Function.Emit_HomeMove {
    Input: kind: Integer
    Input: imm: Integer
    Body: {
        IfCondition EqualTo(kind, 1) ThenBlock: { Emit_MovRaxR13() }
        IfCondition EqualTo(kind, 2) ThenBlock: { Emit_MovR13Rax() }
        IfCondition EqualTo(kind, 3) ThenBlock: {
            asm = "ADD r13, "
            nstr = NumberToString(imm)
            asm = StringConcat(asm, nstr)
            X86Enc_Assemble(asm)
        }
        IfCondition EqualTo(kind, 4) ThenBlock: {
            asm = "SUB r13, "
            nstr = NumberToString(imm)
            asm = StringConcat(asm, nstr)
            X86Enc_Assemble(asm)
        }
        IfCondition EqualTo(kind, 5) ThenBlock: { X86Enc_Assemble("MOVQ rax, xmm2") }
        IfCondition EqualTo(kind, 6) ThenBlock: { X86Enc_Assemble("MOVQ xmm2, rax") }
        IfCondition EqualTo(kind, 7) ThenBlock: { X86Enc_Assemble("MOVSD xmm0, xmm2") }
        IfCondition EqualTo(kind, 8) ThenBlock: { X86Enc_Assemble("MOVSD xmm1, xmm2") }
        IfCondition EqualTo(kind, 9) ThenBlock: { X86Enc_Assemble("MOVSD xmm2, xmm0") }
        IfCondition EqualTo(kind, 10) ThenBlock: { X86Enc_Assemble("MOVQ xmm1, rax") }
        IfCondition EqualTo(kind, 11) ThenBlock: { X86Enc_Assemble("MOVQ xmm0, rax") }
        IfCondition EqualTo(kind, 12) ThenBlock: { X86_EmitR13Mem(0, 73, 139, 0, 0, imm) }
        IfCondition EqualTo(kind, 13) ThenBlock: { X86Enc_Assemble("CMP r13, rbx") }
        IfCondition EqualTo(kind, 14) ThenBlock: { X86Enc_Assemble("CMP rax, r13") }
        IfCondition EqualTo(kind, 15) ThenBlock: {
            asm = "CMP r13, "
            nstr = NumberToString(imm)
            asm = StringConcat(asm, nstr)
            X86Enc_Assemble(asm)
        }
        IfCondition EqualTo(kind, 16) ThenBlock: { Emit_MovRaxR12() }
        IfCondition EqualTo(kind, 17) ThenBlock: { Emit_MovR12Rax() }
        IfCondition EqualTo(kind, 18) ThenBlock: { X86_EmitR13Mem(242, 65, 15, 88, 2, imm) }
        IfCondition EqualTo(kind, 19) ThenBlock: { X86_EmitR13Mem(242, 65, 15, 92, 2, imm) }
        IfCondition EqualTo(kind, 20) ThenBlock: { X86_EmitR13Mem(242, 65, 15, 89, 2, imm) }
        IfCondition EqualTo(kind, 21) ThenBlock: { X86_EmitR13Mem(0, 77, 3, 0, 4, imm) }
        IfCondition EqualTo(kind, 22) ThenBlock: { X86_EmitR13Mem(0, 77, 43, 0, 4, imm) }
        IfCondition EqualTo(kind, 23) ThenBlock: { X86_AddR12R13() }
        IfCondition EqualTo(kind, 24) ThenBlock: { X86_EmitR13Mem(242, 65, 15, 16, 0, imm) }
        IfCondition EqualTo(kind, 25) ThenBlock: { X86_EmitR13Mem(242, 65, 15, 89, 0, imm) }
        IfCondition EqualTo(kind, 26) ThenBlock: { X86Enc_Assemble("ADDSD xmm2, xmm0") }
        IfCondition EqualTo(kind, 27) ThenBlock: { X86_EmitR13Mem(242, 65, 15, 88, 0, imm) }
        IfCondition EqualTo(kind, 28) ThenBlock: { X86Enc_Assemble("MULSD xmm0, xmm2") }
        IfCondition EqualTo(kind, 29) ThenBlock: { X86_EmitR13Mem(242, 65, 15, 16, 1, imm) }
        IfCondition EqualTo(kind, 30) ThenBlock: { X86Enc_Assemble("MOVQ rax, xmm0") }
        IfCondition EqualTo(kind, 31) ThenBlock: { X86_EmitR13Mem(242, 65, 15, 92, 0, imm) }
        IfCondition EqualTo(kind, 32) ThenBlock: { X86Enc_Assemble("ADDSD xmm0, xmm2") }
        IfCondition EqualTo(kind, 33) ThenBlock: { X86Enc_Assemble("SUBSD xmm0, xmm2") }
        IfCondition EqualTo(kind, 34) ThenBlock: { X86_SubR12R13() }
        IfCondition EqualTo(kind, 35) ThenBlock: { X86Enc_Assemble("MULSD xmm2, xmm0") }
        IfCondition EqualTo(kind, 36) ThenBlock: { X86Enc_Assemble("SUBSD xmm2, xmm0") }
        IfCondition EqualTo(kind, 37) ThenBlock: { X86Enc_Assemble("MOVSD xmm1, xmm0") }
        IfCondition EqualTo(kind, 38) ThenBlock: { X86Enc_Assemble("ADDSD xmm0, xmm1") }
        IfCondition EqualTo(kind, 39) ThenBlock: { X86Enc_Assemble("SUBSD xmm0, xmm1") }
        IfCondition EqualTo(kind, 40) ThenBlock: { X86Enc_Assemble("MULSD xmm0, xmm1") }
        IfCondition EqualTo(kind, 41) ThenBlock: {
            asm = "ADD r12, "
            nstr = NumberToString(imm)
            asm = StringConcat(asm, nstr)
            X86Enc_Assemble(asm)
        }
        IfCondition EqualTo(kind, 42) ThenBlock: {
            asm = "SUB r12, "
            nstr = NumberToString(imm)
            asm = StringConcat(asm, nstr)
            X86Enc_Assemble(asm)
        }
        // MOV [r13 + disp], rax. Kinds 1-42 are unchanged.
        IfCondition EqualTo(kind, 43) ThenBlock: { X86_EmitR13Mem(0, 73, 137, 0, 0, imm) }
        IfCondition EqualTo(kind, 44) ThenBlock: { X86Enc_Assemble("CMP r12, rbx") }
        IfCondition EqualTo(kind, 45) ThenBlock: { X86Enc_Assemble("CMP rax, r12") }
        IfCondition EqualTo(kind, 46) ThenBlock: {
            asm = "CMP r12, "
            nstr = NumberToString(imm)
            asm = StringConcat(asm, nstr)
            X86Enc_Assemble(asm)
        }
    }
}

Function.Optimize_HomeRelease {
    Body: {
        LoopHome.active = 0
        LoopHome.blocked = 0
        LoopHome.no_float = 0
        LoopHome.int_name = 0
        LoopHome.flt_name = 0
        LoopHome.int_off = 0
        LoopHome.flt_off = 0
        LoopHome.assign_name = 0
        LoopHome.acc_name = 0
        LoopHome.acc_off = 0
        LoopHome.a0_on = 0
        LoopHome.a1_on = 0
        LoopHome.a2_on = 0
        LoopHome.a3_on = 0
        LoopHome.hold_on = 0
        LoopHome.hold_name = 0
        LoopHome.rbx_free = 0
        LoopHome.lim_on = 0
        LoopHome.lim_name = 0
        LoopHome.lim_off = 0
        LoopHome.alias_spill = 0
        LoopHome.body = 0
        LoopHome.f2_name = 0
        LoopHome.f2_off = 0
        LoopHome.f3_name = 0
        LoopHome.f3_off = 0
        LoopHome.f4_name = 0
        LoopHome.f4_off = 0
        LoopHome.f5_name = 0
        LoopHome.f5_off = 0
        LoopHome.f6_name = 0
        LoopHome.f6_off = 0
        LoopHome.xf_n = 0
        LoopHome.rld_count = 0
        LoopHome.hit_xmm = 0
        LoopHome.tab_on = 0
        LoopHome.tab_name = 0
        LoopHome.tab_off = 0
        LoopHome.tab_many = 0
        LoopHome.has_call = 0
        LoopHome.scan_depth = 0
        LoopHome.sib_index = 1
        LoopHome.der_on = 0
        LoopHome.der_name = 0
        LoopHome.der_via = 0
        LoopHome.der_const = 0
        LoopHome.der_off = 0
        LoopHome.der_step = 0
        LoopHome.iv_nn = 0
        LoopHome.iv_lo = 0
        LoopHome.iv_hi = 0
        LoopHome.iv_step = 0
        LoopHome.iv_at = 0
        LoopHome.coal_on = 0
        LoopHome.coal_name = 0
        LoopHome.coal_slot = 0
        LoopHome.cond = 0
        LoopHome.prod_on = 0
        LoopHome.prod_c = 0
        LoopHome.prod_delta = 0
        LoopHome.prod_bad = 0
        LoopHome.prod_seen = 0
        LoopHome.prod_tmp = 0
        LoopHome.pin_n = 0
        LoopHome.pin_hit = 0
        LoopHome.kmul_on = 0
        LoopHome.kmul_name = 0
        LoopHome.kmul_off = 0
        LoopHome.ihold_on = 0
        LoopHome.ihold_name = 0
        LoopHome.ihold_off = 0
        LoopHome.ihold_reg = 0
        LoopHome.rbx_scratch = 0
        LoopHome.fwd_on = 0
        LoopHome.fwd_name = 0
        LoopHome.fwd_slot = 0
        LoopHome.fwd_use = 0
        LoopHome.sse_scratch = 0
        Optimize_PtrClearAll()
        Optimize_IpClear()
    }
}

Function.Optimize_HomeRec {
    Input: index: Integer
    Output: Address
    Body: {
        off = Multiply(index, 48)
        ReturnValue(Add(LoopHome.recs, off))
    }
}

Function.Optimize_IsIntHome {
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(LoopHome.active, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(LoopHome.int_name, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(StringCompare(name, LoopHome.int_name), 0) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

Function.Optimize_FltSlot {
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(LoopHome.active, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterThan(LoopHome.coal_on, 0) ThenBlock: {
            hit = Optimize_CoalFind(name)
            IfCondition GreaterThan(hit, 0) ThenBlock: { ReturnValue(hit) }
        }
        IfCondition EqualTo(Optimize_NameEq(name, LoopHome.flt_name), 1) ThenBlock: { ReturnValue(2) }
        IfCondition EqualTo(Optimize_NameEq(name, LoopHome.f2_name), 1) ThenBlock: { ReturnValue(3) }
        IfCondition EqualTo(Optimize_NameEq(name, LoopHome.f3_name), 1) ThenBlock: { ReturnValue(4) }
        IfCondition EqualTo(Optimize_NameEq(name, LoopHome.f4_name), 1) ThenBlock: { ReturnValue(5) }
        IfCondition EqualTo(Optimize_NameEq(name, LoopHome.f5_name), 1) ThenBlock: { ReturnValue(6) }
        IfCondition EqualTo(Optimize_NameEq(name, LoopHome.f6_name), 1) ThenBlock: { ReturnValue(7) }
        xs = Optimize_XfSlot(name)
        IfCondition GreaterThan(xs, 0) ThenBlock: { ReturnValue(xs) }
        ReturnValue(0)
    }
}

// xmm8–xmm14. Record stride 16: name, frame offset. xmm15 stays the FMA scratch.
Function.Optimize_XfEnsure {
    Body: {
        IfCondition EqualTo(LoopHome.xf_recs, 0) ThenBlock: {
            LoopHome.xf_recs = Allocate(112)
        }
        ReturnValue(0)
    }
}

Function.Optimize_XfSlot {
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }
        IfCondition LessEqual(LoopHome.xf_n, 0) ThenBlock: { ReturnValue(0) }
        i = 0
        WhileLoop LessThan(i, LoopHome.xf_n) {
            rec = Add(LoopHome.xf_recs, Multiply(i, 16))
            IfCondition EqualTo(Optimize_NameEq(Dereference(rec), name), 1) ThenBlock: {
                ReturnValue(Add(8, i))
            }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

Function.Optimize_XfHas {
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition GreaterThan(Optimize_XfSlot(name), 0) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

Function.Optimize_XfInstall {
    Input: name: Address
    Input: off: Integer
    Output: Integer
    Body: {
        IfCondition GreaterEqual(LoopHome.xf_n, 7) ThenBlock: { ReturnValue(0) }
        Optimize_XfEnsure()
        rec = Add(LoopHome.xf_recs, Multiply(LoopHome.xf_n, 16))
        StoreValue(rec, name)
        StoreValue(Add(rec, 8), off)
        LoopHome.xf_n = Add(LoopHome.xf_n, 1)
        ReturnValue(1)
    }
}

Function.Optimize_XfLoad {
    Body: {
        i = 0
        WhileLoop LessThan(i, LoopHome.xf_n) {
            rec = Add(LoopHome.xf_recs, Multiply(i, 16))
            Emit_MovRaxRbpOffset(Dereference(Add(rec, 8)))
            X86_XmmRR(1, Add(8, i))
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

Function.Optimize_XfSpill {
    Body: {
        i = 0
        WhileLoop LessThan(i, LoopHome.xf_n) {
            rec = Add(LoopHome.xf_recs, Multiply(i, 16))
            X86_XmmRR(2, Add(8, i))
            Emit_MovRbpOffsetRax(Dereference(Add(rec, 8)))
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

// A read of name. An assignment target is a write, so it does not count.
// An index or pointer-field base is a read: the name lives in Data1.
Function.Optimize_NodeReads {
    Input: node: Address
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }
        nt = AST_GetType(node)
        IfCondition EqualTo(nt, AST.IDENTIFIER) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(AST_GetData1(node), name), 1) ThenBlock: { ReturnValue(1) }
        }
        IfCondition EqualTo(nt, AST.INDEX_ASSIGN) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(AST_GetData1(node), name), 1) ThenBlock: { ReturnValue(1) }
        }
        IfCondition EqualTo(nt, AST.POINTER_FIELD_ASSIGN) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(AST_GetData1(node), name), 1) ThenBlock: { ReturnValue(1) }
        }
        IfCondition EqualTo(nt, AST.POINTER_FIELD_ACCESS) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(AST_GetData1(node), name), 1) ThenBlock: { ReturnValue(1) }
        }
        count = AST_GetChildCount(node)
        i = 0
        WhileLoop LessThan(i, count) {
            IfCondition EqualTo(Optimize_NodeReads(AST_GetChild(node, i), name), 1) ThenBlock: { ReturnValue(1) }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

// Plain assignment that replaces name. The right-hand side must not read it.
Function.Optimize_LiveFullDef {
    Input: st: Address
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(Optimize_PlainAssign(st), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_NameEq(AST_GetData1(st), name), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_NodeReads(AST_GetChild(st, 0), name), 1) ThenBlock: { ReturnValue(0) }
        ReturnValue(1)
    }
}

// 1 when name is mentioned in node, ignoring the loop body at skip.
// The while condition stays visible because only the body is skipped.
Function.Optimize_OutsideHit {
    Input: node: Address
    Input: name: Address
    Input: skip: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(node, skip) ThenBlock: { ReturnValue(0) }
        nt = AST_GetType(node)
        IfCondition EqualTo(nt, AST.IDENTIFIER) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(AST_GetData1(node), name), 1) ThenBlock: { ReturnValue(1) }
        }
        IfCondition EqualTo(nt, AST.ASSIGNMENT) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(AST_GetData1(node), name), 1) ThenBlock: { ReturnValue(1) }
        }
        IfCondition EqualTo(nt, AST.INDEX_ASSIGN) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(AST_GetData1(node), name), 1) ThenBlock: { ReturnValue(1) }
        }
        IfCondition EqualTo(nt, AST.POINTER_FIELD_ASSIGN) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(AST_GetData1(node), name), 1) ThenBlock: { ReturnValue(1) }
        }
        IfCondition EqualTo(nt, AST.POINTER_FIELD_ACCESS) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(AST_GetData1(node), name), 1) ThenBlock: { ReturnValue(1) }
        }
        count = AST_GetChildCount(node)
        i = 0
        WhileLoop LessThan(i, count) {
            IfCondition EqualTo(Optimize_OutsideHit(AST_GetChild(node, i), name, skip), 1) ThenBlock: { ReturnValue(1) }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

// AddressOf(name) or any inline asm can read the frame slot without a
// later identifier, so the home must be stored back.
Function.Optimize_LiveEscape {
    Input: node: Address
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        nt = AST_GetType(node)
        IfCondition EqualTo(nt, AST.INLINEASM) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(nt, AST.CALL) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(AST_GetData1(node), "AddressOf"), 1) ThenBlock: {
                IfCondition EqualTo(Optimize_NodeReads(node, name), 1) ThenBlock: { ReturnValue(1) }
            }
        }
        count = AST_GetChildCount(node)
        i = 0
        WhileLoop LessThan(i, count) {
            IfCondition EqualTo(Optimize_LiveEscape(AST_GetChild(node, i), name), 1) ThenBlock: { ReturnValue(1) }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

// 1 when the value in the home must be written back at the loop exit.
// Missing the function node spills. An extra spill is safe.
Function.Optimize_LiveOut {
    Input: name: Address
    Input: body: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Compile.current_func, 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(body, 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(Optimize_OutsideHit(Compile.current_func, name, body), 1) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(Optimize_LiveEscape(Compile.current_func, name), 1) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

// 1 when the loop entry must reload name.
// A live-out home is reloaded even when the body defines it: the loop may
// run zero times and the exit spill must keep the incoming bits.
// A straight-line full definition before any read kills the incoming value.
Function.Optimize_LiveIn {
    Input: name: Address
    Input: condition: Address
    Input: body: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_NodeReads(condition, name), 1) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(Optimize_LiveOut(name, body), 1) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(Optimize_FoldIsBlock(body), 0) ThenBlock: { ReturnValue(1) }
        count = AST_GetChildCount(body)
        i = 0
        WhileLoop LessThan(i, count) {
            st = AST_GetChild(body, i)
            IfCondition EqualTo(Optimize_NodeReads(st, name), 1) ThenBlock: { ReturnValue(1) }
            IfCondition EqualTo(Optimize_LiveFullDef(st, name), 1) ThenBlock: { ReturnValue(0) }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

// While-entry loads only. Optimize_XfLoad stays unconditional for call reload.
Function.Optimize_XfLoadIn {
    Input: condition: Address
    Body: {
        i = 0
        WhileLoop LessThan(i, LoopHome.xf_n) {
            rec = Add(LoopHome.xf_recs, Multiply(i, 16))
            IfCondition EqualTo(Optimize_LiveIn(Dereference(rec), condition, LoopHome.body), 1) ThenBlock: {
                Emit_MovRaxRbpOffset(Dereference(Add(rec, 8)))
                X86_XmmRR(1, Add(8, i))
            }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

// While-exit spills only. Optimize_XfSpill stays unconditional for call save.
Function.Optimize_XfSpillOut {
    Body: {
        i = 0
        WhileLoop LessThan(i, LoopHome.xf_n) {
            rec = Add(LoopHome.xf_recs, Multiply(i, 16))
            IfCondition EqualTo(Optimize_LiveOut(Dereference(rec), LoopHome.body), 1) ThenBlock: {
                X86_XmmRR(2, Add(8, i))
                Emit_MovRbpOffsetRax(Dereference(Add(rec, 8)))
            }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

Function.Optimize_IsFltHome {
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition GreaterThan(Optimize_FltSlot(name), 0) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

Function.Optimize_IsAccHome {
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(LoopHome.active, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(LoopHome.acc_name, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(StringCompare(name, LoopHome.acc_name), 0) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

Function.Optimize_HomeLoad {
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(LoopHome.der_on, 1) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(name, LoopHome.der_name), 1) ThenBlock: {
                X86Enc_Assemble("MOV rax, r11")
                ReturnValue(1)
            }
        }
        IfCondition EqualTo(Optimize_IsIntHome(name), 1) ThenBlock: {
            Emit_HomeMove(1, 0)
            ReturnValue(1)
        }
        IfCondition EqualTo(Optimize_IsAccHome(name), 1) ThenBlock: {
            Emit_HomeMove(16, 0)
            ReturnValue(1)
        }
        IfCondition EqualTo(Optimize_IsFltHome(name), 1) ThenBlock: {
            slot = Optimize_FltSlot(name)
            IfCondition EqualTo(slot, 2) ThenBlock: { Emit_HomeMove(5, 0) }
            IfCondition GreaterThan(slot, 2) ThenBlock: { X86_XmmRR(2, slot) }
            ReturnValue(1)
        }
        IfCondition EqualTo(LoopHome.hold_on, 1) ThenBlock: {
            IfCondition EqualTo(StringCompare(name, LoopHome.hold_name), 0) ThenBlock: {
                Emit_HomeMove(30, 0)
                ReturnValue(1)
            }
        }
        IfCondition EqualTo(Optimize_AliasFind(name), 1) ThenBlock: {
            Emit_HomeMove(12, LoopHome.hit_disp)
            ReturnValue(1)
        }
        ReturnValue(0)
    }
}

Function.Optimize_HomeStore {
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(Optimize_IsIntHome(name), 1) ThenBlock: {
            Emit_HomeMove(2, 0)
            Optimize_PtrClearAll()
            ReturnValue(1)
        }
        IfCondition EqualTo(Optimize_IsAccHome(name), 1) ThenBlock: {
            Emit_HomeMove(17, 0)
            ReturnValue(1)
        }
        IfCondition EqualTo(Optimize_IsFltHome(name), 1) ThenBlock: {
            slot = Optimize_FltSlot(name)
            IfCondition EqualTo(slot, 2) ThenBlock: { Emit_HomeMove(6, 0) }
            IfCondition GreaterThan(slot, 2) ThenBlock: { X86_XmmRR(1, slot) }
            ReturnValue(1)
        }
        IfCondition EqualTo(Optimize_AliasFind(name), 1) ThenBlock: {
            Optimize_AliasClear(name)
            ReturnValue(0)
        }
        ReturnValue(0)
    }
}

Function.Optimize_HomeCallOk {
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(StringCompare(name, "Add"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "Subtract"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "Multiply"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "Divide"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "Modulo"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "Negate"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "EqualTo"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "NotEqual"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "LessThan"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "GreaterThan"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "LessEqual"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "GreaterEqual"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "BitwiseAnd"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "BitwiseOr"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "BitwiseXor"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "BitwiseNot"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "LeftShift"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "RightShift"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "BitAnd"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "BitOr"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "BitXor"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "BitNot"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "ShiftLeft"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "ShiftRight"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "And"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "Or"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "Not"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "Float_Add"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "Float_Sub"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "Float_Mul"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "Float_Div"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "Float_Neg"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "Float_Abs"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "Float_Sqrt"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "Float_FromInt"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "Float_ToInt"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "Dereference"), 0) ThenBlock: { ReturnValue(1) }
        // Inline store: push the address, move the value through rbx, then
        // mov [rax], rbx. No call, and r13 and xmm2-xmm5 stay put. Allocate
        // and Deallocate call the arena, so they stay real calls.
        IfCondition EqualTo(StringCompare(name, "StoreValue"), 0) ThenBlock: { ReturnValue(1) }
        // Float compares use xmm0, xmm1, rax, and rcx. GetByte and SetByte
        // use rax, rbx, and rdi. None of them write r12, r13, r14, or
        // xmm2-xmm14. RbxSafeOp still rejects them, so a leaf compare bound
        // is not parked in rbx beside a byte op.
        IfCondition EqualTo(StringCompare(name, "Float_Eq"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "Float_Ne"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "Float_Lt"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "Float_Gt"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "Float_Le"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "Float_Ge"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "GetByte"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "SetByte"), 0) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

// True when Float_Add or Float_Sub has a Float_Mul child. The multiply
// is fused into a live home, or into xmm0 with xmm6 as the multiplicand.
// It does not by itself write xmm2–xmm5.
Function.Optimize_HomeFma {
    Input: node: Address
    Output: Integer
    Body: {
        name = AST_GetData1(node)
        is_add = 0
        IfCondition EqualTo(StringCompare(name, "Float_Add"), 0) ThenBlock: { is_add = 1 }
        IfCondition EqualTo(StringCompare(name, "Float_Sub"), 0) ThenBlock: { is_add = 1 }
        IfCondition EqualTo(is_add, 0) ThenBlock: { ReturnValue(0) }
        n = AST_GetChildCount(node)
        i = 0
        WhileLoop LessThan(i, n) {
            child = AST_GetChild(node, i)
            IfCondition NotEqual(child, 0) ThenBlock: {
                ct = AST_GetType(child)
                IfCondition EqualTo(ct, AST.CALL) ThenBlock: {
                    cn = AST_GetData1(child)
                    IfCondition EqualTo(StringCompare(cn, "Float_Mul"), 0) ThenBlock: { ReturnValue(1) }
                }
            }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

Function.Optimize_HomeTouch {
    Input: name: Address
    Input: is_store: Integer
    Input: is_float: Integer
    Input: is_seed: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(LoopHome.recs, 0) ThenBlock: {
            LoopHome.recs = Allocate(3072)
        }
        found = -1
        i = 0
        WhileLoop LessThan(i, LoopHome.count) {
            rec = Optimize_HomeRec(i)
            existing = Dereference(rec)
            IfCondition EqualTo(StringCompare(existing, name), 0) ThenBlock: {
                found = i
                ExitLoop
            }
            i = Add(i, 1)
        }
        IfCondition EqualTo(found, -1) ThenBlock: {
            IfCondition GreaterEqual(LoopHome.count, 64) ThenBlock: { ReturnValue(0) }
            found = LoopHome.count
            LoopHome.count = Add(LoopHome.count, 1)
            rec = Optimize_HomeRec(found)
            StoreValue(rec, name)
            StoreValue(Add(rec, 8), 0)
            StoreValue(Add(rec, 16), 0)
            StoreValue(Add(rec, 24), 0)
            StoreValue(Add(rec, 32), 0)
            StoreValue(Add(rec, 40), 0)
        }
        rec = Optimize_HomeRec(found)
        IfCondition EqualTo(is_store, 1) ThenBlock: {
            stores = Dereference(Add(rec, 16))
            StoreValue(Add(rec, 16), Add(stores, 1))
            IfCondition EqualTo(is_float, 1) ThenBlock: {
                fops = Dereference(Add(rec, 24))
                StoreValue(Add(rec, 24), Add(fops, 1))
            }
            IfCondition EqualTo(is_seed, 1) ThenBlock: {
                seeds = Dereference(Add(rec, 40))
                StoreValue(Add(rec, 40), Add(seeds, 1))
            }
        } ElseBlock: {
            loads = Dereference(Add(rec, 8))
            StoreValue(Add(rec, 8), Add(loads, 1))
            IfCondition NotEqual(LoopHome.assign_name, 0) ThenBlock: {
                IfCondition EqualTo(StringCompare(name, LoopHome.assign_name), 0) ThenBlock: {
                    selfn = Dereference(Add(rec, 32))
                    StoreValue(Add(rec, 32), Add(selfn, 1))
                }
            }
        }
        ReturnValue(0)
    }
}

Function.Optimize_HomeWalkKids {
    Input: node: Address
    Output: Integer
    Body: {
        count = AST_GetChildCount(node)
        i = 0
        WhileLoop LessThan(i, count) {
            IfCondition EqualTo(LoopHome.blocked, 1) ThenBlock: { ExitLoop }
            child = AST_GetChild(node, i)
            Optimize_HomeWalk(child)
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

Function.Optimize_HomeBlockNode {
    Input: node_type: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(node_type, AST.WHILE) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(node_type, AST.FOR_EVERY) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(node_type, AST.UNTIL) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(node_type, AST.TRY) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(node_type, AST.LOOP_MAIN) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(node_type, AST.LOOP_ACTOR) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(node_type, AST.LOOP_START) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(node_type, AST.LOOP_SHADOW) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(node_type, AST.DEFER) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(node_type, AST.WITH_CONTEXT) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(node_type, AST.EVERY_INTERVAL) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(node_type, AST.POINTER_FIELD_ASSIGN) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

Function.Optimize_HomeWalk {
    Input: node: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(LoopHome.blocked, 1) ThenBlock: { ReturnValue(0) }
        node_type = AST_GetType(node)
        IfCondition EqualTo(Optimize_HomeBlockNode(node_type), 1) ThenBlock: {
            LoopHome.blocked = 1
            ReturnValue(0)
        }
        IfCondition EqualTo(node_type, AST.IDENTIFIER) ThenBlock: {
            Optimize_HomeTouch(AST_GetData1(node), 0, 0, 0)
            ReturnValue(0)
        }
        IfCondition EqualTo(node_type, AST.ASSIGNMENT) ThenBlock: {
            target_node = AST_GetData2(node)
            IfCondition NotEqual(target_node, 0) ThenBlock: {
                LoopHome.blocked = 1
                ReturnValue(0)
            }
            tname = AST_GetData1(node)
            val = AST_GetChild(node, 0)
            is_float = 0
            is_seed = 0
            IfCondition NotEqual(val, 0) ThenBlock: {
                vt = AST_GetType(val)
                IfCondition EqualTo(vt, AST.CALL) ThenBlock: {
                    vn = AST_GetData1(val)
                    IfCondition EqualTo(StringCompare(vn, "Float_Add"), 0) ThenBlock: { is_float = 1 }
                    IfCondition EqualTo(StringCompare(vn, "Float_Sub"), 0) ThenBlock: { is_float = 1 }
                    IfCondition EqualTo(StringCompare(vn, "Float_Mul"), 0) ThenBlock: { is_float = 1 }
                    IfCondition EqualTo(StringCompare(vn, "Float_Div"), 0) ThenBlock: { is_float = 1 }
                    // A qword load seeds the name. It counts toward a float
                    // home only together with a later add, subtract, multiply,
                    // or divide. A pure load stays fops == 0.
                    IfCondition EqualTo(StringCompare(vn, "Dereference"), 0) ThenBlock: { is_seed = 1 }
                }
            }
            skip_store = 0
            IfCondition NotEqual(val, 0) ThenBlock: {
                IfCondition EqualTo(AST_GetType(val), AST.NUMBER) ThenBlock: {
                    IfCondition EqualTo(StringToNumber(AST_GetData1(val)), 0) ThenBlock: {
                        skip_store = 1
                    }
                }
            }
            IfCondition EqualTo(skip_store, 0) ThenBlock: {
                Optimize_HomeTouch(tname, 1, is_float, is_seed)
            }
            LoopHome.assign_name = tname
            Optimize_HomeWalkKids(node)
            LoopHome.assign_name = 0
            ReturnValue(0)
        }
        IfCondition EqualTo(node_type, AST.CALL) ThenBlock: {
            cname = AST_GetData1(node)
            IfCondition EqualTo(Optimize_HomeCallOk(cname), 0) ThenBlock: {
                IfCondition LessThan(Compile_FindFunction(cname), 0) ThenBlock: {
                    LoopHome.blocked = 1
                    ReturnValue(0)
                }
                LoopHome.has_call = 1
            }
            // A fused multiply-add does not take xmm2. Expression FMA uses
            // xmm6. A home update writes that home in place.
            Optimize_HomeWalkKids(node)
            ReturnValue(0)
        }
        Optimize_HomeWalkKids(node)
        ReturnValue(0)
    }
}

// A field that is loaded, added or subtracted once, and stored back.
// That shape stays a pointer update and does not take a float home.
Function.Optimize_FltFieldUpd {
    Input: loads: Integer
    Input: stores: Integer
    Input: fops: Integer
    Input: selfn: Integer
    Input: seeds: Integer
    Output: Integer
    Body: {
        IfCondition NotEqual(seeds, 1) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(fops, 1) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(stores, 2) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(loads, 2) ThenBlock: { ReturnValue(0) }
        IfCondition LessEqual(selfn, 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(1)
    }
}

Function.Optimize_HomePick {
    Output: Integer
    Body: {
        best_int_name = 0
        best_int_off = 0
        best_int_score = 0
        best_flt_name = 0
        best_flt_off = 0
        best_flt_self = -1
        best_flt_score = 0
        best_flt_loads = -1
        best_flt_fresh = 0
        i = 0
        WhileLoop LessThan(i, LoopHome.count) {
            rec = Optimize_HomeRec(i)
            name = Dereference(rec)
            loads = Dereference(Add(rec, 8))
            stores = Dereference(Add(rec, 16))
            fops = Dereference(Add(rec, 24))
            selfn = Dereference(Add(rec, 32))
            seeds = Dereference(Add(rec, 40))
            IfCondition GreaterThan(loads, 0) ThenBlock: {
                IfCondition GreaterThan(stores, 0) ThenBlock: {
                    IfCondition GreaterThan(fops, 0) ThenBlock: {
                        IfCondition EqualTo(stores, Add(fops, seeds)) ThenBlock: {
                            IfCondition EqualTo(LoopHome.no_float, 0) ThenBlock: {
                                off = Scope_Resolve(name)
                                rt = Scope.resolve_type
                                slot_ok = 0
                                fresh = 0
                                cand_off = 0
                                IfCondition EqualTo(rt, 1) ThenBlock: {
                                    IfCondition LessThan(off, 0) ThenBlock: {
                                        slot_ok = 1
                                        cand_off = off
                                    }
                                }
                                IfCondition EqualTo(rt, 2) ThenBlock: {
                                    IfCondition LessThan(off, 0) ThenBlock: {
                                        slot_ok = 1
                                        cand_off = off
                                    }
                                }
                                IfCondition EqualTo(rt, 0) ThenBlock: {
                                    slot_ok = 1
                                    fresh = 1
                                }
                                IfCondition EqualTo(slot_ok, 1) ThenBlock: {
                                    IfCondition EqualTo(selfn, 0) ThenBlock: {
                                        IfCondition EqualTo(loads, stores) ThenBlock: {
                                            IfCondition EqualTo(Optimize_ConstTempSkip(name), 1) ThenBlock: { slot_ok = 0 }
                                        }
                                    }
                                    IfCondition EqualTo(Optimize_FltFieldUpd(loads, stores, fops, selfn, seeds), 1) ThenBlock: { slot_ok = 0 }
                                    IfCondition EqualTo(slot_ok, 1) ThenBlock: {
                                    take = 0
                                    IfCondition GreaterThan(loads, best_flt_loads) ThenBlock: { take = 1 }
                                    IfCondition EqualTo(loads, best_flt_loads) ThenBlock: {
                                        IfCondition GreaterThan(selfn, best_flt_self) ThenBlock: { take = 1 }
                                        IfCondition EqualTo(selfn, best_flt_self) ThenBlock: {
                                            IfCondition GreaterThan(fops, best_flt_score) ThenBlock: { take = 1 }
                                        }
                                    }
                                    IfCondition EqualTo(take, 1) ThenBlock: {
                                        best_flt_loads = loads
                                        best_flt_self = selfn
                                        best_flt_score = fops
                                        best_flt_name = name
                                        best_flt_off = cand_off
                                        best_flt_fresh = fresh
                                    }
                                    }
                                }
                            }
                        }
                    }
                    IfCondition EqualTo(fops, 0) ThenBlock: {
                        off = Scope_Resolve(name)
                        rt = Scope.resolve_type
                        ok = 0
                        IfCondition EqualTo(rt, 1) ThenBlock: { ok = 1 }
                        IfCondition EqualTo(rt, 2) ThenBlock: { ok = 1 }
                        IfCondition GreaterEqual(off, 0) ThenBlock: { ok = 0 }
                        IfCondition EqualTo(ok, 1) ThenBlock: {
                            score = Add(loads, stores)
                            IfCondition GreaterThan(score, best_int_score) ThenBlock: {
                                best_int_score = score
                                best_int_name = name
                                best_int_off = off
                            }
                        }
                    }
                }
            }
            i = Add(i, 1)
        }
        IfCondition EqualTo(best_flt_fresh, 1) ThenBlock: {
            best_flt_off = Optimize_EnsureSlot(best_flt_name)
            IfCondition EqualTo(best_flt_off, 0) ThenBlock: { best_flt_name = 0 }
        }
        LoopHome.int_name = best_int_name
        LoopHome.int_off = best_int_off
        LoopHome.flt_name = best_flt_name
        LoopHome.flt_off = best_flt_off
        best_acc_name = 0
        best_acc_off = 0
        best_acc_self = 0
        best_acc_score = -1
        IfCondition NotEqual(best_int_name, 0) ThenBlock: {
            j = 0
            WhileLoop LessThan(j, LoopHome.count) {
                rec2 = Optimize_HomeRec(j)
                aname = Dereference(rec2)
                aloads = Dereference(Add(rec2, 8))
                astores = Dereference(Add(rec2, 16))
                afops = Dereference(Add(rec2, 24))
                aself = Dereference(Add(rec2, 32))
                ausable = 0
                IfCondition GreaterThan(aloads, 0) ThenBlock: {
                    IfCondition GreaterThan(astores, 0) ThenBlock: {
                        IfCondition EqualTo(afops, 0) ThenBlock: {
                            IfCondition GreaterThan(aself, 0) ThenBlock: {
                                IfCondition NotEqual(StringCompare(aname, best_int_name), 0) ThenBlock: {
                                    aoff = Scope_Resolve(aname)
                                    art = Scope.resolve_type
                                    aok = 0
                                    IfCondition EqualTo(art, 1) ThenBlock: { aok = 1 }
                                    IfCondition EqualTo(art, 2) ThenBlock: { aok = 1 }
                                    IfCondition GreaterEqual(aoff, 0) ThenBlock: { aok = 0 }
                                    IfCondition EqualTo(aok, 1) ThenBlock: { ausable = 1 }
                                    IfCondition EqualTo(ausable, 1) ThenBlock: {
                                        ascore = Add(aloads, astores)
                                        atake = 0
                                        IfCondition GreaterThan(aself, best_acc_self) ThenBlock: { atake = 1 }
                                        IfCondition EqualTo(aself, best_acc_self) ThenBlock: {
                                            IfCondition GreaterThan(ascore, best_acc_score) ThenBlock: { atake = 1 }
                                        }
                                        IfCondition EqualTo(atake, 1) ThenBlock: {
                                            best_acc_self = aself
                                            best_acc_score = ascore
                                            best_acc_name = aname
                                            best_acc_off = aoff
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
                j = Add(j, 1)
            }
        }
        LoopHome.acc_name = best_acc_name
        LoopHome.acc_off = best_acc_off
        IfCondition NotEqual(LoopHome.flt_name, 0) ThenBlock: {
            Optimize_HomePickExtras()
        }
        ReturnValue(0)
    }
}

Function.Optimize_LoopHomes {
    Input: condition: Address
    Input: body: Address
    Output: Integer
    Body: {
        LoopHome.blocked = 0
        LoopHome.no_float = 0
        LoopHome.count = 0
        LoopHome.int_name = 0
        LoopHome.flt_name = 0
        LoopHome.int_off = 0
        LoopHome.flt_off = 0
        LoopHome.acc_name = 0
        LoopHome.acc_off = 0
        LoopHome.assign_name = 0
        LoopHome.rbx_free = 0
        LoopHome.lim_on = 0
        LoopHome.alias_spill = 1
        LoopHome.hold_on = 0
        LoopHome.hold_name = 0
        LoopHome.body = 0
        LoopHome.cond = 0
        LoopHome.coal_on = 0
        LoopHome.coal_name = 0
        LoopHome.coal_slot = 0
        LoopHome.f2_name = 0
        LoopHome.f2_off = 0
        LoopHome.f3_name = 0
        LoopHome.f3_off = 0
        LoopHome.f4_name = 0
        LoopHome.f4_off = 0
        LoopHome.f5_name = 0
        LoopHome.f5_off = 0
        LoopHome.f6_name = 0
        LoopHome.f6_off = 0
        LoopHome.xf_n = 0
        LoopHome.rld_count = 0
        LoopHome.tab_on = 0
        LoopHome.tab_name = 0
        LoopHome.tab_off = 0
        LoopHome.tab_many = 0
        LoopHome.has_call = 0
        LoopHome.scan_depth = 0
        LoopHome.hit_xmm = 0
        LoopHome.sib_index = 1
        LoopHome.der_on = 0
        LoopHome.der_name = 0
        LoopHome.der_via = 0
        LoopHome.der_const = 0
        LoopHome.der_off = 0
        LoopHome.der_step = 0
        LoopHome.iv_nn = 0
        LoopHome.iv_lo = 0
        LoopHome.iv_hi = 0
        LoopHome.iv_step = 0
        LoopHome.iv_at = 0
        LoopHome.prod_on = 0
        LoopHome.prod_c = 0
        LoopHome.prod_delta = 0
        LoopHome.prod_bad = 0
        LoopHome.prod_seen = 0
        LoopHome.prod_tmp = 0
        LoopHome.pin_n = 0
        LoopHome.pin_hit = 0
        LoopHome.kmul_on = 0
        LoopHome.kmul_name = 0
        LoopHome.kmul_off = 0
        LoopHome.ihold_on = 0
        LoopHome.ihold_name = 0
        LoopHome.ihold_off = 0
        LoopHome.ihold_reg = 0
        LoopHome.rbx_scratch = 0
        LoopHome.fwd_on = 0
        LoopHome.fwd_name = 0
        LoopHome.fwd_slot = 0
        LoopHome.fwd_use = 0
        LoopHome.sse_scratch = 0
        Optimize_AliasClearAll()
        Optimize_PtrClearAll()
        Optimize_IpClear()
        IfCondition EqualTo(LoopHome.recs, 0) ThenBlock: {
            LoopHome.recs = Allocate(3072)
        }
        Optimize_HomeWalk(condition)
        Optimize_HomeWalk(body)
        IfCondition EqualTo(LoopHome.blocked, 1) ThenBlock: {
            LoopHome.int_name = 0
            LoopHome.flt_name = 0
            LoopHome.acc_name = 0
            LoopHome.f2_name = 0
            LoopHome.f3_name = 0
            LoopHome.f4_name = 0
            LoopHome.f5_name = 0
            LoopHome.f6_name = 0
            LoopHome.xf_n = 0
            LoopHome.rld_count = 0
            LoopHome.tab_on = 0
            LoopHome.pin_n = 0
            LoopHome.pin_hit = 0
            LoopHome.kmul_on = 0
            LoopHome.kmul_name = 0
            LoopHome.kmul_off = 0
            LoopHome.ihold_on = 0
            LoopHome.ihold_name = 0
            LoopHome.ihold_off = 0
            LoopHome.ihold_reg = 0
            LoopHome.rbx_scratch = 0
            LoopHome.fwd_on = 0
            LoopHome.fwd_name = 0
            LoopHome.fwd_slot = 0
            LoopHome.fwd_use = 0
            LoopHome.sse_scratch = 0
            ReturnValue(0)
        }
        LoopHome.body = body
        LoopHome.cond = condition
        Optimize_HomePick()
        Optimize_AliasClearAll()
        LoopHome.hold_on = 0
        LoopHome.hold_name = 0
        have = 0
        IfCondition NotEqual(LoopHome.int_name, 0) ThenBlock: { have = 1 }
        IfCondition NotEqual(LoopHome.flt_name, 0) ThenBlock: { have = 1 }
        IfCondition NotEqual(LoopHome.acc_name, 0) ThenBlock: { have = 1 }
        IfCondition NotEqual(LoopHome.f2_name, 0) ThenBlock: { have = 1 }
        Optimize_ScanTable(body)
        Optimize_PickByteBase(body)
        IfCondition EqualTo(LoopHome.tab_on, 1) ThenBlock: { have = 1 }
        IfCondition EqualTo(have, 0) ThenBlock: { ReturnValue(0) }
        Optimize_ScanBody(body)
        Optimize_ScanCondTemps(condition, body)
        Optimize_ScanLimit(condition)
        Optimize_AliasClearAll()
        LoopHome.hold_on = 0
        LoopHome.hold_name = 0
        Optimize_PickInvariant(condition, body)
        Optimize_FindStep(body)
        Optimize_NoteIv(condition, body)
        Optimize_PickDerived(body)
        Optimize_PickIp(condition, body)
        Optimize_PickAddr(condition, body)
        Optimize_PickReload(body)
        Optimize_NoteProd()
        Optimize_PickKmul(condition, body)
        Optimize_NoteRbxScratch(condition, body)
        ReturnValue(1)
    }
}

Function.Optimize_ReadImm {
    Input: node: Address
    Output: Integer
    Body: {
        LoopHome.imm_ok = 0
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        nt = AST_GetType(node)
        IfCondition NotEqual(nt, AST.NUMBER) ThenBlock: { ReturnValue(0) }
        val = StringToNumber(AST_GetData1(node))
        IfCondition LessThan(val, 0) ThenBlock: { ReturnValue(0) }
        LoopHome.imm_ok = 1
        LoopHome.imm_val = val
        ReturnValue(1)
    }
}

Function.Optimize_TryHomeAssign {
    Input: target_name: Address
    Input: value_node: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(Optimize_IsIntHome(target_name), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(value_node, 0) ThenBlock: { ReturnValue(0) }
        vt = AST_GetType(value_node)
        IfCondition NotEqual(vt, AST.CALL) ThenBlock: { ReturnValue(0) }
        opname = AST_GetData1(value_node)
        is_add = 0
        is_sub = 0
        IfCondition EqualTo(StringCompare(opname, "Add"), 0) ThenBlock: { is_add = 1 }
        IfCondition EqualTo(StringCompare(opname, "Subtract"), 0) ThenBlock: { is_sub = 1 }
        IfCondition EqualTo(is_add, 0) ThenBlock: {
            IfCondition EqualTo(is_sub, 0) ThenBlock: { ReturnValue(0) }
        }
        IfCondition NotEqual(AST_GetChildCount(value_node), 2) ThenBlock: { ReturnValue(0) }
        a0 = AST_GetChild(value_node, 0)
        a1 = AST_GetChild(value_node, 1)
        imm_side = -1
        IfCondition EqualTo(Optimize_ReadImm(a1), 1) ThenBlock: {
            imm_side = 1
        } ElseBlock: {
            IfCondition EqualTo(Optimize_ReadImm(a0), 1) ThenBlock: {
                imm_side = 0
            }
        }
        IfCondition LessThan(imm_side, 0) ThenBlock: { ReturnValue(0) }
        other = a0
        IfCondition EqualTo(imm_side, 0) ThenBlock: { other = a1 }
        IfCondition EqualTo(other, 0) ThenBlock: { ReturnValue(0) }
        ot = AST_GetType(other)
        IfCondition NotEqual(ot, AST.IDENTIFIER) ThenBlock: { ReturnValue(0) }
        oname = AST_GetData1(other)
        IfCondition NotEqual(StringCompare(oname, target_name), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(is_sub, 1) ThenBlock: {
            IfCondition NotEqual(imm_side, 1) ThenBlock: { ReturnValue(0) }
        }
        // ADD/SUB r13, imm64 does not exist. Fail before any emit.
        IfCondition EqualTo(Optimize_Fit32(LoopHome.imm_val), 0) ThenBlock: { ReturnValue(0) }
        Optimize_AliasOnCursor()
        IfCondition EqualTo(is_add, 1) ThenBlock: { Emit_HomeMove(3, LoopHome.imm_val) }
        IfCondition EqualTo(is_sub, 1) ThenBlock: { Emit_HomeMove(4, LoopHome.imm_val) }
        // Induction pointers step with the same cursor add.
        IfCondition EqualTo(is_add, 1) ThenBlock: {
            IfCondition EqualTo(LoopHome.imm_val, LoopHome.iv_step) ThenBlock: {
                Optimize_IpBump()
            }
        }
        // The derived sum steps with the cursor. Wrapping add matches.
        IfCondition EqualTo(LoopHome.der_on, 1) ThenBlock: {
            IfCondition EqualTo(is_add, 1) ThenBlock: {
                IfCondition EqualTo(LoopHome.imm_val, LoopHome.der_step) ThenBlock: {
                    step_txt = NumberToString(LoopHome.der_step)
                    step_asm = StringConcat("ADD r11, ", step_txt)
                    X86Enc_Assemble(step_asm)
                }
            }
        }
        // The product steps with the same cursor add. Uses before this
        // statement still see the old product.
        IfCondition EqualTo(LoopHome.prod_on, 1) ThenBlock: {
            IfCondition EqualTo(is_add, 1) ThenBlock: {
                IfCondition EqualTo(LoopHome.imm_val, LoopHome.iv_step) ThenBlock: {
                    Optimize_EmitProdBump()
                }
            }
        }
        ReturnValue(1)
    }
}

Function.Optimize_TryHomeDeref {
    Input: arg: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(LoopHome.active, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_CursorDisp(arg), 0) ThenBlock: { ReturnValue(0) }
        Emit_HomeMove(12, LoopHome.imm_val)
        ReturnValue(1)
    }
}

// A frame local that is not itself a home, a hold, or an r13 alias.
// FrameOff leaves the negative RBP offset in LoopHome.imm_val.
Function.Optimize_FrameCmpOk {
    Input: node: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(node), AST.IDENTIFIER) ThenBlock: { ReturnValue(0) }
        name = AST_GetData1(node)
        IfCondition EqualTo(Optimize_IsIntHome(name), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_IsAccHome(name), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_IsFltHome(name), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_IsXmmHold(node), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_AliasFind(name), 1) ThenBlock: { ReturnValue(0) }
        ReturnValue(Optimize_FrameOff(name))
    }
}

// Compare the r12 accumulator with a leaf. A limit parked in rbx stays there.
// side 0: other operand is the right hand. side 1: other operand is the left.
Function.Optimize_TryAccCompare {
    Input: other: Address
    Input: side: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(other, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_IsLeaf(other), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_ReadImm(other), 1) ThenBlock: {
            IfCondition LessEqual(LoopHome.imm_val, 2147483647) ThenBlock: {
                IfCondition EqualTo(side, 0) ThenBlock: {
                    Emit_HomeMove(46, LoopHome.imm_val)
                    ReturnValue(1)
                }
            }
        }
        lim_hit = 0
        IfCondition EqualTo(LoopHome.lim_on, 1) ThenBlock: {
            IfCondition EqualTo(AST_GetType(other), AST.IDENTIFIER) ThenBlock: {
                IfCondition EqualTo(Optimize_NameEq(AST_GetData1(other), LoopHome.lim_name), 1) ThenBlock: {
                    lim_hit = 1
                }
            }
        }
        IfCondition EqualTo(lim_hit, 1) ThenBlock: {
            IfCondition EqualTo(side, 0) ThenBlock: {
                Emit_HomeMove(44, 0)
                ReturnValue(1)
            }
            Emit_MovRaxRbx()
            Emit_HomeMove(45, 0)
            ReturnValue(1)
        }
        IfCondition EqualTo(Optimize_FrameCmpOk(other), 1) ThenBlock: {
            IfCondition EqualTo(side, 0) ThenBlock: {
                X86_CmpHomeMem(12, LoopHome.imm_val, 0)
                ReturnValue(1)
            }
            X86_CmpHomeMem(12, LoopHome.imm_val, 1)
            ReturnValue(1)
        }
        IfCondition EqualTo(LoopHome.lim_on, 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(side, 1) ThenBlock: {
            got = Compile_Expression(other)
            IfCondition EqualTo(got, 0) ThenBlock: { ReturnValue(0) }
            Emit_HomeMove(45, 0)
            ReturnValue(1)
        }
        got = Optimize_LoadToRbx(other)
        IfCondition EqualTo(got, 0) ThenBlock: { ReturnValue(0) }
        Emit_HomeMove(44, 0)
        ReturnValue(1)
    }
}

// Register number of a value that already lives in a GPR, or -1.
// 13 induction, 12 accumulator, 11 derived, 3 a limit parked in rbx.
Function.Optimize_GprOf {
    Input: node: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition NotEqual(AST_GetType(node), AST.IDENTIFIER) ThenBlock: { ReturnValue(-1) }
        name = AST_GetData1(node)
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition EqualTo(Optimize_IsIntHome(name), 1) ThenBlock: { ReturnValue(13) }
        IfCondition EqualTo(Optimize_IsAccHome(name), 1) ThenBlock: { ReturnValue(12) }
        IfCondition EqualTo(LoopHome.der_on, 1) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(name, LoopHome.der_name), 1) ThenBlock: { ReturnValue(11) }
        }
        IfCondition EqualTo(LoopHome.lim_on, 1) ThenBlock: {
            IfCondition EqualTo(LoopHome.rbx_free, 1) ThenBlock: {
                IfCondition EqualTo(Optimize_NameEq(name, LoopHome.lim_name), 1) ThenBlock: { ReturnValue(3) }
            }
        }
        ReturnValue(-1)
    }
}

Function.Optimize_TryHomeCompare {
    Input: arg0: Address
    Input: arg1: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(LoopHome.active, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(LoopHome.int_name, 0) ThenBlock: { ReturnValue(0) }
        lreg = Optimize_GprOf(arg0)
        rreg = Optimize_GprOf(arg1)
        IfCondition GreaterEqual(lreg, 0) ThenBlock: {
            IfCondition GreaterEqual(rreg, 0) ThenBlock: {
                X86_CmpRegReg(lreg, rreg)
                ReturnValue(1)
            }
        }
        left_home = 0
        right_home = 0
        IfCondition NotEqual(arg0, 0) ThenBlock: {
            IfCondition EqualTo(AST_GetType(arg0), AST.IDENTIFIER) ThenBlock: {
                IfCondition EqualTo(Optimize_IsIntHome(AST_GetData1(arg0)), 1) ThenBlock: { left_home = 1 }
            }
        }
        IfCondition NotEqual(arg1, 0) ThenBlock: {
            IfCondition EqualTo(AST_GetType(arg1), AST.IDENTIFIER) ThenBlock: {
                IfCondition EqualTo(Optimize_IsIntHome(AST_GetData1(arg1)), 1) ThenBlock: { right_home = 1 }
            }
        }
        left_acc = 0
        right_acc = 0
        IfCondition NotEqual(arg0, 0) ThenBlock: {
            IfCondition EqualTo(AST_GetType(arg0), AST.IDENTIFIER) ThenBlock: {
                IfCondition EqualTo(Optimize_IsAccHome(AST_GetData1(arg0)), 1) ThenBlock: { left_acc = 1 }
            }
        }
        IfCondition NotEqual(arg1, 0) ThenBlock: {
            IfCondition EqualTo(AST_GetType(arg1), AST.IDENTIFIER) ThenBlock: {
                IfCondition EqualTo(Optimize_IsAccHome(AST_GetData1(arg1)), 1) ThenBlock: { right_acc = 1 }
            }
        }
        IfCondition EqualTo(left_acc, 1) ThenBlock: {
            IfCondition EqualTo(right_acc, 0) ThenBlock: {
                IfCondition EqualTo(left_home, 0) ThenBlock: {
                    IfCondition EqualTo(right_home, 0) ThenBlock: {
                        IfCondition EqualTo(Optimize_TryAccCompare(arg1, 0), 1) ThenBlock: { ReturnValue(1) }
                    }
                }
            }
        }
        IfCondition EqualTo(right_acc, 1) ThenBlock: {
            IfCondition EqualTo(left_acc, 0) ThenBlock: {
                IfCondition EqualTo(left_home, 0) ThenBlock: {
                    IfCondition EqualTo(right_home, 0) ThenBlock: {
                        IfCondition EqualTo(Optimize_TryAccCompare(arg0, 1), 1) ThenBlock: { ReturnValue(1) }
                    }
                }
            }
        }
        IfCondition EqualTo(left_home, right_home) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(left_home, 1) ThenBlock: {
            IfCondition EqualTo(Optimize_IsLeaf(arg1), 0) ThenBlock: { ReturnValue(0) }
            IfCondition EqualTo(Optimize_ReadImm(arg1), 1) ThenBlock: {
                IfCondition EqualTo(Optimize_Fit32(LoopHome.imm_val), 1) ThenBlock: {
                    Emit_HomeMove(15, LoopHome.imm_val)
                    ReturnValue(1)
                }
            }
            IfCondition EqualTo(LoopHome.rbx_free, 1) ThenBlock: {
                IfCondition EqualTo(LoopHome.lim_on, 1) ThenBlock: {
                    IfCondition EqualTo(AST_GetType(arg1), AST.IDENTIFIER) ThenBlock: {
                        IfCondition EqualTo(Optimize_NameEq(AST_GetData1(arg1), LoopHome.lim_name), 1) ThenBlock: {
                            Emit_HomeMove(13, 0)
                            ReturnValue(1)
                        }
                    }
                }
            }
            IfCondition EqualTo(Optimize_FrameCmpOk(arg1), 1) ThenBlock: {
                X86_CmpHomeMem(13, LoopHome.imm_val, 0)
                ReturnValue(1)
            }
            got = Optimize_LoadToRbx(arg1)
            IfCondition EqualTo(got, 0) ThenBlock: { ReturnValue(0) }
            Emit_HomeMove(13, 0)
            ReturnValue(1)
        }
        IfCondition EqualTo(Optimize_FrameCmpOk(arg0), 1) ThenBlock: {
            X86_CmpHomeMem(13, LoopHome.imm_val, 1)
            ReturnValue(1)
        }
        IfCondition EqualTo(Optimize_IsLeaf(arg0), 0) ThenBlock: { ReturnValue(0) }
        got = Compile_Expression(arg0)
        IfCondition EqualTo(got, 0) ThenBlock: { ReturnValue(0) }
        Emit_HomeMove(14, 0)
        ReturnValue(1)
    }
}

Function.Optimize_LoadLeafXmm {
    Input: node: Address
    Input: which: Integer
    Output: Integer
    Body: {
        node_type = AST_GetType(node)
        IfCondition EqualTo(node_type, AST.IDENTIFIER) ThenBlock: {
            name = AST_GetData1(node)
            IfCondition EqualTo(Optimize_IsFltHome(name), 1) ThenBlock: {
                slot = Optimize_FltSlot(name)
                IfCondition EqualTo(slot, 2) ThenBlock: {
                    IfCondition EqualTo(which, 0) ThenBlock: { Emit_HomeMove(7, 0) }
                    IfCondition EqualTo(which, 1) ThenBlock: { Emit_HomeMove(8, 0) }
                }
                IfCondition GreaterThan(slot, 2) ThenBlock: {
                    IfCondition EqualTo(which, 0) ThenBlock: { X86_XmmRR(3, slot) }
                    IfCondition EqualTo(which, 1) ThenBlock: { X86_XmmRR(8, slot) }
                }
                ReturnValue(1)
            }
            IfCondition EqualTo(Optimize_AliasFind(name), 1) ThenBlock: {
                IfCondition EqualTo(which, 0) ThenBlock: { Emit_HomeMove(24, LoopHome.hit_disp) }
                IfCondition EqualTo(which, 1) ThenBlock: { Emit_HomeMove(29, LoopHome.hit_disp) }
                ReturnValue(1)
            }
            IfCondition EqualTo(LoopHome.hold_on, 1) ThenBlock: {
                IfCondition EqualTo(Optimize_NameEq(name, LoopHome.hold_name), 1) ThenBlock: {
                    IfCondition EqualTo(which, 1) ThenBlock: { Emit_HomeMove(37, 0) }
                    ReturnValue(1)
                }
            }
            IfCondition EqualTo(Optimize_RldFind(name), 1) ThenBlock: {
                IfCondition EqualTo(LoopHome.rld_kind, 1) ThenBlock: {
                    X86_MovsdPtr(which, LoopHome.rld_reg, LoopHome.rld_disp)
                    ReturnValue(1)
                }
            }
        }
        result = Compile_Expression(node)
        IfCondition EqualTo(result, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(which, 0) ThenBlock: { Emit_HomeMove(11, 0) }
        IfCondition EqualTo(which, 1) ThenBlock: { Emit_HomeMove(10, 0) }
        ReturnValue(1)
    }
}

// The live xmm0 hold. Loading anything else first would replace it.
Function.Optimize_IsXmmHold {
    Input: node: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(LoopHome.hold_on, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(node), AST.IDENTIFIER) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_NameEq(AST_GetData1(node), LoopHome.hold_name), 1) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

// Result is left in xmm0 by the float emitter. Integer results are not.
Function.Optimize_FltProducer {
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(StringCompare(name, "Float_Add"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "Float_Sub"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "Float_Mul"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "Float_Div"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "Float_Min"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "Float_Max"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "Float_Neg"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "Float_Abs"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "Float_Sqrt"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "Float_FromInt"), 0) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

Function.Optimize_GprName {
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(StringCompare(name, "Add"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "Subtract"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "Multiply"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "Divide"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "Modulo"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "Negate"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "BitwiseAnd"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "BitwiseOr"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "BitwiseXor"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "BitwiseNot"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "LeftShift"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "RightShift"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "BitAnd"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "BitOr"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "BitXor"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "BitNot"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "ShiftLeft"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "ShiftRight"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "Dereference"), 0) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

// True when evaluating the node writes only general registers.
// xmm0 can keep the other operand of a float operation.
Function.Optimize_GprSafe {
    Input: node: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_IsXmmHold(node), 1) ThenBlock: { ReturnValue(0) }
        nt = AST_GetType(node)
        IfCondition EqualTo(nt, AST.NUMBER) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(nt, AST.IDENTIFIER) ThenBlock: { ReturnValue(1) }
        IfCondition NotEqual(nt, AST.CALL) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_GprName(AST_GetData1(node)), 0) ThenBlock: { ReturnValue(0) }
        count = AST_GetChildCount(node)
        i = 0
        ok = 1
        WhileLoop LessThan(i, count) {
            IfCondition EqualTo(Optimize_GprSafe(AST_GetChild(node, i)), 0) ThenBlock: { ok = 0 }
            i = Add(i, 1)
        }
        ReturnValue(ok)
    }
}

// Leave this operand in xmm0. A float child is asked to skip the rax copy.
Function.Optimize_CompileXmm {
    Input: node: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(Optimize_IsXmmHold(node), 1) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(Optimize_IsLeaf(node), 1) ThenBlock: { ReturnValue(Optimize_LoadLeafXmm(node, 0)) }
        saved = OptState.xmm_out
        IfCondition EqualTo(AST_GetType(node), AST.CALL) ThenBlock: {
            IfCondition EqualTo(Optimize_FltProducer(AST_GetData1(node)), 1) ThenBlock: {
                OptState.xmm_out = 1
                got = Compile_Expression(node)
                OptState.xmm_out = saved
                ReturnValue(got)
            }
        }
        OptState.xmm_out = 0
        got = Compile_Expression(node)
        OptState.xmm_out = saved
        IfCondition EqualTo(got, 0) ThenBlock: { ReturnValue(0) }
        X86Enc_Assemble("MOVQ xmm0, rax")
        ReturnValue(1)
    }
}

// Scale constant 1, 2, 4, or 8. Anything else, including a name, is 0.
Function.Optimize_ScaleValue {
    Input: node: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(node), AST.NUMBER) ThenBlock: { ReturnValue(0) }
        sv = StringToNumber(AST_GetData1(node))
        IfCondition EqualTo(sv, 1) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(sv, 2) ThenBlock: { ReturnValue(2) }
        IfCondition EqualTo(sv, 4) ThenBlock: { ReturnValue(4) }
        IfCondition EqualTo(sv, 8) ThenBlock: { ReturnValue(8) }
        ReturnValue(0)
    }
}

// Dereference(Add(base, Multiply(index, 1/2/4/8))). The scale may sit on
// either side of the multiply. The base is a name. Returns the scale, or 0.
Function.Optimize_QwordScale {
    Input: node: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(node), AST.CALL) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_NameEq(AST_GetData1(node), "Dereference"), 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetChildCount(node), 1) ThenBlock: { ReturnValue(0) }
        addr = AST_GetChild(node, 0)
        IfCondition EqualTo(addr, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(addr), AST.CALL) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_NameEq(AST_GetData1(addr), "Add"), 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetChildCount(addr), 2) ThenBlock: { ReturnValue(0) }
        base = AST_GetChild(addr, 0)
        mul = AST_GetChild(addr, 1)
        IfCondition EqualTo(base, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(base), AST.IDENTIFIER) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(mul, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(mul), AST.CALL) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_NameEq(AST_GetData1(mul), "Multiply"), 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetChildCount(mul), 2) ThenBlock: { ReturnValue(0) }
        right = AST_GetChild(mul, 1)
        sv = Optimize_ScaleValue(right)
        IfCondition EqualTo(sv, 0) ThenBlock: {
            left = AST_GetChild(mul, 0)
            sv = Optimize_ScaleValue(left)
        }
        ReturnValue(sv)
    }
}

Function.Optimize_QwordBase {
    Input: node: Address
    Output: Address
    Body: {
        IfCondition EqualTo(Optimize_QwordScale(node), 0) ThenBlock: { ReturnValue(0) }
        addr = AST_GetChild(node, 0)
        ReturnValue(AST_GetChild(addr, 0))
    }
}

Function.Optimize_QwordIndex {
    Input: node: Address
    Output: Address
    Body: {
        IfCondition EqualTo(Optimize_QwordScale(node), 0) ThenBlock: { ReturnValue(0) }
        addr = AST_GetChild(node, 0)
        mul = AST_GetChild(addr, 1)
        right = AST_GetChild(mul, 1)
        IfCondition GreaterThan(Optimize_ScaleValue(right), 0) ThenBlock: {
            ReturnValue(AST_GetChild(mul, 0))
        }
        ReturnValue(right)
    }
}

// Names whose own instruction does not write r14. Children are checked
// separately. A name missing from this list is treated as a writer.
Function.Optimize_R14SafeName {
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(StringCompare(name, "Add"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "Subtract"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "Multiply"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "Divide"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "Modulo"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "Negate"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "BitwiseAnd"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "BitwiseOr"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "BitwiseXor"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "BitwiseNot"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "BitAnd"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "BitOr"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "BitXor"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "BitNot"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "LeftShift"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "RightShift"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "ShiftLeft"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "ShiftRight"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "EqualTo"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "NotEqual"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "LessThan"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "GreaterThan"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "LessEqual"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "GreaterEqual"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(Optimize_FltProducer(name), 1) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "Float_ToInt"), 0) ThenBlock: { ReturnValue(1) }
        // Float compares and the byte ops use rax, xmm0, xmm1, rbx, rcx, or
        // rdi. They read r14 when it is the base. They do not write it.
        IfCondition EqualTo(StringCompare(name, "Float_Eq"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "Float_Ne"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "Float_Lt"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "Float_Gt"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "Float_Le"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "Float_Ge"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "GetByte"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "SetByte"), 0) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

// 1 when compiling this tree can leave r14 holding something other than
// the active table. A scaled load of that table keeps r14. Unknown calls
// are writers, so the base is reloaded instead of trusting r14.
Function.Optimize_WritesR14 {
    Input: node: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        nt = AST_GetType(node)
        IfCondition EqualTo(nt, AST.INLINEASM) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(nt, AST.CALL) ThenBlock: {
            nm = AST_GetData1(node)
            IfCondition EqualTo(Optimize_NameEq(nm, "Dereference"), 1) ThenBlock: {
                sc = Optimize_QwordScale(node)
                IfCondition GreaterThan(sc, 0) ThenBlock: {
                    base = Optimize_QwordBase(node)
                    keep = 0
                    IfCondition EqualTo(LoopHome.tab_on, 1) ThenBlock: {
                        IfCondition EqualTo(Optimize_NameEq(AST_GetData1(base), LoopHome.tab_name), 1) ThenBlock: {
                            keep = 1
                        }
                    }
                    IfCondition EqualTo(keep, 1) ThenBlock: {
                        ReturnValue(Optimize_WritesR14(Optimize_QwordIndex(node)))
                    }
                    ReturnValue(1)
                }
            } ElseBlock: {
                IfCondition EqualTo(Optimize_R14SafeName(nm), 0) ThenBlock: { ReturnValue(1) }
            }
        }
        count = AST_GetChildCount(node)
        i = 0
        WhileLoop LessThan(i, count) {
            IfCondition EqualTo(Optimize_WritesR14(AST_GetChild(node, i)), 1) ThenBlock: { ReturnValue(1) }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

// The table home is already in r14, and neither the index nor the other
// operand of the float operation replaces it.
Function.Optimize_QwordFast {
    Input: deref: Address
    Input: other: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(LoopHome.tab_on, 0) ThenBlock: { ReturnValue(0) }
        base = Optimize_QwordBase(deref)
        IfCondition EqualTo(base, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_NameEq(AST_GetData1(base), LoopHome.tab_name), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_WritesR14(Optimize_QwordIndex(deref)), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_WritesR14(other), 1) ThenBlock: { ReturnValue(0) }
        ReturnValue(1)
    }
}

// An identifier base can be loaded into r14 without touching xmm0.
Function.Optimize_BaseLoadOk {
    Input: base: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(base, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(base), AST.IDENTIFIER) ThenBlock: { ReturnValue(0) }
        name = AST_GetData1(base)
        IfCondition EqualTo(Optimize_IsIntHome(name), 1) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(Optimize_IsAccHome(name), 1) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(Optimize_IsFltHome(name), 1) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(Optimize_IsXmmHold(base), 1) ThenBlock: { ReturnValue(1) }
        Scope_Resolve(name)
        IfCondition EqualTo(Scope.resolve_type, 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(1)
    }
}

// The dereference can be the memory operand. The index only writes general
// registers, and the base is either the live table or a reloadable name.
Function.Optimize_QwordMemOk {
    Input: deref: Address
    Input: other: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(Optimize_QwordScale(deref), 0) ThenBlock: { ReturnValue(0) }
        index = Optimize_QwordIndex(deref)
        IfCondition EqualTo(Optimize_GprSafe(index), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_QwordFast(deref, other), 1) ThenBlock: { ReturnValue(1) }
        ReturnValue(Optimize_BaseLoadOk(Optimize_QwordBase(deref)))
    }
}

// Index into rcx, then the base into r14 if the table home is not already it.
// xmm0 holds the other operand and is not written. Returns 0 after a partial
// emit; the caller must not emit the load a second time.
Function.Optimize_QwordMemAddr {
    Input: deref: Address
    Input: other: Address
    Output: Integer
    Body: {
        index = Optimize_QwordIndex(deref)
        base = Optimize_QwordBase(deref)
        placed = 0
        LoopHome.sib_index = 1
        IfCondition EqualTo(AST_GetType(index), AST.IDENTIFIER) ThenBlock: {
            inm = AST_GetData1(index)
            IfCondition EqualTo(Optimize_IsIntHome(inm), 1) ThenBlock: {
                LoopHome.sib_index = 13
                placed = 1
            }
            IfCondition EqualTo(placed, 0) ThenBlock: {
                IfCondition EqualTo(Optimize_IsAccHome(inm), 1) ThenBlock: {
                    LoopHome.sib_index = 12
                    placed = 1
                }
            }
        }
        IfCondition EqualTo(placed, 0) ThenBlock: {
            got = Optimize_LoadToRax(index)
            IfCondition EqualTo(got, 0) ThenBlock: {
                saved = OptState.xmm_out
                OptState.xmm_out = 0
                got = Compile_Expression(index)
                OptState.xmm_out = saved
                IfCondition EqualTo(got, 0) ThenBlock: { ReturnValue(0) }
            }
            Emit_MovRcxRax()
        }
        IfCondition EqualTo(Optimize_QwordFast(deref, other), 1) ThenBlock: { ReturnValue(1) }
        got = Optimize_LoadToRax(base)
        IfCondition EqualTo(got, 0) ThenBlock: { ReturnValue(0) }
        Emit_MovR14Rax()
        ReturnValue(1)
    }
}

// A non-table base is copied into r14 for the scaled load. Put the table
// home back so the next use of that home still addresses the table.
Function.Optimize_QwordRestore {
    Input: deref: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(LoopHome.tab_on, 0) ThenBlock: { ReturnValue(0) }
        base = Optimize_QwordBase(deref)
        IfCondition EqualTo(base, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_NameEq(AST_GetData1(base), LoopHome.tab_name), 1) ThenBlock: { ReturnValue(0) }
        Emit_MovRaxRbpOffset(LoopHome.tab_off)
        Emit_MovR14Rax()
        ReturnValue(0)
    }
}

// =============================================================================
// DEBUG CONTROL
// =============================================================================
Function.Optimize_NameEq {
    Input: a: Address
    Input: b: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(a, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(b, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(StringCompare(a, b), 0) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

Function.Optimize_AliasClearAll {
    Body: {
        LoopHome.a0_on = 0
        LoopHome.a1_on = 0
        LoopHome.a2_on = 0
        LoopHome.a3_on = 0
    }
}

Function.Optimize_AliasFind {
    Input: name: Address
    Output: Integer
    Body: {
        LoopHome.hit_on = 0
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(LoopHome.a0_on, 1) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(name, LoopHome.a0_name), 1) ThenBlock: {
                LoopHome.hit_on = 1
                LoopHome.hit_disp = LoopHome.a0_disp
                ReturnValue(1)
            }
        }
        IfCondition EqualTo(LoopHome.a1_on, 1) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(name, LoopHome.a1_name), 1) ThenBlock: {
                LoopHome.hit_on = 1
                LoopHome.hit_disp = LoopHome.a1_disp
                ReturnValue(1)
            }
        }
        IfCondition EqualTo(LoopHome.a2_on, 1) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(name, LoopHome.a2_name), 1) ThenBlock: {
                LoopHome.hit_on = 1
                LoopHome.hit_disp = LoopHome.a2_disp
                ReturnValue(1)
            }
        }
        IfCondition EqualTo(LoopHome.a3_on, 1) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(name, LoopHome.a3_name), 1) ThenBlock: {
                LoopHome.hit_on = 1
                LoopHome.hit_disp = LoopHome.a3_disp
                ReturnValue(1)
            }
        }
        ReturnValue(0)
    }
}

Function.Optimize_AliasClear {
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(LoopHome.a0_on, 1) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(name, LoopHome.a0_name), 1) ThenBlock: { LoopHome.a0_on = 0 }
        }
        IfCondition EqualTo(LoopHome.a1_on, 1) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(name, LoopHome.a1_name), 1) ThenBlock: { LoopHome.a1_on = 0 }
        }
        IfCondition EqualTo(LoopHome.a2_on, 1) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(name, LoopHome.a2_name), 1) ThenBlock: { LoopHome.a2_on = 0 }
        }
        IfCondition EqualTo(LoopHome.a3_on, 1) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(name, LoopHome.a3_name), 1) ThenBlock: { LoopHome.a3_on = 0 }
        }
        ReturnValue(0)
    }
}

Function.Optimize_AliasAdd {
    Input: name: Address
    Input: disp: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(Optimize_AliasFind(name), 1) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(name, LoopHome.a0_name), 1) ThenBlock: {
                IfCondition EqualTo(LoopHome.a0_on, 1) ThenBlock: {
                    LoopHome.a0_disp = disp
                    ReturnValue(1)
                }
            }
            IfCondition EqualTo(Optimize_NameEq(name, LoopHome.a1_name), 1) ThenBlock: {
                IfCondition EqualTo(LoopHome.a1_on, 1) ThenBlock: {
                    LoopHome.a1_disp = disp
                    ReturnValue(1)
                }
            }
            IfCondition EqualTo(Optimize_NameEq(name, LoopHome.a2_name), 1) ThenBlock: {
                IfCondition EqualTo(LoopHome.a2_on, 1) ThenBlock: {
                    LoopHome.a2_disp = disp
                    ReturnValue(1)
                }
            }
            IfCondition EqualTo(Optimize_NameEq(name, LoopHome.a3_name), 1) ThenBlock: {
                IfCondition EqualTo(LoopHome.a3_on, 1) ThenBlock: {
                    LoopHome.a3_disp = disp
                    ReturnValue(1)
                }
            }
        }
        IfCondition EqualTo(LoopHome.a0_on, 0) ThenBlock: {
            LoopHome.a0_on = 1
            LoopHome.a0_name = name
            LoopHome.a0_disp = disp
            ReturnValue(1)
        }
        IfCondition EqualTo(LoopHome.a1_on, 0) ThenBlock: {
            LoopHome.a1_on = 1
            LoopHome.a1_name = name
            LoopHome.a1_disp = disp
            ReturnValue(1)
        }
        IfCondition EqualTo(LoopHome.a2_on, 0) ThenBlock: {
            LoopHome.a2_on = 1
            LoopHome.a2_name = name
            LoopHome.a2_disp = disp
            ReturnValue(1)
        }
        IfCondition EqualTo(LoopHome.a3_on, 0) ThenBlock: {
            LoopHome.a3_on = 1
            LoopHome.a3_name = name
            LoopHome.a3_disp = disp
            ReturnValue(1)
        }
        ReturnValue(0)
    }
}

Function.Optimize_AliasFlush {
    Body: {
        on0 = LoopHome.a0_on
        n0 = LoopHome.a0_name
        d0 = LoopHome.a0_disp
        on1 = LoopHome.a1_on
        n1 = LoopHome.a1_name
        d1 = LoopHome.a1_disp
        on2 = LoopHome.a2_on
        n2 = LoopHome.a2_name
        d2 = LoopHome.a2_disp
        on3 = LoopHome.a3_on
        n3 = LoopHome.a3_name
        d3 = LoopHome.a3_disp
        Optimize_AliasClearAll()
        IfCondition EqualTo(on0, 1) ThenBlock: {
            Emit_HomeMove(12, d0)
            CompileExpr_StoreVariable(n0)
        }
        IfCondition EqualTo(on1, 1) ThenBlock: {
            Emit_HomeMove(12, d1)
            CompileExpr_StoreVariable(n1)
        }
        IfCondition EqualTo(on2, 1) ThenBlock: {
            Emit_HomeMove(12, d2)
            CompileExpr_StoreVariable(n2)
        }
        IfCondition EqualTo(on3, 1) ThenBlock: {
            Emit_HomeMove(12, d3)
            CompileExpr_StoreVariable(n3)
        }
    }
}

Function.Optimize_AliasOnCursor {
    Body: {
        Optimize_PtrClearAll()
        IfCondition EqualTo(LoopHome.alias_spill, 1) ThenBlock: {
            Optimize_AliasFlush()
        } ElseBlock: {
            Optimize_AliasClearAll()
        }
    }
}

// A pointer alias says the local holds the homed cursor plus a displacement.
// rec = cursor, then rec@w, is the same address as Dereference(Add(cursor, 8)).
// The field load uses r13. The null test stays on the stack-reload path.
Function.Optimize_PtrClearAll {
    Body: {
        LoopHome.p0_on = 0
        LoopHome.p1_on = 0
        LoopHome.p2_on = 0
        LoopHome.p3_on = 0
    }
}

Function.Optimize_PtrFind {
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(LoopHome.p0_on, 1) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(name, LoopHome.p0_name), 1) ThenBlock: {
                LoopHome.hit_disp = LoopHome.p0_disp
                ReturnValue(1)
            }
        }
        IfCondition EqualTo(LoopHome.p1_on, 1) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(name, LoopHome.p1_name), 1) ThenBlock: {
                LoopHome.hit_disp = LoopHome.p1_disp
                ReturnValue(1)
            }
        }
        IfCondition EqualTo(LoopHome.p2_on, 1) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(name, LoopHome.p2_name), 1) ThenBlock: {
                LoopHome.hit_disp = LoopHome.p2_disp
                ReturnValue(1)
            }
        }
        IfCondition EqualTo(LoopHome.p3_on, 1) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(name, LoopHome.p3_name), 1) ThenBlock: {
                LoopHome.hit_disp = LoopHome.p3_disp
                ReturnValue(1)
            }
        }
        ReturnValue(0)
    }
}

Function.Optimize_PtrClear {
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(LoopHome.p0_on, 1) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(name, LoopHome.p0_name), 1) ThenBlock: { LoopHome.p0_on = 0 }
        }
        IfCondition EqualTo(LoopHome.p1_on, 1) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(name, LoopHome.p1_name), 1) ThenBlock: { LoopHome.p1_on = 0 }
        }
        IfCondition EqualTo(LoopHome.p2_on, 1) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(name, LoopHome.p2_name), 1) ThenBlock: { LoopHome.p2_on = 0 }
        }
        IfCondition EqualTo(LoopHome.p3_on, 1) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(name, LoopHome.p3_name), 1) ThenBlock: { LoopHome.p3_on = 0 }
        }
        ReturnValue(0)
    }
}

Function.Optimize_PtrAdd {
    Input: name: Address
    Input: disp: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(Optimize_PtrFind(name), 1) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(name, LoopHome.p0_name), 1) ThenBlock: {
                IfCondition EqualTo(LoopHome.p0_on, 1) ThenBlock: {
                    LoopHome.p0_disp = disp
                    ReturnValue(1)
                }
            }
            IfCondition EqualTo(Optimize_NameEq(name, LoopHome.p1_name), 1) ThenBlock: {
                IfCondition EqualTo(LoopHome.p1_on, 1) ThenBlock: {
                    LoopHome.p1_disp = disp
                    ReturnValue(1)
                }
            }
            IfCondition EqualTo(Optimize_NameEq(name, LoopHome.p2_name), 1) ThenBlock: {
                IfCondition EqualTo(LoopHome.p2_on, 1) ThenBlock: {
                    LoopHome.p2_disp = disp
                    ReturnValue(1)
                }
            }
            IfCondition EqualTo(Optimize_NameEq(name, LoopHome.p3_name), 1) ThenBlock: {
                IfCondition EqualTo(LoopHome.p3_on, 1) ThenBlock: {
                    LoopHome.p3_disp = disp
                    ReturnValue(1)
                }
            }
        }
        IfCondition EqualTo(LoopHome.p0_on, 0) ThenBlock: {
            LoopHome.p0_on = 1
            LoopHome.p0_name = name
            LoopHome.p0_disp = disp
            ReturnValue(1)
        }
        IfCondition EqualTo(LoopHome.p1_on, 0) ThenBlock: {
            LoopHome.p1_on = 1
            LoopHome.p1_name = name
            LoopHome.p1_disp = disp
            ReturnValue(1)
        }
        IfCondition EqualTo(LoopHome.p2_on, 0) ThenBlock: {
            LoopHome.p2_on = 1
            LoopHome.p2_name = name
            LoopHome.p2_disp = disp
            ReturnValue(1)
        }
        IfCondition EqualTo(LoopHome.p3_on, 0) ThenBlock: {
            LoopHome.p3_on = 1
            LoopHome.p3_name = name
            LoopHome.p3_disp = disp
            ReturnValue(1)
        }
        ReturnValue(0)
    }
}

Function.Optimize_NotePtrCopy {
    Input: target: Address
    Input: value: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(LoopHome.active, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_IsIntHome(target), 1) ThenBlock: {
            Optimize_PtrClearAll()
            ReturnValue(0)
        }
        IfCondition EqualTo(Optimize_CursorDisp(value), 0) ThenBlock: {
            Optimize_PtrClear(target)
            ReturnValue(0)
        }
        ReturnValue(Optimize_PtrAdd(target, LoopHome.imm_val))
    }
}

// Sets hit_disp to the r13 displacement of this field. 0 means use the stack path.
Function.Optimize_FieldHomeDisp {
    Input: base: Address
    Input: offset: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(LoopHome.active, 0) ThenBlock: { ReturnValue(0) }
        disp = -1
        IfCondition EqualTo(Optimize_IsIntHome(base), 1) ThenBlock: {
            disp = 0
        }
        IfCondition EqualTo(disp, -1) ThenBlock: {
            IfCondition EqualTo(Optimize_PtrFind(base), 1) ThenBlock: {
                disp = LoopHome.hit_disp
            }
        }
        IfCondition LessThan(disp, 0) ThenBlock: { ReturnValue(0) }
        total = Add(disp, offset)
        IfCondition LessThan(total, 0) ThenBlock: { ReturnValue(0) }
        LoopHome.hit_disp = total
        ReturnValue(1)
    }
}

// A plain field is one qword. Nested records and pointer fields stay on the
// normal path so their pool type is still recorded.
Function.Optimize_FieldPlain {
    Input: base: Address
    Input: field: Address
    Output: Integer
    Body: {
        LoopHome.imm_ok = 0
        IfCondition EqualTo(base, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(field, 0) ThenBlock: { ReturnValue(0) }
        pool_type = Scope_GetVarPoolType(base)
        IfCondition EqualTo(pool_type, 0) ThenBlock: { ReturnValue(0) }
        pool_name = Pool_ExtractPoolName(pool_type)
        entry = Pool_FindField(pool_name, field)
        IfCondition EqualTo(entry, 0) ThenBlock: { ReturnValue(0) }
        ftype = Dereference(Add(entry, 24))
        IfCondition EqualTo(ftype, PoolConst.TYPE_NESTED) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(ftype, PoolConst.TYPE_POINTER) ThenBlock: { ReturnValue(0) }
        direction = Dereference(Add(entry, 16))
        IfCondition EqualTo(Scope_IsParameter(base), 1) ThenBlock: {
            IfCondition EqualTo(direction, PoolConst.DIR_OUTPUT) ThenBlock: { ReturnValue(0) }
        }
        off = Dereference(Add(entry, 8))
        IfCondition LessThan(off, 0) ThenBlock: { ReturnValue(0) }
        LoopHome.imm_ok = 1
        LoopHome.imm_val = off
        ReturnValue(1)
    }
}

// w = rec@w, when rec is the homed cursor or a straight-line copy of it,
// is the same value as Dereference(Add(cursor, disp)). The copy has to be
// a direct statement of this loop body, before this read, with no store
// to the cursor in between.
Function.Optimize_FieldMemDisp {
    Input: target: Address
    Input: value: Address
    Output: Integer
    Body: {
        LoopHome.imm_ok = 0
        IfCondition EqualTo(target, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(value, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(LoopHome.int_name, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_NameEq(target, LoopHome.int_name), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_NameEq(target, LoopHome.flt_name), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_NameEq(target, LoopHome.f2_name), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_NameEq(target, LoopHome.f3_name), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_NameEq(target, LoopHome.f4_name), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_NameEq(target, LoopHome.f5_name), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_NameEq(target, LoopHome.f6_name), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_XfHas(target), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_NameEq(target, LoopHome.acc_name), 1) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(value), AST.POINTER_FIELD_ACCESS) ThenBlock: { ReturnValue(0) }
        base = AST_GetData1(value)
        field = AST_GetData2(value)
        IfCondition EqualTo(Optimize_FieldPlain(base, field), 0) ThenBlock: { ReturnValue(0) }
        field_off = LoopHome.imm_val
        body = LoopHome.body
        IfCondition EqualTo(body, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(body), AST.BLOCK) ThenBlock: { ReturnValue(0) }
        found = -1
        count = AST_GetChildCount(body)
        i = 0
        WhileLoop LessThan(i, count) {
            st = AST_GetChild(body, i)
            IfCondition NotEqual(st, 0) ThenBlock: {
                IfCondition EqualTo(AST_GetType(st), AST.ASSIGNMENT) ThenBlock: {
                    IfCondition EqualTo(AST_GetData2(st), 0) ThenBlock: {
                        IfCondition EqualTo(AST_GetChild(st, 0), value) ThenBlock: {
                            IfCondition EqualTo(Optimize_NameEq(AST_GetData1(st), target), 1) ThenBlock: {
                                found = i
                                i = count
                            }
                        }
                    }
                }
            }
            i = Add(i, 1)
        }
        IfCondition LessThan(found, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_NameEq(base, LoopHome.int_name), 1) ThenBlock: {
            LoopHome.imm_ok = 1
            LoopHome.imm_val = field_off
            ReturnValue(1)
        }
        last = -1
        j = 0
        WhileLoop LessThan(j, found) {
            sj = AST_GetChild(body, j)
            IfCondition NotEqual(sj, 0) ThenBlock: {
                IfCondition EqualTo(AST_GetType(sj), AST.ASSIGNMENT) ThenBlock: {
                    IfCondition EqualTo(AST_GetData2(sj), 0) ThenBlock: {
                        tname = AST_GetData1(sj)
                        IfCondition EqualTo(Optimize_NameEq(tname, LoopHome.int_name), 1) ThenBlock: {
                            last = -1
                        }
                        IfCondition EqualTo(Optimize_NameEq(tname, base), 1) ThenBlock: {
                            last = j
                        }
                    }
                }
            }
            j = Add(j, 1)
        }
        IfCondition LessThan(last, 0) ThenBlock: { ReturnValue(0) }
        src = AST_GetChild(AST_GetChild(body, last), 0)
        IfCondition EqualTo(Optimize_CursorDisp(src), 0) ThenBlock: { ReturnValue(0) }
        total = Add(LoopHome.imm_val, field_off)
        IfCondition LessThan(total, 0) ThenBlock: { ReturnValue(0) }
        LoopHome.imm_ok = 1
        LoopHome.imm_val = total
        ReturnValue(1)
    }
}

Function.Optimize_MemAliasShape {
    Input: target: Address
    Input: value: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(Optimize_DerefAliasShape(target, value), 1) ThenBlock: { ReturnValue(1) }
        ReturnValue(Optimize_FieldMemDisp(target, value))
    }
}

// rec = cursor does not use rbx. An Add into that copy does, so it stays
// off this list and still counts as a cursor copy for the field displacement.
Function.Optimize_PtrCopyShape {
    Input: target: Address
    Input: value: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(target, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(value, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(LoopHome.int_name, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_NameEq(target, LoopHome.int_name), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_NameEq(target, LoopHome.flt_name), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_NameEq(target, LoopHome.f2_name), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_NameEq(target, LoopHome.f3_name), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_NameEq(target, LoopHome.f4_name), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_NameEq(target, LoopHome.f5_name), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_NameEq(target, LoopHome.f6_name), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_XfHas(target), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_NameEq(target, LoopHome.acc_name), 1) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(value), AST.IDENTIFIER) ThenBlock: { ReturnValue(0) }
        ReturnValue(Optimize_CursorDisp(value))
    }
}

Function.Optimize_FlushHold {
    Output: Integer
    Body: {
        IfCondition EqualTo(LoopHome.hold_on, 0) ThenBlock: { ReturnValue(0) }
        hold_name = LoopHome.hold_name
        LoopHome.hold_on = 0
        LoopHome.hold_name = 0
        Emit_HomeMove(30, 0)
        CompileExpr_StoreVariable(hold_name)
        ReturnValue(0)
    }
}

Function.Optimize_CursorDisp {
    Input: node: Address
    Output: Integer
    Body: {
        LoopHome.imm_ok = 0
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(LoopHome.int_name, 0) ThenBlock: { ReturnValue(0) }
        at = AST_GetType(node)
        IfCondition EqualTo(at, AST.IDENTIFIER) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(AST_GetData1(node), LoopHome.int_name), 1) ThenBlock: {
                LoopHome.imm_ok = 1
                LoopHome.imm_val = 0
                ReturnValue(1)
            }
            ReturnValue(0)
        }
        IfCondition NotEqual(at, AST.CALL) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(StringCompare(AST_GetData1(node), "Add"), 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetChildCount(node), 2) ThenBlock: { ReturnValue(0) }
        a0 = AST_GetChild(node, 0)
        a1 = AST_GetChild(node, 1)
        imm_side = -1
        IfCondition EqualTo(Optimize_ReadImm(a1), 1) ThenBlock: {
            imm_side = 1
        } ElseBlock: {
            IfCondition EqualTo(Optimize_ReadImm(a0), 1) ThenBlock: {
                imm_side = 0
            }
        }
        IfCondition LessThan(imm_side, 0) ThenBlock: { ReturnValue(0) }
        other = a0
        IfCondition EqualTo(imm_side, 0) ThenBlock: { other = a1 }
        IfCondition EqualTo(other, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(other), AST.IDENTIFIER) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_NameEq(AST_GetData1(other), LoopHome.int_name), 0) ThenBlock: { ReturnValue(0) }
        LoopHome.imm_ok = 1
        ReturnValue(1)
    }
}

Function.Optimize_DerefAliasShape {
    Input: target: Address
    Input: value: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(target, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(value, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_NameEq(target, LoopHome.int_name), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_NameEq(target, LoopHome.flt_name), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_NameEq(target, LoopHome.f2_name), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_NameEq(target, LoopHome.f3_name), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_NameEq(target, LoopHome.f4_name), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_NameEq(target, LoopHome.f5_name), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_NameEq(target, LoopHome.f6_name), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_XfHas(target), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_NameEq(target, LoopHome.acc_name), 1) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(value), AST.CALL) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(StringCompare(AST_GetData1(value), "Dereference"), 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetChildCount(value), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_CursorDisp(AST_GetChild(value, 0)), 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(1)
    }
}

Function.Optimize_CursorAddShape {
    Input: target: Address
    Input: value: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(Optimize_NameEq(target, LoopHome.int_name), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(value, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(value), AST.CALL) ThenBlock: { ReturnValue(0) }
        opname = AST_GetData1(value)
        is_add = 0
        is_sub = 0
        IfCondition EqualTo(StringCompare(opname, "Add"), 0) ThenBlock: { is_add = 1 }
        IfCondition EqualTo(StringCompare(opname, "Subtract"), 0) ThenBlock: { is_sub = 1 }
        IfCondition EqualTo(is_add, 0) ThenBlock: {
            IfCondition EqualTo(is_sub, 0) ThenBlock: { ReturnValue(0) }
        }
        IfCondition NotEqual(AST_GetChildCount(value), 2) ThenBlock: { ReturnValue(0) }
        a0 = AST_GetChild(value, 0)
        a1 = AST_GetChild(value, 1)
        imm_side = -1
        IfCondition EqualTo(Optimize_ReadImm(a1), 1) ThenBlock: {
            imm_side = 1
        } ElseBlock: {
            IfCondition EqualTo(Optimize_ReadImm(a0), 1) ThenBlock: {
                imm_side = 0
            }
        }
        IfCondition LessThan(imm_side, 0) ThenBlock: { ReturnValue(0) }
        other = a0
        IfCondition EqualTo(imm_side, 0) ThenBlock: { other = a1 }
        IfCondition EqualTo(other, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(other), AST.IDENTIFIER) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_NameEq(AST_GetData1(other), target), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(is_sub, 1) ThenBlock: {
            IfCondition NotEqual(imm_side, 1) ThenBlock: { ReturnValue(0) }
        }
        ReturnValue(1)
    }
}

Function.Optimize_AccOther {
    Input: node: Address
    Output: Integer
    Body: {
        LoopHome.hit_class = 0
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(AST_GetType(node), AST.IDENTIFIER) ThenBlock: {
            nm = AST_GetData1(node)
            IfCondition EqualTo(Optimize_NameEq(nm, LoopHome.int_name), 1) ThenBlock: {
                LoopHome.hit_class = 5
                ReturnValue(5)
            }
            IfCondition EqualTo(Optimize_AliasFind(nm), 1) ThenBlock: {
                LoopHome.hit_class = 2
                ReturnValue(2)
            }
            ReturnValue(0)
        }
        IfCondition EqualTo(AST_GetType(node), AST.CALL) ThenBlock: {
            IfCondition EqualTo(StringCompare(AST_GetData1(node), "Dereference"), 0) ThenBlock: {
                IfCondition EqualTo(AST_GetChildCount(node), 1) ThenBlock: {
                    IfCondition EqualTo(Optimize_CursorDisp(AST_GetChild(node, 0)), 1) ThenBlock: {
                        LoopHome.hit_class = 4
                        LoopHome.hit_disp = LoopHome.imm_val
                        ReturnValue(4)
                    }
                }
            }
        }
        IfCondition EqualTo(Optimize_ReadImm(node), 1) ThenBlock: {
            LoopHome.hit_class = 7
            LoopHome.hit_disp = LoopHome.imm_val
            ReturnValue(7)
        }
        ReturnValue(0)
    }
}

Function.Optimize_AccShape {
    Input: target: Address
    Input: value: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(LoopHome.acc_name, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_NameEq(target, LoopHome.acc_name), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(value, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(value), AST.CALL) ThenBlock: { ReturnValue(0) }
        opname = AST_GetData1(value)
        is_add = 0
        is_sub = 0
        IfCondition EqualTo(StringCompare(opname, "Add"), 0) ThenBlock: { is_add = 1 }
        IfCondition EqualTo(StringCompare(opname, "Subtract"), 0) ThenBlock: { is_sub = 1 }
        IfCondition EqualTo(is_add, 0) ThenBlock: {
            IfCondition EqualTo(is_sub, 0) ThenBlock: { ReturnValue(0) }
        }
        IfCondition NotEqual(AST_GetChildCount(value), 2) ThenBlock: { ReturnValue(0) }
        a0 = AST_GetChild(value, 0)
        a1 = AST_GetChild(value, 1)
        left_acc = 0
        right_acc = 0
        IfCondition EqualTo(AST_GetType(a0), AST.IDENTIFIER) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(AST_GetData1(a0), LoopHome.acc_name), 1) ThenBlock: { left_acc = 1 }
        }
        IfCondition EqualTo(AST_GetType(a1), AST.IDENTIFIER) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(AST_GetData1(a1), LoopHome.acc_name), 1) ThenBlock: { right_acc = 1 }
        }
        other = 0
        IfCondition EqualTo(is_add, 1) ThenBlock: {
            IfCondition EqualTo(left_acc, 1) ThenBlock: {
                IfCondition EqualTo(right_acc, 0) ThenBlock: { other = a1 }
            }
            IfCondition EqualTo(right_acc, 1) ThenBlock: {
                IfCondition EqualTo(left_acc, 0) ThenBlock: { other = a0 }
            }
        }
        IfCondition EqualTo(is_sub, 1) ThenBlock: {
            IfCondition EqualTo(left_acc, 1) ThenBlock: {
                IfCondition EqualTo(right_acc, 0) ThenBlock: { other = a1 }
            }
        }
        IfCondition EqualTo(other, 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(Optimize_AccOther(other))
    }
}

Function.Optimize_FltOpKind {
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(StringCompare(name, "Float_Add"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "Float_Sub"), 0) ThenBlock: { ReturnValue(2) }
        IfCondition EqualTo(StringCompare(name, "Float_Mul"), 0) ThenBlock: { ReturnValue(3) }
        IfCondition EqualTo(StringCompare(name, "Float_Div"), 0) ThenBlock: { ReturnValue(4) }
        ReturnValue(0)
    }
}

Function.Optimize_RbxSafeOp {
    Input: node: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        nt = AST_GetType(node)
        IfCondition EqualTo(nt, AST.NUMBER) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(nt, AST.IDENTIFIER) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(nt, AST.CALL) ThenBlock: {
            IfCondition EqualTo(StringCompare(AST_GetData1(node), "Dereference"), 0) ThenBlock: {
                IfCondition EqualTo(AST_GetChildCount(node), 1) ThenBlock: {
                    IfCondition EqualTo(Optimize_CursorDisp(AST_GetChild(node, 0)), 1) ThenBlock: { ReturnValue(1) }
                }
            }
        }
        ReturnValue(0)
    }
}

Function.Optimize_OpClass {
    Input: node: Address
    Output: Integer
    Body: {
        LoopHome.hit_class = 0
        LoopHome.hit_disp = 0
        LoopHome.hit_xmm = 0
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        nt = AST_GetType(node)
        IfCondition EqualTo(nt, AST.IDENTIFIER) ThenBlock: {
            nm = AST_GetData1(node)
            IfCondition EqualTo(Optimize_IsFltHome(nm), 1) ThenBlock: {
                LoopHome.hit_class = 1
                LoopHome.hit_xmm = Optimize_FltSlot(nm)
                ReturnValue(1)
            }
            IfCondition EqualTo(LoopHome.hold_on, 1) ThenBlock: {
                IfCondition EqualTo(Optimize_NameEq(nm, LoopHome.hold_name), 1) ThenBlock: {
                    LoopHome.hit_class = 3
                    ReturnValue(1)
                }
            }
            IfCondition EqualTo(Optimize_AliasFind(nm), 1) ThenBlock: {
                LoopHome.hit_class = 2
                ReturnValue(1)
            }
            IfCondition EqualTo(Optimize_IsIntHome(nm), 1) ThenBlock: {
                LoopHome.hit_class = 5
                ReturnValue(1)
            }
            IfCondition EqualTo(Optimize_RldFind(nm), 1) ThenBlock: {
                IfCondition EqualTo(LoopHome.rld_kind, 1) ThenBlock: {
                    LoopHome.hit_class = 9
                    LoopHome.hit_disp = LoopHome.rld_disp
                    LoopHome.hit_xmm = LoopHome.rld_reg
                    ReturnValue(1)
                }
            }
            off = Scope_Resolve(nm)
            rt = Scope.resolve_type
            IfCondition EqualTo(rt, 3) ThenBlock: {
                pidx = BitwiseAnd(off, 2147483647)
                LoopHome.hit_class = 7
                LoopHome.hit_disp = Multiply(pidx, 8)
                ReturnValue(1)
            }
            frame = 0
            IfCondition EqualTo(rt, 1) ThenBlock: { frame = 1 }
            IfCondition EqualTo(rt, 2) ThenBlock: { frame = 1 }
            IfCondition EqualTo(frame, 1) ThenBlock: {
                IfCondition LessThan(off, 0) ThenBlock: {
                    LoopHome.hit_class = 6
                    LoopHome.hit_disp = off
                    ReturnValue(1)
                }
            }
            ReturnValue(0)
        }
        IfCondition EqualTo(nt, AST.CALL) ThenBlock: {
            IfCondition EqualTo(StringCompare(AST_GetData1(node), "Dereference"), 0) ThenBlock: {
                IfCondition EqualTo(AST_GetChildCount(node), 1) ThenBlock: {
                    IfCondition EqualTo(Optimize_CursorDisp(AST_GetChild(node, 0)), 1) ThenBlock: {
                        LoopHome.hit_class = 4
                        LoopHome.hit_disp = LoopHome.imm_val
                        ReturnValue(1)
                    }
                }
            }
        }
        IfCondition EqualTo(nt, AST.NUMBER) ThenBlock: {
            IfCondition EqualTo(OptState.flt_ready, 1) ThenBlock: {
                bits = StringToNumber(AST_GetData1(node))
                disp = Optimize_FltConstDisp(bits)
                IfCondition LessThan(disp, 0) ThenBlock: {
                    LoopHome.hit_class = 8
                    LoopHome.hit_disp = disp
                    ReturnValue(1)
                }
            }
            ReturnValue(0)
        }
        ReturnValue(0)
    }
}

Function.Optimize_TreeHasName {
    Input: node: Address
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }
        nt = AST_GetType(node)
        IfCondition EqualTo(nt, AST.IDENTIFIER) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(AST_GetData1(node), name), 1) ThenBlock: { ReturnValue(1) }
        }
        IfCondition EqualTo(nt, AST.ASSIGNMENT) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(AST_GetData1(node), name), 1) ThenBlock: { ReturnValue(1) }
        }
        count = AST_GetChildCount(node)
        i = 0
        WhileLoop LessThan(i, count) {
            IfCondition EqualTo(Optimize_TreeHasName(AST_GetChild(node, i), name), 1) ThenBlock: { ReturnValue(1) }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

Function.Optimize_TreeHasIdent {
    Input: node: Address
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }
        nt = AST_GetType(node)
        IfCondition EqualTo(nt, AST.IDENTIFIER) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(AST_GetData1(node), name), 1) ThenBlock: { ReturnValue(1) }
        }
        count = AST_GetChildCount(node)
        i = 0
        WhileLoop LessThan(i, count) {
            IfCondition EqualTo(Optimize_TreeHasIdent(AST_GetChild(node, i), name), 1) ThenBlock: { ReturnValue(1) }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

Function.Optimize_CountWalk {
    Input: node: Address
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        nt = AST_GetType(node)
        IfCondition EqualTo(nt, AST.IDENTIFIER) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(AST_GetData1(node), name), 1) ThenBlock: {
                LoopHome.mention_count = Add(LoopHome.mention_count, 1)
            }
        }
        IfCondition EqualTo(nt, AST.ASSIGNMENT) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(AST_GetData1(node), name), 1) ThenBlock: {
                LoopHome.mention_count = Add(LoopHome.mention_count, 1)
            }
        }
        count = AST_GetChildCount(node)
        i = 0
        WhileLoop LessThan(i, count) {
            Optimize_CountWalk(AST_GetChild(node, i), name)
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

Function.Optimize_CountMentions {
    Input: name: Address
    Output: Integer
    Body: {
        LoopHome.mention_count = 0
        Optimize_CountWalk(LoopHome.body, name)
        ReturnValue(LoopHome.mention_count)
    }
}

Function.Optimize_HoldOk {
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition NotEqual(Optimize_CountMentions(name), 2) ThenBlock: { ReturnValue(0) }
        body = LoopHome.body
        IfCondition EqualTo(body, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(body), AST.BLOCK) ThenBlock: { ReturnValue(0) }
        count = AST_GetChildCount(body)
        def_at = -1
        use_at = -1
        i = 0
        WhileLoop LessThan(i, count) {
            st = AST_GetChild(body, i)
            IfCondition NotEqual(st, 0) ThenBlock: {
                IfCondition EqualTo(AST_GetType(st), AST.ASSIGNMENT) ThenBlock: {
                    IfCondition EqualTo(Optimize_NameEq(AST_GetData1(st), name), 1) ThenBlock: {
                        IfCondition LessThan(def_at, 0) ThenBlock: { def_at = i }
                    }
                }
                IfCondition EqualTo(Optimize_TreeHasIdent(st, name), 1) ThenBlock: {
                    IfCondition LessThan(use_at, 0) ThenBlock: { use_at = i }
                }
            }
            i = Add(i, 1)
        }
        IfCondition LessThan(def_at, 0) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(use_at, 0) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterThan(use_at, def_at) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

Function.Optimize_AssignNested {
    Input: node: Address
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(AST_GetType(node), AST.ASSIGNMENT) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(AST_GetData1(node), name), 1) ThenBlock: {
                ReturnValue(1)
            }
        }
        count = AST_GetChildCount(node)
        i = 0
        WhileLoop LessThan(i, count) {
            IfCondition EqualTo(Optimize_AssignNested(AST_GetChild(node, i), name), 1) ThenBlock: {
                ReturnValue(1)
            }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

Function.Optimize_HoldIn {
    Input: block: Address
    Input: target: Address
    Input: value: Address
    Output: Integer
    Body: {
        body = block
        IfCondition EqualTo(body, 0) ThenBlock: { ReturnValue(0) }
        blk = 0
        IfCondition EqualTo(AST_GetType(body), AST.BLOCK) ThenBlock: { blk = 1 }
        IfCondition EqualTo(AST_GetType(body), AST.BODY) ThenBlock: { blk = 1 }
        IfCondition EqualTo(blk, 0) ThenBlock: { ReturnValue(0) }
        count = AST_GetChildCount(body)
        found = -1
        i = 0
        WhileLoop LessThan(i, count) {
            st = AST_GetChild(body, i)
            IfCondition NotEqual(st, 0) ThenBlock: {
                IfCondition EqualTo(AST_GetType(st), AST.ASSIGNMENT) ThenBlock: {
                    IfCondition EqualTo(AST_GetData2(st), 0) ThenBlock: {
                        IfCondition EqualTo(Optimize_NameEq(AST_GetData1(st), target), 1) ThenBlock: {
                            IfCondition EqualTo(AST_GetChild(st, 0), value) ThenBlock: {
                                found = i
                                i = count
                            }
                        }
                    }
                }
            }
            i = Add(i, 1)
        }
        IfCondition LessThan(found, 0) ThenBlock: { ReturnValue(0) }
        uses = 0
        k = Add(found, 1)
        WhileLoop LessThan(k, count) {
            sk = AST_GetChild(body, k)
            stop = 0
            IfCondition NotEqual(sk, 0) ThenBlock: {
                IfCondition EqualTo(AST_GetType(sk), AST.ASSIGNMENT) ThenBlock: {
                    IfCondition EqualTo(AST_GetData2(sk), 0) ThenBlock: {
                        IfCondition EqualTo(Optimize_NameEq(AST_GetData1(sk), target), 1) ThenBlock: {
                            stop = 1
                        }
                        IfCondition EqualTo(Optimize_CursorAddShape(AST_GetData1(sk), AST_GetChild(sk, 0)), 1) ThenBlock: {
                            stop = 1
                        }
                    }
                }
                IfCondition EqualTo(stop, 0) ThenBlock: {
                    nt = AST_GetType(sk)
                    nest = 0
                    IfCondition EqualTo(nt, AST.IF) ThenBlock: { nest = 1 }
                    IfCondition EqualTo(nt, AST.FORK) ThenBlock: { nest = 1 }
                    IfCondition EqualTo(nt, AST.SWITCH) ThenBlock: { nest = 1 }
                    IfCondition EqualTo(nt, AST.BRANCH) ThenBlock: { nest = 1 }
                    IfCondition EqualTo(nt, AST.WHILE) ThenBlock: { nest = 1 }
                    IfCondition EqualTo(nest, 1) ThenBlock: {
                        IfCondition EqualTo(Optimize_TreeHasIdent(sk, target), 1) ThenBlock: {
                            ReturnValue(0)
                        }
                    }
                    IfCondition EqualTo(Optimize_TreeHasIdent(sk, target), 1) ThenBlock: {
                        uses = Add(uses, 1)
                    }
                }
            }
            IfCondition EqualTo(stop, 1) ThenBlock: { k = count }
            k = Add(k, 1)
        }
        IfCondition EqualTo(uses, 1) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

Function.Optimize_HoldHere {
    Input: target: Address
    Input: value: Address
    Output: Integer
    Body: {
        ReturnValue(Optimize_HoldIn(LoopHome.body, target, value))
    }
}

Function.Optimize_HoldFind {
    Input: node: Address
    Input: target: Address
    Input: value: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        t = AST_GetType(node)
        IfCondition EqualTo(Optimize_FoldIsFn(t), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_FoldIsBlock(node), 1) ThenBlock: {
            count = AST_GetChildCount(node)
            i = 0
            WhileLoop LessThan(i, count) {
                st = AST_GetChild(node, i)
                IfCondition NotEqual(st, 0) ThenBlock: {
                    IfCondition EqualTo(AST_GetType(st), AST.ASSIGNMENT) ThenBlock: {
                        IfCondition EqualTo(AST_GetData2(st), 0) ThenBlock: {
                            IfCondition EqualTo(Optimize_NameEq(AST_GetData1(st), target), 1) ThenBlock: {
                                IfCondition EqualTo(AST_GetChild(st, 0), value) ThenBlock: {
                                    OptState.hold_block = node
                                    ReturnValue(1)
                                }
                            }
                        }
                    }
                }
                i = Add(i, 1)
            }
        }
        count = AST_GetChildCount(node)
        i = 0
        WhileLoop LessThan(i, count) {
            IfCondition EqualTo(Optimize_HoldFind(AST_GetChild(node, i), target, value), 1) ThenBlock: { ReturnValue(1) }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

Function.Optimize_HoldArm {
    Input: target: Address
    Input: value: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(LoopHome.body, 0) ThenBlock: { ReturnValue(0) }
        OptState.hold_block = 0
        IfCondition EqualTo(Optimize_HoldFind(LoopHome.body, target, value), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(OptState.hold_block, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(OptState.hold_block, LoopHome.body) ThenBlock: { ReturnValue(0) }
        ReturnValue(Optimize_HoldIn(OptState.hold_block, target, value))
    }
}

Function.Optimize_HoldChain {
    Input: name: Address
    Output: Integer
    Body: {
        body = LoopHome.body
        IfCondition EqualTo(body, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(body), AST.BLOCK) ThenBlock: { ReturnValue(0) }
        count = AST_GetChildCount(body)
        found = 0
        i = 0
        WhileLoop LessThan(i, count) {
            st = AST_GetChild(body, i)
            IfCondition NotEqual(st, 0) ThenBlock: {
                IfCondition EqualTo(AST_GetType(st), AST.ASSIGNMENT) ThenBlock: {
                    IfCondition EqualTo(AST_GetData2(st), 0) ThenBlock: {
                        IfCondition EqualTo(Optimize_NameEq(AST_GetData1(st), name), 1) ThenBlock: {
                            value = AST_GetChild(st, 0)
                            opk = 0
                            IfCondition NotEqual(value, 0) ThenBlock: {
                                IfCondition EqualTo(AST_GetType(value), AST.CALL) ThenBlock: {
                                    opk = Optimize_FltOpKind(AST_GetData1(value))
                                }
                            }
                            legal = 0
                            IfCondition EqualTo(opk, 1) ThenBlock: { legal = 1 }
                            IfCondition EqualTo(opk, 2) ThenBlock: { legal = 1 }
                            IfCondition EqualTo(opk, 3) ThenBlock: { legal = 1 }
                            IfCondition EqualTo(legal, 0) ThenBlock: { ReturnValue(0) }
                            IfCondition EqualTo(Optimize_HoldHere(name, value), 0) ThenBlock: { ReturnValue(0) }
                            IfCondition EqualTo(Optimize_AssignNested(value, name), 1) ThenBlock: { ReturnValue(0) }
                            found = 1
                        }
                    }
                } ElseBlock: {
                    IfCondition EqualTo(Optimize_AssignNested(st, name), 1) ThenBlock: { ReturnValue(0) }
                }
            }
            i = Add(i, 1)
        }
        ReturnValue(found)
    }
}

Function.Optimize_AliasLive {
    Output: Integer
    Body: {
        n = 0
        IfCondition EqualTo(LoopHome.a0_on, 1) ThenBlock: { n = Add(n, 1) }
        IfCondition EqualTo(LoopHome.a1_on, 1) ThenBlock: { n = Add(n, 1) }
        IfCondition EqualTo(LoopHome.a2_on, 1) ThenBlock: { n = Add(n, 1) }
        IfCondition EqualTo(LoopHome.a3_on, 1) ThenBlock: { n = Add(n, 1) }
        ReturnValue(n)
    }
}

Function.Optimize_EnsureSlot {
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }
        off = Scope_Resolve(name)
        rt = Scope.resolve_type
        IfCondition EqualTo(rt, 1) ThenBlock: {
            IfCondition LessThan(off, 0) ThenBlock: { ReturnValue(off) }
        }
        IfCondition EqualTo(rt, 2) ThenBlock: {
            IfCondition LessThan(off, 0) ThenBlock: { ReturnValue(off) }
        }
        IfCondition EqualTo(rt, 0) ThenBlock: {
            Compile.stack_offset = Add(Compile.stack_offset, 8)
            off = Subtract(0, Compile.stack_offset)
            Compile_RegisterLocal(name, off)
            ReturnValue(off)
        }
        ReturnValue(0)
    }
}

Function.Optimize_NameTaken {
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(Optimize_NameEq(name, LoopHome.flt_name), 1) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(Optimize_NameEq(name, LoopHome.f2_name), 1) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(Optimize_NameEq(name, LoopHome.f3_name), 1) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(Optimize_NameEq(name, LoopHome.f4_name), 1) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(Optimize_NameEq(name, LoopHome.f5_name), 1) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(Optimize_NameEq(name, LoopHome.f6_name), 1) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(Optimize_XfHas(name), 1) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(Optimize_NameEq(name, LoopHome.int_name), 1) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(Optimize_NameEq(name, LoopHome.acc_name), 1) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

Function.Optimize_ExtraTake {
    Output: Integer
    Body: {
        free = 0
        IfCondition EqualTo(LoopHome.f2_name, 0) ThenBlock: { free = 1 }
        IfCondition EqualTo(LoopHome.f3_name, 0) ThenBlock: { free = 1 }
        IfCondition EqualTo(LoopHome.f4_name, 0) ThenBlock: { free = 1 }
        IfCondition EqualTo(LoopHome.f5_name, 0) ThenBlock: { free = 1 }
        IfCondition EqualTo(LoopHome.f6_name, 0) ThenBlock: { free = 1 }
        IfCondition LessThan(LoopHome.xf_n, 7) ThenBlock: { free = 1 }
        IfCondition EqualTo(free, 0) ThenBlock: { ReturnValue(0) }
        best_name = 0
        best_off = 0
        best_self = -1
        best_fops = 0
        best_loads = -1
        best_fresh = 0
        i = 0
        WhileLoop LessThan(i, LoopHome.count) {
            rec = Optimize_HomeRec(i)
            name = Dereference(rec)
            loads = Dereference(Add(rec, 8))
            stores = Dereference(Add(rec, 16))
            fops = Dereference(Add(rec, 24))
            selfn = Dereference(Add(rec, 32))
            seeds = Dereference(Add(rec, 40))
            IfCondition EqualTo(Optimize_NameTaken(name), 0) ThenBlock: {
                IfCondition GreaterThan(loads, 0) ThenBlock: {
                    IfCondition GreaterThan(stores, 0) ThenBlock: {
                        IfCondition GreaterThan(fops, 0) ThenBlock: {
                            IfCondition EqualTo(stores, Add(fops, seeds)) ThenBlock: {
                                off = Scope_Resolve(name)
                                rt = Scope.resolve_type
                                slot_ok = 0
                                fresh = 0
                                cand_off = 0
                                IfCondition EqualTo(rt, 1) ThenBlock: {
                                    IfCondition LessThan(off, 0) ThenBlock: {
                                        slot_ok = 1
                                        cand_off = off
                                    }
                                }
                                IfCondition EqualTo(rt, 2) ThenBlock: {
                                    IfCondition LessThan(off, 0) ThenBlock: {
                                        slot_ok = 1
                                        cand_off = off
                                    }
                                }
                                IfCondition EqualTo(rt, 0) ThenBlock: {
                                    slot_ok = 1
                                    fresh = 1
                                }
                                IfCondition EqualTo(slot_ok, 1) ThenBlock: {
                                    // A free xmm is a home. The xmm0 hold still
                                    // covers a one-use product that did not get a slot.
                                    IfCondition EqualTo(selfn, 0) ThenBlock: {
                                        IfCondition EqualTo(loads, stores) ThenBlock: {
                                            IfCondition EqualTo(Optimize_ConstTempSkip(name), 1) ThenBlock: { slot_ok = 0 }
                                        }
                                    }
                                    IfCondition EqualTo(Optimize_FltFieldUpd(loads, stores, fops, selfn, seeds), 1) ThenBlock: { slot_ok = 0 }
                                }
                                IfCondition EqualTo(slot_ok, 1) ThenBlock: {
                                    take = 0
                                    IfCondition GreaterThan(loads, best_loads) ThenBlock: { take = 1 }
                                    IfCondition EqualTo(loads, best_loads) ThenBlock: {
                                        IfCondition GreaterThan(selfn, best_self) ThenBlock: { take = 1 }
                                        IfCondition EqualTo(selfn, best_self) ThenBlock: {
                                            IfCondition GreaterThan(fops, best_fops) ThenBlock: { take = 1 }
                                        }
                                    }
                                    IfCondition EqualTo(take, 1) ThenBlock: {
                                        best_loads = loads
                                        best_self = selfn
                                        best_fops = fops
                                        best_name = name
                                        best_off = cand_off
                                        best_fresh = fresh
                                    }
                                }
                            }
                        }
                    }
                }
            }
            i = Add(i, 1)
        }
        IfCondition EqualTo(best_name, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(best_fresh, 1) ThenBlock: {
            best_off = Optimize_EnsureSlot(best_name)
            IfCondition EqualTo(best_off, 0) ThenBlock: { ReturnValue(0) }
        }
        IfCondition EqualTo(LoopHome.f2_name, 0) ThenBlock: {
            LoopHome.f2_name = best_name
            LoopHome.f2_off = best_off
            ReturnValue(1)
        }
        IfCondition EqualTo(LoopHome.f3_name, 0) ThenBlock: {
            LoopHome.f3_name = best_name
            LoopHome.f3_off = best_off
            ReturnValue(1)
        }
        IfCondition EqualTo(LoopHome.f4_name, 0) ThenBlock: {
            LoopHome.f4_name = best_name
            LoopHome.f4_off = best_off
            ReturnValue(1)
        }
        IfCondition EqualTo(LoopHome.f5_name, 0) ThenBlock: {
            LoopHome.f5_name = best_name
            LoopHome.f5_off = best_off
            ReturnValue(1)
        }
        IfCondition EqualTo(LoopHome.f6_name, 0) ThenBlock: {
            LoopHome.f6_name = best_name
            LoopHome.f6_off = best_off
            ReturnValue(1)
        }
        ReturnValue(Optimize_XfInstall(best_name, best_off))
    }
}

Function.Optimize_HomePickExtras {
    Output: Integer
    Body: {
        IfCondition EqualTo(LoopHome.flt_name, 0) ThenBlock: { ReturnValue(0) }
        n = 0
        WhileLoop LessThan(n, 12) {
            IfCondition EqualTo(Optimize_ExtraTake(), 0) ThenBlock: { n = 12 }
            n = Add(n, 1)
        }
        ReturnValue(0)
    }
}

// 1 when this compile can see the callee and none of the code it can reach
// writes r13 or xmm2-xmm5. The callee prologue does not save r13. A loop
// home writes those registers. A straight-line fused multiply-add uses xmm6.
Function.Optimize_HomesClobber {
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(1) }
        IfCondition NotEqual(OptState.clean_cache, 0) ThenBlock: {
            hit = SHash.Lookup(OptState.clean_cache, name)
            IfCondition EqualTo(hit, 1) ThenBlock: { ReturnValue(0) }
            IfCondition EqualTo(hit, 2) ThenBlock: { ReturnValue(1) }
        }
        IfCondition GreaterThan(OptState.clean_depth, 16) ThenBlock: { ReturnValue(1) }
        IfCondition NotEqual(OptState.clean_visit, 0) ThenBlock: {
            seen = SHash.Lookup(OptState.clean_visit, name)
            IfCondition EqualTo(seen, 1) ThenBlock: { ReturnValue(1) }
        }
        IfCondition EqualTo(OptState.func_nodes, 0) ThenBlock: { ReturnValue(1) }
        func_node = SHash.LookupAddr(OptState.func_nodes, name)
        IfCondition EqualTo(func_node, Collections.XNULL) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(func_node, 0) ThenBlock: { ReturnValue(1) }
        body = Optimize_InlineBody(func_node)
        IfCondition EqualTo(body, 0) ThenBlock: { ReturnValue(1) }
        IfCondition NotEqual(OptState.clean_visit, 0) ThenBlock: {
            SHash.Insert(OptState.clean_visit, name, 1)
        }
        OptState.clean_depth = Add(OptState.clean_depth, 1)
        bad = Optimize_NodeClobbers(body)
        OptState.clean_depth = Subtract(OptState.clean_depth, 1)
        IfCondition NotEqual(OptState.clean_visit, 0) ThenBlock: {
            SHash.Insert(OptState.clean_visit, name, 0)
        }
        IfCondition NotEqual(OptState.clean_cache, 0) ThenBlock: {
            mark = 1
            IfCondition EqualTo(bad, 1) ThenBlock: { mark = 2 }
            SHash.Insert(OptState.clean_cache, name, mark)
        }
        ReturnValue(bad)
    }
}

Function.Optimize_NodeClobbers {
    Input: node: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        t = AST_GetType(node)
        IfCondition EqualTo(t, AST.INLINEASM) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(Optimize_HomeBlockNode(t), 1) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(t, AST.CALL) ThenBlock: {
            cn = AST_GetData1(node)
            IfCondition EqualTo(cn, 0) ThenBlock: { ReturnValue(1) }
            known = Optimize_HomeCallOk(cn)
            IfCondition EqualTo(known, 0) ThenBlock: {
                IfCondition EqualTo(Optimize_HomesClobber(cn), 1) ThenBlock: { ReturnValue(1) }
            }
        }
        count = AST_GetChildCount(node)
        i = 0
        WhileLoop LessThan(i, count) {
            IfCondition EqualTo(Optimize_NodeClobbers(AST_GetChild(node, i)), 1) ThenBlock: {
                ReturnValue(1)
            }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

Function.Optimize_HomeCallSave {
    Input: callee: Address
    Body: {
        IfCondition EqualTo(LoopHome.active, 1) ThenBlock: {
            Optimize_FlushHold()
            keep = Optimize_HomesClobber(callee)
            IfCondition EqualTo(keep, 1) ThenBlock: {
                IfCondition NotEqual(LoopHome.int_name, 0) ThenBlock: {
                    Emit_HomeMove(1, 0)
                    Emit_MovRbpOffsetRax(LoopHome.int_off)
                }
                IfCondition NotEqual(LoopHome.flt_name, 0) ThenBlock: {
                    Emit_HomeMove(5, 0)
                    Emit_MovRbpOffsetRax(LoopHome.flt_off)
                }
                IfCondition NotEqual(LoopHome.f2_name, 0) ThenBlock: {
                    X86_XmmRR(2, 3)
                    Emit_MovRbpOffsetRax(LoopHome.f2_off)
                }
                IfCondition NotEqual(LoopHome.f3_name, 0) ThenBlock: {
                    X86_XmmRR(2, 4)
                    Emit_MovRbpOffsetRax(LoopHome.f3_off)
                }
                IfCondition NotEqual(LoopHome.f4_name, 0) ThenBlock: {
                    X86_XmmRR(2, 5)
                    Emit_MovRbpOffsetRax(LoopHome.f4_off)
                }
                IfCondition NotEqual(LoopHome.f5_name, 0) ThenBlock: {
                    X86_XmmRR(2, 6)
                    Emit_MovRbpOffsetRax(LoopHome.f5_off)
                }
                IfCondition NotEqual(LoopHome.f6_name, 0) ThenBlock: {
                    X86_XmmRR(2, 7)
                    Emit_MovRbpOffsetRax(LoopHome.f6_off)
                }
                Optimize_XfSpill()
            }
        }
    }
}

Function.Optimize_HomeCallLoad {
    Input: callee: Address
    Body: {
        IfCondition EqualTo(LoopHome.active, 1) ThenBlock: {
            keep = Optimize_HomesClobber(callee)
            IfCondition EqualTo(keep, 1) ThenBlock: {
                IfCondition NotEqual(LoopHome.int_name, 0) ThenBlock: {
                    Emit_MovRaxRbpOffset(LoopHome.int_off)
                    Emit_HomeMove(2, 0)
                }
                IfCondition NotEqual(LoopHome.flt_name, 0) ThenBlock: {
                    Emit_MovRaxRbpOffset(LoopHome.flt_off)
                    Emit_HomeMove(6, 0)
                }
                IfCondition NotEqual(LoopHome.f2_name, 0) ThenBlock: {
                    Emit_MovRaxRbpOffset(LoopHome.f2_off)
                    X86_XmmRR(1, 3)
                }
                IfCondition NotEqual(LoopHome.f3_name, 0) ThenBlock: {
                    Emit_MovRaxRbpOffset(LoopHome.f3_off)
                    X86_XmmRR(1, 4)
                }
                IfCondition NotEqual(LoopHome.f4_name, 0) ThenBlock: {
                    Emit_MovRaxRbpOffset(LoopHome.f4_off)
                    X86_XmmRR(1, 5)
                }
                IfCondition NotEqual(LoopHome.f5_name, 0) ThenBlock: {
                    Emit_MovRaxRbpOffset(LoopHome.f5_off)
                    X86_XmmRR(1, 6)
                }
                IfCondition NotEqual(LoopHome.f6_name, 0) ThenBlock: {
                    Emit_MovRaxRbpOffset(LoopHome.f6_off)
                    X86_XmmRR(1, 7)
                }
                Optimize_XfLoad()
            }
            IfCondition EqualTo(LoopHome.tab_on, 1) ThenBlock: {
                Emit_MovRaxRbpOffset(LoopHome.tab_off)
                Emit_MovR14Rax()
            }
        }
    }
}

Function.Optimize_ScanBlock {
    Input: node: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(1) }
        IfCondition NotEqual(AST_GetType(node), AST.BLOCK) ThenBlock: {
            ReturnValue(Optimize_ScanNode(node))
        }
        count = AST_GetChildCount(node)
        ok = 1
        i = 0
        WhileLoop LessThan(i, count) {
            IfCondition EqualTo(Optimize_ScanNode(AST_GetChild(node, i)), 0) ThenBlock: { ok = 0 }
            i = Add(i, 1)
        }
        ReturnValue(ok)
    }
}

Function.Optimize_ScanCondSafe {
    Input: node: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(node), AST.CALL) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_IsCompareName(AST_GetData1(node)), 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetChildCount(node), 2) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_IsLeaf(AST_GetChild(node, 0)), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_IsLeaf(AST_GetChild(node, 1)), 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(AST_GetChild(node, 1)), AST.NUMBER) ThenBlock: { ReturnValue(0) }
        ReturnValue(1)
    }
}

Function.Optimize_ScanIf {
    Input: node: Address
    Output: Integer
    Body: {
        safe = Optimize_ScanCondSafe(AST_GetChild(node, 0))
        LoopHome.scan_depth = Add(LoopHome.scan_depth, 1)
        IfCondition EqualTo(Optimize_ScanBlock(AST_GetChild(node, 1)), 0) ThenBlock: { safe = 0 }
        IfCondition GreaterThan(AST_GetChildCount(node), 2) ThenBlock: {
            IfCondition EqualTo(Optimize_ScanBlock(AST_GetChild(node, 2)), 0) ThenBlock: { safe = 0 }
        }
        LoopHome.scan_depth = Subtract(LoopHome.scan_depth, 1)
        ReturnValue(safe)
    }
}

Function.Optimize_ScanBranch {
    Input: node: Address
    Output: Integer
    Body: {
        safe = 1
        scr = AST_GetChild(node, 0)
        IfCondition EqualTo(scr, 0) ThenBlock: { safe = 0 }
        IfCondition NotEqual(scr, 0) ThenBlock: {
            st = AST_GetType(scr)
            leaf = 0
            IfCondition EqualTo(st, AST.IDENTIFIER) ThenBlock: { leaf = 1 }
            IfCondition EqualTo(st, AST.NUMBER) ThenBlock: { leaf = 1 }
            IfCondition EqualTo(leaf, 0) ThenBlock: { safe = 0 }
        }
        n = AST_GetChildCount(node)
        i = 1
        WhileLoop LessThan(i, n) {
            ch = AST_GetChild(node, i)
            IfCondition NotEqual(ch, 0) ThenBlock: {
                IfCondition EqualTo(AST_GetType(ch), AST.CASE) ThenBlock: {
                    IfCondition EqualTo(Optimize_IsLeaf(AST_GetChild(ch, 0)), 0) ThenBlock: { safe = 0 }
                }
            }
            i = Add(i, 1)
        }
        LoopHome.scan_depth = Add(LoopHome.scan_depth, 1)
        i = 1
        WhileLoop LessThan(i, n) {
            ch = AST_GetChild(node, i)
            IfCondition NotEqual(ch, 0) ThenBlock: {
                IfCondition EqualTo(AST_GetType(ch), AST.CASE) ThenBlock: {
                    IfCondition EqualTo(Optimize_ScanBlock(AST_GetChild(ch, 1)), 0) ThenBlock: { safe = 0 }
                }
                IfCondition EqualTo(AST_GetType(ch), AST.DEFAULT) ThenBlock: {
                    IfCondition EqualTo(Optimize_ScanBlock(AST_GetChild(ch, 0)), 0) ThenBlock: { safe = 0 }
                }
            }
            i = Add(i, 1)
        }
        LoopHome.scan_depth = Subtract(LoopHome.scan_depth, 1)
        ReturnValue(safe)
    }
}

Function.Optimize_ScanNode {
    Input: node: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        nt = AST_GetType(node)
        IfCondition EqualTo(nt, AST.ASSIGNMENT) ThenBlock: { ReturnValue(Optimize_ScanStmt(node)) }
        IfCondition EqualTo(nt, AST.BLOCK) ThenBlock: { ReturnValue(Optimize_ScanBlock(node)) }
        IfCondition EqualTo(nt, AST.IF) ThenBlock: { ReturnValue(Optimize_ScanIf(node)) }
        IfCondition EqualTo(nt, AST.FORK) ThenBlock: { ReturnValue(Optimize_ScanIf(node)) }
        IfCondition EqualTo(nt, AST.SWITCH) ThenBlock: { ReturnValue(Optimize_ScanBranch(node)) }
        IfCondition EqualTo(nt, AST.BRANCH) ThenBlock: { ReturnValue(Optimize_ScanBranch(node)) }
        ReturnValue(0)
    }
}

Function.Optimize_CallArgsSafe {
    Input: node: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        n = AST_GetChildCount(node)
        i = 0
        WhileLoop LessThan(i, n) {
            IfCondition EqualTo(Optimize_RbxSafeOp(AST_GetChild(node, i)), 0) ThenBlock: { ReturnValue(0) }
            i = Add(i, 1)
        }
        ReturnValue(1)
    }
}

// Dereference(Add(base, Multiply(index, 1/2/4/8))). The scale is the right
// child, matching the integer load. 0 is not this shape. 1 is an identifier
// base whose index does not use rbx. 3 is an identifier base whose index is
// not rbx-safe but does not write r14, so the base can still stay in r14.
// 2 is a scaled address whose base is not stable, or whose index writes r14.
Function.Optimize_ScaledBase {
    Input: node: Address
    Output: Integer
    Body: {
        LoopHome.hold_name = 0
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(node), AST.CALL) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(StringCompare(AST_GetData1(node), "Dereference"), 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetChildCount(node), 1) ThenBlock: { ReturnValue(0) }
        addr = AST_GetChild(node, 0)
        IfCondition EqualTo(addr, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(addr), AST.CALL) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(StringCompare(AST_GetData1(addr), "Add"), 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetChildCount(addr), 2) ThenBlock: { ReturnValue(0) }
        mul = AST_GetChild(addr, 1)
        IfCondition EqualTo(mul, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(mul), AST.CALL) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(StringCompare(AST_GetData1(mul), "Multiply"), 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetChildCount(mul), 2) ThenBlock: { ReturnValue(0) }
        scale_node = AST_GetChild(mul, 1)
        IfCondition EqualTo(Optimize_ScaleValue(scale_node), 0) ThenBlock: { ReturnValue(0) }
        index = AST_GetChild(mul, 0)
        base = AST_GetChild(addr, 0)
        IfCondition EqualTo(base, 0) ThenBlock: { ReturnValue(2) }
        IfCondition NotEqual(AST_GetType(base), AST.IDENTIFIER) ThenBlock: { ReturnValue(2) }
        LoopHome.hold_name = AST_GetData1(base)
        IfCondition EqualTo(Optimize_RbxSafeOp(index), 1) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(Optimize_WritesR14(index), 0) ThenBlock: { ReturnValue(3) }
        ReturnValue(2)
    }
}

Function.Optimize_AssignsName {
    Input: node: Address
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(AST_GetType(node), AST.ASSIGNMENT) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(AST_GetData1(node), name), 1) ThenBlock: { ReturnValue(1) }
        }
        count = AST_GetChildCount(node)
        i = 0
        WhileLoop LessThan(i, count) {
            IfCondition EqualTo(Optimize_AssignsName(AST_GetChild(node, i), name), 1) ThenBlock: { ReturnValue(1) }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

Function.Optimize_NoteTable {
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(LoopHome.tab_many, 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(LoopHome.tab_on, 1) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(name, LoopHome.tab_name), 0) ThenBlock: {
                LoopHome.tab_on = 0
                LoopHome.tab_many = 1
            }
            ReturnValue(0)
        }
        IfCondition EqualTo(Optimize_AssignsName(LoopHome.body, name), 1) ThenBlock: {
            LoopHome.tab_many = 1
            ReturnValue(0)
        }
        off = Scope_Resolve(name)
        rt = Scope.resolve_type
        ok = 0
        IfCondition EqualTo(rt, 1) ThenBlock: { ok = 1 }
        IfCondition EqualTo(rt, 2) ThenBlock: { ok = 1 }
        IfCondition GreaterEqual(off, 0) ThenBlock: { ok = 0 }
        IfCondition EqualTo(ok, 0) ThenBlock: {
            LoopHome.tab_many = 1
            ReturnValue(0)
        }
        LoopHome.tab_on = 1
        LoopHome.tab_name = name
        LoopHome.tab_off = off
        ReturnValue(1)
    }
}

// StoreValue(Add(base, Multiply(index, 1/2/4/8)), value). The base is a
// table candidate, same as a scaled load of that base. 2 means the address
// is scaled but the base is not stable, so a table already chosen is dropped.
Function.Optimize_StoreScaled {
    Input: node: Address
    Output: Integer
    Body: {
        LoopHome.hold_name = 0
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(node), AST.CALL) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(StringCompare(AST_GetData1(node), "StoreValue"), 0) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(AST_GetChildCount(node), 2) ThenBlock: { ReturnValue(0) }
        addr = AST_GetChild(node, 0)
        IfCondition EqualTo(addr, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(addr), AST.CALL) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(StringCompare(AST_GetData1(addr), "Add"), 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetChildCount(addr), 2) ThenBlock: { ReturnValue(0) }
        mul = AST_GetChild(addr, 1)
        IfCondition EqualTo(mul, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(mul), AST.CALL) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(StringCompare(AST_GetData1(mul), "Multiply"), 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetChildCount(mul), 2) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_ScaleValue(AST_GetChild(mul, 1)), 0) ThenBlock: { ReturnValue(0) }
        index = AST_GetChild(mul, 0)
        base = AST_GetChild(addr, 0)
        IfCondition EqualTo(base, 0) ThenBlock: { ReturnValue(2) }
        IfCondition EqualTo(AST_GetType(base), AST.IDENTIFIER) ThenBlock: {
            IfCondition EqualTo(Optimize_RbxSafeOp(index), 1) ThenBlock: {
                LoopHome.hold_name = AST_GetData1(base)
                ReturnValue(1)
            }
        }
        ReturnValue(2)
    }
}

Function.Optimize_ScanTableWalk {
    Input: node: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        k = Optimize_ScaledBase(node)
        note = 0
        IfCondition EqualTo(k, 1) ThenBlock: { note = 1 }
        IfCondition EqualTo(k, 3) ThenBlock: { note = 1 }
        IfCondition EqualTo(note, 1) ThenBlock: { Optimize_NoteTable(LoopHome.hold_name) }
        IfCondition EqualTo(k, 2) ThenBlock: {
            LoopHome.tab_on = 0
            LoopHome.tab_many = 1
        }
        ks = Optimize_StoreScaled(node)
        IfCondition EqualTo(ks, 1) ThenBlock: { Optimize_NoteTable(LoopHome.hold_name) }
        IfCondition EqualTo(ks, 2) ThenBlock: {
            LoopHome.tab_on = 0
            LoopHome.tab_many = 1
        }
        n = AST_GetChildCount(node)
        i = 0
        WhileLoop LessThan(i, n) {
            Optimize_ScanTableWalk(AST_GetChild(node, i))
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

Function.Optimize_ScanTable {
    Input: body: Address
    Body: {
        LoopHome.tab_on = 0
        LoopHome.tab_name = 0
        LoopHome.tab_off = 0
        LoopHome.tab_many = 0
        Optimize_ScanTableWalk(body)
        LoopHome.hold_name = 0
    }
}

Function.Optimize_ScanStmt {
    Input: node: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(node), AST.ASSIGNMENT) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetData2(node), 0) ThenBlock: { ReturnValue(0) }
        target = AST_GetData1(node)
        value = AST_GetChild(node, 0)
        IfCondition EqualTo(value, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_MemAliasShape(target, value), 1) ThenBlock: {
            disp = LoopHome.imm_val
            IfCondition GreaterThan(LoopHome.scan_depth, 0) ThenBlock: { LoopHome.alias_spill = 1 }
            IfCondition EqualTo(Optimize_AliasAdd(target, disp), 0) ThenBlock: { ReturnValue(0) }
            live = Optimize_AliasLive()
            IfCondition GreaterThan(live, LoopHome.scan_temps) ThenBlock: {
                LoopHome.scan_temps = live
            }
            ReturnValue(1)
        }
        IfCondition EqualTo(Optimize_CursorAddShape(target, value), 1) ThenBlock: {
            LoopHome.scan_updates = Add(LoopHome.scan_updates, 1)
            Optimize_AliasClearAll()
            ReturnValue(1)
        }
        IfCondition NotEqual(Optimize_AccShape(target, value), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(AST_GetType(value), AST.CALL) ThenBlock: {
            opk = Optimize_FltOpKind(AST_GetData1(value))
            IfCondition GreaterThan(opk, 0) ThenBlock: {
                IfCondition EqualTo(AST_GetChildCount(value), 2) ThenBlock: {
                    IfCondition EqualTo(Optimize_RbxSafeOp(AST_GetChild(value, 0)), 1) ThenBlock: {
                        IfCondition EqualTo(Optimize_RbxSafeOp(AST_GetChild(value, 1)), 1) ThenBlock: {
                            ReturnValue(1)
                        }
                    }
                }
            }
        }
        IfCondition EqualTo(AST_GetType(value), AST.CALL) ThenBlock: {
            sk = Optimize_ScaledBase(value)
            IfCondition EqualTo(sk, 1) ThenBlock: { ReturnValue(1) }
            IfCondition EqualTo(Optimize_HomeCallOk(AST_GetData1(value)), 0) ThenBlock: {
                IfCondition GreaterEqual(Compile_FindFunction(AST_GetData1(value)), 0) ThenBlock: {
                    IfCondition EqualTo(Optimize_CallArgsSafe(value), 1) ThenBlock: { ReturnValue(1) }
                }
            }
        }
        IfCondition EqualTo(Optimize_PtrCopyShape(target, value), 1) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

Function.Optimize_ScanLifetimes {
    Input: body: Address
    Output: Integer
    Body: {
        count = AST_GetChildCount(body)
        i = 0
        WhileLoop LessThan(i, count) {
            st = AST_GetChild(body, i)
            IfCondition NotEqual(st, 0) ThenBlock: {
                IfCondition EqualTo(AST_GetType(st), AST.ASSIGNMENT) ThenBlock: {
                    IfCondition EqualTo(AST_GetData2(st), 0) ThenBlock: {
                        tgt = AST_GetData1(st)
                        IfCondition EqualTo(Optimize_MemAliasShape(tgt, AST_GetChild(st, 0)), 1) ThenBlock: {
                            prev = -1
                            j = 0
                            WhileLoop LessThan(j, i) {
                                sj = AST_GetChild(body, j)
                                IfCondition NotEqual(sj, 0) ThenBlock: {
                                    IfCondition EqualTo(AST_GetType(sj), AST.ASSIGNMENT) ThenBlock: {
                                        IfCondition EqualTo(AST_GetData2(sj), 0) ThenBlock: {
                                            IfCondition EqualTo(Optimize_NameEq(AST_GetData1(sj), tgt), 1) ThenBlock: {
                                                prev = j
                                            }
                                        }
                                    }
                                }
                                j = Add(j, 1)
                            }
                            IfCondition LessThan(prev, 0) ThenBlock: {
                                j = 0
                                WhileLoop LessThan(j, i) {
                                    IfCondition EqualTo(Optimize_TreeHasName(AST_GetChild(body, j), tgt), 1) ThenBlock: {
                                        LoopHome.alias_spill = 1
                                    }
                                    j = Add(j, 1)
                                }
                            }
                            u = -1
                            j = Add(i, 1)
                            WhileLoop LessThan(j, count) {
                                sj = AST_GetChild(body, j)
                                IfCondition NotEqual(sj, 0) ThenBlock: {
                                    IfCondition EqualTo(AST_GetType(sj), AST.ASSIGNMENT) ThenBlock: {
                                        IfCondition EqualTo(AST_GetData2(sj), 0) ThenBlock: {
                                            IfCondition EqualTo(Optimize_CursorAddShape(AST_GetData1(sj), AST_GetChild(sj, 0)), 1) ThenBlock: {
                                                u = j
                                                j = count
                                            }
                                        }
                                    }
                                }
                                j = Add(j, 1)
                            }
                            IfCondition LessThan(u, 0) ThenBlock: {
                                LoopHome.alias_spill = 1
                            }
                            IfCondition GreaterEqual(u, 0) ThenBlock: {
                                IfCondition EqualTo(Optimize_TreeHasName(AST_GetChild(body, u), tgt), 1) ThenBlock: {
                                    LoopHome.alias_spill = 1
                                }
                                k = Add(u, 1)
                                WhileLoop LessThan(k, count) {
                                    sk = AST_GetChild(body, k)
                                    hit_def = 0
                                    IfCondition NotEqual(sk, 0) ThenBlock: {
                                        IfCondition EqualTo(AST_GetType(sk), AST.ASSIGNMENT) ThenBlock: {
                                            IfCondition EqualTo(AST_GetData2(sk), 0) ThenBlock: {
                                                IfCondition EqualTo(Optimize_NameEq(AST_GetData1(sk), tgt), 1) ThenBlock: {
                                                    hit_def = 1
                                                    IfCondition EqualTo(Optimize_TreeHasName(AST_GetChild(sk, 0), tgt), 1) ThenBlock: {
                                                        LoopHome.alias_spill = 1
                                                    }
                                                    k = count
                                                }
                                            }
                                        }
                                    }
                                    IfCondition EqualTo(hit_def, 0) ThenBlock: {
                                        IfCondition EqualTo(Optimize_TreeHasName(sk, tgt), 1) ThenBlock: {
                                            LoopHome.alias_spill = 1
                                        }
                                    }
                                    k = Add(k, 1)
                                }
                            }
                        }
                    }
                }
            }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

Function.Optimize_ScanBody {
    Input: body: Address
    Output: Integer
    Body: {
        LoopHome.rbx_free = 1
        LoopHome.alias_spill = 0
        LoopHome.scan_temps = 0
        LoopHome.scan_updates = 0
        LoopHome.scan_depth = 0
        Optimize_AliasClearAll()
        LoopHome.hold_on = 0
        IfCondition EqualTo(body, 0) ThenBlock: {
            LoopHome.rbx_free = 0
            ReturnValue(0)
        }
        IfCondition NotEqual(AST_GetType(body), AST.BLOCK) ThenBlock: {
            LoopHome.rbx_free = 0
            ReturnValue(0)
        }
        count = AST_GetChildCount(body)
        i = 0
        WhileLoop LessThan(i, count) {
            IfCondition EqualTo(Optimize_ScanNode(AST_GetChild(body, i)), 0) ThenBlock: {
                LoopHome.rbx_free = 0
            }
            i = Add(i, 1)
        }
        IfCondition EqualTo(LoopHome.scan_updates, 0) ThenBlock: { LoopHome.alias_spill = 1 }
        IfCondition GreaterThan(LoopHome.scan_temps, 4) ThenBlock: { LoopHome.alias_spill = 1 }
        IfCondition GreaterThan(LoopHome.scan_temps, 4) ThenBlock: { LoopHome.rbx_free = 0 }
        IfCondition EqualTo(LoopHome.alias_spill, 0) ThenBlock: {
            Optimize_ScanLifetimes(body)
        }
        Optimize_AliasClearAll()
        LoopHome.hold_on = 0
        LoopHome.hold_name = 0
        ReturnValue(0)
    }
}

Function.Optimize_ScanCondTemps {
    Input: condition: Address
    Input: body: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(LoopHome.alias_spill, 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(condition, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(body, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(body), AST.BLOCK) ThenBlock: { ReturnValue(0) }
        count = AST_GetChildCount(body)
        i = 0
        WhileLoop LessThan(i, count) {
            st = AST_GetChild(body, i)
            IfCondition NotEqual(st, 0) ThenBlock: {
                IfCondition EqualTo(AST_GetType(st), AST.ASSIGNMENT) ThenBlock: {
                    IfCondition EqualTo(AST_GetData2(st), 0) ThenBlock: {
                        tgt = AST_GetData1(st)
                        IfCondition EqualTo(Optimize_MemAliasShape(tgt, AST_GetChild(st, 0)), 1) ThenBlock: {
                            IfCondition EqualTo(Optimize_TreeHasName(condition, tgt), 1) ThenBlock: {
                                LoopHome.alias_spill = 1
                            }
                        }
                    }
                }
            }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

Function.Optimize_BodyAssigns {
    Input: name: Address
    Output: Integer
    Body: {
        body = LoopHome.body
        IfCondition EqualTo(body, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(body), AST.BLOCK) ThenBlock: { ReturnValue(0) }
        count = AST_GetChildCount(body)
        i = 0
        WhileLoop LessThan(i, count) {
            st = AST_GetChild(body, i)
            IfCondition NotEqual(st, 0) ThenBlock: {
                IfCondition EqualTo(AST_GetType(st), AST.ASSIGNMENT) ThenBlock: {
                    IfCondition EqualTo(Optimize_NameEq(AST_GetData1(st), name), 1) ThenBlock: { ReturnValue(1) }
                }
            }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

Function.Optimize_ScanLimit {
    Input: condition: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(LoopHome.rbx_free, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(condition, 0) ThenBlock: {
            LoopHome.rbx_free = 0
            ReturnValue(0)
        }
        IfCondition NotEqual(AST_GetType(condition), AST.CALL) ThenBlock: {
            LoopHome.rbx_free = 0
            ReturnValue(0)
        }
        IfCondition EqualTo(Optimize_IsCompareName(AST_GetData1(condition)), 0) ThenBlock: {
            LoopHome.rbx_free = 0
            ReturnValue(0)
        }
        IfCondition NotEqual(AST_GetChildCount(condition), 2) ThenBlock: {
            LoopHome.rbx_free = 0
            ReturnValue(0)
        }
        a0 = AST_GetChild(condition, 0)
        a1 = AST_GetChild(condition, 1)
        IfCondition EqualTo(Optimize_IsLeaf(a0), 0) ThenBlock: {
            LoopHome.rbx_free = 0
            ReturnValue(0)
        }
        IfCondition EqualTo(Optimize_IsLeaf(a1), 0) ThenBlock: {
            LoopHome.rbx_free = 0
            ReturnValue(0)
        }
        home_left = 0
        home_right = 0
        IfCondition EqualTo(AST_GetType(a0), AST.IDENTIFIER) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(AST_GetData1(a0), LoopHome.int_name), 1) ThenBlock: { home_left = 1 }
        }
        IfCondition EqualTo(AST_GetType(a1), AST.IDENTIFIER) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(AST_GetData1(a1), LoopHome.int_name), 1) ThenBlock: { home_right = 1 }
        }
        IfCondition EqualTo(home_left, home_right) ThenBlock: {
            LoopHome.rbx_free = 0
            ReturnValue(0)
        }
        other = a1
        IfCondition EqualTo(home_right, 1) ThenBlock: { other = a0 }
        IfCondition EqualTo(AST_GetType(other), AST.NUMBER) ThenBlock: {
            LoopHome.lim_on = 0
            ReturnValue(1)
        }
        IfCondition EqualTo(AST_GetType(other), AST.IDENTIFIER) ThenBlock: {
            nm = AST_GetData1(other)
            off = Scope_Resolve(nm)
            rt = Scope.resolve_type
            ok = 0
            IfCondition EqualTo(rt, 1) ThenBlock: { ok = 1 }
            IfCondition EqualTo(rt, 2) ThenBlock: { ok = 1 }
            IfCondition GreaterEqual(off, 0) ThenBlock: { ok = 0 }
            IfCondition EqualTo(ok, 1) ThenBlock: {
                IfCondition EqualTo(Optimize_BodyAssigns(nm), 1) ThenBlock: {
                    LoopHome.rbx_free = 0
                    ReturnValue(0)
                }
                LoopHome.lim_on = 1
                LoopHome.lim_name = nm
                LoopHome.lim_off = off
                ReturnValue(1)
            }
        }
        LoopHome.rbx_free = 0
        ReturnValue(0)
    }
}

Function.Optimize_TryAliasAssign {
    Input: target: Address
    Input: value: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(LoopHome.active, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(LoopHome.alias_spill, 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_MemAliasShape(target, value), 0) ThenBlock: { ReturnValue(0) }
        disp = LoopHome.imm_val
        IfCondition EqualTo(Optimize_AliasAdd(target, disp), 0) ThenBlock: { ReturnValue(0) }
        Optimize_FlushHold()
        ReturnValue(1)
    }
}

// Parameter slot in source order. -1 when the name is not a parameter.
Function.Optimize_ParamIndex {
    Input: func_node: Address
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(func_node, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(-1) }
        n = AST_GetChildCount(func_node)
        i = 0
        slot = 0
        WhileLoop LessThan(i, n) {
            ch = AST_GetChild(func_node, i)
            IfCondition NotEqual(ch, 0) ThenBlock: {
                IfCondition EqualTo(AST_GetType(ch), AST.PARAMETER) ThenBlock: {
                    IfCondition EqualTo(Optimize_NameEq(AST_GetData1(ch), name), 1) ThenBlock: {
                        ReturnValue(slot)
                    }
                    slot = Add(slot, 1)
                }
            }
            i = Add(i, 1)
        }
        ReturnValue(-1)
    }
}

Function.Optimize_ParamCount {
    Input: func_node: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(func_node, 0) ThenBlock: { ReturnValue(0) }
        n = AST_GetChildCount(func_node)
        i = 0
        slot = 0
        WhileLoop LessThan(i, n) {
            ch = AST_GetChild(func_node, i)
            IfCondition NotEqual(ch, 0) ThenBlock: {
                IfCondition EqualTo(AST_GetType(ch), AST.PARAMETER) ThenBlock: {
                    slot = Add(slot, 1)
                }
            }
            i = Add(i, 1)
        }
        ReturnValue(slot)
    }
}

// 1 when this operand can be an argument register or a fit32 immediate.
Function.Optimize_RegLeafSide {
    Input: func_node: Address
    Input: leaf: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(leaf, 0) ThenBlock: { ReturnValue(0) }
        kind = AST_GetType(leaf)
        IfCondition EqualTo(kind, AST.NUMBER) ThenBlock: {
            ReturnValue(Optimize_Fit32(StringToNumber(AST_GetData1(leaf))))
        }
        IfCondition NotEqual(kind, AST.IDENTIFIER) ThenBlock: { ReturnValue(0) }
        idx = Optimize_ParamIndex(func_node, AST_GetData1(leaf))
        IfCondition LessThan(idx, 0) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterThan(idx, 5) ThenBlock: { ReturnValue(0) }
        ReturnValue(1)
    }
}

// The return expression when the body is only Return Add/Subtract of two
// parameters or fit32 numbers, and the function has at most six parameters.
// Zero otherwise. The caller emits that expression with no frame.
Function.Optimize_RegLeafExpr {
    Input: func_node: Address
    Input: body: Address
    Output: Address
    Body: {
        IfCondition EqualTo(body, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(body), AST.BLOCK) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetChildCount(body), 1) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterThan(Optimize_ParamCount(func_node), 6) ThenBlock: { ReturnValue(0) }
        stmt = AST_GetChild(body, 0)
        IfCondition EqualTo(stmt, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(stmt), AST.RETURN) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetChildCount(stmt), 1) ThenBlock: { ReturnValue(0) }
        expr = AST_GetChild(stmt, 0)
        IfCondition EqualTo(expr, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(expr), AST.CALL) ThenBlock: { ReturnValue(0) }
        opname = AST_GetData1(expr)
        is_add = EqualTo(StringCompare(opname, "Add"), 0)
        is_sub = EqualTo(StringCompare(opname, "Subtract"), 0)
        IfCondition EqualTo(is_add, 0) ThenBlock: {
            IfCondition EqualTo(is_sub, 0) ThenBlock: { ReturnValue(0) }
        }
        IfCondition NotEqual(AST_GetChildCount(expr), 2) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_RegLeafSide(func_node, AST_GetChild(expr, 0)), 0) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition EqualTo(Optimize_RegLeafSide(func_node, AST_GetChild(expr, 1)), 0) ThenBlock: {
            ReturnValue(0)
        }
        ReturnValue(expr)
    }
}

Function.Optimize_EmitLeafRax {
    Input: func_node: Address
    Input: leaf: Address
    Output: Integer
    Body: {
        kind = AST_GetType(leaf)
        IfCondition EqualTo(kind, AST.NUMBER) ThenBlock: {
            Emit_MovRaxImm64(StringToNumber(AST_GetData1(leaf)))
            ReturnValue(1)
        }
        idx = Optimize_ParamIndex(func_node, AST_GetData1(leaf))
        reg = CompileFunc_ArgReg(idx)
        IfCondition LessThan(reg, 0) ThenBlock: { ReturnValue(0) }
        Emit_MovRegReg(Reg.RAX, reg)
        ReturnValue(1)
    }
}

// rax = left +/- right. Right is a parameter register or a fit32 immediate.
// Neither side uses rbx, so a frame-free leaf keeps the callee-saved set.
Function.Optimize_EmitRegLeaf {
    Input: func_node: Address
    Input: expr: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(Optimize_EmitLeafRax(func_node, AST_GetChild(expr, 0)), 0) ThenBlock: {
            ReturnValue(0)
        }
        right = AST_GetChild(expr, 1)
        is_sub = EqualTo(StringCompare(AST_GetData1(expr), "Subtract"), 0)
        IfCondition EqualTo(AST_GetType(right), AST.NUMBER) ThenBlock: {
            val = StringToNumber(AST_GetData1(right))
            IfCondition EqualTo(is_sub, 1) ThenBlock: { Emit_SubRegImm32(Reg.RAX, val) }
            IfCondition EqualTo(is_sub, 0) ThenBlock: { Emit_AddRegImm32(Reg.RAX, val) }
            ReturnValue(1)
        }
        reg = CompileFunc_ArgReg(Optimize_ParamIndex(func_node, AST_GetData1(right)))
        IfCondition LessThan(reg, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(is_sub, 1) ThenBlock: { X86_SubRegReg(Reg.RAX, reg) }
        IfCondition EqualTo(is_sub, 0) ThenBlock: { X86_AddRegReg(Reg.RAX, reg) }
        ReturnValue(1)
    }
}

// acc = Add(acc, call) or Add(call, acc), or Subtract(acc, call).
// Six or fewer register arguments leave r12 alone. The call result is in rax.
Function.Optimize_TryAccCall {
    Input: target: Address
    Input: value: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(LoopHome.active, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(LoopHome.acc_name, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_NameEq(target, LoopHome.acc_name), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(value, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(value), AST.CALL) ThenBlock: { ReturnValue(0) }
        opname = AST_GetData1(value)
        is_add = EqualTo(StringCompare(opname, "Add"), 0)
        is_sub = EqualTo(StringCompare(opname, "Subtract"), 0)
        IfCondition EqualTo(is_add, 0) ThenBlock: {
            IfCondition EqualTo(is_sub, 0) ThenBlock: { ReturnValue(0) }
        }
        IfCondition NotEqual(AST_GetChildCount(value), 2) ThenBlock: { ReturnValue(0) }
        a0 = AST_GetChild(value, 0)
        a1 = AST_GetChild(value, 1)
        left_acc = 0
        right_acc = 0
        IfCondition EqualTo(AST_GetType(a0), AST.IDENTIFIER) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(AST_GetData1(a0), LoopHome.acc_name), 1) ThenBlock: {
                left_acc = 1
            }
        }
        IfCondition EqualTo(AST_GetType(a1), AST.IDENTIFIER) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(AST_GetData1(a1), LoopHome.acc_name), 1) ThenBlock: {
                right_acc = 1
            }
        }
        other = 0
        IfCondition EqualTo(is_add, 1) ThenBlock: {
            IfCondition EqualTo(left_acc, 1) ThenBlock: {
                IfCondition EqualTo(right_acc, 0) ThenBlock: { other = a1 }
            }
            IfCondition EqualTo(right_acc, 1) ThenBlock: {
                IfCondition EqualTo(left_acc, 0) ThenBlock: { other = a0 }
            }
        }
        IfCondition EqualTo(is_sub, 1) ThenBlock: {
            IfCondition EqualTo(left_acc, 1) ThenBlock: {
                IfCondition EqualTo(right_acc, 0) ThenBlock: { other = a1 }
            }
        }
        IfCondition EqualTo(other, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(other), AST.CALL) ThenBlock: { ReturnValue(0) }
        cname = AST_GetData1(other)
        IfCondition EqualTo(cname, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_HomeCallOk(cname), 1) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(Compile_FindFunction(cname), 0) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterThan(AST_GetChildCount(other), 6) ThenBlock: { ReturnValue(0) }
        got = Compile_Expression(other)
        IfCondition EqualTo(got, 0) ThenBlock: {
            Compile.error = 1
            ReturnValue(1)
        }
        IfCondition EqualTo(is_sub, 1) ThenBlock: { X86_SubRegReg(Reg.R12, Reg.RAX) }
        IfCondition EqualTo(is_sub, 0) ThenBlock: { X86_AddRegReg(Reg.R12, Reg.RAX) }
        ReturnValue(1)
    }
}

// Previous sibling of target, searching from root. Zero when target is the
// first statement of its block or is not under root.
Function.Optimize_PrevSibling {
    Input: root: Address
    Input: target: Address
    Output: Address
    Body: {
        IfCondition EqualTo(root, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(target, 0) ThenBlock: { ReturnValue(0) }
        count = AST_GetChildCount(root)
        i = 0
        WhileLoop LessThan(i, count) {
            child = AST_GetChild(root, i)
            IfCondition EqualTo(child, target) ThenBlock: {
                IfCondition GreaterThan(i, 0) ThenBlock: {
                    ReturnValue(AST_GetChild(root, Subtract(i, 1)))
                }
                ReturnValue(0)
            }
            found = Optimize_PrevSibling(child, target)
            IfCondition NotEqual(found, 0) ThenBlock: { ReturnValue(found) }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

// name = name + positive constant, either add order. The constant, or 0.
Function.Optimize_StepConst {
    Input: stmt: Address
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(Optimize_PlainAssign(stmt), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_NameEq(AST_GetData1(stmt), name), 0) ThenBlock: { ReturnValue(0) }
        val = AST_GetChild(stmt, 0)
        IfCondition EqualTo(val, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(val), AST.CALL) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(StringCompare(AST_GetData1(val), "Add"), 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetChildCount(val), 2) ThenBlock: { ReturnValue(0) }
        a0 = AST_GetChild(val, 0)
        a1 = AST_GetChild(val, 1)
        num = 0
        hit = 0
        IfCondition EqualTo(Optimize_IdentEq(a0, name), 1) ThenBlock: {
            IfCondition EqualTo(AST_GetType(a1), AST.NUMBER) ThenBlock: {
                num = StringToNumber(AST_GetData1(a1))
                hit = 1
            }
        }
        IfCondition EqualTo(hit, 0) ThenBlock: {
            IfCondition EqualTo(Optimize_IdentEq(a1, name), 1) ThenBlock: {
                IfCondition EqualTo(AST_GetType(a0), AST.NUMBER) ThenBlock: {
                    num = StringToNumber(AST_GetData1(a0))
                    hit = 1
                }
            }
        }
        IfCondition EqualTo(hit, 0) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(num, 1) ThenBlock: { ReturnValue(0) }
        ReturnValue(num)
    }
}

// A qword deref of the index name through one frame-local base.
Function.Optimize_RepeatDeref {
    Input: node: Address
    Input: index_name: Address
    Input: outer_name: Address
    Input: acc_name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(Optimize_QwordScale(node), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_IdentEq(Optimize_QwordIndex(node), index_name), 0) ThenBlock: {
            ReturnValue(0)
        }
        base = Optimize_QwordBase(node)
        IfCondition EqualTo(base, 0) ThenBlock: { ReturnValue(0) }
        bname = AST_GetData1(base)
        IfCondition EqualTo(Optimize_NameEq(bname, index_name), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_NameEq(bname, outer_name), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_NameEq(bname, acc_name), 1) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterThan(Optimize_CountIdents(node, outer_name), 0) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterThan(Optimize_CountIdents(node, acc_name), 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(Optimize_FrameOff(bname))
    }
}

// acc = acc +/- scaled deref of the inner cursor. The load ignores the
// outer cursor, so each outer trip adds the same qword.
Function.Optimize_RepeatAdd {
    Input: stmt: Address
    Input: index_name: Address
    Input: outer_name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(Optimize_PlainAssign(stmt), 0) ThenBlock: { ReturnValue(0) }
        acc = AST_GetData1(stmt)
        IfCondition EqualTo(Optimize_NameEq(acc, index_name), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_NameEq(acc, outer_name), 1) ThenBlock: { ReturnValue(0) }
        val = AST_GetChild(stmt, 0)
        IfCondition EqualTo(val, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(val), AST.CALL) ThenBlock: { ReturnValue(0) }
        opname = AST_GetData1(val)
        is_add = EqualTo(StringCompare(opname, "Add"), 0)
        is_sub = EqualTo(StringCompare(opname, "Subtract"), 0)
        IfCondition EqualTo(is_add, 0) ThenBlock: {
            IfCondition EqualTo(is_sub, 0) ThenBlock: { ReturnValue(0) }
        }
        IfCondition NotEqual(AST_GetChildCount(val), 2) ThenBlock: { ReturnValue(0) }
        a0 = AST_GetChild(val, 0)
        a1 = AST_GetChild(val, 1)
        left_acc = 0
        right_acc = 0
        IfCondition EqualTo(Optimize_IdentEq(a0, acc), 1) ThenBlock: { left_acc = 1 }
        IfCondition EqualTo(Optimize_IdentEq(a1, acc), 1) ThenBlock: { right_acc = 1 }
        other = 0
        IfCondition EqualTo(is_add, 1) ThenBlock: {
            IfCondition EqualTo(left_acc, 1) ThenBlock: {
                IfCondition EqualTo(right_acc, 0) ThenBlock: { other = a1 }
            }
            IfCondition EqualTo(right_acc, 1) ThenBlock: {
                IfCondition EqualTo(left_acc, 0) ThenBlock: { other = a0 }
            }
        }
        IfCondition EqualTo(is_sub, 1) ThenBlock: {
            IfCondition EqualTo(left_acc, 1) ThenBlock: {
                IfCondition EqualTo(right_acc, 0) ThenBlock: { other = a1 }
            }
        }
        IfCondition EqualTo(other, 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(Optimize_RepeatDeref(other, index_name, outer_name, acc))
    }
}

// An outer counted loop whose only effect is to repeat an inner reduction.
// The load does not mention the outer cursor and the body does not store,
// so one pass scaled by the trip count is the same integer sum. The outer
// cursor is left equal to the limit. Returns 1 when that loop was emitted.
Function.Optimize_TryRepeatSum {
    Input: node: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(LoopHome.active, 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(node), AST.WHILE) ThenBlock: { ReturnValue(0) }
        cond = AST_GetChild(node, 0)
        body = AST_GetChild(node, 1)
        IfCondition EqualTo(cond, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(cond), AST.CALL) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(StringCompare(AST_GetData1(cond), "LessThan"), 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetChildCount(cond), 2) ThenBlock: { ReturnValue(0) }
        cleft = AST_GetChild(cond, 0)
        cright = AST_GetChild(cond, 1)
        IfCondition NotEqual(AST_GetType(cleft), AST.IDENTIFIER) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(cright), AST.NUMBER) ThenBlock: { ReturnValue(0) }
        oname = AST_GetData1(cleft)
        limit = StringToNumber(AST_GetData1(cright))
        prev = Optimize_PrevSibling(Compile.current_func, node)
        IfCondition EqualTo(Optimize_PlainAssign(prev), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_NameEq(AST_GetData1(prev), oname), 0) ThenBlock: { ReturnValue(0) }
        pval = AST_GetChild(prev, 0)
        IfCondition EqualTo(pval, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(pval), AST.NUMBER) ThenBlock: { ReturnValue(0) }
        start = StringToNumber(AST_GetData1(pval))
        IfCondition LessThan(start, 0) ThenBlock: { ReturnValue(0) }
        IfCondition LessEqual(limit, start) ThenBlock: { ReturnValue(0) }
        trip = Subtract(limit, start)
        IfCondition LessThan(trip, 2) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_Fit32(trip), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(body, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(body), AST.BLOCK) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetChildCount(body), 3) ThenBlock: { ReturnValue(0) }
        reset = AST_GetChild(body, 0)
        inner = AST_GetChild(body, 1)
        bump = AST_GetChild(body, 2)
        IfCondition EqualTo(Optimize_PlainAssign(reset), 0) ThenBlock: { ReturnValue(0) }
        iname = AST_GetData1(reset)
        IfCondition EqualTo(Optimize_NameEq(iname, oname), 1) ThenBlock: { ReturnValue(0) }
        rval = AST_GetChild(reset, 0)
        IfCondition EqualTo(rval, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(rval), AST.NUMBER) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterThan(Optimize_CountIdents(reset, oname), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(inner, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(inner), AST.WHILE) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterThan(Optimize_CountIdents(inner, oname), 0) ThenBlock: { ReturnValue(0) }
        icond = AST_GetChild(inner, 0)
        ibody = AST_GetChild(inner, 1)
        IfCondition EqualTo(icond, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(icond), AST.CALL) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(StringCompare(AST_GetData1(icond), "LessThan"), 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetChildCount(icond), 2) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_IdentEq(AST_GetChild(icond, 0), iname), 0) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterThan(Optimize_CountIdents(AST_GetChild(icond, 1), iname), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(ibody, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(ibody), AST.BLOCK) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetChildCount(ibody), 2) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_RepeatAdd(AST_GetChild(ibody, 0), iname, oname), 0) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition EqualTo(Optimize_StepConst(AST_GetChild(ibody, 1), iname), 0) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition NotEqual(Optimize_StepConst(bump, oname), 1) ThenBlock: { ReturnValue(0) }
        Compile_Node(reset)
        IfCondition EqualTo(Compile.error, 1) ThenBlock: { ReturnValue(1) }
        OptState.repeat_n = trip
        OptState.repeat_hit = 0
        CompileStmt_While(inner)
        OptState.repeat_n = 0
        IfCondition EqualTo(OptState.repeat_hit, 0) ThenBlock: {
            Compile.error = 1
            ReturnValue(1)
        }
        Emit_MovRaxImm64(limit)
        stored = CompileExpr_StoreVariable(oname)
        IfCondition EqualTo(stored, 0) ThenBlock: {
            Compile.error = 1
            ReturnValue(1)
        }
        ReturnValue(1)
    }
}

// acc = Add(acc, Dereference(Add(tab, Multiply(index, scale))))
// Add is commutative. Subtract only when the accumulator is on the left.
// The table is already in r14. A cursor index uses r13. Any other index
// that does not read the accumulator is compiled to rcx and added from
// memory, so the accumulator is not pushed around the load.
Function.Optimize_TryAccMem {
    Input: target: Address
    Input: value: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(LoopHome.active, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(LoopHome.acc_name, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_NameEq(target, LoopHome.acc_name), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(value, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(value), AST.CALL) ThenBlock: { ReturnValue(0) }
        opname = AST_GetData1(value)
        is_add = EqualTo(StringCompare(opname, "Add"), 0)
        is_sub = EqualTo(StringCompare(opname, "Subtract"), 0)
        IfCondition EqualTo(is_add, 0) ThenBlock: {
            IfCondition EqualTo(is_sub, 0) ThenBlock: { ReturnValue(0) }
        }
        IfCondition NotEqual(AST_GetChildCount(value), 2) ThenBlock: { ReturnValue(0) }
        a0 = AST_GetChild(value, 0)
        a1 = AST_GetChild(value, 1)
        left_acc = 0
        right_acc = 0
        IfCondition EqualTo(AST_GetType(a0), AST.IDENTIFIER) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(AST_GetData1(a0), LoopHome.acc_name), 1) ThenBlock: {
                left_acc = 1
            }
        }
        IfCondition EqualTo(AST_GetType(a1), AST.IDENTIFIER) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(AST_GetData1(a1), LoopHome.acc_name), 1) ThenBlock: {
                right_acc = 1
            }
        }
        other = 0
        IfCondition EqualTo(is_add, 1) ThenBlock: {
            IfCondition EqualTo(left_acc, 1) ThenBlock: {
                IfCondition EqualTo(right_acc, 0) ThenBlock: { other = a1 }
            }
            IfCondition EqualTo(right_acc, 1) ThenBlock: {
                IfCondition EqualTo(left_acc, 0) ThenBlock: { other = a0 }
            }
        }
        IfCondition EqualTo(is_sub, 1) ThenBlock: {
            IfCondition EqualTo(left_acc, 1) ThenBlock: {
                IfCondition EqualTo(right_acc, 0) ThenBlock: { other = a1 }
            }
        }
        IfCondition EqualTo(other, 0) ThenBlock: { ReturnValue(0) }
        scale = Optimize_QwordScale(other)
        IfCondition EqualTo(scale, 0) ThenBlock: { ReturnValue(0) }
        acc_node = a0
        IfCondition EqualTo(left_acc, 0) ThenBlock: { acc_node = a1 }
        IfCondition EqualTo(Optimize_QwordFast(other, acc_node), 0) ThenBlock: { ReturnValue(0) }
        idx = Optimize_QwordIndex(other)
        cursor = 0
        IfCondition NotEqual(LoopHome.int_name, 0) ThenBlock: {
            IfCondition EqualTo(Optimize_IdentEq(idx, LoopHome.int_name), 1) ThenBlock: { cursor = 1 }
        }
        IfCondition EqualTo(cursor, 0) ThenBlock: {
            IfCondition GreaterThan(OptState.repeat_n, 1) ThenBlock: { ReturnValue(0) }
            IfCondition EqualTo(Optimize_TreeHasName(idx, LoopHome.acc_name), 1) ThenBlock: { ReturnValue(0) }
            got = Compile_Expression(idx)
            IfCondition EqualTo(got, 0) ThenBlock: {
                Compile.error = 1
                ReturnValue(1)
            }
            Emit_MovRcxRax()
            IfCondition EqualTo(is_sub, 1) ThenBlock: { X86_AccMemR14Rcx(43, scale) }
            IfCondition EqualTo(is_sub, 0) ThenBlock: { X86_AccMemR14Rcx(3, scale) }
            ReturnValue(1)
        }
        IfCondition GreaterThan(OptState.repeat_n, 1) ThenBlock: {
            X86_MovRaxAtR14R13(scale)
            X86_ImulRaxImm32(OptState.repeat_n)
            IfCondition EqualTo(is_sub, 1) ThenBlock: { X86_SubRegReg(Reg.R12, Reg.RAX) }
            IfCondition EqualTo(is_sub, 0) ThenBlock: { X86_AddRegReg(Reg.R12, Reg.RAX) }
            OptState.repeat_hit = Add(OptState.repeat_hit, 1)
            ReturnValue(1)
        }
        IfCondition EqualTo(is_sub, 1) ThenBlock: { X86_AccMemR14R13(43, scale) }
        IfCondition EqualTo(is_sub, 0) ThenBlock: { X86_AccMemR14R13(3, scale) }
        ReturnValue(1)
    }
}

Function.Optimize_TryAccAssign {
    Input: target: Address
    Input: value: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(LoopHome.active, 0) ThenBlock: { ReturnValue(0) }
        cls = Optimize_AccShape(target, value)
        IfCondition EqualTo(cls, 0) ThenBlock: { ReturnValue(0) }
        opname = AST_GetData1(value)
        is_sub = 0
        IfCondition EqualTo(StringCompare(opname, "Subtract"), 0) ThenBlock: { is_sub = 1 }
        disp = LoopHome.hit_disp
        IfCondition EqualTo(cls, 5) ThenBlock: {
            IfCondition EqualTo(is_sub, 1) ThenBlock: { Emit_HomeMove(34, 0) }
            IfCondition EqualTo(is_sub, 0) ThenBlock: { Emit_HomeMove(23, 0) }
            ReturnValue(1)
        }
        IfCondition EqualTo(cls, 7) ThenBlock: {
            IfCondition EqualTo(Optimize_Fit32(disp), 0) ThenBlock: { ReturnValue(0) }
            IfCondition EqualTo(is_sub, 1) ThenBlock: { Emit_HomeMove(42, disp) }
            IfCondition EqualTo(is_sub, 0) ThenBlock: { Emit_HomeMove(41, disp) }
            ReturnValue(1)
        }
        IfCondition EqualTo(cls, 2) ThenBlock: {
            IfCondition EqualTo(is_sub, 1) ThenBlock: { Emit_HomeMove(22, disp) }
            IfCondition EqualTo(is_sub, 0) ThenBlock: { Emit_HomeMove(21, disp) }
            ReturnValue(1)
        }
        IfCondition EqualTo(cls, 4) ThenBlock: {
            IfCondition EqualTo(is_sub, 1) ThenBlock: { Emit_HomeMove(22, disp) }
            IfCondition EqualTo(is_sub, 0) ThenBlock: { Emit_HomeMove(21, disp) }
            ReturnValue(1)
        }
        ReturnValue(0)
    }
}

Function.Optimize_ClassOk {
    Input: cls: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(cls, 1) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(cls, 2) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(cls, 3) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(cls, 4) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

Function.Optimize_FltSrcOk {
    Input: cls: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(Optimize_ClassOk(cls), 1) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(cls, 6) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(cls, 7) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(cls, 8) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(cls, 9) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

Function.Optimize_IdentEq {
    Input: node: Address
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(node), AST.IDENTIFIER) ThenBlock: { ReturnValue(0) }
        ReturnValue(Optimize_NameEq(AST_GetData1(node), name))
    }
}

Function.Optimize_IsFloatMul {
    Input: node: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(node), AST.CALL) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(StringCompare(AST_GetData1(node), "Float_Mul"), 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetChildCount(node), 2) ThenBlock: { ReturnValue(0) }
        ReturnValue(1)
    }
}

// home = home + (a*b), either add order, or home = home - (a*b).
// The product is fused into that xmm. Hw.level < 2 returns 0 and the
// ordinary add or subtract runs instead.
Function.Optimize_TryFltFma {
    Input: target: Address
    Input: value: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(LoopHome.active, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_IsFltHome(target), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(value, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(value), AST.CALL) ThenBlock: { ReturnValue(0) }
        opname = AST_GetData1(value)
        is_sub = 0
        is_add = 0
        IfCondition EqualTo(StringCompare(opname, "Float_Add"), 0) ThenBlock: { is_add = 1 }
        IfCondition EqualTo(StringCompare(opname, "Float_Sub"), 0) ThenBlock: { is_sub = 1 }
        IfCondition EqualTo(is_add, 0) ThenBlock: {
            IfCondition EqualTo(is_sub, 0) ThenBlock: { ReturnValue(0) }
        }
        IfCondition NotEqual(AST_GetChildCount(value), 2) ThenBlock: { ReturnValue(0) }
        left = AST_GetChild(value, 0)
        right = AST_GetChild(value, 1)
        mul = 0
        IfCondition EqualTo(is_sub, 1) ThenBlock: {
            IfCondition EqualTo(Optimize_IdentEq(left, target), 0) ThenBlock: { ReturnValue(0) }
            IfCondition EqualTo(Optimize_IsFloatMul(right), 0) ThenBlock: { ReturnValue(0) }
            mul = right
        }
        IfCondition EqualTo(is_add, 1) ThenBlock: {
            IfCondition EqualTo(Optimize_IdentEq(left, target), 1) ThenBlock: {
                IfCondition EqualTo(Optimize_IsFloatMul(right), 1) ThenBlock: { mul = right }
            }
            IfCondition EqualTo(Optimize_IdentEq(right, target), 1) ThenBlock: {
                IfCondition EqualTo(Optimize_IsFloatMul(left), 1) ThenBlock: { mul = left }
            }
            IfCondition EqualTo(mul, 0) ThenBlock: { ReturnValue(0) }
        }
        slot = Optimize_FltSlot(target)
        got = FPUCompileX86_FmaHome(slot, AST_GetChild(mul, 0), AST_GetChild(mul, 1), is_sub)
        IfCondition EqualTo(got, 0) ThenBlock: { ReturnValue(0) }
        LoopHome.hold_on = 0
        LoopHome.hold_name = 0
        ReturnValue(1)
    }
}

Function.Optimize_TryFltUpdate {
    Input: target: Address
    Input: value: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(LoopHome.active, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_IsFltHome(target), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_TryFltFma(target, value), 1) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(value, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(value), AST.CALL) ThenBlock: { ReturnValue(0) }
        opk = Optimize_FltOpKind(AST_GetData1(value))
        legal = 0
        IfCondition EqualTo(opk, 1) ThenBlock: { legal = 1 }
        IfCondition EqualTo(opk, 2) ThenBlock: { legal = 1 }
        IfCondition EqualTo(opk, 3) ThenBlock: { legal = 1 }
        IfCondition EqualTo(legal, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetChildCount(value), 2) ThenBlock: { ReturnValue(0) }
        Optimize_OpClass(AST_GetChild(value, 0))
        c0 = LoopHome.hit_class
        d0 = LoopHome.hit_disp
        x0 = LoopHome.hit_xmm
        Optimize_OpClass(AST_GetChild(value, 1))
        c1 = LoopHome.hit_class
        d1 = LoopHome.hit_disp
        x1 = LoopHome.hit_xmm
        ts = Optimize_FltSlot(target)
        home_side = -1
        IfCondition EqualTo(c0, 1) ThenBlock: {
            IfCondition EqualTo(x0, ts) ThenBlock: { home_side = 0 }
        }
        IfCondition EqualTo(c1, 1) ThenBlock: {
            IfCondition EqualTo(x1, ts) ThenBlock: {
                IfCondition LessThan(home_side, 0) ThenBlock: { home_side = 1 }
            }
        }
        IfCondition LessThan(home_side, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(opk, 2) ThenBlock: {
            IfCondition NotEqual(home_side, 0) ThenBlock: { ReturnValue(0) }
        }
        oc = c1
        od = d1
        ox = x1
        IfCondition EqualTo(home_side, 1) ThenBlock: {
            oc = c0
            od = d0
            ox = x0
        }
        IfCondition EqualTo(oc, 3) ThenBlock: {
            IfCondition EqualTo(ts, 2) ThenBlock: {
                IfCondition EqualTo(opk, 1) ThenBlock: { Emit_HomeMove(26, 0) }
                IfCondition EqualTo(opk, 2) ThenBlock: { Emit_HomeMove(36, 0) }
                IfCondition EqualTo(opk, 3) ThenBlock: { Emit_HomeMove(35, 0) }
            }
            IfCondition GreaterThan(ts, 2) ThenBlock: {
                IfCondition EqualTo(opk, 1) ThenBlock: { X86_XmmRR(5, ts) }
                IfCondition EqualTo(opk, 2) ThenBlock: { X86_XmmRR(6, ts) }
                IfCondition EqualTo(opk, 3) ThenBlock: { X86_XmmRR(7, ts) }
            }
            LoopHome.hold_on = 0
            LoopHome.hold_name = 0
            ReturnValue(1)
        }
        mem = 0
        IfCondition EqualTo(oc, 2) ThenBlock: { mem = 1 }
        IfCondition EqualTo(oc, 4) ThenBlock: { mem = 1 }
        IfCondition EqualTo(mem, 1) ThenBlock: {
            IfCondition EqualTo(ts, 2) ThenBlock: {
                IfCondition EqualTo(opk, 1) ThenBlock: { Emit_HomeMove(18, od) }
                IfCondition EqualTo(opk, 2) ThenBlock: { Emit_HomeMove(19, od) }
                IfCondition EqualTo(opk, 3) ThenBlock: { Emit_HomeMove(20, od) }
            }
            IfCondition GreaterThan(ts, 2) ThenBlock: {
                IfCondition EqualTo(opk, 1) ThenBlock: { X86_EmitR13Mem(242, 65, 15, 88, ts, od) }
                IfCondition EqualTo(opk, 2) ThenBlock: { X86_EmitR13Mem(242, 65, 15, 92, ts, od) }
                IfCondition EqualTo(opk, 3) ThenBlock: { X86_EmitR13Mem(242, 65, 15, 89, ts, od) }
            }
            ReturnValue(1)
        }
        IfCondition EqualTo(oc, 1) ThenBlock: {
            opc = 88
            IfCondition EqualTo(opk, 2) ThenBlock: { opc = 92 }
            IfCondition EqualTo(opk, 3) ThenBlock: { opc = 89 }
            X86_XmmBin(opc, ts, ox)
            ReturnValue(1)
        }
        IfCondition EqualTo(oc, 9) ThenBlock: {
            opc = 88
            IfCondition EqualTo(opk, 2) ThenBlock: { opc = 92 }
            IfCondition EqualTo(opk, 3) ThenBlock: { opc = 89 }
            X86_XmmIp(opc, ts, ox, od)
            ReturnValue(1)
        }
        frame = 0
        IfCondition EqualTo(oc, 6) ThenBlock: { frame = 1 }
        IfCondition EqualTo(oc, 8) ThenBlock: { frame = 1 }
        IfCondition EqualTo(oc, 7) ThenBlock: { frame = 2 }
        IfCondition GreaterThan(frame, 0) ThenBlock: {
            opc = 88
            IfCondition EqualTo(opk, 2) ThenBlock: { opc = 92 }
            IfCondition EqualTo(opk, 3) ThenBlock: { opc = 89 }
            IfCondition EqualTo(frame, 1) ThenBlock: { X86_EmitRbpXmm(opc, ts, od) }
            IfCondition EqualTo(frame, 2) ThenBlock: { X86_EmitR15Xmm(opc, ts, od) }
            ReturnValue(1)
        }
        ReturnValue(0)
    }
}

// Stack float or float constant times a cursor field. The product stays in
// xmm0 for its one consumer. Subtract keeps the frame on the left.
Function.Optimize_TryFltFrame {
    Input: target: Address
    Input: opk: Integer
    Input: c0: Integer
    Input: d0: Integer
    Input: c1: Integer
    Input: d1: Integer
    Output: Integer
    Body: {
        f0 = 0
        f1 = 0
        m0 = 0
        m1 = 0
        IfCondition EqualTo(c0, 6) ThenBlock: { f0 = 1 }
        IfCondition EqualTo(c0, 8) ThenBlock: { f0 = 1 }
        IfCondition EqualTo(c1, 6) ThenBlock: { f1 = 1 }
        IfCondition EqualTo(c1, 8) ThenBlock: { f1 = 1 }
        IfCondition EqualTo(c0, 2) ThenBlock: { m0 = 1 }
        IfCondition EqualTo(c0, 4) ThenBlock: { m0 = 1 }
        IfCondition EqualTo(c1, 2) ThenBlock: { m1 = 1 }
        IfCondition EqualTo(c1, 4) ThenBlock: { m1 = 1 }
        frame_disp = 0
        mem_disp = 0
        ok = 0
        IfCondition EqualTo(f0, 1) ThenBlock: {
            IfCondition EqualTo(m1, 1) ThenBlock: {
                frame_disp = d0
                mem_disp = d1
                ok = 1
            }
        }
        IfCondition EqualTo(m0, 1) ThenBlock: {
            IfCondition EqualTo(f1, 1) ThenBlock: {
                IfCondition NotEqual(opk, 2) ThenBlock: {
                    frame_disp = d1
                    mem_disp = d0
                    ok = 1
                }
            }
        }
        IfCondition EqualTo(ok, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(LoopHome.hold_on, 1) ThenBlock: { Optimize_FlushHold() }
        X86_EmitRbpXmm(16, 0, frame_disp)
        IfCondition EqualTo(opk, 1) ThenBlock: { Emit_HomeMove(27, mem_disp) }
        IfCondition EqualTo(opk, 2) ThenBlock: { Emit_HomeMove(31, mem_disp) }
        IfCondition EqualTo(opk, 3) ThenBlock: { Emit_HomeMove(25, mem_disp) }
        LoopHome.hold_on = 1
        LoopHome.hold_name = target
        ReturnValue(1)
    }
}

Function.Optimize_TryFltTemp {
    Input: target: Address
    Input: value: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(LoopHome.active, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_IsIntHome(target), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_IsFltHome(target), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_IsAccHome(target), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(value, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(value), AST.CALL) ThenBlock: { ReturnValue(0) }
        opk = Optimize_FltOpKind(AST_GetData1(value))
        legal = 0
        IfCondition EqualTo(opk, 1) ThenBlock: { legal = 1 }
        IfCondition EqualTo(opk, 2) ThenBlock: { legal = 1 }
        IfCondition EqualTo(opk, 3) ThenBlock: { legal = 1 }
        IfCondition EqualTo(legal, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetChildCount(value), 2) ThenBlock: { ReturnValue(0) }
        hold_ok = Optimize_HoldOk(target)
        IfCondition EqualTo(hold_ok, 0) ThenBlock: { hold_ok = Optimize_HoldHere(target, value) }
        IfCondition EqualTo(hold_ok, 0) ThenBlock: { ReturnValue(0) }
        Optimize_OpClass(AST_GetChild(value, 0))
        c0 = LoopHome.hit_class
        d0 = LoopHome.hit_disp
        x0 = LoopHome.hit_xmm
        Optimize_OpClass(AST_GetChild(value, 1))
        c1 = LoopHome.hit_class
        d1 = LoopHome.hit_disp
        x1 = LoopHome.hit_xmm
        pair_ok = 1
        IfCondition EqualTo(Optimize_ClassOk(c0), 0) ThenBlock: { pair_ok = 0 }
        IfCondition EqualTo(Optimize_ClassOk(c1), 0) ThenBlock: { pair_ok = 0 }
        IfCondition EqualTo(pair_ok, 0) ThenBlock: {
            ReturnValue(Optimize_TryFltFrame(target, opk, c0, d0, c1, d1))
        }
        uses_hold = 0
        IfCondition EqualTo(c0, 3) ThenBlock: { uses_hold = 1 }
        IfCondition EqualTo(c1, 3) ThenBlock: { uses_hold = 1 }
        IfCondition EqualTo(LoopHome.hold_on, 1) ThenBlock: {
            IfCondition EqualTo(uses_hold, 0) ThenBlock: { Optimize_FlushHold() }
        }
        IfCondition EqualTo(c1, 3) ThenBlock: { Emit_HomeMove(37, 0) }
        IfCondition EqualTo(c0, 1) ThenBlock: {
            IfCondition EqualTo(x0, 2) ThenBlock: { Emit_HomeMove(7, 0) }
            IfCondition GreaterThan(x0, 2) ThenBlock: { X86_XmmRR(3, x0) }
        }
        IfCondition EqualTo(c0, 2) ThenBlock: { Emit_HomeMove(24, d0) }
        IfCondition EqualTo(c0, 4) ThenBlock: { Emit_HomeMove(24, d0) }
        IfCondition EqualTo(c1, 3) ThenBlock: {
            IfCondition EqualTo(opk, 1) ThenBlock: { Emit_HomeMove(38, 0) }
            IfCondition EqualTo(opk, 2) ThenBlock: { Emit_HomeMove(39, 0) }
            IfCondition EqualTo(opk, 3) ThenBlock: { Emit_HomeMove(40, 0) }
        }
        IfCondition EqualTo(c1, 1) ThenBlock: {
            IfCondition EqualTo(x1, 2) ThenBlock: {
                IfCondition EqualTo(opk, 1) ThenBlock: { Emit_HomeMove(32, 0) }
                IfCondition EqualTo(opk, 2) ThenBlock: { Emit_HomeMove(33, 0) }
                IfCondition EqualTo(opk, 3) ThenBlock: { Emit_HomeMove(28, 0) }
            }
            IfCondition GreaterThan(x1, 2) ThenBlock: {
                IfCondition EqualTo(opk, 1) ThenBlock: { X86_XmmBin(88, 0, x1) }
                IfCondition EqualTo(opk, 2) ThenBlock: { X86_XmmBin(92, 0, x1) }
                IfCondition EqualTo(opk, 3) ThenBlock: { X86_XmmBin(89, 0, x1) }
            }
        }
        mem = 0
        IfCondition EqualTo(c1, 2) ThenBlock: { mem = 1 }
        IfCondition EqualTo(c1, 4) ThenBlock: { mem = 1 }
        IfCondition EqualTo(mem, 1) ThenBlock: {
            IfCondition EqualTo(opk, 1) ThenBlock: { Emit_HomeMove(27, d1) }
            IfCondition EqualTo(opk, 2) ThenBlock: { Emit_HomeMove(31, d1) }
            IfCondition EqualTo(opk, 3) ThenBlock: { Emit_HomeMove(25, d1) }
        }
        LoopHome.hold_on = 1
        LoopHome.hold_name = target
        ReturnValue(1)
    }
}

// One SSE op into a float home. opcode 16 loads; 88/92/89 are add/sub/mul.
// Class 3 reads the held value in xmm0 and does not flush it.

Function.Optimize_FltHomeOp {
    Input: slot: Integer
    Input: cls: Integer
    Input: disp: Integer
    Input: xmm: Integer
    Input: opcode: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(cls, 1) ThenBlock: {
            X86_XmmBin(opcode, slot, xmm)
            ReturnValue(1)
        }
        mem = 0
        IfCondition EqualTo(cls, 2) ThenBlock: { mem = 1 }
        IfCondition EqualTo(cls, 4) ThenBlock: { mem = 1 }
        IfCondition EqualTo(mem, 1) ThenBlock: {
            X86_EmitR13Mem(242, 65, 15, opcode, slot, disp)
            ReturnValue(1)
        }
        IfCondition EqualTo(cls, 3) ThenBlock: {
            IfCondition EqualTo(opcode, 16) ThenBlock: { X86_XmmRR(4, slot) }
            IfCondition EqualTo(opcode, 88) ThenBlock: { X86_XmmRR(5, slot) }
            IfCondition EqualTo(opcode, 92) ThenBlock: { X86_XmmRR(6, slot) }
            IfCondition EqualTo(opcode, 89) ThenBlock: { X86_XmmRR(7, slot) }
            IfCondition EqualTo(opcode, 94) ThenBlock: { X86_XmmBin(94, slot, 0) }
            ReturnValue(1)
        }
        IfCondition EqualTo(cls, 6) ThenBlock: {
            X86_EmitRbpXmm(opcode, slot, disp)
            ReturnValue(1)
        }
        IfCondition EqualTo(cls, 8) ThenBlock: {
            X86_EmitRbpXmm(opcode, slot, disp)
            ReturnValue(1)
        }
        IfCondition EqualTo(cls, 7) ThenBlock: {
            X86_EmitR15Xmm(opcode, slot, disp)
            ReturnValue(1)
        }
        IfCondition EqualTo(cls, 9) ThenBlock: {
            X86_XmmIp(opcode, slot, xmm, disp)
            ReturnValue(1)
        }
        ReturnValue(0)
    }
}

// A one-use float binop folded into the consumer. Both of its operands are
// already readable, so the binop is computed in the destination xmm and the
// consumer's other operand is applied there. Sub and div keep source order.
// 0 means nothing was emitted. 2 means a move landed and the rest failed.
Function.Optimize_TryFltNestInto {
    Input: slot: Integer
    Input: nested: Address
    Input: ocls: Integer
    Input: odisp: Integer
    Input: oxmm: Integer
    Input: oopc: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(nested, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(nested), AST.CALL) ThenBlock: { ReturnValue(0) }
        opk = Optimize_FltOpKind(AST_GetData1(nested))
        IfCondition EqualTo(opk, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetChildCount(nested), 2) ThenBlock: { ReturnValue(0) }
        n0 = AST_GetChild(nested, 0)
        n1 = AST_GetChild(nested, 1)
        IfCondition EqualTo(Optimize_FwdSrcOk(n0, slot), 0) ThenBlock: { ReturnValue(0) }
        c0 = LoopHome.hit_class
        d0 = LoopHome.hit_disp
        x0 = LoopHome.hit_xmm
        IfCondition EqualTo(Optimize_FwdSrcOk(n1, slot), 0) ThenBlock: { ReturnValue(0) }
        c1 = LoopHome.hit_class
        d1 = LoopHome.hit_disp
        x1 = LoopHome.hit_xmm
        nopc = 88
        IfCondition EqualTo(opk, 2) ThenBlock: { nopc = 92 }
        IfCondition EqualTo(opk, 3) ThenBlock: { nopc = 89 }
        IfCondition EqualTo(opk, 4) ThenBlock: { nopc = 94 }
        IfCondition EqualTo(Optimize_FltHomeOp(slot, c0, d0, x0, 16), 0) ThenBlock: {
            Compile.error = 1
            ReturnValue(2)
        }
        IfCondition EqualTo(Optimize_FltHomeOp(slot, c1, d1, x1, nopc), 0) ThenBlock: {
            Compile.error = 1
            ReturnValue(2)
        }
        IfCondition EqualTo(Optimize_FltHomeOp(slot, ocls, odisp, oxmm, oopc), 0) ThenBlock: {
            Compile.error = 1
            ReturnValue(2)
        }
        ReturnValue(1)
    }
}

// A call whose result the float emitter leaves in xmm0.
Function.Optimize_FltNest {
    Input: node: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(node), AST.CALL) ThenBlock: { ReturnValue(0) }
        ReturnValue(Optimize_FltProducer(AST_GetData1(node)))
    }
}

// 1 when node is only float producers and leaves. Compiling it writes xmm0,
// xmm1, and the FMA scratch, not a float home.
Function.Optimize_FltPure {
    Input: node: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        nt = AST_GetType(node)
        IfCondition EqualTo(nt, AST.IDENTIFIER) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(nt, AST.NUMBER) ThenBlock: { ReturnValue(1) }
        IfCondition NotEqual(nt, AST.CALL) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_FltProducer(AST_GetData1(node)), 0) ThenBlock: { ReturnValue(0) }
        count = AST_GetChildCount(node)
        i = 0
        WhileLoop LessThan(i, count) {
            IfCondition EqualTo(Optimize_FltPure(AST_GetChild(node, i)), 0) ThenBlock: { ReturnValue(0) }
            i = Add(i, 1)
        }
        ReturnValue(1)
    }
}

// Fresh float into a home. The destination is not an operand; in-place
// updates stay in TryFltUpdate. A load into the destination would destroy
// a left-hand use, and a subtract is not commutative. The home xmm is the
// value, so the result is not moved through rax.
//
// A nested binop on the left, whose operands are already readable, is
// computed in this home. The right operand is applied afterwards, in
// source order. A nested multiply under an add or subtract returns
// before that, so expression FMA keeps those bits. Any other nested
// child is compiled into xmm0 and then applied.

Function.Optimize_TryFltSet {
    Input: target: Address
    Input: value: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(LoopHome.active, 0) ThenBlock: { ReturnValue(0) }
        slot = Optimize_FltSlot(target)
        IfCondition LessThan(slot, 2) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(value, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(value), AST.CALL) ThenBlock: { ReturnValue(0) }
        opk = Optimize_FltOpKind(AST_GetData1(value))
        legal = 0
        IfCondition EqualTo(opk, 1) ThenBlock: { legal = 1 }
        IfCondition EqualTo(opk, 2) ThenBlock: { legal = 1 }
        IfCondition EqualTo(opk, 3) ThenBlock: { legal = 1 }
        IfCondition EqualTo(opk, 4) ThenBlock: { legal = 1 }
        IfCondition EqualTo(legal, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetChildCount(value), 2) ThenBlock: { ReturnValue(0) }
        ch0 = AST_GetChild(value, 0)
        ch1 = AST_GetChild(value, 1)
        Optimize_OpClass(ch0)
        c0 = LoopHome.hit_class
        d0 = LoopHome.hit_disp
        x0 = LoopHome.hit_xmm
        Optimize_OpClass(ch1)
        c1 = LoopHome.hit_class
        d1 = LoopHome.hit_disp
        x1 = LoopHome.hit_xmm
        nest = 0
        nest_ok = 0
        IfCondition EqualTo(opk, 1) ThenBlock: { nest_ok = 1 }
        IfCondition EqualTo(opk, 2) ThenBlock: { nest_ok = 1 }
        IfCondition EqualTo(opk, 3) ThenBlock: { nest_ok = 1 }
        IfCondition EqualTo(opk, 4) ThenBlock: { nest_ok = 1 }
        IfCondition EqualTo(Optimize_FltSrcOk(c0), 0) ThenBlock: {
            IfCondition EqualTo(nest_ok, 0) ThenBlock: { ReturnValue(0) }
            IfCondition EqualTo(Optimize_FltNest(ch0), 0) ThenBlock: { ReturnValue(0) }
            // A nested multiply stays on the generic path so it can still fuse.
            IfCondition EqualTo(opk, 1) ThenBlock: {
                IfCondition EqualTo(Optimize_IsFloatMul(ch0), 1) ThenBlock: { ReturnValue(0) }
                IfCondition EqualTo(Optimize_TreeHasIdent(ch0, target), 1) ThenBlock: { ReturnValue(0) }
            }
            IfCondition EqualTo(opk, 2) ThenBlock: {
                IfCondition EqualTo(Optimize_IsFloatMul(ch0), 1) ThenBlock: { ReturnValue(0) }
                IfCondition EqualTo(Optimize_TreeHasIdent(ch0, target), 1) ThenBlock: { ReturnValue(0) }
            }
            nest = 1
        }
        IfCondition EqualTo(Optimize_FltSrcOk(c1), 0) ThenBlock: {
            IfCondition NotEqual(nest, 0) ThenBlock: { ReturnValue(0) }
            IfCondition EqualTo(nest_ok, 0) ThenBlock: { ReturnValue(0) }
            IfCondition EqualTo(Optimize_FltNest(ch1), 0) ThenBlock: { ReturnValue(0) }
            IfCondition EqualTo(opk, 1) ThenBlock: {
                IfCondition EqualTo(Optimize_IsFloatMul(ch1), 1) ThenBlock: { ReturnValue(0) }
                IfCondition EqualTo(Optimize_TreeHasIdent(ch1, target), 1) ThenBlock: { ReturnValue(0) }
            }
            IfCondition EqualTo(opk, 2) ThenBlock: {
                IfCondition EqualTo(Optimize_IsFloatMul(ch1), 1) ThenBlock: { ReturnValue(0) }
                IfCondition EqualTo(Optimize_TreeHasIdent(ch1, target), 1) ThenBlock: { ReturnValue(0) }
            }
            nest = 2
        }
        IfCondition EqualTo(nest, 1) ThenBlock: {
            IfCondition EqualTo(c1, 3) ThenBlock: { ReturnValue(0) }
            IfCondition EqualTo(c1, 1) ThenBlock: {
                IfCondition EqualTo(x1, slot) ThenBlock: { ReturnValue(0) }
            }
        }
        IfCondition EqualTo(nest, 2) ThenBlock: {
            IfCondition EqualTo(c0, 3) ThenBlock: { ReturnValue(0) }
        }
        IfCondition EqualTo(nest, 0) ThenBlock: {
            IfCondition EqualTo(c0, 1) ThenBlock: {
                IfCondition EqualTo(x0, slot) ThenBlock: { ReturnValue(0) }
            }
            IfCondition EqualTo(c1, 1) ThenBlock: {
                IfCondition EqualTo(x1, slot) ThenBlock: { ReturnValue(0) }
            }
        }
        uses_hold = 0
        IfCondition EqualTo(c0, 3) ThenBlock: { uses_hold = 1 }
        IfCondition EqualTo(c1, 3) ThenBlock: { uses_hold = 1 }
        IfCondition EqualTo(LoopHome.hold_on, 1) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(target, LoopHome.hold_name), 1) ThenBlock: { uses_hold = 1 }
            IfCondition EqualTo(Optimize_TreeHasIdent(value, LoopHome.hold_name), 1) ThenBlock: { uses_hold = 1 }
            IfCondition EqualTo(uses_hold, 0) ThenBlock: {
                IfCondition NotEqual(nest, 0) ThenBlock: { Optimize_FlushHold() }
            }
        }
        opc = 88
        IfCondition EqualTo(opk, 2) ThenBlock: { opc = 92 }
        IfCondition EqualTo(opk, 3) ThenBlock: { opc = 89 }
        IfCondition EqualTo(opk, 4) ThenBlock: { opc = 94 }
        IfCondition EqualTo(nest, 1) ThenBlock: {
            direct = Optimize_TryFltNestInto(slot, ch0, c1, d1, x1, opc)
            IfCondition EqualTo(direct, 2) ThenBlock: { ReturnValue(1) }
            IfCondition EqualTo(direct, 1) ThenBlock: {
                IfCondition EqualTo(LoopHome.hold_on, 1) ThenBlock: {
                    IfCondition EqualTo(Optimize_TreeHasIdent(ch0, LoopHome.hold_name), 1) ThenBlock: {
                        uses_hold = 1
                    }
                }
                IfCondition EqualTo(uses_hold, 1) ThenBlock: {
                    LoopHome.hold_on = 0
                    LoopHome.hold_name = 0
                }
                ReturnValue(1)
            }
            saved = OptState.xmm_out
            OptState.xmm_out = 1
            got = Compile_Expression(ch0)
            OptState.xmm_out = saved
            IfCondition EqualTo(got, 0) ThenBlock: {
                Compile.error = 1
                ReturnValue(1)
            }
            IfCondition EqualTo(Optimize_FltHomeOp(slot, 3, 0, 0, 16), 0) ThenBlock: {
                Compile.error = 1
                ReturnValue(1)
            }
            IfCondition EqualTo(Optimize_FltHomeOp(slot, c1, d1, x1, opc), 0) ThenBlock: {
                Compile.error = 1
                ReturnValue(1)
            }
            IfCondition EqualTo(uses_hold, 1) ThenBlock: {
                LoopHome.hold_on = 0
                LoopHome.hold_name = 0
            }
            ReturnValue(1)
        }
        IfCondition EqualTo(nest, 2) ThenBlock: {
            early = 0
            IfCondition EqualTo(Optimize_FltPure(ch1), 1) ThenBlock: {
                IfCondition EqualTo(Optimize_TreeHasIdent(ch1, target), 0) ThenBlock: { early = 1 }
            }
            IfCondition EqualTo(early, 1) ThenBlock: {
                IfCondition EqualTo(Optimize_FltHomeOp(slot, c0, d0, x0, 16), 0) ThenBlock: {
                    Compile.error = 1
                    ReturnValue(1)
                }
            }
            saved = OptState.xmm_out
            OptState.xmm_out = 1
            got = Compile_Expression(ch1)
            OptState.xmm_out = saved
            IfCondition EqualTo(got, 0) ThenBlock: {
                Compile.error = 1
                ReturnValue(1)
            }
            IfCondition EqualTo(early, 0) ThenBlock: {
                IfCondition EqualTo(Optimize_FltHomeOp(slot, c0, d0, x0, 16), 0) ThenBlock: {
                    Compile.error = 1
                    ReturnValue(1)
                }
            }
            IfCondition EqualTo(Optimize_FltHomeOp(slot, 3, 0, 0, opc), 0) ThenBlock: {
                Compile.error = 1
                ReturnValue(1)
            }
            IfCondition EqualTo(uses_hold, 1) ThenBlock: {
                LoopHome.hold_on = 0
                LoopHome.hold_name = 0
            }
            ReturnValue(1)
        }
        IfCondition EqualTo(nest, 0) ThenBlock: {
            IfCondition EqualTo(opk, 3) ThenBlock: {
                IfCondition EqualTo(c0, 1) ThenBlock: {
                    IfCondition EqualTo(c1, 1) ThenBlock: {
                        IfCondition EqualTo(Optimize_CoalPick(target, ch0, ch1, x0, x1, value), 1) ThenBlock: {
                            IfCondition EqualTo(uses_hold, 1) ThenBlock: {
                                LoopHome.hold_on = 0
                                LoopHome.hold_name = 0
                            }
                            ReturnValue(1)
                        }
                    }
                }
            }
        }
        IfCondition EqualTo(Optimize_FltHomeOp(slot, c0, d0, x0, 16), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_FltHomeOp(slot, c1, d1, x1, opc), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(uses_hold, 1) ThenBlock: {
            LoopHome.hold_on = 0
            LoopHome.hold_name = 0
        }
        ReturnValue(1)
    }
}

// Direct operand of a float add, subtract, or multiply. A nested use stays stored.
Function.Optimize_FltDirectUse {
    Input: stmt: Address
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(stmt, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(stmt), AST.ASSIGNMENT) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetData2(stmt), 0) ThenBlock: { ReturnValue(0) }
        value = AST_GetChild(stmt, 0)
        IfCondition EqualTo(value, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(value), AST.CALL) ThenBlock: { ReturnValue(0) }
        opk = Optimize_FltOpKind(AST_GetData1(value))
        legal = 0
        IfCondition EqualTo(opk, 1) ThenBlock: { legal = 1 }
        IfCondition EqualTo(opk, 2) ThenBlock: { legal = 1 }
        IfCondition EqualTo(opk, 3) ThenBlock: { legal = 1 }
        IfCondition EqualTo(legal, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetChildCount(value), 2) ThenBlock: { ReturnValue(0) }
        hit = 0
        c0 = AST_GetChild(value, 0)
        c1 = AST_GetChild(value, 1)
        IfCondition NotEqual(c0, 0) ThenBlock: {
            IfCondition EqualTo(AST_GetType(c0), AST.IDENTIFIER) ThenBlock: {
                IfCondition EqualTo(Optimize_NameEq(AST_GetData1(c0), name), 1) ThenBlock: { hit = 1 }
            }
        }
        IfCondition NotEqual(c1, 0) ThenBlock: {
            IfCondition EqualTo(AST_GetType(c1), AST.IDENTIFIER) ThenBlock: {
                IfCondition EqualTo(Optimize_NameEq(AST_GetData1(c1), name), 1) ThenBlock: { hit = 1 }
            }
        }
        ReturnValue(hit)
    }
}

// One later read, and it is a direct float add, subtract, or multiply.
// The window runs to the next assignment of this name. A cursor add does not
// end it: the loaded bits do not follow the cursor. A read inside the next
// assignment still needs the stack slot.
Function.Optimize_HoldFloatBlock {
    Input: block: Address
    Input: target: Address
    Input: value: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(block, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_FoldIsBlock(block), 0) ThenBlock: { ReturnValue(0) }
        count = AST_GetChildCount(block)
        found = -1
        i = 0
        WhileLoop LessThan(i, count) {
            st = AST_GetChild(block, i)
            IfCondition NotEqual(st, 0) ThenBlock: {
                IfCondition EqualTo(AST_GetType(st), AST.ASSIGNMENT) ThenBlock: {
                    IfCondition EqualTo(AST_GetData2(st), 0) ThenBlock: {
                        IfCondition EqualTo(Optimize_NameEq(AST_GetData1(st), target), 1) ThenBlock: {
                            IfCondition EqualTo(AST_GetChild(st, 0), value) ThenBlock: {
                                found = i
                                i = count
                            }
                        }
                    }
                }
            }
            i = Add(i, 1)
        }
        IfCondition LessThan(found, 0) ThenBlock: { ReturnValue(0) }
        uses = 0
        k = Add(found, 1)
        WhileLoop LessThan(k, count) {
            sk = AST_GetChild(block, k)
            stop = 0
            IfCondition NotEqual(sk, 0) ThenBlock: {
                IfCondition EqualTo(AST_GetType(sk), AST.ASSIGNMENT) ThenBlock: {
                    IfCondition EqualTo(AST_GetData2(sk), 0) ThenBlock: {
                        IfCondition EqualTo(Optimize_NameEq(AST_GetData1(sk), target), 1) ThenBlock: {
                            IfCondition EqualTo(Optimize_TreeHasIdent(sk, target), 1) ThenBlock: { ReturnValue(0) }
                            stop = 1
                        }
                    }
                }
                IfCondition EqualTo(stop, 0) ThenBlock: {
                    nt = AST_GetType(sk)
                    IfCondition EqualTo(nt, AST.POINTER_FIELD_ASSIGN) ThenBlock: {
                        IfCondition EqualTo(Optimize_NameEq(AST_GetData1(sk), target), 1) ThenBlock: { ReturnValue(0) }
                    }
                    IfCondition EqualTo(nt, AST.INDEX_ASSIGN) ThenBlock: {
                        IfCondition EqualTo(Optimize_NameEq(AST_GetData1(sk), target), 1) ThenBlock: { ReturnValue(0) }
                    }
                    nest = 0
                    IfCondition EqualTo(nt, AST.IF) ThenBlock: { nest = 1 }
                    IfCondition EqualTo(nt, AST.FORK) ThenBlock: { nest = 1 }
                    IfCondition EqualTo(nt, AST.SWITCH) ThenBlock: { nest = 1 }
                    IfCondition EqualTo(nt, AST.BRANCH) ThenBlock: { nest = 1 }
                    IfCondition EqualTo(nt, AST.WHILE) ThenBlock: { nest = 1 }
                    IfCondition EqualTo(nest, 1) ThenBlock: {
                        IfCondition EqualTo(Optimize_TreeHasIdent(sk, target), 1) ThenBlock: { ReturnValue(0) }
                    }
                    IfCondition EqualTo(Optimize_TreeHasIdent(sk, target), 1) ThenBlock: {
                        uses = Add(uses, 1)
                        IfCondition EqualTo(Optimize_FltDirectUse(sk, target), 0) ThenBlock: { ReturnValue(0) }
                    }
                }
            }
            IfCondition EqualTo(stop, 1) ThenBlock: { k = count }
            k = Add(k, 1)
        }
        IfCondition EqualTo(uses, 1) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

// A read before the first assignment is the previous iteration's value.
Function.Optimize_HoldFloatCarry {
    Input: target: Address
    Output: Integer
    Body: {
        body = LoopHome.body
        IfCondition EqualTo(body, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_FoldIsBlock(body), 0) ThenBlock: { ReturnValue(0) }
        count = AST_GetChildCount(body)
        i = 0
        WhileLoop LessThan(i, count) {
            st = AST_GetChild(body, i)
            IfCondition NotEqual(st, 0) ThenBlock: {
                stt = AST_GetType(st)
                IfCondition EqualTo(stt, AST.POINTER_FIELD_ASSIGN) ThenBlock: {
                    IfCondition EqualTo(Optimize_NameEq(AST_GetData1(st), target), 1) ThenBlock: { ReturnValue(0) }
                }
                IfCondition EqualTo(stt, AST.INDEX_ASSIGN) ThenBlock: {
                    IfCondition EqualTo(Optimize_NameEq(AST_GetData1(st), target), 1) ThenBlock: { ReturnValue(0) }
                }
                IfCondition EqualTo(stt, AST.ASSIGNMENT) ThenBlock: {
                    IfCondition EqualTo(AST_GetData2(st), 0) ThenBlock: {
                        IfCondition EqualTo(Optimize_NameEq(AST_GetData1(st), target), 1) ThenBlock: {
                            IfCondition EqualTo(Optimize_TreeHasIdent(st, target), 1) ThenBlock: { ReturnValue(0) }
                            ReturnValue(1)
                        }
                    }
                }
                IfCondition EqualTo(Optimize_TreeHasIdent(st, target), 1) ThenBlock: { ReturnValue(0) }
            }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

Function.Optimize_HoldFloatUse {
    Input: target: Address
    Input: value: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(Optimize_HoldFloatBlock(LoopHome.body, target, value), 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(Optimize_HoldFloatCarry(target))
    }
}

// name = Dereference(Add(table, Multiply(index, 1/2/4/8))). The qword stays in
// xmm0 when its only consumer is a float add, subtract, or multiply and nothing
// outside this loop reads the name. The table is already in r14. No stack store.
Function.Optimize_TryHoldTable {
    Input: target: Address
    Input: value: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(LoopHome.active, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(LoopHome.tab_on, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(target, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_IsIntHome(target), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_IsFltHome(target), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_IsAccHome(target), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(value, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(value), AST.CALL) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(StringCompare(AST_GetData1(value), "Dereference"), 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetChildCount(value), 1) ThenBlock: { ReturnValue(0) }
        addr = AST_GetChild(value, 0)
        IfCondition EqualTo(addr, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(addr), AST.CALL) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(StringCompare(AST_GetData1(addr), "Add"), 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetChildCount(addr), 2) ThenBlock: { ReturnValue(0) }
        base = AST_GetChild(addr, 0)
        mul = AST_GetChild(addr, 1)
        IfCondition EqualTo(base, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(base), AST.IDENTIFIER) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_NameEq(AST_GetData1(base), LoopHome.tab_name), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(mul, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(mul), AST.CALL) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(StringCompare(AST_GetData1(mul), "Multiply"), 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetChildCount(mul), 2) ThenBlock: { ReturnValue(0) }
        left = AST_GetChild(mul, 0)
        right = AST_GetChild(mul, 1)
        scale_node = 0
        index = 0
        IfCondition NotEqual(right, 0) ThenBlock: {
            IfCondition EqualTo(AST_GetType(right), AST.NUMBER) ThenBlock: {
                scale_node = right
                index = left
            }
        }
        IfCondition EqualTo(scale_node, 0) ThenBlock: {
            IfCondition NotEqual(left, 0) ThenBlock: {
                IfCondition EqualTo(AST_GetType(left), AST.NUMBER) ThenBlock: {
                    scale_node = left
                    index = right
                }
            }
        }
        IfCondition EqualTo(scale_node, 0) ThenBlock: { ReturnValue(0) }
        sv = StringToNumber(AST_GetData1(scale_node))
        scale_ok = 0
        IfCondition EqualTo(sv, 1) ThenBlock: { scale_ok = 1 }
        IfCondition EqualTo(sv, 2) ThenBlock: { scale_ok = 1 }
        IfCondition EqualTo(sv, 4) ThenBlock: { scale_ok = 1 }
        IfCondition EqualTo(sv, 8) ThenBlock: { scale_ok = 1 }
        IfCondition EqualTo(scale_ok, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_RbxSafeOp(index), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_HoldFloatUse(target, value), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Compile.current_func, 0) ThenBlock: { ReturnValue(0) }
        saved = LoopHome.mention_count
        body_n = Optimize_CountMentions(target)
        LoopHome.mention_count = 0
        Optimize_CountWalk(Compile.current_func, target)
        func_n = LoopHome.mention_count
        LoopHome.mention_count = saved
        IfCondition NotEqual(func_n, body_n) ThenBlock: { ReturnValue(0) }
        Optimize_AliasClear(target)
        Optimize_FlushHold()
        got = Compile_Expression(index)
        IfCondition EqualTo(got, 0) ThenBlock: {
            Compile.error = 1
            ReturnValue(1)
        }
        Emit_MovRcxRax()
        X86_MovRaxDerefR14RcxScaled(sv)
        Emit_HomeMove(11, 0)
        LoopHome.hold_on = 1
        LoopHome.hold_name = target
        ReturnValue(1)
    }
}

Function.Optimize_TryFoldAssign {
    Input: target: Address
    Input: value: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(LoopHome.active, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_TryFltFwdApply(target, value), 1) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(Optimize_TryFltFwd(target, value), 1) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(Optimize_TryAccLogic(target, value), 1) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(Optimize_TryGetByteAssign(target, value), 1) ThenBlock: { ReturnValue(1) }
        Optimize_IholdMakeRoom(value)
        IfCondition EqualTo(Optimize_TryAliasAssign(target, value), 1) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(Optimize_TryAccAssign(target, value), 1) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(Optimize_TryAccCall(target, value), 1) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(Optimize_TryAccMem(target, value), 1) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(Optimize_TryFltUpdate(target, value), 1) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(Optimize_TryFltSet(target, value), 1) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(Optimize_TryFltConst(target, value), 1) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(Optimize_TryFltTemp(target, value), 1) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(Optimize_TryHoldTable(target, value), 1) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(Optimize_TryFltKeep(target, value), 1) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

// 1 when xmm is a float home or the FMA scratch. xmm0 and xmm1 stay free.
Function.Optimize_SseBusy {
    Input: xmm: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(xmm, 15) ThenBlock: { ReturnValue(1) }
        IfCondition LessThan(xmm, 0) ThenBlock: { ReturnValue(1) }
        IfCondition GreaterThan(xmm, 14) ThenBlock: { ReturnValue(1) }
        IfCondition NotEqual(LoopHome.flt_name, 0) ThenBlock: {
            IfCondition EqualTo(xmm, 2) ThenBlock: { ReturnValue(1) }
        }
        IfCondition NotEqual(LoopHome.f2_name, 0) ThenBlock: {
            IfCondition EqualTo(xmm, 3) ThenBlock: { ReturnValue(1) }
        }
        IfCondition NotEqual(LoopHome.f3_name, 0) ThenBlock: {
            IfCondition EqualTo(xmm, 4) ThenBlock: { ReturnValue(1) }
        }
        IfCondition NotEqual(LoopHome.f4_name, 0) ThenBlock: {
            IfCondition EqualTo(xmm, 5) ThenBlock: { ReturnValue(1) }
        }
        IfCondition NotEqual(LoopHome.f5_name, 0) ThenBlock: {
            IfCondition EqualTo(xmm, 6) ThenBlock: { ReturnValue(1) }
        }
        IfCondition NotEqual(LoopHome.f6_name, 0) ThenBlock: {
            IfCondition EqualTo(xmm, 7) ThenBlock: { ReturnValue(1) }
        }
        IfCondition GreaterThan(LoopHome.xf_n, 0) ThenBlock: {
            i = 0
            WhileLoop LessThan(i, LoopHome.xf_n) {
                IfCondition EqualTo(xmm, Add(8, i)) ThenBlock: { ReturnValue(1) }
                i = Add(i, 1)
            }
        }
        IfCondition EqualTo(LoopHome.coal_on, 1) ThenBlock: {
            IfCondition EqualTo(xmm, LoopHome.coal_slot) ThenBlock: { ReturnValue(1) }
        }
        ReturnValue(0)
    }
}

// Next SSE2 scratch that is not the accumulator and not a live home.
// Back-to-back products land in different xmms, so the multiplies overlap.
Function.Optimize_SseScratch {
    Input: avoid: Integer
    Output: Integer
    Body: {
        start = LoopHome.sse_scratch
        IfCondition LessThan(start, 0) ThenBlock: { start = 0 }
        IfCondition GreaterThan(start, 14) ThenBlock: { start = 0 }
        i = 0
        WhileLoop LessThan(i, 15) {
            xmm = Add(start, i)
            IfCondition GreaterThan(xmm, 14) ThenBlock: { xmm = Subtract(xmm, 15) }
            free = 1
            IfCondition EqualTo(xmm, avoid) ThenBlock: { free = 0 }
            IfCondition EqualTo(Optimize_SseBusy(xmm), 1) ThenBlock: { free = 0 }
            IfCondition EqualTo(free, 1) ThenBlock: {
                nxt = Add(xmm, 1)
                IfCondition GreaterThan(nxt, 14) ThenBlock: { nxt = 0 }
                LoopHome.sse_scratch = nxt
                ReturnValue(xmm)
            }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

// A float home whose value is a float expression. The expression leaves
// the bits in xmm0 and movsd copies them into the home. SSE2. The integer
// movq round trip is not used.
Function.Optimize_TryFltKeep {
    Input: target: Address
    Input: value: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(LoopHome.active, 0) ThenBlock: { ReturnValue(0) }
        slot = Optimize_FltSlot(target)
        IfCondition LessThan(slot, 2) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(value, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(value), AST.CALL) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_FltProducer(AST_GetData1(value)), 0) ThenBlock: { ReturnValue(0) }
        saved = OptState.xmm_out
        OptState.xmm_out = 1
        got = Compile_Expression(value)
        OptState.xmm_out = saved
        IfCondition EqualTo(got, 0) ThenBlock: {
            Compile.error = 1
            ReturnValue(1)
        }
        IfCondition EqualTo(Optimize_FltHomeOp(slot, 3, 0, 0, 16), 0) ThenBlock: {
            Compile.error = 1
            ReturnValue(1)
        }
        IfCondition EqualTo(LoopHome.hold_on, 1) ThenBlock: {
            IfCondition EqualTo(Optimize_TreeHasIdent(value, LoopHome.hold_name), 1) ThenBlock: {
                LoopHome.hold_on = 0
                LoopHome.hold_name = 0
            }
        }
        ReturnValue(1)
    }
}

Function.Optimize_ArmReady {
    Input: target: Address
    Input: value: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(LoopHome.active, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_IsIntHome(target), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_IsFltHome(target), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_IsAccHome(target), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(value, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(value), AST.CALL) ThenBlock: { ReturnValue(0) }
        opk = Optimize_FltOpKind(AST_GetData1(value))
        legal = 0
        IfCondition EqualTo(opk, 1) ThenBlock: { legal = 1 }
        IfCondition EqualTo(opk, 2) ThenBlock: { legal = 1 }
        IfCondition EqualTo(opk, 3) ThenBlock: { legal = 1 }
        IfCondition EqualTo(legal, 0) ThenBlock: { ReturnValue(0) }
        hold_ok = Optimize_HoldOk(target)
        IfCondition EqualTo(hold_ok, 0) ThenBlock: { hold_ok = Optimize_HoldHere(target, value) }
        ReturnValue(hold_ok)
    }
}

Function.Optimize_ArmHold {
    Input: target: Address
    Input: value: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(Optimize_ArmReady(target, value), 0) ThenBlock: { ReturnValue(0) }
        LoopHome.hold_on = 1
        LoopHome.hold_name = target
        ReturnValue(1)
    }
}

Function.Optimize_SetDebug {
    Input: enabled: Integer
    Body: {
        OptState.debug = enabled
    }
}

// =============================================================================
// CALL SPLICE
// A direct call whose arguments are names or numbers is replaced, in a copy
// of a small ordinary Function, by those arguments. Two levels: a spliced
// copy may itself be spliced once, and calls inside that second copy stay
// calls. The callable function stays in the binary. A body that contains
// InlineAsm stays a call: the text is the argument registers.
// Run from CompileFunc_Function before locals are counted, so the frame and
// the loop-register pass see the spliced statements.
// =============================================================================

Function.Optimize_InlineCap {
    Output: Integer
    Body: {
        ReturnValue(32)
    }
}

Function.Optimize_InlineBuiltin {
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(Optimize_HomeCallOk(name), 1) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "CallIndirect"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "AddressOf"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "RunTask"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "ReturnValue"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "Allocate"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "Deallocate"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "StoreValue"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "GetByte"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "SetByte"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "MemoryCopy"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "MemorySet"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "MemCompare"), 0) ThenBlock: { ReturnValue(1) }
        // CompileFile lowers these. The registered bodies are stubs, so
        // splicing one would run the stub instead of the syscall.
        IfCondition EqualTo(StringCompare(name, "FileOpen"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "FileWrite"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "FileClose"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "FileRead"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "FileSeek"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "FileGetSize"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "FileExists"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "ReadBinaryFile"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "WriteBinaryFile"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "OpenFile"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "CloseFile"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "GetFileSize"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "WriteTextFile"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "ReadTextFile"), 0) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

Function.Optimize_InlineFail {
    Input: params: Address
    Input: renames: Address
    Input: stmts: Address
    Output: Integer
    Body: {
        IfCondition NotEqual(params, 0) ThenBlock: { Array.Destroy(params) }
        IfCondition NotEqual(renames, 0) ThenBlock: { SHash.Destroy(renames) }
        IfCondition NotEqual(stmts, 0) ThenBlock: { Array.Destroy(stmts) }
        ReturnValue(0)
    }
}

Function.Optimize_InlineFresh {
    Input: avoid: Address
    Output: Address
    Body: {
        guard = 0
        name = 0
        WhileLoop LessThan(guard, 10000) {
            seq = OptState.inline_seq
            OptState.inline_seq = Add(seq, 1)
            name = StringConcat("_inl", NumberToString(seq))
            hit = 0
            IfCondition NotEqual(avoid, 0) ThenBlock: {
                IfCondition EqualTo(SHash.Exists(avoid, name), 1) ThenBlock: { hit = 1 }
            }
            IfCondition EqualTo(hit, 0) ThenBlock: {
                IfCondition NotEqual(avoid, 0) ThenBlock: {
                    SHash.Insert(avoid, name, 1)
                }
                ReturnValue(name)
            }
            guard = Add(guard, 1)
        }
        ReturnValue(name)
    }
}

Function.Optimize_InlineNote {
    Input: names: Address
    Input: name: Address
    Body: {
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(SHash.Exists(names, name), 0) ThenBlock: {
            SHash.Insert(names, name, 1)
        }
        ReturnValue(0)
    }
}

Function.Optimize_InlineCollect {
    Input: node: Address
    Input: names: Address
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(names, 0) ThenBlock: { ReturnValue(0) }
        t = AST_GetType(node)
        IfCondition EqualTo(t, AST.IDENTIFIER) ThenBlock: {
            Optimize_InlineNote(names, AST_GetData1(node))
        }
        IfCondition EqualTo(t, AST.ASSIGNMENT) ThenBlock: {
            Optimize_InlineNote(names, AST_GetData1(node))
        }
        IfCondition EqualTo(t, AST.INDEX_ASSIGN) ThenBlock: {
            Optimize_InlineNote(names, AST_GetData1(node))
        }
        IfCondition EqualTo(t, AST.PARAMETER) ThenBlock: {
            Optimize_InlineNote(names, AST_GetData1(node))
        }
        count = AST_GetChildCount(node)
        i = 0
        WhileLoop LessThan(i, count) {
            Optimize_InlineCollect(AST_GetChild(node, i), names)
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

Function.Optimize_InlineMapped {
    Input: renames: Address
    Input: name: Address
    Output: Address
    Body: {
        IfCondition EqualTo(renames, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }
        hit = SHash.LookupAddr(renames, name)
        IfCondition EqualTo(hit, Collections.XNULL) ThenBlock: { ReturnValue(0) }
        ReturnValue(hit)
    }
}

Function.Optimize_InlineClone {
    Input: node: Address
    Input: renames: Address
    Output: Address
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        t = AST_GetType(node)
        out = AST_Create(t)
        IfCondition EqualTo(out, 0) ThenBlock: { ReturnValue(0) }
        AST_SetLine(out, AST_GetLine(node))
        AST_SetCol(out, AST_GetCol(node))
        d1 = AST_GetData1(node)
        rename_d1 = 0
        IfCondition EqualTo(t, AST.IDENTIFIER) ThenBlock: { rename_d1 = 1 }
        IfCondition EqualTo(t, AST.ASSIGNMENT) ThenBlock: { rename_d1 = 1 }
        IfCondition EqualTo(t, AST.INDEX_ASSIGN) ThenBlock: { rename_d1 = 1 }
        IfCondition EqualTo(rename_d1, 1) ThenBlock: {
            IfCondition EqualTo(Compile_ContainsDot(d1), 0) ThenBlock: {
                mapped = Optimize_InlineMapped(renames, d1)
                IfCondition NotEqual(mapped, 0) ThenBlock: { d1 = mapped }
            }
        }
        AST_SetData1(out, d1)
        AST_SetData2(out, AST_GetData2(node))
        AST_SetData3(out, AST_GetData3(node))
        AST_SetData4(out, AST_GetData4(node))
        count = AST_GetChildCount(node)
        i = 0
        WhileLoop LessThan(i, count) {
            ch = Optimize_InlineClone(AST_GetChild(node, i), renames)
            IfCondition NotEqual(ch, 0) ThenBlock: {
                AST_AddChild(out, ch)
            }
            i = Add(i, 1)
        }
        ReturnValue(out)
    }
}

Function.Optimize_InlineChild {
    Input: node: Address
    Input: index: Integer
    Output: Address
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(index, 0) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterEqual(index, AST_GetChildCount(node)) ThenBlock: { ReturnValue(0) }
        ReturnValue(AST_GetChild(node, index))
    }
}

Function.Optimize_InlineCountAny {
    Input: node: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        n = 0
        count = AST_GetChildCount(node)
        i = 0
        WhileLoop LessThan(i, count) {
            n = Add(n, Optimize_InlineCount(AST_GetChild(node, i)))
            i = Add(i, 1)
        }
        ReturnValue(n)
    }
}

Function.Optimize_InlineCountBlock {
    Input: node: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        n = 0
        count = AST_GetChildCount(node)
        i = 0
        WhileLoop LessThan(i, count) {
            c = Optimize_InlineCount(AST_GetChild(node, i))
            IfCondition EqualTo(c, 0) ThenBlock: { n = Add(n, 1) }
            IfCondition GreaterThan(c, 0) ThenBlock: { n = Add(n, c) }
            i = Add(i, 1)
        }
        ReturnValue(n)
    }
}

Function.Optimize_InlineCountTail {
    Input: node: Address
    Output: Integer
    Body: {
        n = 0
        count = AST_GetChildCount(node)
        i = 1
        WhileLoop LessThan(i, count) {
            n = Add(n, Optimize_InlineCount(AST_GetChild(node, i)))
            i = Add(i, 1)
        }
        ReturnValue(n)
    }
}

Function.Optimize_InlineCount {
    Input: node: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        t = AST_GetType(node)
        IfCondition EqualTo(t, AST.BLOCK) ThenBlock: { ReturnValue(Optimize_InlineCountBlock(node)) }
        IfCondition EqualTo(t, AST.BODY) ThenBlock: { ReturnValue(Optimize_InlineCountBlock(node)) }
        IfCondition EqualTo(t, AST.CASE) ThenBlock: { ReturnValue(Optimize_InlineCountAny(node)) }
        IfCondition EqualTo(t, AST.DEFAULT) ThenBlock: { ReturnValue(Optimize_InlineCountAny(node)) }
        IfCondition EqualTo(t, AST.CATCH) ThenBlock: { ReturnValue(Optimize_InlineCountAny(node)) }
        IfCondition EqualTo(t, AST.FINALLY) ThenBlock: { ReturnValue(Optimize_InlineCountAny(node)) }

        stmt = 0
        IfCondition EqualTo(t, AST.ASSIGNMENT) ThenBlock: { stmt = 1 }
        IfCondition EqualTo(t, AST.RETURN) ThenBlock: { stmt = 1 }
        IfCondition EqualTo(t, AST.CALL) ThenBlock: { stmt = 1 }
        IfCondition EqualTo(t, AST.IF) ThenBlock: { stmt = 1 }
        IfCondition EqualTo(t, AST.FORK) ThenBlock: { stmt = 1 }
        IfCondition EqualTo(t, AST.WHILE) ThenBlock: { stmt = 1 }
        IfCondition EqualTo(t, AST.UNTIL) ThenBlock: { stmt = 1 }
        IfCondition EqualTo(t, AST.SWITCH) ThenBlock: { stmt = 1 }
        IfCondition EqualTo(t, AST.BRANCH) ThenBlock: { stmt = 1 }
        IfCondition EqualTo(t, AST.FOR_EVERY) ThenBlock: { stmt = 1 }
        IfCondition EqualTo(t, AST.TRY) ThenBlock: { stmt = 1 }
        IfCondition EqualTo(t, AST.EXIT_LOOP) ThenBlock: { stmt = 1 }
        IfCondition EqualTo(t, AST.CONTINUE_LOOP) ThenBlock: { stmt = 1 }
        IfCondition EqualTo(stmt, 0) ThenBlock: { ReturnValue(0) }

        n = 1
        IfCondition EqualTo(t, AST.IF) ThenBlock: {
            n = Add(n, Optimize_InlineCount(Optimize_InlineChild(node, 1)))
            n = Add(n, Optimize_InlineCount(Optimize_InlineChild(node, 2)))
            ReturnValue(n)
        }
        IfCondition EqualTo(t, AST.FORK) ThenBlock: {
            n = Add(n, Optimize_InlineCount(Optimize_InlineChild(node, 1)))
            n = Add(n, Optimize_InlineCount(Optimize_InlineChild(node, 2)))
            ReturnValue(n)
        }
        IfCondition EqualTo(t, AST.WHILE) ThenBlock: {
            n = Add(n, Optimize_InlineCount(Optimize_InlineChild(node, 1)))
            ReturnValue(n)
        }
        IfCondition EqualTo(t, AST.UNTIL) ThenBlock: {
            n = Add(n, Optimize_InlineCount(Optimize_InlineChild(node, 1)))
            ReturnValue(n)
        }
        IfCondition EqualTo(t, AST.FOR_EVERY) ThenBlock: {
            n = Add(n, Optimize_InlineCount(Optimize_InlineChild(node, 1)))
            ReturnValue(n)
        }
        IfCondition EqualTo(t, AST.SWITCH) ThenBlock: {
            n = Add(n, Optimize_InlineCountTail(node))
            ReturnValue(n)
        }
        IfCondition EqualTo(t, AST.BRANCH) ThenBlock: {
            n = Add(n, Optimize_InlineCountTail(node))
            ReturnValue(n)
        }
        IfCondition EqualTo(t, AST.TRY) ThenBlock: {
            n = Add(n, Optimize_InlineCountAny(node))
            ReturnValue(n)
        }
        ReturnValue(n)
    }
}

Function.Optimize_InlineForbid {
    Input: node: Address
    Input: self_name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        t = AST_GetType(node)
        bad = 0
        IfCondition EqualTo(t, AST.WHILE) ThenBlock: { bad = 1 }
        IfCondition EqualTo(t, AST.FOR_EVERY) ThenBlock: { bad = 1 }
        IfCondition EqualTo(t, AST.UNTIL) ThenBlock: { bad = 1 }
        IfCondition EqualTo(t, AST.TRY) ThenBlock: { bad = 1 }
        IfCondition EqualTo(t, AST.EVERY_INTERVAL) ThenBlock: { bad = 1 }
        IfCondition EqualTo(t, AST.EXIT_LOOP) ThenBlock: { bad = 1 }
        IfCondition EqualTo(t, AST.CONTINUE_LOOP) ThenBlock: { bad = 1 }
        // Asm text reads edi/esi. Renaming the parameters does not rewrite it,
        // so a spliced CRC32Step hashes the pointer instead of the bytes.
        IfCondition EqualTo(t, AST.INLINEASM) ThenBlock: { bad = 1 }
        IfCondition EqualTo(t, AST.CALL) ThenBlock: {
            cn = AST_GetData1(node)
            IfCondition NotEqual(cn, 0) ThenBlock: {
                IfCondition EqualTo(Optimize_NameEq(cn, self_name), 1) ThenBlock: { bad = 1 }
                IfCondition EqualTo(StringCompare(cn, "CallIndirect"), 0) ThenBlock: { bad = 1 }
                IfCondition EqualTo(StringCompare(cn, "AddressOf"), 0) ThenBlock: { bad = 1 }
            }
        }
        IfCondition EqualTo(bad, 1) ThenBlock: { ReturnValue(1) }
        count = AST_GetChildCount(node)
        i = 0
        WhileLoop LessThan(i, count) {
            IfCondition EqualTo(Optimize_InlineForbid(AST_GetChild(node, i), self_name), 1) ThenBlock: {
                ReturnValue(1)
            }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

Function.Optimize_InlineReturnCount {
    Input: node: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        n = 0
        IfCondition EqualTo(AST_GetType(node), AST.RETURN) ThenBlock: { n = 1 }
        count = AST_GetChildCount(node)
        i = 0
        WhileLoop LessThan(i, count) {
            n = Add(n, Optimize_InlineReturnCount(AST_GetChild(node, i)))
            i = Add(i, 1)
        }
        ReturnValue(n)
    }
}

Function.Optimize_InlineIsParam {
    Input: func_node: Address
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }
        count = AST_GetChildCount(func_node)
        i = 0
        WhileLoop LessThan(i, count) {
            ch = AST_GetChild(func_node, i)
            IfCondition EqualTo(AST_GetType(ch), AST.PARAMETER) ThenBlock: {
                IfCondition EqualTo(Optimize_NameEq(AST_GetData1(ch), name), 1) ThenBlock: {
                    ReturnValue(1)
                }
            }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

Function.Optimize_InlineParams {
    Input: func_node: Address
    Output: Address
    Body: {
        params = Array.Create(8)
        count = AST_GetChildCount(func_node)
        i = 0
        WhileLoop LessThan(i, count) {
            ch = AST_GetChild(func_node, i)
            IfCondition EqualTo(AST_GetType(ch), AST.PARAMETER) ThenBlock: {
                Array.Push(params, AST_GetData1(ch))
            }
            i = Add(i, 1)
        }
        ReturnValue(params)
    }
}

Function.Optimize_InlineBody {
    Input: func_node: Address
    Output: Address
    Body: {
        body = 0
        count = AST_GetChildCount(func_node)
        i = 0
        WhileLoop LessThan(i, count) {
            ch = AST_GetChild(func_node, i)
            IfCondition EqualTo(AST_GetType(ch), AST.BLOCK) ThenBlock: { body = ch }
            i = Add(i, 1)
        }
        ReturnValue(body)
    }
}

Function.Optimize_InlineArgsOk {
    Input: call: Address
    Input: params: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(params, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetChildCount(call), Array.Size(params)) ThenBlock: {
            ReturnValue(0)
        }
        i = 0
        n = Array.Size(params)
        WhileLoop LessThan(i, n) {
            arg = AST_GetChild(call, i)
            IfCondition EqualTo(arg, 0) ThenBlock: { ReturnValue(0) }
            t = AST_GetType(arg)
            ok = 0
            IfCondition EqualTo(t, AST.IDENTIFIER) ThenBlock: { ok = 1 }
            IfCondition EqualTo(t, AST.NUMBER) ThenBlock: { ok = 1 }
            IfCondition EqualTo(ok, 0) ThenBlock: { ReturnValue(0) }
            IfCondition EqualTo(Array.Get(params, i), 0) ThenBlock: { ReturnValue(0) }
            i = Add(i, 1)
        }
        ReturnValue(1)
    }
}

// Every bare name in an expression return is a parameter. A free name
// would bind to the caller's local after the splice.
Function.Optimize_InlineExprClosed {
    Input: node: Address
    Input: func_node: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        nt = AST_GetType(node)
        IfCondition EqualTo(nt, AST.NUMBER) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(nt, AST.IDENTIFIER) ThenBlock: {
            ReturnValue(Optimize_InlineIsParam(func_node, AST_GetData1(node)))
        }
        IfCondition NotEqual(nt, AST.CALL) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_PureName(AST_GetData1(node)), 0) ThenBlock: { ReturnValue(0) }
        count = AST_GetChildCount(node)
        i = 0
        ok = 1
        WhileLoop LessThan(i, count) {
            IfCondition EqualTo(Optimize_InlineExprClosed(AST_GetChild(node, i), func_node), 0) ThenBlock: {
                ok = 0
            }
            i = Add(i, 1)
        }
        ReturnValue(ok)
    }
}

// 1 when a bare identifier is a parameter, a pool field, or a local this
// body assigns. Anything else stays a call so it cannot capture a caller local.
Function.Optimize_InlineLocalsOk {
    Input: node: Address
    Input: func_node: Address
    Input: body: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(AST_GetType(node), AST.IDENTIFIER) ThenBlock: {
            nm = AST_GetData1(node)
            IfCondition EqualTo(nm, 0) ThenBlock: { ReturnValue(0) }
            IfCondition EqualTo(Compile_ContainsDot(nm), 1) ThenBlock: { ReturnValue(1) }
            IfCondition EqualTo(Optimize_InlineIsParam(func_node, nm), 1) ThenBlock: { ReturnValue(1) }
            IfCondition EqualTo(Optimize_AssignNested(body, nm), 1) ThenBlock: { ReturnValue(1) }
            ReturnValue(0)
        }
        count = AST_GetChildCount(node)
        i = 0
        ok = 1
        WhileLoop LessThan(i, count) {
            IfCondition EqualTo(Optimize_InlineLocalsOk(AST_GetChild(node, i), func_node, body), 0) ThenBlock: {
                ok = 0
            }
            i = Add(i, 1)
        }
        ReturnValue(ok)
    }
}

// One statement: ReturnValue of a pure expression whose names are parameters.
Function.Optimize_InlineExprOk {
    Input: func_node: Address
    Input: body: Address
    Output: Integer
    Body: {
        IfCondition NotEqual(AST_GetChildCount(body), 1) ThenBlock: { ReturnValue(0) }
        last = AST_GetChild(body, 0)
        IfCondition NotEqual(AST_GetType(last), AST.RETURN) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(Optimize_InlineReturnCount(body), 1) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(AST_GetChildCount(last), 1) ThenBlock: { ReturnValue(0) }
        rv = AST_GetChild(last, 0)
        IfCondition EqualTo(Optimize_PureExpr(rv), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_InlineExprClosed(rv, func_node), 0) ThenBlock: { ReturnValue(0) }
        params = Optimize_InlineParams(func_node)
        bad = 0
        i = 0
        n = Array.Size(params)
        WhileLoop LessThan(i, n) {
            IfCondition EqualTo(Optimize_AssignNested(body, Array.Get(params, i)), 1) ThenBlock: {
                bad = 1
            }
            i = Add(i, 1)
        }
        Array.Destroy(params)
        IfCondition EqualTo(bad, 1) ThenBlock: { ReturnValue(0) }
        ReturnValue(1)
    }
}

// Statements, no return. Loops, asm, and address-of are already rejected.
Function.Optimize_InlineVoidOk {
    Input: func_node: Address
    Input: body: Address
    Output: Integer
    Body: {
        IfCondition LessThan(AST_GetChildCount(body), 1) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(Optimize_InlineReturnCount(body), 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(Optimize_InlineLocalsOk(body, func_node, body))
    }
}

// 1: return of a local. 2: return of a pure expression. 3: no return.
// 0 stays a call. The cap and the forbid list are the same for all three.
Function.Optimize_InlineKind {
    Input: func_node: Address
    Input: body: Address
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(func_node, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(body, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(func_node), AST.FUNCTION) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(body), AST.BLOCK) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_InlineForbid(body, name), 1) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterThan(Optimize_InlineCount(body), Optimize_InlineCap()) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_InlineEligible(func_node, body, name), 1) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(Optimize_InlineExprOk(func_node, body), 1) ThenBlock: { ReturnValue(2) }
        IfCondition EqualTo(Optimize_InlineVoidOk(func_node, body), 1) ThenBlock: { ReturnValue(3) }
        ReturnValue(0)
    }
}

Function.Optimize_InlineEligible {
    Input: func_node: Address
    Input: body: Address
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(func_node, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(body, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(func_node), AST.FUNCTION) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(body), AST.BLOCK) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_InlineForbid(body, name), 1) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterThan(Optimize_InlineCount(body), Optimize_InlineCap()) ThenBlock: { ReturnValue(0) }
        bc = AST_GetChildCount(body)
        IfCondition LessThan(bc, 1) ThenBlock: { ReturnValue(0) }
        last = AST_GetChild(body, Subtract(bc, 1))
        IfCondition NotEqual(AST_GetType(last), AST.RETURN) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(Optimize_InlineReturnCount(body), 1) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(AST_GetChildCount(last), 1) ThenBlock: { ReturnValue(0) }
        rv = AST_GetChild(last, 0)
        IfCondition NotEqual(AST_GetType(rv), AST.IDENTIFIER) ThenBlock: { ReturnValue(0) }
        rname = AST_GetData1(rv)
        IfCondition EqualTo(rname, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Compile_ContainsDot(rname), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_InlineIsParam(func_node, rname), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_AssignNested(body, rname), 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(1)
    }
}

Function.Optimize_InlineCollideName {
    Input: name: Address
    Input: renames: Address
    Input: caller_names: Address
    Body: {
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }
        // Pool fields (OptState.inline_seq) are one dotted identifier and are
        // already in scope. Freshening them turns the read before the write
        // into a local that has not been stored yet.
        IfCondition EqualTo(Compile_ContainsDot(name), 1) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(Optimize_InlineMapped(renames, name), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(SHash.Exists(caller_names, name), 0) ThenBlock: { ReturnValue(0) }
        fresh = Optimize_InlineFresh(caller_names)
        SHash.InsertAddr(renames, name, fresh)
        ReturnValue(0)
    }
}

Function.Optimize_InlineCollide {
    Input: node: Address
    Input: renames: Address
    Input: caller_names: Address
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        t = AST_GetType(node)
        IfCondition EqualTo(t, AST.ASSIGNMENT) ThenBlock: {
            Optimize_InlineCollideName(AST_GetData1(node), renames, caller_names)
        }
        IfCondition EqualTo(t, AST.INDEX_ASSIGN) ThenBlock: {
            Optimize_InlineCollideName(AST_GetData1(node), renames, caller_names)
        }
        count = AST_GetChildCount(node)
        i = 0
        WhileLoop LessThan(i, count) {
            Optimize_InlineCollide(AST_GetChild(node, i), renames, caller_names)
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

Function.Optimize_InlineSplice {
    Input: block: Address
    Input: index: Integer
    Input: lhs: Address
    Input: call: Address
    Input: self_name: Address
    Input: caller_names: Address
    Output: Integer
    Body: {
        cname = AST_GetData1(call)
        IfCondition EqualTo(cname, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_NameEq(cname, self_name), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_InlineBuiltin(cname), 1) ThenBlock: { ReturnValue(0) }
        func_node = SHash.LookupAddr(OptState.func_nodes, cname)
        IfCondition EqualTo(func_node, Collections.XNULL) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(func_node, 0) ThenBlock: { ReturnValue(0) }

        src_body = SHash.LookupAddr(OptState.func_snaps, cname)
        IfCondition EqualTo(src_body, Collections.XNULL) ThenBlock: {
            src_body = Optimize_InlineBody(func_node)
        }
        IfCondition EqualTo(src_body, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(src_body, Collections.XNULL) ThenBlock: { ReturnValue(0) }
        kind = Optimize_InlineKind(func_node, src_body, cname)
        IfCondition EqualTo(kind, 0) ThenBlock: { ReturnValue(0) }
        // A value body needs an assignment to land in. A void body is the
        // call statement itself. The other way around stays a call.
        IfCondition EqualTo(kind, 3) ThenBlock: {
            IfCondition NotEqual(lhs, 0) ThenBlock: { ReturnValue(0) }
        }
        IfCondition NotEqual(kind, 3) ThenBlock: {
            IfCondition EqualTo(lhs, 0) ThenBlock: { ReturnValue(0) }
        }

        params = Optimize_InlineParams(func_node)
        IfCondition EqualTo(Optimize_InlineArgsOk(call, params), 0) ThenBlock: {
            ReturnValue(Optimize_InlineFail(params, 0, 0))
        }

        renames = SHash.Create(64)
        i = 0
        pc = Array.Size(params)
        WhileLoop LessThan(i, pc) {
            pname = Array.Get(params, i)
            arg = AST_GetChild(call, i)
            target = 0
            at = AST_GetType(arg)
            IfCondition EqualTo(at, AST.NUMBER) ThenBlock: {
                target = Optimize_InlineFresh(caller_names)
            }
            IfCondition EqualTo(at, AST.IDENTIFIER) ThenBlock: {
                written = Optimize_AssignNested(src_body, pname)
                IfCondition EqualTo(written, 1) ThenBlock: {
                    target = Optimize_InlineFresh(caller_names)
                }
                IfCondition EqualTo(written, 0) ThenBlock: {
                    target = AST_GetData1(arg)
                    // x = Scale(x) must copy the argument before the body
                    // writes the same name. A void call has no lhs.
                    IfCondition EqualTo(Optimize_NameEq(target, lhs), 1) ThenBlock: {
                        target = Optimize_InlineFresh(caller_names)
                    }
                }
            }
            IfCondition EqualTo(target, 0) ThenBlock: {
                ReturnValue(Optimize_InlineFail(params, renames, 0))
            }
            SHash.InsertAddr(renames, pname, target)
            i = Add(i, 1)
        }

        IfCondition EqualTo(kind, 1) ThenBlock: {
            last = AST_GetChild(src_body, Subtract(AST_GetChildCount(src_body), 1))
            rname = AST_GetData1(AST_GetChild(last, 0))
            IfCondition NotEqual(Optimize_InlineMapped(renames, rname), 0) ThenBlock: {
                ReturnValue(Optimize_InlineFail(params, renames, 0))
            }
            SHash.InsertAddr(renames, rname, lhs)
        }
        Optimize_InlineCollide(src_body, renames, caller_names)

        stmts = Array.Create(16)
        i = 0
        WhileLoop LessThan(i, pc) {
            pname = Array.Get(params, i)
            arg = AST_GetChild(call, i)
            mapped = Optimize_InlineMapped(renames, pname)
            need = 0
            IfCondition EqualTo(AST_GetType(arg), AST.NUMBER) ThenBlock: { need = 1 }
            IfCondition EqualTo(AST_GetType(arg), AST.IDENTIFIER) ThenBlock: {
                IfCondition EqualTo(Optimize_NameEq(mapped, AST_GetData1(arg)), 0) ThenBlock: {
                    need = 1
                }
            }
            IfCondition EqualTo(need, 1) ThenBlock: {
                expr = Optimize_InlineClone(arg, 0)
                IfCondition NotEqual(expr, 0) ThenBlock: {
                    asg = AST_MakeAssignment(mapped, expr)
                    AST_SetLine(asg, AST_GetLine(call))
                    AST_SetCol(asg, AST_GetCol(call))
                    Array.Push(stmts, asg)
                }
            }
            i = Add(i, 1)
        }

        bc = AST_GetChildCount(src_body)
        IfCondition EqualTo(kind, 1) ThenBlock: {
            j = 0
            last_i = Subtract(bc, 1)
            WhileLoop LessThan(j, last_i) {
                cloned = Optimize_InlineClone(AST_GetChild(src_body, j), renames)
                IfCondition NotEqual(cloned, 0) ThenBlock: {
                    Array.Push(stmts, cloned)
                }
                j = Add(j, 1)
            }
        }
        IfCondition EqualTo(kind, 2) ThenBlock: {
            ret = AST_GetChild(src_body, 0)
            cloned = Optimize_InlineClone(AST_GetChild(ret, 0), renames)
            IfCondition NotEqual(cloned, 0) ThenBlock: {
                asg = AST_MakeAssignment(lhs, cloned)
                AST_SetLine(asg, AST_GetLine(call))
                AST_SetCol(asg, AST_GetCol(call))
                Array.Push(stmts, asg)
            }
        }
        IfCondition EqualTo(kind, 3) ThenBlock: {
            j = 0
            WhileLoop LessThan(j, bc) {
                cloned = Optimize_InlineClone(AST_GetChild(src_body, j), renames)
                IfCondition NotEqual(cloned, 0) ThenBlock: {
                    Array.Push(stmts, cloned)
                }
                j = Add(j, 1)
            }
        }

        n = Array.Size(stmts)
        IfCondition LessThan(n, 1) ThenBlock: {
            ReturnValue(Optimize_InlineFail(params, renames, stmts))
        }
        children = AST_GetChildren(block)
        IfCondition EqualTo(children, 0) ThenBlock: {
            ReturnValue(Optimize_InlineFail(params, renames, stmts))
        }
        Array.Delete(children, index)
        k = 0
        WhileLoop LessThan(k, n) {
            Array.Insert(children, Add(index, k), Array.Get(stmts, k))
            k = Add(k, 1)
        }
        k = 0
        WhileLoop LessThan(k, n) {
            Optimize_InlineCollect(Array.Get(stmts, k), caller_names)
            k = Add(k, 1)
        }
        Array.Destroy(params)
        SHash.Destroy(renames)
        Array.Destroy(stmts)
        ReturnValue(n)
    }
}

Function.Optimize_InlineTry {
    Input: block: Address
    Input: index: Integer
    Input: stmt: Address
    Input: self_name: Address
    Input: caller_names: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(stmt, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(AST_GetType(stmt), AST.ASSIGNMENT) ThenBlock: {
            IfCondition NotEqual(AST_GetData2(stmt), 0) ThenBlock: { ReturnValue(0) }
            IfCondition LessThan(AST_GetChildCount(stmt), 1) ThenBlock: { ReturnValue(0) }
            value = AST_GetChild(stmt, 0)
            IfCondition NotEqual(AST_GetType(value), AST.CALL) ThenBlock: { ReturnValue(0) }
            lhs = AST_GetData1(stmt)
            ReturnValue(Optimize_InlineSplice(block, index, lhs, value, self_name, caller_names))
        }
        IfCondition EqualTo(AST_GetType(stmt), AST.CALL) ThenBlock: {
            ReturnValue(Optimize_InlineSplice(block, index, 0, stmt, self_name, caller_names))
        }
        ReturnValue(0)
    }
}

Function.Optimize_InlineWalkInside {
    Input: stmt: Address
    Input: self_name: Address
    Input: caller_names: Address
    Input: depth: Integer
    Body: {
        IfCondition EqualTo(stmt, 0) ThenBlock: { ReturnValue(0) }
        t = AST_GetType(stmt)
        IfCondition EqualTo(t, AST.BLOCK) ThenBlock: {
            Optimize_InlineWalkBlock(stmt, self_name, caller_names, depth)
            ReturnValue(0)
        }
        IfCondition EqualTo(t, AST.BODY) ThenBlock: {
            Optimize_InlineWalkBlock(stmt, self_name, caller_names, depth)
            ReturnValue(0)
        }
        nest = 0
        IfCondition EqualTo(t, AST.IF) ThenBlock: { nest = 1 }
        IfCondition EqualTo(t, AST.FORK) ThenBlock: { nest = 1 }
        IfCondition EqualTo(t, AST.WHILE) ThenBlock: { nest = 1 }
        IfCondition EqualTo(t, AST.UNTIL) ThenBlock: { nest = 1 }
        IfCondition EqualTo(t, AST.FOR_EVERY) ThenBlock: { nest = 1 }
        IfCondition EqualTo(t, AST.TRY) ThenBlock: { nest = 1 }
        IfCondition EqualTo(t, AST.SWITCH) ThenBlock: { nest = 1 }
        IfCondition EqualTo(t, AST.BRANCH) ThenBlock: { nest = 1 }
        IfCondition EqualTo(t, AST.CASE) ThenBlock: { nest = 1 }
        IfCondition EqualTo(t, AST.DEFAULT) ThenBlock: { nest = 1 }
        IfCondition EqualTo(t, AST.CATCH) ThenBlock: { nest = 1 }
        IfCondition EqualTo(t, AST.FINALLY) ThenBlock: { nest = 1 }
        IfCondition EqualTo(nest, 0) ThenBlock: { ReturnValue(0) }
        count = AST_GetChildCount(stmt)
        i = 0
        WhileLoop LessThan(i, count) {
            Optimize_InlineWalkInside(AST_GetChild(stmt, i), self_name, caller_names, depth)
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

Function.Optimize_InlineWalkSpan {
    Input: block: Address
    Input: begin_at: Integer
    Input: end_at: Integer
    Input: self_name: Address
    Input: caller_names: Address
    Input: depth: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(block, 0) ThenBlock: { ReturnValue(end_at) }
        i = begin_at
        limit = end_at
        WhileLoop LessThan(i, limit) {
            stmt = AST_GetChild(block, i)
            n = Optimize_InlineTry(block, i, stmt, self_name, caller_names)
            IfCondition GreaterThan(n, 0) ThenBlock: {
                grown = n
                // depth 0 may splice the calls it just inserted. depth 1
                // leaves those calls in place, so a third copy never appears.
                IfCondition LessThan(depth, 1) ThenBlock: {
                    span_end = Optimize_InlineWalkSpan(block, i, Add(i, n), self_name, caller_names, 1)
                    grown = Subtract(span_end, i)
                }
                limit = Add(limit, Subtract(grown, 1))
                i = Add(i, grown)
            }
            IfCondition EqualTo(n, 0) ThenBlock: {
                Optimize_InlineWalkInside(stmt, self_name, caller_names, depth)
                i = Add(i, 1)
            }
        }
        ReturnValue(limit)
    }
}

Function.Optimize_InlineWalkBlock {
    Input: block: Address
    Input: self_name: Address
    Input: caller_names: Address
    Input: depth: Integer
    Body: {
        IfCondition EqualTo(block, 0) ThenBlock: { ReturnValue(0) }
        Optimize_InlineWalkSpan(block, 0, AST_GetChildCount(block), self_name, caller_names, depth)
        ReturnValue(0)
    }
}

Function.Optimize_InlineIndex {
    Input: node: Address
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(AST_GetType(node), AST.FUNCTION) ThenBlock: {
            name = AST_GetData1(node)
            IfCondition NotEqual(name, 0) ThenBlock: {
                existing = SHash.LookupAddr(OptState.func_nodes, name)
                IfCondition EqualTo(existing, Collections.XNULL) ThenBlock: {
                    SHash.InsertAddr(OptState.func_nodes, name, node)
                }
            }
        }
        count = AST_GetChildCount(node)
        i = 0
        WhileLoop LessThan(i, count) {
            Optimize_InlineIndex(AST_GetChild(node, i))
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

Function.Optimize_InlineInit {
    Body: {
        IfCondition EqualTo(OptState.inline_ready, 1) ThenBlock: {
            IfCondition EqualTo(OptState.inline_ast, Compile.ast) ThenBlock: {
                ReturnValue(0)
            }
        }
        IfCondition NotEqual(OptState.func_nodes, 0) ThenBlock: {
            SHash.Destroy(OptState.func_nodes)
            OptState.func_nodes = 0
        }
        IfCondition NotEqual(OptState.func_snaps, 0) ThenBlock: {
            SHash.Destroy(OptState.func_snaps)
            OptState.func_snaps = 0
        }
        OptState.func_nodes = SHash.Create(4096)
        OptState.func_snaps = SHash.Create(1024)
        IfCondition NotEqual(OptState.clean_cache, 0) ThenBlock: {
            SHash.Destroy(OptState.clean_cache)
            OptState.clean_cache = 0
        }
        IfCondition NotEqual(OptState.clean_visit, 0) ThenBlock: {
            SHash.Destroy(OptState.clean_visit)
            OptState.clean_visit = 0
        }
        OptState.clean_cache = SHash.Create(4096)
        OptState.clean_visit = SHash.Create(1024)
        OptState.clean_depth = 0
        OptState.inline_seq = 0
        Optimize_InlineIndex(Compile.ast)
        Optimize_FoldInit()
        OptState.inline_ast = Compile.ast
        OptState.inline_ready = 1
        ReturnValue(0)
    }
}

Function.Optimize_InlinePrepare {
    Input: func_node: Address
    Input: body: Address
    Body: {
        IfCondition EqualTo(func_node, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(body, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(func_node), AST.FUNCTION) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Compile.ast, 0) ThenBlock: { ReturnValue(0) }
        name = AST_GetData1(func_node)
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }
        Optimize_InlineInit()
        IfCondition GreaterThan(Optimize_InlineKind(func_node, body, name), 0) ThenBlock: {
            snap = Optimize_InlineClone(body, 0)
            IfCondition NotEqual(snap, 0) ThenBlock: {
                SHash.InsertAddr(OptState.func_snaps, name, snap)
            }
        }
        names = SHash.Create(1024)
        Optimize_InlineCollect(func_node, names)
        Optimize_InlineWalkBlock(body, name, names, 0)
        SHash.Destroy(names)
        Optimize_FoldFunction(body)
        // The splice rewrites this body. Drop a pre-splice answer so the
        // next caller reads the statements that will actually be emitted.
        IfCondition NotEqual(OptState.clean_cache, 0) ThenBlock: {
            SHash.Delete(OptState.clean_cache, name)
        }
        IfCondition NotEqual(OptState.clean_visit, 0) ThenBlock: {
            SHash.Delete(OptState.clean_visit, name)
        }
        ReturnValue(0)
    }
}

// =============================================================================
// JOIN CONSTANT FOLD
// One value for a name: every straight-line write agrees, or every arm of a
// Branch or If leaves a constant. Pure arithmetic that reads those values is
// copied into the arms and folded. A second write, a loop write, or any
// non-pure call poisons the name. Integer math stays integer. Float_FromInt
// and the float ops use the compiler's own operators, so the bits match a
// runtime evaluation on this machine.
// =============================================================================

Function.Optimize_FoldFree {
    Input: arr: Address
    Body: {
        IfCondition NotEqual(arr, 0) ThenBlock: {
            Array.Destroy(arr)
        }
        ReturnValue(0)
    }
}

Function.Optimize_FoldFree6 {
    Input: a: Address
    Input: b: Address
    Input: c: Address
    Input: d: Address
    Input: e: Address
    Input: f: Address
    Body: {
        Optimize_FoldFree(a)
        Optimize_FoldFree(b)
        Optimize_FoldFree(c)
        Optimize_FoldFree(d)
        Optimize_FoldFree(e)
        Optimize_FoldFree(f)
        ReturnValue(0)
    }
}

Function.Optimize_FoldDot {
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }
        i = 0
        WhileLoop LessThan(i, 256) {
            c = GetByte(name, i)
            IfCondition EqualTo(c, 0) ThenBlock: { ReturnValue(0) }
            IfCondition EqualTo(c, 46) ThenBlock: { ReturnValue(1) }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

Function.Optimize_FoldOp {
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(StringCompare(name, "Add"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "Subtract"), 0) ThenBlock: { ReturnValue(2) }
        IfCondition EqualTo(StringCompare(name, "Multiply"), 0) ThenBlock: { ReturnValue(3) }
        IfCondition EqualTo(StringCompare(name, "Divide"), 0) ThenBlock: { ReturnValue(4) }
        IfCondition EqualTo(StringCompare(name, "Float_Add"), 0) ThenBlock: { ReturnValue(5) }
        IfCondition EqualTo(StringCompare(name, "Float_Sub"), 0) ThenBlock: { ReturnValue(6) }
        IfCondition EqualTo(StringCompare(name, "Float_Mul"), 0) ThenBlock: { ReturnValue(7) }
        IfCondition EqualTo(StringCompare(name, "Float_Div"), 0) ThenBlock: { ReturnValue(8) }
        IfCondition EqualTo(StringCompare(name, "Float_FromInt"), 0) ThenBlock: { ReturnValue(9) }
        ReturnValue(0)
    }
}

Function.Optimize_FoldIsFn {
    Input: t: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(t, AST.FUNCTION) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(t, AST.SUBROUTINE) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(t, AST.INLINE_FUNCTION) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

Function.Optimize_FoldIsLoop {
    Input: t: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(t, AST.WHILE) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(t, AST.UNTIL) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(t, AST.FOR_EVERY) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(t, AST.EVERY_INTERVAL) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(t, AST.LOOP_MAIN) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(t, AST.LOOP_ACTOR) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(t, AST.LOOP_START) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(t, AST.LOOP_SHADOW) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

Function.Optimize_FoldIsCtrl {
    Input: t: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(Optimize_FoldIsLoop(t), 1) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(t, AST.IF) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(t, AST.FORK) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(t, AST.SWITCH) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(t, AST.BRANCH) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(t, AST.TRY) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(t, AST.WITH_CONTEXT) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(t, AST.DEFER) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

Function.Optimize_FoldApply {
    Input: op: Integer
    Input: v0: Integer
    Input: v1: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(op, 1) ThenBlock: {
            FoldHold.val = Add(v0, v1)
            ReturnValue(1)
        }
        IfCondition EqualTo(op, 2) ThenBlock: {
            FoldHold.val = Subtract(v0, v1)
            ReturnValue(1)
        }
        IfCondition EqualTo(op, 3) ThenBlock: {
            FoldHold.val = Multiply(v0, v1)
            ReturnValue(1)
        }
        IfCondition EqualTo(op, 4) ThenBlock: {
            IfCondition EqualTo(v1, 0) ThenBlock: { ReturnValue(0) }
            FoldHold.val = Divide(v0, v1)
            ReturnValue(1)
        }
        IfCondition EqualTo(op, 5) ThenBlock: {
            FoldHold.val = Float_Add(v0, v1)
            ReturnValue(1)
        }
        IfCondition EqualTo(op, 6) ThenBlock: {
            FoldHold.val = Float_Sub(v0, v1)
            ReturnValue(1)
        }
        IfCondition EqualTo(op, 7) ThenBlock: {
            FoldHold.val = Float_Mul(v0, v1)
            ReturnValue(1)
        }
        IfCondition EqualTo(op, 8) ThenBlock: {
            FoldHold.val = Float_Div(v0, v1)
            ReturnValue(1)
        }
        IfCondition EqualTo(op, 9) ThenBlock: {
            FoldHold.val = Float_FromInt(v0)
            ReturnValue(1)
        }
        ReturnValue(0)
    }
}

Function.Optimize_FoldLookup {
    Input: names: Address
    Input: kinds: Address
    Input: vals: Address
    Input: name: Address
    Input: use_pool: Integer
    Body: {
        IfCondition EqualTo(name, 0) ThenBlock: {
            FoldHold.kind = 4
            FoldHold.val = 0
            ReturnValue(0)
        }
        IfCondition EqualTo(FoldHold.stop, 1) ThenBlock: {
            FoldHold.kind = 4
            FoldHold.val = 0
            ReturnValue(0)
        }
        hops = 0
        cur = name
        WhileLoop LessThan(hops, 4) {
            found = -1
            IfCondition NotEqual(names, 0) ThenBlock: {
                n = Array.Size(names)
                i = 0
                WhileLoop LessThan(i, n) {
                    IfCondition EqualTo(Optimize_NameEq(Array.Get(names, i), cur), 1) ThenBlock: {
                        found = i
                        ExitLoop
                    }
                    i = Add(i, 1)
                }
            }
            IfCondition GreaterEqual(found, 0) ThenBlock: {
                k = Array.Get(kinds, found)
                v = Array.Get(vals, found)
                FoldHold.kind = k
                FoldHold.val = v
                ReturnValue(0)
            }
            IfCondition LessThan(found, 0) ThenBlock: {
                ExitLoop
            }
        }
        IfCondition EqualTo(use_pool, 1) ThenBlock: {
            IfCondition NotEqual(OptState.pool_slot, 0) ThenBlock: {
                slot = SHash.Lookup(OptState.pool_slot, cur)
                IfCondition NotEqual(slot, Collections.XNULL) ThenBlock: {
                    FoldHold.kind = Array.Get(OptState.pool_kinds, slot)
                    FoldHold.val = Array.Get(OptState.pool_vals, slot)
                    ReturnValue(0)
                }
            }
        }
        FoldHold.kind = 4
        FoldHold.val = 0
        ReturnValue(0)
    }
}

Function.Optimize_FoldValue {
    Input: node: Address
    Input: names: Address
    Input: kinds: Address
    Input: vals: Address
    Input: use_pool: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: {
            FoldHold.kind = 0
            FoldHold.val = 0
            ReturnValue(0)
        }
        t = AST_GetType(node)
        IfCondition EqualTo(t, AST.NUMBER) ThenBlock: {
            FoldHold.val = StringToNumber(AST_GetData1(node))
            IfCondition EqualTo(AST_GetData2(node), 2) ThenBlock: {
                FoldHold.kind = 2
                ReturnValue(0)
            }
            FoldHold.kind = 1
            ReturnValue(0)
        }
        IfCondition EqualTo(t, AST.IDENTIFIER) ThenBlock: {
            Optimize_FoldLookup(names, kinds, vals, AST_GetData1(node), use_pool)
            hops = 0
            last = AST_GetData1(node)
            WhileLoop EqualTo(FoldHold.kind, 3) {
                IfCondition GreaterEqual(hops, 4) ThenBlock: { ExitLoop }
                last = FoldHold.val
                Optimize_FoldLookup(names, kinds, vals, last, use_pool)
                hops = Add(hops, 1)
            }
            IfCondition GreaterThan(hops, 0) ThenBlock: {
                IfCondition NotEqual(FoldHold.kind, 1) ThenBlock: {
                    IfCondition NotEqual(FoldHold.kind, 2) ThenBlock: {
                        FoldHold.kind = 3
                        FoldHold.val = last
                    }
                }
            }
            ReturnValue(0)
        }
        IfCondition NotEqual(t, AST.CALL) ThenBlock: {
            FoldHold.kind = 0
            FoldHold.val = 0
            ReturnValue(0)
        }
        op = Optimize_FoldOp(AST_GetData1(node))
        IfCondition EqualTo(op, 0) ThenBlock: {
            FoldHold.kind = 0
            FoldHold.val = 0
            ReturnValue(0)
        }
        count = AST_GetChildCount(node)
        IfCondition EqualTo(op, 9) ThenBlock: {
            IfCondition NotEqual(count, 1) ThenBlock: {
                FoldHold.kind = 0
                FoldHold.val = 0
                ReturnValue(0)
            }
            Optimize_FoldValue(AST_GetChild(node, 0), names, kinds, vals, use_pool)
            ck = FoldHold.kind
            cv = FoldHold.val
            IfCondition EqualTo(ck, 1) ThenBlock: {
                IfCondition EqualTo(Optimize_FoldApply(9, cv, 0), 1) ThenBlock: {
                    FoldHold.kind = 2
                    ReturnValue(0)
                }
            }
            IfCondition EqualTo(ck, 2) ThenBlock: {
                IfCondition EqualTo(Optimize_FoldApply(9, cv, 0), 1) ThenBlock: {
                    FoldHold.kind = 2
                    ReturnValue(0)
                }
            }
            IfCondition EqualTo(ck, 4) ThenBlock: {
                FoldHold.kind = 4
                FoldHold.val = 0
                ReturnValue(0)
            }
            FoldHold.kind = 0
            FoldHold.val = 0
            ReturnValue(0)
        }
        IfCondition NotEqual(count, 2) ThenBlock: {
            FoldHold.kind = 0
            FoldHold.val = 0
            ReturnValue(0)
        }
        Optimize_FoldValue(AST_GetChild(node, 0), names, kinds, vals, use_pool)
        k0 = FoldHold.kind
        v0 = FoldHold.val
        Optimize_FoldValue(AST_GetChild(node, 1), names, kinds, vals, use_pool)
        k1 = FoldHold.kind
        v1 = FoldHold.val
        num0 = 0
        num1 = 0
        IfCondition EqualTo(k0, 1) ThenBlock: { num0 = 1 }
        IfCondition EqualTo(k0, 2) ThenBlock: { num0 = 1 }
        IfCondition EqualTo(k1, 1) ThenBlock: { num1 = 1 }
        IfCondition EqualTo(k1, 2) ThenBlock: { num1 = 1 }
        IfCondition EqualTo(num0, 1) ThenBlock: {
            IfCondition EqualTo(num1, 1) ThenBlock: {
                IfCondition EqualTo(Optimize_FoldApply(op, v0, v1), 0) ThenBlock: {
                    FoldHold.kind = 0
                    FoldHold.val = 0
                    ReturnValue(0)
                }
                IfCondition LessEqual(op, 4) ThenBlock: {
                    FoldHold.kind = 1
                    ReturnValue(0)
                }
                FoldHold.kind = 2
                ReturnValue(0)
            }
        }
        IfCondition EqualTo(k0, 0) ThenBlock: {
            FoldHold.kind = 0
            FoldHold.val = 0
            ReturnValue(0)
        }
        IfCondition EqualTo(k1, 0) ThenBlock: {
            FoldHold.kind = 0
            FoldHold.val = 0
            ReturnValue(0)
        }
        FoldHold.kind = 4
        FoldHold.val = 0
        ReturnValue(0)
    }
}

Function.Optimize_FoldPut {
    Input: names: Address
    Input: kinds: Address
    Input: vals: Address
    Input: name: Address
    Input: kind: Integer
    Input: val: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(names, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(FoldHold.stop, 1) ThenBlock: { ReturnValue(0) }
        found = -1
        n = Array.Size(names)
        i = 0
        WhileLoop LessThan(i, n) {
            IfCondition EqualTo(Optimize_NameEq(Array.Get(names, i), name), 1) ThenBlock: {
                found = i
                ExitLoop
            }
            i = Add(i, 1)
        }
        IfCondition EqualTo(kind, 3) ThenBlock: {
            IfCondition GreaterEqual(found, 0) ThenBlock: {
                IfCondition EqualTo(Array.Get(kinds, found), 0) ThenBlock: { ReturnValue(0) }
                Array.Set(kinds, found, 3)
                Array.Set(vals, found, val)
                ReturnValue(1)
            }
            IfCondition GreaterEqual(n, 512) ThenBlock: {
                FoldHold.stop = 1
                ReturnValue(0)
            }
            Array.Push(names, name)
            Array.Push(kinds, 3)
            Array.Push(vals, val)
            ReturnValue(1)
        }
        IfCondition GreaterEqual(found, 0) ThenBlock: {
            oldk = Array.Get(kinds, found)
            oldv = Array.Get(vals, found)
            IfCondition EqualTo(oldk, 0) ThenBlock: { ReturnValue(0) }
            IfCondition EqualTo(kind, 0) ThenBlock: {
                Array.Set(kinds, found, 0)
                ReturnValue(0)
            }
            IfCondition EqualTo(kind, 4) ThenBlock: {
                Array.Set(kinds, found, 0)
                ReturnValue(0)
            }
            IfCondition EqualTo(oldk, kind) ThenBlock: {
                IfCondition EqualTo(oldv, val) ThenBlock: { ReturnValue(1) }
            }
            Array.Set(kinds, found, 0)
            ReturnValue(0)
        }
        IfCondition GreaterEqual(n, 512) ThenBlock: {
            FoldHold.stop = 1
            ReturnValue(0)
        }
        Array.Push(names, name)
        Array.Push(kinds, kind)
        Array.Push(vals, val)
        ReturnValue(1)
    }
}

Function.Optimize_FoldForce {
    Input: names: Address
    Input: kinds: Address
    Input: vals: Address
    Input: name: Address
    Input: kind: Integer
    Input: val: Integer
    Body: {
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(names, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(FoldHold.stop, 1) ThenBlock: { ReturnValue(0) }
        found = -1
        n = Array.Size(names)
        i = 0
        WhileLoop LessThan(i, n) {
            IfCondition EqualTo(Optimize_NameEq(Array.Get(names, i), name), 1) ThenBlock: {
                found = i
                ExitLoop
            }
            i = Add(i, 1)
        }
        IfCondition GreaterEqual(found, 0) ThenBlock: {
            Array.Set(kinds, found, kind)
            Array.Set(vals, found, val)
            ReturnValue(0)
        }
        IfCondition GreaterEqual(n, 512) ThenBlock: {
            FoldHold.stop = 1
            ReturnValue(0)
        }
        Array.Push(names, name)
        Array.Push(kinds, kind)
        Array.Push(vals, val)
        ReturnValue(0)
    }
}

Function.Optimize_FoldPoolSee {
    Input: name: Address
    Input: kind: Integer
    Input: val: Integer
    Body: {
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(OptState.pool_slot, 0) ThenBlock: { ReturnValue(0) }
        slot = SHash.Lookup(OptState.pool_slot, name)
        gen = FoldHold.gen
        IfCondition EqualTo(FoldHold.stop, 1) ThenBlock: {
            IfCondition NotEqual(slot, Collections.XNULL) ThenBlock: {
                Array.Set(OptState.pool_kinds, slot, 0)
                Array.Set(OptState.pool_gen, slot, gen)
            }
            ReturnValue(0)
        }
        IfCondition EqualTo(slot, Collections.XNULL) ThenBlock: {
            slot = Array.Size(OptState.pool_names)
            IfCondition GreaterEqual(slot, 8192) ThenBlock: {
                FoldHold.stop = 1
                ReturnValue(0)
            }
            SHash.Insert(OptState.pool_slot, name, slot)
            Array.Push(OptState.pool_names, name)
            Array.Push(OptState.pool_kinds, kind)
            Array.Push(OptState.pool_vals, val)
            Array.Push(OptState.pool_gen, gen)
            IfCondition EqualTo(kind, 1) ThenBlock: {
                FoldHold.added = Add(FoldHold.added, 1)
            }
            IfCondition EqualTo(kind, 2) ThenBlock: {
                FoldHold.added = Add(FoldHold.added, 1)
            }
            ReturnValue(0)
        }
        oldk = Array.Get(OptState.pool_kinds, slot)
        oldv = Array.Get(OptState.pool_vals, slot)
        oldg = Array.Get(OptState.pool_gen, slot)
        IfCondition EqualTo(oldk, 0) ThenBlock: {
            Array.Set(OptState.pool_gen, slot, gen)
            ReturnValue(0)
        }
        IfCondition EqualTo(oldg, gen) ThenBlock: {
            same = 0
            IfCondition EqualTo(kind, oldk) ThenBlock: {
                IfCondition EqualTo(val, oldv) ThenBlock: {
                    IfCondition EqualTo(kind, 1) ThenBlock: { same = 1 }
                    IfCondition EqualTo(kind, 2) ThenBlock: { same = 1 }
                }
            }
            IfCondition EqualTo(same, 0) ThenBlock: {
                Array.Set(OptState.pool_kinds, slot, 0)
                Array.Set(OptState.pool_gen, slot, gen)
            }
            ReturnValue(0)
        }
        IfCondition EqualTo(kind, 0) ThenBlock: {
            Array.Set(OptState.pool_kinds, slot, 0)
            Array.Set(OptState.pool_gen, slot, gen)
            ReturnValue(0)
        }
        IfCondition EqualTo(kind, 4) ThenBlock: {
            Array.Set(OptState.pool_gen, slot, gen)
            ReturnValue(0)
        }
        IfCondition EqualTo(oldk, 4) ThenBlock: {
            Array.Set(OptState.pool_kinds, slot, kind)
            Array.Set(OptState.pool_vals, slot, val)
            Array.Set(OptState.pool_gen, slot, gen)
            FoldHold.added = Add(FoldHold.added, 1)
            ReturnValue(0)
        }
        IfCondition EqualTo(kind, oldk) ThenBlock: {
            IfCondition EqualTo(val, oldv) ThenBlock: {
                Array.Set(OptState.pool_gen, slot, gen)
                ReturnValue(0)
            }
        }
        Array.Set(OptState.pool_kinds, slot, 0)
        Array.Set(OptState.pool_gen, slot, gen)
        ReturnValue(0)
    }
}

Function.Optimize_FoldScanAssign {
    Input: node: Address
    Input: guarded: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetData2(node), 0) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(AST_GetChildCount(node), 1) ThenBlock: { ReturnValue(0) }
        name = AST_GetData1(node)
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }
        dotted = Optimize_FoldDot(name)
        IfCondition EqualTo(guarded, 1) ThenBlock: {
            IfCondition EqualTo(dotted, 1) ThenBlock: {
                Optimize_FoldPoolSee(name, 0, 0)
            }
            IfCondition EqualTo(dotted, 0) ThenBlock: {
                Optimize_FoldPut(OptState.scan_names, OptState.scan_kinds, OptState.scan_vals, name, 0, 0)
            }
            ReturnValue(0)
        }
        Optimize_FoldValue(AST_GetChild(node, 0), OptState.scan_names, OptState.scan_kinds, OptState.scan_vals, 1)
        IfCondition EqualTo(dotted, 1) ThenBlock: {
            Optimize_FoldPoolSee(name, FoldHold.kind, FoldHold.val)
        }
        IfCondition EqualTo(dotted, 0) ThenBlock: {
            Optimize_FoldPut(OptState.scan_names, OptState.scan_kinds, OptState.scan_vals, name, FoldHold.kind, FoldHold.val)
        }
        ReturnValue(0)
    }
}

Function.Optimize_FoldScan {
    Input: node: Address
    Input: guarded: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        t = AST_GetType(node)
        IfCondition EqualTo(Optimize_FoldIsFn(t), 1) ThenBlock: {
            FoldHold.stop = 0
            Array.Clear(OptState.scan_names)
            Array.Clear(OptState.scan_kinds)
            Array.Clear(OptState.scan_vals)
            count = AST_GetChildCount(node)
            i = 0
            WhileLoop LessThan(i, count) {
                Optimize_FoldScan(AST_GetChild(node, i), 0)
                i = Add(i, 1)
            }
            FoldHold.stop = 0
            Array.Clear(OptState.scan_names)
            Array.Clear(OptState.scan_kinds)
            Array.Clear(OptState.scan_vals)
            ReturnValue(0)
        }
        IfCondition EqualTo(Optimize_FoldIsCtrl(t), 1) ThenBlock: {
            count = AST_GetChildCount(node)
            i = 0
            WhileLoop LessThan(i, count) {
                Optimize_FoldScan(AST_GetChild(node, i), 1)
                i = Add(i, 1)
            }
            ReturnValue(0)
        }
        IfCondition EqualTo(t, AST.ASSIGNMENT) ThenBlock: {
            Optimize_FoldScanAssign(node, guarded)
        }
        count = AST_GetChildCount(node)
        i = 0
        WhileLoop LessThan(i, count) {
            Optimize_FoldScan(AST_GetChild(node, i), guarded)
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

Function.Optimize_FoldInit {
    Body: {
        IfCondition EqualTo(Compile.ast, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(OptState.pool_slot, 0) ThenBlock: {
            IfCondition EqualTo(OptState.fold_ast, Compile.ast) ThenBlock: {
                ReturnValue(0)
            }
            SHash.Destroy(OptState.pool_slot)
            Optimize_FoldFree(OptState.pool_names)
            Optimize_FoldFree(OptState.pool_kinds)
            Optimize_FoldFree(OptState.pool_vals)
            Optimize_FoldFree(OptState.pool_gen)
            Optimize_FoldFree(OptState.scan_names)
            Optimize_FoldFree(OptState.scan_kinds)
            Optimize_FoldFree(OptState.scan_vals)
            OptState.pool_slot = 0
        }
        OptState.pool_slot = SHash.Create(4096)
        OptState.pool_names = Array.Create(64)
        OptState.pool_kinds = Array.Create(64)
        OptState.pool_vals = Array.Create(64)
        OptState.pool_gen = Array.Create(64)
        OptState.scan_names = Array.Create(64)
        OptState.scan_kinds = Array.Create(64)
        OptState.scan_vals = Array.Create(64)
        FoldHold.one = Float_FromInt(1)
        FoldHold.gen = 0
        FoldHold.stop = 0
        pass = 0
        WhileLoop LessThan(pass, 8) {
            FoldHold.added = 0
            FoldHold.gen = Add(FoldHold.gen, 1)
            FoldHold.stop = 0
            Array.Clear(OptState.scan_names)
            Array.Clear(OptState.scan_kinds)
            Array.Clear(OptState.scan_vals)
            Optimize_FoldScan(Compile.ast, 0)
            IfCondition EqualTo(FoldHold.added, 0) ThenBlock: {
                IfCondition GreaterThan(pass, 0) ThenBlock: {
                    ExitLoop
                }
            }
            pass = Add(pass, 1)
        }
        FoldHold.stop = 0
        OptState.fold_ast = Compile.ast
        ReturnValue(0)
    }
}

Function.Optimize_FoldNum {
    Input: val: Integer
    Input: kind: Integer
    Output: Address
    Body: {
        node = AST_MakeNumber(NumberToString(val))
        AST_SetData2(node, kind)
        ReturnValue(node)
    }
}

Function.Optimize_FoldPure {
    Input: node: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        t = AST_GetType(node)
        IfCondition EqualTo(t, AST.NUMBER) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(t, AST.IDENTIFIER) ThenBlock: { ReturnValue(1) }
        IfCondition NotEqual(t, AST.CALL) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_FoldOp(AST_GetData1(node)), 0) ThenBlock: { ReturnValue(0) }
        count = AST_GetChildCount(node)
        i = 0
        WhileLoop LessThan(i, count) {
            IfCondition EqualTo(Optimize_FoldPure(AST_GetChild(node, i)), 0) ThenBlock: {
                ReturnValue(0)
            }
            i = Add(i, 1)
        }
        ReturnValue(1)
    }
}

Function.Optimize_FoldHit {
    Input: node: Address
    Input: names: Address
    Input: start: Integer
    Input: count: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        IfCondition LessEqual(count, 0) ThenBlock: { ReturnValue(0) }
        t = AST_GetType(node)
        check = 0
        IfCondition EqualTo(t, AST.IDENTIFIER) ThenBlock: { check = 1 }
        IfCondition EqualTo(t, AST.ASSIGNMENT) ThenBlock: { check = 1 }
        IfCondition EqualTo(t, AST.INDEX_ASSIGN) ThenBlock: { check = 1 }
        IfCondition EqualTo(check, 1) ThenBlock: {
            nm = AST_GetData1(node)
            i = 0
            WhileLoop LessThan(i, count) {
                IfCondition EqualTo(Optimize_NameEq(nm, Array.Get(names, Add(start, i))), 1) ThenBlock: {
                    ReturnValue(1)
                }
                i = Add(i, 1)
            }
        }
        n = AST_GetChildCount(node)
        i = 0
        WhileLoop LessThan(i, n) {
            IfCondition EqualTo(Optimize_FoldHit(AST_GetChild(node, i), names, start, count), 1) ThenBlock: {
                ReturnValue(1)
            }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

Function.Optimize_FoldSimple {
    Input: node: Address
    Output: Address
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(node), AST.ASSIGNMENT) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetData2(node), 0) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(AST_GetChildCount(node), 1) ThenBlock: { ReturnValue(0) }
        name = AST_GetData1(node)
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_FoldDot(name), 1) ThenBlock: { ReturnValue(0) }
        ReturnValue(name)
    }
}

Function.Optimize_FoldDup {
    Input: dn: Address
    Input: dk: Address
    Input: dv: Address
    Input: sn: Address
    Input: sk: Address
    Input: sv: Address
    Body: {
        IfCondition EqualTo(sn, 0) ThenBlock: { ReturnValue(0) }
        n = Array.Size(sn)
        i = 0
        WhileLoop LessThan(i, n) {
            Array.Push(dn, Array.Get(sn, i))
            Array.Push(dk, Array.Get(sk, i))
            Array.Push(dv, Array.Get(sv, i))
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

Function.Optimize_FoldPoison {
    Input: node: Address
    Input: names: Address
    Input: kinds: Address
    Input: vals: Address
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        t = AST_GetType(node)
        IfCondition EqualTo(Optimize_FoldIsFn(t), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(t, AST.ASSIGNMENT) ThenBlock: {
            IfCondition EqualTo(AST_GetData2(node), 0) ThenBlock: {
                Optimize_FoldPut(names, kinds, vals, AST_GetData1(node), 0, 0)
            }
        }
        IfCondition EqualTo(t, AST.INDEX_ASSIGN) ThenBlock: {
            Optimize_FoldPut(names, kinds, vals, AST_GetData1(node), 0, 0)
        }
        count = AST_GetChildCount(node)
        i = 0
        WhileLoop LessThan(i, count) {
            Optimize_FoldPoison(AST_GetChild(node, i), names, kinds, vals)
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

Function.Optimize_FoldSubst {
    Input: node: Address
    Input: names: Address
    Input: kinds: Address
    Input: vals: Address
    Output: Address
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        t = AST_GetType(node)
        IfCondition EqualTo(t, AST.IDENTIFIER) ThenBlock: {
            Optimize_FoldValue(node, names, kinds, vals, 0)
            ck = FoldHold.kind
            cv = FoldHold.val
            IfCondition EqualTo(ck, 1) ThenBlock: {
                ReturnValue(Optimize_FoldNum(cv, 1))
            }
            IfCondition EqualTo(ck, 2) ThenBlock: {
                ReturnValue(Optimize_FoldNum(cv, 2))
            }
            IfCondition EqualTo(ck, 3) ThenBlock: {
                AST_SetData1(node, cv)
                Optimize_FoldValue(node, names, kinds, vals, 0)
                IfCondition EqualTo(FoldHold.kind, 1) ThenBlock: {
                    ReturnValue(Optimize_FoldNum(FoldHold.val, 1))
                }
                IfCondition EqualTo(FoldHold.kind, 2) ThenBlock: {
                    ReturnValue(Optimize_FoldNum(FoldHold.val, 2))
                }
            }
            ReturnValue(node)
        }
        count = AST_GetChildCount(node)
        i = 0
        WhileLoop LessThan(i, count) {
            ch = AST_GetChild(node, i)
            nh = Optimize_FoldSubst(ch, names, kinds, vals)
            IfCondition NotEqual(nh, ch) ThenBlock: {
                AST_SetChild(node, i, nh)
            }
            i = Add(i, 1)
        }
        IfCondition NotEqual(t, AST.CALL) ThenBlock: { ReturnValue(node) }
        op = Optimize_FoldOp(AST_GetData1(node))
        IfCondition EqualTo(op, 0) ThenBlock: { ReturnValue(node) }
        Optimize_FoldValue(node, names, kinds, vals, 0)
        IfCondition EqualTo(FoldHold.kind, 1) ThenBlock: {
            ReturnValue(Optimize_FoldNum(FoldHold.val, 1))
        }
        IfCondition EqualTo(FoldHold.kind, 2) ThenBlock: {
            ReturnValue(Optimize_FoldNum(FoldHold.val, 2))
        }
        IfCondition EqualTo(op, 7) ThenBlock: {
            IfCondition EqualTo(count, 2) ThenBlock: {
                left = AST_GetChild(node, 0)
                right = AST_GetChild(node, 1)
                IfCondition EqualTo(AST_GetType(left), AST.NUMBER) ThenBlock: {
                    IfCondition EqualTo(StringToNumber(AST_GetData1(left)), FoldHold.one) ThenBlock: {
                        ReturnValue(right)
                    }
                }
                IfCondition EqualTo(AST_GetType(right), AST.NUMBER) ThenBlock: {
                    IfCondition EqualTo(StringToNumber(AST_GetData1(right)), FoldHold.one) ThenBlock: {
                        ReturnValue(left)
                    }
                }
            }
        }
        IfCondition EqualTo(op, 8) ThenBlock: {
            IfCondition EqualTo(count, 2) ThenBlock: {
                right = AST_GetChild(node, 1)
                IfCondition EqualTo(AST_GetType(right), AST.NUMBER) ThenBlock: {
                    IfCondition EqualTo(StringToNumber(AST_GetData1(right)), FoldHold.one) ThenBlock: {
                        ReturnValue(AST_GetChild(node, 0))
                    }
                }
            }
        }
        ReturnValue(node)
    }
}

Function.Optimize_FoldCollect {
    Input: block: Address
    Input: dest: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(block, 0) ThenBlock: { ReturnValue(0) }
        count = AST_GetChildCount(block)
        i = 0
        WhileLoop LessThan(i, count) {
            st = AST_GetChild(block, i)
            t = AST_GetType(st)
            IfCondition EqualTo(t, AST.BLOCK) ThenBlock: {
                IfCondition EqualTo(Optimize_FoldCollect(st, dest), 1) ThenBlock: { ReturnValue(1) }
            }
            IfCondition EqualTo(t, AST.BODY) ThenBlock: {
                IfCondition EqualTo(Optimize_FoldCollect(st, dest), 1) ThenBlock: { ReturnValue(1) }
            }
            IfCondition NotEqual(t, AST.BLOCK) ThenBlock: {
                IfCondition NotEqual(t, AST.BODY) ThenBlock: {
                    nm = Optimize_FoldSimple(st)
                    IfCondition NotEqual(nm, 0) ThenBlock: {
                        have = 0
                        j = 0
                        n = Array.Size(dest)
                        WhileLoop LessThan(j, n) {
                            IfCondition EqualTo(Optimize_NameEq(Array.Get(dest, j), nm), 1) ThenBlock: {
                                have = 1
                                ExitLoop
                            }
                            j = Add(j, 1)
                        }
                        IfCondition EqualTo(have, 0) ThenBlock: {
                            IfCondition GreaterEqual(n, 16) ThenBlock: { ReturnValue(1) }
                            Array.Push(dest, nm)
                        }
                    }
                }
            }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

Function.Optimize_FoldArm {
    Input: block: Address
    Input: names: Address
    Input: kinds: Address
    Input: vals: Address
    Body: {
        IfCondition EqualTo(block, 0) ThenBlock: { ReturnValue(0) }
        count = AST_GetChildCount(block)
        i = 0
        WhileLoop LessThan(i, count) {
            st = AST_GetChild(block, i)
            t = AST_GetType(st)
            IfCondition EqualTo(t, AST.BLOCK) ThenBlock: {
                Optimize_FoldArm(st, names, kinds, vals)
            }
            IfCondition EqualTo(t, AST.BODY) ThenBlock: {
                Optimize_FoldArm(st, names, kinds, vals)
            }
            IfCondition NotEqual(t, AST.BLOCK) ThenBlock: {
                IfCondition NotEqual(t, AST.BODY) ThenBlock: {
                    nm = Optimize_FoldSimple(st)
                    IfCondition NotEqual(nm, 0) ThenBlock: {
                        Optimize_FoldValue(AST_GetChild(st, 0), names, kinds, vals, 0)
                        IfCondition EqualTo(FoldHold.kind, 1) ThenBlock: {
                            Optimize_FoldForce(names, kinds, vals, nm, 1, FoldHold.val)
                        }
                        IfCondition EqualTo(FoldHold.kind, 2) ThenBlock: {
                            Optimize_FoldForce(names, kinds, vals, nm, 2, FoldHold.val)
                        }
                        IfCondition NotEqual(FoldHold.kind, 1) ThenBlock: {
                            IfCondition NotEqual(FoldHold.kind, 2) ThenBlock: {
                                Optimize_FoldForce(names, kinds, vals, nm, 0, 0)
                            }
                        }
                    }
                    IfCondition EqualTo(nm, 0) ThenBlock: {
                        Optimize_FoldPoison(st, names, kinds, vals)
                    }
                }
            }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

Function.Optimize_FoldIsBlock {
    Input: node: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        t = AST_GetType(node)
        IfCondition EqualTo(t, AST.BLOCK) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(t, AST.BODY) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

Function.Optimize_FoldGather {
    Input: stmt: Address
    Input: arms: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(stmt, 0) ThenBlock: { ReturnValue(0) }
        t = AST_GetType(stmt)
        count = AST_GetChildCount(stmt)
        IfCondition EqualTo(t, AST.IF) ThenBlock: {
            IfCondition LessThan(count, 3) ThenBlock: { ReturnValue(0) }
            b0 = AST_GetChild(stmt, 1)
            b1 = AST_GetChild(stmt, 2)
            IfCondition EqualTo(Optimize_FoldIsBlock(b0), 0) ThenBlock: { ReturnValue(0) }
            IfCondition EqualTo(Optimize_FoldIsBlock(b1), 0) ThenBlock: { ReturnValue(0) }
            Array.Push(arms, b0)
            Array.Push(arms, b1)
            ReturnValue(1)
        }
        IfCondition EqualTo(t, AST.FORK) ThenBlock: {
            IfCondition LessThan(count, 3) ThenBlock: { ReturnValue(0) }
            b0 = AST_GetChild(stmt, 1)
            b1 = AST_GetChild(stmt, 2)
            IfCondition EqualTo(Optimize_FoldIsBlock(b0), 0) ThenBlock: { ReturnValue(0) }
            IfCondition EqualTo(Optimize_FoldIsBlock(b1), 0) ThenBlock: { ReturnValue(0) }
            Array.Push(arms, b0)
            Array.Push(arms, b1)
            ReturnValue(1)
        }
        branch = 0
        IfCondition EqualTo(t, AST.SWITCH) ThenBlock: { branch = 1 }
        IfCondition EqualTo(t, AST.BRANCH) ThenBlock: { branch = 1 }
        IfCondition EqualTo(branch, 0) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(count, 2) ThenBlock: { ReturnValue(0) }
        has_def = 0
        i = 1
        WhileLoop LessThan(i, count) {
            ch = AST_GetChild(stmt, i)
            ct = AST_GetType(ch)
            IfCondition EqualTo(ct, AST.CASE) ThenBlock: {
                IfCondition LessThan(AST_GetChildCount(ch), 2) ThenBlock: { ReturnValue(0) }
                body = AST_GetChild(ch, 1)
                IfCondition EqualTo(Optimize_FoldIsBlock(body), 0) ThenBlock: { ReturnValue(0) }
                Array.Push(arms, body)
            }
            IfCondition EqualTo(ct, AST.DEFAULT) ThenBlock: {
                has_def = Add(has_def, 1)
                IfCondition LessThan(AST_GetChildCount(ch), 1) ThenBlock: { ReturnValue(0) }
                body = AST_GetChild(ch, 0)
                IfCondition EqualTo(Optimize_FoldIsBlock(body), 0) ThenBlock: { ReturnValue(0) }
                Array.Push(arms, body)
            }
            IfCondition NotEqual(ct, AST.CASE) ThenBlock: {
                IfCondition NotEqual(ct, AST.DEFAULT) ThenBlock: { ReturnValue(0) }
            }
            IfCondition GreaterThan(Array.Size(arms), 16) ThenBlock: { ReturnValue(0) }
            i = Add(i, 1)
        }
        IfCondition NotEqual(has_def, 1) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(Array.Size(arms), 1) ThenBlock: { ReturnValue(0) }
        ReturnValue(1)
    }
}

// A NUMBER operand of Float_Add/Sub/Mul is the same bits the runtime uses.
// Non-leaf functions park up to 8 distinct patterns in the frame once, at
// entry. Class 8 is that slot. Leaves keep the red zone and miss the opt.

Function.Optimize_FltConstEnsure {
    Body: {
        IfCondition EqualTo(OptState.flt_bits, 0) ThenBlock: {
            OptState.flt_bits = Allocate(64)
            OptState.flt_disp = Allocate(64)
        }
        IfCondition EqualTo(OptState.flt_save, 0) ThenBlock: {
            OptState.flt_save = Allocate(640)
        }
        ReturnValue(0)
    }
}

Function.Optimize_FltConstPush {
    Body: {
        Optimize_FltConstEnsure()
        d = OptState.flt_depth
        IfCondition GreaterEqual(d, 4) ThenBlock: {
            OptState.flt_depth = Add(d, 1)
            OptState.flt_skip = Add(OptState.flt_skip, 1)
            ReturnValue(0)
        }
        base = Add(OptState.flt_save, Multiply(d, 160))
        StoreValue(base, OptState.flt_n)
        StoreValue(Add(base, 8), OptState.flt_ready)
        i = 0
        WhileLoop LessThan(i, 8) {
            StoreValue(Add(base, Add(16, Multiply(i, 8))), Dereference(Add(OptState.flt_bits, Multiply(i, 8))))
            StoreValue(Add(base, Add(80, Multiply(i, 8))), Dereference(Add(OptState.flt_disp, Multiply(i, 8))))
            i = Add(i, 1)
        }
        OptState.flt_depth = Add(d, 1)
        OptState.flt_n = 0
        OptState.flt_ready = 0
        ReturnValue(0)
    }
}

Function.Optimize_FltConstPop {
    Body: {
        d = OptState.flt_depth
        IfCondition LessEqual(d, 0) ThenBlock: { ReturnValue(0) }
        OptState.flt_depth = Subtract(d, 1)
        IfCondition GreaterThan(OptState.flt_skip, 0) ThenBlock: {
            OptState.flt_skip = Subtract(OptState.flt_skip, 1)
            ReturnValue(0)
        }
        d = OptState.flt_depth
        base = Add(OptState.flt_save, Multiply(d, 160))
        OptState.flt_n = Dereference(base)
        OptState.flt_ready = Dereference(Add(base, 8))
        i = 0
        WhileLoop LessThan(i, 8) {
            StoreValue(Add(OptState.flt_bits, Multiply(i, 8)), Dereference(Add(base, Add(16, Multiply(i, 8)))))
            StoreValue(Add(OptState.flt_disp, Multiply(i, 8)), Dereference(Add(base, Add(80, Multiply(i, 8)))))
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

Function.Optimize_FltConstNote {
    Input: bits: Integer
    Body: {
        IfCondition GreaterEqual(OptState.flt_n, 8) ThenBlock: { ReturnValue(0) }
        i = 0
        WhileLoop LessThan(i, OptState.flt_n) {
            have = Dereference(Add(OptState.flt_bits, Multiply(i, 8)))
            IfCondition EqualTo(have, bits) ThenBlock: { ReturnValue(0) }
            i = Add(i, 1)
        }
        at = Multiply(OptState.flt_n, 8)
        StoreValue(Add(OptState.flt_bits, at), bits)
        StoreValue(Add(OptState.flt_disp, at), 0)
        OptState.flt_n = Add(OptState.flt_n, 1)
        ReturnValue(0)
    }
}

Function.Optimize_FltConstDisp {
    Input: bits: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(OptState.flt_ready, 0) ThenBlock: { ReturnValue(0) }
        i = 0
        WhileLoop LessThan(i, OptState.flt_n) {
            have = Dereference(Add(OptState.flt_bits, Multiply(i, 8)))
            IfCondition EqualTo(have, bits) ThenBlock: {
                ReturnValue(Dereference(Add(OptState.flt_disp, Multiply(i, 8))))
            }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

Function.Optimize_FltConstWalk {
    Input: node: Address
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        t = AST_GetType(node)
        IfCondition EqualTo(Optimize_FoldIsFn(t), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(t, AST.CALL) ThenBlock: {
            opk = Optimize_FltOpKind(AST_GetData1(node))
            legal = 0
            IfCondition EqualTo(opk, 1) ThenBlock: { legal = 1 }
            IfCondition EqualTo(opk, 2) ThenBlock: { legal = 1 }
            IfCondition EqualTo(opk, 3) ThenBlock: { legal = 1 }
            IfCondition EqualTo(legal, 1) ThenBlock: {
                IfCondition EqualTo(AST_GetChildCount(node), 2) ThenBlock: {
                    s = 0
                    WhileLoop LessThan(s, 2) {
                        ch = AST_GetChild(node, s)
                        IfCondition NotEqual(ch, 0) ThenBlock: {
                            IfCondition EqualTo(AST_GetType(ch), AST.NUMBER) ThenBlock: {
                                Optimize_FltConstNote(StringToNumber(AST_GetData1(ch)))
                            }
                        }
                        s = Add(s, 1)
                    }
                }
            }
        }
        count = AST_GetChildCount(node)
        i = 0
        WhileLoop LessThan(i, count) {
            Optimize_FltConstWalk(AST_GetChild(node, i))
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

Function.Optimize_FltConstPlan {
    Input: body: Address
    Input: is_leaf: Integer
    Output: Integer
    Body: {
        IfCondition GreaterThan(OptState.flt_skip, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(is_leaf, 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(body, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_FoldIsFn(AST_GetType(body)), 1) ThenBlock: {
            c = AST_GetChildCount(body)
            i = 0
            WhileLoop LessThan(i, c) {
                Optimize_FltConstWalk(AST_GetChild(body, i))
                i = Add(i, 1)
            }
            ReturnValue(OptState.flt_n)
        }
        Optimize_FltConstWalk(body)
        ReturnValue(OptState.flt_n)
    }
}

Function.Optimize_FltConstEmit {
    Body: {
        IfCondition GreaterThan(OptState.flt_skip, 0) ThenBlock: { ReturnValue(0) }
        i = 0
        WhileLoop LessThan(i, OptState.flt_n) {
            Compile.stack_offset = Add(Compile.stack_offset, 8)
            disp = Subtract(0, Compile.stack_offset)
            bits = Dereference(Add(OptState.flt_bits, Multiply(i, 8)))
            StoreValue(Add(OptState.flt_disp, Multiply(i, 8)), disp)
            Emit_MovRaxImm64(bits)
            Emit_MovRbpOffsetRax(disp)
            i = Add(i, 1)
        }
        OptState.flt_ready = 1
        ReturnValue(0)
    }
}

Function.Optimize_IdentCount {
    Input: node: Address
    Input: name: Address
    Output: Integer
    Body: {
        LoopHome.mention_count = 0
        Optimize_CountWalk(node, name)
        ReturnValue(LoopHome.mention_count)
    }
}

Function.Optimize_ConstTempQual {
    Input: value: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(value, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(value), AST.CALL) ThenBlock: { ReturnValue(0) }
        opk = Optimize_FltOpKind(AST_GetData1(value))
        legal = 0
        IfCondition EqualTo(opk, 1) ThenBlock: { legal = 1 }
        IfCondition EqualTo(opk, 2) ThenBlock: { legal = 1 }
        IfCondition EqualTo(opk, 3) ThenBlock: { legal = 1 }
        IfCondition EqualTo(legal, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetChildCount(value), 2) ThenBlock: { ReturnValue(0) }
        saw = 0
        s = 0
        WhileLoop LessThan(s, 2) {
            ch = AST_GetChild(value, s)
            IfCondition EqualTo(ch, 0) ThenBlock: { ReturnValue(0) }
            ct = AST_GetType(ch)
            ok = 0
            IfCondition EqualTo(ct, AST.IDENTIFIER) ThenBlock: { ok = 1 }
            IfCondition EqualTo(ct, AST.NUMBER) ThenBlock: {
                disp = Optimize_FltConstDisp(StringToNumber(AST_GetData1(ch)))
                IfCondition LessThan(disp, 0) ThenBlock: {
                    ok = 1
                    saw = 1
                }
            }
            IfCondition EqualTo(ok, 0) ThenBlock: { ReturnValue(0) }
            s = Add(s, 1)
        }
        ReturnValue(saw)
    }
}

Function.Optimize_ConstTempCtrl {
    Input: t: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(t, AST.IF) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(t, AST.FORK) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(t, AST.SWITCH) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(t, AST.BRANCH) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(t, AST.TRY) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(Optimize_FoldIsLoop(t), 1) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

Function.Optimize_ConstTempInside {
    Input: node: Address
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(1) }
        t = AST_GetType(node)
        IfCondition EqualTo(Optimize_FoldIsFn(t), 1) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(Optimize_FoldIsBlock(node), 1) ThenBlock: {
            ReturnValue(Optimize_ConstTempBlock(node, name))
        }
        IfCondition EqualTo(t, AST.ASSIGNMENT) ThenBlock: {
            IfCondition EqualTo(AST_GetData2(node), 0) ThenBlock: {
                IfCondition EqualTo(Optimize_NameEq(AST_GetData1(node), name), 1) ThenBlock: { ReturnValue(0) }
            }
        }
        IfCondition EqualTo(t, AST.IDENTIFIER) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(AST_GetData1(node), name), 1) ThenBlock: { ReturnValue(0) }
        }
        count = AST_GetChildCount(node)
        i = 0
        WhileLoop LessThan(i, count) {
            IfCondition EqualTo(Optimize_ConstTempInside(AST_GetChild(node, i), name), 0) ThenBlock: { ReturnValue(0) }
            i = Add(i, 1)
        }
        ReturnValue(1)
    }
}

Function.Optimize_ConstTempBlock {
    Input: block: Address
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(block, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_FoldIsBlock(block), 0) ThenBlock: { ReturnValue(0) }
        pending = 0
        count = AST_GetChildCount(block)
        i = 0
        WhileLoop LessThan(i, count) {
            st = AST_GetChild(block, i)
            IfCondition NotEqual(st, 0) ThenBlock: {
                t = AST_GetType(st)
                handled = 0
                IfCondition EqualTo(t, AST.INDEX_ASSIGN) ThenBlock: {
                    IfCondition EqualTo(Optimize_NameEq(AST_GetData1(st), name), 1) ThenBlock: { ReturnValue(0) }
                }
                IfCondition EqualTo(t, AST.ASSIGNMENT) ThenBlock: {
                    IfCondition EqualTo(Optimize_NameEq(AST_GetData1(st), name), 1) ThenBlock: {
                        IfCondition NotEqual(AST_GetData2(st), 0) ThenBlock: { ReturnValue(0) }
                        rhs = AST_GetChild(st, 0)
                        IfCondition EqualTo(Optimize_ConstTempQual(rhs), 0) ThenBlock: { ReturnValue(0) }
                        IfCondition EqualTo(Optimize_TreeHasIdent(rhs, name), 1) ThenBlock: { ReturnValue(0) }
                        IfCondition EqualTo(pending, 1) ThenBlock: { ReturnValue(0) }
                        pending = 1
                        OptState.flt_saw = Add(OptState.flt_saw, 1)
                        handled = 1
                    }
                }
                IfCondition EqualTo(handled, 0) ThenBlock: {
                    IfCondition EqualTo(Optimize_FoldIsBlock(st), 1) ThenBlock: {
                        IfCondition EqualTo(pending, 1) ThenBlock: { ReturnValue(0) }
                        IfCondition EqualTo(Optimize_ConstTempBlock(st, name), 0) ThenBlock: { ReturnValue(0) }
                        handled = 1
                    }
                }
                IfCondition EqualTo(handled, 0) ThenBlock: {
                    IfCondition EqualTo(Optimize_ConstTempCtrl(t), 1) ThenBlock: {
                        IfCondition EqualTo(pending, 1) ThenBlock: {
                            IfCondition EqualTo(Optimize_TreeHasIdent(st, name), 1) ThenBlock: { ReturnValue(0) }
                        }
                        IfCondition EqualTo(pending, 0) ThenBlock: {
                            IfCondition EqualTo(Optimize_ConstTempInside(st, name), 0) ThenBlock: { ReturnValue(0) }
                        }
                        handled = 1
                    }
                }
                IfCondition EqualTo(handled, 0) ThenBlock: {
                    IfCondition EqualTo(Optimize_TreeHasIdent(st, name), 1) ThenBlock: {
                        IfCondition EqualTo(pending, 0) ThenBlock: { ReturnValue(0) }
                        IfCondition NotEqual(Optimize_IdentCount(st, name), 1) ThenBlock: { ReturnValue(0) }
                        pending = 0
                    }
                }
            }
            i = Add(i, 1)
        }
        IfCondition EqualTo(pending, 1) ThenBlock: { ReturnValue(0) }
        ReturnValue(1)
    }
}

Function.Optimize_ConstTempSkip {
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(OptState.flt_ready, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(LoopHome.body, 0) ThenBlock: { ReturnValue(0) }
        OptState.flt_saw = 0
        IfCondition EqualTo(Optimize_ConstTempBlock(LoopHome.body, name), 0) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(OptState.flt_saw, 1) ThenBlock: { ReturnValue(0) }
        ReturnValue(1)
    }
}

// Product of a slotted constant into xmm0, held for the one use in this block.
// Subtraction stays left then right. A held right operand is parked in xmm1
// before the left load, because the load uses xmm0.

Function.Optimize_TryFltConst {
    Input: target: Address
    Input: value: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(LoopHome.active, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_IsIntHome(target), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_IsFltHome(target), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_IsAccHome(target), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(value, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(value), AST.CALL) ThenBlock: { ReturnValue(0) }
        opk = Optimize_FltOpKind(AST_GetData1(value))
        legal = 0
        IfCondition EqualTo(opk, 1) ThenBlock: { legal = 1 }
        IfCondition EqualTo(opk, 2) ThenBlock: { legal = 1 }
        IfCondition EqualTo(opk, 3) ThenBlock: { legal = 1 }
        IfCondition EqualTo(legal, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetChildCount(value), 2) ThenBlock: { ReturnValue(0) }
        Optimize_OpClass(AST_GetChild(value, 0))
        c0 = LoopHome.hit_class
        d0 = LoopHome.hit_disp
        x0 = LoopHome.hit_xmm
        Optimize_OpClass(AST_GetChild(value, 1))
        c1 = LoopHome.hit_class
        d1 = LoopHome.hit_disp
        x1 = LoopHome.hit_xmm
        IfCondition EqualTo(Optimize_FltSrcOk(c0), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_FltSrcOk(c1), 0) ThenBlock: { ReturnValue(0) }
        saw8 = 0
        IfCondition EqualTo(c0, 8) ThenBlock: { saw8 = 1 }
        IfCondition EqualTo(c1, 8) ThenBlock: { saw8 = 1 }
        IfCondition EqualTo(saw8, 0) ThenBlock: { ReturnValue(0) }
        hold_ok = Optimize_HoldHere(target, value)
        IfCondition EqualTo(hold_ok, 0) ThenBlock: { hold_ok = Optimize_HoldArm(target, value) }
        IfCondition EqualTo(hold_ok, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(LoopHome.hold_on, 1) ThenBlock: {
            uses = 0
            IfCondition EqualTo(c0, 3) ThenBlock: { uses = 1 }
            IfCondition EqualTo(c1, 3) ThenBlock: { uses = 1 }
            IfCondition EqualTo(uses, 0) ThenBlock: { Optimize_FlushHold() }
        }
        IfCondition EqualTo(c1, 3) ThenBlock: {
            Emit_HomeMove(37, 0)
            Optimize_FltHomeOp(0, c0, d0, x0, 16)
            IfCondition EqualTo(opk, 1) ThenBlock: { Emit_HomeMove(38, 0) }
            IfCondition EqualTo(opk, 2) ThenBlock: { Emit_HomeMove(39, 0) }
            IfCondition EqualTo(opk, 3) ThenBlock: { Emit_HomeMove(40, 0) }
        }
        IfCondition NotEqual(c1, 3) ThenBlock: {
            opc = 88
            IfCondition EqualTo(opk, 2) ThenBlock: { opc = 92 }
            IfCondition EqualTo(opk, 3) ThenBlock: { opc = 89 }
            Optimize_FltHomeOp(0, c0, d0, x0, 16)
            Optimize_FltHomeOp(0, c1, d1, x1, opc)
        }
        LoopHome.hold_on = 1
        LoopHome.hold_name = target
        ReturnValue(1)
    }
}

// A later Branch on the same identifier can use constants an earlier Branch
// on that identifier already chose. Keys match by number or by Default.
// A non-number case does not match. The parent env stays poisoned.

Function.Optimize_FoldFree2 {
    Input: a: Address
    Input: b: Address
    Body: {
        Optimize_FoldFree(a)
        Optimize_FoldFree(b)
        ReturnValue(0)
    }
}

Function.Optimize_FoldSinkEnd {
    Input: key_k: Address
    Input: key_v: Address
    Input: between: Address
    Input: saved: Address
    Body: {
        OptState.fold_between = saved
        Optimize_FoldFree(between)
        Optimize_FoldFree2(key_k, key_v)
        ReturnValue(0)
    }
}

Function.Optimize_FoldScrut {
    Input: stmt: Address
    Output: Address
    Body: {
        IfCondition EqualTo(stmt, 0) ThenBlock: { ReturnValue(0) }
        t = AST_GetType(stmt)
        branch = 0
        IfCondition EqualTo(t, AST.SWITCH) ThenBlock: { branch = 1 }
        IfCondition EqualTo(t, AST.BRANCH) ThenBlock: { branch = 1 }
        IfCondition EqualTo(branch, 0) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(AST_GetChildCount(stmt), 1) ThenBlock: { ReturnValue(0) }
        scr = AST_GetChild(stmt, 0)
        IfCondition EqualTo(scr, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(scr), AST.IDENTIFIER) ThenBlock: { ReturnValue(0) }
        ReturnValue(AST_GetData1(scr))
    }
}

Function.Optimize_FoldPrior {
    Input: block: Address
    Input: index: Integer
    Input: stmt: Address
    Input: between: Address
    Output: Address
    Body: {
        want = Optimize_FoldScrut(stmt)
        IfCondition EqualTo(want, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(block, 0) ThenBlock: { ReturnValue(0) }
        p = Subtract(index, 1)
        WhileLoop GreaterEqual(p, 0) {
            st = AST_GetChild(block, p)
            nm = Optimize_FoldSimple(st)
            IfCondition NotEqual(nm, 0) ThenBlock: {
                IfCondition EqualTo(Optimize_NameEq(nm, want), 1) ThenBlock: { ReturnValue(0) }
                IfCondition EqualTo(between, 0) ThenBlock: { ReturnValue(0) }
                IfCondition EqualTo(Optimize_FoldListed(between, nm), 0) ThenBlock: {
                    IfCondition GreaterEqual(Array.Size(between), 32) ThenBlock: { ReturnValue(0) }
                    Array.Push(between, nm)
                }
            }
            IfCondition EqualTo(nm, 0) ThenBlock: {
                got = Optimize_FoldScrut(st)
                IfCondition EqualTo(got, 0) ThenBlock: { ReturnValue(0) }
                IfCondition EqualTo(Optimize_NameEq(got, want), 0) ThenBlock: { ReturnValue(0) }
                ReturnValue(st)
            }
            p = Subtract(p, 1)
        }
        ReturnValue(0)
    }
}

Function.Optimize_FoldKeys {
    Input: stmt: Address
    Input: key_k: Address
    Input: key_v: Address
    Body: {
        IfCondition EqualTo(stmt, 0) ThenBlock: { ReturnValue(0) }
        count = AST_GetChildCount(stmt)
        i = 1
        WhileLoop LessThan(i, count) {
            ch = AST_GetChild(stmt, i)
            IfCondition NotEqual(ch, 0) ThenBlock: {
                ct = AST_GetType(ch)
                IfCondition EqualTo(ct, AST.CASE) ThenBlock: {
                    kk = 0
                    kv = 0
                    IfCondition GreaterEqual(AST_GetChildCount(ch), 1) ThenBlock: {
                        key = AST_GetChild(ch, 0)
                        IfCondition NotEqual(key, 0) ThenBlock: {
                            IfCondition EqualTo(AST_GetType(key), AST.NUMBER) ThenBlock: {
                                kk = 1
                                kv = StringToNumber(AST_GetData1(key))
                            }
                        }
                    }
                    Array.Push(key_k, kk)
                    Array.Push(key_v, kv)
                }
                IfCondition EqualTo(ct, AST.DEFAULT) ThenBlock: {
                    Array.Push(key_k, 2)
                    Array.Push(key_v, 0)
                }
            }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

Function.Optimize_FoldImportNames {
    Input: prior: Address
    Input: cands: Address
    Body: {
        IfCondition EqualTo(prior, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(cands, 0) ThenBlock: { ReturnValue(0) }
        arms = Array.Create(4)
        IfCondition EqualTo(Optimize_FoldGather(prior, arms), 0) ThenBlock: {
            Optimize_FoldFree(arms)
            ReturnValue(0)
        }
        a = 0
        ac = Array.Size(arms)
        WhileLoop LessThan(a, ac) {
            Optimize_FoldCollect(Array.Get(arms, a), cands)
            a = Add(a, 1)
        }
        Optimize_FoldFree(arms)
        ReturnValue(0)
    }
}

Function.Optimize_FoldImport {
    Input: prior: Address
    Input: kk: Integer
    Input: kv: Integer
    Input: dn: Address
    Input: dk: Address
    Input: dv: Address
    Body: {
        IfCondition EqualTo(prior, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(kk, 0) ThenBlock: { ReturnValue(0) }
        arms = Array.Create(4)
        kks = Array.Create(4)
        kvs = Array.Create(4)
        IfCondition EqualTo(Optimize_FoldGather(prior, arms), 0) ThenBlock: {
            Optimize_FoldFree(arms)
            Optimize_FoldFree(kks)
            Optimize_FoldFree(kvs)
            ReturnValue(0)
        }
        Optimize_FoldKeys(prior, kks, kvs)
        found = -1
        a = 0
        ac = Array.Size(arms)
        WhileLoop LessThan(a, ac) {
            IfCondition LessThan(a, Array.Size(kks)) ThenBlock: {
                ak = Array.Get(kks, a)
                av = Array.Get(kvs, a)
                match = 0
                IfCondition EqualTo(kk, 2) ThenBlock: {
                    IfCondition EqualTo(ak, 2) ThenBlock: { match = 1 }
                }
                IfCondition EqualTo(kk, 1) ThenBlock: {
                    IfCondition EqualTo(ak, 1) ThenBlock: {
                        IfCondition EqualTo(kv, av) ThenBlock: { match = 1 }
                    }
                }
                IfCondition EqualTo(match, 1) ThenBlock: {
                    found = a
                    a = ac
                }
            }
            a = Add(a, 1)
        }
        IfCondition LessThan(found, 0) ThenBlock: {
            Optimize_FoldFree(arms)
            Optimize_FoldFree(kks)
            Optimize_FoldFree(kvs)
            ReturnValue(0)
        }
        body = Array.Get(arms, found)
        cands = Array.Create(4)
        Optimize_FoldCollect(body, cands)
        tn = Array.Create(8)
        tk = Array.Create(8)
        tv = Array.Create(8)
        Optimize_FoldDup(tn, tk, tv, dn, dk, dv)
        Optimize_FoldArm(body, tn, tk, tv)
        j = 0
        jc = Array.Size(cands)
        WhileLoop LessThan(j, jc) {
            nm = Array.Get(cands, j)
            Optimize_FoldLookup(tn, tk, tv, nm, 0)
            keepk = FoldHold.kind
            keepv = FoldHold.val
            listed = Optimize_FoldListed(OptState.fold_between, nm)
            IfCondition EqualTo(listed, 0) ThenBlock: {
                IfCondition EqualTo(keepk, 1) ThenBlock: {
                    Optimize_FoldForce(dn, dk, dv, nm, keepk, keepv)
                }
                IfCondition EqualTo(keepk, 2) ThenBlock: {
                    Optimize_FoldForce(dn, dk, dv, nm, keepk, keepv)
                }
            }
            j = Add(j, 1)
        }
        Optimize_FoldFree(tn)
        Optimize_FoldFree(tk)
        Optimize_FoldFree(tv)
        Optimize_FoldFree(cands)
        Optimize_FoldFree(arms)
        Optimize_FoldFree(kks)
        Optimize_FoldFree(kvs)
        ReturnValue(0)
    }
}

Function.Optimize_FoldSink {
    Input: block: Address
    Input: index: Integer
    Input: stmt: Address
    Input: names: Address
    Input: kinds: Address
    Input: vals: Address
    Body: {
        arms = Array.Create(8)
        can = Optimize_FoldGather(stmt, arms)
        IfCondition EqualTo(can, 0) ThenBlock: {
            dn = Array.Create(8)
            dk = Array.Create(8)
            dv = Array.Create(8)
            Optimize_FoldDup(dn, dk, dv, names, kinds, vals)
            Optimize_FoldWalkInside(stmt, dn, dk, dv)
            Optimize_FoldFree6(arms, dn, dk, dv, 0, 0)
            ReturnValue(0)
        }
        key_k = Array.Create(8)
        key_v = Array.Create(8)
        between = Array.Create(8)
        saved_between = OptState.fold_between
        prior = 0
        IfCondition NotEqual(Optimize_FoldScrut(stmt), 0) ThenBlock: {
            Optimize_FoldKeys(stmt, key_k, key_v)
            prior = Optimize_FoldPrior(block, index, stmt, between)
        }
        acount = Array.Size(arms)
        a = 0
        WhileLoop LessThan(a, acount) {
            dn = Array.Create(8)
            dk = Array.Create(8)
            dv = Array.Create(8)
            Optimize_FoldDup(dn, dk, dv, names, kinds, vals)
            Optimize_FoldWalkBlock(Array.Get(arms, a), dn, dk, dv)
            Optimize_FoldFree(dn)
            Optimize_FoldFree(dk)
            Optimize_FoldFree(dv)
            a = Add(a, 1)
        }
        IfCondition EqualTo(FoldHold.stop, 1) ThenBlock: {
            Optimize_FoldSinkEnd(key_k, key_v, between, saved_between)
            Optimize_FoldFree(arms)
            ReturnValue(0)
        }
        cands = Array.Create(8)
        overflow = 0
        a = 0
        WhileLoop LessThan(a, acount) {
            IfCondition EqualTo(Optimize_FoldCollect(Array.Get(arms, a), cands), 1) ThenBlock: {
                overflow = 1
            }
            a = Add(a, 1)
        }
        IfCondition EqualTo(overflow, 0) ThenBlock: {
            Optimize_FoldImportNames(prior, cands)
        }
        jcount = Array.Size(cands)
        IfCondition EqualTo(overflow, 1) ThenBlock: { jcount = 0 }
        IfCondition LessThan(jcount, 1) ThenBlock: {
            Optimize_FoldSinkEnd(key_k, key_v, between, saved_between)
            Optimize_FoldFree6(arms, cands, 0, 0, 0, 0)
            ReturnValue(0)
        }
        OptState.fold_between = between
        flat_k = Array.Create(32)
        flat_v = Array.Create(32)
        a = 0
        WhileLoop LessThan(a, acount) {
            dn = Array.Create(8)
            dk = Array.Create(8)
            dv = Array.Create(8)
            Optimize_FoldDup(dn, dk, dv, names, kinds, vals)
            IfCondition NotEqual(prior, 0) ThenBlock: {
                IfCondition EqualTo(Array.Size(key_k), acount) ThenBlock: {
                    Optimize_FoldImport(prior, Array.Get(key_k, a), Array.Get(key_v, a), dn, dk, dv)
                }
            }
            Optimize_FoldArm(Array.Get(arms, a), dn, dk, dv)
            j = 0
            WhileLoop LessThan(j, jcount) {
                Optimize_FoldLookup(dn, dk, dv, Array.Get(cands, j), 0)
                fk = FoldHold.kind
                fv = FoldHold.val
                IfCondition NotEqual(fk, 1) ThenBlock: {
                    IfCondition NotEqual(fk, 2) ThenBlock: { fk = 0 }
                }
                Array.Push(flat_k, fk)
                Array.Push(flat_v, fv)
                j = Add(j, 1)
            }
            Optimize_FoldFree(dn)
            Optimize_FoldFree(dk)
            Optimize_FoldFree(dv)
            a = Add(a, 1)
        }
        keep = Array.Create(8)
        j = 0
        WhileLoop LessThan(j, jcount) {
            ok = 1
            a = 0
            WhileLoop LessThan(a, acount) {
                fk = Array.Get(flat_k, Add(Multiply(a, jcount), j))
                IfCondition NotEqual(fk, 1) ThenBlock: {
                    IfCondition NotEqual(fk, 2) ThenBlock: { ok = 0 }
                }
                a = Add(a, 1)
            }
            IfCondition EqualTo(ok, 1) ThenBlock: {
                Array.Push(keep, j)
            }
            j = Add(j, 1)
        }
        join_n = Array.Size(keep)
        IfCondition LessThan(join_n, 1) ThenBlock: {
            Optimize_FoldSinkEnd(key_k, key_v, between, saved_between)
            Optimize_FoldFree6(arms, cands, flat_k, flat_v, keep, 0)
            ReturnValue(0)
        }
        dep = Array.Create(8)
        j = 0
        WhileLoop LessThan(j, join_n) {
            Array.Push(dep, Array.Get(cands, Array.Get(keep, j)))
            j = Add(j, 1)
        }
        pref = Array.Create(8)
        bcount = AST_GetChildCount(block)
        k = Add(index, 1)
        WhileLoop LessThan(Array.Size(pref), 8) {
            IfCondition GreaterEqual(k, bcount) ThenBlock: { ExitLoop }
            st = AST_GetChild(block, k)
            nm = Optimize_FoldSimple(st)
            take = 0
            IfCondition NotEqual(nm, 0) ThenBlock: {
                rhs = AST_GetChild(st, 0)
                IfCondition EqualTo(Optimize_FoldPure(rhs), 1) ThenBlock: {
                    IfCondition EqualTo(Optimize_FoldHit(rhs, dep, 0, Array.Size(dep)), 1) ThenBlock: {
                        take = 1
                    }
                }
            }
            IfCondition EqualTo(take, 0) ThenBlock: { ExitLoop }
            Array.Push(pref, k)
            Array.Push(dep, nm)
            k = Add(k, 1)
        }
        len = Array.Size(pref)
        done = 0
        WhileLoop EqualTo(done, 0) {
            IfCondition LessEqual(len, 0) ThenBlock: { done = 1 }
            IfCondition GreaterThan(len, 0) ThenBlock: {
                bad = 0
                j = Add(Array.Get(pref, Subtract(len, 1)), 1)
                WhileLoop LessThan(j, bcount) {
                    IfCondition EqualTo(Optimize_FoldHit(AST_GetChild(block, j), dep, join_n, len), 1) ThenBlock: {
                        bad = 1
                    }
                    j = Add(j, 1)
                }
                IfCondition EqualTo(bad, 0) ThenBlock: { done = 1 }
                IfCondition EqualTo(bad, 1) ThenBlock: { len = Subtract(len, 1) }
            }
        }
        IfCondition LessEqual(len, 0) ThenBlock: {
            Optimize_FoldFree(pref)
            Optimize_FoldSinkEnd(key_k, key_v, between, saved_between)
            Optimize_FoldFree6(arms, cands, flat_k, flat_v, keep, dep)
            ReturnValue(0)
        }
        IfCondition EqualTo(FoldHold.stop, 1) ThenBlock: {
            Optimize_FoldFree(pref)
            Optimize_FoldSinkEnd(key_k, key_v, between, saved_between)
            Optimize_FoldFree6(arms, cands, flat_k, flat_v, keep, dep)
            ReturnValue(0)
        }
        IfCondition GreaterThan(Array.Size(names), 480) ThenBlock: {
            Optimize_FoldFree(pref)
            Optimize_FoldSinkEnd(key_k, key_v, between, saved_between)
            Optimize_FoldFree6(arms, cands, flat_k, flat_v, keep, dep)
            ReturnValue(0)
        }
        a = 0
        WhileLoop LessThan(a, acount) {
            dn = Array.Create(16)
            dk = Array.Create(16)
            dv = Array.Create(16)
            Optimize_FoldDup(dn, dk, dv, names, kinds, vals)
            j = 0
            WhileLoop LessThan(j, join_n) {
                srcj = Array.Get(keep, j)
                fk = Array.Get(flat_k, Add(Multiply(a, jcount), srcj))
                fv = Array.Get(flat_v, Add(Multiply(a, jcount), srcj))
                Optimize_FoldForce(dn, dk, dv, Array.Get(cands, srcj), fk, fv)
                j = Add(j, 1)
            }
            m = 0
            WhileLoop LessThan(m, len) {
                st = AST_GetChild(block, Array.Get(pref, m))
                tname = AST_GetData1(st)
                cloned = Optimize_InlineClone(AST_GetChild(st, 0), 0)
                rewritten = Optimize_FoldSubst(cloned, dn, dk, dv)
                Optimize_FoldValue(rewritten, dn, dk, dv, 0)
                ck = FoldHold.kind
                cv = FoldHold.val
                IfCondition EqualTo(ck, 1) ThenBlock: {
                    Optimize_FoldForce(dn, dk, dv, tname, 1, cv)
                }
                IfCondition EqualTo(ck, 2) ThenBlock: {
                    Optimize_FoldForce(dn, dk, dv, tname, 2, cv)
                }
                IfCondition NotEqual(ck, 1) ThenBlock: {
                    IfCondition NotEqual(ck, 2) ThenBlock: {
                        IfCondition EqualTo(rewritten, 0) ThenBlock: {
                            Optimize_FoldForce(dn, dk, dv, tname, 0, 0)
                        }
                        IfCondition NotEqual(rewritten, 0) ThenBlock: {
                            IfCondition EqualTo(AST_GetType(rewritten), AST.IDENTIFIER) ThenBlock: {
                                Optimize_FoldForce(dn, dk, dv, tname, 3, AST_GetData1(rewritten))
                            }
                            IfCondition NotEqual(AST_GetType(rewritten), AST.IDENTIFIER) ThenBlock: {
                                asg = AST_MakeAssignment(tname, rewritten)
                                AST_SetLine(asg, AST_GetLine(st))
                                AST_SetCol(asg, AST_GetCol(st))
                                AST_AddChild(Array.Get(arms, a), asg)
                                Optimize_FoldForce(dn, dk, dv, tname, 0, 0)
                            }
                        }
                    }
                }
                m = Add(m, 1)
            }
            Optimize_FoldFree(dn)
            Optimize_FoldFree(dk)
            Optimize_FoldFree(dv)
            a = Add(a, 1)
        }
        children = AST_GetChildren(block)
        m = Subtract(len, 1)
        WhileLoop GreaterEqual(m, 0) {
            Array.Delete(children, Array.Get(pref, m))
            m = Subtract(m, 1)
        }
        Optimize_FoldFree(pref)
        Optimize_FoldSinkEnd(key_k, key_v, between, saved_between)
            Optimize_FoldFree6(arms, cands, flat_k, flat_v, keep, dep)
        ReturnValue(0)
    }
}

Function.Optimize_FoldWalkInside {
    Input: node: Address
    Input: names: Address
    Input: kinds: Address
    Input: vals: Address
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        t = AST_GetType(node)
        IfCondition EqualTo(Optimize_FoldIsFn(t), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_FoldIsBlock(node), 1) ThenBlock: {
            Optimize_FoldWalkBlock(node, names, kinds, vals)
            ReturnValue(0)
        }
        count = AST_GetChildCount(node)
        i = 0
        WhileLoop LessThan(i, count) {
            Optimize_FoldWalkInside(AST_GetChild(node, i), names, kinds, vals)
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

Function.Optimize_FoldWalkBlock {
    Input: block: Address
    Input: names: Address
    Input: kinds: Address
    Input: vals: Address
    Body: {
        IfCondition EqualTo(block, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_FoldIsBlock(block), 0) ThenBlock: { ReturnValue(0) }
        i = 0
        count = AST_GetChildCount(block)
        WhileLoop LessThan(i, count) {
            stmt = AST_GetChild(block, i)
            st = AST_GetType(stmt)
            IfCondition EqualTo(Optimize_FoldIsBlock(stmt), 1) ThenBlock: {
                Optimize_FoldWalkBlock(stmt, names, kinds, vals)
            }
            IfCondition EqualTo(Optimize_FoldIsLoop(st), 1) ThenBlock: {
                dn = Array.Create(8)
                dk = Array.Create(8)
                dv = Array.Create(8)
                Optimize_FoldDup(dn, dk, dv, names, kinds, vals)
                Optimize_FoldPoison(stmt, dn, dk, dv)
                Optimize_FoldWalkInside(stmt, dn, dk, dv)
                Optimize_FoldFree(dn)
                Optimize_FoldFree(dk)
                Optimize_FoldFree(dv)
                Optimize_FoldPoison(stmt, names, kinds, vals)
            }
            IfCondition EqualTo(Optimize_FoldIsCtrl(st), 1) ThenBlock: {
                IfCondition EqualTo(Optimize_FoldIsLoop(st), 0) ThenBlock: {
                    Optimize_FoldSink(block, i, stmt, names, kinds, vals)
                    Optimize_FoldPoison(stmt, names, kinds, vals)
                }
            }
            IfCondition EqualTo(Optimize_FoldIsCtrl(st), 0) ThenBlock: {
                IfCondition EqualTo(Optimize_FoldIsBlock(stmt), 0) ThenBlock: {
                    nm = Optimize_FoldSimple(stmt)
                    IfCondition NotEqual(nm, 0) ThenBlock: {
                        Optimize_FoldValue(AST_GetChild(stmt, 0), names, kinds, vals, 0)
                        IfCondition EqualTo(FoldHold.kind, 1) ThenBlock: {
                            Optimize_FoldPut(names, kinds, vals, nm, 1, FoldHold.val)
                        }
                        IfCondition EqualTo(FoldHold.kind, 2) ThenBlock: {
                            Optimize_FoldPut(names, kinds, vals, nm, 2, FoldHold.val)
                        }
                        IfCondition NotEqual(FoldHold.kind, 1) ThenBlock: {
                            IfCondition NotEqual(FoldHold.kind, 2) ThenBlock: {
                                Optimize_FoldPut(names, kinds, vals, nm, 0, 0)
                            }
                        }
                    }
                    IfCondition EqualTo(nm, 0) ThenBlock: {
                        Optimize_FoldWalkInside(stmt, names, kinds, vals)
                    }
                }
            }
            count = AST_GetChildCount(block)
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

Function.Optimize_FoldDots {
    Input: node: Address
    Input: dest: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        t = AST_GetType(node)
        IfCondition EqualTo(Optimize_FoldIsFn(t), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(t, AST.ASSIGNMENT) ThenBlock: {
            IfCondition EqualTo(AST_GetData2(node), 0) ThenBlock: {
                nm = AST_GetData1(node)
                IfCondition EqualTo(Optimize_FoldDot(nm), 1) ThenBlock: {
                    have = 0
                    j = 0
                    n = Array.Size(dest)
                    WhileLoop LessThan(j, n) {
                        IfCondition EqualTo(Optimize_NameEq(Array.Get(dest, j), nm), 1) ThenBlock: {
                            have = 1
                            ExitLoop
                        }
                        j = Add(j, 1)
                    }
                    IfCondition EqualTo(have, 0) ThenBlock: {
                        IfCondition GreaterEqual(n, 512) ThenBlock: { ReturnValue(1) }
                        Array.Push(dest, nm)
                    }
                }
            }
        }
        count = AST_GetChildCount(node)
        i = 0
        WhileLoop LessThan(i, count) {
            IfCondition EqualTo(Optimize_FoldDots(AST_GetChild(node, i), dest), 1) ThenBlock: {
                ReturnValue(1)
            }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

Function.Optimize_FoldListed {
    Input: names: Address
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(names, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }
        n = Array.Size(names)
        i = 0
        WhileLoop LessThan(i, n) {
            IfCondition EqualTo(Optimize_NameEq(Array.Get(names, i), name), 1) ThenBlock: {
                ReturnValue(1)
            }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

Function.Optimize_FoldFunction {
    Input: body: Address
    Body: {
        IfCondition EqualTo(body, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(OptState.pool_slot, 0) ThenBlock: { ReturnValue(0) }
        FoldHold.stop = 0
        names = Array.Create(32)
        kinds = Array.Create(32)
        vals = Array.Create(32)
        dots = Array.Create(8)
        skip = Optimize_FoldDots(body, dots)
        IfCondition EqualTo(skip, 0) ThenBlock: {
            n = Array.Size(OptState.pool_kinds)
            i = 0
            WhileLoop LessThan(i, n) {
                pk = Array.Get(OptState.pool_kinds, i)
                keep = 0
                IfCondition EqualTo(pk, 1) ThenBlock: { keep = 1 }
                IfCondition EqualTo(pk, 2) ThenBlock: { keep = 1 }
                IfCondition EqualTo(keep, 1) ThenBlock: {
                    pn = Array.Get(OptState.pool_names, i)
                    IfCondition EqualTo(Optimize_FoldListed(dots, pn), 0) ThenBlock: {
                        IfCondition LessThan(Array.Size(names), 512) ThenBlock: {
                            Array.Push(names, pn)
                            Array.Push(kinds, pk)
                            Array.Push(vals, Array.Get(OptState.pool_vals, i))
                        }
                    }
                }
                i = Add(i, 1)
            }
        }
        Optimize_FoldFree(dots)
        Optimize_FoldWalkBlock(body, names, kinds, vals)
        Optimize_FoldFree(names)
        Optimize_FoldFree(kinds)
        Optimize_FoldFree(vals)
        FoldHold.stop = 0
        ReturnValue(0)
    }
}

// A straight-line temporary with one later read is copied into that read
// and the store is dropped. Nested math then stays in rax or xmm the way a
// handwritten expression already does. The name must not be read outside
// this block, and nothing between the store and the read may change a name
// the expression uses.
Function.Optimize_PlainAssign {
    Input: node: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(node), AST.ASSIGNMENT) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetData2(node), 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(1)
    }
}

Function.Optimize_PureName {
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(StringCompare(name, "Add"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "Subtract"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "Multiply"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "Divide"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "Modulo"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "Negate"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "BitwiseAnd"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "BitwiseOr"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "BitwiseXor"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "BitwiseNot"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "LeftShift"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "RightShift"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "BitAnd"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "BitOr"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "BitXor"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "BitNot"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "ShiftLeft"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "ShiftRight"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "Float_Add"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "Float_Sub"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "Float_Mul"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "Float_Div"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "Float_Neg"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "Float_Abs"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "Float_Sqrt"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "Float_FromInt"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "Float_ToInt"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "Dereference"), 0) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

Function.Optimize_PureExpr {
    Input: node: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        nt = AST_GetType(node)
        IfCondition EqualTo(nt, AST.NUMBER) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(nt, AST.IDENTIFIER) ThenBlock: { ReturnValue(1) }
        IfCondition NotEqual(nt, AST.CALL) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_PureName(AST_GetData1(node)), 0) ThenBlock: { ReturnValue(0) }
        count = AST_GetChildCount(node)
        i = 0
        ok = 1
        WhileLoop LessThan(i, count) {
            IfCondition EqualTo(Optimize_PureExpr(AST_GetChild(node, i)), 0) ThenBlock: { ok = 0 }
            i = Add(i, 1)
        }
        ReturnValue(ok)
    }
}

Function.Optimize_CountIdents {
    Input: node: Address
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        n = 0
        IfCondition EqualTo(AST_GetType(node), AST.IDENTIFIER) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(AST_GetData1(node), name), 1) ThenBlock: { n = 1 }
        }
        count = AST_GetChildCount(node)
        i = 0
        WhileLoop LessThan(i, count) {
            n = Add(n, Optimize_CountIdents(AST_GetChild(node, i), name))
            i = Add(i, 1)
        }
        ReturnValue(n)
    }
}

Function.Optimize_Mentions {
    Input: node: Address
    Input: name: Address
    Output: Integer
    Body: {
        LoopHome.mention_count = 0
        Optimize_CountWalk(node, name)
        ReturnValue(LoopHome.mention_count)
    }
}

Function.Optimize_UsesAfter {
    Input: block: Address
    Input: name: Address
    Input: def_at: Integer
    Output: Integer
    Body: {
        uses = 0
        OptState.fold_between = -1
        count = AST_GetChildCount(block)
        k = Add(def_at, 1)
        WhileLoop LessThan(k, count) {
            sk = AST_GetChild(block, k)
            stop = 0
            IfCondition EqualTo(Optimize_PlainAssign(sk), 1) ThenBlock: {
                IfCondition EqualTo(Optimize_NameEq(AST_GetData1(sk), name), 1) ThenBlock: { stop = 1 }
            }
            n = Optimize_CountIdents(sk, name)
            IfCondition GreaterThan(n, 0) ThenBlock: {
                IfCondition EqualTo(Optimize_PlainAssign(sk), 0) ThenBlock: { ReturnValue(-1) }
                IfCondition EqualTo(uses, 0) ThenBlock: { OptState.fold_between = k }
                uses = Add(uses, n)
            }
            IfCondition EqualTo(stop, 1) ThenBlock: { k = count }
            k = Add(k, 1)
        }
        ReturnValue(uses)
    }
}

Function.Optimize_TreeHasDeref {
    Input: node: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(AST_GetType(node), AST.CALL) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(AST_GetData1(node), "Dereference"), 1) ThenBlock: { ReturnValue(1) }
        }
        count = AST_GetChildCount(node)
        i = 0
        WhileLoop LessThan(i, count) {
            IfCondition EqualTo(Optimize_TreeHasDeref(AST_GetChild(node, i)), 1) ThenBlock: { ReturnValue(1) }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

Function.Optimize_FoldClear {
    Input: block: Address
    Input: expr: Address
    Input: def_at: Integer
    Input: use_at: Integer
    Output: Integer
    Body: {
        // A dereference only moves into the next statement. A plain
        // assignment may still hide a call, and a call may write a local
        // the expression reads or the memory a pointer names.
        k = Add(def_at, 1)
        WhileLoop LessThan(k, use_at) {
            sk = AST_GetChild(block, k)
            IfCondition EqualTo(Optimize_TreeHasDeref(expr), 1) ThenBlock: { ReturnValue(0) }
            IfCondition EqualTo(Optimize_PlainAssign(sk), 0) ThenBlock: { ReturnValue(0) }
            IfCondition EqualTo(Optimize_PureExpr(AST_GetChild(sk, 0)), 0) ThenBlock: { ReturnValue(0) }
            IfCondition EqualTo(Optimize_TreeHasIdent(expr, AST_GetData1(sk)), 1) ThenBlock: { ReturnValue(0) }
            k = Add(k, 1)
        }
        ReturnValue(1)
    }
}

Function.Optimize_ReplaceOne {
    Input: node: Address
    Input: name: Address
    Input: expr: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        count = AST_GetChildCount(node)
        i = 0
        WhileLoop LessThan(i, count) {
            ch = AST_GetChild(node, i)
            hit = 0
            IfCondition NotEqual(ch, 0) ThenBlock: {
                IfCondition EqualTo(AST_GetType(ch), AST.IDENTIFIER) ThenBlock: {
                    IfCondition EqualTo(Optimize_NameEq(AST_GetData1(ch), name), 1) ThenBlock: { hit = 1 }
                }
            }
            IfCondition EqualTo(hit, 1) ThenBlock: {
                AST_SetChild(node, i, expr)
                ReturnValue(1)
            }
            IfCondition EqualTo(Optimize_ReplaceOne(ch, name, expr), 1) ThenBlock: { ReturnValue(1) }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

// 1 when `name` is a direct argument of Float_Add or Float_Sub. A folded
// Float_Mul in that spot is what expression FMA matches.
Function.Optimize_FoldMulSite {
    Input: node: Address
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        sum = 0
        IfCondition EqualTo(AST_GetType(node), AST.CALL) ThenBlock: {
            cn = AST_GetData1(node)
            IfCondition EqualTo(StringCompare(cn, "Float_Add"), 0) ThenBlock: { sum = 1 }
            IfCondition EqualTo(StringCompare(cn, "Float_Sub"), 0) ThenBlock: { sum = 1 }
        }
        count = AST_GetChildCount(node)
        i = 0
        WhileLoop LessThan(i, count) {
            ch = AST_GetChild(node, i)
            IfCondition NotEqual(ch, 0) ThenBlock: {
                IfCondition EqualTo(sum, 1) ThenBlock: {
                    IfCondition EqualTo(AST_GetType(ch), AST.IDENTIFIER) ThenBlock: {
                        IfCondition EqualTo(Optimize_NameEq(AST_GetData1(ch), name), 1) ThenBlock: {
                            ReturnValue(1)
                        }
                    }
                }
                IfCondition EqualTo(Optimize_FoldMulSite(ch, name), 1) ThenBlock: { ReturnValue(1) }
            }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

Function.Optimize_FoldOnce {
    Input: block: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(Compile.current_func, 0) ThenBlock: { ReturnValue(0) }
        count = AST_GetChildCount(block)
        i = 0
        WhileLoop LessThan(i, count) {
            st = AST_GetChild(block, i)
            IfCondition EqualTo(Optimize_PlainAssign(st), 1) ThenBlock: {
                t = AST_GetData1(st)
                expr = AST_GetChild(st, 0)
                take = 0
                IfCondition NotEqual(expr, 0) ThenBlock: {
                    IfCondition EqualTo(Optimize_PureExpr(expr), 1) ThenBlock: {
                        IfCondition EqualTo(Optimize_TreeHasIdent(expr, t), 0) ThenBlock: { take = 1 }
                    }
                }
                IfCondition EqualTo(take, 1) ThenBlock: {
                    block_n = Optimize_Mentions(block, t)
                    func_n = Optimize_Mentions(Compile.current_func, t)
                    IfCondition EqualTo(block_n, func_n) ThenBlock: {
                        uses = Optimize_UsesAfter(block, t, i)
                        IfCondition EqualTo(uses, 1) ThenBlock: {
                            use_at = OptState.fold_between
                            use_st = AST_GetChild(block, use_at)
                            use_val = AST_GetChild(use_st, 0)
                            IfCondition EqualTo(Optimize_PureExpr(use_val), 1) ThenBlock: {
                                // A multiply folded into Float_Add or Float_Sub
                                // becomes one VFMADD and the non-integer bits
                                // change. That includes a fresh sum, not only an
                                // add that already names its own target.
                                keep_acc = 0
                                IfCondition EqualTo(AST_GetType(use_val), AST.CALL) ThenBlock: {
                                    IfCondition EqualTo(Optimize_TreeHasIdent(use_val, AST_GetData1(use_st)), 1) ThenBlock: {
                                        un = AST_GetData1(use_val)
                                        IfCondition EqualTo(StringCompare(un, "Float_Add"), 0) ThenBlock: { keep_acc = 1 }
                                        IfCondition EqualTo(StringCompare(un, "Float_Sub"), 0) ThenBlock: { keep_acc = 1 }
                                    }
                                }
                                keep_mul = 0
                                IfCondition EqualTo(AST_GetType(expr), AST.CALL) ThenBlock: {
                                    IfCondition EqualTo(StringCompare(AST_GetData1(expr), "Float_Mul"), 0) ThenBlock: {
                                        IfCondition EqualTo(Optimize_FoldMulSite(use_st, t), 1) ThenBlock: {
                                            keep_mul = 1
                                        }
                                    }
                                }
                                IfCondition EqualTo(keep_acc, 0) ThenBlock: {
                                    IfCondition EqualTo(keep_mul, 0) ThenBlock: {
                                        IfCondition EqualTo(Optimize_FoldClear(block, expr, i, use_at), 1) ThenBlock: {
                                            IfCondition EqualTo(Optimize_ReplaceOne(use_st, t, expr), 1) ThenBlock: {
                                                kids = AST_GetChildren(block)
                                                Array.Delete(kids, i)
                                                ReturnValue(1)
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

Function.Optimize_FoldBlock {
    Input: block: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(Optimize_FoldIsBlock(block), 0) ThenBlock: { ReturnValue(0) }
        saved = OptState.fold_between
        guard = 0
        WhileLoop LessThan(guard, 32) {
            did = Optimize_FoldOnce(block)
            IfCondition EqualTo(did, 0) ThenBlock: { guard = 32 }
            guard = Add(guard, 1)
        }
        OptState.fold_between = saved
        ReturnValue(0)
    }
}

// 1: float operand. 2: integer operand. 0: not a value we can park.
Function.Optimize_InvCtx {
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(StringCompare(name, "Float_Add"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "Float_Sub"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "Float_Mul"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "Float_Div"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "Float_Neg"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "Float_Abs"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "Float_Sqrt"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "Float_ToInt"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "Float_FromInt"), 0) ThenBlock: { ReturnValue(2) }
        IfCondition EqualTo(StringCompare(name, "Float_Eq"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "Float_Ne"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "Float_Lt"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "Float_Gt"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "Float_Le"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "Float_Ge"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "Add"), 0) ThenBlock: { ReturnValue(2) }
        IfCondition EqualTo(StringCompare(name, "Subtract"), 0) ThenBlock: { ReturnValue(2) }
        IfCondition EqualTo(StringCompare(name, "Multiply"), 0) ThenBlock: { ReturnValue(2) }
        IfCondition EqualTo(StringCompare(name, "Divide"), 0) ThenBlock: { ReturnValue(2) }
        IfCondition EqualTo(StringCompare(name, "Modulo"), 0) ThenBlock: { ReturnValue(2) }
        IfCondition EqualTo(StringCompare(name, "Negate"), 0) ThenBlock: { ReturnValue(2) }
        IfCondition EqualTo(StringCompare(name, "Dereference"), 0) ThenBlock: { ReturnValue(2) }
        IfCondition EqualTo(StringCompare(name, "EqualTo"), 0) ThenBlock: { ReturnValue(2) }
        IfCondition EqualTo(StringCompare(name, "NotEqual"), 0) ThenBlock: { ReturnValue(2) }
        IfCondition EqualTo(StringCompare(name, "LessThan"), 0) ThenBlock: { ReturnValue(2) }
        IfCondition EqualTo(StringCompare(name, "GreaterThan"), 0) ThenBlock: { ReturnValue(2) }
        IfCondition EqualTo(StringCompare(name, "LessEqual"), 0) ThenBlock: { ReturnValue(2) }
        IfCondition EqualTo(StringCompare(name, "GreaterEqual"), 0) ThenBlock: { ReturnValue(2) }
        IfCondition EqualTo(StringCompare(name, "BitwiseAnd"), 0) ThenBlock: { ReturnValue(2) }
        IfCondition EqualTo(StringCompare(name, "BitwiseOr"), 0) ThenBlock: { ReturnValue(2) }
        IfCondition EqualTo(StringCompare(name, "BitwiseXor"), 0) ThenBlock: { ReturnValue(2) }
        IfCondition EqualTo(StringCompare(name, "BitwiseNot"), 0) ThenBlock: { ReturnValue(2) }
        IfCondition EqualTo(StringCompare(name, "LeftShift"), 0) ThenBlock: { ReturnValue(2) }
        IfCondition EqualTo(StringCompare(name, "RightShift"), 0) ThenBlock: { ReturnValue(2) }
        IfCondition EqualTo(StringCompare(name, "BitAnd"), 0) ThenBlock: { ReturnValue(2) }
        IfCondition EqualTo(StringCompare(name, "BitOr"), 0) ThenBlock: { ReturnValue(2) }
        IfCondition EqualTo(StringCompare(name, "BitXor"), 0) ThenBlock: { ReturnValue(2) }
        IfCondition EqualTo(StringCompare(name, "BitNot"), 0) ThenBlock: { ReturnValue(2) }
        IfCondition EqualTo(StringCompare(name, "ShiftLeft"), 0) ThenBlock: { ReturnValue(2) }
        IfCondition EqualTo(StringCompare(name, "ShiftRight"), 0) ThenBlock: { ReturnValue(2) }
        ReturnValue(0)
    }
}

Function.Optimize_InvWalk {
    Input: node: Address
    Input: name: Address
    Input: ctx: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(LoopHome.hit_class, 9) ThenBlock: { ReturnValue(0) }
        nt = AST_GetType(node)
        IfCondition EqualTo(nt, AST.IDENTIFIER) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(AST_GetData1(node), name), 1) ThenBlock: {
                IfCondition EqualTo(ctx, 1) ThenBlock: {
                    IfCondition EqualTo(LoopHome.hit_class, 2) ThenBlock: { LoopHome.hit_class = 9 }
                    IfCondition EqualTo(LoopHome.hit_class, 0) ThenBlock: { LoopHome.hit_class = 1 }
                }
                IfCondition EqualTo(ctx, 2) ThenBlock: {
                    IfCondition EqualTo(LoopHome.hit_class, 1) ThenBlock: { LoopHome.hit_class = 9 }
                    IfCondition EqualTo(LoopHome.hit_class, 0) ThenBlock: { LoopHome.hit_class = 2 }
                }
                IfCondition EqualTo(ctx, 0) ThenBlock: { LoopHome.hit_class = 9 }
            }
            ReturnValue(0)
        }
        next = ctx
        IfCondition EqualTo(nt, AST.CALL) ThenBlock: { next = Optimize_InvCtx(AST_GetData1(node)) }
        count = AST_GetChildCount(node)
        i = 0
        WhileLoop LessThan(i, count) {
            Optimize_InvWalk(AST_GetChild(node, i), name, next)
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

Function.Optimize_InvOk {
    Input: name: Address
    Input: kind: Integer
    Input: condition: Address
    Input: body: Address
    Output: Integer
    Body: {
        LoopHome.hit_class = 0
        Optimize_InvWalk(condition, name, 0)
        Optimize_InvWalk(body, name, 0)
        IfCondition EqualTo(LoopHome.hit_class, kind) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

Function.Optimize_FrameOff {
    Input: name: Address
    Output: Integer
    Body: {
        LoopHome.imm_ok = 0
        off = Scope_Resolve(name)
        rt = Scope.resolve_type
        ok = 0
        IfCondition EqualTo(rt, 1) ThenBlock: { ok = 1 }
        IfCondition EqualTo(rt, 2) ThenBlock: { ok = 1 }
        IfCondition GreaterEqual(off, 0) ThenBlock: { ok = 0 }
        IfCondition EqualTo(ok, 1) ThenBlock: {
            LoopHome.imm_ok = 1
            LoopHome.imm_val = off
        }
        ReturnValue(LoopHome.imm_ok)
    }
}

// Inline asm can write a local or r11 without an assignment.
Function.Optimize_TreeHasAsm {
    Input: node: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(AST_GetType(node), AST.INLINEASM) ThenBlock: { ReturnValue(1) }
        count = AST_GetChildCount(node)
        i = 0
        WhileLoop LessThan(i, count) {
            IfCondition EqualTo(Optimize_TreeHasAsm(AST_GetChild(node, i)), 1) ThenBlock: { ReturnValue(1) }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

// A store can change a byte the induction pointer still names.
// Pinning a load across that store would reuse the old value.
Function.Optimize_TreeHasStore {
    Input: node: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        nt = AST_GetType(node)
        IfCondition EqualTo(nt, AST.INDEX_ASSIGN) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(nt, AST.POINTER_FIELD_ASSIGN) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(nt, AST.CALL) ThenBlock: {
            name = AST_GetData1(node)
            IfCondition NotEqual(name, 0) ThenBlock: {
                IfCondition EqualTo(StringCompare(name, "StoreValue"), 0) ThenBlock: { ReturnValue(1) }
                IfCondition EqualTo(StringCompare(name, "SetByte"), 0) ThenBlock: { ReturnValue(1) }
                IfCondition EqualTo(StringCompare(name, "MemoryCopy"), 0) ThenBlock: { ReturnValue(1) }
                IfCondition EqualTo(StringCompare(name, "MemorySet"), 0) ThenBlock: { ReturnValue(1) }
            }
        }
        count = AST_GetChildCount(node)
        i = 0
        WhileLoop LessThan(i, count) {
            IfCondition EqualTo(Optimize_TreeHasStore(AST_GetChild(node, i)), 1) ThenBlock: { ReturnValue(1) }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

// Assignments of name anywhere under node, including nested blocks.
Function.Optimize_AssignCount {
    Input: node: Address
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        n = 0
        IfCondition EqualTo(AST_GetType(node), AST.ASSIGNMENT) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(AST_GetData1(node), name), 1) ThenBlock: { n = 1 }
        }
        count = AST_GetChildCount(node)
        i = 0
        WhileLoop LessThan(i, count) {
            n = Add(n, Optimize_AssignCount(AST_GetChild(node, i), name))
            i = Add(i, 1)
        }
        ReturnValue(n)
    }
}

// The cursor's one update is name = name + positive constant.
// iv_step stays 0 when the body is not that shape.
Function.Optimize_FindStep {
    Input: body: Address
    Output: Integer
    Body: {
        LoopHome.iv_step = 0
        LoopHome.iv_at = -1
        IfCondition EqualTo(body, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(body), AST.BLOCK) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(LoopHome.int_name, 0) ThenBlock: { ReturnValue(0) }
        count = AST_GetChildCount(body)
        found = 0
        i = 0
        WhileLoop LessThan(i, count) {
            st = AST_GetChild(body, i)
            IfCondition EqualTo(Optimize_PlainAssign(st), 1) ThenBlock: {
                IfCondition EqualTo(Optimize_NameEq(AST_GetData1(st), LoopHome.int_name), 1) ThenBlock: {
                    IfCondition EqualTo(found, 1) ThenBlock: {
                        LoopHome.iv_step = 0
                        ReturnValue(0)
                    }
                    val = AST_GetChild(st, 0)
                    ok = 0
                    step = 0
                    IfCondition NotEqual(val, 0) ThenBlock: {
                        IfCondition EqualTo(AST_GetType(val), AST.CALL) ThenBlock: {
                            IfCondition EqualTo(StringCompare(AST_GetData1(val), "Add"), 0) ThenBlock: {
                                IfCondition EqualTo(AST_GetChildCount(val), 2) ThenBlock: {
                                    a0 = AST_GetChild(val, 0)
                                    a1 = AST_GetChild(val, 1)
                                    num = 0
                                    idn = 0
                                    IfCondition EqualTo(AST_GetType(a1), AST.NUMBER) ThenBlock: {
                                        IfCondition EqualTo(Optimize_NameIs(a0, LoopHome.int_name), 1) ThenBlock: {
                                            num = a1
                                            idn = 1
                                        }
                                    }
                                    IfCondition EqualTo(idn, 0) ThenBlock: {
                                        IfCondition EqualTo(AST_GetType(a0), AST.NUMBER) ThenBlock: {
                                            IfCondition EqualTo(Optimize_NameIs(a1, LoopHome.int_name), 1) ThenBlock: {
                                                num = a0
                                                idn = 1
                                            }
                                        }
                                    }
                                    IfCondition EqualTo(idn, 1) ThenBlock: {
                                        step = StringToNumber(AST_GetData1(num))
                                        IfCondition GreaterThan(step, 0) ThenBlock: { ok = 1 }
                                    }
                                }
                            }
                        }
                    }
                    IfCondition EqualTo(ok, 0) ThenBlock: {
                        LoopHome.iv_step = 0
                        ReturnValue(0)
                    }
                    LoopHome.iv_step = step
                    LoopHome.iv_at = i
                    found = 1
                }
            }
            i = Add(i, 1)
        }
        IfCondition EqualTo(found, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(Optimize_AssignCount(body, LoopHome.int_name), 1) ThenBlock: {
            LoopHome.iv_step = 0
            LoopHome.iv_at = -1
            ReturnValue(0)
        }
        ReturnValue(1)
    }
}

// The statement immediately before this loop assigns the cursor a
// non-negative constant. That is the value the body sees on entry.
Function.Optimize_InitAssign {
    Input: node: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(Optimize_PlainAssign(node), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_NameEq(AST_GetData1(node), LoopHome.int_name), 0) ThenBlock: { ReturnValue(0) }
        val = AST_GetChild(node, 0)
        IfCondition EqualTo(val, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(val), AST.NUMBER) ThenBlock: { ReturnValue(0) }
        n = StringToNumber(AST_GetData1(val))
        IfCondition LessThan(n, 0) ThenBlock: { ReturnValue(0) }
        LoopHome.iv_lo = n
        ReturnValue(1)
    }
}

// The loop may sit in a function body block or directly under a
// subroutine. Either way the initializer is the previous sibling.
Function.Optimize_SeekInit {
    Input: node: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        count = AST_GetChildCount(node)
        i = 0
        WhileLoop LessThan(i, count) {
            child = AST_GetChild(node, i)
            hit = 0
            IfCondition NotEqual(child, 0) ThenBlock: {
                IfCondition EqualTo(AST_GetType(child), AST.WHILE) ThenBlock: {
                    IfCondition EqualTo(AST_GetChild(child, 1), LoopHome.body) ThenBlock: { hit = 1 }
                }
            }
            IfCondition EqualTo(hit, 1) ThenBlock: {
                IfCondition GreaterThan(i, 0) ThenBlock: {
                    prev = AST_GetChild(node, Subtract(i, 1))
                    ReturnValue(Optimize_InitAssign(prev))
                }
                ReturnValue(0)
            }
            IfCondition EqualTo(Optimize_SeekInit(child), 1) ThenBlock: { ReturnValue(1) }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

// LessThan(cursor, bound) or GreaterThan(bound, cursor).
// Step 1 against an unknown bound stays in [init, 2^63-2].
// A bigger step needs a constant bound that cannot wrap past the test.
Function.Optimize_NoteBound {
    Input: condition: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(condition, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(condition), AST.CALL) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetChildCount(condition), 2) ThenBlock: { ReturnValue(0) }
        cname = AST_GetData1(condition)
        left = AST_GetChild(condition, 0)
        right = AST_GetChild(condition, 1)
        bound = 0
        IfCondition EqualTo(StringCompare(cname, "LessThan"), 0) ThenBlock: {
            IfCondition EqualTo(Optimize_NameIs(left, LoopHome.int_name), 0) ThenBlock: { ReturnValue(0) }
            bound = right
        }
        IfCondition EqualTo(StringCompare(cname, "GreaterThan"), 0) ThenBlock: {
            IfCondition EqualTo(Optimize_NameIs(right, LoopHome.int_name), 0) ThenBlock: { ReturnValue(0) }
            bound = left
        }
        IfCondition EqualTo(bound, 0) ThenBlock: { ReturnValue(0) }
        maxv = 9223372036854775807
        IfCondition EqualTo(AST_GetType(bound), AST.NUMBER) ThenBlock: {
            b = StringToNumber(AST_GetData1(bound))
            IfCondition LessEqual(b, LoopHome.iv_lo) ThenBlock: { ReturnValue(0) }
            hi = Subtract(b, 1)
            room = Subtract(maxv, hi)
            IfCondition GreaterThan(LoopHome.iv_step, room) ThenBlock: { ReturnValue(0) }
            LoopHome.iv_hi = hi
            ReturnValue(1)
        }
        // One straight-line constant assignment is the same bound. A
        // failed bind keeps the step-1 range below, and a larger step
        // stays unproved.
        IfCondition EqualTo(AST_GetType(bound), AST.IDENTIFIER) ThenBlock: {
            got = Optimize_BindConst(AST_GetData1(bound), condition)
            IfCondition EqualTo(got, 1) ThenBlock: {
                cb = OptState.bind_val
                IfCondition LessEqual(cb, LoopHome.iv_lo) ThenBlock: { ReturnValue(0) }
                hi = Subtract(cb, 1)
                room = Subtract(maxv, hi)
                IfCondition GreaterThan(LoopHome.iv_step, room) ThenBlock: { ReturnValue(0) }
                LoopHome.iv_hi = hi
                ReturnValue(1)
            }
        }
        IfCondition NotEqual(LoopHome.iv_step, 1) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterThan(LoopHome.iv_lo, Subtract(maxv, 1)) ThenBlock: { ReturnValue(0) }
        LoopHome.iv_hi = Subtract(maxv, 1)
        ReturnValue(1)
    }
}

Function.Optimize_NoteIv {
    Input: condition: Address
    Input: body: Address
    Output: Integer
    Body: {
        LoopHome.iv_nn = 0
        IfCondition EqualTo(LoopHome.has_call, 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(LoopHome.int_name, 0) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(LoopHome.iv_step, 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_TreeHasAsm(body), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_TreeHasAsm(condition), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Compile.current_func, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_SeekInit(Compile.current_func), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_NoteBound(condition), 0) ThenBlock: { ReturnValue(0) }
        LoopHome.iv_nn = 1
        ReturnValue(1)
    }
}

// Uses of the derived name must see the value assigned this iteration,
// which is before the cursor update. A use after that update still has
// the old sum, so the running register would be wrong.
Function.Optimize_DerUsesOk {
    Input: body: Address
    Input: name: Address
    Input: def_at: Integer
    Input: upd_at: Integer
    Output: Integer
    Body: {
        count = AST_GetChildCount(body)
        k = 0
        WhileLoop LessThan(k, count) {
            st = AST_GetChild(body, k)
            n = Optimize_CountIdents(st, name)
            IfCondition LessThan(k, def_at) ThenBlock: {
                IfCondition GreaterThan(n, 0) ThenBlock: { ReturnValue(0) }
            }
            IfCondition EqualTo(k, def_at) ThenBlock: {
                IfCondition GreaterThan(n, 0) ThenBlock: { ReturnValue(0) }
            }
            IfCondition GreaterThan(k, upd_at) ThenBlock: {
                IfCondition GreaterThan(n, 0) ThenBlock: { ReturnValue(0) }
            }
            IfCondition EqualTo(k, upd_at) ThenBlock: {
                IfCondition GreaterThan(n, 0) ThenBlock: { ReturnValue(0) }
            }
            k = Add(k, 1)
        }
        ReturnValue(1)
    }
}

// One direct `name = inv + cursor` whose other reads all sit between
// that assignment and the cursor's step. Nothing outside the loop reads it.
Function.Optimize_DerivedTry {
    Input: st: Address
    Input: body: Address
    Input: def_at: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(Optimize_PlainAssign(st), 0) ThenBlock: { ReturnValue(0) }
        target = AST_GetData1(st)
        IfCondition EqualTo(Optimize_NameEq(target, LoopHome.int_name), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_NameTaken(target), 1) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterEqual(def_at, LoopHome.iv_at) ThenBlock: { ReturnValue(0) }
        val = AST_GetChild(st, 0)
        IfCondition EqualTo(val, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(val), AST.CALL) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(StringCompare(AST_GetData1(val), "Add"), 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetChildCount(val), 2) ThenBlock: { ReturnValue(0) }
        a0 = AST_GetChild(val, 0)
        a1 = AST_GetChild(val, 1)
        other = 0
        IfCondition EqualTo(Optimize_NameIs(a0, LoopHome.int_name), 1) ThenBlock: {
            IfCondition EqualTo(Optimize_IsBase(a1), 1) ThenBlock: {
                IfCondition EqualTo(Optimize_NameIs(a1, LoopHome.int_name), 0) ThenBlock: { other = a1 }
            }
        }
        IfCondition EqualTo(other, 0) ThenBlock: {
            IfCondition EqualTo(Optimize_NameIs(a1, LoopHome.int_name), 1) ThenBlock: {
                IfCondition EqualTo(Optimize_IsBase(a0), 1) ThenBlock: {
                    IfCondition EqualTo(Optimize_NameIs(a0, LoopHome.int_name), 0) ThenBlock: { other = a0 }
                }
            }
        }
        IfCondition EqualTo(other, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_Fit32(LoopHome.iv_step), 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(Optimize_AssignCount(body, target), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_DerUsesOk(body, target, def_at, LoopHome.iv_at), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Compile.current_func, 0) ThenBlock: { ReturnValue(0) }
        block_n = Optimize_Mentions(body, target)
        func_n = Optimize_Mentions(Compile.current_func, target)
        IfCondition NotEqual(block_n, func_n) ThenBlock: { ReturnValue(0) }
        via = 0
        konst = 0
        off = 0
        IfCondition EqualTo(AST_GetType(other), AST.NUMBER) ThenBlock: {
            via = 1
            konst = StringToNumber(AST_GetData1(other))
        } ElseBlock: {
            oname = AST_GetData1(other)
            IfCondition EqualTo(Optimize_NameEq(oname, target), 1) ThenBlock: { ReturnValue(0) }
            IfCondition NotEqual(Optimize_AssignCount(body, oname), 0) ThenBlock: { ReturnValue(0) }
            IfCondition EqualTo(Optimize_NameEq(oname, LoopHome.acc_name), 1) ThenBlock: {
                via = 2
            } ElseBlock: {
                IfCondition EqualTo(Optimize_FrameOff(oname), 0) ThenBlock: { ReturnValue(0) }
                via = 3
                off = LoopHome.imm_val
            }
        }
        IfCondition EqualTo(via, 0) ThenBlock: { ReturnValue(0) }
        LoopHome.der_name = target
        LoopHome.der_via = via
        LoopHome.der_const = konst
        LoopHome.der_off = off
        LoopHome.der_step = LoopHome.iv_step
        LoopHome.der_on = 1
        ReturnValue(1)
    }
}

// ij = inv + j becomes a register that starts at inv+j and steps with j.
// r11 is free only when this loop has no call. The compare stays j < n.
Function.Optimize_PickDerived {
    Input: body: Address
    Output: Integer
    Body: {
        LoopHome.der_on = 0
        IfCondition EqualTo(LoopHome.has_call, 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(LoopHome.int_name, 0) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(LoopHome.iv_step, 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_TreeHasAsm(body), 1) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(body), AST.BLOCK) ThenBlock: { ReturnValue(0) }
        count = AST_GetChildCount(body)
        i = 0
        WhileLoop LessThan(i, count) {
            IfCondition EqualTo(Optimize_DerivedTry(AST_GetChild(body, i), body, i), 1) ThenBlock: {
                ReturnValue(1)
            }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

Function.Optimize_EmitDerived {
    Body: {
        IfCondition EqualTo(LoopHome.der_via, 1) ThenBlock: {
            Emit_MovRaxImm64(LoopHome.der_const)
        }
        IfCondition EqualTo(LoopHome.der_via, 2) ThenBlock: {
            Emit_MovRaxR12()
        }
        IfCondition EqualTo(LoopHome.der_via, 3) ThenBlock: {
            Emit_MovRaxRbpOffset(LoopHome.der_off)
        }
        Emit_AddRaxR13()
        X86Enc_Assemble("MOV r11, rax")
    }
}

// (i + step) * c wraps the same as i * c + step * c. One non-power-of-two
// constant factor of the integer home stays in r11. r11 is free only when
// the derived sum and the induction pointers are not using it, and the
// loop has no call. Power-of-two factors stay shifts. An and-with-1
// product stays the low-bit test, so that whole subtree is left alone.

Function.Optimize_ProdConst {
    Input: node: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        nt = AST_GetType(node)
        val = 0
        ok = 0
        IfCondition EqualTo(nt, AST.NUMBER) ThenBlock: {
            val = StringToNumber(AST_GetData1(node))
            ok = 1
        }
        IfCondition EqualTo(nt, AST.IDENTIFIER) ThenBlock: {
            got = Optimize_BindConst(AST_GetData1(node), node)
            IfCondition EqualTo(got, 1) ThenBlock: {
                val = OptState.bind_val
                ok = 1
            }
        }
        IfCondition EqualTo(ok, 0) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterThan(val, 0) ThenBlock: {
            IfCondition EqualTo(Optimize_IsPow2(val), 1) ThenBlock: { ReturnValue(0) }
        }
        LoopHome.prod_tmp = val
        ReturnValue(1)
    }
}

Function.Optimize_ProdTake {
    Input: node: Address
    Output: Integer
    Body: {
        IfCondition NotEqual(AST_GetChildCount(node), 2) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(LoopHome.prod_bad, 1) ThenBlock: { ReturnValue(0) }
        a0 = AST_GetChild(node, 0)
        a1 = AST_GetChild(node, 1)
        hit = 0
        IfCondition EqualTo(Optimize_NameIs(a0, LoopHome.int_name), 1) ThenBlock: {
            IfCondition EqualTo(Optimize_ProdConst(a1), 1) ThenBlock: { hit = 1 }
        }
        IfCondition EqualTo(hit, 0) ThenBlock: {
            IfCondition EqualTo(Optimize_NameIs(a1, LoopHome.int_name), 1) ThenBlock: {
                IfCondition EqualTo(Optimize_ProdConst(a0), 1) ThenBlock: { hit = 1 }
            }
        }
        IfCondition EqualTo(hit, 0) ThenBlock: { ReturnValue(0) }
        val = LoopHome.prod_tmp
        IfCondition EqualTo(LoopHome.prod_seen, 0) ThenBlock: {
            LoopHome.prod_c = val
            LoopHome.prod_seen = 1
            ReturnValue(1)
        }
        IfCondition NotEqual(val, LoopHome.prod_c) ThenBlock: { LoopHome.prod_bad = 1 }
        ReturnValue(1)
    }
}

Function.Optimize_ProdWalk {
    Input: node: Address
    Input: mute: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(LoopHome.prod_bad, 1) ThenBlock: { ReturnValue(0) }
        nt = AST_GetType(node)
        IfCondition EqualTo(nt, AST.CALL) ThenBlock: {
            cname = AST_GetData1(node)
            IfCondition EqualTo(mute, 0) ThenBlock: {
                IfCondition EqualTo(StringCompare(cname, "Multiply"), 0) ThenBlock: {
                    Optimize_ProdTake(node)
                }
            }
            IfCondition EqualTo(Optimize_IsAndName(cname), 1) ThenBlock: {
                IfCondition EqualTo(AST_GetChildCount(node), 2) ThenBlock: {
                    b0 = AST_GetChild(node, 0)
                    b1 = AST_GetChild(node, 1)
                    inner = 0
                    IfCondition EqualTo(Optimize_IsOneNum(b1), 1) ThenBlock: { inner = b0 }
                    IfCondition EqualTo(inner, 0) ThenBlock: {
                        IfCondition EqualTo(Optimize_IsOneNum(b0), 1) ThenBlock: { inner = b1 }
                    }
                    IfCondition NotEqual(inner, 0) ThenBlock: {
                        Optimize_ProdWalk(inner, 1)
                        ReturnValue(0)
                    }
                }
            }
        }
        count = AST_GetChildCount(node)
        i = 0
        WhileLoop LessThan(i, count) {
            Optimize_ProdWalk(AST_GetChild(node, i), mute)
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

Function.Optimize_NoteProd {
    Output: Integer
    Body: {
        LoopHome.prod_on = 0
        LoopHome.prod_c = 0
        LoopHome.prod_delta = 0
        LoopHome.prod_bad = 0
        LoopHome.prod_seen = 0
        LoopHome.prod_tmp = 0
        IfCondition EqualTo(LoopHome.has_call, 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(LoopHome.int_name, 0) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(LoopHome.iv_step, 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_Fit32(LoopHome.iv_step), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(LoopHome.der_on, 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(LoopHome.ip0_on, 1) ThenBlock: {
            IfCondition EqualTo(LoopHome.ip0_reg, 11) ThenBlock: { ReturnValue(0) }
        }
        IfCondition EqualTo(LoopHome.ip1_on, 1) ThenBlock: {
            IfCondition EqualTo(LoopHome.ip1_reg, 11) ThenBlock: { ReturnValue(0) }
        }
        IfCondition EqualTo(Optimize_TreeHasAsm(LoopHome.body), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_TreeHasAsm(LoopHome.cond), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_LiveIn(LoopHome.int_name, LoopHome.cond, LoopHome.body), 0) ThenBlock: {
            ReturnValue(0)
        }
        Optimize_ProdWalk(LoopHome.body, 0)
        Optimize_ProdWalk(LoopHome.cond, 0)
        IfCondition EqualTo(LoopHome.prod_bad, 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(LoopHome.prod_seen, 0) ThenBlock: { ReturnValue(0) }
        LoopHome.prod_delta = Multiply(LoopHome.iv_step, LoopHome.prod_c)
        LoopHome.prod_on = 1
        ReturnValue(1)
    }
}

Function.Optimize_EmitProd {
    Output: Integer
    Body: {
        IfCondition EqualTo(LoopHome.prod_on, 0) ThenBlock: { ReturnValue(0) }
        Emit_MovRaxR13()
        IfCondition EqualTo(Optimize_Fit32(LoopHome.prod_c), 1) ThenBlock: {
            X86_ImulRaxImm32(LoopHome.prod_c)
        } ElseBlock: {
            Emit_PushRbx()
            Emit_MovRbxImm64(LoopHome.prod_c)
            Emit_ImulRaxRbx()
            Emit_PopRbx()
        }
        X86Enc_Assemble("MOV r11, rax")
        ReturnValue(1)
    }
}

Function.Optimize_EmitProdBump {
    Output: Integer
    Body: {
        IfCondition EqualTo(Optimize_Fit32(LoopHome.prod_delta), 1) ThenBlock: {
            X86_AddIpImm(11, LoopHome.prod_delta)
            ReturnValue(1)
        }
        Emit_MovRaxImm64(LoopHome.prod_delta)
        X86_AddRegReg(11, 0)
        ReturnValue(1)
    }
}

Function.Optimize_TryProdUse {
    Input: left: Address
    Input: right: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(LoopHome.active, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(LoopHome.prod_on, 0) ThenBlock: { ReturnValue(0) }
        hit = 0
        IfCondition EqualTo(Optimize_NameIs(left, LoopHome.int_name), 1) ThenBlock: {
            IfCondition EqualTo(Optimize_ProdConst(right), 1) ThenBlock: { hit = 1 }
        }
        IfCondition EqualTo(hit, 0) ThenBlock: {
            IfCondition EqualTo(Optimize_NameIs(right, LoopHome.int_name), 1) ThenBlock: {
                IfCondition EqualTo(Optimize_ProdConst(left), 1) ThenBlock: { hit = 1 }
            }
        }
        IfCondition EqualTo(hit, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(LoopHome.prod_tmp, LoopHome.prod_c) ThenBlock: { ReturnValue(0) }
        X86Enc_Assemble("MOV rax, r11")
        ReturnValue(1)
    }
}

Function.Optimize_TryDerivedDef {
    Input: target_name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(LoopHome.der_on, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_NameEq(target_name, LoopHome.der_name), 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(1)
    }
}

// An address base + (inv + cursor*coeff)*scale becomes a register that
// starts at that byte address and adds coeff*scale*step when the cursor
// steps. A second address with the same base, coeff, and scale is a
// displacement off that register. r11 is used when the derived sum is
// off. r14 is used when no table home owns it. Both are installed only
// when every dereference in the body joins a pointer, so a leftover
// scaled load cannot overwrite r14. A name read once is movsd from that
// register at the multiply. A name read again before the pointer steps
// stays in a free xmm and is copied into xmm0 or xmm1. Hw.level < 2
// leaves the integer path.

Function.Optimize_IpClear {
    Body: {
        LoopHome.ip0_on = 0
        LoopHome.ip1_on = 0
        LoopHome.ip0_mode = 0
        LoopHome.ip0_rhs = 0
        LoopHome.ip0_aname = 0
        LoopHome.ip1_mode = 0
        LoopHome.ip1_rhs = 0
        LoopHome.ip1_aname = 0
        LoopHome.n0_on = 0
        LoopHome.n1_on = 0
        LoopHome.n2_on = 0
        LoopHome.n3_on = 0
        LoopHome.d0_on = 0
        LoopHome.d1_on = 0
        LoopHome.d2_on = 0
        LoopHome.d3_on = 0
        LoopHome.ip_count = 0
    }
}

Function.Optimize_IpNum {
    Input: node: Address
    Output: Integer
    Body: {
        LoopHome.ip_num_ok = 0
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(node), AST.NUMBER) ThenBlock: { ReturnValue(0) }
        LoopHome.ip_num = StringToNumber(AST_GetData1(node))
        LoopHome.ip_num_ok = 1
        ReturnValue(1)
    }
}

Function.Optimize_IpScaleOk {
    Input: n: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(n, 1) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(n, 2) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(n, 4) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(n, 8) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

Function.Optimize_IpLog {
    Input: n: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(n, 1) ThenBlock: { ReturnValue(0) }
        l = 0
        v = n
        WhileLoop GreaterThan(v, 1) {
            IfCondition EqualTo(BitwiseAnd(v, 1), 1) ThenBlock: { ReturnValue(0) }
            v = Divide(v, 2)
            l = Add(l, 1)
        }
        LoopHome.ip_log = l
        ReturnValue(1)
    }
}

Function.Optimize_IpExprEq {
    Input: a: Address
    Input: b: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(a, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(b, 0) ThenBlock: { ReturnValue(0) }
        ta = AST_GetType(a)
        tb = AST_GetType(b)
        IfCondition NotEqual(ta, tb) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(ta, AST.NUMBER) ThenBlock: {
            IfCondition EqualTo(StringCompare(AST_GetData1(a), AST_GetData1(b)), 0) ThenBlock: { ReturnValue(1) }
            ReturnValue(0)
        }
        IfCondition EqualTo(ta, AST.IDENTIFIER) ThenBlock: {
            ReturnValue(Optimize_NameEq(AST_GetData1(a), AST_GetData1(b)))
        }
        IfCondition NotEqual(ta, AST.CALL) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(StringCompare(AST_GetData1(a), AST_GetData1(b)), 0) ThenBlock: { ReturnValue(0) }
        na = AST_GetChildCount(a)
        nb = AST_GetChildCount(b)
        IfCondition NotEqual(na, nb) ThenBlock: { ReturnValue(0) }
        i = 0
        WhileLoop LessThan(i, na) {
            IfCondition EqualTo(Optimize_IpExprEq(AST_GetChild(a, i), AST_GetChild(b, i)), 0) ThenBlock: { ReturnValue(0) }
            i = Add(i, 1)
        }
        ReturnValue(1)
    }
}

Function.Optimize_IpMulParts {
    Input: node: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(node), AST.CALL) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(StringCompare(AST_GetData1(node), "Multiply"), 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetChildCount(node), 2) ThenBlock: { ReturnValue(0) }
        right = AST_GetChild(node, 1)
        left = AST_GetChild(node, 0)
        IfCondition EqualTo(Optimize_IpNum(right), 1) ThenBlock: {
            LoopHome.ip_mul_k = LoopHome.ip_num
            LoopHome.ip_mul_in = left
            ReturnValue(1)
        }
        IfCondition EqualTo(Optimize_IpNum(left), 1) ThenBlock: {
            LoopHome.ip_mul_k = LoopHome.ip_num
            LoopHome.ip_mul_in = right
            ReturnValue(1)
        }
        ReturnValue(0)
    }
}

// ip_delta is the constant c where node = anchor + c. Identifiers must match.
Function.Optimize_IpDelta {
    Input: node: Address
    Input: anchor: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: {
            IfCondition EqualTo(anchor, 0) ThenBlock: {
                LoopHome.ip_delta = 0
                ReturnValue(1)
            }
            ReturnValue(0)
        }
        IfCondition NotEqual(anchor, 0) ThenBlock: {
            IfCondition EqualTo(Optimize_IpExprEq(node, anchor), 1) ThenBlock: {
                LoopHome.ip_delta = 0
                ReturnValue(1)
            }
        }
        IfCondition EqualTo(AST_GetType(node), AST.CALL) ThenBlock: {
            IfCondition EqualTo(StringCompare(AST_GetData1(node), "Add"), 0) ThenBlock: {
                IfCondition EqualTo(AST_GetChildCount(node), 2) ThenBlock: {
                    left = AST_GetChild(node, 0)
                    right = AST_GetChild(node, 1)
                    IfCondition EqualTo(Optimize_IpNum(right), 1) ThenBlock: {
                        n = LoopHome.ip_num
                        IfCondition EqualTo(Optimize_IpDelta(left, anchor), 1) ThenBlock: {
                            LoopHome.ip_delta = Add(LoopHome.ip_delta, n)
                            ReturnValue(1)
                        }
                    }
                    IfCondition EqualTo(Optimize_IpNum(left), 1) ThenBlock: {
                        n = LoopHome.ip_num
                        IfCondition EqualTo(Optimize_IpDelta(right, anchor), 1) ThenBlock: {
                            LoopHome.ip_delta = Add(LoopHome.ip_delta, n)
                            ReturnValue(1)
                        }
                    }
                }
            }
        }
        IfCondition NotEqual(anchor, 0) ThenBlock: {
            IfCondition EqualTo(AST_GetType(anchor), AST.CALL) ThenBlock: {
                IfCondition EqualTo(StringCompare(AST_GetData1(anchor), "Add"), 0) ThenBlock: {
                    IfCondition EqualTo(AST_GetChildCount(anchor), 2) ThenBlock: {
                        left = AST_GetChild(anchor, 0)
                        right = AST_GetChild(anchor, 1)
                        IfCondition EqualTo(Optimize_IpNum(right), 1) ThenBlock: {
                            n = LoopHome.ip_num
                            IfCondition EqualTo(Optimize_IpDelta(node, left), 1) ThenBlock: {
                                LoopHome.ip_delta = Subtract(LoopHome.ip_delta, n)
                                ReturnValue(1)
                            }
                        }
                        IfCondition EqualTo(Optimize_IpNum(left), 1) ThenBlock: {
                            n = LoopHome.ip_num
                            IfCondition EqualTo(Optimize_IpDelta(node, right), 1) ThenBlock: {
                                LoopHome.ip_delta = Subtract(LoopHome.ip_delta, n)
                                ReturnValue(1)
                            }
                        }
                    }
                }
            }
        }
        IfCondition EqualTo(Optimize_IpMulParts(node), 1) ThenBlock: {
            inn = LoopHome.ip_mul_in
            mk = LoopHome.ip_mul_k
            IfCondition EqualTo(Optimize_IpMulParts(anchor), 1) ThenBlock: {
                ina = LoopHome.ip_mul_in
                ma = LoopHome.ip_mul_k
                IfCondition EqualTo(mk, ma) ThenBlock: {
                    IfCondition EqualTo(Optimize_IpDelta(inn, ina), 1) ThenBlock: {
                        LoopHome.ip_delta = Multiply(LoopHome.ip_delta, mk)
                        ReturnValue(1)
                    }
                }
            }
        }
        ReturnValue(0)
    }
}

Function.Optimize_IpRhs {
    Input: name: Address
    Output: Address
    Body: {
        body = LoopHome.body
        IfCondition EqualTo(body, 0) ThenBlock: { ReturnValue(0) }
        count = AST_GetChildCount(body)
        i = 0
        WhileLoop LessThan(i, count) {
            st = AST_GetChild(body, i)
            IfCondition EqualTo(Optimize_PlainAssign(st), 1) ThenBlock: {
                IfCondition EqualTo(Optimize_NameEq(AST_GetData1(st), name), 1) ThenBlock: {
                    ReturnValue(AST_GetChild(st, 0))
                }
            }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

Function.Optimize_IpInvOk {
    Input: node: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(1) }
        nt = AST_GetType(node)
        IfCondition EqualTo(nt, AST.NUMBER) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(nt, AST.IDENTIFIER) ThenBlock: {
            name = AST_GetData1(node)
            IfCondition EqualTo(Optimize_NameEq(name, LoopHome.int_name), 1) ThenBlock: { ReturnValue(0) }
            IfCondition NotEqual(Optimize_AssignCount(LoopHome.body, name), 0) ThenBlock: { ReturnValue(0) }
            ReturnValue(1)
        }
        IfCondition NotEqual(nt, AST.CALL) ThenBlock: { ReturnValue(0) }
        count = AST_GetChildCount(node)
        i = 0
        WhileLoop LessThan(i, count) {
            IfCondition EqualTo(Optimize_IpInvOk(AST_GetChild(node, i)), 0) ThenBlock: { ReturnValue(0) }
            i = Add(i, 1)
        }
        ReturnValue(1)
    }
}

// Index = cursor*coeff + inv + add. inv is an expression node, or 0.
Function.Optimize_IpIndex {
    Input: node: Address
    Input: depth: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterThan(depth, 6) ThenBlock: { ReturnValue(0) }
        nt = AST_GetType(node)
        IfCondition EqualTo(nt, AST.IDENTIFIER) ThenBlock: {
            name = AST_GetData1(node)
            IfCondition EqualTo(Optimize_NameEq(name, LoopHome.int_name), 1) ThenBlock: {
                LoopHome.ip_coeff = 1
                LoopHome.ip_inv = 0
                LoopHome.ip_add = 0
                ReturnValue(1)
            }
            IfCondition GreaterThan(depth, 4) ThenBlock: { ReturnValue(0) }
            IfCondition NotEqual(Optimize_AssignCount(LoopHome.body, name), 1) ThenBlock: { ReturnValue(0) }
            rhs = Optimize_IpRhs(name)
            IfCondition EqualTo(rhs, 0) ThenBlock: { ReturnValue(0) }
            ReturnValue(Optimize_IpIndex(rhs, Add(depth, 1)))
        }
        IfCondition NotEqual(nt, AST.CALL) ThenBlock: { ReturnValue(0) }
        op = AST_GetData1(node)
        IfCondition NotEqual(AST_GetChildCount(node), 2) ThenBlock: { ReturnValue(0) }
        left = AST_GetChild(node, 0)
        right = AST_GetChild(node, 1)
        IfCondition EqualTo(StringCompare(op, "Multiply"), 0) ThenBlock: {
            IfCondition EqualTo(Optimize_IpNum(right), 1) ThenBlock: {
                n = LoopHome.ip_num
                IfCondition EqualTo(Optimize_NameIs(left, LoopHome.int_name), 1) ThenBlock: {
                    LoopHome.ip_coeff = n
                    LoopHome.ip_inv = 0
                    LoopHome.ip_add = 0
                    ReturnValue(1)
                }
                IfCondition EqualTo(Optimize_IpIndex(left, Add(depth, 1)), 1) ThenBlock: {
                    IfCondition NotEqual(LoopHome.ip_inv, 0) ThenBlock: { ReturnValue(0) }
                    LoopHome.ip_coeff = Multiply(LoopHome.ip_coeff, n)
                    LoopHome.ip_add = Multiply(LoopHome.ip_add, n)
                    ReturnValue(1)
                }
            }
            IfCondition EqualTo(Optimize_IpNum(left), 1) ThenBlock: {
                n = LoopHome.ip_num
                IfCondition EqualTo(Optimize_NameIs(right, LoopHome.int_name), 1) ThenBlock: {
                    LoopHome.ip_coeff = n
                    LoopHome.ip_inv = 0
                    LoopHome.ip_add = 0
                    ReturnValue(1)
                }
                IfCondition EqualTo(Optimize_IpIndex(right, Add(depth, 1)), 1) ThenBlock: {
                    IfCondition NotEqual(LoopHome.ip_inv, 0) ThenBlock: { ReturnValue(0) }
                    LoopHome.ip_coeff = Multiply(LoopHome.ip_coeff, n)
                    LoopHome.ip_add = Multiply(LoopHome.ip_add, n)
                    ReturnValue(1)
                }
            }
            ReturnValue(0)
        }
        IfCondition NotEqual(StringCompare(op, "Add"), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_IpNum(right), 1) ThenBlock: {
            n = LoopHome.ip_num
            IfCondition EqualTo(Optimize_IpIndex(left, Add(depth, 1)), 0) ThenBlock: { ReturnValue(0) }
            LoopHome.ip_add = Add(LoopHome.ip_add, n)
            ReturnValue(1)
        }
        IfCondition EqualTo(Optimize_IpNum(left), 1) ThenBlock: {
            n = LoopHome.ip_num
            IfCondition EqualTo(Optimize_IpIndex(right, Add(depth, 1)), 0) ThenBlock: { ReturnValue(0) }
            LoopHome.ip_add = Add(LoopHome.ip_add, n)
            ReturnValue(1)
        }
        got = 0
        IfCondition EqualTo(Optimize_CountIdents(right, LoopHome.int_name), 0) ThenBlock: {
            IfCondition EqualTo(Optimize_IpIndex(left, Add(depth, 1)), 1) ThenBlock: {
                IfCondition EqualTo(LoopHome.ip_inv, 0) ThenBlock: {
                    IfCondition EqualTo(Optimize_IpInvOk(right), 1) ThenBlock: {
                        LoopHome.ip_inv = right
                        got = 1
                    }
                }
            }
        }
        IfCondition EqualTo(got, 0) ThenBlock: {
            IfCondition EqualTo(Optimize_CountIdents(left, LoopHome.int_name), 0) ThenBlock: {
                IfCondition EqualTo(Optimize_IpIndex(right, Add(depth, 1)), 1) ThenBlock: {
                    IfCondition EqualTo(LoopHome.ip_inv, 0) ThenBlock: {
                        IfCondition EqualTo(Optimize_IpInvOk(left), 1) ThenBlock: {
                            LoopHome.ip_inv = left
                            got = 1
                        }
                    }
                }
            }
        }
        ReturnValue(got)
    }
}

// Sets ip_base, ip_coeff, ip_scale, ip_inv, ip_add, ip_via, ip_boff.
Function.Optimize_IpAddrSides {
    Input: base: Address
    Input: idx: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(base, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(base), AST.IDENTIFIER) ThenBlock: { ReturnValue(0) }
        bname = AST_GetData1(base)
        IfCondition EqualTo(Optimize_NameEq(bname, LoopHome.int_name), 1) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(Optimize_AssignCount(LoopHome.body, bname), 0) ThenBlock: { ReturnValue(0) }
        via = 0
        boff = 0
        IfCondition EqualTo(Optimize_NameEq(bname, LoopHome.acc_name), 1) ThenBlock: {
            via = 2
        } ElseBlock: {
            IfCondition EqualTo(Optimize_FrameOff(bname), 0) ThenBlock: { ReturnValue(0) }
            via = 3
            boff = LoopHome.imm_val
        }
        scale = 1
        index = idx
        IfCondition EqualTo(AST_GetType(idx), AST.CALL) ThenBlock: {
            IfCondition EqualTo(StringCompare(AST_GetData1(idx), "Multiply"), 0) ThenBlock: {
                IfCondition EqualTo(AST_GetChildCount(idx), 2) ThenBlock: {
                    left = AST_GetChild(idx, 0)
                    right = AST_GetChild(idx, 1)
                    took = 0
                    IfCondition EqualTo(Optimize_IpNum(right), 1) ThenBlock: {
                        IfCondition EqualTo(Optimize_IpScaleOk(LoopHome.ip_num), 1) ThenBlock: {
                            scale = LoopHome.ip_num
                            index = left
                            took = 1
                        }
                    }
                    IfCondition EqualTo(took, 0) ThenBlock: {
                        IfCondition EqualTo(Optimize_IpNum(left), 1) ThenBlock: {
                            IfCondition EqualTo(Optimize_IpScaleOk(LoopHome.ip_num), 1) ThenBlock: {
                                scale = LoopHome.ip_num
                                index = right
                                took = 1
                            }
                        }
                    }
                    IfCondition EqualTo(took, 0) ThenBlock: { ReturnValue(0) }
                }
            }
        }
        IfCondition EqualTo(Optimize_IpIndex(index, 0), 0) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(LoopHome.ip_coeff, 1) ThenBlock: { ReturnValue(0) }
        LoopHome.ip_base = bname
        LoopHome.ip_scale = scale
        LoopHome.ip_via = via
        LoopHome.ip_boff = boff
        ReturnValue(1)
    }
}

Function.Optimize_IpAddr {
    Input: node: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(node), AST.CALL) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(StringCompare(AST_GetData1(node), "Dereference"), 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetChildCount(node), 1) ThenBlock: { ReturnValue(0) }
        addr = AST_GetChild(node, 0)
        IfCondition EqualTo(addr, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(addr), AST.CALL) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(StringCompare(AST_GetData1(addr), "Add"), 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetChildCount(addr), 2) ThenBlock: { ReturnValue(0) }
        left = AST_GetChild(addr, 0)
        right = AST_GetChild(addr, 1)
        IfCondition EqualTo(Optimize_IpAddrSides(left, right), 1) ThenBlock: { ReturnValue(1) }
        ReturnValue(Optimize_IpAddrSides(right, left))
    }
}

Function.Optimize_IpIsFlt {
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(Optimize_NameEq(name, LoopHome.flt_name), 1) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(Optimize_NameEq(name, LoopHome.f2_name), 1) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(Optimize_NameEq(name, LoopHome.f3_name), 1) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(Optimize_NameEq(name, LoopHome.f4_name), 1) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(Optimize_NameEq(name, LoopHome.f5_name), 1) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(Optimize_NameEq(name, LoopHome.f6_name), 1) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(Optimize_XfHas(name), 1) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

Function.Optimize_IpUseStmt {
    Input: st: Address
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(Optimize_PlainAssign(st), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_IpIsFlt(AST_GetData1(st)), 0) ThenBlock: { ReturnValue(0) }
        val = AST_GetChild(st, 0)
        IfCondition EqualTo(val, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(val), AST.CALL) ThenBlock: { ReturnValue(0) }
        opname = AST_GetData1(val)
        is_sub = 0
        is_add = 0
        IfCondition EqualTo(StringCompare(opname, "Float_Add"), 0) ThenBlock: { is_add = 1 }
        IfCondition EqualTo(StringCompare(opname, "Float_Sub"), 0) ThenBlock: { is_sub = 1 }
        IfCondition EqualTo(is_add, 0) ThenBlock: {
            IfCondition EqualTo(is_sub, 0) ThenBlock: { ReturnValue(0) }
        }
        IfCondition NotEqual(AST_GetChildCount(val), 2) ThenBlock: { ReturnValue(0) }
        left = AST_GetChild(val, 0)
        right = AST_GetChild(val, 1)
        mul = 0
        home = 0
        IfCondition EqualTo(is_sub, 1) ThenBlock: {
            IfCondition EqualTo(Optimize_IdentEq(left, AST_GetData1(st)), 0) ThenBlock: { ReturnValue(0) }
            IfCondition EqualTo(Optimize_IsFloatMul(right), 0) ThenBlock: { ReturnValue(0) }
            mul = right
            home = left
        }
        IfCondition EqualTo(is_add, 1) ThenBlock: {
            IfCondition EqualTo(Optimize_IdentEq(left, AST_GetData1(st)), 1) ThenBlock: {
                IfCondition EqualTo(Optimize_IsFloatMul(right), 1) ThenBlock: {
                    mul = right
                    home = left
                }
            }
            IfCondition EqualTo(Optimize_IdentEq(right, AST_GetData1(st)), 1) ThenBlock: {
                IfCondition EqualTo(Optimize_IsFloatMul(left), 1) ThenBlock: {
                    mul = left
                    home = right
                }
            }
        }
        IfCondition EqualTo(mul, 0) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterThan(Optimize_CountIdents(home, name), 0) ThenBlock: { ReturnValue(0) }
        vn = Optimize_CountIdents(val, name)
        mn = Optimize_CountIdents(mul, name)
        IfCondition NotEqual(vn, mn) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(mn, 1) ThenBlock: { ReturnValue(0) }
        ReturnValue(1)
    }
}

Function.Optimize_IpUsesOk {
    Input: name: Address
    Input: def_at: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_NameEq(name, LoopHome.int_name), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_IpIsFlt(name), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_NameEq(name, LoopHome.acc_name), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_NameEq(name, LoopHome.der_name), 1) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(Optimize_AssignCount(LoopHome.body, name), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Compile.current_func, 0) ThenBlock: { ReturnValue(0) }
        block_n = Optimize_Mentions(LoopHome.body, name)
        func_n = Optimize_Mentions(Compile.current_func, name)
        IfCondition NotEqual(block_n, func_n) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(block_n, 2) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterEqual(def_at, LoopHome.iv_at) ThenBlock: { ReturnValue(0) }
        count = AST_GetChildCount(LoopHome.body)
        k = 0
        WhileLoop LessThan(k, count) {
            st = AST_GetChild(LoopHome.body, k)
            n = Optimize_CountIdents(st, name)
            IfCondition EqualTo(k, def_at) ThenBlock: {
                IfCondition NotEqual(n, 0) ThenBlock: { ReturnValue(0) }
            }
            IfCondition LessThan(k, def_at) ThenBlock: {
                IfCondition GreaterThan(n, 0) ThenBlock: { ReturnValue(0) }
            }
            IfCondition GreaterEqual(k, LoopHome.iv_at) ThenBlock: {
                IfCondition GreaterThan(n, 0) ThenBlock: { ReturnValue(0) }
            }
            IfCondition GreaterThan(k, def_at) ThenBlock: {
                IfCondition LessThan(k, LoopHome.iv_at) ThenBlock: {
                    IfCondition GreaterThan(n, 0) ThenBlock: {
                        IfCondition EqualTo(Optimize_IpUseStmt(st, name), 0) ThenBlock: { ReturnValue(0) }
                    }
                }
            }
            k = Add(k, 1)
        }
        ReturnValue(1)
    }
}

Function.Optimize_IpTakeReg {
    Output: Integer
    Body: {
        used11 = 0
        used14 = 0
        IfCondition EqualTo(LoopHome.ip0_on, 1) ThenBlock: {
            IfCondition EqualTo(LoopHome.ip0_reg, 11) ThenBlock: { used11 = 1 }
            IfCondition EqualTo(LoopHome.ip0_reg, 14) ThenBlock: { used14 = 1 }
        }
        IfCondition EqualTo(LoopHome.ip1_on, 1) ThenBlock: {
            IfCondition EqualTo(LoopHome.ip1_reg, 11) ThenBlock: { used11 = 1 }
            IfCondition EqualTo(LoopHome.ip1_reg, 14) ThenBlock: { used14 = 1 }
        }
        IfCondition EqualTo(used11, 0) ThenBlock: {
            IfCondition EqualTo(LoopHome.der_on, 0) ThenBlock: { ReturnValue(11) }
        }
        IfCondition EqualTo(used14, 0) ThenBlock: {
            IfCondition EqualTo(LoopHome.tab_on, 0) ThenBlock: { ReturnValue(14) }
        }
        ReturnValue(0)
    }
}

Function.Optimize_IpNameFree {
    Output: Integer
    Body: {
        IfCondition EqualTo(LoopHome.n0_on, 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(LoopHome.n1_on, 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(LoopHome.n2_on, 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(LoopHome.n3_on, 0) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

Function.Optimize_IpNote {
    Input: name: Address
    Input: reg: Integer
    Input: disp: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(LoopHome.n0_on, 0) ThenBlock: {
            LoopHome.n0_on = 1
            LoopHome.n0_name = name
            LoopHome.n0_reg = reg
            LoopHome.n0_disp = disp
            ReturnValue(1)
        }
        IfCondition EqualTo(LoopHome.n1_on, 0) ThenBlock: {
            LoopHome.n1_on = 1
            LoopHome.n1_name = name
            LoopHome.n1_reg = reg
            LoopHome.n1_disp = disp
            ReturnValue(1)
        }
        IfCondition EqualTo(LoopHome.n2_on, 0) ThenBlock: {
            LoopHome.n2_on = 1
            LoopHome.n2_name = name
            LoopHome.n2_reg = reg
            LoopHome.n2_disp = disp
            ReturnValue(1)
        }
        IfCondition EqualTo(LoopHome.n3_on, 0) ThenBlock: {
            LoopHome.n3_on = 1
            LoopHome.n3_name = name
            LoopHome.n3_reg = reg
            LoopHome.n3_disp = disp
            ReturnValue(1)
        }
        ReturnValue(0)
    }
}

Function.Optimize_IpCommit {
    Input: name: Address
    Output: Integer
    Body: {
        base = LoopHome.ip_base
        coeff = LoopHome.ip_coeff
        scale = LoopHome.ip_scale
        inv = LoopHome.ip_inv
        addk = LoopHome.ip_add
        via = LoopHome.ip_via
        boff = LoopHome.ip_boff
        IfCondition LessThan(coeff, 1) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterThan(coeff, 1048576) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterThan(LoopHome.iv_step, 1048576) ThenBlock: { ReturnValue(0) }
        bump = Multiply(Multiply(coeff, scale), LoopHome.iv_step)
        IfCondition LessThan(bump, 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_Fit32(bump), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_Fit32(addk), 0) ThenBlock: { ReturnValue(0) }
        slot = -1
        IfCondition EqualTo(LoopHome.ip0_on, 1) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(base, LoopHome.ip0_base), 1) ThenBlock: {
                IfCondition EqualTo(coeff, LoopHome.ip0_coeff) ThenBlock: {
                    IfCondition EqualTo(scale, LoopHome.ip0_scale) ThenBlock: { slot = 0 }
                }
            }
        }
        IfCondition EqualTo(slot, -1) ThenBlock: {
            IfCondition EqualTo(LoopHome.ip1_on, 1) ThenBlock: {
                IfCondition EqualTo(Optimize_NameEq(base, LoopHome.ip1_base), 1) ThenBlock: {
                    IfCondition EqualTo(coeff, LoopHome.ip1_coeff) ThenBlock: {
                        IfCondition EqualTo(scale, LoopHome.ip1_scale) ThenBlock: { slot = 1 }
                    }
                }
            }
        }
        disp = 0
        reg = 0
        IfCondition EqualTo(slot, -1) ThenBlock: {
            IfCondition NotEqual(name, 0) ThenBlock: {
                IfCondition EqualTo(Optimize_IpNameFree(), 0) ThenBlock: { ReturnValue(0) }
            }
            reg = Optimize_IpTakeReg()
            IfCondition EqualTo(reg, 0) ThenBlock: { ReturnValue(0) }
            IfCondition EqualTo(LoopHome.ip0_on, 0) ThenBlock: {
                LoopHome.ip0_on = 1
                LoopHome.ip0_reg = reg
                LoopHome.ip0_bump = bump
                LoopHome.ip0_base = base
                LoopHome.ip0_coeff = coeff
                LoopHome.ip0_scale = scale
                LoopHome.ip0_inv = inv
                LoopHome.ip0_add = addk
                LoopHome.ip0_via = via
                LoopHome.ip0_boff = boff
                slot = 0
            } ElseBlock: {
                IfCondition EqualTo(LoopHome.ip1_on, 0) ThenBlock: {
                    LoopHome.ip1_on = 1
                    LoopHome.ip1_reg = reg
                    LoopHome.ip1_bump = bump
                    LoopHome.ip1_base = base
                    LoopHome.ip1_coeff = coeff
                    LoopHome.ip1_scale = scale
                    LoopHome.ip1_inv = inv
                    LoopHome.ip1_add = addk
                    LoopHome.ip1_via = via
                    LoopHome.ip1_boff = boff
                    slot = 1
                } ElseBlock: {
                    ReturnValue(0)
                }
            }
            disp = 0
        } ElseBlock: {
            anch = LoopHome.ip0_inv
            aadd = LoopHome.ip0_add
            reg = LoopHome.ip0_reg
            IfCondition EqualTo(slot, 1) ThenBlock: {
                anch = LoopHome.ip1_inv
                aadd = LoopHome.ip1_add
                reg = LoopHome.ip1_reg
            }
            IfCondition EqualTo(Optimize_IpDelta(inv, anch), 0) ThenBlock: { ReturnValue(0) }
            d = Add(LoopHome.ip_delta, Subtract(addk, aadd))
            disp = Multiply(d, scale)
            IfCondition EqualTo(Optimize_Fit32(disp), 0) ThenBlock: { ReturnValue(0) }
            IfCondition NotEqual(name, 0) ThenBlock: {
                IfCondition EqualTo(Optimize_IpNameFree(), 0) ThenBlock: { ReturnValue(0) }
            }
        }
        IfCondition EqualTo(Optimize_IpNote(name, reg, disp), 0) ThenBlock: { ReturnValue(0) }
        LoopHome.ip_count = Add(LoopHome.ip_count, 1)
        ReturnValue(1)
    }
}

Function.Optimize_IpCountDeref {
    Input: node: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        n = 0
        IfCondition EqualTo(AST_GetType(node), AST.CALL) ThenBlock: {
            IfCondition EqualTo(StringCompare(AST_GetData1(node), "Dereference"), 0) ThenBlock: { n = 1 }
        }
        count = AST_GetChildCount(node)
        i = 0
        WhileLoop LessThan(i, count) {
            n = Add(n, Optimize_IpCountDeref(AST_GetChild(node, i)))
            i = Add(i, 1)
        }
        ReturnValue(n)
    }
}

Function.Optimize_IpScanFactor {
    Input: node: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(node), AST.CALL) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(StringCompare(AST_GetData1(node), "Dereference"), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_IpAddr(node), 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(Optimize_IpCommit(0))
    }
}

Function.Optimize_IpScanFma {
    Input: st: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(Optimize_PlainAssign(st), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_IpIsFlt(AST_GetData1(st)), 0) ThenBlock: { ReturnValue(0) }
        val = AST_GetChild(st, 0)
        IfCondition EqualTo(val, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(val), AST.CALL) ThenBlock: { ReturnValue(0) }
        opname = AST_GetData1(val)
        is_sub = 0
        is_add = 0
        IfCondition EqualTo(StringCompare(opname, "Float_Add"), 0) ThenBlock: { is_add = 1 }
        IfCondition EqualTo(StringCompare(opname, "Float_Sub"), 0) ThenBlock: { is_sub = 1 }
        IfCondition EqualTo(is_add, 0) ThenBlock: {
            IfCondition EqualTo(is_sub, 0) ThenBlock: { ReturnValue(0) }
        }
        IfCondition NotEqual(AST_GetChildCount(val), 2) ThenBlock: { ReturnValue(0) }
        left = AST_GetChild(val, 0)
        right = AST_GetChild(val, 1)
        mul = 0
        IfCondition EqualTo(is_sub, 1) ThenBlock: {
            IfCondition EqualTo(Optimize_IsFloatMul(right), 1) ThenBlock: { mul = right }
        }
        IfCondition EqualTo(is_add, 1) ThenBlock: {
            IfCondition EqualTo(Optimize_IsFloatMul(right), 1) ThenBlock: { mul = right }
            IfCondition EqualTo(Optimize_IsFloatMul(left), 1) ThenBlock: { mul = left }
        }
        IfCondition EqualTo(mul, 0) ThenBlock: { ReturnValue(0) }
        Optimize_IpScanFactor(AST_GetChild(mul, 0))
        Optimize_IpScanFactor(AST_GetChild(mul, 1))
        ReturnValue(0)
    }
}

// A dereference this loop already owns covers every read inside it.
// A matching dereference is not walked again: the pointer is built from
// the cursor, so those reads are never executed. A bare identifier is a
// real use and keeps the store.
Function.Optimize_IpCovered {
    Input: node: Address
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(Optimize_CountIdents(node, name), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(AST_GetType(node), AST.CALL) ThenBlock: {
            IfCondition EqualTo(StringCompare(AST_GetData1(node), "Dereference"), 0) ThenBlock: {
                IfCondition EqualTo(Optimize_IpMatch(node), 1) ThenBlock: { ReturnValue(1) }
                ReturnValue(0)
            }
        }
        IfCondition EqualTo(AST_GetType(node), AST.IDENTIFIER) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(AST_GetData1(node), name), 1) ThenBlock: { ReturnValue(0) }
        }
        count = AST_GetChildCount(node)
        i = 0
        WhileLoop LessThan(i, count) {
            IfCondition EqualTo(Optimize_IpCovered(AST_GetChild(node, i), name), 0) ThenBlock: { ReturnValue(0) }
            i = Add(i, 1)
        }
        ReturnValue(1)
    }
}

Function.Optimize_IpIsNoted {
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(LoopHome.n0_on, 1) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(name, LoopHome.n0_name), 1) ThenBlock: { ReturnValue(1) }
        }
        IfCondition EqualTo(LoopHome.n1_on, 1) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(name, LoopHome.n1_name), 1) ThenBlock: { ReturnValue(1) }
        }
        IfCondition EqualTo(LoopHome.n2_on, 1) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(name, LoopHome.n2_name), 1) ThenBlock: { ReturnValue(1) }
        }
        IfCondition EqualTo(LoopHome.n3_on, 1) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(name, LoopHome.n3_name), 1) ThenBlock: { ReturnValue(1) }
        }
        ReturnValue(0)
    }
}

// Mentions counts the assignment itself, so two means one real read.
Function.Optimize_IpDropOk {
    Input: name: Address
    Input: def_at: Integer
    Input: condition: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_NameEq(name, LoopHome.int_name), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_IpIsFlt(name), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_NameEq(name, LoopHome.acc_name), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_NameEq(name, LoopHome.der_name), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_IpIsNoted(name), 1) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(Optimize_AssignCount(LoopHome.body, name), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Compile.current_func, 0) ThenBlock: { ReturnValue(0) }
        block_n = Optimize_Mentions(LoopHome.body, name)
        func_n = Optimize_Mentions(Compile.current_func, name)
        IfCondition NotEqual(block_n, func_n) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(block_n, 2) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterEqual(def_at, LoopHome.iv_at) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterThan(Optimize_CountIdents(condition, name), 0) ThenBlock: { ReturnValue(0) }
        st = AST_GetChild(LoopHome.body, def_at)
        IfCondition EqualTo(st, 0) ThenBlock: { ReturnValue(0) }
        val = AST_GetChild(st, 0)
        IfCondition EqualTo(Optimize_PureExpr(val), 0) ThenBlock: { ReturnValue(0) }
        count = AST_GetChildCount(LoopHome.body)
        k = 0
        WhileLoop LessThan(k, count) {
            st = AST_GetChild(LoopHome.body, k)
            n = Optimize_CountIdents(st, name)
            IfCondition LessThan(k, def_at) ThenBlock: {
                IfCondition GreaterThan(n, 0) ThenBlock: { ReturnValue(0) }
            }
            IfCondition GreaterEqual(k, LoopHome.iv_at) ThenBlock: {
                IfCondition GreaterThan(n, 0) ThenBlock: { ReturnValue(0) }
            }
            IfCondition GreaterEqual(k, def_at) ThenBlock: {
                IfCondition LessThan(k, LoopHome.iv_at) ThenBlock: {
                    IfCondition GreaterThan(n, 0) ThenBlock: {
                        IfCondition EqualTo(Optimize_IpCovered(st, name), 0) ThenBlock: { ReturnValue(0) }
                    }
                }
            }
            k = Add(k, 1)
        }
        ReturnValue(1)
    }
}

Function.Optimize_IpDropNote {
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(LoopHome.d0_on, 0) ThenBlock: {
            LoopHome.d0_on = 1
            LoopHome.d0_name = name
            ReturnValue(1)
        }
        IfCondition EqualTo(LoopHome.d1_on, 0) ThenBlock: {
            LoopHome.d1_on = 1
            LoopHome.d1_name = name
            ReturnValue(1)
        }
        IfCondition EqualTo(LoopHome.d2_on, 0) ThenBlock: {
            LoopHome.d2_on = 1
            LoopHome.d2_name = name
            ReturnValue(1)
        }
        IfCondition EqualTo(LoopHome.d3_on, 0) ThenBlock: {
            LoopHome.d3_on = 1
            LoopHome.d3_name = name
            ReturnValue(1)
        }
        ReturnValue(0)
    }
}

// Optional. A full slot leaves that assignment in the loop. Groups stay.
Function.Optimize_IpPickDrops {
    Input: condition: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(LoopHome.ip0_on, 0) ThenBlock: {
            IfCondition EqualTo(LoopHome.ip1_on, 0) ThenBlock: { ReturnValue(0) }
        }
        count = AST_GetChildCount(LoopHome.body)
        i = 0
        WhileLoop LessThan(i, count) {
            st = AST_GetChild(LoopHome.body, i)
            IfCondition EqualTo(Optimize_PlainAssign(st), 1) ThenBlock: {
                name = AST_GetData1(st)
                IfCondition EqualTo(Optimize_IpDropOk(name, i, condition), 1) ThenBlock: {
                    Optimize_IpDropNote(name)
                }
            }
            i = Add(i, 1)
        }
        ReturnValue(1)
    }
}

Function.Optimize_PickIp {
    Input: condition: Address
    Input: body: Address
    Output: Integer
    Body: {
        Optimize_IpClear()
        IfCondition LessThan(Hw.level, 2) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(LoopHome.has_call, 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(LoopHome.int_name, 0) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(LoopHome.iv_step, 1) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(LoopHome.iv_at, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_TreeHasAsm(body), 1) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(body), AST.BLOCK) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterThan(Optimize_IpCountDeref(condition), 0) ThenBlock: { ReturnValue(0) }
        count = AST_GetChildCount(body)
        i = 0
        WhileLoop LessThan(i, count) {
            st = AST_GetChild(body, i)
            took = 0
            IfCondition EqualTo(Optimize_PlainAssign(st), 1) ThenBlock: {
                val = AST_GetChild(st, 0)
                IfCondition NotEqual(val, 0) ThenBlock: {
                    IfCondition EqualTo(AST_GetType(val), AST.CALL) ThenBlock: {
                        IfCondition EqualTo(StringCompare(AST_GetData1(val), "Dereference"), 0) ThenBlock: {
                            IfCondition EqualTo(Optimize_IpUsesOk(AST_GetData1(st), i), 1) ThenBlock: {
                                IfCondition EqualTo(Optimize_IpAddr(val), 1) ThenBlock: {
                                    Optimize_IpCommit(AST_GetData1(st))
                                    took = 1
                                }
                            }
                        }
                    }
                }
            }
            IfCondition EqualTo(took, 0) ThenBlock: {
                Optimize_IpScanFma(st)
            }
            i = Add(i, 1)
        }
        need = Optimize_IpCountDeref(body)
        IfCondition NotEqual(need, LoopHome.ip_count) ThenBlock: {
            Optimize_IpClear()
            ReturnValue(0)
        }
        groups = 0
        IfCondition EqualTo(LoopHome.ip0_on, 1) ThenBlock: { groups = 1 }
        IfCondition EqualTo(LoopHome.ip1_on, 1) ThenBlock: { groups = 1 }
        IfCondition EqualTo(groups, 1) ThenBlock: {
            Optimize_IpPickDrops(condition)
        }
        ReturnValue(1)
    }
}

Function.Optimize_IpMatchName {
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(LoopHome.n0_on, 1) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(name, LoopHome.n0_name), 1) ThenBlock: {
                LoopHome.ip_hit_reg = LoopHome.n0_reg
                LoopHome.ip_hit_disp = LoopHome.n0_disp
                ReturnValue(1)
            }
        }
        IfCondition EqualTo(LoopHome.n1_on, 1) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(name, LoopHome.n1_name), 1) ThenBlock: {
                LoopHome.ip_hit_reg = LoopHome.n1_reg
                LoopHome.ip_hit_disp = LoopHome.n1_disp
                ReturnValue(1)
            }
        }
        IfCondition EqualTo(LoopHome.n2_on, 1) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(name, LoopHome.n2_name), 1) ThenBlock: {
                LoopHome.ip_hit_reg = LoopHome.n2_reg
                LoopHome.ip_hit_disp = LoopHome.n2_disp
                ReturnValue(1)
            }
        }
        IfCondition EqualTo(LoopHome.n3_on, 1) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(name, LoopHome.n3_name), 1) ThenBlock: {
                LoopHome.ip_hit_reg = LoopHome.n3_reg
                LoopHome.ip_hit_disp = LoopHome.n3_disp
                ReturnValue(1)
            }
        }
        ReturnValue(0)
    }
}

Function.Optimize_IpMatchGroup {
    Output: Integer
    Body: {
        base = LoopHome.ip_base
        coeff = LoopHome.ip_coeff
        scale = LoopHome.ip_scale
        inv = LoopHome.ip_inv
        addk = LoopHome.ip_add
        slot = -1
        IfCondition EqualTo(LoopHome.ip0_on, 1) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(base, LoopHome.ip0_base), 1) ThenBlock: {
                IfCondition EqualTo(coeff, LoopHome.ip0_coeff) ThenBlock: {
                    IfCondition EqualTo(scale, LoopHome.ip0_scale) ThenBlock: { slot = 0 }
                }
            }
        }
        IfCondition EqualTo(slot, -1) ThenBlock: {
            IfCondition EqualTo(LoopHome.ip1_on, 1) ThenBlock: {
                IfCondition EqualTo(Optimize_NameEq(base, LoopHome.ip1_base), 1) ThenBlock: {
                    IfCondition EqualTo(coeff, LoopHome.ip1_coeff) ThenBlock: {
                        IfCondition EqualTo(scale, LoopHome.ip1_scale) ThenBlock: { slot = 1 }
                    }
                }
            }
        }
        IfCondition LessThan(slot, 0) ThenBlock: { ReturnValue(0) }
        anch = LoopHome.ip0_inv
        aadd = LoopHome.ip0_add
        reg = LoopHome.ip0_reg
        IfCondition EqualTo(slot, 1) ThenBlock: {
            anch = LoopHome.ip1_inv
            aadd = LoopHome.ip1_add
            reg = LoopHome.ip1_reg
        }
        IfCondition EqualTo(Optimize_IpDelta(inv, anch), 0) ThenBlock: { ReturnValue(0) }
        d = Add(LoopHome.ip_delta, Subtract(addk, aadd))
        disp = Multiply(d, scale)
        IfCondition EqualTo(Optimize_Fit32(disp), 0) ThenBlock: { ReturnValue(0) }
        LoopHome.ip_hit_reg = reg
        LoopHome.ip_hit_disp = disp
        ReturnValue(1)
    }
}

Function.Optimize_IpMatch {
    Input: node: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(LoopHome.ip0_on, 0) ThenBlock: {
            IfCondition EqualTo(LoopHome.ip1_on, 0) ThenBlock: { ReturnValue(0) }
        }
        IfCondition EqualTo(AST_GetType(node), AST.IDENTIFIER) ThenBlock: {
            ReturnValue(Optimize_IpMatchName(AST_GetData1(node)))
        }
        IfCondition EqualTo(Optimize_IpAddr(node), 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(Optimize_IpMatchGroup())
    }
}

Function.Optimize_TryIpDef {
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(LoopHome.active, 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(Optimize_IpMatchName(name))
    }
}

// The address temporary is never computed. Its reads are pointer disp.
Function.Optimize_TryIpDrop {
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(LoopHome.active, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(LoopHome.d0_on, 1) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(name, LoopHome.d0_name), 1) ThenBlock: { ReturnValue(1) }
        }
        IfCondition EqualTo(LoopHome.d1_on, 1) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(name, LoopHome.d1_name), 1) ThenBlock: { ReturnValue(1) }
        }
        IfCondition EqualTo(LoopHome.d2_on, 1) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(name, LoopHome.d2_name), 1) ThenBlock: { ReturnValue(1) }
        }
        IfCondition EqualTo(LoopHome.d3_on, 1) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(name, LoopHome.d3_name), 1) ThenBlock: { ReturnValue(1) }
        }
        ReturnValue(0)
    }
}

// p = base + index*stride, with stride any positive constant. The cursor
// index steps the pointer by stride*step. An index that this loop does
// not assign stays put. Both registers must still be free: a cursor-affine
// group already owns them, and a scaled dereference writes r14.

Function.Optimize_AddrScaled {
    Input: node: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(AST_GetType(node), AST.CALL) ThenBlock: {
            IfCondition EqualTo(StringCompare(AST_GetData1(node), "Dereference"), 0) ThenBlock: {
                IfCondition GreaterEqual(AST_GetChildCount(node), 1) ThenBlock: {
                    addr = AST_GetChild(node, 0)
                    IfCondition NotEqual(addr, 0) ThenBlock: {
                        IfCondition EqualTo(AST_GetType(addr), AST.CALL) ThenBlock: {
                            IfCondition EqualTo(StringCompare(AST_GetData1(addr), "Add"), 0) ThenBlock: {
                                IfCondition EqualTo(AST_GetChildCount(addr), 2) ThenBlock: {
                                    right = AST_GetChild(addr, 1)
                                    IfCondition NotEqual(right, 0) ThenBlock: {
                                        IfCondition EqualTo(AST_GetType(right), AST.CALL) ThenBlock: {
                                            IfCondition EqualTo(StringCompare(AST_GetData1(right), "Multiply"), 0) ThenBlock: {
                                                IfCondition EqualTo(AST_GetChildCount(right), 2) ThenBlock: {
                                                    scale_node = AST_GetChild(right, 1)
                                                    IfCondition EqualTo(Optimize_IpNum(scale_node), 1) ThenBlock: {
                                                        IfCondition EqualTo(Optimize_IpScaleOk(LoopHome.ip_num), 1) ThenBlock: { ReturnValue(1) }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        count = AST_GetChildCount(node)
        i = 0
        WhileLoop LessThan(i, count) {
            IfCondition EqualTo(Optimize_AddrScaled(AST_GetChild(node, i)), 1) ThenBlock: { ReturnValue(1) }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

// Sets ip_hit_disp when addr is name or name+imm.
Function.Optimize_AddrMem {
    Input: addr: Address
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(addr, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(AST_GetType(addr), AST.IDENTIFIER) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(AST_GetData1(addr), name), 1) ThenBlock: {
                LoopHome.ip_hit_disp = 0
                ReturnValue(1)
            }
            ReturnValue(0)
        }
        IfCondition NotEqual(AST_GetType(addr), AST.CALL) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(StringCompare(AST_GetData1(addr), "Add"), 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetChildCount(addr), 2) ThenBlock: { ReturnValue(0) }
        left = AST_GetChild(addr, 0)
        right = AST_GetChild(addr, 1)
        num = 0
        idn = 0
        IfCondition EqualTo(Optimize_IpNum(right), 1) ThenBlock: {
            IfCondition NotEqual(left, 0) ThenBlock: {
                IfCondition EqualTo(AST_GetType(left), AST.IDENTIFIER) ThenBlock: {
                    IfCondition EqualTo(Optimize_NameEq(AST_GetData1(left), name), 1) ThenBlock: {
                        num = LoopHome.ip_num
                        idn = 1
                    }
                }
            }
        }
        IfCondition EqualTo(idn, 0) ThenBlock: {
            IfCondition EqualTo(Optimize_IpNum(left), 1) ThenBlock: {
                IfCondition NotEqual(right, 0) ThenBlock: {
                    IfCondition EqualTo(AST_GetType(right), AST.IDENTIFIER) ThenBlock: {
                        IfCondition EqualTo(Optimize_NameEq(AST_GetData1(right), name), 1) ThenBlock: {
                            num = LoopHome.ip_num
                            idn = 1
                        }
                    }
                }
            }
        }
        IfCondition EqualTo(idn, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_Fit32(num), 0) ThenBlock: { ReturnValue(0) }
        LoopHome.ip_hit_disp = num
        ReturnValue(1)
    }
}

// Every mention is a qword load or an identifier store through this address.
Function.Optimize_AddrCovered {
    Input: node: Address
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(Optimize_CountIdents(node, name), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(AST_GetType(node), AST.IDENTIFIER) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(AST_GetData1(node), name), 1) ThenBlock: { ReturnValue(0) }
        }
        IfCondition EqualTo(AST_GetType(node), AST.CALL) ThenBlock: {
            cname = AST_GetData1(node)
            IfCondition EqualTo(StringCompare(cname, "Dereference"), 0) ThenBlock: {
                IfCondition EqualTo(AST_GetChildCount(node), 1) ThenBlock: {
                    IfCondition EqualTo(Optimize_AddrMem(AST_GetChild(node, 0), name), 1) ThenBlock: { ReturnValue(1) }
                }
                ReturnValue(0)
            }
            IfCondition EqualTo(StringCompare(cname, "StoreValue"), 0) ThenBlock: {
                IfCondition EqualTo(AST_GetChildCount(node), 2) ThenBlock: {
                    IfCondition EqualTo(Optimize_AddrMem(AST_GetChild(node, 0), name), 1) ThenBlock: {
                        val = AST_GetChild(node, 1)
                        IfCondition NotEqual(val, 0) ThenBlock: {
                            IfCondition EqualTo(AST_GetType(val), AST.IDENTIFIER) ThenBlock: {
                                IfCondition EqualTo(Optimize_NameEq(AST_GetData1(val), name), 0) ThenBlock: { ReturnValue(1) }
                            }
                        }
                    }
                }
                ReturnValue(0)
            }
        }
        count = AST_GetChildCount(node)
        i = 0
        WhileLoop LessThan(i, count) {
            IfCondition EqualTo(Optimize_AddrCovered(AST_GetChild(node, i), name), 0) ThenBlock: { ReturnValue(0) }
            i = Add(i, 1)
        }
        ReturnValue(1)
    }
}

// base + index*k. Leaves the byte step in ip_coeff. The base is not assigned.
Function.Optimize_AddrSides {
    Input: base_node: Address
    Input: mul_node: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(base_node, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(base_node), AST.IDENTIFIER) ThenBlock: { ReturnValue(0) }
        bname = AST_GetData1(base_node)
        IfCondition EqualTo(Optimize_NameEq(bname, LoopHome.int_name), 1) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(Optimize_AssignCount(LoopHome.body, bname), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_FrameOff(bname), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_IpMulParts(mul_node), 0) ThenBlock: { ReturnValue(0) }
        k = LoopHome.ip_mul_k
        idx = LoopHome.ip_mul_in
        IfCondition LessThan(k, 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_Fit32(k), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(idx, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(idx), AST.IDENTIFIER) ThenBlock: { ReturnValue(0) }
        iname = AST_GetData1(idx)
        bump = 0
        IfCondition EqualTo(Optimize_NameEq(iname, LoopHome.int_name), 1) ThenBlock: {
            IfCondition NotEqual(Optimize_AssignCount(LoopHome.body, LoopHome.int_name), 1) ThenBlock: { ReturnValue(0) }
            IfCondition LessThan(LoopHome.iv_step, 1) ThenBlock: { ReturnValue(0) }
            IfCondition LessThan(LoopHome.iv_at, 0) ThenBlock: { ReturnValue(0) }
            IfCondition GreaterThan(k, 1048576) ThenBlock: { ReturnValue(0) }
            IfCondition GreaterThan(LoopHome.iv_step, 1048576) ThenBlock: { ReturnValue(0) }
            bump = Multiply(k, LoopHome.iv_step)
            IfCondition LessThan(bump, 1) ThenBlock: { ReturnValue(0) }
            IfCondition EqualTo(Optimize_Fit32(bump), 0) ThenBlock: { ReturnValue(0) }
        } ElseBlock: {
            IfCondition NotEqual(Optimize_AssignCount(LoopHome.body, iname), 0) ThenBlock: { ReturnValue(0) }
            bump = 0
        }
        LoopHome.ip_base = bname
        LoopHome.ip_coeff = bump
        ReturnValue(1)
    }
}

Function.Optimize_AddrShape {
    Input: val: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(val, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(val), AST.CALL) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(StringCompare(AST_GetData1(val), "Add"), 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetChildCount(val), 2) ThenBlock: { ReturnValue(0) }
        left = AST_GetChild(val, 0)
        right = AST_GetChild(val, 1)
        IfCondition EqualTo(Optimize_AddrSides(left, right), 1) ThenBlock: { ReturnValue(1) }
        ReturnValue(Optimize_AddrSides(right, left))
    }
}

// A later loop may reuse the name. Dropping this assignment is safe when
// every outside read is dominated by some other assignment of the name.
Function.Optimize_AddrDeadNode {
    Input: node: Address
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(node, LoopHome.body) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(AST_GetType(node), AST.BLOCK) ThenBlock: {
            ReturnValue(Optimize_AddrDeadBlock(node, name))
        }
        IfCondition EqualTo(AST_GetType(node), AST.IDENTIFIER) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(AST_GetData1(node), name), 1) ThenBlock: { ReturnValue(0) }
            ReturnValue(1)
        }
        count = AST_GetChildCount(node)
        i = 0
        WhileLoop LessThan(i, count) {
            IfCondition EqualTo(Optimize_AddrDeadNode(AST_GetChild(node, i), name), 0) ThenBlock: { ReturnValue(0) }
            i = Add(i, 1)
        }
        ReturnValue(1)
    }
}

Function.Optimize_AddrDeadBlock {
    Input: block: Address
    Input: name: Address
    Output: Integer
    Body: {
        defined = 0
        count = AST_GetChildCount(block)
        i = 0
        WhileLoop LessThan(i, count) {
            st = AST_GetChild(block, i)
            IfCondition EqualTo(defined, 0) ThenBlock: {
                IfCondition EqualTo(Optimize_AddrDeadNode(st, name), 0) ThenBlock: { ReturnValue(0) }
            }
            IfCondition EqualTo(Optimize_PlainAssign(st), 1) ThenBlock: {
                IfCondition EqualTo(Optimize_NameEq(AST_GetData1(st), name), 1) ThenBlock: { defined = 1 }
            }
            i = Add(i, 1)
        }
        ReturnValue(1)
    }
}

Function.Optimize_AddrDeadOut {
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(Compile.current_func, 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(Optimize_AddrDeadNode(Compile.current_func, name))
    }
}

Function.Optimize_AddrOk {
    Input: name: Address
    Input: def_at: Integer
    Input: condition: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }
        bump = LoopHome.ip_coeff
        IfCondition EqualTo(Optimize_NameEq(name, LoopHome.int_name), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_IpIsFlt(name), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_NameEq(name, LoopHome.acc_name), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_NameEq(name, LoopHome.der_name), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_IpIsNoted(name), 1) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(Optimize_AssignCount(LoopHome.body, name), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Compile.current_func, 0) ThenBlock: { ReturnValue(0) }
        block_n = Optimize_Mentions(LoopHome.body, name)
        func_n = Optimize_Mentions(Compile.current_func, name)
        IfCondition NotEqual(block_n, func_n) ThenBlock: {
            IfCondition EqualTo(Optimize_AddrDeadOut(name), 0) ThenBlock: { ReturnValue(0) }
        }
        IfCondition LessThan(block_n, 2) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterThan(Optimize_CountIdents(condition, name), 0) ThenBlock: { ReturnValue(0) }
        st = AST_GetChild(LoopHome.body, def_at)
        IfCondition EqualTo(st, 0) ThenBlock: { ReturnValue(0) }
        val = AST_GetChild(st, 0)
        IfCondition GreaterThan(Optimize_CountIdents(val, name), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_PureExpr(val), 0) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterThan(bump, 0) ThenBlock: {
            IfCondition GreaterEqual(def_at, LoopHome.iv_at) ThenBlock: { ReturnValue(0) }
        }
        count = AST_GetChildCount(LoopHome.body)
        k = 0
        WhileLoop LessThan(k, count) {
            st = AST_GetChild(LoopHome.body, k)
            n = Optimize_CountIdents(st, name)
            IfCondition LessThan(k, def_at) ThenBlock: {
                IfCondition GreaterThan(n, 0) ThenBlock: { ReturnValue(0) }
            }
            IfCondition GreaterThan(k, def_at) ThenBlock: {
                IfCondition GreaterThan(n, 0) ThenBlock: {
                    IfCondition GreaterThan(bump, 0) ThenBlock: {
                        IfCondition GreaterEqual(k, LoopHome.iv_at) ThenBlock: { ReturnValue(0) }
                    }
                    IfCondition EqualTo(Optimize_AddrCovered(st, name), 0) ThenBlock: { ReturnValue(0) }
                }
            }
            k = Add(k, 1)
        }
        ReturnValue(1)
    }
}

Function.Optimize_AddrInstall {
    Input: name: Address
    Input: rhs: Address
    Output: Integer
    Body: {
        reg = Optimize_IpTakeReg()
        IfCondition EqualTo(reg, 0) ThenBlock: { ReturnValue(0) }
        bump = LoopHome.ip_coeff
        IfCondition EqualTo(LoopHome.ip0_on, 0) ThenBlock: {
            LoopHome.ip0_on = 1
            LoopHome.ip0_mode = 1
            LoopHome.ip0_reg = reg
            LoopHome.ip0_bump = bump
            LoopHome.ip0_rhs = rhs
            LoopHome.ip0_aname = name
            ReturnValue(1)
        }
        IfCondition EqualTo(LoopHome.ip1_on, 0) ThenBlock: {
            LoopHome.ip1_on = 1
            LoopHome.ip1_mode = 1
            LoopHome.ip1_reg = reg
            LoopHome.ip1_bump = bump
            LoopHome.ip1_rhs = rhs
            LoopHome.ip1_aname = name
            ReturnValue(1)
        }
        ReturnValue(0)
    }
}

Function.Optimize_AddrFind {
    Input: addr: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(LoopHome.active, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(LoopHome.ip0_on, 1) ThenBlock: {
            IfCondition EqualTo(LoopHome.ip0_mode, 1) ThenBlock: {
                IfCondition EqualTo(Optimize_AddrMem(addr, LoopHome.ip0_aname), 1) ThenBlock: {
                    LoopHome.ip_hit_reg = LoopHome.ip0_reg
                    ReturnValue(1)
                }
            }
        }
        IfCondition EqualTo(LoopHome.ip1_on, 1) ThenBlock: {
            IfCondition EqualTo(LoopHome.ip1_mode, 1) ThenBlock: {
                IfCondition EqualTo(Optimize_AddrMem(addr, LoopHome.ip1_aname), 1) ThenBlock: {
                    LoopHome.ip_hit_reg = LoopHome.ip1_reg
                    ReturnValue(1)
                }
            }
        }
        ReturnValue(0)
    }
}

Function.Optimize_AddrLoad {
    Input: addr: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(Optimize_AddrFind(addr), 0) ThenBlock: { ReturnValue(0) }
        X86_MovRaxIp(LoopHome.ip_hit_reg, LoopHome.ip_hit_disp)
        ReturnValue(1)
    }
}

// StoreValue(Add(tab, Multiply(int_name, scale)), int_name).
// The table prologue already holds the base in r14. The cursor is r13.
Function.Optimize_TryIvStore {
    Input: addr: Address
    Input: val: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(LoopHome.active, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(LoopHome.tab_on, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(LoopHome.int_name, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_IdentEq(val, LoopHome.int_name), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(addr, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(addr), AST.CALL) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(StringCompare(AST_GetData1(addr), "Add"), 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetChildCount(addr), 2) ThenBlock: { ReturnValue(0) }
        base = AST_GetChild(addr, 0)
        mul = AST_GetChild(addr, 1)
        IfCondition EqualTo(Optimize_IdentEq(base, LoopHome.tab_name), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(mul, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(mul), AST.CALL) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(StringCompare(AST_GetData1(mul), "Multiply"), 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetChildCount(mul), 2) ThenBlock: { ReturnValue(0) }
        scale = Optimize_ScaleValue(AST_GetChild(mul, 1))
        idx = AST_GetChild(mul, 0)
        IfCondition EqualTo(scale, 0) ThenBlock: {
            scale = Optimize_ScaleValue(AST_GetChild(mul, 0))
            idx = AST_GetChild(mul, 1)
        }
        IfCondition EqualTo(scale, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_IdentEq(idx, LoopHome.int_name), 0) ThenBlock: { ReturnValue(0) }
        X86_StR13AtR14R13(scale)
        ReturnValue(1)
    }
}

Function.Optimize_AddrStore {
    Input: addr: Address
    Input: val: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(val, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(val), AST.IDENTIFIER) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_AddrFind(addr), 0) ThenBlock: {
            ReturnValue(Optimize_TryIvStore(addr, val))
        }
        reg = LoopHome.ip_hit_reg
        disp = LoopHome.ip_hit_disp
        vname = AST_GetData1(val)
        IfCondition EqualTo(Optimize_RldFind(vname), 1) ThenBlock: {
            same = 0
            IfCondition EqualTo(LoopHome.rld_reg, reg) ThenBlock: {
                IfCondition EqualTo(LoopHome.rld_disp, disp) ThenBlock: { same = 1 }
            }
            IfCondition EqualTo(same, 1) ThenBlock: {
                IfCondition EqualTo(LoopHome.rld_kind, 2) ThenBlock: { ReturnValue(1) }
                IfCondition EqualTo(LoopHome.rld_kind, 3) ThenBlock: { ReturnValue(1) }
            }
        }
        IfCondition EqualTo(LoopHome.ip0_mode, 1) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(vname, LoopHome.ip0_aname), 1) ThenBlock: { ReturnValue(0) }
        }
        IfCondition EqualTo(LoopHome.ip1_mode, 1) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(vname, LoopHome.ip1_aname), 1) ThenBlock: { ReturnValue(0) }
        }
        got = Compile_Expression(val)
        IfCondition EqualTo(got, 0) ThenBlock: {
            Compile.error = 1
            ReturnValue(1)
        }
        Emit_MovRbxRax()
        X86_MovIpRbx(reg, disp)
        ReturnValue(1)
    }
}

// A one-use load from an address register reloads at the use.
// A field that is loaded, updated once, and stored back reloads at the update.
// Records are 32 bytes: name, reg, disp, kind. Kind 1 reloads. Kind 2 updates.

Function.Optimize_RldFind {
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(LoopHome.active, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(LoopHome.rld_count, 0) ThenBlock: { ReturnValue(0) }
        i = 0
        WhileLoop LessThan(i, LoopHome.rld_count) {
            rec = Add(LoopHome.rld_recs, Multiply(i, 32))
            IfCondition EqualTo(Optimize_NameEq(Dereference(rec), name), 1) ThenBlock: {
                LoopHome.rld_at = rec
                LoopHome.rld_reg = Dereference(Add(rec, 8))
                LoopHome.rld_disp = Dereference(Add(rec, 16))
                LoopHome.rld_kind = Dereference(Add(rec, 24))
                ReturnValue(1)
            }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

Function.Optimize_ReloadLoad {
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(Optimize_RldFind(name), 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(LoopHome.rld_kind, 1) ThenBlock: { ReturnValue(0) }
        X86_MovRaxIp(LoopHome.rld_reg, LoopHome.rld_disp)
        ReturnValue(1)
    }
}

Function.Optimize_RldAdd {
    Input: name: Address
    Input: reg: Integer
    Input: disp: Integer
    Input: kind: Integer
    Output: Integer
    Body: {
        IfCondition GreaterEqual(LoopHome.rld_count, 16) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(LoopHome.rld_recs, 0) ThenBlock: {
            LoopHome.rld_recs = Allocate(512)
        }
        rec = Add(LoopHome.rld_recs, Multiply(LoopHome.rld_count, 32))
        StoreValue(rec, name)
        StoreValue(Add(rec, 8), reg)
        StoreValue(Add(rec, 16), disp)
        StoreValue(Add(rec, 24), kind)
        LoopHome.rld_count = Add(LoopHome.rld_count, 1)
        ReturnValue(1)
    }
}

Function.Optimize_RldDeref {
    Input: val: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(val, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(val), AST.CALL) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(StringCompare(AST_GetData1(val), "Dereference"), 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetChildCount(val), 1) ThenBlock: { ReturnValue(0) }
        addr = AST_GetChild(val, 0)
        IfCondition EqualTo(LoopHome.ip0_on, 1) ThenBlock: {
            IfCondition EqualTo(LoopHome.ip0_mode, 1) ThenBlock: {
                IfCondition EqualTo(Optimize_AddrMem(addr, LoopHome.ip0_aname), 1) ThenBlock: {
                    LoopHome.rld_reg = LoopHome.ip0_reg
                    LoopHome.rld_disp = LoopHome.ip_hit_disp
                    ReturnValue(1)
                }
            }
        }
        IfCondition EqualTo(LoopHome.ip1_on, 1) ThenBlock: {
            IfCondition EqualTo(LoopHome.ip1_mode, 1) ThenBlock: {
                IfCondition EqualTo(Optimize_AddrMem(addr, LoopHome.ip1_aname), 1) ThenBlock: {
                    LoopHome.rld_reg = LoopHome.ip1_reg
                    LoopHome.rld_disp = LoopHome.ip_hit_disp
                    ReturnValue(1)
                }
            }
        }
        ReturnValue(0)
    }
}

Function.Optimize_HomeByName {
    Input: name: Address
    Output: Address
    Body: {
        i = 0
        WhileLoop LessThan(i, LoopHome.count) {
            rec = Optimize_HomeRec(i)
            IfCondition EqualTo(Optimize_NameEq(Dereference(rec), name), 1) ThenBlock: { ReturnValue(rec) }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

Function.Optimize_RldUpdate {
    Input: val: Address
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(val, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(val), AST.CALL) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetChildCount(val), 2) ThenBlock: { ReturnValue(0) }
        opk = Optimize_FltOpKind(AST_GetData1(val))
        IfCondition EqualTo(opk, 0) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterThan(opk, 2) ThenBlock: { ReturnValue(0) }
        left = AST_GetChild(val, 0)
        right = AST_GetChild(val, 1)
        left_ok = 0
        IfCondition NotEqual(left, 0) ThenBlock: {
            IfCondition EqualTo(AST_GetType(left), AST.IDENTIFIER) ThenBlock: {
                IfCondition EqualTo(Optimize_NameEq(AST_GetData1(left), name), 1) ThenBlock: { left_ok = 1 }
            }
        }
        IfCondition EqualTo(opk, 2) ThenBlock: { ReturnValue(left_ok) }
        IfCondition EqualTo(left_ok, 1) ThenBlock: { ReturnValue(1) }
        IfCondition NotEqual(right, 0) ThenBlock: {
            IfCondition EqualTo(AST_GetType(right), AST.IDENTIFIER) ThenBlock: {
                IfCondition EqualTo(Optimize_NameEq(AST_GetData1(right), name), 1) ThenBlock: { ReturnValue(1) }
            }
        }
        ReturnValue(0)
    }
}

Function.Optimize_RldStoreAt {
    Input: st: Address
    Input: name: Address
    Input: reg: Integer
    Input: disp: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(st, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(st), AST.CALL) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(StringCompare(AST_GetData1(st), "StoreValue"), 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetChildCount(st), 2) ThenBlock: { ReturnValue(0) }
        val = AST_GetChild(st, 1)
        IfCondition EqualTo(val, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(val), AST.IDENTIFIER) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_NameEq(AST_GetData1(val), name), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(LoopHome.ip0_on, 1) ThenBlock: {
            IfCondition EqualTo(LoopHome.ip0_reg, reg) ThenBlock: {
                IfCondition EqualTo(Optimize_AddrMem(AST_GetChild(st, 0), LoopHome.ip0_aname), 1) ThenBlock: {
                    IfCondition EqualTo(LoopHome.ip_hit_disp, disp) ThenBlock: { ReturnValue(1) }
                }
            }
        }
        IfCondition EqualTo(LoopHome.ip1_on, 1) ThenBlock: {
            IfCondition EqualTo(LoopHome.ip1_reg, reg) ThenBlock: {
                IfCondition EqualTo(Optimize_AddrMem(AST_GetChild(st, 0), LoopHome.ip1_aname), 1) ThenBlock: {
                    IfCondition EqualTo(LoopHome.ip_hit_disp, disp) ThenBlock: { ReturnValue(1) }
                }
            }
        }
        ReturnValue(0)
    }
}

Function.Optimize_RldSeen {
    Input: body: Address
    Input: def_at: Integer
    Input: name: Address
    Input: reg: Integer
    Input: disp: Integer
    Output: Integer
    Body: {
        found_up = 0
        j = Add(def_at, 1)
        count = AST_GetChildCount(body)
        WhileLoop LessThan(j, count) {
            st = AST_GetChild(body, j)
            IfCondition EqualTo(Optimize_PlainAssign(st), 1) ThenBlock: {
                IfCondition EqualTo(Optimize_NameEq(AST_GetData1(st), name), 1) ThenBlock: {
                    IfCondition EqualTo(found_up, 1) ThenBlock: { ReturnValue(0) }
                    IfCondition EqualTo(Optimize_RldUpdate(AST_GetChild(st, 0), name), 0) ThenBlock: { ReturnValue(0) }
                    found_up = 1
                }
            }
            IfCondition EqualTo(Optimize_RldStoreAt(st, name, reg, disp), 1) ThenBlock: {
                ReturnValue(found_up)
            }
            j = Add(j, 1)
        }
        ReturnValue(0)
    }
}

Function.Optimize_PickReload {
    Input: body: Address
    Output: Integer
    Body: {
        LoopHome.rld_count = 0
        IfCondition EqualTo(body, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(body), AST.BLOCK) ThenBlock: { ReturnValue(0) }
        have = 0
        IfCondition EqualTo(LoopHome.ip0_on, 1) ThenBlock: {
            IfCondition EqualTo(LoopHome.ip0_mode, 1) ThenBlock: { have = 1 }
        }
        IfCondition EqualTo(LoopHome.ip1_on, 1) ThenBlock: {
            IfCondition EqualTo(LoopHome.ip1_mode, 1) ThenBlock: { have = 1 }
        }
        IfCondition EqualTo(have, 0) ThenBlock: { ReturnValue(0) }
        count = AST_GetChildCount(body)
        i = 0
        WhileLoop LessThan(i, count) {
            st = AST_GetChild(body, i)
            IfCondition EqualTo(Optimize_PlainAssign(st), 1) ThenBlock: {
                name = AST_GetData1(st)
                IfCondition EqualTo(Optimize_RldDeref(AST_GetChild(st, 0)), 1) ThenBlock: {
                    reg = LoopHome.rld_reg
                    disp = LoopHome.rld_disp
                    skip = 0
                    IfCondition EqualTo(Optimize_NameEq(name, LoopHome.int_name), 1) ThenBlock: { skip = 1 }
                    IfCondition EqualTo(Optimize_NameEq(name, LoopHome.acc_name), 1) ThenBlock: { skip = 1 }
                    IfCondition EqualTo(Optimize_NameTaken(name), 1) ThenBlock: { skip = 1 }
                    IfCondition EqualTo(skip, 0) ThenBlock: {
                        rec = Optimize_HomeByName(name)
                        IfCondition NotEqual(rec, 0) ThenBlock: {
                            loads = Dereference(Add(rec, 8))
                            stores = Dereference(Add(rec, 16))
                            fops = Dereference(Add(rec, 24))
                            selfn = Dereference(Add(rec, 32))
                            seeds = Dereference(Add(rec, 40))
                            IfCondition EqualTo(loads, 1) ThenBlock: {
                                IfCondition EqualTo(stores, 1) ThenBlock: {
                                    IfCondition EqualTo(seeds, 1) ThenBlock: {
                                        IfCondition EqualTo(fops, 0) ThenBlock: {
                                            Optimize_RldAdd(name, reg, disp, 1)
                                        }
                                    }
                                }
                            }
                            IfCondition EqualTo(seeds, 1) ThenBlock: {
                                IfCondition EqualTo(fops, 1) ThenBlock: {
                                    IfCondition EqualTo(stores, 2) ThenBlock: {
                                        IfCondition EqualTo(loads, 2) ThenBlock: {
                                            IfCondition GreaterThan(selfn, 0) ThenBlock: {
                                                IfCondition EqualTo(Optimize_RldSeen(body, i, name, reg, disp), 1) ThenBlock: {
                                                    Optimize_RldAdd(name, reg, disp, 2)
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
            i = Add(i, 1)
        }
        ReturnValue(1)
    }
}

Function.Optimize_TryReloadDrop {
    Input: name: Address
    Input: value: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(Optimize_RldFind(name), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(LoopHome.rld_kind, 1) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(LoopHome.rld_kind, 2) ThenBlock: {
            IfCondition NotEqual(value, 0) ThenBlock: {
                IfCondition EqualTo(AST_GetType(value), AST.CALL) ThenBlock: {
                    IfCondition EqualTo(StringCompare(AST_GetData1(value), "Dereference"), 0) ThenBlock: { ReturnValue(1) }
                }
            }
        }
        ReturnValue(0)
    }
}

// 1 when name is not read after the assignment whose value node is rhs.
// A later full assignment counts as dead. A call in the loop does not:
// the save would store the destroyed register back to the frame.
Function.Optimize_DeadAfter {
    Input: name: Address
    Input: rhs: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(rhs, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(LoopHome.has_call, 1) ThenBlock: { ReturnValue(0) }
        body = LoopHome.body
        IfCondition EqualTo(Optimize_FoldIsBlock(body), 0) ThenBlock: { ReturnValue(0) }
        count = AST_GetChildCount(body)
        found = -1
        i = 0
        WhileLoop LessThan(i, count) {
            st = AST_GetChild(body, i)
            IfCondition EqualTo(Optimize_PlainAssign(st), 1) ThenBlock: {
                IfCondition EqualTo(AST_GetChild(st, 0), rhs) ThenBlock: { found = i }
            }
            i = Add(i, 1)
        }
        IfCondition LessThan(found, 0) ThenBlock: { ReturnValue(0) }
        k = Add(found, 1)
        WhileLoop LessThan(k, count) {
            st = AST_GetChild(body, k)
            IfCondition EqualTo(Optimize_NodeReads(st, name), 1) ThenBlock: { ReturnValue(0) }
            IfCondition EqualTo(Optimize_LiveFullDef(st, name), 1) ThenBlock: { ReturnValue(1) }
            k = Add(k, 1)
        }
        ReturnValue(1)
    }
}

// 1 when src's register can hold dest for the rest of this body.
// src is not read or assigned again, dest is not assigned again, and neither
// value has to be in its own home at the loop edge. One borrowed register.
Function.Optimize_CoalOk {
    Input: src: Address
    Input: dest: Address
    Input: rhs: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(src, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(dest, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(rhs, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_NameEq(src, dest), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(LoopHome.has_call, 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_LiveIn(src, LoopHome.cond, LoopHome.body), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_LiveIn(dest, LoopHome.cond, LoopHome.body), 1) ThenBlock: { ReturnValue(0) }
        body = LoopHome.body
        IfCondition EqualTo(Optimize_FoldIsBlock(body), 0) ThenBlock: { ReturnValue(0) }
        count = AST_GetChildCount(body)
        found = -1
        i = 0
        WhileLoop LessThan(i, count) {
            st = AST_GetChild(body, i)
            IfCondition EqualTo(Optimize_PlainAssign(st), 1) ThenBlock: {
                IfCondition EqualTo(AST_GetChild(st, 0), rhs) ThenBlock: { found = i }
            }
            i = Add(i, 1)
        }
        IfCondition LessThan(found, 0) ThenBlock: { ReturnValue(0) }
        seen = 0
        k = Add(found, 1)
        WhileLoop LessThan(k, count) {
            st = AST_GetChild(body, k)
            nt = AST_GetType(st)
            IfCondition EqualTo(nt, AST.ASSIGNMENT) ThenBlock: {
                IfCondition EqualTo(Optimize_NameEq(AST_GetData1(st), dest), 1) ThenBlock: { ReturnValue(0) }
            }
            IfCondition EqualTo(nt, AST.INDEX_ASSIGN) ThenBlock: {
                IfCondition EqualTo(Optimize_NameEq(AST_GetData1(st), dest), 1) ThenBlock: { ReturnValue(0) }
            }
            IfCondition EqualTo(Optimize_NodeReads(st, src), 1) ThenBlock: { ReturnValue(0) }
            IfCondition EqualTo(Optimize_LiveFullDef(st, src), 1) ThenBlock: { ReturnValue(0) }
            IfCondition EqualTo(Optimize_NodeReads(st, dest), 1) ThenBlock: { seen = 1 }
            k = Add(k, 1)
        }
        ReturnValue(seen)
    }
}

// Up to eight borrowed homes. Stride 16: name, xmm slot. coal_on is the count.
Function.Optimize_CoalEnsure {
    Body: {
        IfCondition EqualTo(LoopHome.coal_recs, 0) ThenBlock: {
            LoopHome.coal_recs = Allocate(128)
        }
        ReturnValue(0)
    }
}

Function.Optimize_CoalFind {
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }
        IfCondition LessEqual(LoopHome.coal_on, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(LoopHome.coal_recs, 0) ThenBlock: { ReturnValue(0) }
        i = 0
        WhileLoop LessThan(i, LoopHome.coal_on) {
            rec = Add(LoopHome.coal_recs, Multiply(i, 16))
            IfCondition EqualTo(Optimize_NameEq(Dereference(rec), name), 1) ThenBlock: {
                ReturnValue(Dereference(Add(rec, 8)))
            }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

// 1 when some other borrowed name already lives in slot.
Function.Optimize_CoalBusy {
    Input: slot: Integer
    Input: dest: Address
    Output: Integer
    Body: {
        IfCondition LessEqual(LoopHome.coal_on, 0) ThenBlock: { ReturnValue(0) }
        i = 0
        WhileLoop LessThan(i, LoopHome.coal_on) {
            rec = Add(LoopHome.coal_recs, Multiply(i, 16))
            IfCondition EqualTo(Dereference(Add(rec, 8)), slot) ThenBlock: {
                IfCondition EqualTo(Optimize_NameEq(Dereference(rec), dest), 0) ThenBlock: { ReturnValue(1) }
            }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

// Remember dest lives in slot. Returns 0 when the table is full.
Function.Optimize_CoalPut {
    Input: dest: Address
    Input: slot: Integer
    Output: Integer
    Body: {
        Optimize_CoalEnsure()
        i = 0
        WhileLoop LessThan(i, LoopHome.coal_on) {
            rec = Add(LoopHome.coal_recs, Multiply(i, 16))
            IfCondition EqualTo(Optimize_NameEq(Dereference(rec), dest), 1) ThenBlock: {
                StoreValue(Add(rec, 8), slot)
                ReturnValue(1)
            }
            i = Add(i, 1)
        }
        IfCondition GreaterEqual(LoopHome.coal_on, 8) ThenBlock: { ReturnValue(0) }
        rec = Add(LoopHome.coal_recs, Multiply(LoopHome.coal_on, 16))
        StoreValue(rec, dest)
        StoreValue(Add(rec, 8), slot)
        LoopHome.coal_on = Add(LoopHome.coal_on, 1)
        ReturnValue(1)
    }
}

// Drop entries whose name is being assigned, or whose register that name owns.
Function.Optimize_CoalDropSlot {
    Input: slot: Integer
    Body: {
        IfCondition LessEqual(LoopHome.coal_on, 0) ThenBlock: { ReturnValue(0) }
        w = 0
        i = 0
        WhileLoop LessThan(i, LoopHome.coal_on) {
            rec = Add(LoopHome.coal_recs, Multiply(i, 16))
            sl = Dereference(Add(rec, 8))
            IfCondition NotEqual(sl, slot) ThenBlock: {
                IfCondition NotEqual(w, i) ThenBlock: {
                    wrec = Add(LoopHome.coal_recs, Multiply(w, 16))
                    StoreValue(wrec, Dereference(rec))
                    StoreValue(Add(wrec, 8), sl)
                }
                w = Add(w, 1)
            }
            i = Add(i, 1)
        }
        LoopHome.coal_on = w
        ReturnValue(0)
    }
}

// Multiply into a dead home and keep the product there. The destination's
// later reads use that register until the destination is assigned again.
Function.Optimize_CoalPick {
    Input: dest: Address
    Input: ch0: Address
    Input: ch1: Address
    Input: x0: Integer
    Input: x1: Integer
    Input: rhs: Address
    Output: Integer
    Body: {
        n0 = 0
        n1 = 0
        IfCondition NotEqual(ch0, 0) ThenBlock: {
            IfCondition EqualTo(AST_GetType(ch0), AST.IDENTIFIER) ThenBlock: { n0 = AST_GetData1(ch0) }
        }
        IfCondition NotEqual(ch1, 0) ThenBlock: {
            IfCondition EqualTo(AST_GetType(ch1), AST.IDENTIFIER) ThenBlock: { n1 = AST_GetData1(ch1) }
        }
        dslot = 0
        oslot = 0
        IfCondition EqualTo(Optimize_CoalOk(n0, dest, rhs), 1) ThenBlock: {
            IfCondition GreaterEqual(x0, 2) ThenBlock: {
                dslot = x0
                oslot = x1
            }
        }
        IfCondition EqualTo(dslot, 0) ThenBlock: {
            IfCondition EqualTo(Optimize_CoalOk(n1, dest, rhs), 1) ThenBlock: {
                IfCondition GreaterEqual(x1, 2) ThenBlock: {
                    dslot = x1
                    oslot = x0
                }
            }
        }
        IfCondition LessThan(dslot, 2) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(oslot, 2) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_CoalBusy(dslot, dest), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_CoalPut(dest, dslot), 0) ThenBlock: { ReturnValue(0) }
        X86_XmmBin(89, dslot, oslot)
        ReturnValue(1)
    }
}

// The borrowed register is about to be assigned, or the borrowed name is.
Function.Optimize_CoalDrop {
    Input: name: Address
    Body: {
        IfCondition LessEqual(LoopHome.coal_on, 0) ThenBlock: { ReturnValue(0) }
        raw = 0
        IfCondition EqualTo(Optimize_NameEq(name, LoopHome.flt_name), 1) ThenBlock: { raw = 2 }
        IfCondition EqualTo(Optimize_NameEq(name, LoopHome.f2_name), 1) ThenBlock: { raw = 3 }
        IfCondition EqualTo(Optimize_NameEq(name, LoopHome.f3_name), 1) ThenBlock: { raw = 4 }
        IfCondition EqualTo(Optimize_NameEq(name, LoopHome.f4_name), 1) ThenBlock: { raw = 5 }
        IfCondition EqualTo(Optimize_NameEq(name, LoopHome.f5_name), 1) ThenBlock: { raw = 6 }
        IfCondition EqualTo(Optimize_NameEq(name, LoopHome.f6_name), 1) ThenBlock: { raw = 7 }
        IfCondition EqualTo(raw, 0) ThenBlock: { raw = Optimize_XfSlot(name) }
        w = 0
        i = 0
        WhileLoop LessThan(i, LoopHome.coal_on) {
            rec = Add(LoopHome.coal_recs, Multiply(i, 16))
            sl = Dereference(Add(rec, 8))
            drop = 0
            IfCondition EqualTo(Optimize_NameEq(Dereference(rec), name), 1) ThenBlock: { drop = 1 }
            IfCondition GreaterThan(raw, 0) ThenBlock: {
                IfCondition EqualTo(sl, raw) ThenBlock: { drop = 1 }
            }
            IfCondition EqualTo(drop, 0) ThenBlock: {
                IfCondition NotEqual(w, i) ThenBlock: {
                    wrec = Add(LoopHome.coal_recs, Multiply(w, 16))
                    StoreValue(wrec, Dereference(rec))
                    StoreValue(Add(wrec, 8), sl)
                }
                w = Add(w, 1)
            }
            i = Add(i, 1)
        }
        LoopHome.coal_on = w
        ReturnValue(0)
    }
}

Function.Optimize_TryFieldUpdate {
    Input: name: Address
    Input: value: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(Optimize_RldFind(name), 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(LoopHome.rld_kind, 2) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_RldUpdate(value, name), 0) ThenBlock: { ReturnValue(0) }
        reg = LoopHome.rld_reg
        disp = LoopHome.rld_disp
        at = LoopHome.rld_at
        opk = Optimize_FltOpKind(AST_GetData1(value))
        other = AST_GetChild(value, 1)
        IfCondition EqualTo(opk, 1) ThenBlock: {
            left = AST_GetChild(value, 0)
            IfCondition NotEqual(left, 0) ThenBlock: {
                IfCondition EqualTo(AST_GetType(left), AST.IDENTIFIER) ThenBlock: {
                    IfCondition EqualTo(Optimize_NameEq(AST_GetData1(left), name), 0) ThenBlock: {
                        other = left
                    }
                }
            }
        }
        hslot = 0
        IfCondition NotEqual(other, 0) ThenBlock: {
            IfCondition EqualTo(AST_GetType(other), AST.IDENTIFIER) ThenBlock: {
                hslot = Optimize_FltSlot(AST_GetData1(other))
            }
        }
        killed = 0
        IfCondition GreaterThan(hslot, 0) ThenBlock: {
            IfCondition EqualTo(opk, 1) ThenBlock: {
                IfCondition EqualTo(Optimize_NameEq(AST_GetData1(other), name), 0) ThenBlock: {
                    IfCondition EqualTo(Optimize_DeadAfter(AST_GetData1(other), value), 1) ThenBlock: {
                        killed = 1
                    }
                }
            }
            IfCondition EqualTo(killed, 1) ThenBlock: {
                X86_XmmIp(88, hslot, reg, disp)
                X86_MovsdIpXmm(reg, disp, hslot)
                Optimize_CoalDropSlot(hslot)
            } ElseBlock: {
                X86_MovsdPtr(0, reg, disp)
                IfCondition EqualTo(opk, 1) ThenBlock: { X86_XmmBin(88, 0, hslot) }
                IfCondition EqualTo(opk, 2) ThenBlock: { X86_XmmBin(92, 0, hslot) }
            }
        } ElseBlock: {
            got = Optimize_CompileXmm(other)
            IfCondition EqualTo(got, 0) ThenBlock: {
                Compile.error = 1
                ReturnValue(1)
            }
            X86_XmmRR(8, 0)
            X86_MovsdPtr(0, reg, disp)
            IfCondition EqualTo(opk, 1) ThenBlock: { X86_XmmBin(88, 0, 1) }
            IfCondition EqualTo(opk, 2) ThenBlock: { X86_XmmBin(92, 0, 1) }
        }
        IfCondition EqualTo(killed, 0) ThenBlock: {
            X86_MovsdIpXmm(reg, disp, 0)
        }
        StoreValue(Add(at, 24), 3)
        LoopHome.rld_kind = 3
        ReturnValue(1)
    }
}

Function.Optimize_PickAddr {
    Input: condition: Address
    Input: body: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(LoopHome.ip0_on, 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(LoopHome.ip1_on, 1) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(Hw.level, 2) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(LoopHome.has_call, 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_TreeHasAsm(body), 1) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(body), AST.BLOCK) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_AddrScaled(body), 1) ThenBlock: { ReturnValue(0) }
        count = AST_GetChildCount(body)
        i = 0
        WhileLoop LessThan(i, count) {
            st = AST_GetChild(body, i)
            IfCondition EqualTo(Optimize_PlainAssign(st), 1) ThenBlock: {
                name = AST_GetData1(st)
                val = AST_GetChild(st, 0)
                IfCondition EqualTo(Optimize_AddrShape(val), 1) ThenBlock: {
                    IfCondition EqualTo(Optimize_AddrOk(name, i, condition), 1) ThenBlock: {
                        IfCondition EqualTo(Optimize_AddrInstall(name, val), 1) ThenBlock: {
                            Optimize_IpDropNote(name)
                        }
                    }
                }
            }
            i = Add(i, 1)
        }
        ReturnValue(1)
    }
}

Function.Optimize_IpBump {
    Body: {
        IfCondition EqualTo(LoopHome.ip0_on, 1) ThenBlock: {
            IfCondition NotEqual(LoopHome.ip0_bump, 0) ThenBlock: {
                X86_AddIpImm(LoopHome.ip0_reg, LoopHome.ip0_bump)
            }
        }
        IfCondition EqualTo(LoopHome.ip1_on, 1) ThenBlock: {
            IfCondition NotEqual(LoopHome.ip1_bump, 0) ThenBlock: {
                X86_AddIpImm(LoopHome.ip1_reg, LoopHome.ip1_bump)
            }
        }
        // The pointer moved. The next trip reloads.
        LoopHome.pin_n = 0
        LoopHome.pin_hit = 0
    }
}

// Four records, stride 24: reg, disp, xmm. Allocate once.
Function.Optimize_PinEnsure {
    Body: {
        IfCondition EqualTo(LoopHome.pin_recs, 0) ThenBlock: {
            LoopHome.pin_recs = Allocate(96)
        }
        ReturnValue(0)
    }
}

// xmm0, xmm1, and xmm15 stay scratch. A live home stays a home.
Function.Optimize_PinTaken {
    Input: xmm: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(xmm, 2) ThenBlock: { ReturnValue(1) }
        IfCondition GreaterThan(xmm, 14) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(xmm, 2) ThenBlock: {
            IfCondition NotEqual(LoopHome.flt_name, 0) ThenBlock: { ReturnValue(1) }
        }
        IfCondition EqualTo(xmm, 3) ThenBlock: {
            IfCondition NotEqual(LoopHome.f2_name, 0) ThenBlock: { ReturnValue(1) }
        }
        IfCondition EqualTo(xmm, 4) ThenBlock: {
            IfCondition NotEqual(LoopHome.f3_name, 0) ThenBlock: { ReturnValue(1) }
        }
        IfCondition EqualTo(xmm, 5) ThenBlock: {
            IfCondition NotEqual(LoopHome.f4_name, 0) ThenBlock: { ReturnValue(1) }
        }
        IfCondition EqualTo(xmm, 6) ThenBlock: {
            IfCondition NotEqual(LoopHome.f5_name, 0) ThenBlock: { ReturnValue(1) }
        }
        IfCondition EqualTo(xmm, 7) ThenBlock: {
            IfCondition NotEqual(LoopHome.f6_name, 0) ThenBlock: { ReturnValue(1) }
        }
        IfCondition GreaterEqual(xmm, 8) ThenBlock: {
            IfCondition LessThan(Subtract(xmm, 8), LoopHome.xf_n) ThenBlock: { ReturnValue(1) }
        }
        IfCondition EqualTo(LoopHome.pin_recs, 0) ThenBlock: { ReturnValue(0) }
        i = 0
        WhileLoop LessThan(i, LoopHome.pin_n) {
            rec = Add(LoopHome.pin_recs, Multiply(i, 24))
            IfCondition EqualTo(Dereference(Add(rec, 16)), xmm) ThenBlock: { ReturnValue(1) }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

// Prefer xmm8–xmm14. xmm7 then xmm6 only when the extra homes are full.
Function.Optimize_PinFree {
    Output: Integer
    Body: {
        IfCondition EqualTo(Optimize_PinTaken(8), 0) ThenBlock: { ReturnValue(8) }
        IfCondition EqualTo(Optimize_PinTaken(9), 0) ThenBlock: { ReturnValue(9) }
        IfCondition EqualTo(Optimize_PinTaken(10), 0) ThenBlock: { ReturnValue(10) }
        IfCondition EqualTo(Optimize_PinTaken(11), 0) ThenBlock: { ReturnValue(11) }
        IfCondition EqualTo(Optimize_PinTaken(12), 0) ThenBlock: { ReturnValue(12) }
        IfCondition EqualTo(Optimize_PinTaken(13), 0) ThenBlock: { ReturnValue(13) }
        IfCondition EqualTo(Optimize_PinTaken(14), 0) ThenBlock: { ReturnValue(14) }
        IfCondition EqualTo(Optimize_PinTaken(7), 0) ThenBlock: { ReturnValue(7) }
        IfCondition EqualTo(Optimize_PinTaken(6), 0) ThenBlock: { ReturnValue(6) }
        ReturnValue(0)
    }
}

Function.Optimize_PinFind {
    Input: reg: Integer
    Input: disp: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(LoopHome.pin_recs, 0) ThenBlock: { ReturnValue(0) }
        i = 0
        WhileLoop LessThan(i, LoopHome.pin_n) {
            rec = Add(LoopHome.pin_recs, Multiply(i, 24))
            IfCondition EqualTo(Dereference(rec), reg) ThenBlock: {
                IfCondition EqualTo(Dereference(Add(rec, 8)), disp) ThenBlock: {
                    LoopHome.pin_hit = Dereference(Add(rec, 16))
                    ReturnValue(1)
                }
            }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

// Copy a multi-use induction load into xmm0 or xmm1. The first use in
// the trip loads it into a free xmm. A later use copies that xmm.
// Returns 0 before any instruction when the load stays a movsd.
Function.Optimize_PinLoad {
    Input: dst: Integer
    Input: node: Address
    Input: reg: Integer
    Input: disp: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(LoopHome.active, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(node), AST.IDENTIFIER) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(LoopHome.body, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(LoopHome.has_call, 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_TreeHasAsm(LoopHome.body), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_TreeHasStore(LoopHome.body), 1) ThenBlock: { ReturnValue(0) }
        name = AST_GetData1(node)
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(Optimize_Mentions(LoopHome.body, name), 3) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_PinFind(reg, disp), 1) ThenBlock: {
            X86_XmmBin(16, dst, LoopHome.pin_hit)
            ReturnValue(1)
        }
        IfCondition GreaterEqual(LoopHome.pin_n, 4) ThenBlock: { ReturnValue(0) }
        xmm = Optimize_PinFree()
        IfCondition EqualTo(xmm, 0) ThenBlock: { ReturnValue(0) }
        Optimize_PinEnsure()
        IfCondition EqualTo(LoopHome.pin_recs, 0) ThenBlock: { ReturnValue(0) }
        X86_MovsdPtr(xmm, reg, disp)
        X86_XmmBin(16, dst, xmm)
        rec = Add(LoopHome.pin_recs, Multiply(LoopHome.pin_n, 24))
        StoreValue(rec, reg)
        StoreValue(Add(rec, 8), disp)
        StoreValue(Add(rec, 16), xmm)
        LoopHome.pin_n = Add(LoopHome.pin_n, 1)
        LoopHome.pin_hit = xmm
        ReturnValue(1)
    }
}

Function.Optimize_EmitIpOne {
    Input: slot: Integer
    Body: {
        reg = LoopHome.ip0_reg
        inv = LoopHome.ip0_inv
        iadd = LoopHome.ip0_add
        scale = LoopHome.ip0_scale
        coeff = LoopHome.ip0_coeff
        via = LoopHome.ip0_via
        boff = LoopHome.ip0_boff
        mode = LoopHome.ip0_mode
        rhs = LoopHome.ip0_rhs
        IfCondition EqualTo(slot, 1) ThenBlock: {
            reg = LoopHome.ip1_reg
            inv = LoopHome.ip1_inv
            iadd = LoopHome.ip1_add
            scale = LoopHome.ip1_scale
            coeff = LoopHome.ip1_coeff
            via = LoopHome.ip1_via
            boff = LoopHome.ip1_boff
            mode = LoopHome.ip1_mode
            rhs = LoopHome.ip1_rhs
        }
        // Named address. The add itself is the pointer, so the cursor is
        // not added again. An invariant index has bump 0 and is not stepped.
        IfCondition EqualTo(mode, 1) ThenBlock: {
            save14 = 0
            IfCondition NotEqual(reg, 14) ThenBlock: {
                IfCondition EqualTo(LoopHome.tab_on, 1) ThenBlock: { save14 = 1 }
                IfCondition EqualTo(slot, 1) ThenBlock: {
                    IfCondition EqualTo(LoopHome.ip0_reg, 14) ThenBlock: { save14 = 1 }
                }
            }
            IfCondition EqualTo(save14, 1) ThenBlock: { Emit_PushR14() }
            got = Compile_Expression(rhs)
            IfCondition EqualTo(got, 0) ThenBlock: {
                IfCondition EqualTo(save14, 1) ThenBlock: { Emit_PopR14() }
                Compile.error = 1
                ReturnValue(0)
            }
            IfCondition EqualTo(reg, 11) ThenBlock: { X86Enc_Assemble("MOV r11, rax") }
            IfCondition EqualTo(reg, 14) ThenBlock: { X86Enc_Assemble("MOV r14, rax") }
            IfCondition EqualTo(save14, 1) ThenBlock: { Emit_PopR14() }
            ReturnValue(1)
        }
        cscale = Multiply(coeff, scale)
        IfCondition NotEqual(inv, 0) ThenBlock: {
            got = Compile_Expression(inv)
            IfCondition EqualTo(got, 0) ThenBlock: {
                Compile.error = 1
                ReturnValue(0)
            }
            IfCondition NotEqual(iadd, 0) ThenBlock: { Emit_AddRaxImm32(iadd) }
        } ElseBlock: {
            Emit_MovRaxImm64(iadd)
        }
        IfCondition GreaterThan(scale, 1) ThenBlock: {
            IfCondition EqualTo(Optimize_IpLog(scale), 1) ThenBlock: {
                IfCondition GreaterThan(LoopHome.ip_log, 0) ThenBlock: { Emit_ShlRaxImm8(LoopHome.ip_log) }
            }
        }
        Emit_PushRax()
        Emit_HomeMove(1, 0)
        IfCondition GreaterThan(cscale, 1) ThenBlock: {
            IfCondition EqualTo(Optimize_IpLog(cscale), 1) ThenBlock: {
                IfCondition GreaterThan(LoopHome.ip_log, 0) ThenBlock: { Emit_ShlRaxImm8(LoopHome.ip_log) }
            } ElseBlock: {
                Emit_MovRbxImm64(cscale)
                X86Enc_Assemble("IMUL rax, rbx")
            }
        }
        Emit_PopRbx()
        Emit_AddRaxRbx()
        IfCondition EqualTo(via, 2) ThenBlock: {
            Emit_AddRaxR12()
        } ElseBlock: {
            Emit_PushRax()
            Emit_MovRaxRbpOffset(boff)
            Emit_MovRbxRax()
            Emit_PopRax()
            Emit_AddRaxRbx()
        }
        IfCondition EqualTo(reg, 11) ThenBlock: { X86Enc_Assemble("MOV r11, rax") }
        IfCondition EqualTo(reg, 14) ThenBlock: { X86Enc_Assemble("MOV r14, rax") }
        ReturnValue(1)
    }
}

Function.Optimize_EmitIp {
    Body: {
        IfCondition EqualTo(LoopHome.active, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(LoopHome.ip0_on, 1) ThenBlock: {
            Optimize_EmitIpOne(0)
        }
        IfCondition EqualTo(LoopHome.ip1_on, 1) ThenBlock: {
            Optimize_EmitIpOne(1)
        }
        ReturnValue(0)
    }
}

// Proven range inside [0, 2^63). The bounds themselves fit in a signed
// int64, and the checks refuse a sum or product that would wrap.
Function.Optimize_RangeName {
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(LoopHome.iv_nn, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_NameEq(name, LoopHome.int_name), 0) ThenBlock: { ReturnValue(0) }
        LoopHome.range_lo = LoopHome.iv_lo
        LoopHome.range_hi = LoopHome.iv_hi
        ReturnValue(1)
    }
}

Function.Optimize_Range {
    Input: node: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        nt = AST_GetType(node)
        IfCondition EqualTo(nt, AST.NUMBER) ThenBlock: {
            val = StringToNumber(AST_GetData1(node))
            IfCondition LessThan(val, 0) ThenBlock: { ReturnValue(0) }
            LoopHome.range_lo = val
            LoopHome.range_hi = val
            ReturnValue(1)
        }
        IfCondition EqualTo(nt, AST.IDENTIFIER) ThenBlock: {
            ReturnValue(Optimize_RangeName(AST_GetData1(node)))
        }
        IfCondition NotEqual(nt, AST.CALL) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetChildCount(node), 2) ThenBlock: { ReturnValue(0) }
        op = AST_GetData1(node)
        is_add = EqualTo(StringCompare(op, "Add"), 0)
        is_sub = EqualTo(StringCompare(op, "Subtract"), 0)
        is_mul = EqualTo(StringCompare(op, "Multiply"), 0)
        IfCondition EqualTo(Or(is_add, Or(is_sub, is_mul)), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_Range(AST_GetChild(node, 0)), 0) ThenBlock: { ReturnValue(0) }
        lo0 = LoopHome.range_lo
        hi0 = LoopHome.range_hi
        IfCondition EqualTo(Optimize_Range(AST_GetChild(node, 1)), 0) ThenBlock: { ReturnValue(0) }
        lo1 = LoopHome.range_lo
        hi1 = LoopHome.range_hi
        maxv = 9223372036854775807
        IfCondition EqualTo(is_add, 1) ThenBlock: {
            IfCondition GreaterThan(hi0, Subtract(maxv, hi1)) ThenBlock: { ReturnValue(0) }
            LoopHome.range_lo = Add(lo0, lo1)
            LoopHome.range_hi = Add(hi0, hi1)
            ReturnValue(1)
        }
        IfCondition EqualTo(is_sub, 1) ThenBlock: {
            IfCondition LessThan(lo0, hi1) ThenBlock: { ReturnValue(0) }
            LoopHome.range_lo = Subtract(lo0, hi1)
            LoopHome.range_hi = Subtract(hi0, lo1)
            ReturnValue(1)
        }
        IfCondition GreaterThan(hi0, 0) ThenBlock: {
            IfCondition GreaterThan(hi1, Divide(maxv, hi0)) ThenBlock: { ReturnValue(0) }
        }
        LoopHome.range_lo = Multiply(lo0, lo1)
        LoopHome.range_hi = Multiply(hi0, hi1)
        ReturnValue(1)
    }
}

Function.Optimize_NonNeg {
    Input: node: Address
    Output: Integer
    Body: {
        ReturnValue(Optimize_Range(node))
    }
}

// Same proof as Optimize_NonNeg, without leaving a range in LoopHome.
Function.Optimize_ProvedNonNeg {
    Input: node: Address
    Output: Integer
    Body: {
        saved_lo = LoopHome.range_lo
        saved_hi = LoopHome.range_hi
        proved = Optimize_NonNeg(node)
        LoopHome.range_lo = saved_lo
        LoopHome.range_hi = saved_hi
        ReturnValue(proved)
    }
}

Function.Optimize_SameBase {
    Input: a: Address
    Input: b: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(a, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(b, 0) ThenBlock: { ReturnValue(0) }
        ta = AST_GetType(a)
        tb = AST_GetType(b)
        IfCondition NotEqual(ta, tb) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(ta, AST.NUMBER) ThenBlock: {
            IfCondition EqualTo(StringToNumber(AST_GetData1(a)), StringToNumber(AST_GetData1(b))) ThenBlock: {
                ReturnValue(1)
            }
            ReturnValue(0)
        }
        IfCondition EqualTo(ta, AST.IDENTIFIER) ThenBlock: {
            ReturnValue(Optimize_NameEq(AST_GetData1(a), AST_GetData1(b)))
        }
        ReturnValue(0)
    }
}

// Add(x, 1) or Add(1, x), and x is the same number or the same name.
Function.Optimize_EvenAdd {
    Input: addn: Address
    Input: base: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(addn, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(addn), AST.CALL) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(StringCompare(AST_GetData1(addn), "Add"), 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetChildCount(addn), 2) ThenBlock: { ReturnValue(0) }
        c0 = AST_GetChild(addn, 0)
        c1 = AST_GetChild(addn, 1)
        IfCondition EqualTo(AST_GetType(c1), AST.NUMBER) ThenBlock: {
            IfCondition EqualTo(StringToNumber(AST_GetData1(c1)), 1) ThenBlock: {
                ReturnValue(Optimize_SameBase(c0, base))
            }
        }
        IfCondition EqualTo(AST_GetType(c0), AST.NUMBER) ThenBlock: {
            IfCondition EqualTo(StringToNumber(AST_GetData1(c0)), 1) ThenBlock: {
                ReturnValue(Optimize_SameBase(c1, base))
            }
        }
        ReturnValue(0)
    }
}

// x*(x+1) is always even, wrapping add and multiply included. One of the
// two factors is even, and the low bit of a product depends only on the
// low bits. Division by 2 of an even value matches SAR. Division by 4
// does not: -6/4 is -1, and SAR by 2 is -2.
Function.Optimize_EvenPair {
    Input: node: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(node), AST.CALL) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(StringCompare(AST_GetData1(node), "Multiply"), 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetChildCount(node), 2) ThenBlock: { ReturnValue(0) }
        a0 = AST_GetChild(node, 0)
        a1 = AST_GetChild(node, 1)
        IfCondition EqualTo(Optimize_EvenAdd(a1, a0), 1) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(Optimize_EvenAdd(a0, a1), 1) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

// 1 when plain SAR by `shift` equals toward-zero Divide.
Function.Optimize_SarSafe {
    Input: node: Address
    Input: shift: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(shift, 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_NonNeg(node), 1) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(shift, 1) ThenBlock: {
            ReturnValue(Optimize_EvenPair(node))
        }
        ReturnValue(0)
    }
}

// A value read in the loop and never written there parks in a free home.
// r12 is the integer slot when the accumulator is empty. Each remaining
// read-only float takes the next xmm3–xmm14 slot. The first winner is the
// same one a single-slot install would have chosen.
Function.Optimize_PickInvariant {
    Input: condition: Address
    Input: body: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(LoopHome.has_call, 1) ThenBlock: { ReturnValue(0) }
        best_int = 0
        best_int_off = 0
        best_int_loads = 0
        i = 0
        WhileLoop LessThan(i, LoopHome.count) {
            rec = Optimize_HomeRec(i)
            name = Dereference(rec)
            loads = Dereference(Add(rec, 8))
            stores = Dereference(Add(rec, 16))
            IfCondition GreaterThan(loads, 0) ThenBlock: {
                IfCondition EqualTo(stores, 0) ThenBlock: {
                    IfCondition EqualTo(Optimize_NameTaken(name), 0) ThenBlock: {
                        skip = 0
                        IfCondition EqualTo(LoopHome.tab_on, 1) ThenBlock: {
                            IfCondition EqualTo(Optimize_NameEq(name, LoopHome.tab_name), 1) ThenBlock: { skip = 1 }
                        }
                        IfCondition EqualTo(LoopHome.lim_on, 1) ThenBlock: {
                            IfCondition EqualTo(Optimize_NameEq(name, LoopHome.lim_name), 1) ThenBlock: { skip = 1 }
                        }
                        IfCondition EqualTo(skip, 0) ThenBlock: {
                            IfCondition EqualTo(Optimize_FrameOff(name), 1) ThenBlock: {
                                off = LoopHome.imm_val
                                IfCondition GreaterThan(loads, best_int_loads) ThenBlock: {
                                    IfCondition EqualTo(Optimize_InvOk(name, 2, condition, body), 1) ThenBlock: {
                                        best_int = name
                                        best_int_off = off
                                        best_int_loads = loads
                                    }
                                }
                            }
                        }
                    }
                }
            }
            i = Add(i, 1)
        }
        IfCondition EqualTo(LoopHome.acc_name, 0) ThenBlock: {
            IfCondition NotEqual(best_int, 0) ThenBlock: {
                LoopHome.acc_name = best_int
                LoopHome.acc_off = best_int_off
            }
        }
        IfCondition EqualTo(LoopHome.no_float, 0) ThenBlock: {
            nflt = 0
            WhileLoop LessThan(nflt, 12) {
                IfCondition EqualTo(Optimize_TakeFlt(condition, body), 0) ThenBlock: { nflt = 12 }
                nflt = Add(nflt, 1)
            }
        }
        ReturnValue(0)
    }
}

// Float predicates. A compare used as a value stays on the 0/1 path.
// This is only the branch form.

Function.Optimize_IsFloatCmp {
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(StringCompare(name, "Float_Eq"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "Float_Ne"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "Float_Lt"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "Float_Gt"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "Float_Le"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "Float_Ge"), 0) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

// Class 1 is a float home. 6 and 8 are frame or a constant pool slot.
// 7 is the r15 pool. A held xmm0 is not ready: the hold is clear at a branch.

Function.Optimize_XmmReady {
    Input: node: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        Optimize_OpClass(node)
        cls = LoopHome.hit_class
        IfCondition EqualTo(cls, 1) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(cls, 6) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(cls, 7) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(cls, 8) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

// One add, subtract, or multiply of two ready leaves. A multiply stays
// unfused here: the compare is not an assignment the FMA pass can see.

Function.Optimize_FcmpBinReady {
    Input: node: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(node), AST.CALL) ThenBlock: { ReturnValue(0) }
        opk = Optimize_FltOpKind(AST_GetData1(node))
        ok = 0
        IfCondition EqualTo(opk, 1) ThenBlock: { ok = 1 }
        IfCondition EqualTo(opk, 2) ThenBlock: { ok = 1 }
        IfCondition EqualTo(opk, 3) ThenBlock: { ok = 1 }
        IfCondition EqualTo(ok, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetChildCount(node), 2) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_XmmReady(AST_GetChild(node, 0)), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_XmmReady(AST_GetChild(node, 1)), 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(1)
    }
}

Function.Optimize_FloatCmpReady {
    Input: node: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(node), AST.CALL) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_IsFloatCmp(AST_GetData1(node)), 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetChildCount(node), 2) ThenBlock: { ReturnValue(0) }
        left = AST_GetChild(node, 0)
        right = AST_GetChild(node, 1)
        left_bin = Optimize_FcmpBinReady(left)
        right_bin = Optimize_FcmpBinReady(right)
        // The right binop is emitted into xmm0 and moved to xmm1. A binop
        // on both sides would clobber that copy.
        IfCondition EqualTo(left_bin, 1) ThenBlock: {
            IfCondition EqualTo(right_bin, 1) ThenBlock: { ReturnValue(0) }
        }
        left_ok = left_bin
        IfCondition EqualTo(left_ok, 0) ThenBlock: { left_ok = Optimize_XmmReady(left) }
        right_ok = right_bin
        IfCondition EqualTo(right_ok, 0) ThenBlock: { right_ok = Optimize_XmmReady(right) }
        IfCondition EqualTo(left_ok, 1) ThenBlock: {
            IfCondition EqualTo(right_ok, 1) ThenBlock: { ReturnValue(1) }
        }
        ReturnValue(0)
    }
}

// An integer leaf compare, or a float compare of homes and frame slots.
// A computed compare against zero stays on the single-compare path.

Function.Optimize_BranchReady {
    Input: node: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(node), AST.CALL) ThenBlock: { ReturnValue(0) }
        name = AST_GetData1(node)
        IfCondition EqualTo(Optimize_IsCompareName(name), 1) ThenBlock: {
            IfCondition EqualTo(AST_GetChildCount(node), 2) ThenBlock: {
                IfCondition EqualTo(Optimize_IsLeaf(AST_GetChild(node, 0)), 1) ThenBlock: {
                    IfCondition EqualTo(Optimize_IsLeaf(AST_GetChild(node, 1)), 1) ThenBlock: { ReturnValue(1) }
                }
            }
        }
        ReturnValue(Optimize_FloatCmpReady(node))
    }
}

Function.Optimize_EmitFcmpLeaf {
    Input: dst: Integer
    Input: node: Address
    Output: Integer
    Body: {
        Optimize_OpClass(node)
        cls = LoopHome.hit_class
        disp = LoopHome.hit_disp
        xmm = LoopHome.hit_xmm
        IfCondition EqualTo(cls, 1) ThenBlock: {
            X86_XmmBin(16, dst, xmm)
            ReturnValue(1)
        }
        IfCondition EqualTo(cls, 6) ThenBlock: {
            X86_EmitRbpXmm(16, dst, disp)
            ReturnValue(1)
        }
        IfCondition EqualTo(cls, 8) ThenBlock: {
            X86_EmitRbpXmm(16, dst, disp)
            ReturnValue(1)
        }
        IfCondition EqualTo(cls, 7) ThenBlock: {
            X86_EmitR15Xmm(16, dst, disp)
            ReturnValue(1)
        }
        ReturnValue(0)
    }
}

// Apply one SSE op into xmm0. The left side of a compare binop is already there.

Function.Optimize_EmitFcmpApply {
    Input: opcode: Integer
    Input: node: Address
    Output: Integer
    Body: {
        Optimize_OpClass(node)
        cls = LoopHome.hit_class
        disp = LoopHome.hit_disp
        xmm = LoopHome.hit_xmm
        IfCondition EqualTo(cls, 1) ThenBlock: {
            X86_XmmBin(opcode, 0, xmm)
            ReturnValue(1)
        }
        IfCondition EqualTo(cls, 6) ThenBlock: {
            X86_EmitRbpXmm(opcode, 0, disp)
            ReturnValue(1)
        }
        IfCondition EqualTo(cls, 8) ThenBlock: {
            X86_EmitRbpXmm(opcode, 0, disp)
            ReturnValue(1)
        }
        IfCondition EqualTo(cls, 7) ThenBlock: {
            X86_EmitR15Xmm(opcode, 0, disp)
            ReturnValue(1)
        }
        ReturnValue(0)
    }
}

Function.Optimize_EmitFcmpBin {
    Input: node: Address
    Output: Integer
    Body: {
        opk = Optimize_FltOpKind(AST_GetData1(node))
        opc = 88
        IfCondition EqualTo(opk, 2) ThenBlock: { opc = 92 }
        IfCondition EqualTo(opk, 3) ThenBlock: { opc = 89 }
        IfCondition EqualTo(opc, 88) ThenBlock: {
            IfCondition NotEqual(opk, 1) ThenBlock: { ReturnValue(0) }
        }
        IfCondition EqualTo(Optimize_EmitFcmpLeaf(0, AST_GetChild(node, 0)), 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(Optimize_EmitFcmpApply(opc, AST_GetChild(node, 1)))
    }
}

// Right operand of a compare whose left value is already in xmm0.
// A home xmm is the ucomisd source. Anything else is copied to xmm1 first.

Function.Optimize_EmitFcmpAgainst {
    Input: node: Address
    Output: Integer
    Body: {
        Optimize_OpClass(node)
        cls = LoopHome.hit_class
        xmm = LoopHome.hit_xmm
        IfCondition EqualTo(cls, 1) ThenBlock: {
            IfCondition GreaterEqual(xmm, 2) ThenBlock: {
                X86_UcomisdXmm0(xmm)
                ReturnValue(1)
            }
        }
        IfCondition EqualTo(Optimize_EmitFcmpLeaf(1, node), 0) ThenBlock: { ReturnValue(0) }
        X86_UcomisdXmm0Xmm1()
        ReturnValue(1)
    }
}

// False jump for a float compare. LE and LT are false on NaN. GT and GE
// already are, because unordered sets CF. EQ is false on NaN. NE is true
// on NaN, so a parity jump skips the equal jump.

Function.Optimize_EmitFloatCmp {
    Input: node: Address
    Input: false_label: Integer
    Output: Integer
    Body: {
        Optimize_IholdPark()
        Optimize_FlushHold()
        left = AST_GetChild(node, 0)
        right = AST_GetChild(node, 1)
        left_bin = Optimize_FcmpBinReady(left)
        right_bin = Optimize_FcmpBinReady(right)
        paired = 0
        IfCondition EqualTo(left_bin, 1) ThenBlock: {
            IfCondition EqualTo(Optimize_EmitFcmpBin(left), 0) ThenBlock: { ReturnValue(0) }
            IfCondition EqualTo(Optimize_EmitFcmpAgainst(right), 0) ThenBlock: { ReturnValue(0) }
            paired = 1
        }
        IfCondition EqualTo(left_bin, 0) ThenBlock: {
            IfCondition EqualTo(right_bin, 1) ThenBlock: {
                IfCondition EqualTo(Optimize_EmitFcmpBin(right), 0) ThenBlock: { ReturnValue(0) }
                X86_XmmBin(16, 1, 0)
                IfCondition EqualTo(Optimize_EmitFcmpLeaf(0, left), 0) ThenBlock: { ReturnValue(0) }
            }
            IfCondition EqualTo(right_bin, 0) ThenBlock: {
                IfCondition EqualTo(Optimize_EmitFcmpLeaf(0, left), 0) ThenBlock: { ReturnValue(0) }
                IfCondition EqualTo(Optimize_EmitFcmpAgainst(right), 0) ThenBlock: { ReturnValue(0) }
                paired = 1
            }
        }
        IfCondition EqualTo(paired, 0) ThenBlock: {
            X86_UcomisdXmm0Xmm1()
        }
        name = AST_GetData1(node)
        IfCondition EqualTo(StringCompare(name, "Float_Le"), 0) ThenBlock: {
            X86_Ja(false_label)
            X86_Jp(false_label)
            ReturnValue(1)
        }
        IfCondition EqualTo(StringCompare(name, "Float_Lt"), 0) ThenBlock: {
            X86_Jae(false_label)
            X86_Jp(false_label)
            ReturnValue(1)
        }
        IfCondition EqualTo(StringCompare(name, "Float_Gt"), 0) ThenBlock: {
            X86_Jbe(false_label)
            ReturnValue(1)
        }
        IfCondition EqualTo(StringCompare(name, "Float_Ge"), 0) ThenBlock: {
            X86_Jb(false_label)
            ReturnValue(1)
        }
        IfCondition EqualTo(StringCompare(name, "Float_Eq"), 0) ThenBlock: {
            X86_Jne(false_label)
            X86_Jp(false_label)
            ReturnValue(1)
        }
        IfCondition EqualTo(StringCompare(name, "Float_Ne"), 0) ThenBlock: {
            skip = Compile_NewLabel()
            X86_Jp(skip)
            X86_Je(false_label)
            Emit_MarkLabel(skip)
            ReturnValue(1)
        }
        ReturnValue(0)
    }
}

Function.Optimize_EmitFalseJump {
    Input: node: Address
    Input: false_label: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(Optimize_FloatCmpReady(node), 1) ThenBlock: {
            ReturnValue(Optimize_EmitFloatCmp(node, false_label))
        }
        IfCondition EqualTo(Optimize_IsCompareName(AST_GetData1(node)), 0) ThenBlock: { ReturnValue(0) }
        got = CompileCompare_Binary(node)
        IfCondition EqualTo(got, 0) ThenBlock: { ReturnValue(0) }
        Optimize_JumpIfFalse(AST_GetData1(node), false_label)
        ReturnValue(1)
    }
}

// One read-only float into the next free xmm. Repeating this picks every
// invariant. The highest load count wins, so the first call matches the
// old single install.

Function.Optimize_TakeFlt {
    Input: condition: Address
    Input: body: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(LoopHome.no_float, 1) ThenBlock: { ReturnValue(0) }
        free = 0
        IfCondition EqualTo(LoopHome.f2_name, 0) ThenBlock: { free = 1 }
        IfCondition EqualTo(LoopHome.f3_name, 0) ThenBlock: { free = 1 }
        IfCondition EqualTo(LoopHome.f4_name, 0) ThenBlock: { free = 1 }
        IfCondition EqualTo(LoopHome.f5_name, 0) ThenBlock: { free = 1 }
        IfCondition EqualTo(LoopHome.f6_name, 0) ThenBlock: { free = 1 }
        IfCondition LessThan(LoopHome.xf_n, 7) ThenBlock: { free = 1 }
        IfCondition EqualTo(free, 0) ThenBlock: { ReturnValue(0) }
        best = 0
        best_off = 0
        best_loads = 0
        i = 0
        WhileLoop LessThan(i, LoopHome.count) {
            rec = Optimize_HomeRec(i)
            name = Dereference(rec)
            loads = Dereference(Add(rec, 8))
            stores = Dereference(Add(rec, 16))
            IfCondition GreaterThan(loads, 0) ThenBlock: {
                IfCondition EqualTo(stores, 0) ThenBlock: {
                    IfCondition EqualTo(Optimize_NameTaken(name), 0) ThenBlock: {
                        skip = 0
                        IfCondition EqualTo(LoopHome.tab_on, 1) ThenBlock: {
                            IfCondition EqualTo(Optimize_NameEq(name, LoopHome.tab_name), 1) ThenBlock: { skip = 1 }
                        }
                        IfCondition EqualTo(LoopHome.lim_on, 1) ThenBlock: {
                            IfCondition EqualTo(Optimize_NameEq(name, LoopHome.lim_name), 1) ThenBlock: { skip = 1 }
                        }
                        IfCondition EqualTo(skip, 0) ThenBlock: {
                            IfCondition EqualTo(Optimize_FrameOff(name), 1) ThenBlock: {
                                off = LoopHome.imm_val
                                IfCondition GreaterThan(loads, best_loads) ThenBlock: {
                                    IfCondition EqualTo(Optimize_InvOk(name, 1, condition, body), 1) ThenBlock: {
                                        best = name
                                        best_off = off
                                        best_loads = loads
                                    }
                                }
                            }
                        }
                    }
                }
            }
            i = Add(i, 1)
        }
        IfCondition EqualTo(best, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(LoopHome.f2_name, 0) ThenBlock: {
            LoopHome.f2_name = best
            LoopHome.f2_off = best_off
            ReturnValue(1)
        }
        IfCondition EqualTo(LoopHome.f3_name, 0) ThenBlock: {
            LoopHome.f3_name = best
            LoopHome.f3_off = best_off
            ReturnValue(1)
        }
        IfCondition EqualTo(LoopHome.f4_name, 0) ThenBlock: {
            LoopHome.f4_name = best
            LoopHome.f4_off = best_off
            ReturnValue(1)
        }
        IfCondition EqualTo(LoopHome.f5_name, 0) ThenBlock: {
            LoopHome.f5_name = best
            LoopHome.f5_off = best_off
            ReturnValue(1)
        }
        IfCondition EqualTo(LoopHome.f6_name, 0) ThenBlock: {
            LoopHome.f6_name = best
            LoopHome.f6_off = best_off
            ReturnValue(1)
        }
        ReturnValue(Optimize_XfInstall(best, best_off))
    }
}

// One outstanding integer temp. It stays in rax, or moves to rbx when the
// next instruction needs rax. The frame slot is written before anything
// that would read the slot or clobber both registers.

Function.Optimize_IholdClear {
    Output: Integer
    Body: {
        LoopHome.ihold_on = 0
        LoopHome.ihold_name = 0
        LoopHome.ihold_off = 0
        LoopHome.ihold_reg = 0
        ReturnValue(0)
    }
}

Function.Optimize_IholdFlush {
    Output: Integer
    Body: {
        IfCondition EqualTo(LoopHome.ihold_on, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(LoopHome.ihold_reg, 3) ThenBlock: {
            Emit_MovRaxRbx()
        }
        Emit_MovRbpOffsetRax(LoopHome.ihold_off)
        Optimize_IholdClear()
        ReturnValue(0)
    }
}

Function.Optimize_IholdPark {
    Output: Integer
    Body: {
        IfCondition EqualTo(LoopHome.ihold_on, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(LoopHome.ihold_reg, 3) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(LoopHome.ihold_reg, 0) ThenBlock: {
            IfCondition EqualTo(LoopHome.rbx_scratch, 1) ThenBlock: {
                Emit_MovRbxRax()
                LoopHome.ihold_reg = 3
                ReturnValue(0)
            }
        }
        Optimize_IholdFlush()
        ReturnValue(0)
    }
}

// A call that lowers through rbx, or a real call, cannot keep the byte there.

Function.Optimize_RbxName {
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(StringCompare(name, "GetByte"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "SetByte"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "StoreValue"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "Modulo"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "Divide"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "Dereference"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "Float_Abs"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(Optimize_IsMathOp(name), 1) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(Optimize_HomeCallOk(name), 0) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

Function.Optimize_NeedsRbx {
    Input: node: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(AST_GetType(node), AST.CALL) ThenBlock: {
            IfCondition EqualTo(Optimize_RbxName(AST_GetData1(node)), 1) ThenBlock: { ReturnValue(1) }
        }
        count = AST_GetChildCount(node)
        i = 0
        WhileLoop LessThan(i, count) {
            IfCondition EqualTo(Optimize_NeedsRbx(AST_GetChild(node, i)), 1) ThenBlock: { ReturnValue(1) }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

Function.Optimize_IholdMakeRoom {
    Input: node: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(LoopHome.ihold_on, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_TreeHasIdent(node, LoopHome.ihold_name), 1) ThenBlock: {
            Optimize_IholdFlush()
            ReturnValue(0)
        }
        IfCondition EqualTo(Optimize_NeedsRbx(node), 1) ThenBlock: {
            Optimize_IholdFlush()
            ReturnValue(0)
        }
        Optimize_IholdPark()
        ReturnValue(0)
    }
}

Function.Optimize_IdentName {
    Input: node: Address
    Output: Address
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(node), AST.IDENTIFIER) ThenBlock: { ReturnValue(0) }
        ReturnValue(AST_GetData1(node))
    }
}

Function.Optimize_LogicComm {
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(StringCompare(name, "Add"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "BitwiseXor"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "BitXor"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "BitwiseOr"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "BitOr"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "BitwiseAnd"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "BitAnd"), 0) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

// The acc is already chosen, but active is still 0 while homes are picked.
// IsAccHome would refuse. Compare the name.

Function.Optimize_AccName {
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(LoopHome.acc_name, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_NameEq(name, LoopHome.acc_name), 1) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

Function.Optimize_IholdShape {
    Input: st: Address
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(st, 0) ThenBlock: { ReturnValue(0) }
        nt = AST_GetType(st)
        IfCondition EqualTo(nt, AST.CALL) ThenBlock: {
            IfCondition EqualTo(StringCompare(AST_GetData1(st), "SetByte"), 0) ThenBlock: {
                IfCondition GreaterEqual(AST_GetChildCount(st), 3) ThenBlock: {
                    IfCondition EqualTo(Optimize_NameEq(Optimize_IdentName(AST_GetChild(st, 1)), name), 1) ThenBlock: { ReturnValue(1) }
                    IfCondition EqualTo(Optimize_NameEq(Optimize_IdentName(AST_GetChild(st, 2)), name), 1) ThenBlock: { ReturnValue(1) }
                }
            }
            ReturnValue(0)
        }
        IfCondition NotEqual(nt, AST.ASSIGNMENT) ThenBlock: { ReturnValue(0) }
        value = AST_GetChild(st, 0)
        IfCondition EqualTo(value, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(value), AST.CALL) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetChildCount(value), 2) ThenBlock: { ReturnValue(0) }
        op = AST_GetData1(value)
        IfCondition EqualTo(StringCompare(op, "GetByte"), 0) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(Optimize_IdentName(AST_GetChild(value, 1)), name), 1) ThenBlock: { ReturnValue(1) }
            ReturnValue(0)
        }
        IfCondition EqualTo(Optimize_AccName(AST_GetData1(st)), 0) ThenBlock: { ReturnValue(0) }
        left = AST_GetChild(value, 0)
        right = AST_GetChild(value, 1)
        ln = Optimize_IdentName(left)
        rn = Optimize_IdentName(right)
        IfCondition EqualTo(Optimize_LogicComm(op), 1) ThenBlock: {
            hit = 0
            IfCondition EqualTo(Optimize_AccName(ln), 1) ThenBlock: {
                IfCondition EqualTo(Optimize_NameEq(rn, name), 1) ThenBlock: { hit = 1 }
            }
            IfCondition EqualTo(Optimize_AccName(rn), 1) ThenBlock: {
                IfCondition EqualTo(Optimize_NameEq(ln, name), 1) ThenBlock: { hit = 1 }
            }
            ReturnValue(hit)
        }
        IfCondition EqualTo(StringCompare(op, "Subtract"), 0) ThenBlock: {
            IfCondition EqualTo(Optimize_AccName(ln), 0) ThenBlock: { ReturnValue(0) }
            IfCondition EqualTo(Optimize_NameEq(rn, name), 1) ThenBlock: { ReturnValue(1) }
        }
        ReturnValue(0)
    }
}

Function.Optimize_IholdUseOk {
    Input: name: Address
    Output: Integer
    Body: {
        body = LoopHome.body
        IfCondition EqualTo(body, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(body), AST.BLOCK) ThenBlock: { ReturnValue(0) }
        count = AST_GetChildCount(body)
        def_at = -1
        use_at = -1
        use_st = 0
        i = 0
        WhileLoop LessThan(i, count) {
            st = AST_GetChild(body, i)
            IfCondition NotEqual(st, 0) ThenBlock: {
                IfCondition EqualTo(AST_GetType(st), AST.ASSIGNMENT) ThenBlock: {
                    IfCondition EqualTo(Optimize_NameEq(AST_GetData1(st), name), 1) ThenBlock: {
                        IfCondition LessThan(def_at, 0) ThenBlock: { def_at = i }
                    }
                }
                IfCondition EqualTo(Optimize_TreeHasIdent(st, name), 1) ThenBlock: {
                    IfCondition LessThan(use_at, 0) ThenBlock: {
                        use_at = i
                        use_st = st
                    }
                }
            }
            i = Add(i, 1)
        }
        IfCondition LessThan(def_at, 0) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterThan(use_at, def_at) ThenBlock: {
            ReturnValue(Optimize_IholdShape(use_st, name))
        }
        ReturnValue(0)
    }
}

Function.Optimize_ShouldIhold {
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(LoopHome.active, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_NameTaken(name), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_HoldOk(name), 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(LoopHome.cond, 0) ThenBlock: {
            IfCondition EqualTo(Optimize_NodeReads(LoopHome.cond, name), 1) ThenBlock: { ReturnValue(0) }
        }
        ReturnValue(Optimize_IholdUseOk(name))
    }
}

Function.Optimize_IholdArm {
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(Optimize_ShouldIhold(name), 0) ThenBlock: { ReturnValue(0) }
        off = 0
        IfCondition EqualTo(Optimize_FrameOff(name), 1) ThenBlock: {
            off = LoopHome.imm_val
        } ElseBlock: {
            rt = Scope.resolve_type
            IfCondition NotEqual(rt, 0) ThenBlock: { ReturnValue(0) }
            off = Optimize_EnsureSlot(name)
            IfCondition GreaterEqual(off, 0) ThenBlock: { ReturnValue(0) }
        }
        IfCondition GreaterEqual(off, 0) ThenBlock: { ReturnValue(0) }
        LoopHome.ihold_on = 1
        LoopHome.ihold_name = name
        LoopHome.ihold_off = off
        LoopHome.ihold_reg = 0
        ReturnValue(1)
    }
}

Function.Optimize_TryIntHold {
    Input: target: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(LoopHome.ihold_on, 1) ThenBlock: { ReturnValue(0) }
        ReturnValue(Optimize_IholdArm(target))
    }
}

Function.Optimize_EmitAccOp {
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(StringCompare(name, "Add"), 0) ThenBlock: {
            X86_AddRegReg(12, 0)
            ReturnValue(1)
        }
        IfCondition EqualTo(StringCompare(name, "Subtract"), 0) ThenBlock: {
            X86_SubRegReg(12, 0)
            ReturnValue(1)
        }
        IfCondition EqualTo(StringCompare(name, "BitwiseXor"), 0) ThenBlock: {
            X86_XorRegReg(12, 0)
            ReturnValue(1)
        }
        IfCondition EqualTo(StringCompare(name, "BitXor"), 0) ThenBlock: {
            X86_XorRegReg(12, 0)
            ReturnValue(1)
        }
        IfCondition EqualTo(StringCompare(name, "BitwiseOr"), 0) ThenBlock: {
            X86_OrRegReg(12, 0)
            ReturnValue(1)
        }
        IfCondition EqualTo(StringCompare(name, "BitOr"), 0) ThenBlock: {
            X86_OrRegReg(12, 0)
            ReturnValue(1)
        }
        IfCondition EqualTo(StringCompare(name, "BitwiseAnd"), 0) ThenBlock: {
            X86_AndRegReg(12, 0)
            ReturnValue(1)
        }
        IfCondition EqualTo(StringCompare(name, "BitAnd"), 0) ThenBlock: {
            X86_AndRegReg(12, 0)
            ReturnValue(1)
        }
        ReturnValue(0)
    }
}

// acc = acc op held, or acc = acc * parked multiplier. The multiply does
// not read rax or rbx, so a live byte hold survives it.

Function.Optimize_TryAccLogic {
    Input: target: Address
    Input: value: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(Optimize_IsAccHome(target), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(value, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(value), AST.CALL) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetChildCount(value), 2) ThenBlock: { ReturnValue(0) }
        op = AST_GetData1(value)
        left = AST_GetChild(value, 0)
        right = AST_GetChild(value, 1)
        ln = Optimize_IdentName(left)
        rn = Optimize_IdentName(right)
        IfCondition EqualTo(StringCompare(op, "Multiply"), 0) ThenBlock: {
            IfCondition EqualTo(LoopHome.kmul_on, 0) ThenBlock: { ReturnValue(0) }
            pair = 0
            IfCondition EqualTo(Optimize_AccName(ln), 1) ThenBlock: {
                IfCondition EqualTo(Optimize_NameEq(rn, LoopHome.kmul_name), 1) ThenBlock: { pair = 1 }
            }
            IfCondition EqualTo(Optimize_AccName(rn), 1) ThenBlock: {
                IfCondition EqualTo(Optimize_NameEq(ln, LoopHome.kmul_name), 1) ThenBlock: { pair = 1 }
            }
            IfCondition EqualTo(pair, 0) ThenBlock: { ReturnValue(0) }
            X86_ImulRegReg(12, 11)
            ReturnValue(1)
        }
        IfCondition EqualTo(LoopHome.ihold_on, 0) ThenBlock: { ReturnValue(0) }
        comm = Optimize_LogicComm(op)
        sub = 0
        IfCondition EqualTo(StringCompare(op, "Subtract"), 0) ThenBlock: { sub = 1 }
        IfCondition EqualTo(comm, 0) ThenBlock: {
            IfCondition EqualTo(sub, 0) ThenBlock: { ReturnValue(0) }
        }
        pair = 0
        IfCondition EqualTo(comm, 1) ThenBlock: {
            IfCondition EqualTo(Optimize_AccName(ln), 1) ThenBlock: {
                IfCondition EqualTo(Optimize_NameEq(rn, LoopHome.ihold_name), 1) ThenBlock: { pair = 1 }
            }
            IfCondition EqualTo(Optimize_AccName(rn), 1) ThenBlock: {
                IfCondition EqualTo(Optimize_NameEq(ln, LoopHome.ihold_name), 1) ThenBlock: { pair = 1 }
            }
        }
        IfCondition EqualTo(sub, 1) ThenBlock: {
            IfCondition EqualTo(Optimize_AccName(ln), 1) ThenBlock: {
                IfCondition EqualTo(Optimize_NameEq(rn, LoopHome.ihold_name), 1) ThenBlock: { pair = 1 }
            }
        }
        IfCondition EqualTo(pair, 0) ThenBlock: { ReturnValue(0) }
        reg = LoopHome.ihold_reg
        IfCondition EqualTo(reg, 3) ThenBlock: { Emit_MovRaxRbx() }
        IfCondition NotEqual(reg, 0) ThenBlock: {
            IfCondition NotEqual(reg, 3) ThenBlock: { ReturnValue(0) }
        }
        IfCondition EqualTo(Optimize_EmitAccOp(op), 0) ThenBlock: { ReturnValue(0) }
        Optimize_IholdClear()
        ReturnValue(1)
    }
}

// Index register for a byte address. 0 is rax, so failure is -1.

Function.Optimize_IndexReg {
    Input: node: Address
    Output: Integer
    Body: {
        name = Optimize_IdentName(node)
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition EqualTo(LoopHome.ihold_on, 1) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(name, LoopHome.ihold_name), 1) ThenBlock: {
                ReturnValue(LoopHome.ihold_reg)
            }
        }
        IfCondition EqualTo(Optimize_IsIntHome(name), 1) ThenBlock: { ReturnValue(13) }
        IfCondition EqualTo(Optimize_IsAccHome(name), 1) ThenBlock: { ReturnValue(12) }
        ReturnValue(-1)
    }
}

Function.Optimize_SibOk {
    Input: base: Integer
    Input: index: Integer
    Output: Integer
    Body: {
        bok = 0
        IfCondition EqualTo(base, 1) ThenBlock: { bok = 1 }
        IfCondition EqualTo(base, 14) ThenBlock: { bok = 1 }
        IfCondition EqualTo(bok, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(index, 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(index, 3) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(index, 12) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(index, 13) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

// r14 when this is the parked byte base. rcx reloads any other frame slot.
// A register home is stale in the frame, so that base stays on the slow path.

Function.Optimize_PrepBase {
    Input: node: Address
    Output: Integer
    Body: {
        name = Optimize_IdentName(node)
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(LoopHome.ihold_on, 1) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(name, LoopHome.ihold_name), 1) ThenBlock: { ReturnValue(0) }
        }
        IfCondition EqualTo(Optimize_NameTaken(name), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(LoopHome.tab_on, 1) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(name, LoopHome.tab_name), 1) ThenBlock: {
                LoopHome.hit_class = 14
                LoopHome.hit_disp = LoopHome.tab_off
                ReturnValue(1)
            }
        }
        IfCondition EqualTo(Optimize_FrameOff(name), 0) ThenBlock: { ReturnValue(0) }
        LoopHome.hit_class = 1
        LoopHome.hit_disp = LoopHome.imm_val
        ReturnValue(1)
    }
}

Function.Optimize_PrepGet {
    Input: node: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(LoopHome.active, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(node), AST.CALL) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(StringCompare(AST_GetData1(node), "GetByte"), 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetChildCount(node), 2) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_PrepBase(AST_GetChild(node, 0)), 0) ThenBlock: { ReturnValue(0) }
        ireg = Optimize_IndexReg(AST_GetChild(node, 1))
        IfCondition EqualTo(Optimize_SibOk(LoopHome.hit_class, ireg), 0) ThenBlock: { ReturnValue(0) }
        LoopHome.hit_xmm = ireg
        ReturnValue(1)
    }
}

// Mode in the return value. Mode 5 leaves the frame offset in imm_ok.
// 1 rax, 2 rbx, 3 r13, 4 r12, 5 frame. 0 is not a fast value.

Function.Optimize_ByteValueMode {
    Input: node: Address
    Output: Integer
    Body: {
        LoopHome.imm_ok = 0
        name = Optimize_IdentName(node)
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(LoopHome.ihold_on, 1) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(name, LoopHome.ihold_name), 1) ThenBlock: {
                IfCondition EqualTo(LoopHome.ihold_reg, 0) ThenBlock: { ReturnValue(1) }
                IfCondition EqualTo(LoopHome.ihold_reg, 3) ThenBlock: { ReturnValue(2) }
                ReturnValue(0)
            }
        }
        IfCondition EqualTo(Optimize_IsIntHome(name), 1) ThenBlock: { ReturnValue(3) }
        IfCondition EqualTo(Optimize_IsAccHome(name), 1) ThenBlock: { ReturnValue(4) }
        IfCondition EqualTo(Optimize_IsFltHome(name), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_FrameOff(name), 0) ThenBlock: { ReturnValue(0) }
        LoopHome.imm_ok = LoopHome.imm_val
        ReturnValue(5)
    }
}

Function.Optimize_PrepSet {
    Input: node: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(LoopHome.active, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(node), AST.CALL) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(StringCompare(AST_GetData1(node), "SetByte"), 0) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(AST_GetChildCount(node), 3) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_PrepBase(AST_GetChild(node, 0)), 0) ThenBlock: { ReturnValue(0) }
        base = LoopHome.hit_class
        disp = LoopHome.hit_disp
        ireg = Optimize_IndexReg(AST_GetChild(node, 1))
        mode = Optimize_ByteValueMode(AST_GetChild(node, 2))
        voff = LoopHome.imm_ok
        IfCondition EqualTo(mode, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_SibOk(base, ireg), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(mode, 3) ThenBlock: {
            IfCondition EqualTo(ireg, 13) ThenBlock: { ReturnValue(0) }
        }
        IfCondition EqualTo(mode, 4) ThenBlock: {
            IfCondition EqualTo(ireg, 12) ThenBlock: { ReturnValue(0) }
        }
        IfCondition EqualTo(mode, 5) ThenBlock: {
            IfCondition EqualTo(ireg, 0) ThenBlock: { ReturnValue(0) }
        }
        IfCondition EqualTo(mode, 2) ThenBlock: {
            IfCondition EqualTo(ireg, 0) ThenBlock: { ReturnValue(0) }
        }
        IfCondition EqualTo(mode, 1) ThenBlock: {
            IfCondition EqualTo(ireg, 0) ThenBlock: {
                vn = Optimize_IdentName(AST_GetChild(node, 2))
                iname = Optimize_IdentName(AST_GetChild(node, 1))
                IfCondition EqualTo(Optimize_NameEq(vn, iname), 0) ThenBlock: { ReturnValue(0) }
            }
        }
        LoopHome.hit_class = base
        LoopHome.hit_disp = disp
        LoopHome.hit_xmm = ireg
        LoopHome.imm_val = mode
        LoopHome.imm_ok = voff
        ReturnValue(1)
    }
}

Function.Optimize_TryEmitGetByte {
    Input: node: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(Optimize_PrepGet(node), 0) ThenBlock: { ReturnValue(0) }
        base = LoopHome.hit_class
        disp = LoopHome.hit_disp
        ireg = LoopHome.hit_xmm
        held = 0
        idx_name = Optimize_IdentName(AST_GetChild(node, 1))
        IfCondition EqualTo(LoopHome.ihold_on, 1) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(idx_name, LoopHome.ihold_name), 1) ThenBlock: {
                held = 1
            }
        }
        IfCondition EqualTo(held, 0) ThenBlock: {
            IfCondition EqualTo(LoopHome.ihold_on, 1) ThenBlock: {
                IfCondition EqualTo(LoopHome.ihold_reg, 0) ThenBlock: {
                    Optimize_IholdPark()
                }
            }
        }
        IfCondition EqualTo(base, 1) ThenBlock: {
            X86_MovRcxRbpOffset(disp)
        }
        X86_SibByte(1, base, ireg)
        IfCondition EqualTo(held, 1) ThenBlock: {
            Optimize_IholdClear()
        }
        ReturnValue(1)
    }
}

Function.Optimize_TryEmitSetByte {
    Input: node: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(Optimize_PrepSet(node), 0) ThenBlock: { ReturnValue(0) }
        base = LoopHome.hit_class
        disp = LoopHome.hit_disp
        ireg = LoopHome.hit_xmm
        mode = LoopHome.imm_val
        voff = LoopHome.imm_ok
        consume = 0
        IfCondition EqualTo(LoopHome.ihold_on, 1) ThenBlock: {
            n1 = Optimize_IdentName(AST_GetChild(node, 1))
            n2 = Optimize_IdentName(AST_GetChild(node, 2))
            IfCondition EqualTo(Optimize_NameEq(n1, LoopHome.ihold_name), 1) ThenBlock: { consume = 1 }
            IfCondition EqualTo(Optimize_NameEq(n2, LoopHome.ihold_name), 1) ThenBlock: { consume = 1 }
        }
        IfCondition EqualTo(base, 1) ThenBlock: {
            X86_MovRcxRbpOffset(disp)
        }
        IfCondition EqualTo(mode, 2) ThenBlock: { Emit_MovRaxRbx() }
        IfCondition EqualTo(mode, 3) ThenBlock: { Emit_HomeMove(1, 0) }
        IfCondition EqualTo(mode, 4) ThenBlock: { Emit_HomeMove(16, 0) }
        IfCondition EqualTo(mode, 5) ThenBlock: { Emit_MovRaxRbpOffset(voff) }
        X86_SibByte(2, base, ireg)
        IfCondition EqualTo(consume, 1) ThenBlock: { Optimize_IholdClear() }
        ReturnValue(1)
    }
}

Function.Optimize_TryGetByteAssign {
    Input: target: Address
    Input: value: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(Optimize_TryEmitGetByte(value), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(LoopHome.ihold_on, 1) ThenBlock: {
            CompileExpr_StoreVariable(target)
            ReturnValue(1)
        }
        IfCondition EqualTo(Optimize_IholdArm(target), 1) ThenBlock: { ReturnValue(1) }
        CompileExpr_StoreVariable(target)
        ReturnValue(1)
    }
}

Function.Optimize_KeepIhold {
    Input: node: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(LoopHome.ihold_on, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(node), AST.CALL) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(StringCompare(AST_GetData1(node), "SetByte"), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_PrepSet(node), 0) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(AST_GetChildCount(node), 3) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_NameEq(Optimize_IdentName(AST_GetChild(node, 1)), LoopHome.ihold_name), 1) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(Optimize_NameEq(Optimize_IdentName(AST_GetChild(node, 2)), LoopHome.ihold_name), 1) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

Function.Optimize_CountByteBase {
    Input: node: Address
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        n = 0
        IfCondition EqualTo(AST_GetType(node), AST.CALL) ThenBlock: {
            op = AST_GetData1(node)
            hit = 0
            IfCondition EqualTo(StringCompare(op, "GetByte"), 0) ThenBlock: { hit = 1 }
            IfCondition EqualTo(StringCompare(op, "SetByte"), 0) ThenBlock: { hit = 1 }
            IfCondition EqualTo(hit, 1) ThenBlock: {
                IfCondition GreaterThan(AST_GetChildCount(node), 0) ThenBlock: {
                    IfCondition EqualTo(Optimize_NameEq(Optimize_IdentName(AST_GetChild(node, 0)), name), 1) ThenBlock: {
                        n = 1
                    }
                }
            }
        }
        count = AST_GetChildCount(node)
        i = 0
        WhileLoop LessThan(i, count) {
            n = Add(n, Optimize_CountByteBase(AST_GetChild(node, i), name))
            i = Add(i, 1)
        }
        ReturnValue(n)
    }
}

// Hottest read-only GetByte or SetByte base, and only when no qword table
// already owns r14. The fields are set directly so a rejected name cannot
// mark every table as many.

Function.Optimize_PickByteBase {
    Input: body: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(LoopHome.tab_on, 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(LoopHome.tab_many, 1) ThenBlock: { ReturnValue(0) }
        best = 0
        best_n = 0
        best_off = 0
        i = 0
        WhileLoop LessThan(i, LoopHome.count) {
            rec = Optimize_HomeRec(i)
            name = Dereference(rec)
            loads = Dereference(Add(rec, 8))
            stores = Dereference(Add(rec, 16))
            IfCondition GreaterThan(loads, 0) ThenBlock: {
                IfCondition EqualTo(stores, 0) ThenBlock: {
                    IfCondition EqualTo(Optimize_NameTaken(name), 0) ThenBlock: {
                        skip = 0
                        IfCondition EqualTo(LoopHome.lim_on, 1) ThenBlock: {
                            IfCondition EqualTo(Optimize_NameEq(name, LoopHome.lim_name), 1) ThenBlock: { skip = 1 }
                        }
                        IfCondition EqualTo(skip, 0) ThenBlock: {
                            n = Optimize_CountByteBase(body, name)
                            IfCondition GreaterThan(n, best_n) ThenBlock: {
                                best = name
                                best_n = n
                            }
                        }
                    }
                }
            }
            i = Add(i, 1)
        }
        IfCondition EqualTo(best, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_AssignsName(body, best), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_FrameOff(best), 0) ThenBlock: { ReturnValue(0) }
        best_off = LoopHome.imm_val
        LoopHome.tab_on = 1
        LoopHome.tab_name = best
        LoopHome.tab_off = best_off
        ReturnValue(1)
    }
}

Function.Optimize_KmulSkip {
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(Optimize_NameTaken(name), 1) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(LoopHome.lim_on, 1) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(name, LoopHome.lim_name), 1) ThenBlock: { ReturnValue(1) }
        }
        IfCondition EqualTo(LoopHome.tab_on, 1) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(name, LoopHome.tab_name), 1) ThenBlock: { ReturnValue(1) }
        }
        ReturnValue(0)
    }
}

// kmul_on 2 is a conflict found while walking. NoteRbxScratch overwrites
// rbx_scratch after this returns, so the walk does not borrow that field.

Function.Optimize_KmulSee {
    Input: name: Address
    Input: condition: Address
    Input: body: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(LoopHome.kmul_on, 2) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_KmulSkip(name), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_AssignsName(body, name), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_InvOk(name, 2, condition, body), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_FrameOff(name), 0) ThenBlock: { ReturnValue(0) }
        off = LoopHome.imm_val
        IfCondition EqualTo(LoopHome.kmul_name, 0) ThenBlock: {
            LoopHome.kmul_on = 1
            LoopHome.kmul_name = name
            LoopHome.kmul_off = off
            ReturnValue(1)
        }
        IfCondition EqualTo(Optimize_NameEq(name, LoopHome.kmul_name), 0) ThenBlock: {
            LoopHome.kmul_on = 2
            LoopHome.kmul_name = 0
            LoopHome.kmul_off = 0
        }
        ReturnValue(0)
    }
}

Function.Optimize_KmulWalk {
    Input: node: Address
    Input: condition: Address
    Input: body: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(LoopHome.kmul_on, 2) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(AST_GetType(node), AST.ASSIGNMENT) ThenBlock: {
            IfCondition EqualTo(AST_GetData2(node), 0) ThenBlock: {
                IfCondition EqualTo(Optimize_AccName(AST_GetData1(node)), 1) ThenBlock: {
                    value = AST_GetChild(node, 0)
                    IfCondition NotEqual(value, 0) ThenBlock: {
                        IfCondition EqualTo(AST_GetType(value), AST.CALL) ThenBlock: {
                            IfCondition EqualTo(StringCompare(AST_GetData1(value), "Multiply"), 0) ThenBlock: {
                                IfCondition EqualTo(AST_GetChildCount(value), 2) ThenBlock: {
                                    ln = Optimize_IdentName(AST_GetChild(value, 0))
                                    rn = Optimize_IdentName(AST_GetChild(value, 1))
                                    other = 0
                                    IfCondition EqualTo(Optimize_AccName(ln), 1) ThenBlock: { other = rn }
                                    IfCondition EqualTo(Optimize_AccName(rn), 1) ThenBlock: {
                                        IfCondition EqualTo(Optimize_AccName(ln), 0) ThenBlock: { other = ln }
                                    }
                                    IfCondition NotEqual(other, 0) ThenBlock: {
                                        Optimize_KmulSee(other, condition, body)
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        count = AST_GetChildCount(node)
        i = 0
        WhileLoop LessThan(i, count) {
            Optimize_KmulWalk(AST_GetChild(node, i), condition, body)
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

Function.Optimize_PickKmul {
    Input: condition: Address
    Input: body: Address
    Output: Integer
    Body: {
        LoopHome.kmul_on = 0
        LoopHome.kmul_name = 0
        LoopHome.kmul_off = 0
        IfCondition EqualTo(LoopHome.has_call, 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(LoopHome.prod_on, 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(LoopHome.der_on, 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(LoopHome.ip0_on, 1) ThenBlock: {
            IfCondition EqualTo(LoopHome.ip0_reg, 11) ThenBlock: { ReturnValue(0) }
        }
        IfCondition EqualTo(LoopHome.ip1_on, 1) ThenBlock: {
            IfCondition EqualTo(LoopHome.ip1_reg, 11) ThenBlock: { ReturnValue(0) }
        }
        IfCondition EqualTo(Optimize_TreeHasAsm(body), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_TreeHasAsm(condition), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(LoopHome.acc_name, 0) ThenBlock: { ReturnValue(0) }
        Optimize_KmulWalk(body, condition, body)
        IfCondition NotEqual(LoopHome.kmul_on, 1) ThenBlock: {
            LoopHome.kmul_on = 0
            LoopHome.kmul_name = 0
            LoopHome.kmul_off = 0
            ReturnValue(0)
        }
        ReturnValue(1)
    }
}

Function.Optimize_TreeHasDiv {
    Input: node: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(AST_GetType(node), AST.CALL) ThenBlock: {
            op = AST_GetData1(node)
            IfCondition EqualTo(StringCompare(op, "Modulo"), 0) ThenBlock: { ReturnValue(1) }
            IfCondition EqualTo(StringCompare(op, "Divide"), 0) ThenBlock: { ReturnValue(1) }
        }
        count = AST_GetChildCount(node)
        i = 0
        WhileLoop LessThan(i, count) {
            IfCondition EqualTo(Optimize_TreeHasDiv(AST_GetChild(node, i)), 1) ThenBlock: { ReturnValue(1) }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

// rbx can hold one byte only when the limit is not already there and the
// loop does not divide. Magic modulo and the parked bound both use rbx.

Function.Optimize_NoteRbxScratch {
    Input: condition: Address
    Input: body: Address
    Output: Integer
    Body: {
        LoopHome.rbx_scratch = 0
        IfCondition EqualTo(LoopHome.rbx_free, 1) ThenBlock: {
            IfCondition EqualTo(LoopHome.lim_on, 1) ThenBlock: { ReturnValue(0) }
        }
        IfCondition EqualTo(Optimize_TreeHasDiv(body), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_TreeHasDiv(condition), 1) ThenBlock: { ReturnValue(0) }
        LoopHome.rbx_scratch = 1
        ReturnValue(1)
    }
}

// A one-use float temp is computed in the consumer's xmm. The consumer then
// applies its other operand there. Sub and div keep the temp on the left.
// A temp that already has a home, or a consumer that still needs the old
// destination, stays on the ordinary path so the two roundings are unchanged.

Function.Optimize_FwdClear {
    Output: Integer
    Body: {
        LoopHome.fwd_on = 0
        LoopHome.fwd_name = 0
        LoopHome.fwd_slot = 0
        LoopHome.fwd_use = 0
        ReturnValue(0)
    }
}

Function.Optimize_FwdFail {
    Output: Integer
    Body: {
        PrintMessage("[COMPILE ERROR] float forward lost its consumer\n")
        Compile.error = 1
        Optimize_FwdClear()
        ReturnValue(1)
    }
}

Function.Optimize_FwdNext {
    Input: target: Address
    Input: value: Address
    Output: Address
    Body: {
        body = LoopHome.body
        IfCondition EqualTo(body, 0) ThenBlock: { ReturnValue(0) }
        blk = 0
        IfCondition EqualTo(AST_GetType(body), AST.BLOCK) ThenBlock: { blk = 1 }
        IfCondition EqualTo(AST_GetType(body), AST.BODY) ThenBlock: { blk = 1 }
        IfCondition EqualTo(blk, 0) ThenBlock: { ReturnValue(0) }
        count = AST_GetChildCount(body)
        found = -1
        i = 0
        WhileLoop LessThan(i, count) {
            st = AST_GetChild(body, i)
            IfCondition NotEqual(st, 0) ThenBlock: {
                IfCondition EqualTo(AST_GetType(st), AST.ASSIGNMENT) ThenBlock: {
                    IfCondition EqualTo(AST_GetData2(st), 0) ThenBlock: {
                        IfCondition EqualTo(Optimize_NameEq(AST_GetData1(st), target), 1) ThenBlock: {
                            IfCondition EqualTo(AST_GetChild(st, 0), value) ThenBlock: {
                                found = i
                                i = count
                            }
                        }
                    }
                }
            }
            i = Add(i, 1)
        }
        IfCondition LessThan(found, 0) ThenBlock: { ReturnValue(0) }
        nxt = Add(found, 1)
        IfCondition GreaterEqual(nxt, count) ThenBlock: { ReturnValue(0) }
        use = AST_GetChild(body, nxt)
        IfCondition EqualTo(use, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(use), AST.ASSIGNMENT) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetData2(use), 0) ThenBlock: { ReturnValue(0) }
        rhs = AST_GetChild(use, 0)
        IfCondition EqualTo(rhs, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(rhs), AST.CALL) ThenBlock: { ReturnValue(0) }
        opk = Optimize_FltOpKind(AST_GetData1(rhs))
        IfCondition EqualTo(opk, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetChildCount(rhs), 2) ThenBlock: { ReturnValue(0) }
        left = AST_GetChild(rhs, 0)
        right = AST_GetChild(rhs, 1)
        side = -1
        IfCondition EqualTo(Optimize_IdentEq(left, target), 1) ThenBlock: { side = 0 }
        IfCondition EqualTo(Optimize_IdentEq(right, target), 1) ThenBlock: {
            IfCondition GreaterEqual(side, 0) ThenBlock: { ReturnValue(0) }
            side = 1
        }
        IfCondition LessThan(side, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(opk, 2) ThenBlock: {
            IfCondition NotEqual(side, 0) ThenBlock: { ReturnValue(0) }
        }
        IfCondition EqualTo(opk, 4) ThenBlock: {
            IfCondition NotEqual(side, 0) ThenBlock: { ReturnValue(0) }
        }
        other = right
        IfCondition EqualTo(side, 1) ThenBlock: { other = left }
        IfCondition EqualTo(Optimize_TreeHasIdent(other, target), 1) ThenBlock: { ReturnValue(0) }
        dest = AST_GetData1(use)
        IfCondition EqualTo(dest, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_NameEq(dest, target), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_IsFltHome(dest), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_IsFltHome(target), 1) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterThan(Optimize_CoalFind(dest), 0) ThenBlock: { ReturnValue(0) }
        slot = Optimize_FltSlot(dest)
        IfCondition LessThan(slot, 2) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_CoalBusy(slot, dest), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_TreeHasIdent(value, dest), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_TreeHasIdent(other, dest), 1) ThenBlock: { ReturnValue(0) }
        LoopHome.fwd_slot = slot
        LoopHome.fwd_use = rhs
        ReturnValue(use)
    }
}

Function.Optimize_FwdSrcOk {
    Input: node: Address
    Input: slot: Integer
    Output: Integer
    Body: {
        Optimize_OpClass(node)
        cls = LoopHome.hit_class
        xmm = LoopHome.hit_xmm
        IfCondition EqualTo(Optimize_FltSrcOk(cls), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(cls, 1) ThenBlock: {
            IfCondition EqualTo(xmm, slot) ThenBlock: { ReturnValue(0) }
            IfCondition LessThan(xmm, 2) ThenBlock: { ReturnValue(0) }
        }
        ReturnValue(1)
    }
}

Function.Optimize_TryFltFwdApply {
    Input: target: Address
    Input: value: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(LoopHome.fwd_on, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(value, LoopHome.fwd_use) ThenBlock: { ReturnValue(Optimize_FwdFail()) }
        opk = Optimize_FltOpKind(AST_GetData1(value))
        IfCondition EqualTo(opk, 0) ThenBlock: { ReturnValue(Optimize_FwdFail()) }
        IfCondition NotEqual(AST_GetChildCount(value), 2) ThenBlock: { ReturnValue(Optimize_FwdFail()) }
        left = AST_GetChild(value, 0)
        right = AST_GetChild(value, 1)
        side = -1
        IfCondition EqualTo(Optimize_IdentEq(left, LoopHome.fwd_name), 1) ThenBlock: { side = 0 }
        IfCondition EqualTo(Optimize_IdentEq(right, LoopHome.fwd_name), 1) ThenBlock: {
            IfCondition GreaterEqual(side, 0) ThenBlock: { ReturnValue(Optimize_FwdFail()) }
            side = 1
        }
        IfCondition LessThan(side, 0) ThenBlock: { ReturnValue(Optimize_FwdFail()) }
        IfCondition EqualTo(opk, 2) ThenBlock: {
            IfCondition NotEqual(side, 0) ThenBlock: { ReturnValue(Optimize_FwdFail()) }
        }
        IfCondition EqualTo(opk, 4) ThenBlock: {
            IfCondition NotEqual(side, 0) ThenBlock: { ReturnValue(Optimize_FwdFail()) }
        }
        other = right
        IfCondition EqualTo(side, 1) ThenBlock: { other = left }
        IfCondition EqualTo(Optimize_FwdSrcOk(other, LoopHome.fwd_slot), 0) ThenBlock: { ReturnValue(Optimize_FwdFail()) }
        cls = LoopHome.hit_class
        disp = LoopHome.hit_disp
        xmm = LoopHome.hit_xmm
        opc = 88
        IfCondition EqualTo(opk, 2) ThenBlock: { opc = 92 }
        IfCondition EqualTo(opk, 3) ThenBlock: { opc = 89 }
        IfCondition EqualTo(opk, 4) ThenBlock: { opc = 94 }
        IfCondition EqualTo(Optimize_FltHomeOp(LoopHome.fwd_slot, cls, disp, xmm, opc), 0) ThenBlock: {
            ReturnValue(Optimize_FwdFail())
        }
        Optimize_FwdClear()
        ReturnValue(1)
    }
}

Function.Optimize_TryFltFwd {
    Input: target: Address
    Input: value: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(LoopHome.active, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(LoopHome.fwd_on, 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(target, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_IsFltHome(target), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_IsIntHome(target), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_IsAccHome(target), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(value, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(value), AST.CALL) ThenBlock: { ReturnValue(0) }
        opk = Optimize_FltOpKind(AST_GetData1(value))
        IfCondition EqualTo(opk, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetChildCount(value), 2) ThenBlock: { ReturnValue(0) }
        hold_ok = Optimize_HoldOk(target)
        IfCondition EqualTo(hold_ok, 0) ThenBlock: { hold_ok = Optimize_HoldHere(target, value) }
        IfCondition EqualTo(hold_ok, 0) ThenBlock: { ReturnValue(0) }
        use = Optimize_FwdNext(target, value)
        IfCondition EqualTo(use, 0) ThenBlock: { ReturnValue(0) }
        slot = LoopHome.fwd_slot
        rhs = LoopHome.fwd_use
        cleft = AST_GetChild(rhs, 0)
        cright = AST_GetChild(rhs, 1)
        other = cright
        IfCondition EqualTo(Optimize_IdentEq(cright, target), 1) ThenBlock: { other = cleft }
        IfCondition EqualTo(Optimize_FwdSrcOk(other, slot), 0) ThenBlock: {
            Optimize_FwdClear()
            ReturnValue(0)
        }
        ch0 = AST_GetChild(value, 0)
        ch1 = AST_GetChild(value, 1)
        IfCondition EqualTo(Optimize_FwdSrcOk(ch0, slot), 0) ThenBlock: {
            Optimize_FwdClear()
            ReturnValue(0)
        }
        c0 = LoopHome.hit_class
        d0 = LoopHome.hit_disp
        x0 = LoopHome.hit_xmm
        IfCondition EqualTo(Optimize_FwdSrcOk(ch1, slot), 0) ThenBlock: {
            Optimize_FwdClear()
            ReturnValue(0)
        }
        c1 = LoopHome.hit_class
        d1 = LoopHome.hit_disp
        x1 = LoopHome.hit_xmm
        opc = 88
        IfCondition EqualTo(opk, 2) ThenBlock: { opc = 92 }
        IfCondition EqualTo(opk, 3) ThenBlock: { opc = 89 }
        IfCondition EqualTo(opk, 4) ThenBlock: { opc = 94 }
        IfCondition EqualTo(Optimize_FltHomeOp(slot, c0, d0, x0, 16), 0) ThenBlock: {
            ReturnValue(Optimize_FwdFail())
        }
        IfCondition EqualTo(Optimize_FltHomeOp(slot, c1, d1, x1, opc), 0) ThenBlock: {
            ReturnValue(Optimize_FwdFail())
        }
        LoopHome.fwd_on = 1
        LoopHome.fwd_name = target
        LoopHome.fwd_slot = slot
        ReturnValue(1)
    }
}