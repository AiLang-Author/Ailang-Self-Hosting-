// =============================================================================
// Library.CCompilerOptimizer.ailang
// =============================================================================
// Expression optimization - eliminates redundant push/pop sequences
// 
// STRATEGY: Pattern-match simple cases first, expand later.
// Start with Add/Multiply of two simple operands (numbers or variables).
// =============================================================================

LibraryImport.Arrays
LibraryImport.Compiler.Frontend.AST.CASTTypes
LibraryImport.Compiler.Frontend.AST.CASTCore
LibraryImport.Compiler.CodeEmit.CEmitCoreArch
LibraryImport.Compiler.Compile.Modules.CCompileScope
LibraryImport.Compiler.Compile.Modules.CCompileCompare

// =============================================================================
// OPTIMIZER STATE
// =============================================================================
FixedPool.OptState {
    "next_temp": Initialize=0, CanChange=True
    "debug": Initialize=1, CanChange=True
    "func_nodes": Initialize=0, CanChange=True
    "func_snaps": Initialize=0, CanChange=True
    "inline_seq": Initialize=0, CanChange=True
    "inline_ready": Initialize=0, CanChange=True
    "inline_ast": Initialize=0, CanChange=True
    "fold_ast": Initialize=0, CanChange=True
    "pool_slot": Initialize=0, CanChange=True
    "pool_names": Initialize=0, CanChange=True
    "pool_kinds": Initialize=0, CanChange=True
    "pool_vals": Initialize=0, CanChange=True
    "pool_gen": Initialize=0, CanChange=True
    "scan_names": Initialize=0, CanChange=True
    "scan_kinds": Initialize=0, CanChange=True
    "scan_vals": Initialize=0, CanChange=True
    "flt_n": Initialize=0, CanChange=True
    "flt_ready": Initialize=0, CanChange=True
    "flt_bits": Initialize=0, CanChange=True
    "flt_disp": Initialize=0, CanChange=True
    "flt_depth": Initialize=0, CanChange=True
    "flt_save": Initialize=0, CanChange=True
    "flt_skip": Initialize=0, CanChange=True
    "flt_saw": Initialize=0, CanChange=True
    "hold_block": Initialize=0, CanChange=True
    "fold_between": Initialize=0, CanChange=True
}

// kind: 0 poisoned, 1 integer, 2 float bits, 3 name alias, 4 not known yet
FixedPool.FoldHold {
    "kind": Initialize=0, CanChange=True
    "val": Initialize=0, CanChange=True
    "one": Initialize=0, CanChange=True
    "stop": Initialize=0, CanChange=True
    "added": Initialize=0, CanChange=True
    "gen": Initialize=0, CanChange=True
}




// =============================================================================
// GENERIC: Load any expression into RAX
// Handles NUMBER, IDENTIFIER, or nested math CALL
// Returns 1 on success, 0 on failure (fall back to standard path)
// =============================================================================
Function.Optimize_LoadToRax {
    Input: node: Address
    Output: Integer
    Body: {
        node_type = AST_GetType(node)
        
        // NUMBER: immediate
        IfCondition EqualTo(node_type, AST.NUMBER) ThenBlock: {
            val = StringToNumber(AST_GetData1(node))
            Emit_MovRaxImm64(val)
            ReturnValue(1)
        }
        
        // IDENTIFIER: variable
        IfCondition EqualTo(node_type, AST.IDENTIFIER) ThenBlock: {
            name = AST_GetData1(node)
            IfCondition EqualTo(Optimize_HomeLoad(name), 1) ThenBlock: { ReturnValue(1) }
            offset = Scope_Resolve(name)
            resolve_type = Scope.resolve_type
            IfCondition EqualTo(resolve_type, 0) ThenBlock: {
                ReturnValue(0)
            }
            IfCondition EqualTo(resolve_type, 3) ThenBlock: {
                pool_index = BitwiseAnd(offset, 2147483647)
                pool_offset = Multiply(pool_index, 8)
                Emit_MovRaxR15Offset(pool_offset)
            } ElseBlock: {
                Emit_MovRaxRbpOffset(offset)
            }
            ReturnValue(1)
        }
        
        // CALL: check if it's a math op we can optimize
        IfCondition EqualTo(node_type, AST.CALL) ThenBlock: {
            func_name = AST_GetData1(node)
            IfCondition EqualTo(Optimize_IsMathOp(func_name), 1) ThenBlock: {
                result = Optimize_BinaryMathOp(node)
                ReturnValue(result)
            }
        }
        
        // Can't optimize this expression
        ReturnValue(0)
    }
}

// =============================================================================
// GENERIC: Load any expression into RBX
// Same as LoadToRax but targets RBX
// =============================================================================
Function.Optimize_LoadToRbx {
    Input: node: Address
    Output: Integer
    Body: {
        node_type = AST_GetType(node)
        
        // NUMBER: immediate
        IfCondition EqualTo(node_type, AST.NUMBER) ThenBlock: {
            val = StringToNumber(AST_GetData1(node))
            Emit_MovRbxImm64(val)
            ReturnValue(1)
        }
        
        // IDENTIFIER: variable
        IfCondition EqualTo(node_type, AST.IDENTIFIER) ThenBlock: {
            name = AST_GetData1(node)
            IfCondition EqualTo(Optimize_IsIntHome(name), 1) ThenBlock: {
                Emit_MovRbxR13()
                ReturnValue(1)
            }
            IfCondition EqualTo(Optimize_IsFltHome(name), 1) ThenBlock: {
                Emit_PushRax()
                slot = Optimize_FltSlot(name)
                IfCondition EqualTo(slot, 2) ThenBlock: { Emit_HomeMove(5, 0) }
                IfCondition GreaterThan(slot, 2) ThenBlock: { X86_XmmRR(2, slot) }
                Emit_MovRbxRax()
                Emit_PopRax()
                ReturnValue(1)
            }
            IfCondition EqualTo(Optimize_IsAccHome(name), 1) ThenBlock: {
                Emit_MovRbxR12()
                ReturnValue(1)
            }
            IfCondition EqualTo(LoopHome.hold_on, 1) ThenBlock: {
                IfCondition EqualTo(StringCompare(name, LoopHome.hold_name), 0) ThenBlock: {
                    Emit_PushRax()
                    Emit_HomeMove(30, 0)
                    Emit_MovRbxRax()
                    Emit_PopRax()
                    ReturnValue(1)
                }
            }
            IfCondition EqualTo(Optimize_AliasFind(name), 1) ThenBlock: {
                X86_EmitR13Mem(0, 73, 139, 0, 3, LoopHome.hit_disp)
                ReturnValue(1)
            }
            offset = Scope_Resolve(name)
            resolve_type = Scope.resolve_type
            IfCondition EqualTo(resolve_type, 0) ThenBlock: {
                ReturnValue(0)
            }
            IfCondition EqualTo(resolve_type, 3) ThenBlock: {
                pool_index = BitwiseAnd(offset, 2147483647)
                pool_offset = Multiply(pool_index, 8)
                Emit_MovRbxR15Offset(pool_offset)
            } ElseBlock: {
                Emit_MovRbxRbpOffset(offset)
            }
            ReturnValue(1)
        }
        
        // CALL: optimize nested math, then move RAX→RBX
        IfCondition EqualTo(node_type, AST.CALL) ThenBlock: {
            func_name = AST_GetData1(node)
            IfCondition EqualTo(Optimize_IsMathOp(func_name), 1) ThenBlock: {
                result = Optimize_BinaryMathOp(node)
                IfCondition EqualTo(result, 1) ThenBlock: {
                    Emit_MovRbxRax()  // Move result to RBX
                    ReturnValue(1)
                }
            }
        }
        
        ReturnValue(0)
    }
}
// =============================================================================
// EMIT OPERATION: Given RAX=left, RBX=right, emit the math/cmp instruction
// Returns 1 on success, 0 on unknown operation
// =============================================================================

Function.Optimize_EmitOperation {
    Input: node: Address
    Input: func_name: Address
    Output: Integer
    Body: {
        // =================================================================
        // ARITHMETIC
        // =================================================================
        IfCondition EqualTo(StringCompare(func_name, "Add"), 0) ThenBlock: {
            Emit_AddRaxRbx()
            ReturnValue(1)
        }
        IfCondition EqualTo(StringCompare(func_name, "Subtract"), 0) ThenBlock: {
            Emit_SubRaxRbx()
            ReturnValue(1)
        }
        IfCondition EqualTo(StringCompare(func_name, "Multiply"), 0) ThenBlock: {
            // Check right operand for power-of-2 → SHL
            arg1 = AST_GetChild(node, 1)
            arg1_type = AST_GetType(arg1)
            IfCondition EqualTo(arg1_type, AST.NUMBER) ThenBlock: {
                val_str = AST_GetData1(arg1)
                val = StringToNumber(val_str)
                IfCondition GreaterThan(val, 0) ThenBlock: {
                    val_minus_1 = Subtract(val, 1)
                    check = BitwiseAnd(val, val_minus_1)
                    IfCondition EqualTo(check, 0) ThenBlock: {
                        shift = 0
                        tmp = val
                        WhileLoop GreaterThan(tmp, 1) {
                            tmp = Divide(tmp, 2)
                            shift = Add(shift, 1)
                        }
                        IfCondition GreaterThan(shift, 0) ThenBlock: {
                            Emit_ShlRaxImm8(shift)
                            ReturnValue(1)
                        }
                        ReturnValue(1)
                    }
                }
            }
            // Check left operand for power-of-2 → SHL
            arg0 = AST_GetChild(node, 0)
            arg0_type = AST_GetType(arg0)
            IfCondition EqualTo(arg0_type, AST.NUMBER) ThenBlock: {
                val_str = AST_GetData1(arg0)
                val = StringToNumber(val_str)
                IfCondition GreaterThan(val, 0) ThenBlock: {
                    val_minus_1 = Subtract(val, 1)
                    check = BitwiseAnd(val, val_minus_1)
                    IfCondition EqualTo(check, 0) ThenBlock: {
                        shift = 0
                        tmp = val
                        WhileLoop GreaterThan(tmp, 1) {
                            tmp = Divide(tmp, 2)
                            shift = Add(shift, 1)
                        }
                        IfCondition GreaterThan(shift, 0) ThenBlock: {
                            Emit_MovRaxRbx()
                            Emit_ShlRaxImm8(shift)
                            ReturnValue(1)
                        }
                        ReturnValue(1)
                    }
                }
            }
            Emit_ImulRaxRbx()
            ReturnValue(1)
        }
        IfCondition EqualTo(StringCompare(func_name, "Divide"), 0) ThenBlock: {
            Emit_Cqo()
            Emit_IdivRbx()
            ReturnValue(1)
        }
        IfCondition EqualTo(StringCompare(func_name, "Modulo"), 0) ThenBlock: {
            arg1 = AST_GetChild(node, 1)
            arg1_type = AST_GetType(arg1)
            IfCondition EqualTo(arg1_type, AST.NUMBER) ThenBlock: {
                val_str = AST_GetData1(arg1)
                val = StringToNumber(val_str)
                IfCondition GreaterThan(val, 0) ThenBlock: {
                    val_minus_1 = Subtract(val, 1)
                    check = BitwiseAnd(val, val_minus_1)
                    IfCondition EqualTo(check, 0) ThenBlock: {
                        Emit_AndRaxImm32(val_minus_1)
                        ReturnValue(1)
                    }
                }
            }
            Emit_Cqo()
            Emit_IdivRbx()
            Emit_MovRaxRdx()
            ReturnValue(1)
        }

        // =================================================================
        // COMPARISONS
        // =================================================================
        IfCondition EqualTo(StringCompare(func_name, "EqualTo"), 0) ThenBlock: {
            Emit_CmpRaxRbx()
            Emit_Sete()
            Emit_MovzxRaxAl()
            ReturnValue(1)
        }
        IfCondition EqualTo(StringCompare(func_name, "NotEqual"), 0) ThenBlock: {
            Emit_CmpRaxRbx()
            Emit_Setne()
            Emit_MovzxRaxAl()
            ReturnValue(1)
        }
        IfCondition EqualTo(StringCompare(func_name, "LessThan"), 0) ThenBlock: {
            Emit_CmpRaxRbx()
            Emit_Setl()
            Emit_MovzxRaxAl()
            ReturnValue(1)
        }
        IfCondition EqualTo(StringCompare(func_name, "GreaterThan"), 0) ThenBlock: {
            Emit_CmpRaxRbx()
            Emit_Setg()
            Emit_MovzxRaxAl()
            ReturnValue(1)
        }
        IfCondition EqualTo(StringCompare(func_name, "LessEqual"), 0) ThenBlock: {
            Emit_CmpRaxRbx()
            Emit_Setle()
            Emit_MovzxRaxAl()
            ReturnValue(1)
        }
        IfCondition EqualTo(StringCompare(func_name, "GreaterEqual"), 0) ThenBlock: {
            Emit_CmpRaxRbx()
            Emit_Setge()
            Emit_MovzxRaxAl()
            ReturnValue(1)
        }

        // =================================================================
        // BITWISE — AND, OR, XOR
        // =================================================================
        is_and = Or(EqualTo(StringCompare(func_name, "BitwiseAnd"), 0), EqualTo(StringCompare(func_name, "BitAnd"), 0))
        IfCondition EqualTo(is_and, 1) ThenBlock: {
            Emit_AndRaxRbx()
            ReturnValue(1)
        }
        is_or = Or(EqualTo(StringCompare(func_name, "BitwiseOr"), 0), EqualTo(StringCompare(func_name, "BitOr"), 0))
        IfCondition EqualTo(is_or, 1) ThenBlock: {
            Emit_OrRaxRbx()
            ReturnValue(1)
        }
        is_xor = Or(EqualTo(StringCompare(func_name, "BitwiseXor"), 0), EqualTo(StringCompare(func_name, "BitXor"), 0))
        IfCondition EqualTo(is_xor, 1) ThenBlock: {
            Emit_XorRaxRbx()
            ReturnValue(1)
        }

        // =================================================================
        // SHIFTS — need RBX→RCX for variable shift, or imm8 for constant
        // =================================================================
        is_shl = Or(EqualTo(StringCompare(func_name, "LeftShift"), 0), EqualTo(StringCompare(func_name, "ShiftLeft"), 0))
        IfCondition EqualTo(is_shl, 1) ThenBlock: {
            // If right operand is constant, use SHL RAX, imm8 directly
            arg1 = AST_GetChild(node, 1)
            arg1_type = AST_GetType(arg1)
            IfCondition EqualTo(arg1_type, AST.NUMBER) ThenBlock: {
                shift_val = StringToNumber(AST_GetData1(arg1))
                Emit_ShlRaxImm8(shift_val)
                ReturnValue(1)
            }
            // Variable shift: RBX has shift amount, move to RCX
            Emit_MovRcxRbx()
            Emit_ShlRaxCl()
            ReturnValue(1)
        }
        is_shr = Or(EqualTo(StringCompare(func_name, "RightShift"), 0), EqualTo(StringCompare(func_name, "ShiftRight"), 0))
        IfCondition EqualTo(is_shr, 1) ThenBlock: {
            arg1 = AST_GetChild(node, 1)
            arg1_type = AST_GetType(arg1)
            IfCondition EqualTo(arg1_type, AST.NUMBER) ThenBlock: {
                shift_val = StringToNumber(AST_GetData1(arg1))
                Emit_ShrRaxImm8(shift_val)
                ReturnValue(1)
            }
            Emit_MovRcxRbx()
            Emit_ShrRaxCl()
            ReturnValue(1)
        }

        ReturnValue(0)
    }
}


// =============================================================================
// GENERIC: Optimize any binary math operation
// Three-way operand loading + operation dispatch
// Returns 1 if optimized, 0 to fall back to standard path
// =============================================================================
Function.Optimize_BinaryMathOp {
    Input: node: Address
    Output: Integer
    Body: {
        arg_count = AST_GetChildCount(node)
        IfCondition NotEqual(arg_count, 2) ThenBlock: {
            ReturnValue(0)
        }
        
        func_name = AST_GetData1(node)
        arg0 = AST_GetChild(node, 0)
        arg1 = AST_GetChild(node, 1)
        
        
        // Classify both operands
        type0 = AST_GetType(arg0)
        type1 = AST_GetType(arg1)
        left_is_simple = Or(EqualTo(type0, AST.NUMBER), EqualTo(type0, AST.IDENTIFIER))
        right_is_simple = Or(EqualTo(type1, AST.NUMBER), EqualTo(type1, AST.IDENTIFIER))
        
        IfCondition EqualTo(right_is_simple, 1) ThenBlock: {
            // PATH A: right is simple (includes both-simple)
            // left → RAX (may recurse), right → RBX (leaf, safe)
            result = Optimize_LoadToRax(arg0)
            IfCondition EqualTo(result, 0) ThenBlock: {
                ReturnValue(0)
            }
            result = Optimize_LoadToRbx(arg1)
            IfCondition EqualTo(result, 0) ThenBlock: {
                ReturnValue(0)
            }
        } ElseBlock: {
            IfCondition EqualTo(left_is_simple, 1) ThenBlock: {
                // PATH B: left is simple, right is complex — NEW
                // Evaluate right FIRST → RAX, stash in RBX
                // Then load simple left → RAX (leaf, won't touch RBX)
                result = Optimize_LoadToRax(arg1)
                IfCondition EqualTo(result, 0) ThenBlock: {
                    ReturnValue(0)
                }
                Emit_MovRbxRax()
                result = Optimize_LoadToRax(arg0)
                IfCondition EqualTo(result, 0) ThenBlock: {
                    ReturnValue(0)
                }
            } ElseBlock: {
                // PATH C: both complex — push/pop unavoidable
                result = Optimize_LoadToRax(arg0)
                IfCondition EqualTo(result, 0) ThenBlock: {
                    ReturnValue(0)
                }
                Emit_PushRax()
                result = Optimize_LoadToRbx(arg1)
                IfCondition EqualTo(result, 0) ThenBlock: {
                    ReturnValue(0)
                }
                Emit_PopRax()
            }
        }
        emit_result = Optimize_EmitOperation(node, func_name)
        ReturnValue(emit_result)



        // RAX = left, RBX = right — emit the operation
        ReturnValue(Optimize_EmitOperation(node, func_name))
    }
}

// =============================================================================
// DISPATCHER: Try to optimize any math operation
// Call this from Compile_Expression for CALL nodes
// Returns 1 if optimized, 0 to use standard path
// =============================================================================
Function.Optimize_TryMathOp {
    Input: node: Address
    Output: Integer
    Body: {
        func_name = AST_GetData1(node)

        // Check if it's a math op we handle
        IfCondition EqualTo(Optimize_IsMathOp(func_name), 1) ThenBlock: {
            ReturnValue(Optimize_BinaryMathOp(node))
        }
        
        // Not a math op we optimize
        ReturnValue(0)
    }
}

// =============================================================================
// HELPER: Check if function is optimizable math op
// =============================================================================


Function.Optimize_IsMathOp {
    Input: name: Address
    Output: Integer
    Body: {
        // Arithmetic
        IfCondition EqualTo(StringCompare(name, "Add"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "Subtract"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "Multiply"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "Divide"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "Modulo"), 0) ThenBlock: { ReturnValue(1) }
        
        // Comparisons
        IfCondition EqualTo(StringCompare(name, "EqualTo"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "NotEqual"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "LessThan"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "GreaterThan"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "LessEqual"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "GreaterEqual"), 0) ThenBlock: { ReturnValue(1) }
        
        // Bitwise
        IfCondition EqualTo(StringCompare(name, "BitwiseAnd"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "BitwiseOr"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "BitwiseXor"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "LeftShift"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "RightShift"), 0) ThenBlock: { ReturnValue(1) }
        
        // Short aliases
        IfCondition EqualTo(StringCompare(name, "BitAnd"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "BitOr"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "BitXor"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "ShiftLeft"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "ShiftRight"), 0) ThenBlock: { ReturnValue(1) }
        
        ReturnValue(0)
    }
}

// =============================================================================
// BRANCH CONDITION
// WhileLoop / IfCondition / Fork only test the condition for zero. A single
// compare of two leaves can jump on the flags from CMP and skip SETCC/MOVZX.
// Returns 1 when the false-label jump was emitted, 0 when the caller should
// use the ordinary 0/1 path, 2 when emission started and then failed.
// =============================================================================
Function.Optimize_IsLeaf {
    Input: node: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: {
            ReturnValue(0)
        }
        node_type = AST_GetType(node)
        IfCondition EqualTo(node_type, AST.NUMBER) ThenBlock: {
            ReturnValue(1)
        }
        IfCondition EqualTo(node_type, AST.IDENTIFIER) ThenBlock: {
            ReturnValue(1)
        }
        ReturnValue(0)
    }
}

Function.Optimize_IsCompareName {
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(name, 0) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition EqualTo(StringCompare(name, "EqualTo"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "NotEqual"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "LessThan"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "GreaterThan"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "LessEqual"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "GreaterEqual"), 0) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

Function.Optimize_JumpIfFalse {
    Input: name: Address
    Input: false_label: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(StringCompare(name, "EqualTo"), 0) ThenBlock: {
            Emit_Jne(false_label)
            ReturnValue(0)
        }
        IfCondition EqualTo(StringCompare(name, "NotEqual"), 0) ThenBlock: {
            Emit_Je(false_label)
            ReturnValue(0)
        }
        IfCondition EqualTo(StringCompare(name, "LessThan"), 0) ThenBlock: {
            Emit_Jge(false_label)
            ReturnValue(0)
        }
        IfCondition EqualTo(StringCompare(name, "GreaterThan"), 0) ThenBlock: {
            Emit_Jle(false_label)
            ReturnValue(0)
        }
        IfCondition EqualTo(StringCompare(name, "LessEqual"), 0) ThenBlock: {
            Emit_Jg(false_label)
            ReturnValue(0)
        }
        Emit_Jl(false_label)
        ReturnValue(0)
    }
}

Function.Optimize_TryBranchCondition {
    Input: node: Address
    Input: false_label: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: {
            ReturnValue(0)
        }
        node_type = AST_GetType(node)
        IfCondition NotEqual(node_type, AST.CALL) ThenBlock: {
            ReturnValue(0)
        }
        name = AST_GetData1(node)
        IfCondition EqualTo(Optimize_IsCompareName(name), 0) ThenBlock: {
            ReturnValue(0)
        }
        arg_count = AST_GetChildCount(node)
        IfCondition NotEqual(arg_count, 2) ThenBlock: {
            ReturnValue(0)
        }
        arg0 = AST_GetChild(node, 0)
        arg1 = AST_GetChild(node, 1)
        IfCondition EqualTo(Optimize_IsLeaf(arg0), 0) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition EqualTo(Optimize_IsLeaf(arg1), 0) ThenBlock: {
            ReturnValue(0)
        }
        result = CompileCompare_Binary(node)
        IfCondition EqualTo(result, 0) ThenBlock: {
            ReturnValue(2)
        }
        Optimize_JumpIfFalse(name, false_label)
        ReturnValue(1)
    }
}

// =============================================================================
// LOOP HOMES
// One integer home (r13), one accumulator (r12), and up to four float homes
// (xmm2 plus xmm3/xmm4/xmm5). A call to a registered function spills the
// caller-saved homes and reloads them. An unknown call, CallIndirect,
// AddressOf, or a nested loop turns the homes off.
// Kind values for Emit_HomeMove are the only place r13/xmm2/r12 are named.
// =============================================================================
FixedPool.LoopHome {
    "active": Initialize=0, CanChange=True
    "blocked": Initialize=0, CanChange=True
    "no_float": Initialize=0, CanChange=True
    "count": Initialize=0, CanChange=True
    "recs": Initialize=0, CanChange=True
    "int_name": Initialize=0, CanChange=True
    "int_off": Initialize=0, CanChange=True
    "flt_name": Initialize=0, CanChange=True
    "flt_off": Initialize=0, CanChange=True
    "assign_name": Initialize=0, CanChange=True
    "imm_ok": Initialize=0, CanChange=True
    "imm_val": Initialize=0, CanChange=True
    "acc_name": Initialize=0, CanChange=True
    "acc_off": Initialize=0, CanChange=True
    "a0_on": Initialize=0, CanChange=True
    "a0_name": Initialize=0, CanChange=True
    "a0_disp": Initialize=0, CanChange=True
    "a1_on": Initialize=0, CanChange=True
    "a1_name": Initialize=0, CanChange=True
    "a1_disp": Initialize=0, CanChange=True
    "a2_on": Initialize=0, CanChange=True
    "a2_name": Initialize=0, CanChange=True
    "a2_disp": Initialize=0, CanChange=True
    "a3_on": Initialize=0, CanChange=True
    "a3_name": Initialize=0, CanChange=True
    "a3_disp": Initialize=0, CanChange=True
    "hold_on": Initialize=0, CanChange=True
    "hold_name": Initialize=0, CanChange=True
    "rbx_free": Initialize=0, CanChange=True
    "lim_on": Initialize=0, CanChange=True
    "lim_name": Initialize=0, CanChange=True
    "lim_off": Initialize=0, CanChange=True
    "alias_spill": Initialize=0, CanChange=True
    "hit_on": Initialize=0, CanChange=True
    "hit_disp": Initialize=0, CanChange=True
    "hit_class": Initialize=0, CanChange=True
    "body": Initialize=0, CanChange=True
    "mention_count": Initialize=0, CanChange=True
    "scan_temps": Initialize=0, CanChange=True
    "scan_updates": Initialize=0, CanChange=True
    "f2_name": Initialize=0, CanChange=True
    "f2_off": Initialize=0, CanChange=True
    "f3_name": Initialize=0, CanChange=True
    "f3_off": Initialize=0, CanChange=True
    "f4_name": Initialize=0, CanChange=True
    "f4_off": Initialize=0, CanChange=True
    "hit_xmm": Initialize=0, CanChange=True
    "tab_on": Initialize=0, CanChange=True
    "tab_name": Initialize=0, CanChange=True
    "tab_off": Initialize=0, CanChange=True
    "tab_many": Initialize=0, CanChange=True
    "has_call": Initialize=0, CanChange=True
    "scan_depth": Initialize=0, CanChange=True
    "p0_on": Initialize=0, CanChange=True
    "p0_name": Initialize=0, CanChange=True
    "p0_disp": Initialize=0, CanChange=True
    "p1_on": Initialize=0, CanChange=True
    "p1_name": Initialize=0, CanChange=True
    "p1_disp": Initialize=0, CanChange=True
    "p2_on": Initialize=0, CanChange=True
    "p2_name": Initialize=0, CanChange=True
    "p2_disp": Initialize=0, CanChange=True
    "p3_on": Initialize=0, CanChange=True
    "p3_name": Initialize=0, CanChange=True
    "p3_disp": Initialize=0, CanChange=True
}

Function.Emit_HomeMove {
    Input: kind: Integer
    Input: imm: Integer
    Body: {
        IfCondition EqualTo(kind, 1) ThenBlock: { Emit_MovRaxR13() }
        IfCondition EqualTo(kind, 2) ThenBlock: { Emit_MovR13Rax() }
        IfCondition EqualTo(kind, 3) ThenBlock: {
            asm = "ADD r13, "
            nstr = NumberToString(imm)
            asm = StringConcat(asm, nstr)
            X86Enc_Assemble(asm)
        }
        IfCondition EqualTo(kind, 4) ThenBlock: {
            asm = "SUB r13, "
            nstr = NumberToString(imm)
            asm = StringConcat(asm, nstr)
            X86Enc_Assemble(asm)
        }
        IfCondition EqualTo(kind, 5) ThenBlock: { X86Enc_Assemble("MOVQ rax, xmm2") }
        IfCondition EqualTo(kind, 6) ThenBlock: { X86Enc_Assemble("MOVQ xmm2, rax") }
        IfCondition EqualTo(kind, 7) ThenBlock: { X86Enc_Assemble("MOVSD xmm0, xmm2") }
        IfCondition EqualTo(kind, 8) ThenBlock: { X86Enc_Assemble("MOVSD xmm1, xmm2") }
        IfCondition EqualTo(kind, 9) ThenBlock: { X86Enc_Assemble("MOVSD xmm2, xmm0") }
        IfCondition EqualTo(kind, 10) ThenBlock: { X86Enc_Assemble("MOVQ xmm1, rax") }
        IfCondition EqualTo(kind, 11) ThenBlock: { X86Enc_Assemble("MOVQ xmm0, rax") }
        IfCondition EqualTo(kind, 12) ThenBlock: { X86_EmitR13Mem(0, 73, 139, 0, 0, imm) }
        IfCondition EqualTo(kind, 13) ThenBlock: { X86Enc_Assemble("CMP r13, rbx") }
        IfCondition EqualTo(kind, 14) ThenBlock: { X86Enc_Assemble("CMP rax, r13") }
        IfCondition EqualTo(kind, 15) ThenBlock: {
            asm = "CMP r13, "
            nstr = NumberToString(imm)
            asm = StringConcat(asm, nstr)
            X86Enc_Assemble(asm)
        }
        IfCondition EqualTo(kind, 16) ThenBlock: { Emit_MovRaxR12() }
        IfCondition EqualTo(kind, 17) ThenBlock: { Emit_MovR12Rax() }
        IfCondition EqualTo(kind, 18) ThenBlock: { X86_EmitR13Mem(242, 65, 15, 88, 2, imm) }
        IfCondition EqualTo(kind, 19) ThenBlock: { X86_EmitR13Mem(242, 65, 15, 92, 2, imm) }
        IfCondition EqualTo(kind, 20) ThenBlock: { X86_EmitR13Mem(242, 65, 15, 89, 2, imm) }
        IfCondition EqualTo(kind, 21) ThenBlock: { X86_EmitR13Mem(0, 77, 3, 0, 4, imm) }
        IfCondition EqualTo(kind, 22) ThenBlock: { X86_EmitR13Mem(0, 77, 43, 0, 4, imm) }
        IfCondition EqualTo(kind, 23) ThenBlock: { X86_AddR12R13() }
        IfCondition EqualTo(kind, 24) ThenBlock: { X86_EmitR13Mem(242, 65, 15, 16, 0, imm) }
        IfCondition EqualTo(kind, 25) ThenBlock: { X86_EmitR13Mem(242, 65, 15, 89, 0, imm) }
        IfCondition EqualTo(kind, 26) ThenBlock: { X86Enc_Assemble("ADDSD xmm2, xmm0") }
        IfCondition EqualTo(kind, 27) ThenBlock: { X86_EmitR13Mem(242, 65, 15, 88, 0, imm) }
        IfCondition EqualTo(kind, 28) ThenBlock: { X86Enc_Assemble("MULSD xmm0, xmm2") }
        IfCondition EqualTo(kind, 29) ThenBlock: { X86_EmitR13Mem(242, 65, 15, 16, 1, imm) }
        IfCondition EqualTo(kind, 30) ThenBlock: { X86Enc_Assemble("MOVQ rax, xmm0") }
        IfCondition EqualTo(kind, 31) ThenBlock: { X86_EmitR13Mem(242, 65, 15, 92, 0, imm) }
        IfCondition EqualTo(kind, 32) ThenBlock: { X86Enc_Assemble("ADDSD xmm0, xmm2") }
        IfCondition EqualTo(kind, 33) ThenBlock: { X86Enc_Assemble("SUBSD xmm0, xmm2") }
        IfCondition EqualTo(kind, 34) ThenBlock: { X86_SubR12R13() }
        IfCondition EqualTo(kind, 35) ThenBlock: { X86Enc_Assemble("MULSD xmm2, xmm0") }
        IfCondition EqualTo(kind, 36) ThenBlock: { X86Enc_Assemble("SUBSD xmm2, xmm0") }
        IfCondition EqualTo(kind, 37) ThenBlock: { X86Enc_Assemble("MOVSD xmm1, xmm0") }
        IfCondition EqualTo(kind, 38) ThenBlock: { X86Enc_Assemble("ADDSD xmm0, xmm1") }
        IfCondition EqualTo(kind, 39) ThenBlock: { X86Enc_Assemble("SUBSD xmm0, xmm1") }
        IfCondition EqualTo(kind, 40) ThenBlock: { X86Enc_Assemble("MULSD xmm0, xmm1") }
        IfCondition EqualTo(kind, 41) ThenBlock: {
            asm = "ADD r12, "
            nstr = NumberToString(imm)
            asm = StringConcat(asm, nstr)
            X86Enc_Assemble(asm)
        }
        IfCondition EqualTo(kind, 42) ThenBlock: {
            asm = "SUB r12, "
            nstr = NumberToString(imm)
            asm = StringConcat(asm, nstr)
            X86Enc_Assemble(asm)
        }
        // MOV [r13 + disp], rax. Kinds 1-42 are unchanged.
        IfCondition EqualTo(kind, 43) ThenBlock: { X86_EmitR13Mem(0, 73, 137, 0, 0, imm) }
    }
}

Function.Optimize_HomeRelease {
    Body: {
        LoopHome.active = 0
        LoopHome.blocked = 0
        LoopHome.no_float = 0
        LoopHome.int_name = 0
        LoopHome.flt_name = 0
        LoopHome.int_off = 0
        LoopHome.flt_off = 0
        LoopHome.assign_name = 0
        LoopHome.acc_name = 0
        LoopHome.acc_off = 0
        LoopHome.a0_on = 0
        LoopHome.a1_on = 0
        LoopHome.a2_on = 0
        LoopHome.a3_on = 0
        LoopHome.hold_on = 0
        LoopHome.hold_name = 0
        LoopHome.rbx_free = 0
        LoopHome.lim_on = 0
        LoopHome.lim_name = 0
        LoopHome.lim_off = 0
        LoopHome.alias_spill = 0
        LoopHome.body = 0
        LoopHome.f2_name = 0
        LoopHome.f2_off = 0
        LoopHome.f3_name = 0
        LoopHome.f3_off = 0
        LoopHome.f4_name = 0
        LoopHome.f4_off = 0
        LoopHome.hit_xmm = 0
        LoopHome.tab_on = 0
        LoopHome.tab_name = 0
        LoopHome.tab_off = 0
        LoopHome.tab_many = 0
        LoopHome.has_call = 0
        LoopHome.scan_depth = 0
        Optimize_PtrClearAll()
    }
}

Function.Optimize_HomeRec {
    Input: index: Integer
    Output: Address
    Body: {
        off = Multiply(index, 40)
        ReturnValue(Add(LoopHome.recs, off))
    }
}

Function.Optimize_IsIntHome {
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(LoopHome.active, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(LoopHome.int_name, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(StringCompare(name, LoopHome.int_name), 0) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

Function.Optimize_FltSlot {
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(LoopHome.active, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_NameEq(name, LoopHome.flt_name), 1) ThenBlock: { ReturnValue(2) }
        IfCondition EqualTo(Optimize_NameEq(name, LoopHome.f2_name), 1) ThenBlock: { ReturnValue(3) }
        IfCondition EqualTo(Optimize_NameEq(name, LoopHome.f3_name), 1) ThenBlock: { ReturnValue(4) }
        IfCondition EqualTo(Optimize_NameEq(name, LoopHome.f4_name), 1) ThenBlock: { ReturnValue(5) }
        ReturnValue(0)
    }
}

Function.Optimize_IsFltHome {
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition GreaterThan(Optimize_FltSlot(name), 0) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

Function.Optimize_IsAccHome {
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(LoopHome.active, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(LoopHome.acc_name, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(StringCompare(name, LoopHome.acc_name), 0) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

Function.Optimize_HomeLoad {
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(Optimize_IsIntHome(name), 1) ThenBlock: {
            Emit_HomeMove(1, 0)
            ReturnValue(1)
        }
        IfCondition EqualTo(Optimize_IsAccHome(name), 1) ThenBlock: {
            Emit_HomeMove(16, 0)
            ReturnValue(1)
        }
        IfCondition EqualTo(Optimize_IsFltHome(name), 1) ThenBlock: {
            slot = Optimize_FltSlot(name)
            IfCondition EqualTo(slot, 2) ThenBlock: { Emit_HomeMove(5, 0) }
            IfCondition GreaterThan(slot, 2) ThenBlock: { X86_XmmRR(2, slot) }
            ReturnValue(1)
        }
        IfCondition EqualTo(LoopHome.hold_on, 1) ThenBlock: {
            IfCondition EqualTo(StringCompare(name, LoopHome.hold_name), 0) ThenBlock: {
                Emit_HomeMove(30, 0)
                ReturnValue(1)
            }
        }
        IfCondition EqualTo(Optimize_AliasFind(name), 1) ThenBlock: {
            Emit_HomeMove(12, LoopHome.hit_disp)
            ReturnValue(1)
        }
        ReturnValue(0)
    }
}

Function.Optimize_HomeStore {
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(Optimize_IsIntHome(name), 1) ThenBlock: {
            Emit_HomeMove(2, 0)
            Optimize_PtrClearAll()
            ReturnValue(1)
        }
        IfCondition EqualTo(Optimize_IsAccHome(name), 1) ThenBlock: {
            Emit_HomeMove(17, 0)
            ReturnValue(1)
        }
        IfCondition EqualTo(Optimize_IsFltHome(name), 1) ThenBlock: {
            slot = Optimize_FltSlot(name)
            IfCondition EqualTo(slot, 2) ThenBlock: { Emit_HomeMove(6, 0) }
            IfCondition GreaterThan(slot, 2) ThenBlock: { X86_XmmRR(1, slot) }
            ReturnValue(1)
        }
        IfCondition EqualTo(Optimize_AliasFind(name), 1) ThenBlock: {
            Optimize_AliasClear(name)
            ReturnValue(0)
        }
        ReturnValue(0)
    }
}

Function.Optimize_HomeCallOk {
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(StringCompare(name, "Add"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "Subtract"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "Multiply"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "Divide"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "Modulo"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "Negate"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "EqualTo"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "NotEqual"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "LessThan"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "GreaterThan"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "LessEqual"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "GreaterEqual"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "BitwiseAnd"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "BitwiseOr"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "BitwiseXor"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "BitwiseNot"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "LeftShift"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "RightShift"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "BitAnd"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "BitOr"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "BitXor"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "BitNot"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "ShiftLeft"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "ShiftRight"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "And"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "Or"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "Not"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "Float_Add"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "Float_Sub"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "Float_Mul"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "Float_Div"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "Float_Neg"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "Float_Abs"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "Float_Sqrt"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "Float_FromInt"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "Float_ToInt"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "Dereference"), 0) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

Function.Optimize_HomeFma {
    Input: node: Address
    Output: Integer
    Body: {
        name = AST_GetData1(node)
        is_add = 0
        IfCondition EqualTo(StringCompare(name, "Float_Add"), 0) ThenBlock: { is_add = 1 }
        IfCondition EqualTo(StringCompare(name, "Float_Sub"), 0) ThenBlock: { is_add = 1 }
        IfCondition EqualTo(is_add, 0) ThenBlock: { ReturnValue(0) }
        n = AST_GetChildCount(node)
        i = 0
        WhileLoop LessThan(i, n) {
            child = AST_GetChild(node, i)
            IfCondition NotEqual(child, 0) ThenBlock: {
                ct = AST_GetType(child)
                IfCondition EqualTo(ct, AST.CALL) ThenBlock: {
                    cn = AST_GetData1(child)
                    IfCondition EqualTo(StringCompare(cn, "Float_Mul"), 0) ThenBlock: { ReturnValue(1) }
                }
            }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

Function.Optimize_HomeTouch {
    Input: name: Address
    Input: is_store: Integer
    Input: is_float: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(LoopHome.recs, 0) ThenBlock: {
            LoopHome.recs = Allocate(640)
        }
        found = -1
        i = 0
        WhileLoop LessThan(i, LoopHome.count) {
            rec = Optimize_HomeRec(i)
            existing = Dereference(rec)
            IfCondition EqualTo(StringCompare(existing, name), 0) ThenBlock: {
                found = i
                ExitLoop
            }
            i = Add(i, 1)
        }
        IfCondition EqualTo(found, -1) ThenBlock: {
            IfCondition GreaterEqual(LoopHome.count, 16) ThenBlock: { ReturnValue(0) }
            found = LoopHome.count
            LoopHome.count = Add(LoopHome.count, 1)
            rec = Optimize_HomeRec(found)
            StoreValue(rec, name)
            StoreValue(Add(rec, 8), 0)
            StoreValue(Add(rec, 16), 0)
            StoreValue(Add(rec, 24), 0)
            StoreValue(Add(rec, 32), 0)
        }
        rec = Optimize_HomeRec(found)
        IfCondition EqualTo(is_store, 1) ThenBlock: {
            stores = Dereference(Add(rec, 16))
            StoreValue(Add(rec, 16), Add(stores, 1))
            IfCondition EqualTo(is_float, 1) ThenBlock: {
                fops = Dereference(Add(rec, 24))
                StoreValue(Add(rec, 24), Add(fops, 1))
            }
        } ElseBlock: {
            loads = Dereference(Add(rec, 8))
            StoreValue(Add(rec, 8), Add(loads, 1))
            IfCondition NotEqual(LoopHome.assign_name, 0) ThenBlock: {
                IfCondition EqualTo(StringCompare(name, LoopHome.assign_name), 0) ThenBlock: {
                    selfn = Dereference(Add(rec, 32))
                    StoreValue(Add(rec, 32), Add(selfn, 1))
                }
            }
        }
        ReturnValue(0)
    }
}

Function.Optimize_HomeWalkKids {
    Input: node: Address
    Output: Integer
    Body: {
        count = AST_GetChildCount(node)
        i = 0
        WhileLoop LessThan(i, count) {
            IfCondition EqualTo(LoopHome.blocked, 1) ThenBlock: { ExitLoop }
            child = AST_GetChild(node, i)
            Optimize_HomeWalk(child)
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

Function.Optimize_HomeBlockNode {
    Input: node_type: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(node_type, AST.WHILE) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(node_type, AST.FOR_EVERY) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(node_type, AST.UNTIL) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(node_type, AST.TRY) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(node_type, AST.LOOP_MAIN) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(node_type, AST.LOOP_ACTOR) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(node_type, AST.LOOP_START) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(node_type, AST.LOOP_SHADOW) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(node_type, AST.DEFER) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(node_type, AST.WITH_CONTEXT) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(node_type, AST.EVERY_INTERVAL) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(node_type, AST.POINTER_FIELD_ASSIGN) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

Function.Optimize_HomeWalk {
    Input: node: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(LoopHome.blocked, 1) ThenBlock: { ReturnValue(0) }
        node_type = AST_GetType(node)
        IfCondition EqualTo(Optimize_HomeBlockNode(node_type), 1) ThenBlock: {
            LoopHome.blocked = 1
            ReturnValue(0)
        }
        IfCondition EqualTo(node_type, AST.IDENTIFIER) ThenBlock: {
            Optimize_HomeTouch(AST_GetData1(node), 0, 0)
            ReturnValue(0)
        }
        IfCondition EqualTo(node_type, AST.ASSIGNMENT) ThenBlock: {
            target_node = AST_GetData2(node)
            IfCondition NotEqual(target_node, 0) ThenBlock: {
                LoopHome.blocked = 1
                ReturnValue(0)
            }
            tname = AST_GetData1(node)
            val = AST_GetChild(node, 0)
            is_float = 0
            IfCondition NotEqual(val, 0) ThenBlock: {
                vt = AST_GetType(val)
                IfCondition EqualTo(vt, AST.CALL) ThenBlock: {
                    vn = AST_GetData1(val)
                    IfCondition EqualTo(StringCompare(vn, "Float_Add"), 0) ThenBlock: { is_float = 1 }
                    IfCondition EqualTo(StringCompare(vn, "Float_Sub"), 0) ThenBlock: { is_float = 1 }
                    IfCondition EqualTo(StringCompare(vn, "Float_Mul"), 0) ThenBlock: { is_float = 1 }
                }
            }
            skip_store = 0
            IfCondition NotEqual(val, 0) ThenBlock: {
                IfCondition EqualTo(AST_GetType(val), AST.NUMBER) ThenBlock: {
                    IfCondition EqualTo(StringToNumber(AST_GetData1(val)), 0) ThenBlock: {
                        skip_store = 1
                    }
                }
            }
            IfCondition EqualTo(skip_store, 0) ThenBlock: {
                Optimize_HomeTouch(tname, 1, is_float)
            }
            LoopHome.assign_name = tname
            Optimize_HomeWalkKids(node)
            LoopHome.assign_name = 0
            ReturnValue(0)
        }
        IfCondition EqualTo(node_type, AST.CALL) ThenBlock: {
            cname = AST_GetData1(node)
            IfCondition EqualTo(Optimize_HomeCallOk(cname), 0) ThenBlock: {
                IfCondition LessThan(Compile_FindFunction(cname), 0) ThenBlock: {
                    LoopHome.blocked = 1
                    ReturnValue(0)
                }
                LoopHome.has_call = 1
            }
            IfCondition EqualTo(Optimize_HomeFma(node), 1) ThenBlock: {
                LoopHome.no_float = 1
            }
            Optimize_HomeWalkKids(node)
            ReturnValue(0)
        }
        Optimize_HomeWalkKids(node)
        ReturnValue(0)
    }
}

Function.Optimize_HomePick {
    Output: Integer
    Body: {
        best_int_name = 0
        best_int_off = 0
        best_int_score = 0
        best_flt_name = 0
        best_flt_off = 0
        best_flt_self = -1
        best_flt_score = 0
        best_flt_fresh = 0
        i = 0
        WhileLoop LessThan(i, LoopHome.count) {
            rec = Optimize_HomeRec(i)
            name = Dereference(rec)
            loads = Dereference(Add(rec, 8))
            stores = Dereference(Add(rec, 16))
            fops = Dereference(Add(rec, 24))
            selfn = Dereference(Add(rec, 32))
            IfCondition GreaterThan(loads, 0) ThenBlock: {
                IfCondition GreaterThan(stores, 0) ThenBlock: {
                    IfCondition GreaterThan(fops, 0) ThenBlock: {
                        IfCondition EqualTo(stores, fops) ThenBlock: {
                            IfCondition EqualTo(LoopHome.no_float, 0) ThenBlock: {
                                off = Scope_Resolve(name)
                                rt = Scope.resolve_type
                                slot_ok = 0
                                fresh = 0
                                cand_off = 0
                                IfCondition EqualTo(rt, 1) ThenBlock: {
                                    IfCondition LessThan(off, 0) ThenBlock: {
                                        slot_ok = 1
                                        cand_off = off
                                    }
                                }
                                IfCondition EqualTo(rt, 2) ThenBlock: {
                                    IfCondition LessThan(off, 0) ThenBlock: {
                                        slot_ok = 1
                                        cand_off = off
                                    }
                                }
                                IfCondition EqualTo(rt, 0) ThenBlock: {
                                    slot_ok = 1
                                    fresh = 1
                                }
                                IfCondition EqualTo(slot_ok, 1) ThenBlock: {
                                    IfCondition EqualTo(selfn, 0) ThenBlock: {
                                        IfCondition EqualTo(loads, stores) ThenBlock: {
                                            IfCondition EqualTo(Optimize_ConstTempSkip(name), 1) ThenBlock: { slot_ok = 0 }
                                        }
                                    }
                                    IfCondition EqualTo(slot_ok, 1) ThenBlock: {
                                    take = 0
                                    IfCondition GreaterThan(selfn, best_flt_self) ThenBlock: { take = 1 }
                                    IfCondition EqualTo(selfn, best_flt_self) ThenBlock: {
                                        IfCondition GreaterThan(fops, best_flt_score) ThenBlock: { take = 1 }
                                    }
                                    IfCondition EqualTo(take, 1) ThenBlock: {
                                        best_flt_self = selfn
                                        best_flt_score = fops
                                        best_flt_name = name
                                        best_flt_off = cand_off
                                        best_flt_fresh = fresh
                                    }
                                    }
                                }
                            }
                        }
                    }
                    IfCondition EqualTo(fops, 0) ThenBlock: {
                        off = Scope_Resolve(name)
                        rt = Scope.resolve_type
                        ok = 0
                        IfCondition EqualTo(rt, 1) ThenBlock: { ok = 1 }
                        IfCondition EqualTo(rt, 2) ThenBlock: { ok = 1 }
                        IfCondition GreaterEqual(off, 0) ThenBlock: { ok = 0 }
                        IfCondition EqualTo(ok, 1) ThenBlock: {
                            score = Add(loads, stores)
                            IfCondition GreaterThan(score, best_int_score) ThenBlock: {
                                best_int_score = score
                                best_int_name = name
                                best_int_off = off
                            }
                        }
                    }
                }
            }
            i = Add(i, 1)
        }
        IfCondition EqualTo(best_flt_fresh, 1) ThenBlock: {
            best_flt_off = Optimize_EnsureSlot(best_flt_name)
            IfCondition EqualTo(best_flt_off, 0) ThenBlock: { best_flt_name = 0 }
        }
        LoopHome.int_name = best_int_name
        LoopHome.int_off = best_int_off
        LoopHome.flt_name = best_flt_name
        LoopHome.flt_off = best_flt_off
        best_acc_name = 0
        best_acc_off = 0
        best_acc_self = 0
        best_acc_score = -1
        IfCondition NotEqual(best_int_name, 0) ThenBlock: {
            j = 0
            WhileLoop LessThan(j, LoopHome.count) {
                rec2 = Optimize_HomeRec(j)
                aname = Dereference(rec2)
                aloads = Dereference(Add(rec2, 8))
                astores = Dereference(Add(rec2, 16))
                afops = Dereference(Add(rec2, 24))
                aself = Dereference(Add(rec2, 32))
                ausable = 0
                IfCondition GreaterThan(aloads, 0) ThenBlock: {
                    IfCondition GreaterThan(astores, 0) ThenBlock: {
                        IfCondition EqualTo(afops, 0) ThenBlock: {
                            IfCondition GreaterThan(aself, 0) ThenBlock: {
                                IfCondition NotEqual(StringCompare(aname, best_int_name), 0) ThenBlock: {
                                    aoff = Scope_Resolve(aname)
                                    art = Scope.resolve_type
                                    aok = 0
                                    IfCondition EqualTo(art, 1) ThenBlock: { aok = 1 }
                                    IfCondition EqualTo(art, 2) ThenBlock: { aok = 1 }
                                    IfCondition GreaterEqual(aoff, 0) ThenBlock: { aok = 0 }
                                    IfCondition EqualTo(aok, 1) ThenBlock: { ausable = 1 }
                                    IfCondition EqualTo(ausable, 1) ThenBlock: {
                                        ascore = Add(aloads, astores)
                                        atake = 0
                                        IfCondition GreaterThan(aself, best_acc_self) ThenBlock: { atake = 1 }
                                        IfCondition EqualTo(aself, best_acc_self) ThenBlock: {
                                            IfCondition GreaterThan(ascore, best_acc_score) ThenBlock: { atake = 1 }
                                        }
                                        IfCondition EqualTo(atake, 1) ThenBlock: {
                                            best_acc_self = aself
                                            best_acc_score = ascore
                                            best_acc_name = aname
                                            best_acc_off = aoff
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
                j = Add(j, 1)
            }
        }
        LoopHome.acc_name = best_acc_name
        LoopHome.acc_off = best_acc_off
        IfCondition NotEqual(LoopHome.flt_name, 0) ThenBlock: {
            Optimize_HomePickExtras()
        }
        ReturnValue(0)
    }
}

Function.Optimize_LoopHomes {
    Input: condition: Address
    Input: body: Address
    Output: Integer
    Body: {
        LoopHome.blocked = 0
        LoopHome.no_float = 0
        LoopHome.count = 0
        LoopHome.int_name = 0
        LoopHome.flt_name = 0
        LoopHome.int_off = 0
        LoopHome.flt_off = 0
        LoopHome.acc_name = 0
        LoopHome.acc_off = 0
        LoopHome.assign_name = 0
        LoopHome.rbx_free = 0
        LoopHome.lim_on = 0
        LoopHome.alias_spill = 1
        LoopHome.hold_on = 0
        LoopHome.hold_name = 0
        LoopHome.body = 0
        LoopHome.f2_name = 0
        LoopHome.f2_off = 0
        LoopHome.f3_name = 0
        LoopHome.f3_off = 0
        LoopHome.f4_name = 0
        LoopHome.f4_off = 0
        LoopHome.tab_on = 0
        LoopHome.tab_name = 0
        LoopHome.tab_off = 0
        LoopHome.tab_many = 0
        LoopHome.has_call = 0
        LoopHome.scan_depth = 0
        LoopHome.hit_xmm = 0
        Optimize_AliasClearAll()
        Optimize_PtrClearAll()
        IfCondition EqualTo(LoopHome.recs, 0) ThenBlock: {
            LoopHome.recs = Allocate(640)
        }
        Optimize_HomeWalk(condition)
        Optimize_HomeWalk(body)
        IfCondition EqualTo(LoopHome.blocked, 1) ThenBlock: {
            LoopHome.int_name = 0
            LoopHome.flt_name = 0
            LoopHome.acc_name = 0
            LoopHome.f2_name = 0
            LoopHome.f3_name = 0
            LoopHome.f4_name = 0
            LoopHome.tab_on = 0
            ReturnValue(0)
        }
        LoopHome.body = body
        Optimize_HomePick()
        Optimize_AliasClearAll()
        LoopHome.hold_on = 0
        LoopHome.hold_name = 0
        have = 0
        IfCondition NotEqual(LoopHome.int_name, 0) ThenBlock: { have = 1 }
        IfCondition NotEqual(LoopHome.flt_name, 0) ThenBlock: { have = 1 }
        IfCondition NotEqual(LoopHome.acc_name, 0) ThenBlock: { have = 1 }
        IfCondition NotEqual(LoopHome.f2_name, 0) ThenBlock: { have = 1 }
        IfCondition EqualTo(have, 0) ThenBlock: { ReturnValue(0) }
        Optimize_ScanBody(body)
        Optimize_ScanCondTemps(condition, body)
        Optimize_ScanLimit(condition)
        Optimize_ScanTable(body)
        Optimize_AliasClearAll()
        LoopHome.hold_on = 0
        LoopHome.hold_name = 0
        ReturnValue(1)
    }
}

Function.Optimize_ReadImm {
    Input: node: Address
    Output: Integer
    Body: {
        LoopHome.imm_ok = 0
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        nt = AST_GetType(node)
        IfCondition NotEqual(nt, AST.NUMBER) ThenBlock: { ReturnValue(0) }
        val = StringToNumber(AST_GetData1(node))
        IfCondition LessThan(val, 0) ThenBlock: { ReturnValue(0) }
        LoopHome.imm_ok = 1
        LoopHome.imm_val = val
        ReturnValue(1)
    }
}

Function.Optimize_TryHomeAssign {
    Input: target_name: Address
    Input: value_node: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(Optimize_IsIntHome(target_name), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(value_node, 0) ThenBlock: { ReturnValue(0) }
        vt = AST_GetType(value_node)
        IfCondition NotEqual(vt, AST.CALL) ThenBlock: { ReturnValue(0) }
        opname = AST_GetData1(value_node)
        is_add = 0
        is_sub = 0
        IfCondition EqualTo(StringCompare(opname, "Add"), 0) ThenBlock: { is_add = 1 }
        IfCondition EqualTo(StringCompare(opname, "Subtract"), 0) ThenBlock: { is_sub = 1 }
        IfCondition EqualTo(is_add, 0) ThenBlock: {
            IfCondition EqualTo(is_sub, 0) ThenBlock: { ReturnValue(0) }
        }
        IfCondition NotEqual(AST_GetChildCount(value_node), 2) ThenBlock: { ReturnValue(0) }
        a0 = AST_GetChild(value_node, 0)
        a1 = AST_GetChild(value_node, 1)
        imm_side = -1
        IfCondition EqualTo(Optimize_ReadImm(a1), 1) ThenBlock: {
            imm_side = 1
        } ElseBlock: {
            IfCondition EqualTo(Optimize_ReadImm(a0), 1) ThenBlock: {
                imm_side = 0
            }
        }
        IfCondition LessThan(imm_side, 0) ThenBlock: { ReturnValue(0) }
        other = a0
        IfCondition EqualTo(imm_side, 0) ThenBlock: { other = a1 }
        IfCondition EqualTo(other, 0) ThenBlock: { ReturnValue(0) }
        ot = AST_GetType(other)
        IfCondition NotEqual(ot, AST.IDENTIFIER) ThenBlock: { ReturnValue(0) }
        oname = AST_GetData1(other)
        IfCondition NotEqual(StringCompare(oname, target_name), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(is_sub, 1) ThenBlock: {
            IfCondition NotEqual(imm_side, 1) ThenBlock: { ReturnValue(0) }
        }
        Optimize_AliasOnCursor()
        IfCondition EqualTo(is_add, 1) ThenBlock: { Emit_HomeMove(3, LoopHome.imm_val) }
        IfCondition EqualTo(is_sub, 1) ThenBlock: { Emit_HomeMove(4, LoopHome.imm_val) }
        ReturnValue(1)
    }
}

Function.Optimize_TryHomeDeref {
    Input: arg: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(LoopHome.active, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_CursorDisp(arg), 0) ThenBlock: { ReturnValue(0) }
        Emit_HomeMove(12, LoopHome.imm_val)
        ReturnValue(1)
    }
}

Function.Optimize_TryHomeCompare {
    Input: arg0: Address
    Input: arg1: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(LoopHome.active, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(LoopHome.int_name, 0) ThenBlock: { ReturnValue(0) }
        left_home = 0
        right_home = 0
        IfCondition NotEqual(arg0, 0) ThenBlock: {
            IfCondition EqualTo(AST_GetType(arg0), AST.IDENTIFIER) ThenBlock: {
                IfCondition EqualTo(Optimize_IsIntHome(AST_GetData1(arg0)), 1) ThenBlock: { left_home = 1 }
            }
        }
        IfCondition NotEqual(arg1, 0) ThenBlock: {
            IfCondition EqualTo(AST_GetType(arg1), AST.IDENTIFIER) ThenBlock: {
                IfCondition EqualTo(Optimize_IsIntHome(AST_GetData1(arg1)), 1) ThenBlock: { right_home = 1 }
            }
        }
        IfCondition EqualTo(left_home, right_home) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(left_home, 1) ThenBlock: {
            IfCondition EqualTo(Optimize_IsLeaf(arg1), 0) ThenBlock: { ReturnValue(0) }
            IfCondition EqualTo(Optimize_ReadImm(arg1), 1) ThenBlock: {
                Emit_HomeMove(15, LoopHome.imm_val)
                ReturnValue(1)
            }
            IfCondition EqualTo(LoopHome.rbx_free, 1) ThenBlock: {
                IfCondition EqualTo(LoopHome.lim_on, 1) ThenBlock: {
                    IfCondition EqualTo(AST_GetType(arg1), AST.IDENTIFIER) ThenBlock: {
                        IfCondition EqualTo(Optimize_NameEq(AST_GetData1(arg1), LoopHome.lim_name), 1) ThenBlock: {
                            Emit_HomeMove(13, 0)
                            ReturnValue(1)
                        }
                    }
                }
            }
            got = Optimize_LoadToRbx(arg1)
            IfCondition EqualTo(got, 0) ThenBlock: { ReturnValue(0) }
            Emit_HomeMove(13, 0)
            ReturnValue(1)
        }
        IfCondition EqualTo(Optimize_IsLeaf(arg0), 0) ThenBlock: { ReturnValue(0) }
        got = Compile_Expression(arg0)
        IfCondition EqualTo(got, 0) ThenBlock: { ReturnValue(0) }
        Emit_HomeMove(14, 0)
        ReturnValue(1)
    }
}

Function.Optimize_LoadLeafXmm {
    Input: node: Address
    Input: which: Integer
    Output: Integer
    Body: {
        node_type = AST_GetType(node)
        IfCondition EqualTo(node_type, AST.IDENTIFIER) ThenBlock: {
            name = AST_GetData1(node)
            IfCondition EqualTo(Optimize_IsFltHome(name), 1) ThenBlock: {
                slot = Optimize_FltSlot(name)
                IfCondition EqualTo(slot, 2) ThenBlock: {
                    IfCondition EqualTo(which, 0) ThenBlock: { Emit_HomeMove(7, 0) }
                    IfCondition EqualTo(which, 1) ThenBlock: { Emit_HomeMove(8, 0) }
                }
                IfCondition GreaterThan(slot, 2) ThenBlock: {
                    IfCondition EqualTo(which, 0) ThenBlock: { X86_XmmRR(3, slot) }
                    IfCondition EqualTo(which, 1) ThenBlock: { X86_XmmRR(8, slot) }
                }
                ReturnValue(1)
            }
            IfCondition EqualTo(Optimize_AliasFind(name), 1) ThenBlock: {
                IfCondition EqualTo(which, 0) ThenBlock: { Emit_HomeMove(24, LoopHome.hit_disp) }
                IfCondition EqualTo(which, 1) ThenBlock: { Emit_HomeMove(29, LoopHome.hit_disp) }
                ReturnValue(1)
            }
            IfCondition EqualTo(LoopHome.hold_on, 1) ThenBlock: {
                IfCondition EqualTo(Optimize_NameEq(name, LoopHome.hold_name), 1) ThenBlock: {
                    IfCondition EqualTo(which, 1) ThenBlock: { Emit_HomeMove(37, 0) }
                    ReturnValue(1)
                }
            }
        }
        result = Compile_Expression(node)
        IfCondition EqualTo(result, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(which, 0) ThenBlock: { Emit_HomeMove(11, 0) }
        IfCondition EqualTo(which, 1) ThenBlock: { Emit_HomeMove(10, 0) }
        ReturnValue(1)
    }
}

// =============================================================================
// DEBUG CONTROL
// =============================================================================
Function.Optimize_NameEq {
    Input: a: Address
    Input: b: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(a, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(b, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(StringCompare(a, b), 0) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

Function.Optimize_AliasClearAll {
    Body: {
        LoopHome.a0_on = 0
        LoopHome.a1_on = 0
        LoopHome.a2_on = 0
        LoopHome.a3_on = 0
    }
}

Function.Optimize_AliasFind {
    Input: name: Address
    Output: Integer
    Body: {
        LoopHome.hit_on = 0
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(LoopHome.a0_on, 1) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(name, LoopHome.a0_name), 1) ThenBlock: {
                LoopHome.hit_on = 1
                LoopHome.hit_disp = LoopHome.a0_disp
                ReturnValue(1)
            }
        }
        IfCondition EqualTo(LoopHome.a1_on, 1) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(name, LoopHome.a1_name), 1) ThenBlock: {
                LoopHome.hit_on = 1
                LoopHome.hit_disp = LoopHome.a1_disp
                ReturnValue(1)
            }
        }
        IfCondition EqualTo(LoopHome.a2_on, 1) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(name, LoopHome.a2_name), 1) ThenBlock: {
                LoopHome.hit_on = 1
                LoopHome.hit_disp = LoopHome.a2_disp
                ReturnValue(1)
            }
        }
        IfCondition EqualTo(LoopHome.a3_on, 1) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(name, LoopHome.a3_name), 1) ThenBlock: {
                LoopHome.hit_on = 1
                LoopHome.hit_disp = LoopHome.a3_disp
                ReturnValue(1)
            }
        }
        ReturnValue(0)
    }
}

Function.Optimize_AliasClear {
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(LoopHome.a0_on, 1) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(name, LoopHome.a0_name), 1) ThenBlock: { LoopHome.a0_on = 0 }
        }
        IfCondition EqualTo(LoopHome.a1_on, 1) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(name, LoopHome.a1_name), 1) ThenBlock: { LoopHome.a1_on = 0 }
        }
        IfCondition EqualTo(LoopHome.a2_on, 1) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(name, LoopHome.a2_name), 1) ThenBlock: { LoopHome.a2_on = 0 }
        }
        IfCondition EqualTo(LoopHome.a3_on, 1) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(name, LoopHome.a3_name), 1) ThenBlock: { LoopHome.a3_on = 0 }
        }
        ReturnValue(0)
    }
}

Function.Optimize_AliasAdd {
    Input: name: Address
    Input: disp: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(Optimize_AliasFind(name), 1) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(name, LoopHome.a0_name), 1) ThenBlock: {
                IfCondition EqualTo(LoopHome.a0_on, 1) ThenBlock: {
                    LoopHome.a0_disp = disp
                    ReturnValue(1)
                }
            }
            IfCondition EqualTo(Optimize_NameEq(name, LoopHome.a1_name), 1) ThenBlock: {
                IfCondition EqualTo(LoopHome.a1_on, 1) ThenBlock: {
                    LoopHome.a1_disp = disp
                    ReturnValue(1)
                }
            }
            IfCondition EqualTo(Optimize_NameEq(name, LoopHome.a2_name), 1) ThenBlock: {
                IfCondition EqualTo(LoopHome.a2_on, 1) ThenBlock: {
                    LoopHome.a2_disp = disp
                    ReturnValue(1)
                }
            }
            IfCondition EqualTo(Optimize_NameEq(name, LoopHome.a3_name), 1) ThenBlock: {
                IfCondition EqualTo(LoopHome.a3_on, 1) ThenBlock: {
                    LoopHome.a3_disp = disp
                    ReturnValue(1)
                }
            }
        }
        IfCondition EqualTo(LoopHome.a0_on, 0) ThenBlock: {
            LoopHome.a0_on = 1
            LoopHome.a0_name = name
            LoopHome.a0_disp = disp
            ReturnValue(1)
        }
        IfCondition EqualTo(LoopHome.a1_on, 0) ThenBlock: {
            LoopHome.a1_on = 1
            LoopHome.a1_name = name
            LoopHome.a1_disp = disp
            ReturnValue(1)
        }
        IfCondition EqualTo(LoopHome.a2_on, 0) ThenBlock: {
            LoopHome.a2_on = 1
            LoopHome.a2_name = name
            LoopHome.a2_disp = disp
            ReturnValue(1)
        }
        IfCondition EqualTo(LoopHome.a3_on, 0) ThenBlock: {
            LoopHome.a3_on = 1
            LoopHome.a3_name = name
            LoopHome.a3_disp = disp
            ReturnValue(1)
        }
        ReturnValue(0)
    }
}

Function.Optimize_AliasFlush {
    Body: {
        on0 = LoopHome.a0_on
        n0 = LoopHome.a0_name
        d0 = LoopHome.a0_disp
        on1 = LoopHome.a1_on
        n1 = LoopHome.a1_name
        d1 = LoopHome.a1_disp
        on2 = LoopHome.a2_on
        n2 = LoopHome.a2_name
        d2 = LoopHome.a2_disp
        on3 = LoopHome.a3_on
        n3 = LoopHome.a3_name
        d3 = LoopHome.a3_disp
        Optimize_AliasClearAll()
        IfCondition EqualTo(on0, 1) ThenBlock: {
            Emit_HomeMove(12, d0)
            CompileExpr_StoreVariable(n0)
        }
        IfCondition EqualTo(on1, 1) ThenBlock: {
            Emit_HomeMove(12, d1)
            CompileExpr_StoreVariable(n1)
        }
        IfCondition EqualTo(on2, 1) ThenBlock: {
            Emit_HomeMove(12, d2)
            CompileExpr_StoreVariable(n2)
        }
        IfCondition EqualTo(on3, 1) ThenBlock: {
            Emit_HomeMove(12, d3)
            CompileExpr_StoreVariable(n3)
        }
    }
}

Function.Optimize_AliasOnCursor {
    Body: {
        Optimize_PtrClearAll()
        IfCondition EqualTo(LoopHome.alias_spill, 1) ThenBlock: {
            Optimize_AliasFlush()
        } ElseBlock: {
            Optimize_AliasClearAll()
        }
    }
}

// A pointer alias says the local holds the homed cursor plus a displacement.
// rec = cursor, then rec@w, is the same address as Dereference(Add(cursor, 8)).
// The field load uses r13. The null test stays on the stack-reload path.
Function.Optimize_PtrClearAll {
    Body: {
        LoopHome.p0_on = 0
        LoopHome.p1_on = 0
        LoopHome.p2_on = 0
        LoopHome.p3_on = 0
    }
}

Function.Optimize_PtrFind {
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(LoopHome.p0_on, 1) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(name, LoopHome.p0_name), 1) ThenBlock: {
                LoopHome.hit_disp = LoopHome.p0_disp
                ReturnValue(1)
            }
        }
        IfCondition EqualTo(LoopHome.p1_on, 1) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(name, LoopHome.p1_name), 1) ThenBlock: {
                LoopHome.hit_disp = LoopHome.p1_disp
                ReturnValue(1)
            }
        }
        IfCondition EqualTo(LoopHome.p2_on, 1) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(name, LoopHome.p2_name), 1) ThenBlock: {
                LoopHome.hit_disp = LoopHome.p2_disp
                ReturnValue(1)
            }
        }
        IfCondition EqualTo(LoopHome.p3_on, 1) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(name, LoopHome.p3_name), 1) ThenBlock: {
                LoopHome.hit_disp = LoopHome.p3_disp
                ReturnValue(1)
            }
        }
        ReturnValue(0)
    }
}

Function.Optimize_PtrClear {
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(LoopHome.p0_on, 1) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(name, LoopHome.p0_name), 1) ThenBlock: { LoopHome.p0_on = 0 }
        }
        IfCondition EqualTo(LoopHome.p1_on, 1) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(name, LoopHome.p1_name), 1) ThenBlock: { LoopHome.p1_on = 0 }
        }
        IfCondition EqualTo(LoopHome.p2_on, 1) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(name, LoopHome.p2_name), 1) ThenBlock: { LoopHome.p2_on = 0 }
        }
        IfCondition EqualTo(LoopHome.p3_on, 1) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(name, LoopHome.p3_name), 1) ThenBlock: { LoopHome.p3_on = 0 }
        }
        ReturnValue(0)
    }
}

Function.Optimize_PtrAdd {
    Input: name: Address
    Input: disp: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(Optimize_PtrFind(name), 1) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(name, LoopHome.p0_name), 1) ThenBlock: {
                IfCondition EqualTo(LoopHome.p0_on, 1) ThenBlock: {
                    LoopHome.p0_disp = disp
                    ReturnValue(1)
                }
            }
            IfCondition EqualTo(Optimize_NameEq(name, LoopHome.p1_name), 1) ThenBlock: {
                IfCondition EqualTo(LoopHome.p1_on, 1) ThenBlock: {
                    LoopHome.p1_disp = disp
                    ReturnValue(1)
                }
            }
            IfCondition EqualTo(Optimize_NameEq(name, LoopHome.p2_name), 1) ThenBlock: {
                IfCondition EqualTo(LoopHome.p2_on, 1) ThenBlock: {
                    LoopHome.p2_disp = disp
                    ReturnValue(1)
                }
            }
            IfCondition EqualTo(Optimize_NameEq(name, LoopHome.p3_name), 1) ThenBlock: {
                IfCondition EqualTo(LoopHome.p3_on, 1) ThenBlock: {
                    LoopHome.p3_disp = disp
                    ReturnValue(1)
                }
            }
        }
        IfCondition EqualTo(LoopHome.p0_on, 0) ThenBlock: {
            LoopHome.p0_on = 1
            LoopHome.p0_name = name
            LoopHome.p0_disp = disp
            ReturnValue(1)
        }
        IfCondition EqualTo(LoopHome.p1_on, 0) ThenBlock: {
            LoopHome.p1_on = 1
            LoopHome.p1_name = name
            LoopHome.p1_disp = disp
            ReturnValue(1)
        }
        IfCondition EqualTo(LoopHome.p2_on, 0) ThenBlock: {
            LoopHome.p2_on = 1
            LoopHome.p2_name = name
            LoopHome.p2_disp = disp
            ReturnValue(1)
        }
        IfCondition EqualTo(LoopHome.p3_on, 0) ThenBlock: {
            LoopHome.p3_on = 1
            LoopHome.p3_name = name
            LoopHome.p3_disp = disp
            ReturnValue(1)
        }
        ReturnValue(0)
    }
}

Function.Optimize_NotePtrCopy {
    Input: target: Address
    Input: value: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(LoopHome.active, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_IsIntHome(target), 1) ThenBlock: {
            Optimize_PtrClearAll()
            ReturnValue(0)
        }
        IfCondition EqualTo(Optimize_CursorDisp(value), 0) ThenBlock: {
            Optimize_PtrClear(target)
            ReturnValue(0)
        }
        ReturnValue(Optimize_PtrAdd(target, LoopHome.imm_val))
    }
}

// Sets hit_disp to the r13 displacement of this field. 0 means use the stack path.
Function.Optimize_FieldHomeDisp {
    Input: base: Address
    Input: offset: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(LoopHome.active, 0) ThenBlock: { ReturnValue(0) }
        disp = -1
        IfCondition EqualTo(Optimize_IsIntHome(base), 1) ThenBlock: {
            disp = 0
        }
        IfCondition EqualTo(disp, -1) ThenBlock: {
            IfCondition EqualTo(Optimize_PtrFind(base), 1) ThenBlock: {
                disp = LoopHome.hit_disp
            }
        }
        IfCondition LessThan(disp, 0) ThenBlock: { ReturnValue(0) }
        total = Add(disp, offset)
        IfCondition LessThan(total, 0) ThenBlock: { ReturnValue(0) }
        LoopHome.hit_disp = total
        ReturnValue(1)
    }
}

// A plain field is one qword. Nested records and pointer fields stay on the
// normal path so their pool type is still recorded.
Function.Optimize_FieldPlain {
    Input: base: Address
    Input: field: Address
    Output: Integer
    Body: {
        LoopHome.imm_ok = 0
        IfCondition EqualTo(base, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(field, 0) ThenBlock: { ReturnValue(0) }
        pool_type = Scope_GetVarPoolType(base)
        IfCondition EqualTo(pool_type, 0) ThenBlock: { ReturnValue(0) }
        pool_name = Pool_ExtractPoolName(pool_type)
        entry = Pool_FindField(pool_name, field)
        IfCondition EqualTo(entry, 0) ThenBlock: { ReturnValue(0) }
        ftype = Dereference(Add(entry, 24))
        IfCondition EqualTo(ftype, PoolConst.TYPE_NESTED) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(ftype, PoolConst.TYPE_POINTER) ThenBlock: { ReturnValue(0) }
        direction = Dereference(Add(entry, 16))
        IfCondition EqualTo(Scope_IsParameter(base), 1) ThenBlock: {
            IfCondition EqualTo(direction, PoolConst.DIR_OUTPUT) ThenBlock: { ReturnValue(0) }
        }
        off = Dereference(Add(entry, 8))
        IfCondition LessThan(off, 0) ThenBlock: { ReturnValue(0) }
        LoopHome.imm_ok = 1
        LoopHome.imm_val = off
        ReturnValue(1)
    }
}

// w = rec@w, when rec is the homed cursor or a straight-line copy of it,
// is the same value as Dereference(Add(cursor, disp)). The copy has to be
// a direct statement of this loop body, before this read, with no store
// to the cursor in between.
Function.Optimize_FieldMemDisp {
    Input: target: Address
    Input: value: Address
    Output: Integer
    Body: {
        LoopHome.imm_ok = 0
        IfCondition EqualTo(target, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(value, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(LoopHome.int_name, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_NameEq(target, LoopHome.int_name), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_NameEq(target, LoopHome.flt_name), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_NameEq(target, LoopHome.f2_name), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_NameEq(target, LoopHome.f3_name), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_NameEq(target, LoopHome.f4_name), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_NameEq(target, LoopHome.acc_name), 1) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(value), AST.POINTER_FIELD_ACCESS) ThenBlock: { ReturnValue(0) }
        base = AST_GetData1(value)
        field = AST_GetData2(value)
        IfCondition EqualTo(Optimize_FieldPlain(base, field), 0) ThenBlock: { ReturnValue(0) }
        field_off = LoopHome.imm_val
        body = LoopHome.body
        IfCondition EqualTo(body, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(body), AST.BLOCK) ThenBlock: { ReturnValue(0) }
        found = -1
        count = AST_GetChildCount(body)
        i = 0
        WhileLoop LessThan(i, count) {
            st = AST_GetChild(body, i)
            IfCondition NotEqual(st, 0) ThenBlock: {
                IfCondition EqualTo(AST_GetType(st), AST.ASSIGNMENT) ThenBlock: {
                    IfCondition EqualTo(AST_GetData2(st), 0) ThenBlock: {
                        IfCondition EqualTo(AST_GetChild(st, 0), value) ThenBlock: {
                            IfCondition EqualTo(Optimize_NameEq(AST_GetData1(st), target), 1) ThenBlock: {
                                found = i
                                i = count
                            }
                        }
                    }
                }
            }
            i = Add(i, 1)
        }
        IfCondition LessThan(found, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_NameEq(base, LoopHome.int_name), 1) ThenBlock: {
            LoopHome.imm_ok = 1
            LoopHome.imm_val = field_off
            ReturnValue(1)
        }
        last = -1
        j = 0
        WhileLoop LessThan(j, found) {
            sj = AST_GetChild(body, j)
            IfCondition NotEqual(sj, 0) ThenBlock: {
                IfCondition EqualTo(AST_GetType(sj), AST.ASSIGNMENT) ThenBlock: {
                    IfCondition EqualTo(AST_GetData2(sj), 0) ThenBlock: {
                        tname = AST_GetData1(sj)
                        IfCondition EqualTo(Optimize_NameEq(tname, LoopHome.int_name), 1) ThenBlock: {
                            last = -1
                        }
                        IfCondition EqualTo(Optimize_NameEq(tname, base), 1) ThenBlock: {
                            last = j
                        }
                    }
                }
            }
            j = Add(j, 1)
        }
        IfCondition LessThan(last, 0) ThenBlock: { ReturnValue(0) }
        src = AST_GetChild(AST_GetChild(body, last), 0)
        IfCondition EqualTo(Optimize_CursorDisp(src), 0) ThenBlock: { ReturnValue(0) }
        total = Add(LoopHome.imm_val, field_off)
        IfCondition LessThan(total, 0) ThenBlock: { ReturnValue(0) }
        LoopHome.imm_ok = 1
        LoopHome.imm_val = total
        ReturnValue(1)
    }
}

Function.Optimize_MemAliasShape {
    Input: target: Address
    Input: value: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(Optimize_DerefAliasShape(target, value), 1) ThenBlock: { ReturnValue(1) }
        ReturnValue(Optimize_FieldMemDisp(target, value))
    }
}

// rec = cursor does not use rbx. An Add into that copy does, so it stays
// off this list and still counts as a cursor copy for the field displacement.
Function.Optimize_PtrCopyShape {
    Input: target: Address
    Input: value: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(target, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(value, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(LoopHome.int_name, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_NameEq(target, LoopHome.int_name), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_NameEq(target, LoopHome.flt_name), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_NameEq(target, LoopHome.f2_name), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_NameEq(target, LoopHome.f3_name), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_NameEq(target, LoopHome.f4_name), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_NameEq(target, LoopHome.acc_name), 1) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(value), AST.IDENTIFIER) ThenBlock: { ReturnValue(0) }
        ReturnValue(Optimize_CursorDisp(value))
    }
}

Function.Optimize_FlushHold {
    Output: Integer
    Body: {
        IfCondition EqualTo(LoopHome.hold_on, 0) ThenBlock: { ReturnValue(0) }
        hold_name = LoopHome.hold_name
        LoopHome.hold_on = 0
        LoopHome.hold_name = 0
        Emit_HomeMove(30, 0)
        CompileExpr_StoreVariable(hold_name)
        ReturnValue(0)
    }
}

Function.Optimize_CursorDisp {
    Input: node: Address
    Output: Integer
    Body: {
        LoopHome.imm_ok = 0
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(LoopHome.int_name, 0) ThenBlock: { ReturnValue(0) }
        at = AST_GetType(node)
        IfCondition EqualTo(at, AST.IDENTIFIER) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(AST_GetData1(node), LoopHome.int_name), 1) ThenBlock: {
                LoopHome.imm_ok = 1
                LoopHome.imm_val = 0
                ReturnValue(1)
            }
            ReturnValue(0)
        }
        IfCondition NotEqual(at, AST.CALL) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(StringCompare(AST_GetData1(node), "Add"), 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetChildCount(node), 2) ThenBlock: { ReturnValue(0) }
        a0 = AST_GetChild(node, 0)
        a1 = AST_GetChild(node, 1)
        imm_side = -1
        IfCondition EqualTo(Optimize_ReadImm(a1), 1) ThenBlock: {
            imm_side = 1
        } ElseBlock: {
            IfCondition EqualTo(Optimize_ReadImm(a0), 1) ThenBlock: {
                imm_side = 0
            }
        }
        IfCondition LessThan(imm_side, 0) ThenBlock: { ReturnValue(0) }
        other = a0
        IfCondition EqualTo(imm_side, 0) ThenBlock: { other = a1 }
        IfCondition EqualTo(other, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(other), AST.IDENTIFIER) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_NameEq(AST_GetData1(other), LoopHome.int_name), 0) ThenBlock: { ReturnValue(0) }
        LoopHome.imm_ok = 1
        ReturnValue(1)
    }
}

Function.Optimize_DerefAliasShape {
    Input: target: Address
    Input: value: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(target, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(value, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_NameEq(target, LoopHome.int_name), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_NameEq(target, LoopHome.flt_name), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_NameEq(target, LoopHome.f2_name), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_NameEq(target, LoopHome.f3_name), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_NameEq(target, LoopHome.f4_name), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_NameEq(target, LoopHome.acc_name), 1) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(value), AST.CALL) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(StringCompare(AST_GetData1(value), "Dereference"), 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetChildCount(value), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_CursorDisp(AST_GetChild(value, 0)), 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(1)
    }
}

Function.Optimize_CursorAddShape {
    Input: target: Address
    Input: value: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(Optimize_NameEq(target, LoopHome.int_name), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(value, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(value), AST.CALL) ThenBlock: { ReturnValue(0) }
        opname = AST_GetData1(value)
        is_add = 0
        is_sub = 0
        IfCondition EqualTo(StringCompare(opname, "Add"), 0) ThenBlock: { is_add = 1 }
        IfCondition EqualTo(StringCompare(opname, "Subtract"), 0) ThenBlock: { is_sub = 1 }
        IfCondition EqualTo(is_add, 0) ThenBlock: {
            IfCondition EqualTo(is_sub, 0) ThenBlock: { ReturnValue(0) }
        }
        IfCondition NotEqual(AST_GetChildCount(value), 2) ThenBlock: { ReturnValue(0) }
        a0 = AST_GetChild(value, 0)
        a1 = AST_GetChild(value, 1)
        imm_side = -1
        IfCondition EqualTo(Optimize_ReadImm(a1), 1) ThenBlock: {
            imm_side = 1
        } ElseBlock: {
            IfCondition EqualTo(Optimize_ReadImm(a0), 1) ThenBlock: {
                imm_side = 0
            }
        }
        IfCondition LessThan(imm_side, 0) ThenBlock: { ReturnValue(0) }
        other = a0
        IfCondition EqualTo(imm_side, 0) ThenBlock: { other = a1 }
        IfCondition EqualTo(other, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(other), AST.IDENTIFIER) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_NameEq(AST_GetData1(other), target), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(is_sub, 1) ThenBlock: {
            IfCondition NotEqual(imm_side, 1) ThenBlock: { ReturnValue(0) }
        }
        ReturnValue(1)
    }
}

Function.Optimize_AccOther {
    Input: node: Address
    Output: Integer
    Body: {
        LoopHome.hit_class = 0
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(AST_GetType(node), AST.IDENTIFIER) ThenBlock: {
            nm = AST_GetData1(node)
            IfCondition EqualTo(Optimize_NameEq(nm, LoopHome.int_name), 1) ThenBlock: {
                LoopHome.hit_class = 5
                ReturnValue(5)
            }
            IfCondition EqualTo(Optimize_AliasFind(nm), 1) ThenBlock: {
                LoopHome.hit_class = 2
                ReturnValue(2)
            }
            ReturnValue(0)
        }
        IfCondition EqualTo(AST_GetType(node), AST.CALL) ThenBlock: {
            IfCondition EqualTo(StringCompare(AST_GetData1(node), "Dereference"), 0) ThenBlock: {
                IfCondition EqualTo(AST_GetChildCount(node), 1) ThenBlock: {
                    IfCondition EqualTo(Optimize_CursorDisp(AST_GetChild(node, 0)), 1) ThenBlock: {
                        LoopHome.hit_class = 4
                        LoopHome.hit_disp = LoopHome.imm_val
                        ReturnValue(4)
                    }
                }
            }
        }
        IfCondition EqualTo(Optimize_ReadImm(node), 1) ThenBlock: {
            LoopHome.hit_class = 7
            LoopHome.hit_disp = LoopHome.imm_val
            ReturnValue(7)
        }
        ReturnValue(0)
    }
}

Function.Optimize_AccShape {
    Input: target: Address
    Input: value: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(LoopHome.acc_name, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_NameEq(target, LoopHome.acc_name), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(value, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(value), AST.CALL) ThenBlock: { ReturnValue(0) }
        opname = AST_GetData1(value)
        is_add = 0
        is_sub = 0
        IfCondition EqualTo(StringCompare(opname, "Add"), 0) ThenBlock: { is_add = 1 }
        IfCondition EqualTo(StringCompare(opname, "Subtract"), 0) ThenBlock: { is_sub = 1 }
        IfCondition EqualTo(is_add, 0) ThenBlock: {
            IfCondition EqualTo(is_sub, 0) ThenBlock: { ReturnValue(0) }
        }
        IfCondition NotEqual(AST_GetChildCount(value), 2) ThenBlock: { ReturnValue(0) }
        a0 = AST_GetChild(value, 0)
        a1 = AST_GetChild(value, 1)
        left_acc = 0
        right_acc = 0
        IfCondition EqualTo(AST_GetType(a0), AST.IDENTIFIER) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(AST_GetData1(a0), LoopHome.acc_name), 1) ThenBlock: { left_acc = 1 }
        }
        IfCondition EqualTo(AST_GetType(a1), AST.IDENTIFIER) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(AST_GetData1(a1), LoopHome.acc_name), 1) ThenBlock: { right_acc = 1 }
        }
        other = 0
        IfCondition EqualTo(is_add, 1) ThenBlock: {
            IfCondition EqualTo(left_acc, 1) ThenBlock: {
                IfCondition EqualTo(right_acc, 0) ThenBlock: { other = a1 }
            }
            IfCondition EqualTo(right_acc, 1) ThenBlock: {
                IfCondition EqualTo(left_acc, 0) ThenBlock: { other = a0 }
            }
        }
        IfCondition EqualTo(is_sub, 1) ThenBlock: {
            IfCondition EqualTo(left_acc, 1) ThenBlock: {
                IfCondition EqualTo(right_acc, 0) ThenBlock: { other = a1 }
            }
        }
        IfCondition EqualTo(other, 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(Optimize_AccOther(other))
    }
}

Function.Optimize_FltOpKind {
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(StringCompare(name, "Float_Add"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "Float_Sub"), 0) ThenBlock: { ReturnValue(2) }
        IfCondition EqualTo(StringCompare(name, "Float_Mul"), 0) ThenBlock: { ReturnValue(3) }
        IfCondition EqualTo(StringCompare(name, "Float_Div"), 0) ThenBlock: { ReturnValue(4) }
        ReturnValue(0)
    }
}

Function.Optimize_RbxSafeOp {
    Input: node: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        nt = AST_GetType(node)
        IfCondition EqualTo(nt, AST.NUMBER) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(nt, AST.IDENTIFIER) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(nt, AST.CALL) ThenBlock: {
            IfCondition EqualTo(StringCompare(AST_GetData1(node), "Dereference"), 0) ThenBlock: {
                IfCondition EqualTo(AST_GetChildCount(node), 1) ThenBlock: {
                    IfCondition EqualTo(Optimize_CursorDisp(AST_GetChild(node, 0)), 1) ThenBlock: { ReturnValue(1) }
                }
            }
        }
        ReturnValue(0)
    }
}

Function.Optimize_OpClass {
    Input: node: Address
    Output: Integer
    Body: {
        LoopHome.hit_class = 0
        LoopHome.hit_disp = 0
        LoopHome.hit_xmm = 0
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        nt = AST_GetType(node)
        IfCondition EqualTo(nt, AST.IDENTIFIER) ThenBlock: {
            nm = AST_GetData1(node)
            IfCondition EqualTo(Optimize_IsFltHome(nm), 1) ThenBlock: {
                LoopHome.hit_class = 1
                LoopHome.hit_xmm = Optimize_FltSlot(nm)
                ReturnValue(1)
            }
            IfCondition EqualTo(LoopHome.hold_on, 1) ThenBlock: {
                IfCondition EqualTo(Optimize_NameEq(nm, LoopHome.hold_name), 1) ThenBlock: {
                    LoopHome.hit_class = 3
                    ReturnValue(1)
                }
            }
            IfCondition EqualTo(Optimize_AliasFind(nm), 1) ThenBlock: {
                LoopHome.hit_class = 2
                ReturnValue(1)
            }
            IfCondition EqualTo(Optimize_IsIntHome(nm), 1) ThenBlock: {
                LoopHome.hit_class = 5
                ReturnValue(1)
            }
            off = Scope_Resolve(nm)
            rt = Scope.resolve_type
            IfCondition EqualTo(rt, 3) ThenBlock: {
                pidx = BitwiseAnd(off, 2147483647)
                LoopHome.hit_class = 7
                LoopHome.hit_disp = Multiply(pidx, 8)
                ReturnValue(1)
            }
            frame = 0
            IfCondition EqualTo(rt, 1) ThenBlock: { frame = 1 }
            IfCondition EqualTo(rt, 2) ThenBlock: { frame = 1 }
            IfCondition EqualTo(frame, 1) ThenBlock: {
                IfCondition LessThan(off, 0) ThenBlock: {
                    LoopHome.hit_class = 6
                    LoopHome.hit_disp = off
                    ReturnValue(1)
                }
            }
            ReturnValue(0)
        }
        IfCondition EqualTo(nt, AST.CALL) ThenBlock: {
            IfCondition EqualTo(StringCompare(AST_GetData1(node), "Dereference"), 0) ThenBlock: {
                IfCondition EqualTo(AST_GetChildCount(node), 1) ThenBlock: {
                    IfCondition EqualTo(Optimize_CursorDisp(AST_GetChild(node, 0)), 1) ThenBlock: {
                        LoopHome.hit_class = 4
                        LoopHome.hit_disp = LoopHome.imm_val
                        ReturnValue(1)
                    }
                }
            }
        }
        IfCondition EqualTo(nt, AST.NUMBER) ThenBlock: {
            IfCondition EqualTo(OptState.flt_ready, 1) ThenBlock: {
                bits = StringToNumber(AST_GetData1(node))
                disp = Optimize_FltConstDisp(bits)
                IfCondition LessThan(disp, 0) ThenBlock: {
                    LoopHome.hit_class = 8
                    LoopHome.hit_disp = disp
                    ReturnValue(1)
                }
            }
            ReturnValue(0)
        }
        ReturnValue(0)
    }
}

Function.Optimize_TreeHasName {
    Input: node: Address
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }
        nt = AST_GetType(node)
        IfCondition EqualTo(nt, AST.IDENTIFIER) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(AST_GetData1(node), name), 1) ThenBlock: { ReturnValue(1) }
        }
        IfCondition EqualTo(nt, AST.ASSIGNMENT) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(AST_GetData1(node), name), 1) ThenBlock: { ReturnValue(1) }
        }
        count = AST_GetChildCount(node)
        i = 0
        WhileLoop LessThan(i, count) {
            IfCondition EqualTo(Optimize_TreeHasName(AST_GetChild(node, i), name), 1) ThenBlock: { ReturnValue(1) }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

Function.Optimize_TreeHasIdent {
    Input: node: Address
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }
        nt = AST_GetType(node)
        IfCondition EqualTo(nt, AST.IDENTIFIER) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(AST_GetData1(node), name), 1) ThenBlock: { ReturnValue(1) }
        }
        count = AST_GetChildCount(node)
        i = 0
        WhileLoop LessThan(i, count) {
            IfCondition EqualTo(Optimize_TreeHasIdent(AST_GetChild(node, i), name), 1) ThenBlock: { ReturnValue(1) }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

Function.Optimize_CountWalk {
    Input: node: Address
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        nt = AST_GetType(node)
        IfCondition EqualTo(nt, AST.IDENTIFIER) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(AST_GetData1(node), name), 1) ThenBlock: {
                LoopHome.mention_count = Add(LoopHome.mention_count, 1)
            }
        }
        IfCondition EqualTo(nt, AST.ASSIGNMENT) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(AST_GetData1(node), name), 1) ThenBlock: {
                LoopHome.mention_count = Add(LoopHome.mention_count, 1)
            }
        }
        count = AST_GetChildCount(node)
        i = 0
        WhileLoop LessThan(i, count) {
            Optimize_CountWalk(AST_GetChild(node, i), name)
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

Function.Optimize_CountMentions {
    Input: name: Address
    Output: Integer
    Body: {
        LoopHome.mention_count = 0
        Optimize_CountWalk(LoopHome.body, name)
        ReturnValue(LoopHome.mention_count)
    }
}

Function.Optimize_HoldOk {
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition NotEqual(Optimize_CountMentions(name), 2) ThenBlock: { ReturnValue(0) }
        body = LoopHome.body
        IfCondition EqualTo(body, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(body), AST.BLOCK) ThenBlock: { ReturnValue(0) }
        count = AST_GetChildCount(body)
        def_at = -1
        use_at = -1
        i = 0
        WhileLoop LessThan(i, count) {
            st = AST_GetChild(body, i)
            IfCondition NotEqual(st, 0) ThenBlock: {
                IfCondition EqualTo(AST_GetType(st), AST.ASSIGNMENT) ThenBlock: {
                    IfCondition EqualTo(Optimize_NameEq(AST_GetData1(st), name), 1) ThenBlock: {
                        IfCondition LessThan(def_at, 0) ThenBlock: { def_at = i }
                    }
                }
                IfCondition EqualTo(Optimize_TreeHasIdent(st, name), 1) ThenBlock: {
                    IfCondition LessThan(use_at, 0) ThenBlock: { use_at = i }
                }
            }
            i = Add(i, 1)
        }
        IfCondition LessThan(def_at, 0) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(use_at, 0) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterThan(use_at, def_at) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

Function.Optimize_AssignNested {
    Input: node: Address
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(AST_GetType(node), AST.ASSIGNMENT) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(AST_GetData1(node), name), 1) ThenBlock: {
                ReturnValue(1)
            }
        }
        count = AST_GetChildCount(node)
        i = 0
        WhileLoop LessThan(i, count) {
            IfCondition EqualTo(Optimize_AssignNested(AST_GetChild(node, i), name), 1) ThenBlock: {
                ReturnValue(1)
            }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

Function.Optimize_HoldIn {
    Input: block: Address
    Input: target: Address
    Input: value: Address
    Output: Integer
    Body: {
        body = block
        IfCondition EqualTo(body, 0) ThenBlock: { ReturnValue(0) }
        blk = 0
        IfCondition EqualTo(AST_GetType(body), AST.BLOCK) ThenBlock: { blk = 1 }
        IfCondition EqualTo(AST_GetType(body), AST.BODY) ThenBlock: { blk = 1 }
        IfCondition EqualTo(blk, 0) ThenBlock: { ReturnValue(0) }
        count = AST_GetChildCount(body)
        found = -1
        i = 0
        WhileLoop LessThan(i, count) {
            st = AST_GetChild(body, i)
            IfCondition NotEqual(st, 0) ThenBlock: {
                IfCondition EqualTo(AST_GetType(st), AST.ASSIGNMENT) ThenBlock: {
                    IfCondition EqualTo(AST_GetData2(st), 0) ThenBlock: {
                        IfCondition EqualTo(Optimize_NameEq(AST_GetData1(st), target), 1) ThenBlock: {
                            IfCondition EqualTo(AST_GetChild(st, 0), value) ThenBlock: {
                                found = i
                                i = count
                            }
                        }
                    }
                }
            }
            i = Add(i, 1)
        }
        IfCondition LessThan(found, 0) ThenBlock: { ReturnValue(0) }
        uses = 0
        k = Add(found, 1)
        WhileLoop LessThan(k, count) {
            sk = AST_GetChild(body, k)
            stop = 0
            IfCondition NotEqual(sk, 0) ThenBlock: {
                IfCondition EqualTo(AST_GetType(sk), AST.ASSIGNMENT) ThenBlock: {
                    IfCondition EqualTo(AST_GetData2(sk), 0) ThenBlock: {
                        IfCondition EqualTo(Optimize_NameEq(AST_GetData1(sk), target), 1) ThenBlock: {
                            stop = 1
                        }
                        IfCondition EqualTo(Optimize_CursorAddShape(AST_GetData1(sk), AST_GetChild(sk, 0)), 1) ThenBlock: {
                            stop = 1
                        }
                    }
                }
                IfCondition EqualTo(stop, 0) ThenBlock: {
                    nt = AST_GetType(sk)
                    nest = 0
                    IfCondition EqualTo(nt, AST.IF) ThenBlock: { nest = 1 }
                    IfCondition EqualTo(nt, AST.FORK) ThenBlock: { nest = 1 }
                    IfCondition EqualTo(nt, AST.SWITCH) ThenBlock: { nest = 1 }
                    IfCondition EqualTo(nt, AST.BRANCH) ThenBlock: { nest = 1 }
                    IfCondition EqualTo(nt, AST.WHILE) ThenBlock: { nest = 1 }
                    IfCondition EqualTo(nest, 1) ThenBlock: {
                        IfCondition EqualTo(Optimize_TreeHasIdent(sk, target), 1) ThenBlock: {
                            ReturnValue(0)
                        }
                    }
                    IfCondition EqualTo(Optimize_TreeHasIdent(sk, target), 1) ThenBlock: {
                        uses = Add(uses, 1)
                    }
                }
            }
            IfCondition EqualTo(stop, 1) ThenBlock: { k = count }
            k = Add(k, 1)
        }
        IfCondition EqualTo(uses, 1) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

Function.Optimize_HoldHere {
    Input: target: Address
    Input: value: Address
    Output: Integer
    Body: {
        ReturnValue(Optimize_HoldIn(LoopHome.body, target, value))
    }
}

Function.Optimize_HoldFind {
    Input: node: Address
    Input: target: Address
    Input: value: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        t = AST_GetType(node)
        IfCondition EqualTo(Optimize_FoldIsFn(t), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_FoldIsBlock(node), 1) ThenBlock: {
            count = AST_GetChildCount(node)
            i = 0
            WhileLoop LessThan(i, count) {
                st = AST_GetChild(node, i)
                IfCondition NotEqual(st, 0) ThenBlock: {
                    IfCondition EqualTo(AST_GetType(st), AST.ASSIGNMENT) ThenBlock: {
                        IfCondition EqualTo(AST_GetData2(st), 0) ThenBlock: {
                            IfCondition EqualTo(Optimize_NameEq(AST_GetData1(st), target), 1) ThenBlock: {
                                IfCondition EqualTo(AST_GetChild(st, 0), value) ThenBlock: {
                                    OptState.hold_block = node
                                    ReturnValue(1)
                                }
                            }
                        }
                    }
                }
                i = Add(i, 1)
            }
        }
        count = AST_GetChildCount(node)
        i = 0
        WhileLoop LessThan(i, count) {
            IfCondition EqualTo(Optimize_HoldFind(AST_GetChild(node, i), target, value), 1) ThenBlock: { ReturnValue(1) }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

Function.Optimize_HoldArm {
    Input: target: Address
    Input: value: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(LoopHome.body, 0) ThenBlock: { ReturnValue(0) }
        OptState.hold_block = 0
        IfCondition EqualTo(Optimize_HoldFind(LoopHome.body, target, value), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(OptState.hold_block, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(OptState.hold_block, LoopHome.body) ThenBlock: { ReturnValue(0) }
        ReturnValue(Optimize_HoldIn(OptState.hold_block, target, value))
    }
}

Function.Optimize_HoldChain {
    Input: name: Address
    Output: Integer
    Body: {
        body = LoopHome.body
        IfCondition EqualTo(body, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(body), AST.BLOCK) ThenBlock: { ReturnValue(0) }
        count = AST_GetChildCount(body)
        found = 0
        i = 0
        WhileLoop LessThan(i, count) {
            st = AST_GetChild(body, i)
            IfCondition NotEqual(st, 0) ThenBlock: {
                IfCondition EqualTo(AST_GetType(st), AST.ASSIGNMENT) ThenBlock: {
                    IfCondition EqualTo(AST_GetData2(st), 0) ThenBlock: {
                        IfCondition EqualTo(Optimize_NameEq(AST_GetData1(st), name), 1) ThenBlock: {
                            value = AST_GetChild(st, 0)
                            opk = 0
                            IfCondition NotEqual(value, 0) ThenBlock: {
                                IfCondition EqualTo(AST_GetType(value), AST.CALL) ThenBlock: {
                                    opk = Optimize_FltOpKind(AST_GetData1(value))
                                }
                            }
                            legal = 0
                            IfCondition EqualTo(opk, 1) ThenBlock: { legal = 1 }
                            IfCondition EqualTo(opk, 2) ThenBlock: { legal = 1 }
                            IfCondition EqualTo(opk, 3) ThenBlock: { legal = 1 }
                            IfCondition EqualTo(legal, 0) ThenBlock: { ReturnValue(0) }
                            IfCondition EqualTo(Optimize_HoldHere(name, value), 0) ThenBlock: { ReturnValue(0) }
                            IfCondition EqualTo(Optimize_AssignNested(value, name), 1) ThenBlock: { ReturnValue(0) }
                            found = 1
                        }
                    }
                } ElseBlock: {
                    IfCondition EqualTo(Optimize_AssignNested(st, name), 1) ThenBlock: { ReturnValue(0) }
                }
            }
            i = Add(i, 1)
        }
        ReturnValue(found)
    }
}

Function.Optimize_AliasLive {
    Output: Integer
    Body: {
        n = 0
        IfCondition EqualTo(LoopHome.a0_on, 1) ThenBlock: { n = Add(n, 1) }
        IfCondition EqualTo(LoopHome.a1_on, 1) ThenBlock: { n = Add(n, 1) }
        IfCondition EqualTo(LoopHome.a2_on, 1) ThenBlock: { n = Add(n, 1) }
        IfCondition EqualTo(LoopHome.a3_on, 1) ThenBlock: { n = Add(n, 1) }
        ReturnValue(n)
    }
}

Function.Optimize_EnsureSlot {
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }
        off = Scope_Resolve(name)
        rt = Scope.resolve_type
        IfCondition EqualTo(rt, 1) ThenBlock: {
            IfCondition LessThan(off, 0) ThenBlock: { ReturnValue(off) }
        }
        IfCondition EqualTo(rt, 2) ThenBlock: {
            IfCondition LessThan(off, 0) ThenBlock: { ReturnValue(off) }
        }
        IfCondition EqualTo(rt, 0) ThenBlock: {
            Compile.stack_offset = Add(Compile.stack_offset, 8)
            off = Subtract(0, Compile.stack_offset)
            Compile_RegisterLocal(name, off)
            ReturnValue(off)
        }
        ReturnValue(0)
    }
}

Function.Optimize_NameTaken {
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(Optimize_NameEq(name, LoopHome.flt_name), 1) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(Optimize_NameEq(name, LoopHome.f2_name), 1) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(Optimize_NameEq(name, LoopHome.f3_name), 1) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(Optimize_NameEq(name, LoopHome.f4_name), 1) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(Optimize_NameEq(name, LoopHome.int_name), 1) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(Optimize_NameEq(name, LoopHome.acc_name), 1) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

Function.Optimize_ExtraTake {
    Output: Integer
    Body: {
        free = 0
        IfCondition EqualTo(LoopHome.f2_name, 0) ThenBlock: { free = 1 }
        IfCondition EqualTo(LoopHome.f3_name, 0) ThenBlock: { free = 1 }
        IfCondition EqualTo(LoopHome.f4_name, 0) ThenBlock: { free = 1 }
        IfCondition EqualTo(free, 0) ThenBlock: { ReturnValue(0) }
        best_name = 0
        best_off = 0
        best_self = -1
        best_fops = 0
        best_fresh = 0
        i = 0
        WhileLoop LessThan(i, LoopHome.count) {
            rec = Optimize_HomeRec(i)
            name = Dereference(rec)
            loads = Dereference(Add(rec, 8))
            stores = Dereference(Add(rec, 16))
            fops = Dereference(Add(rec, 24))
            selfn = Dereference(Add(rec, 32))
            IfCondition EqualTo(Optimize_NameTaken(name), 0) ThenBlock: {
                IfCondition GreaterThan(loads, 0) ThenBlock: {
                    IfCondition GreaterThan(stores, 0) ThenBlock: {
                        IfCondition GreaterThan(fops, 0) ThenBlock: {
                            IfCondition EqualTo(stores, fops) ThenBlock: {
                                off = Scope_Resolve(name)
                                rt = Scope.resolve_type
                                slot_ok = 0
                                fresh = 0
                                cand_off = 0
                                IfCondition EqualTo(rt, 1) ThenBlock: {
                                    IfCondition LessThan(off, 0) ThenBlock: {
                                        slot_ok = 1
                                        cand_off = off
                                    }
                                }
                                IfCondition EqualTo(rt, 2) ThenBlock: {
                                    IfCondition LessThan(off, 0) ThenBlock: {
                                        slot_ok = 1
                                        cand_off = off
                                    }
                                }
                                IfCondition EqualTo(rt, 0) ThenBlock: {
                                    slot_ok = 1
                                    fresh = 1
                                }
                                IfCondition EqualTo(slot_ok, 1) ThenBlock: {
                                    IfCondition EqualTo(Optimize_HoldOk(name), 1) ThenBlock: { slot_ok = 0 }
                                    IfCondition EqualTo(Optimize_HoldChain(name), 1) ThenBlock: { slot_ok = 0 }
                                    IfCondition EqualTo(selfn, 0) ThenBlock: {
                                        IfCondition EqualTo(loads, stores) ThenBlock: {
                                            IfCondition EqualTo(Optimize_ConstTempSkip(name), 1) ThenBlock: { slot_ok = 0 }
                                        }
                                    }
                                }
                                IfCondition EqualTo(slot_ok, 1) ThenBlock: {
                                    take = 0
                                    IfCondition GreaterThan(selfn, best_self) ThenBlock: { take = 1 }
                                    IfCondition EqualTo(selfn, best_self) ThenBlock: {
                                        IfCondition GreaterThan(fops, best_fops) ThenBlock: { take = 1 }
                                    }
                                    IfCondition EqualTo(take, 1) ThenBlock: {
                                        best_self = selfn
                                        best_fops = fops
                                        best_name = name
                                        best_off = cand_off
                                        best_fresh = fresh
                                    }
                                }
                            }
                        }
                    }
                }
            }
            i = Add(i, 1)
        }
        IfCondition EqualTo(best_name, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(best_fresh, 1) ThenBlock: {
            best_off = Optimize_EnsureSlot(best_name)
            IfCondition EqualTo(best_off, 0) ThenBlock: { ReturnValue(0) }
        }
        IfCondition EqualTo(LoopHome.f2_name, 0) ThenBlock: {
            LoopHome.f2_name = best_name
            LoopHome.f2_off = best_off
            ReturnValue(1)
        }
        IfCondition EqualTo(LoopHome.f3_name, 0) ThenBlock: {
            LoopHome.f3_name = best_name
            LoopHome.f3_off = best_off
            ReturnValue(1)
        }
        IfCondition EqualTo(LoopHome.f4_name, 0) ThenBlock: {
            LoopHome.f4_name = best_name
            LoopHome.f4_off = best_off
            ReturnValue(1)
        }
        ReturnValue(0)
    }
}

Function.Optimize_HomePickExtras {
    Output: Integer
    Body: {
        IfCondition EqualTo(LoopHome.flt_name, 0) ThenBlock: { ReturnValue(0) }
        Optimize_ExtraTake()
        Optimize_ExtraTake()
        Optimize_ExtraTake()
        ReturnValue(0)
    }
}

Function.Optimize_HomeCallSave {
    Body: {
        IfCondition EqualTo(LoopHome.active, 1) ThenBlock: {
            Optimize_FlushHold()
            IfCondition NotEqual(LoopHome.int_name, 0) ThenBlock: {
                Emit_HomeMove(1, 0)
                Emit_MovRbpOffsetRax(LoopHome.int_off)
            }
            IfCondition NotEqual(LoopHome.flt_name, 0) ThenBlock: {
                Emit_HomeMove(5, 0)
                Emit_MovRbpOffsetRax(LoopHome.flt_off)
            }
            IfCondition NotEqual(LoopHome.f2_name, 0) ThenBlock: {
                X86_XmmRR(2, 3)
                Emit_MovRbpOffsetRax(LoopHome.f2_off)
            }
            IfCondition NotEqual(LoopHome.f3_name, 0) ThenBlock: {
                X86_XmmRR(2, 4)
                Emit_MovRbpOffsetRax(LoopHome.f3_off)
            }
            IfCondition NotEqual(LoopHome.f4_name, 0) ThenBlock: {
                X86_XmmRR(2, 5)
                Emit_MovRbpOffsetRax(LoopHome.f4_off)
            }
        }
    }
}

Function.Optimize_HomeCallLoad {
    Body: {
        IfCondition EqualTo(LoopHome.active, 1) ThenBlock: {
            IfCondition NotEqual(LoopHome.int_name, 0) ThenBlock: {
                Emit_MovRaxRbpOffset(LoopHome.int_off)
                Emit_HomeMove(2, 0)
            }
            IfCondition NotEqual(LoopHome.flt_name, 0) ThenBlock: {
                Emit_MovRaxRbpOffset(LoopHome.flt_off)
                Emit_HomeMove(6, 0)
            }
            IfCondition NotEqual(LoopHome.f2_name, 0) ThenBlock: {
                Emit_MovRaxRbpOffset(LoopHome.f2_off)
                X86_XmmRR(1, 3)
            }
            IfCondition NotEqual(LoopHome.f3_name, 0) ThenBlock: {
                Emit_MovRaxRbpOffset(LoopHome.f3_off)
                X86_XmmRR(1, 4)
            }
            IfCondition NotEqual(LoopHome.f4_name, 0) ThenBlock: {
                Emit_MovRaxRbpOffset(LoopHome.f4_off)
                X86_XmmRR(1, 5)
            }
            IfCondition EqualTo(LoopHome.tab_on, 1) ThenBlock: {
                Emit_MovRaxRbpOffset(LoopHome.tab_off)
                Emit_MovR14Rax()
            }
        }
    }
}

Function.Optimize_ScanBlock {
    Input: node: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(1) }
        IfCondition NotEqual(AST_GetType(node), AST.BLOCK) ThenBlock: {
            ReturnValue(Optimize_ScanNode(node))
        }
        count = AST_GetChildCount(node)
        ok = 1
        i = 0
        WhileLoop LessThan(i, count) {
            IfCondition EqualTo(Optimize_ScanNode(AST_GetChild(node, i)), 0) ThenBlock: { ok = 0 }
            i = Add(i, 1)
        }
        ReturnValue(ok)
    }
}

Function.Optimize_ScanCondSafe {
    Input: node: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(node), AST.CALL) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_IsCompareName(AST_GetData1(node)), 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetChildCount(node), 2) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_IsLeaf(AST_GetChild(node, 0)), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_IsLeaf(AST_GetChild(node, 1)), 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(AST_GetChild(node, 1)), AST.NUMBER) ThenBlock: { ReturnValue(0) }
        ReturnValue(1)
    }
}

Function.Optimize_ScanIf {
    Input: node: Address
    Output: Integer
    Body: {
        safe = Optimize_ScanCondSafe(AST_GetChild(node, 0))
        LoopHome.scan_depth = Add(LoopHome.scan_depth, 1)
        IfCondition EqualTo(Optimize_ScanBlock(AST_GetChild(node, 1)), 0) ThenBlock: { safe = 0 }
        IfCondition GreaterThan(AST_GetChildCount(node), 2) ThenBlock: {
            IfCondition EqualTo(Optimize_ScanBlock(AST_GetChild(node, 2)), 0) ThenBlock: { safe = 0 }
        }
        LoopHome.scan_depth = Subtract(LoopHome.scan_depth, 1)
        ReturnValue(safe)
    }
}

Function.Optimize_ScanBranch {
    Input: node: Address
    Output: Integer
    Body: {
        safe = 1
        scr = AST_GetChild(node, 0)
        IfCondition EqualTo(scr, 0) ThenBlock: { safe = 0 }
        IfCondition NotEqual(scr, 0) ThenBlock: {
            st = AST_GetType(scr)
            leaf = 0
            IfCondition EqualTo(st, AST.IDENTIFIER) ThenBlock: { leaf = 1 }
            IfCondition EqualTo(st, AST.NUMBER) ThenBlock: { leaf = 1 }
            IfCondition EqualTo(leaf, 0) ThenBlock: { safe = 0 }
        }
        n = AST_GetChildCount(node)
        i = 1
        WhileLoop LessThan(i, n) {
            ch = AST_GetChild(node, i)
            IfCondition NotEqual(ch, 0) ThenBlock: {
                IfCondition EqualTo(AST_GetType(ch), AST.CASE) ThenBlock: {
                    IfCondition EqualTo(Optimize_IsLeaf(AST_GetChild(ch, 0)), 0) ThenBlock: { safe = 0 }
                }
            }
            i = Add(i, 1)
        }
        LoopHome.scan_depth = Add(LoopHome.scan_depth, 1)
        i = 1
        WhileLoop LessThan(i, n) {
            ch = AST_GetChild(node, i)
            IfCondition NotEqual(ch, 0) ThenBlock: {
                IfCondition EqualTo(AST_GetType(ch), AST.CASE) ThenBlock: {
                    IfCondition EqualTo(Optimize_ScanBlock(AST_GetChild(ch, 1)), 0) ThenBlock: { safe = 0 }
                }
                IfCondition EqualTo(AST_GetType(ch), AST.DEFAULT) ThenBlock: {
                    IfCondition EqualTo(Optimize_ScanBlock(AST_GetChild(ch, 0)), 0) ThenBlock: { safe = 0 }
                }
            }
            i = Add(i, 1)
        }
        LoopHome.scan_depth = Subtract(LoopHome.scan_depth, 1)
        ReturnValue(safe)
    }
}

Function.Optimize_ScanNode {
    Input: node: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        nt = AST_GetType(node)
        IfCondition EqualTo(nt, AST.ASSIGNMENT) ThenBlock: { ReturnValue(Optimize_ScanStmt(node)) }
        IfCondition EqualTo(nt, AST.BLOCK) ThenBlock: { ReturnValue(Optimize_ScanBlock(node)) }
        IfCondition EqualTo(nt, AST.IF) ThenBlock: { ReturnValue(Optimize_ScanIf(node)) }
        IfCondition EqualTo(nt, AST.FORK) ThenBlock: { ReturnValue(Optimize_ScanIf(node)) }
        IfCondition EqualTo(nt, AST.SWITCH) ThenBlock: { ReturnValue(Optimize_ScanBranch(node)) }
        IfCondition EqualTo(nt, AST.BRANCH) ThenBlock: { ReturnValue(Optimize_ScanBranch(node)) }
        ReturnValue(0)
    }
}

Function.Optimize_CallArgsSafe {
    Input: node: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        n = AST_GetChildCount(node)
        i = 0
        WhileLoop LessThan(i, n) {
            IfCondition EqualTo(Optimize_RbxSafeOp(AST_GetChild(node, i)), 0) ThenBlock: { ReturnValue(0) }
            i = Add(i, 1)
        }
        ReturnValue(1)
    }
}

Function.Optimize_ScaledBase {
    Input: node: Address
    Output: Integer
    Body: {
        LoopHome.hold_name = 0
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(node), AST.CALL) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(StringCompare(AST_GetData1(node), "Dereference"), 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetChildCount(node), 1) ThenBlock: { ReturnValue(0) }
        addr = AST_GetChild(node, 0)
        IfCondition EqualTo(addr, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(addr), AST.CALL) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(StringCompare(AST_GetData1(addr), "Add"), 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetChildCount(addr), 2) ThenBlock: { ReturnValue(0) }
        mul = AST_GetChild(addr, 1)
        IfCondition EqualTo(mul, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(mul), AST.CALL) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(StringCompare(AST_GetData1(mul), "Multiply"), 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetChildCount(mul), 2) ThenBlock: { ReturnValue(0) }
        scale_node = AST_GetChild(mul, 1)
        IfCondition EqualTo(scale_node, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(scale_node), AST.NUMBER) ThenBlock: { ReturnValue(0) }
        sv = StringToNumber(AST_GetData1(scale_node))
        scale_ok = 0
        IfCondition EqualTo(sv, 1) ThenBlock: { scale_ok = 1 }
        IfCondition EqualTo(sv, 2) ThenBlock: { scale_ok = 1 }
        IfCondition EqualTo(sv, 4) ThenBlock: { scale_ok = 1 }
        IfCondition EqualTo(sv, 8) ThenBlock: { scale_ok = 1 }
        IfCondition EqualTo(scale_ok, 0) ThenBlock: { ReturnValue(0) }
        index = AST_GetChild(mul, 0)
        base = AST_GetChild(addr, 0)
        IfCondition EqualTo(base, 0) ThenBlock: { ReturnValue(2) }
        IfCondition EqualTo(AST_GetType(base), AST.IDENTIFIER) ThenBlock: {
            IfCondition EqualTo(Optimize_RbxSafeOp(index), 1) ThenBlock: {
                LoopHome.hold_name = AST_GetData1(base)
                ReturnValue(1)
            }
        }
        ReturnValue(2)
    }
}

Function.Optimize_AssignsName {
    Input: node: Address
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(AST_GetType(node), AST.ASSIGNMENT) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(AST_GetData1(node), name), 1) ThenBlock: { ReturnValue(1) }
        }
        count = AST_GetChildCount(node)
        i = 0
        WhileLoop LessThan(i, count) {
            IfCondition EqualTo(Optimize_AssignsName(AST_GetChild(node, i), name), 1) ThenBlock: { ReturnValue(1) }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

Function.Optimize_NoteTable {
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(LoopHome.tab_many, 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(LoopHome.tab_on, 1) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(name, LoopHome.tab_name), 0) ThenBlock: {
                LoopHome.tab_on = 0
                LoopHome.tab_many = 1
            }
            ReturnValue(0)
        }
        IfCondition EqualTo(Optimize_AssignsName(LoopHome.body, name), 1) ThenBlock: {
            LoopHome.tab_many = 1
            ReturnValue(0)
        }
        off = Scope_Resolve(name)
        rt = Scope.resolve_type
        ok = 0
        IfCondition EqualTo(rt, 1) ThenBlock: { ok = 1 }
        IfCondition EqualTo(rt, 2) ThenBlock: { ok = 1 }
        IfCondition GreaterEqual(off, 0) ThenBlock: { ok = 0 }
        IfCondition EqualTo(ok, 0) ThenBlock: {
            LoopHome.tab_many = 1
            ReturnValue(0)
        }
        LoopHome.tab_on = 1
        LoopHome.tab_name = name
        LoopHome.tab_off = off
        ReturnValue(1)
    }
}

Function.Optimize_ScanTableWalk {
    Input: node: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        k = Optimize_ScaledBase(node)
        IfCondition EqualTo(k, 1) ThenBlock: { Optimize_NoteTable(LoopHome.hold_name) }
        IfCondition EqualTo(k, 2) ThenBlock: {
            LoopHome.tab_on = 0
            LoopHome.tab_many = 1
        }
        n = AST_GetChildCount(node)
        i = 0
        WhileLoop LessThan(i, n) {
            Optimize_ScanTableWalk(AST_GetChild(node, i))
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

Function.Optimize_ScanTable {
    Input: body: Address
    Body: {
        LoopHome.tab_on = 0
        LoopHome.tab_name = 0
        LoopHome.tab_off = 0
        LoopHome.tab_many = 0
        Optimize_ScanTableWalk(body)
        LoopHome.hold_name = 0
    }
}

Function.Optimize_ScanStmt {
    Input: node: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(node), AST.ASSIGNMENT) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetData2(node), 0) ThenBlock: { ReturnValue(0) }
        target = AST_GetData1(node)
        value = AST_GetChild(node, 0)
        IfCondition EqualTo(value, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_MemAliasShape(target, value), 1) ThenBlock: {
            disp = LoopHome.imm_val
            IfCondition GreaterThan(LoopHome.scan_depth, 0) ThenBlock: { LoopHome.alias_spill = 1 }
            IfCondition EqualTo(Optimize_AliasAdd(target, disp), 0) ThenBlock: { ReturnValue(0) }
            live = Optimize_AliasLive()
            IfCondition GreaterThan(live, LoopHome.scan_temps) ThenBlock: {
                LoopHome.scan_temps = live
            }
            ReturnValue(1)
        }
        IfCondition EqualTo(Optimize_CursorAddShape(target, value), 1) ThenBlock: {
            LoopHome.scan_updates = Add(LoopHome.scan_updates, 1)
            Optimize_AliasClearAll()
            ReturnValue(1)
        }
        IfCondition NotEqual(Optimize_AccShape(target, value), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(AST_GetType(value), AST.CALL) ThenBlock: {
            opk = Optimize_FltOpKind(AST_GetData1(value))
            IfCondition GreaterThan(opk, 0) ThenBlock: {
                IfCondition EqualTo(AST_GetChildCount(value), 2) ThenBlock: {
                    IfCondition EqualTo(Optimize_RbxSafeOp(AST_GetChild(value, 0)), 1) ThenBlock: {
                        IfCondition EqualTo(Optimize_RbxSafeOp(AST_GetChild(value, 1)), 1) ThenBlock: {
                            ReturnValue(1)
                        }
                    }
                }
            }
        }
        IfCondition EqualTo(AST_GetType(value), AST.CALL) ThenBlock: {
            sk = Optimize_ScaledBase(value)
            IfCondition EqualTo(sk, 1) ThenBlock: { ReturnValue(1) }
            IfCondition EqualTo(Optimize_HomeCallOk(AST_GetData1(value)), 0) ThenBlock: {
                IfCondition GreaterEqual(Compile_FindFunction(AST_GetData1(value)), 0) ThenBlock: {
                    IfCondition EqualTo(Optimize_CallArgsSafe(value), 1) ThenBlock: { ReturnValue(1) }
                }
            }
        }
        IfCondition EqualTo(Optimize_PtrCopyShape(target, value), 1) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

Function.Optimize_ScanLifetimes {
    Input: body: Address
    Output: Integer
    Body: {
        count = AST_GetChildCount(body)
        i = 0
        WhileLoop LessThan(i, count) {
            st = AST_GetChild(body, i)
            IfCondition NotEqual(st, 0) ThenBlock: {
                IfCondition EqualTo(AST_GetType(st), AST.ASSIGNMENT) ThenBlock: {
                    IfCondition EqualTo(AST_GetData2(st), 0) ThenBlock: {
                        tgt = AST_GetData1(st)
                        IfCondition EqualTo(Optimize_MemAliasShape(tgt, AST_GetChild(st, 0)), 1) ThenBlock: {
                            prev = -1
                            j = 0
                            WhileLoop LessThan(j, i) {
                                sj = AST_GetChild(body, j)
                                IfCondition NotEqual(sj, 0) ThenBlock: {
                                    IfCondition EqualTo(AST_GetType(sj), AST.ASSIGNMENT) ThenBlock: {
                                        IfCondition EqualTo(AST_GetData2(sj), 0) ThenBlock: {
                                            IfCondition EqualTo(Optimize_NameEq(AST_GetData1(sj), tgt), 1) ThenBlock: {
                                                prev = j
                                            }
                                        }
                                    }
                                }
                                j = Add(j, 1)
                            }
                            IfCondition LessThan(prev, 0) ThenBlock: {
                                j = 0
                                WhileLoop LessThan(j, i) {
                                    IfCondition EqualTo(Optimize_TreeHasName(AST_GetChild(body, j), tgt), 1) ThenBlock: {
                                        LoopHome.alias_spill = 1
                                    }
                                    j = Add(j, 1)
                                }
                            }
                            u = -1
                            j = Add(i, 1)
                            WhileLoop LessThan(j, count) {
                                sj = AST_GetChild(body, j)
                                IfCondition NotEqual(sj, 0) ThenBlock: {
                                    IfCondition EqualTo(AST_GetType(sj), AST.ASSIGNMENT) ThenBlock: {
                                        IfCondition EqualTo(AST_GetData2(sj), 0) ThenBlock: {
                                            IfCondition EqualTo(Optimize_CursorAddShape(AST_GetData1(sj), AST_GetChild(sj, 0)), 1) ThenBlock: {
                                                u = j
                                                j = count
                                            }
                                        }
                                    }
                                }
                                j = Add(j, 1)
                            }
                            IfCondition LessThan(u, 0) ThenBlock: {
                                LoopHome.alias_spill = 1
                            }
                            IfCondition GreaterEqual(u, 0) ThenBlock: {
                                IfCondition EqualTo(Optimize_TreeHasName(AST_GetChild(body, u), tgt), 1) ThenBlock: {
                                    LoopHome.alias_spill = 1
                                }
                                k = Add(u, 1)
                                WhileLoop LessThan(k, count) {
                                    sk = AST_GetChild(body, k)
                                    hit_def = 0
                                    IfCondition NotEqual(sk, 0) ThenBlock: {
                                        IfCondition EqualTo(AST_GetType(sk), AST.ASSIGNMENT) ThenBlock: {
                                            IfCondition EqualTo(AST_GetData2(sk), 0) ThenBlock: {
                                                IfCondition EqualTo(Optimize_NameEq(AST_GetData1(sk), tgt), 1) ThenBlock: {
                                                    hit_def = 1
                                                    IfCondition EqualTo(Optimize_TreeHasName(AST_GetChild(sk, 0), tgt), 1) ThenBlock: {
                                                        LoopHome.alias_spill = 1
                                                    }
                                                    k = count
                                                }
                                            }
                                        }
                                    }
                                    IfCondition EqualTo(hit_def, 0) ThenBlock: {
                                        IfCondition EqualTo(Optimize_TreeHasName(sk, tgt), 1) ThenBlock: {
                                            LoopHome.alias_spill = 1
                                        }
                                    }
                                    k = Add(k, 1)
                                }
                            }
                        }
                    }
                }
            }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

Function.Optimize_ScanBody {
    Input: body: Address
    Output: Integer
    Body: {
        LoopHome.rbx_free = 1
        LoopHome.alias_spill = 0
        LoopHome.scan_temps = 0
        LoopHome.scan_updates = 0
        LoopHome.scan_depth = 0
        Optimize_AliasClearAll()
        LoopHome.hold_on = 0
        IfCondition EqualTo(body, 0) ThenBlock: {
            LoopHome.rbx_free = 0
            ReturnValue(0)
        }
        IfCondition NotEqual(AST_GetType(body), AST.BLOCK) ThenBlock: {
            LoopHome.rbx_free = 0
            ReturnValue(0)
        }
        count = AST_GetChildCount(body)
        i = 0
        WhileLoop LessThan(i, count) {
            IfCondition EqualTo(Optimize_ScanNode(AST_GetChild(body, i)), 0) ThenBlock: {
                LoopHome.rbx_free = 0
            }
            i = Add(i, 1)
        }
        IfCondition EqualTo(LoopHome.scan_updates, 0) ThenBlock: { LoopHome.alias_spill = 1 }
        IfCondition GreaterThan(LoopHome.scan_temps, 4) ThenBlock: { LoopHome.alias_spill = 1 }
        IfCondition GreaterThan(LoopHome.scan_temps, 4) ThenBlock: { LoopHome.rbx_free = 0 }
        IfCondition EqualTo(LoopHome.alias_spill, 0) ThenBlock: {
            Optimize_ScanLifetimes(body)
        }
        Optimize_AliasClearAll()
        LoopHome.hold_on = 0
        LoopHome.hold_name = 0
        ReturnValue(0)
    }
}

Function.Optimize_ScanCondTemps {
    Input: condition: Address
    Input: body: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(LoopHome.alias_spill, 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(condition, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(body, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(body), AST.BLOCK) ThenBlock: { ReturnValue(0) }
        count = AST_GetChildCount(body)
        i = 0
        WhileLoop LessThan(i, count) {
            st = AST_GetChild(body, i)
            IfCondition NotEqual(st, 0) ThenBlock: {
                IfCondition EqualTo(AST_GetType(st), AST.ASSIGNMENT) ThenBlock: {
                    IfCondition EqualTo(AST_GetData2(st), 0) ThenBlock: {
                        tgt = AST_GetData1(st)
                        IfCondition EqualTo(Optimize_MemAliasShape(tgt, AST_GetChild(st, 0)), 1) ThenBlock: {
                            IfCondition EqualTo(Optimize_TreeHasName(condition, tgt), 1) ThenBlock: {
                                LoopHome.alias_spill = 1
                            }
                        }
                    }
                }
            }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

Function.Optimize_BodyAssigns {
    Input: name: Address
    Output: Integer
    Body: {
        body = LoopHome.body
        IfCondition EqualTo(body, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(body), AST.BLOCK) ThenBlock: { ReturnValue(0) }
        count = AST_GetChildCount(body)
        i = 0
        WhileLoop LessThan(i, count) {
            st = AST_GetChild(body, i)
            IfCondition NotEqual(st, 0) ThenBlock: {
                IfCondition EqualTo(AST_GetType(st), AST.ASSIGNMENT) ThenBlock: {
                    IfCondition EqualTo(Optimize_NameEq(AST_GetData1(st), name), 1) ThenBlock: { ReturnValue(1) }
                }
            }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

Function.Optimize_ScanLimit {
    Input: condition: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(LoopHome.rbx_free, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(condition, 0) ThenBlock: {
            LoopHome.rbx_free = 0
            ReturnValue(0)
        }
        IfCondition NotEqual(AST_GetType(condition), AST.CALL) ThenBlock: {
            LoopHome.rbx_free = 0
            ReturnValue(0)
        }
        IfCondition EqualTo(Optimize_IsCompareName(AST_GetData1(condition)), 0) ThenBlock: {
            LoopHome.rbx_free = 0
            ReturnValue(0)
        }
        IfCondition NotEqual(AST_GetChildCount(condition), 2) ThenBlock: {
            LoopHome.rbx_free = 0
            ReturnValue(0)
        }
        a0 = AST_GetChild(condition, 0)
        a1 = AST_GetChild(condition, 1)
        IfCondition EqualTo(Optimize_IsLeaf(a0), 0) ThenBlock: {
            LoopHome.rbx_free = 0
            ReturnValue(0)
        }
        IfCondition EqualTo(Optimize_IsLeaf(a1), 0) ThenBlock: {
            LoopHome.rbx_free = 0
            ReturnValue(0)
        }
        home_left = 0
        home_right = 0
        IfCondition EqualTo(AST_GetType(a0), AST.IDENTIFIER) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(AST_GetData1(a0), LoopHome.int_name), 1) ThenBlock: { home_left = 1 }
        }
        IfCondition EqualTo(AST_GetType(a1), AST.IDENTIFIER) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(AST_GetData1(a1), LoopHome.int_name), 1) ThenBlock: { home_right = 1 }
        }
        IfCondition EqualTo(home_left, home_right) ThenBlock: {
            LoopHome.rbx_free = 0
            ReturnValue(0)
        }
        other = a1
        IfCondition EqualTo(home_right, 1) ThenBlock: { other = a0 }
        IfCondition EqualTo(AST_GetType(other), AST.NUMBER) ThenBlock: {
            LoopHome.lim_on = 0
            ReturnValue(1)
        }
        IfCondition EqualTo(AST_GetType(other), AST.IDENTIFIER) ThenBlock: {
            nm = AST_GetData1(other)
            off = Scope_Resolve(nm)
            rt = Scope.resolve_type
            ok = 0
            IfCondition EqualTo(rt, 1) ThenBlock: { ok = 1 }
            IfCondition EqualTo(rt, 2) ThenBlock: { ok = 1 }
            IfCondition GreaterEqual(off, 0) ThenBlock: { ok = 0 }
            IfCondition EqualTo(ok, 1) ThenBlock: {
                IfCondition EqualTo(Optimize_BodyAssigns(nm), 1) ThenBlock: {
                    LoopHome.rbx_free = 0
                    ReturnValue(0)
                }
                LoopHome.lim_on = 1
                LoopHome.lim_name = nm
                LoopHome.lim_off = off
                ReturnValue(1)
            }
        }
        LoopHome.rbx_free = 0
        ReturnValue(0)
    }
}

Function.Optimize_TryAliasAssign {
    Input: target: Address
    Input: value: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(LoopHome.active, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(LoopHome.alias_spill, 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_MemAliasShape(target, value), 0) ThenBlock: { ReturnValue(0) }
        disp = LoopHome.imm_val
        IfCondition EqualTo(Optimize_AliasAdd(target, disp), 0) ThenBlock: { ReturnValue(0) }
        Optimize_FlushHold()
        ReturnValue(1)
    }
}

Function.Optimize_TryAccAssign {
    Input: target: Address
    Input: value: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(LoopHome.active, 0) ThenBlock: { ReturnValue(0) }
        cls = Optimize_AccShape(target, value)
        IfCondition EqualTo(cls, 0) ThenBlock: { ReturnValue(0) }
        opname = AST_GetData1(value)
        is_sub = 0
        IfCondition EqualTo(StringCompare(opname, "Subtract"), 0) ThenBlock: { is_sub = 1 }
        disp = LoopHome.hit_disp
        IfCondition EqualTo(cls, 5) ThenBlock: {
            IfCondition EqualTo(is_sub, 1) ThenBlock: { Emit_HomeMove(34, 0) }
            IfCondition EqualTo(is_sub, 0) ThenBlock: { Emit_HomeMove(23, 0) }
            ReturnValue(1)
        }
        IfCondition EqualTo(cls, 7) ThenBlock: {
            IfCondition EqualTo(is_sub, 1) ThenBlock: { Emit_HomeMove(42, disp) }
            IfCondition EqualTo(is_sub, 0) ThenBlock: { Emit_HomeMove(41, disp) }
            ReturnValue(1)
        }
        IfCondition EqualTo(cls, 2) ThenBlock: {
            IfCondition EqualTo(is_sub, 1) ThenBlock: { Emit_HomeMove(22, disp) }
            IfCondition EqualTo(is_sub, 0) ThenBlock: { Emit_HomeMove(21, disp) }
            ReturnValue(1)
        }
        IfCondition EqualTo(cls, 4) ThenBlock: {
            IfCondition EqualTo(is_sub, 1) ThenBlock: { Emit_HomeMove(22, disp) }
            IfCondition EqualTo(is_sub, 0) ThenBlock: { Emit_HomeMove(21, disp) }
            ReturnValue(1)
        }
        ReturnValue(0)
    }
}

Function.Optimize_ClassOk {
    Input: cls: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(cls, 1) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(cls, 2) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(cls, 3) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(cls, 4) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

Function.Optimize_FltSrcOk {
    Input: cls: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(Optimize_ClassOk(cls), 1) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(cls, 6) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(cls, 7) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(cls, 8) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

Function.Optimize_TryFltUpdate {
    Input: target: Address
    Input: value: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(LoopHome.active, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_IsFltHome(target), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(value, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(value), AST.CALL) ThenBlock: { ReturnValue(0) }
        opk = Optimize_FltOpKind(AST_GetData1(value))
        legal = 0
        IfCondition EqualTo(opk, 1) ThenBlock: { legal = 1 }
        IfCondition EqualTo(opk, 2) ThenBlock: { legal = 1 }
        IfCondition EqualTo(opk, 3) ThenBlock: { legal = 1 }
        IfCondition EqualTo(legal, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetChildCount(value), 2) ThenBlock: { ReturnValue(0) }
        Optimize_OpClass(AST_GetChild(value, 0))
        c0 = LoopHome.hit_class
        d0 = LoopHome.hit_disp
        x0 = LoopHome.hit_xmm
        Optimize_OpClass(AST_GetChild(value, 1))
        c1 = LoopHome.hit_class
        d1 = LoopHome.hit_disp
        x1 = LoopHome.hit_xmm
        ts = Optimize_FltSlot(target)
        home_side = -1
        IfCondition EqualTo(c0, 1) ThenBlock: {
            IfCondition EqualTo(x0, ts) ThenBlock: { home_side = 0 }
        }
        IfCondition EqualTo(c1, 1) ThenBlock: {
            IfCondition EqualTo(x1, ts) ThenBlock: {
                IfCondition LessThan(home_side, 0) ThenBlock: { home_side = 1 }
            }
        }
        IfCondition LessThan(home_side, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(opk, 2) ThenBlock: {
            IfCondition NotEqual(home_side, 0) ThenBlock: { ReturnValue(0) }
        }
        oc = c1
        od = d1
        ox = x1
        IfCondition EqualTo(home_side, 1) ThenBlock: {
            oc = c0
            od = d0
            ox = x0
        }
        IfCondition EqualTo(oc, 3) ThenBlock: {
            IfCondition EqualTo(ts, 2) ThenBlock: {
                IfCondition EqualTo(opk, 1) ThenBlock: { Emit_HomeMove(26, 0) }
                IfCondition EqualTo(opk, 2) ThenBlock: { Emit_HomeMove(36, 0) }
                IfCondition EqualTo(opk, 3) ThenBlock: { Emit_HomeMove(35, 0) }
            }
            IfCondition GreaterThan(ts, 2) ThenBlock: {
                IfCondition EqualTo(opk, 1) ThenBlock: { X86_XmmRR(5, ts) }
                IfCondition EqualTo(opk, 2) ThenBlock: { X86_XmmRR(6, ts) }
                IfCondition EqualTo(opk, 3) ThenBlock: { X86_XmmRR(7, ts) }
            }
            LoopHome.hold_on = 0
            LoopHome.hold_name = 0
            ReturnValue(1)
        }
        mem = 0
        IfCondition EqualTo(oc, 2) ThenBlock: { mem = 1 }
        IfCondition EqualTo(oc, 4) ThenBlock: { mem = 1 }
        IfCondition EqualTo(mem, 1) ThenBlock: {
            IfCondition EqualTo(ts, 2) ThenBlock: {
                IfCondition EqualTo(opk, 1) ThenBlock: { Emit_HomeMove(18, od) }
                IfCondition EqualTo(opk, 2) ThenBlock: { Emit_HomeMove(19, od) }
                IfCondition EqualTo(opk, 3) ThenBlock: { Emit_HomeMove(20, od) }
            }
            IfCondition GreaterThan(ts, 2) ThenBlock: {
                IfCondition EqualTo(opk, 1) ThenBlock: { X86_EmitR13Mem(242, 65, 15, 88, ts, od) }
                IfCondition EqualTo(opk, 2) ThenBlock: { X86_EmitR13Mem(242, 65, 15, 92, ts, od) }
                IfCondition EqualTo(opk, 3) ThenBlock: { X86_EmitR13Mem(242, 65, 15, 89, ts, od) }
            }
            ReturnValue(1)
        }
        IfCondition EqualTo(oc, 1) ThenBlock: {
            opc = 88
            IfCondition EqualTo(opk, 2) ThenBlock: { opc = 92 }
            IfCondition EqualTo(opk, 3) ThenBlock: { opc = 89 }
            X86_XmmBin(opc, ts, ox)
            ReturnValue(1)
        }
        frame = 0
        IfCondition EqualTo(oc, 6) ThenBlock: { frame = 1 }
        IfCondition EqualTo(oc, 8) ThenBlock: { frame = 1 }
        IfCondition EqualTo(oc, 7) ThenBlock: { frame = 2 }
        IfCondition GreaterThan(frame, 0) ThenBlock: {
            opc = 88
            IfCondition EqualTo(opk, 2) ThenBlock: { opc = 92 }
            IfCondition EqualTo(opk, 3) ThenBlock: { opc = 89 }
            IfCondition EqualTo(frame, 1) ThenBlock: { X86_EmitRbpXmm(opc, ts, od) }
            IfCondition EqualTo(frame, 2) ThenBlock: { X86_EmitR15Xmm(opc, ts, od) }
            ReturnValue(1)
        }
        ReturnValue(0)
    }
}

Function.Optimize_TryFltTemp {
    Input: target: Address
    Input: value: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(LoopHome.active, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_IsIntHome(target), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_IsFltHome(target), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_IsAccHome(target), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(value, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(value), AST.CALL) ThenBlock: { ReturnValue(0) }
        opk = Optimize_FltOpKind(AST_GetData1(value))
        legal = 0
        IfCondition EqualTo(opk, 1) ThenBlock: { legal = 1 }
        IfCondition EqualTo(opk, 2) ThenBlock: { legal = 1 }
        IfCondition EqualTo(opk, 3) ThenBlock: { legal = 1 }
        IfCondition EqualTo(legal, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetChildCount(value), 2) ThenBlock: { ReturnValue(0) }
        hold_ok = Optimize_HoldOk(target)
        IfCondition EqualTo(hold_ok, 0) ThenBlock: { hold_ok = Optimize_HoldHere(target, value) }
        IfCondition EqualTo(hold_ok, 0) ThenBlock: { ReturnValue(0) }
        Optimize_OpClass(AST_GetChild(value, 0))
        c0 = LoopHome.hit_class
        d0 = LoopHome.hit_disp
        Optimize_OpClass(AST_GetChild(value, 1))
        c1 = LoopHome.hit_class
        d1 = LoopHome.hit_disp
        IfCondition EqualTo(Optimize_ClassOk(c0), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_ClassOk(c1), 0) ThenBlock: { ReturnValue(0) }
        uses_hold = 0
        IfCondition EqualTo(c0, 3) ThenBlock: { uses_hold = 1 }
        IfCondition EqualTo(c1, 3) ThenBlock: { uses_hold = 1 }
        IfCondition EqualTo(LoopHome.hold_on, 1) ThenBlock: {
            IfCondition EqualTo(uses_hold, 0) ThenBlock: { Optimize_FlushHold() }
        }
        IfCondition EqualTo(c1, 3) ThenBlock: { Emit_HomeMove(37, 0) }
        IfCondition EqualTo(c0, 1) ThenBlock: { Emit_HomeMove(7, 0) }
        IfCondition EqualTo(c0, 2) ThenBlock: { Emit_HomeMove(24, d0) }
        IfCondition EqualTo(c0, 4) ThenBlock: { Emit_HomeMove(24, d0) }
        IfCondition EqualTo(c1, 3) ThenBlock: {
            IfCondition EqualTo(opk, 1) ThenBlock: { Emit_HomeMove(38, 0) }
            IfCondition EqualTo(opk, 2) ThenBlock: { Emit_HomeMove(39, 0) }
            IfCondition EqualTo(opk, 3) ThenBlock: { Emit_HomeMove(40, 0) }
        }
        IfCondition EqualTo(c1, 1) ThenBlock: {
            IfCondition EqualTo(opk, 1) ThenBlock: { Emit_HomeMove(32, 0) }
            IfCondition EqualTo(opk, 2) ThenBlock: { Emit_HomeMove(33, 0) }
            IfCondition EqualTo(opk, 3) ThenBlock: { Emit_HomeMove(28, 0) }
        }
        mem = 0
        IfCondition EqualTo(c1, 2) ThenBlock: { mem = 1 }
        IfCondition EqualTo(c1, 4) ThenBlock: { mem = 1 }
        IfCondition EqualTo(mem, 1) ThenBlock: {
            IfCondition EqualTo(opk, 1) ThenBlock: { Emit_HomeMove(27, d1) }
            IfCondition EqualTo(opk, 2) ThenBlock: { Emit_HomeMove(31, d1) }
            IfCondition EqualTo(opk, 3) ThenBlock: { Emit_HomeMove(25, d1) }
        }
        LoopHome.hold_on = 1
        LoopHome.hold_name = target
        ReturnValue(1)
    }
}

// One SSE op into a float home. opcode 16 loads; 88/92/89 are add/sub/mul.
// Class 3 reads the held value in xmm0 and does not flush it.

Function.Optimize_FltHomeOp {
    Input: slot: Integer
    Input: cls: Integer
    Input: disp: Integer
    Input: xmm: Integer
    Input: opcode: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(cls, 1) ThenBlock: {
            X86_XmmBin(opcode, slot, xmm)
            ReturnValue(1)
        }
        mem = 0
        IfCondition EqualTo(cls, 2) ThenBlock: { mem = 1 }
        IfCondition EqualTo(cls, 4) ThenBlock: { mem = 1 }
        IfCondition EqualTo(mem, 1) ThenBlock: {
            X86_EmitR13Mem(242, 65, 15, opcode, slot, disp)
            ReturnValue(1)
        }
        IfCondition EqualTo(cls, 3) ThenBlock: {
            IfCondition EqualTo(opcode, 16) ThenBlock: { X86_XmmRR(4, slot) }
            IfCondition EqualTo(opcode, 88) ThenBlock: { X86_XmmRR(5, slot) }
            IfCondition EqualTo(opcode, 92) ThenBlock: { X86_XmmRR(6, slot) }
            IfCondition EqualTo(opcode, 89) ThenBlock: { X86_XmmRR(7, slot) }
            ReturnValue(1)
        }
        IfCondition EqualTo(cls, 6) ThenBlock: {
            X86_EmitRbpXmm(opcode, slot, disp)
            ReturnValue(1)
        }
        IfCondition EqualTo(cls, 8) ThenBlock: {
            X86_EmitRbpXmm(opcode, slot, disp)
            ReturnValue(1)
        }
        IfCondition EqualTo(cls, 7) ThenBlock: {
            X86_EmitR15Xmm(opcode, slot, disp)
            ReturnValue(1)
        }
        ReturnValue(0)
    }
}

// Fresh float into a home. The destination is not an operand; in-place
// updates stay in TryFltUpdate. A load into the destination would destroy
// a left-hand use, and a subtract is not commutative. The home xmm is the
// value, so the result is not moved through rax.

Function.Optimize_TryFltSet {
    Input: target: Address
    Input: value: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(LoopHome.active, 0) ThenBlock: { ReturnValue(0) }
        slot = Optimize_FltSlot(target)
        IfCondition LessThan(slot, 2) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(value, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(value), AST.CALL) ThenBlock: { ReturnValue(0) }
        opk = Optimize_FltOpKind(AST_GetData1(value))
        legal = 0
        IfCondition EqualTo(opk, 1) ThenBlock: { legal = 1 }
        IfCondition EqualTo(opk, 2) ThenBlock: { legal = 1 }
        IfCondition EqualTo(opk, 3) ThenBlock: { legal = 1 }
        IfCondition EqualTo(legal, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetChildCount(value), 2) ThenBlock: { ReturnValue(0) }
        Optimize_OpClass(AST_GetChild(value, 0))
        c0 = LoopHome.hit_class
        d0 = LoopHome.hit_disp
        x0 = LoopHome.hit_xmm
        Optimize_OpClass(AST_GetChild(value, 1))
        c1 = LoopHome.hit_class
        d1 = LoopHome.hit_disp
        x1 = LoopHome.hit_xmm
        IfCondition EqualTo(Optimize_FltSrcOk(c0), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_FltSrcOk(c1), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(c0, 1) ThenBlock: {
            IfCondition EqualTo(x0, slot) ThenBlock: { ReturnValue(0) }
        }
        IfCondition EqualTo(c1, 1) ThenBlock: {
            IfCondition EqualTo(x1, slot) ThenBlock: { ReturnValue(0) }
        }
        IfCondition EqualTo(Optimize_FltHomeOp(slot, c0, d0, x0, 16), 0) ThenBlock: { ReturnValue(0) }
        opc = 88
        IfCondition EqualTo(opk, 2) ThenBlock: { opc = 92 }
        IfCondition EqualTo(opk, 3) ThenBlock: { opc = 89 }
        IfCondition EqualTo(Optimize_FltHomeOp(slot, c1, d1, x1, opc), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(LoopHome.hold_on, 1) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(target, LoopHome.hold_name), 1) ThenBlock: {
                LoopHome.hold_on = 0
                LoopHome.hold_name = 0
            }
        }
        ReturnValue(1)
    }
}

Function.Optimize_TryFoldAssign {
    Input: target: Address
    Input: value: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(LoopHome.active, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_TryAliasAssign(target, value), 1) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(Optimize_TryAccAssign(target, value), 1) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(Optimize_TryFltUpdate(target, value), 1) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(Optimize_TryFltSet(target, value), 1) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(Optimize_TryFltConst(target, value), 1) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(Optimize_TryFltTemp(target, value), 1) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

Function.Optimize_ArmHold {
    Input: target: Address
    Input: value: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(LoopHome.active, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_IsIntHome(target), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_IsFltHome(target), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_IsAccHome(target), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(value, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(value), AST.CALL) ThenBlock: { ReturnValue(0) }
        opk = Optimize_FltOpKind(AST_GetData1(value))
        legal = 0
        IfCondition EqualTo(opk, 1) ThenBlock: { legal = 1 }
        IfCondition EqualTo(opk, 2) ThenBlock: { legal = 1 }
        IfCondition EqualTo(opk, 3) ThenBlock: { legal = 1 }
        IfCondition EqualTo(legal, 0) ThenBlock: { ReturnValue(0) }
        hold_ok = Optimize_HoldOk(target)
        IfCondition EqualTo(hold_ok, 0) ThenBlock: { hold_ok = Optimize_HoldHere(target, value) }
        IfCondition EqualTo(hold_ok, 0) ThenBlock: { ReturnValue(0) }
        LoopHome.hold_on = 1
        LoopHome.hold_name = target
        ReturnValue(1)
    }
}

Function.Optimize_SetDebug {
    Input: enabled: Integer
    Body: {
        OptState.debug = enabled
    }
}

// =============================================================================
// CALL SPLICE
// A direct call whose arguments are names or numbers is replaced, in a copy
// of a small ordinary Function, by those arguments. Two levels: a spliced
// copy may itself be spliced once, and calls inside that second copy stay
// calls. The callable function stays in the binary. A body that contains
// InlineAsm stays a call: the text is the argument registers.
// Run from CompileFunc_Function before locals are counted, so the frame and
// the loop-register pass see the spliced statements.
// =============================================================================

Function.Optimize_InlineCap {
    Output: Integer
    Body: {
        ReturnValue(32)
    }
}

Function.Optimize_InlineBuiltin {
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(Optimize_HomeCallOk(name), 1) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "CallIndirect"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "AddressOf"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "RunTask"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "ReturnValue"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "Allocate"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "Deallocate"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "StoreValue"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "GetByte"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "SetByte"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "MemoryCopy"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "MemorySet"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "MemCompare"), 0) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

Function.Optimize_InlineFail {
    Input: params: Address
    Input: renames: Address
    Input: stmts: Address
    Output: Integer
    Body: {
        IfCondition NotEqual(params, 0) ThenBlock: { Array.Destroy(params) }
        IfCondition NotEqual(renames, 0) ThenBlock: { SHash.Destroy(renames) }
        IfCondition NotEqual(stmts, 0) ThenBlock: { Array.Destroy(stmts) }
        ReturnValue(0)
    }
}

Function.Optimize_InlineFresh {
    Input: avoid: Address
    Output: Address
    Body: {
        guard = 0
        name = 0
        WhileLoop LessThan(guard, 10000) {
            seq = OptState.inline_seq
            OptState.inline_seq = Add(seq, 1)
            name = StringConcat("_inl", NumberToString(seq))
            hit = 0
            IfCondition NotEqual(avoid, 0) ThenBlock: {
                IfCondition EqualTo(SHash.Exists(avoid, name), 1) ThenBlock: { hit = 1 }
            }
            IfCondition EqualTo(hit, 0) ThenBlock: {
                IfCondition NotEqual(avoid, 0) ThenBlock: {
                    SHash.Insert(avoid, name, 1)
                }
                ReturnValue(name)
            }
            guard = Add(guard, 1)
        }
        ReturnValue(name)
    }
}

Function.Optimize_InlineNote {
    Input: names: Address
    Input: name: Address
    Body: {
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(SHash.Exists(names, name), 0) ThenBlock: {
            SHash.Insert(names, name, 1)
        }
        ReturnValue(0)
    }
}

Function.Optimize_InlineCollect {
    Input: node: Address
    Input: names: Address
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(names, 0) ThenBlock: { ReturnValue(0) }
        t = AST_GetType(node)
        IfCondition EqualTo(t, AST.IDENTIFIER) ThenBlock: {
            Optimize_InlineNote(names, AST_GetData1(node))
        }
        IfCondition EqualTo(t, AST.ASSIGNMENT) ThenBlock: {
            Optimize_InlineNote(names, AST_GetData1(node))
        }
        IfCondition EqualTo(t, AST.INDEX_ASSIGN) ThenBlock: {
            Optimize_InlineNote(names, AST_GetData1(node))
        }
        IfCondition EqualTo(t, AST.PARAMETER) ThenBlock: {
            Optimize_InlineNote(names, AST_GetData1(node))
        }
        count = AST_GetChildCount(node)
        i = 0
        WhileLoop LessThan(i, count) {
            Optimize_InlineCollect(AST_GetChild(node, i), names)
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

Function.Optimize_InlineMapped {
    Input: renames: Address
    Input: name: Address
    Output: Address
    Body: {
        IfCondition EqualTo(renames, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }
        hit = SHash.LookupAddr(renames, name)
        IfCondition EqualTo(hit, Collections.XNULL) ThenBlock: { ReturnValue(0) }
        ReturnValue(hit)
    }
}

Function.Optimize_InlineClone {
    Input: node: Address
    Input: renames: Address
    Output: Address
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        t = AST_GetType(node)
        out = AST_Create(t)
        IfCondition EqualTo(out, 0) ThenBlock: { ReturnValue(0) }
        AST_SetLine(out, AST_GetLine(node))
        AST_SetCol(out, AST_GetCol(node))
        d1 = AST_GetData1(node)
        rename_d1 = 0
        IfCondition EqualTo(t, AST.IDENTIFIER) ThenBlock: { rename_d1 = 1 }
        IfCondition EqualTo(t, AST.ASSIGNMENT) ThenBlock: { rename_d1 = 1 }
        IfCondition EqualTo(t, AST.INDEX_ASSIGN) ThenBlock: { rename_d1 = 1 }
        IfCondition EqualTo(rename_d1, 1) ThenBlock: {
            IfCondition EqualTo(Compile_ContainsDot(d1), 0) ThenBlock: {
                mapped = Optimize_InlineMapped(renames, d1)
                IfCondition NotEqual(mapped, 0) ThenBlock: { d1 = mapped }
            }
        }
        AST_SetData1(out, d1)
        AST_SetData2(out, AST_GetData2(node))
        AST_SetData3(out, AST_GetData3(node))
        AST_SetData4(out, AST_GetData4(node))
        count = AST_GetChildCount(node)
        i = 0
        WhileLoop LessThan(i, count) {
            ch = Optimize_InlineClone(AST_GetChild(node, i), renames)
            IfCondition NotEqual(ch, 0) ThenBlock: {
                AST_AddChild(out, ch)
            }
            i = Add(i, 1)
        }
        ReturnValue(out)
    }
}

Function.Optimize_InlineChild {
    Input: node: Address
    Input: index: Integer
    Output: Address
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(index, 0) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterEqual(index, AST_GetChildCount(node)) ThenBlock: { ReturnValue(0) }
        ReturnValue(AST_GetChild(node, index))
    }
}

Function.Optimize_InlineCountAny {
    Input: node: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        n = 0
        count = AST_GetChildCount(node)
        i = 0
        WhileLoop LessThan(i, count) {
            n = Add(n, Optimize_InlineCount(AST_GetChild(node, i)))
            i = Add(i, 1)
        }
        ReturnValue(n)
    }
}

Function.Optimize_InlineCountBlock {
    Input: node: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        n = 0
        count = AST_GetChildCount(node)
        i = 0
        WhileLoop LessThan(i, count) {
            c = Optimize_InlineCount(AST_GetChild(node, i))
            IfCondition EqualTo(c, 0) ThenBlock: { n = Add(n, 1) }
            IfCondition GreaterThan(c, 0) ThenBlock: { n = Add(n, c) }
            i = Add(i, 1)
        }
        ReturnValue(n)
    }
}

Function.Optimize_InlineCountTail {
    Input: node: Address
    Output: Integer
    Body: {
        n = 0
        count = AST_GetChildCount(node)
        i = 1
        WhileLoop LessThan(i, count) {
            n = Add(n, Optimize_InlineCount(AST_GetChild(node, i)))
            i = Add(i, 1)
        }
        ReturnValue(n)
    }
}

Function.Optimize_InlineCount {
    Input: node: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        t = AST_GetType(node)
        IfCondition EqualTo(t, AST.BLOCK) ThenBlock: { ReturnValue(Optimize_InlineCountBlock(node)) }
        IfCondition EqualTo(t, AST.BODY) ThenBlock: { ReturnValue(Optimize_InlineCountBlock(node)) }
        IfCondition EqualTo(t, AST.CASE) ThenBlock: { ReturnValue(Optimize_InlineCountAny(node)) }
        IfCondition EqualTo(t, AST.DEFAULT) ThenBlock: { ReturnValue(Optimize_InlineCountAny(node)) }
        IfCondition EqualTo(t, AST.CATCH) ThenBlock: { ReturnValue(Optimize_InlineCountAny(node)) }
        IfCondition EqualTo(t, AST.FINALLY) ThenBlock: { ReturnValue(Optimize_InlineCountAny(node)) }

        stmt = 0
        IfCondition EqualTo(t, AST.ASSIGNMENT) ThenBlock: { stmt = 1 }
        IfCondition EqualTo(t, AST.RETURN) ThenBlock: { stmt = 1 }
        IfCondition EqualTo(t, AST.CALL) ThenBlock: { stmt = 1 }
        IfCondition EqualTo(t, AST.IF) ThenBlock: { stmt = 1 }
        IfCondition EqualTo(t, AST.FORK) ThenBlock: { stmt = 1 }
        IfCondition EqualTo(t, AST.WHILE) ThenBlock: { stmt = 1 }
        IfCondition EqualTo(t, AST.UNTIL) ThenBlock: { stmt = 1 }
        IfCondition EqualTo(t, AST.SWITCH) ThenBlock: { stmt = 1 }
        IfCondition EqualTo(t, AST.BRANCH) ThenBlock: { stmt = 1 }
        IfCondition EqualTo(t, AST.FOR_EVERY) ThenBlock: { stmt = 1 }
        IfCondition EqualTo(t, AST.TRY) ThenBlock: { stmt = 1 }
        IfCondition EqualTo(t, AST.EXIT_LOOP) ThenBlock: { stmt = 1 }
        IfCondition EqualTo(t, AST.CONTINUE_LOOP) ThenBlock: { stmt = 1 }
        IfCondition EqualTo(stmt, 0) ThenBlock: { ReturnValue(0) }

        n = 1
        IfCondition EqualTo(t, AST.IF) ThenBlock: {
            n = Add(n, Optimize_InlineCount(Optimize_InlineChild(node, 1)))
            n = Add(n, Optimize_InlineCount(Optimize_InlineChild(node, 2)))
            ReturnValue(n)
        }
        IfCondition EqualTo(t, AST.FORK) ThenBlock: {
            n = Add(n, Optimize_InlineCount(Optimize_InlineChild(node, 1)))
            n = Add(n, Optimize_InlineCount(Optimize_InlineChild(node, 2)))
            ReturnValue(n)
        }
        IfCondition EqualTo(t, AST.WHILE) ThenBlock: {
            n = Add(n, Optimize_InlineCount(Optimize_InlineChild(node, 1)))
            ReturnValue(n)
        }
        IfCondition EqualTo(t, AST.UNTIL) ThenBlock: {
            n = Add(n, Optimize_InlineCount(Optimize_InlineChild(node, 1)))
            ReturnValue(n)
        }
        IfCondition EqualTo(t, AST.FOR_EVERY) ThenBlock: {
            n = Add(n, Optimize_InlineCount(Optimize_InlineChild(node, 1)))
            ReturnValue(n)
        }
        IfCondition EqualTo(t, AST.SWITCH) ThenBlock: {
            n = Add(n, Optimize_InlineCountTail(node))
            ReturnValue(n)
        }
        IfCondition EqualTo(t, AST.BRANCH) ThenBlock: {
            n = Add(n, Optimize_InlineCountTail(node))
            ReturnValue(n)
        }
        IfCondition EqualTo(t, AST.TRY) ThenBlock: {
            n = Add(n, Optimize_InlineCountAny(node))
            ReturnValue(n)
        }
        ReturnValue(n)
    }
}

Function.Optimize_InlineForbid {
    Input: node: Address
    Input: self_name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        t = AST_GetType(node)
        bad = 0
        IfCondition EqualTo(t, AST.WHILE) ThenBlock: { bad = 1 }
        IfCondition EqualTo(t, AST.FOR_EVERY) ThenBlock: { bad = 1 }
        IfCondition EqualTo(t, AST.UNTIL) ThenBlock: { bad = 1 }
        IfCondition EqualTo(t, AST.TRY) ThenBlock: { bad = 1 }
        IfCondition EqualTo(t, AST.EVERY_INTERVAL) ThenBlock: { bad = 1 }
        IfCondition EqualTo(t, AST.EXIT_LOOP) ThenBlock: { bad = 1 }
        IfCondition EqualTo(t, AST.CONTINUE_LOOP) ThenBlock: { bad = 1 }
        // Asm text reads edi/esi. Renaming the parameters does not rewrite it,
        // so a spliced CRC32Step hashes the pointer instead of the bytes.
        IfCondition EqualTo(t, AST.INLINEASM) ThenBlock: { bad = 1 }
        IfCondition EqualTo(t, AST.CALL) ThenBlock: {
            cn = AST_GetData1(node)
            IfCondition NotEqual(cn, 0) ThenBlock: {
                IfCondition EqualTo(Optimize_NameEq(cn, self_name), 1) ThenBlock: { bad = 1 }
                IfCondition EqualTo(StringCompare(cn, "CallIndirect"), 0) ThenBlock: { bad = 1 }
                IfCondition EqualTo(StringCompare(cn, "AddressOf"), 0) ThenBlock: { bad = 1 }
            }
        }
        IfCondition EqualTo(bad, 1) ThenBlock: { ReturnValue(1) }
        count = AST_GetChildCount(node)
        i = 0
        WhileLoop LessThan(i, count) {
            IfCondition EqualTo(Optimize_InlineForbid(AST_GetChild(node, i), self_name), 1) ThenBlock: {
                ReturnValue(1)
            }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

Function.Optimize_InlineReturnCount {
    Input: node: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        n = 0
        IfCondition EqualTo(AST_GetType(node), AST.RETURN) ThenBlock: { n = 1 }
        count = AST_GetChildCount(node)
        i = 0
        WhileLoop LessThan(i, count) {
            n = Add(n, Optimize_InlineReturnCount(AST_GetChild(node, i)))
            i = Add(i, 1)
        }
        ReturnValue(n)
    }
}

Function.Optimize_InlineIsParam {
    Input: func_node: Address
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }
        count = AST_GetChildCount(func_node)
        i = 0
        WhileLoop LessThan(i, count) {
            ch = AST_GetChild(func_node, i)
            IfCondition EqualTo(AST_GetType(ch), AST.PARAMETER) ThenBlock: {
                IfCondition EqualTo(Optimize_NameEq(AST_GetData1(ch), name), 1) ThenBlock: {
                    ReturnValue(1)
                }
            }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

Function.Optimize_InlineParams {
    Input: func_node: Address
    Output: Address
    Body: {
        params = Array.Create(8)
        count = AST_GetChildCount(func_node)
        i = 0
        WhileLoop LessThan(i, count) {
            ch = AST_GetChild(func_node, i)
            IfCondition EqualTo(AST_GetType(ch), AST.PARAMETER) ThenBlock: {
                Array.Push(params, AST_GetData1(ch))
            }
            i = Add(i, 1)
        }
        ReturnValue(params)
    }
}

Function.Optimize_InlineBody {
    Input: func_node: Address
    Output: Address
    Body: {
        body = 0
        count = AST_GetChildCount(func_node)
        i = 0
        WhileLoop LessThan(i, count) {
            ch = AST_GetChild(func_node, i)
            IfCondition EqualTo(AST_GetType(ch), AST.BLOCK) ThenBlock: { body = ch }
            i = Add(i, 1)
        }
        ReturnValue(body)
    }
}

Function.Optimize_InlineArgsOk {
    Input: call: Address
    Input: params: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(params, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetChildCount(call), Array.Size(params)) ThenBlock: {
            ReturnValue(0)
        }
        i = 0
        n = Array.Size(params)
        WhileLoop LessThan(i, n) {
            arg = AST_GetChild(call, i)
            IfCondition EqualTo(arg, 0) ThenBlock: { ReturnValue(0) }
            t = AST_GetType(arg)
            ok = 0
            IfCondition EqualTo(t, AST.IDENTIFIER) ThenBlock: { ok = 1 }
            IfCondition EqualTo(t, AST.NUMBER) ThenBlock: { ok = 1 }
            IfCondition EqualTo(ok, 0) ThenBlock: { ReturnValue(0) }
            IfCondition EqualTo(Array.Get(params, i), 0) ThenBlock: { ReturnValue(0) }
            i = Add(i, 1)
        }
        ReturnValue(1)
    }
}

Function.Optimize_InlineEligible {
    Input: func_node: Address
    Input: body: Address
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(func_node, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(body, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(func_node), AST.FUNCTION) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(body), AST.BLOCK) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_InlineForbid(body, name), 1) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterThan(Optimize_InlineCount(body), Optimize_InlineCap()) ThenBlock: { ReturnValue(0) }
        bc = AST_GetChildCount(body)
        IfCondition LessThan(bc, 1) ThenBlock: { ReturnValue(0) }
        last = AST_GetChild(body, Subtract(bc, 1))
        IfCondition NotEqual(AST_GetType(last), AST.RETURN) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(Optimize_InlineReturnCount(body), 1) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(AST_GetChildCount(last), 1) ThenBlock: { ReturnValue(0) }
        rv = AST_GetChild(last, 0)
        IfCondition NotEqual(AST_GetType(rv), AST.IDENTIFIER) ThenBlock: { ReturnValue(0) }
        rname = AST_GetData1(rv)
        IfCondition EqualTo(rname, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Compile_ContainsDot(rname), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_InlineIsParam(func_node, rname), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_AssignNested(body, rname), 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(1)
    }
}

Function.Optimize_InlineCollideName {
    Input: name: Address
    Input: renames: Address
    Input: caller_names: Address
    Body: {
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }
        // Pool fields (OptState.inline_seq) are one dotted identifier and are
        // already in scope. Freshening them turns the read before the write
        // into a local that has not been stored yet.
        IfCondition EqualTo(Compile_ContainsDot(name), 1) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(Optimize_InlineMapped(renames, name), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(SHash.Exists(caller_names, name), 0) ThenBlock: { ReturnValue(0) }
        fresh = Optimize_InlineFresh(caller_names)
        SHash.InsertAddr(renames, name, fresh)
        ReturnValue(0)
    }
}

Function.Optimize_InlineCollide {
    Input: node: Address
    Input: renames: Address
    Input: caller_names: Address
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        t = AST_GetType(node)
        IfCondition EqualTo(t, AST.ASSIGNMENT) ThenBlock: {
            Optimize_InlineCollideName(AST_GetData1(node), renames, caller_names)
        }
        IfCondition EqualTo(t, AST.INDEX_ASSIGN) ThenBlock: {
            Optimize_InlineCollideName(AST_GetData1(node), renames, caller_names)
        }
        count = AST_GetChildCount(node)
        i = 0
        WhileLoop LessThan(i, count) {
            Optimize_InlineCollide(AST_GetChild(node, i), renames, caller_names)
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

Function.Optimize_InlineSplice {
    Input: block: Address
    Input: index: Integer
    Input: lhs: Address
    Input: call: Address
    Input: self_name: Address
    Input: caller_names: Address
    Output: Integer
    Body: {
        cname = AST_GetData1(call)
        IfCondition EqualTo(cname, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(lhs, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_NameEq(cname, self_name), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_InlineBuiltin(cname), 1) ThenBlock: { ReturnValue(0) }
        func_node = SHash.LookupAddr(OptState.func_nodes, cname)
        IfCondition EqualTo(func_node, Collections.XNULL) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(func_node, 0) ThenBlock: { ReturnValue(0) }

        src_body = SHash.LookupAddr(OptState.func_snaps, cname)
        IfCondition EqualTo(src_body, Collections.XNULL) ThenBlock: {
            src_body = Optimize_InlineBody(func_node)
        }
        IfCondition EqualTo(src_body, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(src_body, Collections.XNULL) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_InlineEligible(func_node, src_body, cname), 0) ThenBlock: {
            ReturnValue(0)
        }

        params = Optimize_InlineParams(func_node)
        IfCondition EqualTo(Optimize_InlineArgsOk(call, params), 0) ThenBlock: {
            ReturnValue(Optimize_InlineFail(params, 0, 0))
        }

        renames = SHash.Create(64)
        i = 0
        pc = Array.Size(params)
        WhileLoop LessThan(i, pc) {
            pname = Array.Get(params, i)
            arg = AST_GetChild(call, i)
            target = 0
            at = AST_GetType(arg)
            IfCondition EqualTo(at, AST.NUMBER) ThenBlock: {
                target = Optimize_InlineFresh(caller_names)
            }
            IfCondition EqualTo(at, AST.IDENTIFIER) ThenBlock: {
                written = Optimize_AssignNested(src_body, pname)
                IfCondition EqualTo(written, 1) ThenBlock: {
                    target = Optimize_InlineFresh(caller_names)
                }
                IfCondition EqualTo(written, 0) ThenBlock: {
                    target = AST_GetData1(arg)
                }
            }
            IfCondition EqualTo(target, 0) ThenBlock: {
                ReturnValue(Optimize_InlineFail(params, renames, 0))
            }
            SHash.InsertAddr(renames, pname, target)
            i = Add(i, 1)
        }

        last = AST_GetChild(src_body, Subtract(AST_GetChildCount(src_body), 1))
        rname = AST_GetData1(AST_GetChild(last, 0))
        IfCondition NotEqual(Optimize_InlineMapped(renames, rname), 0) ThenBlock: {
            ReturnValue(Optimize_InlineFail(params, renames, 0))
        }
        SHash.InsertAddr(renames, rname, lhs)
        Optimize_InlineCollide(src_body, renames, caller_names)

        stmts = Array.Create(16)
        i = 0
        WhileLoop LessThan(i, pc) {
            pname = Array.Get(params, i)
            arg = AST_GetChild(call, i)
            mapped = Optimize_InlineMapped(renames, pname)
            need = 0
            IfCondition EqualTo(AST_GetType(arg), AST.NUMBER) ThenBlock: { need = 1 }
            IfCondition EqualTo(AST_GetType(arg), AST.IDENTIFIER) ThenBlock: {
                IfCondition EqualTo(Optimize_NameEq(mapped, AST_GetData1(arg)), 0) ThenBlock: {
                    need = 1
                }
            }
            IfCondition EqualTo(need, 1) ThenBlock: {
                expr = Optimize_InlineClone(arg, 0)
                IfCondition NotEqual(expr, 0) ThenBlock: {
                    asg = AST_MakeAssignment(mapped, expr)
                    AST_SetLine(asg, AST_GetLine(call))
                    AST_SetCol(asg, AST_GetCol(call))
                    Array.Push(stmts, asg)
                }
            }
            i = Add(i, 1)
        }

        bc = AST_GetChildCount(src_body)
        j = 0
        last_i = Subtract(bc, 1)
        WhileLoop LessThan(j, last_i) {
            cloned = Optimize_InlineClone(AST_GetChild(src_body, j), renames)
            IfCondition NotEqual(cloned, 0) ThenBlock: {
                Array.Push(stmts, cloned)
            }
            j = Add(j, 1)
        }

        n = Array.Size(stmts)
        IfCondition LessThan(n, 1) ThenBlock: {
            ReturnValue(Optimize_InlineFail(params, renames, stmts))
        }
        children = AST_GetChildren(block)
        IfCondition EqualTo(children, 0) ThenBlock: {
            ReturnValue(Optimize_InlineFail(params, renames, stmts))
        }
        Array.Delete(children, index)
        k = 0
        WhileLoop LessThan(k, n) {
            Array.Insert(children, Add(index, k), Array.Get(stmts, k))
            k = Add(k, 1)
        }
        k = 0
        WhileLoop LessThan(k, n) {
            Optimize_InlineCollect(Array.Get(stmts, k), caller_names)
            k = Add(k, 1)
        }
        Array.Destroy(params)
        SHash.Destroy(renames)
        Array.Destroy(stmts)
        ReturnValue(n)
    }
}

Function.Optimize_InlineTry {
    Input: block: Address
    Input: index: Integer
    Input: stmt: Address
    Input: self_name: Address
    Input: caller_names: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(stmt, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(stmt), AST.ASSIGNMENT) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetData2(stmt), 0) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(AST_GetChildCount(stmt), 1) ThenBlock: { ReturnValue(0) }
        value = AST_GetChild(stmt, 0)
        IfCondition NotEqual(AST_GetType(value), AST.CALL) ThenBlock: { ReturnValue(0) }
        lhs = AST_GetData1(stmt)
        ReturnValue(Optimize_InlineSplice(block, index, lhs, value, self_name, caller_names))
    }
}

Function.Optimize_InlineWalkInside {
    Input: stmt: Address
    Input: self_name: Address
    Input: caller_names: Address
    Input: depth: Integer
    Body: {
        IfCondition EqualTo(stmt, 0) ThenBlock: { ReturnValue(0) }
        t = AST_GetType(stmt)
        IfCondition EqualTo(t, AST.BLOCK) ThenBlock: {
            Optimize_InlineWalkBlock(stmt, self_name, caller_names, depth)
            ReturnValue(0)
        }
        IfCondition EqualTo(t, AST.BODY) ThenBlock: {
            Optimize_InlineWalkBlock(stmt, self_name, caller_names, depth)
            ReturnValue(0)
        }
        nest = 0
        IfCondition EqualTo(t, AST.IF) ThenBlock: { nest = 1 }
        IfCondition EqualTo(t, AST.FORK) ThenBlock: { nest = 1 }
        IfCondition EqualTo(t, AST.WHILE) ThenBlock: { nest = 1 }
        IfCondition EqualTo(t, AST.UNTIL) ThenBlock: { nest = 1 }
        IfCondition EqualTo(t, AST.FOR_EVERY) ThenBlock: { nest = 1 }
        IfCondition EqualTo(t, AST.TRY) ThenBlock: { nest = 1 }
        IfCondition EqualTo(t, AST.SWITCH) ThenBlock: { nest = 1 }
        IfCondition EqualTo(t, AST.BRANCH) ThenBlock: { nest = 1 }
        IfCondition EqualTo(t, AST.CASE) ThenBlock: { nest = 1 }
        IfCondition EqualTo(t, AST.DEFAULT) ThenBlock: { nest = 1 }
        IfCondition EqualTo(t, AST.CATCH) ThenBlock: { nest = 1 }
        IfCondition EqualTo(t, AST.FINALLY) ThenBlock: { nest = 1 }
        IfCondition EqualTo(nest, 0) ThenBlock: { ReturnValue(0) }
        count = AST_GetChildCount(stmt)
        i = 0
        WhileLoop LessThan(i, count) {
            Optimize_InlineWalkInside(AST_GetChild(stmt, i), self_name, caller_names, depth)
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

Function.Optimize_InlineWalkSpan {
    Input: block: Address
    Input: begin_at: Integer
    Input: end_at: Integer
    Input: self_name: Address
    Input: caller_names: Address
    Input: depth: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(block, 0) ThenBlock: { ReturnValue(end_at) }
        i = begin_at
        limit = end_at
        WhileLoop LessThan(i, limit) {
            stmt = AST_GetChild(block, i)
            n = Optimize_InlineTry(block, i, stmt, self_name, caller_names)
            IfCondition GreaterThan(n, 0) ThenBlock: {
                grown = n
                // depth 0 may splice the calls it just inserted. depth 1
                // leaves those calls in place, so a third copy never appears.
                IfCondition LessThan(depth, 1) ThenBlock: {
                    span_end = Optimize_InlineWalkSpan(block, i, Add(i, n), self_name, caller_names, 1)
                    grown = Subtract(span_end, i)
                }
                limit = Add(limit, Subtract(grown, 1))
                i = Add(i, grown)
            }
            IfCondition EqualTo(n, 0) ThenBlock: {
                Optimize_InlineWalkInside(stmt, self_name, caller_names, depth)
                i = Add(i, 1)
            }
        }
        ReturnValue(limit)
    }
}

Function.Optimize_InlineWalkBlock {
    Input: block: Address
    Input: self_name: Address
    Input: caller_names: Address
    Input: depth: Integer
    Body: {
        IfCondition EqualTo(block, 0) ThenBlock: { ReturnValue(0) }
        Optimize_InlineWalkSpan(block, 0, AST_GetChildCount(block), self_name, caller_names, depth)
        ReturnValue(0)
    }
}

Function.Optimize_InlineIndex {
    Input: node: Address
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(AST_GetType(node), AST.FUNCTION) ThenBlock: {
            name = AST_GetData1(node)
            IfCondition NotEqual(name, 0) ThenBlock: {
                existing = SHash.LookupAddr(OptState.func_nodes, name)
                IfCondition EqualTo(existing, Collections.XNULL) ThenBlock: {
                    SHash.InsertAddr(OptState.func_nodes, name, node)
                }
            }
        }
        count = AST_GetChildCount(node)
        i = 0
        WhileLoop LessThan(i, count) {
            Optimize_InlineIndex(AST_GetChild(node, i))
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

Function.Optimize_InlineInit {
    Body: {
        IfCondition EqualTo(OptState.inline_ready, 1) ThenBlock: {
            IfCondition EqualTo(OptState.inline_ast, Compile.ast) ThenBlock: {
                ReturnValue(0)
            }
        }
        IfCondition NotEqual(OptState.func_nodes, 0) ThenBlock: {
            SHash.Destroy(OptState.func_nodes)
            OptState.func_nodes = 0
        }
        IfCondition NotEqual(OptState.func_snaps, 0) ThenBlock: {
            SHash.Destroy(OptState.func_snaps)
            OptState.func_snaps = 0
        }
        OptState.func_nodes = SHash.Create(4096)
        OptState.func_snaps = SHash.Create(1024)
        OptState.inline_seq = 0
        Optimize_InlineIndex(Compile.ast)
        Optimize_FoldInit()
        OptState.inline_ast = Compile.ast
        OptState.inline_ready = 1
        ReturnValue(0)
    }
}

Function.Optimize_InlinePrepare {
    Input: func_node: Address
    Input: body: Address
    Body: {
        IfCondition EqualTo(func_node, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(body, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(func_node), AST.FUNCTION) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Compile.ast, 0) ThenBlock: { ReturnValue(0) }
        name = AST_GetData1(func_node)
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }
        Optimize_InlineInit()
        IfCondition EqualTo(Optimize_InlineEligible(func_node, body, name), 1) ThenBlock: {
            snap = Optimize_InlineClone(body, 0)
            IfCondition NotEqual(snap, 0) ThenBlock: {
                SHash.InsertAddr(OptState.func_snaps, name, snap)
            }
        }
        names = SHash.Create(1024)
        Optimize_InlineCollect(func_node, names)
        Optimize_InlineWalkBlock(body, name, names, 0)
        SHash.Destroy(names)
        Optimize_FoldFunction(body)
        ReturnValue(0)
    }
}

// =============================================================================
// JOIN CONSTANT FOLD
// One value for a name: every straight-line write agrees, or every arm of a
// Branch or If leaves a constant. Pure arithmetic that reads those values is
// copied into the arms and folded. A second write, a loop write, or any
// non-pure call poisons the name. Integer math stays integer. Float_FromInt
// and the float ops use the compiler's own operators, so the bits match a
// runtime evaluation on this machine.
// =============================================================================

Function.Optimize_FoldFree {
    Input: arr: Address
    Body: {
        IfCondition NotEqual(arr, 0) ThenBlock: {
            Array.Destroy(arr)
        }
        ReturnValue(0)
    }
}

Function.Optimize_FoldFree6 {
    Input: a: Address
    Input: b: Address
    Input: c: Address
    Input: d: Address
    Input: e: Address
    Input: f: Address
    Body: {
        Optimize_FoldFree(a)
        Optimize_FoldFree(b)
        Optimize_FoldFree(c)
        Optimize_FoldFree(d)
        Optimize_FoldFree(e)
        Optimize_FoldFree(f)
        ReturnValue(0)
    }
}

Function.Optimize_FoldDot {
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }
        i = 0
        WhileLoop LessThan(i, 256) {
            c = GetByte(name, i)
            IfCondition EqualTo(c, 0) ThenBlock: { ReturnValue(0) }
            IfCondition EqualTo(c, 46) ThenBlock: { ReturnValue(1) }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

Function.Optimize_FoldOp {
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(StringCompare(name, "Add"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "Subtract"), 0) ThenBlock: { ReturnValue(2) }
        IfCondition EqualTo(StringCompare(name, "Multiply"), 0) ThenBlock: { ReturnValue(3) }
        IfCondition EqualTo(StringCompare(name, "Divide"), 0) ThenBlock: { ReturnValue(4) }
        IfCondition EqualTo(StringCompare(name, "Float_Add"), 0) ThenBlock: { ReturnValue(5) }
        IfCondition EqualTo(StringCompare(name, "Float_Sub"), 0) ThenBlock: { ReturnValue(6) }
        IfCondition EqualTo(StringCompare(name, "Float_Mul"), 0) ThenBlock: { ReturnValue(7) }
        IfCondition EqualTo(StringCompare(name, "Float_Div"), 0) ThenBlock: { ReturnValue(8) }
        IfCondition EqualTo(StringCompare(name, "Float_FromInt"), 0) ThenBlock: { ReturnValue(9) }
        ReturnValue(0)
    }
}

Function.Optimize_FoldIsFn {
    Input: t: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(t, AST.FUNCTION) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(t, AST.SUBROUTINE) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(t, AST.INLINE_FUNCTION) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

Function.Optimize_FoldIsLoop {
    Input: t: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(t, AST.WHILE) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(t, AST.UNTIL) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(t, AST.FOR_EVERY) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(t, AST.EVERY_INTERVAL) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(t, AST.LOOP_MAIN) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(t, AST.LOOP_ACTOR) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(t, AST.LOOP_START) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(t, AST.LOOP_SHADOW) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

Function.Optimize_FoldIsCtrl {
    Input: t: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(Optimize_FoldIsLoop(t), 1) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(t, AST.IF) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(t, AST.FORK) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(t, AST.SWITCH) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(t, AST.BRANCH) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(t, AST.TRY) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(t, AST.WITH_CONTEXT) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(t, AST.DEFER) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

Function.Optimize_FoldApply {
    Input: op: Integer
    Input: v0: Integer
    Input: v1: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(op, 1) ThenBlock: {
            FoldHold.val = Add(v0, v1)
            ReturnValue(1)
        }
        IfCondition EqualTo(op, 2) ThenBlock: {
            FoldHold.val = Subtract(v0, v1)
            ReturnValue(1)
        }
        IfCondition EqualTo(op, 3) ThenBlock: {
            FoldHold.val = Multiply(v0, v1)
            ReturnValue(1)
        }
        IfCondition EqualTo(op, 4) ThenBlock: {
            IfCondition EqualTo(v1, 0) ThenBlock: { ReturnValue(0) }
            FoldHold.val = Divide(v0, v1)
            ReturnValue(1)
        }
        IfCondition EqualTo(op, 5) ThenBlock: {
            FoldHold.val = Float_Add(v0, v1)
            ReturnValue(1)
        }
        IfCondition EqualTo(op, 6) ThenBlock: {
            FoldHold.val = Float_Sub(v0, v1)
            ReturnValue(1)
        }
        IfCondition EqualTo(op, 7) ThenBlock: {
            FoldHold.val = Float_Mul(v0, v1)
            ReturnValue(1)
        }
        IfCondition EqualTo(op, 8) ThenBlock: {
            FoldHold.val = Float_Div(v0, v1)
            ReturnValue(1)
        }
        IfCondition EqualTo(op, 9) ThenBlock: {
            FoldHold.val = Float_FromInt(v0)
            ReturnValue(1)
        }
        ReturnValue(0)
    }
}

Function.Optimize_FoldLookup {
    Input: names: Address
    Input: kinds: Address
    Input: vals: Address
    Input: name: Address
    Input: use_pool: Integer
    Body: {
        IfCondition EqualTo(name, 0) ThenBlock: {
            FoldHold.kind = 4
            FoldHold.val = 0
            ReturnValue(0)
        }
        IfCondition EqualTo(FoldHold.stop, 1) ThenBlock: {
            FoldHold.kind = 4
            FoldHold.val = 0
            ReturnValue(0)
        }
        hops = 0
        cur = name
        WhileLoop LessThan(hops, 4) {
            found = -1
            IfCondition NotEqual(names, 0) ThenBlock: {
                n = Array.Size(names)
                i = 0
                WhileLoop LessThan(i, n) {
                    IfCondition EqualTo(Optimize_NameEq(Array.Get(names, i), cur), 1) ThenBlock: {
                        found = i
                        ExitLoop
                    }
                    i = Add(i, 1)
                }
            }
            IfCondition GreaterEqual(found, 0) ThenBlock: {
                k = Array.Get(kinds, found)
                v = Array.Get(vals, found)
                FoldHold.kind = k
                FoldHold.val = v
                ReturnValue(0)
            }
            IfCondition LessThan(found, 0) ThenBlock: {
                ExitLoop
            }
        }
        IfCondition EqualTo(use_pool, 1) ThenBlock: {
            IfCondition NotEqual(OptState.pool_slot, 0) ThenBlock: {
                slot = SHash.Lookup(OptState.pool_slot, cur)
                IfCondition NotEqual(slot, Collections.XNULL) ThenBlock: {
                    FoldHold.kind = Array.Get(OptState.pool_kinds, slot)
                    FoldHold.val = Array.Get(OptState.pool_vals, slot)
                    ReturnValue(0)
                }
            }
        }
        FoldHold.kind = 4
        FoldHold.val = 0
        ReturnValue(0)
    }
}

Function.Optimize_FoldValue {
    Input: node: Address
    Input: names: Address
    Input: kinds: Address
    Input: vals: Address
    Input: use_pool: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: {
            FoldHold.kind = 0
            FoldHold.val = 0
            ReturnValue(0)
        }
        t = AST_GetType(node)
        IfCondition EqualTo(t, AST.NUMBER) ThenBlock: {
            FoldHold.val = StringToNumber(AST_GetData1(node))
            IfCondition EqualTo(AST_GetData2(node), 2) ThenBlock: {
                FoldHold.kind = 2
                ReturnValue(0)
            }
            FoldHold.kind = 1
            ReturnValue(0)
        }
        IfCondition EqualTo(t, AST.IDENTIFIER) ThenBlock: {
            Optimize_FoldLookup(names, kinds, vals, AST_GetData1(node), use_pool)
            hops = 0
            last = AST_GetData1(node)
            WhileLoop EqualTo(FoldHold.kind, 3) {
                IfCondition GreaterEqual(hops, 4) ThenBlock: { ExitLoop }
                last = FoldHold.val
                Optimize_FoldLookup(names, kinds, vals, last, use_pool)
                hops = Add(hops, 1)
            }
            IfCondition GreaterThan(hops, 0) ThenBlock: {
                IfCondition NotEqual(FoldHold.kind, 1) ThenBlock: {
                    IfCondition NotEqual(FoldHold.kind, 2) ThenBlock: {
                        FoldHold.kind = 3
                        FoldHold.val = last
                    }
                }
            }
            ReturnValue(0)
        }
        IfCondition NotEqual(t, AST.CALL) ThenBlock: {
            FoldHold.kind = 0
            FoldHold.val = 0
            ReturnValue(0)
        }
        op = Optimize_FoldOp(AST_GetData1(node))
        IfCondition EqualTo(op, 0) ThenBlock: {
            FoldHold.kind = 0
            FoldHold.val = 0
            ReturnValue(0)
        }
        count = AST_GetChildCount(node)
        IfCondition EqualTo(op, 9) ThenBlock: {
            IfCondition NotEqual(count, 1) ThenBlock: {
                FoldHold.kind = 0
                FoldHold.val = 0
                ReturnValue(0)
            }
            Optimize_FoldValue(AST_GetChild(node, 0), names, kinds, vals, use_pool)
            ck = FoldHold.kind
            cv = FoldHold.val
            IfCondition EqualTo(ck, 1) ThenBlock: {
                IfCondition EqualTo(Optimize_FoldApply(9, cv, 0), 1) ThenBlock: {
                    FoldHold.kind = 2
                    ReturnValue(0)
                }
            }
            IfCondition EqualTo(ck, 2) ThenBlock: {
                IfCondition EqualTo(Optimize_FoldApply(9, cv, 0), 1) ThenBlock: {
                    FoldHold.kind = 2
                    ReturnValue(0)
                }
            }
            IfCondition EqualTo(ck, 4) ThenBlock: {
                FoldHold.kind = 4
                FoldHold.val = 0
                ReturnValue(0)
            }
            FoldHold.kind = 0
            FoldHold.val = 0
            ReturnValue(0)
        }
        IfCondition NotEqual(count, 2) ThenBlock: {
            FoldHold.kind = 0
            FoldHold.val = 0
            ReturnValue(0)
        }
        Optimize_FoldValue(AST_GetChild(node, 0), names, kinds, vals, use_pool)
        k0 = FoldHold.kind
        v0 = FoldHold.val
        Optimize_FoldValue(AST_GetChild(node, 1), names, kinds, vals, use_pool)
        k1 = FoldHold.kind
        v1 = FoldHold.val
        num0 = 0
        num1 = 0
        IfCondition EqualTo(k0, 1) ThenBlock: { num0 = 1 }
        IfCondition EqualTo(k0, 2) ThenBlock: { num0 = 1 }
        IfCondition EqualTo(k1, 1) ThenBlock: { num1 = 1 }
        IfCondition EqualTo(k1, 2) ThenBlock: { num1 = 1 }
        IfCondition EqualTo(num0, 1) ThenBlock: {
            IfCondition EqualTo(num1, 1) ThenBlock: {
                IfCondition EqualTo(Optimize_FoldApply(op, v0, v1), 0) ThenBlock: {
                    FoldHold.kind = 0
                    FoldHold.val = 0
                    ReturnValue(0)
                }
                IfCondition LessEqual(op, 4) ThenBlock: {
                    FoldHold.kind = 1
                    ReturnValue(0)
                }
                FoldHold.kind = 2
                ReturnValue(0)
            }
        }
        IfCondition EqualTo(k0, 0) ThenBlock: {
            FoldHold.kind = 0
            FoldHold.val = 0
            ReturnValue(0)
        }
        IfCondition EqualTo(k1, 0) ThenBlock: {
            FoldHold.kind = 0
            FoldHold.val = 0
            ReturnValue(0)
        }
        FoldHold.kind = 4
        FoldHold.val = 0
        ReturnValue(0)
    }
}

Function.Optimize_FoldPut {
    Input: names: Address
    Input: kinds: Address
    Input: vals: Address
    Input: name: Address
    Input: kind: Integer
    Input: val: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(names, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(FoldHold.stop, 1) ThenBlock: { ReturnValue(0) }
        found = -1
        n = Array.Size(names)
        i = 0
        WhileLoop LessThan(i, n) {
            IfCondition EqualTo(Optimize_NameEq(Array.Get(names, i), name), 1) ThenBlock: {
                found = i
                ExitLoop
            }
            i = Add(i, 1)
        }
        IfCondition EqualTo(kind, 3) ThenBlock: {
            IfCondition GreaterEqual(found, 0) ThenBlock: {
                IfCondition EqualTo(Array.Get(kinds, found), 0) ThenBlock: { ReturnValue(0) }
                Array.Set(kinds, found, 3)
                Array.Set(vals, found, val)
                ReturnValue(1)
            }
            IfCondition GreaterEqual(n, 512) ThenBlock: {
                FoldHold.stop = 1
                ReturnValue(0)
            }
            Array.Push(names, name)
            Array.Push(kinds, 3)
            Array.Push(vals, val)
            ReturnValue(1)
        }
        IfCondition GreaterEqual(found, 0) ThenBlock: {
            oldk = Array.Get(kinds, found)
            oldv = Array.Get(vals, found)
            IfCondition EqualTo(oldk, 0) ThenBlock: { ReturnValue(0) }
            IfCondition EqualTo(kind, 0) ThenBlock: {
                Array.Set(kinds, found, 0)
                ReturnValue(0)
            }
            IfCondition EqualTo(kind, 4) ThenBlock: {
                Array.Set(kinds, found, 0)
                ReturnValue(0)
            }
            IfCondition EqualTo(oldk, kind) ThenBlock: {
                IfCondition EqualTo(oldv, val) ThenBlock: { ReturnValue(1) }
            }
            Array.Set(kinds, found, 0)
            ReturnValue(0)
        }
        IfCondition GreaterEqual(n, 512) ThenBlock: {
            FoldHold.stop = 1
            ReturnValue(0)
        }
        Array.Push(names, name)
        Array.Push(kinds, kind)
        Array.Push(vals, val)
        ReturnValue(1)
    }
}

Function.Optimize_FoldForce {
    Input: names: Address
    Input: kinds: Address
    Input: vals: Address
    Input: name: Address
    Input: kind: Integer
    Input: val: Integer
    Body: {
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(names, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(FoldHold.stop, 1) ThenBlock: { ReturnValue(0) }
        found = -1
        n = Array.Size(names)
        i = 0
        WhileLoop LessThan(i, n) {
            IfCondition EqualTo(Optimize_NameEq(Array.Get(names, i), name), 1) ThenBlock: {
                found = i
                ExitLoop
            }
            i = Add(i, 1)
        }
        IfCondition GreaterEqual(found, 0) ThenBlock: {
            Array.Set(kinds, found, kind)
            Array.Set(vals, found, val)
            ReturnValue(0)
        }
        IfCondition GreaterEqual(n, 512) ThenBlock: {
            FoldHold.stop = 1
            ReturnValue(0)
        }
        Array.Push(names, name)
        Array.Push(kinds, kind)
        Array.Push(vals, val)
        ReturnValue(0)
    }
}

Function.Optimize_FoldPoolSee {
    Input: name: Address
    Input: kind: Integer
    Input: val: Integer
    Body: {
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(OptState.pool_slot, 0) ThenBlock: { ReturnValue(0) }
        slot = SHash.Lookup(OptState.pool_slot, name)
        gen = FoldHold.gen
        IfCondition EqualTo(FoldHold.stop, 1) ThenBlock: {
            IfCondition NotEqual(slot, Collections.XNULL) ThenBlock: {
                Array.Set(OptState.pool_kinds, slot, 0)
                Array.Set(OptState.pool_gen, slot, gen)
            }
            ReturnValue(0)
        }
        IfCondition EqualTo(slot, Collections.XNULL) ThenBlock: {
            slot = Array.Size(OptState.pool_names)
            IfCondition GreaterEqual(slot, 8192) ThenBlock: {
                FoldHold.stop = 1
                ReturnValue(0)
            }
            SHash.Insert(OptState.pool_slot, name, slot)
            Array.Push(OptState.pool_names, name)
            Array.Push(OptState.pool_kinds, kind)
            Array.Push(OptState.pool_vals, val)
            Array.Push(OptState.pool_gen, gen)
            IfCondition EqualTo(kind, 1) ThenBlock: {
                FoldHold.added = Add(FoldHold.added, 1)
            }
            IfCondition EqualTo(kind, 2) ThenBlock: {
                FoldHold.added = Add(FoldHold.added, 1)
            }
            ReturnValue(0)
        }
        oldk = Array.Get(OptState.pool_kinds, slot)
        oldv = Array.Get(OptState.pool_vals, slot)
        oldg = Array.Get(OptState.pool_gen, slot)
        IfCondition EqualTo(oldk, 0) ThenBlock: {
            Array.Set(OptState.pool_gen, slot, gen)
            ReturnValue(0)
        }
        IfCondition EqualTo(oldg, gen) ThenBlock: {
            same = 0
            IfCondition EqualTo(kind, oldk) ThenBlock: {
                IfCondition EqualTo(val, oldv) ThenBlock: {
                    IfCondition EqualTo(kind, 1) ThenBlock: { same = 1 }
                    IfCondition EqualTo(kind, 2) ThenBlock: { same = 1 }
                }
            }
            IfCondition EqualTo(same, 0) ThenBlock: {
                Array.Set(OptState.pool_kinds, slot, 0)
                Array.Set(OptState.pool_gen, slot, gen)
            }
            ReturnValue(0)
        }
        IfCondition EqualTo(kind, 0) ThenBlock: {
            Array.Set(OptState.pool_kinds, slot, 0)
            Array.Set(OptState.pool_gen, slot, gen)
            ReturnValue(0)
        }
        IfCondition EqualTo(kind, 4) ThenBlock: {
            Array.Set(OptState.pool_gen, slot, gen)
            ReturnValue(0)
        }
        IfCondition EqualTo(oldk, 4) ThenBlock: {
            Array.Set(OptState.pool_kinds, slot, kind)
            Array.Set(OptState.pool_vals, slot, val)
            Array.Set(OptState.pool_gen, slot, gen)
            FoldHold.added = Add(FoldHold.added, 1)
            ReturnValue(0)
        }
        IfCondition EqualTo(kind, oldk) ThenBlock: {
            IfCondition EqualTo(val, oldv) ThenBlock: {
                Array.Set(OptState.pool_gen, slot, gen)
                ReturnValue(0)
            }
        }
        Array.Set(OptState.pool_kinds, slot, 0)
        Array.Set(OptState.pool_gen, slot, gen)
        ReturnValue(0)
    }
}

Function.Optimize_FoldScanAssign {
    Input: node: Address
    Input: guarded: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetData2(node), 0) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(AST_GetChildCount(node), 1) ThenBlock: { ReturnValue(0) }
        name = AST_GetData1(node)
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }
        dotted = Optimize_FoldDot(name)
        IfCondition EqualTo(guarded, 1) ThenBlock: {
            IfCondition EqualTo(dotted, 1) ThenBlock: {
                Optimize_FoldPoolSee(name, 0, 0)
            }
            IfCondition EqualTo(dotted, 0) ThenBlock: {
                Optimize_FoldPut(OptState.scan_names, OptState.scan_kinds, OptState.scan_vals, name, 0, 0)
            }
            ReturnValue(0)
        }
        Optimize_FoldValue(AST_GetChild(node, 0), OptState.scan_names, OptState.scan_kinds, OptState.scan_vals, 1)
        IfCondition EqualTo(dotted, 1) ThenBlock: {
            Optimize_FoldPoolSee(name, FoldHold.kind, FoldHold.val)
        }
        IfCondition EqualTo(dotted, 0) ThenBlock: {
            Optimize_FoldPut(OptState.scan_names, OptState.scan_kinds, OptState.scan_vals, name, FoldHold.kind, FoldHold.val)
        }
        ReturnValue(0)
    }
}

Function.Optimize_FoldScan {
    Input: node: Address
    Input: guarded: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        t = AST_GetType(node)
        IfCondition EqualTo(Optimize_FoldIsFn(t), 1) ThenBlock: {
            FoldHold.stop = 0
            Array.Clear(OptState.scan_names)
            Array.Clear(OptState.scan_kinds)
            Array.Clear(OptState.scan_vals)
            count = AST_GetChildCount(node)
            i = 0
            WhileLoop LessThan(i, count) {
                Optimize_FoldScan(AST_GetChild(node, i), 0)
                i = Add(i, 1)
            }
            FoldHold.stop = 0
            Array.Clear(OptState.scan_names)
            Array.Clear(OptState.scan_kinds)
            Array.Clear(OptState.scan_vals)
            ReturnValue(0)
        }
        IfCondition EqualTo(Optimize_FoldIsCtrl(t), 1) ThenBlock: {
            count = AST_GetChildCount(node)
            i = 0
            WhileLoop LessThan(i, count) {
                Optimize_FoldScan(AST_GetChild(node, i), 1)
                i = Add(i, 1)
            }
            ReturnValue(0)
        }
        IfCondition EqualTo(t, AST.ASSIGNMENT) ThenBlock: {
            Optimize_FoldScanAssign(node, guarded)
        }
        count = AST_GetChildCount(node)
        i = 0
        WhileLoop LessThan(i, count) {
            Optimize_FoldScan(AST_GetChild(node, i), guarded)
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

Function.Optimize_FoldInit {
    Body: {
        IfCondition EqualTo(Compile.ast, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(OptState.pool_slot, 0) ThenBlock: {
            IfCondition EqualTo(OptState.fold_ast, Compile.ast) ThenBlock: {
                ReturnValue(0)
            }
            SHash.Destroy(OptState.pool_slot)
            Optimize_FoldFree(OptState.pool_names)
            Optimize_FoldFree(OptState.pool_kinds)
            Optimize_FoldFree(OptState.pool_vals)
            Optimize_FoldFree(OptState.pool_gen)
            Optimize_FoldFree(OptState.scan_names)
            Optimize_FoldFree(OptState.scan_kinds)
            Optimize_FoldFree(OptState.scan_vals)
            OptState.pool_slot = 0
        }
        OptState.pool_slot = SHash.Create(4096)
        OptState.pool_names = Array.Create(64)
        OptState.pool_kinds = Array.Create(64)
        OptState.pool_vals = Array.Create(64)
        OptState.pool_gen = Array.Create(64)
        OptState.scan_names = Array.Create(64)
        OptState.scan_kinds = Array.Create(64)
        OptState.scan_vals = Array.Create(64)
        FoldHold.one = Float_FromInt(1)
        FoldHold.gen = 0
        FoldHold.stop = 0
        pass = 0
        WhileLoop LessThan(pass, 8) {
            FoldHold.added = 0
            FoldHold.gen = Add(FoldHold.gen, 1)
            FoldHold.stop = 0
            Array.Clear(OptState.scan_names)
            Array.Clear(OptState.scan_kinds)
            Array.Clear(OptState.scan_vals)
            Optimize_FoldScan(Compile.ast, 0)
            IfCondition EqualTo(FoldHold.added, 0) ThenBlock: {
                IfCondition GreaterThan(pass, 0) ThenBlock: {
                    ExitLoop
                }
            }
            pass = Add(pass, 1)
        }
        FoldHold.stop = 0
        OptState.fold_ast = Compile.ast
        ReturnValue(0)
    }
}

Function.Optimize_FoldNum {
    Input: val: Integer
    Input: kind: Integer
    Output: Address
    Body: {
        node = AST_MakeNumber(NumberToString(val))
        AST_SetData2(node, kind)
        ReturnValue(node)
    }
}

Function.Optimize_FoldPure {
    Input: node: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        t = AST_GetType(node)
        IfCondition EqualTo(t, AST.NUMBER) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(t, AST.IDENTIFIER) ThenBlock: { ReturnValue(1) }
        IfCondition NotEqual(t, AST.CALL) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_FoldOp(AST_GetData1(node)), 0) ThenBlock: { ReturnValue(0) }
        count = AST_GetChildCount(node)
        i = 0
        WhileLoop LessThan(i, count) {
            IfCondition EqualTo(Optimize_FoldPure(AST_GetChild(node, i)), 0) ThenBlock: {
                ReturnValue(0)
            }
            i = Add(i, 1)
        }
        ReturnValue(1)
    }
}

Function.Optimize_FoldHit {
    Input: node: Address
    Input: names: Address
    Input: start: Integer
    Input: count: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        IfCondition LessEqual(count, 0) ThenBlock: { ReturnValue(0) }
        t = AST_GetType(node)
        check = 0
        IfCondition EqualTo(t, AST.IDENTIFIER) ThenBlock: { check = 1 }
        IfCondition EqualTo(t, AST.ASSIGNMENT) ThenBlock: { check = 1 }
        IfCondition EqualTo(t, AST.INDEX_ASSIGN) ThenBlock: { check = 1 }
        IfCondition EqualTo(check, 1) ThenBlock: {
            nm = AST_GetData1(node)
            i = 0
            WhileLoop LessThan(i, count) {
                IfCondition EqualTo(Optimize_NameEq(nm, Array.Get(names, Add(start, i))), 1) ThenBlock: {
                    ReturnValue(1)
                }
                i = Add(i, 1)
            }
        }
        n = AST_GetChildCount(node)
        i = 0
        WhileLoop LessThan(i, n) {
            IfCondition EqualTo(Optimize_FoldHit(AST_GetChild(node, i), names, start, count), 1) ThenBlock: {
                ReturnValue(1)
            }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

Function.Optimize_FoldSimple {
    Input: node: Address
    Output: Address
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(node), AST.ASSIGNMENT) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetData2(node), 0) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(AST_GetChildCount(node), 1) ThenBlock: { ReturnValue(0) }
        name = AST_GetData1(node)
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_FoldDot(name), 1) ThenBlock: { ReturnValue(0) }
        ReturnValue(name)
    }
}

Function.Optimize_FoldDup {
    Input: dn: Address
    Input: dk: Address
    Input: dv: Address
    Input: sn: Address
    Input: sk: Address
    Input: sv: Address
    Body: {
        IfCondition EqualTo(sn, 0) ThenBlock: { ReturnValue(0) }
        n = Array.Size(sn)
        i = 0
        WhileLoop LessThan(i, n) {
            Array.Push(dn, Array.Get(sn, i))
            Array.Push(dk, Array.Get(sk, i))
            Array.Push(dv, Array.Get(sv, i))
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

Function.Optimize_FoldPoison {
    Input: node: Address
    Input: names: Address
    Input: kinds: Address
    Input: vals: Address
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        t = AST_GetType(node)
        IfCondition EqualTo(Optimize_FoldIsFn(t), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(t, AST.ASSIGNMENT) ThenBlock: {
            IfCondition EqualTo(AST_GetData2(node), 0) ThenBlock: {
                Optimize_FoldPut(names, kinds, vals, AST_GetData1(node), 0, 0)
            }
        }
        IfCondition EqualTo(t, AST.INDEX_ASSIGN) ThenBlock: {
            Optimize_FoldPut(names, kinds, vals, AST_GetData1(node), 0, 0)
        }
        count = AST_GetChildCount(node)
        i = 0
        WhileLoop LessThan(i, count) {
            Optimize_FoldPoison(AST_GetChild(node, i), names, kinds, vals)
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

Function.Optimize_FoldSubst {
    Input: node: Address
    Input: names: Address
    Input: kinds: Address
    Input: vals: Address
    Output: Address
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        t = AST_GetType(node)
        IfCondition EqualTo(t, AST.IDENTIFIER) ThenBlock: {
            Optimize_FoldValue(node, names, kinds, vals, 0)
            ck = FoldHold.kind
            cv = FoldHold.val
            IfCondition EqualTo(ck, 1) ThenBlock: {
                ReturnValue(Optimize_FoldNum(cv, 1))
            }
            IfCondition EqualTo(ck, 2) ThenBlock: {
                ReturnValue(Optimize_FoldNum(cv, 2))
            }
            IfCondition EqualTo(ck, 3) ThenBlock: {
                AST_SetData1(node, cv)
                Optimize_FoldValue(node, names, kinds, vals, 0)
                IfCondition EqualTo(FoldHold.kind, 1) ThenBlock: {
                    ReturnValue(Optimize_FoldNum(FoldHold.val, 1))
                }
                IfCondition EqualTo(FoldHold.kind, 2) ThenBlock: {
                    ReturnValue(Optimize_FoldNum(FoldHold.val, 2))
                }
            }
            ReturnValue(node)
        }
        count = AST_GetChildCount(node)
        i = 0
        WhileLoop LessThan(i, count) {
            ch = AST_GetChild(node, i)
            nh = Optimize_FoldSubst(ch, names, kinds, vals)
            IfCondition NotEqual(nh, ch) ThenBlock: {
                AST_SetChild(node, i, nh)
            }
            i = Add(i, 1)
        }
        IfCondition NotEqual(t, AST.CALL) ThenBlock: { ReturnValue(node) }
        op = Optimize_FoldOp(AST_GetData1(node))
        IfCondition EqualTo(op, 0) ThenBlock: { ReturnValue(node) }
        Optimize_FoldValue(node, names, kinds, vals, 0)
        IfCondition EqualTo(FoldHold.kind, 1) ThenBlock: {
            ReturnValue(Optimize_FoldNum(FoldHold.val, 1))
        }
        IfCondition EqualTo(FoldHold.kind, 2) ThenBlock: {
            ReturnValue(Optimize_FoldNum(FoldHold.val, 2))
        }
        IfCondition EqualTo(op, 7) ThenBlock: {
            IfCondition EqualTo(count, 2) ThenBlock: {
                left = AST_GetChild(node, 0)
                right = AST_GetChild(node, 1)
                IfCondition EqualTo(AST_GetType(left), AST.NUMBER) ThenBlock: {
                    IfCondition EqualTo(StringToNumber(AST_GetData1(left)), FoldHold.one) ThenBlock: {
                        ReturnValue(right)
                    }
                }
                IfCondition EqualTo(AST_GetType(right), AST.NUMBER) ThenBlock: {
                    IfCondition EqualTo(StringToNumber(AST_GetData1(right)), FoldHold.one) ThenBlock: {
                        ReturnValue(left)
                    }
                }
            }
        }
        IfCondition EqualTo(op, 8) ThenBlock: {
            IfCondition EqualTo(count, 2) ThenBlock: {
                right = AST_GetChild(node, 1)
                IfCondition EqualTo(AST_GetType(right), AST.NUMBER) ThenBlock: {
                    IfCondition EqualTo(StringToNumber(AST_GetData1(right)), FoldHold.one) ThenBlock: {
                        ReturnValue(AST_GetChild(node, 0))
                    }
                }
            }
        }
        ReturnValue(node)
    }
}

Function.Optimize_FoldCollect {
    Input: block: Address
    Input: dest: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(block, 0) ThenBlock: { ReturnValue(0) }
        count = AST_GetChildCount(block)
        i = 0
        WhileLoop LessThan(i, count) {
            st = AST_GetChild(block, i)
            t = AST_GetType(st)
            IfCondition EqualTo(t, AST.BLOCK) ThenBlock: {
                IfCondition EqualTo(Optimize_FoldCollect(st, dest), 1) ThenBlock: { ReturnValue(1) }
            }
            IfCondition EqualTo(t, AST.BODY) ThenBlock: {
                IfCondition EqualTo(Optimize_FoldCollect(st, dest), 1) ThenBlock: { ReturnValue(1) }
            }
            IfCondition NotEqual(t, AST.BLOCK) ThenBlock: {
                IfCondition NotEqual(t, AST.BODY) ThenBlock: {
                    nm = Optimize_FoldSimple(st)
                    IfCondition NotEqual(nm, 0) ThenBlock: {
                        have = 0
                        j = 0
                        n = Array.Size(dest)
                        WhileLoop LessThan(j, n) {
                            IfCondition EqualTo(Optimize_NameEq(Array.Get(dest, j), nm), 1) ThenBlock: {
                                have = 1
                                ExitLoop
                            }
                            j = Add(j, 1)
                        }
                        IfCondition EqualTo(have, 0) ThenBlock: {
                            IfCondition GreaterEqual(n, 16) ThenBlock: { ReturnValue(1) }
                            Array.Push(dest, nm)
                        }
                    }
                }
            }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

Function.Optimize_FoldArm {
    Input: block: Address
    Input: names: Address
    Input: kinds: Address
    Input: vals: Address
    Body: {
        IfCondition EqualTo(block, 0) ThenBlock: { ReturnValue(0) }
        count = AST_GetChildCount(block)
        i = 0
        WhileLoop LessThan(i, count) {
            st = AST_GetChild(block, i)
            t = AST_GetType(st)
            IfCondition EqualTo(t, AST.BLOCK) ThenBlock: {
                Optimize_FoldArm(st, names, kinds, vals)
            }
            IfCondition EqualTo(t, AST.BODY) ThenBlock: {
                Optimize_FoldArm(st, names, kinds, vals)
            }
            IfCondition NotEqual(t, AST.BLOCK) ThenBlock: {
                IfCondition NotEqual(t, AST.BODY) ThenBlock: {
                    nm = Optimize_FoldSimple(st)
                    IfCondition NotEqual(nm, 0) ThenBlock: {
                        Optimize_FoldValue(AST_GetChild(st, 0), names, kinds, vals, 0)
                        IfCondition EqualTo(FoldHold.kind, 1) ThenBlock: {
                            Optimize_FoldForce(names, kinds, vals, nm, 1, FoldHold.val)
                        }
                        IfCondition EqualTo(FoldHold.kind, 2) ThenBlock: {
                            Optimize_FoldForce(names, kinds, vals, nm, 2, FoldHold.val)
                        }
                        IfCondition NotEqual(FoldHold.kind, 1) ThenBlock: {
                            IfCondition NotEqual(FoldHold.kind, 2) ThenBlock: {
                                Optimize_FoldForce(names, kinds, vals, nm, 0, 0)
                            }
                        }
                    }
                    IfCondition EqualTo(nm, 0) ThenBlock: {
                        Optimize_FoldPoison(st, names, kinds, vals)
                    }
                }
            }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

Function.Optimize_FoldIsBlock {
    Input: node: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        t = AST_GetType(node)
        IfCondition EqualTo(t, AST.BLOCK) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(t, AST.BODY) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

Function.Optimize_FoldGather {
    Input: stmt: Address
    Input: arms: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(stmt, 0) ThenBlock: { ReturnValue(0) }
        t = AST_GetType(stmt)
        count = AST_GetChildCount(stmt)
        IfCondition EqualTo(t, AST.IF) ThenBlock: {
            IfCondition LessThan(count, 3) ThenBlock: { ReturnValue(0) }
            b0 = AST_GetChild(stmt, 1)
            b1 = AST_GetChild(stmt, 2)
            IfCondition EqualTo(Optimize_FoldIsBlock(b0), 0) ThenBlock: { ReturnValue(0) }
            IfCondition EqualTo(Optimize_FoldIsBlock(b1), 0) ThenBlock: { ReturnValue(0) }
            Array.Push(arms, b0)
            Array.Push(arms, b1)
            ReturnValue(1)
        }
        IfCondition EqualTo(t, AST.FORK) ThenBlock: {
            IfCondition LessThan(count, 3) ThenBlock: { ReturnValue(0) }
            b0 = AST_GetChild(stmt, 1)
            b1 = AST_GetChild(stmt, 2)
            IfCondition EqualTo(Optimize_FoldIsBlock(b0), 0) ThenBlock: { ReturnValue(0) }
            IfCondition EqualTo(Optimize_FoldIsBlock(b1), 0) ThenBlock: { ReturnValue(0) }
            Array.Push(arms, b0)
            Array.Push(arms, b1)
            ReturnValue(1)
        }
        branch = 0
        IfCondition EqualTo(t, AST.SWITCH) ThenBlock: { branch = 1 }
        IfCondition EqualTo(t, AST.BRANCH) ThenBlock: { branch = 1 }
        IfCondition EqualTo(branch, 0) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(count, 2) ThenBlock: { ReturnValue(0) }
        has_def = 0
        i = 1
        WhileLoop LessThan(i, count) {
            ch = AST_GetChild(stmt, i)
            ct = AST_GetType(ch)
            IfCondition EqualTo(ct, AST.CASE) ThenBlock: {
                IfCondition LessThan(AST_GetChildCount(ch), 2) ThenBlock: { ReturnValue(0) }
                body = AST_GetChild(ch, 1)
                IfCondition EqualTo(Optimize_FoldIsBlock(body), 0) ThenBlock: { ReturnValue(0) }
                Array.Push(arms, body)
            }
            IfCondition EqualTo(ct, AST.DEFAULT) ThenBlock: {
                has_def = Add(has_def, 1)
                IfCondition LessThan(AST_GetChildCount(ch), 1) ThenBlock: { ReturnValue(0) }
                body = AST_GetChild(ch, 0)
                IfCondition EqualTo(Optimize_FoldIsBlock(body), 0) ThenBlock: { ReturnValue(0) }
                Array.Push(arms, body)
            }
            IfCondition NotEqual(ct, AST.CASE) ThenBlock: {
                IfCondition NotEqual(ct, AST.DEFAULT) ThenBlock: { ReturnValue(0) }
            }
            IfCondition GreaterThan(Array.Size(arms), 16) ThenBlock: { ReturnValue(0) }
            i = Add(i, 1)
        }
        IfCondition NotEqual(has_def, 1) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(Array.Size(arms), 1) ThenBlock: { ReturnValue(0) }
        ReturnValue(1)
    }
}

// A NUMBER operand of Float_Add/Sub/Mul is the same bits the runtime uses.
// Non-leaf functions park up to 8 distinct patterns in the frame once, at
// entry. Class 8 is that slot. Leaves keep the red zone and miss the opt.

Function.Optimize_FltConstEnsure {
    Body: {
        IfCondition EqualTo(OptState.flt_bits, 0) ThenBlock: {
            OptState.flt_bits = Allocate(64)
            OptState.flt_disp = Allocate(64)
        }
        IfCondition EqualTo(OptState.flt_save, 0) ThenBlock: {
            OptState.flt_save = Allocate(640)
        }
        ReturnValue(0)
    }
}

Function.Optimize_FltConstPush {
    Body: {
        Optimize_FltConstEnsure()
        d = OptState.flt_depth
        IfCondition GreaterEqual(d, 4) ThenBlock: {
            OptState.flt_depth = Add(d, 1)
            OptState.flt_skip = Add(OptState.flt_skip, 1)
            ReturnValue(0)
        }
        base = Add(OptState.flt_save, Multiply(d, 160))
        StoreValue(base, OptState.flt_n)
        StoreValue(Add(base, 8), OptState.flt_ready)
        i = 0
        WhileLoop LessThan(i, 8) {
            StoreValue(Add(base, Add(16, Multiply(i, 8))), Dereference(Add(OptState.flt_bits, Multiply(i, 8))))
            StoreValue(Add(base, Add(80, Multiply(i, 8))), Dereference(Add(OptState.flt_disp, Multiply(i, 8))))
            i = Add(i, 1)
        }
        OptState.flt_depth = Add(d, 1)
        OptState.flt_n = 0
        OptState.flt_ready = 0
        ReturnValue(0)
    }
}

Function.Optimize_FltConstPop {
    Body: {
        d = OptState.flt_depth
        IfCondition LessEqual(d, 0) ThenBlock: { ReturnValue(0) }
        OptState.flt_depth = Subtract(d, 1)
        IfCondition GreaterThan(OptState.flt_skip, 0) ThenBlock: {
            OptState.flt_skip = Subtract(OptState.flt_skip, 1)
            ReturnValue(0)
        }
        d = OptState.flt_depth
        base = Add(OptState.flt_save, Multiply(d, 160))
        OptState.flt_n = Dereference(base)
        OptState.flt_ready = Dereference(Add(base, 8))
        i = 0
        WhileLoop LessThan(i, 8) {
            StoreValue(Add(OptState.flt_bits, Multiply(i, 8)), Dereference(Add(base, Add(16, Multiply(i, 8)))))
            StoreValue(Add(OptState.flt_disp, Multiply(i, 8)), Dereference(Add(base, Add(80, Multiply(i, 8)))))
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

Function.Optimize_FltConstNote {
    Input: bits: Integer
    Body: {
        IfCondition GreaterEqual(OptState.flt_n, 8) ThenBlock: { ReturnValue(0) }
        i = 0
        WhileLoop LessThan(i, OptState.flt_n) {
            have = Dereference(Add(OptState.flt_bits, Multiply(i, 8)))
            IfCondition EqualTo(have, bits) ThenBlock: { ReturnValue(0) }
            i = Add(i, 1)
        }
        at = Multiply(OptState.flt_n, 8)
        StoreValue(Add(OptState.flt_bits, at), bits)
        StoreValue(Add(OptState.flt_disp, at), 0)
        OptState.flt_n = Add(OptState.flt_n, 1)
        ReturnValue(0)
    }
}

Function.Optimize_FltConstDisp {
    Input: bits: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(OptState.flt_ready, 0) ThenBlock: { ReturnValue(0) }
        i = 0
        WhileLoop LessThan(i, OptState.flt_n) {
            have = Dereference(Add(OptState.flt_bits, Multiply(i, 8)))
            IfCondition EqualTo(have, bits) ThenBlock: {
                ReturnValue(Dereference(Add(OptState.flt_disp, Multiply(i, 8))))
            }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

Function.Optimize_FltConstWalk {
    Input: node: Address
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        t = AST_GetType(node)
        IfCondition EqualTo(Optimize_FoldIsFn(t), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(t, AST.CALL) ThenBlock: {
            opk = Optimize_FltOpKind(AST_GetData1(node))
            legal = 0
            IfCondition EqualTo(opk, 1) ThenBlock: { legal = 1 }
            IfCondition EqualTo(opk, 2) ThenBlock: { legal = 1 }
            IfCondition EqualTo(opk, 3) ThenBlock: { legal = 1 }
            IfCondition EqualTo(legal, 1) ThenBlock: {
                IfCondition EqualTo(AST_GetChildCount(node), 2) ThenBlock: {
                    s = 0
                    WhileLoop LessThan(s, 2) {
                        ch = AST_GetChild(node, s)
                        IfCondition NotEqual(ch, 0) ThenBlock: {
                            IfCondition EqualTo(AST_GetType(ch), AST.NUMBER) ThenBlock: {
                                Optimize_FltConstNote(StringToNumber(AST_GetData1(ch)))
                            }
                        }
                        s = Add(s, 1)
                    }
                }
            }
        }
        count = AST_GetChildCount(node)
        i = 0
        WhileLoop LessThan(i, count) {
            Optimize_FltConstWalk(AST_GetChild(node, i))
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

Function.Optimize_FltConstPlan {
    Input: body: Address
    Input: is_leaf: Integer
    Output: Integer
    Body: {
        IfCondition GreaterThan(OptState.flt_skip, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(is_leaf, 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(body, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_FoldIsFn(AST_GetType(body)), 1) ThenBlock: {
            c = AST_GetChildCount(body)
            i = 0
            WhileLoop LessThan(i, c) {
                Optimize_FltConstWalk(AST_GetChild(body, i))
                i = Add(i, 1)
            }
            ReturnValue(OptState.flt_n)
        }
        Optimize_FltConstWalk(body)
        ReturnValue(OptState.flt_n)
    }
}

Function.Optimize_FltConstEmit {
    Body: {
        IfCondition GreaterThan(OptState.flt_skip, 0) ThenBlock: { ReturnValue(0) }
        i = 0
        WhileLoop LessThan(i, OptState.flt_n) {
            Compile.stack_offset = Add(Compile.stack_offset, 8)
            disp = Subtract(0, Compile.stack_offset)
            bits = Dereference(Add(OptState.flt_bits, Multiply(i, 8)))
            StoreValue(Add(OptState.flt_disp, Multiply(i, 8)), disp)
            Emit_MovRaxImm64(bits)
            Emit_MovRbpOffsetRax(disp)
            i = Add(i, 1)
        }
        OptState.flt_ready = 1
        ReturnValue(0)
    }
}

Function.Optimize_IdentCount {
    Input: node: Address
    Input: name: Address
    Output: Integer
    Body: {
        LoopHome.mention_count = 0
        Optimize_CountWalk(node, name)
        ReturnValue(LoopHome.mention_count)
    }
}

Function.Optimize_ConstTempQual {
    Input: value: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(value, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(value), AST.CALL) ThenBlock: { ReturnValue(0) }
        opk = Optimize_FltOpKind(AST_GetData1(value))
        legal = 0
        IfCondition EqualTo(opk, 1) ThenBlock: { legal = 1 }
        IfCondition EqualTo(opk, 2) ThenBlock: { legal = 1 }
        IfCondition EqualTo(opk, 3) ThenBlock: { legal = 1 }
        IfCondition EqualTo(legal, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetChildCount(value), 2) ThenBlock: { ReturnValue(0) }
        saw = 0
        s = 0
        WhileLoop LessThan(s, 2) {
            ch = AST_GetChild(value, s)
            IfCondition EqualTo(ch, 0) ThenBlock: { ReturnValue(0) }
            ct = AST_GetType(ch)
            ok = 0
            IfCondition EqualTo(ct, AST.IDENTIFIER) ThenBlock: { ok = 1 }
            IfCondition EqualTo(ct, AST.NUMBER) ThenBlock: {
                disp = Optimize_FltConstDisp(StringToNumber(AST_GetData1(ch)))
                IfCondition LessThan(disp, 0) ThenBlock: {
                    ok = 1
                    saw = 1
                }
            }
            IfCondition EqualTo(ok, 0) ThenBlock: { ReturnValue(0) }
            s = Add(s, 1)
        }
        ReturnValue(saw)
    }
}

Function.Optimize_ConstTempCtrl {
    Input: t: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(t, AST.IF) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(t, AST.FORK) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(t, AST.SWITCH) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(t, AST.BRANCH) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(t, AST.TRY) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(Optimize_FoldIsLoop(t), 1) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

Function.Optimize_ConstTempInside {
    Input: node: Address
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(1) }
        t = AST_GetType(node)
        IfCondition EqualTo(Optimize_FoldIsFn(t), 1) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(Optimize_FoldIsBlock(node), 1) ThenBlock: {
            ReturnValue(Optimize_ConstTempBlock(node, name))
        }
        IfCondition EqualTo(t, AST.ASSIGNMENT) ThenBlock: {
            IfCondition EqualTo(AST_GetData2(node), 0) ThenBlock: {
                IfCondition EqualTo(Optimize_NameEq(AST_GetData1(node), name), 1) ThenBlock: { ReturnValue(0) }
            }
        }
        IfCondition EqualTo(t, AST.IDENTIFIER) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(AST_GetData1(node), name), 1) ThenBlock: { ReturnValue(0) }
        }
        count = AST_GetChildCount(node)
        i = 0
        WhileLoop LessThan(i, count) {
            IfCondition EqualTo(Optimize_ConstTempInside(AST_GetChild(node, i), name), 0) ThenBlock: { ReturnValue(0) }
            i = Add(i, 1)
        }
        ReturnValue(1)
    }
}

Function.Optimize_ConstTempBlock {
    Input: block: Address
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(block, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_FoldIsBlock(block), 0) ThenBlock: { ReturnValue(0) }
        pending = 0
        count = AST_GetChildCount(block)
        i = 0
        WhileLoop LessThan(i, count) {
            st = AST_GetChild(block, i)
            IfCondition NotEqual(st, 0) ThenBlock: {
                t = AST_GetType(st)
                handled = 0
                IfCondition EqualTo(t, AST.INDEX_ASSIGN) ThenBlock: {
                    IfCondition EqualTo(Optimize_NameEq(AST_GetData1(st), name), 1) ThenBlock: { ReturnValue(0) }
                }
                IfCondition EqualTo(t, AST.ASSIGNMENT) ThenBlock: {
                    IfCondition EqualTo(Optimize_NameEq(AST_GetData1(st), name), 1) ThenBlock: {
                        IfCondition NotEqual(AST_GetData2(st), 0) ThenBlock: { ReturnValue(0) }
                        rhs = AST_GetChild(st, 0)
                        IfCondition EqualTo(Optimize_ConstTempQual(rhs), 0) ThenBlock: { ReturnValue(0) }
                        IfCondition EqualTo(Optimize_TreeHasIdent(rhs, name), 1) ThenBlock: { ReturnValue(0) }
                        IfCondition EqualTo(pending, 1) ThenBlock: { ReturnValue(0) }
                        pending = 1
                        OptState.flt_saw = Add(OptState.flt_saw, 1)
                        handled = 1
                    }
                }
                IfCondition EqualTo(handled, 0) ThenBlock: {
                    IfCondition EqualTo(Optimize_FoldIsBlock(st), 1) ThenBlock: {
                        IfCondition EqualTo(pending, 1) ThenBlock: { ReturnValue(0) }
                        IfCondition EqualTo(Optimize_ConstTempBlock(st, name), 0) ThenBlock: { ReturnValue(0) }
                        handled = 1
                    }
                }
                IfCondition EqualTo(handled, 0) ThenBlock: {
                    IfCondition EqualTo(Optimize_ConstTempCtrl(t), 1) ThenBlock: {
                        IfCondition EqualTo(pending, 1) ThenBlock: {
                            IfCondition EqualTo(Optimize_TreeHasIdent(st, name), 1) ThenBlock: { ReturnValue(0) }
                        }
                        IfCondition EqualTo(pending, 0) ThenBlock: {
                            IfCondition EqualTo(Optimize_ConstTempInside(st, name), 0) ThenBlock: { ReturnValue(0) }
                        }
                        handled = 1
                    }
                }
                IfCondition EqualTo(handled, 0) ThenBlock: {
                    IfCondition EqualTo(Optimize_TreeHasIdent(st, name), 1) ThenBlock: {
                        IfCondition EqualTo(pending, 0) ThenBlock: { ReturnValue(0) }
                        IfCondition NotEqual(Optimize_IdentCount(st, name), 1) ThenBlock: { ReturnValue(0) }
                        pending = 0
                    }
                }
            }
            i = Add(i, 1)
        }
        IfCondition EqualTo(pending, 1) ThenBlock: { ReturnValue(0) }
        ReturnValue(1)
    }
}

Function.Optimize_ConstTempSkip {
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(OptState.flt_ready, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(LoopHome.body, 0) ThenBlock: { ReturnValue(0) }
        OptState.flt_saw = 0
        IfCondition EqualTo(Optimize_ConstTempBlock(LoopHome.body, name), 0) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(OptState.flt_saw, 1) ThenBlock: { ReturnValue(0) }
        ReturnValue(1)
    }
}

// Product of a slotted constant into xmm0, held for the one use in this block.
// Subtraction stays left then right. A held right operand is parked in xmm1
// before the left load, because the load uses xmm0.

Function.Optimize_TryFltConst {
    Input: target: Address
    Input: value: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(LoopHome.active, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_IsIntHome(target), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_IsFltHome(target), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_IsAccHome(target), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(value, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(value), AST.CALL) ThenBlock: { ReturnValue(0) }
        opk = Optimize_FltOpKind(AST_GetData1(value))
        legal = 0
        IfCondition EqualTo(opk, 1) ThenBlock: { legal = 1 }
        IfCondition EqualTo(opk, 2) ThenBlock: { legal = 1 }
        IfCondition EqualTo(opk, 3) ThenBlock: { legal = 1 }
        IfCondition EqualTo(legal, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetChildCount(value), 2) ThenBlock: { ReturnValue(0) }
        Optimize_OpClass(AST_GetChild(value, 0))
        c0 = LoopHome.hit_class
        d0 = LoopHome.hit_disp
        x0 = LoopHome.hit_xmm
        Optimize_OpClass(AST_GetChild(value, 1))
        c1 = LoopHome.hit_class
        d1 = LoopHome.hit_disp
        x1 = LoopHome.hit_xmm
        IfCondition EqualTo(Optimize_FltSrcOk(c0), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_FltSrcOk(c1), 0) ThenBlock: { ReturnValue(0) }
        saw8 = 0
        IfCondition EqualTo(c0, 8) ThenBlock: { saw8 = 1 }
        IfCondition EqualTo(c1, 8) ThenBlock: { saw8 = 1 }
        IfCondition EqualTo(saw8, 0) ThenBlock: { ReturnValue(0) }
        hold_ok = Optimize_HoldHere(target, value)
        IfCondition EqualTo(hold_ok, 0) ThenBlock: { hold_ok = Optimize_HoldArm(target, value) }
        IfCondition EqualTo(hold_ok, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(LoopHome.hold_on, 1) ThenBlock: {
            uses = 0
            IfCondition EqualTo(c0, 3) ThenBlock: { uses = 1 }
            IfCondition EqualTo(c1, 3) ThenBlock: { uses = 1 }
            IfCondition EqualTo(uses, 0) ThenBlock: { Optimize_FlushHold() }
        }
        IfCondition EqualTo(c1, 3) ThenBlock: {
            Emit_HomeMove(37, 0)
            Optimize_FltHomeOp(0, c0, d0, x0, 16)
            IfCondition EqualTo(opk, 1) ThenBlock: { Emit_HomeMove(38, 0) }
            IfCondition EqualTo(opk, 2) ThenBlock: { Emit_HomeMove(39, 0) }
            IfCondition EqualTo(opk, 3) ThenBlock: { Emit_HomeMove(40, 0) }
        }
        IfCondition NotEqual(c1, 3) ThenBlock: {
            opc = 88
            IfCondition EqualTo(opk, 2) ThenBlock: { opc = 92 }
            IfCondition EqualTo(opk, 3) ThenBlock: { opc = 89 }
            Optimize_FltHomeOp(0, c0, d0, x0, 16)
            Optimize_FltHomeOp(0, c1, d1, x1, opc)
        }
        LoopHome.hold_on = 1
        LoopHome.hold_name = target
        ReturnValue(1)
    }
}

// A later Branch on the same identifier can use constants an earlier Branch
// on that identifier already chose. Keys match by number or by Default.
// A non-number case does not match. The parent env stays poisoned.

Function.Optimize_FoldFree2 {
    Input: a: Address
    Input: b: Address
    Body: {
        Optimize_FoldFree(a)
        Optimize_FoldFree(b)
        ReturnValue(0)
    }
}

Function.Optimize_FoldSinkEnd {
    Input: key_k: Address
    Input: key_v: Address
    Input: between: Address
    Input: saved: Address
    Body: {
        OptState.fold_between = saved
        Optimize_FoldFree(between)
        Optimize_FoldFree2(key_k, key_v)
        ReturnValue(0)
    }
}

Function.Optimize_FoldScrut {
    Input: stmt: Address
    Output: Address
    Body: {
        IfCondition EqualTo(stmt, 0) ThenBlock: { ReturnValue(0) }
        t = AST_GetType(stmt)
        branch = 0
        IfCondition EqualTo(t, AST.SWITCH) ThenBlock: { branch = 1 }
        IfCondition EqualTo(t, AST.BRANCH) ThenBlock: { branch = 1 }
        IfCondition EqualTo(branch, 0) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(AST_GetChildCount(stmt), 1) ThenBlock: { ReturnValue(0) }
        scr = AST_GetChild(stmt, 0)
        IfCondition EqualTo(scr, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(scr), AST.IDENTIFIER) ThenBlock: { ReturnValue(0) }
        ReturnValue(AST_GetData1(scr))
    }
}

Function.Optimize_FoldPrior {
    Input: block: Address
    Input: index: Integer
    Input: stmt: Address
    Input: between: Address
    Output: Address
    Body: {
        want = Optimize_FoldScrut(stmt)
        IfCondition EqualTo(want, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(block, 0) ThenBlock: { ReturnValue(0) }
        p = Subtract(index, 1)
        WhileLoop GreaterEqual(p, 0) {
            st = AST_GetChild(block, p)
            nm = Optimize_FoldSimple(st)
            IfCondition NotEqual(nm, 0) ThenBlock: {
                IfCondition EqualTo(Optimize_NameEq(nm, want), 1) ThenBlock: { ReturnValue(0) }
                IfCondition EqualTo(between, 0) ThenBlock: { ReturnValue(0) }
                IfCondition EqualTo(Optimize_FoldListed(between, nm), 0) ThenBlock: {
                    IfCondition GreaterEqual(Array.Size(between), 32) ThenBlock: { ReturnValue(0) }
                    Array.Push(between, nm)
                }
            }
            IfCondition EqualTo(nm, 0) ThenBlock: {
                got = Optimize_FoldScrut(st)
                IfCondition EqualTo(got, 0) ThenBlock: { ReturnValue(0) }
                IfCondition EqualTo(Optimize_NameEq(got, want), 0) ThenBlock: { ReturnValue(0) }
                ReturnValue(st)
            }
            p = Subtract(p, 1)
        }
        ReturnValue(0)
    }
}

Function.Optimize_FoldKeys {
    Input: stmt: Address
    Input: key_k: Address
    Input: key_v: Address
    Body: {
        IfCondition EqualTo(stmt, 0) ThenBlock: { ReturnValue(0) }
        count = AST_GetChildCount(stmt)
        i = 1
        WhileLoop LessThan(i, count) {
            ch = AST_GetChild(stmt, i)
            IfCondition NotEqual(ch, 0) ThenBlock: {
                ct = AST_GetType(ch)
                IfCondition EqualTo(ct, AST.CASE) ThenBlock: {
                    kk = 0
                    kv = 0
                    IfCondition GreaterEqual(AST_GetChildCount(ch), 1) ThenBlock: {
                        key = AST_GetChild(ch, 0)
                        IfCondition NotEqual(key, 0) ThenBlock: {
                            IfCondition EqualTo(AST_GetType(key), AST.NUMBER) ThenBlock: {
                                kk = 1
                                kv = StringToNumber(AST_GetData1(key))
                            }
                        }
                    }
                    Array.Push(key_k, kk)
                    Array.Push(key_v, kv)
                }
                IfCondition EqualTo(ct, AST.DEFAULT) ThenBlock: {
                    Array.Push(key_k, 2)
                    Array.Push(key_v, 0)
                }
            }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

Function.Optimize_FoldImportNames {
    Input: prior: Address
    Input: cands: Address
    Body: {
        IfCondition EqualTo(prior, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(cands, 0) ThenBlock: { ReturnValue(0) }
        arms = Array.Create(4)
        IfCondition EqualTo(Optimize_FoldGather(prior, arms), 0) ThenBlock: {
            Optimize_FoldFree(arms)
            ReturnValue(0)
        }
        a = 0
        ac = Array.Size(arms)
        WhileLoop LessThan(a, ac) {
            Optimize_FoldCollect(Array.Get(arms, a), cands)
            a = Add(a, 1)
        }
        Optimize_FoldFree(arms)
        ReturnValue(0)
    }
}

Function.Optimize_FoldImport {
    Input: prior: Address
    Input: kk: Integer
    Input: kv: Integer
    Input: dn: Address
    Input: dk: Address
    Input: dv: Address
    Body: {
        IfCondition EqualTo(prior, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(kk, 0) ThenBlock: { ReturnValue(0) }
        arms = Array.Create(4)
        kks = Array.Create(4)
        kvs = Array.Create(4)
        IfCondition EqualTo(Optimize_FoldGather(prior, arms), 0) ThenBlock: {
            Optimize_FoldFree(arms)
            Optimize_FoldFree(kks)
            Optimize_FoldFree(kvs)
            ReturnValue(0)
        }
        Optimize_FoldKeys(prior, kks, kvs)
        found = -1
        a = 0
        ac = Array.Size(arms)
        WhileLoop LessThan(a, ac) {
            IfCondition LessThan(a, Array.Size(kks)) ThenBlock: {
                ak = Array.Get(kks, a)
                av = Array.Get(kvs, a)
                match = 0
                IfCondition EqualTo(kk, 2) ThenBlock: {
                    IfCondition EqualTo(ak, 2) ThenBlock: { match = 1 }
                }
                IfCondition EqualTo(kk, 1) ThenBlock: {
                    IfCondition EqualTo(ak, 1) ThenBlock: {
                        IfCondition EqualTo(kv, av) ThenBlock: { match = 1 }
                    }
                }
                IfCondition EqualTo(match, 1) ThenBlock: {
                    found = a
                    a = ac
                }
            }
            a = Add(a, 1)
        }
        IfCondition LessThan(found, 0) ThenBlock: {
            Optimize_FoldFree(arms)
            Optimize_FoldFree(kks)
            Optimize_FoldFree(kvs)
            ReturnValue(0)
        }
        body = Array.Get(arms, found)
        cands = Array.Create(4)
        Optimize_FoldCollect(body, cands)
        tn = Array.Create(8)
        tk = Array.Create(8)
        tv = Array.Create(8)
        Optimize_FoldDup(tn, tk, tv, dn, dk, dv)
        Optimize_FoldArm(body, tn, tk, tv)
        j = 0
        jc = Array.Size(cands)
        WhileLoop LessThan(j, jc) {
            nm = Array.Get(cands, j)
            Optimize_FoldLookup(tn, tk, tv, nm, 0)
            keepk = FoldHold.kind
            keepv = FoldHold.val
            listed = Optimize_FoldListed(OptState.fold_between, nm)
            IfCondition EqualTo(listed, 0) ThenBlock: {
                IfCondition EqualTo(keepk, 1) ThenBlock: {
                    Optimize_FoldForce(dn, dk, dv, nm, keepk, keepv)
                }
                IfCondition EqualTo(keepk, 2) ThenBlock: {
                    Optimize_FoldForce(dn, dk, dv, nm, keepk, keepv)
                }
            }
            j = Add(j, 1)
        }
        Optimize_FoldFree(tn)
        Optimize_FoldFree(tk)
        Optimize_FoldFree(tv)
        Optimize_FoldFree(cands)
        Optimize_FoldFree(arms)
        Optimize_FoldFree(kks)
        Optimize_FoldFree(kvs)
        ReturnValue(0)
    }
}

Function.Optimize_FoldSink {
    Input: block: Address
    Input: index: Integer
    Input: stmt: Address
    Input: names: Address
    Input: kinds: Address
    Input: vals: Address
    Body: {
        arms = Array.Create(8)
        can = Optimize_FoldGather(stmt, arms)
        IfCondition EqualTo(can, 0) ThenBlock: {
            dn = Array.Create(8)
            dk = Array.Create(8)
            dv = Array.Create(8)
            Optimize_FoldDup(dn, dk, dv, names, kinds, vals)
            Optimize_FoldWalkInside(stmt, dn, dk, dv)
            Optimize_FoldFree6(arms, dn, dk, dv, 0, 0)
            ReturnValue(0)
        }
        key_k = Array.Create(8)
        key_v = Array.Create(8)
        between = Array.Create(8)
        saved_between = OptState.fold_between
        prior = 0
        IfCondition NotEqual(Optimize_FoldScrut(stmt), 0) ThenBlock: {
            Optimize_FoldKeys(stmt, key_k, key_v)
            prior = Optimize_FoldPrior(block, index, stmt, between)
        }
        acount = Array.Size(arms)
        a = 0
        WhileLoop LessThan(a, acount) {
            dn = Array.Create(8)
            dk = Array.Create(8)
            dv = Array.Create(8)
            Optimize_FoldDup(dn, dk, dv, names, kinds, vals)
            Optimize_FoldWalkBlock(Array.Get(arms, a), dn, dk, dv)
            Optimize_FoldFree(dn)
            Optimize_FoldFree(dk)
            Optimize_FoldFree(dv)
            a = Add(a, 1)
        }
        IfCondition EqualTo(FoldHold.stop, 1) ThenBlock: {
            Optimize_FoldSinkEnd(key_k, key_v, between, saved_between)
            Optimize_FoldFree(arms)
            ReturnValue(0)
        }
        cands = Array.Create(8)
        overflow = 0
        a = 0
        WhileLoop LessThan(a, acount) {
            IfCondition EqualTo(Optimize_FoldCollect(Array.Get(arms, a), cands), 1) ThenBlock: {
                overflow = 1
            }
            a = Add(a, 1)
        }
        IfCondition EqualTo(overflow, 0) ThenBlock: {
            Optimize_FoldImportNames(prior, cands)
        }
        jcount = Array.Size(cands)
        IfCondition EqualTo(overflow, 1) ThenBlock: { jcount = 0 }
        IfCondition LessThan(jcount, 1) ThenBlock: {
            Optimize_FoldSinkEnd(key_k, key_v, between, saved_between)
            Optimize_FoldFree6(arms, cands, 0, 0, 0, 0)
            ReturnValue(0)
        }
        OptState.fold_between = between
        flat_k = Array.Create(32)
        flat_v = Array.Create(32)
        a = 0
        WhileLoop LessThan(a, acount) {
            dn = Array.Create(8)
            dk = Array.Create(8)
            dv = Array.Create(8)
            Optimize_FoldDup(dn, dk, dv, names, kinds, vals)
            IfCondition NotEqual(prior, 0) ThenBlock: {
                IfCondition EqualTo(Array.Size(key_k), acount) ThenBlock: {
                    Optimize_FoldImport(prior, Array.Get(key_k, a), Array.Get(key_v, a), dn, dk, dv)
                }
            }
            Optimize_FoldArm(Array.Get(arms, a), dn, dk, dv)
            j = 0
            WhileLoop LessThan(j, jcount) {
                Optimize_FoldLookup(dn, dk, dv, Array.Get(cands, j), 0)
                fk = FoldHold.kind
                fv = FoldHold.val
                IfCondition NotEqual(fk, 1) ThenBlock: {
                    IfCondition NotEqual(fk, 2) ThenBlock: { fk = 0 }
                }
                Array.Push(flat_k, fk)
                Array.Push(flat_v, fv)
                j = Add(j, 1)
            }
            Optimize_FoldFree(dn)
            Optimize_FoldFree(dk)
            Optimize_FoldFree(dv)
            a = Add(a, 1)
        }
        keep = Array.Create(8)
        j = 0
        WhileLoop LessThan(j, jcount) {
            ok = 1
            a = 0
            WhileLoop LessThan(a, acount) {
                fk = Array.Get(flat_k, Add(Multiply(a, jcount), j))
                IfCondition NotEqual(fk, 1) ThenBlock: {
                    IfCondition NotEqual(fk, 2) ThenBlock: { ok = 0 }
                }
                a = Add(a, 1)
            }
            IfCondition EqualTo(ok, 1) ThenBlock: {
                Array.Push(keep, j)
            }
            j = Add(j, 1)
        }
        join_n = Array.Size(keep)
        IfCondition LessThan(join_n, 1) ThenBlock: {
            Optimize_FoldSinkEnd(key_k, key_v, between, saved_between)
            Optimize_FoldFree6(arms, cands, flat_k, flat_v, keep, 0)
            ReturnValue(0)
        }
        dep = Array.Create(8)
        j = 0
        WhileLoop LessThan(j, join_n) {
            Array.Push(dep, Array.Get(cands, Array.Get(keep, j)))
            j = Add(j, 1)
        }
        pref = Array.Create(8)
        bcount = AST_GetChildCount(block)
        k = Add(index, 1)
        WhileLoop LessThan(Array.Size(pref), 8) {
            IfCondition GreaterEqual(k, bcount) ThenBlock: { ExitLoop }
            st = AST_GetChild(block, k)
            nm = Optimize_FoldSimple(st)
            take = 0
            IfCondition NotEqual(nm, 0) ThenBlock: {
                rhs = AST_GetChild(st, 0)
                IfCondition EqualTo(Optimize_FoldPure(rhs), 1) ThenBlock: {
                    IfCondition EqualTo(Optimize_FoldHit(rhs, dep, 0, Array.Size(dep)), 1) ThenBlock: {
                        take = 1
                    }
                }
            }
            IfCondition EqualTo(take, 0) ThenBlock: { ExitLoop }
            Array.Push(pref, k)
            Array.Push(dep, nm)
            k = Add(k, 1)
        }
        len = Array.Size(pref)
        done = 0
        WhileLoop EqualTo(done, 0) {
            IfCondition LessEqual(len, 0) ThenBlock: { done = 1 }
            IfCondition GreaterThan(len, 0) ThenBlock: {
                bad = 0
                j = Add(Array.Get(pref, Subtract(len, 1)), 1)
                WhileLoop LessThan(j, bcount) {
                    IfCondition EqualTo(Optimize_FoldHit(AST_GetChild(block, j), dep, join_n, len), 1) ThenBlock: {
                        bad = 1
                    }
                    j = Add(j, 1)
                }
                IfCondition EqualTo(bad, 0) ThenBlock: { done = 1 }
                IfCondition EqualTo(bad, 1) ThenBlock: { len = Subtract(len, 1) }
            }
        }
        IfCondition LessEqual(len, 0) ThenBlock: {
            Optimize_FoldFree(pref)
            Optimize_FoldSinkEnd(key_k, key_v, between, saved_between)
            Optimize_FoldFree6(arms, cands, flat_k, flat_v, keep, dep)
            ReturnValue(0)
        }
        IfCondition EqualTo(FoldHold.stop, 1) ThenBlock: {
            Optimize_FoldFree(pref)
            Optimize_FoldSinkEnd(key_k, key_v, between, saved_between)
            Optimize_FoldFree6(arms, cands, flat_k, flat_v, keep, dep)
            ReturnValue(0)
        }
        IfCondition GreaterThan(Array.Size(names), 480) ThenBlock: {
            Optimize_FoldFree(pref)
            Optimize_FoldSinkEnd(key_k, key_v, between, saved_between)
            Optimize_FoldFree6(arms, cands, flat_k, flat_v, keep, dep)
            ReturnValue(0)
        }
        a = 0
        WhileLoop LessThan(a, acount) {
            dn = Array.Create(16)
            dk = Array.Create(16)
            dv = Array.Create(16)
            Optimize_FoldDup(dn, dk, dv, names, kinds, vals)
            j = 0
            WhileLoop LessThan(j, join_n) {
                srcj = Array.Get(keep, j)
                fk = Array.Get(flat_k, Add(Multiply(a, jcount), srcj))
                fv = Array.Get(flat_v, Add(Multiply(a, jcount), srcj))
                Optimize_FoldForce(dn, dk, dv, Array.Get(cands, srcj), fk, fv)
                j = Add(j, 1)
            }
            m = 0
            WhileLoop LessThan(m, len) {
                st = AST_GetChild(block, Array.Get(pref, m))
                tname = AST_GetData1(st)
                cloned = Optimize_InlineClone(AST_GetChild(st, 0), 0)
                rewritten = Optimize_FoldSubst(cloned, dn, dk, dv)
                Optimize_FoldValue(rewritten, dn, dk, dv, 0)
                ck = FoldHold.kind
                cv = FoldHold.val
                IfCondition EqualTo(ck, 1) ThenBlock: {
                    Optimize_FoldForce(dn, dk, dv, tname, 1, cv)
                }
                IfCondition EqualTo(ck, 2) ThenBlock: {
                    Optimize_FoldForce(dn, dk, dv, tname, 2, cv)
                }
                IfCondition NotEqual(ck, 1) ThenBlock: {
                    IfCondition NotEqual(ck, 2) ThenBlock: {
                        IfCondition EqualTo(rewritten, 0) ThenBlock: {
                            Optimize_FoldForce(dn, dk, dv, tname, 0, 0)
                        }
                        IfCondition NotEqual(rewritten, 0) ThenBlock: {
                            IfCondition EqualTo(AST_GetType(rewritten), AST.IDENTIFIER) ThenBlock: {
                                Optimize_FoldForce(dn, dk, dv, tname, 3, AST_GetData1(rewritten))
                            }
                            IfCondition NotEqual(AST_GetType(rewritten), AST.IDENTIFIER) ThenBlock: {
                                asg = AST_MakeAssignment(tname, rewritten)
                                AST_SetLine(asg, AST_GetLine(st))
                                AST_SetCol(asg, AST_GetCol(st))
                                AST_AddChild(Array.Get(arms, a), asg)
                                Optimize_FoldForce(dn, dk, dv, tname, 0, 0)
                            }
                        }
                    }
                }
                m = Add(m, 1)
            }
            Optimize_FoldFree(dn)
            Optimize_FoldFree(dk)
            Optimize_FoldFree(dv)
            a = Add(a, 1)
        }
        children = AST_GetChildren(block)
        m = Subtract(len, 1)
        WhileLoop GreaterEqual(m, 0) {
            Array.Delete(children, Array.Get(pref, m))
            m = Subtract(m, 1)
        }
        Optimize_FoldFree(pref)
        Optimize_FoldSinkEnd(key_k, key_v, between, saved_between)
            Optimize_FoldFree6(arms, cands, flat_k, flat_v, keep, dep)
        ReturnValue(0)
    }
}

Function.Optimize_FoldWalkInside {
    Input: node: Address
    Input: names: Address
    Input: kinds: Address
    Input: vals: Address
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        t = AST_GetType(node)
        IfCondition EqualTo(Optimize_FoldIsFn(t), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_FoldIsBlock(node), 1) ThenBlock: {
            Optimize_FoldWalkBlock(node, names, kinds, vals)
            ReturnValue(0)
        }
        count = AST_GetChildCount(node)
        i = 0
        WhileLoop LessThan(i, count) {
            Optimize_FoldWalkInside(AST_GetChild(node, i), names, kinds, vals)
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

Function.Optimize_FoldWalkBlock {
    Input: block: Address
    Input: names: Address
    Input: kinds: Address
    Input: vals: Address
    Body: {
        IfCondition EqualTo(block, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_FoldIsBlock(block), 0) ThenBlock: { ReturnValue(0) }
        i = 0
        count = AST_GetChildCount(block)
        WhileLoop LessThan(i, count) {
            stmt = AST_GetChild(block, i)
            st = AST_GetType(stmt)
            IfCondition EqualTo(Optimize_FoldIsBlock(stmt), 1) ThenBlock: {
                Optimize_FoldWalkBlock(stmt, names, kinds, vals)
            }
            IfCondition EqualTo(Optimize_FoldIsLoop(st), 1) ThenBlock: {
                dn = Array.Create(8)
                dk = Array.Create(8)
                dv = Array.Create(8)
                Optimize_FoldDup(dn, dk, dv, names, kinds, vals)
                Optimize_FoldPoison(stmt, dn, dk, dv)
                Optimize_FoldWalkInside(stmt, dn, dk, dv)
                Optimize_FoldFree(dn)
                Optimize_FoldFree(dk)
                Optimize_FoldFree(dv)
                Optimize_FoldPoison(stmt, names, kinds, vals)
            }
            IfCondition EqualTo(Optimize_FoldIsCtrl(st), 1) ThenBlock: {
                IfCondition EqualTo(Optimize_FoldIsLoop(st), 0) ThenBlock: {
                    Optimize_FoldSink(block, i, stmt, names, kinds, vals)
                    Optimize_FoldPoison(stmt, names, kinds, vals)
                }
            }
            IfCondition EqualTo(Optimize_FoldIsCtrl(st), 0) ThenBlock: {
                IfCondition EqualTo(Optimize_FoldIsBlock(stmt), 0) ThenBlock: {
                    nm = Optimize_FoldSimple(stmt)
                    IfCondition NotEqual(nm, 0) ThenBlock: {
                        Optimize_FoldValue(AST_GetChild(stmt, 0), names, kinds, vals, 0)
                        IfCondition EqualTo(FoldHold.kind, 1) ThenBlock: {
                            Optimize_FoldPut(names, kinds, vals, nm, 1, FoldHold.val)
                        }
                        IfCondition EqualTo(FoldHold.kind, 2) ThenBlock: {
                            Optimize_FoldPut(names, kinds, vals, nm, 2, FoldHold.val)
                        }
                        IfCondition NotEqual(FoldHold.kind, 1) ThenBlock: {
                            IfCondition NotEqual(FoldHold.kind, 2) ThenBlock: {
                                Optimize_FoldPut(names, kinds, vals, nm, 0, 0)
                            }
                        }
                    }
                    IfCondition EqualTo(nm, 0) ThenBlock: {
                        Optimize_FoldWalkInside(stmt, names, kinds, vals)
                    }
                }
            }
            count = AST_GetChildCount(block)
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

Function.Optimize_FoldDots {
    Input: node: Address
    Input: dest: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        t = AST_GetType(node)
        IfCondition EqualTo(Optimize_FoldIsFn(t), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(t, AST.ASSIGNMENT) ThenBlock: {
            IfCondition EqualTo(AST_GetData2(node), 0) ThenBlock: {
                nm = AST_GetData1(node)
                IfCondition EqualTo(Optimize_FoldDot(nm), 1) ThenBlock: {
                    have = 0
                    j = 0
                    n = Array.Size(dest)
                    WhileLoop LessThan(j, n) {
                        IfCondition EqualTo(Optimize_NameEq(Array.Get(dest, j), nm), 1) ThenBlock: {
                            have = 1
                            ExitLoop
                        }
                        j = Add(j, 1)
                    }
                    IfCondition EqualTo(have, 0) ThenBlock: {
                        IfCondition GreaterEqual(n, 512) ThenBlock: { ReturnValue(1) }
                        Array.Push(dest, nm)
                    }
                }
            }
        }
        count = AST_GetChildCount(node)
        i = 0
        WhileLoop LessThan(i, count) {
            IfCondition EqualTo(Optimize_FoldDots(AST_GetChild(node, i), dest), 1) ThenBlock: {
                ReturnValue(1)
            }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

Function.Optimize_FoldListed {
    Input: names: Address
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(names, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }
        n = Array.Size(names)
        i = 0
        WhileLoop LessThan(i, n) {
            IfCondition EqualTo(Optimize_NameEq(Array.Get(names, i), name), 1) ThenBlock: {
                ReturnValue(1)
            }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

Function.Optimize_FoldFunction {
    Input: body: Address
    Body: {
        IfCondition EqualTo(body, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(OptState.pool_slot, 0) ThenBlock: { ReturnValue(0) }
        FoldHold.stop = 0
        names = Array.Create(32)
        kinds = Array.Create(32)
        vals = Array.Create(32)
        dots = Array.Create(8)
        skip = Optimize_FoldDots(body, dots)
        IfCondition EqualTo(skip, 0) ThenBlock: {
            n = Array.Size(OptState.pool_kinds)
            i = 0
            WhileLoop LessThan(i, n) {
                pk = Array.Get(OptState.pool_kinds, i)
                keep = 0
                IfCondition EqualTo(pk, 1) ThenBlock: { keep = 1 }
                IfCondition EqualTo(pk, 2) ThenBlock: { keep = 1 }
                IfCondition EqualTo(keep, 1) ThenBlock: {
                    pn = Array.Get(OptState.pool_names, i)
                    IfCondition EqualTo(Optimize_FoldListed(dots, pn), 0) ThenBlock: {
                        IfCondition LessThan(Array.Size(names), 512) ThenBlock: {
                            Array.Push(names, pn)
                            Array.Push(kinds, pk)
                            Array.Push(vals, Array.Get(OptState.pool_vals, i))
                        }
                    }
                }
                i = Add(i, 1)
            }
        }
        Optimize_FoldFree(dots)
        Optimize_FoldWalkBlock(body, names, kinds, vals)
        Optimize_FoldFree(names)
        Optimize_FoldFree(kinds)
        Optimize_FoldFree(vals)
        FoldHold.stop = 0
        ReturnValue(0)
    }
}