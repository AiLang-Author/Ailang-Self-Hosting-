// =============================================================================
// Library.CCompilerOptimizer.ailang
// =============================================================================
// Expression optimization - eliminates redundant push/pop sequences
// 
// STRATEGY: Pattern-match simple cases first, expand later.
// Start with Add/Multiply of two simple operands (numbers or variables).
// =============================================================================

LibraryImport.XArrays
LibraryImport.Compiler.Frontend.AST.CASTTypes
LibraryImport.Compiler.Frontend.AST.CASTCore
LibraryImport.Compiler.CodeEmit.CEmitCoreArch
LibraryImport.Compiler.Compile.Modules.CCompileScope

// =============================================================================
// OPTIMIZER STATE
// =============================================================================
FixedPool.OptState {
    "next_temp": Initialize=0, CanChange=True
    "debug": Initialize=1, CanChange=True
}

// =============================================================================
// ENTRY POINT: Try to optimize a simple Add
// Called from Compile_Expression when func_name == "Add"
// Returns 1 if optimized, 0 to fall back to standard path
// =============================================================================
Function.Optimize_Add {
    Input: node: Address
    Output: Integer
    Body: {
        // Check we have exactly 2 children
        arg_count = AST_GetChildCount(node)
        IfCondition NotEqual(arg_count, 2) ThenBlock: {
            ReturnValue(0)
        }
        
        arg0 = AST_GetChild(node, 0)
        arg1 = AST_GetChild(node, 1)
        
        type0 = AST_GetType(arg0)
        type1 = AST_GetType(arg1)
        
        // Only optimize if both args are simple (NUMBER or IDENTIFIER)
        is_simple0 = Or(EqualTo(type0, AST.NUMBER), EqualTo(type0, AST.IDENTIFIER))
        is_simple1 = Or(EqualTo(type1, AST.NUMBER), EqualTo(type1, AST.IDENTIFIER))
        
        IfCondition EqualTo(And(is_simple0, is_simple1), 0) ThenBlock: {
            // Not simple - let existing path handle it
            IfCondition EqualTo(OptState.debug, 1) ThenBlock: {
                PrintMessage("[OPT] Add has complex args, falling back\n")
            }
            ReturnValue(0)
        }
        
        IfCondition EqualTo(OptState.debug, 1) ThenBlock: {
            PrintMessage("[OPT] Optimizing simple Add\n")
        }
        
        // Load first arg into RAX
        IfCondition EqualTo(type0, AST.NUMBER) ThenBlock: {
            val = StringToNumber(AST_GetData1(arg0))
            IfCondition EqualTo(OptState.debug, 1) ThenBlock: {
                PrintMessage("[OPT]   arg0 is NUMBER: ")
                PrintNumber(val)
                PrintMessage("\n")
            }
            Emit_MovRaxImm64(val)
        } ElseBlock: {
            name0 = AST_GetData1(arg0)
            offset0 = Scope_Resolve(name0)
            resolve_type0 = Scope.resolve_type
            IfCondition EqualTo(OptState.debug, 1) ThenBlock: {
                PrintMessage("[OPT]   arg0 is VAR: ")
                PrintString(name0)
                PrintMessage(" offset=")
                PrintNumber(offset0)
                PrintMessage(" type=")
                PrintNumber(resolve_type0)
                PrintMessage("\n")
            }
            // Check if variable was found
            IfCondition EqualTo(resolve_type0, 0) ThenBlock: {
                PrintMessage("[OPT] ERROR: Variable not found, falling back\n")
                ReturnValue(0)
            }
            // Pool variable (type=3) uses R15, local/param uses RBP
            IfCondition EqualTo(resolve_type0, 3) ThenBlock: {
                pool_index0 = BitwiseAnd(offset0, 2147483647)
                pool_offset0 = Multiply(pool_index0, 8)
                Emit_MovRaxR15Offset(pool_offset0)
            } ElseBlock: {
                Emit_MovRaxRbpOffset(offset0)
            }
        }
        
        // Load second arg into RBX (no push needed!)
        IfCondition EqualTo(type1, AST.NUMBER) ThenBlock: {
            val = StringToNumber(AST_GetData1(arg1))
            IfCondition EqualTo(OptState.debug, 1) ThenBlock: {
                PrintMessage("[OPT]   arg1 is NUMBER: ")
                PrintNumber(val)
                PrintMessage("\n")
            }
            Emit_MovRbxImm64(val)
        } ElseBlock: {
            name1 = AST_GetData1(arg1)
            offset1 = Scope_Resolve(name1)
            resolve_type1 = Scope.resolve_type
            IfCondition EqualTo(OptState.debug, 1) ThenBlock: {
                PrintMessage("[OPT]   arg1 is VAR: ")
                PrintString(name1)
                PrintMessage(" offset=")
                PrintNumber(offset1)
                PrintMessage(" type=")
                PrintNumber(resolve_type1)
                PrintMessage("\n")
            }
            // Check if variable was found
            IfCondition EqualTo(resolve_type1, 0) ThenBlock: {
                PrintMessage("[OPT] ERROR: Variable not found, falling back\n")
                ReturnValue(0)
            }
            // Pool variable (type=3) uses R15, local/param uses RBP
            IfCondition EqualTo(resolve_type1, 3) ThenBlock: {
                pool_index1 = BitwiseAnd(offset1, 2147483647)
                pool_offset1 = Multiply(pool_index1, 8)
                Emit_MovRbxR15Offset(pool_offset1)
            } ElseBlock: {
                Emit_MovRbxRbpOffset(offset1)
            }
        }
        
        // ADD RAX, RBX - result in RAX
        Emit_AddRaxRbx()
        
        ReturnValue(1)
    }
}

// =============================================================================
// ENTRY POINT: Try to optimize a simple Subtract
// =============================================================================
Function.Optimize_Subtract {
    Input: node: Address
    Output: Integer
    Body: {
        arg_count = AST_GetChildCount(node)
        IfCondition NotEqual(arg_count, 2) ThenBlock: {
            ReturnValue(0)
        }
        
        arg0 = AST_GetChild(node, 0)
        arg1 = AST_GetChild(node, 1)
        
        type0 = AST_GetType(arg0)
        type1 = AST_GetType(arg1)
        
        is_simple0 = Or(EqualTo(type0, AST.NUMBER), EqualTo(type0, AST.IDENTIFIER))
        is_simple1 = Or(EqualTo(type1, AST.NUMBER), EqualTo(type1, AST.IDENTIFIER))
        
        IfCondition EqualTo(And(is_simple0, is_simple1), 0) ThenBlock: {
            ReturnValue(0)
        }
        
        IfCondition EqualTo(OptState.debug, 1) ThenBlock: {
            PrintMessage("[OPT] Optimizing simple Subtract\n")
        }
        
        // Load first arg into RAX
        IfCondition EqualTo(type0, AST.NUMBER) ThenBlock: {
            val = StringToNumber(AST_GetData1(arg0))
            Emit_MovRaxImm64(val)
        } ElseBlock: {
            name0 = AST_GetData1(arg0)
            offset0 = Scope_Resolve(name0)
            resolve_type0 = Scope.resolve_type
            IfCondition EqualTo(resolve_type0, 0) ThenBlock: {
                ReturnValue(0)
            }
            IfCondition EqualTo(resolve_type0, 3) ThenBlock: {
                pool_index0 = BitwiseAnd(offset0, 2147483647)
                pool_offset0 = Multiply(pool_index0, 8)
                Emit_MovRaxR15Offset(pool_offset0)
            } ElseBlock: {
                Emit_MovRaxRbpOffset(offset0)
            }
        }
        
        // Load second arg into RBX
        IfCondition EqualTo(type1, AST.NUMBER) ThenBlock: {
            val = StringToNumber(AST_GetData1(arg1))
            Emit_MovRbxImm64(val)
        } ElseBlock: {
            name1 = AST_GetData1(arg1)
            offset1 = Scope_Resolve(name1)
            resolve_type1 = Scope.resolve_type
            IfCondition EqualTo(resolve_type1, 0) ThenBlock: {
                ReturnValue(0)
            }
            IfCondition EqualTo(resolve_type1, 3) ThenBlock: {
                pool_index1 = BitwiseAnd(offset1, 2147483647)
                pool_offset1 = Multiply(pool_index1, 8)
                Emit_MovRbxR15Offset(pool_offset1)
            } ElseBlock: {
                Emit_MovRbxRbpOffset(offset1)
            }
        }
        
        // SUB RAX, RBX
        Emit_SubRaxRbx()
        
        ReturnValue(1)
    }
}

