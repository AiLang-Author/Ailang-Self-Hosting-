// Float homes still sitting in xmm after the loop spill.
FixedPool.XmmKeep {
    "n0": Initialize=0, CanChange=True
    "x0": Initialize=0, CanChange=True
    "n1": Initialize=0, CanChange=True
    "x1": Initialize=0, CanChange=True
    "n2": Initialize=0, CanChange=True
    "x2": Initialize=0, CanChange=True
    "n3": Initialize=0, CanChange=True
    "x3": Initialize=0, CanChange=True
    "n4": Initialize=0, CanChange=True
    "x4": Initialize=0, CanChange=True
    "n5": Initialize=0, CanChange=True
    "x5": Initialize=0, CanChange=True
}

// Float homes whose reaching def is +0.0. The loop pxors instead of
// reloading the frame. Cleared at every block, call, and if.
FixedPool.ZeroKeep {
    "n0": Initialize=0, CanChange=True
    "n1": Initialize=0, CanChange=True
    "n2": Initialize=0, CanChange=True
    "n3": Initialize=0, CanChange=True
    "n4": Initialize=0, CanChange=True
    "n5": Initialize=0, CanChange=True
}

// Scan state for a temp whose only readers are r9 stores.
FixedPool.IndexKeep {
    "uses": Initialize=0, CanChange=True
    "bad": Initialize=0, CanChange=True
}

// Deferred pin products. The pointer step runs, then every mulsd, then
// every addsd. Piledriver's two SSE pipes pair independent muls; an
// add between them occupies the second pipe.
FixedPool.PinDefer {
    "n": Initialize=0, CanChange=True
    "k0": Initialize=0, CanChange=True
    "a0": Initialize=0, CanChange=True
    "b0": Initialize=0, CanChange=True
    "c0": Initialize=0, CanChange=True
    "s0": Initialize=0, CanChange=True
    "k1": Initialize=0, CanChange=True
    "a1": Initialize=0, CanChange=True
    "b1": Initialize=0, CanChange=True
    "c1": Initialize=0, CanChange=True
    "s1": Initialize=0, CanChange=True
    "k2": Initialize=0, CanChange=True
    "a2": Initialize=0, CanChange=True
    "b2": Initialize=0, CanChange=True
    "c2": Initialize=0, CanChange=True
    "s2": Initialize=0, CanChange=True
    "k3": Initialize=0, CanChange=True
    "a3": Initialize=0, CanChange=True
    "b3": Initialize=0, CanChange=True
    "c3": Initialize=0, CanChange=True
    "s3": Initialize=0, CanChange=True
}

// Names the current loop keeps in registers. Rows live in recs.
// hit_class and hit_reg are the last Optimize_Loc answer.
FixedPool.AllocTab {
    "recs": Initialize=0, CanChange=True
    "n": Initialize=0, CanChange=True
    "hit_class": Initialize=0, CanChange=True
    "hit_reg": Initialize=-1, CanChange=True
}

// Effect bits on a tagged node. PURE is not inherited by a parent.
// Locals are ids 1..128 in the use words, not hardware registers.
FixedPool.TagBit {
    "MEM_READ": Initialize=1
    "MEM_WRITE": Initialize=2
    "CALL": Initialize=4
    "CLOBBER": Initialize=8
    "DIV": Initialize=16
    "DEREF": Initialize=32
    "ASM": Initialize=64
    "JUMP": Initialize=128
    "ESCAPE": Initialize=256
    "PURE": Initialize=512
    "STORE": Initialize=1024
}

// Side array parallel to the AST pool. One 32-byte record per slot:
// effects, def id, use bits 1..64, use bits 65..128.
// audit is -1 until the environ check, then 0 or 1.
// u0 and u1 are scratch for the walk of one node.
FixedPool.TagState {
    "buf": Initialize=0, CanChange=True
    "cap": Initialize=0, CanChange=True
    "names": Initialize=0, CanChange=True
    "nnames": Initialize=0, CanChange=True
    "over": Initialize=0, CanChange=True
    "audit": Initialize=-1, CanChange=True
    "u0": Initialize=0, CanChange=True
    "u1": Initialize=0, CanChange=True
    "def_id": Initialize=0, CanChange=True
    "nodes": Initialize=0, CanChange=True
    "miss_pure": Initialize=0, CanChange=True
    "miss_deref": Initialize=0, CanChange=True
    "miss_asm": Initialize=0, CanChange=True
    "miss_store": Initialize=0, CanChange=True
    "miss_jump": Initialize=0, CanChange=True
    "miss_clob": Initialize=0, CanChange=True
    "miss_use": Initialize=0, CanChange=True
    "miss_slot": Initialize=0, CanChange=True
}

Function.Optimize_SetDebug {
    Input: enabled: Integer
    Body: {
        OptState.debug = enabled
    }
}
