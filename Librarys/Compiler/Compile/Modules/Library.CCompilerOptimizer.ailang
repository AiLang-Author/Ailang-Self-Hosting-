    "bind_val": Initialize=0, CanChange=True
    "bind_seen": Initialize=0, CanChange=True
    "bind_late": Initialize=0, CanChange=True
    "bind_root": Initialize=0, CanChange=True
    "magic_m": Initialize=0, CanChange=True
    "magic_sh": Initialize=0, CanChange=True
    "magic_neg": Initialize=0, CanChange=True
    "divmod_mid": Initialize=-1, CanChange=True
    // 0: quotient is pushed until CommitQuot. 1: already in r12.
    // 2: already in r13. Set only for the open TryDivMod pair.
    "divmod_home": Initialize=0, CanChange=True
    // Non-negative facts taken from the AST. sites/from are the direct
    // calls recorded before any splice. poison is AddressOf of that name.
    // cache/visit are cleared around each function body so a fold cannot
    // reuse a pre-fold answer. 1 proved, 2 refused.
    "nn_sites": Initialize=0, CanChange=True
    "nn_from": Initialize=0, CanChange=True
    "nn_poison": Initialize=0, CanChange=True
    "nn_cache": Initialize=0, CanChange=True
    "nn_visit": Initialize=0, CanChange=True
    "nn_ready": Initialize=0, CanChange=True
    "nn_ast": Initialize=0, CanChange=True
}

// kind: 0 poisoned, 1 integer, 2 float bits, 3 name alias, 4 not known yet
FixedPool.FoldHold {
    "kind": Initialize=0, CanChange=True
    "val": Initialize=0, CanChange=True
    "one": Initialize=0, CanChange=True
    "stop": Initialize=0, CanChange=True
    "added": Initialize=0, CanChange=True
    "gen": Initialize=0, CanChange=True
}

// =============================================================================
// LOOP HOMES
// One integer home (r13), one accumulator (r12), and up to four float homes
// (xmm2 plus xmm3/xmm4/xmm5). A call spills r13 and xmm2-xmm5 unless every
// reachable body in this compile is free of loops, InlineAsm, and fused
// multiply-add, and every call is one of those bodies or an inlined builtin
// that leaves those registers alone. An unknown callee keeps the spill.
// The hold in xmm0 still flushes. A nested loop in the caller turns homes off.
// Kind values for Emit_HomeMove are the only place r13/xmm2/r12 are named.
// =============================================================================
FixedPool.LoopHome {
    "active": Initialize=0, CanChange=True
    "blocked": Initialize=0, CanChange=True
    "no_float": Initialize=0, CanChange=True
    "count": Initialize=0, CanChange=True
