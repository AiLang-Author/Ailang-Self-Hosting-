// =============================================================================
// Library.CCompilerOptimizer.ailang
// =============================================================================
// Expression optimization - eliminates redundant push/pop sequences
// 
// STRATEGY: Pattern-match simple cases first, expand later.
// Start with Add/Multiply of two simple operands (numbers or variables).
// =============================================================================

LibraryImport.Arrays
LibraryImport.Compiler.Frontend.AST.CASTTypes
LibraryImport.Compiler.Frontend.AST.CASTCore
LibraryImport.Compiler.CodeEmit.CEmitCoreArch
LibraryImport.Compiler.Compile.Modules.CCompileScope
LibraryImport.Compiler.Compile.Modules.CCompileCompare
LibraryImport.Hardware

// =============================================================================
// OPTIMIZER STATE
// =============================================================================
FixedPool.OptState {
    "next_temp": Initialize=0, CanChange=True
    "debug": Initialize=1, CanChange=True
    "func_nodes": Initialize=0, CanChange=True
    "func_snaps": Initialize=0, CanChange=True
    "inline_seq": Initialize=0, CanChange=True
    "inline_ready": Initialize=0, CanChange=True
    "inline_ast": Initialize=0, CanChange=True
    "fold_ast": Initialize=0, CanChange=True
    "pool_slot": Initialize=0, CanChange=True
    "pool_names": Initialize=0, CanChange=True
    "pool_kinds": Initialize=0, CanChange=True
    "pool_vals": Initialize=0, CanChange=True
    "pool_gen": Initialize=0, CanChange=True
    "scan_names": Initialize=0, CanChange=True
    "scan_kinds": Initialize=0, CanChange=True
    "scan_vals": Initialize=0, CanChange=True
    "flt_n": Initialize=0, CanChange=True
    "flt_ready": Initialize=0, CanChange=True
    "flt_bits": Initialize=0, CanChange=True
    "flt_disp": Initialize=0, CanChange=True
    "flt_depth": Initialize=0, CanChange=True
    "flt_save": Initialize=0, CanChange=True
    "flt_skip": Initialize=0, CanChange=True
    "flt_saw": Initialize=0, CanChange=True
    "hold_block": Initialize=0, CanChange=True
    "fold_between": Initialize=0, CanChange=True
    "clean_cache": Initialize=0, CanChange=True
    "clean_visit": Initialize=0, CanChange=True
    "clean_depth": Initialize=0, CanChange=True
    "xmm_out": Initialize=0, CanChange=True
    "repeat_n": Initialize=0, CanChange=True
    "repeat_hit": Initialize=0, CanChange=True
    "parity_node": Initialize=0, CanChange=True
    "parity_cls": Initialize=0, CanChange=True
    "bind_n": Initialize=0, CanChange=True
    "bind_bad": Initialize=0, CanChange=True
    "bind_val": Initialize=0, CanChange=True
    "bind_seen": Initialize=0, CanChange=True
    "bind_late": Initialize=0, CanChange=True
    "bind_root": Initialize=0, CanChange=True
    "magic_m": Initialize=0, CanChange=True
    "magic_sh": Initialize=0, CanChange=True
    "magic_neg": Initialize=0, CanChange=True
}

// kind: 0 poisoned, 1 integer, 2 float bits, 3 name alias, 4 not known yet
FixedPool.FoldHold {
    "kind": Initialize=0, CanChange=True
    "val": Initialize=0, CanChange=True
    "one": Initialize=0, CanChange=True
    "stop": Initialize=0, CanChange=True
    "added": Initialize=0, CanChange=True
    "gen": Initialize=0, CanChange=True
}




// =============================================================================
// GENERIC: Load any expression into RAX
// Handles NUMBER, IDENTIFIER, or nested math CALL
// Returns 1 on success, 0 on failure (fall back to standard path)
// =============================================================================
Function.Optimize_LoadToRax {
    Input: node: Address
    Output: Integer
    Body: {
        node_type = AST_GetType(node)
        
        // NUMBER: immediate
        IfCondition EqualTo(node_type, AST.NUMBER) ThenBlock: {
            val = StringToNumber(AST_GetData1(node))
            Emit_MovRaxImm64(val)
            ReturnValue(1)
        }
        
        // IDENTIFIER: variable
        IfCondition EqualTo(node_type, AST.IDENTIFIER) ThenBlock: {
            name = AST_GetData1(node)
            IfCondition EqualTo(Optimize_HomeLoad(name), 1) ThenBlock: { ReturnValue(1) }
            offset = Scope_Resolve(name)
            resolve_type = Scope.resolve_type
            IfCondition EqualTo(resolve_type, 0) ThenBlock: {
                ReturnValue(0)
            }
            IfCondition EqualTo(resolve_type, 3) ThenBlock: {
                pool_index = BitwiseAnd(offset, 2147483647)
                pool_offset = Multiply(pool_index, 8)
                Emit_MovRaxR15Offset(pool_offset)
            } ElseBlock: {
                Emit_MovRaxRbpOffset(offset)
            }
            ReturnValue(1)
        }
        
        // CALL: check if it's a math op we can optimize
        IfCondition EqualTo(node_type, AST.CALL) ThenBlock: {
            func_name = AST_GetData1(node)
            IfCondition EqualTo(Optimize_IsMathOp(func_name), 1) ThenBlock: {
                result = Optimize_BinaryMathOp(node)
                ReturnValue(result)
            }
        }
        
        // Can't optimize this expression
        ReturnValue(0)
    }
}

// =============================================================================
// GENERIC: Load any expression into RBX
// Same as LoadToRax but targets RBX
// =============================================================================
Function.Optimize_LoadToRbx {
    Input: node: Address
    Output: Integer
    Body: {
        node_type = AST_GetType(node)
        
        // NUMBER: immediate
        IfCondition EqualTo(node_type, AST.NUMBER) ThenBlock: {
            val = StringToNumber(AST_GetData1(node))
            Emit_MovRbxImm64(val)
            ReturnValue(1)
        }
        
        // IDENTIFIER: variable
        IfCondition EqualTo(node_type, AST.IDENTIFIER) ThenBlock: {
            name = AST_GetData1(node)
            IfCondition EqualTo(LoopHome.der_on, 1) ThenBlock: {
                IfCondition EqualTo(Optimize_NameEq(name, LoopHome.der_name), 1) ThenBlock: {
                    X86Enc_Assemble("MOV rbx, r11")
                    ReturnValue(1)
                }
            }
            IfCondition EqualTo(Optimize_IsIntHome(name), 1) ThenBlock: {
                Emit_MovRbxR13()
                ReturnValue(1)
            }
            IfCondition EqualTo(Optimize_IsFltHome(name), 1) ThenBlock: {
                Emit_PushRax()
                slot = Optimize_FltSlot(name)
                IfCondition EqualTo(slot, 2) ThenBlock: { Emit_HomeMove(5, 0) }
                IfCondition GreaterThan(slot, 2) ThenBlock: { X86_XmmRR(2, slot) }
                Emit_MovRbxRax()
                Emit_PopRax()
                ReturnValue(1)
            }
            IfCondition EqualTo(Optimize_IsAccHome(name), 1) ThenBlock: {
                Emit_MovRbxR12()
                ReturnValue(1)
            }
            IfCondition EqualTo(LoopHome.hold_on, 1) ThenBlock: {
                IfCondition EqualTo(StringCompare(name, LoopHome.hold_name), 0) ThenBlock: {
                    Emit_PushRax()
                    Emit_HomeMove(30, 0)
                    Emit_MovRbxRax()
                    Emit_PopRax()
                    ReturnValue(1)
                }
            }
            IfCondition EqualTo(Optimize_AliasFind(name), 1) ThenBlock: {
                X86_EmitR13Mem(0, 73, 139, 0, 3, LoopHome.hit_disp)
                ReturnValue(1)
            }
            offset = Scope_Resolve(name)
            resolve_type = Scope.resolve_type
            IfCondition EqualTo(resolve_type, 0) ThenBlock: {
                ReturnValue(0)
            }
            IfCondition EqualTo(resolve_type, 3) ThenBlock: {
                pool_index = BitwiseAnd(offset, 2147483647)
                pool_offset = Multiply(pool_index, 8)
                Emit_MovRbxR15Offset(pool_offset)
            } ElseBlock: {
                Emit_MovRbxRbpOffset(offset)
            }
            ReturnValue(1)
        }
        
        // CALL: optimize nested math, then move RAX→RBX
        IfCondition EqualTo(node_type, AST.CALL) ThenBlock: {
            func_name = AST_GetData1(node)
            IfCondition EqualTo(Optimize_IsMathOp(func_name), 1) ThenBlock: {
                result = Optimize_BinaryMathOp(node)
                IfCondition EqualTo(result, 1) ThenBlock: {
                    Emit_MovRbxRax()  // Move result to RBX
                    ReturnValue(1)
                }
            }
        }
        
        ReturnValue(0)
    }
}
// =============================================================================
// EMIT OPERATION: Given RAX=left, RBX=right, emit the math/cmp instruction
// Returns 1 on success, 0 on unknown operation
// =============================================================================

Function.Optimize_EmitOperation {
    Input: node: Address
    Input: func_name: Address
    Output: Integer
    Body: {
        // =================================================================
        // ARITHMETIC
        // =================================================================
        IfCondition EqualTo(StringCompare(func_name, "Add"), 0) ThenBlock: {
            Emit_AddRaxRbx()
            ReturnValue(1)
        }
        IfCondition EqualTo(StringCompare(func_name, "Subtract"), 0) ThenBlock: {
            Emit_SubRaxRbx()
            ReturnValue(1)
        }
        IfCondition EqualTo(StringCompare(func_name, "Multiply"), 0) ThenBlock: {
            // Check right operand for power-of-2 → SHL
            arg1 = AST_GetChild(node, 1)
            arg1_type = AST_GetType(arg1)
            IfCondition EqualTo(arg1_type, AST.NUMBER) ThenBlock: {
                val_str = AST_GetData1(arg1)
                val = StringToNumber(val_str)
                IfCondition GreaterThan(val, 0) ThenBlock: {
                    val_minus_1 = Subtract(val, 1)
                    check = BitwiseAnd(val, val_minus_1)
                    IfCondition EqualTo(check, 0) ThenBlock: {
                        shift = 0
                        tmp = val
                        WhileLoop GreaterThan(tmp, 1) {
                            tmp = Divide(tmp, 2)
                            shift = Add(shift, 1)
                        }
                        IfCondition GreaterThan(shift, 0) ThenBlock: {
                            Emit_ShlRaxImm8(shift)
                            ReturnValue(1)
                        }
                        ReturnValue(1)
                    }
                }
            }
            // Check left operand for power-of-2 → SHL
            arg0 = AST_GetChild(node, 0)
            arg0_type = AST_GetType(arg0)
            IfCondition EqualTo(arg0_type, AST.NUMBER) ThenBlock: {
                val_str = AST_GetData1(arg0)
                val = StringToNumber(val_str)
                IfCondition GreaterThan(val, 0) ThenBlock: {
                    val_minus_1 = Subtract(val, 1)
                    check = BitwiseAnd(val, val_minus_1)
                    IfCondition EqualTo(check, 0) ThenBlock: {
                        shift = 0
                        tmp = val
                        WhileLoop GreaterThan(tmp, 1) {
                            tmp = Divide(tmp, 2)
                            shift = Add(shift, 1)
                        }
                        IfCondition GreaterThan(shift, 0) ThenBlock: {
                            Emit_MovRaxRbx()
                            Emit_ShlRaxImm8(shift)
                            ReturnValue(1)
                        }
                        ReturnValue(1)
                    }
                }
            }
            Emit_ImulRaxRbx()
            ReturnValue(1)
        }
        IfCondition EqualTo(StringCompare(func_name, "Divide"), 0) ThenBlock: {
            // RAX is the dividend. A positive power-of-two divisor uses
            // the same toward-zero adjustment as CompileArith_Divide:
            // add the sign bit, then SAR. The incoming RBX is not read.
            // Shift 1 uses RCX and RAX only. A larger shift rewrites RBX.
            arg1 = AST_GetChild(node, 1)
            known = CompileArith_KnownDivisor(node, arg1)
            val = OptState.bind_val
            IfCondition EqualTo(known, 1) ThenBlock: {
                IfCondition GreaterThan(val, 0) ThenBlock: {
                    val_minus_1 = Subtract(val, 1)
                    check = BitwiseAnd(val, val_minus_1)
                    IfCondition EqualTo(check, 0) ThenBlock: {
                        shift = 0
                        tmp = val
                        WhileLoop GreaterThan(tmp, 1) {
                            tmp = Divide(tmp, 2)
                            shift = Add(shift, 1)
                        }
                        IfCondition EqualTo(shift, 0) ThenBlock: {
                            ReturnValue(1)
                        }
                        // Plain SAR when the dividend is proven non-negative,
                        // or when it is the always-even product x*(x+1) and
                        // the divisor is 2. A negative odd dividend keeps
                        // the toward-zero bias below.
                        IfCondition EqualTo(Optimize_SarSafe(AST_GetChild(node, 0), shift), 1) ThenBlock: {
                            Emit_SarRaxImm8(shift)
                            ReturnValue(1)
                        }
                        IfCondition EqualTo(shift, 1) ThenBlock: {
                            Emit_MovRegReg(Reg.RCX, Reg.RAX)
                            Emit_ShrRcxImm8(63)
                            Emit_AddRaxRcx()
                            Emit_SarRaxImm8(1)
                            ReturnValue(1)
                        }
                        Emit_MovRegReg(Reg.RDX, Reg.RAX)
                        Emit_MovRegReg(Reg.RCX, Reg.RAX)
                        Emit_ShrRcxImm8(63)
                        Emit_MovRegReg(Reg.RBX, Reg.RCX)
                        Emit_MovRegReg(Reg.RAX, Reg.RCX)
                        Emit_ShlRaxImm8(shift)
                        Emit_SubRaxRbx()
                        Emit_MovRegReg(Reg.RCX, Reg.RAX)
                        Emit_MovRegReg(Reg.RAX, Reg.RDX)
                        Emit_AddRaxRcx()
                        Emit_SarRaxImm8(shift)
                        ReturnValue(1)
                    }
                }
                IfCondition EqualTo(Optimize_MagicPrepare(val), 1) ThenBlock: {
                    nn = 0
                    IfCondition GreaterThan(val, 0) ThenBlock: {
                        nn = Optimize_ProvedNonNeg(AST_GetChild(node, 0))
                    }
                    CompileArith_MagicFinish(val, 0, 0, nn)
                    ReturnValue(1)
                }
            }
            Emit_Cqo()
            Emit_IdivRbx()
            ReturnValue(1)
        }
        IfCondition EqualTo(StringCompare(func_name, "Modulo"), 0) ThenBlock: {
            arg1 = AST_GetChild(node, 1)
            known = CompileArith_KnownDivisor(node, arg1)
            val = OptState.bind_val
            IfCondition EqualTo(known, 1) ThenBlock: {
                IfCondition GreaterThan(val, 0) ThenBlock: {
                    val_minus_1 = Subtract(val, 1)
                    check = BitwiseAnd(val, val_minus_1)
                    IfCondition EqualTo(check, 0) ThenBlock: {
                        // AND is the unsigned mask. A negative dividend, or a
                        // mask that does not fit imm32, uses the magic multiply.
                        saved_lo = LoopHome.range_lo
                        saved_hi = LoopHome.range_hi
                        proved = Optimize_NonNeg(AST_GetChild(node, 0))
                        LoopHome.range_lo = saved_lo
                        LoopHome.range_hi = saved_hi
                        IfCondition EqualTo(proved, 1) ThenBlock: {
                            IfCondition EqualTo(Optimize_Fit32(val_minus_1), 1) ThenBlock: {
                                Emit_AndRaxImm32(val_minus_1)
                                ReturnValue(1)
                            }
                        }
                    }
                }
                IfCondition EqualTo(Optimize_MagicPrepare(val), 1) ThenBlock: {
                    nn = 0
                    IfCondition GreaterThan(val, 0) ThenBlock: {
                        nn = Optimize_ProvedNonNeg(AST_GetChild(node, 0))
                    }
                    CompileArith_MagicFinish(val, 1, 0, nn)
                    ReturnValue(1)
                }
            }
            Emit_Cqo()
            Emit_IdivRbx()
            Emit_MovRaxRdx()
            ReturnValue(1)
        }

        // =================================================================
        // COMPARISONS
        // =================================================================
        IfCondition EqualTo(StringCompare(func_name, "EqualTo"), 0) ThenBlock: {
            Emit_CmpRaxRbx()
            Emit_Sete()
            Emit_MovzxRaxAl()
            ReturnValue(1)
        }
        IfCondition EqualTo(StringCompare(func_name, "NotEqual"), 0) ThenBlock: {
            Emit_CmpRaxRbx()
            Emit_Setne()
            Emit_MovzxRaxAl()
            ReturnValue(1)
        }
        IfCondition EqualTo(StringCompare(func_name, "LessThan"), 0) ThenBlock: {
            Emit_CmpRaxRbx()
            Emit_Setl()
            Emit_MovzxRaxAl()
            ReturnValue(1)
        }
        IfCondition EqualTo(StringCompare(func_name, "GreaterThan"), 0) ThenBlock: {
            Emit_CmpRaxRbx()
            Emit_Setg()
            Emit_MovzxRaxAl()
            ReturnValue(1)
        }
        IfCondition EqualTo(StringCompare(func_name, "LessEqual"), 0) ThenBlock: {
            Emit_CmpRaxRbx()
            Emit_Setle()
            Emit_MovzxRaxAl()
            ReturnValue(1)
        }
        IfCondition EqualTo(StringCompare(func_name, "GreaterEqual"), 0) ThenBlock: {
            Emit_CmpRaxRbx()
            Emit_Setge()
            Emit_MovzxRaxAl()
            ReturnValue(1)
        }

        // =================================================================
        // BITWISE — AND, OR, XOR
        // =================================================================
        is_and = Or(EqualTo(StringCompare(func_name, "BitwiseAnd"), 0), EqualTo(StringCompare(func_name, "BitAnd"), 0))
        IfCondition EqualTo(is_and, 1) ThenBlock: {
            Emit_AndRaxRbx()
            ReturnValue(1)
        }
        is_or = Or(EqualTo(StringCompare(func_name, "BitwiseOr"), 0), EqualTo(StringCompare(func_name, "BitOr"), 0))
        IfCondition EqualTo(is_or, 1) ThenBlock: {
            Emit_OrRaxRbx()
            ReturnValue(1)
        }
        is_xor = Or(EqualTo(StringCompare(func_name, "BitwiseXor"), 0), EqualTo(StringCompare(func_name, "BitXor"), 0))
        IfCondition EqualTo(is_xor, 1) ThenBlock: {
            Emit_XorRaxRbx()
            ReturnValue(1)
        }

        // =================================================================
        // SHIFTS — need RBX→RCX for variable shift, or imm8 for constant
        // =================================================================
        is_shl = Or(EqualTo(StringCompare(func_name, "LeftShift"), 0), EqualTo(StringCompare(func_name, "ShiftLeft"), 0))
        IfCondition EqualTo(is_shl, 1) ThenBlock: {
            // If right operand is constant, use SHL RAX, imm8 directly
            arg1 = AST_GetChild(node, 1)
            arg1_type = AST_GetType(arg1)
            IfCondition EqualTo(arg1_type, AST.NUMBER) ThenBlock: {
                shift_val = StringToNumber(AST_GetData1(arg1))
                Emit_ShlRaxImm8(shift_val)
                ReturnValue(1)
            }
            // Variable shift: RBX has shift amount, move to RCX
            Emit_MovRcxRbx()
            Emit_ShlRaxCl()
            ReturnValue(1)
        }
        is_shr = Or(EqualTo(StringCompare(func_name, "RightShift"), 0), EqualTo(StringCompare(func_name, "ShiftRight"), 0))
        IfCondition EqualTo(is_shr, 1) ThenBlock: {
            arg1 = AST_GetChild(node, 1)
            arg1_type = AST_GetType(arg1)
            IfCondition EqualTo(arg1_type, AST.NUMBER) ThenBlock: {
                shift_val = StringToNumber(AST_GetData1(arg1))
                Emit_ShrRaxImm8(shift_val)
                ReturnValue(1)
            }
            Emit_MovRcxRbx()
            Emit_ShrRaxCl()
            ReturnValue(1)
        }

        ReturnValue(0)
    }
}

// =============================================================================
// RBX LEAF
// Add(leaf, number) and Subtract(leaf, number) can be built in RBX without
// touching RAX, so the other operand is not pushed. A leaf is a number or a
// name. One level only: a nested add still needs RAX and keeps the old path.
// Subtract(number, name) is not commutative and is lowered without swapping.
// If RAX already holds that name, copy it instead of loading the slot again.
// =============================================================================

Function.Optimize_IsBase {
    Input: node: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        node_type = AST_GetType(node)
        is_num = EqualTo(node_type, AST.NUMBER)
        is_id = EqualTo(node_type, AST.IDENTIFIER)
        IfCondition EqualTo(Or(is_num, is_id), 1) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

Function.Optimize_IsImmLeaf {
    Input: node: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(node), AST.CALL) ThenBlock: { ReturnValue(0) }
        func_name = AST_GetData1(node)
        is_add = EqualTo(StringCompare(func_name, "Add"), 0)
        is_sub = EqualTo(StringCompare(func_name, "Subtract"), 0)
        IfCondition EqualTo(Or(is_add, is_sub), 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetChildCount(node), 2) ThenBlock: { ReturnValue(0) }
        c0 = AST_GetChild(node, 0)
        c1 = AST_GetChild(node, 1)
        IfCondition EqualTo(Optimize_IsBase(c0), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_IsBase(c1), 0) ThenBlock: { ReturnValue(0) }
        t0 = AST_GetType(c0)
        t1 = AST_GetType(c1)
        has_num = Or(EqualTo(t0, AST.NUMBER), EqualTo(t1, AST.NUMBER))
        IfCondition EqualTo(has_num, 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(1)
    }
}

Function.Optimize_LeafName {
    Input: node: Address
    Output: Address
    Body: {
        c0 = AST_GetChild(node, 0)
        c1 = AST_GetChild(node, 1)
        IfCondition EqualTo(AST_GetType(c0), AST.IDENTIFIER) ThenBlock: {
            ReturnValue(AST_GetData1(c0))
        }
        IfCondition EqualTo(AST_GetType(c1), AST.IDENTIFIER) ThenBlock: {
            ReturnValue(AST_GetData1(c1))
        }
        ReturnValue(0)
    }
}

Function.Optimize_NameIs {
    Input: node: Address
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(node), AST.IDENTIFIER) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(StringCompare(AST_GetData1(node), name), 0) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

Function.Optimize_IsComm {
    Input: func_name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(StringCompare(func_name, "Add"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(func_name, "Multiply"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(func_name, "BitwiseAnd"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(func_name, "BitwiseOr"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(func_name, "BitwiseXor"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(func_name, "BitAnd"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(func_name, "BitOr"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(func_name, "BitXor"), 0) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

// A signed 32-bit immediate sign-extends. Wider addends go through RCX.

Function.Optimize_Fit32 {
    Input: val: Integer
    Output: Integer
    Body: {
        IfCondition GreaterThan(val, 2147483647) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(val, -2147483648) ThenBlock: { ReturnValue(0) }
        ReturnValue(1)
    }
}

Function.Optimize_RbxAdd {
    Input: val: Integer
    Body: {
        IfCondition EqualTo(Optimize_Fit32(val), 1) ThenBlock: {
            Emit_AddRegImm32(Reg.RBX, val)
        } ElseBlock: {
            Emit_MovRegImm64(Reg.RCX, val)
            X86_AddRegReg(Reg.RBX, Reg.RCX)
        }
    }
}

Function.Optimize_RbxSub {
    Input: val: Integer
    Body: {
        IfCondition EqualTo(Optimize_Fit32(val), 1) ThenBlock: {
            X86_SubRbxImm32(val)
        } ElseBlock: {
            Emit_MovRegImm64(Reg.RCX, val)
            X86_SubRegReg(Reg.RBX, Reg.RCX)
        }
    }
}

Function.Optimize_NumVal {
    Input: node: Address
    Output: Integer
    Body: {
        ReturnValue(StringToNumber(AST_GetData1(node)))
    }
}

// Build an immediate leaf in RBX. RAX is preserved.

Function.Optimize_LoadRbxLeaf {
    Input: node: Address
    Output: Integer
    Body: {
        c0 = AST_GetChild(node, 0)
        c1 = AST_GetChild(node, 1)
        t0 = AST_GetType(c0)
        t1 = AST_GetType(c1)
        is_sub = EqualTo(StringCompare(AST_GetData1(node), "Subtract"), 0)
        IfCondition EqualTo(t1, AST.NUMBER) ThenBlock: {
            IfCondition EqualTo(t0, AST.NUMBER) ThenBlock: {
                val0 = Optimize_NumVal(c0)
                Emit_MovRbxImm64(val0)
            } ElseBlock: {
                got = Optimize_LoadToRbx(c0)
                IfCondition EqualTo(got, 0) ThenBlock: { ReturnValue(0) }
            }
            val = Optimize_NumVal(c1)
            IfCondition EqualTo(is_sub, 1) ThenBlock: {
                Optimize_RbxSub(val)
            } ElseBlock: {
                Optimize_RbxAdd(val)
            }
            ReturnValue(1)
        }
        val = Optimize_NumVal(c0)
        IfCondition EqualTo(is_sub, 0) ThenBlock: {
            got = Optimize_LoadToRbx(c1)
            IfCondition EqualTo(got, 0) ThenBlock: { ReturnValue(0) }
            Optimize_RbxAdd(val)
            ReturnValue(1)
        }
        // rbx = number - name. The name is loaded through RCX so RAX survives.
        Emit_PushRax()
        got = Optimize_LoadToRax(c1)
        IfCondition EqualTo(got, 0) ThenBlock: {
            Emit_PopRax()
            ReturnValue(0)
        }
        Emit_MovRcxRax()
        Emit_PopRax()
        Emit_MovRegImm64(Reg.RBX, val)
        X86_SubRegReg(Reg.RBX, Reg.RCX)
        ReturnValue(1)
    }
}

// RAX already holds the leaf's name. Copy it to RBX and apply the immediate.

Function.Optimize_RbxFromRax {
    Input: node: Address
    Body: {
        c0 = AST_GetChild(node, 0)
        c1 = AST_GetChild(node, 1)
        t1 = AST_GetType(c1)
        is_sub = EqualTo(StringCompare(AST_GetData1(node), "Subtract"), 0)
        IfCondition EqualTo(t1, AST.NUMBER) ThenBlock: {
            val = Optimize_NumVal(c1)
            disp = val
            IfCondition EqualTo(is_sub, 1) ThenBlock: { disp = Subtract(0, val) }
            IfCondition EqualTo(Optimize_Fit32(disp), 1) ThenBlock: {
                X86_LeaRbxRax(disp)
            } ElseBlock: {
                Emit_MovRbxRax()
                IfCondition EqualTo(is_sub, 1) ThenBlock: {
                    Optimize_RbxSub(val)
                } ElseBlock: {
                    Optimize_RbxAdd(val)
                }
            }
        } ElseBlock: {
            val = Optimize_NumVal(c0)
            IfCondition EqualTo(is_sub, 0) ThenBlock: {
                IfCondition EqualTo(Optimize_Fit32(val), 1) ThenBlock: {
                    X86_LeaRbxRax(val)
                } ElseBlock: {
                    Emit_MovRbxRax()
                    Optimize_RbxAdd(val)
                }
            } ElseBlock: {
                Emit_MovRcxRax()
                Emit_MovRegImm64(Reg.RBX, val)
                X86_SubRegReg(Reg.RBX, Reg.RCX)
            }
        }
    }
}

// R12 or R13 when this name is the loop home. Other names stay in memory,
// and LEA cannot fold a memory value.

Function.Optimize_HomeReg {
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(Optimize_IsAccHome(name), 1) ThenBlock: { ReturnValue(12) }
        IfCondition EqualTo(Optimize_IsIntHome(name), 1) ThenBlock: { ReturnValue(13) }
        ReturnValue(0)
    }
}

// Register plus a signed 32-bit displacement. Add(home, k) and Add(k, home)
// are home+k. Subtract(home, k) is home-k. Subtract(k, home) is not.
// Returns 12 or 13, or 0 when the add should stay on the old path.

Function.Optimize_LeaReg {
    Input: node: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(Optimize_IsImmLeaf(node), 0) ThenBlock: { ReturnValue(0) }
        c0 = AST_GetChild(node, 0)
        c1 = AST_GetChild(node, 1)
        is_sub = EqualTo(StringCompare(AST_GetData1(node), "Subtract"), 0)
        IfCondition EqualTo(AST_GetType(c1), AST.NUMBER) ThenBlock: {
            IfCondition NotEqual(AST_GetType(c0), AST.IDENTIFIER) ThenBlock: { ReturnValue(0) }
            reg = Optimize_HomeReg(AST_GetData1(c0))
            IfCondition EqualTo(reg, 0) ThenBlock: { ReturnValue(0) }
            val = Optimize_NumVal(c1)
            IfCondition EqualTo(is_sub, 1) ThenBlock: { val = Subtract(0, val) }
            IfCondition EqualTo(Optimize_Fit32(val), 0) ThenBlock: { ReturnValue(0) }
            ReturnValue(reg)
        }
        IfCondition EqualTo(is_sub, 1) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(c1), AST.IDENTIFIER) ThenBlock: { ReturnValue(0) }
        reg = Optimize_HomeReg(AST_GetData1(c1))
        IfCondition EqualTo(reg, 0) ThenBlock: { ReturnValue(0) }
        val = Optimize_NumVal(c0)
        IfCondition EqualTo(Optimize_Fit32(val), 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(reg)
    }
}

Function.Optimize_LeaDisp {
    Input: node: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(Optimize_LeaReg(node), 0) ThenBlock: { ReturnValue(0) }
        c0 = AST_GetChild(node, 0)
        c1 = AST_GetChild(node, 1)
        is_sub = EqualTo(StringCompare(AST_GetData1(node), "Subtract"), 0)
        IfCondition EqualTo(AST_GetType(c1), AST.NUMBER) ThenBlock: {
            val = Optimize_NumVal(c1)
            IfCondition EqualTo(is_sub, 1) ThenBlock: { ReturnValue(Subtract(0, val)) }
            ReturnValue(val)
        }
        ReturnValue(Optimize_NumVal(c0))
    }
}

// Add(other, home+disp) is LEA RAX, [home + RAX + disp] after other is in
// RAX. Add is commutative, so the home may sit on the left. Returns 0 when
// nothing was emitted, 1 when RAX holds the sum, 2 when emission started
// and then failed.

Function.Optimize_TryLea {
    Input: func_name: Address
    Input: arg0: Address
    Input: arg1: Address
    Output: Integer
    Body: {
        IfCondition NotEqual(StringCompare(func_name, "Add"), 0) ThenBlock: { ReturnValue(0) }
        reg = Optimize_LeaReg(arg1)
        leaf = arg1
        other = arg0
        IfCondition EqualTo(reg, 0) ThenBlock: {
            reg = Optimize_LeaReg(arg0)
            IfCondition EqualTo(reg, 0) ThenBlock: { ReturnValue(0) }
            leaf = arg0
            other = arg1
        }
        kind = AST_GetType(other)
        ok = 0
        IfCondition EqualTo(kind, AST.NUMBER) ThenBlock: { ok = 1 }
        IfCondition EqualTo(kind, AST.IDENTIFIER) ThenBlock: { ok = 1 }
        IfCondition EqualTo(kind, AST.CALL) ThenBlock: {
            IfCondition EqualTo(Optimize_IsMathOp(AST_GetData1(other)), 1) ThenBlock: { ok = 1 }
        }
        IfCondition EqualTo(ok, 0) ThenBlock: { ReturnValue(0) }
        got = Optimize_LoadToRax(other)
        IfCondition EqualTo(got, 0) ThenBlock: { ReturnValue(2) }
        X86_LeaRaxHome(reg, Optimize_LeaDisp(leaf))
        ReturnValue(1)
    }
}

// Returns 0 when the shape does not match (nothing emitted), 1 when RAX is
// the left operand and RBX is the right, 2 when the shape matched but a
// load failed after emission started.

Function.Optimize_TryRbxLeaf {
    Input: node: Address
    Input: func_name: Address
    Input: arg0: Address
    Input: arg1: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(Optimize_IsImmLeaf(arg1), 1) ThenBlock: {
            leaf_name = Optimize_LeafName(arg1)
            same = Optimize_NameIs(arg0, leaf_name)
            IfCondition EqualTo(same, 1) ThenBlock: {
                got = Optimize_LoadToRax(arg0)
                IfCondition EqualTo(got, 0) ThenBlock: { ReturnValue(2) }
                Optimize_RbxFromRax(arg1)
                ReturnValue(1)
            }
            got = Optimize_LoadToRax(arg0)
            IfCondition EqualTo(got, 0) ThenBlock: { ReturnValue(2) }
            got = Optimize_LoadRbxLeaf(arg1)
            IfCondition EqualTo(got, 0) ThenBlock: { ReturnValue(2) }
            ReturnValue(1)
        }
        IfCondition EqualTo(Optimize_IsComm(func_name), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_IsImmLeaf(arg0), 0) ThenBlock: { ReturnValue(0) }
        leaf_name = Optimize_LeafName(arg0)
        same = Optimize_NameIs(arg1, leaf_name)
        IfCondition EqualTo(same, 0) ThenBlock: { ReturnValue(0) }
        got = Optimize_LoadToRax(arg1)
        IfCondition EqualTo(got, 0) ThenBlock: { ReturnValue(2) }
        Optimize_RbxFromRax(arg0)
        ReturnValue(1)
    }
}

Function.Optimize_IsPow2 {
    Input: val: Integer
    Output: Integer
    Body: {
        IfCondition LessEqual(val, 0) ThenBlock: { ReturnValue(0) }
        masked = BitwiseAnd(val, Subtract(val, 1))
        IfCondition EqualTo(masked, 0) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

// 1 when EmitOperation ignores the incoming RBX. A constant shift or a
// power-of-two multiply still needs a number on the right. Divide and
// modulo also skip RBX when the divisor resolves and either the
// power-of-two arm or the magic multiply will take it. IDIV still loads RBX.

Function.Optimize_SkipRbx {
    Input: node: Address
    Input: func_name: Address
    Output: Integer
    Body: {
        arg1 = AST_GetChild(node, 1)
        is_shl = Or(EqualTo(StringCompare(func_name, "LeftShift"), 0), EqualTo(StringCompare(func_name, "ShiftLeft"), 0))
        is_shr = Or(EqualTo(StringCompare(func_name, "RightShift"), 0), EqualTo(StringCompare(func_name, "ShiftRight"), 0))
        IfCondition EqualTo(Or(is_shl, is_shr), 1) ThenBlock: {
            IfCondition NotEqual(AST_GetType(arg1), AST.NUMBER) ThenBlock: { ReturnValue(0) }
            ReturnValue(1)
        }
        is_mul = EqualTo(StringCompare(func_name, "Multiply"), 0)
        IfCondition EqualTo(is_mul, 1) ThenBlock: {
            IfCondition NotEqual(AST_GetType(arg1), AST.NUMBER) ThenBlock: { ReturnValue(0) }
            ReturnValue(Optimize_IsPow2(StringToNumber(AST_GetData1(arg1))))
        }
        is_div = EqualTo(StringCompare(func_name, "Divide"), 0)
        is_mod = EqualTo(StringCompare(func_name, "Modulo"), 0)
        IfCondition EqualTo(Or(is_div, is_mod), 0) ThenBlock: { ReturnValue(0) }
        known = CompileArith_KnownDivisor(node, arg1)
        IfCondition EqualTo(known, 0) ThenBlock: { ReturnValue(0) }
        val = OptState.bind_val
        IfCondition GreaterThan(val, 0) ThenBlock: {
            IfCondition EqualTo(Optimize_IsPow2(val), 1) ThenBlock: {
                IfCondition EqualTo(is_div, 1) ThenBlock: { ReturnValue(1) }
                IfCondition EqualTo(Optimize_Fit32(Subtract(val, 1)), 1) ThenBlock: {
                    IfCondition EqualTo(Optimize_ProvedNonNeg(AST_GetChild(node, 0)), 1) ThenBlock: {
                        ReturnValue(1)
                    }
                }
            }
        }
        ReturnValue(Optimize_MagicPrepare(val))
    }
}

// =============================================================================
// GENERIC: Optimize any binary math operation
// Three-way operand loading + operation dispatch
// Returns 1 if optimized, 0 to fall back to standard path
// =============================================================================
Function.Optimize_BinaryMathOp {
    Input: node: Address
    Output: Integer
    Body: {
        arg_count = AST_GetChildCount(node)
        IfCondition NotEqual(arg_count, 2) ThenBlock: {
            ReturnValue(0)
        }
        
        func_name = AST_GetData1(node)
        arg0 = AST_GetChild(node, 0)
        arg1 = AST_GetChild(node, 1)

        // i * c is the running product when this loop owns that factor.
        IfCondition EqualTo(StringCompare(func_name, "Multiply"), 0) ThenBlock: {
            IfCondition EqualTo(Optimize_TryProdUse(arg0, arg1), 1) ThenBlock: {
                ReturnValue(1)
            }
        }
        
        // Classify both operands
        type0 = AST_GetType(arg0)
        type1 = AST_GetType(arg1)
        left_is_simple = Or(EqualTo(type0, AST.NUMBER), EqualTo(type0, AST.IDENTIFIER))
        right_is_simple = Or(EqualTo(type1, AST.NUMBER), EqualTo(type1, AST.IDENTIFIER))

        // Add of a value and (home + constant) is one LEA. The home stays
        // in R12 or R13. Subtract and divide do not use it.
        lea_hit = Optimize_TryLea(func_name, arg0, arg1)
        IfCondition EqualTo(lea_hit, 2) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(lea_hit, 1) ThenBlock: { ReturnValue(1) }

        // An immediate add or subtract on the right is built in RBX after
        // the left is in RAX. Operand order stays left-then-right.
        leaf_hit = Optimize_TryRbxLeaf(node, func_name, arg0, arg1)
        IfCondition EqualTo(leaf_hit, 2) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(leaf_hit, 1) ThenBlock: {
            emit_result = Optimize_EmitOperation(node, func_name)
            ReturnValue(emit_result)
        }
        
        IfCondition EqualTo(right_is_simple, 1) ThenBlock: {
            // PATH A: right is simple (includes both-simple)
            // left → RAX (may recurse), right → RBX (leaf, safe)
            result = Optimize_LoadToRax(arg0)
            IfCondition EqualTo(result, 0) ThenBlock: {
                ReturnValue(0)
            }
            // A power-of-two or constant-shift arm does not read RBX.
            IfCondition EqualTo(Optimize_SkipRbx(node, func_name), 0) ThenBlock: {
                result = Optimize_LoadToRbx(arg1)
                IfCondition EqualTo(result, 0) ThenBlock: {
                    ReturnValue(0)
                }
            }
        } ElseBlock: {
            IfCondition EqualTo(left_is_simple, 1) ThenBlock: {
                // PATH B: left is simple, right is complex — NEW
                // Evaluate right FIRST → RAX, stash in RBX
                // Then load simple left → RAX (leaf, won't touch RBX)
                result = Optimize_LoadToRax(arg1)
                IfCondition EqualTo(result, 0) ThenBlock: {
                    ReturnValue(0)
                }
                Emit_MovRbxRax()
                result = Optimize_LoadToRax(arg0)
                IfCondition EqualTo(result, 0) ThenBlock: {
                    ReturnValue(0)
                }
            } ElseBlock: {
                // PATH C: both complex — push/pop unavoidable
                result = Optimize_LoadToRax(arg0)
                IfCondition EqualTo(result, 0) ThenBlock: {
                    ReturnValue(0)
                }
                Emit_PushRax()
                result = Optimize_LoadToRbx(arg1)
                IfCondition EqualTo(result, 0) ThenBlock: {
                    ReturnValue(0)
                }
                Emit_PopRax()
            }
        }
        emit_result = Optimize_EmitOperation(node, func_name)
        ReturnValue(emit_result)



        // RAX = left, RBX = right — emit the operation
        ReturnValue(Optimize_EmitOperation(node, func_name))
    }
}

// =============================================================================
// DISPATCHER: Try to optimize any math operation
// Call this from Compile_Expression for CALL nodes
// Returns 1 if optimized, 0 to use standard path
// =============================================================================
Function.Optimize_TryMathOp {
    Input: node: Address
    Output: Integer
    Body: {
        func_name = AST_GetData1(node)

        // Check if it's a math op we handle
        IfCondition EqualTo(Optimize_IsMathOp(func_name), 1) ThenBlock: {
            ReturnValue(Optimize_BinaryMathOp(node))
        }
        
        // Not a math op we optimize
        ReturnValue(0)
    }
}

// =============================================================================
// HELPER: Check if function is optimizable math op
// =============================================================================


Function.Optimize_IsMathOp {
    Input: name: Address
    Output: Integer
    Body: {
        // Arithmetic
        IfCondition EqualTo(StringCompare(name, "Add"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "Subtract"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "Multiply"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "Divide"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "Modulo"), 0) ThenBlock: { ReturnValue(1) }
        
        // Comparisons
        IfCondition EqualTo(StringCompare(name, "EqualTo"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "NotEqual"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "LessThan"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "GreaterThan"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "LessEqual"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "GreaterEqual"), 0) ThenBlock: { ReturnValue(1) }
        
        // Bitwise
        IfCondition EqualTo(StringCompare(name, "BitwiseAnd"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "BitwiseOr"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "BitwiseXor"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "LeftShift"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "RightShift"), 0) ThenBlock: { ReturnValue(1) }
        
        // Short aliases
        IfCondition EqualTo(StringCompare(name, "BitAnd"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "BitOr"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "BitXor"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "ShiftLeft"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "ShiftRight"), 0) ThenBlock: { ReturnValue(1) }
        
        ReturnValue(0)
    }
}

// =============================================================================
// BRANCH CONDITION
// WhileLoop / IfCondition / Fork only test the condition for zero. A single
// compare of two leaves can jump on the flags from CMP and skip SETCC/MOVZX.
// Returns 1 when the false-label jump was emitted, 0 when the caller should
// use the ordinary 0/1 path, 2 when emission started and then failed.
// =============================================================================
Function.Optimize_IsLeaf {
    Input: node: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: {
            ReturnValue(0)
        }
        node_type = AST_GetType(node)
        IfCondition EqualTo(node_type, AST.NUMBER) ThenBlock: {
            ReturnValue(1)
        }
        IfCondition EqualTo(node_type, AST.IDENTIFIER) ThenBlock: {
            ReturnValue(1)
        }
        ReturnValue(0)
    }
}

Function.Optimize_IsZeroNum {
    Input: node: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(node), AST.NUMBER) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(StringToNumber(AST_GetData1(node)), 0) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

Function.Optimize_IsCompareName {
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(name, 0) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition EqualTo(StringCompare(name, "EqualTo"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "NotEqual"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "LessThan"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "GreaterThan"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "LessEqual"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "GreaterEqual"), 0) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

Function.Optimize_JumpIfFalse {
    Input: name: Address
    Input: false_label: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(StringCompare(name, "EqualTo"), 0) ThenBlock: {
            Emit_Jne(false_label)
            ReturnValue(0)
        }
        IfCondition EqualTo(StringCompare(name, "NotEqual"), 0) ThenBlock: {
            Emit_Je(false_label)
            ReturnValue(0)
        }
        IfCondition EqualTo(StringCompare(name, "LessThan"), 0) ThenBlock: {
            Emit_Jge(false_label)
            ReturnValue(0)
        }
        IfCondition EqualTo(StringCompare(name, "GreaterThan"), 0) ThenBlock: {
            Emit_Jle(false_label)
            ReturnValue(0)
        }
        IfCondition EqualTo(StringCompare(name, "LessEqual"), 0) ThenBlock: {
            Emit_Jg(false_label)
            ReturnValue(0)
        }
        Emit_Jl(false_label)
        ReturnValue(0)
    }
}

Function.Optimize_TryBranchCondition {
    Input: node: Address
    Input: false_label: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: {
            ReturnValue(0)
        }
        node_type = AST_GetType(node)
        IfCondition NotEqual(node_type, AST.CALL) ThenBlock: {
            ReturnValue(0)
        }
        name = AST_GetData1(node)
        // A value that is only in a register has to reach memory before a
        // compare reads the frame slot. The back edge also spills it.
        IfCondition EqualTo(LoopHome.ihold_on, 1) ThenBlock: {
            IfCondition EqualTo(Optimize_NodeReads(node, LoopHome.ihold_name), 1) ThenBlock: {
                Optimize_IholdFlush()
            }
        }
        // And of two ready compares is two false jumps. Nothing is emitted
        // unless both sides are ready, so a half-emitted And cannot happen.
        IfCondition EqualTo(StringCompare(name, "And"), 0) ThenBlock: {
            IfCondition EqualTo(AST_GetChildCount(node), 2) ThenBlock: {
                c0 = AST_GetChild(node, 0)
                c1 = AST_GetChild(node, 1)
                IfCondition EqualTo(Optimize_BranchReady(c0), 0) ThenBlock: { ReturnValue(0) }
                IfCondition EqualTo(Optimize_BranchReady(c1), 0) ThenBlock: { ReturnValue(0) }
                IfCondition EqualTo(Optimize_EmitFalseJump(c0, false_label), 0) ThenBlock: { ReturnValue(2) }
                IfCondition EqualTo(Optimize_EmitFalseJump(c1, false_label), 0) ThenBlock: { ReturnValue(2) }
                ReturnValue(1)
            }
            ReturnValue(0)
        }
        IfCondition EqualTo(Optimize_IsFloatCmp(name), 1) ThenBlock: {
            IfCondition EqualTo(Optimize_FloatCmpReady(node), 0) ThenBlock: { ReturnValue(0) }
            IfCondition EqualTo(Optimize_EmitFloatCmp(node, false_label), 0) ThenBlock: { ReturnValue(2) }
            ReturnValue(1)
        }
        IfCondition EqualTo(Optimize_IsCompareName(name), 0) ThenBlock: {
            ReturnValue(0)
        }
        arg_count = AST_GetChildCount(node)
        IfCondition NotEqual(arg_count, 2) ThenBlock: {
            ReturnValue(0)
        }
        arg0 = AST_GetChild(node, 0)
        arg1 = AST_GetChild(node, 1)
        // Compare against zero can test the value. A computed side is
        // not a leaf, so the old path materialized 0/1 and tested that.
        other = 0
        IfCondition EqualTo(Optimize_IsZeroNum(arg1), 1) ThenBlock: {
            IfCondition EqualTo(Optimize_IsLeaf(arg0), 0) ThenBlock: { other = arg0 }
        }
        IfCondition EqualTo(other, 0) ThenBlock: {
            IfCondition EqualTo(Optimize_IsZeroNum(arg0), 1) ThenBlock: {
                IfCondition EqualTo(Optimize_IsLeaf(arg1), 0) ThenBlock: { other = arg1 }
            }
        }
        IfCondition NotEqual(other, 0) ThenBlock: {
            // TEST matches a compare with zero on the right, and equality
            // either way. An ordered compare with zero on the left does not.
            IfCondition EqualTo(Optimize_IsZeroNum(arg0), 1) ThenBlock: {
                ordered = Optimize_FlagCode(name)
                IfCondition GreaterThan(ordered, 2) ThenBlock: { ReturnValue(0) }
            }
            result = Compile_Expression(other)
            IfCondition EqualTo(result, 0) ThenBlock: { ReturnValue(2) }
            Emit_TestRaxRax()
            Optimize_JumpIfFalse(name, false_label)
            ReturnValue(1)
        }
        IfCondition EqualTo(Optimize_IsLeaf(arg0), 0) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition EqualTo(Optimize_IsLeaf(arg1), 0) ThenBlock: {
            ReturnValue(0)
        }
        result = CompileCompare_Binary(node)
        IfCondition EqualTo(result, 0) ThenBlock: {
            ReturnValue(2)
        }
        Optimize_JumpIfFalse(name, false_label)
        ReturnValue(1)
    }
}

// A compare can become a conditional move when both arms store the same
// accumulator. rsi holds the true value. Integer arithmetic and compares
// do not write rsi, and parameters are already spilled off it. r15 stays
// the pool base. Returns 1..6 for the true-condition cmov, else 0.
Function.Optimize_FlagCode {
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(StringCompare(name, "EqualTo"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "NotEqual"), 0) ThenBlock: { ReturnValue(2) }
        IfCondition EqualTo(StringCompare(name, "LessThan"), 0) ThenBlock: { ReturnValue(3) }
        IfCondition EqualTo(StringCompare(name, "GreaterThan"), 0) ThenBlock: { ReturnValue(4) }
        IfCondition EqualTo(StringCompare(name, "LessEqual"), 0) ThenBlock: { ReturnValue(5) }
        IfCondition EqualTo(StringCompare(name, "GreaterEqual"), 0) ThenBlock: { ReturnValue(6) }
        ReturnValue(0)
    }
}

// BitwiseAnd with 1 keeps one bit. A product's low bit is the AND of the
// factors' low bits, so an odd constant factor drops out and an even one
// forces the bit to 0. Equality with 0 or 1 is then TEST, and the
// accumulator select can cmov. Class 1 is constant 0, 2 is constant 1,
// 3 is the node left in OptState.parity_node. Two dynamic factors stay
// on the ordinary compare.
Function.Optimize_IsAndName {
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(StringCompare(name, "BitwiseAnd"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "BitAnd"), 0) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

Function.Optimize_IsOneNum {
    Input: node: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(node), AST.NUMBER) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(StringToNumber(AST_GetData1(node)), 1) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

Function.Optimize_LowClass {
    Input: node: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(node), AST.CALL) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_IsAndName(AST_GetData1(node)), 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetChildCount(node), 2) ThenBlock: { ReturnValue(0) }
        a0 = AST_GetChild(node, 0)
        a1 = AST_GetChild(node, 1)
        inner = 0
        IfCondition EqualTo(Optimize_IsOneNum(a1), 1) ThenBlock: { inner = a0 }
        IfCondition EqualTo(inner, 0) ThenBlock: {
            IfCondition EqualTo(Optimize_IsOneNum(a0), 1) ThenBlock: { inner = a1 }
        }
        IfCondition EqualTo(inner, 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(Optimize_LowFactor(inner))
    }
}

Function.Optimize_LowFactor {
    Input: node: Address
    Output: Integer
    Body: {
        OptState.parity_node = 0
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        nt = AST_GetType(node)
        IfCondition EqualTo(nt, AST.NUMBER) ThenBlock: {
            bit = BitwiseAnd(StringToNumber(AST_GetData1(node)), 1)
            IfCondition EqualTo(bit, 0) ThenBlock: { ReturnValue(1) }
            ReturnValue(2)
        }
        IfCondition EqualTo(nt, AST.IDENTIFIER) ThenBlock: {
            OptState.parity_node = node
            ReturnValue(3)
        }
        IfCondition NotEqual(nt, AST.CALL) ThenBlock: { ReturnValue(0) }
        fname = AST_GetData1(node)
        is_mul = EqualTo(StringCompare(fname, "Multiply"), 0)
        is_and = Optimize_IsAndName(fname)
        IfCondition EqualTo(is_mul, 0) ThenBlock: {
            IfCondition EqualTo(is_and, 0) ThenBlock: { ReturnValue(0) }
        }
        IfCondition NotEqual(AST_GetChildCount(node), 2) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(is_and, 1) ThenBlock: {
            ReturnValue(Optimize_LowClass(node))
        }
        c0 = Optimize_LowFactor(AST_GetChild(node, 0))
        n0 = OptState.parity_node
        c1 = Optimize_LowFactor(AST_GetChild(node, 1))
        n1 = OptState.parity_node
        IfCondition EqualTo(c0, 0) ThenBlock: {
            OptState.parity_node = 0
            ReturnValue(0)
        }
        IfCondition EqualTo(c1, 0) ThenBlock: {
            OptState.parity_node = 0
            ReturnValue(0)
        }
        IfCondition EqualTo(c0, 1) ThenBlock: {
            OptState.parity_node = 0
            ReturnValue(1)
        }
        IfCondition EqualTo(c1, 1) ThenBlock: {
            OptState.parity_node = 0
            ReturnValue(1)
        }
        IfCondition EqualTo(c0, 2) ThenBlock: {
            IfCondition EqualTo(c1, 2) ThenBlock: {
                OptState.parity_node = 0
                ReturnValue(2)
            }
            OptState.parity_node = n1
            ReturnValue(c1)
        }
        IfCondition EqualTo(c1, 2) ThenBlock: {
            OptState.parity_node = n0
            ReturnValue(c0)
        }
        OptState.parity_node = 0
        ReturnValue(0)
    }
}

// 1 means the true arm is the clear bit (CMOVE). 2 means the set bit (CMOVNE).
Function.Optimize_ParityCode {
    Input: node: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(node), AST.CALL) ThenBlock: { ReturnValue(0) }
        name = AST_GetData1(node)
        eq = EqualTo(StringCompare(name, "EqualTo"), 0)
        ne = EqualTo(StringCompare(name, "NotEqual"), 0)
        IfCondition EqualTo(eq, 0) ThenBlock: {
            IfCondition EqualTo(ne, 0) ThenBlock: { ReturnValue(0) }
        }
        IfCondition NotEqual(AST_GetChildCount(node), 2) ThenBlock: { ReturnValue(0) }
        a0 = AST_GetChild(node, 0)
        a1 = AST_GetChild(node, 1)
        imm = -1
        expr = 0
        IfCondition EqualTo(AST_GetType(a1), AST.NUMBER) ThenBlock: {
            imm = StringToNumber(AST_GetData1(a1))
            expr = a0
        }
        IfCondition EqualTo(expr, 0) ThenBlock: {
            IfCondition EqualTo(AST_GetType(a0), AST.NUMBER) ThenBlock: {
                imm = StringToNumber(AST_GetData1(a0))
                expr = a1
            }
        }
        IfCondition EqualTo(expr, 0) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterThan(imm, 1) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(imm, 0) ThenBlock: { ReturnValue(0) }
        cls = Optimize_LowClass(expr)
        IfCondition EqualTo(cls, 0) ThenBlock: {
            OptState.parity_cls = 0
            ReturnValue(0)
        }
        OptState.parity_cls = cls
        want_clear = 0
        IfCondition EqualTo(eq, 1) ThenBlock: {
            IfCondition EqualTo(imm, 0) ThenBlock: { want_clear = 1 }
        }
        IfCondition EqualTo(ne, 1) ThenBlock: {
            IfCondition EqualTo(imm, 1) ThenBlock: { want_clear = 1 }
        }
        IfCondition EqualTo(want_clear, 1) ThenBlock: { ReturnValue(1) }
        ReturnValue(2)
    }
}

Function.Optimize_EmitLowBit {
    Output: Integer
    Body: {
        cls = OptState.parity_cls
        src = OptState.parity_node
        IfCondition EqualTo(cls, 1) ThenBlock: {
            Emit_XorRaxRax()
            Emit_TestRaxRax()
            ReturnValue(1)
        }
        IfCondition EqualTo(cls, 2) ThenBlock: {
            Emit_MovRaxImm64(1)
            Emit_TestRaxRax()
            ReturnValue(1)
        }
        IfCondition NotEqual(cls, 3) ThenBlock: { ReturnValue(2) }
        IfCondition EqualTo(src, 0) ThenBlock: { ReturnValue(2) }
        IfCondition EqualTo(Optimize_IdentEq(src, LoopHome.int_name), 1) ThenBlock: {
            asm = "TEST r13, "
            nstr = NumberToString(1)
            asm = StringConcat(asm, nstr)
            X86Enc_Assemble(asm)
            ReturnValue(1)
        }
        result = Compile_Expression(src)
        IfCondition EqualTo(result, 0) ThenBlock: { ReturnValue(2) }
        asm2 = "TEST rax, "
        nstr2 = NumberToString(1)
        asm2 = StringConcat(asm2, nstr2)
        X86Enc_Assemble(asm2)
        ReturnValue(1)
    }
}

Function.Optimize_FlagReady {
    Input: node: Address
    Output: Integer
    Body: {
        pcode = Optimize_ParityCode(node)
        IfCondition NotEqual(pcode, 0) ThenBlock: { ReturnValue(pcode) }
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(node), AST.CALL) ThenBlock: { ReturnValue(0) }
        code = Optimize_FlagCode(AST_GetData1(node))
        IfCondition EqualTo(code, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetChildCount(node), 2) ThenBlock: { ReturnValue(0) }
        arg0 = AST_GetChild(node, 0)
        arg1 = AST_GetChild(node, 1)
        other = 0
        IfCondition EqualTo(Optimize_IsZeroNum(arg1), 1) ThenBlock: {
            IfCondition EqualTo(Optimize_IsLeaf(arg0), 0) ThenBlock: { other = arg0 }
        }
        IfCondition EqualTo(other, 0) ThenBlock: {
            IfCondition EqualTo(Optimize_IsZeroNum(arg0), 1) ThenBlock: {
                IfCondition EqualTo(Optimize_IsLeaf(arg1), 0) ThenBlock: { other = arg1 }
            }
        }
        IfCondition NotEqual(other, 0) ThenBlock: {
            // TEST of the right-hand value matches every compare with zero.
            // TEST of the left-hand value matches only equality.
            IfCondition EqualTo(Optimize_IsZeroNum(arg0), 1) ThenBlock: {
                IfCondition GreaterThan(code, 2) ThenBlock: { ReturnValue(0) }
            }
            ReturnValue(code)
        }
        IfCondition EqualTo(Optimize_IsLeaf(arg0), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_IsLeaf(arg1), 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(code)
    }
}

// Integer ops whose emitted code leaves rsi alone. Calls, memory copies,
// and float transcendentals do not.
Function.Optimize_RsiSafeName {
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(StringCompare(name, "Add"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "Subtract"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "Multiply"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "Divide"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "Modulo"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "Negate"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "EqualTo"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "NotEqual"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "LessThan"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "GreaterThan"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "LessEqual"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "GreaterEqual"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "BitwiseAnd"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "BitwiseOr"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "BitwiseXor"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "BitwiseNot"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "LeftShift"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "RightShift"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "BitAnd"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "BitOr"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "BitXor"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "BitNot"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "ShiftLeft"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "ShiftRight"), 0) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

Function.Optimize_KeepsRsi {
    Input: node: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        nt = AST_GetType(node)
        IfCondition EqualTo(nt, AST.NUMBER) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(nt, AST.IDENTIFIER) ThenBlock: { ReturnValue(1) }
        IfCondition NotEqual(nt, AST.CALL) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_RsiSafeName(AST_GetData1(node)), 0) ThenBlock: { ReturnValue(0) }
        count = AST_GetChildCount(node)
        i = 0
        WhileLoop LessThan(i, count) {
            IfCondition EqualTo(Optimize_KeepsRsi(AST_GetChild(node, i)), 0) ThenBlock: { ReturnValue(0) }
            i = Add(i, 1)
        }
        ReturnValue(1)
    }
}

Function.Optimize_OnlyStmt {
    Input: block: Address
    Output: Address
    Body: {
        IfCondition EqualTo(block, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(block), AST.BLOCK) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetChildCount(block), 1) ThenBlock: { ReturnValue(0) }
        ReturnValue(AST_GetChild(block, 0))
    }
}

// 1 = add imm, 2 = subtract imm, 0 = not an accumulator constant update.
// The magnitude is left in LoopHome.hit_disp.
Function.Optimize_AccDelta {
    Input: stmt: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(Optimize_PlainAssign(stmt), 0) ThenBlock: { ReturnValue(0) }
        target = AST_GetData1(stmt)
        value = AST_GetChild(stmt, 0)
        cls = Optimize_AccShape(target, value)
        IfCondition NotEqual(cls, 7) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_Fit32(LoopHome.hit_disp), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(StringCompare(AST_GetData1(value), "Subtract"), 0) ThenBlock: { ReturnValue(2) }
        ReturnValue(1)
    }
}

Function.Optimize_EmitRsiDelta {
    Input: kind: Integer
    Input: imm: Integer
    Body: {
        IfCondition EqualTo(kind, 2) ThenBlock: {
            asm = "SUB rsi, "
            nstr = NumberToString(imm)
            asm = StringConcat(asm, nstr)
            X86Enc_Assemble(asm)
        }
        IfCondition EqualTo(kind, 1) ThenBlock: {
            asm = "ADD rsi, "
            nstr = NumberToString(imm)
            asm = StringConcat(asm, nstr)
            X86Enc_Assemble(asm)
        }
    }
}

Function.Optimize_EmitCmov {
    Input: code: Integer
    Body: {
        IfCondition EqualTo(code, 1) ThenBlock: { X86Enc_Assemble("CMOVE r12, rsi") }
        IfCondition EqualTo(code, 2) ThenBlock: { X86Enc_Assemble("CMOVNE r12, rsi") }
        IfCondition EqualTo(code, 3) ThenBlock: { X86Enc_Assemble("CMOVL r12, rsi") }
        IfCondition EqualTo(code, 4) ThenBlock: { X86Enc_Assemble("CMOVG r12, rsi") }
        IfCondition EqualTo(code, 5) ThenBlock: { X86Enc_Assemble("CMOVLE r12, rsi") }
        IfCondition EqualTo(code, 6) ThenBlock: { X86Enc_Assemble("CMOVGE r12, rsi") }
    }
}

// Unsigned compare of 64-bit patterns. Flipping the sign bit turns it
// into a signed compare.
Function.Optimize_ULt {
    Input: a: Integer
    Input: b: Integer
    Output: Integer
    Body: {
        hibit = LeftShift(1, 63)
        fa = BitwiseXor(a, hibit)
        fb = BitwiseXor(b, hibit)
        ReturnValue(LessThan(fa, fb))
    }
}

Function.Optimize_UGe {
    Input: a: Integer
    Input: b: Integer
    Output: Integer
    Body: {
        hibit = LeftShift(1, 63)
        fa = BitwiseXor(a, hibit)
        fb = BitwiseXor(b, hibit)
        ReturnValue(EqualTo(LessThan(fa, fb), 0))
    }
}

// A conditional or a loop can skip the assignment, so it does not dominate.
Function.Optimize_BindSkip {
    Input: nt: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(nt, AST.IF) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(nt, AST.WHILE) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(nt, AST.FOR_EVERY) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(nt, AST.SWITCH) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(nt, AST.TRY) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(nt, AST.CATCH) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(nt, AST.BRANCH) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(nt, AST.UNTIL) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(nt, AST.FORK) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(nt, AST.DEFER) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(nt, AST.LOOP_MAIN) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(nt, AST.LOOP_ACTOR) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(nt, AST.LOOP_START) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(nt, AST.LOOP_SHADOW) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(nt, AST.EVERY_INTERVAL) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(nt, AST.LAMBDA_EXPR) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

Function.Optimize_BindWalk {
    Input: node: Address
    Input: name: Address
    Input: use: Address
    Input: guard: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(node, use) ThenBlock: {
            IfCondition EqualTo(OptState.bind_seen, 0) ThenBlock: {
                OptState.bind_late = 1
            }
        }
        nt = AST_GetType(node)
        next_guard = guard
        IfCondition EqualTo(Optimize_BindSkip(nt), 1) ThenBlock: { next_guard = 1 }
        IfCondition EqualTo(nt, AST.FUNCTION) ThenBlock: {
            IfCondition NotEqual(node, OptState.bind_root) ThenBlock: { next_guard = 1 }
        }
        IfCondition EqualTo(nt, AST.SUBROUTINE) ThenBlock: {
            IfCondition NotEqual(node, OptState.bind_root) ThenBlock: { next_guard = 1 }
        }
        IfCondition EqualTo(nt, AST.CALL) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(AST_GetData1(node), "AddressOf"), 1) ThenBlock: {
                IfCondition GreaterThan(AST_GetChildCount(node), 0) ThenBlock: {
                    op0 = AST_GetChild(node, 0)
                    IfCondition NotEqual(op0, 0) ThenBlock: {
                        IfCondition EqualTo(AST_GetType(op0), AST.IDENTIFIER) ThenBlock: {
                            IfCondition EqualTo(Optimize_NameEq(AST_GetData1(op0), name), 1) ThenBlock: {
                                OptState.bind_bad = 1
                            }
                        }
                    }
                }
            }
        }
        IfCondition EqualTo(nt, AST.ASSIGNMENT) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(AST_GetData1(node), name), 1) ThenBlock: {
                OptState.bind_n = Add(OptState.bind_n, 1)
                plain = 0
                IfCondition EqualTo(AST_GetData2(node), 0) ThenBlock: { plain = 1 }
                rhs = AST_GetChild(node, 0)
                rhs_num = 0
                IfCondition NotEqual(rhs, 0) ThenBlock: {
                    IfCondition EqualTo(AST_GetType(rhs), AST.NUMBER) ThenBlock: { rhs_num = 1 }
                }
                take = 0
                IfCondition EqualTo(plain, 1) ThenBlock: {
                    IfCondition EqualTo(guard, 0) ThenBlock: {
                        IfCondition EqualTo(rhs_num, 1) ThenBlock: {
                            IfCondition EqualTo(OptState.bind_seen, 0) ThenBlock: { take = 1 }
                        }
                    }
                }
                IfCondition EqualTo(take, 1) ThenBlock: {
                    OptState.bind_val = StringToNumber(AST_GetData1(rhs))
                    OptState.bind_seen = 1
                } ElseBlock: {
                    OptState.bind_bad = 1
                }
            }
        }
        count = AST_GetChildCount(node)
        i = 0
        WhileLoop LessThan(i, count) {
            Optimize_BindWalk(AST_GetChild(node, i), name, use, next_guard)
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

// One straight-line number assignment dominates a later use. A second
// assignment, or one inside a conditional or loop, is not constant.
Function.Optimize_BindConst {
    Input: name: Address
    Input: use: Address
    Output: Integer
    Body: {
        OptState.bind_n = 0
        OptState.bind_bad = 0
        OptState.bind_val = 0
        OptState.bind_seen = 0
        OptState.bind_late = 0
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Compile.current_func, 0) ThenBlock: { ReturnValue(0) }
        OptState.bind_root = Compile.current_func
        Optimize_BindWalk(Compile.current_func, name, use, 0)
        IfCondition NotEqual(OptState.bind_n, 1) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(OptState.bind_bad, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(OptState.bind_late, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(OptState.bind_seen, 1) ThenBlock: { ReturnValue(0) }
        ReturnValue(1)
    }
}

// Magic number for toward-zero division by abs(d). The divisor here is a
// value, so the Divide and Modulo below stay on IDIV. Negative divisors
// use the same magnitude and negate the quotient. -1, 0, 1, and INT64_MIN
// fail open.
Function.Optimize_MagicPrepare {
    Input: d: Integer
    Output: Integer
    Body: {
        hibit = LeftShift(1, 63)
        IfCondition EqualTo(d, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(d, 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(d, -1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(d, hibit) ThenBlock: { ReturnValue(0) }
        neg = 0
        ad = d
        IfCondition LessThan(d, 0) ThenBlock: {
            neg = 1
            ad = Subtract(0, d)
        }
        IfCondition LessThan(ad, 2) ThenBlock: { ReturnValue(0) }
        urem = Subtract(0, Modulo(hibit, ad))
        anc = Subtract(Subtract(hibit, 1), urem)
        IfCondition EqualTo(anc, 0) ThenBlock: { ReturnValue(0) }
        q1 = Subtract(0, Divide(hibit, anc))
        r1 = Subtract(0, Modulo(hibit, anc))
        q2 = Subtract(0, Divide(hibit, ad))
        r2 = urem
        steps = 0
        again = 1
        bad = 0
        WhileLoop EqualTo(again, 1) {
            q1 = LeftShift(q1, 1)
            r1 = LeftShift(r1, 1)
            q2 = LeftShift(q2, 1)
            r2 = LeftShift(r2, 1)
            IfCondition EqualTo(Optimize_UGe(r1, anc), 1) ThenBlock: {
                q1 = Add(q1, 1)
                r1 = Subtract(r1, anc)
            }
            IfCondition EqualTo(Optimize_UGe(r2, ad), 1) ThenBlock: {
                q2 = Add(q2, 1)
                r2 = Subtract(r2, ad)
            }
            steps = Add(steps, 1)
            delta = Subtract(ad, r2)
            cont = 0
            IfCondition EqualTo(Optimize_ULt(q1, delta), 1) ThenBlock: { cont = 1 }
            IfCondition EqualTo(q1, delta) ThenBlock: {
                IfCondition EqualTo(r1, 0) ThenBlock: { cont = 1 }
            }
            IfCondition EqualTo(cont, 0) ThenBlock: {
                again = 0
            } ElseBlock: {
                IfCondition GreaterEqual(steps, 64) ThenBlock: {
                    bad = 1
                    again = 0
                }
            }
        }
        IfCondition EqualTo(bad, 1) ThenBlock: { ReturnValue(0) }
        OptState.magic_m = Add(q2, 1)
        OptState.magic_sh = Subtract(steps, 1)
        OptState.magic_neg = neg
        ReturnValue(1)
    }
}

// Modulo of the integer home by a positive power of two is a mask test
// when the dividend is non-negative. ZF then matches a compare with zero.
Function.Optimize_TryModFlag {
    Input: node: Address
    Input: code: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterThan(code, 2) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(node), AST.CALL) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(StringCompare(AST_GetData1(node), "Modulo"), 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetChildCount(node), 2) ThenBlock: { ReturnValue(0) }
        a0 = AST_GetChild(node, 0)
        a1 = AST_GetChild(node, 1)
        IfCondition EqualTo(Optimize_IdentEq(a0, LoopHome.int_name), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_ReadImm(a1), 0) ThenBlock: { ReturnValue(0) }
        val = LoopHome.imm_val
        IfCondition LessEqual(val, 0) ThenBlock: { ReturnValue(0) }
        mask = Subtract(val, 1)
        IfCondition NotEqual(BitwiseAnd(val, mask), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_Fit32(mask), 0) ThenBlock: { ReturnValue(0) }
        saved_lo = LoopHome.range_lo
        saved_hi = LoopHome.range_hi
        proved = Optimize_NonNeg(a0)
        LoopHome.range_lo = saved_lo
        LoopHome.range_hi = saved_hi
        IfCondition EqualTo(proved, 0) ThenBlock: { ReturnValue(0) }
        asm = "TEST r13, "
        nstr = NumberToString(mask)
        asm = StringConcat(asm, nstr)
        X86Enc_Assemble(asm)
        ReturnValue(1)
    }
}

Function.Optimize_EmitFlags {
    Input: node: Address
    Input: code: Integer
    Output: Integer
    Body: {
        pcode = Optimize_ParityCode(node)
        IfCondition NotEqual(pcode, 0) ThenBlock: {
            ReturnValue(Optimize_EmitLowBit())
        }
        arg0 = AST_GetChild(node, 0)
        arg1 = AST_GetChild(node, 1)
        other = 0
        IfCondition EqualTo(Optimize_IsZeroNum(arg1), 1) ThenBlock: {
            IfCondition EqualTo(Optimize_IsLeaf(arg0), 0) ThenBlock: { other = arg0 }
        }
        IfCondition EqualTo(other, 0) ThenBlock: {
            IfCondition EqualTo(Optimize_IsZeroNum(arg0), 1) ThenBlock: {
                IfCondition EqualTo(Optimize_IsLeaf(arg1), 0) ThenBlock: { other = arg1 }
            }
        }
        IfCondition NotEqual(other, 0) ThenBlock: {
            IfCondition EqualTo(Optimize_TryModFlag(other, code), 1) ThenBlock: { ReturnValue(1) }
            result = Compile_Expression(other)
            IfCondition EqualTo(result, 0) ThenBlock: { ReturnValue(2) }
            Emit_TestRaxRax()
            ReturnValue(1)
        }
        result = CompileCompare_Binary(node)
        IfCondition EqualTo(result, 0) ThenBlock: { ReturnValue(2) }
        ReturnValue(1)
    }
}

// Both arms assign the r12 accumulator by a constant. The false update is
// applied first. CMOVcc writes the true value when the compare is true.
// Refused when the condition names that accumulator or can write rsi.
Function.Optimize_TryIfSelect {
    Input: condition: Address
    Input: then_block: Address
    Input: else_block: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(LoopHome.active, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(LoopHome.acc_name, 0) ThenBlock: { ReturnValue(0) }
        then_stmt = Optimize_OnlyStmt(then_block)
        else_stmt = Optimize_OnlyStmt(else_block)
        IfCondition EqualTo(then_stmt, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(else_stmt, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_PlainAssign(then_stmt), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_PlainAssign(else_stmt), 0) ThenBlock: { ReturnValue(0) }
        tname = AST_GetData1(then_stmt)
        ename = AST_GetData1(else_stmt)
        IfCondition EqualTo(Optimize_NameEq(tname, ename), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_IsAccHome(tname), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_TreeHasName(condition, tname), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_KeepsRsi(condition), 0) ThenBlock: { ReturnValue(0) }
        code = Optimize_FlagReady(condition)
        IfCondition EqualTo(code, 0) ThenBlock: { ReturnValue(0) }
        saved_class = LoopHome.hit_class
        saved_disp = LoopHome.hit_disp
        saved_imm = LoopHome.imm_val
        saved_ok = LoopHome.imm_ok
        tdelta = Optimize_AccDelta(then_stmt)
        timm = LoopHome.hit_disp
        edelta = 0
        eimm = 0
        IfCondition NotEqual(tdelta, 0) ThenBlock: {
            edelta = Optimize_AccDelta(else_stmt)
            eimm = LoopHome.hit_disp
        }
        LoopHome.hit_class = saved_class
        LoopHome.hit_disp = saved_disp
        LoopHome.imm_val = saved_imm
        LoopHome.imm_ok = saved_ok
        IfCondition EqualTo(tdelta, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(edelta, 0) ThenBlock: { ReturnValue(0) }
        X86Enc_Assemble("MOV rsi, r12")
        Optimize_EmitRsiDelta(tdelta, timm)
        IfCondition EqualTo(edelta, 2) ThenBlock: { Emit_HomeMove(42, eimm) }
        IfCondition EqualTo(edelta, 1) ThenBlock: { Emit_HomeMove(41, eimm) }
        got = Optimize_EmitFlags(condition, code)
        IfCondition EqualTo(got, 2) ThenBlock: { ReturnValue(2) }
        IfCondition EqualTo(got, 0) ThenBlock: { ReturnValue(2) }
        Optimize_EmitCmov(code)
        ReturnValue(1)
    }
}

// =============================================================================
// LOOP HOMES
// One integer home (r13), one accumulator (r12), and up to four float homes
// (xmm2 plus xmm3/xmm4/xmm5). A call spills r13 and xmm2-xmm5 unless every
// reachable body in this compile is free of loops, InlineAsm, and fused
// multiply-add, and every call is one of those bodies or an inlined builtin
// that leaves those registers alone. An unknown callee keeps the spill.
// The hold in xmm0 still flushes. A nested loop in the caller turns homes off.
// Kind values for Emit_HomeMove are the only place r13/xmm2/r12 are named.
// =============================================================================
FixedPool.LoopHome {
    "active": Initialize=0, CanChange=True
    "blocked": Initialize=0, CanChange=True
    "no_float": Initialize=0, CanChange=True
    "count": Initialize=0, CanChange=True
    "recs": Initialize=0, CanChange=True
    "int_name": Initialize=0, CanChange=True
    "int_off": Initialize=0, CanChange=True
    "flt_name": Initialize=0, CanChange=True
    "flt_off": Initialize=0, CanChange=True
    "assign_name": Initialize=0, CanChange=True
    "imm_ok": Initialize=0, CanChange=True
    "imm_val": Initialize=0, CanChange=True
    "acc_name": Initialize=0, CanChange=True
    "acc_off": Initialize=0, CanChange=True
