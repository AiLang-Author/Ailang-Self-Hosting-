// Library.CHaikuEmit.ailang
// --haiku code emission: the call stub into the runtime syscall shim
// (Librarys/Haiku/Library.HaikuRT, HaikuSys_Call) and the inline
// anonymous-memory sequence used before that shim can run.
//
// Every Linux syscall in a --haiku program goes through HaikuSys_Call,
// which translates numbers, arguments, flags, /proc paths and errors.
// The stub must look like a raw SYSCALL to the surrounding code: only
// RAX (result), RCX and R11 may change.
//
// Copyright (c) 2026 Sean Collins, 2 Paws Machine and Engineering. All rights reserved.
// Licensed under the Sean Collins Software License (SCSL).

LibraryImport.Compiler.CodeEmit.CEmitTypes
LibraryImport.Compiler.CodeEmit.CEmitCore
LibraryImport.Compiler.CodeEmit.CEmitCoreArch
LibraryImport.Compiler.Compile.CCompileMain

FixedPool.HaikuEmit {
    // "ailmmap\0" little-endian: the area name pushed for create_area.
    "AREA_NAME": Initialize=31632320006744417
    "PAGE_ROUND": Initialize=4095
    "ENOMEM": Initialize=-12
}

// R15 byte offset of a pool member such as "HaikuRT.a6", or -1.
Function.Haiku_PoolOffset {
    Input: name: Address
    Output: Integer
    Body: {
        count = Array.Size(Compile.variables)
        i = 0
        WhileLoop LessThan(i, count) {
            entry = Array.Get(Compile.variables, i)
            IfCondition EqualTo(Dereference(Add(entry, 16)), VarType.POOL) ThenBlock: {
                IfCondition EqualTo(StringCompare(Dereference(entry), name), 0) ThenBlock: {
                    index = BitwiseAnd(Dereference(Add(entry, 8)), 2147483647)
                    ReturnValue(Multiply(index, 8))
                }
            }
            i = Add(i, 1)
        }
        ReturnValue(-1)
    }
}

// In:  RAX = Linux syscall number, RDI RSI RDX R10 R8 R9 = Linux args.
// Out: RAX = Linux-style result (negative errno on failure).
Function.Haiku_EmitShimCall {
    Body: {
        shim = Compile_FindFunction("HaikuSys_Call")
        a6_off = Haiku_PoolOffset("HaikuRT.a6")
        IfCondition LessThan(shim, 0) ThenBlock: {
            Compile_Error("--haiku: HaikuSys_Call missing (LibraryImport.Haiku.HaikuRT)", 0)
            ReturnValue(0)
        }
        IfCondition LessThan(a6_off, 0) ThenBlock: {
            Compile_Error("--haiku: HaikuRT.a6 pool slot missing", 0)
            ReturnValue(0)
        }

        Emit_PushRdi()
        Emit_PushRsi()
        Emit_PushRdx()
        Emit_PushR8()
        Emit_Byte(65)  Emit_Byte(81)     // push r9
        Emit_Byte(65)  Emit_Byte(82)     // push r10

        // mov [r15+a6_off], r9  (6th arg rides in a pool slot)
        Emit_Byte(77)  Emit_Byte(137)  Emit_Byte(143)
        Emit_Byte(BitwiseAnd(a6_off, 255))
        Emit_Byte(BitwiseAnd(RightShift(a6_off, 8), 255))
        Emit_Byte(BitwiseAnd(RightShift(a6_off, 16), 255))
        Emit_Byte(BitwiseAnd(RightShift(a6_off, 24), 255))

        // HaikuSys_Call(n, a1, a2, a3, a4, a5)
        Emit_MovRegReg(Reg.R9, Reg.R8)
        Emit_MovRegReg(Reg.R8, Reg.R10)
        Emit_MovRegReg(Reg.RCX, Reg.RDX)
        Emit_MovRegReg(Reg.RDX, Reg.RSI)
        Emit_MovRegReg(Reg.RSI, Reg.RDI)
        Emit_MovRegReg(Reg.RDI, Reg.RAX)

        Emit_PushRbx()
        Emit_MovRegReg(Reg.RBX, Reg.RSP)
        Emit_AndRspImm8(240)
        Emit_Call(shim)
        Emit_MovRegReg(Reg.RSP, Reg.RBX)
        Emit_PopRbx()

        Emit_PopR10()
        Emit_PopR9()
        Emit_PopR8()
        Emit_PopRdx()
        Emit_PopRsi()
        Emit_PopRdi()
        ReturnValue(1)
    }
}

// Inline anonymous map via _kern_create_area. Usable before R15 exists.
// In:  RSI = length, RDX = Linux PROT bits (same values as B_*_AREA).
// Out: RAX = address, or -ENOMEM. Clobbers RDI RSI RDX RCX R8 R9 R10 R11.
Function.Haiku_EmitAnonMap {
    Body: {
        fail = Emit_CreateLabel()
        done = Emit_CreateLabel()

        // r10 = round_up(len, 4096)
        Emit_MovRegReg(Reg.R10, Reg.RSI)
        Emit_Byte(73)  Emit_Byte(129)  Emit_Byte(194)               // add r10, 4095
        Emit_Byte(255) Emit_Byte(15)   Emit_Byte(0)    Emit_Byte(0)
        Emit_Byte(73)  Emit_Byte(129)  Emit_Byte(226)               // and r10, -4096
        Emit_Byte(0)   Emit_Byte(240)  Emit_Byte(255)  Emit_Byte(255)

        // r9 = prot | B_OVERCOMMITTING_AREA (Linux mmap never commits up front)
        Emit_MovRegReg(Reg.R9, Reg.RDX)
        Emit_Byte(73)  Emit_Byte(129)  Emit_Byte(201)               // or r9, 0x1000
        Emit_Byte(0)   Emit_Byte(16)   Emit_Byte(0)    Emit_Byte(0)

        Emit_XorRegReg(Reg.R8, Reg.R8)       // B_NO_LOCK
        Emit_XorRegReg(Reg.RDX, Reg.RDX)     // B_ANY_ADDRESS

        // [rsp] = name, [rsp+8] = address out
        Emit_XorRegReg(Reg.RAX, Reg.RAX)
        Emit_PushRax()
        Emit_MovRaxImm64(HaikuEmit.AREA_NAME)
        Emit_PushRax()
        Emit_MovRegReg(Reg.RDI, Reg.RSP)
        Emit_Byte(72)  Emit_Byte(141)  Emit_Byte(116)               // lea rsi, [rsp+8]
        Emit_Byte(36)  Emit_Byte(8)

        Emit_MovRaxImm64(HaikuSys.CREATE_AREA)
        Emit_SysInstr()
        Emit_PopRcx()
        Emit_PopRcx()

        // area_id is int32: sign-extend before testing
        Emit_Byte(72)  Emit_Byte(99)   Emit_Byte(192)               // movsxd rax, eax
        Emit_TestRaxRax()
        Emit_Js(fail)
        Emit_MovRegReg(Reg.RAX, Reg.RCX)
        Emit_Jmp(done)
        Emit_MarkLabel(fail)
        Emit_MovRaxImm64(HaikuEmit.ENOMEM)
        Emit_MarkLabel(done)
        ReturnValue(1)
    }
}

// Raw Haiku syscall with 7 or 8 arguments. The first six arguments are
// popped into RDI, RSI, RDX, R10, R8, R9. Argument 7 is stored at
// [rsp+8] and argument 8 at [rsp+16]. The kernel's syscall entry skips
// one dummy word at the user stack (interrupts.S .Lsyscall_stack_args
// does addq $8, %rsi on the saved user rsp), so those are arg7 and arg8.
// The caller then loads RAX, emits syscall, and Emit_AddRspImm8(32).
// Linux SystemCall never reaches this: only raw HaikuSyscall does.
Function.Haiku_EmitSyscall7Plus {
    Input: n: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(n, 8) ThenBlock: {
            Emit_PopRcx()
        } ElseBlock: {
            Emit_XorRcxRcx()
        }
        Emit_PopR11()
        Emit_PopR9()
        Emit_PopR8()
        Emit_PopR10()
        Emit_PopRdx()
        Emit_PopRsi()
        Emit_PopRdi()
        Emit_SubRspImm8(32)
        // mov [rsp+8], r11     4C 89 5C 24 08
        Emit_Byte(76)
        Emit_Byte(137)
        Emit_Byte(92)
        Emit_Byte(36)
        Emit_Byte(8)
        // mov [rsp+16], rcx    48 89 4C 24 10
        Emit_Byte(72)
        Emit_Byte(137)
        Emit_Byte(76)
        Emit_Byte(36)
        Emit_Byte(16)
        ReturnValue(1)
    }
}

// SYSCALL with RAX = Linux number and Linux argument registers.
// Linux: the instruction itself. Haiku: through the runtime shim.
Function.Emit_OsSyscall {
    Body: {
        IfCondition EqualTo(Emit.os, OS.HAIKU) ThenBlock: {
            Haiku_EmitShimCall()
        } ElseBlock: {
            Emit_SysInstr()
        }
    }
}
