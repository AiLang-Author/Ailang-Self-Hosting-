// =============================================================================
// Sys_SchedYield - Yield the processor
// Linux syscall 24: sched_yield()
// Registers: none
// =============================================================================
Function.Sys_SchedYield {
    Body: {
        // --- LINUX ---
        IfCondition EqualTo(Emit.os, OS.LINUX) ThenBlock: {
            Emit_MovRaxImm64(LinuxSys.SCHED_YIELD)
            Emit_SysInstr()
        }
        // --- HAIKU: No direct mapping ---
        IfCondition EqualTo(Emit.os, OS.HAIKU) ThenBlock: {
            // TODO: sched_yield has no Haiku equivalent
            Emit_MovRaxImm64(-1)  // Return error
        }
    }
}

