// #############################################################################
// FILE I/O
// #############################################################################


// =============================================================================
// Sys_Read - Read from file descriptor
// Linux syscall 0: read(fd, buf, count)
// Registers: RDI=fd, RSI=buf, RDX=count
// =============================================================================
Function.Sys_Read {
    Body: {
        // --- LINUX ---
        IfCondition EqualTo(Emit.os, OS.LINUX) ThenBlock: {
            Emit_MovRaxImm64(LinuxSys.READ)
            Emit_SysInstr()
        }
        // --- HAIKU ---
        IfCondition EqualTo(Emit.os, OS.HAIKU) ThenBlock: {
            // Haiku adds pos arg, use -1 for current
            // Shuffle: insert -1 for position
            Emit_MovRegReg(Reg.R10, Reg.RDX)  // len -> R10
            Emit_MovRegReg(Reg.RDX, Reg.RSI)  // buf -> RDX
            Emit_MovRsiImm64(-1)              // pos = -1
            Emit_MovRaxImm64(HaikuSys.READ)
            Emit_SysInstr()
        }
    }
}

// =============================================================================
// Sys_Write - Write to file descriptor
// Linux syscall 1: write(fd, buf, count)
// Registers: RDI=fd, RSI=buf, RDX=count
// =============================================================================
Function.Sys_Write {
    Body: {
        // --- LINUX ---
        IfCondition EqualTo(Emit.os, OS.LINUX) ThenBlock: {
            Emit_MovRaxImm64(LinuxSys.WRITE)
            Emit_SysInstr()
        }
        // --- HAIKU ---
        IfCondition EqualTo(Emit.os, OS.HAIKU) ThenBlock: {
            // Haiku adds pos arg, use -1 for current
            // Shuffle: insert -1 for position
            Emit_MovRegReg(Reg.R10, Reg.RDX)  // len -> R10
            Emit_MovRegReg(Reg.RDX, Reg.RSI)  // buf -> RDX
            Emit_MovRsiImm64(-1)              // pos = -1
            Emit_MovRaxImm64(HaikuSys.WRITE)
            Emit_SysInstr()
        }
    }
}

// =============================================================================
// Sys_Open - Open file
// Linux syscall 2: open(filename, flags, mode)
// Registers: RDI=filename, RSI=flags, RDX=mode
// =============================================================================
Function.Sys_Open {
    Body: {
        // --- LINUX ---
        IfCondition EqualTo(Emit.os, OS.LINUX) ThenBlock: {
            Emit_MovRaxImm64(LinuxSys.OPEN)
            Emit_SysInstr()
        }
        // --- HAIKU ---
        IfCondition EqualTo(Emit.os, OS.HAIKU) ThenBlock: {
            // Haiku adds dirfd arg, use -1 for CWD
            // Shuffle: insert -1 for dirfd
            Emit_MovRegReg(Reg.R10, Reg.RDX)  // mode -> R10
            Emit_MovRegReg(Reg.RDX, Reg.RSI)  // flags -> RDX
            Emit_MovRegReg(Reg.RSI, Reg.RDI)  // path -> RSI
            Emit_MovRdiImm64(-1)              // dirfd = -1
            Emit_MovRaxImm64(HaikuSys.OPEN)
            Emit_SysInstr()
        }
    }
}

