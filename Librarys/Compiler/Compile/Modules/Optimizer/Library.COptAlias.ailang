// Library.COptAlias.ailang
// Name aliases, pointer copies, and field displacement.
// Loaded by the optimizer shell. No imports of its own.

// =============================================================================
// DEBUG CONTROL
// =============================================================================
Function.Optimize_NameEq {
    Input: a: Address
    Input: b: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(a, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(b, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(StringCompare(a, b), 0) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

Function.Optimize_AliasClearAll {
    Body: {
        LoopHome.a0_on = 0
        LoopHome.a1_on = 0
        LoopHome.a2_on = 0
        LoopHome.a3_on = 0
    }
}

Function.Optimize_AliasFind {
    Input: name: Address
    Output: Integer
    Body: {
        LoopHome.hit_on = 0
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(LoopHome.a0_on, 1) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(name, LoopHome.a0_name), 1) ThenBlock: {
                LoopHome.hit_on = 1
                LoopHome.hit_disp = LoopHome.a0_disp
                ReturnValue(1)
            }
        }
        IfCondition EqualTo(LoopHome.a1_on, 1) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(name, LoopHome.a1_name), 1) ThenBlock: {
                LoopHome.hit_on = 1
                LoopHome.hit_disp = LoopHome.a1_disp
                ReturnValue(1)
            }
        }
        IfCondition EqualTo(LoopHome.a2_on, 1) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(name, LoopHome.a2_name), 1) ThenBlock: {
                LoopHome.hit_on = 1
                LoopHome.hit_disp = LoopHome.a2_disp
                ReturnValue(1)
            }
        }
        IfCondition EqualTo(LoopHome.a3_on, 1) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(name, LoopHome.a3_name), 1) ThenBlock: {
                LoopHome.hit_on = 1
                LoopHome.hit_disp = LoopHome.a3_disp
                ReturnValue(1)
            }
        }
        ReturnValue(0)
    }
}

Function.Optimize_AliasClear {
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(LoopHome.a0_on, 1) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(name, LoopHome.a0_name), 1) ThenBlock: { LoopHome.a0_on = 0 }
        }
        IfCondition EqualTo(LoopHome.a1_on, 1) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(name, LoopHome.a1_name), 1) ThenBlock: { LoopHome.a1_on = 0 }
        }
        IfCondition EqualTo(LoopHome.a2_on, 1) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(name, LoopHome.a2_name), 1) ThenBlock: { LoopHome.a2_on = 0 }
        }
        IfCondition EqualTo(LoopHome.a3_on, 1) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(name, LoopHome.a3_name), 1) ThenBlock: { LoopHome.a3_on = 0 }
        }
        ReturnValue(0)
    }
}

Function.Optimize_AliasAdd {
    Input: name: Address
    Input: disp: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(Optimize_AliasFind(name), 1) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(name, LoopHome.a0_name), 1) ThenBlock: {
                IfCondition EqualTo(LoopHome.a0_on, 1) ThenBlock: {
                    LoopHome.a0_disp = disp
                    ReturnValue(1)
                }
            }
            IfCondition EqualTo(Optimize_NameEq(name, LoopHome.a1_name), 1) ThenBlock: {
                IfCondition EqualTo(LoopHome.a1_on, 1) ThenBlock: {
                    LoopHome.a1_disp = disp
                    ReturnValue(1)
                }
            }
            IfCondition EqualTo(Optimize_NameEq(name, LoopHome.a2_name), 1) ThenBlock: {
                IfCondition EqualTo(LoopHome.a2_on, 1) ThenBlock: {
                    LoopHome.a2_disp = disp
                    ReturnValue(1)
                }
            }
            IfCondition EqualTo(Optimize_NameEq(name, LoopHome.a3_name), 1) ThenBlock: {
                IfCondition EqualTo(LoopHome.a3_on, 1) ThenBlock: {
                    LoopHome.a3_disp = disp
                    ReturnValue(1)
                }
            }
        }
        IfCondition EqualTo(LoopHome.a0_on, 0) ThenBlock: {
            LoopHome.a0_on = 1
            LoopHome.a0_name = name
            LoopHome.a0_disp = disp
            ReturnValue(1)
        }
        IfCondition EqualTo(LoopHome.a1_on, 0) ThenBlock: {
            LoopHome.a1_on = 1
            LoopHome.a1_name = name
            LoopHome.a1_disp = disp
            ReturnValue(1)
        }
        IfCondition EqualTo(LoopHome.a2_on, 0) ThenBlock: {
            LoopHome.a2_on = 1
            LoopHome.a2_name = name
            LoopHome.a2_disp = disp
            ReturnValue(1)
        }
        IfCondition EqualTo(LoopHome.a3_on, 0) ThenBlock: {
            LoopHome.a3_on = 1
            LoopHome.a3_name = name
            LoopHome.a3_disp = disp
            ReturnValue(1)
        }
        ReturnValue(0)
    }
}

Function.Optimize_AliasFlush {
    Body: {
        on0 = LoopHome.a0_on
        n0 = LoopHome.a0_name
        d0 = LoopHome.a0_disp
        on1 = LoopHome.a1_on
        n1 = LoopHome.a1_name
        d1 = LoopHome.a1_disp
        on2 = LoopHome.a2_on
        n2 = LoopHome.a2_name
        d2 = LoopHome.a2_disp
        on3 = LoopHome.a3_on
        n3 = LoopHome.a3_name
        d3 = LoopHome.a3_disp
        Optimize_AliasClearAll()
        IfCondition EqualTo(on0, 1) ThenBlock: {
            Emit_HomeMove(12, d0)
            CompileExpr_StoreVariable(n0)
        }
        IfCondition EqualTo(on1, 1) ThenBlock: {
            Emit_HomeMove(12, d1)
            CompileExpr_StoreVariable(n1)
        }
        IfCondition EqualTo(on2, 1) ThenBlock: {
            Emit_HomeMove(12, d2)
            CompileExpr_StoreVariable(n2)
        }
        IfCondition EqualTo(on3, 1) ThenBlock: {
            Emit_HomeMove(12, d3)
            CompileExpr_StoreVariable(n3)
        }
    }
}

Function.Optimize_AliasOnCursor {
    Body: {
        Optimize_PtrClearAll()
        IfCondition EqualTo(LoopHome.alias_spill, 1) ThenBlock: {
            Optimize_AliasFlush()
        } ElseBlock: {
            Optimize_AliasClearAll()
        }
    }
}

// A pointer alias says the local holds the homed cursor plus a displacement.
// rec = cursor, then rec@w, is the same address as Dereference(Add(cursor, 8)).
// The field load uses r13. The null test stays on the stack-reload path.
Function.Optimize_PtrClearAll {
    Body: {
        LoopHome.p0_on = 0
        LoopHome.p1_on = 0
        LoopHome.p2_on = 0
        LoopHome.p3_on = 0
    }
}

Function.Optimize_PtrFind {
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(LoopHome.p0_on, 1) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(name, LoopHome.p0_name), 1) ThenBlock: {
                LoopHome.hit_disp = LoopHome.p0_disp
                ReturnValue(1)
            }
        }
        IfCondition EqualTo(LoopHome.p1_on, 1) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(name, LoopHome.p1_name), 1) ThenBlock: {
                LoopHome.hit_disp = LoopHome.p1_disp
                ReturnValue(1)
            }
        }
        IfCondition EqualTo(LoopHome.p2_on, 1) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(name, LoopHome.p2_name), 1) ThenBlock: {
                LoopHome.hit_disp = LoopHome.p2_disp
                ReturnValue(1)
            }
        }
        IfCondition EqualTo(LoopHome.p3_on, 1) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(name, LoopHome.p3_name), 1) ThenBlock: {
                LoopHome.hit_disp = LoopHome.p3_disp
                ReturnValue(1)
            }
        }
        ReturnValue(0)
    }
}

Function.Optimize_PtrClear {
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(LoopHome.p0_on, 1) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(name, LoopHome.p0_name), 1) ThenBlock: { LoopHome.p0_on = 0 }
        }
        IfCondition EqualTo(LoopHome.p1_on, 1) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(name, LoopHome.p1_name), 1) ThenBlock: { LoopHome.p1_on = 0 }
        }
        IfCondition EqualTo(LoopHome.p2_on, 1) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(name, LoopHome.p2_name), 1) ThenBlock: { LoopHome.p2_on = 0 }
        }
        IfCondition EqualTo(LoopHome.p3_on, 1) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(name, LoopHome.p3_name), 1) ThenBlock: { LoopHome.p3_on = 0 }
        }
        ReturnValue(0)
    }
}

Function.Optimize_PtrAdd {
    Input: name: Address
    Input: disp: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(Optimize_PtrFind(name), 1) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(name, LoopHome.p0_name), 1) ThenBlock: {
                IfCondition EqualTo(LoopHome.p0_on, 1) ThenBlock: {
                    LoopHome.p0_disp = disp
                    ReturnValue(1)
                }
            }
            IfCondition EqualTo(Optimize_NameEq(name, LoopHome.p1_name), 1) ThenBlock: {
                IfCondition EqualTo(LoopHome.p1_on, 1) ThenBlock: {
                    LoopHome.p1_disp = disp
                    ReturnValue(1)
                }
            }
            IfCondition EqualTo(Optimize_NameEq(name, LoopHome.p2_name), 1) ThenBlock: {
                IfCondition EqualTo(LoopHome.p2_on, 1) ThenBlock: {
                    LoopHome.p2_disp = disp
                    ReturnValue(1)
                }
            }
            IfCondition EqualTo(Optimize_NameEq(name, LoopHome.p3_name), 1) ThenBlock: {
                IfCondition EqualTo(LoopHome.p3_on, 1) ThenBlock: {
                    LoopHome.p3_disp = disp
                    ReturnValue(1)
                }
            }
        }
        IfCondition EqualTo(LoopHome.p0_on, 0) ThenBlock: {
            LoopHome.p0_on = 1
            LoopHome.p0_name = name
            LoopHome.p0_disp = disp
            ReturnValue(1)
        }
        IfCondition EqualTo(LoopHome.p1_on, 0) ThenBlock: {
            LoopHome.p1_on = 1
            LoopHome.p1_name = name
            LoopHome.p1_disp = disp
            ReturnValue(1)
        }
        IfCondition EqualTo(LoopHome.p2_on, 0) ThenBlock: {
            LoopHome.p2_on = 1
            LoopHome.p2_name = name
            LoopHome.p2_disp = disp
            ReturnValue(1)
        }
        IfCondition EqualTo(LoopHome.p3_on, 0) ThenBlock: {
            LoopHome.p3_on = 1
            LoopHome.p3_name = name
            LoopHome.p3_disp = disp
            ReturnValue(1)
        }
        ReturnValue(0)
    }
}

Function.Optimize_NotePtrCopy {
    Input: target: Address
    Input: value: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(LoopHome.active, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_IsIntHome(target), 1) ThenBlock: {
            Optimize_PtrClearAll()
            ReturnValue(0)
        }
        IfCondition EqualTo(Optimize_CursorDisp(value), 0) ThenBlock: {
            Optimize_PtrClear(target)
            ReturnValue(0)
        }
        ReturnValue(Optimize_PtrAdd(target, LoopHome.imm_val))
    }
}

// Sets hit_disp to the r13 displacement of this field. 0 means use the stack path.
Function.Optimize_FieldHomeDisp {
    Input: base: Address
    Input: offset: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(LoopHome.active, 0) ThenBlock: { ReturnValue(0) }
        disp = -1
        IfCondition EqualTo(Optimize_IsIntHome(base), 1) ThenBlock: {
            disp = 0
        }
        IfCondition EqualTo(disp, -1) ThenBlock: {
            IfCondition EqualTo(Optimize_PtrFind(base), 1) ThenBlock: {
                disp = LoopHome.hit_disp
            }
        }
        IfCondition LessThan(disp, 0) ThenBlock: { ReturnValue(0) }
        total = Add(disp, offset)
        IfCondition LessThan(total, 0) ThenBlock: { ReturnValue(0) }
        LoopHome.hit_disp = total
        ReturnValue(1)
    }
}

// A plain field is one qword. Nested records and pointer fields stay on the
// normal path so their pool type is still recorded.
Function.Optimize_FieldPlain {
    Input: base: Address
    Input: field: Address
    Output: Integer
    Body: {
        LoopHome.imm_ok = 0
        IfCondition EqualTo(base, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(field, 0) ThenBlock: { ReturnValue(0) }
        pool_type = Scope_GetVarPoolType(base)
        IfCondition EqualTo(pool_type, 0) ThenBlock: { ReturnValue(0) }
        pool_name = Pool_ExtractPoolName(pool_type)
        entry = Pool_FindField(pool_name, field)
        IfCondition EqualTo(entry, 0) ThenBlock: { ReturnValue(0) }
        ftype = Dereference(Add(entry, 24))
        IfCondition EqualTo(ftype, PoolConst.TYPE_NESTED) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(ftype, PoolConst.TYPE_POINTER) ThenBlock: { ReturnValue(0) }
        direction = Dereference(Add(entry, 16))
        IfCondition EqualTo(Scope_IsParameter(base), 1) ThenBlock: {
            IfCondition EqualTo(direction, PoolConst.DIR_OUTPUT) ThenBlock: { ReturnValue(0) }
        }
        off = Dereference(Add(entry, 8))
        IfCondition LessThan(off, 0) ThenBlock: { ReturnValue(0) }
        LoopHome.imm_ok = 1
        LoopHome.imm_val = off
        ReturnValue(1)
    }
}

// w = rec@w, when rec is the homed cursor or a straight-line copy of it,
// is the same value as Dereference(Add(cursor, disp)). The copy has to be
// a direct statement of this loop body, before this read, with no store
// to the cursor in between.
Function.Optimize_FieldMemDisp {
    Input: target: Address
    Input: value: Address
    Output: Integer
    Body: {
        LoopHome.imm_ok = 0
        IfCondition EqualTo(target, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(value, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(LoopHome.int_name, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_NameEq(target, LoopHome.int_name), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_NameEq(target, LoopHome.flt_name), 1) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(Optimize_ExtraReg(target), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_NameEq(target, LoopHome.acc_name), 1) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(value), AST.POINTER_FIELD_ACCESS) ThenBlock: { ReturnValue(0) }
        base = AST_GetData1(value)
        field = AST_GetData2(value)
        IfCondition EqualTo(Optimize_FieldPlain(base, field), 0) ThenBlock: { ReturnValue(0) }
        field_off = LoopHome.imm_val
        body = LoopHome.body
        IfCondition EqualTo(body, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(body), AST.BLOCK) ThenBlock: { ReturnValue(0) }
        found = -1
        count = AST_GetChildCount(body)
        i = 0
        WhileLoop LessThan(i, count) {
            st = AST_GetChild(body, i)
            IfCondition NotEqual(st, 0) ThenBlock: {
                IfCondition EqualTo(AST_GetType(st), AST.ASSIGNMENT) ThenBlock: {
                    IfCondition EqualTo(AST_GetData2(st), 0) ThenBlock: {
                        IfCondition EqualTo(AST_GetChild(st, 0), value) ThenBlock: {
                            IfCondition EqualTo(Optimize_NameEq(AST_GetData1(st), target), 1) ThenBlock: {
                                found = i
                                i = count
                            }
                        }
                    }
                }
            }
            i = Add(i, 1)
        }
        IfCondition LessThan(found, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_NameEq(base, LoopHome.int_name), 1) ThenBlock: {
            LoopHome.imm_ok = 1
            LoopHome.imm_val = field_off
            ReturnValue(1)
        }
        last = -1
        j = 0
        WhileLoop LessThan(j, found) {
            sj = AST_GetChild(body, j)
            IfCondition NotEqual(sj, 0) ThenBlock: {
                IfCondition EqualTo(AST_GetType(sj), AST.ASSIGNMENT) ThenBlock: {
                    IfCondition EqualTo(AST_GetData2(sj), 0) ThenBlock: {
                        tname = AST_GetData1(sj)
                        IfCondition EqualTo(Optimize_NameEq(tname, LoopHome.int_name), 1) ThenBlock: {
                            last = -1
                        }
                        IfCondition EqualTo(Optimize_NameEq(tname, base), 1) ThenBlock: {
                            last = j
                        }
                    }
                }
            }
            j = Add(j, 1)
        }
        IfCondition LessThan(last, 0) ThenBlock: { ReturnValue(0) }
        src = AST_GetChild(AST_GetChild(body, last), 0)
        IfCondition EqualTo(Optimize_CursorDisp(src), 0) ThenBlock: { ReturnValue(0) }
        total = Add(LoopHome.imm_val, field_off)
        IfCondition LessThan(total, 0) ThenBlock: { ReturnValue(0) }
        LoopHome.imm_ok = 1
        LoopHome.imm_val = total
        ReturnValue(1)
    }
}

Function.Optimize_MemAliasShape {
    Input: target: Address
    Input: value: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(Optimize_DerefAliasShape(target, value), 1) ThenBlock: { ReturnValue(1) }
        ReturnValue(Optimize_FieldMemDisp(target, value))
    }
}

// rec = cursor does not use rbx. An Add into that copy does, so it stays
// off this list and still counts as a cursor copy for the field displacement.
Function.Optimize_PtrCopyShape {
    Input: target: Address
    Input: value: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(target, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(value, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(LoopHome.int_name, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_NameEq(target, LoopHome.int_name), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_NameEq(target, LoopHome.flt_name), 1) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(Optimize_ExtraReg(target), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_NameEq(target, LoopHome.acc_name), 1) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(value), AST.IDENTIFIER) ThenBlock: { ReturnValue(0) }
        ReturnValue(Optimize_CursorDisp(value))
    }
}

Function.Optimize_FlushHold {
    Output: Integer
    Body: {
        IfCondition EqualTo(LoopHome.hold_on, 0) ThenBlock: { ReturnValue(0) }
        hold_name = LoopHome.hold_name
        LoopHome.hold_on = 0
        LoopHome.hold_name = 0
        Emit_HomeMove(30, 0)
        CompileExpr_StoreVariable(hold_name)
        ReturnValue(0)
    }
}

Function.Optimize_CursorDisp {
    Input: node: Address
    Output: Integer
    Body: {
        LoopHome.imm_ok = 0
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(LoopHome.int_name, 0) ThenBlock: { ReturnValue(0) }
        at = AST_GetType(node)
        IfCondition EqualTo(at, AST.IDENTIFIER) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(AST_GetData1(node), LoopHome.int_name), 1) ThenBlock: {
                LoopHome.imm_ok = 1
                LoopHome.imm_val = 0
                ReturnValue(1)
            }
            ReturnValue(0)
        }
        IfCondition NotEqual(at, AST.CALL) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(StringCompare(AST_GetData1(node), "Add"), 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetChildCount(node), 2) ThenBlock: { ReturnValue(0) }
        a0 = AST_GetChild(node, 0)
        a1 = AST_GetChild(node, 1)
        imm_side = -1
        IfCondition EqualTo(Optimize_ReadImm(a1), 1) ThenBlock: {
            imm_side = 1
        } ElseBlock: {
            IfCondition EqualTo(Optimize_ReadImm(a0), 1) ThenBlock: {
                imm_side = 0
            }
        }
        IfCondition LessThan(imm_side, 0) ThenBlock: { ReturnValue(0) }
        other = a0
        IfCondition EqualTo(imm_side, 0) ThenBlock: { other = a1 }
        IfCondition EqualTo(other, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(other), AST.IDENTIFIER) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_NameEq(AST_GetData1(other), LoopHome.int_name), 0) ThenBlock: { ReturnValue(0) }
        LoopHome.imm_ok = 1
        ReturnValue(1)
    }
}

Function.Optimize_DerefAliasShape {
    Input: target: Address
    Input: value: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(target, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(value, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_NameEq(target, LoopHome.int_name), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_NameEq(target, LoopHome.flt_name), 1) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(Optimize_ExtraReg(target), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_NameEq(target, LoopHome.acc_name), 1) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(value), AST.CALL) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(StringCompare(AST_GetData1(value), "Dereference"), 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetChildCount(value), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_CursorDisp(AST_GetChild(value, 0)), 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(1)
    }
}

Function.Optimize_CursorAddShape {
    Input: target: Address
    Input: value: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(Optimize_NameEq(target, LoopHome.int_name), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(value, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(value), AST.CALL) ThenBlock: { ReturnValue(0) }
        opname = AST_GetData1(value)
        is_add = 0
        is_sub = 0
        IfCondition EqualTo(StringCompare(opname, "Add"), 0) ThenBlock: { is_add = 1 }
        IfCondition EqualTo(StringCompare(opname, "Subtract"), 0) ThenBlock: { is_sub = 1 }
        IfCondition EqualTo(is_add, 0) ThenBlock: {
            IfCondition EqualTo(is_sub, 0) ThenBlock: { ReturnValue(0) }
        }
        IfCondition NotEqual(AST_GetChildCount(value), 2) ThenBlock: { ReturnValue(0) }
        a0 = AST_GetChild(value, 0)
        a1 = AST_GetChild(value, 1)
        imm_side = -1
        IfCondition EqualTo(Optimize_ReadImm(a1), 1) ThenBlock: {
            imm_side = 1
        } ElseBlock: {
            IfCondition EqualTo(Optimize_ReadImm(a0), 1) ThenBlock: {
                imm_side = 0
            }
        }
        IfCondition LessThan(imm_side, 0) ThenBlock: { ReturnValue(0) }
        other = a0
        IfCondition EqualTo(imm_side, 0) ThenBlock: { other = a1 }
        IfCondition EqualTo(other, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(other), AST.IDENTIFIER) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_NameEq(AST_GetData1(other), target), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(is_sub, 1) ThenBlock: {
            IfCondition NotEqual(imm_side, 1) ThenBlock: { ReturnValue(0) }
        }
        ReturnValue(1)
    }
}

Function.Optimize_AccOther {
    Input: node: Address
    Output: Integer
    Body: {
        LoopHome.hit_class = 0
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(AST_GetType(node), AST.IDENTIFIER) ThenBlock: {
            nm = AST_GetData1(node)
            IfCondition EqualTo(Optimize_NameEq(nm, LoopHome.int_name), 1) ThenBlock: {
                LoopHome.hit_class = 5
                ReturnValue(5)
            }
            IfCondition EqualTo(Optimize_AliasFind(nm), 1) ThenBlock: {
                LoopHome.hit_class = 2
                ReturnValue(2)
            }
            ReturnValue(0)
        }
        IfCondition EqualTo(AST_GetType(node), AST.CALL) ThenBlock: {
            IfCondition EqualTo(StringCompare(AST_GetData1(node), "Dereference"), 0) ThenBlock: {
                IfCondition EqualTo(AST_GetChildCount(node), 1) ThenBlock: {
                    IfCondition EqualTo(Optimize_CursorDisp(AST_GetChild(node, 0)), 1) ThenBlock: {
                        LoopHome.hit_class = 4
                        LoopHome.hit_disp = LoopHome.imm_val
                        ReturnValue(4)
                    }
                }
            }
        }
        IfCondition EqualTo(Optimize_ReadImm(node), 1) ThenBlock: {
            LoopHome.hit_class = 7
            LoopHome.hit_disp = LoopHome.imm_val
            ReturnValue(7)
        }
        ReturnValue(0)
    }
}

Function.Optimize_AccShape {
    Input: target: Address
    Input: value: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(LoopHome.acc_name, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_NameEq(target, LoopHome.acc_name), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(value, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(value), AST.CALL) ThenBlock: { ReturnValue(0) }
        opname = AST_GetData1(value)
        is_add = 0
        is_sub = 0
        IfCondition EqualTo(StringCompare(opname, "Add"), 0) ThenBlock: { is_add = 1 }
        IfCondition EqualTo(StringCompare(opname, "Subtract"), 0) ThenBlock: { is_sub = 1 }
        IfCondition EqualTo(is_add, 0) ThenBlock: {
            IfCondition EqualTo(is_sub, 0) ThenBlock: { ReturnValue(0) }
        }
        IfCondition NotEqual(AST_GetChildCount(value), 2) ThenBlock: { ReturnValue(0) }
        a0 = AST_GetChild(value, 0)
        a1 = AST_GetChild(value, 1)
        left_acc = 0
        right_acc = 0
        IfCondition EqualTo(AST_GetType(a0), AST.IDENTIFIER) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(AST_GetData1(a0), LoopHome.acc_name), 1) ThenBlock: { left_acc = 1 }
        }
        IfCondition EqualTo(AST_GetType(a1), AST.IDENTIFIER) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(AST_GetData1(a1), LoopHome.acc_name), 1) ThenBlock: { right_acc = 1 }
        }
        other = 0
        IfCondition EqualTo(is_add, 1) ThenBlock: {
            IfCondition EqualTo(left_acc, 1) ThenBlock: {
                IfCondition EqualTo(right_acc, 0) ThenBlock: { other = a1 }
            }
            IfCondition EqualTo(right_acc, 1) ThenBlock: {
                IfCondition EqualTo(left_acc, 0) ThenBlock: { other = a0 }
            }
        }
        IfCondition EqualTo(is_sub, 1) ThenBlock: {
            IfCondition EqualTo(left_acc, 1) ThenBlock: {
                IfCondition EqualTo(right_acc, 0) ThenBlock: { other = a1 }
            }
        }
        IfCondition EqualTo(other, 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(Optimize_AccOther(other))
    }
}

Function.Optimize_FltOpKind {
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(StringCompare(name, "Float_Add"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "Float_Sub"), 0) ThenBlock: { ReturnValue(2) }
        IfCondition EqualTo(StringCompare(name, "Float_Mul"), 0) ThenBlock: { ReturnValue(3) }
        IfCondition EqualTo(StringCompare(name, "Float_Div"), 0) ThenBlock: { ReturnValue(4) }
        ReturnValue(0)
    }
}

Function.Optimize_RbxSafeOp {
    Input: node: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        nt = AST_GetType(node)
        IfCondition EqualTo(nt, AST.NUMBER) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(nt, AST.IDENTIFIER) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(nt, AST.CALL) ThenBlock: {
            IfCondition EqualTo(StringCompare(AST_GetData1(node), "Dereference"), 0) ThenBlock: {
                IfCondition EqualTo(AST_GetChildCount(node), 1) ThenBlock: {
                    IfCondition EqualTo(Optimize_CursorDisp(AST_GetChild(node, 0)), 1) ThenBlock: { ReturnValue(1) }
                }
            }
        }
        ReturnValue(0)
    }
}

Function.Optimize_OpClass {
    Input: node: Address
    Output: Integer
    Body: {
        LoopHome.hit_class = 0
        LoopHome.hit_disp = 0
        LoopHome.hit_xmm = 0
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        nt = AST_GetType(node)
        IfCondition EqualTo(nt, AST.IDENTIFIER) ThenBlock: {
            nm = AST_GetData1(node)
            IfCondition EqualTo(Optimize_IsFltHome(nm), 1) ThenBlock: {
                LoopHome.hit_class = 1
                LoopHome.hit_xmm = Optimize_FltSlot(nm)
                ReturnValue(1)
            }
            IfCondition EqualTo(LoopHome.hold_on, 1) ThenBlock: {
                IfCondition EqualTo(Optimize_NameEq(nm, LoopHome.hold_name), 1) ThenBlock: {
                    LoopHome.hit_class = 3
                    ReturnValue(1)
                }
            }
            IfCondition EqualTo(Optimize_AliasFind(nm), 1) ThenBlock: {
                LoopHome.hit_class = 2
                ReturnValue(1)
            }
            IfCondition EqualTo(Optimize_IsIntHome(nm), 1) ThenBlock: {
                LoopHome.hit_class = 5
                ReturnValue(1)
            }
            IfCondition EqualTo(Optimize_RldFind(nm), 1) ThenBlock: {
                IfCondition EqualTo(LoopHome.rld_kind, 1) ThenBlock: {
                    LoopHome.hit_class = 9
                    LoopHome.hit_disp = LoopHome.rld_disp
                    LoopHome.hit_xmm = LoopHome.rld_reg
                    ReturnValue(1)
                }
            }
            off = Scope_Resolve(nm)
            rt = Scope.resolve_type
            IfCondition EqualTo(rt, 3) ThenBlock: {
                pidx = BitwiseAnd(off, 2147483647)
                LoopHome.hit_class = 7
                LoopHome.hit_disp = Multiply(pidx, 8)
                ReturnValue(1)
            }
            frame = 0
            IfCondition EqualTo(rt, 1) ThenBlock: { frame = 1 }
            IfCondition EqualTo(rt, 2) ThenBlock: { frame = 1 }
            IfCondition EqualTo(frame, 1) ThenBlock: {
                IfCondition LessThan(off, 0) ThenBlock: {
                    LoopHome.hit_class = 6
                    LoopHome.hit_disp = off
                    ReturnValue(1)
                }
            }
            ReturnValue(0)
        }
        IfCondition EqualTo(nt, AST.CALL) ThenBlock: {
            IfCondition EqualTo(StringCompare(AST_GetData1(node), "Dereference"), 0) ThenBlock: {
                IfCondition EqualTo(AST_GetChildCount(node), 1) ThenBlock: {
                    IfCondition EqualTo(Optimize_CursorDisp(AST_GetChild(node, 0)), 1) ThenBlock: {
                        LoopHome.hit_class = 4
                        LoopHome.hit_disp = LoopHome.imm_val
                        ReturnValue(1)
                    }
                }
            }
        }
        IfCondition EqualTo(nt, AST.NUMBER) ThenBlock: {
            IfCondition EqualTo(OptState.flt_ready, 1) ThenBlock: {
                bits = StringToNumber(AST_GetData1(node))
                disp = Optimize_FltConstDisp(bits)
                IfCondition LessThan(disp, 0) ThenBlock: {
                    LoopHome.hit_class = 8
                    LoopHome.hit_disp = disp
                    ReturnValue(1)
                }
            }
            ReturnValue(0)
        }
        ReturnValue(0)
    }
}

Function.Optimize_AliasLive {
    Output: Integer
    Body: {
        n = 0
        IfCondition EqualTo(LoopHome.a0_on, 1) ThenBlock: { n = Add(n, 1) }
        IfCondition EqualTo(LoopHome.a1_on, 1) ThenBlock: { n = Add(n, 1) }
        IfCondition EqualTo(LoopHome.a2_on, 1) ThenBlock: { n = Add(n, 1) }
        IfCondition EqualTo(LoopHome.a3_on, 1) ThenBlock: { n = Add(n, 1) }
        ReturnValue(n)
    }
}

Function.Optimize_TryAliasAssign {
    Input: target: Address
    Input: value: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(LoopHome.active, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(LoopHome.alias_spill, 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_MemAliasShape(target, value), 0) ThenBlock: { ReturnValue(0) }
        disp = LoopHome.imm_val
        IfCondition EqualTo(Optimize_AliasAdd(target, disp), 0) ThenBlock: { ReturnValue(0) }
        Optimize_FlushHold()
        ReturnValue(1)
    }
}
