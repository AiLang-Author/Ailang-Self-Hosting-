// Library.COptAlloc.ailang
// One table of names that already live in registers for the current loop.
// Loaded by the optimizer shell. No imports of its own.
//
// The frame stays the permanent home of every local. This table only
// answers "where is this name right now?"
//
// Record stride 32: name, class, register, frame offset.
// Class 1 is a GPR. Class 2 is an XMM. Register numbers are the hardware
// numbers (13 is r13, 2 is xmm2). Sixteen rows, one Allocate of 512 bytes.
//
// Stage 1, this file: publish the homes the existing pickers already chose.
// GprOf and FltSlot read the table first and keep their old tests if the
// name is absent. Emitters are unchanged.
// Stage 2: LoadVariable and StoreVariable consult the table.
// Stage 3: rank more names into free registers. Entry loads, exit stores.
// Stage 4: delete a home bank when a pin shows the table covers it.
// Fold, inline, NonNeg, magic division, and FMA stay rules.

// =============================================================================
// TABLE
// =============================================================================

Function.Optimize_AllocReset {
    Body: {
        AllocTab.n = 0
        AllocTab.hit_class = 0
        AllocTab.hit_reg = -1
        ReturnValue(0)
    }
}

Function.Optimize_AllocEnsure {
    Body: {
        IfCondition EqualTo(AllocTab.recs, 0) ThenBlock: {
            AllocTab.recs = Allocate(512)
        }
        ReturnValue(0)
    }
}

Function.Optimize_AllocRec {
    Input: index: Integer
    Output: Address
    Body: {
        ReturnValue(Add(AllocTab.recs, Multiply(index, 32)))
    }
}

Function.Optimize_AllocSeen {
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }
        i = 0
        WhileLoop LessThan(i, AllocTab.n) {
            rec = Optimize_AllocRec(i)
            IfCondition EqualTo(Optimize_NameEq(Dereference(rec), name), 1) ThenBlock: {
                ReturnValue(1)
            }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

// Skip a null name, a full table, and a name already published.
// The first row wins, matching the order GprOf checks homes.
Function.Optimize_AllocAdd {
    Input: name: Address
    Input: cls: Integer
    Input: reg: Integer
    Input: off: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterEqual(AllocTab.n, 16) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_AllocSeen(name), 1) ThenBlock: { ReturnValue(0) }
        Optimize_AllocEnsure()
        rec = Optimize_AllocRec(AllocTab.n)
        StoreValue(rec, name)
        StoreValue(Add(rec, 8), cls)
        StoreValue(Add(rec, 16), reg)
        StoreValue(Add(rec, 24), off)
        AllocTab.n = Add(AllocTab.n, 1)
        ReturnValue(1)
    }
}

// 1 when name is in the table. Class and register land in AllocTab.
Function.Optimize_Loc {
    Input: name: Address
    Output: Integer
    Body: {
        AllocTab.hit_class = 0
        AllocTab.hit_reg = -1
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }
        IfCondition LessEqual(AllocTab.n, 0) ThenBlock: { ReturnValue(0) }
        i = 0
        WhileLoop LessThan(i, AllocTab.n) {
            rec = Optimize_AllocRec(i)
            IfCondition EqualTo(Optimize_NameEq(Dereference(rec), name), 1) ThenBlock: {
                AllocTab.hit_class = Dereference(Add(rec, 8))
                AllocTab.hit_reg = Dereference(Add(rec, 16))
                ReturnValue(1)
            }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

// Copy the homes this loop already picked. Called once LoopHomes succeeds,
// cleared by HomeRelease and by the outer-hoist probe reset.
Function.Optimize_AllocPublish {
    Body: {
        Optimize_AllocReset()
        Optimize_AllocAdd(LoopHome.int_name, 1, 13, LoopHome.int_off)
        Optimize_AllocAdd(LoopHome.acc_name, 1, 12, LoopHome.acc_off)
        IfCondition EqualTo(LoopHome.der_on, 1) ThenBlock: {
            Optimize_AllocAdd(LoopHome.der_name, 1, 11, LoopHome.der_off)
        }
        IfCondition EqualTo(LoopHome.lim_on, 1) ThenBlock: {
            IfCondition EqualTo(LoopHome.rbx_free, 1) ThenBlock: {
                Optimize_AllocAdd(LoopHome.lim_name, 1, 3, LoopHome.lim_off)
            }
        }
        Optimize_AllocAdd(LoopHome.flt_name, 2, 2, LoopHome.flt_off)
        Optimize_AllocAdd(LoopHome.f2_name, 2, 3, LoopHome.f2_off)
        Optimize_AllocAdd(LoopHome.f3_name, 2, 4, LoopHome.f3_off)
        Optimize_AllocAdd(LoopHome.f4_name, 2, 5, LoopHome.f4_off)
        Optimize_AllocAdd(LoopHome.f5_name, 2, 6, LoopHome.f5_off)
        Optimize_AllocAdd(LoopHome.f6_name, 2, 7, LoopHome.f6_off)
        ReturnValue(0)
    }
}
