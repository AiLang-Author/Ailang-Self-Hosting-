// Library.COptAlloc.ailang
// One table of names that already live in registers for the current loop.
// Loaded by the optimizer shell. No imports of its own.
//
// The frame stays the permanent home of every local. This table only
// answers "where is this name right now?"
//
// Record stride 32: name, class, register, frame offset.
// Class 1 is a GPR. Class 2 is an XMM. Register numbers are the hardware
// numbers (13 is r13, 2 is xmm2). Sixteen rows, one Allocate of 512 bytes.
//
// Stage 1: publish the homes the existing pickers already chose.
// GprOf and FltSlot read the table and keep their old tests on a miss.
// Stage 2: LoadVariable and StoreVariable move rax to and from a published
// register. A limit parked in rbx, and a derived name on a store, stay on
// the old path so those bytes do not change.
// Stage 3, started: one extra integer may use r11 when the derived sum,
// the constant factor, and both induction pointers leave it free, and the
// loop has no real call and no inline asm. The frame store stays, so a
// path that still reads the slot sees the same bits. Entry reloads when
// the name is live in. Stage 4 deletes a home bank after that choice
// matches a pin.
// Fold, inline, NonNeg, magic division, and FMA stay rules.

// =============================================================================
// TABLE
// =============================================================================

Function.Optimize_AllocReset {
    Body: {
        AllocTab.n = 0
        AllocTab.hit_class = 0
        AllocTab.hit_reg = -1
        ReturnValue(0)
    }
}

Function.Optimize_AllocEnsure {
    Body: {
        IfCondition EqualTo(AllocTab.recs, 0) ThenBlock: {
            AllocTab.recs = Allocate(512)
        }
        ReturnValue(0)
    }
}

Function.Optimize_AllocRec {
    Input: index: Integer
    Output: Address
    Body: {
        ReturnValue(Add(AllocTab.recs, Multiply(index, 32)))
    }
}

Function.Optimize_AllocSeen {
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }
        i = 0
        WhileLoop LessThan(i, AllocTab.n) {
            rec = Optimize_AllocRec(i)
            IfCondition EqualTo(Optimize_NameEq(Dereference(rec), name), 1) ThenBlock: {
                ReturnValue(1)
            }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

// Skip a null name, a full table, and a name already published.
// The first row wins, matching the order GprOf checks homes.
Function.Optimize_AllocAdd {
    Input: name: Address
    Input: cls: Integer
    Input: reg: Integer
    Input: off: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterEqual(AllocTab.n, 16) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_AllocSeen(name), 1) ThenBlock: { ReturnValue(0) }
        Optimize_AllocEnsure()
        rec = Optimize_AllocRec(AllocTab.n)
        StoreValue(rec, name)
        StoreValue(Add(rec, 8), cls)
        StoreValue(Add(rec, 16), reg)
        StoreValue(Add(rec, 24), off)
        AllocTab.n = Add(AllocTab.n, 1)
        ReturnValue(1)
    }
}

// 1 when name is in the table. Class and register land in AllocTab.
Function.Optimize_Loc {
    Input: name: Address
    Output: Integer
    Body: {
        AllocTab.hit_class = 0
        AllocTab.hit_reg = -1
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }
        IfCondition LessEqual(AllocTab.n, 0) ThenBlock: { ReturnValue(0) }
        i = 0
        WhileLoop LessThan(i, AllocTab.n) {
            rec = Optimize_AllocRec(i)
            IfCondition EqualTo(Optimize_NameEq(Dereference(rec), name), 1) ThenBlock: {
                AllocTab.hit_class = Dereference(Add(rec, 8))
                AllocTab.hit_reg = Dereference(Add(rec, 16))
                ReturnValue(1)
            }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

// Copy the homes this loop already picked. Called once LoopHomes succeeds,
// cleared by HomeRelease and by the outer-hoist probe reset.
Function.Optimize_AllocPublish {
    Body: {
        Optimize_AllocReset()
        Optimize_AllocAdd(LoopHome.int_name, 1, 13, LoopHome.int_off)
        Optimize_AllocAdd(LoopHome.acc_name, 1, 12, LoopHome.acc_off)
        IfCondition EqualTo(LoopHome.der_on, 1) ThenBlock: {
            Optimize_AllocAdd(LoopHome.der_name, 1, 11, LoopHome.der_off)
        }
        IfCondition EqualTo(LoopHome.lim_on, 1) ThenBlock: {
            IfCondition EqualTo(LoopHome.rbx_free, 1) ThenBlock: {
                Optimize_AllocAdd(LoopHome.lim_name, 1, 3, LoopHome.lim_off)
            }
        }
        Optimize_AllocAdd(LoopHome.flt_name, 2, 2, LoopHome.flt_off)
        Optimize_AllocAdd(LoopHome.f2_name, 2, 3, LoopHome.f2_off)
        Optimize_AllocAdd(LoopHome.f3_name, 2, 4, LoopHome.f3_off)
        Optimize_AllocAdd(LoopHome.f4_name, 2, 5, LoopHome.f4_off)
        Optimize_AllocAdd(LoopHome.f5_name, 2, 6, LoopHome.f5_off)
        Optimize_AllocAdd(LoopHome.f6_name, 2, 7, LoopHome.f6_off)
        Optimize_AllocExtend()
        ReturnValue(0)
    }
}

// 1 when node contains a real call or inline asm. Those clobber r11.
// HomeCallOk names are operators and leaf helpers that do not write r11.
Function.Optimize_AllocBad {
    Input: node: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        nt = AST_GetType(node)
        IfCondition EqualTo(nt, AST.INLINEASM) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(nt, AST.CALL) ThenBlock: {
            IfCondition EqualTo(Optimize_HomeCallOk(AST_GetData1(node)), 0) ThenBlock: {
                ReturnValue(1)
            }
        }
        count = AST_GetChildCount(node)
        i = 0
        WhileLoop LessThan(i, count) {
            IfCondition EqualTo(Optimize_AllocBad(AST_GetChild(node, i)), 1) ThenBlock: {
                ReturnValue(1)
            }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

Function.Optimize_AllocHeld {
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(Optimize_AllocSeen(name), 1) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(Optimize_NameTaken(name), 1) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(Optimize_NameEq(name, LoopHome.tab_name), 1) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(Optimize_NameEq(name, LoopHome.lim_name), 1) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(Optimize_NameEq(name, LoopHome.rcx_name), 1) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(Optimize_NameEq(name, LoopHome.rdx_name), 1) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(Optimize_NameEq(name, LoopHome.kmul_name), 1) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(Optimize_NameEq(name, LoopHome.hold_name), 1) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(Optimize_NameEq(name, LoopHome.der_name), 1) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

// The next integer local, by loads plus stores, goes in r11.
// A loop that already has an integer or accumulator home is active,
// so loads through the table see the register.
Function.Optimize_AllocExtend {
    Body: {
        IfCondition EqualTo(LoopHome.int_name, 0) ThenBlock: {
            IfCondition EqualTo(LoopHome.acc_name, 0) ThenBlock: { ReturnValue(0) }
        }
        IfCondition EqualTo(LoopHome.der_on, 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(LoopHome.kmul_on, 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(LoopHome.ip0_on, 1) ThenBlock: {
            IfCondition EqualTo(LoopHome.ip0_reg, 11) ThenBlock: { ReturnValue(0) }
        }
        IfCondition EqualTo(LoopHome.ip1_on, 1) ThenBlock: {
            IfCondition EqualTo(LoopHome.ip1_reg, 11) ThenBlock: { ReturnValue(0) }
        }
        IfCondition EqualTo(Optimize_AllocBad(LoopHome.cond), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_AllocBad(LoopHome.body), 1) ThenBlock: { ReturnValue(0) }
        best_name = 0
        best_off = 0
        best_score = 0
        i = 0
        WhileLoop LessThan(i, LoopHome.count) {
            rec = Optimize_HomeRec(i)
            name = Dereference(rec)
            loads = Dereference(Add(rec, 8))
            stores = Dereference(Add(rec, 16))
            fops = Dereference(Add(rec, 24))
            IfCondition GreaterThan(loads, 0) ThenBlock: {
                IfCondition EqualTo(fops, 0) ThenBlock: {
                    IfCondition EqualTo(Optimize_AllocHeld(name), 0) ThenBlock: {
                        live = 0
                        IfCondition GreaterThan(stores, 0) ThenBlock: { live = 1 }
                        IfCondition EqualTo(live, 0) ThenBlock: {
                            IfCondition EqualTo(Optimize_LiveIn(name, LoopHome.cond, LoopHome.body), 1) ThenBlock: {
                                live = 1
                            }
                        }
                        IfCondition EqualTo(live, 1) ThenBlock: {
                            off = Scope_Resolve(name)
                            rt = Scope.resolve_type
                            ok = 0
                            IfCondition EqualTo(rt, 1) ThenBlock: { ok = 1 }
                            IfCondition EqualTo(rt, 2) ThenBlock: { ok = 1 }
                            IfCondition GreaterEqual(off, 0) ThenBlock: { ok = 0 }
                            IfCondition EqualTo(ok, 1) ThenBlock: {
                                score = Add(loads, stores)
                                IfCondition GreaterThan(score, best_score) ThenBlock: {
                                    best_score = score
                                    best_name = name
                                    best_off = off
                                }
                            }
                        }
                    }
                }
            }
            i = Add(i, 1)
        }
        IfCondition EqualTo(best_name, 0) ThenBlock: { ReturnValue(0) }
        Optimize_AllocAdd(best_name, 1, 11, best_off)
        ReturnValue(1)
    }
}

// While entry. The derived sum uses its own loader.
Function.Optimize_AllocR11In {
    Input: condition: Address
    Body: {
        IfCondition EqualTo(LoopHome.der_on, 1) ThenBlock: { ReturnValue(0) }
        i = 0
        WhileLoop LessThan(i, AllocTab.n) {
            rec = Optimize_AllocRec(i)
            IfCondition EqualTo(Dereference(Add(rec, 8)), 1) ThenBlock: {
                IfCondition EqualTo(Dereference(Add(rec, 16)), 11) ThenBlock: {
                    name = Dereference(rec)
                    IfCondition EqualTo(Optimize_LiveIn(name, condition, LoopHome.body), 1) ThenBlock: {
                        Emit_MovRaxRbpOffset(Dereference(Add(rec, 24)))
                        X86Enc_Assemble("MOV r11, rax")
                    }
                    ReturnValue(0)
                }
            }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

// Move a published register into rax. 1 when this emitted the load.
// rbx (the loop limit) is published but not loaded here.
Function.Optimize_LocLoad {
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(LoopHome.active, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_Loc(name), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(AllocTab.hit_class, 1) ThenBlock: {
            IfCondition EqualTo(AllocTab.hit_reg, 13) ThenBlock: {
                IfCondition GreaterThan(PinDefer.n, 0) ThenBlock: { Optimize_PinFlush() }
                Emit_HomeMove(1, 0)
                ReturnValue(1)
            }
            IfCondition EqualTo(AllocTab.hit_reg, 12) ThenBlock: {
                IfCondition GreaterThan(PinDefer.n, 0) ThenBlock: { Optimize_PinFlush() }
                Emit_HomeMove(16, 0)
                ReturnValue(1)
            }
            IfCondition EqualTo(AllocTab.hit_reg, 11) ThenBlock: {
                IfCondition GreaterThan(PinDefer.n, 0) ThenBlock: { Optimize_PinFlush() }
                X86Enc_Assemble("MOV rax, r11")
                ReturnValue(1)
            }
            ReturnValue(0)
        }
        IfCondition EqualTo(AllocTab.hit_class, 2) ThenBlock: {
            IfCondition GreaterThan(PinDefer.n, 0) ThenBlock: { Optimize_PinFlush() }
            slot = Optimize_FltSlot(name)
            IfCondition EqualTo(slot, 2) ThenBlock: { Emit_HomeMove(5, 0) }
            IfCondition GreaterThan(slot, 2) ThenBlock: { X86_XmmRR(2, slot) }
            ReturnValue(1)
        }
        ReturnValue(0)
    }
}

// Move rax into a published register. 1 when the frame store is not needed.
// A derived name and the rbx limit still take the frame store.
Function.Optimize_LocStore {
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(LoopHome.active, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_Loc(name), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(AllocTab.hit_class, 1) ThenBlock: {
            IfCondition EqualTo(AllocTab.hit_reg, 13) ThenBlock: {
                Emit_HomeMove(2, 0)
                Optimize_PtrClearAll()
                ReturnValue(1)
            }
            IfCondition EqualTo(AllocTab.hit_reg, 12) ThenBlock: {
                Emit_HomeMove(17, 0)
                ReturnValue(1)
            }
            // The extra integer keeps the frame store. The derived sum
            // updates r11 on its own step, so a store of that name does not.
            IfCondition EqualTo(AllocTab.hit_reg, 11) ThenBlock: {
                IfCondition EqualTo(LoopHome.der_on, 1) ThenBlock: {
                    IfCondition EqualTo(Optimize_NameEq(name, LoopHome.der_name), 1) ThenBlock: {
                        ReturnValue(0)
                    }
                }
                X86Enc_Assemble("MOV r11, rax")
                ReturnValue(0)
            }
            ReturnValue(0)
        }
        IfCondition EqualTo(AllocTab.hit_class, 2) ThenBlock: {
            slot = Optimize_FltSlot(name)
            IfCondition EqualTo(slot, 2) ThenBlock: { Emit_HomeMove(6, 0) }
            IfCondition GreaterThan(slot, 2) ThenBlock: { X86_XmmRR(1, slot) }
            ReturnValue(1)
        }
        ReturnValue(0)
    }
}
