// Library.COptBranch.ailang
// Flags, conditional moves, if-select, and float compares.
// Loaded by the optimizer shell. No imports of its own.

// =============================================================================
// BRANCH CONDITION
// WhileLoop / IfCondition / Fork only test the condition for zero. A single
// compare of two leaves can jump on the flags from CMP and skip SETCC/MOVZX.
// Returns 1 when the false-label jump was emitted, 0 when the caller should
// use the ordinary 0/1 path, 2 when emission started and then failed.
// =============================================================================
Function.Optimize_IsLeaf {
    Input: node: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: {
            ReturnValue(0)
        }
        node_type = AST_GetType(node)
        IfCondition EqualTo(node_type, AST.NUMBER) ThenBlock: {
            ReturnValue(1)
        }
        IfCondition EqualTo(node_type, AST.IDENTIFIER) ThenBlock: {
            ReturnValue(1)
        }
        ReturnValue(0)
    }
}

Function.Optimize_IsZeroNum {
    Input: node: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(node), AST.NUMBER) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(StringToNumber(AST_GetData1(node)), 0) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

Function.Optimize_IsCompareName {
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(name, 0) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition EqualTo(StringCompare(name, "EqualTo"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "NotEqual"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "LessThan"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "GreaterThan"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "LessEqual"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "GreaterEqual"), 0) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

Function.Optimize_JumpIfFalse {
    Input: name: Address
    Input: false_label: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(StringCompare(name, "EqualTo"), 0) ThenBlock: {
            Emit_Jne(false_label)
            ReturnValue(0)
        }
        IfCondition EqualTo(StringCompare(name, "NotEqual"), 0) ThenBlock: {
            Emit_Je(false_label)
            ReturnValue(0)
        }
        IfCondition EqualTo(StringCompare(name, "LessThan"), 0) ThenBlock: {
            Emit_Jge(false_label)
            ReturnValue(0)
        }
        IfCondition EqualTo(StringCompare(name, "GreaterThan"), 0) ThenBlock: {
            Emit_Jle(false_label)
            ReturnValue(0)
        }
        IfCondition EqualTo(StringCompare(name, "LessEqual"), 0) ThenBlock: {
            Emit_Jg(false_label)
            ReturnValue(0)
        }
        Emit_Jl(false_label)
        ReturnValue(0)
    }
}

Function.Optimize_TryBranchCondition {
    Input: node: Address
    Input: false_label: Integer
    Output: Integer
    Body: {
        LoopHome.rax_fresh = 0
        LoopHome.rax_cand = 0
        IfCondition EqualTo(node, 0) ThenBlock: {
            ReturnValue(0)
        }
        // The trip count is the pointer end in r13. The back edge compares.
        IfCondition EqualTo(LoopHome.trip_on, 1) ThenBlock: { ReturnValue(1) }
        node_type = AST_GetType(node)
        IfCondition NotEqual(node_type, AST.CALL) ThenBlock: {
            ReturnValue(0)
        }
        name = AST_GetData1(node)
        // A value that is only in a register has to reach memory before a
        // compare reads the frame slot. The back edge also spills it.
        IfCondition EqualTo(LoopHome.ihold_on, 1) ThenBlock: {
            IfCondition EqualTo(Optimize_NodeReads(node, LoopHome.ihold_name), 1) ThenBlock: {
                Optimize_IholdFlush()
            }
        }
        // And of two ready compares is two false jumps. Nothing is emitted
        // unless both sides are ready, so a half-emitted And cannot happen.
        IfCondition EqualTo(StringCompare(name, "And"), 0) ThenBlock: {
            IfCondition EqualTo(AST_GetChildCount(node), 2) ThenBlock: {
                c0 = AST_GetChild(node, 0)
                c1 = AST_GetChild(node, 1)
                IfCondition EqualTo(Optimize_BranchReady(c0), 0) ThenBlock: { ReturnValue(0) }
                IfCondition EqualTo(Optimize_BranchReady(c1), 0) ThenBlock: { ReturnValue(0) }
                IfCondition EqualTo(Optimize_EmitFalseJump(c0, false_label), 0) ThenBlock: { ReturnValue(2) }
                IfCondition EqualTo(Optimize_EmitFalseJump(c1, false_label), 0) ThenBlock: { ReturnValue(2) }
                ReturnValue(1)
            }
            ReturnValue(0)
        }
        IfCondition EqualTo(Optimize_IsFloatCmp(name), 1) ThenBlock: {
            IfCondition EqualTo(Optimize_FloatCmpReady(node), 0) ThenBlock: { ReturnValue(0) }
            IfCondition EqualTo(Optimize_EmitFloatCmp(node, false_label), 0) ThenBlock: { ReturnValue(2) }
            ReturnValue(1)
        }
        IfCondition EqualTo(Optimize_IsCompareName(name), 0) ThenBlock: {
            ReturnValue(0)
        }
        arg_count = AST_GetChildCount(node)
        IfCondition NotEqual(arg_count, 2) ThenBlock: {
            ReturnValue(0)
        }
        arg0 = AST_GetChild(node, 0)
        arg1 = AST_GetChild(node, 1)
        // Compare against zero can test the value. A computed side is
        // not a leaf, so the old path materialized 0/1 and tested that.
        other = 0
        IfCondition EqualTo(Optimize_IsZeroNum(arg1), 1) ThenBlock: {
            IfCondition EqualTo(Optimize_IsLeaf(arg0), 0) ThenBlock: { other = arg0 }
        }
        IfCondition EqualTo(other, 0) ThenBlock: {
            IfCondition EqualTo(Optimize_IsZeroNum(arg0), 1) ThenBlock: {
                IfCondition EqualTo(Optimize_IsLeaf(arg1), 0) ThenBlock: { other = arg1 }
            }
        }
        IfCondition NotEqual(other, 0) ThenBlock: {
            // TEST matches a compare with zero on the right, and equality
            // either way. An ordered compare with zero on the left does not.
            IfCondition EqualTo(Optimize_IsZeroNum(arg0), 1) ThenBlock: {
                ordered = Optimize_FlagCode(name)
                IfCondition GreaterThan(ordered, 2) ThenBlock: { ReturnValue(0) }
            }
            result = Compile_Expression(other)
            IfCondition EqualTo(result, 0) ThenBlock: { ReturnValue(2) }
            Emit_TestRaxRax()
            Optimize_JumpIfFalse(name, false_label)
            ReturnValue(1)
        }
        IfCondition EqualTo(Optimize_IsLeaf(arg0), 0) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition EqualTo(Optimize_IsLeaf(arg1), 0) ThenBlock: {
            ReturnValue(0)
        }
        // A compare-only local parked in RDX. Do not load the skipped slot.
        rdxed = Optimize_TryRdxCmp(name, arg0, arg1, false_label)
        IfCondition EqualTo(rdxed, 1) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(rdxed, 2) ThenBlock: { ReturnValue(2) }
        result = CompileCompare_Binary(node)
        IfCondition EqualTo(result, 0) ThenBlock: {
            ReturnValue(2)
        }
        Optimize_JumpIfFalse(name, false_label)
        Optimize_RaxCommit()
        ReturnValue(1)
    }
}

// A compare can become a conditional move when both arms store the same
// accumulator. rsi holds the true value. Integer arithmetic and compares
// do not write rsi, and parameters are already spilled off it. r15 stays
// the pool base. Returns 1..6 for the true-condition cmov, else 0.
Function.Optimize_FlagCode {
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(StringCompare(name, "EqualTo"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "NotEqual"), 0) ThenBlock: { ReturnValue(2) }
        IfCondition EqualTo(StringCompare(name, "LessThan"), 0) ThenBlock: { ReturnValue(3) }
        IfCondition EqualTo(StringCompare(name, "GreaterThan"), 0) ThenBlock: { ReturnValue(4) }
        IfCondition EqualTo(StringCompare(name, "LessEqual"), 0) ThenBlock: { ReturnValue(5) }
        IfCondition EqualTo(StringCompare(name, "GreaterEqual"), 0) ThenBlock: { ReturnValue(6) }
        ReturnValue(0)
    }
}

// BitwiseAnd with 1 keeps one bit. A product's low bit is the AND of the
// factors' low bits, so an odd constant factor drops out and an even one
// forces the bit to 0. Equality with 0 or 1 is then TEST, and the
// accumulator select can cmov. Class 1 is constant 0, 2 is constant 1,
// 3 is the node left in OptState.parity_node. Two dynamic factors stay
// on the ordinary compare.
Function.Optimize_IsAndName {
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(StringCompare(name, "BitwiseAnd"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "BitAnd"), 0) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

Function.Optimize_IsOneNum {
    Input: node: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(node), AST.NUMBER) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(StringToNumber(AST_GetData1(node)), 1) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

Function.Optimize_LowClass {
    Input: node: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(node), AST.CALL) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_IsAndName(AST_GetData1(node)), 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetChildCount(node), 2) ThenBlock: { ReturnValue(0) }
        a0 = AST_GetChild(node, 0)
        a1 = AST_GetChild(node, 1)
        inner = 0
        IfCondition EqualTo(Optimize_IsOneNum(a1), 1) ThenBlock: { inner = a0 }
        IfCondition EqualTo(inner, 0) ThenBlock: {
            IfCondition EqualTo(Optimize_IsOneNum(a0), 1) ThenBlock: { inner = a1 }
        }
        IfCondition EqualTo(inner, 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(Optimize_LowFactor(inner))
    }
}

Function.Optimize_LowFactor {
    Input: node: Address
    Output: Integer
    Body: {
        OptState.parity_node = 0
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        nt = AST_GetType(node)
        IfCondition EqualTo(nt, AST.NUMBER) ThenBlock: {
            bit = BitwiseAnd(StringToNumber(AST_GetData1(node)), 1)
            IfCondition EqualTo(bit, 0) ThenBlock: { ReturnValue(1) }
            ReturnValue(2)
        }
        IfCondition EqualTo(nt, AST.IDENTIFIER) ThenBlock: {
            OptState.parity_node = node
            ReturnValue(3)
        }
        IfCondition NotEqual(nt, AST.CALL) ThenBlock: { ReturnValue(0) }
        fname = AST_GetData1(node)
        is_mul = EqualTo(StringCompare(fname, "Multiply"), 0)
        is_and = Optimize_IsAndName(fname)
        IfCondition EqualTo(is_mul, 0) ThenBlock: {
            IfCondition EqualTo(is_and, 0) ThenBlock: { ReturnValue(0) }
        }
        IfCondition NotEqual(AST_GetChildCount(node), 2) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(is_and, 1) ThenBlock: {
            ReturnValue(Optimize_LowClass(node))
        }
        c0 = Optimize_LowFactor(AST_GetChild(node, 0))
        n0 = OptState.parity_node
        c1 = Optimize_LowFactor(AST_GetChild(node, 1))
        n1 = OptState.parity_node
        IfCondition EqualTo(c0, 0) ThenBlock: {
            OptState.parity_node = 0
            ReturnValue(0)
        }
        IfCondition EqualTo(c1, 0) ThenBlock: {
            OptState.parity_node = 0
            ReturnValue(0)
        }
        IfCondition EqualTo(c0, 1) ThenBlock: {
            OptState.parity_node = 0
            ReturnValue(1)
        }
        IfCondition EqualTo(c1, 1) ThenBlock: {
            OptState.parity_node = 0
            ReturnValue(1)
        }
        IfCondition EqualTo(c0, 2) ThenBlock: {
            IfCondition EqualTo(c1, 2) ThenBlock: {
                OptState.parity_node = 0
                ReturnValue(2)
            }
            OptState.parity_node = n1
            ReturnValue(c1)
        }
        IfCondition EqualTo(c1, 2) ThenBlock: {
            OptState.parity_node = n0
            ReturnValue(c0)
        }
        OptState.parity_node = 0
        ReturnValue(0)
    }
}

// 1 means the true arm is the clear bit (CMOVE). 2 means the set bit (CMOVNE).
Function.Optimize_ParityCode {
    Input: node: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(node), AST.CALL) ThenBlock: { ReturnValue(0) }
        name = AST_GetData1(node)
        eq = EqualTo(StringCompare(name, "EqualTo"), 0)
        ne = EqualTo(StringCompare(name, "NotEqual"), 0)
        IfCondition EqualTo(eq, 0) ThenBlock: {
            IfCondition EqualTo(ne, 0) ThenBlock: { ReturnValue(0) }
        }
        IfCondition NotEqual(AST_GetChildCount(node), 2) ThenBlock: { ReturnValue(0) }
        a0 = AST_GetChild(node, 0)
        a1 = AST_GetChild(node, 1)
        imm = -1
        expr = 0
        IfCondition EqualTo(AST_GetType(a1), AST.NUMBER) ThenBlock: {
            imm = StringToNumber(AST_GetData1(a1))
            expr = a0
        }
        IfCondition EqualTo(expr, 0) ThenBlock: {
            IfCondition EqualTo(AST_GetType(a0), AST.NUMBER) ThenBlock: {
                imm = StringToNumber(AST_GetData1(a0))
                expr = a1
            }
        }
        IfCondition EqualTo(expr, 0) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterThan(imm, 1) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(imm, 0) ThenBlock: { ReturnValue(0) }
        cls = Optimize_LowClass(expr)
        IfCondition EqualTo(cls, 0) ThenBlock: {
            OptState.parity_cls = 0
            ReturnValue(0)
        }
        OptState.parity_cls = cls
        want_clear = 0
        IfCondition EqualTo(eq, 1) ThenBlock: {
            IfCondition EqualTo(imm, 0) ThenBlock: { want_clear = 1 }
        }
        IfCondition EqualTo(ne, 1) ThenBlock: {
            IfCondition EqualTo(imm, 1) ThenBlock: { want_clear = 1 }
        }
        IfCondition EqualTo(want_clear, 1) ThenBlock: { ReturnValue(1) }
        ReturnValue(2)
    }
}

Function.Optimize_EmitLowBit {
    Output: Integer
    Body: {
        cls = OptState.parity_cls
        src = OptState.parity_node
        IfCondition EqualTo(cls, 1) ThenBlock: {
            Emit_XorRaxRax()
            Emit_TestRaxRax()
            ReturnValue(1)
        }
        IfCondition EqualTo(cls, 2) ThenBlock: {
            Emit_MovRaxImm64(1)
            Emit_TestRaxRax()
            ReturnValue(1)
        }
        IfCondition NotEqual(cls, 3) ThenBlock: { ReturnValue(2) }
        IfCondition EqualTo(src, 0) ThenBlock: { ReturnValue(2) }
        IfCondition EqualTo(Optimize_IdentEq(src, LoopHome.int_name), 1) ThenBlock: {
            asm = "TEST r13, "
            nstr = NumberToString(1)
            asm = StringConcat(asm, nstr)
            X86Enc_Assemble(asm)
            ReturnValue(1)
        }
        result = Compile_Expression(src)
        IfCondition EqualTo(result, 0) ThenBlock: { ReturnValue(2) }
        asm2 = "TEST rax, "
        nstr2 = NumberToString(1)
        asm2 = StringConcat(asm2, nstr2)
        X86Enc_Assemble(asm2)
        ReturnValue(1)
    }
}

Function.Optimize_FlagReady {
    Input: node: Address
    Output: Integer
    Body: {
        pcode = Optimize_ParityCode(node)
        IfCondition NotEqual(pcode, 0) ThenBlock: { ReturnValue(pcode) }
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(node), AST.CALL) ThenBlock: { ReturnValue(0) }
        code = Optimize_FlagCode(AST_GetData1(node))
        IfCondition EqualTo(code, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetChildCount(node), 2) ThenBlock: { ReturnValue(0) }
        arg0 = AST_GetChild(node, 0)
        arg1 = AST_GetChild(node, 1)
        other = 0
        IfCondition EqualTo(Optimize_IsZeroNum(arg1), 1) ThenBlock: {
            IfCondition EqualTo(Optimize_IsLeaf(arg0), 0) ThenBlock: { other = arg0 }
        }
        IfCondition EqualTo(other, 0) ThenBlock: {
            IfCondition EqualTo(Optimize_IsZeroNum(arg0), 1) ThenBlock: {
                IfCondition EqualTo(Optimize_IsLeaf(arg1), 0) ThenBlock: { other = arg1 }
            }
        }
        IfCondition NotEqual(other, 0) ThenBlock: {
            // TEST of the right-hand value matches every compare with zero.
            // TEST of the left-hand value matches only equality.
            IfCondition EqualTo(Optimize_IsZeroNum(arg0), 1) ThenBlock: {
                IfCondition GreaterThan(code, 2) ThenBlock: { ReturnValue(0) }
            }
            ReturnValue(code)
        }
        IfCondition EqualTo(Optimize_IsLeaf(arg0), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_IsLeaf(arg1), 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(code)
    }
}

// Integer ops whose emitted code leaves rsi alone. Calls, memory copies,
// and float transcendentals do not.
Function.Optimize_RsiSafeName {
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(StringCompare(name, "Add"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "Subtract"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "Multiply"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "Divide"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "Modulo"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "Negate"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "EqualTo"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "NotEqual"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "LessThan"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "GreaterThan"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "LessEqual"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "GreaterEqual"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "BitwiseAnd"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "BitwiseOr"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "BitwiseXor"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "BitwiseNot"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "LeftShift"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "RightShift"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "BitAnd"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "BitOr"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "BitXor"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "BitNot"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "ShiftLeft"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "ShiftRight"), 0) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

Function.Optimize_KeepsRsi {
    Input: node: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        nt = AST_GetType(node)
        IfCondition EqualTo(nt, AST.NUMBER) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(nt, AST.IDENTIFIER) ThenBlock: { ReturnValue(1) }
        IfCondition NotEqual(nt, AST.CALL) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_RsiSafeName(AST_GetData1(node)), 0) ThenBlock: { ReturnValue(0) }
        count = AST_GetChildCount(node)
        i = 0
        WhileLoop LessThan(i, count) {
            IfCondition EqualTo(Optimize_KeepsRsi(AST_GetChild(node, i)), 0) ThenBlock: { ReturnValue(0) }
            i = Add(i, 1)
        }
        ReturnValue(1)
    }
}

Function.Optimize_OnlyStmt {
    Input: block: Address
    Output: Address
    Body: {
        IfCondition EqualTo(block, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(block), AST.BLOCK) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetChildCount(block), 1) ThenBlock: { ReturnValue(0) }
        ReturnValue(AST_GetChild(block, 0))
    }
}

// 1 = add imm, 2 = subtract imm, 0 = not an accumulator constant update.
// The magnitude is left in LoopHome.hit_disp.
Function.Optimize_AccDelta {
    Input: stmt: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(Optimize_PlainAssign(stmt), 0) ThenBlock: { ReturnValue(0) }
        target = AST_GetData1(stmt)
        value = AST_GetChild(stmt, 0)
        cls = Optimize_AccShape(target, value)
        IfCondition NotEqual(cls, 7) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_Fit32(LoopHome.hit_disp), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(StringCompare(AST_GetData1(value), "Subtract"), 0) ThenBlock: { ReturnValue(2) }
        ReturnValue(1)
    }
}

Function.Optimize_EmitRsiDelta {
    Input: kind: Integer
    Input: imm: Integer
    Body: {
        IfCondition EqualTo(kind, 2) ThenBlock: {
            asm = "SUB rsi, "
            nstr = NumberToString(imm)
            asm = StringConcat(asm, nstr)
            X86Enc_Assemble(asm)
        }
        IfCondition EqualTo(kind, 1) ThenBlock: {
            asm = "ADD rsi, "
            nstr = NumberToString(imm)
            asm = StringConcat(asm, nstr)
            X86Enc_Assemble(asm)
        }
    }
}

Function.Optimize_EmitCmov {
    Input: code: Integer
    Body: {
        IfCondition EqualTo(code, 1) ThenBlock: { X86Enc_Assemble("CMOVE r12, rsi") }
        IfCondition EqualTo(code, 2) ThenBlock: { X86Enc_Assemble("CMOVNE r12, rsi") }
        IfCondition EqualTo(code, 3) ThenBlock: { X86Enc_Assemble("CMOVL r12, rsi") }
        IfCondition EqualTo(code, 4) ThenBlock: { X86Enc_Assemble("CMOVG r12, rsi") }
        IfCondition EqualTo(code, 5) ThenBlock: { X86Enc_Assemble("CMOVLE r12, rsi") }
        IfCondition EqualTo(code, 6) ThenBlock: { X86Enc_Assemble("CMOVGE r12, rsi") }
    }
}

// Unsigned compare of 64-bit patterns. Flipping the sign bit turns it
// into a signed compare.
Function.Optimize_ULt {
    Input: a: Integer
    Input: b: Integer
    Output: Integer
    Body: {
        hibit = LeftShift(1, 63)
        fa = BitwiseXor(a, hibit)
        fb = BitwiseXor(b, hibit)
        ReturnValue(LessThan(fa, fb))
    }
}

Function.Optimize_UGe {
    Input: a: Integer
    Input: b: Integer
    Output: Integer
    Body: {
        hibit = LeftShift(1, 63)
        fa = BitwiseXor(a, hibit)
        fb = BitwiseXor(b, hibit)
        ReturnValue(EqualTo(LessThan(fa, fb), 0))
    }
}

// A conditional or a loop can skip the assignment, so it does not dominate.
Function.Optimize_BindSkip {
    Input: nt: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(nt, AST.IF) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(nt, AST.WHILE) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(nt, AST.FOR_EVERY) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(nt, AST.SWITCH) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(nt, AST.TRY) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(nt, AST.CATCH) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(nt, AST.BRANCH) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(nt, AST.UNTIL) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(nt, AST.FORK) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(nt, AST.DEFER) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(nt, AST.LOOP_MAIN) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(nt, AST.LOOP_ACTOR) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(nt, AST.LOOP_START) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(nt, AST.LOOP_SHADOW) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(nt, AST.EVERY_INTERVAL) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(nt, AST.LAMBDA_EXPR) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

Function.Optimize_BindWalk {
    Input: node: Address
    Input: name: Address
    Input: use: Address
    Input: guard: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(node, use) ThenBlock: {
            IfCondition EqualTo(OptState.bind_seen, 0) ThenBlock: {
                OptState.bind_late = 1
            }
        }
        nt = AST_GetType(node)
        next_guard = guard
        IfCondition EqualTo(Optimize_BindSkip(nt), 1) ThenBlock: { next_guard = 1 }
        IfCondition EqualTo(nt, AST.FUNCTION) ThenBlock: {
            IfCondition NotEqual(node, OptState.bind_root) ThenBlock: { next_guard = 1 }
        }
        IfCondition EqualTo(nt, AST.SUBROUTINE) ThenBlock: {
            IfCondition NotEqual(node, OptState.bind_root) ThenBlock: { next_guard = 1 }
        }
        IfCondition EqualTo(nt, AST.CALL) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(AST_GetData1(node), "AddressOf"), 1) ThenBlock: {
                IfCondition GreaterThan(AST_GetChildCount(node), 0) ThenBlock: {
                    op0 = AST_GetChild(node, 0)
                    IfCondition NotEqual(op0, 0) ThenBlock: {
                        IfCondition EqualTo(AST_GetType(op0), AST.IDENTIFIER) ThenBlock: {
                            IfCondition EqualTo(Optimize_NameEq(AST_GetData1(op0), name), 1) ThenBlock: {
                                OptState.bind_bad = 1
                            }
                        }
                    }
                }
            }
        }
        IfCondition EqualTo(nt, AST.ASSIGNMENT) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(AST_GetData1(node), name), 1) ThenBlock: {
                OptState.bind_n = Add(OptState.bind_n, 1)
                plain = 0
                IfCondition EqualTo(AST_GetData2(node), 0) ThenBlock: { plain = 1 }
                rhs = AST_GetChild(node, 0)
                rhs_num = 0
                IfCondition NotEqual(rhs, 0) ThenBlock: {
                    IfCondition EqualTo(AST_GetType(rhs), AST.NUMBER) ThenBlock: { rhs_num = 1 }
                }
                take = 0
                IfCondition EqualTo(plain, 1) ThenBlock: {
                    IfCondition EqualTo(guard, 0) ThenBlock: {
                        IfCondition EqualTo(rhs_num, 1) ThenBlock: {
                            IfCondition EqualTo(OptState.bind_seen, 0) ThenBlock: { take = 1 }
                        }
                    }
                }
                IfCondition EqualTo(take, 1) ThenBlock: {
                    OptState.bind_val = StringToNumber(AST_GetData1(rhs))
                    OptState.bind_seen = 1
                } ElseBlock: {
                    OptState.bind_bad = 1
                }
            }
        }
        count = AST_GetChildCount(node)
        i = 0
        WhileLoop LessThan(i, count) {
            Optimize_BindWalk(AST_GetChild(node, i), name, use, next_guard)
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

// One straight-line number assignment dominates a later use. A second
// assignment, or one inside a conditional or loop, is not constant.
Function.Optimize_BindConst {
    Input: name: Address
    Input: use: Address
    Output: Integer
    Body: {
        OptState.bind_n = 0
        OptState.bind_bad = 0
        OptState.bind_val = 0
        OptState.bind_seen = 0
        OptState.bind_late = 0
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Compile.current_func, 0) ThenBlock: { ReturnValue(0) }
        OptState.bind_root = Compile.current_func
        Optimize_BindWalk(Compile.current_func, name, use, 0)
        IfCondition NotEqual(OptState.bind_n, 1) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(OptState.bind_bad, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(OptState.bind_late, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(OptState.bind_seen, 1) ThenBlock: { ReturnValue(0) }
        ReturnValue(1)
    }
}

// Magic number for toward-zero division by abs(d). The divisor here is a
// value, so the Divide and Modulo below stay on IDIV. Negative divisors
// use the same magnitude and negate the quotient. -1, 0, 1, and INT64_MIN
// fail open.
Function.Optimize_MagicPrepare {
    Input: d: Integer
    Output: Integer
    Body: {
        hibit = LeftShift(1, 63)
        IfCondition EqualTo(d, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(d, 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(d, -1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(d, hibit) ThenBlock: { ReturnValue(0) }
        neg = 0
        ad = d
        IfCondition LessThan(d, 0) ThenBlock: {
            neg = 1
            ad = Subtract(0, d)
        }
        IfCondition LessThan(ad, 2) ThenBlock: { ReturnValue(0) }
        urem = Subtract(0, Modulo(hibit, ad))
        anc = Subtract(Subtract(hibit, 1), urem)
        IfCondition EqualTo(anc, 0) ThenBlock: { ReturnValue(0) }
        q1 = Subtract(0, Divide(hibit, anc))
        r1 = Subtract(0, Modulo(hibit, anc))
        q2 = Subtract(0, Divide(hibit, ad))
        r2 = urem
        steps = 0
        again = 1
        bad = 0
        WhileLoop EqualTo(again, 1) {
            q1 = LeftShift(q1, 1)
            r1 = LeftShift(r1, 1)
            q2 = LeftShift(q2, 1)
            r2 = LeftShift(r2, 1)
            IfCondition EqualTo(Optimize_UGe(r1, anc), 1) ThenBlock: {
                q1 = Add(q1, 1)
                r1 = Subtract(r1, anc)
            }
            IfCondition EqualTo(Optimize_UGe(r2, ad), 1) ThenBlock: {
                q2 = Add(q2, 1)
                r2 = Subtract(r2, ad)
            }
            steps = Add(steps, 1)
            delta = Subtract(ad, r2)
            cont = 0
            IfCondition EqualTo(Optimize_ULt(q1, delta), 1) ThenBlock: { cont = 1 }
            IfCondition EqualTo(q1, delta) ThenBlock: {
                IfCondition EqualTo(r1, 0) ThenBlock: { cont = 1 }
            }
            IfCondition EqualTo(cont, 0) ThenBlock: {
                again = 0
            } ElseBlock: {
                IfCondition GreaterEqual(steps, 64) ThenBlock: {
                    bad = 1
                    again = 0
                }
            }
        }
        IfCondition EqualTo(bad, 1) ThenBlock: { ReturnValue(0) }
        OptState.magic_m = Add(q2, 1)
        OptState.magic_sh = Subtract(steps, 1)
        OptState.magic_neg = neg
        ReturnValue(1)
    }
}

// Modulo of the integer home by a positive power of two is a mask test
// when the dividend is non-negative. ZF then matches a compare with zero.
Function.Optimize_TryModFlag {
    Input: node: Address
    Input: code: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterThan(code, 2) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(node), AST.CALL) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(StringCompare(AST_GetData1(node), "Modulo"), 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetChildCount(node), 2) ThenBlock: { ReturnValue(0) }
        a0 = AST_GetChild(node, 0)
        a1 = AST_GetChild(node, 1)
        IfCondition EqualTo(Optimize_IdentEq(a0, LoopHome.int_name), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_ReadImm(a1), 0) ThenBlock: { ReturnValue(0) }
        val = LoopHome.imm_val
        IfCondition LessEqual(val, 0) ThenBlock: { ReturnValue(0) }
        mask = Subtract(val, 1)
        IfCondition NotEqual(BitwiseAnd(val, mask), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_Fit32(mask), 0) ThenBlock: { ReturnValue(0) }
        saved_lo = LoopHome.range_lo
        saved_hi = LoopHome.range_hi
        proved = Optimize_NonNeg(a0)
        LoopHome.range_lo = saved_lo
        LoopHome.range_hi = saved_hi
        IfCondition EqualTo(proved, 0) ThenBlock: { ReturnValue(0) }
        asm = "TEST r13, "
        nstr = NumberToString(mask)
        asm = StringConcat(asm, nstr)
        X86Enc_Assemble(asm)
        ReturnValue(1)
    }
}

Function.Optimize_EmitFlags {
    Input: node: Address
    Input: code: Integer
    Output: Integer
    Body: {
        pcode = Optimize_ParityCode(node)
        IfCondition NotEqual(pcode, 0) ThenBlock: {
            ReturnValue(Optimize_EmitLowBit())
        }
        arg0 = AST_GetChild(node, 0)
        arg1 = AST_GetChild(node, 1)
        other = 0
        IfCondition EqualTo(Optimize_IsZeroNum(arg1), 1) ThenBlock: {
            IfCondition EqualTo(Optimize_IsLeaf(arg0), 0) ThenBlock: { other = arg0 }
        }
        IfCondition EqualTo(other, 0) ThenBlock: {
            IfCondition EqualTo(Optimize_IsZeroNum(arg0), 1) ThenBlock: {
                IfCondition EqualTo(Optimize_IsLeaf(arg1), 0) ThenBlock: { other = arg1 }
            }
        }
        IfCondition NotEqual(other, 0) ThenBlock: {
            IfCondition EqualTo(Optimize_TryModFlag(other, code), 1) ThenBlock: { ReturnValue(1) }
            result = Compile_Expression(other)
            IfCondition EqualTo(result, 0) ThenBlock: { ReturnValue(2) }
            Emit_TestRaxRax()
            ReturnValue(1)
        }
        result = CompileCompare_Binary(node)
        IfCondition EqualTo(result, 0) ThenBlock: { ReturnValue(2) }
        ReturnValue(1)
    }
}

// Both arms assign the r12 accumulator by a constant. The false update is
// applied first. CMOVcc writes the true value when the compare is true.
// Refused when the condition names that accumulator or can write rsi.
Function.Optimize_TryIfSelect {
    Input: condition: Address
    Input: then_block: Address
    Input: else_block: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(LoopHome.active, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(LoopHome.acc_name, 0) ThenBlock: { ReturnValue(0) }
        then_stmt = Optimize_OnlyStmt(then_block)
        else_stmt = Optimize_OnlyStmt(else_block)
        IfCondition EqualTo(then_stmt, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(else_stmt, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_PlainAssign(then_stmt), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_PlainAssign(else_stmt), 0) ThenBlock: { ReturnValue(0) }
        tname = AST_GetData1(then_stmt)
        ename = AST_GetData1(else_stmt)
        IfCondition EqualTo(Optimize_NameEq(tname, ename), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_IsAccHome(tname), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_TreeHasName(condition, tname), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_KeepsRsi(condition), 0) ThenBlock: { ReturnValue(0) }
        code = Optimize_FlagReady(condition)
        IfCondition EqualTo(code, 0) ThenBlock: { ReturnValue(0) }
        saved_class = LoopHome.hit_class
        saved_disp = LoopHome.hit_disp
        saved_imm = LoopHome.imm_val
        saved_ok = LoopHome.imm_ok
        tdelta = Optimize_AccDelta(then_stmt)
        timm = LoopHome.hit_disp
        edelta = 0
        eimm = 0
        IfCondition NotEqual(tdelta, 0) ThenBlock: {
            edelta = Optimize_AccDelta(else_stmt)
            eimm = LoopHome.hit_disp
        }
        LoopHome.hit_class = saved_class
        LoopHome.hit_disp = saved_disp
        LoopHome.imm_val = saved_imm
        LoopHome.imm_ok = saved_ok
        IfCondition EqualTo(tdelta, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(edelta, 0) ThenBlock: { ReturnValue(0) }
        X86Enc_Assemble("MOV rsi, r12")
        Optimize_EmitRsiDelta(tdelta, timm)
        IfCondition EqualTo(edelta, 2) ThenBlock: { Emit_HomeMove(42, eimm) }
        IfCondition EqualTo(edelta, 1) ThenBlock: { Emit_HomeMove(41, eimm) }
        got = Optimize_EmitFlags(condition, code)
        IfCondition EqualTo(got, 2) ThenBlock: { ReturnValue(2) }
        IfCondition EqualTo(got, 0) ThenBlock: { ReturnValue(2) }
        Optimize_EmitCmov(code)
        ReturnValue(1)
    }
}

// Float predicates. A compare used as a value stays on the 0/1 path.
// This is only the branch form.

Function.Optimize_IsFloatCmp {
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(StringCompare(name, "Float_Eq"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "Float_Ne"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "Float_Lt"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "Float_Gt"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "Float_Le"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "Float_Ge"), 0) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

// Class 1 is a float home. 6 and 8 are frame or a constant pool slot.
// 7 is the r15 pool. A held xmm0 is not ready: the hold is clear at a branch.

Function.Optimize_XmmReady {
    Input: node: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        Optimize_OpClass(node)
        cls = LoopHome.hit_class
        IfCondition EqualTo(cls, 1) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(cls, 6) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(cls, 7) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(cls, 8) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

// One add, subtract, or multiply of two ready leaves. A multiply stays
// unfused here: the compare is not an assignment the FMA pass can see.

Function.Optimize_FcmpBinReady {
    Input: node: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(node), AST.CALL) ThenBlock: { ReturnValue(0) }
        opk = Optimize_FltOpKind(AST_GetData1(node))
        ok = 0
        IfCondition EqualTo(opk, 1) ThenBlock: { ok = 1 }
        IfCondition EqualTo(opk, 2) ThenBlock: { ok = 1 }
        IfCondition EqualTo(opk, 3) ThenBlock: { ok = 1 }
        IfCondition EqualTo(ok, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetChildCount(node), 2) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_XmmReady(AST_GetChild(node, 0)), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_XmmReady(AST_GetChild(node, 1)), 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(1)
    }
}

Function.Optimize_FloatCmpReady {
    Input: node: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(node), AST.CALL) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_IsFloatCmp(AST_GetData1(node)), 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetChildCount(node), 2) ThenBlock: { ReturnValue(0) }
        left = AST_GetChild(node, 0)
        right = AST_GetChild(node, 1)
        left_bin = Optimize_FcmpBinReady(left)
        right_bin = Optimize_FcmpBinReady(right)
        // The right binop is emitted into xmm0 and moved to xmm1. A binop
        // on both sides would clobber that copy.
        IfCondition EqualTo(left_bin, 1) ThenBlock: {
            IfCondition EqualTo(right_bin, 1) ThenBlock: { ReturnValue(0) }
        }
        left_ok = left_bin
        IfCondition EqualTo(left_ok, 0) ThenBlock: { left_ok = Optimize_XmmReady(left) }
        right_ok = right_bin
        IfCondition EqualTo(right_ok, 0) ThenBlock: { right_ok = Optimize_XmmReady(right) }
        IfCondition EqualTo(left_ok, 1) ThenBlock: {
            IfCondition EqualTo(right_ok, 1) ThenBlock: { ReturnValue(1) }
        }
        ReturnValue(0)
    }
}

// An integer leaf compare, or a float compare of homes and frame slots.
// A computed compare against zero stays on the single-compare path.

Function.Optimize_BranchReady {
    Input: node: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(node), AST.CALL) ThenBlock: { ReturnValue(0) }
        name = AST_GetData1(node)
        IfCondition EqualTo(Optimize_IsCompareName(name), 1) ThenBlock: {
            IfCondition EqualTo(AST_GetChildCount(node), 2) ThenBlock: {
                IfCondition EqualTo(Optimize_IsLeaf(AST_GetChild(node, 0)), 1) ThenBlock: {
                    IfCondition EqualTo(Optimize_IsLeaf(AST_GetChild(node, 1)), 1) ThenBlock: { ReturnValue(1) }
                }
            }
        }
        ReturnValue(Optimize_FloatCmpReady(node))
    }
}

Function.Optimize_EmitFcmpLeaf {
    Input: dst: Integer
    Input: node: Address
    Output: Integer
    Body: {
        Optimize_OpClass(node)
        cls = LoopHome.hit_class
        disp = LoopHome.hit_disp
        xmm = LoopHome.hit_xmm
        IfCondition EqualTo(cls, 1) ThenBlock: {
            X86_XmmBin(16, dst, xmm)
            ReturnValue(1)
        }
        IfCondition EqualTo(cls, 6) ThenBlock: {
            X86_EmitRbpXmm(16, dst, disp)
            ReturnValue(1)
        }
        IfCondition EqualTo(cls, 8) ThenBlock: {
            X86_EmitRbpXmm(16, dst, disp)
            ReturnValue(1)
        }
        IfCondition EqualTo(cls, 7) ThenBlock: {
            X86_EmitR15Xmm(16, dst, disp)
            ReturnValue(1)
        }
        ReturnValue(0)
    }
}

// Apply one SSE op into xmm0. The left side of a compare binop is already there.

Function.Optimize_EmitFcmpApply {
    Input: opcode: Integer
    Input: node: Address
    Output: Integer
    Body: {
        Optimize_OpClass(node)
        cls = LoopHome.hit_class
        disp = LoopHome.hit_disp
        xmm = LoopHome.hit_xmm
        IfCondition EqualTo(cls, 1) ThenBlock: {
            X86_XmmBin(opcode, 0, xmm)
            ReturnValue(1)
        }
        IfCondition EqualTo(cls, 6) ThenBlock: {
            X86_EmitRbpXmm(opcode, 0, disp)
            ReturnValue(1)
        }
        IfCondition EqualTo(cls, 8) ThenBlock: {
            X86_EmitRbpXmm(opcode, 0, disp)
            ReturnValue(1)
        }
        IfCondition EqualTo(cls, 7) ThenBlock: {
            X86_EmitR15Xmm(opcode, 0, disp)
            ReturnValue(1)
        }
        ReturnValue(0)
    }
}

Function.Optimize_EmitFcmpBin {
    Input: node: Address
    Output: Integer
    Body: {
        opk = Optimize_FltOpKind(AST_GetData1(node))
        opc = 88
        IfCondition EqualTo(opk, 2) ThenBlock: { opc = 92 }
        IfCondition EqualTo(opk, 3) ThenBlock: { opc = 89 }
        IfCondition EqualTo(opc, 88) ThenBlock: {
            IfCondition NotEqual(opk, 1) ThenBlock: { ReturnValue(0) }
        }
        IfCondition EqualTo(Optimize_EmitFcmpLeaf(0, AST_GetChild(node, 0)), 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(Optimize_EmitFcmpApply(opc, AST_GetChild(node, 1)))
    }
}

// Right operand of a compare whose left value is already in xmm0.
// A home xmm is the ucomisd source. Anything else is copied to xmm1 first.

Function.Optimize_EmitFcmpAgainst {
    Input: node: Address
    Output: Integer
    Body: {
        Optimize_OpClass(node)
        cls = LoopHome.hit_class
        xmm = LoopHome.hit_xmm
        IfCondition EqualTo(cls, 1) ThenBlock: {
            IfCondition GreaterEqual(xmm, 2) ThenBlock: {
                X86_UcomisdXmm0(xmm)
                ReturnValue(1)
            }
        }
        IfCondition EqualTo(Optimize_EmitFcmpLeaf(1, node), 0) ThenBlock: { ReturnValue(0) }
        X86_UcomisdXmm0Xmm1()
        ReturnValue(1)
    }
}

// False jump for a float compare. LE and LT are false on NaN. GT and GE
// already are, because unordered sets CF. EQ is false on NaN. NE is true
// on NaN, so a parity jump skips the equal jump.

Function.Optimize_EmitFloatCmp {
    Input: node: Address
    Input: false_label: Integer
    Output: Integer
    Body: {
        Optimize_IholdPark()
        Optimize_FlushHold()
        left = AST_GetChild(node, 0)
        right = AST_GetChild(node, 1)
        left_bin = Optimize_FcmpBinReady(left)
        right_bin = Optimize_FcmpBinReady(right)
        paired = 0
        IfCondition EqualTo(left_bin, 1) ThenBlock: {
            IfCondition EqualTo(Optimize_EmitFcmpBin(left), 0) ThenBlock: { ReturnValue(0) }
            IfCondition EqualTo(Optimize_EmitFcmpAgainst(right), 0) ThenBlock: { ReturnValue(0) }
            paired = 1
        }
        IfCondition EqualTo(left_bin, 0) ThenBlock: {
            IfCondition EqualTo(right_bin, 1) ThenBlock: {
                IfCondition EqualTo(Optimize_EmitFcmpBin(right), 0) ThenBlock: { ReturnValue(0) }
                X86_XmmBin(16, 1, 0)
                IfCondition EqualTo(Optimize_EmitFcmpLeaf(0, left), 0) ThenBlock: { ReturnValue(0) }
            }
            IfCondition EqualTo(right_bin, 0) ThenBlock: {
                IfCondition EqualTo(Optimize_EmitFcmpLeaf(0, left), 0) ThenBlock: { ReturnValue(0) }
                IfCondition EqualTo(Optimize_EmitFcmpAgainst(right), 0) ThenBlock: { ReturnValue(0) }
                paired = 1
            }
        }
        IfCondition EqualTo(paired, 0) ThenBlock: {
            X86_UcomisdXmm0Xmm1()
        }
        name = AST_GetData1(node)
        IfCondition EqualTo(StringCompare(name, "Float_Le"), 0) ThenBlock: {
            X86_Ja(false_label)
            X86_Jp(false_label)
            ReturnValue(1)
        }
        IfCondition EqualTo(StringCompare(name, "Float_Lt"), 0) ThenBlock: {
            X86_Jae(false_label)
            X86_Jp(false_label)
            ReturnValue(1)
        }
        IfCondition EqualTo(StringCompare(name, "Float_Gt"), 0) ThenBlock: {
            X86_Jbe(false_label)
            ReturnValue(1)
        }
        IfCondition EqualTo(StringCompare(name, "Float_Ge"), 0) ThenBlock: {
            X86_Jb(false_label)
            ReturnValue(1)
        }
        IfCondition EqualTo(StringCompare(name, "Float_Eq"), 0) ThenBlock: {
            X86_Jne(false_label)
            X86_Jp(false_label)
            ReturnValue(1)
        }
        IfCondition EqualTo(StringCompare(name, "Float_Ne"), 0) ThenBlock: {
            skip = Compile_NewLabel()
            X86_Jp(skip)
            X86_Je(false_label)
            Emit_MarkLabel(skip)
            ReturnValue(1)
        }
        ReturnValue(0)
    }
}

Function.Optimize_EmitFalseJump {
    Input: node: Address
    Input: false_label: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(Optimize_FloatCmpReady(node), 1) ThenBlock: {
            ReturnValue(Optimize_EmitFloatCmp(node, false_label))
        }
        IfCondition EqualTo(Optimize_IsCompareName(AST_GetData1(node)), 0) ThenBlock: { ReturnValue(0) }
        got = CompileCompare_Binary(node)
        IfCondition EqualTo(got, 0) ThenBlock: { ReturnValue(0) }
        Optimize_JumpIfFalse(AST_GetData1(node), false_label)
        ReturnValue(1)
    }
}

// One read-only float into the next free xmm. Repeating this picks every
// invariant. The highest load count wins, so the first call matches the
// old single install.

Function.Optimize_TakeFlt {
    Input: condition: Address
    Input: body: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(LoopHome.no_float, 1) ThenBlock: { ReturnValue(0) }
        free = 0
        IfCondition EqualTo(LoopHome.f2_name, 0) ThenBlock: { free = 1 }
        IfCondition EqualTo(LoopHome.f3_name, 0) ThenBlock: { free = 1 }
        IfCondition EqualTo(LoopHome.f4_name, 0) ThenBlock: { free = 1 }
        IfCondition EqualTo(LoopHome.f5_name, 0) ThenBlock: { free = 1 }
        IfCondition EqualTo(LoopHome.f6_name, 0) ThenBlock: { free = 1 }
        IfCondition LessThan(LoopHome.xf_n, 7) ThenBlock: { free = 1 }
        IfCondition EqualTo(free, 0) ThenBlock: { ReturnValue(0) }
        best = 0
        best_off = 0
        best_loads = 0
        i = 0
        WhileLoop LessThan(i, LoopHome.count) {
            rec = Optimize_HomeRec(i)
            name = Dereference(rec)
            loads = Dereference(Add(rec, 8))
            stores = Dereference(Add(rec, 16))
            IfCondition GreaterThan(loads, 0) ThenBlock: {
                IfCondition EqualTo(stores, 0) ThenBlock: {
                    IfCondition EqualTo(Optimize_NameTaken(name), 0) ThenBlock: {
                        skip = 0
                        IfCondition EqualTo(LoopHome.tab_on, 1) ThenBlock: {
                            IfCondition EqualTo(Optimize_NameEq(name, LoopHome.tab_name), 1) ThenBlock: { skip = 1 }
                        }
                        IfCondition EqualTo(LoopHome.lim_on, 1) ThenBlock: {
                            IfCondition EqualTo(Optimize_NameEq(name, LoopHome.lim_name), 1) ThenBlock: { skip = 1 }
                        }
                        IfCondition EqualTo(skip, 0) ThenBlock: {
                            IfCondition EqualTo(Optimize_FrameOff(name), 1) ThenBlock: {
                                off = LoopHome.imm_val
                                IfCondition GreaterThan(loads, best_loads) ThenBlock: {
                                    IfCondition EqualTo(Optimize_InvOk(name, 1, condition, body), 1) ThenBlock: {
                                        best = name
                                        best_off = off
                                        best_loads = loads
                                    }
                                }
                            }
                        }
                    }
                }
            }
            i = Add(i, 1)
        }
        IfCondition EqualTo(best, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(LoopHome.f2_name, 0) ThenBlock: {
            LoopHome.f2_name = best
            LoopHome.f2_off = best_off
            ReturnValue(1)
        }
        IfCondition EqualTo(LoopHome.f3_name, 0) ThenBlock: {
            LoopHome.f3_name = best
            LoopHome.f3_off = best_off
            ReturnValue(1)
        }
        IfCondition EqualTo(LoopHome.f4_name, 0) ThenBlock: {
            LoopHome.f4_name = best
            LoopHome.f4_off = best_off
            ReturnValue(1)
        }
        IfCondition EqualTo(LoopHome.f5_name, 0) ThenBlock: {
            LoopHome.f5_name = best
            LoopHome.f5_off = best_off
            ReturnValue(1)
        }
        IfCondition EqualTo(LoopHome.f6_name, 0) ThenBlock: {
            LoopHome.f6_name = best
            LoopHome.f6_off = best_off
            ReturnValue(1)
        }
        ReturnValue(Optimize_XfInstall(best, best_off))
    }
}
