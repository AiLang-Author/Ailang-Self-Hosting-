// Library.COptCFG.ailang
// Explicit basic-block graph for one function body, built once per
// function by Optimize_CFGFunction. Mirrors the existing recursive
// CompileStmt_Block/While/If/Switch shape, but emits block records
// instead of code. No consumer yet (same scaffolding status COptTag
// had before Milestone 2/3 wire it up) - emitters and codegen are
// unchanged by this file. Loaded by the optimizer shell. No imports
// of its own.

// Lazy-init BlockPool.buf and hand out one zeroed 40-byte block
// record. Returns the new block's id (its slot index), or -1 on
// overflow (65536 blocks is far beyond any real function body; an
// overflow here means something is wrong in the caller, not that a
// real function hit the limit).
Function.Optimize_CFGNewBlock {
    Output: Integer
    Body: {
        IfCondition EqualTo(BlockPool.buf, 0) ThenBlock: {
            BlockPool.buf = Allocate(Multiply(BlockPool.cap, 40))
            IfCondition EqualTo(BlockPool.buf, 0) ThenBlock: {
                PrintMessage("[CFG] FATAL: block pool buf Allocate failed\n")
                ReturnValue(-1)
            }
        }
        IfCondition GreaterEqual(BlockPool.head, BlockPool.cap) ThenBlock: {
            PrintMessage("[CFG] FATAL: block pool overflow at head=")
            PrintNumber(BlockPool.head)
            PrintMessage("\n")
            ReturnValue(-1)
        }
        id = BlockPool.head
        BlockPool.head = Add(BlockPool.head, 1)
        slot = Add(BlockPool.buf, Multiply(id, 40))
        StoreValue(Add(slot, 0), 0)    // succ0
        StoreValue(Add(slot, 8), 0)    // succ1
        StoreValue(Add(slot, 16), -1)  // pos_start (unset)
        StoreValue(Add(slot, 24), -1)  // pos_end (unset)
        StoreValue(Add(slot, 32), 0)   // is_loop_header
        ReturnValue(id)
    }
}

// Record address for a live block id, or 0 when out of range.
Function.Optimize_CFGBlockPtr {
    Input: id: Integer
    Output: Address
    Body: {
        IfCondition LessThan(id, 0) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterEqual(id, BlockPool.head) ThenBlock: { ReturnValue(0) }
        ReturnValue(Add(BlockPool.buf, Multiply(id, 40)))
    }
}

Function.Optimize_CFGSucc0 {
    Input: id: Integer
    Output: Integer
    Body: {
        ptr = Optimize_CFGBlockPtr(id)
        IfCondition EqualTo(ptr, 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(Dereference(ptr))
    }
}

Function.Optimize_CFGSucc1 {
    Input: id: Integer
    Output: Integer
    Body: {
        ptr = Optimize_CFGBlockPtr(id)
        IfCondition EqualTo(ptr, 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(Dereference(Add(ptr, 8)))
    }
}

Function.Optimize_CFGSetSucc0 {
    Input: id: Integer
    Input: target: Integer
    Body: {
        ptr = Optimize_CFGBlockPtr(id)
        IfCondition EqualTo(ptr, 0) ThenBlock: { ReturnValue(0) }
        StoreValue(ptr, target)
        ReturnValue(0)
    }
}

Function.Optimize_CFGSetSucc1 {
    Input: id: Integer
    Input: target: Integer
    Body: {
        ptr = Optimize_CFGBlockPtr(id)
        IfCondition EqualTo(ptr, 0) ThenBlock: { ReturnValue(0) }
        StoreValue(Add(ptr, 8), target)
        ReturnValue(0)
    }
}

Function.Optimize_CFGPosStart {
    Input: id: Integer
    Output: Integer
    Body: {
        ptr = Optimize_CFGBlockPtr(id)
        IfCondition EqualTo(ptr, 0) ThenBlock: { ReturnValue(-1) }
        ReturnValue(Dereference(Add(ptr, 16)))
    }
}

Function.Optimize_CFGPosEnd {
    Input: id: Integer
    Output: Integer
    Body: {
        ptr = Optimize_CFGBlockPtr(id)
        IfCondition EqualTo(ptr, 0) ThenBlock: { ReturnValue(-1) }
        ReturnValue(Dereference(Add(ptr, 24)))
    }
}

Function.Optimize_CFGSetLoopHeader {
    Input: id: Integer
    Body: {
        ptr = Optimize_CFGBlockPtr(id)
        IfCondition EqualTo(ptr, 0) ThenBlock: { ReturnValue(0) }
        StoreValue(Add(ptr, 32), 1)
        ReturnValue(0)
    }
}

Function.Optimize_CFGIsLoopHeader {
    Input: id: Integer
    Output: Integer
    Body: {
        ptr = Optimize_CFGBlockPtr(id)
        IfCondition EqualTo(ptr, 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(Dereference(Add(ptr, 32)))
    }
}

// Record that the current program point landed in block id. First
// touch sets pos_start; every touch advances pos_end.
Function.Optimize_CFGTouch {
    Input: id: Integer
    Body: {
        ptr = Optimize_CFGBlockPtr(id)
        IfCondition EqualTo(ptr, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Dereference(Add(ptr, 16)), -1) ThenBlock: {
            StoreValue(Add(ptr, 16), CFGState.pos)
        }
        StoreValue(Add(ptr, 24), CFGState.pos)
        ReturnValue(0)
    }
}

// Natural fallthrough close: only sets succ0 when the block does not
// already have a terminator (Break/Continue/Return set succ0
// themselves and then move CFGState.cur to -1, so this is never
// called on those blocks - this guard is defensive, matching the
// null-check style used throughout this codebase).
Function.Optimize_CFGCloseInto {
    Input: id: Integer
    Input: target: Integer
    Body: {
        IfCondition EqualTo(Optimize_CFGSucc0(id), 0) ThenBlock: {
            Optimize_CFGSetSucc0(id, target)
        }
        ReturnValue(0)
    }
}

Function.Optimize_CFGPushLoop {
    Input: continue_target: Integer
    Input: break_target: Integer
    Body: {
        Array.Push(CFGState.loop_stack, continue_target)
        Array.Push(CFGState.loop_stack, break_target)
        CFGState.loop_depth = Add(CFGState.loop_depth, 1)
    }
}

Function.Optimize_CFGPopLoop {
    Body: {
        IfCondition GreaterThan(CFGState.loop_depth, 0) ThenBlock: {
            Array.Pop(CFGState.loop_stack)
            Array.Pop(CFGState.loop_stack)
            CFGState.loop_depth = Subtract(CFGState.loop_depth, 1)
        }
    }
}

// -1 when used outside any loop (malformed input; the real parser
// already rejects this before the CFG builder ever sees it).
Function.Optimize_CFGLoopContinue {
    Output: Integer
    Body: {
        IfCondition EqualTo(CFGState.loop_depth, 0) ThenBlock: { ReturnValue(-1) }
        idx = Subtract(CFGState.loop_depth, 1)
        ReturnValue(Array.Get(CFGState.loop_stack, Multiply(idx, 2)))
    }
}

Function.Optimize_CFGLoopBreak {
    Output: Integer
    Body: {
        IfCondition EqualTo(CFGState.loop_depth, 0) ThenBlock: { ReturnValue(-1) }
        idx = Subtract(CFGState.loop_depth, 1)
        ReturnValue(Array.Get(CFGState.loop_stack, Add(Multiply(idx, 2), 1)))
    }
}

Function.Optimize_CFGWalkBreak {
    Input: node: Address
    Body: {
        IfCondition EqualTo(CFGState.cur, -1) ThenBlock: { ReturnValue(0) }
        target = Optimize_CFGLoopBreak()
        IfCondition EqualTo(target, -1) ThenBlock: { ReturnValue(0) }
        CFGState.pos = Add(CFGState.pos, 1)
        Optimize_CFGTouch(CFGState.cur)
        Optimize_TagSetPos(node, CFGState.cur, CFGState.pos)
        Optimize_CFGSetSucc0(CFGState.cur, target)
        CFGState.cur = -1
        ReturnValue(0)
    }
}

Function.Optimize_CFGWalkContinue {
    Input: node: Address
    Body: {
        IfCondition EqualTo(CFGState.cur, -1) ThenBlock: { ReturnValue(0) }
        target = Optimize_CFGLoopContinue()
        IfCondition EqualTo(target, -1) ThenBlock: { ReturnValue(0) }
        CFGState.pos = Add(CFGState.pos, 1)
        Optimize_CFGTouch(CFGState.cur)
        Optimize_TagSetPos(node, CFGState.cur, CFGState.pos)
        Optimize_CFGSetSucc0(CFGState.cur, target)
        CFGState.cur = -1
        ReturnValue(0)
    }
}

Function.Optimize_CFGWalkReturn {
    Input: node: Address
    Body: {
        IfCondition EqualTo(CFGState.cur, -1) ThenBlock: { ReturnValue(0) }
        CFGState.pos = Add(CFGState.pos, 1)
        Optimize_CFGTouch(CFGState.cur)
        // The return-value expression (if any) is tagged, not the
        // RETURN node itself - its uses are what matters for liveness.
        rv = AST_GetChild(node, 0)
        IfCondition NotEqual(rv, 0) ThenBlock: {
            Optimize_TagSetPos(rv, CFGState.cur, CFGState.pos)
        } ElseBlock: {
            Optimize_TagSetPos(node, CFGState.cur, CFGState.pos)
        }
        Optimize_CFGSetSucc0(CFGState.cur, CFGState.exit_block)
        CFGState.cur = -1
        ReturnValue(0)
    }
}

// Shared by AST.IF and AST.FORK - both carry [condition, true_block,
// false_block?] in the same child positions (CompileStmt_Fork already
// treats Fork as "same as IfCondition but different syntax").
Function.Optimize_CFGWalkIf {
    Input: node: Address
    Body: {
        then_block = AST_GetChild(node, 1)
        child_count = AST_GetChildCount(node)
        has_else = GreaterThan(child_count, 2)
        else_block = 0
        IfCondition EqualTo(has_else, 1) ThenBlock: {
            else_block = AST_GetChild(node, 2)
        }

        before = CFGState.cur
        CFGState.pos = Add(CFGState.pos, 1)
        Optimize_CFGTouch(before)
        Optimize_TagSetPos(AST_GetChild(node, 0), before, CFGState.pos)

        then_id = Optimize_CFGNewBlock()
        Optimize_CFGSetSucc0(before, then_id)

        merge_id = Optimize_CFGNewBlock()

        IfCondition EqualTo(has_else, 1) ThenBlock: {
            else_id = Optimize_CFGNewBlock()
            Optimize_CFGSetSucc1(before, else_id)

            CFGState.cur = else_id
            Optimize_CFGWalkBlock(else_block)
            IfCondition NotEqual(CFGState.cur, -1) ThenBlock: {
                Optimize_CFGCloseInto(CFGState.cur, merge_id)
            }
        } ElseBlock: {
            Optimize_CFGSetSucc1(before, merge_id)
        }

        CFGState.cur = then_id
        Optimize_CFGWalkBlock(then_block)
        IfCondition NotEqual(CFGState.cur, -1) ThenBlock: {
            Optimize_CFGCloseInto(CFGState.cur, merge_id)
        }

        CFGState.cur = merge_id
        ReturnValue(0)
    }
}

// The condition is tagged on the HEADER, not the predecessor: a
// back-edge re-enters the loop straight into the header on every
// iteration without passing back through "before", so attributing the
// condition's uses to "before" would make them invisible to anything
// live only across later iterations (confirmed by a minimal repro: a
// parameter read only in the condition showed as dead inside a nested
// inner loop, when the real compiled condition re-reads it every pass).
Function.Optimize_CFGWalkWhile {
    Input: node: Address
    Body: {
        body = AST_GetChild(node, 1)

        before = CFGState.cur

        header_id = Optimize_CFGNewBlock()
        Optimize_CFGSetLoopHeader(header_id)
        Optimize_CFGSetSucc0(before, header_id)

        CFGState.pos = Add(CFGState.pos, 1)
        Optimize_CFGTouch(header_id)
        Optimize_TagSetPos(AST_GetChild(node, 0), header_id, CFGState.pos)

        body_id = Optimize_CFGNewBlock()
        exit_id = Optimize_CFGNewBlock()
        Optimize_CFGSetSucc0(header_id, body_id)
        Optimize_CFGSetSucc1(header_id, exit_id)

        Optimize_CFGPushLoop(header_id, exit_id)

        CFGState.cur = body_id
        Optimize_CFGWalkBlock(body)
        IfCondition NotEqual(CFGState.cur, -1) ThenBlock: {
            Optimize_CFGCloseInto(CFGState.cur, header_id)
        }

        Optimize_CFGPopLoop()

        CFGState.cur = exit_id
        ReturnValue(0)
    }
}

// Lowered the same shape CompileStmt_SwitchFast already emits: a
// chain of check-blocks (succ1 = matching case body, succ0 = next
// check), every case body closes into a shared merge block (no
// fall-through between cases, matching the real codegen's per-case
// Emit_Jmp(end_label)).
// Same loop shape as WhileLoop (CompileStmt_ForEvery pushes/pops the
// same Compile.loop_stack for Break/Continue), so it gets a header/
// body/exit with a back-edge the same way. Critical for anything that
// checks "is this function a single straight-line block" (Milestone
// 3b's first allocator-wiring eligibility test) - without this, a
// ForEvery-only function would wrongly look like it has no loop at
// all, since the catch-all statement dispatch below creates no new
// blocks.
Function.Optimize_CFGWalkForEvery {
    Input: node: Address
    Body: {
        body = AST_GetChild(node, 1)

        before = CFGState.cur
        CFGState.pos = Add(CFGState.pos, 1)
        Optimize_CFGTouch(before)

        header_id = Optimize_CFGNewBlock()
        Optimize_CFGSetLoopHeader(header_id)
        Optimize_CFGSetSucc0(before, header_id)

        body_id = Optimize_CFGNewBlock()
        exit_id = Optimize_CFGNewBlock()
        Optimize_CFGSetSucc0(header_id, body_id)
        Optimize_CFGSetSucc1(header_id, exit_id)

        Optimize_CFGPushLoop(header_id, exit_id)

        CFGState.cur = body_id
        Optimize_CFGWalkBlock(body)
        IfCondition NotEqual(CFGState.cur, -1) ThenBlock: {
            Optimize_CFGCloseInto(CFGState.cur, header_id)
        }

        Optimize_CFGPopLoop()

        CFGState.cur = exit_id
        ReturnValue(0)
    }
}

Function.Optimize_CFGWalkSwitch {
    Input: node: Address
    Body: {
        child_count = AST_GetChildCount(node)

        before = CFGState.cur
        CFGState.pos = Add(CFGState.pos, 1)
        Optimize_CFGTouch(before)
        Optimize_TagSetPos(AST_GetChild(node, 0), before, CFGState.pos)

        merge_id = Optimize_CFGNewBlock()

        default_node = 0
        i = 1
        WhileLoop LessThan(i, child_count) {
            cc = AST_GetChild(node, i)
            IfCondition EqualTo(AST_GetType(cc), AST.DEFAULT) ThenBlock: {
                default_node = cc
            }
            i = Add(i, 1)
        }

        check_id = before
        i = 1
        WhileLoop LessThan(i, child_count) {
            cc = AST_GetChild(node, i)
            IfCondition EqualTo(AST_GetType(cc), AST.CASE) ThenBlock: {
                body_id = Optimize_CFGNewBlock()
                next_check = Optimize_CFGNewBlock()
                Optimize_CFGSetSucc1(check_id, body_id)
                Optimize_CFGSetSucc0(check_id, next_check)

                CFGState.cur = body_id
                Optimize_CFGWalkBlock(AST_GetChild(cc, 1))
                IfCondition NotEqual(CFGState.cur, -1) ThenBlock: {
                    Optimize_CFGCloseInto(CFGState.cur, merge_id)
                }
                check_id = next_check
            }
            i = Add(i, 1)
        }

        IfCondition NotEqual(default_node, 0) ThenBlock: {
            CFGState.cur = check_id
            Optimize_CFGWalkBlock(AST_GetChild(default_node, 0))
            IfCondition NotEqual(CFGState.cur, -1) ThenBlock: {
                Optimize_CFGCloseInto(CFGState.cur, merge_id)
            }
        } ElseBlock: {
            Optimize_CFGCloseInto(check_id, merge_id)
        }

        CFGState.cur = merge_id
        ReturnValue(0)
    }
}

// No real exception handling exists today (CompileStmt_Try's own
// comment: "Basic implementation - no actual exception handling, just
// structured flow") - nothing currently raises into the catch block,
// so the CFG mirrors what actually executes: try body, then finally.
Function.Optimize_CFGWalkTry {
    Input: node: Address
    Body: {
        try_body = AST_GetChild(node, 0)
        child_count = AST_GetChildCount(node)
        finally_body = 0
        IfCondition GreaterEqual(child_count, 3) ThenBlock: {
            finally_body = AST_GetChild(node, 2)
        }
        Optimize_CFGWalkBlock(try_body)
        IfCondition NotEqual(finally_body, 0) ThenBlock: {
            IfCondition NotEqual(CFGState.cur, -1) ThenBlock: {
                Optimize_CFGWalkBlock(finally_body)
            }
        }
        ReturnValue(0)
    }
}

Function.Optimize_CFGWalkStmt {
    Input: node: Address
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CFGState.cur, -1) ThenBlock: { ReturnValue(0) }
        nt = AST_GetType(node)

        IfCondition EqualTo(nt, AST.IF) ThenBlock: { Optimize_CFGWalkIf(node) ReturnValue(0) }
        IfCondition EqualTo(nt, AST.FORK) ThenBlock: { Optimize_CFGWalkIf(node) ReturnValue(0) }
        IfCondition EqualTo(nt, AST.WHILE) ThenBlock: { Optimize_CFGWalkWhile(node) ReturnValue(0) }
        IfCondition EqualTo(nt, AST.FOR_EVERY) ThenBlock: { Optimize_CFGWalkForEvery(node) ReturnValue(0) }
        IfCondition EqualTo(nt, AST.SWITCH) ThenBlock: { Optimize_CFGWalkSwitch(node) ReturnValue(0) }
        IfCondition EqualTo(nt, AST.EXIT_LOOP) ThenBlock: { Optimize_CFGWalkBreak(node) ReturnValue(0) }
        IfCondition EqualTo(nt, AST.CONTINUE_LOOP) ThenBlock: { Optimize_CFGWalkContinue(node) ReturnValue(0) }
        IfCondition EqualTo(nt, AST.RETURN) ThenBlock: { Optimize_CFGWalkReturn(node) ReturnValue(0) }
        IfCondition EqualTo(nt, AST.TRY) ThenBlock: { Optimize_CFGWalkTry(node) ReturnValue(0) }
        IfCondition EqualTo(nt, AST.BLOCK) ThenBlock: { Optimize_CFGWalkBlock(node) ReturnValue(0) }

        // Plain statement (Assignment, bare call, ...): one program
        // point in the current block, no new edges.
        CFGState.pos = Add(CFGState.pos, 1)
        Optimize_CFGTouch(CFGState.cur)
        Optimize_TagSetPos(node, CFGState.cur, CFGState.pos)
        ReturnValue(0)
    }
}

Function.Optimize_CFGWalkBlock {
    Input: node: Address
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        count = AST_GetChildCount(node)
        i = 0
        WhileLoop LessThan(i, count) {
            Optimize_CFGWalkStmt(AST_GetChild(node, i))
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

// Build the block graph for one function/subroutine body. Block ids
// only need to be unique within this function (unlike the AST pool,
// which is process-lifetime), so BlockPool resets here rather than
// bumping forever. Returns the entry block id.
Function.Optimize_CFGFunction {
    Input: body: Address
    Output: Integer
    Body: {
        BlockPool.head = 0
        CFGState.loop_stack = Array.Create(64)
        CFGState.loop_depth = 0
        CFGState.pos = 0

        entry = Optimize_CFGNewBlock()
        CFGState.entry = entry
        exitb = Optimize_CFGNewBlock()
        CFGState.exit_block = exitb

        CFGState.cur = entry
        Optimize_CFGWalkBlock(body)
        IfCondition NotEqual(CFGState.cur, -1) ThenBlock: {
            Optimize_CFGCloseInto(CFGState.cur, exitb)
        }

        ReturnValue(entry)
    }
}

// Manual-verification helper for Milestone 1 - dumps every block's
// shape. Not called by any production path; invoked from a throwaway
// driver program while reviewing the CFG builder against the test
// battery (loops, nested If, Break/Continue, Switch, early Return).
Function.Optimize_CFGDump {
    Body: {
        PrintMessage("[CFG] entry=")
        PrintNumber(CFGState.entry)
        PrintMessage(" exit=")
        PrintNumber(CFGState.exit_block)
        PrintMessage(" blocks=")
        PrintNumber(BlockPool.head)
        PrintMessage("\n")
        i = 0
        WhileLoop LessThan(i, BlockPool.head) {
            PrintMessage("  B")
            PrintNumber(i)
            IfCondition EqualTo(Optimize_CFGIsLoopHeader(i), 1) ThenBlock: {
                PrintMessage(" [loop-header]")
            }
            PrintMessage(" pos=[")
            PrintNumber(Optimize_CFGPosStart(i))
            PrintMessage("..")
            PrintNumber(Optimize_CFGPosEnd(i))
            PrintMessage("] succ0=")
            PrintNumber(Optimize_CFGSucc0(i))
            PrintMessage(" succ1=")
            PrintNumber(Optimize_CFGSucc1(i))
            PrintMessage("\n")
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}
