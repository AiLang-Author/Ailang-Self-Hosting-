// Library.COptFold.ailang
// Join constant fold, float constants, and constant temps.
// Loaded by the optimizer shell. No imports of its own.

// =============================================================================
// JOIN CONSTANT FOLD
// One value for a name: every straight-line write agrees, or every arm of a
// Branch or If leaves a constant. Pure arithmetic that reads those values is
// copied into the arms and folded. A second write, a loop write, or any
// non-pure call poisons the name. Integer math stays integer. Float_FromInt
// and the float ops use the compiler's own operators, so the bits match a
// runtime evaluation on this machine.
// =============================================================================

Function.Optimize_FoldFree {
    Input: arr: Address
    Body: {
        IfCondition NotEqual(arr, 0) ThenBlock: {
            Array.Destroy(arr)
        }
        ReturnValue(0)
    }
}

Function.Optimize_FoldFree6 {
    Input: a: Address
    Input: b: Address
    Input: c: Address
    Input: d: Address
    Input: e: Address
    Input: f: Address
    Body: {
        Optimize_FoldFree(a)
        Optimize_FoldFree(b)
        Optimize_FoldFree(c)
        Optimize_FoldFree(d)
        Optimize_FoldFree(e)
        Optimize_FoldFree(f)
        ReturnValue(0)
    }
}

Function.Optimize_FoldDot {
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }
        i = 0
        WhileLoop LessThan(i, 256) {
            c = GetByte(name, i)
            IfCondition EqualTo(c, 0) ThenBlock: { ReturnValue(0) }
            IfCondition EqualTo(c, 46) ThenBlock: { ReturnValue(1) }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

Function.Optimize_FoldOp {
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(StringCompare(name, "Add"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "Subtract"), 0) ThenBlock: { ReturnValue(2) }
        IfCondition EqualTo(StringCompare(name, "Multiply"), 0) ThenBlock: { ReturnValue(3) }
        IfCondition EqualTo(StringCompare(name, "Divide"), 0) ThenBlock: { ReturnValue(4) }
        IfCondition EqualTo(StringCompare(name, "Float_Add"), 0) ThenBlock: { ReturnValue(5) }
        IfCondition EqualTo(StringCompare(name, "Float_Sub"), 0) ThenBlock: { ReturnValue(6) }
        IfCondition EqualTo(StringCompare(name, "Float_Mul"), 0) ThenBlock: { ReturnValue(7) }
        IfCondition EqualTo(StringCompare(name, "Float_Div"), 0) ThenBlock: { ReturnValue(8) }
        IfCondition EqualTo(StringCompare(name, "Float_FromInt"), 0) ThenBlock: { ReturnValue(9) }
        ReturnValue(0)
    }
}

Function.Optimize_FoldIsFn {
    Input: t: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(t, AST.FUNCTION) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(t, AST.SUBROUTINE) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(t, AST.INLINE_FUNCTION) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

Function.Optimize_FoldIsLoop {
    Input: t: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(t, AST.WHILE) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(t, AST.UNTIL) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(t, AST.FOR_EVERY) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(t, AST.EVERY_INTERVAL) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(t, AST.LOOP_MAIN) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(t, AST.LOOP_ACTOR) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(t, AST.LOOP_START) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(t, AST.LOOP_SHADOW) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

Function.Optimize_FoldIsCtrl {
    Input: t: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(Optimize_FoldIsLoop(t), 1) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(t, AST.IF) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(t, AST.FORK) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(t, AST.SWITCH) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(t, AST.BRANCH) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(t, AST.TRY) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(t, AST.WITH_CONTEXT) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(t, AST.DEFER) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

Function.Optimize_FoldApply {
    Input: op: Integer
    Input: v0: Integer
    Input: v1: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(op, 1) ThenBlock: {
            FoldHold.val = Add(v0, v1)
            ReturnValue(1)
        }
        IfCondition EqualTo(op, 2) ThenBlock: {
            FoldHold.val = Subtract(v0, v1)
            ReturnValue(1)
        }
        IfCondition EqualTo(op, 3) ThenBlock: {
            FoldHold.val = Multiply(v0, v1)
            ReturnValue(1)
        }
        IfCondition EqualTo(op, 4) ThenBlock: {
            IfCondition EqualTo(v1, 0) ThenBlock: { ReturnValue(0) }
            FoldHold.val = Divide(v0, v1)
            ReturnValue(1)
        }
        IfCondition EqualTo(op, 5) ThenBlock: {
            FoldHold.val = Float_Add(v0, v1)
            ReturnValue(1)
        }
        IfCondition EqualTo(op, 6) ThenBlock: {
            FoldHold.val = Float_Sub(v0, v1)
            ReturnValue(1)
        }
        IfCondition EqualTo(op, 7) ThenBlock: {
            FoldHold.val = Float_Mul(v0, v1)
            ReturnValue(1)
        }
        IfCondition EqualTo(op, 8) ThenBlock: {
            FoldHold.val = Float_Div(v0, v1)
            ReturnValue(1)
        }
        IfCondition EqualTo(op, 9) ThenBlock: {
            FoldHold.val = Float_FromInt(v0)
            ReturnValue(1)
        }
        ReturnValue(0)
    }
}

Function.Optimize_FoldLookup {
    Input: names: Address
    Input: kinds: Address
    Input: vals: Address
    Input: name: Address
    Input: use_pool: Integer
    Body: {
        IfCondition EqualTo(name, 0) ThenBlock: {
            FoldHold.kind = 4
            FoldHold.val = 0
            ReturnValue(0)
        }
        IfCondition EqualTo(FoldHold.stop, 1) ThenBlock: {
            FoldHold.kind = 4
            FoldHold.val = 0
            ReturnValue(0)
        }
        hops = 0
        cur = name
        WhileLoop LessThan(hops, 4) {
            found = -1
            IfCondition NotEqual(names, 0) ThenBlock: {
                n = Array.Size(names)
                i = 0
                WhileLoop LessThan(i, n) {
                    IfCondition EqualTo(Optimize_NameEq(Array.Get(names, i), cur), 1) ThenBlock: {
                        found = i
                        ExitLoop
                    }
                    i = Add(i, 1)
                }
            }
            IfCondition GreaterEqual(found, 0) ThenBlock: {
                k = Array.Get(kinds, found)
                v = Array.Get(vals, found)
                FoldHold.kind = k
                FoldHold.val = v
                ReturnValue(0)
            }
            IfCondition LessThan(found, 0) ThenBlock: {
                ExitLoop
            }
        }
        IfCondition EqualTo(use_pool, 1) ThenBlock: {
            IfCondition NotEqual(OptState.pool_slot, 0) ThenBlock: {
                slot = SHash.Lookup(OptState.pool_slot, cur)
                IfCondition NotEqual(slot, Collections.XNULL) ThenBlock: {
                    FoldHold.kind = Array.Get(OptState.pool_kinds, slot)
                    FoldHold.val = Array.Get(OptState.pool_vals, slot)
                    ReturnValue(0)
                }
            }
        }
        FoldHold.kind = 4
        FoldHold.val = 0
        ReturnValue(0)
    }
}

Function.Optimize_FoldValue {
    Input: node: Address
    Input: names: Address
    Input: kinds: Address
    Input: vals: Address
    Input: use_pool: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: {
            FoldHold.kind = 0
            FoldHold.val = 0
            ReturnValue(0)
        }
        t = AST_GetType(node)
        IfCondition EqualTo(t, AST.NUMBER) ThenBlock: {
            FoldHold.val = StringToNumber(AST_GetData1(node))
            IfCondition EqualTo(AST_GetData2(node), 2) ThenBlock: {
                FoldHold.kind = 2
                ReturnValue(0)
            }
            FoldHold.kind = 1
            ReturnValue(0)
        }
        IfCondition EqualTo(t, AST.IDENTIFIER) ThenBlock: {
            Optimize_FoldLookup(names, kinds, vals, AST_GetData1(node), use_pool)
            hops = 0
            last = AST_GetData1(node)
            WhileLoop EqualTo(FoldHold.kind, 3) {
                IfCondition GreaterEqual(hops, 4) ThenBlock: { ExitLoop }
                last = FoldHold.val
                Optimize_FoldLookup(names, kinds, vals, last, use_pool)
                hops = Add(hops, 1)
            }
            IfCondition GreaterThan(hops, 0) ThenBlock: {
                IfCondition NotEqual(FoldHold.kind, 1) ThenBlock: {
                    IfCondition NotEqual(FoldHold.kind, 2) ThenBlock: {
                        FoldHold.kind = 3
                        FoldHold.val = last
                    }
                }
            }
            ReturnValue(0)
        }
        IfCondition NotEqual(t, AST.CALL) ThenBlock: {
            FoldHold.kind = 0
            FoldHold.val = 0
            ReturnValue(0)
        }
        op = Optimize_FoldOp(AST_GetData1(node))
        IfCondition EqualTo(op, 0) ThenBlock: {
            FoldHold.kind = 0
            FoldHold.val = 0
            ReturnValue(0)
        }
        count = AST_GetChildCount(node)
        IfCondition EqualTo(op, 9) ThenBlock: {
            IfCondition NotEqual(count, 1) ThenBlock: {
                FoldHold.kind = 0
                FoldHold.val = 0
                ReturnValue(0)
            }
            Optimize_FoldValue(AST_GetChild(node, 0), names, kinds, vals, use_pool)
            ck = FoldHold.kind
            cv = FoldHold.val
            IfCondition EqualTo(ck, 1) ThenBlock: {
                IfCondition EqualTo(Optimize_FoldApply(9, cv, 0), 1) ThenBlock: {
                    FoldHold.kind = 2
                    ReturnValue(0)
                }
            }
            IfCondition EqualTo(ck, 2) ThenBlock: {
                IfCondition EqualTo(Optimize_FoldApply(9, cv, 0), 1) ThenBlock: {
                    FoldHold.kind = 2
                    ReturnValue(0)
                }
            }
            IfCondition EqualTo(ck, 4) ThenBlock: {
                FoldHold.kind = 4
                FoldHold.val = 0
                ReturnValue(0)
            }
            FoldHold.kind = 0
            FoldHold.val = 0
            ReturnValue(0)
        }
        IfCondition NotEqual(count, 2) ThenBlock: {
            FoldHold.kind = 0
            FoldHold.val = 0
            ReturnValue(0)
        }
        Optimize_FoldValue(AST_GetChild(node, 0), names, kinds, vals, use_pool)
        k0 = FoldHold.kind
        v0 = FoldHold.val
        Optimize_FoldValue(AST_GetChild(node, 1), names, kinds, vals, use_pool)
        k1 = FoldHold.kind
        v1 = FoldHold.val
        num0 = 0
        num1 = 0
        IfCondition EqualTo(k0, 1) ThenBlock: { num0 = 1 }
        IfCondition EqualTo(k0, 2) ThenBlock: { num0 = 1 }
        IfCondition EqualTo(k1, 1) ThenBlock: { num1 = 1 }
        IfCondition EqualTo(k1, 2) ThenBlock: { num1 = 1 }
        IfCondition EqualTo(num0, 1) ThenBlock: {
            IfCondition EqualTo(num1, 1) ThenBlock: {
                IfCondition EqualTo(Optimize_FoldApply(op, v0, v1), 0) ThenBlock: {
                    FoldHold.kind = 0
                    FoldHold.val = 0
                    ReturnValue(0)
                }
                IfCondition LessEqual(op, 4) ThenBlock: {
                    FoldHold.kind = 1
                    ReturnValue(0)
                }
                FoldHold.kind = 2
                ReturnValue(0)
            }
        }
        IfCondition EqualTo(k0, 0) ThenBlock: {
            FoldHold.kind = 0
            FoldHold.val = 0
            ReturnValue(0)
        }
        IfCondition EqualTo(k1, 0) ThenBlock: {
            FoldHold.kind = 0
            FoldHold.val = 0
            ReturnValue(0)
        }
        FoldHold.kind = 4
        FoldHold.val = 0
        ReturnValue(0)
    }
}

Function.Optimize_FoldPut {
    Input: names: Address
    Input: kinds: Address
    Input: vals: Address
    Input: name: Address
    Input: kind: Integer
    Input: val: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(names, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(FoldHold.stop, 1) ThenBlock: { ReturnValue(0) }
        found = -1
        n = Array.Size(names)
        i = 0
        WhileLoop LessThan(i, n) {
            IfCondition EqualTo(Optimize_NameEq(Array.Get(names, i), name), 1) ThenBlock: {
                found = i
                ExitLoop
            }
            i = Add(i, 1)
        }
        IfCondition EqualTo(kind, 3) ThenBlock: {
            IfCondition GreaterEqual(found, 0) ThenBlock: {
                IfCondition EqualTo(Array.Get(kinds, found), 0) ThenBlock: { ReturnValue(0) }
                Array.Set(kinds, found, 3)
                Array.Set(vals, found, val)
                ReturnValue(1)
            }
            IfCondition GreaterEqual(n, 512) ThenBlock: {
                FoldHold.stop = 1
                ReturnValue(0)
            }
            Array.Push(names, name)
            Array.Push(kinds, 3)
            Array.Push(vals, val)
            ReturnValue(1)
        }
        IfCondition GreaterEqual(found, 0) ThenBlock: {
            oldk = Array.Get(kinds, found)
            oldv = Array.Get(vals, found)
            IfCondition EqualTo(oldk, 0) ThenBlock: { ReturnValue(0) }
            IfCondition EqualTo(kind, 0) ThenBlock: {
                Array.Set(kinds, found, 0)
                ReturnValue(0)
            }
            IfCondition EqualTo(kind, 4) ThenBlock: {
                Array.Set(kinds, found, 0)
                ReturnValue(0)
            }
            IfCondition EqualTo(oldk, kind) ThenBlock: {
                IfCondition EqualTo(oldv, val) ThenBlock: { ReturnValue(1) }
            }
            Array.Set(kinds, found, 0)
            ReturnValue(0)
        }
        IfCondition GreaterEqual(n, 512) ThenBlock: {
            FoldHold.stop = 1
            ReturnValue(0)
        }
        Array.Push(names, name)
        Array.Push(kinds, kind)
        Array.Push(vals, val)
        ReturnValue(1)
    }
}

Function.Optimize_FoldForce {
    Input: names: Address
    Input: kinds: Address
    Input: vals: Address
    Input: name: Address
    Input: kind: Integer
    Input: val: Integer
    Body: {
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(names, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(FoldHold.stop, 1) ThenBlock: { ReturnValue(0) }
        found = -1
        n = Array.Size(names)
        i = 0
        WhileLoop LessThan(i, n) {
            IfCondition EqualTo(Optimize_NameEq(Array.Get(names, i), name), 1) ThenBlock: {
                found = i
                ExitLoop
            }
            i = Add(i, 1)
        }
        IfCondition GreaterEqual(found, 0) ThenBlock: {
            Array.Set(kinds, found, kind)
            Array.Set(vals, found, val)
            ReturnValue(0)
        }
        IfCondition GreaterEqual(n, 512) ThenBlock: {
            FoldHold.stop = 1
            ReturnValue(0)
        }
        Array.Push(names, name)
        Array.Push(kinds, kind)
        Array.Push(vals, val)
        ReturnValue(0)
    }
}

Function.Optimize_FoldPoolSee {
    Input: name: Address
    Input: kind: Integer
    Input: val: Integer
    Body: {
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(OptState.pool_slot, 0) ThenBlock: { ReturnValue(0) }
        slot = SHash.Lookup(OptState.pool_slot, name)
        gen = FoldHold.gen
        IfCondition EqualTo(FoldHold.stop, 1) ThenBlock: {
            IfCondition NotEqual(slot, Collections.XNULL) ThenBlock: {
                Array.Set(OptState.pool_kinds, slot, 0)
                Array.Set(OptState.pool_gen, slot, gen)
            }
            ReturnValue(0)
        }
        IfCondition EqualTo(slot, Collections.XNULL) ThenBlock: {
            slot = Array.Size(OptState.pool_names)
            IfCondition GreaterEqual(slot, 8192) ThenBlock: {
                FoldHold.stop = 1
                ReturnValue(0)
            }
            SHash.Insert(OptState.pool_slot, name, slot)
            Array.Push(OptState.pool_names, name)
            Array.Push(OptState.pool_kinds, kind)
            Array.Push(OptState.pool_vals, val)
            Array.Push(OptState.pool_gen, gen)
            IfCondition EqualTo(kind, 1) ThenBlock: {
                FoldHold.added = Add(FoldHold.added, 1)
            }
            IfCondition EqualTo(kind, 2) ThenBlock: {
                FoldHold.added = Add(FoldHold.added, 1)
            }
            ReturnValue(0)
        }
        oldk = Array.Get(OptState.pool_kinds, slot)
        oldv = Array.Get(OptState.pool_vals, slot)
        oldg = Array.Get(OptState.pool_gen, slot)
        IfCondition EqualTo(oldk, 0) ThenBlock: {
            Array.Set(OptState.pool_gen, slot, gen)
            ReturnValue(0)
        }
        IfCondition EqualTo(oldg, gen) ThenBlock: {
            same = 0
            IfCondition EqualTo(kind, oldk) ThenBlock: {
                IfCondition EqualTo(val, oldv) ThenBlock: {
                    IfCondition EqualTo(kind, 1) ThenBlock: { same = 1 }
                    IfCondition EqualTo(kind, 2) ThenBlock: { same = 1 }
                }
            }
            IfCondition EqualTo(same, 0) ThenBlock: {
                Array.Set(OptState.pool_kinds, slot, 0)
                Array.Set(OptState.pool_gen, slot, gen)
            }
            ReturnValue(0)
        }
        IfCondition EqualTo(kind, 0) ThenBlock: {
            Array.Set(OptState.pool_kinds, slot, 0)
            Array.Set(OptState.pool_gen, slot, gen)
            ReturnValue(0)
        }
        IfCondition EqualTo(kind, 4) ThenBlock: {
            Array.Set(OptState.pool_gen, slot, gen)
            ReturnValue(0)
        }
        IfCondition EqualTo(oldk, 4) ThenBlock: {
            Array.Set(OptState.pool_kinds, slot, kind)
            Array.Set(OptState.pool_vals, slot, val)
            Array.Set(OptState.pool_gen, slot, gen)
            FoldHold.added = Add(FoldHold.added, 1)
            ReturnValue(0)
        }
        IfCondition EqualTo(kind, oldk) ThenBlock: {
            IfCondition EqualTo(val, oldv) ThenBlock: {
                Array.Set(OptState.pool_gen, slot, gen)
                ReturnValue(0)
            }
        }
        Array.Set(OptState.pool_kinds, slot, 0)
        Array.Set(OptState.pool_gen, slot, gen)
        ReturnValue(0)
    }
}

Function.Optimize_FoldScanAssign {
    Input: node: Address
    Input: guarded: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetData2(node), 0) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(AST_GetChildCount(node), 1) ThenBlock: { ReturnValue(0) }
        name = AST_GetData1(node)
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }
        dotted = Optimize_FoldDot(name)
        IfCondition EqualTo(guarded, 1) ThenBlock: {
            IfCondition EqualTo(dotted, 1) ThenBlock: {
                Optimize_FoldPoolSee(name, 0, 0)
            }
            IfCondition EqualTo(dotted, 0) ThenBlock: {
                Optimize_FoldPut(OptState.scan_names, OptState.scan_kinds, OptState.scan_vals, name, 0, 0)
            }
            ReturnValue(0)
        }
        Optimize_FoldValue(AST_GetChild(node, 0), OptState.scan_names, OptState.scan_kinds, OptState.scan_vals, 1)
        IfCondition EqualTo(dotted, 1) ThenBlock: {
            Optimize_FoldPoolSee(name, FoldHold.kind, FoldHold.val)
        }
        IfCondition EqualTo(dotted, 0) ThenBlock: {
            Optimize_FoldPut(OptState.scan_names, OptState.scan_kinds, OptState.scan_vals, name, FoldHold.kind, FoldHold.val)
        }
        ReturnValue(0)
    }
}

Function.Optimize_FoldScan {
    Input: node: Address
    Input: guarded: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        t = AST_GetType(node)
        IfCondition EqualTo(Optimize_FoldIsFn(t), 1) ThenBlock: {
            FoldHold.stop = 0
            Array.Clear(OptState.scan_names)
            Array.Clear(OptState.scan_kinds)
            Array.Clear(OptState.scan_vals)
            count = AST_GetChildCount(node)
            i = 0
            WhileLoop LessThan(i, count) {
                Optimize_FoldScan(AST_GetChild(node, i), 0)
                i = Add(i, 1)
            }
            FoldHold.stop = 0
            Array.Clear(OptState.scan_names)
            Array.Clear(OptState.scan_kinds)
            Array.Clear(OptState.scan_vals)
            ReturnValue(0)
        }
        IfCondition EqualTo(Optimize_FoldIsCtrl(t), 1) ThenBlock: {
            count = AST_GetChildCount(node)
            i = 0
            WhileLoop LessThan(i, count) {
                Optimize_FoldScan(AST_GetChild(node, i), 1)
                i = Add(i, 1)
            }
            ReturnValue(0)
        }
        IfCondition EqualTo(t, AST.ASSIGNMENT) ThenBlock: {
            Optimize_FoldScanAssign(node, guarded)
        }
        count = AST_GetChildCount(node)
        i = 0
        WhileLoop LessThan(i, count) {
            Optimize_FoldScan(AST_GetChild(node, i), guarded)
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

Function.Optimize_FoldInit {
    Body: {
        IfCondition EqualTo(Compile.ast, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(OptState.pool_slot, 0) ThenBlock: {
            IfCondition EqualTo(OptState.fold_ast, Compile.ast) ThenBlock: {
                ReturnValue(0)
            }
            SHash.Destroy(OptState.pool_slot)
            Optimize_FoldFree(OptState.pool_names)
            Optimize_FoldFree(OptState.pool_kinds)
            Optimize_FoldFree(OptState.pool_vals)
            Optimize_FoldFree(OptState.pool_gen)
            Optimize_FoldFree(OptState.scan_names)
            Optimize_FoldFree(OptState.scan_kinds)
            Optimize_FoldFree(OptState.scan_vals)
            OptState.pool_slot = 0
        }
        OptState.pool_slot = SHash.Create(4096)
        OptState.pool_names = Array.Create(64)
        OptState.pool_kinds = Array.Create(64)
        OptState.pool_vals = Array.Create(64)
        OptState.pool_gen = Array.Create(64)
        OptState.scan_names = Array.Create(64)
        OptState.scan_kinds = Array.Create(64)
        OptState.scan_vals = Array.Create(64)
        FoldHold.one = Float_FromInt(1)
        FoldHold.gen = 0
        FoldHold.stop = 0
        pass = 0
        WhileLoop LessThan(pass, 8) {
            FoldHold.added = 0
            FoldHold.gen = Add(FoldHold.gen, 1)
            FoldHold.stop = 0
            Array.Clear(OptState.scan_names)
            Array.Clear(OptState.scan_kinds)
            Array.Clear(OptState.scan_vals)
            Optimize_FoldScan(Compile.ast, 0)
            IfCondition EqualTo(FoldHold.added, 0) ThenBlock: {
                IfCondition GreaterThan(pass, 0) ThenBlock: {
                    ExitLoop
                }
            }
            pass = Add(pass, 1)
        }
        FoldHold.stop = 0
        OptState.fold_ast = Compile.ast
        ReturnValue(0)
    }
}

Function.Optimize_FoldNum {
    Input: val: Integer
    Input: kind: Integer
    Output: Address
    Body: {
        node = AST_MakeNumber(NumberToString(val))
        AST_SetData2(node, kind)
        ReturnValue(node)
    }
}

Function.Optimize_FoldPure {
    Input: node: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        t = AST_GetType(node)
        IfCondition EqualTo(t, AST.NUMBER) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(t, AST.IDENTIFIER) ThenBlock: { ReturnValue(1) }
        IfCondition NotEqual(t, AST.CALL) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_FoldOp(AST_GetData1(node)), 0) ThenBlock: { ReturnValue(0) }
        count = AST_GetChildCount(node)
        i = 0
        WhileLoop LessThan(i, count) {
            IfCondition EqualTo(Optimize_FoldPure(AST_GetChild(node, i)), 0) ThenBlock: {
                ReturnValue(0)
            }
            i = Add(i, 1)
        }
        ReturnValue(1)
    }
}

Function.Optimize_FoldHit {
    Input: node: Address
    Input: names: Address
    Input: start: Integer
    Input: count: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        IfCondition LessEqual(count, 0) ThenBlock: { ReturnValue(0) }
        t = AST_GetType(node)
        check = 0
        IfCondition EqualTo(t, AST.IDENTIFIER) ThenBlock: { check = 1 }
        IfCondition EqualTo(t, AST.ASSIGNMENT) ThenBlock: { check = 1 }
        IfCondition EqualTo(t, AST.INDEX_ASSIGN) ThenBlock: { check = 1 }
        IfCondition EqualTo(check, 1) ThenBlock: {
            nm = AST_GetData1(node)
            i = 0
            WhileLoop LessThan(i, count) {
                IfCondition EqualTo(Optimize_NameEq(nm, Array.Get(names, Add(start, i))), 1) ThenBlock: {
                    ReturnValue(1)
                }
                i = Add(i, 1)
            }
        }
        n = AST_GetChildCount(node)
        i = 0
        WhileLoop LessThan(i, n) {
            IfCondition EqualTo(Optimize_FoldHit(AST_GetChild(node, i), names, start, count), 1) ThenBlock: {
                ReturnValue(1)
            }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

Function.Optimize_FoldSimple {
    Input: node: Address
    Output: Address
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(node), AST.ASSIGNMENT) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetData2(node), 0) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(AST_GetChildCount(node), 1) ThenBlock: { ReturnValue(0) }
        name = AST_GetData1(node)
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_FoldDot(name), 1) ThenBlock: { ReturnValue(0) }
        ReturnValue(name)
    }
}

Function.Optimize_FoldDup {
    Input: dn: Address
    Input: dk: Address
    Input: dv: Address
    Input: sn: Address
    Input: sk: Address
    Input: sv: Address
    Body: {
        IfCondition EqualTo(sn, 0) ThenBlock: { ReturnValue(0) }
        n = Array.Size(sn)
        i = 0
        WhileLoop LessThan(i, n) {
            Array.Push(dn, Array.Get(sn, i))
            Array.Push(dk, Array.Get(sk, i))
            Array.Push(dv, Array.Get(sv, i))
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

Function.Optimize_FoldPoison {
    Input: node: Address
    Input: names: Address
    Input: kinds: Address
    Input: vals: Address
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        t = AST_GetType(node)
        IfCondition EqualTo(Optimize_FoldIsFn(t), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(t, AST.ASSIGNMENT) ThenBlock: {
            IfCondition EqualTo(AST_GetData2(node), 0) ThenBlock: {
                Optimize_FoldPut(names, kinds, vals, AST_GetData1(node), 0, 0)
            }
        }
        IfCondition EqualTo(t, AST.INDEX_ASSIGN) ThenBlock: {
            Optimize_FoldPut(names, kinds, vals, AST_GetData1(node), 0, 0)
        }
        count = AST_GetChildCount(node)
        i = 0
        WhileLoop LessThan(i, count) {
            Optimize_FoldPoison(AST_GetChild(node, i), names, kinds, vals)
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

Function.Optimize_FoldSubst {
    Input: node: Address
    Input: names: Address
    Input: kinds: Address
    Input: vals: Address
    Output: Address
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        t = AST_GetType(node)
        IfCondition EqualTo(t, AST.IDENTIFIER) ThenBlock: {
            Optimize_FoldValue(node, names, kinds, vals, 0)
            ck = FoldHold.kind
            cv = FoldHold.val
            IfCondition EqualTo(ck, 1) ThenBlock: {
                ReturnValue(Optimize_FoldNum(cv, 1))
            }
            IfCondition EqualTo(ck, 2) ThenBlock: {
                ReturnValue(Optimize_FoldNum(cv, 2))
            }
            IfCondition EqualTo(ck, 3) ThenBlock: {
                AST_SetData1(node, cv)
                Optimize_FoldValue(node, names, kinds, vals, 0)
                IfCondition EqualTo(FoldHold.kind, 1) ThenBlock: {
                    ReturnValue(Optimize_FoldNum(FoldHold.val, 1))
                }
                IfCondition EqualTo(FoldHold.kind, 2) ThenBlock: {
                    ReturnValue(Optimize_FoldNum(FoldHold.val, 2))
                }
            }
            ReturnValue(node)
        }
        count = AST_GetChildCount(node)
        i = 0
        WhileLoop LessThan(i, count) {
            ch = AST_GetChild(node, i)
            nh = Optimize_FoldSubst(ch, names, kinds, vals)
            IfCondition NotEqual(nh, ch) ThenBlock: {
                AST_SetChild(node, i, nh)
            }
            i = Add(i, 1)
        }
        IfCondition NotEqual(t, AST.CALL) ThenBlock: { ReturnValue(node) }
        op = Optimize_FoldOp(AST_GetData1(node))
        IfCondition EqualTo(op, 0) ThenBlock: { ReturnValue(node) }
        Optimize_FoldValue(node, names, kinds, vals, 0)
        IfCondition EqualTo(FoldHold.kind, 1) ThenBlock: {
            ReturnValue(Optimize_FoldNum(FoldHold.val, 1))
        }
        IfCondition EqualTo(FoldHold.kind, 2) ThenBlock: {
            ReturnValue(Optimize_FoldNum(FoldHold.val, 2))
        }
        IfCondition EqualTo(op, 7) ThenBlock: {
            IfCondition EqualTo(count, 2) ThenBlock: {
                left = AST_GetChild(node, 0)
                right = AST_GetChild(node, 1)
                IfCondition EqualTo(AST_GetType(left), AST.NUMBER) ThenBlock: {
                    IfCondition EqualTo(StringToNumber(AST_GetData1(left)), FoldHold.one) ThenBlock: {
                        ReturnValue(right)
                    }
                }
                IfCondition EqualTo(AST_GetType(right), AST.NUMBER) ThenBlock: {
                    IfCondition EqualTo(StringToNumber(AST_GetData1(right)), FoldHold.one) ThenBlock: {
                        ReturnValue(left)
                    }
                }
            }
        }
        IfCondition EqualTo(op, 8) ThenBlock: {
            IfCondition EqualTo(count, 2) ThenBlock: {
                right = AST_GetChild(node, 1)
                IfCondition EqualTo(AST_GetType(right), AST.NUMBER) ThenBlock: {
                    IfCondition EqualTo(StringToNumber(AST_GetData1(right)), FoldHold.one) ThenBlock: {
                        ReturnValue(AST_GetChild(node, 0))
                    }
                }
            }
        }
        ReturnValue(node)
    }
}

Function.Optimize_FoldCollect {
    Input: block: Address
    Input: dest: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(block, 0) ThenBlock: { ReturnValue(0) }
        count = AST_GetChildCount(block)
        i = 0
        WhileLoop LessThan(i, count) {
            st = AST_GetChild(block, i)
            t = AST_GetType(st)
            IfCondition EqualTo(t, AST.BLOCK) ThenBlock: {
                IfCondition EqualTo(Optimize_FoldCollect(st, dest), 1) ThenBlock: { ReturnValue(1) }
            }
            IfCondition EqualTo(t, AST.BODY) ThenBlock: {
                IfCondition EqualTo(Optimize_FoldCollect(st, dest), 1) ThenBlock: { ReturnValue(1) }
            }
            IfCondition NotEqual(t, AST.BLOCK) ThenBlock: {
                IfCondition NotEqual(t, AST.BODY) ThenBlock: {
                    nm = Optimize_FoldSimple(st)
                    IfCondition NotEqual(nm, 0) ThenBlock: {
                        have = 0
                        j = 0
                        n = Array.Size(dest)
                        WhileLoop LessThan(j, n) {
                            IfCondition EqualTo(Optimize_NameEq(Array.Get(dest, j), nm), 1) ThenBlock: {
                                have = 1
                                ExitLoop
                            }
                            j = Add(j, 1)
                        }
                        IfCondition EqualTo(have, 0) ThenBlock: {
                            IfCondition GreaterEqual(n, 16) ThenBlock: { ReturnValue(1) }
                            Array.Push(dest, nm)
                        }
                    }
                }
            }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

Function.Optimize_FoldArm {
    Input: block: Address
    Input: names: Address
    Input: kinds: Address
    Input: vals: Address
    Body: {
        IfCondition EqualTo(block, 0) ThenBlock: { ReturnValue(0) }
        count = AST_GetChildCount(block)
        i = 0
        WhileLoop LessThan(i, count) {
            st = AST_GetChild(block, i)
            t = AST_GetType(st)
            IfCondition EqualTo(t, AST.BLOCK) ThenBlock: {
                Optimize_FoldArm(st, names, kinds, vals)
            }
            IfCondition EqualTo(t, AST.BODY) ThenBlock: {
                Optimize_FoldArm(st, names, kinds, vals)
            }
            IfCondition NotEqual(t, AST.BLOCK) ThenBlock: {
                IfCondition NotEqual(t, AST.BODY) ThenBlock: {
                    nm = Optimize_FoldSimple(st)
                    IfCondition NotEqual(nm, 0) ThenBlock: {
                        Optimize_FoldValue(AST_GetChild(st, 0), names, kinds, vals, 0)
                        IfCondition EqualTo(FoldHold.kind, 1) ThenBlock: {
                            Optimize_FoldForce(names, kinds, vals, nm, 1, FoldHold.val)
                        }
                        IfCondition EqualTo(FoldHold.kind, 2) ThenBlock: {
                            Optimize_FoldForce(names, kinds, vals, nm, 2, FoldHold.val)
                        }
                        IfCondition NotEqual(FoldHold.kind, 1) ThenBlock: {
                            IfCondition NotEqual(FoldHold.kind, 2) ThenBlock: {
                                Optimize_FoldForce(names, kinds, vals, nm, 0, 0)
                            }
                        }
                    }
                    IfCondition EqualTo(nm, 0) ThenBlock: {
                        Optimize_FoldPoison(st, names, kinds, vals)
                    }
                }
            }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

Function.Optimize_FoldIsBlock {
    Input: node: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        t = AST_GetType(node)
        IfCondition EqualTo(t, AST.BLOCK) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(t, AST.BODY) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

Function.Optimize_FoldGather {
    Input: stmt: Address
    Input: arms: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(stmt, 0) ThenBlock: { ReturnValue(0) }
        t = AST_GetType(stmt)
        count = AST_GetChildCount(stmt)
        IfCondition EqualTo(t, AST.IF) ThenBlock: {
            IfCondition LessThan(count, 3) ThenBlock: { ReturnValue(0) }
            b0 = AST_GetChild(stmt, 1)
            b1 = AST_GetChild(stmt, 2)
            IfCondition EqualTo(Optimize_FoldIsBlock(b0), 0) ThenBlock: { ReturnValue(0) }
            IfCondition EqualTo(Optimize_FoldIsBlock(b1), 0) ThenBlock: { ReturnValue(0) }
            Array.Push(arms, b0)
            Array.Push(arms, b1)
            ReturnValue(1)
        }
        IfCondition EqualTo(t, AST.FORK) ThenBlock: {
            IfCondition LessThan(count, 3) ThenBlock: { ReturnValue(0) }
            b0 = AST_GetChild(stmt, 1)
            b1 = AST_GetChild(stmt, 2)
            IfCondition EqualTo(Optimize_FoldIsBlock(b0), 0) ThenBlock: { ReturnValue(0) }
            IfCondition EqualTo(Optimize_FoldIsBlock(b1), 0) ThenBlock: { ReturnValue(0) }
            Array.Push(arms, b0)
            Array.Push(arms, b1)
            ReturnValue(1)
        }
        branch = 0
        IfCondition EqualTo(t, AST.SWITCH) ThenBlock: { branch = 1 }
        IfCondition EqualTo(t, AST.BRANCH) ThenBlock: { branch = 1 }
        IfCondition EqualTo(branch, 0) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(count, 2) ThenBlock: { ReturnValue(0) }
        has_def = 0
        i = 1
        WhileLoop LessThan(i, count) {
            ch = AST_GetChild(stmt, i)
            ct = AST_GetType(ch)
            IfCondition EqualTo(ct, AST.CASE) ThenBlock: {
                IfCondition LessThan(AST_GetChildCount(ch), 2) ThenBlock: { ReturnValue(0) }
                body = AST_GetChild(ch, 1)
                IfCondition EqualTo(Optimize_FoldIsBlock(body), 0) ThenBlock: { ReturnValue(0) }
                Array.Push(arms, body)
            }
            IfCondition EqualTo(ct, AST.DEFAULT) ThenBlock: {
                has_def = Add(has_def, 1)
                IfCondition LessThan(AST_GetChildCount(ch), 1) ThenBlock: { ReturnValue(0) }
                body = AST_GetChild(ch, 0)
                IfCondition EqualTo(Optimize_FoldIsBlock(body), 0) ThenBlock: { ReturnValue(0) }
                Array.Push(arms, body)
            }
            IfCondition NotEqual(ct, AST.CASE) ThenBlock: {
                IfCondition NotEqual(ct, AST.DEFAULT) ThenBlock: { ReturnValue(0) }
            }
            IfCondition GreaterThan(Array.Size(arms), 16) ThenBlock: { ReturnValue(0) }
            i = Add(i, 1)
        }
        IfCondition NotEqual(has_def, 1) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(Array.Size(arms), 1) ThenBlock: { ReturnValue(0) }
        ReturnValue(1)
    }
}

// A NUMBER operand of Float_Add/Sub/Mul is the same bits the runtime uses.
// Non-leaf functions park up to 8 distinct patterns in the frame once, at
// entry. Class 8 is that slot. Leaves keep the red zone and miss the opt.

Function.Optimize_FltConstEnsure {
    Body: {
        IfCondition EqualTo(OptState.flt_bits, 0) ThenBlock: {
            OptState.flt_bits = Allocate(64)
            OptState.flt_disp = Allocate(64)
        }
        IfCondition EqualTo(OptState.flt_save, 0) ThenBlock: {
            OptState.flt_save = Allocate(640)
        }
        ReturnValue(0)
    }
}

Function.Optimize_FltConstPush {
    Body: {
        Optimize_FltConstEnsure()
        d = OptState.flt_depth
        IfCondition GreaterEqual(d, 4) ThenBlock: {
            OptState.flt_depth = Add(d, 1)
            OptState.flt_skip = Add(OptState.flt_skip, 1)
            ReturnValue(0)
        }
        base = Add(OptState.flt_save, Multiply(d, 160))
        StoreValue(base, OptState.flt_n)
        StoreValue(Add(base, 8), OptState.flt_ready)
        i = 0
        WhileLoop LessThan(i, 8) {
            StoreValue(Add(base, Add(16, Multiply(i, 8))), Dereference(Add(OptState.flt_bits, Multiply(i, 8))))
            StoreValue(Add(base, Add(80, Multiply(i, 8))), Dereference(Add(OptState.flt_disp, Multiply(i, 8))))
            i = Add(i, 1)
        }
        OptState.flt_depth = Add(d, 1)
        OptState.flt_n = 0
        OptState.flt_ready = 0
        ReturnValue(0)
    }
}

Function.Optimize_FltConstPop {
    Body: {
        d = OptState.flt_depth
        IfCondition LessEqual(d, 0) ThenBlock: { ReturnValue(0) }
        OptState.flt_depth = Subtract(d, 1)
        IfCondition GreaterThan(OptState.flt_skip, 0) ThenBlock: {
            OptState.flt_skip = Subtract(OptState.flt_skip, 1)
            ReturnValue(0)
        }
        d = OptState.flt_depth
        base = Add(OptState.flt_save, Multiply(d, 160))
        OptState.flt_n = Dereference(base)
        OptState.flt_ready = Dereference(Add(base, 8))
        i = 0
        WhileLoop LessThan(i, 8) {
            StoreValue(Add(OptState.flt_bits, Multiply(i, 8)), Dereference(Add(base, Add(16, Multiply(i, 8)))))
            StoreValue(Add(OptState.flt_disp, Multiply(i, 8)), Dereference(Add(base, Add(80, Multiply(i, 8)))))
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

Function.Optimize_FltConstNote {
    Input: bits: Integer
    Body: {
        IfCondition GreaterEqual(OptState.flt_n, 8) ThenBlock: { ReturnValue(0) }
        i = 0
        WhileLoop LessThan(i, OptState.flt_n) {
            have = Dereference(Add(OptState.flt_bits, Multiply(i, 8)))
            IfCondition EqualTo(have, bits) ThenBlock: { ReturnValue(0) }
            i = Add(i, 1)
        }
        at = Multiply(OptState.flt_n, 8)
        StoreValue(Add(OptState.flt_bits, at), bits)
        StoreValue(Add(OptState.flt_disp, at), 0)
        OptState.flt_n = Add(OptState.flt_n, 1)
        ReturnValue(0)
    }
}

Function.Optimize_FltConstDisp {
    Input: bits: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(OptState.flt_ready, 0) ThenBlock: { ReturnValue(0) }
        i = 0
        WhileLoop LessThan(i, OptState.flt_n) {
            have = Dereference(Add(OptState.flt_bits, Multiply(i, 8)))
            IfCondition EqualTo(have, bits) ThenBlock: {
                ReturnValue(Dereference(Add(OptState.flt_disp, Multiply(i, 8))))
            }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

Function.Optimize_FltConstWalk {
    Input: node: Address
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        t = AST_GetType(node)
        IfCondition EqualTo(Optimize_FoldIsFn(t), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(t, AST.CALL) ThenBlock: {
            opk = Optimize_FltOpKind(AST_GetData1(node))
            legal = 0
            IfCondition EqualTo(opk, 1) ThenBlock: { legal = 1 }
            IfCondition EqualTo(opk, 2) ThenBlock: { legal = 1 }
            IfCondition EqualTo(opk, 3) ThenBlock: { legal = 1 }
            IfCondition EqualTo(legal, 1) ThenBlock: {
                IfCondition EqualTo(AST_GetChildCount(node), 2) ThenBlock: {
                    s = 0
                    WhileLoop LessThan(s, 2) {
                        ch = AST_GetChild(node, s)
                        IfCondition NotEqual(ch, 0) ThenBlock: {
                            IfCondition EqualTo(AST_GetType(ch), AST.NUMBER) ThenBlock: {
                                Optimize_FltConstNote(StringToNumber(AST_GetData1(ch)))
                            }
                        }
                        s = Add(s, 1)
                    }
                }
            }
        }
        count = AST_GetChildCount(node)
        i = 0
        WhileLoop LessThan(i, count) {
            Optimize_FltConstWalk(AST_GetChild(node, i))
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

Function.Optimize_FltConstPlan {
    Input: body: Address
    Input: is_leaf: Integer
    Output: Integer
    Body: {
        IfCondition GreaterThan(OptState.flt_skip, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(is_leaf, 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(body, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_FoldIsFn(AST_GetType(body)), 1) ThenBlock: {
            c = AST_GetChildCount(body)
            i = 0
            WhileLoop LessThan(i, c) {
                Optimize_FltConstWalk(AST_GetChild(body, i))
                i = Add(i, 1)
            }
            ReturnValue(OptState.flt_n)
        }
        Optimize_FltConstWalk(body)
        ReturnValue(OptState.flt_n)
    }
}

Function.Optimize_FltConstEmit {
    Body: {
        IfCondition GreaterThan(OptState.flt_skip, 0) ThenBlock: { ReturnValue(0) }
        i = 0
        WhileLoop LessThan(i, OptState.flt_n) {
            Compile.stack_offset = Add(Compile.stack_offset, 8)
            disp = Subtract(0, Compile.stack_offset)
            bits = Dereference(Add(OptState.flt_bits, Multiply(i, 8)))
            StoreValue(Add(OptState.flt_disp, Multiply(i, 8)), disp)
            Emit_MovRaxImm64(bits)
            Emit_MovRbpOffsetRax(disp)
            i = Add(i, 1)
        }
        OptState.flt_ready = 1
        ReturnValue(0)
    }
}

Function.Optimize_IdentCount {
    Input: node: Address
    Input: name: Address
    Output: Integer
    Body: {
        LoopHome.mention_count = 0
        Optimize_CountWalk(node, name)
        ReturnValue(LoopHome.mention_count)
    }
}

Function.Optimize_ConstTempQual {
    Input: value: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(value, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(value), AST.CALL) ThenBlock: { ReturnValue(0) }
        opk = Optimize_FltOpKind(AST_GetData1(value))
        legal = 0
        IfCondition EqualTo(opk, 1) ThenBlock: { legal = 1 }
        IfCondition EqualTo(opk, 2) ThenBlock: { legal = 1 }
        IfCondition EqualTo(opk, 3) ThenBlock: { legal = 1 }
        IfCondition EqualTo(legal, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetChildCount(value), 2) ThenBlock: { ReturnValue(0) }
        saw = 0
        s = 0
        WhileLoop LessThan(s, 2) {
            ch = AST_GetChild(value, s)
            IfCondition EqualTo(ch, 0) ThenBlock: { ReturnValue(0) }
            ct = AST_GetType(ch)
            ok = 0
            IfCondition EqualTo(ct, AST.IDENTIFIER) ThenBlock: { ok = 1 }
            IfCondition EqualTo(ct, AST.NUMBER) ThenBlock: {
                disp = Optimize_FltConstDisp(StringToNumber(AST_GetData1(ch)))
                IfCondition LessThan(disp, 0) ThenBlock: {
                    ok = 1
                    saw = 1
                }
            }
            IfCondition EqualTo(ok, 0) ThenBlock: { ReturnValue(0) }
            s = Add(s, 1)
        }
        ReturnValue(saw)
    }
}

Function.Optimize_ConstTempCtrl {
    Input: t: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(t, AST.IF) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(t, AST.FORK) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(t, AST.SWITCH) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(t, AST.BRANCH) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(t, AST.TRY) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(Optimize_FoldIsLoop(t), 1) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

Function.Optimize_ConstTempInside {
    Input: node: Address
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(1) }
        t = AST_GetType(node)
        IfCondition EqualTo(Optimize_FoldIsFn(t), 1) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(Optimize_FoldIsBlock(node), 1) ThenBlock: {
            ReturnValue(Optimize_ConstTempBlock(node, name))
        }
        IfCondition EqualTo(t, AST.ASSIGNMENT) ThenBlock: {
            IfCondition EqualTo(AST_GetData2(node), 0) ThenBlock: {
                IfCondition EqualTo(Optimize_NameEq(AST_GetData1(node), name), 1) ThenBlock: { ReturnValue(0) }
            }
        }
        IfCondition EqualTo(t, AST.IDENTIFIER) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(AST_GetData1(node), name), 1) ThenBlock: { ReturnValue(0) }
        }
        count = AST_GetChildCount(node)
        i = 0
        WhileLoop LessThan(i, count) {
            IfCondition EqualTo(Optimize_ConstTempInside(AST_GetChild(node, i), name), 0) ThenBlock: { ReturnValue(0) }
            i = Add(i, 1)
        }
        ReturnValue(1)
    }
}

Function.Optimize_ConstTempBlock {
    Input: block: Address
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(block, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_FoldIsBlock(block), 0) ThenBlock: { ReturnValue(0) }
        pending = 0
        count = AST_GetChildCount(block)
        i = 0
        WhileLoop LessThan(i, count) {
            st = AST_GetChild(block, i)
            IfCondition NotEqual(st, 0) ThenBlock: {
                t = AST_GetType(st)
                handled = 0
                IfCondition EqualTo(t, AST.INDEX_ASSIGN) ThenBlock: {
                    IfCondition EqualTo(Optimize_NameEq(AST_GetData1(st), name), 1) ThenBlock: { ReturnValue(0) }
                }
                IfCondition EqualTo(t, AST.ASSIGNMENT) ThenBlock: {
                    IfCondition EqualTo(Optimize_NameEq(AST_GetData1(st), name), 1) ThenBlock: {
                        IfCondition NotEqual(AST_GetData2(st), 0) ThenBlock: { ReturnValue(0) }
                        rhs = AST_GetChild(st, 0)
                        IfCondition EqualTo(Optimize_ConstTempQual(rhs), 0) ThenBlock: { ReturnValue(0) }
                        IfCondition EqualTo(Optimize_TreeHasIdent(rhs, name), 1) ThenBlock: { ReturnValue(0) }
                        IfCondition EqualTo(pending, 1) ThenBlock: { ReturnValue(0) }
                        pending = 1
                        OptState.flt_saw = Add(OptState.flt_saw, 1)
                        handled = 1
                    }
                }
                IfCondition EqualTo(handled, 0) ThenBlock: {
                    IfCondition EqualTo(Optimize_FoldIsBlock(st), 1) ThenBlock: {
                        IfCondition EqualTo(pending, 1) ThenBlock: { ReturnValue(0) }
                        IfCondition EqualTo(Optimize_ConstTempBlock(st, name), 0) ThenBlock: { ReturnValue(0) }
                        handled = 1
                    }
                }
                IfCondition EqualTo(handled, 0) ThenBlock: {
                    IfCondition EqualTo(Optimize_ConstTempCtrl(t), 1) ThenBlock: {
                        IfCondition EqualTo(pending, 1) ThenBlock: {
                            IfCondition EqualTo(Optimize_TreeHasIdent(st, name), 1) ThenBlock: { ReturnValue(0) }
                        }
                        IfCondition EqualTo(pending, 0) ThenBlock: {
                            IfCondition EqualTo(Optimize_ConstTempInside(st, name), 0) ThenBlock: { ReturnValue(0) }
                        }
                        handled = 1
                    }
                }
                IfCondition EqualTo(handled, 0) ThenBlock: {
                    IfCondition EqualTo(Optimize_TreeHasIdent(st, name), 1) ThenBlock: {
                        IfCondition EqualTo(pending, 0) ThenBlock: { ReturnValue(0) }
                        IfCondition NotEqual(Optimize_IdentCount(st, name), 1) ThenBlock: { ReturnValue(0) }
                        pending = 0
                    }
                }
            }
            i = Add(i, 1)
        }
        IfCondition EqualTo(pending, 1) ThenBlock: { ReturnValue(0) }
        ReturnValue(1)
    }
}

Function.Optimize_ConstTempSkip {
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(OptState.flt_ready, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(LoopHome.body, 0) ThenBlock: { ReturnValue(0) }
        OptState.flt_saw = 0
        IfCondition EqualTo(Optimize_ConstTempBlock(LoopHome.body, name), 0) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(OptState.flt_saw, 1) ThenBlock: { ReturnValue(0) }
        ReturnValue(1)
    }
}

// Product of a slotted constant into xmm0, held for the one use in this block.
// Subtraction stays left then right. A held right operand is parked in xmm1
// before the left load, because the load uses xmm0.

Function.Optimize_TryFltConst {
    Input: target: Address
    Input: value: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(LoopHome.active, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_IsIntHome(target), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_IsFltHome(target), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_IsAccHome(target), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(value, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(value), AST.CALL) ThenBlock: { ReturnValue(0) }
        opk = Optimize_FltOpKind(AST_GetData1(value))
        legal = 0
        IfCondition EqualTo(opk, 1) ThenBlock: { legal = 1 }
        IfCondition EqualTo(opk, 2) ThenBlock: { legal = 1 }
        IfCondition EqualTo(opk, 3) ThenBlock: { legal = 1 }
        IfCondition EqualTo(legal, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetChildCount(value), 2) ThenBlock: { ReturnValue(0) }
        Optimize_OpClass(AST_GetChild(value, 0))
        c0 = LoopHome.hit_class
        d0 = LoopHome.hit_disp
        x0 = LoopHome.hit_xmm
        Optimize_OpClass(AST_GetChild(value, 1))
        c1 = LoopHome.hit_class
        d1 = LoopHome.hit_disp
        x1 = LoopHome.hit_xmm
        IfCondition EqualTo(Optimize_FltSrcOk(c0), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_FltSrcOk(c1), 0) ThenBlock: { ReturnValue(0) }
        saw8 = 0
        IfCondition EqualTo(c0, 8) ThenBlock: { saw8 = 1 }
        IfCondition EqualTo(c1, 8) ThenBlock: { saw8 = 1 }
        IfCondition EqualTo(saw8, 0) ThenBlock: { ReturnValue(0) }
        hold_ok = Optimize_HoldHere(target, value)
        IfCondition EqualTo(hold_ok, 0) ThenBlock: { hold_ok = Optimize_HoldArm(target, value) }
        IfCondition EqualTo(hold_ok, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(LoopHome.hold_on, 1) ThenBlock: {
            uses = 0
            IfCondition EqualTo(c0, 3) ThenBlock: { uses = 1 }
            IfCondition EqualTo(c1, 3) ThenBlock: { uses = 1 }
            IfCondition EqualTo(uses, 0) ThenBlock: { Optimize_FlushHold() }
        }
        IfCondition EqualTo(c1, 3) ThenBlock: {
            Emit_HomeMove(37, 0)
            Optimize_FltHomeOp(0, c0, d0, x0, 16)
            IfCondition EqualTo(opk, 1) ThenBlock: { Emit_HomeMove(38, 0) }
            IfCondition EqualTo(opk, 2) ThenBlock: { Emit_HomeMove(39, 0) }
            IfCondition EqualTo(opk, 3) ThenBlock: { Emit_HomeMove(40, 0) }
        }
        IfCondition NotEqual(c1, 3) ThenBlock: {
            opc = 88
            IfCondition EqualTo(opk, 2) ThenBlock: { opc = 92 }
            IfCondition EqualTo(opk, 3) ThenBlock: { opc = 89 }
            Optimize_FltHomeOp(0, c0, d0, x0, 16)
            Optimize_FltHomeOp(0, c1, d1, x1, opc)
        }
        LoopHome.hold_on = 1
        LoopHome.hold_name = target
        ReturnValue(1)
    }
}

// A later Branch on the same identifier can use constants an earlier Branch
// on that identifier already chose. Keys match by number or by Default.
// A non-number case does not match. The parent env stays poisoned.

Function.Optimize_FoldFree2 {
    Input: a: Address
    Input: b: Address
    Body: {
        Optimize_FoldFree(a)
        Optimize_FoldFree(b)
        ReturnValue(0)
    }
}

Function.Optimize_FoldSinkEnd {
    Input: key_k: Address
    Input: key_v: Address
    Input: between: Address
    Input: saved: Address
    Body: {
        OptState.fold_between = saved
        Optimize_FoldFree(between)
        Optimize_FoldFree2(key_k, key_v)
        ReturnValue(0)
    }
}

Function.Optimize_FoldScrut {
    Input: stmt: Address
    Output: Address
    Body: {
        IfCondition EqualTo(stmt, 0) ThenBlock: { ReturnValue(0) }
        t = AST_GetType(stmt)
        branch = 0
        IfCondition EqualTo(t, AST.SWITCH) ThenBlock: { branch = 1 }
        IfCondition EqualTo(t, AST.BRANCH) ThenBlock: { branch = 1 }
        IfCondition EqualTo(branch, 0) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(AST_GetChildCount(stmt), 1) ThenBlock: { ReturnValue(0) }
        scr = AST_GetChild(stmt, 0)
        IfCondition EqualTo(scr, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(scr), AST.IDENTIFIER) ThenBlock: { ReturnValue(0) }
        ReturnValue(AST_GetData1(scr))
    }
}

Function.Optimize_FoldPrior {
    Input: block: Address
    Input: index: Integer
    Input: stmt: Address
    Input: between: Address
    Output: Address
    Body: {
        want = Optimize_FoldScrut(stmt)
        IfCondition EqualTo(want, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(block, 0) ThenBlock: { ReturnValue(0) }
        p = Subtract(index, 1)
        WhileLoop GreaterEqual(p, 0) {
            st = AST_GetChild(block, p)
            nm = Optimize_FoldSimple(st)
            IfCondition NotEqual(nm, 0) ThenBlock: {
                IfCondition EqualTo(Optimize_NameEq(nm, want), 1) ThenBlock: { ReturnValue(0) }
                IfCondition EqualTo(between, 0) ThenBlock: { ReturnValue(0) }
                IfCondition EqualTo(Optimize_FoldListed(between, nm), 0) ThenBlock: {
                    IfCondition GreaterEqual(Array.Size(between), 32) ThenBlock: { ReturnValue(0) }
                    Array.Push(between, nm)
                }
            }
            IfCondition EqualTo(nm, 0) ThenBlock: {
                got = Optimize_FoldScrut(st)
                IfCondition EqualTo(got, 0) ThenBlock: { ReturnValue(0) }
                IfCondition EqualTo(Optimize_NameEq(got, want), 0) ThenBlock: { ReturnValue(0) }
                ReturnValue(st)
            }
            p = Subtract(p, 1)
        }
        ReturnValue(0)
    }
}

Function.Optimize_FoldKeys {
    Input: stmt: Address
    Input: key_k: Address
    Input: key_v: Address
    Body: {
        IfCondition EqualTo(stmt, 0) ThenBlock: { ReturnValue(0) }
        count = AST_GetChildCount(stmt)
        i = 1
        WhileLoop LessThan(i, count) {
            ch = AST_GetChild(stmt, i)
            IfCondition NotEqual(ch, 0) ThenBlock: {
                ct = AST_GetType(ch)
                IfCondition EqualTo(ct, AST.CASE) ThenBlock: {
                    kk = 0
                    kv = 0
                    IfCondition GreaterEqual(AST_GetChildCount(ch), 1) ThenBlock: {
                        key = AST_GetChild(ch, 0)
                        IfCondition NotEqual(key, 0) ThenBlock: {
                            IfCondition EqualTo(AST_GetType(key), AST.NUMBER) ThenBlock: {
                                kk = 1
                                kv = StringToNumber(AST_GetData1(key))
                            }
                        }
                    }
                    Array.Push(key_k, kk)
                    Array.Push(key_v, kv)
                }
                IfCondition EqualTo(ct, AST.DEFAULT) ThenBlock: {
                    Array.Push(key_k, 2)
                    Array.Push(key_v, 0)
                }
            }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

Function.Optimize_FoldImportNames {
    Input: prior: Address
    Input: cands: Address
    Body: {
        IfCondition EqualTo(prior, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(cands, 0) ThenBlock: { ReturnValue(0) }
        arms = Array.Create(4)
        IfCondition EqualTo(Optimize_FoldGather(prior, arms), 0) ThenBlock: {
            Optimize_FoldFree(arms)
            ReturnValue(0)
        }
        a = 0
        ac = Array.Size(arms)
        WhileLoop LessThan(a, ac) {
            Optimize_FoldCollect(Array.Get(arms, a), cands)
            a = Add(a, 1)
        }
        Optimize_FoldFree(arms)
        ReturnValue(0)
    }
}

Function.Optimize_FoldImport {
    Input: prior: Address
    Input: kk: Integer
    Input: kv: Integer
    Input: dn: Address
    Input: dk: Address
    Input: dv: Address
    Body: {
        IfCondition EqualTo(prior, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(kk, 0) ThenBlock: { ReturnValue(0) }
        arms = Array.Create(4)
        kks = Array.Create(4)
        kvs = Array.Create(4)
        IfCondition EqualTo(Optimize_FoldGather(prior, arms), 0) ThenBlock: {
            Optimize_FoldFree(arms)
            Optimize_FoldFree(kks)
            Optimize_FoldFree(kvs)
            ReturnValue(0)
        }
        Optimize_FoldKeys(prior, kks, kvs)
        found = -1
        a = 0
        ac = Array.Size(arms)
        WhileLoop LessThan(a, ac) {
            IfCondition LessThan(a, Array.Size(kks)) ThenBlock: {
                ak = Array.Get(kks, a)
                av = Array.Get(kvs, a)
                match = 0
                IfCondition EqualTo(kk, 2) ThenBlock: {
                    IfCondition EqualTo(ak, 2) ThenBlock: { match = 1 }
                }
                IfCondition EqualTo(kk, 1) ThenBlock: {
                    IfCondition EqualTo(ak, 1) ThenBlock: {
                        IfCondition EqualTo(kv, av) ThenBlock: { match = 1 }
                    }
                }
                IfCondition EqualTo(match, 1) ThenBlock: {
                    found = a
                    a = ac
                }
            }
            a = Add(a, 1)
        }
        IfCondition LessThan(found, 0) ThenBlock: {
            Optimize_FoldFree(arms)
            Optimize_FoldFree(kks)
            Optimize_FoldFree(kvs)
            ReturnValue(0)
        }
        body = Array.Get(arms, found)
        cands = Array.Create(4)
        Optimize_FoldCollect(body, cands)
        tn = Array.Create(8)
        tk = Array.Create(8)
        tv = Array.Create(8)
        Optimize_FoldDup(tn, tk, tv, dn, dk, dv)
        Optimize_FoldArm(body, tn, tk, tv)
        j = 0
        jc = Array.Size(cands)
        WhileLoop LessThan(j, jc) {
            nm = Array.Get(cands, j)
            Optimize_FoldLookup(tn, tk, tv, nm, 0)
            keepk = FoldHold.kind
            keepv = FoldHold.val
            listed = Optimize_FoldListed(OptState.fold_between, nm)
            IfCondition EqualTo(listed, 0) ThenBlock: {
                IfCondition EqualTo(keepk, 1) ThenBlock: {
                    Optimize_FoldForce(dn, dk, dv, nm, keepk, keepv)
                }
                IfCondition EqualTo(keepk, 2) ThenBlock: {
                    Optimize_FoldForce(dn, dk, dv, nm, keepk, keepv)
                }
            }
            j = Add(j, 1)
        }
        Optimize_FoldFree(tn)
        Optimize_FoldFree(tk)
        Optimize_FoldFree(tv)
        Optimize_FoldFree(cands)
        Optimize_FoldFree(arms)
        Optimize_FoldFree(kks)
        Optimize_FoldFree(kvs)
        ReturnValue(0)
    }
}

Function.Optimize_FoldSink {
    Input: block: Address
    Input: index: Integer
    Input: stmt: Address
    Input: names: Address
    Input: kinds: Address
    Input: vals: Address
    Body: {
        arms = Array.Create(8)
        can = Optimize_FoldGather(stmt, arms)
        IfCondition EqualTo(can, 0) ThenBlock: {
            dn = Array.Create(8)
            dk = Array.Create(8)
            dv = Array.Create(8)
            Optimize_FoldDup(dn, dk, dv, names, kinds, vals)
            Optimize_FoldWalkInside(stmt, dn, dk, dv)
            Optimize_FoldFree6(arms, dn, dk, dv, 0, 0)
            ReturnValue(0)
        }
        key_k = Array.Create(8)
        key_v = Array.Create(8)
        between = Array.Create(8)
        saved_between = OptState.fold_between
        prior = 0
        IfCondition NotEqual(Optimize_FoldScrut(stmt), 0) ThenBlock: {
            Optimize_FoldKeys(stmt, key_k, key_v)
            prior = Optimize_FoldPrior(block, index, stmt, between)
        }
        acount = Array.Size(arms)
        a = 0
        WhileLoop LessThan(a, acount) {
            dn = Array.Create(8)
            dk = Array.Create(8)
            dv = Array.Create(8)
            Optimize_FoldDup(dn, dk, dv, names, kinds, vals)
            Optimize_FoldWalkBlock(Array.Get(arms, a), dn, dk, dv)
            Optimize_FoldFree(dn)
            Optimize_FoldFree(dk)
            Optimize_FoldFree(dv)
            a = Add(a, 1)
        }
        IfCondition EqualTo(FoldHold.stop, 1) ThenBlock: {
            Optimize_FoldSinkEnd(key_k, key_v, between, saved_between)
            Optimize_FoldFree(arms)
            ReturnValue(0)
        }
        cands = Array.Create(8)
        overflow = 0
        a = 0
        WhileLoop LessThan(a, acount) {
            IfCondition EqualTo(Optimize_FoldCollect(Array.Get(arms, a), cands), 1) ThenBlock: {
                overflow = 1
            }
            a = Add(a, 1)
        }
        IfCondition EqualTo(overflow, 0) ThenBlock: {
            Optimize_FoldImportNames(prior, cands)
        }
        jcount = Array.Size(cands)
        IfCondition EqualTo(overflow, 1) ThenBlock: { jcount = 0 }
        IfCondition LessThan(jcount, 1) ThenBlock: {
            Optimize_FoldSinkEnd(key_k, key_v, between, saved_between)
            Optimize_FoldFree6(arms, cands, 0, 0, 0, 0)
            ReturnValue(0)
        }
        OptState.fold_between = between
        flat_k = Array.Create(32)
        flat_v = Array.Create(32)
        a = 0
        WhileLoop LessThan(a, acount) {
            dn = Array.Create(8)
            dk = Array.Create(8)
            dv = Array.Create(8)
            Optimize_FoldDup(dn, dk, dv, names, kinds, vals)
            IfCondition NotEqual(prior, 0) ThenBlock: {
                IfCondition EqualTo(Array.Size(key_k), acount) ThenBlock: {
                    Optimize_FoldImport(prior, Array.Get(key_k, a), Array.Get(key_v, a), dn, dk, dv)
                }
            }
            Optimize_FoldArm(Array.Get(arms, a), dn, dk, dv)
            j = 0
            WhileLoop LessThan(j, jcount) {
                Optimize_FoldLookup(dn, dk, dv, Array.Get(cands, j), 0)
                fk = FoldHold.kind
                fv = FoldHold.val
                IfCondition NotEqual(fk, 1) ThenBlock: {
                    IfCondition NotEqual(fk, 2) ThenBlock: { fk = 0 }
                }
                Array.Push(flat_k, fk)
                Array.Push(flat_v, fv)
                j = Add(j, 1)
            }
            Optimize_FoldFree(dn)
            Optimize_FoldFree(dk)
            Optimize_FoldFree(dv)
            a = Add(a, 1)
        }
        keep = Array.Create(8)
        j = 0
        WhileLoop LessThan(j, jcount) {
            ok = 1
            a = 0
            WhileLoop LessThan(a, acount) {
                fk = Array.Get(flat_k, Add(Multiply(a, jcount), j))
                IfCondition NotEqual(fk, 1) ThenBlock: {
                    IfCondition NotEqual(fk, 2) ThenBlock: { ok = 0 }
                }
                a = Add(a, 1)
            }
            IfCondition EqualTo(ok, 1) ThenBlock: {
                Array.Push(keep, j)
            }
            j = Add(j, 1)
        }
        join_n = Array.Size(keep)
        IfCondition LessThan(join_n, 1) ThenBlock: {
            Optimize_FoldSinkEnd(key_k, key_v, between, saved_between)
            Optimize_FoldFree6(arms, cands, flat_k, flat_v, keep, 0)
            ReturnValue(0)
        }
        dep = Array.Create(8)
        j = 0
        WhileLoop LessThan(j, join_n) {
            Array.Push(dep, Array.Get(cands, Array.Get(keep, j)))
            j = Add(j, 1)
        }
        pref = Array.Create(8)
        bcount = AST_GetChildCount(block)
        k = Add(index, 1)
        WhileLoop LessThan(Array.Size(pref), 8) {
            IfCondition GreaterEqual(k, bcount) ThenBlock: { ExitLoop }
            st = AST_GetChild(block, k)
            nm = Optimize_FoldSimple(st)
            take = 0
            IfCondition NotEqual(nm, 0) ThenBlock: {
                rhs = AST_GetChild(st, 0)
                IfCondition EqualTo(Optimize_FoldPure(rhs), 1) ThenBlock: {
                    IfCondition EqualTo(Optimize_FoldHit(rhs, dep, 0, Array.Size(dep)), 1) ThenBlock: {
                        take = 1
                    }
                }
            }
            IfCondition EqualTo(take, 0) ThenBlock: { ExitLoop }
            Array.Push(pref, k)
            Array.Push(dep, nm)
            k = Add(k, 1)
        }
        len = Array.Size(pref)
        done = 0
        WhileLoop EqualTo(done, 0) {
            IfCondition LessEqual(len, 0) ThenBlock: { done = 1 }
            IfCondition GreaterThan(len, 0) ThenBlock: {
                bad = 0
                j = Add(Array.Get(pref, Subtract(len, 1)), 1)
                WhileLoop LessThan(j, bcount) {
                    IfCondition EqualTo(Optimize_FoldHit(AST_GetChild(block, j), dep, join_n, len), 1) ThenBlock: {
                        bad = 1
                    }
                    j = Add(j, 1)
                }
                IfCondition EqualTo(bad, 0) ThenBlock: { done = 1 }
                IfCondition EqualTo(bad, 1) ThenBlock: { len = Subtract(len, 1) }
            }
        }
        IfCondition LessEqual(len, 0) ThenBlock: {
            Optimize_FoldFree(pref)
            Optimize_FoldSinkEnd(key_k, key_v, between, saved_between)
            Optimize_FoldFree6(arms, cands, flat_k, flat_v, keep, dep)
            ReturnValue(0)
        }
        IfCondition EqualTo(FoldHold.stop, 1) ThenBlock: {
            Optimize_FoldFree(pref)
            Optimize_FoldSinkEnd(key_k, key_v, between, saved_between)
            Optimize_FoldFree6(arms, cands, flat_k, flat_v, keep, dep)
            ReturnValue(0)
        }
        IfCondition GreaterThan(Array.Size(names), 480) ThenBlock: {
            Optimize_FoldFree(pref)
            Optimize_FoldSinkEnd(key_k, key_v, between, saved_between)
            Optimize_FoldFree6(arms, cands, flat_k, flat_v, keep, dep)
            ReturnValue(0)
        }
        a = 0
        WhileLoop LessThan(a, acount) {
            dn = Array.Create(16)
            dk = Array.Create(16)
            dv = Array.Create(16)
            Optimize_FoldDup(dn, dk, dv, names, kinds, vals)
            j = 0
            WhileLoop LessThan(j, join_n) {
                srcj = Array.Get(keep, j)
                fk = Array.Get(flat_k, Add(Multiply(a, jcount), srcj))
                fv = Array.Get(flat_v, Add(Multiply(a, jcount), srcj))
                Optimize_FoldForce(dn, dk, dv, Array.Get(cands, srcj), fk, fv)
                j = Add(j, 1)
            }
            m = 0
            WhileLoop LessThan(m, len) {
                st = AST_GetChild(block, Array.Get(pref, m))
                tname = AST_GetData1(st)
                cloned = Optimize_InlineClone(AST_GetChild(st, 0), 0)
                rewritten = Optimize_FoldSubst(cloned, dn, dk, dv)
                Optimize_FoldValue(rewritten, dn, dk, dv, 0)
                ck = FoldHold.kind
                cv = FoldHold.val
                IfCondition EqualTo(ck, 1) ThenBlock: {
                    Optimize_FoldForce(dn, dk, dv, tname, 1, cv)
                }
                IfCondition EqualTo(ck, 2) ThenBlock: {
                    Optimize_FoldForce(dn, dk, dv, tname, 2, cv)
                }
                IfCondition NotEqual(ck, 1) ThenBlock: {
                    IfCondition NotEqual(ck, 2) ThenBlock: {
                        IfCondition EqualTo(rewritten, 0) ThenBlock: {
                            Optimize_FoldForce(dn, dk, dv, tname, 0, 0)
                        }
                        IfCondition NotEqual(rewritten, 0) ThenBlock: {
                            IfCondition EqualTo(AST_GetType(rewritten), AST.IDENTIFIER) ThenBlock: {
                                Optimize_FoldForce(dn, dk, dv, tname, 3, AST_GetData1(rewritten))
                            }
                            IfCondition NotEqual(AST_GetType(rewritten), AST.IDENTIFIER) ThenBlock: {
                                asg = AST_MakeAssignment(tname, rewritten)
                                AST_SetLine(asg, AST_GetLine(st))
                                AST_SetCol(asg, AST_GetCol(st))
                                AST_AddChild(Array.Get(arms, a), asg)
                                Optimize_FoldForce(dn, dk, dv, tname, 0, 0)
                            }
                        }
                    }
                }
                m = Add(m, 1)
            }
            Optimize_FoldFree(dn)
            Optimize_FoldFree(dk)
            Optimize_FoldFree(dv)
            a = Add(a, 1)
        }
        children = AST_GetChildren(block)
        m = Subtract(len, 1)
        WhileLoop GreaterEqual(m, 0) {
            Array.Delete(children, Array.Get(pref, m))
            m = Subtract(m, 1)
        }
        Optimize_FoldFree(pref)
        Optimize_FoldSinkEnd(key_k, key_v, between, saved_between)
            Optimize_FoldFree6(arms, cands, flat_k, flat_v, keep, dep)
        ReturnValue(0)
    }
}

Function.Optimize_FoldWalkInside {
    Input: node: Address
    Input: names: Address
    Input: kinds: Address
    Input: vals: Address
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        t = AST_GetType(node)
        IfCondition EqualTo(Optimize_FoldIsFn(t), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_FoldIsBlock(node), 1) ThenBlock: {
            Optimize_FoldWalkBlock(node, names, kinds, vals)
            ReturnValue(0)
        }
        count = AST_GetChildCount(node)
        i = 0
        WhileLoop LessThan(i, count) {
            Optimize_FoldWalkInside(AST_GetChild(node, i), names, kinds, vals)
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

Function.Optimize_FoldWalkBlock {
    Input: block: Address
    Input: names: Address
    Input: kinds: Address
    Input: vals: Address
    Body: {
        IfCondition EqualTo(block, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_FoldIsBlock(block), 0) ThenBlock: { ReturnValue(0) }
        i = 0
        count = AST_GetChildCount(block)
        WhileLoop LessThan(i, count) {
            stmt = AST_GetChild(block, i)
            st = AST_GetType(stmt)
            IfCondition EqualTo(Optimize_FoldIsBlock(stmt), 1) ThenBlock: {
                Optimize_FoldWalkBlock(stmt, names, kinds, vals)
            }
            IfCondition EqualTo(Optimize_FoldIsLoop(st), 1) ThenBlock: {
                dn = Array.Create(8)
                dk = Array.Create(8)
                dv = Array.Create(8)
                Optimize_FoldDup(dn, dk, dv, names, kinds, vals)
                Optimize_FoldPoison(stmt, dn, dk, dv)
                Optimize_FoldWalkInside(stmt, dn, dk, dv)
                Optimize_FoldFree(dn)
                Optimize_FoldFree(dk)
                Optimize_FoldFree(dv)
                Optimize_FoldPoison(stmt, names, kinds, vals)
            }
            IfCondition EqualTo(Optimize_FoldIsCtrl(st), 1) ThenBlock: {
                IfCondition EqualTo(Optimize_FoldIsLoop(st), 0) ThenBlock: {
                    Optimize_FoldSink(block, i, stmt, names, kinds, vals)
                    Optimize_FoldPoison(stmt, names, kinds, vals)
                }
            }
            IfCondition EqualTo(Optimize_FoldIsCtrl(st), 0) ThenBlock: {
                IfCondition EqualTo(Optimize_FoldIsBlock(stmt), 0) ThenBlock: {
                    nm = Optimize_FoldSimple(stmt)
                    IfCondition NotEqual(nm, 0) ThenBlock: {
                        Optimize_FoldValue(AST_GetChild(stmt, 0), names, kinds, vals, 0)
                        IfCondition EqualTo(FoldHold.kind, 1) ThenBlock: {
                            Optimize_FoldPut(names, kinds, vals, nm, 1, FoldHold.val)
                        }
                        IfCondition EqualTo(FoldHold.kind, 2) ThenBlock: {
                            Optimize_FoldPut(names, kinds, vals, nm, 2, FoldHold.val)
                        }
                        IfCondition NotEqual(FoldHold.kind, 1) ThenBlock: {
                            IfCondition NotEqual(FoldHold.kind, 2) ThenBlock: {
                                Optimize_FoldPut(names, kinds, vals, nm, 0, 0)
                            }
                        }
                    }
                    IfCondition EqualTo(nm, 0) ThenBlock: {
                        Optimize_FoldWalkInside(stmt, names, kinds, vals)
                    }
                }
            }
            count = AST_GetChildCount(block)
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

Function.Optimize_FoldDots {
    Input: node: Address
    Input: dest: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        t = AST_GetType(node)
        IfCondition EqualTo(Optimize_FoldIsFn(t), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(t, AST.ASSIGNMENT) ThenBlock: {
            IfCondition EqualTo(AST_GetData2(node), 0) ThenBlock: {
                nm = AST_GetData1(node)
                IfCondition EqualTo(Optimize_FoldDot(nm), 1) ThenBlock: {
                    have = 0
                    j = 0
                    n = Array.Size(dest)
                    WhileLoop LessThan(j, n) {
                        IfCondition EqualTo(Optimize_NameEq(Array.Get(dest, j), nm), 1) ThenBlock: {
                            have = 1
                            ExitLoop
                        }
                        j = Add(j, 1)
                    }
                    IfCondition EqualTo(have, 0) ThenBlock: {
                        IfCondition GreaterEqual(n, 512) ThenBlock: { ReturnValue(1) }
                        Array.Push(dest, nm)
                    }
                }
            }
        }
        count = AST_GetChildCount(node)
        i = 0
        WhileLoop LessThan(i, count) {
            IfCondition EqualTo(Optimize_FoldDots(AST_GetChild(node, i), dest), 1) ThenBlock: {
                ReturnValue(1)
            }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

Function.Optimize_FoldListed {
    Input: names: Address
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(names, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }
        n = Array.Size(names)
        i = 0
        WhileLoop LessThan(i, n) {
            IfCondition EqualTo(Optimize_NameEq(Array.Get(names, i), name), 1) ThenBlock: {
                ReturnValue(1)
            }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

Function.Optimize_FoldFunction {
    Input: body: Address
    Body: {
        IfCondition EqualTo(body, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(OptState.pool_slot, 0) ThenBlock: { ReturnValue(0) }
        FoldHold.stop = 0
        names = Array.Create(32)
        kinds = Array.Create(32)
        vals = Array.Create(32)
        dots = Array.Create(8)
        skip = Optimize_FoldDots(body, dots)
        IfCondition EqualTo(skip, 0) ThenBlock: {
            n = Array.Size(OptState.pool_kinds)
            i = 0
            WhileLoop LessThan(i, n) {
                pk = Array.Get(OptState.pool_kinds, i)
                keep = 0
                IfCondition EqualTo(pk, 1) ThenBlock: { keep = 1 }
                IfCondition EqualTo(pk, 2) ThenBlock: { keep = 1 }
                IfCondition EqualTo(keep, 1) ThenBlock: {
                    pn = Array.Get(OptState.pool_names, i)
                    IfCondition EqualTo(Optimize_FoldListed(dots, pn), 0) ThenBlock: {
                        IfCondition LessThan(Array.Size(names), 512) ThenBlock: {
                            Array.Push(names, pn)
                            Array.Push(kinds, pk)
                            Array.Push(vals, Array.Get(OptState.pool_vals, i))
                        }
                    }
                }
                i = Add(i, 1)
            }
        }
        Optimize_FoldFree(dots)
        Optimize_FoldWalkBlock(body, names, kinds, vals)
        Optimize_FoldFree(names)
        Optimize_FoldFree(kinds)
        Optimize_FoldFree(vals)
        FoldHold.stop = 0
        ReturnValue(0)
    }
}

// A straight-line temporary with one later read is copied into that read
// and the store is dropped. Nested math then stays in rax or xmm the way a
// handwritten expression already does. The name must not be read outside
// this block, and nothing between the store and the read may change a name
// the expression uses.
Function.Optimize_PlainAssign {
    Input: node: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(node), AST.ASSIGNMENT) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetData2(node), 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(1)
    }
}

Function.Optimize_PureName {
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(StringCompare(name, "Add"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "Subtract"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "Multiply"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "Divide"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "Modulo"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "Negate"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "BitwiseAnd"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "BitwiseOr"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "BitwiseXor"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "BitwiseNot"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "LeftShift"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "RightShift"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "BitAnd"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "BitOr"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "BitXor"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "BitNot"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "ShiftLeft"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "ShiftRight"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "Float_Add"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "Float_Sub"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "Float_Mul"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "Float_Div"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "Float_Neg"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "Float_Abs"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "Float_Sqrt"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "Float_FromInt"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "Float_ToInt"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "Dereference"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "LessThan"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "GreaterThan"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "LessEqual"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "GreaterEqual"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "EqualTo"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "NotEqual"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "And"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "Or"), 0) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

Function.Optimize_PureExpr {
    Input: node: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        nt = AST_GetType(node)
        IfCondition EqualTo(nt, AST.NUMBER) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(nt, AST.IDENTIFIER) ThenBlock: { ReturnValue(1) }
        IfCondition NotEqual(nt, AST.CALL) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_PureName(AST_GetData1(node)), 0) ThenBlock: { ReturnValue(0) }
        count = AST_GetChildCount(node)
        i = 0
        ok = 1
        WhileLoop LessThan(i, count) {
            IfCondition EqualTo(Optimize_PureExpr(AST_GetChild(node, i)), 0) ThenBlock: { ok = 0 }
            i = Add(i, 1)
        }
        ReturnValue(ok)
    }
}

Function.Optimize_CountIdents {
    Input: node: Address
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        n = 0
        IfCondition EqualTo(AST_GetType(node), AST.IDENTIFIER) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(AST_GetData1(node), name), 1) ThenBlock: { n = 1 }
        }
        count = AST_GetChildCount(node)
        i = 0
        WhileLoop LessThan(i, count) {
            n = Add(n, Optimize_CountIdents(AST_GetChild(node, i), name))
            i = Add(i, 1)
        }
        ReturnValue(n)
    }
}

Function.Optimize_Mentions {
    Input: node: Address
    Input: name: Address
    Output: Integer
    Body: {
        LoopHome.mention_count = 0
        Optimize_CountWalk(node, name)
        ReturnValue(LoopHome.mention_count)
    }
}

Function.Optimize_UsesAfter {
    Input: block: Address
    Input: name: Address
    Input: def_at: Integer
    Output: Integer
    Body: {
        uses = 0
        OptState.fold_between = -1
        count = AST_GetChildCount(block)
        k = Add(def_at, 1)
        WhileLoop LessThan(k, count) {
            sk = AST_GetChild(block, k)
            stop = 0
            IfCondition EqualTo(Optimize_PlainAssign(sk), 1) ThenBlock: {
                IfCondition EqualTo(Optimize_NameEq(AST_GetData1(sk), name), 1) ThenBlock: { stop = 1 }
            }
            n = Optimize_CountIdents(sk, name)
            IfCondition GreaterThan(n, 0) ThenBlock: {
                IfCondition EqualTo(Optimize_PlainAssign(sk), 0) ThenBlock: { ReturnValue(-1) }
                IfCondition EqualTo(uses, 0) ThenBlock: { OptState.fold_between = k }
                uses = Add(uses, n)
            }
            IfCondition EqualTo(stop, 1) ThenBlock: { k = count }
            k = Add(k, 1)
        }
        ReturnValue(uses)
    }
}

Function.Optimize_TreeHasDeref {
    Input: node: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(AST_GetType(node), AST.CALL) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(AST_GetData1(node), "Dereference"), 1) ThenBlock: { ReturnValue(1) }
        }
        count = AST_GetChildCount(node)
        i = 0
        WhileLoop LessThan(i, count) {
            IfCondition EqualTo(Optimize_TreeHasDeref(AST_GetChild(node, i)), 1) ThenBlock: { ReturnValue(1) }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

Function.Optimize_FoldClear {
    Input: block: Address
    Input: expr: Address
    Input: def_at: Integer
    Input: use_at: Integer
    Output: Integer
    Body: {
        // A dereference only moves into the next statement. A plain
        // assignment may still hide a call, and a call may write a local
        // the expression reads or the memory a pointer names.
        k = Add(def_at, 1)
        WhileLoop LessThan(k, use_at) {
            sk = AST_GetChild(block, k)
            IfCondition EqualTo(Optimize_TreeHasDeref(expr), 1) ThenBlock: { ReturnValue(0) }
            IfCondition EqualTo(Optimize_PlainAssign(sk), 0) ThenBlock: { ReturnValue(0) }
            IfCondition EqualTo(Optimize_PureExpr(AST_GetChild(sk, 0)), 0) ThenBlock: { ReturnValue(0) }
            IfCondition EqualTo(Optimize_TreeHasIdent(expr, AST_GetData1(sk)), 1) ThenBlock: { ReturnValue(0) }
            k = Add(k, 1)
        }
        ReturnValue(1)
    }
}

Function.Optimize_ReplaceOne {
    Input: node: Address
    Input: name: Address
    Input: expr: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        count = AST_GetChildCount(node)
        i = 0
        WhileLoop LessThan(i, count) {
            ch = AST_GetChild(node, i)
            hit = 0
            IfCondition NotEqual(ch, 0) ThenBlock: {
                IfCondition EqualTo(AST_GetType(ch), AST.IDENTIFIER) ThenBlock: {
                    IfCondition EqualTo(Optimize_NameEq(AST_GetData1(ch), name), 1) ThenBlock: { hit = 1 }
                }
            }
            IfCondition EqualTo(hit, 1) ThenBlock: {
                AST_SetChild(node, i, expr)
                ReturnValue(1)
            }
            IfCondition EqualTo(Optimize_ReplaceOne(ch, name, expr), 1) ThenBlock: { ReturnValue(1) }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

// 1 when `name` is a direct argument of Float_Add or Float_Sub. A folded
// Float_Mul in that spot is what expression FMA matches.
Function.Optimize_FoldMulSite {
    Input: node: Address
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        sum = 0
        IfCondition EqualTo(AST_GetType(node), AST.CALL) ThenBlock: {
            cn = AST_GetData1(node)
            IfCondition EqualTo(StringCompare(cn, "Float_Add"), 0) ThenBlock: { sum = 1 }
            IfCondition EqualTo(StringCompare(cn, "Float_Sub"), 0) ThenBlock: { sum = 1 }
        }
        count = AST_GetChildCount(node)
        i = 0
        WhileLoop LessThan(i, count) {
            ch = AST_GetChild(node, i)
            IfCondition NotEqual(ch, 0) ThenBlock: {
                IfCondition EqualTo(sum, 1) ThenBlock: {
                    IfCondition EqualTo(AST_GetType(ch), AST.IDENTIFIER) ThenBlock: {
                        IfCondition EqualTo(Optimize_NameEq(AST_GetData1(ch), name), 1) ThenBlock: {
                            ReturnValue(1)
                        }
                    }
                }
                IfCondition EqualTo(Optimize_FoldMulSite(ch, name), 1) ThenBlock: { ReturnValue(1) }
            }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

// 1 when both nodes are number literals of the same value.
Function.Optimize_SameNum {
    Input: a: Address
    Input: b: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(a, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(b, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(a), AST.NUMBER) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(b), AST.NUMBER) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(StringToNumber(AST_GetData1(a)), StringToNumber(AST_GetData1(b))) ThenBlock: {
            ReturnValue(1)
        }
        ReturnValue(0)
    }
}

// 1 when this Modulo is paired with a later Divide of the same value by the
// same constant, and nothing in between reads that value. Folding the
// remainder into its next use would hide the pair from the quotient keep.
Function.Optimize_DivModKeep {
    Input: block: Address
    Input: index: Integer
    Input: expr: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(expr, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(expr), AST.CALL) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(StringCompare(AST_GetData1(expr), "Modulo"), 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetChildCount(expr), 2) ThenBlock: { ReturnValue(0) }
        dividend = AST_GetChild(expr, 0)
        IfCondition EqualTo(dividend, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(dividend), AST.IDENTIFIER) ThenBlock: { ReturnValue(0) }
        dname = AST_GetData1(dividend)
        divs = AST_GetChild(expr, 1)
        count = AST_GetChildCount(block)
        k = Add(index, 1)
        WhileLoop LessThan(k, count) {
            sk = AST_GetChild(block, k)
            IfCondition EqualTo(Optimize_PlainAssign(sk), 1) ThenBlock: {
                IfCondition EqualTo(Optimize_NameEq(AST_GetData1(sk), dname), 1) ThenBlock: {
                    dv = AST_GetChild(sk, 0)
                    hit = 0
                    IfCondition NotEqual(dv, 0) ThenBlock: {
                        IfCondition EqualTo(AST_GetType(dv), AST.CALL) ThenBlock: {
                            IfCondition EqualTo(StringCompare(AST_GetData1(dv), "Divide"), 0) ThenBlock: {
                                IfCondition EqualTo(AST_GetChildCount(dv), 2) ThenBlock: {
                                    IfCondition EqualTo(Optimize_IdentEq(AST_GetChild(dv, 0), dname), 1) ThenBlock: {
                                        IfCondition EqualTo(Optimize_SameNum(divs, AST_GetChild(dv, 1)), 1) ThenBlock: {
                                            hit = 1
                                        }
                                    }
                                }
                            }
                        }
                    }
                    IfCondition EqualTo(hit, 0) ThenBlock: { ReturnValue(0) }
                    ReturnValue(1)
                }
            }
            IfCondition GreaterThan(Optimize_CountIdents(sk, dname), 0) ThenBlock: { ReturnValue(0) }
            k = Add(k, 1)
        }
        ReturnValue(0)
    }
}

Function.Optimize_FoldOnce {
    Input: block: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(Compile.current_func, 0) ThenBlock: { ReturnValue(0) }
        count = AST_GetChildCount(block)
        i = 0
        WhileLoop LessThan(i, count) {
            st = AST_GetChild(block, i)
            IfCondition EqualTo(Optimize_PlainAssign(st), 1) ThenBlock: {
                t = AST_GetData1(st)
                expr = AST_GetChild(st, 0)
                take = 0
                IfCondition NotEqual(expr, 0) ThenBlock: {
                    IfCondition EqualTo(Optimize_PureExpr(expr), 1) ThenBlock: {
                        IfCondition EqualTo(Optimize_TreeHasIdent(expr, t), 0) ThenBlock: { take = 1 }
                    }
                }
                IfCondition EqualTo(take, 1) ThenBlock: {
                    // The scan already gave this name a register. Folding
                    // it into the next expression deletes the assignment
                    // and the register is never written.
                    IfCondition EqualTo(Optimize_ScanActive(), 1) ThenBlock: {
                        fid = Optimize_ScanFind(t)
                        IfCondition GreaterThan(fid, 0) ThenBlock: {
                            IfCondition NotEqual(Optimize_LiveMaxPos(fid), -1) ThenBlock: {
                                IfCondition NotEqual(Optimize_ScanReg(fid), -1) ThenBlock: {
                                    take = 0
                                }
                            }
                        }
                    }
                }
                IfCondition EqualTo(take, 1) ThenBlock: {
                    IfCondition EqualTo(Optimize_DivModKeep(block, i, expr), 0) ThenBlock: {
                    block_n = Optimize_Mentions(block, t)
                    func_n = Optimize_Mentions(Compile.current_func, t)
                    IfCondition EqualTo(block_n, func_n) ThenBlock: {
                        uses = Optimize_UsesAfter(block, t, i)
                        IfCondition EqualTo(uses, 1) ThenBlock: {
                            use_at = OptState.fold_between
                            use_st = AST_GetChild(block, use_at)
                            use_val = AST_GetChild(use_st, 0)
                            IfCondition EqualTo(Optimize_PureExpr(use_val), 1) ThenBlock: {
                                // A multiply folded into Float_Add or Float_Sub
                                // becomes one VFMADD and the non-integer bits
                                // change. That includes a fresh sum, not only an
                                // add that already names its own target.
                                keep_acc = 0
                                IfCondition EqualTo(AST_GetType(use_val), AST.CALL) ThenBlock: {
                                    IfCondition EqualTo(Optimize_TreeHasIdent(use_val, AST_GetData1(use_st)), 1) ThenBlock: {
                                        un = AST_GetData1(use_val)
                                        IfCondition EqualTo(StringCompare(un, "Float_Add"), 0) ThenBlock: { keep_acc = 1 }
                                        IfCondition EqualTo(StringCompare(un, "Float_Sub"), 0) ThenBlock: { keep_acc = 1 }
                                    }
                                }
                                keep_mul = 0
                                IfCondition EqualTo(AST_GetType(expr), AST.CALL) ThenBlock: {
                                    IfCondition EqualTo(StringCompare(AST_GetData1(expr), "Float_Mul"), 0) ThenBlock: {
                                        IfCondition EqualTo(Optimize_FoldMulSite(use_st, t), 1) ThenBlock: {
                                            keep_mul = 1
                                        }
                                    }
                                }
                                IfCondition EqualTo(keep_acc, 0) ThenBlock: {
                                    IfCondition EqualTo(keep_mul, 0) ThenBlock: {
                                        IfCondition EqualTo(Optimize_FoldClear(block, expr, i, use_at), 1) ThenBlock: {
                                            IfCondition EqualTo(Optimize_ReplaceOne(use_st, t, expr), 1) ThenBlock: {
                                                kids = AST_GetChildren(block)
                                                Array.Delete(kids, i)
                                                ReturnValue(1)
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                    }
                }
            }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

Function.Optimize_FoldBlock {
    Input: block: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(Optimize_FoldIsBlock(block), 0) ThenBlock: { ReturnValue(0) }
        saved = OptState.fold_between
        guard = 0
        WhileLoop LessThan(guard, 32) {
            did = Optimize_FoldOnce(block)
            IfCondition EqualTo(did, 0) ThenBlock: { guard = 32 }
            guard = Add(guard, 1)
        }
        OptState.fold_between = saved
        ReturnValue(0)
    }
}

// Inline asm can write a local or r11 without an assignment.
Function.Optimize_TreeHasAsm {
    Input: node: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(AST_GetType(node), AST.INLINEASM) ThenBlock: { ReturnValue(1) }
        count = AST_GetChildCount(node)
        i = 0
        WhileLoop LessThan(i, count) {
            IfCondition EqualTo(Optimize_TreeHasAsm(AST_GetChild(node, i)), 1) ThenBlock: { ReturnValue(1) }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

// A store can change a byte the induction pointer still names.
// Pinning a load across that store would reuse the old value.
Function.Optimize_TreeHasStore {
    Input: node: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        nt = AST_GetType(node)
        IfCondition EqualTo(nt, AST.INDEX_ASSIGN) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(nt, AST.POINTER_FIELD_ASSIGN) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(nt, AST.CALL) ThenBlock: {
            name = AST_GetData1(node)
            IfCondition NotEqual(name, 0) ThenBlock: {
                IfCondition EqualTo(StringCompare(name, "StoreValue"), 0) ThenBlock: { ReturnValue(1) }
                IfCondition EqualTo(StringCompare(name, "SetByte"), 0) ThenBlock: { ReturnValue(1) }
                IfCondition EqualTo(StringCompare(name, "MemoryCopy"), 0) ThenBlock: { ReturnValue(1) }
                IfCondition EqualTo(StringCompare(name, "MemorySet"), 0) ThenBlock: { ReturnValue(1) }
            }
        }
        count = AST_GetChildCount(node)
        i = 0
        WhileLoop LessThan(i, count) {
            IfCondition EqualTo(Optimize_TreeHasStore(AST_GetChild(node, i)), 1) ThenBlock: { ReturnValue(1) }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

// Assignments of name anywhere under node, including nested blocks.
Function.Optimize_AssignCount {
    Input: node: Address
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        n = 0
        IfCondition EqualTo(AST_GetType(node), AST.ASSIGNMENT) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(AST_GetData1(node), name), 1) ThenBlock: { n = 1 }
        }
        count = AST_GetChildCount(node)
        i = 0
        WhileLoop LessThan(i, count) {
            n = Add(n, Optimize_AssignCount(AST_GetChild(node, i), name))
            i = Add(i, 1)
        }
        ReturnValue(n)
    }
}
