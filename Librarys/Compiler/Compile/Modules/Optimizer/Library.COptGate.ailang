// Library.COptGate.ailang
// Switches and a log for finding over-optimization.
//   -optoff=a,b,...  turns rule groups off (names in Optimize_GateBit).
//   -optlog          writes <output>.optlog: one line per fired rule that
//                    drops, skips or rewrites source statements.
// A group is switched at the point that arms it, or at a rule that only
// ever answers "did not match", so turning it off takes the plain path.
// Loaded by the optimizer shell. No imports of its own.

FixedPool.OptGate {
    "off": Initialize=0, CanChange=True
    "log_on": Initialize=0, CanChange=True
    "log_fd": Initialize=-1, CanChange=True
    "log_path": Initialize=0, CanChange=True
    "bad": Initialize=0, CanChange=True
}

// Groups. all is every bit.
//   inline   Optimize_InlinePrepare (call splicing)
//   linscan  ScanArm; functions take the leaf path instead
//   regleaf  Optimize_RegLeafExpr (frameless one-expression functions)
//   fold     Optimize_FoldBlock, Optimize_TryRepeatSum
//   dead     Optimize_ZeroSkip, Optimize_IndexDead
//   homes    Optimize_LoopHomes; every loop takes the blocked path
//   select   Optimize_TryIfSelect, Optimize_ScanIfSelect (cmov)
//   magic    Optimize_MagicPrepare (division by a constant)
//   math     Optimize_TryMathOp
//   byte     Optimize_TryEmitGetByte, Optimize_TryEmitSetByte
//   scanrw   Optimize_ScanTriDen, Optimize_ScanLeaSum, Optimize_ScanFoldSkip
//   skip     Optimize_TryCmpSkip, Optimize_TryRdxSkip, Optimize_TryOffSkip
//   reload   Optimize_TryReloadDrop
Function.Optimize_GateBit {
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(StringEquals(name, "inline"), 1) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringEquals(name, "linscan"), 1) ThenBlock: { ReturnValue(2) }
        IfCondition EqualTo(StringEquals(name, "regleaf"), 1) ThenBlock: { ReturnValue(4) }
        IfCondition EqualTo(StringEquals(name, "fold"), 1) ThenBlock: { ReturnValue(8) }
        IfCondition EqualTo(StringEquals(name, "dead"), 1) ThenBlock: { ReturnValue(16) }
        IfCondition EqualTo(StringEquals(name, "homes"), 1) ThenBlock: { ReturnValue(32) }
        IfCondition EqualTo(StringEquals(name, "select"), 1) ThenBlock: { ReturnValue(64) }
        IfCondition EqualTo(StringEquals(name, "magic"), 1) ThenBlock: { ReturnValue(128) }
        IfCondition EqualTo(StringEquals(name, "math"), 1) ThenBlock: { ReturnValue(256) }
        IfCondition EqualTo(StringEquals(name, "byte"), 1) ThenBlock: { ReturnValue(512) }
        IfCondition EqualTo(StringEquals(name, "scanrw"), 1) ThenBlock: { ReturnValue(1024) }
        IfCondition EqualTo(StringEquals(name, "skip"), 1) ThenBlock: { ReturnValue(2048) }
        IfCondition EqualTo(StringEquals(name, "reload"), 1) ThenBlock: { ReturnValue(4096) }
        IfCondition EqualTo(StringEquals(name, "all"), 1) ThenBlock: { ReturnValue(8191) }
        ReturnValue(0)
    }
}

Function.Optimize_Off {
    Input: bit: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(BitwiseAnd(OptGate.off, bit), 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(1)
    }
}

// Reads one command-line argument. Returns 1 when it was a gate flag.
// An unknown group name sets OptGate.bad so the CLI can refuse to run.
Function.Optimize_GateArg {
    Input: arg: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(StringEquals(arg, "-optlog"), 1) ThenBlock: {
            OptGate.log_on = 1
            ReturnValue(1)
        }
        prefix = "-optoff="
        i = 0
        WhileLoop LessThan(i, 8) {
            IfCondition NotEqual(GetByte(arg, i), GetByte(prefix, i)) ThenBlock: { ReturnValue(0) }
            i = Add(i, 1)
        }
        tok = Allocate(32)
        n = 0
        c = GetByte(arg, i)
        WhileLoop NotEqual(c, 0) {
            IfCondition EqualTo(c, 44) ThenBlock: {
                SetByte(tok, n, 0)
                Optimize_GateAdd(tok)
                n = 0
            } ElseBlock: {
                IfCondition LessThan(n, 31) ThenBlock: {
                    SetByte(tok, n, c)
                    n = Add(n, 1)
                }
            }
            i = Add(i, 1)
            c = GetByte(arg, i)
        }
        SetByte(tok, n, 0)
        Optimize_GateAdd(tok)
        Deallocate(tok, 32)
        ReturnValue(1)
    }
}

Function.Optimize_GateAdd {
    Input: tok: Address
    Body: {
        IfCondition EqualTo(GetByte(tok, 0), 0) ThenBlock: { ReturnValue(0) }
        bit = Optimize_GateBit(tok)
        IfCondition EqualTo(bit, 0) ThenBlock: {
            PrintMessage("[OPTOFF] unknown group: ")
            PrintMessage(tok)
            PrintMessage("\n")
            OptGate.bad = 1
            ReturnValue(0)
        }
        OptGate.off = BitwiseOr(OptGate.off, bit)
    }
}

Function.Optimize_NoteDec {
    Input: fd: Integer
    Input: value: Integer
    Body: {
        buf = Allocate(24)
        v = value
        IfCondition LessThan(v, 0) ThenBlock: { v = 0 }
        n = 0
        WhileLoop LessThan(n, 1) {
            SetByte(buf, n, Add(48, Modulo(v, 10)))
            v = Divide(v, 10)
            n = Add(n, 1)
        }
        WhileLoop GreaterThan(v, 0) {
            SetByte(buf, n, Add(48, Modulo(v, 10)))
            v = Divide(v, 10)
            n = Add(n, 1)
        }
        // Digits went in backwards.
        out = Allocate(24)
        k = 0
        WhileLoop LessThan(k, n) {
            SetByte(out, k, GetByte(buf, Subtract(Subtract(n, 1), k)))
            k = Add(k, 1)
        }
        FileWrite(fd, out, n)
        Deallocate(out, 24)
        Deallocate(buf, 24)
    }
}

// One line: function <tab> +line <tab> rule <tab> name.
// +line counts from the function's own first line, since library lines
// are numbered in the merged unit. name may be 0 when the rule has no
// single target.
Function.Optimize_Note {
    Input: rule: Address
    Input: name: Address
    Input: node: Address
    Body: {
        IfCondition EqualTo(OptGate.log_on, 0) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(OptGate.log_fd, 0) ThenBlock: {
            IfCondition EqualTo(OptGate.log_path, 0) ThenBlock: { ReturnValue(0) }
            OptGate.log_fd = FileOpen(OptGate.log_path, 577, 420)
            IfCondition LessThan(OptGate.log_fd, 0) ThenBlock: {
                OptGate.log_on = 0
                ReturnValue(0)
            }
        }
        fd = OptGate.log_fd
        fname = 0
        rel = AST_GetLine(node)
        IfCondition NotEqual(Compile.current_func, 0) ThenBlock: {
            fname = AST_GetData1(Compile.current_func)
            rel = Subtract(rel, AST_GetLine(Compile.current_func))
        }
        IfCondition EqualTo(fname, 0) ThenBlock: { fname = "?" }
        Listing_WriteStr(fd, fname)
        Listing_WriteStr(fd, "\t+")
        Optimize_NoteDec(fd, rel)
        Listing_WriteStr(fd, "\t")
        Listing_WriteStr(fd, rule)
        Listing_WriteStr(fd, "\t")
        IfCondition EqualTo(name, 0) ThenBlock: { name = "-" }
        Listing_WriteStr(fd, name)
        Listing_WriteStr(fd, "\n")
    }
}

Function.Optimize_NoteClose {
    Body: {
        IfCondition GreaterEqual(OptGate.log_fd, 0) ThenBlock: {
            FileClose(OptGate.log_fd)
            OptGate.log_fd = -1
        }
    }
}
