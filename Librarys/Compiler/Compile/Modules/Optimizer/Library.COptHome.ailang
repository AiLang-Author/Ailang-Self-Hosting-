// Library.COptHome.ailang
// Loop register homes, liveness, and rax and rdx forwarding.
// Loaded by the optimizer shell. No imports of its own.

Function.Emit_HomeMove {
    Input: kind: Integer
    Input: imm: Integer
    Body: {
        IfCondition EqualTo(kind, 1) ThenBlock: { Emit_MovRaxR13() }
        IfCondition EqualTo(kind, 2) ThenBlock: { Emit_MovR13Rax() }
        IfCondition EqualTo(kind, 3) ThenBlock: {
            asm = "ADD r13, "
            nstr = NumberToString(imm)
            asm = StringConcat(asm, nstr)
            X86Enc_Assemble(asm)
        }
        IfCondition EqualTo(kind, 4) ThenBlock: {
            asm = "SUB r13, "
            nstr = NumberToString(imm)
            asm = StringConcat(asm, nstr)
            X86Enc_Assemble(asm)
        }
        IfCondition EqualTo(kind, 5) ThenBlock: { X86Enc_Assemble("MOVQ rax, xmm2") }
        IfCondition EqualTo(kind, 6) ThenBlock: { X86Enc_Assemble("MOVQ xmm2, rax") }
        IfCondition EqualTo(kind, 7) ThenBlock: { X86Enc_Assemble("MOVSD xmm0, xmm2") }
        IfCondition EqualTo(kind, 8) ThenBlock: { X86Enc_Assemble("MOVSD xmm1, xmm2") }
        IfCondition EqualTo(kind, 9) ThenBlock: { X86Enc_Assemble("MOVSD xmm2, xmm0") }
        IfCondition EqualTo(kind, 10) ThenBlock: { X86Enc_Assemble("MOVQ xmm1, rax") }
        IfCondition EqualTo(kind, 11) ThenBlock: { X86Enc_Assemble("MOVQ xmm0, rax") }
        IfCondition EqualTo(kind, 12) ThenBlock: { X86_EmitR13Mem(0, 73, 139, 0, 0, imm) }
        IfCondition EqualTo(kind, 13) ThenBlock: { X86Enc_Assemble("CMP r13, rbx") }
        IfCondition EqualTo(kind, 14) ThenBlock: { X86Enc_Assemble("CMP rax, r13") }
        IfCondition EqualTo(kind, 15) ThenBlock: {
            asm = "CMP r13, "
            nstr = NumberToString(imm)
            asm = StringConcat(asm, nstr)
            X86Enc_Assemble(asm)
        }
        IfCondition EqualTo(kind, 16) ThenBlock: { Emit_MovRaxR12() }
        IfCondition EqualTo(kind, 17) ThenBlock: { Emit_MovR12Rax() }
        IfCondition EqualTo(kind, 18) ThenBlock: { X86_EmitR13Mem(242, 65, 15, 88, 2, imm) }
        IfCondition EqualTo(kind, 19) ThenBlock: { X86_EmitR13Mem(242, 65, 15, 92, 2, imm) }
        IfCondition EqualTo(kind, 20) ThenBlock: { X86_EmitR13Mem(242, 65, 15, 89, 2, imm) }
        IfCondition EqualTo(kind, 21) ThenBlock: { X86_EmitR13Mem(0, 77, 3, 0, 4, imm) }
        IfCondition EqualTo(kind, 22) ThenBlock: { X86_EmitR13Mem(0, 77, 43, 0, 4, imm) }
        IfCondition EqualTo(kind, 23) ThenBlock: { X86_AddR12R13() }
        IfCondition EqualTo(kind, 24) ThenBlock: { X86_EmitR13Mem(242, 65, 15, 16, 0, imm) }
        IfCondition EqualTo(kind, 25) ThenBlock: { X86_EmitR13Mem(242, 65, 15, 89, 0, imm) }
        IfCondition EqualTo(kind, 26) ThenBlock: { X86Enc_Assemble("ADDSD xmm2, xmm0") }
        IfCondition EqualTo(kind, 27) ThenBlock: { X86_EmitR13Mem(242, 65, 15, 88, 0, imm) }
        IfCondition EqualTo(kind, 28) ThenBlock: { X86Enc_Assemble("MULSD xmm0, xmm2") }
        IfCondition EqualTo(kind, 29) ThenBlock: { X86_EmitR13Mem(242, 65, 15, 16, 1, imm) }
        IfCondition EqualTo(kind, 30) ThenBlock: { X86Enc_Assemble("MOVQ rax, xmm0") }
        IfCondition EqualTo(kind, 31) ThenBlock: { X86_EmitR13Mem(242, 65, 15, 92, 0, imm) }
        IfCondition EqualTo(kind, 32) ThenBlock: { X86Enc_Assemble("ADDSD xmm0, xmm2") }
        IfCondition EqualTo(kind, 33) ThenBlock: { X86Enc_Assemble("SUBSD xmm0, xmm2") }
        IfCondition EqualTo(kind, 34) ThenBlock: { X86_SubR12R13() }
        IfCondition EqualTo(kind, 35) ThenBlock: { X86Enc_Assemble("MULSD xmm2, xmm0") }
        IfCondition EqualTo(kind, 36) ThenBlock: { X86Enc_Assemble("SUBSD xmm2, xmm0") }
        IfCondition EqualTo(kind, 37) ThenBlock: { X86Enc_Assemble("MOVSD xmm1, xmm0") }
        IfCondition EqualTo(kind, 38) ThenBlock: { X86Enc_Assemble("ADDSD xmm0, xmm1") }
        IfCondition EqualTo(kind, 39) ThenBlock: { X86Enc_Assemble("SUBSD xmm0, xmm1") }
        IfCondition EqualTo(kind, 40) ThenBlock: { X86Enc_Assemble("MULSD xmm0, xmm1") }
        IfCondition EqualTo(kind, 41) ThenBlock: {
            asm = "ADD r12, "
            nstr = NumberToString(imm)
            asm = StringConcat(asm, nstr)
            X86Enc_Assemble(asm)
        }
        IfCondition EqualTo(kind, 42) ThenBlock: {
            asm = "SUB r12, "
            nstr = NumberToString(imm)
            asm = StringConcat(asm, nstr)
            X86Enc_Assemble(asm)
        }
        // MOV [r13 + disp], rax. Kinds 1-42 are unchanged.
        IfCondition EqualTo(kind, 43) ThenBlock: { X86_EmitR13Mem(0, 73, 137, 0, 0, imm) }
        IfCondition EqualTo(kind, 44) ThenBlock: { X86Enc_Assemble("CMP r12, rbx") }
        IfCondition EqualTo(kind, 45) ThenBlock: { X86Enc_Assemble("CMP rax, r12") }
        IfCondition EqualTo(kind, 46) ThenBlock: {
            asm = "CMP r12, "
            nstr = NumberToString(imm)
            asm = StringConcat(asm, nstr)
            X86Enc_Assemble(asm)
        }
    }
}

Function.Optimize_HomeRelease {
    Body: {
        LoopHome.active = 0
        LoopHome.blocked = 0
        LoopHome.no_float = 0
        LoopHome.int_name = 0
        LoopHome.flt_name = 0
        LoopHome.int_off = 0
        LoopHome.flt_off = 0
        LoopHome.assign_name = 0
        LoopHome.acc_name = 0
        LoopHome.acc_off = 0
        LoopHome.a0_on = 0
        LoopHome.a1_on = 0
        LoopHome.a2_on = 0
        LoopHome.a3_on = 0
        LoopHome.hold_on = 0
        LoopHome.hold_name = 0
        LoopHome.rbx_free = 0
        LoopHome.lim_on = 0
        LoopHome.lim_name = 0
        LoopHome.lim_off = 0
        LoopHome.alias_spill = 0
        LoopHome.body = 0
        LoopHome.rld_count = 0
        LoopHome.hit_xmm = 0
        LoopHome.tab_on = 0
        LoopHome.tab_name = 0
        LoopHome.tab_off = 0
        LoopHome.tab_many = 0
        LoopHome.has_call = 0
        LoopHome.scan_depth = 0
        LoopHome.sib_index = 1
        LoopHome.der_on = 0
        LoopHome.der_name = 0
        LoopHome.der_via = 0
        LoopHome.der_const = 0
        LoopHome.der_off = 0
        LoopHome.der_step = 0
        LoopHome.iv_nn = 0
        LoopHome.iv_lo = 0
        LoopHome.iv_hi = 0
        LoopHome.iv_step = 0
        LoopHome.iv_at = 0
        LoopHome.coal_on = 0
        LoopHome.coal_name = 0
        LoopHome.coal_slot = 0
        LoopHome.cond = 0
        LoopHome.prod_on = 0
        LoopHome.prod_c = 0
        LoopHome.prod_delta = 0
        LoopHome.prod_bad = 0
        LoopHome.prod_seen = 0
        LoopHome.prod_tmp = 0
        LoopHome.pin_n = 0
        LoopHome.pin_hit = 0
        LoopHome.kmul_on = 0
        LoopHome.kmul_name = 0
        LoopHome.kmul_off = 0
        LoopHome.ihold_on = 0
        LoopHome.ihold_name = 0
        LoopHome.ihold_off = 0
        LoopHome.ihold_reg = 0
        LoopHome.rbx_scratch = 0
        LoopHome.fwd_on = 0
        LoopHome.fwd_name = 0
        LoopHome.fwd_slot = 0
        LoopHome.fwd_use = 0
        LoopHome.sse_scratch = 0
        LoopHome.rax_on = 0
        LoopHome.rax_cand = 0
        LoopHome.rax_fresh = 0
        LoopHome.rax_name = 0
        LoopHome.trip_on = 0
        LoopHome.trip_reg = 0
        LoopHome.trip_span = 0
        LoopHome.trip_exit = 0
        LoopHome.st_on = 0
        LoopHome.st_off = 0
        LoopHome.st_idx = 0
        LoopHome.st_base = 0
        LoopHome.st_shift = 0
        LoopHome.st_disp = 0
        LoopHome.rcx_on = 0
        LoopHome.rcx_name = 0
        LoopHome.rcx_base = 0
        LoopHome.off_skip = 0
        LoopHome.rdx_on = 0
        LoopHome.rdx_name = 0
        Optimize_PtrClearAll()
        Optimize_IpClear()
        Optimize_AllocReset()
    }
}

Function.Optimize_HomeRec {
    Input: index: Integer
    Output: Address
    Body: {
        off = Multiply(index, 48)
        ReturnValue(Add(LoopHome.recs, off))
    }
}

Function.Optimize_IsIntHome {
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(LoopHome.active, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(LoopHome.int_name, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(StringCompare(name, LoopHome.int_name), 0) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

Function.Optimize_FltSlot {
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(LoopHome.active, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterThan(LoopHome.coal_on, 0) ThenBlock: {
            hit = Optimize_CoalFind(name)
            IfCondition GreaterThan(hit, 0) ThenBlock: { ReturnValue(hit) }
        }
        IfCondition EqualTo(Optimize_Loc(name), 1) ThenBlock: {
            IfCondition EqualTo(AllocTab.hit_class, 2) ThenBlock: {
                ReturnValue(AllocTab.hit_reg)
            }
        }
        ReturnValue(0)
    }
}

// First free xmm3–xmm14, from the table. The row is visible immediately.
// AllocPublish parks it and puts the other homes in front.
Function.Optimize_InstallFlt {
    Input: name: Address
    Input: off: Integer
    Output: Integer
    Body: {
        reg = 3
        WhileLoop LessThan(reg, 15) {
            IfCondition EqualTo(Optimize_ExtraXmm(reg), 0) ThenBlock: {
                Optimize_AllocAdd(name, 2, reg, off)
                ReturnValue(1)
            }
            reg = Add(reg, 1)
        }
        ReturnValue(0)
    }
}

// A read of name. An assignment target is a write, so it does not count.
// An index or pointer-field base is a read: the name lives in Data1.
Function.Optimize_NodeReads {
    Input: node: Address
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }
        nt = AST_GetType(node)
        IfCondition EqualTo(nt, AST.IDENTIFIER) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(AST_GetData1(node), name), 1) ThenBlock: { ReturnValue(1) }
        }
        IfCondition EqualTo(nt, AST.INDEX_ASSIGN) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(AST_GetData1(node), name), 1) ThenBlock: { ReturnValue(1) }
        }
        IfCondition EqualTo(nt, AST.POINTER_FIELD_ASSIGN) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(AST_GetData1(node), name), 1) ThenBlock: { ReturnValue(1) }
        }
        IfCondition EqualTo(nt, AST.POINTER_FIELD_ACCESS) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(AST_GetData1(node), name), 1) ThenBlock: { ReturnValue(1) }
        }
        count = AST_GetChildCount(node)
        i = 0
        WhileLoop LessThan(i, count) {
            IfCondition EqualTo(Optimize_NodeReads(AST_GetChild(node, i), name), 1) ThenBlock: { ReturnValue(1) }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

// Plain assignment that replaces name. The right-hand side must not read it.
Function.Optimize_LiveFullDef {
    Input: st: Address
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(Optimize_PlainAssign(st), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_NameEq(AST_GetData1(st), name), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_NodeReads(AST_GetChild(st, 0), name), 1) ThenBlock: { ReturnValue(0) }
        ReturnValue(1)
    }
}

// 1 when name is mentioned in node, ignoring the loop body at skip.
// The while condition stays visible because only the body is skipped.
Function.Optimize_OutsideHit {
    Input: node: Address
    Input: name: Address
    Input: skip: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(node, skip) ThenBlock: { ReturnValue(0) }
        nt = AST_GetType(node)
        IfCondition EqualTo(nt, AST.IDENTIFIER) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(AST_GetData1(node), name), 1) ThenBlock: { ReturnValue(1) }
        }
        IfCondition EqualTo(nt, AST.ASSIGNMENT) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(AST_GetData1(node), name), 1) ThenBlock: { ReturnValue(1) }
        }
        IfCondition EqualTo(nt, AST.INDEX_ASSIGN) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(AST_GetData1(node), name), 1) ThenBlock: { ReturnValue(1) }
        }
        IfCondition EqualTo(nt, AST.POINTER_FIELD_ASSIGN) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(AST_GetData1(node), name), 1) ThenBlock: { ReturnValue(1) }
        }
        IfCondition EqualTo(nt, AST.POINTER_FIELD_ACCESS) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(AST_GetData1(node), name), 1) ThenBlock: { ReturnValue(1) }
        }
        count = AST_GetChildCount(node)
        i = 0
        WhileLoop LessThan(i, count) {
            IfCondition EqualTo(Optimize_OutsideHit(AST_GetChild(node, i), name, skip), 1) ThenBlock: { ReturnValue(1) }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

// AddressOf(name) or any inline asm can read the frame slot without a
// later identifier, so the home must be stored back.
Function.Optimize_LiveEscape {
    Input: node: Address
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        nt = AST_GetType(node)
        IfCondition EqualTo(nt, AST.INLINEASM) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(nt, AST.CALL) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(AST_GetData1(node), "AddressOf"), 1) ThenBlock: {
                IfCondition EqualTo(Optimize_NodeReads(node, name), 1) ThenBlock: { ReturnValue(1) }
            }
        }
        count = AST_GetChildCount(node)
        i = 0
        WhileLoop LessThan(i, count) {
            IfCondition EqualTo(Optimize_LiveEscape(AST_GetChild(node, i), name), 1) ThenBlock: { ReturnValue(1) }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

// 1 when the value in the home must be written back at the loop exit.
// Missing the function node spills. An extra spill is safe.
Function.Optimize_LiveOut {
    Input: name: Address
    Input: body: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Compile.current_func, 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(body, 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(Optimize_OutsideHit(Compile.current_func, name, body), 1) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(Optimize_LiveEscape(Compile.current_func, name), 1) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

// 1 when the loop entry must reload name.
// A live-out home is reloaded even when the body defines it: the loop may
// run zero times and the exit spill must keep the incoming bits.
// A straight-line full definition before any read kills the incoming value.
Function.Optimize_LiveIn {
    Input: name: Address
    Input: condition: Address
    Input: body: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_NodeReads(condition, name), 1) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(Optimize_LiveOut(name, body), 1) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(Optimize_FoldIsBlock(body), 0) ThenBlock: { ReturnValue(1) }
        count = AST_GetChildCount(body)
        i = 0
        WhileLoop LessThan(i, count) {
            st = AST_GetChild(body, i)
            IfCondition EqualTo(Optimize_NodeReads(st, name), 1) ThenBlock: { ReturnValue(1) }
            IfCondition EqualTo(Optimize_LiveFullDef(st, name), 1) ThenBlock: { ReturnValue(0) }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

Function.Optimize_IsFltHome {
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition GreaterThan(Optimize_FltSlot(name), 0) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

Function.Optimize_IsAccHome {
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(LoopHome.active, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(LoopHome.acc_name, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(StringCompare(name, LoopHome.acc_name), 0) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

Function.Optimize_HomeLoad {
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition GreaterThan(PinDefer.n, 0) ThenBlock: { Optimize_PinFlush() }
        IfCondition EqualTo(LoopHome.der_on, 1) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(name, LoopHome.der_name), 1) ThenBlock: {
                X86Enc_Assemble("MOV rax, r11")
                ReturnValue(1)
            }
        }
        IfCondition EqualTo(LoopHome.hold_on, 1) ThenBlock: {
            IfCondition EqualTo(StringCompare(name, LoopHome.hold_name), 0) ThenBlock: {
                Emit_HomeMove(30, 0)
                ReturnValue(1)
            }
        }
        IfCondition EqualTo(Optimize_AliasFind(name), 1) ThenBlock: {
            Emit_HomeMove(12, LoopHome.hit_disp)
            ReturnValue(1)
        }
        ReturnValue(0)
    }
}

Function.Optimize_HomeStore {
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(Optimize_AliasFind(name), 1) ThenBlock: {
            Optimize_AliasClear(name)
            ReturnValue(0)
        }
        ReturnValue(0)
    }
}

Function.Optimize_HomeCallOk {
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(StringCompare(name, "Add"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "Subtract"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "Multiply"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "Divide"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "Modulo"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "Negate"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "EqualTo"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "NotEqual"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "LessThan"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "GreaterThan"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "LessEqual"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "GreaterEqual"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "BitwiseAnd"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "BitwiseOr"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "BitwiseXor"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "BitwiseNot"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "LeftShift"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "RightShift"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "BitAnd"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "BitOr"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "BitXor"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "BitNot"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "ShiftLeft"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "ShiftRight"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "And"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "Or"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "Not"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "Float_Add"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "Float_Sub"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "Float_Mul"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "Float_Div"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "Float_Neg"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "Float_Abs"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "Float_Sqrt"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "Float_FromInt"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "Float_ToInt"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "Dereference"), 0) ThenBlock: { ReturnValue(1) }
        // Inline store: push the address, move the value through rbx, then
        // mov [rax], rbx. No call, and r13 and xmm2-xmm5 stay put. Allocate
        // and Deallocate call the arena, so they stay real calls.
        IfCondition EqualTo(StringCompare(name, "StoreValue"), 0) ThenBlock: { ReturnValue(1) }
        // Float compares use xmm0, xmm1, rax, and rcx. GetByte and SetByte
        // use rax, rbx, and rdi. None of them write r12, r13, r14, or
        // xmm2-xmm14. RbxSafeOp still rejects them, so a leaf compare bound
        // is not parked in rbx beside a byte op.
        IfCondition EqualTo(StringCompare(name, "Float_Eq"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "Float_Ne"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "Float_Lt"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "Float_Gt"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "Float_Le"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "Float_Ge"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "GetByte"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "SetByte"), 0) ThenBlock: { ReturnValue(1) }
        // In-place scans. StringLength and Crc32String use rax, rcx, rdi,
        // r8, xmm0, and xmm1. StringCompare saves xmm2 and xmm3. MemoryCopy
        // uses xmm0 and restores rsi, rdi, and rcx.
        IfCondition EqualTo(StringCompare(name, "StringLength"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "StringCompare"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "StringEquals"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "Crc32String"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "MemoryCopy"), 0) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

// True when Float_Add or Float_Sub has a Float_Mul child. The multiply
// is fused into a live home, or into xmm0 with xmm6 as the multiplicand.
// It does not by itself write xmm2–xmm5.
Function.Optimize_HomeFma {
    Input: node: Address
    Output: Integer
    Body: {
        name = AST_GetData1(node)
        is_add = 0
        IfCondition EqualTo(StringCompare(name, "Float_Add"), 0) ThenBlock: { is_add = 1 }
        IfCondition EqualTo(StringCompare(name, "Float_Sub"), 0) ThenBlock: { is_add = 1 }
        IfCondition EqualTo(is_add, 0) ThenBlock: { ReturnValue(0) }
        n = AST_GetChildCount(node)
        i = 0
        WhileLoop LessThan(i, n) {
            child = AST_GetChild(node, i)
            IfCondition NotEqual(child, 0) ThenBlock: {
                ct = AST_GetType(child)
                IfCondition EqualTo(ct, AST.CALL) ThenBlock: {
                    cn = AST_GetData1(child)
                    IfCondition EqualTo(StringCompare(cn, "Float_Mul"), 0) ThenBlock: { ReturnValue(1) }
                }
            }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

Function.Optimize_HomeTouch {
    Input: name: Address
    Input: is_store: Integer
    Input: is_float: Integer
    Input: is_seed: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(LoopHome.recs, 0) ThenBlock: {
            LoopHome.recs = Allocate(3072)
        }
        found = -1
        i = 0
        WhileLoop LessThan(i, LoopHome.count) {
            rec = Optimize_HomeRec(i)
            existing = Dereference(rec)
            IfCondition EqualTo(StringCompare(existing, name), 0) ThenBlock: {
                found = i
                ExitLoop
            }
            i = Add(i, 1)
        }
        IfCondition EqualTo(found, -1) ThenBlock: {
            IfCondition GreaterEqual(LoopHome.count, 64) ThenBlock: { ReturnValue(0) }
            found = LoopHome.count
            LoopHome.count = Add(LoopHome.count, 1)
            rec = Optimize_HomeRec(found)
            StoreValue(rec, name)
            StoreValue(Add(rec, 8), 0)
            StoreValue(Add(rec, 16), 0)
            StoreValue(Add(rec, 24), 0)
            StoreValue(Add(rec, 32), 0)
            StoreValue(Add(rec, 40), 0)
        }
        rec = Optimize_HomeRec(found)
        IfCondition EqualTo(is_store, 1) ThenBlock: {
            stores = Dereference(Add(rec, 16))
            StoreValue(Add(rec, 16), Add(stores, 1))
            IfCondition EqualTo(is_float, 1) ThenBlock: {
                fops = Dereference(Add(rec, 24))
                StoreValue(Add(rec, 24), Add(fops, 1))
            }
            IfCondition EqualTo(is_seed, 1) ThenBlock: {
                seeds = Dereference(Add(rec, 40))
                StoreValue(Add(rec, 40), Add(seeds, 1))
            }
        } ElseBlock: {
            loads = Dereference(Add(rec, 8))
            StoreValue(Add(rec, 8), Add(loads, 1))
            IfCondition NotEqual(LoopHome.assign_name, 0) ThenBlock: {
                IfCondition EqualTo(StringCompare(name, LoopHome.assign_name), 0) ThenBlock: {
                    selfn = Dereference(Add(rec, 32))
                    StoreValue(Add(rec, 32), Add(selfn, 1))
                }
            }
        }
        ReturnValue(0)
    }
}

Function.Optimize_HomeWalkKids {
    Input: node: Address
    Output: Integer
    Body: {
        count = AST_GetChildCount(node)
        i = 0
        WhileLoop LessThan(i, count) {
            IfCondition EqualTo(LoopHome.blocked, 1) ThenBlock: { ExitLoop }
            child = AST_GetChild(node, i)
            Optimize_HomeWalk(child)
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

Function.Optimize_HomeBlockNode {
    Input: node_type: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(node_type, AST.WHILE) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(node_type, AST.FOR_EVERY) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(node_type, AST.UNTIL) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(node_type, AST.TRY) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(node_type, AST.LOOP_MAIN) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(node_type, AST.LOOP_ACTOR) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(node_type, AST.LOOP_START) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(node_type, AST.LOOP_SHADOW) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(node_type, AST.DEFER) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(node_type, AST.WITH_CONTEXT) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(node_type, AST.EVERY_INTERVAL) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(node_type, AST.POINTER_FIELD_ASSIGN) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

Function.Optimize_HomeWalk {
    Input: node: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(LoopHome.blocked, 1) ThenBlock: { ReturnValue(0) }
        node_type = AST_GetType(node)
        IfCondition EqualTo(Optimize_HomeBlockNode(node_type), 1) ThenBlock: {
            LoopHome.blocked = 1
            ReturnValue(0)
        }
        IfCondition EqualTo(node_type, AST.IDENTIFIER) ThenBlock: {
            Optimize_HomeTouch(AST_GetData1(node), 0, 0, 0)
            ReturnValue(0)
        }
        IfCondition EqualTo(node_type, AST.ASSIGNMENT) ThenBlock: {
            target_node = AST_GetData2(node)
            IfCondition NotEqual(target_node, 0) ThenBlock: {
                LoopHome.blocked = 1
                ReturnValue(0)
            }
            tname = AST_GetData1(node)
            val = AST_GetChild(node, 0)
            is_float = 0
            is_seed = 0
            IfCondition NotEqual(val, 0) ThenBlock: {
                vt = AST_GetType(val)
                IfCondition EqualTo(vt, AST.CALL) ThenBlock: {
                    vn = AST_GetData1(val)
                    IfCondition EqualTo(StringCompare(vn, "Float_Add"), 0) ThenBlock: { is_float = 1 }
                    IfCondition EqualTo(StringCompare(vn, "Float_Sub"), 0) ThenBlock: { is_float = 1 }
                    IfCondition EqualTo(StringCompare(vn, "Float_Mul"), 0) ThenBlock: { is_float = 1 }
                    IfCondition EqualTo(StringCompare(vn, "Float_Div"), 0) ThenBlock: { is_float = 1 }
                    // A qword load seeds the name. It counts toward a float
                    // home only together with a later add, subtract, multiply,
                    // or divide. A pure load stays fops == 0.
                    IfCondition EqualTo(StringCompare(vn, "Dereference"), 0) ThenBlock: { is_seed = 1 }
                }
            }
            skip_store = 0
            IfCondition NotEqual(val, 0) ThenBlock: {
                IfCondition EqualTo(AST_GetType(val), AST.NUMBER) ThenBlock: {
                    IfCondition EqualTo(StringToNumber(AST_GetData1(val)), 0) ThenBlock: {
                        skip_store = 1
                    }
                }
            }
            IfCondition EqualTo(skip_store, 0) ThenBlock: {
                Optimize_HomeTouch(tname, 1, is_float, is_seed)
            }
            LoopHome.assign_name = tname
            Optimize_HomeWalkKids(node)
            LoopHome.assign_name = 0
            ReturnValue(0)
        }
        IfCondition EqualTo(node_type, AST.CALL) ThenBlock: {
            cname = AST_GetData1(node)
            IfCondition EqualTo(Optimize_HomeCallOk(cname), 0) ThenBlock: {
                IfCondition LessThan(Compile_FindFunction(cname), 0) ThenBlock: {
                    LoopHome.blocked = 1
                    ReturnValue(0)
                }
                LoopHome.has_call = 1
            }
            // A fused multiply-add does not take xmm2. Expression FMA uses
            // xmm6. A home update writes that home in place.
            Optimize_HomeWalkKids(node)
            ReturnValue(0)
        }
        Optimize_HomeWalkKids(node)
        ReturnValue(0)
    }
}

// A field that is loaded, added or subtracted once, and stored back.
// That shape stays a pointer update and does not take a float home.
Function.Optimize_FltFieldUpd {
    Input: loads: Integer
    Input: stores: Integer
    Input: fops: Integer
    Input: selfn: Integer
    Input: seeds: Integer
    Output: Integer
    Body: {
        IfCondition NotEqual(seeds, 1) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(fops, 1) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(stores, 2) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(loads, 2) ThenBlock: { ReturnValue(0) }
        IfCondition LessEqual(selfn, 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(1)
    }
}

Function.Optimize_HomePick {
    Output: Integer
    Body: {
        best_int_name = 0
        best_int_off = 0
        best_int_score = 0
        best_flt_name = 0
        best_flt_off = 0
        best_flt_self = -1
        best_flt_score = 0
        best_flt_loads = -1
        best_flt_fresh = 0
        i = 0
        WhileLoop LessThan(i, LoopHome.count) {
            rec = Optimize_HomeRec(i)
            name = Dereference(rec)
            loads = Dereference(Add(rec, 8))
            stores = Dereference(Add(rec, 16))
            fops = Dereference(Add(rec, 24))
            selfn = Dereference(Add(rec, 32))
            seeds = Dereference(Add(rec, 40))
            IfCondition GreaterThan(loads, 0) ThenBlock: {
                IfCondition GreaterThan(stores, 0) ThenBlock: {
                    IfCondition GreaterThan(fops, 0) ThenBlock: {
                        IfCondition EqualTo(stores, Add(fops, seeds)) ThenBlock: {
                            IfCondition EqualTo(LoopHome.no_float, 0) ThenBlock: {
                                off = Scope_Resolve(name)
                                rt = Scope.resolve_type
                                slot_ok = 0
                                fresh = 0
                                cand_off = 0
                                IfCondition EqualTo(rt, 1) ThenBlock: {
                                    IfCondition LessThan(off, 0) ThenBlock: {
                                        slot_ok = 1
                                        cand_off = off
                                    }
                                }
                                IfCondition EqualTo(rt, 2) ThenBlock: {
                                    IfCondition LessThan(off, 0) ThenBlock: {
                                        slot_ok = 1
                                        cand_off = off
                                    }
                                }
                                IfCondition EqualTo(rt, 0) ThenBlock: {
                                    slot_ok = 1
                                    fresh = 1
                                }
                                IfCondition EqualTo(slot_ok, 1) ThenBlock: {
                                    IfCondition EqualTo(selfn, 0) ThenBlock: {
                                        IfCondition EqualTo(loads, stores) ThenBlock: {
                                            IfCondition EqualTo(Optimize_ConstTempSkip(name), 1) ThenBlock: { slot_ok = 0 }
                                        }
                                    }
                                    IfCondition EqualTo(Optimize_FltFieldUpd(loads, stores, fops, selfn, seeds), 1) ThenBlock: { slot_ok = 0 }
                                    IfCondition EqualTo(slot_ok, 1) ThenBlock: {
                                    take = 0
                                    IfCondition GreaterThan(loads, best_flt_loads) ThenBlock: { take = 1 }
                                    IfCondition EqualTo(loads, best_flt_loads) ThenBlock: {
                                        IfCondition GreaterThan(selfn, best_flt_self) ThenBlock: { take = 1 }
                                        IfCondition EqualTo(selfn, best_flt_self) ThenBlock: {
                                            IfCondition GreaterThan(fops, best_flt_score) ThenBlock: { take = 1 }
                                        }
                                    }
                                    IfCondition EqualTo(take, 1) ThenBlock: {
                                        best_flt_loads = loads
                                        best_flt_self = selfn
                                        best_flt_score = fops
                                        best_flt_name = name
                                        best_flt_off = cand_off
                                        best_flt_fresh = fresh
                                    }
                                    }
                                }
                            }
                        }
                    }
                    IfCondition EqualTo(fops, 0) ThenBlock: {
                        off = Scope_Resolve(name)
                        rt = Scope.resolve_type
                        ok = 0
                        IfCondition EqualTo(rt, 1) ThenBlock: { ok = 1 }
                        IfCondition EqualTo(rt, 2) ThenBlock: { ok = 1 }
                        IfCondition GreaterEqual(off, 0) ThenBlock: { ok = 0 }
                        IfCondition EqualTo(ok, 1) ThenBlock: {
                            score = Add(loads, stores)
                            IfCondition GreaterThan(score, best_int_score) ThenBlock: {
                                best_int_score = score
                                best_int_name = name
                                best_int_off = off
                            }
                        }
                    }
                }
            }
            i = Add(i, 1)
        }
        IfCondition EqualTo(best_flt_fresh, 1) ThenBlock: {
            best_flt_off = Optimize_EnsureSlot(best_flt_name)
            IfCondition EqualTo(best_flt_off, 0) ThenBlock: { best_flt_name = 0 }
        }
        LoopHome.int_name = best_int_name
        LoopHome.int_off = best_int_off
        LoopHome.flt_name = best_flt_name
        LoopHome.flt_off = best_flt_off
        best_acc_name = 0
        best_acc_off = 0
        best_acc_self = 0
        best_acc_score = -1
        IfCondition NotEqual(best_int_name, 0) ThenBlock: {
            j = 0
            WhileLoop LessThan(j, LoopHome.count) {
                rec2 = Optimize_HomeRec(j)
                aname = Dereference(rec2)
                aloads = Dereference(Add(rec2, 8))
                astores = Dereference(Add(rec2, 16))
                afops = Dereference(Add(rec2, 24))
                aself = Dereference(Add(rec2, 32))
                ausable = 0
                IfCondition GreaterThan(aloads, 0) ThenBlock: {
                    IfCondition GreaterThan(astores, 0) ThenBlock: {
                        IfCondition EqualTo(afops, 0) ThenBlock: {
                            IfCondition GreaterThan(aself, 0) ThenBlock: {
                                IfCondition NotEqual(StringCompare(aname, best_int_name), 0) ThenBlock: {
                                    aoff = Scope_Resolve(aname)
                                    art = Scope.resolve_type
                                    aok = 0
                                    IfCondition EqualTo(art, 1) ThenBlock: { aok = 1 }
                                    IfCondition EqualTo(art, 2) ThenBlock: { aok = 1 }
                                    IfCondition GreaterEqual(aoff, 0) ThenBlock: { aok = 0 }
                                    IfCondition EqualTo(aok, 1) ThenBlock: { ausable = 1 }
                                    IfCondition EqualTo(ausable, 1) ThenBlock: {
                                        ascore = Add(aloads, astores)
                                        atake = 0
                                        IfCondition GreaterThan(aself, best_acc_self) ThenBlock: { atake = 1 }
                                        IfCondition EqualTo(aself, best_acc_self) ThenBlock: {
                                            IfCondition GreaterThan(ascore, best_acc_score) ThenBlock: { atake = 1 }
                                        }
                                        IfCondition EqualTo(atake, 1) ThenBlock: {
                                            best_acc_self = aself
                                            best_acc_score = ascore
                                            best_acc_name = aname
                                            best_acc_off = aoff
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
                j = Add(j, 1)
            }
        }
        LoopHome.acc_name = best_acc_name
        LoopHome.acc_off = best_acc_off
        IfCondition NotEqual(LoopHome.flt_name, 0) ThenBlock: {
            Optimize_HomePickExtras()
        }
        ReturnValue(0)
    }
}

// 1 when node contains a call that is not on the home-safe list.
// Home-safe calls are still walked, so a user call in an argument counts.
Function.Optimize_ExprBad {
    Input: node: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        nt = AST_GetType(node)
        IfCondition EqualTo(nt, AST.CALL) ThenBlock: {
            cn = AST_GetData1(node)
            IfCondition EqualTo(Optimize_HomeCallOk(cn), 0) ThenBlock: { ReturnValue(1) }
        }
        count = AST_GetChildCount(node)
        i = 0
        WhileLoop LessThan(i, count) {
            IfCondition EqualTo(Optimize_ExprBad(AST_GetChild(node, i)), 1) ThenBlock: { ReturnValue(1) }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

// How control leaves node.
// 0 falls, and no home-clobbering call falls with it.
// 1 falls, and a home-clobbering call falls with it.
// 2 leaves by Return. The frame dies, so homes do not have to survive.
// 3 reaches ContinueLoop or ExitLoop. Homes are spilled there, so a call
// on that path still counts.
Function.Optimize_FlowBlock {
    Input: node: Address
    Output: Integer
    Body: {
        pending = 0
        count = AST_GetChildCount(node)
        i = 0
        WhileLoop LessThan(i, count) {
            code = Optimize_Flow(AST_GetChild(node, i))
            IfCondition EqualTo(code, 3) ThenBlock: { ReturnValue(3) }
            IfCondition EqualTo(code, 1) ThenBlock: { pending = 1 }
            IfCondition EqualTo(code, 2) ThenBlock: { ReturnValue(2) }
            i = Add(i, 1)
        }
        IfCondition EqualTo(pending, 1) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

Function.Optimize_FlowIf {
    Input: node: Address
    Output: Integer
    Body: {
        cond_bad = Optimize_ExprBad(AST_GetChild(node, 0))
        then_code = Optimize_Flow(AST_GetChild(node, 1))
        has_else = 0
        else_code = 0
        IfCondition GreaterThan(AST_GetChildCount(node), 2) ThenBlock: {
            has_else = 1
            else_code = Optimize_Flow(AST_GetChild(node, 2))
        }
        IfCondition EqualTo(then_code, 3) ThenBlock: { ReturnValue(3) }
        IfCondition EqualTo(else_code, 3) ThenBlock: { ReturnValue(3) }
        IfCondition EqualTo(has_else, 0) ThenBlock: {
            IfCondition EqualTo(cond_bad, 1) ThenBlock: { ReturnValue(1) }
            IfCondition EqualTo(then_code, 1) ThenBlock: { ReturnValue(1) }
            ReturnValue(0)
        }
        falls = 0
        badfall = 0
        IfCondition LessThan(then_code, 2) ThenBlock: { falls = 1 }
        IfCondition EqualTo(then_code, 1) ThenBlock: { badfall = 1 }
        IfCondition LessThan(else_code, 2) ThenBlock: { falls = 1 }
        IfCondition EqualTo(else_code, 1) ThenBlock: { badfall = 1 }
        IfCondition EqualTo(cond_bad, 1) ThenBlock: {
            IfCondition EqualTo(falls, 1) ThenBlock: { badfall = 1 }
        }
        IfCondition EqualTo(falls, 0) ThenBlock: { ReturnValue(2) }
        IfCondition EqualTo(badfall, 1) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

Function.Optimize_Flow {
    Input: node: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        nt = AST_GetType(node)
        IfCondition EqualTo(nt, AST.RETURN) ThenBlock: { ReturnValue(2) }
        IfCondition EqualTo(nt, AST.EXIT_LOOP) ThenBlock: { ReturnValue(3) }
        IfCondition EqualTo(nt, AST.CONTINUE_LOOP) ThenBlock: { ReturnValue(3) }
        IfCondition EqualTo(nt, AST.BLOCK) ThenBlock: { ReturnValue(Optimize_FlowBlock(node)) }
        IfCondition EqualTo(nt, AST.IF) ThenBlock: { ReturnValue(Optimize_FlowIf(node)) }
        IfCondition EqualTo(Optimize_ExprBad(node), 1) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

// 1 when a home-clobbering call can reach the loop back edge or a break.
// A call that only reaches Return does not.
Function.Optimize_EdgeBad {
    Input: condition: Address
    Input: body: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(Optimize_ExprBad(condition), 1) ThenBlock: { ReturnValue(1) }
        code = Optimize_Flow(body)
        IfCondition EqualTo(code, 1) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(code, 3) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

Function.Optimize_LoopHomes {
    Input: condition: Address
    Input: body: Address
    Output: Integer
    Body: {
        Optimize_AllocReset()
        LoopHome.blocked = 0
        LoopHome.no_float = 0
        LoopHome.count = 0
        LoopHome.int_name = 0
        LoopHome.flt_name = 0
        LoopHome.int_off = 0
        LoopHome.flt_off = 0
        LoopHome.acc_name = 0
        LoopHome.acc_off = 0
        LoopHome.assign_name = 0
        LoopHome.rbx_free = 0
        LoopHome.lim_on = 0
        LoopHome.alias_spill = 1
        LoopHome.hold_on = 0
        LoopHome.hold_name = 0
        LoopHome.body = 0
        LoopHome.cond = 0
        LoopHome.coal_on = 0
        LoopHome.coal_name = 0
        LoopHome.coal_slot = 0
        LoopHome.rld_count = 0
        LoopHome.tab_on = 0
        LoopHome.tab_name = 0
        LoopHome.tab_off = 0
        LoopHome.tab_many = 0
        LoopHome.has_call = 0
        LoopHome.scan_depth = 0
        LoopHome.hit_xmm = 0
        LoopHome.sib_index = 1
        LoopHome.der_on = 0
        LoopHome.der_name = 0
        LoopHome.der_via = 0
        LoopHome.der_const = 0
        LoopHome.der_off = 0
        LoopHome.der_step = 0
        LoopHome.iv_nn = 0
        LoopHome.iv_lo = 0
        LoopHome.iv_hi = 0
        LoopHome.iv_step = 0
        LoopHome.iv_at = 0
        LoopHome.prod_on = 0
        LoopHome.prod_c = 0
        LoopHome.prod_delta = 0
        LoopHome.prod_bad = 0
        LoopHome.prod_seen = 0
        LoopHome.prod_tmp = 0
        LoopHome.pin_n = 0
        LoopHome.pin_hit = 0
        LoopHome.kmul_on = 0
        LoopHome.kmul_name = 0
        LoopHome.kmul_off = 0
        LoopHome.ihold_on = 0
        LoopHome.ihold_name = 0
        LoopHome.ihold_off = 0
        LoopHome.ihold_reg = 0
        LoopHome.rbx_scratch = 0
        LoopHome.fwd_on = 0
        LoopHome.fwd_name = 0
        LoopHome.fwd_slot = 0
        LoopHome.fwd_use = 0
        LoopHome.sse_scratch = 0
        LoopHome.rax_on = 0
        LoopHome.rax_cand = 0
        LoopHome.rax_fresh = 0
        LoopHome.rax_name = 0
        LoopHome.trip_on = 0
        LoopHome.trip_reg = 0
        LoopHome.trip_span = 0
        LoopHome.trip_exit = 0
        LoopHome.st_on = 0
        LoopHome.st_off = 0
        LoopHome.st_idx = 0
        LoopHome.st_base = 0
        LoopHome.st_shift = 0
        LoopHome.st_disp = 0
        LoopHome.rcx_on = 0
        LoopHome.rcx_name = 0
        LoopHome.rcx_base = 0
        LoopHome.off_skip = 0
        LoopHome.rdx_on = 0
        LoopHome.rdx_name = 0
        Optimize_AliasClearAll()
        Optimize_PtrClearAll()
        Optimize_IpClear()
        IfCondition EqualTo(LoopHome.recs, 0) ThenBlock: {
            LoopHome.recs = Allocate(3072)
        }
        Optimize_HomeWalk(condition)
        Optimize_HomeWalk(body)
        IfCondition EqualTo(LoopHome.blocked, 1) ThenBlock: {
            LoopHome.int_name = 0
            LoopHome.flt_name = 0
            LoopHome.acc_name = 0
            LoopHome.rld_count = 0
            LoopHome.tab_on = 0
            LoopHome.pin_n = 0
            LoopHome.pin_hit = 0
            LoopHome.kmul_on = 0
            LoopHome.kmul_name = 0
            LoopHome.kmul_off = 0
            LoopHome.ihold_on = 0
            LoopHome.ihold_name = 0
            LoopHome.ihold_off = 0
            LoopHome.ihold_reg = 0
            LoopHome.rbx_scratch = 0
            LoopHome.fwd_on = 0
            LoopHome.fwd_name = 0
            LoopHome.fwd_slot = 0
            LoopHome.fwd_use = 0
            LoopHome.sse_scratch = 0
            LoopHome.rax_on = 0
            LoopHome.rax_cand = 0
            LoopHome.rax_fresh = 0
            LoopHome.rax_name = 0
            LoopHome.trip_on = 0
            LoopHome.trip_reg = 0
            LoopHome.trip_span = 0
            LoopHome.trip_exit = 0
            ReturnValue(0)
        }
        // A call that cannot reach this back edge still spills when it runs.
        // Keeping has_call set was pinning the whole probe in the frame.
        IfCondition EqualTo(Optimize_EdgeBad(condition, body), 0) ThenBlock: {
            LoopHome.has_call = 0
        }
        LoopHome.body = body
        LoopHome.cond = condition
        Optimize_HomePick()
        Optimize_AliasClearAll()
        LoopHome.hold_on = 0
        LoopHome.hold_name = 0
        have = 0
        IfCondition NotEqual(LoopHome.int_name, 0) ThenBlock: { have = 1 }
        IfCondition NotEqual(LoopHome.flt_name, 0) ThenBlock: { have = 1 }
        IfCondition NotEqual(LoopHome.acc_name, 0) ThenBlock: { have = 1 }
        // Extras published so far fill f2 first. TakeFlt has not run yet.
        IfCondition EqualTo(Optimize_ExtraAny(), 1) ThenBlock: { have = 1 }
        Optimize_ScanTable(body)
        Optimize_PickByteBase(body)
        Optimize_PickStride(body)
        IfCondition EqualTo(LoopHome.tab_on, 1) ThenBlock: { have = 1 }
        IfCondition EqualTo(LoopHome.st_on, 1) ThenBlock: { have = 1 }
        IfCondition EqualTo(have, 0) ThenBlock: { ReturnValue(0) }
        Optimize_ScanBody(body)
        Optimize_ScanCondTemps(condition, body)
        Optimize_ScanLimit(condition)
        Optimize_AliasClearAll()
        LoopHome.hold_on = 0
        LoopHome.hold_name = 0
        Optimize_PickInvariant(condition, body)
        Optimize_FindStep(body)
        Optimize_NoteIv(condition, body)
        Optimize_PickDerived(body)
        Optimize_PickIp(condition, body)
        Optimize_PickAddr(condition, body)
        Optimize_PickReload(body)
        Optimize_NoteProd()
        Optimize_PickKmul(condition, body)
        Optimize_NoteRbxScratch(condition, body)
        Optimize_AllocPublish()
        ReturnValue(1)
    }
}

Function.Optimize_ReadImm {
    Input: node: Address
    Output: Integer
    Body: {
        LoopHome.imm_ok = 0
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        nt = AST_GetType(node)
        IfCondition NotEqual(nt, AST.NUMBER) ThenBlock: { ReturnValue(0) }
        val = StringToNumber(AST_GetData1(node))
        IfCondition LessThan(val, 0) ThenBlock: { ReturnValue(0) }
        LoopHome.imm_ok = 1
        LoopHome.imm_val = val
        ReturnValue(1)
    }
}

Function.Optimize_TryHomeAssign {
    Input: target_name: Address
    Input: value_node: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(Optimize_IsIntHome(target_name), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(value_node, 0) ThenBlock: { ReturnValue(0) }
        vt = AST_GetType(value_node)
        IfCondition NotEqual(vt, AST.CALL) ThenBlock: { ReturnValue(0) }
        opname = AST_GetData1(value_node)
        is_add = 0
        is_sub = 0
        IfCondition EqualTo(StringCompare(opname, "Add"), 0) ThenBlock: { is_add = 1 }
        IfCondition EqualTo(StringCompare(opname, "Subtract"), 0) ThenBlock: { is_sub = 1 }
        IfCondition EqualTo(is_add, 0) ThenBlock: {
            IfCondition EqualTo(is_sub, 0) ThenBlock: { ReturnValue(0) }
        }
        IfCondition NotEqual(AST_GetChildCount(value_node), 2) ThenBlock: { ReturnValue(0) }
        a0 = AST_GetChild(value_node, 0)
        a1 = AST_GetChild(value_node, 1)
        imm_side = -1
        IfCondition EqualTo(Optimize_ReadImm(a1), 1) ThenBlock: {
            imm_side = 1
        } ElseBlock: {
            IfCondition EqualTo(Optimize_ReadImm(a0), 1) ThenBlock: {
                imm_side = 0
            }
        }
        IfCondition LessThan(imm_side, 0) ThenBlock: { ReturnValue(0) }
        other = a0
        IfCondition EqualTo(imm_side, 0) ThenBlock: { other = a1 }
        IfCondition EqualTo(other, 0) ThenBlock: { ReturnValue(0) }
        ot = AST_GetType(other)
        IfCondition NotEqual(ot, AST.IDENTIFIER) ThenBlock: { ReturnValue(0) }
        oname = AST_GetData1(other)
        IfCondition NotEqual(StringCompare(oname, target_name), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(is_sub, 1) ThenBlock: {
            IfCondition NotEqual(imm_side, 1) ThenBlock: { ReturnValue(0) }
        }
        // ADD/SUB r13, imm64 does not exist. Fail before any emit.
        IfCondition EqualTo(Optimize_Fit32(LoopHome.imm_val), 0) ThenBlock: { ReturnValue(0) }
        Optimize_AliasOnCursor()
        // r13 holds the pointer end while a trip loop is running.
        IfCondition EqualTo(LoopHome.trip_on, 0) ThenBlock: {
            IfCondition EqualTo(is_add, 1) ThenBlock: { Emit_HomeMove(3, LoopHome.imm_val) }
            IfCondition EqualTo(is_sub, 1) ThenBlock: { Emit_HomeMove(4, LoopHome.imm_val) }
        }
        // Induction pointers step with the same cursor add.
        IfCondition EqualTo(is_add, 1) ThenBlock: {
            IfCondition EqualTo(LoopHome.imm_val, LoopHome.iv_step) ThenBlock: {
                Optimize_IpBump()
            }
        }
        // The derived sum steps with the cursor. Wrapping add matches.
        IfCondition EqualTo(LoopHome.der_on, 1) ThenBlock: {
            IfCondition EqualTo(is_add, 1) ThenBlock: {
                IfCondition EqualTo(LoopHome.imm_val, LoopHome.der_step) ThenBlock: {
                    step_txt = NumberToString(LoopHome.der_step)
                    step_asm = StringConcat("ADD r11, ", step_txt)
                    X86Enc_Assemble(step_asm)
                }
            }
        }
        // The product steps with the same cursor add. Uses before this
        // statement still see the old product.
        IfCondition EqualTo(LoopHome.prod_on, 1) ThenBlock: {
            IfCondition EqualTo(is_add, 1) ThenBlock: {
                IfCondition EqualTo(LoopHome.imm_val, LoopHome.iv_step) ThenBlock: {
                    Optimize_EmitProdBump()
                }
            }
        }
        ReturnValue(1)
    }
}

// Register-register Add/Subtract. All three names (target, arg0, arg1)
// must be GPR-homed integers in the location table.
Function.Optimize_TryLocArith {
    Input: target_name: Address
    Input: value_node: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(LoopHome.active, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(value_node, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(value_node), AST.CALL) ThenBlock: { ReturnValue(0) }
        opname = AST_GetData1(value_node)
        is_add = 0
        is_sub = 0
        IfCondition EqualTo(StringCompare(opname, "Add"), 0) ThenBlock: { is_add = 1 }
        IfCondition EqualTo(StringCompare(opname, "Subtract"), 0) ThenBlock: { is_sub = 1 }
        IfCondition EqualTo(is_add, 0) ThenBlock: {
            IfCondition EqualTo(is_sub, 0) ThenBlock: { ReturnValue(0) }
        }
        IfCondition NotEqual(AST_GetChildCount(value_node), 2) ThenBlock: { ReturnValue(0) }
        a0 = AST_GetChild(value_node, 0)
        a1 = AST_GetChild(value_node, 1)
        IfCondition NotEqual(AST_GetType(a0), AST.IDENTIFIER) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(a1), AST.IDENTIFIER) ThenBlock: { ReturnValue(0) }
        name0 = AST_GetData1(a0)
        name1 = AST_GetData1(a1)

        IfCondition EqualTo(Optimize_Loc(target_name), 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AllocTab.hit_class, 1) ThenBlock: { ReturnValue(0) }
        dst_reg = AllocTab.hit_reg
        dst_off = AllocTab.hit_off
        IfCondition EqualTo(dst_reg, 13) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(dst_reg, 3)  ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(LoopHome.der_on, 1) ThenBlock: {
            IfCondition EqualTo(dst_reg, 11) ThenBlock: {
                IfCondition EqualTo(Optimize_NameEq(target_name, LoopHome.der_name), 1) ThenBlock: {
                    ReturnValue(0)
                }
            }
        }
        dst_name = 0
        IfCondition EqualTo(dst_reg, 11) ThenBlock: { dst_name = "r11" }
        IfCondition EqualTo(dst_reg, 12) ThenBlock: { dst_name = "r12" }
        IfCondition EqualTo(dst_reg, 14) ThenBlock: { dst_name = "r14" }
        IfCondition EqualTo(dst_name, 0) ThenBlock: { ReturnValue(0) }

        IfCondition EqualTo(Optimize_Loc(name0), 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AllocTab.hit_class, 1) ThenBlock: { ReturnValue(0) }
        reg0 = AllocTab.hit_reg
        rn0 = 0
        IfCondition EqualTo(reg0, 11) ThenBlock: { rn0 = "r11" }
        IfCondition EqualTo(reg0, 12) ThenBlock: { rn0 = "r12" }
        IfCondition EqualTo(reg0, 13) ThenBlock: { rn0 = "r13" }
        IfCondition EqualTo(reg0, 14) ThenBlock: { rn0 = "r14" }
        IfCondition EqualTo(rn0, 0) ThenBlock: { ReturnValue(0) }

        IfCondition EqualTo(Optimize_Loc(name1), 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AllocTab.hit_class, 1) ThenBlock: { ReturnValue(0) }
        reg1 = AllocTab.hit_reg
        rn1 = 0
        IfCondition EqualTo(reg1, 11) ThenBlock: { rn1 = "r11" }
        IfCondition EqualTo(reg1, 12) ThenBlock: { rn1 = "r12" }
        IfCondition EqualTo(reg1, 13) ThenBlock: { rn1 = "r13" }
        IfCondition EqualTo(reg1, 14) ThenBlock: { rn1 = "r14" }
        IfCondition EqualTo(rn1, 0) ThenBlock: { ReturnValue(0) }

        // shape: 0 = target is arg0, 1 = target is arg1 (Add only), 2 = distinct
        shape = 2
        IfCondition EqualTo(StringCompare(target_name, name0), 0) ThenBlock: { shape = 0 }
        IfCondition EqualTo(shape, 2) ThenBlock: {
            IfCondition EqualTo(is_add, 1) ThenBlock: {
                IfCondition EqualTo(StringCompare(target_name, name1), 0) ThenBlock: { shape = 1 }
            }
        }
        // target = Sub(x, target) can't be done without a temp — bail out
        IfCondition EqualTo(is_sub, 1) ThenBlock: {
            IfCondition EqualTo(shape, 2) ThenBlock: {
                IfCondition EqualTo(StringCompare(target_name, name1), 0) ThenBlock: { ReturnValue(0) }
            }
        }

        IfCondition GreaterThan(PinDefer.n, 0) ThenBlock: { Optimize_PinFlush() }
        Optimize_RaxDrop()

        op = "ADD "
        IfCondition EqualTo(is_sub, 1) ThenBlock: { op = "SUB " }

        IfCondition EqualTo(shape, 0) ThenBlock: {
            asm = StringConcat(op, StringConcat(dst_name, StringConcat(", ", rn1)))
            X86Enc_Assemble(asm)
        }
        IfCondition EqualTo(shape, 1) ThenBlock: {
            asm = StringConcat("ADD ", StringConcat(dst_name, StringConcat(", ", rn0)))
            X86Enc_Assemble(asm)
        }
        IfCondition EqualTo(shape, 2) ThenBlock: {
            mov_asm = StringConcat("MOV ", StringConcat(dst_name, StringConcat(", ", rn0)))
            X86Enc_Assemble(mov_asm)
            asm = StringConcat(op, StringConcat(dst_name, StringConcat(", ", rn1)))
            X86Enc_Assemble(asm)
        }

        Optimize_AliasClear(target_name)
        ReturnValue(1)
    }
}

// Add(home, imm) or Add(imm, home). Leaves the step in imm_val.
Function.Optimize_HomeStep {
    Input: node: Address
    Input: home_name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(node), AST.CALL) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(StringCompare(AST_GetData1(node), "Add"), 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetChildCount(node), 2) ThenBlock: { ReturnValue(0) }
        a0 = AST_GetChild(node, 0)
        a1 = AST_GetChild(node, 1)
        imm_side = -1
        IfCondition EqualTo(Optimize_ReadImm(a1), 1) ThenBlock: {
            imm_side = 1
        } ElseBlock: {
            IfCondition EqualTo(Optimize_ReadImm(a0), 1) ThenBlock: {
                imm_side = 0
            }
        }
        IfCondition LessThan(imm_side, 0) ThenBlock: { ReturnValue(0) }
        other = a0
        IfCondition EqualTo(imm_side, 0) ThenBlock: { other = a1 }
        IfCondition EqualTo(other, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(other), AST.IDENTIFIER) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(StringCompare(AST_GetData1(other), home_name), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_Fit32(LoopHome.imm_val), 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(1)
    }
}

// home = BitwiseAnd(Add(home, imm), frame). r13 stays the home.
// AND r13, [rbp+disp] reads the frame, so a later store of that mask stays.
Function.Optimize_TryHomeMask {
    Input: target_name: Address
    Input: value_node: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(Optimize_IsIntHome(target_name), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(LoopHome.trip_on, 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(value_node, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(value_node), AST.CALL) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_IsAndName(AST_GetData1(value_node)), 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetChildCount(value_node), 2) ThenBlock: { ReturnValue(0) }
        a0 = AST_GetChild(value_node, 0)
        a1 = AST_GetChild(value_node, 1)
        step = -1
        mask_node = 0
        IfCondition EqualTo(Optimize_HomeStep(a0, target_name), 1) ThenBlock: {
            step = LoopHome.imm_val
            mask_node = a1
        }
        IfCondition LessThan(step, 0) ThenBlock: {
            IfCondition EqualTo(Optimize_HomeStep(a1, target_name), 1) ThenBlock: {
                step = LoopHome.imm_val
                mask_node = a0
            }
        }
        IfCondition LessThan(step, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_FrameCmpFresh(mask_node), 0) ThenBlock: { ReturnValue(0) }
        disp = LoopHome.imm_val
        Optimize_AliasOnCursor()
        Emit_HomeMove(3, step)
        X86_AndR13Mem(disp)
        ReturnValue(1)
    }
}

Function.Optimize_TryHomeDeref {
    Input: arg: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(LoopHome.active, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_CursorDisp(arg), 0) ThenBlock: { ReturnValue(0) }
        Emit_HomeMove(12, LoopHome.imm_val)
        ReturnValue(1)
    }
}

// A frame local that is not itself a home, a hold, or an r13 alias.
// FrameOff leaves the negative RBP offset in LoopHome.imm_val.
Function.Optimize_FrameCmpOk {
    Input: node: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(node), AST.IDENTIFIER) ThenBlock: { ReturnValue(0) }
        name = AST_GetData1(node)
        IfCondition EqualTo(Optimize_IsIntHome(name), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_IsAccHome(name), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_IsFltHome(name), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_IsXmmHold(node), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_AliasFind(name), 1) ThenBlock: { ReturnValue(0) }
        ReturnValue(Optimize_FrameOff(name))
    }
}

// A compare just left this frame local in RAX. Homes stay in their registers.
// Commit publishes it only after the branch jump, so a later load can skip
// the frame reload while Emit.code_size is still the commit point.
Function.Optimize_RaxCandidate {
    Input: node: Address
    Output: Integer
    Body: {
        LoopHome.rax_cand = 0
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(node), AST.IDENTIFIER) ThenBlock: { ReturnValue(0) }
        name = AST_GetData1(node)
        IfCondition EqualTo(Optimize_IsIntHome(name), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_IsAccHome(name), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_IsFltHome(name), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_FrameOff(name), 0) ThenBlock: { ReturnValue(0) }
        LoopHome.rax_name = name
        LoopHome.rax_off = LoopHome.imm_val
        LoopHome.rax_cand = 1
        ReturnValue(1)
    }
}

Function.Optimize_RaxCommit {
    Output: Integer
    Body: {
        IfCondition EqualTo(LoopHome.rax_cand, 0) ThenBlock: {
            LoopHome.rax_fresh = 0
            ReturnValue(0)
        }
        LoopHome.rax_on = 1
        LoopHome.rax_pos = Emit.code_size
        LoopHome.rax_fresh = 1
        LoopHome.rax_cand = 0
        ReturnValue(1)
    }
}

Function.Optimize_RaxDrop {
    Output: Integer
    Body: {
        LoopHome.rax_on = 0
        LoopHome.rax_fresh = 0
        LoopHome.rax_cand = 0
        ReturnValue(0)
    }
}

// 1 when RAX still holds this local. Every rax-writing path calls
// RaxDrop, so the latch survives across non-rax instructions.
// A deferred pin may hold a newer store, so the frame load stays.
Function.Optimize_RaxTake {
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(LoopHome.rax_on, 0) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterThan(PinDefer.n, 0) ThenBlock: {
            LoopHome.rax_on = 0
            ReturnValue(0)
        }
        IfCondition EqualTo(Optimize_NameEq(name, LoopHome.rax_name), 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(1)
    }
}

Function.Optimize_RaxPin {
    Input: name: Address
    Input: off: Integer
    Output: Integer
    Body: {
        LoopHome.rax_name = name
        LoopHome.rax_off = off
        LoopHome.rax_on = 1
        LoopHome.rax_pos = Emit.code_size
        LoopHome.rax_fresh = 1
        LoopHome.rax_cand = 0
        ReturnValue(1)
    }
}

// A frame store just wrote rax. Remember it for the next load of this
// name. rax_fresh stays off so a branch does not treat rax as its compare.
Function.Optimize_RaxStored {
    Input: name: Address
    Input: off: Integer
    Output: Integer
    Body: {
        IfCondition GreaterThan(PinDefer.n, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }
        Optimize_RaxPin(name, off)
        LoopHome.rax_fresh = 0
        ReturnValue(1)
    }
}

// 1 when control cannot fall out of this node. An If can, because the
// false arm continues, so only a return, break, or continue counts.
Function.Optimize_NoFall {
    Input: node: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        t = AST_GetType(node)
        IfCondition EqualTo(t, AST.RETURN) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(t, AST.EXIT_LOOP) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(t, AST.CONTINUE_LOOP) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(t, AST.BLOCK) ThenBlock: {
            n = AST_GetChildCount(node)
            i = 0
            WhileLoop LessThan(i, n) {
                ch = AST_GetChild(node, i)
                IfCondition NotEqual(ch, 0) ThenBlock: {
                    IfCondition EqualTo(Optimize_NoFall(ch), 1) ThenBlock: { ReturnValue(1) }
                }
                i = Add(i, 1)
            }
        }
        ReturnValue(0)
    }
}

// 1 when this branch compare loads name first and leaves it in RAX.
// The left side is the identifier. The right side is a signed imm32 or a
// frame local, so nothing is emitted before that load and the frame slot
// of name is not read.
Function.Optimize_CmpLeft {
    Input: cond: Address
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(cond, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(cond), AST.CALL) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_IsCompareName(AST_GetData1(cond)), 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetChildCount(cond), 2) ThenBlock: { ReturnValue(0) }
        left = AST_GetChild(cond, 0)
        right = AST_GetChild(cond, 1)
        IfCondition EqualTo(left, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(left), AST.IDENTIFIER) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_NameEq(AST_GetData1(left), name), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_TreeHasIdent(right, name), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(AST_GetType(right), AST.NUMBER) ThenBlock: {
            ReturnValue(Optimize_Fit32(StringToNumber(AST_GetData1(right))))
        }
        IfCondition NotEqual(AST_GetType(right), AST.IDENTIFIER) ThenBlock: { ReturnValue(0) }
        ReturnValue(Optimize_FrameCmpOk(right))
    }
}

// Walk statements from index. 2 when every later read of name is a branch
// compare the RAX note can satisfy, and at least one such compare exists.
// 1 when those statements do not read name. 0 when a read would reload
// the frame. pending is 1 when RAX still holds name at this statement.
Function.Optimize_CmpChain {
    Input: block: Address
    Input: index: Integer
    Input: name: Address
    Input: pending: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(Optimize_FoldIsBlock(block), 0) ThenBlock: { ReturnValue(0) }
        count = AST_GetChildCount(block)
        i = index
        saw = 0
        WhileLoop LessThan(i, count) {
            st = AST_GetChild(block, i)
            IfCondition NotEqual(st, 0) ThenBlock: {
                mentioned = Optimize_TreeHasName(st, name)
                IfCondition EqualTo(mentioned, 0) ThenBlock: {
                    pending = 0
                } ElseBlock: {
                    IfCondition EqualTo(pending, 0) ThenBlock: { ReturnValue(0) }
                    killed = 0
                    IfCondition EqualTo(Optimize_PlainAssign(st), 1) ThenBlock: {
                        IfCondition EqualTo(Optimize_NameEq(AST_GetData1(st), name), 1) ThenBlock: {
                            IfCondition EqualTo(Optimize_NodeReads(AST_GetChild(st, 0), name), 0) ThenBlock: {
                                killed = 1
                            }
                        }
                    }
                    IfCondition EqualTo(killed, 1) ThenBlock: {
                        IfCondition EqualTo(saw, 1) ThenBlock: { ReturnValue(2) }
                        ReturnValue(1)
                    }
                    IfCondition NotEqual(AST_GetType(st), AST.IF) ThenBlock: { ReturnValue(0) }
                    IfCondition EqualTo(Optimize_CmpLeft(AST_GetChild(st, 0), name), 0) ThenBlock: { ReturnValue(0) }
                    saw = 1
                    then_b = AST_GetChild(st, 1)
                    IfCondition NotEqual(then_b, 0) ThenBlock: {
                        IfCondition EqualTo(Optimize_TreeHasName(then_b, name), 1) ThenBlock: {
                            sub = Optimize_CmpChain(then_b, 0, name, 1)
                            IfCondition EqualTo(sub, 0) ThenBlock: { ReturnValue(0) }
                        }
                    }
                    else_b = 0
                    IfCondition GreaterThan(AST_GetChildCount(st), 2) ThenBlock: {
                        else_b = AST_GetChild(st, 2)
                    }
                    else_uses = 0
                    IfCondition NotEqual(else_b, 0) ThenBlock: {
                        IfCondition EqualTo(Optimize_TreeHasName(else_b, name), 1) ThenBlock: {
                            else_uses = 1
                        }
                    }
                    IfCondition EqualTo(else_uses, 1) ThenBlock: {
                        IfCondition EqualTo(Optimize_NoFall(then_b), 0) ThenBlock: { ReturnValue(0) }
                        sub_e = Optimize_CmpChain(else_b, 0, name, 1)
                        IfCondition EqualTo(sub_e, 0) ThenBlock: { ReturnValue(0) }
                    }
                    // An else joins and drops the note. A then that falls
                    // through drops it too. A return leaves RAX at the false label.
                    IfCondition NotEqual(else_b, 0) ThenBlock: {
                        pending = 0
                    } ElseBlock: {
                        IfCondition EqualTo(Optimize_NoFall(then_b), 1) ThenBlock: {
                            pending = 1
                        } ElseBlock: {
                            pending = 0
                        }
                    }
                }
            }
            i = Add(i, 1)
        }
        IfCondition EqualTo(saw, 1) ThenBlock: { ReturnValue(2) }
        ReturnValue(1)
    }
}

// The value is already in RAX. Skip the frame store when every later read
// is a compare that loads this name before emitting anything else. A read
// the note cannot satisfy still stores, so the frame slot stays current.
Function.Optimize_TryCmpSkip {
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(LoopHome.ihold_on, 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(LoopHome.hold_on, 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(LoopHome.fwd_on, 1) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterThan(PinDefer.n, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_IsIntHome(name), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_IsAccHome(name), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_IsFltHome(name), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_AliasFind(name), 1) ThenBlock: { ReturnValue(0) }
        off = Optimize_EnsureSlot(name)
        IfCondition EqualTo(off, 0) ThenBlock: { ReturnValue(0) }
        block = OutKeep.block
        IfCondition EqualTo(Optimize_FoldIsBlock(block), 0) ThenBlock: { ReturnValue(0) }
        at = OutKeep.at
        IfCondition LessThan(at, 0) ThenBlock: { ReturnValue(0) }
        here = AST_GetChild(block, at)
        IfCondition EqualTo(Optimize_PlainAssign(here), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_NameEq(AST_GetData1(here), name), 0) ThenBlock: { ReturnValue(0) }
        k = 0
        WhileLoop LessThan(k, at) {
            IfCondition EqualTo(Optimize_NodeReads(AST_GetChild(block, k), name), 1) ThenBlock: {
                ReturnValue(0)
            }
            k = Add(k, 1)
        }
        IfCondition EqualTo(Compile.current_func, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_LiveEscape(Compile.current_func, name), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_OutsideHit(Compile.current_func, name, block), 1) ThenBlock: { ReturnValue(0) }
        chained = Optimize_CmpChain(block, Add(at, 1), name, 1)
        IfCondition NotEqual(chained, 2) ThenBlock: { ReturnValue(0) }
        Optimize_RaxPin(name, off)
        ReturnValue(1)
    }
}

// 1 when compiling this node cannot write RDX. Add and Subtract are
// ADD/SUB/LEA. A compare is CMP/TEST. A dereference is a load into RAX.
// Multiply, divide, modulo, and calls are not on this list.
Function.Optimize_RdxSafe {
    Input: node: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(1) }
        nt = AST_GetType(node)
        IfCondition EqualTo(nt, AST.NUMBER) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(nt, AST.IDENTIFIER) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(nt, AST.STRING) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(nt, AST.BOOLEAN) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(nt, AST.NULL) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(nt, AST.CONTINUE_LOOP) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(nt, AST.EXIT_LOOP) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(nt, AST.RETURN) ThenBlock: {
            IfCondition LessThan(AST_GetChildCount(node), 1) ThenBlock: { ReturnValue(1) }
            ReturnValue(Optimize_RdxSafe(AST_GetChild(node, 0)))
        }
        IfCondition EqualTo(nt, AST.BLOCK) ThenBlock: {
            n = AST_GetChildCount(node)
            i = 0
            WhileLoop LessThan(i, n) {
                IfCondition EqualTo(Optimize_RdxSafe(AST_GetChild(node, i)), 0) ThenBlock: {
                    ReturnValue(0)
                }
                i = Add(i, 1)
            }
            ReturnValue(1)
        }
        IfCondition EqualTo(nt, AST.IF) ThenBlock: {
            IfCondition EqualTo(Optimize_RdxSafe(AST_GetChild(node, 0)), 0) ThenBlock: { ReturnValue(0) }
            IfCondition EqualTo(Optimize_RdxSafe(AST_GetChild(node, 1)), 0) ThenBlock: { ReturnValue(0) }
            IfCondition GreaterThan(AST_GetChildCount(node), 2) ThenBlock: {
                IfCondition EqualTo(Optimize_RdxSafe(AST_GetChild(node, 2)), 0) ThenBlock: { ReturnValue(0) }
            }
            ReturnValue(1)
        }
        IfCondition EqualTo(nt, AST.ASSIGNMENT) ThenBlock: {
            IfCondition EqualTo(Optimize_PlainAssign(node), 0) ThenBlock: { ReturnValue(0) }
            ReturnValue(Optimize_RdxSafe(AST_GetChild(node, 0)))
        }
        IfCondition NotEqual(nt, AST.CALL) ThenBlock: { ReturnValue(0) }
        nm = AST_GetData1(node)
        IfCondition EqualTo(nm, 0) ThenBlock: { ReturnValue(0) }
        kind = 0
        IfCondition EqualTo(StringCompare(nm, "Add"), 0) ThenBlock: { kind = 1 }
        IfCondition EqualTo(StringCompare(nm, "Subtract"), 0) ThenBlock: { kind = 1 }
        IfCondition EqualTo(Optimize_IsCompareName(nm), 1) ThenBlock: { kind = 1 }
        IfCondition EqualTo(StringCompare(nm, "Dereference"), 0) ThenBlock: { kind = 2 }
        IfCondition EqualTo(kind, 0) ThenBlock: { ReturnValue(0) }
        n = AST_GetChildCount(node)
        IfCondition EqualTo(kind, 2) ThenBlock: {
            IfCondition LessThan(n, 1) ThenBlock: { ReturnValue(0) }
            IfCondition GreaterThan(n, 2) ThenBlock: { ReturnValue(0) }
            ReturnValue(Optimize_RdxSafe(AST_GetChild(node, 0)))
        }
        IfCondition NotEqual(n, 2) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_RdxSafe(AST_GetChild(node, 0)), 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(Optimize_RdxSafe(AST_GetChild(node, 1)))
    }
}

// Same walk as CmpChain, but a statement that does not mention name keeps
// the note when it cannot write RDX. A then that falls through keeps it
// only when that then cannot write RDX. A return does not join.
Function.Optimize_RdxChain {
    Input: block: Address
    Input: index: Integer
    Input: name: Address
    Input: pending: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(Optimize_FoldIsBlock(block), 0) ThenBlock: { ReturnValue(0) }
        count = AST_GetChildCount(block)
        i = index
        saw = 0
        WhileLoop LessThan(i, count) {
            st = AST_GetChild(block, i)
            IfCondition NotEqual(st, 0) ThenBlock: {
                mentioned = Optimize_TreeHasName(st, name)
                IfCondition EqualTo(mentioned, 0) ThenBlock: {
                    IfCondition EqualTo(Optimize_RdxSafe(st), 0) ThenBlock: {
                        pending = 0
                    }
                } ElseBlock: {
                    IfCondition EqualTo(pending, 0) ThenBlock: { ReturnValue(0) }
                    killed = 0
                    IfCondition EqualTo(Optimize_PlainAssign(st), 1) ThenBlock: {
                        IfCondition EqualTo(Optimize_NameEq(AST_GetData1(st), name), 1) ThenBlock: {
                            IfCondition EqualTo(Optimize_NodeReads(AST_GetChild(st, 0), name), 0) ThenBlock: {
                                killed = 1
                            }
                        }
                    }
                    IfCondition EqualTo(killed, 1) ThenBlock: {
                        IfCondition EqualTo(saw, 1) ThenBlock: { ReturnValue(2) }
                        ReturnValue(1)
                    }
                    IfCondition NotEqual(AST_GetType(st), AST.IF) ThenBlock: { ReturnValue(0) }
                    IfCondition EqualTo(Optimize_CmpLeft(AST_GetChild(st, 0), name), 0) ThenBlock: { ReturnValue(0) }
                    saw = 1
                    then_b = AST_GetChild(st, 1)
                    IfCondition NotEqual(then_b, 0) ThenBlock: {
                        IfCondition EqualTo(Optimize_TreeHasName(then_b, name), 1) ThenBlock: {
                            sub = Optimize_RdxChain(then_b, 0, name, 1)
                            IfCondition EqualTo(sub, 0) ThenBlock: { ReturnValue(0) }
                        }
                    }
                    else_b = 0
                    IfCondition GreaterThan(AST_GetChildCount(st), 2) ThenBlock: {
                        else_b = AST_GetChild(st, 2)
                    }
                    else_uses = 0
                    IfCondition NotEqual(else_b, 0) ThenBlock: {
                        IfCondition EqualTo(Optimize_TreeHasName(else_b, name), 1) ThenBlock: {
                            else_uses = 1
                        }
                    }
                    IfCondition EqualTo(else_uses, 1) ThenBlock: {
                        sub_e = Optimize_RdxChain(else_b, 0, name, 1)
                        IfCondition EqualTo(sub_e, 0) ThenBlock: { ReturnValue(0) }
                    }
                    preserve = 1
                    IfCondition EqualTo(Optimize_AlwaysReturns(then_b), 0) ThenBlock: {
                        IfCondition EqualTo(Optimize_RdxSafe(then_b), 0) ThenBlock: {
                            preserve = 0
                        }
                    }
                    IfCondition NotEqual(else_b, 0) ThenBlock: {
                        IfCondition EqualTo(Optimize_AlwaysReturns(else_b), 0) ThenBlock: {
                            IfCondition EqualTo(Optimize_RdxSafe(else_b), 0) ThenBlock: {
                                preserve = 0
                            }
                        }
                    }
                    pending = preserve
                }
            }
            i = Add(i, 1)
        }
        IfCondition EqualTo(saw, 1) ThenBlock: { ReturnValue(2) }
        ReturnValue(1)
    }
}

// The value is already in RAX. Park it in RDX and skip the frame store
// when every later read is a compare and the statements in between cannot
// write RDX. RAX is then free for the next load.
Function.Optimize_TryRdxSkip {
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(LoopHome.rdx_on, 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(LoopHome.ihold_on, 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(LoopHome.hold_on, 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(LoopHome.fwd_on, 1) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterThan(PinDefer.n, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_IsIntHome(name), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_IsAccHome(name), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_IsFltHome(name), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_AliasFind(name), 1) ThenBlock: { ReturnValue(0) }
        off = Optimize_EnsureSlot(name)
        IfCondition EqualTo(off, 0) ThenBlock: { ReturnValue(0) }
        block = OutKeep.block
        IfCondition EqualTo(Optimize_FoldIsBlock(block), 0) ThenBlock: { ReturnValue(0) }
        at = OutKeep.at
        IfCondition LessThan(at, 0) ThenBlock: { ReturnValue(0) }
        here = AST_GetChild(block, at)
        IfCondition EqualTo(Optimize_PlainAssign(here), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_NameEq(AST_GetData1(here), name), 0) ThenBlock: { ReturnValue(0) }
        k = 0
        WhileLoop LessThan(k, at) {
            IfCondition EqualTo(Optimize_NodeReads(AST_GetChild(block, k), name), 1) ThenBlock: {
                ReturnValue(0)
            }
            k = Add(k, 1)
        }
        IfCondition EqualTo(Compile.current_func, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_LiveEscape(Compile.current_func, name), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_OutsideHit(Compile.current_func, name, block), 1) ThenBlock: { ReturnValue(0) }
        chained = Optimize_RdxChain(block, Add(at, 1), name, 1)
        IfCondition NotEqual(chained, 2) ThenBlock: { ReturnValue(0) }
        Emit_MovRegReg(Reg.RDX, Reg.RAX)
        LoopHome.rdx_on = 1
        LoopHome.rdx_name = name
        ReturnValue(1)
    }
}

// 1 when this load would read a frame slot that was never stored.
Function.Optimize_RdxMiss {
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(LoopHome.rdx_on, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_NameEq(name, LoopHome.rdx_name), 0) ThenBlock: { ReturnValue(0) }
        Compile.error = 1
        ReturnValue(1)
    }
}

// The joining path clobbered RDX. Later compares must use the frame slot.
Function.Optimize_RdxDropJoin {
    Input: node: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(LoopHome.rdx_on, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_AlwaysReturns(node), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_RdxSafe(node), 1) ThenBlock: { ReturnValue(0) }
        LoopHome.rdx_on = 0
        LoopHome.rdx_name = 0
        ReturnValue(1)
    }
}

// Compare the parked local without loading it. 1 when the jump was emitted.
// 2 when the left is the parked name and the right is not an imm32 or a
// frame slot. 0 when this compare is not the parked name.
Function.Optimize_TryRdxCmp {
    Input: cmp_name: Address
    Input: arg0: Address
    Input: arg1: Address
    Input: false_label: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(LoopHome.rdx_on, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(arg0, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(arg0), AST.IDENTIFIER) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_NameEq(AST_GetData1(arg0), LoopHome.rdx_name), 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(arg1, 0) ThenBlock: {
            IfCondition EqualTo(AST_GetType(arg1), AST.NUMBER) ThenBlock: {
                imm = StringToNumber(AST_GetData1(arg1))
                IfCondition EqualTo(Optimize_Fit32(imm), 1) ThenBlock: {
                    X86_CmpRdxImm(imm)
                    Optimize_JumpIfFalse(cmp_name, false_label)
                    ReturnValue(1)
                }
            }
        }
        IfCondition EqualTo(Optimize_FrameCmpOk(arg1), 1) ThenBlock: {
            disp = LoopHome.imm_val
            X86_CmpRdxMem(disp)
            Optimize_JumpIfFalse(cmp_name, false_label)
            ReturnValue(1)
        }
        Compile.error = 1
        ReturnValue(2)
    }
}

// The frame slot matches the register. A value held only in a register does not.
Function.Optimize_FrameCmpFresh {
    Input: node: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(Optimize_FrameCmpOk(node), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(LoopHome.ihold_on, 1) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(AST_GetData1(node), LoopHome.ihold_name), 1) ThenBlock: {
                ReturnValue(0)
            }
        }
        ReturnValue(1)
    }
}

// Compare the r12 accumulator with a leaf. A limit parked in rbx stays there.
// side 0: other operand is the right hand. side 1: other operand is the left.
Function.Optimize_TryAccCompare {
    Input: other: Address
    Input: side: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(other, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_IsLeaf(other), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_ReadImm(other), 1) ThenBlock: {
            IfCondition LessEqual(LoopHome.imm_val, 2147483647) ThenBlock: {
                IfCondition EqualTo(side, 0) ThenBlock: {
                    Emit_HomeMove(46, LoopHome.imm_val)
                    ReturnValue(1)
                }
            }
        }
        lim_hit = 0
        IfCondition EqualTo(LoopHome.lim_on, 1) ThenBlock: {
            IfCondition EqualTo(AST_GetType(other), AST.IDENTIFIER) ThenBlock: {
                IfCondition EqualTo(Optimize_NameEq(AST_GetData1(other), LoopHome.lim_name), 1) ThenBlock: {
                    lim_hit = 1
                }
            }
        }
        IfCondition EqualTo(lim_hit, 1) ThenBlock: {
            IfCondition EqualTo(side, 0) ThenBlock: {
                Emit_HomeMove(44, 0)
                ReturnValue(1)
            }
            Emit_MovRaxRbx()
            Emit_HomeMove(45, 0)
            ReturnValue(1)
        }
        IfCondition EqualTo(Optimize_FrameCmpOk(other), 1) ThenBlock: {
            IfCondition EqualTo(side, 0) ThenBlock: {
                X86_CmpHomeMem(12, LoopHome.imm_val, 0)
                ReturnValue(1)
            }
            X86_CmpHomeMem(12, LoopHome.imm_val, 1)
            ReturnValue(1)
        }
        IfCondition EqualTo(LoopHome.lim_on, 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(side, 1) ThenBlock: {
            got = Compile_Expression(other)
            IfCondition EqualTo(got, 0) ThenBlock: { ReturnValue(0) }
            Emit_HomeMove(45, 0)
            ReturnValue(1)
        }
        got = Optimize_LoadToRbx(other)
        IfCondition EqualTo(got, 0) ThenBlock: { ReturnValue(0) }
        Emit_HomeMove(44, 0)
        ReturnValue(1)
    }
}

// Register number of a GPR row, or -1. Published before the loop is
// active. The only caller runs while the loop is active.
Function.Optimize_GprOf {
    Input: node: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition NotEqual(AST_GetType(node), AST.IDENTIFIER) ThenBlock: { ReturnValue(-1) }
        name = AST_GetData1(node)
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition EqualTo(LoopHome.active, 1) ThenBlock: {
            IfCondition EqualTo(Optimize_Loc(name), 1) ThenBlock: {
                IfCondition EqualTo(AllocTab.hit_class, 1) ThenBlock: {
                    ReturnValue(AllocTab.hit_reg)
                }
            }
        }
        ReturnValue(-1)
    }
}

Function.Optimize_TryHomeCompare {
    Input: arg0: Address
    Input: arg1: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(LoopHome.active, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(LoopHome.int_name, 0) ThenBlock: { ReturnValue(0) }
        lreg = Optimize_GprOf(arg0)
        rreg = Optimize_GprOf(arg1)
        IfCondition GreaterEqual(lreg, 0) ThenBlock: {
            IfCondition GreaterEqual(rreg, 0) ThenBlock: {
                X86_CmpRegReg(lreg, rreg)
                ReturnValue(1)
            }
        }
        left_home = 0
        right_home = 0
        IfCondition NotEqual(arg0, 0) ThenBlock: {
            IfCondition EqualTo(AST_GetType(arg0), AST.IDENTIFIER) ThenBlock: {
                IfCondition EqualTo(Optimize_IsIntHome(AST_GetData1(arg0)), 1) ThenBlock: { left_home = 1 }
            }
        }
        IfCondition NotEqual(arg1, 0) ThenBlock: {
            IfCondition EqualTo(AST_GetType(arg1), AST.IDENTIFIER) ThenBlock: {
                IfCondition EqualTo(Optimize_IsIntHome(AST_GetData1(arg1)), 1) ThenBlock: { right_home = 1 }
            }
        }
        left_acc = 0
        right_acc = 0
        IfCondition NotEqual(arg0, 0) ThenBlock: {
            IfCondition EqualTo(AST_GetType(arg0), AST.IDENTIFIER) ThenBlock: {
                IfCondition EqualTo(Optimize_IsAccHome(AST_GetData1(arg0)), 1) ThenBlock: { left_acc = 1 }
            }
        }
        IfCondition NotEqual(arg1, 0) ThenBlock: {
            IfCondition EqualTo(AST_GetType(arg1), AST.IDENTIFIER) ThenBlock: {
                IfCondition EqualTo(Optimize_IsAccHome(AST_GetData1(arg1)), 1) ThenBlock: { right_acc = 1 }
            }
        }
        IfCondition EqualTo(left_acc, 1) ThenBlock: {
            IfCondition EqualTo(right_acc, 0) ThenBlock: {
                IfCondition EqualTo(left_home, 0) ThenBlock: {
                    IfCondition EqualTo(right_home, 0) ThenBlock: {
                        IfCondition EqualTo(Optimize_TryAccCompare(arg1, 0), 1) ThenBlock: { ReturnValue(1) }
                    }
                }
            }
        }
        IfCondition EqualTo(right_acc, 1) ThenBlock: {
            IfCondition EqualTo(left_acc, 0) ThenBlock: {
                IfCondition EqualTo(left_home, 0) ThenBlock: {
                    IfCondition EqualTo(right_home, 0) ThenBlock: {
                        IfCondition EqualTo(Optimize_TryAccCompare(arg0, 1), 1) ThenBlock: { ReturnValue(1) }
                    }
                }
            }
        }
        IfCondition EqualTo(left_home, right_home) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(left_home, 1) ThenBlock: {
            IfCondition EqualTo(Optimize_IsLeaf(arg1), 0) ThenBlock: { ReturnValue(0) }
            IfCondition EqualTo(Optimize_ReadImm(arg1), 1) ThenBlock: {
                IfCondition EqualTo(Optimize_Fit32(LoopHome.imm_val), 1) ThenBlock: {
                    Emit_HomeMove(15, LoopHome.imm_val)
                    ReturnValue(1)
                }
            }
            IfCondition EqualTo(LoopHome.rbx_free, 1) ThenBlock: {
                IfCondition EqualTo(LoopHome.lim_on, 1) ThenBlock: {
                    IfCondition EqualTo(AST_GetType(arg1), AST.IDENTIFIER) ThenBlock: {
                        IfCondition EqualTo(Optimize_NameEq(AST_GetData1(arg1), LoopHome.lim_name), 1) ThenBlock: {
                            Emit_HomeMove(13, 0)
                            ReturnValue(1)
                        }
                    }
                }
            }
            IfCondition EqualTo(Optimize_FrameCmpOk(arg1), 1) ThenBlock: {
                X86_CmpHomeMem(13, LoopHome.imm_val, 0)
                ReturnValue(1)
            }
            got = Optimize_LoadToRbx(arg1)
            IfCondition EqualTo(got, 0) ThenBlock: { ReturnValue(0) }
            Emit_HomeMove(13, 0)
            ReturnValue(1)
        }
        IfCondition EqualTo(Optimize_FrameCmpOk(arg0), 1) ThenBlock: {
            X86_CmpHomeMem(13, LoopHome.imm_val, 1)
            ReturnValue(1)
        }
        IfCondition EqualTo(Optimize_IsLeaf(arg0), 0) ThenBlock: { ReturnValue(0) }
        got = Compile_Expression(arg0)
        IfCondition EqualTo(got, 0) ThenBlock: { ReturnValue(0) }
        Emit_HomeMove(14, 0)
        ReturnValue(1)
    }
}

Function.Optimize_LoadLeafXmm {
    Input: node: Address
    Input: which: Integer
    Output: Integer
    Body: {
        node_type = AST_GetType(node)
        IfCondition EqualTo(node_type, AST.IDENTIFIER) ThenBlock: {
            name = AST_GetData1(node)
            IfCondition EqualTo(Optimize_IsFltHome(name), 1) ThenBlock: {
                slot = Optimize_FltSlot(name)
                IfCondition EqualTo(slot, 2) ThenBlock: {
                    IfCondition EqualTo(which, 0) ThenBlock: { Emit_HomeMove(7, 0) }
                    IfCondition EqualTo(which, 1) ThenBlock: { Emit_HomeMove(8, 0) }
                }
                IfCondition GreaterThan(slot, 2) ThenBlock: {
                    IfCondition EqualTo(which, 0) ThenBlock: { X86_XmmRR(3, slot) }
                    IfCondition EqualTo(which, 1) ThenBlock: { X86_XmmRR(8, slot) }
                }
                ReturnValue(1)
            }
            IfCondition EqualTo(Optimize_AliasFind(name), 1) ThenBlock: {
                IfCondition EqualTo(which, 0) ThenBlock: { Emit_HomeMove(24, LoopHome.hit_disp) }
                IfCondition EqualTo(which, 1) ThenBlock: { Emit_HomeMove(29, LoopHome.hit_disp) }
                ReturnValue(1)
            }
            IfCondition EqualTo(LoopHome.hold_on, 1) ThenBlock: {
                IfCondition EqualTo(Optimize_NameEq(name, LoopHome.hold_name), 1) ThenBlock: {
                    IfCondition EqualTo(which, 1) ThenBlock: { Emit_HomeMove(37, 0) }
                    ReturnValue(1)
                }
            }
            IfCondition EqualTo(Optimize_RldFind(name), 1) ThenBlock: {
                IfCondition EqualTo(LoopHome.rld_kind, 1) ThenBlock: {
                    X86_MovsdPtr(which, LoopHome.rld_reg, LoopHome.rld_disp)
                    ReturnValue(1)
                }
            }
        }
        result = Compile_Expression(node)
        IfCondition EqualTo(result, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(which, 0) ThenBlock: { Emit_HomeMove(11, 0) }
        IfCondition EqualTo(which, 1) ThenBlock: { Emit_HomeMove(10, 0) }
        ReturnValue(1)
    }
}

// The live xmm0 hold. Loading anything else first would replace it.
Function.Optimize_IsXmmHold {
    Input: node: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(LoopHome.hold_on, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(node), AST.IDENTIFIER) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_NameEq(AST_GetData1(node), LoopHome.hold_name), 1) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

// Result is left in xmm0 by the float emitter. Integer results are not.
Function.Optimize_FltProducer {
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(StringCompare(name, "Float_Add"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "Float_Sub"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "Float_Mul"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "Float_Div"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "Float_Min"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "Float_Max"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "Float_Neg"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "Float_Abs"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "Float_Sqrt"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "Float_FromInt"), 0) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

Function.Optimize_GprName {
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(StringCompare(name, "Add"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "Subtract"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "Multiply"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "Divide"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "Modulo"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "Negate"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "BitwiseAnd"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "BitwiseOr"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "BitwiseXor"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "BitwiseNot"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "LeftShift"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "RightShift"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "BitAnd"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "BitOr"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "BitXor"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "BitNot"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "ShiftLeft"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "ShiftRight"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "Dereference"), 0) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

// True when evaluating the node writes only general registers.
// xmm0 can keep the other operand of a float operation.
Function.Optimize_GprSafe {
    Input: node: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_IsXmmHold(node), 1) ThenBlock: { ReturnValue(0) }
        nt = AST_GetType(node)
        IfCondition EqualTo(nt, AST.NUMBER) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(nt, AST.IDENTIFIER) ThenBlock: { ReturnValue(1) }
        IfCondition NotEqual(nt, AST.CALL) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_GprName(AST_GetData1(node)), 0) ThenBlock: { ReturnValue(0) }
        count = AST_GetChildCount(node)
        i = 0
        ok = 1
        WhileLoop LessThan(i, count) {
            IfCondition EqualTo(Optimize_GprSafe(AST_GetChild(node, i)), 0) ThenBlock: { ok = 0 }
            i = Add(i, 1)
        }
        ReturnValue(ok)
    }
}

// Leave this operand in xmm0. A float child is asked to skip the rax copy.
Function.Optimize_CompileXmm {
    Input: node: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(Optimize_IsXmmHold(node), 1) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(Optimize_IsLeaf(node), 1) ThenBlock: { ReturnValue(Optimize_LoadLeafXmm(node, 0)) }
        saved = OptState.xmm_out
        IfCondition EqualTo(AST_GetType(node), AST.CALL) ThenBlock: {
            IfCondition EqualTo(Optimize_FltProducer(AST_GetData1(node)), 1) ThenBlock: {
                OptState.xmm_out = 1
                got = Compile_Expression(node)
                OptState.xmm_out = saved
                ReturnValue(got)
            }
        }
        OptState.xmm_out = 0
        got = Compile_Expression(node)
        OptState.xmm_out = saved
        IfCondition EqualTo(got, 0) ThenBlock: { ReturnValue(0) }
        X86Enc_Assemble("MOVQ xmm0, rax")
        ReturnValue(1)
    }
}

Function.Optimize_HomeCallSave {
    Input: callee: Address
    Body: {
        IfCondition EqualTo(LoopHome.active, 1) ThenBlock: {
            Optimize_FlushHold()
            keep = Optimize_HomesClobber(callee)
            IfCondition EqualTo(keep, 1) ThenBlock: {
                IfCondition NotEqual(LoopHome.int_name, 0) ThenBlock: {
                    Emit_HomeMove(1, 0)
                    Emit_MovRbpOffsetRax(LoopHome.int_off)
                }
                IfCondition NotEqual(LoopHome.flt_name, 0) ThenBlock: {
                    Emit_HomeMove(5, 0)
                    Emit_MovRbpOffsetRax(LoopHome.flt_off)
                }
                Optimize_AllocXmmSave()
            }
        }
    }
}

Function.Optimize_HomeCallLoad {
    Input: callee: Address
    Body: {
        IfCondition EqualTo(LoopHome.active, 1) ThenBlock: {
            keep = Optimize_HomesClobber(callee)
            IfCondition EqualTo(keep, 1) ThenBlock: {
                IfCondition NotEqual(LoopHome.int_name, 0) ThenBlock: {
                    Emit_MovRaxRbpOffset(LoopHome.int_off)
                    Emit_HomeMove(2, 0)
                }
                IfCondition NotEqual(LoopHome.flt_name, 0) ThenBlock: {
                    Emit_MovRaxRbpOffset(LoopHome.flt_off)
                    Emit_HomeMove(6, 0)
                }
                Optimize_AllocXmmLoad()
            }
            IfCondition EqualTo(LoopHome.tab_on, 1) ThenBlock: {
                Emit_MovRaxRbpOffset(LoopHome.tab_off)
                Emit_MovR14Rax()
            }
        }
    }
}

// acc = Add(acc, call) or Add(call, acc), or Subtract(acc, call).
// Six or fewer register arguments leave r12 alone. The call result is in rax.
Function.Optimize_TryAccCall {
    Input: target: Address
    Input: value: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(LoopHome.active, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(LoopHome.acc_name, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_NameEq(target, LoopHome.acc_name), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(value, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(value), AST.CALL) ThenBlock: { ReturnValue(0) }
        opname = AST_GetData1(value)
        is_add = EqualTo(StringCompare(opname, "Add"), 0)
        is_sub = EqualTo(StringCompare(opname, "Subtract"), 0)
        IfCondition EqualTo(is_add, 0) ThenBlock: {
            IfCondition EqualTo(is_sub, 0) ThenBlock: { ReturnValue(0) }
        }
        IfCondition NotEqual(AST_GetChildCount(value), 2) ThenBlock: { ReturnValue(0) }
        a0 = AST_GetChild(value, 0)
        a1 = AST_GetChild(value, 1)
        left_acc = 0
        right_acc = 0
        IfCondition EqualTo(AST_GetType(a0), AST.IDENTIFIER) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(AST_GetData1(a0), LoopHome.acc_name), 1) ThenBlock: {
                left_acc = 1
            }
        }
        IfCondition EqualTo(AST_GetType(a1), AST.IDENTIFIER) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(AST_GetData1(a1), LoopHome.acc_name), 1) ThenBlock: {
                right_acc = 1
            }
        }
        other = 0
        IfCondition EqualTo(is_add, 1) ThenBlock: {
            IfCondition EqualTo(left_acc, 1) ThenBlock: {
                IfCondition EqualTo(right_acc, 0) ThenBlock: { other = a1 }
            }
            IfCondition EqualTo(right_acc, 1) ThenBlock: {
                IfCondition EqualTo(left_acc, 0) ThenBlock: { other = a0 }
            }
        }
        IfCondition EqualTo(is_sub, 1) ThenBlock: {
            IfCondition EqualTo(left_acc, 1) ThenBlock: {
                IfCondition EqualTo(right_acc, 0) ThenBlock: { other = a1 }
            }
        }
        IfCondition EqualTo(other, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(other), AST.CALL) ThenBlock: { ReturnValue(0) }
        cname = AST_GetData1(other)
        IfCondition EqualTo(cname, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_HomeCallOk(cname), 1) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(Compile_FindFunction(cname), 0) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterThan(AST_GetChildCount(other), 6) ThenBlock: { ReturnValue(0) }
        got = Compile_Expression(other)
        IfCondition EqualTo(got, 0) ThenBlock: {
            Compile.error = 1
            ReturnValue(1)
        }
        IfCondition EqualTo(is_sub, 1) ThenBlock: { X86_SubRegReg(Reg.R12, Reg.RAX) }
        IfCondition EqualTo(is_sub, 0) ThenBlock: { X86_AddRegReg(Reg.R12, Reg.RAX) }
        ReturnValue(1)
    }
}

// acc = Add(acc, Dereference(Add(tab, Multiply(index, scale))))
// Add is commutative. Subtract only when the accumulator is on the left.
// The table is already in r14. A cursor index uses r13. Any other index
// that does not read the accumulator is compiled to rcx and added from
// memory, so the accumulator is not pushed around the load.
Function.Optimize_TryAccMem {
    Input: target: Address
    Input: value: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(LoopHome.active, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(LoopHome.acc_name, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_NameEq(target, LoopHome.acc_name), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(value, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(value), AST.CALL) ThenBlock: { ReturnValue(0) }
        opname = AST_GetData1(value)
        is_add = EqualTo(StringCompare(opname, "Add"), 0)
        is_sub = EqualTo(StringCompare(opname, "Subtract"), 0)
        IfCondition EqualTo(is_add, 0) ThenBlock: {
            IfCondition EqualTo(is_sub, 0) ThenBlock: { ReturnValue(0) }
        }
        IfCondition NotEqual(AST_GetChildCount(value), 2) ThenBlock: { ReturnValue(0) }
        a0 = AST_GetChild(value, 0)
        a1 = AST_GetChild(value, 1)
        left_acc = 0
        right_acc = 0
        IfCondition EqualTo(AST_GetType(a0), AST.IDENTIFIER) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(AST_GetData1(a0), LoopHome.acc_name), 1) ThenBlock: {
                left_acc = 1
            }
        }
        IfCondition EqualTo(AST_GetType(a1), AST.IDENTIFIER) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(AST_GetData1(a1), LoopHome.acc_name), 1) ThenBlock: {
                right_acc = 1
            }
        }
        other = 0
        IfCondition EqualTo(is_add, 1) ThenBlock: {
            IfCondition EqualTo(left_acc, 1) ThenBlock: {
                IfCondition EqualTo(right_acc, 0) ThenBlock: { other = a1 }
            }
            IfCondition EqualTo(right_acc, 1) ThenBlock: {
                IfCondition EqualTo(left_acc, 0) ThenBlock: { other = a0 }
            }
        }
        IfCondition EqualTo(is_sub, 1) ThenBlock: {
            IfCondition EqualTo(left_acc, 1) ThenBlock: {
                IfCondition EqualTo(right_acc, 0) ThenBlock: { other = a1 }
            }
        }
        IfCondition EqualTo(other, 0) ThenBlock: { ReturnValue(0) }
        scale = Optimize_QwordScale(other)
        IfCondition EqualTo(scale, 0) ThenBlock: { ReturnValue(0) }
        acc_node = a0
        IfCondition EqualTo(left_acc, 0) ThenBlock: { acc_node = a1 }
        IfCondition EqualTo(Optimize_QwordFast(other, acc_node), 0) ThenBlock: { ReturnValue(0) }
        idx = Optimize_QwordIndex(other)
        cursor = 0
        IfCondition NotEqual(LoopHome.int_name, 0) ThenBlock: {
            IfCondition EqualTo(Optimize_IdentEq(idx, LoopHome.int_name), 1) ThenBlock: { cursor = 1 }
        }
        IfCondition EqualTo(cursor, 0) ThenBlock: {
            IfCondition GreaterThan(OptState.repeat_n, 1) ThenBlock: { ReturnValue(0) }
            IfCondition EqualTo(Optimize_TreeHasName(idx, LoopHome.acc_name), 1) ThenBlock: { ReturnValue(0) }
            got = Compile_Expression(idx)
            IfCondition EqualTo(got, 0) ThenBlock: {
                Compile.error = 1
                ReturnValue(1)
            }
            Emit_MovRcxRax()
            IfCondition EqualTo(is_sub, 1) ThenBlock: { X86_AccMemR14Rcx(43, scale) }
            IfCondition EqualTo(is_sub, 0) ThenBlock: { X86_AccMemR14Rcx(3, scale) }
            ReturnValue(1)
        }
        IfCondition GreaterThan(OptState.repeat_n, 1) ThenBlock: {
            X86_MovRaxAtR14R13(scale)
            X86_ImulRaxImm32(OptState.repeat_n)
            IfCondition EqualTo(is_sub, 1) ThenBlock: { X86_SubRegReg(Reg.R12, Reg.RAX) }
            IfCondition EqualTo(is_sub, 0) ThenBlock: { X86_AddRegReg(Reg.R12, Reg.RAX) }
            OptState.repeat_hit = Add(OptState.repeat_hit, 1)
            ReturnValue(1)
        }
        IfCondition EqualTo(is_sub, 1) ThenBlock: { X86_AccMemR14R13(43, scale) }
        IfCondition EqualTo(is_sub, 0) ThenBlock: { X86_AccMemR14R13(3, scale) }
        ReturnValue(1)
    }
}

Function.Optimize_TryAccAssign {
    Input: target: Address
    Input: value: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(LoopHome.active, 0) ThenBlock: { ReturnValue(0) }
        cls = Optimize_AccShape(target, value)
        IfCondition EqualTo(cls, 0) ThenBlock: { ReturnValue(0) }
        opname = AST_GetData1(value)
        is_sub = 0
        IfCondition EqualTo(StringCompare(opname, "Subtract"), 0) ThenBlock: { is_sub = 1 }
        disp = LoopHome.hit_disp
        IfCondition EqualTo(cls, 5) ThenBlock: {
            IfCondition EqualTo(is_sub, 1) ThenBlock: { Emit_HomeMove(34, 0) }
            IfCondition EqualTo(is_sub, 0) ThenBlock: { Emit_HomeMove(23, 0) }
            ReturnValue(1)
        }
        IfCondition EqualTo(cls, 7) ThenBlock: {
            IfCondition EqualTo(Optimize_Fit32(disp), 0) ThenBlock: { ReturnValue(0) }
            IfCondition EqualTo(is_sub, 1) ThenBlock: { Emit_HomeMove(42, disp) }
            IfCondition EqualTo(is_sub, 0) ThenBlock: { Emit_HomeMove(41, disp) }
            ReturnValue(1)
        }
        IfCondition EqualTo(cls, 2) ThenBlock: {
            IfCondition EqualTo(is_sub, 1) ThenBlock: { Emit_HomeMove(22, disp) }
            IfCondition EqualTo(is_sub, 0) ThenBlock: { Emit_HomeMove(21, disp) }
            ReturnValue(1)
        }
        IfCondition EqualTo(cls, 4) ThenBlock: {
            IfCondition EqualTo(is_sub, 1) ThenBlock: { Emit_HomeMove(22, disp) }
            IfCondition EqualTo(is_sub, 0) ThenBlock: { Emit_HomeMove(21, disp) }
            ReturnValue(1)
        }
        ReturnValue(0)
    }
}

Function.Optimize_HomeByName {
    Input: name: Address
    Output: Address
    Body: {
        i = 0
        WhileLoop LessThan(i, LoopHome.count) {
            rec = Optimize_HomeRec(i)
            IfCondition EqualTo(Optimize_NameEq(Dereference(rec), name), 1) ThenBlock: { ReturnValue(rec) }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}
