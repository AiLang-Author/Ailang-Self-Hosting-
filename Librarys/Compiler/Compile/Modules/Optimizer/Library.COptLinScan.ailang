// Library.COptLinScan.ailang
// Linear-scan register allocation (Poletto-Sarkar) over the per-name
// intervals Library.COptLive.ailang computes. Replaces what LoopHome
// (the picker) and AllocTab (the lookup table) do today, but as one
// function-wide pass instead of a reset-per-loop one.
//
// Candidate pool for this first cut: the four SysV callee-saved GPRs
// already in use by the existing home system - rbx, r12, r13, r14.
// Callee-saved means every one of them is safe to hold a value across
// a real call for the interval's entire lifetime, as long as the
// prologue/epilogue actually save and restore it - which is the
// structural fix for C2 (today only rbx/r12 are ever pushed; r13/r14
// are not, despite being used as homes). crosses_call does not need
// to gate this pool at all; it only matters for a true scratch
// register, which this first cut does not use (r11 is a documented,
// not-yet-taken future extension - see Optimize_ScanRun).
//
// No consumer yet. Loaded by the optimizer shell. No imports of its
// own.

// Per-name scratch for one sort+scan run. Reset each call. Sized 128
// to match TagState's local-name cap.
//
// want/eligible/mat are the gated-wiring state (see Optimize_ScanArm
// and friends, below the scan algorithm itself): "want" caches the
// AILANG_LINSCAN=1 environment check; "eligible" is 1 for a function
// whose body the CFG models (If/Fork merge points are reconciled
// below, and While/ForEvery drop "mat" at the back edge). "mat" is a
// per-function, per-name "has this register
// actually been populated yet" flag. A scratch write spills the
// home and then clears the bit. The register is the value until
// that spill. The frame is stale in between.
FixedPool.ScanState {
    "buf": Initialize=0, CanChange=True   // lazily allocated, 128 * 24 bytes
    "want": Initialize=-1, CanChange=True
    "eligible": Initialize=0, CanChange=True
    "mat": Initialize=0, CanChange=True   // lazily allocated, 128 bytes
    "flt": Initialize=0, CanChange=True   // 128 bytes: 1 = float-only name
    "keep": Initialize=0, CanChange=True  // name id whose reg write is the new value
    "loop_mask": Initialize=0, CanChange=True
    "iv": Initialize=0, CanChange=True
    "base": Initialize=0, CanChange=True
    "body": Initialize=0, CanChange=True
    "pick": Initialize=-1, CanChange=True
    // 128 words. Bit r is set when an op in that name's live range
    // writes r and does not restore it. The scan will not home it there.
    // A spill emitted at the write would store whatever the register
    // holds on the next trip through a loop, which is the scratch, not
    // the home. PutInt's digit and Hash.FindSlot's probe both faulted
    // that way.
    "forbid": Initialize=0, CanChange=True
    // CPU stack of PUSH operands for this function. A POP of the same
    // register puts the pre-push value back, so a materialized home
    // stays materialized. A POP of a different register is a value
    // pop and still spills. 256 entries of 8 bytes. save_sp < 0 means
    // the model overflowed and every later pop clobbers.
    "save_stk": Initialize=0, CanChange=True
    "save_sp": Initialize=0, CanChange=True
    // 1 while ScanFltInto1 holds the outer operand in xmm15.
    // A nested float takes the push/pop path so it cannot
    // overwrite that park.
    "xmm15_busy": Initialize=0, CanChange=True
    // Bit (xmm-6) for each of xmm6..xmm14 saved in this prologue.
    "xmm_save_mask": Initialize=0, CanChange=True
}

// Two hoisted pointers for the loop being compiled. r14 then r11.
// A nested loop pushes this record, spills the registers, and pops
// them back when it returns. base/stride are scratch for the arm.
FixedPool.ScanPtr {
    "n": Initialize=0, CanChange=True
    "snap": Initialize=0, CanChange=True
    "name0": Initialize=0, CanChange=True
    "name1": Initialize=0, CanChange=True
    "reg0": Initialize=0, CanChange=True
    "reg1": Initialize=0, CanChange=True
    "bump0": Initialize=0, CanChange=True
    "bump1": Initialize=0, CanChange=True
    "iv0": Initialize=0, CanChange=True
    "iv1": Initialize=0, CanChange=True
    "step0": Initialize=0, CanChange=True
    "step1": Initialize=0, CanChange=True
    "base0": Initialize=0, CanChange=True
    "base1": Initialize=0, CanChange=True
    "stride0": Initialize=0, CanChange=True
    "stride1": Initialize=0, CanChange=True
    "hit_reg": Initialize=0, CanChange=True
    "hit_disp": Initialize=0, CanChange=True
    "mess": Initialize=0, CanChange=True
    "found": Initialize=0, CanChange=True
    "step": Initialize=0, CanChange=True
    "calls": Initialize=0, CanChange=True
    "sbase": Initialize=0, CanChange=True
    "siv": Initialize=0, CanChange=True
    "sstride": Initialize=0, CanChange=True
    "rm": Initialize=0, CanChange=True
    "rm_n": Initialize=0, CanChange=True
    // Invariant pointer parked in r14 for [r14+index*scale]. 0 = none.
    "scale_name": Initialize=0, CanChange=True
    "scale_bad": Initialize=0, CanChange=True
    // ij = inv + iv, kept in r11 and stepped with the iv. 0 = none.
    "run_name": Initialize=0, CanChange=True
    "run_iv": Initialize=0, CanChange=True
    "run_inv": Initialize=0, CanChange=True
    "run_step": Initialize=0, CanChange=True
    // Invariant GetByte/SetByte base parked in r14. 0 = none.
    // Leaf loops only. A nested loop reuses r14, so an outer byte
    // base is refused rather than restored.
    "byte_name": Initialize=0, CanChange=True
    "byte_bad": Initialize=0, CanChange=True
    // SetByte(base, iv, imm); iv = iv + step; while iv < lim.
    // r14 walks base+iv. r11 is base+lim. 0 = not this loop.
    "byte_iv": Initialize=0, CanChange=True
    "byte_step": Initialize=0, CanChange=True
    "byte_lim": Initialize=0, CanChange=True
    "byte_imm": Initialize=-1, CanChange=True
    // Sum loop: acc = acc + GetByte(base, iv); iv = iv + 1.
    // 0 = the strided SetByte walker. rbx holds acc for the trip.
    "byte_acc": Initialize=0, CanChange=True
    // Invariant byte base kept in r11 across an inner loop. The inner
    // loop borrows r11 and the pop puts this base back. 0 = none.
    "byte_keep": Initialize=0, CanChange=True
    // Spilled integer counter kept in r14 for one leaf loop. 0 = none.
    // ctr_lim is the LessThan immediate, 0..127.
    "ctr_name": Initialize=0, CanChange=True
    "ctr_lim": Initialize=0, CanChange=True
    // Loop-invariant frame float parked in xmm2 for this leaf loop.
    // Loaded once on entry. 0 = none. xmm2 is not in the scan pool.
    "flt_keep": Initialize=0, CanChange=True
    // Statement position of the pointer kill about to run. -1 spills
    // every stale field. A last use at or before this position does not.
    "at_pos": Initialize=-1, CanChange=True
    // Unstepped pointer fields with no scan xmm, parked for this loop
    // only. park0 is xmm3. park1/park2 are leftover pool xmms
    // (xmm4-xmm14), never xmm0/xmm1 (expression scratch). 0 = empty.
    "park0": Initialize=0, CanChange=True
    "park1": Initialize=0, CanChange=True
    "park2": Initialize=0, CanChange=True
    // Body of the loop ScanPtrArm is compiling. StoreValue uses it to
    // refuse a delayed write when the xmm is updated in this body.
    "loop_body": Initialize=0, CanChange=True
    // Slot 1 walks backward: bump1 is the positive stride, AddIpImm
    // subtracts it. rev_c is C in idx = C - iv.
    "rev1": Initialize=0, CanChange=True
    "rev_c": Initialize=0, CanChange=True
    // Index names of the two-pointer swap. walk_lo is i, walk_hi is idx.
    "walk_lo": Initialize=0, CanChange=True
    "walk_hi": Initialize=0, CanChange=True
    // 1 when the body is the six-statement swap. a lives in rax, b in rcx.
    "swap": Initialize=0, CanChange=True
    "swap_a": Initialize=0, CanChange=True
    "swap_b": Initialize=0, CanChange=True
    // Hardware xmm for park1/park2 (4..14). -1 = empty.
    "park1_reg": Initialize=-1, CanChange=True
    "park2_reg": Initialize=-1, CanChange=True
    // Statement scratch for the triangular denominator. Not saved
    // across a nested loop. Valid only after ScanDenMatch returns 1.
    "tri_src": Initialize=0, CanChange=True
    "tri_base": Initialize=0, CanChange=True
    "tri_disp": Initialize=0, CanChange=True
    "tri_pin": Initialize=0, CanChange=True
    "tri_ij": Initialize=0, CanChange=True
    "tri_ij1": Initialize=0, CanChange=True
    "tri_tri": Initialize=0, CanChange=True
    "tri_plus": Initialize=0, CanChange=True
    "id_n": Initialize=0, CanChange=True
}

// 24 bytes/entry: start_pos, end_pos, reg (Reg.* code, or -1 = spill).
// Indexed 0..127 by (name id - 1), same convention as NameState.
Function.Optimize_ScanEnsure {
    Body: {
        IfCondition NotEqual(ScanState.buf, 0) ThenBlock: { ReturnValue(0) }
        ScanState.buf = Allocate(Multiply(128, 24))
        ReturnValue(0)
    }
}

Function.Optimize_ScanPtr {
    Input: id: Integer
    Output: Address
    Body: {
        IfCondition Or(LessThan(id, 1), GreaterThan(id, 128)) ThenBlock: { ReturnValue(0) }
        ReturnValue(Add(ScanState.buf, Multiply(Subtract(id, 1), 24)))
    }
}

Function.Optimize_ScanReg {
    Input: id: Integer
    Output: Integer
    Body: {
        p = Optimize_ScanPtr(id)
        IfCondition EqualTo(p, 0) ThenBlock: { ReturnValue(-1) }
        ReturnValue(Dereference(Add(p, 16)))
    }
}

// Runs the whole algorithm for the function whose intervals
// Library.COptLive.ailang just computed (Optimize_TagFunction ->
// Optimize_CFGFunction -> Optimize_LiveFunction must already have run
// on this body - same ordering CompileFunc_Function already uses).
//
// Classic Poletto-Sarkar sweep: process intervals in start order,
// expire anything already ended, take a free register if one exists,
// otherwise spill whichever of (the new interval, the active interval
// with the furthest end) gains least from holding one.
// 1 when some live name already owns reg. A scratch must not use it.
Function.Optimize_ScanRegBusy {
    Input: reg: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(Optimize_ScanActive(), 0) ThenBlock: { ReturnValue(0) }
        i = 1
        WhileLoop LessThan(i, Add(TagState.nnames, 1)) {
            IfCondition NotEqual(Optimize_LiveMaxPos(i), -1) ThenBlock: {
                IfCondition EqualTo(Optimize_ScanReg(i), reg) ThenBlock: { ReturnValue(1) }
            }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

// 1 when reg is a caller-saved value home (not rax, not r14, not r15).
Function.Optimize_ScanCallerReg {
    Input: reg: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(reg, Reg.RCX) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(reg, Reg.RDX) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(reg, Reg.RSI) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(reg, Reg.RDI) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(reg, Reg.R8) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(reg, Reg.R9) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(reg, Reg.R10) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(reg, Reg.R11) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

// Do not spill caller-saved homes at a call. The store would be emitted
// only on the arm that reaches that instruction, and a later use reloads
// the slot on the other arm, which never wrote it. That is the arena
// mmap fault. The definition already wrote the frame (ScanHold). This
// only drops the cache flag so the next load does not read the register
// the call just clobbered. rbx, r12, and r13 stay.
Function.Optimize_ScanSpillCallers {
    Body: {
        ReturnValue(0)
    }
}

Function.Optimize_ScanForgetCallers {
    Body: {
        IfCondition EqualTo(Optimize_ScanActive(), 0) ThenBlock: { ReturnValue(0) }
        i = 1
        last = Add(TagState.nnames, 1)
        WhileLoop LessThan(i, last) {
            IfCondition EqualTo(Optimize_ScanMatGet(i), 1) ThenBlock: {
                reg = Optimize_ScanReg(i)
                drop = 0
                IfCondition EqualTo(reg, Reg.RCX) ThenBlock: { drop = 1 }
                IfCondition EqualTo(reg, Reg.RDX) ThenBlock: { drop = 1 }
                IfCondition EqualTo(reg, Reg.RSI) ThenBlock: { drop = 1 }
                IfCondition EqualTo(reg, Reg.RDI) ThenBlock: { drop = 1 }
                IfCondition EqualTo(reg, Reg.R8) ThenBlock: { drop = 1 }
                IfCondition EqualTo(reg, Reg.R9) ThenBlock: { drop = 1 }
                IfCondition EqualTo(reg, Reg.R10) ThenBlock: { drop = 1 }
                IfCondition EqualTo(reg, Reg.R11) ThenBlock: { drop = 1 }
                IfCondition EqualTo(drop, 1) ThenBlock: {
                    Optimize_VerifyEnd(i)
                    SetByte(ScanState.mat, Subtract(i, 1), 0)
                }
            }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

// 1 when aid is the better spill: shallower loop, then lower cost,
// then a use that is further away.
Function.Optimize_ScanColder {
    Input: aid: Integer
    Input: cur: Integer
    Input: from: Integer
    Output: Integer
    Body: {
        ad = Optimize_LiveDepth(aid)
        cd = Optimize_LiveDepth(cur)
        IfCondition LessThan(ad, cd) ThenBlock: { ReturnValue(1) }
        IfCondition GreaterThan(ad, cd) ThenBlock: { ReturnValue(0) }
        ac = Optimize_ScanSpillCost(aid)
        cc = Optimize_ScanSpillCost(cur)
        IfCondition LessThan(ac, cc) ThenBlock: { ReturnValue(1) }
        IfCondition GreaterThan(ac, cc) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterThan(Optimize_ScanNext(aid, from), Optimize_ScanNext(cur, from)) ThenBlock: {
            ReturnValue(1)
        }
        ReturnValue(0)
    }
}

// Index of reg in the free list, or -1.
Function.Optimize_ScanFindFree {
    Input: free_regs: Address
    Input: free_n: Integer
    Input: reg: Integer
    Output: Integer
    Body: {
        i = 0
        WhileLoop LessThan(i, free_n) {
            IfCondition EqualTo(Dereference(Add(free_regs, Multiply(i, 8))), reg) ThenBlock: {
                ReturnValue(i)
            }
            i = Add(i, 1)
        }
        ReturnValue(-1)
    }
}

// Remove free_regs[index]. Returns the new length.
Function.Optimize_ScanDropFree {
    Input: free_regs: Address
    Input: free_n: Integer
    Input: index: Integer
    Output: Integer
    Body: {
        last = Subtract(free_n, 1)
        StoreValue(Add(free_regs, Multiply(index, 8)), Dereference(Add(free_regs, Multiply(last, 8))))
        ReturnValue(last)
    }
}

// Last free xmm6-xmm14. The list is stored high to low, so the last
// match is the lowest free callee-saved xmm. xmm4 and xmm5 stay for
// names that do not cross a call. ScanState.pick is the register, or
// -1 when every callee-saved xmm is already taken.
Function.Optimize_ScanTakeCalleeXmm {
    Input: free_regs: Address
    Input: free_n: Integer
    Output: Integer
    Body: {
        ScanState.pick = -1
        pick_at = -1
        j = 0
        WhileLoop LessThan(j, free_n) {
            cand = Dereference(Add(free_regs, Multiply(j, 8)))
            IfCondition GreaterEqual(cand, 38) ThenBlock: {
                IfCondition LessEqual(cand, 46) ThenBlock: {
                    pick_at = j
                }
            }
            j = Add(j, 1)
        }
        IfCondition LessThan(pick_at, 0) ThenBlock: { ReturnValue(free_n) }
        ScanState.pick = Dereference(Add(free_regs, Multiply(pick_at, 8)))
        ReturnValue(Optimize_ScanDropFree(free_regs, free_n, pick_at))
    }
}

// 1 for a callee-saved register a call-crossing value may occupy.
// xmm6-xmm14 are 38-46. The prologue saves each one this function uses.
Function.Optimize_ScanCalleeReg {
    Input: reg: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(reg, Reg.RBX) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(reg, Reg.R12) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(reg, Reg.R13) ThenBlock: { ReturnValue(1) }
        IfCondition GreaterEqual(reg, 38) ThenBlock: {
            IfCondition LessEqual(reg, 46) ThenBlock: { ReturnValue(1) }
        }
        ReturnValue(0)
    }
}

// Put reg on the free list when no active interval holds it. rbx is
// kept out of the initial list when the body does not scratch it, so
// a call-crossing name can still take it.
Function.Optimize_ScanOfferReg {
    Input: free_regs: Address
    Input: free_n: Integer
    Input: reg: Integer
    Input: active_id: Address
    Input: active_n: Integer
    Output: Integer
    Body: {
        IfCondition GreaterEqual(Optimize_ScanFindFree(free_regs, free_n, reg), 0) ThenBlock: {
            ReturnValue(free_n)
        }
        a = 0
        WhileLoop LessThan(a, active_n) {
            aid = Dereference(Add(active_id, Multiply(a, 8)))
            IfCondition EqualTo(Optimize_ScanReg(aid), reg) ThenBlock: {
                ReturnValue(free_n)
            }
            a = Add(a, 1)
        }
        StoreValue(Add(free_regs, Multiply(free_n, 8)), reg)
        ReturnValue(Add(free_n, 1))
    }
}

// Registers this lowering writes and does not restore. A home left
// in one of them is spilled at the write. Inside a loop that spill
// runs every trip, after the register has already been overwritten,
// so the frame receives the scratch. Caller-saved bits match the
// verifier: rcx rdx rsi rdi r8 r9 r10 r11. rax is not a home.
Function.Optimize_ScanOpClobber {
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }
        // rcx rdx rsi rdi r9. movzx r9d and movzx edx are the page tail.
        IfCondition EqualTo(StringCompare(name, "StringCompare"), 0) ThenBlock: { ReturnValue(710) }
        IfCondition EqualTo(StringCompare(name, "StringEquals"), 0) ThenBlock: { ReturnValue(710) }
        // rcx rdi r8. The aligned loop is movdqa xmm, [rdi].
        IfCondition EqualTo(StringCompare(name, "StringLength"), 0) ThenBlock: { ReturnValue(386) }
        // rcx rdi. inc rdi walks the bytes.
        IfCondition EqualTo(StringCompare(name, "Crc32String"), 0) ThenBlock: { ReturnValue(130) }
        // pop rcx; mov rdi, rax. Neither is restored.
        IfCondition EqualTo(StringCompare(name, "SetByte"), 0) ThenBlock: { ReturnValue(130) }
        // mov rbx, rax for the index. Not restored on the slow path.
        IfCondition EqualTo(StringCompare(name, "GetByte"), 0) ThenBlock: { ReturnValue(8) }
        // Magic division is imul, which writes rdx, then a copy in rcx.
        // rbx is pushed and popped around that sequence.
        IfCondition EqualTo(StringCompare(name, "Divide"), 0) ThenBlock: { ReturnValue(6) }
        IfCondition EqualTo(StringCompare(name, "Modulo"), 0) ThenBlock: { ReturnValue(6) }
        ReturnValue(0)
    }
}

Function.Optimize_ScanForbidOf {
    Input: id: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(ScanState.forbid, 0) ThenBlock: { ReturnValue(0) }
        IfCondition Or(LessThan(id, 1), GreaterThan(id, 128)) ThenBlock: { ReturnValue(0) }
        ReturnValue(Dereference(Add(ScanState.forbid, Multiply(Subtract(id, 1), 8))))
    }
}

// pos < 0 means the call was not a program point. Every live name
// then avoids the mask. A name whose interval starts at pos is the
// value this statement defines, so the write is its own definition.
Function.Optimize_ScanForbidAt {
    Input: pos: Integer
    Input: mask: Integer
    Body: {
        IfCondition EqualTo(mask, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(ScanState.forbid, 0) ThenBlock: { ReturnValue(0) }
        i = 1
        last = Add(TagState.nnames, 1)
        WhileLoop LessThan(i, last) {
            mn = Optimize_LiveMinPos(i)
            mx = Optimize_LiveMaxPos(i)
            hit = 0
            IfCondition GreaterEqual(mn, 0) ThenBlock: {
                IfCondition GreaterEqual(mx, mn) ThenBlock: {
                    IfCondition LessThan(pos, 0) ThenBlock: { hit = 1 }
                    IfCondition GreaterEqual(pos, 0) ThenBlock: {
                        IfCondition GreaterThan(pos, mn) ThenBlock: {
                            IfCondition LessEqual(pos, mx) ThenBlock: { hit = 1 }
                        }
                    }
                }
            }
            IfCondition EqualTo(hit, 1) ThenBlock: {
                slot = Add(ScanState.forbid, Multiply(Subtract(i, 1), 8))
                StoreValue(slot, BitwiseOr(Dereference(slot), mask))
            }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

// A direct-call argument is copied into rdi before the call instruction.
// Caller-saved homes are safe when the name dies on that statement and
// is not live-out of the block. A name still live after the call, or
// used beside a nested call, keeps the mask.
Function.Optimize_ScanForbidDrop {
    Input: id: Integer
    Input: pos: Integer
    Input: blk: Integer
    Body: {
        IfCondition LessThan(id, 1) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterThan(id, 128) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(pos, 1) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(Optimize_LiveThru(id), 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(Optimize_LiveCallKeep(id), 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(Optimize_LiveMaxPos(id), pos) ThenBlock: { ReturnValue(0) }
        hit = 0
        IfCondition LessEqual(id, 64) ThenBlock: {
            IfCondition NotEqual(BitwiseAnd(Optimize_LiveOut0(blk), LeftShift(1, Subtract(id, 1))), 0) ThenBlock: {
                hit = 1
            }
        }
        IfCondition GreaterThan(id, 64) ThenBlock: {
            IfCondition NotEqual(BitwiseAnd(Optimize_LiveOut1(blk), LeftShift(1, Subtract(id, 65))), 0) ThenBlock: {
                hit = 1
            }
        }
        IfCondition EqualTo(hit, 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(ScanState.forbid, 0) ThenBlock: { ReturnValue(0) }
        slot = Add(ScanState.forbid, Multiply(Subtract(id, 1), 8))
        // 4038 is rcx rdx rsi rdi r8 r9 r10 r11. rbx and the other
        // callee-saved registers stay forbidden when something else set them.
        StoreValue(slot, BitwiseAnd(Dereference(slot), BitwiseNot(4038)))
        ReturnValue(0)
    }
}

Function.Optimize_ScanForbidDirect {
    Input: node: Address
    Input: pos: Integer
    Input: blk: Integer
    Body: {
        IfCondition EqualTo(Optimize_LiveDirectCall(node), 0) ThenBlock: { ReturnValue(0) }
        rec = Optimize_TagPtr(node)
        IfCondition EqualTo(rec, 0) ThenBlock: { ReturnValue(0) }
        u0 = Dereference(Add(rec, 16))
        u1 = Dereference(Add(rec, 24))
        k = 0
        WhileLoop LessThan(k, 64) {
            IfCondition NotEqual(BitwiseAnd(u0, LeftShift(1, k)), 0) ThenBlock: {
                Optimize_ScanForbidDrop(Add(k, 1), pos, blk)
            }
            IfCondition NotEqual(BitwiseAnd(u1, LeftShift(1, k)), 0) ThenBlock: {
                Optimize_ScanForbidDrop(Add(k, 65), pos, blk)
            }
            k = Add(k, 1)
        }
        ReturnValue(0)
    }
}

Function.Optimize_ScanForbidWalk {
    Input: node: Address
    Input: pos: Integer
    Input: blk: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        // Unstamped nodes keep block_id -1 and a zero pos word. Taking
        // that zero would hide the enclosing statement's real position,
        // so a StringCompare nested in a condition never forbids anything.
        bid = Optimize_TagBlockOf(node)
        IfCondition NotEqual(bid, -1) ThenBlock: {
            here = Optimize_TagPosOf(node)
            IfCondition GreaterThan(here, 0) ThenBlock: {
                pos = here
                blk = bid
            }
        }
        nt = AST_GetType(node)
        IfCondition EqualTo(nt, AST.CALL) ThenBlock: {
            mask = Optimize_ScanOpClobber(AST_GetData1(node))
            rec = Optimize_TagPtr(node)
            real = 0
            IfCondition NotEqual(rec, 0) ThenBlock: {
                IfCondition NotEqual(BitwiseAnd(Dereference(rec), TagBit.CALL), 0) ThenBlock: {
                    mask = BitwiseOr(mask, 4038)
                    real = 1
                }
            }
            Optimize_ScanForbidAt(pos, mask)
            IfCondition EqualTo(real, 1) ThenBlock: {
                Optimize_ScanForbidDirect(node, pos, blk)
            }
        }
        n = AST_GetChildCount(node)
        i = 0
        WhileLoop LessThan(i, n) {
            Optimize_ScanForbidWalk(AST_GetChild(node, i), pos, blk)
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

Function.Optimize_ScanForbidBuild {
    Input: body: Address
    Body: {
        IfCondition EqualTo(ScanState.forbid, 0) ThenBlock: {
            ScanState.forbid = Allocate(1024)
        }
        IfCondition EqualTo(ScanState.forbid, 0) ThenBlock: { ReturnValue(0) }
        i = 0
        WhileLoop LessThan(i, 128) {
            StoreValue(Add(ScanState.forbid, Multiply(i, 8)), 0)
            i = Add(i, 1)
        }
        Optimize_ScanForbidWalk(body, -1, -1)
        ReturnValue(0)
    }
}

// First preferred register that is actually free. dangerous=1 tries
// rcx and r11 for a value that contains no real call. Kind 1 refuses
// that fallback and spills instead. forbid is the register mask this
// name must not occupy. ScanState.pick is the register, or -1. The
// return value is the new free-list length.
Function.Optimize_ScanTake {
    Input: free_regs: Address
    Input: free_n: Integer
    Input: kind: Integer
    Input: dangerous: Integer
    Input: forbid: Integer
    Output: Integer
    Body: {
        ScanState.pick = -1
        pref = Allocate(128)
        npref = 0
        IfCondition EqualTo(dangerous, 1) ThenBlock: {
            // Kind 1 must not fall through into a caller-saved register.
            // rcx and r11 are the leftover caller-saved regs for a value
            // that contains no real call. r14 is the address temporary,
            // so it is not a fallback either.
            IfCondition EqualTo(kind, 1) ThenBlock: {
                npref = 0
            } ElseBlock: {
                StoreValue(pref, Reg.RCX)
                StoreValue(Add(pref, 8), Reg.R11)
                npref = 2
            }
        } ElseBlock: {
            IfCondition EqualTo(kind, 0) ThenBlock: {
                StoreValue(pref, Reg.R10)
                StoreValue(Add(pref, 8), Reg.R8)
                StoreValue(Add(pref, 16), Reg.R9)
                StoreValue(Add(pref, 24), Reg.RSI)
                StoreValue(Add(pref, 32), Reg.RDI)
                StoreValue(Add(pref, 40), Reg.RDX)
                StoreValue(Add(pref, 48), Reg.RCX)
                StoreValue(Add(pref, 56), Reg.R11)
                npref = 8
            }
            IfCondition EqualTo(kind, 1) ThenBlock: {
                StoreValue(pref, Reg.R12)
                StoreValue(Add(pref, 8), Reg.R13)
                StoreValue(Add(pref, 16), Reg.RBX)
                npref = 3
            }
            IfCondition EqualTo(kind, 2) ThenBlock: {
                StoreValue(pref, Reg.R10)
                StoreValue(Add(pref, 8), Reg.R8)
                StoreValue(Add(pref, 16), Reg.R9)
                StoreValue(Add(pref, 24), Reg.RSI)
                StoreValue(Add(pref, 32), Reg.RDI)
                StoreValue(Add(pref, 40), Reg.RDX)
                StoreValue(Add(pref, 48), Reg.RCX)
                StoreValue(Add(pref, 56), Reg.R11)
                StoreValue(Add(pref, 64), Reg.R12)
                StoreValue(Add(pref, 72), Reg.R13)
                StoreValue(Add(pref, 80), Reg.RBX)
                npref = 11
            }
        }
        i = 0
        WhileLoop LessThan(i, npref) {
            IfCondition EqualTo(ScanState.pick, -1) ThenBlock: {
                want = Dereference(Add(pref, Multiply(i, 8)))
                blocked = BitwiseAnd(forbid, LeftShift(1, want))
                IfCondition EqualTo(blocked, 0) ThenBlock: {
                    at = Optimize_ScanFindFree(free_regs, free_n, want)
                    IfCondition GreaterEqual(at, 0) ThenBlock: {
                        ScanState.pick = want
                        free_n = Optimize_ScanDropFree(free_regs, free_n, at)
                    }
                }
            }
            i = Add(i, 1)
        }
        Deallocate(pref, 128)
        ReturnValue(free_n)
    }
}

// Give cur the active home with the shallowest loop depth. A base
// stays. Returns 1 when cur received a register.
Function.Optimize_ScanEvict {
    Input: active_id: Address
    Input: active_end: Address
    Input: active_n: Integer
    Input: cur_id: Integer
    Input: cur_end: Integer
    Input: cur_start: Integer
    Output: Integer
    Body: {
        cur_ptr = Optimize_ScanPtr(cur_id)
        best_a = -1
        best_id = 0
        cur_forbid = Optimize_ScanForbidOf(cur_id)
        a = 0
        WhileLoop LessThan(a, active_n) {
            aid = Dereference(Add(active_id, Multiply(a, 8)))
            IfCondition EqualTo(Optimize_ScanIsBase(aid), 0) ThenBlock: {
                allow = 1
                vreg = Dereference(Add(Optimize_ScanPtr(aid), 16))
                IfCondition EqualTo(Optimize_LiveCrossesCall(cur_id), 1) ThenBlock: {
                    IfCondition EqualTo(Optimize_ScanCalleeReg(vreg), 0) ThenBlock: { allow = 0 }
                }
                IfCondition GreaterEqual(vreg, 0) ThenBlock: {
                    IfCondition NotEqual(BitwiseAnd(cur_forbid, LeftShift(1, vreg)), 0) ThenBlock: { allow = 0 }
                }
                IfCondition EqualTo(allow, 1) ThenBlock: {
                colder = 0
                IfCondition LessThan(best_a, 0) ThenBlock: {
                    IfCondition EqualTo(Optimize_ScanColder(aid, cur_id, cur_start), 1) ThenBlock: {
                        colder = 1
                    }
                } ElseBlock: {
                    IfCondition EqualTo(Optimize_ScanColder(aid, best_id, cur_start), 1) ThenBlock: {
                        colder = 1
                    }
                }
                IfCondition EqualTo(colder, 1) ThenBlock: {
                    best_a = a
                    best_id = aid
                }
                }
            }
            a = Add(a, 1)
        }
        IfCondition LessThan(best_a, 0) ThenBlock: { ReturnValue(0) }
        reg = Dereference(Add(Optimize_ScanPtr(best_id), 16))
        StoreValue(Add(Optimize_ScanPtr(best_id), 16), -1)
        StoreValue(Add(cur_ptr, 16), reg)
        StoreValue(Add(active_id, Multiply(best_a, 8)), cur_id)
        StoreValue(Add(active_end, Multiply(best_a, 8)), cur_end)
        ReturnValue(1)
    }
}

// Argument register of a parameter, or -1. Slot 6 and above arrive
// on the stack and have no register to keep.
Function.Optimize_ScanParamReg {
    Input: id: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(Compile.current_func, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition LessThan(id, 1) ThenBlock: { ReturnValue(-1) }
        IfCondition GreaterThan(id, 128) ThenBlock: { ReturnValue(-1) }
        IfCondition EqualTo(TagState.names, 0) ThenBlock: { ReturnValue(-1) }
        name = Dereference(Add(TagState.names, Multiply(Subtract(id, 1), 8)))
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(-1) }
        node = Compile.current_func
        n = AST_GetChildCount(node)
        i = 0
        slot = 0
        WhileLoop LessThan(i, n) {
            ch = AST_GetChild(node, i)
            IfCondition NotEqual(ch, 0) ThenBlock: {
                IfCondition EqualTo(AST_GetType(ch), AST.PARAMETER) ThenBlock: {
                    IfCondition EqualTo(Optimize_NameEq(AST_GetData1(ch), name), 1) ThenBlock: {
                        ReturnValue(CompileFunc_ArgReg(slot))
                    }
                    slot = Add(slot, 1)
                }
            }
            i = Add(i, 1)
        }
        ReturnValue(-1)
    }
}

Function.Optimize_ScanRun {
    Body: {
        Optimize_ScanEnsure()
        IfCondition EqualTo(ScanState.buf, 0) ThenBlock: { ReturnValue(0) }
        Optimize_ScanForbidBuild(ScanState.body)

        n = 0
        order = Allocate(Multiply(128, 8))   // name ids, sorted by start_pos
        i = 1
        WhileLoop LessThan(i, Add(TagState.nnames, 1)) {
            IfCondition NotEqual(Optimize_LiveMaxPos(i), -1) ThenBlock: {
                p = Optimize_ScanPtr(i)
                StoreValue(p, Optimize_LiveMinPos(i))
                StoreValue(Add(p, 8), Optimize_LiveMaxPos(i))
                StoreValue(Add(p, 16), -1)
                StoreValue(Add(order, Multiply(n, 8)), i)
                n = Add(n, 1)
            }
            i = Add(i, 1)
        }

        // Insertion sort by start_pos - n is at most 128, plenty cheap.
        k = 1
        WhileLoop LessThan(k, n) {
            kid = Dereference(Add(order, Multiply(k, 8)))
            kstart = Dereference(Optimize_ScanPtr(kid))
            kpri = 2
            IfCondition NotEqual(ScanState.flt, 0) ThenBlock: {
                kb = GetByte(ScanState.flt, Subtract(kid, 1))
                IfCondition EqualTo(kb, 1) ThenBlock: { kpri = 0 }
                IfCondition EqualTo(kb, 5) ThenBlock: { kpri = 1 }
                IfCondition EqualTo(kb, 6) ThenBlock: { kpri = 1 }
            }
            j = Subtract(k, 1)
            done = 0
            WhileLoop And(GreaterEqual(j, 0), EqualTo(done, 0)) {
                jid = Dereference(Add(order, Multiply(j, 8)))
                jstart = Dereference(Optimize_ScanPtr(jid))
                jpri = 2
                IfCondition NotEqual(ScanState.flt, 0) ThenBlock: {
                    jb = GetByte(ScanState.flt, Subtract(jid, 1))
                    IfCondition EqualTo(jb, 1) ThenBlock: { jpri = 0 }
                    IfCondition EqualTo(jb, 5) ThenBlock: { jpri = 1 }
                    IfCondition EqualTo(jb, 6) ThenBlock: { jpri = 1 }
                }
                shift = 0
                IfCondition GreaterThan(jstart, kstart) ThenBlock: { shift = 1 }
                IfCondition EqualTo(jstart, kstart) ThenBlock: {
                    IfCondition GreaterThan(jpri, kpri) ThenBlock: { shift = 1 }
                }
                IfCondition EqualTo(shift, 1) ThenBlock: {
                    StoreValue(Add(order, Multiply(Add(j, 1), 8)), jid)
                    j = Subtract(j, 1)
                } ElseBlock: {
                    done = 1
                }
            }
            StoreValue(Add(order, Multiply(Add(j, 1), 8)), kid)
            k = Add(k, 1)
        }

        // GPRs the scan may hand out. A value live across a real call
        // takes only rbx, r12, or r13, and spills at its definition when
        // none of those is free. r14 stays out: the address lowering
        // still writes it, and a later reload of that home undoes an
        // assignment that only updated the register. A value with no
        // real call in its range takes rcx, rdx, rsi, rdi, or r8-r11
        // and is not saved around a call. rbx stays off this list when
        // the body does not scratch it; a call-crossing name is offered
        // it anyway. r15 is the FixedPool base and is not a value home.
        // rax stays the accumulator. XMM numbers are 32+xmm.
        hold_rbx = 0
        IfCondition NotEqual(ScanState.body, 0) ThenBlock: {
            IfCondition EqualTo(BitwiseAnd(Optimize_ScanLoopMask(ScanState.body), 1), 0) ThenBlock: {
                hold_rbx = 1
            }
        }
        free_g = Allocate(128)
        StoreValue(free_g, Reg.R12)
        StoreValue(Add(free_g, 8), Reg.R13)
        StoreValue(Add(free_g, 16), Reg.R10)
        StoreValue(Add(free_g, 24), Reg.R8)
        StoreValue(Add(free_g, 32), Reg.R9)
        StoreValue(Add(free_g, 40), Reg.RSI)
        StoreValue(Add(free_g, 48), Reg.RDI)
        StoreValue(Add(free_g, 56), Reg.RDX)
        StoreValue(Add(free_g, 64), Reg.RCX)
        StoreValue(Add(free_g, 72), Reg.R11)
        free_n_g = 10
        IfCondition EqualTo(hold_rbx, 0) ThenBlock: {
            StoreValue(Add(free_g, 80), Reg.RBX)
            free_n_g = 11
        }
        // xmm4-xmm14. xmm0/xmm1/xmm15 are the expression scratch.
        // xmm2/xmm3 are the scratch the string and byte loops already use.
        // The number stored is 32+xmm so it never compares equal to a GPR.
        free_x = Allocate(128)
        xi = 0
        WhileLoop LessThan(xi, 11) {
            // Pop takes the tail, so xmm4 is handed out before xmm14.
            // Low xmm numbers need no REX prefix on the float ops.
            StoreValue(Add(free_x, Multiply(xi, 8)), Add(36, Subtract(10, xi)))
            xi = Add(xi, 1)
        }
        free_n_x = 11

        // A loop pays one push for the whole function. A straight-line
        // call pays it on every entry, so only a name still live after
        // a call gets rbx/r12/r13. UNTIL sets the walk bit and not
        // has_loop.
        loop_fn = CFGState.has_loop
        IfCondition NotEqual(ScanState.body, 0) ThenBlock: {
            IfCondition NotEqual(BitwiseAnd(CompileFunc_CalleeWalk(ScanState.body, 1), 8), 0) ThenBlock: {
                loop_fn = 1
            }
        }

        active_id_g = Allocate(128)
        active_end_g = Allocate(128)
        active_n_g = 0
        active_id_x = Allocate(128)
        active_end_x = Allocate(128)
        active_n_x = 0

        idx = 0
        WhileLoop LessThan(idx, n) {
            cur_id = Dereference(Add(order, Multiply(idx, 8)))
            is_x = 0
            skip = 0
            IfCondition NotEqual(ScanState.flt, 0) ThenBlock: {
                fb = GetByte(ScanState.flt, Subtract(cur_id, 1))
                IfCondition EqualTo(fb, 1) ThenBlock: { is_x = 1 }
                IfCondition EqualTo(fb, 5) ThenBlock: { is_x = 1 }
                IfCondition EqualTo(fb, 6) ThenBlock: { is_x = 1 }
                IfCondition EqualTo(fb, 3) ThenBlock: { skip = 1 }
                // 4 is a one-use FromInt or Div. It may take an xmm
                // only after this pass, and only one nobody else holds
                // for its whole live range. It never evicts.
                IfCondition EqualTo(fb, 4) ThenBlock: { skip = 1 }
            }
            // Kind 1 is a real call in the live range: callee-saved only.
            // That assignment wins over kind 0. Kind 0 is a straight-line
            // name that is not live after any call. Kind 2 is everything
            // else, and it prefers caller-saved registers. The block
            // mark treats every name in a call block as crossing. A
            // straight-line name that is dead when the call returns,
            // and is not an operand beside that call, does not. The
            // prologue then does not push a register for it. Floats
            // use the same kinds: a call-crossing float takes xmm6-xmm14,
            // which the prologue saves. xmm4 and xmm5 are caller-saved.
            gkind = 2
            IfCondition EqualTo(loop_fn, 0) ThenBlock: {
                IfCondition EqualTo(Optimize_LiveThru(cur_id), 0) ThenBlock: { gkind = 0 }
            }
            IfCondition EqualTo(Optimize_LiveCrossesCall(cur_id), 1) ThenBlock: { gkind = 1 }
            IfCondition EqualTo(gkind, 1) ThenBlock: {
                IfCondition EqualTo(loop_fn, 0) ThenBlock: {
                    IfCondition EqualTo(Optimize_LiveThru(cur_id), 0) ThenBlock: {
                        IfCondition EqualTo(Optimize_LiveCallKeep(cur_id), 0) ThenBlock: {
                            gkind = 0
                        }
                    }
                }
            }
            IfCondition EqualTo(skip, 1) ThenBlock: {
                idx = Add(idx, 1)
                ContinueLoop
            }
            free_regs = free_g
            free_n = free_n_g
            active_id = active_id_g
            active_end = active_end_g
            active_n = active_n_g
            IfCondition EqualTo(is_x, 1) ThenBlock: {
                free_regs = free_x
                free_n = free_n_x
                active_id = active_id_x
                active_end = active_end_x
                active_n = active_n_x
            }
            cur_ptr = Optimize_ScanPtr(cur_id)
            cur_start = Dereference(cur_ptr)
            cur_end = Dereference(Add(cur_ptr, 8))

            // Expire active intervals that ended before this one starts.
            a = 0
            WhileLoop LessThan(a, active_n) {
                IfCondition LessThan(Dereference(Add(active_end, Multiply(a, 8))), cur_start) ThenBlock: {
                    ex_id = Dereference(Add(active_id, Multiply(a, 8)))
                    ex_reg = Dereference(Add(Optimize_ScanPtr(ex_id), 16))
                    StoreValue(Add(free_regs, Multiply(free_n, 8)), ex_reg)
                    free_n = Add(free_n, 1)
                    // swap-remove a from active
                    last = Subtract(active_n, 1)
                    StoreValue(Add(active_id, Multiply(a, 8)), Dereference(Add(active_id, Multiply(last, 8))))
                    StoreValue(Add(active_end, Multiply(a, 8)), Dereference(Add(active_end, Multiply(last, 8))))
                    active_n = last
                } ElseBlock: {
                    a = Add(a, 1)
                }
            }

            IfCondition EqualTo(is_x, 0) ThenBlock: {
                IfCondition EqualTo(gkind, 1) ThenBlock: {
                    free_n = Optimize_ScanOfferReg(free_regs, free_n, Reg.RBX, active_id, active_n)
                }
            }
            IfCondition GreaterThan(free_n, 0) ThenBlock: {
                IfCondition EqualTo(is_x, 1) ThenBlock: {
                    // A float live across a call cannot take xmm4 or xmm5.
                    // The loop spill runs again on the back edge, after
                    // the call has overwritten a caller-saved xmm, and
                    // that store replaces the frame value. xmm6-xmm14
                    // are saved by the callee. If none is free the name
                    // stays on the frame.
                    IfCondition EqualTo(gkind, 1) ThenBlock: {
                        free_n = Optimize_ScanTakeCalleeXmm(free_regs, free_n)
                        IfCondition NotEqual(ScanState.pick, -1) ThenBlock: {
                            StoreValue(Add(cur_ptr, 16), ScanState.pick)
                            StoreValue(Add(active_id, Multiply(active_n, 8)), cur_id)
                            StoreValue(Add(active_end, Multiply(active_n, 8)), cur_end)
                            active_n = Add(active_n, 1)
                        }
                    } ElseBlock: {
                        free_n = Subtract(free_n, 1)
                        reg = Dereference(Add(free_regs, Multiply(free_n, 8)))
                        StoreValue(Add(cur_ptr, 16), reg)
                        StoreValue(Add(active_id, Multiply(active_n, 8)), cur_id)
                        StoreValue(Add(active_end, Multiply(active_n, 8)), cur_end)
                        active_n = Add(active_n, 1)
                    }
                } ElseBlock: {
                    // A straight-line parameter that does not survive a
                    // call already sits in its argument register. Taking
                    // that register skips the prologue copy to the frame.
                    ScanState.pick = -1
                    IfCondition EqualTo(gkind, 0) ThenBlock: {
                        preg = Optimize_ScanParamReg(cur_id)
                        IfCondition GreaterEqual(preg, 0) ThenBlock: {
                            pblock = BitwiseAnd(Optimize_ScanForbidOf(cur_id), LeftShift(1, preg))
                            IfCondition EqualTo(pblock, 0) ThenBlock: {
                                pat = Optimize_ScanFindFree(free_regs, free_n, preg)
                                IfCondition GreaterEqual(pat, 0) ThenBlock: {
                                    free_n = Optimize_ScanDropFree(free_regs, free_n, pat)
                                    ScanState.pick = preg
                                }
                            }
                        }
                    }
                    IfCondition EqualTo(ScanState.pick, -1) ThenBlock: {
                        free_n = Optimize_ScanTake(free_regs, free_n, gkind, 0, Optimize_ScanForbidOf(cur_id))
                    }
                    IfCondition NotEqual(ScanState.pick, -1) ThenBlock: {
                        StoreValue(Add(cur_ptr, 16), ScanState.pick)
                        StoreValue(Add(active_id, Multiply(active_n, 8)), cur_id)
                        StoreValue(Add(active_end, Multiply(active_n, 8)), cur_end)
                        active_n = Add(active_n, 1)
                    }
                }
            }
            IfCondition EqualTo(Optimize_ScanReg(cur_id), -1) ThenBlock: {
                IfCondition EqualTo(is_x, 0) ThenBlock: {
                    got_ev = Optimize_ScanEvict(active_id, active_end, active_n, cur_id, cur_end, cur_start)
                    IfCondition EqualTo(got_ev, 0) ThenBlock: {
                        free_n = Optimize_ScanTake(free_regs, free_n, gkind, 1, Optimize_ScanForbidOf(cur_id))
                        IfCondition NotEqual(ScanState.pick, -1) ThenBlock: {
                            StoreValue(Add(cur_ptr, 16), ScanState.pick)
                            StoreValue(Add(active_id, Multiply(active_n, 8)), cur_id)
                            StoreValue(Add(active_end, Multiply(active_n, 8)), cur_end)
                            active_n = Add(active_n, 1)
                        } ElseBlock: {
                            StoreValue(Add(cur_ptr, 16), -1)
                        }
                    }
                } ElseBlock: {
                // Keep the name the inner loop reloads most. An in-place
                // field update counts four times, so a velocity beats a
                // one-shot position. Equal cost falls back to next use.
                // A header use is numbered before the body, so LiveNext
                // misses it. Live-out of this block is that back edge.
                cur_next = Optimize_ScanNext(cur_id, cur_start)
                cur_cost = Optimize_ScanSpillCost(cur_id)
                drop_a = -1
                drop_next = cur_next
                drop_cost = cur_cost
                // 0 none, 1 a colder induction var, 2 a non-induction var.
                // A non-induction var wins. An inner counter can take the
                // register from an outer one only when its cost is higher.
                drop_kind = 0
                a = 0
                WhileLoop LessThan(a, active_n) {
                    aid = Dereference(Add(active_id, Multiply(a, 8)))
                    an = Optimize_ScanNext(aid, cur_start)
                    ac = Optimize_ScanSpillCost(aid)
                    take = 0
                    kind = 0
                    IfCondition EqualTo(Optimize_ScanIsIv(cur_id), 1) ThenBlock: {
                        IfCondition EqualTo(Optimize_ScanIsIv(aid), 0) ThenBlock: {
                            vr = Optimize_ScanReg(aid)
                            hit = 0
                            IfCondition EqualTo(vr, Reg.R12) ThenBlock: { hit = 1 }
                            IfCondition EqualTo(vr, Reg.R13) ThenBlock: { hit = 1 }
                            IfCondition EqualTo(hit, 1) ThenBlock: {
                                IfCondition EqualTo(drop_kind, 2) ThenBlock: {
                                    IfCondition GreaterThan(an, drop_next) ThenBlock: {
                                        take = 1
                                        kind = 2
                                    }
                                }
                                IfCondition NotEqual(drop_kind, 2) ThenBlock: {
                                    take = 1
                                    kind = 2
                                }
                            }
                        }
                        IfCondition EqualTo(Optimize_ScanIsIv(aid), 1) ThenBlock: {
                            IfCondition NotEqual(drop_kind, 2) ThenBlock: {
                                vr2 = Optimize_ScanReg(aid)
                                hit2 = 0
                                IfCondition EqualTo(vr2, Reg.R12) ThenBlock: { hit2 = 1 }
                                IfCondition EqualTo(vr2, Reg.R13) ThenBlock: { hit2 = 1 }
                                IfCondition EqualTo(hit2, 1) ThenBlock: {
                                    IfCondition LessThan(ac, cur_cost) ThenBlock: {
                                        IfCondition EqualTo(drop_kind, 0) ThenBlock: { take = 1 }
                                        IfCondition LessThan(ac, drop_cost) ThenBlock: { take = 1 }
                                        IfCondition EqualTo(take, 1) ThenBlock: { kind = 1 }
                                    }
                                }
                            }
                        }
                    } ElseBlock: {
                        IfCondition EqualTo(Optimize_ScanIsIv(aid), 0) ThenBlock: {
                            IfCondition EqualTo(Optimize_ScanIsBase(aid), 0) ThenBlock: {
                                IfCondition EqualTo(is_x, 1) ThenBlock: {
                                    IfCondition GreaterThan(an, drop_next) ThenBlock: { take = 1 }
                                    // Do not steal xmm4 or xmm5 for a
                                    // float that is live across a call.
                                    IfCondition EqualTo(gkind, 1) ThenBlock: {
                                        fv = Optimize_ScanReg(aid)
                                        IfCondition LessThan(fv, 38) ThenBlock: { take = 0 }
                                    }
                                }
                                IfCondition EqualTo(is_x, 0) ThenBlock: {
                                    IfCondition LessThan(ac, drop_cost) ThenBlock: { take = 1 }
                                    IfCondition EqualTo(ac, drop_cost) ThenBlock: {
                                        IfCondition GreaterThan(an, drop_next) ThenBlock: { take = 1 }
                                    }
                                }
                            }
                        }
                    }
                    IfCondition EqualTo(take, 1) ThenBlock: {
                        drop_next = an
                        drop_cost = ac
                        drop_a = a
                        IfCondition NotEqual(kind, 0) ThenBlock: { drop_kind = kind }
                    }
                    a = Add(a, 1)
                }
                IfCondition GreaterEqual(drop_a, 0) ThenBlock: {
                    drop_id = Dereference(Add(active_id, Multiply(drop_a, 8)))
                    reg = Dereference(Add(Optimize_ScanPtr(drop_id), 16))
                    StoreValue(Add(Optimize_ScanPtr(drop_id), 16), -1)
                    StoreValue(Add(cur_ptr, 16), reg)
                    StoreValue(Add(active_id, Multiply(drop_a, 8)), cur_id)
                    StoreValue(Add(active_end, Multiply(drop_a, 8)), cur_end)
                } ElseBlock: {
                    StoreValue(Add(cur_ptr, 16), -1)
                }
                }
            }
            IfCondition EqualTo(is_x, 1) ThenBlock: {
                free_n_x = free_n
                active_n_x = active_n
            } ElseBlock: {
                free_n_g = free_n
                active_n_g = active_n
            }
            idx = Add(idx, 1)
        }

        // rbx was not in the free list. Give it to the unassigned IV
        // that would spill the most, unless a parked GetByte index is
        // still on the frame. VM Run's pc beats c.
        best = 0
        best_c = -1
        best_d = -1
        gi = 1
        WhileLoop LessThan(gi, Add(TagState.nnames, 1)) {
            IfCondition EqualTo(Optimize_ScanIsIv(gi), 1) ThenBlock: {
                IfCondition EqualTo(Optimize_ScanReg(gi), -1) ThenBlock: {
                    IfCondition NotEqual(Optimize_LiveMaxPos(gi), -1) ThenBlock: {
                        gd = Optimize_LiveDepth(gi)
                        gc = Optimize_ScanSpillCost(gi)
                        better = 0
                        IfCondition GreaterThan(gd, best_d) ThenBlock: { better = 1 }
                        IfCondition EqualTo(gd, best_d) ThenBlock: {
                            IfCondition GreaterThan(gc, best_c) ThenBlock: { better = 1 }
                        }
                        IfCondition EqualTo(better, 1) ThenBlock: {
                            best_d = gd
                            best_c = gc
                            best = gi
                        }
                    }
                }
            }
            gi = Add(gi, 1)
        }
        IfCondition EqualTo(hold_rbx, 1) ThenBlock: {
            gb = Optimize_ScanGbIdx(ScanState.body)
            IfCondition NotEqual(gb, 0) ThenBlock: {
                best = gb
            }
        }
        // The counter already took r12 or r13, so the reserved rbx
        // would sit idle while the accumulator spills. The mask said
        // nothing scratches rbx, so the hottest spilled integer can
        // have it. Float names stay on the xmm list.
        IfCondition EqualTo(hold_rbx, 1) ThenBlock: {
            IfCondition EqualTo(best, 0) ThenBlock: {
                best_c = -1
                best_d = -1
                gi = 1
                WhileLoop LessThan(gi, Add(TagState.nnames, 1)) {
                    IfCondition EqualTo(Optimize_ScanReg(gi), -1) ThenBlock: {
                        IfCondition NotEqual(Optimize_LiveMaxPos(gi), -1) ThenBlock: {
                            flt_skip = 0
                            IfCondition NotEqual(ScanState.flt, 0) ThenBlock: {
                                IfCondition NotEqual(GetByte(ScanState.flt, Subtract(gi, 1)), 0) ThenBlock: {
                                    flt_skip = 1
                                }
                            }
                            IfCondition EqualTo(flt_skip, 0) ThenBlock: {
                                gd = Optimize_LiveDepth(gi)
                                gc = Optimize_ScanSpillCost(gi)
                                better = 0
                                IfCondition GreaterThan(gd, best_d) ThenBlock: { better = 1 }
                                IfCondition EqualTo(gd, best_d) ThenBlock: {
                                    IfCondition GreaterThan(gc, best_c) ThenBlock: { better = 1 }
                                }
                                IfCondition EqualTo(better, 1) ThenBlock: {
                                    best_d = gd
                                    best_c = gc
                                    best = gi
                                }
                            }
                        }
                    }
                    gi = Add(gi, 1)
                }
            }
        }
        IfCondition EqualTo(hold_rbx, 1) ThenBlock: {
            IfCondition NotEqual(best, 0) ThenBlock: {
                owned = 0
                oi = 1
                WhileLoop LessThan(oi, Add(TagState.nnames, 1)) {
                    IfCondition EqualTo(Optimize_ScanReg(oi), Reg.RBX) ThenBlock: {
                        IfCondition NotEqual(Optimize_LiveMaxPos(oi), -1) ThenBlock: { owned = 1 }
                    }
                    oi = Add(oi, 1)
                }
                give = 1
                IfCondition EqualTo(owned, 1) ThenBlock: { give = 0 }
                IfCondition EqualTo(loop_fn, 0) ThenBlock: {
                    IfCondition EqualTo(Optimize_LiveThru(best), 0) ThenBlock: { give = 0 }
                }
                // A block-level cross mark is not enough. A straight-line
                // name that is dead when the call returns stays spilled.
                // Handing it rbx would push rbx on every entry.
                IfCondition EqualTo(Optimize_LiveCrossesCall(best), 1) ThenBlock: {
                    give = 1
                    IfCondition EqualTo(owned, 1) ThenBlock: { give = 0 }
                    IfCondition EqualTo(loop_fn, 0) ThenBlock: {
                        IfCondition EqualTo(Optimize_LiveThru(best), 0) ThenBlock: {
                            IfCondition EqualTo(Optimize_LiveCallKeep(best), 0) ThenBlock: {
                                give = 0
                            }
                        }
                    }
                }
                IfCondition NotEqual(BitwiseAnd(Optimize_ScanForbidOf(best), LeftShift(1, Reg.RBX)), 0) ThenBlock: {
                    give = 0
                }
                IfCondition EqualTo(give, 1) ThenBlock: {
                    StoreValue(Add(Optimize_ScanPtr(best), 16), Reg.RBX)
                }
            }
        }

        // One-use conversions take a register that stayed idle across
        // their whole range. The hot names already finished, so this
        // cannot spill cr the way an early 4.0 did.
        Optimize_ScanFltFill()

        // The free list has already been consumed. hold_rbx is the
        // same value the pool was built from: 1 means rbx was kept
        // out and may have been given back above.
        Optimize_ScanDump(hold_rbx)

        Deallocate(order, Multiply(128, 8))
        Deallocate(free_g, 128)
        Deallocate(free_x, 128)
        Deallocate(active_id_g, 128)
        Deallocate(active_end_g, 128)
        Deallocate(active_id_x, 128)
        Deallocate(active_end_x, 128)
        ReturnValue(0)
    }
}

// 1 when some live name already holds reg across [start, end].
// A dead name can still show a register from the previous function.
Function.Optimize_ScanXmmBusy {
    Input: reg: Integer
    Input: start: Integer
    Input: end: Integer
    Output: Integer
    Body: {
        j = 1
        last = Add(TagState.nnames, 1)
        WhileLoop LessThan(j, last) {
            IfCondition NotEqual(Optimize_LiveMaxPos(j), -1) ThenBlock: {
                IfCondition EqualTo(Optimize_ScanReg(j), reg) ThenBlock: {
                    jp = Optimize_ScanPtr(j)
                    js = Dereference(jp)
                    je = Dereference(Add(jp, 8))
                    hit = 1
                    IfCondition LessThan(je, start) ThenBlock: { hit = 0 }
                    IfCondition GreaterThan(js, end) ThenBlock: { hit = 0 }
                    IfCondition EqualTo(hit, 1) ThenBlock: { ReturnValue(1) }
                }
            }
            j = Add(j, 1)
        }
        ReturnValue(0)
    }
}

// Lowest idle pool xmm for this range, or -1. xmm4 is 36.
Function.Optimize_ScanXmmSpare {
    Input: start: Integer
    Input: end: Integer
    Output: Integer
    Body: {
        reg = 36
        WhileLoop LessEqual(reg, 46) {
            IfCondition EqualTo(Optimize_ScanXmmBusy(reg, start, end), 0) ThenBlock: {
                ReturnValue(reg)
            }
            reg = Add(reg, 1)
        }
        ReturnValue(-1)
    }
}

// 1 when this name is born before some later block and is still
// live there. A FromInt computed and consumed inside one loop body
// stays folded into that statement.
Function.Optimize_ScanFltInvariant {
    Input: id: Integer
    Output: Integer
    Body: {
        st = Optimize_LiveMinPos(id)
        en = Optimize_LiveMaxPos(id)
        IfCondition LessThan(st, 0) ThenBlock: { ReturnValue(0) }
        b = 0
        WhileLoop LessThan(b, BlockPool.head) {
            ps = Optimize_CFGPosStart(b)
            IfCondition GreaterThan(ps, 0) ThenBlock: {
                IfCondition LessThan(st, ps) ThenBlock: {
                    IfCondition GreaterEqual(en, ps) ThenBlock: { ReturnValue(1) }
                }
            }
            b = Add(b, 1)
        }
        ReturnValue(0)
    }
}

// Hand leftover xmms to one-use float conversions that live into a
// later block. Highest spill cost first. Never spills a name the
// main pass kept, and never homes a conversion the inner loop folds.
Function.Optimize_ScanFltFill {
    Body: {
        IfCondition EqualTo(ScanState.flt, 0) ThenBlock: { ReturnValue(0) }
        guard = 0
        WhileLoop LessThan(guard, 11) {
            best = 0
            best_cost = -1
            i = 1
            last = Add(TagState.nnames, 1)
            WhileLoop LessThan(i, last) {
                fb = GetByte(ScanState.flt, Subtract(i, 1))
                IfCondition EqualTo(fb, 4) ThenBlock: {
                    IfCondition EqualTo(Optimize_ScanReg(i), -1) ThenBlock: {
                        IfCondition EqualTo(Optimize_ScanFltInvariant(i), 1) ThenBlock: {
                            ip = Optimize_ScanPtr(i)
                            ist = Dereference(ip)
                            ien = Dereference(Add(ip, 8))
                            IfCondition LessEqual(ist, ien) ThenBlock: {
                                IfCondition NotEqual(Optimize_ScanXmmSpare(ist, ien), -1) ThenBlock: {
                                    ic = Optimize_ScanSpillCost(i)
                                    IfCondition GreaterThan(ic, best_cost) ThenBlock: {
                                        best = i
                                        best_cost = ic
                                    }
                                }
                            }
                        }
                    }
                }
                i = Add(i, 1)
            }
            IfCondition EqualTo(best, 0) ThenBlock: { ReturnValue(0) }
            bp = Optimize_ScanPtr(best)
            reg = Optimize_ScanXmmSpare(Dereference(bp), Dereference(Add(bp, 8)))
            IfCondition EqualTo(reg, -1) ThenBlock: { ReturnValue(0) }
            StoreValue(Add(bp, 16), reg)
            guard = Add(guard, 1)
        }
        ReturnValue(0)
    }
}

// 1 when this register was assigned to any interval in the function
// just scanned - the structural replacement for the hand-maintained
// push rbx/push r12 list (C2) and for CompileFunc_HasCalls's
// leaf/non-leaf guess (C8): a function is a true leaf iff no interval
// anywhere in it ever crossed a call, which Optimize_LiveCrossesCall
// already answers per-name directly.
Function.Optimize_ScanRegUsed {
    Input: reg: Integer
    Output: Integer
    Body: {
        i = 1
        WhileLoop LessThan(i, Add(TagState.nnames, 1)) {
            IfCondition EqualTo(Optimize_ScanReg(i), reg) ThenBlock: { ReturnValue(1) }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

// reg number to the SysV name. Unknown numbers print as a decimal.
Function.Optimize_ScanRegText {
    Input: reg: Integer
    Body: {
        IfCondition EqualTo(reg, -1) ThenBlock: {
            PrintMessage("SPILL")
            ReturnValue(0)
        }
        IfCondition EqualTo(reg, 0) ThenBlock: { PrintMessage("rax") }
        IfCondition EqualTo(reg, 1) ThenBlock: { PrintMessage("rcx") }
        IfCondition EqualTo(reg, 2) ThenBlock: { PrintMessage("rdx") }
        IfCondition EqualTo(reg, 3) ThenBlock: { PrintMessage("rbx") }
        IfCondition EqualTo(reg, 6) ThenBlock: { PrintMessage("rsi") }
        IfCondition EqualTo(reg, 7) ThenBlock: { PrintMessage("rdi") }
        IfCondition EqualTo(reg, 8) ThenBlock: { PrintMessage("r8") }
        IfCondition EqualTo(reg, 9) ThenBlock: { PrintMessage("r9") }
        IfCondition EqualTo(reg, 10) ThenBlock: { PrintMessage("r10") }
        IfCondition EqualTo(reg, 11) ThenBlock: { PrintMessage("r11") }
        IfCondition EqualTo(reg, 12) ThenBlock: { PrintMessage("r12") }
        IfCondition EqualTo(reg, 13) ThenBlock: { PrintMessage("r13") }
        IfCondition EqualTo(reg, 14) ThenBlock: { PrintMessage("r14") }
        IfCondition EqualTo(reg, 15) ThenBlock: { PrintMessage("r15") }
        named = 0
        IfCondition EqualTo(reg, 0) ThenBlock: { named = 1 }
        IfCondition EqualTo(reg, 1) ThenBlock: { named = 1 }
        IfCondition EqualTo(reg, 2) ThenBlock: { named = 1 }
        IfCondition EqualTo(reg, 3) ThenBlock: { named = 1 }
        IfCondition GreaterEqual(reg, 6) ThenBlock: {
            IfCondition LessEqual(reg, 15) ThenBlock: { named = 1 }
        }
        IfCondition EqualTo(named, 0) ThenBlock: { PrintNumber(reg) }
        ReturnValue(0)
    }
}

// Prints the GPR pool this run was allowed to hand out, then every
// live name. Stack slots are assigned later, during frame layout, so
// a spill here is SPILL rather than an rbp offset.
Function.Optimize_ScanDump {
    Input: hold_rbx: Integer
    Body: {
        IfCondition EqualTo(Compile.current_func, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(StringCompare(AST_GetData1(Compile.current_func), "Fannkuch"), 0) ThenBlock: {
            ReturnValue(0)
        }
        PrintMessage("[SCAN] func ")
        PrintString(AST_GetData1(Compile.current_func))
        PrintMessage("\n")
        PrintMessage("[SCAN] pool r12 r13 r10 r8 r9 rsi rdi rdx rcx r11")
        IfCondition EqualTo(hold_rbx, 0) ThenBlock: {
            PrintMessage(" rbx")
        }
        PrintMessage("\n")
        PrintMessage("[SCAN] r15 is the pool base and is not a value home. rax is the accumulator.\n")
        PrintMessage("[SCAN] call-crossing homes are r12 r13 rbx. r14 stays the address temporary. otherwise the value spills at its definition.\n")
        i = 1
        WhileLoop LessThan(i, Add(TagState.nnames, 1)) {
            IfCondition NotEqual(Optimize_LiveMaxPos(i), -1) ThenBlock: {
                PrintMessage("  ")
                IfCondition NotEqual(TagState.names, 0) ThenBlock: {
                    PrintString(Dereference(Add(TagState.names, Multiply(Subtract(i, 1), 8))))
                }
                PrintMessage(" #")
                PrintNumber(i)
                PrintMessage(" [")
                PrintNumber(Optimize_LiveMinPos(i))
                PrintMessage("..")
                PrintNumber(Optimize_LiveMaxPos(i))
                PrintMessage("] ")
                reg = Optimize_ScanReg(i)
                Optimize_ScanRegText(reg)
                PrintMessage(" cost=")
                PrintNumber(Optimize_ScanSpillCost(i))
                PrintMessage(" depth=")
                PrintNumber(Optimize_LiveDepth(i))
                IfCondition EqualTo(Optimize_LiveCrossesCall(i), 1) ThenBlock: {
                    PrintMessage(" crosses-call")
                }
                IfCondition EqualTo(Optimize_ScanIsIv(i), 1) ThenBlock: {
                    PrintMessage(" iv")
                }
                PrintMessage("\n")
            }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

// =============================================================================
// GATED CONSUMER WIRING (first rollout slice)
//
// CompileExpr_LoadVariable/StoreVariable (Library.CCompileExpr.ailang)
// call Optimize_ScanTryLoad/Optimize_ScanNoteStore/Optimize_ScanSeedLoad
// as their very last option, after every existing mechanism has already
// had a chance (Optimize_RaxTake, Optimize_LocLoad/Store - inactive
// outside a loop anyway, since LoopHome.active stays 0 - Optimize_
// HomeLoad/Store, Optimize_ReloadLoad, ...). Those hooks are no-ops
// unless Optimize_ScanArm has armed this function and AILANG_LINSCAN=1
// is set. If/Fork/While/ForEvery/Switch are modeled by the CFG. Switch
// joins use ScanMatSnapshot/Restore/MergeAnd in CompileStmt_Switch*.
//
// Correctness design: every store still writes the RBP-relative stack
// slot exactly as before (nothing here ever skips that) and also
// copies RAX into the assigned register, marking it "materialized".
// A load only reads the register once it is marked materialized -
// otherwise it falls through to the normal stack load, which then
// seeds the register for every later read. The stack slot and the
// register are therefore always in sync by construction; the register
// is purely a cache to skip redundant memory loads, never a second
// source of truth.
// =============================================================================

Function.Optimize_ScanWantUse {
    Output: Integer
    Body: {
        IfCondition GreaterEqual(ScanState.want, 0) ThenBlock: { ReturnValue(ScanState.want) }
        ScanState.want = 0
        envpath = "/proc/self/environ"
        env_fd = SystemCall(2, envpath, 0, 0)
        IfCondition LessThan(env_fd, 0) ThenBlock: { ReturnValue(0) }
        env_bufsz = 131072
        env_buf = Allocate(env_bufsz)
        env_n = SystemCall(0, env_fd, env_buf, env_bufsz)
        SystemCall(3, env_fd, 0, 0)
        needle = "AILANG_LINSCAN="
        nlen = 15
        found = 0
        ei = 0
        elimit = Subtract(env_n, nlen)
        WhileLoop LessEqual(ei, elimit) {
            IfCondition EqualTo(found, 1) ThenBlock: { ExitLoop }
            match = 1
            ej = 0
            WhileLoop LessThan(ej, nlen) {
                bc = GetByte(env_buf, Add(ei, ej))
                nc = GetByte(needle, ej)
                IfCondition NotEqual(bc, nc) ThenBlock: { match = 0 }
                ej = Add(ej, 1)
            }
            IfCondition EqualTo(match, 1) ThenBlock: {
                vc = GetByte(env_buf, Add(ei, nlen))
                IfCondition EqualTo(vc, 49) ThenBlock: { ScanState.want = 1 }
                found = 1
            }
            ei = Add(ei, 1)
        }
        Deallocate(env_buf, env_bufsz)
        ReturnValue(ScanState.want)
    }
}

// Call once per function, after Optimize_ScanRun, right before
// statement compilation begins (same point CompileFunc_Function/
// SubRoutine already call Optimize_ScanRun from).
//
// If/Fork/While/ForEvery/Switch functions are eligible. Merge points
// use Optimize_ScanMatSnapshot/Restore/MergeAnd in CompileStmt_If,
// CompileStmt_Fork, and CompileStmt_Switch*: a name stays
// materialized only when every arm left it that way. Emitters still use rbx/r12/r13/r14 as scratch
// (StoreValue's value register is rbx). Optimize_ScanNoteAsm and
// Optimize_ScanClobberReg clear the materialized bit on those
// writes. The next load reads the stack slot and reseeds.
//
// Independently of block shape: inline asm (ASM) can write any
// register or memory address without going through CompileExpr_
// StoreVariable at all, and AddressOf (ESCAPE) hands out one of this
// function's own locals' stack addresses, which can then be written
// through a raw pointer later with no way for Optimize_ScanInvalidate
// to see it coming. CLOBBER covers the existing HomeBlockNode list for
// the same reason. All three are already aggregated into body's own
// tag record by Optimize_TagWalk (bottom-up OR of every descendant),
// so this is a single O(1) read, not a new tree walk.
// AST.TRY is modeled by the CFG builder (sequential try-then-finally,
// matching what actually executes today) so it is NOT in this list.
//
// AST.WHILE and AST.FOR_EVERY are modeled by the CFG and are eligible.
// LoopHome stays off for the whole function while this allocator is
// active (CompileStmt_While sets outer). The materialized-bit walk is
// still one forward pass: it does not follow the back edge. A header
// emitted while a name is materialized keeps reading that register on
// every iteration, including after the body has killed it. Allocate
// and any >6-arg call do `mov r12, rsp`, and ordinary compares do
// `mov rbx, rax`. CompileStmt_While / CompileStmt_ForEvery therefore
// spill homes whose registers the body scratches, then compile the
// header to reload those from the frame. Assignments of those names
// still store. A name in a register the body leaves alone is updated
// in the register only; the loop-exit spill writes it back.
//
// Everything else here has no CFG builder support at all - it would
// fall into Optimize_CFGWalkStmt's "one atomic program point" catch-
// all, which is wrong whenever the construct has its own internal
// repetition or branching this pass doesn't know about.
Function.Optimize_ScanUnmodeled {
    Input: node: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        nt = AST_GetType(node)
        IfCondition EqualTo(nt, AST.UNTIL) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(nt, AST.LOOP_MAIN) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(nt, AST.LOOP_ACTOR) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(nt, AST.LOOP_START) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(nt, AST.LOOP_SHADOW) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(nt, AST.WITH_CONTEXT) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(nt, AST.DEFER) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(nt, AST.EVERY_INTERVAL) ThenBlock: { ReturnValue(1) }
        // A CALL with no callee name is some other, rarer call shape
        // (Optimize_TagCall's own name==0 branch treats it as fully
        // unknown - MEM_READ|MEM_WRITE|CALL|CLOBBER). Unlike a named
        // callee, there's nothing to point at to argue it's safe, so
        // it stays excluded here rather than assumed fine.
        IfCondition EqualTo(nt, AST.CALL) ThenBlock: {
            IfCondition EqualTo(AST_GetData1(node), 0) ThenBlock: { ReturnValue(1) }
        }
        count = AST_GetChildCount(node)
        i = 0
        WhileLoop LessThan(i, count) {
            IfCondition EqualTo(Optimize_ScanUnmodeled(AST_GetChild(node, i)), 1) ThenBlock: { ReturnValue(1) }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

Function.Optimize_ScanArm {
    Input: body: Address
    Body: {
        ScanState.eligible = 0
        Optimize_ScanWantUse()
        IfCondition EqualTo(Optimize_ScanUnmodeled(body), 0) ThenBlock: {
            rec = Optimize_TagPtr(body)
            IfCondition NotEqual(rec, 0) ThenBlock: {
                // ASM: raw-hex InlineAsm emits bytes directly, bypassing
                // every instrumented emission path. ESCAPE: AddressOf
                // on one of this function's own locals lets a later
                // indirect write change its stack slot without ever
                // touching the cached register - the stack slot stays
                // correct, but the register goes stale with nothing to
                // notice, since no register write occurred at all. Both
                // are real gaps for this allocator specifically, unlike
                // CLOBBER, which this system never needed: every actual
                // register write is caught reactively at the emission
                // layer regardless of what AILang-level construct
                // caused it, and every construct CLOBBER used to flag
                // via Optimize_HomeBlockNode that still matters here
                // (WHILE/FOR_EVERY/UNTIL/LOOP_*/DEFER/WITH_CONTEXT/
                // EVERY_INTERVAL) is independently excluded above by
                // Optimize_ScanUnmodeled. Switch is modeled by the CFG
                // and joins with ScanMatSnapshot/Restore/MergeAnd.
                unsafe = BitwiseOr(TagBit.ASM, TagBit.ESCAPE)
                IfCondition EqualTo(BitwiseAnd(Dereference(rec), unsafe), 0) ThenBlock: {
                    ScanState.eligible = 1
                }
            }
        }
        IfCondition EqualTo(ScanState.mat, 0) ThenBlock: {
            ScanState.mat = Allocate(128)
        }
        i = 0
        WhileLoop LessThan(i, 128) {
            SetByte(ScanState.mat, i, 0)
            i = Add(i, 1)
        }
        ScanState.keep = 0
        ScanState.loop_mask = 0
        ScanState.save_sp = 0
        ScanState.xmm15_busy = 0
        ScanState.xmm_save_mask = 0
        ScanPtr.rm_n = 0
        Optimize_VerifyReset()
        ReturnValue(0)
    }
}

Function.Optimize_ScanActive {
    Output: Integer
    Body: {
        IfCondition EqualTo(Optimize_ScanWantUse(), 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(ScanState.eligible)
    }
}

Function.Optimize_ScanMatGet {
    Input: id: Integer
    Output: Integer
    Body: {
        IfCondition Or(LessThan(id, 1), GreaterThan(id, 128)) ThenBlock: { ReturnValue(0) }
        ReturnValue(GetByte(ScanState.mat, Subtract(id, 1)))
    }
}

Function.Optimize_ScanMatSet {
    Input: id: Integer
    Body: {
        IfCondition Or(LessThan(id, 1), GreaterThan(id, 128)) ThenBlock: { ReturnValue(0) }
        // One value per register. A later name that reuses the register
        // after this name's last use must not leave the old bit set.
        reg = Optimize_ScanReg(id)
        IfCondition NotEqual(reg, -1) ThenBlock: {
            i = 1
            WhileLoop LessThan(i, Add(TagState.nnames, 1)) {
                IfCondition NotEqual(i, id) ThenBlock: {
                    IfCondition EqualTo(Optimize_ScanReg(i), reg) ThenBlock: {
                        IfCondition EqualTo(Optimize_ScanMatGet(i), 1) ThenBlock: {
                            Optimize_VerifyEnd(i)
                        }
                        SetByte(ScanState.mat, Subtract(i, 1), 0)
                    }
                }
                i = Add(i, 1)
            }
        }
        SetByte(ScanState.mat, Subtract(id, 1), 1)
        ReturnValue(0)
    }
}

// Scale of Add(identifier, Multiply(index, 1|2|4|8)). The constant has
// to sit on the right: that is the form the scaled load and store emit.
// A constant on the left stays 0 and keeps the ordinary rbx charge.
Function.Optimize_ScanScaleOf {
    Input: addr: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(addr, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(addr), AST.CALL) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_NameEq(AST_GetData1(addr), "Add"), 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetChildCount(addr), 2) ThenBlock: { ReturnValue(0) }
        base = AST_GetChild(addr, 0)
        mul = AST_GetChild(addr, 1)
        IfCondition EqualTo(base, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(base), AST.IDENTIFIER) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(mul, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(mul), AST.CALL) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_NameEq(AST_GetData1(mul), "Multiply"), 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetChildCount(mul), 2) ThenBlock: { ReturnValue(0) }
        ReturnValue(Optimize_ScaleValue(AST_GetChild(mul, 1)))
    }
}

// 1 when this call is a scaled qword deref, or a scaled store of a
// name or a number. Those use a SIB base and an index register. They
// do not write rbx. A field store and a store of a computed value do,
// and so does every deref that is not this shape. Children are still
// walked by ScanLoopMask, so a multiply or a call inside the index
// still charges the registers it actually writes.
Function.Optimize_ScanMemRbxFree {
    Input: node: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(node), AST.CALL) ThenBlock: { ReturnValue(0) }
        nm = AST_GetData1(node)
        IfCondition EqualTo(nm, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_NameEq(nm, "Dereference"), 1) ThenBlock: {
            IfCondition EqualTo(AST_GetChildCount(node), 1) ThenBlock: {
                IfCondition NotEqual(Optimize_ScanScaleOf(AST_GetChild(node, 0)), 0) ThenBlock: {
                    ReturnValue(1)
                }
            }
        }
        IfCondition EqualTo(Optimize_NameEq(nm, "StoreValue"), 1) ThenBlock: {
            IfCondition EqualTo(AST_GetChildCount(node), 2) ThenBlock: {
                IfCondition NotEqual(Optimize_ScanScaleOf(AST_GetChild(node, 0)), 0) ThenBlock: {
                    val = AST_GetChild(node, 1)
                    IfCondition NotEqual(val, 0) ThenBlock: {
                        IfCondition EqualTo(AST_GetType(val), AST.IDENTIFIER) ThenBlock: { ReturnValue(1) }
                        IfCondition EqualTo(AST_GetType(val), AST.NUMBER) ThenBlock: { ReturnValue(1) }
                    }
                }
            }
        }
        ReturnValue(0)
    }
}

// Bits of registers the loop body will scratch, so a header must not
// keep reading them. 1 = rbx (address math), 2 = r12 (Allocate's
// mov r12, rsp), 4 = r13 (string helpers). r14 is never a value home.
// Inlined helpers push rbx/r12/r13 and then reuse them. The push runs
// only on the path that executes the helper. A branch that skips it
// must already have those homes in the frame, or the join reloads a
// slot this path never wrote. 1 = rbx, 2 = r12, 4 = r13.
Function.Optimize_ScanStringSmash {
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }
        hit = 0
        IfCondition EqualTo(StringCompare(name, "StringToNumber"), 0) ThenBlock: { hit = 1 }
        IfCondition EqualTo(StringCompare(name, "NumberToString"), 0) ThenBlock: { hit = 1 }
        IfCondition EqualTo(StringCompare(name, "StringConcat"), 0) ThenBlock: { hit = 1 }
        IfCondition EqualTo(StringCompare(name, "StringSubstring"), 0) ThenBlock: { hit = 1 }
        IfCondition EqualTo(StringCompare(name, "StringExtract"), 0) ThenBlock: { hit = 1 }
        IfCondition EqualTo(StringCompare(name, "StringCharAt"), 0) ThenBlock: { hit = 1 }
        IfCondition EqualTo(StringCompare(name, "StringToUpper"), 0) ThenBlock: { hit = 1 }
        IfCondition EqualTo(StringCompare(name, "StringToLower"), 0) ThenBlock: { hit = 1 }
        IfCondition EqualTo(StringCompare(name, "StringTrim"), 0) ThenBlock: { hit = 1 }
        IfCondition EqualTo(StringCompare(name, "StringCopy"), 0) ThenBlock: { hit = 1 }
        IfCondition EqualTo(StringCompare(name, "PrintNumber"), 0) ThenBlock: { hit = 1 }
        IfCondition EqualTo(StringCompare(name, "PrintHex"), 0) ThenBlock: { hit = 1 }
        IfCondition EqualTo(StringCompare(name, "WriteTextFile"), 0) ThenBlock: { hit = 1 }
        IfCondition EqualTo(StringCompare(name, "ReadTextFile"), 0) ThenBlock: { hit = 1 }
        IfCondition EqualTo(StringCompare(name, "Power"), 0) ThenBlock: { hit = 1 }
        IfCondition EqualTo(StringCompare(name, "CopyLinkage"), 0) ThenBlock: { hit = 1 }
        IfCondition EqualTo(StringCompare(name, "CopyLinkageInto"), 0) ThenBlock: { hit = 1 }
        IfCondition EqualTo(StringCompare(name, "CompareLinkage"), 0) ThenBlock: { hit = 1 }
        IfCondition EqualTo(hit, 1) ThenBlock: { ReturnValue(7) }
        IfCondition EqualTo(StringCompare(name, "StringFromChar"), 0) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

Function.Optimize_ScanLoopMask {
    Input: node: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        mask = 0
        IfCondition EqualTo(AST_GetType(node), AST.CALL) ThenBlock: {
            // Divide, Deref, and a call whose setup writes rbx still
            // kill a rbx home. A user function of six or fewer plain
            // args does not: the callee saves rbx, and the arguments
            // land in rdi-r9. r12 and r13 stay reserved for the calls
            // that actually write them. A GetByte whose base is already
            // in r14 does not scratch rbx.
            parked = 0
            nm = AST_GetData1(node)
            IfCondition NotEqual(nm, 0) ThenBlock: {
                IfCondition NotEqual(ScanPtr.byte_name, 0) ThenBlock: {
                    is_byte = 0
                    IfCondition EqualTo(StringCompare(nm, "GetByte"), 0) ThenBlock: { is_byte = 1 }
                    IfCondition EqualTo(StringCompare(nm, "SetByte"), 0) ThenBlock: { is_byte = 1 }
                    IfCondition EqualTo(is_byte, 1) ThenBlock: {
                        IfCondition GreaterThan(AST_GetChildCount(node), 0) ThenBlock: {
                            b = AST_GetChild(node, 0)
                            IfCondition NotEqual(b, 0) ThenBlock: {
                                IfCondition EqualTo(AST_GetType(b), AST.IDENTIFIER) ThenBlock: {
                                    IfCondition EqualTo(Optimize_NameEq(AST_GetData1(b), ScanPtr.byte_name), 1) ThenBlock: {
                                        parked = 1
                                    }
                                }
                            }
                        }
                    }
                }
            }
            IfCondition EqualTo(parked, 0) ThenBlock: {
                is_byte_op = 0
                IfCondition NotEqual(nm, 0) ThenBlock: {
                    IfCondition EqualTo(StringCompare(nm, "GetByte"), 0) ThenBlock: { is_byte_op = 1 }
                    IfCondition EqualTo(StringCompare(nm, "SetByte"), 0) ThenBlock: { is_byte_op = 1 }
                }
                IfCondition EqualTo(is_byte_op, 0) ThenBlock: {
                int_keep = CompileFunc_IntOpName(nm)
                // idiv and two-register imul still shuttle through rbx.
                // imul rax, imm32 does not, so Multiply(x, k) keeps a rbx home.
                IfCondition NotEqual(nm, 0) ThenBlock: {
                    IfCondition EqualTo(StringCompare(nm, "Multiply"), 0) ThenBlock: {
                        int_keep = 0
                        IfCondition EqualTo(AST_GetChildCount(node), 2) ThenBlock: {
                            mt0 = AST_GetType(AST_GetChild(node, 0))
                            mt1 = AST_GetType(AST_GetChild(node, 1))
                            IfCondition EqualTo(mt0, AST.NUMBER) ThenBlock: { int_keep = 1 }
                            IfCondition EqualTo(mt1, AST.NUMBER) ThenBlock: { int_keep = 1 }
                        }
                    }
                    IfCondition EqualTo(StringCompare(nm, "Divide"), 0) ThenBlock: { int_keep = 0 }
                    IfCondition EqualTo(StringCompare(nm, "Modulo"), 0) ThenBlock: { int_keep = 0 }
                }
                IfCondition EqualTo(int_keep, 0) ThenBlock: {
                user_keep = 0
                IfCondition NotEqual(nm, 0) ThenBlock: {
                    IfCondition GreaterEqual(Compile_FindFunction(nm), 0) ThenBlock: {
                        IfCondition LessEqual(AST_GetChildCount(node), 6) ThenBlock: {
                            IfCondition EqualTo(CompileFunc_ArgsPlain(node), 1) ThenBlock: {
                                user_keep = 1
                            }
                        }
                    }
                }
                IfCondition EqualTo(user_keep, 0) ThenBlock: {
                mask = 1
                // A scaled qword deref or a scaled store of a name does
                // not write rbx. Clearing the bit here leaves every
                // other call charged. The child walk below still sees
                // an index expression that does write rbx.
                mem_free = Optimize_ScanMemRbxFree(node)
                IfCondition EqualTo(mem_free, 1) ThenBlock: { mask = 0 }
                IfCondition NotEqual(nm, 0) ThenBlock: {
                    IfCondition EqualTo(StringCompare(nm, "Allocate"), 0) ThenBlock: { mask = BitwiseOr(mask, 2) }
                    IfCondition EqualTo(StringCompare(nm, "Deallocate"), 0) ThenBlock: { mask = BitwiseOr(mask, 2) }
                    rbx = 0
                    IfCondition EqualTo(mem_free, 0) ThenBlock: {
                        IfCondition EqualTo(StringCompare(nm, "Dereference"), 0) ThenBlock: { rbx = 1 }
                        IfCondition EqualTo(StringCompare(nm, "StoreValue"), 0) ThenBlock: { rbx = 1 }
                    }
                    IfCondition EqualTo(StringCompare(nm, "GetByte"), 0) ThenBlock: { rbx = 1 }
                    IfCondition EqualTo(StringCompare(nm, "SetByte"), 0) ThenBlock: { rbx = 1 }
                    IfCondition EqualTo(rbx, 1) ThenBlock: { mask = BitwiseOr(mask, 1) }
                    r13 = 0
                    IfCondition EqualTo(StringCompare(nm, "StringLength"), 0) ThenBlock: { r13 = 1 }
                    IfCondition EqualTo(StringCompare(nm, "StringCompare"), 0) ThenBlock: { r13 = 1 }
                    IfCondition EqualTo(StringCompare(nm, "NumberToString"), 0) ThenBlock: { r13 = 1 }
                    IfCondition EqualTo(r13, 1) ThenBlock: { mask = BitwiseOr(mask, 4) }
                }
                }
                }
                }
            }
        }
        IfCondition EqualTo(AST_GetType(node), AST.CALL) ThenBlock: {
            mask = BitwiseOr(mask, Optimize_ScanStringSmash(AST_GetData1(node)))
        }
        n = AST_GetChildCount(node)
        i = 0
        WhileLoop LessThan(i, n) {
            mask = BitwiseOr(mask, Optimize_ScanLoopMask(AST_GetChild(node, i)))
            i = Add(i, 1)
        }
        ReturnValue(mask)
    }
}

// 1 when [min, max] meets [lo, hi]. A dead name keeps the previous
// function's register number, so a negative max never hits.
Function.Optimize_ScanRangeHit {
    Input: id: Integer
    Input: lo: Integer
    Input: hi: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(id, 1) ThenBlock: { ReturnValue(0) }
        mx = Optimize_LiveMaxPos(id)
        IfCondition LessThan(mx, 0) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(mx, lo) ThenBlock: { ReturnValue(0) }
        mn = Optimize_LiveMinPos(id)
        IfCondition GreaterThan(mn, hi) ThenBlock: { ReturnValue(0) }
        ReturnValue(1)
    }
}

Function.Optimize_ScanPosMin {
    Input: node: Address
    Input: best: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(best) }
        p = Optimize_TagPosOf(node)
        IfCondition GreaterEqual(p, 0) ThenBlock: {
            IfCondition LessThan(p, best) ThenBlock: { best = p }
        }
        n = AST_GetChildCount(node)
        i = 0
        WhileLoop LessThan(i, n) {
            best = Optimize_ScanPosMin(AST_GetChild(node, i), best)
            i = Add(i, 1)
        }
        ReturnValue(best)
    }
}

Function.Optimize_ScanPosMax {
    Input: node: Address
    Input: best: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(best) }
        p = Optimize_TagPosOf(node)
        IfCondition GreaterThan(p, best) ThenBlock: { best = p }
        n = AST_GetChildCount(node)
        i = 0
        WhileLoop LessThan(i, n) {
            best = Optimize_ScanPosMax(AST_GetChild(node, i), best)
            i = Add(i, 1)
        }
        ReturnValue(best)
    }
}

// Two names can share a caller-saved register when their linear ranges
// do not overlap. The body is compiled once, while the carried name is
// still materialized, and a later assignment in that body writes the
// same register. The back edge keeps reading it. revcomp's LCG seed
// and the output byte both landed in r10, so the next trip read the
// byte as the seed (SUM 7416691 XOR 19). Drop every name on a register
// that another name also uses inside this loop. The body reloads the
// frame. spill is 0 on the rotated re-clear: the entry test may have
// warmed the cache, the frame already holds the value, and a spill
// would publish the test's scratch. rbx, r12, and r13 skip the frame
// store unless the mask says the body scratches them, so a shared one
// joins that mask or the slot stays at the pre-loop value.
Function.Optimize_ScanDropCarry {
    Input: lo: Integer
    Input: hi: Integer
    Input: spill: Integer
    Body: {
        IfCondition EqualTo(Optimize_ScanActive(), 0) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterThan(lo, hi) ThenBlock: { ReturnValue(0) }
        i = 1
        last = Add(TagState.nnames, 1)
        WhileLoop LessThan(i, last) {
            reg = Optimize_ScanReg(i)
            hit = 0
            IfCondition GreaterEqual(reg, 0) ThenBlock: {
                IfCondition LessEqual(reg, 15) ThenBlock: {
                    IfCondition EqualTo(Optimize_ScanRangeHit(i, lo, hi), 1) ThenBlock: {
                        hit = 1
                    }
                }
            }
            IfCondition EqualTo(hit, 1) ThenBlock: {
                shared = 0
                j = 1
                WhileLoop LessThan(j, last) {
                    IfCondition NotEqual(j, i) ThenBlock: {
                        IfCondition EqualTo(Optimize_ScanReg(j), reg) ThenBlock: {
                            IfCondition EqualTo(Optimize_ScanRangeHit(j, lo, hi), 1) ThenBlock: {
                                shared = 1
                            }
                        }
                    }
                    j = Add(j, 1)
                }
                IfCondition EqualTo(shared, 1) ThenBlock: {
                    IfCondition EqualTo(Optimize_ScanMatGet(i), 1) ThenBlock: {
                        IfCondition EqualTo(spill, 1) ThenBlock: {
                            Optimize_ScanSpillId(i)
                        }
                        Optimize_VerifyEnd(i)
                    }
                    SetByte(ScanState.mat, Subtract(i, 1), 0)
                    IfCondition EqualTo(reg, Reg.RBX) ThenBlock: {
                        ScanState.loop_mask = BitwiseOr(ScanState.loop_mask, 1)
                    }
                    IfCondition EqualTo(reg, Reg.R12) ThenBlock: {
                        ScanState.loop_mask = BitwiseOr(ScanState.loop_mask, 2)
                    }
                    IfCondition EqualTo(reg, Reg.R13) ThenBlock: {
                        ScanState.loop_mask = BitwiseOr(ScanState.loop_mask, 4)
                    }
                }
            }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

// The header reloads these registers from the frame. Write the current
// value out once, before the label, then compile the header cold.
// Later assignments of these names store, because ScanState.loop_mask
// names the same registers. Names outside the mask stay in the register.
Function.Optimize_ScanDropRegs {
    Input: mask: Integer
    Body: {
        IfCondition EqualTo(Optimize_ScanActive(), 0) ThenBlock: { ReturnValue(0) }
        i = 1
        WhileLoop LessThan(i, 129) {
            reg = Optimize_ScanReg(i)
            drop = 0
            IfCondition EqualTo(reg, Reg.RBX) ThenBlock: {
                IfCondition EqualTo(BitwiseAnd(mask, 1), 1) ThenBlock: { drop = 1 }
            }
            IfCondition EqualTo(reg, Reg.R12) ThenBlock: {
                IfCondition EqualTo(BitwiseAnd(mask, 2), 2) ThenBlock: { drop = 1 }
            }
            IfCondition EqualTo(reg, Reg.R13) ThenBlock: {
                IfCondition EqualTo(BitwiseAnd(mask, 4), 4) ThenBlock: { drop = 1 }
            }
            // Address lowering writes these on every loop. A home left
            // here is reloaded at the header instead of going stale.
            IfCondition EqualTo(reg, Reg.RCX) ThenBlock: { drop = 1 }
            IfCondition EqualTo(reg, Reg.R11) ThenBlock: { drop = 1 }
            IfCondition EqualTo(reg, Reg.R14) ThenBlock: { drop = 1 }
            IfCondition EqualTo(drop, 1) ThenBlock: {
                Optimize_ScanSpillId(i)
                IfCondition EqualTo(Optimize_ScanMatGet(i), 1) ThenBlock: {
                    Optimize_VerifyEnd(i)
                }
                SetByte(ScanState.mat, Subtract(i, 1), 0)
            }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

// Register holding this name right now, if it can be a SIB base.
// 0 means the caller reloads through r14.
Function.Optimize_ScanAddrBase {
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(Optimize_ScanActive(), 0) ThenBlock: { ReturnValue(0) }
        id = Optimize_TagIntern(name)
        IfCondition EqualTo(id, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_ScanMatGet(id), 0) ThenBlock: { ReturnValue(0) }
        reg = Optimize_ScanReg(id)
        ok = 0
        IfCondition EqualTo(reg, Reg.RBX) ThenBlock: { ok = 1 }
        IfCondition EqualTo(reg, Reg.R12) ThenBlock: { ok = 1 }
        IfCondition EqualTo(reg, Reg.R13) ThenBlock: { ok = 1 }
        IfCondition EqualTo(reg, Reg.R10) ThenBlock: { ok = 1 }
        IfCondition EqualTo(reg, Reg.R8) ThenBlock: { ok = 1 }
        IfCondition EqualTo(reg, Reg.R9) ThenBlock: { ok = 1 }
        IfCondition EqualTo(reg, Reg.RSI) ThenBlock: { ok = 1 }
        IfCondition EqualTo(reg, Reg.RDI) ThenBlock: { ok = 1 }
        IfCondition EqualTo(reg, Reg.RDX) ThenBlock: { ok = 1 }
        IfCondition EqualTo(ok, 1) ThenBlock: { ReturnValue(reg) }
        ReturnValue(0)
    }
}

// 1 when compiling this value leaves r14 and rcx alone. A number is
// mov rax, imm. A scan identifier is mov rax, home, or a frame load
// that reseeds that home. RCX and R14 are the scaled address temps,
// so a value that lives there still needs the push around the store.
Function.Optimize_ScanStorePlain {
    Input: value: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(Optimize_ScanActive(), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(value, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(AST_GetType(value), AST.NUMBER) ThenBlock: { ReturnValue(1) }
        IfCondition NotEqual(AST_GetType(value), AST.IDENTIFIER) ThenBlock: { ReturnValue(0) }
        id = Optimize_TagIntern(AST_GetData1(value))
        IfCondition EqualTo(id, 0) ThenBlock: { ReturnValue(0) }
        reg = Optimize_ScanReg(id)
        IfCondition EqualTo(reg, Reg.RCX) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(reg, Reg.R14) ThenBlock: { ReturnValue(0) }
        ReturnValue(1)
    }
}

// Materialized GPR holding this value, or -1. The scaled store can
// write that register straight to memory. RSP, RBP, and the pool base
// are not value homes.
Function.Optimize_ScanStoreSrc {
    Input: value: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(Optimize_ScanActive(), 0) ThenBlock: { ReturnValue(-1) }
        IfCondition EqualTo(value, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition NotEqual(AST_GetType(value), AST.IDENTIFIER) ThenBlock: { ReturnValue(-1) }
        id = Optimize_TagIntern(AST_GetData1(value))
        IfCondition EqualTo(id, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition EqualTo(Optimize_ScanMatGet(id), 0) ThenBlock: { ReturnValue(-1) }
        reg = Optimize_ScanReg(id)
        IfCondition LessThan(reg, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition GreaterThan(reg, 15) ThenBlock: { ReturnValue(-1) }
        IfCondition EqualTo(reg, Reg.RSP) ThenBlock: { ReturnValue(-1) }
        IfCondition EqualTo(reg, Reg.RBP) ThenBlock: { ReturnValue(-1) }
        IfCondition EqualTo(reg, Reg.R15) ThenBlock: { ReturnValue(-1) }
        IfCondition GreaterEqual(Optimize_ScanXmm(reg), 0) ThenBlock: { ReturnValue(-1) }
        ReturnValue(reg)
    }
}

// 1 float, 2 integer, 0 neither. Float_FromInt and Float_ToInt are
// handled by the walker because their argument class is the opposite
// of their result.
Function.Optimize_ScanUseClass {
    Input: nm: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(nm, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(StringCompare(nm, "Float_Add"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(nm, "Float_Sub"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(nm, "Float_Mul"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(nm, "Float_Div"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(nm, "Float_Neg"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(nm, "Float_Abs"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(nm, "Float_Sqrt"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(nm, "Float_Min"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(nm, "Float_Max"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(nm, "Float_Eq"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(nm, "Float_Ne"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(nm, "Float_Lt"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(nm, "Float_Gt"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(nm, "Float_Le"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(nm, "Float_Ge"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(nm, "Add"), 0) ThenBlock: { ReturnValue(2) }
        IfCondition EqualTo(StringCompare(nm, "Subtract"), 0) ThenBlock: { ReturnValue(2) }
        IfCondition EqualTo(StringCompare(nm, "Multiply"), 0) ThenBlock: { ReturnValue(2) }
        IfCondition EqualTo(StringCompare(nm, "Divide"), 0) ThenBlock: { ReturnValue(2) }
        IfCondition EqualTo(StringCompare(nm, "Modulo"), 0) ThenBlock: { ReturnValue(2) }
        IfCondition EqualTo(StringCompare(nm, "Negate"), 0) ThenBlock: { ReturnValue(2) }
        IfCondition EqualTo(StringCompare(nm, "BitwiseAnd"), 0) ThenBlock: { ReturnValue(2) }
        IfCondition EqualTo(StringCompare(nm, "BitwiseOr"), 0) ThenBlock: { ReturnValue(2) }
        IfCondition EqualTo(StringCompare(nm, "BitwiseXor"), 0) ThenBlock: { ReturnValue(2) }
        IfCondition EqualTo(StringCompare(nm, "BitwiseNot"), 0) ThenBlock: { ReturnValue(2) }
        IfCondition EqualTo(StringCompare(nm, "LeftShift"), 0) ThenBlock: { ReturnValue(2) }
        IfCondition EqualTo(StringCompare(nm, "RightShift"), 0) ThenBlock: { ReturnValue(2) }
        IfCondition EqualTo(StringCompare(nm, "BitAnd"), 0) ThenBlock: { ReturnValue(2) }
        IfCondition EqualTo(StringCompare(nm, "BitOr"), 0) ThenBlock: { ReturnValue(2) }
        IfCondition EqualTo(StringCompare(nm, "BitXor"), 0) ThenBlock: { ReturnValue(2) }
        IfCondition EqualTo(StringCompare(nm, "BitNot"), 0) ThenBlock: { ReturnValue(2) }
        IfCondition EqualTo(StringCompare(nm, "ShiftLeft"), 0) ThenBlock: { ReturnValue(2) }
        IfCondition EqualTo(StringCompare(nm, "ShiftRight"), 0) ThenBlock: { ReturnValue(2) }
        IfCondition EqualTo(StringCompare(nm, "LessThan"), 0) ThenBlock: { ReturnValue(2) }
        IfCondition EqualTo(StringCompare(nm, "GreaterThan"), 0) ThenBlock: { ReturnValue(2) }
        IfCondition EqualTo(StringCompare(nm, "LessEqual"), 0) ThenBlock: { ReturnValue(2) }
        IfCondition EqualTo(StringCompare(nm, "GreaterEqual"), 0) ThenBlock: { ReturnValue(2) }
        IfCondition EqualTo(StringCompare(nm, "EqualTo"), 0) ThenBlock: { ReturnValue(2) }
        IfCondition EqualTo(StringCompare(nm, "NotEqual"), 0) ThenBlock: { ReturnValue(2) }
        IfCondition EqualTo(StringCompare(nm, "And"), 0) ThenBlock: { ReturnValue(2) }
        IfCondition EqualTo(StringCompare(nm, "Or"), 0) ThenBlock: { ReturnValue(2) }
        IfCondition EqualTo(StringCompare(nm, "Not"), 0) ThenBlock: { ReturnValue(2) }
        ReturnValue(0)
    }
}

// Lookup only. TagIntern would append a name the liveness pass never saw.
Function.Optimize_ScanFind {
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(TagState.names, 0) ThenBlock: { ReturnValue(0) }
        i = 0
        WhileLoop LessThan(i, TagState.nnames) {
            existing = Dereference(Add(TagState.names, Multiply(i, 8)))
            IfCondition EqualTo(Optimize_NameEq(existing, name), 1) ThenBlock: { ReturnValue(Add(i, 1)) }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

Function.Optimize_ScanMarkBit {
    Input: id: Integer
    Input: bit: Integer
    Body: {
        IfCondition EqualTo(ScanState.flt, 0) ThenBlock: { ReturnValue(0) }
        IfCondition Or(LessThan(id, 1), GreaterThan(id, 128)) ThenBlock: { ReturnValue(0) }
        at = Subtract(id, 1)
        SetByte(ScanState.flt, at, BitwiseOr(GetByte(ScanState.flt, at), bit))
        ReturnValue(0)
    }
}

Function.Optimize_ScanMarkUses {
    Input: node: Address
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(node), AST.CALL) ThenBlock: { ReturnValue(0) }
        nm = AST_GetData1(node)
        cls = 0
        IfCondition EqualTo(StringCompare(nm, "Float_FromInt"), 0) ThenBlock: { cls = 2 }
        IfCondition EqualTo(StringCompare(nm, "Float_ToInt"), 0) ThenBlock: { cls = 1 }
        IfCondition EqualTo(cls, 0) ThenBlock: { cls = Optimize_ScanUseClass(nm) }
        IfCondition EqualTo(cls, 0) ThenBlock: { ReturnValue(0) }
        nch = AST_GetChildCount(node)
        i = 0
        WhileLoop LessThan(i, nch) {
            ch = AST_GetChild(node, i)
            IfCondition NotEqual(ch, 0) ThenBlock: {
                IfCondition EqualTo(AST_GetType(ch), AST.IDENTIFIER) ThenBlock: {
                    Optimize_ScanMarkBit(Optimize_ScanFind(AST_GetData1(ch)), cls)
                }
            }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

Function.Optimize_ScanMarkNode {
    Input: node: Address
    Input: depth: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        nt = AST_GetType(node)
        IfCondition EqualTo(nt, AST.ASSIGNMENT) ThenBlock: {
            Optimize_ScanNoteIv(node)
            Optimize_ScanNoteBase(node)
            IfCondition GreaterThan(AST_GetChildCount(node), 0) ThenBlock: {
                val = AST_GetChild(node, 0)
                IfCondition NotEqual(val, 0) ThenBlock: {
                    IfCondition EqualTo(AST_GetType(val), AST.CALL) ThenBlock: {
                        vn = AST_GetData1(val)
                        bit = 0
                        IfCondition EqualTo(StringCompare(vn, "Float_FromInt"), 0) ThenBlock: { bit = 1 }
                        IfCondition EqualTo(StringCompare(vn, "Float_ToInt"), 0) ThenBlock: { bit = 2 }
                        IfCondition EqualTo(bit, 0) ThenBlock: {
                            c = Optimize_ScanUseClass(vn)
                            IfCondition EqualTo(c, 1) ThenBlock: { bit = 1 }
                            IfCondition EqualTo(c, 2) ThenBlock: { bit = 2 }
                        }
                        IfCondition NotEqual(bit, 0) ThenBlock: {
                            Optimize_ScanMarkBit(Optimize_ScanFind(AST_GetData1(node)), bit)
                        }
                        // Bit 64: name = name ± x. Spilling this reloads the
                        // value, updates it, and stores it back every trip.
                        IfCondition EqualTo(bit, 1) ThenBlock: {
                            selfu = 0
                            IfCondition EqualTo(StringCompare(vn, "Float_Add"), 0) ThenBlock: { selfu = 1 }
                            IfCondition EqualTo(StringCompare(vn, "Float_Sub"), 0) ThenBlock: { selfu = 1 }
                            IfCondition EqualTo(selfu, 1) ThenBlock: {
                                IfCondition EqualTo(AST_GetChildCount(val), 2) ThenBlock: {
                                    tname = AST_GetData1(node)
                                    s0 = AST_GetChild(val, 0)
                                    s1 = AST_GetChild(val, 1)
                                    hit = 0
                                    IfCondition NotEqual(s0, 0) ThenBlock: {
                                        IfCondition EqualTo(AST_GetType(s0), AST.IDENTIFIER) ThenBlock: {
                                            IfCondition EqualTo(Optimize_NameEq(AST_GetData1(s0), tname), 1) ThenBlock: { hit = 1 }
                                        }
                                    }
                                    IfCondition NotEqual(s1, 0) ThenBlock: {
                                        IfCondition EqualTo(AST_GetType(s1), AST.IDENTIFIER) ThenBlock: {
                                            IfCondition EqualTo(Optimize_NameEq(AST_GetData1(s1), tname), 1) ThenBlock: { hit = 1 }
                                        }
                                    }
                                    IfCondition EqualTo(hit, 1) ThenBlock: {
                                        IfCondition GreaterEqual(depth, 2) ThenBlock: {
                                            Optimize_ScanMarkBit(Optimize_ScanFind(tname), 64)
                                        }
                                    }
                                }
                            }
                        }
                        // Bit 32: a one-use div or conversion is folded
                        // into the multiply so it does not take an xmm.
                        IfCondition EqualTo(StringCompare(vn, "Float_FromInt"), 0) ThenBlock: {
                            Optimize_ScanMarkBit(Optimize_ScanFind(AST_GetData1(node)), 32)
                        }
                        IfCondition EqualTo(StringCompare(vn, "Float_Div"), 0) ThenBlock: {
                            Optimize_ScanMarkBit(Optimize_ScanFind(AST_GetData1(node)), 32)
                        }
                        // Bit 8: the value is a field of a plain pointer.
                        // Bit 4: any other definition. Both means the
                        // loaded field is later overwritten.
                        IfCondition EqualTo(StringCompare(vn, "Dereference"), 0) ThenBlock: {
                            IfCondition EqualTo(AST_GetChildCount(val), 1) ThenBlock: {
                                adr = AST_GetChild(val, 0)
                                plain = 0
                                IfCondition NotEqual(adr, 0) ThenBlock: {
                                    IfCondition EqualTo(AST_GetType(adr), AST.IDENTIFIER) ThenBlock: { plain = 1 }
                                    IfCondition EqualTo(AST_GetType(adr), AST.CALL) ThenBlock: {
                                        IfCondition EqualTo(StringCompare(AST_GetData1(adr), "Add"), 0) ThenBlock: {
                                            IfCondition EqualTo(AST_GetChildCount(adr), 2) ThenBlock: {
                                                d0 = AST_GetChild(adr, 0)
                                                d1 = AST_GetChild(adr, 1)
                                                IfCondition NotEqual(d1, 0) ThenBlock: {
                                                    IfCondition EqualTo(AST_GetType(d1), AST.NUMBER) ThenBlock: {
                                                        IfCondition NotEqual(d0, 0) ThenBlock: {
                                                            IfCondition EqualTo(AST_GetType(d0), AST.IDENTIFIER) ThenBlock: { plain = 1 }
                                                        }
                                                    }
                                                }
                                                IfCondition NotEqual(d0, 0) ThenBlock: {
                                                    IfCondition EqualTo(AST_GetType(d0), AST.NUMBER) ThenBlock: {
                                                        IfCondition NotEqual(d1, 0) ThenBlock: {
                                                            IfCondition EqualTo(AST_GetType(d1), AST.IDENTIFIER) ThenBlock: { plain = 1 }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                                IfCondition EqualTo(plain, 1) ThenBlock: {
                                    Optimize_ScanMarkBit(Optimize_ScanFind(AST_GetData1(node)), 8)
                                } ElseBlock: {
                                    scaled = 0
                                    IfCondition EqualTo(Optimize_ScanPtrShape(adr), 1) ThenBlock: {
                                        st = ScanPtr.sstride
                                        IfCondition EqualTo(st, 1) ThenBlock: { scaled = 1 }
                                        IfCondition EqualTo(st, 2) ThenBlock: { scaled = 1 }
                                        IfCondition EqualTo(st, 4) ThenBlock: { scaled = 1 }
                                        IfCondition EqualTo(st, 8) ThenBlock: { scaled = 1 }
                                    }
                                    IfCondition EqualTo(scaled, 1) ThenBlock: {
                                        Optimize_ScanMarkBit(Optimize_ScanFind(AST_GetData1(node)), 16)
                                    } ElseBlock: {
                                        Optimize_ScanMarkBit(Optimize_ScanFind(AST_GetData1(node)), 4)
                                    }
                                }
                            }
                        } ElseBlock: {
                            Optimize_ScanMarkBit(Optimize_ScanFind(AST_GetData1(node)), 4)
                        }
                    } ElseBlock: {
                        Optimize_ScanMarkBit(Optimize_ScanFind(AST_GetData1(node)), 4)
                    }
                }
            }
        }
        IfCondition EqualTo(nt, AST.CALL) ThenBlock: { Optimize_ScanMarkUses(node) }
        nch = AST_GetChildCount(node)
        next = depth
        IfCondition EqualTo(nt, AST.WHILE) ThenBlock: { next = Add(depth, 1) }
        IfCondition EqualTo(nt, AST.FOR_EVERY) ThenBlock: { next = Add(depth, 1) }
        i = 0
        WhileLoop LessThan(i, nch) {
            Optimize_ScanMarkNode(AST_GetChild(node, i), next)
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

Function.Optimize_ScanMarkCopy {
    Input: node: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        changed = 0
        IfCondition EqualTo(AST_GetType(node), AST.ASSIGNMENT) ThenBlock: {
            IfCondition GreaterThan(AST_GetChildCount(node), 0) ThenBlock: {
                val = AST_GetChild(node, 0)
                IfCondition NotEqual(val, 0) ThenBlock: {
                    IfCondition EqualTo(AST_GetType(val), AST.IDENTIFIER) ThenBlock: {
                        id = Optimize_ScanFind(AST_GetData1(node))
                        sid = Optimize_ScanFind(AST_GetData1(val))
                        IfCondition GreaterThan(id, 0) ThenBlock: {
                            IfCondition GreaterThan(sid, 0) ThenBlock: {
                                cur = GetByte(ScanState.flt, Subtract(id, 1))
                                merged = BitwiseOr(cur, GetByte(ScanState.flt, Subtract(sid, 1)))
                                IfCondition NotEqual(merged, cur) ThenBlock: {
                                    SetByte(ScanState.flt, Subtract(id, 1), merged)
                                    changed = 1
                                }
                            }
                        }
                    }
                }
            }
        }
        nch = AST_GetChildCount(node)
        i = 0
        WhileLoop LessThan(i, nch) {
            IfCondition EqualTo(Optimize_ScanMarkCopy(AST_GetChild(node, i)), 1) ThenBlock: { changed = 1 }
            i = Add(i, 1)
        }
        ReturnValue(changed)
    }
}

// Called once per function, before Optimize_ScanRun. A name is a float
// candidate when every seen use is a float op and it is never an integer
// operand. Literal 0 does not count as integer, so s00 = 0 still qualifies.
Function.Optimize_ScanMark {
    Input: body: Address
    Body: {
        IfCondition EqualTo(ScanState.flt, 0) ThenBlock: { ScanState.flt = Allocate(128) }
        IfCondition EqualTo(ScanState.iv, 0) ThenBlock: { ScanState.iv = Allocate(128) }
        IfCondition EqualTo(ScanState.base, 0) ThenBlock: { ScanState.base = Allocate(128) }
        IfCondition EqualTo(ScanState.flt, 0) ThenBlock: { ReturnValue(0) }
        i = 0
        WhileLoop LessThan(i, 128) {
            SetByte(ScanState.flt, i, 0)
            IfCondition NotEqual(ScanState.iv, 0) ThenBlock: { SetByte(ScanState.iv, i, 0) }
            IfCondition NotEqual(ScanState.base, 0) ThenBlock: { SetByte(ScanState.base, i, 0) }
            i = Add(i, 1)
        }
        ScanPtr.scale_name = 0
        ScanPtr.scale_bad = 0
        ScanPtr.run_name = 0
        ScanPtr.run_iv = 0
        ScanPtr.run_inv = 0
        ScanPtr.run_step = 0
        ScanPtr.byte_name = 0
        ScanPtr.byte_bad = 0
        ScanPtr.byte_iv = 0
        ScanPtr.byte_step = 0
        ScanPtr.byte_lim = 0
        ScanPtr.byte_imm = -1
        ScanPtr.byte_acc = 0
        ScanPtr.byte_keep = 0
        ScanPtr.ctr_name = 0
        ScanPtr.ctr_lim = 0
        ScanPtr.flt_keep = 0
        ScanPtr.park0 = 0
        ScanPtr.park1 = 0
        ScanPtr.park2 = 0
        ScanPtr.park1_reg = -1
        ScanPtr.park2_reg = -1
        IfCondition EqualTo(body, 0) ThenBlock: { ReturnValue(0) }
        Optimize_ScanMarkNode(body, 0)
        pass = 0
        WhileLoop LessThan(pass, 8) {
            IfCondition EqualTo(Optimize_ScanMarkCopy(body), 0) ThenBlock: { pass = 8 }
            pass = Add(pass, 1)
        }
        i = 0
        WhileLoop LessThan(i, 128) {
            b = GetByte(ScanState.flt, i)
            keep = 0
            // 1: computed float, allocated first. 5: also loaded from a
            // field, allocated after the temps. 3: the value is only a
            // field of a plain pointer, reloaded from that pointer, no
            // register. 0: not a float.
            IfCondition NotEqual(BitwiseAnd(b, 1), 0) ThenBlock: {
                IfCondition EqualTo(BitwiseAnd(b, 2), 0) ThenBlock: {
                    keep = 1
                    IfCondition NotEqual(BitwiseAnd(b, 8), 0) ThenBlock: {
                        IfCondition EqualTo(BitwiseAnd(b, 4), 0) ThenBlock: { keep = 3 }
                        IfCondition NotEqual(BitwiseAnd(b, 4), 0) ThenBlock: { keep = 5 }
                        // A field that is updated in place outranks a temp.
                        IfCondition EqualTo(keep, 5) ThenBlock: {
                            IfCondition NotEqual(BitwiseAnd(b, 64), 0) ThenBlock: { keep = 6 }
                        }
                    }
                    // A scaled load used once is folded into the multiply,
                    // which then reads [base+index*scale] itself.
                    IfCondition NotEqual(BitwiseAnd(b, 16), 0) ThenBlock: {
                        IfCondition EqualTo(BitwiseAnd(b, 4), 0) ThenBlock: {
                            IfCondition EqualTo(BitwiseAnd(b, 8), 0) ThenBlock: {
                                cnt = 99
                                IfCondition NotEqual(NameState.nuse, 0) ThenBlock: {
                                    cnt = Dereference(Add(NameState.nuse, Multiply(i, 8)))
                                }
                                IfCondition GreaterThan(cnt, 0) ThenBlock: {
                                    IfCondition LessEqual(cnt, 2) ThenBlock: { keep = 3 }
                                }
                            }
                        }
                    }
                    // One-use FromInt and Div. keep 4 is not in the main
                    // pool, so it cannot evict a hotter name. A free xmm
                    // may still hold it for the whole live range. A
                    // compare of whatever is left parks that frame value
                    // in xmm2 once per entry.
                    IfCondition NotEqual(BitwiseAnd(b, 32), 0) ThenBlock: {
                        cnt = 99
                        IfCondition NotEqual(NameState.nuse, 0) ThenBlock: {
                            cnt = Dereference(Add(NameState.nuse, Multiply(i, 8)))
                        }
                        IfCondition GreaterThan(cnt, 0) ThenBlock: {
                            IfCondition LessEqual(cnt, 2) ThenBlock: { keep = 4 }
                        }
                    }
                }
            }
            SetByte(ScanState.flt, i, keep)
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

// Block whose statements cover pos. The tightest span wins when a
// nested loop's range sits inside an outer touch.
Function.Optimize_ScanBlockAt {
    Input: pos: Integer
    Output: Integer
    Body: {
        best = -1
        best_span = 2147483647
        b = 0
        WhileLoop LessThan(b, BlockPool.head) {
            ps = Optimize_CFGPosStart(b)
            pe = Optimize_CFGPosEnd(b)
            IfCondition NotEqual(ps, -1) ThenBlock: {
                IfCondition NotEqual(pe, -1) ThenBlock: {
                    IfCondition LessEqual(ps, pos) ThenBlock: {
                        IfCondition GreaterEqual(pe, pos) ThenBlock: {
                            span = Subtract(pe, ps)
                            IfCondition LessThan(span, best_span) ThenBlock: {
                                best_span = span
                                best = b
                            }
                        }
                    }
                }
            }
            b = Add(b, 1)
        }
        ReturnValue(best)
    }
}

// LiveNext, except a name that is live-out here is used on the back
// edge even when that use has a lower statement number.
// Reload weight. An in-place field update is four times a plain temp,
// because spilling it turns every trip into a reload, an update, and a
// store. Zero means the liveness pass recorded no mentions.
Function.Optimize_ScanSpillCost {
    Input: id: Integer
    Output: Integer
    Body: {
        c = Optimize_LiveCost(id)
        IfCondition EqualTo(ScanState.flt, 0) ThenBlock: { ReturnValue(c) }
        IfCondition Or(LessThan(id, 1), GreaterThan(id, 128)) ThenBlock: { ReturnValue(c) }
        IfCondition EqualTo(GetByte(ScanState.flt, Subtract(id, 1)), 6) ThenBlock: {
            c = Multiply(c, 4)
        }
        ReturnValue(c)
    }
}

Function.Optimize_ScanNext {
    Input: id: Integer
    Input: from: Integer
    Output: Integer
    Body: {
        n = Optimize_LiveNext(id, from)
        IfCondition NotEqual(n, 2147483647) ThenBlock: { ReturnValue(n) }
        b = Optimize_ScanBlockAt(from)
        IfCondition LessThan(b, 0) ThenBlock: { ReturnValue(n) }
        IfCondition EqualTo(Optimize_ScanBit(id, Optimize_LiveOut0(b), Optimize_LiveOut1(b)), 1) ThenBlock: {
            ReturnValue(0)
        }
        ReturnValue(n)
    }
}

// First use of a homed parameter: the register is assigned but empty.
// Load the frame once, then the scaled address can use the register.
Function.Optimize_ScanForce {
    Input: name: Address
    Body: {
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }
        id = Optimize_TagIntern(name)
        IfCondition LessThan(id, 1) ThenBlock: { ReturnValue(0) }
        reg = Optimize_ScanReg(id)
        IfCondition EqualTo(reg, -1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_ScanMatGet(id), 1) ThenBlock: { ReturnValue(0) }
        // rbx is the compare scratch. rcx, r11, and r14 are the address
        // temps, so a home there is not a stable LEA base.
        ok = 0
        IfCondition EqualTo(reg, Reg.R12) ThenBlock: { ok = 1 }
        IfCondition EqualTo(reg, Reg.R13) ThenBlock: { ok = 1 }
        IfCondition EqualTo(reg, Reg.R10) ThenBlock: { ok = 1 }
        IfCondition EqualTo(reg, Reg.R8) ThenBlock: { ok = 1 }
        IfCondition EqualTo(reg, Reg.R9) ThenBlock: { ok = 1 }
        IfCondition EqualTo(reg, Reg.RSI) ThenBlock: { ok = 1 }
        IfCondition EqualTo(reg, Reg.RDI) ThenBlock: { ok = 1 }
        IfCondition EqualTo(reg, Reg.RDX) ThenBlock: { ok = 1 }
        IfCondition EqualTo(ok, 0) ThenBlock: { ReturnValue(0) }
        off = Scope_Resolve(name)
        rt = Scope.resolve_type
        ok = 0
        IfCondition EqualTo(rt, 1) ThenBlock: { ok = 1 }
        IfCondition EqualTo(rt, 2) ThenBlock: { ok = 1 }
        IfCondition GreaterEqual(off, 0) ThenBlock: { ok = 0 }
        IfCondition EqualTo(ok, 0) ThenBlock: { ReturnValue(0) }
        Emit_MovRaxRbpOffset(off)
        Optimize_ScanSeedLoad(name)
        ReturnValue(0)
    }
}

// Parameters homed in r12 or r13 are loaded once per call. A later
// pointer header can then LEA from the register. rbx is left alone:
// ScanForce refuses it, and the prologue does not leave rax holding
// the first argument. Inactive scan (a true leaf) emits nothing.
Function.Optimize_ScanSeedParams {
    Input: func_node: Address
    Body: {
        IfCondition EqualTo(Optimize_ScanActive(), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(func_node, 0) ThenBlock: { ReturnValue(0) }
        n = AST_GetChildCount(func_node)
        i = 0
        WhileLoop LessThan(i, n) {
            child = AST_GetChild(func_node, i)
            IfCondition EqualTo(AST_GetType(child), AST.PARAMETER) ThenBlock: {
                Optimize_ScanForce(AST_GetData1(child))
            }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

Function.Optimize_ScanIsBase {
    Input: id: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(id, 1) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterThan(id, 128) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(ScanState.base, 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(GetByte(ScanState.base, Subtract(id, 1)))
    }
}

Function.Optimize_ScanMarkBase {
    Input: name: Address
    Body: {
        IfCondition EqualTo(ScanState.base, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }
        id = Optimize_ScanFind(name)
        IfCondition LessThan(id, 1) ThenBlock: { ReturnValue(0) }
        SetByte(ScanState.base, Subtract(id, 1), 1)
        ReturnValue(0)
    }
}

// base + index*1/2/4/8. The base has to stay in a register so the
// load is one scaled address.
Function.Optimize_ScanNoteBase {
    Input: node: Address
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(AST_GetType(node), AST.CALL) ThenBlock: {
            IfCondition EqualTo(StringCompare(AST_GetData1(node), "Add"), 0) ThenBlock: {
                IfCondition EqualTo(AST_GetChildCount(node), 2) ThenBlock: {
                    left = AST_GetChild(node, 0)
                    right = AST_GetChild(node, 1)
                    bname = 0
                    mul = 0
                    IfCondition EqualTo(AST_GetType(left), AST.IDENTIFIER) ThenBlock: {
                        bname = AST_GetData1(left)
                        mul = right
                    }
                    IfCondition EqualTo(bname, 0) ThenBlock: {
                        IfCondition EqualTo(AST_GetType(right), AST.IDENTIFIER) ThenBlock: {
                            bname = AST_GetData1(right)
                            mul = left
                        }
                    }
                    IfCondition NotEqual(bname, 0) ThenBlock: {
                        IfCondition NotEqual(mul, 0) ThenBlock: {
                            IfCondition EqualTo(AST_GetType(mul), AST.CALL) ThenBlock: {
                                IfCondition EqualTo(StringCompare(AST_GetData1(mul), "Multiply"), 0) ThenBlock: {
                                    Optimize_ScanMarkBase(bname)
                                }
                            }
                        }
                    }
                }
            }
        }
        nch = AST_GetChildCount(node)
        i = 0
        WhileLoop LessThan(i, nch) {
            Optimize_ScanNoteBase(AST_GetChild(node, i))
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

Function.Optimize_ScanIsIv {
    Input: id: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(id, 1) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterThan(id, 128) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(ScanState.iv, 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(GetByte(ScanState.iv, Subtract(id, 1)))
    }
}

// name = name + positive constant. That is the loop cursor.
Function.Optimize_ScanNoteIv {
    Input: node: Address
    Body: {
        IfCondition EqualTo(ScanState.iv, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_PlainAssign(node), 0) ThenBlock: { ReturnValue(0) }
        name = AST_GetData1(node)
        val = AST_GetChild(node, 0)
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(val, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(val), AST.CALL) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(StringCompare(AST_GetData1(val), "Add"), 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetChildCount(val), 2) ThenBlock: { ReturnValue(0) }
        a0 = AST_GetChild(val, 0)
        a1 = AST_GetChild(val, 1)
        num = 0
        IfCondition EqualTo(AST_GetType(a1), AST.NUMBER) ThenBlock: {
            IfCondition EqualTo(AST_GetType(a0), AST.IDENTIFIER) ThenBlock: {
                IfCondition EqualTo(StringCompare(AST_GetData1(a0), name), 0) ThenBlock: { num = a1 }
            }
        }
        IfCondition EqualTo(num, 0) ThenBlock: {
            IfCondition EqualTo(AST_GetType(a0), AST.NUMBER) ThenBlock: {
                IfCondition EqualTo(AST_GetType(a1), AST.IDENTIFIER) ThenBlock: {
                    IfCondition EqualTo(StringCompare(AST_GetData1(a1), name), 0) ThenBlock: { num = a0 }
                }
            }
        }
        IfCondition EqualTo(num, 0) ThenBlock: { ReturnValue(0) }
        IfCondition LessEqual(StringToNumber(AST_GetData1(num)), 0) ThenBlock: { ReturnValue(0) }
        id = Optimize_ScanFind(name)
        IfCondition LessThan(id, 1) ThenBlock: { ReturnValue(0) }
        SetByte(ScanState.iv, Subtract(id, 1), 1)
        ReturnValue(1)
    }
}

// movsd into slot from [baseReg + indexReg*scale]. Scale is 1, 2, 4, or 8.
// Both names already have scan GPRs, so the address is not rebuilt.
Function.Optimize_ScanScaleLoad {
    Input: addr: Address
    Input: slot: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(addr, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(addr), AST.CALL) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(StringCompare(AST_GetData1(addr), "Add"), 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetChildCount(addr), 2) ThenBlock: { ReturnValue(0) }
        left = AST_GetChild(addr, 0)
        right = AST_GetChild(addr, 1)
        base = left
        mul = right
        IfCondition EqualTo(AST_GetType(right), AST.IDENTIFIER) ThenBlock: {
            IfCondition EqualTo(AST_GetType(left), AST.CALL) ThenBlock: {
                base = right
                mul = left
            }
        }
        IfCondition NotEqual(AST_GetType(base), AST.IDENTIFIER) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(mul), AST.CALL) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(StringCompare(AST_GetData1(mul), "Multiply"), 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetChildCount(mul), 2) ThenBlock: { ReturnValue(0) }
        m0 = AST_GetChild(mul, 0)
        m1 = AST_GetChild(mul, 1)
        idx = 0
        num = 0
        IfCondition EqualTo(AST_GetType(m1), AST.NUMBER) ThenBlock: {
            IfCondition EqualTo(AST_GetType(m0), AST.IDENTIFIER) ThenBlock: {
                idx = m0
                num = m1
            }
        }
        IfCondition EqualTo(idx, 0) ThenBlock: {
            IfCondition EqualTo(AST_GetType(m0), AST.NUMBER) ThenBlock: {
                IfCondition EqualTo(AST_GetType(m1), AST.IDENTIFIER) ThenBlock: {
                    idx = m1
                    num = m0
                }
            }
        }
        IfCondition EqualTo(idx, 0) ThenBlock: { ReturnValue(0) }
        scale = StringToNumber(AST_GetData1(num))
        ok = 0
        IfCondition EqualTo(scale, 1) ThenBlock: { ok = 1 }
        IfCondition EqualTo(scale, 2) ThenBlock: { ok = 1 }
        IfCondition EqualTo(scale, 4) ThenBlock: { ok = 1 }
        IfCondition EqualTo(scale, 8) ThenBlock: { ok = 1 }
        IfCondition EqualTo(ok, 0) ThenBlock: { ReturnValue(0) }
        Optimize_ScanForce(AST_GetData1(base))
        Optimize_ScanForce(AST_GetData1(idx))
        breg = Optimize_ScanAddrBase(AST_GetData1(base))
        ireg = Optimize_ScanAddrBase(AST_GetData1(idx))
        IfCondition EqualTo(breg, 0) ThenBlock: {
            IfCondition NotEqual(ScanPtr.scale_name, 0) ThenBlock: {
                IfCondition EqualTo(Optimize_NameEq(AST_GetData1(base), ScanPtr.scale_name), 1) ThenBlock: {
                    breg = Reg.R14
                }
            }
        }
        IfCondition EqualTo(breg, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(ireg, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(breg, ireg) ThenBlock: { ReturnValue(0) }
        LoopHome.ip_hit_reg = breg
        LoopHome.sib_index = ireg
        X86_XmmScaled(16, 0, scale, ireg)
        X86_XmmBin(16, slot, 0)
        ReturnValue(1)
    }
}

// Same address as ScanScaleLoad, but the SSE op lands in xmm0.
// opcode 89 is mulsd, so a product can use the memory operand directly.
Function.Optimize_ScanScaleOp {
    Input: addr: Address
    Input: opcode: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(addr, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(addr), AST.CALL) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(StringCompare(AST_GetData1(addr), "Add"), 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetChildCount(addr), 2) ThenBlock: { ReturnValue(0) }
        left = AST_GetChild(addr, 0)
        right = AST_GetChild(addr, 1)
        base = left
        mul = right
        IfCondition EqualTo(AST_GetType(right), AST.IDENTIFIER) ThenBlock: {
            IfCondition EqualTo(AST_GetType(left), AST.CALL) ThenBlock: {
                base = right
                mul = left
            }
        }
        IfCondition NotEqual(AST_GetType(base), AST.IDENTIFIER) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(mul), AST.CALL) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(StringCompare(AST_GetData1(mul), "Multiply"), 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetChildCount(mul), 2) ThenBlock: { ReturnValue(0) }
        m0 = AST_GetChild(mul, 0)
        m1 = AST_GetChild(mul, 1)
        idx = 0
        num = 0
        IfCondition EqualTo(AST_GetType(m1), AST.NUMBER) ThenBlock: {
            IfCondition EqualTo(AST_GetType(m0), AST.IDENTIFIER) ThenBlock: {
                idx = m0
                num = m1
            }
        }
        IfCondition EqualTo(idx, 0) ThenBlock: {
            IfCondition EqualTo(AST_GetType(m0), AST.NUMBER) ThenBlock: {
                IfCondition EqualTo(AST_GetType(m1), AST.IDENTIFIER) ThenBlock: {
                    idx = m1
                    num = m0
                }
            }
        }
        IfCondition EqualTo(idx, 0) ThenBlock: { ReturnValue(0) }
        scale = StringToNumber(AST_GetData1(num))
        ok = 0
        IfCondition EqualTo(scale, 1) ThenBlock: { ok = 1 }
        IfCondition EqualTo(scale, 2) ThenBlock: { ok = 1 }
        IfCondition EqualTo(scale, 4) ThenBlock: { ok = 1 }
        IfCondition EqualTo(scale, 8) ThenBlock: { ok = 1 }
        IfCondition EqualTo(ok, 0) ThenBlock: { ReturnValue(0) }
        Optimize_ScanForce(AST_GetData1(base))
        Optimize_ScanForce(AST_GetData1(idx))
        breg = Optimize_ScanAddrBase(AST_GetData1(base))
        ireg = Optimize_ScanAddrBase(AST_GetData1(idx))
        IfCondition EqualTo(breg, 0) ThenBlock: {
            IfCondition NotEqual(ScanPtr.scale_name, 0) ThenBlock: {
                IfCondition EqualTo(Optimize_NameEq(AST_GetData1(base), ScanPtr.scale_name), 1) ThenBlock: {
                    breg = Reg.R14
                }
            }
        }
        IfCondition EqualTo(breg, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(ireg, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(breg, ireg) ThenBlock: { ReturnValue(0) }
        LoopHome.ip_hit_reg = breg
        LoopHome.sib_index = ireg
        X86_XmmScaled(opcode, 0, scale, ireg)
        ReturnValue(1)
    }
}

// 1 when name id's bit is set in the live-in or live-out mask pair.
Function.Optimize_ScanBit {
    Input: id: Integer
    Input: w0: Integer
    Input: w1: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(id, 1) ThenBlock: { ReturnValue(0) }
        IfCondition LessEqual(id, 64) ThenBlock: {
            IfCondition NotEqual(BitwiseAnd(w0, LeftShift(1, Subtract(id, 1))), 0) ThenBlock: { ReturnValue(1) }
            ReturnValue(0)
        }
        IfCondition LessEqual(id, 128) ThenBlock: {
            IfCondition NotEqual(BitwiseAnd(w1, LeftShift(1, Subtract(id, 65))), 0) ThenBlock: { ReturnValue(1) }
            ReturnValue(0)
        }
        ReturnValue(0)
    }
}

// Record every identifier under this statement at pos. A nested
// statement carries its own pos and is left for the outer walk.
Function.Optimize_ScanTouch {
    Input: node: Address
    Input: pos: Integer
    Input: mins: Address
    Input: maxs: Address
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        nt = AST_GetType(node)
        IfCondition EqualTo(nt, AST.ASSIGNMENT) ThenBlock: {
            id = Optimize_ScanFind(AST_GetData1(node))
            IfCondition GreaterThan(id, 0) ThenBlock: {
                at = Multiply(Subtract(id, 1), 8)
                cur = Dereference(Add(mins, at))
                IfCondition LessThan(pos, cur) ThenBlock: { StoreValue(Add(mins, at), pos) }
                cur = Dereference(Add(maxs, at))
                IfCondition GreaterThan(pos, cur) ThenBlock: { StoreValue(Add(maxs, at), pos) }
            }
        }
        IfCondition EqualTo(nt, AST.IDENTIFIER) ThenBlock: {
            id = Optimize_ScanFind(AST_GetData1(node))
            IfCondition GreaterThan(id, 0) ThenBlock: {
                at = Multiply(Subtract(id, 1), 8)
                cur = Dereference(Add(mins, at))
                IfCondition LessThan(pos, cur) ThenBlock: { StoreValue(Add(mins, at), pos) }
                cur = Dereference(Add(maxs, at))
                IfCondition GreaterThan(pos, cur) ThenBlock: { StoreValue(Add(maxs, at), pos) }
            }
            ReturnValue(0)
        }
        nch = AST_GetChildCount(node)
        i = 0
        WhileLoop LessThan(i, nch) {
            ch = AST_GetChild(node, i)
            stop = 0
            IfCondition NotEqual(ch, 0) ThenBlock: {
                cpos = Optimize_TagPosOf(ch)
                IfCondition GreaterThan(cpos, 0) ThenBlock: {
                    IfCondition NotEqual(cpos, pos) ThenBlock: { stop = 1 }
                }
            }
            IfCondition EqualTo(stop, 0) ThenBlock: {
                Optimize_ScanTouch(ch, pos, mins, maxs)
            }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

Function.Optimize_ScanTouchWalk {
    Input: node: Address
    Input: mins: Address
    Input: maxs: Address
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        pos = Optimize_TagPosOf(node)
        // A tag record left at 0 was never given a program point.
        // CFG positions start at 1.
        IfCondition GreaterThan(pos, 0) ThenBlock: {
            Optimize_ScanTouch(node, pos, mins, maxs)
        }
        nch = AST_GetChildCount(node)
        i = 0
        WhileLoop LessThan(i, nch) {
            Optimize_ScanTouchWalk(AST_GetChild(node, i), mins, maxs)
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

// The block liveness interval runs from the first statement of a block
// to the last, for every name the block mentions. A temp that dies on
// the next line therefore holds a register for the whole block, and the
// float that actually needs it spills. Shrink each interval to the
// statements that mention the name, then stretch it back out to a block
// edge only when the name is live-in or live-out there.
Function.Optimize_ScanRefine {
    Input: body: Address
    Body: {
        IfCondition EqualTo(body, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(NameState.buf, 0) ThenBlock: { ReturnValue(0) }
        mins = Allocate(1024)
        maxs = Allocate(1024)
        i = 0
        WhileLoop LessThan(i, 128) {
            StoreValue(Add(mins, Multiply(i, 8)), 2147483647)
            StoreValue(Add(maxs, Multiply(i, 8)), -1)
            i = Add(i, 1)
        }
        Optimize_ScanTouchWalk(body, mins, maxs)
        i = 1
        WhileLoop LessThan(i, Add(TagState.nnames, 1)) {
            at = Multiply(Subtract(i, 1), 8)
            tmin = Dereference(Add(mins, at))
            tmax = Dereference(Add(maxs, at))
            IfCondition GreaterEqual(tmax, 0) ThenBlock: {
                omin = Optimize_LiveMinPos(i)
                omax = Optimize_LiveMaxPos(i)
                IfCondition GreaterEqual(omax, 0) ThenBlock: {
                    // Only shrink. A touch outside the old range is ignored
                    // so a missed statement cannot extend a register past
                    // the block the dataflow already proved.
                    fmin = tmin
                    fmax = tmax
                    IfCondition LessThan(fmin, omin) ThenBlock: { fmin = omin }
                    IfCondition GreaterThan(fmax, omax) ThenBlock: { fmax = omax }
                    // A value used in a block where this block does not
                    // define it has to survive the whole block. Otherwise
                    // a later temp reuses the register and the next loop
                    // trip reads that temp. A name this block defines is
                    // not stretched: its next trip rewrites the register
                    // before the use.
                    b = 0
                    WhileLoop LessThan(b, BlockPool.head) {
                        df = Optimize_ScanBit(i, Optimize_LiveDef0(b), Optimize_LiveDef1(b))
                        IfCondition EqualTo(df, 0) ThenBlock: {
                            inn = Optimize_ScanBit(i, Optimize_LiveIn0(b), Optimize_LiveIn1(b))
                            IfCondition EqualTo(inn, 1) ThenBlock: {
                                ps = Optimize_CFGPosStart(b)
                                IfCondition GreaterThan(ps, 0) ThenBlock: {
                                    IfCondition LessThan(ps, fmin) ThenBlock: { fmin = ps }
                                }
                            }
                            outg = Optimize_ScanBit(i, Optimize_LiveOut0(b), Optimize_LiveOut1(b))
                            IfCondition EqualTo(outg, 1) ThenBlock: {
                                pe = Optimize_CFGPosEnd(b)
                                IfCondition GreaterThan(pe, 0) ThenBlock: {
                                    IfCondition GreaterThan(pe, fmax) ThenBlock: { fmax = pe }
                                }
                            }
                        }
                        b = Add(b, 1)
                    }
                    IfCondition LessThan(fmin, omin) ThenBlock: { fmin = omin }
                    IfCondition GreaterThan(fmax, omax) ThenBlock: { fmax = omax }
                    IfCondition LessEqual(fmin, fmax) ThenBlock: {
                        slot = Add(NameState.buf, Multiply(Subtract(i, 1), 16))
                        StoreValue(slot, fmin)
                        StoreValue(Add(slot, 8), fmax)
                    }
                }
            }
            i = Add(i, 1)
        }
        Deallocate(mins, 1024)
        Deallocate(maxs, 1024)
        ReturnValue(0)
    }
}

// Negative frame offset of a float whose bits are in that slot.
// 0 when the name is not a float frame, or a scan xmm already holds it.
Function.Optimize_ScanFltFrame {
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(ScanState.flt, 0) ThenBlock: { ReturnValue(0) }
        id = Optimize_ScanFind(name)
        IfCondition EqualTo(id, 0) ThenBlock: { ReturnValue(0) }
        b = GetByte(ScanState.flt, Subtract(id, 1))
        flt = 0
        IfCondition EqualTo(b, 1) ThenBlock: { flt = 1 }
        IfCondition EqualTo(b, 3) ThenBlock: { flt = 1 }
        IfCondition EqualTo(b, 4) ThenBlock: { flt = 1 }
        IfCondition EqualTo(b, 5) ThenBlock: { flt = 1 }
        IfCondition EqualTo(b, 6) ThenBlock: { flt = 1 }
        IfCondition EqualTo(flt, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_ScanMatGet(id), 1) ThenBlock: {
            IfCondition GreaterEqual(Optimize_ScanXmm(Optimize_ScanReg(id)), 0) ThenBlock: {
                ReturnValue(0)
            }
        }
        off = Scope_Resolve(name)
        rt = Scope.resolve_type
        ok = 0
        IfCondition EqualTo(rt, 1) ThenBlock: { ok = 1 }
        IfCondition EqualTo(rt, 2) ThenBlock: { ok = 1 }
        IfCondition EqualTo(ok, 0) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterEqual(off, 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(off)
    }
}

// movsd the frame float into xmm `which`. Does not write rax or the other xmm.
Function.Optimize_ScanFltFrameLoad {
    Input: node: Address
    Input: which: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(node), AST.IDENTIFIER) ThenBlock: { ReturnValue(0) }
        off = Optimize_ScanFltFrame(AST_GetData1(node))
        IfCondition GreaterEqual(off, 0) ThenBlock: { ReturnValue(0) }
        X86_EmitRbpXmm(16, which, off)
        ReturnValue(1)
    }
}

// 1 when this tree cannot run the FMA matcher. That matcher writes xmm15.
Function.Optimize_ScanFltNoFma {
    Input: node: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(AST_GetType(node), AST.CALL) ThenBlock: {
            nm = AST_GetData1(node)
            IfCondition EqualTo(StringCompare(nm, "Float_Add"), 0) ThenBlock: { ReturnValue(0) }
            IfCondition EqualTo(StringCompare(nm, "Float_Sub"), 0) ThenBlock: { ReturnValue(0) }
        }
        n = AST_GetChildCount(node)
        i = 0
        WhileLoop LessThan(i, n) {
            IfCondition EqualTo(Optimize_ScanFltNoFma(AST_GetChild(node, i)), 0) ThenBlock: {
                ReturnValue(0)
            }
            i = Add(i, 1)
        }
        ReturnValue(1)
    }
}

// A float call that leaves xmm15 alone, so it can hold the other operand.
Function.Optimize_ScanFltScratchOk {
    Input: node: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(node), AST.CALL) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_FltProducer(AST_GetData1(node)), 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(Optimize_ScanFltNoFma(node))
    }
}

// Right operand into xmm1. xmm0 already holds the left value.
// A frame float is movsd. A multiply uses xmm15 instead of the stack.
Function.Optimize_ScanFltInto1 {
    Input: node: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(Optimize_ScanFltFrameLoad(node, 1), 1) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(Optimize_ScanFltScratchOk(node), 1) ThenBlock: {
            // xmm15 holds the outer operand for the whole CompileXmm.
            // A nested multiply would park over it and the addend
            // becomes the inner value. The push path is nested-safe.
            IfCondition EqualTo(ScanState.xmm15_busy, 0) ThenBlock: {
                ScanState.xmm15_busy = 1
                X86_Movapd(15, 0)
                got = Optimize_CompileXmm(node)
                ScanState.xmm15_busy = 0
                IfCondition EqualTo(got, 0) ThenBlock: {
                    X86_Movapd(0, 15)
                    ReturnValue(0)
                }
                Trans_Asm("MOVSD xmm1, xmm0")
                X86_Movapd(0, 15)
                ReturnValue(1)
            }
        }
        X86_PushXMM0()
        got = Optimize_CompileXmm(node)
        IfCondition EqualTo(got, 0) ThenBlock: {
            X86_PopXMM0()
            ReturnValue(0)
        }
        Trans_Asm("MOVSD xmm1, xmm0")
        X86_PopXMM0()
        ReturnValue(1)
    }
}

// Hardware xmm of a materialized identifier, or -1.
Function.Optimize_ScanFltSrc {
    Input: node: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition NotEqual(AST_GetType(node), AST.IDENTIFIER) ThenBlock: { ReturnValue(-1) }
        name = AST_GetData1(node)
        id = Optimize_TagIntern(name)
        IfCondition EqualTo(id, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition EqualTo(Optimize_ScanMatGet(id), 1) ThenBlock: {
            xmm = Optimize_ScanXmm(Optimize_ScanReg(id))
            IfCondition GreaterEqual(xmm, 0) ThenBlock: { ReturnValue(xmm) }
        }
        IfCondition NotEqual(ScanPtr.flt_keep, 0) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(name, ScanPtr.flt_keep), 1) ThenBlock: {
                ReturnValue(2)
            }
        }
        px = Optimize_ScanFltPark(name)
        IfCondition GreaterEqual(px, 0) ThenBlock: { ReturnValue(px) }
        ReturnValue(-1)
    }
}

// Hardware xmm, or -1 when reg is a GPR or a spill.
Function.Optimize_ScanXmm {
    Input: reg: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(reg, 36) ThenBlock: { ReturnValue(-1) }
        IfCondition GreaterThan(reg, 46) ThenBlock: { ReturnValue(-1) }
        ReturnValue(Subtract(reg, 32))
    }
}

// Write one materialized home back to its frame slot. Does not use
// rax: a clobber spill runs while rax holds the value that is about
// to overwrite the register. Leaves mat set. The caller clears it
// when the register itself is about to die.
Function.Optimize_ScanSpillId {
    Input: id: Integer
    Body: {
        IfCondition EqualTo(Optimize_ScanActive(), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_ScanMatGet(id), 0) ThenBlock: { ReturnValue(0) }
        reg = Optimize_ScanReg(id)
        IfCondition EqualTo(reg, -1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(TagState.names, 0) ThenBlock: { ReturnValue(0) }
        name = Dereference(Add(TagState.names, Multiply(Subtract(id, 1), 8)))
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }
        off = Scope_Resolve(name)
        IfCondition EqualTo(Scope.resolve_type, 3) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Scope.resolve_type, 0) ThenBlock: {
            Compile.stack_offset = Add(Compile.stack_offset, 8)
            off = Subtract(0, Compile.stack_offset)
            Compile_RegisterLocal(name, off)
        }
        xmm = Optimize_ScanXmm(reg)
        IfCondition GreaterEqual(xmm, 0) ThenBlock: {
            X86_MovsdRbpDisp(xmm, off)
            ReturnValue(0)
        }
        X86_MovRbpOffsetGpr(off, reg)
        ReturnValue(0)
    }
}

Function.Optimize_ScanSpillXmm {
    Body: {
        IfCondition EqualTo(Optimize_ScanActive(), 0) ThenBlock: { ReturnValue(0) }
        i = 1
        WhileLoop LessThan(i, Add(TagState.nnames, 1)) {
            IfCondition GreaterEqual(Optimize_ScanXmm(Optimize_ScanReg(i)), 0) ThenBlock: {
                Optimize_ScanSpillId(i)
            }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

// 1 when this tree can smash a float home. Float_* and integer math
// use xmm0/xmm1 or rbx, not the other homes. A real call does not
// save xmm, so the homes have to be in memory across it.
Function.Optimize_ScanTreeXmmKill {
    Input: node: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(AST_GetType(node), AST.CALL) ThenBlock: {
            nm = AST_GetData1(node)
            kill = 1
            IfCondition NotEqual(nm, 0) ThenBlock: {
                IfCondition EqualTo(Optimize_ScanByteSafe(nm), 1) ThenBlock: { kill = 0 }
                IfCondition EqualTo(Optimize_ScanUseClass(nm), 1) ThenBlock: { kill = 0 }
                IfCondition EqualTo(Optimize_ScanPtrPure(nm), 1) ThenBlock: { kill = 0 }
            }
            IfCondition EqualTo(kill, 1) ThenBlock: { ReturnValue(1) }
        }
        n = AST_GetChildCount(node)
        i = 0
        WhileLoop LessThan(i, n) {
            IfCondition EqualTo(Optimize_ScanTreeXmmKill(AST_GetChild(node, i)), 1) ThenBlock: {
                ReturnValue(1)
            }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

// Write homes whose registers this mask will scratch. Leaves mat set
// so a later MergeAnd can still keep a name that every arm left in
// the register. Switch passes the OR of every Case/Default body.
Function.Optimize_ScanSpillMask {
    Input: mask: Integer
    Input: xmm_kill: Integer
    Body: {
        IfCondition EqualTo(Optimize_ScanActive(), 0) ThenBlock: { ReturnValue(0) }
        i = 1
        last = Add(TagState.nnames, 1)
        WhileLoop LessThan(i, last) {
            IfCondition EqualTo(Optimize_ScanMatGet(i), 1) ThenBlock: {
                reg = Optimize_ScanReg(i)
                spill = 0
                IfCondition GreaterEqual(Optimize_ScanXmm(reg), 0) ThenBlock: {
                    IfCondition EqualTo(xmm_kill, 1) ThenBlock: { spill = 1 }
                }
                IfCondition EqualTo(reg, Reg.RBX) ThenBlock: {
                    IfCondition EqualTo(BitwiseAnd(mask, 1), 1) ThenBlock: { spill = 1 }
                }
                IfCondition EqualTo(reg, Reg.R12) ThenBlock: {
                    IfCondition EqualTo(BitwiseAnd(mask, 2), 2) ThenBlock: { spill = 1 }
                }
                IfCondition EqualTo(reg, Reg.R13) ThenBlock: {
                    IfCondition EqualTo(BitwiseAnd(mask, 4), 4) ThenBlock: { spill = 1 }
                }
                IfCondition EqualTo(spill, 1) ThenBlock: { Optimize_ScanSpillId(i) }
            }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

// Publish homes whose registers this tree will scratch. A float home
// stays in its xmm when nothing here calls out. r12 and r13 stay when
// the tree only reads them. Leaves mat set.
Function.Optimize_ScanSpillIf {
    Input: a: Address
    Input: b: Address
    Input: c: Address
    Body: {
        IfCondition EqualTo(Optimize_ScanActive(), 0) ThenBlock: { ReturnValue(0) }
        mask = Optimize_ScanLoopMask(a)
        mask = BitwiseOr(mask, Optimize_ScanLoopMask(b))
        mask = BitwiseOr(mask, Optimize_ScanLoopMask(c))
        xmm_kill = Optimize_ScanTreeXmmKill(a)
        IfCondition EqualTo(xmm_kill, 0) ThenBlock: {
            xmm_kill = Optimize_ScanTreeXmmKill(b)
        }
        IfCondition EqualTo(xmm_kill, 0) ThenBlock: {
            xmm_kill = Optimize_ScanTreeXmmKill(c)
        }
        ReturnValue(Optimize_ScanSpillMask(mask, xmm_kill))
    }
}

// 1 when nm is the builtin lit. A null name is not a match.
Function.Optimize_ScanIfEq {
    Input: nm: Address
    Input: lit: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(nm, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(StringCompare(nm, lit), 0) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

// 1 when compiling this call clears id's mat on this path only.
// A real call forgets caller-saved homes and every xmm without
// storing them. rbx, r12, and r13 survive a normal call. Inline
// math that writes one fixed register is listed here. ScanSpillIf
// already publishes rbx, r12, and r13 when the mask bit is set.
Function.Optimize_ScanIfCallKills {
    Input: node: Address
    Input: id: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        reg = Optimize_ScanReg(id)
        IfCondition EqualTo(reg, -1) ThenBlock: { ReturnValue(0) }
        nm = AST_GetData1(node)
        IfCondition EqualTo(Optimize_ScanByteSafe(nm), 0) ThenBlock: {
            IfCondition EqualTo(Optimize_ScanCallerReg(reg), 1) ThenBlock: { ReturnValue(1) }
            IfCondition GreaterEqual(Optimize_ScanXmm(reg), 0) ThenBlock: { ReturnValue(1) }
            IfCondition EqualTo(reg, Reg.R12) ThenBlock: {
                IfCondition EqualTo(Optimize_ScanIfEq(nm, "Allocate"), 1) ThenBlock: { ReturnValue(1) }
                IfCondition EqualTo(Optimize_ScanIfEq(nm, "Deallocate"), 1) ThenBlock: { ReturnValue(1) }
            }
            IfCondition EqualTo(reg, Reg.R13) ThenBlock: {
                IfCondition EqualTo(Optimize_ScanIfEq(nm, "StringLength"), 1) ThenBlock: { ReturnValue(1) }
                IfCondition EqualTo(Optimize_ScanIfEq(nm, "StringCompare"), 1) ThenBlock: { ReturnValue(1) }
                IfCondition EqualTo(Optimize_ScanIfEq(nm, "NumberToString"), 1) ThenBlock: { ReturnValue(1) }
            }
            ReturnValue(0)
        }
        IfCondition EqualTo(nm, 0) ThenBlock: { ReturnValue(0) }
        // idiv and cqo write rdx. The divisor shuttle writes rbx, which
        // ScanSpillIf publishes from the loop mask.
        IfCondition EqualTo(reg, Reg.RDX) ThenBlock: {
            IfCondition EqualTo(Optimize_ScanIfEq(nm, "Divide"), 1) ThenBlock: { ReturnValue(1) }
            IfCondition EqualTo(Optimize_ScanIfEq(nm, "Modulo"), 1) ThenBlock: { ReturnValue(1) }
        }
        // Two identifiers take the rcx pair (mov rcx, right). An
        // immediate add or subtract is add/sub rax, imm and leaves rcx.
        IfCondition EqualTo(reg, Reg.RCX) ThenBlock: {
            is_add = Optimize_ScanIfEq(nm, "Add")
            IfCondition EqualTo(is_add, 0) ThenBlock: {
                is_add = Optimize_ScanIfEq(nm, "Subtract")
            }
            IfCondition EqualTo(is_add, 1) ThenBlock: {
                IfCondition EqualTo(AST_GetChildCount(node), 2) ThenBlock: {
                    a0 = AST_GetChild(node, 0)
                    a1 = AST_GetChild(node, 1)
                    IfCondition NotEqual(a0, 0) ThenBlock: {
                        IfCondition NotEqual(a1, 0) ThenBlock: {
                            IfCondition EqualTo(AST_GetType(a0), AST.IDENTIFIER) ThenBlock: {
                                IfCondition EqualTo(AST_GetType(a1), AST.IDENTIFIER) ThenBlock: {
                                    ReturnValue(1)
                                }
                            }
                        }
                    }
                }
            }
            // A variable shift moves the count into rcx. An immediate
            // shift is shl/shr rax, imm8.
            is_sh = Optimize_ScanIfEq(nm, "LeftShift")
            IfCondition EqualTo(is_sh, 0) ThenBlock: { is_sh = Optimize_ScanIfEq(nm, "RightShift") }
            IfCondition EqualTo(is_sh, 0) ThenBlock: { is_sh = Optimize_ScanIfEq(nm, "ShiftLeft") }
            IfCondition EqualTo(is_sh, 0) ThenBlock: { is_sh = Optimize_ScanIfEq(nm, "ShiftRight") }
            IfCondition EqualTo(is_sh, 1) ThenBlock: {
                IfCondition GreaterEqual(AST_GetChildCount(node), 2) ThenBlock: {
                    sh = AST_GetChild(node, 1)
                    IfCondition NotEqual(sh, 0) ThenBlock: {
                        IfCondition EqualTo(AST_GetType(sh), AST.NUMBER) ThenBlock: { ReturnValue(0) }
                    }
                }
                ReturnValue(1)
            }
            IfCondition EqualTo(Optimize_ScanIfEq(nm, "SetByte"), 1) ThenBlock: { ReturnValue(1) }
            IfCondition EqualTo(Optimize_ScanIfEq(nm, "Dereference"), 1) ThenBlock: { ReturnValue(1) }
            IfCondition EqualTo(Optimize_ScanIfEq(nm, "StoreValue"), 1) ThenBlock: { ReturnValue(1) }
        }
        IfCondition EqualTo(reg, Reg.RDI) ThenBlock: {
            IfCondition EqualTo(Optimize_ScanIfEq(nm, "SetByte"), 1) ThenBlock: { ReturnValue(1) }
        }
        ReturnValue(0)
    }
}

// 1 when compiling node can leave id unmaterialized. The other arm of
// an If never executes that clear, and the join reloads the frame.
// A constant store into a different register does not. A loop or a
// switch inside the arm clears every home; one spill covers the join.
Function.Optimize_ScanIfDrops {
    Input: node: Address
    Input: id: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        t = AST_GetType(node)
        IfCondition EqualTo(t, AST.NUMBER) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(t, AST.STRING) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(t, AST.BOOLEAN) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(t, AST.NULL) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(t, AST.IDENTIFIER) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(t, AST.EXIT_LOOP) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(t, AST.CONTINUE_LOOP) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(t, AST.WHILE) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(t, AST.FOR_EVERY) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(t, AST.SWITCH) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(t, AST.TRY) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(t, AST.INLINEASM) ThenBlock: { ReturnValue(1) }
        walk = 0
        IfCondition EqualTo(t, AST.BLOCK) ThenBlock: { walk = 1 }
        IfCondition EqualTo(t, AST.BODY) ThenBlock: { walk = 1 }
        IfCondition EqualTo(t, AST.IF) ThenBlock: { walk = 1 }
        IfCondition EqualTo(t, AST.FORK) ThenBlock: { walk = 1 }
        IfCondition EqualTo(t, AST.RETURN) ThenBlock: { walk = 1 }
        IfCondition EqualTo(t, AST.CALL) ThenBlock: {
            IfCondition EqualTo(Optimize_ScanIfCallKills(node, id), 1) ThenBlock: { ReturnValue(1) }
            walk = 1
        }
        IfCondition EqualTo(t, AST.ASSIGNMENT) ThenBlock: {
            // ptr@field = value writes through a pool helper. That
            // helper is not a fixed register we can name, so spill.
            IfCondition NotEqual(AST_GetData2(node), 0) ThenBlock: { ReturnValue(1) }
            walk = 1
        }
        IfCondition EqualTo(walk, 1) ThenBlock: {
            n = AST_GetChildCount(node)
            i = 0
            WhileLoop LessThan(i, n) {
                IfCondition EqualTo(Optimize_ScanIfDrops(AST_GetChild(node, i), id), 1) ThenBlock: {
                    ReturnValue(1)
                }
                i = Add(i, 1)
            }
            IfCondition EqualTo(t, AST.ASSIGNMENT) ThenBlock: {
                // The store re-materializes this name. Another name in
                // the same register is spilled by ClobberReg on this
                // path only, so the join would reload a slot the other
                // arm did not write.
                tid = Optimize_ScanFind(AST_GetData1(node))
                IfCondition EqualTo(tid, id) ThenBlock: { ReturnValue(0) }
                IfCondition GreaterThan(tid, 0) ThenBlock: {
                    tr = Optimize_ScanReg(tid)
                    IfCondition NotEqual(tr, -1) ThenBlock: {
                        IfCondition EqualTo(tr, Optimize_ScanReg(id)) ThenBlock: { ReturnValue(1) }
                    }
                }
            }
            ReturnValue(0)
        }
        // Unrecognized node. Spill rather than guess that mat survives.
        ReturnValue(1)
    }
}

// Publish id when an arm can clear it. Leaves mat set: the register
// still holds the value on the path that does not run the arm.
// Homes the arm never kills stay in their registers. ScanSpillDirty
// remains the full publish used by loop MatClear.
Function.Optimize_ScanSpillJoin {
    Input: cond: Address
    Input: a: Address
    Input: b: Address
    Body: {
        IfCondition EqualTo(Optimize_ScanActive(), 0) ThenBlock: { ReturnValue(0) }
        i = 1
        last = Add(TagState.nnames, 1)
        WhileLoop LessThan(i, last) {
            IfCondition EqualTo(Optimize_ScanMatGet(i), 1) ThenBlock: {
                // A call in the condition forgets caller-saved homes
                // without storing. That clear is before the branch, so
                // both arms reload the frame. Compare conditions do not.
                drop = Optimize_ScanIfDrops(cond, i)
                IfCondition EqualTo(drop, 0) ThenBlock: {
                    drop = Optimize_ScanIfDrops(a, i)
                }
                IfCondition EqualTo(drop, 0) ThenBlock: {
                    drop = Optimize_ScanIfDrops(b, i)
                }
                IfCondition EqualTo(drop, 1) ThenBlock: { Optimize_ScanSpillId(i) }
            }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

// GPRs and xmms. Loop exit and a for-every body still publish every
// home. If and Fork use ScanSpillJoin so an arm that cannot clear a
// home does not store it. Leaves mat set.
Function.Optimize_ScanSpillDirty {
    Body: {
        IfCondition EqualTo(Optimize_ScanActive(), 0) ThenBlock: { ReturnValue(0) }
        i = 1
        WhileLoop LessThan(i, Add(TagState.nnames, 1)) {
            Optimize_ScanSpillId(i)
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

// A real call clobbers every xmm. Write the homes back and drop the
// cache flags. GPRs stay: rbx/r12/r13 are callee-saved.
Function.Optimize_ScanDropXmm {
    Body: {
        IfCondition EqualTo(Optimize_ScanActive(), 0) ThenBlock: { ReturnValue(0) }
        Optimize_ScanSpillXmm()
        i = 1
        WhileLoop LessThan(i, Add(TagState.nnames, 1)) {
            IfCondition GreaterEqual(Optimize_ScanXmm(Optimize_ScanReg(i)), 0) ThenBlock: {
                IfCondition EqualTo(Optimize_ScanMatGet(i), 1) ThenBlock: {
                    Optimize_VerifyEnd(i)
                }
                SetByte(ScanState.mat, Subtract(i, 1), 0)
            }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

// The xmm holds the value. Create the frame slot the first time this
// name is defined so a later spill has somewhere to land. Later
// updates leave the slot stale until that spill.
Function.Optimize_ScanFltPublish {
    Input: id: Integer
    Input: slot: Integer
    Input: name: Address
    Body: {
        Optimize_ScanMatSet(id)
        // Make sure a frame slot exists for the spill. Do not store on
        // this path: the xmm is the value, and a store here would run
        // on every trip of the loop.
        Scope_Resolve(name)
        IfCondition EqualTo(Scope.resolve_type, 0) ThenBlock: {
            Compile.stack_offset = Add(Compile.stack_offset, 8)
            off = Subtract(0, Compile.stack_offset)
            Compile_RegisterLocal(name, off)
        }
        Optimize_RaxDrop()
        ReturnValue(0)
    }
}

// target = target ± (a*b), or any float add/sub/mul/div/sqrt into the
// scan xmm. The stack slot is not rewritten on later updates. The
// loop-exit spill and the if-arm spill publish it. Returns 0 before
// any instruction when the shape does not match.
Function.Optimize_ScanFltUpdate {
    Input: target: Address
    Input: value: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(Optimize_ScanActive(), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(target, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(value, 0) ThenBlock: { ReturnValue(0) }
        id = Optimize_TagIntern(target)
        IfCondition EqualTo(id, 0) ThenBlock: { ReturnValue(0) }
        // The multiply loads this name from the pointer. Do not also
        // copy it into an xmm, and do not clobber that xmm first.
        IfCondition EqualTo(Optimize_IpMatchName(target), 1) ThenBlock: { ReturnValue(0) }
        slot = Optimize_ScanXmm(Optimize_ScanReg(id))
        IfCondition LessThan(slot, 2) ThenBlock: { ReturnValue(0) }
        // Another live name may still be in this xmm. Spill it before
        // the first write. keep leaves this name's bits in place so an
        // in-place update still sees them.
        ScanState.keep = id
        Optimize_ScanClobberReg(Optimize_ScanReg(id))
        ScanState.keep = 0
        // A fresh +0.0. The integer literal 0 has the same bits.
        IfCondition EqualTo(AST_GetType(value), AST.NUMBER) ThenBlock: {
            IfCondition EqualTo(StringToNumber(AST_GetData1(value)), 0) ThenBlock: {
                X86_PxorXmm(slot)
                Optimize_ScanFltPublish(id, slot, target)
                ReturnValue(1)
            }
            ReturnValue(0)
        }
        IfCondition NotEqual(AST_GetType(value), AST.CALL) ThenBlock: { ReturnValue(0) }
        opname = AST_GetData1(value)
        // ix = Dereference(bi) or Dereference(Add(bi, 8)) lands in the
        // xmm. The pointer is computed to rax and the float is never
        // staged through an integer store.
        IfCondition EqualTo(StringCompare(opname, "Dereference"), 0) ThenBlock: {
            IfCondition NotEqual(AST_GetChildCount(value), 1) ThenBlock: { ReturnValue(0) }
            addr = AST_GetChild(value, 0)
            disp = 0
            base_node = addr
            IfCondition NotEqual(addr, 0) ThenBlock: {
                IfCondition EqualTo(AST_GetType(addr), AST.CALL) ThenBlock: {
                    IfCondition EqualTo(StringCompare(AST_GetData1(addr), "Add"), 0) ThenBlock: {
                        IfCondition EqualTo(AST_GetChildCount(addr), 2) ThenBlock: {
                            c0 = AST_GetChild(addr, 0)
                            c1 = AST_GetChild(addr, 1)
                            IfCondition EqualTo(AST_GetType(c1), AST.NUMBER) ThenBlock: {
                                disp = StringToNumber(AST_GetData1(c1))
                                base_node = c0
                            }
                            IfCondition EqualTo(AST_GetType(c0), AST.NUMBER) ThenBlock: {
                                disp = StringToNumber(AST_GetData1(c0))
                                base_node = c1
                            }
                        }
                    }
                }
            }
            IfCondition EqualTo(Optimize_IpMatch(addr), 1) ThenBlock: {
                X86_MovsdPtr(slot, LoopHome.ip_hit_reg, LoopHome.ip_hit_disp)
                Optimize_ScanFltPublish(id, slot, target)
                ReturnValue(1)
            }
            IfCondition EqualTo(Optimize_ScanScaleLoad(addr, slot), 1) ThenBlock: {
                Optimize_ScanFltPublish(id, slot, target)
                ReturnValue(1)
            }
            IfCondition NotEqual(base_node, 0) ThenBlock: {
                IfCondition EqualTo(AST_GetType(base_node), AST.IDENTIFIER) ThenBlock: {
                    preg = Optimize_ScanPtrReg(AST_GetData1(base_node))
                    IfCondition NotEqual(preg, 0) ThenBlock: {
                        X86_MovsdPtr(slot, preg, disp)
                        Optimize_ScanPtrRmSet(target, preg, disp, 0)
                        Optimize_ScanFltPublish(id, slot, target)
                        ReturnValue(1)
                    }
                }
            }
            got = Compile_Expression(base_node)
            IfCondition EqualTo(got, 0) ThenBlock: {
                Compile.error = 1
                ReturnValue(1)
            }
            X86_MovsdRaxDisp(slot, disp)
            Optimize_ScanFltPublish(id, slot, target)
            ReturnValue(1)
        }
        IfCondition EqualTo(StringCompare(opname, "Float_Sqrt"), 0) ThenBlock: {
            IfCondition NotEqual(AST_GetChildCount(value), 1) ThenBlock: { ReturnValue(0) }
            src = AST_GetChild(value, 0)
            ss = Optimize_ScanFltSrc(src)
            IfCondition GreaterEqual(ss, 0) ThenBlock: {
                X86_XmmBin(81, slot, ss)
            } ElseBlock: {
                got = Compile_Expression(src)
                IfCondition EqualTo(got, 0) ThenBlock: {
                    Compile.error = 1
                    ReturnValue(1)
                }
                X86_XmmRR(1, 0)
                X86_XmmBin(81, slot, 0)
            }
            Optimize_ScanFltPublish(id, slot, target)
            ReturnValue(1)
        }
        // den = Float_FromInt(n) stays in the home. The integer arrives
        // in rax; cvtsi2sd writes xmm0, then one movsd fills the slot.
        IfCondition EqualTo(StringCompare(opname, "Float_FromInt"), 0) ThenBlock: {
            IfCondition NotEqual(AST_GetChildCount(value), 1) ThenBlock: { ReturnValue(0) }
            got = Compile_Expression(AST_GetChild(value, 0))
            IfCondition EqualTo(got, 0) ThenBlock: {
                Compile.error = 1
                ReturnValue(1)
            }
            Trans_Asm("CVTSI2SD xmm0, rax")
            IfCondition NotEqual(slot, 0) ThenBlock: {
                X86_XmmBin(16, slot, 0)
            }
            Optimize_ScanFltPublish(id, slot, target)
            ReturnValue(1)
        }
        IfCondition NotEqual(AST_GetChildCount(value), 2) ThenBlock: { ReturnValue(0) }
        is_add = 0
        is_sub = 0
        is_mul = 0
        is_div = 0
        IfCondition EqualTo(StringCompare(opname, "Float_Add"), 0) ThenBlock: { is_add = 1 }
        IfCondition EqualTo(StringCompare(opname, "Float_Sub"), 0) ThenBlock: { is_sub = 1 }
        IfCondition EqualTo(StringCompare(opname, "Float_Mul"), 0) ThenBlock: { is_mul = 1 }
        IfCondition EqualTo(StringCompare(opname, "Float_Div"), 0) ThenBlock: { is_div = 1 }
        IfCondition EqualTo(is_add, 0) ThenBlock: {
            IfCondition EqualTo(is_sub, 0) ThenBlock: {
                IfCondition EqualTo(is_mul, 0) ThenBlock: {
                    IfCondition EqualTo(is_div, 0) ThenBlock: { ReturnValue(0) }
                }
            }
        }
        left = AST_GetChild(value, 0)
        right = AST_GetChild(value, 1)
        // In-place FMA needs the old accumulator, so the xmm must already
        // hold it. A plain dx = ix - jx does not.
        IfCondition EqualTo(Optimize_ScanMatGet(id), 1) ThenBlock: {
        IfCondition EqualTo(is_mul, 0) ThenBlock: {
            mul = 0
            IfCondition EqualTo(is_sub, 1) ThenBlock: {
                IfCondition EqualTo(Optimize_IdentEq(left, target), 1) ThenBlock: {
                    IfCondition EqualTo(Optimize_IsFloatMul(right), 1) ThenBlock: { mul = right }
                }
            }
            IfCondition EqualTo(is_add, 1) ThenBlock: {
                IfCondition EqualTo(Optimize_IdentEq(left, target), 1) ThenBlock: {
                    IfCondition EqualTo(Optimize_IsFloatMul(right), 1) ThenBlock: { mul = right }
                }
                IfCondition EqualTo(Optimize_IdentEq(right, target), 1) ThenBlock: {
                    IfCondition EqualTo(Optimize_IsFloatMul(left), 1) ThenBlock: { mul = left }
                }
            }
            IfCondition NotEqual(mul, 0) ThenBlock: {
                got = FPUCompileX86_FmaHome(slot, AST_GetChild(mul, 0), AST_GetChild(mul, 1), is_sub)
                IfCondition EqualTo(got, 1) ThenBlock: {
                    Optimize_ScanFltPublish(id, slot, target)
                    ReturnValue(1)
                }
            }
        }
        }
        // prod = (one / Float_FromInt(...)) * u[j]. The div was folded
        // in, so this one statement is the column's float chain.
        IfCondition EqualTo(is_mul, 1) ThenBlock: {
            IfCondition NotEqual(left, 0) ThenBlock: {
                IfCondition EqualTo(AST_GetType(left), AST.CALL) ThenBlock: {
                    IfCondition EqualTo(StringCompare(AST_GetData1(left), "Float_Div"), 0) ThenBlock: {
                        IfCondition EqualTo(AST_GetChildCount(left), 2) ThenBlock: {
                            mem = 0
                            IfCondition NotEqual(right, 0) ThenBlock: {
                                IfCondition EqualTo(AST_GetType(right), AST.CALL) ThenBlock: {
                                    IfCondition EqualTo(StringCompare(AST_GetData1(right), "Dereference"), 0) ThenBlock: {
                                        IfCondition EqualTo(AST_GetChildCount(right), 1) ThenBlock: {
                                            mem = 1
                                        }
                                    }
                                }
                            }
                            IfCondition EqualTo(mem, 1) ThenBlock: {
                            d0 = AST_GetChild(left, 0)
                            d1 = AST_GetChild(left, 1)
                            den_ok = 0
                            IfCondition NotEqual(d1, 0) ThenBlock: {
                                IfCondition EqualTo(AST_GetType(d1), AST.CALL) ThenBlock: {
                                    IfCondition EqualTo(StringCompare(AST_GetData1(d1), "Float_FromInt"), 0) ThenBlock: {
                                        IfCondition EqualTo(AST_GetChildCount(d1), 1) ThenBlock: {
                                            got = Compile_Expression(AST_GetChild(d1, 0))
                                            IfCondition EqualTo(got, 1) ThenBlock: {
                                                X86_Cvtsi2sdXmm1()
                                                den_ok = 1
                                            }
                                        }
                                    }
                                }
                            }
                            IfCondition EqualTo(den_ok, 0) ThenBlock: {
                                drs = Optimize_ScanFltSrc(d1)
                                IfCondition GreaterEqual(drs, 0) ThenBlock: {
                                    X86_XmmRR(8, drs)
                                    den_ok = 1
                                }
                            }
                            IfCondition EqualTo(den_ok, 1) ThenBlock: {
                                one_ok = 0
                                ols = Optimize_ScanFltSrc(d0)
                                IfCondition GreaterEqual(ols, 0) ThenBlock: {
                                    X86_XmmBin(16, 0, ols)
                                    one_ok = 1
                                }
                                IfCondition EqualTo(one_ok, 1) ThenBlock: {
                                    X86_XmmBin(94, 0, 1)
                                    mul_ok = 0
                                    IfCondition NotEqual(right, 0) ThenBlock: {
                                        IfCondition EqualTo(AST_GetType(right), AST.CALL) ThenBlock: {
                                            IfCondition EqualTo(StringCompare(AST_GetData1(right), "Dereference"), 0) ThenBlock: {
                                                IfCondition EqualTo(AST_GetChildCount(right), 1) ThenBlock: {
                                                    IfCondition EqualTo(Optimize_ScanScaleOp(AST_GetChild(right, 0), 89), 1) ThenBlock: {
                                                        mul_ok = 1
                                                    }
                                                }
                                            }
                                        }
                                    }
                                    IfCondition EqualTo(mul_ok, 1) ThenBlock: {
                                        X86_XmmBin(16, slot, 0)
                                        Optimize_ScanFltPublish(id, slot, target)
                                        ReturnValue(1)
                                    }
                                    Compile.error = 1
                                    ReturnValue(1)
                                }
                            }
                            }
                        }
                    }
                }
            }
        }
        ls = Optimize_ScanFltSrc(left)
        rs = Optimize_ScanFltSrc(right)
        // Both factors are already in xmms. Operate on the home.
        // Copying through xmm0/xmm1 on every column is the slow path.
        IfCondition GreaterEqual(ls, 0) ThenBlock: {
            IfCondition GreaterEqual(rs, 0) ThenBlock: {
                fast = 0
                IfCondition NotEqual(slot, rs) ThenBlock: { fast = 1 }
                IfCondition EqualTo(is_add, 1) ThenBlock: { fast = 1 }
                IfCondition EqualTo(is_mul, 1) ThenBlock: { fast = 1 }
                IfCondition EqualTo(fast, 1) ThenBlock: {
                    opc = 88
                    IfCondition EqualTo(is_sub, 1) ThenBlock: { opc = 92 }
                    IfCondition EqualTo(is_mul, 1) ThenBlock: { opc = 89 }
                    IfCondition EqualTo(is_div, 1) ThenBlock: { opc = 94 }
                    IfCondition EqualTo(slot, ls) ThenBlock: {
                        X86_XmmBin(opc, slot, rs)
                    } ElseBlock: {
                        IfCondition EqualTo(slot, rs) ThenBlock: {
                            X86_XmmBin(opc, slot, ls)
                        } ElseBlock: {
                            IfCondition EqualTo(Hw.avx, 1) ThenBlock: {
                                X86_VexSd(opc, slot, ls, rs)
                            } ElseBlock: {
                                X86_Movapd(slot, ls)
                                X86_XmmBin(opc, slot, rs)
                            }
                        }
                    }
                    Optimize_ScanFltPublish(id, slot, target)
                    ReturnValue(1)
                }
            }
        }
        // prod = a * u[j] with u[j] still a scaled address. xmm0 holds
        // a, mulsd reads [base+index*scale], the product lands in the home.
        IfCondition EqualTo(is_mul, 1) ThenBlock: {
            IfCondition GreaterEqual(ls, 0) ThenBlock: {
                IfCondition LessThan(rs, 0) ThenBlock: {
                    IfCondition NotEqual(right, 0) ThenBlock: {
                        IfCondition EqualTo(AST_GetType(right), AST.CALL) ThenBlock: {
                            IfCondition EqualTo(StringCompare(AST_GetData1(right), "Dereference"), 0) ThenBlock: {
                                IfCondition EqualTo(AST_GetChildCount(right), 1) ThenBlock: {
                                    X86_XmmBin(16, 0, ls)
                                    IfCondition EqualTo(Optimize_ScanScaleOp(AST_GetChild(right, 0), 89), 1) ThenBlock: {
                                        X86_XmmBin(16, slot, 0)
                                        Optimize_ScanFltPublish(id, slot, target)
                                        ReturnValue(1)
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        // zr = (zr2 - zi2) + cr. All three are homes. xmm0 is scratch
        // so the sources stay intact, then one movsd fills the home.
        IfCondition EqualTo(is_add, 1) ThenBlock: {
            IfCondition NotEqual(left, 0) ThenBlock: {
                IfCondition EqualTo(AST_GetType(left), AST.CALL) ThenBlock: {
                    IfCondition EqualTo(StringCompare(AST_GetData1(left), "Float_Sub"), 0) ThenBlock: {
                        IfCondition EqualTo(AST_GetChildCount(left), 2) ThenBlock: {
                            sa = Optimize_ScanFltSrc(AST_GetChild(left, 0))
                            sb = Optimize_ScanFltSrc(AST_GetChild(left, 1))
                            sc = Optimize_ScanFltSrc(right)
                            IfCondition GreaterEqual(sa, 0) ThenBlock: {
                                IfCondition GreaterEqual(sb, 0) ThenBlock: {
                                    IfCondition GreaterEqual(sc, 0) ThenBlock: {
                                        // Write the home when it is not one of
                                        // the sources. Otherwise xmm0 is scratch.
                                        into = 0
                                        IfCondition NotEqual(slot, sa) ThenBlock: {
                                            IfCondition NotEqual(slot, sb) ThenBlock: {
                                                IfCondition NotEqual(slot, sc) ThenBlock: { into = 1 }
                                            }
                                        }
                                        dst = 0
                                        IfCondition EqualTo(into, 1) ThenBlock: { dst = slot }
                                        X86_Movapd(dst, sa)
                                        X86_XmmBin(92, dst, sb)
                                        X86_XmmBin(88, dst, sc)
                                        IfCondition EqualTo(into, 0) ThenBlock: {
                                            X86_Movapd(slot, 0)
                                        }
                                        Optimize_ScanFltPublish(id, slot, target)
                                        ReturnValue(1)
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        // zi = two * (zr * zi) + ci. Same rule: the product is not
        // written back through rax between the multiply and the add.
        IfCondition EqualTo(is_add, 1) ThenBlock: {
            IfCondition NotEqual(left, 0) ThenBlock: {
                IfCondition EqualTo(AST_GetType(left), AST.CALL) ThenBlock: {
                    IfCondition EqualTo(StringCompare(AST_GetData1(left), "Float_Mul"), 0) ThenBlock: {
                        IfCondition EqualTo(AST_GetChildCount(left), 2) ThenBlock: {
                            m0 = AST_GetChild(left, 0)
                            m1 = AST_GetChild(left, 1)
                            inner = 0
                            scale = 0
                            IfCondition NotEqual(m1, 0) ThenBlock: {
                                IfCondition EqualTo(AST_GetType(m1), AST.CALL) ThenBlock: {
                                    IfCondition EqualTo(StringCompare(AST_GetData1(m1), "Float_Mul"), 0) ThenBlock: {
                                        inner = m1
                                        scale = m0
                                    }
                                }
                            }
                            IfCondition EqualTo(inner, 0) ThenBlock: {
                                IfCondition NotEqual(m0, 0) ThenBlock: {
                                    IfCondition EqualTo(AST_GetType(m0), AST.CALL) ThenBlock: {
                                        IfCondition EqualTo(StringCompare(AST_GetData1(m0), "Float_Mul"), 0) ThenBlock: {
                                            inner = m0
                                            scale = m1
                                        }
                                    }
                                }
                            }
                            IfCondition NotEqual(inner, 0) ThenBlock: {
                                IfCondition EqualTo(AST_GetChildCount(inner), 2) ThenBlock: {
                                    p = Optimize_ScanFltSrc(AST_GetChild(inner, 0))
                                    q = Optimize_ScanFltSrc(AST_GetChild(inner, 1))
                                    s = Optimize_ScanFltSrc(scale)
                                    t = Optimize_ScanFltSrc(right)
                                    IfCondition GreaterEqual(p, 0) ThenBlock: {
                                        IfCondition GreaterEqual(q, 0) ThenBlock: {
                                            IfCondition GreaterEqual(s, 0) ThenBlock: {
                                                IfCondition GreaterEqual(t, 0) ThenBlock: {
                                                    into = 0
                                                    IfCondition NotEqual(slot, p) ThenBlock: {
                                                        IfCondition NotEqual(slot, q) ThenBlock: {
                                                            IfCondition NotEqual(slot, s) ThenBlock: {
                                                                IfCondition NotEqual(slot, t) ThenBlock: { into = 1 }
                                                            }
                                                        }
                                                    }
                                                    dst = 0
                                                    IfCondition EqualTo(into, 1) ThenBlock: { dst = slot }
                                                    X86_Movapd(dst, p)
                                                    X86_XmmBin(89, dst, q)
                                                    X86_XmmBin(89, dst, s)
                                                    X86_XmmBin(88, dst, t)
                                                    IfCondition EqualTo(into, 0) ThenBlock: {
                                                        X86_Movapd(slot, 0)
                                                    }
                                                    Optimize_ScanFltPublish(id, slot, target)
                                                    ReturnValue(1)
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        // A field the scan spilled is still [r11 or r14 + disp].
        // subsd/mulsd read that address. Copying both sides through
        // xmm0 and xmm1 is the slow path below.
        ls = Optimize_ScanFltSrc(left)
        rs = Optimize_ScanFltSrc(right)
        lrm = 0
        rrm = 0
        lreg = 0
        ldisp = 0
        rreg = 0
        rdisp = 0
        IfCondition LessThan(ls, 0) ThenBlock: {
            IfCondition NotEqual(left, 0) ThenBlock: {
                IfCondition EqualTo(AST_GetType(left), AST.IDENTIFIER) ThenBlock: {
                    lrm = Optimize_ScanPtrRmFind(AST_GetData1(left))
                    IfCondition EqualTo(lrm, 1) ThenBlock: {
                        lreg = ScanPtr.hit_reg
                        ldisp = ScanPtr.hit_disp
                    }
                }
            }
        }
        IfCondition LessThan(rs, 0) ThenBlock: {
            IfCondition NotEqual(right, 0) ThenBlock: {
                IfCondition EqualTo(AST_GetType(right), AST.IDENTIFIER) ThenBlock: {
                    rrm = Optimize_ScanPtrRmFind(AST_GetData1(right))
                    IfCondition EqualTo(rrm, 1) ThenBlock: {
                        rreg = ScanPtr.hit_reg
                        rdisp = ScanPtr.hit_disp
                    }
                }
            }
        }
        opc = 88
        IfCondition EqualTo(is_sub, 1) ThenBlock: { opc = 92 }
        IfCondition EqualTo(is_mul, 1) ThenBlock: { opc = 89 }
        IfCondition EqualTo(is_div, 1) ThenBlock: { opc = 94 }
        IfCondition EqualTo(lrm, 1) ThenBlock: {
            IfCondition EqualTo(rrm, 1) ThenBlock: {
                X86_MovsdPtr(slot, lreg, ldisp)
                X86_XmmPtr(opc, slot, rreg, rdisp)
                Optimize_ScanFltPublish(id, slot, target)
                ReturnValue(1)
            }
        }
        IfCondition GreaterEqual(ls, 0) ThenBlock: {
            IfCondition EqualTo(rrm, 1) ThenBlock: {
                IfCondition EqualTo(slot, ls) ThenBlock: {
                    X86_XmmPtr(opc, slot, rreg, rdisp)
                } ElseBlock: {
                    IfCondition EqualTo(Hw.avx, 1) ThenBlock: {
                        X86_VexSdPtr(opc, slot, ls, rreg, rdisp)
                    } ElseBlock: {
                        X86_Movapd(slot, ls)
                        X86_XmmPtr(opc, slot, rreg, rdisp)
                    }
                }
                Optimize_ScanFltPublish(id, slot, target)
                ReturnValue(1)
            }
        }
        IfCondition EqualTo(lrm, 1) ThenBlock: {
            IfCondition GreaterEqual(rs, 2) ThenBlock: {
                // t = mem * home, and t lives in the home. One mulsd/addsd.
                IfCondition EqualTo(slot, rs) ThenBlock: {
                    mem_ok = 0
                    IfCondition EqualTo(is_add, 1) ThenBlock: { mem_ok = 1 }
                    IfCondition EqualTo(is_mul, 1) ThenBlock: { mem_ok = 1 }
                    IfCondition EqualTo(mem_ok, 1) ThenBlock: {
                        X86_XmmPtr(opc, slot, lreg, ldisp)
                        Optimize_ScanFltPublish(id, slot, target)
                        ReturnValue(1)
                    }
                }
                IfCondition NotEqual(slot, rs) ThenBlock: {
                    IfCondition EqualTo(Hw.avx, 1) ThenBlock: {
                        X86_VexSdPtr(opc, slot, rs, lreg, ldisp)
                    } ElseBlock: {
                        X86_Movapd(slot, rs)
                        X86_XmmPtr(opc, slot, lreg, ldisp)
                    }
                    Optimize_ScanFltPublish(id, slot, target)
                    ReturnValue(1)
                }
            }
        }
        // left in xmm0, right in xmm1, then the op into the home.
        // A source that is already in an xmm is copied. A frame float
        // is movsd. A nested multiply keeps the left value in xmm15.
        // The home is not stored; the loop-exit spill writes it back.
        ls = Optimize_ScanFltSrc(left)
        lrm = 0
        IfCondition LessThan(ls, 0) ThenBlock: {
            IfCondition NotEqual(left, 0) ThenBlock: {
                IfCondition EqualTo(AST_GetType(left), AST.IDENTIFIER) ThenBlock: {
                    lrm = Optimize_ScanPtrRmFind(AST_GetData1(left))
                }
            }
        }
        IfCondition GreaterEqual(ls, 0) ThenBlock: {
            X86_XmmBin(16, 0, ls)
        } ElseBlock: {
            IfCondition EqualTo(lrm, 1) ThenBlock: {
                X86_MovsdPtr(0, ScanPtr.hit_reg, ScanPtr.hit_disp)
            } ElseBlock: {
                got = Optimize_CompileXmm(left)
                IfCondition EqualTo(got, 0) ThenBlock: {
                    Compile.error = 1
                    ReturnValue(1)
                }
            }
        }
        rs = Optimize_ScanFltSrc(right)
        rrm = 0
        IfCondition LessThan(rs, 0) ThenBlock: {
            IfCondition NotEqual(right, 0) ThenBlock: {
                IfCondition EqualTo(AST_GetType(right), AST.IDENTIFIER) ThenBlock: {
                    rrm = Optimize_ScanPtrRmFind(AST_GetData1(right))
                }
            }
        }
        IfCondition GreaterEqual(rs, 0) ThenBlock: {
            X86_XmmRR(8, rs)
        } ElseBlock: {
            IfCondition EqualTo(rrm, 1) ThenBlock: {
                X86_MovsdPtr(1, ScanPtr.hit_reg, ScanPtr.hit_disp)
            } ElseBlock: {
                got = Optimize_ScanFltInto1(right)
                IfCondition EqualTo(got, 0) ThenBlock: {
                    Compile.error = 1
                    ReturnValue(1)
                }
            }
        }
        X86_XmmBin(16, slot, 0)
        opc = 88
        IfCondition EqualTo(is_sub, 1) ThenBlock: { opc = 92 }
        IfCondition EqualTo(is_mul, 1) ThenBlock: { opc = 89 }
        IfCondition EqualTo(is_div, 1) ThenBlock: { opc = 94 }
        X86_XmmBin(opc, slot, 1)
        Optimize_ScanFltPublish(id, slot, target)
        ReturnValue(1)
    }
}

// Loop exit. Registers the body scratches are spilled and forgotten.
// A register the body only reads still holds its value on every
// exit, including zero-trip, so it stays materialized and the
// frame is left alone.
Function.Optimize_ScanMatKeep {
    Body: {
        IfCondition EqualTo(Optimize_ScanActive(), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(ScanState.mat, 0) ThenBlock: { ReturnValue(0) }
        mask = ScanState.loop_mask
        i = 1
        last = Add(TagState.nnames, 1)
        WhileLoop LessThan(i, last) {
            IfCondition EqualTo(Optimize_ScanMatGet(i), 1) ThenBlock: {
                reg = Optimize_ScanReg(i)
                drop = 0
                IfCondition GreaterEqual(Optimize_ScanXmm(reg), 0) ThenBlock: { drop = 1 }
                IfCondition EqualTo(reg, Reg.RBX) ThenBlock: {
                    IfCondition EqualTo(BitwiseAnd(mask, 1), 1) ThenBlock: { drop = 1 }
                }
                IfCondition EqualTo(reg, Reg.R12) ThenBlock: {
                    IfCondition EqualTo(BitwiseAnd(mask, 2), 2) ThenBlock: { drop = 1 }
                }
                IfCondition EqualTo(reg, Reg.R13) ThenBlock: {
                    IfCondition EqualTo(BitwiseAnd(mask, 4), 4) ThenBlock: { drop = 1 }
                }
                IfCondition EqualTo(drop, 1) ThenBlock: {
                    Optimize_ScanSpillId(i)
                    Optimize_VerifyEnd(i)
                    SetByte(ScanState.mat, Subtract(i, 1), 0)
                }
            }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

// Drop every materialized home. Write GPRs and xmms back first.
// A homed assignment does not store, so the frame is behind the
// register until this spill. A zero-trip loop still has the
// pre-loop bits in the register.
Function.Optimize_ScanMatClear {
    Body: {
        IfCondition EqualTo(Optimize_ScanActive(), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(ScanState.mat, 0) ThenBlock: { ReturnValue(0) }
        Optimize_ScanSpillDirty()
        i = 0
        WhileLoop LessThan(i, 128) {
            IfCondition EqualTo(GetByte(ScanState.mat, i), 1) ThenBlock: {
                Optimize_VerifyEnd(Add(i, 1))
            }
            SetByte(ScanState.mat, i, 0)
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

// Drop flags without writing homes. The slow Branch comparison chain
// emits at a point that is not on every path, so a spill there would
// be dead code. Case bodies then reload from the frame.
Function.Optimize_ScanMatForget {
    Body: {
        IfCondition EqualTo(ScanState.mat, 0) ThenBlock: { ReturnValue(0) }
        i = 0
        WhileLoop LessThan(i, 128) {
            IfCondition EqualTo(GetByte(ScanState.mat, i), 1) ThenBlock: {
                Optimize_VerifyEnd(Add(i, 1))
            }
            SetByte(ScanState.mat, i, 0)
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

// Last-chance load: 1 when this emitted "mov rax, reg" instead of a
// memory load. name must already be interned (Optimize_TagFunction
// ran before any statement compiled) and materialized (some earlier
// store in this same straight-line body already populated the
// register - see Optimize_ScanNoteStore/Optimize_ScanSeedLoad).
Function.Optimize_ScanTryLoad {
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(Optimize_ScanActive(), 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(ScanPtr.run_name, 0) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(name, ScanPtr.run_name), 1) ThenBlock: {
                Emit_MovRegReg(Reg.RAX, Reg.R11)
                ReturnValue(1)
            }
        }
        id = Optimize_TagIntern(name)
        IfCondition EqualTo(id, 0) ThenBlock: { ReturnValue(0) }
        reg = Optimize_ScanReg(id)
        IfCondition EqualTo(reg, -1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_ScanMatGet(id), 0) ThenBlock: { ReturnValue(0) }
        xmm = Optimize_ScanXmm(reg)
        IfCondition GreaterEqual(xmm, 0) ThenBlock: {
            X86_XmmRR(2, xmm)
            ReturnValue(1)
        }
        Emit_MovRegReg(Reg.RAX, reg)
        ReturnValue(1)
    }
}

// Called right after the normal stack load, win or lose: seeds the
// register the first time this name is read (covers a parameter that
// is read before ever being assigned - the only case a name can reach
// a load with a register but without a prior store in a single
// straight-line block).
Function.Optimize_ScanSeedLoad {
    Input: name: Address
    Body: {
        IfCondition EqualTo(Optimize_ScanActive(), 0) ThenBlock: { ReturnValue(0) }
        id = Optimize_TagIntern(name)
        IfCondition EqualTo(id, 0) ThenBlock: { ReturnValue(0) }
        reg = Optimize_ScanReg(id)
        IfCondition EqualTo(reg, -1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_ScanMatGet(id), 1) ThenBlock: { ReturnValue(0) }
        xmm = Optimize_ScanXmm(reg)
        IfCondition GreaterEqual(xmm, 0) ThenBlock: {
            X86_XmmRR(1, xmm)
            Optimize_ScanMatSet(id)
            ReturnValue(0)
        }
        // rbx is the scratch register for Add/Sub/Mul (the other operand
        // sits there). Copying a home into rbx in the middle of that
        // expression replaces the other operand. The statement-end store
        // still fills rbx once the scratch is dead.
        IfCondition EqualTo(reg, Reg.RBX) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterEqual(reg, 0) ThenBlock: {
            IfCondition LessEqual(reg, 15) ThenBlock: {
                IfCondition LessThan(Optimize_ScanXmm(reg), 0) ThenBlock: {
                    Optimize_VerifyBegin(id, reg)
                }
            }
        }
        Emit_MovRegReg(reg, Reg.RAX)
        Optimize_ScanMatSet(id)
        ReturnValue(0)
    }
}

// Called at the very top of CompileStmt_Assignment, before any of its
// fused/specialized paths run - several of them (Optimize_TryFoldAssign,
// TryHomeAssign, TryMaskStep, ...) write the target's stack slot
// through their own emission and return without ever reaching
// CompileExpr_StoreVariable, which is the only place Optimize_
// ScanNoteStore lives. Without this, a name already materialized into
// its register by an earlier plain assignment would go stale the
// moment a fused path reassigns it through one of those side doors -
// the stack slot gets the new value, the cached register keeps the
// old one, and a later load would silently read the wrong answer.
// Unconditionally clearing "materialized" here, before the assignment
// is even dispatched, means: if the plain CompileExpr_StoreVariable
// path ends up handling it, Optimize_ScanNoteStore immediately
// re-marks it materialized with the correct value; if a fused path
// handles it instead, the flag simply stays cleared and the next load
// falls through to the real (now up to date) stack value and reseeds
// the register from there - a missed caching opportunity, never a
// correctness gap.
Function.Optimize_ScanInvalidate {
    Input: name: Address
    Body: {
        IfCondition EqualTo(Optimize_ScanActive(), 0) ThenBlock: { ReturnValue(0) }
        id = Optimize_TagIntern(name)
        IfCondition EqualTo(id, 0) ThenBlock: { ReturnValue(0) }
        IfCondition Or(LessThan(id, 1), GreaterThan(id, 128)) ThenBlock: { ReturnValue(0) }
        Optimize_ScanSpillId(id)
        IfCondition EqualTo(Optimize_ScanMatGet(id), 1) ThenBlock: {
            Optimize_VerifyEnd(id)
        }
        SetByte(ScanState.mat, Subtract(id, 1), 0)
        ReturnValue(0)
    }
}

// 1 when the scan register, not the frame, holds this name.
Function.Optimize_ScanHomed {
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(Optimize_ScanActive(), 0) ThenBlock: { ReturnValue(0) }
        id = Optimize_TagIntern(name)
        IfCondition EqualTo(id, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_ScanReg(id), -1) ThenBlock: { ReturnValue(0) }
        ReturnValue(1)
    }
}

// 1 when StoreVariable should update the register and skip the frame
// store. A register the enclosing loop scratches is reloaded from the
// frame at the header, so that name still stores.
Function.Optimize_ScanHold {
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(Optimize_ScanHomed(name), 0) ThenBlock: { ReturnValue(0) }
        id = Optimize_TagIntern(name)
        reg = Optimize_ScanReg(id)
        mask = ScanState.loop_mask
        IfCondition EqualTo(reg, Reg.RBX) ThenBlock: {
            IfCondition EqualTo(BitwiseAnd(mask, 1), 1) ThenBlock: { ReturnValue(0) }
        }
        IfCondition EqualTo(reg, Reg.R12) ThenBlock: {
            IfCondition EqualTo(BitwiseAnd(mask, 2), 2) ThenBlock: { ReturnValue(0) }
        }
        IfCondition EqualTo(reg, Reg.R13) ThenBlock: {
            IfCondition EqualTo(BitwiseAnd(mask, 4), 4) ThenBlock: { ReturnValue(0) }
        }
        // Caller-saved homes are reused as scratch, and a loop body is
        // compiled once. If that compile sees the name unmaterialized,
        // every iteration reloads the frame. The back edge does not
        // spill, so the assignment has to write the slot. Callee-saved
        // rbx/r12/r13 stay register-only unless the loop mask drops them.
        IfCondition EqualTo(reg, Reg.RCX) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(reg, Reg.RDX) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(reg, Reg.RSI) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(reg, Reg.RDI) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(reg, Reg.R8) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(reg, Reg.R9) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(reg, Reg.R10) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(reg, Reg.R11) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(reg, Reg.R14) ThenBlock: { ReturnValue(0) }
        ReturnValue(1)
    }
}

// The frame was just written by a path that did not go through
// StoreVariable. Drop the cache flag without spilling the old register
// over that new slot.
Function.Optimize_ScanMatDrop {
    Input: name: Address
    Body: {
        IfCondition EqualTo(Optimize_ScanActive(), 0) ThenBlock: { ReturnValue(0) }
        id = Optimize_TagIntern(name)
        IfCondition EqualTo(id, 0) ThenBlock: { ReturnValue(0) }
        IfCondition Or(LessThan(id, 1), GreaterThan(id, 128)) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_ScanMatGet(id), 1) ThenBlock: {
            Optimize_VerifyEnd(id)
        }
        SetByte(ScanState.mat, Subtract(id, 1), 0)
        ReturnValue(0)
    }
}

// Copy rax into the scan register. The frame store is the caller's
// choice. keep stops this write from spilling the name it is defining.
// Any other name still living in the register is spilled first.
Function.Optimize_ScanNoteStore {
    Input: name: Address
    Body: {
        IfCondition EqualTo(Optimize_ScanActive(), 0) ThenBlock: { ReturnValue(0) }
        id = Optimize_TagIntern(name)
        IfCondition EqualTo(id, 0) ThenBlock: { ReturnValue(0) }
        reg = Optimize_ScanReg(id)
        IfCondition EqualTo(reg, -1) ThenBlock: { ReturnValue(0) }
        ScanState.keep = id
        Optimize_ScanClobberReg(reg)
        xmm = Optimize_ScanXmm(reg)
        IfCondition GreaterEqual(xmm, 0) ThenBlock: {
            X86_XmmRR(1, xmm)
        } ElseBlock: {
            IfCondition GreaterEqual(reg, 0) ThenBlock: {
                IfCondition LessEqual(reg, 15) ThenBlock: {
                    IfCondition LessThan(Optimize_ScanXmm(reg), 0) ThenBlock: {
                        Optimize_VerifyBegin(id, reg)
                    }
                }
            }
            Emit_MovRegReg(reg, Reg.RAX)
        }
        ScanState.keep = 0
        Optimize_ScanMatSet(id)
        ReturnValue(0)
    }
}

// 1 when a scan home is materialized in rbx. The math shuttle
// writes rbx, so the caller pushes it and pops after the op.
Function.Optimize_ScanRbxMat {
    Output: Integer
    Body: {
        IfCondition EqualTo(Optimize_ScanActive(), 0) ThenBlock: { ReturnValue(0) }
        i = 1
        last = Add(TagState.nnames, 1)
        WhileLoop LessThan(i, last) {
            IfCondition EqualTo(Optimize_ScanReg(i), Reg.RBX) ThenBlock: {
                IfCondition EqualTo(Optimize_ScanMatGet(i), 1) ThenBlock: {
                    ReturnValue(1)
                }
            }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

// The slot is already the value. Drop the register without storing it:
// a scratch may already have overwritten it, and a spill would publish
// that scratch as the name.
Function.Optimize_ScanForgetReg {
    Input: reg: Integer
    Body: {
        IfCondition NotEqual(ScanState.want, 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(ScanState.eligible, 0) ThenBlock: { ReturnValue(0) }
        i = 1
        WhileLoop LessThan(i, Add(TagState.nnames, 1)) {
            IfCondition EqualTo(Optimize_ScanReg(i), reg) ThenBlock: {
                IfCondition EqualTo(Optimize_ScanMatGet(i), 1) ThenBlock: {
                    Optimize_VerifyEnd(i)
                }
                SetByte(ScanState.mat, Subtract(i, 1), 0)
            }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

// A CanHold parameter is not in the frame. Loads of its slot are
// rewritten to the incoming register. Before that register is
// overwritten, write it out and drop the rewrite. Scan off still
// holds parameters this way, so this does not check the scan gate.
Function.Optimize_ScanBreakHold {
    Input: reg: Integer
    Body: {
        IfCondition LessThan(reg, 0) ThenBlock: { ReturnValue(0) }
        slot = 0
        WhileLoop LessThan(slot, 6) {
            off = Subtract(0, Multiply(Add(slot, 1), 8))
            hold = CompileFunc_HoldReg(off)
            IfCondition EqualTo(hold, reg) ThenBlock: {
                X86_MovRbpOffsetGpr(off, reg)
                CompileFunc_HoldSet(slot, -1)
            }
            slot = Add(slot, 1)
        }
        ReturnValue(0)
    }
}

// A scratch write of this register is about to kill whatever name was
// homed there. Spill that name first. The stack was not written at the
// assignment. want/eligible are read directly so this stays a couple
// of compares on the gate-off path.
Function.Optimize_ScanClobberReg {
    Input: reg: Integer
    Body: {
        IfCondition NotEqual(ScanState.want, 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(ScanState.eligible, 0) ThenBlock: { ReturnValue(0) }
        Optimize_ScanBreakHold(reg)
        i = 1
        WhileLoop LessThan(i, Add(TagState.nnames, 1)) {
            IfCondition EqualTo(Optimize_ScanReg(i), reg) ThenBlock: {
                IfCondition NotEqual(i, ScanState.keep) ThenBlock: {
                    IfCondition EqualTo(Optimize_ScanMatGet(i), 1) ThenBlock: {
                    // A name whose last mention already happened is dead.
                    // Spilling it writes a store the next column never reads.
                    // Unmaterialized names still live in the frame.
                    dead = 0
                    IfCondition GreaterThan(ScanState.keep, 0) ThenBlock: {
                        kend = Optimize_LiveMaxPos(i)
                        kstart = Optimize_LiveMinPos(ScanState.keep)
                        IfCondition GreaterEqual(kend, 0) ThenBlock: {
                            IfCondition GreaterEqual(kstart, 0) ThenBlock: {
                                IfCondition LessThan(kend, kstart) ThenBlock: { dead = 1 }
                            }
                        }
                    }
                    IfCondition EqualTo(dead, 0) ThenBlock: {
                        Optimize_ScanSpillId(i)
                    }
                    // The scratch bytes are emitted after this returns.
                    // VerifyCover closes the window after those bytes, so the
                    // write stays inside the live range. Ending here hides it.
                    SetByte(ScanState.mat, Subtract(i, 1), 0)
                    // rbx is the compare/GetByte shuttle. After a smash,
                    // ScanHold must not skip the frame store or a rotated
                    // while rereads the old slot (sieve/memcopy hang).
                    IfCondition EqualTo(reg, Reg.RBX) ThenBlock: {
                        ScanState.loop_mask = BitwiseOr(ScanState.loop_mask, 1)
                    }
                    }
                }
            }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

Function.Optimize_ScanStarts {
    Input: text: Address
    Input: pre: Address
    Output: Integer
    Body: {
        n = StringLength(pre)
        IfCondition LessThan(StringLength(text), n) ThenBlock: { ReturnValue(0) }
        i = 0
        WhileLoop LessThan(i, n) {
            IfCondition NotEqual(GetByte(text, i), GetByte(pre, i)) ThenBlock: { ReturnValue(0) }
            i = Add(i, 1)
        }
        ReturnValue(1)
    }
}

// Called from X86Enc_Assemble, before the bytes. A writer mnemonic
// whose first operand is a GPR spills that home. Longer names are
// matched first. MUL, DIV, and IDIV write rdx, not their operand.
// CALL and SYSCALL spill every materialized caller-saved home.

Function.Optimize_ScanStartsAt {
    Input: text: Address
    Input: at: Integer
    Input: pre: Address
    Output: Integer
    Body: {
        n = StringLength(pre)
        IfCondition LessThan(Subtract(StringLength(text), at), n) ThenBlock: { ReturnValue(0) }
        i = 0
        WhileLoop LessThan(i, n) {
            IfCondition NotEqual(GetByte(text, Add(at, i)), GetByte(pre, i)) ThenBlock: { ReturnValue(0) }
            i = Add(i, 1)
        }
        ReturnValue(1)
    }
}

Function.Optimize_ScanRegEnd {
    Input: text: Address
    Input: at: Integer
    Output: Integer
    Body: {
        IfCondition GreaterEqual(at, StringLength(text)) ThenBlock: { ReturnValue(1) }
        c = GetByte(text, at)
        IfCondition GreaterEqual(c, 48) ThenBlock: {
            IfCondition LessEqual(c, 57) ThenBlock: { ReturnValue(0) }
        }
        IfCondition GreaterEqual(c, 65) ThenBlock: {
            IfCondition LessEqual(c, 90) ThenBlock: { ReturnValue(0) }
        }
        IfCondition GreaterEqual(c, 97) ThenBlock: {
            IfCondition LessEqual(c, 122) ThenBlock: { ReturnValue(0) }
        }
        ReturnValue(1)
    }
}

Function.Optimize_ScanWordIs {
    Input: text: Address
    Input: at: Integer
    Input: pre: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(Optimize_ScanStartsAt(text, at, pre), 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(Optimize_ScanRegEnd(text, Add(at, StringLength(pre))))
    }
}

Function.Optimize_ScanRegWord {
    Input: text: Address
    Input: at: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(Optimize_ScanWordIs(text, at, "r10"), 1) ThenBlock: { ReturnValue(Reg.R10) }
        IfCondition EqualTo(Optimize_ScanWordIs(text, at, "r11"), 1) ThenBlock: { ReturnValue(Reg.R11) }
        IfCondition EqualTo(Optimize_ScanWordIs(text, at, "r12"), 1) ThenBlock: { ReturnValue(Reg.R12) }
        IfCondition EqualTo(Optimize_ScanWordIs(text, at, "r13"), 1) ThenBlock: { ReturnValue(Reg.R13) }
        IfCondition EqualTo(Optimize_ScanWordIs(text, at, "r14"), 1) ThenBlock: { ReturnValue(Reg.R14) }
        IfCondition EqualTo(Optimize_ScanWordIs(text, at, "r15"), 1) ThenBlock: { ReturnValue(Reg.R15) }
        IfCondition EqualTo(Optimize_ScanWordIs(text, at, "rbx"), 1) ThenBlock: { ReturnValue(Reg.RBX) }
        IfCondition EqualTo(Optimize_ScanWordIs(text, at, "rcx"), 1) ThenBlock: { ReturnValue(Reg.RCX) }
        IfCondition EqualTo(Optimize_ScanWordIs(text, at, "rdx"), 1) ThenBlock: { ReturnValue(Reg.RDX) }
        IfCondition EqualTo(Optimize_ScanWordIs(text, at, "rsi"), 1) ThenBlock: { ReturnValue(Reg.RSI) }
        IfCondition EqualTo(Optimize_ScanWordIs(text, at, "rdi"), 1) ThenBlock: { ReturnValue(Reg.RDI) }
        IfCondition EqualTo(Optimize_ScanWordIs(text, at, "rax"), 1) ThenBlock: { ReturnValue(Reg.RAX) }
        IfCondition EqualTo(Optimize_ScanWordIs(text, at, "r8"), 1) ThenBlock: { ReturnValue(Reg.R8) }
        IfCondition EqualTo(Optimize_ScanWordIs(text, at, "r9"), 1) ThenBlock: { ReturnValue(Reg.R9) }
        ReturnValue(-1)
    }
}

Function.Optimize_ScanNoteHit {
    Input: asm_str: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(Optimize_ScanStarts(asm_str, "CALL"), 1) ThenBlock: {
            Optimize_ScanSpillCallers()
            ReturnValue(-1)
        }
        IfCondition EqualTo(Optimize_ScanStarts(asm_str, "SYSCALL"), 1) ThenBlock: {
            Optimize_ScanSpillCallers()
            ReturnValue(-1)
        }
        IfCondition EqualTo(Optimize_ScanStarts(asm_str, "CQO"), 1) ThenBlock: { ReturnValue(Reg.RDX) }
        IfCondition EqualTo(Optimize_ScanStarts(asm_str, "IDIV "), 1) ThenBlock: { ReturnValue(Reg.RDX) }
        IfCondition EqualTo(Optimize_ScanStarts(asm_str, "DIV "), 1) ThenBlock: { ReturnValue(Reg.RDX) }
        IfCondition EqualTo(Optimize_ScanStarts(asm_str, "MUL "), 1) ThenBlock: { ReturnValue(Reg.RDX) }
        n = StringLength(asm_str)
        op_at = -1
        i = 0
        WhileLoop LessThan(i, n) {
            IfCondition EqualTo(op_at, -1) ThenBlock: {
                IfCondition EqualTo(GetByte(asm_str, i), 32) ThenBlock: { op_at = Add(i, 1) }
            }
            i = Add(i, 1)
        }
        IfCondition LessThan(op_at, 0) ThenBlock: { ReturnValue(-1) }
        writer = 0
        IfCondition EqualTo(Optimize_ScanStarts(asm_str, "MOV "), 1) ThenBlock: { writer = 1 }
        IfCondition EqualTo(Optimize_ScanStarts(asm_str, "POP "), 1) ThenBlock: { writer = 1 }
        IfCondition EqualTo(Optimize_ScanStarts(asm_str, "ADD "), 1) ThenBlock: { writer = 1 }
        IfCondition EqualTo(Optimize_ScanStarts(asm_str, "SUB "), 1) ThenBlock: { writer = 1 }
        IfCondition EqualTo(Optimize_ScanStarts(asm_str, "XOR "), 1) ThenBlock: { writer = 1 }
        IfCondition EqualTo(Optimize_ScanStarts(asm_str, "AND "), 1) ThenBlock: { writer = 1 }
        IfCondition EqualTo(Optimize_ScanStarts(asm_str, "OR "), 1) ThenBlock: { writer = 1 }
        IfCondition EqualTo(Optimize_ScanStarts(asm_str, "INC "), 1) ThenBlock: { writer = 1 }
        IfCondition EqualTo(Optimize_ScanStarts(asm_str, "DEC "), 1) ThenBlock: { writer = 1 }
        IfCondition EqualTo(Optimize_ScanStarts(asm_str, "NEG "), 1) ThenBlock: { writer = 1 }
        IfCondition EqualTo(Optimize_ScanStarts(asm_str, "NOT "), 1) ThenBlock: { writer = 1 }
        IfCondition EqualTo(Optimize_ScanStarts(asm_str, "LEA "), 1) ThenBlock: { writer = 1 }
        IfCondition EqualTo(Optimize_ScanStarts(asm_str, "SHL "), 1) ThenBlock: { writer = 1 }
        IfCondition EqualTo(Optimize_ScanStarts(asm_str, "SHR "), 1) ThenBlock: { writer = 1 }
        IfCondition EqualTo(Optimize_ScanStarts(asm_str, "SAR "), 1) ThenBlock: { writer = 1 }
        IfCondition EqualTo(Optimize_ScanStarts(asm_str, "IMUL "), 1) ThenBlock: { writer = 1 }
        IfCondition EqualTo(writer, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition EqualTo(GetByte(asm_str, op_at), 91) ThenBlock: { ReturnValue(-1) }
        ReturnValue(Optimize_ScanRegWord(asm_str, op_at))
    }
}

// A parameter kept in rdi/rsi/rdx/rcx/r8/r9 is not in its frame slot.
// Publish it before an assembled write of that register. This runs
// with the scan off: CanHold still redirects the slot at the register,
// and a later call or mov would otherwise leave the slot empty.
Function.Optimize_ScanBreakAsm {
    Input: asm_str: Address
    Body: {
        IfCondition EqualTo(asm_str, 0) ThenBlock: { ReturnValue(0) }
        wide = 0
        IfCondition EqualTo(Optimize_ScanStarts(asm_str, "CALL"), 1) ThenBlock: { wide = 1 }
        IfCondition EqualTo(Optimize_ScanStarts(asm_str, "SYSCALL"), 1) ThenBlock: { wide = 1 }
        IfCondition EqualTo(wide, 1) ThenBlock: {
            Optimize_ScanBreakHold(Reg.RDI)
            Optimize_ScanBreakHold(Reg.RSI)
            Optimize_ScanBreakHold(Reg.RDX)
            Optimize_ScanBreakHold(Reg.RCX)
            Optimize_ScanBreakHold(Reg.R8)
            Optimize_ScanBreakHold(Reg.R9)
            ReturnValue(0)
        }
        hit = Optimize_ScanNoteHit(asm_str)
        IfCondition GreaterEqual(hit, 0) ThenBlock: {
            Optimize_ScanBreakHold(hit)
        }
        ReturnValue(0)
    }
}

// Register named by a PUSH/POP operand. rbp is not a value home, but
// it still occupies a stack slot, so the save model has to see it.
Function.Optimize_ScanSaveReg {
    Input: asm_str: Address
    Input: at: Integer
    Output: Integer
    Body: {
        reg = Optimize_ScanRegWord(asm_str, at)
        IfCondition NotEqual(reg, -1) ThenBlock: { ReturnValue(reg) }
        IfCondition EqualTo(Optimize_ScanWordIs(asm_str, at, "rbp"), 1) ThenBlock: {
            ReturnValue(Reg.RBP)
        }
        IfCondition EqualTo(Optimize_ScanWordIs(asm_str, at, "rsp"), 1) ThenBlock: {
            ReturnValue(Reg.RSP)
        }
        ReturnValue(-1)
    }
}

// Name currently materialized in reg, or 0. The push saves that value.
Function.Optimize_ScanMatReg {
    Input: reg: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(reg, 0) ThenBlock: { ReturnValue(0) }
        i = 1
        last = Add(TagState.nnames, 1)
        WhileLoop LessThan(i, last) {
            IfCondition EqualTo(Optimize_ScanReg(i), reg) ThenBlock: {
                IfCondition EqualTo(Optimize_ScanMatGet(i), 1) ThenBlock: {
                    ReturnValue(i)
                }
            }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

Function.Optimize_ScanSavePush {
    Input: reg: Integer
    Body: {
        IfCondition LessThan(ScanState.save_sp, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(ScanState.save_stk, 0) ThenBlock: {
            ScanState.save_stk = Allocate(2048)
        }
        IfCondition EqualTo(ScanState.save_stk, 0) ThenBlock: {
            ScanState.save_sp = -1
            ReturnValue(0)
        }
        IfCondition GreaterEqual(ScanState.save_sp, 256) ThenBlock: {
            ScanState.save_sp = -1
            ReturnValue(0)
        }
        id = Optimize_ScanMatReg(reg)
        word = Add(Multiply(id, 65536), Add(reg, 2))
        StoreValue(Add(ScanState.save_stk, Multiply(ScanState.save_sp, 8)), word)
        ScanState.save_sp = Add(ScanState.save_sp, 1)
        ReturnValue(0)
    }
}

// 1 when this POP restores the register saved by the matching PUSH.
// The home is in the register again. A value pop returns 0 so the
// caller spills it.
Function.Optimize_ScanSavePop {
    Input: reg: Integer
    Output: Integer
    Body: {
        IfCondition LessEqual(ScanState.save_sp, 0) ThenBlock: { ReturnValue(0) }
        ScanState.save_sp = Subtract(ScanState.save_sp, 1)
        word = Dereference(Add(ScanState.save_stk, Multiply(ScanState.save_sp, 8)))
        top_reg = Subtract(BitwiseAnd(word, 65535), 2)
        top_id = Divide(word, 65536)
        IfCondition NotEqual(top_reg, reg) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(top_id, 1) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(Optimize_ScanReg(top_id), reg) ThenBlock: { ReturnValue(0) }
        Optimize_ScanMatSet(top_id)
        ReturnValue(1)
    }
}

Function.Optimize_ScanNoteAsm {
    Input: asm_str: Address
    Body: {
        Optimize_ScanBreakAsm(asm_str)
        IfCondition NotEqual(ScanState.want, 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(ScanState.eligible, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(asm_str, 0) ThenBlock: { ReturnValue(0) }
        // PUSH does not change the register. Remember it so the
        // matching POP is not treated as a kill of the home. The
        // pop of err*2's save was clearing y, and the next
        // Subtract(0, dy) then wrote rbx.
        IfCondition EqualTo(Optimize_ScanStarts(asm_str, "PUSH "), 1) ThenBlock: {
            Optimize_ScanSavePush(Optimize_ScanSaveReg(asm_str, 5))
            ReturnValue(0)
        }
        IfCondition EqualTo(Optimize_ScanStarts(asm_str, "POP "), 1) ThenBlock: {
            kept = Optimize_ScanSavePop(Optimize_ScanSaveReg(asm_str, 4))
            IfCondition EqualTo(kept, 1) ThenBlock: { ReturnValue(0) }
        }
        hit = Optimize_ScanNoteHit(asm_str)
        IfCondition NotEqual(hit, -1) ThenBlock: { Optimize_ScanClobberReg(hit) }
        ReturnValue(0)
    }
}

// =============================================================================
// BRANCH MERGE-POINT RECONCILIATION (If/Fork/Switch)
//
// A name assigned in only one arm of an If would look "materialized"
// after the merge from the compiler's sequential walk order alone,
// even though the register is genuinely undefined at runtime whenever
// the OTHER arm was the one actually taken - the compiler visits both
// arms' source during compilation regardless of which one executes.
// CompileStmt_If/Fork/Switch (Library.CCompileStmt.ailang) snapshot the
// materialized-flags array before each arm, then AND the arms'
// resulting states back together at the merge point: a name is only
// trusted materialized after the merge if every arm left it that way.
// Conservative, not maximally precise (an irrelevant arm - e.g. one
// that always returns early - still gets ANDed in, which can only
// clear bits, never wrongly set one, so it costs a missed caching
// opportunity, not correctness), but it means no per-branch dataflow
// bookkeeping is needed to stay sound.
// =============================================================================

Function.Optimize_ScanMatSnapshot {
    Output: Address
    Body: {
        IfCondition EqualTo(Optimize_ScanActive(), 0) ThenBlock: { ReturnValue(0) }
        snap = Allocate(128)
        IfCondition EqualTo(snap, 0) ThenBlock: { ReturnValue(0) }
        i = 0
        WhileLoop LessThan(i, 128) {
            SetByte(snap, i, GetByte(ScanState.mat, i))
            i = Add(i, 1)
        }
        ReturnValue(snap)
    }
}

Function.Optimize_ScanMatRestore {
    Input: snap: Address
    Body: {
        IfCondition EqualTo(snap, 0) ThenBlock: { ReturnValue(0) }
        i = 0
        WhileLoop LessThan(i, 128) {
            nb = GetByte(snap, i)
            IfCondition EqualTo(GetByte(ScanState.mat, i), 1) ThenBlock: {
                IfCondition EqualTo(nb, 0) ThenBlock: {
                    Optimize_VerifyEnd(Add(i, 1))
                }
            }
            SetByte(ScanState.mat, i, nb)
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

// mat := mat AND snap, byte-wise (flags are 0/1, so this is exactly
// logical AND per name).
Function.Optimize_ScanMatMergeAnd {
    Input: snap: Address
    Body: {
        IfCondition EqualTo(snap, 0) ThenBlock: { ReturnValue(0) }
        i = 0
        WhileLoop LessThan(i, 128) {
            ob = GetByte(ScanState.mat, i)
            nb = BitwiseAnd(ob, GetByte(snap, i))
            IfCondition EqualTo(ob, 1) ThenBlock: {
                IfCondition EqualTo(nb, 0) ThenBlock: {
                    Optimize_VerifyEnd(Add(i, 1))
                }
            }
            SetByte(ScanState.mat, i, nb)
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

Function.Optimize_ScanMatFree {
    Input: snap: Address
    Body: {
        IfCondition NotEqual(snap, 0) ThenBlock: { Deallocate(snap, 128) }
        ReturnValue(0)
    }
}

// 1 when this call is compiled inline and does not kill r11.
Function.Optimize_ScanPtrPure {
    Input: nm: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(nm, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(StringCompare(nm, "Add"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(nm, "Subtract"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(nm, "Multiply"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(nm, "Divide"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(nm, "Modulo"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(nm, "Negate"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(nm, "Float_Add"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(nm, "Float_Sub"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(nm, "Float_Mul"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(nm, "Float_Div"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(nm, "Float_Sqrt"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(nm, "Float_Neg"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(nm, "Float_Abs"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(nm, "Float_Lt"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(nm, "Float_Gt"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(nm, "Float_Le"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(nm, "Float_Ge"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(nm, "Float_Eq"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(nm, "Float_Ne"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(nm, "Float_FromInt"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(nm, "Dereference"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(nm, "StoreValue"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(nm, "LessThan"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(nm, "GreaterThan"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(nm, "LessEqual"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(nm, "GreaterEqual"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(nm, "EqualTo"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(nm, "NotEqual"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(nm, "And"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(nm, "Or"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(nm, "Not"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(nm, "BitwiseAnd"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(nm, "BitwiseOr"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(nm, "BitwiseXor"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(nm, "BitwiseNot"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(nm, "LeftShift"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(nm, "RightShift"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(nm, "ShiftLeft"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(nm, "ShiftRight"), 0) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

// Register holding this hoisted pointer, or 0.
Function.Optimize_ScanPtrReg {
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterThan(ScanPtr.n, 0) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(name, ScanPtr.name0), 1) ThenBlock: {
                ReturnValue(ScanPtr.reg0)
            }
        }
        IfCondition GreaterThan(ScanPtr.n, 1) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(name, ScanPtr.name1), 1) ThenBlock: {
                ReturnValue(ScanPtr.reg1)
            }
        }
        ReturnValue(0)
    }
}

// 1 when addr is this pointer or pointer+constant. Fills hit_reg/hit_disp.
Function.Optimize_ScanPtrAddr {
    Input: addr: Address
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(addr, 0) ThenBlock: { ReturnValue(0) }
        reg = Optimize_ScanPtrReg(name)
        IfCondition EqualTo(reg, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(AST_GetType(addr), AST.IDENTIFIER) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(AST_GetData1(addr), name), 1) ThenBlock: {
                ScanPtr.hit_reg = reg
                ScanPtr.hit_disp = 0
                ReturnValue(1)
            }
            ReturnValue(0)
        }
        IfCondition NotEqual(AST_GetType(addr), AST.CALL) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(StringCompare(AST_GetData1(addr), "Add"), 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetChildCount(addr), 2) ThenBlock: { ReturnValue(0) }
        c0 = AST_GetChild(addr, 0)
        c1 = AST_GetChild(addr, 1)
        disp_node = 0
        base_node = 0
        IfCondition NotEqual(c1, 0) ThenBlock: {
            IfCondition EqualTo(AST_GetType(c1), AST.NUMBER) ThenBlock: {
                disp_node = c1
                base_node = c0
            }
        }
        IfCondition EqualTo(disp_node, 0) ThenBlock: {
            IfCondition NotEqual(c0, 0) ThenBlock: {
                IfCondition EqualTo(AST_GetType(c0), AST.NUMBER) ThenBlock: {
                    disp_node = c0
                    base_node = c1
                }
            }
        }
        IfCondition EqualTo(disp_node, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(base_node, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(base_node), AST.IDENTIFIER) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_NameEq(AST_GetData1(base_node), name), 0) ThenBlock: { ReturnValue(0) }
        disp = StringToNumber(AST_GetData1(disp_node))
        IfCondition EqualTo(Optimize_Fit32(disp), 0) ThenBlock: { ReturnValue(0) }
        ScanPtr.hit_reg = reg
        ScanPtr.hit_disp = disp
        ReturnValue(1)
    }
}

// 1 when this address expression is one of the hoisted pointers.
Function.Optimize_ScanPtrHit {
    Input: addr: Address
    Output: Integer
    Body: {
        IfCondition GreaterThan(ScanPtr.n, 0) ThenBlock: {
            IfCondition EqualTo(Optimize_ScanPtrAddr(addr, ScanPtr.name0), 1) ThenBlock: { ReturnValue(1) }
        }
        IfCondition GreaterThan(ScanPtr.n, 1) ThenBlock: {
            IfCondition EqualTo(Optimize_ScanPtrAddr(addr, ScanPtr.name1), 1) ThenBlock: { ReturnValue(1) }
        }
        IfCondition EqualTo(ScanPtr.walk_lo, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_ScanPtrShape(addr), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_NameEq(AST_GetData1(ScanPtr.sbase), AST_GetData1(ScanPtr.base0)), 0) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition NotEqual(ScanPtr.sstride, ScanPtr.stride0) ThenBlock: { ReturnValue(0) }
        iname = AST_GetData1(ScanPtr.siv)
        IfCondition EqualTo(Optimize_NameEq(iname, ScanPtr.walk_lo), 1) ThenBlock: {
            ScanPtr.hit_reg = ScanPtr.reg0
            ScanPtr.hit_disp = 0
            ReturnValue(1)
        }
        IfCondition GreaterThan(ScanPtr.n, 1) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(iname, ScanPtr.walk_hi), 1) ThenBlock: {
                ScanPtr.hit_reg = ScanPtr.reg1
                ScanPtr.hit_disp = 0
                ReturnValue(1)
            }
        }
        ReturnValue(0)
    }
}

// A spilled name defined by a field load is read back from the hoisted
// pointer. 32 records of name, reg, disp, stale. stale is 1 when the
// frame slot was not written. Cleared when that name is assigned, and
// when the pointer register is stepped or reused.
Function.Optimize_ScanPtrRmBuf {
    Output: Address
    Body: {
        IfCondition EqualTo(ScanPtr.rm, 0) ThenBlock: {
            ScanPtr.rm = Allocate(1024)
        }
        ReturnValue(ScanPtr.rm)
    }
}

Function.Optimize_ScanPtrRmFind {
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(ScanPtr.rm, 0) ThenBlock: { ReturnValue(0) }
        i = 0
        WhileLoop LessThan(i, ScanPtr.rm_n) {
            rec = Add(ScanPtr.rm, Multiply(i, 32))
            IfCondition EqualTo(Optimize_NameEq(Dereference(rec), name), 1) ThenBlock: {
                reg = Dereference(Add(rec, 8))
                IfCondition NotEqual(reg, 0) ThenBlock: {
                    ScanPtr.hit_reg = reg
                    ScanPtr.hit_disp = Dereference(Add(rec, 16))
                    ReturnValue(1)
                }
            }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

Function.Optimize_ScanPtrRmClear {
    Input: name: Address
    Body: {
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(ScanPtr.rm, 0) ThenBlock: { ReturnValue(0) }
        i = 0
        WhileLoop LessThan(i, ScanPtr.rm_n) {
            rec = Add(ScanPtr.rm, Multiply(i, 32))
            IfCondition EqualTo(Optimize_NameEq(Dereference(rec), name), 1) ThenBlock: {
                StoreValue(Add(rec, 8), 0)
                StoreValue(Add(rec, 24), 0)
            }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

// The pointer register is about to change. A stale field is written
// to its frame only when a later statement still reads the name.
Function.Optimize_ScanRmFlush {
    Input: rec: Address
    Body: {
        name = Dereference(rec)
        preg = Dereference(Add(rec, 8))
        disp = Dereference(Add(rec, 16))
        spill = 1
        pos = ScanPtr.at_pos
        IfCondition GreaterEqual(pos, 0) ThenBlock: {
            id = Optimize_ScanFind(name)
            IfCondition GreaterThan(id, 0) ThenBlock: {
                mx = Optimize_LiveMaxPos(id)
                IfCondition GreaterEqual(mx, 0) ThenBlock: {
                    IfCondition LessEqual(mx, pos) ThenBlock: { spill = 0 }
                }
            }
        }
        IfCondition EqualTo(spill, 0) ThenBlock: { ReturnValue(0) }
        off = Scope_Resolve(name)
        IfCondition EqualTo(Scope.resolve_type, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Scope.resolve_type, 3) ThenBlock: { ReturnValue(0) }
        X86_MovRaxIp(preg, disp)
        Emit_MovRbpOffsetRax(off)
        ReturnValue(0)
    }
}

// 1 when this pointer is live for the whole loop and is not stepped.
Function.Optimize_ScanPtrHeld {
    Input: reg: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(reg, 0) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterThan(ScanPtr.n, 0) ThenBlock: {
            IfCondition EqualTo(reg, ScanPtr.reg0) ThenBlock: {
                IfCondition EqualTo(ScanPtr.bump0, 0) ThenBlock: { ReturnValue(1) }
            }
        }
        IfCondition GreaterThan(ScanPtr.n, 1) ThenBlock: {
            IfCondition EqualTo(reg, ScanPtr.reg1) ThenBlock: {
                IfCondition EqualTo(ScanPtr.bump1, 0) ThenBlock: { ReturnValue(1) }
            }
        }
        ReturnValue(0)
    }
}

// Write scan-homed fields back to the hoisted pointer. Used at loop
// exit so i-velocity is not stored every inner trip.
Function.Optimize_ScanFltFlush {
    Body: {
        IfCondition EqualTo(Optimize_ScanActive(), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(ScanPtr.rm, 0) ThenBlock: { ReturnValue(0) }
        i = 0
        WhileLoop LessThan(i, ScanPtr.rm_n) {
            rec = Add(ScanPtr.rm, Multiply(i, 32))
            preg = Dereference(Add(rec, 8))
            IfCondition NotEqual(preg, 0) ThenBlock: {
                IfCondition EqualTo(Optimize_ScanPtrHeld(preg), 1) ThenBlock: {
                    name = Dereference(rec)
                    id = Optimize_ScanFind(name)
                    IfCondition GreaterThan(id, 0) ThenBlock: {
                        IfCondition EqualTo(Optimize_ScanMatGet(id), 1) ThenBlock: {
                            xs = Optimize_ScanXmm(Optimize_ScanReg(id))
                            IfCondition GreaterEqual(xs, 2) ThenBlock: {
                                X86_MovsdIpXmm(preg, Dereference(Add(rec, 16)), xs)
                            }
                        }
                    }
                }
            }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

Function.Optimize_ScanPtrRmKill {
    Input: reg: Integer
    Body: {
        IfCondition EqualTo(ScanPtr.rm, 0) ThenBlock: { ReturnValue(0) }
        i = 0
        WhileLoop LessThan(i, ScanPtr.rm_n) {
            rec = Add(ScanPtr.rm, Multiply(i, 32))
            IfCondition EqualTo(Dereference(Add(rec, 8)), reg) ThenBlock: {
                IfCondition EqualTo(Dereference(Add(rec, 24)), 1) ThenBlock: {
                    Optimize_ScanRmFlush(rec)
                }
                StoreValue(Add(rec, 8), 0)
                StoreValue(Add(rec, 24), 0)
            }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

Function.Optimize_ScanPtrRmSet {
    Input: name: Address
    Input: reg: Integer
    Input: disp: Integer
    Input: stale: Integer
    Body: {
        buf = Optimize_ScanPtrRmBuf()
        IfCondition EqualTo(buf, 0) ThenBlock: { ReturnValue(0) }
        i = 0
        WhileLoop LessThan(i, ScanPtr.rm_n) {
            rec = Add(buf, Multiply(i, 32))
            IfCondition EqualTo(Optimize_NameEq(Dereference(rec), name), 1) ThenBlock: {
                StoreValue(Add(rec, 8), reg)
                StoreValue(Add(rec, 16), disp)
                StoreValue(Add(rec, 24), stale)
                ReturnValue(1)
            }
            i = Add(i, 1)
        }
        IfCondition GreaterEqual(ScanPtr.rm_n, 32) ThenBlock: { ReturnValue(0) }
        rec = Add(buf, Multiply(ScanPtr.rm_n, 32))
        StoreValue(rec, name)
        StoreValue(Add(rec, 8), reg)
        StoreValue(Add(rec, 16), disp)
        StoreValue(Add(rec, 24), stale)
        ScanPtr.rm_n = Add(ScanPtr.rm_n, 1)
        ReturnValue(1)
    }
}

// name = name ± other, and the scan spilled name. The field the load
// noted is the memory home. xmm0 is scratch. other must already be
// in a real xmm, so the update does not bounce through rax.
// 1 when this identifier's last mention is the current statement.
Function.Optimize_ScanFltLast {
    Input: node: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(node), AST.IDENTIFIER) ThenBlock: { ReturnValue(0) }
        id = Optimize_TagIntern(AST_GetData1(node))
        IfCondition EqualTo(id, 0) ThenBlock: { ReturnValue(0) }
        kend = Optimize_LiveMaxPos(id)
        at = ScanPtr.at_pos
        IfCondition LessThan(kend, 0) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(at, 0) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterThan(kend, at) ThenBlock: { ReturnValue(0) }
        ReturnValue(1)
    }
}

Function.Optimize_ScanFltMem {
    Input: target: Address
    Input: value: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(Optimize_ScanActive(), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(target, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(value, 0) ThenBlock: { ReturnValue(0) }
        tid = Optimize_ScanFind(target)
        IfCondition GreaterThan(tid, 0) ThenBlock: {
            IfCondition EqualTo(Optimize_ScanMatGet(tid), 1) ThenBlock: {
                IfCondition GreaterEqual(Optimize_ScanXmm(Optimize_ScanReg(tid)), 2) ThenBlock: {
                    ReturnValue(0)
                }
            }
        }
        IfCondition NotEqual(AST_GetType(value), AST.CALL) ThenBlock: { ReturnValue(0) }
        op = AST_GetData1(value)
        is_add = 0
        is_sub = 0
        IfCondition EqualTo(StringCompare(op, "Float_Add"), 0) ThenBlock: { is_add = 1 }
        IfCondition EqualTo(StringCompare(op, "Float_Sub"), 0) ThenBlock: { is_sub = 1 }
        IfCondition EqualTo(is_add, 0) ThenBlock: {
            IfCondition EqualTo(is_sub, 0) ThenBlock: { ReturnValue(0) }
        }
        IfCondition NotEqual(AST_GetChildCount(value), 2) ThenBlock: { ReturnValue(0) }
        s0 = AST_GetChild(value, 0)
        s1 = AST_GetChild(value, 1)
        left = 0
        other = 0
        IfCondition NotEqual(s0, 0) ThenBlock: {
            IfCondition EqualTo(AST_GetType(s0), AST.IDENTIFIER) ThenBlock: {
                IfCondition EqualTo(Optimize_NameEq(AST_GetData1(s0), target), 1) ThenBlock: {
                    left = 1
                    other = s1
                }
            }
        }
        IfCondition EqualTo(left, 0) ThenBlock: {
            IfCondition NotEqual(s1, 0) ThenBlock: {
                IfCondition EqualTo(AST_GetType(s1), AST.IDENTIFIER) ThenBlock: {
                    IfCondition EqualTo(Optimize_NameEq(AST_GetData1(s1), target), 1) ThenBlock: {
                        other = s0
                    }
                }
            }
        }
        IfCondition EqualTo(other, 0) ThenBlock: { ReturnValue(0) }
        ss = Optimize_ScanFltSrc(other)
        IfCondition LessThan(ss, 2) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_ScanPtrRmFind(target), 0) ThenBlock: { ReturnValue(0) }
        reg = ScanPtr.hit_reg
        disp = ScanPtr.hit_disp
        ok = 0
        IfCondition EqualTo(reg, 11) ThenBlock: { ok = 1 }
        IfCondition EqualTo(reg, 14) ThenBlock: { ok = 1 }
        IfCondition EqualTo(ok, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(is_add, 1) ThenBlock: {
            last = Optimize_ScanFltLast(other)
            IfCondition EqualTo(last, 1) ThenBlock: {
                // SSE2: addsd delta, [field]; store delta. The delta dies.
                X86_XmmPtr(88, ss, reg, disp)
                X86_MovsdIpXmm(reg, disp, ss)
                ReturnValue(1)
            }
            IfCondition EqualTo(Hw.avx, 1) ThenBlock: {
                X86_VexSdPtr(88, 0, ss, reg, disp)
                X86_MovsdIpXmm(reg, disp, 0)
                ReturnValue(1)
            }
        }
        X86_MovsdPtr(0, reg, disp)
        IfCondition EqualTo(is_add, 1) ThenBlock: {
            X86_XmmBin(88, 0, ss)
        }
        IfCondition EqualTo(is_sub, 1) ThenBlock: {
            IfCondition EqualTo(left, 1) ThenBlock: {
                X86_XmmBin(92, 0, ss)
            } ElseBlock: {
                X86_XmmBin(16, 1, 0)
                X86_XmmBin(16, 0, ss)
                X86_XmmBin(92, 0, 1)
            }
        }
        X86_MovsdIpXmm(reg, disp, 0)
        ReturnValue(1)
    }
}

// Hardware xmm of a loop-local parked field, or -1. park0 is xmm3.
Function.Optimize_ScanFltPark {
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition NotEqual(ScanPtr.park0, 0) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(name, ScanPtr.park0), 1) ThenBlock: { ReturnValue(3) }
        }
        IfCondition NotEqual(ScanPtr.park1, 0) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(name, ScanPtr.park1), 1) ThenBlock: { ReturnValue(ScanPtr.park1_reg) }
        }
        IfCondition NotEqual(ScanPtr.park2, 0) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(name, ScanPtr.park2), 1) ThenBlock: { ReturnValue(ScanPtr.park2_reg) }
        }
        ReturnValue(-1)
    }
}

// 1 when a Float_* result in this tree has no pool xmm and will
// compile through xmm0/xmm1. Parking iy there then dies.
Function.Optimize_ScanFltUsesScratch {
    Input: node: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(AST_GetType(node), AST.WHILE) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(AST_GetType(node), AST.FOR_EVERY) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(AST_GetType(node), AST.ASSIGNMENT) ThenBlock: {
            val = AST_GetChild(node, 0)
            IfCondition NotEqual(val, 0) ThenBlock: {
                IfCondition EqualTo(AST_GetType(val), AST.CALL) ThenBlock: {
                    vn = AST_GetData1(val)
                    muldiv = 0
                    IfCondition EqualTo(StringCompare(vn, "Float_Mul"), 0) ThenBlock: { muldiv = 1 }
                    IfCondition EqualTo(StringCompare(vn, "Float_Div"), 0) ThenBlock: { muldiv = 1 }
                    IfCondition EqualTo(muldiv, 1) ThenBlock: {
                        id = Optimize_ScanFind(AST_GetData1(node))
                        homed = 0
                        IfCondition NotEqual(id, 0) ThenBlock: {
                            IfCondition GreaterEqual(Optimize_ScanReg(id), 36) ThenBlock: { homed = 1 }
                        }
                        IfCondition EqualTo(homed, 0) ThenBlock: { ReturnValue(1) }
                        ReturnValue(0)
                    }
                }
            }
        }
        IfCondition EqualTo(AST_GetType(node), AST.CALL) ThenBlock: {
            vn = AST_GetData1(node)
            IfCondition EqualTo(StringCompare(vn, "Float_Mul"), 0) ThenBlock: { ReturnValue(1) }
            IfCondition EqualTo(StringCompare(vn, "Float_Div"), 0) ThenBlock: { ReturnValue(1) }
        }
        n = AST_GetChildCount(node)
        i = 0
        WhileLoop LessThan(i, n) {
            IfCondition EqualTo(Optimize_ScanFltUsesScratch(AST_GetChild(node, i)), 1) ThenBlock: {
                ReturnValue(1)
            }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

// Take an empty park for this name. xmm3 first: the float slow path
// writes xmm0/xmm1/xmm15, not xmm3. xmm0/xmm1 only when this body
// does not compile Float_* through that scratch (n-body AVX homes).
Function.Optimize_ScanFltParkTake {
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(-1) }
        hit = Optimize_ScanFltPark(name)
        IfCondition GreaterEqual(hit, 0) ThenBlock: { ReturnValue(hit) }
        IfCondition EqualTo(ScanPtr.park0, 0) ThenBlock: {
            ScanPtr.park0 = name
            ReturnValue(3)
        }
        IfCondition NotEqual(ScanPtr.loop_body, 0) ThenBlock: {
            IfCondition EqualTo(Optimize_ScanFltUsesScratch(ScanPtr.loop_body), 1) ThenBlock: {
                ReturnValue(-1)
            }
        }
        IfCondition EqualTo(ScanPtr.park1, 0) ThenBlock: {
            ScanPtr.park1 = name
            ScanPtr.park1_reg = 0
            ReturnValue(0)
        }
        IfCondition EqualTo(ScanPtr.park2, 0) ThenBlock: {
            ScanPtr.park2 = name
            ScanPtr.park2_reg = 1
            ReturnValue(1)
        }
        ReturnValue(-1)
    }
}

Function.Optimize_ScanFltParkClear {
    Body: {
        ScanPtr.park0 = 0
        ScanPtr.park1 = 0
        ScanPtr.park2 = 0
        ScanPtr.park1_reg = -1
        ScanPtr.park2_reg = -1
        ReturnValue(0)
    }
}

// 1 when this loop body assigns name to something other than a
// Dereference. Parking that name would skip the load and leave the
// later store reading a stale frame slot.
Function.Optimize_ScanFltParkWritten {
    Input: node: Address
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(AST_GetType(node), AST.WHILE) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(AST_GetType(node), AST.FOR_EVERY) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(AST_GetType(node), AST.ASSIGNMENT) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(AST_GetData1(node), name), 1) ThenBlock: {
                val = AST_GetChild(node, 0)
                is_der = 0
                IfCondition NotEqual(val, 0) ThenBlock: {
                    IfCondition EqualTo(AST_GetType(val), AST.CALL) ThenBlock: {
                        IfCondition EqualTo(StringCompare(AST_GetData1(val), "Dereference"), 0) ThenBlock: { is_der = 1 }
                    }
                }
                IfCondition EqualTo(is_der, 0) ThenBlock: { ReturnValue(1) }
            }
        }
        n = AST_GetChildCount(node)
        i = 0
        WhileLoop LessThan(i, n) {
            IfCondition EqualTo(Optimize_ScanFltParkWritten(AST_GetChild(node, i), name), 1) ThenBlock: { ReturnValue(1) }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

// Reload a parked field from the hoisted pointer after an inner pop.
Function.Optimize_ScanFltParkReload {
    Input: name: Address
    Input: xmm: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_ScanPtrRmFind(name), 0) ThenBlock: { ReturnValue(0) }
        preg = ScanPtr.hit_reg
        ok = 0
        IfCondition EqualTo(preg, 11) ThenBlock: { ok = 1 }
        IfCondition EqualTo(preg, 14) ThenBlock: { ok = 1 }
        IfCondition EqualTo(ok, 0) ThenBlock: { ReturnValue(0) }
        X86_MovsdPtr(xmm, preg, ScanPtr.hit_disp)
        ReturnValue(1)
    }
}

// Load fields of a pointer this loop does not step. The body then
// skips those Dereference assignments. i-velocity stays in its xmm
// across j. ix parks in xmm3; iy/iz take leftover pool xmms.
Function.Optimize_ScanFltHoist {
    Input: node: Address
    Body: {
        Optimize_ScanFltHoistWalk(node, node)
        ReturnValue(0)
    }
}

Function.Optimize_ScanFltHoistWalk {
    Input: node: Address
    Input: body: Address
    Body: {
        IfCondition EqualTo(Optimize_ScanActive(), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(AST_GetType(node), AST.WHILE) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(AST_GetType(node), AST.FOR_EVERY) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(AST_GetType(node), AST.ASSIGNMENT) ThenBlock: {
            name = AST_GetData1(node)
            val = AST_GetChild(node, 0)
            IfCondition NotEqual(val, 0) ThenBlock: {
                IfCondition EqualTo(AST_GetType(val), AST.CALL) ThenBlock: {
                    IfCondition EqualTo(StringCompare(AST_GetData1(val), "Dereference"), 0) ThenBlock: {
                        IfCondition EqualTo(AST_GetChildCount(val), 1) ThenBlock: {
                            IfCondition EqualTo(Optimize_ScanPtrHit(AST_GetChild(val, 0)), 1) ThenBlock: {
                                preg = ScanPtr.hit_reg
                                pdisp = ScanPtr.hit_disp
                                stepped = 0
                                IfCondition EqualTo(preg, ScanPtr.reg0) ThenBlock: {
                                    IfCondition NotEqual(ScanPtr.bump0, 0) ThenBlock: { stepped = 1 }
                                }
                                IfCondition EqualTo(preg, ScanPtr.reg1) ThenBlock: {
                                    IfCondition NotEqual(ScanPtr.bump1, 0) ThenBlock: { stepped = 1 }
                                }
                                IfCondition EqualTo(stepped, 0) ThenBlock: {
                                    id = Optimize_ScanFind(name)
                                    slot = -1
                                    IfCondition GreaterThan(id, 0) ThenBlock: {
                                        slot = Optimize_ScanXmm(Optimize_ScanReg(id))
                                    }
                                    IfCondition GreaterEqual(slot, 2) ThenBlock: {
                                        X86_MovsdPtr(slot, preg, pdisp)
                                        Optimize_ScanPtrRmSet(name, preg, pdisp, 0)
                                        Optimize_ScanFltPublish(id, slot, name)
                                    }
                                    IfCondition LessThan(slot, 2) ThenBlock: {
                                        fb = 0
                                        IfCondition GreaterThan(id, 0) ThenBlock: {
                                            IfCondition NotEqual(ScanState.flt, 0) ThenBlock: {
                                                fb = GetByte(ScanState.flt, Subtract(id, 1))
                                            }
                                        }
                                        okp = 0
                                        IfCondition EqualTo(fb, 3) ThenBlock: { okp = 1 }
                                        IfCondition EqualTo(fb, 5) ThenBlock: { okp = 1 }
                                        IfCondition EqualTo(okp, 1) ThenBlock: {
                                            IfCondition EqualTo(Optimize_ScanFltParkWritten(body, name), 0) ThenBlock: {
                                                do_park = 1
                                                IfCondition NotEqual(NameState.nuse, 0) ThenBlock: {
                                                    cnt = Dereference(Add(NameState.nuse, Multiply(Subtract(id, 1), 8)))
                                                    IfCondition LessEqual(cnt, 1) ThenBlock: { do_park = 0 }
                                                }
                                                IfCondition EqualTo(do_park, 1) ThenBlock: {
                                                    px = Optimize_ScanFltParkTake(name)
                                                    IfCondition GreaterEqual(px, 0) ThenBlock: {
                                                        X86_MovsdPtr(px, preg, pdisp)
                                                        Optimize_ScanPtrRmSet(name, preg, pdisp, 0)
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        n = AST_GetChildCount(node)
        i = 0
        WhileLoop LessThan(i, n) {
            Optimize_ScanFltHoistWalk(AST_GetChild(node, i), body)
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

// 1 when name already lives in an xmm that was loaded from this
// same hoisted field. The inner j loop re-reads i-velocity every
// trip; the register still holds it.
Function.Optimize_ScanFltKeep {
    Input: name: Address
    Input: value: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(Optimize_ScanActive(), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(value, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(value), AST.CALL) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(StringCompare(AST_GetData1(value), "Dereference"), 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetChildCount(value), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_ScanPtrHit(AST_GetChild(value, 0)), 0) ThenBlock: { ReturnValue(0) }
        preg = ScanPtr.hit_reg
        pdisp = ScanPtr.hit_disp
        id = Optimize_ScanFind(name)
        IfCondition EqualTo(id, 0) ThenBlock: { ReturnValue(0) }
        held = 0
        IfCondition EqualTo(Optimize_ScanMatGet(id), 1) ThenBlock: {
            IfCondition GreaterEqual(Optimize_ScanXmm(Optimize_ScanReg(id)), 2) ThenBlock: { held = 1 }
        }
        IfCondition EqualTo(held, 0) ThenBlock: {
            IfCondition GreaterEqual(Optimize_ScanFltPark(name), 0) ThenBlock: { held = 1 }
        }
        IfCondition EqualTo(held, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_ScanPtrRmFind(name), 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(ScanPtr.hit_reg, preg) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(ScanPtr.hit_disp, pdisp) ThenBlock: { ReturnValue(0) }
        ReturnValue(1)
    }
}

// Remember name = Dereference(hoisted pointer [+ disp]). stale is 0
// when the frame was written, 1 when the frame is still empty.
Function.Optimize_ScanPtrRmNote {
    Input: name: Address
    Input: value: Address
    Body: {
        IfCondition EqualTo(Optimize_ScanActive(), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(value, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(value), AST.CALL) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(StringCompare(AST_GetData1(value), "Dereference"), 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetChildCount(value), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_ScanPtrHit(AST_GetChild(value, 0)), 0) ThenBlock: { ReturnValue(0) }
        Optimize_ScanPtrRmSet(name, ScanPtr.hit_reg, ScanPtr.hit_disp, 0)
        ReturnValue(0)
    }
}

// Make sure a later kill has a frame slot to fill. 1 when it does.
Function.Optimize_ScanFrameSlot {
    Input: name: Address
    Output: Integer
    Body: {
        off = Scope_Resolve(name)
        IfCondition EqualTo(Scope.resolve_type, 3) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Scope.resolve_type, 0) ThenBlock: {
            Compile.stack_offset = Add(Compile.stack_offset, 8)
            off = Subtract(0, Compile.stack_offset)
            Compile_RegisterLocal(name, off)
            Scope_Resolve(name)
        }
        IfCondition EqualTo(Scope.resolve_type, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Scope.resolve_type, 3) ThenBlock: { ReturnValue(0) }
        ReturnValue(1)
    }
}

// 1 when name = Dereference(hoisted pointer) needs no frame store.
// The pointer is the home. A kill writes the frame if the name is
// still live. A scan register is left on the normal store path.
Function.Optimize_ScanRmElide {
    Input: name: Address
    Input: value: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(Optimize_ScanActive(), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(value, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(value), AST.CALL) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(StringCompare(AST_GetData1(value), "Dereference"), 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetChildCount(value), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_ScanPtrHit(AST_GetChild(value, 0)), 0) ThenBlock: { ReturnValue(0) }
        id = Optimize_ScanFind(name)
        IfCondition GreaterThan(id, 0) ThenBlock: {
            IfCondition NotEqual(Optimize_ScanReg(id), -1) ThenBlock: { ReturnValue(0) }
        }
        reg = ScanPtr.hit_reg
        disp = ScanPtr.hit_disp
        IfCondition EqualTo(Optimize_ScanFrameSlot(name), 0) ThenBlock: { ReturnValue(0) }
        Optimize_ScanPtrRmSet(name, reg, disp, 1)
        ReturnValue(1)
    }
}

// 1 when addr is name or Add(name, constant). Does not require the hoist.
Function.Optimize_ScanPtrForm {
    Input: addr: Address
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(addr, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(AST_GetType(addr), AST.IDENTIFIER) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(AST_GetData1(addr), name), 1) ThenBlock: { ReturnValue(1) }
            ReturnValue(0)
        }
        IfCondition NotEqual(AST_GetType(addr), AST.CALL) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(StringCompare(AST_GetData1(addr), "Add"), 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetChildCount(addr), 2) ThenBlock: { ReturnValue(0) }
        c0 = AST_GetChild(addr, 0)
        c1 = AST_GetChild(addr, 1)
        IfCondition NotEqual(c1, 0) ThenBlock: {
            IfCondition EqualTo(AST_GetType(c1), AST.NUMBER) ThenBlock: {
                IfCondition NotEqual(c0, 0) ThenBlock: {
                    IfCondition EqualTo(AST_GetType(c0), AST.IDENTIFIER) ThenBlock: {
                        IfCondition EqualTo(Optimize_NameEq(AST_GetData1(c0), name), 1) ThenBlock: { ReturnValue(1) }
                    }
                }
            }
        }
        IfCondition NotEqual(c0, 0) ThenBlock: {
            IfCondition EqualTo(AST_GetType(c0), AST.NUMBER) ThenBlock: {
                IfCondition NotEqual(c1, 0) ThenBlock: {
                    IfCondition EqualTo(AST_GetType(c1), AST.IDENTIFIER) ThenBlock: {
                        IfCondition EqualTo(Optimize_NameEq(AST_GetData1(c1), name), 1) ThenBlock: { ReturnValue(1) }
                    }
                }
            }
        }
        ReturnValue(0)
    }
}

// 1 when a read of name is not a field address off the hoisted pointer.
Function.Optimize_ScanPtrBad {
    Input: node: Address
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        t = AST_GetType(node)
        IfCondition EqualTo(t, AST.IDENTIFIER) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(AST_GetData1(node), name), 1) ThenBlock: { ReturnValue(1) }
            ReturnValue(0)
        }
        IfCondition EqualTo(t, AST.ASSIGNMENT) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(AST_GetData1(node), name), 1) ThenBlock: {
                ReturnValue(Optimize_ScanPtrBad(AST_GetChild(node, 0), name))
            }
        }
        IfCondition EqualTo(t, AST.CALL) ThenBlock: {
            nm = AST_GetData1(node)
            IfCondition EqualTo(Optimize_ScanPtrPure(nm), 0) ThenBlock: { ScanPtr.calls = 1 }
            IfCondition EqualTo(StringCompare(nm, "Dereference"), 0) ThenBlock: {
                IfCondition GreaterThan(AST_GetChildCount(node), 0) ThenBlock: {
                    IfCondition EqualTo(Optimize_ScanPtrForm(AST_GetChild(node, 0), name), 1) ThenBlock: {
                        ReturnValue(0)
                    }
                }
            }
            IfCondition EqualTo(StringCompare(nm, "StoreValue"), 0) ThenBlock: {
                IfCondition GreaterThan(AST_GetChildCount(node), 1) ThenBlock: {
                    IfCondition EqualTo(Optimize_ScanPtrForm(AST_GetChild(node, 0), name), 1) ThenBlock: {
                        ReturnValue(Optimize_ScanPtrBad(AST_GetChild(node, 1), name))
                    }
                }
            }
        }
        n = AST_GetChildCount(node)
        i = 0
        WhileLoop LessThan(i, n) {
            IfCondition EqualTo(Optimize_ScanPtrBad(AST_GetChild(node, i), name), 1) ThenBlock: { ReturnValue(1) }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

// Scratch: mess=1 when iv is assigned by something other than iv+step.
// found=1 and step=the constant when there is one such add.
Function.Optimize_ScanPtrSeeStep {
    Input: node: Address
    Input: iv: Address
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(AST_GetType(node), AST.BLOCK) ThenBlock: {
            n = AST_GetChildCount(node)
            i = 0
            WhileLoop LessThan(i, n) {
                Optimize_ScanPtrSeeStep(AST_GetChild(node, i), iv)
                i = Add(i, 1)
            }
            ReturnValue(0)
        }
        IfCondition EqualTo(AST_GetType(node), AST.WHILE) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(AST_GetType(node), AST.FOR_EVERY) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_PlainAssign(node), 0) ThenBlock: {
            n = AST_GetChildCount(node)
            i = 0
            WhileLoop LessThan(i, n) {
                Optimize_ScanPtrSeeStep(AST_GetChild(node, i), iv)
                i = Add(i, 1)
            }
            ReturnValue(0)
        }
        IfCondition EqualTo(Optimize_NameEq(AST_GetData1(node), iv), 0) ThenBlock: { ReturnValue(0) }
        val = AST_GetChild(node, 0)
        got = 0
        IfCondition NotEqual(val, 0) ThenBlock: {
            IfCondition EqualTo(AST_GetType(val), AST.CALL) ThenBlock: {
                IfCondition EqualTo(StringCompare(AST_GetData1(val), "Add"), 0) ThenBlock: {
                    IfCondition EqualTo(AST_GetChildCount(val), 2) ThenBlock: {
                        a0 = AST_GetChild(val, 0)
                        a1 = AST_GetChild(val, 1)
                        num = 0
                        ident = 0
                        IfCondition NotEqual(a1, 0) ThenBlock: {
                            IfCondition EqualTo(AST_GetType(a1), AST.NUMBER) ThenBlock: {
                                num = a1
                                ident = a0
                            }
                        }
                        IfCondition EqualTo(num, 0) ThenBlock: {
                            IfCondition NotEqual(a0, 0) ThenBlock: {
                                IfCondition EqualTo(AST_GetType(a0), AST.NUMBER) ThenBlock: {
                                    num = a0
                                    ident = a1
                                }
                            }
                        }
                        IfCondition NotEqual(num, 0) ThenBlock: {
                            IfCondition NotEqual(ident, 0) ThenBlock: {
                                IfCondition EqualTo(AST_GetType(ident), AST.IDENTIFIER) ThenBlock: {
                                    IfCondition EqualTo(Optimize_NameEq(AST_GetData1(ident), iv), 1) ThenBlock: {
                                        st = StringToNumber(AST_GetData1(num))
                                        IfCondition EqualTo(ScanPtr.found, 0) ThenBlock: {
                                            ScanPtr.found = 1
                                            ScanPtr.step = st
                                        }
                                        IfCondition NotEqual(st, ScanPtr.step) ThenBlock: { ScanPtr.mess = 1 }
                                        got = 1
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        IfCondition EqualTo(got, 0) ThenBlock: { ScanPtr.mess = 1 }
        ReturnValue(0)
    }
}

// value is Add(base, Multiply(index, stride)) in either order.
// Fills base0/iv0/stride0 as scratch when slot is 0. Returns 1 on a match.
Function.Optimize_ScanPtrShape {
    Input: value: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(value, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(value), AST.CALL) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(StringCompare(AST_GetData1(value), "Add"), 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetChildCount(value), 2) ThenBlock: { ReturnValue(0) }
        a0 = AST_GetChild(value, 0)
        a1 = AST_GetChild(value, 1)
        mul = 0
        base = 0
        IfCondition NotEqual(a0, 0) ThenBlock: {
            IfCondition EqualTo(AST_GetType(a0), AST.CALL) ThenBlock: {
                IfCondition EqualTo(StringCompare(AST_GetData1(a0), "Multiply"), 0) ThenBlock: {
                    mul = a0
                    base = a1
                }
            }
        }
        IfCondition EqualTo(mul, 0) ThenBlock: {
            IfCondition NotEqual(a1, 0) ThenBlock: {
                IfCondition EqualTo(AST_GetType(a1), AST.CALL) ThenBlock: {
                    IfCondition EqualTo(StringCompare(AST_GetData1(a1), "Multiply"), 0) ThenBlock: {
                        mul = a1
                        base = a0
                    }
                }
            }
        }
        IfCondition EqualTo(mul, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(base, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(base), AST.IDENTIFIER) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetChildCount(mul), 2) ThenBlock: { ReturnValue(0) }
        m0 = AST_GetChild(mul, 0)
        m1 = AST_GetChild(mul, 1)
        num = 0
        ident = 0
        IfCondition NotEqual(m1, 0) ThenBlock: {
            IfCondition EqualTo(AST_GetType(m1), AST.NUMBER) ThenBlock: {
                num = m1
                ident = m0
            }
        }
        IfCondition EqualTo(num, 0) ThenBlock: {
            IfCondition NotEqual(m0, 0) ThenBlock: {
                IfCondition EqualTo(AST_GetType(m0), AST.NUMBER) ThenBlock: {
                    num = m0
                    ident = m1
                }
            }
        }
        IfCondition EqualTo(num, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(ident, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(ident), AST.IDENTIFIER) ThenBlock: { ReturnValue(0) }
        stride = StringToNumber(AST_GetData1(num))
        IfCondition LessThan(stride, 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_Fit32(stride), 0) ThenBlock: { ReturnValue(0) }
        ScanPtr.sbase = base
        ScanPtr.siv = ident
        ScanPtr.sstride = stride
        ReturnValue(1)
    }
}

Function.Optimize_ScanPtrTake {
    Input: name: Address
    Input: reg: Integer
    Body: {
        idx = ScanPtr.siv
        base = ScanPtr.sbase
        stride = ScanPtr.sstride
        step = 0
        bump = 0
        IfCondition EqualTo(ScanPtr.found, 1) ThenBlock: {
            step = ScanPtr.step
            bump = Multiply(stride, step)
        }
        IfCondition EqualTo(ScanPtr.n, 0) ThenBlock: {
            ScanPtr.name0 = name
            ScanPtr.iv0 = idx
            ScanPtr.base0 = base
            ScanPtr.stride0 = stride
            ScanPtr.bump0 = bump
            ScanPtr.step0 = step
            ScanPtr.reg0 = reg
            ScanPtr.n = 1
            ReturnValue(1)
        }
        IfCondition EqualTo(ScanPtr.n, 1) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(name, ScanPtr.name0), 1) ThenBlock: {
                ScanPtr.bump0 = -1
                ReturnValue(0)
            }
            ScanPtr.name1 = name
            ScanPtr.iv1 = idx
            ScanPtr.base1 = base
            ScanPtr.stride1 = stride
            ScanPtr.bump1 = bump
            ScanPtr.step1 = step
            ScanPtr.reg1 = reg
            ScanPtr.n = 2
            ReturnValue(1)
        }
        ReturnValue(0)
    }
}

// base + index*stride into the pointer register when both names are
// already in rbx, r12, or r13 and the stride is a scale. Otherwise 0
// and the caller rebuilds the address through rcx.
Function.Optimize_ScanPtrLea {
    Input: slot: Integer
    Output: Integer
    Body: {
        idx = ScanPtr.iv0
        base = ScanPtr.base0
        stride = ScanPtr.stride0
        reg = ScanPtr.reg0
        IfCondition EqualTo(slot, 1) ThenBlock: {
            idx = ScanPtr.iv1
            base = ScanPtr.base1
            stride = ScanPtr.stride1
            reg = ScanPtr.reg1
        }
        IfCondition EqualTo(idx, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(base, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(base), AST.IDENTIFIER) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(idx), AST.IDENTIFIER) ThenBlock: { ReturnValue(0) }
        ok = 0
        IfCondition EqualTo(stride, 1) ThenBlock: { ok = 1 }
        IfCondition EqualTo(stride, 2) ThenBlock: { ok = 1 }
        IfCondition EqualTo(stride, 4) ThenBlock: { ok = 1 }
        IfCondition EqualTo(stride, 8) ThenBlock: { ok = 1 }
        IfCondition EqualTo(ok, 0) ThenBlock: { ReturnValue(0) }
        Optimize_ScanForce(AST_GetData1(base))
        Optimize_ScanForce(AST_GetData1(idx))
        breg = Optimize_ScanAddrBase(AST_GetData1(base))
        ireg = Optimize_ScanAddrBase(AST_GetData1(idx))
        IfCondition EqualTo(breg, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(ireg, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(breg, ireg) ThenBlock: { ReturnValue(0) }
        X86_LeaRegScaled(reg, breg, ireg, stride)
        ReturnValue(1)
    }
}

// r11 = base + (rev_c - iv)*stride, with the low pointer already in
// reg0. lea r11, [base + rev_c*stride]; sub r11, reg0; add r11, base.
// Holds for any iv. A missing home or a displacement outside signed
// 32 bits returns 0 so the rcx rebuild still runs.
Function.Optimize_ScanPtrRevLea {
    Output: Integer
    Body: {
        base = ScanPtr.base0
        IfCondition EqualTo(base, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(base), AST.IDENTIFIER) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(ScanPtr.reg0, ScanPtr.reg1) ThenBlock: { ReturnValue(0) }
        disp = Multiply(ScanPtr.rev_c, ScanPtr.stride0)
        IfCondition EqualTo(Optimize_Fit32(disp), 0) ThenBlock: { ReturnValue(0) }
        Optimize_ScanForce(AST_GetData1(base))
        breg = Optimize_ScanAddrBase(AST_GetData1(base))
        IfCondition EqualTo(breg, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(breg, ScanPtr.reg1) ThenBlock: { ReturnValue(0) }
        X86_LeaRegDisp(ScanPtr.reg1, breg, disp)
        X86_SubRegReg(ScanPtr.reg1, ScanPtr.reg0)
        X86_AddRegReg(ScanPtr.reg1, breg)
        ReturnValue(1)
    }
}

// r11 = base + (k - iv) * stride. rev_c is k's name when rev1 is 2.
// Same identity as RevLea, with a scaled index instead of a displacement.
// A missing home returns 0 and does not multiply the name pointer.
Function.Optimize_ScanPtrRevLeaK {
    Output: Integer
    Body: {
        base = ScanPtr.base0
        IfCondition EqualTo(base, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(base), AST.IDENTIFIER) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(ScanPtr.reg0, ScanPtr.reg1) ThenBlock: { ReturnValue(0) }
        kname = ScanPtr.rev_c
        IfCondition EqualTo(kname, 0) ThenBlock: { ReturnValue(0) }
        stride = ScanPtr.stride0
        ok = 0
        IfCondition EqualTo(stride, 1) ThenBlock: { ok = 1 }
        IfCondition EqualTo(stride, 2) ThenBlock: { ok = 1 }
        IfCondition EqualTo(stride, 4) ThenBlock: { ok = 1 }
        IfCondition EqualTo(stride, 8) ThenBlock: { ok = 1 }
        IfCondition EqualTo(ok, 0) ThenBlock: { ReturnValue(0) }
        lo = ScanPtr.walk_lo
        IfCondition NotEqual(lo, 0) ThenBlock: {
            kr = Optimize_ScanReg(Optimize_TagIntern(kname))
            ir = Optimize_ScanReg(Optimize_TagIntern(lo))
            IfCondition NotEqual(kr, -1) ThenBlock: {
                IfCondition EqualTo(kr, ir) ThenBlock: { ReturnValue(0) }
            }
        }
        Optimize_ScanForce(AST_GetData1(base))
        Optimize_ScanForce(kname)
        breg = Optimize_ScanAddrBase(AST_GetData1(base))
        kreg = Optimize_ScanAddrBase(kname)
        IfCondition EqualTo(breg, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(kreg, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(breg, kreg) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(breg, ScanPtr.reg0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(kreg, ScanPtr.reg0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(breg, ScanPtr.reg1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(kreg, ScanPtr.reg1) ThenBlock: { ReturnValue(0) }
        X86_LeaRegScaled(ScanPtr.reg1, breg, kreg, stride)
        X86_SubRegReg(ScanPtr.reg1, ScanPtr.reg0)
        X86_AddRegReg(ScanPtr.reg1, breg)
        ReturnValue(1)
    }
}

// base + index*stride into r14 or r11. slot 1 pushes r14 around the math.
Function.Optimize_ScanPtrEmit {
    Input: slot: Integer
    Body: {
        IfCondition EqualTo(Optimize_ScanPtrLea(slot), 1) ThenBlock: { ReturnValue(1) }
        idx = ScanPtr.iv0
        base = ScanPtr.base0
        stride = ScanPtr.stride0
        reg = ScanPtr.reg0
        IfCondition EqualTo(slot, 1) ThenBlock: {
            idx = ScanPtr.iv1
            base = ScanPtr.base1
            stride = ScanPtr.stride1
            reg = ScanPtr.reg1
            Emit_PushR14()
        }
        got = Compile_Expression(idx)
        IfCondition EqualTo(got, 0) ThenBlock: {
            IfCondition EqualTo(slot, 1) ThenBlock: { Emit_PopR14() }
            Compile.error = 1
            ReturnValue(0)
        }
        pow = 0
        IfCondition GreaterThan(stride, 1) ThenBlock: {
            mask = BitwiseAnd(stride, Subtract(stride, 1))
            IfCondition EqualTo(mask, 0) ThenBlock: { pow = 1 }
        }
        IfCondition EqualTo(stride, 1) ThenBlock: { pow = 1 }
        IfCondition EqualTo(pow, 1) ThenBlock: {
            sh = 0
            tmp = stride
            WhileLoop GreaterThan(tmp, 1) {
                tmp = Divide(tmp, 2)
                sh = Add(sh, 1)
            }
            IfCondition GreaterThan(sh, 0) ThenBlock: { Emit_ShlRaxImm8(sh) }
        } ElseBlock: {
            Emit_ImulRaxImm32(stride)
        }
        Emit_PushRax()
        got = Compile_Expression(base)
        IfCondition EqualTo(got, 0) ThenBlock: {
            Emit_PopRax()
            IfCondition EqualTo(slot, 1) ThenBlock: { Emit_PopR14() }
            Compile.error = 1
            ReturnValue(0)
        }
        // rcx, not rbx: a live iv in rbx must survive this one-time setup.
        Emit_PopRcx()
        X86_AddRegReg(Reg.RAX, Reg.RCX)
        Emit_MovRegReg(reg, Reg.RAX)
        IfCondition EqualTo(slot, 1) ThenBlock: { Emit_PopR14() }
        ReturnValue(1)
    }
}

Function.Optimize_ScanPtrConsider {
    Input: node: Address
    Input: body: Address
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(AST_GetType(node), AST.BLOCK) ThenBlock: {
            n = AST_GetChildCount(node)
            i = 0
            WhileLoop LessThan(i, n) {
                Optimize_ScanPtrConsider(AST_GetChild(node, i), body)
                i = Add(i, 1)
            }
            ReturnValue(0)
        }
        IfCondition EqualTo(AST_GetType(node), AST.WHILE) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(AST_GetType(node), AST.FOR_EVERY) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_PlainAssign(node), 0) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterEqual(ScanPtr.n, 2) ThenBlock: { ReturnValue(0) }
        name = AST_GetData1(node)
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_ScanPtrShape(AST_GetChild(node, 0)), 0) ThenBlock: { ReturnValue(0) }
        idx_node = ScanPtr.siv
        base_node = ScanPtr.sbase
        stride = ScanPtr.sstride
        idx_name = AST_GetData1(idx_node)
        IfCondition EqualTo(Optimize_NameEq(name, idx_name), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_NameEq(name, AST_GetData1(base_node)), 1) ThenBlock: { ReturnValue(0) }
        ScanPtr.found = 0
        ScanPtr.mess = 0
        ScanPtr.step = 0
        Optimize_ScanPtrSeeStep(body, idx_name)
        IfCondition EqualTo(ScanPtr.mess, 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_ScanPtrBad(body, name), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(ScanPtr.found, 1) ThenBlock: {
            IfCondition EqualTo(Optimize_Fit32(Multiply(stride, ScanPtr.step)), 0) ThenBlock: { ReturnValue(0) }
        }
        reg = 14
        IfCondition EqualTo(ScanPtr.n, 1) ThenBlock: {
            IfCondition EqualTo(ScanPtr.calls, 1) ThenBlock: { ReturnValue(0) }
            reg = 11
        }
        Optimize_ScanPtrTake(name, reg)
        ReturnValue(0)
    }
}

// The affine address walk (i*N+k)*8. Table homes stay off. r14/r11
// hold the pointers. active stays 0 so the old value homes stay off.
Function.Optimize_ScanIpArm {
    Input: condition: Address
    Input: body: Address
    Body: {
        IfCondition EqualTo(Optimize_ScanActive(), 0) ThenBlock: { ReturnValue(0) }
        Optimize_LoopHomes(condition, body)
        LoopHome.tab_on = 0
        LoopHome.st_on = 0
        LoopHome.der_on = 0
        LoopHome.trip_on = 0
        LoopHome.kmul_on = 0
        LoopHome.prod_on = 0
        LoopHome.active = 0
        // One group would take r11 from the running sum. Matmul needs
        // both walks (A by 8, B by the row stride). Retry once the table
        // and derived homes, which also want r14 and r11, are off.
        IfCondition EqualTo(LoopHome.ip0_on, 0) ThenBlock: {
            Optimize_PickIp(condition, body)
        }
        IfCondition EqualTo(LoopHome.ip1_on, 0) ThenBlock: {
            Optimize_PickIp(condition, body)
        }
        IfCondition EqualTo(LoopHome.ip0_on, 0) ThenBlock: {
            Optimize_IpClear()
            ReturnValue(0)
        }
        IfCondition EqualTo(LoopHome.ip1_on, 0) ThenBlock: {
            Optimize_IpClear()
            ReturnValue(0)
        }
        Optimize_EmitIpOne(0)
        Optimize_EmitIpOne(1)
        ReturnValue(0)
    }
}

// k = k+step steps the affine pointers. The index update still stores.
Function.Optimize_ScanIpStep {
    Input: name: Address
    Input: value: Address
    Body: {
        IfCondition EqualTo(LoopHome.ip0_on, 0) ThenBlock: {
            IfCondition EqualTo(LoopHome.ip1_on, 0) ThenBlock: { ReturnValue(0) }
        }
        IfCondition EqualTo(LoopHome.int_name, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(StringCompare(name, LoopHome.int_name), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(value, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(value), AST.CALL) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(StringCompare(AST_GetData1(value), "Add"), 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetChildCount(value), 2) ThenBlock: { ReturnValue(0) }
        a0 = AST_GetChild(value, 0)
        a1 = AST_GetChild(value, 1)
        num = 0
        IfCondition EqualTo(AST_GetType(a1), AST.NUMBER) ThenBlock: {
            IfCondition EqualTo(AST_GetType(a0), AST.IDENTIFIER) ThenBlock: {
                IfCondition EqualTo(StringCompare(AST_GetData1(a0), name), 0) ThenBlock: { num = a1 }
            }
        }
        IfCondition EqualTo(num, 0) ThenBlock: {
            IfCondition EqualTo(AST_GetType(a0), AST.NUMBER) ThenBlock: {
                IfCondition EqualTo(AST_GetType(a1), AST.IDENTIFIER) ThenBlock: {
                    IfCondition EqualTo(StringCompare(AST_GetData1(a1), name), 0) ThenBlock: { num = a0 }
                }
            }
        }
        IfCondition EqualTo(num, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(StringToNumber(AST_GetData1(num)), LoopHome.iv_step) ThenBlock: { ReturnValue(0) }
        Optimize_IpBump()
        ReturnValue(0)
    }
}

// Positive step when value is Add(name, constant) in either order.
Function.Optimize_ScanAddConst {
    Input: name: Address
    Input: value: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(value, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(value), AST.CALL) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(StringCompare(AST_GetData1(value), "Add"), 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetChildCount(value), 2) ThenBlock: { ReturnValue(0) }
        a0 = AST_GetChild(value, 0)
        a1 = AST_GetChild(value, 1)
        num = 0
        ident = 0
        IfCondition NotEqual(a1, 0) ThenBlock: {
            IfCondition EqualTo(AST_GetType(a1), AST.NUMBER) ThenBlock: {
                num = a1
                ident = a0
            }
        }
        IfCondition EqualTo(num, 0) ThenBlock: {
            IfCondition NotEqual(a0, 0) ThenBlock: {
                IfCondition EqualTo(AST_GetType(a0), AST.NUMBER) ThenBlock: {
                    num = a0
                    ident = a1
                }
            }
        }
        IfCondition EqualTo(num, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(ident, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(ident), AST.IDENTIFIER) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_NameEq(AST_GetData1(ident), name), 0) ThenBlock: { ReturnValue(0) }
        st = StringToNumber(AST_GetData1(num))
        IfCondition LessEqual(st, 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(st)
    }
}

// Step of name = name + positive constant, or 0.
Function.Optimize_ScanSelfStep {
    Input: node: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(Optimize_PlainAssign(node), 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(Optimize_ScanAddConst(AST_GetData1(node), AST_GetChild(node, 0)))
    }
}

// 1 when this loop assigns name. Nested loops are a different arm.
Function.Optimize_ScanAssigns {
    Input: node: Address
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }
        t = AST_GetType(node)
        IfCondition EqualTo(t, AST.WHILE) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(t, AST.FOR_EVERY) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_PlainAssign(node), 1) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(AST_GetData1(node), name), 1) ThenBlock: { ReturnValue(1) }
        }
        n = AST_GetChildCount(node)
        i = 0
        WhileLoop LessThan(i, n) {
            IfCondition EqualTo(Optimize_ScanAssigns(AST_GetChild(node, i), name), 1) ThenBlock: { ReturnValue(1) }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

// 1 when any statement in this tree assigns name, including nested loops.
// ScanAssigns stops at WHILE because a nested loop is a different arm.
Function.Optimize_ScanWrites {
    Input: node: Address
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_PlainAssign(node), 1) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(AST_GetData1(node), name), 1) ThenBlock: { ReturnValue(1) }
        }
        n = AST_GetChildCount(node)
        i = 0
        WhileLoop LessThan(i, n) {
            IfCondition EqualTo(Optimize_ScanWrites(AST_GetChild(node, i), name), 1) ThenBlock: { ReturnValue(1) }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

// One GetByte index that is still on the frame. st is four words:
// base name, index id, bad, while-depth. A slow GetByte writes rbx,
// so any shape the park will not win is bad and the caller leaves rbx
// on the highest-cost IV.
Function.Optimize_ScanGbTake {
    Input: node: Address
    Input: st: Address
    Body: {
        IfCondition LessThan(AST_GetChildCount(node), 2) ThenBlock: {
            StoreValue(Add(st, 16), 1)
            ReturnValue(0)
        }
        b = AST_GetChild(node, 0)
        ix = AST_GetChild(node, 1)
        IfCondition EqualTo(b, 0) ThenBlock: {
            StoreValue(Add(st, 16), 1)
            ReturnValue(0)
        }
        IfCondition NotEqual(AST_GetType(b), AST.IDENTIFIER) ThenBlock: {
            StoreValue(Add(st, 16), 1)
            ReturnValue(0)
        }
        IfCondition LessEqual(Dereference(Add(st, 24)), 0) ThenBlock: {
            StoreValue(Add(st, 16), 1)
            ReturnValue(0)
        }
        bname = AST_GetData1(b)
        seen = Dereference(st)
        IfCondition EqualTo(seen, 0) ThenBlock: {
            StoreValue(st, bname)
        } ElseBlock: {
            IfCondition EqualTo(Optimize_NameEq(bname, seen), 0) ThenBlock: {
                StoreValue(Add(st, 16), 1)
                ReturnValue(0)
            }
        }
        idn = 0
        IfCondition NotEqual(ix, 0) ThenBlock: {
            IfCondition EqualTo(AST_GetType(ix), AST.IDENTIFIER) ThenBlock: {
                idn = ix
            }
        }
        IfCondition EqualTo(idn, 0) ThenBlock: {
            IfCondition NotEqual(ix, 0) ThenBlock: {
                IfCondition EqualTo(AST_GetType(ix), AST.CALL) ThenBlock: {
                    IfCondition EqualTo(StringCompare(AST_GetData1(ix), "BitwiseAnd"), 0) ThenBlock: {
                        IfCondition EqualTo(AST_GetChildCount(ix), 2) ThenBlock: {
                            a0 = AST_GetChild(ix, 0)
                            a1 = AST_GetChild(ix, 1)
                            IfCondition NotEqual(a0, 0) ThenBlock: {
                                IfCondition EqualTo(AST_GetType(a0), AST.IDENTIFIER) ThenBlock: {
                                    IfCondition NotEqual(a1, 0) ThenBlock: {
                                        IfCondition EqualTo(AST_GetType(a1), AST.NUMBER) ThenBlock: {
                                            idn = a0
                                        }
                                    }
                                }
                            }
                            IfCondition EqualTo(idn, 0) ThenBlock: {
                                IfCondition NotEqual(a1, 0) ThenBlock: {
                                    IfCondition EqualTo(AST_GetType(a1), AST.IDENTIFIER) ThenBlock: {
                                        IfCondition NotEqual(a0, 0) ThenBlock: {
                                            IfCondition EqualTo(AST_GetType(a0), AST.NUMBER) ThenBlock: {
                                                idn = a1
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        IfCondition EqualTo(idn, 0) ThenBlock: {
            StoreValue(Add(st, 16), 1)
            ReturnValue(0)
        }
        id = Optimize_TagIntern(AST_GetData1(idn))
        IfCondition LessThan(id, 1) ThenBlock: {
            StoreValue(Add(st, 16), 1)
            ReturnValue(0)
        }
        IfCondition EqualTo(Optimize_ScanIsIv(id), 0) ThenBlock: {
            StoreValue(Add(st, 16), 1)
            ReturnValue(0)
        }
        IfCondition NotEqual(Optimize_ScanReg(id), -1) ThenBlock: {
            StoreValue(Add(st, 16), 1)
            ReturnValue(0)
        }
        IfCondition EqualTo(Optimize_LiveMaxPos(id), -1) ThenBlock: {
            StoreValue(Add(st, 16), 1)
            ReturnValue(0)
        }
        IfCondition EqualTo(Optimize_NameEq(AST_GetData1(idn), bname), 1) ThenBlock: {
            StoreValue(Add(st, 16), 1)
            ReturnValue(0)
        }
        prev = Dereference(Add(st, 8))
        IfCondition NotEqual(prev, 0) ThenBlock: {
            IfCondition NotEqual(prev, id) ThenBlock: {
                StoreValue(Add(st, 16), 1)
                ReturnValue(0)
            }
        }
        StoreValue(Add(st, 8), id)
        ReturnValue(0)
    }
}

Function.Optimize_ScanGbSee {
    Input: node: Address
    Input: st: Address
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Dereference(Add(st, 16)), 1) ThenBlock: { ReturnValue(0) }
        t = AST_GetType(node)
        IfCondition EqualTo(t, AST.INLINEASM) ThenBlock: {
            StoreValue(Add(st, 16), 1)
            ReturnValue(0)
        }
        IfCondition EqualTo(t, AST.FOR_EVERY) ThenBlock: {
            StoreValue(Add(st, 16), 1)
            ReturnValue(0)
        }
        IfCondition EqualTo(t, AST.WHILE) ThenBlock: {
            d = Dereference(Add(st, 24))
            StoreValue(Add(st, 24), Add(d, 1))
            n = AST_GetChildCount(node)
            i = 0
            WhileLoop LessThan(i, n) {
                Optimize_ScanGbSee(AST_GetChild(node, i), st)
                i = Add(i, 1)
            }
            StoreValue(Add(st, 24), d)
            ReturnValue(0)
        }
        IfCondition EqualTo(t, AST.CALL) ThenBlock: {
            nm = AST_GetData1(node)
            IfCondition NotEqual(nm, 0) ThenBlock: {
                IfCondition EqualTo(StringCompare(nm, "SetByte"), 0) ThenBlock: {
                    StoreValue(Add(st, 16), 1)
                    ReturnValue(0)
                }
                IfCondition EqualTo(StringCompare(nm, "GetByte"), 0) ThenBlock: {
                    Optimize_ScanGbTake(node, st)
                }
            }
        }
        n = AST_GetChildCount(node)
        i = 0
        WhileLoop LessThan(i, n) {
            Optimize_ScanGbSee(AST_GetChild(node, i), st)
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

// Tag id of the unassigned GetByte index, or 0. VM Run returns pc.
Function.Optimize_ScanGbIdx {
    Input: body: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(body, 0) ThenBlock: { ReturnValue(0) }
        st = Allocate(32)
        StoreValue(st, 0)
        StoreValue(Add(st, 8), 0)
        StoreValue(Add(st, 16), 0)
        StoreValue(Add(st, 24), 0)
        Optimize_ScanGbSee(body, st)
        bad = Dereference(Add(st, 16))
        id = Dereference(Add(st, 8))
        bname = Dereference(st)
        Deallocate(st, 32)
        IfCondition EqualTo(bad, 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(id, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(bname, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_ScanWrites(body, bname), 1) ThenBlock: { ReturnValue(0) }
        ReturnValue(id)
    }
}

// 1 when value is Add(ident, ident). The two names are sbase and siv.
Function.Optimize_ScanAddIds {
    Input: value: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(value, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(value), AST.CALL) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(StringCompare(AST_GetData1(value), "Add"), 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetChildCount(value), 2) ThenBlock: { ReturnValue(0) }
        a0 = AST_GetChild(value, 0)
        a1 = AST_GetChild(value, 1)
        IfCondition EqualTo(a0, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(a1, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(a0), AST.IDENTIFIER) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(a1), AST.IDENTIFIER) ThenBlock: { ReturnValue(0) }
        ScanPtr.sbase = a0
        ScanPtr.siv = a1
        ReturnValue(1)
    }
}

// Note one Dereference(Add(base, index*1/2/4/8)). Every such load in
// the loop has to share one base. The base is copied to r14 once.
// An index that is not already in r12 or r13 is computed into rcx.
Function.Optimize_ScanScaleSee {
    Input: node: Address
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        t = AST_GetType(node)
        // A nested loop reuses r14 for its own pointer. An outer hoist
        // would still be in r14 when that loop returns, so refuse it.
        IfCondition EqualTo(t, AST.WHILE) ThenBlock: {
            ScanPtr.scale_bad = 1
            ReturnValue(0)
        }
        IfCondition EqualTo(t, AST.FOR_EVERY) ThenBlock: {
            ScanPtr.scale_bad = 1
            ReturnValue(0)
        }
        IfCondition EqualTo(t, AST.CALL) ThenBlock: {
            nm = AST_GetData1(node)
            seen = 0
            IfCondition EqualTo(StringCompare(nm, "Dereference"), 0) ThenBlock: {
                IfCondition EqualTo(AST_GetChildCount(node), 1) ThenBlock: { seen = 1 }
            }
            IfCondition EqualTo(StringCompare(nm, "StoreValue"), 0) ThenBlock: {
                IfCondition GreaterThan(AST_GetChildCount(node), 0) ThenBlock: { seen = 1 }
            }
            IfCondition EqualTo(seen, 1) ThenBlock: {
                addr = AST_GetChild(node, 0)
                IfCondition EqualTo(Optimize_ScanPtrShape(addr), 1) ThenBlock: {
                    st = ScanPtr.sstride
                    pow = 0
                    IfCondition EqualTo(st, 1) ThenBlock: { pow = 1 }
                    IfCondition EqualTo(st, 2) ThenBlock: { pow = 1 }
                    IfCondition EqualTo(st, 4) ThenBlock: { pow = 1 }
                    IfCondition EqualTo(st, 8) ThenBlock: { pow = 1 }
                    IfCondition EqualTo(pow, 1) ThenBlock: {
                        bname = AST_GetData1(ScanPtr.sbase)
                        IfCondition EqualTo(ScanPtr.scale_name, 0) ThenBlock: {
                            ScanPtr.scale_name = bname
                        } ElseBlock: {
                            IfCondition EqualTo(Optimize_NameEq(bname, ScanPtr.scale_name), 0) ThenBlock: {
                                ScanPtr.scale_bad = 1
                            }
                        }
                    }
                }
            }
        }
        n = AST_GetChildCount(node)
        i = 0
        WhileLoop LessThan(i, n) {
            Optimize_ScanScaleSee(AST_GetChild(node, i))
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

// Copy the scaled-address base into r14 once. Later columns use
// [r14+index*scale] instead of reloading the base and shifting.
Function.Optimize_ScanScaleArm {
    Input: body: Address
    Body: {
        IfCondition EqualTo(Optimize_ScanActive(), 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(ScanPtr.n, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(LoopHome.ip0_on, 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(LoopHome.ip1_on, 1) ThenBlock: { ReturnValue(0) }
        ScanPtr.scale_name = 0
        ScanPtr.scale_bad = 0
        Optimize_ScanScaleSee(body)
        IfCondition EqualTo(ScanPtr.scale_bad, 1) ThenBlock: {
            ScanPtr.scale_name = 0
            ScanPtr.scale_bad = 0
            ReturnValue(0)
        }
        IfCondition EqualTo(ScanPtr.scale_name, 0) ThenBlock: { ReturnValue(0) }
        name = ScanPtr.scale_name
        id = Optimize_TagIntern(name)
        reg = Optimize_ScanReg(id)
        breg = 0
        IfCondition EqualTo(Optimize_ScanMatGet(id), 1) ThenBlock: {
            IfCondition EqualTo(reg, Reg.RBX) ThenBlock: { breg = reg }
            IfCondition EqualTo(reg, Reg.R12) ThenBlock: { breg = reg }
            IfCondition EqualTo(reg, Reg.R13) ThenBlock: { breg = reg }
        }
        IfCondition NotEqual(breg, 0) ThenBlock: {
            Emit_MovRegReg(Reg.R14, breg)
            ReturnValue(1)
        }
        off = Scope_Resolve(name)
        rt = Scope.resolve_type
        ok = 0
        IfCondition EqualTo(rt, 1) ThenBlock: { ok = 1 }
        IfCondition EqualTo(rt, 2) ThenBlock: { ok = 1 }
        IfCondition GreaterEqual(off, 0) ThenBlock: { ok = 0 }
        IfCondition EqualTo(ok, 0) ThenBlock: {
            ScanPtr.scale_name = 0
            ReturnValue(0)
        }
        Emit_MovRaxRbpOffset(off)
        Emit_MovRegReg(Reg.R14, Reg.RAX)
        ReturnValue(1)
    }
}

// 1 when this call compiles without writing r14. A real call, even a
// leaf, may use r14 as scratch, so anything outside this list refuses
// the byte hoist.
Function.Optimize_ScanByteSafe {
    Input: nm: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(nm, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_ScanPtrPure(nm), 1) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(Optimize_ScanUseClass(nm), 1) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(nm, "GetByte"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(nm, "SetByte"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(nm, "Float_FromInt"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(nm, "Add"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(nm, "Subtract"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(nm, "Multiply"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(nm, "Divide"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(nm, "Modulo"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(nm, "LessThan"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(nm, "GreaterThan"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(nm, "LessEqual"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(nm, "GreaterEqual"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(nm, "EqualTo"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(nm, "NotEqual"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(nm, "BitwiseAnd"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(nm, "BitwiseOr"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(nm, "BitwiseXor"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(nm, "BitwiseNot"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(nm, "LeftShift"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(nm, "RightShift"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(nm, "ShiftLeft"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(nm, "ShiftRight"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(nm, "Not"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(nm, "And"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(nm, "Or"), 0) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

// One GetByte/SetByte base per leaf loop. Nested loops and any call
// that can write r14 refuse the hoist.
Function.Optimize_ScanByteSee {
    Input: node: Address
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(ScanPtr.byte_bad, 2) ThenBlock: { ReturnValue(0) }
        t = AST_GetType(node)
        IfCondition EqualTo(t, AST.WHILE) ThenBlock: {
            IfCondition EqualTo(ScanPtr.byte_bad, 0) ThenBlock: { ScanPtr.byte_bad = 1 }
            ReturnValue(0)
        }
        IfCondition EqualTo(t, AST.FOR_EVERY) ThenBlock: {
            IfCondition EqualTo(ScanPtr.byte_bad, 0) ThenBlock: { ScanPtr.byte_bad = 1 }
            ReturnValue(0)
        }
        IfCondition EqualTo(t, AST.INLINEASM) ThenBlock: {
            ScanPtr.byte_bad = 2
            ReturnValue(0)
        }
        IfCondition EqualTo(t, AST.CALL) ThenBlock: {
            nm = AST_GetData1(node)
            IfCondition EqualTo(Optimize_ScanByteSafe(nm), 0) ThenBlock: {
                // Skip/ParseNum save r14 (callee-saved). Treat them
                // like a nested loop so Park still hoists src. INLINEASM
                // already set byte_bad=2 above.
                IfCondition EqualTo(ScanPtr.byte_bad, 0) ThenBlock: { ScanPtr.byte_bad = 1 }
                ReturnValue(0)
            }
            hit = 0
            IfCondition EqualTo(StringCompare(nm, "GetByte"), 0) ThenBlock: { hit = 1 }
            IfCondition EqualTo(StringCompare(nm, "SetByte"), 0) ThenBlock: { hit = 1 }
            IfCondition EqualTo(hit, 1) ThenBlock: {
                IfCondition GreaterThan(AST_GetChildCount(node), 0) ThenBlock: {
                    b = AST_GetChild(node, 0)
                    IfCondition NotEqual(b, 0) ThenBlock: {
                        IfCondition EqualTo(AST_GetType(b), AST.IDENTIFIER) ThenBlock: {
                            bname = AST_GetData1(b)
                            IfCondition EqualTo(ScanPtr.byte_name, 0) ThenBlock: {
                                ScanPtr.byte_name = bname
                            } ElseBlock: {
                                IfCondition EqualTo(Optimize_NameEq(bname, ScanPtr.byte_name), 0) ThenBlock: {
                                    ScanPtr.byte_bad = 2
                                }
                            }
                        }
                    }
                }
            }
        }
        n = AST_GetChildCount(node)
        i = 0
        WhileLoop LessThan(i, n) {
            Optimize_ScanByteSee(AST_GetChild(node, i))
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

// 1 when name is a frame local or a live rbx/r12/r13 home.
Function.Optimize_ScanByteHold {
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }
        id = Optimize_TagIntern(name)
        IfCondition NotEqual(id, 0) ThenBlock: {
            IfCondition EqualTo(Optimize_ScanMatGet(id), 1) ThenBlock: {
                reg = Optimize_ScanReg(id)
                IfCondition EqualTo(reg, Reg.RBX) ThenBlock: { ReturnValue(1) }
                IfCondition EqualTo(reg, Reg.R12) ThenBlock: { ReturnValue(1) }
                IfCondition EqualTo(reg, Reg.R13) ThenBlock: { ReturnValue(1) }
            }
        }
        off = Scope_Resolve(name)
        rt = Scope.resolve_type
        ok = 0
        IfCondition EqualTo(rt, 1) ThenBlock: { ok = 1 }
        IfCondition EqualTo(rt, 2) ThenBlock: { ok = 1 }
        IfCondition GreaterEqual(off, 0) ThenBlock: { ok = 0 }
        ReturnValue(ok)
    }
}

// Add reg into r14. reg is rbx, r12, r13, or rcx (1).
Function.Optimize_ScanByteAdd {
    Input: reg: Integer
    Body: {
        IfCondition EqualTo(reg, 1) ThenBlock: { X86Enc_Assemble("ADD r14, rcx") }
        IfCondition EqualTo(reg, Reg.RBX) ThenBlock: { X86Enc_Assemble("ADD r14, rbx") }
        IfCondition EqualTo(reg, Reg.R12) ThenBlock: { X86Enc_Assemble("ADD r14, r12") }
        IfCondition EqualTo(reg, Reg.R13) ThenBlock: { X86Enc_Assemble("ADD r14, r13") }
        ReturnValue(0)
    }
}

// The byte loop reads this name from its frame slot. A scan home
// skipped that store, so write the register back before the load.
Function.Optimize_ScanByteSlot {
    Input: name: Address
    Body: {
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }
        id = Optimize_TagIntern(name)
        IfCondition EqualTo(id, 0) ThenBlock: { ReturnValue(0) }
        Optimize_ScanSpillId(id)
        ReturnValue(0)
    }
}

// r14 = base + iv, r11 = base + lim. Both ends stay off the index regs.
Function.Optimize_ScanByteCursor {
    Body: {
        Optimize_ScanByteSlot(ScanPtr.byte_name)
        off = Scope_Resolve(ScanPtr.byte_name)
        Emit_MovRaxRbpOffset(off)
        Emit_MovRegReg(Reg.R14, Reg.RAX)
        lim_id = Optimize_TagIntern(ScanPtr.byte_lim)
        lim_reg = 0
        IfCondition EqualTo(Optimize_ScanMatGet(lim_id), 1) ThenBlock: {
            reg = Optimize_ScanReg(lim_id)
            IfCondition EqualTo(reg, Reg.RBX) ThenBlock: { lim_reg = reg }
            IfCondition EqualTo(reg, Reg.R12) ThenBlock: { lim_reg = reg }
            IfCondition EqualTo(reg, Reg.R13) ThenBlock: { lim_reg = reg }
        }
        Emit_MovRegReg(Reg.R11, Reg.R14)
        IfCondition NotEqual(lim_reg, 0) ThenBlock: {
            IfCondition EqualTo(lim_reg, Reg.R13) ThenBlock: { X86Enc_Assemble("ADD r11, r13") }
            IfCondition EqualTo(lim_reg, Reg.R12) ThenBlock: { X86Enc_Assemble("ADD r11, r12") }
            IfCondition EqualTo(lim_reg, Reg.RBX) ThenBlock: { X86Enc_Assemble("ADD r11, rbx") }
        } ElseBlock: {
            Optimize_ScanByteSlot(ScanPtr.byte_lim)
            loff = Scope_Resolve(ScanPtr.byte_lim)
            X86_MovRcxRbpOffset(loff)
            X86Enc_Assemble("ADD r11, rcx")
        }
        iv_id = Optimize_TagIntern(ScanPtr.byte_iv)
        iv_reg = 0
        IfCondition EqualTo(Optimize_ScanMatGet(iv_id), 1) ThenBlock: {
            reg = Optimize_ScanReg(iv_id)
            IfCondition EqualTo(reg, Reg.RBX) ThenBlock: { iv_reg = reg }
            IfCondition EqualTo(reg, Reg.R12) ThenBlock: { iv_reg = reg }
            IfCondition EqualTo(reg, Reg.R13) ThenBlock: { iv_reg = reg }
        }
        IfCondition NotEqual(iv_reg, 0) ThenBlock: {
            Optimize_ScanByteAdd(iv_reg)
        } ElseBlock: {
            Optimize_ScanByteSlot(ScanPtr.byte_iv)
            ioff = Scope_Resolve(ScanPtr.byte_iv)
            X86_MovRcxRbpOffset(ioff)
            Optimize_ScanByteAdd(1)
        }
        ReturnValue(0)
    }
}

// Body is exactly SetByte(base, iv, imm) then iv = iv + step,
// and the test is iv < lim. Indexed byte stores lost to a plain
// [r14] store on this CPU, so r14 walks the address.
Function.Optimize_ScanBytePattern {
    Input: cond: Address
    Input: body: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(body, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(body), AST.BLOCK) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetChildCount(body), 2) ThenBlock: { ReturnValue(0) }
        st0 = AST_GetChild(body, 0)
        st1 = AST_GetChild(body, 1)
        IfCondition NotEqual(AST_GetType(st0), AST.CALL) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(StringCompare(AST_GetData1(st0), "SetByte"), 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetChildCount(st0), 3) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_PlainAssign(st1), 0) ThenBlock: { ReturnValue(0) }
        b = AST_GetChild(st0, 0)
        ivn = AST_GetChild(st0, 1)
        imm = AST_GetChild(st0, 2)
        IfCondition NotEqual(AST_GetType(b), AST.IDENTIFIER) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(ivn), AST.IDENTIFIER) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(imm), AST.NUMBER) ThenBlock: { ReturnValue(0) }
        n = StringToNumber(AST_GetData1(imm))
        IfCondition LessThan(n, 0) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterThan(n, 255) ThenBlock: { ReturnValue(0) }
        target = AST_GetData1(st1)
        IfCondition EqualTo(Optimize_NameEq(target, AST_GetData1(ivn)), 0) ThenBlock: { ReturnValue(0) }
        val = AST_GetChild(st1, 0)
        IfCondition NotEqual(AST_GetType(val), AST.CALL) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(StringCompare(AST_GetData1(val), "Add"), 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetChildCount(val), 2) ThenBlock: { ReturnValue(0) }
        a0 = AST_GetChild(val, 0)
        a1 = AST_GetChild(val, 1)
        IfCondition NotEqual(AST_GetType(a0), AST.IDENTIFIER) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(a1), AST.IDENTIFIER) ThenBlock: { ReturnValue(0) }
        step = 0
        IfCondition EqualTo(Optimize_NameEq(AST_GetData1(a0), target), 1) ThenBlock: { step = AST_GetData1(a1) }
        IfCondition EqualTo(Optimize_NameEq(AST_GetData1(a1), target), 1) ThenBlock: { step = AST_GetData1(a0) }
        IfCondition EqualTo(step, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_NameEq(step, target), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(cond, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(cond), AST.CALL) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(StringCompare(AST_GetData1(cond), "LessThan"), 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetChildCount(cond), 2) ThenBlock: { ReturnValue(0) }
        c0 = AST_GetChild(cond, 0)
        c1 = AST_GetChild(cond, 1)
        IfCondition NotEqual(AST_GetType(c0), AST.IDENTIFIER) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(c1), AST.IDENTIFIER) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_NameEq(AST_GetData1(c0), target), 0) ThenBlock: { ReturnValue(0) }
        lim = AST_GetData1(c1)
        IfCondition EqualTo(Optimize_NameEq(lim, target), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_ScanByteHold(step), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_ScanByteHold(lim), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_ScanByteHold(target), 0) ThenBlock: { ReturnValue(0) }
        boff = Scope_Resolve(AST_GetData1(b))
        brt = Scope.resolve_type
        bok = 0
        IfCondition EqualTo(brt, 1) ThenBlock: { bok = 1 }
        IfCondition EqualTo(brt, 2) ThenBlock: { bok = 1 }
        IfCondition GreaterEqual(boff, 0) ThenBlock: { bok = 0 }
        IfCondition EqualTo(bok, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_ScanAssigns(body, AST_GetData1(b)), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_ScanAssigns(body, step), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_ScanAssigns(body, lim), 1) ThenBlock: { ReturnValue(0) }
        ScanPtr.byte_iv = target
        ScanPtr.byte_step = step
        ScanPtr.byte_lim = lim
        ScanPtr.byte_imm = n
        ReturnValue(1)
    }
}

// 1 when value is the number 1.
Function.Optimize_ScanByteOne {
    Input: node: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(node), AST.NUMBER) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(StringToNumber(AST_GetData1(node)), 1) ThenBlock: { ReturnValue(0) }
        ReturnValue(1)
    }
}

// acc = acc + GetByte(base, iv), then iv = iv + 1, while iv < lim.
// Step 1 is the only shape a 16-byte sum can fold.
Function.Optimize_ScanByteSum {
    Input: cond: Address
    Input: body: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(body, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(body), AST.BLOCK) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetChildCount(body), 2) ThenBlock: { ReturnValue(0) }
        st0 = AST_GetChild(body, 0)
        st1 = AST_GetChild(body, 1)
        IfCondition EqualTo(Optimize_PlainAssign(st0), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_PlainAssign(st1), 0) ThenBlock: { ReturnValue(0) }
        acc = AST_GetData1(st0)
        target = AST_GetData1(st1)
        IfCondition EqualTo(Optimize_NameEq(acc, target), 1) ThenBlock: { ReturnValue(0) }
        val = AST_GetChild(st0, 0)
        IfCondition NotEqual(AST_GetType(val), AST.CALL) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(StringCompare(AST_GetData1(val), "Add"), 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetChildCount(val), 2) ThenBlock: { ReturnValue(0) }
        a0 = AST_GetChild(val, 0)
        a1 = AST_GetChild(val, 1)
        got = 0
        IfCondition NotEqual(a0, 0) ThenBlock: {
            IfCondition EqualTo(AST_GetType(a0), AST.IDENTIFIER) ThenBlock: {
                IfCondition EqualTo(Optimize_NameEq(AST_GetData1(a0), acc), 1) ThenBlock: { got = a1 }
            }
        }
        IfCondition EqualTo(got, 0) ThenBlock: {
            IfCondition NotEqual(a1, 0) ThenBlock: {
                IfCondition EqualTo(AST_GetType(a1), AST.IDENTIFIER) ThenBlock: {
                    IfCondition EqualTo(Optimize_NameEq(AST_GetData1(a1), acc), 1) ThenBlock: { got = a0 }
                }
            }
        }
        IfCondition EqualTo(got, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(got), AST.CALL) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(StringCompare(AST_GetData1(got), "GetByte"), 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetChildCount(got), 2) ThenBlock: { ReturnValue(0) }
        b = AST_GetChild(got, 0)
        ivn = AST_GetChild(got, 1)
        IfCondition NotEqual(AST_GetType(b), AST.IDENTIFIER) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(ivn), AST.IDENTIFIER) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_NameEq(AST_GetData1(b), ScanPtr.byte_name), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_NameEq(AST_GetData1(ivn), target), 0) ThenBlock: { ReturnValue(0) }
        stepv = AST_GetChild(st1, 0)
        IfCondition NotEqual(AST_GetType(stepv), AST.CALL) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(StringCompare(AST_GetData1(stepv), "Add"), 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetChildCount(stepv), 2) ThenBlock: { ReturnValue(0) }
        s0 = AST_GetChild(stepv, 0)
        s1 = AST_GetChild(stepv, 1)
        one = 0
        IfCondition EqualTo(Optimize_ScanByteOne(s1), 1) ThenBlock: {
            IfCondition NotEqual(s0, 0) ThenBlock: {
                IfCondition EqualTo(AST_GetType(s0), AST.IDENTIFIER) ThenBlock: {
                    IfCondition EqualTo(Optimize_NameEq(AST_GetData1(s0), target), 1) ThenBlock: { one = 1 }
                }
            }
        }
        IfCondition EqualTo(one, 0) ThenBlock: {
            IfCondition EqualTo(Optimize_ScanByteOne(s0), 1) ThenBlock: {
                IfCondition NotEqual(s1, 0) ThenBlock: {
                    IfCondition EqualTo(AST_GetType(s1), AST.IDENTIFIER) ThenBlock: {
                        IfCondition EqualTo(Optimize_NameEq(AST_GetData1(s1), target), 1) ThenBlock: { one = 1 }
                    }
                }
            }
        }
        IfCondition EqualTo(one, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(cond, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(cond), AST.CALL) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(StringCompare(AST_GetData1(cond), "LessThan"), 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetChildCount(cond), 2) ThenBlock: { ReturnValue(0) }
        c0 = AST_GetChild(cond, 0)
        c1 = AST_GetChild(cond, 1)
        IfCondition NotEqual(AST_GetType(c0), AST.IDENTIFIER) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(c1), AST.IDENTIFIER) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_NameEq(AST_GetData1(c0), target), 0) ThenBlock: { ReturnValue(0) }
        lim = AST_GetData1(c1)
        IfCondition EqualTo(Optimize_NameEq(lim, target), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_NameEq(lim, acc), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_NameEq(acc, ScanPtr.byte_name), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_ScanByteHold(target), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_ScanByteHold(lim), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_ScanByteHold(acc), 0) ThenBlock: { ReturnValue(0) }
        boff = Scope_Resolve(ScanPtr.byte_name)
        brt = Scope.resolve_type
        bok = 0
        IfCondition EqualTo(brt, 1) ThenBlock: { bok = 1 }
        IfCondition EqualTo(brt, 2) ThenBlock: { bok = 1 }
        IfCondition GreaterEqual(boff, 0) ThenBlock: { bok = 0 }
        IfCondition EqualTo(bok, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_ScanAssigns(body, ScanPtr.byte_name), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_ScanAssigns(body, lim), 1) ThenBlock: { ReturnValue(0) }
        ScanPtr.byte_iv = target
        ScanPtr.byte_lim = lim
        ScanPtr.byte_step = 0
        ScanPtr.byte_imm = -1
        ScanPtr.byte_acc = acc
        ReturnValue(1)
    }
}

// 1 when a float home is live. The 16-byte sum uses xmm0, xmm1, and xmm2.
Function.Optimize_ScanByteXmmBusy {
    Output: Integer
    Body: {
        i = 1
        last = Add(TagState.nnames, 1)
        WhileLoop LessThan(i, last) {
            IfCondition EqualTo(Optimize_ScanMatGet(i), 1) ThenBlock: {
                IfCondition GreaterEqual(Optimize_ScanXmm(Optimize_ScanReg(i)), 0) ThenBlock: {
                    ReturnValue(1)
                }
            }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

// rbx = acc. The cursor already consumed the limit register.
Function.Optimize_ScanByteAccLoad {
    Body: {
        id = Optimize_TagIntern(ScanPtr.byte_acc)
        IfCondition EqualTo(Optimize_ScanMatGet(id), 1) ThenBlock: {
            reg = Optimize_ScanReg(id)
            IfCondition EqualTo(reg, Reg.RBX) ThenBlock: { ReturnValue(0) }
            IfCondition EqualTo(reg, Reg.R12) ThenBlock: {
                Emit_MovRbxR12()
                ReturnValue(0)
            }
            IfCondition EqualTo(reg, Reg.R13) ThenBlock: {
                Emit_MovRbxR13()
                ReturnValue(0)
            }
        }
        Optimize_ScanByteSlot(ScanPtr.byte_acc)
        off = Scope_Resolve(ScanPtr.byte_acc)
        Emit_MovRbxRbpOffset(off)
        ReturnValue(0)
    }
}

// Inline 16-byte sum for a span of at least 64 bytes. Shorter spans
// stay on the byte cursor. movdqu does not need the pointer aligned.
// r14 walks, r11 is the end, rbx is the accumulator. The tail is the
// ordinary loop body, which starts at the next label the caller emits.
Function.Optimize_ScanByteWide {
    Input: end_label: Integer
    Body: {
        IfCondition EqualTo(Optimize_ScanByteXmmBusy(), 1) ThenBlock: { ReturnValue(0) }
        tail = Compile_NewLabel()
        wide = Compile_NewLabel()
        rest = Compile_NewLabel()
        Emit_MovRegReg(Reg.RAX, Reg.R11)
        Emit_Byte(0x4C)
        Emit_Byte(0x29)
        Emit_Byte(0xF0)
        Emit_Byte(0x48)
        Emit_Byte(0x83)
        Emit_Byte(0xF8)
        Emit_Byte(0x40)
        Emit_Jb(tail)
        Emit_Byte(0x48)
        Emit_Byte(0x89)
        Emit_Byte(0xC1)
        Emit_Byte(0x48)
        Emit_Byte(0x83)
        Emit_Byte(0xE1)
        Emit_Byte(0xF0)
        Emit_Byte(0x4C)
        Emit_Byte(0x01)
        Emit_Byte(0xF1)
        X86_ByteSumInit()
        Emit_MarkLabel(wide)
        X86_ByteSumStep()
        Emit_Byte(0x49)
        Emit_Byte(0x83)
        Emit_Byte(0xC6)
        Emit_Byte(0x10)
        Emit_Byte(0x49)
        Emit_Byte(0x39)
        Emit_Byte(0xCE)
        Emit_Jb(wide)
        X86_ByteSumFold()
        Emit_MarkLabel(tail)
        Emit_Byte(0x4D)
        Emit_Byte(0x39)
        Emit_Byte(0xDE)
        Emit_Jb(rest)
        Optimize_ScanByteRepair()
        Emit_Jmp(end_label)
        Emit_MarkLabel(rest)
        ReturnValue(0)
    }
}

// Load the invariant GetByte/SetByte base into r14. 0 when the name
// is not a frame local or is assigned in this body.
Function.Optimize_ScanByteReload {
    Output: Integer
    Body: {
        IfCondition EqualTo(ScanPtr.byte_name, 0) ThenBlock: { ReturnValue(0) }
        id = Optimize_TagIntern(ScanPtr.byte_name)
        breg = 0
        IfCondition NotEqual(id, 0) ThenBlock: {
            IfCondition EqualTo(Optimize_ScanMatGet(id), 1) ThenBlock: {
                reg = Optimize_ScanReg(id)
                IfCondition EqualTo(reg, Reg.RBX) ThenBlock: { breg = reg }
                IfCondition EqualTo(reg, Reg.R12) ThenBlock: { breg = reg }
                IfCondition EqualTo(reg, Reg.R13) ThenBlock: { breg = reg }
            }
        }
        IfCondition NotEqual(breg, 0) ThenBlock: {
            Emit_MovRegReg(Reg.R14, breg)
            ReturnValue(1)
        }
        Optimize_ScanByteSlot(ScanPtr.byte_name)
        off = Scope_Resolve(ScanPtr.byte_name)
        rt = Scope.resolve_type
        ok = 0
        IfCondition EqualTo(rt, 1) ThenBlock: { ok = 1 }
        IfCondition EqualTo(rt, 2) ThenBlock: { ok = 1 }
        IfCondition GreaterEqual(off, 0) ThenBlock: { ok = 0 }
        IfCondition EqualTo(ok, 0) ThenBlock: { ReturnValue(0) }
        Emit_MovRaxRbpOffset(off)
        Emit_MovRegReg(Reg.R14, Reg.RAX)
        ReturnValue(1)
    }
}

// Unstepped GetByte base. Cursor/sum patterns already claimed r14 as
// base+iv. This only parks the pointer, so later GetByte uses
// [r14+idx] instead of reloading the base every trip.
Function.Optimize_ScanBytePark {
    Input: body: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(ScanPtr.byte_name, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_ScanAssigns(body, ScanPtr.byte_name), 1) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition EqualTo(Optimize_ScanByteReload(), 0) ThenBlock: { ReturnValue(0) }
        ScanPtr.byte_iv = 0
        ScanPtr.byte_acc = 0
        ReturnValue(1)
    }
}

// Strided SetByte loop, or a unit-stride byte sum. r14 = base+iv,
// r11 = base+lim. The sum keeps acc in rbx and folds 16 bytes inline
// when at least 64 bytes remain.
Function.Optimize_ScanByteArm {
    Input: cond: Address
    Input: body: Address
    Input: end_label: Integer
    Body: {
        IfCondition EqualTo(Optimize_ScanActive(), 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(ScanPtr.n, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(LoopHome.ip0_on, 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(LoopHome.ip1_on, 1) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(ScanPtr.scale_name, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(ScanPtr.run_name, 0) ThenBlock: { ReturnValue(0) }
        ScanPtr.byte_name = 0
        ScanPtr.byte_bad = 0
        ScanPtr.byte_iv = 0
        ScanPtr.byte_step = 0
        ScanPtr.byte_lim = 0
        ScanPtr.byte_imm = -1
        ScanPtr.byte_acc = 0
        ScanPtr.byte_keep = 0
        Optimize_ScanByteSee(body)
        IfCondition EqualTo(ScanPtr.byte_bad, 2) ThenBlock: {
            ScanPtr.byte_name = 0
            ScanPtr.byte_bad = 0
            ReturnValue(0)
        }
        IfCondition EqualTo(ScanPtr.byte_name, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(ScanPtr.byte_bad, 0) ThenBlock: {
            IfCondition EqualTo(Optimize_ScanBytePattern(cond, body), 1) ThenBlock: {
                Optimize_ScanByteCursor()
                ReturnValue(1)
            }
            IfCondition EqualTo(Optimize_ScanByteSum(cond, body), 1) ThenBlock: {
                Optimize_ScanByteCursor()
                Optimize_ScanByteAccLoad()
                Optimize_ScanByteWide(end_label)
                ReturnValue(1)
            }
            IfCondition EqualTo(Optimize_ScanBytePark(body), 1) ThenBlock: {
                ReturnValue(1)
            }
        }
        // Nested loop sets byte_bad=1. The base is still invariant.
        // Park it in r14 so outer GetByte is [r14+idx]; the inner
        // Push/Pop reloads r14. LZ4 Compress was reloading src from
        // the frame on every GetByte because keep cleared byte_name.
        IfCondition EqualTo(ScanPtr.byte_bad, 1) ThenBlock: {
            IfCondition EqualTo(Optimize_ScanBytePark(body), 1) ThenBlock: {
                ReturnValue(1)
            }
        }
        IfCondition EqualTo(ScanPtr.byte_bad, 1) ThenBlock: {
            IfCondition EqualTo(Optimize_ScanAssigns(body, ScanPtr.byte_name), 0) ThenBlock: {
                koff = Scope_Resolve(ScanPtr.byte_name)
                krt = Scope.resolve_type
                kok = 0
                IfCondition EqualTo(krt, 1) ThenBlock: { kok = 1 }
                IfCondition EqualTo(krt, 2) ThenBlock: { kok = 1 }
                IfCondition GreaterEqual(koff, 0) ThenBlock: { kok = 0 }
                IfCondition EqualTo(kok, 1) ThenBlock: {
                    Optimize_ScanByteSlot(ScanPtr.byte_name)
                    Emit_MovRaxRbpOffset(koff)
                    X86Enc_Assemble("MOV r11, rax")
                    ScanPtr.byte_keep = ScanPtr.byte_name
                    ScanPtr.byte_name = 0
                    ScanPtr.byte_iv = 0
                    ScanPtr.byte_acc = 0
                    ScanPtr.byte_bad = 0
                    ReturnValue(1)
                }
            }
        }
        ScanPtr.byte_name = 0
        ScanPtr.byte_iv = 0
        ScanPtr.byte_acc = 0
        ScanPtr.byte_bad = 0
        ReturnValue(0)
    }
}

// 2 when this tree increments name by a positive constant and every
// other write of name is a plain number. 0 when a nested loop or a
// stranger write makes r14 unsafe. 1 when name is untouched.
Function.Optimize_ScanCtrWalk {
    Input: node: Address
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(1) }
        t = AST_GetType(node)
        IfCondition EqualTo(t, AST.WHILE) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(t, AST.FOR_EVERY) ThenBlock: { ReturnValue(0) }
        saw = 1
        IfCondition EqualTo(Optimize_PlainAssign(node), 1) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(AST_GetData1(node), name), 1) ThenBlock: {
                val = AST_GetChild(node, 0)
                IfCondition EqualTo(val, 0) ThenBlock: { ReturnValue(0) }
                IfCondition EqualTo(AST_GetType(val), AST.NUMBER) ThenBlock: { ReturnValue(1) }
                st = Optimize_ScanAddConst(name, val)
                IfCondition GreaterThan(st, 0) ThenBlock: {
                    IfCondition LessThan(st, 128) ThenBlock: { ReturnValue(2) }
                }
                ReturnValue(0)
            }
        }
        n = AST_GetChildCount(node)
        i = 0
        WhileLoop LessThan(i, n) {
            w = Optimize_ScanCtrWalk(AST_GetChild(node, i), name)
            IfCondition EqualTo(w, 0) ThenBlock: { ReturnValue(0) }
            IfCondition EqualTo(w, 2) ThenBlock: { saw = 2 }
            i = Add(i, 1)
        }
        ReturnValue(saw)
    }
}

// 1 when the body reads name other than as the addend of the
// increment ScanCtrSet compiles. That increment is add r14, k and
// does not read the frame. Every other read still loads the slot.
Function.Optimize_ScanCtrUsed {
    Input: node: Address
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_PlainAssign(node), 1) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(AST_GetData1(node), name), 1) ThenBlock: {
                val = AST_GetChild(node, 0)
                IfCondition EqualTo(val, 0) ThenBlock: { ReturnValue(0) }
                IfCondition EqualTo(AST_GetType(val), AST.NUMBER) ThenBlock: { ReturnValue(0) }
                st = Optimize_ScanAddConst(name, val)
                IfCondition GreaterThan(st, 0) ThenBlock: {
                    IfCondition LessThan(st, 128) ThenBlock: { ReturnValue(0) }
                }
                ReturnValue(0)
            }
        }
        nt = AST_GetType(node)
        IfCondition EqualTo(nt, AST.IDENTIFIER) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(AST_GetData1(node), name), 1) ThenBlock: { ReturnValue(1) }
        }
        IfCondition EqualTo(nt, AST.INDEX_ASSIGN) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(AST_GetData1(node), name), 1) ThenBlock: { ReturnValue(1) }
        }
        IfCondition EqualTo(nt, AST.POINTER_FIELD_ASSIGN) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(AST_GetData1(node), name), 1) ThenBlock: { ReturnValue(1) }
        }
        IfCondition EqualTo(nt, AST.POINTER_FIELD_ACCESS) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(AST_GetData1(node), name), 1) ThenBlock: { ReturnValue(1) }
        }
        n = AST_GetChildCount(node)
        i = 0
        WhileLoop LessThan(i, n) {
            IfCondition EqualTo(Optimize_ScanCtrUsed(AST_GetChild(node, i), name), 1) ThenBlock: {
                ReturnValue(1)
            }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

// A spilled i < 50 counter. r12 and r13 are the outer indexes, so i
// lives in r14 and the back edge compares the register. The frame is
// written once on the way out, so this is only safe when the body
// does not read i. A read would keep seeing the entry value.
Function.Optimize_ScanCtrArm {
    Input: cond: Address
    Input: body: Address
    Body: {
        IfCondition EqualTo(Optimize_ScanActive(), 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(ScanPtr.n, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(LoopHome.ip0_on, 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(LoopHome.ip1_on, 1) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(ScanPtr.scale_name, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(ScanPtr.run_name, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(ScanPtr.byte_iv, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(ScanPtr.byte_keep, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(ScanPtr.byte_name, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(LoopHome.trip_on, 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(cond, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(cond), AST.CALL) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(StringCompare(AST_GetData1(cond), "LessThan"), 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetChildCount(cond), 2) ThenBlock: { ReturnValue(0) }
        c0 = AST_GetChild(cond, 0)
        c1 = AST_GetChild(cond, 1)
        IfCondition NotEqual(AST_GetType(c0), AST.IDENTIFIER) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(c1), AST.NUMBER) ThenBlock: { ReturnValue(0) }
        lim = StringToNumber(AST_GetData1(c1))
        IfCondition LessThan(lim, 0) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterThan(lim, 127) ThenBlock: { ReturnValue(0) }
        name = AST_GetData1(c0)
        IfCondition NotEqual(Optimize_ScanAddrBase(name), 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(Optimize_ScanCtrWalk(body, name), 2) ThenBlock: { ReturnValue(0) }
        // FB_DrawChar reads col for the pixel and the shift. Leaving
        // those on the frame while r14 advances draws only column 0.
        IfCondition EqualTo(Optimize_ScanCtrUsed(body, name), 1) ThenBlock: { ReturnValue(0) }
        off = Scope_Resolve(name)
        rt = Scope.resolve_type
        ok = 0
        IfCondition EqualTo(rt, 1) ThenBlock: { ok = 1 }
        IfCondition EqualTo(rt, 2) ThenBlock: { ok = 1 }
        IfCondition GreaterEqual(off, 0) ThenBlock: { ok = 0 }
        IfCondition EqualTo(ok, 0) ThenBlock: { ReturnValue(0) }
        Emit_MovRaxRbpOffset(off)
        X86Enc_Assemble("MOV r14, rax")
        ScanPtr.ctr_name = name
        ScanPtr.ctr_lim = lim
        ReturnValue(1)
    }
}

// i = i + k, or i = N. r14 is the counter. The frame is written once
// on the way out.
Function.Optimize_ScanCtrSet {
    Input: name: Address
    Input: value: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(ScanPtr.ctr_name, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_NameEq(name, ScanPtr.ctr_name), 0) ThenBlock: { ReturnValue(0) }
        st = Optimize_ScanAddConst(name, value)
        IfCondition GreaterThan(st, 0) ThenBlock: {
            IfCondition LessThan(st, 128) ThenBlock: {
                Emit_Byte(0x49)
                Emit_Byte(0x83)
                Emit_Byte(0xC6)
                Emit_Byte(st)
                ReturnValue(1)
            }
        }
        IfCondition NotEqual(value, 0) ThenBlock: {
            IfCondition EqualTo(AST_GetType(value), AST.NUMBER) ThenBlock: {
                n = StringToNumber(AST_GetData1(value))
                Emit_Byte(0x49)
                Emit_Byte(0xC7)
                Emit_Byte(0xC6)
                Emit_DWord(n)
                ReturnValue(1)
            }
        }
        ReturnValue(0)
    }
}

// The loop fell out. Put the counter back. A zero-trip entry jumps
// over this, so the frame keeps the value it already had.
Function.Optimize_ScanCtrExit {
    Body: {
        IfCondition EqualTo(ScanPtr.ctr_name, 0) ThenBlock: { ReturnValue(0) }
        off = Scope_Resolve(ScanPtr.ctr_name)
        Emit_MovRegReg(Reg.RAX, Reg.R14)
        Emit_MovRbpOffsetRax(off)
        Optimize_ScanByteMatDrop(ScanPtr.ctr_name)
        ScanPtr.ctr_name = 0
        ScanPtr.ctr_lim = 0
        ReturnValue(0)
    }
}

// 1 when this loop must not park a float in xmm2. A nested loop, a
// byte walk, or inline asm can write xmm2. Real calls are refused
// separately by ScanTreeXmmKill.
Function.Optimize_ScanFltBlocked {
    Input: node: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        t = AST_GetType(node)
        IfCondition EqualTo(t, AST.INLINEASM) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(t, AST.CALL) ThenBlock: {
            nm = AST_GetData1(node)
            IfCondition NotEqual(nm, 0) ThenBlock: {
                IfCondition EqualTo(StringCompare(nm, "GetByte"), 0) ThenBlock: { ReturnValue(1) }
                IfCondition EqualTo(StringCompare(nm, "SetByte"), 0) ThenBlock: { ReturnValue(1) }
            }
        }
        n = AST_GetChildCount(node)
        i = 0
        WhileLoop LessThan(i, n) {
            IfCondition EqualTo(Optimize_ScanFltBlocked(AST_GetChild(node, i)), 1) ThenBlock: {
                ReturnValue(1)
            }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

// Frame float with no scan register, not written in this loop.
// 0 when the node is not that identifier.
Function.Optimize_ScanFltCand {
    Input: node: Address
    Input: body: Address
    Output: Address
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(node), AST.IDENTIFIER) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterEqual(Optimize_ScanFltSrc(node), 0) ThenBlock: { ReturnValue(0) }
        name = AST_GetData1(node)
        id = Optimize_ScanFind(name)
        IfCondition EqualTo(id, 0) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterEqual(Optimize_ScanReg(id), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_ScanAssigns(body, name), 1) ThenBlock: { ReturnValue(0) }
        off = Scope_Resolve(name)
        rt = Scope.resolve_type
        ok = 0
        IfCondition EqualTo(rt, 1) ThenBlock: { ok = 1 }
        IfCondition EqualTo(rt, 2) ThenBlock: { ok = 1 }
        IfCondition GreaterEqual(off, 0) ThenBlock: { ok = 0 }
        IfCondition EqualTo(ok, 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(name)
    }
}

// First frame float compared or used in a float op in this loop.
// Nested loops are their own arm, so a use inside one is left for
// that loop. A compare still wins when both exist.
Function.Optimize_ScanFltFind {
    Input: node: Address
    Input: body: Address
    Output: Address
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        t = AST_GetType(node)
        IfCondition EqualTo(t, AST.WHILE) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(t, AST.FOR_EVERY) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(t, AST.CALL) ThenBlock: {
            nm = AST_GetData1(node)
            want = Optimize_IsFloatCmp(nm)
            IfCondition EqualTo(want, 0) ThenBlock: {
                IfCondition NotEqual(Optimize_FltOpKind(nm), 0) ThenBlock: { want = 1 }
            }
            IfCondition EqualTo(want, 1) ThenBlock: {
                IfCondition GreaterEqual(AST_GetChildCount(node), 1) ThenBlock: {
                    hit = Optimize_ScanFltCand(AST_GetChild(node, 0), body)
                    IfCondition NotEqual(hit, 0) ThenBlock: { ReturnValue(hit) }
                }
                IfCondition GreaterEqual(AST_GetChildCount(node), 2) ThenBlock: {
                    hit2 = Optimize_ScanFltCand(AST_GetChild(node, 1), body)
                    IfCondition NotEqual(hit2, 0) ThenBlock: { ReturnValue(hit2) }
                }
            }
        }
        n = AST_GetChildCount(node)
        i = 0
        WhileLoop LessThan(i, n) {
            found = Optimize_ScanFltFind(AST_GetChild(node, i), body)
            IfCondition NotEqual(found, 0) ThenBlock: { ReturnValue(found) }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

// Spilled float used in this body, never assigned here. Highest
// reload cost wins. dt in Advance is a parameter the pool did not
// keep, so Find's compare walk misses it.
Function.Optimize_ScanFltSpillInv {
    Input: body: Address
    Output: Address
    Body: {
        IfCondition EqualTo(body, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(ScanState.flt, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(TagState.names, 0) ThenBlock: { ReturnValue(0) }
        best = 0
        best_cost = -1
        i = 1
        last = Add(TagState.nnames, 1)
        WhileLoop LessThan(i, last) {
            fb = GetByte(ScanState.flt, Subtract(i, 1))
            ok = 0
            IfCondition EqualTo(fb, 1) ThenBlock: { ok = 1 }
            IfCondition EqualTo(fb, 3) ThenBlock: { ok = 1 }
            IfCondition EqualTo(fb, 4) ThenBlock: { ok = 1 }
            IfCondition EqualTo(fb, 5) ThenBlock: { ok = 1 }
            IfCondition EqualTo(fb, 6) ThenBlock: { ok = 1 }
            IfCondition EqualTo(ok, 1) ThenBlock: {
                IfCondition EqualTo(Optimize_ScanReg(i), -1) ThenBlock: {
                    name = Dereference(Add(TagState.names, Multiply(Subtract(i, 1), 8)))
                    IfCondition EqualTo(Optimize_ScanAssigns(body, name), 0) ThenBlock: {
                        IfCondition EqualTo(Optimize_NodeReads(body, name), 1) ThenBlock: {
                            off = Scope_Resolve(name)
                            rt = Scope.resolve_type
                            frame = 0
                            IfCondition EqualTo(rt, 1) ThenBlock: { frame = 1 }
                            IfCondition EqualTo(rt, 2) ThenBlock: { frame = 1 }
                            IfCondition GreaterEqual(off, 0) ThenBlock: { frame = 0 }
                            IfCondition EqualTo(frame, 1) ThenBlock: {
                                c = Optimize_ScanSpillCost(i)
                                IfCondition GreaterThan(c, best_cost) ThenBlock: {
                                    best = name
                                    best_cost = c
                                }
                            }
                        }
                    }
                }
            }
            i = Add(i, 1)
        }
        ReturnValue(best)
    }
}

// Park one loop-invariant frame float in xmm2. The back edge jumps
// to the body, past this load, so the compare reads the register.
Function.Optimize_ScanFltArm {
    Input: cond: Address
    Input: body: Address
    Body: {
        IfCondition EqualTo(Optimize_ScanActive(), 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(ScanPtr.byte_iv, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(ScanPtr.byte_acc, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(ScanPtr.byte_keep, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(ScanPtr.byte_name, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_ScanTreeXmmKill(body), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_ScanTreeXmmKill(cond), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_ScanFltBlocked(body), 1) ThenBlock: { ReturnValue(0) }
        name = Optimize_ScanFltFind(body, body)
        IfCondition EqualTo(name, 0) ThenBlock: {
            name = Optimize_ScanFltFind(cond, body)
        }
        IfCondition EqualTo(name, 0) ThenBlock: {
            name = Optimize_ScanFltSpillInv(body)
        }
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }
        off = Scope_Resolve(name)
        X86_EmitRbpXmm(16, 2, off)
        ScanPtr.flt_keep = name
        ReturnValue(1)
    }
}

// The loop is done. xmm2 is scratch again. Pop reloads an outer park.
Function.Optimize_ScanFltDrop {
    Body: {
        ScanPtr.flt_keep = 0
        Optimize_ScanFltParkClear()
        ReturnValue(0)
    }
}

// Index register for [r14+index]. 0 = not a plain local.
// 1 = frame slot, caller loads it into rcx. 3/12/13 = already there.
Function.Optimize_ScanByteIdx {
    Input: node: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(node), AST.IDENTIFIER) ThenBlock: { ReturnValue(0) }
        name = AST_GetData1(node)
        id = Optimize_TagIntern(name)
        IfCondition NotEqual(id, 0) ThenBlock: {
            IfCondition EqualTo(Optimize_ScanMatGet(id), 1) ThenBlock: {
                reg = Optimize_ScanReg(id)
                IfCondition EqualTo(reg, Reg.RBX) ThenBlock: { ReturnValue(reg) }
                IfCondition EqualTo(reg, Reg.R12) ThenBlock: { ReturnValue(reg) }
                IfCondition EqualTo(reg, Reg.R13) ThenBlock: { ReturnValue(reg) }
            }
        }
        off = Scope_Resolve(name)
        rt = Scope.resolve_type
        ok = 0
        IfCondition EqualTo(rt, 1) ThenBlock: { ok = 1 }
        IfCondition EqualTo(rt, 2) ThenBlock: { ok = 1 }
        IfCondition GreaterEqual(off, 0) ThenBlock: { ok = 0 }
        IfCondition EqualTo(ok, 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(1)
    }
}

// Frame index into rcx. ScanByteIdx already accepted this name.
// The scan may have skipped the definition store, so write the home
// back before this load.
Function.Optimize_ScanByteLoad {
    Input: node: Address
    Body: {
        Optimize_ScanByteSlot(AST_GetData1(node))
        off = Scope_Resolve(AST_GetData1(node))
        X86_MovRcxRbpOffset(off)
        ReturnValue(0)
    }
}

// Register holding the hoisted byte base, or 0. r14 from Park,
// r11 from a nested-loop keep.
Function.Optimize_ScanByteBase {
    Input: node: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(node), AST.IDENTIFIER) ThenBlock: { ReturnValue(0) }
        name = AST_GetData1(node)
        IfCondition NotEqual(ScanPtr.byte_name, 0) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(name, ScanPtr.byte_name), 1) ThenBlock: {
                ReturnValue(14)
            }
        }
        IfCondition NotEqual(ScanPtr.byte_keep, 0) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(name, ScanPtr.byte_keep), 1) ThenBlock: {
                ReturnValue(11)
            }
        }
        ReturnValue(0)
    }
}

// MOVZX rax, byte [base+index] or [base+index+disp8].
Function.Optimize_ScanByteGet {
    Input: node: Address
    Output: Integer
    Body: {
        IfCondition LessThan(AST_GetChildCount(node), 2) ThenBlock: { ReturnValue(0) }
        breg = Optimize_ScanByteBase(AST_GetChild(node, 0))
        IfCondition EqualTo(breg, 0) ThenBlock: { ReturnValue(0) }
        idx = AST_GetChild(node, 1)
        disp = 0
        IfCondition EqualTo(AST_GetType(idx), AST.CALL) ThenBlock: {
            IfCondition EqualTo(StringCompare(AST_GetData1(idx), "Add"), 0) ThenBlock: {
                IfCondition EqualTo(AST_GetChildCount(idx), 2) ThenBlock: {
                    a0 = AST_GetChild(idx, 0)
                    a1 = AST_GetChild(idx, 1)
                    in_n = 0
                    in_i = 0
                    IfCondition NotEqual(a1, 0) ThenBlock: {
                        IfCondition EqualTo(AST_GetType(a1), AST.NUMBER) ThenBlock: {
                            IfCondition NotEqual(a0, 0) ThenBlock: {
                                IfCondition EqualTo(AST_GetType(a0), AST.IDENTIFIER) ThenBlock: {
                                    in_n = a1
                                    in_i = a0
                                }
                            }
                        }
                    }
                    IfCondition EqualTo(in_n, 0) ThenBlock: {
                        IfCondition NotEqual(a0, 0) ThenBlock: {
                            IfCondition EqualTo(AST_GetType(a0), AST.NUMBER) ThenBlock: {
                                IfCondition NotEqual(a1, 0) ThenBlock: {
                                    IfCondition EqualTo(AST_GetType(a1), AST.IDENTIFIER) ThenBlock: {
                                        in_n = a0
                                        in_i = a1
                                    }
                                }
                            }
                        }
                    }
                    IfCondition NotEqual(in_n, 0) ThenBlock: {
                        d = StringToNumber(AST_GetData1(in_n))
                        IfCondition GreaterThan(d, 0) ThenBlock: {
                            IfCondition LessThan(d, 128) ThenBlock: {
                                disp = d
                                idx = in_i
                            }
                        }
                    }
                }
            }
        }
        ireg = Optimize_ScanByteIdx(idx)
        IfCondition EqualTo(ireg, 0) ThenBlock: {
            IfCondition EqualTo(Compile_Expression(idx), 0) ThenBlock: { ReturnValue(0) }
            IfCondition EqualTo(disp, 0) ThenBlock: {
                X86_SibByte(1, breg, 0)
            } ElseBlock: {
                X86_SibByteDisp(1, breg, 0, disp)
            }
            ReturnValue(1)
        }
        IfCondition EqualTo(ireg, 1) ThenBlock: { Optimize_ScanByteLoad(idx) }
        IfCondition EqualTo(disp, 0) ThenBlock: {
            X86_SibByte(1, breg, ireg)
        } ElseBlock: {
            X86_SibByteDisp(1, breg, ireg, disp)
        }
        ReturnValue(1)
    }
}

// MOV byte [r14+index], imm8, or AL when the value is a local.
// 0 leaves the ordinary SetByte path. Nothing is emitted on the
// failure returns above the loads.
Function.Optimize_ScanByteSet {
    Input: node: Address
    Output: Integer
    Body: {
        IfCondition LessThan(AST_GetChildCount(node), 3) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(ScanPtr.byte_iv, 0) ThenBlock: {
            IfCondition EqualTo(Optimize_ScanByteBase(AST_GetChild(node, 0)), 0) ThenBlock: { ReturnValue(0) }
            idx = AST_GetChild(node, 1)
            IfCondition NotEqual(AST_GetType(idx), AST.IDENTIFIER) ThenBlock: { ReturnValue(0) }
            IfCondition EqualTo(Optimize_NameEq(AST_GetData1(idx), ScanPtr.byte_iv), 0) ThenBlock: { ReturnValue(0) }
            val = AST_GetChild(node, 2)
            IfCondition NotEqual(AST_GetType(val), AST.NUMBER) ThenBlock: { ReturnValue(0) }
            IfCondition NotEqual(StringToNumber(AST_GetData1(val)), ScanPtr.byte_imm) ThenBlock: { ReturnValue(0) }
            X86_MovByteDerefR14Imm(ScanPtr.byte_imm)
            ReturnValue(1)
        }
        sb = Optimize_ScanByteBase(AST_GetChild(node, 0))
        IfCondition EqualTo(sb, 0) ThenBlock: { ReturnValue(0) }
        idx = AST_GetChild(node, 1)
        ireg = Optimize_ScanByteIdx(idx)
        IfCondition EqualTo(ireg, 0) ThenBlock: { ReturnValue(0) }
        val = AST_GetChild(node, 2)
        IfCondition EqualTo(val, 0) ThenBlock: { ReturnValue(0) }
        vt = AST_GetType(val)
        IfCondition EqualTo(vt, AST.NUMBER) ThenBlock: {
            n = StringToNumber(AST_GetData1(val))
            IfCondition LessThan(n, 0) ThenBlock: { ReturnValue(0) }
            IfCondition GreaterThan(n, 255) ThenBlock: { ReturnValue(0) }
            IfCondition EqualTo(ireg, 1) ThenBlock: { Optimize_ScanByteLoad(idx) }
            X86_SibByteImm(sb, ireg, n)
            ReturnValue(1)
        }
        IfCondition NotEqual(vt, AST.IDENTIFIER) ThenBlock: { ReturnValue(0) }
        vname = AST_GetData1(val)
        vid = Optimize_TagIntern(vname)
        vreg = 0
        IfCondition NotEqual(vid, 0) ThenBlock: {
            IfCondition EqualTo(Optimize_ScanMatGet(vid), 1) ThenBlock: {
                reg = Optimize_ScanReg(vid)
                IfCondition EqualTo(reg, Reg.RBX) ThenBlock: { vreg = reg }
                IfCondition EqualTo(reg, Reg.R12) ThenBlock: { vreg = reg }
                IfCondition EqualTo(reg, Reg.R13) ThenBlock: { vreg = reg }
            }
        }
        voff = 0
        vframe = 0
        IfCondition EqualTo(vreg, 0) ThenBlock: {
            voff = Scope_Resolve(vname)
            rt = Scope.resolve_type
            IfCondition EqualTo(rt, 1) ThenBlock: { vframe = 1 }
            IfCondition EqualTo(rt, 2) ThenBlock: { vframe = 1 }
            IfCondition GreaterEqual(voff, 0) ThenBlock: { vframe = 0 }
            IfCondition EqualTo(vframe, 0) ThenBlock: { ReturnValue(0) }
        }
        IfCondition NotEqual(vreg, 0) ThenBlock: {
            Emit_MovRegReg(Reg.RAX, vreg)
        } ElseBlock: {
            Optimize_ScanByteSlot(vname)
            Emit_MovRaxRbpOffset(voff)
        }
        IfCondition EqualTo(ireg, 1) ThenBlock: { Optimize_ScanByteLoad(idx) }
        X86_SibByte(2, sb, ireg)
        ReturnValue(1)
    }
}

// iv = iv + step. r14 already holds base+iv, so the add steps the pointer
// and the frame copy of iv stays put until the loop exits.
Function.Optimize_ScanByteBump {
    Input: name: Address
    Input: value: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(ScanPtr.byte_iv, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(ScanPtr.byte_acc, 0) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(name, ScanPtr.byte_iv), 1) ThenBlock: {
                X86_AddR14One()
                ReturnValue(1)
            }
            ReturnValue(0)
        }
        IfCondition EqualTo(Optimize_NameEq(name, ScanPtr.byte_iv), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(value, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(value), AST.CALL) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(StringCompare(AST_GetData1(value), "Add"), 0) ThenBlock: { ReturnValue(0) }
        sid = Optimize_TagIntern(ScanPtr.byte_step)
        sreg = 0
        IfCondition EqualTo(Optimize_ScanMatGet(sid), 1) ThenBlock: {
            reg = Optimize_ScanReg(sid)
            IfCondition EqualTo(reg, Reg.RBX) ThenBlock: { sreg = reg }
            IfCondition EqualTo(reg, Reg.R12) ThenBlock: { sreg = reg }
            IfCondition EqualTo(reg, Reg.R13) ThenBlock: { sreg = reg }
        }
        IfCondition NotEqual(sreg, 0) ThenBlock: {
            Optimize_ScanByteAdd(sreg)
            ReturnValue(1)
        }
        Optimize_ScanByteSlot(ScanPtr.byte_step)
        soff = Scope_Resolve(ScanPtr.byte_step)
        X86_MovRcxRbpOffset(soff)
        Optimize_ScanByteAdd(1)
        ReturnValue(1)
    }
}

// One byte of the sum. rbx is the accumulator and r14 is the cursor.
Function.Optimize_ScanByteAcc {
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(ScanPtr.byte_acc, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_NameEq(name, ScanPtr.byte_acc), 0) ThenBlock: { ReturnValue(0) }
        X86_MovzxRaxByteR14()
        Emit_Byte(0x48)
        Emit_Byte(0x01)
        Emit_Byte(0xC3)
        ReturnValue(1)
    }
}

// The frame slot was just written with the repaired value. Drop the
// scan bit without spilling: a spill would store the old register
// over that slot. The next read reloads the frame.
Function.Optimize_ScanByteMatDrop {
    Input: name: Address
    Body: {
        id = Optimize_TagIntern(name)
        IfCondition EqualTo(id, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_ScanMatGet(id), 1) ThenBlock: {
            Optimize_VerifyEnd(id)
        }
        SetByte(ScanState.mat, Subtract(id, 1), 0)
        ReturnValue(0)
    }
}

// iv = r14 - base, and the sum accumulator is written back from rbx.
// The entry test jumped to the loop end and skipped this, so a
// zero-trip loop keeps the values it already had.
Function.Optimize_ScanByteRepair {
    Body: {
        IfCondition EqualTo(ScanPtr.byte_iv, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(ScanPtr.byte_acc, 0) ThenBlock: {
            Emit_MovRegReg(Reg.RAX, Reg.RBX)
            aoff = Scope_Resolve(ScanPtr.byte_acc)
            Emit_MovRbpOffsetRax(aoff)
            Optimize_ScanByteMatDrop(ScanPtr.byte_acc)
        }
        Emit_MovRegReg(Reg.RAX, Reg.R14)
        off = Scope_Resolve(ScanPtr.byte_name)
        X86_MovRcxRbpOffset(off)
        X86Enc_Assemble("SUB rax, rcx")
        voff = Scope_Resolve(ScanPtr.byte_iv)
        Emit_MovRbpOffsetRax(voff)
        Optimize_ScanByteMatDrop(ScanPtr.byte_iv)
        ReturnValue(0)
    }
}

// t = inv + iv, with iv stepping by a positive constant after t is
// defined. r11 holds t. The assignment itself emits nothing.
Function.Optimize_ScanRunArm {
    Input: body: Address
    Body: {
        IfCondition EqualTo(Optimize_ScanActive(), 0) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterThan(ScanPtr.n, 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(LoopHome.ip0_on, 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(LoopHome.ip1_on, 1) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(ScanPtr.byte_iv, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(body, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(body), AST.BLOCK) ThenBlock: { ReturnValue(0) }
        n = AST_GetChildCount(body)
        inc_name = 0
        inc_n = 0
        inc_at = -1
        inc_step = 0
        i = 0
        WhileLoop LessThan(i, n) {
            st = AST_GetChild(body, i)
            step = Optimize_ScanSelfStep(st)
            IfCondition GreaterThan(step, 0) ThenBlock: {
                inc_n = Add(inc_n, 1)
                inc_name = AST_GetData1(st)
                inc_at = i
                inc_step = step
            }
            i = Add(i, 1)
        }
        IfCondition NotEqual(inc_n, 1) ThenBlock: { ReturnValue(0) }
        got = 0
        bad = 0
        def_at = -1
        tname = 0
        inv = 0
        i = 0
        WhileLoop LessThan(i, n) {
            st = AST_GetChild(body, i)
            IfCondition EqualTo(Optimize_PlainAssign(st), 1) ThenBlock: {
                IfCondition EqualTo(Optimize_ScanAddIds(AST_GetChild(st, 0)), 1) ThenBlock: {
                    an = AST_GetData1(ScanPtr.sbase)
                    bn = AST_GetData1(ScanPtr.siv)
                    other = 0
                    IfCondition EqualTo(Optimize_NameEq(an, inc_name), 1) ThenBlock: { other = bn }
                    IfCondition EqualTo(Optimize_NameEq(bn, inc_name), 1) ThenBlock: { other = an }
                    IfCondition NotEqual(other, 0) ThenBlock: {
                        IfCondition EqualTo(got, 1) ThenBlock: { bad = 1 }
                        got = 1
                        tname = AST_GetData1(st)
                        inv = other
                        def_at = i
                    }
                }
            }
            i = Add(i, 1)
        }
        IfCondition EqualTo(bad, 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(got, 0) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterThan(def_at, inc_at) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_ScanAssigns(body, inv), 1) ThenBlock: { ReturnValue(0) }
        inv_reg = Optimize_ScanAddrBase(inv)
        iv_reg = Optimize_ScanAddrBase(inc_name)
        IfCondition EqualTo(inv_reg, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(iv_reg, 0) ThenBlock: { ReturnValue(0) }
        // The init uses rbx as scratch. A live home there would be lost.
        k = 1
        WhileLoop LessThan(k, Add(TagState.nnames, 1)) {
            IfCondition EqualTo(Optimize_ScanReg(k), Reg.RBX) ThenBlock: {
                IfCondition EqualTo(Optimize_ScanMatGet(k), 1) ThenBlock: { ReturnValue(0) }
            }
            k = Add(k, 1)
        }
        Emit_MovRegReg(Reg.RAX, inv_reg)
        Emit_MovRegReg(Reg.RBX, iv_reg)
        Emit_AddRaxRbx()
        Emit_MovRegReg(Reg.R11, Reg.RAX)
        ScanPtr.run_name = tname
        ScanPtr.run_iv = inc_name
        ScanPtr.run_inv = inv
        ScanPtr.run_step = inc_step
        ReturnValue(1)
    }
}

// Direct assignment name = Add(ident, positive). Returns the constant
// and leaves the ident in sbase. 0 when that is not the whole value.
Function.Optimize_ScanDefAdd {
    Input: block: Address
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(block, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(block), AST.BLOCK) ThenBlock: { ReturnValue(0) }
        n = AST_GetChildCount(block)
        found = 0
        step = 0
        i = 0
        WhileLoop LessThan(i, n) {
            st = AST_GetChild(block, i)
            IfCondition EqualTo(Optimize_PlainAssign(st), 1) ThenBlock: {
                IfCondition EqualTo(Optimize_NameEq(AST_GetData1(st), name), 1) ThenBlock: {
                    val = AST_GetChild(st, 0)
                    stv = 0
                    IfCondition NotEqual(val, 0) ThenBlock: {
                        IfCondition EqualTo(AST_GetType(val), AST.CALL) ThenBlock: {
                            IfCondition EqualTo(StringCompare(AST_GetData1(val), "Add"), 0) ThenBlock: {
                                IfCondition EqualTo(AST_GetChildCount(val), 2) ThenBlock: {
                                    c0 = AST_GetChild(val, 0)
                                    c1 = AST_GetChild(val, 1)
                                    num = 0
                                    ident = 0
                                    IfCondition NotEqual(c1, 0) ThenBlock: {
                                        IfCondition EqualTo(AST_GetType(c1), AST.NUMBER) ThenBlock: {
                                            num = c1
                                            ident = c0
                                        }
                                    }
                                    IfCondition EqualTo(num, 0) ThenBlock: {
                                        IfCondition NotEqual(c0, 0) ThenBlock: {
                                            IfCondition EqualTo(AST_GetType(c0), AST.NUMBER) ThenBlock: {
                                                num = c0
                                                ident = c1
                                            }
                                        }
                                    }
                                    IfCondition NotEqual(num, 0) ThenBlock: {
                                        IfCondition NotEqual(ident, 0) ThenBlock: {
                                            IfCondition EqualTo(AST_GetType(ident), AST.IDENTIFIER) ThenBlock: {
                                                IfCondition EqualTo(Optimize_NameEq(AST_GetData1(ident), name), 0) ThenBlock: {
                                                    stv = StringToNumber(AST_GetData1(num))
                                                    ScanPtr.sbase = ident
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                    IfCondition EqualTo(found, 1) ThenBlock: { ReturnValue(0) }
                    found = 1
                    step = stv
                }
            }
            i = Add(i, 1)
        }
        IfCondition LessEqual(step, 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(step)
    }
}

// 1 when LEA rax, [reg+rax+disp] can use this base. r12 and r13 survive
// a call and the integer scratch. rbx and the caller-saved homes do
// not, so they are allowed only when the other arm is a plain load.
Function.Optimize_ScanLeaOk {
    Input: reg: Integer
    Input: other: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(reg, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(reg, Reg.R12) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(reg, Reg.R13) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(other, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(other), AST.IDENTIFIER) ThenBlock: { ReturnValue(0) }
        ok = 0
        IfCondition EqualTo(reg, Reg.RBX) ThenBlock: { ok = 1 }
        IfCondition EqualTo(reg, Reg.RDX) ThenBlock: { ok = 1 }
        IfCondition EqualTo(reg, Reg.RSI) ThenBlock: { ok = 1 }
        IfCondition EqualTo(reg, Reg.RDI) ThenBlock: { ok = 1 }
        IfCondition EqualTo(reg, Reg.R8) ThenBlock: { ok = 1 }
        IfCondition EqualTo(reg, Reg.R9) ThenBlock: { ok = 1 }
        IfCondition EqualTo(reg, Reg.R10) ThenBlock: { ok = 1 }
        ReturnValue(ok)
    }
}

// The scan skipped StoreVariable. Write the frame the way that path
// would, including a first-seen local. Pool fields stay on r15.
Function.Optimize_ScanFramePut {
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }
        off = Scope_Resolve(name)
        rt = Scope.resolve_type
        IfCondition EqualTo(rt, 0) ThenBlock: {
            Compile.stack_offset = Add(Compile.stack_offset, 8)
            off = Subtract(0, Compile.stack_offset)
            Compile_RegisterLocal(name, off)
            rt = 1
        }
        IfCondition EqualTo(rt, 3) ThenBlock: { ReturnValue(0) }
        Emit_MovRbpOffsetRax(off)
        Optimize_RaxStored(name, off)
        ReturnValue(1)
    }
}

// 1 when ScanFramePut has somewhere to put rax. A pool field does not.
Function.Optimize_ScanCanFrame {
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }
        Scope_Resolve(name)
        IfCondition EqualTo(Scope.resolve_type, 3) ThenBlock: { ReturnValue(0) }
        ReturnValue(1)
    }
}

// Add(other, name) where name was defined as base+k and base is in
// a scan address home. Leaves the sum in rax. Used when the add is an
// expression, not a statement the assignment hook can see.
// 1 and sbase set when node is Add(ident, positive constant).
Function.Optimize_ScanLeaLeaf {
    Input: node: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(node), AST.CALL) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(StringCompare(AST_GetData1(node), "Add"), 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetChildCount(node), 2) ThenBlock: { ReturnValue(0) }
        c0 = AST_GetChild(node, 0)
        c1 = AST_GetChild(node, 1)
        num = 0
        ident = 0
        IfCondition NotEqual(c1, 0) ThenBlock: {
            IfCondition EqualTo(AST_GetType(c1), AST.NUMBER) ThenBlock: {
                num = c1
                ident = c0
            }
        }
        IfCondition EqualTo(num, 0) ThenBlock: {
            IfCondition NotEqual(c0, 0) ThenBlock: {
                IfCondition EqualTo(AST_GetType(c0), AST.NUMBER) ThenBlock: {
                    num = c0
                    ident = c1
                }
            }
        }
        IfCondition EqualTo(num, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(ident, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(ident), AST.IDENTIFIER) ThenBlock: { ReturnValue(0) }
        st = StringToNumber(AST_GetData1(num))
        IfCondition LessEqual(st, 0) ThenBlock: { ReturnValue(0) }
        ScanPtr.sbase = ident
        ReturnValue(st)
    }
}

Function.Optimize_ScanLeaExpr {
    Input: node: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(Optimize_ScanActive(), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(node), AST.CALL) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(StringCompare(AST_GetData1(node), "Add"), 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetChildCount(node), 2) ThenBlock: { ReturnValue(0) }
        a0 = AST_GetChild(node, 0)
        a1 = AST_GetChild(node, 1)
        other = 0
        step = Optimize_ScanLeaLeaf(a1)
        IfCondition GreaterThan(step, 0) ThenBlock: { other = a0 }
        IfCondition EqualTo(step, 0) ThenBlock: {
            step = Optimize_ScanLeaLeaf(a0)
            IfCondition GreaterThan(step, 0) ThenBlock: { other = a1 }
        }
        IfCondition EqualTo(step, 0) ThenBlock: {
            addend = 0
            IfCondition NotEqual(a1, 0) ThenBlock: {
                IfCondition EqualTo(AST_GetType(a1), AST.IDENTIFIER) ThenBlock: {
                    addend = a1
                    other = a0
                }
            }
            IfCondition EqualTo(addend, 0) ThenBlock: {
                IfCondition NotEqual(a0, 0) ThenBlock: {
                    IfCondition EqualTo(AST_GetType(a0), AST.IDENTIFIER) ThenBlock: {
                        addend = a0
                        other = a1
                    }
                }
            }
            IfCondition NotEqual(addend, 0) ThenBlock: {
                step = Optimize_ScanDefAdd(OutKeep.block, AST_GetData1(addend))
            }
        }
        IfCondition EqualTo(step, 0) ThenBlock: { ReturnValue(0) }
        base = ScanPtr.sbase
        IfCondition EqualTo(base, 0) ThenBlock: { ReturnValue(0) }
        bname = AST_GetData1(base)
        reg = Optimize_ScanAddrBase(bname)
        IfCondition EqualTo(Optimize_ScanLeaOk(reg, other), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(other, 0) ThenBlock: { ReturnValue(0) }
        got = Compile_Expression(other)
        IfCondition EqualTo(got, 0) ThenBlock: { ReturnValue(0) }
        X86_LeaRaxHome(reg, step)
        ReturnValue(1)
    }
}

// den = tri + (base + k). r12 and r13 may add any other arm. A caller-saved
// base or rbx is only safe when the other arm is a load: a call or a
// math scratch would kill it before the lea. A hold of 0 reloads from
// the frame next iteration, so that path writes the slot too.
Function.Optimize_ScanLeaSum {
    Input: target: Address
    Input: value: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(Optimize_ScanActive(), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(value, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(value), AST.CALL) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(StringCompare(AST_GetData1(value), "Add"), 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetChildCount(value), 2) ThenBlock: { ReturnValue(0) }
        a0 = AST_GetChild(value, 0)
        a1 = AST_GetChild(value, 1)
        addend = 0
        other = 0
        IfCondition NotEqual(a1, 0) ThenBlock: {
            IfCondition EqualTo(AST_GetType(a1), AST.IDENTIFIER) ThenBlock: {
                addend = a1
                other = a0
            }
        }
        IfCondition EqualTo(addend, 0) ThenBlock: {
            IfCondition NotEqual(a0, 0) ThenBlock: {
                IfCondition EqualTo(AST_GetType(a0), AST.IDENTIFIER) ThenBlock: {
                    addend = a0
                    other = a1
                }
            }
        }
        IfCondition EqualTo(addend, 0) ThenBlock: { ReturnValue(0) }
        step = Optimize_ScanDefAdd(OutKeep.block, AST_GetData1(addend))
        IfCondition EqualTo(step, 0) ThenBlock: { ReturnValue(0) }
        base = ScanPtr.sbase
        IfCondition EqualTo(base, 0) ThenBlock: { ReturnValue(0) }
        bname = AST_GetData1(base)
        reg = Optimize_ScanAddrBase(bname)
        IfCondition EqualTo(Optimize_ScanLeaOk(reg, other), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(other, 0) ThenBlock: { ReturnValue(0) }
        got = Compile_Expression(other)
        IfCondition EqualTo(got, 0) ThenBlock: {
            Compile.error = 1
            ReturnValue(1)
        }
        X86_LeaRaxHome(reg, step)
        Optimize_RaxPin(target, 0)
        IfCondition EqualTo(Optimize_ScanHold(target), 1) ThenBlock: {
            Optimize_ScanNoteStore(target)
        } ElseBlock: {
            Optimize_ScanFramePut(target)
            Optimize_ScanNoteStore(target)
        }
        ReturnValue(1)
    }
}

// Name of an identifier node, or 0.
Function.Optimize_ScanIdentName {
    Input: node: Address
    Output: Address
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(node), AST.IDENTIFIER) ThenBlock: { ReturnValue(0) }
        ReturnValue(AST_GetData1(node))
    }
}

// 1 when node is Add(name, 1) or Add(1, name). The name is not the
// assignment target. Returns that name. Step is exactly 1: x*(x+1)
// is the even product a floor sar can divide.
Function.Optimize_ScanPlus1 {
    Input: node: Address
    Output: Address
    Body: {
        st = Optimize_ScanLeaLeaf(node)
        IfCondition NotEqual(st, 1) ThenBlock: { ReturnValue(0) }
        base = ScanPtr.sbase
        IfCondition EqualTo(base, 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(AST_GetData1(base))
    }
}

// 1 when node is Multiply of these two names, either order.
Function.Optimize_ScanTriMul {
    Input: node: Address
    Input: left_name: Address
    Input: right_name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(node), AST.CALL) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(StringCompare(AST_GetData1(node), "Multiply"), 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetChildCount(node), 2) ThenBlock: { ReturnValue(0) }
        a = Optimize_ScanIdentName(AST_GetChild(node, 0))
        b = Optimize_ScanIdentName(AST_GetChild(node, 1))
        IfCondition EqualTo(a, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(b, 0) ThenBlock: { ReturnValue(0) }
        hit = 0
        IfCondition EqualTo(Optimize_NameEq(a, left_name), 1) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(b, right_name), 1) ThenBlock: { hit = 1 }
        }
        IfCondition EqualTo(Optimize_NameEq(a, right_name), 1) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(b, left_name), 1) ThenBlock: { hit = 1 }
        }
        ReturnValue(hit)
    }
}

// 1 when node is Divide(Multiply(ij, ij1), 2), either multiply order.
Function.Optimize_ScanTriDiv {
    Input: node: Address
    Input: ij: Address
    Input: ij1: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(node), AST.CALL) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(StringCompare(AST_GetData1(node), "Divide"), 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetChildCount(node), 2) ThenBlock: { ReturnValue(0) }
        num = AST_GetChild(node, 1)
        IfCondition EqualTo(num, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(num), AST.NUMBER) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(StringToNumber(AST_GetData1(num)), 2) ThenBlock: { ReturnValue(0) }
        ReturnValue(Optimize_ScanTriMul(AST_GetChild(node, 0), ij, ij1))
    }
}

// 1 when node is Add of these two names, either order.
Function.Optimize_ScanAddPair {
    Input: node: Address
    Input: left_name: Address
    Input: right_name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(node), AST.CALL) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(StringCompare(AST_GetData1(node), "Add"), 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetChildCount(node), 2) ThenBlock: { ReturnValue(0) }
        a = Optimize_ScanIdentName(AST_GetChild(node, 0))
        b = Optimize_ScanIdentName(AST_GetChild(node, 1))
        IfCondition EqualTo(a, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(b, 0) ThenBlock: { ReturnValue(0) }
        hit = 0
        IfCondition EqualTo(Optimize_NameEq(a, left_name), 1) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(b, right_name), 1) ThenBlock: { hit = 1 }
        }
        IfCondition EqualTo(Optimize_NameEq(a, right_name), 1) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(b, left_name), 1) ThenBlock: { hit = 1 }
        }
        ReturnValue(hit)
    }
}

// Register that holds this name now. The running ij lives in r11 even
// when it has no scan home. rax is not a value home, so 0 means none.
Function.Optimize_ScanSrcReg {
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(ScanPtr.run_name, 0) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(name, ScanPtr.run_name), 1) ThenBlock: {
                ReturnValue(Reg.R11)
            }
        }
        id = Optimize_TagIntern(name)
        IfCondition LessThan(id, 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_ScanMatGet(id), 0) ThenBlock: { ReturnValue(0) }
        reg = Optimize_ScanReg(id)
        IfCondition LessThan(Optimize_ScanXmm(reg), 0) ThenBlock: {
            ok = 0
            IfCondition EqualTo(reg, Reg.RBX) ThenBlock: { ok = 1 }
            IfCondition EqualTo(reg, Reg.RCX) ThenBlock: { ok = 1 }
            IfCondition EqualTo(reg, Reg.RDX) ThenBlock: { ok = 1 }
            IfCondition EqualTo(reg, Reg.RSI) ThenBlock: { ok = 1 }
            IfCondition EqualTo(reg, Reg.RDI) ThenBlock: { ok = 1 }
            IfCondition EqualTo(reg, Reg.R8) ThenBlock: { ok = 1 }
            IfCondition EqualTo(reg, Reg.R9) ThenBlock: { ok = 1 }
            IfCondition EqualTo(reg, Reg.R10) ThenBlock: { ok = 1 }
            IfCondition EqualTo(reg, Reg.R11) ThenBlock: { ok = 1 }
            IfCondition EqualTo(reg, Reg.R12) ThenBlock: { ok = 1 }
            IfCondition EqualTo(reg, Reg.R13) ThenBlock: { ok = 1 }
            IfCondition EqualTo(ok, 1) ThenBlock: { ReturnValue(reg) }
        }
        ReturnValue(0)
    }
}

// Identifier uses of name, not counting an assignment's left side.
// Stops counting at 2. The result is in ScanPtr.id_n.
Function.Optimize_ScanIdAdd {
    Input: node: Address
    Input: name: Address
    Body: {
        IfCondition GreaterEqual(ScanPtr.id_n, 2) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(AST_GetType(node), AST.IDENTIFIER) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(AST_GetData1(node), name), 1) ThenBlock: {
                ScanPtr.id_n = Add(ScanPtr.id_n, 1)
            }
        }
        IfCondition GreaterEqual(ScanPtr.id_n, 2) ThenBlock: { ReturnValue(0) }
        count = AST_GetChildCount(node)
        i = 0
        WhileLoop LessThan(i, count) {
            IfCondition GreaterEqual(ScanPtr.id_n, 2) ThenBlock: { ReturnValue(0) }
            Optimize_ScanIdAdd(AST_GetChild(node, i), name)
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

// 1 when the function mentions this name as an identifier exactly once.
Function.Optimize_ScanIdOnce {
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Compile.current_func, 0) ThenBlock: { ReturnValue(0) }
        ScanPtr.id_n = 0
        Optimize_ScanIdAdd(Compile.current_func, name)
        IfCondition EqualTo(ScanPtr.id_n, 1) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

// Index of the plain assignment name = value in this block, or -1.
Function.Optimize_ScanFindAsg {
    Input: block: Address
    Input: name: Address
    Input: value: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(block, 0) ThenBlock: { ReturnValue(-1) }
        n = AST_GetChildCount(block)
        i = 0
        WhileLoop LessThan(i, n) {
            st = AST_GetChild(block, i)
            IfCondition EqualTo(Optimize_PlainAssign(st), 1) ThenBlock: {
                IfCondition EqualTo(Optimize_NameEq(AST_GetData1(st), name), 1) ThenBlock: {
                    IfCondition EqualTo(AST_GetChild(st, 0), value) ThenBlock: { ReturnValue(i) }
                }
            }
            i = Add(i, 1)
        }
        ReturnValue(-1)
    }
}

// 1 when the next statement is the fused float consumer that reads den
// before any rax drop. Pin-only is safe then. A later use needs a store.
Function.Optimize_ScanDenFused {
    Input: node: Address
    Input: den: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(node), AST.CALL) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(StringCompare(AST_GetData1(node), "Float_Mul"), 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetChildCount(node), 2) ThenBlock: { ReturnValue(0) }
        left = AST_GetChild(node, 0)
        right = AST_GetChild(node, 1)
        IfCondition EqualTo(left, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(left), AST.CALL) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(StringCompare(AST_GetData1(left), "Float_Div"), 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetChildCount(left), 2) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(right, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(right), AST.CALL) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(StringCompare(AST_GetData1(right), "Dereference"), 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetChildCount(right), 1) ThenBlock: { ReturnValue(0) }
        d0 = AST_GetChild(left, 0)
        d1 = AST_GetChild(left, 1)
        IfCondition EqualTo(d1, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(d1), AST.CALL) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(StringCompare(AST_GetData1(d1), "Float_FromInt"), 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetChildCount(d1), 1) ThenBlock: { ReturnValue(0) }
        ch = Optimize_ScanIdentName(AST_GetChild(d1, 0))
        IfCondition EqualTo(Optimize_NameEq(ch, den), 0) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(Optimize_ScanFltSrc(d0), 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(1)
    }
}

Function.Optimize_ScanDenPin {
    Input: block: Address
    Input: di: Integer
    Input: den: Address
    Output: Integer
    Body: {
        IfCondition GreaterThan(PinDefer.n, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_ScanIdOnce(den), 0) ThenBlock: { ReturnValue(0) }
        n = AST_GetChildCount(block)
        nxt = Add(di, 1)
        IfCondition GreaterEqual(nxt, n) ThenBlock: { ReturnValue(0) }
        st = AST_GetChild(block, nxt)
        IfCondition EqualTo(Optimize_PlainAssign(st), 0) ThenBlock: { ReturnValue(0) }
        tid = Optimize_TagIntern(AST_GetData1(st))
        IfCondition LessThan(tid, 1) ThenBlock: { ReturnValue(0) }
        slot = Optimize_ScanXmm(Optimize_ScanReg(tid))
        IfCondition LessThan(slot, 2) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_ScanDenFused(AST_GetChild(st, 0), den), 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(1)
    }
}

// 1 when statements di-3..di are ij1 = ij+1, tri = ij*(ij+1)/2,
// plus = base+1, den = tri+plus. Fills the tri_* scratch. Does not emit.
Function.Optimize_ScanDenMatch {
    Input: di: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(Optimize_ScanActive(), 0) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(di, 3) ThenBlock: { ReturnValue(0) }
        block = OutKeep.block
        IfCondition EqualTo(block, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(block), AST.BLOCK) ThenBlock: { ReturnValue(0) }
        n = AST_GetChildCount(block)
        IfCondition GreaterEqual(di, n) ThenBlock: { ReturnValue(0) }
        s0 = AST_GetChild(block, Subtract(di, 3))
        s1 = AST_GetChild(block, Subtract(di, 2))
        s2 = AST_GetChild(block, Subtract(di, 1))
        s3 = AST_GetChild(block, di)
        IfCondition EqualTo(Optimize_PlainAssign(s0), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_PlainAssign(s1), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_PlainAssign(s2), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_PlainAssign(s3), 0) ThenBlock: { ReturnValue(0) }
        n_ij1 = AST_GetData1(s0)
        n_tri = AST_GetData1(s1)
        n_plus = AST_GetData1(s2)
        n_den = AST_GetData1(s3)
        ij_name = Optimize_ScanPlus1(AST_GetChild(s0, 0))
        IfCondition EqualTo(ij_name, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_NameEq(ij_name, n_ij1), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_ScanTriDiv(AST_GetChild(s1, 0), ij_name, n_ij1), 0) ThenBlock: { ReturnValue(0) }
        plus_base = Optimize_ScanPlus1(AST_GetChild(s2, 0))
        IfCondition EqualTo(plus_base, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_NameEq(plus_base, n_plus), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_ScanAddPair(AST_GetChild(s3, 0), n_tri, n_plus), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_NameEq(n_ij1, n_tri), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_NameEq(n_ij1, n_plus), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_NameEq(n_tri, n_plus), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_NameEq(n_den, n_ij1), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_NameEq(n_den, n_tri), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_NameEq(n_den, n_plus), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_Fit32(1), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_ScanRbxMat(), 1) ThenBlock: { ReturnValue(0) }
        src = Optimize_ScanSrcReg(ij_name)
        IfCondition EqualTo(src, 0) ThenBlock: { ReturnValue(0) }
        breg = Optimize_ScanAddrBase(plus_base)
        IfCondition EqualTo(breg, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_ScanIdOnce(n_ij1), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_ScanIdOnce(n_tri), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_ScanIdOnce(n_plus), 0) ThenBlock: { ReturnValue(0) }
        pin = Optimize_ScanDenPin(block, di, n_den)
        IfCondition EqualTo(pin, 0) ThenBlock: {
            IfCondition EqualTo(Optimize_ScanHold(n_den), 0) ThenBlock: {
                IfCondition EqualTo(Optimize_ScanCanFrame(n_den), 0) ThenBlock: {
                    id = Optimize_TagIntern(n_den)
                    reg = -1
                    IfCondition GreaterThan(id, 0) ThenBlock: { reg = Optimize_ScanReg(id) }
                    IfCondition EqualTo(reg, -1) ThenBlock: { ReturnValue(0) }
                }
            }
        }
        ScanPtr.tri_src = src
        ScanPtr.tri_base = breg
        ScanPtr.tri_disp = 1
        ScanPtr.tri_pin = pin
        ScanPtr.tri_ij = ij_name
        ScanPtr.tri_ij1 = n_ij1
        ScanPtr.tri_tri = n_tri
        ScanPtr.tri_plus = n_plus
        ReturnValue(1)
    }
}

// Emit mov, lea rbx, imul, sar, lea. Pin den. Store it unless the only
// use is the next fused float consumer, which reads rax first.
Function.Optimize_ScanTriDen {
    Input: target: Address
    Input: value: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(Optimize_ScanActive(), 0) ThenBlock: { ReturnValue(0) }
        block = OutKeep.block
        IfCondition EqualTo(block, 0) ThenBlock: { ReturnValue(0) }
        di = Optimize_ScanFindAsg(block, target, value)
        IfCondition LessThan(di, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_ScanDenMatch(di), 0) ThenBlock: { ReturnValue(0) }
        src = ScanPtr.tri_src
        breg = ScanPtr.tri_base
        disp = ScanPtr.tri_disp
        pin = ScanPtr.tri_pin
        Optimize_RaxDrop()
        IfCondition NotEqual(src, Reg.RAX) ThenBlock: {
            Emit_MovRegReg(Reg.RAX, src)
        }
        X86_LeaRbxRax(1)
        Emit_ImulRaxRbx()
        Emit_SarRaxImm8(1)
        X86_LeaRaxHome(breg, disp)
        Optimize_RaxPin(target, 0)
        IfCondition EqualTo(pin, 0) ThenBlock: {
            IfCondition EqualTo(Optimize_ScanHold(target), 1) ThenBlock: {
                Optimize_ScanNoteStore(target)
            } ElseBlock: {
                Optimize_ScanFramePut(target)
                Optimize_ScanNoteStore(target)
            }
        }
        ReturnValue(1)
    }
}

// Skip ij1, tri, and the +1 temp when the denominator three statements
// ahead will emit them. Does not drop rax: the fused pin must survive
// a skipped producer, and these producers run before that pin.
Function.Optimize_ScanFoldSkip {
    Input: name: Address
    Input: value: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(Optimize_ScanActive(), 0) ThenBlock: { ReturnValue(0) }
        block = OutKeep.block
        IfCondition EqualTo(block, 0) ThenBlock: { ReturnValue(0) }
        at = Optimize_ScanFindAsg(block, name, value)
        IfCondition LessThan(at, 0) ThenBlock: { ReturnValue(0) }
        n = AST_GetChildCount(block)
        k = 1
        WhileLoop LessEqual(k, 3) {
            di = Add(at, k)
            IfCondition LessThan(di, n) ThenBlock: {
                IfCondition EqualTo(Optimize_ScanDenMatch(di), 1) ThenBlock: {
                    hit = 0
                    IfCondition EqualTo(Optimize_NameEq(name, ScanPtr.tri_ij1), 1) ThenBlock: { hit = 1 }
                    IfCondition EqualTo(Optimize_NameEq(name, ScanPtr.tri_tri), 1) ThenBlock: { hit = 1 }
                    IfCondition EqualTo(Optimize_NameEq(name, ScanPtr.tri_plus), 1) ThenBlock: { hit = 1 }
                    IfCondition EqualTo(hit, 1) ThenBlock: { ReturnValue(1) }
                }
            }
            k = Add(k, 1)
        }
        ReturnValue(0)
    }
}

// The running sum is already in r11. Skip the add.
Function.Optimize_ScanRunDef {
    Input: name: Address
    Input: value: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(ScanPtr.run_name, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_NameEq(name, ScanPtr.run_name), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_ScanAddIds(value), 0) ThenBlock: { ReturnValue(0) }
        an = AST_GetData1(ScanPtr.sbase)
        bn = AST_GetData1(ScanPtr.siv)
        hit = 0
        IfCondition EqualTo(Optimize_NameEq(an, ScanPtr.run_iv), 1) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(bn, ScanPtr.run_inv), 1) ThenBlock: { hit = 1 }
        }
        IfCondition EqualTo(Optimize_NameEq(bn, ScanPtr.run_iv), 1) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(an, ScanPtr.run_inv), 1) ThenBlock: { hit = 1 }
        }
        ReturnValue(hit)
    }
}

// The iv just stepped. The running sum steps by the same amount.
Function.Optimize_ScanRunBump {
    Input: name: Address
    Input: value: Address
    Body: {
        IfCondition EqualTo(ScanPtr.run_name, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_NameEq(name, ScanPtr.run_iv), 0) ThenBlock: { ReturnValue(0) }
        st = Optimize_ScanAddConst(name, value)
        IfCondition NotEqual(st, ScanPtr.run_step) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(st, 0) ThenBlock: { ReturnValue(0) }
        // AddRegImm32 has no r11 form. The assembler does not treat
        // r11 as a scan home, so this add does not spill anything.
        txt = StringConcat("ADD r11, ", NumberToString(st))
        X86Enc_Assemble(txt)
        ReturnValue(0)
    }
}

// j = j + 1 updates the home in place. rax is left alone.
// r12, r13, and rbx use the existing imm32 helpers and stay
// register-only when ScanHold says the loop does not reload them.
// r8, r9, r10, and rdi still publish the frame: a later use in this
// same body can reload the slot after the register is scratched.
// rcx, rdx, rsi, r11, and r14 are not handled here. r15 is the pool.
Function.Optimize_ScanIvInc {
    Input: name: Address
    Input: value: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(Optimize_ScanActive(), 0) ThenBlock: { ReturnValue(0) }
        id = Optimize_TagIntern(name)
        IfCondition EqualTo(Optimize_ScanIsIv(id), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_ScanMatGet(id), 0) ThenBlock: { ReturnValue(0) }
        reg = Optimize_ScanReg(id)
        ok = 0
        hand = 0
        IfCondition EqualTo(reg, Reg.R12) ThenBlock: {
            ok = 1
            hand = 1
        }
        IfCondition EqualTo(reg, Reg.R13) ThenBlock: {
            ok = 1
            hand = 1
        }
        IfCondition EqualTo(reg, Reg.RBX) ThenBlock: {
            ok = 1
            hand = 1
        }
        IfCondition EqualTo(reg, Reg.R8) ThenBlock: { ok = 1 }
        IfCondition EqualTo(reg, Reg.R9) ThenBlock: { ok = 1 }
        IfCondition EqualTo(reg, Reg.R10) ThenBlock: { ok = 1 }
        IfCondition EqualTo(reg, Reg.RDI) ThenBlock: { ok = 1 }
        IfCondition EqualTo(ok, 0) ThenBlock: { ReturnValue(0) }
        mask = ScanState.loop_mask
        IfCondition EqualTo(reg, Reg.R12) ThenBlock: {
            IfCondition EqualTo(BitwiseAnd(mask, 2), 2) ThenBlock: { ReturnValue(0) }
        }
        IfCondition EqualTo(reg, Reg.R13) ThenBlock: {
            IfCondition EqualTo(BitwiseAnd(mask, 4), 4) ThenBlock: { ReturnValue(0) }
        }
        IfCondition EqualTo(reg, Reg.RBX) ThenBlock: {
            IfCondition EqualTo(BitwiseAnd(mask, 1), 1) ThenBlock: { ReturnValue(0) }
        }
        st = Optimize_ScanAddConst(name, value)
        IfCondition EqualTo(st, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_Fit32(st), 0) ThenBlock: { ReturnValue(0) }
        // A caller-saved home is reloaded from the frame when this body
        // scratches the register. The add has to publish that slot, or
        // the next pass reads the value from before the step.
        need = 0
        off = 0
        IfCondition EqualTo(Optimize_ScanHold(name), 0) ThenBlock: {
            need = 1
            off = Scope_Resolve(name)
            IfCondition EqualTo(Scope.resolve_type, 0) ThenBlock: { ReturnValue(0) }
            IfCondition EqualTo(Scope.resolve_type, 3) ThenBlock: { ReturnValue(0) }
            IfCondition GreaterEqual(CompileFunc_HoldReg(off), 0) ThenBlock: { ReturnValue(0) }
        }
        // The add updates this home. Without keep, the assembler
        // spills the register before the write, once per column.
        saved = ScanState.keep
        ScanState.keep = id
        IfCondition EqualTo(hand, 1) ThenBlock: {
            Emit_AddRegImm32(reg, st)
        } ElseBlock: {
            txt = ""
            IfCondition EqualTo(reg, Reg.R8) ThenBlock: { txt = StringConcat("ADD r8, ", NumberToString(st)) }
            IfCondition EqualTo(reg, Reg.R9) ThenBlock: { txt = StringConcat("ADD r9, ", NumberToString(st)) }
            IfCondition EqualTo(reg, Reg.R10) ThenBlock: { txt = StringConcat("ADD r10, ", NumberToString(st)) }
            IfCondition EqualTo(reg, Reg.RDI) ThenBlock: { txt = StringConcat("ADD rdi, ", NumberToString(st)) }
            X86Enc_Assemble(txt)
        }
        ScanState.keep = saved
        IfCondition EqualTo(need, 1) ThenBlock: {
            X86_MovRbpOffsetGpr(off, reg)
        }
        ReturnValue(1)
    }
}

// name = Add(name, other) or Add(other, name), or name = Sub(name, other).
// Both names are materialized GPRs. The add writes the destination
// register. A caller-saved home still publishes the frame, because a
// later call reloads that slot. rbx, r12, and r13 publish only when
// ScanHold says the loop reloads them.
Function.Optimize_ScanAddHome {
    Input: name: Address
    Input: value: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(Optimize_ScanActive(), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(value, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(value), AST.CALL) ThenBlock: { ReturnValue(0) }
        op = AST_GetData1(value)
        is_add = 0
        is_sub = 0
        IfCondition EqualTo(StringCompare(op, "Add"), 0) ThenBlock: { is_add = 1 }
        IfCondition EqualTo(StringCompare(op, "Subtract"), 0) ThenBlock: { is_sub = 1 }
        IfCondition EqualTo(is_add, 0) ThenBlock: {
            IfCondition EqualTo(is_sub, 0) ThenBlock: { ReturnValue(0) }
        }
        IfCondition NotEqual(AST_GetChildCount(value), 2) ThenBlock: { ReturnValue(0) }
        id = Optimize_TagIntern(name)
        IfCondition EqualTo(id, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_ScanMatGet(id), 0) ThenBlock: { ReturnValue(0) }
        reg = Optimize_ScanReg(id)
        IfCondition LessThan(reg, 0) ThenBlock: { ReturnValue(0) }
        a0 = AST_GetChild(value, 0)
        a1 = AST_GetChild(value, 1)
        other = 0
        IfCondition NotEqual(a0, 0) ThenBlock: {
            IfCondition EqualTo(AST_GetType(a0), AST.IDENTIFIER) ThenBlock: {
                IfCondition EqualTo(Optimize_NameEq(AST_GetData1(a0), name), 1) ThenBlock: {
                    other = a1
                }
            }
        }
        IfCondition EqualTo(other, 0) ThenBlock: {
            IfCondition EqualTo(is_sub, 1) ThenBlock: { ReturnValue(0) }
            IfCondition NotEqual(a1, 0) ThenBlock: {
                IfCondition EqualTo(AST_GetType(a1), AST.IDENTIFIER) ThenBlock: {
                    IfCondition EqualTo(Optimize_NameEq(AST_GetData1(a1), name), 1) ThenBlock: {
                        other = a0
                    }
                }
            }
        }
        IfCondition EqualTo(other, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(other), AST.IDENTIFIER) ThenBlock: { ReturnValue(0) }
        oreg = Optimize_ScanAddrBase(AST_GetData1(other))
        IfCondition EqualTo(oreg, 0) ThenBlock: { ReturnValue(0) }
        need = 0
        off = 0
        IfCondition EqualTo(Optimize_ScanHold(name), 0) ThenBlock: {
            need = 1
            off = Scope_Resolve(name)
            IfCondition EqualTo(Scope.resolve_type, 0) ThenBlock: { ReturnValue(0) }
            IfCondition EqualTo(Scope.resolve_type, 3) ThenBlock: { ReturnValue(0) }
            IfCondition GreaterEqual(CompileFunc_HoldReg(off), 0) ThenBlock: { ReturnValue(0) }
        }
        saved = ScanState.keep
        ScanState.keep = id
        IfCondition EqualTo(is_sub, 1) ThenBlock: {
            X86_SubRegReg(reg, oreg)
        } ElseBlock: {
            X86_AddRegReg(reg, oreg)
        }
        ScanState.keep = saved
        IfCondition EqualTo(need, 1) ThenBlock: {
            X86_MovRbpOffsetGpr(off, reg)
        }
        ReturnValue(1)
    }
}

// Parameters that live in an xmm are still on the frame until the
// first use. Load them once, before the back edge, so the column
// loop reads the register.
Function.Optimize_ScanSeedLoop {
    Input: node: Address
    Body: {
        IfCondition EqualTo(Optimize_ScanActive(), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        pos = Optimize_TagPosOf(node)
        IfCondition LessThan(pos, 0) ThenBlock: { ReturnValue(0) }
        b = Optimize_ScanBlockAt(pos)
        IfCondition LessThan(b, 0) ThenBlock: { ReturnValue(0) }
        in0 = Optimize_LiveIn0(b)
        in1 = Optimize_LiveIn1(b)
        i = 1
        WhileLoop LessThan(i, Add(TagState.nnames, 1)) {
            IfCondition EqualTo(Optimize_ScanBit(i, in0, in1), 1) ThenBlock: {
                IfCondition EqualTo(Optimize_ScanMatGet(i), 0) ThenBlock: {
                    xmm = Optimize_ScanXmm(Optimize_ScanReg(i))
                    IfCondition GreaterEqual(xmm, 0) ThenBlock: {
                        name = Dereference(Add(TagState.names, Multiply(Subtract(i, 1), 8)))
                        off = Scope_Resolve(name)
                        rt = Scope.resolve_type
                        ok = 0
                        IfCondition EqualTo(rt, 1) ThenBlock: { ok = 1 }
                        IfCondition EqualTo(rt, 2) ThenBlock: { ok = 1 }
                        IfCondition GreaterEqual(off, 0) ThenBlock: { ok = 0 }
                        IfCondition EqualTo(ok, 1) ThenBlock: {
                            X86_EmitRbpXmm(16, xmm, off)
                            Optimize_ScanMatSet(i)
                        }
                    }
                }
            }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

// Identifier used as Dereference/StoreValue base, or Add(ident, imm).
Function.Optimize_ScanPtrBaseName {
    Input: addr: Address
    Output: Address
    Body: {
        IfCondition EqualTo(addr, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(AST_GetType(addr), AST.IDENTIFIER) ThenBlock: {
            ReturnValue(AST_GetData1(addr))
        }
        IfCondition NotEqual(AST_GetType(addr), AST.CALL) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(StringCompare(AST_GetData1(addr), "Add"), 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetChildCount(addr), 2) ThenBlock: { ReturnValue(0) }
        c0 = AST_GetChild(addr, 0)
        c1 = AST_GetChild(addr, 1)
        IfCondition NotEqual(c1, 0) ThenBlock: {
            IfCondition EqualTo(AST_GetType(c1), AST.NUMBER) ThenBlock: {
                IfCondition NotEqual(c0, 0) ThenBlock: {
                    IfCondition EqualTo(AST_GetType(c0), AST.IDENTIFIER) ThenBlock: {
                        ReturnValue(AST_GetData1(c0))
                    }
                }
            }
        }
        IfCondition NotEqual(c0, 0) ThenBlock: {
            IfCondition EqualTo(AST_GetType(c0), AST.NUMBER) ThenBlock: {
                IfCondition NotEqual(c1, 0) ThenBlock: {
                    IfCondition EqualTo(AST_GetType(c1), AST.IDENTIFIER) ThenBlock: {
                        ReturnValue(AST_GetData1(c1))
                    }
                }
            }
        }
        ReturnValue(0)
    }
}

// Unstepped field pointer into r14 or r11. No index math.
Function.Optimize_ScanPtrHoldEmit {
    Input: slot: Integer
    Body: {
        name = ScanPtr.name0
        reg = ScanPtr.reg0
        IfCondition EqualTo(slot, 1) ThenBlock: {
            name = ScanPtr.name1
            reg = ScanPtr.reg1
        }
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(reg, 0) ThenBlock: { ReturnValue(0) }
        id = Optimize_ScanFind(name)
        IfCondition GreaterThan(id, 0) ThenBlock: {
            IfCondition EqualTo(Optimize_ScanMatGet(id), 1) ThenBlock: {
                hreg = Optimize_ScanReg(id)
                IfCondition EqualTo(hreg, Reg.RBX) ThenBlock: {
                    Emit_MovRegReg(reg, hreg)
                    ReturnValue(1)
                }
                IfCondition EqualTo(hreg, Reg.R12) ThenBlock: {
                    Emit_MovRegReg(reg, hreg)
                    ReturnValue(1)
                }
                IfCondition EqualTo(hreg, Reg.R13) ThenBlock: {
                    Emit_MovRegReg(reg, hreg)
                    ReturnValue(1)
                }
            }
        }
        off = Scope_Resolve(name)
        rt = Scope.resolve_type
        ok = 0
        IfCondition EqualTo(rt, 1) ThenBlock: { ok = 1 }
        IfCondition EqualTo(rt, 2) ThenBlock: { ok = 1 }
        IfCondition GreaterEqual(off, 0) ThenBlock: { ok = 0 }
        IfCondition EqualTo(ok, 0) ThenBlock: { ReturnValue(0) }
        Emit_MovRaxRbpOffset(off)
        Emit_MovRegReg(reg, Reg.RAX)
        ReturnValue(1)
    }
}

Function.Optimize_ScanPtrHoldWalk {
    Input: node: Address
    Input: body: Address
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterEqual(ScanPtr.n, 2) ThenBlock: { ReturnValue(0) }
        t = AST_GetType(node)
        IfCondition EqualTo(t, AST.WHILE) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(t, AST.FOR_EVERY) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(t, AST.CALL) ThenBlock: {
            nm = AST_GetData1(node)
            hit = 0
            IfCondition EqualTo(StringCompare(nm, "Dereference"), 0) ThenBlock: { hit = 1 }
            IfCondition EqualTo(StringCompare(nm, "StoreValue"), 0) ThenBlock: { hit = 1 }
            IfCondition EqualTo(hit, 1) ThenBlock: {
                IfCondition GreaterThan(AST_GetChildCount(node), 0) ThenBlock: {
                    bname = Optimize_ScanPtrBaseName(AST_GetChild(node, 0))
                    IfCondition NotEqual(bname, 0) ThenBlock: {
                        skip = 0
                        IfCondition GreaterThan(ScanPtr.n, 0) ThenBlock: {
                            IfCondition EqualTo(Optimize_NameEq(bname, ScanPtr.name0), 1) ThenBlock: { skip = 1 }
                        }
                        IfCondition GreaterThan(ScanPtr.n, 1) ThenBlock: {
                            IfCondition EqualTo(Optimize_NameEq(bname, ScanPtr.name1), 1) ThenBlock: { skip = 1 }
                        }
                        IfCondition EqualTo(skip, 0) ThenBlock: {
                            IfCondition EqualTo(Optimize_ScanAssigns(body, bname), 0) ThenBlock: {
                                IfCondition EqualTo(Optimize_ScanPtrBad(body, bname), 0) ThenBlock: {
                                    // A real call clobbers r14/r11. Parking
                                    // usedp across Skip wrote [r14] into
                                    // garbage and hung jsonarena.
                                    IfCondition EqualTo(ScanPtr.calls, 1) ThenBlock: { ReturnValue(0) }
                                    ScanPtr.siv = 0
                                    ScanPtr.sbase = bname
                                    ScanPtr.sstride = 0
                                    ScanPtr.found = 0
                                    ScanPtr.step = 0
                                    hreg = 14
                                    IfCondition EqualTo(ScanPtr.n, 1) ThenBlock: {
                                        hreg = 11
                                    }
                                    Optimize_ScanPtrTake(bname, hreg)
                                }
                            }
                        }
                    }
                }
            }
        }
        n = AST_GetChildCount(node)
        i = 0
        WhileLoop LessThan(i, n) {
            Optimize_ScanPtrHoldWalk(AST_GetChild(node, i), body)
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

Function.Optimize_ScanPtrHold {
    Input: body: Address
    Body: {
        IfCondition EqualTo(body, 0) ThenBlock: { ReturnValue(0) }
        Optimize_ScanPtrHoldWalk(body, body)
        ReturnValue(0)
    }
}

// Name into rax. A materialized home is mov rax, reg. Otherwise the
// frame slot. Does not compile the expression: a subtract would park
// the other operand in rbx, and the iv may live there.
Function.Optimize_ScanLoadHome {
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_ScanTryLoad(name), 1) ThenBlock: { ReturnValue(1) }
        off = Scope_Resolve(name)
        rt = Scope.resolve_type
        ok = 0
        IfCondition EqualTo(rt, 1) ThenBlock: { ok = 1 }
        IfCondition EqualTo(rt, 2) ThenBlock: { ok = 1 }
        IfCondition GreaterEqual(off, 0) ThenBlock: { ok = 0 }
        IfCondition EqualTo(ok, 0) ThenBlock: { ReturnValue(0) }
        Emit_MovRaxRbpOffset(off)
        ReturnValue(1)
    }
}

// r11 = base + (rev_c - iv) * stride. Slot 0 already holds the low pointer.
// rev1 2 is k - iv: rev_c is a name, never an immediate.
Function.Optimize_ScanPtrEmitRev {
    Body: {
        IfCondition EqualTo(ScanPtr.rev1, 2) ThenBlock: {
            IfCondition EqualTo(Optimize_ScanPtrRevLeaK(), 1) ThenBlock: { ReturnValue(1) }
        } ElseBlock: {
            IfCondition EqualTo(Optimize_ScanPtrRevLea(), 1) ThenBlock: { ReturnValue(1) }
        }
        idx = ScanPtr.iv0
        base = ScanPtr.base0
        stride = ScanPtr.stride0
        Emit_PushR14()
        got = Compile_Expression(idx)
        IfCondition EqualTo(got, 0) ThenBlock: {
            Emit_PopR14()
            Compile.error = 1
            ReturnValue(0)
        }
        pow = 0
        IfCondition GreaterThan(stride, 1) ThenBlock: {
            mask = BitwiseAnd(stride, Subtract(stride, 1))
            IfCondition EqualTo(mask, 0) ThenBlock: { pow = 1 }
        }
        IfCondition EqualTo(stride, 1) ThenBlock: { pow = 1 }
        sh = 0
        IfCondition EqualTo(pow, 1) ThenBlock: {
            tmp = stride
            WhileLoop GreaterThan(tmp, 1) {
                tmp = Divide(tmp, 2)
                sh = Add(sh, 1)
            }
            IfCondition GreaterThan(sh, 0) ThenBlock: { Emit_ShlRaxImm8(sh) }
        } ElseBlock: {
            Emit_ImulRaxImm32(stride)
        }
        Emit_PushRax()
        IfCondition EqualTo(ScanPtr.rev1, 2) ThenBlock: {
            gotk = Optimize_ScanLoadHome(ScanPtr.rev_c)
            IfCondition EqualTo(gotk, 0) ThenBlock: {
                Emit_PopRax()
                Emit_PopR14()
                Compile.error = 1
                ReturnValue(0)
            }
        } ElseBlock: {
            Emit_MovRaxImm64(ScanPtr.rev_c)
        }
        IfCondition GreaterThan(sh, 0) ThenBlock: { Emit_ShlRaxImm8(sh) }
        IfCondition EqualTo(pow, 0) ThenBlock: {
            Emit_ImulRaxImm32(stride)
        }
        Emit_PopRcx()
        X86_SubRegReg(Reg.RAX, Reg.RCX)
        Emit_PushRax()
        got = Compile_Expression(base)
        IfCondition EqualTo(got, 0) ThenBlock: {
            Emit_PopRax()
            Emit_PopR14()
            Compile.error = 1
            ReturnValue(0)
        }
        Emit_PopRcx()
        X86_AddRegReg(Reg.RAX, Reg.RCX)
        Emit_MovRegReg(ScanPtr.reg1, Reg.RAX)
        Emit_PopR14()
        ReturnValue(1)
    }
}

// Six-statement swap: a=[base+i*s]; idx=C-i or idx=k-i; b=[base+idx*s];
// [base+i*s]=b; [base+idx*s]=a; i+=step. Parks low in r14, high in r11.
// rev1 1 stores the integer C. rev1 2 stores k's name in rev_c.
Function.Optimize_ScanPtrSwap {
    Input: body: Address
    Body: {
        IfCondition EqualTo(body, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(body), AST.BLOCK) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetChildCount(body), 6) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(ScanPtr.n, 0) ThenBlock: { ReturnValue(0) }
        s0 = AST_GetChild(body, 0)
        s1 = AST_GetChild(body, 1)
        s2 = AST_GetChild(body, 2)
        s3 = AST_GetChild(body, 3)
        s4 = AST_GetChild(body, 4)
        s5 = AST_GetChild(body, 5)
        IfCondition EqualTo(Optimize_PlainAssign(s0), 0) ThenBlock: { ReturnValue(0) }
        v0 = AST_GetChild(s0, 0)
        IfCondition EqualTo(v0, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(v0), AST.CALL) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(StringCompare(AST_GetData1(v0), "Dereference"), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(AST_GetChildCount(v0), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_ScanPtrShape(AST_GetChild(v0, 0)), 0) ThenBlock: { ReturnValue(0) }
        st = ScanPtr.sstride
        ok = 0
        IfCondition EqualTo(st, 1) ThenBlock: { ok = 1 }
        IfCondition EqualTo(st, 2) ThenBlock: { ok = 1 }
        IfCondition EqualTo(st, 4) ThenBlock: { ok = 1 }
        IfCondition EqualTo(st, 8) ThenBlock: { ok = 1 }
        IfCondition EqualTo(ok, 0) ThenBlock: { ReturnValue(0) }
        bname = AST_GetData1(ScanPtr.sbase)
        iname = AST_GetData1(ScanPtr.siv)
        lo_base = ScanPtr.sbase
        lo_iv = ScanPtr.siv
        aname = AST_GetData1(s0)
        IfCondition EqualTo(bname, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(iname, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(aname, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_PlainAssign(s1), 0) ThenBlock: { ReturnValue(0) }
        v1 = AST_GetChild(s1, 0)
        IfCondition EqualTo(v1, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(v1), AST.CALL) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(StringCompare(AST_GetData1(v1), "Subtract"), 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetChildCount(v1), 2) ThenBlock: { ReturnValue(0) }
        c0 = AST_GetChild(v1, 0)
        c1 = AST_GetChild(v1, 1)
        cnum = 0
        civ = 0
        IfCondition NotEqual(c0, 0) ThenBlock: {
            IfCondition EqualTo(AST_GetType(c0), AST.NUMBER) ThenBlock: {
                IfCondition NotEqual(c1, 0) ThenBlock: {
                    IfCondition EqualTo(AST_GetType(c1), AST.IDENTIFIER) ThenBlock: {
                        cnum = c0
                        civ = c1
                    }
                }
            }
        }
        IfCondition EqualTo(cnum, 0) ThenBlock: {
            IfCondition NotEqual(c1, 0) ThenBlock: {
                IfCondition EqualTo(AST_GetType(c1), AST.NUMBER) ThenBlock: {
                    IfCondition NotEqual(c0, 0) ThenBlock: {
                        IfCondition EqualTo(AST_GetType(c0), AST.IDENTIFIER) ThenBlock: {
                            cnum = c1
                            civ = c0
                        }
                    }
                }
            }
        }
        kmode = 0
        kname = 0
        IfCondition EqualTo(cnum, 0) ThenBlock: {
            IfCondition NotEqual(c0, 0) ThenBlock: {
                IfCondition EqualTo(AST_GetType(c0), AST.IDENTIFIER) ThenBlock: {
                    IfCondition NotEqual(c1, 0) ThenBlock: {
                        IfCondition EqualTo(AST_GetType(c1), AST.IDENTIFIER) ThenBlock: {
                            IfCondition EqualTo(Optimize_NameEq(AST_GetData1(c1), iname), 1) ThenBlock: {
                                IfCondition EqualTo(Optimize_NameEq(AST_GetData1(c0), iname), 0) ThenBlock: {
                                    kname = AST_GetData1(c0)
                                    kmode = 2
                                }
                            }
                        }
                    }
                }
            }
            IfCondition EqualTo(kmode, 0) ThenBlock: { ReturnValue(0) }
            IfCondition EqualTo(kname, 0) ThenBlock: { ReturnValue(0) }
            IfCondition EqualTo(Optimize_NameEq(kname, iname), 1) ThenBlock: { ReturnValue(0) }
            IfCondition EqualTo(Optimize_NameEq(kname, bname), 1) ThenBlock: { ReturnValue(0) }
            IfCondition EqualTo(Optimize_NameEq(kname, aname), 1) ThenBlock: { ReturnValue(0) }
            IfCondition EqualTo(Optimize_ScanAssigns(body, kname), 1) ThenBlock: { ReturnValue(0) }
            kr = Optimize_ScanReg(Optimize_TagIntern(kname))
            ir = Optimize_ScanReg(Optimize_TagIntern(iname))
            IfCondition NotEqual(kr, -1) ThenBlock: {
                IfCondition EqualTo(kr, ir) ThenBlock: { ReturnValue(0) }
            }
            br = Optimize_ScanReg(Optimize_TagIntern(bname))
            IfCondition NotEqual(kr, -1) ThenBlock: {
                IfCondition EqualTo(kr, br) ThenBlock: { ReturnValue(0) }
            }
        } ElseBlock: {
            IfCondition EqualTo(Optimize_NameEq(AST_GetData1(civ), iname), 0) ThenBlock: { ReturnValue(0) }
            C = StringToNumber(AST_GetData1(cnum))
            IfCondition LessThan(C, 0) ThenBlock: { ReturnValue(0) }
            IfCondition EqualTo(Optimize_Fit32(C), 0) ThenBlock: { ReturnValue(0) }
        }
        idxname = AST_GetData1(s1)
        IfCondition EqualTo(idxname, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_NameEq(idxname, iname), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(kmode, 2) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(kname, idxname), 1) ThenBlock: { ReturnValue(0) }
        }
        IfCondition EqualTo(Optimize_PlainAssign(s2), 0) ThenBlock: { ReturnValue(0) }
        v2 = AST_GetChild(s2, 0)
        IfCondition EqualTo(v2, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(v2), AST.CALL) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(StringCompare(AST_GetData1(v2), "Dereference"), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(AST_GetChildCount(v2), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_ScanPtrShape(AST_GetChild(v2, 0)), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_NameEq(AST_GetData1(ScanPtr.sbase), bname), 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(ScanPtr.sstride, st) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_NameEq(AST_GetData1(ScanPtr.siv), idxname), 0) ThenBlock: { ReturnValue(0) }
        bnm = AST_GetData1(s2)
        IfCondition EqualTo(bnm, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_NameEq(bnm, aname), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(kmode, 2) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(kname, bnm), 1) ThenBlock: { ReturnValue(0) }
        }
        IfCondition NotEqual(AST_GetType(s3), AST.CALL) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(StringCompare(AST_GetData1(s3), "StoreValue"), 0) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(AST_GetChildCount(s3), 2) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_ScanPtrShape(AST_GetChild(s3, 0)), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_NameEq(AST_GetData1(ScanPtr.sbase), bname), 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(ScanPtr.sstride, st) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_NameEq(AST_GetData1(ScanPtr.siv), iname), 0) ThenBlock: { ReturnValue(0) }
        sv3 = AST_GetChild(s3, 1)
        IfCondition EqualTo(sv3, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(sv3), AST.IDENTIFIER) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_NameEq(AST_GetData1(sv3), bnm), 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(s4), AST.CALL) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(StringCompare(AST_GetData1(s4), "StoreValue"), 0) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(AST_GetChildCount(s4), 2) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_ScanPtrShape(AST_GetChild(s4, 0)), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_NameEq(AST_GetData1(ScanPtr.sbase), bname), 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(ScanPtr.sstride, st) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_NameEq(AST_GetData1(ScanPtr.siv), idxname), 0) ThenBlock: { ReturnValue(0) }
        sv4 = AST_GetChild(s4, 1)
        IfCondition EqualTo(sv4, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(sv4), AST.IDENTIFIER) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_NameEq(AST_GetData1(sv4), aname), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_PlainAssign(s5), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_NameEq(AST_GetData1(s5), iname), 0) ThenBlock: { ReturnValue(0) }
        v5 = AST_GetChild(s5, 0)
        IfCondition EqualTo(Optimize_ScanAddConst(iname, v5), 0) ThenBlock: { ReturnValue(0) }
        step = Optimize_ScanAddConst(iname, v5)
        IfCondition LessThan(step, 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_Fit32(Multiply(st, step)), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_ScanAssigns(body, bname), 1) ThenBlock: { ReturnValue(0) }
        ScanPtr.siv = lo_iv
        ScanPtr.sbase = lo_base
        ScanPtr.sstride = st
        ScanPtr.found = 1
        ScanPtr.step = step
        Optimize_ScanPtrTake(bname, 14)
        ScanPtr.siv = lo_iv
        ScanPtr.sbase = lo_base
        ScanPtr.sstride = st
        ScanPtr.found = 1
        ScanPtr.step = step
        Optimize_ScanPtrTake(idxname, 11)
        IfCondition EqualTo(kmode, 2) ThenBlock: {
            ScanPtr.rev1 = 2
            ScanPtr.rev_c = kname
        } ElseBlock: {
            ScanPtr.rev1 = 1
            ScanPtr.rev_c = C
        }
        ScanPtr.walk_lo = iname
        ScanPtr.walk_hi = idxname
        ScanPtr.swap = 1
        ScanPtr.swap_a = aname
        ScanPtr.swap_b = bnm
        ReturnValue(1)
    }
}

// Two-pointer swap parks a/b in rax/rcx, so Deref/StoreValue do not
// write rbx. Clear loop_mask bit 1 so DropRegs leaves the iv in rbx.
// Swap's Take would overwrite name0; restore it so SpillOuter still
// spills the outer pointers.
Function.Optimize_ScanSwapMask {
    Input: body: Address
    Body: {
        IfCondition EqualTo(Optimize_ScanActive(), 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(ScanPtr.n, 0) ThenBlock: { ReturnValue(0) }
        saved_name0 = ScanPtr.name0
        saved_name1 = ScanPtr.name1
        saved_reg0 = ScanPtr.reg0
        saved_reg1 = ScanPtr.reg1
        saved_bump0 = ScanPtr.bump0
        saved_bump1 = ScanPtr.bump1
        saved_iv0 = ScanPtr.iv0
        saved_iv1 = ScanPtr.iv1
        saved_step0 = ScanPtr.step0
        saved_step1 = ScanPtr.step1
        saved_base0 = ScanPtr.base0
        saved_base1 = ScanPtr.base1
        saved_stride0 = ScanPtr.stride0
        saved_stride1 = ScanPtr.stride1
        Optimize_ScanPtrSwap(body)
        IfCondition EqualTo(ScanPtr.swap, 1) ThenBlock: {
            IfCondition EqualTo(BitwiseAnd(ScanState.loop_mask, 1), 1) ThenBlock: {
                ScanState.loop_mask = Subtract(ScanState.loop_mask, 1)
            }
        }
        ScanPtr.n = 0
        ScanPtr.name0 = saved_name0
        ScanPtr.name1 = saved_name1
        ScanPtr.reg0 = saved_reg0
        ScanPtr.reg1 = saved_reg1
        ScanPtr.bump0 = saved_bump0
        ScanPtr.bump1 = saved_bump1
        ScanPtr.iv0 = saved_iv0
        ScanPtr.iv1 = saved_iv1
        ScanPtr.step0 = saved_step0
        ScanPtr.step1 = saved_step1
        ScanPtr.base0 = saved_base0
        ScanPtr.base1 = saved_base1
        ScanPtr.stride0 = saved_stride0
        ScanPtr.stride1 = saved_stride1
        ScanPtr.rev1 = 0
        ScanPtr.rev_c = 0
        ScanPtr.walk_lo = 0
        ScanPtr.walk_hi = 0
        ScanPtr.swap = 0
        ScanPtr.swap_a = 0
        ScanPtr.swap_b = 0
        ReturnValue(0)
    }
}

// Skip idx = C-i. Load a into rax from [r14], b into rcx from [r11].
Function.Optimize_ScanSwapAssign {
    Input: name: Address
    Input: value: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(ScanPtr.swap, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_NameEq(name, ScanPtr.walk_hi), 1) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(value, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(value), AST.CALL) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(StringCompare(AST_GetData1(value), "Dereference"), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(AST_GetChildCount(value), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_ScanPtrHit(AST_GetChild(value, 0)), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_NameEq(name, ScanPtr.swap_a), 1) ThenBlock: {
            X86_MovRaxIp(ScanPtr.hit_reg, ScanPtr.hit_disp)
            ReturnValue(1)
        }
        IfCondition EqualTo(Optimize_NameEq(name, ScanPtr.swap_b), 1) ThenBlock: {
            X86_MovRcxIp(ScanPtr.hit_reg, ScanPtr.hit_disp)
            ReturnValue(1)
        }
        ReturnValue(0)
    }
}

// perm[i] = b is [r14], rcx. perm[idx] = a is [r11], rax.
Function.Optimize_ScanSwapStore {
    Input: addr: Address
    Input: val: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(ScanPtr.swap, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(val, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(val), AST.IDENTIFIER) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_ScanPtrHit(addr), 0) ThenBlock: { ReturnValue(0) }
        vname = AST_GetData1(val)
        IfCondition EqualTo(Optimize_NameEq(vname, ScanPtr.swap_b), 1) ThenBlock: {
            IfCondition EqualTo(ScanPtr.hit_reg, ScanPtr.reg0) ThenBlock: {
                X86_MovIpRcx(ScanPtr.hit_reg, ScanPtr.hit_disp)
                ReturnValue(1)
            }
        }
        IfCondition EqualTo(Optimize_NameEq(vname, ScanPtr.swap_a), 1) ThenBlock: {
            IfCondition EqualTo(ScanPtr.hit_reg, ScanPtr.reg1) ThenBlock: {
                X86_MovIpRax(ScanPtr.hit_reg, ScanPtr.hit_disp)
                ReturnValue(1)
            }
        }
        ReturnValue(0)
    }
}

// Before the back-edge label: compute each pointer once. Later trips
// add the stride instead of multiplying the index again.
Function.Optimize_ScanPtrArm {
    Input: body: Address
    Body: {
        IfCondition EqualTo(Optimize_ScanActive(), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(body, 0) ThenBlock: { ReturnValue(0) }
        ScanPtr.calls = 0
        ScanPtr.n = 0
        ScanPtr.loop_body = body
        ScanPtr.rev1 = 0
        ScanPtr.rev_c = 0
        ScanPtr.walk_lo = 0
        ScanPtr.walk_hi = 0
        ScanPtr.swap = 0
        ScanPtr.swap_a = 0
        ScanPtr.swap_b = 0
        Optimize_ScanPtrConsider(body, body)
        Optimize_ScanPtrHold(body)
        IfCondition EqualTo(ScanPtr.n, 0) ThenBlock: {
            Optimize_ScanPtrSwap(body)
        }
        IfCondition GreaterThan(ScanPtr.n, 0) ThenBlock: {
            IfCondition LessThan(ScanPtr.bump0, 0) ThenBlock: {
                IfCondition GreaterThan(ScanPtr.n, 1) ThenBlock: {
                    ScanPtr.name0 = ScanPtr.name1
                    ScanPtr.reg0 = ScanPtr.reg1
                    ScanPtr.bump0 = ScanPtr.bump1
                    ScanPtr.iv0 = ScanPtr.iv1
                    ScanPtr.step0 = ScanPtr.step1
                    ScanPtr.base0 = ScanPtr.base1
                    ScanPtr.stride0 = ScanPtr.stride1
                    ScanPtr.n = 1
                } ElseBlock: {
                    ScanPtr.n = 0
                }
            }
        }
        IfCondition GreaterThan(ScanPtr.n, 1) ThenBlock: {
            IfCondition LessThan(ScanPtr.bump1, 0) ThenBlock: { ScanPtr.n = 1 }
        }
        IfCondition GreaterThan(ScanPtr.n, 1) ThenBlock: {
            IfCondition EqualTo(ScanPtr.calls, 1) ThenBlock: { ScanPtr.n = 1 }
        }
        IfCondition GreaterThan(ScanPtr.n, 0) ThenBlock: {
            IfCondition EqualTo(ScanPtr.iv0, 0) ThenBlock: {
                Optimize_ScanPtrHoldEmit(0)
            } ElseBlock: {
                Optimize_ScanPtrEmit(0)
            }
        }
        IfCondition GreaterThan(ScanPtr.n, 1) ThenBlock: {
            IfCondition NotEqual(ScanPtr.rev1, 0) ThenBlock: {
                Optimize_ScanPtrEmitRev()
            } ElseBlock: {
                IfCondition EqualTo(ScanPtr.iv1, 0) ThenBlock: {
                    Optimize_ScanPtrHoldEmit(1)
                } ElseBlock: {
                    Optimize_ScanPtrEmit(1)
                }
            }
        }
        ReturnValue(0)
    }
}

Function.Optimize_ScanPtrSpill {
    Input: slot: Integer
    Body: {
        name = ScanPtr.name0
        reg = ScanPtr.reg0
        IfCondition EqualTo(slot, 1) ThenBlock: {
            name = ScanPtr.name1
            reg = ScanPtr.reg1
        }
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }
        // Copy the pointer. MovRaxIp loads [reg+disp], which is a field.
        Emit_MovRegReg(Reg.RAX, reg)
        off = Scope_Resolve(name)
        IfCondition EqualTo(Scope.resolve_type, 0) ThenBlock: {
            Compile.stack_offset = Add(Compile.stack_offset, 8)
            off = Subtract(0, Compile.stack_offset)
            Compile_RegisterLocal(name, off)
        }
        IfCondition EqualTo(Scope.resolve_type, 3) ThenBlock: { ReturnValue(0) }
        Emit_MovRbpOffsetRax(off)
        ReturnValue(0)
    }
}

Function.Optimize_ScanPtrReload {
    Input: slot: Integer
    Body: {
        name = ScanPtr.name0
        reg = ScanPtr.reg0
        IfCondition EqualTo(slot, 1) ThenBlock: {
            name = ScanPtr.name1
            reg = ScanPtr.reg1
        }
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }
        off = Scope_Resolve(name)
        IfCondition EqualTo(Scope.resolve_type, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Scope.resolve_type, 3) ThenBlock: { ReturnValue(0) }
        Emit_MovRaxRbpOffset(off)
        Emit_MovRegReg(reg, Reg.RAX)
        ReturnValue(0)
    }
}

// Remember the enclosing loop's pointers, then clear the record so this
// loop can reuse r14 and r11. The register save happens after DropRegs
// (ScanPtrSpillOuter): that pass can write the same frame slot from a
// value home, and the pointer register is the value that has to win.
Function.Optimize_ScanPtrPush {
    Body: {
        IfCondition EqualTo(Optimize_ScanActive(), 0) ThenBlock: { ReturnValue(0) }
        snap = Allocate(320)
        IfCondition EqualTo(snap, 0) ThenBlock: { ReturnValue(0) }
        StoreValue(snap, ScanPtr.n)
        StoreValue(Add(snap, 8), ScanPtr.name0)
        StoreValue(Add(snap, 16), ScanPtr.name1)
        StoreValue(Add(snap, 24), ScanPtr.reg0)
        StoreValue(Add(snap, 32), ScanPtr.reg1)
        StoreValue(Add(snap, 40), ScanPtr.bump0)
        StoreValue(Add(snap, 48), ScanPtr.bump1)
        StoreValue(Add(snap, 56), ScanPtr.iv0)
        StoreValue(Add(snap, 64), ScanPtr.iv1)
        StoreValue(Add(snap, 72), ScanPtr.step0)
        StoreValue(Add(snap, 80), ScanPtr.step1)
        StoreValue(Add(snap, 88), ScanPtr.snap)
        StoreValue(Add(snap, 96), ScanPtr.scale_name)
        StoreValue(Add(snap, 104), ScanPtr.run_name)
        StoreValue(Add(snap, 112), ScanPtr.run_iv)
        StoreValue(Add(snap, 120), ScanPtr.run_inv)
        StoreValue(Add(snap, 128), ScanPtr.run_step)
        StoreValue(Add(snap, 136), ScanPtr.byte_name)
        StoreValue(Add(snap, 144), ScanPtr.byte_iv)
        StoreValue(Add(snap, 152), ScanPtr.byte_step)
        StoreValue(Add(snap, 160), ScanPtr.byte_lim)
        StoreValue(Add(snap, 168), ScanPtr.byte_imm)
        StoreValue(Add(snap, 176), ScanPtr.byte_acc)
        StoreValue(Add(snap, 184), ScanPtr.byte_keep)
        StoreValue(Add(snap, 192), ScanPtr.ctr_name)
        StoreValue(Add(snap, 200), ScanPtr.ctr_lim)
        StoreValue(Add(snap, 208), ScanPtr.flt_keep)
        StoreValue(Add(snap, 216), ScanPtr.park0)
        StoreValue(Add(snap, 224), ScanPtr.park1)
        StoreValue(Add(snap, 232), ScanPtr.park2)
        StoreValue(Add(snap, 240), ScanPtr.loop_body)
        StoreValue(Add(snap, 248), ScanPtr.rev1)
        StoreValue(Add(snap, 256), ScanPtr.rev_c)
        StoreValue(Add(snap, 264), ScanPtr.walk_lo)
        StoreValue(Add(snap, 272), ScanPtr.walk_hi)
        StoreValue(Add(snap, 280), ScanPtr.swap)
        StoreValue(Add(snap, 288), ScanPtr.swap_a)
        StoreValue(Add(snap, 296), ScanPtr.swap_b)
        StoreValue(Add(snap, 304), ScanPtr.park1_reg)
        StoreValue(Add(snap, 312), ScanPtr.park2_reg)
        ScanPtr.snap = snap
        ScanPtr.n = 0
        ScanPtr.scale_name = 0
        ScanPtr.scale_bad = 0
        ScanPtr.run_name = 0
        ScanPtr.run_iv = 0
        ScanPtr.run_inv = 0
        ScanPtr.run_step = 0
        ScanPtr.byte_name = 0
        ScanPtr.byte_bad = 0
        ScanPtr.byte_iv = 0
        ScanPtr.byte_step = 0
        ScanPtr.byte_lim = 0
        ScanPtr.byte_imm = -1
        ScanPtr.byte_acc = 0
        ScanPtr.byte_keep = 0
        ScanPtr.ctr_name = 0
        ScanPtr.ctr_lim = 0
        ScanPtr.flt_keep = 0
        ScanPtr.park0 = 0
        ScanPtr.park1 = 0
        ScanPtr.park2 = 0
        ScanPtr.loop_body = 0
        ScanPtr.rev1 = 0
        ScanPtr.rev_c = 0
        ScanPtr.walk_lo = 0
        ScanPtr.walk_hi = 0
        ScanPtr.swap = 0
        ScanPtr.swap_a = 0
        ScanPtr.swap_b = 0
        ScanPtr.park1_reg = -1
        ScanPtr.park2_reg = -1
        ReturnValue(0)
    }
}

// Save the pointers Push just snapshotted. name0/reg0 are still the
// outer record; n is already 0 so the inner arm can reuse it.
Function.Optimize_ScanPtrSpillOuter {
    Body: {
        snap = ScanPtr.snap
        IfCondition EqualTo(snap, 0) ThenBlock: { ReturnValue(0) }
        saved = Dereference(snap)
        IfCondition GreaterThan(saved, 0) ThenBlock: {
            Optimize_ScanPtrSpill(0)
            Optimize_ScanPtrRmKill(ScanPtr.reg0)
        }
        IfCondition GreaterThan(saved, 1) ThenBlock: {
            Optimize_ScanPtrSpill(1)
            Optimize_ScanPtrRmKill(ScanPtr.reg1)
        }
        ReturnValue(0)
    }
}

Function.Optimize_ScanPtrPop {
    Body: {
        snap = ScanPtr.snap
        IfCondition EqualTo(snap, 0) ThenBlock: { ReturnValue(0) }
        ScanPtr.n = Dereference(snap)
        ScanPtr.name0 = Dereference(Add(snap, 8))
        ScanPtr.name1 = Dereference(Add(snap, 16))
        ScanPtr.reg0 = Dereference(Add(snap, 24))
        ScanPtr.reg1 = Dereference(Add(snap, 32))
        ScanPtr.bump0 = Dereference(Add(snap, 40))
        ScanPtr.bump1 = Dereference(Add(snap, 48))
        ScanPtr.iv0 = Dereference(Add(snap, 56))
        ScanPtr.iv1 = Dereference(Add(snap, 64))
        ScanPtr.step0 = Dereference(Add(snap, 72))
        ScanPtr.step1 = Dereference(Add(snap, 80))
        ScanPtr.snap = Dereference(Add(snap, 88))
        ScanPtr.scale_name = Dereference(Add(snap, 96))
        ScanPtr.run_name = Dereference(Add(snap, 104))
        ScanPtr.run_iv = Dereference(Add(snap, 112))
        ScanPtr.run_inv = Dereference(Add(snap, 120))
        ScanPtr.run_step = Dereference(Add(snap, 128))
        ScanPtr.byte_name = Dereference(Add(snap, 136))
        ScanPtr.byte_iv = Dereference(Add(snap, 144))
        ScanPtr.byte_step = Dereference(Add(snap, 152))
        ScanPtr.byte_lim = Dereference(Add(snap, 160))
        ScanPtr.byte_imm = Dereference(Add(snap, 168))
        ScanPtr.byte_acc = Dereference(Add(snap, 176))
        ScanPtr.byte_keep = Dereference(Add(snap, 184))
        ScanPtr.ctr_name = Dereference(Add(snap, 192))
        ScanPtr.ctr_lim = Dereference(Add(snap, 200))
        ScanPtr.flt_keep = Dereference(Add(snap, 208))
        ScanPtr.park0 = Dereference(Add(snap, 216))
        ScanPtr.park1 = Dereference(Add(snap, 224))
        ScanPtr.park2 = Dereference(Add(snap, 232))
        ScanPtr.loop_body = Dereference(Add(snap, 240))
        ScanPtr.rev1 = Dereference(Add(snap, 248))
        ScanPtr.rev_c = Dereference(Add(snap, 256))
        ScanPtr.walk_lo = Dereference(Add(snap, 264))
        ScanPtr.walk_hi = Dereference(Add(snap, 272))
        ScanPtr.swap = Dereference(Add(snap, 280))
        ScanPtr.swap_a = Dereference(Add(snap, 288))
        ScanPtr.swap_b = Dereference(Add(snap, 296))
        ScanPtr.park1_reg = Dereference(Add(snap, 304))
        ScanPtr.park2_reg = Dereference(Add(snap, 312))
        ScanPtr.byte_bad = 0
        Deallocate(snap, 320)
        IfCondition NotEqual(ScanPtr.flt_keep, 0) ThenBlock: {
            foff = Scope_Resolve(ScanPtr.flt_keep)
            frt = Scope.resolve_type
            fok = 0
            IfCondition EqualTo(frt, 1) ThenBlock: { fok = 1 }
            IfCondition EqualTo(frt, 2) ThenBlock: { fok = 1 }
            IfCondition GreaterEqual(foff, 0) ThenBlock: { fok = 0 }
            IfCondition EqualTo(fok, 1) ThenBlock: {
                X86_EmitRbpXmm(16, 2, foff)
            }
        }
        IfCondition NotEqual(ScanPtr.byte_keep, 0) ThenBlock: {
            Optimize_ScanByteSlot(ScanPtr.byte_keep)
            koff = Scope_Resolve(ScanPtr.byte_keep)
            Emit_MovRaxRbpOffset(koff)
            X86Enc_Assemble("MOV r11, rax")
        }
        IfCondition NotEqual(ScanPtr.byte_name, 0) ThenBlock: {
            IfCondition EqualTo(ScanPtr.byte_iv, 0) ThenBlock: {
                dummy = Optimize_ScanByteReload()
            }
        }
        IfCondition GreaterThan(ScanPtr.n, 0) ThenBlock: { Optimize_ScanPtrReload(0) }
        IfCondition GreaterThan(ScanPtr.n, 1) ThenBlock: { Optimize_ScanPtrReload(1) }
        IfCondition EqualTo(Optimize_ScanFltParkReload(ScanPtr.park0, 3), 0) ThenBlock: {
            ScanPtr.park0 = 0
        }
        IfCondition EqualTo(Optimize_ScanFltParkReload(ScanPtr.park1, ScanPtr.park1_reg), 0) ThenBlock: {
            ScanPtr.park1 = 0
            ScanPtr.park1_reg = -1
        }
        IfCondition EqualTo(Optimize_ScanFltParkReload(ScanPtr.park2, ScanPtr.park2_reg), 0) ThenBlock: {
            ScanPtr.park2 = 0
            ScanPtr.park2_reg = -1
        }
        ReturnValue(0)
    }
}

// The pointer is already in its register. Skip the multiply. A later
// load of the name as a value is rejected before the pointer is armed.
Function.Optimize_ScanPtrDef {
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(Optimize_ScanPtrReg(name), 0) ThenBlock: { ReturnValue(0) }
        Optimize_ScanMatDrop(name)
        ReturnValue(1)
    }
}

// iv = iv + step. The hoisted pointer moves by stride*step.
Function.Optimize_ScanPtrBump {
    Input: name: Address
    Input: value: Address
    Body: {
        IfCondition EqualTo(ScanPtr.n, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(value, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(value), AST.CALL) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(StringCompare(AST_GetData1(value), "Add"), 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetChildCount(value), 2) ThenBlock: { ReturnValue(0) }
        a0 = AST_GetChild(value, 0)
        a1 = AST_GetChild(value, 1)
        num = 0
        ident = 0
        IfCondition NotEqual(a1, 0) ThenBlock: {
            IfCondition EqualTo(AST_GetType(a1), AST.NUMBER) ThenBlock: {
                num = a1
                ident = a0
            }
        }
        IfCondition EqualTo(num, 0) ThenBlock: {
            IfCondition NotEqual(a0, 0) ThenBlock: {
                IfCondition EqualTo(AST_GetType(a0), AST.NUMBER) ThenBlock: {
                    num = a0
                    ident = a1
                }
            }
        }
        IfCondition EqualTo(num, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(ident, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(ident), AST.IDENTIFIER) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_NameEq(AST_GetData1(ident), name), 0) ThenBlock: { ReturnValue(0) }
        st = StringToNumber(AST_GetData1(num))
        IfCondition GreaterThan(ScanPtr.n, 0) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(name, AST_GetData1(ScanPtr.iv0)), 1) ThenBlock: {
                IfCondition EqualTo(st, ScanPtr.step0) ThenBlock: {
                    IfCondition NotEqual(ScanPtr.bump0, 0) ThenBlock: {
                        Optimize_ScanPtrRmKill(ScanPtr.reg0)
                        X86_AddIpImm(ScanPtr.reg0, ScanPtr.bump0)
                    }
                }
            }
        }
        IfCondition GreaterThan(ScanPtr.n, 1) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(name, AST_GetData1(ScanPtr.iv1)), 1) ThenBlock: {
                IfCondition EqualTo(st, ScanPtr.step1) ThenBlock: {
                    IfCondition NotEqual(ScanPtr.bump1, 0) ThenBlock: {
                        amt = ScanPtr.bump1
                        IfCondition NotEqual(ScanPtr.rev1, 0) ThenBlock: {
                            amt = Subtract(0, amt)
                        }
                        Optimize_ScanPtrRmKill(ScanPtr.reg1)
                        X86_AddIpImm(ScanPtr.reg1, amt)
                    }
                }
            }
        }
        ReturnValue(0)
    }
}
