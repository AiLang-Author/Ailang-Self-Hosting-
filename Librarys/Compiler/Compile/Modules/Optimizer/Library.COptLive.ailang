// Library.COptLive.ailang
// Liveness over the block graph built by Library.COptCFG.ailang.
// Per-block def/use is a sound (not maximally precise) union of every
// program point tagged into that block - no intra-block kill
// ordering. Over-estimating a live range is safe for a register
// allocator (it just spills sooner); under-estimating is the kind of
// correctness bug this whole effort exists to stop reproducing. One
// contiguous (min_pos, max_pos) interval per name, not split live
// ranges - a possible future refinement, not required for Milestone 3.
// No consumer yet. Loaded by the optimizer shell. No imports of its own.

// 88 bytes/block: def0, def1, use0, use1, live_in0, live_in1,
// live_out0, live_out1, has_call, exp0, exp1. exp is the uses that
// happen before this block's first def of that name. Reset per
// function, same lifetime as BlockPool (block ids are only unique
// within one function).
FixedPool.LiveState {
    "buf": Initialize=0, CanChange=True
    "cap": Initialize=65536
    "call0": Initialize=0, CanChange=True   // OR of live_in|live_out over every has_call block
    "call1": Initialize=0, CanChange=True
    "audit": Initialize=-1, CanChange=True  // -1 until the environ check, then 0 or 1
    "checked": Initialize=0, CanChange=True
    "miss_in": Initialize=0, CanChange=True
    "over": Initialize=0, CanChange=True    // new=live, old=dead (safe: over-approximation)
    "under": Initialize=0, CanChange=True   // new=dead, old=live (UNSAFE: real bug)
}

// 16 bytes/interned name (1..128): min_pos, max_pos. max_pos stays -1
// for a name nothing ever bounded (should not happen for a name that
// is genuinely interned, but Optimize_LiveInterval reports it rather
// than asserting, consistent with this codebase's null-check style).
FixedPool.NameState {
    "buf": Initialize=0, CanChange=True
    "cost": Initialize=0, CanChange=True
    "nuse": Initialize=0, CanChange=True
    "uses": Initialize=0, CanChange=True
}

Function.Optimize_LiveEnsure {
    Body: {
        IfCondition NotEqual(LiveState.buf, 0) ThenBlock: { ReturnValue(0) }
        LiveState.buf = Allocate(Multiply(LiveState.cap, 88))
        IfCondition EqualTo(LiveState.buf, 0) ThenBlock: {
            PrintMessage("[LIVE] FATAL: live state buf Allocate failed\n")
        }
        ReturnValue(0)
    }
}

Function.Optimize_LiveBlockPtr {
    Input: id: Integer
    Output: Address
    Body: {
        IfCondition LessThan(id, 0) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterEqual(id, LiveState.cap) ThenBlock: { ReturnValue(0) }
        ReturnValue(Add(LiveState.buf, Multiply(id, 88)))
    }
}

Function.Optimize_LiveClearBlock {
    Input: id: Integer
    Body: {
        ptr = Optimize_LiveBlockPtr(id)
        IfCondition EqualTo(ptr, 0) ThenBlock: { ReturnValue(0) }
        w = 0
        WhileLoop LessThan(w, 11) {
            StoreValue(Add(ptr, Multiply(w, 8)), 0)
            w = Add(w, 1)
        }
        ReturnValue(0)
    }
}

Function.Optimize_LiveDef0 { Input: id: Integer Output: Integer Body: { p = Optimize_LiveBlockPtr(id) IfCondition EqualTo(p, 0) ThenBlock: { ReturnValue(0) } ReturnValue(Dereference(p)) } }
Function.Optimize_LiveDef1 { Input: id: Integer Output: Integer Body: { p = Optimize_LiveBlockPtr(id) IfCondition EqualTo(p, 0) ThenBlock: { ReturnValue(0) } ReturnValue(Dereference(Add(p, 8))) } }
Function.Optimize_LiveUse0 { Input: id: Integer Output: Integer Body: { p = Optimize_LiveBlockPtr(id) IfCondition EqualTo(p, 0) ThenBlock: { ReturnValue(0) } ReturnValue(Dereference(Add(p, 16))) } }
Function.Optimize_LiveUse1 { Input: id: Integer Output: Integer Body: { p = Optimize_LiveBlockPtr(id) IfCondition EqualTo(p, 0) ThenBlock: { ReturnValue(0) } ReturnValue(Dereference(Add(p, 24))) } }
Function.Optimize_LiveIn0 { Input: id: Integer Output: Integer Body: { p = Optimize_LiveBlockPtr(id) IfCondition EqualTo(p, 0) ThenBlock: { ReturnValue(0) } ReturnValue(Dereference(Add(p, 32))) } }
Function.Optimize_LiveIn1 { Input: id: Integer Output: Integer Body: { p = Optimize_LiveBlockPtr(id) IfCondition EqualTo(p, 0) ThenBlock: { ReturnValue(0) } ReturnValue(Dereference(Add(p, 40))) } }
Function.Optimize_LiveOut0 { Input: id: Integer Output: Integer Body: { p = Optimize_LiveBlockPtr(id) IfCondition EqualTo(p, 0) ThenBlock: { ReturnValue(0) } ReturnValue(Dereference(Add(p, 48))) } }
Function.Optimize_LiveOut1 { Input: id: Integer Output: Integer Body: { p = Optimize_LiveBlockPtr(id) IfCondition EqualTo(p, 0) ThenBlock: { ReturnValue(0) } ReturnValue(Dereference(Add(p, 56))) } }
Function.Optimize_LiveHasCall { Input: id: Integer Output: Integer Body: { p = Optimize_LiveBlockPtr(id) IfCondition EqualTo(p, 0) ThenBlock: { ReturnValue(0) } ReturnValue(Dereference(Add(p, 64))) } }
Function.Optimize_LiveExp0 { Input: id: Integer Output: Integer Body: { p = Optimize_LiveBlockPtr(id) IfCondition EqualTo(p, 0) ThenBlock: { ReturnValue(0) } ReturnValue(Dereference(Add(p, 72))) } }
Function.Optimize_LiveExp1 { Input: id: Integer Output: Integer Body: { p = Optimize_LiveBlockPtr(id) IfCondition EqualTo(p, 0) ThenBlock: { ReturnValue(0) } ReturnValue(Dereference(Add(p, 80))) } }

Function.Optimize_LiveOrDef {
    Input: id: Integer
    Input: b0: Integer
    Input: b1: Integer
    Body: {
        p = Optimize_LiveBlockPtr(id)
        IfCondition EqualTo(p, 0) ThenBlock: { ReturnValue(0) }
        StoreValue(p, BitwiseOr(Dereference(p), b0))
        StoreValue(Add(p, 8), BitwiseOr(Dereference(Add(p, 8)), b1))
        ReturnValue(0)
    }
}

Function.Optimize_LiveOrUse {
    Input: id: Integer
    Input: b0: Integer
    Input: b1: Integer
    Body: {
        p = Optimize_LiveBlockPtr(id)
        IfCondition EqualTo(p, 0) ThenBlock: { ReturnValue(0) }
        StoreValue(Add(p, 16), BitwiseOr(Dereference(Add(p, 16)), b0))
        StoreValue(Add(p, 24), BitwiseOr(Dereference(Add(p, 24)), b1))
        ReturnValue(0)
    }
}

Function.Optimize_LiveSetHasCall {
    Input: id: Integer
    Body: {
        p = Optimize_LiveBlockPtr(id)
        IfCondition EqualTo(p, 0) ThenBlock: { ReturnValue(0) }
        StoreValue(Add(p, 64), 1)
        ReturnValue(0)
    }
}

Function.Optimize_LiveSetIn {
    Input: id: Integer
    Input: w0: Integer
    Input: w1: Integer
    Body: {
        p = Optimize_LiveBlockPtr(id)
        IfCondition EqualTo(p, 0) ThenBlock: { ReturnValue(0) }
        StoreValue(Add(p, 32), w0)
        StoreValue(Add(p, 40), w1)
        ReturnValue(0)
    }
}

Function.Optimize_LiveSetOut {
    Input: id: Integer
    Input: w0: Integer
    Input: w1: Integer
    Body: {
        p = Optimize_LiveBlockPtr(id)
        IfCondition EqualTo(p, 0) ThenBlock: { ReturnValue(0) }
        StoreValue(Add(p, 48), w0)
        StoreValue(Add(p, 56), w1)
        ReturnValue(0)
    }
}

// Fold one tagged node's def/use/call bits into its block. Recurses
// over the whole subtree so stale tag data from an earlier function
// (block ids are reused per function, unlike the process-lifetime
// AST pool) never leaks in - only nodes actually reachable from this
// function's body are visited.
Function.Optimize_LiveFill {
    Input: node: Address
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        bid = Optimize_TagBlockOf(node)
        IfCondition NotEqual(bid, -1) ThenBlock: {
            rec = Optimize_TagPtr(node)
            IfCondition NotEqual(rec, 0) ThenBlock: {
                eff = Dereference(rec)
                def_id = Dereference(Add(rec, 8))
                u0 = Dereference(Add(rec, 16))
                u1 = Dereference(Add(rec, 24))
                Optimize_LiveOrUse(bid, u0, u1)
                IfCondition NotEqual(def_id, 0) ThenBlock: {
                    IfCondition LessEqual(def_id, 64) ThenBlock: {
                        Optimize_LiveOrDef(bid, LeftShift(1, Subtract(def_id, 1)), 0)
                    } ElseBlock: {
                        Optimize_LiveOrDef(bid, 0, LeftShift(1, Subtract(def_id, 65)))
                    }
                }
                IfCondition NotEqual(BitwiseAnd(eff, TagBit.CALL), 0) ThenBlock: {
                    Optimize_LiveSetHasCall(bid)
                }
            }
        }
        count = AST_GetChildCount(node)
        i = 0
        WhileLoop LessThan(i, count) {
            Optimize_LiveFill(AST_GetChild(node, i))
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

// Backward fixed-point: live_out[B] = union(live_in[succ]),
// live_in[B] = use[B] | (live_out[B] - def[B]). Structured control
// flow means at most one back-edge per loop header, so this settles
// in 1-2 full sweeps per nesting level - a plain repeat-until-stable
// sweep is cheap enough, no worklist needed.
Function.Optimize_LiveSolve {
    Body: {
        changed = 1
        WhileLoop EqualTo(changed, 1) {
            changed = 0
            b = Subtract(BlockPool.head, 1)
            WhileLoop GreaterEqual(b, 0) {
                s0 = Optimize_CFGSucc0(b)
                s1 = Optimize_CFGSucc1(b)
                out0 = 0
                out1 = 0
                IfCondition NotEqual(s0, 0) ThenBlock: {
                    out0 = BitwiseOr(out0, Optimize_LiveIn0(s0))
                    out1 = BitwiseOr(out1, Optimize_LiveIn1(s0))
                }
                IfCondition NotEqual(s1, 0) ThenBlock: {
                    out0 = BitwiseOr(out0, Optimize_LiveIn0(s1))
                    out1 = BitwiseOr(out1, Optimize_LiveIn1(s1))
                }
                notdef0 = BitwiseNot(Optimize_LiveDef0(b))
                notdef1 = BitwiseNot(Optimize_LiveDef1(b))
                // exp is uses before the first def. A later use of a
                // name this block already defined is not live-in, so a
                // loop temp does not become live at function entry.
                in0 = BitwiseOr(Optimize_LiveExp0(b), BitwiseAnd(out0, notdef0))
                in1 = BitwiseOr(Optimize_LiveExp1(b), BitwiseAnd(out1, notdef1))

                IfCondition NotEqual(in0, Optimize_LiveIn0(b)) ThenBlock: { changed = 1 }
                IfCondition NotEqual(in1, Optimize_LiveIn1(b)) ThenBlock: { changed = 1 }
                IfCondition NotEqual(out0, Optimize_LiveOut0(b)) ThenBlock: { changed = 1 }
                IfCondition NotEqual(out1, Optimize_LiveOut1(b)) ThenBlock: { changed = 1 }

                Optimize_LiveSetIn(b, in0, in1)
                Optimize_LiveSetOut(b, out0, out1)
                b = Subtract(b, 1)
            }
        }
        ReturnValue(0)
    }
}

// name's bit set in live_in(b) extends the interval down to that
// block's first real statement; live_out(b) extends it up to the
// last. Blocks with no statement of their own (pos_start == -1, pure
// dispatch blocks like a loop header) cannot bound anything - the
// dataflow already threaded liveness through them into their
// neighbors, which do have real positions.
Function.Optimize_LiveTouch {
    Input: id: Integer
    Input: pos: Integer
    Input: w: Integer
    Body: {
        IfCondition Or(LessThan(id, 1), GreaterThan(id, 128)) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(pos, 0) ThenBlock: { ReturnValue(0) }
        slot = Add(NameState.buf, Multiply(Subtract(id, 1), 16))
        IfCondition LessThan(pos, Dereference(slot)) ThenBlock: { StoreValue(slot, pos) }
        IfCondition GreaterThan(pos, Dereference(Add(slot, 8))) ThenBlock: { StoreValue(Add(slot, 8), pos) }
        IfCondition NotEqual(NameState.nuse, 0) ThenBlock: {
            IfCondition NotEqual(NameState.uses, 0) ThenBlock: {
                ui = Subtract(id, 1)
                cnt = Dereference(Add(NameState.nuse, Multiply(ui, 8)))
                IfCondition LessThan(cnt, 8) ThenBlock: {
                    dup = 0
                    IfCondition GreaterThan(cnt, 0) ThenBlock: {
                        prev = Dereference(Add(NameState.uses, Multiply(Add(Multiply(ui, 8), Subtract(cnt, 1)), 8)))
                        IfCondition EqualTo(prev, pos) ThenBlock: { dup = 1 }
                    }
                    IfCondition EqualTo(dup, 0) ThenBlock: {
                        StoreValue(Add(NameState.uses, Multiply(Add(Multiply(ui, 8), cnt), 8)), pos)
                        StoreValue(Add(NameState.nuse, Multiply(ui, 8)), Add(cnt, 1))
                    }
                }
            }
        }
        ReturnValue(0)
    }
}

// Next statement at or after `from` that mentions id. 2147483647 means
// no later mention. A full 8-slot list with nothing left means a later
// mention was dropped, so the name is treated as used soon.
Function.Optimize_LiveNext {
    Input: id: Integer
    Input: from: Integer
    Output: Integer
    Body: {
        IfCondition Or(LessThan(id, 1), GreaterThan(id, 128)) ThenBlock: { ReturnValue(2147483647) }
        IfCondition EqualTo(NameState.nuse, 0) ThenBlock: { ReturnValue(2147483647) }
        IfCondition EqualTo(NameState.uses, 0) ThenBlock: { ReturnValue(2147483647) }
        ui = Subtract(id, 1)
        cnt = Dereference(Add(NameState.nuse, Multiply(ui, 8)))
        capped = 0
        IfCondition GreaterThan(cnt, 8) ThenBlock: {
            cnt = 8
            capped = 1
        }
        IfCondition EqualTo(cnt, 8) ThenBlock: { capped = 1 }
        best = 2147483647
        i = 0
        WhileLoop LessThan(i, cnt) {
            p = Dereference(Add(NameState.uses, Multiply(Add(Multiply(ui, 8), i), 8)))
            IfCondition GreaterEqual(p, from) ThenBlock: {
                IfCondition LessThan(p, best) ThenBlock: { best = p }
            }
            i = Add(i, 1)
        }
        IfCondition EqualTo(best, 2147483647) ThenBlock: {
            IfCondition EqualTo(capped, 1) ThenBlock: { ReturnValue(from) }
        }
        ReturnValue(best)
    }
}

Function.Optimize_LiveTouchMask {
    Input: bits: Integer
    Input: base: Integer
    Input: pos: Integer
    Input: w: Integer
    Body: {
        k = 0
        WhileLoop LessThan(k, 64) {
            IfCondition NotEqual(BitwiseAnd(bits, LeftShift(1, k)), 0) ThenBlock: {
                Optimize_LiveTouch(Add(base, k), pos, w)
            }
            k = Add(k, 1)
        }
        ReturnValue(0)
    }
}

// One reload from the stack, scaled by loop nesting. Depth 0 is 1,
// each enclosing loop multiplies by 10. The spill choice compares
// these, not which interval happens to end later.
Function.Optimize_LiveCost {
    Input: id: Integer
    Output: Integer
    Body: {
        IfCondition Or(LessThan(id, 1), GreaterThan(id, 128)) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(NameState.cost, 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(Dereference(Add(NameState.cost, Multiply(Subtract(id, 1), 8))))
    }
}

// One position per statement. Uses and the def of that statement share
// the position. A name's range is the first mention through the last.
Function.Optimize_LiveSpan {
    Input: node: Address
    Input: depth: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        w = 1
        d = depth
        WhileLoop GreaterThan(d, 0) {
            IfCondition LessThan(w, 100000) ThenBlock: { w = Multiply(w, 10) }
            d = Subtract(d, 1)
        }
        bid = Optimize_TagBlockOf(node)
        IfCondition NotEqual(bid, -1) ThenBlock: {
            pos = Optimize_TagPosOf(node)
            rec = Optimize_TagPtr(node)
            IfCondition NotEqual(rec, 0) ThenBlock: {
                Optimize_LiveTouchMask(Dereference(Add(rec, 16)), 1, pos, w)
                Optimize_LiveTouchMask(Dereference(Add(rec, 24)), 65, pos, w)
                def_id = Dereference(Add(rec, 8))
                IfCondition GreaterThan(def_id, 0) ThenBlock: {
                    Optimize_LiveTouch(def_id, pos, w)
                }
            }
        }
        next = depth
        nt = AST_GetType(node)
        IfCondition EqualTo(nt, AST.WHILE) ThenBlock: { next = Add(depth, 1) }
        IfCondition EqualTo(nt, AST.FOR_EVERY) ThenBlock: { next = Add(depth, 1) }
        count = AST_GetChildCount(node)
        i = 0
        WhileLoop LessThan(i, count) {
            Optimize_LiveSpan(AST_GetChild(node, i), next)
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

// Uses that occur before this block defines the name. Later uses of a
// value defined in the same block are not live on the way in.
Function.Optimize_LiveExpose {
    Input: node: Address
    Body: {
        nblk = BlockPool.head
        IfCondition LessEqual(nblk, 0) ThenBlock: { ReturnValue(0) }
        bytes = Multiply(nblk, 8)
        k0 = Allocate(bytes)
        k1 = Allocate(bytes)
        IfCondition EqualTo(k0, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(k1, 0) ThenBlock: {
            Deallocate(k0, bytes)
            ReturnValue(0)
        }
        i = 0
        WhileLoop LessThan(i, nblk) {
            StoreValue(Add(k0, Multiply(i, 8)), 0)
            StoreValue(Add(k1, Multiply(i, 8)), 0)
            i = Add(i, 1)
        }
        Optimize_LiveExposeNode(node, k0, k1)
        Deallocate(k0, bytes)
        Deallocate(k1, bytes)
        ReturnValue(0)
    }
}

Function.Optimize_LiveExposeNode {
    Input: node: Address
    Input: k0: Address
    Input: k1: Address
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        bid = Optimize_TagBlockOf(node)
        IfCondition NotEqual(bid, -1) ThenBlock: {
            IfCondition LessThan(bid, BlockPool.head) ThenBlock: {
                rec = Optimize_TagPtr(node)
                IfCondition NotEqual(rec, 0) ThenBlock: {
                    u0 = Dereference(Add(rec, 16))
                    u1 = Dereference(Add(rec, 24))
                    killed0 = Dereference(Add(k0, Multiply(bid, 8)))
                    killed1 = Dereference(Add(k1, Multiply(bid, 8)))
                    exp0 = BitwiseAnd(u0, BitwiseNot(killed0))
                    exp1 = BitwiseAnd(u1, BitwiseNot(killed1))
                    p = Optimize_LiveBlockPtr(bid)
                    IfCondition NotEqual(p, 0) ThenBlock: {
                        StoreValue(Add(p, 72), BitwiseOr(Dereference(Add(p, 72)), exp0))
                        StoreValue(Add(p, 80), BitwiseOr(Dereference(Add(p, 80)), exp1))
                    }
                    def_id = Dereference(Add(rec, 8))
                    IfCondition GreaterThan(def_id, 0) ThenBlock: {
                        IfCondition LessEqual(def_id, 64) ThenBlock: {
                            bit = LeftShift(1, Subtract(def_id, 1))
                            StoreValue(Add(k0, Multiply(bid, 8)), BitwiseOr(killed0, bit))
                        } ElseBlock: {
                            bit = LeftShift(1, Subtract(def_id, 65))
                            StoreValue(Add(k1, Multiply(bid, 8)), BitwiseOr(killed1, bit))
                        }
                    }
                }
            }
        }
        count = AST_GetChildCount(node)
        i = 0
        WhileLoop LessThan(i, count) {
            Optimize_LiveExposeNode(AST_GetChild(node, i), k0, k1)
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

Function.Optimize_LiveInterval {
    Input: body: Address
    Body: {
        n = Allocate(Multiply(128, 16))
        NameState.buf = n
        i = 0
        WhileLoop LessThan(i, 128) {
            StoreValue(Add(n, Multiply(i, 16)), 2147483647)
            StoreValue(Add(n, Add(Multiply(i, 16), 8)), -1)
            i = Add(i, 1)
        }

        LiveState.call0 = 0
        LiveState.call1 = 0

        // Mention bounds are the statement positions. live-in pulls the
        // start back to the block entry, live-out pushes the end out to
        // the block exit. A temp that dies mid-block does not cover it.
        IfCondition EqualTo(NameState.nuse, 0) ThenBlock: {
            NameState.nuse = Allocate(1024)
        }
        IfCondition EqualTo(NameState.uses, 0) ThenBlock: {
            NameState.uses = Allocate(8192)
        }
        ci = 0
        WhileLoop LessThan(ci, 128) {
            IfCondition NotEqual(NameState.nuse, 0) ThenBlock: {
                StoreValue(Add(NameState.nuse, Multiply(ci, 8)), 0)
            }
            ci = Add(ci, 1)
        }
        Optimize_LiveSpan(body, 0)

        b = 0
        WhileLoop LessThan(b, BlockPool.head) {
            ps = Optimize_CFGPosStart(b)
            pe = Optimize_CFGPosEnd(b)
            lo0 = BitwiseOr(Optimize_LiveIn0(b), BitwiseOr(Optimize_LiveUse0(b), Optimize_LiveDef0(b)))
            lo1 = BitwiseOr(Optimize_LiveIn1(b), BitwiseOr(Optimize_LiveUse1(b), Optimize_LiveDef1(b)))
            in0 = Optimize_LiveIn0(b)
            in1 = Optimize_LiveIn1(b)
            out0 = Optimize_LiveOut0(b)
            out1 = Optimize_LiveOut1(b)

            IfCondition NotEqual(ps, -1) ThenBlock: {
                k = 0
                WhileLoop LessThan(k, 64) {
                    IfCondition NotEqual(BitwiseAnd(in0, LeftShift(1, k)), 0) ThenBlock: {
                        slot = Add(n, Multiply(k, 16))
                        IfCondition LessThan(ps, Dereference(slot)) ThenBlock: { StoreValue(slot, ps) }
                        IfCondition LessThan(Dereference(Add(slot, 8)), ps) ThenBlock: { StoreValue(Add(slot, 8), ps) }
                    }
                    IfCondition NotEqual(BitwiseAnd(in1, LeftShift(1, k)), 0) ThenBlock: {
                        slot = Add(n, Multiply(Add(k, 64), 16))
                        IfCondition LessThan(ps, Dereference(slot)) ThenBlock: { StoreValue(slot, ps) }
                        IfCondition LessThan(Dereference(Add(slot, 8)), ps) ThenBlock: { StoreValue(Add(slot, 8), ps) }
                    }
                    k = Add(k, 1)
                }
            }
            IfCondition NotEqual(pe, -1) ThenBlock: {
                k = 0
                WhileLoop LessThan(k, 64) {
                    IfCondition NotEqual(BitwiseAnd(out0, LeftShift(1, k)), 0) ThenBlock: {
                        slot = Add(n, Multiply(k, 16))
                        IfCondition GreaterThan(pe, Dereference(Add(slot, 8))) ThenBlock: { StoreValue(Add(slot, 8), pe) }
                        IfCondition GreaterThan(Dereference(slot), pe) ThenBlock: { StoreValue(slot, pe) }
                    }
                    IfCondition NotEqual(BitwiseAnd(out1, LeftShift(1, k)), 0) ThenBlock: {
                        slot = Add(n, Multiply(Add(k, 64), 16))
                        IfCondition GreaterThan(pe, Dereference(Add(slot, 8))) ThenBlock: { StoreValue(Add(slot, 8), pe) }
                        IfCondition GreaterThan(Dereference(slot), pe) ThenBlock: { StoreValue(slot, pe) }
                    }
                    k = Add(k, 1)
                }
            }

            // No intra-block ordering, so a name touched anywhere in a
            // call-bearing block is conservatively marked as crossing it -
            // safe (just a missed register-reuse opportunity) rather than
            // unsound.
            IfCondition EqualTo(Optimize_LiveHasCall(b), 1) ThenBlock: {
                LiveState.call0 = BitwiseOr(LiveState.call0, lo0)
                LiveState.call1 = BitwiseOr(LiveState.call1, lo1)
            }
            b = Add(b, 1)
        }
        ReturnValue(0)
    }
}

Function.Optimize_LiveMinPos { Input: id: Integer Output: Integer Body: {
    IfCondition Or(LessThan(id, 1), GreaterThan(id, 128)) ThenBlock: { ReturnValue(-1) }
    ReturnValue(Dereference(Add(NameState.buf, Multiply(Subtract(id, 1), 16))))
} }
Function.Optimize_LiveMaxPos { Input: id: Integer Output: Integer Body: {
    IfCondition Or(LessThan(id, 1), GreaterThan(id, 128)) ThenBlock: { ReturnValue(-1) }
    ReturnValue(Dereference(Add(Add(NameState.buf, Multiply(Subtract(id, 1), 16)), 8)))
} }

// 1 when a real function call's live-in|live-out set includes this
// name anywhere in the function - the structural replacement for
// CompileFunc_HasCalls (C8) and the real caller-saved/callee-saved
// decision input (C2), once Milestone 3 consumes it.
Function.Optimize_LiveCrossesCall {
    Input: id: Integer
    Output: Integer
    Body: {
        IfCondition Or(LessThan(id, 1), GreaterThan(id, 128)) ThenBlock: { ReturnValue(0) }
        IfCondition LessEqual(id, 64) ThenBlock: {
            IfCondition NotEqual(BitwiseAnd(LiveState.call0, LeftShift(1, Subtract(id, 1))), 0) ThenBlock: { ReturnValue(1) }
            ReturnValue(0)
        }
        IfCondition NotEqual(BitwiseAnd(LiveState.call1, LeftShift(1, Subtract(id, 65))), 0) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

// Run the whole pipeline for one function: Optimize_TagFunction and
// Optimize_CFGFunction must already have run on the same body (the
// caller does this once, in that order - see CompileFunc_Function).
Function.Optimize_LiveFunction {
    Input: body: Address
    Body: {
        Optimize_LiveEnsure()
        IfCondition EqualTo(LiveState.buf, 0) ThenBlock: { ReturnValue(0) }
        b = 0
        WhileLoop LessThan(b, BlockPool.head) {
            Optimize_LiveClearBlock(b)
            b = Add(b, 1)
        }
        Optimize_LiveFill(body)
        Optimize_LiveExpose(body)
        Optimize_LiveSolve()
        Optimize_LiveInterval(body)
        IfCondition EqualTo(Optimize_LiveWantAudit(), 1) ThenBlock: {
            LiveState.checked = 0
            LiveState.miss_in = 0
            LiveState.over = 0
            LiveState.under = 0
            Optimize_LiveAuditNode(body)
            Optimize_LiveReport()
        }
        ReturnValue(0)
    }
}

// 1 when AILANG_LIVE_AUDIT=1 is in the environment. Same check
// Optimize_TagWantAudit already does, under a different variable -
// kept separate rather than shared so each pass's audit can be
// toggled independently.
Function.Optimize_LiveWantAudit {
    Output: Integer
    Body: {
        IfCondition GreaterEqual(LiveState.audit, 0) ThenBlock: { ReturnValue(LiveState.audit) }
        LiveState.audit = 0
        envpath = "/proc/self/environ"
        env_fd = SystemCall(2, envpath, 0, 0)
        IfCondition LessThan(env_fd, 0) ThenBlock: { ReturnValue(0) }
        env_bufsz = 131072
        env_buf = Allocate(env_bufsz)
        env_n = SystemCall(0, env_fd, env_buf, env_bufsz)
        SystemCall(3, env_fd, 0, 0)
        needle = "AILANG_LIVE_AUDIT="
        nlen = 18
        found = 0
        ei = 0
        elimit = Subtract(env_n, nlen)
        WhileLoop LessEqual(ei, elimit) {
            IfCondition EqualTo(found, 1) ThenBlock: { ExitLoop }
            match = 1
            ej = 0
            WhileLoop LessThan(ej, nlen) {
                bc = GetByte(env_buf, Add(ei, ej))
                nc = GetByte(needle, ej)
                IfCondition NotEqual(bc, nc) ThenBlock: { match = 0 }
                ej = Add(ej, 1)
            }
            IfCondition EqualTo(match, 1) ThenBlock: {
                vc = GetByte(env_buf, Add(ei, nlen))
                IfCondition EqualTo(vc, 49) ThenBlock: { LiveState.audit = 1 }
                found = 1
            }
            ei = Add(ei, 1)
        }
        Deallocate(env_buf, env_bufsz)
        ReturnValue(LiveState.audit)
    }
}

// Cross-checks one WHILE node's loop-entry liveness against this
// pass's header-block live_in. The condition is tagged directly on
// its header block (see Optimize_CFGWalkWhile), so that block id is
// just the condition node's own recorded block.
Function.Optimize_LiveAuditWhile {
    Input: node: Address
    Body: {
        cond = AST_GetChild(node, 0)
        body = AST_GetChild(node, 1)
        header_id = Optimize_TagBlockOf(cond)
        IfCondition LessThan(header_id, 0) ThenBlock: { ReturnValue(0) }
        in0 = Optimize_LiveIn0(header_id)
        in1 = Optimize_LiveIn1(header_id)
        i = 0
        WhileLoop LessThan(i, TagState.nnames) {
            name = Dereference(Add(TagState.names, Multiply(i, 8)))
            id = Add(i, 1)
            got = 0
            IfCondition LessEqual(id, 64) ThenBlock: {
                IfCondition NotEqual(BitwiseAnd(in0, LeftShift(1, Subtract(id, 1))), 0) ThenBlock: { got = 1 }
            } ElseBlock: {
                IfCondition NotEqual(BitwiseAnd(in1, LeftShift(1, Subtract(id, 65))), 0) ThenBlock: { got = 1 }
            }
            want = Optimize_LiveIn(name, cond, body)
            LiveState.checked = Add(LiveState.checked, 1)
            IfCondition NotEqual(got, want) ThenBlock: {
                LiveState.miss_in = Add(LiveState.miss_in, 1)
                IfCondition EqualTo(want, 0) ThenBlock: {
                    LiveState.over = Add(LiveState.over, 1)
                } ElseBlock: {
                    LiveState.under = Add(LiveState.under, 1)
                    PrintMessage("[LIVE] UNDER-estimate: ")
                    PrintString(name)
                    PrintMessage(" old=live new=dead at line ")
                    PrintNumber(AST_GetLine(node))
                    PrintMessage("\n")
                }
            }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

Function.Optimize_LiveAuditNode {
    Input: node: Address
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(AST_GetType(node), AST.WHILE) ThenBlock: {
            Optimize_LiveAuditWhile(node)
        }
        count = AST_GetChildCount(node)
        i = 0
        WhileLoop LessThan(i, count) {
            Optimize_LiveAuditNode(AST_GetChild(node, i))
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

Function.Optimize_LiveReport {
    Body: {
        IfCondition EqualTo(LiveState.checked, 0) ThenBlock: { ReturnValue(0) }
        PrintMessage("LIVE checked ")
        PrintNumber(LiveState.checked)
        PrintMessage(" miss_in ")
        PrintNumber(LiveState.miss_in)
        PrintMessage(" over ")
        PrintNumber(LiveState.over)
        PrintMessage(" under ")
        PrintNumber(LiveState.under)
        PrintMessage("\n")
        ReturnValue(0)
    }
}

// Manual-verification helper, mirrors Optimize_CFGDump. Not called by
// any production path.
Function.Optimize_LiveDump {
    Body: {
        PrintMessage("[LIVE] blocks=")
        PrintNumber(BlockPool.head)
        PrintMessage("\n")
        b = 0
        WhileLoop LessThan(b, BlockPool.head) {
            PrintMessage("  B")
            PrintNumber(b)
            PrintMessage(" def=")
            PrintNumber(Optimize_LiveDef0(b))
            PrintMessage("/")
            PrintNumber(Optimize_LiveDef1(b))
            PrintMessage(" use=")
            PrintNumber(Optimize_LiveUse0(b))
            PrintMessage("/")
            PrintNumber(Optimize_LiveUse1(b))
            PrintMessage(" in=")
            PrintNumber(Optimize_LiveIn0(b))
            PrintMessage("/")
            PrintNumber(Optimize_LiveIn1(b))
            PrintMessage(" out=")
            PrintNumber(Optimize_LiveOut0(b))
            PrintMessage("/")
            PrintNumber(Optimize_LiveOut1(b))
            IfCondition EqualTo(Optimize_LiveHasCall(b), 1) ThenBlock: {
                PrintMessage(" [call]")
            }
            PrintMessage("\n")
            b = Add(b, 1)
        }
        i = 1
        WhileLoop LessThan(i, Add(TagState.nnames, 1)) {
            mn = Optimize_LiveMinPos(i)
            mx = Optimize_LiveMaxPos(i)
            IfCondition NotEqual(mx, -1) ThenBlock: {
                PrintMessage("  name#")
                PrintNumber(i)
                PrintMessage(" [")
                PrintNumber(mn)
                PrintMessage("..")
                PrintNumber(mx)
                PrintMessage("]")
                IfCondition EqualTo(Optimize_LiveCrossesCall(i), 1) ThenBlock: {
                    PrintMessage(" crosses-call")
                }
                PrintMessage("\n")
            }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}
