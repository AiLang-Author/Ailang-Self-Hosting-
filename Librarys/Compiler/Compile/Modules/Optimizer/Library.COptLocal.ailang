// Library.COptLocal.ailang
// Integer hold, byte address, and known multiply.
// Loaded by the optimizer shell. No imports of its own.

// One outstanding integer temp. It stays in rax, or moves to rbx when the
// next instruction needs rax. The frame slot is written before anything
// that would read the slot or clobber both registers.

Function.Optimize_IholdClear {
    Output: Integer
    Body: {
        LoopHome.ihold_on = 0
        LoopHome.ihold_name = 0
        LoopHome.ihold_off = 0
        LoopHome.ihold_reg = 0
        ReturnValue(0)
    }
}

Function.Optimize_IholdFlush {
    Output: Integer
    Body: {
        IfCondition EqualTo(LoopHome.ihold_on, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(LoopHome.ihold_reg, 3) ThenBlock: {
            Emit_MovRaxRbx()
        }
        Emit_MovRbpOffsetRax(LoopHome.ihold_off)
        Optimize_IholdClear()
        ReturnValue(0)
    }
}

Function.Optimize_IholdPark {
    Output: Integer
    Body: {
        IfCondition EqualTo(LoopHome.ihold_on, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(LoopHome.ihold_reg, 3) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(LoopHome.ihold_reg, 0) ThenBlock: {
            IfCondition EqualTo(LoopHome.rbx_scratch, 1) ThenBlock: {
                Emit_MovRbxRax()
                LoopHome.ihold_reg = 3
                ReturnValue(0)
            }
        }
        Optimize_IholdFlush()
        ReturnValue(0)
    }
}

// A call that lowers through rbx, or a real call, cannot keep the byte there.

Function.Optimize_RbxName {
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(StringCompare(name, "GetByte"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "SetByte"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "StoreValue"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "Modulo"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "Divide"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "Dereference"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "Float_Abs"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(Optimize_IsMathOp(name), 1) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(Optimize_HomeCallOk(name), 0) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

Function.Optimize_NeedsRbx {
    Input: node: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(AST_GetType(node), AST.CALL) ThenBlock: {
            IfCondition EqualTo(Optimize_RbxName(AST_GetData1(node)), 1) ThenBlock: { ReturnValue(1) }
        }
        count = AST_GetChildCount(node)
        i = 0
        WhileLoop LessThan(i, count) {
            IfCondition EqualTo(Optimize_NeedsRbx(AST_GetChild(node, i)), 1) ThenBlock: { ReturnValue(1) }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

Function.Optimize_IholdMakeRoom {
    Input: node: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(LoopHome.ihold_on, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_TreeHasIdent(node, LoopHome.ihold_name), 1) ThenBlock: {
            Optimize_IholdFlush()
            ReturnValue(0)
        }
        IfCondition EqualTo(Optimize_NeedsRbx(node), 1) ThenBlock: {
            Optimize_IholdFlush()
            ReturnValue(0)
        }
        Optimize_IholdPark()
        ReturnValue(0)
    }
}

Function.Optimize_IdentName {
    Input: node: Address
    Output: Address
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(node), AST.IDENTIFIER) ThenBlock: { ReturnValue(0) }
        ReturnValue(AST_GetData1(node))
    }
}

Function.Optimize_LogicComm {
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(StringCompare(name, "Add"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "BitwiseXor"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "BitXor"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "BitwiseOr"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "BitOr"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "BitwiseAnd"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "BitAnd"), 0) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

// The acc is already chosen, but active is still 0 while homes are picked.
// IsAccHome would refuse. Compare the name.

Function.Optimize_AccName {
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(LoopHome.acc_name, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_NameEq(name, LoopHome.acc_name), 1) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

Function.Optimize_IholdShape {
    Input: st: Address
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(st, 0) ThenBlock: { ReturnValue(0) }
        nt = AST_GetType(st)
        IfCondition EqualTo(nt, AST.CALL) ThenBlock: {
            IfCondition EqualTo(StringCompare(AST_GetData1(st), "SetByte"), 0) ThenBlock: {
                IfCondition GreaterEqual(AST_GetChildCount(st), 3) ThenBlock: {
                    IfCondition EqualTo(Optimize_NameEq(Optimize_IdentName(AST_GetChild(st, 1)), name), 1) ThenBlock: { ReturnValue(1) }
                    IfCondition EqualTo(Optimize_NameEq(Optimize_IdentName(AST_GetChild(st, 2)), name), 1) ThenBlock: { ReturnValue(1) }
                }
            }
            ReturnValue(0)
        }
        IfCondition NotEqual(nt, AST.ASSIGNMENT) ThenBlock: { ReturnValue(0) }
        value = AST_GetChild(st, 0)
        IfCondition EqualTo(value, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(value), AST.CALL) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetChildCount(value), 2) ThenBlock: { ReturnValue(0) }
        op = AST_GetData1(value)
        IfCondition EqualTo(StringCompare(op, "GetByte"), 0) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(Optimize_IdentName(AST_GetChild(value, 1)), name), 1) ThenBlock: { ReturnValue(1) }
            ReturnValue(0)
        }
        IfCondition EqualTo(Optimize_AccName(AST_GetData1(st)), 0) ThenBlock: { ReturnValue(0) }
        left = AST_GetChild(value, 0)
        right = AST_GetChild(value, 1)
        ln = Optimize_IdentName(left)
        rn = Optimize_IdentName(right)
        IfCondition EqualTo(Optimize_LogicComm(op), 1) ThenBlock: {
            hit = 0
            IfCondition EqualTo(Optimize_AccName(ln), 1) ThenBlock: {
                IfCondition EqualTo(Optimize_NameEq(rn, name), 1) ThenBlock: { hit = 1 }
            }
            IfCondition EqualTo(Optimize_AccName(rn), 1) ThenBlock: {
                IfCondition EqualTo(Optimize_NameEq(ln, name), 1) ThenBlock: { hit = 1 }
            }
            ReturnValue(hit)
        }
        IfCondition EqualTo(StringCompare(op, "Subtract"), 0) ThenBlock: {
            IfCondition EqualTo(Optimize_AccName(ln), 0) ThenBlock: { ReturnValue(0) }
            IfCondition EqualTo(Optimize_NameEq(rn, name), 1) ThenBlock: { ReturnValue(1) }
        }
        ReturnValue(0)
    }
}

Function.Optimize_IholdUseOk {
    Input: name: Address
    Output: Integer
    Body: {
        body = LoopHome.body
        IfCondition EqualTo(body, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(body), AST.BLOCK) ThenBlock: { ReturnValue(0) }
        count = AST_GetChildCount(body)
        def_at = -1
        use_at = -1
        use_st = 0
        i = 0
        WhileLoop LessThan(i, count) {
            st = AST_GetChild(body, i)
            IfCondition NotEqual(st, 0) ThenBlock: {
                IfCondition EqualTo(AST_GetType(st), AST.ASSIGNMENT) ThenBlock: {
                    IfCondition EqualTo(Optimize_NameEq(AST_GetData1(st), name), 1) ThenBlock: {
                        IfCondition LessThan(def_at, 0) ThenBlock: { def_at = i }
                    }
                }
                IfCondition EqualTo(Optimize_TreeHasIdent(st, name), 1) ThenBlock: {
                    IfCondition LessThan(use_at, 0) ThenBlock: {
                        use_at = i
                        use_st = st
                    }
                }
            }
            i = Add(i, 1)
        }
        IfCondition LessThan(def_at, 0) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterThan(use_at, def_at) ThenBlock: {
            ReturnValue(Optimize_IholdShape(use_st, name))
        }
        ReturnValue(0)
    }
}

Function.Optimize_ShouldIhold {
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(LoopHome.active, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_NameTaken(name), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_HoldOk(name), 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(LoopHome.cond, 0) ThenBlock: {
            IfCondition EqualTo(Optimize_NodeReads(LoopHome.cond, name), 1) ThenBlock: { ReturnValue(0) }
        }
        ReturnValue(Optimize_IholdUseOk(name))
    }
}

Function.Optimize_IholdArm {
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(Optimize_ShouldIhold(name), 0) ThenBlock: { ReturnValue(0) }
        off = 0
        IfCondition EqualTo(Optimize_FrameOff(name), 1) ThenBlock: {
            off = LoopHome.imm_val
        } ElseBlock: {
            rt = Scope.resolve_type
            IfCondition NotEqual(rt, 0) ThenBlock: { ReturnValue(0) }
            off = Optimize_EnsureSlot(name)
            IfCondition GreaterEqual(off, 0) ThenBlock: { ReturnValue(0) }
        }
        IfCondition GreaterEqual(off, 0) ThenBlock: { ReturnValue(0) }
        LoopHome.ihold_on = 1
        LoopHome.ihold_name = name
        LoopHome.ihold_off = off
        LoopHome.ihold_reg = 0
        ReturnValue(1)
    }
}

Function.Optimize_TryIntHold {
    Input: target: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(LoopHome.ihold_on, 1) ThenBlock: { ReturnValue(0) }
        ReturnValue(Optimize_IholdArm(target))
    }
}

Function.Optimize_EmitAccOp {
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(StringCompare(name, "Add"), 0) ThenBlock: {
            X86_AddRegReg(12, 0)
            ReturnValue(1)
        }
        IfCondition EqualTo(StringCompare(name, "Subtract"), 0) ThenBlock: {
            X86_SubRegReg(12, 0)
            ReturnValue(1)
        }
        IfCondition EqualTo(StringCompare(name, "BitwiseXor"), 0) ThenBlock: {
            X86_XorRegReg(12, 0)
            ReturnValue(1)
        }
        IfCondition EqualTo(StringCompare(name, "BitXor"), 0) ThenBlock: {
            X86_XorRegReg(12, 0)
            ReturnValue(1)
        }
        IfCondition EqualTo(StringCompare(name, "BitwiseOr"), 0) ThenBlock: {
            X86_OrRegReg(12, 0)
            ReturnValue(1)
        }
        IfCondition EqualTo(StringCompare(name, "BitOr"), 0) ThenBlock: {
            X86_OrRegReg(12, 0)
            ReturnValue(1)
        }
        IfCondition EqualTo(StringCompare(name, "BitwiseAnd"), 0) ThenBlock: {
            X86_AndRegReg(12, 0)
            ReturnValue(1)
        }
        IfCondition EqualTo(StringCompare(name, "BitAnd"), 0) ThenBlock: {
            X86_AndRegReg(12, 0)
            ReturnValue(1)
        }
        ReturnValue(0)
    }
}

// acc = acc op held, or acc = acc * parked multiplier. The multiply does
// not read rax or rbx, so a live byte hold survives it.

Function.Optimize_TryAccLogic {
    Input: target: Address
    Input: value: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(Optimize_IsAccHome(target), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(value, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(value), AST.CALL) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetChildCount(value), 2) ThenBlock: { ReturnValue(0) }
        op = AST_GetData1(value)
        left = AST_GetChild(value, 0)
        right = AST_GetChild(value, 1)
        ln = Optimize_IdentName(left)
        rn = Optimize_IdentName(right)
        IfCondition EqualTo(StringCompare(op, "Multiply"), 0) ThenBlock: {
            IfCondition EqualTo(LoopHome.kmul_on, 0) ThenBlock: { ReturnValue(0) }
            pair = 0
            IfCondition EqualTo(Optimize_AccName(ln), 1) ThenBlock: {
                IfCondition EqualTo(Optimize_NameEq(rn, LoopHome.kmul_name), 1) ThenBlock: { pair = 1 }
            }
            IfCondition EqualTo(Optimize_AccName(rn), 1) ThenBlock: {
                IfCondition EqualTo(Optimize_NameEq(ln, LoopHome.kmul_name), 1) ThenBlock: { pair = 1 }
            }
            IfCondition EqualTo(pair, 0) ThenBlock: { ReturnValue(0) }
            X86_ImulRegReg(12, 11)
            ReturnValue(1)
        }
        IfCondition EqualTo(LoopHome.ihold_on, 0) ThenBlock: { ReturnValue(0) }
        comm = Optimize_LogicComm(op)
        sub = 0
        IfCondition EqualTo(StringCompare(op, "Subtract"), 0) ThenBlock: { sub = 1 }
        IfCondition EqualTo(comm, 0) ThenBlock: {
            IfCondition EqualTo(sub, 0) ThenBlock: { ReturnValue(0) }
        }
        pair = 0
        IfCondition EqualTo(comm, 1) ThenBlock: {
            IfCondition EqualTo(Optimize_AccName(ln), 1) ThenBlock: {
                IfCondition EqualTo(Optimize_NameEq(rn, LoopHome.ihold_name), 1) ThenBlock: { pair = 1 }
            }
            IfCondition EqualTo(Optimize_AccName(rn), 1) ThenBlock: {
                IfCondition EqualTo(Optimize_NameEq(ln, LoopHome.ihold_name), 1) ThenBlock: { pair = 1 }
            }
        }
        IfCondition EqualTo(sub, 1) ThenBlock: {
            IfCondition EqualTo(Optimize_AccName(ln), 1) ThenBlock: {
                IfCondition EqualTo(Optimize_NameEq(rn, LoopHome.ihold_name), 1) ThenBlock: { pair = 1 }
            }
        }
        IfCondition EqualTo(pair, 0) ThenBlock: { ReturnValue(0) }
        reg = LoopHome.ihold_reg
        IfCondition EqualTo(reg, 3) ThenBlock: { Emit_MovRaxRbx() }
        IfCondition NotEqual(reg, 0) ThenBlock: {
            IfCondition NotEqual(reg, 3) ThenBlock: { ReturnValue(0) }
        }
        IfCondition EqualTo(Optimize_EmitAccOp(op), 0) ThenBlock: { ReturnValue(0) }
        Optimize_IholdClear()
        ReturnValue(1)
    }
}

// Index register for a byte address. 0 is rax, so failure is -1.

Function.Optimize_IndexReg {
    Input: node: Address
    Output: Integer
    Body: {
        name = Optimize_IdentName(node)
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition EqualTo(LoopHome.ihold_on, 1) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(name, LoopHome.ihold_name), 1) ThenBlock: {
                ReturnValue(LoopHome.ihold_reg)
            }
        }
        IfCondition EqualTo(Optimize_IsIntHome(name), 1) ThenBlock: { ReturnValue(13) }
        IfCondition EqualTo(Optimize_IsAccHome(name), 1) ThenBlock: { ReturnValue(12) }
        ReturnValue(-1)
    }
}

Function.Optimize_SibOk {
    Input: base: Integer
    Input: index: Integer
    Output: Integer
    Body: {
        bok = 0
        IfCondition EqualTo(base, 1) ThenBlock: { bok = 1 }
        IfCondition EqualTo(base, 14) ThenBlock: { bok = 1 }
        IfCondition EqualTo(bok, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(index, 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(index, 3) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(index, 12) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(index, 13) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

// r14 when this is the parked byte base. rcx reloads any other frame slot.
// A register home is stale in the frame, so that base stays on the slow path.

Function.Optimize_PrepBase {
    Input: node: Address
    Output: Integer
    Body: {
        name = Optimize_IdentName(node)
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(LoopHome.ihold_on, 1) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(name, LoopHome.ihold_name), 1) ThenBlock: { ReturnValue(0) }
        }
        IfCondition EqualTo(Optimize_NameTaken(name), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(LoopHome.tab_on, 1) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(name, LoopHome.tab_name), 1) ThenBlock: {
                LoopHome.hit_class = 14
                LoopHome.hit_disp = LoopHome.tab_off
                ReturnValue(1)
            }
        }
        IfCondition EqualTo(Optimize_FrameOff(name), 0) ThenBlock: { ReturnValue(0) }
        LoopHome.hit_class = 1
        LoopHome.hit_disp = LoopHome.imm_val
        ReturnValue(1)
    }
}

Function.Optimize_PrepGet {
    Input: node: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(LoopHome.active, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(node), AST.CALL) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(StringCompare(AST_GetData1(node), "GetByte"), 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetChildCount(node), 2) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_PrepBase(AST_GetChild(node, 0)), 0) ThenBlock: { ReturnValue(0) }
        ireg = Optimize_IndexReg(AST_GetChild(node, 1))
        IfCondition EqualTo(Optimize_SibOk(LoopHome.hit_class, ireg), 0) ThenBlock: { ReturnValue(0) }
        LoopHome.hit_xmm = ireg
        ReturnValue(1)
    }
}

// Mode in the return value. Mode 5 leaves the frame offset in imm_ok.
// 1 rax, 2 rbx, 3 r13, 4 r12, 5 frame. 0 is not a fast value.

Function.Optimize_ByteValueMode {
    Input: node: Address
    Output: Integer
    Body: {
        LoopHome.imm_ok = 0
        name = Optimize_IdentName(node)
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(LoopHome.ihold_on, 1) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(name, LoopHome.ihold_name), 1) ThenBlock: {
                IfCondition EqualTo(LoopHome.ihold_reg, 0) ThenBlock: { ReturnValue(1) }
                IfCondition EqualTo(LoopHome.ihold_reg, 3) ThenBlock: { ReturnValue(2) }
                ReturnValue(0)
            }
        }
        IfCondition EqualTo(Optimize_IsIntHome(name), 1) ThenBlock: { ReturnValue(3) }
        IfCondition EqualTo(Optimize_IsAccHome(name), 1) ThenBlock: { ReturnValue(4) }
        IfCondition EqualTo(Optimize_IsFltHome(name), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_FrameOff(name), 0) ThenBlock: { ReturnValue(0) }
        LoopHome.imm_ok = LoopHome.imm_val
        ReturnValue(5)
    }
}

Function.Optimize_PrepSet {
    Input: node: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(LoopHome.active, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(node), AST.CALL) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(StringCompare(AST_GetData1(node), "SetByte"), 0) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(AST_GetChildCount(node), 3) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_PrepBase(AST_GetChild(node, 0)), 0) ThenBlock: { ReturnValue(0) }
        base = LoopHome.hit_class
        disp = LoopHome.hit_disp
        ireg = Optimize_IndexReg(AST_GetChild(node, 1))
        mode = Optimize_ByteValueMode(AST_GetChild(node, 2))
        voff = LoopHome.imm_ok
        IfCondition EqualTo(mode, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_SibOk(base, ireg), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(mode, 3) ThenBlock: {
            IfCondition EqualTo(ireg, 13) ThenBlock: { ReturnValue(0) }
        }
        IfCondition EqualTo(mode, 4) ThenBlock: {
            IfCondition EqualTo(ireg, 12) ThenBlock: { ReturnValue(0) }
        }
        IfCondition EqualTo(mode, 5) ThenBlock: {
            IfCondition EqualTo(ireg, 0) ThenBlock: { ReturnValue(0) }
        }
        IfCondition EqualTo(mode, 2) ThenBlock: {
            IfCondition EqualTo(ireg, 0) ThenBlock: { ReturnValue(0) }
        }
        IfCondition EqualTo(mode, 1) ThenBlock: {
            IfCondition EqualTo(ireg, 0) ThenBlock: {
                vn = Optimize_IdentName(AST_GetChild(node, 2))
                iname = Optimize_IdentName(AST_GetChild(node, 1))
                IfCondition EqualTo(Optimize_NameEq(vn, iname), 0) ThenBlock: { ReturnValue(0) }
            }
        }
        LoopHome.hit_class = base
        LoopHome.hit_disp = disp
        LoopHome.hit_xmm = ireg
        LoopHome.imm_val = mode
        LoopHome.imm_ok = voff
        ReturnValue(1)
    }
}

Function.Optimize_TryEmitGetByte {
    Input: node: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(Optimize_PrepGet(node), 0) ThenBlock: { ReturnValue(0) }
        base = LoopHome.hit_class
        disp = LoopHome.hit_disp
        ireg = LoopHome.hit_xmm
        held = 0
        idx_name = Optimize_IdentName(AST_GetChild(node, 1))
        IfCondition EqualTo(LoopHome.ihold_on, 1) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(idx_name, LoopHome.ihold_name), 1) ThenBlock: {
                held = 1
            }
        }
        IfCondition EqualTo(held, 0) ThenBlock: {
            IfCondition EqualTo(LoopHome.ihold_on, 1) ThenBlock: {
                IfCondition EqualTo(LoopHome.ihold_reg, 0) ThenBlock: {
                    Optimize_IholdPark()
                }
            }
        }
        IfCondition EqualTo(base, 1) ThenBlock: {
            X86_MovRcxRbpOffset(disp)
        }
        X86_SibByte(1, base, ireg)
        IfCondition EqualTo(held, 1) ThenBlock: {
            Optimize_IholdClear()
        }
        ReturnValue(1)
    }
}

Function.Optimize_TryEmitSetByte {
    Input: node: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(Optimize_PrepSet(node), 0) ThenBlock: { ReturnValue(0) }
        base = LoopHome.hit_class
        disp = LoopHome.hit_disp
        ireg = LoopHome.hit_xmm
        mode = LoopHome.imm_val
        voff = LoopHome.imm_ok
        consume = 0
        IfCondition EqualTo(LoopHome.ihold_on, 1) ThenBlock: {
            n1 = Optimize_IdentName(AST_GetChild(node, 1))
            n2 = Optimize_IdentName(AST_GetChild(node, 2))
            IfCondition EqualTo(Optimize_NameEq(n1, LoopHome.ihold_name), 1) ThenBlock: { consume = 1 }
            IfCondition EqualTo(Optimize_NameEq(n2, LoopHome.ihold_name), 1) ThenBlock: { consume = 1 }
        }
        IfCondition EqualTo(base, 1) ThenBlock: {
            X86_MovRcxRbpOffset(disp)
        }
        IfCondition EqualTo(mode, 2) ThenBlock: { Emit_MovRaxRbx() }
        IfCondition EqualTo(mode, 3) ThenBlock: { Emit_HomeMove(1, 0) }
        IfCondition EqualTo(mode, 4) ThenBlock: { Emit_HomeMove(16, 0) }
        IfCondition EqualTo(mode, 5) ThenBlock: { Emit_MovRaxRbpOffset(voff) }
        X86_SibByte(2, base, ireg)
        IfCondition EqualTo(consume, 1) ThenBlock: { Optimize_IholdClear() }
        ReturnValue(1)
    }
}

Function.Optimize_TryGetByteAssign {
    Input: target: Address
    Input: value: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(Optimize_TryEmitGetByte(value), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(LoopHome.ihold_on, 1) ThenBlock: {
            CompileExpr_StoreVariable(target)
            ReturnValue(1)
        }
        IfCondition EqualTo(Optimize_IholdArm(target), 1) ThenBlock: { ReturnValue(1) }
        CompileExpr_StoreVariable(target)
        ReturnValue(1)
    }
}

Function.Optimize_KeepIhold {
    Input: node: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(LoopHome.ihold_on, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(node), AST.CALL) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(StringCompare(AST_GetData1(node), "SetByte"), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_PrepSet(node), 0) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(AST_GetChildCount(node), 3) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_NameEq(Optimize_IdentName(AST_GetChild(node, 1)), LoopHome.ihold_name), 1) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(Optimize_NameEq(Optimize_IdentName(AST_GetChild(node, 2)), LoopHome.ihold_name), 1) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

Function.Optimize_CountByteBase {
    Input: node: Address
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        n = 0
        IfCondition EqualTo(AST_GetType(node), AST.CALL) ThenBlock: {
            op = AST_GetData1(node)
            hit = 0
            IfCondition EqualTo(StringCompare(op, "GetByte"), 0) ThenBlock: { hit = 1 }
            IfCondition EqualTo(StringCompare(op, "SetByte"), 0) ThenBlock: { hit = 1 }
            IfCondition EqualTo(hit, 1) ThenBlock: {
                IfCondition GreaterThan(AST_GetChildCount(node), 0) ThenBlock: {
                    IfCondition EqualTo(Optimize_NameEq(Optimize_IdentName(AST_GetChild(node, 0)), name), 1) ThenBlock: {
                        n = 1
                    }
                }
            }
        }
        count = AST_GetChildCount(node)
        i = 0
        WhileLoop LessThan(i, count) {
            n = Add(n, Optimize_CountByteBase(AST_GetChild(node, i), name))
            i = Add(i, 1)
        }
        ReturnValue(n)
    }
}

// Hottest read-only GetByte or SetByte base, and only when no qword table
// already owns r14. The fields are set directly so a rejected name cannot
// mark every table as many.

Function.Optimize_PickByteBase {
    Input: body: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(LoopHome.tab_on, 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(LoopHome.tab_many, 1) ThenBlock: { ReturnValue(0) }
        best = 0
        best_n = 0
        best_off = 0
        i = 0
        WhileLoop LessThan(i, LoopHome.count) {
            rec = Optimize_HomeRec(i)
            name = Dereference(rec)
            loads = Dereference(Add(rec, 8))
            stores = Dereference(Add(rec, 16))
            IfCondition GreaterThan(loads, 0) ThenBlock: {
                IfCondition EqualTo(stores, 0) ThenBlock: {
                    IfCondition EqualTo(Optimize_NameTaken(name), 0) ThenBlock: {
                        skip = 0
                        IfCondition EqualTo(LoopHome.lim_on, 1) ThenBlock: {
                            IfCondition EqualTo(Optimize_NameEq(name, LoopHome.lim_name), 1) ThenBlock: { skip = 1 }
                        }
                        IfCondition EqualTo(skip, 0) ThenBlock: {
                            n = Optimize_CountByteBase(body, name)
                            IfCondition GreaterThan(n, best_n) ThenBlock: {
                                best = name
                                best_n = n
                            }
                        }
                    }
                }
            }
            i = Add(i, 1)
        }
        IfCondition EqualTo(best, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_AssignsName(body, best), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_FrameOff(best), 0) ThenBlock: { ReturnValue(0) }
        best_off = LoopHome.imm_val
        LoopHome.tab_on = 1
        LoopHome.tab_name = best
        LoopHome.tab_off = best_off
        ReturnValue(1)
    }
}

Function.Optimize_KmulSkip {
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(Optimize_NameTaken(name), 1) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(LoopHome.lim_on, 1) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(name, LoopHome.lim_name), 1) ThenBlock: { ReturnValue(1) }
        }
        IfCondition EqualTo(LoopHome.tab_on, 1) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(name, LoopHome.tab_name), 1) ThenBlock: { ReturnValue(1) }
        }
        ReturnValue(0)
    }
}

// kmul_on 2 is a conflict found while walking. NoteRbxScratch overwrites
// rbx_scratch after this returns, so the walk does not borrow that field.

Function.Optimize_KmulSee {
    Input: name: Address
    Input: condition: Address
    Input: body: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(LoopHome.kmul_on, 2) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_KmulSkip(name), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_AssignsName(body, name), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_InvOk(name, 2, condition, body), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_FrameOff(name), 0) ThenBlock: { ReturnValue(0) }
        off = LoopHome.imm_val
        IfCondition EqualTo(LoopHome.kmul_name, 0) ThenBlock: {
            LoopHome.kmul_on = 1
            LoopHome.kmul_name = name
            LoopHome.kmul_off = off
            ReturnValue(1)
        }
        IfCondition EqualTo(Optimize_NameEq(name, LoopHome.kmul_name), 0) ThenBlock: {
            LoopHome.kmul_on = 2
            LoopHome.kmul_name = 0
            LoopHome.kmul_off = 0
        }
        ReturnValue(0)
    }
}

Function.Optimize_KmulWalk {
    Input: node: Address
    Input: condition: Address
    Input: body: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(LoopHome.kmul_on, 2) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(AST_GetType(node), AST.ASSIGNMENT) ThenBlock: {
            IfCondition EqualTo(AST_GetData2(node), 0) ThenBlock: {
                IfCondition EqualTo(Optimize_AccName(AST_GetData1(node)), 1) ThenBlock: {
                    value = AST_GetChild(node, 0)
                    IfCondition NotEqual(value, 0) ThenBlock: {
                        IfCondition EqualTo(AST_GetType(value), AST.CALL) ThenBlock: {
                            IfCondition EqualTo(StringCompare(AST_GetData1(value), "Multiply"), 0) ThenBlock: {
                                IfCondition EqualTo(AST_GetChildCount(value), 2) ThenBlock: {
                                    ln = Optimize_IdentName(AST_GetChild(value, 0))
                                    rn = Optimize_IdentName(AST_GetChild(value, 1))
                                    other = 0
                                    IfCondition EqualTo(Optimize_AccName(ln), 1) ThenBlock: { other = rn }
                                    IfCondition EqualTo(Optimize_AccName(rn), 1) ThenBlock: {
                                        IfCondition EqualTo(Optimize_AccName(ln), 0) ThenBlock: { other = ln }
                                    }
                                    IfCondition NotEqual(other, 0) ThenBlock: {
                                        Optimize_KmulSee(other, condition, body)
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        count = AST_GetChildCount(node)
        i = 0
        WhileLoop LessThan(i, count) {
            Optimize_KmulWalk(AST_GetChild(node, i), condition, body)
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

Function.Optimize_PickKmul {
    Input: condition: Address
    Input: body: Address
    Output: Integer
    Body: {
        LoopHome.kmul_on = 0
        LoopHome.kmul_name = 0
        LoopHome.kmul_off = 0
        IfCondition EqualTo(LoopHome.has_call, 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(LoopHome.prod_on, 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(LoopHome.der_on, 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(LoopHome.ip0_on, 1) ThenBlock: {
            IfCondition EqualTo(LoopHome.ip0_reg, 11) ThenBlock: { ReturnValue(0) }
        }
        IfCondition EqualTo(LoopHome.ip1_on, 1) ThenBlock: {
            IfCondition EqualTo(LoopHome.ip1_reg, 11) ThenBlock: { ReturnValue(0) }
        }
        IfCondition EqualTo(Optimize_TreeHasAsm(body), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_TreeHasAsm(condition), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(LoopHome.acc_name, 0) ThenBlock: { ReturnValue(0) }
        Optimize_KmulWalk(body, condition, body)
        IfCondition NotEqual(LoopHome.kmul_on, 1) ThenBlock: {
            LoopHome.kmul_on = 0
            LoopHome.kmul_name = 0
            LoopHome.kmul_off = 0
            ReturnValue(0)
        }
        ReturnValue(1)
    }
}

Function.Optimize_TreeHasDiv {
    Input: node: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(AST_GetType(node), AST.CALL) ThenBlock: {
            op = AST_GetData1(node)
            IfCondition EqualTo(StringCompare(op, "Modulo"), 0) ThenBlock: { ReturnValue(1) }
            IfCondition EqualTo(StringCompare(op, "Divide"), 0) ThenBlock: { ReturnValue(1) }
        }
        count = AST_GetChildCount(node)
        i = 0
        WhileLoop LessThan(i, count) {
            IfCondition EqualTo(Optimize_TreeHasDiv(AST_GetChild(node, i)), 1) ThenBlock: { ReturnValue(1) }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}
