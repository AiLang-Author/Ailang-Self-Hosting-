// Library.COptMath.ailang
// Peephole math into rax and rbx, LEA, and binary operators.
// Loaded by the optimizer shell. No imports of its own.

// =============================================================================
// GENERIC: Load any expression into RAX
// Handles NUMBER, IDENTIFIER, or nested math CALL
// Returns 1 on success, 0 on failure (fall back to standard path)
// =============================================================================
Function.Optimize_LoadToRax {
    Input: node: Address
    Output: Integer
    Body: {
        node_type = AST_GetType(node)
        
        // NUMBER: immediate
        IfCondition EqualTo(node_type, AST.NUMBER) ThenBlock: {
            val = StringToNumber(AST_GetData1(node))
            Emit_MovRaxImm64(val)
            ReturnValue(1)
        }
        
        // IDENTIFIER: variable
        IfCondition EqualTo(node_type, AST.IDENTIFIER) ThenBlock: {
            name = AST_GetData1(node)
            // A skipped stride product was not stored. Rebuild it.
            IfCondition EqualTo(Optimize_RematOff(name), 1) ThenBlock: { ReturnValue(1) }
            IfCondition EqualTo(LoopHome.off_skip, 1) ThenBlock: {
                IfCondition EqualTo(Optimize_NameEq(name, LoopHome.st_off), 1) ThenBlock: {
                    Compile.error = 1
                    ReturnValue(0)
                }
            }
            IfCondition EqualTo(Optimize_RdxMiss(name), 1) ThenBlock: { ReturnValue(0) }
            IfCondition EqualTo(Optimize_LocLoad(name), 1) ThenBlock: { ReturnValue(1) }
            IfCondition EqualTo(Optimize_HomeLoad(name), 1) ThenBlock: { ReturnValue(1) }
            offset = Scope_Resolve(name)
            resolve_type = Scope.resolve_type
            IfCondition EqualTo(resolve_type, 0) ThenBlock: {
                ReturnValue(0)
            }
            IfCondition EqualTo(resolve_type, 3) ThenBlock: {
                pool_index = BitwiseAnd(offset, 2147483647)
                pool_offset = Multiply(pool_index, 8)
                Emit_MovRaxR15Offset(pool_offset)
            } ElseBlock: {
                Emit_MovRaxRbpOffset(offset)
            }
            ReturnValue(1)
        }
        
        // CALL: check if it's a math op we can optimize
        IfCondition EqualTo(node_type, AST.CALL) ThenBlock: {
            func_name = AST_GetData1(node)
            IfCondition EqualTo(Optimize_IsMathOp(func_name), 1) ThenBlock: {
                result = Optimize_BinaryMathOp(node)
                ReturnValue(result)
            }
        }
        
        // Can't optimize this expression
        ReturnValue(0)
    }
}

// =============================================================================
// GENERIC: Load any expression into RBX
// Same as LoadToRax but targets RBX
// =============================================================================
Function.Optimize_LoadToRbx {
    Input: node: Address
    Output: Integer
    Body: {
        node_type = AST_GetType(node)
        
        // NUMBER: immediate
        IfCondition EqualTo(node_type, AST.NUMBER) ThenBlock: {
            val = StringToNumber(AST_GetData1(node))
            Emit_MovRbxImm64(val)
            ReturnValue(1)
        }
        
        // IDENTIFIER: variable
        IfCondition EqualTo(node_type, AST.IDENTIFIER) ThenBlock: {
            name = AST_GetData1(node)
            IfCondition EqualTo(LoopHome.der_on, 1) ThenBlock: {
                IfCondition EqualTo(Optimize_NameEq(name, LoopHome.der_name), 1) ThenBlock: {
                    X86Enc_Assemble("MOV rbx, r11")
                    ReturnValue(1)
                }
            }
            IfCondition EqualTo(LoopHome.active, 1) ThenBlock: {
                IfCondition EqualTo(Optimize_Loc(name), 1) ThenBlock: {
                    IfCondition EqualTo(AllocTab.hit_class, 1) ThenBlock: {
                        IfCondition EqualTo(AllocTab.hit_reg, 13) ThenBlock: {
                            Emit_MovRbxR13()
                            ReturnValue(1)
                        }
                        IfCondition EqualTo(AllocTab.hit_reg, 12) ThenBlock: {
                            Emit_MovRbxR12()
                            ReturnValue(1)
                        }
                        IfCondition EqualTo(AllocTab.hit_reg, 11) ThenBlock: {
                            Optimize_AllocToRbx(11)
                            ReturnValue(1)
                        }
                        IfCondition EqualTo(AllocTab.hit_reg, 14) ThenBlock: {
                            Optimize_AllocToRbx(14)
                            ReturnValue(1)
                        }
                    }
                    // Same movq the old float test emitted. FltSlot still
                    // prefers a borrow. No pin flush on this path.
                    IfCondition EqualTo(AllocTab.hit_class, 2) ThenBlock: {
                        slot = Optimize_FltSlot(name)
                        IfCondition GreaterThan(slot, 0) ThenBlock: {
                            Emit_PushRax()
                            IfCondition EqualTo(slot, 2) ThenBlock: { Emit_HomeMove(5, 0) }
                            IfCondition GreaterThan(slot, 2) ThenBlock: { X86_XmmRR(2, slot) }
                            Emit_MovRbxRax()
                            Emit_PopRax()
                            ReturnValue(1)
                        }
                    }
                }
            }
            IfCondition EqualTo(LoopHome.hold_on, 1) ThenBlock: {
                IfCondition EqualTo(StringCompare(name, LoopHome.hold_name), 0) ThenBlock: {
                    Emit_PushRax()
                    Emit_HomeMove(30, 0)
                    Emit_MovRbxRax()
                    Emit_PopRax()
                    ReturnValue(1)
                }
            }
            IfCondition EqualTo(Optimize_AliasFind(name), 1) ThenBlock: {
                X86_EmitR13Mem(0, 73, 139, 0, 3, LoopHome.hit_disp)
                ReturnValue(1)
            }
            // Same skipped product, into RBX. RAX already holds the other addend.
            IfCondition EqualTo(Optimize_RematOffRbx(name), 1) ThenBlock: { ReturnValue(1) }
            IfCondition EqualTo(LoopHome.off_skip, 1) ThenBlock: {
                IfCondition EqualTo(Optimize_NameEq(name, LoopHome.st_off), 1) ThenBlock: {
                    Compile.error = 1
                    ReturnValue(0)
                }
            }
            IfCondition EqualTo(Optimize_RdxMiss(name), 1) ThenBlock: { ReturnValue(0) }
            offset = Scope_Resolve(name)
            resolve_type = Scope.resolve_type
            IfCondition EqualTo(resolve_type, 0) ThenBlock: {
                ReturnValue(0)
            }
            IfCondition EqualTo(resolve_type, 3) ThenBlock: {
                pool_index = BitwiseAnd(offset, 2147483647)
                pool_offset = Multiply(pool_index, 8)
                Emit_MovRbxR15Offset(pool_offset)
            } ElseBlock: {
                Emit_MovRbxRbpOffset(offset)
            }
            ReturnValue(1)
        }
        
        // CALL: optimize nested math, then move RAX→RBX
        IfCondition EqualTo(node_type, AST.CALL) ThenBlock: {
            func_name = AST_GetData1(node)
            IfCondition EqualTo(Optimize_IsMathOp(func_name), 1) ThenBlock: {
                result = Optimize_BinaryMathOp(node)
                IfCondition EqualTo(result, 1) ThenBlock: {
                    Emit_MovRbxRax()  // Move result to RBX
                    ReturnValue(1)
                }
            }
        }
        
        ReturnValue(0)
    }
}

// =============================================================================
// EMIT OPERATION: Given RAX=left, RBX=right, emit the math/cmp instruction
// Returns 1 on success, 0 on unknown operation
// =============================================================================

Function.Optimize_EmitOperation {
    Input: node: Address
    Input: func_name: Address
    Output: Integer
    Body: {
        // =================================================================
        // ARITHMETIC
        // =================================================================
        IfCondition EqualTo(StringCompare(func_name, "Add"), 0) ThenBlock: {
            Emit_AddRaxRbx()
            ReturnValue(1)
        }
        IfCondition EqualTo(StringCompare(func_name, "Subtract"), 0) ThenBlock: {
            Emit_SubRaxRbx()
            ReturnValue(1)
        }
        IfCondition EqualTo(StringCompare(func_name, "Multiply"), 0) ThenBlock: {
            // Check right operand for power-of-2 → SHL
            arg1 = AST_GetChild(node, 1)
            arg1_type = AST_GetType(arg1)
            IfCondition EqualTo(arg1_type, AST.NUMBER) ThenBlock: {
                val_str = AST_GetData1(arg1)
                val = StringToNumber(val_str)
                IfCondition GreaterThan(val, 0) ThenBlock: {
                    val_minus_1 = Subtract(val, 1)
                    check = BitwiseAnd(val, val_minus_1)
                    IfCondition EqualTo(check, 0) ThenBlock: {
                        shift = 0
                        tmp = val
                        WhileLoop GreaterThan(tmp, 1) {
                            tmp = Divide(tmp, 2)
                            shift = Add(shift, 1)
                        }
                        IfCondition GreaterThan(shift, 0) ThenBlock: {
                            Emit_ShlRaxImm8(shift)
                            ReturnValue(1)
                        }
                        ReturnValue(1)
                    }
                }
            }
            // Check left operand for power-of-2 → SHL
            arg0 = AST_GetChild(node, 0)
            arg0_type = AST_GetType(arg0)
            IfCondition EqualTo(arg0_type, AST.NUMBER) ThenBlock: {
                val_str = AST_GetData1(arg0)
                val = StringToNumber(val_str)
                IfCondition GreaterThan(val, 0) ThenBlock: {
                    val_minus_1 = Subtract(val, 1)
                    check = BitwiseAnd(val, val_minus_1)
                    IfCondition EqualTo(check, 0) ThenBlock: {
                        shift = 0
                        tmp = val
                        WhileLoop GreaterThan(tmp, 1) {
                            tmp = Divide(tmp, 2)
                            shift = Add(shift, 1)
                        }
                        IfCondition GreaterThan(shift, 0) ThenBlock: {
                            Emit_MovRaxRbx()
                            Emit_ShlRaxImm8(shift)
                            ReturnValue(1)
                        }
                        ReturnValue(1)
                    }
                }
            }
            Emit_ImulRaxRbx()
            ReturnValue(1)
        }
        IfCondition EqualTo(StringCompare(func_name, "Divide"), 0) ThenBlock: {
            // RAX is the dividend. A positive power-of-two divisor uses
            // the same toward-zero adjustment as CompileArith_Divide:
            // add the sign bit, then SAR. The incoming RBX is not read.
            // Shift 1 uses RCX and RAX only. A larger shift rewrites RBX.
            arg1 = AST_GetChild(node, 1)
            known = CompileArith_KnownDivisor(node, arg1)
            val = OptState.bind_val
            IfCondition EqualTo(known, 1) ThenBlock: {
                IfCondition GreaterThan(val, 0) ThenBlock: {
                    val_minus_1 = Subtract(val, 1)
                    check = BitwiseAnd(val, val_minus_1)
                    IfCondition EqualTo(check, 0) ThenBlock: {
                        shift = 0
                        tmp = val
                        WhileLoop GreaterThan(tmp, 1) {
                            tmp = Divide(tmp, 2)
                            shift = Add(shift, 1)
                        }
                        IfCondition EqualTo(shift, 0) ThenBlock: {
                            ReturnValue(1)
                        }
                        // Plain SAR when the dividend is proven non-negative,
                        // or when it is the always-even product x*(x+1) and
                        // the divisor is 2. A negative odd dividend keeps
                        // the toward-zero bias below.
                        IfCondition EqualTo(Optimize_SarSafe(AST_GetChild(node, 0), shift), 1) ThenBlock: {
                            Emit_SarRaxImm8(shift)
                            ReturnValue(1)
                        }
                        IfCondition EqualTo(shift, 1) ThenBlock: {
                            Emit_MovRegReg(Reg.RCX, Reg.RAX)
                            Emit_ShrRcxImm8(63)
                            Emit_AddRaxRcx()
                            Emit_SarRaxImm8(1)
                            ReturnValue(1)
                        }
                        Emit_MovRegReg(Reg.RDX, Reg.RAX)
                        Emit_MovRegReg(Reg.RCX, Reg.RAX)
                        Emit_ShrRcxImm8(63)
                        Emit_MovRegReg(Reg.RBX, Reg.RCX)
                        Emit_MovRegReg(Reg.RAX, Reg.RCX)
                        Emit_ShlRaxImm8(shift)
                        Emit_SubRaxRbx()
                        Emit_MovRegReg(Reg.RCX, Reg.RAX)
                        Emit_MovRegReg(Reg.RAX, Reg.RDX)
                        Emit_AddRaxRcx()
                        Emit_SarRaxImm8(shift)
                        ReturnValue(1)
                    }
                }
                IfCondition EqualTo(Optimize_MagicPrepare(val), 1) ThenBlock: {
                    nn = 0
                    IfCondition GreaterThan(val, 0) ThenBlock: {
                        nn = Optimize_ProvedNonNeg(AST_GetChild(node, 0))
                    }
                    CompileArith_MagicFinish(val, 0, 0, nn, 0)
                    ReturnValue(1)
                }
            }
            Emit_Cqo()
            Emit_IdivRbx()
            ReturnValue(1)
        }
        IfCondition EqualTo(StringCompare(func_name, "Modulo"), 0) ThenBlock: {
            arg1 = AST_GetChild(node, 1)
            known = CompileArith_KnownDivisor(node, arg1)
            val = OptState.bind_val
            IfCondition EqualTo(known, 1) ThenBlock: {
                IfCondition GreaterThan(val, 0) ThenBlock: {
                    val_minus_1 = Subtract(val, 1)
                    check = BitwiseAnd(val, val_minus_1)
                    IfCondition EqualTo(check, 0) ThenBlock: {
                        // AND is the unsigned mask. A negative dividend, or a
                        // mask that does not fit imm32, uses the magic multiply.
                        saved_lo = LoopHome.range_lo
                        saved_hi = LoopHome.range_hi
                        proved = Optimize_NonNeg(AST_GetChild(node, 0))
                        LoopHome.range_lo = saved_lo
                        LoopHome.range_hi = saved_hi
                        IfCondition EqualTo(proved, 1) ThenBlock: {
                            IfCondition EqualTo(Optimize_Fit32(val_minus_1), 1) ThenBlock: {
                                Emit_AndRaxImm32(val_minus_1)
                                ReturnValue(1)
                            }
                        }
                    }
                }
                IfCondition EqualTo(Optimize_MagicPrepare(val), 1) ThenBlock: {
                    nn = 0
                    IfCondition GreaterThan(val, 0) ThenBlock: {
                        nn = Optimize_ProvedNonNeg(AST_GetChild(node, 0))
                    }
                    CompileArith_MagicFinish(val, 1, 0, nn, 0)
                    ReturnValue(1)
                }
            }
            Emit_Cqo()
            Emit_IdivRbx()
            Emit_MovRaxRdx()
            ReturnValue(1)
        }

        // =================================================================
        // COMPARISONS
        // =================================================================
        IfCondition EqualTo(StringCompare(func_name, "EqualTo"), 0) ThenBlock: {
            Emit_CmpRaxRbx()
            Emit_Sete()
            Emit_MovzxRaxAl()
            ReturnValue(1)
        }
        IfCondition EqualTo(StringCompare(func_name, "NotEqual"), 0) ThenBlock: {
            Emit_CmpRaxRbx()
            Emit_Setne()
            Emit_MovzxRaxAl()
            ReturnValue(1)
        }
        IfCondition EqualTo(StringCompare(func_name, "LessThan"), 0) ThenBlock: {
            Emit_CmpRaxRbx()
            Emit_Setl()
            Emit_MovzxRaxAl()
            ReturnValue(1)
        }
        IfCondition EqualTo(StringCompare(func_name, "GreaterThan"), 0) ThenBlock: {
            Emit_CmpRaxRbx()
            Emit_Setg()
            Emit_MovzxRaxAl()
            ReturnValue(1)
        }
        IfCondition EqualTo(StringCompare(func_name, "LessEqual"), 0) ThenBlock: {
            Emit_CmpRaxRbx()
            Emit_Setle()
            Emit_MovzxRaxAl()
            ReturnValue(1)
        }
        IfCondition EqualTo(StringCompare(func_name, "GreaterEqual"), 0) ThenBlock: {
            Emit_CmpRaxRbx()
            Emit_Setge()
            Emit_MovzxRaxAl()
            ReturnValue(1)
        }

        // =================================================================
        // BITWISE — AND, OR, XOR
        // =================================================================
        is_and = Or(EqualTo(StringCompare(func_name, "BitwiseAnd"), 0), EqualTo(StringCompare(func_name, "BitAnd"), 0))
        IfCondition EqualTo(is_and, 1) ThenBlock: {
            Emit_AndRaxRbx()
            ReturnValue(1)
        }
        is_or = Or(EqualTo(StringCompare(func_name, "BitwiseOr"), 0), EqualTo(StringCompare(func_name, "BitOr"), 0))
        IfCondition EqualTo(is_or, 1) ThenBlock: {
            Emit_OrRaxRbx()
            ReturnValue(1)
        }
        is_xor = Or(EqualTo(StringCompare(func_name, "BitwiseXor"), 0), EqualTo(StringCompare(func_name, "BitXor"), 0))
        IfCondition EqualTo(is_xor, 1) ThenBlock: {
            Emit_XorRaxRbx()
            ReturnValue(1)
        }

        // =================================================================
        // SHIFTS — need RBX→RCX for variable shift, or imm8 for constant
        // =================================================================
        is_shl = Or(EqualTo(StringCompare(func_name, "LeftShift"), 0), EqualTo(StringCompare(func_name, "ShiftLeft"), 0))
        IfCondition EqualTo(is_shl, 1) ThenBlock: {
            // If right operand is constant, use SHL RAX, imm8 directly
            arg1 = AST_GetChild(node, 1)
            arg1_type = AST_GetType(arg1)
            IfCondition EqualTo(arg1_type, AST.NUMBER) ThenBlock: {
                shift_val = StringToNumber(AST_GetData1(arg1))
                Emit_ShlRaxImm8(shift_val)
                ReturnValue(1)
            }
            // Variable shift: RBX has shift amount, move to RCX
            Emit_MovRcxRbx()
            Emit_ShlRaxCl()
            ReturnValue(1)
        }
        is_shr = Or(EqualTo(StringCompare(func_name, "RightShift"), 0), EqualTo(StringCompare(func_name, "ShiftRight"), 0))
        IfCondition EqualTo(is_shr, 1) ThenBlock: {
            arg1 = AST_GetChild(node, 1)
            arg1_type = AST_GetType(arg1)
            IfCondition EqualTo(arg1_type, AST.NUMBER) ThenBlock: {
                shift_val = StringToNumber(AST_GetData1(arg1))
                Emit_ShrRaxImm8(shift_val)
                ReturnValue(1)
            }
            Emit_MovRcxRbx()
            Emit_ShrRaxCl()
            ReturnValue(1)
        }

        ReturnValue(0)
    }
}

// =============================================================================
// RBX LEAF
// Add(leaf, number) and Subtract(leaf, number) can be built in RBX without
// touching RAX, so the other operand is not pushed. A leaf is a number or a
// name. One level only: a nested add still needs RAX and keeps the old path.
// Subtract(number, name) is not commutative and is lowered without swapping.
// If RAX already holds that name, copy it instead of loading the slot again.
// =============================================================================

Function.Optimize_IsBase {
    Input: node: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        node_type = AST_GetType(node)
        is_num = EqualTo(node_type, AST.NUMBER)
        is_id = EqualTo(node_type, AST.IDENTIFIER)
        IfCondition EqualTo(Or(is_num, is_id), 1) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

Function.Optimize_IsImmLeaf {
    Input: node: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(node), AST.CALL) ThenBlock: { ReturnValue(0) }
        func_name = AST_GetData1(node)
        is_add = EqualTo(StringCompare(func_name, "Add"), 0)
        is_sub = EqualTo(StringCompare(func_name, "Subtract"), 0)
        IfCondition EqualTo(Or(is_add, is_sub), 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetChildCount(node), 2) ThenBlock: { ReturnValue(0) }
        c0 = AST_GetChild(node, 0)
        c1 = AST_GetChild(node, 1)
        IfCondition EqualTo(Optimize_IsBase(c0), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_IsBase(c1), 0) ThenBlock: { ReturnValue(0) }
        t0 = AST_GetType(c0)
        t1 = AST_GetType(c1)
        has_num = Or(EqualTo(t0, AST.NUMBER), EqualTo(t1, AST.NUMBER))
        IfCondition EqualTo(has_num, 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(1)
    }
}

Function.Optimize_LeafName {
    Input: node: Address
    Output: Address
    Body: {
        c0 = AST_GetChild(node, 0)
        c1 = AST_GetChild(node, 1)
        IfCondition EqualTo(AST_GetType(c0), AST.IDENTIFIER) ThenBlock: {
            ReturnValue(AST_GetData1(c0))
        }
        IfCondition EqualTo(AST_GetType(c1), AST.IDENTIFIER) ThenBlock: {
            ReturnValue(AST_GetData1(c1))
        }
        ReturnValue(0)
    }
}

Function.Optimize_NameIs {
    Input: node: Address
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(node), AST.IDENTIFIER) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(StringCompare(AST_GetData1(node), name), 0) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

Function.Optimize_IsComm {
    Input: func_name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(StringCompare(func_name, "Add"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(func_name, "Multiply"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(func_name, "BitwiseAnd"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(func_name, "BitwiseOr"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(func_name, "BitwiseXor"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(func_name, "BitAnd"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(func_name, "BitOr"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(func_name, "BitXor"), 0) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

// A signed 32-bit immediate sign-extends. Wider addends go through RCX.

Function.Optimize_Fit32 {
    Input: val: Integer
    Output: Integer
    Body: {
        IfCondition GreaterThan(val, 2147483647) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(val, -2147483648) ThenBlock: { ReturnValue(0) }
        ReturnValue(1)
    }
}

Function.Optimize_RbxAdd {
    Input: val: Integer
    Body: {
        IfCondition EqualTo(Optimize_Fit32(val), 1) ThenBlock: {
            Emit_AddRegImm32(Reg.RBX, val)
        } ElseBlock: {
            Emit_MovRegImm64(Reg.RCX, val)
            X86_AddRegReg(Reg.RBX, Reg.RCX)
        }
    }
}

Function.Optimize_RbxSub {
    Input: val: Integer
    Body: {
        IfCondition EqualTo(Optimize_Fit32(val), 1) ThenBlock: {
            X86_SubRbxImm32(val)
        } ElseBlock: {
            Emit_MovRegImm64(Reg.RCX, val)
            X86_SubRegReg(Reg.RBX, Reg.RCX)
        }
    }
}

Function.Optimize_NumVal {
    Input: node: Address
    Output: Integer
    Body: {
        ReturnValue(StringToNumber(AST_GetData1(node)))
    }
}

// Build an immediate leaf in RBX. RAX is preserved.

Function.Optimize_LoadRbxLeaf {
    Input: node: Address
    Output: Integer
    Body: {
        c0 = AST_GetChild(node, 0)
        c1 = AST_GetChild(node, 1)
        t0 = AST_GetType(c0)
        t1 = AST_GetType(c1)
        is_sub = EqualTo(StringCompare(AST_GetData1(node), "Subtract"), 0)
        IfCondition EqualTo(t1, AST.NUMBER) ThenBlock: {
            IfCondition EqualTo(t0, AST.NUMBER) ThenBlock: {
                val0 = Optimize_NumVal(c0)
                Emit_MovRbxImm64(val0)
            } ElseBlock: {
                got = Optimize_LoadToRbx(c0)
                IfCondition EqualTo(got, 0) ThenBlock: { ReturnValue(0) }
            }
            val = Optimize_NumVal(c1)
            IfCondition EqualTo(is_sub, 1) ThenBlock: {
                Optimize_RbxSub(val)
            } ElseBlock: {
                Optimize_RbxAdd(val)
            }
            ReturnValue(1)
        }
        val = Optimize_NumVal(c0)
        IfCondition EqualTo(is_sub, 0) ThenBlock: {
            got = Optimize_LoadToRbx(c1)
            IfCondition EqualTo(got, 0) ThenBlock: { ReturnValue(0) }
            Optimize_RbxAdd(val)
            ReturnValue(1)
        }
        // rbx = number - name. The name is loaded through RCX so RAX survives.
        Emit_PushRax()
        got = Optimize_LoadToRax(c1)
        IfCondition EqualTo(got, 0) ThenBlock: {
            Emit_PopRax()
            ReturnValue(0)
        }
        Emit_MovRcxRax()
        Emit_PopRax()
        Emit_MovRegImm64(Reg.RBX, val)
        X86_SubRegReg(Reg.RBX, Reg.RCX)
        ReturnValue(1)
    }
}

// RAX already holds the leaf's name. Copy it to RBX and apply the immediate.

Function.Optimize_RbxFromRax {
    Input: node: Address
    Body: {
        c0 = AST_GetChild(node, 0)
        c1 = AST_GetChild(node, 1)
        t1 = AST_GetType(c1)
        is_sub = EqualTo(StringCompare(AST_GetData1(node), "Subtract"), 0)
        IfCondition EqualTo(t1, AST.NUMBER) ThenBlock: {
            val = Optimize_NumVal(c1)
            disp = val
            IfCondition EqualTo(is_sub, 1) ThenBlock: { disp = Subtract(0, val) }
            IfCondition EqualTo(Optimize_Fit32(disp), 1) ThenBlock: {
                X86_LeaRbxRax(disp)
            } ElseBlock: {
                Emit_MovRbxRax()
                IfCondition EqualTo(is_sub, 1) ThenBlock: {
                    Optimize_RbxSub(val)
                } ElseBlock: {
                    Optimize_RbxAdd(val)
                }
            }
        } ElseBlock: {
            val = Optimize_NumVal(c0)
            IfCondition EqualTo(is_sub, 0) ThenBlock: {
                IfCondition EqualTo(Optimize_Fit32(val), 1) ThenBlock: {
                    X86_LeaRbxRax(val)
                } ElseBlock: {
                    Emit_MovRbxRax()
                    Optimize_RbxAdd(val)
                }
            } ElseBlock: {
                Emit_MovRcxRax()
                Emit_MovRegImm64(Reg.RBX, val)
                X86_SubRegReg(Reg.RBX, Reg.RCX)
            }
        }
    }
}

// R12 or R13 when this name is the loop home. Other names stay in memory,
// and LEA cannot fold a memory value.

Function.Optimize_HomeReg {
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(Optimize_IsAccHome(name), 1) ThenBlock: { ReturnValue(12) }
        IfCondition EqualTo(Optimize_IsIntHome(name), 1) ThenBlock: { ReturnValue(13) }
        ReturnValue(0)
    }
}

// Register plus a signed 32-bit displacement. Add(home, k) and Add(k, home)
// are home+k. Subtract(home, k) is home-k. Subtract(k, home) is not.
// Returns 12 or 13, or 0 when the add should stay on the old path.

Function.Optimize_LeaReg {
    Input: node: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(Optimize_IsImmLeaf(node), 0) ThenBlock: { ReturnValue(0) }
        c0 = AST_GetChild(node, 0)
        c1 = AST_GetChild(node, 1)
        is_sub = EqualTo(StringCompare(AST_GetData1(node), "Subtract"), 0)
        IfCondition EqualTo(AST_GetType(c1), AST.NUMBER) ThenBlock: {
            IfCondition NotEqual(AST_GetType(c0), AST.IDENTIFIER) ThenBlock: { ReturnValue(0) }
            reg = Optimize_HomeReg(AST_GetData1(c0))
            IfCondition EqualTo(reg, 0) ThenBlock: { ReturnValue(0) }
            val = Optimize_NumVal(c1)
            IfCondition EqualTo(is_sub, 1) ThenBlock: { val = Subtract(0, val) }
            IfCondition EqualTo(Optimize_Fit32(val), 0) ThenBlock: { ReturnValue(0) }
            ReturnValue(reg)
        }
        IfCondition EqualTo(is_sub, 1) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(c1), AST.IDENTIFIER) ThenBlock: { ReturnValue(0) }
        reg = Optimize_HomeReg(AST_GetData1(c1))
        IfCondition EqualTo(reg, 0) ThenBlock: { ReturnValue(0) }
        val = Optimize_NumVal(c0)
        IfCondition EqualTo(Optimize_Fit32(val), 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(reg)
    }
}

Function.Optimize_LeaDisp {
    Input: node: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(Optimize_LeaReg(node), 0) ThenBlock: { ReturnValue(0) }
        c0 = AST_GetChild(node, 0)
        c1 = AST_GetChild(node, 1)
        is_sub = EqualTo(StringCompare(AST_GetData1(node), "Subtract"), 0)
        IfCondition EqualTo(AST_GetType(c1), AST.NUMBER) ThenBlock: {
            val = Optimize_NumVal(c1)
            IfCondition EqualTo(is_sub, 1) ThenBlock: { ReturnValue(Subtract(0, val)) }
            ReturnValue(val)
        }
        ReturnValue(Optimize_NumVal(c0))
    }
}

// Add(other, home+disp) is LEA RAX, [home + RAX + disp] after other is in
// RAX. Add is commutative, so the home may sit on the left. Returns 0 when
// nothing was emitted, 1 when RAX holds the sum, 2 when emission started
// and then failed.

Function.Optimize_TryLea {
    Input: func_name: Address
    Input: arg0: Address
    Input: arg1: Address
    Output: Integer
    Body: {
        IfCondition NotEqual(StringCompare(func_name, "Add"), 0) ThenBlock: { ReturnValue(0) }
        reg = Optimize_LeaReg(arg1)
        leaf = arg1
        other = arg0
        IfCondition EqualTo(reg, 0) ThenBlock: {
            reg = Optimize_LeaReg(arg0)
            IfCondition EqualTo(reg, 0) ThenBlock: { ReturnValue(0) }
            leaf = arg0
            other = arg1
        }
        kind = AST_GetType(other)
        ok = 0
        IfCondition EqualTo(kind, AST.NUMBER) ThenBlock: { ok = 1 }
        IfCondition EqualTo(kind, AST.IDENTIFIER) ThenBlock: { ok = 1 }
        IfCondition EqualTo(kind, AST.CALL) ThenBlock: {
            IfCondition EqualTo(Optimize_IsMathOp(AST_GetData1(other)), 1) ThenBlock: { ok = 1 }
        }
        IfCondition EqualTo(ok, 0) ThenBlock: { ReturnValue(0) }
        got = Optimize_LoadToRax(other)
        IfCondition EqualTo(got, 0) ThenBlock: { ReturnValue(2) }
        X86_LeaRaxHome(reg, Optimize_LeaDisp(leaf))
        ReturnValue(1)
    }
}

// Returns 0 when the shape does not match (nothing emitted), 1 when RAX is
// the left operand and RBX is the right, 2 when the shape matched but a
// load failed after emission started.

Function.Optimize_TryRbxLeaf {
    Input: node: Address
    Input: func_name: Address
    Input: arg0: Address
    Input: arg1: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(Optimize_IsImmLeaf(arg1), 1) ThenBlock: {
            leaf_name = Optimize_LeafName(arg1)
            same = Optimize_NameIs(arg0, leaf_name)
            IfCondition EqualTo(same, 1) ThenBlock: {
                got = Optimize_LoadToRax(arg0)
                IfCondition EqualTo(got, 0) ThenBlock: { ReturnValue(2) }
                Optimize_RbxFromRax(arg1)
                ReturnValue(1)
            }
            got = Optimize_LoadToRax(arg0)
            IfCondition EqualTo(got, 0) ThenBlock: { ReturnValue(2) }
            got = Optimize_LoadRbxLeaf(arg1)
            IfCondition EqualTo(got, 0) ThenBlock: { ReturnValue(2) }
            ReturnValue(1)
        }
        IfCondition EqualTo(Optimize_IsComm(func_name), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_IsImmLeaf(arg0), 0) ThenBlock: { ReturnValue(0) }
        leaf_name = Optimize_LeafName(arg0)
        same = Optimize_NameIs(arg1, leaf_name)
        IfCondition EqualTo(same, 0) ThenBlock: { ReturnValue(0) }
        got = Optimize_LoadToRax(arg1)
        IfCondition EqualTo(got, 0) ThenBlock: { ReturnValue(2) }
        Optimize_RbxFromRax(arg0)
        ReturnValue(1)
    }
}

Function.Optimize_IsPow2 {
    Input: val: Integer
    Output: Integer
    Body: {
        IfCondition LessEqual(val, 0) ThenBlock: { ReturnValue(0) }
        masked = BitwiseAnd(val, Subtract(val, 1))
        IfCondition EqualTo(masked, 0) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

// 1 when EmitOperation ignores the incoming RBX. A constant shift or a
// power-of-two multiply still needs a number on the right. Divide and
// modulo also skip RBX when the divisor resolves and either the
// power-of-two arm or the magic multiply will take it. IDIV still loads RBX.

Function.Optimize_SkipRbx {
    Input: node: Address
    Input: func_name: Address
    Output: Integer
    Body: {
        arg1 = AST_GetChild(node, 1)
        is_shl = Or(EqualTo(StringCompare(func_name, "LeftShift"), 0), EqualTo(StringCompare(func_name, "ShiftLeft"), 0))
        is_shr = Or(EqualTo(StringCompare(func_name, "RightShift"), 0), EqualTo(StringCompare(func_name, "ShiftRight"), 0))
        IfCondition EqualTo(Or(is_shl, is_shr), 1) ThenBlock: {
            IfCondition NotEqual(AST_GetType(arg1), AST.NUMBER) ThenBlock: { ReturnValue(0) }
            ReturnValue(1)
        }
        is_mul = EqualTo(StringCompare(func_name, "Multiply"), 0)
        IfCondition EqualTo(is_mul, 1) ThenBlock: {
            IfCondition NotEqual(AST_GetType(arg1), AST.NUMBER) ThenBlock: { ReturnValue(0) }
            ReturnValue(Optimize_IsPow2(StringToNumber(AST_GetData1(arg1))))
        }
        is_div = EqualTo(StringCompare(func_name, "Divide"), 0)
        is_mod = EqualTo(StringCompare(func_name, "Modulo"), 0)
        IfCondition EqualTo(Or(is_div, is_mod), 0) ThenBlock: { ReturnValue(0) }
        known = CompileArith_KnownDivisor(node, arg1)
        IfCondition EqualTo(known, 0) ThenBlock: { ReturnValue(0) }
        val = OptState.bind_val
        IfCondition GreaterThan(val, 0) ThenBlock: {
            IfCondition EqualTo(Optimize_IsPow2(val), 1) ThenBlock: {
                IfCondition EqualTo(is_div, 1) ThenBlock: { ReturnValue(1) }
                IfCondition EqualTo(Optimize_Fit32(Subtract(val, 1)), 1) ThenBlock: {
                    IfCondition EqualTo(Optimize_ProvedNonNeg(AST_GetChild(node, 0)), 1) ThenBlock: {
                        ReturnValue(1)
                    }
                }
            }
        }
        ReturnValue(Optimize_MagicPrepare(val))
    }
}

// =============================================================================
// GENERIC: Optimize any binary math operation
// Three-way operand loading + operation dispatch
// Returns 1 if optimized, 0 to fall back to standard path
// =============================================================================
Function.Optimize_BinaryMathOp {
    Input: node: Address
    Output: Integer
    Body: {
        arg_count = AST_GetChildCount(node)
        IfCondition NotEqual(arg_count, 2) ThenBlock: {
            ReturnValue(0)
        }
        
        func_name = AST_GetData1(node)
        arg0 = AST_GetChild(node, 0)
        arg1 = AST_GetChild(node, 1)

        // i * c is the running product when this loop owns that factor.
        IfCondition EqualTo(StringCompare(func_name, "Multiply"), 0) ThenBlock: {
            IfCondition EqualTo(Optimize_TryProdUse(arg0, arg1), 1) ThenBlock: {
                ReturnValue(1)
            }
        }
        
        // Classify both operands
        type0 = AST_GetType(arg0)
        type1 = AST_GetType(arg1)
        left_is_simple = Or(EqualTo(type0, AST.NUMBER), EqualTo(type0, AST.IDENTIFIER))
        right_is_simple = Or(EqualTo(type1, AST.NUMBER), EqualTo(type1, AST.IDENTIFIER))

        // Add of a value and (home + constant) is one LEA. The home stays
        // in R12 or R13. Subtract and divide do not use it.
        lea_hit = Optimize_TryLea(func_name, arg0, arg1)
        IfCondition EqualTo(lea_hit, 2) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(lea_hit, 1) ThenBlock: { ReturnValue(1) }

        // A literal right-hand side on Add or Subtract is an immediate
        // operand, not a value worth a register. TryLea already took the
        // one-instruction form when a loop-home register was on one side;
        // this is the plain case TryRbxLeaf below would otherwise shuttle
        // through rbx for no reason, including straight-line code with no
        // loop home at all.
        IfCondition EqualTo(type1, AST.NUMBER) ThenBlock: {
            imm_fast = 0
            is_add = EqualTo(StringCompare(func_name, "Add"), 0)
            is_sub = EqualTo(StringCompare(func_name, "Subtract"), 0)
            is_mul_imm = 0
            IfCondition EqualTo(Or(is_add, is_sub), 1) ThenBlock: {
                imm_val = StringToNumber(AST_GetData1(arg1))
                IfCondition GreaterEqual(imm_val, -2147483648) ThenBlock: {
                    IfCondition LessEqual(imm_val, 2147483647) ThenBlock: {
                        imm_fast = 1
                    }
                }
            }
            // A non-power-of-2 multiply by a literal is a 3-operand IMUL,
            // not a shuttled register-register multiply. A power of 2 stays
            // on the existing shift path (SkipRbx below), which is at least
            // as cheap and already in place.
            IfCondition EqualTo(StringCompare(func_name, "Multiply"), 0) ThenBlock: {
                imm_val = StringToNumber(AST_GetData1(arg1))
                IfCondition GreaterEqual(imm_val, -2147483648) ThenBlock: {
                    IfCondition LessEqual(imm_val, 2147483647) ThenBlock: {
                        IfCondition EqualTo(Optimize_IsPow2(imm_val), 0) ThenBlock: {
                            imm_fast = 1
                            is_mul_imm = 1
                        }
                    }
                }
            }
            IfCondition EqualTo(imm_fast, 1) ThenBlock: {
                result = Optimize_LoadToRax(arg0)
                IfCondition EqualTo(result, 0) ThenBlock: { ReturnValue(0) }
                IfCondition EqualTo(is_add, 1) ThenBlock: { Emit_AddRaxImm32(imm_val) }
                IfCondition EqualTo(is_sub, 1) ThenBlock: { Emit_SubRaxImm32(imm_val) }
                IfCondition EqualTo(is_mul_imm, 1) ThenBlock: { Emit_ImulRaxImm32(imm_val) }
                ReturnValue(1)
            }
        }

        // An immediate add or subtract on the right is built in RBX after
        // the left is in RAX. Operand order stays left-then-right.
        leaf_hit = Optimize_TryRbxLeaf(node, func_name, arg0, arg1)
        IfCondition EqualTo(leaf_hit, 2) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(leaf_hit, 1) ThenBlock: {
            emit_result = Optimize_EmitOperation(node, func_name)
            ReturnValue(emit_result)
        }
        
        IfCondition EqualTo(right_is_simple, 1) ThenBlock: {
            // PATH A: right is simple (includes both-simple)
            // left → RAX (may recurse), right → RBX (leaf, safe)
            result = Optimize_LoadToRax(arg0)
            IfCondition EqualTo(result, 0) ThenBlock: {
                ReturnValue(0)
            }
            // A power-of-two or constant-shift arm does not read RBX.
            IfCondition EqualTo(Optimize_SkipRbx(node, func_name), 0) ThenBlock: {
                result = Optimize_LoadToRbx(arg1)
                IfCondition EqualTo(result, 0) ThenBlock: {
                    ReturnValue(0)
                }
            }
        } ElseBlock: {
            IfCondition EqualTo(left_is_simple, 1) ThenBlock: {
                // PATH B: left is simple, right is complex — NEW
                // Evaluate right FIRST → RAX, stash in RBX
                // Then load simple left → RAX (leaf, won't touch RBX)
                result = Optimize_LoadToRax(arg1)
                IfCondition EqualTo(result, 0) ThenBlock: {
                    ReturnValue(0)
                }
                Emit_MovRbxRax()
                result = Optimize_LoadToRax(arg0)
                IfCondition EqualTo(result, 0) ThenBlock: {
                    ReturnValue(0)
                }
            } ElseBlock: {
                // PATH C: both complex — push/pop unavoidable
                result = Optimize_LoadToRax(arg0)
                IfCondition EqualTo(result, 0) ThenBlock: {
                    ReturnValue(0)
                }
                Emit_PushRax()
                result = Optimize_LoadToRbx(arg1)
                IfCondition EqualTo(result, 0) ThenBlock: {
                    ReturnValue(0)
                }
                Emit_PopRax()
            }
        }
        emit_result = Optimize_EmitOperation(node, func_name)
        ReturnValue(emit_result)



        // RAX = left, RBX = right — emit the operation
        ReturnValue(Optimize_EmitOperation(node, func_name))
    }
}

// =============================================================================
// DISPATCHER: Try to optimize any math operation
// Call this from Compile_Expression for CALL nodes
// Returns 1 if optimized, 0 to use standard path
// =============================================================================
Function.Optimize_TryMathOp {
    Input: node: Address
    Output: Integer
    Body: {
        func_name = AST_GetData1(node)

        // Check if it's a math op we handle
        IfCondition EqualTo(Optimize_IsMathOp(func_name), 1) ThenBlock: {
            ReturnValue(Optimize_BinaryMathOp(node))
        }
        
        // Not a math op we optimize
        ReturnValue(0)
    }
}

// =============================================================================
// HELPER: Check if function is optimizable math op
// =============================================================================


Function.Optimize_IsMathOp {
    Input: name: Address
    Output: Integer
    Body: {
        // Arithmetic
        IfCondition EqualTo(StringCompare(name, "Add"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "Subtract"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "Multiply"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "Divide"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "Modulo"), 0) ThenBlock: { ReturnValue(1) }
        
        // Comparisons
        IfCondition EqualTo(StringCompare(name, "EqualTo"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "NotEqual"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "LessThan"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "GreaterThan"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "LessEqual"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "GreaterEqual"), 0) ThenBlock: { ReturnValue(1) }
        
        // Bitwise
        IfCondition EqualTo(StringCompare(name, "BitwiseAnd"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "BitwiseOr"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "BitwiseXor"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "LeftShift"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "RightShift"), 0) ThenBlock: { ReturnValue(1) }
        
        // Short aliases
        IfCondition EqualTo(StringCompare(name, "BitAnd"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "BitOr"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "BitXor"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "ShiftLeft"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "ShiftRight"), 0) ThenBlock: { ReturnValue(1) }
        
        ReturnValue(0)
    }
}
