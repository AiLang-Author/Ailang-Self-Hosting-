// Library.COptNonNeg.ailang
// Non-negative proof, range, and arithmetic-shift safety.
// Loaded by the optimizer shell. No imports of its own.

// A non-negative dividend may use the unsigned magic. The fact is read
// off the AST: every assignment of the name produces a non-negative
// value, a local is written on the straight-line path before it is
// read, and a parameter is non-negative only when every direct call
// passes one. AddressOf of the name, or of the function, refuses.
// One +1 under a header test `name < bound` cannot wrap a non-negative
// value. Any other self-update must prove itself. A negative literal,
// a failed call site, or an unknown write keeps the signed divide.

Function.Optimize_NnForget {
    Body: {
        IfCondition NotEqual(OptState.nn_cache, 0) ThenBlock: {
            SHash.Destroy(OptState.nn_cache)
            OptState.nn_cache = 0
        }
        IfCondition NotEqual(OptState.nn_visit, 0) ThenBlock: {
            SHash.Destroy(OptState.nn_visit)
            OptState.nn_visit = 0
        }
        ReturnValue(0)
    }
}

Function.Optimize_NnReset {
    Body: {
        Optimize_NnForget()
        IfCondition NotEqual(OptState.nn_sites, 0) ThenBlock: {
            SHash.Destroy(OptState.nn_sites)
            OptState.nn_sites = 0
        }
        IfCondition NotEqual(OptState.nn_from, 0) ThenBlock: {
            SHash.Destroy(OptState.nn_from)
            OptState.nn_from = 0
        }
        IfCondition NotEqual(OptState.nn_poison, 0) ThenBlock: {
            SHash.Destroy(OptState.nn_poison)
            OptState.nn_poison = 0
        }
        OptState.nn_ready = 0
        OptState.nn_ast = 0
        ReturnValue(0)
    }
}

Function.Optimize_NnPush {
    Input: cname: Address
    Input: call: Address
    Input: func: Address
    Body: {
        arr = SHash.LookupAddr(OptState.nn_sites, cname)
        IfCondition EqualTo(arr, Collections.XNULL) ThenBlock: { arr = 0 }
        IfCondition EqualTo(arr, 0) ThenBlock: {
            arr = Array.Create(4)
            SHash.InsertAddr(OptState.nn_sites, cname, arr)
        }
        Array.Push(arr, call)
        far = SHash.LookupAddr(OptState.nn_from, cname)
        IfCondition EqualTo(far, Collections.XNULL) ThenBlock: { far = 0 }
        IfCondition EqualTo(far, 0) ThenBlock: {
            far = Array.Create(4)
            SHash.InsertAddr(OptState.nn_from, cname, far)
        }
        Array.Push(far, func)
        ReturnValue(0)
    }
}

Function.Optimize_NnWalk {
    Input: node: Address
    Input: func: Address
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        nt = AST_GetType(node)
        next = func
        IfCondition EqualTo(nt, AST.FUNCTION) ThenBlock: { next = node }
        IfCondition EqualTo(nt, AST.SUBROUTINE) ThenBlock: { next = node }
        IfCondition EqualTo(nt, AST.INLINE_FUNCTION) ThenBlock: { next = node }
        IfCondition EqualTo(nt, AST.CALL) ThenBlock: {
            cname = AST_GetData1(node)
            IfCondition NotEqual(cname, 0) ThenBlock: {
                IfCondition EqualTo(Optimize_NameEq(cname, "AddressOf"), 1) ThenBlock: {
                    IfCondition GreaterThan(AST_GetChildCount(node), 0) ThenBlock: {
                        a0 = AST_GetChild(node, 0)
                        IfCondition NotEqual(a0, 0) ThenBlock: {
                            IfCondition EqualTo(AST_GetType(a0), AST.IDENTIFIER) ThenBlock: {
                                an = AST_GetData1(a0)
                                IfCondition NotEqual(an, 0) ThenBlock: {
                                    SHash.Insert(OptState.nn_poison, an, 1)
                                }
                            }
                        }
                    }
                } ElseBlock: {
                    Optimize_NnPush(cname, node, next)
                }
            }
        }
        ccount = AST_GetChildCount(node)
        i = 0
        WhileLoop LessThan(i, ccount) {
            Optimize_NnWalk(AST_GetChild(node, i), next)
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

// Once per program, before the first splice. Later folds mutate call
// arguments in place, so the recorded nodes stay the live ones.
Function.Optimize_NnIndex {
    Body: {
        IfCondition EqualTo(OptState.nn_ready, 1) ThenBlock: {
            IfCondition EqualTo(OptState.nn_ast, Compile.ast) ThenBlock: {
                ReturnValue(0)
            }
        }
        Optimize_NnReset()
        IfCondition EqualTo(Compile.ast, 0) ThenBlock: { ReturnValue(0) }
        OptState.nn_sites = SHash.Create(4096)
        OptState.nn_from = SHash.Create(4096)
        OptState.nn_poison = SHash.Create(1024)
        Optimize_NnWalk(Compile.ast, 0)
        OptState.nn_ready = 1
        OptState.nn_ast = Compile.ast
        ReturnValue(0)
    }
}

Function.Optimize_NnKey {
    Input: func: Address
    Input: name: Address
    Output: Address
    Body: {
        IfCondition EqualTo(func, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }
        fn = AST_GetData1(func)
        IfCondition EqualTo(fn, 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(StringConcat(StringConcat(fn, "#"), name))
    }
}

Function.Optimize_NnParam {
    Input: func: Address
    Input: name: Address
    Output: Integer
    Body: {
        found = -1
        idx = 0
        ccount = AST_GetChildCount(func)
        i = 0
        WhileLoop LessThan(i, ccount) {
            ch = AST_GetChild(func, i)
            IfCondition EqualTo(AST_GetType(ch), AST.PARAMETER) ThenBlock: {
                IfCondition EqualTo(Optimize_NameEq(AST_GetData1(ch), name), 1) ThenBlock: {
                    found = idx
                }
                idx = Add(idx, 1)
            }
            i = Add(i, 1)
        }
        ReturnValue(found)
    }
}

Function.Optimize_NnLoop {
    Input: nt: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(nt, AST.WHILE) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(nt, AST.FOR_EVERY) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(nt, AST.UNTIL) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(nt, AST.LOOP_MAIN) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(nt, AST.LOOP_ACTOR) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(nt, AST.LOOP_START) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(nt, AST.LOOP_SHADOW) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(nt, AST.EVERY_INTERVAL) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

Function.Optimize_NnReads {
    Input: node: Address
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        nt = AST_GetType(node)
        IfCondition EqualTo(nt, AST.FUNCTION) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(nt, AST.SUBROUTINE) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(nt, AST.INLINE_FUNCTION) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(nt, AST.IDENTIFIER) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(AST_GetData1(node), name), 1) ThenBlock: {
                ReturnValue(1)
            }
        }
        ccount = AST_GetChildCount(node)
        i = 0
        WhileLoop LessThan(i, ccount) {
            IfCondition EqualTo(Optimize_NnReads(AST_GetChild(node, i), name), 1) ThenBlock: {
                ReturnValue(1)
            }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

Function.Optimize_NnHasAssign {
    Input: node: Address
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        nt = AST_GetType(node)
        IfCondition EqualTo(nt, AST.FUNCTION) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(nt, AST.SUBROUTINE) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(nt, AST.INLINE_FUNCTION) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(nt, AST.ASSIGNMENT) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(AST_GetData1(node), name), 1) ThenBlock: {
                ReturnValue(1)
            }
        }
        ccount = AST_GetChildCount(node)
        i = 0
        WhileLoop LessThan(i, ccount) {
            IfCondition EqualTo(Optimize_NnHasAssign(AST_GetChild(node, i), name), 1) ThenBlock: {
                ReturnValue(1)
            }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

// name = name + 1, either operand order.
Function.Optimize_NnIsInc1 {
    Input: node: Address
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(node), AST.CALL) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(StringCompare(AST_GetData1(node), "Add"), 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetChildCount(node), 2) ThenBlock: { ReturnValue(0) }
        c0 = AST_GetChild(node, 0)
        c1 = AST_GetChild(node, 1)
        IfCondition EqualTo(AST_GetType(c1), AST.NUMBER) ThenBlock: {
            IfCondition EqualTo(StringToNumber(AST_GetData1(c1)), 1) ThenBlock: {
                IfCondition EqualTo(AST_GetType(c0), AST.IDENTIFIER) ThenBlock: {
                    ReturnValue(Optimize_NameEq(AST_GetData1(c0), name))
                }
            }
        }
        IfCondition EqualTo(AST_GetType(c0), AST.NUMBER) ThenBlock: {
            IfCondition EqualTo(StringToNumber(AST_GetData1(c0)), 1) ThenBlock: {
                IfCondition EqualTo(AST_GetType(c1), AST.IDENTIFIER) ThenBlock: {
                    ReturnValue(Optimize_NameEq(AST_GetData1(c1), name))
                }
            }
        }
        ReturnValue(0)
    }
}

// Header test name < bound, or bound > name. LessEqual can observe the
// maximum signed value and the following +1 wraps.
Function.Optimize_NnBound {
    Input: node: Address
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(node), AST.CALL) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetChildCount(node), 2) ThenBlock: { ReturnValue(0) }
        op = AST_GetData1(node)
        left = AST_GetChild(node, 0)
        right = AST_GetChild(node, 1)
        IfCondition EqualTo(StringCompare(op, "LessThan"), 0) ThenBlock: {
            IfCondition EqualTo(AST_GetType(left), AST.IDENTIFIER) ThenBlock: {
                ReturnValue(Optimize_NameEq(AST_GetData1(left), name))
            }
            ReturnValue(0)
        }
        IfCondition EqualTo(StringCompare(op, "GreaterThan"), 0) ThenBlock: {
            IfCondition EqualTo(AST_GetType(right), AST.IDENTIFIER) ThenBlock: {
                ReturnValue(Optimize_NameEq(AST_GetData1(right), name))
            }
        }
        ReturnValue(0)
    }
}

// 1 when the body increments name by exactly 1 once, and no nested loop
// writes it. -1 when some other write is present.
Function.Optimize_NnIncTally {
    Input: node: Address
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        nt = AST_GetType(node)
        IfCondition EqualTo(nt, AST.FUNCTION) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(nt, AST.SUBROUTINE) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(nt, AST.INLINE_FUNCTION) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_NnLoop(nt), 1) ThenBlock: {
            IfCondition EqualTo(Optimize_NnHasAssign(node, name), 1) ThenBlock: {
                ReturnValue(-1)
            }
            ReturnValue(0)
        }
        IfCondition EqualTo(nt, AST.ASSIGNMENT) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(AST_GetData1(node), name), 1) ThenBlock: {
                IfCondition NotEqual(AST_GetData2(node), 0) ThenBlock: { ReturnValue(-1) }
                IfCondition LessThan(AST_GetChildCount(node), 1) ThenBlock: { ReturnValue(-1) }
                IfCondition EqualTo(Optimize_NnIsInc1(AST_GetChild(node, 0), name), 0) ThenBlock: {
                    ReturnValue(-1)
                }
                ReturnValue(1)
            }
        }
        total = 0
        ccount = AST_GetChildCount(node)
        i = 0
        WhileLoop LessThan(i, ccount) {
            part = Optimize_NnIncTally(AST_GetChild(node, i), name)
            IfCondition LessThan(part, 0) ThenBlock: { ReturnValue(-1) }
            total = Add(total, part)
            i = Add(i, 1)
        }
        ReturnValue(total)
    }
}

Function.Optimize_NnIncSafe {
    Input: loop: Address
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(loop, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(loop), AST.WHILE) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(AST_GetChildCount(loop), 2) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_NnBound(AST_GetChild(loop, 0), name), 0) ThenBlock: {
            ReturnValue(0)
        }
        total = Optimize_NnIncTally(AST_GetChild(loop, 1), name)
        IfCondition EqualTo(total, 1) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

// 1 when expr cannot be negative. assume is a name already known
// non-negative, used for the update n = Divide(n, positive).
Function.Optimize_NnExpr {
    Input: node: Address
    Input: func: Address
    Input: assume: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        nt = AST_GetType(node)
        IfCondition EqualTo(nt, AST.NUMBER) ThenBlock: {
            IfCondition LessThan(StringToNumber(AST_GetData1(node)), 0) ThenBlock: {
                ReturnValue(0)
            }
            ReturnValue(1)
        }
        IfCondition EqualTo(nt, AST.IDENTIFIER) ThenBlock: {
            idn = AST_GetData1(node)
            IfCondition NotEqual(assume, 0) ThenBlock: {
                IfCondition EqualTo(Optimize_NameEq(idn, assume), 1) ThenBlock: {
                    ReturnValue(1)
                }
            }
            ReturnValue(Optimize_NameNonNeg(func, idn))
        }
        IfCondition NotEqual(nt, AST.CALL) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetChildCount(node), 2) ThenBlock: { ReturnValue(0) }
        op = AST_GetData1(node)
        divop = 0
        IfCondition EqualTo(StringCompare(op, "Divide"), 0) ThenBlock: { divop = 1 }
        IfCondition EqualTo(StringCompare(op, "Modulo"), 0) ThenBlock: { divop = 1 }
        IfCondition EqualTo(divop, 0) ThenBlock: { ReturnValue(0) }
        den = AST_GetChild(node, 1)
        IfCondition NotEqual(AST_GetType(den), AST.NUMBER) ThenBlock: { ReturnValue(0) }
        IfCondition LessEqual(StringToNumber(AST_GetData1(den)), 0) ThenBlock: {
            ReturnValue(0)
        }
        ReturnValue(Optimize_NnExpr(AST_GetChild(node, 0), func, assume))
    }
}

// flags bit0 = parameter, bit1 = not straight-line. Returns the number
// of straight-line assignments, or -1 when a write or an early read is
// not non-negative.
Function.Optimize_NnScan {
    Input: node: Address
    Input: name: Address
    Input: func: Address
    Input: loop: Address
    Input: seen: Integer
    Input: flags: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(seen) }
        IfCondition LessThan(seen, 0) ThenBlock: { ReturnValue(-1) }
        nt = AST_GetType(node)
        IfCondition EqualTo(nt, AST.FUNCTION) ThenBlock: { ReturnValue(seen) }
        IfCondition EqualTo(nt, AST.SUBROUTINE) ThenBlock: { ReturnValue(seen) }
        IfCondition EqualTo(nt, AST.INLINE_FUNCTION) ThenBlock: { ReturnValue(seen) }
        is_param = BitwiseAnd(flags, 1)
        guard = 0
        IfCondition GreaterEqual(flags, 2) ThenBlock: { guard = 1 }
        IfCondition EqualTo(nt, AST.WHILE) ThenBlock: {
            wflags = Add(is_param, 2)
            ccount = AST_GetChildCount(node)
            i = 0
            WhileLoop LessThan(i, ccount) {
                seen = Optimize_NnScan(AST_GetChild(node, i), name, func, node, seen, wflags)
                IfCondition LessThan(seen, 0) ThenBlock: { ReturnValue(-1) }
                i = Add(i, 1)
            }
            ReturnValue(seen)
        }
        IfCondition EqualTo(nt, AST.ASSIGNMENT) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(AST_GetData1(node), name), 1) ThenBlock: {
                IfCondition NotEqual(AST_GetData2(node), 0) ThenBlock: { ReturnValue(-1) }
                IfCondition LessThan(AST_GetChildCount(node), 1) ThenBlock: { ReturnValue(-1) }
                rhs = AST_GetChild(node, 0)
                IfCondition EqualTo(is_param, 0) ThenBlock: {
                    IfCondition EqualTo(seen, 0) ThenBlock: {
                        IfCondition EqualTo(Optimize_NnReads(rhs, name), 1) ThenBlock: {
                            ReturnValue(-1)
                        }
                    }
                }
                ok = 0
                IfCondition EqualTo(Optimize_NnIsInc1(rhs, name), 1) ThenBlock: {
                    ok = Optimize_NnIncSafe(loop, name)
                } ElseBlock: {
                    ok = Optimize_NnExpr(rhs, func, name)
                }
                IfCondition EqualTo(ok, 0) ThenBlock: { ReturnValue(-1) }
                IfCondition EqualTo(guard, 0) ThenBlock: { ReturnValue(Add(seen, 1)) }
                ReturnValue(seen)
            }
        }
        IfCondition EqualTo(nt, AST.CALL) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(AST_GetData1(node), "AddressOf"), 1) ThenBlock: {
                IfCondition GreaterThan(AST_GetChildCount(node), 0) ThenBlock: {
                    a0 = AST_GetChild(node, 0)
                    IfCondition NotEqual(a0, 0) ThenBlock: {
                        IfCondition EqualTo(AST_GetType(a0), AST.IDENTIFIER) ThenBlock: {
                            IfCondition EqualTo(Optimize_NameEq(AST_GetData1(a0), name), 1) ThenBlock: {
                                ReturnValue(-1)
                            }
                        }
                    }
                }
            }
        }
        IfCondition EqualTo(nt, AST.IDENTIFIER) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(AST_GetData1(node), name), 1) ThenBlock: {
                IfCondition EqualTo(is_param, 0) ThenBlock: {
                    IfCondition EqualTo(seen, 0) ThenBlock: { ReturnValue(-1) }
                }
            }
            ReturnValue(seen)
        }
        next_flags = is_param
        IfCondition NotEqual(nt, AST.BLOCK) ThenBlock: {
            next_flags = Add(is_param, 2)
        }
        ccount = AST_GetChildCount(node)
        i = 0
        WhileLoop LessThan(i, ccount) {
            seen = Optimize_NnScan(AST_GetChild(node, i), name, func, loop, seen, next_flags)
            IfCondition LessThan(seen, 0) ThenBlock: { ReturnValue(-1) }
            i = Add(i, 1)
        }
        ReturnValue(seen)
    }
}

Function.Optimize_NnScanList {
    Input: node: Address
    Input: name: Address
    Input: func: Address
    Input: seen: Integer
    Input: flags: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(seen) }
        ccount = AST_GetChildCount(node)
        i = 0
        WhileLoop LessThan(i, ccount) {
            seen = Optimize_NnScan(AST_GetChild(node, i), name, func, 0, seen, flags)
            IfCondition LessThan(seen, 0) ThenBlock: { ReturnValue(-1) }
            i = Add(i, 1)
        }
        ReturnValue(seen)
    }
}

Function.Optimize_NnIncoming {
    Input: func: Address
    Input: pidx: Integer
    Output: Integer
    Body: {
        fname = AST_GetData1(func)
        IfCondition EqualTo(fname, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(OptState.nn_poison, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(SHash.Lookup(OptState.nn_poison, fname), 1) ThenBlock: {
            ReturnValue(0)
        }
        sites = SHash.LookupAddr(OptState.nn_sites, fname)
        froms = SHash.LookupAddr(OptState.nn_from, fname)
        IfCondition EqualTo(sites, Collections.XNULL) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(froms, Collections.XNULL) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(sites, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(froms, 0) ThenBlock: { ReturnValue(0) }
        n = Array.Size(sites)
        IfCondition LessThan(n, 1) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(Array.Size(froms), n) ThenBlock: { ReturnValue(0) }
        i = 0
        WhileLoop LessThan(i, n) {
            call = Array.Get(sites, i)
            caller = Array.Get(froms, i)
            IfCondition EqualTo(call, 0) ThenBlock: { ReturnValue(0) }
            IfCondition EqualTo(caller, 0) ThenBlock: { ReturnValue(0) }
            IfCondition LessEqual(AST_GetChildCount(call), pidx) ThenBlock: { ReturnValue(0) }
            IfCondition EqualTo(Optimize_NnExpr(AST_GetChild(call, pidx), caller, 0), 0) ThenBlock: {
                ReturnValue(0)
            }
            i = Add(i, 1)
        }
        ReturnValue(1)
    }
}

Function.Optimize_NnProve {
    Input: func: Address
    Input: name: Address
    Output: Integer
    Body: {
        is_param = 0
        pidx = Optimize_NnParam(func, name)
        IfCondition GreaterEqual(pidx, 0) ThenBlock: {
            is_param = 1
            IfCondition EqualTo(Optimize_NnIncoming(func, pidx), 0) ThenBlock: {
                ReturnValue(0)
            }
        }
        root = Optimize_InlineBody(func)
        seen = 0
        IfCondition EqualTo(root, 0) ThenBlock: {
            seen = Optimize_NnScanList(func, name, func, 0, is_param)
        } ElseBlock: {
            seen = Optimize_NnScan(root, name, func, 0, 0, is_param)
        }
        IfCondition LessThan(seen, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(is_param, 0) ThenBlock: {
            IfCondition LessThan(seen, 1) ThenBlock: { ReturnValue(0) }
        }
        ReturnValue(1)
    }
}

Function.Optimize_NameNonNeg {
    Input: func: Address
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(func, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Compile.ast, 0) ThenBlock: { ReturnValue(0) }
        Optimize_NnIndex()
        key = Optimize_NnKey(func, name)
        IfCondition EqualTo(key, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(OptState.nn_cache, 0) ThenBlock: {
            hit = SHash.Lookup(OptState.nn_cache, key)
            IfCondition EqualTo(hit, 1) ThenBlock: { ReturnValue(1) }
            IfCondition EqualTo(hit, 2) ThenBlock: { ReturnValue(0) }
        }
        IfCondition EqualTo(OptState.nn_visit, 0) ThenBlock: {
            OptState.nn_visit = SHash.Create(4096)
        }
        IfCondition EqualTo(SHash.Lookup(OptState.nn_visit, key), 1) ThenBlock: {
            ReturnValue(0)
        }
        SHash.Insert(OptState.nn_visit, key, 1)
        ok = Optimize_NnProve(func, name)
        SHash.Insert(OptState.nn_visit, key, 0)
        IfCondition EqualTo(OptState.nn_cache, 0) ThenBlock: {
            OptState.nn_cache = SHash.Create(4096)
        }
        mark = 2
        IfCondition EqualTo(ok, 1) ThenBlock: { mark = 1 }
        SHash.Insert(OptState.nn_cache, key, mark)
        ReturnValue(ok)
    }
}

// Proven range inside [0, 2^63). The bounds themselves fit in a signed
// int64, and the checks refuse a sum or product that would wrap.
Function.Optimize_RangeName {
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(LoopHome.iv_nn, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_NameEq(name, LoopHome.int_name), 0) ThenBlock: { ReturnValue(0) }
        LoopHome.range_lo = LoopHome.iv_lo
        LoopHome.range_hi = LoopHome.iv_hi
        ReturnValue(1)
    }
}

Function.Optimize_Range {
    Input: node: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        nt = AST_GetType(node)
        IfCondition EqualTo(nt, AST.NUMBER) ThenBlock: {
            val = StringToNumber(AST_GetData1(node))
            IfCondition LessThan(val, 0) ThenBlock: { ReturnValue(0) }
            LoopHome.range_lo = val
            LoopHome.range_hi = val
            ReturnValue(1)
        }
        IfCondition EqualTo(nt, AST.IDENTIFIER) ThenBlock: {
            named = AST_GetData1(node)
            got = Optimize_RangeName(named)
            IfCondition EqualTo(got, 1) ThenBlock: { ReturnValue(1) }
            IfCondition EqualTo(Compile.current_func, 0) ThenBlock: { ReturnValue(0) }
            IfCondition EqualTo(Optimize_NameNonNeg(Compile.current_func, named), 1) ThenBlock: {
                LoopHome.range_lo = 0
                LoopHome.range_hi = 9223372036854775807
                ReturnValue(1)
            }
            ReturnValue(0)
        }
        IfCondition NotEqual(nt, AST.CALL) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetChildCount(node), 2) ThenBlock: { ReturnValue(0) }
        op = AST_GetData1(node)
        is_add = EqualTo(StringCompare(op, "Add"), 0)
        is_sub = EqualTo(StringCompare(op, "Subtract"), 0)
        is_mul = EqualTo(StringCompare(op, "Multiply"), 0)
        IfCondition EqualTo(Or(is_add, Or(is_sub, is_mul)), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_Range(AST_GetChild(node, 0)), 0) ThenBlock: { ReturnValue(0) }
        lo0 = LoopHome.range_lo
        hi0 = LoopHome.range_hi
        IfCondition EqualTo(Optimize_Range(AST_GetChild(node, 1)), 0) ThenBlock: { ReturnValue(0) }
        lo1 = LoopHome.range_lo
        hi1 = LoopHome.range_hi
        maxv = 9223372036854775807
        IfCondition EqualTo(is_add, 1) ThenBlock: {
            IfCondition GreaterThan(hi0, Subtract(maxv, hi1)) ThenBlock: { ReturnValue(0) }
            LoopHome.range_lo = Add(lo0, lo1)
            LoopHome.range_hi = Add(hi0, hi1)
            ReturnValue(1)
        }
        IfCondition EqualTo(is_sub, 1) ThenBlock: {
            IfCondition LessThan(lo0, hi1) ThenBlock: { ReturnValue(0) }
            LoopHome.range_lo = Subtract(lo0, hi1)
            LoopHome.range_hi = Subtract(hi0, lo1)
            ReturnValue(1)
        }
        IfCondition GreaterThan(hi0, 0) ThenBlock: {
            IfCondition GreaterThan(hi1, Divide(maxv, hi0)) ThenBlock: { ReturnValue(0) }
        }
        LoopHome.range_lo = Multiply(lo0, lo1)
        LoopHome.range_hi = Multiply(hi0, hi1)
        ReturnValue(1)
    }
}

Function.Optimize_NonNeg {
    Input: node: Address
    Output: Integer
    Body: {
        ReturnValue(Optimize_Range(node))
    }
}

// Same proof as Optimize_NonNeg, without leaving a range in LoopHome.
Function.Optimize_ProvedNonNeg {
    Input: node: Address
    Output: Integer
    Body: {
        saved_lo = LoopHome.range_lo
        saved_hi = LoopHome.range_hi
        proved = Optimize_NonNeg(node)
        LoopHome.range_lo = saved_lo
        LoopHome.range_hi = saved_hi
        ReturnValue(proved)
    }
}

Function.Optimize_SameBase {
    Input: a: Address
    Input: b: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(a, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(b, 0) ThenBlock: { ReturnValue(0) }
        ta = AST_GetType(a)
        tb = AST_GetType(b)
        IfCondition NotEqual(ta, tb) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(ta, AST.NUMBER) ThenBlock: {
            IfCondition EqualTo(StringToNumber(AST_GetData1(a)), StringToNumber(AST_GetData1(b))) ThenBlock: {
                ReturnValue(1)
            }
            ReturnValue(0)
        }
        IfCondition EqualTo(ta, AST.IDENTIFIER) ThenBlock: {
            ReturnValue(Optimize_NameEq(AST_GetData1(a), AST_GetData1(b)))
        }
        ReturnValue(0)
    }
}

// Add(x, 1) or Add(1, x), and x is the same number or the same name.
Function.Optimize_EvenAdd {
    Input: addn: Address
    Input: base: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(addn, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(addn), AST.CALL) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(StringCompare(AST_GetData1(addn), "Add"), 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetChildCount(addn), 2) ThenBlock: { ReturnValue(0) }
        c0 = AST_GetChild(addn, 0)
        c1 = AST_GetChild(addn, 1)
        IfCondition EqualTo(AST_GetType(c1), AST.NUMBER) ThenBlock: {
            IfCondition EqualTo(StringToNumber(AST_GetData1(c1)), 1) ThenBlock: {
                ReturnValue(Optimize_SameBase(c0, base))
            }
        }
        IfCondition EqualTo(AST_GetType(c0), AST.NUMBER) ThenBlock: {
            IfCondition EqualTo(StringToNumber(AST_GetData1(c0)), 1) ThenBlock: {
                ReturnValue(Optimize_SameBase(c1, base))
            }
        }
        ReturnValue(0)
    }
}

// x*(x+1) is always even, wrapping add and multiply included. One of the
// two factors is even, and the low bit of a product depends only on the
// low bits. Division by 2 of an even value matches SAR. Division by 4
// does not: -6/4 is -1, and SAR by 2 is -2.
Function.Optimize_EvenPair {
    Input: node: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(node), AST.CALL) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(StringCompare(AST_GetData1(node), "Multiply"), 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetChildCount(node), 2) ThenBlock: { ReturnValue(0) }
        a0 = AST_GetChild(node, 0)
        a1 = AST_GetChild(node, 1)
        IfCondition EqualTo(Optimize_EvenAdd(a1, a0), 1) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(Optimize_EvenAdd(a0, a1), 1) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

// 1 when plain SAR by `shift` equals toward-zero Divide.
Function.Optimize_SarSafe {
    Input: node: Address
    Input: shift: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(shift, 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_NonNeg(node), 1) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(shift, 1) ThenBlock: {
            ReturnValue(Optimize_EvenPair(node))
        }
        ReturnValue(0)
    }
}
