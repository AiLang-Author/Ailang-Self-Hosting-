// Library.COptOut.ailang
// Outer pointer keeps, zero floats, and dead index temps.
// Loaded by the optimizer shell. No imports of its own.

Function.Optimize_TreeHasJump {
    Input: node: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        t = AST_GetType(node)
        IfCondition EqualTo(t, AST.EXIT_LOOP) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(t, AST.CONTINUE_LOOP) ThenBlock: { ReturnValue(1) }
        count = AST_GetChildCount(node)
        i = 0
        WhileLoop LessThan(i, count) {
            IfCondition EqualTo(Optimize_TreeHasJump(AST_GetChild(node, i)), 1) ThenBlock: { ReturnValue(1) }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

Function.Optimize_IpIsDrop {
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(LoopHome.d0_on, 1) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(name, LoopHome.d0_name), 1) ThenBlock: { ReturnValue(1) }
        }
        IfCondition EqualTo(LoopHome.d1_on, 1) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(name, LoopHome.d1_name), 1) ThenBlock: { ReturnValue(1) }
        }
        IfCondition EqualTo(LoopHome.d2_on, 1) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(name, LoopHome.d2_name), 1) ThenBlock: { ReturnValue(1) }
        }
        IfCondition EqualTo(LoopHome.d3_on, 1) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(name, LoopHome.d3_name), 1) ThenBlock: { ReturnValue(1) }
        }
        ReturnValue(0)
    }
}

// 1 when every read of the cursor is the step itself or a dropped address.
Function.Optimize_TripUsesOk {
    Output: Integer
    Body: {
        IfCondition EqualTo(LoopHome.body, 0) ThenBlock: { ReturnValue(0) }
        count = AST_GetChildCount(LoopHome.body)
        i = 0
        WhileLoop LessThan(i, count) {
            st = AST_GetChild(LoopHome.body, i)
            n = Optimize_CountIdents(st, LoopHome.int_name)
            IfCondition GreaterThan(n, 0) ThenBlock: {
                ok = 0
                IfCondition EqualTo(i, LoopHome.iv_at) ThenBlock: { ok = 1 }
                IfCondition EqualTo(ok, 0) ThenBlock: {
                    IfCondition EqualTo(Optimize_PlainAssign(st), 1) ThenBlock: {
                        tname = AST_GetData1(st)
                        IfCondition EqualTo(Optimize_IpIsNoted(tname), 1) ThenBlock: { ok = 1 }
                        IfCondition EqualTo(Optimize_IpIsDrop(tname), 1) ThenBlock: { ok = 1 }
                    }
                }
                IfCondition EqualTo(ok, 0) ThenBlock: { ReturnValue(0) }
            }
            i = Add(i, 1)
        }
        ReturnValue(1)
    }
}

// Counted loop whose cursor is only the trip count. r13 becomes the
// pointer end. The back edge compares the stepped pointer. SSE2, no k add.
Function.Optimize_TripArm {
    Output: Integer
    Body: {
        LoopHome.trip_on = 0
        IfCondition EqualTo(LoopHome.iv_nn, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(LoopHome.iv_step, 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(LoopHome.int_name, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_TreeHasJump(LoopHome.body), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_TripUsesOk(), 0) ThenBlock: { ReturnValue(0) }
        reg = 0
        bump = 0
        IfCondition EqualTo(LoopHome.ip0_on, 1) ThenBlock: {
            IfCondition GreaterThan(LoopHome.ip0_bump, 0) ThenBlock: {
                reg = LoopHome.ip0_reg
                bump = LoopHome.ip0_bump
            }
        }
        IfCondition EqualTo(reg, 0) ThenBlock: {
            IfCondition EqualTo(LoopHome.ip1_on, 1) ThenBlock: {
                IfCondition GreaterThan(LoopHome.ip1_bump, 0) ThenBlock: {
                    reg = LoopHome.ip1_reg
                    bump = LoopHome.ip1_bump
                }
            }
        }
        IfCondition EqualTo(reg, 0) ThenBlock: { ReturnValue(0) }
        okreg = 0
        IfCondition EqualTo(reg, 11) ThenBlock: { okreg = 1 }
        IfCondition EqualTo(reg, 14) ThenBlock: { okreg = 1 }
        IfCondition EqualTo(okreg, 0) ThenBlock: { ReturnValue(0) }
        trips = Add(Subtract(LoopHome.iv_hi, LoopHome.iv_lo), 1)
        IfCondition LessThan(trips, 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_Fit32(trips), 0) ThenBlock: { ReturnValue(0) }
        span = Multiply(trips, bump)
        IfCondition EqualTo(Optimize_Fit32(span), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(reg, 11) ThenBlock: { X86Enc_Assemble("MOV rax, r11") }
        IfCondition EqualTo(reg, 14) ThenBlock: { X86Enc_Assemble("MOV rax, r14") }
        Emit_AddRaxImm32(span)
        X86Enc_Assemble("MOV r13, rax")
        LoopHome.trip_on = 1
        LoopHome.trip_reg = reg
        LoopHome.trip_span = span
        LoopHome.trip_exit = Add(LoopHome.iv_lo, trips)
        ReturnValue(1)
    }
}

Function.Optimize_OutKill {
    Body: {
        OutKeep.a_on = 0
        OutKeep.b_on = 0
        OutKeep.c_on = 0
        ReturnValue(0)
    }
}

Function.Optimize_XmmKill {
    Body: {
        XmmKeep.n0 = 0
        XmmKeep.n1 = 0
        XmmKeep.n2 = 0
        XmmKeep.n3 = 0
        XmmKeep.n4 = 0
        XmmKeep.n5 = 0
        ReturnValue(0)
    }
}

Function.Optimize_XmmNote {
    Input: name: Address
    Input: xmm: Integer
    Body: {
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_NameEq(XmmKeep.n0, name), 1) ThenBlock: { XmmKeep.x0 = xmm ReturnValue(0) }
        IfCondition EqualTo(Optimize_NameEq(XmmKeep.n1, name), 1) ThenBlock: { XmmKeep.x1 = xmm ReturnValue(0) }
        IfCondition EqualTo(Optimize_NameEq(XmmKeep.n2, name), 1) ThenBlock: { XmmKeep.x2 = xmm ReturnValue(0) }
        IfCondition EqualTo(Optimize_NameEq(XmmKeep.n3, name), 1) ThenBlock: { XmmKeep.x3 = xmm ReturnValue(0) }
        IfCondition EqualTo(Optimize_NameEq(XmmKeep.n4, name), 1) ThenBlock: { XmmKeep.x4 = xmm ReturnValue(0) }
        IfCondition EqualTo(Optimize_NameEq(XmmKeep.n5, name), 1) ThenBlock: { XmmKeep.x5 = xmm ReturnValue(0) }
        IfCondition EqualTo(XmmKeep.n0, 0) ThenBlock: { XmmKeep.n0 = name XmmKeep.x0 = xmm ReturnValue(0) }
        IfCondition EqualTo(XmmKeep.n1, 0) ThenBlock: { XmmKeep.n1 = name XmmKeep.x1 = xmm ReturnValue(0) }
        IfCondition EqualTo(XmmKeep.n2, 0) ThenBlock: { XmmKeep.n2 = name XmmKeep.x2 = xmm ReturnValue(0) }
        IfCondition EqualTo(XmmKeep.n3, 0) ThenBlock: { XmmKeep.n3 = name XmmKeep.x3 = xmm ReturnValue(0) }
        IfCondition EqualTo(XmmKeep.n4, 0) ThenBlock: { XmmKeep.n4 = name XmmKeep.x4 = xmm ReturnValue(0) }
        IfCondition EqualTo(XmmKeep.n5, 0) ThenBlock: { XmmKeep.n5 = name XmmKeep.x5 = xmm ReturnValue(0) }
        ReturnValue(0)
    }
}

Function.Optimize_XmmDrop {
    Input: name: Address
    Body: {
        IfCondition EqualTo(Optimize_NameEq(XmmKeep.n0, name), 1) ThenBlock: { XmmKeep.n0 = 0 }
        IfCondition EqualTo(Optimize_NameEq(XmmKeep.n1, name), 1) ThenBlock: { XmmKeep.n1 = 0 }
        IfCondition EqualTo(Optimize_NameEq(XmmKeep.n2, name), 1) ThenBlock: { XmmKeep.n2 = 0 }
        IfCondition EqualTo(Optimize_NameEq(XmmKeep.n3, name), 1) ThenBlock: { XmmKeep.n3 = 0 }
        IfCondition EqualTo(Optimize_NameEq(XmmKeep.n4, name), 1) ThenBlock: { XmmKeep.n4 = 0 }
        IfCondition EqualTo(Optimize_NameEq(XmmKeep.n5, name), 1) ThenBlock: { XmmKeep.n5 = 0 }
        ReturnValue(0)
    }
}

Function.Optimize_XmmGet {
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition EqualTo(Optimize_NameEq(XmmKeep.n0, name), 1) ThenBlock: { ReturnValue(XmmKeep.x0) }
        IfCondition EqualTo(Optimize_NameEq(XmmKeep.n1, name), 1) ThenBlock: { ReturnValue(XmmKeep.x1) }
        IfCondition EqualTo(Optimize_NameEq(XmmKeep.n2, name), 1) ThenBlock: { ReturnValue(XmmKeep.x2) }
        IfCondition EqualTo(Optimize_NameEq(XmmKeep.n3, name), 1) ThenBlock: { ReturnValue(XmmKeep.x3) }
        IfCondition EqualTo(Optimize_NameEq(XmmKeep.n4, name), 1) ThenBlock: { ReturnValue(XmmKeep.x4) }
        IfCondition EqualTo(Optimize_NameEq(XmmKeep.n5, name), 1) ThenBlock: { ReturnValue(XmmKeep.x5) }
        ReturnValue(-1)
    }
}

Function.Optimize_ZeroKill {
    Body: {
        ZeroKeep.n0 = 0
        ZeroKeep.n1 = 0
        ZeroKeep.n2 = 0
        ZeroKeep.n3 = 0
        ZeroKeep.n4 = 0
        ZeroKeep.n5 = 0
        ReturnValue(0)
    }
}

Function.Optimize_ZeroHas {
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_NameEq(ZeroKeep.n0, name), 1) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(Optimize_NameEq(ZeroKeep.n1, name), 1) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(Optimize_NameEq(ZeroKeep.n2, name), 1) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(Optimize_NameEq(ZeroKeep.n3, name), 1) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(Optimize_NameEq(ZeroKeep.n4, name), 1) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(Optimize_NameEq(ZeroKeep.n5, name), 1) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

Function.Optimize_ZeroNote {
    Input: name: Address
    Body: {
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_ZeroHas(name), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(ZeroKeep.n0, 0) ThenBlock: { ZeroKeep.n0 = name ReturnValue(0) }
        IfCondition EqualTo(ZeroKeep.n1, 0) ThenBlock: { ZeroKeep.n1 = name ReturnValue(0) }
        IfCondition EqualTo(ZeroKeep.n2, 0) ThenBlock: { ZeroKeep.n2 = name ReturnValue(0) }
        IfCondition EqualTo(ZeroKeep.n3, 0) ThenBlock: { ZeroKeep.n3 = name ReturnValue(0) }
        IfCondition EqualTo(ZeroKeep.n4, 0) ThenBlock: { ZeroKeep.n4 = name ReturnValue(0) }
        IfCondition EqualTo(ZeroKeep.n5, 0) ThenBlock: { ZeroKeep.n5 = name ReturnValue(0) }
        ReturnValue(0)
    }
}

// The last def before the nested while is name = 0, and nothing in
// between reads it. The while prologue pxors that home.
Function.Optimize_ZeroReach {
    Input: name: Address
    Input: at: Integer
    Output: Integer
    Body: {
        block = OutKeep.block
        IfCondition EqualTo(block, 0) ThenBlock: { ReturnValue(0) }
        found = 0
        i = 0
        WhileLoop LessThan(i, at) {
            st = AST_GetChild(block, i)
            mine = 0
            IfCondition EqualTo(Optimize_PlainAssign(st), 1) ThenBlock: {
                IfCondition EqualTo(Optimize_NameEq(AST_GetData1(st), name), 1) ThenBlock: { mine = 1 }
            }
            IfCondition EqualTo(mine, 1) ThenBlock: {
                IfCondition EqualTo(Optimize_IpNum(AST_GetChild(st, 0)), 0) ThenBlock: { ReturnValue(0) }
                IfCondition NotEqual(LoopHome.ip_num, 0) ThenBlock: { ReturnValue(0) }
                found = 1
            } ElseBlock: {
                IfCondition EqualTo(Optimize_NodeReads(st, name), 1) ThenBlock: { ReturnValue(0) }
            }
            i = Add(i, 1)
        }
        ReturnValue(found)
    }
}

Function.Optimize_ZeroArmOne {
    Input: name: Address
    Input: cond: Address
    Input: body: Address
    Input: at: Integer
    Body: {
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_LiveIn(name, cond, body), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_ZeroReach(name, at), 0) ThenBlock: { ReturnValue(0) }
        Optimize_ZeroNote(name)
        ReturnValue(0)
    }
}

Function.Optimize_ZeroSkip {
    Input: name: Address
    Input: value: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(Optimize_ZeroHas(name), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_IpNum(value), 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(LoopHome.ip_num, 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(1)
    }
}

// Straight number assigns, then a while. Homes of that while that arrive
// as +0.0 are pxor'd in the prologue, so the frame store is dropped.
Function.Optimize_OutZeroArm {
    Input: node: Address
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(LoopHome.active, 1) ThenBlock: { ReturnValue(0) }
        count = AST_GetChildCount(node)
        at = -1
        i = 0
        WhileLoop LessThan(i, count) {
            ch = AST_GetChild(node, i)
            stop = 0
            IfCondition NotEqual(ch, 0) ThenBlock: {
                IfCondition EqualTo(AST_GetType(ch), AST.WHILE) ThenBlock: {
                    at = i
                    stop = 1
                } ElseBlock: {
                    ok = 0
                    IfCondition EqualTo(Optimize_PlainAssign(ch), 1) ThenBlock: {
                        val = AST_GetChild(ch, 0)
                        IfCondition NotEqual(val, 0) ThenBlock: {
                            IfCondition EqualTo(AST_GetType(val), AST.NUMBER) ThenBlock: { ok = 1 }
                        }
                    }
                    IfCondition EqualTo(ok, 0) ThenBlock: { ReturnValue(0) }
                }
            }
            IfCondition EqualTo(stop, 1) ThenBlock: { i = count }
            i = Add(i, 1)
        }
        IfCondition LessThan(at, 0) ThenBlock: { ReturnValue(0) }
        w = AST_GetChild(node, at)
        cond = AST_GetChild(w, 0)
        body = AST_GetChild(w, 1)
        got = Optimize_LoopHomes(cond, body)
        IfCondition EqualTo(got, 1) ThenBlock: {
            i = 0
            WhileLoop LessThan(i, AllocTab.n) {
                rec = Optimize_AllocRec(i)
                IfCondition EqualTo(Dereference(Add(rec, 8)), 2) ThenBlock: {
                    reg = Dereference(Add(rec, 16))
                    IfCondition GreaterEqual(reg, 2) ThenBlock: {
                        IfCondition LessEqual(reg, 7) ThenBlock: {
                            IfCondition LessThan(Dereference(Add(rec, 24)), 0) ThenBlock: {
                                Optimize_ZeroArmOne(Dereference(rec), cond, body, at)
                            }
                        }
                    }
                }
                i = Add(i, 1)
            }
        }
        Optimize_OutHoistReset()
        ReturnValue(0)
    }
}

// The address would take the r9 match path. Does not emit and does not
// clear c_on. A mismatch means the temp still has to be materialized.
Function.Optimize_IndexStoreOk {
    Input: addr: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(OutKeep.c_on, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_OutAddr(addr), 0) ThenBlock: { ReturnValue(0) }
        same = 1
        IfCondition EqualTo(Optimize_NameEq(OutKeep.p_base, OutKeep.c_base), 0) ThenBlock: { same = 0 }
        IfCondition NotEqual(OutKeep.p_scale, OutKeep.c_scale) ThenBlock: { same = 0 }
        IfCondition EqualTo(Optimize_NameEq(OutKeep.p_cur, OutKeep.c_cur), 0) ThenBlock: { same = 0 }
        IfCondition NotEqual(OutKeep.p_coeff, OutKeep.c_coeff) ThenBlock: { same = 0 }
        IfCondition EqualTo(same, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_IpDelta(OutKeep.p_inv, OutKeep.c_inv), 0) ThenBlock: { ReturnValue(0) }
        extra = Subtract(OutKeep.p_add, OutKeep.c_add)
        disp = Multiply(Add(LoopHome.ip_delta, extra), OutKeep.c_scale)
        IfCondition EqualTo(Optimize_Fit32(disp), 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(1)
    }
}

Function.Optimize_IndexScan {
    Input: node: Address
    Input: name: Address
    Input: in_addr: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(IndexKeep.bad, 1) ThenBlock: { ReturnValue(0) }
        nt = AST_GetType(node)
        IfCondition EqualTo(nt, AST.CALL) ThenBlock: {
            IfCondition EqualTo(StringCompare(AST_GetData1(node), "StoreValue"), 0) ThenBlock: {
                IfCondition GreaterEqual(AST_GetChildCount(node), 2) ThenBlock: {
                    addr = AST_GetChild(node, 0)
                    IfCondition GreaterThan(Optimize_CountIdents(addr, name), 0) ThenBlock: {
                        IfCondition NotEqual(AST_GetChildCount(node), 2) ThenBlock: { IndexKeep.bad = 1 }
                        IfCondition EqualTo(Optimize_IndexStoreOk(addr), 0) ThenBlock: { IndexKeep.bad = 1 }
                    }
                    Optimize_IndexScan(addr, name, 1)
                    Optimize_IndexScan(AST_GetChild(node, 1), name, 0)
                    ReturnValue(0)
                }
            }
        }
        IfCondition EqualTo(nt, AST.IDENTIFIER) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(AST_GetData1(node), name), 1) ThenBlock: {
                IfCondition EqualTo(in_addr, 0) ThenBlock: { IndexKeep.bad = 1 }
                IndexKeep.uses = Add(IndexKeep.uses, 1)
            }
            ReturnValue(0)
        }
        count = AST_GetChildCount(node)
        i = 0
        WhileLoop LessThan(i, count) {
            Optimize_IndexScan(AST_GetChild(node, i), name, in_addr)
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

// cj / cj1 exist only so a store address can see them. The r9 fold reads
// the AST, so the assignment itself does not need to run.
Function.Optimize_IndexDead {
    Input: name: Address
    Input: value: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(OutKeep.c_on, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_PureExpr(value), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Compile.current_func, 0) ThenBlock: { ReturnValue(0) }
        block = OutKeep.block
        IfCondition EqualTo(block, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(Optimize_CountIdents(Compile.current_func, name), Optimize_CountIdents(block, name)) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(Optimize_AssignCount(Compile.current_func, name), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_LiveEscape(Compile.current_func, name), 1) ThenBlock: { ReturnValue(0) }
        IndexKeep.uses = 0
        IndexKeep.bad = 0
        Optimize_IndexScan(block, name, 0)
        IfCondition EqualTo(IndexKeep.bad, 1) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(IndexKeep.uses, 1) ThenBlock: { ReturnValue(0) }
        ReturnValue(1)
    }
}

// ADD r8, r9, or r10, imm32. Returns 0 when the add is not encoded.
Function.Optimize_OutAdd {
    Input: reg: Integer
    Input: bytes: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(bytes, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_Fit32(bytes), 0) ThenBlock: { ReturnValue(0) }
        modrm = 192
        IfCondition EqualTo(reg, 9) ThenBlock: { modrm = 193 }
        IfCondition EqualTo(reg, 10) ThenBlock: { modrm = 194 }
        Emit_Byte(73)
        small = 0
        IfCondition LessThan(bytes, 128) ThenBlock: { small = 1 }
        IfCondition EqualTo(small, 1) ThenBlock: {
            Emit_Byte(131)
            Emit_Byte(modrm)
            Emit_Byte(BitwiseAnd(bytes, 255))
        } ElseBlock: {
            Emit_Byte(129)
            Emit_Byte(modrm)
            Emit_DWord(bytes)
        }
        ReturnValue(1)
    }
}

Function.Optimize_OutMatch {
    Input: slot: Integer
    Output: Integer
    Body: {
        on = OutKeep.a_on
        inv = OutKeep.a_inv
        base = OutKeep.a_base
        scale = OutKeep.a_scale
        addk = OutKeep.a_add
        via = OutKeep.a_via
        boff = OutKeep.a_boff
        coeff = OutKeep.a_coeff
        ipinv = LoopHome.ip0_inv
        ipbase = LoopHome.ip0_base
        ipscale = LoopHome.ip0_scale
        ipadd = LoopHome.ip0_add
        ipvia = LoopHome.ip0_via
        ipboff = LoopHome.ip0_boff
        ipcoeff = LoopHome.ip0_coeff
        IfCondition EqualTo(slot, 1) ThenBlock: {
            on = OutKeep.b_on
            inv = OutKeep.b_inv
            base = OutKeep.b_base
            scale = OutKeep.b_scale
            addk = OutKeep.b_add
            via = OutKeep.b_via
            boff = OutKeep.b_boff
            coeff = OutKeep.b_coeff
            ipinv = LoopHome.ip1_inv
            ipbase = LoopHome.ip1_base
            ipscale = LoopHome.ip1_scale
            ipadd = LoopHome.ip1_add
            ipvia = LoopHome.ip1_via
            ipboff = LoopHome.ip1_boff
            ipcoeff = LoopHome.ip1_coeff
        }
        IfCondition EqualTo(on, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_NameEq(base, ipbase), 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(scale, ipscale) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(addk, ipadd) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(coeff, ipcoeff) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(inv, ipinv) ThenBlock: { ReturnValue(0) }
        ReturnValue(1)
    }
}

Function.Optimize_OutUse {
    Input: slot: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(Optimize_OutMatch(slot), 0) ThenBlock: { ReturnValue(0) }
        reg = LoopHome.ip0_reg
        IfCondition EqualTo(slot, 1) ThenBlock: { reg = LoopHome.ip1_reg }
        X86_IpCache(slot, reg, 0)
        ok = 0
        IfCondition EqualTo(reg, 11) ThenBlock: { ok = 1 }
        IfCondition EqualTo(reg, 14) ThenBlock: { ok = 1 }
        ReturnValue(ok)
    }
}

Function.Optimize_OutSave {
    Input: slot: Integer
    Body: {
        reg = LoopHome.ip0_reg
        IfCondition EqualTo(slot, 1) ThenBlock: { reg = LoopHome.ip1_reg }
        ok = 0
        IfCondition EqualTo(reg, 11) ThenBlock: { ok = 1 }
        IfCondition EqualTo(reg, 14) ThenBlock: { ok = 1 }
        IfCondition EqualTo(ok, 0) ThenBlock: { ReturnValue(0) }
        X86_IpCache(slot, reg, 1)
        IfCondition EqualTo(slot, 0) ThenBlock: {
            OutKeep.a_on = 1
            OutKeep.a_inv = LoopHome.ip0_inv
            OutKeep.a_base = LoopHome.ip0_base
            OutKeep.a_scale = LoopHome.ip0_scale
            OutKeep.a_add = LoopHome.ip0_add
            OutKeep.a_via = LoopHome.ip0_via
            OutKeep.a_boff = LoopHome.ip0_boff
            OutKeep.a_coeff = LoopHome.ip0_coeff
        } ElseBlock: {
            OutKeep.b_on = 1
            OutKeep.b_inv = LoopHome.ip1_inv
            OutKeep.b_base = LoopHome.ip1_base
            OutKeep.b_scale = LoopHome.ip1_scale
            OutKeep.b_add = LoopHome.ip1_add
            OutKeep.b_via = LoopHome.ip1_via
            OutKeep.b_boff = LoopHome.ip1_boff
            OutKeep.b_coeff = LoopHome.ip1_coeff
        }
        ReturnValue(0)
    }
}

Function.Optimize_OutTouch {
    Input: name: Address
    Input: skip_a: Integer
    Input: skip_b: Integer
    Input: skip_c: Integer
    Body: {
        IfCondition EqualTo(skip_a, 0) ThenBlock: {
            IfCondition EqualTo(OutKeep.a_on, 1) ThenBlock: {
                hit = 0
                IfCondition EqualTo(Optimize_NameEq(OutKeep.a_base, name), 1) ThenBlock: { hit = 1 }
                IfCondition GreaterThan(Optimize_CountIdents(OutKeep.a_inv, name), 0) ThenBlock: { hit = 1 }
                IfCondition EqualTo(hit, 1) ThenBlock: { OutKeep.a_on = 0 }
            }
        }
        IfCondition EqualTo(skip_b, 0) ThenBlock: {
            IfCondition EqualTo(OutKeep.b_on, 1) ThenBlock: {
                hit = 0
                IfCondition EqualTo(Optimize_NameEq(OutKeep.b_base, name), 1) ThenBlock: { hit = 1 }
                IfCondition GreaterThan(Optimize_CountIdents(OutKeep.b_inv, name), 0) ThenBlock: { hit = 1 }
                IfCondition EqualTo(hit, 1) ThenBlock: { OutKeep.b_on = 0 }
            }
        }
        IfCondition EqualTo(skip_c, 0) ThenBlock: {
            IfCondition EqualTo(OutKeep.c_on, 1) ThenBlock: {
                hit = 0
                IfCondition EqualTo(Optimize_NameEq(OutKeep.c_base, name), 1) ThenBlock: { hit = 1 }
                IfCondition EqualTo(Optimize_NameEq(OutKeep.c_cur, name), 1) ThenBlock: { hit = 1 }
                IfCondition GreaterThan(Optimize_CountIdents(OutKeep.c_inv, name), 0) ThenBlock: { hit = 1 }
                IfCondition EqualTo(hit, 1) ThenBlock: { OutKeep.c_on = 0 }
            }
        }
        ReturnValue(0)
    }
}

// name = name + imm keeps a bare-identifier pointer by adding the stride.
Function.Optimize_OutAssign {
    Input: name: Address
    Input: value: Address
    Body: {
        step = 0
        imm = 0
        IfCondition NotEqual(value, 0) ThenBlock: {
            IfCondition EqualTo(AST_GetType(value), AST.CALL) ThenBlock: {
                IfCondition EqualTo(StringCompare(AST_GetData1(value), "Add"), 0) ThenBlock: {
                    IfCondition EqualTo(AST_GetChildCount(value), 2) ThenBlock: {
                        left = AST_GetChild(value, 0)
                        right = AST_GetChild(value, 1)
                        IfCondition EqualTo(Optimize_IpNum(right), 1) ThenBlock: {
                            IfCondition EqualTo(Optimize_IdentEq(left, name), 1) ThenBlock: {
                                imm = LoopHome.ip_num
                                step = 1
                            }
                        }
                        IfCondition EqualTo(step, 0) ThenBlock: {
                            IfCondition EqualTo(Optimize_IpNum(left), 1) ThenBlock: {
                                IfCondition EqualTo(Optimize_IdentEq(right, name), 1) ThenBlock: {
                                    imm = LoopHome.ip_num
                                    step = 1
                                }
                            }
                        }
                    }
                }
            }
        }
        skip_a = 0
        skip_b = 0
        skip_c = 0
        IfCondition EqualTo(step, 1) ThenBlock: {
            IfCondition EqualTo(OutKeep.a_on, 1) ThenBlock: {
                IfCondition NotEqual(OutKeep.a_inv, 0) ThenBlock: {
                    IfCondition EqualTo(AST_GetType(OutKeep.a_inv), AST.IDENTIFIER) ThenBlock: {
                        IfCondition EqualTo(Optimize_NameEq(AST_GetData1(OutKeep.a_inv), name), 1) ThenBlock: {
                            bytes = Multiply(imm, OutKeep.a_scale)
                            got = Optimize_OutAdd(8, bytes)
                            IfCondition EqualTo(got, 0) ThenBlock: { OutKeep.a_on = 0 }
                            skip_a = 1
                        }
                    }
                }
            }
            IfCondition EqualTo(OutKeep.b_on, 1) ThenBlock: {
                IfCondition NotEqual(OutKeep.b_inv, 0) ThenBlock: {
                    IfCondition EqualTo(AST_GetType(OutKeep.b_inv), AST.IDENTIFIER) ThenBlock: {
                        IfCondition EqualTo(Optimize_NameEq(AST_GetData1(OutKeep.b_inv), name), 1) ThenBlock: {
                            bytes = Multiply(imm, OutKeep.b_scale)
                            got = Optimize_OutAdd(10, bytes)
                            IfCondition EqualTo(got, 0) ThenBlock: { OutKeep.b_on = 0 }
                            skip_b = 1
                        }
                    }
                }
            }
            IfCondition EqualTo(OutKeep.c_on, 1) ThenBlock: {
                IfCondition EqualTo(Optimize_NameEq(OutKeep.c_cur, name), 1) ThenBlock: {
                    bytes = Multiply(imm, Multiply(OutKeep.c_coeff, OutKeep.c_scale))
                    got = Optimize_OutAdd(9, bytes)
                    IfCondition EqualTo(got, 0) ThenBlock: { OutKeep.c_on = 0 }
                    skip_c = 1
                }
            }
        }
        Optimize_OutTouch(name, skip_a, skip_b, skip_c)
        ReturnValue(0)
    }
}

Function.Optimize_OutRhs {
    Input: name: Address
    Output: Address
    Body: {
        body = OutKeep.block
        IfCondition EqualTo(body, 0) ThenBlock: { ReturnValue(0) }
        count = AST_GetChildCount(body)
        i = 0
        WhileLoop LessThan(i, count) {
            st = AST_GetChild(body, i)
            IfCondition EqualTo(Optimize_PlainAssign(st), 1) ThenBlock: {
                IfCondition EqualTo(Optimize_NameEq(AST_GetData1(st), name), 1) ThenBlock: {
                    ReturnValue(AST_GetChild(st, 0))
                }
            }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

// Index = cursor * coeff + inv + add. A self-update is the cursor.
// A one-assign temp expands. Anything else is invariant.
Function.Optimize_OutSplit {
    Input: node: Address
    Input: depth: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterThan(depth, 8) ThenBlock: { ReturnValue(0) }
        nt = AST_GetType(node)
        IfCondition EqualTo(nt, AST.IDENTIFIER) ThenBlock: {
            name = AST_GetData1(node)
            ac = Optimize_AssignCount(OutKeep.block, name)
            IfCondition EqualTo(ac, 0) ThenBlock: {
                OutKeep.p_coeff = 0
                OutKeep.p_inv = node
                OutKeep.p_add = 0
                OutKeep.p_cur = 0
                ReturnValue(1)
            }
            IfCondition NotEqual(ac, 1) ThenBlock: { ReturnValue(0) }
            rhs = Optimize_OutRhs(name)
            IfCondition EqualTo(rhs, 0) ThenBlock: { ReturnValue(0) }
            IfCondition GreaterThan(Optimize_CountIdents(rhs, name), 0) ThenBlock: {
                OutKeep.p_coeff = 1
                OutKeep.p_inv = 0
                OutKeep.p_add = 0
                OutKeep.p_cur = name
                ReturnValue(1)
            }
            ReturnValue(Optimize_OutSplit(rhs, Add(depth, 1)))
        }
        IfCondition NotEqual(nt, AST.CALL) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetChildCount(node), 2) ThenBlock: { ReturnValue(0) }
        op = AST_GetData1(node)
        left = AST_GetChild(node, 0)
        right = AST_GetChild(node, 1)
        IfCondition EqualTo(StringCompare(op, "Multiply"), 0) ThenBlock: {
            n = 0
            inner = 0
            took = 0
            IfCondition EqualTo(Optimize_IpNum(right), 1) ThenBlock: {
                n = LoopHome.ip_num
                inner = left
                took = 1
            }
            IfCondition EqualTo(took, 0) ThenBlock: {
                IfCondition EqualTo(Optimize_IpNum(left), 1) ThenBlock: {
                    n = LoopHome.ip_num
                    inner = right
                    took = 1
                }
            }
            IfCondition EqualTo(took, 0) ThenBlock: { ReturnValue(0) }
            IfCondition LessThan(n, 1) ThenBlock: { ReturnValue(0) }
            IfCondition EqualTo(Optimize_OutSplit(inner, Add(depth, 1)), 0) ThenBlock: { ReturnValue(0) }
            IfCondition EqualTo(OutKeep.p_coeff, 0) ThenBlock: {
                OutKeep.p_inv = node
                OutKeep.p_add = 0
                OutKeep.p_cur = 0
                OutKeep.p_coeff = 0
                ReturnValue(1)
            }
            IfCondition NotEqual(OutKeep.p_inv, 0) ThenBlock: { ReturnValue(0) }
            OutKeep.p_coeff = Multiply(OutKeep.p_coeff, n)
            OutKeep.p_add = Multiply(OutKeep.p_add, n)
            ReturnValue(1)
        }
        IfCondition NotEqual(StringCompare(op, "Add"), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_IpNum(right), 1) ThenBlock: {
            n = LoopHome.ip_num
            IfCondition EqualTo(Optimize_OutSplit(left, Add(depth, 1)), 0) ThenBlock: { ReturnValue(0) }
            OutKeep.p_add = Add(OutKeep.p_add, n)
            ReturnValue(1)
        }
        IfCondition EqualTo(Optimize_IpNum(left), 1) ThenBlock: {
            n = LoopHome.ip_num
            IfCondition EqualTo(Optimize_OutSplit(right, Add(depth, 1)), 0) ThenBlock: { ReturnValue(0) }
            OutKeep.p_add = Add(OutKeep.p_add, n)
            ReturnValue(1)
        }
        IfCondition EqualTo(Optimize_OutSplit(right, Add(depth, 1)), 0) ThenBlock: { ReturnValue(0) }
        rc = OutKeep.p_coeff
        rinv = OutKeep.p_inv
        radd = OutKeep.p_add
        rcur = OutKeep.p_cur
        IfCondition EqualTo(Optimize_OutSplit(left, Add(depth, 1)), 0) ThenBlock: { ReturnValue(0) }
        lc = OutKeep.p_coeff
        linv = OutKeep.p_inv
        ladd = OutKeep.p_add
        lcur = OutKeep.p_cur
        IfCondition GreaterThan(lc, 0) ThenBlock: {
            IfCondition GreaterThan(rc, 0) ThenBlock: { ReturnValue(0) }
            OutKeep.p_coeff = lc
            OutKeep.p_cur = lcur
            OutKeep.p_add = Add(ladd, radd)
            OutKeep.p_inv = rinv
            ReturnValue(1)
        }
        IfCondition GreaterThan(rc, 0) ThenBlock: {
            OutKeep.p_coeff = rc
            OutKeep.p_cur = rcur
            OutKeep.p_add = Add(ladd, radd)
            OutKeep.p_inv = linv
            ReturnValue(1)
        }
        OutKeep.p_coeff = 0
        OutKeep.p_cur = 0
        OutKeep.p_add = 0
        OutKeep.p_inv = node
        ReturnValue(1)
    }
}

Function.Optimize_OutAddrSides {
    Input: base: Address
    Input: idx: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(base, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(base), AST.IDENTIFIER) ThenBlock: { ReturnValue(0) }
        bname = AST_GetData1(base)
        IfCondition NotEqual(Optimize_AssignCount(OutKeep.block, bname), 0) ThenBlock: { ReturnValue(0) }
        scale = 1
        index = idx
        IfCondition NotEqual(idx, 0) ThenBlock: {
            IfCondition EqualTo(AST_GetType(idx), AST.CALL) ThenBlock: {
                IfCondition EqualTo(StringCompare(AST_GetData1(idx), "Multiply"), 0) ThenBlock: {
                    IfCondition EqualTo(AST_GetChildCount(idx), 2) ThenBlock: {
                        left = AST_GetChild(idx, 0)
                        right = AST_GetChild(idx, 1)
                        took = 0
                        IfCondition EqualTo(Optimize_IpNum(right), 1) ThenBlock: {
                            IfCondition EqualTo(Optimize_IpScaleOk(LoopHome.ip_num), 1) ThenBlock: {
                                scale = LoopHome.ip_num
                                index = left
                                took = 1
                            }
                        }
                        IfCondition EqualTo(took, 0) ThenBlock: {
                            IfCondition EqualTo(Optimize_IpNum(left), 1) ThenBlock: {
                                IfCondition EqualTo(Optimize_IpScaleOk(LoopHome.ip_num), 1) ThenBlock: {
                                    scale = LoopHome.ip_num
                                    index = right
                                    took = 1
                                }
                            }
                        }
                        IfCondition EqualTo(took, 0) ThenBlock: { ReturnValue(0) }
                    }
                }
            }
        }
        IfCondition EqualTo(Optimize_OutSplit(index, 0), 0) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(OutKeep.p_coeff, 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(OutKeep.p_cur, 0) ThenBlock: { ReturnValue(0) }
        OutKeep.p_base = bname
        OutKeep.p_scale = scale
        ReturnValue(1)
    }
}

Function.Optimize_OutAddr {
    Input: addr: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(addr, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(OutKeep.block, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(addr), AST.CALL) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(StringCompare(AST_GetData1(addr), "Add"), 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetChildCount(addr), 2) ThenBlock: { ReturnValue(0) }
        left = AST_GetChild(addr, 0)
        right = AST_GetChild(addr, 1)
        IfCondition EqualTo(Optimize_OutAddrSides(left, right), 1) ThenBlock: { ReturnValue(1) }
        ReturnValue(Optimize_OutAddrSides(right, left))
    }
}

// Store a float home through r9 when the address is affine in an outer cursor.
Function.Optimize_OutStore {
    Input: addr: Address
    Input: val: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(val, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(val), AST.IDENTIFIER) ThenBlock: { ReturnValue(0) }
        xmm = Optimize_XmmGet(AST_GetData1(val))
        IfCondition LessThan(xmm, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_OutAddr(addr), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(OutKeep.c_on, 1) ThenBlock: {
            same = 1
            IfCondition EqualTo(Optimize_NameEq(OutKeep.p_base, OutKeep.c_base), 0) ThenBlock: { same = 0 }
            IfCondition NotEqual(OutKeep.p_scale, OutKeep.c_scale) ThenBlock: { same = 0 }
            IfCondition EqualTo(Optimize_NameEq(OutKeep.p_cur, OutKeep.c_cur), 0) ThenBlock: { same = 0 }
            IfCondition NotEqual(OutKeep.p_coeff, OutKeep.c_coeff) ThenBlock: { same = 0 }
            IfCondition EqualTo(same, 1) ThenBlock: {
                IfCondition EqualTo(Optimize_IpDelta(OutKeep.p_inv, OutKeep.c_inv), 1) ThenBlock: {
                    extra = Subtract(OutKeep.p_add, OutKeep.c_add)
                    disp = Multiply(Add(LoopHome.ip_delta, extra), OutKeep.c_scale)
                    IfCondition EqualTo(Optimize_Fit32(disp), 1) ThenBlock: {
                        X86_MovsdR9(xmm, disp)
                        ReturnValue(1)
                    }
                }
            }
            OutKeep.c_on = 0
            ReturnValue(0)
        }
        got = Compile_Expression(addr)
        IfCondition EqualTo(got, 0) ThenBlock: {
            Compile.error = 1
            ReturnValue(1)
        }
        xmm = Optimize_XmmGet(AST_GetData1(val))
        IfCondition LessThan(xmm, 0) ThenBlock: { ReturnValue(0) }
        X86_MovR9Rax()
        X86_MovsdR9(xmm, 0)
        OutKeep.c_on = 1
        OutKeep.c_base = OutKeep.p_base
        OutKeep.c_inv = OutKeep.p_inv
        OutKeep.c_scale = OutKeep.p_scale
        OutKeep.c_cur = OutKeep.p_cur
        OutKeep.c_add = OutKeep.p_add
        OutKeep.c_coeff = OutKeep.p_coeff
        ReturnValue(1)
    }
}

// A name assigned in this body gets its frame slot before the hoist reads it.
// A nested loop still owns its own temps. Registering them here makes an
// address temporary look like a frame integer, so it steals r13 from the
// cursor and the pointer homes never arm.
Function.Optimize_OutEnsure {
    Input: node: Address
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_HomeBlockNode(AST_GetType(node)), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(AST_GetType(node), AST.ASSIGNMENT) ThenBlock: {
            name = AST_GetData1(node)
            IfCondition NotEqual(name, 0) ThenBlock: {
                Scope_Resolve(name)
                IfCondition EqualTo(Scope.resolve_type, 0) ThenBlock: {
                    Compile.stack_offset = Add(Compile.stack_offset, 8)
                    off = Subtract(0, Compile.stack_offset)
                    Compile_RegisterLocal(name, off)
                }
            }
        }
        count = AST_GetChildCount(node)
        i = 0
        WhileLoop LessThan(i, count) {
            Optimize_OutEnsure(AST_GetChild(node, i))
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

Function.Optimize_OutNested {
    Input: node: Address
    Output: Address
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        count = AST_GetChildCount(node)
        i = 0
        WhileLoop LessThan(i, count) {
            ch = AST_GetChild(node, i)
            IfCondition NotEqual(ch, 0) ThenBlock: {
                nt = AST_GetType(ch)
                IfCondition EqualTo(nt, AST.WHILE) ThenBlock: { ReturnValue(ch) }
                nest = 0
                IfCondition EqualTo(nt, AST.BLOCK) ThenBlock: { nest = 1 }
                IfCondition EqualTo(nt, AST.BODY) ThenBlock: { nest = 1 }
                IfCondition EqualTo(nest, 1) ThenBlock: {
                    c2 = AST_GetChildCount(ch)
                    j = 0
                    WhileLoop LessThan(j, c2) {
                        gch = AST_GetChild(ch, j)
                        IfCondition NotEqual(gch, 0) ThenBlock: {
                            IfCondition EqualTo(AST_GetType(gch), AST.WHILE) ThenBlock: { ReturnValue(gch) }
                        }
                        j = Add(j, 1)
                    }
                }
            }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

// (inv + add + cur*coeff) * scale + base, into r9.
Function.Optimize_OutEmitAffine {
    Output: Integer
    Body: {
        has = 0
        IfCondition NotEqual(OutKeep.p_inv, 0) ThenBlock: {
            got = Compile_Expression(OutKeep.p_inv)
            IfCondition EqualTo(got, 0) ThenBlock: {
                Compile.error = 1
                ReturnValue(0)
            }
            has = 1
        }
        IfCondition NotEqual(OutKeep.p_add, 0) ThenBlock: {
            IfCondition EqualTo(Optimize_Fit32(OutKeep.p_add), 0) ThenBlock: { ReturnValue(0) }
            IfCondition EqualTo(has, 0) ThenBlock: {
                Emit_MovRaxImm64(OutKeep.p_add)
                has = 1
            } ElseBlock: {
                Emit_AddRaxImm32(OutKeep.p_add)
            }
        }
        IfCondition NotEqual(OutKeep.p_cur, 0) ThenBlock: {
            IfCondition EqualTo(has, 1) ThenBlock: { Emit_PushRax() }
            IfCondition EqualTo(Optimize_FrameOff(OutKeep.p_cur), 0) ThenBlock: {
                IfCondition EqualTo(has, 1) ThenBlock: { Emit_PopRax() }
                ReturnValue(0)
            }
            Emit_MovRaxRbpOffset(LoopHome.imm_val)
            IfCondition GreaterThan(OutKeep.p_coeff, 1) ThenBlock: {
                IfCondition EqualTo(Optimize_IpLog(OutKeep.p_coeff), 1) ThenBlock: {
                    IfCondition GreaterThan(LoopHome.ip_log, 0) ThenBlock: { Emit_ShlRaxImm8(LoopHome.ip_log) }
                } ElseBlock: {
                    Emit_MovRbxImm64(OutKeep.p_coeff)
                    X86Enc_Assemble("IMUL rax, rbx")
                }
            }
            IfCondition EqualTo(has, 1) ThenBlock: {
                Emit_PopRbx()
                Emit_AddRaxRbx()
            }
            has = 1
        }
        IfCondition GreaterThan(OutKeep.p_scale, 1) ThenBlock: {
            IfCondition EqualTo(has, 0) ThenBlock: { ReturnValue(0) }
            IfCondition EqualTo(Optimize_IpLog(OutKeep.p_scale), 1) ThenBlock: {
                IfCondition GreaterThan(LoopHome.ip_log, 0) ThenBlock: { Emit_ShlRaxImm8(LoopHome.ip_log) }
            } ElseBlock: {
                ReturnValue(0)
            }
        }
        IfCondition EqualTo(Optimize_FrameOff(OutKeep.p_base), 0) ThenBlock: { ReturnValue(0) }
        boff = LoopHome.imm_val
        IfCondition EqualTo(has, 0) ThenBlock: {
            Emit_MovRaxRbpOffset(boff)
        } ElseBlock: {
            Emit_PushRax()
            Emit_MovRaxRbpOffset(boff)
            Emit_MovRbxRax()
            Emit_PopRax()
            Emit_AddRaxRbx()
        }
        X86_MovR9Rax()
        ReturnValue(1)
    }
}

Function.Optimize_OutArmStores {
    Input: body: Address
    Body: {
        IfCondition EqualTo(body, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(OutKeep.c_on, 1) ThenBlock: { ReturnValue(0) }
        saved = OutKeep.block
        OutKeep.block = body
        count = AST_GetChildCount(body)
        i = 0
        WhileLoop LessThan(i, count) {
            st = AST_GetChild(body, i)
            IfCondition NotEqual(st, 0) ThenBlock: {
                IfCondition EqualTo(AST_GetType(st), AST.CALL) ThenBlock: {
                    IfCondition EqualTo(StringCompare(AST_GetData1(st), "StoreValue"), 0) ThenBlock: {
                        IfCondition GreaterEqual(AST_GetChildCount(st), 2) ThenBlock: {
                            IfCondition EqualTo(Optimize_OutAddr(AST_GetChild(st, 0)), 1) ThenBlock: {
                                IfCondition EqualTo(Optimize_OutEmitAffine(), 1) ThenBlock: {
                                    OutKeep.c_on = 1
                                    OutKeep.c_base = OutKeep.p_base
                                    OutKeep.c_inv = OutKeep.p_inv
                                    OutKeep.c_scale = OutKeep.p_scale
                                    OutKeep.c_cur = OutKeep.p_cur
                                    OutKeep.c_add = OutKeep.p_add
                                    OutKeep.c_coeff = OutKeep.p_coeff
                                    i = count
                                }
                            }
                        }
                    }
                }
            }
            i = Add(i, 1)
        }
        OutKeep.block = saved
        ReturnValue(0)
    }
}

Function.Optimize_OutHoistReset {
    Body: {
        LoopHome.active = 0
        LoopHome.int_name = 0
        LoopHome.flt_name = 0
        LoopHome.acc_name = 0
        LoopHome.f2_name = 0
        LoopHome.f3_name = 0
        LoopHome.f4_name = 0
        LoopHome.f5_name = 0
        LoopHome.f6_name = 0
        LoopHome.body = 0
        LoopHome.cond = 0
        LoopHome.iv_nn = 0
        LoopHome.iv_lo = 0
        LoopHome.trip_on = 0
        LoopHome.trip_reg = 0
        LoopHome.trip_span = 0
        LoopHome.trip_exit = 0
        Optimize_IpClear()
        Optimize_AllocReset()
        ReturnValue(0)
    }
}

// Once per entry, before the back edge: the inner k=0 pointers and the
// store base. Later iterations only copy those registers.
Function.Optimize_OutHoist {
    Input: body: Address
    Body: {
        IfCondition EqualTo(body, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(LoopHome.active, 1) ThenBlock: { ReturnValue(0) }
        inner = Optimize_OutNested(body)
        IfCondition EqualTo(inner, 0) ThenBlock: { ReturnValue(0) }
        Optimize_OutEnsure(body)
        icond = AST_GetChild(inner, 0)
        ibody = AST_GetChild(inner, 1)
        got = Optimize_LoopHomes(icond, ibody)
        IfCondition EqualTo(got, 1) ThenBlock: {
            IfCondition EqualTo(LoopHome.iv_nn, 1) ThenBlock: {
                IfCondition EqualTo(LoopHome.iv_lo, 0) ThenBlock: {
                    need = 0
                    IfCondition EqualTo(LoopHome.ip0_on, 1) ThenBlock: {
                        IfCondition EqualTo(LoopHome.ip0_via, 2) ThenBlock: { need = 1 }
                    }
                    IfCondition EqualTo(LoopHome.ip1_on, 1) ThenBlock: {
                        IfCondition EqualTo(LoopHome.ip1_via, 2) ThenBlock: { need = 1 }
                    }
                    IfCondition EqualTo(need, 1) ThenBlock: {
                        IfCondition NotEqual(LoopHome.acc_name, 0) ThenBlock: {
                            Emit_MovRaxRbpOffset(LoopHome.acc_off)
                            Emit_HomeMove(17, 0)
                        }
                    }
                    IfCondition EqualTo(LoopHome.ip0_on, 1) ThenBlock: { Optimize_EmitIpOne(0) }
                    IfCondition EqualTo(LoopHome.ip1_on, 1) ThenBlock: { Optimize_EmitIpOne(1) }
                }
            }
            have = Optimize_AllocNamed()
            IfCondition EqualTo(have, 1) ThenBlock: { Optimize_OutArmStores(body) }
        }
        Optimize_OutHoistReset()
        ReturnValue(0)
    }
}
