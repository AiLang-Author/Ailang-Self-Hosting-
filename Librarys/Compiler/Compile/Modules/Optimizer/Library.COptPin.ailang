// Library.COptPin.ailang
// XMM pin and deferred multiply then add.
// Loaded by the optimizer shell. No imports of its own.

// Four records, stride 32: reg, disp, xmm, uses left. Allocate once.
// uses left is -1 until the first multiply counts Float_Mul reads.
Function.Optimize_PinEnsure {
    Body: {
        IfCondition EqualTo(LoopHome.pin_recs, 0) ThenBlock: {
            LoopHome.pin_recs = Allocate(128)
        }
        ReturnValue(0)
    }
}

// xmm0, xmm1, and xmm15 stay scratch. A live home stays a home.
Function.Optimize_PinTaken {
    Input: xmm: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(xmm, 2) ThenBlock: { ReturnValue(1) }
        IfCondition GreaterThan(xmm, 14) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(xmm, 2) ThenBlock: {
            IfCondition NotEqual(LoopHome.flt_name, 0) ThenBlock: { ReturnValue(1) }
        }
        IfCondition EqualTo(xmm, 3) ThenBlock: {
            IfCondition NotEqual(LoopHome.f2_name, 0) ThenBlock: { ReturnValue(1) }
        }
        IfCondition EqualTo(xmm, 4) ThenBlock: {
            IfCondition NotEqual(LoopHome.f3_name, 0) ThenBlock: { ReturnValue(1) }
        }
        IfCondition EqualTo(xmm, 5) ThenBlock: {
            IfCondition NotEqual(LoopHome.f4_name, 0) ThenBlock: { ReturnValue(1) }
        }
        IfCondition EqualTo(xmm, 6) ThenBlock: {
            IfCondition NotEqual(LoopHome.f5_name, 0) ThenBlock: { ReturnValue(1) }
        }
        IfCondition EqualTo(xmm, 7) ThenBlock: {
            IfCondition NotEqual(LoopHome.f6_name, 0) ThenBlock: { ReturnValue(1) }
        }
        IfCondition GreaterEqual(xmm, 8) ThenBlock: {
            IfCondition LessThan(Subtract(xmm, 8), LoopHome.xf_n) ThenBlock: { ReturnValue(1) }
        }
        IfCondition EqualTo(LoopHome.pin_recs, 0) ThenBlock: { ReturnValue(0) }
        i = 0
        WhileLoop LessThan(i, LoopHome.pin_n) {
            rec = Add(LoopHome.pin_recs, Multiply(i, 32))
            IfCondition EqualTo(Dereference(Add(rec, 16)), xmm) ThenBlock: { ReturnValue(1) }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

// Prefer xmm8–xmm14. xmm7 then xmm6 only when the extra homes are full.
Function.Optimize_PinFree {
    Output: Integer
    Body: {
        IfCondition EqualTo(Optimize_PinTaken(8), 0) ThenBlock: { ReturnValue(8) }
        IfCondition EqualTo(Optimize_PinTaken(9), 0) ThenBlock: { ReturnValue(9) }
        IfCondition EqualTo(Optimize_PinTaken(10), 0) ThenBlock: { ReturnValue(10) }
        IfCondition EqualTo(Optimize_PinTaken(11), 0) ThenBlock: { ReturnValue(11) }
        IfCondition EqualTo(Optimize_PinTaken(12), 0) ThenBlock: { ReturnValue(12) }
        IfCondition EqualTo(Optimize_PinTaken(13), 0) ThenBlock: { ReturnValue(13) }
        IfCondition EqualTo(Optimize_PinTaken(14), 0) ThenBlock: { ReturnValue(14) }
        IfCondition EqualTo(Optimize_PinTaken(7), 0) ThenBlock: { ReturnValue(7) }
        IfCondition EqualTo(Optimize_PinTaken(6), 0) ThenBlock: { ReturnValue(6) }
        ReturnValue(0)
    }
}

Function.Optimize_PinFind {
    Input: reg: Integer
    Input: disp: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(LoopHome.pin_recs, 0) ThenBlock: { ReturnValue(0) }
        i = 0
        WhileLoop LessThan(i, LoopHome.pin_n) {
            rec = Add(LoopHome.pin_recs, Multiply(i, 32))
            IfCondition EqualTo(Dereference(rec), reg) ThenBlock: {
                IfCondition EqualTo(Dereference(Add(rec, 8)), disp) ThenBlock: {
                    LoopHome.pin_hit = Dereference(Add(rec, 16))
                    ReturnValue(1)
                }
            }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

// Copy a multi-use induction load into xmm0 or xmm1. The first use in
// the trip loads it into a free xmm. A later use copies that xmm.
// Returns 0 before any instruction when the load stays a movsd.
Function.Optimize_PinLoad {
    Input: dst: Integer
    Input: node: Address
    Input: reg: Integer
    Input: disp: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(LoopHome.active, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(node), AST.IDENTIFIER) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(LoopHome.body, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(LoopHome.has_call, 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_TreeHasAsm(LoopHome.body), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_TreeHasStore(LoopHome.body), 1) ThenBlock: { ReturnValue(0) }
        name = AST_GetData1(node)
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(Optimize_Mentions(LoopHome.body, name), 3) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_PinFind(reg, disp), 1) ThenBlock: {
            X86_XmmBin(16, dst, LoopHome.pin_hit)
            ReturnValue(1)
        }
        IfCondition GreaterEqual(LoopHome.pin_n, 4) ThenBlock: { ReturnValue(0) }
        xmm = Optimize_PinFree()
        IfCondition EqualTo(xmm, 0) ThenBlock: { ReturnValue(0) }
        Optimize_PinEnsure()
        IfCondition EqualTo(LoopHome.pin_recs, 0) ThenBlock: { ReturnValue(0) }
        X86_MovsdPtr(xmm, reg, disp)
        X86_XmmBin(16, dst, xmm)
        rec = Add(LoopHome.pin_recs, Multiply(LoopHome.pin_n, 32))
        StoreValue(rec, reg)
        StoreValue(Add(rec, 8), disp)
        StoreValue(Add(rec, 16), xmm)
        StoreValue(Add(rec, 24), -1)
        LoopHome.pin_n = Add(LoopHome.pin_n, 1)
        LoopHome.pin_hit = xmm
        ReturnValue(1)
    }
}

// 1 when this induction load is already pinned or the name is used at
// least three times in the loop body (the store plus two reads).
Function.Optimize_PinWorth {
    Input: node: Address
    Input: reg: Integer
    Input: disp: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(Optimize_PinFind(reg, disp), 1) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(node), AST.IDENTIFIER) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(LoopHome.body, 0) ThenBlock: { ReturnValue(0) }
        name = AST_GetData1(node)
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(Optimize_Mentions(LoopHome.body, name), 3) ThenBlock: { ReturnValue(0) }
        ReturnValue(1)
    }
}

// 1 when both addresses can be kept without dropping an older pin.
Function.Optimize_PinRoom {
    Input: reg_a: Integer
    Input: disp_a: Integer
    Input: reg_b: Integer
    Input: disp_b: Integer
    Output: Integer
    Body: {
        need = 0
        IfCondition EqualTo(Optimize_PinFind(reg_a, disp_a), 0) ThenBlock: { need = 1 }
        IfCondition EqualTo(Optimize_PinFind(reg_b, disp_b), 0) ThenBlock: { need = Add(need, 1) }
        IfCondition EqualTo(need, 0) ThenBlock: { ReturnValue(1) }
        IfCondition GreaterThan(Add(LoopHome.pin_n, need), 4) ThenBlock: { ReturnValue(0) }
        free = 0
        xmm = 6
        WhileLoop LessEqual(xmm, 14) {
            IfCondition EqualTo(Optimize_PinTaken(xmm), 0) ThenBlock: { free = Add(free, 1) }
            xmm = Add(xmm, 1)
        }
        IfCondition LessThan(free, need) ThenBlock: { ReturnValue(0) }
        ReturnValue(1)
    }
}

// Load reg+disp once into a pin xmm. A later call with the same address
// returns that xmm and does not reload. The pin is not a multiply dest.
Function.Optimize_PinKeep {
    Input: reg: Integer
    Input: disp: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(Optimize_PinFind(reg, disp), 1) ThenBlock: { ReturnValue(LoopHome.pin_hit) }
        xmm = Optimize_PinFree()
        IfCondition EqualTo(xmm, 0) ThenBlock: { ReturnValue(0) }
        Optimize_PinEnsure()
        IfCondition EqualTo(LoopHome.pin_recs, 0) ThenBlock: { ReturnValue(0) }
        X86_MovsdPtr(xmm, reg, disp)
        rec = Add(LoopHome.pin_recs, Multiply(LoopHome.pin_n, 32))
        StoreValue(rec, reg)
        StoreValue(Add(rec, 8), disp)
        StoreValue(Add(rec, 16), xmm)
        StoreValue(Add(rec, 24), -1)
        LoopHome.pin_n = Add(LoopHome.pin_n, 1)
        LoopHome.pin_hit = xmm
        ReturnValue(xmm)
    }
}

// pass 0 is the multiply. pass 1 is the add or sub into the home.
Function.Optimize_PinEmit {
    Input: i: Integer
    Input: pass: Integer
    Body: {
        k = PinDefer.k0
        a = PinDefer.a0
        b = PinDefer.b0
        c = PinDefer.c0
        s = PinDefer.s0
        IfCondition EqualTo(i, 1) ThenBlock: {
            k = PinDefer.k1
            a = PinDefer.a1
            b = PinDefer.b1
            c = PinDefer.c1
            s = PinDefer.s1
        }
        IfCondition EqualTo(i, 2) ThenBlock: {
            k = PinDefer.k2
            a = PinDefer.a2
            b = PinDefer.b2
            c = PinDefer.c2
            s = PinDefer.s2
        }
        IfCondition EqualTo(i, 3) ThenBlock: {
            k = PinDefer.k3
            a = PinDefer.a3
            b = PinDefer.b3
            c = PinDefer.c3
            s = PinDefer.s3
        }
        kind = k
        is_sub = 0
        IfCondition GreaterEqual(k, 2) ThenBlock: {
            is_sub = 1
            kind = Subtract(k, 2)
        }
        IfCondition EqualTo(pass, 0) ThenBlock: {
            IfCondition EqualTo(kind, 1) ThenBlock: {
                X86_Movapd(a, b)
                X86_XmmBin(89, a, c)
            } ElseBlock: {
                X86_XmmBin(89, a, b)
            }
        } ElseBlock: {
            op = 88
            IfCondition EqualTo(is_sub, 1) ThenBlock: { op = 92 }
            X86_XmmBin(op, s, a)
        }
        ReturnValue(0)
    }
}

Function.Optimize_PinFlush {
    Body: {
        n = PinDefer.n
        IfCondition EqualTo(n, 0) ThenBlock: { ReturnValue(0) }
        i = 0
        WhileLoop LessThan(i, n) {
            Optimize_PinEmit(i, 0)
            i = Add(i, 1)
        }
        i = 0
        WhileLoop LessThan(i, n) {
            Optimize_PinEmit(i, 1)
            i = Add(i, 1)
        }
        PinDefer.n = 0
        ReturnValue(0)
    }
}

// kind 0: mulsd a, b. kind 1: movapd a, b; mulsd a, c.
// is_sub is packed as +2. The home add waits until PinFlush.
Function.Optimize_PinPush {
    Input: k: Integer
    Input: a: Integer
    Input: b: Integer
    Input: c: Integer
    Input: s: Integer
    Body: {
        IfCondition GreaterEqual(PinDefer.n, 4) ThenBlock: { Optimize_PinFlush() }
        i = PinDefer.n
        IfCondition EqualTo(i, 0) ThenBlock: {
            PinDefer.k0 = k
            PinDefer.a0 = a
            PinDefer.b0 = b
            PinDefer.c0 = c
            PinDefer.s0 = s
        }
        IfCondition EqualTo(i, 1) ThenBlock: {
            PinDefer.k1 = k
            PinDefer.a1 = a
            PinDefer.b1 = b
            PinDefer.c1 = c
            PinDefer.s1 = s
        }
        IfCondition EqualTo(i, 2) ThenBlock: {
            PinDefer.k2 = k
            PinDefer.a2 = a
            PinDefer.b2 = b
            PinDefer.c2 = c
            PinDefer.s2 = s
        }
        IfCondition EqualTo(i, 3) ThenBlock: {
            PinDefer.k3 = k
            PinDefer.a3 = a
            PinDefer.b3 = b
            PinDefer.c3 = c
            PinDefer.s3 = s
        }
        PinDefer.n = Add(i, 1)
        ReturnValue(0)
    }
}

// home = home ± a*b when a and b are both multi-use pointer loads.
// Load each once. The last use of a factor is a destructive mulsd.
// A product that still needs both factors copies one. SSE2, two roundings.
// Returns 0 before any instruction when the old memory mulsd stays.
Function.Optimize_PinReuse {
    Input: slot: Integer
    Input: arg_a: Address
    Input: arg_b: Address
    Input: is_sub: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(Optimize_IpMatch(arg_a), 0) ThenBlock: { ReturnValue(0) }
        reg_a = LoopHome.ip_hit_reg
        disp_a = LoopHome.ip_hit_disp
        IfCondition EqualTo(Optimize_IpMatch(arg_b), 0) ThenBlock: { ReturnValue(0) }
        reg_b = LoopHome.ip_hit_reg
        disp_b = LoopHome.ip_hit_disp
        IfCondition EqualTo(Optimize_PinWorth(arg_a, reg_a, disp_a), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_PinWorth(arg_b, reg_b, disp_b), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_PinRoom(reg_a, disp_a, reg_b, disp_b), 0) ThenBlock: { ReturnValue(0) }
        Optimize_FlushHold()
        pa = Optimize_PinKeep(reg_a, disp_a)
        pb = Optimize_PinKeep(reg_b, disp_b)
        IfCondition EqualTo(pa, 0) ThenBlock: {
            Compile.error = 1
            ReturnValue(1)
        }
        IfCondition EqualTo(pb, 0) ThenBlock: {
            Compile.error = 1
            ReturnValue(1)
        }
        la = Optimize_PinLeft(reg_a, disp_a, arg_a)
        lb = Optimize_PinLeft(reg_b, disp_b, arg_b)
        Optimize_PinSpend(reg_a, disp_a)
        Optimize_PinSpend(reg_b, disp_b)
        die_a = 0
        die_b = 0
        IfCondition EqualTo(la, 1) ThenBlock: { die_a = 1 }
        IfCondition EqualTo(lb, 1) ThenBlock: { die_b = 1 }
        pk = 0
        IfCondition EqualTo(is_sub, 1) ThenBlock: { pk = 2 }
        IfCondition EqualTo(die_a, 1) ThenBlock: {
            Optimize_PinPush(pk, pa, pb, 0, slot)
            Optimize_PinKill(reg_a, disp_a)
            IfCondition EqualTo(die_b, 1) ThenBlock: { Optimize_PinKill(reg_b, disp_b) }
            ReturnValue(1)
        }
        IfCondition EqualTo(die_b, 1) ThenBlock: {
            Optimize_PinPush(pk, pb, pa, 0, slot)
            Optimize_PinKill(reg_b, disp_b)
            ReturnValue(1)
        }
        sc = Optimize_SseScratch(slot)
        Optimize_PinPush(Add(pk, 1), sc, pa, pb, slot)
        ReturnValue(1)
    }
}

// Record address for this pin, or 0.
Function.Optimize_PinRec {
    Input: reg: Integer
    Input: disp: Integer
    Output: Address
    Body: {
        IfCondition EqualTo(LoopHome.pin_recs, 0) ThenBlock: { ReturnValue(0) }
        i = 0
        WhileLoop LessThan(i, LoopHome.pin_n) {
            rec = Add(LoopHome.pin_recs, Multiply(i, 32))
            IfCondition EqualTo(Dereference(rec), reg) ThenBlock: {
                IfCondition EqualTo(Dereference(Add(rec, 8)), disp) ThenBlock: { ReturnValue(rec) }
            }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

// Float_Mul reads of this name under node. The assignment is not a read.
Function.Optimize_MulUses {
    Input: node: Address
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }
        n = 0
        IfCondition EqualTo(AST_GetType(node), AST.CALL) ThenBlock: {
            IfCondition EqualTo(StringCompare(AST_GetData1(node), "Float_Mul"), 0) ThenBlock: {
                count = AST_GetChildCount(node)
                i = 0
                WhileLoop LessThan(i, count) {
                    ch = AST_GetChild(node, i)
                    hit = 0
                    IfCondition NotEqual(ch, 0) ThenBlock: {
                        IfCondition EqualTo(AST_GetType(ch), AST.IDENTIFIER) ThenBlock: {
                            IfCondition EqualTo(Optimize_NameEq(AST_GetData1(ch), name), 1) ThenBlock: {
                                n = Add(n, 1)
                                hit = 1
                            }
                        }
                    }
                    IfCondition EqualTo(hit, 0) ThenBlock: {
                        n = Add(n, Optimize_MulUses(ch, name))
                    }
                    i = Add(i, 1)
                }
                ReturnValue(n)
            }
        }
        count = AST_GetChildCount(node)
        i = 0
        WhileLoop LessThan(i, count) {
            n = Add(n, Optimize_MulUses(AST_GetChild(node, i), name))
            i = Add(i, 1)
        }
        ReturnValue(n)
    }
}

// Remaining mul uses, including the one about to be emitted. -1 means unset.
Function.Optimize_PinLeft {
    Input: reg: Integer
    Input: disp: Integer
    Input: node: Address
    Output: Integer
    Body: {
        rec = Optimize_PinRec(reg, disp)
        IfCondition EqualTo(rec, 0) ThenBlock: { ReturnValue(0) }
        left = Dereference(Add(rec, 24))
        IfCondition LessThan(left, 0) ThenBlock: {
            nm = 0
            IfCondition NotEqual(node, 0) ThenBlock: {
                IfCondition EqualTo(AST_GetType(node), AST.IDENTIFIER) ThenBlock: {
                    nm = AST_GetData1(node)
                }
            }
            left = Optimize_MulUses(LoopHome.body, nm)
            StoreValue(Add(rec, 24), left)
        }
        ReturnValue(left)
    }
}

Function.Optimize_PinSpend {
    Input: reg: Integer
    Input: disp: Integer
    Body: {
        rec = Optimize_PinRec(reg, disp)
        IfCondition EqualTo(rec, 0) ThenBlock: { ReturnValue(0) }
        left = Dereference(Add(rec, 24))
        IfCondition GreaterThan(left, 0) ThenBlock: {
            StoreValue(Add(rec, 24), Subtract(left, 1))
        }
        ReturnValue(0)
    }
}

// The factor register now holds the product. Later reads must miss.
Function.Optimize_PinKill {
    Input: reg: Integer
    Input: disp: Integer
    Body: {
        rec = Optimize_PinRec(reg, disp)
        IfCondition NotEqual(rec, 0) ThenBlock: { StoreValue(rec, -1) }
        ReturnValue(0)
    }
}

// Load every multi-use induction once at the top of the trip.
Function.Optimize_PinWarmOne {
    Input: on: Integer
    Input: name: Address
    Input: reg: Integer
    Input: disp: Integer
    Body: {
        IfCondition EqualTo(on, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(Optimize_MulUses(LoopHome.body, name), 2) ThenBlock: { ReturnValue(0) }
        Optimize_PinKeep(reg, disp)
        ReturnValue(0)
    }
}

Function.Optimize_PinWarm {
    Body: {
        Optimize_PinWarmOne(LoopHome.n0_on, LoopHome.n0_name, LoopHome.n0_reg, LoopHome.n0_disp)
        Optimize_PinWarmOne(LoopHome.n1_on, LoopHome.n1_name, LoopHome.n1_reg, LoopHome.n1_disp)
        Optimize_PinWarmOne(LoopHome.n2_on, LoopHome.n2_name, LoopHome.n2_reg, LoopHome.n2_disp)
        Optimize_PinWarmOne(LoopHome.n3_on, LoopHome.n3_name, LoopHome.n3_reg, LoopHome.n3_disp)
        ReturnValue(0)
    }
}
