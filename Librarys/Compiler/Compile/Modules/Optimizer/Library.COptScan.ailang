// Library.COptScan.ailang
// Value holds, lifetime scans, register leaves, and repeat sums.
// Loaded by the optimizer shell. No imports of its own.

Function.Optimize_TreeHasName {
    Input: node: Address
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }
        nt = AST_GetType(node)
        IfCondition EqualTo(nt, AST.IDENTIFIER) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(AST_GetData1(node), name), 1) ThenBlock: { ReturnValue(1) }
        }
        IfCondition EqualTo(nt, AST.ASSIGNMENT) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(AST_GetData1(node), name), 1) ThenBlock: { ReturnValue(1) }
        }
        count = AST_GetChildCount(node)
        i = 0
        WhileLoop LessThan(i, count) {
            IfCondition EqualTo(Optimize_TreeHasName(AST_GetChild(node, i), name), 1) ThenBlock: { ReturnValue(1) }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

Function.Optimize_TreeHasIdent {
    Input: node: Address
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }
        nt = AST_GetType(node)
        IfCondition EqualTo(nt, AST.IDENTIFIER) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(AST_GetData1(node), name), 1) ThenBlock: { ReturnValue(1) }
        }
        count = AST_GetChildCount(node)
        i = 0
        WhileLoop LessThan(i, count) {
            IfCondition EqualTo(Optimize_TreeHasIdent(AST_GetChild(node, i), name), 1) ThenBlock: { ReturnValue(1) }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

Function.Optimize_CountWalk {
    Input: node: Address
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        nt = AST_GetType(node)
        IfCondition EqualTo(nt, AST.IDENTIFIER) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(AST_GetData1(node), name), 1) ThenBlock: {
                LoopHome.mention_count = Add(LoopHome.mention_count, 1)
            }
        }
        IfCondition EqualTo(nt, AST.ASSIGNMENT) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(AST_GetData1(node), name), 1) ThenBlock: {
                LoopHome.mention_count = Add(LoopHome.mention_count, 1)
            }
        }
        count = AST_GetChildCount(node)
        i = 0
        WhileLoop LessThan(i, count) {
            Optimize_CountWalk(AST_GetChild(node, i), name)
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

Function.Optimize_CountMentions {
    Input: name: Address
    Output: Integer
    Body: {
        LoopHome.mention_count = 0
        Optimize_CountWalk(LoopHome.body, name)
        ReturnValue(LoopHome.mention_count)
    }
}

Function.Optimize_HoldOk {
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition NotEqual(Optimize_CountMentions(name), 2) ThenBlock: { ReturnValue(0) }
        body = LoopHome.body
        IfCondition EqualTo(body, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(body), AST.BLOCK) ThenBlock: { ReturnValue(0) }
        count = AST_GetChildCount(body)
        def_at = -1
        use_at = -1
        i = 0
        WhileLoop LessThan(i, count) {
            st = AST_GetChild(body, i)
            IfCondition NotEqual(st, 0) ThenBlock: {
                IfCondition EqualTo(AST_GetType(st), AST.ASSIGNMENT) ThenBlock: {
                    IfCondition EqualTo(Optimize_NameEq(AST_GetData1(st), name), 1) ThenBlock: {
                        IfCondition LessThan(def_at, 0) ThenBlock: { def_at = i }
                    }
                }
                IfCondition EqualTo(Optimize_TreeHasIdent(st, name), 1) ThenBlock: {
                    IfCondition LessThan(use_at, 0) ThenBlock: { use_at = i }
                }
            }
            i = Add(i, 1)
        }
        IfCondition LessThan(def_at, 0) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(use_at, 0) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterThan(use_at, def_at) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

Function.Optimize_AssignNested {
    Input: node: Address
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(AST_GetType(node), AST.ASSIGNMENT) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(AST_GetData1(node), name), 1) ThenBlock: {
                ReturnValue(1)
            }
        }
        count = AST_GetChildCount(node)
        i = 0
        WhileLoop LessThan(i, count) {
            IfCondition EqualTo(Optimize_AssignNested(AST_GetChild(node, i), name), 1) ThenBlock: {
                ReturnValue(1)
            }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

Function.Optimize_HoldIn {
    Input: block: Address
    Input: target: Address
    Input: value: Address
    Output: Integer
    Body: {
        body = block
        IfCondition EqualTo(body, 0) ThenBlock: { ReturnValue(0) }
        blk = 0
        IfCondition EqualTo(AST_GetType(body), AST.BLOCK) ThenBlock: { blk = 1 }
        IfCondition EqualTo(AST_GetType(body), AST.BODY) ThenBlock: { blk = 1 }
        IfCondition EqualTo(blk, 0) ThenBlock: { ReturnValue(0) }
        count = AST_GetChildCount(body)
        found = -1
        i = 0
        WhileLoop LessThan(i, count) {
            st = AST_GetChild(body, i)
            IfCondition NotEqual(st, 0) ThenBlock: {
                IfCondition EqualTo(AST_GetType(st), AST.ASSIGNMENT) ThenBlock: {
                    IfCondition EqualTo(AST_GetData2(st), 0) ThenBlock: {
                        IfCondition EqualTo(Optimize_NameEq(AST_GetData1(st), target), 1) ThenBlock: {
                            IfCondition EqualTo(AST_GetChild(st, 0), value) ThenBlock: {
                                found = i
                                i = count
                            }
                        }
                    }
                }
            }
            i = Add(i, 1)
        }
        IfCondition LessThan(found, 0) ThenBlock: { ReturnValue(0) }
        uses = 0
        k = Add(found, 1)
        WhileLoop LessThan(k, count) {
            sk = AST_GetChild(body, k)
            stop = 0
            IfCondition NotEqual(sk, 0) ThenBlock: {
                IfCondition EqualTo(AST_GetType(sk), AST.ASSIGNMENT) ThenBlock: {
                    IfCondition EqualTo(AST_GetData2(sk), 0) ThenBlock: {
                        IfCondition EqualTo(Optimize_NameEq(AST_GetData1(sk), target), 1) ThenBlock: {
                            stop = 1
                        }
                        IfCondition EqualTo(Optimize_CursorAddShape(AST_GetData1(sk), AST_GetChild(sk, 0)), 1) ThenBlock: {
                            stop = 1
                        }
                    }
                }
                IfCondition EqualTo(stop, 0) ThenBlock: {
                    nt = AST_GetType(sk)
                    nest = 0
                    IfCondition EqualTo(nt, AST.IF) ThenBlock: { nest = 1 }
                    IfCondition EqualTo(nt, AST.FORK) ThenBlock: { nest = 1 }
                    IfCondition EqualTo(nt, AST.SWITCH) ThenBlock: { nest = 1 }
                    IfCondition EqualTo(nt, AST.BRANCH) ThenBlock: { nest = 1 }
                    IfCondition EqualTo(nt, AST.WHILE) ThenBlock: { nest = 1 }
                    IfCondition EqualTo(nest, 1) ThenBlock: {
                        IfCondition EqualTo(Optimize_TreeHasIdent(sk, target), 1) ThenBlock: {
                            ReturnValue(0)
                        }
                    }
                    IfCondition EqualTo(Optimize_TreeHasIdent(sk, target), 1) ThenBlock: {
                        uses = Add(uses, 1)
                    }
                }
            }
            IfCondition EqualTo(stop, 1) ThenBlock: { k = count }
            k = Add(k, 1)
        }
        IfCondition EqualTo(uses, 1) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

Function.Optimize_HoldHere {
    Input: target: Address
    Input: value: Address
    Output: Integer
    Body: {
        ReturnValue(Optimize_HoldIn(LoopHome.body, target, value))
    }
}

Function.Optimize_HoldFind {
    Input: node: Address
    Input: target: Address
    Input: value: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        t = AST_GetType(node)
        IfCondition EqualTo(Optimize_FoldIsFn(t), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_FoldIsBlock(node), 1) ThenBlock: {
            count = AST_GetChildCount(node)
            i = 0
            WhileLoop LessThan(i, count) {
                st = AST_GetChild(node, i)
                IfCondition NotEqual(st, 0) ThenBlock: {
                    IfCondition EqualTo(AST_GetType(st), AST.ASSIGNMENT) ThenBlock: {
                        IfCondition EqualTo(AST_GetData2(st), 0) ThenBlock: {
                            IfCondition EqualTo(Optimize_NameEq(AST_GetData1(st), target), 1) ThenBlock: {
                                IfCondition EqualTo(AST_GetChild(st, 0), value) ThenBlock: {
                                    OptState.hold_block = node
                                    ReturnValue(1)
                                }
                            }
                        }
                    }
                }
                i = Add(i, 1)
            }
        }
        count = AST_GetChildCount(node)
        i = 0
        WhileLoop LessThan(i, count) {
            IfCondition EqualTo(Optimize_HoldFind(AST_GetChild(node, i), target, value), 1) ThenBlock: { ReturnValue(1) }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

Function.Optimize_HoldArm {
    Input: target: Address
    Input: value: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(LoopHome.body, 0) ThenBlock: { ReturnValue(0) }
        OptState.hold_block = 0
        IfCondition EqualTo(Optimize_HoldFind(LoopHome.body, target, value), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(OptState.hold_block, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(OptState.hold_block, LoopHome.body) ThenBlock: { ReturnValue(0) }
        ReturnValue(Optimize_HoldIn(OptState.hold_block, target, value))
    }
}

Function.Optimize_HoldChain {
    Input: name: Address
    Output: Integer
    Body: {
        body = LoopHome.body
        IfCondition EqualTo(body, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(body), AST.BLOCK) ThenBlock: { ReturnValue(0) }
        count = AST_GetChildCount(body)
        found = 0
        i = 0
        WhileLoop LessThan(i, count) {
            st = AST_GetChild(body, i)
            IfCondition NotEqual(st, 0) ThenBlock: {
                IfCondition EqualTo(AST_GetType(st), AST.ASSIGNMENT) ThenBlock: {
                    IfCondition EqualTo(AST_GetData2(st), 0) ThenBlock: {
                        IfCondition EqualTo(Optimize_NameEq(AST_GetData1(st), name), 1) ThenBlock: {
                            value = AST_GetChild(st, 0)
                            opk = 0
                            IfCondition NotEqual(value, 0) ThenBlock: {
                                IfCondition EqualTo(AST_GetType(value), AST.CALL) ThenBlock: {
                                    opk = Optimize_FltOpKind(AST_GetData1(value))
                                }
                            }
                            legal = 0
                            IfCondition EqualTo(opk, 1) ThenBlock: { legal = 1 }
                            IfCondition EqualTo(opk, 2) ThenBlock: { legal = 1 }
                            IfCondition EqualTo(opk, 3) ThenBlock: { legal = 1 }
                            IfCondition EqualTo(legal, 0) ThenBlock: { ReturnValue(0) }
                            IfCondition EqualTo(Optimize_HoldHere(name, value), 0) ThenBlock: { ReturnValue(0) }
                            IfCondition EqualTo(Optimize_AssignNested(value, name), 1) ThenBlock: { ReturnValue(0) }
                            found = 1
                        }
                    }
                } ElseBlock: {
                    IfCondition EqualTo(Optimize_AssignNested(st, name), 1) ThenBlock: { ReturnValue(0) }
                }
            }
            i = Add(i, 1)
        }
        ReturnValue(found)
    }
}

Function.Optimize_EnsureSlot {
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }
        off = Scope_Resolve(name)
        rt = Scope.resolve_type
        IfCondition EqualTo(rt, 1) ThenBlock: {
            IfCondition LessThan(off, 0) ThenBlock: { ReturnValue(off) }
        }
        IfCondition EqualTo(rt, 2) ThenBlock: {
            IfCondition LessThan(off, 0) ThenBlock: { ReturnValue(off) }
        }
        IfCondition EqualTo(rt, 0) ThenBlock: {
            Compile.stack_offset = Add(Compile.stack_offset, 8)
            off = Subtract(0, Compile.stack_offset)
            Compile_RegisterLocal(name, off)
            ReturnValue(off)
        }
        ReturnValue(0)
    }
}

Function.Optimize_NameTaken {
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(Optimize_NameEq(name, LoopHome.flt_name), 1) ThenBlock: { ReturnValue(1) }
        IfCondition NotEqual(Optimize_ExtraReg(name), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(Optimize_NameEq(name, LoopHome.int_name), 1) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(Optimize_NameEq(name, LoopHome.acc_name), 1) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

Function.Optimize_ExtraTake {
    Output: Integer
    Body: {
        free = 0
        IfCondition EqualTo(LoopHome.f2_name, 0) ThenBlock: { free = 1 }
        IfCondition EqualTo(LoopHome.f3_name, 0) ThenBlock: { free = 1 }
        IfCondition EqualTo(LoopHome.f4_name, 0) ThenBlock: { free = 1 }
        IfCondition EqualTo(LoopHome.f5_name, 0) ThenBlock: { free = 1 }
        IfCondition EqualTo(LoopHome.f6_name, 0) ThenBlock: { free = 1 }
        IfCondition LessThan(LoopHome.xf_n, 7) ThenBlock: { free = 1 }
        IfCondition EqualTo(free, 0) ThenBlock: { ReturnValue(0) }
        best_name = 0
        best_off = 0
        best_self = -1
        best_fops = 0
        best_loads = -1
        best_fresh = 0
        i = 0
        WhileLoop LessThan(i, LoopHome.count) {
            rec = Optimize_HomeRec(i)
            name = Dereference(rec)
            loads = Dereference(Add(rec, 8))
            stores = Dereference(Add(rec, 16))
            fops = Dereference(Add(rec, 24))
            selfn = Dereference(Add(rec, 32))
            seeds = Dereference(Add(rec, 40))
            IfCondition EqualTo(Optimize_NameTaken(name), 0) ThenBlock: {
                IfCondition GreaterThan(loads, 0) ThenBlock: {
                    IfCondition GreaterThan(stores, 0) ThenBlock: {
                        IfCondition GreaterThan(fops, 0) ThenBlock: {
                            IfCondition EqualTo(stores, Add(fops, seeds)) ThenBlock: {
                                off = Scope_Resolve(name)
                                rt = Scope.resolve_type
                                slot_ok = 0
                                fresh = 0
                                cand_off = 0
                                IfCondition EqualTo(rt, 1) ThenBlock: {
                                    IfCondition LessThan(off, 0) ThenBlock: {
                                        slot_ok = 1
                                        cand_off = off
                                    }
                                }
                                IfCondition EqualTo(rt, 2) ThenBlock: {
                                    IfCondition LessThan(off, 0) ThenBlock: {
                                        slot_ok = 1
                                        cand_off = off
                                    }
                                }
                                IfCondition EqualTo(rt, 0) ThenBlock: {
                                    slot_ok = 1
                                    fresh = 1
                                }
                                IfCondition EqualTo(slot_ok, 1) ThenBlock: {
                                    // A free xmm is a home. The xmm0 hold still
                                    // covers a one-use product that did not get a slot.
                                    IfCondition EqualTo(selfn, 0) ThenBlock: {
                                        IfCondition EqualTo(loads, stores) ThenBlock: {
                                            IfCondition EqualTo(Optimize_ConstTempSkip(name), 1) ThenBlock: { slot_ok = 0 }
                                        }
                                    }
                                    IfCondition EqualTo(Optimize_FltFieldUpd(loads, stores, fops, selfn, seeds), 1) ThenBlock: { slot_ok = 0 }
                                }
                                IfCondition EqualTo(slot_ok, 1) ThenBlock: {
                                    take = 0
                                    IfCondition GreaterThan(loads, best_loads) ThenBlock: { take = 1 }
                                    IfCondition EqualTo(loads, best_loads) ThenBlock: {
                                        IfCondition GreaterThan(selfn, best_self) ThenBlock: { take = 1 }
                                        IfCondition EqualTo(selfn, best_self) ThenBlock: {
                                            IfCondition GreaterThan(fops, best_fops) ThenBlock: { take = 1 }
                                        }
                                    }
                                    IfCondition EqualTo(take, 1) ThenBlock: {
                                        best_loads = loads
                                        best_self = selfn
                                        best_fops = fops
                                        best_name = name
                                        best_off = cand_off
                                        best_fresh = fresh
                                    }
                                }
                            }
                        }
                    }
                }
            }
            i = Add(i, 1)
        }
        IfCondition EqualTo(best_name, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(best_fresh, 1) ThenBlock: {
            best_off = Optimize_EnsureSlot(best_name)
            IfCondition EqualTo(best_off, 0) ThenBlock: { ReturnValue(0) }
        }
        ReturnValue(Optimize_InstallFlt(best_name, best_off))
    }
}

Function.Optimize_HomePickExtras {
    Output: Integer
    Body: {
        IfCondition EqualTo(LoopHome.flt_name, 0) ThenBlock: { ReturnValue(0) }
        n = 0
        WhileLoop LessThan(n, 12) {
            IfCondition EqualTo(Optimize_ExtraTake(), 0) ThenBlock: { n = 12 }
            n = Add(n, 1)
        }
        ReturnValue(0)
    }
}

// 1 when this compile can see the callee and none of the code it can reach
// writes r13 or xmm2-xmm5. The callee prologue does not save r13. A loop
// home writes those registers. A straight-line fused multiply-add uses xmm6.
Function.Optimize_HomesClobber {
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(1) }
        IfCondition NotEqual(OptState.clean_cache, 0) ThenBlock: {
            hit = SHash.Lookup(OptState.clean_cache, name)
            IfCondition EqualTo(hit, 1) ThenBlock: { ReturnValue(0) }
            IfCondition EqualTo(hit, 2) ThenBlock: { ReturnValue(1) }
        }
        IfCondition GreaterThan(OptState.clean_depth, 16) ThenBlock: { ReturnValue(1) }
        IfCondition NotEqual(OptState.clean_visit, 0) ThenBlock: {
            seen = SHash.Lookup(OptState.clean_visit, name)
            IfCondition EqualTo(seen, 1) ThenBlock: { ReturnValue(1) }
        }
        IfCondition EqualTo(OptState.func_nodes, 0) ThenBlock: { ReturnValue(1) }
        func_node = SHash.LookupAddr(OptState.func_nodes, name)
        IfCondition EqualTo(func_node, Collections.XNULL) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(func_node, 0) ThenBlock: { ReturnValue(1) }
        body = Optimize_InlineBody(func_node)
        IfCondition EqualTo(body, 0) ThenBlock: { ReturnValue(1) }
        IfCondition NotEqual(OptState.clean_visit, 0) ThenBlock: {
            SHash.Insert(OptState.clean_visit, name, 1)
        }
        OptState.clean_depth = Add(OptState.clean_depth, 1)
        bad = Optimize_NodeClobbers(body)
        OptState.clean_depth = Subtract(OptState.clean_depth, 1)
        IfCondition NotEqual(OptState.clean_visit, 0) ThenBlock: {
            SHash.Insert(OptState.clean_visit, name, 0)
        }
        IfCondition NotEqual(OptState.clean_cache, 0) ThenBlock: {
            mark = 1
            IfCondition EqualTo(bad, 1) ThenBlock: { mark = 2 }
            SHash.Insert(OptState.clean_cache, name, mark)
        }
        ReturnValue(bad)
    }
}

Function.Optimize_NodeClobbers {
    Input: node: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        t = AST_GetType(node)
        IfCondition EqualTo(t, AST.INLINEASM) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(Optimize_HomeBlockNode(t), 1) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(t, AST.CALL) ThenBlock: {
            cn = AST_GetData1(node)
            IfCondition EqualTo(cn, 0) ThenBlock: { ReturnValue(1) }
            known = Optimize_HomeCallOk(cn)
            IfCondition EqualTo(known, 0) ThenBlock: {
                IfCondition EqualTo(Optimize_HomesClobber(cn), 1) ThenBlock: { ReturnValue(1) }
            }
        }
        count = AST_GetChildCount(node)
        i = 0
        WhileLoop LessThan(i, count) {
            IfCondition EqualTo(Optimize_NodeClobbers(AST_GetChild(node, i)), 1) ThenBlock: {
                ReturnValue(1)
            }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

Function.Optimize_ScanBlock {
    Input: node: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(1) }
        IfCondition NotEqual(AST_GetType(node), AST.BLOCK) ThenBlock: {
            ReturnValue(Optimize_ScanNode(node))
        }
        count = AST_GetChildCount(node)
        ok = 1
        i = 0
        WhileLoop LessThan(i, count) {
            IfCondition EqualTo(Optimize_ScanNode(AST_GetChild(node, i)), 0) ThenBlock: { ok = 0 }
            i = Add(i, 1)
        }
        ReturnValue(ok)
    }
}

Function.Optimize_ScanCondSafe {
    Input: node: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(node), AST.CALL) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_IsCompareName(AST_GetData1(node)), 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetChildCount(node), 2) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_IsLeaf(AST_GetChild(node, 0)), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_IsLeaf(AST_GetChild(node, 1)), 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(AST_GetChild(node, 1)), AST.NUMBER) ThenBlock: { ReturnValue(0) }
        ReturnValue(1)
    }
}

Function.Optimize_ScanIf {
    Input: node: Address
    Output: Integer
    Body: {
        safe = Optimize_ScanCondSafe(AST_GetChild(node, 0))
        LoopHome.scan_depth = Add(LoopHome.scan_depth, 1)
        IfCondition EqualTo(Optimize_ScanBlock(AST_GetChild(node, 1)), 0) ThenBlock: { safe = 0 }
        IfCondition GreaterThan(AST_GetChildCount(node), 2) ThenBlock: {
            IfCondition EqualTo(Optimize_ScanBlock(AST_GetChild(node, 2)), 0) ThenBlock: { safe = 0 }
        }
        LoopHome.scan_depth = Subtract(LoopHome.scan_depth, 1)
        ReturnValue(safe)
    }
}

Function.Optimize_ScanBranch {
    Input: node: Address
    Output: Integer
    Body: {
        safe = 1
        scr = AST_GetChild(node, 0)
        IfCondition EqualTo(scr, 0) ThenBlock: { safe = 0 }
        IfCondition NotEqual(scr, 0) ThenBlock: {
            st = AST_GetType(scr)
            leaf = 0
            IfCondition EqualTo(st, AST.IDENTIFIER) ThenBlock: { leaf = 1 }
            IfCondition EqualTo(st, AST.NUMBER) ThenBlock: { leaf = 1 }
            IfCondition EqualTo(leaf, 0) ThenBlock: { safe = 0 }
        }
        n = AST_GetChildCount(node)
        i = 1
        WhileLoop LessThan(i, n) {
            ch = AST_GetChild(node, i)
            IfCondition NotEqual(ch, 0) ThenBlock: {
                IfCondition EqualTo(AST_GetType(ch), AST.CASE) ThenBlock: {
                    IfCondition EqualTo(Optimize_IsLeaf(AST_GetChild(ch, 0)), 0) ThenBlock: { safe = 0 }
                }
            }
            i = Add(i, 1)
        }
        LoopHome.scan_depth = Add(LoopHome.scan_depth, 1)
        i = 1
        WhileLoop LessThan(i, n) {
            ch = AST_GetChild(node, i)
            IfCondition NotEqual(ch, 0) ThenBlock: {
                IfCondition EqualTo(AST_GetType(ch), AST.CASE) ThenBlock: {
                    IfCondition EqualTo(Optimize_ScanBlock(AST_GetChild(ch, 1)), 0) ThenBlock: { safe = 0 }
                }
                IfCondition EqualTo(AST_GetType(ch), AST.DEFAULT) ThenBlock: {
                    IfCondition EqualTo(Optimize_ScanBlock(AST_GetChild(ch, 0)), 0) ThenBlock: { safe = 0 }
                }
            }
            i = Add(i, 1)
        }
        LoopHome.scan_depth = Subtract(LoopHome.scan_depth, 1)
        ReturnValue(safe)
    }
}

Function.Optimize_ScanNode {
    Input: node: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        nt = AST_GetType(node)
        IfCondition EqualTo(nt, AST.ASSIGNMENT) ThenBlock: { ReturnValue(Optimize_ScanStmt(node)) }
        IfCondition EqualTo(nt, AST.BLOCK) ThenBlock: { ReturnValue(Optimize_ScanBlock(node)) }
        IfCondition EqualTo(nt, AST.IF) ThenBlock: { ReturnValue(Optimize_ScanIf(node)) }
        IfCondition EqualTo(nt, AST.FORK) ThenBlock: { ReturnValue(Optimize_ScanIf(node)) }
        IfCondition EqualTo(nt, AST.SWITCH) ThenBlock: { ReturnValue(Optimize_ScanBranch(node)) }
        IfCondition EqualTo(nt, AST.BRANCH) ThenBlock: { ReturnValue(Optimize_ScanBranch(node)) }
        ReturnValue(0)
    }
}

Function.Optimize_CallArgsSafe {
    Input: node: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        n = AST_GetChildCount(node)
        i = 0
        WhileLoop LessThan(i, n) {
            IfCondition EqualTo(Optimize_RbxSafeOp(AST_GetChild(node, i)), 0) ThenBlock: { ReturnValue(0) }
            i = Add(i, 1)
        }
        ReturnValue(1)
    }
}

Function.Optimize_ScanStmt {
    Input: node: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(node), AST.ASSIGNMENT) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetData2(node), 0) ThenBlock: { ReturnValue(0) }
        target = AST_GetData1(node)
        value = AST_GetChild(node, 0)
        IfCondition EqualTo(value, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_MemAliasShape(target, value), 1) ThenBlock: {
            disp = LoopHome.imm_val
            IfCondition GreaterThan(LoopHome.scan_depth, 0) ThenBlock: { LoopHome.alias_spill = 1 }
            IfCondition EqualTo(Optimize_AliasAdd(target, disp), 0) ThenBlock: { ReturnValue(0) }
            live = Optimize_AliasLive()
            IfCondition GreaterThan(live, LoopHome.scan_temps) ThenBlock: {
                LoopHome.scan_temps = live
            }
            ReturnValue(1)
        }
        IfCondition EqualTo(Optimize_CursorAddShape(target, value), 1) ThenBlock: {
            LoopHome.scan_updates = Add(LoopHome.scan_updates, 1)
            Optimize_AliasClearAll()
            ReturnValue(1)
        }
        IfCondition NotEqual(Optimize_AccShape(target, value), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(AST_GetType(value), AST.CALL) ThenBlock: {
            opk = Optimize_FltOpKind(AST_GetData1(value))
            IfCondition GreaterThan(opk, 0) ThenBlock: {
                IfCondition EqualTo(AST_GetChildCount(value), 2) ThenBlock: {
                    IfCondition EqualTo(Optimize_RbxSafeOp(AST_GetChild(value, 0)), 1) ThenBlock: {
                        IfCondition EqualTo(Optimize_RbxSafeOp(AST_GetChild(value, 1)), 1) ThenBlock: {
                            ReturnValue(1)
                        }
                    }
                }
            }
        }
        IfCondition EqualTo(AST_GetType(value), AST.CALL) ThenBlock: {
            sk = Optimize_ScaledBase(value)
            IfCondition EqualTo(sk, 1) ThenBlock: { ReturnValue(1) }
            IfCondition EqualTo(Optimize_HomeCallOk(AST_GetData1(value)), 0) ThenBlock: {
                IfCondition GreaterEqual(Compile_FindFunction(AST_GetData1(value)), 0) ThenBlock: {
                    IfCondition EqualTo(Optimize_CallArgsSafe(value), 1) ThenBlock: { ReturnValue(1) }
                }
            }
        }
        IfCondition EqualTo(Optimize_PtrCopyShape(target, value), 1) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

Function.Optimize_ScanLifetimes {
    Input: body: Address
    Output: Integer
    Body: {
        count = AST_GetChildCount(body)
        i = 0
        WhileLoop LessThan(i, count) {
            st = AST_GetChild(body, i)
            IfCondition NotEqual(st, 0) ThenBlock: {
                IfCondition EqualTo(AST_GetType(st), AST.ASSIGNMENT) ThenBlock: {
                    IfCondition EqualTo(AST_GetData2(st), 0) ThenBlock: {
                        tgt = AST_GetData1(st)
                        IfCondition EqualTo(Optimize_MemAliasShape(tgt, AST_GetChild(st, 0)), 1) ThenBlock: {
                            prev = -1
                            j = 0
                            WhileLoop LessThan(j, i) {
                                sj = AST_GetChild(body, j)
                                IfCondition NotEqual(sj, 0) ThenBlock: {
                                    IfCondition EqualTo(AST_GetType(sj), AST.ASSIGNMENT) ThenBlock: {
                                        IfCondition EqualTo(AST_GetData2(sj), 0) ThenBlock: {
                                            IfCondition EqualTo(Optimize_NameEq(AST_GetData1(sj), tgt), 1) ThenBlock: {
                                                prev = j
                                            }
                                        }
                                    }
                                }
                                j = Add(j, 1)
                            }
                            IfCondition LessThan(prev, 0) ThenBlock: {
                                j = 0
                                WhileLoop LessThan(j, i) {
                                    IfCondition EqualTo(Optimize_TreeHasName(AST_GetChild(body, j), tgt), 1) ThenBlock: {
                                        LoopHome.alias_spill = 1
                                    }
                                    j = Add(j, 1)
                                }
                            }
                            u = -1
                            j = Add(i, 1)
                            WhileLoop LessThan(j, count) {
                                sj = AST_GetChild(body, j)
                                IfCondition NotEqual(sj, 0) ThenBlock: {
                                    IfCondition EqualTo(AST_GetType(sj), AST.ASSIGNMENT) ThenBlock: {
                                        IfCondition EqualTo(AST_GetData2(sj), 0) ThenBlock: {
                                            IfCondition EqualTo(Optimize_CursorAddShape(AST_GetData1(sj), AST_GetChild(sj, 0)), 1) ThenBlock: {
                                                u = j
                                                j = count
                                            }
                                        }
                                    }
                                }
                                j = Add(j, 1)
                            }
                            IfCondition LessThan(u, 0) ThenBlock: {
                                LoopHome.alias_spill = 1
                            }
                            IfCondition GreaterEqual(u, 0) ThenBlock: {
                                IfCondition EqualTo(Optimize_TreeHasName(AST_GetChild(body, u), tgt), 1) ThenBlock: {
                                    LoopHome.alias_spill = 1
                                }
                                k = Add(u, 1)
                                WhileLoop LessThan(k, count) {
                                    sk = AST_GetChild(body, k)
                                    hit_def = 0
                                    IfCondition NotEqual(sk, 0) ThenBlock: {
                                        IfCondition EqualTo(AST_GetType(sk), AST.ASSIGNMENT) ThenBlock: {
                                            IfCondition EqualTo(AST_GetData2(sk), 0) ThenBlock: {
                                                IfCondition EqualTo(Optimize_NameEq(AST_GetData1(sk), tgt), 1) ThenBlock: {
                                                    hit_def = 1
                                                    IfCondition EqualTo(Optimize_TreeHasName(AST_GetChild(sk, 0), tgt), 1) ThenBlock: {
                                                        LoopHome.alias_spill = 1
                                                    }
                                                    k = count
                                                }
                                            }
                                        }
                                    }
                                    IfCondition EqualTo(hit_def, 0) ThenBlock: {
                                        IfCondition EqualTo(Optimize_TreeHasName(sk, tgt), 1) ThenBlock: {
                                            LoopHome.alias_spill = 1
                                        }
                                    }
                                    k = Add(k, 1)
                                }
                            }
                        }
                    }
                }
            }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

Function.Optimize_ScanBody {
    Input: body: Address
    Output: Integer
    Body: {
        LoopHome.rbx_free = 1
        LoopHome.alias_spill = 0
        LoopHome.scan_temps = 0
        LoopHome.scan_updates = 0
        LoopHome.scan_depth = 0
        Optimize_AliasClearAll()
        LoopHome.hold_on = 0
        IfCondition EqualTo(body, 0) ThenBlock: {
            LoopHome.rbx_free = 0
            ReturnValue(0)
        }
        IfCondition NotEqual(AST_GetType(body), AST.BLOCK) ThenBlock: {
            LoopHome.rbx_free = 0
            ReturnValue(0)
        }
        count = AST_GetChildCount(body)
        i = 0
        WhileLoop LessThan(i, count) {
            IfCondition EqualTo(Optimize_ScanNode(AST_GetChild(body, i)), 0) ThenBlock: {
                LoopHome.rbx_free = 0
            }
            i = Add(i, 1)
        }
        IfCondition EqualTo(LoopHome.scan_updates, 0) ThenBlock: { LoopHome.alias_spill = 1 }
        IfCondition GreaterThan(LoopHome.scan_temps, 4) ThenBlock: { LoopHome.alias_spill = 1 }
        IfCondition GreaterThan(LoopHome.scan_temps, 4) ThenBlock: { LoopHome.rbx_free = 0 }
        IfCondition EqualTo(LoopHome.alias_spill, 0) ThenBlock: {
            Optimize_ScanLifetimes(body)
        }
        Optimize_AliasClearAll()
        LoopHome.hold_on = 0
        LoopHome.hold_name = 0
        ReturnValue(0)
    }
}

Function.Optimize_ScanCondTemps {
    Input: condition: Address
    Input: body: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(LoopHome.alias_spill, 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(condition, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(body, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(body), AST.BLOCK) ThenBlock: { ReturnValue(0) }
        count = AST_GetChildCount(body)
        i = 0
        WhileLoop LessThan(i, count) {
            st = AST_GetChild(body, i)
            IfCondition NotEqual(st, 0) ThenBlock: {
                IfCondition EqualTo(AST_GetType(st), AST.ASSIGNMENT) ThenBlock: {
                    IfCondition EqualTo(AST_GetData2(st), 0) ThenBlock: {
                        tgt = AST_GetData1(st)
                        IfCondition EqualTo(Optimize_MemAliasShape(tgt, AST_GetChild(st, 0)), 1) ThenBlock: {
                            IfCondition EqualTo(Optimize_TreeHasName(condition, tgt), 1) ThenBlock: {
                                LoopHome.alias_spill = 1
                            }
                        }
                    }
                }
            }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

Function.Optimize_BodyAssigns {
    Input: name: Address
    Output: Integer
    Body: {
        body = LoopHome.body
        IfCondition EqualTo(body, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(body), AST.BLOCK) ThenBlock: { ReturnValue(0) }
        count = AST_GetChildCount(body)
        i = 0
        WhileLoop LessThan(i, count) {
            st = AST_GetChild(body, i)
            IfCondition NotEqual(st, 0) ThenBlock: {
                IfCondition EqualTo(AST_GetType(st), AST.ASSIGNMENT) ThenBlock: {
                    IfCondition EqualTo(Optimize_NameEq(AST_GetData1(st), name), 1) ThenBlock: { ReturnValue(1) }
                }
            }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

// 1 when this tree lowers through RBX without saving it. A real call saves
// RBX. Magic divide, a byte store, and a compare that materializes both
// sides do not. An accumulator limit parked in RBX stays off those loops.
Function.Optimize_TreeRbxBusy {
    Input: node: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        nt = AST_GetType(node)
        IfCondition EqualTo(nt, AST.INLINEASM) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(nt, AST.CALL) ThenBlock: {
            op = AST_GetData1(node)
            IfCondition EqualTo(StringCompare(op, "Divide"), 0) ThenBlock: { ReturnValue(1) }
            IfCondition EqualTo(StringCompare(op, "Modulo"), 0) ThenBlock: { ReturnValue(1) }
            IfCondition EqualTo(StringCompare(op, "StoreValue"), 0) ThenBlock: { ReturnValue(1) }
            IfCondition EqualTo(StringCompare(op, "SetByte"), 0) ThenBlock: { ReturnValue(1) }
            IfCondition EqualTo(StringCompare(op, "GetByte"), 0) ThenBlock: { ReturnValue(1) }
            IfCondition EqualTo(StringCompare(op, "Allocate"), 0) ThenBlock: { ReturnValue(1) }
            IfCondition EqualTo(StringCompare(op, "Deallocate"), 0) ThenBlock: { ReturnValue(1) }
            IfCondition EqualTo(StringCompare(op, "MemoryCopy"), 0) ThenBlock: { ReturnValue(1) }
            IfCondition EqualTo(StringCompare(op, "MemorySet"), 0) ThenBlock: { ReturnValue(1) }
            IfCondition EqualTo(Optimize_IsCompareName(op), 1) ThenBlock: {
                IfCondition NotEqual(AST_GetChildCount(node), 2) ThenBlock: { ReturnValue(1) }
                c0 = AST_GetChild(node, 0)
                c1 = AST_GetChild(node, 1)
                quiet = 0
                IfCondition NotEqual(c1, 0) ThenBlock: {
                    IfCondition EqualTo(AST_GetType(c1), AST.NUMBER) ThenBlock: {
                        IfCondition EqualTo(Optimize_Fit32(StringToNumber(AST_GetData1(c1))), 1) ThenBlock: {
                            quiet = 1
                        }
                    }
                }
                IfCondition EqualTo(quiet, 0) ThenBlock: {
                    IfCondition NotEqual(c0, 0) ThenBlock: {
                        IfCondition EqualTo(AST_GetType(c0), AST.IDENTIFIER) ThenBlock: {
                            IfCondition NotEqual(c1, 0) ThenBlock: {
                                IfCondition EqualTo(AST_GetType(c1), AST.IDENTIFIER) ThenBlock: {
                                    quiet = 1
                                }
                            }
                        }
                    }
                }
                IfCondition EqualTo(quiet, 0) ThenBlock: { ReturnValue(1) }
            }
        }
        count = AST_GetChildCount(node)
        i = 0
        WhileLoop LessThan(i, count) {
            IfCondition EqualTo(Optimize_TreeRbxBusy(AST_GetChild(node, i)), 1) ThenBlock: { ReturnValue(1) }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

// 1 when a continue or a loop exit sits in this tree. A function return
// does not. Those two reach a back edge; a return does not.
Function.Optimize_TreeHasStop {
    Input: node: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        nt = AST_GetType(node)
        IfCondition EqualTo(nt, AST.CONTINUE_LOOP) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(nt, AST.EXIT_LOOP) ThenBlock: { ReturnValue(1) }
        n = AST_GetChildCount(node)
        i = 0
        WhileLoop LessThan(i, n) {
            IfCondition EqualTo(Optimize_TreeHasStop(AST_GetChild(node, i)), 1) ThenBlock: {
                ReturnValue(1)
            }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

// 1 when every path through this node returns from the function.
// A continue or a break makes that untrue. Later siblings of a return are dead.
Function.Optimize_AlwaysReturns {
    Input: node: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        nt = AST_GetType(node)
        IfCondition EqualTo(nt, AST.RETURN) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(nt, AST.IF) ThenBlock: {
            IfCondition GreaterThan(AST_GetChildCount(node), 2) ThenBlock: {
                th = AST_GetChild(node, 1)
                el = AST_GetChild(node, 2)
                IfCondition EqualTo(Optimize_AlwaysReturns(th), 1) ThenBlock: {
                    IfCondition EqualTo(Optimize_AlwaysReturns(el), 1) ThenBlock: {
                        ReturnValue(1)
                    }
                }
            }
            ReturnValue(0)
        }
        IfCondition NotEqual(nt, AST.BLOCK) ThenBlock: { ReturnValue(0) }
        n = AST_GetChildCount(node)
        i = 0
        WhileLoop LessThan(i, n) {
            st = AST_GetChild(node, i)
            IfCondition NotEqual(st, 0) ThenBlock: {
                stt = AST_GetType(st)
                IfCondition EqualTo(stt, AST.RETURN) ThenBlock: { ReturnValue(1) }
                IfCondition EqualTo(Optimize_TreeHasStop(st), 1) ThenBlock: { ReturnValue(0) }
                IfCondition EqualTo(stt, AST.IF) ThenBlock: {
                    IfCondition GreaterThan(AST_GetChildCount(st), 2) ThenBlock: {
                        th = AST_GetChild(st, 1)
                        el = AST_GetChild(st, 2)
                        IfCondition EqualTo(Optimize_AlwaysReturns(th), 1) ThenBlock: {
                            IfCondition EqualTo(Optimize_AlwaysReturns(el), 1) ThenBlock: {
                                ReturnValue(1)
                            }
                        }
                    }
                }
                IfCondition EqualTo(stt, AST.BLOCK) ThenBlock: {
                    IfCondition EqualTo(Optimize_AlwaysReturns(st), 1) ThenBlock: { ReturnValue(1) }
                }
            }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

// 1 when a back-edge path clobbers RBX. A store on a path that returns
// from the function does not. Continue and break still do.
Function.Optimize_EdgeBusy {
    Input: node: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        nt = AST_GetType(node)
        IfCondition EqualTo(nt, AST.BLOCK) ThenBlock: {
            n = AST_GetChildCount(node)
            i = 0
            WhileLoop LessThan(i, n) {
                st = AST_GetChild(node, i)
                IfCondition NotEqual(st, 0) ThenBlock: {
                    IfCondition EqualTo(Optimize_AlwaysReturns(st), 1) ThenBlock: {
                        ReturnValue(0)
                    }
                    IfCondition EqualTo(Optimize_EdgeBusy(st), 1) ThenBlock: { ReturnValue(1) }
                }
                i = Add(i, 1)
            }
            ReturnValue(0)
        }
        IfCondition EqualTo(nt, AST.IF) ThenBlock: {
            IfCondition EqualTo(Optimize_TreeRbxBusy(AST_GetChild(node, 0)), 1) ThenBlock: {
                ReturnValue(1)
            }
            th = AST_GetChild(node, 1)
            IfCondition EqualTo(Optimize_AlwaysReturns(th), 0) ThenBlock: {
                IfCondition EqualTo(Optimize_EdgeBusy(th), 1) ThenBlock: { ReturnValue(1) }
            }
            IfCondition GreaterThan(AST_GetChildCount(node), 2) ThenBlock: {
                el = AST_GetChild(node, 2)
                IfCondition EqualTo(Optimize_AlwaysReturns(el), 0) ThenBlock: {
                    IfCondition EqualTo(Optimize_EdgeBusy(el), 1) ThenBlock: { ReturnValue(1) }
                }
            }
            ReturnValue(0)
        }
        ReturnValue(Optimize_TreeRbxBusy(node))
    }
}

// Park the accumulator's frame limit in RBX when the body cannot clobber it.
// ScanBody clears rbx_free for a probe that contains a call. That bans
// scratch use. It does not mean RBX dies. This turns it back on for the limit.
Function.Optimize_AccLimit {
    Input: condition: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(condition, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(condition), AST.CALL) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_IsCompareName(AST_GetData1(condition)), 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetChildCount(condition), 2) ThenBlock: { ReturnValue(0) }
        a0 = AST_GetChild(condition, 0)
        a1 = AST_GetChild(condition, 1)
        IfCondition EqualTo(Optimize_IsLeaf(a0), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_IsLeaf(a1), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(LoopHome.acc_name, 0) ThenBlock: { ReturnValue(0) }
        acc_left = 0
        acc_right = 0
        IfCondition EqualTo(AST_GetType(a0), AST.IDENTIFIER) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(AST_GetData1(a0), LoopHome.acc_name), 1) ThenBlock: {
                acc_left = 1
            }
        }
        IfCondition EqualTo(AST_GetType(a1), AST.IDENTIFIER) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(AST_GetData1(a1), LoopHome.acc_name), 1) ThenBlock: {
                acc_right = 1
            }
        }
        IfCondition EqualTo(acc_left, acc_right) ThenBlock: { ReturnValue(0) }
        other = a1
        IfCondition EqualTo(acc_right, 1) ThenBlock: { other = a0 }
        IfCondition NotEqual(AST_GetType(other), AST.IDENTIFIER) ThenBlock: { ReturnValue(0) }
        nm = AST_GetData1(other)
        IfCondition EqualTo(Optimize_NameEq(nm, LoopHome.int_name), 1) ThenBlock: { ReturnValue(0) }
        off = Scope_Resolve(nm)
        rt = Scope.resolve_type
        ok = 0
        IfCondition EqualTo(rt, 1) ThenBlock: { ok = 1 }
        IfCondition EqualTo(rt, 2) ThenBlock: { ok = 1 }
        IfCondition GreaterEqual(off, 0) ThenBlock: { ok = 0 }
        IfCondition EqualTo(ok, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_BodyAssigns(nm), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_EdgeBusy(LoopHome.body), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_EdgeBusy(condition), 1) ThenBlock: { ReturnValue(0) }
        LoopHome.rbx_free = 1
        LoopHome.lim_on = 1
        LoopHome.lim_name = nm
        LoopHome.lim_off = off
        ReturnValue(1)
    }
}

Function.Optimize_ScanLimit {
    Input: condition: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(LoopHome.rbx_free, 0) ThenBlock: {
            IfCondition EqualTo(Optimize_AccLimit(condition), 1) ThenBlock: { ReturnValue(1) }
            ReturnValue(0)
        }
        IfCondition EqualTo(condition, 0) ThenBlock: {
            LoopHome.rbx_free = 0
            ReturnValue(0)
        }
        IfCondition NotEqual(AST_GetType(condition), AST.CALL) ThenBlock: {
            LoopHome.rbx_free = 0
            ReturnValue(0)
        }
        IfCondition EqualTo(Optimize_IsCompareName(AST_GetData1(condition)), 0) ThenBlock: {
            LoopHome.rbx_free = 0
            ReturnValue(0)
        }
        IfCondition NotEqual(AST_GetChildCount(condition), 2) ThenBlock: {
            LoopHome.rbx_free = 0
            ReturnValue(0)
        }
        a0 = AST_GetChild(condition, 0)
        a1 = AST_GetChild(condition, 1)
        IfCondition EqualTo(Optimize_IsLeaf(a0), 0) ThenBlock: {
            LoopHome.rbx_free = 0
            ReturnValue(0)
        }
        IfCondition EqualTo(Optimize_IsLeaf(a1), 0) ThenBlock: {
            LoopHome.rbx_free = 0
            ReturnValue(0)
        }
        home_left = 0
        home_right = 0
        acc_pick = 0
        IfCondition EqualTo(AST_GetType(a0), AST.IDENTIFIER) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(AST_GetData1(a0), LoopHome.int_name), 1) ThenBlock: { home_left = 1 }
            IfCondition EqualTo(home_left, 0) ThenBlock: {
                IfCondition NotEqual(LoopHome.acc_name, 0) ThenBlock: {
                    IfCondition EqualTo(Optimize_NameEq(AST_GetData1(a0), LoopHome.acc_name), 1) ThenBlock: {
                        home_left = 1
                        acc_pick = 1
                    }
                }
            }
        }
        IfCondition EqualTo(AST_GetType(a1), AST.IDENTIFIER) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(AST_GetData1(a1), LoopHome.int_name), 1) ThenBlock: { home_right = 1 }
            IfCondition EqualTo(home_right, 0) ThenBlock: {
                IfCondition NotEqual(LoopHome.acc_name, 0) ThenBlock: {
                    IfCondition EqualTo(Optimize_NameEq(AST_GetData1(a1), LoopHome.acc_name), 1) ThenBlock: {
                        home_right = 1
                        acc_pick = 1
                    }
                }
            }
        }
        IfCondition EqualTo(home_left, home_right) ThenBlock: {
            LoopHome.rbx_free = 0
            ReturnValue(0)
        }
        other = a1
        IfCondition EqualTo(home_right, 1) ThenBlock: { other = a0 }
        IfCondition EqualTo(AST_GetType(other), AST.NUMBER) ThenBlock: {
            LoopHome.lim_on = 0
            ReturnValue(1)
        }
        IfCondition EqualTo(AST_GetType(other), AST.IDENTIFIER) ThenBlock: {
            nm = AST_GetData1(other)
            off = Scope_Resolve(nm)
            rt = Scope.resolve_type
            ok = 0
            IfCondition EqualTo(rt, 1) ThenBlock: { ok = 1 }
            IfCondition EqualTo(rt, 2) ThenBlock: { ok = 1 }
            IfCondition GreaterEqual(off, 0) ThenBlock: { ok = 0 }
            IfCondition EqualTo(ok, 1) ThenBlock: {
                IfCondition EqualTo(Optimize_BodyAssigns(nm), 1) ThenBlock: {
                    LoopHome.rbx_free = 0
                    ReturnValue(0)
                }
                // The integer home already parked limits next to divides.
                // The accumulator's limit is new, and only when the body
                // cannot clobber RBX on a path that reaches the back edge.
                IfCondition EqualTo(acc_pick, 1) ThenBlock: {
                    busy = 0
                    IfCondition EqualTo(Optimize_TreeRbxBusy(LoopHome.body), 1) ThenBlock: { busy = 1 }
                    IfCondition EqualTo(Optimize_TreeRbxBusy(condition), 1) ThenBlock: { busy = 1 }
                    IfCondition EqualTo(busy, 1) ThenBlock: {
                        LoopHome.rbx_free = 0
                        ReturnValue(0)
                    }
                }
                LoopHome.lim_on = 1
                LoopHome.lim_name = nm
                LoopHome.lim_off = off
                ReturnValue(1)
            }
        }
        LoopHome.rbx_free = 0
        ReturnValue(0)
    }
}

// Parameter slot in source order. -1 when the name is not a parameter.
Function.Optimize_ParamIndex {
    Input: func_node: Address
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(func_node, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(-1) }
        n = AST_GetChildCount(func_node)
        i = 0
        slot = 0
        WhileLoop LessThan(i, n) {
            ch = AST_GetChild(func_node, i)
            IfCondition NotEqual(ch, 0) ThenBlock: {
                IfCondition EqualTo(AST_GetType(ch), AST.PARAMETER) ThenBlock: {
                    IfCondition EqualTo(Optimize_NameEq(AST_GetData1(ch), name), 1) ThenBlock: {
                        ReturnValue(slot)
                    }
                    slot = Add(slot, 1)
                }
            }
            i = Add(i, 1)
        }
        ReturnValue(-1)
    }
}

Function.Optimize_ParamCount {
    Input: func_node: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(func_node, 0) ThenBlock: { ReturnValue(0) }
        n = AST_GetChildCount(func_node)
        i = 0
        slot = 0
        WhileLoop LessThan(i, n) {
            ch = AST_GetChild(func_node, i)
            IfCondition NotEqual(ch, 0) ThenBlock: {
                IfCondition EqualTo(AST_GetType(ch), AST.PARAMETER) ThenBlock: {
                    slot = Add(slot, 1)
                }
            }
            i = Add(i, 1)
        }
        ReturnValue(slot)
    }
}

// 1 when this operand can be an argument register or a fit32 immediate.
Function.Optimize_RegLeafSide {
    Input: func_node: Address
    Input: leaf: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(leaf, 0) ThenBlock: { ReturnValue(0) }
        kind = AST_GetType(leaf)
        IfCondition EqualTo(kind, AST.NUMBER) ThenBlock: {
            ReturnValue(Optimize_Fit32(StringToNumber(AST_GetData1(leaf))))
        }
        IfCondition NotEqual(kind, AST.IDENTIFIER) ThenBlock: { ReturnValue(0) }
        idx = Optimize_ParamIndex(func_node, AST_GetData1(leaf))
        IfCondition LessThan(idx, 0) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterThan(idx, 5) ThenBlock: { ReturnValue(0) }
        ReturnValue(1)
    }
}

// The return expression when the body is only Return Add/Subtract of two
// parameters or fit32 numbers, and the function has at most six parameters.
// Zero otherwise. The caller emits that expression with no frame.
Function.Optimize_RegLeafExpr {
    Input: func_node: Address
    Input: body: Address
    Output: Address
    Body: {
        IfCondition EqualTo(body, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(body), AST.BLOCK) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetChildCount(body), 1) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterThan(Optimize_ParamCount(func_node), 6) ThenBlock: { ReturnValue(0) }
        stmt = AST_GetChild(body, 0)
        IfCondition EqualTo(stmt, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(stmt), AST.RETURN) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetChildCount(stmt), 1) ThenBlock: { ReturnValue(0) }
        expr = AST_GetChild(stmt, 0)
        IfCondition EqualTo(expr, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(expr), AST.CALL) ThenBlock: { ReturnValue(0) }
        opname = AST_GetData1(expr)
        is_add = EqualTo(StringCompare(opname, "Add"), 0)
        is_sub = EqualTo(StringCompare(opname, "Subtract"), 0)
        IfCondition EqualTo(is_add, 0) ThenBlock: {
            IfCondition EqualTo(is_sub, 0) ThenBlock: { ReturnValue(0) }
        }
        IfCondition NotEqual(AST_GetChildCount(expr), 2) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_RegLeafSide(func_node, AST_GetChild(expr, 0)), 0) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition EqualTo(Optimize_RegLeafSide(func_node, AST_GetChild(expr, 1)), 0) ThenBlock: {
            ReturnValue(0)
        }
        ReturnValue(expr)
    }
}

Function.Optimize_EmitLeafRax {
    Input: func_node: Address
    Input: leaf: Address
    Output: Integer
    Body: {
        kind = AST_GetType(leaf)
        IfCondition EqualTo(kind, AST.NUMBER) ThenBlock: {
            Emit_MovRaxImm64(StringToNumber(AST_GetData1(leaf)))
            ReturnValue(1)
        }
        idx = Optimize_ParamIndex(func_node, AST_GetData1(leaf))
        reg = CompileFunc_ArgReg(idx)
        IfCondition LessThan(reg, 0) ThenBlock: { ReturnValue(0) }
        Emit_MovRegReg(Reg.RAX, reg)
        ReturnValue(1)
    }
}

// rax = left +/- right. Right is a parameter register or a fit32 immediate.
// Neither side uses rbx, so a frame-free leaf keeps the callee-saved set.
Function.Optimize_EmitRegLeaf {
    Input: func_node: Address
    Input: expr: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(Optimize_EmitLeafRax(func_node, AST_GetChild(expr, 0)), 0) ThenBlock: {
            ReturnValue(0)
        }
        right = AST_GetChild(expr, 1)
        is_sub = EqualTo(StringCompare(AST_GetData1(expr), "Subtract"), 0)
        IfCondition EqualTo(AST_GetType(right), AST.NUMBER) ThenBlock: {
            val = StringToNumber(AST_GetData1(right))
            IfCondition EqualTo(is_sub, 1) ThenBlock: { Emit_SubRegImm32(Reg.RAX, val) }
            IfCondition EqualTo(is_sub, 0) ThenBlock: { Emit_AddRegImm32(Reg.RAX, val) }
            ReturnValue(1)
        }
        reg = CompileFunc_ArgReg(Optimize_ParamIndex(func_node, AST_GetData1(right)))
        IfCondition LessThan(reg, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(is_sub, 1) ThenBlock: { X86_SubRegReg(Reg.RAX, reg) }
        IfCondition EqualTo(is_sub, 0) ThenBlock: { X86_AddRegReg(Reg.RAX, reg) }
        ReturnValue(1)
    }
}

// Previous sibling of target, searching from root. Zero when target is the
// first statement of its block or is not under root.
Function.Optimize_PrevSibling {
    Input: root: Address
    Input: target: Address
    Output: Address
    Body: {
        IfCondition EqualTo(root, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(target, 0) ThenBlock: { ReturnValue(0) }
        count = AST_GetChildCount(root)
        i = 0
        WhileLoop LessThan(i, count) {
            child = AST_GetChild(root, i)
            IfCondition EqualTo(child, target) ThenBlock: {
                IfCondition GreaterThan(i, 0) ThenBlock: {
                    ReturnValue(AST_GetChild(root, Subtract(i, 1)))
                }
                ReturnValue(0)
            }
            found = Optimize_PrevSibling(child, target)
            IfCondition NotEqual(found, 0) ThenBlock: { ReturnValue(found) }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

// name = name + positive constant, either add order. The constant, or 0.
Function.Optimize_StepConst {
    Input: stmt: Address
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(Optimize_PlainAssign(stmt), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_NameEq(AST_GetData1(stmt), name), 0) ThenBlock: { ReturnValue(0) }
        val = AST_GetChild(stmt, 0)
        IfCondition EqualTo(val, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(val), AST.CALL) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(StringCompare(AST_GetData1(val), "Add"), 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetChildCount(val), 2) ThenBlock: { ReturnValue(0) }
        a0 = AST_GetChild(val, 0)
        a1 = AST_GetChild(val, 1)
        num = 0
        hit = 0
        IfCondition EqualTo(Optimize_IdentEq(a0, name), 1) ThenBlock: {
            IfCondition EqualTo(AST_GetType(a1), AST.NUMBER) ThenBlock: {
                num = StringToNumber(AST_GetData1(a1))
                hit = 1
            }
        }
        IfCondition EqualTo(hit, 0) ThenBlock: {
            IfCondition EqualTo(Optimize_IdentEq(a1, name), 1) ThenBlock: {
                IfCondition EqualTo(AST_GetType(a0), AST.NUMBER) ThenBlock: {
                    num = StringToNumber(AST_GetData1(a0))
                    hit = 1
                }
            }
        }
        IfCondition EqualTo(hit, 0) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(num, 1) ThenBlock: { ReturnValue(0) }
        ReturnValue(num)
    }
}

// A qword deref of the index name through one frame-local base.
Function.Optimize_RepeatDeref {
    Input: node: Address
    Input: index_name: Address
    Input: outer_name: Address
    Input: acc_name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(Optimize_QwordScale(node), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_IdentEq(Optimize_QwordIndex(node), index_name), 0) ThenBlock: {
            ReturnValue(0)
        }
        base = Optimize_QwordBase(node)
        IfCondition EqualTo(base, 0) ThenBlock: { ReturnValue(0) }
        bname = AST_GetData1(base)
        IfCondition EqualTo(Optimize_NameEq(bname, index_name), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_NameEq(bname, outer_name), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_NameEq(bname, acc_name), 1) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterThan(Optimize_CountIdents(node, outer_name), 0) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterThan(Optimize_CountIdents(node, acc_name), 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(Optimize_FrameOff(bname))
    }
}

// acc = acc +/- scaled deref of the inner cursor. The load ignores the
// outer cursor, so each outer trip adds the same qword.
Function.Optimize_RepeatAdd {
    Input: stmt: Address
    Input: index_name: Address
    Input: outer_name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(Optimize_PlainAssign(stmt), 0) ThenBlock: { ReturnValue(0) }
        acc = AST_GetData1(stmt)
        IfCondition EqualTo(Optimize_NameEq(acc, index_name), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_NameEq(acc, outer_name), 1) ThenBlock: { ReturnValue(0) }
        val = AST_GetChild(stmt, 0)
        IfCondition EqualTo(val, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(val), AST.CALL) ThenBlock: { ReturnValue(0) }
        opname = AST_GetData1(val)
        is_add = EqualTo(StringCompare(opname, "Add"), 0)
        is_sub = EqualTo(StringCompare(opname, "Subtract"), 0)
        IfCondition EqualTo(is_add, 0) ThenBlock: {
            IfCondition EqualTo(is_sub, 0) ThenBlock: { ReturnValue(0) }
        }
        IfCondition NotEqual(AST_GetChildCount(val), 2) ThenBlock: { ReturnValue(0) }
        a0 = AST_GetChild(val, 0)
        a1 = AST_GetChild(val, 1)
        left_acc = 0
        right_acc = 0
        IfCondition EqualTo(Optimize_IdentEq(a0, acc), 1) ThenBlock: { left_acc = 1 }
        IfCondition EqualTo(Optimize_IdentEq(a1, acc), 1) ThenBlock: { right_acc = 1 }
        other = 0
        IfCondition EqualTo(is_add, 1) ThenBlock: {
            IfCondition EqualTo(left_acc, 1) ThenBlock: {
                IfCondition EqualTo(right_acc, 0) ThenBlock: { other = a1 }
            }
            IfCondition EqualTo(right_acc, 1) ThenBlock: {
                IfCondition EqualTo(left_acc, 0) ThenBlock: { other = a0 }
            }
        }
        IfCondition EqualTo(is_sub, 1) ThenBlock: {
            IfCondition EqualTo(left_acc, 1) ThenBlock: {
                IfCondition EqualTo(right_acc, 0) ThenBlock: { other = a1 }
            }
        }
        IfCondition EqualTo(other, 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(Optimize_RepeatDeref(other, index_name, outer_name, acc))
    }
}

// An outer counted loop whose only effect is to repeat an inner reduction.
// The load does not mention the outer cursor and the body does not store,
// so one pass scaled by the trip count is the same integer sum. The outer
// cursor is left equal to the limit. Returns 1 when that loop was emitted.
Function.Optimize_TryRepeatSum {
    Input: node: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(LoopHome.active, 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(node), AST.WHILE) ThenBlock: { ReturnValue(0) }
        cond = AST_GetChild(node, 0)
        body = AST_GetChild(node, 1)
        IfCondition EqualTo(cond, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(cond), AST.CALL) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(StringCompare(AST_GetData1(cond), "LessThan"), 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetChildCount(cond), 2) ThenBlock: { ReturnValue(0) }
        cleft = AST_GetChild(cond, 0)
        cright = AST_GetChild(cond, 1)
        IfCondition NotEqual(AST_GetType(cleft), AST.IDENTIFIER) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(cright), AST.NUMBER) ThenBlock: { ReturnValue(0) }
        oname = AST_GetData1(cleft)
        limit = StringToNumber(AST_GetData1(cright))
        prev = Optimize_PrevSibling(Compile.current_func, node)
        IfCondition EqualTo(Optimize_PlainAssign(prev), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_NameEq(AST_GetData1(prev), oname), 0) ThenBlock: { ReturnValue(0) }
        pval = AST_GetChild(prev, 0)
        IfCondition EqualTo(pval, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(pval), AST.NUMBER) ThenBlock: { ReturnValue(0) }
        start = StringToNumber(AST_GetData1(pval))
        IfCondition LessThan(start, 0) ThenBlock: { ReturnValue(0) }
        IfCondition LessEqual(limit, start) ThenBlock: { ReturnValue(0) }
        trip = Subtract(limit, start)
        IfCondition LessThan(trip, 2) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_Fit32(trip), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(body, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(body), AST.BLOCK) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetChildCount(body), 3) ThenBlock: { ReturnValue(0) }
        reset = AST_GetChild(body, 0)
        inner = AST_GetChild(body, 1)
        bump = AST_GetChild(body, 2)
        IfCondition EqualTo(Optimize_PlainAssign(reset), 0) ThenBlock: { ReturnValue(0) }
        iname = AST_GetData1(reset)
        IfCondition EqualTo(Optimize_NameEq(iname, oname), 1) ThenBlock: { ReturnValue(0) }
        rval = AST_GetChild(reset, 0)
        IfCondition EqualTo(rval, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(rval), AST.NUMBER) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterThan(Optimize_CountIdents(reset, oname), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(inner, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(inner), AST.WHILE) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterThan(Optimize_CountIdents(inner, oname), 0) ThenBlock: { ReturnValue(0) }
        icond = AST_GetChild(inner, 0)
        ibody = AST_GetChild(inner, 1)
        IfCondition EqualTo(icond, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(icond), AST.CALL) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(StringCompare(AST_GetData1(icond), "LessThan"), 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetChildCount(icond), 2) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_IdentEq(AST_GetChild(icond, 0), iname), 0) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterThan(Optimize_CountIdents(AST_GetChild(icond, 1), iname), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(ibody, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(ibody), AST.BLOCK) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetChildCount(ibody), 2) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_RepeatAdd(AST_GetChild(ibody, 0), iname, oname), 0) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition EqualTo(Optimize_StepConst(AST_GetChild(ibody, 1), iname), 0) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition NotEqual(Optimize_StepConst(bump, oname), 1) ThenBlock: { ReturnValue(0) }
        Compile_Node(reset)
        IfCondition EqualTo(Compile.error, 1) ThenBlock: { ReturnValue(1) }
        OptState.repeat_n = trip
        OptState.repeat_hit = 0
        CompileStmt_While(inner)
        OptState.repeat_n = 0
        IfCondition EqualTo(OptState.repeat_hit, 0) ThenBlock: {
            Compile.error = 1
            ReturnValue(1)
        }
        Emit_MovRaxImm64(limit)
        stored = CompileExpr_StoreVariable(oname)
        IfCondition EqualTo(stored, 0) ThenBlock: {
            Compile.error = 1
            ReturnValue(1)
        }
        ReturnValue(1)
    }
}
