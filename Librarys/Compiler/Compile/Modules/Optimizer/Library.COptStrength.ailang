// Library.COptStrength.ailang
// Induction variables, products, and induction pointers.
// Loaded by the optimizer shell. No imports of its own.

// 1: float operand. 2: integer operand. 0: not a value we can park.
Function.Optimize_InvCtx {
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(StringCompare(name, "Float_Add"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "Float_Sub"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "Float_Mul"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "Float_Div"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "Float_Neg"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "Float_Abs"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "Float_Sqrt"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "Float_ToInt"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "Float_FromInt"), 0) ThenBlock: { ReturnValue(2) }
        IfCondition EqualTo(StringCompare(name, "Float_Eq"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "Float_Ne"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "Float_Lt"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "Float_Gt"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "Float_Le"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "Float_Ge"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "Add"), 0) ThenBlock: { ReturnValue(2) }
        IfCondition EqualTo(StringCompare(name, "Subtract"), 0) ThenBlock: { ReturnValue(2) }
        IfCondition EqualTo(StringCompare(name, "Multiply"), 0) ThenBlock: { ReturnValue(2) }
        IfCondition EqualTo(StringCompare(name, "Divide"), 0) ThenBlock: { ReturnValue(2) }
        IfCondition EqualTo(StringCompare(name, "Modulo"), 0) ThenBlock: { ReturnValue(2) }
        IfCondition EqualTo(StringCompare(name, "Negate"), 0) ThenBlock: { ReturnValue(2) }
        IfCondition EqualTo(StringCompare(name, "Dereference"), 0) ThenBlock: { ReturnValue(2) }
        IfCondition EqualTo(StringCompare(name, "EqualTo"), 0) ThenBlock: { ReturnValue(2) }
        IfCondition EqualTo(StringCompare(name, "NotEqual"), 0) ThenBlock: { ReturnValue(2) }
        IfCondition EqualTo(StringCompare(name, "LessThan"), 0) ThenBlock: { ReturnValue(2) }
        IfCondition EqualTo(StringCompare(name, "GreaterThan"), 0) ThenBlock: { ReturnValue(2) }
        IfCondition EqualTo(StringCompare(name, "LessEqual"), 0) ThenBlock: { ReturnValue(2) }
        IfCondition EqualTo(StringCompare(name, "GreaterEqual"), 0) ThenBlock: { ReturnValue(2) }
        IfCondition EqualTo(StringCompare(name, "BitwiseAnd"), 0) ThenBlock: { ReturnValue(2) }
        IfCondition EqualTo(StringCompare(name, "BitwiseOr"), 0) ThenBlock: { ReturnValue(2) }
        IfCondition EqualTo(StringCompare(name, "BitwiseXor"), 0) ThenBlock: { ReturnValue(2) }
        IfCondition EqualTo(StringCompare(name, "BitwiseNot"), 0) ThenBlock: { ReturnValue(2) }
        IfCondition EqualTo(StringCompare(name, "LeftShift"), 0) ThenBlock: { ReturnValue(2) }
        IfCondition EqualTo(StringCompare(name, "RightShift"), 0) ThenBlock: { ReturnValue(2) }
        IfCondition EqualTo(StringCompare(name, "BitAnd"), 0) ThenBlock: { ReturnValue(2) }
        IfCondition EqualTo(StringCompare(name, "BitOr"), 0) ThenBlock: { ReturnValue(2) }
        IfCondition EqualTo(StringCompare(name, "BitXor"), 0) ThenBlock: { ReturnValue(2) }
        IfCondition EqualTo(StringCompare(name, "BitNot"), 0) ThenBlock: { ReturnValue(2) }
        IfCondition EqualTo(StringCompare(name, "ShiftLeft"), 0) ThenBlock: { ReturnValue(2) }
        IfCondition EqualTo(StringCompare(name, "ShiftRight"), 0) ThenBlock: { ReturnValue(2) }
        ReturnValue(0)
    }
}

Function.Optimize_InvWalk {
    Input: node: Address
    Input: name: Address
    Input: ctx: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(LoopHome.hit_class, 9) ThenBlock: { ReturnValue(0) }
        nt = AST_GetType(node)
        IfCondition EqualTo(nt, AST.IDENTIFIER) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(AST_GetData1(node), name), 1) ThenBlock: {
                IfCondition EqualTo(ctx, 1) ThenBlock: {
                    IfCondition EqualTo(LoopHome.hit_class, 2) ThenBlock: { LoopHome.hit_class = 9 }
                    IfCondition EqualTo(LoopHome.hit_class, 0) ThenBlock: { LoopHome.hit_class = 1 }
                }
                IfCondition EqualTo(ctx, 2) ThenBlock: {
                    IfCondition EqualTo(LoopHome.hit_class, 1) ThenBlock: { LoopHome.hit_class = 9 }
                    IfCondition EqualTo(LoopHome.hit_class, 0) ThenBlock: { LoopHome.hit_class = 2 }
                }
                IfCondition EqualTo(ctx, 0) ThenBlock: { LoopHome.hit_class = 9 }
            }
            ReturnValue(0)
        }
        next = ctx
        IfCondition EqualTo(nt, AST.CALL) ThenBlock: { next = Optimize_InvCtx(AST_GetData1(node)) }
        count = AST_GetChildCount(node)
        i = 0
        WhileLoop LessThan(i, count) {
            Optimize_InvWalk(AST_GetChild(node, i), name, next)
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

Function.Optimize_InvOk {
    Input: name: Address
    Input: kind: Integer
    Input: condition: Address
    Input: body: Address
    Output: Integer
    Body: {
        LoopHome.hit_class = 0
        Optimize_InvWalk(condition, name, 0)
        Optimize_InvWalk(body, name, 0)
        IfCondition EqualTo(LoopHome.hit_class, kind) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

Function.Optimize_FrameOff {
    Input: name: Address
    Output: Integer
    Body: {
        LoopHome.imm_ok = 0
        off = Scope_Resolve(name)
        rt = Scope.resolve_type
        ok = 0
        IfCondition EqualTo(rt, 1) ThenBlock: { ok = 1 }
        IfCondition EqualTo(rt, 2) ThenBlock: { ok = 1 }
        IfCondition GreaterEqual(off, 0) ThenBlock: { ok = 0 }
        IfCondition EqualTo(ok, 1) ThenBlock: {
            LoopHome.imm_ok = 1
            LoopHome.imm_val = off
        }
        ReturnValue(LoopHome.imm_ok)
    }
}

// The cursor's one update is name = name + positive constant.
// iv_step stays 0 when the body is not that shape.
Function.Optimize_FindStep {
    Input: body: Address
    Output: Integer
    Body: {
        LoopHome.iv_step = 0
        LoopHome.iv_at = -1
        IfCondition EqualTo(body, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(body), AST.BLOCK) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(LoopHome.int_name, 0) ThenBlock: { ReturnValue(0) }
        count = AST_GetChildCount(body)
        found = 0
        i = 0
        WhileLoop LessThan(i, count) {
            st = AST_GetChild(body, i)
            IfCondition EqualTo(Optimize_PlainAssign(st), 1) ThenBlock: {
                IfCondition EqualTo(Optimize_NameEq(AST_GetData1(st), LoopHome.int_name), 1) ThenBlock: {
                    IfCondition EqualTo(found, 1) ThenBlock: {
                        LoopHome.iv_step = 0
                        ReturnValue(0)
                    }
                    val = AST_GetChild(st, 0)
                    ok = 0
                    step = 0
                    IfCondition NotEqual(val, 0) ThenBlock: {
                        IfCondition EqualTo(AST_GetType(val), AST.CALL) ThenBlock: {
                            IfCondition EqualTo(StringCompare(AST_GetData1(val), "Add"), 0) ThenBlock: {
                                IfCondition EqualTo(AST_GetChildCount(val), 2) ThenBlock: {
                                    a0 = AST_GetChild(val, 0)
                                    a1 = AST_GetChild(val, 1)
                                    num = 0
                                    idn = 0
                                    IfCondition EqualTo(AST_GetType(a1), AST.NUMBER) ThenBlock: {
                                        IfCondition EqualTo(Optimize_NameIs(a0, LoopHome.int_name), 1) ThenBlock: {
                                            num = a1
                                            idn = 1
                                        }
                                    }
                                    IfCondition EqualTo(idn, 0) ThenBlock: {
                                        IfCondition EqualTo(AST_GetType(a0), AST.NUMBER) ThenBlock: {
                                            IfCondition EqualTo(Optimize_NameIs(a1, LoopHome.int_name), 1) ThenBlock: {
                                                num = a0
                                                idn = 1
                                            }
                                        }
                                    }
                                    IfCondition EqualTo(idn, 1) ThenBlock: {
                                        step = StringToNumber(AST_GetData1(num))
                                        IfCondition GreaterThan(step, 0) ThenBlock: { ok = 1 }
                                    }
                                }
                            }
                        }
                    }
                    IfCondition EqualTo(ok, 0) ThenBlock: {
                        LoopHome.iv_step = 0
                        ReturnValue(0)
                    }
                    LoopHome.iv_step = step
                    LoopHome.iv_at = i
                    found = 1
                }
            }
            i = Add(i, 1)
        }
        IfCondition EqualTo(found, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(Optimize_AssignCount(body, LoopHome.int_name), 1) ThenBlock: {
            LoopHome.iv_step = 0
            LoopHome.iv_at = -1
            ReturnValue(0)
        }
        ReturnValue(1)
    }
}

// The statement immediately before this loop assigns the cursor a
// non-negative constant. That is the value the body sees on entry.
Function.Optimize_InitAssign {
    Input: node: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(Optimize_PlainAssign(node), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_NameEq(AST_GetData1(node), LoopHome.int_name), 0) ThenBlock: { ReturnValue(0) }
        val = AST_GetChild(node, 0)
        IfCondition EqualTo(val, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(val), AST.NUMBER) ThenBlock: { ReturnValue(0) }
        n = StringToNumber(AST_GetData1(val))
        IfCondition LessThan(n, 0) ThenBlock: { ReturnValue(0) }
        LoopHome.iv_lo = n
        ReturnValue(1)
    }
}

// The loop may sit in a function body block or directly under a
// subroutine. Either way the initializer is the previous sibling.
Function.Optimize_SeekInit {
    Input: node: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        count = AST_GetChildCount(node)
        i = 0
        WhileLoop LessThan(i, count) {
            child = AST_GetChild(node, i)
            hit = 0
            IfCondition NotEqual(child, 0) ThenBlock: {
                IfCondition EqualTo(AST_GetType(child), AST.WHILE) ThenBlock: {
                    IfCondition EqualTo(AST_GetChild(child, 1), LoopHome.body) ThenBlock: { hit = 1 }
                }
            }
            IfCondition EqualTo(hit, 1) ThenBlock: {
                IfCondition GreaterThan(i, 0) ThenBlock: {
                    prev = AST_GetChild(node, Subtract(i, 1))
                    ReturnValue(Optimize_InitAssign(prev))
                }
                ReturnValue(0)
            }
            IfCondition EqualTo(Optimize_SeekInit(child), 1) ThenBlock: { ReturnValue(1) }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

// LessThan(cursor, bound) or GreaterThan(bound, cursor).
// Step 1 against an unknown bound stays in [init, 2^63-2].
// A bigger step needs a constant bound that cannot wrap past the test.
Function.Optimize_NoteBound {
    Input: condition: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(condition, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(condition), AST.CALL) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetChildCount(condition), 2) ThenBlock: { ReturnValue(0) }
        cname = AST_GetData1(condition)
        left = AST_GetChild(condition, 0)
        right = AST_GetChild(condition, 1)
        bound = 0
        IfCondition EqualTo(StringCompare(cname, "LessThan"), 0) ThenBlock: {
            IfCondition EqualTo(Optimize_NameIs(left, LoopHome.int_name), 0) ThenBlock: { ReturnValue(0) }
            bound = right
        }
        IfCondition EqualTo(StringCompare(cname, "GreaterThan"), 0) ThenBlock: {
            IfCondition EqualTo(Optimize_NameIs(right, LoopHome.int_name), 0) ThenBlock: { ReturnValue(0) }
            bound = left
        }
        IfCondition EqualTo(bound, 0) ThenBlock: { ReturnValue(0) }
        maxv = 9223372036854775807
        IfCondition EqualTo(AST_GetType(bound), AST.NUMBER) ThenBlock: {
            b = StringToNumber(AST_GetData1(bound))
            IfCondition LessEqual(b, LoopHome.iv_lo) ThenBlock: { ReturnValue(0) }
            hi = Subtract(b, 1)
            room = Subtract(maxv, hi)
            IfCondition GreaterThan(LoopHome.iv_step, room) ThenBlock: { ReturnValue(0) }
            LoopHome.iv_hi = hi
            ReturnValue(1)
        }
        // One straight-line constant assignment is the same bound. A
        // failed bind keeps the step-1 range below, and a larger step
        // stays unproved.
        IfCondition EqualTo(AST_GetType(bound), AST.IDENTIFIER) ThenBlock: {
            got = Optimize_BindConst(AST_GetData1(bound), condition)
            IfCondition EqualTo(got, 1) ThenBlock: {
                cb = OptState.bind_val
                IfCondition LessEqual(cb, LoopHome.iv_lo) ThenBlock: { ReturnValue(0) }
                hi = Subtract(cb, 1)
                room = Subtract(maxv, hi)
                IfCondition GreaterThan(LoopHome.iv_step, room) ThenBlock: { ReturnValue(0) }
                LoopHome.iv_hi = hi
                ReturnValue(1)
            }
        }
        IfCondition NotEqual(LoopHome.iv_step, 1) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterThan(LoopHome.iv_lo, Subtract(maxv, 1)) ThenBlock: { ReturnValue(0) }
        LoopHome.iv_hi = Subtract(maxv, 1)
        ReturnValue(1)
    }
}

Function.Optimize_NoteIv {
    Input: condition: Address
    Input: body: Address
    Output: Integer
    Body: {
        LoopHome.iv_nn = 0
        IfCondition EqualTo(LoopHome.has_call, 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(LoopHome.int_name, 0) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(LoopHome.iv_step, 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_TreeHasAsm(body), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_TreeHasAsm(condition), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Compile.current_func, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_SeekInit(Compile.current_func), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_NoteBound(condition), 0) ThenBlock: { ReturnValue(0) }
        LoopHome.iv_nn = 1
        ReturnValue(1)
    }
}

// Uses of the derived name must see the value assigned this iteration,
// which is before the cursor update. A use after that update still has
// the old sum, so the running register would be wrong.
Function.Optimize_DerUsesOk {
    Input: body: Address
    Input: name: Address
    Input: def_at: Integer
    Input: upd_at: Integer
    Output: Integer
    Body: {
        count = AST_GetChildCount(body)
        k = 0
        WhileLoop LessThan(k, count) {
            st = AST_GetChild(body, k)
            n = Optimize_CountIdents(st, name)
            IfCondition LessThan(k, def_at) ThenBlock: {
                IfCondition GreaterThan(n, 0) ThenBlock: { ReturnValue(0) }
            }
            IfCondition EqualTo(k, def_at) ThenBlock: {
                IfCondition GreaterThan(n, 0) ThenBlock: { ReturnValue(0) }
            }
            IfCondition GreaterThan(k, upd_at) ThenBlock: {
                IfCondition GreaterThan(n, 0) ThenBlock: { ReturnValue(0) }
            }
            IfCondition EqualTo(k, upd_at) ThenBlock: {
                IfCondition GreaterThan(n, 0) ThenBlock: { ReturnValue(0) }
            }
            k = Add(k, 1)
        }
        ReturnValue(1)
    }
}

// One direct `name = inv + cursor` whose other reads all sit between
// that assignment and the cursor's step. Nothing outside the loop reads it.
Function.Optimize_DerivedTry {
    Input: st: Address
    Input: body: Address
    Input: def_at: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(Optimize_PlainAssign(st), 0) ThenBlock: { ReturnValue(0) }
        target = AST_GetData1(st)
        IfCondition EqualTo(Optimize_NameEq(target, LoopHome.int_name), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_NameTaken(target), 1) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterEqual(def_at, LoopHome.iv_at) ThenBlock: { ReturnValue(0) }
        val = AST_GetChild(st, 0)
        IfCondition EqualTo(val, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(val), AST.CALL) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(StringCompare(AST_GetData1(val), "Add"), 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetChildCount(val), 2) ThenBlock: { ReturnValue(0) }
        a0 = AST_GetChild(val, 0)
        a1 = AST_GetChild(val, 1)
        other = 0
        IfCondition EqualTo(Optimize_NameIs(a0, LoopHome.int_name), 1) ThenBlock: {
            IfCondition EqualTo(Optimize_IsBase(a1), 1) ThenBlock: {
                IfCondition EqualTo(Optimize_NameIs(a1, LoopHome.int_name), 0) ThenBlock: { other = a1 }
            }
        }
        IfCondition EqualTo(other, 0) ThenBlock: {
            IfCondition EqualTo(Optimize_NameIs(a1, LoopHome.int_name), 1) ThenBlock: {
                IfCondition EqualTo(Optimize_IsBase(a0), 1) ThenBlock: {
                    IfCondition EqualTo(Optimize_NameIs(a0, LoopHome.int_name), 0) ThenBlock: { other = a0 }
                }
            }
        }
        IfCondition EqualTo(other, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_Fit32(LoopHome.iv_step), 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(Optimize_AssignCount(body, target), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_DerUsesOk(body, target, def_at, LoopHome.iv_at), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Compile.current_func, 0) ThenBlock: { ReturnValue(0) }
        block_n = Optimize_Mentions(body, target)
        func_n = Optimize_Mentions(Compile.current_func, target)
        IfCondition NotEqual(block_n, func_n) ThenBlock: { ReturnValue(0) }
        via = 0
        konst = 0
        off = 0
        IfCondition EqualTo(AST_GetType(other), AST.NUMBER) ThenBlock: {
            via = 1
            konst = StringToNumber(AST_GetData1(other))
        } ElseBlock: {
            oname = AST_GetData1(other)
            IfCondition EqualTo(Optimize_NameEq(oname, target), 1) ThenBlock: { ReturnValue(0) }
            IfCondition NotEqual(Optimize_AssignCount(body, oname), 0) ThenBlock: { ReturnValue(0) }
            IfCondition EqualTo(Optimize_NameEq(oname, LoopHome.acc_name), 1) ThenBlock: {
                via = 2
            } ElseBlock: {
                IfCondition EqualTo(Optimize_FrameOff(oname), 0) ThenBlock: { ReturnValue(0) }
                via = 3
                off = LoopHome.imm_val
            }
        }
        IfCondition EqualTo(via, 0) ThenBlock: { ReturnValue(0) }
        LoopHome.der_name = target
        LoopHome.der_via = via
        LoopHome.der_const = konst
        LoopHome.der_off = off
        LoopHome.der_step = LoopHome.iv_step
        LoopHome.der_on = 1
        ReturnValue(1)
    }
}

// ij = inv + j becomes a register that starts at inv+j and steps with j.
// r11 is free only when this loop has no call. The compare stays j < n.
Function.Optimize_PickDerived {
    Input: body: Address
    Output: Integer
    Body: {
        LoopHome.der_on = 0
        IfCondition EqualTo(LoopHome.has_call, 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(LoopHome.int_name, 0) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(LoopHome.iv_step, 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_TreeHasAsm(body), 1) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(body), AST.BLOCK) ThenBlock: { ReturnValue(0) }
        count = AST_GetChildCount(body)
        i = 0
        WhileLoop LessThan(i, count) {
            IfCondition EqualTo(Optimize_DerivedTry(AST_GetChild(body, i), body, i), 1) ThenBlock: {
                ReturnValue(1)
            }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

Function.Optimize_EmitDerived {
    Body: {
        IfCondition EqualTo(LoopHome.der_via, 1) ThenBlock: {
            Emit_MovRaxImm64(LoopHome.der_const)
        }
        IfCondition EqualTo(LoopHome.der_via, 2) ThenBlock: {
            Emit_MovRaxR12()
        }
        IfCondition EqualTo(LoopHome.der_via, 3) ThenBlock: {
            Emit_MovRaxRbpOffset(LoopHome.der_off)
        }
        Emit_AddRaxR13()
        X86Enc_Assemble("MOV r11, rax")
    }
}

// (i + step) * c wraps the same as i * c + step * c. One non-power-of-two
// constant factor of the integer home stays in r11. r11 is free only when
// the derived sum and the induction pointers are not using it, and the
// loop has no call. Power-of-two factors stay shifts. An and-with-1
// product stays the low-bit test, so that whole subtree is left alone.

Function.Optimize_ProdConst {
    Input: node: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        nt = AST_GetType(node)
        val = 0
        ok = 0
        IfCondition EqualTo(nt, AST.NUMBER) ThenBlock: {
            val = StringToNumber(AST_GetData1(node))
            ok = 1
        }
        IfCondition EqualTo(nt, AST.IDENTIFIER) ThenBlock: {
            got = Optimize_BindConst(AST_GetData1(node), node)
            IfCondition EqualTo(got, 1) ThenBlock: {
                val = OptState.bind_val
                ok = 1
            }
        }
        IfCondition EqualTo(ok, 0) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterThan(val, 0) ThenBlock: {
            IfCondition EqualTo(Optimize_IsPow2(val), 1) ThenBlock: { ReturnValue(0) }
        }
        LoopHome.prod_tmp = val
        ReturnValue(1)
    }
}

Function.Optimize_ProdTake {
    Input: node: Address
    Output: Integer
    Body: {
        IfCondition NotEqual(AST_GetChildCount(node), 2) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(LoopHome.prod_bad, 1) ThenBlock: { ReturnValue(0) }
        a0 = AST_GetChild(node, 0)
        a1 = AST_GetChild(node, 1)
        hit = 0
        IfCondition EqualTo(Optimize_NameIs(a0, LoopHome.int_name), 1) ThenBlock: {
            IfCondition EqualTo(Optimize_ProdConst(a1), 1) ThenBlock: { hit = 1 }
        }
        IfCondition EqualTo(hit, 0) ThenBlock: {
            IfCondition EqualTo(Optimize_NameIs(a1, LoopHome.int_name), 1) ThenBlock: {
                IfCondition EqualTo(Optimize_ProdConst(a0), 1) ThenBlock: { hit = 1 }
            }
        }
        IfCondition EqualTo(hit, 0) ThenBlock: { ReturnValue(0) }
        val = LoopHome.prod_tmp
        IfCondition EqualTo(LoopHome.prod_seen, 0) ThenBlock: {
            LoopHome.prod_c = val
            LoopHome.prod_seen = 1
            ReturnValue(1)
        }
        IfCondition NotEqual(val, LoopHome.prod_c) ThenBlock: { LoopHome.prod_bad = 1 }
        ReturnValue(1)
    }
}

Function.Optimize_ProdWalk {
    Input: node: Address
    Input: mute: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(LoopHome.prod_bad, 1) ThenBlock: { ReturnValue(0) }
        nt = AST_GetType(node)
        IfCondition EqualTo(nt, AST.CALL) ThenBlock: {
            cname = AST_GetData1(node)
            IfCondition EqualTo(mute, 0) ThenBlock: {
                IfCondition EqualTo(StringCompare(cname, "Multiply"), 0) ThenBlock: {
                    Optimize_ProdTake(node)
                }
            }
            IfCondition EqualTo(Optimize_IsAndName(cname), 1) ThenBlock: {
                IfCondition EqualTo(AST_GetChildCount(node), 2) ThenBlock: {
                    b0 = AST_GetChild(node, 0)
                    b1 = AST_GetChild(node, 1)
                    inner = 0
                    IfCondition EqualTo(Optimize_IsOneNum(b1), 1) ThenBlock: { inner = b0 }
                    IfCondition EqualTo(inner, 0) ThenBlock: {
                        IfCondition EqualTo(Optimize_IsOneNum(b0), 1) ThenBlock: { inner = b1 }
                    }
                    IfCondition NotEqual(inner, 0) ThenBlock: {
                        Optimize_ProdWalk(inner, 1)
                        ReturnValue(0)
                    }
                }
            }
        }
        count = AST_GetChildCount(node)
        i = 0
        WhileLoop LessThan(i, count) {
            Optimize_ProdWalk(AST_GetChild(node, i), mute)
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

Function.Optimize_NoteProd {
    Output: Integer
    Body: {
        LoopHome.prod_on = 0
        LoopHome.prod_c = 0
        LoopHome.prod_delta = 0
        LoopHome.prod_bad = 0
        LoopHome.prod_seen = 0
        LoopHome.prod_tmp = 0
        IfCondition EqualTo(LoopHome.has_call, 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(LoopHome.int_name, 0) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(LoopHome.iv_step, 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_Fit32(LoopHome.iv_step), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(LoopHome.der_on, 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(LoopHome.ip0_on, 1) ThenBlock: {
            IfCondition EqualTo(LoopHome.ip0_reg, 11) ThenBlock: { ReturnValue(0) }
        }
        IfCondition EqualTo(LoopHome.ip1_on, 1) ThenBlock: {
            IfCondition EqualTo(LoopHome.ip1_reg, 11) ThenBlock: { ReturnValue(0) }
        }
        IfCondition EqualTo(Optimize_TreeHasAsm(LoopHome.body), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_TreeHasAsm(LoopHome.cond), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_LiveIn(LoopHome.int_name, LoopHome.cond, LoopHome.body), 0) ThenBlock: {
            ReturnValue(0)
        }
        Optimize_ProdWalk(LoopHome.body, 0)
        Optimize_ProdWalk(LoopHome.cond, 0)
        IfCondition EqualTo(LoopHome.prod_bad, 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(LoopHome.prod_seen, 0) ThenBlock: { ReturnValue(0) }
        LoopHome.prod_delta = Multiply(LoopHome.iv_step, LoopHome.prod_c)
        LoopHome.prod_on = 1
        ReturnValue(1)
    }
}

Function.Optimize_EmitProd {
    Output: Integer
    Body: {
        IfCondition EqualTo(LoopHome.prod_on, 0) ThenBlock: { ReturnValue(0) }
        Emit_MovRaxR13()
        IfCondition EqualTo(Optimize_Fit32(LoopHome.prod_c), 1) ThenBlock: {
            X86_ImulRaxImm32(LoopHome.prod_c)
        } ElseBlock: {
            Emit_PushRbx()
            Emit_MovRbxImm64(LoopHome.prod_c)
            Emit_ImulRaxRbx()
            Emit_PopRbx()
        }
        X86Enc_Assemble("MOV r11, rax")
        ReturnValue(1)
    }
}

Function.Optimize_EmitProdBump {
    Output: Integer
    Body: {
        IfCondition EqualTo(Optimize_Fit32(LoopHome.prod_delta), 1) ThenBlock: {
            X86_AddIpImm(11, LoopHome.prod_delta)
            ReturnValue(1)
        }
        Emit_MovRaxImm64(LoopHome.prod_delta)
        X86_AddRegReg(11, 0)
        ReturnValue(1)
    }
}

Function.Optimize_TryProdUse {
    Input: left: Address
    Input: right: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(LoopHome.active, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(LoopHome.prod_on, 0) ThenBlock: { ReturnValue(0) }
        hit = 0
        IfCondition EqualTo(Optimize_NameIs(left, LoopHome.int_name), 1) ThenBlock: {
            IfCondition EqualTo(Optimize_ProdConst(right), 1) ThenBlock: { hit = 1 }
        }
        IfCondition EqualTo(hit, 0) ThenBlock: {
            IfCondition EqualTo(Optimize_NameIs(right, LoopHome.int_name), 1) ThenBlock: {
                IfCondition EqualTo(Optimize_ProdConst(left), 1) ThenBlock: { hit = 1 }
            }
        }
        IfCondition EqualTo(hit, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(LoopHome.prod_tmp, LoopHome.prod_c) ThenBlock: { ReturnValue(0) }
        X86Enc_Assemble("MOV rax, r11")
        ReturnValue(1)
    }
}

Function.Optimize_TryDerivedDef {
    Input: target_name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(LoopHome.der_on, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_NameEq(target_name, LoopHome.der_name), 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(1)
    }
}

// An address base + (inv + cursor*coeff)*scale becomes a register that
// starts at that byte address and adds coeff*scale*step when the cursor
// steps. A second address with the same base, coeff, and scale is a
// displacement off that register. r11 is used when the derived sum is
// off. r14 is used when no table home owns it. Both are installed only
// when every dereference in the body joins a pointer, so a leftover
// scaled load cannot overwrite r14. A name read once is movsd from that
// register at the multiply. A name read again before the pointer steps
// stays in a free xmm and is copied into xmm0 or xmm1. Hw.level < 2
// leaves the integer path.

Function.Optimize_IpClear {
    Body: {
        LoopHome.ip0_on = 0
        LoopHome.ip1_on = 0
        LoopHome.ip0_mode = 0
        LoopHome.ip0_rhs = 0
        LoopHome.ip0_aname = 0
        LoopHome.ip1_mode = 0
        LoopHome.ip1_rhs = 0
        LoopHome.ip1_aname = 0
        LoopHome.n0_on = 0
        LoopHome.n1_on = 0
        LoopHome.n2_on = 0
        LoopHome.n3_on = 0
        LoopHome.d0_on = 0
        LoopHome.d1_on = 0
        LoopHome.d2_on = 0
        LoopHome.d3_on = 0
        LoopHome.ip_count = 0
    }
}

Function.Optimize_IpNum {
    Input: node: Address
    Output: Integer
    Body: {
        LoopHome.ip_num_ok = 0
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(node), AST.NUMBER) ThenBlock: { ReturnValue(0) }
        LoopHome.ip_num = StringToNumber(AST_GetData1(node))
        LoopHome.ip_num_ok = 1
        ReturnValue(1)
    }
}

Function.Optimize_IpScaleOk {
    Input: n: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(n, 1) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(n, 2) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(n, 4) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(n, 8) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

Function.Optimize_IpLog {
    Input: n: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(n, 1) ThenBlock: { ReturnValue(0) }
        l = 0
        v = n
        WhileLoop GreaterThan(v, 1) {
            IfCondition EqualTo(BitwiseAnd(v, 1), 1) ThenBlock: { ReturnValue(0) }
            v = Divide(v, 2)
            l = Add(l, 1)
        }
        LoopHome.ip_log = l
        ReturnValue(1)
    }
}

Function.Optimize_IpExprEq {
    Input: a: Address
    Input: b: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(a, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(b, 0) ThenBlock: { ReturnValue(0) }
        ta = AST_GetType(a)
        tb = AST_GetType(b)
        IfCondition NotEqual(ta, tb) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(ta, AST.NUMBER) ThenBlock: {
            IfCondition EqualTo(StringCompare(AST_GetData1(a), AST_GetData1(b)), 0) ThenBlock: { ReturnValue(1) }
            ReturnValue(0)
        }
        IfCondition EqualTo(ta, AST.IDENTIFIER) ThenBlock: {
            ReturnValue(Optimize_NameEq(AST_GetData1(a), AST_GetData1(b)))
        }
        IfCondition NotEqual(ta, AST.CALL) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(StringCompare(AST_GetData1(a), AST_GetData1(b)), 0) ThenBlock: { ReturnValue(0) }
        na = AST_GetChildCount(a)
        nb = AST_GetChildCount(b)
        IfCondition NotEqual(na, nb) ThenBlock: { ReturnValue(0) }
        i = 0
        WhileLoop LessThan(i, na) {
            IfCondition EqualTo(Optimize_IpExprEq(AST_GetChild(a, i), AST_GetChild(b, i)), 0) ThenBlock: { ReturnValue(0) }
            i = Add(i, 1)
        }
        ReturnValue(1)
    }
}

Function.Optimize_IpMulParts {
    Input: node: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(node), AST.CALL) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(StringCompare(AST_GetData1(node), "Multiply"), 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetChildCount(node), 2) ThenBlock: { ReturnValue(0) }
        right = AST_GetChild(node, 1)
        left = AST_GetChild(node, 0)
        IfCondition EqualTo(Optimize_IpNum(right), 1) ThenBlock: {
            LoopHome.ip_mul_k = LoopHome.ip_num
            LoopHome.ip_mul_in = left
            ReturnValue(1)
        }
        IfCondition EqualTo(Optimize_IpNum(left), 1) ThenBlock: {
            LoopHome.ip_mul_k = LoopHome.ip_num
            LoopHome.ip_mul_in = right
            ReturnValue(1)
        }
        ReturnValue(0)
    }
}

// ip_delta is the constant c where node = anchor + c. Identifiers must match.
Function.Optimize_IpDelta {
    Input: node: Address
    Input: anchor: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: {
            IfCondition EqualTo(anchor, 0) ThenBlock: {
                LoopHome.ip_delta = 0
                ReturnValue(1)
            }
            ReturnValue(0)
        }
        IfCondition NotEqual(anchor, 0) ThenBlock: {
            IfCondition EqualTo(Optimize_IpExprEq(node, anchor), 1) ThenBlock: {
                LoopHome.ip_delta = 0
                ReturnValue(1)
            }
        }
        IfCondition EqualTo(AST_GetType(node), AST.CALL) ThenBlock: {
            IfCondition EqualTo(StringCompare(AST_GetData1(node), "Add"), 0) ThenBlock: {
                IfCondition EqualTo(AST_GetChildCount(node), 2) ThenBlock: {
                    left = AST_GetChild(node, 0)
                    right = AST_GetChild(node, 1)
                    IfCondition EqualTo(Optimize_IpNum(right), 1) ThenBlock: {
                        n = LoopHome.ip_num
                        IfCondition EqualTo(Optimize_IpDelta(left, anchor), 1) ThenBlock: {
                            LoopHome.ip_delta = Add(LoopHome.ip_delta, n)
                            ReturnValue(1)
                        }
                    }
                    IfCondition EqualTo(Optimize_IpNum(left), 1) ThenBlock: {
                        n = LoopHome.ip_num
                        IfCondition EqualTo(Optimize_IpDelta(right, anchor), 1) ThenBlock: {
                            LoopHome.ip_delta = Add(LoopHome.ip_delta, n)
                            ReturnValue(1)
                        }
                    }
                }
            }
        }
        IfCondition NotEqual(anchor, 0) ThenBlock: {
            IfCondition EqualTo(AST_GetType(anchor), AST.CALL) ThenBlock: {
                IfCondition EqualTo(StringCompare(AST_GetData1(anchor), "Add"), 0) ThenBlock: {
                    IfCondition EqualTo(AST_GetChildCount(anchor), 2) ThenBlock: {
                        left = AST_GetChild(anchor, 0)
                        right = AST_GetChild(anchor, 1)
                        IfCondition EqualTo(Optimize_IpNum(right), 1) ThenBlock: {
                            n = LoopHome.ip_num
                            IfCondition EqualTo(Optimize_IpDelta(node, left), 1) ThenBlock: {
                                LoopHome.ip_delta = Subtract(LoopHome.ip_delta, n)
                                ReturnValue(1)
                            }
                        }
                        IfCondition EqualTo(Optimize_IpNum(left), 1) ThenBlock: {
                            n = LoopHome.ip_num
                            IfCondition EqualTo(Optimize_IpDelta(node, right), 1) ThenBlock: {
                                LoopHome.ip_delta = Subtract(LoopHome.ip_delta, n)
                                ReturnValue(1)
                            }
                        }
                    }
                }
            }
        }
        IfCondition EqualTo(Optimize_IpMulParts(node), 1) ThenBlock: {
            inn = LoopHome.ip_mul_in
            mk = LoopHome.ip_mul_k
            IfCondition EqualTo(Optimize_IpMulParts(anchor), 1) ThenBlock: {
                ina = LoopHome.ip_mul_in
                ma = LoopHome.ip_mul_k
                IfCondition EqualTo(mk, ma) ThenBlock: {
                    IfCondition EqualTo(Optimize_IpDelta(inn, ina), 1) ThenBlock: {
                        LoopHome.ip_delta = Multiply(LoopHome.ip_delta, mk)
                        ReturnValue(1)
                    }
                }
            }
        }
        ReturnValue(0)
    }
}

Function.Optimize_IpRhs {
    Input: name: Address
    Output: Address
    Body: {
        body = LoopHome.body
        IfCondition EqualTo(body, 0) ThenBlock: { ReturnValue(0) }
        count = AST_GetChildCount(body)
        i = 0
        WhileLoop LessThan(i, count) {
            st = AST_GetChild(body, i)
            IfCondition EqualTo(Optimize_PlainAssign(st), 1) ThenBlock: {
                IfCondition EqualTo(Optimize_NameEq(AST_GetData1(st), name), 1) ThenBlock: {
                    ReturnValue(AST_GetChild(st, 0))
                }
            }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

Function.Optimize_IpInvOk {
    Input: node: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(1) }
        nt = AST_GetType(node)
        IfCondition EqualTo(nt, AST.NUMBER) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(nt, AST.IDENTIFIER) ThenBlock: {
            name = AST_GetData1(node)
            IfCondition EqualTo(Optimize_NameEq(name, LoopHome.int_name), 1) ThenBlock: { ReturnValue(0) }
            IfCondition NotEqual(Optimize_AssignCount(LoopHome.body, name), 0) ThenBlock: { ReturnValue(0) }
            ReturnValue(1)
        }
        IfCondition NotEqual(nt, AST.CALL) ThenBlock: { ReturnValue(0) }
        count = AST_GetChildCount(node)
        i = 0
        WhileLoop LessThan(i, count) {
            IfCondition EqualTo(Optimize_IpInvOk(AST_GetChild(node, i)), 0) ThenBlock: { ReturnValue(0) }
            i = Add(i, 1)
        }
        ReturnValue(1)
    }
}

// Index = cursor*coeff + inv + add. inv is an expression node, or 0.
Function.Optimize_IpIndex {
    Input: node: Address
    Input: depth: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterThan(depth, 6) ThenBlock: { ReturnValue(0) }
        nt = AST_GetType(node)
        IfCondition EqualTo(nt, AST.IDENTIFIER) ThenBlock: {
            name = AST_GetData1(node)
            IfCondition EqualTo(Optimize_NameEq(name, LoopHome.int_name), 1) ThenBlock: {
                LoopHome.ip_coeff = 1
                LoopHome.ip_inv = 0
                LoopHome.ip_add = 0
                ReturnValue(1)
            }
            IfCondition GreaterThan(depth, 4) ThenBlock: { ReturnValue(0) }
            IfCondition NotEqual(Optimize_AssignCount(LoopHome.body, name), 1) ThenBlock: { ReturnValue(0) }
            rhs = Optimize_IpRhs(name)
            IfCondition EqualTo(rhs, 0) ThenBlock: { ReturnValue(0) }
            ReturnValue(Optimize_IpIndex(rhs, Add(depth, 1)))
        }
        IfCondition NotEqual(nt, AST.CALL) ThenBlock: { ReturnValue(0) }
        op = AST_GetData1(node)
        IfCondition NotEqual(AST_GetChildCount(node), 2) ThenBlock: { ReturnValue(0) }
        left = AST_GetChild(node, 0)
        right = AST_GetChild(node, 1)
        IfCondition EqualTo(StringCompare(op, "Multiply"), 0) ThenBlock: {
            IfCondition EqualTo(Optimize_IpNum(right), 1) ThenBlock: {
                n = LoopHome.ip_num
                IfCondition EqualTo(Optimize_NameIs(left, LoopHome.int_name), 1) ThenBlock: {
                    LoopHome.ip_coeff = n
                    LoopHome.ip_inv = 0
                    LoopHome.ip_add = 0
                    ReturnValue(1)
                }
                IfCondition EqualTo(Optimize_IpIndex(left, Add(depth, 1)), 1) ThenBlock: {
                    IfCondition NotEqual(LoopHome.ip_inv, 0) ThenBlock: { ReturnValue(0) }
                    LoopHome.ip_coeff = Multiply(LoopHome.ip_coeff, n)
                    LoopHome.ip_add = Multiply(LoopHome.ip_add, n)
                    ReturnValue(1)
                }
            }
            IfCondition EqualTo(Optimize_IpNum(left), 1) ThenBlock: {
                n = LoopHome.ip_num
                IfCondition EqualTo(Optimize_NameIs(right, LoopHome.int_name), 1) ThenBlock: {
                    LoopHome.ip_coeff = n
                    LoopHome.ip_inv = 0
                    LoopHome.ip_add = 0
                    ReturnValue(1)
                }
                IfCondition EqualTo(Optimize_IpIndex(right, Add(depth, 1)), 1) ThenBlock: {
                    IfCondition NotEqual(LoopHome.ip_inv, 0) ThenBlock: { ReturnValue(0) }
                    LoopHome.ip_coeff = Multiply(LoopHome.ip_coeff, n)
                    LoopHome.ip_add = Multiply(LoopHome.ip_add, n)
                    ReturnValue(1)
                }
            }
            ReturnValue(0)
        }
        IfCondition NotEqual(StringCompare(op, "Add"), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_IpNum(right), 1) ThenBlock: {
            n = LoopHome.ip_num
            IfCondition EqualTo(Optimize_IpIndex(left, Add(depth, 1)), 0) ThenBlock: { ReturnValue(0) }
            LoopHome.ip_add = Add(LoopHome.ip_add, n)
            ReturnValue(1)
        }
        IfCondition EqualTo(Optimize_IpNum(left), 1) ThenBlock: {
            n = LoopHome.ip_num
            IfCondition EqualTo(Optimize_IpIndex(right, Add(depth, 1)), 0) ThenBlock: { ReturnValue(0) }
            LoopHome.ip_add = Add(LoopHome.ip_add, n)
            ReturnValue(1)
        }
        got = 0
        IfCondition EqualTo(Optimize_CountIdents(right, LoopHome.int_name), 0) ThenBlock: {
            IfCondition EqualTo(Optimize_IpIndex(left, Add(depth, 1)), 1) ThenBlock: {
                IfCondition EqualTo(LoopHome.ip_inv, 0) ThenBlock: {
                    IfCondition EqualTo(Optimize_IpInvOk(right), 1) ThenBlock: {
                        LoopHome.ip_inv = right
                        got = 1
                    }
                }
            }
        }
        IfCondition EqualTo(got, 0) ThenBlock: {
            IfCondition EqualTo(Optimize_CountIdents(left, LoopHome.int_name), 0) ThenBlock: {
                IfCondition EqualTo(Optimize_IpIndex(right, Add(depth, 1)), 1) ThenBlock: {
                    IfCondition EqualTo(LoopHome.ip_inv, 0) ThenBlock: {
                        IfCondition EqualTo(Optimize_IpInvOk(left), 1) ThenBlock: {
                            LoopHome.ip_inv = left
                            got = 1
                        }
                    }
                }
            }
        }
        ReturnValue(got)
    }
}

// Sets ip_base, ip_coeff, ip_scale, ip_inv, ip_add, ip_via, ip_boff.
Function.Optimize_IpAddrSides {
    Input: base: Address
    Input: idx: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(base, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(base), AST.IDENTIFIER) ThenBlock: { ReturnValue(0) }
        bname = AST_GetData1(base)
        IfCondition EqualTo(Optimize_NameEq(bname, LoopHome.int_name), 1) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(Optimize_AssignCount(LoopHome.body, bname), 0) ThenBlock: { ReturnValue(0) }
        via = 0
        boff = 0
        IfCondition EqualTo(Optimize_NameEq(bname, LoopHome.acc_name), 1) ThenBlock: {
            via = 2
        } ElseBlock: {
            IfCondition EqualTo(Optimize_FrameOff(bname), 0) ThenBlock: { ReturnValue(0) }
            via = 3
            boff = LoopHome.imm_val
        }
        scale = 1
        index = idx
        IfCondition EqualTo(AST_GetType(idx), AST.CALL) ThenBlock: {
            IfCondition EqualTo(StringCompare(AST_GetData1(idx), "Multiply"), 0) ThenBlock: {
                IfCondition EqualTo(AST_GetChildCount(idx), 2) ThenBlock: {
                    left = AST_GetChild(idx, 0)
                    right = AST_GetChild(idx, 1)
                    took = 0
                    IfCondition EqualTo(Optimize_IpNum(right), 1) ThenBlock: {
                        IfCondition EqualTo(Optimize_IpScaleOk(LoopHome.ip_num), 1) ThenBlock: {
                            scale = LoopHome.ip_num
                            index = left
                            took = 1
                        }
                    }
                    IfCondition EqualTo(took, 0) ThenBlock: {
                        IfCondition EqualTo(Optimize_IpNum(left), 1) ThenBlock: {
                            IfCondition EqualTo(Optimize_IpScaleOk(LoopHome.ip_num), 1) ThenBlock: {
                                scale = LoopHome.ip_num
                                index = right
                                took = 1
                            }
                        }
                    }
                    IfCondition EqualTo(took, 0) ThenBlock: { ReturnValue(0) }
                }
            }
        }
        IfCondition EqualTo(Optimize_IpIndex(index, 0), 0) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(LoopHome.ip_coeff, 1) ThenBlock: { ReturnValue(0) }
        LoopHome.ip_base = bname
        LoopHome.ip_scale = scale
        LoopHome.ip_via = via
        LoopHome.ip_boff = boff
        ReturnValue(1)
    }
}

Function.Optimize_IpAddr {
    Input: node: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(node), AST.CALL) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(StringCompare(AST_GetData1(node), "Dereference"), 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetChildCount(node), 1) ThenBlock: { ReturnValue(0) }
        addr = AST_GetChild(node, 0)
        IfCondition EqualTo(addr, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(addr), AST.CALL) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(StringCompare(AST_GetData1(addr), "Add"), 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetChildCount(addr), 2) ThenBlock: { ReturnValue(0) }
        left = AST_GetChild(addr, 0)
        right = AST_GetChild(addr, 1)
        IfCondition EqualTo(Optimize_IpAddrSides(left, right), 1) ThenBlock: { ReturnValue(1) }
        ReturnValue(Optimize_IpAddrSides(right, left))
    }
}

Function.Optimize_IpIsFlt {
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(Optimize_NameEq(name, LoopHome.flt_name), 1) ThenBlock: { ReturnValue(1) }
        IfCondition NotEqual(Optimize_ExtraReg(name), 0) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

Function.Optimize_IpUseStmt {
    Input: st: Address
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(Optimize_PlainAssign(st), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_IpIsFlt(AST_GetData1(st)), 0) ThenBlock: { ReturnValue(0) }
        val = AST_GetChild(st, 0)
        IfCondition EqualTo(val, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(val), AST.CALL) ThenBlock: { ReturnValue(0) }
        opname = AST_GetData1(val)
        is_sub = 0
        is_add = 0
        IfCondition EqualTo(StringCompare(opname, "Float_Add"), 0) ThenBlock: { is_add = 1 }
        IfCondition EqualTo(StringCompare(opname, "Float_Sub"), 0) ThenBlock: { is_sub = 1 }
        IfCondition EqualTo(is_add, 0) ThenBlock: {
            IfCondition EqualTo(is_sub, 0) ThenBlock: { ReturnValue(0) }
        }
        IfCondition NotEqual(AST_GetChildCount(val), 2) ThenBlock: { ReturnValue(0) }
        left = AST_GetChild(val, 0)
        right = AST_GetChild(val, 1)
        mul = 0
        home = 0
        IfCondition EqualTo(is_sub, 1) ThenBlock: {
            IfCondition EqualTo(Optimize_IdentEq(left, AST_GetData1(st)), 0) ThenBlock: { ReturnValue(0) }
            IfCondition EqualTo(Optimize_IsFloatMul(right), 0) ThenBlock: { ReturnValue(0) }
            mul = right
            home = left
        }
        IfCondition EqualTo(is_add, 1) ThenBlock: {
            IfCondition EqualTo(Optimize_IdentEq(left, AST_GetData1(st)), 1) ThenBlock: {
                IfCondition EqualTo(Optimize_IsFloatMul(right), 1) ThenBlock: {
                    mul = right
                    home = left
                }
            }
            IfCondition EqualTo(Optimize_IdentEq(right, AST_GetData1(st)), 1) ThenBlock: {
                IfCondition EqualTo(Optimize_IsFloatMul(left), 1) ThenBlock: {
                    mul = left
                    home = right
                }
            }
        }
        IfCondition EqualTo(mul, 0) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterThan(Optimize_CountIdents(home, name), 0) ThenBlock: { ReturnValue(0) }
        vn = Optimize_CountIdents(val, name)
        mn = Optimize_CountIdents(mul, name)
        IfCondition NotEqual(vn, mn) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(mn, 1) ThenBlock: { ReturnValue(0) }
        ReturnValue(1)
    }
}

Function.Optimize_IpUsesOk {
    Input: name: Address
    Input: def_at: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_NameEq(name, LoopHome.int_name), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_IpIsFlt(name), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_NameEq(name, LoopHome.acc_name), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_NameEq(name, LoopHome.der_name), 1) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(Optimize_AssignCount(LoopHome.body, name), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Compile.current_func, 0) ThenBlock: { ReturnValue(0) }
        block_n = Optimize_Mentions(LoopHome.body, name)
        func_n = Optimize_Mentions(Compile.current_func, name)
        IfCondition NotEqual(block_n, func_n) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(block_n, 2) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterEqual(def_at, LoopHome.iv_at) ThenBlock: { ReturnValue(0) }
        count = AST_GetChildCount(LoopHome.body)
        k = 0
        WhileLoop LessThan(k, count) {
            st = AST_GetChild(LoopHome.body, k)
            n = Optimize_CountIdents(st, name)
            IfCondition EqualTo(k, def_at) ThenBlock: {
                IfCondition NotEqual(n, 0) ThenBlock: { ReturnValue(0) }
            }
            IfCondition LessThan(k, def_at) ThenBlock: {
                IfCondition GreaterThan(n, 0) ThenBlock: { ReturnValue(0) }
            }
            IfCondition GreaterEqual(k, LoopHome.iv_at) ThenBlock: {
                IfCondition GreaterThan(n, 0) ThenBlock: { ReturnValue(0) }
            }
            IfCondition GreaterThan(k, def_at) ThenBlock: {
                IfCondition LessThan(k, LoopHome.iv_at) ThenBlock: {
                    IfCondition GreaterThan(n, 0) ThenBlock: {
                        IfCondition EqualTo(Optimize_IpUseStmt(st, name), 0) ThenBlock: { ReturnValue(0) }
                    }
                }
            }
            k = Add(k, 1)
        }
        ReturnValue(1)
    }
}

Function.Optimize_IpTakeReg {
    Output: Integer
    Body: {
        used11 = 0
        used14 = 0
        IfCondition EqualTo(LoopHome.ip0_on, 1) ThenBlock: {
            IfCondition EqualTo(LoopHome.ip0_reg, 11) ThenBlock: { used11 = 1 }
            IfCondition EqualTo(LoopHome.ip0_reg, 14) ThenBlock: { used14 = 1 }
        }
        IfCondition EqualTo(LoopHome.ip1_on, 1) ThenBlock: {
            IfCondition EqualTo(LoopHome.ip1_reg, 11) ThenBlock: { used11 = 1 }
            IfCondition EqualTo(LoopHome.ip1_reg, 14) ThenBlock: { used14 = 1 }
        }
        IfCondition EqualTo(used11, 0) ThenBlock: {
            IfCondition EqualTo(LoopHome.der_on, 0) ThenBlock: { ReturnValue(11) }
        }
        IfCondition EqualTo(used14, 0) ThenBlock: {
            IfCondition EqualTo(LoopHome.tab_on, 0) ThenBlock: { ReturnValue(14) }
        }
        ReturnValue(0)
    }
}

Function.Optimize_IpNameFree {
    Output: Integer
    Body: {
        IfCondition EqualTo(LoopHome.n0_on, 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(LoopHome.n1_on, 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(LoopHome.n2_on, 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(LoopHome.n3_on, 0) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

Function.Optimize_IpNote {
    Input: name: Address
    Input: reg: Integer
    Input: disp: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(LoopHome.n0_on, 0) ThenBlock: {
            LoopHome.n0_on = 1
            LoopHome.n0_name = name
            LoopHome.n0_reg = reg
            LoopHome.n0_disp = disp
            ReturnValue(1)
        }
        IfCondition EqualTo(LoopHome.n1_on, 0) ThenBlock: {
            LoopHome.n1_on = 1
            LoopHome.n1_name = name
            LoopHome.n1_reg = reg
            LoopHome.n1_disp = disp
            ReturnValue(1)
        }
        IfCondition EqualTo(LoopHome.n2_on, 0) ThenBlock: {
            LoopHome.n2_on = 1
            LoopHome.n2_name = name
            LoopHome.n2_reg = reg
            LoopHome.n2_disp = disp
            ReturnValue(1)
        }
        IfCondition EqualTo(LoopHome.n3_on, 0) ThenBlock: {
            LoopHome.n3_on = 1
            LoopHome.n3_name = name
            LoopHome.n3_reg = reg
            LoopHome.n3_disp = disp
            ReturnValue(1)
        }
        ReturnValue(0)
    }
}

Function.Optimize_IpCommit {
    Input: name: Address
    Output: Integer
    Body: {
        base = LoopHome.ip_base
        coeff = LoopHome.ip_coeff
        scale = LoopHome.ip_scale
        inv = LoopHome.ip_inv
        addk = LoopHome.ip_add
        via = LoopHome.ip_via
        boff = LoopHome.ip_boff
        IfCondition LessThan(coeff, 1) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterThan(coeff, 1048576) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterThan(LoopHome.iv_step, 1048576) ThenBlock: { ReturnValue(0) }
        bump = Multiply(Multiply(coeff, scale), LoopHome.iv_step)
        IfCondition LessThan(bump, 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_Fit32(bump), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_Fit32(addk), 0) ThenBlock: { ReturnValue(0) }
        slot = -1
        IfCondition EqualTo(LoopHome.ip0_on, 1) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(base, LoopHome.ip0_base), 1) ThenBlock: {
                IfCondition EqualTo(coeff, LoopHome.ip0_coeff) ThenBlock: {
                    IfCondition EqualTo(scale, LoopHome.ip0_scale) ThenBlock: { slot = 0 }
                }
            }
        }
        IfCondition EqualTo(slot, -1) ThenBlock: {
            IfCondition EqualTo(LoopHome.ip1_on, 1) ThenBlock: {
                IfCondition EqualTo(Optimize_NameEq(base, LoopHome.ip1_base), 1) ThenBlock: {
                    IfCondition EqualTo(coeff, LoopHome.ip1_coeff) ThenBlock: {
                        IfCondition EqualTo(scale, LoopHome.ip1_scale) ThenBlock: { slot = 1 }
                    }
                }
            }
        }
        disp = 0
        reg = 0
        IfCondition EqualTo(slot, -1) ThenBlock: {
            IfCondition NotEqual(name, 0) ThenBlock: {
                IfCondition EqualTo(Optimize_IpNameFree(), 0) ThenBlock: { ReturnValue(0) }
            }
            reg = Optimize_IpTakeReg()
            IfCondition EqualTo(reg, 0) ThenBlock: { ReturnValue(0) }
            IfCondition EqualTo(LoopHome.ip0_on, 0) ThenBlock: {
                LoopHome.ip0_on = 1
                LoopHome.ip0_reg = reg
                LoopHome.ip0_bump = bump
                LoopHome.ip0_base = base
                LoopHome.ip0_coeff = coeff
                LoopHome.ip0_scale = scale
                LoopHome.ip0_inv = inv
                LoopHome.ip0_add = addk
                LoopHome.ip0_via = via
                LoopHome.ip0_boff = boff
                slot = 0
            } ElseBlock: {
                IfCondition EqualTo(LoopHome.ip1_on, 0) ThenBlock: {
                    LoopHome.ip1_on = 1
                    LoopHome.ip1_reg = reg
                    LoopHome.ip1_bump = bump
                    LoopHome.ip1_base = base
                    LoopHome.ip1_coeff = coeff
                    LoopHome.ip1_scale = scale
                    LoopHome.ip1_inv = inv
                    LoopHome.ip1_add = addk
                    LoopHome.ip1_via = via
                    LoopHome.ip1_boff = boff
                    slot = 1
                } ElseBlock: {
                    ReturnValue(0)
                }
            }
            disp = 0
        } ElseBlock: {
            anch = LoopHome.ip0_inv
            aadd = LoopHome.ip0_add
            reg = LoopHome.ip0_reg
            IfCondition EqualTo(slot, 1) ThenBlock: {
                anch = LoopHome.ip1_inv
                aadd = LoopHome.ip1_add
                reg = LoopHome.ip1_reg
            }
            IfCondition EqualTo(Optimize_IpDelta(inv, anch), 0) ThenBlock: { ReturnValue(0) }
            d = Add(LoopHome.ip_delta, Subtract(addk, aadd))
            disp = Multiply(d, scale)
            IfCondition EqualTo(Optimize_Fit32(disp), 0) ThenBlock: { ReturnValue(0) }
            IfCondition NotEqual(name, 0) ThenBlock: {
                IfCondition EqualTo(Optimize_IpNameFree(), 0) ThenBlock: { ReturnValue(0) }
            }
        }
        IfCondition EqualTo(Optimize_IpNote(name, reg, disp), 0) ThenBlock: { ReturnValue(0) }
        LoopHome.ip_count = Add(LoopHome.ip_count, 1)
        ReturnValue(1)
    }
}

Function.Optimize_IpCountDeref {
    Input: node: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        n = 0
        IfCondition EqualTo(AST_GetType(node), AST.CALL) ThenBlock: {
            IfCondition EqualTo(StringCompare(AST_GetData1(node), "Dereference"), 0) ThenBlock: { n = 1 }
        }
        count = AST_GetChildCount(node)
        i = 0
        WhileLoop LessThan(i, count) {
            n = Add(n, Optimize_IpCountDeref(AST_GetChild(node, i)))
            i = Add(i, 1)
        }
        ReturnValue(n)
    }
}

Function.Optimize_IpScanFactor {
    Input: node: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(node), AST.CALL) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(StringCompare(AST_GetData1(node), "Dereference"), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_IpAddr(node), 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(Optimize_IpCommit(0))
    }
}

Function.Optimize_IpScanFma {
    Input: st: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(Optimize_PlainAssign(st), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_IpIsFlt(AST_GetData1(st)), 0) ThenBlock: { ReturnValue(0) }
        val = AST_GetChild(st, 0)
        IfCondition EqualTo(val, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(val), AST.CALL) ThenBlock: { ReturnValue(0) }
        opname = AST_GetData1(val)
        is_sub = 0
        is_add = 0
        IfCondition EqualTo(StringCompare(opname, "Float_Add"), 0) ThenBlock: { is_add = 1 }
        IfCondition EqualTo(StringCompare(opname, "Float_Sub"), 0) ThenBlock: { is_sub = 1 }
        IfCondition EqualTo(is_add, 0) ThenBlock: {
            IfCondition EqualTo(is_sub, 0) ThenBlock: { ReturnValue(0) }
        }
        IfCondition NotEqual(AST_GetChildCount(val), 2) ThenBlock: { ReturnValue(0) }
        left = AST_GetChild(val, 0)
        right = AST_GetChild(val, 1)
        mul = 0
        IfCondition EqualTo(is_sub, 1) ThenBlock: {
            IfCondition EqualTo(Optimize_IsFloatMul(right), 1) ThenBlock: { mul = right }
        }
        IfCondition EqualTo(is_add, 1) ThenBlock: {
            IfCondition EqualTo(Optimize_IsFloatMul(right), 1) ThenBlock: { mul = right }
            IfCondition EqualTo(Optimize_IsFloatMul(left), 1) ThenBlock: { mul = left }
        }
        IfCondition EqualTo(mul, 0) ThenBlock: { ReturnValue(0) }
        Optimize_IpScanFactor(AST_GetChild(mul, 0))
        Optimize_IpScanFactor(AST_GetChild(mul, 1))
        ReturnValue(0)
    }
}

// A dereference this loop already owns covers every read inside it.
// A matching dereference is not walked again: the pointer is built from
// the cursor, so those reads are never executed. A bare identifier is a
// real use and keeps the store.
Function.Optimize_IpCovered {
    Input: node: Address
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(Optimize_CountIdents(node, name), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(AST_GetType(node), AST.CALL) ThenBlock: {
            IfCondition EqualTo(StringCompare(AST_GetData1(node), "Dereference"), 0) ThenBlock: {
                IfCondition EqualTo(Optimize_IpMatch(node), 1) ThenBlock: { ReturnValue(1) }
                ReturnValue(0)
            }
        }
        IfCondition EqualTo(AST_GetType(node), AST.IDENTIFIER) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(AST_GetData1(node), name), 1) ThenBlock: { ReturnValue(0) }
        }
        count = AST_GetChildCount(node)
        i = 0
        WhileLoop LessThan(i, count) {
            IfCondition EqualTo(Optimize_IpCovered(AST_GetChild(node, i), name), 0) ThenBlock: { ReturnValue(0) }
            i = Add(i, 1)
        }
        ReturnValue(1)
    }
}

Function.Optimize_IpIsNoted {
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(LoopHome.n0_on, 1) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(name, LoopHome.n0_name), 1) ThenBlock: { ReturnValue(1) }
        }
        IfCondition EqualTo(LoopHome.n1_on, 1) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(name, LoopHome.n1_name), 1) ThenBlock: { ReturnValue(1) }
        }
        IfCondition EqualTo(LoopHome.n2_on, 1) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(name, LoopHome.n2_name), 1) ThenBlock: { ReturnValue(1) }
        }
        IfCondition EqualTo(LoopHome.n3_on, 1) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(name, LoopHome.n3_name), 1) ThenBlock: { ReturnValue(1) }
        }
        ReturnValue(0)
    }
}

// Mentions counts the assignment itself, so two means one real read.
Function.Optimize_IpDropOk {
    Input: name: Address
    Input: def_at: Integer
    Input: condition: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_NameEq(name, LoopHome.int_name), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_IpIsFlt(name), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_NameEq(name, LoopHome.acc_name), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_NameEq(name, LoopHome.der_name), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_IpIsNoted(name), 1) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(Optimize_AssignCount(LoopHome.body, name), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Compile.current_func, 0) ThenBlock: { ReturnValue(0) }
        block_n = Optimize_Mentions(LoopHome.body, name)
        func_n = Optimize_Mentions(Compile.current_func, name)
        IfCondition NotEqual(block_n, func_n) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(block_n, 2) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterEqual(def_at, LoopHome.iv_at) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterThan(Optimize_CountIdents(condition, name), 0) ThenBlock: { ReturnValue(0) }
        st = AST_GetChild(LoopHome.body, def_at)
        IfCondition EqualTo(st, 0) ThenBlock: { ReturnValue(0) }
        val = AST_GetChild(st, 0)
        IfCondition EqualTo(Optimize_PureExpr(val), 0) ThenBlock: { ReturnValue(0) }
        count = AST_GetChildCount(LoopHome.body)
        k = 0
        WhileLoop LessThan(k, count) {
            st = AST_GetChild(LoopHome.body, k)
            n = Optimize_CountIdents(st, name)
            IfCondition LessThan(k, def_at) ThenBlock: {
                IfCondition GreaterThan(n, 0) ThenBlock: { ReturnValue(0) }
            }
            IfCondition GreaterEqual(k, LoopHome.iv_at) ThenBlock: {
                IfCondition GreaterThan(n, 0) ThenBlock: { ReturnValue(0) }
            }
            IfCondition GreaterEqual(k, def_at) ThenBlock: {
                IfCondition LessThan(k, LoopHome.iv_at) ThenBlock: {
                    IfCondition GreaterThan(n, 0) ThenBlock: {
                        IfCondition EqualTo(Optimize_IpCovered(st, name), 0) ThenBlock: { ReturnValue(0) }
                    }
                }
            }
            k = Add(k, 1)
        }
        ReturnValue(1)
    }
}

Function.Optimize_IpDropNote {
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(LoopHome.d0_on, 0) ThenBlock: {
            LoopHome.d0_on = 1
            LoopHome.d0_name = name
            ReturnValue(1)
        }
        IfCondition EqualTo(LoopHome.d1_on, 0) ThenBlock: {
            LoopHome.d1_on = 1
            LoopHome.d1_name = name
            ReturnValue(1)
        }
        IfCondition EqualTo(LoopHome.d2_on, 0) ThenBlock: {
            LoopHome.d2_on = 1
            LoopHome.d2_name = name
            ReturnValue(1)
        }
        IfCondition EqualTo(LoopHome.d3_on, 0) ThenBlock: {
            LoopHome.d3_on = 1
            LoopHome.d3_name = name
            ReturnValue(1)
        }
        ReturnValue(0)
    }
}

// Optional. A full slot leaves that assignment in the loop. Groups stay.
Function.Optimize_IpPickDrops {
    Input: condition: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(LoopHome.ip0_on, 0) ThenBlock: {
            IfCondition EqualTo(LoopHome.ip1_on, 0) ThenBlock: { ReturnValue(0) }
        }
        count = AST_GetChildCount(LoopHome.body)
        i = 0
        WhileLoop LessThan(i, count) {
            st = AST_GetChild(LoopHome.body, i)
            IfCondition EqualTo(Optimize_PlainAssign(st), 1) ThenBlock: {
                name = AST_GetData1(st)
                IfCondition EqualTo(Optimize_IpDropOk(name, i, condition), 1) ThenBlock: {
                    Optimize_IpDropNote(name)
                }
            }
            i = Add(i, 1)
        }
        ReturnValue(1)
    }
}

Function.Optimize_PickIp {
    Input: condition: Address
    Input: body: Address
    Output: Integer
    Body: {
        Optimize_IpClear()
        IfCondition LessThan(Hw.level, 2) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(LoopHome.has_call, 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(LoopHome.int_name, 0) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(LoopHome.iv_step, 1) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(LoopHome.iv_at, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_TreeHasAsm(body), 1) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(body), AST.BLOCK) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterThan(Optimize_IpCountDeref(condition), 0) ThenBlock: { ReturnValue(0) }
        count = AST_GetChildCount(body)
        i = 0
        WhileLoop LessThan(i, count) {
            st = AST_GetChild(body, i)
            took = 0
            IfCondition EqualTo(Optimize_PlainAssign(st), 1) ThenBlock: {
                val = AST_GetChild(st, 0)
                IfCondition NotEqual(val, 0) ThenBlock: {
                    IfCondition EqualTo(AST_GetType(val), AST.CALL) ThenBlock: {
                        IfCondition EqualTo(StringCompare(AST_GetData1(val), "Dereference"), 0) ThenBlock: {
                            IfCondition EqualTo(Optimize_IpUsesOk(AST_GetData1(st), i), 1) ThenBlock: {
                                IfCondition EqualTo(Optimize_IpAddr(val), 1) ThenBlock: {
                                    Optimize_IpCommit(AST_GetData1(st))
                                    took = 1
                                }
                            }
                        }
                    }
                }
            }
            IfCondition EqualTo(took, 0) ThenBlock: {
                Optimize_IpScanFma(st)
            }
            i = Add(i, 1)
        }
        need = Optimize_IpCountDeref(body)
        IfCondition NotEqual(need, LoopHome.ip_count) ThenBlock: {
            Optimize_IpClear()
            ReturnValue(0)
        }
        groups = 0
        IfCondition EqualTo(LoopHome.ip0_on, 1) ThenBlock: { groups = 1 }
        IfCondition EqualTo(LoopHome.ip1_on, 1) ThenBlock: { groups = 1 }
        IfCondition EqualTo(groups, 1) ThenBlock: {
            Optimize_IpPickDrops(condition)
        }
        ReturnValue(1)
    }
}

Function.Optimize_IpMatchName {
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(LoopHome.n0_on, 1) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(name, LoopHome.n0_name), 1) ThenBlock: {
                LoopHome.ip_hit_reg = LoopHome.n0_reg
                LoopHome.ip_hit_disp = LoopHome.n0_disp
                ReturnValue(1)
            }
        }
        IfCondition EqualTo(LoopHome.n1_on, 1) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(name, LoopHome.n1_name), 1) ThenBlock: {
                LoopHome.ip_hit_reg = LoopHome.n1_reg
                LoopHome.ip_hit_disp = LoopHome.n1_disp
                ReturnValue(1)
            }
        }
        IfCondition EqualTo(LoopHome.n2_on, 1) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(name, LoopHome.n2_name), 1) ThenBlock: {
                LoopHome.ip_hit_reg = LoopHome.n2_reg
                LoopHome.ip_hit_disp = LoopHome.n2_disp
                ReturnValue(1)
            }
        }
        IfCondition EqualTo(LoopHome.n3_on, 1) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(name, LoopHome.n3_name), 1) ThenBlock: {
                LoopHome.ip_hit_reg = LoopHome.n3_reg
                LoopHome.ip_hit_disp = LoopHome.n3_disp
                ReturnValue(1)
            }
        }
        ReturnValue(0)
    }
}

Function.Optimize_IpMatchGroup {
    Output: Integer
    Body: {
        base = LoopHome.ip_base
        coeff = LoopHome.ip_coeff
        scale = LoopHome.ip_scale
        inv = LoopHome.ip_inv
        addk = LoopHome.ip_add
        slot = -1
        IfCondition EqualTo(LoopHome.ip0_on, 1) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(base, LoopHome.ip0_base), 1) ThenBlock: {
                IfCondition EqualTo(coeff, LoopHome.ip0_coeff) ThenBlock: {
                    IfCondition EqualTo(scale, LoopHome.ip0_scale) ThenBlock: { slot = 0 }
                }
            }
        }
        IfCondition EqualTo(slot, -1) ThenBlock: {
            IfCondition EqualTo(LoopHome.ip1_on, 1) ThenBlock: {
                IfCondition EqualTo(Optimize_NameEq(base, LoopHome.ip1_base), 1) ThenBlock: {
                    IfCondition EqualTo(coeff, LoopHome.ip1_coeff) ThenBlock: {
                        IfCondition EqualTo(scale, LoopHome.ip1_scale) ThenBlock: { slot = 1 }
                    }
                }
            }
        }
        IfCondition LessThan(slot, 0) ThenBlock: { ReturnValue(0) }
        anch = LoopHome.ip0_inv
        aadd = LoopHome.ip0_add
        reg = LoopHome.ip0_reg
        IfCondition EqualTo(slot, 1) ThenBlock: {
            anch = LoopHome.ip1_inv
            aadd = LoopHome.ip1_add
            reg = LoopHome.ip1_reg
        }
        IfCondition EqualTo(Optimize_IpDelta(inv, anch), 0) ThenBlock: { ReturnValue(0) }
        d = Add(LoopHome.ip_delta, Subtract(addk, aadd))
        disp = Multiply(d, scale)
        IfCondition EqualTo(Optimize_Fit32(disp), 0) ThenBlock: { ReturnValue(0) }
        LoopHome.ip_hit_reg = reg
        LoopHome.ip_hit_disp = disp
        ReturnValue(1)
    }
}

Function.Optimize_IpMatch {
    Input: node: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(LoopHome.ip0_on, 0) ThenBlock: {
            IfCondition EqualTo(LoopHome.ip1_on, 0) ThenBlock: { ReturnValue(0) }
        }
        IfCondition EqualTo(AST_GetType(node), AST.IDENTIFIER) ThenBlock: {
            ReturnValue(Optimize_IpMatchName(AST_GetData1(node)))
        }
        IfCondition EqualTo(Optimize_IpAddr(node), 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(Optimize_IpMatchGroup())
    }
}

Function.Optimize_TryIpDef {
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(LoopHome.active, 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(Optimize_IpMatchName(name))
    }
}

// The address temporary is never computed. Its reads are pointer disp.
Function.Optimize_TryIpDrop {
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(LoopHome.active, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(LoopHome.d0_on, 1) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(name, LoopHome.d0_name), 1) ThenBlock: { ReturnValue(1) }
        }
        IfCondition EqualTo(LoopHome.d1_on, 1) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(name, LoopHome.d1_name), 1) ThenBlock: { ReturnValue(1) }
        }
        IfCondition EqualTo(LoopHome.d2_on, 1) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(name, LoopHome.d2_name), 1) ThenBlock: { ReturnValue(1) }
        }
        IfCondition EqualTo(LoopHome.d3_on, 1) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(name, LoopHome.d3_name), 1) ThenBlock: { ReturnValue(1) }
        }
        ReturnValue(0)
    }
}

Function.Optimize_IpBump {
    Body: {
        IfCondition EqualTo(LoopHome.ip0_on, 1) ThenBlock: {
            IfCondition NotEqual(LoopHome.ip0_bump, 0) ThenBlock: {
                X86_AddIpImm(LoopHome.ip0_reg, LoopHome.ip0_bump)
            }
        }
        IfCondition EqualTo(LoopHome.ip1_on, 1) ThenBlock: {
            IfCondition NotEqual(LoopHome.ip1_bump, 0) ThenBlock: {
                X86_AddIpImm(LoopHome.ip1_reg, LoopHome.ip1_bump)
            }
        }
        // Products already loaded. Multiply after the pointer step so the
        // next trip's address is ready while the FP pipe is busy.
        Optimize_PinFlush()
        // The pointer moved. The next trip reloads.
        LoopHome.pin_n = 0
        LoopHome.pin_hit = 0
    }
}

Function.Optimize_EmitIpOne {
    Input: slot: Integer
    Body: {
        reg = LoopHome.ip0_reg
        inv = LoopHome.ip0_inv
        iadd = LoopHome.ip0_add
        scale = LoopHome.ip0_scale
        coeff = LoopHome.ip0_coeff
        via = LoopHome.ip0_via
        boff = LoopHome.ip0_boff
        mode = LoopHome.ip0_mode
        rhs = LoopHome.ip0_rhs
        IfCondition EqualTo(slot, 1) ThenBlock: {
            reg = LoopHome.ip1_reg
            inv = LoopHome.ip1_inv
            iadd = LoopHome.ip1_add
            scale = LoopHome.ip1_scale
            coeff = LoopHome.ip1_coeff
            via = LoopHome.ip1_via
            boff = LoopHome.ip1_boff
            mode = LoopHome.ip1_mode
            rhs = LoopHome.ip1_rhs
        }
        // Named address. The add itself is the pointer, so the cursor is
        // not added again. An invariant index has bump 0 and is not stepped.
        IfCondition EqualTo(mode, 1) ThenBlock: {
            save14 = 0
            IfCondition NotEqual(reg, 14) ThenBlock: {
                IfCondition EqualTo(LoopHome.tab_on, 1) ThenBlock: { save14 = 1 }
                IfCondition EqualTo(slot, 1) ThenBlock: {
                    IfCondition EqualTo(LoopHome.ip0_reg, 14) ThenBlock: { save14 = 1 }
                }
            }
            IfCondition EqualTo(save14, 1) ThenBlock: { Emit_PushR14() }
            got = Compile_Expression(rhs)
            IfCondition EqualTo(got, 0) ThenBlock: {
                IfCondition EqualTo(save14, 1) ThenBlock: { Emit_PopR14() }
                Compile.error = 1
                ReturnValue(0)
            }
            IfCondition EqualTo(reg, 11) ThenBlock: { X86Enc_Assemble("MOV r11, rax") }
            IfCondition EqualTo(reg, 14) ThenBlock: { X86Enc_Assemble("MOV r14, rax") }
            IfCondition EqualTo(save14, 1) ThenBlock: { Emit_PopR14() }
            ReturnValue(1)
        }
        zero_k = 0
        IfCondition EqualTo(LoopHome.iv_nn, 1) ThenBlock: {
            IfCondition EqualTo(LoopHome.iv_lo, 0) ThenBlock: { zero_k = 1 }
        }
        IfCondition EqualTo(zero_k, 1) ThenBlock: {
            IfCondition EqualTo(Optimize_OutUse(slot), 1) ThenBlock: { ReturnValue(1) }
        }
        cscale = Multiply(coeff, scale)
        IfCondition NotEqual(inv, 0) ThenBlock: {
            got = Compile_Expression(inv)
            IfCondition EqualTo(got, 0) ThenBlock: {
                Compile.error = 1
                ReturnValue(0)
            }
            IfCondition NotEqual(iadd, 0) ThenBlock: { Emit_AddRaxImm32(iadd) }
        } ElseBlock: {
            Emit_MovRaxImm64(iadd)
        }
        IfCondition GreaterThan(scale, 1) ThenBlock: {
            IfCondition EqualTo(Optimize_IpLog(scale), 1) ThenBlock: {
                IfCondition GreaterThan(LoopHome.ip_log, 0) ThenBlock: { Emit_ShlRaxImm8(LoopHome.ip_log) }
            }
        }
        IfCondition EqualTo(zero_k, 0) ThenBlock: {
            Emit_PushRax()
            Emit_HomeMove(1, 0)
            IfCondition GreaterThan(cscale, 1) ThenBlock: {
                IfCondition EqualTo(Optimize_IpLog(cscale), 1) ThenBlock: {
                    IfCondition GreaterThan(LoopHome.ip_log, 0) ThenBlock: { Emit_ShlRaxImm8(LoopHome.ip_log) }
                } ElseBlock: {
                    Emit_MovRbxImm64(cscale)
                    X86Enc_Assemble("IMUL rax, rbx")
                }
            }
            Emit_PopRbx()
            Emit_AddRaxRbx()
        }
        IfCondition EqualTo(via, 2) ThenBlock: {
            Emit_AddRaxR12()
        } ElseBlock: {
            Emit_PushRax()
            Emit_MovRaxRbpOffset(boff)
            Emit_MovRbxRax()
            Emit_PopRax()
            Emit_AddRaxRbx()
        }
        IfCondition EqualTo(reg, 11) ThenBlock: { X86Enc_Assemble("MOV r11, rax") }
        IfCondition EqualTo(reg, 14) ThenBlock: { X86Enc_Assemble("MOV r14, rax") }
        IfCondition EqualTo(zero_k, 1) ThenBlock: { Optimize_OutSave(slot) }
        ReturnValue(1)
    }
}

Function.Optimize_EmitIp {
    Body: {
        IfCondition EqualTo(LoopHome.active, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(LoopHome.ip0_on, 1) ThenBlock: {
            Optimize_EmitIpOne(0)
        }
        IfCondition EqualTo(LoopHome.ip1_on, 1) ThenBlock: {
            Optimize_EmitIpOne(1)
        }
        ReturnValue(0)
    }
}

// A value read in the loop and never written there parks in a free home.
// r12 is the integer slot when the accumulator is empty. Each remaining
// read-only float takes the next xmm3–xmm14 slot. The first winner is the
// same one a single-slot install would have chosen.
Function.Optimize_PickInvariant {
    Input: condition: Address
    Input: body: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(LoopHome.has_call, 1) ThenBlock: { ReturnValue(0) }
        best_int = 0
        best_int_off = 0
        best_int_loads = 0
        i = 0
        WhileLoop LessThan(i, LoopHome.count) {
            rec = Optimize_HomeRec(i)
            name = Dereference(rec)
            loads = Dereference(Add(rec, 8))
            stores = Dereference(Add(rec, 16))
            IfCondition GreaterThan(loads, 0) ThenBlock: {
                IfCondition EqualTo(stores, 0) ThenBlock: {
                    IfCondition EqualTo(Optimize_NameTaken(name), 0) ThenBlock: {
                        skip = 0
                        IfCondition EqualTo(LoopHome.tab_on, 1) ThenBlock: {
                            IfCondition EqualTo(Optimize_NameEq(name, LoopHome.tab_name), 1) ThenBlock: { skip = 1 }
                        }
                        IfCondition EqualTo(LoopHome.lim_on, 1) ThenBlock: {
                            IfCondition EqualTo(Optimize_NameEq(name, LoopHome.lim_name), 1) ThenBlock: { skip = 1 }
                        }
                        IfCondition EqualTo(skip, 0) ThenBlock: {
                            IfCondition EqualTo(Optimize_FrameOff(name), 1) ThenBlock: {
                                off = LoopHome.imm_val
                                IfCondition GreaterThan(loads, best_int_loads) ThenBlock: {
                                    IfCondition EqualTo(Optimize_InvOk(name, 2, condition, body), 1) ThenBlock: {
                                        best_int = name
                                        best_int_off = off
                                        best_int_loads = loads
                                    }
                                }
                            }
                        }
                    }
                }
            }
            i = Add(i, 1)
        }
        IfCondition EqualTo(LoopHome.acc_name, 0) ThenBlock: {
            IfCondition NotEqual(best_int, 0) ThenBlock: {
                LoopHome.acc_name = best_int
                LoopHome.acc_off = best_int_off
            }
        }
        IfCondition EqualTo(LoopHome.no_float, 0) ThenBlock: {
            nflt = 0
            WhileLoop LessThan(nflt, 12) {
                IfCondition EqualTo(Optimize_TakeFlt(condition, body), 0) ThenBlock: { nflt = 12 }
                nflt = Add(nflt, 1)
            }
        }
        ReturnValue(0)
    }
}
