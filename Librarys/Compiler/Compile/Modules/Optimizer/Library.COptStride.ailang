// Library.COptStride.ailang
// Scaled stride, offset rematerialization, and the r14 record base.
// Loaded by the optimizer shell. No imports of its own.

// Scale constant 1, 2, 4, or 8. Anything else, including a name, is 0.
Function.Optimize_ScaleValue {
    Input: node: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(node), AST.NUMBER) ThenBlock: { ReturnValue(0) }
        sv = StringToNumber(AST_GetData1(node))
        IfCondition EqualTo(sv, 1) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(sv, 2) ThenBlock: { ReturnValue(2) }
        IfCondition EqualTo(sv, 4) ThenBlock: { ReturnValue(4) }
        IfCondition EqualTo(sv, 8) ThenBlock: { ReturnValue(8) }
        ReturnValue(0)
    }
}

// Dereference(Add(base, Multiply(index, 1/2/4/8))). The scale may sit on
// either side of the multiply. The base is a name. Returns the scale, or 0.
Function.Optimize_QwordScale {
    Input: node: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(node), AST.CALL) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_NameEq(AST_GetData1(node), "Dereference"), 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetChildCount(node), 1) ThenBlock: { ReturnValue(0) }
        addr = AST_GetChild(node, 0)
        IfCondition EqualTo(addr, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(addr), AST.CALL) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_NameEq(AST_GetData1(addr), "Add"), 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetChildCount(addr), 2) ThenBlock: { ReturnValue(0) }
        base = AST_GetChild(addr, 0)
        mul = AST_GetChild(addr, 1)
        IfCondition EqualTo(base, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(base), AST.IDENTIFIER) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(mul, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(mul), AST.CALL) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_NameEq(AST_GetData1(mul), "Multiply"), 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetChildCount(mul), 2) ThenBlock: { ReturnValue(0) }
        right = AST_GetChild(mul, 1)
        sv = Optimize_ScaleValue(right)
        IfCondition EqualTo(sv, 0) ThenBlock: {
            left = AST_GetChild(mul, 0)
            sv = Optimize_ScaleValue(left)
        }
        ReturnValue(sv)
    }
}

Function.Optimize_QwordBase {
    Input: node: Address
    Output: Address
    Body: {
        IfCondition EqualTo(Optimize_QwordScale(node), 0) ThenBlock: { ReturnValue(0) }
        addr = AST_GetChild(node, 0)
        ReturnValue(AST_GetChild(addr, 0))
    }
}

Function.Optimize_QwordIndex {
    Input: node: Address
    Output: Address
    Body: {
        IfCondition EqualTo(Optimize_QwordScale(node), 0) ThenBlock: { ReturnValue(0) }
        addr = AST_GetChild(node, 0)
        mul = AST_GetChild(addr, 1)
        right = AST_GetChild(mul, 1)
        IfCondition GreaterThan(Optimize_ScaleValue(right), 0) ThenBlock: {
            ReturnValue(AST_GetChild(mul, 0))
        }
        ReturnValue(right)
    }
}

// Names whose own instruction does not write r14. Children are checked
// separately. A name missing from this list is treated as a writer.
Function.Optimize_R14SafeName {
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(StringCompare(name, "Add"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "Subtract"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "Multiply"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "Divide"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "Modulo"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "Negate"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "BitwiseAnd"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "BitwiseOr"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "BitwiseXor"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "BitwiseNot"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "BitAnd"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "BitOr"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "BitXor"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "BitNot"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "LeftShift"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "RightShift"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "ShiftLeft"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "ShiftRight"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "EqualTo"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "NotEqual"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "LessThan"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "GreaterThan"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "LessEqual"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "GreaterEqual"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(Optimize_FltProducer(name), 1) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "Float_ToInt"), 0) ThenBlock: { ReturnValue(1) }
        // Float compares and the byte ops use rax, xmm0, xmm1, rbx, rcx, or
        // rdi. They read r14 when it is the base. They do not write it.
        IfCondition EqualTo(StringCompare(name, "Float_Eq"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "Float_Ne"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "Float_Lt"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "Float_Gt"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "Float_Le"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "Float_Ge"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "GetByte"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "SetByte"), 0) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

// 1 when compiling this tree can leave r14 holding something other than
// the active table. A scaled load of that table keeps r14. Unknown calls
// are writers, so the base is reloaded instead of trusting r14.
Function.Optimize_WritesR14 {
    Input: node: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        nt = AST_GetType(node)
        IfCondition EqualTo(nt, AST.INLINEASM) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(nt, AST.CALL) ThenBlock: {
            nm = AST_GetData1(node)
            IfCondition EqualTo(Optimize_NameEq(nm, "Dereference"), 1) ThenBlock: {
                sc = Optimize_QwordScale(node)
                IfCondition GreaterThan(sc, 0) ThenBlock: {
                    base = Optimize_QwordBase(node)
                    keep = 0
                    IfCondition EqualTo(LoopHome.tab_on, 1) ThenBlock: {
                        IfCondition EqualTo(Optimize_NameEq(AST_GetData1(base), LoopHome.tab_name), 1) ThenBlock: {
                            keep = 1
                        }
                    }
                    IfCondition EqualTo(keep, 1) ThenBlock: {
                        ReturnValue(Optimize_WritesR14(Optimize_QwordIndex(node)))
                    }
                    ReturnValue(1)
                }
            } ElseBlock: {
                IfCondition EqualTo(Optimize_R14SafeName(nm), 0) ThenBlock: { ReturnValue(1) }
            }
        }
        count = AST_GetChildCount(node)
        i = 0
        WhileLoop LessThan(i, count) {
            IfCondition EqualTo(Optimize_WritesR14(AST_GetChild(node, i)), 1) ThenBlock: { ReturnValue(1) }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

// The table home is already in r14, and neither the index nor the other
// operand of the float operation replaces it. active is required:
// tab_on can be left set by a probe that does not emit the prologue,
// and linear scan also keeps ordinary values in r14.
Function.Optimize_QwordFast {
    Input: deref: Address
    Input: other: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(LoopHome.active, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(LoopHome.tab_on, 0) ThenBlock: { ReturnValue(0) }
        base = Optimize_QwordBase(deref)
        IfCondition EqualTo(base, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_NameEq(AST_GetData1(base), LoopHome.tab_name), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_WritesR14(Optimize_QwordIndex(deref)), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_WritesR14(other), 1) ThenBlock: { ReturnValue(0) }
        ReturnValue(1)
    }
}

// An identifier base can be loaded into r14 without touching xmm0.
Function.Optimize_BaseLoadOk {
    Input: base: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(base, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(base), AST.IDENTIFIER) ThenBlock: { ReturnValue(0) }
        name = AST_GetData1(base)
        IfCondition EqualTo(Optimize_IsIntHome(name), 1) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(Optimize_IsAccHome(name), 1) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(Optimize_IsFltHome(name), 1) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(Optimize_IsXmmHold(base), 1) ThenBlock: { ReturnValue(1) }
        Scope_Resolve(name)
        IfCondition EqualTo(Scope.resolve_type, 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(1)
    }
}

// The dereference can be the memory operand. The index only writes general
// registers, and the base is either the live table or a reloadable name.
Function.Optimize_QwordMemOk {
    Input: deref: Address
    Input: other: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(Optimize_QwordScale(deref), 0) ThenBlock: { ReturnValue(0) }
        index = Optimize_QwordIndex(deref)
        IfCondition EqualTo(Optimize_GprSafe(index), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_QwordFast(deref, other), 1) ThenBlock: { ReturnValue(1) }
        ReturnValue(Optimize_BaseLoadOk(Optimize_QwordBase(deref)))
    }
}

// Index into rcx, then the base into r14 if the table home is not already it.
// xmm0 holds the other operand and is not written. Returns 0 after a partial
// emit; the caller must not emit the load a second time.
Function.Optimize_QwordMemAddr {
    Input: deref: Address
    Input: other: Address
    Output: Integer
    Body: {
        index = Optimize_QwordIndex(deref)
        base = Optimize_QwordBase(deref)
        placed = 0
        LoopHome.sib_index = 1
        IfCondition EqualTo(AST_GetType(index), AST.IDENTIFIER) ThenBlock: {
            inm = AST_GetData1(index)
            IfCondition EqualTo(Optimize_IsIntHome(inm), 1) ThenBlock: {
                LoopHome.sib_index = 13
                placed = 1
            }
            IfCondition EqualTo(placed, 0) ThenBlock: {
                IfCondition EqualTo(Optimize_IsAccHome(inm), 1) ThenBlock: {
                    LoopHome.sib_index = 12
                    placed = 1
                }
            }
        }
        IfCondition EqualTo(placed, 0) ThenBlock: {
            IfCondition EqualTo(AST_GetType(index), AST.IDENTIFIER) ThenBlock: {
                sreg = Optimize_ScanAddrBase(AST_GetData1(index))
                IfCondition NotEqual(sreg, 0) ThenBlock: {
                    LoopHome.sib_index = sreg
                    placed = 1
                }
            }
        }
        IfCondition EqualTo(placed, 0) ThenBlock: {
            got = Optimize_LoadToRax(index)
            IfCondition EqualTo(got, 0) ThenBlock: {
                saved = OptState.xmm_out
                OptState.xmm_out = 0
                got = Compile_Expression(index)
                OptState.xmm_out = saved
                IfCondition EqualTo(got, 0) ThenBlock: { ReturnValue(0) }
            }
            Emit_MovRcxRax()
        }
        // Base stays in its scan register when that register is not the
        // index. Otherwise reload through r14, the address temporary.
        LoopHome.ip_hit_reg = 14
        IfCondition EqualTo(Optimize_QwordFast(deref, other), 1) ThenBlock: { ReturnValue(1) }
        breg = 0
        IfCondition EqualTo(AST_GetType(base), AST.IDENTIFIER) ThenBlock: {
            breg = Optimize_ScanAddrBase(AST_GetData1(base))
        }
        IfCondition EqualTo(breg, LoopHome.sib_index) ThenBlock: { breg = 0 }
        IfCondition NotEqual(breg, 0) ThenBlock: {
            LoopHome.ip_hit_reg = breg
            ReturnValue(1)
        }
        got = Optimize_LoadToRax(base)
        IfCondition EqualTo(got, 0) ThenBlock: { ReturnValue(0) }
        Emit_MovR14Rax()
        ReturnValue(1)
    }
}

// A non-table base is copied into r14 for the scaled load. Put the table
// home back so the next use of that home still addresses the table.
Function.Optimize_QwordRestore {
    Input: deref: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(LoopHome.tab_on, 0) ThenBlock: { ReturnValue(0) }
        base = Optimize_QwordBase(deref)
        IfCondition EqualTo(base, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_NameEq(AST_GetData1(base), LoopHome.tab_name), 1) ThenBlock: { ReturnValue(0) }
        Emit_MovRaxRbpOffset(LoopHome.tab_off)
        Emit_MovR14Rax()
        ReturnValue(0)
    }
}

// Dereference(Add(base, Multiply(index, 1/2/4/8))). The scale is the right
// child, matching the integer load. 0 is not this shape. 1 is an identifier
// base whose index does not use rbx. 3 is an identifier base whose index is
// not rbx-safe but does not write r14, so the base can still stay in r14.
// 2 is a scaled address whose base is not stable, or whose index writes r14.
Function.Optimize_ScaledBase {
    Input: node: Address
    Output: Integer
    Body: {
        LoopHome.hold_name = 0
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(node), AST.CALL) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(StringCompare(AST_GetData1(node), "Dereference"), 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetChildCount(node), 1) ThenBlock: { ReturnValue(0) }
        addr = AST_GetChild(node, 0)
        IfCondition EqualTo(addr, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(addr), AST.CALL) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(StringCompare(AST_GetData1(addr), "Add"), 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetChildCount(addr), 2) ThenBlock: { ReturnValue(0) }
        mul = AST_GetChild(addr, 1)
        IfCondition EqualTo(mul, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(mul), AST.CALL) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(StringCompare(AST_GetData1(mul), "Multiply"), 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetChildCount(mul), 2) ThenBlock: { ReturnValue(0) }
        scale_node = AST_GetChild(mul, 1)
        IfCondition EqualTo(Optimize_ScaleValue(scale_node), 0) ThenBlock: { ReturnValue(0) }
        index = AST_GetChild(mul, 0)
        base = AST_GetChild(addr, 0)
        IfCondition EqualTo(base, 0) ThenBlock: { ReturnValue(2) }
        IfCondition NotEqual(AST_GetType(base), AST.IDENTIFIER) ThenBlock: { ReturnValue(2) }
        LoopHome.hold_name = AST_GetData1(base)
        IfCondition EqualTo(Optimize_RbxSafeOp(index), 1) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(Optimize_WritesR14(index), 0) ThenBlock: { ReturnValue(3) }
        ReturnValue(2)
    }
}

Function.Optimize_AssignsName {
    Input: node: Address
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(AST_GetType(node), AST.ASSIGNMENT) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(AST_GetData1(node), name), 1) ThenBlock: { ReturnValue(1) }
        }
        count = AST_GetChildCount(node)
        i = 0
        WhileLoop LessThan(i, count) {
            IfCondition EqualTo(Optimize_AssignsName(AST_GetChild(node, i), name), 1) ThenBlock: { ReturnValue(1) }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

Function.Optimize_NoteTable {
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(LoopHome.tab_many, 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(LoopHome.tab_on, 1) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(name, LoopHome.tab_name), 0) ThenBlock: {
                LoopHome.tab_on = 0
                LoopHome.tab_many = 1
            }
            ReturnValue(0)
        }
        IfCondition EqualTo(Optimize_AssignsName(LoopHome.body, name), 1) ThenBlock: {
            LoopHome.tab_many = 1
            ReturnValue(0)
        }
        off = Scope_Resolve(name)
        rt = Scope.resolve_type
        ok = 0
        IfCondition EqualTo(rt, 1) ThenBlock: { ok = 1 }
        IfCondition EqualTo(rt, 2) ThenBlock: { ok = 1 }
        IfCondition GreaterEqual(off, 0) ThenBlock: { ok = 0 }
        IfCondition EqualTo(ok, 0) ThenBlock: {
            LoopHome.tab_many = 1
            ReturnValue(0)
        }
        LoopHome.tab_on = 1
        LoopHome.tab_name = name
        LoopHome.tab_off = off
        ReturnValue(1)
    }
}

// StoreValue(Add(base, Multiply(index, 1/2/4/8)), value). The base is a
// table candidate, same as a scaled load of that base. 2 means the address
// is scaled but the base is not stable, so a table already chosen is dropped.
Function.Optimize_StoreScaled {
    Input: node: Address
    Output: Integer
    Body: {
        LoopHome.hold_name = 0
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(node), AST.CALL) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(StringCompare(AST_GetData1(node), "StoreValue"), 0) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(AST_GetChildCount(node), 2) ThenBlock: { ReturnValue(0) }
        addr = AST_GetChild(node, 0)
        IfCondition EqualTo(addr, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(addr), AST.CALL) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(StringCompare(AST_GetData1(addr), "Add"), 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetChildCount(addr), 2) ThenBlock: { ReturnValue(0) }
        mul = AST_GetChild(addr, 1)
        IfCondition EqualTo(mul, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(mul), AST.CALL) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(StringCompare(AST_GetData1(mul), "Multiply"), 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetChildCount(mul), 2) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_ScaleValue(AST_GetChild(mul, 1)), 0) ThenBlock: { ReturnValue(0) }
        index = AST_GetChild(mul, 0)
        base = AST_GetChild(addr, 0)
        IfCondition EqualTo(base, 0) ThenBlock: { ReturnValue(2) }
        IfCondition EqualTo(AST_GetType(base), AST.IDENTIFIER) ThenBlock: {
            IfCondition EqualTo(Optimize_RbxSafeOp(index), 1) ThenBlock: {
                LoopHome.hold_name = AST_GetData1(base)
                ReturnValue(1)
            }
        }
        ReturnValue(2)
    }
}

Function.Optimize_ScanTableWalk {
    Input: node: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        k = Optimize_ScaledBase(node)
        note = 0
        IfCondition EqualTo(k, 1) ThenBlock: { note = 1 }
        IfCondition EqualTo(k, 3) ThenBlock: { note = 1 }
        IfCondition EqualTo(note, 1) ThenBlock: { Optimize_NoteTable(LoopHome.hold_name) }
        IfCondition EqualTo(k, 2) ThenBlock: {
            LoopHome.tab_on = 0
            LoopHome.tab_many = 1
        }
        ks = Optimize_StoreScaled(node)
        IfCondition EqualTo(ks, 1) ThenBlock: { Optimize_NoteTable(LoopHome.hold_name) }
        IfCondition EqualTo(ks, 2) ThenBlock: {
            LoopHome.tab_on = 0
            LoopHome.tab_many = 1
        }
        n = AST_GetChildCount(node)
        i = 0
        WhileLoop LessThan(i, n) {
            Optimize_ScanTableWalk(AST_GetChild(node, i))
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

Function.Optimize_ScanTable {
    Input: body: Address
    Body: {
        LoopHome.tab_on = 0
        LoopHome.tab_name = 0
        LoopHome.tab_off = 0
        LoopHome.tab_many = 0
        Optimize_ScanTableWalk(body)
        LoopHome.hold_name = 0
    }
}

// log2 of a power of two in 1..256. -1 otherwise. A stride of 16, 32, or
// 64 is a record array: the index is shifted, then added to the base.
Function.Optimize_StrideShift {
    Input: val: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(Optimize_IsPow2(val), 0) ThenBlock: { ReturnValue(-1) }
        IfCondition GreaterThan(val, 256) ThenBlock: { ReturnValue(-1) }
        s = 0
        n = 1
        WhileLoop LessThan(n, val) {
            n = Multiply(n, 2)
            s = Add(s, 1)
        }
        ReturnValue(s)
    }
}

// Multiply(index, power-of-two) or the swapped form. Sets st_idx and st_shift.
Function.Optimize_StrideFromMul {
    Input: node: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(node), AST.CALL) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(StringCompare(AST_GetData1(node), "Multiply"), 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetChildCount(node), 2) ThenBlock: { ReturnValue(0) }
        a0 = AST_GetChild(node, 0)
        a1 = AST_GetChild(node, 1)
        ident = 0
        konst = 0
        IfCondition NotEqual(a0, 0) ThenBlock: {
            IfCondition EqualTo(AST_GetType(a0), AST.IDENTIFIER) ThenBlock: {
                IfCondition NotEqual(a1, 0) ThenBlock: {
                    IfCondition EqualTo(AST_GetType(a1), AST.NUMBER) ThenBlock: {
                        ident = a0
                        konst = StringToNumber(AST_GetData1(a1))
                    }
                }
            }
        }
        IfCondition EqualTo(ident, 0) ThenBlock: {
            IfCondition NotEqual(a1, 0) ThenBlock: {
                IfCondition EqualTo(AST_GetType(a1), AST.IDENTIFIER) ThenBlock: {
                    IfCondition NotEqual(a0, 0) ThenBlock: {
                        IfCondition EqualTo(AST_GetType(a0), AST.NUMBER) ThenBlock: {
                            ident = a1
                            konst = StringToNumber(AST_GetData1(a0))
                        }
                    }
                }
            }
        }
        IfCondition EqualTo(ident, 0) ThenBlock: { ReturnValue(0) }
        sh = Optimize_StrideShift(konst)
        IfCondition LessThan(sh, 0) ThenBlock: { ReturnValue(0) }
        LoopHome.st_idx = ident
        LoopHome.st_shift = sh
        ReturnValue(1)
    }
}

// off, or off plus a signed byte displacement. Sets st_disp.
Function.Optimize_StrideOffExpr {
    Input: node: Address
    Input: off_name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(AST_GetType(node), AST.IDENTIFIER) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(AST_GetData1(node), off_name), 1) ThenBlock: {
                LoopHome.st_disp = 0
                ReturnValue(1)
            }
        }
        IfCondition NotEqual(AST_GetType(node), AST.CALL) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(StringCompare(AST_GetData1(node), "Add"), 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetChildCount(node), 2) ThenBlock: { ReturnValue(0) }
        a0 = AST_GetChild(node, 0)
        a1 = AST_GetChild(node, 1)
        num = 0
        hit = 0
        IfCondition NotEqual(a0, 0) ThenBlock: {
            IfCondition EqualTo(AST_GetType(a0), AST.IDENTIFIER) ThenBlock: {
                IfCondition EqualTo(Optimize_NameEq(AST_GetData1(a0), off_name), 1) ThenBlock: {
                    IfCondition NotEqual(a1, 0) ThenBlock: {
                        IfCondition EqualTo(AST_GetType(a1), AST.NUMBER) ThenBlock: {
                            num = StringToNumber(AST_GetData1(a1))
                            hit = 1
                        }
                    }
                }
            }
        }
        IfCondition EqualTo(hit, 0) ThenBlock: {
            IfCondition NotEqual(a1, 0) ThenBlock: {
                IfCondition EqualTo(AST_GetType(a1), AST.IDENTIFIER) ThenBlock: {
                    IfCondition EqualTo(Optimize_NameEq(AST_GetData1(a1), off_name), 1) ThenBlock: {
                        IfCondition NotEqual(a0, 0) ThenBlock: {
                            IfCondition EqualTo(AST_GetType(a0), AST.NUMBER) ThenBlock: {
                                num = StringToNumber(AST_GetData1(a0))
                                hit = 1
                            }
                        }
                    }
                }
            }
        }
        IfCondition EqualTo(hit, 0) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(num, -128) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterThan(num, 127) ThenBlock: { ReturnValue(0) }
        LoopHome.st_disp = num
        ReturnValue(1)
    }
}

// Record the invariant base of Add(base, off) and Add(base, off+disp).
// A second base sets st_on to 2.
Function.Optimize_StrideWalk {
    Input: node: Address
    Input: off_name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(LoopHome.st_on, 2) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(AST_GetType(node), AST.CALL) ThenBlock: {
            IfCondition EqualTo(StringCompare(AST_GetData1(node), "Add"), 0) ThenBlock: {
                IfCondition EqualTo(AST_GetChildCount(node), 2) ThenBlock: {
                    base = AST_GetChild(node, 0)
                    off = AST_GetChild(node, 1)
                    IfCondition NotEqual(base, 0) ThenBlock: {
                        IfCondition EqualTo(AST_GetType(base), AST.IDENTIFIER) ThenBlock: {
                            IfCondition EqualTo(Optimize_StrideOffExpr(off, off_name), 1) ThenBlock: {
                                bname = AST_GetData1(base)
                                IfCondition EqualTo(LoopHome.st_base, 0) ThenBlock: {
                                    LoopHome.st_base = bname
                                }
                                IfCondition EqualTo(Optimize_NameEq(bname, LoopHome.st_base), 0) ThenBlock: {
                                    LoopHome.st_on = 2
                                    LoopHome.st_base = 0
                                }
                            }
                        }
                    }
                }
            }
        }
        n = AST_GetChildCount(node)
        i = 0
        WhileLoop LessThan(i, n) {
            Optimize_StrideWalk(AST_GetChild(node, i), off_name)
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

// off = index * stride, with every use of off before the index is assigned
// again. The base of base[index * stride + disp] stays in r14 when it is
// invariant. Stride may be any power of two up to 256, which covers a
// 32-byte record. This is not a hash-table pass.
Function.Optimize_PickStride {
    Input: body: Address
    Output: Integer
    Body: {
        LoopHome.st_on = 0
        LoopHome.st_off = 0
        LoopHome.st_idx = 0
        LoopHome.st_base = 0
        LoopHome.st_shift = 0
        LoopHome.st_disp = 0
        IfCondition EqualTo(body, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(body), AST.BLOCK) ThenBlock: { ReturnValue(0) }
        count = AST_GetChildCount(body)
        i = 0
        WhileLoop LessThan(i, count) {
            st = AST_GetChild(body, i)
            take = 0
            IfCondition EqualTo(Optimize_PlainAssign(st), 1) ThenBlock: {
                val = AST_GetChild(st, 0)
                IfCondition EqualTo(Optimize_StrideFromMul(val), 1) ThenBlock: {
                    off = AST_GetData1(st)
                    idx = AST_GetData1(LoopHome.st_idx)
                    take = 1
                    IfCondition EqualTo(Optimize_NameEq(off, idx), 1) ThenBlock: { take = 0 }
                    IfCondition NotEqual(Optimize_AssignCount(body, off), 1) ThenBlock: { take = 0 }
                    direct = 0
                    upd = -1
                    j = 0
                    WhileLoop LessThan(j, count) {
                        sj = AST_GetChild(body, j)
                        IfCondition EqualTo(Optimize_PlainAssign(sj), 1) ThenBlock: {
                            IfCondition EqualTo(Optimize_NameEq(AST_GetData1(sj), idx), 1) ThenBlock: {
                                direct = Add(direct, 1)
                                upd = j
                            }
                        }
                        j = Add(j, 1)
                    }
                    IfCondition GreaterThan(direct, 1) ThenBlock: { take = 0 }
                    IfCondition NotEqual(Optimize_AssignCount(body, idx), direct) ThenBlock: { take = 0 }
                    IfCondition GreaterEqual(upd, 0) ThenBlock: {
                        IfCondition LessEqual(upd, i) ThenBlock: { take = 0 }
                    }
                    bad = 0
                    j = 0
                    WhileLoop LessThan(j, i) {
                        IfCondition GreaterThan(Optimize_CountIdents(AST_GetChild(body, j), off), 0) ThenBlock: { bad = 1 }
                        j = Add(j, 1)
                    }
                    IfCondition GreaterEqual(upd, 0) ThenBlock: {
                        j = upd
                        WhileLoop LessThan(j, count) {
                            IfCondition GreaterThan(Optimize_CountIdents(AST_GetChild(body, j), off), 0) ThenBlock: { bad = 1 }
                            j = Add(j, 1)
                        }
                    }
                    IfCondition EqualTo(bad, 1) ThenBlock: { take = 0 }
                    IfCondition GreaterThan(Optimize_CountIdents(LoopHome.cond, off), 0) ThenBlock: { take = 0 }
                    IfCondition EqualTo(take, 1) ThenBlock: {
                        saved_idx = LoopHome.st_idx
                        saved_shift = LoopHome.st_shift
                        LoopHome.st_base = 0
                        LoopHome.st_on = 0
                        Optimize_StrideWalk(body, off)
                        IfCondition EqualTo(LoopHome.st_on, 2) ThenBlock: { take = 0 }
                        IfCondition EqualTo(LoopHome.st_base, 0) ThenBlock: { take = 0 }
                        IfCondition EqualTo(take, 1) ThenBlock: {
                            IfCondition EqualTo(Optimize_NameEq(LoopHome.st_base, LoopHome.int_name), 1) ThenBlock: { take = 0 }
                            IfCondition EqualTo(Optimize_NameEq(LoopHome.st_base, LoopHome.acc_name), 1) ThenBlock: { take = 0 }
                            IfCondition NotEqual(Optimize_AssignCount(body, LoopHome.st_base), 0) ThenBlock: { take = 0 }
                        }
                        IfCondition EqualTo(take, 1) ThenBlock: {
                            IfCondition EqualTo(LoopHome.tab_on, 0) ThenBlock: {
                                Optimize_NoteTable(LoopHome.st_base)
                            }
                            LoopHome.st_off = off
                            LoopHome.st_idx = saved_idx
                            LoopHome.st_shift = saved_shift
                            LoopHome.st_on = 1
                            ReturnValue(1)
                        }
                    }
                }
            }
            i = Add(i, 1)
        }
        LoopHome.st_on = 0
        LoopHome.st_off = 0
        LoopHome.st_idx = 0
        LoopHome.st_base = 0
        LoopHome.st_shift = 0
        ReturnValue(0)
    }
}

// rcx held the raw byte offset. A call, a shift into rcx, or a join drops it.
Function.Optimize_RcxDrop {
    Output: Integer
    Body: {
        LoopHome.rcx_on = 0
        LoopHome.rcx_name = 0
        LoopHome.rcx_base = 0
        ReturnValue(0)
    }
}

// Add(st_base, off) or Add(st_base, off+disp8). Does not keep st_disp.
Function.Optimize_CoverAdd {
    Input: node: Address
    Input: off_name: Address
    Output: Integer
    Body: {
        saved = LoopHome.st_disp
        hit = 0
        IfCondition NotEqual(node, 0) ThenBlock: {
            IfCondition EqualTo(AST_GetType(node), AST.CALL) ThenBlock: {
                IfCondition EqualTo(StringCompare(AST_GetData1(node), "Add"), 0) ThenBlock: {
                    IfCondition EqualTo(AST_GetChildCount(node), 2) ThenBlock: {
                        b = AST_GetChild(node, 0)
                        o = AST_GetChild(node, 1)
                        IfCondition NotEqual(b, 0) ThenBlock: {
                            IfCondition EqualTo(AST_GetType(b), AST.IDENTIFIER) ThenBlock: {
                                IfCondition EqualTo(Optimize_NameEq(AST_GetData1(b), LoopHome.st_base), 1) ThenBlock: {
                                    IfCondition EqualTo(Optimize_StrideOffExpr(o, off_name), 1) ThenBlock: {
                                        hit = 1
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        LoopHome.st_disp = saved
        ReturnValue(hit)
    }
}

// 1 when a read of the stride offset is not an address of the form
// base[off+disp8]. Those reads need the frame slot.
Function.Optimize_OffBad {
    Input: node: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_CoverAdd(node, LoopHome.st_off), 1) ThenBlock: {
            ReturnValue(Optimize_OffBad(AST_GetChild(node, 0)))
        }
        nt = AST_GetType(node)
        IfCondition EqualTo(nt, AST.IDENTIFIER) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(AST_GetData1(node), LoopHome.st_off), 1) ThenBlock: {
                ReturnValue(1)
            }
            ReturnValue(0)
        }
        IfCondition EqualTo(nt, AST.INDEX_ASSIGN) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(AST_GetData1(node), LoopHome.st_off), 1) ThenBlock: {
                ReturnValue(1)
            }
        }
        IfCondition EqualTo(nt, AST.POINTER_FIELD_ASSIGN) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(AST_GetData1(node), LoopHome.st_off), 1) ThenBlock: {
                ReturnValue(1)
            }
        }
        IfCondition EqualTo(nt, AST.POINTER_FIELD_ACCESS) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(AST_GetData1(node), LoopHome.st_off), 1) ThenBlock: {
                ReturnValue(1)
            }
        }
        n = AST_GetChildCount(node)
        i = 0
        WhileLoop LessThan(i, n) {
            IfCondition EqualTo(Optimize_OffBad(AST_GetChild(node, i)), 1) ThenBlock: {
                ReturnValue(1)
            }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

// A two-leaf compare does not write rcx. Anything else might.
Function.Optimize_RcxQuiet {
    Input: node: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(node), AST.CALL) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_IsCompareName(AST_GetData1(node)), 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetChildCount(node), 2) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(LoopHome.ihold_on, 1) ThenBlock: {
            IfCondition EqualTo(Optimize_NodeReads(node, LoopHome.ihold_name), 1) ThenBlock: {
                ReturnValue(0)
            }
        }
        IfCondition EqualTo(Optimize_IsLeaf(AST_GetChild(node, 0)), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_IsLeaf(AST_GetChild(node, 1)), 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(1)
    }
}

// 1 when this statement can use the raw offset still sitting in rcx.
// An If saves and restores the note itself. A disp-0 deref establishes it.
Function.Optimize_RcxKeep {
    Input: stmt: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(stmt, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(AST_GetType(stmt), AST.IF) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(LoopHome.rcx_on, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_PlainAssign(stmt), 0) ThenBlock: { ReturnValue(0) }
        val = AST_GetChild(stmt, 0)
        IfCondition EqualTo(val, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(val), AST.CALL) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(StringCompare(AST_GetData1(val), "Dereference"), 0) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(AST_GetChildCount(val), 1) ThenBlock: { ReturnValue(0) }
        ReturnValue(Optimize_CoverAdd(AST_GetChild(val, 0), LoopHome.st_off))
    }
}

// The stride product is idx<<shift until idx changes. Used when the frame
// slot was not stored. rcx wins when it still holds that raw offset.
Function.Optimize_RematOff {
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(LoopHome.off_skip, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(LoopHome.st_on, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_NameEq(name, LoopHome.st_off), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(LoopHome.rcx_on, 1) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(LoopHome.rcx_name, LoopHome.st_off), 1) ThenBlock: {
                IfCondition EqualTo(Optimize_NameEq(LoopHome.rcx_base, LoopHome.st_base), 1) ThenBlock: {
                    Emit_MovRaxRcx()
                    ReturnValue(1)
                }
            }
        }
        IfCondition EqualTo(LoopHome.st_idx, 0) ThenBlock: { ReturnValue(0) }
        idx = AST_GetData1(LoopHome.st_idx)
        IfCondition EqualTo(idx, 0) ThenBlock: { ReturnValue(0) }
        placed = 0
        IfCondition EqualTo(Optimize_IsIntHome(idx), 1) ThenBlock: {
            Emit_HomeMove(1, 0)
            placed = 1
        }
        IfCondition EqualTo(placed, 0) ThenBlock: {
            IfCondition EqualTo(Optimize_IsAccHome(idx), 1) ThenBlock: {
                Emit_HomeMove(16, 0)
                placed = 1
            }
        }
        IfCondition EqualTo(placed, 0) ThenBlock: {
            ioff = Scope_Resolve(idx)
            rt = Scope.resolve_type
            ok = 0
            IfCondition EqualTo(rt, 1) ThenBlock: { ok = 1 }
            IfCondition EqualTo(rt, 2) ThenBlock: { ok = 1 }
            IfCondition GreaterEqual(ioff, 0) ThenBlock: { ok = 0 }
            IfCondition EqualTo(ok, 0) ThenBlock: { ReturnValue(0) }
            Emit_MovRaxRbpOffset(ioff)
            placed = 1
        }
        IfCondition GreaterThan(LoopHome.st_shift, 0) ThenBlock: {
            Emit_ShlRaxImm8(LoopHome.st_shift)
        }
        ReturnValue(placed)
    }
}

// Same product, placed in RBX. The other addend is already in RAX, so this
// does not go through RematOff. rcx, r13, r12, or the index frame slot.
Function.Optimize_RematOffRbx {
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(LoopHome.off_skip, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(LoopHome.st_on, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_NameEq(name, LoopHome.st_off), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(LoopHome.rcx_on, 1) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(LoopHome.rcx_name, LoopHome.st_off), 1) ThenBlock: {
                IfCondition EqualTo(Optimize_NameEq(LoopHome.rcx_base, LoopHome.st_base), 1) ThenBlock: {
                    Emit_MovRbxRcx()
                    ReturnValue(1)
                }
            }
        }
        IfCondition EqualTo(LoopHome.st_idx, 0) ThenBlock: { ReturnValue(0) }
        idx = AST_GetData1(LoopHome.st_idx)
        IfCondition EqualTo(idx, 0) ThenBlock: { ReturnValue(0) }
        placed = 0
        IfCondition EqualTo(Optimize_IsIntHome(idx), 1) ThenBlock: {
            Emit_MovRbxR13()
            placed = 1
        }
        IfCondition EqualTo(placed, 0) ThenBlock: {
            IfCondition EqualTo(Optimize_IsAccHome(idx), 1) ThenBlock: {
                Emit_MovRbxR12()
                placed = 1
            }
        }
        IfCondition EqualTo(placed, 0) ThenBlock: {
            ioff = Scope_Resolve(idx)
            rt = Scope.resolve_type
            ok = 0
            IfCondition EqualTo(rt, 1) ThenBlock: { ok = 1 }
            IfCondition EqualTo(rt, 2) ThenBlock: { ok = 1 }
            IfCondition GreaterEqual(ioff, 0) ThenBlock: { ok = 0 }
            IfCondition EqualTo(ok, 0) ThenBlock: { ReturnValue(0) }
            Emit_MovRbxRbpOffset(ioff)
            placed = 1
        }
        IfCondition GreaterThan(LoopHome.st_shift, 0) ThenBlock: {
            Emit_ShlRbxImm8(LoopHome.st_shift)
        }
        ReturnValue(placed)
    }
}

// Skip the frame store of off = idx<<shift when every read is base[off+disp]
// and the product can be rebuilt from the index. RAX still holds the product.
// rax_fresh stays off so a later compare does not treat RAX as this local.
Function.Optimize_TryOffSkip {
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(LoopHome.st_on, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_NameEq(name, LoopHome.st_off), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(LoopHome.ihold_on, 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(LoopHome.hold_on, 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(LoopHome.fwd_on, 1) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterThan(PinDefer.n, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_IsIntHome(name), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_IsAccHome(name), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_IsFltHome(name), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_AliasFind(name), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(LoopHome.st_idx, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(LoopHome.body, 0) ThenBlock: { ReturnValue(0) }
        idx = AST_GetData1(LoopHome.st_idx)
        IfCondition EqualTo(idx, 0) ThenBlock: { ReturnValue(0) }
        can = 0
        IfCondition EqualTo(Optimize_IsIntHome(idx), 1) ThenBlock: { can = 1 }
        IfCondition EqualTo(Optimize_IsAccHome(idx), 1) ThenBlock: { can = 1 }
        IfCondition EqualTo(can, 0) ThenBlock: {
            ioff = Scope_Resolve(idx)
            rt = Scope.resolve_type
            ok = 0
            IfCondition EqualTo(rt, 1) ThenBlock: { ok = 1 }
            IfCondition EqualTo(rt, 2) ThenBlock: { ok = 1 }
            IfCondition GreaterEqual(ioff, 0) ThenBlock: { ok = 0 }
            IfCondition EqualTo(ok, 1) ThenBlock: { can = 1 }
        }
        IfCondition EqualTo(can, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Compile.current_func, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_LiveEscape(Compile.current_func, name), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_OutsideHit(Compile.current_func, name, LoopHome.body), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_OffBad(LoopHome.body), 1) ThenBlock: { ReturnValue(0) }
        LoopHome.off_skip = 1
        Optimize_RaxPin(name, 0)
        LoopHome.rax_fresh = 0
        ReturnValue(1)
    }
}

// Emit base[index * stride + disp] when PickStride armed this loop.
// r14 keeps an invariant base. A different table already in r14 is left alone.
// A raw offset left in rcx addresses a later disp8 without reloading off.
Function.Optimize_TryStrideDeref {
    Input: addr: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(LoopHome.active, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(LoopHome.st_on, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(addr, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(addr), AST.CALL) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(StringCompare(AST_GetData1(addr), "Add"), 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetChildCount(addr), 2) ThenBlock: { ReturnValue(0) }
        base = AST_GetChild(addr, 0)
        off = AST_GetChild(addr, 1)
        IfCondition EqualTo(base, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(base), AST.IDENTIFIER) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_NameEq(AST_GetData1(base), LoopHome.st_base), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Optimize_StrideOffExpr(off, LoopHome.st_off), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(LoopHome.tab_on, 1) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(LoopHome.tab_name, LoopHome.st_base), 0) ThenBlock: { ReturnValue(0) }
        }
        disp = LoopHome.st_disp
        use_tab = 0
        IfCondition EqualTo(LoopHome.tab_on, 1) ThenBlock: { use_tab = 1 }
        // Park the raw offset in rcx before the base load. The base load
        // writes RAX, and a later disp8 uses rcx without touching it.
        rcx_hit = 0
        IfCondition EqualTo(LoopHome.rcx_on, 1) ThenBlock: {
            IfCondition EqualTo(Optimize_NameEq(LoopHome.rcx_name, LoopHome.st_off), 1) ThenBlock: {
                IfCondition EqualTo(Optimize_NameEq(LoopHome.rcx_base, LoopHome.st_base), 1) ThenBlock: {
                    rcx_hit = 1
                }
            }
        }
        IfCondition EqualTo(rcx_hit, 0) ThenBlock: {
            got = CompileExpr_LoadVariable(LoopHome.st_off)
            IfCondition EqualTo(got, 0) ThenBlock: {
                Compile.error = 1
                ReturnValue(1)
            }
            Emit_MovRcxRax()
            LoopHome.rcx_on = 1
            LoopHome.rcx_name = LoopHome.st_off
            LoopHome.rcx_base = LoopHome.st_base
        }
        IfCondition EqualTo(use_tab, 0) ThenBlock: {
            gotb = CompileExpr_LoadVariable(LoopHome.st_base)
            IfCondition EqualTo(gotb, 0) ThenBlock: {
                Compile.error = 1
                ReturnValue(1)
            }
            Emit_MovR14Rax()
        }
        IfCondition EqualTo(disp, 0) ThenBlock: {
            X86_MovRaxDerefR14RcxScaled(1)
        } ElseBlock: {
            X86_MovRaxDerefR14RcxDisp8(disp)
        }
        ReturnValue(1)
    }
}
