// Library.COptTag.ailang
// One bottom-up pass writes effects and local uses onto a side array.
// The 64-byte AST node stays as it is. Emitters do not read the tags yet.
// Loaded by the optimizer shell. No imports of its own.

// Grow the side array so every handed-out AST slot has a record.
// 48 bytes/slot: the original 32 (eff, def_id, u0, u1) plus block_id
// and pos, written by Optimize_TagSetPos for whichever nodes the CFG
// builder (Library.COptCFG.ailang) marks as a program point.
Function.Optimize_TagEnsure {
    Input: need: Integer
    Body: {
        IfCondition LessEqual(need, TagState.cap) ThenBlock: { ReturnValue(0) }
        newcap = TagState.cap
        IfCondition LessThan(newcap, 1024) ThenBlock: { newcap = 1024 }
        WhileLoop LessThan(newcap, need) {
            newcap = Multiply(newcap, 2)
        }
        nb = Allocate(Multiply(newcap, 48))
        IfCondition EqualTo(nb, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(TagState.buf, 0) ThenBlock: {
            words = Multiply(TagState.cap, 6)
            i = 0
            WhileLoop LessThan(i, words) {
                src = Add(TagState.buf, Multiply(i, 8))
                dst = Add(nb, Multiply(i, 8))
                StoreValue(dst, Dereference(src))
                i = Add(i, 1)
            }
        }
        TagState.buf = nb
        TagState.cap = newcap
        ReturnValue(0)
    }
}

// Record address, or 0 when the node is not a live slot.
Function.Optimize_TagPtr {
    Input: node: Address
    Output: Address
    Body: {
        idx = AST_SlotIndex(node)
        IfCondition LessThan(idx, 0) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterEqual(idx, TagState.cap) ThenBlock: { ReturnValue(0) }
        ReturnValue(Add(TagState.buf, Multiply(idx, 48)))
    }
}

// block_id/pos are -1 until Optimize_TagSetPos stamps them. Only
// nodes the CFG builder treats as a program point (simple statements,
// and the condition expression of If/Fork/While/Switch) get stamped;
// everything else reads back -1 from Optimize_TagBlockOf/TagPosOf.
Function.Optimize_TagSetPos {
    Input: node: Address
    Input: block_id: Integer
    Input: pos: Integer
    Body: {
        rec = Optimize_TagPtr(node)
        IfCondition EqualTo(rec, 0) ThenBlock: { ReturnValue(0) }
        StoreValue(Add(rec, 32), block_id)
        StoreValue(Add(rec, 40), pos)
        ReturnValue(0)
    }
}

Function.Optimize_TagBlockOf {
    Input: node: Address
    Output: Integer
    Body: {
        rec = Optimize_TagPtr(node)
        IfCondition EqualTo(rec, 0) ThenBlock: { ReturnValue(-1) }
        ReturnValue(Dereference(Add(rec, 32)))
    }
}

Function.Optimize_TagPosOf {
    Input: node: Address
    Output: Integer
    Body: {
        rec = Optimize_TagPtr(node)
        IfCondition EqualTo(rec, 0) ThenBlock: { ReturnValue(-1) }
        ReturnValue(Dereference(Add(rec, 40)))
    }
}

Function.Optimize_TagReset {
    Body: {
        TagState.nnames = 0
        TagState.over = 0
        IfCondition EqualTo(TagState.names, 0) ThenBlock: {
            TagState.names = Allocate(1024)
        }
        ReturnValue(0)
    }
}

// Local id in 1..128, or 0 when the name does not fit.
// A name with a "." in it is a pool field reference (Collections.foo,
// LoopHome.bar, ...), never a plain local - AILang's grammar reserves
// the dot for that. Pool access never goes through CompileExpr_
// LoadVariable/StoreVariable's normal stack-slot path at all (it has
// its own R15-relative branch that returns before either reaches a
// register-caching hook), so interning one here would hand it a real
// interval and a real allocated register that nothing ever actually
// populates or reads through - the register just sits reserved,
// pointlessly contending with whatever a real local in the same
// function needed it for.
Function.Optimize_TagIntern {
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(TagState.names, 0) ThenBlock: { ReturnValue(0) }
        nlen = StringLength(name)
        di = 0
        WhileLoop LessThan(di, nlen) {
            IfCondition EqualTo(GetByte(name, di), 46) ThenBlock: { ReturnValue(0) }
            di = Add(di, 1)
        }
        i = 0
        WhileLoop LessThan(i, TagState.nnames) {
            existing = Dereference(Add(TagState.names, Multiply(i, 8)))
            IfCondition EqualTo(Optimize_NameEq(existing, name), 1) ThenBlock: {
                ReturnValue(Add(i, 1))
            }
            i = Add(i, 1)
        }
        IfCondition GreaterEqual(TagState.nnames, 128) ThenBlock: {
            TagState.over = 1
            ReturnValue(0)
        }
        StoreValue(Add(TagState.names, Multiply(TagState.nnames, 8)), name)
        TagState.nnames = Add(TagState.nnames, 1)
        ReturnValue(TagState.nnames)
    }
}

// OR local id into the walk scratch. Id 1 is bit 0 of u0.
Function.Optimize_TagNote {
    Input: id: Integer
    Body: {
        IfCondition LessThan(id, 1) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterThan(id, 128) ThenBlock: { ReturnValue(0) }
        bit = Subtract(id, 1)
        IfCondition GreaterThan(id, 64) ThenBlock: {
            bit = Subtract(id, 65)
            mask = LeftShift(1, bit)
            TagState.u1 = BitwiseOr(TagState.u1, mask)
            ReturnValue(0)
        }
        mask = LeftShift(1, bit)
        TagState.u0 = BitwiseOr(TagState.u0, mask)
        ReturnValue(0)
    }
}

// 1 when id's bit is set on this record.
Function.Optimize_TagUses {
    Input: rec: Address
    Input: id: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(rec, 0) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(id, 1) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterThan(id, 128) ThenBlock: { ReturnValue(0) }
        bit = Subtract(id, 1)
        word = 16
        IfCondition GreaterThan(id, 64) ThenBlock: {
            bit = Subtract(id, 65)
            word = 24
        }
        mask = LeftShift(1, bit)
        val = Dereference(Add(rec, word))
        IfCondition NotEqual(BitwiseAnd(val, mask), 0) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

Function.Optimize_TagHas {
    Input: rec: Address
    Input: bit: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(rec, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(BitwiseAnd(Dereference(rec), bit), 0) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

// Bits this call adds. PURE is set only when every child record is PURE.
Function.Optimize_TagCall {
    Input: node: Address
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(name, 0) ThenBlock: {
            bits = BitwiseOr(TagBit.MEM_READ, TagBit.MEM_WRITE)
            bits = BitwiseOr(bits, TagBit.CALL)
            bits = BitwiseOr(bits, TagBit.CLOBBER)
            ReturnValue(bits)
        }
        eff = 0
        IfCondition EqualTo(Optimize_NameEq(name, "Divide"), 1) ThenBlock: {
            eff = BitwiseOr(eff, TagBit.DIV)
        }
        IfCondition EqualTo(Optimize_NameEq(name, "Modulo"), 1) ThenBlock: {
            eff = BitwiseOr(eff, TagBit.DIV)
        }
        IfCondition EqualTo(Optimize_NameEq(name, "Float_Div"), 1) ThenBlock: {
            eff = BitwiseOr(eff, TagBit.DIV)
        }
        IfCondition EqualTo(Optimize_NameEq(name, "Dereference"), 1) ThenBlock: {
            eff = BitwiseOr(eff, TagBit.MEM_READ)
            eff = BitwiseOr(eff, TagBit.DEREF)
        }
        IfCondition EqualTo(Optimize_NameEq(name, "GetByte"), 1) ThenBlock: {
            eff = BitwiseOr(eff, TagBit.MEM_READ)
        }
        IfCondition EqualTo(Optimize_NameEq(name, "StringLength"), 1) ThenBlock: {
            eff = BitwiseOr(eff, TagBit.MEM_READ)
        }
        IfCondition EqualTo(Optimize_NameEq(name, "StringCompare"), 1) ThenBlock: {
            eff = BitwiseOr(eff, TagBit.MEM_READ)
        }
        IfCondition EqualTo(Optimize_NameEq(name, "StringEquals"), 1) ThenBlock: {
            eff = BitwiseOr(eff, TagBit.MEM_READ)
        }
        IfCondition EqualTo(Optimize_NameEq(name, "Crc32String"), 1) ThenBlock: {
            eff = BitwiseOr(eff, TagBit.MEM_READ)
        }
        IfCondition EqualTo(Optimize_NameEq(name, "MemoryCopy"), 1) ThenBlock: {
            eff = BitwiseOr(eff, TagBit.MEM_READ)
            eff = BitwiseOr(eff, TagBit.MEM_WRITE)
            eff = BitwiseOr(eff, TagBit.STORE)
        }
        IfCondition EqualTo(Optimize_NameEq(name, "StoreValue"), 1) ThenBlock: {
            eff = BitwiseOr(eff, TagBit.MEM_WRITE)
            eff = BitwiseOr(eff, TagBit.STORE)
        }
        IfCondition EqualTo(Optimize_NameEq(name, "SetByte"), 1) ThenBlock: {
            eff = BitwiseOr(eff, TagBit.MEM_WRITE)
            eff = BitwiseOr(eff, TagBit.STORE)
        }
        IfCondition EqualTo(Optimize_NameEq(name, "MemorySet"), 1) ThenBlock: {
            eff = BitwiseOr(eff, TagBit.MEM_WRITE)
            eff = BitwiseOr(eff, TagBit.STORE)
        }
        IfCondition EqualTo(Optimize_NameEq(name, "AddressOf"), 1) ThenBlock: {
            eff = BitwiseOr(eff, TagBit.ESCAPE)
        }
        IfCondition EqualTo(Optimize_PureName(name), 0) ThenBlock: {
            eff = BitwiseOr(eff, TagBit.CALL)
        }
        IfCondition EqualTo(Optimize_HomeCallOk(name), 0) ThenBlock: {
            eff = BitwiseOr(eff, TagBit.MEM_READ)
            eff = BitwiseOr(eff, TagBit.MEM_WRITE)
            eff = BitwiseOr(eff, TagBit.CALL)
            IfCondition EqualTo(Optimize_HomesClobber(name), 1) ThenBlock: {
                eff = BitwiseOr(eff, TagBit.CLOBBER)
            }
        }
        IfCondition EqualTo(Optimize_PureName(name), 1) ThenBlock: {
            pure = 1
            count = AST_GetChildCount(node)
            i = 0
            WhileLoop LessThan(i, count) {
                child = AST_GetChild(node, i)
                IfCondition EqualTo(child, 0) ThenBlock: {
                    pure = 0
                } ElseBlock: {
                    cr = Optimize_TagPtr(child)
                    IfCondition EqualTo(cr, 0) ThenBlock: {
                        pure = 0
                    } ElseBlock: {
                        IfCondition EqualTo(BitwiseAnd(Dereference(cr), TagBit.PURE), 0) ThenBlock: {
                            pure = 0
                        }
                    }
                }
                i = Add(i, 1)
            }
            IfCondition EqualTo(pure, 1) ThenBlock: {
                eff = BitwiseOr(eff, TagBit.PURE)
            }
        }
        ReturnValue(eff)
    }
}

// Bits this node adds on top of its children. PURE from a child is not kept.
Function.Optimize_TagSelf {
    Input: node: Address
    Output: Integer
    Body: {
        nt = AST_GetType(node)
        eff = 0
        // INDEX_ASSIGN and INLINEASM are both type 977 today, so the old
        // walks cannot tell them apart. The tag matches both walks.
        IfCondition EqualTo(nt, AST.INLINEASM) ThenBlock: {
            eff = BitwiseOr(eff, TagBit.ASM)
            eff = BitwiseOr(eff, TagBit.STORE)
            eff = BitwiseOr(eff, TagBit.CLOBBER)
            eff = BitwiseOr(eff, TagBit.MEM_WRITE)
        }
        IfCondition EqualTo(nt, AST.EXIT_LOOP) ThenBlock: {
            eff = BitwiseOr(eff, TagBit.JUMP)
        }
        IfCondition EqualTo(nt, AST.CONTINUE_LOOP) ThenBlock: {
            eff = BitwiseOr(eff, TagBit.JUMP)
        }
        IfCondition EqualTo(Optimize_HomeBlockNode(nt), 1) ThenBlock: {
            eff = BitwiseOr(eff, TagBit.CLOBBER)
        }
        IfCondition EqualTo(nt, AST.POINTER_FIELD_ASSIGN) ThenBlock: {
            eff = BitwiseOr(eff, TagBit.STORE)
            eff = BitwiseOr(eff, TagBit.MEM_WRITE)
        }
        IfCondition EqualTo(nt, AST.NUMBER) ThenBlock: {
            eff = BitwiseOr(eff, TagBit.PURE)
        }
        IfCondition EqualTo(nt, AST.IDENTIFIER) ThenBlock: {
            Optimize_TagNote(Optimize_TagIntern(AST_GetData1(node)))
            eff = BitwiseOr(eff, TagBit.PURE)
        }
        IfCondition EqualTo(nt, AST.ASSIGNMENT) ThenBlock: {
            TagState.def_id = Optimize_TagIntern(AST_GetData1(node))
        }
        IfCondition EqualTo(nt, AST.CALL) ThenBlock: {
            eff = BitwiseOr(eff, Optimize_TagCall(node, AST_GetData1(node)))
        }
        ReturnValue(eff)
    }
}

Function.Optimize_TagBind {
    Input: node: Address
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        nt = AST_GetType(node)
        IfCondition EqualTo(nt, AST.PARAMETER) ThenBlock: {
            Optimize_TagIntern(AST_GetData1(node))
        }
        IfCondition EqualTo(nt, AST.ASSIGNMENT) ThenBlock: {
            Optimize_TagIntern(AST_GetData1(node))
        }
        IfCondition EqualTo(nt, AST.IDENTIFIER) ThenBlock: {
            Optimize_TagIntern(AST_GetData1(node))
        }
        count = AST_GetChildCount(node)
        i = 0
        WhileLoop LessThan(i, count) {
            Optimize_TagBind(AST_GetChild(node, i))
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

Function.Optimize_TagWalk {
    Input: node: Address
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        count = AST_GetChildCount(node)
        i = 0
        WhileLoop LessThan(i, count) {
            Optimize_TagWalk(AST_GetChild(node, i))
            i = Add(i, 1)
        }
        rec = Optimize_TagPtr(node)
        IfCondition EqualTo(rec, 0) ThenBlock: { ReturnValue(0) }
        TagState.u0 = 0
        TagState.u1 = 0
        TagState.def_id = 0
        eff = 0
        pure_mask = BitwiseNot(TagBit.PURE)
        i = 0
        WhileLoop LessThan(i, count) {
            child = AST_GetChild(node, i)
            cr = Optimize_TagPtr(child)
            IfCondition NotEqual(cr, 0) ThenBlock: {
                ce = BitwiseAnd(Dereference(cr), pure_mask)
                eff = BitwiseOr(eff, ce)
                TagState.u0 = BitwiseOr(TagState.u0, Dereference(Add(cr, 16)))
                TagState.u1 = BitwiseOr(TagState.u1, Dereference(Add(cr, 24)))
            }
            i = Add(i, 1)
        }
        eff = BitwiseOr(eff, Optimize_TagSelf(node))
        StoreValue(rec, eff)
        StoreValue(Add(rec, 8), TagState.def_id)
        StoreValue(Add(rec, 16), TagState.u0)
        StoreValue(Add(rec, 24), TagState.u1)
        StoreValue(Add(rec, 32), -1)   // block_id: not a program point until CFG says otherwise
        ReturnValue(0)
    }
}

// 1 when got and want disagree. Both are treated as flags.
Function.Optimize_TagDiff {
    Input: got: Integer
    Input: want: Integer
    Output: Integer
    Body: {
        g = 0
        w = 0
        IfCondition NotEqual(got, 0) ThenBlock: { g = 1 }
        IfCondition NotEqual(want, 0) ThenBlock: { w = 1 }
        IfCondition NotEqual(g, w) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

Function.Optimize_TagAuditNode {
    Input: node: Address
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        rec = Optimize_TagPtr(node)
        TagState.nodes = Add(TagState.nodes, 1)
        IfCondition EqualTo(rec, 0) ThenBlock: {
            TagState.miss_slot = Add(TagState.miss_slot, 1)
        } ElseBlock: {
            IfCondition EqualTo(Optimize_TagDiff(Optimize_TagHas(rec, TagBit.PURE), Optimize_PureExpr(node)), 1) ThenBlock: {
                TagState.miss_pure = Add(TagState.miss_pure, 1)
            }
            IfCondition EqualTo(Optimize_TagDiff(Optimize_TagHas(rec, TagBit.DEREF), Optimize_TreeHasDeref(node)), 1) ThenBlock: {
                TagState.miss_deref = Add(TagState.miss_deref, 1)
            }
            IfCondition EqualTo(Optimize_TagDiff(Optimize_TagHas(rec, TagBit.ASM), Optimize_TreeHasAsm(node)), 1) ThenBlock: {
                TagState.miss_asm = Add(TagState.miss_asm, 1)
            }
            IfCondition EqualTo(Optimize_TagDiff(Optimize_TagHas(rec, TagBit.STORE), Optimize_TreeHasStore(node)), 1) ThenBlock: {
                TagState.miss_store = Add(TagState.miss_store, 1)
            }
            IfCondition EqualTo(Optimize_TagDiff(Optimize_TagHas(rec, TagBit.JUMP), Optimize_TreeHasJump(node)), 1) ThenBlock: {
                TagState.miss_jump = Add(TagState.miss_jump, 1)
            }
            IfCondition EqualTo(Optimize_TagDiff(Optimize_TagHas(rec, TagBit.CLOBBER), Optimize_NodeClobbers(node)), 1) ThenBlock: {
                TagState.miss_clob = Add(TagState.miss_clob, 1)
            }
            IfCondition EqualTo(TagState.over, 0) ThenBlock: {
                n = 0
                WhileLoop LessThan(n, TagState.nnames) {
                    id = Add(n, 1)
                    nm = Dereference(Add(TagState.names, Multiply(n, 8)))
                    want = 0
                    IfCondition GreaterThan(Optimize_CountIdents(node, nm), 0) ThenBlock: { want = 1 }
                    IfCondition EqualTo(Optimize_TagDiff(Optimize_TagUses(rec, id), want), 1) ThenBlock: {
                        TagState.miss_use = Add(TagState.miss_use, 1)
                    }
                    n = Add(n, 1)
                }
            }
        }
        count = AST_GetChildCount(node)
        i = 0
        WhileLoop LessThan(i, count) {
            Optimize_TagAuditNode(AST_GetChild(node, i))
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

// 1 when AILANG_TAG_AUDIT=1 is in the environment. Cached after the first read.
Function.Optimize_TagWantAudit {
    Output: Integer
    Body: {
        IfCondition GreaterEqual(TagState.audit, 0) ThenBlock: { ReturnValue(TagState.audit) }
        TagState.audit = 0
        envpath = "/proc/self/environ"
        env_fd = SystemCall(2, envpath, 0, 0)
        IfCondition LessThan(env_fd, 0) ThenBlock: { ReturnValue(0) }
        env_bufsz = 131072
        env_buf = Allocate(env_bufsz)
        env_n = SystemCall(0, env_fd, env_buf, env_bufsz)
        SystemCall(3, env_fd, 0, 0)
        needle = "AILANG_TAG_AUDIT="
        nlen = 17
        found = 0
        ei = 0
        elimit = Subtract(env_n, nlen)
        WhileLoop LessEqual(ei, elimit) {
            IfCondition EqualTo(found, 1) ThenBlock: {
                ExitLoop
            }
            match = 1
            ej = 0
            WhileLoop LessThan(ej, nlen) {
                bc = GetByte(env_buf, Add(ei, ej))
                nc = GetByte(needle, ej)
                IfCondition NotEqual(bc, nc) ThenBlock: { match = 0 }
                ej = Add(ej, 1)
            }
            IfCondition EqualTo(match, 1) ThenBlock: {
                vc = GetByte(env_buf, Add(ei, nlen))
                IfCondition EqualTo(vc, 49) ThenBlock: {
                    TagState.audit = 1
                }
                found = 1
            }
            ei = Add(ei, 1)
        }
        Deallocate(env_buf, env_bufsz)
        ReturnValue(TagState.audit)
    }
}

Function.Optimize_TagReport {
    Input: node: Address
    Body: {
        name = AST_GetData1(node)
        PrintMessage("TAG ")
        IfCondition EqualTo(name, 0) ThenBlock: {
            PrintMessage("?")
        } ElseBlock: {
            PrintMessage(name)
        }
        PrintMessage(" nodes ")
        PrintNumber(TagState.nodes)
        PrintMessage(" pure ")
        PrintNumber(TagState.miss_pure)
        PrintMessage(" deref ")
        PrintNumber(TagState.miss_deref)
        PrintMessage(" asm ")
        PrintNumber(TagState.miss_asm)
        PrintMessage(" store ")
        PrintNumber(TagState.miss_store)
        PrintMessage(" jump ")
        PrintNumber(TagState.miss_jump)
        PrintMessage(" clob ")
        PrintNumber(TagState.miss_clob)
        PrintMessage(" use ")
        PrintNumber(TagState.miss_use)
        PrintMessage(" slot ")
        PrintNumber(TagState.miss_slot)
        PrintMessage(" over ")
        PrintNumber(TagState.over)
        PrintMessage("\n")
        ReturnValue(0)
    }
}

// Fill tags for one function or subroutine. Emitters do not read them.
// AILANG_TAG_AUDIT=1 also checks the tags against the old tree walks.
Function.Optimize_TagFunction {
    Input: node: Address
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        Optimize_TagReset()
        IfCondition EqualTo(TagState.names, 0) ThenBlock: { ReturnValue(0) }
        Optimize_TagBind(node)
        Optimize_TagEnsure(AST_SlotHead())
        IfCondition EqualTo(TagState.buf, 0) ThenBlock: { ReturnValue(0) }
        Optimize_TagWalk(node)
        IfCondition EqualTo(Optimize_TagWantAudit(), 1) ThenBlock: {
            TagState.nodes = 0
            TagState.miss_pure = 0
            TagState.miss_deref = 0
            TagState.miss_asm = 0
            TagState.miss_store = 0
            TagState.miss_jump = 0
            TagState.miss_clob = 0
            TagState.miss_use = 0
            TagState.miss_slot = 0
            Optimize_TagAuditNode(node)
            Optimize_TagReport(node)
        }
        ReturnValue(0)
    }
}
