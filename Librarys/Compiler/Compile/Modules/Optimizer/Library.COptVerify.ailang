// Library.COptVerify.ailang
// After emission, walk each linear-scan register home. Flag an instruction
// that writes that register and is not the value's own definition.
// A call writes rax, rcx, rdx, rsi, rdi, and r8-r11. DIV/IDIV/MUL write
// rax and rdx and are never treated as an in-place update.
// Records are 32 bytes: id, reg, def_pos, end_pos. end_pos -1 is still open.
// A clobber still prints one "VERIFY hits N" line. The per-instruction
// dump prints only when AILANG_VERIFY=1.

FixedPool.VerifyState {
    "recs": Initialize=0, CanChange=True
    "n": Initialize=0, CanChange=True
    "bad": Initialize=0, CanChange=True
    "full": Initialize=0, CanChange=True
    "hex": Initialize=0, CanChange=True
    "trace": Initialize=-1, CanChange=True
}

FixedPool.VerifyDec {
    "pos": Initialize=0, CanChange=True
    "lim": Initialize=0, CanChange=True
    "rex": Initialize=0, CanChange=True
    "rex_w": Initialize=0, CanChange=True
    "rex_r": Initialize=0, CanChange=True
    "rex_x": Initialize=0, CanChange=True
    "rex_b": Initialize=0, CanChange=True
    "p66": Initialize=0, CanChange=True
    "p67": Initialize=0, CanChange=True
    "pf2": Initialize=0, CanChange=True
    "pf3": Initialize=0, CanChange=True
    "bad": Initialize=0, CanChange=True
    "wmask": Initialize=0, CanChange=True
    "rmask": Initialize=0, CanChange=True
    "force": Initialize=0, CanChange=True
    "mod": Initialize=0, CanChange=True
    "ext": Initialize=0, CanChange=True
    "greg": Initialize=0, CanChange=True
    "grm": Initialize=-1, CanChange=True
}

Function.Optimize_VerifyReset {
    Body: {
        VerifyState.n = 0
        VerifyState.bad = 0
        ReturnValue(0)
    }
}

Function.Optimize_VerifyPtr {
    Input: index: Integer
    Output: Address
    Body: {
        ReturnValue(Add(VerifyState.recs, Multiply(index, 32)))
    }
}

Function.Optimize_VerifyFindOpen {
    Input: id: Integer
    Output: Integer
    Body: {
        i = 0
        found = -1
        WhileLoop LessThan(i, VerifyState.n) {
            p = Optimize_VerifyPtr(i)
            rid = Dereference(p)
            endp = Dereference(Add(p, 24))
            IfCondition EqualTo(rid, id) ThenBlock: {
                IfCondition EqualTo(endp, -1) ThenBlock: {
                    found = i
                }
            }
            i = Add(i, 1)
        }
        ReturnValue(found)
    }
}

Function.Optimize_VerifyEnd {
    Input: id: Integer
    Body: {
        slot = Optimize_VerifyFindOpen(id)
        IfCondition LessThan(slot, 0) ThenBlock: { ReturnValue(0) }
        p = Optimize_VerifyPtr(slot)
        StoreValue(Add(p, 24), Emit_GetPosition())
        ReturnValue(0)
    }
}

Function.Optimize_VerifyBegin {
    Input: id: Integer
    Input: reg: Integer
    Body: {
        IfCondition LessThan(reg, 0) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterThan(reg, 15) ThenBlock: { ReturnValue(0) }
        xmm = Optimize_ScanXmm(reg)
        IfCondition GreaterEqual(xmm, 0) ThenBlock: { ReturnValue(0) }
        Optimize_VerifyEnd(id)
        IfCondition EqualTo(VerifyState.recs, 0) ThenBlock: {
            VerifyState.recs = Allocate(32768)
        }
        IfCondition EqualTo(VerifyState.recs, 0) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterEqual(VerifyState.n, 1024) ThenBlock: {
            IfCondition EqualTo(VerifyState.full, 0) ThenBlock: {
                PrintMessage("VERIFY_FULL\n")
                VerifyState.full = 1
            }
            ReturnValue(0)
        }
        p = Optimize_VerifyPtr(VerifyState.n)
        StoreValue(p, id)
        StoreValue(Add(p, 8), reg)
        StoreValue(Add(p, 16), Emit_GetPosition())
        StoreValue(Add(p, 24), -1)
        VerifyState.n = Add(VerifyState.n, 1)
        ReturnValue(0)
    }
}

Function.Optimize_VerifyW {
    Input: reg: Integer
    Body: {
        IfCondition LessThan(reg, 0) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterThan(reg, 15) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(reg, 4) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(reg, 5) ThenBlock: { ReturnValue(0) }
        VerifyDec.wmask = BitwiseOr(VerifyDec.wmask, LeftShift(1, reg))
        ReturnValue(0)
    }
}

Function.Optimize_VerifyR {
    Input: reg: Integer
    Body: {
        IfCondition LessThan(reg, 0) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterThan(reg, 15) ThenBlock: { ReturnValue(0) }
        VerifyDec.rmask = BitwiseOr(VerifyDec.rmask, LeftShift(1, reg))
        ReturnValue(0)
    }
}

Function.Optimize_VerifyCallers {
    Body: {
        Optimize_VerifyW(0)
        Optimize_VerifyW(1)
        Optimize_VerifyW(2)
        Optimize_VerifyW(6)
        Optimize_VerifyW(7)
        Optimize_VerifyW(8)
        Optimize_VerifyW(9)
        Optimize_VerifyW(10)
        Optimize_VerifyW(11)
        VerifyDec.force = 1
        ReturnValue(0)
    }
}

Function.Optimize_VerifyTake {
    Output: Integer
    Body: {
        IfCondition GreaterEqual(VerifyDec.pos, VerifyDec.lim) ThenBlock: {
            VerifyDec.bad = 1
            ReturnValue(0)
        }
        b = GetByte(Emit.code, VerifyDec.pos)
        VerifyDec.pos = Add(VerifyDec.pos, 1)
        ReturnValue(b)
    }
}

Function.Optimize_VerifySkip {
    Input: n: Integer
    Body: {
        nxt = Add(VerifyDec.pos, n)
        IfCondition GreaterThan(nxt, VerifyDec.lim) ThenBlock: {
            VerifyDec.bad = 1
            ReturnValue(0)
        }
        VerifyDec.pos = nxt
        ReturnValue(0)
    }
}

Function.Optimize_VerifyPrefixes {
    Body: {
        n = 0
        WhileLoop LessThan(n, 14) {
            IfCondition GreaterEqual(VerifyDec.pos, VerifyDec.lim) ThenBlock: {
                VerifyDec.bad = 1
                ReturnValue(0)
            }
            b = GetByte(Emit.code, VerifyDec.pos)
            kind = 0
            IfCondition EqualTo(b, 0xF0) ThenBlock: { kind = 1 }
            IfCondition EqualTo(b, 0xF2) ThenBlock: { kind = 2 }
            IfCondition EqualTo(b, 0xF3) ThenBlock: { kind = 3 }
            IfCondition EqualTo(b, 0x66) ThenBlock: { kind = 4 }
            IfCondition EqualTo(b, 0x67) ThenBlock: { kind = 5 }
            IfCondition EqualTo(b, 0x2E) ThenBlock: { kind = 1 }
            IfCondition EqualTo(b, 0x36) ThenBlock: { kind = 1 }
            IfCondition EqualTo(b, 0x26) ThenBlock: { kind = 1 }
            IfCondition EqualTo(b, 0x3E) ThenBlock: { kind = 1 }
            IfCondition EqualTo(b, 0x64) ThenBlock: { kind = 1 }
            IfCondition EqualTo(b, 0x65) ThenBlock: { kind = 1 }
            IfCondition EqualTo(kind, 2) ThenBlock: { VerifyDec.pf2 = 1 }
            IfCondition EqualTo(kind, 3) ThenBlock: { VerifyDec.pf3 = 1 }
            IfCondition EqualTo(kind, 4) ThenBlock: { VerifyDec.p66 = 1 }
            IfCondition EqualTo(kind, 5) ThenBlock: { VerifyDec.p67 = 1 }
            IfCondition GreaterThan(kind, 0) ThenBlock: {
                VerifyDec.pos = Add(VerifyDec.pos, 1)
            }
            rex = 0
            IfCondition EqualTo(kind, 0) ThenBlock: {
                IfCondition GreaterEqual(b, 0x40) ThenBlock: {
                    IfCondition LessEqual(b, 0x4F) ThenBlock: { rex = 1 }
                }
            }
            IfCondition EqualTo(rex, 1) ThenBlock: {
                VerifyDec.rex = b
                VerifyDec.pos = Add(VerifyDec.pos, 1)
                ReturnValue(0)
            }
            IfCondition EqualTo(kind, 0) ThenBlock: { ReturnValue(0) }
            n = Add(n, 1)
        }
        VerifyDec.bad = 1
        ReturnValue(0)
    }
}

Function.Optimize_VerifySib {
    Input: mode: Integer
    Body: {
        sib = Optimize_VerifyTake()
        IfCondition EqualTo(VerifyDec.bad, 1) ThenBlock: { ReturnValue(0) }
        idx3 = BitwiseAnd(RightShift(sib, 3), 7)
        base3 = BitwiseAnd(sib, 7)
        none = 0
        IfCondition EqualTo(idx3, 4) ThenBlock: {
            IfCondition EqualTo(VerifyDec.rex_x, 0) ThenBlock: { none = 1 }
        }
        IfCondition EqualTo(none, 0) ThenBlock: {
            idx = idx3
            IfCondition EqualTo(VerifyDec.rex_x, 1) ThenBlock: {
                idx = Add(idx, 8)
            }
            Optimize_VerifyR(idx)
        }
        IfCondition EqualTo(mode, 0) ThenBlock: {
            IfCondition EqualTo(base3, 5) ThenBlock: {
                Optimize_VerifySkip(4)
                ReturnValue(0)
            }
        }
        base = base3
        IfCondition EqualTo(VerifyDec.rex_b, 1) ThenBlock: {
            base = Add(base, 8)
        }
        Optimize_VerifyR(base)
        IfCondition EqualTo(mode, 1) ThenBlock: { Optimize_VerifySkip(1) }
        IfCondition EqualTo(mode, 2) ThenBlock: { Optimize_VerifySkip(4) }
        ReturnValue(0)
    }
}

Function.Optimize_VerifyEatModrm {
    Body: {
        modrm = Optimize_VerifyTake()
        IfCondition EqualTo(VerifyDec.bad, 1) ThenBlock: { ReturnValue(0) }
        mode = RightShift(modrm, 6)
        reg3 = BitwiseAnd(RightShift(modrm, 3), 7)
        rm3 = BitwiseAnd(modrm, 7)
        VerifyDec.mod = mode
        VerifyDec.ext = reg3
        greg = reg3
        IfCondition EqualTo(VerifyDec.rex_r, 1) ThenBlock: {
            greg = Add(greg, 8)
        }
        VerifyDec.greg = greg
        VerifyDec.grm = -1
        IfCondition EqualTo(mode, 3) ThenBlock: {
            grm = rm3
            IfCondition EqualTo(VerifyDec.rex_b, 1) ThenBlock: {
                grm = Add(grm, 8)
            }
            VerifyDec.grm = grm
            ReturnValue(0)
        }
        IfCondition EqualTo(rm3, 4) ThenBlock: {
            Optimize_VerifySib(mode)
            ReturnValue(0)
        }
        IfCondition EqualTo(mode, 0) ThenBlock: {
            IfCondition EqualTo(rm3, 5) ThenBlock: {
                Optimize_VerifySkip(4)
                ReturnValue(0)
            }
        }
        base = rm3
        IfCondition EqualTo(VerifyDec.rex_b, 1) ThenBlock: {
            base = Add(base, 8)
        }
        Optimize_VerifyR(base)
        IfCondition EqualTo(mode, 1) ThenBlock: { Optimize_VerifySkip(1) }
        IfCondition EqualTo(mode, 2) ThenBlock: { Optimize_VerifySkip(4) }
        ReturnValue(0)
    }
}

Function.Optimize_VerifyAlu {
    Input: op: Integer
    Body: {
        row = RightShift(op, 3)
        form = BitwiseAnd(op, 7)
        IfCondition GreaterEqual(form, 6) ThenBlock: {
            VerifyDec.bad = 1
            ReturnValue(0)
        }
        cmp = 0
        IfCondition EqualTo(row, 7) ThenBlock: { cmp = 1 }
        IfCondition EqualTo(form, 4) ThenBlock: {
            Optimize_VerifySkip(1)
            Optimize_VerifyR(0)
            IfCondition EqualTo(cmp, 0) ThenBlock: { Optimize_VerifyW(0) }
            ReturnValue(0)
        }
        IfCondition EqualTo(form, 5) ThenBlock: {
            Optimize_VerifySkip(4)
            Optimize_VerifyR(0)
            IfCondition EqualTo(cmp, 0) ThenBlock: { Optimize_VerifyW(0) }
            ReturnValue(0)
        }
        Optimize_VerifyEatModrm()
        IfCondition LessEqual(form, 1) ThenBlock: {
            Optimize_VerifyR(VerifyDec.greg)
            IfCondition EqualTo(VerifyDec.mod, 3) ThenBlock: {
                Optimize_VerifyR(VerifyDec.grm)
                IfCondition EqualTo(cmp, 0) ThenBlock: { Optimize_VerifyW(VerifyDec.grm) }
            }
            ReturnValue(0)
        }
        Optimize_VerifyR(VerifyDec.greg)
        IfCondition EqualTo(cmp, 0) ThenBlock: { Optimize_VerifyW(VerifyDec.greg) }
        IfCondition EqualTo(VerifyDec.mod, 3) ThenBlock: { Optimize_VerifyR(VerifyDec.grm) }
        ReturnValue(0)
    }
}

Function.Optimize_VerifyGrpImm {
    Input: imm: Integer
    Body: {
        Optimize_VerifyEatModrm()
        Optimize_VerifySkip(imm)
        IfCondition EqualTo(VerifyDec.ext, 7) ThenBlock: {
            IfCondition EqualTo(VerifyDec.mod, 3) ThenBlock: { Optimize_VerifyR(VerifyDec.grm) }
            ReturnValue(0)
        }
        IfCondition EqualTo(VerifyDec.mod, 3) ThenBlock: {
            Optimize_VerifyR(VerifyDec.grm)
            Optimize_VerifyW(VerifyDec.grm)
        }
        ReturnValue(0)
    }
}

Function.Optimize_VerifyShift {
    Input: imm: Integer
    Input: by_cl: Integer
    Body: {
        Optimize_VerifyEatModrm()
        IfCondition GreaterThan(imm, 0) ThenBlock: { Optimize_VerifySkip(imm) }
        IfCondition EqualTo(by_cl, 1) ThenBlock: { Optimize_VerifyR(1) }
        IfCondition EqualTo(VerifyDec.mod, 3) ThenBlock: {
            Optimize_VerifyR(VerifyDec.grm)
            Optimize_VerifyW(VerifyDec.grm)
        }
        ReturnValue(0)
    }
}

Function.Optimize_VerifyTest {
    Body: {
        Optimize_VerifyEatModrm()
        Optimize_VerifyR(VerifyDec.greg)
        IfCondition EqualTo(VerifyDec.mod, 3) ThenBlock: { Optimize_VerifyR(VerifyDec.grm) }
        ReturnValue(0)
    }
}

Function.Optimize_VerifyXchg {
    Body: {
        Optimize_VerifyEatModrm()
        Optimize_VerifyW(VerifyDec.greg)
        IfCondition EqualTo(VerifyDec.mod, 3) ThenBlock: { Optimize_VerifyW(VerifyDec.grm) }
        VerifyDec.force = 1
        ReturnValue(0)
    }
}

Function.Optimize_VerifyMov {
    Input: to_reg: Integer
    Body: {
        Optimize_VerifyEatModrm()
        IfCondition EqualTo(to_reg, 1) ThenBlock: {
            Optimize_VerifyW(VerifyDec.greg)
            IfCondition EqualTo(VerifyDec.mod, 3) ThenBlock: { Optimize_VerifyR(VerifyDec.grm) }
            ReturnValue(0)
        }
        Optimize_VerifyR(VerifyDec.greg)
        IfCondition EqualTo(VerifyDec.mod, 3) ThenBlock: { Optimize_VerifyW(VerifyDec.grm) }
        ReturnValue(0)
    }
}

Function.Optimize_VerifyImulImm {
    Input: imm: Integer
    Body: {
        Optimize_VerifyEatModrm()
        Optimize_VerifySkip(imm)
        Optimize_VerifyW(VerifyDec.greg)
        IfCondition EqualTo(VerifyDec.mod, 3) ThenBlock: { Optimize_VerifyR(VerifyDec.grm) }
        ReturnValue(0)
    }
}

Function.Optimize_VerifyF7 {
    Input: wide: Integer
    Body: {
        Optimize_VerifyEatModrm()
        IfCondition LessEqual(VerifyDec.ext, 1) ThenBlock: {
            IfCondition EqualTo(wide, 1) ThenBlock: { Optimize_VerifySkip(4) }
            IfCondition EqualTo(wide, 0) ThenBlock: { Optimize_VerifySkip(1) }
            IfCondition EqualTo(VerifyDec.mod, 3) ThenBlock: { Optimize_VerifyR(VerifyDec.grm) }
            ReturnValue(0)
        }
        IfCondition LessEqual(VerifyDec.ext, 3) ThenBlock: {
            IfCondition EqualTo(VerifyDec.mod, 3) ThenBlock: {
                Optimize_VerifyR(VerifyDec.grm)
                Optimize_VerifyW(VerifyDec.grm)
            }
            ReturnValue(0)
        }
        Optimize_VerifyR(0)
        Optimize_VerifyR(2)
        Optimize_VerifyW(0)
        Optimize_VerifyW(2)
        IfCondition EqualTo(VerifyDec.mod, 3) ThenBlock: { Optimize_VerifyR(VerifyDec.grm) }
        VerifyDec.force = 1
        ReturnValue(0)
    }
}

Function.Optimize_VerifyFF {
    Body: {
        Optimize_VerifyEatModrm()
        IfCondition LessEqual(VerifyDec.ext, 1) ThenBlock: {
            IfCondition EqualTo(VerifyDec.mod, 3) ThenBlock: {
                Optimize_VerifyR(VerifyDec.grm)
                Optimize_VerifyW(VerifyDec.grm)
            }
            ReturnValue(0)
        }
        IfCondition EqualTo(VerifyDec.ext, 2) ThenBlock: {
            Optimize_VerifyCallers()
            ReturnValue(0)
        }
        IfCondition EqualTo(VerifyDec.ext, 3) ThenBlock: {
            Optimize_VerifyCallers()
            ReturnValue(0)
        }
        IfCondition EqualTo(VerifyDec.ext, 6) ThenBlock: {
            IfCondition EqualTo(VerifyDec.mod, 3) ThenBlock: { Optimize_VerifyR(VerifyDec.grm) }
        }
        ReturnValue(0)
    }
}

Function.Optimize_VerifyString {
    Input: op: Integer
    Body: {
        IfCondition EqualTo(VerifyDec.pf2, 1) ThenBlock: { Optimize_VerifyW(1) }
        IfCondition EqualTo(VerifyDec.pf3, 1) ThenBlock: { Optimize_VerifyW(1) }
        IfCondition EqualTo(op, 0xA4) ThenBlock: {
            Optimize_VerifyW(6)
            Optimize_VerifyW(7)
        }
        IfCondition EqualTo(op, 0xA5) ThenBlock: {
            Optimize_VerifyW(6)
            Optimize_VerifyW(7)
        }
        IfCondition EqualTo(op, 0xA6) ThenBlock: {
            Optimize_VerifyW(6)
            Optimize_VerifyW(7)
        }
        IfCondition EqualTo(op, 0xA7) ThenBlock: {
            Optimize_VerifyW(6)
            Optimize_VerifyW(7)
        }
        IfCondition EqualTo(op, 0xAA) ThenBlock: { Optimize_VerifyW(7) }
        IfCondition EqualTo(op, 0xAB) ThenBlock: { Optimize_VerifyW(7) }
        IfCondition EqualTo(op, 0xAC) ThenBlock: {
            Optimize_VerifyW(6)
            Optimize_VerifyW(0)
        }
        IfCondition EqualTo(op, 0xAD) ThenBlock: {
            Optimize_VerifyW(6)
            Optimize_VerifyW(0)
        }
        IfCondition EqualTo(op, 0xAE) ThenBlock: { Optimize_VerifyW(7) }
        IfCondition EqualTo(op, 0xAF) ThenBlock: { Optimize_VerifyW(7) }
        IfCondition EqualTo(op, 0x6C) ThenBlock: { Optimize_VerifyW(7) }
        IfCondition EqualTo(op, 0x6D) ThenBlock: { Optimize_VerifyW(7) }
        IfCondition EqualTo(op, 0x6E) ThenBlock: { Optimize_VerifyW(6) }
        IfCondition EqualTo(op, 0x6F) ThenBlock: { Optimize_VerifyW(6) }
        VerifyDec.force = 1
        ReturnValue(0)
    }
}

Function.Optimize_VerifyOpReg {
    Input: op: Integer
    Input: base: Integer
    Output: Integer
    Body: {
        rd = Subtract(op, base)
        IfCondition EqualTo(VerifyDec.rex_b, 1) ThenBlock: {
            rd = Add(rd, 8)
        }
        ReturnValue(rd)
    }
}

Function.Optimize_VerifyOp50 {
    Input: op: Integer
    Body: {
        IfCondition LessEqual(op, 0x57) ThenBlock: {
            Optimize_VerifyR(Optimize_VerifyOpReg(op, 0x50))
            ReturnValue(0)
        }
        IfCondition LessEqual(op, 0x5F) ThenBlock: {
            Optimize_VerifyW(Optimize_VerifyOpReg(op, 0x58))
            ReturnValue(0)
        }
        IfCondition EqualTo(op, 0x68) ThenBlock: {
            Optimize_VerifySkip(4)
            ReturnValue(0)
        }
        IfCondition EqualTo(op, 0x6A) ThenBlock: {
            Optimize_VerifySkip(1)
            ReturnValue(0)
        }
        IfCondition EqualTo(op, 0x69) ThenBlock: {
            Optimize_VerifyImulImm(4)
            ReturnValue(0)
        }
        IfCondition EqualTo(op, 0x6B) ThenBlock: {
            Optimize_VerifyImulImm(1)
            ReturnValue(0)
        }
        IfCondition GreaterEqual(op, 0x6C) ThenBlock: {
            IfCondition LessEqual(op, 0x6F) ThenBlock: {
                Optimize_VerifyString(op)
                ReturnValue(0)
            }
        }
        VerifyDec.bad = 1
        ReturnValue(0)
    }
}

Function.Optimize_VerifyOp70 {
    Input: op: Integer
    Body: {
        IfCondition LessEqual(op, 0x7F) ThenBlock: {
            Optimize_VerifySkip(1)
            ReturnValue(0)
        }
        IfCondition EqualTo(op, 0x80) ThenBlock: {
            Optimize_VerifyGrpImm(1)
            ReturnValue(0)
        }
        IfCondition EqualTo(op, 0x81) ThenBlock: {
            Optimize_VerifyGrpImm(4)
            ReturnValue(0)
        }
        IfCondition EqualTo(op, 0x82) ThenBlock: {
            Optimize_VerifyGrpImm(1)
            ReturnValue(0)
        }
        IfCondition EqualTo(op, 0x83) ThenBlock: {
            Optimize_VerifyGrpImm(1)
            ReturnValue(0)
        }
        IfCondition EqualTo(op, 0x84) ThenBlock: {
            Optimize_VerifyTest()
            ReturnValue(0)
        }
        IfCondition EqualTo(op, 0x85) ThenBlock: {
            Optimize_VerifyTest()
            ReturnValue(0)
        }
        IfCondition EqualTo(op, 0x86) ThenBlock: {
            Optimize_VerifyXchg()
            ReturnValue(0)
        }
        IfCondition EqualTo(op, 0x87) ThenBlock: {
            Optimize_VerifyXchg()
            ReturnValue(0)
        }
        IfCondition EqualTo(op, 0x88) ThenBlock: {
            Optimize_VerifyMov(0)
            ReturnValue(0)
        }
        IfCondition EqualTo(op, 0x89) ThenBlock: {
            Optimize_VerifyMov(0)
            ReturnValue(0)
        }
        IfCondition EqualTo(op, 0x8A) ThenBlock: {
            Optimize_VerifyMov(1)
            ReturnValue(0)
        }
        IfCondition EqualTo(op, 0x8B) ThenBlock: {
            Optimize_VerifyMov(1)
            ReturnValue(0)
        }
        IfCondition EqualTo(op, 0x8C) ThenBlock: {
            Optimize_VerifyEatModrm()
            IfCondition EqualTo(VerifyDec.mod, 3) ThenBlock: { Optimize_VerifyW(VerifyDec.grm) }
            ReturnValue(0)
        }
        IfCondition EqualTo(op, 0x8D) ThenBlock: {
            Optimize_VerifyEatModrm()
            Optimize_VerifyW(VerifyDec.greg)
            ReturnValue(0)
        }
        IfCondition EqualTo(op, 0x8E) ThenBlock: {
            Optimize_VerifyEatModrm()
            ReturnValue(0)
        }
        IfCondition EqualTo(op, 0x8F) ThenBlock: {
            Optimize_VerifyEatModrm()
            IfCondition EqualTo(VerifyDec.mod, 3) ThenBlock: {
                IfCondition EqualTo(VerifyDec.ext, 0) ThenBlock: { Optimize_VerifyW(VerifyDec.grm) }
            }
            ReturnValue(0)
        }
        VerifyDec.bad = 1
        ReturnValue(0)
    }
}

Function.Optimize_VerifyMoffs {
    Output: Integer
    Body: {
        n = 8
        IfCondition EqualTo(VerifyDec.p67, 1) ThenBlock: { n = 4 }
        ReturnValue(n)
    }
}

Function.Optimize_VerifyOp90 {
    Input: op: Integer
    Body: {
        IfCondition LessEqual(op, 0x97) ThenBlock: {
            rd = Optimize_VerifyOpReg(op, 0x90)
            IfCondition EqualTo(rd, 0) ThenBlock: { ReturnValue(0) }
            Optimize_VerifyW(0)
            Optimize_VerifyW(rd)
            VerifyDec.force = 1
            ReturnValue(0)
        }
        IfCondition EqualTo(op, 0x98) ThenBlock: {
            Optimize_VerifyR(0)
            Optimize_VerifyW(0)
            ReturnValue(0)
        }
        IfCondition EqualTo(op, 0x99) ThenBlock: {
            Optimize_VerifyR(0)
            Optimize_VerifyW(2)
            ReturnValue(0)
        }
        IfCondition EqualTo(op, 0x9B) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(op, 0x9C) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(op, 0x9D) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(op, 0x9E) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(op, 0x9F) ThenBlock: {
            Optimize_VerifyW(0)
            ReturnValue(0)
        }
        IfCondition EqualTo(op, 0xA0) ThenBlock: {
            Optimize_VerifySkip(Optimize_VerifyMoffs())
            Optimize_VerifyW(0)
            ReturnValue(0)
        }
        IfCondition EqualTo(op, 0xA1) ThenBlock: {
            Optimize_VerifySkip(Optimize_VerifyMoffs())
            Optimize_VerifyW(0)
            ReturnValue(0)
        }
        IfCondition EqualTo(op, 0xA2) ThenBlock: {
            Optimize_VerifySkip(Optimize_VerifyMoffs())
            Optimize_VerifyR(0)
            ReturnValue(0)
        }
        IfCondition EqualTo(op, 0xA3) ThenBlock: {
            Optimize_VerifySkip(Optimize_VerifyMoffs())
            Optimize_VerifyR(0)
            ReturnValue(0)
        }
        IfCondition EqualTo(op, 0xA8) ThenBlock: {
            Optimize_VerifySkip(1)
            Optimize_VerifyR(0)
            ReturnValue(0)
        }
        IfCondition EqualTo(op, 0xA9) ThenBlock: {
            Optimize_VerifySkip(4)
            Optimize_VerifyR(0)
            ReturnValue(0)
        }
        IfCondition GreaterEqual(op, 0xA4) ThenBlock: {
            IfCondition LessEqual(op, 0xAF) ThenBlock: {
                Optimize_VerifyString(op)
                ReturnValue(0)
            }
        }
        VerifyDec.bad = 1
        ReturnValue(0)
    }
}

Function.Optimize_VerifyOpB0 {
    Input: op: Integer
    Body: {
        IfCondition LessEqual(op, 0xB7) ThenBlock: {
            Optimize_VerifyW(Optimize_VerifyOpReg(op, 0xB0))
            Optimize_VerifySkip(1)
            ReturnValue(0)
        }
        IfCondition LessEqual(op, 0xBF) ThenBlock: {
            Optimize_VerifyW(Optimize_VerifyOpReg(op, 0xB8))
            IfCondition EqualTo(VerifyDec.rex_w, 1) ThenBlock: { Optimize_VerifySkip(8) }
            IfCondition EqualTo(VerifyDec.rex_w, 0) ThenBlock: { Optimize_VerifySkip(4) }
            ReturnValue(0)
        }
        IfCondition EqualTo(op, 0xC0) ThenBlock: {
            Optimize_VerifyShift(1, 0)
            ReturnValue(0)
        }
        IfCondition EqualTo(op, 0xC1) ThenBlock: {
            Optimize_VerifyShift(1, 0)
            ReturnValue(0)
        }
        IfCondition EqualTo(op, 0xC2) ThenBlock: {
            Optimize_VerifySkip(2)
            ReturnValue(0)
        }
        IfCondition EqualTo(op, 0xC3) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(op, 0xC6) ThenBlock: {
            Optimize_VerifyEatModrm()
            Optimize_VerifySkip(1)
            IfCondition EqualTo(VerifyDec.ext, 0) ThenBlock: {
                IfCondition EqualTo(VerifyDec.mod, 3) ThenBlock: { Optimize_VerifyW(VerifyDec.grm) }
            }
            ReturnValue(0)
        }
        IfCondition EqualTo(op, 0xC7) ThenBlock: {
            Optimize_VerifyEatModrm()
            Optimize_VerifySkip(4)
            IfCondition EqualTo(VerifyDec.ext, 0) ThenBlock: {
                IfCondition EqualTo(VerifyDec.mod, 3) ThenBlock: { Optimize_VerifyW(VerifyDec.grm) }
            }
            ReturnValue(0)
        }
        IfCondition EqualTo(op, 0xC8) ThenBlock: {
            Optimize_VerifySkip(3)
            ReturnValue(0)
        }
        IfCondition EqualTo(op, 0xC9) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(op, 0xCC) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(op, 0xCD) ThenBlock: {
            Optimize_VerifySkip(1)
            ReturnValue(0)
        }
        IfCondition EqualTo(op, 0xD0) ThenBlock: {
            Optimize_VerifyShift(0, 0)
            ReturnValue(0)
        }
        IfCondition EqualTo(op, 0xD1) ThenBlock: {
            Optimize_VerifyShift(0, 0)
            ReturnValue(0)
        }
        IfCondition EqualTo(op, 0xD2) ThenBlock: {
            Optimize_VerifyShift(0, 1)
            ReturnValue(0)
        }
        IfCondition EqualTo(op, 0xD3) ThenBlock: {
            Optimize_VerifyShift(0, 1)
            ReturnValue(0)
        }
        IfCondition GreaterEqual(op, 0xD8) ThenBlock: {
            IfCondition LessEqual(op, 0xDF) ThenBlock: {
                Optimize_VerifyEatModrm()
                ReturnValue(0)
            }
        }
        IfCondition GreaterEqual(op, 0xE0) ThenBlock: {
            IfCondition LessEqual(op, 0xE2) ThenBlock: {
                Optimize_VerifySkip(1)
                Optimize_VerifyW(1)
                VerifyDec.force = 1
                ReturnValue(0)
            }
        }
        IfCondition EqualTo(op, 0xE3) ThenBlock: {
            Optimize_VerifySkip(1)
            Optimize_VerifyR(1)
            ReturnValue(0)
        }
        IfCondition EqualTo(op, 0xE4) ThenBlock: {
            Optimize_VerifySkip(1)
            Optimize_VerifyW(0)
            VerifyDec.force = 1
            ReturnValue(0)
        }
        IfCondition EqualTo(op, 0xE5) ThenBlock: {
            Optimize_VerifySkip(1)
            Optimize_VerifyW(0)
            VerifyDec.force = 1
            ReturnValue(0)
        }
        IfCondition EqualTo(op, 0xE6) ThenBlock: {
            Optimize_VerifySkip(1)
            Optimize_VerifyR(0)
            ReturnValue(0)
        }
        IfCondition EqualTo(op, 0xE7) ThenBlock: {
            Optimize_VerifySkip(1)
            Optimize_VerifyR(0)
            ReturnValue(0)
        }
        IfCondition EqualTo(op, 0xE8) ThenBlock: {
            Optimize_VerifySkip(4)
            Optimize_VerifyCallers()
            ReturnValue(0)
        }
        IfCondition EqualTo(op, 0xE9) ThenBlock: {
            Optimize_VerifySkip(4)
            ReturnValue(0)
        }
        IfCondition EqualTo(op, 0xEB) ThenBlock: {
            Optimize_VerifySkip(1)
            ReturnValue(0)
        }
        IfCondition EqualTo(op, 0xEC) ThenBlock: {
            Optimize_VerifyW(0)
            VerifyDec.force = 1
            ReturnValue(0)
        }
        IfCondition EqualTo(op, 0xED) ThenBlock: {
            Optimize_VerifyW(0)
            VerifyDec.force = 1
            ReturnValue(0)
        }
        IfCondition EqualTo(op, 0xEE) ThenBlock: {
            Optimize_VerifyR(0)
            ReturnValue(0)
        }
        IfCondition EqualTo(op, 0xEF) ThenBlock: {
            Optimize_VerifyR(0)
            ReturnValue(0)
        }
        IfCondition EqualTo(op, 0xF1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(op, 0xF4) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(op, 0xF5) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(op, 0xF6) ThenBlock: {
            Optimize_VerifyF7(0)
            ReturnValue(0)
        }
        IfCondition EqualTo(op, 0xF7) ThenBlock: {
            Optimize_VerifyF7(1)
            ReturnValue(0)
        }
        IfCondition GreaterEqual(op, 0xF8) ThenBlock: {
            IfCondition LessEqual(op, 0xFD) ThenBlock: { ReturnValue(0) }
        }
        IfCondition EqualTo(op, 0xFE) ThenBlock: {
            Optimize_VerifyEatModrm()
            IfCondition LessEqual(VerifyDec.ext, 1) ThenBlock: {
                IfCondition EqualTo(VerifyDec.mod, 3) ThenBlock: {
                    Optimize_VerifyR(VerifyDec.grm)
                    Optimize_VerifyW(VerifyDec.grm)
                }
            }
            ReturnValue(0)
        }
        IfCondition EqualTo(op, 0xFF) ThenBlock: {
            Optimize_VerifyFF()
            ReturnValue(0)
        }
        VerifyDec.bad = 1
        ReturnValue(0)
    }
}

Function.Optimize_VerifyTwoFixed {
    Input: op: Integer
    Output: Integer
    Body: {
        hit = 0
        IfCondition EqualTo(op, 0x05) ThenBlock: {
            Optimize_VerifyW(0)
            Optimize_VerifyW(1)
            Optimize_VerifyW(11)
            VerifyDec.force = 1
            hit = 1
        }
        IfCondition EqualTo(op, 0x06) ThenBlock: { hit = 1 }
        IfCondition EqualTo(op, 0x07) ThenBlock: { hit = 1 }
        IfCondition EqualTo(op, 0x08) ThenBlock: { hit = 1 }
        IfCondition EqualTo(op, 0x09) ThenBlock: { hit = 1 }
        IfCondition EqualTo(op, 0x0B) ThenBlock: { hit = 1 }
        IfCondition EqualTo(op, 0x0E) ThenBlock: { hit = 1 }
        IfCondition EqualTo(op, 0x30) ThenBlock: { hit = 1 }
        IfCondition EqualTo(op, 0x31) ThenBlock: {
            Optimize_VerifyW(0)
            Optimize_VerifyW(2)
            VerifyDec.force = 1
            hit = 1
        }
        IfCondition EqualTo(op, 0x32) ThenBlock: {
            Optimize_VerifyW(0)
            Optimize_VerifyW(2)
            VerifyDec.force = 1
            hit = 1
        }
        IfCondition EqualTo(op, 0x33) ThenBlock: {
            Optimize_VerifyW(0)
            Optimize_VerifyW(2)
            VerifyDec.force = 1
            hit = 1
        }
        IfCondition EqualTo(op, 0x34) ThenBlock: {
            Optimize_VerifyCallers()
            hit = 1
        }
        IfCondition EqualTo(op, 0x35) ThenBlock: { hit = 1 }
        IfCondition EqualTo(op, 0x77) ThenBlock: { hit = 1 }
        IfCondition EqualTo(op, 0xA0) ThenBlock: { hit = 1 }
        IfCondition EqualTo(op, 0xA1) ThenBlock: { hit = 1 }
        IfCondition EqualTo(op, 0xA2) ThenBlock: {
            Optimize_VerifyW(0)
            Optimize_VerifyW(1)
            Optimize_VerifyW(2)
            Optimize_VerifyW(3)
            VerifyDec.force = 1
            hit = 1
        }
        IfCondition EqualTo(op, 0xA8) ThenBlock: { hit = 1 }
        IfCondition EqualTo(op, 0xA9) ThenBlock: { hit = 1 }
        IfCondition EqualTo(op, 0xAA) ThenBlock: { hit = 1 }
        IfCondition GreaterEqual(op, 0xC8) ThenBlock: {
            IfCondition LessEqual(op, 0xCF) ThenBlock: {
                rd = Subtract(op, 0xC8)
                IfCondition EqualTo(VerifyDec.rex_b, 1) ThenBlock: {
                    rd = Add(rd, 8)
                }
                Optimize_VerifyR(rd)
                Optimize_VerifyW(rd)
                hit = 1
            }
        }
        ReturnValue(hit)
    }
}

Function.Optimize_VerifyTwoImm {
    Input: op: Integer
    Body: {
        imm = 0
        IfCondition EqualTo(op, 0x70) ThenBlock: { imm = 1 }
        IfCondition EqualTo(op, 0x71) ThenBlock: { imm = 1 }
        IfCondition EqualTo(op, 0x72) ThenBlock: { imm = 1 }
        IfCondition EqualTo(op, 0x73) ThenBlock: { imm = 1 }
        IfCondition EqualTo(op, 0xA4) ThenBlock: { imm = 1 }
        IfCondition EqualTo(op, 0xAC) ThenBlock: { imm = 1 }
        IfCondition EqualTo(op, 0xBA) ThenBlock: { imm = 1 }
        IfCondition EqualTo(op, 0xC2) ThenBlock: { imm = 1 }
        IfCondition EqualTo(op, 0xC4) ThenBlock: { imm = 1 }
        IfCondition EqualTo(op, 0xC5) ThenBlock: { imm = 1 }
        IfCondition EqualTo(op, 0xC6) ThenBlock: { imm = 1 }
        IfCondition EqualTo(imm, 1) ThenBlock: { Optimize_VerifySkip(1) }
        ReturnValue(0)
    }
}

Function.Optimize_VerifyShld {
    Input: by_cl: Integer
    Body: {
        IfCondition EqualTo(by_cl, 1) ThenBlock: { Optimize_VerifyR(1) }
        Optimize_VerifyR(VerifyDec.greg)
        IfCondition EqualTo(VerifyDec.mod, 3) ThenBlock: {
            Optimize_VerifyR(VerifyDec.grm)
            Optimize_VerifyW(VerifyDec.grm)
        }
        ReturnValue(0)
    }
}

Function.Optimize_VerifyTwoGpr {
    Input: op: Integer
    Body: {
        IfCondition GreaterEqual(op, 0x40) ThenBlock: {
            IfCondition LessEqual(op, 0x4F) ThenBlock: {
                Optimize_VerifyW(VerifyDec.greg)
                VerifyDec.force = 1
                ReturnValue(0)
            }
        }
        IfCondition GreaterEqual(op, 0x90) ThenBlock: {
            IfCondition LessEqual(op, 0x9F) ThenBlock: {
                IfCondition EqualTo(VerifyDec.mod, 3) ThenBlock: { Optimize_VerifyW(VerifyDec.grm) }
                ReturnValue(0)
            }
        }
        IfCondition EqualTo(op, 0xA3) ThenBlock: {
            Optimize_VerifyR(VerifyDec.greg)
            IfCondition EqualTo(VerifyDec.mod, 3) ThenBlock: { Optimize_VerifyR(VerifyDec.grm) }
            ReturnValue(0)
        }
        IfCondition EqualTo(op, 0xA4) ThenBlock: {
            Optimize_VerifyShld(0)
            ReturnValue(0)
        }
        IfCondition EqualTo(op, 0xA5) ThenBlock: {
            Optimize_VerifyShld(1)
            ReturnValue(0)
        }
        IfCondition EqualTo(op, 0xAB) ThenBlock: {
            Optimize_VerifyShld(0)
            ReturnValue(0)
        }
        IfCondition EqualTo(op, 0xAC) ThenBlock: {
            Optimize_VerifyShld(0)
            ReturnValue(0)
        }
        IfCondition EqualTo(op, 0xAD) ThenBlock: {
            Optimize_VerifyShld(1)
            ReturnValue(0)
        }
        IfCondition EqualTo(op, 0xAF) ThenBlock: {
            Optimize_VerifyR(VerifyDec.greg)
            Optimize_VerifyW(VerifyDec.greg)
            IfCondition EqualTo(VerifyDec.mod, 3) ThenBlock: { Optimize_VerifyR(VerifyDec.grm) }
            ReturnValue(0)
        }
        IfCondition EqualTo(op, 0xB0) ThenBlock: {
            Optimize_VerifyW(0)
            IfCondition EqualTo(VerifyDec.mod, 3) ThenBlock: { Optimize_VerifyW(VerifyDec.grm) }
            VerifyDec.force = 1
            ReturnValue(0)
        }
        IfCondition EqualTo(op, 0xB1) ThenBlock: {
            Optimize_VerifyW(0)
            IfCondition EqualTo(VerifyDec.mod, 3) ThenBlock: { Optimize_VerifyW(VerifyDec.grm) }
            VerifyDec.force = 1
            ReturnValue(0)
        }
        IfCondition EqualTo(op, 0xB3) ThenBlock: {
            Optimize_VerifyShld(0)
            ReturnValue(0)
        }
        IfCondition EqualTo(op, 0xB6) ThenBlock: {
            Optimize_VerifyW(VerifyDec.greg)
            IfCondition EqualTo(VerifyDec.mod, 3) ThenBlock: { Optimize_VerifyR(VerifyDec.grm) }
            ReturnValue(0)
        }
        IfCondition EqualTo(op, 0xB7) ThenBlock: {
            Optimize_VerifyW(VerifyDec.greg)
            IfCondition EqualTo(VerifyDec.mod, 3) ThenBlock: { Optimize_VerifyR(VerifyDec.grm) }
            ReturnValue(0)
        }
        IfCondition EqualTo(op, 0xB8) ThenBlock: {
            Optimize_VerifyW(VerifyDec.greg)
            IfCondition EqualTo(VerifyDec.mod, 3) ThenBlock: { Optimize_VerifyR(VerifyDec.grm) }
            ReturnValue(0)
        }
        IfCondition EqualTo(op, 0xBA) ThenBlock: {
            IfCondition EqualTo(VerifyDec.mod, 3) ThenBlock: {
                IfCondition GreaterEqual(VerifyDec.ext, 5) ThenBlock: {
                    Optimize_VerifyR(VerifyDec.grm)
                    Optimize_VerifyW(VerifyDec.grm)
                }
                IfCondition EqualTo(VerifyDec.ext, 4) ThenBlock: { Optimize_VerifyR(VerifyDec.grm) }
            }
            ReturnValue(0)
        }
        IfCondition EqualTo(op, 0xBB) ThenBlock: {
            Optimize_VerifyShld(0)
            ReturnValue(0)
        }
        IfCondition EqualTo(op, 0xBC) ThenBlock: {
            Optimize_VerifyW(VerifyDec.greg)
            IfCondition EqualTo(VerifyDec.mod, 3) ThenBlock: { Optimize_VerifyR(VerifyDec.grm) }
            ReturnValue(0)
        }
        IfCondition EqualTo(op, 0xBD) ThenBlock: {
            Optimize_VerifyW(VerifyDec.greg)
            IfCondition EqualTo(VerifyDec.mod, 3) ThenBlock: { Optimize_VerifyR(VerifyDec.grm) }
            ReturnValue(0)
        }
        IfCondition EqualTo(op, 0xBE) ThenBlock: {
            Optimize_VerifyW(VerifyDec.greg)
            IfCondition EqualTo(VerifyDec.mod, 3) ThenBlock: { Optimize_VerifyR(VerifyDec.grm) }
            ReturnValue(0)
        }
        IfCondition EqualTo(op, 0xBF) ThenBlock: {
            Optimize_VerifyW(VerifyDec.greg)
            IfCondition EqualTo(VerifyDec.mod, 3) ThenBlock: { Optimize_VerifyR(VerifyDec.grm) }
            ReturnValue(0)
        }
        IfCondition EqualTo(op, 0xC0) ThenBlock: {
            Optimize_VerifyW(VerifyDec.greg)
            IfCondition EqualTo(VerifyDec.mod, 3) ThenBlock: { Optimize_VerifyW(VerifyDec.grm) }
            VerifyDec.force = 1
            ReturnValue(0)
        }
        IfCondition EqualTo(op, 0xC1) ThenBlock: {
            Optimize_VerifyW(VerifyDec.greg)
            IfCondition EqualTo(VerifyDec.mod, 3) ThenBlock: { Optimize_VerifyW(VerifyDec.grm) }
            VerifyDec.force = 1
            ReturnValue(0)
        }
        IfCondition EqualTo(op, 0xD7) ThenBlock: {
            Optimize_VerifyW(VerifyDec.greg)
            ReturnValue(0)
        }
        ReturnValue(0)
    }
}

Function.Optimize_VerifyTwo {
    Input: op: Integer
    Body: {
        IfCondition GreaterEqual(op, 0x80) ThenBlock: {
            IfCondition LessEqual(op, 0x8F) ThenBlock: {
                Optimize_VerifySkip(4)
                ReturnValue(0)
            }
        }
        IfCondition EqualTo(op, 0x38) ThenBlock: {
            Optimize_VerifyTake()
            Optimize_VerifyEatModrm()
            ReturnValue(0)
        }
        IfCondition EqualTo(op, 0x3A) ThenBlock: {
            Optimize_VerifyTake()
            Optimize_VerifyEatModrm()
            Optimize_VerifySkip(1)
            ReturnValue(0)
        }
        fixed = Optimize_VerifyTwoFixed(op)
        IfCondition EqualTo(fixed, 1) ThenBlock: { ReturnValue(0) }
        Optimize_VerifyEatModrm()
        Optimize_VerifyTwoImm(op)
        Optimize_VerifyTwoGpr(op)
        ReturnValue(0)
    }
}

Function.Optimize_VerifyOpcode {
    Input: op: Integer
    Body: {
        IfCondition EqualTo(op, 0x0F) ThenBlock: {
            op2 = Optimize_VerifyTake()
            IfCondition EqualTo(VerifyDec.bad, 0) ThenBlock: { Optimize_VerifyTwo(op2) }
            ReturnValue(0)
        }
        IfCondition EqualTo(op, 0x63) ThenBlock: {
            Optimize_VerifyMov(1)
            ReturnValue(0)
        }
        IfCondition LessEqual(op, 0x3F) ThenBlock: {
            Optimize_VerifyAlu(op)
            ReturnValue(0)
        }
        IfCondition GreaterEqual(op, 0x50) ThenBlock: {
            IfCondition LessEqual(op, 0x6F) ThenBlock: {
                Optimize_VerifyOp50(op)
                ReturnValue(0)
            }
        }
        IfCondition GreaterEqual(op, 0x70) ThenBlock: {
            IfCondition LessEqual(op, 0x8F) ThenBlock: {
                Optimize_VerifyOp70(op)
                ReturnValue(0)
            }
        }
        IfCondition GreaterEqual(op, 0x90) ThenBlock: {
            IfCondition LessEqual(op, 0xAF) ThenBlock: {
                Optimize_VerifyOp90(op)
                ReturnValue(0)
            }
        }
        IfCondition GreaterEqual(op, 0xB0) ThenBlock: {
            Optimize_VerifyOpB0(op)
            ReturnValue(0)
        }
        VerifyDec.bad = 1
        ReturnValue(0)
    }
}

Function.Optimize_VerifyInsn {
    Input: pos: Integer
    Output: Integer
    Body: {
        VerifyDec.pos = pos
        VerifyDec.lim = Emit.code_size
        VerifyDec.rex = 0
        VerifyDec.rex_w = 0
        VerifyDec.rex_r = 0
        VerifyDec.rex_x = 0
        VerifyDec.rex_b = 0
        VerifyDec.p66 = 0
        VerifyDec.p67 = 0
        VerifyDec.pf2 = 0
        VerifyDec.pf3 = 0
        VerifyDec.bad = 0
        VerifyDec.wmask = 0
        VerifyDec.rmask = 0
        VerifyDec.force = 0
        VerifyDec.mod = 0
        VerifyDec.ext = 0
        VerifyDec.greg = 0
        VerifyDec.grm = -1
        IfCondition LessThan(pos, 0) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterEqual(pos, Emit.code_size) ThenBlock: { ReturnValue(0) }
        Optimize_VerifyPrefixes()
        IfCondition EqualTo(VerifyDec.bad, 1) ThenBlock: { ReturnValue(0) }
        VerifyDec.rex_w = BitwiseAnd(RightShift(VerifyDec.rex, 3), 1)
        VerifyDec.rex_r = BitwiseAnd(RightShift(VerifyDec.rex, 2), 1)
        VerifyDec.rex_x = BitwiseAnd(RightShift(VerifyDec.rex, 1), 1)
        VerifyDec.rex_b = BitwiseAnd(VerifyDec.rex, 1)
        op = Optimize_VerifyTake()
        IfCondition EqualTo(VerifyDec.bad, 1) ThenBlock: { ReturnValue(0) }
        Optimize_VerifyOpcode(op)
        IfCondition EqualTo(VerifyDec.bad, 1) ThenBlock: { ReturnValue(0) }
        ilen = Subtract(VerifyDec.pos, pos)
        IfCondition LessEqual(ilen, 0) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterThan(ilen, 15) ThenBlock: { ReturnValue(0) }
        packed = ilen
        packed = BitwiseOr(packed, LeftShift(VerifyDec.wmask, 8))
        packed = BitwiseOr(packed, LeftShift(VerifyDec.rmask, 24))
        IfCondition EqualTo(VerifyDec.force, 1) ThenBlock: {
            packed = BitwiseOr(packed, LeftShift(1, 40))
        }
        ReturnValue(packed)
    }
}

Function.Optimize_VerifyAnyOpen {
    Output: Integer
    Body: {
        i = 0
        WhileLoop LessThan(i, VerifyState.n) {
            p = Optimize_VerifyPtr(i)
            endp = Dereference(Add(p, 24))
            IfCondition EqualTo(endp, -1) ThenBlock: { ReturnValue(1) }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

Function.Optimize_VerifyCover {
    Input: start: Integer
    Body: {
        IfCondition LessEqual(VerifyState.n, 0) ThenBlock: { ReturnValue(0) }
        open = Optimize_VerifyAnyOpen()
        IfCondition EqualTo(open, 0) ThenBlock: { ReturnValue(0) }
        info = Optimize_VerifyInsn(start)
        ilen = BitwiseAnd(info, 255)
        IfCondition EqualTo(ilen, 0) ThenBlock: { ReturnValue(0) }
        wmask = BitwiseAnd(RightShift(info, 8), 65535)
        rmask = BitwiseAnd(RightShift(info, 24), 65535)
        forced = BitwiseAnd(info, LeftShift(1, 40))
        IfCondition EqualTo(wmask, 0) ThenBlock: { ReturnValue(0) }
        now = Emit_GetPosition()
        i = 0
        WhileLoop LessThan(i, VerifyState.n) {
            p = Optimize_VerifyPtr(i)
            endp = Dereference(Add(p, 24))
            def = Dereference(Add(p, 16))
            reg = Dereference(Add(p, 8))
            IfCondition EqualTo(endp, -1) ThenBlock: {
                IfCondition NotEqual(def, start) ThenBlock: {
                    IfCondition GreaterEqual(reg, 0) ThenBlock: {
                        IfCondition LessEqual(reg, 15) ThenBlock: {
                            bit = LeftShift(1, reg)
                            hit = BitwiseAnd(wmask, bit)
                            IfCondition NotEqual(hit, 0) ThenBlock: {
                                kill = 0
                                IfCondition NotEqual(forced, 0) ThenBlock: { kill = 1 }
                                rd = BitwiseAnd(rmask, bit)
                                IfCondition EqualTo(rd, 0) ThenBlock: { kill = 1 }
                                IfCondition EqualTo(kill, 1) ThenBlock: {
                                    StoreValue(Add(p, 24), now)
                                }
                            }
                        }
                    }
                }
            }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

Function.Optimize_VerifyCloseOpen {
    Body: {
        now = Emit_GetPosition()
        i = 0
        WhileLoop LessThan(i, VerifyState.n) {
            p = Optimize_VerifyPtr(i)
            endp = Dereference(Add(p, 24))
            IfCondition EqualTo(endp, -1) ThenBlock: { StoreValue(Add(p, 24), now) }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

Function.Optimize_VerifyIsDef {
    Input: pos: Integer
    Output: Integer
    Body: {
        i = 0
        WhileLoop LessThan(i, VerifyState.n) {
            p = Optimize_VerifyPtr(i)
            def = Dereference(Add(p, 16))
            IfCondition EqualTo(def, pos) ThenBlock: { ReturnValue(1) }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

Function.Optimize_VerifyHex2 {
    Input: b: Integer
    Body: {
        IfCondition EqualTo(VerifyState.hex, 0) ThenBlock: {
            VerifyState.hex = Allocate(4)
        }
        IfCondition EqualTo(VerifyState.hex, 0) ThenBlock: { ReturnValue(0) }
        digits = "0123456789ABCDEF"
        nib = BitwiseAnd(b, 255)
        hi = GetByte(digits, Divide(nib, 16))
        lo = GetByte(digits, Modulo(nib, 16))
        SetByte(VerifyState.hex, 0, hi)
        SetByte(VerifyState.hex, 1, lo)
        SetByte(VerifyState.hex, 2, 0)
        PrintString(VerifyState.hex)
        ReturnValue(0)
    }
}

Function.Optimize_VerifyBytes {
    Input: pos: Integer
    Input: n: Integer
    Body: {
        shown = 0
        WhileLoop LessThan(shown, n) {
            at = Add(pos, shown)
            IfCondition LessThan(at, Emit.code_size) ThenBlock: {
                PrintMessage(" ")
                Optimize_VerifyHex2(GetByte(Emit.code, at))
            }
            shown = Add(shown, 1)
        }
        ReturnValue(0)
    }
}

Function.Optimize_VerifyPrintName {
    Input: id: Integer
    Body: {
        IfCondition LessThan(id, 1) ThenBlock: {
            PrintMessage("?")
            ReturnValue(0)
        }
        IfCondition GreaterThan(id, TagState.nnames) ThenBlock: {
            PrintMessage("?")
            ReturnValue(0)
        }
        IfCondition EqualTo(TagState.names, 0) ThenBlock: {
            PrintMessage("?")
            ReturnValue(0)
        }
        nm = Dereference(Add(TagState.names, Multiply(Subtract(id, 1), 8)))
        IfCondition EqualTo(nm, 0) ThenBlock: {
            PrintMessage("?")
            ReturnValue(0)
        }
        PrintString(nm)
        ReturnValue(0)
    }
}

// 1 when AILANG_VERIFY=1. Cached. Default is off, so a compile prints
// only the one-line hit count.
Function.Optimize_VerifyWantTrace {
    Output: Integer
    Body: {
        IfCondition GreaterEqual(VerifyState.trace, 0) ThenBlock: { ReturnValue(VerifyState.trace) }
        VerifyState.trace = 0
        envpath = "/proc/self/environ"
        env_fd = SystemCall(2, envpath, 0, 0)
        IfCondition LessThan(env_fd, 0) ThenBlock: { ReturnValue(0) }
        env_bufsz = 131072
        env_buf = Allocate(env_bufsz)
        env_n = SystemCall(0, env_fd, env_buf, env_bufsz)
        SystemCall(3, env_fd, 0, 0)
        needle = "AILANG_VERIFY="
        nlen = 14
        found = 0
        ei = 0
        elimit = Subtract(env_n, nlen)
        WhileLoop LessEqual(ei, elimit) {
            IfCondition EqualTo(found, 1) ThenBlock: { ExitLoop }
            match = 1
            ej = 0
            WhileLoop LessThan(ej, nlen) {
                bc = GetByte(env_buf, Add(ei, ej))
                nc = GetByte(needle, ej)
                IfCondition NotEqual(bc, nc) ThenBlock: { match = 0 }
                ej = Add(ej, 1)
            }
            IfCondition EqualTo(match, 1) ThenBlock: {
                vc = GetByte(env_buf, Add(ei, nlen))
                IfCondition EqualTo(vc, 49) ThenBlock: { VerifyState.trace = 1 }
                found = 1
            }
            ei = Add(ei, 1)
        }
        Deallocate(env_buf, env_bufsz)
        ReturnValue(VerifyState.trace)
    }
}

Function.Optimize_VerifyHit {
    Input: func_name: Address
    Input: id: Integer
    Input: reg: Integer
    Input: pos: Integer
    Input: nbytes: Integer
    Body: {
        IfCondition GreaterEqual(VerifyState.bad, 2000) ThenBlock: { ReturnValue(0) }
        VerifyState.bad = Add(VerifyState.bad, 1)
        IfCondition NotEqual(Optimize_VerifyWantTrace(), 1) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(nbytes, 0) ThenBlock: { PrintMessage("VERIFY_UNKNOWN") }
        IfCondition GreaterEqual(nbytes, 0) ThenBlock: { PrintMessage("VERIFY") }
        PrintMessage(" func ")
        IfCondition EqualTo(func_name, 0) ThenBlock: { PrintMessage("?") }
        IfCondition NotEqual(func_name, 0) ThenBlock: { PrintString(func_name) }
        PrintMessage(" value ")
        PrintNumber(id)
        PrintMessage(" ")
        Optimize_VerifyPrintName(id)
        PrintMessage(" reg ")
        PrintNumber(reg)
        PrintMessage(" at ")
        PrintNumber(pos)
        PrintMessage(" bytes")
        show = 8
        IfCondition GreaterThan(nbytes, 0) ThenBlock: {
            show = nbytes
        }
        IfCondition GreaterThan(show, 8) ThenBlock: { show = 8 }
        Optimize_VerifyBytes(pos, show)
        PrintMessage("\n")
        ReturnValue(0)
    }
}

Function.Optimize_VerifyWalk {
    Input: func_name: Address
    Input: slot: Integer
    Body: {
        p = Optimize_VerifyPtr(slot)
        id = Dereference(p)
        reg = Dereference(Add(p, 8))
        def = Dereference(Add(p, 16))
        endp = Dereference(Add(p, 24))
        IfCondition LessThan(reg, 0) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterThan(reg, 15) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(reg, 4) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(reg, 5) ThenBlock: { ReturnValue(0) }
        IfCondition LessEqual(endp, def) ThenBlock: { ReturnValue(0) }
        pos = def
        WhileLoop LessThan(pos, endp) {
            IfCondition GreaterEqual(VerifyState.bad, 2000) ThenBlock: { ReturnValue(0) }
            info = Optimize_VerifyInsn(pos)
            ilen = BitwiseAnd(info, 255)
            IfCondition EqualTo(ilen, 0) ThenBlock: {
                Optimize_VerifyHit(func_name, id, reg, pos, -1)
                ReturnValue(0)
            }
            isdef = Optimize_VerifyIsDef(pos)
            IfCondition EqualTo(isdef, 0) ThenBlock: {
                bit = LeftShift(1, reg)
                wr = BitwiseAnd(RightShift(info, 8), bit)
                rd = BitwiseAnd(RightShift(info, 24), bit)
                forced = BitwiseAnd(info, LeftShift(1, 40))
                IfCondition NotEqual(wr, 0) ThenBlock: {
                    allow = 0
                    IfCondition NotEqual(rd, 0) ThenBlock: {
                        IfCondition EqualTo(forced, 0) ThenBlock: { allow = 1 }
                    }
                    IfCondition EqualTo(allow, 0) ThenBlock: {
                        Optimize_VerifyHit(func_name, id, reg, pos, ilen)
                    }
                }
            }
            pos = Add(pos, ilen)
        }
        ReturnValue(0)
    }
}

Function.Optimize_VerifyFlush {
    Input: func_name: Address
    Body: {
        Optimize_VerifyCloseOpen()
        VerifyState.bad = 0
        i = 0
        WhileLoop LessThan(i, VerifyState.n) {
            IfCondition GreaterEqual(VerifyState.bad, 2000) ThenBlock: {
                PrintMessage("VERIFY_CAP\n")
                ExitLoop
            }
            Optimize_VerifyWalk(func_name, i)
            i = Add(i, 1)
        }
        IfCondition GreaterThan(VerifyState.bad, 0) ThenBlock: {
            PrintMessage("VERIFY hits ")
            PrintNumber(VerifyState.bad)
            PrintMessage("\n")
        }
        VerifyState.n = 0
        ReturnValue(0)
    }
}
