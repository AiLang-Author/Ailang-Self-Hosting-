// =============================================================================

// OS_Exit - Exit process
Function.OS_Exit {
    Input: code: Integer
    Body: {
        IfCondition EqualTo(Emit.os, OS.LINUX) ThenBlock: {
            SystemCall(SysNum.EXIT_GROUP, code)
            // Does not return
        }
        IfCondition EqualTo(Emit.os, OS.HAIKU) ThenBlock: {
            SystemCall(HaikuSysNum.EXIT_TEAM, code)
            // Does not return
        }
    }
}

