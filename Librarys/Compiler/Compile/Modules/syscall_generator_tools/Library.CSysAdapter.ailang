//
// These functions handle OS-specific syscall signature differences.
// They read Emit.os to determine which syscall convention to use.

LibraryImport.Compiler.CodeEmit.CEmitCore
LibraryImport.Compiler.CodeEmit.CSysOps
LibraryImport.Compiler.Compile.Modules.CSyscallTable
LibraryImport.Compiler.Compile.Modules.CSyscallTableHaiku


// =============================================================================
// FILE I/O
// =============================================================================

// OS_Read - Read from file descriptor
Function.OS_Read {
    Input: fd: Integer
    Input: buf: Address
    Input: count: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(Emit.os, OS.LINUX) ThenBlock: {
            result = SystemCall(SysNum.READ, fd, buf, count)
            ReturnValue(result)
        }
        IfCondition EqualTo(Emit.os, OS.HAIKU) ThenBlock: {
            result = SystemCall(HaikuSysNum.READ, fd, -1, buf, count)
            ReturnValue(result)
        }
    }
}

