// OS_Mmap - Map memory region
Function.OS_Mmap {
    Input: addr: Address
    Input: length: Integer
    Input: prot: Integer
    Input: flags: Integer
    Input: fd: Integer
    Input: offset: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(Emit.os, OS.LINUX) ThenBlock: {
            result = SystemCall(SysNum.MMAP, addr, length, prot, flags, fd, offset)
            ReturnValue(result)
        }
        IfCondition EqualTo(Emit.os, OS.HAIKU) ThenBlock: {
            result = SystemCall(HaikuSysNum.MAP_FILE, "mmap", addr, 0, length, prot, flags, 1, fd, offset)
            ReturnValue(result)
        }
    }
}

