// OS_Nanosleep - Sleep for specified time
Function.OS_Nanosleep {
    Input: req: Address
    Input: rem: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(Emit.os, OS.LINUX) ThenBlock: {
            result = SystemCall(SysNum.NANOSLEEP, req, rem)
            ReturnValue(result)
        }
        IfCondition EqualTo(Emit.os, OS.HAIKU) ThenBlock: {
            result = SystemCall(HaikuSysNum.SNOOZE_ETC, 0, 0, 0, rem)
            ReturnValue(result)
        }
    }
}


