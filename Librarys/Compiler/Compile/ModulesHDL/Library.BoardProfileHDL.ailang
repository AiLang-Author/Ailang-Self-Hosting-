// Library.BoardProfileHDL.ailang
// Load ailang.board/v1 JSON at HDL emit time: verify ports, fill pin maps, emit CST.
// Industry never standardized this — we own the schema; humans/models fill the catalog.
//
// Usage (from CLI):
//   BoardProf_Load("boards/tang_nano_9k/board.json")
//   BoardProf_LoadBind("boards/tang_nano_9k/bind_blink.json")
//   BoardProf_ApplyAtEmit(base_path)   // after netlist exists
//
// Copyright (c) 2025-2026 Sean Collins, 2 Paws Machine and Engineering. All rights reserved.
// Licensed under the Sean Collins Software License (SCSL v1.0).

LibraryImport.Arrays
LibraryImport.JSON
LibraryImport.Compiler.Compile.ModulesHDL.NetlistIRHDL
LibraryImport.Compiler.Compile.ModulesHDL.EmitVerilogHDL
LibraryImport.Compiler.Compile.ModulesHDL.EmitSdcHDL

// =============================================================================
// STATE
// =============================================================================
FixedPool.BoardProf {
    "loaded":       Initialize=0, CanChange=True
    "path":         Initialize=0, CanChange=True
    "root":         Initialize=0, CanChange=True   // tagged JSON object
    "name":         Initialize=0, CanChange=True
    "vendor":       Initialize=0, CanChange=True
    "part":         Initialize=0, CanChange=True
    "family":       Initialize=0, CanChange=True
    "loader_board": Initialize=0, CanChange=True
    "synth":        Initialize=0, CanChange=True
    "bind_loaded":  Initialize=0, CanChange=True
    "bind_path":    Initialize=0, CanChange=True
    "bind_root":    Initialize=0, CanChange=True
    "errors":       Initialize=0, CanChange=True
    "warnings":     Initialize=0, CanChange=True
    "catalog_path": Initialize=0, CanChange=True
}

Function.BoardProf_Init {
    Body: {
        BoardProf.loaded = 0
        BoardProf.path = 0
        BoardProf.root = 0
        BoardProf.name = 0
        BoardProf.vendor = 0
        BoardProf.part = 0
        BoardProf.family = 0
        BoardProf.loader_board = 0
        BoardProf.synth = 0
        BoardProf.bind_loaded = 0
        BoardProf.bind_path = 0
        BoardProf.bind_root = 0
        BoardProf.errors = 0
        BoardProf.warnings = 0
        BoardProf.catalog_path = "boards/catalog.json"
    }
}

// Read entire text file (null-terminated). Uses ReadTextFile builtin when available.
Function.BoardProf_ReadFile {
    Input: path: Address
    Output: Address
    Body: {
        IfCondition EqualTo(path, 0) ThenBlock: { ReturnValue(0) }
        // FileOpen O_RDONLY = 0
        fd = FileOpen(path, 0, 0)
        IfCondition LessThan(fd, 0) ThenBlock: {
            PrintMessage("[BOARD] cannot open ")
            PrintMessage(path)
            PrintMessage("\n")
            ReturnValue(0)
        }
        // seek end for size
        sz = FileSeek(fd, 0, 2)
        FileSeek(fd, 0, 0)
        IfCondition LessThan(sz, 1) ThenBlock: {
            FileClose(fd)
            ReturnValue(0)
        }
        buf = Allocate(Add(sz, 1))
        n = FileRead(fd, buf, sz)
        FileClose(fd)
        IfCondition LessThan(n, 1) ThenBlock: { ReturnValue(0) }
        SetByte(buf, n, 0)
        ReturnValue(buf)
    }
}

Function.BoardProf_Load {
    Input: path: Address
    Output: Integer
    Body: {
        BoardProf_Init()
        IfCondition EqualTo(path, 0) ThenBlock: {
            PrintMessage("[BOARD] empty path\n")
            ReturnValue(0)
        }
        text = BoardProf_ReadFile(path)
        IfCondition EqualTo(text, 0) ThenBlock: {
            ReturnValue(0)
        }
        tagged = ParseJSON(text)
        IfCondition EqualTo(tagged, 0) ThenBlock: {
            PrintMessage("[BOARD] JSON parse failed: ")
            PrintMessage(path)
            PrintMessage("\n")
            ReturnValue(0)
        }
        obj = JSON.AsObject(tagged)
        IfCondition EqualTo(obj, 0) ThenBlock: {
            PrintMessage("[BOARD] root is not an object\n")
            ReturnValue(0)
        }
        sch = JSON.GetString(obj, "schema")
        IfCondition EqualTo(sch, 0) ThenBlock: {
            PrintMessage("[BOARD] missing schema field\n")
            BoardProf.errors = Add(BoardProf.errors, 1)
            ReturnValue(0)
        }
        IfCondition NotEqual(StringCompare(sch, "ailang.board/v1"), 0) ThenBlock: {
            PrintMessage("[BOARD] unsupported schema: ")
            PrintMessage(sch)
            PrintMessage(" (want ailang.board/v1)\n")
            BoardProf.errors = Add(BoardProf.errors, 1)
            ReturnValue(0)
        }
        BoardProf.root = tagged
        BoardProf.path = path
        BoardProf.name = JSON.GetString(obj, "name")
        BoardProf.vendor = JSON.GetString(obj, "vendor")
        dev = JSON.GetObject(obj, "device")
        IfCondition NotEqual(dev, 0) ThenBlock: {
            BoardProf.part = JSON.GetString(dev, "part")
            BoardProf.family = JSON.GetString(dev, "family")
            BoardProf.loader_board = JSON.GetString(dev, "loader_board")
            BoardProf.synth = JSON.GetString(dev, "synth")
        }
        BoardProf.loaded = 1
        PrintMessage("[BOARD] loaded profile ")
        IfCondition NotEqual(BoardProf.name, 0) ThenBlock: {
            PrintMessage(BoardProf.name)
        } ElseBlock: {
            PrintMessage(path)
        }
        IfCondition NotEqual(BoardProf.part, 0) ThenBlock: {
            PrintMessage(" (")
            PrintMessage(BoardProf.part)
            PrintMessage(")")
        }
        PrintMessage("\n")
        // Push default clock into SDC before emit (CLI -period can override after)
        BoardProf_ApplyClockToSdc()
        ReturnValue(1)
    }
}

// clocks[defaults.clk].hz → SDC period_ns (1e9/hz)
Function.BoardProf_ApplyClockToSdc {
    Output: Integer
    Body: {
        IfCondition EqualTo(BoardProf.loaded, 0) ThenBlock: { ReturnValue(0) }
        robj = JSON.AsObject(BoardProf.root)
        IfCondition EqualTo(robj, 0) ThenBlock: { ReturnValue(0) }
        clocks = JSON.GetObject(robj, "clocks")
        defs = JSON.GetObject(robj, "defaults")
        IfCondition Or(EqualTo(clocks, 0), EqualTo(defs, 0)) ThenBlock: { ReturnValue(0) }
        ck = JSON.GetString(defs, "clk")
        IfCondition EqualTo(ck, 0) ThenBlock: { ReturnValue(0) }
        cobj = JSON.GetObject(clocks, ck)
        IfCondition EqualTo(cobj, 0) ThenBlock: { ReturnValue(0) }
        hz = JSON.GetNumber(cobj, "hz")
        IfCondition LessEqual(hz, 0) ThenBlock: { ReturnValue(0) }
        per = Divide(1000000000, hz)
        IfCondition LessThan(per, 1) ThenBlock: { per = 1 }
        EmitSdcHDL_SetPeriodNs(per)
        PrintMessage("[BOARD] applied clock ")
        PrintMessage(ck)
        PrintMessage(" → period_ns=")
        PrintNumber(per)
        PrintMessage(" (from board profile)\n")
        ReturnValue(1)
    }
}

// Pin JSON value as string (accepts "10" or 10)
Function.BoardProf_JsonPinString {
    Input: tagged: Address
    Output: Address
    Body: {
        IfCondition EqualTo(tagged, 0) ThenBlock: { ReturnValue(0) }
        s = JSON.AsString(tagged)
        IfCondition NotEqual(s, 0) ThenBlock: { ReturnValue(s) }
        IfCondition EqualTo(JSON.TagType(tagged), JType.NUMBER) ThenBlock: {
            n = JSON.AsNumber(tagged)
            ReturnValue(NL_IntToString(n))
        }
        ReturnValue(0)
    }
}

Function.BoardProf_LoadBind {
    Input: path: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(path, 0) ThenBlock: { ReturnValue(0) }
        text = BoardProf_ReadFile(path)
        IfCondition EqualTo(text, 0) ThenBlock: { ReturnValue(0) }
        tagged = ParseJSON(text)
        IfCondition EqualTo(tagged, 0) ThenBlock: {
            PrintMessage("[BOARD] bind JSON parse failed: ")
            PrintMessage(path)
            PrintMessage("\n")
            ReturnValue(0)
        }
        obj = JSON.AsObject(tagged)
        IfCondition EqualTo(obj, 0) ThenBlock: { ReturnValue(0) }
        sch = JSON.GetString(obj, "schema")
        IfCondition NotEqual(sch, 0) ThenBlock: {
            IfCondition NotEqual(StringCompare(sch, "ailang.board.bind/v1"), 0) ThenBlock: {
                PrintMessage("[BOARD] bind schema warning: expected ailang.board.bind/v1\n")
                BoardProf.warnings = Add(BoardProf.warnings, 1)
            }
        }
        // If board field is a name and profile not loaded, try boards/<name>/board.json
        bname = JSON.GetString(obj, "board")
        IfCondition EqualTo(BoardProf.loaded, 0) ThenBlock: {
            IfCondition NotEqual(bname, 0) ThenBlock: {
                // path ends with .json → load as path; else construct boards/<name>/board.json
                is_path = 0
                // crude: contains '/' or ends with .json
                i = 0
                WhileLoop NotEqual(GetByte(bname, i), 0) {
                    IfCondition EqualTo(GetByte(bname, i), 47) ThenBlock: { is_path = 1 }
                    i = Add(i, 1)
                }
                IfCondition EqualTo(is_path, 1) ThenBlock: {
                    BoardProf_Load(bname)
                } ElseBlock: {
                    p = StringConcat("boards/", bname)
                    p = StringConcat(p, "/board.json")
                    BoardProf_Load(p)
                }
            }
        }
        BoardProf.bind_root = tagged
        BoardProf.bind_path = path
        BoardProf.bind_loaded = 1
        PrintMessage("[BOARD] loaded bind ")
        PrintMessage(path)
        PrintMessage("\n")
        ReturnValue(1)
    }
}

// List catalog for "prompt" / IDE / --list-boards
Function.BoardProf_ListCatalog {
    Input: catalog_path: Address
    Output: Integer
    Body: {
        path = catalog_path
        IfCondition EqualTo(path, 0) ThenBlock: {
            path = BoardProf.catalog_path
        }
        text = BoardProf_ReadFile(path)
        IfCondition EqualTo(text, 0) ThenBlock: {
            PrintMessage("[BOARD] no catalog at ")
            IfCondition NotEqual(path, 0) ThenBlock: { PrintMessage(path) }
            PrintMessage("\n")
            ReturnValue(0)
        }
        tagged = ParseJSON(text)
        obj = JSON.AsObject(tagged)
        IfCondition EqualTo(obj, 0) ThenBlock: { ReturnValue(0) }
        arr = JSON.GetArray(obj, "boards")
        IfCondition EqualTo(arr, 0) ThenBlock: {
            PrintMessage("[BOARD] catalog has no boards[]\n")
            ReturnValue(0)
        }
        n = JSON.ArrayLength(arr)
        PrintMessage("[BOARD] available profiles (")
        PrintNumber(n)
        PrintMessage("):\n")
        i = 0
        WhileLoop LessThan(i, n) {
            item_t = JSON.ArrayGet(arr, i)
            item = JSON.AsObject(item_t)
            IfCondition NotEqual(item, 0) ThenBlock: {
                nm = JSON.GetString(item, "name")
                dn = JSON.GetString(item, "display_name")
                pt = JSON.GetString(item, "path")
                PrintMessage("  ")
                IfCondition NotEqual(nm, 0) ThenBlock: { PrintMessage(nm) }
                PrintMessage("  —  ")
                IfCondition NotEqual(dn, 0) ThenBlock: { PrintMessage(dn) }
                IfCondition NotEqual(pt, 0) ThenBlock: {
                    PrintMessage("  [")
                    PrintMessage(pt)
                    PrintMessage("]")
                }
                PrintMessage("\n")
            }
            i = Add(i, 1)
        }
        PrintMessage("Use: -board boards/<name>/board.json  [-bind boards/<name>/bind_*.json]\n")
        ReturnValue(1)
    }
}

// Lookup bind entry for a port name. Returns resource name string, or "" if null-bound, or 0 if missing.
// Also prints invert / bits notes.
Function.BoardProf_BindLookup {
    Input: port_name: Address
    Output: Address
    Body: {
        IfCondition EqualTo(BoardProf.bind_loaded, 0) ThenBlock: { ReturnValue(0) }
        bobj = JSON.AsObject(BoardProf.bind_root)
        IfCondition EqualTo(bobj, 0) ThenBlock: { ReturnValue(0) }
        bind = JSON.GetObject(bobj, "bind")
        IfCondition EqualTo(bind, 0) ThenBlock: { ReturnValue(0) }
        // Try as string first via GetString
        s = JSON.GetString(bind, port_name)
        IfCondition NotEqual(s, 0) ThenBlock: {
            ReturnValue(s)
        }
        // Object form: { "resource": "led", "bits": "5:0" }
        o = JSON.GetObject(bind, port_name)
        IfCondition NotEqual(o, 0) ThenBlock: {
            r = JSON.GetString(o, "resource")
            IfCondition NotEqual(r, 0) ThenBlock: { ReturnValue(r) }
            // signal form under resource
            ReturnValue(JSON.GetString(o, "signal"))
        }
        // null binding: key present but null → GetType null
        t = JSON.GetType(bind, port_name)
        IfCondition EqualTo(t, JType.NULL) ThenBlock: {
            ReturnValue("")   // explicit unbound
        }
        ReturnValue(0)  // missing
    }
}

// Verify top ports against bind + profile. Does not fail compile by default (warn).
Function.BoardProf_Verify {
    Output: Integer
    Body: {
        IfCondition EqualTo(BoardProf.loaded, 0) ThenBlock: {
            PrintMessage("[BOARD] verify skipped (no profile)\n")
            ReturnValue(1)
        }
        top = NL_FindModule(NL.top_name)
        IfCondition EqualTo(top, 0) ThenBlock: {
            PrintMessage("[BOARD] verify: no ailang_top\n")
            ReturnValue(0)
        }
        ports = NL_ModulePorts(top)
        IfCondition EqualTo(ports, 0) ThenBlock: { ReturnValue(1) }
        PrintMessage("[BOARD] pin verification:\n")
        pc = Array.Size(ports)
        pi = 0
        assigned = 0
        unbound = 0
        WhileLoop LessThan(pi, pc) {
            p = Array.Get(ports, pi)
            pname = NL_SafeIdent(Dereference(p))
            pwidth = Dereference(Add(p, 16))
            res = 0
            IfCondition EqualTo(BoardProf.bind_loaded, 1) ThenBlock: {
                res = BoardProf_BindLookup(pname)
            }
            // defaults: clk → defaults.clk clock resource
            IfCondition EqualTo(res, 0) ThenBlock: {
                IfCondition EqualTo(StringCompare(pname, "clk"), 0) ThenBlock: {
                    robj = JSON.AsObject(BoardProf.root)
                    defs = JSON.GetObject(robj, "defaults")
                    IfCondition NotEqual(defs, 0) ThenBlock: {
                        res = JSON.GetString(defs, "clk")
                    }
                }
            }
            PrintMessage("  ")
            PrintMessage(pname)
            PrintMessage(" w=")
            PrintNumber(pwidth)
            PrintMessage(" → ")
            IfCondition EqualTo(res, 0) ThenBlock: {
                PrintMessage("UNASSIGNED")
                unbound = Add(unbound, 1)
                BoardProf.warnings = Add(BoardProf.warnings, 1)
            }
            IfCondition NotEqual(res, 0) ThenBlock: {
                IfCondition EqualTo(GetByte(res, 0), 0) ThenBlock: {
                    PrintMessage("(explicit null — not on package)")
                } ElseBlock: {
                    PrintMessage(res)
                    assigned = Add(assigned, 1)
                }
            }
            PrintMessage("\n")
            pi = Add(pi, 1)
        }
        PrintMessage("[BOARD] assigned=")
        PrintNumber(assigned)
        PrintMessage(" unbound=")
        PrintNumber(unbound)
        PrintMessage(" errors=")
        PrintNumber(BoardProf.errors)
        PrintMessage(" warnings=")
        PrintNumber(BoardProf.warnings)
        PrintMessage("\n")
        ReturnValue(1)
    }
}

// Emit Gowin CST from profile clocks + led-style resources (when bind present).
// Writes <base>.cst
Function.BoardProf_EmitCst {
    Input: base_path: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(BoardProf.loaded, 0) ThenBlock: { ReturnValue(0) }
        robj = JSON.AsObject(BoardProf.root)
        IfCondition EqualTo(robj, 0) ThenBlock: { ReturnValue(0) }
        // only gowin packs emit CST for now
        IfCondition NotEqual(BoardProf.vendor, 0) ThenBlock: {
            IfCondition NotEqual(StringCompare(BoardProf.vendor, "gowin"), 0) ThenBlock: {
                IfCondition NotEqual(StringCompare(BoardProf.vendor, "sim"), 0) ThenBlock: {
                    // still try
                }
            }
        }
        t = ""
        t = NL_TextAppend(t, "// Generated by AILang HDL from board profile ")
        IfCondition NotEqual(BoardProf.name, 0) ThenBlock: {
            t = NL_TextAppend(t, BoardProf.name)
        }
        t = NL_TextAppend(t, "\n")
        t = NL_TextAppend(t, "// schema: ailang.board/v1 — do not hand-edit for CI; edit board.json\n\n")

        // clocks
        clocks = JSON.GetObject(robj, "clocks")
        IfCondition NotEqual(clocks, 0) ThenBlock: {
            // default clk resource
            clk_res = 0
            defs = JSON.GetObject(robj, "defaults")
            IfCondition NotEqual(defs, 0) ThenBlock: {
                clk_res = JSON.GetString(defs, "clk")
            }
            IfCondition NotEqual(clk_res, 0) ThenBlock: {
                cobj = JSON.GetObject(clocks, clk_res)
                IfCondition NotEqual(cobj, 0) ThenBlock: {
                    pin = JSON.GetString(cobj, "pin")
                    iostd = JSON.GetString(cobj, "iostandard")
                    IfCondition EqualTo(iostd, 0) ThenBlock: { iostd = "LVCMOS33" }
                    IfCondition NotEqual(pin, 0) ThenBlock: {
                        t = NL_TextAppend(t, "IO_LOC  \"clk\" ")
                        t = NL_TextAppend(t, pin)
                        t = NL_TextAppend(t, ";\n")
                        t = NL_TextAppend(t, "IO_PORT \"clk\" IO_TYPE=")
                        t = NL_TextAppend(t, iostd)
                        t = NL_TextAppend(t, " PULL_MODE=UP;\n\n")
                    }
                }
            }
        }

        // If bind maps Board_led → led, emit led[i] from resource pins
        // (physical top_wrap names ports led[5:0]; CST targets those names)
        resources = JSON.GetObject(robj, "resources")
        IfCondition NotEqual(resources, 0) ThenBlock: {
            led = JSON.GetObject(resources, "led")
            IfCondition NotEqual(led, 0) ThenBlock: {
                pins = JSON.GetArray(led, "pins")
                iostd = JSON.GetString(led, "iostandard")
                IfCondition EqualTo(iostd, 0) ThenBlock: { iostd = "LVCMOS33" }
                IfCondition NotEqual(pins, 0) ThenBlock: {
                    n = JSON.ArrayLength(pins)
                    bi = 0
                    WhileLoop LessThan(bi, n) {
                        pt = JSON.ArrayGet(pins, bi)
                        pstr = BoardProf_JsonPinString(pt)
                        IfCondition NotEqual(pstr, 0) ThenBlock: {
                            t = NL_TextAppend(t, "IO_LOC  \"led[")
                            t = NL_TextAppend(t, NL_IntToString(bi))
                            t = NL_TextAppend(t, "]\" ")
                            t = NL_TextAppend(t, pstr)
                            t = NL_TextAppend(t, ";\n")
                            t = NL_TextAppend(t, "IO_PORT \"led[")
                            t = NL_TextAppend(t, NL_IntToString(bi))
                            t = NL_TextAppend(t, "]\" IO_TYPE=")
                            t = NL_TextAppend(t, iostd)
                            t = NL_TextAppend(t, ";\n")
                        }
                        bi = Add(bi, 1)
                    }
                }
            }
        }

        cpath = StringConcat(base_path, ".cst")
        fd = FileOpen(cpath, 577, 420)
        IfCondition LessThan(fd, 0) ThenBlock: {
            PrintMessage("[BOARD] cannot write ")
            PrintMessage(cpath)
            PrintMessage("\n")
            ReturnValue(0)
        }
        len = 0
        WhileLoop NotEqual(GetByte(t, len), 0) {
            len = Add(len, 1)
            IfCondition GreaterThan(len, 1000000) ThenBlock: { ExitLoop }
        }
        FileWrite(fd, t, len)
        FileClose(fd)
        PrintMessage("[BOARD] wrote ")
        PrintMessage(cpath)
        PrintMessage("\n")
        ReturnValue(1)
    }
}

// Emit-time hook: verify + write CST (+ future: fill pins)
Function.BoardProf_ApplyAtEmit {
    Input: base_path: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(BoardProf.loaded, 0) ThenBlock: {
            // Friendly prompt: show catalog so session / IDE can pick next time
            PrintMessage("[BOARD] no profile loaded — pin maps stay UNASSIGNED\n")
            BoardProf_ListCatalog(BoardProf.catalog_path)
            ReturnValue(1)
        }
        BoardProf_Verify()
        // Clock already applied on Load; re-apply so late loads still win over default
        BoardProf_ApplyClockToSdc()
        BoardProf_EmitCst(base_path)
        BoardProf_EmitAssignedPins(base_path)
        ReturnValue(1)
    }
}

// Overlay assigned pins onto <base>.pins (human-readable assignment report)
Function.BoardProf_EmitAssignedPins {
    Input: base_path: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(BoardProf.loaded, 0) ThenBlock: { ReturnValue(0) }
        t = ""
        t = NL_TextAppend(t, "# AILang HDL assigned pin map (from board profile)\n")
        t = NL_TextAppend(t, "# profile: ")
        IfCondition NotEqual(BoardProf.name, 0) ThenBlock: {
            t = NL_TextAppend(t, BoardProf.name)
        }
        t = NL_TextAppend(t, "\n")
        t = NL_TextAppend(t, "# format: port  →  resource  (see boards/ for JSON source of truth)\n#\n")
        top = NL_FindModule(NL.top_name)
        IfCondition EqualTo(top, 0) ThenBlock: { ReturnValue(0) }
        ports = NL_ModulePorts(top)
        IfCondition EqualTo(ports, 0) ThenBlock: { ReturnValue(0) }
        pc = Array.Size(ports)
        pi = 0
        WhileLoop LessThan(pi, pc) {
            p = Array.Get(ports, pi)
            pname = NL_SafeIdent(Dereference(p))
            res = BoardProf_BindLookup(pname)
            IfCondition EqualTo(res, 0) ThenBlock: {
                IfCondition EqualTo(StringCompare(pname, "clk"), 0) ThenBlock: {
                    robj = JSON.AsObject(BoardProf.root)
                    defs = JSON.GetObject(robj, "defaults")
                    IfCondition NotEqual(defs, 0) ThenBlock: {
                        res = JSON.GetString(defs, "clk")
                    }
                }
            }
            t = NL_TextAppend(t, pname)
            t = NL_TextAppend(t, "  →  ")
            IfCondition EqualTo(res, 0) ThenBlock: {
                t = NL_TextAppend(t, "UNASSIGNED\n")
            }
            IfCondition NotEqual(res, 0) ThenBlock: {
                IfCondition EqualTo(GetByte(res, 0), 0) ThenBlock: {
                    t = NL_TextAppend(t, "(not on package)\n")
                } ElseBlock: {
                    t = NL_TextAppend(t, res)
                    t = NL_TextAppend(t, "\n")
                }
            }
            pi = Add(pi, 1)
        }
        apath = StringConcat(base_path, ".assigned.pins")
        fd = FileOpen(apath, 577, 420)
        IfCondition LessThan(fd, 0) ThenBlock: { ReturnValue(0) }
        len = 0
        WhileLoop NotEqual(GetByte(t, len), 0) {
            len = Add(len, 1)
            IfCondition GreaterThan(len, 1000000) ThenBlock: { ExitLoop }
        }
        FileWrite(fd, t, len)
        FileClose(fd)
        PrintMessage("[BOARD] wrote ")
        PrintMessage(apath)
        PrintMessage("\n")
        ReturnValue(1)
    }
}
