// Library.CCompileExprHDL.ailang
// Expression lowering → nets/cells (mirrors CCompileExpr / CCompileArith roles).
// Result: net name string in NL.last_net; also returned from CompileExprHDL_*.
// Location: Librarys/Compiler/Compile/ModulesHDL/Library.CCompileExprHDL.ailang
//
// Supported:
//   NUMBER, IDENTIFIER (param or Pool.field dotted name),
//   CALL Add/Subtract/Multiply/Divide and compare helpers,
//   MEMBER_ACCESS (base.field → "base.field")

LibraryImport.Arrays
LibraryImport.Compiler.Frontend.AST.CASTTypes
LibraryImport.Compiler.Frontend.AST.CASTCore
LibraryImport.Compiler.Compile.ModulesHDL.NetlistIRHDL
LibraryImport.Compiler.Compile.ModulesHDL.NetlistPrimsHDL

// =============================================================================
// ENTRY — compile any expr into current module; returns net name or 0
// =============================================================================
Function.CompileExprHDL {
    Input: node: Address
    Output: Address
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: {
            NL_Error("null expression", 0)
            ReturnValue(0)
        }

        mod = NL_GetCurrentModule()
        IfCondition EqualTo(mod, 0) ThenBlock: {
            NL_Error("expression with no current module", AST_GetLine(node))
            ReturnValue(0)
        }

        ntype = AST_GetType(node)

        IfCondition EqualTo(ntype, AST.NUMBER) ThenBlock: {
            ReturnValue(CompileExprHDL_Number(mod, node))
        }
        IfCondition EqualTo(ntype, AST.BOOLEAN) ThenBlock: {
            ReturnValue(CompileExprHDL_Number(mod, node))
        }
        IfCondition EqualTo(ntype, AST.NULL) ThenBlock: {
            ReturnValue(NL_Prim_Const(mod, 0, 64))
        }
        IfCondition EqualTo(ntype, AST.IDENTIFIER) ThenBlock: {
            ReturnValue(CompileExprHDL_Ident(mod, node))
        }
        IfCondition EqualTo(ntype, AST.MEMBER_ACCESS) ThenBlock: {
            ReturnValue(CompileExprHDL_Member(mod, node))
        }
        IfCondition EqualTo(ntype, AST.CALL) ThenBlock: {
            ReturnValue(CompileExprHDL_Call(mod, node))
        }
        IfCondition EqualTo(ntype, AST.INDEX_ACCESS) ThenBlock: {
            ReturnValue(CompileExprHDL_Index(mod, node))
        }
        IfCondition EqualTo(ntype, AST.BINARY_OP) ThenBlock: {
            ReturnValue(CompileExprHDL_BinaryOp(mod, node))
        }
        IfCondition EqualTo(ntype, AST.UNARY_OP) ThenBlock: {
            ReturnValue(CompileExprHDL_UnaryOp(mod, node))
        }

        NL_Error("expression form not in HDL body subset", AST_GetLine(node))
        PrintMessage("[HDL]   expr type=")
        PrintNumber(ntype)
        PrintMessage("\n")
        ReturnValue(0)
    }
}

// =============================================================================
// NUMBER / BOOL → const wire
// =============================================================================
Function.CompileExprHDL_Number {
    Input: mod: Address
    Input: node: Address
    Output: Address
    Body: {
        s = AST_GetData1(node)
        val = 0
        IfCondition NotEqual(s, 0) ThenBlock: {
            // BOOLEAN may store 0/1 as integer already; NUMBER is digit string
            ntype = AST_GetType(node)
            IfCondition EqualTo(ntype, AST.BOOLEAN) ThenBlock: {
                val = s
                // if s looks like a pointer (huge), try StringToNumber
                IfCondition GreaterThan(val, 1) ThenBlock: {
                    val = StringToNumber(s)
                }
            } ElseBlock: {
                val = StringToNumber(s)
            }
        }
        ReturnValue(NL_Prim_Const(mod, val, 64))
    }
}

// =============================================================================
// IDENTIFIER — param port, pool field (dotted), or local wire
// =============================================================================
Function.CompileExprHDL_Ident {
    Input: mod: Address
    Input: node: Address
    Output: Address
    Body: {
        name = AST_GetData1(node)
        IfCondition EqualTo(name, 0) ThenBlock: {
            NL_Error("empty identifier", AST_GetLine(node))
            ReturnValue(0)
        }

        // ForEvery loop variable binding (unrolled)
        IfCondition NotEqual(NL.foreach_name, 0) ThenBlock: {
            IfCondition EqualTo(StringCompare(name, NL.foreach_name), 0) ThenBlock: {
                IfCondition NotEqual(NL.foreach_net, 0) ThenBlock: {
                    NL.last_net = NL.foreach_net
                    ReturnValue(NL.foreach_net)
                }
            }
        }

        // FixedPool field? dotted name lexed as one identifier ("App.count")
        mem = NL_FindMemory(name)
        IfCondition NotEqual(mem, 0) ThenBlock: {
            safe = NL_SafeIdent(name)
            // ForEvery reduction: use last comb write to this field if any
            IfCondition EqualTo(NL.foreach_mode, 1) ThenBlock: {
                sh = NL_ForeachShadowGet(safe)
                IfCondition NotEqual(sh, 0) ThenBlock: {
                    NL.last_net = sh
                    ReturnValue(sh)
                }
            }
            NL.last_net = safe
            ReturnValue(safe)
        }

        // Otherwise: port or bare name as wire (params are ports with this name)
        NL.last_net = name
        ReturnValue(name)
    }
}

// =============================================================================
// MEMBER ACCESS — base.field → "base.field" (if not already dotted ident)
// =============================================================================
Function.CompileExprHDL_Member {
    Input: mod: Address
    Input: node: Address
    Output: Address
    Body: {
        member = AST_GetData1(node)
        base = AST_GetChild(node, 0)
        IfCondition EqualTo(base, 0) ThenBlock: {
            NL_Error("member access missing base", AST_GetLine(node))
            ReturnValue(0)
        }
        base_name = AST_GetData1(base)
        IfCondition EqualTo(base_name, 0) ThenBlock: {
            NL_Error("member access base not identifier", AST_GetLine(node))
            ReturnValue(0)
        }
        full = StringConcat(base_name, ".")
        full = StringConcat(full, member)
        mem = NL_FindMemory(full)
        IfCondition NotEqual(mem, 0) ThenBlock: {
            safe = NL_SafeIdent(full)
            NL.last_net = safe
            ReturnValue(safe)
        }
        // Non-pool member: still form a net name
        safe = NL_SafeIdent(full)
        NL.last_net = safe
        ReturnValue(safe)
    }
}

// =============================================================================
// INDEX — base[index]
// base = FixedPool array (depth>1). index = const OR any expr (async read).
// emit: assign out = Mem[idx];
// =============================================================================
Function.CompileExprHDL_Index {
    Input: mod: Address
    Input: node: Address
    Output: Address
    Body: {
        // children[0]=base, [1]=index  (see AST_MakeIndexAccess)
        IfCondition LessThan(AST_GetChildCount(node), 2) ThenBlock: {
            NL_Error("index access missing parts", AST_GetLine(node))
            ReturnValue(0)
        }
        base = AST_GetChild(node, 0)
        idx = AST_GetChild(node, 1)
        IfCondition NotEqual(AST_GetType(base), AST.IDENTIFIER) ThenBlock: {
            NL_Error("HDL index base must be identifier", AST_GetLine(node))
            ReturnValue(0)
        }
        bname = AST_GetData1(base)
        mem = NL_FindMemory(bname)
        IfCondition EqualTo(mem, 0) ThenBlock: {
            NL_Error("index base is not a FixedPool field", AST_GetLine(node))
            ReturnValue(0)
        }
        depth = Dereference(Add(mem, 16))
        IfCondition LessEqual(depth, 1) ThenBlock: {
            NL_Error("index into scalar FixedPool — use field name, not [i]", AST_GetLine(node))
            ReturnValue(0)
        }

        safe = NL_SafeIdent(bname)
        out = NL_FreshWire()
        rhs = 0

        // Const index: bounds-check + literal
        IfCondition EqualTo(AST_GetType(idx), AST.NUMBER) ThenBlock: {
            ival = StringToNumber(AST_GetData1(idx))
            IfCondition Or(LessThan(ival, 0), GreaterEqual(ival, depth)) ThenBlock: {
                NL_Error("const index out of FixedPool array depth", AST_GetLine(node))
                ReturnValue(0)
            }
            rhs = StringConcat(safe, "[")
            rhs = StringConcat(rhs, NL_IntToString(ival))
            rhs = StringConcat(rhs, "]")
            PrintMessage("  index ")
            PrintMessage(safe)
            PrintMessage("[")
            PrintNumber(ival)
            PrintMessage("] → ")
            PrintMessage(out)
            PrintMessage("\n")
        } ElseBlock: {
            // Variable index: comb async read Mem[idx_net]
            idx_net = CompileExprHDL(idx)
            IfCondition EqualTo(idx_net, 0) ThenBlock: {
                ReturnValue(0)
            }
            rhs = StringConcat(safe, "[")
            rhs = StringConcat(rhs, idx_net)
            rhs = StringConcat(rhs, "]")
            PrintMessage("  index ")
            PrintMessage(safe)
            PrintMessage("[")
            PrintMessage(idx_net)
            PrintMessage("] → ")
            PrintMessage(out)
            PrintMessage(" (var)\n")
        }

        NL_AddAssign(mod, out, rhs, NLKind.ASSIGN_COMB, 64)
        NL.last_net = out
        ReturnValue(out)
    }
}

// =============================================================================
// CALL — Add/Sub/... and user funcs
// =============================================================================
Function.CompileExprHDL_Call {
    Input: mod: Address
    Input: node: Address
    Output: Address
    Body: {
        fname = AST_GetData1(node)
        IfCondition EqualTo(fname, 0) ThenBlock: {
            NL_Error("call missing name", AST_GetLine(node))
            ReturnValue(0)
        }

        // --- Builtins → NetlistPrims (Yosys-aligned API list) ---
        // Clean AST CALL name → single table; Modules resolve here only.
        pkind = NL_Prim_KindFromCallName(fname)
        IfCondition NotEqual(pkind, 0) ThenBlock: {
            arity = NL_Prim_Arity(pkind)
            IfCondition EqualTo(arity, 1) ThenBlock: {
                ReturnValue(CompileExprHDL_UnaryCall(mod, node, pkind))
            }
            IfCondition EqualTo(arity, 2) ThenBlock: {
                ReturnValue(CompileExprHDL_BinCall(mod, node, pkind))
            }
            NL_Error("prim arity not supported for this call", AST_GetLine(node))
            ReturnValue(0)
        }

        // AbsoluteValue(x) → mux(x < 0, -x, x)  — structured, not if-soup
        IfCondition EqualTo(StringCompare(fname, "AbsoluteValue"), 0) ThenBlock: {
            IfCondition NotEqual(AST_GetChildCount(node), 1) ThenBlock: {
                NL_Error("AbsoluteValue expects 1 arg", AST_GetLine(node))
                ReturnValue(0)
            }
            a = CompileExprHDL(AST_GetChild(node, 0))
            IfCondition EqualTo(a, 0) ThenBlock: { ReturnValue(0) }
            z = NL_Prim_Const(mod, 0, 64)
            neg = NL_Prim_Neg(mod, a, 64)
            lt = NL_Prim_Lt(mod, a, z, 64)
            ReturnValue(NL_Prim_Mux(mod, lt, neg, a, 64))
        }

        // Print* as call form — same generic channel as AST.PRINT statements
        IfCondition EqualTo(StringCompare(fname, "PrintMessage"), 0) ThenBlock: {
            // Fabricate PRINT node semantics inline
            IfCondition GreaterThan(AST_GetChildCount(node), 0) ThenBlock: {
                arg = AST_GetChild(node, 0)
                IfCondition EqualTo(AST_GetType(arg), AST.STRING) ThenBlock: {
                    NL_EnsurePrintInfra()
                    n = NL_PrintAppendString(AST_GetData1(arg))
                    PrintMessage("  PrintMessage(call) → ")
                    PrintNumber(n)
                    PrintMessage(" bytes\n")
                }
            }
            ReturnValue(NL_EmitConst(mod, 0, 64))
        }
        IfCondition EqualTo(StringCompare(fname, "PrintNumber"), 0) ThenBlock: {
            IfCondition GreaterThan(AST_GetChildCount(node), 0) ThenBlock: {
                arg = AST_GetChild(node, 0)
                IfCondition EqualTo(AST_GetType(arg), AST.NUMBER) ThenBlock: {
                    NL_EnsurePrintInfra()
                    val = StringToNumber(AST_GetData1(arg))
                    IfCondition EqualTo(val, 0) ThenBlock: {
                        NL_PrintAppendByte(48)
                    } ElseBlock: {
                        n = val
                        IfCondition LessThan(n, 0) ThenBlock: {
                            NL_PrintAppendByte(45)
                            n = Subtract(0, n)
                        }
                        tmp = Array.Create(24)
                        WhileLoop GreaterThan(n, 0) {
                            d = Subtract(n, Multiply(Divide(n, 10), 10))
                            Array.Push(tmp, Add(48, d))
                            n = Divide(n, 10)
                        }
                        i = Array.Size(tmp)
                        WhileLoop GreaterThan(i, 0) {
                            i = Subtract(i, 1)
                            NL_PrintAppendByte(Array.Get(tmp, i))
                        }
                    }
                } ElseBlock: {
                    net = CompileExprHDL(arg)
                    IfCondition NotEqual(net, 0) ThenBlock: {
                        NL_PrintItoAEnqueue(net)
                    }
                }
            }
            ReturnValue(NL_Prim_Const(mod, 0, 64))
        }

        // Increment(x) / Decrement(x) → x±1 (expression value; store separately)
        IfCondition EqualTo(StringCompare(fname, "Increment"), 0) ThenBlock: {
            IfCondition NotEqual(AST_GetChildCount(node), 1) ThenBlock: {
                NL_Error("Increment expects 1 arg", AST_GetLine(node))
                ReturnValue(0)
            }
            a = CompileExprHDL(AST_GetChild(node, 0))
            IfCondition EqualTo(a, 0) ThenBlock: { ReturnValue(0) }
            one = NL_Prim_Const(mod, 1, 64)
            ReturnValue(NL_Prim_Add(mod, a, one, 64))
        }
        IfCondition EqualTo(StringCompare(fname, "Decrement"), 0) ThenBlock: {
            IfCondition NotEqual(AST_GetChildCount(node), 1) ThenBlock: {
                NL_Error("Decrement expects 1 arg", AST_GetLine(node))
                ReturnValue(0)
            }
            a = CompileExprHDL(AST_GetChild(node, 0))
            IfCondition EqualTo(a, 0) ThenBlock: { ReturnValue(0) }
            one = NL_Prim_Const(mod, 1, 64)
            ReturnValue(NL_Prim_Sub(mod, a, one, 64))
        }
        // Clamp(x, lo, hi) → Min(Max(x, lo), hi)
        IfCondition EqualTo(StringCompare(fname, "Clamp"), 0) ThenBlock: {
            IfCondition NotEqual(AST_GetChildCount(node), 3) ThenBlock: {
                NL_Error("Clamp expects 3 args (x, lo, hi)", AST_GetLine(node))
                ReturnValue(0)
            }
            x = CompileExprHDL(AST_GetChild(node, 0))
            lo = CompileExprHDL(AST_GetChild(node, 1))
            hi = CompileExprHDL(AST_GetChild(node, 2))
            IfCondition Or(EqualTo(x, 0), Or(EqualTo(lo, 0), EqualTo(hi, 0))) ThenBlock: {
                ReturnValue(0)
            }
            // max(x, lo)
            gt = NL_Prim_Gt(mod, x, lo, 64)
            t1 = NL_Prim_Mux(mod, gt, x, lo, 64)
            // min(t1, hi)
            lt = NL_Prim_Lt(mod, t1, hi, 64)
            ReturnValue(NL_Prim_Mux(mod, lt, t1, hi, 64))
        }

        // Select(cond, t, f) → mux  (structured ternary)
        IfCondition EqualTo(StringCompare(fname, "Select"), 0) ThenBlock: {
            IfCondition NotEqual(AST_GetChildCount(node), 3) ThenBlock: {
                NL_Error("Select expects 3 args (cond, then, else)", AST_GetLine(node))
                ReturnValue(0)
            }
            c = CompileExprHDL(AST_GetChild(node, 0))
            t = CompileExprHDL(AST_GetChild(node, 1))
            f = CompileExprHDL(AST_GetChild(node, 2))
            IfCondition Or(EqualTo(c, 0), Or(EqualTo(t, 0), EqualTo(f, 0))) ThenBlock: {
                ReturnValue(0)
            }
            ReturnValue(NL_Prim_Mux(mod, c, t, f, 64))
        }

        // Min(a,b) / Max(a,b) → structured mux (not if-soup)
        IfCondition EqualTo(StringCompare(fname, "Min"), 0) ThenBlock: {
            IfCondition NotEqual(AST_GetChildCount(node), 2) ThenBlock: {
                NL_Error("Min expects 2 args", AST_GetLine(node))
                ReturnValue(0)
            }
            a = CompileExprHDL(AST_GetChild(node, 0))
            b = CompileExprHDL(AST_GetChild(node, 1))
            IfCondition Or(EqualTo(a, 0), EqualTo(b, 0)) ThenBlock: { ReturnValue(0) }
            lt = NL_Prim_Lt(mod, a, b, 64)
            ReturnValue(NL_Prim_Mux(mod, lt, a, b, 64))
        }
        IfCondition EqualTo(StringCompare(fname, "Max"), 0) ThenBlock: {
            IfCondition NotEqual(AST_GetChildCount(node), 2) ThenBlock: {
                NL_Error("Max expects 2 args", AST_GetLine(node))
                ReturnValue(0)
            }
            a = CompileExprHDL(AST_GetChild(node, 0))
            b = CompileExprHDL(AST_GetChild(node, 1))
            IfCondition Or(EqualTo(a, 0), EqualTo(b, 0)) ThenBlock: { ReturnValue(0) }
            gt = NL_Prim_Gt(mod, a, b, 64)
            ReturnValue(NL_Prim_Mux(mod, gt, a, b, 64))
        }
        IfCondition EqualTo(StringCompare(fname, "PrintString"), 0) ThenBlock: {
            ReturnValue(NL_EmitConst(mod, 0, 64))
        }

        // User Function → hierarchical instance (must already be compiled/discovered)
        callee = NL_FindModule(fname)
        IfCondition NotEqual(callee, 0) ThenBlock: {
            ckind = NL_ModuleKind(callee)
            IfCondition EqualTo(ckind, NLKind.MODULE_FUNC) ThenBlock: {
                ReturnValue(CompileExprHDL_UserCall(mod, node, callee, fname))
            }
        }

        NL_Error("function call not in HDL body subset", AST_GetLine(node))
        PrintMessage("[HDL]   call ")
        PrintMessage(fname)
        PrintMessage("\n")
        ReturnValue(0)
    }
}

// Instantiate callee module; connect clk/rst + data ports in declaration order
Function.CompileExprHDL_UserCall {
    Input: mod: Address
    Input: node: Address
    Input: callee: Address
    Input: fname: Address
    Output: Address
    Body: {
        argc = AST_GetChildCount(node)
        // Collect data input ports (skip clk/rst) and one output (prefer "result")
        ports = NL_ModulePorts(callee)
        in_ports = Array.Create(8)
        out_port = 0
        IfCondition NotEqual(ports, 0) ThenBlock: {
            pc = Array.Size(ports)
            pi = 0
            WhileLoop LessThan(pi, pc) {
                p = Array.Get(ports, pi)
                pname = Dereference(p)
                pdir = Dereference(Add(p, 8))
                IfCondition EqualTo(pdir, NLKind.PORT_IN) ThenBlock: {
                    IfCondition NotEqual(StringCompare(pname, "clk"), 0) ThenBlock: {
                        IfCondition NotEqual(StringCompare(pname, "rst"), 0) ThenBlock: {
                            Array.Push(in_ports, pname)
                        }
                    }
                }
                IfCondition EqualTo(pdir, NLKind.PORT_OUT) ThenBlock: {
                    IfCondition EqualTo(StringCompare(pname, "result"), 0) ThenBlock: {
                        out_port = pname
                    }
                    IfCondition EqualTo(out_port, 0) ThenBlock: {
                        out_port = pname
                    }
                }
                pi = Add(pi, 1)
            }
        }

        nin = Array.Size(in_ports)
        IfCondition NotEqual(argc, nin) ThenBlock: {
            NL_Error("user call arity mismatch vs Function inputs", AST_GetLine(node))
            PrintMessage("[HDL]   ")
            PrintMessage(fname)
            PrintMessage(" expects ")
            PrintNumber(nin)
            PrintMessage(" args, got ")
            PrintNumber(argc)
            PrintMessage("\n")
            ReturnValue(0)
        }

        result_net = NL_FreshWire()
        inst = NL_AddInstance(mod, fname, result_net)
        NL_InstConnect(inst, "clk", "clk")
        NL_InstConnect(inst, "rst", "rst")

        ai = 0
        WhileLoop LessThan(ai, argc) {
            anet = CompileExprHDL(AST_GetChild(node, ai))
            IfCondition EqualTo(anet, 0) ThenBlock: {
                ReturnValue(0)
            }
            NL_InstConnect(inst, Array.Get(in_ports, ai), anet)
            ai = Add(ai, 1)
        }

        IfCondition EqualTo(out_port, 0) ThenBlock: {
            out_port = "result"
        }
        NL_InstConnect(inst, out_port, result_net)

        PrintMessage("  call ")
        PrintMessage(fname)
        PrintMessage(" → instance out=")
        PrintMessage(result_net)
        PrintMessage("\n")
        NL.last_net = result_net
        ReturnValue(result_net)
    }
}

Function.CompileExprHDL_BinCall {
    Input: mod: Address
    Input: node: Address
    Input: kind: Integer
    Output: Address
    Body: {
        argc = AST_GetChildCount(node)
        IfCondition NotEqual(argc, 2) ThenBlock: {
            NL_Error("binary op expects 2 args", AST_GetLine(node))
            ReturnValue(0)
        }
        a = CompileExprHDL(AST_GetChild(node, 0))
        IfCondition EqualTo(a, 0) ThenBlock: { ReturnValue(0) }
        b = CompileExprHDL(AST_GetChild(node, 1))
        IfCondition EqualTo(b, 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(NL_Prim_Emit(mod, kind, a, b, 64))
    }
}

Function.CompileExprHDL_UnaryCall {
    Input: mod: Address
    Input: node: Address
    Input: kind: Integer
    Output: Address
    Body: {
        argc = AST_GetChildCount(node)
        IfCondition LessThan(argc, 1) ThenBlock: {
            NL_Error("unary op expects 1 arg", AST_GetLine(node))
            ReturnValue(0)
        }
        a = CompileExprHDL(AST_GetChild(node, 0))
        IfCondition EqualTo(a, 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(NL_Prim_Emit(mod, kind, a, 0, 64))
    }
}

// AST binary / unary (if ever emitted; AIlang mostly uses calls)
Function.CompileExprHDL_BinaryOp {
    Input: mod: Address
    Input: node: Address
    Output: Address
    Body: {
        op = AST_GetData1(node)
        a = CompileExprHDL(AST_GetChild(node, 0))
        b = CompileExprHDL(AST_GetChild(node, 1))
        IfCondition Or(EqualTo(a, 0), EqualTo(b, 0)) ThenBlock: {
            ReturnValue(0)
        }
        kind = NLKind.CELL_ADD
        IfCondition EqualTo(op, AST.OP_ADD) ThenBlock: { kind = NLKind.CELL_ADD }
        IfCondition EqualTo(op, AST.OP_SUBTRACT) ThenBlock: { kind = NLKind.CELL_SUB }
        IfCondition EqualTo(op, AST.OP_MULTIPLY) ThenBlock: { kind = NLKind.CELL_MUL }
        IfCondition EqualTo(op, AST.OP_DIVIDE) ThenBlock: { kind = NLKind.CELL_DIV }
        IfCondition EqualTo(op, AST.OP_EQ) ThenBlock: { kind = NLKind.CELL_EQ }
        IfCondition EqualTo(op, AST.OP_NE) ThenBlock: { kind = NLKind.CELL_NE }
        IfCondition EqualTo(op, AST.OP_LT) ThenBlock: { kind = NLKind.CELL_LT }
        IfCondition EqualTo(op, AST.OP_GT) ThenBlock: { kind = NLKind.CELL_GT }
        IfCondition EqualTo(op, AST.OP_LE) ThenBlock: { kind = NLKind.CELL_LE }
        IfCondition EqualTo(op, AST.OP_GE) ThenBlock: { kind = NLKind.CELL_GE }
        IfCondition EqualTo(op, AST.OP_AND) ThenBlock: { kind = NLKind.CELL_LOGIC_AND }
        IfCondition EqualTo(op, AST.OP_OR) ThenBlock: { kind = NLKind.CELL_LOGIC_OR }
        ReturnValue(NL_Prim_Emit(mod, kind, a, b, 64))
    }
}

Function.CompileExprHDL_UnaryOp {
    Input: mod: Address
    Input: node: Address
    Output: Address
    Body: {
        a = CompileExprHDL(AST_GetChild(node, 0))
        IfCondition EqualTo(a, 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(NL_Prim_Emit(mod, NLKind.CELL_LOGIC_NOT, a, 0, 64))
    }
}
