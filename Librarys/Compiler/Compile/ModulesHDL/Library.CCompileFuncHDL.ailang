// Library.CCompileFuncHDL.ailang
// Function / SubRoutine / RunTask → netlist modules (circuit regions).
// Location: Librarys/Compiler/Compile/ModulesHDL/Library.CCompileFuncHDL.ailang
//
// Hardware meaning (v1):
//   Function.Name  → hierarchical module (ports from Input/Output decls)
//   SubRoutine.Name → hierarchical module (no params in AIlang style)
//   RunTask(Name)  → clocked sequential region (task module + note on top)
//
// Body lowering (statements → FSM/datapath) grows later.
// v1 records the region and stubs the body so serializers have structure.

LibraryImport.Arrays
LibraryImport.Compiler.Frontend.AST.CASTTypes
LibraryImport.Compiler.Frontend.AST.CASTCore
LibraryImport.Compiler.Compile.ModulesHDL.NetlistIRHDL

// =============================================================================
// FUNCTION → MODULE
// =============================================================================
Function.CompileFuncHDL_Function {
    Input: node: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: {
            ReturnValue(0)
        }

        name = AST_GetData1(node)
        IfCondition EqualTo(name, 0) ThenBlock: {
            NL_Error("Function missing name", AST_GetLine(node))
            ReturnValue(0)
        }

        // May already exist from discover pass — reuse shell, still wire ports/body
        mod = NL_FindModule(name)
        IfCondition EqualTo(mod, 0) ThenBlock: {
            mod = NL_CreateModule(name, NLKind.MODULE_FUNC)
            NL.func_count = Add(NL.func_count, 1)
        }
        NL_SetCurrentModule(mod)

        PrintMessage("[HDL] Function.")
        PrintMessage(name)
        PrintMessage(" → module\n")

        // Ports only once (discover may have created empty shell)
        ports = NL_ModulePorts(mod)
        pcount = 0
        IfCondition NotEqual(ports, 0) ThenBlock: {
            pcount = Array.Size(ports)
        }
        IfCondition EqualTo(pcount, 0) ThenBlock: {
            // Clock/reset available to sequential bodies later
            NL_AddPort(mod, "clk", NLKind.PORT_CLOCK, 1)
            NL_AddPort(mod, "rst", NLKind.PORT_RESET, 1)

            // Walk children for parameters and output decls
            child_count = AST_GetChildCount(node)
            i = 0
            WhileLoop LessThan(i, child_count) {
                child = AST_GetChild(node, i)
                ctype = AST_GetType(child)

                IfCondition EqualTo(ctype, AST.PARAMETER) ThenBlock: {
                    pname = AST_GetData1(child)
                    IfCondition NotEqual(pname, 0) ThenBlock: {
                        NL_AddPort(mod, pname, NLKind.PORT_IN, 64)
                        PrintMessage("  + in  ")
                        PrintMessage(pname)
                        PrintMessage("\n")
                    }
                }

                // Output: Type — DATA1 is a *type AST node*, not a port name.
                // AIlang functions return via the type; hardware uses a fixed
                // result port until named multi-out lands.
                IfCondition EqualTo(ctype, AST.OUTPUT_DECL) ThenBlock: {
                    NL_AddPort(mod, "result", NLKind.PORT_OUT, 64)
                    PrintMessage("  + out result\n")
                }

                i = Add(i, 1)
            }
        }

        ReturnValue(CompileFuncHDL_BodyStub(mod, node))
    }
}

// =============================================================================
// SUBROUTINE → MODULE
// =============================================================================
Function.CompileFuncHDL_SubRoutine {
    Input: node: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: {
            ReturnValue(0)
        }

        name = AST_GetData1(node)
        IfCondition EqualTo(name, 0) ThenBlock: {
            NL_Error("SubRoutine missing name", AST_GetLine(node))
            ReturnValue(0)
        }

        mod = NL_FindModule(name)
        IfCondition EqualTo(mod, 0) ThenBlock: {
            mod = NL_CreateModule(name, NLKind.MODULE_SUB)
            NL.sub_count = Add(NL.sub_count, 1)
        }
        NL_SetCurrentModule(mod)

        PrintMessage("[HDL] SubRoutine.")
        PrintMessage(name)
        PrintMessage(" → module\n")

        ports = NL_ModulePorts(mod)
        pcount = 0
        IfCondition NotEqual(ports, 0) ThenBlock: {
            pcount = Array.Size(ports)
        }
        IfCondition EqualTo(pcount, 0) ThenBlock: {
            NL_AddPort(mod, "clk", NLKind.PORT_CLOCK, 1)
            NL_AddPort(mod, "rst", NLKind.PORT_RESET, 1)
        }

        ReturnValue(CompileFuncHDL_BodyStub(mod, node))
    }
}

// =============================================================================
// RUNTASK → CLOCKED REGION
// Software: schedule work unit. Hardware: sequential process on clk.
// =============================================================================
Function.CompileFuncHDL_RunTask {
    Input: node: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: {
            ReturnValue(0)
        }

        // RunTask(task_name) — name usually in data1 or first child
        tname = AST_GetData1(node)
        IfCondition EqualTo(tname, 0) ThenBlock: {
            IfCondition GreaterThan(AST_GetChildCount(node), 0) ThenBlock: {
                child = AST_GetChild(node, 0)
                IfCondition EqualTo(AST_GetType(child), AST.IDENTIFIER) ThenBlock: {
                    tname = AST_GetData1(child)
                }
                IfCondition EqualTo(AST_GetType(child), AST.STRING) ThenBlock: {
                    tname = AST_GetData1(child)
                }
            }
        }

        IfCondition EqualTo(tname, 0) ThenBlock: {
            tname = "task_anon"
        }

        // Task module name: task_<name>
        mod_name = StringConcat("task_", tname)
        existing = NL_FindModule(mod_name)
        IfCondition EqualTo(existing, 0) ThenBlock: {
            mod = NL_CreateModule(mod_name, NLKind.MODULE_TASK)
            NL_AddPort(mod, "clk", NLKind.PORT_CLOCK, 1)
            NL_AddPort(mod, "rst", NLKind.PORT_RESET, 1)
            // Marker cell: sequential region (body fills later)
            NL_AddCell(mod, NLKind.CELL_DFF, "seq_state", 0, 0, 32)
            NL.task_count = Add(NL.task_count, 1)

            // Instance stub on top module
            top = NL_EnsureTop()
            NL_AddCell(top, NLKind.CELL_INSTANCE, mod_name, 0, 0, 0)
        }

        PrintMessage("[HDL] RunTask(")
        PrintMessage(tname)
        PrintMessage(") → clocked region ")
        PrintMessage(mod_name)
        PrintMessage("\n")

        ReturnValue(1)
    }
}

// =============================================================================
// BODY STUB — record that a body exists; full stmt/expr lowering is next phase
// =============================================================================
Function.CompileFuncHDL_BodyStub {
    Input: mod: Address
    Input: node: Address
    Output: Integer
    Body: {
        // Count statement-like children for visibility; do not lower yet
        stmt_count = 0
        child_count = AST_GetChildCount(node)
        i = 0
        WhileLoop LessThan(i, child_count) {
            child = AST_GetChild(node, i)
            ctype = AST_GetType(child)

            IfCondition EqualTo(ctype, AST.BODY) ThenBlock: {
                bc = AST_GetChildCount(child)
                stmt_count = Add(stmt_count, bc)
            }

            // SubRoutine statements are direct children
            IfCondition EqualTo(ctype, AST.ASSIGNMENT) ThenBlock: {
                stmt_count = Add(stmt_count, 1)
            }
            IfCondition EqualTo(ctype, AST.IF) ThenBlock: {
                stmt_count = Add(stmt_count, 1)
            }
            IfCondition EqualTo(ctype, AST.WHILE) ThenBlock: {
                stmt_count = Add(stmt_count, 1)
            }
            IfCondition EqualTo(ctype, AST.CALL) ThenBlock: {
                stmt_count = Add(stmt_count, 1)
            }
            IfCondition EqualTo(ctype, AST.RETURN) ThenBlock: {
                stmt_count = Add(stmt_count, 1)
            }
            IfCondition EqualTo(ctype, AST.BLOCK) ThenBlock: {
                stmt_count = Add(stmt_count, 1)
            }

            i = Add(i, 1)
        }

        IfCondition GreaterThan(stmt_count, 0) ThenBlock: {
            // Placeholder cell documents unfinished body lowering
            NL_AddCell(mod, NLKind.CELL_BUF, "__body_pending", stmt_count, 0, 1)
            PrintMessage("  body stmts≈")
            PrintNumber(stmt_count)
            PrintMessage(" (lowering pending)\n")
        }

        ReturnValue(1)
    }
}

// Pass-1 registration only (create empty module shell)
Function.CompileFuncHDL_Discover {
    Input: node: Address
    Input: kind: Integer
    Output: Integer
    Body: {
        name = AST_GetData1(node)
        IfCondition EqualTo(name, 0) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition EqualTo(NL_FindModule(name), 0) ThenBlock: {
            NL_CreateModule(name, kind)
            IfCondition EqualTo(kind, NLKind.MODULE_FUNC) ThenBlock: {
                NL.func_count = Add(NL.func_count, 1)
            }
            IfCondition EqualTo(kind, NLKind.MODULE_SUB) ThenBlock: {
                NL.sub_count = Add(NL.sub_count, 1)
            }
        }
        ReturnValue(1)
    }
}
