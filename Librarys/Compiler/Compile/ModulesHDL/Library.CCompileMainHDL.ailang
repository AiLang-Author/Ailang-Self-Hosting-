// Library.CCompileMainHDL.ailang
// HDL / netlist compile dispatcher for the AILang self-hosting compiler.
// Location: Librarys/Compiler/Compile/ModulesHDL/Library.CCompileMainHDL.ailang
//
// Split point from CCompileMain (x86):
//   Same frontend AST in.
//   Different generators: circuit graph, not machine code.
//   Serializers live in this folder (Verilog + JSON). No Emit_Byte / ELF path.
//
// v1 subset + body lowering:
//   FixedPool, Function, SubRoutine, RunTask
//   Bodies: assign, return, if, Add/Sub/Mul/Div, compares
//   Main body lowers into ailang_top (seq); pure Functions are comb modules
//
// Entry:
//   CompileHDL_Init()
//   CompileHDL_Program(ast) → builds netlist IR
//   CompileHDL_WriteVerilog(path) / CompileHDL_WriteJson(path)
//   CompileHDL_Free()

LibraryImport.Arrays
LibraryImport.Compiler.Frontend.AST.CASTTypes
LibraryImport.Compiler.Frontend.AST.CASTCore

LibraryImport.Compiler.Compile.ModulesHDL.NetlistIRHDL
LibraryImport.Compiler.Compile.ModulesHDL.NetlistPrimsHDL
LibraryImport.Compiler.Compile.ModulesHDL.CCompilePoolHDL
LibraryImport.Compiler.Compile.ModulesHDL.CCompileExprHDL
LibraryImport.Compiler.Compile.ModulesHDL.CCompileStmtHDL
LibraryImport.Compiler.Compile.ModulesHDL.CCompileFuncHDL
LibraryImport.Compiler.Compile.ModulesHDL.EmitVerilogHDL
LibraryImport.Compiler.Compile.ModulesHDL.EmitJsonHDL
LibraryImport.Compiler.Compile.ModulesHDL.EmitSdcHDL

// =============================================================================
// HDL COMPILE STATE (separate from x86 FixedPool.Compile)
// =============================================================================
FixedPool.CompileHDL {
    "ast":            Initialize=0, CanChange=True
    "error":          Initialize=0, CanChange=True
    "error_msg":      Initialize=0, CanChange=True
    "error_line":     Initialize=0, CanChange=True
    "nodes_compiled": Initialize=0, CanChange=True
    "strict":         Initialize=1, CanChange=True
    "out_verilog":    Initialize=0, CanChange=True
    "out_json":       Initialize=0, CanChange=True
}

// =============================================================================
// INIT / FREE
// =============================================================================
Function.CompileHDL_Init {
    Output: Integer
    Body: {
        CompileHDL.ast = 0
        CompileHDL.error = 0
        CompileHDL.error_msg = 0
        CompileHDL.error_line = 0
        CompileHDL.nodes_compiled = 0
        CompileHDL.strict = 1
        CompileHDL.out_verilog = 0
        CompileHDL.out_json = 0
        NL_Init()
        PrintMessage("[HDL] CompileHDL_Init — netlist backend ready\n")
        PrintMessage("[HDL] subset: FixedPool, Function, SubRoutine, RunTask\n")
        ReturnValue(1)
    }
}

Function.CompileHDL_Free {
    Body: {
        NL_Free()
        CompileHDL.ast = 0
        CompileHDL.out_verilog = 0
        CompileHDL.out_json = 0
    }
}

Function.CompileHDL_Error {
    Input: msg: Address
    Input: line: Integer
    Body: {
        CompileHDL.error = 1
        CompileHDL.error_msg = msg
        CompileHDL.error_line = line
        NL_Error(msg, line)
    }
}

// =============================================================================
// MAIN ENTRY — AST → netlist IR
// =============================================================================
Function.CompileHDL_Program {
    Input: ast: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(ast, 0) ThenBlock: {
            CompileHDL_Error("Null AST", 0)
            ReturnValue(0)
        }

        CompileHDL.ast = ast
        PrintMessage("[HDL] Pass 1: discover FixedPool / Function / SubRoutine\n")
        CompileHDL_Discover(ast)
        IfCondition EqualTo(CompileHDL.error, 1) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition EqualTo(NL.error, 1) ThenBlock: {
            CompileHDL.error = 1
            ReturnValue(0)
        }

        // Always have a top container for pool memories
        NL_EnsureTop()

        PrintMessage("[HDL] Pass 2: generate netlist graph\n")
        CompileHDL_Generate(ast)
        IfCondition EqualTo(CompileHDL.error, 1) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition EqualTo(NL.error, 1) ThenBlock: {
            CompileHDL.error = 1
            ReturnValue(0)
        }

        PrintMessage("[HDL] Pass 3: complete\n")
        NL_PrintStats()
        ReturnValue(1)
    }
}

// Compile + write artifacts next to a base path
// base "out/foo" → .v .nl.json .sdc .ys .pins  (+ .blif via yosys -s)
Function.CompileHDL_ProgramToFiles {
    Input: ast: Address
    Input: base_path: Address
    Output: Integer
    Body: {
        ok = CompileHDL_Program(ast)
        IfCondition EqualTo(ok, 0) ThenBlock: {
            ReturnValue(0)
        }

        vpath = StringConcat(base_path, ".v")
        jpath = StringConcat(base_path, ".nl.json")
        spath = StringConcat(base_path, ".sdc")
        ypath = StringConcat(base_path, ".ys")
        ppath = StringConcat(base_path, ".pins")
        bpath = StringConcat(base_path, ".blif")

        IfCondition EqualTo(CompileHDL_WriteVerilog(vpath), 0) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition EqualTo(CompileHDL_WriteJson(jpath), 0) ThenBlock: {
            ReturnValue(0)
        }
        // Sidecars are best-effort (still success if .v ok)
        CompileHDL_WriteSdc(spath)
        CompileHDL_WriteYosys(ypath, vpath, bpath)
        CompileHDL_WritePins(ppath)
        ReturnValue(1)
    }
}

// =============================================================================
// SERIALIZE HELPERS
// =============================================================================
Function.CompileHDL_WriteVerilog {
    Input: path: Address
    Output: Integer
    Body: {
        ReturnValue(EmitVerilogHDL_WriteFile(path))
    }
}

Function.CompileHDL_WriteJson {
    Input: path: Address
    Output: Integer
    Body: {
        ReturnValue(EmitJsonHDL_WriteFile(path))
    }
}

Function.CompileHDL_WriteSdc {
    Input: path: Address
    Output: Integer
    Body: {
        ReturnValue(EmitSdcHDL_WriteFile(path))
    }
}

Function.CompileHDL_WriteYosys {
    Input: path: Address
    Input: vpath: Address
    Input: blifpath: Address
    Output: Integer
    Body: {
        ReturnValue(EmitYosysTcl_WriteFile(path, vpath, blifpath))
    }
}

Function.CompileHDL_WritePins {
    Input: path: Address
    Output: Integer
    Body: {
        ReturnValue(EmitPinsHDL_WriteFile(path))
    }
}

Function.CompileHDL_GetVerilogText {
    Output: Address
    Body: {
        CompileHDL.out_verilog = EmitVerilogHDL_Serialize()
        ReturnValue(CompileHDL.out_verilog)
    }
}

Function.CompileHDL_GetJsonText {
    Output: Address
    Body: {
        CompileHDL.out_json = EmitJsonHDL_Serialize()
        ReturnValue(CompileHDL.out_json)
    }
}

// =============================================================================
// PASS 1 — DISCOVER
// =============================================================================
Function.CompileHDL_Discover {
    Input: ast: Address
    Body: {
        IfCondition EqualTo(ast, 0) ThenBlock: {
            ReturnValue(0)
        }

        node_type = AST_GetType(ast)

        IfCondition EqualTo(node_type, AST.PROGRAM) ThenBlock: {
            count = AST_GetChildCount(ast)
            i = 0
            WhileLoop LessThan(i, count) {
                child = AST_GetChild(ast, i)
                CompileHDL_Discover(child)
                IfCondition EqualTo(NL.error, 1) ThenBlock: {
                    ExitLoop
                }
                i = Add(i, 1)
            }
            ReturnValue(1)
        }

        IfCondition EqualTo(node_type, AST.FUNCTION) ThenBlock: {
            CompileFuncHDL_Discover(ast, NLKind.MODULE_FUNC)
            ReturnValue(1)
        }

        IfCondition EqualTo(node_type, AST.SUBROUTINE) ThenBlock: {
            CompileFuncHDL_Discover(ast, NLKind.MODULE_SUB)
            ReturnValue(1)
        }

        // Pools registered in generate pass (need member details)
        IfCondition EqualTo(node_type, AST.POOL_FIXED) ThenBlock: {
            ReturnValue(1)
        }

        IfCondition EqualTo(node_type, AST.LIBRARY_IMPORT) ThenBlock: {
            ReturnValue(1)
        }

        ReturnValue(0)
    }
}

// =============================================================================
// PASS 2 — GENERATE
// =============================================================================
Function.CompileHDL_Generate {
    Input: ast: Address
    Body: {
        IfCondition EqualTo(ast, 0) ThenBlock: {
            ReturnValue(0)
        }

        node_type = AST_GetType(ast)

        IfCondition EqualTo(node_type, AST.PROGRAM) ThenBlock: {
            count = AST_GetChildCount(ast)
            i = 0
            WhileLoop LessThan(i, count) {
                IfCondition EqualTo(NL.error, 1) ThenBlock: {
                    ExitLoop
                }
                IfCondition EqualTo(CompileHDL.error, 1) ThenBlock: {
                    ExitLoop
                }
                child = AST_GetChild(ast, i)
                CompileHDL_Node(child)
                i = Add(i, 1)
            }
            ReturnValue(1)
        }

        CompileHDL_Node(ast)
        ReturnValue(1)
    }
}

// =============================================================================
// NODE DISPATCH — v1 subset only
// =============================================================================
Function.CompileHDL_Node {
    Input: node: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition EqualTo(CompileHDL.error, 1) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition EqualTo(NL.error, 1) ThenBlock: {
            ReturnValue(0)
        }

        node_type = AST_GetType(node)
        CompileHDL.nodes_compiled = Add(CompileHDL.nodes_compiled, 1)
        NL.nodes_seen = Add(NL.nodes_seen, 1)

        // --- Allowed ---
        IfCondition EqualTo(node_type, AST.PROGRAM) ThenBlock: {
            ReturnValue(CompileHDL_Generate(node))
        }

        IfCondition EqualTo(node_type, AST.LIBRARY_IMPORT) ThenBlock: {
            ReturnValue(1)
        }

        IfCondition EqualTo(node_type, AST.POOL_FIXED) ThenBlock: {
            ReturnValue(CompilePoolHDL_Fixed(node))
        }

        IfCondition EqualTo(node_type, AST.FUNCTION) ThenBlock: {
            ReturnValue(CompileFuncHDL_Function(node))
        }

        IfCondition EqualTo(node_type, AST.SUBROUTINE) ThenBlock: {
            ReturnValue(CompileFuncHDL_SubRoutine(node))
        }

        IfCondition EqualTo(node_type, AST.RUN_TASK) ThenBlock: {
            ReturnValue(CompileFuncHDL_RunTask(node))
        }

        // --- Explicit rejects (memory growth / non-subset) ---
        IfCondition EqualTo(node_type, AST.POOL_DYNAMIC) ThenBlock: {
            ReturnValue(CompilePoolHDL_Dynamic(node))
        }

        IfCondition EqualTo(node_type, AST.POOL_TEMPORAL) ThenBlock: {
            ReturnValue(CompilePoolHDL_Unsupported(node, "TemporalPool"))
        }
        IfCondition EqualTo(node_type, AST.POOL_NEURAL) ThenBlock: {
            ReturnValue(CompilePoolHDL_Unsupported(node, "NeuralPool"))
        }
        IfCondition EqualTo(node_type, AST.POOL_KERNEL) ThenBlock: {
            ReturnValue(CompilePoolHDL_Unsupported(node, "KernelPool"))
        }
        IfCondition EqualTo(node_type, AST.POOL_ACTOR) ThenBlock: {
            ReturnValue(CompilePoolHDL_Unsupported(node, "ActorPool"))
        }
        IfCondition EqualTo(node_type, AST.POOL_SECURITY) ThenBlock: {
            ReturnValue(CompilePoolHDL_Unsupported(node, "SecurityPool"))
        }
        IfCondition EqualTo(node_type, AST.POOL_FILE) ThenBlock: {
            ReturnValue(CompilePoolHDL_Unsupported(node, "FilePool"))
        }
        IfCondition EqualTo(node_type, AST.POOL_LINKAGE) ThenBlock: {
            ReturnValue(CompilePoolHDL_Unsupported(node, "LinkagePool"))
        }

        // Top-level statements outside functions: allow only if we later
        // map them into top sequential region. v1: warn in non-strict, error in strict.
        IfCondition EqualTo(node_type, AST.ASSIGNMENT) ThenBlock: {
            ReturnValue(CompileHDL_UnsupportedNode(node, "top-level assignment"))
        }
        IfCondition EqualTo(node_type, AST.IF) ThenBlock: {
            ReturnValue(CompileHDL_UnsupportedNode(node, "If (body lowering pending)"))
        }
        IfCondition EqualTo(node_type, AST.WHILE) ThenBlock: {
            ReturnValue(CompileHDL_UnsupportedNode(node, "While (body lowering pending)"))
        }
        IfCondition EqualTo(node_type, AST.CALL) ThenBlock: {
            ReturnValue(CompileHDL_UnsupportedNode(node, "Call (body lowering pending)"))
        }

        // Unknown / not yet in subset
        ReturnValue(CompileHDL_UnsupportedNode(node, "AST node not in HDL v1 subset"))
    }
}

Function.CompileHDL_UnsupportedNode {
    Input: node: Address
    Input: what: Address
    Output: Integer
    Body: {
        line = 0
        IfCondition NotEqual(node, 0) ThenBlock: {
            line = AST_GetLine(node)
        }
        IfCondition EqualTo(CompileHDL.strict, 1) ThenBlock: {
            CompileHDL_Error(what, line)
            PrintMessage("[HDL]   node_type=")
            PrintNumber(AST_GetType(node))
            PrintMessage("\n")
            ReturnValue(0)
        }
        // Non-strict: skip with warning
        PrintMessage("[HDL] WARN skip: ")
        PrintMessage(what)
        PrintMessage(" (type=")
        PrintNumber(AST_GetType(node))
        PrintMessage(")\n")
        ReturnValue(1)
    }
}

// =============================================================================
// STATS
// =============================================================================
Function.CompileHDL_PrintStats {
    Body: {
        PrintMessage("[HDL COMPILE STATS]\n")
        PrintMessage("  nodes walked: ")
        PrintNumber(CompileHDL.nodes_compiled)
        PrintMessage("\n")
        NL_PrintStats()
        IfCondition EqualTo(CompileHDL.error, 1) ThenBlock: {
            PrintMessage("  compile error: yes\n")
            IfCondition NotEqual(CompileHDL.error_msg, 0) ThenBlock: {
                PrintMessage("  message: ")
                PrintMessage(CompileHDL.error_msg)
                PrintMessage("\n")
            }
        }
    }
}
