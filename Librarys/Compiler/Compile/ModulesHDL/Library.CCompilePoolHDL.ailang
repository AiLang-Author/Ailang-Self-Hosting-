// Library.CCompilePoolHDL.ailang
// FixedPool → netlist memories / register storage.
// Location: Librarys/Compiler/Compile/ModulesHDL/Library.CCompilePoolHDL.ailang
//
// Hardware meaning:
//   FixedPool.Name { "field": Initialize=N, MaximumLength-K }
//     → memory/regfile in the top module
//   DynamicPool and growth are illegal in v1 (reject).
//
// No x86 MOV [R15+off]. Storage is placed, not grown.

LibraryImport.Arrays
LibraryImport.Compiler.Frontend.AST.CASTTypes
LibraryImport.Compiler.Frontend.AST.CASTCore
LibraryImport.Compiler.Compile.ModulesHDL.NetlistIRHDL

// Default Integer width for pool scalars (matches AIlang 64-bit values)
FixedPool.PoolHDLConst {
    "DEFAULT_WIDTH": Initialize=64
    "DEFAULT_DEPTH": Initialize=1
}

// =============================================================================
// FIXED POOL → MEMORIES
// =============================================================================
Function.CompilePoolHDL_Fixed {
    Input: pool_node: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(pool_node, 0) ThenBlock: {
            ReturnValue(0)
        }

        pool_name = AST_GetData1(pool_node)
        IfCondition EqualTo(pool_name, 0) ThenBlock: {
            NL_Error("FixedPool missing name", AST_GetLine(pool_node))
            ReturnValue(0)
        }

        top = NL_EnsureTop()
        NL.pool_count = Add(NL.pool_count, 1)

        PrintMessage("[HDL] FixedPool.")
        PrintMessage(pool_name)
        PrintMessage("\n")

        count = AST_GetChildCount(pool_node)
        i = 0
        WhileLoop LessThan(i, count) {
            member = AST_GetChild(pool_node, i)
            member_type = AST_GetType(member)

            IfCondition EqualTo(member_type, AST.POOL_MEMBER) ThenBlock: {
                CompilePoolHDL_Member(top, pool_name, member)
                IfCondition EqualTo(NL.error, 1) ThenBlock: {
                    ReturnValue(0)
                }
            }

            // Nested SubPool later — v1 rejects explicitly
            IfCondition EqualTo(member_type, AST.SUBPOOL) ThenBlock: {
                NL_Error("SubPool not supported in HDL v1 subset", AST_GetLine(member))
                ReturnValue(0)
            }

            i = Add(i, 1)
        }

        ReturnValue(1)
    }
}

// One pool member → one memory entry
Function.CompilePoolHDL_Member {
    Input: top: Address
    Input: pool_name: Address
    Input: member: Address
    Output: Integer
    Body: {
        field_name = AST_GetData1(member)
        IfCondition EqualTo(field_name, 0) ThenBlock: {
            NL_Error("pool member missing name", AST_GetLine(member))
            ReturnValue(0)
        }

        width = PoolHDLConst.DEFAULT_WIDTH
        depth = PoolHDLConst.DEFAULT_DEPTH
        init_value = 0
        is_string = 0

        // Initializer on DATA2 (NUMBER or STRING node), same as x86 Compile_RegisterPool
        init_node = AST_GetData2(member)
        IfCondition NotEqual(init_node, 0) ThenBlock: {
            init_type = AST_GetType(init_node)
            IfCondition EqualTo(init_type, AST.NUMBER) ThenBlock: {
                init_str = AST_GetData1(init_node)
                init_value = StringToNumber(init_str)
            }
            IfCondition EqualTo(init_type, AST.STRING) ThenBlock: {
                // Hardware has no OS string heap — record as rejected for v1
                // (or treat as ROM later). For now: hard error keeps subset honest.
                NL_Error("string FixedPool initializers not in HDL v1", AST_GetLine(member))
                ReturnValue(0)
            }
        }

        // Scan attributes: MaximumLength, ElementType (POOL_ATTR / typed nodes)
        attr_count = AST_GetChildCount(member)
        a = 0
        WhileLoop LessThan(a, attr_count) {
            attr = AST_GetChild(member, a)
            attr_type = AST_GetType(attr)

            IfCondition EqualTo(attr_type, AST.POOL_MAXLENGTH) ThenBlock: {
                ml = AST_GetData1(attr)
                dtry = 0
                IfCondition NotEqual(ml, 0) ThenBlock: {
                    // String digits, or accidental negative int
                    IfCondition LessThan(ml, 0) ThenBlock: {
                        dtry = Subtract(0, ml)
                    } ElseBlock: {
                        dtry = StringToNumber(ml)
                        IfCondition LessThan(dtry, 0) ThenBlock: {
                            dtry = Subtract(0, dtry)
                        }
                    }
                    IfCondition GreaterThan(dtry, 0) ThenBlock: {
                        depth = dtry
                    }
                }
                IfCondition GreaterThan(AST_GetChildCount(attr), 0) ThenBlock: {
                    vn = AST_GetChild(attr, 0)
                    IfCondition EqualTo(AST_GetType(vn), AST.NUMBER) ThenBlock: {
                        depth = StringToNumber(AST_GetData1(vn))
                        IfCondition LessThan(depth, 0) ThenBlock: {
                            depth = Subtract(0, depth)
                        }
                    }
                }
            }

            IfCondition EqualTo(attr_type, AST.POOL_ELEMENTTYPE) ThenBlock: {
                et = AST_GetData1(attr)
                width = CompilePoolHDL_WidthFromElementType(et)
            }

            IfCondition EqualTo(attr_type, AST.POOL_ATTR) ThenBlock: {
                key = AST_GetData1(attr)
                val_node = AST_GetData2(attr)
                IfCondition EqualTo(val_node, 0) ThenBlock: {
                    IfCondition GreaterThan(AST_GetChildCount(attr), 0) ThenBlock: {
                        val_node = AST_GetChild(attr, 0)
                    }
                }
                IfCondition NotEqual(key, 0) ThenBlock: {
                    IfCondition EqualTo(StringCompare(key, "MaximumLength"), 0) ThenBlock: {
                        IfCondition NotEqual(val_node, 0) ThenBlock: {
                            IfCondition EqualTo(AST_GetType(val_node), AST.NUMBER) ThenBlock: {
                                depth = StringToNumber(AST_GetData1(val_node))
                            }
                            IfCondition EqualTo(AST_GetType(val_node), AST.UNARY_OP) ThenBlock: {
                                IfCondition GreaterThan(AST_GetChildCount(val_node), 0) ThenBlock: {
                                    vn = AST_GetChild(val_node, 0)
                                    IfCondition EqualTo(AST_GetType(vn), AST.NUMBER) ThenBlock: {
                                        depth = StringToNumber(AST_GetData1(vn))
                                    }
                                }
                            }
                            IfCondition LessThan(depth, 0) ThenBlock: {
                                depth = Subtract(0, depth)
                            }
                        }
                    }
                    IfCondition EqualTo(StringCompare(key, "ElementType"), 0) ThenBlock: {
                        etname = 0
                        IfCondition NotEqual(val_node, 0) ThenBlock: {
                            IfCondition EqualTo(AST_GetType(val_node), AST.IDENTIFIER) ThenBlock: {
                                etname = AST_GetData1(val_node)
                            }
                            IfCondition EqualTo(etname, 0) ThenBlock: {
                                etname = AST_GetData1(val_node)
                            }
                        }
                        width = CompilePoolHDL_WidthFromElementType(etname)
                    }
                }
            }

            a = Add(a, 1)
        }

        IfCondition LessEqual(depth, 0) ThenBlock: {
            depth = PoolHDLConst.DEFAULT_DEPTH
        }
        // Cap absurd depths (safety)
        IfCondition GreaterThan(depth, 4096) ThenBlock: {
            NL_Error("FixedPool MaximumLength > 4096 not accepted in HDL v1", AST_GetLine(member))
            ReturnValue(0)
        }

        full = StringConcat(pool_name, ".")
        full = StringConcat(full, field_name)

        // ≤6-arg call (ABI-safe), then set pool/field meta
        mem = NL_AddMemory(top, full, width, depth, init_value)
        NL_MemorySetMeta(mem, pool_name, field_name, is_string)

        // Scalar (depth 1) also gets a simple DFF cell stub for sequential use
        IfCondition EqualTo(depth, 1) ThenBlock: {
            NL_AddCell(top, NLKind.CELL_DFF, full, init_value, 0, width)
        } ElseBlock: {
            NL_AddCell(top, NLKind.CELL_MEM, full, depth, 0, width)
        }

        // Scalars: export as top output reg (observe + keep under synth DCE).
        // Arrays (depth>1): internal mem/ROM fabric — port per-element later.
        safe = NL_SafeIdent(full)
        IfCondition EqualTo(depth, 1) ThenBlock: {
            NL_AddPort(top, safe, NLKind.PORT_OUT, width)
            PrintMessage("  + mem ")
            PrintMessage(full)
            PrintMessage(" w=")
            PrintNumber(width)
            PrintMessage(" (out port)\n")
        } ElseBlock: {
            PrintMessage("  + mem ")
            PrintMessage(full)
            PrintMessage(" w=")
            PrintNumber(width)
            PrintMessage(" d=")
            PrintNumber(depth)
            PrintMessage(" (array/ROM fabric)\n")
        }

        ReturnValue(1)
    }
}

// ElementType name → bit width
Function.CompilePoolHDL_WidthFromElementType {
    Input: etname: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(etname, 0) ThenBlock: {
            ReturnValue(PoolHDLConst.DEFAULT_WIDTH)
        }
        IfCondition EqualTo(StringCompare(etname, "Byte"), 0) ThenBlock: {
            ReturnValue(8)
        }
        IfCondition EqualTo(StringCompare(etname, "bit"), 0) ThenBlock: {
            ReturnValue(1)
        }
        IfCondition EqualTo(StringCompare(etname, "Bit"), 0) ThenBlock: {
            ReturnValue(1)
        }
        IfCondition EqualTo(StringCompare(etname, "Integer"), 0) ThenBlock: {
            ReturnValue(64)
        }
        IfCondition EqualTo(StringCompare(etname, "Address"), 0) ThenBlock: {
            ReturnValue(64)
        }
        IfCondition EqualTo(StringCompare(etname, "Text"), 0) ThenBlock: {
            // text blobs not synthesizable as scalar width — keep 64 ptr-ish
            ReturnValue(64)
        }
        ReturnValue(PoolHDLConst.DEFAULT_WIDTH)
    }
}

// DynamicPool is not placeable without a hard max — reject in v1
Function.CompilePoolHDL_Dynamic {
    Input: pool_node: Address
    Output: Integer
    Body: {
        name = AST_GetData1(pool_node)
        msg = "DynamicPool illegal for HDL target (memory cannot grow); use FixedPool"
        NL_Error(msg, AST_GetLine(pool_node))
        IfCondition NotEqual(name, 0) ThenBlock: {
            PrintMessage("[HDL]   DynamicPool.")
            PrintMessage(name)
            PrintMessage("\n")
        }
        ReturnValue(0)
    }
}

// Other pool kinds — not in subset
Function.CompilePoolHDL_Unsupported {
    Input: pool_node: Address
    Input: kind_name: Address
    Output: Integer
    Body: {
        NL_Error("pool kind not in HDL v1 subset (FixedPool only)", AST_GetLine(pool_node))
        IfCondition NotEqual(kind_name, 0) ThenBlock: {
            PrintMessage("[HDL]   kind=")
            PrintMessage(kind_name)
            PrintMessage("\n")
        }
        ReturnValue(0)
    }
}
