// Library.CCompileStmtHDL.ailang
// Statement lowering → assigns (mirrors CCompileStmt).
// Location: Librarys/Compiler/Compile/ModulesHDL/Library.CCompileStmtHDL.ailang
//
// Supported: BLOCK, ASSIGNMENT, RETURN, IF (simple then/else → mux or seq),
//            expression statements (calls with side-effect ignore).

LibraryImport.Arrays
LibraryImport.Compiler.Frontend.AST.CASTTypes
LibraryImport.Compiler.Frontend.AST.CASTCore
LibraryImport.Compiler.Compile.ModulesHDL.NetlistIRHDL
LibraryImport.Compiler.Compile.ModulesHDL.NetlistPrimsHDL
LibraryImport.Compiler.Compile.ModulesHDL.CCompileExprHDL

// =============================================================================
// DISPATCH
// =============================================================================
Function.CompileStmtHDL {
    Input: node: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: {
            ReturnValue(1)
        }
        IfCondition EqualTo(NL.error, 1) ThenBlock: {
            ReturnValue(0)
        }

        ntype = AST_GetType(node)

        IfCondition EqualTo(ntype, AST.BLOCK) ThenBlock: {
            ReturnValue(CompileStmtHDL_Block(node))
        }
        IfCondition EqualTo(ntype, AST.BODY) ThenBlock: {
            ReturnValue(CompileStmtHDL_Block(node))
        }
        IfCondition EqualTo(ntype, AST.ASSIGNMENT) ThenBlock: {
            ReturnValue(CompileStmtHDL_Assign(node))
        }
        IfCondition EqualTo(ntype, AST.INDEX_ASSIGN) ThenBlock: {
            ReturnValue(CompileStmtHDL_IndexAssign(node))
        }
        IfCondition EqualTo(ntype, AST.RETURN) ThenBlock: {
            ReturnValue(CompileStmtHDL_Return(node))
        }
        IfCondition EqualTo(ntype, AST.IF) ThenBlock: {
            ReturnValue(CompileStmtHDL_If(node))
        }
        IfCondition EqualTo(ntype, AST.FORK) ThenBlock: {
            // Same shape as If — 2-way; still markers for now (2-entry mux later)
            ReturnValue(CompileStmtHDL_If(node))
        }
        IfCondition EqualTo(ntype, AST.SWITCH) ThenBlock: {
            // Branch → prefer LUT/matrix table over if-else chains
            ReturnValue(CompileStmtHDL_BranchLut(node))
        }
        IfCondition EqualTo(ntype, AST.WHILE) ThenBlock: {
            // One body iteration per clock while cond holds (multi-cycle)
            ReturnValue(CompileStmtHDL_While(node))
        }
        IfCondition EqualTo(ntype, AST.UNTIL) ThenBlock: {
            // UntilCondition C { body } ≡ WhileLoop Not(C) { body }
            ReturnValue(CompileStmtHDL_Until(node))
        }
        IfCondition EqualTo(ntype, AST.FOR_EVERY) ThenBlock: {
            // Bounded unroll over FixedPool array only
            ReturnValue(CompileStmtHDL_ForEvery(node))
        }
        IfCondition EqualTo(ntype, AST.EXIT_LOOP) ThenBlock: {
            PrintMessage("[HDL] note: ExitLoop ignored in HW (use bounded While/Branch)\n")
            ReturnValue(1)
        }
        IfCondition EqualTo(ntype, AST.CONTINUE_LOOP) ThenBlock: {
            PrintMessage("[HDL] note: ContinueLoop ignored in HW (1 iter/clock already)\n")
            ReturnValue(1)
        }
        IfCondition EqualTo(ntype, AST.CALL) ThenBlock: {
            // expression statement
            r = CompileExprHDL(node)
            IfCondition EqualTo(r, 0) ThenBlock: {
                IfCondition EqualTo(NL.error, 1) ThenBlock: {
                    ReturnValue(0)
                }
            }
            ReturnValue(1)
        }
        // PrintMessage / PrintNumber — orthogonal I/O (not ignored)
        IfCondition EqualTo(ntype, AST.PRINT) ThenBlock: {
            ReturnValue(CompileStmtHDL_Print(node))
        }
        // HALT — no OS; treat as no-op in hardware (chip keeps clocking)
        IfCondition EqualTo(ntype, AST.HALT) ThenBlock: {
            PrintMessage("[HDL] note: Halt ignored on silicon (no process exit)\n")
            ReturnValue(1)
        }

        // Skip empty / unsupported quietly in non-strict path — MainHDL sets strict
        PrintMessage("[HDL] stmt skip type=")
        PrintNumber(ntype)
        PrintMessage("\n")
        ReturnValue(1)
    }
}

// =============================================================================
// PRINT — generic software I/O → gates (orthogonal stdout)
// PrintMessage("Hi")  → append to shared print ROM (queue = source order)
// PrintNumber(const)  → decimal digits into same ROM
// PrintNumber(expr)   → enqueue net for multi-job itoa after ROM (order preserved)
// =============================================================================
Function.CompileStmtHDL_Print {
    Input: node: Address
    Output: Integer
    Body: {
        kind = AST_GetData1(node)   // 1=message 2=number
        IfCondition EqualTo(AST_GetChildCount(node), 0) ThenBlock: {
            ReturnValue(1)
        }
        arg = AST_GetChild(node, 0)
        NL_EnsurePrintInfra()

        IfCondition EqualTo(kind, 1) ThenBlock: {
            IfCondition EqualTo(AST_GetType(arg), AST.STRING) ThenBlock: {
                s = AST_GetData1(arg)
                n = NL_PrintAppendString(s)
                PrintMessage("  PrintMessage → ")
                PrintNumber(n)
                PrintMessage(" bytes into print ROM (queued)\n")
                ReturnValue(1)
            }
            NL_Error("PrintMessage(expr) needs string literal for HDL (generic emit)", AST_GetLine(node))
            ReturnValue(0)
        }

        IfCondition EqualTo(kind, 2) ThenBlock: {
            IfCondition EqualTo(AST_GetType(arg), AST.NUMBER) ThenBlock: {
                val = StringToNumber(AST_GetData1(arg))
                CompileStmtHDL_PrintAppendDecimal(val)
                PrintMessage("  PrintNumber(")
                PrintNumber(val)
                PrintMessage(") → decimal bytes (queued)\n")
                ReturnValue(1)
            }
            // Runtime integer → job queue (multi PrintNumber keeps order)
            net = CompileExprHDL(arg)
            IfCondition EqualTo(net, 0) ThenBlock: {
                ReturnValue(0)
            }
            NL_PrintItoAEnqueue(net)
            ReturnValue(1)
        }

        ReturnValue(1)
    }
}

// Append decimal representation of val (handles 0 and negative)
Function.CompileStmtHDL_PrintAppendDecimal {
    Input: val: Integer
    Body: {
        IfCondition EqualTo(val, 0) ThenBlock: {
            NL_PrintAppendByte(48)  // '0'
            ReturnValue(0)
        }
        IfCondition LessThan(val, 0) ThenBlock: {
            NL_PrintAppendByte(45)  // '-'
            val = Subtract(0, val)
        }
        // digits reversed then re-reverse via temp array
        tmp = Array.Create(24)
        n = val
        WhileLoop GreaterThan(n, 0) {
            digit = Subtract(n, Multiply(Divide(n, 10), 10))
            Array.Push(tmp, Add(48, digit))
            n = Divide(n, 10)
        }
        // reverse
        i = Array.Size(tmp)
        WhileLoop GreaterThan(i, 0) {
            i = Subtract(i, 1)
            NL_PrintAppendByte(Array.Get(tmp, i))
        }
    }
}

// =============================================================================
// BLOCK
// =============================================================================
Function.CompileStmtHDL_Block {
    Input: node: Address
    Output: Integer
    Body: {
        count = AST_GetChildCount(node)
        i = 0
        WhileLoop LessThan(i, count) {
            IfCondition EqualTo(NL.error, 1) ThenBlock: {
                ReturnValue(0)
            }
            child = AST_GetChild(node, i)
            // Skip nested decl noise
            ctype = AST_GetType(child)
            IfCondition EqualTo(ctype, AST.PARAMETER) ThenBlock: {
                i = Add(i, 1)
                ContinueLoop
            }
            IfCondition EqualTo(ctype, AST.OUTPUT_DECL) ThenBlock: {
                i = Add(i, 1)
                ContinueLoop
            }
            ok = CompileStmtHDL(child)
            IfCondition EqualTo(ok, 0) ThenBlock: {
                ReturnValue(0)
            }
            i = Add(i, 1)
        }
        ReturnValue(1)
    }
}

// =============================================================================
// INDEX ASSIGN  pool[i] = value  → seq write Mem[idx] <= rhs
// =============================================================================
Function.CompileStmtHDL_IndexAssign {
    Input: node: Address
    Output: Integer
    Body: {
        mod = NL_GetCurrentModule()
        IfCondition EqualTo(mod, 0) ThenBlock: {
            NL_Error("index assignment outside module", AST_GetLine(node))
            ReturnValue(0)
        }
        IfCondition LessThan(AST_GetChildCount(node), 2) ThenBlock: {
            NL_Error("index assignment missing parts", AST_GetLine(node))
            ReturnValue(0)
        }
        bname = AST_GetData1(node)
        idx = AST_GetChild(node, 0)
        value = AST_GetChild(node, 1)
        mem = NL_FindMemory(bname)
        IfCondition EqualTo(mem, 0) ThenBlock: {
            NL_Error("index assign base is not FixedPool array", AST_GetLine(node))
            ReturnValue(0)
        }
        depth = Dereference(Add(mem, 16))
        IfCondition LessEqual(depth, 1) ThenBlock: {
            NL_Error("index assign into scalar — use field = value", AST_GetLine(node))
            ReturnValue(0)
        }
        safe = NL_SafeIdent(bname)
        rhs = CompileExprHDL(value)
        IfCondition EqualTo(rhs, 0) ThenBlock: { ReturnValue(0) }

        // Build lhs: Mem[const] or Mem[net]
        lhs = 0
        IfCondition EqualTo(AST_GetType(idx), AST.NUMBER) ThenBlock: {
            ival = StringToNumber(AST_GetData1(idx))
            IfCondition Or(LessThan(ival, 0), GreaterEqual(ival, depth)) ThenBlock: {
                NL_Error("const index assign out of depth", AST_GetLine(node))
                ReturnValue(0)
            }
            lhs = StringConcat(safe, "[")
            lhs = StringConcat(lhs, NL_IntToString(ival))
            lhs = StringConcat(lhs, "]")
        } ElseBlock: {
            ine = CompileExprHDL(idx)
            IfCondition EqualTo(ine, 0) ThenBlock: { ReturnValue(0) }
            lhs = StringConcat(safe, "[")
            lhs = StringConcat(lhs, ine)
            lhs = StringConcat(lhs, "]")
        }

        // Const-index writes participate in straight-line shadow chain
        // (var-index still direct seq — same net string for different i would collide)
        IfCondition EqualTo(AST_GetType(idx), AST.NUMBER) ThenBlock: {
            IfCondition EqualTo(NL.foreach_mode, 0) ThenBlock: {
                out = NL_FreshWire()
                NL_AddAssign(mod, out, rhs, NLKind.ASSIGN_COMB, Dereference(Add(mem, 8)))
                NL_ChainShadowSet(lhs, out)
                PrintMessage("  chain-shadow ")
                PrintMessage(lhs)
                PrintMessage(" = ")
                PrintMessage(out)
                PrintMessage(" (array)\n")
                ReturnValue(1)
            }
        }

        NL_AddAssign(mod, lhs, rhs, NLKind.ASSIGN_SEQ, Dereference(Add(mem, 8)))
        PrintMessage("  assign ")
        PrintMessage(lhs)
        PrintMessage(" <= ")
        PrintMessage(rhs)
        PrintMessage(" (array/seq)\n")
        ReturnValue(1)
    }
}

// =============================================================================
// ASSIGNMENT  target = value
// target is string (dotted Pool.field lexed as one ident, or bare name)
// =============================================================================
Function.CompileStmtHDL_Assign {
    Input: node: Address
    Output: Integer
    Body: {
        mod = NL_GetCurrentModule()
        IfCondition EqualTo(mod, 0) ThenBlock: {
            NL_Error("assignment outside module", AST_GetLine(node))
            ReturnValue(0)
        }

        target = AST_GetData1(node)
        value = AST_GetChild(node, 0)
        IfCondition EqualTo(target, 0) ThenBlock: {
            NL_Error("assignment missing target", AST_GetLine(node))
            ReturnValue(0)
        }
        IfCondition EqualTo(value, 0) ThenBlock: {
            NL_Error("assignment missing value", AST_GetLine(node))
            ReturnValue(0)
        }

        rhs = CompileExprHDL(value)
        IfCondition EqualTo(rhs, 0) ThenBlock: {
            ReturnValue(0)
        }

        // Pool field → safe reg name; sequential write if in seq_mode or is pool
        lhs = target
        mem = NL_FindMemory(target)
        is_pool = 0
        IfCondition NotEqual(mem, 0) ThenBlock: {
            lhs = NL_SafeIdent(target)
            is_pool = 1
        } ElseBlock: {
            // also try if target already has dots replaced? keep as-is
            lhs = NL_SafeIdent(target)
        }

        kind = NLKind.ASSIGN_COMB
        IfCondition EqualTo(NL.seq_mode, 1) ThenBlock: {
            kind = NLKind.ASSIGN_SEQ
        }
        IfCondition EqualTo(is_pool, 1) ThenBlock: {
            // Pool storage is clocked state
            kind = NLKind.ASSIGN_SEQ
        }

        // ForEvery unroll: chain comb updates; commit to regs after loop
        IfCondition EqualTo(NL.foreach_mode, 1) ThenBlock: {
            IfCondition EqualTo(is_pool, 1) ThenBlock: {
                // Keep result on a fresh wire as latest shadow
                out = NL_FreshWire()
                NL_AddAssign(mod, out, rhs, NLKind.ASSIGN_COMB, 64)
                NL_ForeachShadowSet(lhs, out)
                PrintMessage("  foreach-shadow ")
                PrintMessage(lhs)
                PrintMessage(" = ")
                PrintMessage(out)
                PrintMessage("\n")
                ReturnValue(1)
            }
        }

        // Straight-line updates: shadow chain so x=f(x); x=g(x) accumulates
        // Applies to pool SEQ and comb locals (Function temps like PopCount8)
        use_chain = 0
        IfCondition EqualTo(is_pool, 1) ThenBlock: {
            IfCondition EqualTo(kind, NLKind.ASSIGN_SEQ) ThenBlock: {
                use_chain = 1
            }
        }
        IfCondition EqualTo(kind, NLKind.ASSIGN_COMB) ThenBlock: {
            IfCondition EqualTo(is_pool, 0) ThenBlock: {
                IfCondition NotEqual(StringCompare(lhs, "result"), 0) ThenBlock: {
                    use_chain = 1
                }
            }
        }
        IfCondition EqualTo(use_chain, 1) ThenBlock: {
            out = NL_FreshWire()
            NL_AddAssign(mod, out, rhs, NLKind.ASSIGN_COMB, 64)
            NL_ChainShadowSet(lhs, out)
            PrintMessage("  chain-shadow ")
            PrintMessage(lhs)
            PrintMessage(" = ")
            PrintMessage(out)
            PrintMessage("\n")
            ReturnValue(1)
        }

        NL_AddAssign(mod, lhs, rhs, kind, 64)
        PrintMessage("  assign ")
        PrintMessage(lhs)
        PrintMessage(" = ")
        PrintMessage(rhs)
        IfCondition EqualTo(kind, NLKind.ASSIGN_SEQ) ThenBlock: {
            PrintMessage(" (seq)\n")
        } ElseBlock: {
            PrintMessage(" (comb)\n")
        }
        ReturnValue(1)
    }
}

// =============================================================================
// RETURN  → assign result = expr  (combinational function output)
// =============================================================================
Function.CompileStmtHDL_Return {
    Input: node: Address
    Output: Integer
    Body: {
        mod = NL_GetCurrentModule()
        IfCondition EqualTo(mod, 0) ThenBlock: {
            NL_Error("return outside module", AST_GetLine(node))
            ReturnValue(0)
        }

        // ReturnValue(expr) → child[0] = expr
        IfCondition EqualTo(AST_GetChildCount(node), 0) ThenBlock: {
            ReturnValue(1)
        }
        value = AST_GetChild(node, 0)
        IfCondition EqualTo(value, 0) ThenBlock: {
            ReturnValue(1)
        }

        rhs = CompileExprHDL(value)
        IfCondition EqualTo(rhs, 0) ThenBlock: {
            ReturnValue(0)
        }

        NL_AddAssign(mod, "result", rhs, NLKind.ASSIGN_COMB, 64)
        PrintMessage("  return → result = ")
        PrintMessage(rhs)
        PrintMessage("\n")
        ReturnValue(1)
    }
}

// =============================================================================
// IF — structure first (HW will structure it anyway):
//   1) both arms target=const same → 2-entry LUT
//   2) both arms single assign same target, any expr → NL_Prim_Mux ($mux)
//   3) else sequential if markers (last resort)
// =============================================================================
Function.CompileStmtHDL_If {
    Input: node: Address
    Output: Integer
    Body: {
        mod = NL_GetCurrentModule()
        // children: [0]=cond, [1]=then, [2]=else?
        IfCondition LessThan(AST_GetChildCount(node), 2) ThenBlock: {
            NL_Error("If missing then branch", AST_GetLine(node))
            ReturnValue(0)
        }

        // Commit straight-line shadows before control
        NL_ChainShadowFlush(mod)

        cond = AST_GetChild(node, 0)
        thenb = AST_GetChild(node, 1)
        elseb = 0
        IfCondition GreaterThan(AST_GetChildCount(node), 2) ThenBlock: {
            elseb = AST_GetChild(node, 2)
        }

        // --- 1) Const table form ---
        IfCondition NotEqual(elseb, 0) ThenBlock: {
            ok_t = CompileStmtHDL_ExtractConstAssign(thenb)
            t_tgt = NL.last_net
            t_val = NL.extract_val
            ok_e = 0
            e_val = 0
            IfCondition EqualTo(ok_t, 1) ThenBlock: {
                ok_e = CompileStmtHDL_ExtractConstAssign(elseb)
                e_val = NL.extract_val
                e_tgt = NL.last_net
            }
            IfCondition EqualTo(ok_t, 1) ThenBlock: {
                IfCondition EqualTo(ok_e, 1) ThenBlock: {
                    IfCondition EqualTo(StringCompare(t_tgt, e_tgt), 0) ThenBlock: {
                        cnet = CompileExprHDL(cond)
                        IfCondition EqualTo(cnet, 0) ThenBlock: {
                            ReturnValue(0)
                        }
                        lut = NL_CreateLut(mod, StringConcat("if_", t_tgt), 1, 64)
                        // cond==0 → else, cond!=0 → then  (1-bit addr)
                        NL_LutSetEntry(lut, 0, e_val)
                        NL_LutSetEntry(lut, 1, t_val)
                        out = NL_LutBindAddr(lut, cnet)
                        tgt = t_tgt
                        kind = NLKind.ASSIGN_COMB
                        IfCondition EqualTo(NL.seq_mode, 1) ThenBlock: {
                            kind = NLKind.ASSIGN_SEQ
                        }
                        IfCondition NotEqual(NL_FindMemory(tgt), 0) ThenBlock: {
                            kind = NLKind.ASSIGN_SEQ
                            tgt = NL_SafeIdent(tgt)
                        } ElseBlock: {
                            tgt = NL_SafeIdent(tgt)
                        }
                        NL_AddAssign(mod, tgt, out, kind, 64)
                        PrintMessage("  if → 2-entry LUT → ")
                        PrintMessage(tgt)
                        PrintMessage("\n")
                        ReturnValue(1)
                    }
                }
            }
        }

        // --- 2) Structured mux: same target, any RHS expr (then/else) ---
        // Why: ambiguous free-form if in software; hardware wants a mux.
        // AILang keeps the If syntax ergonomic; we lower to gates.
        IfCondition NotEqual(elseb, 0) ThenBlock: {
            ok_t = CompileStmtHDL_ExtractSimpleAssign(thenb)
            t_tgt = NL.last_net
            t_rhs = NL.extract_rhs
            ok_e = 0
            e_rhs = 0
            e_tgt = 0
            IfCondition EqualTo(ok_t, 1) ThenBlock: {
                ok_e = CompileStmtHDL_ExtractSimpleAssign(elseb)
                e_rhs = NL.extract_rhs
                e_tgt = NL.last_net
            }
            IfCondition EqualTo(ok_t, 1) ThenBlock: {
                IfCondition EqualTo(ok_e, 1) ThenBlock: {
                    IfCondition EqualTo(StringCompare(t_tgt, e_tgt), 0) ThenBlock: {
                        cnet = CompileExprHDL(cond)
                        IfCondition EqualTo(cnet, 0) ThenBlock: {
                            ReturnValue(0)
                        }
                        out = NL_Prim_Mux(mod, cnet, t_rhs, e_rhs, 64)
                        IfCondition EqualTo(out, 0) ThenBlock: {
                            ReturnValue(0)
                        }
                        tgt = t_tgt
                        kind = NLKind.ASSIGN_COMB
                        IfCondition EqualTo(NL.seq_mode, 1) ThenBlock: {
                            kind = NLKind.ASSIGN_SEQ
                        }
                        IfCondition NotEqual(NL_FindMemory(tgt), 0) ThenBlock: {
                            kind = NLKind.ASSIGN_SEQ
                            tgt = NL_SafeIdent(tgt)
                        } ElseBlock: {
                            tgt = NL_SafeIdent(tgt)
                        }
                        NL_AddAssign(mod, tgt, out, kind, 64)
                        PrintMessage("  if → mux → ")
                        PrintMessage(tgt)
                        PrintMessage(" = ")
                        PrintMessage(cnet)
                        PrintMessage(" ? ")
                        PrintMessage(t_rhs)
                        PrintMessage(" : ")
                        PrintMessage(e_rhs)
                        PrintMessage("\n")
                        ReturnValue(1)
                    }
                }
            }
        }

        cnet = CompileExprHDL(cond)
        IfCondition EqualTo(cnet, 0) ThenBlock: {
            ReturnValue(0)
        }

        // --- 3) Sequential if markers (multi-stmt arms / different targets) ---
        // Shadow-chain within each arm, flush commits *inside* the arm markers
        // so a=f(a); a=g(a) accumulates under if (cond).
        NL_AddAssign(mod, "__if_begin", cnet, 2, 1)
        ok = CompileStmtHDL(thenb)
        IfCondition EqualTo(ok, 0) ThenBlock: {
            ReturnValue(0)
        }
        NL_ChainShadowFlush(mod)
        IfCondition NotEqual(elseb, 0) ThenBlock: {
            NL_AddAssign(mod, "__else", cnet, 3, 1)
            ok = CompileStmtHDL(elseb)
            IfCondition EqualTo(ok, 0) ThenBlock: {
                ReturnValue(0)
            }
            NL_ChainShadowFlush(mod)
        }
        NL_AddAssign(mod, "__if_end", cnet, 4, 1)
        PrintMessage("  if ")
        PrintMessage(cnet)
        PrintMessage(" (seq+arm-shadow)\n")
        ReturnValue(1)
    }
}

// =============================================================================
// ForEvery var in FixedPoolArray { body }
// Unroll depth times (cap 32). Loop var binds to pool[i] net each iteration.
// Collection must be identifier naming a FixedPool field with depth > 1.
// =============================================================================
Function.CompileStmtHDL_ForEvery {
    Input: node: Address
    Output: Integer
    Body: {
        mod = NL_GetCurrentModule()
        IfCondition EqualTo(mod, 0) ThenBlock: {
            NL_Error("ForEvery outside module", AST_GetLine(node))
            ReturnValue(0)
        }
        NL_ChainShadowFlush(mod)
        var_name = AST_GetData1(node)
        IfCondition LessThan(AST_GetChildCount(node), 2) ThenBlock: {
            NL_Error("ForEvery missing collection/body", AST_GetLine(node))
            ReturnValue(0)
        }
        coll = AST_GetChild(node, 0)
        body = AST_GetChild(node, 1)
        IfCondition EqualTo(var_name, 0) ThenBlock: {
            NL_Error("ForEvery missing variable name", AST_GetLine(node))
            ReturnValue(0)
        }
        IfCondition NotEqual(AST_GetType(coll), AST.IDENTIFIER) ThenBlock: {
            NL_Error("HDL ForEvery collection must be FixedPool array identifier", AST_GetLine(node))
            ReturnValue(0)
        }
        cname = AST_GetData1(coll)
        mem = NL_FindMemory(cname)
        IfCondition EqualTo(mem, 0) ThenBlock: {
            NL_Error("ForEvery collection is not a FixedPool field", AST_GetLine(node))
            ReturnValue(0)
        }
        depth = Dereference(Add(mem, 16))
        IfCondition LessEqual(depth, 1) ThenBlock: {
            NL_Error("ForEvery needs MaximumLength array (depth>1)", AST_GetLine(node))
            ReturnValue(0)
        }
        IfCondition GreaterThan(depth, 32) ThenBlock: {
            NL_Error("ForEvery unroll depth > 32 not accepted in HDL v1 (use index While)", AST_GetLine(node))
            ReturnValue(0)
        }

        safe = NL_SafeIdent(cname)
        prev_mode = NL.foreach_mode
        prev_shn = NL.foreach_sh_names
        prev_shv = NL.foreach_sh_nets
        NL.foreach_mode = 1
        // Nested ForEvery: each level has its own reduction shadow map
        NL.foreach_sh_names = Array.Create(8)
        NL.foreach_sh_nets = Array.Create(8)

        PrintMessage("  ForEvery ")
        PrintMessage(var_name)
        PrintMessage(" in ")
        PrintMessage(safe)
        PrintMessage(" depth=")
        PrintNumber(depth)
        PrintMessage(" (unroll+shadow)\n")

        i = 0
        WhileLoop LessThan(i, depth) {
            // bind var → safe[i] (push for nested lookup)
            net = StringConcat(safe, "[")
            net = StringConcat(net, NL_IntToString(i))
            net = StringConcat(net, "]")
            NL_ForeachBindPush(var_name, net)
            ok = CompileStmtHDL(body)
            NL_ForeachBindPop()
            IfCondition EqualTo(ok, 0) ThenBlock: {
                NL.foreach_mode = prev_mode
                NL.foreach_sh_names = prev_shn
                NL.foreach_sh_nets = prev_shv
                ReturnValue(0)
            }
            i = Add(i, 1)
        }

        // Commit shadows → seq regs (one write per lhs after full unroll)
        nsh = Array.Size(NL.foreach_sh_names)
        si = 0
        WhileLoop LessThan(si, nsh) {
            sl = Array.Get(NL.foreach_sh_names, si)
            sn = Array.Get(NL.foreach_sh_nets, si)
            NL_AddAssign(mod, sl, sn, NLKind.ASSIGN_SEQ, 64)
            PrintMessage("  foreach-commit ")
            PrintMessage(sl)
            PrintMessage(" <= ")
            PrintMessage(sn)
            PrintMessage("\n")
            si = Add(si, 1)
        }

        NL.foreach_mode = prev_mode
        NL.foreach_sh_names = prev_shn
        NL.foreach_sh_nets = prev_shv
        ReturnValue(1)
    }
}

// UntilCondition C { body } → while (!C) body  (1 iter/clock)
Function.CompileStmtHDL_Until {
    Input: node: Address
    Output: Integer
    Body: {
        mod = NL_GetCurrentModule()
        IfCondition EqualTo(mod, 0) ThenBlock: {
            NL_Error("Until outside module", AST_GetLine(node))
            ReturnValue(0)
        }
        IfCondition LessThan(AST_GetChildCount(node), 2) ThenBlock: {
            NL_Error("Until missing body", AST_GetLine(node))
            ReturnValue(0)
        }
        NL_ChainShadowFlush(mod)
        prev_seq = NL.seq_mode
        NL.seq_mode = 1
        cond = AST_GetChild(node, 0)
        body = AST_GetChild(node, 1)
        cnet = CompileExprHDL(cond)
        IfCondition EqualTo(cnet, 0) ThenBlock: {
            NL.seq_mode = prev_seq
            ReturnValue(0)
        }
        // invert: run body while NOT condition
        ncond = NL_Prim_LogicNot(mod, cnet, 1)
        NL_AddAssign(mod, "__while_begin", ncond, 2, 1)
        ok = CompileStmtHDL(body)
        IfCondition EqualTo(ok, 0) ThenBlock: {
            NL.seq_mode = prev_seq
            ReturnValue(0)
        }
        NL_AddAssign(mod, "__while_end", ncond, 4, 1)
        NL.seq_mode = prev_seq
        PrintMessage("  until !")
        PrintMessage(cnet)
        PrintMessage(" { … }  // 1 iter/clock\n")
        ReturnValue(1)
    }
}

// =============================================================================
// WHILE — multi-cycle: each posedge, if cond then body (one iteration)
// Not unrolled; not unbounded software spin. Chip advances once per clock.
// Prefer bounded conditions (LessThan(reg, K)) so it eventually idles.
// =============================================================================
Function.CompileStmtHDL_While {
    Input: node: Address
    Output: Integer
    Body: {
        mod = NL_GetCurrentModule()
        IfCondition EqualTo(mod, 0) ThenBlock: {
            NL_Error("While outside module", AST_GetLine(node))
            ReturnValue(0)
        }
        IfCondition LessThan(AST_GetChildCount(node), 2) ThenBlock: {
            NL_Error("While missing body", AST_GetLine(node))
            ReturnValue(0)
        }

        NL_ChainShadowFlush(mod)

        // Force sequential context — while is a clocked construct
        prev_seq = NL.seq_mode
        NL.seq_mode = 1

        cond = AST_GetChild(node, 0)
        body = AST_GetChild(node, 1)
        cnet = CompileExprHDL(cond)
        IfCondition EqualTo(cnet, 0) ThenBlock: {
            NL.seq_mode = prev_seq
            ReturnValue(0)
        }

        // Reuse if-begin / if-end markers (no else) → if (cond) begin body end
        NL_AddAssign(mod, "__while_begin", cnet, 2, 1)
        ok = CompileStmtHDL(body)
        IfCondition EqualTo(ok, 0) ThenBlock: {
            NL.seq_mode = prev_seq
            ReturnValue(0)
        }
        NL_AddAssign(mod, "__while_end", cnet, 4, 1)

        NL.seq_mode = prev_seq
        PrintMessage("  while ")
        PrintMessage(cnet)
        PrintMessage(" { … }  // 1 iter/clock\n")
        ReturnValue(1)
    }
}

// Branch multi-stmt / multi-target: cascade if (sel==K) begin body end
Function.CompileStmtHDL_BranchSeq {
    Input: node: Address
    Output: Integer
    Body: {
        mod = NL_GetCurrentModule()
        NL_ChainShadowFlush(mod)
        sel_node = AST_GetChild(node, 0)
        sel_net = CompileExprHDL(sel_node)
        IfCondition EqualTo(sel_net, 0) ThenBlock: {
            ReturnValue(0)
        }
        prev_seq = NL.seq_mode
        NL.seq_mode = 1

        def_body = 0
        cc = AST_GetChildCount(node)
        ci = 1
        first = 1
        WhileLoop LessThan(ci, cc) {
            ch = AST_GetChild(node, ci)
            ctype = AST_GetType(ch)
            IfCondition EqualTo(ctype, AST.CASE) ThenBlock: {
                IfCondition LessThan(AST_GetChildCount(ch), 2) ThenBlock: {
                    NL.seq_mode = prev_seq
                    NL_Error("Case missing body", AST_GetLine(ch))
                    ReturnValue(0)
                }
                kn = AST_GetChild(ch, 0)
                body = AST_GetChild(ch, 1)
                IfCondition NotEqual(AST_GetType(kn), AST.NUMBER) ThenBlock: {
                    NL.seq_mode = prev_seq
                    NL_Error("Branch seq needs constant Case keys", AST_GetLine(ch))
                    ReturnValue(0)
                }
                k = StringToNumber(AST_GetData1(kn))
                knet = NL_Prim_Const(mod, k, 64)
                eq = NL_Prim_Eq(mod, sel_net, knet, 64)
                // if (sel==k) begin body end  — independent cascade
                NL_AddAssign(mod, "__if_begin", eq, 2, 1)
                ok = CompileStmtHDL(body)
                IfCondition EqualTo(ok, 0) ThenBlock: {
                    NL.seq_mode = prev_seq
                    ReturnValue(0)
                }
                NL_ChainShadowFlush(mod)
                NL_AddAssign(mod, "__if_end", eq, 4, 1)
                first = 0
            }
            IfCondition EqualTo(ctype, AST.DEFAULT) ThenBlock: {
                def_body = AST_GetChild(ch, 0)
            }
            ci = Add(ci, 1)
        }
        // Default when no case key matched
        IfCondition NotEqual(def_body, 0) ThenBlock: {
            matched = NL_Prim_Const(mod, 0, 1)
            ci = 1
            WhileLoop LessThan(ci, cc) {
                ch = AST_GetChild(node, ci)
                IfCondition EqualTo(AST_GetType(ch), AST.CASE) ThenBlock: {
                    IfCondition GreaterThan(AST_GetChildCount(ch), 0) ThenBlock: {
                        kn = AST_GetChild(ch, 0)
                        IfCondition EqualTo(AST_GetType(kn), AST.NUMBER) ThenBlock: {
                            k = StringToNumber(AST_GetData1(kn))
                            knet = NL_Prim_Const(mod, k, 64)
                            eq = NL_Prim_Eq(mod, sel_net, knet, 64)
                            matched = NL_Prim_LogicOr(mod, matched, eq, 1)
                        }
                    }
                }
                ci = Add(ci, 1)
            }
            nmatch = NL_Prim_LogicNot(mod, matched, 1)
            NL_AddAssign(mod, "__if_begin", nmatch, 2, 1)
            ok = CompileStmtHDL(def_body)
            IfCondition EqualTo(ok, 0) ThenBlock: {
                NL.seq_mode = prev_seq
                ReturnValue(0)
            }
            NL_ChainShadowFlush(mod)
            NL_AddAssign(mod, "__if_end", nmatch, 4, 1)
        }

        NL.seq_mode = prev_seq
        PrintMessage("  Branch → seq if-cascade (multi-stmt cases)\n")
        ReturnValue(1)
    }
}

// =============================================================================
// BRANCH → LUT if pure const table; else sequential if-chain (multi-stmt cases)
// =============================================================================
Function.CompileStmtHDL_BranchLut {
    Input: node: Address
    Output: Integer
    Body: {
        mod = NL_GetCurrentModule()
        IfCondition EqualTo(mod, 0) ThenBlock: {
            NL_Error("Branch outside module", AST_GetLine(node))
            ReturnValue(0)
        }

        NL_ChainShadowFlush(mod)

        // children[0] = selector expr; rest = CASE / DEFAULT
        IfCondition LessThan(AST_GetChildCount(node), 2) ThenBlock: {
            NL_Error("Branch empty", AST_GetLine(node))
            ReturnValue(0)
        }

        // Probe: can all cases be const-table form?
        can_lut = 1
        probe_tgt = 0
        cc0 = AST_GetChildCount(node)
        ci0 = 1
        WhileLoop LessThan(ci0, cc0) {
            ch0 = AST_GetChild(node, ci0)
            ctype0 = AST_GetType(ch0)
            IfCondition EqualTo(ctype0, AST.CASE) ThenBlock: {
                IfCondition LessThan(AST_GetChildCount(ch0), 2) ThenBlock: {
                    can_lut = 0
                    ExitLoop
                }
                IfCondition NotEqual(AST_GetType(AST_GetChild(ch0, 0)), AST.NUMBER) ThenBlock: {
                    can_lut = 0
                    ExitLoop
                }
                okx0 = CompileStmtHDL_ExtractConstAssign(AST_GetChild(ch0, 1))
                IfCondition EqualTo(okx0, 0) ThenBlock: {
                    can_lut = 0
                    ExitLoop
                }
                IfCondition EqualTo(probe_tgt, 0) ThenBlock: {
                    probe_tgt = NL.last_net
                } ElseBlock: {
                    IfCondition NotEqual(StringCompare(probe_tgt, NL.last_net), 0) ThenBlock: {
                        can_lut = 0
                        ExitLoop
                    }
                }
            }
            IfCondition EqualTo(ctype0, AST.DEFAULT) ThenBlock: {
                okx0 = CompileStmtHDL_ExtractConstAssign(AST_GetChild(ch0, 0))
                IfCondition EqualTo(okx0, 0) ThenBlock: {
                    can_lut = 0
                    ExitLoop
                }
            }
            ci0 = Add(ci0, 1)
        }
        IfCondition EqualTo(can_lut, 0) ThenBlock: {
            ReturnValue(CompileStmtHDL_BranchSeq(node))
        }

        sel_node = AST_GetChild(node, 0)
        sel_net = CompileExprHDL(sel_node)
        IfCondition EqualTo(sel_net, 0) ThenBlock: {
            ReturnValue(0)
        }

        // Collect table rows: max_key, target name, default val, per-key values
        // Use sparse map: parallel arrays keys[] values[] + default
        keys = Array.Create(64)
        vals = Array.Create(64)
        target = 0
        def_val = 0
        has_def = 0
        max_key = 0

        cc = AST_GetChildCount(node)
        ci = 1
        WhileLoop LessThan(ci, cc) {
            ch = AST_GetChild(node, ci)
            ctype = AST_GetType(ch)

            IfCondition EqualTo(ctype, AST.CASE) ThenBlock: {
                // case children: [0]=value expr, [1]=body
                IfCondition LessThan(AST_GetChildCount(ch), 2) ThenBlock: {
                    NL_Error("Case missing body", AST_GetLine(ch))
                    ReturnValue(0)
                }
                kval_node = AST_GetChild(ch, 0)
                body = AST_GetChild(ch, 1)
                IfCondition NotEqual(AST_GetType(kval_node), AST.NUMBER) ThenBlock: {
                    NL_Error("Branch LUT needs constant Case keys (table form)", AST_GetLine(ch))
                    ReturnValue(0)
                }
                k = StringToNumber(AST_GetData1(kval_node))
                okx = CompileStmtHDL_ExtractConstAssign(body)
                IfCondition EqualTo(okx, 0) ThenBlock: {
                    NL_Error("Branch LUT needs Case body: single target = constant", AST_GetLine(ch))
                    ReturnValue(0)
                }
                tname = NL.last_net
                tval = NL.extract_val
                IfCondition EqualTo(target, 0) ThenBlock: {
                    target = tname
                } ElseBlock: {
                    IfCondition NotEqual(StringCompare(target, tname), 0) ThenBlock: {
                        NL_Error("Branch LUT: all cases must assign same target", AST_GetLine(ch))
                        ReturnValue(0)
                    }
                }
                Array.Push(keys, k)
                Array.Push(vals, tval)
                IfCondition GreaterThan(k, max_key) ThenBlock: {
                    max_key = k
                }
            }

            IfCondition EqualTo(ctype, AST.DEFAULT) ThenBlock: {
                body = AST_GetChild(ch, 0)
                okx = CompileStmtHDL_ExtractConstAssign(body)
                IfCondition EqualTo(okx, 0) ThenBlock: {
                    NL_Error("Branch LUT Default must be single target = constant", AST_GetLine(ch))
                    ReturnValue(0)
                }
                tname = NL.last_net
                IfCondition EqualTo(target, 0) ThenBlock: {
                    target = tname
                } ElseBlock: {
                    IfCondition NotEqual(StringCompare(target, tname), 0) ThenBlock: {
                        NL_Error("Branch LUT: Default target mismatch", AST_GetLine(ch))
                        ReturnValue(0)
                    }
                }
                def_val = NL.extract_val
                has_def = 1
            }

            ci = Add(ci, 1)
        }

        IfCondition EqualTo(target, 0) ThenBlock: {
            NL_Error("Branch LUT: no cases", AST_GetLine(node))
            ReturnValue(0)
        }

        // addr_bits from max_key
        abits = 1
        cap = 2
        WhileLoop LessEqual(cap, max_key) {
            abits = Add(abits, 1)
            cap = Multiply(cap, 2)
            IfCondition GreaterThan(abits, 8) ThenBlock: {
                ExitLoop
            }
        }
        // at least cover max_key
        IfCondition EqualTo(max_key, 0) ThenBlock: {
            abits = 1
        }

        lut = NL_CreateLut(mod, StringConcat("br_", target), abits, 64)
        IfCondition EqualTo(lut, 0) ThenBlock: {
            ReturnValue(0)
        }

        // Fill default across table
        depth = Dereference(Add(lut, 24))
        i = 0
        WhileLoop LessThan(i, depth) {
            fill = 0
            IfCondition EqualTo(has_def, 1) ThenBlock: {
                fill = def_val
            }
            NL_LutSetEntry(lut, i, fill)
            i = Add(i, 1)
        }
        // Overlay case keys
        n = Array.Size(keys)
        i = 0
        WhileLoop LessThan(i, n) {
            NL_LutSetEntry(lut, Array.Get(keys, i), Array.Get(vals, i))
            i = Add(i, 1)
        }

        out = NL_LutBindAddr(lut, sel_net)

        // Drive target from LUT out
        kind = NLKind.ASSIGN_COMB
        IfCondition EqualTo(NL.seq_mode, 1) ThenBlock: {
            kind = NLKind.ASSIGN_SEQ
        }
        // pool targets always seq
        IfCondition NotEqual(NL_FindMemory(target), 0) ThenBlock: {
            kind = NLKind.ASSIGN_SEQ
            target = NL_SafeIdent(target)
        } ElseBlock: {
            target = NL_SafeIdent(target)
        }
        NL_AddAssign(mod, target, out, kind, 64)

        PrintMessage("  Branch → LUT → ")
        PrintMessage(target)
        PrintMessage(" (table, not if-else)\n")
        ReturnValue(1)
    }
}

// If body is `{ name = NUMBER }` (or block containing one such assign):
//   success → return 1, NL.last_net=target, NL.extract_val=constant
//   fail    → return 0
// (Value may be 0, so success cannot be the value itself.)
Function.CompileStmtHDL_ExtractConstAssign {
    Input: body: Address
    Output: Integer
    Body: {
        NL.extract_val = 0
        IfCondition EqualTo(body, 0) ThenBlock: {
            ReturnValue(0)
        }
        node = body
        btype = AST_GetType(body)

        // Unwrap BLOCK / BODY — take first ASSIGNMENT child
        IfCondition EqualTo(btype, AST.BLOCK) ThenBlock: {
            bc = AST_GetChildCount(body)
            bi = 0
            node = 0
            WhileLoop LessThan(bi, bc) {
                ch = AST_GetChild(body, bi)
                IfCondition EqualTo(AST_GetType(ch), AST.ASSIGNMENT) ThenBlock: {
                    node = ch
                    ExitLoop
                }
                bi = Add(bi, 1)
            }
            IfCondition EqualTo(node, 0) ThenBlock: {
                ReturnValue(0)
            }
        }
        IfCondition EqualTo(btype, AST.BODY) ThenBlock: {
            bc = AST_GetChildCount(body)
            bi = 0
            node = 0
            WhileLoop LessThan(bi, bc) {
                ch = AST_GetChild(body, bi)
                IfCondition EqualTo(AST_GetType(ch), AST.ASSIGNMENT) ThenBlock: {
                    node = ch
                    ExitLoop
                }
                bi = Add(bi, 1)
            }
            IfCondition EqualTo(node, 0) ThenBlock: {
                ReturnValue(0)
            }
        }

        IfCondition NotEqual(AST_GetType(node), AST.ASSIGNMENT) ThenBlock: {
            ReturnValue(0)
        }
        tname = AST_GetData1(node)
        valn = AST_GetChild(node, 0)
        IfCondition EqualTo(valn, 0) ThenBlock: {
            ReturnValue(0)
        }
        vtype = AST_GetType(valn)
        IfCondition EqualTo(vtype, AST.NUMBER) ThenBlock: {
            NL.last_net = tname
            NL.extract_val = StringToNumber(AST_GetData1(valn))
            ReturnValue(1)
        }
        IfCondition EqualTo(vtype, AST.BOOLEAN) ThenBlock: {
            NL.last_net = tname
            bv = AST_GetData1(valn)
            IfCondition GreaterThan(bv, 1) ThenBlock: {
                NL.extract_val = StringToNumber(bv)
            } ElseBlock: {
                NL.extract_val = bv
            }
            ReturnValue(1)
        }
        ReturnValue(0)
    }
}

// Single assignment with any RHS: compile RHS net.
// success → 1, NL.last_net=target name, NL.extract_rhs=rhs net
// Reject multi-stmt / non-assign arms (those stay sequential if).
Function.CompileStmtHDL_ExtractSimpleAssign {
    Input: body: Address
    Output: Integer
    Body: {
        NL.extract_rhs = 0
        IfCondition EqualTo(body, 0) ThenBlock: {
            ReturnValue(0)
        }
        node = 0
        btype = AST_GetType(body)

        IfCondition EqualTo(btype, AST.ASSIGNMENT) ThenBlock: {
            node = body
        }
        IfCondition Or(EqualTo(btype, AST.BLOCK), EqualTo(btype, AST.BODY)) ThenBlock: {
            bc = AST_GetChildCount(body)
            bi = 0
            ac = 0
            WhileLoop LessThan(bi, bc) {
                ch = AST_GetChild(body, bi)
                ct = AST_GetType(ch)
                IfCondition EqualTo(ct, AST.ASSIGNMENT) ThenBlock: {
                    ac = Add(ac, 1)
                    node = ch
                } ElseBlock: {
                    // any other statement → not a simple one-assign arm
                    ReturnValue(0)
                }
                bi = Add(bi, 1)
            }
            IfCondition NotEqual(ac, 1) ThenBlock: {
                ReturnValue(0)
            }
        }

        IfCondition EqualTo(node, 0) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition NotEqual(AST_GetType(node), AST.ASSIGNMENT) ThenBlock: {
            ReturnValue(0)
        }

        tname = AST_GetData1(node)
        valn = AST_GetChild(node, 0)
        IfCondition Or(EqualTo(tname, 0), EqualTo(valn, 0)) ThenBlock: {
            ReturnValue(0)
        }
        rhs = CompileExprHDL(valn)
        IfCondition EqualTo(rhs, 0) ThenBlock: {
            ReturnValue(0)
        }
        NL.last_net = tname
        NL.extract_rhs = rhs
        ReturnValue(1)
    }
}

// =============================================================================
// Lower all body-like children of a Function/SubRoutine node
// =============================================================================
Function.CompileStmtHDL_FunctionBody {
    Input: func_node: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(func_node, 0) ThenBlock: {
            ReturnValue(1)
        }
        count = AST_GetChildCount(func_node)
        i = 0
        WhileLoop LessThan(i, count) {
            child = AST_GetChild(func_node, i)
            ctype = AST_GetType(child)

            IfCondition EqualTo(ctype, AST.PARAMETER) ThenBlock: {
                i = Add(i, 1)
                ContinueLoop
            }
            IfCondition EqualTo(ctype, AST.OUTPUT_DECL) ThenBlock: {
                i = Add(i, 1)
                ContinueLoop
            }
            IfCondition EqualTo(ctype, AST.BLOCK) ThenBlock: {
                ok = CompileStmtHDL_Block(child)
                IfCondition EqualTo(ok, 0) ThenBlock: { ReturnValue(0) }
                i = Add(i, 1)
                ContinueLoop
            }
            IfCondition EqualTo(ctype, AST.BODY) ThenBlock: {
                ok = CompileStmtHDL_Block(child)
                IfCondition EqualTo(ok, 0) ThenBlock: { ReturnValue(0) }
                i = Add(i, 1)
                ContinueLoop
            }

            // Direct statements (SubRoutine style)
            ok = CompileStmtHDL(child)
            IfCondition EqualTo(ok, 0) ThenBlock: { ReturnValue(0) }
            i = Add(i, 1)
        }
        // End of body: commit straight-line chain shadows
        mod = NL_GetCurrentModule()
        IfCondition NotEqual(mod, 0) ThenBlock: {
            NL_ChainShadowFlush(mod)
        }
        ReturnValue(1)
    }
}
