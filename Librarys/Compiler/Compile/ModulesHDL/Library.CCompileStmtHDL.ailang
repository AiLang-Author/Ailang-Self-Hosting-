// Library.CCompileStmtHDL.ailang
// Statement lowering → assigns (mirrors CCompileStmt).
// Location: Librarys/Compiler/Compile/ModulesHDL/Library.CCompileStmtHDL.ailang
//
// Supported: BLOCK, ASSIGNMENT, RETURN, IF (simple then/else → mux or seq),
//            expression statements (calls with side-effect ignore).

LibraryImport.Arrays
LibraryImport.Compiler.Frontend.AST.CASTTypes
LibraryImport.Compiler.Frontend.AST.CASTCore
LibraryImport.Compiler.Compile.ModulesHDL.NetlistIRHDL
LibraryImport.Compiler.Compile.ModulesHDL.CCompileExprHDL

// =============================================================================
// DISPATCH
// =============================================================================
Function.CompileStmtHDL {
    Input: node: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: {
            ReturnValue(1)
        }
        IfCondition EqualTo(NL.error, 1) ThenBlock: {
            ReturnValue(0)
        }

        ntype = AST_GetType(node)

        IfCondition EqualTo(ntype, AST.BLOCK) ThenBlock: {
            ReturnValue(CompileStmtHDL_Block(node))
        }
        IfCondition EqualTo(ntype, AST.BODY) ThenBlock: {
            ReturnValue(CompileStmtHDL_Block(node))
        }
        IfCondition EqualTo(ntype, AST.ASSIGNMENT) ThenBlock: {
            ReturnValue(CompileStmtHDL_Assign(node))
        }
        IfCondition EqualTo(ntype, AST.RETURN) ThenBlock: {
            ReturnValue(CompileStmtHDL_Return(node))
        }
        IfCondition EqualTo(ntype, AST.IF) ThenBlock: {
            ReturnValue(CompileStmtHDL_If(node))
        }
        IfCondition EqualTo(ntype, AST.CALL) ThenBlock: {
            // expression statement
            r = CompileExprHDL(node)
            IfCondition EqualTo(r, 0) ThenBlock: {
                IfCondition EqualTo(NL.error, 1) ThenBlock: {
                    ReturnValue(0)
                }
            }
            ReturnValue(1)
        }

        // Skip empty / unsupported quietly in non-strict path — MainHDL sets strict
        PrintMessage("[HDL] stmt skip type=")
        PrintNumber(ntype)
        PrintMessage("\n")
        ReturnValue(1)
    }
}

// =============================================================================
// BLOCK
// =============================================================================
Function.CompileStmtHDL_Block {
    Input: node: Address
    Output: Integer
    Body: {
        count = AST_GetChildCount(node)
        i = 0
        WhileLoop LessThan(i, count) {
            IfCondition EqualTo(NL.error, 1) ThenBlock: {
                ReturnValue(0)
            }
            child = AST_GetChild(node, i)
            // Skip nested decl noise
            ctype = AST_GetType(child)
            IfCondition EqualTo(ctype, AST.PARAMETER) ThenBlock: {
                i = Add(i, 1)
                ContinueLoop
            }
            IfCondition EqualTo(ctype, AST.OUTPUT_DECL) ThenBlock: {
                i = Add(i, 1)
                ContinueLoop
            }
            ok = CompileStmtHDL(child)
            IfCondition EqualTo(ok, 0) ThenBlock: {
                ReturnValue(0)
            }
            i = Add(i, 1)
        }
        ReturnValue(1)
    }
}

// =============================================================================
// ASSIGNMENT  target = value
// target is string (dotted Pool.field lexed as one ident, or bare name)
// =============================================================================
Function.CompileStmtHDL_Assign {
    Input: node: Address
    Output: Integer
    Body: {
        mod = NL_GetCurrentModule()
        IfCondition EqualTo(mod, 0) ThenBlock: {
            NL_Error("assignment outside module", AST_GetLine(node))
            ReturnValue(0)
        }

        target = AST_GetData1(node)
        value = AST_GetChild(node, 0)
        IfCondition EqualTo(target, 0) ThenBlock: {
            NL_Error("assignment missing target", AST_GetLine(node))
            ReturnValue(0)
        }
        IfCondition EqualTo(value, 0) ThenBlock: {
            NL_Error("assignment missing value", AST_GetLine(node))
            ReturnValue(0)
        }

        rhs = CompileExprHDL(value)
        IfCondition EqualTo(rhs, 0) ThenBlock: {
            ReturnValue(0)
        }

        // Pool field → safe reg name; sequential write if in seq_mode or is pool
        lhs = target
        mem = NL_FindMemory(target)
        is_pool = 0
        IfCondition NotEqual(mem, 0) ThenBlock: {
            lhs = NL_SafeIdent(target)
            is_pool = 1
        } ElseBlock: {
            // also try if target already has dots replaced? keep as-is
            lhs = NL_SafeIdent(target)
        }

        kind = NLKind.ASSIGN_COMB
        IfCondition EqualTo(NL.seq_mode, 1) ThenBlock: {
            kind = NLKind.ASSIGN_SEQ
        }
        IfCondition EqualTo(is_pool, 1) ThenBlock: {
            // Pool storage is clocked state
            kind = NLKind.ASSIGN_SEQ
        }

        NL_AddAssign(mod, lhs, rhs, kind, 64)
        PrintMessage("  assign ")
        PrintMessage(lhs)
        PrintMessage(" = ")
        PrintMessage(rhs)
        IfCondition EqualTo(kind, NLKind.ASSIGN_SEQ) ThenBlock: {
            PrintMessage(" (seq)\n")
        } ElseBlock: {
            PrintMessage(" (comb)\n")
        }
        ReturnValue(1)
    }
}

// =============================================================================
// RETURN  → assign result = expr  (combinational function output)
// =============================================================================
Function.CompileStmtHDL_Return {
    Input: node: Address
    Output: Integer
    Body: {
        mod = NL_GetCurrentModule()
        IfCondition EqualTo(mod, 0) ThenBlock: {
            NL_Error("return outside module", AST_GetLine(node))
            ReturnValue(0)
        }

        // ReturnValue(expr) → child[0] = expr
        IfCondition EqualTo(AST_GetChildCount(node), 0) ThenBlock: {
            ReturnValue(1)
        }
        value = AST_GetChild(node, 0)
        IfCondition EqualTo(value, 0) ThenBlock: {
            ReturnValue(1)
        }

        rhs = CompileExprHDL(value)
        IfCondition EqualTo(rhs, 0) ThenBlock: {
            ReturnValue(0)
        }

        NL_AddAssign(mod, "result", rhs, NLKind.ASSIGN_COMB, 64)
        PrintMessage("  return → result = ")
        PrintMessage(rhs)
        PrintMessage("\n")
        ReturnValue(1)
    }
}

// =============================================================================
// IF — simple: compile cond; if combo, use mux for assign targets is hard.
// v1: only support If with sequential bodies (both branches as stmt lists)
// without phi/mux merging — emit both under comments is wrong.
//
// Practical v1: require seq_mode; lower as:
//   // if cond — emit cond wire, then ONLY then-branch for now if we can't mux
// Better: for each assignment in then/else, would need SSA.
//
// Stick to plan: lower If as combinational select only when both branches
// are single returns, else sequential enable is TODO.
// For now: compile condition (for side effects), then then-block only,
// with a warning if else exists — NO that's wrong.
//
// Correct simple approach for hardware:
//   cond_net = expr
//   walk then and else not supported for arbitrary stmts yet
//   → error asking to use simpler structure OR
//   → emit if(cond) begin ... end in verilog as raw seq block
//
// Store IF as a special assign kind later. For this milestone:
// Emit sequential if-wrapper by recording a CELL_BUF marker and lowering
// then-block only when no else; with else, error.
// =============================================================================
Function.CompileStmtHDL_If {
    Input: node: Address
    Output: Integer
    Body: {
        mod = NL_GetCurrentModule()
        // children: [0]=cond, [1]=then, [2]=else?
        IfCondition LessThan(AST_GetChildCount(node), 2) ThenBlock: {
            NL_Error("If missing then branch", AST_GetLine(node))
            ReturnValue(0)
        }

        cond = AST_GetChild(node, 0)
        thenb = AST_GetChild(node, 1)
        elseb = 0
        IfCondition GreaterThan(AST_GetChildCount(node), 2) ThenBlock: {
            elseb = AST_GetChild(node, 2)
        }

        cnet = CompileExprHDL(cond)
        IfCondition EqualTo(cnet, 0) ThenBlock: {
            ReturnValue(0)
        }

        // Record if-condition wire for emit (seq if-begin uses it)
        // Store as assign meta: special lhs "__if_cond" push then-block
        // Simpler approach: force seq_mode and emit NL_AddAssign of a
        // sentinel that EmitVerilog expands — too messy.
        //
        // v1: lower then branch always; if else present, lower else too
        // under the assumption of sequential process and use Verilog if.
        // We'll add IF region to assigns list as kind 2/3 markers.

        // Marker start
        NL_AddAssign(mod, "__if_begin", cnet, 2, 1)
        ok = CompileStmtHDL(thenb)
        IfCondition EqualTo(ok, 0) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition NotEqual(elseb, 0) ThenBlock: {
            NL_AddAssign(mod, "__else", cnet, 3, 1)
            ok = CompileStmtHDL(elseb)
            IfCondition EqualTo(ok, 0) ThenBlock: {
                ReturnValue(0)
            }
        }
        NL_AddAssign(mod, "__if_end", cnet, 4, 1)
        PrintMessage("  if ")
        PrintMessage(cnet)
        PrintMessage(" ...\n")
        ReturnValue(1)
    }
}

// =============================================================================
// Lower all body-like children of a Function/SubRoutine node
// =============================================================================
Function.CompileStmtHDL_FunctionBody {
    Input: func_node: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(func_node, 0) ThenBlock: {
            ReturnValue(1)
        }
        count = AST_GetChildCount(func_node)
        i = 0
        WhileLoop LessThan(i, count) {
            child = AST_GetChild(func_node, i)
            ctype = AST_GetType(child)

            IfCondition EqualTo(ctype, AST.PARAMETER) ThenBlock: {
                i = Add(i, 1)
                ContinueLoop
            }
            IfCondition EqualTo(ctype, AST.OUTPUT_DECL) ThenBlock: {
                i = Add(i, 1)
                ContinueLoop
            }
            IfCondition EqualTo(ctype, AST.BLOCK) ThenBlock: {
                ok = CompileStmtHDL_Block(child)
                IfCondition EqualTo(ok, 0) ThenBlock: { ReturnValue(0) }
                i = Add(i, 1)
                ContinueLoop
            }
            IfCondition EqualTo(ctype, AST.BODY) ThenBlock: {
                ok = CompileStmtHDL_Block(child)
                IfCondition EqualTo(ok, 0) ThenBlock: { ReturnValue(0) }
                i = Add(i, 1)
                ContinueLoop
            }

            // Direct statements (SubRoutine style)
            ok = CompileStmtHDL(child)
            IfCondition EqualTo(ok, 0) ThenBlock: { ReturnValue(0) }
            i = Add(i, 1)
        }
        ReturnValue(1)
    }
}
