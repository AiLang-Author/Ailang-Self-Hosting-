// Library.EmitJsonHDL.ailang
// JSON netlist serializer — tool-friendly dump of the circuit graph.
// Location: Librarys/Compiler/Compile/ModulesHDL/Library.EmitJsonHDL.ailang
//
// Uses Library.JSON for object/array build + Serialize.
// Pure data emit; no machine-code path.

LibraryImport.Arrays
LibraryImport.JSON
LibraryImport.Compiler.Compile.ModulesHDL.NetlistIRHDL
LibraryImport.Compiler.Compile.ModulesHDL.NetlistPrimsHDL
LibraryImport.Compiler.Compile.ModulesHDL.EmitVerilogHDL

// =============================================================================
// PUBLIC API
// =============================================================================
Function.EmitJsonHDL_Build {
    Output: Address
    Body: {
        root = JSON.NewObject()
        JSON.SetString(root, "generator", "AILang-HDL")
        JSON.SetString(root, "format", "ailang-netlist-v1")
        JSON.SetString(root, "top", NL.top_name)
        JSON.SetNumber(root, "pool_count", NL.pool_count)
        JSON.SetNumber(root, "func_count", NL.func_count)
        JSON.SetNumber(root, "sub_count", NL.sub_count)
        JSON.SetNumber(root, "task_count", NL.task_count)

        mods = JSON.NewArray()
        IfCondition NotEqual(NL.modules, 0) ThenBlock: {
            count = Array.Size(NL.modules)
            i = 0
            WhileLoop LessThan(i, count) {
                mod = Array.Get(NL.modules, i)
                mobj = EmitJsonHDL_Module(mod)
                JSON.PushObject(mods, mobj)
                i = Add(i, 1)
            }
        }
        JSON.SetArray(root, "modules", mods)
        ReturnValue(root)
    }
}

Function.EmitJsonHDL_Serialize {
    Output: Address
    Body: {
        root = EmitJsonHDL_Build()
        // JSON.Serialize expects a tagged value, not a raw object handle
        tagged = JSON.Tag(JType.OBJECT, root)
        text = JSON.Serialize(tagged)
        ReturnValue(text)
    }
}

Function.EmitJsonHDL_WriteFile {
    Input: path: Address
    Output: Integer
    Body: {
        text = EmitJsonHDL_Serialize()
        IfCondition EqualTo(text, 0) ThenBlock: {
            PrintMessage("[HDL] ERROR: JSON serialize failed\n")
            ReturnValue(0)
        }

        fd = FileOpen(path, 577, 420)
        IfCondition LessThan(fd, 0) ThenBlock: {
            PrintMessage("[HDL] ERROR: cannot write ")
            PrintMessage(path)
            PrintMessage("\n")
            ReturnValue(0)
        }

        len = EmitVerilogHDL_StrLen(text)
        written = FileWrite(fd, text, len)
        FileClose(fd)

        PrintMessage("[HDL] wrote netlist JSON: ")
        PrintMessage(path)
        PrintMessage(" (")
        PrintNumber(written)
        PrintMessage(" bytes)\n")

        IfCondition LessThan(written, 1) ThenBlock: {
            ReturnValue(0)
        }
        ReturnValue(1)
    }
}

// =============================================================================
// MODULE → JSON OBJECT
// =============================================================================
Function.EmitJsonHDL_Module {
    Input: mod: Address
    Output: Address
    Body: {
        obj = JSON.NewObject()
        name = NL_ModuleName(mod)
        IfCondition EqualTo(name, 0) ThenBlock: {
            name = "unnamed"
        }
        JSON.SetString(obj, "name", name)
        JSON.SetNumber(obj, "kind", NL_ModuleKind(mod))

        // Ports
        parr = JSON.NewArray()
        ports = NL_ModulePorts(mod)
        IfCondition NotEqual(ports, 0) ThenBlock: {
            pc = Array.Size(ports)
            pi = 0
            WhileLoop LessThan(pi, pc) {
                port = Array.Get(ports, pi)
                po = JSON.NewObject()
                JSON.SetString(po, "name", Dereference(port))
                JSON.SetNumber(po, "dir", Dereference(Add(port, 8)))
                JSON.SetNumber(po, "width", Dereference(Add(port, 16)))
                JSON.SetNumber(po, "net_id", Dereference(Add(port, 24)))
                JSON.PushObject(parr, po)
                pi = Add(pi, 1)
            }
        }
        JSON.SetArray(obj, "ports", parr)

        // Memories
        marr = JSON.NewArray()
        memories = NL_ModuleMemories(mod)
        IfCondition NotEqual(memories, 0) ThenBlock: {
            mc = Array.Size(memories)
            mi = 0
            WhileLoop LessThan(mi, mc) {
                mem = Array.Get(memories, mi)
                mo = JSON.NewObject()
                JSON.SetString(mo, "name", Dereference(mem))
                JSON.SetNumber(mo, "width", Dereference(Add(mem, 8)))
                JSON.SetNumber(mo, "depth", Dereference(Add(mem, 16)))
                JSON.SetNumber(mo, "init", Dereference(Add(mem, 24)))
                JSON.SetString(mo, "pool", Dereference(Add(mem, 32)))
                JSON.SetString(mo, "field", Dereference(Add(mem, 40)))
                JSON.PushObject(marr, mo)
                mi = Add(mi, 1)
            }
        }
        JSON.SetArray(obj, "memories", marr)

        // Cells
        carr = JSON.NewArray()
        cells = NL_ModuleCells(mod)
        IfCondition NotEqual(cells, 0) ThenBlock: {
            cc = Array.Size(cells)
            ci = 0
            WhileLoop LessThan(ci, cc) {
                cell = Array.Get(cells, ci)
                co = JSON.NewObject()
                JSON.SetNumber(co, "id", Dereference(cell))
                ckind = Dereference(Add(cell, 8))
                JSON.SetNumber(co, "kind", ckind)
                JSON.SetString(co, "prim", NL_Prim_ShortName(ckind))
                ys = NL_Prim_YosysName(ckind)
                IfCondition EqualTo(ys, 0) ThenBlock: { ys = "" }
                JSON.SetString(co, "yosys", ys)
                cname = Dereference(Add(cell, 16))
                IfCondition EqualTo(cname, 0) ThenBlock: {
                    cname = ""
                }
                JSON.SetString(co, "name", cname)
                JSON.SetNumber(co, "param0", Dereference(Add(cell, 24)))
                JSON.SetNumber(co, "param1", Dereference(Add(cell, 32)))
                JSON.SetNumber(co, "width", Dereference(Add(cell, 40)))
                JSON.PushObject(carr, co)
                ci = Add(ci, 1)
            }
        }
        JSON.SetArray(obj, "cells", carr)

        // Nets
        narr = JSON.NewArray()
        nets = NL_ModuleNets(mod)
        IfCondition NotEqual(nets, 0) ThenBlock: {
            nc = Array.Size(nets)
            ni = 0
            WhileLoop LessThan(ni, nc) {
                net = Array.Get(nets, ni)
                no = JSON.NewObject()
                JSON.SetNumber(no, "id", Dereference(net))
                nname = Dereference(Add(net, 8))
                IfCondition EqualTo(nname, 0) ThenBlock: {
                    nname = ""
                }
                JSON.SetString(no, "name", nname)
                JSON.SetNumber(no, "width", Dereference(Add(net, 16)))
                JSON.PushObject(narr, no)
                ni = Add(ni, 1)
            }
        }
        JSON.SetArray(obj, "nets", narr)

        ReturnValue(obj)
    }
}
