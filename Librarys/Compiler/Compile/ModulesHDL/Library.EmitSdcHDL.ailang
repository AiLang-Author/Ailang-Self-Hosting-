// Library.EmitSdcHDL.ailang
// Minimal SDC + Yosys script sidecars for the HDL backend.
// Location: Librarys/Compiler/Compile/ModulesHDL/Library.EmitSdcHDL.ailang

LibraryImport.Compiler.Compile.ModulesHDL.NetlistIRHDL
LibraryImport.Compiler.Compile.ModulesHDL.EmitVerilogHDL

// Default 100 MHz (period 10 ns). CLI: -period N  or  --period-ns N
FixedPool.SdcHDL {
    "period_ns": Initialize=10, CanChange=True
    "text": Initialize=0, CanChange=True
}

Function.EmitSdcHDL_SetPeriodNs {
    Input: ns: Integer
    Body: {
        IfCondition LessEqual(ns, 0) ThenBlock: {
            ns = 10
        }
        SdcHDL.period_ns = ns
        PrintMessage("[HDL] clock period_ns=")
        PrintNumber(ns)
        PrintMessage("\n")
    }
}

// =============================================================================
// SDC — clock + I/O delay (25% of period)
// =============================================================================
Function.EmitSdcHDL_Serialize {
    Output: Address
    Body: {
        per = SdcHDL.period_ns
        IfCondition LessEqual(per, 0) ThenBlock: { per = 10 }
        // integer 25% of period (ns); min 1
        iod = Divide(per, 4)
        IfCondition LessThan(iod, 1) ThenBlock: { iod = 1 }

        t = ""
        t = NL_TextAppend(t, "# Generated by AILang HDL backend\n")
        t = NL_TextAppend(t, "# SDC for ailang_top — period from -period / --period-ns\n")
        t = NL_TextAppend(t, "#\n")
        t = NL_TextAppend(t, "create_clock -name clk -period ")
        t = NL_TextAppend(t, NL_IntToString(per))
        t = NL_TextAppend(t, " [get_ports clk]\n")
        t = NL_TextAppend(t, "set_clock_uncertainty 0.1 [get_clocks clk]\n")
        t = NL_TextAppend(t, "# Async reset — do not time through rst by default\n")
        t = NL_TextAppend(t, "set_false_path -from [get_ports rst]\n")
        t = NL_TextAppend(t, "# Placeholder I/O delays (~25% of period = ")
        t = NL_TextAppend(t, NL_IntToString(iod))
        t = NL_TextAppend(t, " ns)\n")
        t = NL_TextAppend(t, "set_input_delay  -clock clk ")
        t = NL_TextAppend(t, NL_IntToString(iod))
        t = NL_TextAppend(t, " [all_inputs]\n")
        t = NL_TextAppend(t, "set_output_delay -clock clk ")
        t = NL_TextAppend(t, NL_IntToString(iod))
        t = NL_TextAppend(t, " [all_outputs]\n")
        SdcHDL.text = t
        ReturnValue(t)
    }
}

Function.EmitSdcHDL_WriteFile {
    Input: path: Address
    Output: Integer
    Body: {
        text = EmitSdcHDL_Serialize()
        IfCondition EqualTo(text, 0) ThenBlock: { ReturnValue(0) }
        fd = FileOpen(path, 577, 420)
        IfCondition LessThan(fd, 0) ThenBlock: {
            PrintMessage("[HDL] ERROR: cannot write ")
            PrintMessage(path)
            PrintMessage("\n")
            ReturnValue(0)
        }
        len = EmitVerilogHDL_StrLen(text)
        written = FileWrite(fd, text, len)
        FileClose(fd)
        PrintMessage("[HDL] wrote SDC: ")
        PrintMessage(path)
        PrintMessage(" (")
        PrintNumber(written)
        PrintMessage(" bytes)\n")
        IfCondition LessThan(written, 1) ThenBlock: { ReturnValue(0) }
        ReturnValue(1)
    }
}

// =============================================================================
// Yosys script — check + BLIF export
// =============================================================================
Function.EmitYosysTcl_Serialize {
    Input: vpath: Address
    Input: blifpath: Address
    Output: Address
    Body: {
        t = ""
        t = NL_TextAppend(t, "# Generated by AILang HDL backend\n")
        t = NL_TextAppend(t, "# Usage: yosys -s <thisfile.ys>\n")
        t = NL_TextAppend(t, "read_verilog ")
        IfCondition NotEqual(vpath, 0) ThenBlock: {
            t = NL_TextAppend(t, vpath)
        } ElseBlock: {
            t = NL_TextAppend(t, "design.v")
        }
        t = NL_TextAppend(t, "\n")
        t = NL_TextAppend(t, "hierarchy -check -top ailang_top\n")
        t = NL_TextAppend(t, "proc; opt\n")
        t = NL_TextAppend(t, "# memory: keep arrays; ram_style attrs guide vendor synth scripts\n")
        t = NL_TextAppend(t, "memory; opt\n")
        t = NL_TextAppend(t, "stat\n")
        t = NL_TextAppend(t, "check\n")
        IfCondition NotEqual(blifpath, 0) ThenBlock: {
            t = NL_TextAppend(t, "write_blif ")
            t = NL_TextAppend(t, blifpath)
            t = NL_TextAppend(t, "\n")
        }
        // Companion synth scripts written next to .ys by EmitYosysSynth_* helpers
        t = NL_TextAppend(t, "# Optional vendor synth (also see <base>.synth_ice40.ys):\n")
        t = NL_TextAppend(t, "#   yosys -s <base>.synth_ice40.ys\n")
        t = NL_TextAppend(t, "#   yosys -s <base>.synth_ecp5.ys\n")
        t = NL_TextAppend(t, "#   yosys -s <base>.synth_xilinx.ys\n")
        ReturnValue(t)
    }
}

// Vendor synth one-liners — call after WriteYosys with base path
Function.EmitYosysSynth_WriteAll {
    Input: base: Address
    Input: vpath: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(base, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(vpath, 0) ThenBlock: { vpath = StringConcat(base, ".v") }

        // ice40
        t = ""
        t = NL_TextAppend(t, "# AILang → Yosys ice40 synth\n")
        t = NL_TextAppend(t, "read_verilog ")
        t = NL_TextAppend(t, vpath)
        t = NL_TextAppend(t, "\n")
        t = NL_TextAppend(t, "synth_ice40 -top ailang_top -json ")
        t = NL_TextAppend(t, base)
        t = NL_TextAppend(t, ".ice40.json\n")
        EmitPinsHDL_WriteText(StringConcat(base, ".synth_ice40.ys"), t)

        // ecp5
        t = ""
        t = NL_TextAppend(t, "# AILang → Yosys ecp5 synth\n")
        t = NL_TextAppend(t, "read_verilog ")
        t = NL_TextAppend(t, vpath)
        t = NL_TextAppend(t, "\n")
        t = NL_TextAppend(t, "synth_ecp5 -top ailang_top -json ")
        t = NL_TextAppend(t, base)
        t = NL_TextAppend(t, ".ecp5.json\n")
        EmitPinsHDL_WriteText(StringConcat(base, ".synth_ecp5.ys"), t)

        // xilinx 7-series style
        t = ""
        t = NL_TextAppend(t, "# AILang → Yosys xilinx synth (generic 7-series flow)\n")
        t = NL_TextAppend(t, "read_verilog ")
        t = NL_TextAppend(t, vpath)
        t = NL_TextAppend(t, "\n")
        t = NL_TextAppend(t, "synth_xilinx -top ailang_top -family xc7\n")
        t = NL_TextAppend(t, "write_edif ")
        t = NL_TextAppend(t, base)
        t = NL_TextAppend(t, ".edif\n")
        EmitPinsHDL_WriteText(StringConcat(base, ".synth_xilinx.ys"), t)

        ReturnValue(1)
    }
}

Function.EmitYosysTcl_WriteFile {
    Input: path: Address
    Input: vpath: Address
    Input: blifpath: Address
    Output: Integer
    Body: {
        text = EmitYosysTcl_Serialize(vpath, blifpath)
        IfCondition EqualTo(text, 0) ThenBlock: { ReturnValue(0) }
        fd = FileOpen(path, 577, 420)
        IfCondition LessThan(fd, 0) ThenBlock: {
            PrintMessage("[HDL] ERROR: cannot write ")
            PrintMessage(path)
            PrintMessage("\n")
            ReturnValue(0)
        }
        len = EmitVerilogHDL_StrLen(text)
        written = FileWrite(fd, text, len)
        FileClose(fd)
        PrintMessage("[HDL] wrote Yosys script: ")
        PrintMessage(path)
        PrintMessage(" (")
        PrintNumber(written)
        PrintMessage(" bytes)\n")
        IfCondition LessThan(written, 1) ThenBlock: { ReturnValue(0) }
        ReturnValue(1)
    }
}

// =============================================================================
// Pin maps — generic .pins + ice40 .pcf + Xilinx .xdc placeholders
// =============================================================================
Function.EmitPinsHDL_Serialize {
    Output: Address
    Body: {
        t = ""
        t = NL_TextAppend(t, "# AILang HDL pin map — bind to board pins\n")
        t = NL_TextAppend(t, "# format: port  direction  width  board_pin\n")
        t = NL_TextAppend(t, "# Also emitted: <base>.pcf (ice40) and <base>.xdc (Xilinx)\n")
        t = NL_TextAppend(t, "#\n")

        top = NL_FindModule(NL.top_name)
        IfCondition EqualTo(top, 0) ThenBlock: {
            t = NL_TextAppend(t, "# (no ailang_top yet)\n")
            ReturnValue(t)
        }
        ports = NL_ModulePorts(top)
        IfCondition EqualTo(ports, 0) ThenBlock: {
            ReturnValue(t)
        }
        pc = Array.Size(ports)
        pi = 0
        WhileLoop LessThan(pi, pc) {
            p = Array.Get(ports, pi)
            pname = Dereference(p)
            pdir = Dereference(Add(p, 8))
            pwidth = Dereference(Add(p, 16))
            t = NL_TextAppend(t, NL_SafeIdent(pname))
            t = NL_TextAppend(t, "  ")
            IfCondition EqualTo(pdir, NLKind.PORT_IN) ThenBlock: {
                t = NL_TextAppend(t, "in ")
            }
            IfCondition EqualTo(pdir, NLKind.PORT_OUT) ThenBlock: {
                t = NL_TextAppend(t, "out")
            }
            IfCondition EqualTo(pdir, NLKind.PORT_CLOCK) ThenBlock: {
                t = NL_TextAppend(t, "in ")
            }
            IfCondition EqualTo(pdir, NLKind.PORT_RESET) ThenBlock: {
                t = NL_TextAppend(t, "in ")
            }
            t = NL_TextAppend(t, "  ")
            t = NL_TextAppend(t, NL_IntToString(pwidth))
            t = NL_TextAppend(t, "  UNASSIGNED\n")
            pi = Add(pi, 1)
        }
        ReturnValue(t)
    }
}

// ice40 PCF: set_io port PIN
Function.EmitPinsHDL_SerializePcf {
    Output: Address
    Body: {
        t = ""
        t = NL_TextAppend(t, "# AILang → ice40 PCF (edit PIN names for your board)\n")
        t = NL_TextAppend(t, "# nextpnr-ice40 --pcf thisfile.pcf ...\n")
        top = NL_FindModule(NL.top_name)
        IfCondition EqualTo(top, 0) ThenBlock: { ReturnValue(t) }
        ports = NL_ModulePorts(top)
        IfCondition EqualTo(ports, 0) ThenBlock: { ReturnValue(t) }
        pc = Array.Size(ports)
        pi = 0
        WhileLoop LessThan(pi, pc) {
            p = Array.Get(ports, pi)
            pname = NL_SafeIdent(Dereference(p))
            pwidth = Dereference(Add(p, 16))
            IfCondition GreaterThan(pwidth, 1) ThenBlock: {
                bi = 0
                WhileLoop LessThan(bi, pwidth) {
                    t = NL_TextAppend(t, "set_io ")
                    t = NL_TextAppend(t, pname)
                    t = NL_TextAppend(t, "[")
                    t = NL_TextAppend(t, NL_IntToString(bi))
                    t = NL_TextAppend(t, "]  PIN_")
                    t = NL_TextAppend(t, pname)
                    t = NL_TextAppend(t, "_")
                    t = NL_TextAppend(t, NL_IntToString(bi))
                    t = NL_TextAppend(t, "\n")
                    bi = Add(bi, 1)
                }
            } ElseBlock: {
                t = NL_TextAppend(t, "set_io ")
                t = NL_TextAppend(t, pname)
                t = NL_TextAppend(t, "  PIN_")
                t = NL_TextAppend(t, pname)
                t = NL_TextAppend(t, "\n")
            }
            pi = Add(pi, 1)
        }
        ReturnValue(t)
    }
}

// Xilinx XDC: set_property PACKAGE_PIN ...
Function.EmitPinsHDL_SerializeXdc {
    Output: Address
    Body: {
        t = ""
        t = NL_TextAppend(t, "# AILang → Xilinx XDC (edit PACKAGE_PIN for your board)\n")
        t = NL_TextAppend(t, "# create_clock is also in the .sdc sidecar\n")
        per = SdcHDL.period_ns
        IfCondition LessEqual(per, 0) ThenBlock: { per = 10 }
        t = NL_TextAppend(t, "create_clock -period ")
        t = NL_TextAppend(t, NL_IntToString(per))
        t = NL_TextAppend(t, " -name clk [get_ports clk]\n")
        top = NL_FindModule(NL.top_name)
        IfCondition EqualTo(top, 0) ThenBlock: { ReturnValue(t) }
        ports = NL_ModulePorts(top)
        IfCondition EqualTo(ports, 0) ThenBlock: { ReturnValue(t) }
        pc = Array.Size(ports)
        pi = 0
        WhileLoop LessThan(pi, pc) {
            p = Array.Get(ports, pi)
            pname = NL_SafeIdent(Dereference(p))
            pwidth = Dereference(Add(p, 16))
            IfCondition GreaterThan(pwidth, 1) ThenBlock: {
                bi = 0
                WhileLoop LessThan(bi, pwidth) {
                    t = NL_TextAppend(t, "set_property PACKAGE_PIN XX [get_ports {")
                    t = NL_TextAppend(t, pname)
                    t = NL_TextAppend(t, "[")
                    t = NL_TextAppend(t, NL_IntToString(bi))
                    t = NL_TextAppend(t, "]}]\n")
                    t = NL_TextAppend(t, "set_property IOSTANDARD LVCMOS33 [get_ports {")
                    t = NL_TextAppend(t, pname)
                    t = NL_TextAppend(t, "[")
                    t = NL_TextAppend(t, NL_IntToString(bi))
                    t = NL_TextAppend(t, "]}]\n")
                    bi = Add(bi, 1)
                }
            } ElseBlock: {
                t = NL_TextAppend(t, "set_property PACKAGE_PIN XX [get_ports ")
                t = NL_TextAppend(t, pname)
                t = NL_TextAppend(t, "]\n")
                t = NL_TextAppend(t, "set_property IOSTANDARD LVCMOS33 [get_ports ")
                t = NL_TextAppend(t, pname)
                t = NL_TextAppend(t, "]\n")
            }
            pi = Add(pi, 1)
        }
        ReturnValue(t)
    }
}

Function.EmitPinsHDL_WriteText {
    Input: path: Address
    Input: text: Address
    Output: Integer
    Body: {
        IfCondition Or(EqualTo(path, 0), EqualTo(text, 0)) ThenBlock: { ReturnValue(0) }
        fd = FileOpen(path, 577, 420)
        IfCondition LessThan(fd, 0) ThenBlock: {
            PrintMessage("[HDL] ERROR: cannot write ")
            PrintMessage(path)
            PrintMessage("\n")
            ReturnValue(0)
        }
        len = EmitVerilogHDL_StrLen(text)
        written = FileWrite(fd, text, len)
        FileClose(fd)
        PrintMessage("[HDL] wrote pin map: ")
        PrintMessage(path)
        PrintMessage(" (")
        PrintNumber(written)
        PrintMessage(" bytes)\n")
        IfCondition LessThan(written, 1) ThenBlock: { ReturnValue(0) }
        ReturnValue(1)
    }
}

// path is typically <base>.pins — also write <base>.pcf and <base>.xdc
Function.EmitPinsHDL_WriteFile {
    Input: path: Address
    Output: Integer
    Body: {
        ok = EmitPinsHDL_WriteText(path, EmitPinsHDL_Serialize())
        // Derive base by stripping trailing ".pins" if present
        base = path
        // naive: always also write path with suffixes via string replace of .pins
        // If path ends with .pins, strip 5 chars; else use path as base
        plen = EmitVerilogHDL_StrLen(path)
        IfCondition GreaterEqual(plen, 5) ThenBlock: {
            // check last 5 == .pins
            // GetByte path[plen-5]...
            c0 = GetByte(path, Subtract(plen, 5))
            c1 = GetByte(path, Subtract(plen, 4))
            c2 = GetByte(path, Subtract(plen, 3))
            c3 = GetByte(path, Subtract(plen, 2))
            c4 = GetByte(path, Subtract(plen, 1))
            IfCondition EqualTo(c0, 46) ThenBlock: {
                IfCondition EqualTo(c1, 112) ThenBlock: {
                    IfCondition EqualTo(c2, 105) ThenBlock: {
                        IfCondition EqualTo(c3, 110) ThenBlock: {
                            IfCondition EqualTo(c4, 115) ThenBlock: {
                                // build base without .pins
                                base = Allocate(Subtract(plen, 4))
                                i = 0
                                WhileLoop LessThan(i, Subtract(plen, 5)) {
                                    SetByte(base, i, GetByte(path, i))
                                    i = Add(i, 1)
                                }
                                SetByte(base, Subtract(plen, 5), 0)
                            }
                        }
                    }
                }
            }
        }
        EmitPinsHDL_WriteText(StringConcat(base, ".pcf"), EmitPinsHDL_SerializePcf())
        EmitPinsHDL_WriteText(StringConcat(base, ".xdc"), EmitPinsHDL_SerializeXdc())
        ReturnValue(ok)
    }
}
