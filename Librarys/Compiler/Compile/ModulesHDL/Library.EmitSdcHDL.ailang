// Library.EmitSdcHDL.ailang
// Minimal SDC + Yosys script sidecars for the HDL backend.
// Location: Librarys/Compiler/Compile/ModulesHDL/Library.EmitSdcHDL.ailang

LibraryImport.Compiler.Compile.ModulesHDL.NetlistIRHDL
LibraryImport.Compiler.Compile.ModulesHDL.EmitVerilogHDL

// Default 100 MHz period (ns) — override later via CLI if needed
FixedPool.SdcHDL {
    "period_ns": Initialize=10
    "text": Initialize=0, CanChange=True
}

// =============================================================================
// SDC — clock + I/O delay stubs
// =============================================================================
Function.EmitSdcHDL_Serialize {
    Output: Address
    Body: {
        t = ""
        t = NL_TextAppend(t, "# Generated by AILang HDL backend\n")
        t = NL_TextAppend(t, "# Minimal SDC for ailang_top — edit for board/timing signoff\n")
        t = NL_TextAppend(t, "#\n")
        t = NL_TextAppend(t, "create_clock -name clk -period ")
        t = NL_TextAppend(t, NL_IntToString(SdcHDL.period_ns))
        t = NL_TextAppend(t, " [get_ports clk]\n")
        t = NL_TextAppend(t, "set_clock_uncertainty 0.1 [get_clocks clk]\n")
        t = NL_TextAppend(t, "# Async reset — do not time through rst by default\n")
        t = NL_TextAppend(t, "set_false_path -from [get_ports rst]\n")
        t = NL_TextAppend(t, "# Placeholder I/O delays (25% of period)\n")
        t = NL_TextAppend(t, "set_input_delay  -clock clk 2.5 [all_inputs]\n")
        t = NL_TextAppend(t, "set_output_delay -clock clk 2.5 [all_outputs]\n")
        SdcHDL.text = t
        ReturnValue(t)
    }
}

Function.EmitSdcHDL_WriteFile {
    Input: path: Address
    Output: Integer
    Body: {
        text = EmitSdcHDL_Serialize()
        IfCondition EqualTo(text, 0) ThenBlock: { ReturnValue(0) }
        fd = FileOpen(path, 577, 420)
        IfCondition LessThan(fd, 0) ThenBlock: {
            PrintMessage("[HDL] ERROR: cannot write ")
            PrintMessage(path)
            PrintMessage("\n")
            ReturnValue(0)
        }
        len = EmitVerilogHDL_StrLen(text)
        written = FileWrite(fd, text, len)
        FileClose(fd)
        PrintMessage("[HDL] wrote SDC: ")
        PrintMessage(path)
        PrintMessage(" (")
        PrintNumber(written)
        PrintMessage(" bytes)\n")
        IfCondition LessThan(written, 1) ThenBlock: { ReturnValue(0) }
        ReturnValue(1)
    }
}

// =============================================================================
// Yosys script — open-source synth check loop
// =============================================================================
Function.EmitYosysTcl_Serialize {
    Input: vpath: Address
    Output: Address
    Body: {
        t = ""
        t = NL_TextAppend(t, "# Generated by AILang HDL backend\n")
        t = NL_TextAppend(t, "# Usage: yosys -s ")
        // filename filled by caller context — self-contained read
        t = NL_TextAppend(t, "<thisfile.ys>\n")
        t = NL_TextAppend(t, "read_verilog ")
        IfCondition NotEqual(vpath, 0) ThenBlock: {
            t = NL_TextAppend(t, vpath)
        } ElseBlock: {
            t = NL_TextAppend(t, "design.v")
        }
        t = NL_TextAppend(t, "\n")
        t = NL_TextAppend(t, "hierarchy -check -top ailang_top\n")
        t = NL_TextAppend(t, "proc; opt; memory; opt\n")
        t = NL_TextAppend(t, "stat\n")
        t = NL_TextAppend(t, "check\n")
        // optional techmap stubs for open FPGA flows
        t = NL_TextAppend(t, "# synth_ice40 -top ailang_top\n")
        t = NL_TextAppend(t, "# write_blif design.blif\n")
        ReturnValue(t)
    }
}

Function.EmitYosysTcl_WriteFile {
    Input: path: Address
    Input: vpath: Address
    Output: Integer
    Body: {
        text = EmitYosysTcl_Serialize(vpath)
        IfCondition EqualTo(text, 0) ThenBlock: { ReturnValue(0) }
        fd = FileOpen(path, 577, 420)
        IfCondition LessThan(fd, 0) ThenBlock: {
            PrintMessage("[HDL] ERROR: cannot write ")
            PrintMessage(path)
            PrintMessage("\n")
            ReturnValue(0)
        }
        len = EmitVerilogHDL_StrLen(text)
        written = FileWrite(fd, text, len)
        FileClose(fd)
        PrintMessage("[HDL] wrote Yosys script: ")
        PrintMessage(path)
        PrintMessage(" (")
        PrintNumber(written)
        PrintMessage(" bytes)\n")
        IfCondition LessThan(written, 1) ThenBlock: { ReturnValue(0) }
        ReturnValue(1)
    }
}
