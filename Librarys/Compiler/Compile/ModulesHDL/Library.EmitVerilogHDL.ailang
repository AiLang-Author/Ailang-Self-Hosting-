// Library.EmitVerilogHDL.ailang
// Structural Verilog serializer for the HDL netlist IR.
// Location: Librarys/Compiler/Compile/ModulesHDL/Library.EmitVerilogHDL.ailang
//
// Pure text emit — no machine-code buffers, no fixups, no ELF.
// Output is a readable structural netlist suitable for Yosys / vendor flows.

LibraryImport.Arrays
LibraryImport.Compiler.Compile.ModulesHDL.NetlistIRHDL

FixedPool.VEmit {
    "text": Initialize=0, CanChange=True
}

// =============================================================================
// PUBLIC API
// =============================================================================
Function.EmitVerilogHDL_Serialize {
    Output: Address
    Body: {
        VEmit.text = ""
        VEmit.text = NL_TextAppend(VEmit.text, "// Generated by AILang HDL backend\n")
        VEmit.text = NL_TextAppend(VEmit.text, "// Structural netlist — regular AIlang source, no HDL dialect\n")
        VEmit.text = NL_TextAppend(VEmit.text, "//\n\n")

        IfCondition EqualTo(NL.modules, 0) ThenBlock: {
            VEmit.text = NL_TextAppend(VEmit.text, "// (empty netlist)\n")
            ReturnValue(VEmit.text)
        }

        count = Array.Size(NL.modules)
        i = 0
        WhileLoop LessThan(i, count) {
            mod = Array.Get(NL.modules, i)
            EmitVerilogHDL_Module(mod)
            VEmit.text = NL_TextAppend(VEmit.text, "\n")
            i = Add(i, 1)
        }

        ReturnValue(VEmit.text)
    }
}

Function.EmitVerilogHDL_WriteFile {
    Input: path: Address
    Output: Integer
    Body: {
        text = EmitVerilogHDL_Serialize()
        IfCondition EqualTo(text, 0) ThenBlock: {
            ReturnValue(0)
        }

        // FileFlags.WRITE_NEW = O_WRONLY|O_CREAT|O_TRUNC = 577
        // FileMode.RW = 0644 = 420
        fd = FileOpen(path, 577, 420)
        IfCondition LessThan(fd, 0) ThenBlock: {
            PrintMessage("[HDL] ERROR: cannot write ")
            PrintMessage(path)
            PrintMessage("\n")
            ReturnValue(0)
        }

        // Length via walking bytes (StringLength if available as primitive)
        len = EmitVerilogHDL_StrLen(text)
        written = FileWrite(fd, text, len)
        FileClose(fd)

        PrintMessage("[HDL] wrote structural Verilog: ")
        PrintMessage(path)
        PrintMessage(" (")
        PrintNumber(written)
        PrintMessage(" bytes)\n")

        IfCondition LessThan(written, 1) ThenBlock: {
            ReturnValue(0)
        }
        ReturnValue(1)
    }
}

// =============================================================================
// MODULE EMIT
// =============================================================================
Function.EmitVerilogHDL_Module {
    Input: mod: Address
    Body: {
        name = NL_ModuleName(mod)
        IfCondition EqualTo(name, 0) ThenBlock: {
            name = "unnamed"
        }

        VEmit.text = NL_TextAppend(VEmit.text, "module ")
        VEmit.text = NL_TextAppend(VEmit.text, EmitVerilogHDL_SafeIdent(name))
        VEmit.text = NL_TextAppend(VEmit.text, " (\n")

        // Port list
        ports = NL_ModulePorts(mod)
        pcount = 0
        IfCondition NotEqual(ports, 0) ThenBlock: {
            pcount = Array.Size(ports)
        }

        pi = 0
        WhileLoop LessThan(pi, pcount) {
            port = Array.Get(ports, pi)
            EmitVerilogHDL_PortDecl(port, EqualTo(pi, Subtract(pcount, 1)))
            pi = Add(pi, 1)
        }

        VEmit.text = NL_TextAppend(VEmit.text, ");\n")

        // Memories / regs from FixedPool
        memories = NL_ModuleMemories(mod)
        IfCondition NotEqual(memories, 0) ThenBlock: {
            mcount = Array.Size(memories)
            mi = 0
            WhileLoop LessThan(mi, mcount) {
                mem = Array.Get(memories, mi)
                EmitVerilogHDL_Memory(mem)
                mi = Add(mi, 1)
            }
        }

        // Cells → wire decls + combinational equations
        cells = NL_ModuleCells(mod)
        IfCondition NotEqual(cells, 0) ThenBlock: {
            ccount = Array.Size(cells)
            ci = 0
            WhileLoop LessThan(ci, ccount) {
                cell = Array.Get(cells, ci)
                EmitVerilogHDL_Cell(cell)
                ci = Add(ci, 1)
            }
        }

        // LUT / matrix ROMs (preferred multi-way form)
        EmitVerilogHDL_Luts(mod)

        // User Function instances (hierarchy)
        EmitVerilogHDL_Instances(mod)

        // Continuous assigns + sequential process
        EmitVerilogHDL_Assigns(mod)

        VEmit.text = NL_TextAppend(VEmit.text, "endmodule\n")
    }
}

Function.EmitVerilogHDL_PortDecl {
    Input: port: Address
    Input: is_last: Integer
    Body: {
        pname = Dereference(port)
        dir = Dereference(Add(port, 8))
        width = Dereference(Add(port, 16))
        safe = EmitVerilogHDL_SafeIdent(pname)

        // Pool-backed outputs are registers (driven in always block).
        // Function result ports stay wires (combinational assign).
        is_reg_out = 0
        IfCondition EqualTo(dir, NLKind.PORT_OUT) ThenBlock: {
            is_reg_out = EmitVerilogHDL_IsPoolPort(safe)
        }

        VEmit.text = NL_TextAppend(VEmit.text, "  ")

        IfCondition EqualTo(dir, NLKind.PORT_IN) ThenBlock: {
            VEmit.text = NL_TextAppend(VEmit.text, "input  ")
        }
        IfCondition EqualTo(dir, NLKind.PORT_OUT) ThenBlock: {
            IfCondition EqualTo(is_reg_out, 1) ThenBlock: {
                VEmit.text = NL_TextAppend(VEmit.text, "output reg ")
            } ElseBlock: {
                VEmit.text = NL_TextAppend(VEmit.text, "output ")
            }
        }
        IfCondition EqualTo(dir, NLKind.PORT_INOUT) ThenBlock: {
            VEmit.text = NL_TextAppend(VEmit.text, "inout  ")
        }
        IfCondition EqualTo(dir, NLKind.PORT_CLOCK) ThenBlock: {
            VEmit.text = NL_TextAppend(VEmit.text, "input  ")
        }
        IfCondition EqualTo(dir, NLKind.PORT_RESET) ThenBlock: {
            VEmit.text = NL_TextAppend(VEmit.text, "input  ")
        }

        IfCondition GreaterThan(width, 1) ThenBlock: {
            VEmit.text = NL_TextAppend(VEmit.text, "[")
            VEmit.text = NL_TextAppend(VEmit.text, NL_IntToString(Subtract(width, 1)))
            VEmit.text = NL_TextAppend(VEmit.text, ":0] ")
        } ElseBlock: {
            VEmit.text = NL_TextAppend(VEmit.text, "      ")
        }

        VEmit.text = NL_TextAppend(VEmit.text, safe)
        IfCondition EqualTo(is_last, 0) ThenBlock: {
            VEmit.text = NL_TextAppend(VEmit.text, ",\n")
        } ElseBlock: {
            VEmit.text = NL_TextAppend(VEmit.text, "\n")
        }
    }
}

Function.EmitVerilogHDL_Memory {
    Input: mem: Address
    Body: {
        full = Dereference(mem)
        width = Dereference(Add(mem, 8))
        depth = Dereference(Add(mem, 16))
        initv = Dereference(Add(mem, 24))
        safe = EmitVerilogHDL_SafeIdent(full)

        // Already declared as output reg on the port list — only note init
        VEmit.text = NL_TextAppend(VEmit.text, "  // FixedPool field: ")
        VEmit.text = NL_TextAppend(VEmit.text, full)
        VEmit.text = NL_TextAppend(VEmit.text, " (port) init=")
        VEmit.text = NL_TextAppend(VEmit.text, NL_IntToString(initv))
        VEmit.text = NL_TextAppend(VEmit.text, "\n")

        IfCondition EqualTo(depth, 1) ThenBlock: {
            // Initial value via procedural init (port is output reg)
            VEmit.text = NL_TextAppend(VEmit.text, "  initial ")
            VEmit.text = NL_TextAppend(VEmit.text, safe)
            VEmit.text = NL_TextAppend(VEmit.text, " = ")
            VEmit.text = NL_TextAppend(VEmit.text, NL_IntToString(width))
            VEmit.text = NL_TextAppend(VEmit.text, "'d")
            VEmit.text = NL_TextAppend(VEmit.text, NL_IntToString(initv))
            VEmit.text = NL_TextAppend(VEmit.text, ";\n")
        } ElseBlock: {
            // Internal array (not exported as port for multi-element yet)
            VEmit.text = NL_TextAppend(VEmit.text, "  reg [")
            VEmit.text = NL_TextAppend(VEmit.text, NL_IntToString(Subtract(width, 1)))
            VEmit.text = NL_TextAppend(VEmit.text, ":0] ")
            VEmit.text = NL_TextAppend(VEmit.text, safe)
            VEmit.text = NL_TextAppend(VEmit.text, " [0:")
            VEmit.text = NL_TextAppend(VEmit.text, NL_IntToString(Subtract(depth, 1)))
            VEmit.text = NL_TextAppend(VEmit.text, "];\n")
        }
    }
}

Function.EmitVerilogHDL_Cell {
    Input: cell: Address
    Body: {
        kind = Dereference(Add(cell, 8))
        cname = Dereference(Add(cell, 16))
        p0 = Dereference(Add(cell, 24))
        width = Dereference(Add(cell, 40))
        op_a = Dereference(Add(cell, 48))
        op_b = Dereference(Add(cell, 56))
        safe = EmitVerilogHDL_SafeIdent(cname)
        wa = EmitVerilogHDL_SafeIdent(op_a)
        wb = EmitVerilogHDL_SafeIdent(op_b)

        IfCondition EqualTo(kind, NLKind.CELL_DFF) ThenBlock: {
            // Pool regs already emitted as reg — skip duplicate
            ReturnValue(0)
        }
        IfCondition EqualTo(kind, NLKind.CELL_MEM) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition EqualTo(kind, NLKind.CELL_INSTANCE) ThenBlock: {
            // Full port maps emitted via EmitVerilogHDL_Instances
            ReturnValue(0)
        }
        IfCondition EqualTo(kind, NLKind.CELL_BUF) ThenBlock: {
            ReturnValue(0)
        }

        // Wire for result of this cell
        IfCondition GreaterThan(width, 1) ThenBlock: {
            VEmit.text = NL_TextAppend(VEmit.text, "  wire [")
            VEmit.text = NL_TextAppend(VEmit.text, NL_IntToString(Subtract(width, 1)))
            VEmit.text = NL_TextAppend(VEmit.text, ":0] ")
            VEmit.text = NL_TextAppend(VEmit.text, safe)
            VEmit.text = NL_TextAppend(VEmit.text, ";\n")
        } ElseBlock: {
            VEmit.text = NL_TextAppend(VEmit.text, "  wire ")
            VEmit.text = NL_TextAppend(VEmit.text, safe)
            VEmit.text = NL_TextAppend(VEmit.text, ";\n")
        }

        VEmit.text = NL_TextAppend(VEmit.text, "  assign ")
        VEmit.text = NL_TextAppend(VEmit.text, safe)
        VEmit.text = NL_TextAppend(VEmit.text, " = ")

        IfCondition EqualTo(kind, NLKind.CELL_CONST) ThenBlock: {
            VEmit.text = NL_TextAppend(VEmit.text, NL_IntToString(width))
            VEmit.text = NL_TextAppend(VEmit.text, "'d")
            VEmit.text = NL_TextAppend(VEmit.text, NL_IntToString(p0))
            VEmit.text = NL_TextAppend(VEmit.text, ";\n")
            ReturnValue(0)
        }

        IfCondition EqualTo(kind, NLKind.CELL_NOT) ThenBlock: {
            VEmit.text = NL_TextAppend(VEmit.text, "~")
            VEmit.text = NL_TextAppend(VEmit.text, wa)
            VEmit.text = NL_TextAppend(VEmit.text, ";\n")
            ReturnValue(0)
        }

        // Binary ops
        VEmit.text = NL_TextAppend(VEmit.text, wa)
        IfCondition EqualTo(kind, NLKind.CELL_ADD) ThenBlock: {
            VEmit.text = NL_TextAppend(VEmit.text, " + ")
        }
        IfCondition EqualTo(kind, NLKind.CELL_SUB) ThenBlock: {
            VEmit.text = NL_TextAppend(VEmit.text, " - ")
        }
        IfCondition EqualTo(kind, NLKind.CELL_MUL) ThenBlock: {
            VEmit.text = NL_TextAppend(VEmit.text, " * ")
        }
        IfCondition EqualTo(kind, NLKind.CELL_DIV) ThenBlock: {
            VEmit.text = NL_TextAppend(VEmit.text, " / ")
        }
        IfCondition EqualTo(kind, NLKind.CELL_EQ) ThenBlock: {
            VEmit.text = NL_TextAppend(VEmit.text, " == ")
        }
        IfCondition EqualTo(kind, NLKind.CELL_NE) ThenBlock: {
            VEmit.text = NL_TextAppend(VEmit.text, " != ")
        }
        IfCondition EqualTo(kind, NLKind.CELL_LT) ThenBlock: {
            VEmit.text = NL_TextAppend(VEmit.text, " < ")
        }
        IfCondition EqualTo(kind, NLKind.CELL_GT) ThenBlock: {
            VEmit.text = NL_TextAppend(VEmit.text, " > ")
        }
        IfCondition EqualTo(kind, NLKind.CELL_LE) ThenBlock: {
            VEmit.text = NL_TextAppend(VEmit.text, " <= ")
        }
        IfCondition EqualTo(kind, NLKind.CELL_GE) ThenBlock: {
            VEmit.text = NL_TextAppend(VEmit.text, " >= ")
        }
        IfCondition EqualTo(kind, NLKind.CELL_AND) ThenBlock: {
            VEmit.text = NL_TextAppend(VEmit.text, " & ")
        }
        IfCondition EqualTo(kind, NLKind.CELL_OR) ThenBlock: {
            VEmit.text = NL_TextAppend(VEmit.text, " | ")
        }
        IfCondition EqualTo(kind, NLKind.CELL_MUX) ThenBlock: {
            // name = sel ? a : b  — not fully wired yet
            VEmit.text = NL_TextAppend(VEmit.text, " /*mux*/ ")
        }
        VEmit.text = NL_TextAppend(VEmit.text, wb)
        VEmit.text = NL_TextAppend(VEmit.text, ";\n")
    }
}

// =============================================================================
// Module instances (user calls)
// =============================================================================
Function.EmitVerilogHDL_Instances {
    Input: mod: Address
    Body: {
        insts = NL_ModuleInstances(mod)
        IfCondition EqualTo(insts, 0) ThenBlock: {
            ReturnValue(0)
        }
        ic = Array.Size(insts)
        ii = 0
        WhileLoop LessThan(ii, ic) {
            inst = Array.Get(insts, ii)
            tname = EmitVerilogHDL_SafeIdent(Dereference(inst))
            iname = EmitVerilogHDL_SafeIdent(Dereference(Add(inst, 8)))
            conns = Dereference(Add(inst, 16))
            result_net = Dereference(Add(inst, 24))

            // Declare result wire if present
            IfCondition NotEqual(result_net, 0) ThenBlock: {
                VEmit.text = NL_TextAppend(VEmit.text, "  wire [63:0] ")
                VEmit.text = NL_TextAppend(VEmit.text, EmitVerilogHDL_SafeIdent(result_net))
                VEmit.text = NL_TextAppend(VEmit.text, ";\n")
            }

            VEmit.text = NL_TextAppend(VEmit.text, "  ")
            VEmit.text = NL_TextAppend(VEmit.text, tname)
            VEmit.text = NL_TextAppend(VEmit.text, " ")
            VEmit.text = NL_TextAppend(VEmit.text, iname)
            VEmit.text = NL_TextAppend(VEmit.text, " (\n")

            IfCondition NotEqual(conns, 0) ThenBlock: {
                nc = Array.Size(conns)
                ci = 0
                WhileLoop LessThan(ci, nc) {
                    e = Array.Get(conns, ci)
                    pn = EmitVerilogHDL_SafeIdent(Dereference(e))
                    nn = EmitVerilogHDL_SafeIdent(Dereference(Add(e, 8)))
                    VEmit.text = NL_TextAppend(VEmit.text, "    .")
                    VEmit.text = NL_TextAppend(VEmit.text, pn)
                    VEmit.text = NL_TextAppend(VEmit.text, "(")
                    VEmit.text = NL_TextAppend(VEmit.text, nn)
                    VEmit.text = NL_TextAppend(VEmit.text, ")")
                    IfCondition LessThan(ci, Subtract(nc, 1)) ThenBlock: {
                        VEmit.text = NL_TextAppend(VEmit.text, ",\n")
                    } ElseBlock: {
                        VEmit.text = NL_TextAppend(VEmit.text, "\n")
                    }
                    ci = Add(ci, 1)
                }
            }
            VEmit.text = NL_TextAppend(VEmit.text, "  );\n")
            ii = Add(ii, 1)
        }
    }
}

// =============================================================================
// LUT emit — case ROM (Yosys → $mem/$lut). Flat table, not if-else chains.
// =============================================================================
Function.EmitVerilogHDL_Luts {
    Input: mod: Address
    Body: {
        luts = NL_ModuleLuts(mod)
        IfCondition EqualTo(luts, 0) ThenBlock: {
            ReturnValue(0)
        }
        lc = Array.Size(luts)
        li = 0
        WhileLoop LessThan(li, lc) {
            lut = Array.Get(luts, li)
            EmitVerilogHDL_OneLut(lut)
            li = Add(li, 1)
        }
    }
}

Function.EmitVerilogHDL_OneLut {
    Input: lut: Address
    Body: {
        name = Dereference(lut)
        abits = Dereference(Add(lut, 8))
        dbits = Dereference(Add(lut, 16))
        depth = Dereference(Add(lut, 24))
        entries = Dereference(Add(lut, 32))
        addr = Dereference(Add(lut, 40))
        outn = Dereference(Add(lut, 48))
        saddr = EmitVerilogHDL_SafeIdent(addr)
        sout = EmitVerilogHDL_SafeIdent(outn)
        sname = EmitVerilogHDL_SafeIdent(name)

        VEmit.text = NL_TextAppend(VEmit.text, "  // LUT matrix ")
        VEmit.text = NL_TextAppend(VEmit.text, sname)
        VEmit.text = NL_TextAppend(VEmit.text, " [")
        VEmit.text = NL_TextAppend(VEmit.text, NL_IntToString(depth))
        VEmit.text = NL_TextAppend(VEmit.text, " entries] — table decode, not if-else\n")

        // out wire
        VEmit.text = NL_TextAppend(VEmit.text, "  reg [")
        VEmit.text = NL_TextAppend(VEmit.text, NL_IntToString(Subtract(dbits, 1)))
        VEmit.text = NL_TextAppend(VEmit.text, ":0] ")
        VEmit.text = NL_TextAppend(VEmit.text, sout)
        VEmit.text = NL_TextAppend(VEmit.text, ";\n")

        // Combinational case ROM
        VEmit.text = NL_TextAppend(VEmit.text, "  always @(*) begin\n")
        VEmit.text = NL_TextAppend(VEmit.text, "    case (")
        VEmit.text = NL_TextAppend(VEmit.text, saddr)
        VEmit.text = NL_TextAppend(VEmit.text, ")\n")

        i = 0
        WhileLoop LessThan(i, depth) {
            val = 0
            IfCondition NotEqual(entries, 0) ThenBlock: {
                IfCondition LessThan(i, Array.Size(entries)) ThenBlock: {
                    val = Array.Get(entries, i)
                }
            }
            VEmit.text = NL_TextAppend(VEmit.text, "      ")
            VEmit.text = NL_TextAppend(VEmit.text, NL_IntToString(abits))
            VEmit.text = NL_TextAppend(VEmit.text, "'d")
            VEmit.text = NL_TextAppend(VEmit.text, NL_IntToString(i))
            VEmit.text = NL_TextAppend(VEmit.text, ": ")
            VEmit.text = NL_TextAppend(VEmit.text, sout)
            VEmit.text = NL_TextAppend(VEmit.text, " = ")
            VEmit.text = NL_TextAppend(VEmit.text, NL_IntToString(dbits))
            VEmit.text = NL_TextAppend(VEmit.text, "'d")
            VEmit.text = NL_TextAppend(VEmit.text, NL_IntToString(val))
            VEmit.text = NL_TextAppend(VEmit.text, ";\n")
            i = Add(i, 1)
        }

        VEmit.text = NL_TextAppend(VEmit.text, "      default: ")
        VEmit.text = NL_TextAppend(VEmit.text, sout)
        VEmit.text = NL_TextAppend(VEmit.text, " = ")
        VEmit.text = NL_TextAppend(VEmit.text, NL_IntToString(dbits))
        VEmit.text = NL_TextAppend(VEmit.text, "'d0;\n")
        VEmit.text = NL_TextAppend(VEmit.text, "    endcase\n")
        VEmit.text = NL_TextAppend(VEmit.text, "  end\n")
    }
}

// Assign entries: comb assign, seq in always @(posedge clk), if markers
Function.EmitVerilogHDL_Assigns {
    Input: mod: Address
    Body: {
        assigns = NL_ModuleAssigns(mod)
        IfCondition EqualTo(assigns, 0) ThenBlock: {
            ReturnValue(0)
        }
        acount = Array.Size(assigns)
        IfCondition EqualTo(acount, 0) ThenBlock: {
            ReturnValue(0)
        }

        // Pass 1: combinational assigns (kind 0)
        ai = 0
        WhileLoop LessThan(ai, acount) {
            a = Array.Get(assigns, ai)
            kind = Dereference(Add(a, 16))
            IfCondition EqualTo(kind, NLKind.ASSIGN_COMB) ThenBlock: {
                raw_lhs = Dereference(a)
                raw_rhs = Dereference(Add(a, 8))
                lhs = EmitVerilogHDL_SafeIdent(raw_lhs)
                // RHS may be "Mem[3]" index form — only safe-ident if no '['
                rhs = raw_rhs
                IfCondition EqualTo(EmitVerilogHDL_HasBracket(raw_rhs), 0) ThenBlock: {
                    rhs = EmitVerilogHDL_SafeIdent(raw_rhs)
                } ElseBlock: {
                    // still map dots in base before [
                    rhs = EmitVerilogHDL_SafeIndexRhs(raw_rhs)
                }
                // Temp wires (wN) need a declaration
                IfCondition EqualTo(EmitVerilogHDL_IsTempWire(lhs), 1) ThenBlock: {
                    VEmit.text = NL_TextAppend(VEmit.text, "  wire [63:0] ")
                    VEmit.text = NL_TextAppend(VEmit.text, lhs)
                    VEmit.text = NL_TextAppend(VEmit.text, ";\n")
                }
                VEmit.text = NL_TextAppend(VEmit.text, "  assign ")
                VEmit.text = NL_TextAppend(VEmit.text, lhs)
                VEmit.text = NL_TextAppend(VEmit.text, " = ")
                VEmit.text = NL_TextAppend(VEmit.text, rhs)
                VEmit.text = NL_TextAppend(VEmit.text, ";\n")
            }
            ai = Add(ai, 1)
        }

        // Pass 2: sequential region (kind 1 = seq, 2=if_begin, 3=else, 4=if_end)
        has_seq = 0
        ai = 0
        WhileLoop LessThan(ai, acount) {
            a = Array.Get(assigns, ai)
            kind = Dereference(Add(a, 16))
            IfCondition GreaterThan(kind, 0) ThenBlock: {
                has_seq = 1
            }
            ai = Add(ai, 1)
        }

        IfCondition EqualTo(has_seq, 0) ThenBlock: {
            ReturnValue(0)
        }

        VEmit.text = NL_TextAppend(VEmit.text, "  always @(posedge clk) begin\n")
        VEmit.text = NL_TextAppend(VEmit.text, "    if (rst) begin\n")
        // Reset pool regs in this module to their init values
        memories = NL_ModuleMemories(mod)
        IfCondition NotEqual(memories, 0) ThenBlock: {
            mc = Array.Size(memories)
            mi = 0
            WhileLoop LessThan(mi, mc) {
                mem = Array.Get(memories, mi)
                mname = EmitVerilogHDL_SafeIdent(Dereference(mem))
                initv = Dereference(Add(mem, 24))
                width = Dereference(Add(mem, 8))
                VEmit.text = NL_TextAppend(VEmit.text, "      ")
                VEmit.text = NL_TextAppend(VEmit.text, mname)
                VEmit.text = NL_TextAppend(VEmit.text, " <= ")
                VEmit.text = NL_TextAppend(VEmit.text, NL_IntToString(width))
                VEmit.text = NL_TextAppend(VEmit.text, "'d")
                VEmit.text = NL_TextAppend(VEmit.text, NL_IntToString(initv))
                VEmit.text = NL_TextAppend(VEmit.text, ";\n")
                mi = Add(mi, 1)
            }
        }
        VEmit.text = NL_TextAppend(VEmit.text, "    end else begin\n")

        if_depth = 0
        ai = 0
        WhileLoop LessThan(ai, acount) {
            a = Array.Get(assigns, ai)
            kind = Dereference(Add(a, 16))
            lhs = Dereference(a)
            rhs = Dereference(Add(a, 8))
            slhs = EmitVerilogHDL_SafeIdent(lhs)
            srhs = EmitVerilogHDL_SafeIdent(rhs)

            IfCondition EqualTo(kind, NLKind.ASSIGN_SEQ) ThenBlock: {
                VEmit.text = NL_TextAppend(VEmit.text, "      ")
                VEmit.text = NL_TextAppend(VEmit.text, slhs)
                VEmit.text = NL_TextAppend(VEmit.text, " <= ")
                VEmit.text = NL_TextAppend(VEmit.text, srhs)
                VEmit.text = NL_TextAppend(VEmit.text, ";\n")
            }
            // kind 2 = if begin
            IfCondition EqualTo(kind, 2) ThenBlock: {
                VEmit.text = NL_TextAppend(VEmit.text, "      if (")
                VEmit.text = NL_TextAppend(VEmit.text, srhs)
                VEmit.text = NL_TextAppend(VEmit.text, ") begin\n")
                if_depth = Add(if_depth, 1)
            }
            IfCondition EqualTo(kind, 3) ThenBlock: {
                VEmit.text = NL_TextAppend(VEmit.text, "      end else begin\n")
            }
            IfCondition EqualTo(kind, 4) ThenBlock: {
                VEmit.text = NL_TextAppend(VEmit.text, "      end\n")
                if_depth = Subtract(if_depth, 1)
            }
            ai = Add(ai, 1)
        }

        VEmit.text = NL_TextAppend(VEmit.text, "    end\n")
        VEmit.text = NL_TextAppend(VEmit.text, "  end\n")
    }
}

// =============================================================================
// HELPERS
// =============================================================================
// lhs is w + digits (temp net from NL_FreshWire)
Function.EmitVerilogHDL_IsTempWire {
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(GetByte(name, 0), 119) ThenBlock: {
            ReturnValue(0)  // 'w'
        }
        IfCondition EqualTo(GetByte(name, 1), 0) ThenBlock: {
            ReturnValue(0)
        }
        // rest mostly digits
        ReturnValue(1)
    }
}

Function.EmitVerilogHDL_HasBracket {
    Input: s: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(s, 0) ThenBlock: { ReturnValue(0) }
        i = 0
        WhileLoop NotEqual(GetByte(s, i), 0) {
            IfCondition EqualTo(GetByte(s, i), 91) ThenBlock: {
                ReturnValue(1)  // '['
            }
            i = Add(i, 1)
            IfCondition GreaterThan(i, 4096) ThenBlock: { ExitLoop }
        }
        ReturnValue(0)
    }
}

// "App.table[3]" → "App_table[3]"
Function.EmitVerilogHDL_SafeIndexRhs {
    Input: s: Address
    Output: Address
    Body: {
        IfCondition EqualTo(s, 0) ThenBlock: { ReturnValue("0") }
        // find '['
        br = 0
        WhileLoop NotEqual(GetByte(s, br), 0) {
            IfCondition EqualTo(GetByte(s, br), 91) ThenBlock: {
                ExitLoop
            }
            br = Add(br, 1)
        }
        // copy base, map dots
        base = Allocate(Add(br, 1))
        i = 0
        WhileLoop LessThan(i, br) {
            ch = GetByte(s, i)
            IfCondition EqualTo(ch, 46) ThenBlock: {
                SetByte(base, i, 95)
            } ElseBlock: {
                SetByte(base, i, ch)
            }
            i = Add(i, 1)
        }
        SetByte(base, br, 0)
        // append from [
        tail = ""
        // build tail manually
        tlen = 0
        WhileLoop NotEqual(GetByte(s, Add(br, tlen)), 0) {
            tlen = Add(tlen, 1)
        }
        tail = Allocate(Add(tlen, 1))
        j = 0
        WhileLoop LessThan(j, tlen) {
            SetByte(tail, j, GetByte(s, Add(br, j)))
            j = Add(j, 1)
        }
        SetByte(tail, tlen, 0)
        ReturnValue(StringConcat(base, tail))
    }
}

// True if this port name is a FixedPool field (output reg, not comb wire)
Function.EmitVerilogHDL_IsPoolPort {
    Input: safe_name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(safe_name, 0) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition EqualTo(NL.modules, 0) ThenBlock: {
            ReturnValue(0)
        }
        mc = Array.Size(NL.modules)
        mi = 0
        WhileLoop LessThan(mi, mc) {
            mod = Array.Get(NL.modules, mi)
            memories = NL_ModuleMemories(mod)
            IfCondition NotEqual(memories, 0) ThenBlock: {
                fc = Array.Size(memories)
                fi = 0
                WhileLoop LessThan(fi, fc) {
                    mem = Array.Get(memories, fi)
                    msafe = EmitVerilogHDL_SafeIdent(Dereference(mem))
                    IfCondition EqualTo(StringCompare(msafe, safe_name), 0) ThenBlock: {
                        ReturnValue(1)
                    }
                    fi = Add(fi, 1)
                }
            }
            mi = Add(mi, 1)
        }
        ReturnValue(0)
    }
}

// Replace '.' with '_' for Verilog identifiers
Function.EmitVerilogHDL_SafeIdent {
    Input: name: Address
    Output: Address
    Body: {
        IfCondition EqualTo(name, 0) ThenBlock: {
            ReturnValue("unnamed")
        }
        len = EmitVerilogHDL_StrLen(name)
        out = Allocate(Add(len, 1))
        i = 0
        WhileLoop LessThan(i, len) {
            ch = GetByte(name, i)
            // '.' = 46 → '_' = 95
            IfCondition EqualTo(ch, 46) ThenBlock: {
                SetByte(out, i, 95)
            } ElseBlock: {
                SetByte(out, i, ch)
            }
            i = Add(i, 1)
        }
        SetByte(out, len, 0)
        ReturnValue(out)
    }
}

Function.EmitVerilogHDL_StrLen {
    Input: s: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(s, 0) ThenBlock: {
            ReturnValue(0)
        }
        n = 0
        WhileLoop NotEqual(GetByte(s, n), 0) {
            n = Add(n, 1)
            // Safety cap
            IfCondition GreaterThan(n, 16777216) ThenBlock: {
                ExitLoop
            }
        }
        ReturnValue(n)
    }
}
