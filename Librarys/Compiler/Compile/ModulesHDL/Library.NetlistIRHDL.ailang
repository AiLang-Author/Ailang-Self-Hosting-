// Library.NetlistIRHDL.ailang
// Netlist intermediate representation for the AILang hardware backend.
// This is the "object code" for --target=hdl: a circuit graph, not machine bytes.
// Location: Librarys/Compiler/Compile/ModulesHDL/Library.NetlistIRHDL.ailang
//
// Layout
//   FixedPool.NL          — global builder state
//   Module entry  (48 B)  — name, ports, cells, nets, memories, kind
//   Memory entry  (56 B)  — name, width, depth, init, pool, field
//   Port entry    (32 B)  — name, dir, width, net_id
//   Cell entry    (48 B)  — id, kind, name, params, conns, width
//   Net entry     (32 B)  — id, name, width, driver_cell
//
// No x86 emit. No ELF. Serializers live alongside this IR in ModulesHDL.

LibraryImport.Arrays

// =============================================================================
// CONSTANTS
// =============================================================================
FixedPool.NLKind {
    "MODULE_TOP":    Initialize=1
    "MODULE_FUNC":   Initialize=2
    "MODULE_SUB":    Initialize=3
    "MODULE_TASK":   Initialize=4

    "PORT_IN":       Initialize=1
    "PORT_OUT":      Initialize=2
    "PORT_INOUT":    Initialize=3
    "PORT_CLOCK":    Initialize=4
    "PORT_RESET":    Initialize=5

    "CELL_CONST":    Initialize=1
    "CELL_WIRE":     Initialize=2
    "CELL_DFF":      Initialize=3
    "CELL_ADD":      Initialize=4
    "CELL_SUB":      Initialize=5
    "CELL_MUX":      Initialize=6
    "CELL_MEM":      Initialize=7
    "CELL_BUF":      Initialize=8
    "CELL_INSTANCE": Initialize=9
    "CELL_MUL":      Initialize=10
    "CELL_DIV":      Initialize=11
    "CELL_EQ":       Initialize=12
    "CELL_NE":       Initialize=13
    "CELL_LT":       Initialize=14
    "CELL_GT":       Initialize=15
    "CELL_LE":       Initialize=16
    "CELL_GE":       Initialize=17
    "CELL_AND":      Initialize=18
    "CELL_OR":       Initialize=19
    "CELL_NOT":      Initialize=20

    // Assign kinds (stored in assign entries, not cells)
    "ASSIGN_COMB":   Initialize=0
    "ASSIGN_SEQ":    Initialize=1
}

// Global netlist builder state — pure graph, zero machine-code buffers
FixedPool.NL {
    "modules":        Initialize=0, CanChange=True
    "current_module": Initialize=0, CanChange=True
    "next_net_id":    Initialize=1, CanChange=True
    "next_cell_id":   Initialize=1, CanChange=True
    "next_wire":      Initialize=1, CanChange=True
    "error":          Initialize=0, CanChange=True
    "error_msg":      Initialize=0, CanChange=True
    "error_line":     Initialize=0, CanChange=True
    "pool_count":     Initialize=0, CanChange=True
    "func_count":     Initialize=0, CanChange=True
    "sub_count":      Initialize=0, CanChange=True
    "task_count":     Initialize=0, CanChange=True
    "nodes_seen":     Initialize=0, CanChange=True
    "top_name":       Initialize=0, CanChange=True
    "initialized":    Initialize=0, CanChange=True
    // Last expression result: net/wire name string (for expr→stmt glue)
    "last_net":       Initialize=0, CanChange=True
    // 1 = inside clocked process (seq assigns); 0 = combinational
    "seq_mode":       Initialize=0, CanChange=True
}

// =============================================================================
// INTEGER → DECIMAL STRING (local; avoid pulling browser URL helpers)
// =============================================================================
Function.NL_IntToString {
    Input: val: Integer
    Output: Address
    Body: {
        IfCondition EqualTo(val, 0) ThenBlock: {
            z = Allocate(2)
            SetByte(z, 0, 48)
            SetByte(z, 1, 0)
            ReturnValue(z)
        }
        tmp = Allocate(24)
        ti = 0
        n = val
        neg = 0
        IfCondition LessThan(n, 0) ThenBlock: {
            neg = 1
            n = Subtract(0, n)
        }
        WhileLoop GreaterThan(n, 0) {
            digit = Subtract(n, Multiply(Divide(n, 10), 10))
            SetByte(tmp, ti, Add(48, digit))
            ti = Add(ti, 1)
            n = Divide(n, 10)
        }
        IfCondition EqualTo(neg, 1) ThenBlock: {
            SetByte(tmp, ti, 45)
            ti = Add(ti, 1)
        }
        buf = Allocate(Add(ti, 1))
        j = 0
        WhileLoop LessThan(j, ti) {
            SetByte(buf, j, GetByte(tmp, Subtract(Subtract(ti, 1), j)))
            j = Add(j, 1)
        }
        SetByte(buf, ti, 0)
        Deallocate(tmp, 0)
        ReturnValue(buf)
    }
}

// Append string to growing text buffer (inline concat pattern used elsewhere)
Function.NL_TextAppend {
    Input: dest: Address
    Input: piece: Address
    Output: Address
    Body: {
        IfCondition EqualTo(piece, 0) ThenBlock: {
            ReturnValue(dest)
        }
        IfCondition EqualTo(dest, 0) ThenBlock: {
            // Fresh copy so callers can free piece independently if needed
            ReturnValue(StringConcat("", piece))
        }
        temp = dest
        result = StringConcat(dest, piece)
        Deallocate(temp, 0)
        ReturnValue(result)
    }
}

// =============================================================================
// INIT / FREE
// =============================================================================
Function.NL_Init {
    Output: Integer
    Body: {
        IfCondition NotEqual(NL.modules, 0) ThenBlock: {
            NL_Free()
        }
        NL.modules = Array.Create(64)
        NL.current_module = 0
        NL.next_net_id = 1
        NL.next_cell_id = 1
        NL.next_wire = 1
        NL.error = 0
        NL.error_msg = 0
        NL.error_line = 0
        NL.pool_count = 0
        NL.func_count = 0
        NL.sub_count = 0
        NL.task_count = 0
        NL.nodes_seen = 0
        NL.top_name = "ailang_top"
        NL.last_net = 0
        NL.seq_mode = 0
        NL.initialized = 1
        ReturnValue(1)
    }
}

Function.NL_Free {
    Body: {
        // Entries are process-lifetime for v1 (Arena); just drop the array handles.
        IfCondition NotEqual(NL.modules, 0) ThenBlock: {
            Array.Destroy(NL.modules)
        }
        NL.modules = 0
        NL.current_module = 0
        NL.initialized = 0
    }
}

Function.NL_Error {
    Input: msg: Address
    Input: line: Integer
    Body: {
        NL.error = 1
        NL.error_msg = msg
        NL.error_line = line
        PrintMessage("[HDL] ERROR")
        IfCondition GreaterThan(line, 0) ThenBlock: {
            PrintMessage(" line ")
            PrintNumber(line)
        }
        PrintMessage(": ")
        IfCondition NotEqual(msg, 0) ThenBlock: {
            PrintMessage(msg)
        }
        PrintMessage("\n")
    }
}

// =============================================================================
// MODULES
// Module entry (56 bytes):
//   [0]  name
//   [8]  ports    (XArray)
//   [16] cells    (XArray)
//   [24] nets     (XArray)
//   [32] memories (XArray)
//   [40] kind     (NLKind.MODULE_*)
//   [48] assigns  (XArray of assign entries)
// =============================================================================
Function.NL_CreateModule {
    Input: name: Address
    Input: kind: Integer
    Output: Address
    Body: {
        mod = Allocate(56)
        StoreValue(mod, name)
        StoreValue(Add(mod, 8), Array.Create(16))
        StoreValue(Add(mod, 16), Array.Create(64))
        StoreValue(Add(mod, 24), Array.Create(128))
        StoreValue(Add(mod, 32), Array.Create(64))
        StoreValue(Add(mod, 40), kind)
        StoreValue(Add(mod, 48), Array.Create(128))
        Array.Push(NL.modules, mod)
        ReturnValue(mod)
    }
}

Function.NL_SetCurrentModule {
    Input: mod: Address
    Body: {
        NL.current_module = mod
    }
}

Function.NL_GetCurrentModule {
    Output: Address
    Body: {
        ReturnValue(NL.current_module)
    }
}

Function.NL_FindModule {
    Input: name: Address
    Output: Address
    Body: {
        IfCondition EqualTo(NL.modules, 0) ThenBlock: {
            ReturnValue(0)
        }
        count = Array.Size(NL.modules)
        i = 0
        WhileLoop LessThan(i, count) {
            mod = Array.Get(NL.modules, i)
            mname = Dereference(mod)
            IfCondition EqualTo(StringCompare(mname, name), 0) ThenBlock: {
                ReturnValue(mod)
            }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

Function.NL_ModuleName {
    Input: mod: Address
    Output: Address
    Body: {
        IfCondition EqualTo(mod, 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(Dereference(mod))
    }
}

Function.NL_ModulePorts {
    Input: mod: Address
    Output: Address
    Body: {
        IfCondition EqualTo(mod, 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(Dereference(Add(mod, 8)))
    }
}

Function.NL_ModuleCells {
    Input: mod: Address
    Output: Address
    Body: {
        IfCondition EqualTo(mod, 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(Dereference(Add(mod, 16)))
    }
}

Function.NL_ModuleNets {
    Input: mod: Address
    Output: Address
    Body: {
        IfCondition EqualTo(mod, 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(Dereference(Add(mod, 24)))
    }
}

Function.NL_ModuleMemories {
    Input: mod: Address
    Output: Address
    Body: {
        IfCondition EqualTo(mod, 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(Dereference(Add(mod, 32)))
    }
}

Function.NL_ModuleKind {
    Input: mod: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(mod, 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(Dereference(Add(mod, 40)))
    }
}

Function.NL_ModuleAssigns {
    Input: mod: Address
    Output: Address
    Body: {
        IfCondition EqualTo(mod, 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(Dereference(Add(mod, 48)))
    }
}

// Ensure a top-level container module exists (holds FixedPool memories)
Function.NL_EnsureTop {
    Output: Address
    Body: {
        top = NL_FindModule(NL.top_name)
        IfCondition EqualTo(top, 0) ThenBlock: {
            top = NL_CreateModule(NL.top_name, NLKind.MODULE_TOP)
            // Default clock / reset ports for sequential regions later
            NL_AddPort(top, "clk", NLKind.PORT_CLOCK, 1)
            NL_AddPort(top, "rst", NLKind.PORT_RESET, 1)
        }
        NL_SetCurrentModule(top)
        ReturnValue(top)
    }
}

// =============================================================================
// PORTS
// Port entry (32 bytes):
//   [0]  name
//   [8]  dir
//   [16] width
//   [24] net_id
// =============================================================================
Function.NL_AddPort {
    Input: mod: Address
    Input: name: Address
    Input: dir: Integer
    Input: width: Integer
    Output: Address
    Body: {
        IfCondition EqualTo(mod, 0) ThenBlock: {
            ReturnValue(0)
        }
        port = Allocate(32)
        net_id = NL.next_net_id
        NL.next_net_id = Add(NL.next_net_id, 1)
        StoreValue(port, name)
        StoreValue(Add(port, 8), dir)
        StoreValue(Add(port, 16), width)
        StoreValue(Add(port, 24), net_id)
        ports = NL_ModulePorts(mod)
        Array.Push(ports, port)
        // Mirror as a named net
        NL_AddNet(mod, name, width)
        ReturnValue(port)
    }
}

// =============================================================================
// MEMORIES (from FixedPool fields)
// Memory entry (56 bytes):
//   [0]  full_name   ("Pool.field")
//   [8]  width_bits
//   [16] depth
//   [24] init_value
//   [32] pool_name
//   [40] field_name
//   [48] is_string_init
// =============================================================================
// Create memory shell (≤6 args — AIlang call ABI is register-limited).
// Fill remaining fields with NL_MemorySetMeta / NL_MemorySetInit.
Function.NL_AddMemory {
    Input: mod: Address
    Input: full_name: Address
    Input: width_bits: Integer
    Input: depth: Integer
    Input: init_value: Integer
    Output: Address
    Body: {
        IfCondition EqualTo(mod, 0) ThenBlock: {
            ReturnValue(0)
        }
        mem = Allocate(56)
        StoreValue(mem, full_name)
        StoreValue(Add(mem, 8), width_bits)
        StoreValue(Add(mem, 16), depth)
        StoreValue(Add(mem, 24), init_value)
        StoreValue(Add(mem, 32), 0)
        StoreValue(Add(mem, 40), 0)
        StoreValue(Add(mem, 48), 0)
        memories = NL_ModuleMemories(mod)
        Array.Push(memories, mem)
        ReturnValue(mem)
    }
}

Function.NL_MemorySetMeta {
    Input: mem: Address
    Input: pool_name: Address
    Input: field_name: Address
    Input: is_string_init: Integer
    Body: {
        IfCondition EqualTo(mem, 0) ThenBlock: {
            ReturnValue(0)
        }
        StoreValue(Add(mem, 32), pool_name)
        StoreValue(Add(mem, 40), field_name)
        StoreValue(Add(mem, 48), is_string_init)
    }
}

// =============================================================================
// NETS
// Net entry (32 bytes):
//   [0]  id
//   [8]  name
//   [16] width
//   [24] driver_cell_id  (0 = undriven / port)
// =============================================================================
Function.NL_AddNet {
    Input: mod: Address
    Input: name: Address
    Input: width: Integer
    Output: Address
    Body: {
        IfCondition EqualTo(mod, 0) ThenBlock: {
            ReturnValue(0)
        }
        net = Allocate(32)
        id = NL.next_net_id
        NL.next_net_id = Add(NL.next_net_id, 1)
        StoreValue(net, id)
        StoreValue(Add(net, 8), name)
        StoreValue(Add(net, 16), width)
        StoreValue(Add(net, 24), 0)
        nets = NL_ModuleNets(mod)
        Array.Push(nets, net)
        ReturnValue(net)
    }
}

// =============================================================================
// CELLS
// Cell entry (64 bytes):
//   [0]  id
//   [8]  kind
//   [16] name       (lhs / instance / wire out name)
//   [24] param0     (e.g. const value)
//   [32] param1
//   [40] width
//   [48] op_a       (string net name, optional)
//   [56] op_b       (string net name, optional)
// =============================================================================
Function.NL_AddCell {
    Input: mod: Address
    Input: kind: Integer
    Input: name: Address
    Input: param0: Integer
    Input: param1: Integer
    Input: width: Integer
    Output: Address
    Body: {
        IfCondition EqualTo(mod, 0) ThenBlock: {
            ReturnValue(0)
        }
        cell = Allocate(64)
        id = NL.next_cell_id
        NL.next_cell_id = Add(NL.next_cell_id, 1)
        StoreValue(cell, id)
        StoreValue(Add(cell, 8), kind)
        StoreValue(Add(cell, 16), name)
        StoreValue(Add(cell, 24), param0)
        StoreValue(Add(cell, 32), param1)
        StoreValue(Add(cell, 40), width)
        StoreValue(Add(cell, 48), 0)
        StoreValue(Add(cell, 56), 0)
        cells = NL_ModuleCells(mod)
        Array.Push(cells, cell)
        ReturnValue(cell)
    }
}

Function.NL_CellSetOps {
    Input: cell: Address
    Input: op_a: Address
    Input: op_b: Address
    Body: {
        IfCondition EqualTo(cell, 0) ThenBlock: {
            ReturnValue(0)
        }
        StoreValue(Add(cell, 48), op_a)
        StoreValue(Add(cell, 56), op_b)
    }
}

// =============================================================================
// ASSIGNS
// Assign entry (32 bytes):
//   [0]  lhs   (string)
//   [8]  rhs   (string — net or expression fragment)
//   [16] kind  (ASSIGN_COMB / ASSIGN_SEQ)
//   [24] width
// =============================================================================
Function.NL_AddAssign {
    Input: mod: Address
    Input: lhs: Address
    Input: rhs: Address
    Input: kind: Integer
    Input: width: Integer
    Output: Address
    Body: {
        IfCondition EqualTo(mod, 0) ThenBlock: {
            ReturnValue(0)
        }
        a = Allocate(32)
        StoreValue(a, lhs)
        StoreValue(Add(a, 8), rhs)
        StoreValue(Add(a, 16), kind)
        StoreValue(Add(a, 24), width)
        assigns = NL_ModuleAssigns(mod)
        IfCondition EqualTo(assigns, 0) ThenBlock: {
            // Older module shells from discover — create assigns array
            assigns = Array.Create(128)
            StoreValue(Add(mod, 48), assigns)
        }
        Array.Push(assigns, a)
        ReturnValue(a)
    }
}

// Fresh temp wire name: w1, w2, ...
Function.NL_FreshWire {
    Output: Address
    Body: {
        n = NL.next_wire
        NL.next_wire = Add(NL.next_wire, 1)
        ReturnValue(StringConcat("w", NL_IntToString(n)))
    }
}

// Safe ident: dots → underscores (shared by expr/emit)
Function.NL_SafeIdent {
    Input: name: Address
    Output: Address
    Body: {
        IfCondition EqualTo(name, 0) ThenBlock: {
            ReturnValue("unnamed")
        }
        // count length
        len = 0
        WhileLoop NotEqual(GetByte(name, len), 0) {
            len = Add(len, 1)
            IfCondition GreaterThan(len, 4096) ThenBlock: {
                ExitLoop
            }
        }
        out = Allocate(Add(len, 1))
        i = 0
        WhileLoop LessThan(i, len) {
            ch = GetByte(name, i)
            IfCondition EqualTo(ch, 46) ThenBlock: {
                SetByte(out, i, 95)
            } ElseBlock: {
                SetByte(out, i, ch)
            }
            i = Add(i, 1)
        }
        SetByte(out, len, 0)
        ReturnValue(out)
    }
}

// Look up FixedPool memory by full name "Pool.field" across all modules
Function.NL_FindMemory {
    Input: full_name: Address
    Output: Address
    Body: {
        IfCondition EqualTo(NL.modules, 0) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition EqualTo(full_name, 0) ThenBlock: {
            ReturnValue(0)
        }
        mc = Array.Size(NL.modules)
        mi = 0
        WhileLoop LessThan(mi, mc) {
            mod = Array.Get(NL.modules, mi)
            memories = NL_ModuleMemories(mod)
            IfCondition NotEqual(memories, 0) ThenBlock: {
                fc = Array.Size(memories)
                fi = 0
                WhileLoop LessThan(fi, fc) {
                    mem = Array.Get(memories, fi)
                    mname = Dereference(mem)
                    IfCondition EqualTo(StringCompare(mname, full_name), 0) ThenBlock: {
                        ReturnValue(mem)
                    }
                    fi = Add(fi, 1)
                }
            }
            mi = Add(mi, 1)
        }
        ReturnValue(0)
    }
}

// Binop sugar: create out wire + CELL + set ops; returns out wire name
Function.NL_EmitBinop {
    Input: mod: Address
    Input: kind: Integer
    Input: op_a: Address
    Input: op_b: Address
    Input: width: Integer
    Output: Address
    Body: {
        out = NL_FreshWire()
        cell = NL_AddCell(mod, kind, out, 0, 0, width)
        NL_CellSetOps(cell, op_a, op_b)
        NL.last_net = out
        ReturnValue(out)
    }
}

// Const sugar: wire driven by integer constant
Function.NL_EmitConst {
    Input: mod: Address
    Input: value: Integer
    Input: width: Integer
    Output: Address
    Body: {
        out = NL_FreshWire()
        cell = NL_AddCell(mod, NLKind.CELL_CONST, out, value, 0, width)
        NL.last_net = out
        ReturnValue(out)
    }
}

// =============================================================================
// STATS
// =============================================================================
Function.NL_PrintStats {
    Body: {
        PrintMessage("[HDL NETLIST]\n")
        PrintMessage("  modules:  ")
        IfCondition EqualTo(NL.modules, 0) ThenBlock: {
            PrintNumber(0)
        } ElseBlock: {
            PrintNumber(Array.Size(NL.modules))
        }
        PrintMessage("\n")
        PrintMessage("  pools:    ")
        PrintNumber(NL.pool_count)
        PrintMessage("\n")
        PrintMessage("  funcs:    ")
        PrintNumber(NL.func_count)
        PrintMessage("\n")
        PrintMessage("  subs:     ")
        PrintNumber(NL.sub_count)
        PrintMessage("\n")
        PrintMessage("  tasks:    ")
        PrintNumber(NL.task_count)
        PrintMessage("\n")
        PrintMessage("  nodes:    ")
        PrintNumber(NL.nodes_seen)
        PrintMessage("\n")
        IfCondition EqualTo(NL.error, 1) ThenBlock: {
            PrintMessage("  ERRORS:   yes\n")
        }
    }
}
