// Library.NetlistPrimsHDL.ailang
// =============================================================================
// NETLIST PRIMITIVE API  —  the HDL peer of CodeEmit/X86 (X86_*)
// =============================================================================
//
// Product rule
//   ModulesHDL generators resolve the clean AILang AST to THIS API only.
//   They do not invent ad-hoc Verilog fragments or scatter raw cell opcodes.
//   Serializers (EmitVerilog / EmitJson) and Yosys own techmap after emit.
//
// Stack (parallel to x86)
//   Frontend AST  →  ModulesHDL (CCompile*HDL)  →  NL_Prim_*  →  Netlist IR
//                 →  EmitVerilog / .nl.json      →  Yosys simlib/techmap/techlibs
//
// Yosys owns the heavy library (share/yosys/simlib.v, techmap.v, ice40/, …).
// We meet it maximally: every primitive here has a stable NLKind + Yosys $name
// where one exists. AILang-only sugar (CONST, INSTANCE, print channel) is marked.
//
// Location: Librarys/Compiler/Compile/ModulesHDL/Library.NetlistPrimsHDL.ailang
//
// -----------------------------------------------------------------------------
// API LIST (call these from Modules)
// -----------------------------------------------------------------------------
//
// Resolve / metadata
//   NL_Prim_KindFromCallName(name) → kind | 0
//   NL_Prim_Arity(kind)            → 0 const / 1 unary / 2 binary / 3 mux / -1 special
//   NL_Prim_YosysName(kind)        → "$add" | "" if not a $cell
//   NL_Prim_ShortName(kind)        → "add"
//   NL_Prim_IsYosysNative(kind)    → 1/0
//   NL_Prim_PrintCatalog()         → debug dump of full table
//
// Emit (return out-net name string; sets NL.last_net)
//   NL_Prim_Emit(mod, kind, a, b, width)   generic binary/unary
//   NL_Prim_Const(mod, value, width)
//   NL_Prim_Add / Sub / Mul / Div / Mod
//   NL_Prim_Eq / Ne / Lt / Gt / Le / Ge
//   NL_Prim_And / Or / Xor / Xnor / Not / Neg
//   NL_Prim_LogicAnd / LogicOr / LogicNot
//   NL_Prim_Shl / Shr / Sshl / Sshr
//   NL_Prim_Mux(mod, sel, a, b, width)     $mux (sel in op_a, a in op_b; b via param note)
//   NL_Prim_Buf / Pos
//   NL_Prim_ReduceAnd / ReduceOr / ReduceXor
//   NL_Prim_Dff / Mem                  storage markers (pool path)
//   NL_Prim_Lut                        multi-way table (preferred over if-chains)
//
// AILang call names → prims (KindFromCallName)
//   Add Subtract Multiply Divide Modulo Negate
//   EqualTo NotEqual LessThan GreaterThan LessEqual GreaterEqual
//   And Or Not  (logical forms → $logic_* when used as conditions; bitwise via Bit*)
//   BitwiseAnd BitwiseOr BitwiseXor BitwiseNot
//   ShiftLeft LeftShift ShiftRight RightShift
//
// Yosys $cells intentionally deferred to later techmap / vendor packs
//   $alu $fa $lcu $macc $mem_v2 $dffe $adff …  — emit structural first; Yosys expands
//
// -----------------------------------------------------------------------------

LibraryImport.Compiler.Compile.ModulesHDL.NetlistIRHDL

// =============================================================================
// METADATA
// =============================================================================

// Arity of a cell kind: 0=const/none, 1=unary (A→Y), 2=binary (A,B→Y),
// 3=ternary mux, -1=special (mem/instance/lut fabric).
Function.NL_Prim_Arity {
    Input: kind: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(kind, NLKind.CELL_CONST) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(kind, NLKind.CELL_WIRE) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(kind, NLKind.CELL_INSTANCE) ThenBlock: { ReturnValue(-1) }
        IfCondition EqualTo(kind, NLKind.CELL_MEM) ThenBlock: { ReturnValue(-1) }
        IfCondition EqualTo(kind, NLKind.CELL_DFF) ThenBlock: { ReturnValue(-1) }
        IfCondition EqualTo(kind, NLKind.CELL_LUT) ThenBlock: { ReturnValue(-1) }
        IfCondition EqualTo(kind, NLKind.CELL_MUX) ThenBlock: { ReturnValue(3) }
        IfCondition EqualTo(kind, NLKind.CELL_PMUX) ThenBlock: { ReturnValue(3) }

        // Unary
        IfCondition EqualTo(kind, NLKind.CELL_NOT) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(kind, NLKind.CELL_NEG) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(kind, NLKind.CELL_BUF) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(kind, NLKind.CELL_POS) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(kind, NLKind.CELL_LOGIC_NOT) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(kind, NLKind.CELL_REDUCE_AND) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(kind, NLKind.CELL_REDUCE_OR) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(kind, NLKind.CELL_REDUCE_XOR) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(kind, NLKind.CELL_SLICE) ThenBlock: { ReturnValue(1) }

        // Known binary set
        IfCondition EqualTo(kind, NLKind.CELL_ADD) ThenBlock: { ReturnValue(2) }
        IfCondition EqualTo(kind, NLKind.CELL_SUB) ThenBlock: { ReturnValue(2) }
        IfCondition EqualTo(kind, NLKind.CELL_MUL) ThenBlock: { ReturnValue(2) }
        IfCondition EqualTo(kind, NLKind.CELL_DIV) ThenBlock: { ReturnValue(2) }
        IfCondition EqualTo(kind, NLKind.CELL_MOD) ThenBlock: { ReturnValue(2) }
        IfCondition EqualTo(kind, NLKind.CELL_EQ) ThenBlock: { ReturnValue(2) }
        IfCondition EqualTo(kind, NLKind.CELL_NE) ThenBlock: { ReturnValue(2) }
        IfCondition EqualTo(kind, NLKind.CELL_LT) ThenBlock: { ReturnValue(2) }
        IfCondition EqualTo(kind, NLKind.CELL_GT) ThenBlock: { ReturnValue(2) }
        IfCondition EqualTo(kind, NLKind.CELL_LE) ThenBlock: { ReturnValue(2) }
        IfCondition EqualTo(kind, NLKind.CELL_GE) ThenBlock: { ReturnValue(2) }
        IfCondition EqualTo(kind, NLKind.CELL_AND) ThenBlock: { ReturnValue(2) }
        IfCondition EqualTo(kind, NLKind.CELL_OR) ThenBlock: { ReturnValue(2) }
        IfCondition EqualTo(kind, NLKind.CELL_XOR) ThenBlock: { ReturnValue(2) }
        IfCondition EqualTo(kind, NLKind.CELL_XNOR) ThenBlock: { ReturnValue(2) }
        IfCondition EqualTo(kind, NLKind.CELL_LOGIC_AND) ThenBlock: { ReturnValue(2) }
        IfCondition EqualTo(kind, NLKind.CELL_LOGIC_OR) ThenBlock: { ReturnValue(2) }
        IfCondition EqualTo(kind, NLKind.CELL_SHL) ThenBlock: { ReturnValue(2) }
        IfCondition EqualTo(kind, NLKind.CELL_SHR) ThenBlock: { ReturnValue(2) }
        IfCondition EqualTo(kind, NLKind.CELL_SSHL) ThenBlock: { ReturnValue(2) }
        IfCondition EqualTo(kind, NLKind.CELL_SSHR) ThenBlock: { ReturnValue(2) }
        IfCondition EqualTo(kind, NLKind.CELL_CONCAT) ThenBlock: { ReturnValue(2) }

        ReturnValue(-1)
    }
}

// Yosys RTLIL internal cell name (simlib.v). Empty string = not a $cell.
Function.NL_Prim_YosysName {
    Input: kind: Integer
    Output: Address
    Body: {
        IfCondition EqualTo(kind, NLKind.CELL_ADD) ThenBlock: { ReturnValue("$add") }
        IfCondition EqualTo(kind, NLKind.CELL_SUB) ThenBlock: { ReturnValue("$sub") }
        IfCondition EqualTo(kind, NLKind.CELL_MUL) ThenBlock: { ReturnValue("$mul") }
        IfCondition EqualTo(kind, NLKind.CELL_DIV) ThenBlock: { ReturnValue("$div") }
        IfCondition EqualTo(kind, NLKind.CELL_MOD) ThenBlock: { ReturnValue("$mod") }
        IfCondition EqualTo(kind, NLKind.CELL_EQ) ThenBlock: { ReturnValue("$eq") }
        IfCondition EqualTo(kind, NLKind.CELL_NE) ThenBlock: { ReturnValue("$ne") }
        IfCondition EqualTo(kind, NLKind.CELL_LT) ThenBlock: { ReturnValue("$lt") }
        IfCondition EqualTo(kind, NLKind.CELL_GT) ThenBlock: { ReturnValue("$gt") }
        IfCondition EqualTo(kind, NLKind.CELL_LE) ThenBlock: { ReturnValue("$le") }
        IfCondition EqualTo(kind, NLKind.CELL_GE) ThenBlock: { ReturnValue("$ge") }
        IfCondition EqualTo(kind, NLKind.CELL_AND) ThenBlock: { ReturnValue("$and") }
        IfCondition EqualTo(kind, NLKind.CELL_OR) ThenBlock: { ReturnValue("$or") }
        IfCondition EqualTo(kind, NLKind.CELL_XOR) ThenBlock: { ReturnValue("$xor") }
        IfCondition EqualTo(kind, NLKind.CELL_XNOR) ThenBlock: { ReturnValue("$xnor") }
        IfCondition EqualTo(kind, NLKind.CELL_NOT) ThenBlock: { ReturnValue("$not") }
        IfCondition EqualTo(kind, NLKind.CELL_NEG) ThenBlock: { ReturnValue("$neg") }
        IfCondition EqualTo(kind, NLKind.CELL_BUF) ThenBlock: { ReturnValue("$buf") }
        IfCondition EqualTo(kind, NLKind.CELL_POS) ThenBlock: { ReturnValue("$pos") }
        IfCondition EqualTo(kind, NLKind.CELL_LOGIC_AND) ThenBlock: { ReturnValue("$logic_and") }
        IfCondition EqualTo(kind, NLKind.CELL_LOGIC_OR) ThenBlock: { ReturnValue("$logic_or") }
        IfCondition EqualTo(kind, NLKind.CELL_LOGIC_NOT) ThenBlock: { ReturnValue("$logic_not") }
        IfCondition EqualTo(kind, NLKind.CELL_SHL) ThenBlock: { ReturnValue("$shl") }
        IfCondition EqualTo(kind, NLKind.CELL_SHR) ThenBlock: { ReturnValue("$shr") }
        IfCondition EqualTo(kind, NLKind.CELL_SSHL) ThenBlock: { ReturnValue("$sshl") }
        IfCondition EqualTo(kind, NLKind.CELL_SSHR) ThenBlock: { ReturnValue("$sshr") }
        IfCondition EqualTo(kind, NLKind.CELL_MUX) ThenBlock: { ReturnValue("$mux") }
        IfCondition EqualTo(kind, NLKind.CELL_PMUX) ThenBlock: { ReturnValue("$pmux") }
        IfCondition EqualTo(kind, NLKind.CELL_LUT) ThenBlock: { ReturnValue("$lut") }
        IfCondition EqualTo(kind, NLKind.CELL_DFF) ThenBlock: { ReturnValue("$dff") }
        IfCondition EqualTo(kind, NLKind.CELL_MEM) ThenBlock: { ReturnValue("$mem") }
        IfCondition EqualTo(kind, NLKind.CELL_SLICE) ThenBlock: { ReturnValue("$slice") }
        IfCondition EqualTo(kind, NLKind.CELL_CONCAT) ThenBlock: { ReturnValue("$concat") }
        IfCondition EqualTo(kind, NLKind.CELL_REDUCE_AND) ThenBlock: { ReturnValue("$reduce_and") }
        IfCondition EqualTo(kind, NLKind.CELL_REDUCE_OR) ThenBlock: { ReturnValue("$reduce_or") }
        IfCondition EqualTo(kind, NLKind.CELL_REDUCE_XOR) ThenBlock: { ReturnValue("$reduce_xor") }
        // CONST / WIRE / INSTANCE — AILang IR only
        ReturnValue("")
    }
}

Function.NL_Prim_IsYosysNative {
    Input: kind: Integer
    Output: Integer
    Body: {
        n = NL_Prim_YosysName(kind)
        IfCondition EqualTo(n, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(GetByte(n, 0), 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(1)
    }
}

// Short name for JSON / logs (no $)
Function.NL_Prim_ShortName {
    Input: kind: Integer
    Output: Address
    Body: {
        IfCondition EqualTo(kind, NLKind.CELL_CONST) ThenBlock: { ReturnValue("const") }
        IfCondition EqualTo(kind, NLKind.CELL_WIRE) ThenBlock: { ReturnValue("wire") }
        IfCondition EqualTo(kind, NLKind.CELL_INSTANCE) ThenBlock: { ReturnValue("instance") }
        ys = NL_Prim_YosysName(kind)
        IfCondition NotEqual(ys, 0) ThenBlock: {
            IfCondition NotEqual(GetByte(ys, 0), 0) ThenBlock: {
                // strip leading '$'
                IfCondition EqualTo(GetByte(ys, 0), 36) ThenBlock: {
                    ReturnValue(Add(ys, 1))
                }
                ReturnValue(ys)
            }
        }
        ReturnValue("unknown")
    }
}

// =============================================================================
// AILang CALL NAME → CELL KIND
// Clean AST: CALL nodes carry the builtin name; we resolve once here.
// =============================================================================
Function.NL_Prim_KindFromCallName {
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }

        // Arithmetic
        IfCondition EqualTo(StringCompare(name, "Add"), 0) ThenBlock: { ReturnValue(NLKind.CELL_ADD) }
        IfCondition EqualTo(StringCompare(name, "Subtract"), 0) ThenBlock: { ReturnValue(NLKind.CELL_SUB) }
        IfCondition EqualTo(StringCompare(name, "Multiply"), 0) ThenBlock: { ReturnValue(NLKind.CELL_MUL) }
        IfCondition EqualTo(StringCompare(name, "Divide"), 0) ThenBlock: { ReturnValue(NLKind.CELL_DIV) }
        IfCondition EqualTo(StringCompare(name, "Modulo"), 0) ThenBlock: { ReturnValue(NLKind.CELL_MOD) }
        IfCondition EqualTo(StringCompare(name, "Negate"), 0) ThenBlock: { ReturnValue(NLKind.CELL_NEG) }

        // Compare
        IfCondition EqualTo(StringCompare(name, "EqualTo"), 0) ThenBlock: { ReturnValue(NLKind.CELL_EQ) }
        IfCondition EqualTo(StringCompare(name, "NotEqual"), 0) ThenBlock: { ReturnValue(NLKind.CELL_NE) }
        IfCondition EqualTo(StringCompare(name, "LessThan"), 0) ThenBlock: { ReturnValue(NLKind.CELL_LT) }
        IfCondition EqualTo(StringCompare(name, "GreaterThan"), 0) ThenBlock: { ReturnValue(NLKind.CELL_GT) }
        IfCondition EqualTo(StringCompare(name, "LessEqual"), 0) ThenBlock: { ReturnValue(NLKind.CELL_LE) }
        IfCondition EqualTo(StringCompare(name, "GreaterEqual"), 0) ThenBlock: { ReturnValue(NLKind.CELL_GE) }

        // Logical (condition form) → Yosys $logic_*
        IfCondition EqualTo(StringCompare(name, "And"), 0) ThenBlock: { ReturnValue(NLKind.CELL_LOGIC_AND) }
        IfCondition EqualTo(StringCompare(name, "Or"), 0) ThenBlock: { ReturnValue(NLKind.CELL_LOGIC_OR) }
        IfCondition EqualTo(StringCompare(name, "Not"), 0) ThenBlock: { ReturnValue(NLKind.CELL_LOGIC_NOT) }

        // Bitwise
        IfCondition EqualTo(StringCompare(name, "BitwiseAnd"), 0) ThenBlock: { ReturnValue(NLKind.CELL_AND) }
        IfCondition EqualTo(StringCompare(name, "BitAnd"), 0) ThenBlock: { ReturnValue(NLKind.CELL_AND) }
        IfCondition EqualTo(StringCompare(name, "BitwiseOr"), 0) ThenBlock: { ReturnValue(NLKind.CELL_OR) }
        IfCondition EqualTo(StringCompare(name, "BitOr"), 0) ThenBlock: { ReturnValue(NLKind.CELL_OR) }
        IfCondition EqualTo(StringCompare(name, "BitwiseXor"), 0) ThenBlock: { ReturnValue(NLKind.CELL_XOR) }
        IfCondition EqualTo(StringCompare(name, "BitXor"), 0) ThenBlock: { ReturnValue(NLKind.CELL_XOR) }
        IfCondition EqualTo(StringCompare(name, "BitwiseNot"), 0) ThenBlock: { ReturnValue(NLKind.CELL_NOT) }
        IfCondition EqualTo(StringCompare(name, "BitNot"), 0) ThenBlock: { ReturnValue(NLKind.CELL_NOT) }

        // Shifts
        IfCondition EqualTo(StringCompare(name, "ShiftLeft"), 0) ThenBlock: { ReturnValue(NLKind.CELL_SHL) }
        IfCondition EqualTo(StringCompare(name, "LeftShift"), 0) ThenBlock: { ReturnValue(NLKind.CELL_SHL) }
        IfCondition EqualTo(StringCompare(name, "ShiftRight"), 0) ThenBlock: { ReturnValue(NLKind.CELL_SHR) }
        IfCondition EqualTo(StringCompare(name, "RightShift"), 0) ThenBlock: { ReturnValue(NLKind.CELL_SHR) }

        ReturnValue(0)
    }
}

// =============================================================================
// GENERIC EMIT
// =============================================================================
Function.NL_Prim_Const {
    Input: mod: Address
    Input: value: Integer
    Input: width: Integer
    Output: Address
    Body: {
        ReturnValue(NL_EmitConst(mod, value, width))
    }
}

// Binary or unary (b may be 0 for unary). Uses IR builder; sets NL.last_net.
Function.NL_Prim_Emit {
    Input: mod: Address
    Input: kind: Integer
    Input: op_a: Address
    Input: op_b: Address
    Input: width: Integer
    Output: Address
    Body: {
        arity = NL_Prim_Arity(kind)
        IfCondition EqualTo(arity, 0) ThenBlock: {
            // Const should use NL_Prim_Const
            ReturnValue(0)
        }
        IfCondition EqualTo(arity, 1) ThenBlock: {
            out = NL_FreshWire()
            cell = NL_AddCell(mod, kind, out, 0, 0, width)
            NL_CellSetOps(cell, op_a, 0)
            NL.last_net = out
            ReturnValue(out)
        }
        IfCondition EqualTo(arity, 2) ThenBlock: {
            ReturnValue(NL_EmitBinop(mod, kind, op_a, op_b, width))
        }
        // mux / special — callers use dedicated helpers
        ReturnValue(0)
    }
}

