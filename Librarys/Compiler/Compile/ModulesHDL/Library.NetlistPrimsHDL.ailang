// $mux: out = sel ? t : f
// Cell layout v1: op_a=sel, op_b=t, param0 holds f as string pointer when possible.
// EmitVerilog understands CELL_MUX specially.
Function.NL_Prim_Mux {
    Input: mod: Address
    Input: sel: Address
    Input: t: Address
    Input: f: Address
    Input: width: Integer
    Output: Address
    Body: {
        out = NL_FreshWire()
        // param0 unused as int; store f pointer in op via third slot — use param1 as 0
        // and pack f into cell name side: set ops sel/t, store f as "name" is out.
        // Extend: put f string in a side-channel — for v1 use NL_CellSetOps(sel,t)
        // and a second cell note. Simpler: encode f as op via allocating 3-op later.
        // Use: op_a = sel, op_b = t, and append assign style via param0=0 + store f at
        // unused: we reuse param1 as pointer-sized? Integers only for params.
        // Practical v1: create out and binary-looking cell; EmitVerilog MUX reads
        // op_a as sel, op_b as t, and looks for connected "f_" + out wire — too fragile.
        // Instead: emit as comb: assign out = sel ? t : f via a CELL_MUX with
        // ops (sel, t) and name carrying both outs — store f in cell by allocating
        // extra field: for now push a fake binop then emit special-case uses op_a/op_b
        // and we store f string pointer by abusing: Add a third op via CellSetOps only 2.
        //
        // Decision: CELL_MUX stores sel in op_a, t in op_b; f is stored by creating
        // a linked const or we widen cell later. Temporary: f as second cell BUF named
        // out_f companion — skip. Emit structural string in param via... 
        //
        // Clean approach for 6-arg ABI: store f as the cell's "name" is out; put
        // f into a net that is the third connection recorded as assign.
        // Simplest correct path: build mux as two-level using existing cells:
        //   not_sel = ~sel; a1 = sel & t; a0 = not_sel & f; out = a1 | a0
        // That is fully primitive and Yosys-friendly.
        ns = NL_Prim_LogicNot(mod, sel, 1)
        a1 = NL_Prim_And(mod, sel, t, width)
        a0 = NL_Prim_And(mod, ns, f, width)
        ReturnValue(NL_Prim_Or(mod, a1, a0, width))
    }
}

// Storage markers (pool path already uses NL_AddCell; these wrap for API completeness)
Function.NL_Prim_Dff {
    Input: mod: Address
    Input: name: Address
    Input: init_value: Integer
    Input: width: Integer
    Output: Address
    Body: {
        ReturnValue(NL_AddCell(mod, NLKind.CELL_DFF, name, init_value, 0, width))
    }
}

Function.NL_Prim_Mem {
    Input: mod: Address
    Input: name: Address
    Input: depth: Integer
    Input: width: Integer
    Output: Address
    Body: {
        ReturnValue(NL_AddCell(mod, NLKind.CELL_MEM, name, depth, 0, width))
    }
}

// =============================================================================
// CATALOG DUMP (human + agent audit of maximal Yosys meet)
// =============================================================================
Function.NL_Prim_PrintOne {
    Input: kind: Integer
    Body: {
        PrintMessage("  ")
        PrintNumber(kind)
        PrintMessage("  ")
        PrintMessage(NL_Prim_ShortName(kind))
        PrintMessage("  yosys=")
        ys = NL_Prim_YosysName(kind)
        IfCondition Or(EqualTo(ys, 0), EqualTo(GetByte(ys, 0), 0)) ThenBlock: {
            PrintMessage("(ailang-ir)")
        } ElseBlock: {
            PrintMessage(ys)
        }
        PrintMessage("  arity=")
        PrintNumber(NL_Prim_Arity(kind))
        PrintMessage("\n")
    }
}

Function.NL_Prim_PrintCatalog {
    Body: {
        PrintMessage("[HDL] NetlistPrims catalog (AST → prim → Yosys $cell)\n")
        NL_Prim_PrintOne(NLKind.CELL_CONST)
        NL_Prim_PrintOne(NLKind.CELL_WIRE)
        NL_Prim_PrintOne(NLKind.CELL_BUF)
        NL_Prim_PrintOne(NLKind.CELL_POS)
        NL_Prim_PrintOne(NLKind.CELL_NOT)
        NL_Prim_PrintOne(NLKind.CELL_NEG)
        NL_Prim_PrintOne(NLKind.CELL_AND)
        NL_Prim_PrintOne(NLKind.CELL_OR)
        NL_Prim_PrintOne(NLKind.CELL_XOR)
        NL_Prim_PrintOne(NLKind.CELL_XNOR)
        NL_Prim_PrintOne(NLKind.CELL_ADD)
        NL_Prim_PrintOne(NLKind.CELL_SUB)
        NL_Prim_PrintOne(NLKind.CELL_MUL)
        NL_Prim_PrintOne(NLKind.CELL_DIV)
        NL_Prim_PrintOne(NLKind.CELL_MOD)
        NL_Prim_PrintOne(NLKind.CELL_EQ)
        NL_Prim_PrintOne(NLKind.CELL_NE)
        NL_Prim_PrintOne(NLKind.CELL_LT)
        NL_Prim_PrintOne(NLKind.CELL_GT)
        NL_Prim_PrintOne(NLKind.CELL_LE)
        NL_Prim_PrintOne(NLKind.CELL_GE)
        NL_Prim_PrintOne(NLKind.CELL_LOGIC_AND)
        NL_Prim_PrintOne(NLKind.CELL_LOGIC_OR)
        NL_Prim_PrintOne(NLKind.CELL_LOGIC_NOT)
        NL_Prim_PrintOne(NLKind.CELL_SHL)
        NL_Prim_PrintOne(NLKind.CELL_SHR)
        NL_Prim_PrintOne(NLKind.CELL_SSHL)
        NL_Prim_PrintOne(NLKind.CELL_SSHR)
        NL_Prim_PrintOne(NLKind.CELL_MUX)
        NL_Prim_PrintOne(NLKind.CELL_PMUX)
        NL_Prim_PrintOne(NLKind.CELL_LUT)
        NL_Prim_PrintOne(NLKind.CELL_DFF)
        NL_Prim_PrintOne(NLKind.CELL_MEM)
        NL_Prim_PrintOne(NLKind.CELL_SLICE)
        NL_Prim_PrintOne(NLKind.CELL_CONCAT)
        NL_Prim_PrintOne(NLKind.CELL_REDUCE_AND)
        NL_Prim_PrintOne(NLKind.CELL_REDUCE_OR)
        NL_Prim_PrintOne(NLKind.CELL_REDUCE_XOR)
        NL_Prim_PrintOne(NLKind.CELL_INSTANCE)
    }
}
