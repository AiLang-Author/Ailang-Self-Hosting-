// Library.CCompileDebug.ailang
// Debug statement compilation
// Location: Librarys/Compiler/Debug/Library.CCompileDebug.ailang
//
// Architecture:
//   - Compiles DEBUG_BLOCK, DEBUG_ASSERT, DEBUG_TRACE, DEBUG_BREAK
//   - Conditional compilation based on Dbg.level
//   - Stripped code emits NOP (zero overhead in production)
//   - All syscalls go through CSysDispatch for OS portability

LibraryImport.Arrays

LibraryImport.Compiler.Debug.CDebugTypes
LibraryImport.Compiler.Compile.Modules.CSysDispatch
LibraryImport.Compiler.Debug.X86.CEmitDebugX86

LibraryImport.Compiler.Frontend.AST.CASTTypes
LibraryImport.Compiler.Frontend.AST.CASTCore

LibraryImport.Compiler.CodeEmit.CEmitTypes
LibraryImport.Compiler.CodeEmit.CEmitCore
LibraryImport.Compiler.CodeEmit.CEmitCoreArch

LibraryImport.Compiler.Compile.Modules.CCompileStmt
LibraryImport.Compiler.Compile.CCompileMain

// =============================================================================
// INITIALIZATION
// Called from Compile_Init with command-line flags
// =============================================================================
Function.Debug_Init {
    Input: level: Integer
    Input: perf: Integer
    Body: {
        Dbg.level = level
        Dbg.perf_enabled = perf
        Dbg.assert_count = 0
        Dbg.block_count = 0
        Dbg.perf_count = 0
        Dbg.stripped_count = 0
        
        // Initialize perf tracking if enabled
        IfCondition EqualTo(perf, 1) ThenBlock: {
            Dbg.perf_slots = Array.Create(64)
            Dbg.perf_slot_count = 0
        }
        
        Dbg.initialized = 1
        
        IfCondition GreaterThan(level, 0) ThenBlock: {
            PrintMessage("[DEBUG] Debug system initialized at level ")
            PrintNumber(level)
            IfCondition EqualTo(perf, 1) ThenBlock: {
                PrintMessage(" with profiling")
            }
            PrintMessage("\n")
        }
    }
}

// =============================================================================
// CLEANUP
// =============================================================================
Function.Debug_Free {
    Body: {
        IfCondition NotEqual(Dbg.perf_slots, 0) ThenBlock: {
            // Free each slot
            i = 0
            WhileLoop LessThan(i, Dbg.perf_slot_count) {
                slot = Array.Get(Dbg.perf_slots, i)
                IfCondition NotEqual(slot, 0) ThenBlock: {
                    Deallocate(slot, PerfSlot.SIZE)
                }
                i = Add(i, 1)
            }
            Array.Destroy(Dbg.perf_slots)
            Dbg.perf_slots = 0
        }
        Dbg.initialized = 0
    }
}

// =============================================================================
// TRY COMPILE - Main dispatcher called from CCompileMain
// Returns 1 if handled, 0 to try other modules
// =============================================================================
Function.CompileDebug_TryCompile {
    Input: node: Address
    Output: Integer
    Body: {
        node_type = AST_GetType(node)
        
        IfCondition EqualTo(node_type, AST.DEBUG_BLOCK) ThenBlock: {
            CompileDebug_Block(node)
            ReturnValue(1)
        }
        
        IfCondition EqualTo(node_type, AST.DEBUG_ASSERT) ThenBlock: {
            CompileDebug_Assert(node)
            ReturnValue(1)
        }
        
        IfCondition EqualTo(node_type, AST.DEBUG_TRACE) ThenBlock: {
            CompileDebug_Trace(node)
            ReturnValue(1)
        }
        
        IfCondition EqualTo(node_type, AST.DEBUG_BREAK) ThenBlock: {
            CompileDebug_Break(node)
            ReturnValue(1)
        }
        
        IfCondition EqualTo(node_type, AST.DEBUG_PERF) ThenBlock: {
            CompileDebug_Perf(node)
            ReturnValue(1)
        }
        
        IfCondition EqualTo(node_type, AST.DEBUG_MEMORY) ThenBlock: {
           CompileDebug_Memory(node)
           ReturnValue(1)
        }

        ReturnValue(0)
    }
}

// =============================================================================
// DEBUG BLOCK
// Debug("label", level=N) { ... }
// Compiles body only if Dbg.level >= required level
// =============================================================================
Function.CompileDebug_Block {
    Input: node: Address
    Body: {
        label = AST_GetData1(node)
        required_level = AST_GetData2(node)
        
        // Default to level 1 if not specified (for parser compatibility)
        IfCondition EqualTo(required_level, 0) ThenBlock: {
            required_level = 1
        }
        
        // Check if this block should compile
        IfCondition LessThan(Dbg.level, required_level) ThenBlock: {
            // Below required level - strip the block
            Dbg.stripped_count = Add(Dbg.stripped_count, 1)
            // Emit single NOP as placeholder (can be removed entirely in optimizer)
            X86_Nop()
            ReturnValue(0)
        }
        
        Dbg.block_count = Add(Dbg.block_count, 1)
        
        // Optional: emit label marker for debugging
        IfCondition GreaterEqual(Dbg.level, 3) ThenBlock: {
            PrintMessage("[DEBUG BLOCK] Compiling: ")
            PrintString(label)
            PrintMessage(" (level ")
            PrintNumber(required_level)
            PrintMessage(")\n")
        }
        
        // Compile the body block
        body = AST_GetChild(node, 0)
        IfCondition NotEqual(body, 0) ThenBlock: {
            CompileStmt_Block(body)
        }
    }
}

/// =============================================================================
// DEBUG ASSERT
// DebugAssert(condition, "message")
// If condition false: print message and exit with code 1
// =============================================================================
Function.CompileDebug_Assert {
    Input: node: Address
    Body: {
        // Only compile if debug level >= 1 (BASIC)
        IfCondition LessThan(Dbg.level, DebugLevel.BASIC) ThenBlock: {
            Dbg.stripped_count = Add(Dbg.stripped_count, 1)
            X86_Nop()
            ReturnValue(0)
        }
        
        Dbg.assert_count = Add(Dbg.assert_count, 1)
        
        // Get condition (required) and optional message
        condition = AST_GetChild(node, 0)
        child_count = AST_GetChildCount(node)
        
        has_message = 0
        message = 0
        IfCondition GreaterEqual(child_count, 2) ThenBlock: {
            message = AST_GetChild(node, 1)
            has_message = 1
        }
        
        // Compile condition -> RAX
        Compile_Expression(condition)
        
        // TEST RAX, RAX
        Emit_TestRaxRax()
        
        // JNE pass_label (jump if condition is true/non-zero)
        pass_label = Compile_NewLabel()
        Emit_Jne(pass_label)
        
        // === Assertion failed path ===
        
        // Print "ASSERTION FAILED: " prefix (18 chars)
        prefix_offset = Emit_AddString("ASSERTION FAILED: ")
        Emit_MovRsiDataOffset(prefix_offset)
        Emit_MovRdxImm64(18)
        Emit_MovRdiImm64(1)
        Sys_Write()
        
        // Print user message if provided
        IfCondition EqualTo(has_message, 1) ThenBlock: {
            msg_type = AST_GetType(message)
            IfCondition EqualTo(msg_type, AST.STRING) ThenBlock: {
                // String literal - get value and length at compile time
                msg_str = AST_GetData1(message)
                msg_len = StringLength(msg_str)
                msg_offset = Emit_AddString(msg_str)
                Emit_MovRsiDataOffset(msg_offset)
                Emit_MovRdxImm64(msg_len)
                Emit_MovRdiImm64(1)
                Sys_Write()
            } ElseBlock: {
                // Expression - compile and print (runtime string)
                Compile_Expression(message)
                Emit_MovRsiRax()
                Emit_MovRdxImm64(256)
                Emit_MovRdiImm64(1)
                Sys_Write()
            }
        }
        
        // Print newline
        nl_offset = Emit_AddString("\n")
        Emit_MovRsiDataOffset(nl_offset)
        Emit_MovRdxImm64(1)
        Emit_MovRdiImm64(1)
        Sys_Write()
        
        // Exit with code 1
        Emit_MovRdiImm64(1)
        Sys_Exit()
        
        // === Assertion passed path ===
        Emit_MarkLabel(pass_label)
    }
}

// =============================================================================
// DEBUG TRACE (Placeholder - expand later)
// DebugTrace.Entry("func", args...)
// DebugTrace.Exit("func", return_value)
// DebugTrace.Point("label", value)
// =============================================================================
Function.CompileDebug_Trace {
    Input: node: Address
    Body: {
        // Only at level 2+ (TRACE)
        IfCondition LessThan(Dbg.level, DebugLevel.TRACE) ThenBlock: {
            Dbg.stripped_count = Add(Dbg.stripped_count, 1)
            X86_Nop()
            ReturnValue(0)
        }
        
        // TODO: Implement trace compilation
        X86_Nop()
    }
}

// =============================================================================
// DEBUG BREAK
// DebugBreak("label")
// Emits INT3 instruction - triggers debugger breakpoint
// =============================================================================
Function.CompileDebug_Break {
    Input: node: Address
    Body: {
        // Only at level 4 (FULL debug)
        IfCondition LessThan(Dbg.level, DebugLevel.FULL) ThenBlock: {
            Dbg.stripped_count = Add(Dbg.stripped_count, 1)
            X86_Nop()
            ReturnValue(0)
        }
        
        // Emit INT3
        X86_Int3()
    }
}


// =============================================================================
// DEBUG MEMORY - Unified dispatcher
// DebugMemory.Dump(addr, size, "label") - Hex dump
// DebugMemory.Pattern(addr, size, value) - Fill with pattern
// DebugMemory.Leak.Start() - Start leak tracking
// DebugMemory.Leak.Check() - Check for leaks
// =============================================================================
Function.CompileDebug_Memory {
    Input: node: Address
    Body: {
        // Check if debug level >= 3 (DETAILED)
        IfCondition LessThan(Dbg.level, DebugLevel.DETAILED) ThenBlock: {
            Dbg.stripped_count = Add(Dbg.stripped_count, 1)
            X86_Nop()
            ReturnValue(0)
        }
        
        variant = AST_GetData2(node)
        
        IfCondition EqualTo(variant, 1) ThenBlock: {
            CompileDebug_MemoryDump_Impl(node)
            ReturnValue(1)
        }
        
        IfCondition EqualTo(variant, 2) ThenBlock: {
            // Pattern - TODO
            X86_Nop()
            ReturnValue(1)
        }
        
        IfCondition EqualTo(variant, 3) ThenBlock: {
            // Leak.Start - TODO
            X86_Nop()
            ReturnValue(1)
        }
        
        IfCondition EqualTo(variant, 4) ThenBlock: {
            // Leak.Check - TODO
            X86_Nop()
            ReturnValue(1)
        }
        
        X86_Nop()
        ReturnValue(0)
    }
}

// =============================================================================
// MEMORY DUMP IMPLEMENTATION
// Emits code that prints hex dump at runtime
// Output format:
//   [DUMP] label (size bytes @ 0xADDR)
//   0xADDR: XX XX XX XX XX XX XX XX XX XX XX XX XX XX XX XX
// =============================================================================
Function.CompileDebug_MemoryDump_Impl {
    Input: node: Address
    Body: {
        label = AST_GetData1(node)
        addr_expr = AST_GetChild(node, 0)
        size_expr = AST_GetChild(node, 1)
        
        // Save callee-saved registers
        Emit_PushRbx()
        Emit_PushR12()
        Emit_PushR13()
        Emit_PushR14()
        Emit_PushR15()
        
        // Compile address -> RAX, save to R12
        Compile_Expression(addr_expr)
        Emit_MovR12Rax()
        
        // Compile size -> RAX, save to R13
        Compile_Expression(size_expr)
        Emit_MovR13Rax()
        
        // R14 = current offset (starts at 0)
        Emit_XorRegReg(Reg.R14, Reg.R14)
        
        // Print "[DUMP] "
        prefix_offset = Emit_AddString("[DUMP] ")
        Emit_MovRsiDataOffset(prefix_offset)
        Emit_MovRdxImm64(7)
        Emit_MovRdiImm64(1)
        Sys_Write()
        
        // Print label if provided
        IfCondition NotEqual(label, 0) ThenBlock: {
            label_offset = Emit_AddString(label)
            label_len = StringLength(label)
            Emit_MovRsiDataOffset(label_offset)
            Emit_MovRdxImm64(label_len)
            Emit_MovRdiImm64(1)
            Sys_Write()
        }
        
        // Print " ("
        paren_offset = Emit_AddString(" (")
        Emit_MovRsiDataOffset(paren_offset)
        Emit_MovRdxImm64(2)
        Emit_MovRdiImm64(1)
        Sys_Write()
        
        // Print size (R13) as decimal
        Emit_PushR12()
        Emit_PushR13()
        Emit_MovRaxR13()
        CompileDebug_PrintNumberInline()
        Emit_PopR13()
        Emit_PopR12()
        
        // Print " bytes @ 0x"
        bytes_offset = Emit_AddString(" bytes @ 0x")
        Emit_MovRsiDataOffset(bytes_offset)
        Emit_MovRdxImm64(11)
        Emit_MovRdiImm64(1)
        Sys_Write()
        
        // Print address (R12) as hex
        Emit_PushR12()
        Emit_PushR13()
        Emit_MovRaxR12()
        CompileDebug_PrintHexInline()
        Emit_PopR13()
        Emit_PopR12()
        
        // Print ")\n"
        close_offset = Emit_AddString(")\n")
        Emit_MovRsiDataOffset(close_offset)
        Emit_MovRdxImm64(2)
        Emit_MovRdiImm64(1)
        Sys_Write()
        
        // === Main dump loop ===
        // R12 = base address
        // R13 = total size
        // R14 = current offset
        
        row_loop = Emit_CreateLabel()
        row_done = Emit_CreateLabel()
        byte_loop = Emit_CreateLabel()
        byte_done = Emit_CreateLabel()
        
        Emit_MarkLabel(row_loop)
        
        // Check if done (R14 >= R13)
        Emit_CmpR14R13()
        Emit_Jge(row_done)
        
        // Print address prefix "0x"
        addr_prefix = Emit_AddString("0x")
        Emit_MovRsiDataOffset(addr_prefix)
        Emit_MovRdxImm64(2)
        Emit_MovRdiImm64(1)
        Sys_Write()
        
        // Print current address (R12 + R14) as hex
        Emit_PushR12()
        Emit_PushR13()
        Emit_PushR14()
        Emit_MovRaxR12()
        Emit_AddRaxR14()
        CompileDebug_PrintHexInline()
        Emit_PopR14()
        Emit_PopR13()
        Emit_PopR12()
        
        // Print ": "
        colon_offset = Emit_AddString(": ")
        Emit_MovRsiDataOffset(colon_offset)
        Emit_MovRdxImm64(2)
        Emit_MovRdiImm64(1)
        Sys_Write()
        
        // R15 = bytes to print this row (min(16, R13 - R14))
        Emit_MovRaxR13()
        Emit_SubRaxR14()
        Emit_CmpRaxImm8(16)
        row_less_16 = Emit_CreateLabel()
        row_set_count = Emit_CreateLabel()
        Emit_Jl(row_less_16)
        Emit_MovRaxImm64(16)
        Emit_Jmp(row_set_count)
        Emit_MarkLabel(row_less_16)
        Emit_MarkLabel(row_set_count)
        Emit_MovR15Rax()
        
        // RBX = byte counter for this row
        Emit_XorRbxRbx()
        
        Emit_MarkLabel(byte_loop)
        
        // Check if row done (RBX >= R15)
        Emit_CmpRbxR15()
        Emit_Jge(byte_done)
        
        // Load byte at [R12 + R14]
        Emit_MovRaxR12()
        Emit_AddRaxR14()
        Emit_MovzxRaxByteDerefRax()
        
        // Save RBX, R12-R15 for hex print
        Emit_PushRbx()
        Emit_PushR12()
        Emit_PushR13()
        Emit_PushR14()
        Emit_PushR15()
        
        // Print byte as 2-digit hex
        CompileDebug_PrintHexByteInline()
        
        // Print space
        space_offset = Emit_AddString(" ")
        Emit_MovRsiDataOffset(space_offset)
        Emit_MovRdxImm64(1)
        Emit_MovRdiImm64(1)
        Sys_Write()
        
        Emit_PopR15()
        Emit_PopR14()
        Emit_PopR13()
        Emit_PopR12()
        Emit_PopRbx()
        
        // Increment counters
        Emit_IncRbx()
        Emit_IncR14()
        
        Emit_Jmp(byte_loop)
        
        Emit_MarkLabel(byte_done)
        
        // Print newline
        nl_offset = Emit_AddString("\n")
        Emit_MovRsiDataOffset(nl_offset)
        Emit_MovRdxImm64(1)
        Emit_MovRdiImm64(1)
        Sys_Write()
        
        Emit_Jmp(row_loop)
        
        Emit_MarkLabel(row_done)
        
        // Restore callee-saved
        Emit_PopR15()
        Emit_PopR14()
        Emit_PopR13()
        Emit_PopR12()
        Emit_PopRbx()
    }
}

// =============================================================================
// HELPER: Print number in RAX inline (clobbers most registers)
// =============================================================================
Function.CompileDebug_PrintNumberInline {
    Body: {
        Emit_PushRax()
        Emit_SubRspImm8(24)
        
        Emit_XorR8R8()
        Emit_MovRcxImm64(10)
        Emit_MovRaxRsp8()
        
        digit_loop = Emit_CreateLabel()
        done_digits = Emit_CreateLabel()
        
        Emit_MarkLabel(digit_loop)
        Emit_XorRdxRdx()
        Emit_DivRcx()
        Emit_AddRdxImm8(48)
        Emit_MovRspR8Dl()
        Emit_IncR8()
        Emit_TestRaxRax()
        Emit_Jne(digit_loop)
        
        Emit_MarkLabel(done_digits)
        
        print_loop = Emit_CreateLabel()
        print_done = Emit_CreateLabel()
        
        Emit_MarkLabel(print_loop)
        Emit_TestR8R8()
        Emit_Je(print_done)
        Emit_DecR8()
        Emit_LeaRsiRspR8()
        Emit_MovRdxImm64(1)
        Emit_MovRdiImm64(1)
        Sys_Write()
        Emit_Jmp(print_loop)
        
        Emit_MarkLabel(print_done)
        
        Emit_AddRspImm8(32)
    }
}

// =============================================================================
// HELPER: Print RAX as hex inline (no 0x prefix)
// =============================================================================
Function.CompileDebug_PrintHexInline {
    Body: {
        Emit_PushRax()
        Emit_SubRspImm8(24)
        
        Emit_XorR8R8()
        Emit_MovRcxImm64(16)
        Emit_MovRaxRsp8()
        
        // Handle zero case
        zero_check = Emit_CreateLabel()
        not_zero = Emit_CreateLabel()
        
        Emit_TestRaxRax()
        Emit_Jne(not_zero)
        Emit_MovRdxImm64(48)
        Emit_MovRspR8Dl()
        Emit_IncR8()
        Emit_Jmp(zero_check)
        
        Emit_MarkLabel(not_zero)
        
        hex_loop = Emit_CreateLabel()
        hex_done = Emit_CreateLabel()
        digit_letter = Emit_CreateLabel()
        store_hex = Emit_CreateLabel()
        
        Emit_MarkLabel(hex_loop)
        Emit_TestRaxRax()
        Emit_Je(hex_done)
        
        Emit_XorRdxRdx()
        Emit_DivRcx()
        Emit_CmpRdxImm8(10)
        Emit_Jge(digit_letter)
        Emit_AddRdxImm32(48)
        Emit_Jmp(store_hex)
        Emit_MarkLabel(digit_letter)
        Emit_AddRdxImm32(55)
        Emit_MarkLabel(store_hex)
        Emit_MovRspR8Dl()
        Emit_IncR8()
        Emit_Jmp(hex_loop)
        
        Emit_MarkLabel(hex_done)
        Emit_MarkLabel(zero_check)
        
        print_loop = Emit_CreateLabel()
        print_done = Emit_CreateLabel()
        
        Emit_MarkLabel(print_loop)
        Emit_TestR8R8()
        Emit_Je(print_done)
        Emit_DecR8()
        Emit_LeaRsiRspR8()
        Emit_MovRdxImm64(1)
        Emit_MovRdiImm64(1)
        Sys_Write()
        Emit_Jmp(print_loop)
        
        Emit_MarkLabel(print_done)
        
        Emit_AddRspImm8(32)
    }
}

// =============================================================================
// HELPER: Print AL (low byte of RAX) as 2 hex digits
// =============================================================================
Function.CompileDebug_PrintHexByteInline {
    Body: {
        Emit_PushRax()
        Emit_SubRspImm8(8)
        
        // High nibble: (byte >> 4) & 0xF
        Emit_MovRaxRspOff8()
        Emit_ShrRaxImm8(4)
        Emit_AndRaxImm8(15)
        
        high_letter = Emit_CreateLabel()
        high_done = Emit_CreateLabel()
        Emit_CmpRaxImm8(10)
        Emit_Jge(high_letter)
        Emit_AddRaxImm8(48)
        Emit_Jmp(high_done)
        Emit_MarkLabel(high_letter)
        Emit_AddRaxImm8(55)
        Emit_MarkLabel(high_done)
        
        Emit_MovRspAl()
        
        // Low nibble: byte & 0xF
        Emit_MovRaxRspOff8()
        Emit_AndRaxImm8(15)
        
        low_letter = Emit_CreateLabel()
        low_done = Emit_CreateLabel()
        Emit_CmpRaxImm8(10)
        Emit_Jge(low_letter)
        Emit_AddRaxImm8(48)
        Emit_Jmp(low_done)
        Emit_MarkLabel(low_letter)
        Emit_AddRaxImm8(55)
        Emit_MarkLabel(low_done)
        
        Emit_MovRspOff1Al()
        
        // Print 2 chars
        Emit_MovRsiRsp()
        Emit_MovRdxImm64(2)
        Emit_MovRdiImm64(1)
        Sys_Write()
        
        Emit_AddRspImm8(16)
    }
}


// =============================================================================
// DEBUG PERF - Unified dispatcher
// DebugPerf.Start("label") - Push timestamp to stack
// DebugPerf.End("label") - Pop timestamp, calculate cycles, print
// DebugPerf.Mark("label") - Print current timestamp
// =============================================================================
Function.CompileDebug_Perf {
    Input: node: Address
    Body: {
        // Check if perf is enabled
        IfCondition EqualTo(Dbg.perf_enabled, 0) ThenBlock: {
            X86_Nop()
            ReturnValue(0)
        }
        
        label = AST_GetData1(node)
        variant = AST_GetData2(node)
        
        Dbg.perf_count = Add(Dbg.perf_count, 1)
        
        IfCondition EqualTo(variant, 1) ThenBlock: {
            CompileDebug_PerfStart_Impl(label)
            ReturnValue(1)
        }
        
        IfCondition EqualTo(variant, 2) ThenBlock: {
            CompileDebug_PerfEnd_Impl(label)
            ReturnValue(1)
        }
        
        IfCondition EqualTo(variant, 3) ThenBlock: {
            CompileDebug_PerfMark_Impl(label)
            ReturnValue(1)
        }
        
        X86_Nop()
        ReturnValue(0)
    }
}

// =============================================================================
// PERF START IMPLEMENTATION
// Uses RDTSC, combines EDX:EAX into 64-bit, pushes to stack
// =============================================================================
Function.CompileDebug_PerfStart_Impl {
    Input: label: Address
    Body: {
        Emit_XorRaxRax()
        X86_Cpuid()
        X86_Rdtsc()
        
        Emit_ShlRdxImm8(32)
        Emit_OrRaxRdx()
        
        Emit_PushRax()
    }
}

// =============================================================================
// PERF END IMPLEMENTATION
// Uses RDTSCP, calculates elapsed, prints result
// =============================================================================
Function.CompileDebug_PerfEnd_Impl {
    Input: label: Address
    Body: {
        X86_Rdtscp()
        
        Emit_ShlRdxImm8(32)
        Emit_OrRaxRdx()
        
        // Pop start timestamp into RBX
        Emit_PopRbx()
        
        // Calculate elapsed: RAX = end - start
        Emit_SubRaxRbx()
        
        // Save elapsed
        Emit_PushRax()
        
        // Print "[PERF] "
        prefix_offset = Emit_AddString("[PERF] ")
        Emit_MovRsiDataOffset(prefix_offset)
        Emit_MovRdxImm64(7)
        Emit_MovRdiImm64(1)
        Sys_Write()
        
        // Print label
        IfCondition NotEqual(label, 0) ThenBlock: {
            label_offset = Emit_AddString(label)
            Emit_MovRsiDataOffset(label_offset)
            label_len = StringLength(label)
            Emit_MovRdxImm64(label_len)
            Emit_MovRdiImm64(1)
            Sys_Write()
        }
        
        // Print ": "
        sep_offset = Emit_AddString(": ")
        Emit_MovRsiDataOffset(sep_offset)
        Emit_MovRdxImm64(2)
        Emit_MovRdiImm64(1)
        Sys_Write()
        
        // Restore elapsed to RAX
        Emit_PopRax()
        
        // Print the number
        Emit_PushRax()
        Emit_SubRspImm8(24)
        
        Emit_XorR8R8()
        Emit_MovRcxImm64(10)
        Emit_MovRaxRsp8()
        
        digit_loop = Emit_CreateLabel()
        done_loop = Emit_CreateLabel()
        
        Emit_MarkLabel(digit_loop)
        Emit_XorRdxRdx()
        Emit_DivRcx()
        Emit_AddRdxImm8(48)
        Emit_MovRspR8Dl()
        Emit_IncR8()
        Emit_TestRaxRax()
        Emit_Jne(digit_loop)
        
        Emit_MarkLabel(done_loop)
        
        print_loop = Emit_CreateLabel()
        print_done = Emit_CreateLabel()
        
        Emit_MarkLabel(print_loop)
        Emit_TestR8R8()
        Emit_Je(print_done)
        Emit_DecR8()
        Emit_LeaRsiRspR8()
        Emit_MovRdxImm64(1)
        Emit_MovRdiImm64(1)
        Sys_Write()
        Emit_Jmp(print_loop)
        
        Emit_MarkLabel(print_done)
        
        // Print " cycles\n"
        suffix_offset = Emit_AddString(" cycles\n")
        Emit_MovRsiDataOffset(suffix_offset)
        Emit_MovRdxImm64(8)
        Emit_MovRdiImm64(1)
        Sys_Write()
        
        // Clean up stack
        Emit_AddRspImm8(32)
    }
}

// =============================================================================
// PERF MARK IMPLEMENTATION (simplified - just print timestamp)
// =============================================================================
Function.CompileDebug_PerfMark_Impl {
    Input: label: Address
    Body: {
        X86_Rdtscp()
        
        Emit_ShlRdxImm8(32)
        Emit_OrRaxRdx()
        
        Emit_PushRax()
        
        // Print "[MARK] "
        prefix_offset = Emit_AddString("[MARK] ")
        Emit_MovRsiDataOffset(prefix_offset)
        Emit_MovRdxImm64(7)
        Emit_MovRdiImm64(1)
        Sys_Write()
        
        IfCondition NotEqual(label, 0) ThenBlock: {
            label_offset = Emit_AddString(label)
            Emit_MovRsiDataOffset(label_offset)
            label_len = StringLength(label)
            Emit_MovRdxImm64(label_len)
            Emit_MovRdiImm64(1)
            Sys_Write()
        }
        
        sep_offset = Emit_AddString(": ")
        Emit_MovRsiDataOffset(sep_offset)
        Emit_MovRdxImm64(2)
        Emit_MovRdiImm64(1)
        Sys_Write()
        
        // Pop and print timestamp
        Emit_PopRax()
        
        // Print newline
        nl_offset = Emit_AddString("\n")
        Emit_MovRsiDataOffset(nl_offset)
        Emit_MovRdxImm64(1)
        Emit_MovRdiImm64(1)
        Sys_Write()
    }
}

// =============================================================================
// HELPER: Print null-terminated string (RSI = string ptr)
// =============================================================================
Function.CompileDebug_PrintString {
    Body: {
        Emit_PushRsi()
        
        Emit_MovRegReg(Reg.RDI, Reg.RSI)
        
        Emit_MovRdxImm64(256)
        
        Emit_PopRsi()
        
        Emit_MovRdiImm64(1)
        
        Sys_Write()
    }
}

// =============================================================================
// STATISTICS
// =============================================================================
Function.Debug_PrintStats {
    Body: {
        IfCondition EqualTo(Dbg.initialized, 0) ThenBlock: {
            ReturnValue(0)
        }
        
        PrintMessage("[DEBUG STATS]\n")
        PrintMessage("  Debug level: ")
        PrintNumber(Dbg.level)
        PrintMessage("\n")
        PrintMessage("  Blocks compiled: ")
        PrintNumber(Dbg.block_count)
        PrintMessage("\n")
        PrintMessage("  Asserts compiled: ")
        PrintNumber(Dbg.assert_count)
        PrintMessage("\n")
        PrintMessage("  Perf markers: ")
        PrintNumber(Dbg.perf_count)
        PrintMessage("\n")
        PrintMessage("  Blocks stripped: ")
        PrintNumber(Dbg.stripped_count)
        PrintMessage("\n")
    }
}