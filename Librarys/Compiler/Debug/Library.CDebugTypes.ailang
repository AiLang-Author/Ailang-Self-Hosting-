// Library.CDebugTypes.ailang
// Debug system type definitions and state
// Location: Librarys/Compiler/Debug/Library.CDebugTypes.ailang
//
// Architecture:
//   - Self-contained constants and state
//   - No external imports (can be used by any module)
//   - Debug level controls conditional compilation

// =============================================================================
// DEBUG STATE
// Tracks current debug configuration during compilation
// =============================================================================
FixedPool.Dbg {
    "level": Initialize=0, CanChange=True           // 0-4, set by -D flag
    "perf_enabled": Initialize=0, CanChange=True    // 1 if -P flag set
    "initialized": Initialize=0, CanChange=True
    
    // Statistics
    "assert_count": Initialize=0, CanChange=True    // Total asserts compiled
    "block_count": Initialize=0, CanChange=True     // Total debug blocks compiled
    "perf_count": Initialize=0, CanChange=True      // Total perf markers compiled
    "stripped_count": Initialize=0, CanChange=True  // Blocks stripped (below level)
    
    // Performance tracking (for DebugPerf)
    "perf_slots": Initialize=0, CanChange=True      // XArray of perf slot entries
    "perf_slot_count": Initialize=0, CanChange=True
}

// =============================================================================
// DEBUG LEVELS
// Hierarchical - higher levels include all lower level features
// =============================================================================
FixedPool.DebugLevel {
    "NONE": Initialize=0        // Production - all debug code stripped
    "BASIC": Initialize=1       // Assertions only (DebugAssert)
    "TRACE": Initialize=2       // + Debug blocks level 1-2, basic traces
    "DETAILED": Initialize=3    // + Memory inspection, watchpoints, level 3 blocks
    "FULL": Initialize=4        // Everything: breakpoints, interactive, level 4 blocks
}

// =============================================================================
// DEBUG NODE FIELD INDICES
// For accessing AST node data fields
// =============================================================================
FixedPool.DebugField {
    "LABEL": Initialize=1       // Data1 = label string (for Debug blocks)
    "LEVEL": Initialize=2       // Data2 = required debug level
}

// =============================================================================
// PERF SLOT STRUCTURE (for DebugPerf tracking)
// 32 bytes per slot
// =============================================================================
// [0]  label_ptr    - Pointer to label string
// [8]  start_low    - Low 32 bits of start timestamp
// [12] start_high   - High 32 bits of start timestamp
// [16] end_low      - Low 32 bits of end timestamp
// [20] end_high     - High 32 bits of end timestamp
// [24] active       - 1 if timer started, 0 if stopped
// [28] reserved

FixedPool.PerfSlot {
    "LABEL": Initialize=0
    "START_LOW": Initialize=8
    "START_HIGH": Initialize=12
    "END_LOW": Initialize=16
    "END_HIGH": Initialize=20
    "ACTIVE": Initialize=24
    "SIZE": Initialize=32
}

// =============================================================================
// DEBUG TRACE TYPES
// For DebugTrace.Entry, DebugTrace.Exit, DebugTrace.Point
// =============================================================================
FixedPool.TraceType {
    "ENTRY": Initialize=1       // Function entry
    "EXIT": Initialize=2        // Function exit
    "POINT": Initialize=3       // Arbitrary trace point
}

// =============================================================================
// DEBUG MEMORY OPERATIONS
// For DebugMemory.Dump, DebugMemory.Watch, etc.
// =============================================================================
FixedPool.MemDebugOp {
    "DUMP": Initialize=1        // Hex dump memory region
    "WATCH": Initialize=2       // Watch for changes
    "LEAK_START": Initialize=3  // Start leak tracking
    "LEAK_CHECK": Initialize=4  // Check for leaks
    "PATTERN": Initialize=5     // Fill with pattern (0xDEADBEEF etc)
}

// =============================================================================
// ASSERT FAILURE ACTIONS
// What to do when assertion fails
// =============================================================================
FixedPool.AssertAction {
    "EXIT": Initialize=1        // Exit program (default)
    "BREAK": Initialize=2       // Emit INT3 for debugger
    "LOG": Initialize=3         // Log and continue (future)
}