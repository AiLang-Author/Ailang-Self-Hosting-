// Library.CEmitDebugX86.ailang
// x86-64 debug instruction emission
// Location: Librarys/Compiler/Debug/X86/Library.CEmitDebugX86.ailang
//
// Architecture:
//   - Pure byte emission functions
//   - No AST knowledge (called by CCompileDebug)
//   - Provides: INT3, RDTSC, RDTSCP, NOP variants

LibraryImport.Compiler.CodeEmit.CEmitCore

// =============================================================================
// INT3 - Software Breakpoint
// Opcode: 0xCC
// Triggers debug exception (trap to debugger)
// =============================================================================
Function.X86_Int3 {
    Body: {
        Emit_Byte(0xCC)
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
    }
}

// =============================================================================
// RDTSC - Read Time Stamp Counter
// Opcode: 0x0F 0x31
// Result: EDX:EAX = 64-bit cycle count since CPU reset
// Note: Not serializing - may execute out of order
// =============================================================================
Function.X86_Rdtsc {
    Body: {
        Emit_Byte(0x0F)
        Emit_Byte(0x31)
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
    }
}

// =============================================================================
// RDTSCP - Read Time Stamp Counter and Processor ID
// Opcode: 0x0F 0x01 0xF9
// Result: EDX:EAX = 64-bit cycle count, ECX = IA32_TSC_AUX (processor ID)
// Partially serializing - waits for prior instructions to complete
// More accurate for profiling than RDTSC
// =============================================================================
Function.X86_Rdtscp {
    Body: {
        Emit_Byte(0x0F)
        Emit_Byte(0x01)
        Emit_Byte(0xF9)
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
    }
}

// =============================================================================
// CPUID - CPU Identification (serializing fence)
// Opcode: 0x0F 0xA2
// Serializes instruction stream - use before RDTSC for accurate timing
// Clobbers: EAX, EBX, ECX, EDX
// =============================================================================
Function.X86_Cpuid {
    Body: {
        Emit_Byte(0x0F)
        Emit_Byte(0xA2)
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
    }
}

// =============================================================================
// NOP - No Operation (single byte)
// Opcode: 0x90
// Used for stripped debug code
// =============================================================================
Function.X86_Nop {
    Body: {
        Emit_Byte(0x90)
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
    }
}

// =============================================================================
// Multi-byte NOPs
// Intel recommended NOP sequences for alignment
// =============================================================================

// 2-byte NOP: 66 90
Function.X86_Nop2 {
    Body: {
        Emit_Byte(0x66)
        Emit_Byte(0x90)
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
    }
}

// 3-byte NOP: 0F 1F 00
Function.X86_Nop3 {
    Body: {
        Emit_Byte(0x0F)
        Emit_Byte(0x1F)
        Emit_Byte(0x00)
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
    }
}

// 4-byte NOP: 0F 1F 40 00
Function.X86_Nop4 {
    Body: {
        Emit_Byte(0x0F)
        Emit_Byte(0x1F)
        Emit_Byte(0x40)
        Emit_Byte(0x00)
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
    }
}

// 5-byte NOP: 0F 1F 44 00 00
Function.X86_Nop5 {
    Body: {
        Emit_Byte(0x0F)
        Emit_Byte(0x1F)
        Emit_Byte(0x44)
        Emit_Byte(0x00)
        Emit_Byte(0x00)
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
    }
}

// 6-byte NOP: 66 0F 1F 44 00 00
Function.X86_Nop6 {
    Body: {
        Emit_Byte(0x66)
        Emit_Byte(0x0F)
        Emit_Byte(0x1F)
        Emit_Byte(0x44)
        Emit_Byte(0x00)
        Emit_Byte(0x00)
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
    }
}

// 7-byte NOP: 0F 1F 80 00 00 00 00
Function.X86_Nop7 {
    Body: {
        Emit_Byte(0x0F)
        Emit_Byte(0x1F)
        Emit_Byte(0x80)
        Emit_Byte(0x00)
        Emit_Byte(0x00)
        Emit_Byte(0x00)
        Emit_Byte(0x00)
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
    }
}

// 8-byte NOP: 0F 1F 84 00 00 00 00 00
Function.X86_Nop8 {
    Body: {
        Emit_Byte(0x0F)
        Emit_Byte(0x1F)
        Emit_Byte(0x84)
        Emit_Byte(0x00)
        Emit_Byte(0x00)
        Emit_Byte(0x00)
        Emit_Byte(0x00)
        Emit_Byte(0x00)
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
    }
}

// 9-byte NOP: 66 0F 1F 84 00 00 00 00 00
Function.X86_Nop9 {
    Body: {
        Emit_Byte(0x66)
        Emit_Byte(0x0F)
        Emit_Byte(0x1F)
        Emit_Byte(0x84)
        Emit_Byte(0x00)
        Emit_Byte(0x00)
        Emit_Byte(0x00)
        Emit_Byte(0x00)
        Emit_Byte(0x00)
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
    }
}

// =============================================================================
// EMIT N NOPS
// Emit specified number of NOP bytes (uses optimal multi-byte NOPs)
// =============================================================================
Function.X86_NopN {
    Input: count: Integer
    Body: {
        remaining = count
        
        WhileLoop GreaterEqual(remaining, 9) {
            X86_Nop9()
            remaining = Subtract(remaining, 9)
        }
        
        IfCondition GreaterEqual(remaining, 8) ThenBlock: {
            X86_Nop8()
            remaining = Subtract(remaining, 8)
        }
        IfCondition GreaterEqual(remaining, 7) ThenBlock: {
            X86_Nop7()
            remaining = Subtract(remaining, 7)
        }
        IfCondition GreaterEqual(remaining, 6) ThenBlock: {
            X86_Nop6()
            remaining = Subtract(remaining, 6)
        }
        IfCondition GreaterEqual(remaining, 5) ThenBlock: {
            X86_Nop5()
            remaining = Subtract(remaining, 5)
        }
        IfCondition GreaterEqual(remaining, 4) ThenBlock: {
            X86_Nop4()
            remaining = Subtract(remaining, 4)
        }
        IfCondition GreaterEqual(remaining, 3) ThenBlock: {
            X86_Nop3()
            remaining = Subtract(remaining, 3)
        }
        IfCondition GreaterEqual(remaining, 2) ThenBlock: {
            X86_Nop2()
            remaining = Subtract(remaining, 2)
        }
        IfCondition EqualTo(remaining, 1) ThenBlock: {
            X86_Nop()
        }
    }
}

// =============================================================================
// SERIALIZED RDTSC SEQUENCE
// For accurate timing: CPUID serializes, then RDTSC reads timestamp
// Clobbers: EAX, EBX, ECX, EDX (CPUID clobbers all)
// =============================================================================
Function.X86_SerializedRdtsc {
    Body: {
        // XOR EAX, EAX (set CPUID leaf 0)
        Emit_Byte(0x31)     // XOR r32, r/m32
        Emit_Byte(0xC0)     // EAX, EAX
        
        // CPUID - serialize
        X86_Cpuid()
        
        // RDTSC - read timestamp into EDX:EAX
        X86_Rdtsc()
    }
}

// =============================================================================
// UD2 - Undefined Instruction
// Opcode: 0x0F 0x0B
// Generates #UD exception - useful for unreachable code markers
// =============================================================================
Function.X86_Ud2 {
    Body: {
        Emit_Byte(0x0F)
        Emit_Byte(0x0B)
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
    }
}