// =============================================================================
// DIVIDE INSTRUCTIONS
// =============================================================================

// CQO - Sign extend RAX into RDX:RAX for division
Function.X86_Cqo {
    Body: {
        Emit_Byte(0x48)    // 0x48 REX.W
        Emit_Byte(0x99)   // 0x99 CQO
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
    }
}

// IDIV RBX - Signed divide RDX:RAX by RBX
// Quotient in RAX, remainder in RDX
Function.X86_IdivRbx {
    Body: {
        Emit_Byte(0x48)    // 0x48 REX.W
        Emit_Byte(0xF7)   // 0xF7 IDIV r/m64
        Emit_Byte(0xFB)   // 0xFB ModR/M: /7, RBX
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
    }
}

// IDIV RCX
Function.X86_IdivRcx {
    Body: {
        Emit_Byte(0x48)
        Emit_Byte(0xF7)
        Emit_Byte(0xF9)   // 0xF9 ModR/M: /7, RCX
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
    }
}

// DIV RBX - Unsigned divide
Function.X86_DivRbx {
    Body: {
        Emit_Byte(0x48)    // 0x48 REX.W
        Emit_Byte(0xF7)   // 0xF7 DIV r/m64
        Emit_Byte(0xF3)   // 0xF3 ModR/M: /6, RBX
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
    }
}

