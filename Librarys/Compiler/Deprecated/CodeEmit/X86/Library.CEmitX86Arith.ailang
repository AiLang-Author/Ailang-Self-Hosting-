// ADD RDI, RDX = 48 01 D7
Function.X86_AddRdiRdx {
    Body: {
        Emit_Byte(0x48)  // REX.W
        Emit_Byte(0x01)  // ADD r/m64, r64
        Emit_Byte(0xD7)  // ModRM: RDX -> RDI
