// Library.CEmitX86Arith.ailang
// x86-64 arithmetic instructions
// Location: Librarys/Compiler/CodeEmit/X86/Library.CEmitX86Arith.ailang

LibraryImport.Compiler.CodeEmit.CEmitTypes
LibraryImport.Compiler.CodeEmit.CEmitCore

// =============================================================================
// ADD INSTRUCTIONS
// =============================================================================

// ADD RAX, RBX
Function.X86_AddRaxRbx {
    Body: {
        Emit_Byte(0x48)    // 0x48 REX.W
        Emit_Byte(0x01)     // 0x01 ADD r/m64, r64
        Emit_Byte(0xD8)   // 0xD8 ModR/M: mod=11, reg=RBX, r/m=RAX
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
    }
}

// ADD RCX, RBX
Function.X86_AddRcxRbx {
    Body: {
        Emit_Byte(0x48)    // REX.W
        Emit_Byte(0x01)     // ADD r/m64, r64
        Emit_Byte(0xD9)   // 0xD9 ModR/M: RCX, RBX
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
    }
}

// ADD RAX, RCX
Function.X86_AddRaxRcx {
    Body: {
        Emit_Byte(0x48)
        Emit_Byte(0x01)
        Emit_Byte(0xC8)   // 0xC8
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
    }
}


