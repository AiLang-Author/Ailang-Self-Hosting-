        Emit_DWord(imm)
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
    }
}

// ADD RAX, imm8 (sign-extended)
Function.X86_AddRaxImm8 {
    Input: imm: Integer
    Body: {
        Emit_Byte(0x48)    // 0x48 REX.W
        Emit_Byte(0x83)   // 0x83 ADD r/m64, imm8
        Emit_Byte(0xC0)   // 0xC0 ModR/M: RAX
        Emit_Byte(imm)
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
    }
}

// ADD RSI, imm8
Function.X86_AddRsiImm8 {
    Input: imm: Integer
    Body: {
        Emit_Byte(0x48)    // 0x48 REX.W
        Emit_Byte(0x83)   // 0x83 ADD r/m64, imm8
        Emit_Byte(0xC6)   // 0xC6 ModR/M: RSI
        // Handle signed byte
        IfCondition LessThan(imm, 0) ThenBlock: {
            Emit_Byte(Add(256, imm))
        } ElseBlock: {
            Emit_Byte(imm)
        }
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
    }
}

// ADD RCX, RAX
Function.X86_AddRcxRax {
    Body: {
        Emit_Byte(0x48)    // 0x48 REX.W
        Emit_Byte(0x01)     // 0x01 ADD r/m64, r64
        Emit_Byte(0xC1)   // 0xC1 ModR/M: RCX, RAX
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
    }
}

// ADD RSI, R13 - 4C 01 EE
Function.X86_AddRsiR13 {
    Body: {
        Emit_Byte(0x4C)
        Emit_Byte(0x01)
