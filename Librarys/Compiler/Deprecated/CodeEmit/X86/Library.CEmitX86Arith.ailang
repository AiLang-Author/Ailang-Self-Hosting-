// =============================================================================
// MULTIPLY INSTRUCTIONS
// =============================================================================

// IMUL RAX, RBX (signed multiply)
Function.X86_ImulRaxRbx {
    Body: {
        Emit_Byte(0x48)    // 0x48 REX.W
        Emit_Byte(0x0F)    // 0x0F
        Emit_Byte(0xAF)   // 0xAF IMUL r64, r/m64
        Emit_Byte(0xC3)   // 0xC3 ModR/M: RAX, RBX
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
    }
}

// IMUL RAX, RCX
Function.X86_ImulRaxRcx {
    Body: {
        Emit_Byte(0x48)
        Emit_Byte(0x0F)
        Emit_Byte(0xAF)
        Emit_Byte(0xC1)   // 0xC1 ModR/M: RAX, RCX
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
    }
}

// IMUL RAX, imm32 (3-operand form)
Function.X86_ImulRaxRaxImm32 {
    Input: imm: Integer
    Body: {
        Emit_Byte(0x48)    // 0x48 REX.W
        Emit_Byte(0x69)   // 0x69 IMUL r64, r/m64, imm32
        Emit_Byte(0xC0)   // 0xC0 ModR/M: RAX, RAX
        Emit_DWord(imm)
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
    }
}

// MUL RBX (unsigned multiply, RDX:RAX = RAX * RBX)
Function.X86_MulRbx {
    Body: {
        Emit_Byte(0x48)    // 0x48 REX.W
        Emit_Byte(0xF7)   // 0xF7 MUL r/m64
        Emit_Byte(0xE3)   // 0xE3 ModR/M: /4, RBX
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
    }
}

