// Library.CEmitX86Helpers.ailang
// Additional X86 helper instructions needed by Compile modules
// Location: Librarys/Compiler/CodeEmit/X86/Library.CEmitX86Helpers.ailang
//
// UNIQUE functions only - duplicates removed

LibraryImport.Compiler.CodeEmit.CEmitTypes
LibraryImport.Compiler.CodeEmit.CEmitCore

// =============================================================================
// RELOCATION TYPES
// =============================================================================
FixedPool.X86RelocKind {
    "DATA_ABS64": Initialize=1   
    "CODE_REL32": Initialize=2  
}

// =============================================================================
// R13/R14 REGISTER OPERATIONS (not in other files)
// =============================================================================

Function.X86_XorR13R13 {
    Body: {
        Emit_Byte(0x4D)
        Emit_Byte(0x31)
        Emit_Byte(0xED)
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
    }
}

Function.X86_IncR13 {
    Body: {
        Emit_Byte(0x49)
        Emit_Byte(0xFF)
        Emit_Byte(0xC5)
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
    }
}

Function.X86_DecR14 {
    Body: {
        Emit_Byte(0x49)
        Emit_Byte(0xFF)
        Emit_Byte(0xCE)
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
    }
}

Function.X86_AddR14Imm32 {
    Input: imm: Integer
    Body: {
        Emit_Byte(0x49)
        Emit_Byte(0x81)
        Emit_Byte(0xC6)
        Emit_DWord(imm)
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
    }
}

// SHL RBX, imm8 = 48 C1 E3 imm
Function.X86_ShlRbxImm8 {
    Input: imm: Integer
    Body: {
        Emit_Byte(0x48)
        Emit_Byte(0xC1)
        Emit_Byte(0xE3)
        Emit_Byte(imm)
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
    }
}

// ADD RBX, R12 = 4C 01 E3
Function.X86_AddRbxR12 {
    Body: {
        Emit_Byte(0x4C)
        Emit_Byte(0x01)
        Emit_Byte(0xE3)
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
    }
}


// =============================================================================
// ADD RDX, imm32 (not in other files)
// =============================================================================
Function.X86_AddRdxImm32 {
    Input: imm: Integer
    Body: {
        Emit_Byte(0x48)
        Emit_Byte(0x81)
        Emit_Byte(0xC2)
        Emit_DWord(imm)
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
    }
}

// =============================================================================
// BYTE MEMORY OPERATIONS (not in other files)
// =============================================================================

Function.X86_MovByteRspImm8 {
    Input: imm: Integer
    Body: {
        Emit_Byte(0xC6)
        Emit_Byte(0x04)
        Emit_Byte(0x24)
        Emit_Byte(imm)
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
    }
}

Function.X86_MovByteR14Imm8 {
    Input: imm: Integer
    Body: {
        Emit_Byte(0x41)
        Emit_Byte(0xC6)
        Emit_Byte(0x06)
        Emit_Byte(imm)
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
    }
}

Function.X86_MovByteR14Rdx {
    Body: {
        Emit_Byte(0x41)
        Emit_Byte(0x88)
        Emit_Byte(0x16)
        Emit.instructions_emitted = Add(Emit.instructions_emitted, 1)
    }
}



