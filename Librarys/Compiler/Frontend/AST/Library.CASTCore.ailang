Function.AST_GetType {
    Input: node: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: {
            ReturnValue(0)
        }
        ReturnValue(XArray.XGet(node, ASTField.TYPE))
    }
}

