// Library.CASTCore.ailang
// Core AST operations using XArray for node storage
// No raw pointer arithmetic - uses proven XArray infrastructure

LibraryImport.XArrays
LibraryImport.Compiler.Frontend.AST.CASTTypes

// =============================================================================
// AST NODE POOL — fixed-size (64B) slot allocator for AST nodes.
//
// Before this pool every AST_Create did two XArray.XCreate calls (one for
// the node struct, one for its children list). For a ailang_cli self-
// compile producing 82,638 AST nodes that was 165,000+ small allocations,
// each rounded up to an Arena slab class. Peak compile RSS was 1.77 GB.
//
// Now the node struct is a plain 64-byte slot handed out from a single
// up-front pool allocation. Children still use XArray (variable-length,
// lazy-created on first AST_AddChild so leaf nodes pay nothing). Field
// access moves from XArray.XGet(node, idx) to Dereference(Add(node,
// idx*8)) — faster AND smaller.
//
// Same invariants as the regex parser pools (RegexFragPool et al in
// Library.Regex_Thompson.ailang):
//   * Process-lifetime bump allocator. Never reset `head` between
//     compiles — any live AST node reference would dangle.
//   * Returns 0 on cap overflow so callers' null-checks keep working.
//   * Lazy-init buf on first AST_NodeAlloc call.
// =============================================================================

FixedPool.ASTNodePool {
    "buf":  Initialize=0, CanChange=True
    "head": Initialize=0, CanChange=True
    "cap":  Initialize=4194304      // 4M nodes × 64B = 256 MB reserved
}

Function.AST_NodeAlloc {
    Output: Address
    Body: {
        IfCondition EqualTo(ASTNodePool.buf, 0) ThenBlock: {
            ASTNodePool.buf = Allocate(Multiply(ASTNodePool.cap, 64))
            IfCondition EqualTo(ASTNodePool.buf, 0) ThenBlock: {
                PrintMessage("[AST] FATAL: pool buf Allocate failed\n")
                ReturnValue(0)
            }
        }
        IfCondition GreaterEqual(ASTNodePool.head, ASTNodePool.cap) ThenBlock: {
            PrintMessage("[AST] FATAL: node pool overflow at head=")
            PrintNumber(ASTNodePool.head)
            PrintMessage(" cap=")
            PrintNumber(ASTNodePool.cap)
            PrintMessage("\n")
            ReturnValue(0)
        }
        slot = Add(ASTNodePool.buf, Multiply(ASTNodePool.head, 64))
        ASTNodePool.head = Add(ASTNodePool.head, 1)
        // Zero the 8 fields. Deterministic starting state matters
        // because callers rely on "unset" fields reading as 0.
        i = 0
        WhileLoop LessThan(i, 64) {
            SetByte(slot, i, 0)
            i = Add(i, 1)
        }
        ReturnValue(slot)
    }
}

// =============================================================================
// SYMBOL TYPES
// =============================================================================
FixedPool.SymType {
    "SYM_UNKNOWN": Initialize=0
    "SYM_FUNCTION": Initialize=1
    "SYM_SUBROUTINE": Initialize=2
    "SYM_VARIABLE": Initialize=3
    "SYM_PARAMETER": Initialize=4
    "SYM_POOL": Initialize=5
    "SYM_POOL_VAR": Initialize=6
    "SYM_CONSTANT": Initialize=7
    "SYM_TYPE": Initialize=8
    "SYM_LABEL": Initialize=9
}

// =============================================================================
// SEMANTIC ANALYZER STATE
// =============================================================================
FixedPool.Semantic {
    "symbols": Initialize=0, CanChange=True
    "symbol_count": Initialize=0, CanChange=True
    "scopes": Initialize=0, CanChange=True
    "scope_depth": Initialize=0, CanChange=True
    "current_function": Initialize=0, CanChange=True
    "error": Initialize=0, CanChange=True
    "error_count": Initialize=0, CanChange=True
    "warning_count": Initialize=0, CanChange=True
    "error_msg": Initialize=0, CanChange=True
    "error_line": Initialize=0, CanChange=True
    "error_col": Initialize=0, CanChange=True
}

// =============================================================================
// SYMBOL RECORD STRUCTURE
// Each symbol: [name, type, data_type, scope_level, node_ref, flags]
// =============================================================================
FixedPool.SymField {
    "NAME": Initialize=0
    "TYPE": Initialize=1
    "DATA_TYPE": Initialize=2
    "SCOPE": Initialize=3
    "NODE": Initialize=4
    "FLAGS": Initialize=5
    "SYM_SIZE": Initialize=6
}

// =============================================================================
// SYMBOL FLAGS
// =============================================================================
FixedPool.SymFlag {
    "NONE": Initialize=0
    "DEFINED": Initialize=1
    "USED": Initialize=2
    "EXPORTED": Initialize=4
    "IMPORTED": Initialize=8
    "MUTABLE": Initialize=16
    "INITIALIZED": Initialize=32
}

// =============================================================================
// NODE CREATION
// =============================================================================

// =============================================================================
// MODIFIED AST_Create - Register in master list
// Replace existing AST_Create in Library.CASTCore.ailang
// =============================================================================

// Pool-backed node. Layout (64 bytes, offsets in bytes):
//   [0]  TYPE       [32] DATA2
//   [8]  LINE       [40] DATA3
//   [16] COL        [48] DATA4
//   [24] DATA1      [56] CHILDREN (0 = no children yet; lazy XArray
//                                   on first AST_AddChild)
Function.AST_Create {
    Input: node_type: Integer
    Output: Address
    Body: {
        node = AST_NodeAlloc()
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }

        StoreValue(node,          node_type)         // TYPE
        StoreValue(Add(node,  8), ASTState.auto_line) // LINE
        StoreValue(Add(node, 16), ASTState.auto_col)  // COL
        // DATA1..4 and CHILDREN already zeroed by AST_NodeAlloc.

        ASTState.node_count = Add(ASTState.node_count, 1)
        ReturnValue(node)
    }
}


Function.AST_CreateAt {
    Input: node_type: Integer
    Input: line: Integer
    Input: col: Integer
    Output: Address
    Body: {
        node = AST_Create(node_type)
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        StoreValue(Add(node,  8), line)  // LINE
        StoreValue(Add(node, 16), col)   // COL
        ReturnValue(node)
    }
}

// =============================================================================
// AST INIT - Call once at start of parsing
// Add to Library.CASTCore.ailang
// =============================================================================
Function.AST_Init {
    Body: {
        // Old all_nodes master list is no longer used — ASTNodePool
        // tracks every allocated slot in order [0, head) and that's
        // the enumeration AST_FreeAll walks.
        IfCondition NotEqual(ASTState.all_nodes, 0) ThenBlock: {
            XArray.XDestroy(ASTState.all_nodes)
            ASTState.all_nodes = 0
        }
        ASTState.node_count = 0
        ASTState.error = 0
        ASTState.error_msg = 0

        PrintMessage("[AST] Initialized, pool-backed node storage\n")
    }
}


// =============================================================================
// FIELD GETTERS
// =============================================================================

// All field access is offset-based Dereference on the 64-byte pool slot.
// No XArray bookkeeping. Byte offsets (vs ASTField index × 8):
//   TYPE=0  LINE=8  COL=16  DATA1=24  DATA2=32  DATA3=40  DATA4=48  CHILDREN=56

Function.AST_GetType {
    Input: node: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(Dereference(node))
    }
}

Function.AST_GetLine {
    Input: node: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(Dereference(Add(node, 8)))
    }
}

Function.AST_GetCol {
    Input: node: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(Dereference(Add(node, 16)))
    }
}

Function.AST_GetData1 {
    Input: node: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(Dereference(Add(node, 24)))
    }
}

Function.AST_GetData2 {
    Input: node: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(Dereference(Add(node, 32)))
    }
}

Function.AST_GetData3 {
    Input: node: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
