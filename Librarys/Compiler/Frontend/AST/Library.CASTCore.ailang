// =============================================================================
// CHILD NODE MANAGEMENT
// =============================================================================

Function.AST_AddChild {
    Input: parent: Address
    Input: child: Address
    Body: {
        IfCondition And(NotEqual(parent, 0), NotEqual(child, 0)) ThenBlock: {
            children = XArray.XGet(parent, ASTField.CHILDREN)
            XArray.XPush(children, child)
        }
    }
}

Function.AST_GetChild {
    Input: node: Address
    Input: index: Integer
    Output: Address
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: {
            ReturnValue(0)
        }
        children = XArray.XGet(node, ASTField.CHILDREN)
        IfCondition EqualTo(children, 0) ThenBlock: {
            ReturnValue(0)
        }
        ReturnValue(XArray.XGet(children, index))
    }
}

Function.AST_GetChildCount {
    Input: node: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: {
            ReturnValue(0)
        }
        children = XArray.XGet(node, ASTField.CHILDREN)
        IfCondition EqualTo(children, 0) ThenBlock: {
            ReturnValue(0)
        }
        ReturnValue(XArray.XSize(children))
    }
}

Function.AST_SetChild {
    Input: node: Address
    Input: index: Integer
    Input: child: Address
    Body: {
        IfCondition NotEqual(node, 0) ThenBlock: {
            children = XArray.XGet(node, ASTField.CHILDREN)
            IfCondition NotEqual(children, 0) ThenBlock: {
                XArray.XSet(children, index, child)
            }
        }
    }
}

// =============================================================================
// TYPE CHECKING
// =============================================================================

Function.AST_IsType {
    Input: node: Address
    Input: expected: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: {
            ReturnValue(0)
        }
        actual = XArray.XGet(node, ASTField.TYPE)
        IfCondition EqualTo(actual, expected) ThenBlock: {
            ReturnValue(1)
        }
        ReturnValue(0)
    }
}

Function.AST_IsNull {
    Input: node: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: {
            ReturnValue(1)
        }
        ReturnValue(0)
    }
}

// =============================================================================
// NODE CLEANUP
// =============================================================================

Function.AST_Free {
    Input: node: Address
    Body: {
        IfCondition NotEqual(node, 0) ThenBlock: {
            // Free all children recursively
            children = XArray.XGet(node, ASTField.CHILDREN)
            IfCondition NotEqual(children, 0) ThenBlock: {
                count = XArray.XSize(children)
                i = 0
                WhileLoop LessThan(i, count) {
                    child = XArray.XGet(children, i)
                //    AST_Free(child)
                    i = Add(i, 1)
                }
                XArray.XDestroy(children)
            }
            
            // Free the node itself
            XArray.XDestroy(node)
            ASTState.node_count = Subtract(ASTState.node_count, 1)
        }
    }
}

Function.AST_FreeShallow {
    Input: node: Address
    Body: {
        IfCondition NotEqual(node, 0) ThenBlock: {
            children = XArray.XGet(node, ASTField.CHILDREN)
            IfCondition NotEqual(children, 0) ThenBlock: {
                XArray.XDestroy(children)
            }
            XArray.XDestroy(node)
            ASTState.node_count = Subtract(ASTState.node_count, 1)
        }
    }
}

// =============================================================================
// AST_FreeAll - Non-recursive bulk free using master list
// Add to Library.CASTCore.ailang
// =============================================================================
Function.AST_FreeAll {
    Body: {
        IfCondition EqualTo(ASTState.all_nodes, 0) ThenBlock: {
            PrintMessage("[AST] Warning: all_nodes is null, nothing to free\n")
            ReturnValue(0)
        }
        
        count = XArray.XSize(ASTState.all_nodes)
        freed = 0
        
        PrintMessage("[AST] Freeing ")
        PrintNumber(count)
        PrintMessage(" nodes...\n")
        
        // Iterate flat list - no recursion needed
        i = 0
        WhileLoop LessThan(i, count) {
            node = XArray.XGet(ASTState.all_nodes, i)
            
            IfCondition NotEqual(node, 0) ThenBlock: {
                // Free the children XArray (but NOT the child nodes - they're in the list too)
                children = XArray.XGet(node, ASTField.CHILDREN)
                IfCondition NotEqual(children, 0) ThenBlock: {
                    XArray.XDestroy(children)
                }
                
                // Free the node XArray itself
                XArray.XDestroy(node)
                freed = Add(freed, 1)
            }
            
            i = Add(i, 1)
        }
        
        // Free the master list itself
        XArray.XDestroy(ASTState.all_nodes)
        ASTState.all_nodes = 0
        ASTState.node_count = 0
        
        PrintMessage("[AST] Freed ")
        PrintNumber(freed)
        PrintMessage(" nodes\n")
    }
}