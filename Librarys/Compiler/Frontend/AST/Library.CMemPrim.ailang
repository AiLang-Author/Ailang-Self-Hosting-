// Library.CMemPrim.ailang
// Name decoder for the width-explicit memory primitives.
//
//   RDMEM_<w>(addr)              RDMEM_<w>(base, offset)
//   WRMEM_<w>(addr, value)       WRMEM_<w>(base, offset, value)
//
//   <w>  8 16 32 64     zero-extending read, or a store of the low bytes
//        S8 S16 S32     sign-extending read (RDMEM only)
//
//   RDMEM_IO_<w> / WRMEM_IO_<w> are device-memory accesses. Each one is
//   exactly one access of that width, in program order. They are never
//   folded, hoisted, merged, split, or dropped.
//
// The parser lowers the plain forms onto GetByte, SetByte, Dereference,
// and StoreValue (Parse_MemPrimLower), so codegen and the optimizer see
// the same tree as the old spellings. The IO forms keep their own name.
// No purity or home list knows that name, so every optimizer pass treats
// it as an opaque call. CompileMem_IO emits it.
//
// Decoded code: bits 0-1 op (1 read, 2 write), bit 2 IO, bit 3 signed,
// bits 4+ size in bytes. 0 means not a memory primitive. -1 means the
// name starts RDMEM_ or WRMEM_ but is not a valid spelling.

Function.MemPrim_Decode {
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }
        // R D / W R, then M E M _. Each test stops at the first mismatch,
        // so a short name never reads past its terminator.
        c0 = GetByte(name, 0)
        op = 0
        IfCondition EqualTo(c0, 82) ThenBlock: {
            IfCondition EqualTo(GetByte(name, 1), 68) ThenBlock: { op = 1 }
        }
        IfCondition EqualTo(c0, 87) ThenBlock: {
            IfCondition EqualTo(GetByte(name, 1), 82) ThenBlock: { op = 2 }
        }
        IfCondition EqualTo(op, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(GetByte(name, 2), 77) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(GetByte(name, 3), 69) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(GetByte(name, 4), 77) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(GetByte(name, 5), 95) ThenBlock: { ReturnValue(0) }

        p = 6
        io = 0
        // I O _
        IfCondition EqualTo(GetByte(name, 6), 73) ThenBlock: {
            IfCondition EqualTo(GetByte(name, 7), 79) ThenBlock: {
                IfCondition EqualTo(GetByte(name, 8), 95) ThenBlock: {
                    io = 1
                    p = 9
                }
            }
        }
        sgn = 0
        // S
        IfCondition EqualTo(GetByte(name, p), 83) ThenBlock: {
            sgn = 1
            p = Add(p, 1)
        }
        d0 = GetByte(name, p)
        d1 = 0
        IfCondition NotEqual(d0, 0) ThenBlock: { d1 = GetByte(name, Add(p, 1)) }
        d2 = 0
        IfCondition NotEqual(d1, 0) ThenBlock: { d2 = GetByte(name, Add(p, 2)) }
        IfCondition NotEqual(d2, 0) ThenBlock: { ReturnValue(-1) }

        size = 0
        // 8, 16, 32, 64
        IfCondition EqualTo(d0, 56) ThenBlock: {
            IfCondition EqualTo(d1, 0) ThenBlock: { size = 1 }
        }
        IfCondition EqualTo(d0, 49) ThenBlock: {
            IfCondition EqualTo(d1, 54) ThenBlock: { size = 2 }
        }
        IfCondition EqualTo(d0, 51) ThenBlock: {
            IfCondition EqualTo(d1, 50) ThenBlock: { size = 4 }
        }
        IfCondition EqualTo(d0, 54) ThenBlock: {
            IfCondition EqualTo(d1, 52) ThenBlock: { size = 8 }
        }
        IfCondition EqualTo(size, 0) ThenBlock: { ReturnValue(-1) }
        // Sign extension is a read of 8, 16, or 32 bits.
        IfCondition EqualTo(sgn, 1) ThenBlock: {
            IfCondition EqualTo(op, 2) ThenBlock: { ReturnValue(-1) }
            IfCondition EqualTo(size, 8) ThenBlock: { ReturnValue(-1) }
        }
        ReturnValue(Add(Add(op, Multiply(io, 4)), Add(Multiply(sgn, 8), Multiply(size, 16))))
    }
}

Function.MemPrim_Op {
    Input: code: Integer
    Output: Integer
    Body: { ReturnValue(BitwiseAnd(code, 3)) }
}

Function.MemPrim_IsIO {
    Input: code: Integer
    Output: Integer
    Body: { ReturnValue(BitwiseAnd(RightShift(code, 2), 1)) }
}

Function.MemPrim_Signed {
    Input: code: Integer
    Output: Integer
    Body: { ReturnValue(BitwiseAnd(RightShift(code, 3), 1)) }
}

Function.MemPrim_Size {
    Input: code: Integer
    Output: Integer
    Body: { ReturnValue(RightShift(code, 4)) }
}

// Width hint for Dereference / StoreValue. 0 is the plain 8-byte form,
// which keeps the one-argument Dereference that the optimizer matches.
// The s-hints are sign-extending reads.
Function.MemPrim_Hint {
    Input: code: Integer
    Output: Address
    Body: {
        size = MemPrim_Size(code)
        IfCondition EqualTo(MemPrim_Signed(code), 1) ThenBlock: {
            IfCondition EqualTo(size, 1) ThenBlock: { ReturnValue("sbyte") }
            IfCondition EqualTo(size, 2) ThenBlock: { ReturnValue("sword") }
            ReturnValue("sdword")
        }
        IfCondition EqualTo(size, 1) ThenBlock: { ReturnValue("byte") }
        IfCondition EqualTo(size, 2) ThenBlock: { ReturnValue("word") }
        IfCondition EqualTo(size, 4) ThenBlock: { ReturnValue("dword") }
        ReturnValue(0)
    }
}
