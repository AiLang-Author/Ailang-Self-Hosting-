LibraryImport.Compiler.Frontend.AST.CASTTypes
LibraryImport.Compiler.Frontend.AST.CASTCore

// Library.CMemPrim.ailang
// Name decoder for the width-explicit memory primitives.
//
//   RDMEM_<w>(addr)              RDMEM_<w>(base, offset)
//   WRMEM_<w>(addr, value)       WRMEM_<w>(base, offset, value)
//
//   <w>  8 16 32 64     zero-extending read, or a store of the low bytes
//        S8 S16 S32     sign-extending read (RDMEM only)
//
//   RDMEM_IO_<w> / WRMEM_IO_<w> are device-memory accesses. Each one is
//   exactly one access of that width, in program order. They are never
//   folded, hoisted, merged, split, or dropped.
//
// These names are the compiler's own vocabulary; there are no other
// memory builtins. The parser (Parse_MemPrimLower) checks the argument
// count and settles each access into the one shape its name implies, so
// the name alone says what the tree looks like:
//
//   RDMEM_8(base, offset)              byte-at read     MemName_IsByteAt
//   WRMEM_8(base, offset, value)       byte-at write    MemName_IsByteSetAt
//   RDMEM_16/32/64/S8/S16/S32(addr)    flat read        MemName_IsLoad
//   WRMEM_16/32/64(addr, value)        flat write       MemName_IsStore
//
// RDMEM_8(addr) gets offset 0, and WRMEM_8(addr, value) likewise. A
// (base, offset) form of any other width becomes one Add(base, offset)
// address. The byte paths index with base and offset; the wider paths
// match on the shape of the one address.
//
// The _IO_ forms are none of these. No optimizer list knows them, so
// every pass treats them as opaque calls, and CompileMem_IO emits
// exactly one access each.
//
// Decoded code: bits 0-1 op (1 read, 2 write), bit 2 IO, bit 3 signed,
// bits 4+ size in bytes. 0 means not a memory primitive. -1 means the
// name starts RDMEM_ or WRMEM_ but is not a valid spelling.

Function.MemPrim_Decode {
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }
        // R D / W R, then M E M _. Each test stops at the first mismatch,
        // so a short name never reads past its terminator.
        c0 = RDMEM_8(name, 0)
        op = 0
        IfCondition EqualTo(c0, 82) ThenBlock: {
            IfCondition EqualTo(RDMEM_8(name, 1), 68) ThenBlock: { op = 1 }
        }
        IfCondition EqualTo(c0, 87) ThenBlock: {
            IfCondition EqualTo(RDMEM_8(name, 1), 82) ThenBlock: { op = 2 }
        }
        IfCondition EqualTo(op, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(RDMEM_8(name, 2), 77) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(RDMEM_8(name, 3), 69) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(RDMEM_8(name, 4), 77) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(RDMEM_8(name, 5), 95) ThenBlock: { ReturnValue(0) }

        p = 6
        io = 0
        // I O _
        IfCondition EqualTo(RDMEM_8(name, 6), 73) ThenBlock: {
            IfCondition EqualTo(RDMEM_8(name, 7), 79) ThenBlock: {
                IfCondition EqualTo(RDMEM_8(name, 8), 95) ThenBlock: {
                    io = 1
                    p = 9
                }
            }
        }
        sgn = 0
        // S
        IfCondition EqualTo(RDMEM_8(name, p), 83) ThenBlock: {
            sgn = 1
            p = Add(p, 1)
        }
        d0 = RDMEM_8(name, p)
        d1 = 0
        IfCondition NotEqual(d0, 0) ThenBlock: { d1 = RDMEM_8(name, Add(p, 1)) }
        d2 = 0
        IfCondition NotEqual(d1, 0) ThenBlock: { d2 = RDMEM_8(name, Add(p, 2)) }
        IfCondition NotEqual(d2, 0) ThenBlock: { ReturnValue(-1) }

        size = 0
        // 8, 16, 32, 64
        IfCondition EqualTo(d0, 56) ThenBlock: {
            IfCondition EqualTo(d1, 0) ThenBlock: { size = 1 }
        }
        IfCondition EqualTo(d0, 49) ThenBlock: {
            IfCondition EqualTo(d1, 54) ThenBlock: { size = 2 }
        }
        IfCondition EqualTo(d0, 51) ThenBlock: {
            IfCondition EqualTo(d1, 50) ThenBlock: { size = 4 }
        }
        IfCondition EqualTo(d0, 54) ThenBlock: {
            IfCondition EqualTo(d1, 52) ThenBlock: { size = 8 }
        }
        IfCondition EqualTo(size, 0) ThenBlock: { ReturnValue(-1) }
        // Sign extension is a read of 8, 16, or 32 bits.
        IfCondition EqualTo(sgn, 1) ThenBlock: {
            IfCondition EqualTo(op, 2) ThenBlock: { ReturnValue(-1) }
            IfCondition EqualTo(size, 8) ThenBlock: { ReturnValue(-1) }
        }
        ReturnValue(Add(Add(op, Multiply(io, 4)), Add(Multiply(sgn, 8), Multiply(size, 16))))
    }
}

Function.MemPrim_Op {
    Input: code: Integer
    Output: Integer
    Body: { ReturnValue(BitwiseAnd(code, 3)) }
}

Function.MemPrim_IsIO {
    Input: code: Integer
    Output: Integer
    Body: { ReturnValue(BitwiseAnd(RightShift(code, 2), 1)) }
}

Function.MemPrim_Signed {
    Input: code: Integer
    Output: Integer
    Body: { ReturnValue(BitwiseAnd(RightShift(code, 3), 1)) }
}

Function.MemPrim_Size {
    Input: code: Integer
    Output: Integer
    Body: { ReturnValue(RightShift(code, 4)) }
}

// =============================================================================
// SHAPE TESTS
// The Name forms take a call name; the Node forms take a node and are 0
// for anything that is not a call.
// =============================================================================

// Decoded code for a plain (non-IO) memory name, else 0.
Function.MemName_Code {
    Input: name: Address
    Output: Integer
    Body: {
        code = MemPrim_Decode(name)
        IfCondition LessThan(code, 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(MemPrim_IsIO(code), 1) ThenBlock: { ReturnValue(0) }
        ReturnValue(code)
    }
}

// 1 for the unsigned byte name of op (RDMEM_8 / WRMEM_8).
Function.MemPrim_IsByteCode {
    Input: code: Integer
    Output: Integer
    Body: {
        IfCondition NotEqual(MemPrim_Size(code), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(MemPrim_Signed(code), 1) ThenBlock: { ReturnValue(0) }
        ReturnValue(1)
    }
}

// RDMEM_8(base, offset)
Function.MemName_IsByteAt {
    Input: name: Address
    Output: Integer
    Body: {
        code = MemName_Code(name)
        IfCondition NotEqual(MemPrim_Op(code), 1) ThenBlock: { ReturnValue(0) }
        ReturnValue(MemPrim_IsByteCode(code))
    }
}

// WRMEM_8(base, offset, value)
Function.MemName_IsByteSetAt {
    Input: name: Address
    Output: Integer
    Body: {
        code = MemName_Code(name)
        IfCondition NotEqual(MemPrim_Op(code), 2) ThenBlock: { ReturnValue(0) }
        ReturnValue(MemPrim_IsByteCode(code))
    }
}

// Flat read RDMEM_<w>(addr): every read but RDMEM_8.
Function.MemName_IsLoad {
    Input: name: Address
    Output: Integer
    Body: {
        code = MemName_Code(name)
        IfCondition NotEqual(MemPrim_Op(code), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(MemPrim_IsByteCode(code), 1) ThenBlock: { ReturnValue(0) }
        ReturnValue(1)
    }
}

// Flat write WRMEM_<w>(addr, value): every write but WRMEM_8.
Function.MemName_IsStore {
    Input: name: Address
    Output: Integer
    Body: {
        code = MemName_Code(name)
        IfCondition NotEqual(MemPrim_Op(code), 2) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(MemPrim_IsByteCode(code), 1) ThenBlock: { ReturnValue(0) }
        ReturnValue(1)
    }
}

// RDMEM_64(addr)
Function.MemName_IsLoad64 {
    Input: name: Address
    Output: Integer
    Body: {
        code = MemName_Code(name)
        IfCondition NotEqual(MemPrim_Op(code), 1) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(MemPrim_Size(code), 8) ThenBlock: { ReturnValue(0) }
        ReturnValue(1)
    }
}

// WRMEM_64(addr, value)
Function.MemName_IsStore64 {
    Input: name: Address
    Output: Integer
    Body: {
        code = MemName_Code(name)
        IfCondition NotEqual(MemPrim_Op(code), 2) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(MemPrim_Size(code), 8) ThenBlock: { ReturnValue(0) }
        ReturnValue(1)
    }
}

// The name of node when it is a call, else 0.
Function.MemNode_Name {
    Input: node: Address
    Output: Address
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(AST_GetType(node), AST.CALL) ThenBlock: { ReturnValue(0) }
        ReturnValue(AST_GetData1(node))
    }
}

Function.MemNode_IsByteAt {
    Input: node: Address
    Output: Integer
    Body: { ReturnValue(MemName_IsByteAt(MemNode_Name(node))) }
}

Function.MemNode_IsByteSetAt {
    Input: node: Address
    Output: Integer
    Body: { ReturnValue(MemName_IsByteSetAt(MemNode_Name(node))) }
}

Function.MemNode_IsLoad {
    Input: node: Address
    Output: Integer
    Body: { ReturnValue(MemName_IsLoad(MemNode_Name(node))) }
}

Function.MemNode_IsStore {
    Input: node: Address
    Output: Integer
    Body: { ReturnValue(MemName_IsStore(MemNode_Name(node))) }
}

Function.MemNode_IsLoad64 {
    Input: node: Address
    Output: Integer
    Body: { ReturnValue(MemName_IsLoad64(MemNode_Name(node))) }
}

Function.MemNode_IsStore64 {
    Input: node: Address
    Output: Integer
    Body: { ReturnValue(MemName_IsStore64(MemNode_Name(node))) }
}
