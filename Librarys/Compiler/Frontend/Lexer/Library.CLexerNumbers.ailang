// Library.CLexerNumbers.ailang
// Number lexing for the AILang self-hosting compiler
// Handles: integers, hex (0x), octal (0o), binary (0b), floats, scientific notation
//
// BOOTSTRAP FIX: Returns DECIMAL string for all number types
// so StringToNumber() works without modification

LibraryImport.Arrays
LibraryImport.Compiler.Frontend.Lexer.CLexerTypes
LibraryImport.Compiler.Frontend.Lexer.CLexerCore

// =============================================================================
// HEX DIGIT CHECK
// =============================================================================
Function.Lex_IsHexDigit {
    Input: c: Integer
    Output: Integer
    Body: {
        is_digit = Lex_IsDigit(c)
        is_upper_hex = And(GreaterEqual(c, 65), LessEqual(c, 70))   // A-F
        is_lower_hex = And(GreaterEqual(c, 97), LessEqual(c, 102))  // a-f
        
        result = Or(Or(is_digit, is_upper_hex), is_lower_hex)
        ReturnValue(result)
    }
}

// =============================================================================
// HEX DIGIT VALUE (0-15)
// =============================================================================
Function.Lex_HexDigitValue {
    Input: c: Integer
    Output: Integer
    Body: {
        // 0-9 -> 0-9
        IfCondition And(GreaterEqual(c, 48), LessEqual(c, 57)) ThenBlock: {
            ReturnValue(Subtract(c, 48))
        }
        // a-f -> 10-15
        IfCondition And(GreaterEqual(c, 97), LessEqual(c, 102)) ThenBlock: {
            ReturnValue(Subtract(c, 87))
        }
        // A-F -> 10-15
        IfCondition And(GreaterEqual(c, 65), LessEqual(c, 70)) ThenBlock: {
            ReturnValue(Subtract(c, 55))
        }
        ReturnValue(0)
    }
}

// =============================================================================
// BINARY DIGIT CHECK
// =============================================================================
Function.Lex_IsBinaryDigit {
    Input: c: Integer
    Output: Integer
    Body: {
        result = Or(EqualTo(c, 48), EqualTo(c, 49))  // '0' or '1'
        ReturnValue(result)
    }
}

// =============================================================================
// OCTAL DIGIT CHECK
// =============================================================================
Function.Lex_IsOctalDigit {
    Input: c: Integer
    Output: Integer
    Body: {
        result = And(GreaterEqual(c, 48), LessEqual(c, 55))  // '0'-'7'
        ReturnValue(result)
    }
}

// =============================================================================
// WRITE INTEGER TO LEXER BUFFER AS DECIMAL
// Uses lexer buffer system, not Allocate
// =============================================================================
// Write unsigned 64-bit value as 0xHHHH... (16 hex digits).
// Used so bit-63 values never pass through signed abs/itoa (which corrupted
// IEEE double bit patterns like 0xBFF0... = -1.0).
Function.Lex_WriteU64HexToBuffer {
    Input: value: Integer
    Body: {
        Lex_BufAppend(48)   // '0'
        Lex_BufAppend(120)  // 'x'
        // 16 nibbles, MSB first. RightShift is logical SHR — safe for bit 63.
        i = 15
        done = 0
        WhileLoop EqualTo(done, 0) {
            shift = Multiply(i, 4)
            nib = BitwiseAnd(RightShift(value, shift), 0xF)
            IfCondition LessThan(nib, 10) ThenBlock: {
                Lex_BufAppend(Add(48, nib))       // '0'+nib
            } ElseBlock: {
                Lex_BufAppend(Add(87, nib))       // 'a'+nib-10
            }
            IfCondition EqualTo(i, 0) ThenBlock: {
                done = 1
            } ElseBlock: {
                i = Subtract(i, 1)
            }
        }
        ReturnValue(0)
    }
}

Function.Lex_WriteIntToBuffer {
    Input: value: Integer
    Input: is_negative: Integer
    Body: {
        // Handle zero specially
        IfCondition EqualTo(value, 0) ThenBlock: {
            IfCondition EqualTo(is_negative, 1) ThenBlock: {
                Lex_BufAppend(45)  // '-'
            }
            Lex_BufAppend(48)  // '0'
            ReturnValue(0)
        }

        // Only apply arithmetic negation when the source had an explicit '-'.
        // NEVER treat high bit alone as signed negative for hex/bin/oct values —
        // that rewrote 0xBFF0... (-1.0 double bits) into 0x4010... (4.0).
        abs_value = value
        IfCondition EqualTo(is_negative, 1) ThenBlock: {
            IfCondition LessThan(value, 0) ThenBlock: {
                abs_value = Subtract(0, value)
            }
        } ElseBlock: {
            // Unsigned path: if bit 63 set, emit 0x... hex (full bit fidelity).
            // StringToNumber must accept 0x prefix (see CompileStringCore).
            // Construct 1<<63 without a high-bit hex literal (host StringToNumber
            // used to corrupt 0x8000... when compiling this very file).
            sign_mask = BitwiseNot(0x7FFFFFFFFFFFFFFF)
            signbit = BitwiseAnd(value, sign_mask)
            IfCondition NotEqual(signbit, 0) ThenBlock: {
                Lex_WriteU64HexToBuffer(value)
                ReturnValue(0)
            }
        }

        // Count digits (abs_value is non-negative signed here)
        temp = abs_value
        digit_count = 0
        WhileLoop GreaterThan(temp, 0) {
            digit_count = Add(digit_count, 1)
            temp = Divide(temp, 10)
        }

        IfCondition EqualTo(is_negative, 1) ThenBlock: {
            Lex_BufAppend(45)  // '-'
        }

        divisor = 1
        i = 1
        WhileLoop LessThan(i, digit_count) {
            divisor = Multiply(divisor, 10)
            i = Add(i, 1)
        }

        remaining = abs_value
        WhileLoop GreaterThan(divisor, 0) {
            digit = Divide(remaining, divisor)
            Lex_BufAppend(Add(48, digit))
            remaining = Modulo(remaining, divisor)
            divisor = Divide(divisor, 10)
        }

        ReturnValue(0)
    }
}

// =============================================================================
// READ HEX NUMBER (after detecting 0x prefix)
// Returns decimal string representation
// =============================================================================
Function.Lex_ReadHexNumber {
    Input: is_negative: Integer
    Output: Address
    Body: {
        // Skip 0x prefix (caller already peeked)
        Lex_Advance()  // skip '0'
        Lex_Advance()  // skip 'x' or 'X'
        
        // Parse hex digits into numeric value
        value = 0
        has_digits = 0
        
        WhileLoop EqualTo(1, 1) {
            c = Lex_CurrentChar()
            
            // Skip underscores
            IfCondition EqualTo(c, ASCII.UNDERSCORE) ThenBlock: {
                Lex_Advance()
                ContinueLoop
            }
            
            is_hex = Lex_IsHexDigit(c)
            IfCondition EqualTo(is_hex, 0) ThenBlock: {
                BreakLoop
            }
            
            digit_val = Lex_HexDigitValue(c)
            value = Add(Multiply(value, 16), digit_val)
            has_digits = 1
            Lex_Advance()
        }
        
        IfCondition EqualTo(has_digits, 0) ThenBlock: {
            Lex_Error("Invalid hex literal: no digits after 0x")
            ReturnValue(0)
        }
        
        // Convert to decimal string using lexer buffer
        Lex_BufClear()
        Lex_WriteIntToBuffer(value, is_negative)
        result = Lex_BufGetString()
        ReturnValue(result)
    }
}

// =============================================================================
// READ BINARY NUMBER (after detecting 0b prefix)
// Returns decimal string representation
// =============================================================================
Function.Lex_ReadBinaryNumber {
    Input: is_negative: Integer
    Output: Address
    Body: {
        // Skip 0b prefix
        Lex_Advance()  // skip '0'
        Lex_Advance()  // skip 'b' or 'B'
        
        // Parse binary digits into numeric value
        value = 0
        has_digits = 0
        
        WhileLoop EqualTo(1, 1) {
            c = Lex_CurrentChar()
            
            // Skip underscores
            IfCondition EqualTo(c, ASCII.UNDERSCORE) ThenBlock: {
                Lex_Advance()
                ContinueLoop
            }
            
            is_bin = Lex_IsBinaryDigit(c)
            IfCondition EqualTo(is_bin, 0) ThenBlock: {
                BreakLoop
            }
            
            // value = value * 2 + (c - '0')
            digit_val = Subtract(c, 48)
            value = Add(Multiply(value, 2), digit_val)
            has_digits = 1
            Lex_Advance()
        }
        
        IfCondition EqualTo(has_digits, 0) ThenBlock: {
            Lex_Error("Invalid binary literal: no digits after 0b")
            ReturnValue(0)
        }
        
        // Convert to decimal string using lexer buffer
        Lex_BufClear()
        Lex_WriteIntToBuffer(value, is_negative)
        result = Lex_BufGetString()
        ReturnValue(result)
    }
}

// =============================================================================
// READ OCTAL NUMBER (after detecting 0o prefix)
// Returns decimal string representation
// =============================================================================
Function.Lex_ReadOctalNumber {
    Input: is_negative: Integer
    Output: Address
    Body: {
        // Skip 0o prefix
        Lex_Advance()  // skip '0'
        Lex_Advance()  // skip 'o' or 'O'
        
        // Parse octal digits into numeric value
        value = 0
        has_digits = 0
        
        WhileLoop EqualTo(1, 1) {
            c = Lex_CurrentChar()
            
            // Skip underscores
            IfCondition EqualTo(c, ASCII.UNDERSCORE) ThenBlock: {
                Lex_Advance()
                ContinueLoop
            }
            
            is_oct = Lex_IsOctalDigit(c)
            IfCondition EqualTo(is_oct, 0) ThenBlock: {
                BreakLoop
            }
            
            // value = value * 8 + (c - '0')
            digit_val = Subtract(c, 48)
            value = Add(Multiply(value, 8), digit_val)
            has_digits = 1
            Lex_Advance()
        }
        
        IfCondition EqualTo(has_digits, 0) ThenBlock: {
            Lex_Error("Invalid octal literal: no digits after 0o")
            ReturnValue(0)
        }
        
        // Convert to decimal string using lexer buffer
        Lex_BufClear()
        Lex_WriteIntToBuffer(value, is_negative)
        result = Lex_BufGetString()
        ReturnValue(result)
    }
}

// =============================================================================
// READ NUMBER (Main Entry Point)
// Handles: decimal, hex (0x), octal (0o), binary (0b), floats, scientific notation
// Returns decimal string value (so StringToNumber works correctly)
// =============================================================================
Function.Lex_ReadNumber {
    Output: Address
    Body: {
        Lex_BufClear()
        
        c = Lex_CurrentChar()
        
        // Handle negative sign
        is_negative = 0
        IfCondition EqualTo(c, ASCII.DASH) ThenBlock: {
            is_negative = 1
            Lex_Advance()
            c = Lex_CurrentChar()
        }
        
        // Check for hex (0x), binary (0b), or octal (0o)
        IfCondition EqualTo(c, ASCII.ZERO) ThenBlock: {
            next = Lex_PeekChar(1)
            
            // Hex: 0x or 0X (120='x', 88='X')
            IfCondition Or(EqualTo(next, 120), EqualTo(next, 88)) ThenBlock: {
                ReturnValue(Lex_ReadHexNumber(is_negative))
            }
            
            // Binary: 0b or 0B (98='b', 66='B')
            IfCondition Or(EqualTo(next, 98), EqualTo(next, 66)) ThenBlock: {
                ReturnValue(Lex_ReadBinaryNumber(is_negative))
            }
            
            // Octal: 0o or 0O (111='o', 79='O')
            IfCondition Or(EqualTo(next, 111), EqualTo(next, 79)) ThenBlock: {
                ReturnValue(Lex_ReadOctalNumber(is_negative))
            }
        }
        
        // Regular decimal number - use original buffer approach
        // Put back negative sign if present
        IfCondition EqualTo(is_negative, 1) ThenBlock: {
            Lex_BufAppend(ASCII.DASH)
        }
        
        // Read decimal digits (with optional decimal point and exponent)
        has_dot = 0
        has_exp = 0
        has_digits = 0
        
        WhileLoop EqualTo(1, 1) {
            c = Lex_CurrentChar()
            
            // Check for digit
            is_digit = Lex_IsDigit(c)
            IfCondition EqualTo(is_digit, 1) ThenBlock: {
                Lex_BufAppend(c)
                Lex_Advance()
                has_digits = 1
                ContinueLoop
            }
            
            // Check for underscore (skip in output)
            IfCondition EqualTo(c, ASCII.UNDERSCORE) ThenBlock: {
                Lex_Advance()
                ContinueLoop
            }
            
            // Check for decimal point
            IfCondition EqualTo(c, ASCII.DOT) ThenBlock: {
                // Only one decimal point allowed
                IfCondition EqualTo(has_dot, 1) ThenBlock: {
                    BreakLoop
                }
                // Make sure next char is digit (not another dot or identifier)
                next = Lex_PeekChar(1)
                next_is_digit = Lex_IsDigit(next)
                IfCondition EqualTo(next_is_digit, 0) ThenBlock: {
                    BreakLoop
                }
                has_dot = 1
                Lex_BufAppend(c)
                Lex_Advance()
                ContinueLoop
            }
            
            // Check for exponent (e or E)
            is_exp_char = Or(EqualTo(c, 101), EqualTo(c, 69))  // 'e' or 'E'
            IfCondition EqualTo(is_exp_char, 1) ThenBlock: {
                // Only one exponent allowed
                IfCondition EqualTo(has_exp, 1) ThenBlock: {
                    BreakLoop
                }
                has_exp = 1
                Lex_BufAppend(c)
                Lex_Advance()
                
                // Check for sign after exponent
                c = Lex_CurrentChar()
                is_sign = Or(EqualTo(c, ASCII.PLUS), EqualTo(c, ASCII.DASH))
                IfCondition EqualTo(is_sign, 1) ThenBlock: {
                    Lex_BufAppend(c)
                    Lex_Advance()
                }
                
                // Must have at least one digit after exponent
                c = Lex_CurrentChar()
                exp_digit = Lex_IsDigit(c)
                IfCondition EqualTo(exp_digit, 0) ThenBlock: {
                    Lex_Error("Invalid number: expected digit after exponent")
                    ReturnValue(0)
                }
                ContinueLoop
            }
            
            // Not part of number - exit loop
            BreakLoop
        }
        
        // Validate we have at least one digit
        IfCondition EqualTo(has_digits, 0) ThenBlock: {
            Lex_Error("Invalid number: no digits")
            ReturnValue(0)
        }
        
        result = Lex_BufGetString()
        ReturnValue(result)
    }
}

// =============================================================================
// CHECK IF AT NUMBER START
// Returns 1 if current position could start a number
// =============================================================================
Function.Lex_AtNumberStart {
    Output: Integer
    Body: {
        c = Lex_CurrentChar()
        
        // Direct digit
        is_digit = Lex_IsDigit(c)
        IfCondition EqualTo(is_digit, 1) ThenBlock: {
            ReturnValue(1)
        }
        
        // Negative number: - followed by digit
        IfCondition EqualTo(c, ASCII.DASH) ThenBlock: {
            next = Lex_PeekChar(1)
            next_digit = Lex_IsDigit(next)
            ReturnValue(next_digit)
        }
        
        ReturnValue(0)
    }
}