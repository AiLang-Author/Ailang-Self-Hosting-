// Library.CAutoImport.ailang
// Automatic dependency injection for Core libraries
// Runs BEFORE Import_ResolveAll to inject missing imports


LibraryImport.Compiler.Import.CCoreRegistry

// =============================================================================
// STATE
// =============================================================================
FixedPool.AutoImport {
    "needed_libs": Initialize=0      // Array of library names to inject
    "needed_count": Initialize=0
    "capacity": Initialize=64
    "initialized": Initialize=0
    "debug": Initialize=0            // Set to 1 for verbose output
}

// =============================================================================
// MAIN ENTRY POINT
// Called before Import_ResolveAll
// Returns modified source with injected imports
// =============================================================================
Function.AutoImport_Resolve {
    Input: source: Address
    Output: Address
    Body: {
        IfCondition EqualTo(source, 0) ThenBlock: {
            ReturnValue(0)
        }
        
        // Initialize if needed
        IfCondition EqualTo(AutoImport.initialized, 0) ThenBlock: {
            AutoImport.needed_libs = ArrayCreate(AutoImport.capacity)
            AutoImport.initialized = 1
        }
        
        // Reset needed list
        AutoImport.needed_count = 0
        
        // Ensure registry is initialized
        CoreRegistry_Init()
        
        // Scan source for function calls that need Core libraries
        AutoImport_ScanSource(source)
        
        // Check which needed libs are already imported
        AutoImport_FilterExisting(source)
        
        // Inject missing imports
        IfCondition GreaterThan(AutoImport.needed_count, 0) ThenBlock: {
            source = AutoImport_InjectImports(source)
        }
        
        ReturnValue(source)
    }
}

// =============================================================================
// SOURCE SCANNER
// Finds function calls and checks against CoreRegistry
// =============================================================================
Function.AutoImport_ScanSource {
    Input: source: Address
    Body: {
        len = StringLength(source)
        pos = 0
        
        WhileLoop LessThan(pos, len) {
            c = GetByte(source, pos)
            
            // Look for identifier start (letter or underscore)
            is_alpha = AutoImport_IsAlpha(c)
            IfCondition EqualTo(is_alpha, 1) ThenBlock: {
                // Check if previous char makes this a call (not definition)
                // We want: X( but not Function.X or Input: X
                is_call_context = AutoImport_IsCallContext(source, pos, len)
                
                IfCondition EqualTo(is_call_context, 1) ThenBlock: {
                    // Extract identifier
                    ident = AutoImport_ExtractIdent(source, pos, len)
                    ident_len = StringLength(ident)
                    
                    IfCondition GreaterThan(ident_len, 0) ThenBlock: {
                        // Look up in registry
                        lib = CoreRegistry_Lookup(ident)
                        
                        IfCondition NotEqual(lib, 0) ThenBlock: {
                            // Found! Add to needed list if not already there
                            AutoImport_AddNeeded(lib)
                            
                            IfCondition EqualTo(AutoImport.debug, 1) ThenBlock: {
                                PrintMessage("[AUTOIMPORT] Found call to ")
                                PrintMessage(ident)
                                PrintMessage(" -> needs ")
                                PrintMessage(lib)
                                PrintMessage("\n")
                            }
                        }
                    }
                    
                    // Skip past this identifier
                    pos = Add(pos, ident_len)
                }
            }
            
            pos = Add(pos, 1)
        }
    }
}

// =============================================================================
// CALL CONTEXT CHECK
// Returns 1 if position looks like a function call, not a definition
// =============================================================================
Function.AutoImport_IsCallContext {
    Input: source: Address
    Input: pos: Integer
    Input: len: Integer
    Output: Integer
    Body: {
        // Skip if at start
        IfCondition EqualTo(pos, 0) ThenBlock: {
            ReturnValue(1)
        }
        
        // Check previous non-whitespace
        check_pos = Subtract(pos, 1)
        WhileLoop GreaterEqual(check_pos, 0) {
            c = GetByte(source, check_pos)
            
            // Skip whitespace
            IfCondition EqualTo(c, 32) ThenBlock: {
                check_pos = Subtract(check_pos, 1)
            } ElseBlock: {
                IfCondition EqualTo(c, 9) ThenBlock: {
                    check_pos = Subtract(check_pos, 1)
                } ElseBlock: {
                    BreakLoop
                }
            }
        }
        
        IfCondition LessThan(check_pos, 0) ThenBlock: {
            ReturnValue(1)
        }
        
        prev_c = GetByte(source, check_pos)
        
        // If previous is '.', check if it's "Function."
        IfCondition EqualTo(prev_c, 46) ThenBlock: {
            // Check for "Function" before the dot
            IfCondition GreaterEqual(check_pos, 8) ThenBlock: {
                match = AutoImport_MatchBackward(source, Subtract(check_pos, 8), "Function")
                IfCondition EqualTo(match, 1) ThenBlock: {
                    ReturnValue(0)  // This is a definition
                }
            }
            // Otherwise it's like "XArray.XPush" - still a call
            ReturnValue(1)
        }
        
        // If previous is ':', likely "Input: name" or "Output: name"
        IfCondition EqualTo(prev_c, 58) ThenBlock: {
            ReturnValue(0)
        }
        
        // Most other contexts are calls
        ReturnValue(1)
    }
}

// =============================================================================
// EXTRACT IDENTIFIER
// =============================================================================
Function.AutoImport_ExtractIdent {
    Input: source: Address
    Input: start: Integer
    Input: len: Integer
    Output: Address
    Body: {
        end_pos = start
        
        WhileLoop LessThan(end_pos, len) {
            c = GetByte(source, end_pos)
            
            is_alnum = AutoImport_IsAlphaNum(c)
            IfCondition EqualTo(is_alnum, 0) ThenBlock: {
                BreakLoop
            }
            
            end_pos = Add(end_pos, 1)
        }
        
        ident_len = Subtract(end_pos, start)
        IfCondition LessEqual(ident_len, 0) ThenBlock: {
            ReturnValue(0)
        }
        
        // Allocate using raw syscall
        alloc_size = Add(ident_len, 1)
        ident = AutoImport_RawAlloc(alloc_size)
        
        i = 0
        WhileLoop LessThan(i, ident_len) {
            c = GetByte(source, Add(start, i))
            SetByte(ident, i, c)
            i = Add(i, 1)
        }
        SetByte(ident, ident_len, 0)
        
        ReturnValue(ident)
    }
}

// =============================================================================
// ADD TO NEEDED LIST (if not duplicate)
// =============================================================================
Function.AutoImport_AddNeeded {
    Input: lib_name: Address
    Body: {
        // Check for duplicate
        count = AutoImport.needed_count
        i = 0
        WhileLoop LessThan(i, count) {
            existing = ArrayGet(AutoImport.needed_libs, i)
            eq = CoreRegistry_StrEq(lib_name, existing)
            IfCondition EqualTo(eq, 1) ThenBlock: {
                ReturnValue(0)  // Already in list
            }
            i = Add(i, 1)
        }
        
        // Add to list
        IfCondition LessThan(count, AutoImport.capacity) ThenBlock: {
            ArraySet(AutoImport.needed_libs, count, lib_name)
            AutoImport.needed_count = Add(count, 1)
        }
    }
}

// =============================================================================
// FILTER OUT ALREADY-IMPORTED LIBRARIES
// =============================================================================
Function.AutoImport_FilterExisting {
    Input: source: Address
    Body: {
        // For each needed lib, check if already imported
        i = 0
        WhileLoop LessThan(i, AutoImport.needed_count) {
            lib_name = ArrayGet(AutoImport.needed_libs, i)
            
            // Build import pattern: "LibraryImport.Core.Arena"
            pattern = AutoImport_BuildImportPattern(lib_name)
            
            found = AutoImport_Contains(source, pattern)
            IfCondition EqualTo(found, 1) ThenBlock: {
                // Already imported - remove from needed list
                AutoImport_RemoveNeeded(i)
                // Don't increment i since we shifted the array
            } ElseBlock: {
                i = Add(i, 1)
            }
        }
    }
}

// =============================================================================
// BUILD IMPORT PATTERN
// "Core.Arena" -> "LibraryImport.Core.Arena"
// =============================================================================
Function.AutoImport_BuildImportPattern {
    Input: lib_name: Address
    Output: Address
    Body: {
        prefix = "LibraryImport."
        prefix_len = 14
        lib_len = StringLength(lib_name)
        total_len = Add(prefix_len, lib_len)
        
        result = AutoImport_RawAlloc(Add(total_len, 1))
        
        // Copy prefix
        i = 0
        WhileLoop LessThan(i, prefix_len) {
            c = GetByte(prefix, i)
            SetByte(result, i, c)
            i = Add(i, 1)
        }
        
        // Copy lib name
        j = 0
        WhileLoop LessThan(j, lib_len) {
            c = GetByte(lib_name, j)
            SetByte(result, Add(prefix_len, j), c)
            j = Add(j, 1)
        }
        
        SetByte(result, total_len, 0)
        ReturnValue(result)
    }
}

// =============================================================================
// REMOVE FROM NEEDED LIST
// =============================================================================
Function.AutoImport_RemoveNeeded {
    Input: index: Integer
    Body: {
        count = AutoImport.needed_count
        
        // Shift remaining elements down
        i = index
        last = Subtract(count, 1)
        WhileLoop LessThan(i, last) {
            next_val = ArrayGet(AutoImport.needed_libs, Add(i, 1))
            ArraySet(AutoImport.needed_libs, i, next_val)
            i = Add(i, 1)
        }
        
        AutoImport.needed_count = Subtract(count, 1)
    }
}

// =============================================================================
// INJECT IMPORTS
// Prepends missing LibraryImport statements to source
// =============================================================================
Function.AutoImport_InjectImports {
    Input: source: Address
    Output: Address
    Body: {
        count = AutoImport.needed_count
        
        IfCondition EqualTo(count, 0) ThenBlock: {
            ReturnValue(source)
        }
        
        PrintMessage("[AUTOIMPORT] Injecting ")
        PrintNumber(count)
        PrintMessage(" Core imports:\n")
        
        // Build injection string
        result = source
        
        i = 0
        WhileLoop LessThan(i, count) {
            lib_name = ArrayGet(AutoImport.needed_libs, i)
            
            PrintMessage("[AUTOIMPORT]   LibraryImport.")
            PrintMessage(lib_name)
            PrintMessage("\n")
            
            // Build "LibraryImport.X\n"
            import_line = AutoImport_BuildImportLine(lib_name)
            
            // Prepend to result
            result = AutoImport_Concat(import_line, result)
            
            i = Add(i, 1)
        }
        
        ReturnValue(result)
    }
}

// =============================================================================
// BUILD IMPORT LINE
// "Core.Arena" -> "LibraryImport.Core.Arena\n"
// =============================================================================
Function.AutoImport_BuildImportLine {
    Input: lib_name: Address
    Output: Address
    Body: {
        prefix = "LibraryImport."
        prefix_len = 14
        lib_len = StringLength(lib_name)
        total_len = Add(Add(prefix_len, lib_len), 1)  // +1 for newline
        
        result = AutoImport_RawAlloc(Add(total_len, 1))
        
        // Copy prefix
        i = 0
        WhileLoop LessThan(i, prefix_len) {
            c = GetByte(prefix, i)
            SetByte(result, i, c)
            i = Add(i, 1)
        }
        
        // Copy lib name
        j = 0
        WhileLoop LessThan(j, lib_len) {
            c = GetByte(lib_name, j)
            SetByte(result, Add(prefix_len, j), c)
            j = Add(j, 1)
        }
        
        // Add newline
        newline_pos = Add(prefix_len, lib_len)
        SetByte(result, newline_pos, 10)
        SetByte(result, Add(newline_pos, 1), 0)
        
        ReturnValue(result)
    }
}

// =============================================================================
// STRING CONCATENATION (no StringConcat dependency)
// =============================================================================
Function.AutoImport_Concat {
    Input: s1: Address
    Input: s2: Address
    Output: Address
    Body: {
        len1 = StringLength(s1)
        len2 = StringLength(s2)
        total = Add(len1, len2)
        
        result = AutoImport_RawAlloc(Add(total, 1))
        
        // Copy s1
        i = 0
        WhileLoop LessThan(i, len1) {
            c = GetByte(s1, i)
            SetByte(result, i, c)
            i = Add(i, 1)
        }
        
        // Copy s2
        j = 0
        WhileLoop LessThan(j, len2) {
            c = GetByte(s2, j)
            SetByte(result, Add(len1, j), c)
            j = Add(j, 1)
        }
        
        SetByte(result, total, 0)
        ReturnValue(result)
    }
}

// =============================================================================
// SUBSTRING SEARCH
// =============================================================================
Function.AutoImport_Contains {
    Input: source: Address
    Input: pattern: Address
    Output: Integer
    Body: {
        src_len = StringLength(source)
        pat_len = StringLength(pattern)
        
        IfCondition GreaterThan(pat_len, src_len) ThenBlock: {
            ReturnValue(0)
        }
        
        max_pos = Subtract(src_len, pat_len)
        pos = 0
        
        WhileLoop LessEqual(pos, max_pos) {
            match = 1
            i = 0
            WhileLoop LessThan(i, pat_len) {
                c1 = GetByte(source, Add(pos, i))
                c2 = GetByte(pattern, i)
                IfCondition NotEqual(c1, c2) ThenBlock: {
                    match = 0
                    BreakLoop
                }
                i = Add(i, 1)
            }
            
            IfCondition EqualTo(match, 1) ThenBlock: {
                ReturnValue(1)
            }
            
            pos = Add(pos, 1)
        }
        
        ReturnValue(0)
    }
}

// =============================================================================
// BACKWARD PATTERN MATCH
// =============================================================================
Function.AutoImport_MatchBackward {
    Input: source: Address
    Input: pos: Integer
    Input: pattern: Address
    Output: Integer
    Body: {
        pat_len = StringLength(pattern)
        
        i = 0
        WhileLoop LessThan(i, pat_len) {
            c1 = GetByte(source, Add(pos, i))
            c2 = GetByte(pattern, i)
            IfCondition NotEqual(c1, c2) ThenBlock: {
                ReturnValue(0)
            }
            i = Add(i, 1)
        }
        
        ReturnValue(1)
    }
}

// =============================================================================
// CHARACTER CLASSIFICATION
// =============================================================================
Function.AutoImport_IsAlpha {
    Input: c: Integer
    Output: Integer
    Body: {
        // A-Z: 65-90, a-z: 97-122, _: 95
        IfCondition And(GreaterEqual(c, 65), LessEqual(c, 90)) ThenBlock: {
            ReturnValue(1)
        }
        IfCondition And(GreaterEqual(c, 97), LessEqual(c, 122)) ThenBlock: {
            ReturnValue(1)
        }
        IfCondition EqualTo(c, 95) ThenBlock: {
            ReturnValue(1)
        }
        ReturnValue(0)
    }
}

Function.AutoImport_IsAlphaNum {
    Input: c: Integer
    Output: Integer
    Body: {
        is_alpha = AutoImport_IsAlpha(c)
        IfCondition EqualTo(is_alpha, 1) ThenBlock: {
            ReturnValue(1)
        }
        // 0-9: 48-57
        IfCondition And(GreaterEqual(c, 48), LessEqual(c, 57)) ThenBlock: {
            ReturnValue(1)
        }
        ReturnValue(0)
    }
}

// =============================================================================
// RAW ALLOCATION (no Arena dependency)
// =============================================================================
Function.AutoImport_RawAlloc {
    Input: size: Integer
    Output: Address
    Body: {
        // mmap syscall
        addr = SystemCall(9, 0, size, 3, 34, -1, 0)
        ReturnValue(addr)
    }
}