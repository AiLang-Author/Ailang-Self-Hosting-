// Library.CCoreRegistry.ailang
// Scans Librarys/Core/ at startup, builds function→library map
// Uses ONLY builtin arrays (no XArrays) to avoid bootstrap issues
//

// =============================================================================
// REGISTRY STATE
// Uses builtin ArrayCreate - no library dependencies
// =============================================================================
FixedPool.CoreRegistry {
    "func_names": Initialize=0      // Array of function name strings
    "lib_names": Initialize=0       // Array of corresponding library names
    "count": Initialize=0
    "capacity": Initialize=512
    "initialized": Initialize=0
    "core_path": Initialize=0       // "Librarys/Core/"
}

// =============================================================================
// INITIALIZATION
// =============================================================================
Function.CoreRegistry_Init {
    Output: Integer
    Body: {
        IfCondition EqualTo(CoreRegistry.initialized, 1) ThenBlock: {
            ReturnValue(1)
        }
        
        PrintMessage("[CORE] Initializing Core Registry...\n")
        
        // Create storage arrays using builtins
        CoreRegistry.func_names = ArrayCreate(CoreRegistry.capacity)
        CoreRegistry.lib_names = ArrayCreate(CoreRegistry.capacity)
        CoreRegistry.core_path = "Librarys/Core/"
        CoreRegistry.count = 0
        
        // Scan known core libraries
        // TODO: Replace with ListDirectory when available
        CoreRegistry_ScanFile("Librarys/Core/Library.Arena.ailang", "Core.Arena")
        CoreRegistry_ScanFile("Librarys/Core/Library.XArrays.ailang", "Core.XArrays")
        
        CoreRegistry.initialized = 1
        
        PrintMessage("[CORE] Registry initialized: ")
        PrintNumber(CoreRegistry.count)
        PrintMessage(" functions from Core libraries\n")
        
        ReturnValue(1)
    }
}

// =============================================================================
// FILE SCANNER
// Extracts Function.Name patterns from a library file
// =============================================================================
Function.CoreRegistry_ScanFile {
    Input: path: Address
    Input: lib_name: Address
    Body: {
        content = ReadTextFile(path)
        IfCondition EqualTo(content, 0) ThenBlock: {
            PrintMessage("[CORE] Warning: Could not read ")
            PrintMessage(path)
            PrintMessage("\n")
            ReturnValue(0)
        }
        
        len = StringLength(content)
        pos = 0
        func_count = 0
        
        WhileLoop LessThan(pos, len) {
            // Check if we're at start of line or start of file
            at_line_start = 0
            IfCondition EqualTo(pos, 0) ThenBlock: {
                at_line_start = 1
            } ElseBlock: {
                prev_char = GetByte(content, Subtract(pos, 1))
                IfCondition EqualTo(prev_char, 10) ThenBlock: {
                    at_line_start = 1
                }
            }
            
            IfCondition EqualTo(at_line_start, 1) ThenBlock: {
                // Check for "Function." pattern
                match = CoreRegistry_MatchAt(content, pos, len, "Function.")
                IfCondition EqualTo(match, 1) ThenBlock: {
                    name_start = Add(pos, 9)
                    func_name = CoreRegistry_ExtractIdentifier(content, name_start, len)
                    
                    IfCondition NotEqual(func_name, 0) ThenBlock: {
                        CoreRegistry_Add(func_name, lib_name)
                        func_count = Add(func_count, 1)
                    }
                }
            }
            
            pos = Add(pos, 1)
        }
        
        PrintMessage("[CORE]   ")
        PrintMessage(path)
        PrintMessage(": ")
        PrintNumber(func_count)
        PrintMessage(" functions\n")
    }
}

// =============================================================================
// PATTERN MATCHING
// =============================================================================
Function.CoreRegistry_MatchAt {
    Input: content: Address
    Input: pos: Integer
    Input: content_len: Integer
    Input: pattern: Address
    Output: Integer
    Body: {
        pat_len = StringLength(pattern)
        
        // Check bounds
        end_pos = Add(pos, pat_len)
        IfCondition GreaterThan(end_pos, content_len) ThenBlock: {
            ReturnValue(0)
        }
        
        // Compare bytes
        i = 0
        WhileLoop LessThan(i, pat_len) {
            c1 = GetByte(content, Add(pos, i))
            c2 = GetByte(pattern, i)
            IfCondition NotEqual(c1, c2) ThenBlock: {
                ReturnValue(0)
            }
            i = Add(i, 1)
        }
        
        ReturnValue(1)
    }
}

// =============================================================================
// IDENTIFIER EXTRACTION
// Extracts identifier starting at pos until space, newline, or {
// =============================================================================
Function.CoreRegistry_ExtractIdentifier {
    Input: content: Address
    Input: start: Integer
    Input: content_len: Integer
    Output: Address
    Body: {
        // Find end of identifier
        end_pos = start
        WhileLoop LessThan(end_pos, content_len) {
            c = GetByte(content, end_pos)
            
            // Stop at whitespace, braces, or newline
            IfCondition EqualTo(c, 32) ThenBlock: { BreakLoop }   // space
            IfCondition EqualTo(c, 9) ThenBlock: { BreakLoop }    // tab
            IfCondition EqualTo(c, 10) ThenBlock: { BreakLoop }   // newline
            IfCondition EqualTo(c, 13) ThenBlock: { BreakLoop }   // CR
            IfCondition EqualTo(c, 123) ThenBlock: { BreakLoop }  // {
            
            end_pos = Add(end_pos, 1)
        }
        
        name_len = Subtract(end_pos, start)
        IfCondition LessEqual(name_len, 0) ThenBlock: {
            ReturnValue(0)
        }
        
        // Allocate and copy - use raw syscall to avoid Arena dependency
        alloc_size = Add(name_len, 1)
        name = CoreRegistry_RawAlloc(alloc_size)
        IfCondition EqualTo(name, 0) ThenBlock: {
            ReturnValue(0)
        }
        
        i = 0
        WhileLoop LessThan(i, name_len) {
            c = GetByte(content, Add(start, i))
            SetByte(name, i, c)
            i = Add(i, 1)
        }
        SetByte(name, name_len, 0)
        
        ReturnValue(name)
    }
}

// =============================================================================
// RAW ALLOCATION (no Arena dependency)
// Uses mmap syscall directly
// =============================================================================
Function.CoreRegistry_RawAlloc {
    Input: size: Integer
    Output: Address
    Body: {
        // Round up to page granularity for small allocs
        // mmap: syscall 9, addr=0, len=size, prot=3 (RW), flags=34 (ANON|PRIVATE), fd=-1, off=0
        addr = SystemCall(9, 0, size, 3, 34, -1, 0)
        ReturnValue(addr)
    }
}

// =============================================================================
// REGISTRY ADD
// =============================================================================
Function.CoreRegistry_Add {
    Input: func_name: Address
    Input: lib_name: Address
    Body: {
        count = CoreRegistry.count
        
        IfCondition GreaterEqual(count, CoreRegistry.capacity) ThenBlock: {
            PrintMessage("[CORE] Warning: Registry full, skipping ")
            PrintMessage(func_name)
            PrintMessage("\n")
            ReturnValue(0)
        }
        
        ArraySet(CoreRegistry.func_names, count, func_name)
        ArraySet(CoreRegistry.lib_names, count, lib_name)
        CoreRegistry.count = Add(count, 1)
    }
}

// =============================================================================
// LOOKUP
// Returns library name for a function, or 0 if not found
// =============================================================================
Function.CoreRegistry_Lookup {
    Input: func_name: Address
    Output: Address
    Body: {
        IfCondition EqualTo(CoreRegistry.initialized, 0) ThenBlock: {
            CoreRegistry_Init()
        }
        
        count = CoreRegistry.count
        i = 0
        
        WhileLoop LessThan(i, count) {
            stored_name = ArrayGet(CoreRegistry.func_names, i)
            
            cmp = CoreRegistry_StrEq(func_name, stored_name)
            IfCondition EqualTo(cmp, 1) ThenBlock: {
                lib = ArrayGet(CoreRegistry.lib_names, i)
                ReturnValue(lib)
            }
            
            i = Add(i, 1)
        }
        
        ReturnValue(0)
    }
}

// =============================================================================
// STRING EQUALITY (no StringCompare dependency)
// =============================================================================
Function.CoreRegistry_StrEq {
    Input: s1: Address
    Input: s2: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(s1, s2) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(s1, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(s2, 0) ThenBlock: { ReturnValue(0) }
        
        i = 0
        WhileLoop LessThan(i, 256) {
            c1 = GetByte(s1, i)
            c2 = GetByte(s2, i)
            
            IfCondition NotEqual(c1, c2) ThenBlock: {
                ReturnValue(0)
            }
            
            IfCondition EqualTo(c1, 0) ThenBlock: {
                ReturnValue(1)
            }
            
            i = Add(i, 1)
        }
        
        ReturnValue(0)
    }
}

// =============================================================================
// DEBUG: List all registered functions
// =============================================================================
Function.CoreRegistry_Dump {
    Body: {
        PrintMessage("[CORE] Registry dump:\n")
        
        count = CoreRegistry.count
        i = 0
        
        WhileLoop LessThan(i, count) {
            func_name = ArrayGet(CoreRegistry.func_names, i)
            lib_name = ArrayGet(CoreRegistry.lib_names, i)
            
            PrintMessage("  ")
            PrintMessage(func_name)
            PrintMessage(" -> ")
            PrintMessage(lib_name)
            PrintMessage("\n")
            
            i = Add(i, 1)
        }
    }
}