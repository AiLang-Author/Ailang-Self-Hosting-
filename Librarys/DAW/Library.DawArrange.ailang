// Arrange: track headers and clip lanes. Clips keep their own start.
// Horizontal scroll is time. Vertical scroll is tracks. Neither is capped at 16.
//
// Copyright © 2026 Sean Collins, 2 Paws Machine and Engineering. SCSL v1.0.

LibraryImport.DAW.DawTrack
LibraryImport.DAW.DawClip
LibraryImport.DAW.DawNote
LibraryImport.DAW.DawSong
LibraryImport.DAW.DawFile
LibraryImport.Display.Render.Framebuffer

FixedPool.DawArr {
    "lane":  Initialize=36
    "head":  Initialize=200
    "bar":   Initialize=20
    "ruler": Initialize=36
    "ox":    Initialize=0, CanChange=True
    "oy":    Initialize=0, CanChange=True
    "ow":    Initialize=0, CanChange=True
    "oh":    Initialize=0, CanChange=True
    "rx":    Initialize=0, CanChange=True
    "ry":    Initialize=0, CanChange=True
    "rw":    Initialize=0, CanChange=True
    "rh":    Initialize=0, CanChange=True
    "hx":    Initialize=0, CanChange=True
    "hy":    Initialize=0, CanChange=True
    "hw":    Initialize=0, CanChange=True
    "hh":    Initialize=0, CanChange=True
    "vx":    Initialize=0, CanChange=True
    "vy":    Initialize=0, CanChange=True
    "vw":    Initialize=0, CanChange=True
    "vh":    Initialize=0, CanChange=True
    "zx":    Initialize=0, CanChange=True
    "zy":    Initialize=0, CanChange=True
    "zw":    Initialize=120, CanChange=True
    "zh":    Initialize=14, CanChange=True
    "step":  Initialize=80, CanChange=True
    "minor": Initialize=80, CanChange=True
    "htr":   Initialize=0, CanChange=True
    "ax":    Initialize=0, CanChange=True
    "ay":    Initialize=0, CanChange=True
}

Function.DawArrange.Clamp {
    Output: Integer
    Body: {
        IfCondition LessThan(DawTracks.arr_x, 0) ThenBlock: { DawTracks.arr_x = 0 }
        IfCondition GreaterThan(DawTracks.arr_x, 4000) ThenBlock: { DawTracks.arr_x = 4000 }
        IfCondition LessThan(DawTracks.arr_y, 0) ThenBlock: { DawTracks.arr_y = 0 }
        last = Subtract(DawTracks.n, 1)
        IfCondition LessThan(last, 0) ThenBlock: { last = 0 }
        IfCondition GreaterThan(DawTracks.arr_y, last) ThenBlock: { DawTracks.arr_y = last }
        ReturnValue(0)
    }
}

Function.DawArrange.Zoom {
    Output: Integer
    Body: {
        z = DawTracks.zoom
        IfCondition LessThan(z, 25) ThenBlock: { z = 25 }
        IfCondition GreaterThan(z, 400) ThenBlock: { z = 400 }
        DawTracks.zoom = z
        ReturnValue(z)
    }
}

Function.DawArrange.Px {
    Input: t: Integer
    Output: Integer
    Body: {
        z = DawArrange.Zoom()
        d = Subtract(t, DawTracks.arr_x)
        ReturnValue(Add(DawArr.ox, Divide(Multiply(d, z), 100)))
    }
}

Function.DawArrange.Time {
    Input: px: Integer
    Output: Integer
    Body: {
        z = DawArrange.Zoom()
        IfCondition LessThan(z, 1) ThenBlock: { z = 1 }
        d = Subtract(px, DawArr.ox)
        ReturnValue(Add(DawTracks.arr_x, Divide(Multiply(d, 100), z)))
    }
}

Function.DawArrange.Scale {
    Output: Integer
    Body: {
        z = DawArrange.Zoom()
        step = 800
        px80 = Divide(Multiply(80, z), 100)
        px8 = Divide(Multiply(8, z), 100)
        IfCondition GreaterEqual(px80, 36) ThenBlock: { step = 80 }
        IfCondition GreaterEqual(px8, 36) ThenBlock: { step = 8 }
        minor = step
        fine = Divide(step, 10)
        IfCondition LessThan(fine, 1) ThenBlock: { fine = 1 }
        fpx = Divide(Multiply(fine, z), 100)
        IfCondition GreaterEqual(fpx, 8) ThenBlock: {
            minor = fine
        }
        DawArr.step = step
        DawArr.minor = minor
        ReturnValue(step)
    }
}

Function.DawArrange.Follow {
    Output: Integer
    Body: {
        z = DawArrange.Zoom()
        IfCondition LessThan(z, 1) ThenBlock: { z = 1 }
        IfCondition LessThan(DawArr.ow, 40) ThenBlock: { ReturnValue(0) }
        view = Divide(Multiply(DawArr.ow, 100), z)
        margin = Divide(view, 6)
        IfCondition LessThan(margin, 40) ThenBlock: { margin = 40 }
        left = Add(DawTracks.arr_x, margin)
        right = Subtract(Add(DawTracks.arr_x, view), margin)
        IfCondition LessThan(DawTracks.play, left) ThenBlock: {
            DawTracks.arr_x = Subtract(DawTracks.play, Divide(view, 4))
        }
        IfCondition GreaterThan(DawTracks.play, right) ThenBlock: {
            DawTracks.arr_x = Subtract(DawTracks.play, Divide(view, 4))
        }
        DawArrange.Clamp()
        ReturnValue(0)
    }
}

Function.DawArrange.ZoomAt {
    Input: px: Integer
    Output: Integer
    Body: {
        rel = Subtract(px, DawArr.zx)
        IfCondition LessThan(rel, 0) ThenBlock: { rel = 0 }
        IfCondition GreaterThan(rel, DawArr.zw) ThenBlock: { rel = DawArr.zw }
        den = DawArr.zw
        IfCondition LessThan(den, 1) ThenBlock: { den = 1 }
        DawTracks.zoom = Add(25, Divide(Multiply(rel, 375), den))
        DawArrange.Zoom()
        ReturnValue(DawTracks.zoom)
    }
}

Function.DawArrange.Nudge {
    Input: dx: Integer
    Input: dy: Integer
    Output: Integer
    Body: {
        DawTracks.arr_x = Add(DawTracks.arr_x, dx)
        DawTracks.arr_y = Add(DawTracks.arr_y, dy)
        DawArrange.Clamp()
        ReturnValue(0)
    }
}

Function.DawArrange.Layout {
    Input: x: Integer
    Input: y: Integer
    Input: w: Integer
    Input: h: Integer
    Output: Integer
    Body: {
        bar = DawArr.bar
        rh = DawArr.ruler
        lane_x = Add(x, DawArr.head)
        lane_w = Subtract(Subtract(w, DawArr.head), bar)
        IfCondition LessThan(lane_w, 40) ThenBlock: { lane_w = 40 }
        ry = Add(y, 22)
        oy = Add(ry, rh)
        oh = Subtract(Subtract(Subtract(h, 22), rh), bar)
        IfCondition LessThan(oh, DawArr.lane) ThenBlock: { oh = DawArr.lane }
        DawArr.rx = lane_x
        DawArr.ry = ry
        DawArr.rw = lane_w
        DawArr.rh = rh
        DawArr.ox = lane_x
        DawArr.oy = oy
        DawArr.ow = lane_w
        DawArr.oh = oh
        DawArr.hx = lane_x
        DawArr.hy = Subtract(Add(y, h), bar)
        DawArr.hw = lane_w
        DawArr.hh = bar
        DawArr.vx = Subtract(Add(x, w), bar)
        DawArr.vy = oy
        DawArr.vw = bar
        DawArr.vh = oh
        ReturnValue(0)
    }
}

Function.DawArrange.Hit {
    Input: px: Integer
    Input: py: Integer
    Output: Integer
    Body: {
        IfCondition GreaterEqual(px, DawArr.ax) ThenBlock: {
            IfCondition LessThan(px, Add(DawArr.ax, 56)) ThenBlock: {
                IfCondition GreaterEqual(py, DawArr.ay) ThenBlock: {
                    IfCondition LessThan(py, Add(DawArr.ay, 16)) ThenBlock: {
                        ReturnValue(7)
                    }
                }
            }
        }
        IfCondition GreaterEqual(px, Add(DawArr.ax, 60)) ThenBlock: {
            IfCondition LessThan(px, Add(DawArr.ax, 108)) ThenBlock: {
                IfCondition GreaterEqual(py, DawArr.ay) ThenBlock: {
                    IfCondition LessThan(py, Add(DawArr.ay, 16)) ThenBlock: {
                        ReturnValue(8)
                    }
                }
            }
        }
        fx = DawFile.bx
        IfCondition GreaterEqual(px, fx) ThenBlock: {
            IfCondition LessThan(px, Add(fx, 52)) ThenBlock: {
                IfCondition GreaterEqual(py, DawArr.ay) ThenBlock: {
                    IfCondition LessThan(py, Add(DawArr.ay, 16)) ThenBlock: {
                        ReturnValue(13)
                    }
                }
            }
        }
        IfCondition GreaterEqual(px, DawArr.zx) ThenBlock: {
            IfCondition LessThan(px, Add(DawArr.zx, DawArr.zw)) ThenBlock: {
                IfCondition GreaterEqual(py, DawArr.zy) ThenBlock: {
                    IfCondition LessThan(py, Add(DawArr.zy, DawArr.zh)) ThenBlock: {
                        ReturnValue(6)
                    }
                }
            }
        }
        IfCondition GreaterEqual(px, DawArr.rx) ThenBlock: {
            IfCondition LessThan(px, Add(DawArr.rx, DawArr.rw)) ThenBlock: {
                IfCondition GreaterEqual(py, DawArr.ry) ThenBlock: {
                    IfCondition LessThan(py, Add(DawArr.ry, DawArr.rh)) ThenBlock: {
                        ReturnValue(3)
                    }
                }
            }
        }
        IfCondition GreaterEqual(px, DawArr.hx) ThenBlock: {
            IfCondition LessThan(px, Add(DawArr.hx, DawArr.hw)) ThenBlock: {
                IfCondition GreaterEqual(py, DawArr.hy) ThenBlock: {
                    IfCondition LessThan(py, Add(DawArr.hy, DawArr.hh)) ThenBlock: {
                        ReturnValue(1)
                    }
                }
            }
        }
        IfCondition GreaterEqual(px, DawArr.vx) ThenBlock: {
            IfCondition LessThan(px, Add(DawArr.vx, DawArr.vw)) ThenBlock: {
                IfCondition GreaterEqual(py, DawArr.vy) ThenBlock: {
                    IfCondition LessThan(py, Add(DawArr.vy, DawArr.vh)) ThenBlock: {
                        ReturnValue(2)
                    }
                }
            }
        }
        ReturnValue(0)
    }
}

Function.DawArrange.Scrub {
    Input: px: Integer
    Output: Integer
    Body: {
        z = DawArrange.Zoom()
        IfCondition LessThan(z, 1) ThenBlock: { z = 1 }
        zone = 56
        speed = 0
        right = Add(DawArr.rx, DawArr.rw)
        IfCondition GreaterThan(px, Subtract(right, zone)) ThenBlock: {
            depth = Subtract(px, Subtract(right, zone))
            IfCondition GreaterThan(depth, zone) ThenBlock: { depth = zone }
            speed = Add(6, Divide(depth, 3))
        }
        IfCondition LessThan(px, Add(DawArr.rx, zone)) ThenBlock: {
            depth = Subtract(Add(DawArr.rx, zone), px)
            IfCondition GreaterThan(depth, zone) ThenBlock: { depth = zone }
            speed = Subtract(0, Add(6, Divide(depth, 3)))
        }
        IfCondition NotEqual(speed, 0) ThenBlock: {
            DawTracks.arr_x = Add(DawTracks.arr_x, Divide(Multiply(speed, 100), z))
            DawArrange.Clamp()
        }
        t = DawArrange.Time(px)
        DawTracks.play = t
        IfCondition LessThan(DawTracks.play, 0) ThenBlock: { DawTracks.play = 0 }
        IfCondition GreaterThan(DawTracks.play, 4000) ThenBlock: { DawTracks.play = 4000 }
        ReturnValue(0)
    }
}

Function.DawArrange.ThumbW {
    Output: Integer
    Body: {
        z = DawArrange.Zoom()
        IfCondition LessThan(z, 1) ThenBlock: { z = 1 }
        vis = Divide(Multiply(DawArr.ow, 100), z)
        IfCondition GreaterThan(vis, 4000) ThenBlock: { vis = 4000 }
        IfCondition LessThan(vis, 1) ThenBlock: { vis = 1 }
        tw = Divide(Multiply(DawArr.hw, vis), 4000)
        IfCondition LessThan(tw, 28) ThenBlock: { tw = 28 }
        IfCondition GreaterThan(tw, DawArr.hw) ThenBlock: { tw = DawArr.hw }
        ReturnValue(tw)
    }
}

Function.DawArrange.DragH {
    Input: px: Integer
    Output: Integer
    Body: {
        tw = DawArrange.ThumbW()
        tspace = Subtract(DawArr.hw, tw)
        IfCondition LessThan(tspace, 1) ThenBlock: { tspace = 1 }
        rel = Subtract(Subtract(px, DawArr.hx), Divide(tw, 2))
        IfCondition LessThan(rel, 0) ThenBlock: { rel = 0 }
        IfCondition GreaterThan(rel, tspace) ThenBlock: { rel = tspace }
        DawTracks.arr_x = Divide(Multiply(rel, 4000), tspace)
        DawArrange.Clamp()
        ReturnValue(0)
    }
}

Function.DawArrange.DragV {
    Input: py: Integer
    Output: Integer
    Body: {
        rows = Divide(DawArr.oh, DawArr.lane)
        IfCondition LessThan(rows, 1) ThenBlock: { rows = 1 }
        n = DawTracks.n
        IfCondition LessThan(n, 1) ThenBlock: { n = 1 }
        th = Divide(Multiply(DawArr.vh, rows), n)
        IfCondition LessThan(th, 28) ThenBlock: { th = 28 }
        IfCondition GreaterThan(th, DawArr.vh) ThenBlock: { th = DawArr.vh }
        tspace = Subtract(DawArr.vh, th)
        IfCondition LessThan(tspace, 1) ThenBlock: { tspace = 1 }
        maxy = Subtract(n, rows)
        IfCondition LessThan(maxy, 0) ThenBlock: { maxy = 0 }
        rel = Subtract(Subtract(py, DawArr.vy), Divide(th, 2))
        IfCondition LessThan(rel, 0) ThenBlock: { rel = 0 }
        IfCondition GreaterThan(rel, tspace) ThenBlock: { rel = tspace }
        IfCondition EqualTo(maxy, 0) ThenBlock: {
            DawTracks.arr_y = 0
        }
        ElseBlock: {
            DawTracks.arr_y = Divide(Multiply(rel, maxy), tspace)
        }
        DawArrange.Clamp()
        ReturnValue(0)
    }
}

Function.DawArrange.DrawRuler {
    Output: Integer
    Body: {
        x = DawArr.rx
        y = DawArr.ry
        w = DawArr.rw
        h = DawArr.rh
        bg = FB_RGB(28, 32, 40)
        ink = FB_RGB(230, 230, 224)
        dim = FB_RGB(140, 148, 158)
        tick = FB_RGB(90, 96, 108)
        major = FB_RGB(200, 204, 212)
        FB_FillRectFast(x, y, w, h, bg)
        DawArrange.Scale()
        step = DawArr.step
        minor = DawArr.minor
        t0 = DawTracks.arr_x
        z = DawArrange.Zoom()
        gx = Subtract(t0, Modulo(t0, minor))
        limit = Add(t0, Divide(Multiply(w, 100), z))
        WhileLoop LessThan(gx, limit) {
            sx = Add(x, Divide(Multiply(Subtract(gx, t0), z), 100))
            IfCondition GreaterEqual(sx, x) ThenBlock: {
                IfCondition LessThan(sx, Add(x, w)) ThenBlock: {
                    IfCondition EqualTo(Modulo(gx, step), 0) ThenBlock: {
                        FB_VLine(sx, y, Subtract(Add(y, h), 1), major)
                        IfCondition EqualTo(Modulo(gx, 80), 0) ThenBlock: {
                            FB_DrawNumber(Add(sx, 3), Add(y, 4), Divide(gx, 80), ink, -1)
                        }
                        ElseBlock: {
                            tenth = Modulo(Divide(gx, 8), 10)
                            FB_DrawNumber(Add(sx, 2), Add(y, 4), tenth, dim, -1)
                        }
                    }
                    ElseBlock: {
                        FB_VLine(sx, Add(y, Divide(h, 2)), Subtract(Add(y, h), 1), tick)
                    }
                }
            }
            gx = Add(gx, minor)
        }
        phx = Add(x, Divide(Multiply(Subtract(DawTracks.play, t0), z), 100))
        IfCondition GreaterEqual(phx, x) ThenBlock: {
            IfCondition LessThan(phx, Add(x, w)) ThenBlock: {
                FB_FillRectFast(Subtract(phx, 1), y, 3, h, FB_RGB(240, 220, 90))
                FB_FillRectFast(Subtract(phx, 5), y, 11, 8, FB_RGB(240, 220, 90))
            }
        }
        ReturnValue(0)
    }
}

Function.DawArrange.DrawBars {
    Output: Integer
    Body: {
        bar_c = FB_RGB(54, 58, 66)
        track = FB_RGB(36, 40, 46)
        thumb = FB_RGB(200, 180, 80)
        FB_FillRectFast(DawArr.hx, DawArr.hy, DawArr.hw, DawArr.hh, track)
        FB_FillRectFast(DawArr.vx, DawArr.vy, DawArr.vw, DawArr.vh, track)
        tw = DawArrange.ThumbW()
        tspace = Subtract(DawArr.hw, tw)
        IfCondition LessThan(tspace, 1) ThenBlock: { tspace = 1 }
        tx = Add(DawArr.hx, Divide(Multiply(DawTracks.arr_x, tspace), 4000))
        FB_FillRectFast(tx, Add(DawArr.hy, 3), tw, Subtract(DawArr.hh, 6), thumb)
        rows = Divide(DawArr.oh, DawArr.lane)
        IfCondition LessThan(rows, 1) ThenBlock: { rows = 1 }
        n = DawTracks.n
        IfCondition LessThan(n, 1) ThenBlock: { n = 1 }
        th = Divide(Multiply(DawArr.vh, rows), n)
        IfCondition LessThan(th, 28) ThenBlock: { th = 28 }
        IfCondition GreaterThan(th, DawArr.vh) ThenBlock: { th = DawArr.vh }
        maxy = Subtract(n, rows)
        IfCondition LessThan(maxy, 1) ThenBlock: { maxy = 1 }
        vspace = Subtract(DawArr.vh, th)
        IfCondition LessThan(vspace, 1) ThenBlock: { vspace = 1 }
        ty = Add(DawArr.vy, Divide(Multiply(DawTracks.arr_y, vspace), maxy))
        FB_FillRectFast(Add(DawArr.vx, 3), ty, Subtract(DawArr.vw, 6), th, thumb)
        ReturnValue(0)
    }
}

Function.DawArrange.Pick {
    Input: px: Integer
    Input: py: Integer
    Output: Address
    Body: {
        IfCondition LessThan(px, DawArr.ox) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(py, DawArr.oy) ThenBlock: { ReturnValue(0) }
        right = Add(DawArr.ox, DawArr.ow)
        bottom = Add(DawArr.oy, DawArr.oh)
        IfCondition GreaterEqual(px, right) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterEqual(py, bottom) ThenBlock: { ReturnValue(0) }
        row = Divide(Subtract(py, DawArr.oy), DawArr.lane)
        idx = Add(DawTracks.arr_y, row)
        tr = DawTrack.At(idx)
        IfCondition EqualTo(tr, 0) ThenBlock: { ReturnValue(0) }
        clip_at = PoolFieldOffset(LinkagePool.DawTrack, "clips")
        c = Dereference(Add(tr, clip_at))
        WhileLoop NotEqual(c, 0) {
            st_at = PoolFieldOffset(LinkagePool.DawClip, "start")
            ln_at = PoolFieldOffset(LinkagePool.DawClip, "length")
            st = Dereference(Add(c, st_at))
            ln = Dereference(Add(c, ln_at))
            z = DawArrange.Zoom()
            sx = Add(DawArr.ox, Divide(Multiply(Subtract(st, DawTracks.arr_x), z), 100))
            ex = Add(sx, Divide(Multiply(ln, z), 100))
            IfCondition GreaterEqual(px, sx) ThenBlock: {
                IfCondition LessThan(px, ex) ThenBlock: { ReturnValue(c) }
            }
            next_at = PoolFieldOffset(LinkagePool.DawClip, "next")
            c = Dereference(Add(c, next_at))
        }
        ReturnValue(0)
    }
}

Function.DawArrange.PickTrack {
    Input: px: Integer
    Input: py: Integer
    Output: Address
    Body: {
        IfCondition LessThan(py, DawArr.oy) ThenBlock: { ReturnValue(0) }
        bottom = Add(DawArr.oy, DawArr.oh)
        IfCondition GreaterEqual(py, bottom) ThenBlock: { ReturnValue(0) }
        left = Subtract(DawArr.ox, DawArr.head)
        right = Add(DawArr.ox, DawArr.ow)
        IfCondition LessThan(px, left) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterEqual(px, right) ThenBlock: { ReturnValue(0) }
        row = Divide(Subtract(py, DawArr.oy), DawArr.lane)
        idx = Add(DawTracks.arr_y, row)
        ReturnValue(DawTrack.At(idx))
    }
}

Function.DawArrange.MixBtns {
    Input: x: Integer
    Input: row_y: Integer
    Input: track: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(track, 0) ThenBlock: { ReturnValue(0) }
        a_at = PoolFieldOffset(LinkagePool.DawTrack, "arm")
        m_at = PoolFieldOffset(LinkagePool.DawTrack, "mute")
        s_at = PoolFieldOffset(LinkagePool.DawTrack, "solo")
        arm = Dereference(Add(track, a_at))
        mute = Dereference(Add(track, m_at))
        solo = Dereference(Add(track, s_at))
        by = Add(row_y, 10)
        fill = FB_RGB(28, 32, 38)
        fg = FB_RGB(180, 180, 170)
        IfCondition EqualTo(arm, 1) ThenBlock: {
            fill = FB_RGB(190, 48, 42)
            fg = FB_RGB(255, 236, 230)
        }
        FB_FillRectFast(x, by, 30, 16, fill)
        FB_DrawString(Add(x, 3), Add(by, 4), "REC", fg, -1)
        fill = FB_RGB(28, 32, 38)
        fg = FB_RGB(180, 180, 170)
        IfCondition EqualTo(mute, 1) ThenBlock: {
            fill = FB_RGB(214, 176, 48)
            fg = FB_RGB(20, 20, 16)
        }
        FB_FillRectFast(Add(x, 32), by, 14, 16, fill)
        FB_DrawString(Add(x, 35), Add(by, 4), "M", fg, -1)
        fill = FB_RGB(28, 32, 38)
        fg = FB_RGB(180, 180, 170)
        IfCondition EqualTo(solo, 1) ThenBlock: {
            fill = FB_RGB(46, 168, 96)
            fg = FB_RGB(20, 20, 16)
        }
        FB_FillRectFast(Add(x, 48), by, 14, 16, fill)
        FB_DrawString(Add(x, 51), Add(by, 4), "S", fg, -1)
        ReturnValue(0)
    }
}

Function.DawArrange.HitName {
    Input: px: Integer
    Input: py: Integer
    Output: Address
    Body: {
        IfCondition LessThan(py, DawArr.oy) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterEqual(py, Add(DawArr.oy, DawArr.oh)) ThenBlock: { ReturnValue(0) }
        left = Subtract(DawArr.ox, DawArr.head)
        right = Subtract(DawArr.ox, 76)
        IfCondition LessThan(px, Add(left, 4)) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterEqual(px, right) ThenBlock: { ReturnValue(0) }
        row = Divide(Subtract(py, DawArr.oy), DawArr.lane)
        ReturnValue(DawTrack.At(Add(DawTracks.arr_y, row)))
    }
}

Function.DawArrange.HitMix {
    Input: px: Integer
    Input: py: Integer
    Output: Integer
    Body: {
        DawArr.htr = 0
        IfCondition LessThan(py, DawArr.oy) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterEqual(py, Add(DawArr.oy, DawArr.oh)) ThenBlock: { ReturnValue(0) }
        left = Subtract(DawArr.ox, 72)
        IfCondition LessThan(px, left) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterEqual(px, Subtract(DawArr.ox, 4)) ThenBlock: { ReturnValue(0) }
        row = Divide(Subtract(py, DawArr.oy), DawArr.lane)
        tr = DawTrack.At(Add(DawTracks.arr_y, row))
        IfCondition EqualTo(tr, 0) ThenBlock: { ReturnValue(0) }
        DawArr.htr = tr
        rel = Subtract(px, left)
        IfCondition LessThan(rel, 32) ThenBlock: { ReturnValue(1) }
        IfCondition LessThan(rel, 48) ThenBlock: { ReturnValue(2) }
        ReturnValue(3)
    }
}

Function.DawArrange.NoteMarks {
    Input: track: Address
    Input: row_y: Integer
    Output: Integer
    Body: {
        cur = DawNote.Head(track)
        IfCondition EqualTo(cur, 0) ThenBlock: { ReturnValue(0) }
        z = DawArrange.Zoom()
        IfCondition LessThan(z, 1) ThenBlock: { z = 1 }
        left = DawArr.ox
        right = Add(DawArr.ox, DawArr.ow)
        as = PoolFieldOffset(LinkagePool.DawNote, "start")
        bs = PoolFieldOffset(LinkagePool.DawNote, "pitch")
        cs = PoolFieldOffset(LinkagePool.DawNote, "length")
        soff = PoolFieldOffset(LinkagePool.DawNote, "sel")
        noff = PoolFieldOffset(LinkagePool.DawNote, "next")
        WhileLoop NotEqual(cur, 0) {
            st = Dereference(Add(cur, as))
            ln = Dereference(Add(cur, cs))
            pit = Dereference(Add(cur, bs))
            selv = Dereference(Add(cur, soff))
            nx = Add(left, Divide(Multiply(Subtract(st, DawTracks.arr_x), z), 100))
            nw = Divide(Multiply(ln, z), 100)
            IfCondition LessThan(nw, 3) ThenBlock: { nw = 3 }
            IfCondition LessThan(nx, left) ThenBlock: {
                nw = Subtract(nw, Subtract(left, nx))
                nx = left
            }
            IfCondition GreaterThan(Add(nx, nw), right) ThenBlock: {
                nw = Subtract(right, nx)
            }
            IfCondition GreaterThan(nw, 2) ThenBlock: {
                rel = Subtract(96, pit)
                IfCondition LessThan(rel, 0) ThenBlock: { rel = 0 }
                IfCondition GreaterThan(rel, 60) ThenBlock: { rel = 60 }
                ny = Add(row_y, Add(6, Divide(rel, 3)))
                col = FB_RGB(255, 236, 180)
                mh = 3
                IfCondition EqualTo(selv, 1) ThenBlock: {
                    col = FB_RGB(255, 250, 220)
                    mh = 5
                }
                FB_FillRectFast(nx, ny, nw, mh, col)
            }
            cur = Dereference(Add(cur, noff))
        }
        ReturnValue(1)
    }
}

Function.DawArrange.Draw {
    Input: x: Integer
    Input: y: Integer
    Input: w: Integer
    Input: h: Integer
    Output: Integer
    Body: {
        bg = FB_RGB(22, 24, 28)
        hdr = FB_RGB(32, 36, 42)
        ink = FB_RGB(230, 230, 224)
        grid = FB_RGB(48, 52, 58)
        midi_c = FB_RGB(196, 122, 48)
        wave_c = FB_RGB(46, 140, 96)
        FB_FillRectFast(x, y, w, h, bg)
        FB_FillRectFast(x, y, w, 22, FB_RGB(40, 44, 52))
        DawArr.ax = Add(x, 328)
        DawArr.ay = Add(y, 3)
        fbx = Add(x, 4)
        DawFile.bx = fbx
        DawFile.by = DawArr.ay
        FB_FillRectFast(fbx, DawArr.ay, 52, 16, FB_RGB(70, 78, 96))
        FB_DrawString(Add(fbx, 10), Add(DawArr.ay, 4), "FILE", FB_RGB(236, 232, 210), -1)
        FB_FillRectFast(DawArr.ax, DawArr.ay, 56, 16, FB_RGB(46, 140, 72))
        FB_DrawString(Add(DawArr.ax, 12), Add(DawArr.ay, 4), "ADD", FB_RGB(236, 255, 236), -1)
        FB_FillRectFast(Add(DawArr.ax, 60), DawArr.ay, 48, 16, FB_RGB(128, 52, 48))
        FB_DrawString(Add(DawArr.ax, 68), Add(DawArr.ay, 4), "DEL", FB_RGB(255, 236, 230), -1)
        DawArr.zx = Subtract(Add(x, w), 124)
        DawArr.zy = Add(y, 4)
        DawArr.zw = 110
        DawArr.zh = 14
        IfCondition LessThan(w, 680) ThenBlock: {
            DawArr.zw = 0
        }
        ElseBlock: {
            FB_DrawString(Subtract(Add(x, w), 168), Add(y, 6), "ZOOM", ink, -1)
            FB_FillRectFast(DawArr.zx, DawArr.zy, DawArr.zw, DawArr.zh, FB_RGB(16, 18, 22))
            zrel = Subtract(DawTracks.zoom, 25)
            IfCondition LessThan(zrel, 0) ThenBlock: { zrel = 0 }
            zx = Add(DawArr.zx, Divide(Multiply(zrel, Subtract(DawArr.zw, 10)), 375))
            FB_FillRectFast(zx, DawArr.zy, 10, DawArr.zh, FB_RGB(240, 200, 60))
        }
        DawArrange.Layout(x, y, w, h)
        FB_FillRectFast(x, DawArr.ry, DawArr.head, DawArr.rh, FB_RGB(28, 32, 40))
        FB_DrawString(Add(x, 8), Add(DawArr.ry, 12), "TIME", ink, -1)
        DawArrange.DrawRuler()
        body_y = DawArr.oy
        body_h = DawArr.oh
        lane_x = DawArr.ox
        lane_w = DawArr.ow
        rows = Divide(body_h, DawArr.lane)
        IfCondition LessThan(rows, 1) ThenBlock: { rows = 1 }
        i = 0
        WhileLoop LessThan(i, rows) {
            idx = Add(DawTracks.arr_y, i)
            tr = DawTrack.At(idx)
            row_y = Add(body_y, Multiply(i, DawArr.lane))
            IfCondition EqualTo(tr, 0) ThenBlock: {
                i = rows
            }
            ElseBlock: {
                hcol = hdr
                ncol = ink
                IfCondition EqualTo(tr, DawTracks.sel) ThenBlock: {
                    hcol = FB_RGB(56, 58, 36)
                    ncol = FB_RGB(240, 200, 60)
                }
                FB_FillRectFast(x, row_y, DawArr.head, DawArr.lane, hcol)
                IfCondition EqualTo(tr, DawTracks.sel) ThenBlock: {
                    FB_FillRectFast(x, row_y, 4, DawArr.lane, FB_RGB(240, 200, 60))
                }
                FB_FillRectFast(lane_x, row_y, lane_w, DawArr.lane, bg)
                z = DawArrange.Zoom()
                IfCondition LessThan(z, 1) ThenBlock: { z = 1 }
                minor = DawArr.minor
                step = DawArr.step
                gx = Subtract(DawTracks.arr_x, Modulo(DawTracks.arr_x, minor))
                limit = Add(DawTracks.arr_x, Divide(Multiply(lane_w, 100), z))
                WhileLoop LessThan(gx, limit) {
                    sx = Add(lane_x, Divide(Multiply(Subtract(gx, DawTracks.arr_x), z), 100))
                    IfCondition GreaterEqual(sx, lane_x) ThenBlock: {
                        IfCondition LessThan(sx, Add(lane_x, lane_w)) ThenBlock: {
                            mark = grid
                            IfCondition EqualTo(Modulo(gx, step), 0) ThenBlock: {
                                mark = FB_RGB(78, 86, 98)
                            }
                            FB_VLine(sx, row_y, Add(row_y, Subtract(DawArr.lane, 1)), mark)
                        }
                    }
                    gx = Add(gx, minor)
                }
                name_at = PoolFieldOffset(LinkagePool.DawTrack, "name")
                view_at = PoolFieldOffset(LinkagePool.DawTrack, "view")
                clip_at = PoolFieldOffset(LinkagePool.DawTrack, "clips")
                nm = Dereference(Add(tr, name_at))
                FB_DrawString(Add(x, 10), Add(row_y, 6), nm, ncol, -1)
                view = Dereference(Add(tr, view_at))
                k_at = PoolFieldOffset(LinkagePool.DawTrack, "kind")
                kindv = Dereference(Add(tr, k_at))
                tword = "wave"
                IfCondition EqualTo(kindv, 1) ThenBlock: { tword = "synth" }
                IfCondition EqualTo(view, 1) ThenBlock: {
                    IfCondition EqualTo(kindv, 0) ThenBlock: { tword = "sample" }
                }
                FB_DrawString(Add(x, 10), Add(row_y, 18), tword, FB_RGB(160, 164, 150), -1)
                DawArrange.MixBtns(Subtract(DawArr.ox, 72), row_y, tr)
                notes_at = PoolFieldOffset(LinkagePool.DawTrack, "notes")
                nhead = Dereference(Add(tr, notes_at))
                col = wave_c
                IfCondition EqualTo(view, 1) ThenBlock: { col = midi_c }
                c = Dereference(Add(tr, clip_at))
                WhileLoop NotEqual(c, 0) {
                    st_at = PoolFieldOffset(LinkagePool.DawClip, "start")
                    ln_at = PoolFieldOffset(LinkagePool.DawClip, "length")
                    st = Dereference(Add(c, st_at))
                    ln = Dereference(Add(c, ln_at))
                    z = DawArrange.Zoom()
                    px = Add(lane_x, Divide(Multiply(Subtract(st, DawTracks.arr_x), z), 100))
                    ln = Divide(Multiply(ln, z), 100)
                    IfCondition LessThan(px, lane_x) ThenBlock: {
                        ln = Subtract(ln, Subtract(lane_x, px))
                        px = lane_x
                    }
                    right = Add(lane_x, lane_w)
                    IfCondition GreaterThan(Add(px, ln), right) ThenBlock: {
                        ln = Subtract(right, px)
                    }
                    IfCondition GreaterThan(ln, 2) ThenBlock: {
                        FB_FillRectFast(px, Add(row_y, 6), ln, Subtract(DawArr.lane, 12), col)
                        IfCondition EqualTo(c, DawBoard.sel) ThenBlock: {
                            FB_Rect(px, Add(row_y, 6), ln, Subtract(DawArr.lane, 12), FB_RGB(240, 220, 120))
                        }
                        lab_at = PoolFieldOffset(LinkagePool.DawClip, "label")
                        lab = Dereference(Add(c, lab_at))
                        IfCondition NotEqual(lab, 0) ThenBlock: {
                            FB_DrawString(Add(px, 4), Add(row_y, 4), lab, ink, -1)
                        }
                        src_at = PoolFieldOffset(LinkagePool.DawClip, "src")
                        srcv = Dereference(Add(c, src_at))
                        IfCondition EqualTo(srcv, 1) ThenBlock: {
                            IfCondition EqualTo(nhead, 0) ThenBlock: {
                                mark = 0
                                WhileLoop LessThan(mark, 8) {
                                    nx = Add(px, Add(8, Multiply(mark, 16)))
                                    IfCondition LessThan(nx, Subtract(Add(px, ln), 6)) ThenBlock: {
                                        ny = Add(row_y, Add(16, Multiply(Modulo(Add(mark, idx), 3), 4)))
                                        FB_FillRectFast(nx, ny, 10, 3, FB_RGB(255, 236, 180))
                                    }
                                    mark = Add(mark, 1)
                                }
                            }
                        }
                        ElseBlock: {
                            mark = 0
                            midy = Add(row_y, Divide(DawArr.lane, 2))
                            WhileLoop LessThan(mark, ln) {
                                amp = Modulo(Multiply(Add(mark, st), 5), 8)
                                FB_VLine(Add(px, mark), Subtract(midy, amp), Add(midy, amp), FB_RGB(210, 245, 220))
                                mark = Add(mark, 4)
                            }
                        }
                    }
                    next_at = PoolFieldOffset(LinkagePool.DawClip, "next")
                    c = Dereference(Add(c, next_at))
                }
                IfCondition NotEqual(nhead, 0) ThenBlock: {
                    DawArrange.NoteMarks(tr, row_y)
                }
                FB_HLine(x, Subtract(Add(x, w), 1), Add(row_y, Subtract(DawArr.lane, 1)), grid)
                z = DawArrange.Zoom()
                phx = Add(lane_x, Divide(Multiply(Subtract(DawTracks.play, DawTracks.arr_x), z), 100))
                IfCondition GreaterEqual(phx, lane_x) ThenBlock: {
                    IfCondition LessThan(phx, Add(lane_x, lane_w)) ThenBlock: {
                        FB_VLine(phx, row_y, Add(row_y, Subtract(DawArr.lane, 1)), FB_RGB(240, 220, 90))
                    }
                }
                i = Add(i, 1)
            }
        }
        DawArrange.DrawBars()
        ReturnValue(0)
    }
}
