// New-track dialog. ADD opens it. The row you click is the kind of track.
//
// Copyright © 2026 Sean Collins, 2 Paws Machine and Engineering. SCSL v1.0.

LibraryImport.Display.Render.Framebuffer

FixedPool.DawAsk {
    "on":  Initialize=0, CanChange=True
    "x":   Initialize=0, CanChange=True
    "y":   Initialize=0, CanChange=True
    "w":   Initialize=320, CanChange=True
    "h":   Initialize=196, CanChange=True
    "hot": Initialize=-1, CanChange=True
}

Function.DawAsk.Open {
    Output: Integer
    Body: {
        DawAsk.x = Divide(Subtract(FB.width, DawAsk.w), 2)
        DawAsk.y = Divide(Subtract(FB.height, DawAsk.h), 2)
        IfCondition LessThan(DawAsk.x, 0) ThenBlock: { DawAsk.x = 0 }
        IfCondition LessThan(DawAsk.y, 0) ThenBlock: { DawAsk.y = 0 }
        DawAsk.hot = -1
        DawAsk.on = 1
        ReturnValue(1)
    }
}

Function.DawAsk.Row {
    Input: px: Integer
    Input: py: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(DawAsk.on, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition LessThan(px, Add(DawAsk.x, 16)) ThenBlock: { ReturnValue(-1) }
        IfCondition GreaterEqual(px, Subtract(Add(DawAsk.x, DawAsk.w), 16)) ThenBlock: { ReturnValue(-1) }
        top = Add(DawAsk.y, 44)
        IfCondition LessThan(py, top) ThenBlock: { ReturnValue(-1) }
        rel = Subtract(py, top)
        i = Divide(rel, 48)
        IfCondition LessThan(i, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition GreaterThan(i, 2) ThenBlock: { ReturnValue(-1) }
        inside = Subtract(rel, Multiply(i, 48))
        IfCondition GreaterEqual(inside, 40) ThenBlock: { ReturnValue(-1) }
        ReturnValue(i)
    }
}

Function.DawAsk.Hover {
    Input: px: Integer
    Input: py: Integer
    Output: Integer
    Body: {
        DawAsk.hot = DawAsk.Row(px, py)
        ReturnValue(DawAsk.hot)
    }
}

Function.DawAsk.Hit {
    Input: px: Integer
    Input: py: Integer
    Output: Integer
    Body: {
        row = DawAsk.Row(px, py)
        IfCondition LessThan(row, 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(Add(row, 1))
    }
}

Function.DawAsk.Draw {
    Output: Integer
    Body: {
        IfCondition EqualTo(DawAsk.on, 0) ThenBlock: { ReturnValue(0) }
        bg = FB_RGB(28, 32, 40)
        ink = FB_RGB(236, 232, 210)
        dim = FB_RGB(160, 164, 150)
        FB_FillRectFast(DawAsk.x, DawAsk.y, DawAsk.w, DawAsk.h, bg)
        FB_Rect(DawAsk.x, DawAsk.y, DawAsk.w, DawAsk.h, FB_RGB(240, 200, 60))
        FB_DrawString(Add(DawAsk.x, 16), Add(DawAsk.y, 12), "New track", ink, -1)
        i = 0
        WhileLoop LessThan(i, 3) {
            iy = Add(Add(DawAsk.y, 44), Multiply(i, 48))
            lab = "MIDI"
            sub = "notes, synth"
            IfCondition EqualTo(i, 1) ThenBlock: {
                lab = "SAMPLE"
                sub = "notes, sampler"
            }
            IfCondition EqualTo(i, 2) ThenBlock: {
                lab = "WAVE"
                sub = "audio track"
            }
            fill = FB_RGB(40, 46, 56)
            fg = ink
            sg = dim
            IfCondition EqualTo(i, DawAsk.hot) ThenBlock: {
                fill = FB_RGB(64, 86, 128)
                fg = FB_RGB(255, 248, 230)
                sg = FB_RGB(240, 200, 60)
            }
            FB_FillRectFast(Add(DawAsk.x, 16), iy, Subtract(DawAsk.w, 32), 40, fill)
            IfCondition EqualTo(i, DawAsk.hot) ThenBlock: {
                FB_FillRectFast(Add(DawAsk.x, 16), iy, 3, 40, FB_RGB(240, 200, 60))
            }
            FB_DrawString(Add(DawAsk.x, 28), Add(iy, 6), lab, fg, -1)
            FB_DrawString(Add(DawAsk.x, 28), Add(iy, 22), sub, sg, -1)
            i = Add(i, 1)
        }
        ReturnValue(1)
    }
}
