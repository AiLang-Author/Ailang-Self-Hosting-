// A clip on a track. Start and length are arranged time, not file order.
// Gaps, repeats, and a later start are normal.
//
// Copyright © 2026 Sean Collins, 2 Paws Machine and Engineering. SCSL v1.0.

LibraryImport.DAW.DawTrack
LibraryImport.DAW.DawNote
LibraryImport.DAW.DawSong

LinkagePool.DawClip {
    "next":   Initialize=0, PointerTo=LinkagePool.DawClip
    "start":  Initialize=0
    "length": Initialize=0
    "src":    Initialize=0
    "label":  Initialize=0
    "file":   Initialize=0
}

Function.DawClip.SetStart {
    Input: clip: Address
    Input: start: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(clip, 0) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(start, 0) ThenBlock: { start = 0 }
        at = PoolFieldOffset(LinkagePool.DawClip, "start")
        StoreValue(Add(clip, at), start)
        ReturnValue(start)
    }
}

Function.DawClip.Add {
    Input: track: Address
    Input: start: Integer
    Input: length: Integer
    Input: src: Integer
    Input: label: Address
    Output: Address
    Body: {
        IfCondition EqualTo(track, 0) ThenBlock: { ReturnValue(0) }
        c = AllocateLinkage(LinkagePool.DawClip)
        IfCondition EqualTo(c, 0) ThenBlock: { ReturnValue(0) }
        c@start = start
        c@length = length
        c@src = src
        lb = DawSong.CopyStr(label)
        c@label = lb
        coff = PoolFieldOffset(LinkagePool.DawTrack, "clips")
        head = Dereference(Add(track, coff))
        IfCondition EqualTo(head, 0) ThenBlock: {
            StoreValue(Add(track, coff), c)
            ReturnValue(c)
        }
        noff = PoolFieldOffset(LinkagePool.DawClip, "next")
        cur = head
        nxt = Dereference(Add(cur, noff))
        WhileLoop NotEqual(nxt, 0) {
            cur = nxt
            nxt = Dereference(Add(cur, noff))
        }
        StoreValue(Add(cur, noff), c)
        ReturnValue(c)
    }
}

FixedPool.DawBoard {
    "has":    Initialize=0, CanChange=True
    "src":    Initialize=0, CanChange=True
    "length": Initialize=0, CanChange=True
    "label":  Initialize=0, CanChange=True
    "notes":  Initialize=0, CanChange=True
    "sel":    Initialize=0, CanChange=True
}

Function.DawClip.SetFile {
    Input: clip: Address
    Input: text: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(clip, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(text, 0) ThenBlock: { ReturnValue(0) }
        buf = DawSong.CopyStr(text)
        IfCondition EqualTo(buf, 0) ThenBlock: { ReturnValue(0) }
        at = PoolFieldOffset(LinkagePool.DawClip, "file")
        slot = Add(clip, at)
        StoreValue(slot, buf)
        ReturnValue(1)
    }
}

Function.DawClip.Owner {
    Input: clip: Address
    Output: Address
    Body: {
        IfCondition EqualTo(clip, 0) ThenBlock: { ReturnValue(0) }
        tnext = PoolFieldOffset(LinkagePool.DawTrack, "next")
        coff = PoolFieldOffset(LinkagePool.DawTrack, "clips")
        cnext = PoolFieldOffset(LinkagePool.DawClip, "next")
        tr = DawTracks.head
        WhileLoop NotEqual(tr, 0) {
            c = Dereference(Add(tr, coff))
            WhileLoop NotEqual(c, 0) {
                IfCondition EqualTo(c, clip) ThenBlock: { ReturnValue(tr) }
                c = Dereference(Add(c, cnext))
            }
            tr = Dereference(Add(tr, tnext))
        }
        ReturnValue(0)
    }
}

Function.DawClip.Unlink {
    Input: track: Address
    Input: clip: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(track, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(clip, 0) ThenBlock: { ReturnValue(0) }
        at = PoolFieldOffset(LinkagePool.DawTrack, "clips")
        noff = PoolFieldOffset(LinkagePool.DawClip, "next")
        prev = 0
        cur = Dereference(Add(track, at))
        WhileLoop NotEqual(cur, 0) {
            nxt = Dereference(Add(cur, noff))
            IfCondition EqualTo(cur, clip) ThenBlock: {
                IfCondition EqualTo(prev, 0) ThenBlock: {
                    StoreValue(Add(track, at), nxt)
                }
                ElseBlock: {
                    StoreValue(Add(prev, noff), nxt)
                }
                ReturnValue(1)
            }
            prev = cur
            cur = nxt
        }
        ReturnValue(0)
    }
}

Function.DawClip.TakeNotes {
    Input: track: Address
    Input: t0: Integer
    Input: t1: Integer
    Output: Integer
    Body: {
        DawBoard.notes = 0
        IfCondition EqualTo(track, 0) ThenBlock: { ReturnValue(0) }
        as = PoolFieldOffset(LinkagePool.DawNote, "start")
        bs = PoolFieldOffset(LinkagePool.DawNote, "pitch")
        cs = PoolFieldOffset(LinkagePool.DawNote, "length")
        noff = PoolFieldOffset(LinkagePool.DawNote, "next")
        cur = DawNote.Head(track)
        tail = 0
        WhileLoop NotEqual(cur, 0) {
            st = Dereference(Add(cur, as))
            IfCondition GreaterEqual(st, t0) ThenBlock: {
                IfCondition LessThan(st, t1) ThenBlock: {
                    n = AllocateLinkage(LinkagePool.DawNote)
                    IfCondition NotEqual(n, 0) ThenBlock: {
                        n@start = Subtract(st, t0)
                        pit = Dereference(Add(cur, bs))
                        ln = Dereference(Add(cur, cs))
                        n@pitch = pit
                        n@length = ln
                        n@sel = 0
                        IfCondition EqualTo(tail, 0) ThenBlock: {
                            DawBoard.notes = n
                        }
                        ElseBlock: {
                            StoreValue(Add(tail, noff), n)
                        }
                        tail = n
                    }
                }
            }
            cur = Dereference(Add(cur, noff))
        }
        ReturnValue(1)
    }
}

Function.DawClip.DropNotes {
    Input: track: Address
    Input: t0: Integer
    Input: t1: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(track, 0) ThenBlock: { ReturnValue(0) }
        at = PoolFieldOffset(LinkagePool.DawTrack, "notes")
        as = PoolFieldOffset(LinkagePool.DawNote, "start")
        noff = PoolFieldOffset(LinkagePool.DawNote, "next")
        prev = 0
        cur = Dereference(Add(track, at))
        WhileLoop NotEqual(cur, 0) {
            nxt = Dereference(Add(cur, noff))
            st = Dereference(Add(cur, as))
            drop = 0
            IfCondition GreaterEqual(st, t0) ThenBlock: {
                IfCondition LessThan(st, t1) ThenBlock: { drop = 1 }
            }
            IfCondition EqualTo(drop, 1) ThenBlock: {
                IfCondition EqualTo(prev, 0) ThenBlock: {
                    StoreValue(Add(track, at), nxt)
                }
                ElseBlock: {
                    StoreValue(Add(prev, noff), nxt)
                }
            }
            ElseBlock: {
                prev = cur
            }
            cur = nxt
        }
        ReturnValue(1)
    }
}

Function.DawClip.PutNotes {
    Input: track: Address
    Input: base: Integer
    Output: Integer
    Body: {
        as = PoolFieldOffset(LinkagePool.DawNote, "start")
        bs = PoolFieldOffset(LinkagePool.DawNote, "pitch")
        cs = PoolFieldOffset(LinkagePool.DawNote, "length")
        noff = PoolFieldOffset(LinkagePool.DawNote, "next")
        cur = DawBoard.notes
        WhileLoop NotEqual(cur, 0) {
            rel = Dereference(Add(cur, as))
            pit = Dereference(Add(cur, bs))
            ln = Dereference(Add(cur, cs))
            DawNote.Add(track, Add(base, rel), ln, pit)
            cur = Dereference(Add(cur, noff))
        }
        ReturnValue(1)
    }
}

Function.DawClip.Copy {
    Input: clip: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(clip, 0) ThenBlock: { ReturnValue(0) }
        st_at = PoolFieldOffset(LinkagePool.DawClip, "start")
        ln_at = PoolFieldOffset(LinkagePool.DawClip, "length")
        src_at = PoolFieldOffset(LinkagePool.DawClip, "src")
        lab_at = PoolFieldOffset(LinkagePool.DawClip, "label")
        st = Dereference(Add(clip, st_at))
        DawBoard.length = Dereference(Add(clip, ln_at))
        DawBoard.src = Dereference(Add(clip, src_at))
        DawBoard.label = Dereference(Add(clip, lab_at))
        DawBoard.notes = 0
        IfCondition EqualTo(DawBoard.src, 1) ThenBlock: {
            own = DawClip.Owner(clip)
            t1 = Add(st, DawBoard.length)
            DawClip.TakeNotes(own, st, t1)
        }
        DawBoard.has = 1
        ReturnValue(1)
    }
}

Function.DawClip.Paste {
    Input: track: Address
    Input: time: Integer
    Output: Address
    Body: {
        IfCondition EqualTo(DawBoard.has, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(track, 0) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(time, 0) ThenBlock: { time = 0 }
        c = DawClip.Add(track, time, DawBoard.length, DawBoard.src, DawBoard.label)
        IfCondition EqualTo(c, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(DawBoard.src, 1) ThenBlock: {
            DawClip.PutNotes(track, time)
        }
        DawBoard.sel = c
        ReturnValue(c)
    }
}

Function.DawClip.Holds {
    Input: clip: Address
    Input: at: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(clip, 0) ThenBlock: { ReturnValue(0) }
        st_at = PoolFieldOffset(LinkagePool.DawClip, "start")
        ln_at = PoolFieldOffset(LinkagePool.DawClip, "length")
        st = Dereference(Add(clip, st_at))
        ln = Dereference(Add(clip, ln_at))
        IfCondition LessEqual(at, st) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterEqual(at, Add(st, ln)) ThenBlock: { ReturnValue(0) }
        ReturnValue(1)
    }
}

Function.DawClip.Under {
    Input: track: Address
    Input: at: Integer
    Output: Address
    Body: {
        IfCondition EqualTo(track, 0) ThenBlock: { ReturnValue(0) }
        coff = PoolFieldOffset(LinkagePool.DawTrack, "clips")
        noff = PoolFieldOffset(LinkagePool.DawClip, "next")
        c = Dereference(Add(track, coff))
        WhileLoop NotEqual(c, 0) {
            IfCondition EqualTo(DawClip.Holds(c, at), 1) ThenBlock: { ReturnValue(c) }
            c = Dereference(Add(c, noff))
        }
        ReturnValue(0)
    }
}

Function.DawClip.SplitAt {
    Output: Integer
    Body: {
        at = DawTracks.play
        clip = DawBoard.sel
        IfCondition EqualTo(DawClip.Holds(clip, at), 0) ThenBlock: {
            clip = DawClip.Under(DawTracks.sel, at)
        }
        IfCondition EqualTo(clip, 0) ThenBlock: { ReturnValue(0) }
        own = DawClip.Owner(clip)
        st_at = PoolFieldOffset(LinkagePool.DawClip, "start")
        ln_at = PoolFieldOffset(LinkagePool.DawClip, "length")
        src_at = PoolFieldOffset(LinkagePool.DawClip, "src")
        lab_at = PoolFieldOffset(LinkagePool.DawClip, "label")
        st = Dereference(Add(clip, st_at))
        ln = Dereference(Add(clip, ln_at))
        left = Subtract(at, st)
        IfCondition LessThan(left, 8) ThenBlock: { ReturnValue(0) }
        right = Subtract(ln, left)
        IfCondition LessThan(right, 8) ThenBlock: { ReturnValue(0) }
        StoreValue(Add(clip, ln_at), left)
        srcv = Dereference(Add(clip, src_at))
        lab = Dereference(Add(clip, lab_at))
        neu = DawClip.Add(own, at, right, srcv, lab)
        DawBoard.sel = neu
        ReturnValue(1)
    }
}

Function.DawClip.Command {
    Input: which: Integer
    Output: Integer
    Body: {
        clip = DawBoard.sel
        own = DawClip.Owner(clip)
        IfCondition EqualTo(which, 1) ThenBlock: {
            ReturnValue(DawClip.Copy(clip))
        }
        IfCondition EqualTo(which, 2) ThenBlock: {
            ReturnValue(DawClip.SplitAt())
        }
        IfCondition EqualTo(which, 3) ThenBlock: {
            DawClip.Paste(DawTracks.sel, DawTracks.play)
            ReturnValue(1)
        }
        IfCondition EqualTo(which, 4) ThenBlock: {
            IfCondition EqualTo(clip, 0) ThenBlock: { ReturnValue(0) }
            st_at = PoolFieldOffset(LinkagePool.DawClip, "start")
            ln_at = PoolFieldOffset(LinkagePool.DawClip, "length")
            st = Dereference(Add(clip, st_at))
            ln = Dereference(Add(clip, ln_at))
            DawClip.Copy(clip)
            DawClip.Paste(own, Add(st, ln))
            ReturnValue(1)
        }
        IfCondition EqualTo(which, 5) ThenBlock: {
            IfCondition EqualTo(clip, 0) ThenBlock: { ReturnValue(0) }
            DawClip.Unlink(own, clip)
            DawBoard.sel = 0
            ReturnValue(1)
        }
        IfCondition EqualTo(which, 6) ThenBlock: {
            ReturnValue(DawClip.SplitAt())
        }
        ReturnValue(0)
    }
}
