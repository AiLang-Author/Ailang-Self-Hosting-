// Console strips. Each instance has a level meter, a dB fader, and
// the decibel readout. Horizontal scroll when the strips do not fit.
//
// Copyright © 2026 Sean Collins, 2 Paws Machine and Engineering. SCSL v1.0.

LibraryImport.DAW.DawTrack
LibraryImport.DAW.DawLevel
LibraryImport.Display.Render.Framebuffer

FixedPool.DawCon {
    "ox": Initialize=0, CanChange=True
    "oy": Initialize=0, CanChange=True
    "sw": Initialize=72, CanChange=True
    "ft": Initialize=0, CanChange=True
    "fh": Initialize=1, CanChange=True
    "part": Initialize=0, CanChange=True
    "psx": Initialize=0, CanChange=True
    "pany": Initialize=0, CanChange=True
    "pan0": Initialize=500, CanChange=True
    "gx": Initialize=0, CanChange=True
    "gy": Initialize=0, CanChange=True
    "ml": Initialize=700, CanChange=True
    "mr": Initialize=700, CanChange=True
    "mx": Initialize=0, CanChange=True
    "right": Initialize=0, CanChange=True
    "hx": Initialize=0, CanChange=True
    "hy": Initialize=0, CanChange=True
    "hw": Initialize=0, CanChange=True
    "hh": Initialize=18, CanChange=True
    "iy": Initialize=0, CanChange=True
    "ey": Initialize=0, CanChange=True
    "ry": Initialize=0, CanChange=True
}

Function.DawConsole.Limit {
    Output: Integer
    Body: {
        view = DawCon.hw
        IfCondition LessThan(view, 1) ThenBlock: { view = 1 }
        span = Multiply(DawTracks.n, DawCon.sw)
        max = Subtract(span, view)
        IfCondition LessThan(max, 0) ThenBlock: { max = 0 }
        ReturnValue(max)
    }
}

Function.DawConsole.Clamp {
    Output: Integer
    Body: {
        max = DawConsole.Limit()
        IfCondition LessThan(DawTracks.con_y, 0) ThenBlock: { DawTracks.con_y = 0 }
        IfCondition GreaterThan(DawTracks.con_y, max) ThenBlock: { DawTracks.con_y = max }
        ReturnValue(DawTracks.con_y)
    }
}

Function.DawConsole.HThumb {
    Output: Integer
    Body: {
        view = DawCon.hw
        IfCondition LessThan(view, 1) ThenBlock: { view = 1 }
        span = Multiply(DawTracks.n, DawCon.sw)
        IfCondition LessThan(span, view) ThenBlock: { span = view }
        tw = Divide(Multiply(DawCon.hw, view), span)
        IfCondition LessThan(tw, 28) ThenBlock: { tw = 28 }
        IfCondition GreaterThan(tw, DawCon.hw) ThenBlock: { tw = DawCon.hw }
        ReturnValue(tw)
    }
}

Function.DawConsole.DragH {
    Input: px: Integer
    Output: Integer
    Body: {
        tw = DawConsole.HThumb()
        tspace = Subtract(DawCon.hw, tw)
        IfCondition LessThan(tspace, 1) ThenBlock: {
            DawTracks.con_y = 0
            ReturnValue(0)
        }
        rel = Subtract(Subtract(px, DawCon.hx), Divide(tw, 2))
        IfCondition LessThan(rel, 0) ThenBlock: { rel = 0 }
        IfCondition GreaterThan(rel, tspace) ThenBlock: { rel = tspace }
        max = DawConsole.Limit()
        DawTracks.con_y = Divide(Multiply(rel, max), tspace)
        DawConsole.Clamp()
        ReturnValue(DawTracks.con_y)
    }
}

Function.DawConsole.Nudge {
    Input: dx: Integer
    Output: Integer
    Body: {
        DawTracks.con_y = Add(DawTracks.con_y, dx)
        DawConsole.Clamp()
        ReturnValue(0)
    }
}

Function.DawConsole.SetFader {
    Input: track: Address
    Input: py: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(track, 0) ThenBlock: { ReturnValue(0) }
        rel = Subtract(Add(DawCon.ft, DawCon.fh), py)
        IfCondition LessThan(rel, 0) ThenBlock: { rel = 0 }
        IfCondition GreaterThan(rel, DawCon.fh) ThenBlock: { rel = DawCon.fh }
        den = DawCon.fh
        IfCondition LessThan(den, 1) ThenBlock: { den = 1 }
        p = Divide(Multiply(rel, 1000), den)
        at = PoolFieldOffset(LinkagePool.DawTrack, "fader")
        StoreValue(Add(track, at), p)
        ReturnValue(p)
    }
}

Function.DawConsole.SetPan {
    Input: track: Address
    Input: px: Integer
    Input: py: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(track, 0) ThenBlock: { ReturnValue(0) }
        dx = Subtract(px, DawCon.gx)
        dy = Subtract(DawCon.gy, py)
        p = Add(DawCon.pan0, Multiply(Add(dx, dy), 20))
        IfCondition LessThan(p, 0) ThenBlock: { p = 0 }
        IfCondition GreaterThan(p, 1000) ThenBlock: { p = 1000 }
        at = PoolFieldOffset(LinkagePool.DawTrack, "pan")
        StoreValue(Add(track, at), p)
        ReturnValue(p)
    }
}

Function.DawConsole.DrawPan {
    Input: x: Integer
    Input: y: Integer
    Input: w: Integer
    Input: pan: Integer
    Input: ink: Integer
    Output: Integer
    Body: {
        bar = FB_RGB(16, 18, 20)
        mark = FB_RGB(240, 210, 80)
        FB_FillRectFast(x, Add(y, 10), w, 4, bar)
        mid = Add(x, Divide(w, 2))
        FB_VLine(mid, Add(y, 6), Add(y, 18), mark)
        thumb = Add(x, Divide(Multiply(Subtract(w, 6), pan), 1000))
        FB_FillRectFast(thumb, Add(y, 6), 6, 12, FB_RGB(230, 230, 224))
        span = Subtract(pan, 500)
        side = "R"
        IfCondition LessThan(span, 0) ThenBlock: {
            side = "L"
            span = Subtract(0, span)
        }
        IfCondition GreaterEqual(span, 500) ThenBlock: {
            FB_DrawString(x, y, side, ink, -1)
            FB_DrawString(Add(x, 8), y, "inf", ink, -1)
            ReturnValue(0)
        }
        tenths = Divide(Multiply(span, 9), 5)
        IfCondition LessThan(tenths, 5) ThenBlock: {
            FB_DrawString(x, y, "C", ink, -1)
            ReturnValue(0)
        }
        whole = Divide(tenths, 10)
        frac = Modulo(tenths, 10)
        FB_DrawString(x, y, side, ink, -1)
        IfCondition GreaterEqual(whole, 10) ThenBlock: {
            FB_DrawNumber(Add(x, 8), y, whole, ink, -1)
            FB_DrawString(Add(x, 24), y, ".", ink, -1)
            FB_DrawNumber(Add(x, 32), y, frac, ink, -1)
        }
        ElseBlock: {
            FB_DrawNumber(Add(x, 8), y, whole, ink, -1)
            FB_DrawString(Add(x, 16), y, ".", ink, -1)
            FB_DrawNumber(Add(x, 24), y, frac, ink, -1)
        }
        ReturnValue(0)
    }
}

Function.DawConsole.SetMaster {
    Input: side: Integer
    Input: py: Integer
    Output: Integer
    Body: {
        rel = Subtract(Add(DawCon.ft, DawCon.fh), py)
        IfCondition LessThan(rel, 0) ThenBlock: { rel = 0 }
        IfCondition GreaterThan(rel, DawCon.fh) ThenBlock: { rel = DawCon.fh }
        den = DawCon.fh
        IfCondition LessThan(den, 1) ThenBlock: { den = 1 }
        p = Divide(Multiply(rel, 1000), den)
        IfCondition EqualTo(side, 3) ThenBlock: { DawCon.ml = p }
        IfCondition EqualTo(side, 4) ThenBlock: { DawCon.mr = p }
        ReturnValue(p)
    }
}

Function.DawConsole.Pick {
    Input: px: Integer
    Input: py: Integer
    Output: Address
    Body: {
        DawCon.part = 0
        IfCondition GreaterEqual(px, DawCon.hx) ThenBlock: {
            IfCondition LessThan(px, Add(DawCon.hx, DawCon.hw)) ThenBlock: {
                IfCondition GreaterEqual(py, DawCon.hy) ThenBlock: {
                    IfCondition LessThan(py, Add(DawCon.hy, DawCon.hh)) ThenBlock: {
                        DawCon.part = 5
                        ReturnValue(0)
                    }
                }
            }
        }
        IfCondition LessThan(py, DawCon.oy) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterEqual(py, Add(DawCon.oy, 4000)) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterEqual(px, DawCon.mx) ThenBlock: {
            IfCondition LessThan(px, DawCon.right) ThenBlock: {
                IfCondition LessThan(py, DawCon.ft) ThenBlock: { ReturnValue(0) }
                IfCondition GreaterEqual(py, Add(DawCon.ft, DawCon.fh)) ThenBlock: { ReturnValue(0) }
                mid = Add(DawCon.mx, 48)
                DawCon.part = 4
                IfCondition LessThan(px, mid) ThenBlock: { DawCon.part = 3 }
                ReturnValue(1)
            }
        }
        IfCondition GreaterEqual(py, Add(DawCon.ft, DawCon.fh)) ThenBlock: {
            IfCondition GreaterEqual(py, DawCon.hy) ThenBlock: { ReturnValue(0) }
        }
        i = 0
        WhileLoop LessThan(i, DawTracks.n) {
            sx = Subtract(Add(DawCon.ox, Multiply(i, DawCon.sw)), DawTracks.con_y)
            IfCondition GreaterEqual(px, sx) ThenBlock: {
                IfCondition LessThan(px, Add(sx, Subtract(DawCon.sw, 4))) ThenBlock: {
                    tr = DawTrack.At(i)
                    DawCon.psx = sx
                    IfCondition GreaterEqual(py, DawCon.iy) ThenBlock: {
                        IfCondition LessThan(py, Add(DawCon.iy, 16)) ThenBlock: {
                            DawCon.part = 9
                            ReturnValue(tr)
                        }
                    }
                    IfCondition GreaterEqual(py, DawCon.ey) ThenBlock: {
                        IfCondition LessThan(py, Add(DawCon.ey, 16)) ThenBlock: {
                            DawCon.part = 10
                            ReturnValue(tr)
                        }
                    }
                    IfCondition GreaterEqual(py, DawCon.ry) ThenBlock: {
                        IfCondition LessThan(py, Add(DawCon.ry, 16)) ThenBlock: {
                            rel = Subtract(px, sx)
                            DawCon.part = 6
                            IfCondition GreaterEqual(rel, 30) ThenBlock: { DawCon.part = 7 }
                            IfCondition GreaterEqual(rel, 48) ThenBlock: { DawCon.part = 8 }
                            ReturnValue(tr)
                        }
                    }
                    IfCondition GreaterEqual(py, DawCon.pany) ThenBlock: {
                        IfCondition LessThan(py, Add(DawCon.pany, 20)) ThenBlock: {
                            DawCon.part = 2
                            pat = PoolFieldOffset(LinkagePool.DawTrack, "pan")
                            DawCon.pan0 = Dereference(Add(tr, pat))
                            DawCon.gx = px
                            DawCon.gy = py
                            ReturnValue(tr)
                        }
                    }
                    IfCondition GreaterEqual(py, DawCon.ft) ThenBlock: {
                        IfCondition LessThan(py, Add(DawCon.ft, DawCon.fh)) ThenBlock: {
                            DawCon.part = 1
                            ReturnValue(tr)
                        }
                    }
                    ReturnValue(0)
                }
            }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

Function.DawConsole.Draw {
    Input: x: Integer
    Input: y: Integer
    Input: w: Integer
    Input: h: Integer
    Output: Integer
    Body: {
        bg = FB_RGB(18, 20, 24)
        strip = FB_RGB(36, 40, 46)
        slot = FB_RGB(16, 18, 20)
        thumb = FB_RGB(230, 230, 224)
        meter = FB_RGB(70, 190, 90)
        tick = FB_RGB(90, 96, 104)
        ink = FB_RGB(220, 220, 214)
        dim = FB_RGB(170, 190, 170)
        FB_SetClip(x, y, w, h)
        FB_FillRectFast(x, y, w, h, bg)
        FB_DrawString(Add(x, 8), Add(y, 2), "Console", ink, -1)
        master_w = 100
        lanes = Subtract(w, master_w)
        IfCondition LessThan(lanes, 40) ThenBlock: { lanes = 40 }
        IfCondition GreaterThan(lanes, w) ThenBlock: { lanes = w }
        sw = 72
        hb = 18
        DawCon.hh = hb
        DawCon.hx = x
        DawCon.hw = lanes
        DawCon.hy = Subtract(Add(y, h), hb)
        name_y = Subtract(DawCon.hy, 14)
        DawCon.iy = Add(y, 16)
        DawCon.ey = Add(DawCon.iy, 14)
        DawCon.ry = Add(DawCon.ey, 14)
        DawCon.pany = Add(DawCon.ry, 16)
        ft = Add(DawCon.pany, 20)
        fh = Subtract(name_y, Add(ft, 2))
        IfCondition LessThan(fh, 8) ThenBlock: {
            fh = 8
            ft = Subtract(name_y, 10)
            IfCondition LessThan(ft, DawCon.pany) ThenBlock: { ft = DawCon.pany }
        }
        DawCon.ox = Add(x, 4)
        DawCon.oy = y
        DawCon.right = Add(x, w)
        DawCon.mx = Add(x, lanes)
        DawCon.sw = sw
        DawCon.ft = ft
        DawCon.fh = fh
        FB_SetClip(x, y, lanes, h)
        i = 0
        WhileLoop LessThan(i, DawTracks.n) {
            tr = DawTrack.At(i)
            sx = Subtract(Add(DawCon.ox, Multiply(i, sw)), DawTracks.con_y)
            IfCondition GreaterThan(sx, Subtract(Add(x, w), 4)) ThenBlock: {
                i = DawTracks.n
            }
            ElseBlock: {
                IfCondition GreaterThan(Add(sx, sw), x) ThenBlock: {
                    fat = PoolFieldOffset(LinkagePool.DawTrack, "fader")
                    pat = PoolFieldOffset(LinkagePool.DawTrack, "pan")
                    fp = Dereference(Add(tr, fat))
                    pan = Dereference(Add(tr, pat))
                    strip_h = Subtract(DawCon.hy, Add(y, 14))
                    IfCondition LessThan(strip_h, 1) ThenBlock: { strip_h = 1 }
                    FB_FillRectFast(sx, Add(y, 14), Subtract(sw, 6), strip_h, strip)
                    kat = PoolFieldOffset(LinkagePool.DawTrack, "kind")
                    a_at = PoolFieldOffset(LinkagePool.DawTrack, "arm")
                    m_at = PoolFieldOffset(LinkagePool.DawTrack, "mute")
                    s_at = PoolFieldOffset(LinkagePool.DawTrack, "solo")
                    kindv = Dereference(Add(tr, kat))
                    armv = Dereference(Add(tr, a_at))
                    mutv = Dereference(Add(tr, m_at))
                    solv = Dereference(Add(tr, s_at))
                    slab = "SMP"
                    IfCondition EqualTo(kindv, 1) ThenBlock: { slab = "SYN" }
                    FB_FillRectFast(Add(sx, 2), DawCon.iy, Subtract(sw, 10), 14, FB_RGB(48, 56, 72))
                    FB_DrawString(Add(sx, 6), Add(DawCon.iy, 3), slab, ink, -1)
                    fx_at = PoolFieldOffset(LinkagePool.DawTrack, "fx")
                    fxv = Dereference(Add(tr, fx_at))
                    flab = "FX"
                    IfCondition EqualTo(fxv, 1) ThenBlock: { flab = "EQ" }
                    IfCondition EqualTo(fxv, 2) ThenBlock: { flab = "CMP" }
                    FB_FillRectFast(Add(sx, 2), DawCon.ey, Subtract(sw, 10), 14, FB_RGB(48, 56, 48))
                    FB_DrawString(Add(sx, 6), Add(DawCon.ey, 3), flab, ink, -1)
                    bf = FB_RGB(28, 32, 38)
                    bfg = FB_RGB(180, 180, 170)
                    IfCondition EqualTo(armv, 1) ThenBlock: {
                        bf = FB_RGB(190, 48, 42)
                        bfg = FB_RGB(255, 236, 230)
                    }
                    FB_FillRectFast(sx, DawCon.ry, 28, 14, bf)
                    FB_DrawString(Add(sx, 2), Add(DawCon.ry, 3), "REC", bfg, -1)
                    bf = FB_RGB(28, 32, 38)
                    bfg = FB_RGB(180, 180, 170)
                    IfCondition EqualTo(mutv, 1) ThenBlock: {
                        bf = FB_RGB(214, 176, 48)
                        bfg = FB_RGB(20, 20, 16)
                    }
                    FB_FillRectFast(Add(sx, 30), DawCon.ry, 16, 14, bf)
                    FB_DrawString(Add(sx, 34), Add(DawCon.ry, 3), "M", bfg, -1)
                    bf = FB_RGB(28, 32, 38)
                    bfg = FB_RGB(180, 180, 170)
                    IfCondition EqualTo(solv, 1) ThenBlock: {
                        bf = FB_RGB(46, 168, 96)
                        bfg = FB_RGB(20, 20, 16)
                    }
                    FB_FillRectFast(Add(sx, 48), DawCon.ry, 16, 14, bf)
                    FB_DrawString(Add(sx, 52), Add(DawCon.ry, 3), "S", bfg, -1)
                    DawConsole.DrawPan(Add(sx, 2), DawCon.pany, Subtract(sw, 10), pan, dim)
                    mh = Divide(Multiply(fh, fp), 1000)
                    FB_FillRectFast(Add(sx, 8), Subtract(Add(ft, fh), mh), 8, mh, meter)
                    FB_FillRectFast(Add(sx, 24), ft, 8, fh, slot)
                    k = 0
                    WhileLoop LessThan(k, 5) {
                        ty = Add(ft, Divide(Multiply(k, fh), 4))
                        FB_HLine(Add(sx, 20), Add(sx, 36), ty, tick)
                        k = Add(k, 1)
                    }
                    thumb_y = Subtract(Add(ft, fh), Divide(Multiply(fh, fp), 1000))
                    thumb_y = Subtract(thumb_y, 4)
                    IfCondition LessThan(thumb_y, ft) ThenBlock: { thumb_y = ft }
                    FB_FillRectFast(Add(sx, 18), thumb_y, 20, 8, thumb)
                    DawLevel.Draw(Add(sx, 2), Add(ft, 2), fp, dim)
                    name_at = PoolFieldOffset(LinkagePool.DawTrack, "name")
                    nm = Dereference(Add(tr, name_at))
                    FB_DrawString(Add(sx, 4), Subtract(DawCon.hy, 14), nm, ink, -1)
                }
                i = Add(i, 1)
            }
        }
        FB_SetClip(x, y, w, h)
        track_c = FB_RGB(36, 40, 46)
        bar_c = FB_RGB(200, 180, 80)
        FB_FillRectFast(DawCon.hx, DawCon.hy, DawCon.hw, DawCon.hh, track_c)
        tw = DawConsole.HThumb()
        tspace = Subtract(DawCon.hw, tw)
        IfCondition LessThan(tspace, 1) ThenBlock: { tspace = 1 }
        max = DawConsole.Limit()
        tx = DawCon.hx
        IfCondition GreaterThan(max, 0) ThenBlock: {
            tx = Add(DawCon.hx, Divide(Multiply(DawTracks.con_y, tspace), max))
        }
        FB_FillRectFast(tx, Add(DawCon.hy, 4), tw, Subtract(DawCon.hh, 8), bar_c)
        FB_FillRectFast(DawCon.mx, y, master_w, h, FB_RGB(28, 32, 40))
        FB_DrawString(Add(DawCon.mx, 8), Add(y, 16), "MASTER", ink, -1)
        DawLevel.Draw(Add(DawCon.mx, 4), Add(y, 28), DawCon.ml, dim)
        DawLevel.Draw(Add(DawCon.mx, 48), Add(y, 28), DawCon.mr, dim)
        mlh = Divide(Multiply(fh, DawCon.ml), 1000)
        mrh = Divide(Multiply(fh, DawCon.mr), 1000)
        FB_FillRectFast(Add(DawCon.mx, 14), Subtract(Add(ft, fh), mlh), 10, mlh, meter)
        FB_FillRectFast(Add(DawCon.mx, 58), Subtract(Add(ft, fh), mrh), 10, mrh, meter)
        FB_FillRectFast(Add(DawCon.mx, 16), ft, 6, fh, slot)
        FB_FillRectFast(Add(DawCon.mx, 60), ft, 6, fh, slot)
        lthumb = Subtract(Subtract(Add(ft, fh), Divide(Multiply(fh, DawCon.ml), 1000)), 4)
        rthumb = Subtract(Subtract(Add(ft, fh), Divide(Multiply(fh, DawCon.mr), 1000)), 4)
        IfCondition LessThan(lthumb, ft) ThenBlock: { lthumb = ft }
        IfCondition LessThan(rthumb, ft) ThenBlock: { rthumb = ft }
        FB_FillRectFast(Add(DawCon.mx, 10), lthumb, 18, 8, thumb)
        FB_FillRectFast(Add(DawCon.mx, 54), rthumb, 18, 8, thumb)
        FB_DrawString(Add(DawCon.mx, 12), Subtract(DawCon.hy, 14), "L", ink, -1)
        FB_DrawString(Add(DawCon.mx, 56), Subtract(DawCon.hy, 14), "R", ink, -1)
        FB_ClearClip()
        ReturnValue(0)
    }
}
