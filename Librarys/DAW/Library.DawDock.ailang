// Vertical desk bar for the DAW workspace. A 2px strip on the right
// edge is always there. The pointer wakes the bar, and it draws on
// top of every window. Leaving the bar hides it again.
// SYN, SMP, and EQ stash the synth, the sample player, and the EQ.
//
// Copyright © 2026 Sean Collins, 2 Paws Machine and Engineering. SCSL v1.0.

LibraryImport.Applications.AppDesk
LibraryImport.DAW.DawTrack
LibraryImport.DAW.DawEq
LibraryImport.Display.Render.Framebuffer

FixedPool.DawDock {
    "on":  Initialize=0, CanChange=True
    "bw":  Initialize=48, CanChange=True
    "hz":  Initialize=12, CanChange=True
    "syw": Initialize=-1, CanChange=True
    "saw": Initialize=-1, CanChange=True
    "eqw": Initialize=-1, CanChange=True
    "cpw": Initialize=-1, CanChange=True
    "sx":  Initialize=180, CanChange=True
    "sy":  Initialize=48, CanChange=True
    "sw":  Initialize=440, CanChange=True
    "sh":  Initialize=300, CanChange=True
    "ax":  Initialize=220, CanChange=True
    "ay":  Initialize=80, CanChange=True
    "aw":  Initialize=440, CanChange=True
    "ah":  Initialize=260, CanChange=True
    "ex":  Initialize=260, CanChange=True
    "ey":  Initialize=110, CanChange=True
    "ew":  Initialize=380, CanChange=True
    "eh":  Initialize=280, CanChange=True
    "jx":  Initialize=300, CanChange=True
    "jy":  Initialize=140, CanChange=True
    "jw":  Initialize=360, CanChange=True
    "jh":  Initialize=260, CanChange=True
}

Function.DawDock.Edge {
    Output: Integer
    Body: {
        ReturnValue(Subtract(FB.width, DawDock.hz))
    }
}

Function.DawDock.Left {
    Output: Integer
    Body: {
        ReturnValue(Subtract(DawDock.Edge(), DawDock.bw))
    }
}

Function.DawDock.Watch {
    Input: px: Integer
    Input: py: Integer
    Output: Integer
    Body: {
        hot = DawDock.Edge()
        left = DawDock.Left()
        inside = 0
        IfCondition GreaterEqual(px, hot) ThenBlock: { inside = 1 }
        IfCondition EqualTo(DawDock.on, 1) ThenBlock: {
            IfCondition GreaterEqual(px, left) ThenBlock: { inside = 1 }
        }
        IfCondition EqualTo(inside, 1) ThenBlock: {
            DawDock.on = 1
            ReturnValue(1)
        }
        DawDock.on = 0
        ReturnValue(0)
    }
}

Function.DawDock.Id {
    Input: which: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(which, 1) ThenBlock: { ReturnValue(DawDock.syw) }
        IfCondition EqualTo(which, 2) ThenBlock: { ReturnValue(DawDock.saw) }
        IfCondition EqualTo(which, 3) ThenBlock: { ReturnValue(DawDock.eqw) }
        IfCondition EqualTo(which, 4) ThenBlock: { ReturnValue(DawDock.cpw) }
        ReturnValue(-1)
    }
}

Function.DawDock.SetId {
    Input: which: Integer
    Input: idx: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(which, 1) ThenBlock: { DawDock.syw = idx }
        IfCondition EqualTo(which, 2) ThenBlock: { DawDock.saw = idx }
        IfCondition EqualTo(which, 3) ThenBlock: { DawDock.eqw = idx }
        IfCondition EqualTo(which, 4) ThenBlock: { DawDock.cpw = idx }
        ReturnValue(idx)
    }
}

Function.DawDock.Up {
    Input: idx: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(idx, 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(AppDesk.Get(idx, AppDeskWin.LIVE))
    }
}

Function.DawDock.Keep {
    Input: which: Integer
    Input: idx: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(idx, 0) ThenBlock: { ReturnValue(0) }
        x = AppDesk.Get(idx, AppDeskWin.X)
        y = AppDesk.Get(idx, AppDeskWin.Y)
        w = AppDesk.Get(idx, AppDeskWin.W)
        h = AppDesk.Get(idx, AppDeskWin.H)
        IfCondition EqualTo(which, 1) ThenBlock: {
            DawDock.sx = x
            DawDock.sy = y
            DawDock.sw = w
            DawDock.sh = h
        }
        IfCondition EqualTo(which, 2) ThenBlock: {
            DawDock.ax = x
            DawDock.ay = y
            DawDock.aw = w
            DawDock.ah = h
        }
        IfCondition EqualTo(which, 3) ThenBlock: {
            DawDock.ex = x
            DawDock.ey = y
            DawDock.ew = w
            DawDock.eh = h
        }
        IfCondition EqualTo(which, 4) ThenBlock: {
            DawDock.jx = x
            DawDock.jy = y
            DawDock.jw = w
            DawDock.jh = h
        }
        ReturnValue(1)
    }
}

Function.DawDock.Which {
    Input: idx: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(idx, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(idx, DawDock.syw) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(idx, DawDock.saw) ThenBlock: { ReturnValue(2) }
        IfCondition EqualTo(idx, DawDock.eqw) ThenBlock: { ReturnValue(3) }
        IfCondition EqualTo(idx, DawDock.cpw) ThenBlock: { ReturnValue(4) }
        ReturnValue(0)
    }
}

Function.DawDock.Show {
    Input: which: Integer
    Output: Integer
    Body: {
        idx = DawDock.Id(which)
        live = DawDock.Up(idx)
        IfCondition EqualTo(live, 1) ThenBlock: {
            AppDesk.Raise(idx)
            ReturnValue(idx)
        }
        obj = 5
        title = "Synth"
        x = DawDock.sx
        y = DawDock.sy
        w = DawDock.sw
        h = DawDock.sh
        IfCondition EqualTo(which, 2) ThenBlock: {
            obj = 6
            title = "Sample"
            x = DawDock.ax
            y = DawDock.ay
            w = DawDock.aw
            h = DawDock.ah
        }
        IfCondition EqualTo(which, 3) ThenBlock: {
            obj = 7
            title = "EQ"
            x = DawDock.ex
            y = DawDock.ey
            w = DawDock.ew
            h = DawDock.eh
        }
        IfCondition EqualTo(which, 4) ThenBlock: {
            obj = 8
            title = "Comp"
            x = DawDock.jx
            y = DawDock.jy
            w = DawDock.jw
            h = DawDock.jh
        }
        idx = AppDesk.Open(obj, title, 0)
        IfCondition LessThan(idx, 0) ThenBlock: { ReturnValue(-1) }
        AppDesk.Set(idx, AppDeskWin.KIND, 4)
        AppDesk.Set(idx, AppDeskWin.X, x)
        AppDesk.Set(idx, AppDeskWin.Y, y)
        AppDesk.Set(idx, AppDeskWin.W, w)
        AppDesk.Set(idx, AppDeskWin.H, h)
        DawDock.SetId(which, idx)
        ReturnValue(idx)
    }
}

Function.DawDock.Hide {
    Input: which: Integer
    Output: Integer
    Body: {
        idx = DawDock.Id(which)
        IfCondition EqualTo(DawDock.Up(idx), 0) ThenBlock: { ReturnValue(0) }
        DawDock.Keep(which, idx)
        AppDesk.Close(idx)
        DawDock.SetId(which, -1)
        ReturnValue(1)
    }
}

Function.DawDock.Toggle {
    Input: which: Integer
    Output: Integer
    Body: {
        idx = DawDock.Id(which)
        IfCondition EqualTo(DawDock.Up(idx), 1) ThenBlock: {
            DawDock.Hide(which)
            ReturnValue(0)
        }
        ReturnValue(DawDock.Show(which))
    }
}

Function.DawDock.NoteClosed {
    Input: idx: Integer
    Output: Integer
    Body: {
        which = DawDock.Which(idx)
        IfCondition EqualTo(which, 0) ThenBlock: { ReturnValue(0) }
        DawDock.Keep(which, idx)
        DawDock.SetId(which, -1)
        ReturnValue(which)
    }
}

Function.DawDock.Hit {
    Input: px: Integer
    Input: py: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(DawDock.on, 0) ThenBlock: { ReturnValue(0) }
        left = DawDock.Left()
        IfCondition LessThan(px, left) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterEqual(px, FB.width) ThenBlock: { ReturnValue(0) }
        rel = Subtract(py, 8)
        IfCondition LessThan(rel, 0) ThenBlock: { ReturnValue(0) }
        i = Divide(rel, 40)
        IfCondition GreaterThan(i, 2) ThenBlock: { ReturnValue(0) }
        inside = Subtract(rel, Multiply(i, 40))
        IfCondition GreaterEqual(inside, 36) ThenBlock: { ReturnValue(0) }
        ReturnValue(Add(i, 1))
    }
}

Function.DawDock.DrawHot {
    Output: Integer
    Body: {
        x0 = DawDock.Edge()
        light = FB_RGB(232, 232, 232)
        dark = FB_RGB(40, 40, 40)
        y = 0
        WhileLoop LessThan(y, FB.height) {
            x = 0
            WhileLoop LessThan(x, DawDock.hz) {
                col = light
                IfCondition EqualTo(Modulo(Add(x, y), 2), 1) ThenBlock: { col = dark }
                FB_SetPixel(Add(x0, x), y, col)
                x = Add(x, 1)
            }
            y = Add(y, 1)
        }
        ReturnValue(0)
    }
}

Function.DawDock.Draw {
    Output: Integer
    Body: {
        DawDock.DrawHot()
        IfCondition EqualTo(DawDock.on, 0) ThenBlock: { ReturnValue(0) }
        left = DawDock.Left()
        bg = FB_RGB(14, 18, 32)
        ink = FB_RGB(232, 238, 248)
        dim = FB_RGB(122, 138, 170)
        hot = FB_RGB(42, 212, 255)
        FB_FillRectFast(left, 0, DawDock.bw, FB.height, bg)
        i = 0
        WhileLoop LessThan(i, 3) {
            by = Add(8, Multiply(i, 40))
            bx = Add(left, 2)
            lab = "SYN"
            which = 1
            IfCondition EqualTo(i, 1) ThenBlock: {
                lab = "SMP"
                which = 2
            }
            IfCondition EqualTo(i, 2) ThenBlock: {
                lab = "EQ"
                which = 3
            }
            live = DawDock.Up(DawDock.Id(which))
            fill = FB_RGB(22, 34, 63)
            fg = dim
            IfCondition EqualTo(live, 1) ThenBlock: {
                fill = FB_RGB(42, 64, 104)
                fg = hot
            }
            FB_FillRectFast(bx, by, 44, 36, fill)
            FB_DrawString(Add(bx, 10), Add(by, 14), lab, fg, -1)
            i = Add(i, 1)
        }
        DawDock.DrawHot()
        ReturnValue(1)
    }
}

Function.DawDock.DrawSynth {
    Input: x: Integer
    Input: y: Integer
    Input: w: Integer
    Input: h: Integer
    Output: Integer
    Body: {
        ink = FB_RGB(230, 230, 224)
        dim = FB_RGB(150, 154, 160)
        FB_FillRectFast(x, y, w, h, FB_RGB(18, 20, 28))
        FB_DrawString(Add(x, 12), Add(y, 12), "Synth", ink, -1)
        tr = DawTracks.sel
        IfCondition EqualTo(tr, 0) ThenBlock: { ReturnValue(0) }
        name_at = PoolFieldOffset(LinkagePool.DawTrack, "name")
        inst_at = PoolFieldOffset(LinkagePool.DawTrack, "inst")
        kind_at = PoolFieldOffset(LinkagePool.DawTrack, "kind")
        nm = Dereference(Add(tr, name_at))
        ins = Dereference(Add(tr, inst_at))
        kind = Dereference(Add(tr, kind_at))
        FB_DrawString(Add(x, 12), Add(y, 40), nm, ink, -1)
        IfCondition EqualTo(kind, 1) ThenBlock: {
            FB_DrawString(Add(x, 12), Add(y, 64), ins, dim, -1)
            FB_DrawString(Add(x, 12), Add(y, 96), "preset and controls live here", dim, -1)
        }
        ElseBlock: {
            FB_DrawString(Add(x, 12), Add(y, 64), "pick a synth track", dim, -1)
        }
        ReturnValue(0)
    }
}

Function.DawDock.DrawSample {
    Input: x: Integer
    Input: y: Integer
    Input: w: Integer
    Input: h: Integer
    Output: Integer
    Body: {
        ink = FB_RGB(230, 230, 224)
        dim = FB_RGB(150, 154, 160)
        FB_FillRectFast(x, y, w, h, FB_RGB(18, 24, 22))
        FB_DrawString(Add(x, 12), Add(y, 12), "Sample", ink, -1)
        tr = DawTracks.sel
        IfCondition EqualTo(tr, 0) ThenBlock: { ReturnValue(0) }
        name_at = PoolFieldOffset(LinkagePool.DawTrack, "name")
        inst_at = PoolFieldOffset(LinkagePool.DawTrack, "inst")
        kind_at = PoolFieldOffset(LinkagePool.DawTrack, "kind")
        nm = Dereference(Add(tr, name_at))
        ins = Dereference(Add(tr, inst_at))
        kind = Dereference(Add(tr, kind_at))
        FB_DrawString(Add(x, 12), Add(y, 40), nm, ink, -1)
        IfCondition EqualTo(kind, 0) ThenBlock: {
            FB_DrawString(Add(x, 12), Add(y, 64), ins, dim, -1)
            FB_DrawString(Add(x, 12), Add(y, 96), "pack and zones live here", dim, -1)
        }
        ElseBlock: {
            FB_DrawString(Add(x, 12), Add(y, 64), "pick a sample track", dim, -1)
        }
        ReturnValue(0)
    }
}

Function.DawDock.DrawEQ {
    Input: x: Integer
    Input: y: Integer
    Input: w: Integer
    Input: h: Integer
    Output: Integer
    Body: {
        drawn = DawEq.Draw(x, y, w, h)
        ReturnValue(drawn)
    }
}

Function.DawDock.DrawComp {
    Input: x: Integer
    Input: y: Integer
    Input: w: Integer
    Input: h: Integer
    Output: Integer
    Body: {
        ink = FB_RGB(230, 230, 224)
        dim = FB_RGB(150, 154, 160)
        FB_FillRectFast(x, y, w, h, FB_RGB(22, 20, 18))
        FB_DrawString(Add(x, 12), Add(y, 12), "Compressor", ink, -1)
        tr = DawTracks.sel
        IfCondition NotEqual(tr, 0) ThenBlock: {
            name_at = PoolFieldOffset(LinkagePool.DawTrack, "name")
            nm = Dereference(Add(tr, name_at))
            FB_DrawString(Add(x, 12), Add(y, 36), nm, ink, -1)
        }
        FB_DrawString(Add(x, 12), Add(y, 68), "Threshold", dim, -1)
        FB_DrawString(Add(x, 12), Add(y, 92), "Ratio", dim, -1)
        FB_DrawString(Add(x, 12), Add(y, 116), "Attack", dim, -1)
        FB_DrawString(Add(x, 12), Add(y, 140), "Release", dim, -1)
        ReturnValue(0)
    }
}
