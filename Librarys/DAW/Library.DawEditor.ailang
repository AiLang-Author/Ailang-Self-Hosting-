// Piano roll for the selected track. One time axis with the arrange.
// Click empty adds. Drag empty draws a box. Drag a note moves it.
// The bright cap on the right trims. ALL CUT KEY+ KEY- are on the bar.
//
// Copyright © 2026 Sean Collins, 2 Paws Machine and Engineering. SCSL v1.0.

LibraryImport.DAW.DawTrack
LibraryImport.DAW.DawNote
LibraryImport.DAW.DawArrange
LibraryImport.Display.Render.Framebuffer

FixedPool.DawEdit {
    "ox":    Initialize=0, CanChange=True
    "oy":    Initialize=0, CanChange=True
    "ow":    Initialize=0, CanChange=True
    "oh":    Initialize=0, CanChange=True
    "kx":    Initialize=0, CanChange=True
    "ky":    Initialize=0, CanChange=True
    "kh":    Initialize=0, CanChange=True
    "vx":    Initialize=0, CanChange=True
    "vy":    Initialize=0, CanChange=True
    "vw":    Initialize=14, CanChange=True
    "vh":    Initialize=0, CanChange=True
    "bx":    Initialize=0, CanChange=True
    "by":    Initialize=0, CanChange=True
    "row":   Initialize=12, CanChange=True
    "ey0":   Initialize=0, CanChange=True
    "x0":    Initialize=0, CanChange=True
    "y0":    Initialize=0, CanChange=True
    "x1":    Initialize=0, CanChange=True
    "y1":    Initialize=0, CanChange=True
    "moved": Initialize=0, CanChange=True
    "part":  Initialize=0, CanChange=True
    "edge":  Initialize=0, CanChange=True
    "hot":   Initialize=-1, CanChange=True
    "hp":    Initialize=-1, CanChange=True
    "hx":    Initialize=0, CanChange=True
    "hy":    Initialize=0, CanChange=True
    "hw":    Initialize=0, CanChange=True
    "hh":    Initialize=18, CanChange=True
}

Function.DawEditor.Clamp {
    Output: Integer
    Body: {
        IfCondition LessThan(DawTracks.edit_y, 0) ThenBlock: { DawTracks.edit_y = 0 }
        IfCondition GreaterThan(DawTracks.edit_y, 120) ThenBlock: { DawTracks.edit_y = 120 }
        ReturnValue(DawTracks.edit_y)
    }
}

Function.DawEditor.Top {
    Output: Integer
    Body: {
        DawEditor.Clamp()
        ReturnValue(Subtract(120, DawTracks.edit_y))
    }
}

Function.DawEditor.Nudge {
    Input: dx: Integer
    Input: dy: Integer
    Output: Integer
    Body: {
        DawTracks.edit_x = Add(DawTracks.edit_x, dx)
        DawTracks.edit_y = Add(DawTracks.edit_y, dy)
        IfCondition LessThan(DawTracks.edit_x, 0) ThenBlock: { DawTracks.edit_x = 0 }
        IfCondition GreaterThan(DawTracks.edit_x, 8000) ThenBlock: { DawTracks.edit_x = 8000 }
        DawEditor.Clamp()
        ReturnValue(0)
    }
}

Function.DawEditor.Px {
    Input: t: Integer
    Output: Integer
    Body: {
        z = DawArrange.Zoom()
        d = Subtract(t, DawTracks.arr_x)
        ReturnValue(Add(DawEdit.ox, Divide(Multiply(d, z), 100)))
    }
}

Function.DawEditor.TimeOf {
    Input: px: Integer
    Output: Integer
    Body: {
        z = DawArrange.Zoom()
        IfCondition LessThan(z, 1) ThenBlock: { z = 1 }
        d = Subtract(px, DawEdit.ox)
        ReturnValue(Add(DawTracks.arr_x, Divide(Multiply(d, 100), z)))
    }
}

Function.DawEditor.Snap {
    Input: t: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(t, 0) ThenBlock: { t = 0 }
        q = Divide(Add(t, 4), 8)
        ReturnValue(Multiply(q, 8))
    }
}

Function.DawEditor.NoteW {
    Input: length: Integer
    Output: Integer
    Body: {
        z = DawArrange.Zoom()
        w = Divide(Multiply(length, z), 100)
        IfCondition LessThan(w, 4) ThenBlock: { w = 4 }
        ReturnValue(w)
    }
}

Function.DawEditor.RowY {
    Input: pitch: Integer
    Output: Integer
    Body: {
        top = DawEditor.Top()
        i = Subtract(top, pitch)
        ry = Multiply(i, DawEdit.row)
        ReturnValue(Add(DawEdit.oy, ry))
    }
}

Function.DawEditor.PitchAt {
    Input: py: Integer
    Output: Integer
    Body: {
        rh = DawEdit.row
        IfCondition LessThan(rh, 1) ThenBlock: { rh = 12 }
        i = Divide(Subtract(py, DawEdit.oy), rh)
        IfCondition LessThan(i, 0) ThenBlock: { i = 0 }
        top = DawEditor.Top()
        p = Subtract(top, i)
        IfCondition LessThan(p, 0) ThenBlock: { p = 0 }
        IfCondition GreaterThan(p, 127) ThenBlock: { p = 127 }
        ReturnValue(p)
    }
}

Function.DawEditor.Black {
    Input: pitch: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(pitch, 0) ThenBlock: { ReturnValue(0) }
        pc = Modulo(pitch, 12)
        IfCondition EqualTo(pc, 1) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(pc, 3) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(pc, 6) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(pc, 8) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(pc, 10) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

Function.DawEditor.Letter {
    Input: pitch: Integer
    Output: Address
    Body: {
        IfCondition LessThan(pitch, 0) ThenBlock: { ReturnValue("C") }
        pc = Modulo(pitch, 12)
        IfCondition EqualTo(pc, 0) ThenBlock: { ReturnValue("C") }
        IfCondition EqualTo(pc, 1) ThenBlock: { ReturnValue("C#") }
        IfCondition EqualTo(pc, 2) ThenBlock: { ReturnValue("D") }
        IfCondition EqualTo(pc, 3) ThenBlock: { ReturnValue("D#") }
        IfCondition EqualTo(pc, 4) ThenBlock: { ReturnValue("E") }
        IfCondition EqualTo(pc, 5) ThenBlock: { ReturnValue("F") }
        IfCondition EqualTo(pc, 6) ThenBlock: { ReturnValue("F#") }
        IfCondition EqualTo(pc, 7) ThenBlock: { ReturnValue("G") }
        IfCondition EqualTo(pc, 8) ThenBlock: { ReturnValue("G#") }
        IfCondition EqualTo(pc, 9) ThenBlock: { ReturnValue("A") }
        IfCondition EqualTo(pc, 10) ThenBlock: { ReturnValue("A#") }
        ReturnValue("B")
    }
}

Function.DawEditor.Layout {
    Input: x: Integer
    Input: y: Integer
    Input: w: Integer
    Input: h: Integer
    Output: Integer
    Body: {
        bar = 28
        keys = 44
        sb = 14
        hb = 18
        DawEdit.hh = hb
        DawEdit.kx = x
        DawEdit.ky = Add(y, bar)
        body = Subtract(Subtract(h, bar), hb)
        IfCondition LessThan(body, DawEdit.row) ThenBlock: { body = DawEdit.row }
        DawEdit.kh = body
        DawEdit.ox = Add(x, keys)
        DawEdit.oy = Add(y, bar)
        DawEdit.ow = Subtract(Subtract(w, keys), sb)
        DawEdit.oh = body
        IfCondition LessThan(DawEdit.ow, 20) ThenBlock: { DawEdit.ow = 20 }
        DawEdit.vx = Subtract(Add(x, w), sb)
        DawEdit.vy = Add(y, bar)
        DawEdit.vw = sb
        DawEdit.vh = body
        DawEdit.hx = DawEdit.ox
        DawEdit.hy = Add(DawEdit.oy, body)
        DawEdit.hw = DawEdit.ow
        DawEdit.bx = Add(x, 72)
        DawEdit.by = Add(y, 3)
        ReturnValue(0)
    }
}

Function.DawEditor.HThumb {
    Output: Integer
    Body: {
        z = DawArrange.Zoom()
        IfCondition LessThan(z, 1) ThenBlock: { z = 1 }
        vis = Divide(Multiply(DawEdit.ow, 100), z)
        IfCondition GreaterThan(vis, 4000) ThenBlock: { vis = 4000 }
        IfCondition LessThan(vis, 1) ThenBlock: { vis = 1 }
        tw = Divide(Multiply(DawEdit.hw, vis), 4000)
        IfCondition LessThan(tw, 28) ThenBlock: { tw = 28 }
        IfCondition GreaterThan(tw, DawEdit.hw) ThenBlock: { tw = DawEdit.hw }
        ReturnValue(tw)
    }
}

Function.DawEditor.DragH {
    Input: px: Integer
    Output: Integer
    Body: {
        tw = DawEditor.HThumb()
        tspace = Subtract(DawEdit.hw, tw)
        IfCondition LessThan(tspace, 1) ThenBlock: { tspace = 1 }
        rel = Subtract(Subtract(px, DawEdit.hx), Divide(tw, 2))
        IfCondition LessThan(rel, 0) ThenBlock: { rel = 0 }
        IfCondition GreaterThan(rel, tspace) ThenBlock: { rel = tspace }
        DawTracks.arr_x = Divide(Multiply(rel, 4000), tspace)
        DawArrange.Clamp()
        ReturnValue(DawTracks.arr_x)
    }
}

Function.DawEditor.Thumb {
    Output: Integer
    Body: {
        rh = DawEdit.row
        IfCondition LessThan(rh, 1) ThenBlock: { rh = 12 }
        rows = Divide(DawEdit.oh, rh)
        IfCondition LessThan(rows, 1) ThenBlock: { rows = 1 }
        th = Divide(Multiply(DawEdit.vh, rows), 121)
        IfCondition LessThan(th, 16) ThenBlock: { th = 16 }
        IfCondition GreaterThan(th, DawEdit.vh) ThenBlock: { th = DawEdit.vh }
        ReturnValue(th)
    }
}

Function.DawEditor.Show {
    Input: track: Address
    Output: Integer
    Body: {
        cur = DawNote.Head(track)
        IfCondition EqualTo(cur, 0) ThenBlock: { ReturnValue(0) }
        bs = PoolFieldOffset(LinkagePool.DawNote, "pitch")
        noff = PoolFieldOffset(LinkagePool.DawNote, "next")
        lo = 127
        hi = 0
        WhileLoop NotEqual(cur, 0) {
            v = Dereference(Add(cur, bs))
            IfCondition LessThan(v, lo) ThenBlock: { lo = v }
            IfCondition GreaterThan(v, hi) ThenBlock: { hi = v }
            cur = Dereference(Add(cur, noff))
        }
        rh = DawEdit.row
        IfCondition LessThan(rh, 1) ThenBlock: { rh = 12 }
        rows = 16
        IfCondition GreaterEqual(DawEdit.oh, rh) ThenBlock: {
            rows = Divide(DawEdit.oh, rh)
        }
        IfCondition LessThan(rows, 4) ThenBlock: { rows = 4 }
        mid = Divide(Add(lo, hi), 2)
        half = Divide(rows, 2)
        top = Add(mid, half)
        IfCondition GreaterThan(top, 120) ThenBlock: { top = 120 }
        IfCondition LessThan(top, half) ThenBlock: { top = half }
        DawTracks.edit_y = Subtract(120, top)
        DawEditor.Clamp()
        ReturnValue(top)
    }
}

Function.DawEditor.Seed {
    Input: track: Address
    Input: which: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(which, 0) ThenBlock: {
            DawNote.Add(track, 48, 28, 64)
            DawNote.Add(track, 76, 28, 67)
            DawNote.Add(track, 104, 28, 71)
            DawNote.Add(track, 132, 28, 74)
            DawNote.Add(track, 160, 28, 76)
            DawNote.Add(track, 188, 28, 74)
            DawNote.Add(track, 216, 28, 71)
        }
        IfCondition EqualTo(which, 1) ThenBlock: {
            DawNote.Add(track, 120, 40, 36)
            DawNote.Add(track, 200, 40, 43)
            DawNote.Add(track, 280, 40, 40)
            DawNote.Add(track, 360, 40, 36)
        }
        IfCondition EqualTo(which, 2) ThenBlock: {
            DawNote.Add(track, 88, 24, 72)
            DawNote.Add(track, 140, 24, 76)
            DawNote.Add(track, 196, 24, 79)
            DawNote.Add(track, 252, 24, 84)
        }
        ReturnValue(0)
    }
}

Function.DawEditor.HitNote {
    Input: track: Address
    Input: px: Integer
    Input: py: Integer
    Output: Address
    Body: {
        DawEdit.edge = 0
        found = 0
        as = PoolFieldOffset(LinkagePool.DawNote, "start")
        bs = PoolFieldOffset(LinkagePool.DawNote, "pitch")
        cs = PoolFieldOffset(LinkagePool.DawNote, "length")
        noff = PoolFieldOffset(LinkagePool.DawNote, "next")
        cur = DawNote.Head(track)
        WhileLoop NotEqual(cur, 0) {
            st = Dereference(Add(cur, as))
            ln = Dereference(Add(cur, cs))
            pit = Dereference(Add(cur, bs))
            nx = DawEditor.Px(st)
            nw = DawEditor.NoteW(ln)
            ny = DawEditor.RowY(pit)
            nh = DawEdit.row
            IfCondition GreaterEqual(px, nx) ThenBlock: {
                IfCondition LessThan(px, Add(nx, nw)) ThenBlock: {
                    IfCondition GreaterEqual(py, ny) ThenBlock: {
                        IfCondition LessThan(py, Add(ny, nh)) ThenBlock: {
                            found = cur
                            handle = 8
                            half = Divide(nw, 2)
                            IfCondition GreaterThan(handle, half) ThenBlock: { handle = half }
                            IfCondition LessThan(handle, 2) ThenBlock: { handle = 2 }
                            DawEdit.edge = 0
                            IfCondition GreaterEqual(px, Subtract(Add(nx, nw), handle)) ThenBlock: {
                                DawEdit.edge = 1
                            }
                        }
                    }
                }
            }
            cur = Dereference(Add(cur, noff))
        }
        ReturnValue(found)
    }
}

Function.DawEditor.ButtonAt {
    Input: px: Integer
    Input: py: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(py, DawEdit.by) ThenBlock: { ReturnValue(-1) }
        IfCondition GreaterEqual(py, Add(DawEdit.by, 22)) ThenBlock: { ReturnValue(-1) }
        IfCondition LessThan(px, DawEdit.bx) ThenBlock: { ReturnValue(-1) }
        rel = Subtract(px, DawEdit.bx)
        i = Divide(rel, 52)
        IfCondition LessThan(i, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition GreaterThan(i, 3) ThenBlock: { ReturnValue(-1) }
        inside = Subtract(rel, Multiply(i, 52))
        IfCondition GreaterEqual(inside, 48) ThenBlock: { ReturnValue(-1) }
        ReturnValue(i)
    }
}

Function.DawEditor.ApplyBand {
    Input: track: Address
    Output: Integer
    Body: {
        xa = DawEdit.x0
        xb = DawEdit.x1
        IfCondition GreaterThan(xa, xb) ThenBlock: {
            xa = DawEdit.x1
            xb = DawEdit.x0
        }
        ya = DawEdit.y0
        yb = DawEdit.y1
        IfCondition GreaterThan(ya, yb) ThenBlock: {
            ya = DawEdit.y1
            yb = DawEdit.y0
        }
        soff = PoolFieldOffset(LinkagePool.DawNote, "sel")
        noff = PoolFieldOffset(LinkagePool.DawNote, "next")
        as = PoolFieldOffset(LinkagePool.DawNote, "start")
        bs = PoolFieldOffset(LinkagePool.DawNote, "pitch")
        cs = PoolFieldOffset(LinkagePool.DawNote, "length")
        cur = DawNote.Head(track)
        WhileLoop NotEqual(cur, 0) {
            st = Dereference(Add(cur, as))
            ln = Dereference(Add(cur, cs))
            pit = Dereference(Add(cur, bs))
            nx = DawEditor.Px(st)
            nw = DawEditor.NoteW(ln)
            ny = DawEditor.RowY(pit)
            nh = DawEdit.row
            on = 0
            IfCondition LessThan(nx, xb) ThenBlock: {
                IfCondition GreaterThan(Add(nx, nw), xa) ThenBlock: {
                    IfCondition LessThan(ny, yb) ThenBlock: {
                        IfCondition GreaterThan(Add(ny, nh), ya) ThenBlock: {
                            on = 1
                        }
                    }
                }
            }
            StoreValue(Add(cur, soff), on)
            cur = Dereference(Add(cur, noff))
        }
        ReturnValue(1)
    }
}

Function.DawEditor.Press {
    Input: px: Integer
    Input: py: Integer
    Output: Integer
    Body: {
        DawEdit.part = 0
        DawEdit.moved = 0
        DawEdit.hot = -1
        DawEdit.x0 = px
        DawEdit.y0 = py
        DawEdit.x1 = px
        DawEdit.y1 = py
        track = DawTracks.sel
        IfCondition EqualTo(track, 0) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(DawEdit.ow, 20) ThenBlock: { ReturnValue(0) }
        view_at = PoolFieldOffset(LinkagePool.DawTrack, "view")
        view = Dereference(Add(track, view_at))
        IfCondition EqualTo(view, 1) ThenBlock: {
            b = DawEditor.ButtonAt(px, py)
            IfCondition GreaterEqual(b, 0) ThenBlock: {
                DawEdit.hot = b
                DawEdit.part = 4
                IfCondition EqualTo(b, 0) ThenBlock: { DawNote.SelectAll(track) }
                IfCondition EqualTo(b, 1) ThenBlock: { DawNote.DeleteSel(track) }
                IfCondition EqualTo(b, 2) ThenBlock: { DawNote.Shift(track, 1) }
                IfCondition EqualTo(b, 3) ThenBlock: { DawNote.Shift(track, -1) }
                ReturnValue(4)
            }
        }
        IfCondition NotEqual(view, 1) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterEqual(px, DawEdit.vx) ThenBlock: {
            IfCondition LessThan(px, Add(DawEdit.vx, DawEdit.vw)) ThenBlock: {
                IfCondition GreaterEqual(py, DawEdit.vy) ThenBlock: {
                    IfCondition LessThan(py, Add(DawEdit.vy, DawEdit.vh)) ThenBlock: {
                        DawEdit.part = 5
                        DawEditor.DragV(py)
                        ReturnValue(5)
                    }
                }
            }
        }
        IfCondition GreaterEqual(px, DawEdit.hx) ThenBlock: {
            IfCondition LessThan(px, Add(DawEdit.hx, DawEdit.hw)) ThenBlock: {
                IfCondition GreaterEqual(py, DawEdit.hy) ThenBlock: {
                    IfCondition LessThan(py, Add(DawEdit.hy, DawEdit.hh)) ThenBlock: {
                        DawEdit.part = 7
                        DawEditor.DragH(px)
                        ReturnValue(7)
                    }
                }
            }
        }
        IfCondition GreaterEqual(px, DawEdit.ox) ThenBlock: {
            IfCondition LessThan(px, Add(DawEdit.ox, DawEdit.ow)) ThenBlock: {
                IfCondition GreaterEqual(py, DawEdit.oy) ThenBlock: {
                    IfCondition LessThan(py, Add(DawEdit.oy, DawEdit.oh)) ThenBlock: {
                        hit = DawEditor.HitNote(track, px, py)
                        IfCondition NotEqual(hit, 0) ThenBlock: {
                            soff = PoolFieldOffset(LinkagePool.DawNote, "sel")
                            selv = Dereference(Add(hit, soff))
                            IfCondition EqualTo(selv, 0) ThenBlock: {
                                DawNote.SelectOnly(track, hit)
                            }
                            DawNote.Capture(track)
                            IfCondition EqualTo(DawEdit.edge, 1) ThenBlock: {
                                DawEdit.part = 2
                            }
                            ElseBlock: {
                                DawEdit.part = 1
                            }
                            ReturnValue(DawEdit.part)
                        }
                        DawEdit.part = 3
                        ReturnValue(3)
                    }
                }
            }
        }
        IfCondition GreaterEqual(px, DawEdit.kx) ThenBlock: {
            IfCondition LessThan(px, DawEdit.ox) ThenBlock: {
                IfCondition GreaterEqual(py, DawEdit.oy) ThenBlock: {
                    IfCondition LessThan(py, Add(DawEdit.oy, DawEdit.oh)) ThenBlock: {
                        DawEdit.part = 6
                        DawEdit.ey0 = DawTracks.edit_y
                        ReturnValue(6)
                    }
                }
            }
        }
        ReturnValue(0)
    }
}

Function.DawEditor.DragV {
    Input: py: Integer
    Output: Integer
    Body: {
        th = DawEditor.Thumb()
        tspace = Subtract(DawEdit.vh, th)
        IfCondition LessThan(tspace, 1) ThenBlock: { tspace = 1 }
        rel = Subtract(Subtract(py, DawEdit.vy), Divide(th, 2))
        IfCondition LessThan(rel, 0) ThenBlock: { rel = 0 }
        IfCondition GreaterThan(rel, tspace) ThenBlock: { rel = tspace }
        DawTracks.edit_y = Divide(Multiply(rel, 120), tspace)
        DawEditor.Clamp()
        ReturnValue(DawTracks.edit_y)
    }
}

Function.DawEditor.DragKeys {
    Input: py: Integer
    Output: Integer
    Body: {
        rh = DawEdit.row
        IfCondition LessThan(rh, 1) ThenBlock: { rh = 12 }
        d = Divide(Subtract(py, DawEdit.y0), rh)
        DawTracks.edit_y = Add(DawEdit.ey0, d)
        DawEditor.Clamp()
        ReturnValue(DawTracks.edit_y)
    }
}

Function.DawEditor.Drag {
    Input: px: Integer
    Input: py: Integer
    Output: Integer
    Body: {
        track = DawTracks.sel
        IfCondition EqualTo(DawEdit.part, 5) ThenBlock: {
            DawEditor.DragV(py)
            ReturnValue(5)
        }
        IfCondition EqualTo(DawEdit.part, 6) ThenBlock: {
            DawEditor.DragKeys(py)
            ReturnValue(6)
        }
        IfCondition EqualTo(DawEdit.part, 7) ThenBlock: {
            DawEditor.DragH(px)
            ReturnValue(7)
        }
        IfCondition EqualTo(DawEdit.part, 1) ThenBlock: {
            t1 = DawEditor.TimeOf(px)
            t0 = DawEditor.TimeOf(DawEdit.x0)
            s1 = DawEditor.Snap(t1)
            s0 = DawEditor.Snap(t0)
            dt = Subtract(s1, s0)
            p1 = DawEditor.PitchAt(py)
            p0 = DawEditor.PitchAt(DawEdit.y0)
            dp = Subtract(p1, p0)
            DawNote.MoveSel(track, dt, dp)
            ReturnValue(1)
        }
        IfCondition EqualTo(DawEdit.part, 2) ThenBlock: {
            t1 = DawEditor.TimeOf(px)
            t0 = DawEditor.TimeOf(DawEdit.x0)
            s1 = DawEditor.Snap(t1)
            s0 = DawEditor.Snap(t0)
            dt = Subtract(s1, s0)
            DawNote.LenSel(track, dt)
            ReturnValue(2)
        }
        IfCondition EqualTo(DawEdit.part, 3) ThenBlock: {
            cx = px
            cy = py
            IfCondition LessThan(cx, DawEdit.ox) ThenBlock: { cx = DawEdit.ox }
            right = Subtract(Add(DawEdit.ox, DawEdit.ow), 1)
            IfCondition GreaterThan(cx, right) ThenBlock: { cx = right }
            IfCondition LessThan(cy, DawEdit.oy) ThenBlock: { cy = DawEdit.oy }
            bot = Subtract(Add(DawEdit.oy, DawEdit.oh), 1)
            IfCondition GreaterThan(cy, bot) ThenBlock: { cy = bot }
            DawEdit.x1 = cx
            DawEdit.y1 = cy
            adx = Subtract(px, DawEdit.x0)
            ady = Subtract(py, DawEdit.y0)
            IfCondition LessThan(adx, 0) ThenBlock: { adx = Subtract(0, adx) }
            IfCondition LessThan(ady, 0) ThenBlock: { ady = Subtract(0, ady) }
            IfCondition GreaterEqual(adx, 4) ThenBlock: { DawEdit.moved = 1 }
            IfCondition GreaterEqual(ady, 4) ThenBlock: { DawEdit.moved = 1 }
            IfCondition EqualTo(DawEdit.moved, 1) ThenBlock: {
                DawEditor.ApplyBand(track)
            }
            ReturnValue(3)
        }
        ReturnValue(0)
    }
}

Function.DawEditor.Release {
    Input: px: Integer
    Input: py: Integer
    Output: Integer
    Body: {
        track = DawTracks.sel
        IfCondition EqualTo(DawEdit.part, 3) ThenBlock: {
            IfCondition EqualTo(DawEdit.moved, 0) ThenBlock: {
                t0 = DawEditor.TimeOf(DawEdit.x0)
                st = DawEditor.Snap(t0)
                pit = DawEditor.PitchAt(DawEdit.y0)
                n = DawNote.Add(track, st, 28, pit)
                DawNote.SelectOnly(track, n)
            }
        }
        DawEdit.part = 0
        DawEdit.moved = 0
        DawEdit.hot = -1
        DawEdit.x1 = DawEdit.x0
        DawEdit.y1 = DawEdit.y0
        ReturnValue(0)
    }
}

Function.DawEditor.Hover {
    Input: px: Integer
    Input: py: Integer
    Output: Integer
    Body: {
        DawEdit.hp = -1
        IfCondition LessThan(DawEdit.ow, 20) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(px, DawEdit.ox) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterEqual(px, Add(DawEdit.ox, DawEdit.ow)) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(py, DawEdit.oy) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterEqual(py, Add(DawEdit.oy, DawEdit.oh)) ThenBlock: { ReturnValue(0) }
        DawEdit.hp = DawEditor.PitchAt(py)
        ReturnValue(DawEdit.hp)
    }
}

Function.DawEditor.DrawButtons {
    Input: x: Integer
    Input: y: Integer
    Input: w: Integer
    Output: Integer
    Body: {
        ink = FB_RGB(236, 232, 210)
        off = FB_RGB(48, 52, 58)
        on = FB_RGB(240, 200, 60)
        dim = FB_RGB(148, 152, 158)
        i = 0
        WhileLoop LessThan(i, 4) {
            bx = Add(DawEdit.bx, Multiply(i, 52))
            fill = off
            fg = ink
            IfCondition EqualTo(i, DawEdit.hot) ThenBlock: {
                fill = on
                fg = FB_RGB(24, 24, 20)
            }
            FB_FillRectFast(bx, DawEdit.by, 48, 22, fill)
            lab = "ALL"
            IfCondition EqualTo(i, 1) ThenBlock: { lab = "CUT" }
            IfCondition EqualTo(i, 2) ThenBlock: { lab = "KEY+" }
            IfCondition EqualTo(i, 3) ThenBlock: { lab = "KEY-" }
            FB_DrawString(Add(bx, 4), Add(DawEdit.by, 6), lab, fg, -1)
            i = Add(i, 1)
        }
        FB_DrawString(Add(DawEdit.bx, 216), Add(y, 10), "empty click adds   drag box selects   edge trims", dim, -1)
        IfCondition GreaterEqual(DawEdit.hp, 0) ThenBlock: {
            lab = DawEditor.Letter(DawEdit.hp)
            FB_DrawString(Subtract(Add(x, w), 64), Add(y, 10), lab, on, -1)
            oct = Subtract(Divide(DawEdit.hp, 12), 1)
            FB_DrawNumber(Subtract(Add(x, w), 40), Add(y, 10), oct, on, -1)
        }
        ReturnValue(0)
    }
}

Function.DawEditor.DrawPiano {
    Output: Integer
    Body: {
        rh = DawEdit.row
        rows = Divide(DawEdit.oh, rh)
        top = DawEditor.Top()
        white = FB_RGB(186, 182, 170)
        black = FB_RGB(32, 34, 40)
        dark = FB_RGB(36, 36, 36)
        lite = FB_RGB(230, 226, 214)
        gold = FB_RGB(240, 200, 60)
        i = 0
        WhileLoop LessThan(i, rows) {
            p = Subtract(top, i)
            ry = Add(DawEdit.oy, Multiply(i, rh))
            fill = white
            fg = dark
            IfCondition EqualTo(DawEditor.Black(p), 1) ThenBlock: {
                fill = black
                fg = lite
            }
            IfCondition EqualTo(p, DawEdit.hp) ThenBlock: {
                fill = FB_RGB(78, 72, 40)
                fg = gold
            }
            FB_FillRectFast(DawEdit.kx, ry, 44, rh, fill)
            show = 0
            IfCondition EqualTo(p, DawEdit.hp) ThenBlock: { show = 1 }
            IfCondition GreaterEqual(p, 0) ThenBlock: {
                IfCondition EqualTo(Modulo(p, 12), 0) ThenBlock: { show = 1 }
            }
            IfCondition EqualTo(show, 1) ThenBlock: {
                IfCondition GreaterEqual(p, 0) ThenBlock: {
                    lab = DawEditor.Letter(p)
                    FB_DrawString(Add(DawEdit.kx, 2), Add(ry, 2), lab, fg, -1)
                    oct = Subtract(Divide(p, 12), 1)
                    FB_DrawNumber(Add(DawEdit.kx, 20), Add(ry, 2), oct, fg, -1)
                }
            }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

Function.DawEditor.DrawScroll {
    Output: Integer
    Body: {
        track = FB_RGB(36, 40, 46)
        thumb = FB_RGB(200, 180, 80)
        FB_FillRectFast(DawEdit.vx, DawEdit.vy, DawEdit.vw, DawEdit.vh, track)
        th = DawEditor.Thumb()
        tspace = Subtract(DawEdit.vh, th)
        IfCondition LessThan(tspace, 1) ThenBlock: { tspace = 1 }
        ty = Add(DawEdit.vy, Divide(Multiply(DawTracks.edit_y, tspace), 120))
        FB_FillRectFast(Add(DawEdit.vx, 3), ty, Subtract(DawEdit.vw, 6), th, thumb)
        ReturnValue(0)
    }
}

Function.DawEditor.DrawH {
    Output: Integer
    Body: {
        track = FB_RGB(36, 40, 46)
        thumb = FB_RGB(200, 180, 80)
        FB_FillRectFast(DawEdit.hx, DawEdit.hy, DawEdit.hw, DawEdit.hh, track)
        FB_FillRectFast(DawEdit.vx, DawEdit.hy, DawEdit.vw, DawEdit.hh, track)
        tw = DawEditor.HThumb()
        tspace = Subtract(DawEdit.hw, tw)
        IfCondition LessThan(tspace, 1) ThenBlock: { tspace = 1 }
        tx = Add(DawEdit.hx, Divide(Multiply(DawTracks.arr_x, tspace), 4000))
        FB_FillRectFast(tx, Add(DawEdit.hy, 4), tw, Subtract(DawEdit.hh, 8), thumb)
        ReturnValue(0)
    }
}

Function.DawEditor.DrawNotes {
    Input: track: Address
    Output: Integer
    Body: {
        body = FB_RGB(232, 168, 64)
        selc = FB_RGB(255, 214, 96)
        edge = FB_RGB(255, 248, 220)
        as = PoolFieldOffset(LinkagePool.DawNote, "start")
        bs = PoolFieldOffset(LinkagePool.DawNote, "pitch")
        cs = PoolFieldOffset(LinkagePool.DawNote, "length")
        soff = PoolFieldOffset(LinkagePool.DawNote, "sel")
        noff = PoolFieldOffset(LinkagePool.DawNote, "next")
        cur = DawNote.Head(track)
        WhileLoop NotEqual(cur, 0) {
            st = Dereference(Add(cur, as))
            ln = Dereference(Add(cur, cs))
            pit = Dereference(Add(cur, bs))
            selv = Dereference(Add(cur, soff))
            nx = DawEditor.Px(st)
            nw = DawEditor.NoteW(ln)
            ny = DawEditor.RowY(pit)
            ny = Add(ny, 1)
            nh = Subtract(DawEdit.row, 2)
            IfCondition LessThan(nh, 2) ThenBlock: { nh = 2 }
            col = body
            IfCondition EqualTo(selv, 1) ThenBlock: { col = selc }
            FB_FillRectFast(nx, ny, nw, nh, col)
            cap = 4
            IfCondition GreaterThan(cap, nw) ThenBlock: { cap = nw }
            FB_FillRectFast(Subtract(Add(nx, nw), cap), ny, cap, nh, edge)
            IfCondition EqualTo(selv, 1) ThenBlock: {
                FB_Rect(nx, ny, nw, nh, edge)
            }
            cur = Dereference(Add(cur, noff))
        }
        ReturnValue(0)
    }
}

Function.DawEditor.DrawBand {
    Output: Integer
    Body: {
        IfCondition EqualTo(DawEdit.moved, 0) ThenBlock: { ReturnValue(0) }
        xa = DawEdit.x0
        xb = DawEdit.x1
        IfCondition GreaterThan(xa, xb) ThenBlock: {
            xa = DawEdit.x1
            xb = DawEdit.x0
        }
        ya = DawEdit.y0
        yb = DawEdit.y1
        IfCondition GreaterThan(ya, yb) ThenBlock: {
            ya = DawEdit.y1
            yb = DawEdit.y0
        }
        bw = Subtract(xb, xa)
        bh = Subtract(yb, ya)
        IfCondition LessThan(bw, 1) ThenBlock: { bw = 1 }
        IfCondition LessThan(bh, 1) ThenBlock: { bh = 1 }
        FB_Rect(xa, ya, bw, bh, FB_RGB(240, 220, 120))
        ReturnValue(0)
    }
}

Function.DawEditor.DrawGrid {
    Input: track: Address
    Output: Integer
    Body: {
        rh = DawEdit.row
        rows = Divide(DawEdit.oh, rh)
        top = DawEditor.Top()
        i = 0
        WhileLoop LessThan(i, rows) {
            p = Subtract(top, i)
            ry = Add(DawEdit.oy, Multiply(i, rh))
            fill = FB_RGB(22, 24, 28)
            IfCondition EqualTo(DawEditor.Black(p), 1) ThenBlock: {
                fill = FB_RGB(14, 16, 18)
            }
            IfCondition EqualTo(p, DawEdit.hp) ThenBlock: {
                fill = FB_RGB(40, 44, 28)
            }
            FB_FillRectFast(DawEdit.ox, ry, DawEdit.ow, rh, fill)
            i = Add(i, 1)
        }
        DawArrange.Scale()
        z = DawArrange.Zoom()
        IfCondition LessThan(z, 1) ThenBlock: { z = 1 }
        minor = DawArr.minor
        IfCondition LessThan(minor, 1) ThenBlock: { minor = 8 }
        t = Subtract(DawTracks.arr_x, Modulo(DawTracks.arr_x, minor))
        limit = Add(DawTracks.arr_x, Divide(Multiply(DawEdit.ow, 100), z))
        grid = FB_RGB(48, 52, 58)
        major = FB_RGB(72, 78, 88)
        WhileLoop LessThan(t, limit) {
            sx = DawEditor.Px(t)
            IfCondition GreaterEqual(sx, DawEdit.ox) ThenBlock: {
                IfCondition LessThan(sx, Add(DawEdit.ox, DawEdit.ow)) ThenBlock: {
                    mark = grid
                    IfCondition EqualTo(Modulo(t, DawArr.step), 0) ThenBlock: { mark = major }
                    FB_VLine(sx, DawEdit.oy, Subtract(Add(DawEdit.oy, DawEdit.oh), 1), mark)
                }
            }
            t = Add(t, minor)
        }
        DawEditor.DrawNotes(track)
        phx = DawEditor.Px(DawTracks.play)
        IfCondition GreaterEqual(phx, DawEdit.ox) ThenBlock: {
            IfCondition LessThan(phx, Add(DawEdit.ox, DawEdit.ow)) ThenBlock: {
                FB_VLine(phx, DawEdit.oy, Subtract(Add(DawEdit.oy, DawEdit.oh), 1), FB_RGB(240, 220, 90))
            }
        }
        IfCondition EqualTo(DawEdit.part, 3) ThenBlock: { DawEditor.DrawBand() }
        ReturnValue(0)
    }
}

Function.DawEditor.Wave {
    Input: x: Integer
    Input: y: Integer
    Input: w: Integer
    Input: h: Integer
    Output: Integer
    Body: {
        mid = Add(y, Divide(h, 2))
        col = FB_RGB(80, 190, 140)
        i = 0
        WhileLoop LessThan(i, w) {
            t = Add(i, DawTracks.arr_x)
            amp = Modulo(Multiply(t, 17), Divide(h, 2))
            FB_VLine(Add(x, i), Subtract(mid, amp), Add(mid, amp), col)
            i = Add(i, 3)
        }
        ReturnValue(0)
    }
}

Function.DawEditor.Draw {
    Input: x: Integer
    Input: y: Integer
    Input: w: Integer
    Input: h: Integer
    Output: Integer
    Body: {
        bg = FB_RGB(14, 16, 20)
        ink = FB_RGB(230, 230, 224)
        dim = FB_RGB(148, 152, 158)
        DawEditor.Layout(x, y, w, h)
        FB_SetClip(x, y, w, h)
        FB_FillRectFast(x, y, w, h, bg)
        FB_FillRectFast(x, y, w, 28, FB_RGB(32, 34, 40))
        tr = DawTracks.sel
        IfCondition EqualTo(tr, 0) ThenBlock: {
            FB_DrawString(Add(x, 8), Add(y, 10), "click a track name", dim, -1)
            FB_ClearClip()
            ReturnValue(0)
        }
        name_at = PoolFieldOffset(LinkagePool.DawTrack, "name")
        view_at = PoolFieldOffset(LinkagePool.DawTrack, "view")
        nm = Dereference(Add(tr, name_at))
        FB_DrawString(Add(x, 8), Add(y, 10), nm, ink, -1)
        view = Dereference(Add(tr, view_at))
        IfCondition NotEqual(view, 1) ThenBlock: {
            FB_DrawString(Add(x, 72), Add(y, 10), "audio - click a midi track name", dim, -1)
            DawEditor.Wave(x, Add(y, 28), w, Subtract(h, 28))
            FB_ClearClip()
            ReturnValue(0)
        }
        DawEditor.DrawButtons(x, y, w)
        DawEditor.DrawPiano()
        DawEditor.DrawScroll()
        DawEditor.DrawH()
        FB_SetClip(DawEdit.ox, DawEdit.oy, DawEdit.ow, DawEdit.oh)
        DawEditor.DrawGrid(tr)
        FB_ClearClip()
        ReturnValue(0)
    }
}
