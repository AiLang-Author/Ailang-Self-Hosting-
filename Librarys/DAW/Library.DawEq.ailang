// EQ picture. Four bands, eight integers, one slot directory.
// It draws sliders and writes the files. It does not see samples
// and it does not open the sound card.
//
//   /dev/shm/daw/<track>/fx/0/kind.txt    eq
//   /dev/shm/daw/<track>/fx/0/bypass.txt  0
//   /dev/shm/daw/<track>/fx/0/param.txt   gain, freq, four times
//
// Gain is tenths of a dB, -120..120. Freq is Hz, 20..20000.
// The freq slider is logarithmic. The file still stores Hz.
// Defaults are 0 / 120, 0 / 800, 0 / 2500, 0 / 8000.
// Bands are low shelf, low-mid peak, high-mid peak, high shelf.
//
// Copyright © 2026 Sean Collins, 2 Paws Machine and Engineering. SCSL v1.0.

LibraryImport.Arena
LibraryImport.DAW.DawTrack
LibraryImport.Display.Render.Framebuffer

FixedPool.DawEq {
    "bound": Initialize=0, CanChange=True
    "told":  Initialize=0, CanChange=True
    "tr":    Initialize=0, CanChange=True
    "g0":    Initialize=0, CanChange=True
    "f0":    Initialize=120, CanChange=True
    "g1":    Initialize=0, CanChange=True
    "f1":    Initialize=800, CanChange=True
    "g2":    Initialize=0, CanChange=True
    "f2":    Initialize=2500, CanChange=True
    "g3":    Initialize=0, CanChange=True
    "f3":    Initialize=8000, CanChange=True
    "cx":    Initialize=0, CanChange=True
    "cy":    Initialize=0, CanChange=True
    "cw":    Initialize=0, CanChange=True
    "ch":    Initialize=0, CanChange=True
    "drag":  Initialize=-1, CanChange=True
    "num":   Initialize=0, CanChange=True
}

Function.DawEq.Boot {
    Output: Integer
    Body: {
        IfCondition NotEqual(DawEq.num, 0) ThenBlock: { ReturnValue(1) }
        buf = Allocate(16)
        IfCondition EqualTo(buf, 0) ThenBlock: { ReturnValue(0) }
        SetByte(buf, 0, 0)
        DawEq.num = buf
        ReturnValue(1)
    }
}

Function.DawEq.Gain {
    Input: band: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(band, 0) ThenBlock: { ReturnValue(DawEq.g0) }
        IfCondition EqualTo(band, 1) ThenBlock: { ReturnValue(DawEq.g1) }
        IfCondition EqualTo(band, 2) ThenBlock: { ReturnValue(DawEq.g2) }
        ReturnValue(DawEq.g3)
    }
}

Function.DawEq.Freq {
    Input: band: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(band, 0) ThenBlock: { ReturnValue(DawEq.f0) }
        IfCondition EqualTo(band, 1) ThenBlock: { ReturnValue(DawEq.f1) }
        IfCondition EqualTo(band, 2) ThenBlock: { ReturnValue(DawEq.f2) }
        ReturnValue(DawEq.f3)
    }
}

Function.DawEq.PutGain {
    Input: band: Integer
    Input: val: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(val, -120) ThenBlock: { val = -120 }
        IfCondition GreaterThan(val, 120) ThenBlock: { val = 120 }
        IfCondition EqualTo(band, 0) ThenBlock: { DawEq.g0 = val }
        IfCondition EqualTo(band, 1) ThenBlock: { DawEq.g1 = val }
        IfCondition EqualTo(band, 2) ThenBlock: { DawEq.g2 = val }
        IfCondition EqualTo(band, 3) ThenBlock: { DawEq.g3 = val }
        ReturnValue(val)
    }
}

Function.DawEq.PutFreq {
    Input: band: Integer
    Input: val: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(val, 20) ThenBlock: { val = 20 }
        IfCondition GreaterThan(val, 20000) ThenBlock: { val = 20000 }
        IfCondition EqualTo(band, 0) ThenBlock: { DawEq.f0 = val }
        IfCondition EqualTo(band, 1) ThenBlock: { DawEq.f1 = val }
        IfCondition EqualTo(band, 2) ThenBlock: { DawEq.f2 = val }
        IfCondition EqualTo(band, 3) ThenBlock: { DawEq.f3 = val }
        ReturnValue(val)
    }
}

Function.DawEq.Defaults {
    Output: Integer
    Body: {
        DawEq.g0 = 0
        DawEq.f0 = 120
        DawEq.g1 = 0
        DawEq.f1 = 800
        DawEq.g2 = 0
        DawEq.f2 = 2500
        DawEq.g3 = 0
        DawEq.f3 = 8000
        ReturnValue(1)
    }
}

Function.DawEq.Store {
    Input: idx: Integer
    Input: val: Integer
    Output: Integer
    Body: {
        band = Divide(idx, 2)
        side = Modulo(idx, 2)
        IfCondition EqualTo(side, 0) ThenBlock: { DawEq.PutGain(band, val) }
        ElseBlock: { DawEq.PutFreq(band, val) }
        ReturnValue(1)
    }
}

Function.DawEq.Commit {
    Input: idx: Integer
    Input: acc: Integer
    Input: sign: Integer
    Input: seen: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(seen, 0) ThenBlock: { ReturnValue(idx) }
        IfCondition GreaterEqual(idx, 8) ThenBlock: { ReturnValue(idx) }
        val = Multiply(sign, acc)
        DawEq.Store(idx, val)
        ReturnValue(Add(idx, 1))
    }
}

Function.DawEq.Take {
    Input: buf: Address
    Input: n: Integer
    Output: Integer
    Body: {
        idx = 0
        acc = 0
        sign = 1
        seen = 0
        i = 0
        WhileLoop LessThan(i, n) {
            b = GetByte(buf, i)
            IfCondition EqualTo(b, 45) ThenBlock: {
                IfCondition EqualTo(seen, 0) ThenBlock: { sign = -1 }
            }
            IfCondition GreaterEqual(b, 48) ThenBlock: {
                IfCondition LessEqual(b, 57) ThenBlock: {
                    seen = 1
                    acc = Add(Multiply(acc, 10), Subtract(b, 48))
                }
            }
            IfCondition EqualTo(b, 10) ThenBlock: {
                idx = DawEq.Commit(idx, acc, sign, seen)
                acc = 0
                sign = 1
                seen = 0
            }
            IfCondition EqualTo(b, 13) ThenBlock: {
                idx = DawEq.Commit(idx, acc, sign, seen)
                acc = 0
                sign = 1
                seen = 0
            }
            i = Add(i, 1)
        }
        DawEq.Commit(idx, acc, sign, seen)
        ReturnValue(1)
    }
}

Function.DawEq.CopyTo {
    Input: dst: Address
    Input: off: Integer
    Input: src: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(src, 0) ThenBlock: { ReturnValue(off) }
        n = StringLength(src)
        i = 0
        WhileLoop LessThan(i, n) {
            b = GetByte(src, i)
            SetByte(dst, Add(off, i), b)
            i = Add(i, 1)
        }
        ReturnValue(Add(off, n))
    }
}

Function.DawEq.Dir {
    Input: tail: Address
    Output: Address
    Body: {
        IfCondition EqualTo(DawEq.tr, 0) ThenBlock: { ReturnValue(0) }
        name_at = PoolFieldOffset(LinkagePool.DawTrack, "name")
        nm = Dereference(Add(DawEq.tr, name_at))
        IfCondition EqualTo(nm, 0) ThenBlock: { ReturnValue(0) }
        nlen = StringLength(nm)
        IfCondition LessThan(nlen, 1) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterThan(nlen, 64) ThenBlock: { ReturnValue(0) }
        buf = Allocate(160)
        IfCondition EqualTo(buf, 0) ThenBlock: { ReturnValue(0) }
        at = 0
        at = DawEq.CopyTo(buf, at, "/dev/shm/daw/")
        at = DawEq.CopyTo(buf, at, nm)
        t0 = 0
        IfCondition NotEqual(tail, 0) ThenBlock: { t0 = GetByte(tail, 0) }
        IfCondition NotEqual(t0, 0) ThenBlock: {
            SetByte(buf, at, 47)
            at = Add(at, 1)
            at = DawEq.CopyTo(buf, at, tail)
        }
        SetByte(buf, at, 0)
        ReturnValue(buf)
    }
}

Function.DawEq.File {
    Input: leaf: Address
    Output: Address
    Body: {
        dirp = DawEq.Dir("fx/0")
        IfCondition EqualTo(dirp, 0) ThenBlock: { ReturnValue(0) }
        buf = Allocate(160)
        IfCondition EqualTo(buf, 0) ThenBlock: {
            Deallocate(dirp, 160)
            ReturnValue(0)
        }
        at = DawEq.CopyTo(buf, 0, dirp)
        Deallocate(dirp, 160)
        SetByte(buf, at, 47)
        at = Add(at, 1)
        at = DawEq.CopyTo(buf, at, leaf)
        SetByte(buf, at, 0)
        ReturnValue(buf)
    }
}

Function.DawEq.Mk {
    Input: dirp: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(dirp, 0) ThenBlock: { ReturnValue(0) }
        r = SystemCall(83, dirp, 493, 0)
        IfCondition GreaterEqual(r, 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(r, -17) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

Function.DawEq.Dirs {
    Output: Integer
    Body: {
        r = DawEq.Mk("/dev/shm/daw")
        IfCondition EqualTo(r, 0) ThenBlock: { ReturnValue(0) }
        dirp = DawEq.Dir(0)
        r = DawEq.Mk(dirp)
        IfCondition NotEqual(dirp, 0) ThenBlock: { Deallocate(dirp, 160) }
        IfCondition EqualTo(r, 0) ThenBlock: { ReturnValue(0) }
        dirp = DawEq.Dir("fx")
        r = DawEq.Mk(dirp)
        IfCondition NotEqual(dirp, 0) ThenBlock: { Deallocate(dirp, 160) }
        IfCondition EqualTo(r, 0) ThenBlock: { ReturnValue(0) }
        dirp = DawEq.Dir("fx/0")
        r = DawEq.Mk(dirp)
        IfCondition NotEqual(dirp, 0) ThenBlock: { Deallocate(dirp, 160) }
        ReturnValue(r)
    }
}

Function.DawEq.Size {
    Input: dirp: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(dirp, 0) ThenBlock: { ReturnValue(-2) }
        statbuf = Allocate(144)
        IfCondition EqualTo(statbuf, 0) ThenBlock: { ReturnValue(-2) }
        r = SystemCall(4, dirp, statbuf)
        IfCondition LessThan(r, 0) ThenBlock: {
            Deallocate(statbuf, 144)
            ReturnValue(-2)
        }
        sz = Dereference(Add(statbuf, 48))
        Deallocate(statbuf, 144)
        ReturnValue(sz)
    }
}

Function.DawEq.PutDec {
    Input: fd: Integer
    Input: val: Integer
    Output: Integer
    Body: {
        buf = Allocate(16)
        IfCondition EqualTo(buf, 0) ThenBlock: { ReturnValue(0) }
        neg = 0
        v = val
        IfCondition LessThan(v, 0) ThenBlock: {
            neg = 1
            v = Subtract(0, v)
        }
        i = 0
        IfCondition EqualTo(v, 0) ThenBlock: {
            SetByte(buf, 0, 48)
            i = 1
        }
        WhileLoop GreaterThan(v, 0) {
            SetByte(buf, i, Add(48, Modulo(v, 10)))
            v = Divide(v, 10)
            i = Add(i, 1)
        }
        j = Subtract(i, 1)
        k = 0
        WhileLoop LessThan(k, j) {
            a = GetByte(buf, k)
            SetByte(buf, k, GetByte(buf, j))
            SetByte(buf, j, a)
            k = Add(k, 1)
            j = Subtract(j, 1)
        }
        IfCondition EqualTo(neg, 1) ThenBlock: {
            k = i
            WhileLoop GreaterThan(k, 0) {
                prev = Subtract(k, 1)
                SetByte(buf, k, GetByte(buf, prev))
                k = prev
            }
            SetByte(buf, 0, 45)
            i = Add(i, 1)
        }
        SetByte(buf, i, 10)
        i = Add(i, 1)
        SystemCall(1, fd, buf, i)
        Deallocate(buf, 16)
        ReturnValue(1)
    }
}

Function.DawEq.Save {
    Output: Integer
    Body: {
        IfCondition EqualTo(DawEq.tr, 0) ThenBlock: { ReturnValue(0) }
        path = DawEq.File("param.txt")
        IfCondition EqualTo(path, 0) ThenBlock: { ReturnValue(0) }
        fd = SystemCall(2, path, 577, 420)
        Deallocate(path, 160)
        IfCondition LessThan(fd, 0) ThenBlock: { ReturnValue(0) }
        DawEq.PutDec(fd, DawEq.g0)
        DawEq.PutDec(fd, DawEq.f0)
        DawEq.PutDec(fd, DawEq.g1)
        DawEq.PutDec(fd, DawEq.f1)
        DawEq.PutDec(fd, DawEq.g2)
        DawEq.PutDec(fd, DawEq.f2)
        DawEq.PutDec(fd, DawEq.g3)
        DawEq.PutDec(fd, DawEq.f3)
        SystemCall(3, fd, 0, 0)
        ReturnValue(1)
    }
}

Function.DawEq.WriteLit {
    Input: leaf: Address
    Input: text: Address
    Output: Integer
    Body: {
        path = DawEq.File(leaf)
        IfCondition EqualTo(path, 0) ThenBlock: { ReturnValue(0) }
        sz = DawEq.Size(path)
        IfCondition NotEqual(sz, -2) ThenBlock: {
            Deallocate(path, 160)
            ReturnValue(1)
        }
        fd = SystemCall(2, path, 577, 420)
        Deallocate(path, 160)
        IfCondition LessThan(fd, 0) ThenBlock: { ReturnValue(0) }
        len = StringLength(text)
        SystemCall(1, fd, text, len)
        SystemCall(3, fd, 0, 0)
        ReturnValue(1)
    }
}

Function.DawEq.Load {
    Output: Integer
    Body: {
        path = DawEq.File("param.txt")
        IfCondition EqualTo(path, 0) ThenBlock: { ReturnValue(0) }
        sz = DawEq.Size(path)
        IfCondition LessThan(sz, 1) ThenBlock: {
            Deallocate(path, 160)
            ReturnValue(0)
        }
        IfCondition GreaterThan(sz, 240) ThenBlock: {
            Deallocate(path, 160)
            ReturnValue(0)
        }
        cap = Add(sz, 1)
        buf = Allocate(cap)
        IfCondition EqualTo(buf, 0) ThenBlock: {
            Deallocate(path, 160)
            ReturnValue(0)
        }
        fd = SystemCall(2, path, 0, 0)
        Deallocate(path, 160)
        IfCondition LessThan(fd, 0) ThenBlock: {
            Deallocate(buf, cap)
            ReturnValue(0)
        }
        got = 0
        state = 1
        WhileLoop EqualTo(state, 1) {
            IfCondition GreaterEqual(got, sz) ThenBlock: { state = 2 }
            ElseBlock: {
                dstp = Add(buf, got)
                need = Subtract(sz, got)
                nr = SystemCall(0, fd, dstp, need)
                IfCondition LessThan(nr, 1) ThenBlock: { state = 0 }
                ElseBlock: { got = Add(got, nr) }
            }
        }
        SystemCall(3, fd, 0, 0)
        IfCondition EqualTo(state, 2) ThenBlock: { DawEq.Take(buf, sz) }
        Deallocate(buf, cap)
        IfCondition EqualTo(state, 2) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

Function.DawEq.Sync {
    Output: Integer
    Body: {
        sel = DawTracks.sel
        IfCondition EqualTo(sel, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(sel, DawEq.tr) ThenBlock: {
            IfCondition EqualTo(DawEq.bound, 1) ThenBlock: { ReturnValue(1) }
        }
        DawEq.tr = sel
        DawEq.bound = 0
        DawEq.Defaults()
        got = DawEq.Load()
        dirs = DawEq.Dirs()
        IfCondition EqualTo(dirs, 0) ThenBlock: {
            IfCondition EqualTo(DawEq.told, 0) ThenBlock: {
                PrintMessage("eq fail\n")
                DawEq.told = 1
            }
            ReturnValue(0)
        }
        DawEq.WriteLit("kind.txt", "eq\n")
        DawEq.WriteLit("bypass.txt", "0\n")
        IfCondition EqualTo(got, 0) ThenBlock: { DawEq.Save() }
        DawEq.bound = 1
        DawEq.told = 0
        name_at = PoolFieldOffset(LinkagePool.DawTrack, "name")
        nm = Dereference(Add(DawEq.tr, name_at))
        PrintMessage("eq ")
        IfCondition NotEqual(nm, 0) ThenBlock: { PrintMessage(nm) }
        PrintMessage(" ")
        PrintNumber(DawEq.cx)
        PrintMessage(" ")
        PrintNumber(DawEq.cy)
        PrintMessage(" ")
        PrintNumber(DawEq.cw)
        PrintMessage("\n")
        ReturnValue(1)
    }
}

Function.DawEq.SliderX {
    Output: Integer
    Body: {
        ReturnValue(Add(DawEq.cx, 80))
    }
}

Function.DawEq.SliderW {
    Output: Integer
    Body: {
        room = Subtract(DawEq.cw, 152)
        IfCondition LessThan(room, 40) ThenBlock: { room = 40 }
        ReturnValue(room)
    }
}

Function.DawEq.NumX {
    Output: Integer
    Body: {
        ReturnValue(Add(DawEq.cx, Subtract(DawEq.cw, 64)))
    }
}

Function.DawEq.RowTop {
    Input: band: Integer
    Output: Integer
    Body: {
        step = Multiply(band, 52)
        base = Add(DawEq.cy, 32)
        ReturnValue(Add(base, step))
    }
}

Function.DawEq.SliderY {
    Input: which: Integer
    Output: Integer
    Body: {
        band = Divide(which, 2)
        top = DawEq.RowTop(band)
        side = Modulo(which, 2)
        IfCondition EqualTo(side, 0) ThenBlock: { ReturnValue(Add(top, 16)) }
        ReturnValue(Add(top, 34))
    }
}

Function.DawEq.Apply {
    Input: which: Integer
    Input: mx: Integer
    Output: Integer
    Body: {
        sx = DawEq.SliderX()
        sw = DawEq.SliderW()
        rel = Subtract(mx, sx)
        IfCondition LessThan(rel, 0) ThenBlock: { rel = 0 }
        IfCondition GreaterThan(rel, sw) ThenBlock: { rel = sw }
        band = Divide(which, 2)
        side = Modulo(which, 2)
        IfCondition EqualTo(side, 0) ThenBlock: {
            span = Multiply(rel, 240)
            val = Add(-120, Divide(span, sw))
            DawEq.PutGain(band, val)
        }
        ElseBlock: {
            idx = Divide(Multiply(rel, 32), sw)
            IfCondition GreaterThan(idx, 32) ThenBlock: { idx = 32 }
            val = DawEq.FreqAt(idx)
            DawEq.PutFreq(band, val)
        }
        IfCondition EqualTo(DawEq.bound, 1) ThenBlock: { DawEq.Save() }
        ReturnValue(1)
    }
}

Function.DawEq.Press {
    Input: mx: Integer
    Input: my: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(DawEq.cw, 1) ThenBlock: { ReturnValue(0) }
        found = -1
        i = 0
        WhileLoop LessThan(i, 8) {
            sx = DawEq.SliderX()
            sy = DawEq.SliderY(i)
            sw = DawEq.SliderW()
            right = Add(sx, sw)
            bot = Add(sy, 14)
            IfCondition GreaterEqual(mx, sx) ThenBlock: {
                IfCondition LessThan(mx, right) ThenBlock: {
                    IfCondition GreaterEqual(my, sy) ThenBlock: {
                        IfCondition LessThan(my, bot) ThenBlock: { found = i }
                    }
                }
            }
            i = Add(i, 1)
        }
        IfCondition LessThan(found, 0) ThenBlock: { ReturnValue(0) }
        DawEq.drag = found
        DawEq.Apply(found, mx)
        ReturnValue(1)
    }
}

Function.DawEq.Drag {
    Input: mx: Integer
    Input: my: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(DawEq.drag, 0) ThenBlock: { ReturnValue(0) }
        DawEq.Apply(DawEq.drag, mx)
        ReturnValue(1)
    }
}

Function.DawEq.Up {
    Output: Integer
    Body: {
        DawEq.drag = -1
        ReturnValue(0)
    }
}

Function.DawEq.FormatInt {
    Input: val: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(DawEq.num, 0) ThenBlock: { ReturnValue(0) }
        buf = DawEq.num
        neg = 0
        v = val
        IfCondition LessThan(v, 0) ThenBlock: {
            neg = 1
            v = Subtract(0, v)
        }
        i = 0
        IfCondition EqualTo(v, 0) ThenBlock: {
            SetByte(buf, 0, 48)
            i = 1
        }
        WhileLoop GreaterThan(v, 0) {
            SetByte(buf, i, Add(48, Modulo(v, 10)))
            v = Divide(v, 10)
            i = Add(i, 1)
        }
        j = Subtract(i, 1)
        k = 0
        WhileLoop LessThan(k, j) {
            a = GetByte(buf, k)
            SetByte(buf, k, GetByte(buf, j))
            SetByte(buf, j, a)
            k = Add(k, 1)
            j = Subtract(j, 1)
        }
        IfCondition EqualTo(neg, 1) ThenBlock: {
            k = i
            WhileLoop GreaterThan(k, 0) {
                prev = Subtract(k, 1)
                SetByte(buf, k, GetByte(buf, prev))
                k = prev
            }
            SetByte(buf, 0, 45)
            i = Add(i, 1)
        }
        SetByte(buf, i, 0)
        ReturnValue(i)
    }
}

Function.DawEq.FormatTenths {
    Input: val: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(DawEq.num, 0) ThenBlock: { ReturnValue(0) }
        buf = DawEq.num
        neg = 0
        v = val
        IfCondition LessThan(v, 0) ThenBlock: {
            neg = 1
            v = Subtract(0, v)
        }
        whole = Divide(v, 10)
        frac = Modulo(v, 10)
        p = 0
        IfCondition EqualTo(neg, 1) ThenBlock: {
            SetByte(buf, 0, 45)
            p = 1
        }
        IfCondition GreaterEqual(whole, 10) ThenBlock: {
            SetByte(buf, p, Add(48, Divide(whole, 10)))
            p = Add(p, 1)
            SetByte(buf, p, Add(48, Modulo(whole, 10)))
            p = Add(p, 1)
        }
        ElseBlock: {
            SetByte(buf, p, Add(48, whole))
            p = Add(p, 1)
        }
        SetByte(buf, p, 46)
        p = Add(p, 1)
        SetByte(buf, p, Add(48, frac))
        p = Add(p, 1)
        SetByte(buf, p, 0)
        ReturnValue(p)
    }
}

Function.DawEq.FreqAt {
    Input: i: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(i, 0) ThenBlock: { ReturnValue(20) }
        IfCondition EqualTo(i, 1) ThenBlock: { ReturnValue(25) }
        IfCondition EqualTo(i, 2) ThenBlock: { ReturnValue(31) }
        IfCondition EqualTo(i, 3) ThenBlock: { ReturnValue(38) }
        IfCondition EqualTo(i, 4) ThenBlock: { ReturnValue(47) }
        IfCondition EqualTo(i, 5) ThenBlock: { ReturnValue(59) }
        IfCondition EqualTo(i, 6) ThenBlock: { ReturnValue(73) }
        IfCondition EqualTo(i, 7) ThenBlock: { ReturnValue(91) }
        IfCondition EqualTo(i, 8) ThenBlock: { ReturnValue(112) }
        IfCondition EqualTo(i, 9) ThenBlock: { ReturnValue(140) }
        IfCondition EqualTo(i, 10) ThenBlock: { ReturnValue(173) }
        IfCondition EqualTo(i, 11) ThenBlock: { ReturnValue(215) }
        IfCondition EqualTo(i, 12) ThenBlock: { ReturnValue(267) }
        IfCondition EqualTo(i, 13) ThenBlock: { ReturnValue(331) }
        IfCondition EqualTo(i, 14) ThenBlock: { ReturnValue(411) }
        IfCondition EqualTo(i, 15) ThenBlock: { ReturnValue(510) }
        IfCondition EqualTo(i, 16) ThenBlock: { ReturnValue(632) }
        IfCondition EqualTo(i, 17) ThenBlock: { ReturnValue(785) }
        IfCondition EqualTo(i, 18) ThenBlock: { ReturnValue(974) }
        IfCondition EqualTo(i, 19) ThenBlock: { ReturnValue(1209) }
        IfCondition EqualTo(i, 20) ThenBlock: { ReturnValue(1500) }
        IfCondition EqualTo(i, 21) ThenBlock: { ReturnValue(1861) }
        IfCondition EqualTo(i, 22) ThenBlock: { ReturnValue(2310) }
        IfCondition EqualTo(i, 23) ThenBlock: { ReturnValue(2866) }
        IfCondition EqualTo(i, 24) ThenBlock: { ReturnValue(3557) }
        IfCondition EqualTo(i, 25) ThenBlock: { ReturnValue(4413) }
        IfCondition EqualTo(i, 26) ThenBlock: { ReturnValue(5477) }
        IfCondition EqualTo(i, 27) ThenBlock: { ReturnValue(6796) }
        IfCondition EqualTo(i, 28) ThenBlock: { ReturnValue(8434) }
        IfCondition EqualTo(i, 29) ThenBlock: { ReturnValue(10466) }
        IfCondition EqualTo(i, 30) ThenBlock: { ReturnValue(12988) }
        IfCondition EqualTo(i, 31) ThenBlock: { ReturnValue(16117) }
        ReturnValue(20000)
    }
}

Function.DawEq.FreqPos {
    Input: val: Integer
    Output: Integer
    Body: {
        best = 0
        i = 0
        WhileLoop LessThan(i, 33) {
            f = DawEq.FreqAt(i)
            IfCondition LessEqual(f, val) ThenBlock: { best = i }
            i = Add(i, 1)
        }
        ReturnValue(best)
    }
}

Function.DawEq.Label {
    Input: band: Integer
    Output: Address
    Body: {
        IfCondition EqualTo(band, 0) ThenBlock: { ReturnValue("Low") }
        IfCondition EqualTo(band, 1) ThenBlock: { ReturnValue("Low mid") }
        IfCondition EqualTo(band, 2) ThenBlock: { ReturnValue("High mid") }
        ReturnValue("High")
    }
}

Function.DawEq.Bar {
    Input: which: Integer
    Input: val: Integer
    Input: lo: Integer
    Input: hi: Integer
    Input: mark: Integer
    Output: Integer
    Body: {
        sx = DawEq.SliderX()
        sy = DawEq.SliderY(which)
        sw = DawEq.SliderW()
        ink = FB_RGB(230, 230, 224)
        gold = FB_RGB(240, 200, 60)
        FB_FillRectFast(sx, Add(sy, 5), sw, 4, FB_RGB(16, 18, 20))
        usable = Subtract(sw, 6)
        IfCondition LessThan(usable, 1) ThenBlock: { usable = 1 }
        IfCondition EqualTo(mark, 1) ThenBlock: {
            span = Subtract(hi, lo)
            pos = Subtract(val, lo)
            tx = Divide(Multiply(pos, usable), span)
        }
        ElseBlock: {
            best = DawEq.FreqPos(val)
            tx = Divide(Multiply(best, usable), 32)
        }
        IfCondition LessThan(tx, 0) ThenBlock: { tx = 0 }
        IfCondition GreaterThan(tx, usable) ThenBlock: { tx = usable }
        thumb = Add(sx, tx)
        IfCondition EqualTo(mark, 1) ThenBlock: {
            half = Divide(sw, 2)
            center = Add(sx, half)
            IfCondition GreaterThan(val, 0) ThenBlock: {
                IfCondition GreaterThan(thumb, center) ThenBlock: {
                    wide = Subtract(thumb, center)
                    FB_FillRectFast(center, Add(sy, 5), wide, 4, FB_RGB(46, 140, 72))
                }
            }
            IfCondition LessThan(val, 0) ThenBlock: {
                IfCondition GreaterThan(center, thumb) ThenBlock: {
                    wide = Subtract(center, thumb)
                    FB_FillRectFast(thumb, Add(sy, 5), wide, 4, FB_RGB(128, 52, 48))
                }
            }
            FB_VLine(center, sy, Add(sy, 14), gold)
        }
        knob = ink
        IfCondition EqualTo(DawEq.drag, which) ThenBlock: { knob = gold }
        FB_FillRectFast(thumb, sy, 6, 14, knob)
        nx = DawEq.NumX()
        IfCondition EqualTo(mark, 1) ThenBlock: { DawEq.FormatTenths(val) }
        ElseBlock: { DawEq.FormatInt(val) }
        IfCondition NotEqual(DawEq.num, 0) ThenBlock: {
            FB_DrawString(nx, sy, DawEq.num, ink, -1)
        }
        ReturnValue(0)
    }
}

Function.DawEq.Draw {
    Input: x: Integer
    Input: y: Integer
    Input: w: Integer
    Input: h: Integer
    Output: Integer
    Body: {
        DawEq.cx = x
        DawEq.cy = y
        DawEq.cw = w
        DawEq.ch = h
        ink = FB_RGB(230, 230, 224)
        dim = FB_RGB(150, 154, 160)
        FB_FillRectFast(x, y, w, h, FB_RGB(20, 22, 18))
        FB_DrawString(Add(x, 8), Add(y, 8), "EQ", ink, -1)
        DawEq.Boot()
        DawEq.Sync()
        IfCondition NotEqual(DawEq.tr, 0) ThenBlock: {
            name_at = PoolFieldOffset(LinkagePool.DawTrack, "name")
            nm = Dereference(Add(DawEq.tr, name_at))
            IfCondition NotEqual(nm, 0) ThenBlock: {
                FB_DrawString(Add(x, 40), Add(y, 8), nm, ink, -1)
            }
        }
        band = 0
        WhileLoop LessThan(band, 4) {
            top = DawEq.RowTop(band)
            IfCondition GreaterThan(band, 0) ThenBlock: {
                rule = Subtract(top, 4)
                FB_HLine(Add(x, 8), Subtract(Add(x, w), 8), rule, FB_RGB(40, 44, 40))
            }
            lab = DawEq.Label(band)
            FB_DrawString(Add(x, 8), Add(top, 2), lab, ink, -1)
            gy = DawEq.SliderY(Multiply(band, 2))
            fy = DawEq.SliderY(Add(Multiply(band, 2), 1))
            FB_DrawString(Add(x, 8), gy, "dB", dim, -1)
            FB_DrawString(Add(x, 8), fy, "Hz", dim, -1)
            gv = DawEq.Gain(band)
            fv = DawEq.Freq(band)
            DawEq.Bar(Multiply(band, 2), gv, -120, 120, 1)
            DawEq.Bar(Add(Multiply(band, 2), 1), fv, 20, 20000, 0)
            band = Add(band, 1)
        }
        ReturnValue(0)
    }
}
