// File menu. One header button, four commands underneath.
//
// Copyright © 2026 Sean Collins, 2 Paws Machine and Engineering. SCSL v1.0.

LibraryImport.Display.Render.Framebuffer

FixedPool.DawFile {
    "on":  Initialize=0, CanChange=True
    "x":   Initialize=0, CanChange=True
    "y":   Initialize=0, CanChange=True
    "w":   Initialize=120, CanChange=True
    "h":   Initialize=88, CanChange=True
    "hot": Initialize=-1, CanChange=True
    "bx":  Initialize=0, CanChange=True
    "by":  Initialize=0, CanChange=True
}

Function.DawFile.Open {
    Input: ax: Integer
    Input: ay: Integer
    Output: Integer
    Body: {
        left = ax
        top = ay
        limit = Subtract(FB.width, DawFile.w)
        IfCondition GreaterThan(left, limit) ThenBlock: { left = limit }
        IfCondition LessThan(left, 0) ThenBlock: { left = 0 }
        limit = Subtract(FB.height, DawFile.h)
        IfCondition GreaterThan(top, limit) ThenBlock: { top = limit }
        IfCondition LessThan(top, 0) ThenBlock: { top = 0 }
        DawFile.x = left
        DawFile.y = top
        DawFile.on = 1
        DawFile.hot = -1
        PrintMessage("filemenu ")
        PrintNumber(DawFile.x)
        PrintMessage(" ")
        PrintNumber(DawFile.y)
        PrintMessage("\n")
        ReturnValue(1)
    }
}

Function.DawFile.Row {
    Input: mx: Integer
    Input: my: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(DawFile.on, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition LessThan(mx, DawFile.x) ThenBlock: { ReturnValue(-1) }
        IfCondition LessThan(my, DawFile.y) ThenBlock: { ReturnValue(-1) }
        right = Add(DawFile.x, DawFile.w)
        IfCondition GreaterEqual(mx, right) ThenBlock: { ReturnValue(-1) }
        bot = Add(DawFile.y, DawFile.h)
        IfCondition GreaterEqual(my, bot) ThenBlock: { ReturnValue(-1) }
        rel = Subtract(my, DawFile.y)
        i = Divide(rel, 22)
        IfCondition LessThan(i, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition GreaterThan(i, 3) ThenBlock: { ReturnValue(-1) }
        ReturnValue(i)
    }
}

Function.DawFile.Hover {
    Input: mx: Integer
    Input: my: Integer
    Output: Integer
    Body: {
        DawFile.hot = DawFile.Row(mx, my)
        ReturnValue(DawFile.hot)
    }
}

Function.DawFile.Hit {
    Input: mx: Integer
    Input: my: Integer
    Output: Integer
    Body: {
        i = DawFile.Row(mx, my)
        IfCondition LessThan(i, 0) ThenBlock: { ReturnValue(0) }
        pick = Add(i, 1)
        ReturnValue(pick)
    }
}

Function.DawFile.Draw {
    Output: Integer
    Body: {
        IfCondition EqualTo(DawFile.on, 0) ThenBlock: { ReturnValue(0) }
        bg = FB_RGB(32, 36, 44)
        edge = FB_RGB(200, 180, 80)
        gold = FB_RGB(240, 200, 60)
        hi = FB_RGB(64, 86, 128)
        FB_FillRectFast(DawFile.x, DawFile.y, DawFile.w, DawFile.h, bg)
        FB_Rect(DawFile.x, DawFile.y, DawFile.w, DawFile.h, edge)
        i = 0
        WhileLoop LessThan(i, 4) {
            iy = Add(DawFile.y, Multiply(i, 22))
            lab = "New"
            IfCondition EqualTo(i, 1) ThenBlock: { lab = "Open" }
            IfCondition EqualTo(i, 2) ThenBlock: { lab = "Save" }
            IfCondition EqualTo(i, 3) ThenBlock: { lab = "Close" }
            ink = FB_RGB(236, 232, 210)
            IfCondition EqualTo(i, DawFile.hot) ThenBlock: {
                band = Subtract(DawFile.w, 4)
                hx = Add(DawFile.x, 2)
                FB_FillRectFast(hx, iy, band, 22, hi)
                FB_FillRectFast(hx, iy, 3, 22, gold)
                ink = FB_RGB(255, 248, 230)
            }
            tx = Add(DawFile.x, 12)
            ty = Add(iy, 6)
            FB_DrawString(tx, ty, lab, ink, -1)
            i = Add(i, 1)
        }
        ReturnValue(1)
    }
}
