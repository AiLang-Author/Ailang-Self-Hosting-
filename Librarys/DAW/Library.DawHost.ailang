// One Carla instance id per track. Minted once and stored on the track.
// Later launches are handed the same id. Bind does not start a process
// and it does not open the sound card. The desk sets live, then Sync
// execs /home/bob/Carla/bin/carla-ring for each track that has a host id.
//
// Copyright © 2026 Sean Collins, 2 Paws Machine and Engineering. SCSL v1.0.

LibraryImport.Arena
LibraryImport.DAW.DawTrack
LibraryImport.DAW.DawSong

FixedPool.DawHost {
    "live": Initialize=0, CanChange=True
    "pids": Initialize=0, CanChange=True
    "keep": Initialize=0, CanChange=True
    "n":    Initialize=0, CanChange=True
    "nap":  Initialize=0, CanChange=True
}

Function.DawHost.IdBuf {
    Input: val: Integer
    Output: Address
    Body: {
        buf = Allocate(24)
        IfCondition EqualTo(buf, 0) ThenBlock: { ReturnValue(0) }
        raw = Allocate(24)
        IfCondition EqualTo(raw, 0) ThenBlock: {
            Deallocate(buf, 24)
            ReturnValue(0)
        }
        SetByte(buf, 0, 99)
        v = val
        IfCondition LessThan(v, 0) ThenBlock: { v = 0 }
        i = 0
        IfCondition EqualTo(v, 0) ThenBlock: {
            SetByte(raw, 0, 48)
            i = 1
        }
        WhileLoop GreaterThan(v, 0) {
            dig = Modulo(v, 10)
            ch = Add(48, dig)
            SetByte(raw, i, ch)
            v = Divide(v, 10)
            i = Add(i, 1)
        }
        j = 0
        WhileLoop LessThan(j, i) {
            src = Subtract(i, 1)
            src = Subtract(src, j)
            pos = Add(j, 1)
            ch = GetByte(raw, src)
            SetByte(buf, pos, ch)
            j = Add(j, 1)
        }
        end = Add(i, 1)
        SetByte(buf, end, 0)
        Deallocate(raw, 24)
        ReturnValue(buf)
    }
}

Function.DawHost.Mint {
    Input: track: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(track, 0) ThenBlock: { ReturnValue(0) }
        cur = DawSong.HostOf(track)
        blank = DawSong.Blank(cur)
        IfCondition EqualTo(blank, 0) ThenBlock: { ReturnValue(1) }
        nxt = Add(DawSong.hseq, 1)
        buf = DawHost.IdBuf(nxt)
        IfCondition EqualTo(buf, 0) ThenBlock: { ReturnValue(0) }
        ok = DawTrack.SetHost(track, buf)
        Deallocate(buf, 24)
        IfCondition EqualTo(ok, 0) ThenBlock: { ReturnValue(0) }
        DawSong.hseq = nxt
        ReturnValue(1)
    }
}

Function.DawHost.Bind {
    Input: track: Address
    Input: plug: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(track, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(plug, 0) ThenBlock: { ReturnValue(0) }
        blank = DawSong.Blank(plug)
        IfCondition EqualTo(blank, 1) ThenBlock: { ReturnValue(0) }
        safe = DawSong.RelSafe(plug)
        IfCondition EqualTo(safe, 0) ThenBlock: { ReturnValue(0) }
        ok = DawHost.Mint(track)
        IfCondition EqualTo(ok, 0) ThenBlock: { ReturnValue(0) }
        ok = DawTrack.SetPlugin(track, plug)
        IfCondition EqualTo(ok, 0) ThenBlock: { ReturnValue(0) }
        id = DawSong.HostOf(track)
        rel = DawSong.VstRel(id)
        IfCondition EqualTo(rel, 0) ThenBlock: { ReturnValue(0) }
        ok = DawTrack.SetVst(track, rel)
        DawSong.FreeStr(rel)
        ReturnValue(ok)
    }
}

Function.DawHost.Boot {
    Output: Integer
    Body: {
        IfCondition NotEqual(DawHost.pids, 0) ThenBlock: { ReturnValue(1) }
        buf = Allocate(128)
        IfCondition EqualTo(buf, 0) ThenBlock: { ReturnValue(0) }
        keep = Allocate(128)
        IfCondition EqualTo(keep, 0) ThenBlock: {
            Deallocate(buf, 128)
            ReturnValue(0)
        }
        nap = Allocate(16)
        IfCondition EqualTo(nap, 0) ThenBlock: {
            Deallocate(buf, 128)
            Deallocate(keep, 128)
            ReturnValue(0)
        }
        i = 0
        WhileLoop LessThan(i, 128) {
            SetByte(buf, i, 0)
            SetByte(keep, i, 0)
            i = Add(i, 1)
        }
        StoreValue(nap, 0)
        StoreValue(Add(nap, 8), 20000000)
        DawHost.pids = buf
        DawHost.keep = keep
        DawHost.nap = nap
        DawHost.n = 0
        ReturnValue(1)
    }
}

Function.DawHost.At {
    Input: base: Address
    Input: index: Integer
    Output: Address
    Body: {
        off = Multiply(index, 8)
        ReturnValue(Add(base, off))
    }
}

Function.DawHost.Reap {
    Output: Integer
    Body: {
        run = 1
        WhileLoop EqualTo(run, 1) {
            got = SystemCall(61, -1, 0, 1, 0, 0)
            IfCondition LessEqual(got, 0) ThenBlock: { run = 0 }
        }
        ReturnValue(0)
    }
}

Function.DawHost.Gone {
    Input: pid: Integer
    Output: Integer
    Body: {
        i = 0
        WhileLoop LessThan(i, 50) {
            alive = SystemCall(62, pid, 0, 0, 0, 0)
            IfCondition NotEqual(alive, 0) ThenBlock: { ReturnValue(1) }
            got = SystemCall(61, pid, 0, 1, 0, 0)
            IfCondition GreaterThan(got, 0) ThenBlock: { ReturnValue(1) }
            SystemCall(35, DawHost.nap, 0, 0)
            i = Add(i, 1)
        }
        PrintMessage("carla stuck\n")
        ReturnValue(0)
    }
}

Function.DawHost.StopAll {
    Output: Integer
    Body: {
        IfCondition EqualTo(DawHost.pids, 0) ThenBlock: { ReturnValue(0) }
        i = 0
        WhileLoop LessThan(i, DawHost.n) {
            at = DawHost.At(DawHost.pids, i)
            pid = Dereference(at)
            IfCondition GreaterThan(pid, 0) ThenBlock: {
                SystemCall(62, pid, 15, 0, 0, 0)
                DawHost.Gone(pid)
            }
            kat = DawHost.At(DawHost.keep, i)
            keep = Dereference(kat)
            IfCondition NotEqual(keep, 0) ThenBlock: { DawSong.FreeStr(keep) }
            StoreValue(at, 0)
            StoreValue(kat, 0)
            i = Add(i, 1)
        }
        DawHost.n = 0
        DawHost.Reap()
        ReturnValue(1)
    }
}

Function.DawHost.Exec {
    Input: id: Address
    Input: plug: Address
    Input: state: Address
    Output: Integer
    Body: {
        argv = Allocate(64)
        IfCondition EqualTo(argv, 0) ThenBlock: {
            SystemCall(60, 127, 0, 0, 0, 0)
            ReturnValue(0)
        }
        bin = "/home/bob/Carla/bin/carla-ring"
        StoreValue(argv, bin)
        StoreValue(Add(argv, 8), "--id")
        StoreValue(Add(argv, 16), id)
        slot = 24
        pblank = DawSong.Blank(plug)
        IfCondition EqualTo(pblank, 0) ThenBlock: {
            StoreValue(Add(argv, slot), "--plugin")
            slot = Add(slot, 8)
            StoreValue(Add(argv, slot), plug)
            slot = Add(slot, 8)
        }
        sblank = DawSong.Blank(state)
        IfCondition EqualTo(sblank, 0) ThenBlock: {
            StoreValue(Add(argv, slot), "--state")
            slot = Add(slot, 8)
            StoreValue(Add(argv, slot), state)
            slot = Add(slot, 8)
        }
        StoreValue(Add(argv, slot), 0)
        envp = Allocate(8)
        StoreValue(envp, 0)
        SystemCall(59, bin, argv, envp, 0, 0)
        SystemCall(60, 127, 0, 0, 0, 0)
        ReturnValue(0)
    }
}

Function.DawHost.StartOne {
    Input: track: Address
    Output: Integer
    Body: {
        IfCondition GreaterEqual(DawHost.n, 16) ThenBlock: {
            PrintMessage("carla full\n")
            ReturnValue(0)
        }
        id = DawSong.HostOf(track)
        blank = DawSong.Blank(id)
        IfCondition EqualTo(blank, 1) ThenBlock: { ReturnValue(0) }
        plug = DawSong.PluginOf(track)
        state = 0
        vst = DawSong.VstOf(track)
        vblank = DawSong.Blank(vst)
        pblank = DawSong.Blank(DawSong.path)
        IfCondition EqualTo(vblank, 0) ThenBlock: {
            IfCondition EqualTo(pblank, 0) ThenBlock: {
                state = DawSong.Join(DawSong.path, vst)
            }
        }
        pid = SystemCall(57, 0, 0, 0, 0, 0)
        IfCondition EqualTo(pid, 0) ThenBlock: {
            DawHost.Exec(id, plug, state)
        }
        IfCondition LessThan(pid, 0) ThenBlock: {
            IfCondition NotEqual(state, 0) ThenBlock: { DawSong.FreeStr(state) }
            ReturnValue(0)
        }
        at = DawHost.At(DawHost.pids, DawHost.n)
        kat = DawHost.At(DawHost.keep, DawHost.n)
        StoreValue(at, pid)
        StoreValue(kat, state)
        DawHost.n = Add(DawHost.n, 1)
        PrintMessage("carla ")
        PrintMessage(id)
        PrintMessage("\n")
        ReturnValue(pid)
    }
}

Function.DawHost.Sync {
    Output: Integer
    Body: {
        IfCondition EqualTo(DawHost.live, 0) ThenBlock: { ReturnValue(0) }
        ok = DawHost.Boot()
        IfCondition EqualTo(ok, 0) ThenBlock: { ReturnValue(0) }
        DawHost.StopAll()
        noff = PoolFieldOffset(LinkagePool.DawTrack, "next")
        cur = DawTracks.head
        WhileLoop NotEqual(cur, 0) {
            DawHost.StartOne(cur)
            cur = Dereference(Add(cur, noff))
        }
        DawHost.Reap()
        ReturnValue(DawHost.n)
    }
}
