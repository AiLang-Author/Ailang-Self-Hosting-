// Inspector for the selected instance. Record, mute, solo, and the
// two openers (instrument and EQ) match the channel strip.
//
// Copyright © 2026 Sean Collins, 2 Paws Machine and Engineering. SCSL v1.0.

LibraryImport.DAW.DawTrack
LibraryImport.Display.Render.Framebuffer

FixedPool.DawIns {
    "x1": Initialize=0, CanChange=True
    "y1": Initialize=0, CanChange=True
    "x2": Initialize=0, CanChange=True
    "y2": Initialize=0, CanChange=True
}

Function.DawInspect.Draw {
    Input: x: Integer
    Input: y: Integer
    Input: w: Integer
    Input: h: Integer
    Output: Integer
    Body: {
        bg = FB_RGB(26, 28, 34)
        ink = FB_RGB(230, 230, 224)
        dim = FB_RGB(150, 154, 160)
        FB_FillRectFast(x, y, w, h, bg)
        FB_DrawString(Add(x, 8), Add(y, 8), "Inspector", ink, -1)
        tr = DawTracks.sel
        IfCondition EqualTo(tr, 0) ThenBlock: { ReturnValue(0) }
        name_at = PoolFieldOffset(LinkagePool.DawTrack, "name")
        inst_at = PoolFieldOffset(LinkagePool.DawTrack, "inst")
        kind_at = PoolFieldOffset(LinkagePool.DawTrack, "kind")
        a_at = PoolFieldOffset(LinkagePool.DawTrack, "arm")
        m_at = PoolFieldOffset(LinkagePool.DawTrack, "mute")
        s_at = PoolFieldOffset(LinkagePool.DawTrack, "solo")
        nm = Dereference(Add(tr, name_at))
        ins = Dereference(Add(tr, inst_at))
        FB_DrawString(Add(x, 8), Add(y, 36), nm, ink, -1)
        FB_DrawString(Add(x, 8), Add(y, 56), ins, dim, -1)
        kind = Dereference(Add(tr, kind_at))
        label = "sample"
        IfCondition EqualTo(kind, 1) ThenBlock: { label = "synth" }
        FB_DrawString(Add(x, 8), Add(y, 76), label, dim, -1)
        view_at = PoolFieldOffset(LinkagePool.DawTrack, "view")
        view = Dereference(Add(tr, view_at))
        vlab = "wave"
        IfCondition EqualTo(view, 1) ThenBlock: { vlab = "midi" }
        FB_DrawString(Add(x, 8), Add(y, 96), vlab, dim, -1)
        arm = Dereference(Add(tr, a_at))
        mute = Dereference(Add(tr, m_at))
        solo = Dereference(Add(tr, s_at))
        rlab = "REC off"
        IfCondition EqualTo(arm, 1) ThenBlock: { rlab = "REC on" }
        mlab = "M mute off"
        IfCondition EqualTo(mute, 1) ThenBlock: { mlab = "M mute on" }
        slab = "S solo off"
        IfCondition EqualTo(solo, 1) ThenBlock: { slab = "S solo on" }
        FB_DrawString(Add(x, 8), Add(y, 124), rlab, ink, -1)
        FB_DrawString(Add(x, 8), Add(y, 144), mlab, ink, -1)
        FB_DrawString(Add(x, 8), Add(y, 164), slab, ink, -1)
        slot = "SMP"
        IfCondition EqualTo(kind, 1) ThenBlock: { slot = "SYN" }
        DawIns.x1 = Add(x, 8)
        DawIns.y1 = Add(y, 196)
        DawIns.x2 = Add(x, 8)
        DawIns.y2 = Add(y, 224)
        FB_FillRectFast(DawIns.x1, DawIns.y1, 72, 22, FB_RGB(48, 56, 72))
        FB_DrawString(Add(DawIns.x1, 8), Add(DawIns.y1, 6), slot, ink, -1)
        FB_FillRectFast(DawIns.x2, DawIns.y2, 72, 22, FB_RGB(48, 56, 48))
        FB_DrawString(Add(DawIns.x2, 8), Add(DawIns.y2, 6), "EQ", ink, -1)
        ReturnValue(0)
    }
}

Function.DawInspect.Hit {
    Input: px: Integer
    Input: py: Integer
    Output: Integer
    Body: {
        IfCondition GreaterEqual(px, DawIns.x1) ThenBlock: {
            IfCondition LessThan(px, Add(DawIns.x1, 72)) ThenBlock: {
                IfCondition GreaterEqual(py, DawIns.y1) ThenBlock: {
                    IfCondition LessThan(py, Add(DawIns.y1, 22)) ThenBlock: {
                        ReturnValue(1)
                    }
                }
            }
        }
        IfCondition GreaterEqual(px, DawIns.x2) ThenBlock: {
            IfCondition LessThan(px, Add(DawIns.x2, 72)) ThenBlock: {
                IfCondition GreaterEqual(py, DawIns.y2) ThenBlock: {
                    IfCondition LessThan(py, Add(DawIns.y2, 22)) ThenBlock: {
                        ReturnValue(2)
                    }
                }
            }
        }
        ReturnValue(0)
    }
}
