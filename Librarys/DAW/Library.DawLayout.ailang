// Default workspace. The editor, mixer, and inspector start docked.
// Each can leave the session window. Restore puts them back.
//
// Copyright © 2026 Sean Collins, 2 Paws Machine and Engineering. SCSL v1.0.

LibraryImport.Applications.AppDesk
LibraryImport.DAW.DawTrack
LibraryImport.Display.Render.Framebuffer

FixedPool.DawLay {
    "edit": Initialize=1, CanChange=True
    "mix":  Initialize=1, CanChange=True
    "ins":  Initialize=1, CanChange=True
    "route": Initialize=0, CanChange=True
    "mixw": Initialize=-1, CanChange=True
    "insw": Initialize=-1, CanChange=True
    "editw": Initialize=-1, CanChange=True
    "routew": Initialize=-1, CanChange=True
    "bx":   Initialize=0, CanChange=True
    "by":   Initialize=0, CanChange=True
}

Function.DawLayout.Plain {
    Input: idx: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(idx, 0) ThenBlock: { ReturnValue(0) }
        AppDesk.Set(idx, AppDeskWin.KIND, 4)
        ReturnValue(idx)
    }
}

Function.DawLayout.Shutdown {
    Input: idx: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(idx, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(AppDesk.Get(idx, AppDeskWin.LIVE), 1) ThenBlock: {
            AppDesk.Close(idx)
        }
        ReturnValue(0)
    }
}

Function.DawLayout.Place {
    Input: idx: Integer
    Input: x: Integer
    Input: y: Integer
    Input: w: Integer
    Input: h: Integer
    Output: Integer
    Body: {
        DawLayout.Plain(idx)
        AppDesk.Set(idx, AppDeskWin.X, x)
        AppDesk.Set(idx, AppDeskWin.Y, y)
        AppDesk.Set(idx, AppDeskWin.W, w)
        AppDesk.Set(idx, AppDeskWin.H, h)
        ReturnValue(idx)
    }
}

Function.DawLayout.Restore {
    Output: Integer
    Body: {
        DawLay.edit = 1
        DawLay.mix = 1
        DawLay.ins = 1
        DawLay.route = 0
        DawLayout.Shutdown(DawLay.editw)
        DawLayout.Shutdown(DawLay.mixw)
        DawLayout.Shutdown(DawLay.insw)
        DawLayout.Shutdown(DawLay.routew)
        DawLay.editw = -1
        DawLay.mixw = -1
        DawLay.insw = -1
        DawLay.routew = -1
        DawTracks.arr_x = 0
        DawTracks.arr_y = 0
        DawTracks.edit_x = 0
        DawTracks.edit_y = 0
        DawTracks.con_y = 0
        DawTracks.zoom = 100
        ReturnValue(0)
    }
}

Function.DawLayout.One {
    Input: flag: Integer
    Input: idx: Integer
    Input: title: Address
    Input: obj: Integer
    Input: x: Integer
    Input: y: Integer
    Output: Integer
    Body: {
        ReturnValue(idx)
    }
}

Function.DawLayout.Sync {
    Output: Integer
    Body: {
        IfCondition EqualTo(DawLay.edit, 1) ThenBlock: {
            live = 0
            IfCondition GreaterEqual(DawLay.editw, 0) ThenBlock: {
                live = AppDesk.Get(DawLay.editw, AppDeskWin.LIVE)
            }
            IfCondition EqualTo(live, 0) ThenBlock: {
                DawLay.editw = AppDesk.Open(4, "Editor", 0)
                DawLayout.Place(DawLay.editw, 8, 430, 760, 270)
            }
        }
        ElseBlock: {
            DawLayout.Shutdown(DawLay.editw)
            DawLay.editw = -1
        }
        IfCondition EqualTo(DawLay.mix, 1) ThenBlock: {
            live = 0
            IfCondition GreaterEqual(DawLay.mixw, 0) ThenBlock: {
                live = AppDesk.Get(DawLay.mixw, AppDeskWin.LIVE)
            }
            IfCondition EqualTo(live, 0) ThenBlock: {
                DawLay.mixw = AppDesk.Open(2, "Mixer", 0)
                DawLayout.Place(DawLay.mixw, 780, 360, 480, 340)
            }
        }
        ElseBlock: {
            DawLayout.Shutdown(DawLay.mixw)
            DawLay.mixw = -1
        }
        IfCondition EqualTo(DawLay.ins, 1) ThenBlock: {
            live = 0
            IfCondition GreaterEqual(DawLay.insw, 0) ThenBlock: {
                live = AppDesk.Get(DawLay.insw, AppDeskWin.LIVE)
            }
            IfCondition EqualTo(live, 0) ThenBlock: {
                DawLay.insw = AppDesk.Open(3, "Inspector", 0)
                DawLayout.Place(DawLay.insw, 780, 8, 480, 340)
            }
        }
        ElseBlock: {
            DawLayout.Shutdown(DawLay.insw)
            DawLay.insw = -1
        }
        IfCondition EqualTo(DawLay.route, 1) ThenBlock: {
            live = 0
            IfCondition GreaterEqual(DawLay.routew, 0) ThenBlock: {
                live = AppDesk.Get(DawLay.routew, AppDeskWin.LIVE)
            }
            IfCondition EqualTo(live, 0) ThenBlock: {
                DawLay.routew = AppDesk.Open(9, "Route", 0)
                DawLayout.Place(DawLay.routew, 240, 160, 720, 480)
            }
        }
        ElseBlock: {
            DawLayout.Shutdown(DawLay.routew)
            DawLay.routew = -1
        }
        ReturnValue(0)
    }
}

Function.DawLayout.Hit {
    Input: px: Integer
    Input: py: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(py, DawLay.by) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterEqual(py, Add(DawLay.by, 16)) ThenBlock: { ReturnValue(0) }
        i = 0
        WhileLoop LessThan(i, 5) {
            x0 = Add(DawLay.bx, Multiply(i, 48))
            IfCondition GreaterEqual(px, x0) ThenBlock: {
                IfCondition LessThan(px, Add(x0, 44)) ThenBlock: {
                    ReturnValue(Add(i, 1))
                }
            }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

Function.DawLayout.DrawTools {
    Input: x: Integer
    Input: y: Integer
    Output: Integer
    Body: {
        DawLay.bx = x
        DawLay.by = y
        i = 0
        WhileLoop LessThan(i, 5) {
            bx = Add(x, Multiply(i, 48))
            on = 0
            IfCondition EqualTo(i, 0) ThenBlock: { on = DawLay.edit }
            IfCondition EqualTo(i, 1) ThenBlock: { on = DawLay.mix }
            IfCondition EqualTo(i, 2) ThenBlock: { on = DawLay.ins }
            IfCondition EqualTo(i, 3) ThenBlock: { on = DawLay.route }
            fill = FB_RGB(40, 44, 52)
            fg = FB_RGB(220, 220, 214)
            IfCondition EqualTo(on, 1) ThenBlock: {
                fill = FB_RGB(70, 120, 140)
            }
            FB_FillRectFast(bx, y, 44, 16, fill)
            lab = "EDIT"
            IfCondition EqualTo(i, 1) ThenBlock: { lab = "MIX" }
            IfCondition EqualTo(i, 2) ThenBlock: { lab = "INS" }
            IfCondition EqualTo(i, 3) ThenBlock: { lab = "ROUTE" }
            IfCondition EqualTo(i, 4) ThenBlock: { lab = "HOME" }
            tx = Add(bx, 4)
            IfCondition EqualTo(i, 3) ThenBlock: { tx = Add(bx, 2) }
            FB_DrawString(tx, Add(y, 4), lab, fg, -1)
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}
