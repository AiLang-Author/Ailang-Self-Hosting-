// Console fader law. Travel is marked in decibels, not percent.
// Unity, 0 dB, sits near the top. The bottom is minus infinity.
// That is the usual mixing-desk scale: small moves around 0, large
// moves in the quiet region.
//
// Copyright © 2026 Sean Collins, 2 Paws Machine and Engineering. SCSL v1.0.

LibraryImport.Display.Render.Framebuffer

Function.DawLevel.Span {
    Input: p: Integer
    Input: hi_p: Integer
    Input: lo_p: Integer
    Input: hi_t: Integer
    Input: lo_t: Integer
    Output: Integer
    Body: {
        num = Multiply(Subtract(p, lo_p), Subtract(hi_t, lo_t))
        den = Subtract(hi_p, lo_p)
        IfCondition LessThan(den, 1) ThenBlock: { den = 1 }
        ReturnValue(Add(lo_t, Divide(num, den)))
    }
}

// Tenths of a dB. -100000 means the fader is at the bottom stop.
Function.DawLevel.Tenths {
    Input: p: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(p, 0) ThenBlock: { p = 0 }
        IfCondition GreaterThan(p, 1000) ThenBlock: { p = 1000 }
        IfCondition EqualTo(p, 0) ThenBlock: { ReturnValue(-100000) }
        IfCondition GreaterEqual(p, 700) ThenBlock: {
            ReturnValue(DawLevel.Span(p, 1000, 700, 60, 0))
        }
        IfCondition GreaterEqual(p, 560) ThenBlock: {
            ReturnValue(DawLevel.Span(p, 700, 560, 0, -60))
        }
        IfCondition GreaterEqual(p, 430) ThenBlock: {
            ReturnValue(DawLevel.Span(p, 560, 430, -60, -120))
        }
        IfCondition GreaterEqual(p, 300) ThenBlock: {
            ReturnValue(DawLevel.Span(p, 430, 300, -120, -240))
        }
        IfCondition GreaterEqual(p, 160) ThenBlock: {
            ReturnValue(DawLevel.Span(p, 300, 160, -240, -480))
        }
        ReturnValue(DawLevel.Span(p, 160, 1, -480, -900))
    }
}

// Linear gain for the mixer. 256 is 0 dB. 512 is +6 dB. 0 is silence.
// The knots match the decibel marks. The mix is still sample * gain / 256.
Function.DawLevel.Gain {
    Input: p: Integer
    Output: Integer
    Body: {
        IfCondition LessEqual(p, 0) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterThan(p, 1000) ThenBlock: { p = 1000 }
        IfCondition GreaterEqual(p, 700) ThenBlock: {
            ReturnValue(Add(256, Divide(Multiply(Subtract(p, 700), 256), 300)))
        }
        IfCondition GreaterEqual(p, 560) ThenBlock: {
            ReturnValue(Add(128, Divide(Multiply(Subtract(p, 560), 128), 140)))
        }
        IfCondition GreaterEqual(p, 430) ThenBlock: {
            ReturnValue(Add(64, Divide(Multiply(Subtract(p, 430), 64), 130)))
        }
        IfCondition GreaterEqual(p, 300) ThenBlock: {
            ReturnValue(Add(16, Divide(Multiply(Subtract(p, 300), 48), 130)))
        }
        IfCondition GreaterEqual(p, 160) ThenBlock: {
            ReturnValue(Add(1, Divide(Multiply(Subtract(p, 160), 15), 140)))
        }
        ReturnValue(0)
    }
}

Function.DawLevel.Draw {
    Input: x: Integer
    Input: y: Integer
    Input: p: Integer
    Input: color: Integer
    Output: Integer
    Body: {
        t = DawLevel.Tenths(p)
        IfCondition EqualTo(t, -100000) ThenBlock: {
            FB_DrawString(x, y, "-inf", color, -1)
            ReturnValue(0)
        }
        sign = "+"
        av = t
        IfCondition LessThan(t, 0) ThenBlock: {
            sign = "-"
            av = Subtract(0, t)
        }
        FB_DrawString(x, y, sign, color, -1)
        whole = Divide(av, 10)
        frac = Modulo(av, 10)
        FB_DrawNumber(Add(x, 8), y, whole, color, -1)
        FB_DrawString(Add(x, 24), y, ".", color, -1)
        FB_DrawNumber(Add(x, 32), y, frac, color, -1)
        ReturnValue(0)
    }
}
