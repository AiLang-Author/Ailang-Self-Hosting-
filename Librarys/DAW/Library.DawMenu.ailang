// Right-click menu for a part. The words match the keys.
//
// Copyright © 2026 Sean Collins, 2 Paws Machine and Engineering. SCSL v1.0.

LibraryImport.DAW.DawClip
LibraryImport.Display.Render.Framebuffer

FixedPool.DawMenu {
    "on": Initialize=0, CanChange=True
    "x":  Initialize=0, CanChange=True
    "y":  Initialize=0, CanChange=True
    "w":  Initialize=148, CanChange=True
    "h":  Initialize=132, CanChange=True
    "hot": Initialize=-1, CanChange=True
}

Function.DawMenu.Open {
    Input: px: Integer
    Input: py: Integer
    Output: Integer
    Body: {
        limit = Subtract(FB.width, DawMenu.w)
        IfCondition GreaterThan(px, limit) ThenBlock: { px = limit }
        IfCondition LessThan(px, 0) ThenBlock: { px = 0 }
        limit = Subtract(FB.height, DawMenu.h)
        IfCondition GreaterThan(py, limit) ThenBlock: { py = limit }
        IfCondition LessThan(py, 0) ThenBlock: { py = 0 }
        DawMenu.x = px
        DawMenu.y = py
        DawMenu.on = 1
        DawMenu.hot = -1
        ReturnValue(1)
    }
}

Function.DawMenu.Row {
    Input: px: Integer
    Input: py: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(DawMenu.on, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition LessThan(px, DawMenu.x) ThenBlock: { ReturnValue(-1) }
        IfCondition LessThan(py, DawMenu.y) ThenBlock: { ReturnValue(-1) }
        IfCondition GreaterEqual(px, Add(DawMenu.x, DawMenu.w)) ThenBlock: { ReturnValue(-1) }
        IfCondition GreaterEqual(py, Add(DawMenu.y, DawMenu.h)) ThenBlock: { ReturnValue(-1) }
        rel = Subtract(py, DawMenu.y)
        i = Divide(rel, 22)
        IfCondition LessThan(i, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition GreaterThan(i, 5) ThenBlock: { ReturnValue(-1) }
        ReturnValue(i)
    }
}

Function.DawMenu.Hover {
    Input: px: Integer
    Input: py: Integer
    Output: Integer
    Body: {
        DawMenu.hot = DawMenu.Row(px, py)
        ReturnValue(DawMenu.hot)
    }
}

Function.DawMenu.Hit {
    Input: px: Integer
    Input: py: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(DawMenu.on, 0) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(px, DawMenu.x) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(py, DawMenu.y) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterEqual(px, Add(DawMenu.x, DawMenu.w)) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterEqual(py, Add(DawMenu.y, DawMenu.h)) ThenBlock: { ReturnValue(0) }
        rel = Subtract(py, DawMenu.y)
        i = Divide(rel, 22)
        IfCondition EqualTo(i, 0) ThenBlock: { ReturnValue(2) }
        IfCondition EqualTo(i, 1) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(i, 2) ThenBlock: { ReturnValue(3) }
        IfCondition EqualTo(i, 3) ThenBlock: { ReturnValue(4) }
        IfCondition EqualTo(i, 4) ThenBlock: { ReturnValue(6) }
        IfCondition EqualTo(i, 5) ThenBlock: { ReturnValue(5) }
        ReturnValue(0)
    }
}

Function.DawMenu.Draw {
    Output: Integer
    Body: {
        IfCondition EqualTo(DawMenu.on, 0) ThenBlock: { ReturnValue(0) }
        bg = FB_RGB(32, 36, 44)
        ink = FB_RGB(236, 232, 210)
        dim = FB_RGB(160, 164, 150)
        FB_FillRectFast(DawMenu.x, DawMenu.y, DawMenu.w, DawMenu.h, bg)
        FB_Rect(DawMenu.x, DawMenu.y, DawMenu.w, DawMenu.h, FB_RGB(200, 180, 80))
        i = 0
        WhileLoop LessThan(i, 6) {
            iy = Add(DawMenu.y, Multiply(i, 22))
            lab = "CUT"
            key = "play"
            IfCondition EqualTo(i, 1) ThenBlock: {
                lab = "COPY"
                key = "^C"
            }
            IfCondition EqualTo(i, 2) ThenBlock: {
                lab = "PASTE"
                key = "^V"
            }
            IfCondition EqualTo(i, 3) ThenBlock: {
                lab = "DUP"
                key = "^D"
            }
            IfCondition EqualTo(i, 4) ThenBlock: {
                lab = "SPLIT"
                key = "play"
            }
            IfCondition EqualTo(i, 5) ThenBlock: {
                lab = "ERASE"
                key = "Del"
            }
            IfCondition EqualTo(i, DawMenu.hot) ThenBlock: {
                FB_FillRectFast(Add(DawMenu.x, 2), iy, Subtract(DawMenu.w, 4), 22, FB_RGB(64, 86, 128))
                FB_FillRectFast(Add(DawMenu.x, 2), iy, 3, 22, FB_RGB(240, 200, 60))
                ink = FB_RGB(255, 248, 230)
                dim = FB_RGB(240, 200, 60)
            }
            ElseBlock: {
                ink = FB_RGB(236, 232, 210)
                dim = FB_RGB(160, 164, 150)
            }
            FB_DrawString(Add(DawMenu.x, 8), Add(iy, 6), lab, ink, -1)
            FB_DrawString(Add(DawMenu.x, 88), Add(iy, 6), key, dim, -1)
            i = Add(i, 1)
        }
        ReturnValue(1)
    }
}
