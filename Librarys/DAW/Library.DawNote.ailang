// Notes on one track. The editor selects, moves, trims, and adds these.
// A note the pointer just allocated can use @. A note loaded from the
// chain uses PoolFieldOffset. The field name has to be a literal.
//
// Copyright © 2026 Sean Collins, 2 Paws Machine and Engineering. SCSL v1.0.

LibraryImport.DAW.DawTrack

LinkagePool.DawNote {
    "next":    Initialize=0, PointerTo=LinkagePool.DawNote
    "start":   Initialize=0
    "length":  Initialize=28
    "pitch":   Initialize=60
    "sel":     Initialize=0
    "start0":  Initialize=0
    "pitch0":  Initialize=60
    "length0": Initialize=28
}

Function.DawNote.Head {
    Input: track: Address
    Output: Address
    Body: {
        IfCondition EqualTo(track, 0) ThenBlock: { ReturnValue(0) }
        at = PoolFieldOffset(LinkagePool.DawTrack, "notes")
        ReturnValue(Dereference(Add(track, at)))
    }
}

Function.DawNote.Add {
    Input: track: Address
    Input: start: Integer
    Input: length: Integer
    Input: pitch: Integer
    Output: Address
    Body: {
        IfCondition EqualTo(track, 0) ThenBlock: { ReturnValue(0) }
        n = AllocateLinkage(LinkagePool.DawNote)
        IfCondition EqualTo(n, 0) ThenBlock: { ReturnValue(0) }
        n@start = start
        n@length = length
        n@pitch = pitch
        n@start0 = start
        n@pitch0 = pitch
        n@length0 = length
        n@sel = 0
        at = PoolFieldOffset(LinkagePool.DawTrack, "notes")
        head = Dereference(Add(track, at))
        IfCondition EqualTo(head, 0) ThenBlock: {
            StoreValue(Add(track, at), n)
            ReturnValue(n)
        }
        noff = PoolFieldOffset(LinkagePool.DawNote, "next")
        cur = head
        nxt = Dereference(Add(cur, noff))
        WhileLoop NotEqual(nxt, 0) {
            cur = nxt
            nxt = Dereference(Add(cur, noff))
        }
        StoreValue(Add(cur, noff), n)
        ReturnValue(n)
    }
}

Function.DawNote.SelectOnly {
    Input: track: Address
    Input: note: Address
    Output: Integer
    Body: {
        soff = PoolFieldOffset(LinkagePool.DawNote, "sel")
        noff = PoolFieldOffset(LinkagePool.DawNote, "next")
        cur = DawNote.Head(track)
        WhileLoop NotEqual(cur, 0) {
            StoreValue(Add(cur, soff), 0)
            cur = Dereference(Add(cur, noff))
        }
        IfCondition NotEqual(note, 0) ThenBlock: {
            StoreValue(Add(note, soff), 1)
        }
        ReturnValue(1)
    }
}

Function.DawNote.SelectAll {
    Input: track: Address
    Output: Integer
    Body: {
        soff = PoolFieldOffset(LinkagePool.DawNote, "sel")
        noff = PoolFieldOffset(LinkagePool.DawNote, "next")
        cur = DawNote.Head(track)
        WhileLoop NotEqual(cur, 0) {
            StoreValue(Add(cur, soff), 1)
            cur = Dereference(Add(cur, noff))
        }
        ReturnValue(1)
    }
}

Function.DawNote.Capture {
    Input: track: Address
    Output: Integer
    Body: {
        soff = PoolFieldOffset(LinkagePool.DawNote, "sel")
        noff = PoolFieldOffset(LinkagePool.DawNote, "next")
        a0 = PoolFieldOffset(LinkagePool.DawNote, "start")
        b0 = PoolFieldOffset(LinkagePool.DawNote, "pitch")
        c0 = PoolFieldOffset(LinkagePool.DawNote, "length")
        as = PoolFieldOffset(LinkagePool.DawNote, "start0")
        bs = PoolFieldOffset(LinkagePool.DawNote, "pitch0")
        cs = PoolFieldOffset(LinkagePool.DawNote, "length0")
        cur = DawNote.Head(track)
        WhileLoop NotEqual(cur, 0) {
            selv = Dereference(Add(cur, soff))
            IfCondition EqualTo(selv, 1) ThenBlock: {
                v = Dereference(Add(cur, a0))
                StoreValue(Add(cur, as), v)
                v = Dereference(Add(cur, b0))
                StoreValue(Add(cur, bs), v)
                v = Dereference(Add(cur, c0))
                StoreValue(Add(cur, cs), v)
            }
            cur = Dereference(Add(cur, noff))
        }
        ReturnValue(1)
    }
}

Function.DawNote.MoveSel {
    Input: track: Address
    Input: dt: Integer
    Input: dp: Integer
    Output: Integer
    Body: {
        soff = PoolFieldOffset(LinkagePool.DawNote, "sel")
        noff = PoolFieldOffset(LinkagePool.DawNote, "next")
        a0 = PoolFieldOffset(LinkagePool.DawNote, "start0")
        b0 = PoolFieldOffset(LinkagePool.DawNote, "pitch0")
        as = PoolFieldOffset(LinkagePool.DawNote, "start")
        bs = PoolFieldOffset(LinkagePool.DawNote, "pitch")
        min_s = 999999
        max_s = 0
        min_p = 127
        max_p = 0
        any = 0
        cur = DawNote.Head(track)
        WhileLoop NotEqual(cur, 0) {
            selv = Dereference(Add(cur, soff))
            IfCondition EqualTo(selv, 1) ThenBlock: {
                any = 1
                v = Dereference(Add(cur, a0))
                IfCondition LessThan(v, min_s) ThenBlock: { min_s = v }
                IfCondition GreaterThan(v, max_s) ThenBlock: { max_s = v }
                v = Dereference(Add(cur, b0))
                IfCondition LessThan(v, min_p) ThenBlock: { min_p = v }
                IfCondition GreaterThan(v, max_p) ThenBlock: { max_p = v }
            }
            cur = Dereference(Add(cur, noff))
        }
        IfCondition EqualTo(any, 0) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(Add(min_s, dt), 0) ThenBlock: { dt = Subtract(0, min_s) }
        IfCondition GreaterThan(Add(max_s, dt), 4000) ThenBlock: { dt = Subtract(4000, max_s) }
        IfCondition LessThan(Add(min_p, dp), 0) ThenBlock: { dp = Subtract(0, min_p) }
        IfCondition GreaterThan(Add(max_p, dp), 127) ThenBlock: { dp = Subtract(127, max_p) }
        cur = DawNote.Head(track)
        WhileLoop NotEqual(cur, 0) {
            selv = Dereference(Add(cur, soff))
            IfCondition EqualTo(selv, 1) ThenBlock: {
                v = Dereference(Add(cur, a0))
                v = Add(v, dt)
                StoreValue(Add(cur, as), v)
                v = Dereference(Add(cur, b0))
                v = Add(v, dp)
                StoreValue(Add(cur, bs), v)
            }
            cur = Dereference(Add(cur, noff))
        }
        ReturnValue(1)
    }
}

Function.DawNote.LenSel {
    Input: track: Address
    Input: dt: Integer
    Output: Integer
    Body: {
        soff = PoolFieldOffset(LinkagePool.DawNote, "sel")
        noff = PoolFieldOffset(LinkagePool.DawNote, "next")
        c0 = PoolFieldOffset(LinkagePool.DawNote, "length0")
        cs = PoolFieldOffset(LinkagePool.DawNote, "length")
        cur = DawNote.Head(track)
        WhileLoop NotEqual(cur, 0) {
            selv = Dereference(Add(cur, soff))
            IfCondition EqualTo(selv, 1) ThenBlock: {
                v = Dereference(Add(cur, c0))
                v = Add(v, dt)
                IfCondition LessThan(v, 8) ThenBlock: { v = 8 }
                IfCondition GreaterThan(v, 800) ThenBlock: { v = 800 }
                StoreValue(Add(cur, cs), v)
            }
            cur = Dereference(Add(cur, noff))
        }
        ReturnValue(1)
    }
}

Function.DawNote.Shift {
    Input: track: Address
    Input: dp: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(dp, 0) ThenBlock: { ReturnValue(0) }
        soff = PoolFieldOffset(LinkagePool.DawNote, "sel")
        noff = PoolFieldOffset(LinkagePool.DawNote, "next")
        bs = PoolFieldOffset(LinkagePool.DawNote, "pitch")
        b0 = PoolFieldOffset(LinkagePool.DawNote, "pitch0")
        nsel = 0
        cur = DawNote.Head(track)
        WhileLoop NotEqual(cur, 0) {
            selv = Dereference(Add(cur, soff))
            IfCondition EqualTo(selv, 1) ThenBlock: { nsel = Add(nsel, 1) }
            cur = Dereference(Add(cur, noff))
        }
        min_p = 127
        max_p = 0
        any = 0
        cur = DawNote.Head(track)
        WhileLoop NotEqual(cur, 0) {
            selv = Dereference(Add(cur, soff))
            use = 0
            IfCondition EqualTo(nsel, 0) ThenBlock: { use = 1 }
            IfCondition EqualTo(selv, 1) ThenBlock: { use = 1 }
            IfCondition EqualTo(use, 1) ThenBlock: {
                any = 1
                v = Dereference(Add(cur, bs))
                IfCondition LessThan(v, min_p) ThenBlock: { min_p = v }
                IfCondition GreaterThan(v, max_p) ThenBlock: { max_p = v }
            }
            cur = Dereference(Add(cur, noff))
        }
        IfCondition EqualTo(any, 0) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(Add(min_p, dp), 0) ThenBlock: { dp = Subtract(0, min_p) }
        IfCondition GreaterThan(Add(max_p, dp), 127) ThenBlock: { dp = Subtract(127, max_p) }
        cur = DawNote.Head(track)
        WhileLoop NotEqual(cur, 0) {
            selv = Dereference(Add(cur, soff))
            use = 0
            IfCondition EqualTo(nsel, 0) ThenBlock: { use = 1 }
            IfCondition EqualTo(selv, 1) ThenBlock: { use = 1 }
            IfCondition EqualTo(use, 1) ThenBlock: {
                v = Dereference(Add(cur, bs))
                v = Add(v, dp)
                StoreValue(Add(cur, bs), v)
                StoreValue(Add(cur, b0), v)
            }
            cur = Dereference(Add(cur, noff))
        }
        ReturnValue(1)
    }
}

Function.DawNote.DeleteSel {
    Input: track: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(track, 0) ThenBlock: { ReturnValue(0) }
        at = PoolFieldOffset(LinkagePool.DawTrack, "notes")
        soff = PoolFieldOffset(LinkagePool.DawNote, "sel")
        noff = PoolFieldOffset(LinkagePool.DawNote, "next")
        prev = 0
        cur = Dereference(Add(track, at))
        WhileLoop NotEqual(cur, 0) {
            nxt = Dereference(Add(cur, noff))
            selv = Dereference(Add(cur, soff))
            IfCondition EqualTo(selv, 1) ThenBlock: {
                IfCondition EqualTo(prev, 0) ThenBlock: {
                    StoreValue(Add(track, at), nxt)
                }
                ElseBlock: {
                    StoreValue(Add(prev, noff), nxt)
                }
            }
            ElseBlock: {
                prev = cur
            }
            cur = nxt
        }
        ReturnValue(1)
    }
}
