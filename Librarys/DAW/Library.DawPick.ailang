// Dropdown on the track name, and the effect dropdown on a mixer strip.
// The row under the pointer is highlighted.
//
// Copyright © 2026 Sean Collins, 2 Paws Machine and Engineering. SCSL v1.0.

LibraryImport.Display.Render.Framebuffer

FixedPool.DawPick {
    "on":   Initialize=0, CanChange=True
    "mode": Initialize=0, CanChange=True
    "tr":   Initialize=0, CanChange=True
    "x":    Initialize=0, CanChange=True
    "y":    Initialize=0, CanChange=True
    "w":    Initialize=220, CanChange=True
    "h":    Initialize=120, CanChange=True
    "hot":  Initialize=-1, CanChange=True
    "rows": Initialize=3, CanChange=True
}

Function.DawPick.Open {
    Input: px: Integer
    Input: py: Integer
    Input: mode: Integer
    Input: track: Address
    Output: Integer
    Body: {
        DawPick.mode = mode
        DawPick.tr = track
        DawPick.rows = 3
        DawPick.h = 132
        IfCondition EqualTo(mode, 2) ThenBlock: {
            DawPick.rows = 3
            DawPick.h = 132
        }
        limit = Subtract(FB.width, DawPick.w)
        IfCondition GreaterThan(px, limit) ThenBlock: { px = limit }
        IfCondition LessThan(px, 0) ThenBlock: { px = 0 }
        limit = Subtract(FB.height, DawPick.h)
        IfCondition GreaterThan(py, limit) ThenBlock: { py = limit }
        IfCondition LessThan(py, 0) ThenBlock: { py = 0 }
        DawPick.x = px
        DawPick.y = py
        DawPick.hot = -1
        DawPick.on = 1
        ReturnValue(1)
    }
}

Function.DawPick.Row {
    Input: px: Integer
    Input: py: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(DawPick.on, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition LessThan(px, DawPick.x) ThenBlock: { ReturnValue(-1) }
        IfCondition GreaterEqual(px, Add(DawPick.x, DawPick.w)) ThenBlock: { ReturnValue(-1) }
        IfCondition LessThan(py, DawPick.y) ThenBlock: { ReturnValue(-1) }
        IfCondition GreaterEqual(py, Add(DawPick.y, DawPick.h)) ThenBlock: { ReturnValue(-1) }
        rel = Subtract(py, DawPick.y)
        i = Divide(rel, 44)
        IfCondition LessThan(i, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition GreaterEqual(i, DawPick.rows) ThenBlock: { ReturnValue(-1) }
        ReturnValue(i)
    }
}

Function.DawPick.Hover {
    Input: px: Integer
    Input: py: Integer
    Output: Integer
    Body: {
        DawPick.hot = DawPick.Row(px, py)
        ReturnValue(DawPick.hot)
    }
}

Function.DawPick.Hit {
    Input: px: Integer
    Input: py: Integer
    Output: Integer
    Body: {
        row = DawPick.Row(px, py)
        IfCondition LessThan(row, 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(Add(row, 1))
    }
}

Function.DawPick.Draw {
    Output: Integer
    Body: {
        IfCondition EqualTo(DawPick.on, 0) ThenBlock: { ReturnValue(0) }
        bg = FB_RGB(28, 32, 40)
        ink = FB_RGB(236, 232, 210)
        dim = FB_RGB(160, 164, 150)
        FB_FillRectFast(DawPick.x, DawPick.y, DawPick.w, DawPick.h, bg)
        FB_Rect(DawPick.x, DawPick.y, DawPick.w, DawPick.h, FB_RGB(240, 200, 60))
        i = 0
        WhileLoop LessThan(i, DawPick.rows) {
            iy = Add(DawPick.y, Multiply(i, 44))
            lab = "SYNTH"
            sub = "notes, synth"
            IfCondition EqualTo(DawPick.mode, 1) ThenBlock: {
                IfCondition EqualTo(i, 1) ThenBlock: {
                    lab = "SAMPLE"
                    sub = "notes, sampler"
                }
                IfCondition EqualTo(i, 2) ThenBlock: {
                    lab = "WAVE"
                    sub = "audio, no notes"
                }
            }
            IfCondition EqualTo(DawPick.mode, 2) ThenBlock: {
                lab = "EQ"
                sub = "equalizer"
                IfCondition EqualTo(i, 1) ThenBlock: {
                    lab = "COMP"
                    sub = "compressor"
                }
                IfCondition EqualTo(i, 2) ThenBlock: {
                    lab = "NONE"
                    sub = "no effect"
                }
            }
            fill = FB_RGB(40, 46, 56)
            fg = ink
            sg = dim
            IfCondition EqualTo(i, DawPick.hot) ThenBlock: {
                fill = FB_RGB(64, 86, 128)
                fg = FB_RGB(255, 248, 230)
                sg = FB_RGB(240, 200, 60)
            }
            FB_FillRectFast(Add(DawPick.x, 4), Add(iy, 2), Subtract(DawPick.w, 8), 40, fill)
            IfCondition EqualTo(i, DawPick.hot) ThenBlock: {
                FB_FillRectFast(Add(DawPick.x, 4), Add(iy, 2), 3, 40, FB_RGB(240, 200, 60))
            }
            FB_DrawString(Add(DawPick.x, 14), Add(iy, 6), lab, fg, -1)
            FB_DrawString(Add(DawPick.x, 14), Add(iy, 22), sub, sg, -1)
            i = Add(i, 1)
        }
        ReturnValue(1)
    }
}
