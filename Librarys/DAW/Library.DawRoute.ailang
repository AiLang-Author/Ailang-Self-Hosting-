// Connection list. Ports, slots, and cables. The mixer does not read this yet.
// The Route window is a patch bay of the same list.
// Top to bottom: inputs, mixer, effects, side, master, outputs.
// dir 0 is in, dir 1 is out. owner 0 hardware, 1 track, 2 bus, 3 master.
// kind 0 audio, 1 send, 2 return, 3 key.
//
// Copyright © 2026 Sean Collins, 2 Paws Machine and Engineering. SCSL v1.0.

LibraryImport.DAW.DawTrack
LibraryImport.Display.Render.Framebuffer

LinkagePool.DawPort {
    "next":     Initialize=0, PointerTo=LinkagePool.DawPort
    "owner":    Initialize=0
    "owner_ix": Initialize=0
    "track":    Initialize=0
    "dir":      Initialize=0
    "name":     Initialize=0
    "slots":    Initialize=0, PointerTo=LinkagePool.DawSlot
    "row":      Initialize=0
    "bay":      Initialize=0
    "jx":       Initialize=0
    "col":      Initialize=-1
    "label":    Initialize=0
}

LinkagePool.DawSlot {
    "next":  Initialize=0, PointerTo=LinkagePool.DawSlot
    "index": Initialize=0
    "role":  Initialize=0
}

LinkagePool.DawConn {
    "next":  Initialize=0, PointerTo=LinkagePool.DawConn
    "src":   Initialize=0
    "dst":   Initialize=0
    "kind":  Initialize=0
    "delay": Initialize=0
    "loop":  Initialize=0
    "map":   Initialize=0, PointerTo=LinkagePool.DawMap
    "row":   Initialize=0
}

LinkagePool.DawMap {
    "next":  Initialize=0, PointerTo=LinkagePool.DawMap
    "src_i": Initialize=0
    "dst_i": Initialize=0
}

LinkagePool.DawBind {
    "next":       Initialize=0, PointerTo=LinkagePool.DawBind
    "port":       Initialize=0
    "slot_index": Initialize=0
    "control":    Initialize=0
}

FixedPool.DawRoute {
    "ports":   Initialize=0, CanChange=True
    "conns":   Initialize=0, CanChange=True
    "binds":   Initialize=0, CanChange=True
    "rule":    Initialize=1, CanChange=True
    "src":     Initialize=0, CanChange=True
    "gkind":   Initialize=-1, CanChange=True
    "hw_in":   Initialize=0, CanChange=True
    "hw_out":  Initialize=0, CanChange=True
    "mst_in":  Initialize=0, CanChange=True
    "mst_out": Initialize=0, CanChange=True
    "scroll":  Initialize=0, CanChange=True
    "menu":    Initialize=0, CanChange=True
    "mx":      Initialize=0, CanChange=True
    "my":      Initialize=0, CanChange=True
    "why":     Initialize=0, CanChange=True
    "ox":      Initialize=0, CanChange=True
    "oy":      Initialize=0, CanChange=True
    "ow":      Initialize=0, CanChange=True
    "oh":      Initialize=0, CanChange=True
    "sel":     Initialize=0, CanChange=True
    "nrows":   Initialize=0, CanChange=True
    "vis":     Initialize=1, CanChange=True
    "hov":     Initialize=-1, CanChange=True
    "sbx":     Initialize=0, CanChange=True
    "sby":     Initialize=0, CanChange=True
    "sbh":     Initialize=0, CanChange=True
    "walk":    Initialize=0, CanChange=True
    "hot":     Initialize=-1, CanChange=True
    "arm":     Initialize=0, CanChange=True
    "ax":      Initialize=0, CanChange=True
    "ay":      Initialize=0, CanChange=True
    "x0":      Initialize=0, CanChange=True
    "y0":      Initialize=0, CanChange=True
    "lane":    Initialize=0, CanChange=True
    "pinx":    Initialize=0, CanChange=True
    "rh":      Initialize=0, CanChange=True
    "x1":      Initialize=0, CanChange=True
    "y1":      Initialize=0, CanChange=True
    "x2":      Initialize=0, CanChange=True
    "y2":      Initialize=0, CanChange=True
    "mid":     Initialize=0, CanChange=True
    "jog":     Initialize=0, CanChange=True
    "barw":    Initialize=0, CanChange=True
    "gx1":     Initialize=0, CanChange=True
    "gx2":     Initialize=0, CanChange=True
    "pitch":   Initialize=56, CanChange=True
    "sdrag":   Initialize=0, CanChange=True
    "sgrab":   Initialize=0, CanChange=True
}

Function.DawRoute.Link {
    Input: p: Address
    Output: Integer
    Body: {
        off = PoolFieldOffset(LinkagePool.DawPort, "next")
        IfCondition EqualTo(DawRoute.ports, 0) ThenBlock: {
            DawRoute.ports = p
            ReturnValue(1)
        }
        cur = DawRoute.ports
        nxt = Dereference(Add(cur, off))
        WhileLoop NotEqual(nxt, 0) {
            cur = nxt
            nxt = Dereference(Add(cur, off))
        }
        StoreValue(Add(cur, off), p)
        ReturnValue(1)
    }
}

Function.DawRoute.AddSlot {
    Input: port: Address
    Input: index: Integer
    Input: role: Address
    Output: Address
    Body: {
        IfCondition EqualTo(port, 0) ThenBlock: { ReturnValue(0) }
        s = AllocateLinkage(LinkagePool.DawSlot)
        IfCondition EqualTo(s, 0) ThenBlock: { ReturnValue(0) }
        s@next = 0
        s@index = index
        s@role = role
        soff = PoolFieldOffset(LinkagePool.DawPort, "slots")
        head = Dereference(Add(port, soff))
        IfCondition EqualTo(head, 0) ThenBlock: {
            StoreValue(Add(port, soff), s)
            ReturnValue(s)
        }
        noff = PoolFieldOffset(LinkagePool.DawSlot, "next")
        cur = head
        nxt = Dereference(Add(cur, noff))
        WhileLoop NotEqual(nxt, 0) {
            cur = nxt
            nxt = Dereference(Add(cur, noff))
        }
        StoreValue(Add(cur, noff), s)
        ReturnValue(s)
    }
}

Function.DawRoute.Pair {
    Input: port: Address
    Output: Integer
    Body: {
        DawRoute.AddSlot(port, 0, "L")
        DawRoute.AddSlot(port, 1, "R")
        ReturnValue(0)
    }
}

Function.DawRoute.Make {
    Input: code: Integer
    Input: track: Address
    Input: dir: Integer
    Input: name: Address
    Output: Address
    Body: {
        p = AllocateLinkage(LinkagePool.DawPort)
        IfCondition EqualTo(p, 0) ThenBlock: { ReturnValue(0) }
        p@owner = code
        p@owner_ix = 0
        p@track = track
        p@dir = dir
        p@name = name
        p@slots = 0
        p@row = 0
        p@bay = 0
        p@jx = 0
        p@col = -1
        DawRoute.Link(p)
        DawRoute.Pair(p)
        ReturnValue(p)
    }
}

Function.DawRoute.Bind {
    Input: port: Address
    Input: slot: Integer
    Input: control: Integer
    Output: Address
    Body: {
        IfCondition EqualTo(port, 0) ThenBlock: { ReturnValue(0) }
        b = AllocateLinkage(LinkagePool.DawBind)
        IfCondition EqualTo(b, 0) ThenBlock: { ReturnValue(0) }
        b@next = 0
        b@port = port
        b@slot_index = slot
        b@control = control
        off = PoolFieldOffset(LinkagePool.DawBind, "next")
        IfCondition EqualTo(DawRoute.binds, 0) ThenBlock: {
            DawRoute.binds = b
            ReturnValue(b)
        }
        cur = DawRoute.binds
        nxt = Dereference(Add(cur, off))
        WhileLoop NotEqual(nxt, 0) {
            cur = nxt
            nxt = Dereference(Add(cur, off))
        }
        StoreValue(Add(cur, off), b)
        ReturnValue(b)
    }
}

Function.DawRoute.Connect {
    Input: src: Address
    Input: dst: Address
    Input: kind: Integer
    Output: Address
    Body: {
        IfCondition EqualTo(src, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(dst, 0) ThenBlock: { ReturnValue(0) }
        cable = AllocateLinkage(LinkagePool.DawConn)
        IfCondition EqualTo(cable, 0) ThenBlock: { ReturnValue(0) }
        cable@next = 0
        cable@src = src
        cable@dst = dst
        cable@kind = kind
        cable@delay = 0
        cable@loop = 0
        cable@map = 0
        cable@row = 0
        off = PoolFieldOffset(LinkagePool.DawConn, "next")
        IfCondition EqualTo(DawRoute.conns, 0) ThenBlock: {
            DawRoute.conns = cable
            ReturnValue(cable)
        }
        cur = DawRoute.conns
        nxt = Dereference(Add(cur, off))
        WhileLoop NotEqual(nxt, 0) {
            cur = nxt
            nxt = Dereference(Add(cur, off))
        }
        StoreValue(Add(cur, off), cable)
        ReturnValue(cable)
    }
}

Function.DawRoute.Map {
    Input: conn: Address
    Input: src_i: Integer
    Input: dst_i: Integer
    Output: Address
    Body: {
        IfCondition EqualTo(conn, 0) ThenBlock: { ReturnValue(0) }
        m = AllocateLinkage(LinkagePool.DawMap)
        IfCondition EqualTo(m, 0) ThenBlock: { ReturnValue(0) }
        m@next = 0
        m@src_i = src_i
        m@dst_i = dst_i
        moff = PoolFieldOffset(LinkagePool.DawConn, "map")
        head = Dereference(Add(conn, moff))
        IfCondition EqualTo(head, 0) ThenBlock: {
            StoreValue(Add(conn, moff), m)
            ReturnValue(m)
        }
        noff = PoolFieldOffset(LinkagePool.DawMap, "next")
        cur = head
        nxt = Dereference(Add(cur, noff))
        WhileLoop NotEqual(nxt, 0) {
            cur = nxt
            nxt = Dereference(Add(cur, noff))
        }
        StoreValue(Add(cur, noff), m)
        ReturnValue(m)
    }
}

Function.DawRoute.Ensure {
    Output: Integer
    Body: {
        IfCondition NotEqual(DawRoute.hw_out, 0) ThenBlock: { ReturnValue(0) }
        hw_out = DawRoute.Make(0, 0, 1, "hw.out")
        hw_in = DawRoute.Make(0, 0, 0, "hw.in")
        mst_in = DawRoute.Make(3, 0, 0, "master.in")
        mst_out = DawRoute.Make(3, 0, 1, "master.out")
        DawRoute.SetBay(hw_out, 5)
        DawRoute.SetBay(hw_in, 0)
        DawRoute.SetBay(mst_in, 9)
        DawRoute.SetBay(mst_out, 4)
        DawRoute.hw_out = hw_out
        DawRoute.hw_in = hw_in
        DawRoute.mst_in = mst_in
        DawRoute.mst_out = mst_out
        DawRoute.Bind(mst_out, 0, 1)
        DawRoute.Bind(mst_out, 1, 2)
        ReturnValue(1)
    }
}

Function.DawRoute.Has {
    Input: track: Address
    Output: Integer
    Body: {
        off = PoolFieldOffset(LinkagePool.DawPort, "next")
        toff = PoolFieldOffset(LinkagePool.DawPort, "track")
        cur = DawRoute.ports
        WhileLoop NotEqual(cur, 0) {
            tr = Dereference(Add(cur, toff))
            IfCondition EqualTo(tr, track) ThenBlock: { ReturnValue(1) }
            cur = Dereference(Add(cur, off))
        }
        ReturnValue(0)
    }
}

Function.DawRoute.NameBuf {
    Input: track: Address
    Input: which: Integer
    Output: Address
    Body: {
        buf = Allocate(64)
        IfCondition EqualTo(buf, 0) ThenBlock: { ReturnValue(0) }
        n_at = PoolFieldOffset(LinkagePool.DawTrack, "name")
        nm = Dereference(Add(track, n_at))
        end = 0
        n = 0
        WhileLoop LessThan(n, 40) {
            ch = 0
            IfCondition NotEqual(nm, 0) ThenBlock: {
                ch = GetByte(nm, n)
            }
            IfCondition EqualTo(ch, 0) ThenBlock: {
                end = n
                n = 40
            }
            ElseBlock: {
                SetByte(buf, n, ch)
                n = Add(n, 1)
                end = n
            }
        }
        p0 = end
        p1 = Add(end, 1)
        p2 = Add(end, 2)
        p3 = Add(end, 3)
        p4 = Add(end, 4)
        SetByte(buf, p0, 46)
        IfCondition EqualTo(which, 0) ThenBlock: {
            SetByte(buf, p1, 105)
            SetByte(buf, p2, 110)
            SetByte(buf, p3, 0)
        }
        ElseBlock: {
            SetByte(buf, p1, 111)
            SetByte(buf, p2, 117)
            SetByte(buf, p3, 116)
            SetByte(buf, p4, 0)
        }
        ReturnValue(buf)
    }
}

Function.DawRoute.NameBay {
    Input: track: Address
    Input: which: Integer
    Output: Address
    Body: {
        buf = Allocate(64)
        IfCondition EqualTo(buf, 0) ThenBlock: { ReturnValue(0) }
        n_at = PoolFieldOffset(LinkagePool.DawTrack, "name")
        nm = Dereference(Add(track, n_at))
        end = 0
        n = 0
        WhileLoop LessThan(n, 40) {
            ch = 0
            IfCondition NotEqual(nm, 0) ThenBlock: {
                ch = GetByte(nm, n)
            }
            IfCondition EqualTo(ch, 0) ThenBlock: {
                end = n
                n = 40
            }
            ElseBlock: {
                SetByte(buf, n, ch)
                n = Add(n, 1)
                end = n
            }
        }
        SetByte(buf, end, 46)
        p1 = Add(end, 1)
        p2 = Add(end, 2)
        p3 = Add(end, 3)
        p4 = Add(end, 4)
        IfCondition EqualTo(which, 2) ThenBlock: {
            SetByte(buf, p1, 102)
            SetByte(buf, p2, 120)
            SetByte(buf, p3, 115)
            SetByte(buf, p4, 0)
        }
        IfCondition EqualTo(which, 3) ThenBlock: {
            SetByte(buf, p1, 102)
            SetByte(buf, p2, 120)
            SetByte(buf, p3, 114)
            SetByte(buf, p4, 0)
        }
        IfCondition EqualTo(which, 4) ThenBlock: {
            SetByte(buf, p1, 115)
            SetByte(buf, p2, 100)
            SetByte(buf, p3, 115)
            SetByte(buf, p4, 0)
        }
        IfCondition EqualTo(which, 5) ThenBlock: {
            SetByte(buf, p1, 115)
            SetByte(buf, p2, 100)
            SetByte(buf, p3, 114)
            SetByte(buf, p4, 0)
        }
        IfCondition EqualTo(which, 6) ThenBlock: {
            SetByte(buf, p1, 109)
            SetByte(buf, p2, 115)
            SetByte(buf, p3, 116)
            SetByte(buf, p4, 0)
        }
        ReturnValue(buf)
    }
}

Function.DawRoute.Attach {
    Input: track: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(track, 0) ThenBlock: { ReturnValue(0) }
        got = DawRoute.Has(track)
        IfCondition EqualTo(got, 1) ThenBlock: { ReturnValue(0) }
        DawRoute.Ensure()
        code = 1
        k_at = PoolFieldOffset(LinkagePool.DawTrack, "kind")
        kv = Dereference(Add(track, k_at))
        IfCondition EqualTo(kv, 2) ThenBlock: { code = 2 }
        in_nm = DawRoute.NameBuf(track, 0)
        out_nm = DawRoute.NameBuf(track, 1)
        pin = DawRoute.Make(code, track, 0, in_nm)
        pout = DawRoute.Make(code, track, 1, out_nm)
        DawRoute.SetBay(pin, 1)
        DawRoute.SetBay(pout, 1)
        DawRoute.Bind(pout, 0, 0)
        DawRoute.Bind(pout, 1, 0)
        fn = DawRoute.NameBay(track, 2)
        fxs = DawRoute.Make(code, track, 1, fn)
        DawRoute.SetBay(fxs, 2)
        fn = DawRoute.NameBay(track, 3)
        fxr = DawRoute.Make(code, track, 0, fn)
        DawRoute.SetBay(fxr, 2)
        fn = DawRoute.NameBay(track, 4)
        sds = DawRoute.Make(code, track, 1, fn)
        DawRoute.SetBay(sds, 3)
        fn = DawRoute.NameBay(track, 5)
        sdr = DawRoute.Make(code, track, 0, fn)
        DawRoute.SetBay(sdr, 3)
        fn = DawRoute.NameBay(track, 6)
        minp = DawRoute.Make(3, track, 0, fn)
        DawRoute.SetBay(minp, 4)
        IfCondition EqualTo(DawRoute.rule, 1) ThenBlock: {
            cable = DawRoute.Connect(pout, minp, 0)
            DawRoute.Map(cable, 0, 0)
            DawRoute.Map(cable, 1, 1)
        }
        ReturnValue(1)
    }
}

Function.DawRoute.CutBind {
    Input: port: Address
    Output: Integer
    Body: {
        off = PoolFieldOffset(LinkagePool.DawBind, "next")
        poff = PoolFieldOffset(LinkagePool.DawBind, "port")
        prev = 0
        cur = DawRoute.binds
        WhileLoop NotEqual(cur, 0) {
            nxt = Dereference(Add(cur, off))
            bp = Dereference(Add(cur, poff))
            IfCondition EqualTo(bp, port) ThenBlock: {
                IfCondition EqualTo(prev, 0) ThenBlock: {
                    DawRoute.binds = nxt
                }
                ElseBlock: {
                    StoreValue(Add(prev, off), nxt)
                }
            }
            ElseBlock: {
                prev = cur
            }
            cur = nxt
        }
        ReturnValue(0)
    }
}

Function.DawRoute.CutConn {
    Input: track: Address
    Output: Integer
    Body: {
        off = PoolFieldOffset(LinkagePool.DawConn, "next")
        soff = PoolFieldOffset(LinkagePool.DawConn, "src")
        doff = PoolFieldOffset(LinkagePool.DawConn, "dst")
        toff = PoolFieldOffset(LinkagePool.DawPort, "track")
        prev = 0
        cur = DawRoute.conns
        WhileLoop NotEqual(cur, 0) {
            nxt = Dereference(Add(cur, off))
            sp = Dereference(Add(cur, soff))
            dp = Dereference(Add(cur, doff))
            hit = 0
            IfCondition NotEqual(sp, 0) ThenBlock: {
                st = Dereference(Add(sp, toff))
                IfCondition EqualTo(st, track) ThenBlock: { hit = 1 }
            }
            IfCondition NotEqual(dp, 0) ThenBlock: {
                dt = Dereference(Add(dp, toff))
                IfCondition EqualTo(dt, track) ThenBlock: { hit = 1 }
            }
            IfCondition EqualTo(hit, 1) ThenBlock: {
                IfCondition EqualTo(cur, DawRoute.sel) ThenBlock: {
                    DawRoute.sel = 0
                }
                IfCondition EqualTo(prev, 0) ThenBlock: {
                    DawRoute.conns = nxt
                }
                ElseBlock: {
                    StoreValue(Add(prev, off), nxt)
                }
            }
            ElseBlock: {
                prev = cur
            }
            cur = nxt
        }
        ReturnValue(0)
    }
}

Function.DawRoute.CutPort {
    Input: track: Address
    Output: Integer
    Body: {
        off = PoolFieldOffset(LinkagePool.DawPort, "next")
        toff = PoolFieldOffset(LinkagePool.DawPort, "track")
        prev = 0
        cur = DawRoute.ports
        WhileLoop NotEqual(cur, 0) {
            nxt = Dereference(Add(cur, off))
            tr = Dereference(Add(cur, toff))
            IfCondition EqualTo(tr, track) ThenBlock: {
                IfCondition EqualTo(cur, DawRoute.src) ThenBlock: {
                    DawRoute.src = 0
                    DawRoute.gkind = -1
                    DawRoute.menu = 0
                }
                DawRoute.CutBind(cur)
                IfCondition EqualTo(prev, 0) ThenBlock: {
                    DawRoute.ports = nxt
                }
                ElseBlock: {
                    StoreValue(Add(prev, off), nxt)
                }
            }
            ElseBlock: {
                prev = cur
            }
            cur = nxt
        }
        ReturnValue(0)
    }
}

Function.DawRoute.Drop {
    Input: track: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(track, 0) ThenBlock: { ReturnValue(0) }
        DawRoute.CutConn(track)
        DawRoute.CutPort(track)
        ReturnValue(1)
    }
}

Function.DawRoute.Monitor {
    Output: Integer
    Body: {
        DawRoute.Ensure()
        off = PoolFieldOffset(LinkagePool.DawConn, "next")
        soff = PoolFieldOffset(LinkagePool.DawConn, "src")
        doff = PoolFieldOffset(LinkagePool.DawConn, "dst")
        koff = PoolFieldOffset(LinkagePool.DawConn, "kind")
        cur = DawRoute.conns
        WhileLoop NotEqual(cur, 0) {
            sp = Dereference(Add(cur, soff))
            dp = Dereference(Add(cur, doff))
            kk = Dereference(Add(cur, koff))
            IfCondition EqualTo(sp, DawRoute.mst_out) ThenBlock: {
                IfCondition EqualTo(dp, DawRoute.hw_out) ThenBlock: {
                    IfCondition EqualTo(kk, 0) ThenBlock: { ReturnValue(0) }
                }
            }
            cur = Dereference(Add(cur, off))
        }
        cable = DawRoute.Connect(DawRoute.mst_out, DawRoute.hw_out, 0)
        DawRoute.Map(cable, 0, 0)
        DawRoute.Map(cable, 1, 1)
        ReturnValue(1)
    }
}

Function.DawRoute.Report {
    Output: Integer
    Body: {
        off = PoolFieldOffset(LinkagePool.DawConn, "next")
        n = 0
        cur = DawRoute.conns
        WhileLoop NotEqual(cur, 0) {
            n = Add(n, 1)
            cur = Dereference(Add(cur, off))
        }
        PrintMessage("routes ")
        PrintNumber(n)
        PrintMessage("\n")
        ReturnValue(n)
    }
}

Function.DawRoute.ApplyAlsa {
    Output: Integer
    Body: {
        IfCondition NotEqual(DawRoute.hw_out, 0) ThenBlock: {
            got = DawRoute.PLabel(DawRoute.hw_out)
            IfCondition NotEqual(got, 0) ThenBlock: { ReturnValue(0) }
        }
        fd = SystemCall(2, "/dev/shm/daw/alsa_io.txt", 0, 0)
        IfCondition LessThan(fd, 0) ThenBlock: { ReturnValue(0) }
        buf = Allocate(4096)
        IfCondition EqualTo(buf, 0) ThenBlock: {
            SystemCall(3, fd, 0, 0)
            ReturnValue(0)
        }
        n = SystemCall(0, fd, buf, 4095)
        SystemCall(3, fd, 0, 0)
        IfCondition LessThan(n, 3) ThenBlock: {
            Deallocate(buf, 4096)
            ReturnValue(0)
        }
        SetByte(buf, n, 0)
        i = 0
        outs = 0
        ins = 0
        WhileLoop LessThan(i, n) {
            ch = GetByte(buf, i)
            IfCondition EqualTo(ch, 10) ThenBlock: {
                i = Add(i, 1)
            }
            ElseBlock: {
                kind = ch
                i = Add(i, 1)
                IfCondition LessThan(i, n) ThenBlock: {
                    sp = GetByte(buf, i)
                    IfCondition EqualTo(sp, 32) ThenBlock: { i = Add(i, 1) }
                }
                dev = 0
                run = 1
                WhileLoop EqualTo(run, 1) {
                    IfCondition GreaterEqual(i, n) ThenBlock: { run = 0 }
                    ElseBlock: {
                        dig = GetByte(buf, i)
                        okd = 0
                        IfCondition GreaterEqual(dig, 48) ThenBlock: {
                            IfCondition LessEqual(dig, 57) ThenBlock: { okd = 1 }
                        }
                        IfCondition EqualTo(okd, 1) ThenBlock: {
                            dev = Multiply(dev, 10)
                            dev = Add(dev, Subtract(dig, 48))
                            i = Add(i, 1)
                        }
                        ElseBlock: { run = 0 }
                    }
                }
                IfCondition LessThan(i, n) ThenBlock: {
                    sp2 = GetByte(buf, i)
                    IfCondition EqualTo(sp2, 32) ThenBlock: { i = Add(i, 1) }
                }
                lab = Allocate(64)
                k = 0
                IfCondition NotEqual(lab, 0) ThenBlock: {
                    copy = 1
                    WhileLoop EqualTo(copy, 1) {
                        IfCondition GreaterEqual(i, n) ThenBlock: { copy = 0 }
                        ElseBlock: {
                            IfCondition GreaterEqual(k, 40) ThenBlock: { copy = 0 }
                            ElseBlock: {
                                c2 = GetByte(buf, i)
                                IfCondition EqualTo(c2, 10) ThenBlock: { copy = 0 }
                                ElseBlock: {
                                    IfCondition EqualTo(c2, 0) ThenBlock: { copy = 0 }
                                    ElseBlock: {
                                        SetByte(lab, k, c2)
                                        k = Add(k, 1)
                                        i = Add(i, 1)
                                    }
                                }
                            }
                        }
                    }
                    SetByte(lab, k, 0)
                }
                skip = 1
                WhileLoop EqualTo(skip, 1) {
                    IfCondition GreaterEqual(i, n) ThenBlock: { skip = 0 }
                    ElseBlock: {
                        c3 = GetByte(buf, i)
                        i = Add(i, 1)
                        IfCondition EqualTo(c3, 10) ThenBlock: { skip = 0 }
                    }
                }
                keep = 0
                IfCondition GreaterThan(k, 0) ThenBlock: { keep = 1 }
                IfCondition EqualTo(lab, 0) ThenBlock: { keep = 0 }
                IfCondition EqualTo(keep, 1) ThenBlock: {
                    IfCondition EqualTo(kind, 79) ThenBlock: {
                        IfCondition EqualTo(outs, 0) ThenBlock: {
                            DawRoute.SetLabel(DawRoute.hw_out, lab)
                            DawRoute.SetIx(DawRoute.hw_out, dev)
                            outs = 1
                        }
                        ElseBlock: {
                            neu = DawRoute.Make(0, 0, 1, lab)
                            DawRoute.SetBay(neu, 5)
                            DawRoute.SetLabel(neu, lab)
                            DawRoute.SetIx(neu, dev)
                            outs = Add(outs, 1)
                        }
                    }
                    IfCondition EqualTo(kind, 73) ThenBlock: {
                        IfCondition EqualTo(ins, 0) ThenBlock: {
                            DawRoute.SetLabel(DawRoute.hw_in, lab)
                            DawRoute.SetIx(DawRoute.hw_in, dev)
                            ins = 1
                        }
                        ElseBlock: {
                            neu2 = DawRoute.Make(0, 0, 0, lab)
                            DawRoute.SetBay(neu2, 0)
                            DawRoute.SetLabel(neu2, lab)
                            DawRoute.SetIx(neu2, dev)
                            ins = Add(ins, 1)
                        }
                    }
                }
                IfCondition EqualTo(keep, 0) ThenBlock: {
                    IfCondition NotEqual(lab, 0) ThenBlock: { Deallocate(lab, 64) }
                }
            }
        }
        Deallocate(buf, 4096)
        ReturnValue(Add(outs, ins))
    }
}

