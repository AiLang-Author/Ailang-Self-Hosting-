Function.DawRoute.SameOwner {
    Input: a: Address
    Input: b: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(a, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(b, 0) ThenBlock: { ReturnValue(0) }
        oa = DawRoute.POwner(a)
        ob = DawRoute.POwner(b)
        IfCondition EqualTo(oa, 3) ThenBlock: {
            IfCondition EqualTo(ob, 3) ThenBlock: { ReturnValue(1) }
        }
        IfCondition EqualTo(oa, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(ob, 0) ThenBlock: { ReturnValue(0) }
        ta = DawRoute.PTrack(a)
        tb = DawRoute.PTrack(b)
        IfCondition EqualTo(ta, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(ta, tb) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

Function.DawRoute.Offers {
    Input: port: Address
    Input: kind: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(port, 0) ThenBlock: { ReturnValue(0) }
        own = DawRoute.POwner(port)
        dir = DawRoute.PDir(port)
        IfCondition EqualTo(own, 0) ThenBlock: {
            IfCondition EqualTo(dir, 0) ThenBlock: {
                IfCondition EqualTo(kind, 2) ThenBlock: { ReturnValue(1) }
            }
            ReturnValue(0)
        }
        IfCondition EqualTo(dir, 1) ThenBlock: {
            IfCondition EqualTo(own, 1) ThenBlock: {
                IfCondition EqualTo(kind, 0) ThenBlock: { ReturnValue(1) }
                IfCondition EqualTo(kind, 1) ThenBlock: { ReturnValue(1) }
                IfCondition EqualTo(kind, 3) ThenBlock: { ReturnValue(1) }
            }
            IfCondition EqualTo(own, 2) ThenBlock: {
                IfCondition EqualTo(kind, 0) ThenBlock: { ReturnValue(1) }
                IfCondition EqualTo(kind, 1) ThenBlock: { ReturnValue(1) }
                IfCondition EqualTo(kind, 3) ThenBlock: { ReturnValue(1) }
            }
            IfCondition EqualTo(own, 3) ThenBlock: {
                IfCondition EqualTo(kind, 0) ThenBlock: { ReturnValue(1) }
                IfCondition EqualTo(kind, 1) ThenBlock: { ReturnValue(1) }
            }
        }
        ReturnValue(0)
    }
}

Function.DawRoute.Legal {
    Input: dst: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(dst, 0) ThenBlock: { ReturnValue(2) }
        own = DawRoute.POwner(dst)
        dir = DawRoute.PDir(dst)
        kk = DawRoute.gkind
        IfCondition EqualTo(kk, 2) ThenBlock: {
            IfCondition EqualTo(dir, 0) ThenBlock: {
                IfCondition EqualTo(own, 1) ThenBlock: { ReturnValue(0) }
                IfCondition EqualTo(own, 2) ThenBlock: { ReturnValue(0) }
            }
            ReturnValue(1)
        }
        IfCondition EqualTo(kk, 3) ThenBlock: {
            IfCondition EqualTo(dir, 0) ThenBlock: {
                IfCondition EqualTo(own, 1) ThenBlock: { ReturnValue(0) }
                IfCondition EqualTo(own, 2) ThenBlock: { ReturnValue(0) }
            }
            ReturnValue(2)
        }
        IfCondition EqualTo(kk, 1) ThenBlock: {
            IfCondition EqualTo(dst, DawRoute.hw_out) ThenBlock: { ReturnValue(0) }
            IfCondition EqualTo(own, 0) ThenBlock: {
                IfCondition EqualTo(dir, 1) ThenBlock: { ReturnValue(0) }
            }
            ReturnValue(2)
        }
        IfCondition EqualTo(DawRoute.src, DawRoute.mst_out) ThenBlock: {
            IfCondition EqualTo(dst, DawRoute.hw_out) ThenBlock: { ReturnValue(0) }
            ReturnValue(2)
        }
        so = DawRoute.POwner(DawRoute.src)
        sd = DawRoute.PDir(DawRoute.src)
        IfCondition EqualTo(sd, 1) ThenBlock: {
            IfCondition EqualTo(so, 1) ThenBlock: {
                IfCondition EqualTo(dir, 0) ThenBlock: {
                    IfCondition EqualTo(own, 2) ThenBlock: { ReturnValue(0) }
                    IfCondition EqualTo(own, 3) ThenBlock: { ReturnValue(0) }
                }
            }
            IfCondition EqualTo(so, 2) ThenBlock: {
                IfCondition EqualTo(dir, 0) ThenBlock: {
                    IfCondition EqualTo(own, 2) ThenBlock: { ReturnValue(0) }
                    IfCondition EqualTo(own, 3) ThenBlock: { ReturnValue(0) }
                }
            }
        }
        ReturnValue(2)
    }
}

Function.DawRoute.Reaches {
    Input: start: Address
    Input: goal: Address
    Input: depth: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(start, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(goal, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(DawRoute.walk, 0) ThenBlock: {
            DawRoute.walk = Allocate(640)
        }
        buf = DawRoute.walk
        IfCondition EqualTo(buf, 0) ThenBlock: { ReturnValue(0) }
        cap = depth
        IfCondition LessThan(cap, 1) ThenBlock: { cap = 32 }
        StoreValue(buf, start)
        nstack = 1
        nseen = 0
        steps = 0
        found = 0
        run = 1
        off = PoolFieldOffset(LinkagePool.DawConn, "next")
        soff = PoolFieldOffset(LinkagePool.DawConn, "src")
        doff = PoolFieldOffset(LinkagePool.DawConn, "dst")
        koff = PoolFieldOffset(LinkagePool.DawConn, "kind")
        WhileLoop EqualTo(run, 1) {
            IfCondition LessThan(nstack, 1) ThenBlock: { run = 0 }
            ElseBlock: {
                IfCondition GreaterThan(steps, cap) ThenBlock: { run = 0 }
                ElseBlock: {
                    nstack = Subtract(nstack, 1)
                    slot = Multiply(nstack, 8)
                    here = Dereference(Add(buf, slot))
                    steps = Add(steps, 1)
                    seen = 0
                    si = 0
                    WhileLoop LessThan(si, nseen) {
                        sslot = Add(256, Multiply(si, 8))
                        prev = Dereference(Add(buf, sslot))
                        same = DawRoute.SameOwner(prev, here)
                        IfCondition EqualTo(same, 1) ThenBlock: { seen = 1 }
                        si = Add(si, 1)
                    }
                    IfCondition EqualTo(seen, 0) ThenBlock: {
                        IfCondition LessThan(nseen, 40) ThenBlock: {
                            sslot = Add(256, Multiply(nseen, 8))
                            StoreValue(Add(buf, sslot), here)
                            nseen = Add(nseen, 1)
                        }
                        cur = DawRoute.conns
                        WhileLoop NotEqual(cur, 0) {
                            IfCondition EqualTo(found, 0) ThenBlock: {
                                sp = Dereference(Add(cur, soff))
                                dp = Dereference(Add(cur, doff))
                                kk = Dereference(Add(cur, koff))
                                IfCondition EqualTo(kk, 0) ThenBlock: {
                                    IfCondition NotEqual(sp, 0) ThenBlock: {
                                        IfCondition NotEqual(dp, 0) ThenBlock: {
                                            srcsame = DawRoute.SameOwner(sp, here)
                                            IfCondition EqualTo(srcsame, 1) ThenBlock: {
                                                own = DawRoute.POwner(dp)
                                                follow = 0
                                                IfCondition EqualTo(own, 1) ThenBlock: { follow = 1 }
                                                IfCondition EqualTo(own, 2) ThenBlock: { follow = 1 }
                                                IfCondition EqualTo(own, 3) ThenBlock: { follow = 1 }
                                                IfCondition EqualTo(follow, 1) ThenBlock: {
                                                    hit = DawRoute.SameOwner(dp, goal)
                                                    IfCondition EqualTo(hit, 1) ThenBlock: { found = 1 }
                                                    ElseBlock: {
                                                        IfCondition LessThan(nstack, 30) ThenBlock: {
                                                            dslot = Multiply(nstack, 8)
                                                            StoreValue(Add(buf, dslot), dp)
                                                            nstack = Add(nstack, 1)
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                            cur = Dereference(Add(cur, off))
                        }
                    }
                    IfCondition EqualTo(found, 1) ThenBlock: { run = 0 }
                }
            }
        }
        ReturnValue(found)
    }
}

Function.DawRoute.MaxLoop {
    Output: Integer
    Body: {
        off = PoolFieldOffset(LinkagePool.DawConn, "next")
        top = 0
        cur = DawRoute.conns
        WhileLoop NotEqual(cur, 0) {
            lp = DawRoute.CLoop(cur)
            IfCondition GreaterThan(lp, top) ThenBlock: { top = lp }
            cur = Dereference(Add(cur, off))
        }
        ReturnValue(top)
    }
}

Function.DawRoute.Unlink {
    Input: conn: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(conn, 0) ThenBlock: { ReturnValue(0) }
        off = PoolFieldOffset(LinkagePool.DawConn, "next")
        prev = 0
        cur = DawRoute.conns
        WhileLoop NotEqual(cur, 0) {
            nxt = Dereference(Add(cur, off))
            IfCondition EqualTo(cur, conn) ThenBlock: {
                IfCondition EqualTo(DawRoute.sel, conn) ThenBlock: {
                    DawRoute.sel = 0
                }
                IfCondition EqualTo(prev, 0) ThenBlock: {
                    DawRoute.conns = nxt
                }
                ElseBlock: {
                    StoreValue(Add(prev, off), nxt)
                }
                ReturnValue(1)
            }
            prev = cur
            cur = nxt
        }
        ReturnValue(0)
    }
}

Function.DawRoute.KeepsDry {
    Input: src: Address
    Output: Integer
    Body: {
        tr = DawRoute.PTrack(src)
        off = PoolFieldOffset(LinkagePool.DawConn, "next")
        cur = DawRoute.conns
        WhileLoop NotEqual(cur, 0) {
            sp = DawRoute.CSrc(cur)
            kk = DawRoute.CKind(cur)
            IfCondition EqualTo(sp, src) ThenBlock: {
                IfCondition EqualTo(kk, 1) ThenBlock: {
                    dp = DawRoute.CDst(cur)
                    dt = DawRoute.PTrack(dp)
                    IfCondition EqualTo(dt, tr) ThenBlock: {
                        bb = DawRoute.PBay(dp)
                        IfCondition EqualTo(bb, 2) ThenBlock: { ReturnValue(1) }
                        IfCondition EqualTo(bb, 3) ThenBlock: { ReturnValue(1) }
                    }
                }
            }
            cur = Dereference(Add(cur, off))
        }
        ReturnValue(0)
    }
}

Function.DawRoute.CutLoop {
    Input: conn: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(conn, 0) ThenBlock: { ReturnValue(0) }
        lp = DawRoute.CLoop(conn)
        IfCondition EqualTo(lp, 0) ThenBlock: {
            DawRoute.Unlink(conn)
            DawRoute.sel = 0
            DawRoute.why = 0
            ReturnValue(1)
        }
        off = PoolFieldOffset(LinkagePool.DawConn, "next")
        cur = DawRoute.conns
        src = 0
        WhileLoop NotEqual(cur, 0) {
            got = DawRoute.CLoop(cur)
            IfCondition EqualTo(got, lp) ThenBlock: {
                kk = DawRoute.CKind(cur)
                IfCondition EqualTo(kk, 1) ThenBlock: {
                    src = DawRoute.CSrc(cur)
                }
            }
            cur = Dereference(Add(cur, off))
        }
        prev = 0
        cur = DawRoute.conns
        WhileLoop NotEqual(cur, 0) {
            nxt = Dereference(Add(cur, off))
            got = DawRoute.CLoop(cur)
            IfCondition EqualTo(got, lp) ThenBlock: {
                IfCondition EqualTo(cur, DawRoute.sel) ThenBlock: {
                    DawRoute.sel = 0
                }
                IfCondition EqualTo(prev, 0) ThenBlock: {
                    DawRoute.conns = nxt
                }
                ElseBlock: {
                    StoreValue(Add(prev, off), nxt)
                }
            }
            ElseBlock: { prev = cur }
            cur = nxt
        }
        IfCondition NotEqual(src, 0) ThenBlock: {
            bb = DawRoute.PBay(src)
            dd = DawRoute.PDir(src)
            IfCondition EqualTo(bb, 1) ThenBlock: {
                IfCondition EqualTo(dd, 1) ThenBlock: {
                    held = DawRoute.KeepsDry(src)
                    IfCondition EqualTo(held, 0) ThenBlock: {
                        tr = DawRoute.PTrack(src)
                        mstp = DawRoute.Find(tr, 4, 0)
                        IfCondition NotEqual(mstp, 0) ThenBlock: {
                            dry = DawRoute.SameConn(src, mstp, 0)
                            IfCondition EqualTo(dry, 0) ThenBlock: {
                                DawRoute.Wire(src, mstp, 0, 0)
                            }
                        }
                    }
                }
            }
        }
        DawRoute.sel = 0
        DawRoute.why = 0
        ReturnValue(1)
    }
}

Function.DawRoute.Finish {
    Input: dst: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(dst, 0) ThenBlock: {
            DawRoute.why = 4
            ReturnValue(0)
        }
        IfCondition EqualTo(DawRoute.src, 0) ThenBlock: {
            DawRoute.why = 4
            ReturnValue(0)
        }
        code = DawRoute.Legal(dst)
        IfCondition NotEqual(code, 0) ThenBlock: {
            DawRoute.why = code
            ReturnValue(0)
        }
        IfCondition EqualTo(DawRoute.gkind, 0) ThenBlock: {
            mon = 0
            IfCondition EqualTo(DawRoute.src, DawRoute.mst_out) ThenBlock: {
                IfCondition EqualTo(dst, DawRoute.hw_out) ThenBlock: { mon = 1 }
            }
            IfCondition EqualTo(mon, 0) ThenBlock: {
                self = DawRoute.SameOwner(DawRoute.src, dst)
                IfCondition EqualTo(self, 1) ThenBlock: {
                    DawRoute.why = 3
                    ReturnValue(0)
                }
                got = DawRoute.Reaches(dst, DawRoute.src, 32)
                IfCondition EqualTo(got, 1) ThenBlock: {
                    DawRoute.why = 3
                    ReturnValue(0)
                }
            }
        }
        loopv = 0
        IfCondition EqualTo(DawRoute.gkind, 1) ThenBlock: {
            top = DawRoute.MaxLoop()
            loopv = Add(top, 1)
        }
        IfCondition EqualTo(DawRoute.gkind, 2) ThenBlock: {
            IfCondition NotEqual(DawRoute.sel, 0) ThenBlock: {
                sk = DawRoute.CKind(DawRoute.sel)
                IfCondition EqualTo(sk, 1) ThenBlock: {
                    loopv = DawRoute.CLoop(DawRoute.sel)
                }
            }
        }
        made = DawRoute.Connect(DawRoute.src, dst, DawRoute.gkind)
        IfCondition EqualTo(made, 0) ThenBlock: {
            DawRoute.why = 4
            ReturnValue(0)
        }
        DawRoute.SetLoop(made, loopv)
        DawRoute.Map(made, 0, 0)
        DawRoute.Map(made, 1, 1)
        DawRoute.sel = made
        DawRoute.src = 0
        DawRoute.gkind = -1
        DawRoute.why = 0
        DawRoute.menu = 0
        ReturnValue(1)
    }
}

Function.DawRoute.InGroup {
    Input: port: Address
    Input: group: Integer
    Output: Integer
    Body: {
        own = DawRoute.POwner(port)
        dir = DawRoute.PDir(port)
        IfCondition EqualTo(group, 0) ThenBlock: {
            IfCondition EqualTo(own, 0) ThenBlock: {
                IfCondition EqualTo(dir, 0) ThenBlock: { ReturnValue(1) }
            }
            ReturnValue(0)
        }
        IfCondition EqualTo(group, 1) ThenBlock: {
            IfCondition EqualTo(own, 0) ThenBlock: {
                IfCondition EqualTo(dir, 1) ThenBlock: { ReturnValue(1) }
            }
            ReturnValue(0)
        }
        IfCondition EqualTo(group, 2) ThenBlock: {
            IfCondition EqualTo(own, 1) ThenBlock: { ReturnValue(1) }
            ReturnValue(0)
        }
        IfCondition EqualTo(group, 3) ThenBlock: {
            IfCondition EqualTo(own, 2) ThenBlock: { ReturnValue(1) }
            ReturnValue(0)
        }
        IfCondition EqualTo(group, 4) ThenBlock: {
            IfCondition EqualTo(own, 3) ThenBlock: { ReturnValue(1) }
            ReturnValue(0)
        }
        ReturnValue(0)
    }
}

Function.DawRoute.GroupN {
    Input: group: Integer
    Output: Integer
    Body: {
        off = PoolFieldOffset(LinkagePool.DawPort, "next")
        cur = DawRoute.ports
        cnt = 0
        WhileLoop NotEqual(cur, 0) {
            ing = DawRoute.InGroup(cur, group)
            IfCondition EqualTo(ing, 1) ThenBlock: { cnt = Add(cnt, 1) }
            cur = Dereference(Add(cur, off))
        }
        ReturnValue(cnt)
    }
}

Function.DawRoute.HeadWord {
    Input: group: Integer
    Output: Address
    Body: {
        lab = "Hardware in"
        IfCondition EqualTo(group, 1) ThenBlock: { lab = "Hardware out" }
        IfCondition EqualTo(group, 2) ThenBlock: { lab = "Tracks" }
        IfCondition EqualTo(group, 3) ThenBlock: { lab = "Buses" }
        IfCondition EqualTo(group, 4) ThenBlock: { lab = "Master" }
        ReturnValue(lab)
    }
}

Function.DawRoute.KindWord {
    Input: kk: Integer
    Output: Address
    Body: {
        lab = "Audio"
        IfCondition EqualTo(kk, 1) ThenBlock: { lab = "Send" }
        IfCondition EqualTo(kk, 2) ThenBlock: { lab = "Return" }
        IfCondition EqualTo(kk, 3) ThenBlock: { lab = "Key" }
        ReturnValue(lab)
    }
}

Function.DawRoute.BusOrd {
    Input: port: Address
    Output: Integer
    Body: {
        goal = DawRoute.PTrack(port)
        off = PoolFieldOffset(LinkagePool.DawPort, "next")
        cur = DawRoute.ports
        idx = 0
        WhileLoop NotEqual(cur, 0) {
            own = DawRoute.POwner(cur)
            dir = DawRoute.PDir(cur)
            IfCondition EqualTo(own, 2) ThenBlock: {
                IfCondition EqualTo(dir, 0) ThenBlock: {
                    tr = DawRoute.PTrack(cur)
                    IfCondition EqualTo(tr, goal) ThenBlock: { ReturnValue(idx) }
                    idx = Add(idx, 1)
                }
            }
            cur = Dereference(Add(cur, off))
        }
        ReturnValue(0)
    }
}

Function.DawRoute.BusInk {
    Input: idx: Integer
    Output: Integer
    Body: {
        k = Modulo(idx, 8)
        col = FB_RGB(70, 120, 140)
        IfCondition EqualTo(k, 1) ThenBlock: { col = FB_RGB(70, 190, 90) }
        IfCondition EqualTo(k, 2) ThenBlock: { col = FB_RGB(80, 160, 160) }
        IfCondition EqualTo(k, 3) ThenBlock: { col = FB_RGB(120, 140, 200) }
        IfCondition EqualTo(k, 4) ThenBlock: { col = FB_RGB(180, 140, 200) }
        IfCondition EqualTo(k, 5) ThenBlock: { col = FB_RGB(160, 180, 120) }
        IfCondition EqualTo(k, 6) ThenBlock: { col = FB_RGB(140, 160, 200) }
        IfCondition EqualTo(k, 7) ThenBlock: { col = FB_RGB(100, 150, 130) }
        ReturnValue(col)
    }
}

Function.DawRoute.LoopInk {
    Input: lp: Integer
    Output: Integer
    Body: {
        k = lp
        IfCondition LessThan(k, 1) ThenBlock: { k = 1 }
        k = Modulo(Subtract(k, 1), 4)
        col = FB_RGB(220, 140, 60)
        IfCondition EqualTo(k, 1) ThenBlock: { col = FB_RGB(200, 100, 160) }
        IfCondition EqualTo(k, 2) ThenBlock: { col = FB_RGB(160, 120, 200) }
        IfCondition EqualTo(k, 3) ThenBlock: { col = FB_RGB(200, 160, 100) }
        ReturnValue(col)
    }
}

Function.DawRoute.Ink {
    Input: conn: Address
    Output: Integer
    Body: {
        col = FB_RGB(170, 190, 170)
        IfCondition EqualTo(conn, 0) ThenBlock: { ReturnValue(col) }
        kk = DawRoute.CKind(conn)
        sp = DawRoute.CSrc(conn)
        dp = DawRoute.CDst(conn)
        lp = DawRoute.CLoop(conn)
        IfCondition EqualTo(kk, 3) ThenBlock: {
            col = FB_RGB(230, 90, 200)
            ReturnValue(col)
        }
        IfCondition EqualTo(kk, 1) ThenBlock: {
            col = DawRoute.LoopInk(lp)
            ReturnValue(col)
        }
        IfCondition EqualTo(kk, 2) ThenBlock: {
            IfCondition NotEqual(lp, 0) ThenBlock: {
                col = DawRoute.LoopInk(lp)
                ReturnValue(col)
            }
            col = FB_RGB(80, 170, 180)
            ReturnValue(col)
        }
        IfCondition EqualTo(kk, 0) ThenBlock: {
            IfCondition EqualTo(sp, DawRoute.mst_out) ThenBlock: {
                IfCondition EqualTo(dp, DawRoute.hw_out) ThenBlock: {
                    col = FB_RGB(200, 180, 80)
                    ReturnValue(col)
                }
            }
            IfCondition NotEqual(dp, 0) ThenBlock: {
                own = DawRoute.POwner(dp)
                IfCondition EqualTo(own, 2) ThenBlock: {
                    ord = DawRoute.BusOrd(dp)
                    col = DawRoute.BusInk(ord)
                    ReturnValue(col)
                }
            }
        }
        ReturnValue(col)
    }
}

Function.DawRoute.Cancel {
    Output: Integer
    Body: {
        DawRoute.gkind = -1
        DawRoute.menu = 0
        DawRoute.src = 0
        DawRoute.why = 0
        ReturnValue(0)
    }
}

Function.DawRoute.Inside {
    Input: px: Integer
    Input: py: Integer
    Output: Integer
    Body: {
        IfCondition LessEqual(DawRoute.ow, 0) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(px, DawRoute.ox) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(py, DawRoute.oy) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterEqual(px, Add(DawRoute.ox, DawRoute.ow)) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterEqual(py, Add(DawRoute.oy, DawRoute.oh)) ThenBlock: { ReturnValue(0) }
        ReturnValue(1)
    }
}

Function.DawRoute.Measure {
    Output: Integer
    Body: {
        g = 0
        rows = 0
        WhileLoop LessThan(g, 5) {
            gn = DawRoute.GroupN(g)
            IfCondition GreaterThan(gn, 0) ThenBlock: {
                rows = Add(rows, 1)
                rows = Add(rows, gn)
            }
            g = Add(g, 1)
        }
        DawRoute.nrows = rows
        ReturnValue(rows)
    }
}

Function.DawRoute.ClampScroll {
    Output: Integer
    Body: {
        maxs = Subtract(DawRoute.nrows, DawRoute.vis)
        IfCondition LessThan(maxs, 0) ThenBlock: { maxs = 0 }
        IfCondition LessThan(DawRoute.scroll, 0) ThenBlock: { DawRoute.scroll = 0 }
        IfCondition GreaterThan(DawRoute.scroll, maxs) ThenBlock: { DawRoute.scroll = maxs }
        ReturnValue(DawRoute.scroll)
    }
}

Function.DawRoute.ClearRows {
    Output: Integer
    Body: {
        off = PoolFieldOffset(LinkagePool.DawPort, "next")
        cur = DawRoute.ports
        WhileLoop NotEqual(cur, 0) {
            DawRoute.SetPRow(cur, 0)
            cur = Dereference(Add(cur, off))
        }
        off = PoolFieldOffset(LinkagePool.DawConn, "next")
        cur = DawRoute.conns
        WhileLoop NotEqual(cur, 0) {
            DawRoute.SetCRow(cur, 0)
            cur = Dereference(Add(cur, off))
        }
        ReturnValue(0)
    }
}

Function.DawRoute.DrawRoles {
    Input: port: Address
    Input: yy: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(port, 0) ThenBlock: { ReturnValue(0) }
        soff = PoolFieldOffset(LinkagePool.DawPort, "slots")
        head = Dereference(Add(port, soff))
        noff = PoolFieldOffset(LinkagePool.DawSlot, "next")
        roff = PoolFieldOffset(LinkagePool.DawSlot, "role")
        ioff = PoolFieldOffset(LinkagePool.DawSlot, "index")
        dim = FB_RGB(160, 164, 150)
        cur = head
        WhileLoop NotEqual(cur, 0) {
            role = Dereference(Add(cur, roff))
            ix = Dereference(Add(cur, ioff))
            IfCondition NotEqual(role, 0) ThenBlock: {
                rx = Add(DawRoute.ox, Add(148, Multiply(ix, 16)))
                FB_DrawString(rx, yy, role, dim, -1)
            }
            cur = Dereference(Add(cur, noff))
        }
        ReturnValue(0)
    }
}

Function.DawRoute.DrawPort {
    Input: port: Address
    Input: yy: Integer
    Output: Integer
    Body: {
        DawRoute.SetPRow(port, yy)
        fill = FB_RGB(24, 26, 32)
        ink = FB_RGB(220, 220, 214)
        IfCondition EqualTo(port, DawRoute.src) ThenBlock: {
            fill = FB_RGB(48, 44, 24)
        }
        x0 = Add(DawRoute.ox, 4)
        FB_FillRectFast(x0, yy, 220, 14, fill)
        IfCondition EqualTo(port, DawRoute.src) ThenBlock: {
            bar = FB_RGB(200, 180, 80)
            FB_FillRectFast(x0, yy, 3, 14, bar)
        }
        name = DawRoute.PName(port)
        ty = Add(yy, 3)
        IfCondition NotEqual(name, 0) ThenBlock: {
            tx = Add(DawRoute.ox, 10)
            FB_DrawString(tx, ty, name, ink, -1)
        }
        DawRoute.DrawRoles(port, ty)
        ReturnValue(0)
    }
}

Function.DawRoute.DrawPorts {
    Output: Integer
    Body: {
        gold = FB_RGB(200, 180, 80)
        off = PoolFieldOffset(LinkagePool.DawPort, "next")
        shown = 0
        row_i = 0
        g = 0
        yy = Add(DawRoute.oy, 18)
        WhileLoop LessThan(g, 5) {
            gn = DawRoute.GroupN(g)
            IfCondition GreaterThan(gn, 0) ThenBlock: {
                IfCondition GreaterEqual(row_i, DawRoute.scroll) ThenBlock: {
                    IfCondition LessThan(shown, DawRoute.vis) ThenBlock: {
                        word = DawRoute.HeadWord(g)
                        ty = Add(yy, 3)
                        tx = Add(DawRoute.ox, 8)
                        FB_DrawString(tx, ty, word, gold, -1)
                        yy = Add(yy, 14)
                        shown = Add(shown, 1)
                    }
                }
                row_i = Add(row_i, 1)
                cur = DawRoute.ports
                WhileLoop NotEqual(cur, 0) {
                    ing = DawRoute.InGroup(cur, g)
                    IfCondition EqualTo(ing, 1) ThenBlock: {
                        IfCondition GreaterEqual(row_i, DawRoute.scroll) ThenBlock: {
                            IfCondition LessThan(shown, DawRoute.vis) ThenBlock: {
                                DawRoute.DrawPort(cur, yy)
                                yy = Add(yy, 14)
                                shown = Add(shown, 1)
                            }
                            ElseBlock: { DawRoute.SetPRow(cur, 0) }
                        }
                        ElseBlock: { DawRoute.SetPRow(cur, 0) }
                        row_i = Add(row_i, 1)
                    }
                    cur = Dereference(Add(cur, off))
                }
            }
            g = Add(g, 1)
        }
        ReturnValue(shown)
    }
}

Function.DawRoute.DrawMap {
    Input: conn: Address
    Input: x: Integer
    Input: yy: Integer
    Output: Integer
    Body: {
        moff = PoolFieldOffset(LinkagePool.DawConn, "map")
        head = Dereference(Add(conn, moff))
        noff = PoolFieldOffset(LinkagePool.DawMap, "next")
        soff = PoolFieldOffset(LinkagePool.DawMap, "src_i")
        doff = PoolFieldOffset(LinkagePool.DawMap, "dst_i")
        dim = FB_RGB(160, 164, 150)
        cur = head
        colx = x
        WhileLoop NotEqual(cur, 0) {
            si = Dereference(Add(cur, soff))
            di = Dereference(Add(cur, doff))
            FB_DrawNumber(colx, yy, si, dim, -1)
            dash = Add(colx, 8)
            FB_DrawString(dash, yy, "-", dim, -1)
            dn = Add(colx, 16)
            FB_DrawNumber(dn, yy, di, dim, -1)
            colx = Add(colx, 32)
            cur = Dereference(Add(cur, noff))
        }
        ReturnValue(0)
    }
}

Function.DawRoute.DrawConn {
    Input: conn: Address
    Input: yy: Integer
    Output: Integer
    Body: {
        DawRoute.SetCRow(conn, yy)
        base = Add(DawRoute.ox, 304)
        fill = FB_RGB(24, 26, 32)
        IfCondition EqualTo(conn, DawRoute.sel) ThenBlock: {
            fill = FB_RGB(48, 44, 24)
        }
        wide = Subtract(DawRoute.ow, 312)
        IfCondition LessThan(wide, 40) ThenBlock: { wide = 40 }
        FB_FillRectFast(base, yy, wide, 14, fill)
        col = DawRoute.Ink(conn)
        sw = Add(base, 2)
        sy = Add(yy, 3)
        FB_FillRectFast(sw, sy, 8, 8, col)
        ink = FB_RGB(220, 220, 214)
        ty = Add(yy, 3)
        sp = DawRoute.CSrc(conn)
        dp = DawRoute.CDst(conn)
        sn = DawRoute.PName(sp)
        dn = DawRoute.PName(dp)
        IfCondition NotEqual(sn, 0) ThenBlock: {
            tx = Add(base, 14)
            FB_DrawString(tx, ty, sn, ink, -1)
        }
        mx = Add(base, 112)
        DawRoute.DrawMap(conn, mx, ty)
        kk = DawRoute.CKind(conn)
        word = DawRoute.KindWord(kk)
        kx = Add(base, 184)
        FB_DrawString(kx, ty, word, col, -1)
        IfCondition NotEqual(dn, 0) ThenBlock: {
            dx = Add(base, 248)
            FB_DrawString(dx, ty, dn, ink, -1)
        }
        IfCondition EqualTo(kk, 2) ThenBlock: {
            dx = Add(base, 360)
            FB_DrawString(dx, ty, "d", ink, -1)
            nx = Add(dx, 8)
            dl = DawRoute.CDelay(conn)
            FB_DrawNumber(nx, ty, dl, ink, -1)
        }
        lp = DawRoute.CLoop(conn)
        IfCondition NotEqual(lp, 0) ThenBlock: {
            hx = Add(base, 400)
            FB_DrawString(hx, ty, "#", col, -1)
            nx = Add(hx, 8)
            FB_DrawNumber(nx, ty, lp, col, -1)
        }
        ReturnValue(0)
    }
}

Function.DawRoute.DrawConns {
    Output: Integer
    Body: {
        off = PoolFieldOffset(LinkagePool.DawConn, "next")
        yy = Add(DawRoute.oy, 18)
        bot = Subtract(Add(DawRoute.oy, DawRoute.oh), 46)
        cur = DawRoute.conns
        WhileLoop NotEqual(cur, 0) {
            nxt = Add(yy, 14)
            IfCondition LessEqual(nxt, bot) ThenBlock: {
                DawRoute.DrawConn(cur, yy)
                yy = nxt
            }
            ElseBlock: { DawRoute.SetCRow(cur, 0) }
            cur = Dereference(Add(cur, off))
        }
        ReturnValue(0)
    }
}

Function.DawRoute.DrawCables {
    Output: Integer
    Body: {
        off = PoolFieldOffset(LinkagePool.DawConn, "next")
        cur = DawRoute.conns
        idx = 0
        WhileLoop NotEqual(cur, 0) {
            sp = DawRoute.CSrc(cur)
            dp = DawRoute.CDst(cur)
            y1 = DawRoute.PRow(sp)
            y2 = DawRoute.PRow(dp)
            IfCondition NotEqual(y1, 0) ThenBlock: {
                IfCondition NotEqual(y2, 0) ThenBlock: {
                    col = DawRoute.Ink(cur)
                    k = Modulo(idx, 8)
                    vx = Add(DawRoute.ox, Add(236, Multiply(k, 4)))
                    y1m = Add(y1, 6)
                    y2m = Add(y2, 6)
                    x0 = Add(DawRoute.ox, 224)
                    FB_Line(x0, y1m, vx, y1m, col)
                    FB_Line(vx, y1m, vx, y2m, col)
                    FB_Line(vx, y2m, x0, y2m, col)
                }
            }
            idx = Add(idx, 1)
            cur = Dereference(Add(cur, off))
        }
        ReturnValue(0)
    }
}

Function.DawRoute.DrawScroll {
    Output: Integer
    Body: {
        DawRoute.sbx = Add(DawRoute.ox, 276)
        DawRoute.sby = Add(DawRoute.oy, 18)
        DawRoute.sbh = Multiply(DawRoute.vis, 14)
        bar = FB_RGB(16, 18, 22)
        FB_FillRectFast(DawRoute.sbx, DawRoute.sby, 12, DawRoute.sbh, bar)
        maxs = Subtract(DawRoute.nrows, DawRoute.vis)
        th = 28
        IfCondition GreaterThan(th, DawRoute.sbh) ThenBlock: { th = DawRoute.sbh }
        IfCondition LessThan(th, 8) ThenBlock: { th = 8 }
        pos = 0
        IfCondition GreaterThan(maxs, 0) ThenBlock: {
            travel = Subtract(DawRoute.sbh, th)
            IfCondition LessThan(travel, 0) ThenBlock: { travel = 0 }
            pos = Divide(Multiply(DawRoute.scroll, travel), maxs)
        }
        thumb = FB_RGB(200, 180, 80)
        ty = Add(DawRoute.sby, pos)
        FB_FillRectFast(DawRoute.sbx, ty, 12, th, thumb)
        ReturnValue(0)
    }
}

Function.DawRoute.Find {
    Input: track: Address
    Input: bay: Integer
    Input: dir: Integer
    Output: Address
    Body: {
        off = PoolFieldOffset(LinkagePool.DawPort, "next")
        cur = DawRoute.ports
        WhileLoop NotEqual(cur, 0) {
            tr = DawRoute.PTrack(cur)
            IfCondition EqualTo(tr, track) ThenBlock: {
                bb = DawRoute.PBay(cur)
                IfCondition EqualTo(bb, bay) ThenBlock: {
                    dd = DawRoute.PDir(cur)
                    IfCondition EqualTo(dd, dir) ThenBlock: {
                        ReturnValue(cur)
                    }
                }
            }
            cur = Dereference(Add(cur, off))
        }
        ReturnValue(0)
    }
}

Function.DawRoute.SameConn {
    Input: src: Address
    Input: dst: Address
    Input: kind: Integer
    Output: Address
    Body: {
        off = PoolFieldOffset(LinkagePool.DawConn, "next")
        cur = DawRoute.conns
        WhileLoop NotEqual(cur, 0) {
            sp = DawRoute.CSrc(cur)
            dp = DawRoute.CDst(cur)
            kk = DawRoute.CKind(cur)
            IfCondition EqualTo(sp, src) ThenBlock: {
                IfCondition EqualTo(dp, dst) ThenBlock: {
                    IfCondition EqualTo(kk, kind) ThenBlock: {
                        ReturnValue(cur)
                    }
                }
            }
            cur = Dereference(Add(cur, off))
        }
        ReturnValue(0)
    }
}

Function.DawRoute.FindKindSrc {
    Input: port: Address
    Input: kind: Integer
    Output: Address
    Body: {
        off = PoolFieldOffset(LinkagePool.DawConn, "next")
        cur = DawRoute.conns
        WhileLoop NotEqual(cur, 0) {
            sp = DawRoute.CSrc(cur)
            kk = DawRoute.CKind(cur)
            IfCondition EqualTo(sp, port) ThenBlock: {
                IfCondition EqualTo(kk, kind) ThenBlock: {
                    ReturnValue(cur)
                }
            }
            cur = Dereference(Add(cur, off))
        }
        ReturnValue(0)
    }
}

Function.DawRoute.CordOn {
    Input: port: Address
    Output: Address
    Body: {
        off = PoolFieldOffset(LinkagePool.DawConn, "next")
        cur = DawRoute.conns
        WhileLoop NotEqual(cur, 0) {
            sp = DawRoute.CSrc(cur)
            dp = DawRoute.CDst(cur)
            IfCondition EqualTo(sp, port) ThenBlock: { ReturnValue(cur) }
            IfCondition EqualTo(dp, port) ThenBlock: { ReturnValue(cur) }
            cur = Dereference(Add(cur, off))
        }
        ReturnValue(0)
    }
}

Function.DawRoute.Wire {
    Input: src: Address
    Input: dst: Address
    Input: kind: Integer
    Input: lp: Integer
    Output: Address
    Body: {
        cable = DawRoute.Connect(src, dst, kind)
        IfCondition EqualTo(cable, 0) ThenBlock: { ReturnValue(0) }
        DawRoute.Map(cable, 0, 0)
        DawRoute.Map(cable, 1, 1)
        DawRoute.SetLoop(cable, lp)
        ReturnValue(cable)
    }
}

Function.DawRoute.IndexCols {
    Output: Integer
    Body: {
        off = PoolFieldOffset(LinkagePool.DawPort, "next")
        cur = DawRoute.ports
        n = 0
        WhileLoop NotEqual(cur, 0) {
            bb = DawRoute.PBay(cur)
            dd = DawRoute.PDir(cur)
            IfCondition EqualTo(bb, 1) ThenBlock: {
                IfCondition EqualTo(dd, 1) ThenBlock: {
                    DawRoute.SetCol(cur, n)
                    n = Add(n, 1)
                }
                ElseBlock: { DawRoute.SetCol(cur, -1) }
            }
            ElseBlock: { DawRoute.SetCol(cur, -1) }
            cur = Dereference(Add(cur, off))
        }
        cur = DawRoute.ports
        WhileLoop NotEqual(cur, 0) {
            col = DawRoute.PCol(cur)
            IfCondition LessThan(col, 0) ThenBlock: {
                tr = DawRoute.PTrack(cur)
                IfCondition NotEqual(tr, 0) ThenBlock: {
                    hit = DawRoute.Find(tr, 1, 1)
                    IfCondition NotEqual(hit, 0) ThenBlock: {
                        got = DawRoute.PCol(hit)
                        DawRoute.SetCol(cur, got)
                    }
                }
            }
            cur = Dereference(Add(cur, off))
        }
        DawRoute.nrows = n
        ReturnValue(n)
    }
}

Function.DawRoute.Layout {
    Output: Integer
    Body: {
        DawRoute.lane = Add(DawRoute.ox, 78)
        DawRoute.pinx = Subtract(Add(DawRoute.ox, DawRoute.ow), 56)
        space = Subtract(DawRoute.oh, 56)
        IfCondition LessThan(space, 216) ThenBlock: { space = 216 }
        DawRoute.rh = Divide(space, 6)
        IfCondition LessThan(DawRoute.rh, 36) ThenBlock: { DawRoute.rh = 36 }
        visw = Subtract(DawRoute.ow, 142)
        DawRoute.pitch = 56
        IfCondition LessThan(visw, DawRoute.pitch) ThenBlock: { visw = DawRoute.pitch }
        DawRoute.barw = visw
        DawRoute.vis = Divide(visw, DawRoute.pitch)
        IfCondition LessThan(DawRoute.vis, 1) ThenBlock: { DawRoute.vis = 1 }
        DawRoute.IndexCols()
        DawRoute.ClampScroll()
        ReturnValue(0)
    }
}

Function.DawRoute.Join {
    Input: dst: Address
    Output: Integer
    Body: {
        src = DawRoute.src
        IfCondition EqualTo(src, 0) ThenBlock: {
            DawRoute.why = 4
            DawRoute.arm = 0
            ReturnValue(0)
        }
        IfCondition EqualTo(dst, 0) ThenBlock: {
            DawRoute.why = 4
            DawRoute.arm = 0
            ReturnValue(0)
        }
        sb = DawRoute.PBay(src)
        db = DawRoute.PBay(dst)
        sd = DawRoute.PDir(src)
        dd = DawRoute.PDir(dst)
        IfCondition EqualTo(sb, 1) ThenBlock: {
            IfCondition EqualTo(sd, 1) ThenBlock: {
                loopbay = 0
                IfCondition EqualTo(db, 2) ThenBlock: { loopbay = 2 }
                IfCondition EqualTo(db, 3) ThenBlock: { loopbay = 3 }
                IfCondition NotEqual(loopbay, 0) ThenBlock: {
                    tr = DawRoute.PTrack(dst)
                    sendp = DawRoute.Find(tr, loopbay, 1)
                    retp = DawRoute.Find(tr, loopbay, 0)
                    mstp = DawRoute.Find(tr, 4, 0)
                    IfCondition EqualTo(sendp, 0) ThenBlock: {
                        DawRoute.why = 4
                        DawRoute.arm = 0
                        DawRoute.src = 0
                        ReturnValue(0)
                    }
                    IfCondition EqualTo(retp, 0) ThenBlock: {
                        DawRoute.why = 4
                        DawRoute.arm = 0
                        DawRoute.src = 0
                        ReturnValue(0)
                    }
                    IfCondition EqualTo(mstp, 0) ThenBlock: {
                        DawRoute.why = 4
                        DawRoute.arm = 0
                        DawRoute.src = 0
                        ReturnValue(0)
                    }
                    got = DawRoute.SameConn(src, sendp, 1)
                    IfCondition EqualTo(got, 0) ThenBlock: {
                        top = DawRoute.MaxLoop()
                        lp = Add(top, 1)
                        cable = DawRoute.Wire(src, sendp, 1, lp)
                        back = DawRoute.Wire(retp, mstp, 2, lp)
                        DawRoute.sel = back
                        ta = DawRoute.PTrack(src)
                        IfCondition EqualTo(ta, tr) ThenBlock: {
                            dry = DawRoute.SameConn(src, mstp, 0)
                            IfCondition NotEqual(dry, 0) ThenBlock: {
                                DawRoute.Unlink(dry)
                            }
                        }
                    }
                    ElseBlock: {
                        DawRoute.sel = DawRoute.FindKindSrc(retp, 2)
                        IfCondition EqualTo(DawRoute.sel, 0) ThenBlock: { DawRoute.sel = got }
                    }
                    DawRoute.why = 0
                    DawRoute.arm = 0
                    DawRoute.src = 0
                    DawRoute.gkind = -1
                    DawRoute.menu = 0
                    ReturnValue(1)
                }
                IfCondition EqualTo(db, 4) ThenBlock: {
                    IfCondition EqualTo(dd, 0) ThenBlock: {
                        got = DawRoute.SameConn(src, dst, 0)
                        IfCondition EqualTo(got, 0) ThenBlock: {
                            cable = DawRoute.Wire(src, dst, 0, 0)
                            DawRoute.sel = cable
                        }
                        ElseBlock: { DawRoute.sel = got }
                        DawRoute.why = 0
                        DawRoute.arm = 0
                        DawRoute.src = 0
                        DawRoute.gkind = -1
                        ReturnValue(1)
                    }
                }
            }
        }
        IfCondition EqualTo(sd, 0) ThenBlock: {
            retbay = 0
            IfCondition EqualTo(sb, 2) ThenBlock: { retbay = 1 }
            IfCondition EqualTo(sb, 3) ThenBlock: { retbay = 1 }
            IfCondition EqualTo(sb, 0) ThenBlock: { retbay = 1 }
            land = 0
            IfCondition EqualTo(db, 4) ThenBlock: {
                IfCondition EqualTo(dd, 0) ThenBlock: { land = 1 }
            }
            IfCondition EqualTo(db, 1) ThenBlock: {
                IfCondition EqualTo(dd, 0) ThenBlock: { land = 1 }
            }
            IfCondition EqualTo(retbay, 1) ThenBlock: {
                IfCondition EqualTo(land, 1) ThenBlock: {
                    old = DawRoute.FindKindSrc(src, 2)
                    lp = 0
                    IfCondition NotEqual(old, 0) ThenBlock: {
                        lp = DawRoute.CLoop(old)
                        DawRoute.Unlink(old)
                    }
                    cable = DawRoute.Wire(src, dst, 2, lp)
                    DawRoute.sel = cable
                    DawRoute.why = 0
                    DawRoute.arm = 0
                    DawRoute.src = 0
                    DawRoute.gkind = -1
                    ReturnValue(1)
                }
            }
        }
        IfCondition EqualTo(db, 5) ThenBlock: {
            IfCondition EqualTo(src, DawRoute.mst_out) ThenBlock: {
                got = DawRoute.SameConn(src, dst, 0)
                IfCondition EqualTo(got, 0) ThenBlock: {
                    cable = DawRoute.Wire(src, dst, 0, 0)
                    DawRoute.sel = cable
                }
                ElseBlock: { DawRoute.sel = got }
                DawRoute.why = 0
                DawRoute.arm = 0
                DawRoute.src = 0
                ReturnValue(1)
            }
            IfCondition EqualTo(sd, 1) ThenBlock: {
                so = DawRoute.POwner(src)
                ok = 0
                IfCondition EqualTo(so, 1) ThenBlock: { ok = 1 }
                IfCondition EqualTo(so, 2) ThenBlock: { ok = 1 }
                IfCondition EqualTo(so, 3) ThenBlock: { ok = 1 }
                IfCondition EqualTo(ok, 1) ThenBlock: {
                    got = DawRoute.SameConn(src, dst, 1)
                    IfCondition EqualTo(got, 0) ThenBlock: {
                        top = DawRoute.MaxLoop()
                        lp = Add(top, 1)
                        cable = DawRoute.Wire(src, dst, 1, lp)
                        DawRoute.sel = cable
                    }
                    ElseBlock: { DawRoute.sel = got }
                    DawRoute.why = 0
                    DawRoute.arm = 0
                    DawRoute.src = 0
                    ReturnValue(1)
                }
            }
        }
        DawRoute.why = 2
        DawRoute.arm = 0
        DawRoute.src = 0
        ReturnValue(0)
    }
}

Function.DawRoute.RowY {
    Input: tier: Integer
    Output: Integer
    Body: {
        y = Add(DawRoute.oy, 6)
        step = Multiply(tier, DawRoute.rh)
        ReturnValue(Add(y, step))
    }
}

Function.DawRoute.BayWord {
    Input: tier: Integer
    Output: Address
    Body: {
        IfCondition EqualTo(tier, 0) ThenBlock: { ReturnValue("Inputs") }
        IfCondition EqualTo(tier, 1) ThenBlock: { ReturnValue("Mixer") }
        IfCondition EqualTo(tier, 2) ThenBlock: { ReturnValue("Effects") }
        IfCondition EqualTo(tier, 3) ThenBlock: { ReturnValue("Side") }
        IfCondition EqualTo(tier, 4) ThenBlock: { ReturnValue("Master") }
        ReturnValue("Outputs")
    }
}

Function.DawRoute.Touches {
    Input: port: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(DawRoute.sel, 0) ThenBlock: { ReturnValue(0) }
        sp = DawRoute.CSrc(DawRoute.sel)
        dp = DawRoute.CDst(DawRoute.sel)
        IfCondition EqualTo(sp, port) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(dp, port) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

Function.DawRoute.DrawJack {
    Input: port: Address
    Input: xx: Integer
    Input: yy: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(port, 0) ThenBlock: { ReturnValue(0) }
        bay = DawRoute.PBay(port)
        dir = DawRoute.PDir(port)
        fill = FB_RGB(36, 40, 48)
        edge = FB_RGB(150, 154, 146)
        IfCondition EqualTo(bay, 0) ThenBlock: { fill = FB_RGB(50, 90, 110) }
        IfCondition EqualTo(bay, 1) ThenBlock: { fill = FB_RGB(50, 80, 100) }
        IfCondition EqualTo(bay, 2) ThenBlock: { fill = FB_RGB(120, 90, 40) }
        IfCondition EqualTo(bay, 3) ThenBlock: { fill = FB_RGB(110, 60, 90) }
        IfCondition EqualTo(bay, 4) ThenBlock: { fill = FB_RGB(120, 100, 40) }
        IfCondition EqualTo(bay, 5) ThenBlock: { fill = FB_RGB(40, 100, 70) }
        hollow = 0
        IfCondition EqualTo(dir, 0) ThenBlock: {
            IfCondition EqualTo(bay, 2) ThenBlock: { hollow = 1 }
            IfCondition EqualTo(bay, 3) ThenBlock: { hollow = 1 }
        }
        IfCondition EqualTo(hollow, 1) ThenBlock: { fill = FB_RGB(18, 20, 24) }
        IfCondition EqualTo(port, DawRoute.src) ThenBlock: { edge = FB_RGB(200, 180, 80) }
        hot = DawRoute.Touches(port)
        IfCondition EqualTo(hot, 1) ThenBlock: {
            edge = DawRoute.Ink(DawRoute.sel)
        }
        FB_FillRectFast(xx, yy, 12, 12, fill)
        FB_Rect(xx, yy, 12, 12, edge)
        DawRoute.SetPRow(port, yy)
        DawRoute.SetJX(port, xx)
        ReturnValue(0)
    }
}

Function.DawRoute.BayLabels {
    Output: Integer
    Body: {
        ink = FB_RGB(200, 180, 80)
        dim = FB_RGB(140, 144, 136)
        rule = FB_RGB(32, 36, 42)
        i = 0
        WhileLoop LessThan(i, 6) {
            yy = DawRoute.RowY(i)
            FB_FillRectFast(DawRoute.ox, yy, DawRoute.ow, 1, rule)
            word = DawRoute.BayWord(i)
            ty = Add(yy, 8)
            tx = Add(DawRoute.ox, 6)
            FB_DrawString(tx, ty, word, ink, -1)
            IfCondition EqualTo(i, 2) ThenBlock: {
                sy = Add(yy, 20)
                FB_DrawString(tx, sy, "S R", dim, -1)
            }
            IfCondition EqualTo(i, 3) ThenBlock: {
                sy = Add(yy, 20)
                FB_DrawString(tx, sy, "S R", dim, -1)
            }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

Function.DawRoute.BayCols {
    Output: Integer
    Body: {
        off = PoolFieldOffset(LinkagePool.DawPort, "next")
        ink = FB_RGB(220, 220, 214)
        cur = DawRoute.ports
        WhileLoop NotEqual(cur, 0) {
            col = DawRoute.PCol(cur)
            bay = DawRoute.PBay(cur)
            dir = DawRoute.PDir(cur)
            show = 0
            IfCondition GreaterEqual(col, DawRoute.scroll) ThenBlock: {
                last = Add(DawRoute.scroll, DawRoute.vis)
                IfCondition LessThan(col, last) ThenBlock: { show = 1 }
            }
            IfCondition EqualTo(show, 1) ThenBlock: {
                rel = Subtract(col, DawRoute.scroll)
                x = Add(DawRoute.lane, Multiply(rel, DawRoute.pitch))
                yy = DawRoute.RowY(bay)
                jy = Add(yy, 18)
                IfCondition EqualTo(bay, 1) ThenBlock: {
                    IfCondition EqualTo(dir, 1) ThenBlock: {
                        DawRoute.DrawJack(cur, Add(x, 2), jy)
                        tr = DawRoute.PTrack(cur)
                        IfCondition NotEqual(tr, 0) ThenBlock: {
                            n_at = PoolFieldOffset(LinkagePool.DawTrack, "name")
                            nm = Dereference(Add(tr, n_at))
                            IfCondition NotEqual(nm, 0) ThenBlock: {
                                FB_DrawString(x, Add(yy, 4), nm, ink, -1)
                            }
                        }
                    }
                    IfCondition EqualTo(dir, 0) ThenBlock: {
                        DawRoute.DrawJack(cur, Add(x, 22), jy)
                    }
                }
                IfCondition EqualTo(bay, 2) ThenBlock: {
                    IfCondition EqualTo(dir, 1) ThenBlock: {
                        DawRoute.DrawJack(cur, Add(x, 2), jy)
                    }
                    IfCondition EqualTo(dir, 0) ThenBlock: {
                        DawRoute.DrawJack(cur, Add(x, 22), jy)
                    }
                }
                IfCondition EqualTo(bay, 3) ThenBlock: {
                    IfCondition EqualTo(dir, 1) ThenBlock: {
                        DawRoute.DrawJack(cur, Add(x, 2), jy)
                    }
                    IfCondition EqualTo(dir, 0) ThenBlock: {
                        DawRoute.DrawJack(cur, Add(x, 22), jy)
                    }
                }
                IfCondition EqualTo(bay, 4) ThenBlock: {
                    IfCondition EqualTo(dir, 0) ThenBlock: {
                        DawRoute.DrawJack(cur, Add(x, 12), jy)
                    }
                }
            }
            ElseBlock: {
                IfCondition GreaterEqual(col, 0) ThenBlock: {
                    DawRoute.SetPRow(cur, 0)
                    DawRoute.SetJX(cur, 0)
                }
            }
            cur = Dereference(Add(cur, off))
        }
        ReturnValue(0)
    }
}

Function.DawRoute.TextW {
    Input: text: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(text, 0) ThenBlock: { ReturnValue(0) }
        len = 0
        go = 1
        WhileLoop EqualTo(go, 1) {
            IfCondition GreaterEqual(len, 48) ThenBlock: { go = 0 }
            ElseBlock: {
                ch = GetByte(text, len)
                IfCondition EqualTo(ch, 0) ThenBlock: { go = 0 }
                ElseBlock: { len = Add(len, 1) }
            }
        }
        ReturnValue(Multiply(len, 8))
    }
}

Function.DawRoute.DrawCaps {
    Input: yy: Integer
    Output: Integer
    Body: {
        ink = FB_RGB(220, 220, 214)
        x = DawRoute.lane
        limit = Subtract(Add(DawRoute.ox, DawRoute.ow), 8)
        off = PoolFieldOffset(LinkagePool.DawPort, "next")
        cur = DawRoute.ports
        WhileLoop NotEqual(cur, 0) {
            bb = DawRoute.PBay(cur)
            dd = DawRoute.PDir(cur)
            IfCondition EqualTo(bb, 0) ThenBlock: {
                IfCondition EqualTo(dd, 0) ThenBlock: {
                    lab = DawRoute.PLabel(cur)
                    tw = DawRoute.TextW(lab)
                    need = Add(Add(16, tw), 14)
                    room = Subtract(limit, x)
                    IfCondition LessThan(need, room) ThenBlock: {
                        DawRoute.DrawJack(cur, x, yy)
                        IfCondition NotEqual(lab, 0) ThenBlock: {
                            tx = Add(x, 16)
                            ty = Add(yy, 2)
                            FB_DrawString(tx, ty, lab, ink, -1)
                        }
                        x = Add(x, need)
                    }
                }
            }
            cur = Dereference(Add(cur, off))
        }
        ReturnValue(x)
    }
}

Function.DawRoute.DrawPlays {
    Input: yy: Integer
    Output: Integer
    Body: {
        ink = FB_RGB(220, 220, 214)
        jx = Add(DawRoute.pinx, 16)
        DawRoute.DrawJack(DawRoute.hw_out, jx, yy)
        lab = DawRoute.PLabel(DawRoute.hw_out)
        tw = DawRoute.TextW(lab)
        lx = Subtract(jx, Add(tw, 8))
        IfCondition LessThan(lx, DawRoute.lane) ThenBlock: { lx = DawRoute.lane }
        IfCondition NotEqual(lab, 0) ThenBlock: {
            ty = Add(yy, 2)
            FB_DrawString(lx, ty, lab, ink, -1)
        }
        stop = Subtract(lx, 12)
        x = DawRoute.lane
        off = PoolFieldOffset(LinkagePool.DawPort, "next")
        cur = DawRoute.ports
        WhileLoop NotEqual(cur, 0) {
            bb = DawRoute.PBay(cur)
            dd = DawRoute.PDir(cur)
            IfCondition EqualTo(bb, 5) ThenBlock: {
                IfCondition EqualTo(dd, 1) ThenBlock: {
                    IfCondition NotEqual(cur, DawRoute.hw_out) ThenBlock: {
                        lab2 = DawRoute.PLabel(cur)
                        tw2 = DawRoute.TextW(lab2)
                        need = Add(Add(16, tw2), 14)
                        endx = Add(x, need)
                        IfCondition LessThan(endx, stop) ThenBlock: {
                            DawRoute.DrawJack(cur, x, yy)
                            IfCondition NotEqual(lab2, 0) ThenBlock: {
                                tx = Add(x, 16)
                                ty2 = Add(yy, 2)
                                FB_DrawString(tx, ty2, lab2, ink, -1)
                            }
                            x = endx
                        }
                    }
                }
            }
            cur = Dereference(Add(cur, off))
        }
        ReturnValue(x)
    }
}

Function.DawRoute.BayPins {
    Output: Integer
    Body: {
        y0 = DawRoute.RowY(0)
        DawRoute.DrawCaps(Add(y0, 18))
        y4 = DawRoute.RowY(4)
        DawRoute.DrawJack(DawRoute.mst_out, Add(DawRoute.pinx, 16), Add(y4, 18))
        y5 = DawRoute.RowY(5)
        DawRoute.DrawPlays(Add(y5, 18))
        ReturnValue(0)
    }
}

Function.DawRoute.Arrow {
    Input: xx: Integer
    Input: yy: Integer
    Input: dir: Integer
    Input: col: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(dir, 0) ThenBlock: {
            xL = Subtract(xx, 4)
            xR = Add(xx, 4)
            yb = Subtract(yy, 6)
            FB_Line(xx, yy, xL, yb, col)
            FB_Line(xx, yy, xR, yb, col)
        }
        ElseBlock: {
            xL = Subtract(xx, 4)
            xR = Add(xx, 4)
            yb = Add(yy, 6)
            FB_Line(xx, yy, xL, yb, col)
            FB_Line(xx, yy, xR, yb, col)
        }
        ReturnValue(0)
    }
}

Function.DawRoute.Ends {
    Input: conn: Address
    Output: Integer
    Body: {
        sp = DawRoute.CSrc(conn)
        dp = DawRoute.CDst(conn)
        yA = DawRoute.PRow(sp)
        xA = DawRoute.PJX(sp)
        yB = DawRoute.PRow(dp)
        xB = DawRoute.PJX(dp)
        IfCondition EqualTo(yA, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(xA, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(yB, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(xB, 0) ThenBlock: { ReturnValue(0) }
        DawRoute.x1 = Add(xA, 6)
        DawRoute.y1 = Add(yA, 6)
        DawRoute.x2 = Add(xB, 6)
        DawRoute.y2 = yB
        lp = DawRoute.CLoop(conn)
        gap = Multiply(Modulo(lp, 5), 3)
        mid = Divide(Add(DawRoute.y1, DawRoute.y2), 2)
        IfCondition LessThan(DawRoute.y1, DawRoute.y2) ThenBlock: {
            mid = Subtract(mid, gap)
        }
        ElseBlock: { mid = Add(mid, gap) }
        DawRoute.mid = mid
        cs = DawRoute.PCol(sp)
        cd = DawRoute.PCol(dp)
        DawRoute.jog = 1
        IfCondition GreaterEqual(cs, 0) ThenBlock: {
            IfCondition GreaterEqual(cd, 0) ThenBlock: {
                edge = Subtract(DawRoute.pitch, 8)
                gs = Add(DawRoute.lane, Multiply(Subtract(cs, DawRoute.scroll), DawRoute.pitch))
                gd = Add(DawRoute.lane, Multiply(Subtract(cd, DawRoute.scroll), DawRoute.pitch))
                DawRoute.gx1 = Add(gs, edge)
                DawRoute.gx2 = Add(gd, edge)
                DawRoute.jog = 2
            }
        }
        IfCondition EqualTo(DawRoute.x1, DawRoute.x2) ThenBlock: {
            IfCondition NotEqual(DawRoute.jog, 2) ThenBlock: { DawRoute.jog = 0 }
        }
        ReturnValue(1)
    }
}

Function.DawRoute.PaintCord {
    Input: col: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(DawRoute.jog, 0) ThenBlock: {
            FB_Line(DawRoute.x1, DawRoute.y1, DawRoute.x2, DawRoute.y2, col)
        }
        IfCondition EqualTo(DawRoute.jog, 1) ThenBlock: {
            FB_Line(DawRoute.x1, DawRoute.y1, DawRoute.x1, DawRoute.mid, col)
            FB_Line(DawRoute.x1, DawRoute.mid, DawRoute.x2, DawRoute.mid, col)
            FB_Line(DawRoute.x2, DawRoute.mid, DawRoute.x2, DawRoute.y2, col)
        }
        IfCondition EqualTo(DawRoute.jog, 2) ThenBlock: {
            FB_Line(DawRoute.x1, DawRoute.y1, DawRoute.gx1, DawRoute.y1, col)
            FB_Line(DawRoute.gx1, DawRoute.y1, DawRoute.gx1, DawRoute.mid, col)
            FB_Line(DawRoute.gx1, DawRoute.mid, DawRoute.gx2, DawRoute.mid, col)
            FB_Line(DawRoute.gx2, DawRoute.mid, DawRoute.gx2, DawRoute.y2, col)
            FB_Line(DawRoute.gx2, DawRoute.y2, DawRoute.x2, DawRoute.y2, col)
        }
        dir = 0
        IfCondition LessThan(DawRoute.y2, DawRoute.mid) ThenBlock: { dir = 1 }
        IfCondition EqualTo(DawRoute.jog, 0) ThenBlock: {
            IfCondition LessThan(DawRoute.y2, DawRoute.y1) ThenBlock: { dir = 1 }
        }
        DawRoute.Arrow(DawRoute.x2, DawRoute.y2, dir, col)
        ReturnValue(0)
    }
}

Function.DawRoute.BayCords {
    Output: Integer
    Body: {
        off = PoolFieldOffset(LinkagePool.DawConn, "next")
        cur = DawRoute.conns
        WhileLoop NotEqual(cur, 0) {
            ok = DawRoute.Ends(cur)
            IfCondition EqualTo(ok, 1) ThenBlock: {
                col = DawRoute.Ink(cur)
                DawRoute.PaintCord(col)
            }
            cur = Dereference(Add(cur, off))
        }
        ReturnValue(0)
    }
}

Function.DawRoute.BayRubber {
    Output: Integer
    Body: {
        IfCondition NotEqual(DawRoute.arm, 1) ThenBlock: { ReturnValue(0) }
        yy = DawRoute.PRow(DawRoute.src)
        xx = DawRoute.PJX(DawRoute.src)
        IfCondition EqualTo(yy, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(xx, 0) ThenBlock: { ReturnValue(0) }
        DawRoute.x1 = Add(xx, 6)
        DawRoute.y1 = Add(yy, 6)
        DawRoute.x2 = DawRoute.ax
        DawRoute.y2 = DawRoute.ay
        DawRoute.mid = Divide(Add(DawRoute.y1, DawRoute.y2), 2)
        DawRoute.jog = 1
        IfCondition EqualTo(DawRoute.x1, DawRoute.x2) ThenBlock: { DawRoute.jog = 0 }
        col = FB_RGB(236, 232, 210)
        DawRoute.PaintCord(col)
        ReturnValue(0)
    }
}

Function.DawRoute.ThumbW {
    Output: Integer
    Body: {
        IfCondition LessThan(DawRoute.nrows, 1) ThenBlock: { ReturnValue(DawRoute.barw) }
        tw = Divide(Multiply(DawRoute.vis, DawRoute.barw), DawRoute.nrows)
        IfCondition LessThan(tw, 12) ThenBlock: { tw = 12 }
        IfCondition GreaterThan(tw, DawRoute.barw) ThenBlock: { tw = DawRoute.barw }
        ReturnValue(tw)
    }
}

Function.DawRoute.ThumbX {
    Output: Integer
    Body: {
        tw = DawRoute.ThumbW()
        maxs = Subtract(DawRoute.nrows, DawRoute.vis)
        IfCondition LessThan(maxs, 1) ThenBlock: { ReturnValue(DawRoute.sbx) }
        span = Subtract(DawRoute.barw, tw)
        IfCondition LessThan(span, 0) ThenBlock: { span = 0 }
        tx = Divide(Multiply(DawRoute.scroll, span), maxs)
        ReturnValue(Add(DawRoute.sbx, tx))
    }
}

Function.DawRoute.BayScroll {
    Output: Integer
    Body: {
        DawRoute.sbx = DawRoute.lane
        DawRoute.sby = Subtract(Add(DawRoute.oy, DawRoute.oh), 52)
        DawRoute.sbh = 12
        IfCondition LessEqual(DawRoute.nrows, DawRoute.vis) ThenBlock: {
            DawRoute.barw = 0
            ReturnValue(0)
        }
        track = FB_RGB(32, 34, 38)
        thumb = FB_RGB(200, 180, 80)
        FB_FillRectFast(DawRoute.sbx, DawRoute.sby, DawRoute.barw, DawRoute.sbh, track)
        tw = DawRoute.ThumbW()
        tx = DawRoute.ThumbX()
        FB_FillRectFast(tx, DawRoute.sby, tw, DawRoute.sbh, thumb)
        ReturnValue(0)
    }
}

Function.DawRoute.InBar {
    Input: px: Integer
    Input: py: Integer
    Output: Integer
    Body: {
        IfCondition LessEqual(DawRoute.barw, 0) ThenBlock: { ReturnValue(0) }
        top = Subtract(DawRoute.sby, 6)
        bot = Add(Add(DawRoute.sby, DawRoute.sbh), 2)
        IfCondition LessThan(py, top) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterEqual(py, bot) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(px, DawRoute.sbx) ThenBlock: { ReturnValue(0) }
        endx = Add(DawRoute.sbx, DawRoute.barw)
        IfCondition GreaterEqual(px, endx) ThenBlock: { ReturnValue(0) }
        ReturnValue(1)
    }
}

Function.DawRoute.DragScroll {
    Input: px: Integer
    Output: Integer
    Body: {
        tw = DawRoute.ThumbW()
        span = Subtract(DawRoute.barw, tw)
        IfCondition LessThan(span, 1) ThenBlock: { ReturnValue(0) }
        rel = Subtract(px, DawRoute.sbx)
        rel = Subtract(rel, DawRoute.sgrab)
        IfCondition LessThan(rel, 0) ThenBlock: { rel = 0 }
        IfCondition GreaterThan(rel, span) ThenBlock: { rel = span }
        maxs = Subtract(DawRoute.nrows, DawRoute.vis)
        IfCondition LessThan(maxs, 1) ThenBlock: {
            DawRoute.scroll = 0
            ReturnValue(0)
        }
        DawRoute.scroll = Divide(Multiply(rel, maxs), span)
        DawRoute.ClampScroll()
        ReturnValue(DawRoute.scroll)
    }
}

Function.DawRoute.Abs {
    Input: v: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(v, 0) ThenBlock: { ReturnValue(Subtract(0, v)) }
        ReturnValue(v)
    }
}

Function.DawRoute.NearV {
    Input: px: Integer
    Input: py: Integer
    Input: xx: Integer
    Input: y0: Integer
    Input: y1: Integer
    Output: Integer
    Body: {
        dx = DawRoute.Abs(Subtract(px, xx))
        IfCondition GreaterThan(dx, 5) ThenBlock: { ReturnValue(0) }
        lo = y0
        hi = y1
        IfCondition GreaterThan(lo, hi) ThenBlock: {
            lo = y1
            hi = y0
        }
        lo = Subtract(lo, 4)
        hi = Add(hi, 4)
        IfCondition LessThan(py, lo) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterThan(py, hi) ThenBlock: { ReturnValue(0) }
        ReturnValue(1)
    }
}

Function.DawRoute.NearH {
    Input: px: Integer
    Input: py: Integer
    Input: yy: Integer
    Input: x0: Integer
    Input: x1: Integer
    Output: Integer
    Body: {
        dy = DawRoute.Abs(Subtract(py, yy))
        IfCondition GreaterThan(dy, 5) ThenBlock: { ReturnValue(0) }
        lo = x0
        hi = x1
        IfCondition GreaterThan(lo, hi) ThenBlock: {
            lo = x1
            hi = x0
        }
        lo = Subtract(lo, 4)
        hi = Add(hi, 4)
        IfCondition LessThan(px, lo) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterThan(px, hi) ThenBlock: { ReturnValue(0) }
        ReturnValue(1)
    }
}

Function.DawRoute.CordAt {
    Input: px: Integer
    Input: py: Integer
    Output: Address
    Body: {
        off = PoolFieldOffset(LinkagePool.DawConn, "next")
        cur = DawRoute.conns
        WhileLoop NotEqual(cur, 0) {
            ok = DawRoute.Ends(cur)
            IfCondition EqualTo(ok, 1) ThenBlock: {
                hit = 0
                IfCondition EqualTo(DawRoute.jog, 0) ThenBlock: {
                    hit = DawRoute.NearV(px, py, DawRoute.x1, DawRoute.y1, DawRoute.y2)
                }
                IfCondition EqualTo(DawRoute.jog, 1) ThenBlock: {
                    hit = DawRoute.NearV(px, py, DawRoute.x1, DawRoute.y1, DawRoute.mid)
                    IfCondition EqualTo(hit, 0) ThenBlock: {
                        hit = DawRoute.NearH(px, py, DawRoute.mid, DawRoute.x1, DawRoute.x2)
                    }
                    IfCondition EqualTo(hit, 0) ThenBlock: {
                        hit = DawRoute.NearV(px, py, DawRoute.x2, DawRoute.mid, DawRoute.y2)
                    }
                }
                IfCondition EqualTo(DawRoute.jog, 2) ThenBlock: {
                    hit = DawRoute.NearH(px, py, DawRoute.y1, DawRoute.x1, DawRoute.gx1)
                    IfCondition EqualTo(hit, 0) ThenBlock: {
                        hit = DawRoute.NearV(px, py, DawRoute.gx1, DawRoute.y1, DawRoute.mid)
                    }
                    IfCondition EqualTo(hit, 0) ThenBlock: {
                        hit = DawRoute.NearH(px, py, DawRoute.mid, DawRoute.gx1, DawRoute.gx2)
                    }
                    IfCondition EqualTo(hit, 0) ThenBlock: {
                        hit = DawRoute.NearV(px, py, DawRoute.gx2, DawRoute.mid, DawRoute.y2)
                    }
                    IfCondition EqualTo(hit, 0) ThenBlock: {
                        hit = DawRoute.NearH(px, py, DawRoute.y2, DawRoute.gx2, DawRoute.x2)
                    }
                }
                IfCondition EqualTo(hit, 1) ThenBlock: { ReturnValue(cur) }
            }
            cur = Dereference(Add(cur, off))
        }
        ReturnValue(0)
    }
}

Function.DawRoute.JackAt {
    Input: px: Integer
    Input: py: Integer
    Output: Address
    Body: {
        off = PoolFieldOffset(LinkagePool.DawPort, "next")
        cur = DawRoute.ports
        WhileLoop NotEqual(cur, 0) {
            xx = DawRoute.PJX(cur)
            yy = DawRoute.PRow(cur)
            IfCondition NotEqual(xx, 0) ThenBlock: {
                IfCondition NotEqual(yy, 0) ThenBlock: {
                    IfCondition GreaterEqual(px, xx) ThenBlock: {
                        IfCondition LessThan(px, Add(xx, 12)) ThenBlock: {
                            IfCondition GreaterEqual(py, yy) ThenBlock: {
                                IfCondition LessThan(py, Add(yy, 12)) ThenBlock: {
                                    ReturnValue(cur)
                                }
                            }
                        }
                    }
                }
            }
            cur = Dereference(Add(cur, off))
        }
        ReturnValue(0)
    }
}

Function.DawRoute.Move {
    Input: px: Integer
    Input: py: Integer
    Output: Integer
    Body: {
        DawRoute.ax = px
        DawRoute.ay = py
        ReturnValue(1)
    }
}

Function.DawRoute.Release {
    Input: px: Integer
    Input: py: Integer
    Output: Integer
    Body: {
        IfCondition NotEqual(DawRoute.arm, 1) ThenBlock: { ReturnValue(0) }
        port = DawRoute.JackAt(px, py)
        dx = DawRoute.Abs(Subtract(px, DawRoute.x0))
        dy = DawRoute.Abs(Subtract(py, DawRoute.y0))
        far = Add(dx, dy)
        IfCondition NotEqual(port, 0) ThenBlock: {
            IfCondition NotEqual(port, DawRoute.src) ThenBlock: {
                IfCondition GreaterThan(far, 3) ThenBlock: {
                    DawRoute.Join(port)
                    ReturnValue(1)
                }
            }
        }
        IfCondition NotEqual(port, 0) ThenBlock: {
            wire = DawRoute.CordOn(port)
            IfCondition NotEqual(wire, 0) ThenBlock: { DawRoute.sel = wire }
        }
        DawRoute.arm = 0
        DawRoute.src = 0
        ReturnValue(1)
    }
}

Function.DawRoute.BarHit {
    Input: px: Integer
    Input: py: Integer
    Output: Integer
    Body: {
        by = Subtract(Add(DawRoute.oy, DawRoute.oh), 20)
        IfCondition LessThan(py, by) ThenBlock: { ReturnValue(-1) }
        IfCondition GreaterEqual(py, Add(by, 16)) ThenBlock: { ReturnValue(-1) }
        x0 = Add(DawRoute.ox, 8)
        IfCondition GreaterEqual(px, x0) ThenBlock: {
            IfCondition LessThan(px, Add(x0, 72)) ThenBlock: { ReturnValue(4) }
        }
        ReturnValue(-1)
    }
}

Function.DawRoute.DrawStatus {
    Output: Integer
    Body: {
        ty = Subtract(Add(DawRoute.oy, DawRoute.oh), 36)
        tx = Add(DawRoute.ox, 8)
        ink = FB_RGB(200, 180, 80)
        lab = "Drag one jack onto another."
        IfCondition EqualTo(DawRoute.why, 1) ThenBlock: {
            lab = "not a return"
            ink = FB_RGB(220, 180, 120)
        }
        IfCondition EqualTo(DawRoute.why, 2) ThenBlock: {
            lab = "not audio"
            ink = FB_RGB(220, 180, 120)
        }
        IfCondition EqualTo(DawRoute.why, 3) ThenBlock: {
            lab = "cycle"
            ink = FB_RGB(220, 180, 120)
        }
        IfCondition EqualTo(DawRoute.why, 4) ThenBlock: {
            lab = "slot missing"
            ink = FB_RGB(220, 180, 120)
        }
        IfCondition EqualTo(DawRoute.why, 0) ThenBlock: {
            IfCondition EqualTo(DawRoute.arm, 1) ThenBlock: {
                lab = "Drop on a jack."
            }
            IfCondition NotEqual(DawRoute.arm, 1) ThenBlock: {
                IfCondition NotEqual(DawRoute.sel, 0) ThenBlock: {
                    lab = "Break removes the selected cable."
                }
            }
        }
        FB_DrawString(tx, ty, lab, ink, -1)
        by = Subtract(Add(DawRoute.oy, DawRoute.oh), 20)
        x0 = Add(DawRoute.ox, 8)
        fill = FB_RGB(28, 30, 34)
        fg = FB_RGB(160, 164, 150)
        IfCondition NotEqual(DawRoute.sel, 0) ThenBlock: {
            fill = FB_RGB(128, 52, 48)
            fg = FB_RGB(255, 236, 230)
        }
        FB_FillRectFast(x0, by, 72, 16, fill)
        FB_DrawString(Add(x0, 8), Add(by, 4), "Break", fg, -1)
        ReturnValue(0)
    }
}

Function.DawRoute.DrawMenu {
    Output: Integer
    Body: {
        IfCondition EqualTo(DawRoute.menu, 0) ThenBlock: { ReturnValue(0) }
        bg = FB_RGB(32, 36, 44)
        gold = FB_RGB(200, 180, 80)
        FB_FillRectFast(DawRoute.mx, DawRoute.my, 96, 72, bg)
        FB_Rect(DawRoute.mx, DawRoute.my, 96, 72, gold)
        hot = FB_RGB(70, 120, 140)
        dim = FB_RGB(160, 164, 150)
        lit = FB_RGB(236, 232, 210)
        i = 0
        WhileLoop LessThan(i, 4) {
            iy = Add(DawRoute.my, Multiply(i, 18))
            IfCondition EqualTo(i, DawRoute.hov) ThenBlock: {
                FB_FillRectFast(DawRoute.mx, iy, 96, 18, hot)
            }
            lab = DawRoute.KindWord(i)
            ink = lit
            ok = DawRoute.Offers(DawRoute.src, i)
            IfCondition EqualTo(ok, 0) ThenBlock: { ink = dim }
            tx = Add(DawRoute.mx, 8)
            ty = Add(iy, 5)
            FB_DrawString(tx, ty, lab, ink, -1)
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

Function.DawRoute.Draw {
    Input: x: Integer
    Input: y: Integer
    Input: w: Integer
    Input: h: Integer
    Output: Integer
    Body: {
        DawRoute.ox = x
        DawRoute.oy = y
        DawRoute.ow = w
        DawRoute.oh = h
        IfCondition LessThan(w, 8) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(h, 8) ThenBlock: { ReturnValue(0) }
        DawRoute.Layout()
        FB_SetClip(x, y, w, h)
        bg = FB_RGB(18, 20, 24)
        FB_FillRectFast(x, y, w, h, bg)
        DawRoute.BayLabels()
        DawRoute.BayCols()
        DawRoute.BayPins()
        DawRoute.BayCords()
        DawRoute.BayRubber()
        DawRoute.BayScroll()
        DawRoute.DrawStatus()
        FB_ClearClip()
        ReturnValue(0)
    }
}

Function.DawRoute.PortAt {
    Input: px: Integer
    Input: py: Integer
    Output: Address
    Body: {
        left = Add(DawRoute.ox, 4)
        IfCondition LessThan(px, left) ThenBlock: { ReturnValue(0) }
        right = Add(DawRoute.ox, 228)
        IfCondition GreaterEqual(px, right) ThenBlock: { ReturnValue(0) }
        off = PoolFieldOffset(LinkagePool.DawPort, "next")
        cur = DawRoute.ports
        WhileLoop NotEqual(cur, 0) {
            yy = DawRoute.PRow(cur)
            IfCondition NotEqual(yy, 0) ThenBlock: {
                IfCondition GreaterEqual(py, yy) ThenBlock: {
                    IfCondition LessThan(py, Add(yy, 14)) ThenBlock: {
                        ReturnValue(cur)
                    }
                }
            }
            cur = Dereference(Add(cur, off))
        }
        ReturnValue(0)
    }
}

Function.DawRoute.ConnAt {
    Input: px: Integer
    Input: py: Integer
    Output: Address
    Body: {
        left = Add(DawRoute.ox, 300)
        IfCondition LessThan(px, left) ThenBlock: { ReturnValue(0) }
        right = Add(DawRoute.ox, DawRoute.ow)
        IfCondition GreaterEqual(px, right) ThenBlock: { ReturnValue(0) }
        off = PoolFieldOffset(LinkagePool.DawConn, "next")
        cur = DawRoute.conns
        WhileLoop NotEqual(cur, 0) {
            yy = DawRoute.CRow(cur)
            IfCondition NotEqual(yy, 0) ThenBlock: {
                IfCondition GreaterEqual(py, yy) ThenBlock: {
                    IfCondition LessThan(py, Add(yy, 14)) ThenBlock: {
                        ReturnValue(cur)
                    }
                }
            }
            cur = Dereference(Add(cur, off))
        }
        ReturnValue(0)
    }
}

Function.DawRoute.CableAt {
    Input: px: Integer
    Input: py: Integer
    Output: Address
    Body: {
        left = Add(DawRoute.ox, 224)
        IfCondition LessThan(px, left) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterEqual(px, DawRoute.sbx) ThenBlock: { ReturnValue(0) }
        off = PoolFieldOffset(LinkagePool.DawConn, "next")
        cur = DawRoute.conns
        idx = 0
        WhileLoop NotEqual(cur, 0) {
            sp = DawRoute.CSrc(cur)
            dp = DawRoute.CDst(cur)
            y1 = DawRoute.PRow(sp)
            y2 = DawRoute.PRow(dp)
            IfCondition NotEqual(y1, 0) ThenBlock: {
                IfCondition NotEqual(y2, 0) ThenBlock: {
                    k = Modulo(idx, 8)
                    vx = Add(DawRoute.ox, Add(236, Multiply(k, 4)))
                    ylo = y1
                    yhi = y2
                    IfCondition LessThan(y2, y1) ThenBlock: {
                        ylo = y2
                        yhi = y1
                    }
                    yhi = Add(yhi, 14)
                    vx0 = Subtract(vx, 3)
                    vx1 = Add(vx, 4)
                    IfCondition GreaterEqual(px, vx0) ThenBlock: {
                        IfCondition LessThan(px, vx1) ThenBlock: {
                            IfCondition GreaterEqual(py, ylo) ThenBlock: {
                                IfCondition LessThan(py, yhi) ThenBlock: {
                                    ReturnValue(cur)
                                }
                            }
                        }
                    }
                    y1b = Add(y1, 14)
                    IfCondition GreaterEqual(py, y1) ThenBlock: {
                        IfCondition LessThan(py, y1b) ThenBlock: {
                            IfCondition LessThan(px, vx1) ThenBlock: {
                                ReturnValue(cur)
                            }
                        }
                    }
                    y2b = Add(y2, 14)
                    IfCondition GreaterEqual(py, y2) ThenBlock: {
                        IfCondition LessThan(py, y2b) ThenBlock: {
                            IfCondition LessThan(px, vx1) ThenBlock: {
                                ReturnValue(cur)
                            }
                        }
                    }
                }
            }
            idx = Add(idx, 1)
            cur = Dereference(Add(cur, off))
        }
        ReturnValue(0)
    }
}

Function.DawRoute.MenuRow {
    Input: px: Integer
    Input: py: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(DawRoute.menu, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition LessThan(px, DawRoute.mx) ThenBlock: { ReturnValue(-1) }
        IfCondition LessThan(py, DawRoute.my) ThenBlock: { ReturnValue(-1) }
        IfCondition GreaterEqual(px, Add(DawRoute.mx, 96)) ThenBlock: { ReturnValue(-1) }
        IfCondition GreaterEqual(py, Add(DawRoute.my, 72)) ThenBlock: { ReturnValue(-1) }
        rel = Subtract(py, DawRoute.my)
        i = Divide(rel, 18)
        IfCondition LessThan(i, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition GreaterThan(i, 3) ThenBlock: { ReturnValue(-1) }
        ReturnValue(i)
    }
}

Function.DawRoute.Hover {
    Input: px: Integer
    Input: py: Integer
    Output: Integer
    Body: {
        DawRoute.hov = DawRoute.MenuRow(px, py)
        DawRoute.hot = DawRoute.BarHit(px, py)
        ReturnValue(DawRoute.hov)
    }
}

Function.DawRoute.OpenMenu {
    Input: px: Integer
    Input: py: Integer
    Output: Integer
    Body: {
        mx = px
        my = py
        limit = Subtract(Add(DawRoute.ox, DawRoute.ow), 96)
        IfCondition GreaterThan(mx, limit) ThenBlock: { mx = limit }
        IfCondition LessThan(mx, DawRoute.ox) ThenBlock: { mx = DawRoute.ox }
        limit = Subtract(Add(DawRoute.oy, DawRoute.oh), 72)
        IfCondition GreaterThan(my, limit) ThenBlock: { my = limit }
        IfCondition LessThan(my, DawRoute.oy) ThenBlock: { my = DawRoute.oy }
        DawRoute.mx = mx
        DawRoute.my = my
        DawRoute.menu = 1
        DawRoute.hov = -1
        ReturnValue(1)
    }
}

Function.DawRoute.PickKind {
    Input: row: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(row, 0) ThenBlock: { ReturnValue(0) }
        ok = DawRoute.Offers(DawRoute.src, row)
        IfCondition EqualTo(ok, 0) ThenBlock: { ReturnValue(0) }
        DawRoute.gkind = row
        DawRoute.why = 0
        DawRoute.menu = 0
        ReturnValue(1)
    }
}

Function.DawRoute.Press {
    Input: px: Integer
    Input: py: Integer
    Output: Integer
    Body: {
        which = DawRoute.BarHit(px, py)
        IfCondition EqualTo(which, 4) ThenBlock: {
            IfCondition NotEqual(DawRoute.sel, 0) ThenBlock: {
                gone = DawRoute.sel
                DawRoute.CutLoop(gone)
            }
            DawRoute.arm = 0
            DawRoute.src = 0
            DawRoute.sdrag = 0
            ReturnValue(1)
        }
        onbar = DawRoute.InBar(px, py)
        IfCondition EqualTo(onbar, 1) ThenBlock: {
            tx = DawRoute.ThumbX()
            tw = DawRoute.ThumbW()
            right = Add(tx, tw)
            DawRoute.arm = 0
            DawRoute.src = 0
            IfCondition GreaterEqual(px, tx) ThenBlock: {
                IfCondition LessThan(px, right) ThenBlock: {
                    DawRoute.sdrag = 1
                    DawRoute.sgrab = Subtract(px, tx)
                    ReturnValue(1)
                }
            }
            DawRoute.sdrag = 0
            IfCondition LessThan(px, tx) ThenBlock: {
                DawRoute.scroll = Subtract(DawRoute.scroll, 1)
            }
            ElseBlock: {
                DawRoute.scroll = Add(DawRoute.scroll, 1)
            }
            DawRoute.ClampScroll()
            ReturnValue(1)
        }
        port = DawRoute.JackAt(px, py)
        IfCondition NotEqual(port, 0) ThenBlock: {
            DawRoute.src = port
            DawRoute.arm = 1
            DawRoute.x0 = px
            DawRoute.y0 = py
            DawRoute.ax = px
            DawRoute.ay = py
            DawRoute.why = 0
            DawRoute.gkind = -1
            DawRoute.sdrag = 0
            ReturnValue(1)
        }
        wire = DawRoute.CordAt(px, py)
        IfCondition NotEqual(wire, 0) ThenBlock: {
            DawRoute.sel = wire
            DawRoute.arm = 0
            DawRoute.src = 0
            DawRoute.why = 0
            DawRoute.sdrag = 0
            ReturnValue(1)
        }
        DawRoute.arm = 0
        DawRoute.sdrag = 0
        ReturnValue(1)
    }
}

Function.DawRoute.Right {
    Input: px: Integer
    Input: py: Integer
    Output: Integer
    Body: {
        inn = DawRoute.Inside(px, py)
        IfCondition EqualTo(inn, 0) ThenBlock: { ReturnValue(1) }
        wire = DawRoute.CordAt(px, py)
        IfCondition NotEqual(wire, 0) ThenBlock: { DawRoute.sel = wire }
        ReturnValue(1)
    }
}

Function.DawRoute.FindName {
    Input: name: Address
    Output: Address
    Body: {
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }
        off = PoolFieldOffset(LinkagePool.DawPort, "next")
        cur = DawRoute.ports
        WhileLoop NotEqual(cur, 0) {
            nm = DawRoute.PName(cur)
            hit = 0
            IfCondition NotEqual(nm, 0) ThenBlock: {
                cmp = StringCompare(nm, name)
                IfCondition EqualTo(cmp, 0) ThenBlock: { hit = 1 }
            }
            IfCondition EqualTo(hit, 1) ThenBlock: { ReturnValue(cur) }
            cur = Dereference(Add(cur, off))
        }
        ReturnValue(0)
    }
}

Function.DawRoute.SetDelay {
    Input: conn: Address
    Input: delay: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(conn, 0) ThenBlock: { ReturnValue(0) }
        off = PoolFieldOffset(LinkagePool.DawConn, "delay")
        StoreValue(Add(conn, off), delay)
        ReturnValue(delay)
    }
}

Function.DawRoute.OnChain {
    Input: track: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(track, 0) ThenBlock: { ReturnValue(0) }
        off = PoolFieldOffset(LinkagePool.DawTrack, "next")
        cur = DawTracks.head
        WhileLoop NotEqual(cur, 0) {
            IfCondition EqualTo(cur, track) ThenBlock: { ReturnValue(1) }
            cur = Dereference(Add(cur, off))
        }
        ReturnValue(0)
    }
}

Function.DawRoute.UnlinkLoose {
    Output: Integer
    Body: {
        off = PoolFieldOffset(LinkagePool.DawConn, "next")
        prev = 0
        cur = DawRoute.conns
        count = 0
        WhileLoop NotEqual(cur, 0) {
            nxt = Dereference(Add(cur, off))
            sp = DawRoute.CSrc(cur)
            dp = DawRoute.CDst(cur)
            st = DawRoute.PTrack(sp)
            dt = DawRoute.PTrack(dp)
            ks = DawRoute.OnChain(st)
            kd = DawRoute.OnChain(dt)
            keep = 0
            IfCondition EqualTo(ks, 1) ThenBlock: { keep = 1 }
            IfCondition EqualTo(kd, 1) ThenBlock: { keep = 1 }
            IfCondition EqualTo(keep, 0) ThenBlock: {
                IfCondition EqualTo(DawRoute.sel, cur) ThenBlock: { DawRoute.sel = 0 }
                IfCondition EqualTo(prev, 0) ThenBlock: {
                    DawRoute.conns = nxt
                }
                ElseBlock: {
                    StoreValue(Add(prev, off), nxt)
                }
                count = Add(count, 1)
            }
            ElseBlock: {
                prev = cur
            }
            cur = nxt
        }
        ReturnValue(count)
    }
}
