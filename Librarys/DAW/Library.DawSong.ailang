Function.DawSong.TInt {
    Input: track: Address
    Input: which: Integer
    Output: Integer
    Body: {
        at = PoolFieldOffset(LinkagePool.DawTrack, "kind")
        IfCondition EqualTo(which, 2) ThenBlock: {
            at = PoolFieldOffset(LinkagePool.DawTrack, "view")
        }
        IfCondition EqualTo(which, 3) ThenBlock: {
            at = PoolFieldOffset(LinkagePool.DawTrack, "arm")
        }
        IfCondition EqualTo(which, 4) ThenBlock: {
            at = PoolFieldOffset(LinkagePool.DawTrack, "mute")
        }
        IfCondition EqualTo(which, 5) ThenBlock: {
            at = PoolFieldOffset(LinkagePool.DawTrack, "solo")
        }
        IfCondition EqualTo(which, 6) ThenBlock: {
            at = PoolFieldOffset(LinkagePool.DawTrack, "fader")
        }
        IfCondition EqualTo(which, 7) ThenBlock: {
            at = PoolFieldOffset(LinkagePool.DawTrack, "pan")
        }
        IfCondition EqualTo(which, 8) ThenBlock: {
            at = PoolFieldOffset(LinkagePool.DawTrack, "fx")
        }
        ReturnValue(Dereference(Add(track, at)))
    }
}

