Function.DawSong.PresetRel {
    Input: text: Address
    Output: Address
    Body: {
        a = StringConcat("patches/", text)
        b = StringConcat(a, ".fxp")
        DawSong.FreeStr(a)
        ReturnValue(b)
    }
}

Function.DawSong.VstRel {
    Input: text: Address
    Output: Address
    Body: {
        a = StringConcat("patches/", text)
        b = StringConcat(a, ".bin")
        DawSong.FreeStr(a)
        ReturnValue(b)
    }
}

Function.DawSong.PatchJoin {
    Input: text: Address
    Input: tail: Address
    Output: Address
    Body: {
        dirp = DawSong.Join(DawSong.path, "patches")
        base = DawSong.Join(dirp, text)
        DawSong.FreeStr(dirp)
        out = StringConcat(base, tail)
        DawSong.FreeStr(base)
        ReturnValue(out)
    }
}

Function.DawSong.PatchTmp {
    Input: text: Address
    Output: Address
    Body: {
        p = DawSong.PatchJoin(text, ".fxp.tmp")
        ReturnValue(p)
    }
}

Function.DawSong.PatchFinal {
    Input: text: Address
    Output: Address
    Body: {
        p = DawSong.PatchJoin(text, ".fxp")
        ReturnValue(p)
    }
}

Function.DawSong.Resolve {
    Input: text: Address
    Output: Address
    Body: {
        k = DawSong.PathKind(text)
        IfCondition EqualTo(k, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(k, 1) ThenBlock: {
            p = DawSong.CopyStr(text)
            ReturnValue(p)
        }
        d = DawSong.HasDotDot(text)
        IfCondition EqualTo(d, 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(k, 2) ThenBlock: {
            p = DawSong.Join(DawSong.repo, text)
            ReturnValue(p)
        }
        IfCondition EqualTo(DawSong.path, 0) ThenBlock: { ReturnValue(0) }
        p = DawSong.Join(DawSong.path, text)
        ReturnValue(p)
    }
}

Function.DawSong.FillSuffix {
    Input: text: Address
    Input: which: Integer
    Output: Address
    Body: {
        buf = DawSong.suf
        len = 0
        IfCondition NotEqual(text, 0) ThenBlock: { len = StringLength(text) }
        IfCondition GreaterThan(len, 40) ThenBlock: { len = 40 }
        idx = 0
        WhileLoop LessThan(idx, len) {
            ch = GetByte(text, idx)
            SetByte(buf, idx, ch)
            idx = Add(idx, 1)
        }
        SetByte(buf, idx, 46)
        p1 = Add(idx, 1)
        p2 = Add(idx, 2)
        p3 = Add(idx, 3)
        p4 = Add(idx, 4)
        IfCondition EqualTo(which, 0) ThenBlock: {
            SetByte(buf, p1, 105)
            SetByte(buf, p2, 110)
            SetByte(buf, p3, 0)
        }
        IfCondition EqualTo(which, 1) ThenBlock: {
            SetByte(buf, p1, 111)
            SetByte(buf, p2, 117)
            SetByte(buf, p3, 116)
            SetByte(buf, p4, 0)
        }
        IfCondition EqualTo(which, 2) ThenBlock: {
            SetByte(buf, p1, 109)
            SetByte(buf, p2, 115)
            SetByte(buf, p3, 116)
            SetByte(buf, p4, 0)
        }
        IfCondition EqualTo(which, 3) ThenBlock: {
            SetByte(buf, p1, 102)
            SetByte(buf, p2, 120)
            SetByte(buf, p3, 115)
            SetByte(buf, p4, 0)
        }
        IfCondition EqualTo(which, 4) ThenBlock: {
            SetByte(buf, p1, 102)
            SetByte(buf, p2, 120)
            SetByte(buf, p3, 114)
            SetByte(buf, p4, 0)
        }
        IfCondition EqualTo(which, 5) ThenBlock: {
            SetByte(buf, p1, 115)
            SetByte(buf, p2, 100)
            SetByte(buf, p3, 115)
            SetByte(buf, p4, 0)
        }
        IfCondition EqualTo(which, 6) ThenBlock: {
            SetByte(buf, p1, 115)
            SetByte(buf, p2, 100)
            SetByte(buf, p3, 114)
            SetByte(buf, p4, 0)
        }
        ReturnValue(buf)
    }
}

Function.DawSong.PortHit {
    Input: text: Address
    Output: Integer
    Body: {
        off = PoolFieldOffset(LinkagePool.DawPort, "next")
        cur = DawRoute.ports
        WhileLoop NotEqual(cur, 0) {
            tr = DawRoute.PTrack(cur)
            IfCondition EqualTo(tr, 0) ThenBlock: {
                nm = DawRoute.PName(cur)
                IfCondition NotEqual(nm, 0) ThenBlock: {
                    cmp = StringCompare(nm, text)
                    IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
                }
            }
            cur = Dereference(Add(cur, off))
        }
        ReturnValue(0)
    }
}

Function.DawSong.Clash {
    Input: text: Address
    Output: Integer
    Body: {
        buf = DawSong.FillSuffix(text, 0)
        hit = DawSong.PortHit(buf)
        IfCondition EqualTo(hit, 1) ThenBlock: { ReturnValue(1) }
        buf = DawSong.FillSuffix(text, 1)
        hit = DawSong.PortHit(buf)
        IfCondition EqualTo(hit, 1) ThenBlock: { ReturnValue(1) }
        buf = DawSong.FillSuffix(text, 2)
        hit = DawSong.PortHit(buf)
        IfCondition EqualTo(hit, 1) ThenBlock: { ReturnValue(1) }
        buf = DawSong.FillSuffix(text, 3)
        hit = DawSong.PortHit(buf)
        IfCondition EqualTo(hit, 1) ThenBlock: { ReturnValue(1) }
        buf = DawSong.FillSuffix(text, 4)
        hit = DawSong.PortHit(buf)
        IfCondition EqualTo(hit, 1) ThenBlock: { ReturnValue(1) }
        buf = DawSong.FillSuffix(text, 5)
        hit = DawSong.PortHit(buf)
        IfCondition EqualTo(hit, 1) ThenBlock: { ReturnValue(1) }
        buf = DawSong.FillSuffix(text, 6)
        hit = DawSong.PortHit(buf)
        IfCondition EqualTo(hit, 1) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

Function.DawSong.OptOk {
    Input: obj: Address
    Input: key: Address
    Output: Integer
    Body: {
        ty = JSON.GetType(obj, key)
        IfCondition EqualTo(ty, JType.NULL) ThenBlock: { ReturnValue(1) }
        IfCondition NotEqual(ty, JType.STRING) ThenBlock: { ReturnValue(0) }
        s = JSON.GetString(obj, key)
        r = DawSong.RelSafe(s)
        ReturnValue(r)
    }
}

Function.DawSong.PresetOk {
    Input: obj: Address
    Input: text: Address
    Output: Integer
    Body: {
        ty = JSON.GetType(obj, "preset")
        IfCondition EqualTo(ty, JType.NULL) ThenBlock: { ReturnValue(1) }
        IfCondition NotEqual(ty, JType.STRING) ThenBlock: { ReturnValue(0) }
        s = JSON.GetString(obj, "preset")
        blank = DawSong.Blank(s)
        IfCondition EqualTo(blank, 1) ThenBlock: { ReturnValue(1) }
        expect = DawSong.PresetRel(text)
        cmp = StringCompare(s, expect)
        DawSong.FreeStr(expect)
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

Function.DawSong.HostOk {
    Input: obj: Address
    Output: Integer
    Body: {
        ty = JSON.GetType(obj, "host")
        IfCondition EqualTo(ty, JType.NULL) ThenBlock: { ReturnValue(1) }
        IfCondition NotEqual(ty, JType.STRING) ThenBlock: { ReturnValue(0) }
        s = JSON.GetString(obj, "host")
        blank = DawSong.Blank(s)
        IfCondition EqualTo(blank, 1) ThenBlock: { ReturnValue(1) }
        r = DawSong.LegalFolder(s)
        ReturnValue(r)
    }
}

Function.DawSong.VstOk {
    Input: obj: Address
    Output: Integer
    Body: {
        ty = JSON.GetType(obj, "vst")
        IfCondition EqualTo(ty, JType.NULL) ThenBlock: { ReturnValue(1) }
        IfCondition NotEqual(ty, JType.STRING) ThenBlock: { ReturnValue(0) }
        vs = JSON.GetString(obj, "vst")
        blank = DawSong.Blank(vs)
        IfCondition EqualTo(blank, 1) ThenBlock: { ReturnValue(1) }
        hty = JSON.GetType(obj, "host")
        IfCondition NotEqual(hty, JType.STRING) ThenBlock: { ReturnValue(0) }
        hid = JSON.GetString(obj, "host")
        hb = DawSong.Blank(hid)
        IfCondition EqualTo(hb, 1) ThenBlock: { ReturnValue(0) }
        rel = DawSong.VstRel(hid)
        IfCondition EqualTo(rel, 0) ThenBlock: { ReturnValue(0) }
        cmp = StringCompare(vs, rel)
        DawSong.FreeStr(rel)
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

Function.DawSong.HostSeqOk {
    Input: obj: Address
    Output: Integer
    Body: {
        ty = JSON.GetType(obj, "host_seq")
        IfCondition EqualTo(ty, JType.NULL) ThenBlock: { ReturnValue(1) }
        IfCondition NotEqual(ty, JType.NUMBER) ThenBlock: { ReturnValue(0) }
        v = JSON.GetNumber(obj, "host_seq")
        IfCondition LessThan(v, 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(1)
    }
}

Function.DawSong.DupName {
    Input: arr: Address
    Input: index: Integer
    Input: text: Address
    Output: Integer
    Body: {
        idx = 0
        WhileLoop LessThan(idx, index) {
            tagged = JSON.ArrayGet(arr, idx)
            obj = JSON.AsObject(tagged)
            IfCondition NotEqual(obj, 0) ThenBlock: {
                other = JSON.GetString(obj, "name")
                IfCondition NotEqual(other, 0) ThenBlock: {
                    cmp = StringCompare(other, text)
                    IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
                }
            }
            idx = Add(idx, 1)
        }
        ReturnValue(0)
    }
}

Function.DawSong.DupHost {
    Input: arr: Address
    Input: index: Integer
    Input: text: Address
    Output: Integer
    Body: {
        blank = DawSong.Blank(text)
        IfCondition EqualTo(blank, 1) ThenBlock: { ReturnValue(0) }
        idx = 0
        WhileLoop LessThan(idx, index) {
            tagged = JSON.ArrayGet(arr, idx)
            obj = JSON.AsObject(tagged)
            IfCondition NotEqual(obj, 0) ThenBlock: {
                other = JSON.GetString(obj, "host")
                IfCondition NotEqual(other, 0) ThenBlock: {
                    cmp = StringCompare(other, text)
                    IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
                }
            }
            idx = Add(idx, 1)
        }
        ReturnValue(0)
    }
}

Function.DawSong.NeedStr {
    Input: obj: Address
    Input: key: Address
    Output: Address
    Body: {
        ty = JSON.GetType(obj, key)
        IfCondition NotEqual(ty, JType.STRING) ThenBlock: { ReturnValue(0) }
        s = JSON.GetString(obj, key)
        ReturnValue(s)
    }
}

Function.DawSong.CheckClip {
    Input: obj: Address
    Output: Integer
    Body: {
        ok = DawSong.Num(obj, "start")
        IfCondition EqualTo(ok, 0) ThenBlock: { ReturnValue(0) }
        st = DawSong.num
        rng = DawSong.InRange(st, 0, 100000)
        IfCondition EqualTo(rng, 0) ThenBlock: { ReturnValue(0) }
        ok = DawSong.Num(obj, "length")
        IfCondition EqualTo(ok, 0) ThenBlock: { ReturnValue(0) }
        ln = DawSong.num
        rng = DawSong.InRange(ln, 0, 100000)
        IfCondition EqualTo(rng, 0) ThenBlock: { ReturnValue(0) }
        ok = DawSong.Num(obj, "src")
        IfCondition EqualTo(ok, 0) ThenBlock: { ReturnValue(0) }
        src = DawSong.num
        IfCondition NotEqual(src, 0) ThenBlock: {
            IfCondition NotEqual(src, 1) ThenBlock: { ReturnValue(0) }
        }
        lab = DawSong.NeedStr(obj, "label")
        IfCondition EqualTo(lab, 0) ThenBlock: { ReturnValue(0) }
        ok = DawSong.OptOk(obj, "file")
        IfCondition EqualTo(ok, 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(1)
    }
}

Function.DawSong.CheckNote {
    Input: obj: Address
    Output: Integer
    Body: {
        ok = DawSong.Num(obj, "start")
        IfCondition EqualTo(ok, 0) ThenBlock: { ReturnValue(0) }
        st = DawSong.num
        rng = DawSong.InRange(st, 0, 100000)
        IfCondition EqualTo(rng, 0) ThenBlock: { ReturnValue(0) }
        ok = DawSong.Num(obj, "length")
        IfCondition EqualTo(ok, 0) ThenBlock: { ReturnValue(0) }
        ln = DawSong.num
        rng = DawSong.InRange(ln, 0, 100000)
        IfCondition EqualTo(rng, 0) ThenBlock: { ReturnValue(0) }
        ok = DawSong.Num(obj, "pitch")
        IfCondition EqualTo(ok, 0) ThenBlock: { ReturnValue(0) }
        pit = DawSong.num
        rng = DawSong.InRange(pit, 0, 127)
        IfCondition EqualTo(rng, 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(1)
    }
}

Function.DawSong.CheckMap {
    Input: obj: Address
    Output: Integer
    Body: {
        ty = JSON.GetType(obj, "map")
        IfCondition NotEqual(ty, JType.ARRAY) ThenBlock: { ReturnValue(0) }
        arr = JSON.GetArray(obj, "map")
        mlen = JSON.ArrayLength(arr)
        IfCondition LessThan(mlen, 2) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterThan(mlen, 16) ThenBlock: { ReturnValue(0) }
        odd = BitwiseAnd(mlen, 1)
        IfCondition NotEqual(odd, 0) ThenBlock: { ReturnValue(0) }
        idx = 0
        WhileLoop LessThan(idx, mlen) {
            tagged = JSON.ArrayGet(arr, idx)
            tt = JSON.TagType(tagged)
            IfCondition NotEqual(tt, JType.NUMBER) ThenBlock: { ReturnValue(0) }
            idx = Add(idx, 1)
        }
        ReturnValue(1)
    }
}

Function.DawSong.CheckConn {
    Input: obj: Address
    Output: Integer
    Body: {
        src = DawSong.NeedStr(obj, "src")
        IfCondition EqualTo(src, 0) ThenBlock: { ReturnValue(0) }
        blank = DawSong.Blank(src)
        IfCondition EqualTo(blank, 1) ThenBlock: { ReturnValue(0) }
        dst = DawSong.NeedStr(obj, "dst")
        IfCondition EqualTo(dst, 0) ThenBlock: { ReturnValue(0) }
        blank = DawSong.Blank(dst)
        IfCondition EqualTo(blank, 1) ThenBlock: { ReturnValue(0) }
        ok = DawSong.Num(obj, "kind")
        IfCondition EqualTo(ok, 0) ThenBlock: { ReturnValue(0) }
        kv = DawSong.num
        rng = DawSong.InRange(kv, 0, 3)
        IfCondition EqualTo(rng, 0) ThenBlock: { ReturnValue(0) }
        ok = DawSong.Num(obj, "loop")
        IfCondition EqualTo(ok, 0) ThenBlock: { ReturnValue(0) }
        ok = DawSong.Num(obj, "delay")
        IfCondition EqualTo(ok, 0) ThenBlock: { ReturnValue(0) }
        ok = DawSong.CheckMap(obj)
        ReturnValue(ok)
    }
}

Function.DawSong.CheckList {
    Input: arr: Address
    Input: kind: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(arr, 0) ThenBlock: { ReturnValue(0) }
        count = JSON.ArrayLength(arr)
        idx = 0
        WhileLoop LessThan(idx, count) {
            tagged = JSON.ArrayGet(arr, idx)
            obj = JSON.AsObject(tagged)
            IfCondition EqualTo(obj, 0) ThenBlock: { ReturnValue(0) }
            ok = 0
            IfCondition EqualTo(kind, 1) ThenBlock: { ok = DawSong.CheckClip(obj) }
            IfCondition EqualTo(kind, 2) ThenBlock: { ok = DawSong.CheckNote(obj) }
            IfCondition EqualTo(kind, 3) ThenBlock: { ok = DawSong.CheckConn(obj) }
            IfCondition EqualTo(ok, 0) ThenBlock: { ReturnValue(0) }
            idx = Add(idx, 1)
        }
        ReturnValue(1)
    }
}

Function.DawSong.CheckTrack {
    Input: arr: Address
    Input: index: Integer
    Input: obj: Address
    Output: Integer
    Body: {
        nm = DawSong.NeedStr(obj, "name")
        IfCondition EqualTo(nm, 0) ThenBlock: { ReturnValue(0) }
        ok = DawSong.TrackNameOk(nm)
        IfCondition EqualTo(ok, 0) ThenBlock: { ReturnValue(0) }
        cmp = StringCompare(nm, "hw")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(0) }
        cmp = StringCompare(nm, "master")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(0) }
        hit = DawSong.Clash(nm)
        IfCondition EqualTo(hit, 1) ThenBlock: { ReturnValue(0) }
        dup = DawSong.DupName(arr, index, nm)
        IfCondition EqualTo(dup, 1) ThenBlock: { ReturnValue(0) }
        ok = DawSong.Num(obj, "kind")
        IfCondition EqualTo(ok, 0) ThenBlock: { ReturnValue(0) }
        kv = DawSong.num
        ok = DawSong.Num(obj, "view")
        IfCondition EqualTo(ok, 0) ThenBlock: { ReturnValue(0) }
        vv = DawSong.num
        pair = DawSong.KindOk(kv, vv)
        IfCondition EqualTo(pair, 0) ThenBlock: { ReturnValue(0) }
        inst = DawSong.NeedStr(obj, "inst")
        IfCondition EqualTo(inst, 0) ThenBlock: { ReturnValue(0) }
        ok = DawSong.PresetOk(obj, nm)
        IfCondition EqualTo(ok, 0) ThenBlock: { ReturnValue(0) }
        ok = DawSong.OptOk(obj, "library")
        IfCondition EqualTo(ok, 0) ThenBlock: { ReturnValue(0) }
        ok = DawSong.OptOk(obj, "pack")
        IfCondition EqualTo(ok, 0) ThenBlock: { ReturnValue(0) }
        ok = DawSong.OptOk(obj, "midi")
        IfCondition EqualTo(ok, 0) ThenBlock: { ReturnValue(0) }
        ok = DawSong.HostOk(obj)
        IfCondition EqualTo(ok, 0) ThenBlock: { ReturnValue(0) }
        hty = JSON.GetType(obj, "host")
        IfCondition EqualTo(hty, JType.STRING) ThenBlock: {
            hs = JSON.GetString(obj, "host")
            dup = DawSong.DupHost(arr, index, hs)
            IfCondition EqualTo(dup, 1) ThenBlock: { ReturnValue(0) }
        }
        ok = DawSong.OptOk(obj, "plugin")
        IfCondition EqualTo(ok, 0) ThenBlock: { ReturnValue(0) }
        ok = DawSong.VstOk(obj)
        IfCondition EqualTo(ok, 0) ThenBlock: { ReturnValue(0) }
        ok = DawSong.Num(obj, "arm")
        IfCondition EqualTo(ok, 0) ThenBlock: { ReturnValue(0) }
        rng = DawSong.InRange(DawSong.num, 0, 1)
        IfCondition EqualTo(rng, 0) ThenBlock: { ReturnValue(0) }
        ok = DawSong.Num(obj, "mute")
        IfCondition EqualTo(ok, 0) ThenBlock: { ReturnValue(0) }
        rng = DawSong.InRange(DawSong.num, 0, 1)
        IfCondition EqualTo(rng, 0) ThenBlock: { ReturnValue(0) }
        ok = DawSong.Num(obj, "solo")
        IfCondition EqualTo(ok, 0) ThenBlock: { ReturnValue(0) }
        rng = DawSong.InRange(DawSong.num, 0, 1)
        IfCondition EqualTo(rng, 0) ThenBlock: { ReturnValue(0) }
        ok = DawSong.Num(obj, "fader")
        IfCondition EqualTo(ok, 0) ThenBlock: { ReturnValue(0) }
        rng = DawSong.InRange(DawSong.num, 0, 1000)
        IfCondition EqualTo(rng, 0) ThenBlock: { ReturnValue(0) }
        ok = DawSong.Num(obj, "pan")
        IfCondition EqualTo(ok, 0) ThenBlock: { ReturnValue(0) }
        rng = DawSong.InRange(DawSong.num, 0, 1000)
        IfCondition EqualTo(rng, 0) ThenBlock: { ReturnValue(0) }
        ok = DawSong.Num(obj, "fx")
        IfCondition EqualTo(ok, 0) ThenBlock: { ReturnValue(0) }
        ty = JSON.GetType(obj, "clips")
        IfCondition NotEqual(ty, JType.ARRAY) ThenBlock: { ReturnValue(0) }
        clips = JSON.GetArray(obj, "clips")
        ok = DawSong.CheckList(clips, 1)
        IfCondition EqualTo(ok, 0) ThenBlock: { ReturnValue(0) }
        ty = JSON.GetType(obj, "notes")
        IfCondition NotEqual(ty, JType.ARRAY) ThenBlock: { ReturnValue(0) }
        notes = JSON.GetArray(obj, "notes")
        ok = DawSong.CheckList(notes, 2)
        IfCondition EqualTo(ok, 0) ThenBlock: { ReturnValue(0) }
        ty = JSON.GetType(obj, "automation")
        IfCondition NotEqual(ty, JType.ARRAY) ThenBlock: { ReturnValue(0) }
        ReturnValue(1)
    }
}

Function.DawSong.CheckAll {
    Input: obj: Address
    Input: folder: Address
    Output: Integer
    Body: {
        ty = JSON.GetType(obj, "version")
        IfCondition NotEqual(ty, JType.NUMBER) ThenBlock: {
            DawSong.why = 1
            ReturnValue(0)
        }
        ver = JSON.GetNumber(obj, "version")
        IfCondition NotEqual(ver, 1) ThenBlock: {
            DawSong.why = 1
            ReturnValue(0)
        }
        DawSong.why = 2
        nm = DawSong.NeedStr(obj, "name")
        IfCondition EqualTo(nm, 0) ThenBlock: { ReturnValue(0) }
        cmp = StringCompare(nm, folder)
        IfCondition NotEqual(cmp, 0) ThenBlock: { ReturnValue(0) }
        sg = DawSong.NeedStr(obj, "song")
        IfCondition EqualTo(sg, 0) ThenBlock: { ReturnValue(0) }
        ok = DawSong.RelSafe(sg)
        IfCondition EqualTo(ok, 0) ThenBlock: { ReturnValue(0) }
        ok = DawSong.Num(obj, "master_l")
        IfCondition EqualTo(ok, 0) ThenBlock: { ReturnValue(0) }
        rng = DawSong.InRange(DawSong.num, 0, 1000)
        IfCondition EqualTo(rng, 0) ThenBlock: { ReturnValue(0) }
        ok = DawSong.Num(obj, "master_r")
        IfCondition EqualTo(ok, 0) ThenBlock: { ReturnValue(0) }
        rng = DawSong.InRange(DawSong.num, 0, 1000)
        IfCondition EqualTo(rng, 0) ThenBlock: { ReturnValue(0) }
        ok = DawSong.Num(obj, "play")
        IfCondition EqualTo(ok, 0) ThenBlock: { ReturnValue(0) }
        rng = DawSong.InRange(DawSong.num, 0, 4000)
        IfCondition EqualTo(rng, 0) ThenBlock: { ReturnValue(0) }
        ok = DawSong.Num(obj, "zoom")
        IfCondition EqualTo(ok, 0) ThenBlock: { ReturnValue(0) }
        rng = DawSong.InRange(DawSong.num, 25, 400)
        IfCondition EqualTo(rng, 0) ThenBlock: { ReturnValue(0) }
        ok = DawSong.Num(obj, "rule")
        IfCondition EqualTo(ok, 0) ThenBlock: { ReturnValue(0) }
        rv = DawSong.num
        IfCondition NotEqual(rv, 0) ThenBlock: {
            IfCondition NotEqual(rv, 1) ThenBlock: { ReturnValue(0) }
        }
        ok = DawSong.HostSeqOk(obj)
        IfCondition EqualTo(ok, 0) ThenBlock: { ReturnValue(0) }
        ty = JSON.GetType(obj, "tracks")
        IfCondition NotEqual(ty, JType.ARRAY) ThenBlock: { ReturnValue(0) }
        tracks = JSON.GetArray(obj, "tracks")
        nt = JSON.ArrayLength(tracks)
        IfCondition GreaterThan(nt, 168) ThenBlock: { ReturnValue(0) }
        ty = JSON.GetType(obj, "conns")
        IfCondition NotEqual(ty, JType.ARRAY) ThenBlock: { ReturnValue(0) }
        conns = JSON.GetArray(obj, "conns")
        nc = JSON.ArrayLength(conns)
        IfCondition GreaterThan(nc, 1024) ThenBlock: { ReturnValue(0) }
        idx = 0
        WhileLoop LessThan(idx, nt) {
            tagged = JSON.ArrayGet(tracks, idx)
            tobj = JSON.AsObject(tagged)
            IfCondition EqualTo(tobj, 0) ThenBlock: { ReturnValue(0) }
            ok = DawSong.CheckTrack(tracks, idx, tobj)
            IfCondition EqualTo(ok, 0) ThenBlock: { ReturnValue(0) }
            idx = Add(idx, 1)
        }
        IfCondition EqualTo(rv, 0) ThenBlock: {
            ok = DawSong.CheckList(conns, 3)
            IfCondition EqualTo(ok, 0) ThenBlock: { ReturnValue(0) }
        }
        ReturnValue(1)
    }
}

Function.DawSong.Consumed {
    Input: buf: Address
    Input: sz: Integer
    Output: Integer
    Body: {
        pos = JParse.pos
        run = 1
        WhileLoop EqualTo(run, 1) {
            IfCondition GreaterEqual(pos, sz) ThenBlock: { run = 0 }
            ElseBlock: {
                ch = GetByte(buf, pos)
                ws = 0
                IfCondition EqualTo(ch, 32) ThenBlock: { ws = 1 }
                IfCondition EqualTo(ch, 9) ThenBlock: { ws = 1 }
                IfCondition EqualTo(ch, 10) ThenBlock: { ws = 1 }
                IfCondition EqualTo(ch, 13) ThenBlock: { ws = 1 }
                IfCondition EqualTo(ws, 1) ThenBlock: { pos = Add(pos, 1) }
                ElseBlock: { run = 0 }
            }
        }
        IfCondition NotEqual(pos, sz) ThenBlock: { ReturnValue(0) }
        idx = Subtract(sz, 1)
        run = 1
        last = 0
        WhileLoop EqualTo(run, 1) {
            IfCondition LessThan(idx, 0) ThenBlock: { run = 0 }
            ElseBlock: {
                ch = GetByte(buf, idx)
                ws = 0
                IfCondition EqualTo(ch, 32) ThenBlock: { ws = 1 }
                IfCondition EqualTo(ch, 9) ThenBlock: { ws = 1 }
                IfCondition EqualTo(ch, 10) ThenBlock: { ws = 1 }
                IfCondition EqualTo(ch, 13) ThenBlock: { ws = 1 }
                IfCondition EqualTo(ws, 1) ThenBlock: { idx = Subtract(idx, 1) }
                ElseBlock: {
                    last = ch
                    run = 0
                }
            }
        }
        IfCondition NotEqual(last, 125) ThenBlock: { ReturnValue(0) }
        ReturnValue(1)
    }
}

Function.DawSong.PutStr {
    Input: obj: Address
    Input: key: Address
    Input: text: Address
    Output: Integer
    Body: {
        buf = DawSong.PoolCopy(text)
        IfCondition EqualTo(buf, 0) ThenBlock: { ReturnValue(0) }
        JSON.SetString(obj, key, buf)
        ReturnValue(1)
    }
}

Function.DawSong.FailTag {
    Input: hold: Address
    Output: Address
    Body: {
        IfCondition NotEqual(hold, 0) ThenBlock: { JSON.Free(hold) }
        ReturnValue(0)
    }
}

Function.DawSong.KillArr {
    Input: arr: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(arr, 0) ThenBlock: { ReturnValue(0) }
        hold = JSON.Tag(JType.ARRAY, arr)
        JSON.Free(hold)
        ReturnValue(0)
    }
}

Function.DawSong.WipeTmps {
    Output: Integer
    Body: {
        IfCondition EqualTo(DawSong.path, 0) ThenBlock: { ReturnValue(0) }
        cur = DawTracks.head
        WhileLoop NotEqual(cur, 0) {
            nm = DawSong.NameOf(cur)
            ok = DawSong.TrackNameOk(nm)
            IfCondition EqualTo(ok, 1) ThenBlock: {
                tmp = DawSong.PatchTmp(nm)
                DawSong.Unlink(tmp)
                DawSong.FreeStr(tmp)
            }
            hid = DawSong.HostOf(cur)
            okh = DawSong.LegalFolder(hid)
            IfCondition EqualTo(okh, 1) ThenBlock: {
                btmp = DawSong.PatchJoin(hid, ".bin.tmp")
                IfCondition NotEqual(btmp, 0) ThenBlock: {
                    DawSong.Unlink(btmp)
                    DawSong.FreeStr(btmp)
                }
            }
            cur = DawSong.NextOf(cur)
        }
        sess = DawSong.Join(DawSong.path, "session.json.tmp")
        DawSong.Unlink(sess)
        DawSong.FreeStr(sess)
        ReturnValue(1)
    }
}

Function.DawSong.AbortSave {
    Input: hold: Address
    Input: text: Address
    Output: Integer
    Body: {
        DawSong.WipeTmps()
        IfCondition NotEqual(text, 0) ThenBlock: { DawSong.FreeStr(text) }
        IfCondition NotEqual(hold, 0) ThenBlock: { JSON.Free(hold) }
        DawSong.err = "save fail"
        PrintMessage("save fail\n")
        ReturnValue(0)
    }
}

Function.DawSong.EnsureUntitled {
    Output: Integer
    Body: {
        ok = DawSong.Mkdir(DawSong.root)
        IfCondition EqualTo(ok, 0) ThenBlock: { ReturnValue(0) }
        dirp = DawSong.Join(DawSong.root, "untitled")
        ok = DawSong.Mkdir(dirp)
        adir = DawSong.Join(dirp, "audio")
        aok = DawSong.Mkdir(adir)
        DawSong.FreeStr(adir)
        mdir = DawSong.Join(dirp, "midi")
        mok = DawSong.Mkdir(mdir)
        DawSong.FreeStr(mdir)
        pdir = DawSong.Join(dirp, "patches")
        pok = DawSong.Mkdir(pdir)
        DawSong.FreeStr(pdir)
        IfCondition EqualTo(ok, 0) ThenBlock: {
            DawSong.FreeStr(dirp)
            ReturnValue(0)
        }
        IfCondition EqualTo(aok, 0) ThenBlock: {
            DawSong.FreeStr(dirp)
            ReturnValue(0)
        }
        IfCondition EqualTo(mok, 0) ThenBlock: {
            DawSong.FreeStr(dirp)
            ReturnValue(0)
        }
        IfCondition EqualTo(pok, 0) ThenBlock: {
            DawSong.FreeStr(dirp)
            ReturnValue(0)
        }
        DawSong.path = dirp
        ReturnValue(1)
    }
}

Function.DawSong.MkdirSong {
    Input: dirp: Address
    Output: Integer
    Body: {
        ok = DawSong.Mkdir(dirp)
        adir = DawSong.Join(dirp, "audio")
        aok = DawSong.Mkdir(adir)
        DawSong.FreeStr(adir)
        mdir = DawSong.Join(dirp, "midi")
        mok = DawSong.Mkdir(mdir)
        DawSong.FreeStr(mdir)
        pdir = DawSong.Join(dirp, "patches")
        pok = DawSong.Mkdir(pdir)
        DawSong.FreeStr(pdir)
        IfCondition EqualTo(ok, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(aok, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(mok, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(pok, 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(1)
    }
}

Function.DawSong.CopyOne {
    Input: track: Address
    Output: Integer
    Body: {
        nm = DawSong.NameOf(track)
        ok = DawSong.TrackNameOk(nm)
        IfCondition EqualTo(ok, 0) ThenBlock: { ReturnValue(0) }
        pre = DawSong.PresetOf(track)
        blank = DawSong.Blank(pre)
        IfCondition EqualTo(blank, 1) ThenBlock: { ReturnValue(1) }
        src = DawSong.Resolve(pre)
        IfCondition EqualTo(src, 0) ThenBlock: { ReturnValue(0) }
        tmp = DawSong.PatchTmp(nm)
        IfCondition EqualTo(tmp, 0) ThenBlock: {
            DawSong.FreeStr(src)
            ReturnValue(0)
        }
        ok = DawSong.CopyFile(src, tmp)
        IfCondition EqualTo(ok, 0) ThenBlock: {
            DawSong.Unlink(tmp)
            DawSong.FreeStr(src)
            DawSong.FreeStr(tmp)
            ReturnValue(0)
        }
        DawSong.FreeStr(src)
        DawSong.FreeStr(tmp)
        ReturnValue(1)
    }
}

Function.DawSong.CopyPatches {
    Output: Integer
    Body: {
        cur = DawTracks.head
        WhileLoop NotEqual(cur, 0) {
            ok = DawSong.CopyOne(cur)
            IfCondition EqualTo(ok, 0) ThenBlock: { ReturnValue(0) }
            cur = DawSong.NextOf(cur)
        }
        ReturnValue(1)
    }
}

Function.DawSong.ShmState {
    Input: text: Address
    Output: Address
    Body: {
        IfCondition EqualTo(text, 0) ThenBlock: { ReturnValue(0) }
        top = DawSong.Join("/dev/shm/daw", text)
        IfCondition EqualTo(top, 0) ThenBlock: { ReturnValue(0) }
        out = DawSong.Join(top, "state.bin")
        DawSong.FreeStr(top)
        ReturnValue(out)
    }
}

Function.DawSong.StateSrc {
    Input: track: Address
    Output: Address
    Body: {
        hid = DawSong.HostOf(track)
        blank = DawSong.Blank(hid)
        IfCondition EqualTo(blank, 1) ThenBlock: { ReturnValue(0) }
        shm = DawSong.ShmState(hid)
        IfCondition EqualTo(shm, 0) ThenBlock: { ReturnValue(0) }
        sz = DawSong.RegSize(shm)
        IfCondition GreaterEqual(sz, 1) ThenBlock: { ReturnValue(shm) }
        DawSong.FreeStr(shm)
        vs = DawSong.VstOf(track)
        vb = DawSong.Blank(vs)
        IfCondition EqualTo(vb, 1) ThenBlock: { ReturnValue(0) }
        songf = DawSong.Resolve(vs)
        IfCondition EqualTo(songf, 0) ThenBlock: { ReturnValue(0) }
        sz = DawSong.RegSize(songf)
        IfCondition GreaterEqual(sz, 1) ThenBlock: { ReturnValue(songf) }
        DawSong.FreeStr(songf)
        ReturnValue(0)
    }
}

Function.DawSong.CopyState {
    Input: track: Address
    Output: Integer
    Body: {
        vs = DawSong.VstOf(track)
        vb = DawSong.Blank(vs)
        IfCondition EqualTo(vb, 1) ThenBlock: { ReturnValue(1) }
        src = DawSong.StateSrc(track)
        IfCondition EqualTo(src, 0) ThenBlock: { ReturnValue(1) }
        hid = DawSong.HostOf(track)
        tmp = DawSong.PatchJoin(hid, ".bin.tmp")
        IfCondition EqualTo(tmp, 0) ThenBlock: {
            DawSong.FreeStr(src)
            ReturnValue(0)
        }
        ok = DawSong.CopyFile(src, tmp)
        DawSong.FreeStr(src)
        IfCondition EqualTo(ok, 0) ThenBlock: {
            DawSong.Unlink(tmp)
            DawSong.FreeStr(tmp)
            ReturnValue(0)
        }
        fin = DawSong.PatchJoin(hid, ".bin")
        IfCondition EqualTo(fin, 0) ThenBlock: {
            DawSong.Unlink(tmp)
            DawSong.FreeStr(tmp)
            ReturnValue(0)
        }
        code = SystemCall(82, tmp, fin, 0)
        IfCondition LessThan(code, 0) ThenBlock: {
            DawSong.Unlink(tmp)
            DawSong.FreeStr(tmp)
            DawSong.FreeStr(fin)
            ReturnValue(0)
        }
        DawSong.FreeStr(tmp)
        DawSong.FreeStr(fin)
        ReturnValue(1)
    }
}

Function.DawSong.CopyStates {
    Output: Integer
    Body: {
        cur = DawTracks.head
        WhileLoop NotEqual(cur, 0) {
            ok = DawSong.CopyState(cur)
            IfCondition EqualTo(ok, 0) ThenBlock: { ReturnValue(0) }
            cur = DawSong.NextOf(cur)
        }
        ReturnValue(1)
    }
}

Function.DawSong.RenameOne {
    Input: track: Address
    Output: Integer
    Body: {
        nm = DawSong.NameOf(track)
        ok = DawSong.TrackNameOk(nm)
        IfCondition EqualTo(ok, 0) ThenBlock: { ReturnValue(0) }
        pre = DawSong.PresetOf(track)
        blank = DawSong.Blank(pre)
        IfCondition EqualTo(blank, 1) ThenBlock: { ReturnValue(1) }
        tmp = DawSong.PatchTmp(nm)
        fin = DawSong.PatchFinal(nm)
        code = SystemCall(82, tmp, fin, 0)
        DawSong.FreeStr(tmp)
        DawSong.FreeStr(fin)
        IfCondition LessThan(code, 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(1)
    }
}

Function.DawSong.RenamePatches {
    Output: Integer
    Body: {
        cur = DawTracks.head
        WhileLoop NotEqual(cur, 0) {
            ok = DawSong.RenameOne(cur)
            IfCondition EqualTo(ok, 0) ThenBlock: { ReturnValue(0) }
            cur = DawSong.NextOf(cur)
        }
        ReturnValue(1)
    }
}

Function.DawSong.CommitOne {
    Input: track: Address
    Output: Integer
    Body: {
        pre = DawSong.PresetOf(track)
        blank = DawSong.Blank(pre)
        IfCondition EqualTo(blank, 1) ThenBlock: {
            DawTrack.SetPreset(track, DawSong.empty)
            DawTrack.SetLibrary(track, DawSong.empty)
            ReturnValue(1)
        }
        lib = DawSong.LibraryOf(track)
        lb = DawSong.Blank(lib)
        IfCondition EqualTo(lb, 1) ThenBlock: {
            DawTrack.SetLibrary(track, pre)
        }
        ElseBlock: {
            DawTrack.SetLibrary(track, lib)
        }
        nm = DawSong.NameOf(track)
        rel = DawSong.PresetRel(nm)
        IfCondition NotEqual(rel, 0) ThenBlock: {
            DawTrack.SetPreset(track, rel)
            DawSong.FreeStr(rel)
        }
        ReturnValue(1)
    }
}

Function.DawSong.CommitStrings {
    Output: Integer
    Body: {
        cur = DawTracks.head
        WhileLoop NotEqual(cur, 0) {
            DawSong.CommitOne(cur)
            cur = DawSong.NextOf(cur)
        }
        ReturnValue(1)
    }
}

Function.DawSong.CInt {
    Input: clip: Address
    Input: which: Integer
    Output: Integer
    Body: {
        at = PoolFieldOffset(LinkagePool.DawClip, "start")
        IfCondition EqualTo(which, 2) ThenBlock: {
            at = PoolFieldOffset(LinkagePool.DawClip, "length")
        }
        IfCondition EqualTo(which, 3) ThenBlock: {
            at = PoolFieldOffset(LinkagePool.DawClip, "src")
        }
        v = Dereference(Add(clip, at))
        ReturnValue(v)
    }
}

Function.DawSong.CStr {
    Input: clip: Address
    Input: which: Integer
    Output: Address
    Body: {
        at = PoolFieldOffset(LinkagePool.DawClip, "label")
        IfCondition EqualTo(which, 2) ThenBlock: {
            at = PoolFieldOffset(LinkagePool.DawClip, "file")
        }
        p = Dereference(Add(clip, at))
        ReturnValue(p)
    }
}

Function.DawSong.CNext {
    Input: clip: Address
    Output: Address
    Body: {
        at = PoolFieldOffset(LinkagePool.DawClip, "next")
        p = Dereference(Add(clip, at))
        ReturnValue(p)
    }
}

Function.DawSong.NInt {
    Input: note: Address
    Input: which: Integer
    Output: Integer
    Body: {
        at = PoolFieldOffset(LinkagePool.DawNote, "start")
        IfCondition EqualTo(which, 2) ThenBlock: {
            at = PoolFieldOffset(LinkagePool.DawNote, "length")
        }
        IfCondition EqualTo(which, 3) ThenBlock: {
            at = PoolFieldOffset(LinkagePool.DawNote, "pitch")
        }
        v = Dereference(Add(note, at))
        ReturnValue(v)
    }
}

Function.DawSong.NNext {
    Input: note: Address
    Output: Address
    Body: {
        at = PoolFieldOffset(LinkagePool.DawNote, "next")
        p = Dereference(Add(note, at))
        ReturnValue(p)
    }
}

Function.DawSong.BuildClip {
    Input: clip: Address
    Output: Address
    Body: {
        obj = JSON.NewObject()
        hold = JSON.Tag(JType.OBJECT, obj)
        st = DawSong.CInt(clip, 1)
        JSON.SetNumber(obj, "start", st)
        ln = DawSong.CInt(clip, 2)
        JSON.SetNumber(obj, "length", ln)
        srcv = DawSong.CInt(clip, 3)
        JSON.SetNumber(obj, "src", srcv)
        lab = DawSong.CStr(clip, 1)
        ok = DawSong.PutStr(obj, "label", lab)
        IfCondition EqualTo(ok, 0) ThenBlock: {
            gone = DawSong.FailTag(hold)
            ReturnValue(gone)
        }
        fp = DawSong.CStr(clip, 2)
        ok = DawSong.SafeOrEmpty(fp)
        IfCondition EqualTo(ok, 0) ThenBlock: {
            gone = DawSong.FailTag(hold)
            ReturnValue(gone)
        }
        ok = DawSong.PutStr(obj, "file", fp)
        IfCondition EqualTo(ok, 0) ThenBlock: {
            gone = DawSong.FailTag(hold)
            ReturnValue(gone)
        }
        ReturnValue(hold)
    }
}

Function.DawSong.BuildClips {
    Input: track: Address
    Output: Address
    Body: {
        arr = JSON.NewArray()
        cur = DawSong.ClipsOf(track)
        WhileLoop NotEqual(cur, 0) {
            hold = DawSong.BuildClip(cur)
            IfCondition EqualTo(hold, 0) ThenBlock: {
                DawSong.KillArr(arr)
                ReturnValue(0)
            }
            child = JSON.AsObject(hold)
            JSON.PushObject(arr, child)
            Deallocate(hold, 16)
            cur = DawSong.CNext(cur)
        }
        ReturnValue(arr)
    }
}

Function.DawSong.BuildNote {
    Input: note: Address
    Output: Address
    Body: {
        obj = JSON.NewObject()
        hold = JSON.Tag(JType.OBJECT, obj)
        st = DawSong.NInt(note, 1)
        JSON.SetNumber(obj, "start", st)
        ln = DawSong.NInt(note, 2)
        JSON.SetNumber(obj, "length", ln)
        pit = DawSong.NInt(note, 3)
        JSON.SetNumber(obj, "pitch", pit)
        ReturnValue(hold)
    }
}

Function.DawSong.BuildNotes {
    Input: track: Address
    Output: Address
    Body: {
        arr = JSON.NewArray()
        cur = DawSong.NotesOf(track)
        WhileLoop NotEqual(cur, 0) {
            hold = DawSong.BuildNote(cur)
            IfCondition EqualTo(hold, 0) ThenBlock: {
                DawSong.KillArr(arr)
                ReturnValue(0)
            }
            child = JSON.AsObject(hold)
            JSON.PushObject(arr, child)
            Deallocate(hold, 16)
            cur = DawSong.NNext(cur)
        }
        ReturnValue(arr)
    }
}

Function.DawSong.BuildConn {
    Input: wire: Address
    Output: Address
    Body: {
        obj = JSON.NewObject()
        hold = JSON.Tag(JType.OBJECT, obj)
        sp = DawRoute.CSrc(wire)
        sn = DawRoute.PName(sp)
        blank = DawSong.Blank(sn)
        IfCondition EqualTo(blank, 1) ThenBlock: {
            gone = DawSong.FailTag(hold)
            ReturnValue(gone)
        }
        ok = DawSong.PutStr(obj, "src", sn)
        IfCondition EqualTo(ok, 0) ThenBlock: {
            gone = DawSong.FailTag(hold)
            ReturnValue(gone)
        }
        dp = DawRoute.CDst(wire)
        dn = DawRoute.PName(dp)
        blank = DawSong.Blank(dn)
        IfCondition EqualTo(blank, 1) ThenBlock: {
            gone = DawSong.FailTag(hold)
            ReturnValue(gone)
        }
        ok = DawSong.PutStr(obj, "dst", dn)
        IfCondition EqualTo(ok, 0) ThenBlock: {
            gone = DawSong.FailTag(hold)
            ReturnValue(gone)
        }
        kv = DawRoute.CKind(wire)
        JSON.SetNumber(obj, "kind", kv)
        lv = DawRoute.CLoop(wire)
        JSON.SetNumber(obj, "loop", lv)
        dv = DawRoute.CDelay(wire)
        JSON.SetNumber(obj, "delay", dv)
        arr = JSON.NewArray()
        moff = PoolFieldOffset(LinkagePool.DawConn, "map")
        mhead = Dereference(Add(wire, moff))
        noff = PoolFieldOffset(LinkagePool.DawMap, "next")
        soff = PoolFieldOffset(LinkagePool.DawMap, "src_i")
        doff = PoolFieldOffset(LinkagePool.DawMap, "dst_i")
        cur = mhead
        WhileLoop NotEqual(cur, 0) {
            a = Dereference(Add(cur, soff))
            b = Dereference(Add(cur, doff))
            JSON.PushNumber(arr, a)
            JSON.PushNumber(arr, b)
            cur = Dereference(Add(cur, noff))
        }
        JSON.SetArray(obj, "map", arr)
        ReturnValue(hold)
    }
}

Function.DawSong.BuildConns {
    Output: Address
    Body: {
        arr = JSON.NewArray()
        off = PoolFieldOffset(LinkagePool.DawConn, "next")
        cur = DawRoute.conns
        WhileLoop NotEqual(cur, 0) {
            hold = DawSong.BuildConn(cur)
            IfCondition EqualTo(hold, 0) ThenBlock: {
                DawSong.KillArr(arr)
                ReturnValue(0)
            }
            child = JSON.AsObject(hold)
            JSON.PushObject(arr, child)
            Deallocate(hold, 16)
            cur = Dereference(Add(cur, off))
        }
        ReturnValue(arr)
    }
}

Function.DawSong.PutNums {
    Input: obj: Address
    Input: track: Address
    Output: Integer
    Body: {
        v = DawSong.KindOf(track)
        JSON.SetNumber(obj, "kind", v)
        v = DawSong.ViewOf(track)
        JSON.SetNumber(obj, "view", v)
        v = DawSong.ArmOf(track)
        JSON.SetNumber(obj, "arm", v)
        v = DawSong.MuteOf(track)
        JSON.SetNumber(obj, "mute", v)
        v = DawSong.SoloOf(track)
        JSON.SetNumber(obj, "solo", v)
        v = DawSong.FaderOf(track)
        JSON.SetNumber(obj, "fader", v)
        v = DawSong.PanOf(track)
        JSON.SetNumber(obj, "pan", v)
        v = DawSong.FxOf(track)
        JSON.SetNumber(obj, "fx", v)
        ReturnValue(1)
    }
}

Function.DawSong.LibSrc {
    Input: track: Address
    Output: Address
    Body: {
        pre = DawSong.PresetOf(track)
        b0 = DawSong.Blank(pre)
        IfCondition EqualTo(b0, 1) ThenBlock: {
            e = DawSong.Empty()
            ReturnValue(e)
        }
        lib = DawSong.LibraryOf(track)
        b1 = DawSong.Blank(lib)
        IfCondition EqualTo(b1, 0) ThenBlock: { ReturnValue(lib) }
        ReturnValue(pre)
    }
}

Function.DawSong.BuildHost {
    Input: obj: Address
    Input: track: Address
    Output: Integer
    Body: {
        hid = DawSong.HostOf(track)
        blank = DawSong.Blank(hid)
        IfCondition EqualTo(blank, 0) ThenBlock: {
            legal = DawSong.LegalFolder(hid)
            IfCondition EqualTo(legal, 0) ThenBlock: { ReturnValue(0) }
        }
        ok = DawSong.PutStr(obj, "host", hid)
        IfCondition EqualTo(ok, 0) ThenBlock: { ReturnValue(0) }
        plug = DawSong.PluginOf(track)
        safe = DawSong.SafeOrEmpty(plug)
        IfCondition EqualTo(safe, 0) ThenBlock: { ReturnValue(0) }
        ok = DawSong.PutStr(obj, "plugin", plug)
        IfCondition EqualTo(ok, 0) ThenBlock: { ReturnValue(0) }
        vs = DawSong.VstOf(track)
        vb = DawSong.Blank(vs)
        IfCondition EqualTo(vb, 1) ThenBlock: {
            ok = DawSong.PutStr(obj, "vst", 0)
            ReturnValue(ok)
        }
        IfCondition EqualTo(blank, 1) ThenBlock: { ReturnValue(0) }
        rel = DawSong.VstRel(hid)
        IfCondition EqualTo(rel, 0) ThenBlock: { ReturnValue(0) }
        cmp = StringCompare(vs, rel)
        DawSong.FreeStr(rel)
        IfCondition NotEqual(cmp, 0) ThenBlock: { ReturnValue(0) }
        ok = DawSong.PutStr(obj, "vst", vs)
        ReturnValue(ok)
    }
}

Function.DawSong.BuildTrack {
    Input: track: Address
    Output: Address
    Body: {
        obj = JSON.NewObject()
        hold = JSON.Tag(JType.OBJECT, obj)
        nm = DawSong.NameOf(track)
        ok = DawSong.TrackNameOk(nm)
        IfCondition EqualTo(ok, 0) ThenBlock: {
            gone = DawSong.FailTag(hold)
            ReturnValue(gone)
        }
        ok = DawSong.PutStr(obj, "name", nm)
        IfCondition EqualTo(ok, 0) ThenBlock: {
            gone = DawSong.FailTag(hold)
            ReturnValue(gone)
        }
        DawSong.PutNums(obj, track)
        inst = DawSong.InstOf(track)
        ok = DawSong.PutStr(obj, "inst", inst)
        IfCondition EqualTo(ok, 0) ThenBlock: {
            gone = DawSong.FailTag(hold)
            ReturnValue(gone)
        }
        pre = DawSong.PresetOf(track)
        blank = DawSong.Blank(pre)
        IfCondition EqualTo(blank, 1) ThenBlock: {
            ok = DawSong.PutStr(obj, "preset", 0)
            IfCondition EqualTo(ok, 0) ThenBlock: {
                gone = DawSong.FailTag(hold)
                ReturnValue(gone)
            }
        }
        ElseBlock: {
            rel = DawSong.PresetRel(nm)
            safe = DawSong.RelSafe(rel)
            IfCondition EqualTo(safe, 0) ThenBlock: {
                DawSong.FreeStr(rel)
                gone = DawSong.FailTag(hold)
                ReturnValue(gone)
            }
            JSON.SetString(obj, "preset", rel)
        }
        libp = DawSong.LibSrc(track)
        safe = DawSong.RelSafe(libp)
        IfCondition EqualTo(safe, 0) ThenBlock: {
            gone = DawSong.FailTag(hold)
            ReturnValue(gone)
        }
        ok = DawSong.PutStr(obj, "library", libp)
        IfCondition EqualTo(ok, 0) ThenBlock: {
            gone = DawSong.FailTag(hold)
            ReturnValue(gone)
        }
        pk = DawSong.PackOf(track)
        safe = DawSong.SafeOrEmpty(pk)
        IfCondition EqualTo(safe, 0) ThenBlock: {
            gone = DawSong.FailTag(hold)
            ReturnValue(gone)
        }
        ok = DawSong.PutStr(obj, "pack", pk)
        IfCondition EqualTo(ok, 0) ThenBlock: {
            gone = DawSong.FailTag(hold)
            ReturnValue(gone)
        }
        md = DawSong.MidiOf(track)
        safe = DawSong.SafeOrEmpty(md)
        IfCondition EqualTo(safe, 0) ThenBlock: {
            gone = DawSong.FailTag(hold)
            ReturnValue(gone)
        }
        ok = DawSong.PutStr(obj, "midi", md)
        IfCondition EqualTo(ok, 0) ThenBlock: {
            gone = DawSong.FailTag(hold)
            ReturnValue(gone)
        }
        ok = DawSong.BuildHost(obj, track)
        IfCondition EqualTo(ok, 0) ThenBlock: {
            gone = DawSong.FailTag(hold)
            ReturnValue(gone)
        }
        clips = DawSong.BuildClips(track)
        IfCondition EqualTo(clips, 0) ThenBlock: {
            gone = DawSong.FailTag(hold)
            ReturnValue(gone)
        }
        JSON.SetArray(obj, "clips", clips)
        notes = DawSong.BuildNotes(track)
        IfCondition EqualTo(notes, 0) ThenBlock: {
            gone = DawSong.FailTag(hold)
            ReturnValue(gone)
        }
        JSON.SetArray(obj, "notes", notes)
        auto = JSON.NewArray()
        JSON.SetArray(obj, "automation", auto)
        ReturnValue(hold)
    }
}

Function.DawSong.BuildTracks {
    Output: Address
    Body: {
        arr = JSON.NewArray()
        cur = DawTracks.head
        WhileLoop NotEqual(cur, 0) {
            hold = DawSong.BuildTrack(cur)
            IfCondition EqualTo(hold, 0) ThenBlock: {
                DawSong.KillArr(arr)
                ReturnValue(0)
            }
            child = JSON.AsObject(hold)
            JSON.PushObject(arr, child)
            Deallocate(hold, 16)
            cur = DawSong.NextOf(cur)
        }
        ReturnValue(arr)
    }
}

Function.DawSong.Build {
    Output: Address
    Body: {
        IfCondition EqualTo(DawSong.path, 0) ThenBlock: { ReturnValue(0) }
        obj = JSON.NewObject()
        hold = JSON.Tag(JType.OBJECT, obj)
        JSON.SetNumber(obj, "version", 1)
        base = DawSong.Base(DawSong.path)
        ok = DawSong.PutStr(obj, "name", base)
        IfCondition EqualTo(ok, 0) ThenBlock: {
            gone = DawSong.FailTag(hold)
            ReturnValue(gone)
        }
        safe = DawSong.SafeOrEmpty(DawSong.song)
        IfCondition EqualTo(safe, 0) ThenBlock: {
            gone = DawSong.FailTag(hold)
            ReturnValue(gone)
        }
        ok = DawSong.PutStr(obj, "song", DawSong.song)
        IfCondition EqualTo(ok, 0) ThenBlock: {
            gone = DawSong.FailTag(hold)
            ReturnValue(gone)
        }
        JSON.SetNumber(obj, "master_l", DawCon.ml)
        JSON.SetNumber(obj, "master_r", DawCon.mr)
        JSON.SetNumber(obj, "play", DawTracks.play)
        JSON.SetNumber(obj, "zoom", DawTracks.zoom)
        JSON.SetNumber(obj, "rule", 0)
        JSON.SetNumber(obj, "host_seq", DawSong.hseq)
        tracks = DawSong.BuildTracks()
        IfCondition EqualTo(tracks, 0) ThenBlock: {
            gone = DawSong.FailTag(hold)
            ReturnValue(gone)
        }
        JSON.SetArray(obj, "tracks", tracks)
        cords = DawSong.BuildConns()
        IfCondition EqualTo(cords, 0) ThenBlock: {
            gone = DawSong.FailTag(hold)
            ReturnValue(gone)
        }
        JSON.SetArray(obj, "conns", cords)
        ReturnValue(hold)
    }
}

Function.DawSong.Save {
    Output: Integer
    Body: {
        DawSong.Boot()
        made = 0
        IfCondition EqualTo(DawSong.path, 0) ThenBlock: {
            made = DawSong.EnsureUntitled()
            IfCondition EqualTo(made, 0) ThenBlock: {
                r = DawSong.AbortSave(0, 0)
                ReturnValue(r)
            }
        }
        ElseBlock: {
            dirp = DawSong.Join(DawSong.path, "patches")
            made = DawSong.Mkdir(dirp)
            DawSong.FreeStr(dirp)
            IfCondition EqualTo(made, 0) ThenBlock: {
                r = DawSong.AbortSave(0, 0)
                ReturnValue(r)
            }
        }
        made = DawSong.CopyPatches()
        IfCondition EqualTo(made, 0) ThenBlock: {
            r = DawSong.AbortSave(0, 0)
            ReturnValue(r)
        }
        made = DawSong.CopyStates()
        IfCondition EqualTo(made, 0) ThenBlock: {
            r = DawSong.AbortSave(0, 0)
            ReturnValue(r)
        }
        hold = DawSong.Build()
        IfCondition EqualTo(hold, 0) ThenBlock: {
            r = DawSong.AbortSave(0, 0)
            ReturnValue(r)
        }
        text = JSON.Serialize(hold)
        IfCondition EqualTo(text, 0) ThenBlock: {
            r = DawSong.AbortSave(hold, 0)
            ReturnValue(r)
        }
        tmp = DawSong.Join(DawSong.path, "session.json.tmp")
        made = DawSong.WriteText(tmp, text)
        IfCondition EqualTo(made, 0) ThenBlock: {
            DawSong.FreeStr(tmp)
            r = DawSong.AbortSave(hold, text)
            ReturnValue(r)
        }
        made = DawSong.RenamePatches()
        IfCondition EqualTo(made, 0) ThenBlock: {
            DawSong.FreeStr(tmp)
            r = DawSong.AbortSave(hold, text)
            ReturnValue(r)
        }
        fin = DawSong.Join(DawSong.path, "session.json")
        code = SystemCall(82, tmp, fin, 0)
        DawSong.FreeStr(tmp)
        IfCondition LessThan(code, 0) ThenBlock: {
            DawSong.FreeStr(fin)
            r = DawSong.AbortSave(hold, text)
            ReturnValue(r)
        }
        oldf = DawSong.file
        DawSong.file = fin
        IfCondition NotEqual(oldf, 0) ThenBlock: { DawSong.FreeStr(oldf) }
        DawSong.CommitStrings()
        DawSong.FreeStr(text)
        JSON.Free(hold)
        DawSong.err = "saved"
        PrintMessage("save ok\n")
        PrintNumber(DawTracks.n)
        PrintMessage("\n")
        PrintMessage(DawSong.path)
        PrintMessage("\n")
        ReturnValue(1)
    }
}

// Chain, scrolls, and the monitor. Caller owns path, file, and song.
Function.DawSong.ClearChain {
    Output: Integer
    Body: {
        WhileLoop NotEqual(DawTracks.head, 0) {
            DawTrack.Remove(DawTracks.head)
        }
        DawTracks.head = 0
        DawTracks.n = 0
        DawTracks.sel = 0
        DawRoute.rule = 1
        DawRoute.Monitor()
        DawTracks.arr_x = 0
        DawTracks.arr_y = 0
        DawTracks.edit_x = 0
        DawTracks.edit_y = 42
        DawTracks.con_y = 0
        DawRoute.scroll = 0
        DawTracks.play = 360
        DawTracks.zoom = 100
        DawCon.ml = 700
        DawCon.mr = 700
        DawBoard.has = 0
        DawBoard.sel = 0
        DawRoute.sel = 0
        DawRoute.menu = 0
        DawRoute.src = 0
        DawRoute.gkind = -1
        DawSong.on = 0
        DawSong.neu = 0
        DawSong.hot = -1
        DawSong.hseq = 0
        ReturnValue(1)
    }
}

Function.DawSong.Close {
    Output: Integer
    Body: {
        DawSong.ClearChain()
        oldp = DawSong.path
        oldf = DawSong.file
        olds = DawSong.song
        DawSong.path = 0
        DawSong.file = 0
        DawSong.song = 0
        IfCondition NotEqual(oldp, 0) ThenBlock: { DawSong.FreeStr(oldp) }
        IfCondition NotEqual(oldf, 0) ThenBlock: { DawSong.FreeStr(oldf) }
        IfCondition NotEqual(olds, 0) ThenBlock: { DawSong.FreeStr(olds) }
        DawSong.err = "closed"
        DawSong.kick = 1
        PrintMessage("close ok\n")
        PrintNumber(DawTracks.n)
        PrintMessage("\n")
        ReturnValue(1)
    }
}

Function.DawSong.OptPtr {
    Input: obj: Address
    Input: key: Address
    Output: Address
    Body: {
        ty = JSON.GetType(obj, key)
        IfCondition EqualTo(ty, JType.STRING) ThenBlock: {
            s = JSON.GetString(obj, key)
            IfCondition EqualTo(s, 0) ThenBlock: {
                e = DawSong.Empty()
                ReturnValue(e)
            }
            ReturnValue(s)
        }
        e = DawSong.Empty()
        ReturnValue(e)
    }
}

Function.DawSong.PutInts {
    Input: track: Address
    Input: obj: Address
    Output: Integer
    Body: {
        ok = DawSong.Num(obj, "arm")
        v = DawSong.num
        DawTrack.SetArm(track, v)
        ok = DawSong.Num(obj, "mute")
        v = DawSong.num
        DawTrack.SetMute(track, v)
        ok = DawSong.Num(obj, "solo")
        v = DawSong.num
        DawTrack.SetSolo(track, v)
        ok = DawSong.Num(obj, "fader")
        v = DawSong.num
        DawTrack.SetFader(track, v)
        ok = DawSong.Num(obj, "pan")
        v = DawSong.num
        DawTrack.SetPan(track, v)
        ok = DawSong.Num(obj, "fx")
        v = DawSong.num
        DawTrack.SetFx(track, v)
        ReturnValue(ok)
    }
}

Function.DawSong.PutStrs {
    Input: track: Address
    Input: obj: Address
    Output: Integer
    Body: {
        s = DawSong.OptPtr(obj, "preset")
        DawTrack.SetPreset(track, s)
        s = DawSong.OptPtr(obj, "library")
        DawTrack.SetLibrary(track, s)
        s = DawSong.OptPtr(obj, "pack")
        DawTrack.SetPack(track, s)
        s = DawSong.OptPtr(obj, "midi")
        DawTrack.SetMidi(track, s)
        s = DawSong.OptPtr(obj, "host")
        DawTrack.SetHost(track, s)
        s = DawSong.OptPtr(obj, "plugin")
        DawTrack.SetPlugin(track, s)
        s = DawSong.OptPtr(obj, "vst")
        DawTrack.SetVst(track, s)
        ReturnValue(1)
    }
}

Function.DawSong.AddClips {
    Input: track: Address
    Input: arr: Address
    Output: Integer
    Body: {
        count = JSON.ArrayLength(arr)
        idx = 0
        WhileLoop LessThan(idx, count) {
            tagged = JSON.ArrayGet(arr, idx)
            obj = JSON.AsObject(tagged)
            ok = DawSong.Num(obj, "start")
            st = DawSong.num
            ok = DawSong.Num(obj, "length")
            ln = DawSong.num
            ok = DawSong.Num(obj, "src")
            srcv = DawSong.num
            lab = DawSong.NeedStr(obj, "label")
            IfCondition EqualTo(lab, 0) ThenBlock: { lab = DawSong.Empty() }
            clip = DawClip.Add(track, st, ln, srcv, lab)
            IfCondition EqualTo(clip, 0) ThenBlock: { ReturnValue(0) }
            fp = DawSong.OptPtr(obj, "file")
            DawClip.SetFile(clip, fp)
            idx = Add(idx, 1)
        }
        ReturnValue(1)
    }
}

Function.DawSong.AddNotes {
    Input: track: Address
    Input: arr: Address
    Output: Integer
    Body: {
        count = JSON.ArrayLength(arr)
        idx = 0
        WhileLoop LessThan(idx, count) {
            tagged = JSON.ArrayGet(arr, idx)
            obj = JSON.AsObject(tagged)
            ok = DawSong.Num(obj, "start")
            st = DawSong.num
            ok = DawSong.Num(obj, "length")
            ln = DawSong.num
            ok = DawSong.Num(obj, "pitch")
            pit = DawSong.num
            note = DawNote.Add(track, st, ln, pit)
            IfCondition EqualTo(note, 0) ThenBlock: { ReturnValue(0) }
            idx = Add(idx, 1)
        }
        ReturnValue(1)
    }
}

Function.DawSong.AddOne {
    Input: obj: Address
    Output: Address
    Body: {
        nm = DawSong.NeedStr(obj, "name")
        IfCondition EqualTo(nm, 0) ThenBlock: { ReturnValue(0) }
        ok = DawSong.Num(obj, "kind")
        kv = DawSong.num
        ok = DawSong.Num(obj, "view")
        vv = DawSong.num
        inst = DawSong.NeedStr(obj, "inst")
        IfCondition EqualTo(inst, 0) ThenBlock: { inst = DawSong.Empty() }
        t = DawTrack.Add(nm, kv, vv, inst)
        IfCondition EqualTo(t, 0) ThenBlock: { ReturnValue(0) }
        DawSong.PutInts(t, obj)
        DawSong.PutStrs(t, obj)
        clips = JSON.GetArray(obj, "clips")
        ok = DawSong.AddClips(t, clips)
        IfCondition EqualTo(ok, 0) ThenBlock: { ReturnValue(0) }
        notes = JSON.GetArray(obj, "notes")
        ok = DawSong.AddNotes(t, notes)
        IfCondition EqualTo(ok, 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(t)
    }
}

Function.DawSong.Rollback {
    Input: oldh: Address
    Input: oldn: Integer
    Input: olds: Address
    Input: oldr: Integer
    Output: Integer
    Body: {
        WhileLoop NotEqual(DawTracks.head, 0) {
            DawTrack.Remove(DawTracks.head)
        }
        DawTracks.head = oldh
        DawTracks.n = oldn
        DawTracks.sel = olds
        DawRoute.rule = oldr
        ReturnValue(0)
    }
}

Function.DawSong.DropOld {
    Input: oldh: Address
    Output: Integer
    Body: {
        cur = oldh
        WhileLoop NotEqual(cur, 0) {
            nxt = DawSong.NextOf(cur)
            DawRoute.Drop(cur)
            cur = nxt
        }
        ReturnValue(1)
    }
}

Function.DawSong.ApplyMap {
    Input: cable: Address
    Input: obj: Address
    Output: Integer
    Body: {
        arr = JSON.GetArray(obj, "map")
        mlen = JSON.ArrayLength(arr)
        idx = 0
        WhileLoop LessThan(idx, mlen) {
            t0 = JSON.ArrayGet(arr, idx)
            a = JSON.AsNumber(t0)
            j = Add(idx, 1)
            t1 = JSON.ArrayGet(arr, j)
            b = JSON.AsNumber(t1)
            DawRoute.Map(cable, a, b)
            idx = Add(idx, 2)
        }
        ReturnValue(1)
    }
}

Function.DawSong.ApplyCord {
    Input: obj: Address
    Output: Integer
    Body: {
        srcs = JSON.GetString(obj, "src")
        dsts = JSON.GetString(obj, "dst")
        sp = DawRoute.FindName(srcs)
        dp = DawRoute.FindName(dsts)
        IfCondition EqualTo(sp, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(dp, 0) ThenBlock: { ReturnValue(0) }
        ok = DawSong.Num(obj, "kind")
        kv = DawSong.num
        ok = DawSong.Num(obj, "loop")
        lv = DawSong.num
        ok = DawSong.Num(obj, "delay")
        dv = DawSong.num
        cable = DawRoute.Connect(sp, dp, kv)
        DawSong.ApplyMap(cable, obj)
        DawRoute.SetLoop(cable, lv)
        DawRoute.SetDelay(cable, dv)
        ReturnValue(1)
    }
}

Function.DawSong.ApplyConns {
    Input: arr: Address
    Output: Integer
    Body: {
        said = 0
        count = JSON.ArrayLength(arr)
        idx = 0
        WhileLoop LessThan(idx, count) {
            tagged = JSON.ArrayGet(arr, idx)
            obj = JSON.AsObject(tagged)
            hit = DawSong.ApplyCord(obj)
            IfCondition EqualTo(hit, 0) ThenBlock: {
                IfCondition EqualTo(said, 0) ThenBlock: {
                    PrintMessage("slot missing\n")
                    said = 1
                }
            }
            idx = Add(idx, 1)
        }
        ReturnValue(1)
    }
}

Function.DawSong.Apply {
    Input: obj: Address
    Output: Integer
    Body: {
        oldh = DawTracks.head
        oldn = DawTracks.n
        olds = DawTracks.sel
        oldr = DawRoute.rule
        DawTracks.head = 0
        DawTracks.n = 0
        DawTracks.sel = 0
        ok = DawSong.Num(obj, "rule")
        frule = DawSong.num
        DawRoute.rule = frule
        tracks = JSON.GetArray(obj, "tracks")
        nt = JSON.ArrayLength(tracks)
        idx = 0
        fail = 0
        WhileLoop LessThan(idx, nt) {
            tagged = JSON.ArrayGet(tracks, idx)
            tobj = JSON.AsObject(tagged)
            t = DawSong.AddOne(tobj)
            IfCondition EqualTo(t, 0) ThenBlock: {
                fail = 1
                idx = nt
            }
            ElseBlock: { idx = Add(idx, 1) }
        }
        IfCondition EqualTo(fail, 1) ThenBlock: {
            r = DawSong.Rollback(oldh, oldn, olds, oldr)
            ReturnValue(r)
        }
        DawSong.DropOld(oldh)
        DawRoute.UnlinkLoose()
        IfCondition EqualTo(frule, 0) ThenBlock: {
            cords = JSON.GetArray(obj, "conns")
            DawSong.ApplyConns(cords)
        }
        ElseBlock: { DawRoute.Monitor() }
        DawRoute.rule = 1
        ok = DawSong.Num(obj, "master_l")
        mlv = DawSong.num
        ok = DawSong.Num(obj, "master_r")
        mrv = DawSong.num
        ok = DawSong.Num(obj, "play")
        playv = DawSong.num
        ok = DawSong.Num(obj, "zoom")
        zoomv = DawSong.num
        DawCon.ml = mlv
        DawCon.mr = mrv
        DawTracks.play = playv
        DawTracks.zoom = zoomv
        DawTracks.sel = DawTracks.head
        IfCondition NotEqual(DawTracks.head, 0) ThenBlock: {
            DawEditor.Show(DawTracks.head)
        }
        DawTracks.arr_x = 0
        DawTracks.arr_y = 0
        DawTracks.edit_x = 0
        DawTracks.edit_y = 42
        DawTracks.con_y = 0
        DawRoute.scroll = 0
        DawBoard.has = 0
        DawBoard.sel = 0
        DawRoute.sel = 0
        DawRoute.menu = 0
        ty = JSON.GetType(obj, "host_seq")
        seqv = 0
        IfCondition EqualTo(ty, JType.NUMBER) ThenBlock: {
            seqv = JSON.GetNumber(obj, "host_seq")
        }
        DawSong.hseq = seqv
        ReturnValue(1)
    }
}

Function.DawSong.BadJson {
    Output: Integer
    Body: {
        DawSong.err = "bad json"
        PrintMessage("open bad\n")
        PrintMessage("bad json\n")
        ReturnValue(0)
    }
}

Function.DawSong.BadVersion {
    Output: Integer
    Body: {
        DawSong.err = "bad version"
        PrintMessage("open version\n")
        PrintMessage("bad version\n")
        ReturnValue(0)
    }
}

Function.DawSong.Miss {
    Output: Integer
    Body: {
        DawSong.err = "missing"
        PrintMessage("open miss\n")
        PrintMessage("missing\n")
        ReturnValue(0)
    }
}

Function.DawSong.LoadFail {
    Input: tagged: Address
    Input: buf: Address
    Input: sz: Integer
    Input: full: Address
    Input: code: Integer
    Output: Integer
    Body: {
        IfCondition NotEqual(tagged, 0) ThenBlock: { JSON.Free(tagged) }
        DawSong.FreeBuf(buf, sz)
        DawSong.FreeStr(full)
        IfCondition EqualTo(code, 1) ThenBlock: {
            r = DawSong.Miss()
            ReturnValue(r)
        }
        IfCondition EqualTo(code, 2) ThenBlock: {
            r = DawSong.BadVersion()
            ReturnValue(r)
        }
        r = DawSong.BadJson()
        ReturnValue(r)
    }
}

Function.DawSong.Load {
    Input: folder: Address
    Output: Integer
    Body: {
        DawSong.Boot()
        ok = DawSong.LegalFolder(folder)
        IfCondition EqualTo(ok, 0) ThenBlock: {
            r = DawSong.BadJson()
            ReturnValue(r)
        }
        dirp = DawSong.Join(DawSong.root, folder)
        full = DawSong.Join(dirp, "session.json")
        DawSong.FreeStr(dirp)
        sz = DawSong.FileSize(full)
        IfCondition EqualTo(sz, -2) ThenBlock: {
            DawSong.FreeStr(full)
            r = DawSong.Miss()
            ReturnValue(r)
        }
        IfCondition LessThan(sz, 1) ThenBlock: {
            DawSong.FreeStr(full)
            r = DawSong.BadJson()
            ReturnValue(r)
        }
        buf = DawSong.ReadFile(full, sz)
        IfCondition EqualTo(buf, 0) ThenBlock: {
            DawSong.FreeStr(full)
            r = DawSong.BadJson()
            ReturnValue(r)
        }
        tagged = ParseJSON(buf)
        obj = JSON.AsObject(tagged)
        IfCondition EqualTo(obj, 0) ThenBlock: {
            r = DawSong.LoadFail(tagged, buf, sz, full, 0)
            ReturnValue(r)
        }
        ate = DawSong.Consumed(buf, sz)
        IfCondition EqualTo(ate, 0) ThenBlock: {
            r = DawSong.LoadFail(tagged, buf, sz, full, 0)
            ReturnValue(r)
        }
        ok = DawSong.CheckAll(obj, folder)
        IfCondition EqualTo(ok, 0) ThenBlock: {
            code = 0
            IfCondition EqualTo(DawSong.why, 1) ThenBlock: { code = 2 }
            r = DawSong.LoadFail(tagged, buf, sz, full, code)
            ReturnValue(r)
        }
        ok = DawSong.Apply(obj)
        IfCondition EqualTo(ok, 0) ThenBlock: {
            r = DawSong.LoadFail(tagged, buf, sz, full, 0)
            ReturnValue(r)
        }
        oldp = DawSong.path
        oldf = DawSong.file
        np = DawSong.Join(DawSong.root, folder)
        DawSong.path = np
        DawSong.file = full
        IfCondition NotEqual(oldp, 0) ThenBlock: { DawSong.FreeStr(oldp) }
        IfCondition NotEqual(oldf, 0) ThenBlock: { DawSong.FreeStr(oldf) }
        sg = JSON.GetString(obj, "song")
        ns = DawSong.CopyStr(sg)
        olds = DawSong.song
        DawSong.song = ns
        IfCondition NotEqual(olds, 0) ThenBlock: { DawSong.FreeStr(olds) }
        DawSong.err = "opened"
        PrintMessage("open ok\n")
        PrintNumber(DawTracks.n)
        PrintMessage("\n")
        PrintMessage(DawSong.path)
        PrintMessage("\n")
        PrintMessage("opened\n")
        DawSong.kick = 1
        JSON.Free(tagged)
        DawSong.FreeBuf(buf, sz)
        ReturnValue(1)
    }
}

Function.DawSong.Slot {
    Input: index: Integer
    Output: Address
    Body: {
        IfCondition EqualTo(DawSong.names, 0) ThenBlock: { ReturnValue(0) }
        off = Multiply(index, 64)
        p = Add(DawSong.names, off)
        ReturnValue(p)
    }
}

Function.DawSong.TakeName {
    Input: src: Address
    Output: Integer
    Body: {
        IfCondition GreaterEqual(DawSong.n, 32) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(DawSong.names, 0) ThenBlock: { ReturnValue(0) }
        slot = DawSong.Slot(DawSong.n)
        IfCondition EqualTo(slot, 0) ThenBlock: { ReturnValue(0) }
        idx = 0
        run = 1
        WhileLoop EqualTo(run, 1) {
            IfCondition GreaterEqual(idx, 40) ThenBlock: { run = 0 }
            ElseBlock: {
                ch = GetByte(src, idx)
                SetByte(slot, idx, ch)
                IfCondition EqualTo(ch, 0) ThenBlock: { run = 0 }
                ElseBlock: { idx = Add(idx, 1) }
            }
        }
        SetByte(slot, 40, 0)
        ok = DawSong.LegalFolder(slot)
        IfCondition EqualTo(ok, 0) ThenBlock: { ReturnValue(0) }
        PrintMessage("song ")
        PrintMessage(slot)
        PrintMessage("\n")
        DawSong.n = Add(DawSong.n, 1)
        ReturnValue(1)
    }
}

Function.DawSong.List {
    Output: Integer
    Body: {
        DawSong.n = 0
        IfCondition EqualTo(DawSong.names, 0) ThenBlock: {
            cap = Allocate(2048)
            IfCondition EqualTo(cap, 0) ThenBlock: { ReturnValue(0) }
            DawSong.names = cap
        }
        fd = SystemCall(2, DawSong.root, 0, 0)
        IfCondition LessThan(fd, 0) ThenBlock: { ReturnValue(0) }
        buf = Allocate(4096)
        IfCondition EqualTo(buf, 0) ThenBlock: {
            SystemCall(3, fd, 0, 0)
            ReturnValue(0)
        }
        run = 1
        WhileLoop EqualTo(run, 1) {
            nread = SystemCall(217, fd, buf, 4096)
            IfCondition LessEqual(nread, 0) ThenBlock: { run = 0 }
            ElseBlock: {
                pos = 0
                WhileLoop LessThan(pos, nread) {
                    p16 = Add(pos, 16)
                    p17 = Add(pos, 17)
                    lo = GetByte(buf, p16)
                    hi = GetByte(buf, p17)
                    reclen = Add(lo, Multiply(hi, 256))
                    IfCondition LessThan(reclen, 20) ThenBlock: { pos = nread }
                    ElseBlock: {
                        p18 = Add(pos, 18)
                        dtype = GetByte(buf, p18)
                        take = 0
                        IfCondition EqualTo(dtype, 4) ThenBlock: { take = 1 }
                        IfCondition EqualTo(dtype, 10) ThenBlock: { take = 1 }
                        IfCondition EqualTo(take, 1) ThenBlock: {
                            p19 = Add(pos, 19)
                            nm = Add(buf, p19)
                            DawSong.TakeName(nm)
                        }
                        pos = Add(pos, reclen)
                    }
                }
            }
        }
        SystemCall(3, fd, 0, 0)
        Deallocate(buf, 4096)
        ReturnValue(DawSong.n)
    }
}

Function.DawSong.OpenAsk {
    Output: Integer
    Body: {
        DawSong.Boot()
        DawSong.neu = 0
        count = DawSong.List()
        vis = count
        IfCondition GreaterThan(vis, 8) ThenBlock: { vis = 8 }
        DawSong.shown = vis
        DawSong.ph = Add(48, Multiply(vis, 24))
        DawSong.pw = 360
        span = Subtract(FB.width, DawSong.pw)
        half = Divide(span, 2)
        DawSong.px = half
        IfCondition LessThan(DawSong.px, 0) ThenBlock: { DawSong.px = 0 }
        span = Subtract(FB.height, DawSong.ph)
        half = Divide(span, 2)
        DawSong.py = half
        IfCondition LessThan(DawSong.py, 0) ThenBlock: { DawSong.py = 0 }
        DawSong.hot = -1
        DawSong.on = 1
        PrintMessage("list ")
        PrintNumber(count)
        PrintMessage("\n")
        PrintMessage("panel ")
        PrintNumber(DawSong.px)
        PrintMessage(" ")
        PrintNumber(DawSong.py)
        PrintMessage(" ")
        PrintNumber(DawSong.shown)
        PrintMessage("\n")
        ReturnValue(1)
    }
}

Function.DawSong.RowAt {
    Input: mx: Integer
    Input: my: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(mx, DawSong.px) ThenBlock: { ReturnValue(-3) }
        right = Add(DawSong.px, DawSong.pw)
        IfCondition GreaterEqual(mx, right) ThenBlock: { ReturnValue(-3) }
        IfCondition LessThan(my, DawSong.py) ThenBlock: { ReturnValue(-3) }
        bot = Add(DawSong.py, DawSong.ph)
        IfCondition GreaterEqual(my, bot) ThenBlock: { ReturnValue(-3) }
        rel = Subtract(my, DawSong.py)
        IfCondition LessThan(rel, 28) ThenBlock: { ReturnValue(-1) }
        band = Add(28, Multiply(DawSong.shown, 24))
        IfCondition GreaterEqual(rel, band) ThenBlock: { ReturnValue(-2) }
        row = Divide(Subtract(rel, 28), 24)
        IfCondition LessThan(row, 0) ThenBlock: { ReturnValue(-2) }
        IfCondition GreaterEqual(row, DawSong.shown) ThenBlock: { ReturnValue(-2) }
        ReturnValue(row)
    }
}

Function.DawSong.ClearWord {
    Output: Integer
    Body: {
        IfCondition EqualTo(DawSong.word, 0) ThenBlock: { ReturnValue(0) }
        buf = DawSong.word
        SetByte(buf, 0, 0)
        DawSong.wn = 0
        ReturnValue(1)
    }
}

Function.DawSong.Type {
    Input: ch: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(DawSong.word, 0) ThenBlock: { ReturnValue(0) }
        buf = DawSong.word
        at = DawSong.wn
        IfCondition EqualTo(ch, 8) ThenBlock: {
            IfCondition GreaterThan(at, 0) ThenBlock: {
                at = Subtract(at, 1)
                DawSong.wn = at
                SetByte(buf, at, 0)
            }
            ReturnValue(1)
        }
        IfCondition GreaterEqual(at, 32) ThenBlock: { ReturnValue(0) }
        good = 0
        IfCondition GreaterEqual(ch, 48) ThenBlock: {
            IfCondition LessEqual(ch, 57) ThenBlock: { good = 1 }
        }
        IfCondition GreaterEqual(ch, 65) ThenBlock: {
            IfCondition LessEqual(ch, 90) ThenBlock: { good = 1 }
        }
        IfCondition GreaterEqual(ch, 97) ThenBlock: {
            IfCondition LessEqual(ch, 122) ThenBlock: { good = 1 }
        }
        IfCondition EqualTo(ch, 95) ThenBlock: { good = 1 }
        IfCondition EqualTo(ch, 45) ThenBlock: { good = 1 }
        IfCondition EqualTo(good, 0) ThenBlock: { ReturnValue(0) }
        SetByte(buf, at, ch)
        at = Add(at, 1)
        DawSong.wn = at
        SetByte(buf, at, 0)
        ReturnValue(1)
    }
}

Function.DawSong.Glyph {
    Input: idx: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(idx, 26) ThenBlock: {
            ch = Add(97, idx)
            ReturnValue(ch)
        }
        IfCondition LessThan(idx, 36) ThenBlock: {
            ch = Add(22, idx)
            ReturnValue(ch)
        }
        IfCondition EqualTo(idx, 36) ThenBlock: { ReturnValue(95) }
        ReturnValue(45)
    }
}

Function.DawSong.KeyCol {
    Input: idx: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(idx, 13) ThenBlock: { ReturnValue(idx) }
        IfCondition LessThan(idx, 26) ThenBlock: {
            col = Subtract(idx, 13)
            ReturnValue(col)
        }
        col = Subtract(idx, 26)
        ReturnValue(col)
    }
}

Function.DawSong.KeyRow {
    Input: idx: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(idx, 13) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(idx, 26) ThenBlock: { ReturnValue(1) }
        ReturnValue(2)
    }
}

Function.DawSong.KeyX {
    Input: idx: Integer
    Output: Integer
    Body: {
        col = DawSong.KeyCol(idx)
        step = Multiply(col, 30)
        left = Add(DawSong.px, 16)
        at = Add(left, step)
        ReturnValue(at)
    }
}

Function.DawSong.KeyY {
    Input: idx: Integer
    Output: Integer
    Body: {
        row = DawSong.KeyRow(idx)
        step = Multiply(row, 28)
        top = Add(DawSong.py, 56)
        at = Add(top, step)
        ReturnValue(at)
    }
}

Function.DawSong.NameAt {
    Input: mx: Integer
    Input: my: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(mx, DawSong.px) ThenBlock: { ReturnValue(-3) }
        right = Add(DawSong.px, DawSong.pw)
        IfCondition GreaterEqual(mx, right) ThenBlock: { ReturnValue(-3) }
        IfCondition LessThan(my, DawSong.py) ThenBlock: { ReturnValue(-3) }
        bot = Add(DawSong.py, DawSong.ph)
        IfCondition GreaterEqual(my, bot) ThenBlock: { ReturnValue(-3) }
        rely = Subtract(my, DawSong.py)
        IfCondition LessThan(rely, 28) ThenBlock: { ReturnValue(-1) }
        IfCondition GreaterEqual(rely, 56) ThenBlock: {
            IfCondition LessThan(rely, 134) ThenBlock: {
                rowrel = Subtract(rely, 56)
                row = Divide(rowrel, 28)
                rem = Subtract(rowrel, Multiply(row, 28))
                IfCondition LessThan(rem, 22) ThenBlock: {
                    IfCondition LessThan(row, 3) ThenBlock: {
                        relx = Subtract(mx, DawSong.px)
                        IfCondition GreaterEqual(relx, 16) ThenBlock: {
                            colspace = Subtract(relx, 16)
                            col = Divide(colspace, 30)
                            crem = Subtract(colspace, Multiply(col, 30))
                            IfCondition LessThan(crem, 28) ThenBlock: {
                                IfCondition LessThan(row, 2) ThenBlock: {
                                    IfCondition LessThan(col, 13) ThenBlock: {
                                        idx = Add(Multiply(row, 13), col)
                                        ReturnValue(idx)
                                    }
                                }
                                IfCondition EqualTo(row, 2) ThenBlock: {
                                    IfCondition LessThan(col, 12) ThenBlock: {
                                        idx = Add(26, col)
                                        ReturnValue(idx)
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        IfCondition GreaterEqual(rely, 134) ThenBlock: {
            IfCondition LessThan(rely, 158) ThenBlock: {
                relx = Subtract(mx, DawSong.px)
                IfCondition GreaterEqual(relx, 16) ThenBlock: {
                    IfCondition LessThan(relx, 126) ThenBlock: { ReturnValue(38) }
                }
                IfCondition GreaterEqual(relx, 140) ThenBlock: {
                    IfCondition LessThan(relx, 220) ThenBlock: { ReturnValue(39) }
                }
                IfCondition GreaterEqual(relx, 232) ThenBlock: {
                    IfCondition LessThan(relx, 342) ThenBlock: { ReturnValue(40) }
                }
            }
        }
        ReturnValue(-4)
    }
}

Function.DawSong.Create {
    Output: Integer
    Body: {
        made = DawSong.Boot()
        IfCondition EqualTo(made, 0) ThenBlock: {
            DawSong.err = "new fail"
            PrintMessage("new fail\n")
            ReturnValue(0)
        }
        legal = DawSong.LegalFolder(DawSong.word)
        IfCondition EqualTo(legal, 0) ThenBlock: {
            PrintMessage("new bad\n")
            ReturnValue(0)
        }
        dirp = DawSong.Join(DawSong.root, DawSong.word)
        IfCondition EqualTo(dirp, 0) ThenBlock: {
            DawSong.err = "new fail"
            PrintMessage("new fail\n")
            ReturnValue(0)
        }
        sess = DawSong.Join(dirp, "session.json")
        IfCondition EqualTo(sess, 0) ThenBlock: {
            DawSong.FreeStr(dirp)
            DawSong.err = "new fail"
            PrintMessage("new fail\n")
            ReturnValue(0)
        }
        sz = DawSong.FileSize(sess)
        DawSong.FreeStr(sess)
        IfCondition NotEqual(sz, -2) ThenBlock: {
            DawSong.FreeStr(dirp)
            DawSong.neu = 0
            DawSong.on = 0
            DawSong.hot = -1
            DawSong.err = "exists"
            PrintMessage("new exists\n")
            ReturnValue(0)
        }
        made = DawSong.Mkdir(DawSong.root)
        IfCondition EqualTo(made, 0) ThenBlock: {
            DawSong.FreeStr(dirp)
            DawSong.err = "new fail"
            PrintMessage("new fail\n")
            ReturnValue(0)
        }
        made = DawSong.MkdirSong(dirp)
        IfCondition EqualTo(made, 0) ThenBlock: {
            DawSong.FreeStr(dirp)
            DawSong.err = "new fail"
            PrintMessage("new fail\n")
            ReturnValue(0)
        }
        DawSong.ClearChain()
        oldp = DawSong.path
        oldf = DawSong.file
        olds = DawSong.song
        DawSong.path = dirp
        DawSong.file = 0
        DawSong.song = 0
        IfCondition NotEqual(oldp, 0) ThenBlock: { DawSong.FreeStr(oldp) }
        IfCondition NotEqual(oldf, 0) ThenBlock: { DawSong.FreeStr(oldf) }
        IfCondition NotEqual(olds, 0) ThenBlock: { DawSong.FreeStr(olds) }
        DawSong.neu = 0
        DawSong.on = 0
        DawSong.hot = -1
        PrintMessage("new ok\n")
        PrintMessage(DawSong.word)
        PrintMessage("\n")
        DawSong.ClearWord()
        DawSong.kick = 1
        made = DawSong.Save()
        ReturnValue(made)
    }
}

Function.DawSong.NewAsk {
    Output: Integer
    Body: {
        made = DawSong.Boot()
        IfCondition EqualTo(made, 0) ThenBlock: {
            DawSong.err = "new fail"
            PrintMessage("new fail\n")
            ReturnValue(0)
        }
        DawSong.ClearWord()
        DawSong.on = 0
        DawSong.neu = 1
        DawSong.hot = -1
        DawSong.pw = 420
        DawSong.ph = 170
        span = Subtract(FB.width, DawSong.pw)
        half = Divide(span, 2)
        DawSong.px = half
        IfCondition LessThan(DawSong.px, 0) ThenBlock: { DawSong.px = 0 }
        span = Subtract(FB.height, DawSong.ph)
        half = Divide(span, 2)
        DawSong.py = half
        IfCondition LessThan(DawSong.py, 0) ThenBlock: { DawSong.py = 0 }
        PrintMessage("namepanel ")
        PrintNumber(DawSong.px)
        PrintMessage(" ")
        PrintNumber(DawSong.py)
        PrintMessage("\n")
        ReturnValue(1)
    }
}

Function.DawSong.KeyPaint {
    Input: idx: Integer
    Input: ink: Integer
    Output: Integer
    Body: {
        kx = DawSong.KeyX(idx)
        ky = DawSong.KeyY(idx)
        fill = FB_RGB(40, 44, 52)
        IfCondition EqualTo(idx, DawSong.hot) ThenBlock: {
            fill = FB_RGB(64, 86, 128)
        }
        FB_FillRectFast(kx, ky, 28, 22, fill)
        g = DawSong.Glyph(idx)
        gx = Add(kx, 10)
        gy = Add(ky, 7)
        FB_DrawChar(gx, gy, g, ink, -1)
        ReturnValue(1)
    }
}

Function.DawSong.Btn {
    Input: ox: Integer
    Input: oy: Integer
    Input: bw: Integer
    Input: id: Integer
    Input: label: Address
    Output: Integer
    Body: {
        fill = FB_RGB(40, 44, 52)
        IfCondition EqualTo(id, DawSong.hot) ThenBlock: {
            fill = FB_RGB(64, 86, 128)
        }
        bx = Add(DawSong.px, ox)
        ink = FB_RGB(220, 220, 214)
        FB_FillRectFast(bx, oy, bw, 24, fill)
        tx = Add(bx, 8)
        ty = Add(oy, 8)
        FB_DrawString(tx, ty, label, ink, -1)
        ReturnValue(1)
    }
}

Function.DawSong.NameDraw {
    Output: Integer
    Body: {
        bg = FB_RGB(28, 32, 40)
        ink = FB_RGB(220, 220, 214)
        gold = FB_RGB(240, 200, 60)
        line = FB_RGB(16, 18, 22)
        FB_FillRectFast(DawSong.px, DawSong.py, DawSong.pw, DawSong.ph, bg)
        FB_DrawString(Add(DawSong.px, 16), Add(DawSong.py, 8), "New song", gold, -1)
        ny = Add(DawSong.py, 28)
        FB_FillRectFast(DawSong.px, ny, DawSong.pw, 24, line)
        tx = Add(DawSong.px, 16)
        ty = Add(ny, 8)
        FB_DrawString(tx, ty, DawSong.word, ink, -1)
        i = 0
        WhileLoop LessThan(i, 38) {
            DawSong.KeyPaint(i, ink)
            i = Add(i, 1)
        }
        by = Add(DawSong.py, 134)
        DawSong.Btn(16, by, 110, 38, "Create")
        DawSong.Btn(140, by, 80, 39, "BACK")
        DawSong.Btn(232, by, 110, 40, "Cancel")
        FB_Rect(DawSong.px, DawSong.py, DawSong.pw, DawSong.ph, gold)
        ReturnValue(1)
    }
}

Function.DawSong.NameHit {
    Input: mx: Integer
    Input: my: Integer
    Output: Integer
    Body: {
        code = DawSong.NameAt(mx, my)
        IfCondition EqualTo(code, -3) ThenBlock: {
            DawSong.Cancel()
            ReturnValue(1)
        }
        IfCondition LessThan(code, 0) ThenBlock: { ReturnValue(1) }
        IfCondition LessThan(code, 38) ThenBlock: {
            g = DawSong.Glyph(code)
            DawSong.Type(g)
            ReturnValue(1)
        }
        IfCondition EqualTo(code, 38) ThenBlock: {
            DawSong.Create()
            ReturnValue(1)
        }
        IfCondition EqualTo(code, 39) ThenBlock: {
            DawSong.Type(8)
            ReturnValue(1)
        }
        IfCondition EqualTo(code, 40) ThenBlock: {
            DawSong.Cancel()
            ReturnValue(1)
        }
        ReturnValue(1)
    }
}

Function.DawSong.Up {
    Output: Integer
    Body: {
        IfCondition EqualTo(DawSong.on, 1) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(DawSong.neu, 1) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

Function.DawSong.Cancel {
    Output: Integer
    Body: {
        DawSong.on = 0
        DawSong.neu = 0
        DawSong.err = 0
        DawSong.hot = -1
        DawSong.ClearWord()
        ReturnValue(1)
    }
}

Function.DawSong.Hit {
    Input: mx: Integer
    Input: my: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(DawSong.neu, 1) ThenBlock: {
            DawSong.NameHit(mx, my)
            ReturnValue(1)
        }
        IfCondition EqualTo(DawSong.on, 0) ThenBlock: { ReturnValue(0) }
        row = DawSong.RowAt(mx, my)
        IfCondition EqualTo(row, -1) ThenBlock: { ReturnValue(1) }
        IfCondition LessThan(row, 0) ThenBlock: {
            DawSong.Cancel()
            ReturnValue(1)
        }
        DawSong.on = 0
        DawSong.hot = -1
        slot = DawSong.Slot(row)
        IfCondition EqualTo(slot, 0) ThenBlock: { ReturnValue(1) }
        DawSong.Load(slot)
        ReturnValue(1)
    }
}

Function.DawSong.Hover {
    Input: mx: Integer
    Input: my: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(DawSong.neu, 1) ThenBlock: {
            code = DawSong.NameAt(mx, my)
            IfCondition GreaterEqual(code, 0) ThenBlock: { DawSong.hot = code }
            ElseBlock: { DawSong.hot = -1 }
            ReturnValue(DawSong.hot)
        }
        IfCondition EqualTo(DawSong.on, 0) ThenBlock: {
            DawSong.hot = -1
            ReturnValue(-1)
        }
        row = DawSong.RowAt(mx, my)
        IfCondition LessThan(row, 0) ThenBlock: {
            IfCondition EqualTo(row, -2) ThenBlock: { DawSong.hot = -2 }
            ElseBlock: { DawSong.hot = -1 }
            ReturnValue(DawSong.hot)
        }
        DawSong.hot = row
        ReturnValue(row)
    }
}

Function.DawSong.Draw {
    Output: Integer
    Body: {
        IfCondition EqualTo(DawSong.neu, 1) ThenBlock: {
            DawSong.NameDraw()
            ReturnValue(1)
        }
        IfCondition EqualTo(DawSong.on, 0) ThenBlock: { ReturnValue(0) }
        bg = FB_RGB(28, 32, 40)
        ink = FB_RGB(220, 220, 214)
        gold = FB_RGB(240, 200, 60)
        FB_FillRectFast(DawSong.px, DawSong.py, DawSong.pw, DawSong.ph, bg)
        i = 0
        WhileLoop LessThan(i, DawSong.shown) {
            iy = Add(Add(DawSong.py, 28), Multiply(i, 24))
            fill = FB_RGB(40, 44, 52)
            IfCondition EqualTo(i, DawSong.hot) ThenBlock: {
                fill = FB_RGB(64, 86, 128)
            }
            FB_FillRectFast(DawSong.px, iy, DawSong.pw, 24, fill)
            slot = DawSong.Slot(i)
            FB_DrawString(Add(DawSong.px, 16), Add(iy, 4), slot, ink, -1)
            i = Add(i, 1)
        }
        cy = Add(Add(DawSong.py, 28), Multiply(DawSong.shown, 24))
        cfill = FB_RGB(40, 44, 52)
        IfCondition EqualTo(DawSong.hot, -2) ThenBlock: {
            cfill = FB_RGB(64, 86, 128)
        }
        FB_FillRectFast(DawSong.px, cy, DawSong.pw, 20, cfill)
        FB_DrawString(Add(DawSong.px, 16), Add(cy, 2), "Cancel", ink, -1)
        FB_DrawString(Add(DawSong.px, 16), Add(DawSong.py, 8), "Open song", gold, -1)
        FB_Rect(DawSong.px, DawSong.py, DawSong.pw, DawSong.ph, gold)
        ReturnValue(1)
    }
}
