LibraryImport.DAW.DawRoute
LibraryImport.DAW.DawClip
LibraryImport.DAW.DawNote
LibraryImport.DAW.DawConsole
LibraryImport.DAW.DawEditor

FixedPool.DawSong {
    "path":   Initialize=0, CanChange=True
    "file":   Initialize=0, CanChange=True
    "on":     Initialize=0, CanChange=True
    "n":      Initialize=0, CanChange=True
    "names":  Initialize=0, CanChange=True
    "hot":    Initialize=-1, CanChange=True
    "err":    Initialize=0, CanChange=True
    "root":   Initialize=0, CanChange=True
    "daw":    Initialize=0, CanChange=True
    "repo":   Initialize=0, CanChange=True
    "song":   Initialize=0, CanChange=True
    "empty":  Initialize=0, CanChange=True
    "suf":    Initialize=0, CanChange=True
    "px":     Initialize=0, CanChange=True
    "py":     Initialize=0, CanChange=True
    "pw":     Initialize=360, CanChange=True
    "ph":     Initialize=48, CanChange=True
    "shown":  Initialize=0, CanChange=True
    "num":    Initialize=0, CanChange=True
    "why":    Initialize=0, CanChange=True
    "neu":    Initialize=0, CanChange=True
    "word":   Initialize=0, CanChange=True
    "wn":     Initialize=0, CanChange=True
    "hseq":   Initialize=0, CanChange=True
    "kick":   Initialize=0, CanChange=True
}

Function.DawSong.CopyStr {
    Input: text: Address
    Output: Address
    Body: {
        IfCondition EqualTo(text, 0) ThenBlock: {
            buf = Allocate(1)
            IfCondition EqualTo(buf, 0) ThenBlock: { ReturnValue(0) }
            SetByte(buf, 0, 0)
            ReturnValue(buf)
        }
        len = StringLength(text)
        cap = Add(len, 1)
        buf = Allocate(cap)
        IfCondition EqualTo(buf, 0) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterThan(len, 0) ThenBlock: {
            MemoryCopy(buf, text, len)
        }
        SetByte(buf, len, 0)
        ReturnValue(buf)
    }
}

Function.DawSong.FreeStr {
    Input: text: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(text, 0) ThenBlock: { ReturnValue(0) }
        len = StringLength(text)
        cap = Add(len, 1)
        Deallocate(text, cap)
        ReturnValue(1)
    }
}

Function.DawSong.Boot {
    Output: Integer
    Body: {
        IfCondition NotEqual(DawSong.root, 0) ThenBlock: { ReturnValue(1) }
        wbuf = Allocate(33)
        IfCondition EqualTo(wbuf, 0) ThenBlock: { ReturnValue(0) }
        i = 0
        WhileLoop LessThan(i, 33) {
            SetByte(wbuf, i, 0)
            i = Add(i, 1)
        }
        DawSong.word = wbuf
        DawSong.wn = 0
        DawSong.neu = 0
        DawSong.root = "/home/bob/Ailang-Self-Hosting-/DAW/Songs"
        DawSong.daw = "/home/bob/Ailang-Self-Hosting-/DAW"
        DawSong.repo = "/home/bob/Ailang-Self-Hosting-"
        DawSong.suf = Allocate(64)
        buf = Allocate(1)
        SetByte(buf, 0, 0)
        DawSong.empty = buf
        DawSong.hot = -1
        ReturnValue(1)
    }
}

Function.DawSong.Empty {
    Output: Address
    Body: {
        DawSong.Boot()
        ReturnValue(DawSong.empty)
    }
}

Function.DawSong.Join {
    Input: a: Address
    Input: b: Address
    Output: Address
    Body: {
        mid = StringConcat(a, "/")
        out = StringConcat(mid, b)
        DawSong.FreeStr(mid)
        ReturnValue(out)
    }
}

Function.DawSong.Mkdir {
    Input: dirp: Address
    Output: Integer
    Body: {
        r = SystemCall(83, dirp, 493, 0)
        IfCondition GreaterEqual(r, 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(r, -17) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

Function.DawSong.Unlink {
    Input: dirp: Address
    Output: Integer
    Body: {
        SystemCall(87, dirp, 0, 0)
        ReturnValue(1)
    }
}

Function.DawSong.Blank {
    Input: text: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(text, 0) ThenBlock: { ReturnValue(1) }
        b = GetByte(text, 0)
        IfCondition EqualTo(b, 0) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

Function.DawSong.PoolCopy {
    Input: text: Address
    Output: Address
    Body: {
        IfCondition EqualTo(text, 0) ThenBlock: {
            buf = DawSong.CopyStr(0)
            ReturnValue(buf)
        }
        buf = DawSong.CopyStr(text)
        ReturnValue(buf)
    }
}

Function.DawSong.WriteText {
    Input: dirp: Address
    Input: text: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(text, 0) ThenBlock: { ReturnValue(0) }
        fd = SystemCall(2, dirp, 577, 420)
        IfCondition LessThan(fd, 0) ThenBlock: { ReturnValue(0) }
        len = StringLength(text)
        off = 0
        state = 1
        WhileLoop EqualTo(state, 1) {
            IfCondition GreaterEqual(off, len) ThenBlock: { state = 2 }
            ElseBlock: {
                dstp = Add(text, off)
                need = Subtract(len, off)
                wr = SystemCall(1, fd, dstp, need)
                IfCondition LessThan(wr, 1) ThenBlock: { state = 0 }
                ElseBlock: { off = Add(off, wr) }
            }
        }
        SystemCall(3, fd, 0, 0)
        IfCondition EqualTo(state, 2) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

Function.DawSong.RegSize {
    Input: src: Address
    Output: Integer
    Body: {
        statbuf = Allocate(144)
        r = SystemCall(4, src, statbuf)
        IfCondition LessThan(r, 0) ThenBlock: {
            Deallocate(statbuf, 144)
            ReturnValue(-1)
        }
        mode = Dereference(Add(statbuf, 24))
        sz = Dereference(Add(statbuf, 48))
        Deallocate(statbuf, 144)
        kind = BitwiseAnd(mode, 61440)
        IfCondition NotEqual(kind, 32768) ThenBlock: { ReturnValue(-1) }
        IfCondition LessThan(sz, 1) ThenBlock: { ReturnValue(-1) }
        ReturnValue(sz)
    }
}

Function.DawSong.FileSize {
    Input: src: Address
    Output: Integer
    Body: {
        statbuf = Allocate(144)
        r = SystemCall(4, src, statbuf)
        IfCondition LessThan(r, 0) ThenBlock: {
            Deallocate(statbuf, 144)
            ReturnValue(-2)
        }
        mode = Dereference(Add(statbuf, 24))
        sz = Dereference(Add(statbuf, 48))
        Deallocate(statbuf, 144)
        kind = BitwiseAnd(mode, 61440)
        IfCondition NotEqual(kind, 32768) ThenBlock: { ReturnValue(-1) }
        IfCondition LessThan(sz, 1) ThenBlock: { ReturnValue(-1) }
        IfCondition GreaterThan(sz, 1048576) ThenBlock: { ReturnValue(-1) }
        ReturnValue(sz)
    }
}

Function.DawSong.ReadFile {
    Input: src: Address
    Input: sz: Integer
    Output: Address
    Body: {
        cap = Add(sz, 1)
        buf = Allocate(cap)
        IfCondition EqualTo(buf, 0) ThenBlock: { ReturnValue(0) }
        fd = SystemCall(2, src, 0, 0)
        IfCondition LessThan(fd, 0) ThenBlock: {
            Deallocate(buf, cap)
            ReturnValue(0)
        }
        got = 0
        state = 1
        WhileLoop EqualTo(state, 1) {
            IfCondition GreaterEqual(got, sz) ThenBlock: { state = 2 }
            ElseBlock: {
                dstp = Add(buf, got)
                need = Subtract(sz, got)
                nr = SystemCall(0, fd, dstp, need)
                IfCondition LessThan(nr, 1) ThenBlock: { state = 0 }
                ElseBlock: { got = Add(got, nr) }
            }
        }
        SystemCall(3, fd, 0, 0)
        SetByte(buf, sz, 0)
        IfCondition EqualTo(state, 2) ThenBlock: { ReturnValue(buf) }
        Deallocate(buf, cap)
        ReturnValue(0)
    }
}

Function.DawSong.FreeBuf {
    Input: buf: Address
    Input: sz: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(buf, 0) ThenBlock: { ReturnValue(0) }
        cap = Add(sz, 1)
        Deallocate(buf, cap)
        ReturnValue(1)
    }
}

Function.DawSong.CopyFile {
    Input: src: Address
    Input: dst: Address
    Output: Integer
    Body: {
        sz = DawSong.RegSize(src)
        IfCondition LessThan(sz, 1) ThenBlock: { ReturnValue(0) }
        inf = SystemCall(2, src, 0, 0)
        IfCondition LessThan(inf, 0) ThenBlock: { ReturnValue(0) }
        outf = SystemCall(2, dst, 577, 420)
        IfCondition LessThan(outf, 0) ThenBlock: {
            SystemCall(3, inf, 0, 0)
            ReturnValue(0)
        }
        buf = Allocate(4096)
        IfCondition EqualTo(buf, 0) ThenBlock: {
            SystemCall(3, inf, 0, 0)
            SystemCall(3, outf, 0, 0)
            ReturnValue(0)
        }
        left = sz
        state = 1
        WhileLoop EqualTo(state, 1) {
            IfCondition LessThan(left, 1) ThenBlock: { state = 2 }
            ElseBlock: {
                want = 4096
                IfCondition LessThan(left, want) ThenBlock: { want = left }
                got = SystemCall(0, inf, buf, want)
                IfCondition LessThan(got, 1) ThenBlock: { state = 0 }
                ElseBlock: {
                    woff = 0
                    WhileLoop LessThan(woff, got) {
                        dstp = Add(buf, woff)
                        need = Subtract(got, woff)
                        wr = SystemCall(1, outf, dstp, need)
                        IfCondition LessThan(wr, 1) ThenBlock: {
                            state = 0
                            woff = got
                        }
                        ElseBlock: {
                            woff = Add(woff, wr)
                        }
                    }
                    IfCondition EqualTo(state, 1) ThenBlock: {
                        left = Subtract(left, got)
                    }
                }
            }
        }
        SystemCall(3, inf, 0, 0)
        SystemCall(3, outf, 0, 0)
        Deallocate(buf, 4096)
        IfCondition EqualTo(state, 2) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

Function.DawSong.PathKind {
    Input: text: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(text, 0) ThenBlock: { ReturnValue(0) }
        b0 = GetByte(text, 0)
        IfCondition EqualTo(b0, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(b0, 47) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(b0, 68) ThenBlock: {
            len = StringLength(text)
            IfCondition GreaterEqual(len, 4) ThenBlock: {
                b1 = GetByte(text, 1)
                b2 = GetByte(text, 2)
                b3 = GetByte(text, 3)
                IfCondition EqualTo(b1, 65) ThenBlock: {
                    IfCondition EqualTo(b2, 87) ThenBlock: {
                        IfCondition EqualTo(b3, 47) ThenBlock: { ReturnValue(2) }
                    }
                }
            }
        }
        ReturnValue(3)
    }
}

Function.DawSong.HasDotDot {
    Input: text: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(text, 0) ThenBlock: { ReturnValue(0) }
        len = StringLength(text)
        idx = 0
        WhileLoop LessThan(idx, len) {
            b0 = GetByte(text, idx)
            b1 = 0
            b2 = 0
            i1 = Add(idx, 1)
            i2 = Add(idx, 2)
            IfCondition LessThan(i1, len) ThenBlock: { b1 = GetByte(text, i1) }
            IfCondition LessThan(i2, len) ThenBlock: { b2 = GetByte(text, i2) }
            IfCondition EqualTo(b0, 46) ThenBlock: {
                IfCondition EqualTo(b1, 46) ThenBlock: {
                    endseg = 0
                    IfCondition GreaterEqual(i2, len) ThenBlock: { endseg = 1 }
                    IfCondition EqualTo(b2, 47) ThenBlock: { endseg = 1 }
                    IfCondition EqualTo(endseg, 1) ThenBlock: { ReturnValue(1) }
                }
            }
            step = 1
            WhileLoop EqualTo(step, 1) {
                IfCondition GreaterEqual(idx, len) ThenBlock: { step = 0 }
                ElseBlock: {
                    ch = GetByte(text, idx)
                    idx = Add(idx, 1)
                    IfCondition EqualTo(ch, 47) ThenBlock: { step = 0 }
                }
            }
        }
        ReturnValue(0)
    }
}

Function.DawSong.RelSafe {
    Input: text: Address
    Output: Integer
    Body: {
        k = DawSong.PathKind(text)
        IfCondition EqualTo(k, 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(k, 1) ThenBlock: { ReturnValue(1) }
        d = DawSong.HasDotDot(text)
        IfCondition EqualTo(d, 1) ThenBlock: { ReturnValue(0) }
        ReturnValue(1)
    }
}

Function.DawSong.SafeOrEmpty {
    Input: text: Address
    Output: Integer
    Body: {
        blank = DawSong.Blank(text)
        IfCondition EqualTo(blank, 1) ThenBlock: { ReturnValue(1) }
        r = DawSong.RelSafe(text)
        ReturnValue(r)
    }
}

Function.DawSong.LegalFolder {
    Input: text: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(text, 0) ThenBlock: { ReturnValue(0) }
        len = StringLength(text)
        IfCondition LessThan(len, 1) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterThan(len, 32) ThenBlock: { ReturnValue(0) }
        idx = 0
        WhileLoop LessThan(idx, len) {
            ch = GetByte(text, idx)
            good = 0
            IfCondition GreaterEqual(ch, 48) ThenBlock: {
                IfCondition LessEqual(ch, 57) ThenBlock: { good = 1 }
            }
            IfCondition GreaterEqual(ch, 65) ThenBlock: {
                IfCondition LessEqual(ch, 90) ThenBlock: { good = 1 }
            }
            IfCondition GreaterEqual(ch, 97) ThenBlock: {
                IfCondition LessEqual(ch, 122) ThenBlock: { good = 1 }
            }
            IfCondition EqualTo(ch, 95) ThenBlock: { good = 1 }
            IfCondition EqualTo(ch, 45) ThenBlock: { good = 1 }
            IfCondition EqualTo(good, 0) ThenBlock: { ReturnValue(0) }
            idx = Add(idx, 1)
        }
        ReturnValue(1)
    }
}

Function.DawSong.TrackNameOk {
    Input: text: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(text, 0) ThenBlock: { ReturnValue(0) }
        len = StringLength(text)
        IfCondition LessThan(len, 1) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterThan(len, 40) ThenBlock: { ReturnValue(0) }
        idx = 0
        WhileLoop LessThan(idx, len) {
            ch = GetByte(text, idx)
            IfCondition EqualTo(ch, 47) ThenBlock: { ReturnValue(0) }
            idx = Add(idx, 1)
        }
        ReturnValue(1)
    }
}

Function.DawSong.InRange {
    Input: v: Integer
    Input: lo: Integer
    Input: hi: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(v, lo) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterThan(v, hi) ThenBlock: { ReturnValue(0) }
        ReturnValue(1)
    }
}

Function.DawSong.Base {
    Input: text: Address
    Output: Address
    Body: {
        IfCondition EqualTo(text, 0) ThenBlock: { ReturnValue(0) }
        len = StringLength(text)
        idx = 0
        last = -1
        WhileLoop LessThan(idx, len) {
            ch = GetByte(text, idx)
            IfCondition EqualTo(ch, 47) ThenBlock: { last = idx }
            idx = Add(idx, 1)
        }
        IfCondition LessThan(last, 0) ThenBlock: { ReturnValue(text) }
        off = Add(last, 1)
        p = Add(text, off)
        ReturnValue(p)
    }
}

Function.DawSong.Title {
    Output: Address
    Body: {
        IfCondition NotEqual(DawSong.err, 0) ThenBlock: { ReturnValue(DawSong.err) }
        IfCondition NotEqual(DawSong.path, 0) ThenBlock: {
            base = DawSong.Base(DawSong.path)
            ReturnValue(base)
        }
        ReturnValue("Arrange")
    }
}

Function.DawSong.Num {
    Input: obj: Address
    Input: key: Address
    Output: Integer
    Body: {
        ty = JSON.GetType(obj, key)
        IfCondition NotEqual(ty, JType.NUMBER) ThenBlock: { ReturnValue(0) }
        DawSong.num = JSON.GetNumber(obj, key)
        ReturnValue(1)
    }
}

Function.DawSong.KindOk {
    Input: k: Integer
    Input: v: Integer
    Output: Integer
    Body: {
        ok = 0
        IfCondition EqualTo(k, 1) ThenBlock: {
            IfCondition EqualTo(v, 1) ThenBlock: { ok = 1 }
        }
        IfCondition EqualTo(k, 0) ThenBlock: {
            IfCondition EqualTo(v, 1) ThenBlock: { ok = 1 }
            IfCondition EqualTo(v, 0) ThenBlock: { ok = 1 }
        }
        IfCondition EqualTo(k, 2) ThenBlock: {
            IfCondition EqualTo(v, 0) ThenBlock: { ok = 1 }
        }
        ReturnValue(ok)
    }
}

Function.DawSong.TStr {
    Input: track: Address
    Input: which: Integer
    Output: Address
    Body: {
        at = PoolFieldOffset(LinkagePool.DawTrack, "name")
        IfCondition EqualTo(which, 2) ThenBlock: {
            at = PoolFieldOffset(LinkagePool.DawTrack, "inst")
        }
        IfCondition EqualTo(which, 3) ThenBlock: {
            at = PoolFieldOffset(LinkagePool.DawTrack, "preset")
        }
        IfCondition EqualTo(which, 4) ThenBlock: {
            at = PoolFieldOffset(LinkagePool.DawTrack, "library")
        }
        IfCondition EqualTo(which, 5) ThenBlock: {
            at = PoolFieldOffset(LinkagePool.DawTrack, "pack")
        }
        IfCondition EqualTo(which, 6) ThenBlock: {
            at = PoolFieldOffset(LinkagePool.DawTrack, "midi")
        }
        IfCondition EqualTo(which, 7) ThenBlock: {
            at = PoolFieldOffset(LinkagePool.DawTrack, "host")
        }
        IfCondition EqualTo(which, 8) ThenBlock: {
            at = PoolFieldOffset(LinkagePool.DawTrack, "plugin")
        }
        IfCondition EqualTo(which, 9) ThenBlock: {
            at = PoolFieldOffset(LinkagePool.DawTrack, "vst")
        }
        ReturnValue(Dereference(Add(track, at)))
    }
}

