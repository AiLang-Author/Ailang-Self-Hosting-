Function.DawTrack.Remove {
    Input: track: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(track, 0) ThenBlock: { ReturnValue(0) }
        DawRoute.Drop(track)
        noff = PoolFieldOffset(LinkagePool.DawTrack, "next")
        prev = 0
        cur = DawTracks.head
        WhileLoop NotEqual(cur, 0) {
            IfCondition EqualTo(cur, track) ThenBlock: {
                nxt = Dereference(Add(cur, noff))
                IfCondition EqualTo(prev, 0) ThenBlock: {
                    DawTracks.head = nxt
                }
                ElseBlock: {
                    StoreValue(Add(prev, noff), nxt)
                }
                DawTracks.n = Subtract(DawTracks.n, 1)
                IfCondition LessThan(DawTracks.n, 0) ThenBlock: { DawTracks.n = 0 }
                IfCondition EqualTo(DawTracks.sel, track) ThenBlock: {
                    DawTracks.sel = nxt
                    IfCondition EqualTo(nxt, 0) ThenBlock: { DawTracks.sel = prev }
                }
                ReturnValue(1)
            }
            prev = cur
            cur = Dereference(Add(cur, noff))
        }
        ReturnValue(0)
    }
}
