// One instrument instance. The list is a chain, not a fixed cap.
// Sixteen on screen is a view. The chain can be longer.
// host is the Carla instance id. plugin is the VST path.
// vst is the song-relative chunk, patches/<id>.bin.
//
// Copyright © 2026 Sean Collins, 2 Paws Machine and Engineering. SCSL v1.0.

LibraryImport.DAW.DawRoute
LibraryImport.DAW.DawSong

LinkagePool.DawTrack {
    "next":  Initialize=0, PointerTo=LinkagePool.DawTrack
    "name":  Initialize=0
    "kind":  Initialize=0
    "view":  Initialize=0
    "inst":  Initialize=0
    "clips": Initialize=0, PointerTo=LinkagePool.DawClip
    "arm":   Initialize=0
    "mute":  Initialize=0
    "solo":  Initialize=0
    "fader": Initialize=700
    "pan":   Initialize=500
    "notes":   Initialize=0, PointerTo=LinkagePool.DawNote
    "fx":      Initialize=0
    "preset":  Initialize=0
    "library": Initialize=0
    "pack":    Initialize=0
    "midi":    Initialize=0
    "host":    Initialize=0
    "plugin":  Initialize=0
    "vst":     Initialize=0
}

FixedPool.DawTracks {
    "head":     Initialize=0, CanChange=True
    "n":        Initialize=0, CanChange=True
    "sel":      Initialize=0, CanChange=True
    "arr_x":    Initialize=0, CanChange=True
    "arr_y":    Initialize=0, CanChange=True
    "edit_x":   Initialize=0, CanChange=True
    "edit_y":   Initialize=42, CanChange=True
    "con_y":    Initialize=0, CanChange=True
    "play":     Initialize=360, CanChange=True
    "zoom":     Initialize=100, CanChange=True
}

Function.DawTrack.Add {
    Input: name: Address
    Input: kind: Integer
    Input: view: Integer
    Input: inst: Address
    Output: Address
    Body: {
        t = AllocateLinkage(LinkagePool.DawTrack)
        IfCondition EqualTo(t, 0) ThenBlock: { ReturnValue(0) }
        nb = DawSong.CopyStr(name)
        ib = DawSong.CopyStr(inst)
        t@name = nb
        t@kind = kind
        t@view = view
        t@inst = ib
        t@fader = 700
        t@pan = 500
        noff = PoolFieldOffset(LinkagePool.DawTrack, "next")
        IfCondition EqualTo(DawTracks.head, 0) ThenBlock: {
            DawTracks.head = t
        }
        ElseBlock: {
            cur = DawTracks.head
            nxt = Dereference(Add(cur, noff))
            WhileLoop NotEqual(nxt, 0) {
                cur = nxt
                nxt = Dereference(Add(cur, noff))
            }
            StoreValue(Add(cur, noff), t)
        }
        DawTracks.n = Add(DawTracks.n, 1)
        IfCondition EqualTo(DawTracks.sel, 0) ThenBlock: { DawTracks.sel = t }
        DawRoute.Attach(t)
        ReturnValue(t)
    }
}

Function.DawTrack.AnyArm {
    Output: Integer
    Body: {
        noff = PoolFieldOffset(LinkagePool.DawTrack, "next")
        a_at = PoolFieldOffset(LinkagePool.DawTrack, "arm")
        cur = DawTracks.head
        WhileLoop NotEqual(cur, 0) {
            v = Dereference(Add(cur, a_at))
            IfCondition EqualTo(v, 1) ThenBlock: { ReturnValue(1) }
            cur = Dereference(Add(cur, noff))
        }
        ReturnValue(0)
    }
}

Function.DawTrack.Flip {
    Input: track: Address
    Input: which: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(track, 0) ThenBlock: { ReturnValue(0) }
        at = PoolFieldOffset(LinkagePool.DawTrack, "arm")
        IfCondition EqualTo(which, 2) ThenBlock: {
            at = PoolFieldOffset(LinkagePool.DawTrack, "mute")
        }
        IfCondition EqualTo(which, 3) ThenBlock: {
            at = PoolFieldOffset(LinkagePool.DawTrack, "solo")
        }
        v = Dereference(Add(track, at))
        n = 0
        IfCondition EqualTo(v, 0) ThenBlock: { n = 1 }
        StoreValue(Add(track, at), n)
        ReturnValue(n)
    }
}

Function.DawTrack.At {
    Input: index: Integer
    Output: Address
    Body: {
        cur = DawTracks.head
        i = 0
        noff = PoolFieldOffset(LinkagePool.DawTrack, "next")
        WhileLoop NotEqual(cur, 0) {
            IfCondition EqualTo(i, index) ThenBlock: { ReturnValue(cur) }
            i = Add(i, 1)
            cur = Dereference(Add(cur, noff))
        }
        ReturnValue(0)
    }
}

Function.DawTrack.Use {
    Input: track: Address
    Input: which: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(track, 0) ThenBlock: { ReturnValue(0) }
        k_at = PoolFieldOffset(LinkagePool.DawTrack, "kind")
        v_at = PoolFieldOffset(LinkagePool.DawTrack, "view")
        i_at = PoolFieldOffset(LinkagePool.DawTrack, "inst")
        IfCondition EqualTo(which, 1) ThenBlock: {
            StoreValue(Add(track, k_at), 1)
            StoreValue(Add(track, v_at), 1)
            StoreValue(Add(track, i_at), "synth")
        }
        IfCondition EqualTo(which, 2) ThenBlock: {
            StoreValue(Add(track, k_at), 0)
            StoreValue(Add(track, v_at), 1)
            StoreValue(Add(track, i_at), "sample")
        }
        IfCondition EqualTo(which, 3) ThenBlock: {
            StoreValue(Add(track, k_at), 0)
            StoreValue(Add(track, v_at), 0)
            StoreValue(Add(track, i_at), "wave")
        }
        ReturnValue(which)
    }
}

Function.DawTrack.SetFx {
    Input: track: Address
    Input: which: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(track, 0) ThenBlock: { ReturnValue(0) }
        at = PoolFieldOffset(LinkagePool.DawTrack, "fx")
        StoreValue(Add(track, at), which)
        ReturnValue(which)
    }
}

