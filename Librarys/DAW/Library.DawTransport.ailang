// Master clock and transport. Rewind, pause, play, fast-forward.
// The clock is the playhead. Nothing here opens the sound card.
//
// Copyright © 2026 Sean Collins, 2 Paws Machine and Engineering. SCSL v1.0.

LibraryImport.DAW.DawTrack
LibraryImport.Display.Render.Framebuffer

FixedPool.DawTrans {
    "ox":   Initialize=0, CanChange=True
    "oy":   Initialize=0, CanChange=True
    "bx":   Initialize=0, CanChange=True
    "by":   Initialize=0, CanChange=True
    "rec":  Initialize=0, CanChange=True
}

Function.DawTransport.Places {
    Input: x: Integer
    Input: y: Integer
    Input: n: Integer
    Input: places: Integer
    Input: color: Integer
    Output: Integer
    Body: {
        place = 1
        k = 1
        WhileLoop LessThan(k, places) {
            place = Multiply(place, 10)
            k = Add(k, 1)
        }
        WhileLoop GreaterThan(places, 0) {
            dig = Modulo(Divide(n, place), 10)
            FB_DrawNumber(x, y, dig, color, -1)
            x = Add(x, 8)
            place = Divide(place, 10)
            places = Subtract(places, 1)
        }
        ReturnValue(x)
    }
}

Function.DawTransport.Clamp {
    Output: Integer
    Body: {
        IfCondition LessThan(DawTracks.play, 0) ThenBlock: { DawTracks.play = 0 }
        IfCondition GreaterThan(DawTracks.play, 4000) ThenBlock: { DawTracks.play = 4000 }
        ReturnValue(0)
    }
}

Function.DawTransport.Hit {
    Input: px: Integer
    Input: py: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(py, DawTrans.by) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterEqual(py, Add(DawTrans.by, 22)) ThenBlock: { ReturnValue(0) }
        i = 0
        WhileLoop LessThan(i, 5) {
            x0 = Add(DawTrans.bx, Multiply(i, 52))
            IfCondition GreaterEqual(px, x0) ThenBlock: {
                IfCondition LessThan(px, Add(x0, 48)) ThenBlock: {
                    ReturnValue(Add(i, 1))
                }
            }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

Function.DawTransport.Draw {
    Input: x: Integer
    Input: y: Integer
    Input: w: Integer
    Input: h: Integer
    Input: playing: Integer
    Output: Integer
    Body: {
        bg = FB_RGB(20, 22, 26)
        ink = FB_RGB(236, 232, 210)
        dim = FB_RGB(140, 144, 150)
        on = FB_RGB(240, 200, 60)
        off = FB_RGB(48, 52, 58)
        FB_FillRectFast(x, y, w, h, bg)
        FB_DrawString(Add(x, 8), Add(y, 12), "MASTER", dim, -1)
        ms = Divide(Multiply(DawTracks.play, 25), 2)
        mins = Divide(ms, 60000)
        sec = Modulo(Divide(ms, 1000), 60)
        frac = Modulo(ms, 1000)
        cx = DawTransport.Places(Add(x, 64), Add(y, 10), mins, 2, ink)
        FB_DrawString(cx, Add(y, 10), ":", ink, -1)
        cx = DawTransport.Places(Add(cx, 8), Add(y, 10), sec, 2, ink)
        FB_DrawString(cx, Add(y, 10), ".", ink, -1)
        DawTransport.Places(Add(cx, 8), Add(y, 10), frac, 3, ink)
        DawTrans.ox = x
        DawTrans.oy = y
        DawTrans.bx = Add(x, 200)
        DawTrans.by = Add(y, 8)
        i = 0
        WhileLoop LessThan(i, 5) {
            bx = Add(DawTrans.bx, Multiply(i, 52))
            lit = 0
            IfCondition EqualTo(i, 1) ThenBlock: {
                IfCondition EqualTo(playing, 0) ThenBlock: { lit = 1 }
            }
            IfCondition EqualTo(i, 2) ThenBlock: {
                IfCondition EqualTo(playing, 1) ThenBlock: { lit = 1 }
            }
            IfCondition EqualTo(i, 4) ThenBlock: {
                IfCondition EqualTo(DawTrans.rec, 1) ThenBlock: { lit = 1 }
            }
            fill = off
            fg = ink
            IfCondition EqualTo(lit, 1) ThenBlock: {
                fill = on
                fg = FB_RGB(20, 20, 20)
            }
            IfCondition EqualTo(i, 4) ThenBlock: {
                IfCondition EqualTo(DawTrans.rec, 1) ThenBlock: {
                    fill = FB_RGB(190, 48, 42)
                    fg = FB_RGB(255, 236, 230)
                }
            }
            FB_FillRectFast(bx, DawTrans.by, 48, 22, fill)
            lab = "RW"
            IfCondition EqualTo(i, 1) ThenBlock: { lab = "PAUSE" }
            IfCondition EqualTo(i, 2) ThenBlock: { lab = "PLAY" }
            IfCondition EqualTo(i, 3) ThenBlock: { lab = "FF" }
            IfCondition EqualTo(i, 4) ThenBlock: { lab = "REC" }
            FB_DrawString(Add(bx, 4), Add(DawTrans.by, 6), lab, fg, -1)
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}
