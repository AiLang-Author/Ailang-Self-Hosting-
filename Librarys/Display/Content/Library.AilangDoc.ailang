}

FixedPool.ADocList {
    "NONE":   Initialize=0
    "BULLET": Initialize=1
    "NUMBER": Initialize=2
}

FixedPool.ADocParaOff {
    "KIND":   Initialize=0
    "INDENT": Initialize=8
    "OFF0":   Initialize=16
    "ITEM":   Initialize=24
}

FixedPool.ADocTable {
    "data":  Initialize=0, CanChange=True
    "count": Initialize=0, CanChange=True
}

Function.ADoc_Init {
    Output: Integer
    Body: {
        IfCondition NotEqual(ADocTable.data, 0) ThenBlock: {
            ReturnValue(1)
        }
        sz = Multiply(ADocConst.MAX_DOCS, ADocConst.REC_SIZE)
        p = Allocate(sz)
        IfCondition EqualTo(p, 0) ThenBlock: {
            PrintMessage("[AilangDoc] alloc fail\n")
            ReturnValue(0)
        }
        MemorySet(p, 0, sz)
        ADocTable.data = p
        ADocTable.count = 0
        PrintMessage("[AilangDoc] init ok\n")
        ReturnValue(1)
    }
}

Function.ADoc_Ptr {
    Input: idx: Integer
    Output: Address
    Body: {
        ReturnValue(Add(ADocTable.data, Multiply(idx, ADocConst.REC_SIZE)))
    }
}

FixedPool.ADocAcc {
    "idx":   Initialize=0, CanChange=True
    "field": Initialize=0, CanChange=True
    "val":   Initialize=0, CanChange=True
}

Function.ADoc_Get {
    Input: idx: Integer
    Input: field: Integer
    Output: Integer
    Body: {
        ADocAcc.idx = idx
        ADocAcc.field = field
        ReturnValue(Dereference(Add(ADoc_Ptr(ADocAcc.idx), ADocAcc.field)))
    }
}

Function.ADoc_Set {
    Input: idx: Integer
    Input: field: Integer
    Input: val: Integer
    Body: {
        ADocAcc.idx = idx
        ADocAcc.field = field
        ADocAcc.val = val
        StoreValue(Add(ADoc_Ptr(ADocAcc.idx), ADocAcc.field), ADocAcc.val)
    }
}

Function.ADoc_Create {
    Input: paper: Integer
    Input: orient: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(ADocTable.data, 0) ThenBlock: {
            ADoc_Init()
        }
        idx = ADocTable.count
        IfCondition GreaterEqual(idx, ADocConst.MAX_DOCS) ThenBlock: {
            PrintMessage("[AilangDoc] table full\n")
            ReturnValue(-1)
        }
        ADocTable.count = Add(idx, 1)
        ADoc_Set(idx, ADocField.PAPER, paper)
        ADoc_Set(idx, ADocField.ORIENT, orient)
        ADoc_Set(idx, ADocField.CUSTOM_W, 0)
        ADoc_Set(idx, ADocField.CUSTOM_H, 0)
        ADoc_Set(idx, ADocField.MT, ADocConst.MARGIN_PT)
        ADoc_Set(idx, ADocField.MR, ADocConst.MARGIN_PT)
        ADoc_Set(idx, ADocField.MB, ADocConst.MARGIN_PT)
        ADoc_Set(idx, ADocField.ML, ADocConst.MARGIN_PT)
        ADoc_Set(idx, ADocField.SIZE_PT, ADocConst.SIZE_PT)
        ADoc_Set(idx, ADocField.PRINT_DPI, ADocConst.LAYOUT_DPI)
        ADoc_Set(idx, ADocField.LAYOUT_INST, -1)
        ADoc_Set(idx, ADocField.RUN_PTR, 0)
        ADoc_Set(idx, ADocField.RUN_LEN, 0)
        ADoc_Set(idx, ADocField.RUN_CAP, 0)
        ADoc_Set(idx, ADocField.PAGE_COUNT, 1)
        ADoc_Set(idx, ADocField.LINE_DATA, 0)
        ADoc_Set(idx, ADocField.LINE_COUNT, 0)
        ADoc_Set(idx, ADocField.BOLD, 0)
        ADoc_Set(idx, ADocField.ITALIC, 0)
        ADoc_Set(idx, ADocField.FLAGS, DocFlag.LAYOUT_DIRTY)
        ADoc_Set(idx, ADocField.PG_ID, 0)
        ADoc_Set(idx, ADocField.ALIGN, ADocAlign.LEFT)
        ADoc_Set(idx, ADocField.UNDERLINE, 0)
        ADoc_Set(idx, ADocField.HDR_PTR, 0)
        ADoc_Set(idx, ADocField.HDR_LEN, 0)
        ADoc_Set(idx, ADocField.FTR_PTR, 0)
        ADoc_Set(idx, ADocField.FTR_LEN, 0)
        ADoc_Set(idx, ADocField.TAB_SP, 4)
        ADoc_Set(idx, ADocField.FACE, FontState.doc_face)
        ADoc_Set(idx, ADocField.PARA_DATA, 0)
        ADoc_Set(idx, ADocField.PARA_COUNT, 0)
        ReturnValue(idx)
    }
}

Function.ADoc_SetCustom {
    Input: idx: Integer
    Input: w_pt: Integer
    Input: h_pt: Integer
    Body: {
        ADoc_Set(idx, ADocField.PAPER, DocPaper.CUSTOM)
        ADoc_Set(idx, ADocField.CUSTOM_W, w_pt)
        ADoc_Set(idx, ADocField.CUSTOM_H, h_pt)
        ADoc_Set(idx, ADocField.FLAGS, DocFlag.LAYOUT_DIRTY)
    }
}

Function.ADoc_MarkDirty {
    Input: idx: Integer
    Body: {
        f = ADoc_Get(idx, ADocField.FLAGS)
        ADoc_Set(idx, ADocField.FLAGS, BitwiseOr(f, DocFlag.LAYOUT_DIRTY))
    }
}

Function.ADoc_EnsureLines {
    Input: idx: Integer
    Output: Integer
    Body: {
        p = ADoc_Get(idx, ADocField.LINE_DATA)
        IfCondition NotEqual(p, 0) ThenBlock: {
            ReturnValue(p)
        }
        n = Multiply(ADocConst.MAX_LINES, ADocConst.LINE_SIZE)
        p = Allocate(n)
        IfCondition EqualTo(p, 0) ThenBlock: {
            ReturnValue(0)
        }
        MemorySet(p, 0, n)
        ADoc_Set(idx, ADocField.LINE_DATA, p)
        ReturnValue(p)
    }
}

Function.ADoc_LinePtr {
    Input: idx: Integer
    Input: li: Integer
    Output: Address
    Body: {
        base = ADoc_Get(idx, ADocField.LINE_DATA)
        ReturnValue(Add(base, Multiply(li, ADocConst.LINE_SIZE)))
    }
}

Function.ADoc_RunGrow {
    Input: idx: Integer
    Input: need: Integer
    Output: Integer
    Body: {
        cap = ADoc_Get(idx, ADocField.RUN_CAP)
        IfCondition GreaterEqual(cap, need) ThenBlock: {
            ReturnValue(1)
        }
        ncap = ADocConst.RUN_MIN
        IfCondition GreaterThan(cap, 0) ThenBlock: {
            ncap = cap
        }
        WhileLoop LessThan(ncap, need) {
            ncap = Multiply(ncap, 2)
        }
        nb = Allocate(ncap)
        IfCondition EqualTo(nb, 0) ThenBlock: {
            PrintMessage("[AilangDoc] run alloc fail\n")
            ReturnValue(0)
        }
        MemorySet(nb, 0, ncap)
        old = ADoc_Get(idx, ADocField.RUN_PTR)
        olen = ADoc_Get(idx, ADocField.RUN_LEN)
        IfCondition GreaterThan(olen, 0) ThenBlock: {
            ci = 0
            WhileLoop LessThan(ci, olen) {
                SetByte(nb, ci, GetByte(old, ci))
                ci = Add(ci, 1)
            }
        }
        IfCondition NotEqual(old, 0) ThenBlock: {
            Deallocate(old, cap)
        }
        ADoc_Set(idx, ADocField.RUN_PTR, nb)
        ADoc_Set(idx, ADocField.RUN_CAP, ncap)
        ReturnValue(1)
    }
}

Function.ADoc_Append {
    Input: idx: Integer
    Input: src: Address
    Input: slen: Integer
    Output: Integer
    Body: {
        IfCondition LessEqual(slen, 0) ThenBlock: {
            ReturnValue(1)
        }
        olen = ADoc_Get(idx, ADocField.RUN_LEN)
        need = Add(olen, slen)
        ok = ADoc_RunGrow(idx, Add(need, 1))
        IfCondition EqualTo(ok, 0) ThenBlock: {
            ReturnValue(0)
        }
        dst = ADoc_Get(idx, ADocField.RUN_PTR)
        si = 0
        WhileLoop LessThan(si, slen) {
            SetByte(dst, Add(olen, si), GetByte(src, si))
            si = Add(si, 1)
        }
        SetByte(dst, need, 0)
        ADoc_Set(idx, ADocField.RUN_LEN, need)
        ADoc_MarkDirty(idx)
        ReturnValue(1)
    }
}

Function.ADoc_ClearRun {
    Input: idx: Integer
    Body: {
        ADoc_Set(idx, ADocField.RUN_LEN, 0)
        ADoc_Set(idx, ADocField.PAGE_COUNT, 1)
        ADoc_Set(idx, ADocField.LINE_COUNT, 0)
        ADoc_MarkDirty(idx)
    }
}

FixedPool.ADocEdit {
    "one": Initialize=0, CanChange=True
}

FixedPool.ADocPara {
    "idx":    Initialize=0, CanChange=True
    "i":      Initialize=0, CanChange=True
    "n":      Initialize=0, CanChange=True
    "off":    Initialize=0, CanChange=True
    "end":    Initialize=0, CanChange=True
    "run":    Initialize=0, CanChange=True
    "rlen":   Initialize=0, CanChange=True
    "p":      Initialize=0, CanChange=True
    "kind":   Initialize=0, CanChange=True
    "indent": Initialize=0, CanChange=True
    "item":   Initialize=0, CanChange=True
    "c0":     Initialize=0, CanChange=True
    "c1":     Initialize=0, CanChange=True
    "c2":     Initialize=0, CanChange=True
    "c3":     Initialize=0, CanChange=True
    "c4":     Initialize=0, CanChange=True
}

FixedPool.ADocBand {
    "idx":   Initialize=0, CanChange=True
    "ptr_f": Initialize=0, CanChange=True
    "len_f": Initialize=0, CanChange=True
    "src":   Initialize=0, CanChange=True
    "slen":  Initialize=0, CanChange=True
    "old":   Initialize=0, CanChange=True
    "olen":  Initialize=0, CanChange=True
    "p":     Initialize=0, CanChange=True
    "si":    Initialize=0, CanChange=True
}

Function.ADoc_InsertAt {
    Input: idx: Integer
    Input: off: Integer
    Input: src: Address
    Input: slen: Integer
    Output: Integer
    Body: {
        IfCondition LessEqual(slen, 0) ThenBlock: {
            ReturnValue(1)
        }
        olen = ADoc_Get(idx, ADocField.RUN_LEN)
        IfCondition LessThan(off, 0) ThenBlock: {
            off = 0
        }
        IfCondition GreaterThan(off, olen) ThenBlock: {
            off = olen
        }
        ADocPara.off = off
        ADocPara.n = slen
        need = Add(olen, slen)
        ok = ADoc_RunGrow(idx, Add(need, 1))
        IfCondition EqualTo(ok, 0) ThenBlock: {
            ReturnValue(0)
        }
        dst = ADoc_Get(idx, ADocField.RUN_PTR)
        i = Subtract(olen, 1)
        WhileLoop GreaterEqual(i, off) {
            SetByte(dst, Add(i, slen), GetByte(dst, i))
            i = Subtract(i, 1)
        }
        si = 0
        WhileLoop LessThan(si, slen) {
            SetByte(dst, Add(off, si), GetByte(src, si))
            si = Add(si, 1)
        }
        SetByte(dst, need, 0)
        ADoc_Set(idx, ADocField.RUN_LEN, need)
        ADoc_ParaOnInsert(idx, ADocPara.off, ADocPara.n)
        ADoc_MarkDirty(idx)
        ReturnValue(1)
    }
}

Function.ADoc_DeleteRange {
    Input: idx: Integer
    Input: off: Integer
    Input: n: Integer
    Body: {
        olen = ADoc_Get(idx, ADocField.RUN_LEN)
        IfCondition LessEqual(n, 0) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition LessThan(off, 0) ThenBlock: {
            off = 0
        }
        IfCondition GreaterEqual(off, olen) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition GreaterThan(Add(off, n), olen) ThenBlock: {
            n = Subtract(olen, off)
        }
        ADocPara.off = off
        ADocPara.n = n
        dst = ADoc_Get(idx, ADocField.RUN_PTR)
        i = off
        lim = Subtract(olen, n)
        WhileLoop LessThan(i, lim) {
            SetByte(dst, i, GetByte(dst, Add(i, n)))
            i = Add(i, 1)
        }
        ADoc_Set(idx, ADocField.RUN_LEN, Subtract(olen, n))
        ADoc_ParaOnDelete(idx, ADocPara.off, ADocPara.n)
        ADoc_MarkDirty(idx)
    }
}

Function.ADoc_InsertByte {
    Input: idx: Integer
    Input: off: Integer
    Input: ch: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(ADocEdit.one, 0) ThenBlock: {
            ADocEdit.one = Allocate(8)
        }
        SetByte(ADocEdit.one, 0, ch)
        ReturnValue(ADoc_InsertAt(idx, off, ADocEdit.one, 1))
    }
}

Function.ADoc_SetBand {
    Input: idx: Integer
    Input: ptr_field: Integer
    Input: len_field: Integer
    Input: src: Address
    Input: slen: Integer
    Body: {
        ADocBand.idx = idx
        ADocBand.ptr_f = ptr_field
        ADocBand.len_f = len_field
        ADocBand.src = src
        ADocBand.slen = slen
        ADocBand.old = ADoc_Get(ADocBand.idx, ADocBand.ptr_f)
        ADocBand.olen = ADoc_Get(ADocBand.idx, ADocBand.len_f)
        IfCondition Or(EqualTo(ADocBand.src, 0), LessEqual(ADocBand.slen, 0)) ThenBlock: {
            IfCondition NotEqual(ADocBand.old, 0) ThenBlock: {
                Deallocate(ADocBand.old, Add(ADocBand.olen, 1))
            }
            ADoc_Set(ADocBand.idx, ADocBand.ptr_f, 0)
            ADoc_Set(ADocBand.idx, ADocBand.len_f, 0)
            ReturnValue(0)
        }
        ADocBand.p = Allocate(Add(ADocBand.slen, 1))
        IfCondition EqualTo(ADocBand.p, 0) ThenBlock: {
            ReturnValue(0)
        }
        ADocBand.si = 0
        WhileLoop LessThan(ADocBand.si, ADocBand.slen) {
            SetByte(ADocBand.p, ADocBand.si, GetByte(ADocBand.src, ADocBand.si))
            ADocBand.si = Add(ADocBand.si, 1)
        }
        SetByte(ADocBand.p, ADocBand.slen, 0)
        IfCondition NotEqual(ADocBand.old, 0) ThenBlock: {
            Deallocate(ADocBand.old, Add(ADocBand.olen, 1))
        }
        ADoc_Set(ADocBand.idx, ADocBand.ptr_f, ADocBand.p)
        ADoc_Set(ADocBand.idx, ADocBand.len_f, ADocBand.slen)
    }
}

Function.ADoc_EnsureParas {
    Input: idx: Integer
    Output: Integer
    Body: {
        p = ADoc_Get(idx, ADocField.PARA_DATA)
        IfCondition NotEqual(p, 0) ThenBlock: {
            ReturnValue(p)
        }
        n = Multiply(ADocConst.MAX_PARAS, ADocConst.PARA_SIZE)
        p = Allocate(n)
        IfCondition EqualTo(p, 0) ThenBlock: {
            ReturnValue(0)
        }
        MemorySet(p, 0, n)
        ADoc_Set(idx, ADocField.PARA_DATA, p)
        ADoc_Set(idx, ADocField.PARA_COUNT, 0)
        ReturnValue(p)
    }
}

Function.ADoc_ParaPtr {
    Input: idx: Integer
    Input: pi: Integer
    Output: Address
    Body: {
        ReturnValue(Add(ADoc_Get(idx, ADocField.PARA_DATA), Multiply(pi, ADocConst.PARA_SIZE)))
    }
}

Function.ADoc_ParaSeed {
    Input: idx: Integer
    Body: {
        IfCondition EqualTo(ADoc_EnsureParas(idx), 0) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition GreaterThan(ADoc_Get(idx, ADocField.PARA_COUNT), 0) ThenBlock: {
            ReturnValue(1)
        }
        ADocPara.p = ADoc_ParaPtr(idx, 0)
        StoreValue(Add(ADocPara.p, ADocParaOff.KIND), 0)
        StoreValue(Add(ADocPara.p, ADocParaOff.INDENT), 0)
        StoreValue(Add(ADocPara.p, ADocParaOff.OFF0), 0)
        StoreValue(Add(ADocPara.p, ADocParaOff.ITEM), 0)
        ADoc_Set(idx, ADocField.PARA_COUNT, 1)
        ReturnValue(1)
    }
}

Function.ADoc_ParaOnInsert {
    Input: idx: Integer
    Input: off: Integer
    Input: slen: Integer
    Body: {
        IfCondition EqualTo(ADoc_Get(idx, ADocField.PARA_DATA), 0) ThenBlock: {
            ReturnValue(0)
        }
        ADocPara.idx = idx
        ADocPara.off = off
        ADocPara.n = slen
        ADocPara.i = 0
        ADocPara.end = ADoc_Get(ADocPara.idx, ADocField.PARA_COUNT)
        WhileLoop LessThan(ADocPara.i, ADocPara.end) {
            ADocPara.p = ADoc_ParaPtr(ADocPara.idx, ADocPara.i)
            IfCondition GreaterThan(Dereference(Add(ADocPara.p, ADocParaOff.OFF0)), ADocPara.off) ThenBlock: {
                StoreValue(Add(ADocPara.p, ADocParaOff.OFF0), Add(Dereference(Add(ADocPara.p, ADocParaOff.OFF0)), ADocPara.n))
            }
            ADocPara.i = Add(ADocPara.i, 1)
        }
    }
}

Function.ADoc_ParaOnDelete {
    Input: idx: Integer
    Input: off: Integer
    Input: n: Integer
    Body: {
        IfCondition EqualTo(ADoc_Get(idx, ADocField.PARA_DATA), 0) ThenBlock: {
            ReturnValue(0)
        }
        ADocPara.idx = idx
        ADocPara.off = off
        ADocPara.end = Add(off, n)
        ADocPara.n = n
        ADocPara.i = 0
        WhileLoop LessThan(ADocPara.i, ADoc_Get(ADocPara.idx, ADocField.PARA_COUNT)) {
            ADocPara.p = ADoc_ParaPtr(ADocPara.idx, ADocPara.i)
            ADocPara.item = Dereference(Add(ADocPara.p, ADocParaOff.OFF0))
            IfCondition GreaterEqual(ADocPara.item, ADocPara.end) ThenBlock: {
                StoreValue(Add(ADocPara.p, ADocParaOff.OFF0), Subtract(ADocPara.item, ADocPara.n))
                ADocPara.i = Add(ADocPara.i, 1)
            }
            ElseBlock: {
                IfCondition GreaterEqual(ADocPara.item, ADocPara.off) ThenBlock: {
                    ADoc_ParaRemove(ADocPara.idx, ADocPara.i)
                }
                ElseBlock: {
                    ADocPara.i = Add(ADocPara.i, 1)
                }
            }
        }
        IfCondition LessEqual(ADoc_Get(ADocPara.idx, ADocField.PARA_COUNT), 0) ThenBlock: {
            ADoc_ParaSeed(ADocPara.idx)
        }
    }
}

Function.ADoc_ParaRemove {
    Input: idx: Integer
    Input: at: Integer
    Body: {
        ADocPara.n = ADoc_Get(idx, ADocField.PARA_COUNT)
        IfCondition Or(LessThan(at, 0), GreaterEqual(at, ADocPara.n)) ThenBlock: {
            ReturnValue(0)
        }
        ADocPara.i = at
        WhileLoop LessThan(ADocPara.i, Subtract(ADocPara.n, 1)) {
            ADocPara.p = ADoc_ParaPtr(idx, ADocPara.i)
            ADocPara.run = ADoc_ParaPtr(idx, Add(ADocPara.i, 1))
            StoreValue(Add(ADocPara.p, ADocParaOff.KIND), Dereference(Add(ADocPara.run, ADocParaOff.KIND)))
            StoreValue(Add(ADocPara.p, ADocParaOff.INDENT), Dereference(Add(ADocPara.run, ADocParaOff.INDENT)))
            StoreValue(Add(ADocPara.p, ADocParaOff.OFF0), Dereference(Add(ADocPara.run, ADocParaOff.OFF0)))
            StoreValue(Add(ADocPara.p, ADocParaOff.ITEM), Dereference(Add(ADocPara.run, ADocParaOff.ITEM)))
            ADocPara.i = Add(ADocPara.i, 1)
        }
        ADoc_Set(idx, ADocField.PARA_COUNT, Subtract(ADocPara.n, 1))
    }
}

Function.ADoc_ParaInsert {
    Input: idx: Integer
    Input: at: Integer
    Input: off: Integer
    Input: kind: Integer
    Input: indent: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(ADoc_EnsureParas(idx), 0) ThenBlock: {
            ReturnValue(-1)
        }
        ADocPara.n = ADoc_Get(idx, ADocField.PARA_COUNT)
        IfCondition GreaterEqual(ADocPara.n, ADocConst.MAX_PARAS) ThenBlock: {
            ReturnValue(-1)
        }
        IfCondition LessThan(at, 0) ThenBlock: {
            at = 0
        }
        IfCondition GreaterThan(at, ADocPara.n) ThenBlock: {
            at = ADocPara.n
        }
        ADocPara.i = ADocPara.n
        WhileLoop GreaterThan(ADocPara.i, at) {
            ADocPara.p = ADoc_ParaPtr(idx, ADocPara.i)
            ADocPara.run = ADoc_ParaPtr(idx, Subtract(ADocPara.i, 1))
            StoreValue(Add(ADocPara.p, ADocParaOff.KIND), Dereference(Add(ADocPara.run, ADocParaOff.KIND)))
            StoreValue(Add(ADocPara.p, ADocParaOff.INDENT), Dereference(Add(ADocPara.run, ADocParaOff.INDENT)))
            StoreValue(Add(ADocPara.p, ADocParaOff.OFF0), Dereference(Add(ADocPara.run, ADocParaOff.OFF0)))
            StoreValue(Add(ADocPara.p, ADocParaOff.ITEM), Dereference(Add(ADocPara.run, ADocParaOff.ITEM)))
            ADocPara.i = Subtract(ADocPara.i, 1)
        }
        ADocPara.p = ADoc_ParaPtr(idx, at)
        StoreValue(Add(ADocPara.p, ADocParaOff.KIND), kind)
        StoreValue(Add(ADocPara.p, ADocParaOff.INDENT), indent)
        StoreValue(Add(ADocPara.p, ADocParaOff.OFF0), off)
        StoreValue(Add(ADocPara.p, ADocParaOff.ITEM), 0)
        ADoc_Set(idx, ADocField.PARA_COUNT, Add(ADocPara.n, 1))
        ReturnValue(at)
    }
}

Function.ADoc_ParaAtOff {
    Input: idx: Integer
    Input: off: Integer
    Output: Integer
    Body: {
        ADoc_ParaSeed(idx)
        ADocPara.idx = idx
        ADocPara.off = off
        ADocPara.n = ADoc_Get(idx, ADocField.PARA_COUNT)
        ADocPara.item = 0
        ADocPara.i = 0
        WhileLoop LessThan(ADocPara.i, ADocPara.n) {
            ADocPara.p = ADoc_ParaPtr(idx, ADocPara.i)
            IfCondition LessEqual(Dereference(Add(ADocPara.p, ADocParaOff.OFF0)), ADocPara.off) ThenBlock: {
                ADocPara.item = ADocPara.i
            }
            ADocPara.i = Add(ADocPara.i, 1)
        }
        ReturnValue(ADocPara.item)
    }
}

Function.ADoc_ParaContentLen {
    Input: idx: Integer
    Input: pi: Integer
    Output: Integer
    Body: {
        ADocPara.n = ADoc_Get(idx, ADocField.PARA_COUNT)
        ADocPara.rlen = ADoc_Get(idx, ADocField.RUN_LEN)
        ADocPara.off = Dereference(Add(ADoc_ParaPtr(idx, pi), ADocParaOff.OFF0))
        IfCondition LessThan(Add(pi, 1), ADocPara.n) ThenBlock: {
            ADocPara.end = Subtract(Dereference(Add(ADoc_ParaPtr(idx, Add(pi, 1)), ADocParaOff.OFF0)), 1)
        }
        ElseBlock: {
            ADocPara.end = ADocPara.rlen
        }
        IfCondition LessThan(ADocPara.end, ADocPara.off) ThenBlock: {
            ReturnValue(0)
        }
        ReturnValue(Subtract(ADocPara.end, ADocPara.off))
    }
}

Function.ADoc_ParaRenumber {
    Input: idx: Integer
    Body: {
        ADocPara.c0 = 0
        ADocPara.c1 = 0
        ADocPara.c2 = 0
        ADocPara.c3 = 0
        ADocPara.c4 = 0
        ADocPara.i = 0
        ADocPara.n = ADoc_Get(idx, ADocField.PARA_COUNT)
        WhileLoop LessThan(ADocPara.i, ADocPara.n) {
            ADocPara.p = ADoc_ParaPtr(idx, ADocPara.i)
            ADocPara.kind = Dereference(Add(ADocPara.p, ADocParaOff.KIND))
            ADocPara.indent = Dereference(Add(ADocPara.p, ADocParaOff.INDENT))
            IfCondition EqualTo(ADocPara.kind, ADocList.NUMBER) ThenBlock: {
                IfCondition LessThan(ADocPara.indent, 1) ThenBlock: {
                    ADocPara.indent = 1
                    StoreValue(Add(ADocPara.p, ADocParaOff.INDENT), 1)
                }
                IfCondition EqualTo(ADocPara.indent, 1) ThenBlock: { ADocPara.c1 = Add(ADocPara.c1, 1)  ADocPara.c2 = 0  ADocPara.c3 = 0  ADocPara.c4 = 0  StoreValue(Add(ADocPara.p, ADocParaOff.ITEM), ADocPara.c1) }
                IfCondition EqualTo(ADocPara.indent, 2) ThenBlock: { ADocPara.c2 = Add(ADocPara.c2, 1)  ADocPara.c3 = 0  ADocPara.c4 = 0  StoreValue(Add(ADocPara.p, ADocParaOff.ITEM), ADocPara.c2) }
                IfCondition EqualTo(ADocPara.indent, 3) ThenBlock: { ADocPara.c3 = Add(ADocPara.c3, 1)  ADocPara.c4 = 0  StoreValue(Add(ADocPara.p, ADocParaOff.ITEM), ADocPara.c3) }
                IfCondition EqualTo(ADocPara.indent, 4) ThenBlock: { ADocPara.c4 = Add(ADocPara.c4, 1)  StoreValue(Add(ADocPara.p, ADocParaOff.ITEM), ADocPara.c4) }
            }
            ElseBlock: {
                IfCondition EqualTo(ADocPara.kind, ADocList.BULLET) ThenBlock: {
                    IfCondition LessThan(ADocPara.indent, 1) ThenBlock: {
                        StoreValue(Add(ADocPara.p, ADocParaOff.INDENT), 1)
                    }
                    StoreValue(Add(ADocPara.p, ADocParaOff.ITEM), 0)
                }
                ElseBlock: {
                    ADocPara.c1 = 0
                    ADocPara.c2 = 0
                    ADocPara.c3 = 0
                    ADocPara.c4 = 0
                    StoreValue(Add(ADocPara.p, ADocParaOff.ITEM), 0)
                }
            }
            ADocPara.i = Add(ADocPara.i, 1)
        }
    }
}

Function.ADoc_ParaToggle {
    Input: idx: Integer
    Input: off: Integer
    Input: kind: Integer
    Body: {
        ADoc_ParaSeed(idx)
        ADocPara.i = ADoc_ParaAtOff(idx, off)
        ADocPara.p = ADoc_ParaPtr(idx, ADocPara.i)
        IfCondition EqualTo(Dereference(Add(ADocPara.p, ADocParaOff.KIND)), kind) ThenBlock: {
            StoreValue(Add(ADocPara.p, ADocParaOff.KIND), 0)
            StoreValue(Add(ADocPara.p, ADocParaOff.INDENT), 0)
        }
        ElseBlock: {
            StoreValue(Add(ADocPara.p, ADocParaOff.KIND), kind)
            IfCondition LessThan(Dereference(Add(ADocPara.p, ADocParaOff.INDENT)), 1) ThenBlock: {
                StoreValue(Add(ADocPara.p, ADocParaOff.INDENT), 1)
            }
        }
        ADoc_ParaRenumber(idx)
        ADoc_MarkDirty(idx)
    }
}

Function.ADoc_ParaIndent {
    Input: idx: Integer
    Input: off: Integer
    Input: delta: Integer
    Body: {
        ADoc_ParaSeed(idx)
        ADocPara.i = ADoc_ParaAtOff(idx, off)
        ADocPara.p = ADoc_ParaPtr(idx, ADocPara.i)
        ADocPara.indent = Add(Dereference(Add(ADocPara.p, ADocParaOff.INDENT)), delta)
        ADocPara.kind = Dereference(Add(ADocPara.p, ADocParaOff.KIND))
        IfCondition LessThan(ADocPara.indent, 0) ThenBlock: {
            ADocPara.indent = 0
        }
        IfCondition GreaterThan(ADocPara.indent, 4) ThenBlock: {
            ADocPara.indent = 4
        }
        IfCondition EqualTo(ADocPara.indent, 0) ThenBlock: {
            StoreValue(Add(ADocPara.p, ADocParaOff.KIND), 0)
        }
        ElseBlock: {
            IfCondition EqualTo(ADocPara.kind, 0) ThenBlock: {
                StoreValue(Add(ADocPara.p, ADocParaOff.KIND), ADocList.BULLET)
            }
        }
        StoreValue(Add(ADocPara.p, ADocParaOff.INDENT), ADocPara.indent)
        ADoc_ParaRenumber(idx)
        ADoc_MarkDirty(idx)
    }
}

Function.ADoc_ParaSplit {
    Input: idx: Integer
    Input: off: Integer
    Output: Integer
    Body: {
        ADoc_ParaSeed(idx)
        ADocPara.off = off
        ADocPara.i = ADoc_ParaAtOff(idx, ADocPara.off)
        ADocPara.p = ADoc_ParaPtr(idx, ADocPara.i)
        ADocPara.kind = Dereference(Add(ADocPara.p, ADocParaOff.KIND))
        ADocPara.indent = Dereference(Add(ADocPara.p, ADocParaOff.INDENT))
        ADoc_ParaInsert(idx, Add(ADocPara.i, 1), ADocPara.off, ADocPara.kind, ADocPara.indent)
        ADoc_ParaRenumber(idx)
        ReturnValue(1)
    }
}
