    "ML":           Initialize=56
    "SIZE_PT":      Initialize=64
    "PRINT_DPI":    Initialize=72
    "LAYOUT_INST":  Initialize=80
    "RUN_PTR":      Initialize=88
    "RUN_LEN":      Initialize=96
    "RUN_CAP":      Initialize=104
    "PAGE_COUNT":   Initialize=112
    "LINE_DATA":    Initialize=120
    "LINE_COUNT":   Initialize=128
    "BOLD":         Initialize=136
    "ITALIC":       Initialize=144
    "FLAGS":        Initialize=152
    "PG_ID":        Initialize=160
    "ALIGN":        Initialize=168
    "UNDERLINE":    Initialize=176
    "HDR_PTR":      Initialize=184
    "HDR_LEN":      Initialize=192
    "FTR_PTR":      Initialize=200
    "FTR_LEN":      Initialize=208
    "TAB_SP":       Initialize=216
    "FACE":         Initialize=224
    "PARA_DATA":    Initialize=232
