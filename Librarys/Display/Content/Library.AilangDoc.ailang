    "OFF0":     Initialize=0
    "OFF1":     Initialize=8
    "PAGE":     Initialize=16
    "X_PX":     Initialize=24
    "Y_PX":     Initialize=32
    "W_PX":     Initialize=40
    "MARK":     Initialize=48
    "ITEM":     Initialize=56
