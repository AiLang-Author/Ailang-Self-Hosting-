// Library.AilangDoc.ailang
// In-house document IR. Paper in points is the contract. UTF-8 run is the
// typewriter body. Not pixels, not TextBuffer, not Auckland HTML.
// Copyright © 2026 Sean Collins, 2 Paws Machine and Engineering. SCSL.

LibraryImport.Arena
LibraryImport.Display.Render.Fonts

// Paper ids match PageSurface.PaperType. FREE is not a document size.
FixedPool.DocPaper {
    "LETTER":  Initialize=1
    "LEGAL":   Initialize=2
    "A4":      Initialize=3
    "A3":      Initialize=4
    "FREE":    Initialize=5
    "CUSTOM":  Initialize=6
    "PORTRAIT":  Initialize=0
    "LANDSCAPE": Initialize=1
}

FixedPool.DocKind {
    "TEXT":   Initialize=1
    "IMAGE":  Initialize=2
    "TABLE":  Initialize=3
    "SKETCH": Initialize=4
    "CHART":  Initialize=5
    "OBJECT": Initialize=255
}

FixedPool.DocFlag {
    "LAYOUT_DIRTY": Initialize=1
}

FixedPool.ADocField {
    "PAPER":        Initialize=0
    "ORIENT":       Initialize=8
    "CUSTOM_W":     Initialize=16
    "CUSTOM_H":     Initialize=24
    "MT":           Initialize=32
    "MR":           Initialize=40
    "MB":           Initialize=48
    "ML":           Initialize=56
    "SIZE_PT":      Initialize=64
    "PRINT_DPI":    Initialize=72
    "LAYOUT_INST":  Initialize=80
    "RUN_PTR":      Initialize=88
    "RUN_LEN":      Initialize=96
    "RUN_CAP":      Initialize=104
    "PAGE_COUNT":   Initialize=112
    "LINE_DATA":    Initialize=120
    "LINE_COUNT":   Initialize=128
    "BOLD":         Initialize=136
    "ITALIC":       Initialize=144
    "FLAGS":        Initialize=152
    "PG_ID":        Initialize=160
    "ALIGN":        Initialize=168
    "UNDERLINE":    Initialize=176
    "HDR_PTR":      Initialize=184
    "HDR_LEN":      Initialize=192
    "FTR_PTR":      Initialize=200
    "FTR_LEN":      Initialize=208
}

FixedPool.ADocAlign {
    "LEFT":   Initialize=0
    "CENTER": Initialize=1
    "RIGHT":  Initialize=2
    "JUST":   Initialize=3
}

FixedPool.ADocConst {
    "REC_SIZE":     Initialize=216
    "MAX_DOCS":     Initialize=32
    "MAX_LINES":    Initialize=4096
    "LINE_SIZE":    Initialize=48
    "RUN_MIN":      Initialize=4096
    "LAYOUT_DPI":   Initialize=96
    "MARGIN_PT":    Initialize=72
    "SIZE_PT":      Initialize=12
}

FixedPool.DocLineOff {
    "OFF0":     Initialize=0
    "OFF1":     Initialize=8
    "PAGE":     Initialize=16
    "X_PX":     Initialize=24
    "Y_PX":     Initialize=32
    "W_PX":     Initialize=40
}

FixedPool.ADocTable {
    "data":  Initialize=0, CanChange=True
    "count": Initialize=0, CanChange=True
}

Function.ADoc_Init {
    Output: Integer
    Body: {
        IfCondition NotEqual(ADocTable.data, 0) ThenBlock: {
            ReturnValue(1)
        }
        sz = Multiply(ADocConst.MAX_DOCS, ADocConst.REC_SIZE)
        p = Allocate(sz)
        IfCondition EqualTo(p, 0) ThenBlock: {
            PrintMessage("[AilangDoc] alloc fail\n")
            ReturnValue(0)
        }
        MemorySet(p, 0, sz)
        ADocTable.data = p
        ADocTable.count = 0
        PrintMessage("[AilangDoc] init ok\n")
        ReturnValue(1)
    }
}

Function.ADoc_Ptr {
    Input: idx: Integer
    Output: Address
    Body: {
        ReturnValue(Add(ADocTable.data, Multiply(idx, ADocConst.REC_SIZE)))
    }
}

Function.ADoc_Get {
    Input: idx: Integer
    Input: field: Integer
    Output: Integer
    Body: {
        ReturnValue(Dereference(Add(ADoc_Ptr(idx), field)))
    }
}

Function.ADoc_Set {
    Input: idx: Integer
    Input: field: Integer
    Input: val: Integer
    Body: {
        StoreValue(Add(ADoc_Ptr(idx), field), val)
    }
}

Function.ADoc_Create {
    Input: paper: Integer
    Input: orient: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(ADocTable.data, 0) ThenBlock: {
            ADoc_Init()
        }
        idx = ADocTable.count
        IfCondition GreaterEqual(idx, ADocConst.MAX_DOCS) ThenBlock: {
            PrintMessage("[AilangDoc] table full\n")
            ReturnValue(-1)
        }
        ADocTable.count = Add(idx, 1)
        ADoc_Set(idx, ADocField.PAPER, paper)
        ADoc_Set(idx, ADocField.ORIENT, orient)
        ADoc_Set(idx, ADocField.CUSTOM_W, 0)
        ADoc_Set(idx, ADocField.CUSTOM_H, 0)
        ADoc_Set(idx, ADocField.MT, ADocConst.MARGIN_PT)
        ADoc_Set(idx, ADocField.MR, ADocConst.MARGIN_PT)
        ADoc_Set(idx, ADocField.MB, ADocConst.MARGIN_PT)
        ADoc_Set(idx, ADocField.ML, ADocConst.MARGIN_PT)
        ADoc_Set(idx, ADocField.SIZE_PT, ADocConst.SIZE_PT)
        ADoc_Set(idx, ADocField.PRINT_DPI, ADocConst.LAYOUT_DPI)
        ADoc_Set(idx, ADocField.LAYOUT_INST, -1)
        ADoc_Set(idx, ADocField.RUN_PTR, 0)
        ADoc_Set(idx, ADocField.RUN_LEN, 0)
        ADoc_Set(idx, ADocField.RUN_CAP, 0)
        ADoc_Set(idx, ADocField.PAGE_COUNT, 1)
        ADoc_Set(idx, ADocField.LINE_DATA, 0)
        ADoc_Set(idx, ADocField.LINE_COUNT, 0)
        ADoc_Set(idx, ADocField.BOLD, 0)
        ADoc_Set(idx, ADocField.ITALIC, 0)
        ADoc_Set(idx, ADocField.FLAGS, DocFlag.LAYOUT_DIRTY)
        ADoc_Set(idx, ADocField.PG_ID, 0)
        ADoc_Set(idx, ADocField.ALIGN, ADocAlign.LEFT)
        ADoc_Set(idx, ADocField.UNDERLINE, 0)
        ADoc_Set(idx, ADocField.HDR_PTR, 0)
        ADoc_Set(idx, ADocField.HDR_LEN, 0)
        ADoc_Set(idx, ADocField.FTR_PTR, 0)
        ADoc_Set(idx, ADocField.FTR_LEN, 0)
        ReturnValue(idx)
    }
}

Function.ADoc_SetCustom {
    Input: idx: Integer
    Input: w_pt: Integer
    Input: h_pt: Integer
    Body: {
        ADoc_Set(idx, ADocField.PAPER, DocPaper.CUSTOM)
        ADoc_Set(idx, ADocField.CUSTOM_W, w_pt)
        ADoc_Set(idx, ADocField.CUSTOM_H, h_pt)
        ADoc_Set(idx, ADocField.FLAGS, DocFlag.LAYOUT_DIRTY)
    }
}

Function.ADoc_MarkDirty {
    Input: idx: Integer
    Body: {
        f = ADoc_Get(idx, ADocField.FLAGS)
        ADoc_Set(idx, ADocField.FLAGS, BitwiseOr(f, DocFlag.LAYOUT_DIRTY))
    }
}

Function.ADoc_EnsureLines {
    Input: idx: Integer
    Output: Integer
    Body: {
        p = ADoc_Get(idx, ADocField.LINE_DATA)
        IfCondition NotEqual(p, 0) ThenBlock: {
            ReturnValue(p)
        }
        n = Multiply(ADocConst.MAX_LINES, ADocConst.LINE_SIZE)
        p = Allocate(n)
        IfCondition EqualTo(p, 0) ThenBlock: {
            ReturnValue(0)
        }
        MemorySet(p, 0, n)
        ADoc_Set(idx, ADocField.LINE_DATA, p)
        ReturnValue(p)
    }
}

Function.ADoc_LinePtr {
    Input: idx: Integer
    Input: li: Integer
    Output: Address
    Body: {
        base = ADoc_Get(idx, ADocField.LINE_DATA)
        ReturnValue(Add(base, Multiply(li, ADocConst.LINE_SIZE)))
    }
}

Function.ADoc_RunGrow {
    Input: idx: Integer
    Input: need: Integer
    Output: Integer
    Body: {
        cap = ADoc_Get(idx, ADocField.RUN_CAP)
        IfCondition GreaterEqual(cap, need) ThenBlock: {
            ReturnValue(1)
        }
        ncap = ADocConst.RUN_MIN
        IfCondition GreaterThan(cap, 0) ThenBlock: {
            ncap = cap
        }
        WhileLoop LessThan(ncap, need) {
            ncap = Multiply(ncap, 2)
        }
        nb = Allocate(ncap)
        IfCondition EqualTo(nb, 0) ThenBlock: {
            PrintMessage("[AilangDoc] run alloc fail\n")
            ReturnValue(0)
        }
        MemorySet(nb, 0, ncap)
        old = ADoc_Get(idx, ADocField.RUN_PTR)
        olen = ADoc_Get(idx, ADocField.RUN_LEN)
        IfCondition GreaterThan(olen, 0) ThenBlock: {
            ci = 0
            WhileLoop LessThan(ci, olen) {
                SetByte(nb, ci, GetByte(old, ci))
                ci = Add(ci, 1)
            }
        }
        IfCondition NotEqual(old, 0) ThenBlock: {
            Deallocate(old, cap)
        }
        ADoc_Set(idx, ADocField.RUN_PTR, nb)
        ADoc_Set(idx, ADocField.RUN_CAP, ncap)
        ReturnValue(1)
    }
}

Function.ADoc_Append {
    Input: idx: Integer
    Input: src: Address
    Input: slen: Integer
    Output: Integer
    Body: {
        IfCondition LessEqual(slen, 0) ThenBlock: {
            ReturnValue(1)
        }
        olen = ADoc_Get(idx, ADocField.RUN_LEN)
        need = Add(olen, slen)
        ok = ADoc_RunGrow(idx, Add(need, 1))
        IfCondition EqualTo(ok, 0) ThenBlock: {
            ReturnValue(0)
        }
        dst = ADoc_Get(idx, ADocField.RUN_PTR)
        si = 0
        WhileLoop LessThan(si, slen) {
            SetByte(dst, Add(olen, si), GetByte(src, si))
            si = Add(si, 1)
        }
        SetByte(dst, need, 0)
        ADoc_Set(idx, ADocField.RUN_LEN, need)
        ADoc_MarkDirty(idx)
        ReturnValue(1)
    }
}

Function.ADoc_ClearRun {
    Input: idx: Integer
    Body: {
        ADoc_Set(idx, ADocField.RUN_LEN, 0)
        ADoc_Set(idx, ADocField.PAGE_COUNT, 1)
        ADoc_Set(idx, ADocField.LINE_COUNT, 0)
        ADoc_MarkDirty(idx)
    }
}

FixedPool.ADocEdit {
    "one": Initialize=0, CanChange=True
}

Function.ADoc_InsertAt {
    Input: idx: Integer
    Input: off: Integer
    Input: src: Address
    Input: slen: Integer
    Output: Integer
    Body: {
        IfCondition LessEqual(slen, 0) ThenBlock: {
            ReturnValue(1)
        }
        olen = ADoc_Get(idx, ADocField.RUN_LEN)
        IfCondition LessThan(off, 0) ThenBlock: {
            off = 0
        }
        IfCondition GreaterThan(off, olen) ThenBlock: {
            off = olen
        }
        need = Add(olen, slen)
        ok = ADoc_RunGrow(idx, Add(need, 1))
        IfCondition EqualTo(ok, 0) ThenBlock: {
            ReturnValue(0)
        }
        dst = ADoc_Get(idx, ADocField.RUN_PTR)
        i = Subtract(olen, 1)
        WhileLoop GreaterEqual(i, off) {
            SetByte(dst, Add(i, slen), GetByte(dst, i))
            i = Subtract(i, 1)
        }
        si = 0
        WhileLoop LessThan(si, slen) {
            SetByte(dst, Add(off, si), GetByte(src, si))
            si = Add(si, 1)
        }
        SetByte(dst, need, 0)
        ADoc_Set(idx, ADocField.RUN_LEN, need)
        ADoc_MarkDirty(idx)
        ReturnValue(1)
    }
}

Function.ADoc_DeleteRange {
    Input: idx: Integer
    Input: off: Integer
    Input: n: Integer
    Body: {
        olen = ADoc_Get(idx, ADocField.RUN_LEN)
        IfCondition LessEqual(n, 0) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition LessThan(off, 0) ThenBlock: {
            off = 0
        }
        IfCondition GreaterEqual(off, olen) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition GreaterThan(Add(off, n), olen) ThenBlock: {
            n = Subtract(olen, off)
        }
        dst = ADoc_Get(idx, ADocField.RUN_PTR)
        i = off
        lim = Subtract(olen, n)
        WhileLoop LessThan(i, lim) {
            SetByte(dst, i, GetByte(dst, Add(i, n)))
            i = Add(i, 1)
        }
        ADoc_Set(idx, ADocField.RUN_LEN, Subtract(olen, n))
        ADoc_MarkDirty(idx)
    }
}

Function.ADoc_InsertByte {
    Input: idx: Integer
    Input: off: Integer
    Input: ch: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(ADocEdit.one, 0) ThenBlock: {
            ADocEdit.one = Allocate(8)
        }
        SetByte(ADocEdit.one, 0, ch)
        ReturnValue(ADoc_InsertAt(idx, off, ADocEdit.one, 1))
    }
}

Function.ADoc_SetBand {
    Input: idx: Integer
    Input: ptr_field: Integer
    Input: len_field: Integer
    Input: src: Address
    Input: slen: Integer
    Body: {
        old = ADoc_Get(idx, ptr_field)
        olen = ADoc_Get(idx, len_field)
        IfCondition NotEqual(old, 0) ThenBlock: {
            Deallocate(old, Add(olen, 1))
        }
        IfCondition Or(EqualTo(src, 0), LessEqual(slen, 0)) ThenBlock: {
            ADoc_Set(idx, ptr_field, 0)
            ADoc_Set(idx, len_field, 0)
            ADoc_MarkDirty(idx)
            ReturnValue(0)
        }
        p = Allocate(Add(slen, 1))
        IfCondition EqualTo(p, 0) ThenBlock: {
            ADoc_Set(idx, ptr_field, 0)
            ADoc_Set(idx, len_field, 0)
            ReturnValue(0)
        }
        si = 0
        WhileLoop LessThan(si, slen) {
            SetByte(p, si, GetByte(src, si))
            si = Add(si, 1)
        }
        SetByte(p, slen, 0)
        ADoc_Set(idx, ptr_field, p)
        ADoc_Set(idx, len_field, slen)
        ADoc_MarkDirty(idx)
    }
}
