    "REC_SIZE":     Initialize=248
    "MAX_DOCS":     Initialize=32
    "MAX_LINES":    Initialize=4096
    "LINE_SIZE":    Initialize=72
    "MAX_PARAS":    Initialize=1024
    "PARA_SIZE":    Initialize=32
    "RUN_MIN":      Initialize=4096
