    "LETTER":  Initialize=1
    "LEGAL":   Initialize=2
    "A4":      Initialize=3
    "A3":      Initialize=4
    "FREE":    Initialize=5
    "CUSTOM":  Initialize=6
    "PORTRAIT":  Initialize=0
    "LANDSCAPE": Initialize=1
}

FixedPool.DocKind {
    "TEXT":   Initialize=1
    "IMAGE":  Initialize=2
    "TABLE":  Initialize=3
    "SKETCH": Initialize=4
    "CHART":  Initialize=5
    "OBJECT": Initialize=255
}

