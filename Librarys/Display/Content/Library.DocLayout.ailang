// Library.DocLayout.ailang
// One paper solver + typewriter wrap/paginate/hit.
// Running y is LAYOUT_DPI pixels. Points only at DocPaper_*.
// Copyright © 2026 Sean Collins, 2 Paws Machine and Engineering. SCSL.

LibraryImport.Arena
LibraryImport.Display.Render.Fonts
LibraryImport.Display.Content.AilangDoc

FixedPool.DocPaperOut {
    "w": Initialize=0, CanChange=True
    "h": Initialize=0, CanChange=True
    "cw": Initialize=0, CanChange=True
    "ch": Initialize=0, CanChange=True
}

FixedPool.DocWrap {
    "inst":    Initialize=0, CanChange=True
    "run":     Initialize=0, CanChange=True
    "rlen":    Initialize=0, CanChange=True
    "cw":      Initialize=0, CanChange=True
    "ch":      Initialize=0, CanChange=True
    "lh":      Initialize=0, CanChange=True
    "start":   Initialize=0, CanChange=True
    "off":     Initialize=0, CanChange=True
    "page":    Initialize=0, CanChange=True
    "y":       Initialize=0, CanChange=True
    "nlines":  Initialize=0, CanChange=True
    "maxpage": Initialize=0, CanChange=True
    "doc":     Initialize=0, CanChange=True
    "align":   Initialize=0, CanChange=True
}

FixedPool.DocLayConst {
    "PAGE_GAP_PX": Initialize=16
    "MAX_PAGES":   Initialize=256
}

Function.DocPaper_SizePt {
    Input: paper: Integer
    Input: orient: Integer
    Input: custom_w_pt: Integer
    Input: custom_h_pt: Integer
    Input: out_w: Address
    Input: out_h: Address
    Output: Integer
    Body: {
        w = 0
        h = 0
        IfCondition EqualTo(paper, DocPaper.LETTER) ThenBlock: {
            w = 612
            h = 792
        }
        IfCondition EqualTo(paper, DocPaper.LEGAL) ThenBlock: {
            w = 612
            h = 1008
        }
        IfCondition EqualTo(paper, DocPaper.A4) ThenBlock: {
            w = 595
            h = 842
        }
        IfCondition EqualTo(paper, DocPaper.A3) ThenBlock: {
            w = 842
            h = 1191
        }
        IfCondition EqualTo(paper, DocPaper.CUSTOM) ThenBlock: {
            IfCondition Or(LessEqual(custom_w_pt, 0), LessEqual(custom_h_pt, 0)) ThenBlock: {
                ReturnValue(0)
            }
            w = custom_w_pt
            h = custom_h_pt
        }
        IfCondition EqualTo(w, 0) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition EqualTo(orient, DocPaper.LANDSCAPE) ThenBlock: {
            t = w
            w = h
            h = t
        }
        DocPaperOut.w = w
        DocPaperOut.h = h
        IfCondition NotEqual(out_w, 0) ThenBlock: {
            StoreValue(out_w, w)
        }
        IfCondition NotEqual(out_h, 0) ThenBlock: {
            StoreValue(out_h, h)
        }
        ReturnValue(1)
    }
}

Function.DocPaper_ContentBox {
    Input: w: Integer
    Input: h: Integer
    Input: mt: Integer
    Input: mr: Integer
    Input: mb: Integer
    Input: ml: Integer
    Output: Integer
    Body: {
        cw = Subtract(w, Add(ml, mr))
        ch = Subtract(h, Add(mt, mb))
        IfCondition Or(LessThan(cw, 1), LessThan(ch, 1)) ThenBlock: {
            ReturnValue(0)
        }
        DocPaperOut.cw = cw
        DocPaperOut.ch = ch
        ReturnValue(1)
    }
}

Function.DocLayout_PtToPx {
    Input: pt: Integer
    Output: Integer
    Body: {
        ReturnValue(Divide(Multiply(pt, ADocConst.LAYOUT_DPI), 72))
    }
}

Function.DocLayout_Bind {
    Input: doc: Integer
    Output: Integer
    Body: {
        face = FontState.doc_face
        IfCondition LessThan(face, 0) ThenBlock: {
            face = FontState.default_face
        }
        IfCondition LessThan(face, 0) ThenBlock: {
            PrintMessage("[DocLayout] no face\n")
            ReturnValue(-1)
        }
        spt = ADoc_Get(doc, ADocField.SIZE_PT)
        IfCondition LessEqual(spt, 0) ThenBlock: {
            spt = ADocConst.SIZE_PT
        }
        gpx = DocLayout_PtToPx(spt)
        inst = VFont_CreateInstance(face, gpx)
        ADoc_Set(doc, ADocField.LAYOUT_INST, inst)
        ReturnValue(inst)
    }
}

Function.DocLayout_AdvanceY {
    Body: {
        DocWrap.y = Add(DocWrap.y, DocWrap.lh)
        lim = DocWrap.ch
        IfCondition GreaterThan(Add(DocWrap.y, DocWrap.lh), lim) ThenBlock: {
            np = Add(DocWrap.page, 1)
            IfCondition LessThan(np, DocLayConst.MAX_PAGES) ThenBlock: {
                DocWrap.page = np
                DocWrap.y = 0
                IfCondition GreaterThan(np, DocWrap.maxpage) ThenBlock: {
                    DocWrap.maxpage = np
                }
            }
        }
    }
}

Function.DocLayout_Emit {
    Input: off0: Integer
    Input: off1: Integer
    Body: {
        IfCondition GreaterEqual(DocWrap.nlines, ADocConst.MAX_LINES) ThenBlock: {
            ReturnValue(0)
        }
        wpx = 0
        IfCondition GreaterThan(off1, off0) ThenBlock: {
            wpx = VInst_MeasureWidth(DocWrap.inst, Add(DocWrap.run, off0), Subtract(off1, off0))
        }
        xp = 0
        IfCondition EqualTo(DocWrap.align, ADocAlign.CENTER) ThenBlock: {
            xp = Divide(Subtract(DocWrap.cw, wpx), 2)
        }
        IfCondition EqualTo(DocWrap.align, ADocAlign.RIGHT) ThenBlock: {
            xp = Subtract(DocWrap.cw, wpx)
        }
        IfCondition LessThan(xp, 0) ThenBlock: {
            xp = 0
        }
        lp = ADoc_LinePtr(DocWrap.doc, DocWrap.nlines)
        StoreValue(Add(lp, DocLineOff.OFF0), off0)
        StoreValue(Add(lp, DocLineOff.OFF1), off1)
        StoreValue(Add(lp, DocLineOff.PAGE), DocWrap.page)
        StoreValue(Add(lp, DocLineOff.X_PX), xp)
        StoreValue(Add(lp, DocLineOff.Y_PX), DocWrap.y)
        StoreValue(Add(lp, DocLineOff.W_PX), wpx)
        DocWrap.nlines = Add(DocWrap.nlines, 1)
        DocLayout_AdvanceY()
    }
}

Function.DocLayout_MeasureRange {
    Input: a: Integer
    Input: b: Integer
    Output: Integer
    Body: {
        IfCondition LessEqual(b, a) ThenBlock: {
            ReturnValue(0)
        }
        ReturnValue(VInst_MeasureWidth(DocWrap.inst, Add(DocWrap.run, a), Subtract(b, a)))
    }
}

Function.DocLayout_SplitOverlong {
    Input: a: Integer
    Input: b: Integer
    Output: Integer
    Body: {
        // Last byte in [a,b) that still fits content width.
        cut = Add(a, 1)
        i = Add(a, 1)
        WhileLoop LessEqual(i, b) {
            mw = DocLayout_MeasureRange(a, i)
            IfCondition GreaterThan(mw, DocWrap.cw) ThenBlock: {
                i = Add(b, 1)
            }
            ElseBlock: {
                cut = i
                i = Add(i, 1)
            }
        }
        IfCondition LessEqual(cut, a) ThenBlock: {
            cut = Add(a, 1)
        }
        ReturnValue(cut)
    }
}

Function.DocLayout_FlushTo {
    Input: end: Integer
    Body: {
        DocLayout_Emit(DocWrap.start, end)
        DocWrap.start = end
    }
}

Function.DocLayout_WrapBody {
    Body: {
        DocWrap.start = 0
        DocWrap.off = 0
        DocWrap.page = 0
        DocWrap.y = 0
        DocWrap.nlines = 0
        DocWrap.maxpage = 0
        rlen = DocWrap.rlen
        WhileLoop LessThan(DocWrap.off, rlen) {
            ch = GetByte(DocWrap.run, DocWrap.off)
            IfCondition EqualTo(ch, 13) ThenBlock: {
                DocWrap.off = Add(DocWrap.off, 1)
            }
            ElseBlock: {
                IfCondition EqualTo(ch, 10) ThenBlock: {
                    DocLayout_FlushTo(DocWrap.off)
                    DocWrap.off = Add(DocWrap.off, 1)
                    DocWrap.start = DocWrap.off
                }
                ElseBlock: {
                    prev = DocWrap.off
                    DocLayout_TakeTok()
                    IfCondition LessEqual(DocWrap.off, prev) ThenBlock: {
                        DocWrap.off = Add(prev, 1)
                    }
                }
            }
        }
        IfCondition LessThan(DocWrap.start, rlen) ThenBlock: {
            DocLayout_FlushTo(rlen)
        }
    }
}

Function.DocLayout_WordEnd {
    Input: i: Integer
    Output: Integer
    Body: {
        rlen = DocWrap.rlen
        WhileLoop LessThan(i, rlen) {
            b = GetByte(DocWrap.run, i)
            IfCondition EqualTo(b, 32) ThenBlock: {
                ReturnValue(i)
            }
            IfCondition EqualTo(b, 10) ThenBlock: {
                ReturnValue(i)
            }
            IfCondition EqualTo(b, 13) ThenBlock: {
                ReturnValue(i)
            }
            i = Add(i, 1)
        }
        ReturnValue(rlen)
    }
}

Function.DocLayout_TakeTok {
    Body: {
        i = DocWrap.off
        IfCondition EqualTo(GetByte(DocWrap.run, i), 32) ThenBlock: {
            IfCondition GreaterThan(i, DocWrap.start) ThenBlock: {
                sp = i
                we = DocLayout_WordEnd(Add(i, 1))
                mw = DocLayout_MeasureRange(DocWrap.start, we)
                IfCondition GreaterThan(mw, DocWrap.cw) ThenBlock: {
                    DocLayout_FlushTo(sp)
                    DocWrap.start = Add(sp, 1)
                    DocWrap.off = DocWrap.start
                    ReturnValue(0)
                }
                DocWrap.off = we
                ReturnValue(0)
            }
        }
        we = DocLayout_WordEnd(i)
        mw = DocLayout_MeasureRange(DocWrap.start, we)
        IfCondition GreaterThan(mw, DocWrap.cw) ThenBlock: {
            IfCondition GreaterThan(i, DocWrap.start) ThenBlock: {
                DocLayout_FlushTo(i)
                DocWrap.off = i
                ReturnValue(0)
            }
            IfCondition GreaterThan(we, i) ThenBlock: {
                cut = DocLayout_SplitOverlong(i, we)
                DocLayout_FlushTo(cut)
                DocWrap.off = cut
                ReturnValue(0)
            }
        }
        IfCondition EqualTo(we, i) ThenBlock: {
            DocWrap.off = Add(i, 1)
        }
        ElseBlock: {
            DocWrap.off = we
        }
    }
}

Function.DocLayout_Paginate {
    Input: doc: Integer
    Output: Integer
    Body: {
        DocWrap.doc = doc
        inst = DocLayout_Bind(DocWrap.doc)
        IfCondition LessThan(inst, 0) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition EqualTo(ADoc_EnsureLines(DocWrap.doc), 0) ThenBlock: {
            ReturnValue(0)
        }
        ppr = ADoc_Get(DocWrap.doc, ADocField.PAPER)
        por = ADoc_Get(DocWrap.doc, ADocField.ORIENT)
        pcw = ADoc_Get(DocWrap.doc, ADocField.CUSTOM_W)
        pch = ADoc_Get(DocWrap.doc, ADocField.CUSTOM_H)
        ok = DocPaper_SizePt(ppr, por, pcw, pch, 0, 0)
        IfCondition EqualTo(ok, 0) ThenBlock: {
            PrintMessage("[DocLayout] bad paper\n")
            ReturnValue(0)
        }
        mt = ADoc_Get(DocWrap.doc, ADocField.MT)
        mr = ADoc_Get(DocWrap.doc, ADocField.MR)
        mb = ADoc_Get(DocWrap.doc, ADocField.MB)
        ml = ADoc_Get(DocWrap.doc, ADocField.ML)
        pw = DocPaperOut.w
        ph = DocPaperOut.h
        ok = DocPaper_ContentBox(pw, ph, mt, mr, mb, ml)
        IfCondition EqualTo(ok, 0) ThenBlock: {
            ReturnValue(0)
        }
        DocWrap.inst = inst
        DocWrap.align = ADoc_Get(DocWrap.doc, ADocField.ALIGN)
        DocWrap.run = ADoc_Get(DocWrap.doc, ADocField.RUN_PTR)
        DocWrap.rlen = ADoc_Get(DocWrap.doc, ADocField.RUN_LEN)
        DocWrap.cw = DocLayout_PtToPx(DocPaperOut.cw)
        DocWrap.ch = DocLayout_PtToPx(DocPaperOut.ch)
        DocWrap.lh = VInst_GetLineHeight(inst)
        IfCondition LessEqual(DocWrap.lh, 0) ThenBlock: {
            DocWrap.lh = 16
        }
        IfCondition EqualTo(DocWrap.rlen, 0) ThenBlock: {
            ADoc_Set(DocWrap.doc, ADocField.LINE_COUNT, 0)
            ADoc_Set(DocWrap.doc, ADocField.PAGE_COUNT, 1)
            ADoc_Set(DocWrap.doc, ADocField.FLAGS, 0)
            ReturnValue(1)
        }
        DocLayout_WrapBody()
        pc = Add(DocWrap.maxpage, 1)
        IfCondition EqualTo(DocWrap.nlines, 0) ThenBlock: {
            pc = 1
        }
        ADoc_Set(DocWrap.doc, ADocField.LINE_COUNT, DocWrap.nlines)
        ADoc_Set(DocWrap.doc, ADocField.PAGE_COUNT, pc)
        ADoc_Set(DocWrap.doc, ADocField.FLAGS, 0)
        ReturnValue(1)
    }
}

Function.DocLayout_LineAtOff {
    Input: doc: Integer
    Input: off: Integer
    Output: Integer
    Body: {
        DocWrap.doc = doc
        DocWrap.start = off
        DocWrap.rlen = ADoc_Get(DocWrap.doc, ADocField.LINE_COUNT)
        DocWrap.nlines = -1
        DocWrap.off = 0
        WhileLoop LessThan(DocWrap.off, DocWrap.rlen) {
            lp = ADoc_LinePtr(DocWrap.doc, DocWrap.off)
            o0 = Dereference(Add(lp, DocLineOff.OFF0))
            o1 = Dereference(Add(lp, DocLineOff.OFF1))
            IfCondition And(GreaterEqual(DocWrap.start, o0), LessEqual(DocWrap.start, o1)) ThenBlock: {
                DocWrap.nlines = DocWrap.off
            }
            DocWrap.off = Add(DocWrap.off, 1)
        }
        IfCondition And(LessThan(DocWrap.nlines, 0), GreaterThan(DocWrap.rlen, 0)) ThenBlock: {
            DocWrap.nlines = Subtract(DocWrap.rlen, 1)
        }
        ReturnValue(DocWrap.nlines)
    }
}

Function.DocLayout_Hit {
    Input: doc: Integer
    Input: page_idx: Integer
    Input: content_x_px: Integer
    Input: content_y_px: Integer
    Output: Integer
    Body: {
        n = ADoc_Get(doc, ADocField.LINE_COUNT)
        inst = ADoc_Get(doc, ADocField.LAYOUT_INST)
        run = ADoc_Get(doc, ADocField.RUN_PTR)
        lh = VInst_GetLineHeight(inst)
        last = 0
        i = 0
        WhileLoop LessThan(i, n) {
            lp = ADoc_LinePtr(doc, i)
            pg = Dereference(Add(lp, DocLineOff.PAGE))
            IfCondition EqualTo(pg, page_idx) ThenBlock: {
                y = Dereference(Add(lp, DocLineOff.Y_PX))
                o0 = Dereference(Add(lp, DocLineOff.OFF0))
                o1 = Dereference(Add(lp, DocLineOff.OFF1))
                last = o1
                IfCondition And(GreaterEqual(content_y_px, y), LessThan(content_y_px, Add(y, lh))) ThenBlock: {
                    sl = Subtract(o1, o0)
                    col = VInst_PixelToCol(inst, Add(run, o0), sl, content_x_px)
                    ReturnValue(Add(o0, col))
                }
            }
            i = Add(i, 1)
        }
        ReturnValue(last)
    }
}
