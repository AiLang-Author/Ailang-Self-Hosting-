// Library.DocSess.ailang
// Document facility sessions. Handle = idx | (gen<<16), gen starts at 1
// so extra 0 is never a valid session.
// Copyright © 2026 Sean Collins, 2 Paws Machine and Engineering. SCSL.

LibraryImport.Arena
LibraryImport.Display.UI.Auckland
LibraryImport.Display.Content.AilangDoc

FixedPool.DocSessOff {
    "DOC_ID":    Initialize=0
    "FILE_ID":   Initialize=8
    "FLAGS":     Initialize=16
    "CARET_OFF": Initialize=24
    "SEL_A":     Initialize=32
    "SEL_B":     Initialize=40
    "SCROLL_X":  Initialize=48
    "SCROLL_Y":  Initialize=56
    "WIN_ID":    Initialize=64
    "JOB":       Initialize=72
    "NODE_ID":   Initialize=80
    "GEN":       Initialize=88
    "PAPER":     Initialize=96
    "ORIENT":    Initialize=104
}

FixedPool.DocSessFlag {
    "DIRTY":        Initialize=1
    "NAMED":        Initialize=2
    "READONLY":     Initialize=4
    "WAS_PLAIN":    Initialize=8
    "LAYOUT_DIRTY": Initialize=16
}

FixedPool.DocSessConst {
    "REC_SIZE":  Initialize=128
    "MAX":       Initialize=32
    "GEN_MUL":   Initialize=65536
}

FixedPool.DocSessTable {
    "data":  Initialize=0, CanChange=True
    "ready": Initialize=0, CanChange=True
    "slot":  Initialize=0, CanChange=True
}

Function.DocFacility_Ensure {
    Output: Integer
    Body: {
        IfCondition EqualTo(DocSessTable.ready, 1) ThenBlock: {
            ReturnValue(1)
        }
        ADoc_Init()
        sz = Multiply(DocSessConst.MAX, DocSessConst.REC_SIZE)
        p = Allocate(sz)
        IfCondition EqualTo(p, 0) ThenBlock: {
            PrintMessage("[DocSess] alloc fail\n")
            ReturnValue(0)
        }
        MemorySet(p, 0, sz)
        DocSessTable.data = p
        DocSessTable.ready = 1
        PrintMessage("[DocSess] ensure ok\n")
        ReturnValue(1)
    }
}

Function.DocSess_Ptr {
    Input: idx: Integer
    Output: Address
    Body: {
        ReturnValue(Add(DocSessTable.data, Multiply(idx, DocSessConst.REC_SIZE)))
    }
}

Function.DocSess_Get {
    Input: idx: Integer
    Input: field: Integer
    Output: Integer
    Body: {
        ReturnValue(Dereference(Add(DocSess_Ptr(idx), field)))
    }
}

Function.DocSess_Set {
    Input: idx: Integer
    Input: field: Integer
    Input: val: Integer
    Body: {
        StoreValue(Add(DocSess_Ptr(idx), field), val)
    }
}

Function.DocSess_Idx {
    Input: sess: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(sess, 0) ThenBlock: {
            ReturnValue(-1)
        }
        IfCondition EqualTo(DocSessTable.ready, 0) ThenBlock: {
            ReturnValue(-1)
        }
        idx = Modulo(sess, DocSessConst.GEN_MUL)
        IfCondition GreaterEqual(idx, DocSessConst.MAX) ThenBlock: {
            ReturnValue(-1)
        }
        gen = Divide(sess, DocSessConst.GEN_MUL)
        got = DocSess_Get(idx, DocSessOff.GEN)
        IfCondition NotEqual(got, gen) ThenBlock: {
            ReturnValue(-1)
        }
        ReturnValue(idx)
    }
}

Function.DocSess_Handle {
    Input: idx: Integer
    Output: Integer
    Body: {
        gen = DocSess_Get(idx, DocSessOff.GEN)
        ReturnValue(Add(idx, Multiply(gen, DocSessConst.GEN_MUL)))
    }
}

Function.DocSess_Create {
    Input: paper: Integer
    Input: orient: Integer
    Output: Integer
    Body: {
        ok = DocFacility_Ensure()
        IfCondition EqualTo(ok, 0) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition EqualTo(paper, 0) ThenBlock: {
            paper = DocPaper.LETTER
        }
        IfCondition EqualTo(paper, DocPaper.FREE) ThenBlock: {
            paper = DocPaper.LETTER
        }
        IfCondition EqualTo(paper, DocPaper.CUSTOM) ThenBlock: {
            paper = DocPaper.LETTER
        }
        idx = 0
        DocSessTable.slot = -1
        WhileLoop LessThan(idx, DocSessConst.MAX) {
            IfCondition EqualTo(DocSess_Get(idx, DocSessOff.GEN), 0) ThenBlock: {
                DocSessTable.slot = idx
                idx = DocSessConst.MAX
            }
            ElseBlock: {
                idx = Add(idx, 1)
            }
        }
        IfCondition LessThan(DocSessTable.slot, 0) ThenBlock: {
            PrintMessage("[DocSess] table full\n")
            ReturnValue(0)
        }
        did = ADoc_Create(paper, orient)
        IfCondition LessThan(did, 0) ThenBlock: {
            ReturnValue(0)
        }
        DocSess_FillNew(did, paper, orient)
        ReturnValue(DocSess_Handle(DocSessTable.slot))
    }
}

Function.DocSess_FillNew {
    Input: did: Integer
    Input: paper: Integer
    Input: orient: Integer
    Body: {
        found = DocSessTable.slot
        DocSess_Set(found, DocSessOff.DOC_ID, did)
        DocSess_Set(found, DocSessOff.FILE_ID, 0)
        DocSess_Set(found, DocSessOff.FLAGS, DocSessFlag.LAYOUT_DIRTY)
        DocSess_Set(found, DocSessOff.CARET_OFF, 0)
        DocSess_Set(found, DocSessOff.SEL_A, 0)
        DocSess_Set(found, DocSessOff.SEL_B, 0)
        DocSess_Set(found, DocSessOff.SCROLL_X, 0)
        DocSess_Set(found, DocSessOff.SCROLL_Y, 0)
        DocSess_Set(found, DocSessOff.WIN_ID, 0)
        DocSess_Set(found, DocSessOff.JOB, 0)
        DocSess_Set(found, DocSessOff.NODE_ID, -1)
        DocSess_Set(found, DocSessOff.GEN, 1)
        DocSess_Set(found, DocSessOff.PAPER, paper)
        DocSess_Set(found, DocSessOff.ORIENT, orient)
    }
}

Function.DocSess_Doc {
    Input: sess: Integer
    Output: Integer
    Body: {
        idx = DocSess_Idx(sess)
        IfCondition LessThan(idx, 0) ThenBlock: {
            ReturnValue(-1)
        }
        ReturnValue(DocSess_Get(idx, DocSessOff.DOC_ID))
    }
}

Function.DocSess_SetReadonly {
    Input: sess: Integer
    Body: {
        idx = DocSess_Idx(sess)
        IfCondition GreaterEqual(idx, 0) ThenBlock: {
            f = DocSess_Get(idx, DocSessOff.FLAGS)
            DocSess_Set(idx, DocSessOff.FLAGS, BitwiseOr(f, DocSessFlag.READONLY))
        }
    }
}

Function.DocSess_SetNode {
    Input: sess: Integer
    Input: node: Integer
    Body: {
        idx = DocSess_Idx(sess)
        IfCondition GreaterEqual(idx, 0) ThenBlock: {
            DocSess_Set(idx, DocSessOff.NODE_ID, node)
        }
    }
}

Function.DocSess_SetWin {
    Input: sess: Integer
    Input: win_idx: Integer
    Body: {
        idx = DocSess_Idx(sess)
        IfCondition GreaterEqual(idx, 0) ThenBlock: {
            DocSess_Set(idx, DocSessOff.WIN_ID, win_idx)
        }
    }
}

Function.DocSess_SetJob {
    Input: sess: Integer
    Input: job: Integer
    Body: {
        idx = DocSess_Idx(sess)
        IfCondition GreaterEqual(idx, 0) ThenBlock: {
            DocSess_Set(idx, DocSessOff.JOB, job)
        }
    }
}

Function.DocSess_WalkStampWin {
    Input: ctx: LinkagePool.AKContext
    Input: node: Integer
    Input: win_idx: Integer
    Body: {
        IfCondition LessThan(node, 0) ThenBlock: {
            ReturnValue(0)
        }
        tag = AK_Get(ctx, node, AKF.TAG)
        IfCondition EqualTo(tag, AKTag.DOCVIEW) ThenBlock: {
            sess = AK_ExtraGet(ctx, node, AKExtra.TEXTBUF_H)
            DocSess_SetWin(sess, win_idx)
        }
        child = AK_Get(ctx, node, AKF.FIRST_CHILD)
        WhileLoop NotEqual(child, -1) {
            DocSess_WalkStampWin(ctx, child, win_idx)
            child = AK_Get(ctx, child, AKF.NEXT_SIBLING)
        }
    }
}

Function.DocSess_StampWin {
    Input: ctx: LinkagePool.AKContext
    Input: win_idx: Integer
    Body: {
        IfCondition EqualTo(ctx, 0) ThenBlock: {
            ReturnValue(0)
        }
        DocSess_WalkStampWin(ctx, ctx@tree_root, win_idx)
    }
}

Function.DocSess_WalkStampJob {
    Input: ctx: LinkagePool.AKContext
    Input: node: Integer
    Input: job: Integer
    Body: {
        IfCondition LessThan(node, 0) ThenBlock: {
            ReturnValue(0)
        }
        tag = AK_Get(ctx, node, AKF.TAG)
        IfCondition EqualTo(tag, AKTag.DOCVIEW) ThenBlock: {
            sess = AK_ExtraGet(ctx, node, AKExtra.TEXTBUF_H)
            DocSess_SetJob(sess, job)
        }
        child = AK_Get(ctx, node, AKF.FIRST_CHILD)
        WhileLoop NotEqual(child, -1) {
            DocSess_WalkStampJob(ctx, child, job)
            child = AK_Get(ctx, child, AKF.NEXT_SIBLING)
        }
    }
}

Function.DocSess_StampJob {
    Input: ctx: LinkagePool.AKContext
    Input: job: Integer
    Body: {
        IfCondition EqualTo(ctx, 0) ThenBlock: {
            ReturnValue(0)
        }
        DocSess_WalkStampJob(ctx, ctx@tree_root, job)
    }
}
