// Library.DocStore.ailang
// Postgres is home for document names, paper, frames, and text.
// Binary pictures live in UUID blobs; rows point at filename + uuid.
// Not the files VFS table. pgcrypto can wrap text/blobs later.
// Copyright © 2026 Sean Collins, 2 Paws Machine and Engineering. SCSL.

LibraryImport.Arena
LibraryImport.StringUtils
LibraryImport.Hash
LibraryImport.Arrays
LibraryImport.PostgreSQL_Complete
LibraryImport.Display.Content.AilangDoc
Import.OS.UUIDStore

FixedPool.DocStoreKind {
    "TEXT":  Initialize=1
    "IMAGE": Initialize=2
}

Function.DocStore_Q {
    Input: conn: Integer
    Input: sql: Address
    Body: {
        r = PG_Query(conn, sql)
        IfCondition NotEqual(r, 0) ThenBlock: {
            PG_DestroyResult(r)
        }
    }
}

Function.DocStore_EnsureDocs {
    Input: conn: Integer
    Body: {
        DocStore_Q(conn, "CREATE TABLE IF NOT EXISTS documents (id SERIAL PRIMARY KEY, name TEXT NOT NULL)")
        DocStore_Q(conn, "ALTER TABLE documents ADD COLUMN IF NOT EXISTS paper INTEGER NOT NULL DEFAULT 1")
        DocStore_Q(conn, "ALTER TABLE documents ADD COLUMN IF NOT EXISTS orientation INTEGER NOT NULL DEFAULT 0")
        DocStore_Q(conn, "ALTER TABLE documents ADD COLUMN IF NOT EXISTS paper_w_pt INTEGER NOT NULL DEFAULT 0")
        DocStore_Q(conn, "ALTER TABLE documents ADD COLUMN IF NOT EXISTS paper_h_pt INTEGER NOT NULL DEFAULT 0")
        DocStore_Q(conn, "ALTER TABLE documents ADD COLUMN IF NOT EXISTS margin_t_pt INTEGER NOT NULL DEFAULT 72")
        DocStore_Q(conn, "ALTER TABLE documents ADD COLUMN IF NOT EXISTS margin_r_pt INTEGER NOT NULL DEFAULT 72")
        DocStore_Q(conn, "ALTER TABLE documents ADD COLUMN IF NOT EXISTS margin_b_pt INTEGER NOT NULL DEFAULT 72")
        DocStore_Q(conn, "ALTER TABLE documents ADD COLUMN IF NOT EXISTS margin_l_pt INTEGER NOT NULL DEFAULT 72")
        DocStore_Q(conn, "ALTER TABLE documents ADD COLUMN IF NOT EXISTS size_pt INTEGER NOT NULL DEFAULT 12")
        DocStore_Q(conn, "ALTER TABLE documents ADD COLUMN IF NOT EXISTS bold INTEGER NOT NULL DEFAULT 0")
        DocStore_Q(conn, "ALTER TABLE documents ADD COLUMN IF NOT EXISTS italic INTEGER NOT NULL DEFAULT 0")
        DocStore_Q(conn, "ALTER TABLE documents ADD COLUMN IF NOT EXISTS print_dpi INTEGER NOT NULL DEFAULT 96")
        DocStore_Q(conn, "ALTER TABLE documents ADD COLUMN IF NOT EXISTS owner TEXT DEFAULT 'bob'")
        DocStore_Q(conn, "ALTER TABLE documents ADD COLUMN IF NOT EXISTS created TIMESTAMP DEFAULT NOW()")
        DocStore_Q(conn, "ALTER TABLE documents ADD COLUMN IF NOT EXISTS modified TIMESTAMP DEFAULT NOW()")
        PrintMessage("[DocStore] documents table ready\n")
    }
}

Function.DocStore_EnsureFrames {
    Input: conn: Integer
    Body: {
        DocStore_Q(conn, "CREATE TABLE IF NOT EXISTS document_frames (id SERIAL PRIMARY KEY, document_id INTEGER NOT NULL)")
        DocStore_Q(conn, "ALTER TABLE document_frames ADD COLUMN IF NOT EXISTS kind INTEGER NOT NULL DEFAULT 1")
        DocStore_Q(conn, "ALTER TABLE document_frames ADD COLUMN IF NOT EXISTS page_idx INTEGER NOT NULL DEFAULT 0")
        DocStore_Q(conn, "ALTER TABLE document_frames ADD COLUMN IF NOT EXISTS z_order INTEGER NOT NULL DEFAULT 0")
        DocStore_Q(conn, "ALTER TABLE document_frames ADD COLUMN IF NOT EXISTS box_x_pt INTEGER NOT NULL DEFAULT 0")
        DocStore_Q(conn, "ALTER TABLE document_frames ADD COLUMN IF NOT EXISTS box_y_pt INTEGER NOT NULL DEFAULT 0")
        DocStore_Q(conn, "ALTER TABLE document_frames ADD COLUMN IF NOT EXISTS box_w_pt INTEGER NOT NULL DEFAULT 0")
        DocStore_Q(conn, "ALTER TABLE document_frames ADD COLUMN IF NOT EXISTS box_h_pt INTEGER NOT NULL DEFAULT 0")
        DocStore_Q(conn, "ALTER TABLE document_frames ADD COLUMN IF NOT EXISTS flags INTEGER NOT NULL DEFAULT 0")
        PrintMessage("[DocStore] document_frames table ready\n")
    }
}

Function.DocStore_EnsureRuns {
    Input: conn: Integer
    Body: {
        DocStore_Q(conn, "CREATE TABLE IF NOT EXISTS document_runs (id SERIAL PRIMARY KEY, frame_id INTEGER NOT NULL)")
        DocStore_Q(conn, "ALTER TABLE document_runs ADD COLUMN IF NOT EXISTS seq INTEGER NOT NULL DEFAULT 0")
        DocStore_Q(conn, "ALTER TABLE document_runs ADD COLUMN IF NOT EXISTS text TEXT NOT NULL DEFAULT ''")
        DocStore_Q(conn, "ALTER TABLE document_runs ADD COLUMN IF NOT EXISTS size_pt INTEGER")
        DocStore_Q(conn, "ALTER TABLE document_runs ADD COLUMN IF NOT EXISTS bold INTEGER")
        DocStore_Q(conn, "ALTER TABLE document_runs ADD COLUMN IF NOT EXISTS italic INTEGER")
        DocStore_Q(conn, "ALTER TABLE document_runs ADD COLUMN IF NOT EXISTS color INTEGER")
        PrintMessage("[DocStore] document_runs table ready\n")
    }
}

Function.DocStore_EnsureAssets {
    Input: conn: Integer
    Body: {
        DocStore_Q(conn, "CREATE TABLE IF NOT EXISTS document_assets (id SERIAL PRIMARY KEY, document_id INTEGER NOT NULL)")
        DocStore_Q(conn, "ALTER TABLE document_assets ADD COLUMN IF NOT EXISTS frame_id INTEGER")
        DocStore_Q(conn, "ALTER TABLE document_assets ADD COLUMN IF NOT EXISTS name TEXT NOT NULL")
        DocStore_Q(conn, "ALTER TABLE document_assets ADD COLUMN IF NOT EXISTS mime TEXT")
        DocStore_Q(conn, "ALTER TABLE document_assets ADD COLUMN IF NOT EXISTS blob_uuid TEXT NOT NULL")
        DocStore_Q(conn, "ALTER TABLE document_assets ADD COLUMN IF NOT EXISTS byte_len INTEGER NOT NULL DEFAULT 0")
        DocStore_Q(conn, "ALTER TABLE document_assets ADD COLUMN IF NOT EXISTS pix_w INTEGER DEFAULT 0")
        DocStore_Q(conn, "ALTER TABLE document_assets ADD COLUMN IF NOT EXISTS pix_h INTEGER DEFAULT 0")
        PrintMessage("[DocStore] document_assets table ready\n")
    }
}

Function.DocStore_EnsureTables {
    Input: conn: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(conn, 0) ThenBlock: {
            ReturnValue(0)
        }
        DocStore_EnsureDocs(conn)
        DocStore_EnsureFrames(conn)
        DocStore_EnsureRuns(conn)
        DocStore_EnsureAssets(conn)
        ReturnValue(1)
    }
}

FixedPool.DSBuf {
    "ptr": Initialize=0, CanChange=True
    "off": Initialize=0, CanChange=True
    "cap": Initialize=0, CanChange=True
}

Function.DSBuf_Init {
    Input: cap: Integer
    Body: {
        IfCondition LessThan(cap, 256) ThenBlock: {
            cap = 256
        }
        p = Allocate(cap)
        MemorySet(p, 0, cap)
        DSBuf.ptr = p
        DSBuf.off = 0
        DSBuf.cap = cap
    }
}

Function.DSBuf_PutByte {
    Input: b: Integer
    Body: {
        IfCondition LessThan(DSBuf.off, Subtract(DSBuf.cap, 1)) ThenBlock: {
            SetByte(DSBuf.ptr, DSBuf.off, b)
            DSBuf.off = Add(DSBuf.off, 1)
        }
    }
}

Function.DSBuf_Str {
    Input: s: Address
    Body: {
        IfCondition EqualTo(s, 0) ThenBlock: {
            ReturnValue(0)
        }
        n = StringLength(s)
        i = 0
        WhileLoop LessThan(i, n) {
            DSBuf_PutByte(GetByte(s, i))
            i = Add(i, 1)
        }
    }
}

Function.DSBuf_Int {
    Input: n: Integer
    Body: {
        DSBuf_Str(NumberToString(n))
    }
}

Function.DSBuf_Quote {
    Input: s: Address
    Input: slen: Integer
    Body: {
        DSBuf_PutByte(39)
        IfCondition And(NotEqual(s, 0), GreaterThan(slen, 0)) ThenBlock: {
            i = 0
            WhileLoop LessThan(i, slen) {
                b = GetByte(s, i)
                DSBuf_PutByte(b)
                IfCondition EqualTo(b, 39) ThenBlock: {
                    DSBuf_PutByte(39)
                }
                i = Add(i, 1)
            }
        }
        DSBuf_PutByte(39)
    }
}

Function.DSBuf_Done {
    Output: Address
    Body: {
        SetByte(DSBuf.ptr, DSBuf.off, 0)
        ReturnValue(DSBuf.ptr)
    }
}

Function.DSBuf_ExecId {
    Input: conn: Integer
    Output: Integer
    Body: {
        sql = DSBuf_Done()
        r = PG_Query(conn, sql)
        Deallocate(DSBuf.ptr, DSBuf.cap)
        DSBuf.ptr = 0
        IfCondition EqualTo(r, 0) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition EqualTo(Array.Size(r), 0) ThenBlock: {
            PG_DestroyResult(r)
            ReturnValue(0)
        }
        row = Array.Get(r, 0)
        id_str = Hash.Get(row, "id")
        nid = 0
        IfCondition NotEqual(id_str, 0) ThenBlock: {
            nid = StringToNumber(id_str)
        }
        PG_DestroyResult(r)
        ReturnValue(nid)
    }
}

Function.DocStore_InsertDoc {
    Input: conn: Integer
    Input: name: Address
    Input: doc: Integer
    Output: Integer
    Body: {
        DSBuf_Init(1024)
        DSBuf_Str("INSERT INTO documents (name, paper, orientation, paper_w_pt, paper_h_pt, margin_t_pt, margin_r_pt, margin_b_pt, margin_l_pt, size_pt, bold, italic, print_dpi) VALUES (")
        DSBuf_Quote(name, StringLength(name))
        DSBuf_Str(", ")
        DSBuf_Int(ADoc_Get(doc, ADocField.PAPER))
        DSBuf_Str(", ")
        DSBuf_Int(ADoc_Get(doc, ADocField.ORIENT))
        DSBuf_Str(", ")
        DSBuf_Int(ADoc_Get(doc, ADocField.CUSTOM_W))
        DSBuf_Str(", ")
        DSBuf_Int(ADoc_Get(doc, ADocField.CUSTOM_H))
        DSBuf_Str(", ")
        DSBuf_Int(ADoc_Get(doc, ADocField.MT))
        DSBuf_Str(", ")
        DSBuf_Int(ADoc_Get(doc, ADocField.MR))
        DSBuf_Str(", ")
        DSBuf_Int(ADoc_Get(doc, ADocField.MB))
        DSBuf_Str(", ")
        DSBuf_Int(ADoc_Get(doc, ADocField.ML))
        DSBuf_Str(", ")
        DSBuf_Int(ADoc_Get(doc, ADocField.SIZE_PT))
        DSBuf_Str(", ")
        DSBuf_Int(ADoc_Get(doc, ADocField.BOLD))
        DSBuf_Str(", ")
        DSBuf_Int(ADoc_Get(doc, ADocField.ITALIC))
        DSBuf_Str(", ")
        DSBuf_Int(ADoc_Get(doc, ADocField.PRINT_DPI))
        DSBuf_Str(") RETURNING id")
        nid = DSBuf_ExecId(conn)
        IfCondition GreaterThan(nid, 0) ThenBlock: {
            ADoc_Set(doc, ADocField.PG_ID, nid)
        }
        ReturnValue(nid)
    }
}

Function.DocStore_InsertTextFrame {
    Input: conn: Integer
    Input: pg_id: Integer
    Output: Integer
    Body: {
        DSBuf_Init(256)
        DSBuf_Str("INSERT INTO document_frames (document_id, kind, z_order) VALUES (")
        DSBuf_Int(pg_id)
        DSBuf_Str(", 1, 0) RETURNING id")
        ReturnValue(DSBuf_ExecId(conn))
    }
}

Function.DocStore_InsertRun {
    Input: conn: Integer
    Input: frame_id: Integer
    Input: text: Address
    Input: tlen: Integer
    Output: Integer
    Body: {
        cap = Add(Multiply(tlen, 2), 128)
        DSBuf_Init(cap)
        DSBuf_Str("INSERT INTO document_runs (frame_id, seq, text) VALUES (")
        DSBuf_Int(frame_id)
        DSBuf_Str(", 0, ")
        DSBuf_Quote(text, tlen)
        DSBuf_Str(") RETURNING id")
        ReturnValue(DSBuf_ExecId(conn))
    }
}

Function.DocStore_Save {
    Input: conn: Integer
    Input: doc: Integer
    Input: name: Address
    Output: Integer
    Body: {
        pgid = ADoc_Get(doc, ADocField.PG_ID)
        IfCondition EqualTo(pgid, 0) ThenBlock: {
            pgid = DocStore_InsertDoc(conn, name, doc)
            IfCondition EqualTo(pgid, 0) ThenBlock: {
                PrintMessage("[DocStore] insert document failed\n")
                ReturnValue(0)
            }
            fid = DocStore_InsertTextFrame(conn, pgid)
            IfCondition EqualTo(fid, 0) ThenBlock: {
                ReturnValue(0)
            }
            DocStore_InsertRun(conn, fid, ADoc_Get(doc, ADocField.RUN_PTR), ADoc_Get(doc, ADocField.RUN_LEN))
            ReturnValue(pgid)
        }
        DSBuf_Init(256)
        DSBuf_Str("UPDATE documents SET modified=NOW() WHERE id=")
        DSBuf_Int(pgid)
        sql = DSBuf_Done()
        r = PG_Query(conn, sql)
        IfCondition NotEqual(r, 0) ThenBlock: {
            PG_DestroyResult(r)
        }
        Deallocate(DSBuf.ptr, DSBuf.cap)
        DSBuf.ptr = 0
        ReturnValue(pgid)
    }
}

Function.DocStore_AttachAsset {
    Input: conn: Integer
    Input: pg_id: Integer
    Input: filename: Address
    Input: mime: Address
    Input: data: Address
    Input: dlen: Integer
    Output: Integer
    Body: {
        IfCondition LessEqual(pg_id, 0) ThenBlock: {
            ReturnValue(0)
        }
        UUID_Init()
        uuid = UUID_Generate()
        IfCondition EqualTo(uuid, 0) ThenBlock: {
            ReturnValue(0)
        }
        rc = UUID_Create(uuid, data, dlen)
        IfCondition NotEqual(rc, 0) ThenBlock: {
            PrintMessage("[DocStore] blob write failed\n")
            ReturnValue(0)
        }
        DSBuf_Init(256)
        DSBuf_Str("INSERT INTO document_frames (document_id, kind, z_order) VALUES (")
        DSBuf_Int(pg_id)
        DSBuf_Str(", 2, 1) RETURNING id")
        fid = DSBuf_ExecId(conn)
        IfCondition EqualTo(fid, 0) ThenBlock: {
            ReturnValue(0)
        }
        DSBuf_Init(512)
        DSBuf_Str("INSERT INTO document_assets (document_id, frame_id, name, mime, blob_uuid, byte_len) VALUES (")
        DSBuf_Int(pg_id)
        DSBuf_Str(", ")
        DSBuf_Int(fid)
        DSBuf_Str(", ")
        DSBuf_Quote(filename, StringLength(filename))
        DSBuf_Str(", ")
        DSBuf_Quote(mime, StringLength(mime))
        DSBuf_Str(", ")
        DSBuf_Quote(uuid, StringLength(uuid))
        DSBuf_Str(", ")
        DSBuf_Int(dlen)
        DSBuf_Str(") RETURNING id")
        ReturnValue(DSBuf_ExecId(conn))
    }
}
