Function.DocFmt_ApplyFont {
    Input: idx: Integer
    Body: {
        DocFmt.v = FontCat_EnsureFace(idx)
        IfCondition LessThan(DocFmt.v, 0) ThenBlock: {
            PrintMessage("[DocFmt] font load fail idx=")
            PrintNumber(idx)
            PrintMessage("\n")
            ReturnValue(0)
        }
        IfCondition EqualTo(PlaceHud_SelKind(), PHConst.KIND_TABLE) ThenBlock: {
            PlaceHud_SetFace(DocFmt.v)
            DocFmt.ptr = FontCat_Name(idx)
            IfCondition NotEqual(DocFmt.ptr, 0) ThenBlock: {
                DocFmt.len = StringLength(DocFmt.ptr)
                DocFmt.c = AK_FindById(DocFmt.ctx, "font")
                IfCondition GreaterEqual(DocFmt.c, 0) ThenBlock: {
                    AK_ExtraSet(DocFmt.ctx, DocFmt.c, AKExtra.STR_PTR, DocFmt.ptr)
                    AK_ExtraSet(DocFmt.ctx, DocFmt.c, AKExtra.STR_LEN, DocFmt.len)
                    AK_Set(DocFmt.ctx, DocFmt.c, AKF.DIRTY, 1)
                }
            }
            DocFmt.need = 0
            DocFmt_Finish()
            ReturnValue(1)
        }
        ADoc_Set(DocFmt.did, ADocField.FACE, DocFmt.v)
        DocLayout_Bind(DocFmt.did)
        ADoc_MarkDirty(DocFmt.did)
        DocFmt.need = 1
        DocFmt.ptr = FontCat_Name(idx)
        IfCondition NotEqual(DocFmt.ptr, 0) ThenBlock: {
            DocFmt.len = StringLength(DocFmt.ptr)
            DocFmt.c = AK_FindById(DocFmt.ctx, "font")
            IfCondition GreaterEqual(DocFmt.c, 0) ThenBlock: {
                AK_ExtraSet(DocFmt.ctx, DocFmt.c, AKExtra.STR_PTR, DocFmt.ptr)
                AK_ExtraSet(DocFmt.ctx, DocFmt.c, AKExtra.STR_LEN, DocFmt.len)
                AK_Set(DocFmt.ctx, DocFmt.c, AKF.DIRTY, 1)
            }
        }
        DocFmt_Finish()
    }
}

Function.DocFmt_Apply {
    Input: ctx: LinkagePool.AKContext
    Input: action_ptr: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(action_ptr, 0) ThenBlock: {
            ReturnValue(0)
        }
        DocFmt.act = action_ptr
        IfCondition NotEqual(GetByte(DocFmt.act, 0), 102) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition NotEqual(GetByte(DocFmt.act, 1), 109) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition NotEqual(GetByte(DocFmt.act, 2), 116) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition NotEqual(GetByte(DocFmt.act, 3), 46) ThenBlock: {
            ReturnValue(0)
        }
        DocFmt.ctx = ctx
        IfCondition EqualTo(StringCompare(DocFmt.act, "fmt.drop.font"), 0) ThenBlock: {
            DocFmt_ToggleDrop(1)
            ReturnValue(1)
        }
        IfCondition EqualTo(StringCompare(DocFmt.act, "fmt.drop.setup"), 0) ThenBlock: {
            DocFmt_ToggleDrop(2)
            ReturnValue(1)
        }
        IfCondition EqualTo(StringCompare(DocFmt.act, "fmt.table"), 0) ThenBlock: {
            IfCondition And(EqualTo(PlaceHud.tool, PHTool.PLACE), EqualTo(PlaceHud.kind, PHConst.KIND_TABLE)) ThenBlock: {
                PlaceHud_SetTool(PHTool.CARET)
            }
            ElseBlock: {
                PlaceHud_SetKind(PHConst.KIND_TABLE)
                PlaceHud_SetTool(PHTool.PLACE)
            }
            DocFmt_SyncTableBtn(ctx)
            DocFmt_SyncBoxBtn(ctx)
            DocFmt_SyncImgBtn(ctx)
            ReturnValue(1)
        }
        IfCondition EqualTo(StringCompare(DocFmt.act, "fmt.box"), 0) ThenBlock: {
            IfCondition And(EqualTo(PlaceHud.tool, PHTool.PLACE), EqualTo(PlaceHud.kind, PHConst.KIND_TEXT)) ThenBlock: {
                PlaceHud_SetTool(PHTool.CARET)
            }
            ElseBlock: {
                PlaceHud_SetKind(PHConst.KIND_TEXT)
                PlaceHud_SetTool(PHTool.PLACE)
            }
            DocFmt_SyncTableBtn(ctx)
            DocFmt_SyncBoxBtn(ctx)
            DocFmt_SyncImgBtn(ctx)
            ReturnValue(1)
        }
        IfCondition EqualTo(StringCompare(DocFmt.act, "fmt.image"), 0) ThenBlock: {
            IfCondition And(EqualTo(PlaceHud.tool, PHTool.PLACE), EqualTo(PlaceHud.kind, PHConst.KIND_IMAGE)) ThenBlock: {
                PlaceHud_SetTool(PHTool.CARET)
            }
            ElseBlock: {
                PlaceHud_SetKind(PHConst.KIND_IMAGE)
                PlaceHud_SetTool(PHTool.PLACE)
            }
            DocFmt_SyncTableBtn(ctx)
            DocFmt_SyncBoxBtn(ctx)
            DocFmt_SyncImgBtn(ctx)
            ReturnValue(1)
        }
        IfCondition EqualTo(DocFmt_BindSess(ctx), 0) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition EqualTo(StringCompare(DocFmt.act, "fmt.bold"), 0) ThenBlock: {
            DocFmt_Toggle(ADocField.BOLD)
            ReturnValue(1)
        }
        IfCondition EqualTo(StringCompare(DocFmt.act, "fmt.italic"), 0) ThenBlock: {
            DocFmt_Toggle(ADocField.ITALIC)
            ReturnValue(1)
        }
        IfCondition EqualTo(StringCompare(DocFmt.act, "fmt.underline"), 0) ThenBlock: {
            DocFmt_Toggle(ADocField.UNDERLINE)
            ReturnValue(1)
        }
        IfCondition EqualTo(StringCompare(DocFmt.act, "fmt.list.bullet"), 0) ThenBlock: {
            ADoc_ParaToggle(DocFmt.did, DocSess_Get(DocFmt.sidx, DocSessOff.CARET_OFF), ADocList.BULLET)
            DocFmt.need = 1
            DocFmt_Finish()
            ReturnValue(1)
        }
        IfCondition EqualTo(StringCompare(DocFmt.act, "fmt.list.num"), 0) ThenBlock: {
            ADoc_ParaToggle(DocFmt.did, DocSess_Get(DocFmt.sidx, DocSessOff.CARET_OFF), ADocList.NUMBER)
            DocFmt.need = 1
            DocFmt_Finish()
            ReturnValue(1)
        }
        IfCondition EqualTo(StringCompare(DocFmt.act, "fmt.list.in"), 0) ThenBlock: {
            ADoc_ParaIndent(DocFmt.did, DocSess_Get(DocFmt.sidx, DocSessOff.CARET_OFF), 1)
            DocFmt.need = 1
            DocFmt_Finish()
            ReturnValue(1)
        }
        IfCondition EqualTo(StringCompare(DocFmt.act, "fmt.list.out"), 0) ThenBlock: {
            ADoc_ParaIndent(DocFmt.did, DocSess_Get(DocFmt.sidx, DocSessOff.CARET_OFF), Subtract(0, 1))
            DocFmt.need = 1
            DocFmt_Finish()
            ReturnValue(1)
        }
        IfCondition EqualTo(StringCompare(DocFmt.act, "fmt.align.left"), 0) ThenBlock: {
            DocFmt_SetAlign(ADocAlign.LEFT)
            ReturnValue(1)
        }
        IfCondition EqualTo(StringCompare(DocFmt.act, "fmt.align.center"), 0) ThenBlock: {
            DocFmt_SetAlign(ADocAlign.CENTER)
            ReturnValue(1)
        }
        IfCondition EqualTo(StringCompare(DocFmt.act, "fmt.align.right"), 0) ThenBlock: {
            DocFmt_SetAlign(ADocAlign.RIGHT)
            ReturnValue(1)
        }
        IfCondition EqualTo(StringCompare(DocFmt.act, "fmt.align.just"), 0) ThenBlock: {
            DocFmt_SetAlign(ADocAlign.JUST)
            ReturnValue(1)
        }
        IfCondition EqualTo(StringCompare(DocFmt.act, "fmt.size"), 0) ThenBlock: {
            DocFmt_ApplySize()
            ReturnValue(1)
        }
        IfCondition EqualTo(StringCompare(DocFmt.act, "fmt.mt.up"), 0) ThenBlock: {
            DocFmt_Nudge(ADocField.MT, 14, 18, 216)
            ReturnValue(1)
        }
        IfCondition EqualTo(StringCompare(DocFmt.act, "fmt.mt.dn"), 0) ThenBlock: {
            DocFmt_Nudge(ADocField.MT, -14, 18, 216)
            ReturnValue(1)
        }
        IfCondition EqualTo(StringCompare(DocFmt.act, "fmt.ml.up"), 0) ThenBlock: {
            DocFmt_Nudge(ADocField.ML, 14, 18, 216)
            ReturnValue(1)
        }
        IfCondition EqualTo(StringCompare(DocFmt.act, "fmt.ml.dn"), 0) ThenBlock: {
            DocFmt_Nudge(ADocField.ML, -14, 18, 216)
            ReturnValue(1)
        }
        IfCondition EqualTo(StringCompare(DocFmt.act, "fmt.mr.up"), 0) ThenBlock: {
            DocFmt_Nudge(ADocField.MR, 14, 18, 216)
            ReturnValue(1)
        }
        IfCondition EqualTo(StringCompare(DocFmt.act, "fmt.mr.dn"), 0) ThenBlock: {
            DocFmt_Nudge(ADocField.MR, -14, 18, 216)
            ReturnValue(1)
        }
        IfCondition EqualTo(StringCompare(DocFmt.act, "fmt.mb.up"), 0) ThenBlock: {
            DocFmt_Nudge(ADocField.MB, 14, 18, 216)
            ReturnValue(1)
        }
        IfCondition EqualTo(StringCompare(DocFmt.act, "fmt.mb.dn"), 0) ThenBlock: {
            DocFmt_Nudge(ADocField.MB, -14, 18, 216)
            ReturnValue(1)
        }
        IfCondition EqualTo(StringCompare(DocFmt.act, "fmt.sz.up"), 0) ThenBlock: {
            DocFmt_Nudge(ADocField.SIZE_PT, 2, 8, 72)
            ReturnValue(1)
        }
        IfCondition EqualTo(StringCompare(DocFmt.act, "fmt.sz.dn"), 0) ThenBlock: {
            DocFmt_Nudge(ADocField.SIZE_PT, -2, 8, 72)
            ReturnValue(1)
        }
        IfCondition EqualTo(StringCompare(DocFmt.act, "fmt.tab.up"), 0) ThenBlock: {
            DocFmt_Nudge(ADocField.TAB_SP, 1, 1, 8)
            ReturnValue(1)
        }
        IfCondition EqualTo(StringCompare(DocFmt.act, "fmt.tab.dn"), 0) ThenBlock: {
            DocFmt_Nudge(ADocField.TAB_SP, -1, 1, 8)
            ReturnValue(1)
        }
        IfCondition EqualTo(StringCompare(DocFmt.act, "fmt.margin"), 0) ThenBlock: {
            DocFmt_ApplyMargin()
            ReturnValue(1)
        }
        IfCondition EqualTo(StringCompare(DocFmt.act, "fmt.header"), 0) ThenBlock: {
            DocFmt_ApplyHeader()
            ReturnValue(1)
        }
        IfCondition EqualTo(StringCompare(DocFmt.act, "fmt.footer"), 0) ThenBlock: {
            DocFmt_ApplyFooter()
            ReturnValue(1)
        }
        IfCondition EqualTo(StringCompare(DocFmt.act, "fmt.drop.font"), 0) ThenBlock: {
            DocFmt_ToggleDrop(1)
            ReturnValue(1)
        }
        IfCondition EqualTo(StringCompare(DocFmt.act, "fmt.drop.setup"), 0) ThenBlock: {
            DocFmt_ToggleDrop(2)
            ReturnValue(1)
        }
        IfCondition EqualTo(GetByte(DocFmt.act, 8), 46) ThenBlock: {
            IfCondition EqualTo(GetByte(DocFmt.act, 4), 102) ThenBlock: {
                DocFmt.i = Subtract(GetByte(DocFmt.act, 9), 48)
                IfCondition And(GreaterEqual(DocFmt.i, 0), LessThan(DocFmt.i, 10)) ThenBlock: {
                    DocFmt_ApplyFont(DocFmt.i)
                    ReturnValue(1)
                }
            }
        }
        ReturnValue(0)
    }
}
