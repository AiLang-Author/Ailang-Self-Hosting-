FixedPool.DocDrawScr {
    "canvas":  Initialize=0, CanChange=True
    "sx":      Initialize=0, CanChange=True
    "sy":      Initialize=0, CanChange=True
    "sw":      Initialize=0, CanChange=True
    "sh":      Initialize=0, CanChange=True
    "clip_x":  Initialize=0, CanChange=True
    "clip_y":  Initialize=0, CanChange=True
    "clip_w":  Initialize=0, CanChange=True
    "clip_h":  Initialize=0, CanChange=True
    "pw":      Initialize=0, CanChange=True
    "ph":      Initialize=0, CanChange=True
    "scx":     Initialize=0, CanChange=True
    "scy":     Initialize=0, CanChange=True
    "pc":      Initialize=0, CanChange=True
    "node":    Initialize=0, CanChange=True
    "did":     Initialize=0, CanChange=True
    "sidx":    Initialize=0, CanChange=True
    "foc":     Initialize=0, CanChange=True
    "ml":      Initialize=0, CanChange=True
    "mt":      Initialize=0, CanChange=True
    "mr":      Initialize=0, CanChange=True
    "mb":      Initialize=0, CanChange=True
    "lh":      Initialize=0, CanChange=True
    "inst":    Initialize=0, CanChange=True
    "li":      Initialize=0, CanChange=True
    "o0":      Initialize=0, CanChange=True
    "o1":      Initialize=0, CanChange=True
    "xp":      Initialize=0, CanChange=True
    "run":     Initialize=0, CanChange=True
    "nlines":  Initialize=0, CanChange=True
    "ptr":     Initialize=0, CanChange=True
    "xa":      Initialize=0, CanChange=True
    "oy":      Initialize=0, CanChange=True
    "bold":    Initialize=0, CanChange=True
    "uline":   Initialize=0, CanChange=True
    "ink":     Initialize=0, CanChange=True
    "mark":    Initialize=0, CanChange=True
    "item":    Initialize=0, CanChange=True
    "hang":    Initialize=0, CanChange=True
}

FixedPool.DocBand {
    "buf":  Initialize=0, CanChange=True
    "n":    Initialize=0, CanChange=True
    "inst": Initialize=-1, CanChange=True
}

FixedPool.DocFmt {
    "ctx":   Initialize=0, CanChange=True
    "did":   Initialize=-1, CanChange=True
    "sidx":  Initialize=-1, CanChange=True
    "node":  Initialize=-1, CanChange=True
    "ptr":   Initialize=0, CanChange=True
    "len":   Initialize=0, CanChange=True
    "pt":    Initialize=0, CanChange=True
    "i":     Initialize=0, CanChange=True
    "v":     Initialize=0, CanChange=True
    "c":     Initialize=0, CanChange=True
    "whole": Initialize=0, CanChange=True
    "frac":  Initialize=0, CanChange=True
    "fdiv":  Initialize=1, CanChange=True
    "dot":   Initialize=0, CanChange=True
    "need":  Initialize=0, CanChange=True
    "act":   Initialize=0, CanChange=True
    "lab":   Initialize=0, CanChange=True
    "drop":  Initialize=0, CanChange=True
}

FixedPool.DocBoxScr {
    "clip_x": Initialize=0, CanChange=True
    "clip_y": Initialize=0, CanChange=True
    "clip_w": Initialize=0, CanChange=True
    "clip_h": Initialize=0, CanChange=True
    "did":    Initialize=0, CanChange=True
    "sidx":   Initialize=0, CanChange=True
    "inst":   Initialize=0, CanChange=True
    "lh":     Initialize=0, CanChange=True
    "ml":     Initialize=0, CanChange=True
    "mt":     Initialize=0, CanChange=True
    "mr":     Initialize=0, CanChange=True
    "mb":     Initialize=0, CanChange=True
    "pw":     Initialize=0, CanChange=True
