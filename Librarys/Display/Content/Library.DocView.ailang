}

Function.DocView_ClipFill {
    Input: x: Integer
    Input: y: Integer
    Input: w: Integer
    Input: h: Integer
    Input: color: Integer
    Body: {
        ox = x
        IfCondition GreaterThan(DocDrawScr.clip_x, ox) ThenBlock: {
            ox = DocDrawScr.clip_x
        }
        oy = y
        IfCondition GreaterThan(DocDrawScr.clip_y, oy) ThenBlock: {
            oy = DocDrawScr.clip_y
        }
        x2 = Add(x, w)
        cx2 = Add(DocDrawScr.clip_x, DocDrawScr.clip_w)
        IfCondition LessThan(cx2, x2) ThenBlock: {
            x2 = cx2
        }
        y2 = Add(y, h)
        cy2 = Add(DocDrawScr.clip_y, DocDrawScr.clip_h)
        IfCondition LessThan(cy2, y2) ThenBlock: {
            y2 = cy2
        }
        ow = Subtract(x2, ox)
        oh = Subtract(y2, oy)
        IfCondition LessEqual(ow, 0) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition LessEqual(oh, 0) ThenBlock: {
            ReturnValue(0)
        }
        Draw_Pix_FillRect(DocDrawScr.canvas, ox, oy, ow, oh, color)
    }
}

Function.AK_DrawDocView {
    Input: ctx: LinkagePool.AKContext
    Input: node: Integer
    Body: {
        DocDrawScr.node = node
        canvas = ctx@canvas
        sx = Subtract(AK_Get(ctx, DocDrawScr.node, AKF.SOLVED_X), ctx@scroll_offset_x)
        sy = Subtract(AK_Get(ctx, DocDrawScr.node, AKF.SOLVED_Y), ctx@scroll_offset_y)
        sw = AK_Get(ctx, DocDrawScr.node, AKF.SOLVED_W)
        sh = AK_Get(ctx, DocDrawScr.node, AKF.SOLVED_H)
        sess = AK_ExtraGet(ctx, DocDrawScr.node, AKExtra.TEXTBUF_H)
        DocDrawScr.foc = 0
        IfCondition EqualTo(ctx@focus_node, DocDrawScr.node) ThenBlock: {
            DocDrawScr.foc = 1
        }
        DocView_Paint(canvas, sx, sy, sw, sh, sess)
        VFont_UseSize(UIScale.font_body)
    }
}

Function.DocView_Paint {
    Input: canvas: Integer
    Input: sx: Integer
    Input: sy: Integer
    Input: sw: Integer
    Input: sh: Integer
    Input: sess: Integer
    Body: {
        IfCondition Or(LessEqual(sw, 0), LessEqual(sh, 0)) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition EqualTo(canvas, 0) ThenBlock: {
            ReturnValue(0)
        }
        idx = DocSess_Idx(sess)
        IfCondition LessThan(idx, 0) ThenBlock: {
            ReturnValue(0)
        }
        DocDrawScr.sidx = idx
        DocDrawScr.canvas = canvas
        DocDrawScr.sx = sx
        DocDrawScr.sy = sy
        DocDrawScr.sw = sw
        DocDrawScr.sh = sh
        DocDrawScr.clip_x = sx
        DocDrawScr.clip_y = sy
        DocDrawScr.clip_w = sw
        DocDrawScr.clip_h = sh

        DocView_ClipFill(sx, sy, sw, sh, Theme.window_bg)
        DocView_PaintSheets()
    }
}

Function.DocView_PaintSheets {
    Body: {
        idx = DocDrawScr.sidx
        did = DocSess_Get(idx, DocSessOff.DOC_ID)
        IfCondition LessThan(did, 0) ThenBlock: {
            ReturnValue(0)
        }
        DocDrawScr.did = did
        fl = ADoc_Get(DocDrawScr.did, ADocField.FLAGS)
        need = BitwiseAnd(fl, DocFlag.LAYOUT_DIRTY)
        IfCondition EqualTo(need, 0) ThenBlock: {
            IfCondition GreaterThan(ADoc_Get(DocDrawScr.did, ADocField.RUN_LEN), 0) ThenBlock: {
                IfCondition EqualTo(ADoc_Get(DocDrawScr.did, ADocField.LINE_COUNT), 0) ThenBlock: {
                    need = 1
                }
            }
        }
        IfCondition NotEqual(need, 0) ThenBlock: {
            DocLayout_Paginate(DocDrawScr.did)
        }
        ppr = ADoc_Get(DocDrawScr.did, ADocField.PAPER)
        por = ADoc_Get(DocDrawScr.did, ADocField.ORIENT)
        pcw = ADoc_Get(DocDrawScr.did, ADocField.CUSTOM_W)
        pch = ADoc_Get(DocDrawScr.did, ADocField.CUSTOM_H)
        ok = DocPaper_SizePt(ppr, por, pcw, pch, 0, 0)
        IfCondition EqualTo(ok, 0) ThenBlock: {
            ReturnValue(0)
        }
        DocDrawScr.pw = DocLayout_PtToPx(DocPaperOut.w)
        DocDrawScr.ph = DocLayout_PtToPx(DocPaperOut.h)
        DocDrawScr.scx = DocSess_Get(DocDrawScr.sidx, DocSessOff.SCROLL_X)
        DocDrawScr.scy = DocSess_Get(DocDrawScr.sidx, DocSessOff.SCROLL_Y)
        pc = ADoc_Get(DocDrawScr.did, ADocField.PAGE_COUNT)
        IfCondition LessThan(pc, 1) ThenBlock: {
            pc = 1
        }
        DocDrawScr.pc = pc
        DocDrawScr.ml = DocLayout_PtToPx(ADoc_Get(DocDrawScr.did, ADocField.ML))
        DocDrawScr.mt = DocLayout_PtToPx(ADoc_Get(DocDrawScr.did, ADocField.MT))
        DocDrawScr.mr = DocLayout_PtToPx(ADoc_Get(DocDrawScr.did, ADocField.MR))
        DocDrawScr.mb = DocLayout_PtToPx(ADoc_Get(DocDrawScr.did, ADocField.MB))
        DocDrawScr.inst = ADoc_Get(DocDrawScr.did, ADocField.LAYOUT_INST)
        DocDrawScr.lh = 16
        IfCondition GreaterEqual(DocDrawScr.inst, 0) ThenBlock: {
            DocDrawScr.lh = VInst_GetLineHeight(DocDrawScr.inst)
            DocLayout_BindTab(DocDrawScr.did, DocDrawScr.inst)
        }
        IfCondition LessEqual(DocDrawScr.lh, 0) ThenBlock: {
            DocDrawScr.lh = 16
        }
        DocView_BlitSheets()
        DocView_PaintGuides()
        DocView_PaintInk()
        DocView_PaintFrames()
        DocView_PaintBand()
        FontState.tab_px = 0
        FontState.sp_px = 0
    }
}

Function.DocView_BlitSheets {
    Body: {
        DocDrawScr.li = 0
        WhileLoop LessThan(DocDrawScr.li, DocDrawScr.pc) {
            oy = Multiply(DocDrawScr.li, Add(DocDrawScr.ph, DocLayConst.PAGE_GAP_PX))
            sheet_x = Subtract(DocDrawScr.sx, DocDrawScr.scx)
            sheet_y = Subtract(Add(DocDrawScr.sy, oy), DocDrawScr.scy)
            DocView_ClipFill(sheet_x, sheet_y, DocDrawScr.pw, DocDrawScr.ph, Theme.page_bg)
            DocDrawScr.li = Add(DocDrawScr.li, 1)
        }
    }
}

Function.DocView_PaintGuides {
    Body: {
        DocDrawScr.xp = Subtract(Subtract(DocDrawScr.pw, DocDrawScr.ml), DocDrawScr.mr)
        DocDrawScr.xa = Subtract(Subtract(DocDrawScr.ph, DocDrawScr.mt), DocDrawScr.mb)
        IfCondition Or(LessEqual(DocDrawScr.xp, 1), LessEqual(DocDrawScr.xa, 1)) ThenBlock: {
            ReturnValue(0)
        }
        DocDrawScr.li = 0
        WhileLoop LessThan(DocDrawScr.li, DocDrawScr.pc) {
            DocDrawScr.oy = Multiply(DocDrawScr.li, Add(DocDrawScr.ph, DocLayConst.PAGE_GAP_PX))
            DocView_ClipFill(Subtract(Add(DocDrawScr.sx, DocDrawScr.ml), DocDrawScr.scx), Subtract(Add(Add(DocDrawScr.sy, DocDrawScr.oy), DocDrawScr.mt), DocDrawScr.scy), DocDrawScr.xp, 1, 0xFFB4C2D4)
            DocView_ClipFill(Subtract(Add(DocDrawScr.sx, DocDrawScr.ml), DocDrawScr.scx), Subtract(Add(Add(Add(DocDrawScr.sy, DocDrawScr.oy), DocDrawScr.mt), DocDrawScr.xa), Add(DocDrawScr.scy, 1)), DocDrawScr.xp, 1, 0xFFB4C2D4)
            DocView_ClipFill(Subtract(Add(DocDrawScr.sx, DocDrawScr.ml), DocDrawScr.scx), Subtract(Add(Add(DocDrawScr.sy, DocDrawScr.oy), DocDrawScr.mt), DocDrawScr.scy), 1, DocDrawScr.xa, 0xFFB4C2D4)
            DocView_ClipFill(Subtract(Add(Add(DocDrawScr.sx, DocDrawScr.ml), DocDrawScr.xp), Add(DocDrawScr.scx, 1)), Subtract(Add(Add(DocDrawScr.sy, DocDrawScr.oy), DocDrawScr.mt), DocDrawScr.scy), 1, DocDrawScr.xa, 0xFFB4C2D4)
            DocDrawScr.li = Add(DocDrawScr.li, 1)
        }
    }
}

Function.DocView_LineOriginY {
    Input: li: Integer
    Output: Integer
    Body: {
        lp = ADoc_LinePtr(DocDrawScr.did, li)
        pg = Dereference(Add(lp, DocLineOff.PAGE))
        y = Dereference(Add(lp, DocLineOff.Y_PX))
        oy = Multiply(pg, Add(DocDrawScr.ph, DocLayConst.PAGE_GAP_PX))
        ReturnValue(Add(Add(oy, DocDrawScr.mt), y))
    }
}

Function.DocView_PaintInk {
    Body: {
        IfCondition LessThan(DocDrawScr.did, 0) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition LessThan(DocDrawScr.inst, 0) ThenBlock: {
            ReturnValue(0)
        }
        DocDrawScr.nlines = ADoc_Get(DocDrawScr.did, ADocField.LINE_COUNT)
        DocDrawScr.bold = ADoc_Get(DocDrawScr.did, ADocField.BOLD)
        DocDrawScr.uline = ADoc_Get(DocDrawScr.did, ADocField.UNDERLINE)
        DocDrawScr.ink = Theme.text_fg
        IfCondition EqualTo(DocDrawScr.ink, 0) ThenBlock: {
            DocDrawScr.ink = 0xFF1A1A1A
        }
        IfCondition EqualTo(DocDrawScr.ink, Theme.page_bg) ThenBlock: {
            DocDrawScr.ink = 0xFF1A1A1A
        }
        DocView_PaintBands()
        DocView_PaintSel()
        DocView_PaintLines()
        IfCondition EqualTo(DocDrawScr.foc, 1) ThenBlock: {
            DocView_PaintCaret()
        }
    }
}

Function.DocView_PaintMarker {
    Input: dx: Integer
    Input: dy: Integer
    Body: {
        DocFmt.i = Subtract(dx, DocDrawScr.hang)
        IfCondition EqualTo(DocDrawScr.mark, ADocList.BULLET) ThenBlock: {
            DocFmt.pt = Add(DocFmt.i, Subtract(Divide(DocDrawScr.hang, 2), 2))
            IfCondition LessThan(DocFmt.pt, Add(DocFmt.i, 2)) ThenBlock: {
                DocFmt.pt = Add(DocFmt.i, 2)
            }
            DocView_ClipFill(DocFmt.pt, Add(dy, Subtract(Divide(DocDrawScr.lh, 2), 2)), 4, 4, DocDrawScr.ink)
            ReturnValue(0)
        }
        IfCondition EqualTo(DocDrawScr.mark, ADocList.NUMBER) ThenBlock: {
            IfCondition EqualTo(DocFmt.lab, 0) ThenBlock: {
                DocFmt.lab = Allocate(48)
            }
            IfCondition EqualTo(DocFmt.lab, 0) ThenBlock: {
                ReturnValue(0)
            }
            DocFmt.v = DocDrawScr.item
            IfCondition LessThan(DocFmt.v, 1) ThenBlock: {
                DocFmt.v = 1
            }
            IfCondition GreaterEqual(DocFmt.v, 10) ThenBlock: {
                SetByte(DocFmt.lab, 0, Add(48, Divide(DocFmt.v, 10)))
                SetByte(DocFmt.lab, 1, Add(48, Subtract(DocFmt.v, Multiply(Divide(DocFmt.v, 10), 10))))
                SetByte(DocFmt.lab, 2, 46)
                SetByte(DocFmt.lab, 3, 0)
                DocFmt.len = 3
            }
            ElseBlock: {
                SetByte(DocFmt.lab, 0, Add(48, DocFmt.v))
                SetByte(DocFmt.lab, 1, 46)
                SetByte(DocFmt.lab, 2, 0)
                DocFmt.len = 2
            }
            DocFmt.pt = VInst_MeasureWidth(DocDrawScr.inst, DocFmt.lab, DocFmt.len)
            DocFmt.c = Subtract(dx, Add(DocFmt.pt, 4))
            IfCondition LessThan(DocFmt.c, Add(DocFmt.i, 2)) ThenBlock: {
                DocFmt.c = Add(DocFmt.i, 2)
            }
            VInst_DrawString(DocDrawScr.inst, DocDrawScr.canvas, DocFmt.lab, DocFmt.len, DocFmt.c, dy)
        }
    }
}

Function.DocView_PaintLines {
    Body: {
        FontState.draw_color = DocDrawScr.ink
        DocDrawScr.run = ADoc_Get(DocDrawScr.did, ADocField.RUN_PTR)
        DocDrawScr.li = 0
        WhileLoop LessThan(DocDrawScr.li, DocDrawScr.nlines) {
            DocDrawScr.ptr = ADoc_LinePtr(DocDrawScr.did, DocDrawScr.li)
            DocDrawScr.o0 = Dereference(Add(DocDrawScr.ptr, DocLineOff.OFF0))
            DocDrawScr.o1 = Dereference(Add(DocDrawScr.ptr, DocLineOff.OFF1))
            DocDrawScr.xp = Dereference(Add(DocDrawScr.ptr, DocLineOff.X_PX))
            DocDrawScr.oy = Add(Add(Multiply(Dereference(Add(DocDrawScr.ptr, DocLineOff.PAGE)), Add(DocDrawScr.ph, DocLayConst.PAGE_GAP_PX)), DocDrawScr.mt), Dereference(Add(DocDrawScr.ptr, DocLineOff.Y_PX)))
            dx = Subtract(Add(Add(DocDrawScr.sx, DocDrawScr.ml), DocDrawScr.xp), DocDrawScr.scx)
            dy = Subtract(Add(DocDrawScr.sy, DocDrawScr.oy), DocDrawScr.scy)
            DocDrawScr.mark = Dereference(Add(DocDrawScr.ptr, DocLineOff.MARK))
            DocDrawScr.item = Dereference(Add(DocDrawScr.ptr, DocLineOff.ITEM))
            DocDrawScr.hang = Dereference(Add(DocDrawScr.ptr, DocLineOff.HANG))
            IfCondition NotEqual(DocDrawScr.mark, 0) ThenBlock: {
                DocView_PaintMarker(dx, dy)
            }
            sl = Subtract(DocDrawScr.o1, DocDrawScr.o0)
            IfCondition And(GreaterThan(sl, 0), NotEqual(DocDrawScr.run, 0)) ThenBlock: {
                VInst_DrawString(DocDrawScr.inst, DocDrawScr.canvas, Add(DocDrawScr.run, DocDrawScr.o0), sl, dx, dy)
                IfCondition EqualTo(DocDrawScr.bold, 1) ThenBlock: {
                    bx = Subtract(Add(Add(DocDrawScr.sx, DocDrawScr.ml), DocDrawScr.xp), DocDrawScr.scx)
                    by = Subtract(Add(DocDrawScr.sy, DocDrawScr.oy), DocDrawScr.scy)
                    VInst_DrawString(DocDrawScr.inst, DocDrawScr.canvas, Add(DocDrawScr.run, DocDrawScr.o0), Subtract(DocDrawScr.o1, DocDrawScr.o0), Add(bx, 1), by)
                }
                IfCondition EqualTo(DocDrawScr.uline, 1) ThenBlock: {
                    DocDrawScr.xa = VInst_MeasureWidth(DocDrawScr.inst, Add(DocDrawScr.run, DocDrawScr.o0), Subtract(DocDrawScr.o1, DocDrawScr.o0))
                    ux = Subtract(Add(Add(DocDrawScr.sx, DocDrawScr.ml), DocDrawScr.xp), DocDrawScr.scx)
                    uy = Subtract(Add(DocDrawScr.sy, DocDrawScr.oy), DocDrawScr.scy)
                    DocView_ClipFill(ux, Subtract(Add(uy, DocDrawScr.lh), 2), DocDrawScr.xa, 1, DocDrawScr.ink)
                }
            }
            DocDrawScr.li = Add(DocDrawScr.li, 1)
        }
    }
}

Function.DocView_PaintSel {
    Body: {
        sa = DocSess_Get(DocDrawScr.sidx, DocSessOff.SEL_A)
        sb = DocSess_Get(DocDrawScr.sidx, DocSessOff.SEL_B)
        IfCondition EqualTo(sa, sb) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition GreaterThan(sa, sb) ThenBlock: {
            t = sa
            sa = sb
            sb = t
        }
        DocDrawScr.o0 = sa
        DocDrawScr.o1 = sb
        DocDrawScr.run = ADoc_Get(DocDrawScr.did, ADocField.RUN_PTR)
        DocDrawScr.li = 0
        WhileLoop LessThan(DocDrawScr.li, DocDrawScr.nlines) {
            DocDrawScr.ptr = ADoc_LinePtr(DocDrawScr.did, DocDrawScr.li)
            a0 = Dereference(Add(DocDrawScr.ptr, DocLineOff.OFF0))
            a1 = Dereference(Add(DocDrawScr.ptr, DocLineOff.OFF1))
            lo = DocDrawScr.o0
            hi = DocDrawScr.o1
            IfCondition And(LessThan(a0, hi), GreaterThan(a1, lo)) ThenBlock: {
                a = a0
                IfCondition GreaterThan(lo, a) ThenBlock: {
                    a = lo
                }
                b = a1
                IfCondition LessThan(hi, b) ThenBlock: {
                    b = hi
                }
                DocDrawScr.xa = 0
                IfCondition GreaterThan(a, a0) ThenBlock: {
                    DocDrawScr.xa = VInst_MeasureWidth(DocDrawScr.inst, Add(DocDrawScr.run, a0), Subtract(a, a0))
                }
                xb = VInst_MeasureWidth(DocDrawScr.inst, Add(DocDrawScr.run, a0), Subtract(b, a0))
                DocDrawScr.oy = Add(Add(Multiply(Dereference(Add(DocDrawScr.ptr, DocLineOff.PAGE)), Add(DocDrawScr.ph, DocLayConst.PAGE_GAP_PX)), DocDrawScr.mt), Dereference(Add(DocDrawScr.ptr, DocLineOff.Y_PX)))
                dx = Subtract(Add(Add(Add(DocDrawScr.sx, DocDrawScr.ml), Dereference(Add(DocDrawScr.ptr, DocLineOff.X_PX))), DocDrawScr.xa), DocDrawScr.scx)
                dy = Subtract(Add(DocDrawScr.sy, DocDrawScr.oy), DocDrawScr.scy)
                DocView_ClipFill(dx, dy, Subtract(xb, DocDrawScr.xa), DocDrawScr.lh, Theme.ak_selection_bg)
            }
            DocDrawScr.li = Add(DocDrawScr.li, 1)
        }
    }
}

Function.DocView_PaintCaret {
    Body: {
        DocDrawScr.o1 = DocSess_Get(DocDrawScr.sidx, DocSessOff.CARET_OFF)
        DocDrawScr.li = DocLayout_LineAtOff(DocDrawScr.did, DocDrawScr.o1)
        IfCondition LessThan(DocDrawScr.li, 0) ThenBlock: {
            dx = Subtract(Add(DocDrawScr.sx, DocDrawScr.ml), DocDrawScr.scx)
            dy = Subtract(Add(DocDrawScr.sy, DocDrawScr.mt), DocDrawScr.scy)
            DocView_ClipFill(dx, dy, 1, DocDrawScr.lh, 0xFF1A1A1A)
            ReturnValue(0)
        }
        DocDrawScr.ptr = ADoc_LinePtr(DocDrawScr.did, DocDrawScr.li)
        DocDrawScr.o0 = Dereference(Add(DocDrawScr.ptr, DocLineOff.OFF0))
        DocDrawScr.xp = Dereference(Add(DocDrawScr.ptr, DocLineOff.X_PX))
        DocDrawScr.oy = Add(Add(Multiply(Dereference(Add(DocDrawScr.ptr, DocLineOff.PAGE)), Add(DocDrawScr.ph, DocLayConst.PAGE_GAP_PX)), DocDrawScr.mt), Dereference(Add(DocDrawScr.ptr, DocLineOff.Y_PX)))
        DocDrawScr.run = ADoc_Get(DocDrawScr.did, ADocField.RUN_PTR)
        DocDrawScr.xa = 0
        IfCondition GreaterThan(DocDrawScr.o1, DocDrawScr.o0) ThenBlock: {
            DocDrawScr.xa = VInst_MeasureWidth(DocDrawScr.inst, Add(DocDrawScr.run, DocDrawScr.o0), Subtract(DocDrawScr.o1, DocDrawScr.o0))
        }
        dx = Subtract(Add(Add(Add(DocDrawScr.sx, DocDrawScr.ml), DocDrawScr.xp), DocDrawScr.xa), DocDrawScr.scx)
        dy = Subtract(Add(DocDrawScr.sy, DocDrawScr.oy), DocDrawScr.scy)
        DocView_ClipFill(dx, dy, 1, DocDrawScr.lh, 0xFF1A1A1A)
    }
}

Function.DocView_ExpandBand {
    Input: src: Address
    Input: slen: Integer
    Input: page: Integer
    Body: {
        IfCondition EqualTo(DocBand.buf, 0) ThenBlock: {
            DocBand.buf = Allocate(128)
        }
        IfCondition EqualTo(DocBand.buf, 0) ThenBlock: {
            DocBand.n = 0
            ReturnValue(0)
        }
        DocFmt.i = 0
        DocBand.n = 0
        WhileLoop And(LessThan(DocFmt.i, slen), LessThan(DocBand.n, 120)) {
            DocFmt.c = GetByte(src, DocFmt.i)
            IfCondition EqualTo(DocFmt.c, 35) ThenBlock: {
                DocFmt.v = page
                IfCondition GreaterEqual(DocFmt.v, 10) ThenBlock: {
                    SetByte(DocBand.buf, DocBand.n, Add(48, Divide(DocFmt.v, 10)))
                    DocBand.n = Add(DocBand.n, 1)
                }
                SetByte(DocBand.buf, DocBand.n, Add(48, Subtract(DocFmt.v, Multiply(Divide(DocFmt.v, 10), 10))))
                DocBand.n = Add(DocBand.n, 1)
            }
            ElseBlock: {
                SetByte(DocBand.buf, DocBand.n, DocFmt.c)
                DocBand.n = Add(DocBand.n, 1)
            }
            DocFmt.i = Add(DocFmt.i, 1)
        }
        SetByte(DocBand.buf, DocBand.n, 0)
    }
}

Function.DocView_PaintBands {
    Body: {
        IfCondition EqualTo(DocBand.inst, -1) ThenBlock: {
            face = ADoc_Get(DocDrawScr.did, ADocField.FACE)
            IfCondition LessThan(face, 0) ThenBlock: {
                face = FontState.doc_face
            }
            IfCondition LessThan(face, 0) ThenBlock: {
                face = FontState.default_face
            }
            IfCondition GreaterEqual(face, 0) ThenBlock: {
                DocBand.inst = VFont_CreateInstance(face, 13)
            }
        }
        IfCondition LessThan(DocBand.inst, 0) ThenBlock: {
            ReturnValue(0)
        }
        DocDrawScr.li = 0
        WhileLoop LessThan(DocDrawScr.li, DocDrawScr.pc) {
            DocView_PaintOneBand(0)
            DocView_PaintOneBand(1)
            DocDrawScr.li = Add(DocDrawScr.li, 1)
        }
    }
}

Function.DocView_PaintOneBand {
    Input: is_ftr: Integer
    Body: {
        IfCondition EqualTo(is_ftr, 0) ThenBlock: {
            DocFmt.ptr = ADoc_Get(DocDrawScr.did, ADocField.HDR_PTR)
            DocFmt.len = ADoc_Get(DocDrawScr.did, ADocField.HDR_LEN)
        }
        ElseBlock: {
            DocFmt.ptr = ADoc_Get(DocDrawScr.did, ADocField.FTR_PTR)
            DocFmt.len = ADoc_Get(DocDrawScr.did, ADocField.FTR_LEN)
        }
        IfCondition Or(EqualTo(DocFmt.ptr, 0), LessEqual(DocFmt.len, 0)) ThenBlock: {
            ReturnValue(0)
        }
        DocView_ExpandBand(DocFmt.ptr, DocFmt.len, Add(DocDrawScr.li, 1))
        IfCondition LessEqual(DocBand.n, 0) ThenBlock: {
            ReturnValue(0)
        }
        FontState.draw_color = DocDrawScr.ink
        DocDrawScr.xa = VInst_MeasureWidth(DocBand.inst, DocBand.buf, DocBand.n)
        DocFmt.v = VInst_GetLineHeight(DocBand.inst)
        IfCondition LessEqual(DocFmt.v, 0) ThenBlock: {
            DocFmt.v = 12
        }
        DocFmt.pt = ADoc_Get(DocDrawScr.did, ADocField.ALIGN)
        DocDrawScr.xp = DocDrawScr.ml
        IfCondition EqualTo(DocFmt.pt, ADocAlign.CENTER) ThenBlock: {
            DocDrawScr.xp = Add(DocDrawScr.ml, Divide(Subtract(Subtract(Subtract(DocDrawScr.pw, DocDrawScr.ml), DocDrawScr.mr), DocDrawScr.xa), 2))
        }
        IfCondition EqualTo(DocFmt.pt, ADocAlign.RIGHT) ThenBlock: {
            DocDrawScr.xp = Subtract(Subtract(DocDrawScr.pw, DocDrawScr.mr), DocDrawScr.xa)
        }
        IfCondition LessThan(DocDrawScr.xp, 0) ThenBlock: {
            DocDrawScr.xp = 0
        }
        DocDrawScr.oy = Multiply(DocDrawScr.li, Add(DocDrawScr.ph, DocLayConst.PAGE_GAP_PX))
        IfCondition EqualTo(is_ftr, 0) ThenBlock: {
            DocDrawScr.oy = Add(DocDrawScr.oy, Divide(Subtract(DocDrawScr.mt, DocFmt.v), 2))
        }
        ElseBlock: {
            DocDrawScr.oy = Add(DocDrawScr.oy, Subtract(DocDrawScr.ph, Divide(Add(DocDrawScr.mb, DocFmt.v), 2)))
        }
        dx = Subtract(Add(DocDrawScr.sx, DocDrawScr.xp), DocDrawScr.scx)
        dy = Subtract(Add(DocDrawScr.sy, DocDrawScr.oy), DocDrawScr.scy)
        VInst_DrawString(DocBand.inst, DocDrawScr.canvas, DocBand.buf, DocBand.n, dx, dy)
    }
}

Function.DocView_DeleteSel {
    Input: sidx: Integer
    Output: Integer
    Body: {
        sa = DocSess_Get(sidx, DocSessOff.SEL_A)
        sb = DocSess_Get(sidx, DocSessOff.SEL_B)
        IfCondition EqualTo(sa, sb) ThenBlock: {
            ReturnValue(0)
        }
        lo = sa
        hi = sb
        IfCondition GreaterThan(lo, hi) ThenBlock: {
            t = lo
            lo = hi
            hi = t
        }
        did = DocSess_Get(sidx, DocSessOff.DOC_ID)
        ADoc_DeleteRange(did, lo, Subtract(hi, lo))
        DocSess_Set(sidx, DocSessOff.CARET_OFF, lo)
        DocSess_Set(sidx, DocSessOff.SEL_A, lo)
        DocSess_Set(sidx, DocSessOff.SEL_B, lo)
        ReturnValue(1)
    }
}

Function.DocView_CollapseSel {
    Input: sidx: Integer
    Body: {
        c = DocSess_Get(sidx, DocSessOff.CARET_OFF)
        DocSess_Set(sidx, DocSessOff.SEL_A, c)
        DocSess_Set(sidx, DocSessOff.SEL_B, c)
    }
}

Function.DocView_ClampCaret {
    Input: sidx: Integer
    Body: {
        did = DocSess_Get(sidx, DocSessOff.DOC_ID)
        n = ADoc_Get(did, ADocField.RUN_LEN)
        c = DocSess_Get(sidx, DocSessOff.CARET_OFF)
        IfCondition LessThan(c, 0) ThenBlock: {
            c = 0
        }
        IfCondition GreaterThan(c, n) ThenBlock: {
            c = n
        }
        DocSess_Set(sidx, DocSessOff.CARET_OFF, c)
    }
}

Function.DocView_EnsureCaretVisible {
    Input: sidx: Integer
    Input: sw: Integer
    Input: sh: Integer
    Body: {
        did = DocSess_Get(sidx, DocSessOff.DOC_ID)
        fl = ADoc_Get(did, ADocField.FLAGS)
        IfCondition NotEqual(BitwiseAnd(fl, DocFlag.LAYOUT_DIRTY), 0) ThenBlock: {
            DocLayout_Paginate(did)
        }
        ppr = ADoc_Get(did, ADocField.PAPER)
        por = ADoc_Get(did, ADocField.ORIENT)
        DocPaper_SizePt(ppr, por, ADoc_Get(did, ADocField.CUSTOM_W), ADoc_Get(did, ADocField.CUSTOM_H), 0, 0)
        ph = DocLayout_PtToPx(DocPaperOut.h)
        pw = DocLayout_PtToPx(DocPaperOut.w)
        mt = DocLayout_PtToPx(ADoc_Get(did, ADocField.MT))
        ml = DocLayout_PtToPx(ADoc_Get(did, ADocField.ML))
        inst = ADoc_Get(did, ADocField.LAYOUT_INST)
        lh = 16
        IfCondition GreaterEqual(inst, 0) ThenBlock: {
            lh = VInst_GetLineHeight(inst)
            DocLayout_BindTab(did, inst)
        }
        caret = DocSess_Get(sidx, DocSessOff.CARET_OFF)
        li = DocLayout_LineAtOff(did, caret)
        py = mt
        px = ml
        IfCondition GreaterEqual(li, 0) ThenBlock: {
            lp = ADoc_LinePtr(did, li)
            pg = Dereference(Add(lp, DocLineOff.PAGE))
            y = Dereference(Add(lp, DocLineOff.Y_PX))
            o0 = Dereference(Add(lp, DocLineOff.OFF0))
            py = Add(Add(Multiply(pg, Add(ph, DocLayConst.PAGE_GAP_PX)), mt), y)
            run = ADoc_Get(did, ADocField.RUN_PTR)
            IfCondition GreaterThan(caret, o0) ThenBlock: {
                px = Add(ml, VInst_MeasureWidth(inst, Add(run, o0), Subtract(caret, o0)))
            }
        }
        scx = DocSess_Get(sidx, DocSessOff.SCROLL_X)
        scy = DocSess_Get(sidx, DocSessOff.SCROLL_Y)
        IfCondition LessThan(py, scy) ThenBlock: {
            scy = Subtract(py, lh)
        }
        IfCondition GreaterThan(Add(py, lh), Add(scy, sh)) ThenBlock: {
            scy = Subtract(Add(py, lh), sh)
        }
        IfCondition LessThan(px, scx) ThenBlock: {
            scx = px
        }
        IfCondition GreaterThan(Add(px, 1), Add(scx, sw)) ThenBlock: {
            scx = Subtract(Add(px, 1), sw)
        }
        IfCondition LessThan(scx, 0) ThenBlock: {
            scx = 0
        }
        IfCondition LessThan(scy, 0) ThenBlock: {
            scy = 0
        }
        maxy = Subtract(Multiply(ADoc_Get(did, ADocField.PAGE_COUNT), Add(ph, DocLayConst.PAGE_GAP_PX)), sh)
        IfCondition LessThan(maxy, 0) ThenBlock: {
            maxy = 0
        }
        IfCondition GreaterThan(scy, maxy) ThenBlock: {
            scy = maxy
        }
        DocSess_Set(sidx, DocSessOff.SCROLL_X, scx)
        DocSess_Set(sidx, DocSessOff.SCROLL_Y, scy)
    }
}

Function.DocView_MapPtr {
    Input: ctx: LinkagePool.AKContext
    Input: node: Integer
    Input: mx: Integer
    Input: my: Integer
    Input: sidx: Integer
    Body: {
        PlaceHud.lx = Add(Subtract(mx, AK_Get(ctx, node, AKF.SOLVED_X)), DocSess_Get(sidx, DocSessOff.SCROLL_X))
        PlaceHud.ly = Add(Subtract(my, AK_Get(ctx, node, AKF.SOLVED_Y)), DocSess_Get(sidx, DocSessOff.SCROLL_Y))
        IfCondition LessThan(PlaceHud.lx, 0) ThenBlock: {
            PlaceHud.lx = 0
        }
        IfCondition LessThan(PlaceHud.ly, 0) ThenBlock: {
            PlaceHud.ly = 0
        }
    }
}

Function.DocView_PaintBand {
    Body: {
        IfCondition EqualTo(PlaceHud.live, 0) ThenBlock: {
            ReturnValue(0)
        }
        PlaceHud_Norm()
        PlaceHud.oi = Subtract(Add(DocDrawScr.sx, PlaceHud.xa), DocDrawScr.scx)
        PlaceHud.cin = Subtract(Add(DocDrawScr.sy, PlaceHud.ya), DocDrawScr.scy)
        DocView_ClipFill(PlaceHud.oi, PlaceHud.cin, PlaceHud.wpx, 1, Theme.place_band)
        DocView_ClipFill(PlaceHud.oi, Subtract(Add(PlaceHud.cin, PlaceHud.hpx), 1), PlaceHud.wpx, 1, Theme.place_band)
        DocView_ClipFill(PlaceHud.oi, PlaceHud.cin, 1, PlaceHud.hpx, Theme.place_band)
        DocView_ClipFill(Subtract(Add(PlaceHud.oi, PlaceHud.wpx), 1), PlaceHud.cin, 1, PlaceHud.hpx, Theme.place_band)
        IfCondition EqualTo(PlaceHud.tool, PHTool.PLACE) ThenBlock: {
            PlaceHud_DrawHud(DocDrawScr.canvas, PlaceHud.oi, Subtract(PlaceHud.cin, 24))
        }
    }
}

Function.DocView_PaintTextBox {
    Body: {
        PlaceHud.cp = Dereference(Add(PlaceHud.oi, PHFrOff.CHILD))
        PlaceHud.np = Dereference(Add(PlaceHud.oi, PHFrOff.SIDX))
        IfCondition LessThan(PlaceHud.cp, 0) ThenBlock: {
            ReturnValue(0)
        }
        DocDrawScr.oy = Subtract(Add(DocDrawScr.sx, PlaceHud.xa), DocDrawScr.scx)
        DocDrawScr.xa = Subtract(Add(DocDrawScr.sy, PlaceHud.ya), DocDrawScr.scy)
        DocView_ClipFill(DocDrawScr.oy, DocDrawScr.xa, PlaceHud.wpx, PlaceHud.hpx, Theme.page_bg)
        IfCondition EqualTo(PlaceHud.sel_fi, PlaceHud.field) ThenBlock: {
            PlaceHud_Stroke(DocDrawScr.canvas, DocDrawScr.oy, DocDrawScr.xa, PlaceHud.wpx, PlaceHud.hpx, Theme.hud_accent)
        }
        ElseBlock: {
            PlaceHud_Stroke(DocDrawScr.canvas, DocDrawScr.oy, DocDrawScr.xa, PlaceHud.wpx, PlaceHud.hpx, Theme.table_grid)
        }
        DocBoxScr.clip_x = DocDrawScr.clip_x
        DocBoxScr.clip_y = DocDrawScr.clip_y
        DocBoxScr.clip_w = DocDrawScr.clip_w
        DocBoxScr.clip_h = DocDrawScr.clip_h
        DocBoxScr.did = DocDrawScr.did
        DocBoxScr.sidx = DocDrawScr.sidx
        DocBoxScr.inst = DocDrawScr.inst
        DocBoxScr.lh = DocDrawScr.lh
        DocBoxScr.ml = DocDrawScr.ml
        DocBoxScr.mt = DocDrawScr.mt
        DocBoxScr.mr = DocDrawScr.mr
        DocBoxScr.mb = DocDrawScr.mb
        DocBoxScr.pw = DocDrawScr.pw
        DocBoxScr.ph = DocDrawScr.ph
        DocBoxScr.scx = DocDrawScr.scx
        DocBoxScr.scy = DocDrawScr.scy
        DocBoxScr.foc = DocDrawScr.foc
        DocBoxScr.hang = DocDrawScr.hang
        DocDrawScr.clip_x = DocDrawScr.oy
        DocDrawScr.clip_y = DocDrawScr.xa
        DocDrawScr.clip_w = PlaceHud.wpx
        DocDrawScr.clip_h = PlaceHud.hpx
        DocDrawScr.did = PlaceHud.cp
        DocDrawScr.sidx = PlaceHud.np
        DocDrawScr.scx = Subtract(DocBoxScr.scx, PlaceHud.xa)
        DocDrawScr.scy = Subtract(DocBoxScr.scy, PlaceHud.ya)
        IfCondition EqualTo(PlaceHud.sel_fi, PlaceHud.field) ThenBlock: {
            DocDrawScr.foc = 1
        }
        ElseBlock: {
            DocDrawScr.foc = 0
        }
        fl = ADoc_Get(DocDrawScr.did, ADocField.FLAGS)
        IfCondition NotEqual(BitwiseAnd(fl, DocFlag.LAYOUT_DIRTY), 0) ThenBlock: {
            DocLayout_Paginate(DocDrawScr.did)
        }
        IfCondition EqualTo(ADoc_Get(DocDrawScr.did, ADocField.LINE_COUNT), 0) ThenBlock: {
            IfCondition GreaterThan(ADoc_Get(DocDrawScr.did, ADocField.RUN_LEN), 0) ThenBlock: {
                DocLayout_Paginate(DocDrawScr.did)
            }
        }
        DocPaper_SizePt(ADoc_Get(DocDrawScr.did, ADocField.PAPER), ADoc_Get(DocDrawScr.did, ADocField.ORIENT), ADoc_Get(DocDrawScr.did, ADocField.CUSTOM_W), ADoc_Get(DocDrawScr.did, ADocField.CUSTOM_H), 0, 0)
        DocDrawScr.pw = DocLayout_PtToPx(DocPaperOut.w)
        DocDrawScr.ph = DocLayout_PtToPx(DocPaperOut.h)
        DocDrawScr.ml = DocLayout_PtToPx(ADoc_Get(DocDrawScr.did, ADocField.ML))
        DocDrawScr.mt = DocLayout_PtToPx(ADoc_Get(DocDrawScr.did, ADocField.MT))
        DocDrawScr.mr = DocLayout_PtToPx(ADoc_Get(DocDrawScr.did, ADocField.MR))
        DocDrawScr.mb = DocLayout_PtToPx(ADoc_Get(DocDrawScr.did, ADocField.MB))
        DocDrawScr.inst = ADoc_Get(DocDrawScr.did, ADocField.LAYOUT_INST)
        IfCondition LessThan(DocDrawScr.inst, 0) ThenBlock: {
            DocDrawScr.inst = DocLayout_Bind(DocDrawScr.did)
        }
        DocDrawScr.lh = 16
        IfCondition GreaterEqual(DocDrawScr.inst, 0) ThenBlock: {
            DocDrawScr.lh = VInst_GetLineHeight(DocDrawScr.inst)
            DocLayout_BindTab(DocDrawScr.did, DocDrawScr.inst)
        }
        DocView_PaintInk()
        DocDrawScr.clip_x = DocBoxScr.clip_x
        DocDrawScr.clip_y = DocBoxScr.clip_y
        DocDrawScr.clip_w = DocBoxScr.clip_w
        DocDrawScr.clip_h = DocBoxScr.clip_h
        DocDrawScr.did = DocBoxScr.did
        DocDrawScr.sidx = DocBoxScr.sidx
        DocDrawScr.inst = DocBoxScr.inst
        DocDrawScr.lh = DocBoxScr.lh
        DocDrawScr.ml = DocBoxScr.ml
        DocDrawScr.mt = DocBoxScr.mt
        DocDrawScr.mr = DocBoxScr.mr
        DocDrawScr.mb = DocBoxScr.mb
        DocDrawScr.pw = DocBoxScr.pw
        DocDrawScr.ph = DocBoxScr.ph
        DocDrawScr.scx = DocBoxScr.scx
        DocDrawScr.scy = DocBoxScr.scy
        DocDrawScr.foc = DocBoxScr.foc
        DocDrawScr.hang = DocBoxScr.hang
    }
}

Function.DocView_PaintImage {
    Body: {
        DocDrawScr.oy = Subtract(Add(DocDrawScr.sx, PlaceHud.xa), DocDrawScr.scx)
        DocDrawScr.xa = Subtract(Add(DocDrawScr.sy, PlaceHud.ya), DocDrawScr.scy)
        DocView_ClipFill(DocDrawScr.oy, DocDrawScr.xa, PlaceHud.wpx, PlaceHud.hpx, Theme.page_bg)
        PlaceHud.cp = Dereference(Add(PlaceHud.oi, PHFrOff.CHILD))
        IfCondition And(GreaterEqual(PlaceHud.cp, 0), LessThan(PlaceHud.cp, 16)) ThenBlock: {
            ImgBlit.surf = DocDrawScr.canvas
            ImgBlit.dx = DocDrawScr.oy
            ImgBlit.dy = DocDrawScr.xa
            ImgBlit.dw = PlaceHud.wpx
            ImgBlit.dh = PlaceHud.hpx
            ImgBlit.cx0 = DocDrawScr.clip_x
            ImgBlit.cy0 = DocDrawScr.clip_y
            ImgBlit.cx1 = Add(DocDrawScr.clip_x, DocDrawScr.clip_w)
            ImgBlit.cy1 = Add(DocDrawScr.clip_y, DocDrawScr.clip_h)
            ImgXlat_Blit(PlaceHud.cp)
        }
        IfCondition EqualTo(PlaceHud.sel_fi, PlaceHud.field) ThenBlock: {
            PlaceHud_Stroke(DocDrawScr.canvas, DocDrawScr.oy, DocDrawScr.xa, PlaceHud.wpx, PlaceHud.hpx, Theme.hud_accent)
        }
        ElseBlock: {
            PlaceHud_Stroke(DocDrawScr.canvas, DocDrawScr.oy, DocDrawScr.xa, PlaceHud.wpx, PlaceHud.hpx, Theme.table_grid)
        }
    }
}

Function.DocView_PollImagePick {
    Output: Integer
    Body: {
        IfCondition EqualTo(PlaceHud.pick, 1) ThenBlock: {
            PlaceHud.pick = 0
            ReturnValue(1)
        }
        ReturnValue(0)
    }
}

Function.DocView_PaintFrames {
    Body: {
        PlaceHud_Init()
        PlaceHud.field = 0
        WhileLoop LessThan(PlaceHud.field, PlaceHud.nfr) {
            PlaceHud.oi = Add(PlaceHud.fr, Multiply(PlaceHud.field, PHConst.FR_SIZE))
            IfCondition EqualTo(Dereference(Add(PlaceHud.oi, PHFrOff.DID)), DocDrawScr.did) ThenBlock: {
                PlaceHud.xa = Dereference(Add(PlaceHud.oi, PHFrOff.X))
                PlaceHud.ya = Dereference(Add(PlaceHud.oi, PHFrOff.Y))
                PlaceHud.wpx = Dereference(Add(PlaceHud.oi, PHFrOff.W))
                PlaceHud.hpx = Dereference(Add(PlaceHud.oi, PHFrOff.H))
                IfCondition EqualTo(Dereference(Add(PlaceHud.oi, PHFrOff.KIND)), PHConst.KIND_TEXT) ThenBlock: {
                    DocView_PaintTextBox()
                }
                ElseBlock: {
                IfCondition EqualTo(Dereference(Add(PlaceHud.oi, PHFrOff.KIND)), PHConst.KIND_IMAGE) ThenBlock: {
                    DocView_PaintImage()
                    PlaceHud.oi = Add(PlaceHud.fr, Multiply(PlaceHud.field, PHConst.FR_SIZE))
                }
                ElseBlock: {
                IfCondition EqualTo(Dereference(Add(PlaceHud.oi, PHFrOff.KIND)), PHConst.KIND_TABLE) ThenBlock: {
                PlaceHud.tc = Dereference(Add(PlaceHud.oi, PHFrOff.NCOL))
                PlaceHud.tr = Dereference(Add(PlaceHud.oi, PHFrOff.NROW))
                PlaceHud.cfr = Dereference(Add(PlaceHud.oi, PHFrOff.RH))
                IfCondition LessThan(PlaceHud.tc, 1) ThenBlock: {
                    PlaceHud.tc = PHConst.DEF_COL
                }
                IfCondition LessThan(PlaceHud.tr, 1) ThenBlock: {
                    PlaceHud.tr = 1
                }
                IfCondition LessThan(PlaceHud.cfr, 16) ThenBlock: {
                    PlaceHud.cfr = PHConst.DEF_RH
                }
                PlaceHud_UseFont(Dereference(Add(PlaceHud.oi, PHFrOff.FACE)), Dereference(Add(PlaceHud.oi, PHFrOff.SIZE)))
                DocDrawScr.hang = PlaceHud_Gw(PlaceHud.cfr)
                DocDrawScr.oy = Subtract(Add(DocDrawScr.sx, PlaceHud.xa), DocDrawScr.scx)
                DocDrawScr.xa = Subtract(Add(DocDrawScr.sy, PlaceHud.ya), DocDrawScr.scy)
                DocDrawScr.xp = Divide(Subtract(PlaceHud.wpx, DocDrawScr.hang), PlaceHud.tc)
                IfCondition LessThan(DocDrawScr.xp, 1) ThenBlock: {
                    DocDrawScr.xp = 1
                }
                DocView_ClipFill(DocDrawScr.oy, DocDrawScr.xa, DocDrawScr.hang, PlaceHud.hpx, Theme.table_rownum_bg)
                DocView_ClipFill(Add(DocDrawScr.oy, DocDrawScr.hang), DocDrawScr.xa, Subtract(PlaceHud.wpx, DocDrawScr.hang), PlaceHud.cfr, Theme.table_header_bg)
                IfCondition EqualTo(PlaceHud.sel_fi, PlaceHud.field) ThenBlock: {
                    DocView_ClipFill(Add(DocDrawScr.oy, Add(DocDrawScr.hang, Multiply(PlaceHud.sel_c, DocDrawScr.xp))), Add(DocDrawScr.xa, Multiply(PlaceHud.sel_r, PlaceHud.cfr)), DocDrawScr.xp, PlaceHud.cfr, Theme.table_sel_bg)
                }
                PlaceHud.lx = 0
                WhileLoop LessEqual(PlaceHud.lx, PlaceHud.tr) {
                    DocView_ClipFill(DocDrawScr.oy, Add(DocDrawScr.xa, Multiply(PlaceHud.lx, PlaceHud.cfr)), PlaceHud.wpx, 1, Theme.table_grid)
                    IfCondition GreaterThan(PlaceHud.lx, 0) ThenBlock: {
                        IfCondition EqualTo(PlaceHud.lab, 0) ThenBlock: {
                            PlaceHud.lab = Allocate(64)
                        }
                        IfCondition LessThan(PlaceHud.lx, 10) ThenBlock: {
                            SetByte(PlaceHud.lab, 0, Add(48, PlaceHud.lx))
                            SetByte(PlaceHud.lab, 1, 0)
                            FontState.draw_color = Theme.table_rownum_fg
                            VFont_DrawString(DocDrawScr.canvas, PlaceHud.lab, 1, Add(DocDrawScr.oy, 4), Add(Add(DocDrawScr.xa, Multiply(PlaceHud.lx, PlaceHud.cfr)), 4), Theme.table_rownum_fg)
                        }
                        ElseBlock: {
                            SetByte(PlaceHud.lab, 0, Add(48, Divide(PlaceHud.lx, 10)))
                            SetByte(PlaceHud.lab, 1, Add(48, Subtract(PlaceHud.lx, Multiply(Divide(PlaceHud.lx, 10), 10))))
                            SetByte(PlaceHud.lab, 2, 0)
                            FontState.draw_color = Theme.table_rownum_fg
                            VFont_DrawString(DocDrawScr.canvas, PlaceHud.lab, 2, Add(DocDrawScr.oy, 2), Add(Add(DocDrawScr.xa, Multiply(PlaceHud.lx, PlaceHud.cfr)), 4), Theme.table_rownum_fg)
                        }
                    }
                    PlaceHud.lx = Add(PlaceHud.lx, 1)
                }
                DocView_ClipFill(DocDrawScr.oy, Subtract(Add(DocDrawScr.xa, PlaceHud.hpx), 1), PlaceHud.wpx, 1, Theme.table_grid)
                DocView_ClipFill(DocDrawScr.oy, DocDrawScr.xa, 1, PlaceHud.hpx, Theme.table_grid)
                PlaceHud.lx = 0
                WhileLoop LessEqual(PlaceHud.lx, PlaceHud.tc) {
                    DocView_ClipFill(Add(DocDrawScr.oy, Add(DocDrawScr.hang, Multiply(PlaceHud.lx, DocDrawScr.xp))), DocDrawScr.xa, 1, PlaceHud.hpx, Theme.table_grid)
                    PlaceHud.lx = Add(PlaceHud.lx, 1)
                }
                PlaceHud.np = Dereference(Add(PlaceHud.oi, PHFrOff.CELLS))
                IfCondition NotEqual(PlaceHud.np, 0) ThenBlock: {
                    PlaceHud.lx = 0
                    WhileLoop LessEqual(PlaceHud.lx, PlaceHud.tr) {
                        PlaceHud.ly = 0
                        WhileLoop LessThan(PlaceHud.ly, PlaceHud.tc) {
                            PlaceHud.cp = Add(PlaceHud.np, Multiply(Add(Multiply(PlaceHud.lx, PlaceHud.tc), PlaceHud.ly), PHConst.CELL_SIZE))
                            PlaceHud.cin = Dereference(Add(PlaceHud.cp, PHCellOff.PTR))
                            PlaceHud.cwh = Dereference(Add(PlaceHud.cp, PHCellOff.LEN))
                            IfCondition And(NotEqual(PlaceHud.cin, 0), GreaterThan(PlaceHud.cwh, 0)) ThenBlock: {
                                IfCondition EqualTo(PlaceHud.lx, 0) ThenBlock: {
                                    FontState.draw_color = Theme.table_header_fg
                                    VFont_DrawString(DocDrawScr.canvas, PlaceHud.cin, PlaceHud.cwh, Add(Add(DocDrawScr.oy, DocDrawScr.hang), Add(Multiply(PlaceHud.ly, DocDrawScr.xp), 4)), Add(Add(DocDrawScr.xa, Multiply(PlaceHud.lx, PlaceHud.cfr)), 4), Theme.table_header_fg)
                                }
                                ElseBlock: {
                                    FontState.draw_color = Theme.table_cell_fg
                                    VFont_DrawString(DocDrawScr.canvas, PlaceHud.cin, PlaceHud.cwh, Add(Add(DocDrawScr.oy, DocDrawScr.hang), Add(Multiply(PlaceHud.ly, DocDrawScr.xp), 4)), Add(Add(DocDrawScr.xa, Multiply(PlaceHud.lx, PlaceHud.cfr)), 4), Theme.table_cell_fg)
                                }
                            }
                            PlaceHud.ly = Add(PlaceHud.ly, 1)
                        }
                        PlaceHud.lx = Add(PlaceHud.lx, 1)
                    }
                }
                IfCondition EqualTo(PlaceHud.sel_fi, PlaceHud.field) ThenBlock: {
                    PlaceHud.cp = PlaceHud_Cell(PlaceHud.sel_fi, PlaceHud.sel_r, PlaceHud.sel_c)
                    PlaceHud.cin = 0
                    PlaceHud.cwh = 0
                    IfCondition NotEqual(PlaceHud.cp, 0) ThenBlock: {
                        PlaceHud.cin = Dereference(Add(PlaceHud.cp, PHCellOff.PTR))
                        PlaceHud.cwh = Dereference(Add(PlaceHud.cp, PHCellOff.LEN))
                    }
                    PlaceHud.np = 0
                    IfCondition And(NotEqual(PlaceHud.cin, 0), GreaterThan(PlaceHud.sel_off, 0)) ThenBlock: {
                        IfCondition GreaterThan(PlaceHud.sel_off, PlaceHud.cwh) ThenBlock: {
                            PlaceHud.sel_off = PlaceHud.cwh
                        }
                        PlaceHud.np = VFont_MeasureWidth(PlaceHud.cin, PlaceHud.sel_off)
                    }
                    DocView_ClipFill(Add(Add(Add(DocDrawScr.oy, DocDrawScr.hang), Multiply(PlaceHud.sel_c, DocDrawScr.xp)), Add(4, PlaceHud.np)), Add(Add(DocDrawScr.xa, Multiply(PlaceHud.sel_r, PlaceHud.cfr)), 3), 1, Subtract(PlaceHud.cfr, 6), Theme.hud_accent)
                }
                }
                }
                }
            }
            PlaceHud.field = Add(PlaceHud.field, 1)
        }
    }
}

Function.DocView_Click {
    Input: ctx: LinkagePool.AKContext
    Input: node: Integer
    Input: mx: Integer
    Input: my: Integer
    Body: {
        sess = AK_ExtraGet(ctx, node, AKExtra.TEXTBUF_H)
        sidx = DocSess_Idx(sess)
        IfCondition LessThan(sidx, 0) ThenBlock: {
            ReturnValue(0)
        }
        PlaceHud.did = DocSess_Get(sidx, DocSessOff.DOC_ID)
        DocView_MapPtr(ctx, node, mx, my, sidx)
        IfCondition EqualTo(PlaceHud.tool, PHTool.PLACE) ThenBlock: {
            PlaceHud_Begin(PlaceHud.lx, PlaceHud.ly)
            AK_Set(ctx, node, AKF.DIRTY, 1)
            ctx@dirty_count = Add(ctx@dirty_count, 1)
            ReturnValue(0)
        }
        PlaceHud.grab = PlaceHud_HitHandle(PlaceHud.lx, PlaceHud.ly)
        IfCondition GreaterThan(PlaceHud.grab, 0) ThenBlock: {
            PlaceHud_GrabStart(PlaceHud.grab)
            AK_Set(ctx, node, AKF.DIRTY, 1)
            ctx@dirty_count = Add(ctx@dirty_count, 1)
            ReturnValue(0)
        }
        IfCondition EqualTo(PlaceHud_Hit(PlaceHud.did, PlaceHud.lx, PlaceHud.ly), 1) ThenBlock: {
            DocFmt.ctx = ctx
            IfCondition EqualTo(PlaceHud_SelKind(), PHConst.KIND_TABLE) ThenBlock: {
                DocFmt_SyncTableLabels()
            }
            IfCondition EqualTo(PlaceHud_SelKind(), PHConst.KIND_IMAGE) ThenBlock: {
                PlaceHud_GrabStart(PHConst.GRAB_MOVE)
            }
            IfCondition EqualTo(PlaceHud_SelKind(), PHConst.KIND_TEXT) ThenBlock: {
                PlaceHud.oi = PlaceHud_Fr(PlaceHud.sel_fi)
                PlaceHud.cp = Dereference(Add(PlaceHud.oi, PHFrOff.CHILD))
                PlaceHud.np = Dereference(Add(PlaceHud.oi, PHFrOff.SIDX))
                IfCondition And(GreaterEqual(PlaceHud.cp, 0), GreaterEqual(PlaceHud.np, 0)) ThenBlock: {
                    fl = ADoc_Get(PlaceHud.cp, ADocField.FLAGS)
                    IfCondition NotEqual(BitwiseAnd(fl, DocFlag.LAYOUT_DIRTY), 0) ThenBlock: {
                        DocLayout_Paginate(PlaceHud.cp)
                    }
                    inst = ADoc_Get(PlaceHud.cp, ADocField.LAYOUT_INST)
                    IfCondition LessThan(inst, 0) ThenBlock: {
                        inst = DocLayout_Bind(PlaceHud.cp)
                    }
                    IfCondition GreaterEqual(inst, 0) ThenBlock: {
                        DocLayout_BindTab(PlaceHud.cp, inst)
                    }
                    ml = DocLayout_PtToPx(ADoc_Get(PlaceHud.cp, ADocField.ML))
                    mt = DocLayout_PtToPx(ADoc_Get(PlaceHud.cp, ADocField.MT))
                    cx = Subtract(Subtract(PlaceHud.lx, PlaceHud.xa), ml)
                    cy = Subtract(Subtract(PlaceHud.ly, PlaceHud.ya), mt)
                    IfCondition LessThan(cx, 0) ThenBlock: { cx = 0 }
                    IfCondition LessThan(cy, 0) ThenBlock: { cy = 0 }
                    off = DocLayout_Hit(PlaceHud.cp, 0, cx, cy)
                    DocSess_Set(PlaceHud.np, DocSessOff.CARET_OFF, off)
                    DocSess_Set(PlaceHud.np, DocSessOff.SEL_A, off)
                    DocSess_Set(PlaceHud.np, DocSessOff.SEL_B, off)
                }
            }
            AK_Set(ctx, node, AKF.DIRTY, 1)
            ctx@dirty_count = Add(ctx@dirty_count, 1)
            ReturnValue(0)
        }
        PlaceHud.sel_fi = -1
        did = PlaceHud.did
        fl = ADoc_Get(did, ADocField.FLAGS)
        IfCondition NotEqual(BitwiseAnd(fl, DocFlag.LAYOUT_DIRTY), 0) ThenBlock: {
            DocLayout_Paginate(did)
        }
        sx = AK_Get(ctx, node, AKF.SOLVED_X)
        sy = AK_Get(ctx, node, AKF.SOLVED_Y)
        DocPaper_SizePt(ADoc_Get(did, ADocField.PAPER), ADoc_Get(did, ADocField.ORIENT), ADoc_Get(did, ADocField.CUSTOM_W), ADoc_Get(did, ADocField.CUSTOM_H), 0, 0)
        ph = DocLayout_PtToPx(DocPaperOut.h)
        stride = Add(ph, DocLayConst.PAGE_GAP_PX)
        IfCondition LessEqual(stride, 0) ThenBlock: {
            stride = 1
        }
        scx = DocSess_Get(sidx, DocSessOff.SCROLL_X)
        scy = DocSess_Get(sidx, DocSessOff.SCROLL_Y)
        lx = Add(Subtract(mx, sx), scx)
        ly = Add(Subtract(my, sy), scy)
        pg = Divide(ly, stride)
        yin = Subtract(ly, Multiply(pg, stride))
        ml = DocLayout_PtToPx(ADoc_Get(did, ADocField.ML))
        mt = DocLayout_PtToPx(ADoc_Get(did, ADocField.MT))
        cx = Subtract(lx, ml)
        cy = Subtract(yin, mt)
        IfCondition LessThan(cx, 0) ThenBlock: {
            cx = 0
        }
        IfCondition LessThan(cy, 0) ThenBlock: {
            cy = 0
        }
        IfCondition LessThan(pg, 0) ThenBlock: {
            pg = 0
        }
        inst = ADoc_Get(did, ADocField.LAYOUT_INST)
        IfCondition GreaterEqual(inst, 0) ThenBlock: {
            DocLayout_BindTab(did, inst)
        }
        off = DocLayout_Hit(did, pg, cx, cy)
        DocSess_Set(sidx, DocSessOff.CARET_OFF, off)
        DocSess_Set(sidx, DocSessOff.SEL_A, off)
        DocSess_Set(sidx, DocSessOff.SEL_B, off)
        PlaceHud_Begin(PlaceHud.lx, PlaceHud.ly)
        AK_Set(ctx, node, AKF.DIRTY, 1)
        ctx@dirty_count = Add(ctx@dirty_count, 1)
    }
}

Function.DocView_Drag {
    Input: ctx: LinkagePool.AKContext
    Input: node: Integer
    Input: mx: Integer
    Input: my: Integer
    Body: {
        sess = AK_ExtraGet(ctx, node, AKExtra.TEXTBUF_H)
        sidx = DocSess_Idx(sess)
        IfCondition LessThan(sidx, 0) ThenBlock: {
            ReturnValue(0)
        }
        DocView_MapPtr(ctx, node, mx, my, sidx)
        IfCondition GreaterThan(PlaceHud.grab, 0) ThenBlock: {
            PlaceHud_GrabApply()
            AK_Set(ctx, node, AKF.DIRTY, 1)
            ctx@dirty_count = Add(ctx@dirty_count, 1)
            ReturnValue(0)
        }
        IfCondition EqualTo(PlaceHud.live, 0) ThenBlock: {
            ReturnValue(0)
        }
        PlaceHud_Move(PlaceHud.lx, PlaceHud.ly)
        IfCondition EqualTo(PlaceHud.tool, PHTool.PLACE) ThenBlock: {
            AK_Set(ctx, node, AKF.DIRTY, 1)
            ctx@dirty_count = Add(ctx@dirty_count, 1)
            ReturnValue(0)
        }
        IfCondition EqualTo(PlaceHud.drag, 0) ThenBlock: {
            ReturnValue(0)
        }
        did = DocSess_Get(sidx, DocSessOff.DOC_ID)
        DocPaper_SizePt(ADoc_Get(did, ADocField.PAPER), ADoc_Get(did, ADocField.ORIENT), ADoc_Get(did, ADocField.CUSTOM_W), ADoc_Get(did, ADocField.CUSTOM_H), 0, 0)
        ph = DocLayout_PtToPx(DocPaperOut.h)
        stride = Add(ph, DocLayConst.PAGE_GAP_PX)
        IfCondition LessEqual(stride, 0) ThenBlock: {
            stride = 1
        }
        pg = Divide(PlaceHud.ly, stride)
        yin = Subtract(PlaceHud.ly, Multiply(pg, stride))
        ml = DocLayout_PtToPx(ADoc_Get(did, ADocField.ML))
        mt = DocLayout_PtToPx(ADoc_Get(did, ADocField.MT))
        cx = Subtract(PlaceHud.lx, ml)
        cy = Subtract(yin, mt)
        IfCondition LessThan(cx, 0) ThenBlock: { cx = 0 }
        IfCondition LessThan(cy, 0) ThenBlock: { cy = 0 }
        IfCondition LessThan(pg, 0) ThenBlock: { pg = 0 }
        inst = ADoc_Get(did, ADocField.LAYOUT_INST)
        IfCondition GreaterEqual(inst, 0) ThenBlock: {
            DocLayout_BindTab(did, inst)
        }
        off = DocLayout_Hit(did, pg, cx, cy)
        DocSess_Set(sidx, DocSessOff.SEL_B, off)
        DocSess_Set(sidx, DocSessOff.CARET_OFF, off)
        AK_Set(ctx, node, AKF.DIRTY, 1)
        ctx@dirty_count = Add(ctx@dirty_count, 1)
    }
}

Function.DocView_Up {
    Input: ctx: LinkagePool.AKContext
    Input: node: Integer
    Input: mx: Integer
    Input: my: Integer
    Body: {
        sess = AK_ExtraGet(ctx, node, AKExtra.TEXTBUF_H)
        sidx = DocSess_Idx(sess)
        IfCondition LessThan(sidx, 0) ThenBlock: {
            PlaceHud_Cancel()
            ReturnValue(0)
        }
        DocView_MapPtr(ctx, node, mx, my, sidx)
        IfCondition And(EqualTo(PlaceHud.tool, PHTool.PLACE), EqualTo(PlaceHud.live, 1)) ThenBlock: {
            PlaceHud_Move(PlaceHud.lx, PlaceHud.ly)
            IfCondition EqualTo(PlaceHud.drag, 1) ThenBlock: {
                PlaceHud.did = DocSess_Get(sidx, DocSessOff.DOC_ID)
                PlaceHud.tf = ADoc_Get(PlaceHud.did, ADocField.FACE)
                PlaceHud.tsz = ADoc_Get(PlaceHud.did, ADocField.SIZE_PT)
                IfCondition EqualTo(PlaceHud.kind, PHConst.KIND_IMAGE) ThenBlock: {
                    PlaceHud.np = PlaceHud_AddImage(PlaceHud.did)
                    PrintMessage("[PlaceHud] image place\n")
                }
                ElseBlock: {
                IfCondition EqualTo(PlaceHud.kind, PHConst.KIND_TEXT) ThenBlock: {
                    PlaceHud.wpx = PlaceHud.wpx
                    PlaceHud.cp = Divide(Multiply(PlaceHud.wpx, 72), 96)
                    PlaceHud.np = Divide(Multiply(PlaceHud.hpx, 72), 96)
                    PlaceHud.cfr = DocSess_CreateBox(PlaceHud.cp, PlaceHud.np, PlaceHud.tf, PlaceHud.tsz)
                    PlaceHud.oi = DocSess_Idx(PlaceHud.cfr)
                    IfCondition GreaterEqual(PlaceHud.oi, 0) ThenBlock: {
                        PlaceHud.cp = DocSess_Get(PlaceHud.oi, DocSessOff.DOC_ID)
                        DocLayout_Bind(PlaceHud.cp)
                        PlaceHud.np = PlaceHud_AddBox(PlaceHud.did, PlaceHud.cp, PlaceHud.oi, PlaceHud.tf, PlaceHud.tsz)
                    }
                    ElseBlock: {
                        PlaceHud.np = -1
                    }
                }
                ElseBlock: {
                    PlaceHud.np = PlaceHud_AddFrame(PlaceHud.did, PlaceHud.tf, PlaceHud.tsz)
                    PrintMessage("[PlaceHud] table frame w=")
                    PrintNumber(PlaceHud.wpx)
                    PrintMessage(" h=")
                    PrintNumber(PlaceHud.hpx)
                    PrintMessage(" rows=")
                    PrintNumber(PlaceHud.tr)
                    PrintMessage("\n")
                }
                }
                IfCondition GreaterEqual(PlaceHud.np, 0) ThenBlock: {
                    PlaceHud_SetTool(PHTool.CARET)
                    DocFmt_SyncTableBtn(ctx)
                    DocFmt_SyncBoxBtn(ctx)
                    DocFmt_SyncImgBtn(ctx)
                    DocFmt.ctx = ctx
                    IfCondition EqualTo(PlaceHud_SelKind(), PHConst.KIND_TABLE) ThenBlock: {
                        DocFmt_SyncTableLabels()
                    }
                }
            }
        }
        PlaceHud.live = 0
        PlaceHud.drag = 0
        PlaceHud.grab = 0
        AK_Set(ctx, node, AKF.DIRTY, 1)
        ctx@dirty_count = Add(ctx@dirty_count, 1)
    }
}

Function.DocView_Wheel {
    Input: ctx: LinkagePool.AKContext
    Input: node: Integer
    Input: data: Integer
    Body: {
        sess = AK_ExtraGet(ctx, node, AKExtra.TEXTBUF_H)
        sidx = DocSess_Idx(sess)
        IfCondition LessThan(sidx, 0) ThenBlock: {
            ReturnValue(0)
        }
        did = DocSess_Get(sidx, DocSessOff.DOC_ID)
        inst = ADoc_Get(did, ADocField.LAYOUT_INST)
        lh = 16
        IfCondition GreaterEqual(inst, 0) ThenBlock: {
            lh = VInst_GetLineHeight(inst)
        }
        step = Multiply(lh, 3)
        scy = DocSess_Get(sidx, DocSessOff.SCROLL_Y)
        IfCondition GreaterThan(data, 0) ThenBlock: {
            scy = Subtract(scy, step)
        }
        IfCondition LessThan(data, 0) ThenBlock: {
            scy = Add(scy, step)
        }
        IfCondition LessThan(scy, 0) ThenBlock: {
            scy = 0
        }
        sh = AK_Get(ctx, node, AKF.SOLVED_H)
        DocPaper_SizePt(ADoc_Get(did, ADocField.PAPER), ADoc_Get(did, ADocField.ORIENT), ADoc_Get(did, ADocField.CUSTOM_W), ADoc_Get(did, ADocField.CUSTOM_H), 0, 0)
        ph = DocLayout_PtToPx(DocPaperOut.h)
        maxy = Subtract(Multiply(ADoc_Get(did, ADocField.PAGE_COUNT), Add(ph, DocLayConst.PAGE_GAP_PX)), sh)
        IfCondition LessThan(maxy, 0) ThenBlock: {
            maxy = 0
        }
        IfCondition GreaterThan(scy, maxy) ThenBlock: {
            scy = maxy
        }
        DocSess_Set(sidx, DocSessOff.SCROLL_Y, scy)
        AK_Set(ctx, node, AKF.DIRTY, 1)
        ctx@dirty_count = Add(ctx@dirty_count, 1)
    }
}

Function.DocView_KeyNav {
    Input: sidx: Integer
    Input: keycode: Integer
    Input: shift: Integer
    Input: ctrl: Integer
    Output: Integer
    Body: {
        did = DocSess_Get(sidx, DocSessOff.DOC_ID)
        caret = DocSess_Get(sidx, DocSessOff.CARET_OFF)
        nlen = ADoc_Get(did, ADocField.RUN_LEN)
        IfCondition EqualTo(shift, 0) ThenBlock: {
            DocView_CollapseSel(sidx)
        }
        ElseBlock: {
            IfCondition EqualTo(DocSess_Get(sidx, DocSessOff.SEL_A), DocSess_Get(sidx, DocSessOff.SEL_B)) ThenBlock: {
                DocSess_Set(sidx, DocSessOff.SEL_A, caret)
            }
        }
        IfCondition EqualTo(keycode, Key.LEFT) ThenBlock: {
            caret = Subtract(caret, 1)
        }
        IfCondition EqualTo(keycode, Key.RIGHT) ThenBlock: {
            caret = Add(caret, 1)
        }
        IfCondition EqualTo(keycode, Key.HOME) ThenBlock: {
            IfCondition EqualTo(ctrl, 1) ThenBlock: {
                caret = 0
            }
            ElseBlock: {
                li = DocLayout_LineAtOff(did, caret)
                IfCondition GreaterEqual(li, 0) ThenBlock: {
                    caret = Dereference(Add(ADoc_LinePtr(did, li), DocLineOff.OFF0))
                }
            }
        }
        IfCondition EqualTo(keycode, Key.END) ThenBlock: {
            IfCondition EqualTo(ctrl, 1) ThenBlock: {
                caret = nlen
            }
            ElseBlock: {
                li = DocLayout_LineAtOff(did, caret)
                IfCondition GreaterEqual(li, 0) ThenBlock: {
                    caret = Dereference(Add(ADoc_LinePtr(did, li), DocLineOff.OFF1))
                }
            }
        }
        IfCondition EqualTo(keycode, Key.UP) ThenBlock: {
            DocView_MoveVert(sidx, 0)
            caret = DocSess_Get(sidx, DocSessOff.CARET_OFF)
        }
        IfCondition EqualTo(keycode, Key.DOWN) ThenBlock: {
            DocView_MoveVert(sidx, 1)
            caret = DocSess_Get(sidx, DocSessOff.CARET_OFF)
        }
        DocSess_Set(sidx, DocSessOff.CARET_OFF, caret)
        DocView_ClampCaret(sidx)
        IfCondition EqualTo(shift, 1) ThenBlock: {
            DocSess_Set(sidx, DocSessOff.SEL_B, DocSess_Get(sidx, DocSessOff.CARET_OFF))
        }
        ElseBlock: {
            DocView_CollapseSel(sidx)
        }
        ReturnValue(1)
    }
}

Function.DocView_MoveVert {
    Input: sidx: Integer
    Input: down: Integer
    Body: {
        did = DocSess_Get(sidx, DocSessOff.DOC_ID)
        caret = DocSess_Get(sidx, DocSessOff.CARET_OFF)
        li = DocLayout_LineAtOff(did, caret)
        IfCondition LessThan(li, 0) ThenBlock: {
            ReturnValue(0)
        }
        n = ADoc_Get(did, ADocField.LINE_COUNT)
        ni = Subtract(li, 1)
        IfCondition EqualTo(down, 1) ThenBlock: {
            ni = Add(li, 1)
        }
        IfCondition LessThan(ni, 0) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition GreaterEqual(ni, n) ThenBlock: {
            ReturnValue(0)
        }
        lp = ADoc_LinePtr(did, li)
        o0 = Dereference(Add(lp, DocLineOff.OFF0))
        run = ADoc_Get(did, ADocField.RUN_PTR)
        inst = ADoc_Get(did, ADocField.LAYOUT_INST)
        IfCondition GreaterEqual(inst, 0) ThenBlock: {
            DocLayout_BindTab(did, inst)
        }
        xa = 0
        IfCondition GreaterThan(caret, o0) ThenBlock: {
            xa = VInst_MeasureWidth(inst, Add(run, o0), Subtract(caret, o0))
        }
        np = ADoc_LinePtr(did, ni)
        n0 = Dereference(Add(np, DocLineOff.OFF0))
        n1 = Dereference(Add(np, DocLineOff.OFF1))
        col = VInst_PixelToCol(inst, Add(run, n0), Subtract(n1, n0), xa)
        DocSess_Set(sidx, DocSessOff.CARET_OFF, Add(n0, col))
    }
}

Function.DocView_KeyEdit {
    Input: sidx: Integer
    Input: keycode: Integer
    Input: ch: Integer
    Input: ctrl: Integer
    Output: Integer
    Body: {
        flags = DocSess_Get(sidx, DocSessOff.FLAGS)
        IfCondition NotEqual(BitwiseAnd(flags, DocSessFlag.READONLY), 0) ThenBlock: {
            ReturnValue(0)
        }
        did = DocSess_Get(sidx, DocSessOff.DOC_ID)
        IfCondition EqualTo(ctrl, 1) ThenBlock: {
            ReturnValue(DocView_KeyCtrl(sidx, keycode, ch))
        }
        IfCondition EqualTo(keycode, Key.BACKSPACE) ThenBlock: {
            IfCondition EqualTo(DocView_DeleteSel(sidx), 0) ThenBlock: {
                c = DocSess_Get(sidx, DocSessOff.CARET_OFF)
                DocFmt.i = ADoc_ParaAtOff(did, c)
                DocFmt.v = 0
                IfCondition GreaterEqual(DocFmt.i, 0) ThenBlock: {
                    DocFmt.ptr = ADoc_ParaPtr(did, DocFmt.i)
                    IfCondition And(EqualTo(c, Dereference(Add(DocFmt.ptr, ADocParaOff.OFF0))), NotEqual(Dereference(Add(DocFmt.ptr, ADocParaOff.KIND)), 0)) ThenBlock: {
                        ADoc_ParaIndent(did, c, Subtract(0, 1))
                        DocFmt.v = 1
                    }
                }
                IfCondition And(EqualTo(DocFmt.v, 0), GreaterThan(c, 0)) ThenBlock: {
                    ADoc_DeleteRange(did, Subtract(c, 1), 1)
                    DocSess_Set(sidx, DocSessOff.CARET_OFF, Subtract(c, 1))
                    DocView_CollapseSel(sidx)
                }
            }
            ReturnValue(1)
        }
        IfCondition EqualTo(keycode, Key.DELETE) ThenBlock: {
            IfCondition EqualTo(DocView_DeleteSel(sidx), 0) ThenBlock: {
                c = DocSess_Get(sidx, DocSessOff.CARET_OFF)
                ADoc_DeleteRange(did, c, 1)
                DocView_CollapseSel(sidx)
            }
            ReturnValue(1)
        }
        IfCondition EqualTo(keycode, Key.ENTER) ThenBlock: {
            DocView_DeleteSel(sidx)
            DocFmt.did = did
            DocFmt.c = DocSess_Get(sidx, DocSessOff.CARET_OFF)
            DocFmt.i = ADoc_ParaAtOff(DocFmt.did, DocFmt.c)
            DocFmt.v = 0
            IfCondition GreaterEqual(DocFmt.i, 0) ThenBlock: {
                DocFmt.ptr = ADoc_ParaPtr(DocFmt.did, DocFmt.i)
                IfCondition And(NotEqual(Dereference(Add(DocFmt.ptr, ADocParaOff.KIND)), 0), LessEqual(ADoc_ParaContentLen(DocFmt.did, DocFmt.i), 0)) ThenBlock: {
                    StoreValue(Add(DocFmt.ptr, ADocParaOff.KIND), 0)
                    StoreValue(Add(DocFmt.ptr, ADocParaOff.INDENT), 0)
                    ADoc_ParaRenumber(DocFmt.did)
                    ADoc_MarkDirty(DocFmt.did)
                    DocFmt.v = 1
                }
            }
            IfCondition EqualTo(DocFmt.v, 0) ThenBlock: {
                ADoc_InsertByte(DocFmt.did, DocFmt.c, 10)
                ADoc_ParaSplit(DocFmt.did, Add(DocFmt.c, 1))
                DocSess_Set(sidx, DocSessOff.CARET_OFF, Add(DocFmt.c, 1))
            }
            DocView_CollapseSel(sidx)
            ReturnValue(1)
        }
        IfCondition And(GreaterEqual(ch, 32), LessThan(ch, 127)) ThenBlock: {
            DocView_DeleteSel(sidx)
            c = DocSess_Get(sidx, DocSessOff.CARET_OFF)
            ADoc_InsertByte(did, c, ch)
            DocSess_Set(sidx, DocSessOff.CARET_OFF, Add(c, 1))
            DocView_CollapseSel(sidx)
            ReturnValue(1)
        }
        IfCondition Or(EqualTo(keycode, Key.TAB), EqualTo(ch, 9)) ThenBlock: {
            DocFmt.sidx = sidx
            DocView_DeleteSel(DocFmt.sidx)
            DocFmt.did = DocSess_Get(DocFmt.sidx, DocSessOff.DOC_ID)
            DocFmt.c = DocSess_Get(DocFmt.sidx, DocSessOff.CARET_OFF)
            DocFmt.i = ADoc_ParaAtOff(DocFmt.did, DocFmt.c)
            DocFmt.v = 0
            IfCondition GreaterEqual(DocFmt.i, 0) ThenBlock: {
                DocFmt.ptr = ADoc_ParaPtr(DocFmt.did, DocFmt.i)
                IfCondition And(NotEqual(Dereference(Add(DocFmt.ptr, ADocParaOff.KIND)), 0), EqualTo(DocFmt.c, Dereference(Add(DocFmt.ptr, ADocParaOff.OFF0)))) ThenBlock: {
                    ADoc_ParaIndent(DocFmt.did, DocFmt.c, 1)
                    DocFmt.v = 1
                }
            }
            IfCondition EqualTo(DocFmt.v, 0) ThenBlock: {
                ADoc_InsertByte(DocFmt.did, DocFmt.c, 9)
                DocSess_Set(DocFmt.sidx, DocSessOff.CARET_OFF, Add(DocFmt.c, 1))
            }
            DocView_CollapseSel(DocFmt.sidx)
            ReturnValue(1)
        }
        ReturnValue(0)
    }
}

Function.DocView_KeyCtrl {
    Input: sidx: Integer
    Input: keycode: Integer
    Input: ch: Integer
    Output: Integer
    Body: {
        did = DocSess_Get(sidx, DocSessOff.DOC_ID)
        run = ADoc_Get(did, ADocField.RUN_PTR)
        nlen = ADoc_Get(did, ADocField.RUN_LEN)
        sa = DocSess_Get(sidx, DocSessOff.SEL_A)
        sb = DocSess_Get(sidx, DocSessOff.SEL_B)
        lo = sa
        hi = sb
        IfCondition GreaterThan(lo, hi) ThenBlock: {
            t = lo
            lo = hi
            hi = t
        }
        is_a = EqualTo(keycode, Key.A)
        IfCondition Or(EqualTo(ch, 1), Or(EqualTo(ch, 97), EqualTo(ch, 65))) ThenBlock: {
            is_a = 1
        }
        IfCondition EqualTo(is_a, 1) ThenBlock: {
            DocSess_Set(sidx, DocSessOff.SEL_A, 0)
            DocSess_Set(sidx, DocSessOff.SEL_B, nlen)
            DocSess_Set(sidx, DocSessOff.CARET_OFF, nlen)
            ReturnValue(1)
        }
        is_c = EqualTo(keycode, Key.C)
        IfCondition Or(EqualTo(ch, 3), Or(EqualTo(ch, 99), EqualTo(ch, 67))) ThenBlock: {
            is_c = 1
        }
        IfCondition EqualTo(is_c, 1) ThenBlock: {
            IfCondition GreaterThan(hi, lo) ThenBlock: {
                Clipboard_Set(Add(run, lo), Subtract(hi, lo))
            }
            ReturnValue(1)
        }
        is_x = EqualTo(keycode, Key.X)
        IfCondition Or(EqualTo(ch, 24), Or(EqualTo(ch, 120), EqualTo(ch, 88))) ThenBlock: {
            is_x = 1
        }
        IfCondition EqualTo(is_x, 1) ThenBlock: {
            IfCondition GreaterThan(hi, lo) ThenBlock: {
                Clipboard_Set(Add(run, lo), Subtract(hi, lo))
                DocView_DeleteSel(sidx)
            }
            ReturnValue(1)
        }
        is_v = EqualTo(keycode, Key.V)
        IfCondition Or(EqualTo(ch, 22), Or(EqualTo(ch, 118), EqualTo(ch, 86))) ThenBlock: {
            is_v = 1
        }
        IfCondition EqualTo(is_v, 1) ThenBlock: {
            DocView_DeleteSel(sidx)
            c = DocSess_Get(sidx, DocSessOff.CARET_OFF)
            cp = Clipboard_Get()
            cl = Clipboard.len
            IfCondition And(NotEqual(cp, 0), GreaterThan(cl, 0)) ThenBlock: {
                ADoc_InsertAt(did, c, cp, cl)
                DocSess_Set(sidx, DocSessOff.CARET_OFF, Add(c, cl))
                DocView_CollapseSel(sidx)
            }
            ReturnValue(1)
        }
        ReturnValue(0)
    }
}

Function.DocView_Key {
    Input: ctx: LinkagePool.AKContext
    Input: node: Integer
    Input: keycode: Integer
    Input: ch: Integer
    Input: shift: Integer
    Input: ctrl: Integer
    Output: Integer
    Body: {
        sess = AK_ExtraGet(ctx, node, AKExtra.TEXTBUF_H)
        sidx = DocSess_Idx(sess)
        IfCondition LessThan(sidx, 0) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition EqualTo(keycode, Key.ESC) ThenBlock: {
            IfCondition GreaterEqual(PlaceHud.sel_fi, 0) ThenBlock: {
                PlaceHud.sel_fi = -1
                AK_Set(ctx, node, AKF.DIRTY, 1)
                ctx@dirty_count = Add(ctx@dirty_count, 1)
                ReturnValue(1)
            }
            PlaceHud_Cancel()
            IfCondition EqualTo(PlaceHud.tool, PHTool.PLACE) ThenBlock: {
                PlaceHud_SetTool(PHTool.CARET)
                DocFmt_SyncTableBtn(ctx)
                DocFmt_SyncBoxBtn(ctx)
                DocFmt_SyncImgBtn(ctx)
            }
            AK_Set(ctx, node, AKF.DIRTY, 1)
            ctx@dirty_count = Add(ctx@dirty_count, 1)
            ReturnValue(1)
        }
        IfCondition GreaterEqual(PlaceHud.sel_fi, 0) ThenBlock: {
            IfCondition EqualTo(PlaceHud_SelKind(), PHConst.KIND_TABLE) ThenBlock: {
                handled = PlaceHud_Key(keycode, ch, shift)
                IfCondition EqualTo(handled, 1) ThenBlock: {
                    AK_Set(ctx, node, AKF.DIRTY, 1)
                    ctx@dirty_count = Add(ctx@dirty_count, 1)
                    ReturnValue(1)
                }
            }
            IfCondition EqualTo(PlaceHud_SelKind(), PHConst.KIND_TEXT) ThenBlock: {
                PlaceHud.oi = PlaceHud_Fr(PlaceHud.sel_fi)
                PlaceHud.np = Dereference(Add(PlaceHud.oi, PHFrOff.SIDX))
                IfCondition GreaterEqual(PlaceHud.np, 0) ThenBlock: {
                    sidx = PlaceHud.np
                }
            }
            IfCondition EqualTo(PlaceHud_SelKind(), PHConst.KIND_IMAGE) ThenBlock: {
                IfCondition EqualTo(keycode, Key.LEFT) ThenBlock: {
                    PlaceHud_Nudge(Negate(4), 0)
                }
                IfCondition EqualTo(keycode, Key.RIGHT) ThenBlock: {
                    PlaceHud_Nudge(4, 0)
                }
                IfCondition EqualTo(keycode, Key.UP) ThenBlock: {
                    PlaceHud_Nudge(0, Negate(4))
                }
                IfCondition EqualTo(keycode, Key.DOWN) ThenBlock: {
                    PlaceHud_Nudge(0, 4)
                }
                AK_Set(ctx, node, AKF.DIRTY, 1)
                ctx@dirty_count = Add(ctx@dirty_count, 1)
                ReturnValue(1)
            }
        }
        handled = 0
        is_nav = 0
        IfCondition EqualTo(keycode, Key.LEFT) ThenBlock: { is_nav = 1 }
        IfCondition EqualTo(keycode, Key.RIGHT) ThenBlock: { is_nav = 1 }
        IfCondition EqualTo(keycode, Key.UP) ThenBlock: { is_nav = 1 }
        IfCondition EqualTo(keycode, Key.DOWN) ThenBlock: { is_nav = 1 }
        IfCondition EqualTo(keycode, Key.HOME) ThenBlock: { is_nav = 1 }
        IfCondition EqualTo(keycode, Key.END) ThenBlock: { is_nav = 1 }
        IfCondition EqualTo(is_nav, 1) ThenBlock: {
            handled = DocView_KeyNav(sidx, keycode, shift, ctrl)
        }
        IfCondition EqualTo(handled, 0) ThenBlock: {
            handled = DocView_KeyEdit(sidx, keycode, ch, ctrl)
        }
        IfCondition EqualTo(handled, 1) ThenBlock: {
            sw = AK_Get(ctx, node, AKF.SOLVED_W)
            sh = AK_Get(ctx, node, AKF.SOLVED_H)
            DocView_EnsureCaretVisible(sidx, sw, sh)
            AK_Set(ctx, node, AKF.DIRTY, 1)
            ctx@dirty_count = Add(ctx@dirty_count, 1)
        }
        ReturnValue(handled)
    }
}

Function.DocFmt_BindSess {
    Input: ctx: LinkagePool.AKContext
    Output: Integer
    Body: {
        DocFmt.ctx = ctx
        DocFmt.node = AK_GetFocusNode(ctx)
        IfCondition GreaterEqual(DocFmt.node, 0) ThenBlock: {
            IfCondition NotEqual(AK_Get(ctx, DocFmt.node, AKF.TAG), AKTag.DOCVIEW) ThenBlock: {
                DocFmt.node = -1
            }
        }
        IfCondition LessThan(DocFmt.node, 0) ThenBlock: {
            DocFmt.node = AK_FindById(ctx, "main")
        }
        IfCondition LessThan(DocFmt.node, 0) ThenBlock: {
            ReturnValue(0)
        }
        sess = AK_ExtraGet(ctx, DocFmt.node, AKExtra.TEXTBUF_H)
        DocFmt.sidx = DocSess_Idx(sess)
        IfCondition LessThan(DocFmt.sidx, 0) ThenBlock: {
            ReturnValue(0)
        }
        DocFmt.did = DocSess_Get(DocFmt.sidx, DocSessOff.DOC_ID)
        IfCondition LessThan(DocFmt.did, 0) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition EqualTo(PlaceHud_SelKind(), PHConst.KIND_TEXT) ThenBlock: {
            PlaceHud.oi = PlaceHud_Fr(PlaceHud.sel_fi)
            PlaceHud.np = Dereference(Add(PlaceHud.oi, PHFrOff.SIDX))
            PlaceHud.cp = Dereference(Add(PlaceHud.oi, PHFrOff.CHILD))
            IfCondition GreaterEqual(PlaceHud.np, 0) ThenBlock: {
                DocFmt.sidx = PlaceHud.np
            }
            IfCondition GreaterEqual(PlaceHud.cp, 0) ThenBlock: {
                DocFmt.did = PlaceHud.cp
            }
        }
        ReturnValue(1)
    }
}

Function.DocFmt_ReadInput {
    Input: id_str: Address
    Body: {
        DocFmt.ptr = 0
        DocFmt.len = 0
        n = AK_FindById(DocFmt.ctx, id_str)
        IfCondition LessThan(n, 0) ThenBlock: {
            ReturnValue(0)
        }
        tbh = AK_ExtraGet(DocFmt.ctx, n, AKExtra.TEXTBUF_H)
        IfCondition LessEqual(tbh, 0) ThenBlock: {
            ReturnValue(0)
        }
        DocFmt.ptr = TextBuf_GetLine(tbh, 0)
        IfCondition EqualTo(DocFmt.ptr, 0) ThenBlock: {
            DocFmt.len = 0
            ReturnValue(0)
        }
        DocFmt.len = StringLength(DocFmt.ptr)
    }
}

Function.DocFmt_ParseInch {
    Output: Integer
    Body: {
        DocFmt.whole = 0
        DocFmt.frac = 0
        DocFmt.fdiv = 1
        DocFmt.dot = 0
        DocFmt.i = 0
        WhileLoop LessThan(DocFmt.i, DocFmt.len) {
            DocFmt.c = GetByte(DocFmt.ptr, DocFmt.i)
            IfCondition EqualTo(DocFmt.c, 46) ThenBlock: {
                DocFmt.dot = 1
            }
            ElseBlock: {
                IfCondition And(GreaterEqual(DocFmt.c, 48), LessEqual(DocFmt.c, 57)) ThenBlock: {
                    IfCondition EqualTo(DocFmt.dot, 0) ThenBlock: {
                        DocFmt.whole = Add(Multiply(DocFmt.whole, 10), Subtract(DocFmt.c, 48))
                    }
                    ElseBlock: {
                        IfCondition LessThan(DocFmt.fdiv, 100) ThenBlock: {
                            DocFmt.frac = Add(Multiply(DocFmt.frac, 10), Subtract(DocFmt.c, 48))
                            DocFmt.fdiv = Multiply(DocFmt.fdiv, 10)
                        }
                    }
                }
            }
            DocFmt.i = Add(DocFmt.i, 1)
        }
        DocFmt.v = Multiply(DocFmt.whole, 100)
        IfCondition GreaterThan(DocFmt.fdiv, 1) ThenBlock: {
            DocFmt.v = Add(DocFmt.v, Divide(Multiply(DocFmt.frac, 100), DocFmt.fdiv))
        }
        DocFmt.pt = Divide(Multiply(DocFmt.v, 72), 2540)
        IfCondition LessThan(DocFmt.pt, 18) ThenBlock: {
            DocFmt.pt = 18
        }
        IfCondition GreaterThan(DocFmt.pt, 216) ThenBlock: {
            DocFmt.pt = 216
        }
        ReturnValue(DocFmt.pt)
    }
}

Function.DocFmt_ParsePt {
    Output: Integer
    Body: {
        DocFmt.v = 0
        DocFmt.i = 0
        WhileLoop LessThan(DocFmt.i, DocFmt.len) {
            DocFmt.c = GetByte(DocFmt.ptr, DocFmt.i)
            IfCondition And(GreaterEqual(DocFmt.c, 48), LessEqual(DocFmt.c, 57)) ThenBlock: {
                DocFmt.v = Add(Multiply(DocFmt.v, 10), Subtract(DocFmt.c, 48))
            }
            DocFmt.i = Add(DocFmt.i, 1)
        }
        IfCondition LessThan(DocFmt.v, 8) ThenBlock: {
            DocFmt.v = 8
        }
        IfCondition GreaterThan(DocFmt.v, 72) ThenBlock: {
            DocFmt.v = 72
        }
        ReturnValue(DocFmt.v)
    }
}

Function.DocFmt_Finish {
    Body: {
        IfCondition EqualTo(DocFmt.need, 1) ThenBlock: {
            DocLayout_Paginate(DocFmt.did)
        }
        sw = AK_Get(DocFmt.ctx, DocFmt.node, AKF.SOLVED_W)
        sh = AK_Get(DocFmt.ctx, DocFmt.node, AKF.SOLVED_H)
        DocView_EnsureCaretVisible(DocFmt.sidx, sw, sh)
        AK_Set(DocFmt.ctx, DocFmt.node, AKF.DIRTY, 1)
        dc = AK_GetDirtyCount(DocFmt.ctx)
        AK_SetDirtyCount(DocFmt.ctx, Add(dc, 1))
        AK_SetFocusNode(DocFmt.ctx, DocFmt.node)
    }
}

Function.DocFmt_Toggle {
    Input: field: Integer
    Body: {
        DocFmt.v = ADoc_Get(DocFmt.did, field)
        IfCondition EqualTo(DocFmt.v, 0) ThenBlock: {
            DocFmt.v = 1
        }
        ElseBlock: {
            DocFmt.v = 0
        }
        ADoc_Set(DocFmt.did, field, DocFmt.v)
        DocFmt.need = 0
        DocFmt_Finish()
    }
}

Function.DocFmt_SetAlign {
    Input: al: Integer
    Body: {
        ADoc_Set(DocFmt.did, ADocField.ALIGN, al)
        ADoc_MarkDirty(DocFmt.did)
        DocFmt.need = 1
        DocFmt_Finish()
    }
}

Function.DocFmt_SyncTableLabels {
    Body: {
        IfCondition LessThan(PlaceHud.sel_fi, 0) ThenBlock: {
            ReturnValue(0)
        }
        PlaceHud.oi = PlaceHud_Fr(PlaceHud.sel_fi)
        IfCondition EqualTo(PlaceHud.oi, 0) ThenBlock: {
            ReturnValue(0)
        }
        DocFmt_ShowLabel(ADocField.SIZE_PT, Dereference(Add(PlaceHud.oi, PHFrOff.SIZE)))
        DocFmt.v = Dereference(Add(PlaceHud.oi, PHFrOff.FACE))
        DocFmt.i = 0
        WhileLoop LessThan(DocFmt.i, FontCat_Count()) {
            DocFmt.c = FontCat_Ptr(DocFmt.i)
            IfCondition EqualTo(Dereference(Add(DocFmt.c, FontCatFields.FACE)), DocFmt.v) ThenBlock: {
                DocFmt.ptr = FontCat_Name(DocFmt.i)
                IfCondition NotEqual(DocFmt.ptr, 0) ThenBlock: {
                    DocFmt.len = StringLength(DocFmt.ptr)
                    DocFmt.c = AK_FindById(DocFmt.ctx, "font")
                    IfCondition GreaterEqual(DocFmt.c, 0) ThenBlock: {
                        AK_ExtraSet(DocFmt.ctx, DocFmt.c, AKExtra.STR_PTR, DocFmt.ptr)
                        AK_ExtraSet(DocFmt.ctx, DocFmt.c, AKExtra.STR_LEN, DocFmt.len)
                        AK_Set(DocFmt.ctx, DocFmt.c, AKF.DIRTY, 1)
                    }
                }
                DocFmt.i = FontCat_Count()
            }
            ElseBlock: {
                DocFmt.i = Add(DocFmt.i, 1)
            }
        }
    }
}

Function.DocFmt_Nudge {
    Input: field: Integer
    Input: step: Integer
    Input: lo: Integer
    Input: hi: Integer
    Body: {
        IfCondition And(EqualTo(field, ADocField.SIZE_PT), EqualTo(PlaceHud_SelKind(), PHConst.KIND_TABLE)) ThenBlock: {
            DocFmt.v = PlaceHud_NudgeSize(step)
            DocFmt.need = 0
            DocFmt_Finish()
            DocFmt_ShowLabel(ADocField.SIZE_PT, DocFmt.v)
            ReturnValue(1)
        }
        DocFmt.v = ADoc_Get(DocFmt.did, field)
        DocFmt.v = Add(DocFmt.v, step)
        IfCondition LessThan(DocFmt.v, lo) ThenBlock: {
            DocFmt.v = lo
        }
        IfCondition GreaterThan(DocFmt.v, hi) ThenBlock: {
            DocFmt.v = hi
        }
        ADoc_Set(DocFmt.did, field, DocFmt.v)
        IfCondition Or(EqualTo(field, ADocField.SIZE_PT), EqualTo(field, ADocField.TAB_SP)) ThenBlock: {
            DocLayout_Bind(DocFmt.did)
        }
        ADoc_MarkDirty(DocFmt.did)
        DocFmt.need = 1
        PrintMessage("[DocFmt] nudge field=")
        PrintNumber(field)
        PrintMessage(" pt=")
        PrintNumber(DocFmt.v)
        PrintMessage("\n")
        DocFmt_Finish()
        DocFmt_ShowLabel(field, DocFmt.v)
    }
}

Function.DocFmt_ShowLabel {
    Input: field: Integer
    Input: pt: Integer
    Body: {
        IfCondition EqualTo(DocFmt.lab, 0) ThenBlock: {
            DocFmt.lab = Allocate(48)
        }
        IfCondition EqualTo(DocFmt.lab, 0) ThenBlock: {
            ReturnValue(0)
        }
        DocFmt.i = 16
        IfCondition EqualTo(field, ADocField.ML) ThenBlock: { DocFmt.i = 8 }
        IfCondition EqualTo(field, ADocField.MR) ThenBlock: { DocFmt.i = 24 }
        IfCondition EqualTo(field, ADocField.MB) ThenBlock: { DocFmt.i = 32 }
        IfCondition EqualTo(field, ADocField.SIZE_PT) ThenBlock: { DocFmt.i = 0 }
        IfCondition EqualTo(field, ADocField.TAB_SP) ThenBlock: { DocFmt.i = 40 }
        p = Add(DocFmt.lab, DocFmt.i)
        IfCondition Or(EqualTo(field, ADocField.SIZE_PT), EqualTo(field, ADocField.TAB_SP)) ThenBlock: {
            IfCondition GreaterEqual(pt, 10) ThenBlock: {
                SetByte(p, 0, Add(48, Divide(pt, 10)))
                SetByte(p, 1, Add(48, Subtract(pt, Multiply(Divide(pt, 10), 10))))
                SetByte(p, 2, 0)
                DocFmt.len = 2
            }
            ElseBlock: {
                SetByte(p, 0, Add(48, pt))
                SetByte(p, 1, 0)
                DocFmt.len = 1
            }
        }
        ElseBlock: {
            DocFmt.v = Divide(Multiply(pt, 2540), 72)
            DocFmt.whole = Divide(DocFmt.v, 100)
            DocFmt.frac = Subtract(DocFmt.v, Multiply(DocFmt.whole, 100))
            IfCondition GreaterEqual(DocFmt.whole, 100) ThenBlock: {
                SetByte(p, 0, Add(48, Divide(DocFmt.whole, 100)))
                SetByte(p, 1, Add(48, Divide(Subtract(DocFmt.whole, Multiply(Divide(DocFmt.whole, 100), 100)), 10)))
                SetByte(p, 2, Add(48, Subtract(DocFmt.whole, Multiply(Divide(DocFmt.whole, 10), 10))))
                SetByte(p, 3, 46)
                SetByte(p, 4, Add(48, Divide(DocFmt.frac, 10)))
                SetByte(p, 5, Add(48, Subtract(DocFmt.frac, Multiply(Divide(DocFmt.frac, 10), 10))))
                SetByte(p, 6, 0)
                DocFmt.len = 6
            }
            ElseBlock: {
                IfCondition GreaterEqual(DocFmt.whole, 10) ThenBlock: {
                    SetByte(p, 0, Add(48, Divide(DocFmt.whole, 10)))
                    SetByte(p, 1, Add(48, Subtract(DocFmt.whole, Multiply(Divide(DocFmt.whole, 10), 10))))
                    SetByte(p, 2, 46)
                    SetByte(p, 3, Add(48, Divide(DocFmt.frac, 10)))
                    SetByte(p, 4, Add(48, Subtract(DocFmt.frac, Multiply(Divide(DocFmt.frac, 10), 10))))
                    SetByte(p, 5, 0)
                    DocFmt.len = 5
                }
                ElseBlock: {
                    SetByte(p, 0, Add(48, DocFmt.whole))
                    SetByte(p, 1, 46)
                    SetByte(p, 2, Add(48, Divide(DocFmt.frac, 10)))
                    SetByte(p, 3, Add(48, Subtract(DocFmt.frac, Multiply(Divide(DocFmt.frac, 10), 10))))
                    SetByte(p, 4, 0)
                    DocFmt.len = 4
                }
            }
        }
        idp = "mt"
        IfCondition EqualTo(field, ADocField.ML) ThenBlock: { idp = "ml" }
        IfCondition EqualTo(field, ADocField.MR) ThenBlock: { idp = "mr" }
        IfCondition EqualTo(field, ADocField.MB) ThenBlock: { idp = "mb" }
        IfCondition EqualTo(field, ADocField.SIZE_PT) ThenBlock: { idp = "sz" }
        IfCondition EqualTo(field, ADocField.TAB_SP) ThenBlock: { idp = "tab" }
        DocFmt.c = AK_FindById(DocFmt.ctx, idp)
        IfCondition GreaterEqual(DocFmt.c, 0) ThenBlock: {
            AK_ExtraSet(DocFmt.ctx, DocFmt.c, AKExtra.STR_PTR, Add(DocFmt.lab, DocFmt.i))
            AK_ExtraSet(DocFmt.ctx, DocFmt.c, AKExtra.STR_LEN, DocFmt.len)
            AK_Set(DocFmt.ctx, DocFmt.c, AKF.DIRTY, 1)
        }
    }
}

Function.DocFmt_ApplySize {
    Body: {
        DocFmt_ReadInput("sz")
        IfCondition LessEqual(DocFmt.len, 0) ThenBlock: {
            ReturnValue(0)
        }
        ADoc_Set(DocFmt.did, ADocField.SIZE_PT, DocFmt_ParsePt())
        DocLayout_Bind(DocFmt.did)
        ADoc_MarkDirty(DocFmt.did)
        DocFmt.need = 1
        DocFmt_Finish()
    }
}

Function.DocFmt_ApplyMargin {
    Body: {
        DocFmt_ReadInput("ml")
        DocFmt.pt = DocFmt_ParseInch()
        ADoc_Set(DocFmt.did, ADocField.ML, DocFmt.pt)
        DocFmt_ReadInput("mt")
        DocFmt.pt = DocFmt_ParseInch()
        ADoc_Set(DocFmt.did, ADocField.MT, DocFmt.pt)
        PrintMessage("[DocFmt] top margin pt=")
        PrintNumber(DocFmt.pt)
        PrintMessage("\n")
        DocFmt_ReadInput("mr")
        DocFmt.pt = DocFmt_ParseInch()
        ADoc_Set(DocFmt.did, ADocField.MR, DocFmt.pt)
        DocFmt_ReadInput("mb")
        DocFmt.pt = DocFmt_ParseInch()
        ADoc_Set(DocFmt.did, ADocField.MB, DocFmt.pt)
        ADoc_MarkDirty(DocFmt.did)
        DocFmt.need = 1
        DocFmt_Finish()
    }
}

Function.DocFmt_ApplyHeader {
    Body: {
        DocFmt_ReadInput("hdr")
        ADoc_SetBand(DocFmt.did, ADocField.HDR_PTR, ADocField.HDR_LEN, DocFmt.ptr, DocFmt.len)
        DocFmt.need = 0
        DocFmt_Finish()
        PrintMessage("[DocFmt] header len=")
        PrintNumber(ADoc_Get(DocFmt.did, ADocField.HDR_LEN))
        PrintMessage(" run=")
        PrintNumber(ADoc_Get(DocFmt.did, ADocField.RUN_LEN))
        PrintMessage("\n")
    }
}

Function.DocFmt_ApplyFooter {
    Body: {
        DocFmt_ReadInput("ftr")
        ADoc_SetBand(DocFmt.did, ADocField.FTR_PTR, ADocField.FTR_LEN, DocFmt.ptr, DocFmt.len)
        DocFmt.need = 0
        DocFmt_Finish()
    }
}

Function.DocFmt_ApplyDrops {
    Body: {
        DocFmt.v = 0
        IfCondition EqualTo(DocFmt.drop, 1) ThenBlock: {
            DocFmt.v = 1
        }
        DocFmt.c = AK_FindById(DocFmt.ctx, "drop_font")
        PrintMessage("[DocFmt] drop_font node=")
        PrintNumber(DocFmt.c)
        PrintMessage(" vis=")
        PrintNumber(DocFmt.v)
        PrintMessage("\n")
        IfCondition GreaterEqual(DocFmt.c, 0) ThenBlock: {
            AK_Set(DocFmt.ctx, DocFmt.c, AKF.VISIBLE, DocFmt.v)
            AK_Set(DocFmt.ctx, DocFmt.c, AKF.DIRTY, 1)
            DocFmt.i = AK_Get(DocFmt.ctx, DocFmt.c, AKF.PARENT)
            IfCondition GreaterEqual(DocFmt.i, 0) ThenBlock: {
                AK_Set(DocFmt.ctx, DocFmt.i, AKF.HEIGHT, 0)
                AK_Set(DocFmt.ctx, DocFmt.i, AKF.DIRTY, 1)
            }
        }
        DocFmt.v = 0
        IfCondition EqualTo(DocFmt.drop, 2) ThenBlock: {
            DocFmt.v = 1
        }
        DocFmt.c = AK_FindById(DocFmt.ctx, "drop_setup")
        PrintMessage("[DocFmt] drop_setup node=")
        PrintNumber(DocFmt.c)
        PrintMessage(" vis=")
        PrintNumber(DocFmt.v)
        PrintMessage("\n")
        IfCondition GreaterEqual(DocFmt.c, 0) ThenBlock: {
            AK_Set(DocFmt.ctx, DocFmt.c, AKF.VISIBLE, DocFmt.v)
            AK_Set(DocFmt.ctx, DocFmt.c, AKF.DIRTY, 1)
            DocFmt.i = AK_Get(DocFmt.ctx, DocFmt.c, AKF.PARENT)
            IfCondition GreaterEqual(DocFmt.i, 0) ThenBlock: {
                AK_Set(DocFmt.ctx, DocFmt.i, AKF.HEIGHT, 0)
                AK_Set(DocFmt.ctx, DocFmt.i, AKF.DIRTY, 1)
            }
        }
        DocFmt.v = AK_GetDirtyCount(DocFmt.ctx)
        AK_SetDirtyCount(DocFmt.ctx, Add(DocFmt.v, 1))
    }
}

Function.DocFmt_ToggleDrop {
    Input: which: Integer
    Body: {
        IfCondition EqualTo(DocFmt.drop, which) ThenBlock: {
            DocFmt.drop = 0
        }
        ElseBlock: {
            DocFmt.drop = which
        }
        DocFmt_ApplyDrops()
    }
}

Function.DocFmt_SyncTableBtn {
    Input: ctx: LinkagePool.AKContext
    Body: {
        DocFmt.c = AK_FindById(ctx, "btn_table")
        IfCondition LessThan(DocFmt.c, 0) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition And(EqualTo(PlaceHud.tool, PHTool.PLACE), EqualTo(PlaceHud.kind, PHConst.KIND_TABLE)) ThenBlock: {
            AK_ExtraSet(ctx, DocFmt.c, AKExtra.COLOR_BG, Theme.hud_accent)
            AK_ExtraSet(ctx, DocFmt.c, AKExtra.COLOR_FG, 0xFF0A1020)
        }
        ElseBlock: {
            AK_ExtraSet(ctx, DocFmt.c, AKExtra.COLOR_BG, 0xFF2A4068)
            AK_ExtraSet(ctx, DocFmt.c, AKExtra.COLOR_FG, 0xFFE8EEF8)
        }
        AK_Set(ctx, DocFmt.c, AKF.DIRTY, 1)
        DocFmt.v = AK_GetDirtyCount(ctx)
        AK_SetDirtyCount(ctx, Add(DocFmt.v, 1))
    }
}

