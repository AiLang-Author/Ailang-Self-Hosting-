// Library.Document.ailang
// Multi-page document management
// Owns a collection of PageSurface pages with consistent paper/orientation
// Copyright © 2026 Sean Collins, 2 Paws Machine and Engineering. SCSL.

LibraryImport.Arrays
LibraryImport.Display.Render.DSurfaceTypes
LibraryImport.Display.Render.DSurface
LibraryImport.Display.Render.DDrawPixel
LibraryImport.Display.Content.PageSurface
LibraryImport.Display.Render.Fonts
LibraryImport.Display.UI.TextRegion

// =============================================================================
// DOCUMENT STRUCTURE — 64 bytes per document
// =============================================================================
FixedPool.DocField {
    "PAPER_TYPE":  Initialize=0     // PaperType constant for new pages
    "ORIENTATION": Initialize=8     // PageOrient constant for new pages
    "DPI":         Initialize=16    // DPI for all pages
    "PAGE_LIST":   Initialize=24    // XArray of page indices (into PageTable)
    "PAGE_COUNT":  Initialize=32    // number of pages
    "CURSOR_PAGE": Initialize=40    // current page index for writing
    "CURSOR_Y":    Initialize=48    // current Y position on current page
    "FLAGS":       Initialize=56    // document flags
}

FixedPool.DocConst {
    "META_SIZE":  Initialize=64
    "MAX_DOCS":   Initialize=32
}

FixedPool.DocFlags {
    "DIRTY":     Initialize=1
    "AUTO_PAGE": Initialize=2    // auto-add pages on overflow
}

// =============================================================================
// DOCUMENT TABLE
// =============================================================================
FixedPool.DocTable {
    "data":  Initialize=0, CanChange=True
    "count": Initialize=0, CanChange=True
}

// =============================================================================
// INIT
// =============================================================================
Function.Doc_Init {
    Output: Integer
    Body: {
        dsz = Multiply(DocConst.MAX_DOCS, DocConst.META_SIZE)
        db = Allocate(dsz)
        IfCondition EqualTo(db, 0) ThenBlock: {
            PrintMessage("[Document] alloc fail\n")
            ReturnValue(0)
        }
        MemorySet(db, 0, dsz)
        DocTable.data = db
        DocTable.count = 0
        PrintMessage("[Document] init ok\n")
        ReturnValue(1)
    }
}

// =============================================================================
// DOCUMENT METADATA HELPERS
// =============================================================================
Function.Doc_Ptr {
    Input: idx: Integer
    Output: Address
    Body: {
        off = Multiply(idx, DocConst.META_SIZE)
        ReturnValue(Add(DocTable.data, off))
    }
}

Function.Doc_Get {
    Input: idx: Integer
    Input: field: Integer
    Output: Integer
    Body: {
        p = Doc_Ptr(idx)
        ReturnValue(Dereference(Add(p, field)))
    }
}

Function.Doc_Set {
    Input: idx: Integer
    Input: field: Integer
    Input: val: Integer
    Body: {
        p = Doc_Ptr(idx)
        StoreValue(Add(p, field), val)
    }
}

// =============================================================================
// CREATE — new document with paper type and orientation
// Returns document index, or -1 on failure
// =============================================================================
Function.Doc_Create {
    Input: paper_type: Integer
    Input: orientation: Integer
    Input: dpi: Integer
    Output: Integer
    Body: {
        idx = DocTable.count
        IfCondition GreaterEqual(idx, DocConst.MAX_DOCS) ThenBlock: {
            PrintMessage("[Document] doc table full\n")
            ReturnValue(-1)
        }

        IfCondition EqualTo(dpi, 0) ThenBlock: {
            dpi = PageConst.DEFAULT_DPI
        }

        // Create page list
        pages = Array.Create(16)

        DocTable.count = Add(idx, 1)
        Doc_Set(idx, DocField.PAPER_TYPE, paper_type)
        Doc_Set(idx, DocField.ORIENTATION, orientation)
        Doc_Set(idx, DocField.DPI, dpi)
        Doc_Set(idx, DocField.PAGE_LIST, pages)
        Doc_Set(idx, DocField.PAGE_COUNT, 0)
        Doc_Set(idx, DocField.CURSOR_PAGE, 0)
        Doc_Set(idx, DocField.CURSOR_Y, 0)
        Doc_Set(idx, DocField.FLAGS, DocFlags.AUTO_PAGE)

        // Create first page automatically
        first_page = Doc_AddPage(idx)
        IfCondition LessThan(first_page, 0) ThenBlock: {
            PrintMessage("[Document] failed to create first page\n")
            ReturnValue(-1)
        }

        PrintMessage("[Document] created doc ")
        PrintNumber(idx)
        PrintMessage("\n")
        ReturnValue(idx)
    }
}

// =============================================================================
// ADD PAGE — append a new page to the document
// Returns page index (in PageTable), or -1 on failure
// =============================================================================
Function.Doc_AddPage {
    Input: doc: Integer
    Output: Integer
    Body: {
        pt = Doc_Get(doc, DocField.PAPER_TYPE)
        orient = Doc_Get(doc, DocField.ORIENTATION)
        dpi = Doc_Get(doc, DocField.DPI)

        page = PageSurface_Create(pt, orient, dpi)
        IfCondition LessThan(page, 0) ThenBlock: {
            PrintMessage("[Document] page creation failed\n")
            ReturnValue(-1)
        }

        pages = Doc_Get(doc, DocField.PAGE_LIST)
        Array.Push(pages, page)

        pc = Doc_Get(doc, DocField.PAGE_COUNT)
        Doc_Set(doc, DocField.PAGE_COUNT, Add(pc, 1))

        PrintMessage("[Document] added page ")
        PrintNumber(pc)
        PrintMessage(" to doc ")
        PrintNumber(doc)
        PrintMessage("\n")

        ReturnValue(page)
    }
}

// =============================================================================
// GET PAGE — retrieve page index by document-local page number
// =============================================================================
Function.Doc_GetPage {
    Input: doc: Integer
    Input: page_num: Integer
    Output: Integer
    Body: {
        pc = Doc_Get(doc, DocField.PAGE_COUNT)
        IfCondition GreaterEqual(page_num, pc) ThenBlock: {
            ReturnValue(-1)
        }
        pages = Doc_Get(doc, DocField.PAGE_LIST)
        ReturnValue(Array.Get(pages, page_num))
    }
}

// =============================================================================
// GET PAGE COUNT
// =============================================================================
Function.Doc_GetPageCount {
    Input: doc: Integer
    Output: Integer
    Body: {
        ReturnValue(Doc_Get(doc, DocField.PAGE_COUNT))
    }
}

// =============================================================================
// GET CURRENT PAGE — the page the cursor is on
// =============================================================================
Function.Doc_GetCurrentPage {
    Input: doc: Integer
    Output: Integer
    Body: {
        cp = Doc_Get(doc, DocField.CURSOR_PAGE)
        ReturnValue(Doc_GetPage(doc, cp))
    }
}

// =============================================================================
// GET CURRENT SURFACE — surface handle for the cursor's page
// =============================================================================
Function.Doc_GetCurrentSurface {
    Input: doc: Integer
    Output: Integer
    Body: {
        page = Doc_GetCurrentPage(doc)
        IfCondition LessThan(page, 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(PageSurface_GetSurface(page))
    }
}

// =============================================================================
// CURSOR MANAGEMENT
// =============================================================================
Function.Doc_GetCursorY {
    Input: doc: Integer
    Output: Integer
    Body: {
        ReturnValue(Doc_Get(doc, DocField.CURSOR_Y))
    }
}

Function.Doc_SetCursorY {
    Input: doc: Integer
    Input: y: Integer
    Body: {
        Doc_Set(doc, DocField.CURSOR_Y, y)
    }
}

// =============================================================================
// CHECK PAGE BREAK — does current cursor Y exceed content area?
// If auto-page is on, creates new page and resets cursor
// Returns 1 if page break occurred, 0 if not
// =============================================================================
Function.Doc_CheckPageBreak {
    Input: doc: Integer
    Output: Integer
    Body: {
        cp_idx = Doc_Get(doc, DocField.CURSOR_PAGE)
        page = Doc_GetPage(doc, cp_idx)
        IfCondition LessThan(page, 0) ThenBlock: { ReturnValue(0) }

        content_h = PageSurface_GetContentH(page)
        content_y = PageSurface_GetContentY(page)
        max_y = Add(content_y, content_h)

        cursor_y = Doc_Get(doc, DocField.CURSOR_Y)
        IfCondition LessThan(cursor_y, max_y) ThenBlock: {
            ReturnValue(0)
        }

        // Cursor past bottom of content area — page break needed
        flags = Doc_Get(doc, DocField.FLAGS)
        has_auto = BitwiseAnd(flags, DocFlags.AUTO_PAGE)
        IfCondition EqualTo(has_auto, 0) ThenBlock: {
            // No auto-page — caller handles it
            ReturnValue(0)
        }

        // Create new page
        new_page = Doc_AddPage(doc)
        IfCondition LessThan(new_page, 0) ThenBlock: { ReturnValue(0) }

        // Advance cursor to new page
        new_cp = Add(cp_idx, 1)
        Doc_Set(doc, DocField.CURSOR_PAGE, new_cp)

        // Reset Y to top of content area on new page
        new_content_y = PageSurface_GetContentY(new_page)
        Doc_Set(doc, DocField.CURSOR_Y, new_content_y)

        PrintMessage("[Document] page break -> page ")
        PrintNumber(new_cp)
        PrintMessage("\n")

        ReturnValue(1)
    }
}

// =============================================================================
// WRITE TEXT — render text at cursor, advance cursor, handle page breaks
// Returns number of lines rendered
// =============================================================================
Function.Doc_WriteText {
    Input: doc: Integer
    Input: text: Address
    Input: text_len: Integer
    Input: color: Integer
    Output: Integer
    Body: {
        page = Doc_GetCurrentPage(doc)
        IfCondition LessThan(page, 0) ThenBlock: { ReturnValue(0) }

        surf = PageSurface_GetSurface(page)
        IfCondition EqualTo(surf, 0) ThenBlock: { ReturnValue(0) }

        cx = PageSurface_GetContentX(page)
        cw = PageSurface_GetContentW(page)
        cy = Doc_Get(doc, DocField.CURSOR_Y)

        // If cursor_y is 0, initialize to content top
        IfCondition EqualTo(cy, 0) ThenBlock: {
            cy = PageSurface_GetContentY(page)
            Doc_Set(doc, DocField.CURSOR_Y, cy)
        }

        // Measure text height for page break check
        line_h = VFont_GetLineHeight()

        // Check if we need a page break before writing
        Doc_CheckPageBreak(doc)

        // Re-read after possible page break
        page = Doc_GetCurrentPage(doc)
        surf = PageSurface_GetSurface(page)
        cx = PageSurface_GetContentX(page)
        cw = PageSurface_GetContentW(page)
        cy = Doc_Get(doc, DocField.CURSOR_Y)

        // Create TextRegion for this line — height is remaining space from
        // cursor to bottom content edge, not full content height
        ct = PageSurface_GetContentY(page)
        ch = PageSurface_GetContentH(page)
        ch = Subtract(Add(ct, ch), cy)
        IfCondition LessEqual(ch, 0) ThenBlock: { ReturnValue(0) }
        tr = TextRegion_Create(surf, cx, cy, cw, ch)
        TextRegion_SetColor(tr, color)
        TextRegion_SetWrap(tr, 1)
        TextRegion_Render(tr, text, text_len)

        // Advance cursor by rendered height
        rendered_h = TextRegion_MeasureHeight(tr, text, text_len)
        line_h = VFont_GetLineHeight()
        IfCondition LessThan(rendered_h, line_h) ThenBlock: {
            rendered_h = line_h
        }
        new_cy = Add(cy, rendered_h)
        Doc_Set(doc, DocField.CURSOR_Y, new_cy)

        ReturnValue(1)
    }
}

// =============================================================================
// DESTROY — free all pages and metadata
// =============================================================================
Function.Doc_Destroy {
    Input: doc: Integer
    Body: {
        pc = Doc_Get(doc, DocField.PAGE_COUNT)
        pages = Doc_Get(doc, DocField.PAGE_LIST)

        di = 0
        WhileLoop LessThan(di, pc) {
            page = Array.Get(pages, di)
            IfCondition GreaterEqual(page, 0) ThenBlock: {
                PageSurface_Destroy(page)
            }
            di = Add(di, 1)
        }

        Array.Destroy(pages)
        Doc_Set(doc, DocField.PAGE_LIST, 0)
        Doc_Set(doc, DocField.PAGE_COUNT, 0)
    }
}