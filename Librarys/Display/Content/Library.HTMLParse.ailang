// Library.HTMLParse.ailang
// Generic HTML-subset lexer, parser, and AST
// Produces a tag/attribute tree from markup — knows nothing about Auckland
// Copyright © 2026 Sean Collins, 2 Paws Machine and Engineering. SCSL.

LibraryImport.Arrays

// =============================================================================
// TOKEN TYPES
// =============================================================================
FixedPool.HTok {
    "TAG_OPEN":       Initialize=1    // <tagname
    "TAG_CLOSE":      Initialize=2    // </tagname>
    "TAG_SELF_CLOSE": Initialize=3    // />
    "ATTR_NAME":      Initialize=4    // attribute name
    "ATTR_VALUE":     Initialize=5    // "value"
    "TEXT":           Initialize=6    // text content between tags
    "TAG_END":        Initialize=7    // > (end of opening tag)
    "EOF":            Initialize=8
}

// =============================================================================
// AST NODE TYPES
// =============================================================================
FixedPool.HNode {
    "ELEMENT":  Initialize=1    // tag with attributes and children
    "TEXT":     Initialize=2    // text content node
    "ROOT":     Initialize=3    // document root (virtual)
}

// =============================================================================
// AST NODE STRUCTURE — 96 bytes per node
// =============================================================================
FixedPool.HField {
    "TYPE":          Initialize=0     // HNode type
    "TAG_PTR":       Initialize=8     // tag name string pointer
    "TAG_LEN":       Initialize=16    // tag name length
    "TEXT_PTR":      Initialize=24    // text content pointer (TEXT nodes)
    "TEXT_LEN":      Initialize=32    // text content length
    "PARENT":        Initialize=40    // parent node index
    "FIRST_CHILD":   Initialize=48    // first child index
    "NEXT_SIBLING":  Initialize=56    // next sibling index
    "CHILD_COUNT":   Initialize=64    // number of children
    "ATTR_LIST":     Initialize=72    // XArray of attribute pairs
    "LINE":          Initialize=80    // source line number
    "COL":           Initialize=88    // source column number
}

FixedPool.HNodeConst {
    "MAX_NODES":  Initialize=1024
    "ENTRY_SIZE": Initialize=96
}

// =============================================================================
// TOKEN STRUCTURE — 40 bytes per token
// =============================================================================
FixedPool.HTokField {
    "TYPE":   Initialize=0
    "PTR":    Initialize=8     // string pointer (tag name, attr name, attr value, text)
    "LEN":    Initialize=16    // string length
    "LINE":   Initialize=24    // source line
    "COL":    Initialize=32    // source column
}

FixedPool.HTokConst {
    "MAX_TOKENS":  Initialize=4096
    "ENTRY_SIZE":  Initialize=40
}

// =============================================================================
// ATTRIBUTE PAIR — 32 bytes
// =============================================================================
FixedPool.HAttrField {
    "NAME_PTR":  Initialize=0
    "NAME_LEN":  Initialize=8
    "VAL_PTR":   Initialize=16
    "VAL_LEN":   Initialize=24
}

FixedPool.HAttrConst {
    "ENTRY_SIZE": Initialize=32
    "MAX_ATTRS":  Initialize=2048
}

// =============================================================================
// LEXER STATE
// =============================================================================
FixedPool.HLex {
    "source":     Initialize=0, CanChange=True
    "source_len": Initialize=0, CanChange=True
    "pos":        Initialize=0, CanChange=True
    "line":       Initialize=1, CanChange=True
    "col":        Initialize=1, CanChange=True
    "error":      Initialize=0, CanChange=True
    "error_msg":  Initialize=0, CanChange=True
    "error_line": Initialize=0, CanChange=True
    "error_col":  Initialize=0, CanChange=True
}

// =============================================================================
// TOKEN TABLE
// =============================================================================
FixedPool.HTokTable {
    "data":  Initialize=0, CanChange=True
    "count": Initialize=0, CanChange=True
}

// =============================================================================
// AST TABLE
// =============================================================================
FixedPool.HAST {
    "data":  Initialize=0, CanChange=True
    "count": Initialize=0, CanChange=True
    "root":  Initialize=-1, CanChange=True
}

// =============================================================================
// ATTRIBUTE TABLE
// =============================================================================
FixedPool.HAttrTable {
    "data":  Initialize=0, CanChange=True
    "count": Initialize=0, CanChange=True
}

// =============================================================================
// STRING TABLE — interned strings for tag names, attr names, values
// =============================================================================
FixedPool.HStringTable {
    "buffer":   Initialize=0, CanChange=True
    "capacity": Initialize=65536
    "pos":      Initialize=0, CanChange=True
}

// =============================================================================
// PARSER STATE
// =============================================================================
FixedPool.HParse {
    "tok_pos":   Initialize=0, CanChange=True
    "tok_count": Initialize=0, CanChange=True
    "error":     Initialize=0, CanChange=True
    "error_msg": Initialize=0, CanChange=True
    "stack":     Initialize=0, CanChange=True   // parent stack (XStack)
}


// =============================================================================
// INIT — allocate all tables
// =============================================================================
Function.HTML_Init {
    Output: Integer
    Body: {
        // Token table
        tsz = Multiply(HTokConst.MAX_TOKENS, HTokConst.ENTRY_SIZE)
        tb = Allocate(tsz)
        IfCondition EqualTo(tb, 0) ThenBlock: {
            PrintMessage("[HTML] token alloc fail\n")
            ReturnValue(0)
        }
        ti = 0
        WhileLoop LessThan(ti, tsz) {
            SetByte(tb, ti, 0)
            ti = Add(ti, 1)
        }
        HTokTable.data = tb
        HTokTable.count = 0

        // AST node table
        nsz = Multiply(HNodeConst.MAX_NODES, HNodeConst.ENTRY_SIZE)
        nb = Allocate(nsz)
        IfCondition EqualTo(nb, 0) ThenBlock: {
            PrintMessage("[HTML] node alloc fail\n")
            ReturnValue(0)
        }
        ni = 0
        WhileLoop LessThan(ni, nsz) {
            SetByte(nb, ni, 0)
            ni = Add(ni, 1)
        }
        HAST.data = nb
        HAST.count = 0
        HAST.root = -1

        // Attribute table
        asz = Multiply(HAttrConst.MAX_ATTRS, HAttrConst.ENTRY_SIZE)
        ab = Allocate(asz)
        IfCondition EqualTo(ab, 0) ThenBlock: {
            PrintMessage("[HTML] attr alloc fail\n")
            ReturnValue(0)
        }
        ai = 0
        WhileLoop LessThan(ai, asz) {
            SetByte(ab, ai, 0)
            ai = Add(ai, 1)
        }
        HAttrTable.data = ab
        HAttrTable.count = 0

        // String table
        sb = Allocate(HStringTable.capacity)
        IfCondition EqualTo(sb, 0) ThenBlock: {
            PrintMessage("[HTML] string table alloc fail\n")
            ReturnValue(0)
        }
        HStringTable.buffer = sb
        HStringTable.pos = 0

        PrintMessage("[HTML] init ok\n")
        ReturnValue(1)
    }
}

// =============================================================================
// RESET — clear tables for reuse (keeps allocations)
// =============================================================================
Function.HTML_Reset {
    Body: {
        HTokTable.count = 0
        HAST.count = 0
        HAST.root = -1
        HAttrTable.count = 0
        HStringTable.pos = 0
        HLex.pos = 0
        HLex.line = 1
        HLex.col = 1
        HLex.error = 0
        HParse.tok_pos = 0
        HParse.error = 0
    }
}

// =============================================================================
// STRING TABLE — intern a string, returns pointer into table
// =============================================================================
Function.HTML_Intern {
    Input: src: Address
    Input: len: Integer
    Output: Address
    Body: {
        // len=0 is valid (empty string) — intern a single NUL byte
        needed = Add(HStringTable.pos, Add(len, 1))
        IfCondition GreaterEqual(needed, HStringTable.capacity) ThenBlock: {
            PrintMessage("[HTML] string table full\n")
            ReturnValue(0)
        }

        dest = Add(HStringTable.buffer, HStringTable.pos)
        ci = 0
        WhileLoop LessThan(ci, len) {
            ch = GetByte(src, ci)
            SetByte(dest, ci, ch)
            ci = Add(ci, 1)
        }
        SetByte(dest, len, 0)
        HStringTable.pos = Add(HStringTable.pos, Add(len, 1))
        ReturnValue(dest)
    }
}

// =============================================================================
// TOKEN TABLE HELPERS
// =============================================================================
Function.HTML_TokPtr {
    Input: idx: Integer
    Output: Address
    Body: {
        off = Multiply(idx, HTokConst.ENTRY_SIZE)
        ReturnValue(Add(HTokTable.data, off))
    }
}

Function.HTML_TokGet {
    Input: idx: Integer
    Input: field: Integer
    Output: Integer
    Body: {
        p = HTML_TokPtr(idx)
        ReturnValue(Dereference(Add(p, field)))
    }
}

Function.HTML_TokSet {
    Input: idx: Integer
    Input: field: Integer
    Input: val: Integer
    Body: {
        p = HTML_TokPtr(idx)
        StoreValue(Add(p, field), val)
    }
}

Function.HTML_AddToken {
    Input: ttype: Integer
    Input: ptr: Address
    Input: len: Integer
    Output: Integer
    Body: {
        idx = HTokTable.count
        IfCondition GreaterEqual(idx, HTokConst.MAX_TOKENS) ThenBlock: {
            PrintMessage("[HTML] token table full\n")
            ReturnValue(-1)
        }
        HTokTable.count = Add(idx, 1)
        HTML_TokSet(idx, HTokField.TYPE, ttype)
        HTML_TokSet(idx, HTokField.PTR, ptr)
        HTML_TokSet(idx, HTokField.LEN, len)
        HTML_TokSet(idx, HTokField.LINE, HLex.line)
        HTML_TokSet(idx, HTokField.COL, HLex.col)
        ReturnValue(idx)
    }
}

// =============================================================================
// AST NODE HELPERS
// =============================================================================
Function.HTML_NodePtr {
    Input: idx: Integer
    Output: Address
    Body: {
        off = Multiply(idx, HNodeConst.ENTRY_SIZE)
        ReturnValue(Add(HAST.data, off))
    }
}

Function.HTML_NodeGet {
    Input: idx: Integer
    Input: field: Integer
    Output: Integer
    Body: {
        p = HTML_NodePtr(idx)
        ReturnValue(Dereference(Add(p, field)))
    }
}

Function.HTML_NodeSet {
    Input: idx: Integer
    Input: field: Integer
    Input: val: Integer
    Body: {
        p = HTML_NodePtr(idx)
        StoreValue(Add(p, field), val)
    }
}

Function.HTML_CreateNode {
    Input: ntype: Integer
    Output: Integer
    Body: {
        idx = HAST.count
        IfCondition GreaterEqual(idx, HNodeConst.MAX_NODES) ThenBlock: {
            PrintMessage("[HTML] node table full\n")
            ReturnValue(-1)
        }
        HAST.count = Add(idx, 1)
        HTML_NodeSet(idx, HField.TYPE, ntype)
        HTML_NodeSet(idx, HField.TAG_PTR, 0)
        HTML_NodeSet(idx, HField.TAG_LEN, 0)
        HTML_NodeSet(idx, HField.TEXT_PTR, 0)
        HTML_NodeSet(idx, HField.TEXT_LEN, 0)
        HTML_NodeSet(idx, HField.PARENT, -1)
        HTML_NodeSet(idx, HField.FIRST_CHILD, -1)
        HTML_NodeSet(idx, HField.NEXT_SIBLING, -1)
        HTML_NodeSet(idx, HField.CHILD_COUNT, 0)
        HTML_NodeSet(idx, HField.ATTR_LIST, 0)
        HTML_NodeSet(idx, HField.LINE, HLex.line)
        HTML_NodeSet(idx, HField.COL, HLex.col)
        ReturnValue(idx)
    }
}

Function.HTML_AddChildNode {
    Input: parent: Integer
    Input: child: Integer
    Body: {
        HTML_NodeSet(child, HField.PARENT, parent)
        fc = HTML_NodeGet(parent, HField.FIRST_CHILD)

        IfCondition EqualTo(fc, -1) ThenBlock: {
            HTML_NodeSet(parent, HField.FIRST_CHILD, child)
        }
        IfCondition NotEqual(fc, -1) ThenBlock: {
            cur = fc
            ns = HTML_NodeGet(cur, HField.NEXT_SIBLING)
            WhileLoop NotEqual(ns, -1) {
                cur = ns
                ns = HTML_NodeGet(cur, HField.NEXT_SIBLING)
            }
            HTML_NodeSet(cur, HField.NEXT_SIBLING, child)
        }
        cc = HTML_NodeGet(parent, HField.CHILD_COUNT)
        HTML_NodeSet(parent, HField.CHILD_COUNT, Add(cc, 1))
    }
}

// =============================================================================
// ATTRIBUTE HELPERS
// =============================================================================
Function.HTML_AttrPtr {
    Input: idx: Integer
    Output: Address
    Body: {
        off = Multiply(idx, HAttrConst.ENTRY_SIZE)
        ReturnValue(Add(HAttrTable.data, off))
    }
}

// Attribute storage: ATTR_LIST = first_attr_index+1 (0 = no attrs)
// Attr count stored in TEXT_LEN field for ELEMENT nodes (unused on elements)
Function.HTML_AddAttr {
    Input: node: Integer
    Input: name_ptr: Address
    Input: name_len: Integer
    Input: val_ptr: Address
    Input: val_len: Integer
    Output: Integer
    Body: {
        idx = HAttrTable.count
        IfCondition GreaterEqual(idx, HAttrConst.MAX_ATTRS) ThenBlock: {
            PrintMessage("[HTML] attr table full\n")
            ReturnValue(-1)
        }
        HAttrTable.count = Add(idx, 1)
        ap = HTML_AttrPtr(idx)
        StoreValue(Add(ap, HAttrField.NAME_PTR), name_ptr)
        StoreValue(Add(ap, HAttrField.NAME_LEN), name_len)
        StoreValue(Add(ap, HAttrField.VAL_PTR), val_ptr)
        StoreValue(Add(ap, HAttrField.VAL_LEN), val_len)

        al = HTML_NodeGet(node, HField.ATTR_LIST)
        IfCondition EqualTo(al, 0) ThenBlock: {
            HTML_NodeSet(node, HField.ATTR_LIST, Add(idx, 1))
        }
        // Increment attr count stored in TEXT_LEN for element nodes
        ac = HTML_NodeGet(node, HField.TEXT_LEN)
        HTML_NodeSet(node, HField.TEXT_LEN, Add(ac, 1))
        ReturnValue(idx)
    }
}

// Get attribute count for a node — attrs are contiguous from first_attr
// Caller walks from first_attr to first_attr+count
Function.HTML_NodeAttrFirst {
    Input: node: Integer
    Output: Integer
    Body: {
        al = HTML_NodeGet(node, HField.ATTR_LIST)
        IfCondition EqualTo(al, 0) ThenBlock: { ReturnValue(-1) }
        ReturnValue(Subtract(al, 1))
    }
}

// Get number of attributes on a node
Function.HTML_NodeAttrCount {
    Input: node: Integer
    Output: Integer
    Body: {
        ntype = HTML_NodeGet(node, HField.TYPE)
        IfCondition NotEqual(ntype, HNode.ELEMENT) ThenBlock: { ReturnValue(0) }
        ReturnValue(HTML_NodeGet(node, HField.TEXT_LEN))
    }
}

Function.HTML_AttrGetName {
    Input: attr_idx: Integer
    Output: Address
    Body: {
        ap = HTML_AttrPtr(attr_idx)
        ReturnValue(Dereference(Add(ap, HAttrField.NAME_PTR)))
    }
}

Function.HTML_AttrGetNameLen {
    Input: attr_idx: Integer
    Output: Integer
    Body: {
        ap = HTML_AttrPtr(attr_idx)
        ReturnValue(Dereference(Add(ap, HAttrField.NAME_LEN)))
    }
}

Function.HTML_AttrGetVal {
    Input: attr_idx: Integer
    Output: Address
    Body: {
        ap = HTML_AttrPtr(attr_idx)
        ReturnValue(Dereference(Add(ap, HAttrField.VAL_PTR)))
    }
}

Function.HTML_AttrGetValLen {
    Input: attr_idx: Integer
    Output: Integer
    Body: {
        ap = HTML_AttrPtr(attr_idx)
        ReturnValue(Dereference(Add(ap, HAttrField.VAL_LEN)))
    }
}

// =============================================================================
// LEXER — CHARACTER HELPERS
// =============================================================================
Function.HTML_Peek {
    Output: Integer
    Body: {
        IfCondition GreaterEqual(HLex.pos, HLex.source_len) ThenBlock: {
            ReturnValue(0)
        }
        ReturnValue(GetByte(HLex.source, HLex.pos))
    }
}

Function.HTML_Advance {
    Output: Integer
    Body: {
        IfCondition GreaterEqual(HLex.pos, HLex.source_len) ThenBlock: {
            ReturnValue(0)
        }
        ch = GetByte(HLex.source, HLex.pos)
        HLex.pos = Add(HLex.pos, 1)
        IfCondition EqualTo(ch, 10) ThenBlock: {
            HLex.line = Add(HLex.line, 1)
            HLex.col = 1
        }
        IfCondition NotEqual(ch, 10) ThenBlock: {
            HLex.col = Add(HLex.col, 1)
        }
        ReturnValue(ch)
    }
}

Function.HTML_IsWhitespace {
    Input: ch: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(ch, 32) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(ch, 9) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(ch, 10) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(ch, 13) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

Function.HTML_IsNameChar {
    Input: ch: Integer
    Output: Integer
    Body: {
        // a-z
        IfCondition And(GreaterEqual(ch, 97), LessEqual(ch, 122)) ThenBlock: { ReturnValue(1) }
        // A-Z
        IfCondition And(GreaterEqual(ch, 65), LessEqual(ch, 90)) ThenBlock: { ReturnValue(1) }
        // 0-9
        IfCondition And(GreaterEqual(ch, 48), LessEqual(ch, 57)) ThenBlock: { ReturnValue(1) }
        // hyphen
        IfCondition EqualTo(ch, 45) ThenBlock: { ReturnValue(1) }
        // underscore
        IfCondition EqualTo(ch, 95) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

Function.HTML_SkipWhitespace {
    Body: {
        ws_ch = HTML_Peek()
        ws_is = HTML_IsWhitespace(ws_ch)
        WhileLoop EqualTo(ws_is, 1) {
            HTML_Advance()
            ws_ch = HTML_Peek()
            ws_is = HTML_IsWhitespace(ws_ch)
        }
    }
}

// =============================================================================
// LEXER — ERROR
// =============================================================================
Function.HTML_LexError {
    Input: msg: Address
    Body: {
        HLex.error = 1
        HLex.error_msg = msg
        HLex.error_line = HLex.line
        HLex.error_col = HLex.col
        PrintMessage("[HTML] LEX ERROR line ")
        PrintNumber(HLex.line)
        PrintMessage(" col ")
        PrintNumber(HLex.col)
        PrintMessage(": ")
        PrintMessage(msg)
        PrintMessage("\n")
    }
}

// =============================================================================
// LEXER — SCAN TAG NAME (after < or </)
// =============================================================================
Function.HTML_ScanName {
    Output: Integer
    Body: {
        start = HLex.pos
        nc = HTML_Peek()
        nc_ok = HTML_IsNameChar(nc)
        WhileLoop EqualTo(nc_ok, 1) {
            HTML_Advance()
            nc = HTML_Peek()
            nc_ok = HTML_IsNameChar(nc)
        }
        name_len = Subtract(HLex.pos, start)
        IfCondition EqualTo(name_len, 0) ThenBlock: {
            ReturnValue(0)
        }
        src_ptr = Add(HLex.source, start)
        interned = HTML_Intern(src_ptr, name_len)
        ReturnValue(interned)
    }
}

// =============================================================================
// LEXER — SCAN QUOTED STRING (after opening ")
// =============================================================================
Function.HTML_ScanQuoted {
    Output: Address
    Body: {
        // Opening quote already consumed
        start = HLex.pos
        qc = HTML_Peek()
        WhileLoop And(NotEqual(qc, 34), NotEqual(qc, 0)) {
            HTML_Advance()
            qc = HTML_Peek()
        }
        val_len = Subtract(HLex.pos, start)
        IfCondition EqualTo(qc, 0) ThenBlock: {
            HTML_LexError("Unterminated string")
            ReturnValue(0)
        }
        // Consume closing quote
        HTML_Advance()
        src_ptr = Add(HLex.source, start)
        interned = HTML_Intern(src_ptr, val_len)
        ReturnValue(interned)
    }
}

// =============================================================================
// LEXER — SKIP COMMENT <!-- ... -->
// =============================================================================
Function.HTML_SkipComment {
    Body: {
        // We've seen "<!-", consume the second "-"
        HTML_Advance()
        // Now scan for "-->"
        cmt_done = 0
        WhileLoop EqualTo(cmt_done, 0) {
            cmt_ch = HTML_Peek()
            IfCondition EqualTo(cmt_ch, 0) ThenBlock: {
                cmt_done = 1
            }
            IfCondition EqualTo(cmt_ch, 45) ThenBlock: {
                HTML_Advance()
                cmt_c2 = HTML_Peek()
                IfCondition EqualTo(cmt_c2, 45) ThenBlock: {
                    HTML_Advance()
                    cmt_c3 = HTML_Peek()
                    IfCondition EqualTo(cmt_c3, 62) ThenBlock: {
                        HTML_Advance()
                        cmt_done = 1
                    }
                }
            }
            IfCondition EqualTo(cmt_done, 0) ThenBlock: {
                HTML_Advance()
            }
        }
    }
}

// =============================================================================
// LEXER — MAIN TOKENIZE
// =============================================================================
Function.HTML_Tokenize {
    Input: source: Address
    Input: source_len: Integer
    Output: Integer
    Body: {
        HLex.source = source
        HLex.source_len = source_len
        HLex.pos = 0
        HLex.line = 1
        HLex.col = 1
        HLex.error = 0
        HTokTable.count = 0

        tok_ch = HTML_Peek()

        WhileLoop And(NotEqual(tok_ch, 0), EqualTo(HLex.error, 0)) {

            // ─── TAG START: < ───
            IfCondition EqualTo(tok_ch, 60) ThenBlock: {
                HTML_Advance()
                next_ch = HTML_Peek()

                // ─── CLOSE TAG: </ ───
                IfCondition EqualTo(next_ch, 47) ThenBlock: {
                    HTML_Advance()
                    cname = HTML_ScanName()
                    IfCondition EqualTo(cname, 0) ThenBlock: {
                        HTML_LexError("Expected tag name after </")
                    }
                    IfCondition NotEqual(cname, 0) ThenBlock: {
                        cname_len = StringLength(cname)
                        HTML_AddToken(HTok.TAG_CLOSE, cname, cname_len)
                        HTML_SkipWhitespace()
                        gt_ch = HTML_Peek()
                        IfCondition NotEqual(gt_ch, 62) ThenBlock: {
                            HTML_LexError("Expected > after close tag name")
                        }
                        IfCondition EqualTo(gt_ch, 62) ThenBlock: {
                            HTML_Advance()
                        }
                    }
                }

                // ─── COMMENT: <!-- ───
                IfCondition EqualTo(next_ch, 33) ThenBlock: {
                    HTML_Advance()
                    d1 = HTML_Peek()
                    IfCondition EqualTo(d1, 45) ThenBlock: {
                        HTML_Advance()
                        d2 = HTML_Peek()
                        IfCondition EqualTo(d2, 45) ThenBlock: {
                            HTML_SkipComment()
                        }
                    }
                }

                // ─── OPEN TAG: <tagname ───
                is_close = EqualTo(next_ch, 47)
                is_bang = EqualTo(next_ch, 33)
                is_tag = Not(Or(is_close, is_bang))
                IfCondition EqualTo(is_tag, 1) ThenBlock: {
                    oname = HTML_ScanName()
                    IfCondition EqualTo(oname, 0) ThenBlock: {
                        HTML_LexError("Expected tag name after <")
                    }
                    IfCondition NotEqual(oname, 0) ThenBlock: {
                        oname_len = StringLength(oname)
                        HTML_AddToken(HTok.TAG_OPEN, oname, oname_len)

                        // ─── ATTRIBUTES ───
                        HTML_SkipWhitespace()
                        attr_ch = HTML_Peek()
                        attr_done = 0

                        WhileLoop EqualTo(attr_done, 0) {
                            // Check for end of tag
                            IfCondition EqualTo(attr_ch, 62) ThenBlock: {
                                attr_done = 1
                            }
                            IfCondition EqualTo(attr_ch, 47) ThenBlock: {
                                attr_done = 1
                            }
                            IfCondition EqualTo(attr_ch, 0) ThenBlock: {
                                attr_done = 1
                            }

                            IfCondition EqualTo(attr_done, 0) ThenBlock: {
                                // Scan attribute name
                                aname = HTML_ScanName()
                                IfCondition EqualTo(aname, 0) ThenBlock: {
                                    HTML_LexError("Expected attribute name")
                                    attr_done = 1
                                }
                                IfCondition NotEqual(aname, 0) ThenBlock: {
                                    aname_len = StringLength(aname)
                                    HTML_AddToken(HTok.ATTR_NAME, aname, aname_len)

                                    // Expect =
                                    HTML_SkipWhitespace()
                                    eq_ch = HTML_Peek()
                                    IfCondition NotEqual(eq_ch, 61) ThenBlock: {
                                        HTML_LexError("Expected = after attribute name")
                                        attr_done = 1
                                    }
                                    IfCondition EqualTo(eq_ch, 61) ThenBlock: {
                                        HTML_Advance()
                                        HTML_SkipWhitespace()
                                        // Expect opening quote
                                        q_ch = HTML_Peek()
                                        IfCondition NotEqual(q_ch, 34) ThenBlock: {
                                            HTML_LexError("Expected \" for attribute value")
                                            attr_done = 1
                                        }
                                        IfCondition EqualTo(q_ch, 34) ThenBlock: {
                                            HTML_Advance()
                                            aval = HTML_ScanQuoted()
                                            IfCondition NotEqual(aval, 0) ThenBlock: {
                                                aval_len = StringLength(aval)
                                                HTML_AddToken(HTok.ATTR_VALUE, aval, aval_len)
                                            }
                                        }
                                    }
                                }

                                HTML_SkipWhitespace()
                                attr_ch = HTML_Peek()
                            }
                        }

                        // End of tag: > or />
                        end_ch = HTML_Peek()
                        IfCondition EqualTo(end_ch, 47) ThenBlock: {
                            HTML_Advance()
                            gt2 = HTML_Peek()
                            IfCondition EqualTo(gt2, 62) ThenBlock: {
                                HTML_Advance()
                                HTML_AddToken(HTok.TAG_SELF_CLOSE, 0, 0)
                            }
                            IfCondition NotEqual(gt2, 62) ThenBlock: {
                                HTML_LexError("Expected > after /")
                            }
                        }
                        IfCondition EqualTo(end_ch, 62) ThenBlock: {
                            HTML_Advance()
                            HTML_AddToken(HTok.TAG_END, 0, 0)
                        }
                    }
                }
            }

            // ─── TEXT CONTENT ───
            IfCondition NotEqual(tok_ch, 60) ThenBlock: {
                txt_start = HLex.pos
                txt_ch = tok_ch
                WhileLoop And(NotEqual(txt_ch, 60), NotEqual(txt_ch, 0)) {
                    HTML_Advance()
                    txt_ch = HTML_Peek()
                }
                txt_len = Subtract(HLex.pos, txt_start)

                // Skip whitespace-only text nodes
                txt_all_ws = 1
                twi = 0
                WhileLoop LessThan(twi, txt_len) {
                    twc = GetByte(HLex.source, Add(txt_start, twi))
                    tw_is = HTML_IsWhitespace(twc)
                    IfCondition EqualTo(tw_is, 0) ThenBlock: {
                        txt_all_ws = 0
                    }
                    twi = Add(twi, 1)
                }

                IfCondition EqualTo(txt_all_ws, 0) ThenBlock: {
                    txt_src = Add(HLex.source, txt_start)
                    txt_interned = HTML_Intern(txt_src, txt_len)
                    HTML_AddToken(HTok.TEXT, txt_interned, txt_len)
                }
            }

            tok_ch = HTML_Peek()
        }

        // Add EOF token
        HTML_AddToken(HTok.EOF, 0, 0)

        PrintMessage("[HTML] lexed ")
        PrintNumber(HTokTable.count)
        PrintMessage(" tokens\n")

        IfCondition EqualTo(HLex.error, 1) ThenBlock: {
            ReturnValue(0)
        }
        ReturnValue(1)
    }
}


// =============================================================================
// PARSER — HELPERS
// =============================================================================
Function.HTML_CurTokType {
    Output: Integer
    Body: {
        IfCondition GreaterEqual(HParse.tok_pos, HTokTable.count) ThenBlock: {
            ReturnValue(HTok.EOF)
        }
        ReturnValue(HTML_TokGet(HParse.tok_pos, HTokField.TYPE))
    }
}

Function.HTML_CurTokPtr {
    Output: Address
    Body: {
        ReturnValue(HTML_TokGet(HParse.tok_pos, HTokField.PTR))
    }
}

Function.HTML_CurTokLen {
    Output: Integer
    Body: {
        ReturnValue(HTML_TokGet(HParse.tok_pos, HTokField.LEN))
    }
}

Function.HTML_AdvanceTok {
    Body: {
        HParse.tok_pos = Add(HParse.tok_pos, 1)
    }
}

Function.HTML_ParseError {
    Input: msg: Address
    Body: {
        HParse.error = 1
        HParse.error_msg = msg
        tline = HTML_TokGet(HParse.tok_pos, HTokField.LINE)
        tcol = HTML_TokGet(HParse.tok_pos, HTokField.COL)
        PrintMessage("[HTML] PARSE ERROR line ")
        PrintNumber(tline)
        PrintMessage(" col ")
        PrintNumber(tcol)
        PrintMessage(": ")
        PrintMessage(msg)
        PrintMessage("\n")
    }
}

// =============================================================================
// PARSER — BUILD AST FROM TOKEN STREAM
// =============================================================================
Function.HTML_Parse {
    Output: Integer
    Body: {
        HParse.tok_pos = 0
        HParse.tok_count = HTokTable.count
        HParse.error = 0

        // Create parent stack
        HParse.stack = Stack.Create(64)

        // Create root node
        root = HTML_CreateNode(HNode.ROOT)
        HAST.root = root
        Stack.Push(HParse.stack, root)

        ptt = HTML_CurTokType()

        WhileLoop And(NotEqual(ptt, HTok.EOF), EqualTo(HParse.error, 0)) {

            // ─── TAG OPEN ───
            IfCondition EqualTo(ptt, HTok.TAG_OPEN) ThenBlock: {
                tag_name = HTML_CurTokPtr()
                tag_len = HTML_CurTokLen()
                HTML_AdvanceTok()

                elem = HTML_CreateNode(HNode.ELEMENT)
                HTML_NodeSet(elem, HField.TAG_PTR, tag_name)
                HTML_NodeSet(elem, HField.TAG_LEN, tag_len)

                // Collect attributes
                att = HTML_CurTokType()
                WhileLoop EqualTo(att, HTok.ATTR_NAME) {
                    an_ptr = HTML_CurTokPtr()
                    an_len = HTML_CurTokLen()
                    HTML_AdvanceTok()

                    // Expect ATTR_VALUE
                    avt = HTML_CurTokType()
                    IfCondition NotEqual(avt, HTok.ATTR_VALUE) ThenBlock: {
                        HTML_ParseError("Expected attribute value")
                    }
                    IfCondition EqualTo(avt, HTok.ATTR_VALUE) ThenBlock: {
                        av_ptr = HTML_CurTokPtr()
                        av_len = HTML_CurTokLen()
                        HTML_AdvanceTok()
                        HTML_AddAttr(elem, an_ptr, an_len, av_ptr, av_len)
                    }

                    att = HTML_CurTokType()
                }

                // Check for self-close or tag-end
                end_tt = HTML_CurTokType()
                IfCondition EqualTo(end_tt, HTok.TAG_SELF_CLOSE) ThenBlock: {
                    HTML_AdvanceTok()
                    // Add to current parent, don't push
                    parent_idx = Stack.Peek(HParse.stack)
                    HTML_AddChildNode(parent_idx, elem)
                }
                IfCondition EqualTo(end_tt, HTok.TAG_END) ThenBlock: {
                    HTML_AdvanceTok()
                    // Add to current parent, push as new parent
                    parent_idx2 = Stack.Peek(HParse.stack)
                    HTML_AddChildNode(parent_idx2, elem)
                    Stack.Push(HParse.stack, elem)
                }
            }

            // ─── TAG CLOSE ───
            IfCondition EqualTo(ptt, HTok.TAG_CLOSE) ThenBlock: {
                close_name = HTML_CurTokPtr()
                HTML_AdvanceTok()

                // Pop stack — verify tag name matches
                top = Stack.Peek(HParse.stack)
                IfCondition EqualTo(top, root) ThenBlock: {
                    HTML_ParseError("Unexpected close tag — no matching open tag")
                }
                IfCondition NotEqual(top, root) ThenBlock: {
                    top_name = HTML_NodeGet(top, HField.TAG_PTR)
                    match = StringCompare(top_name, close_name)
                    IfCondition NotEqual(match, 0) ThenBlock: {
                        PrintMessage("[HTML] PARSE ERROR: close tag mismatch, expected ")
                        PrintMessage(top_name)
                        PrintMessage(" got ")
                        PrintMessage(close_name)
                        PrintMessage("\n")
                        HParse.error = 1
                    }
                    IfCondition EqualTo(match, 0) ThenBlock: {
                        Stack.Pop(HParse.stack)
                    }
                }
            }

            // ─── TEXT NODE ───
            IfCondition EqualTo(ptt, HTok.TEXT) ThenBlock: {
                txt_ptr = HTML_CurTokPtr()
                txt_len = HTML_CurTokLen()
                HTML_AdvanceTok()

                tnode = HTML_CreateNode(HNode.TEXT)
                HTML_NodeSet(tnode, HField.TEXT_PTR, txt_ptr)
                HTML_NodeSet(tnode, HField.TEXT_LEN, txt_len)
                txt_parent = Stack.Peek(HParse.stack)
                HTML_AddChildNode(txt_parent, tnode)
            }

            // ─── SKIP UNEXPECTED ───
            skip_is_open = EqualTo(ptt, HTok.TAG_OPEN)
            skip_is_close = EqualTo(ptt, HTok.TAG_CLOSE)
            skip_is_text = EqualTo(ptt, HTok.TEXT)
            skip_known = Or(skip_is_open, Or(skip_is_close, skip_is_text))
            IfCondition EqualTo(skip_known, 0) ThenBlock: {
                HTML_AdvanceTok()
            }

            ptt = HTML_CurTokType()
        }

        // Verify stack is empty (only root remains)
        stk_size = Array.Size(HParse.stack)
        IfCondition GreaterThan(stk_size, 1) ThenBlock: {
            PrintMessage("[HTML] PARSE ERROR: unclosed tags remain\n")
            HParse.error = 1
        }

        Array.Destroy(HParse.stack)

        PrintMessage("[HTML] parsed ")
        PrintNumber(HAST.count)
        PrintMessage(" nodes\n")

        IfCondition EqualTo(HParse.error, 1) ThenBlock: {
            ReturnValue(-1)
        }
        ReturnValue(root)
    }
}

// =============================================================================
// PUBLIC API — PARSE FILE
// =============================================================================
Function.HTML_ParseFile {
    Input: filename: Address
    Output: Integer
    Body: {
        // Open file
        fd = SystemCall(2, filename, 0, 0)
        IfCondition LessThan(fd, 0) ThenBlock: {
            PrintMessage("[HTML] cannot open: ")
            PrintMessage(filename)
            PrintMessage("\n")
            ReturnValue(-1)
        }

        // Get file size
        fsize = SystemCall(8, fd, 0, 2)
        SystemCall(8, fd, 0, 0)

        IfCondition LessEqual(fsize, 0) ThenBlock: {
            SystemCall(3, fd)
            PrintMessage("[HTML] empty file: ")
            PrintMessage(filename)
            PrintMessage("\n")
            ReturnValue(-1)
        }

        // Allocate and read
        alloc_sz = Add(fsize, 1)
        fbuf = Allocate(alloc_sz)
        bytes_read = SystemCall(0, fd, fbuf, fsize)
        SystemCall(3, fd)
        SetByte(fbuf, bytes_read, 0)

        // Tokenize
        lex_ok = HTML_Tokenize(fbuf, bytes_read)
        IfCondition EqualTo(lex_ok, 0) ThenBlock: {
            Deallocate(fbuf, alloc_sz)
            ReturnValue(-1)
        }

        // Parse
        result = HTML_Parse()

        Deallocate(fbuf, alloc_sz)
        ReturnValue(result)
    }
}

// =============================================================================
// PUBLIC API — PARSE STRING
// =============================================================================
Function.HTML_ParseString {
    Input: source: Address
    Input: source_len: Integer
    Output: Integer
    Body: {
        lex_ok = HTML_Tokenize(source, source_len)
        IfCondition EqualTo(lex_ok, 0) ThenBlock: {
            ReturnValue(-1)
        }
        ReturnValue(HTML_Parse())
    }
}

// =============================================================================
// QUERY HELPERS — for consumers walking the AST
// =============================================================================

// Find an attribute value by name on a node
Function.HTML_GetAttr {
    Input: node: Integer
    Input: attr_name: Address
    Output: Address
    Body: {
        first = HTML_NodeAttrFirst(node)
        IfCondition LessThan(first, 0) ThenBlock: { ReturnValue(0) }

        count = HTML_NodeAttrCount(node)
        IfCondition EqualTo(count, 0) ThenBlock: { ReturnValue(0) }

        ga_i = first
        ga_end = Add(first, count)
        WhileLoop LessThan(ga_i, ga_end) {
            ga_name = HTML_AttrGetName(ga_i)
            IfCondition NotEqual(ga_name, 0) ThenBlock: {
                cmp = StringCompare(ga_name, attr_name)
                IfCondition EqualTo(cmp, 0) ThenBlock: {
                    ReturnValue(HTML_AttrGetVal(ga_i))
                }
            }
            ga_i = Add(ga_i, 1)
        }
        ReturnValue(0)
    }
}

// Get tag name string of an element node
Function.HTML_GetTagName {
    Input: node: Integer
    Output: Address
    Body: {
        ReturnValue(HTML_NodeGet(node, HField.TAG_PTR))
    }
}

// Get first child
Function.HTML_GetFirstChild {
    Input: node: Integer
    Output: Integer
    Body: {
        ReturnValue(HTML_NodeGet(node, HField.FIRST_CHILD))
    }
}

// Get next sibling
Function.HTML_GetNextSibling {
    Input: node: Integer
    Output: Integer
    Body: {
        ReturnValue(HTML_NodeGet(node, HField.NEXT_SIBLING))
    }
}

// Get node type
Function.HTML_GetNodeType {
    Input: node: Integer
    Output: Integer
    Body: {
        ReturnValue(HTML_NodeGet(node, HField.TYPE))
    }
}

// Get child count
Function.HTML_GetChildCount {
    Input: node: Integer
    Output: Integer
    Body: {
        ReturnValue(HTML_NodeGet(node, HField.CHILD_COUNT))
    }
}

// =============================================================================
// DEBUG — DUMP AST
// =============================================================================
Function.HTML_DumpNode {
    Input: node: Integer
    Input: depth: Integer
    Body: {
        IfCondition LessThan(node, 0) ThenBlock: { ReturnValue(0) }

        // Indent
        di = 0
        WhileLoop LessThan(di, depth) {
            PrintMessage("  ")
            di = Add(di, 1)
        }

        ntype = HTML_NodeGet(node, HField.TYPE)

        IfCondition EqualTo(ntype, HNode.ROOT) ThenBlock: {
            PrintMessage("[ROOT]\n")
        }
        IfCondition EqualTo(ntype, HNode.TEXT) ThenBlock: {
            tp = HTML_NodeGet(node, HField.TEXT_PTR)
            PrintMessage("[TEXT] \"")
            IfCondition NotEqual(tp, 0) ThenBlock: { PrintMessage(tp) }
            PrintMessage("\"\n")
        }
        IfCondition EqualTo(ntype, HNode.ELEMENT) ThenBlock: {
            tname = HTML_NodeGet(node, HField.TAG_PTR)
            PrintMessage("<")
            IfCondition NotEqual(tname, 0) ThenBlock: { PrintMessage(tname) }
            PrintMessage(">")

            // Print attrs
            afirst = HTML_NodeAttrFirst(node)
            acount = HTML_NodeAttrCount(node)
            IfCondition GreaterThan(acount, 0) ThenBlock: {
                da_i = afirst
                da_end = Add(afirst, acount)
                WhileLoop LessThan(da_i, da_end) {
                    da_n = HTML_AttrGetName(da_i)
                    IfCondition NotEqual(da_n, 0) ThenBlock: {
                        PrintMessage(" ")
                        PrintMessage(da_n)
                        PrintMessage("=\"")
                        da_v = HTML_AttrGetVal(da_i)
                        IfCondition NotEqual(da_v, 0) ThenBlock: { PrintMessage(da_v) }
                        PrintMessage("\"")
                    }
                    da_i = Add(da_i, 1)
                }
            }

            PrintMessage("\n")
        }

        // Recurse children
        dchild = HTML_NodeGet(node, HField.FIRST_CHILD)
        child_depth = Add(depth, 1)
        WhileLoop NotEqual(dchild, -1) {
            HTML_DumpNode(dchild, child_depth)
            dchild = HTML_NodeGet(dchild, HField.NEXT_SIBLING)
        }
    }
}

Function.HTML_Dump {
    Body: {
        PrintMessage("\n--- HTML AST ---\n")
        IfCondition GreaterEqual(HAST.root, 0) ThenBlock: {
            HTML_DumpNode(HAST.root, 0)
        }
        PrintMessage("--- END AST ---\n\n")
    }
}