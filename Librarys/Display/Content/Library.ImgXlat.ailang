// Library.ImgXlat.ailang
// Still-image translators. Identify + Translate to canonical BGRA.
// JPEG/PNG are the first two; Wuffs-style packages plug in later as
// additional Identify/Translate pairs. No clock. No MediaCenter.
// Scaling to a PlaceHUD box is the blit, not the decoder.
// Copyright © 2026 Sean Collins, 2 Paws Machine and Engineering. SCSL.

LibraryImport.Display.Render.DSurface
LibraryImport.Display.Render.DSurfaceTypes
LibraryImport.Browser.ImageDecode
LibraryImport.Browser.JPEGDecode

FixedPool.XlatKind {
    "NONE": Initialize=0
    "JPEG": Initialize=1
    "PNG":  Initialize=2
}

FixedPool.ImgXlat {
    "data": Initialize=0, CanChange=True
    "len":  Initialize=0, CanChange=True
    "kind": Initialize=0, CanChange=True
    "h":    Initialize=-1, CanChange=True
}

FixedPool.ImgBlit {
    "surf":  Initialize=0, CanChange=True
    "dx":    Initialize=0, CanChange=True
    "dy":    Initialize=0, CanChange=True
    "dw":    Initialize=0, CanChange=True
    "dh":    Initialize=0, CanChange=True
    "cx0":   Initialize=0, CanChange=True
    "cy0":   Initialize=0, CanChange=True
    "cx1":   Initialize=0, CanChange=True
    "cy1":   Initialize=0, CanChange=True
    "sw":    Initialize=0, CanChange=True
    "sh":    Initialize=0, CanChange=True
    "pix":   Initialize=0, CanChange=True
    "pitch": Initialize=0, CanChange=True
    "x":     Initialize=0, CanChange=True
    "y":     Initialize=0, CanChange=True
    "sx":    Initialize=0, CanChange=True
    "sy":    Initialize=0, CanChange=True
    "spitch": Initialize=0, CanChange=True
    "sdata": Initialize=0, CanChange=True
    "color": Initialize=0, CanChange=True
}

Function.ImgXlat_NameIsImage {
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(name, 0) ThenBlock: {
            ReturnValue(0)
        }
        ImgXlat.len = StringLength(name)
        IfCondition LessThan(ImgXlat.len, 4) ThenBlock: {
            ReturnValue(0)
        }
        ImgXlat.kind = GetByte(name, Subtract(ImgXlat.len, 4))
        IfCondition EqualTo(ImgXlat.kind, 46) ThenBlock: {
            ImgXlat.h = GetByte(name, Subtract(ImgXlat.len, 3))
            IfCondition Or(EqualTo(ImgXlat.h, 112), EqualTo(ImgXlat.h, 80)) ThenBlock: {
                ReturnValue(1)
            }
            IfCondition Or(EqualTo(ImgXlat.h, 106), EqualTo(ImgXlat.h, 74)) ThenBlock: {
                ReturnValue(1)
            }
        }
        IfCondition GreaterEqual(ImgXlat.len, 5) ThenBlock: {
            IfCondition EqualTo(GetByte(name, Subtract(ImgXlat.len, 5)), 46) ThenBlock: {
                ImgXlat.h = GetByte(name, Subtract(ImgXlat.len, 4))
                IfCondition Or(EqualTo(ImgXlat.h, 106), EqualTo(ImgXlat.h, 74)) ThenBlock: {
                    ReturnValue(1)
                }
            }
        }
        ReturnValue(0)
    }
}

Function.ImgXlat_Identify {
    Input: data: Address
    Input: len: Integer
    Output: Integer
    Body: {
        IfCondition Or(EqualTo(data, 0), LessThan(len, 4)) ThenBlock: {
            ReturnValue(XlatKind.NONE)
        }
        IfCondition And(EqualTo(GetByte(data, 0), 255), EqualTo(GetByte(data, 1), 216)) ThenBlock: {
            ReturnValue(XlatKind.JPEG)
        }
        IfCondition And(And(EqualTo(GetByte(data, 0), 137), EqualTo(GetByte(data, 1), 80)), And(EqualTo(GetByte(data, 2), 78), EqualTo(GetByte(data, 3), 71))) ThenBlock: {
            ReturnValue(XlatKind.PNG)
        }
        ReturnValue(XlatKind.NONE)
    }
}

Function.ImgXlat_Translate {
    Input: data: Address
    Input: len: Integer
    Output: Integer
    Body: {
        ImgXlat.data = data
        ImgXlat.len = len
        ImgXlat.kind = ImgXlat_Identify(ImgXlat.data, ImgXlat.len)
        ImgXlat.h = -1
        IfCondition EqualTo(ImgXlat.kind, XlatKind.JPEG) ThenBlock: {
            ImgXlat.h = IMG_DecodeJPEG(ImgXlat.data, ImgXlat.len)
        }
        IfCondition EqualTo(ImgXlat.kind, XlatKind.PNG) ThenBlock: {
            ImgXlat.h = IMG_DecodePNG(ImgXlat.data, ImgXlat.len)
        }
        PrintMessage("[Xlat] kind=")
        PrintNumber(ImgXlat.kind)
        PrintMessage(" handle=")
        PrintNumber(ImgXlat.h)
        PrintMessage("\n")
        ReturnValue(ImgXlat.h)
    }
}

Function.ImgXlat_Blit {
    Input: handle: Integer
    Body: {
        IfCondition LessThan(handle, 0) ThenBlock: {
            ReturnValue(0)
        }
        ImgBlit.pix = IMG_GetPixels(handle)
        ImgBlit.sw = IMG_GetWidth(handle)
        ImgBlit.sh = IMG_GetHeight(handle)
        IfCondition Or(EqualTo(ImgBlit.pix, 0), Or(LessEqual(ImgBlit.sw, 0), LessEqual(ImgBlit.sh, 0))) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition Or(LessEqual(ImgBlit.dw, 0), LessEqual(ImgBlit.dh, 0)) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition NotEqual(ImgBlit.surf, 0) ThenBlock: {
            ImgBlit.sdata = Surface_GetData(ImgBlit.surf)
            ImgBlit.spitch = Surface_GetPitch(ImgBlit.surf)
        }
        IfCondition EqualTo(ImgBlit.sdata, 0) ThenBlock: {
            ReturnValue(0)
        }
        ImgBlit.pitch = Multiply(ImgBlit.sw, 4)
        IfCondition LessThan(ImgBlit.cx0, ImgBlit.dx) ThenBlock: {
            ImgBlit.cx0 = ImgBlit.dx
        }
        IfCondition LessThan(ImgBlit.cy0, ImgBlit.dy) ThenBlock: {
            ImgBlit.cy0 = ImgBlit.dy
        }
        IfCondition GreaterThan(ImgBlit.cx1, Add(ImgBlit.dx, ImgBlit.dw)) ThenBlock: {
            ImgBlit.cx1 = Add(ImgBlit.dx, ImgBlit.dw)
        }
        IfCondition GreaterThan(ImgBlit.cy1, Add(ImgBlit.dy, ImgBlit.dh)) ThenBlock: {
            ImgBlit.cy1 = Add(ImgBlit.dy, ImgBlit.dh)
        }
        IfCondition GreaterEqual(ImgBlit.cx0, ImgBlit.cx1) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition GreaterEqual(ImgBlit.cy0, ImgBlit.cy1) ThenBlock: {
            ReturnValue(0)
        }
        ImgBlit.y = ImgBlit.cy0
        WhileLoop LessThan(ImgBlit.y, ImgBlit.cy1) {
            ImgBlit.sy = Divide(Multiply(Subtract(ImgBlit.y, ImgBlit.dy), ImgBlit.sh), ImgBlit.dh)
            IfCondition GreaterEqual(ImgBlit.sy, ImgBlit.sh) ThenBlock: {
                ImgBlit.sy = Subtract(ImgBlit.sh, 1)
            }
            ImgBlit.x = ImgBlit.cx0
            WhileLoop LessThan(ImgBlit.x, ImgBlit.cx1) {
                ImgBlit.sx = Divide(Multiply(Subtract(ImgBlit.x, ImgBlit.dx), ImgBlit.sw), ImgBlit.dw)
                IfCondition GreaterEqual(ImgBlit.sx, ImgBlit.sw) ThenBlock: {
                    ImgBlit.sx = Subtract(ImgBlit.sw, 1)
                }
                ImgBlit.color = Dereference(Add(Add(ImgBlit.pix, Multiply(ImgBlit.sy, ImgBlit.pitch)), Multiply(ImgBlit.sx, 4)), "dword")
                StoreValue(Add(Add(ImgBlit.sdata, Multiply(ImgBlit.y, ImgBlit.spitch)), Multiply(ImgBlit.x, 4)), ImgBlit.color, "dword")
                ImgBlit.x = Add(ImgBlit.x, 1)
            }
            ImgBlit.y = Add(ImgBlit.y, 1)
        }
        ReturnValue(1)
    }
}
