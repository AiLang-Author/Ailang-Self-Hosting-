// Library.PlaceHud.ailang
// Themed rubber-band + W/H HUD. Hosts: DocView tables, select, later CAD.
// Origin on down; opposite corner on drag. Internal pixels; HUD inches.
// Copyright © 2026 Sean Collins, 2 Paws Machine and Engineering. SCSL.

LibraryImport.Display.Render.DDrawPixel
LibraryImport.Display.Render.Fonts
LibraryImport.Display.Theme.UITheme
LibraryImport.Display.Theme.UIScale
LibraryImport.Display.Input.Cursor
LibraryImport.Display.Input.DInputTypes

FixedPool.PHTool {
    "CARET": Initialize=0
    "PLACE": Initialize=1
}

FixedPool.PlaceHud {
    "tool":  Initialize=0, CanChange=True
    "live":  Initialize=0, CanChange=True
    "drag":  Initialize=0, CanChange=True
    "x0":    Initialize=0, CanChange=True
    "y0":    Initialize=0, CanChange=True
    "x1":    Initialize=0, CanChange=True
    "y1":    Initialize=0, CanChange=True
    "xa":    Initialize=0, CanChange=True
    "ya":    Initialize=0, CanChange=True
    "xb":    Initialize=0, CanChange=True
    "yb":    Initialize=0, CanChange=True
    "wpx":   Initialize=0, CanChange=True
    "hpx":   Initialize=0, CanChange=True
    "field": Initialize=0, CanChange=True
    "lab":   Initialize=0, CanChange=True
    "nfr":   Initialize=0, CanChange=True
    "fr":    Initialize=0, CanChange=True
    "did":   Initialize=-1, CanChange=True
    "cin":   Initialize=0, CanChange=True
    "cwh":   Initialize=0, CanChange=True
    "cfr":   Initialize=0, CanChange=True
    "oi":     Initialize=0, CanChange=True
    "lx":     Initialize=0, CanChange=True
    "ly":     Initialize=0, CanChange=True
    "inited": Initialize=0, CanChange=True
    "sel_fi": Initialize=-1, CanChange=True
    "sel_r":  Initialize=0, CanChange=True
    "sel_c":  Initialize=0, CanChange=True
    "sel_off": Initialize=0, CanChange=True
    "tr":     Initialize=0, CanChange=True
    "tc":     Initialize=0, CanChange=True
    "cp":     Initialize=0, CanChange=True
    "np":     Initialize=0, CanChange=True
    "tf":     Initialize=0, CanChange=True
    "tsz":    Initialize=0, CanChange=True
    "kind":   Initialize=1, CanChange=True
    "pick":   Initialize=0, CanChange=True
    "grab":   Initialize=0, CanChange=True
    "gx":     Initialize=0, CanChange=True
    "gy":     Initialize=0, CanChange=True
    "ox":     Initialize=0, CanChange=True
    "oy":     Initialize=0, CanChange=True
    "ow":     Initialize=0, CanChange=True
    "oh":     Initialize=0, CanChange=True
    "so":     Initialize=0, CanChange=True
}

FixedPool.PHFrOff {
    "X":     Initialize=0
    "Y":     Initialize=8
    "W":     Initialize=16
    "H":     Initialize=24
    "KIND":  Initialize=32
    "DID":   Initialize=40
    "NCOL":  Initialize=48
    "NROW":  Initialize=56
    "CELLS": Initialize=64
    "RH":    Initialize=72
    "FACE":  Initialize=80
    "SIZE":  Initialize=88
    "CHILD": Initialize=96
    "SIDX":  Initialize=104
}

FixedPool.PHCellOff {
    "PTR": Initialize=0
    "LEN": Initialize=8
    "CAP": Initialize=16
}

FixedPool.PHConst {
    "FR_SIZE":    Initialize=112
    "FR_MAX":     Initialize=8
    "KIND_TABLE": Initialize=1
    "KIND_TEXT":  Initialize=2
    "KIND_IMAGE": Initialize=3
    "MIN_PX":     Initialize=24
    "CELL_SIZE":  Initialize=24
    "MAX_COL":    Initialize=8
    "MAX_ROW":    Initialize=32
    "GUTTER":     Initialize=18
    "DEF_COL":    Initialize=3
    "DEF_RH":     Initialize=22
    "HANDLE":     Initialize=8
    "GRAB_MOVE":  Initialize=1
    "GRAB_NW":    Initialize=2
    "GRAB_N":     Initialize=3
    "GRAB_NE":    Initialize=4
    "GRAB_E":     Initialize=5
    "GRAB_SE":    Initialize=6
    "GRAB_S":     Initialize=7
    "GRAB_SW":    Initialize=8
    "GRAB_W":     Initialize=9
}

Function.PlaceHud_Init {
    Body: {
        IfCondition EqualTo(PlaceHud.inited, 1) ThenBlock: {
            ReturnValue(1)
        }
        IfCondition EqualTo(PlaceHud.lab, 0) ThenBlock: {
            PlaceHud.lab = Allocate(64)
        }
        IfCondition EqualTo(PlaceHud.fr, 0) ThenBlock: {
            PlaceHud.fr = Allocate(Multiply(PHConst.FR_MAX, PHConst.FR_SIZE))
            IfCondition NotEqual(PlaceHud.fr, 0) ThenBlock: {
                MemorySet(PlaceHud.fr, 0, Multiply(PHConst.FR_MAX, PHConst.FR_SIZE))
            }
        }
        PlaceHud.tool = PHTool.CARET
        PlaceHud.live = 0
        PlaceHud.drag = 0
        PlaceHud.nfr = 0
        PlaceHud.inited = 1
        ReturnValue(1)
    }
}

Function.PlaceHud_Cancel {
    Body: {
        PlaceHud.live = 0
        PlaceHud.drag = 0
        PlaceHud.grab = 0
        ReturnValue(0)
    }
}

Function.PlaceHud_SetTool {
    Input: t: Integer
    Body: {
        PlaceHud_Init()
        PlaceHud.tool = t
        PlaceHud.live = 0
        PlaceHud.drag = 0
        PlaceHud.grab = 0
        IfCondition EqualTo(t, PHTool.PLACE) ThenBlock: {
            Cursor_SetShape(CursorShape.CROSSHAIR)
            PrintMessage("[PlaceHud] tool=PLACE\n")
        }
        ElseBlock: {
            Cursor_SetShape(CursorShape.BEAM)
            PrintMessage("[PlaceHud] tool=CARET\n")
        }
    }
}

Function.PlaceHud_Norm {
    Body: {
        PlaceHud.xa = PlaceHud.x0
        PlaceHud.xb = PlaceHud.x1
        IfCondition GreaterThan(PlaceHud.xa, PlaceHud.xb) ThenBlock: {
            PlaceHud.wpx = PlaceHud.xa
            PlaceHud.xa = PlaceHud.xb
            PlaceHud.xb = PlaceHud.wpx
        }
        PlaceHud.ya = PlaceHud.y0
        PlaceHud.yb = PlaceHud.y1
        IfCondition GreaterThan(PlaceHud.ya, PlaceHud.yb) ThenBlock: {
            PlaceHud.hpx = PlaceHud.ya
            PlaceHud.ya = PlaceHud.yb
            PlaceHud.yb = PlaceHud.hpx
        }
        PlaceHud.wpx = Subtract(PlaceHud.xb, PlaceHud.xa)
        PlaceHud.hpx = Subtract(PlaceHud.yb, PlaceHud.ya)
        IfCondition LessThan(PlaceHud.wpx, 0) ThenBlock: {
            PlaceHud.wpx = 0
        }
        IfCondition LessThan(PlaceHud.hpx, 0) ThenBlock: {
            PlaceHud.hpx = 0
        }
    }
}

Function.PlaceHud_Begin {
    Input: x: Integer
    Input: y: Integer
    Body: {
        PlaceHud_Init()
        PlaceHud.x0 = x
        PlaceHud.y0 = y
        PlaceHud.x1 = x
        PlaceHud.y1 = y
        PlaceHud.live = 1
        PlaceHud.drag = 0
        PlaceHud_Norm()
    }
}

Function.PlaceHud_Move {
    Input: x: Integer
    Input: y: Integer
    Body: {
        IfCondition EqualTo(PlaceHud.live, 0) ThenBlock: {
            ReturnValue(0)
        }
        PlaceHud.x1 = x
        PlaceHud.y1 = y
        PlaceHud_Norm()
        IfCondition GreaterThan(Add(PlaceHud.wpx, PlaceHud.hpx), 3) ThenBlock: {
            PlaceHud.drag = 1
        }
    }
}

Function.PlaceHud_InchStr {
    Input: px: Integer
    Input: dst: Address
    Input: off: Integer
    Output: Integer
    Body: {
        PlaceHud.so = off
        PlaceHud.cin = Divide(Multiply(px, 2540), 96)
        PlaceHud.cwh = Divide(PlaceHud.cin, 100)
        PlaceHud.cfr = Subtract(PlaceHud.cin, Multiply(PlaceHud.cwh, 100))
        IfCondition GreaterEqual(PlaceHud.cwh, 100) ThenBlock: {
            SetByte(dst, PlaceHud.so, Add(48, Divide(PlaceHud.cwh, 100)))
            PlaceHud.so = Add(PlaceHud.so, 1)
            PlaceHud.cwh = Subtract(PlaceHud.cwh, Multiply(Divide(PlaceHud.cwh, 100), 100))
            SetByte(dst, PlaceHud.so, Add(48, Divide(PlaceHud.cwh, 10)))
            PlaceHud.so = Add(PlaceHud.so, 1)
            SetByte(dst, PlaceHud.so, Add(48, Subtract(PlaceHud.cwh, Multiply(Divide(PlaceHud.cwh, 10), 10))))
            PlaceHud.so = Add(PlaceHud.so, 1)
        }
        ElseBlock: {
            IfCondition GreaterThan(PlaceHud.cwh, 9) ThenBlock: {
                SetByte(dst, PlaceHud.so, Add(48, Divide(PlaceHud.cwh, 10)))
                PlaceHud.so = Add(PlaceHud.so, 1)
                SetByte(dst, PlaceHud.so, Add(48, Subtract(PlaceHud.cwh, Multiply(Divide(PlaceHud.cwh, 10), 10))))
                PlaceHud.so = Add(PlaceHud.so, 1)
            }
            ElseBlock: {
                SetByte(dst, PlaceHud.so, Add(48, PlaceHud.cwh))
                PlaceHud.so = Add(PlaceHud.so, 1)
            }
        }
        SetByte(dst, PlaceHud.so, 46)
        PlaceHud.so = Add(PlaceHud.so, 1)
        SetByte(dst, PlaceHud.so, Add(48, Divide(PlaceHud.cfr, 10)))
        PlaceHud.so = Add(PlaceHud.so, 1)
        SetByte(dst, PlaceHud.so, Add(48, Subtract(PlaceHud.cfr, Multiply(Divide(PlaceHud.cfr, 10), 10))))
        PlaceHud.so = Add(PlaceHud.so, 1)
        ReturnValue(PlaceHud.so)
    }
}

Function.PlaceHud_UseFont {
    Input: face: Integer
    Input: size: Integer
    Output: Integer
    Body: {
        PlaceHud.cp = face
        PlaceHud.cin = size
        IfCondition LessThan(PlaceHud.cp, 0) ThenBlock: {
            PlaceHud.cp = FontState.doc_face
        }
        IfCondition LessThan(PlaceHud.cin, 8) ThenBlock: {
            PlaceHud.cin = 8
        }
        IfCondition GreaterThan(PlaceHud.cin, 72) ThenBlock: {
            PlaceHud.cin = 72
        }
        IfCondition LessThan(PlaceHud.cp, 0) ThenBlock: {
            ReturnValue(-1)
        }
        VFont_BindFace(PlaceHud.cp)
        FontState.render_size = PlaceHud.cin
        FontState.tab_px = 0
        FontState.sp_px = 0
        PlaceHud.np = VFont_CreateInstance(PlaceHud.cp, PlaceHud.cin)
        FontState.default_inst = PlaceHud.np
        ReturnValue(PlaceHud.np)
    }
}

Function.PlaceHud_Gw {
    Input: rh: Integer
    Output: Integer
    Body: {
        IfCondition GreaterThan(rh, PHConst.GUTTER) ThenBlock: {
            ReturnValue(rh)
        }
        ReturnValue(PHConst.GUTTER)
    }
}

Function.PlaceHud_Reflow {
    Input: fi: Integer
    Output: Integer
    Body: {
        PlaceHud.oi = PlaceHud_Fr(fi)
        IfCondition EqualTo(PlaceHud.oi, 0) ThenBlock: {
            ReturnValue(0)
        }
        PlaceHud.np = PlaceHud_UseFont(Dereference(Add(PlaceHud.oi, PHFrOff.FACE)), Dereference(Add(PlaceHud.oi, PHFrOff.SIZE)))
        IfCondition LessThan(PlaceHud.np, 0) ThenBlock: {
            ReturnValue(0)
        }
        PlaceHud.cfr = Add(VInst_GetLineHeight(PlaceHud.np), 6)
        IfCondition LessThan(PlaceHud.cfr, 16) ThenBlock: {
            PlaceHud.cfr = 16
        }
        StoreValue(Add(PlaceHud.oi, PHFrOff.RH), PlaceHud.cfr)
        PlaceHud.tr = Dereference(Add(PlaceHud.oi, PHFrOff.NROW))
        StoreValue(Add(PlaceHud.oi, PHFrOff.H), Multiply(PlaceHud.cfr, Add(PlaceHud.tr, 1)))
        ReturnValue(1)
    }
}

Function.PlaceHud_NudgeSize {
    Input: step: Integer
    Output: Integer
    Body: {
        PlaceHud.oi = PlaceHud_Fr(PlaceHud.sel_fi)
        IfCondition EqualTo(PlaceHud.oi, 0) ThenBlock: {
            ReturnValue(0)
        }
        PlaceHud.cfr = Add(Dereference(Add(PlaceHud.oi, PHFrOff.SIZE)), step)
        IfCondition LessThan(PlaceHud.cfr, 8) ThenBlock: {
            PlaceHud.cfr = 8
        }
        IfCondition GreaterThan(PlaceHud.cfr, 72) ThenBlock: {
            PlaceHud.cfr = 72
        }
        StoreValue(Add(PlaceHud.oi, PHFrOff.SIZE), PlaceHud.cfr)
        PlaceHud_Reflow(PlaceHud.sel_fi)
        ReturnValue(PlaceHud.cfr)
    }
}

Function.PlaceHud_SetFace {
    Input: face: Integer
    Output: Integer
    Body: {
        PlaceHud.oi = PlaceHud_Fr(PlaceHud.sel_fi)
        IfCondition EqualTo(PlaceHud.oi, 0) ThenBlock: {
            ReturnValue(0)
        }
        StoreValue(Add(PlaceHud.oi, PHFrOff.FACE), face)
        PlaceHud_Reflow(PlaceHud.sel_fi)
        ReturnValue(1)
    }
}

Function.PlaceHud_AddFrame {
    Input: did: Integer
    Input: face: Integer
    Input: size: Integer
    Output: Integer
    Body: {
        PlaceHud.tf = face
        PlaceHud.tsz = size
        PlaceHud_Init()
        PlaceHud_Norm()
        IfCondition Or(LessThan(PlaceHud.wpx, PHConst.MIN_PX), LessThan(PlaceHud.hpx, PHConst.MIN_PX)) ThenBlock: {
            ReturnValue(-1)
        }
        IfCondition GreaterEqual(PlaceHud.nfr, PHConst.FR_MAX) ThenBlock: {
            ReturnValue(-1)
        }
        PlaceHud.np = PlaceHud_UseFont(PlaceHud.tf, PlaceHud.tsz)
        PlaceHud.cfr = PHConst.DEF_RH
        IfCondition GreaterEqual(PlaceHud.np, 0) ThenBlock: {
            PlaceHud.cfr = Add(VInst_GetLineHeight(PlaceHud.np), 6)
            IfCondition LessThan(PlaceHud.cfr, 16) ThenBlock: {
                PlaceHud.cfr = 16
            }
        }
        PlaceHud.tc = PHConst.DEF_COL
        PlaceHud.tr = Divide(Subtract(PlaceHud.hpx, PlaceHud.cfr), PlaceHud.cfr)
        IfCondition LessThan(PlaceHud.tr, 1) ThenBlock: {
            PlaceHud.tr = 1
        }
        IfCondition GreaterThan(PlaceHud.tr, PHConst.MAX_ROW) ThenBlock: {
            PlaceHud.tr = PHConst.MAX_ROW
        }
        PlaceHud.hpx = Multiply(PlaceHud.cfr, Add(PlaceHud.tr, 1))
        PlaceHud.oi = Multiply(PlaceHud.tc, Add(PlaceHud.tr, 1))
        PlaceHud.cin = Allocate(Multiply(PlaceHud.oi, PHConst.CELL_SIZE))
        IfCondition EqualTo(PlaceHud.cin, 0) ThenBlock: {
            ReturnValue(-1)
        }
        MemorySet(PlaceHud.cin, 0, Multiply(PlaceHud.oi, PHConst.CELL_SIZE))
        PlaceHud.field = Add(PlaceHud.fr, Multiply(PlaceHud.nfr, PHConst.FR_SIZE))
        StoreValue(Add(PlaceHud.field, PHFrOff.X), PlaceHud.xa)
        StoreValue(Add(PlaceHud.field, PHFrOff.Y), PlaceHud.ya)
        StoreValue(Add(PlaceHud.field, PHFrOff.W), PlaceHud.wpx)
        StoreValue(Add(PlaceHud.field, PHFrOff.H), PlaceHud.hpx)
        StoreValue(Add(PlaceHud.field, PHFrOff.KIND), PHConst.KIND_TABLE)
        StoreValue(Add(PlaceHud.field, PHFrOff.DID), did)
        StoreValue(Add(PlaceHud.field, PHFrOff.NCOL), PlaceHud.tc)
        StoreValue(Add(PlaceHud.field, PHFrOff.NROW), PlaceHud.tr)
        StoreValue(Add(PlaceHud.field, PHFrOff.CELLS), PlaceHud.cin)
        StoreValue(Add(PlaceHud.field, PHFrOff.RH), PlaceHud.cfr)
        StoreValue(Add(PlaceHud.field, PHFrOff.FACE), PlaceHud.tf)
        StoreValue(Add(PlaceHud.field, PHFrOff.SIZE), PlaceHud.tsz)
        StoreValue(Add(PlaceHud.field, PHFrOff.CHILD), -1)
        StoreValue(Add(PlaceHud.field, PHFrOff.SIDX), -1)
        PlaceHud.sel_fi = PlaceHud.nfr
        PlaceHud.sel_r = 0
        PlaceHud.sel_c = 0
        PlaceHud.sel_off = 0
        PlaceHud.nfr = Add(PlaceHud.nfr, 1)
        ReturnValue(PlaceHud.sel_fi)
    }
}

Function.PlaceHud_SetKind {
    Input: k: Integer
    Body: {
        PlaceHud.kind = k
    }
}

Function.PlaceHud_SelKind {
    Output: Integer
    Body: {
        IfCondition LessThan(PlaceHud.sel_fi, 0) ThenBlock: {
            ReturnValue(-1)
        }
        PlaceHud.oi = PlaceHud_Fr(PlaceHud.sel_fi)
        IfCondition EqualTo(PlaceHud.oi, 0) ThenBlock: {
            ReturnValue(-1)
        }
        ReturnValue(Dereference(Add(PlaceHud.oi, PHFrOff.KIND)))
    }
}

Function.PlaceHud_AddBox {
    Input: did: Integer
    Input: child: Integer
    Input: sidx: Integer
    Input: face: Integer
    Input: size: Integer
    Output: Integer
    Body: {
        PlaceHud.tf = face
        PlaceHud.tsz = size
        PlaceHud.cp = child
        PlaceHud.np = sidx
        PlaceHud_Init()
        PlaceHud_Norm()
        IfCondition Or(LessThan(PlaceHud.wpx, PHConst.MIN_PX), LessThan(PlaceHud.hpx, PHConst.MIN_PX)) ThenBlock: {
            ReturnValue(-1)
        }
        IfCondition GreaterEqual(PlaceHud.nfr, PHConst.FR_MAX) ThenBlock: {
            ReturnValue(-1)
        }
        PlaceHud.field = Add(PlaceHud.fr, Multiply(PlaceHud.nfr, PHConst.FR_SIZE))
        StoreValue(Add(PlaceHud.field, PHFrOff.X), PlaceHud.xa)
        StoreValue(Add(PlaceHud.field, PHFrOff.Y), PlaceHud.ya)
        StoreValue(Add(PlaceHud.field, PHFrOff.W), PlaceHud.wpx)
        StoreValue(Add(PlaceHud.field, PHFrOff.H), PlaceHud.hpx)
        StoreValue(Add(PlaceHud.field, PHFrOff.KIND), PHConst.KIND_TEXT)
        StoreValue(Add(PlaceHud.field, PHFrOff.DID), did)
        StoreValue(Add(PlaceHud.field, PHFrOff.NCOL), 0)
        StoreValue(Add(PlaceHud.field, PHFrOff.NROW), 0)
        StoreValue(Add(PlaceHud.field, PHFrOff.CELLS), 0)
        StoreValue(Add(PlaceHud.field, PHFrOff.RH), 0)
        StoreValue(Add(PlaceHud.field, PHFrOff.FACE), PlaceHud.tf)
        StoreValue(Add(PlaceHud.field, PHFrOff.SIZE), PlaceHud.tsz)
        StoreValue(Add(PlaceHud.field, PHFrOff.CHILD), PlaceHud.cp)
        StoreValue(Add(PlaceHud.field, PHFrOff.SIDX), PlaceHud.np)
        PlaceHud.sel_fi = PlaceHud.nfr
        PlaceHud.sel_r = -1
        PlaceHud.sel_c = 0
        PlaceHud.sel_off = 0
        PlaceHud.nfr = Add(PlaceHud.nfr, 1)
        PrintMessage("[PlaceHud] text box w=")
        PrintNumber(PlaceHud.wpx)
        PrintMessage(" h=")
        PrintNumber(PlaceHud.hpx)
        PrintMessage(" child=")
        PrintNumber(PlaceHud.cp)
        PrintMessage("\n")
        ReturnValue(PlaceHud.sel_fi)
    }
}

Function.PlaceHud_AddImage {
    Input: did: Integer
    Output: Integer
    Body: {
        PlaceHud_Init()
        PlaceHud_Norm()
        IfCondition Or(LessThan(PlaceHud.wpx, PHConst.MIN_PX), LessThan(PlaceHud.hpx, PHConst.MIN_PX)) ThenBlock: {
            ReturnValue(-1)
        }
        IfCondition GreaterEqual(PlaceHud.nfr, PHConst.FR_MAX) ThenBlock: {
            ReturnValue(-1)
        }
        PlaceHud.field = Add(PlaceHud.fr, Multiply(PlaceHud.nfr, PHConst.FR_SIZE))
        StoreValue(Add(PlaceHud.field, PHFrOff.X), PlaceHud.xa)
        StoreValue(Add(PlaceHud.field, PHFrOff.Y), PlaceHud.ya)
        StoreValue(Add(PlaceHud.field, PHFrOff.W), PlaceHud.wpx)
        StoreValue(Add(PlaceHud.field, PHFrOff.H), PlaceHud.hpx)
        StoreValue(Add(PlaceHud.field, PHFrOff.KIND), PHConst.KIND_IMAGE)
        StoreValue(Add(PlaceHud.field, PHFrOff.DID), did)
        StoreValue(Add(PlaceHud.field, PHFrOff.NCOL), 0)
        StoreValue(Add(PlaceHud.field, PHFrOff.NROW), 0)
        StoreValue(Add(PlaceHud.field, PHFrOff.CELLS), 0)
        StoreValue(Add(PlaceHud.field, PHFrOff.RH), 0)
        StoreValue(Add(PlaceHud.field, PHFrOff.FACE), -1)
        StoreValue(Add(PlaceHud.field, PHFrOff.SIZE), 0)
        StoreValue(Add(PlaceHud.field, PHFrOff.CHILD), -1)
        StoreValue(Add(PlaceHud.field, PHFrOff.SIDX), -1)
        PlaceHud.sel_fi = PlaceHud.nfr
        PlaceHud.sel_r = -1
        PlaceHud.sel_c = 0
        PlaceHud.nfr = Add(PlaceHud.nfr, 1)
        PlaceHud.pick = 1
        PrintMessage("[PlaceHud] image frame w=")
        PrintNumber(PlaceHud.wpx)
        PrintMessage(" h=")
        PrintNumber(PlaceHud.hpx)
        PrintMessage("\n")
        ReturnValue(PlaceHud.sel_fi)
    }
}

Function.PlaceHud_BindImg {
    Input: handle: Integer
    Body: {
        PlaceHud.oi = PlaceHud_Fr(PlaceHud.sel_fi)
        IfCondition EqualTo(PlaceHud.oi, 0) ThenBlock: {
            ReturnValue(0)
        }
        StoreValue(Add(PlaceHud.oi, PHFrOff.CHILD), handle)
        PrintMessage("[PlaceHud] image bind handle=")
        PrintNumber(handle)
        PrintMessage("\n")
    }
}

Function.PlaceHud_GrabStart {
    Input: mode: Integer
    Body: {
        PlaceHud.oi = PlaceHud_Fr(PlaceHud.sel_fi)
        IfCondition EqualTo(PlaceHud.oi, 0) ThenBlock: {
            PlaceHud.grab = 0
            ReturnValue(0)
        }
        PlaceHud.ox = Dereference(Add(PlaceHud.oi, PHFrOff.X))
        PlaceHud.oy = Dereference(Add(PlaceHud.oi, PHFrOff.Y))
        PlaceHud.ow = Dereference(Add(PlaceHud.oi, PHFrOff.W))
        PlaceHud.oh = Dereference(Add(PlaceHud.oi, PHFrOff.H))
        PlaceHud.gx = Subtract(PlaceHud.lx, PlaceHud.ox)
        PlaceHud.gy = Subtract(PlaceHud.ly, PlaceHud.oy)
        PlaceHud.grab = mode
        PlaceHud.wpx = PlaceHud.ow
        PlaceHud.hpx = PlaceHud.oh
        PlaceHud.xa = PlaceHud.ox
        PlaceHud.ya = PlaceHud.oy
        ReturnValue(1)
    }
}

Function.PlaceHud_GrabApply {
    Body: {
        IfCondition EqualTo(PlaceHud.grab, 0) ThenBlock: {
            ReturnValue(0)
        }
        PlaceHud.oi = PlaceHud_Fr(PlaceHud.sel_fi)
        IfCondition EqualTo(PlaceHud.oi, 0) ThenBlock: {
            PlaceHud.grab = 0
            ReturnValue(0)
        }
        PlaceHud.xa = PlaceHud.ox
        PlaceHud.ya = PlaceHud.oy
        PlaceHud.wpx = PlaceHud.ow
        PlaceHud.hpx = PlaceHud.oh
        IfCondition EqualTo(PlaceHud.grab, PHConst.GRAB_MOVE) ThenBlock: {
            PlaceHud.xa = Subtract(PlaceHud.lx, PlaceHud.gx)
            PlaceHud.ya = Subtract(PlaceHud.ly, PlaceHud.gy)
        }
        IfCondition EqualTo(PlaceHud.grab, PHConst.GRAB_SE) ThenBlock: {
            PlaceHud.wpx = Subtract(PlaceHud.lx, PlaceHud.ox)
            PlaceHud.hpx = Subtract(PlaceHud.ly, PlaceHud.oy)
        }
        IfCondition EqualTo(PlaceHud.grab, PHConst.GRAB_SW) ThenBlock: {
            PlaceHud.xa = PlaceHud.lx
            PlaceHud.wpx = Subtract(Add(PlaceHud.ox, PlaceHud.ow), PlaceHud.lx)
            PlaceHud.hpx = Subtract(PlaceHud.ly, PlaceHud.oy)
        }
        IfCondition EqualTo(PlaceHud.grab, PHConst.GRAB_NE) ThenBlock: {
            PlaceHud.ya = PlaceHud.ly
            PlaceHud.wpx = Subtract(PlaceHud.lx, PlaceHud.ox)
            PlaceHud.hpx = Subtract(Add(PlaceHud.oy, PlaceHud.oh), PlaceHud.ly)
        }
        IfCondition EqualTo(PlaceHud.grab, PHConst.GRAB_NW) ThenBlock: {
            PlaceHud.xa = PlaceHud.lx
            PlaceHud.ya = PlaceHud.ly
            PlaceHud.wpx = Subtract(Add(PlaceHud.ox, PlaceHud.ow), PlaceHud.lx)
            PlaceHud.hpx = Subtract(Add(PlaceHud.oy, PlaceHud.oh), PlaceHud.ly)
        }
        IfCondition EqualTo(PlaceHud.grab, PHConst.GRAB_E) ThenBlock: {
            PlaceHud.wpx = Subtract(PlaceHud.lx, PlaceHud.ox)
        }
        IfCondition EqualTo(PlaceHud.grab, PHConst.GRAB_W) ThenBlock: {
            PlaceHud.xa = PlaceHud.lx
            PlaceHud.wpx = Subtract(Add(PlaceHud.ox, PlaceHud.ow), PlaceHud.lx)
        }
        IfCondition EqualTo(PlaceHud.grab, PHConst.GRAB_S) ThenBlock: {
            PlaceHud.hpx = Subtract(PlaceHud.ly, PlaceHud.oy)
        }
        IfCondition EqualTo(PlaceHud.grab, PHConst.GRAB_N) ThenBlock: {
            PlaceHud.ya = PlaceHud.ly
            PlaceHud.hpx = Subtract(Add(PlaceHud.oy, PlaceHud.oh), PlaceHud.ly)
        }
        IfCondition LessThan(PlaceHud.xa, 0) ThenBlock: { PlaceHud.xa = 0 }
        IfCondition LessThan(PlaceHud.ya, 0) ThenBlock: { PlaceHud.ya = 0 }
        IfCondition LessThan(PlaceHud.wpx, PHConst.MIN_PX) ThenBlock: {
            IfCondition Or(EqualTo(PlaceHud.grab, PHConst.GRAB_W), EqualTo(PlaceHud.grab, PHConst.GRAB_NW)) ThenBlock: {
                PlaceHud.xa = Subtract(Add(PlaceHud.ox, PlaceHud.ow), PHConst.MIN_PX)
            }
            IfCondition EqualTo(PlaceHud.grab, PHConst.GRAB_SW) ThenBlock: {
                PlaceHud.xa = Subtract(Add(PlaceHud.ox, PlaceHud.ow), PHConst.MIN_PX)
            }
            PlaceHud.wpx = PHConst.MIN_PX
        }
        IfCondition LessThan(PlaceHud.hpx, PHConst.MIN_PX) ThenBlock: {
            IfCondition Or(EqualTo(PlaceHud.grab, PHConst.GRAB_N), EqualTo(PlaceHud.grab, PHConst.GRAB_NW)) ThenBlock: {
                PlaceHud.ya = Subtract(Add(PlaceHud.oy, PlaceHud.oh), PHConst.MIN_PX)
            }
            IfCondition EqualTo(PlaceHud.grab, PHConst.GRAB_NE) ThenBlock: {
                PlaceHud.ya = Subtract(Add(PlaceHud.oy, PlaceHud.oh), PHConst.MIN_PX)
            }
            PlaceHud.hpx = PHConst.MIN_PX
        }
        StoreValue(Add(PlaceHud.oi, PHFrOff.X), PlaceHud.xa)
        StoreValue(Add(PlaceHud.oi, PHFrOff.Y), PlaceHud.ya)
        StoreValue(Add(PlaceHud.oi, PHFrOff.W), PlaceHud.wpx)
        StoreValue(Add(PlaceHud.oi, PHFrOff.H), PlaceHud.hpx)
        ReturnValue(1)
    }
}

Function.PlaceHud_InKnob {
    Input: x: Integer
    Input: y: Integer
    Input: kx: Integer
    Input: ky: Integer
    Output: Integer
    Body: {
        IfCondition And(And(GreaterEqual(x, kx), LessThan(x, Add(kx, PHConst.HANDLE))), And(GreaterEqual(y, ky), LessThan(y, Add(ky, PHConst.HANDLE)))) ThenBlock: {
            ReturnValue(1)
        }
        ReturnValue(0)
    }
}

Function.PlaceHud_HitHandle {
    Input: x: Integer
    Input: y: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(PlaceHud.sel_fi, 0) ThenBlock: {
            ReturnValue(0)
        }
        PlaceHud.oi = PlaceHud_Fr(PlaceHud.sel_fi)
        IfCondition EqualTo(PlaceHud.oi, 0) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition NotEqual(Dereference(Add(PlaceHud.oi, PHFrOff.KIND)), PHConst.KIND_IMAGE) ThenBlock: {
            ReturnValue(0)
        }
        PlaceHud.xa = Dereference(Add(PlaceHud.oi, PHFrOff.X))
        PlaceHud.ya = Dereference(Add(PlaceHud.oi, PHFrOff.Y))
        PlaceHud.wpx = Dereference(Add(PlaceHud.oi, PHFrOff.W))
        PlaceHud.hpx = Dereference(Add(PlaceHud.oi, PHFrOff.H))
        PlaceHud.np = Subtract(PHConst.HANDLE, 0)
        IfCondition EqualTo(PlaceHud_InKnob(x, y, PlaceHud.xa, PlaceHud.ya), 1) ThenBlock: {
            ReturnValue(PHConst.GRAB_NW)
        }
        IfCondition EqualTo(PlaceHud_InKnob(x, y, Subtract(Add(PlaceHud.xa, PlaceHud.wpx), PlaceHud.np), PlaceHud.ya), 1) ThenBlock: {
            ReturnValue(PHConst.GRAB_NE)
        }
        IfCondition EqualTo(PlaceHud_InKnob(x, y, Subtract(Add(PlaceHud.xa, PlaceHud.wpx), PlaceHud.np), Subtract(Add(PlaceHud.ya, PlaceHud.hpx), PlaceHud.np)), 1) ThenBlock: {
            ReturnValue(PHConst.GRAB_SE)
        }
        IfCondition EqualTo(PlaceHud_InKnob(x, y, PlaceHud.xa, Subtract(Add(PlaceHud.ya, PlaceHud.hpx), PlaceHud.np)), 1) ThenBlock: {
            ReturnValue(PHConst.GRAB_SW)
        }
        IfCondition EqualTo(PlaceHud_InKnob(x, y, Add(PlaceHud.xa, Divide(Subtract(PlaceHud.wpx, PlaceHud.np), 2)), PlaceHud.ya), 1) ThenBlock: {
            ReturnValue(PHConst.GRAB_N)
        }
        IfCondition EqualTo(PlaceHud_InKnob(x, y, Add(PlaceHud.xa, Divide(Subtract(PlaceHud.wpx, PlaceHud.np), 2)), Subtract(Add(PlaceHud.ya, PlaceHud.hpx), PlaceHud.np)), 1) ThenBlock: {
            ReturnValue(PHConst.GRAB_S)
        }
        IfCondition EqualTo(PlaceHud_InKnob(x, y, PlaceHud.xa, Add(PlaceHud.ya, Divide(Subtract(PlaceHud.hpx, PlaceHud.np), 2))), 1) ThenBlock: {
            ReturnValue(PHConst.GRAB_W)
        }
        IfCondition EqualTo(PlaceHud_InKnob(x, y, Subtract(Add(PlaceHud.xa, PlaceHud.wpx), PlaceHud.np), Add(PlaceHud.ya, Divide(Subtract(PlaceHud.hpx, PlaceHud.np), 2))), 1) ThenBlock: {
            ReturnValue(PHConst.GRAB_E)
        }
        ReturnValue(0)
    }
}

Function.PlaceHud_DrawKnob {
    Input: canvas: Integer
    Input: x: Integer
    Input: y: Integer
    Body: {
        Draw_Pix_FillRect(canvas, x, y, PHConst.HANDLE, PHConst.HANDLE, Theme.hud_accent)
        Draw_Pix_FillRect(canvas, Add(x, 1), Add(y, 1), Subtract(PHConst.HANDLE, 2), Subtract(PHConst.HANDLE, 2), 0xFFFFFFFF)
    }
}

Function.PlaceHud_DrawHandles {
    Input: canvas: Integer
    Input: x: Integer
    Input: y: Integer
    Input: w: Integer
    Input: h: Integer
    Body: {
        PlaceHud.np = PHConst.HANDLE
        PlaceHud_DrawKnob(canvas, x, y)
        PlaceHud_DrawKnob(canvas, Subtract(Add(x, w), PlaceHud.np), y)
        PlaceHud_DrawKnob(canvas, Subtract(Add(x, w), PlaceHud.np), Subtract(Add(y, h), PlaceHud.np))
        PlaceHud_DrawKnob(canvas, x, Subtract(Add(y, h), PlaceHud.np))
        PlaceHud_DrawKnob(canvas, Add(x, Divide(Subtract(w, PlaceHud.np), 2)), y)
        PlaceHud_DrawKnob(canvas, Add(x, Divide(Subtract(w, PlaceHud.np), 2)), Subtract(Add(y, h), PlaceHud.np))
        PlaceHud_DrawKnob(canvas, x, Add(y, Divide(Subtract(h, PlaceHud.np), 2)))
        PlaceHud_DrawKnob(canvas, Subtract(Add(x, w), PlaceHud.np), Add(y, Divide(Subtract(h, PlaceHud.np), 2)))
    }
}

Function.PlaceHud_Nudge {
    Input: dx: Integer
    Input: dy: Integer
    Output: Integer
    Body: {
        PlaceHud.oi = PlaceHud_Fr(PlaceHud.sel_fi)
        IfCondition EqualTo(PlaceHud.oi, 0) ThenBlock: {
            ReturnValue(0)
        }
        PlaceHud.xa = Add(Dereference(Add(PlaceHud.oi, PHFrOff.X)), dx)
        PlaceHud.ya = Add(Dereference(Add(PlaceHud.oi, PHFrOff.Y)), dy)
        IfCondition LessThan(PlaceHud.xa, 0) ThenBlock: { PlaceHud.xa = 0 }
        IfCondition LessThan(PlaceHud.ya, 0) ThenBlock: { PlaceHud.ya = 0 }
        StoreValue(Add(PlaceHud.oi, PHFrOff.X), PlaceHud.xa)
        StoreValue(Add(PlaceHud.oi, PHFrOff.Y), PlaceHud.ya)
        ReturnValue(1)
    }
}

Function.PlaceHud_Stroke {
    Input: canvas: Integer
    Input: x: Integer
    Input: y: Integer
    Input: w: Integer
    Input: h: Integer
    Input: color: Integer
    Body: {
        IfCondition Or(LessThan(w, 1), LessThan(h, 1)) ThenBlock: {
            ReturnValue(0)
        }
        Draw_Pix_FillRect(canvas, x, y, w, 1, color)
        Draw_Pix_FillRect(canvas, x, Subtract(Add(y, h), 1), w, 1, color)
        Draw_Pix_FillRect(canvas, x, y, 1, h, color)
        Draw_Pix_FillRect(canvas, Subtract(Add(x, w), 1), y, 1, h, color)
    }
}

Function.PlaceHud_DrawHud {
    Input: canvas: Integer
    Input: hx: Integer
    Input: hy: Integer
    Body: {
        PlaceHud_Init()
        PlaceHud_Norm()
        IfCondition EqualTo(PlaceHud.lab, 0) ThenBlock: {
            ReturnValue(0)
        }
        Draw_Pix_FillRect(canvas, hx, hy, 220, 22, Theme.hud_bg)
        PlaceHud.cin = 0
        SetByte(PlaceHud.lab, 0, 87)
        SetByte(PlaceHud.lab, 1, 32)
        PlaceHud.cin = PlaceHud_InchStr(PlaceHud.wpx, PlaceHud.lab, 2)
        SetByte(PlaceHud.lab, PlaceHud.cin, 32)
        PlaceHud.cin = Add(PlaceHud.cin, 1)
        SetByte(PlaceHud.lab, PlaceHud.cin, 72)
        PlaceHud.cin = Add(PlaceHud.cin, 1)
        SetByte(PlaceHud.lab, PlaceHud.cin, 32)
        PlaceHud.cin = Add(PlaceHud.cin, 1)
        PlaceHud.cin = PlaceHud_InchStr(PlaceHud.hpx, PlaceHud.lab, PlaceHud.cin)
        SetByte(PlaceHud.lab, PlaceHud.cin, 32)
        PlaceHud.cin = Add(PlaceHud.cin, 1)
        SetByte(PlaceHud.lab, PlaceHud.cin, 109)
        PlaceHud.cin = Add(PlaceHud.cin, 1)
        SetByte(PlaceHud.lab, PlaceHud.cin, 109)
        PlaceHud.cin = Add(PlaceHud.cin, 1)
        SetByte(PlaceHud.lab, PlaceHud.cin, 0)
        FontState.draw_color = Theme.hud_fg
        VFont_UseDocSize(12)
        VFont_DrawString(canvas, PlaceHud.lab, PlaceHud.cin, Add(hx, 6), Add(hy, 4), Theme.hud_fg)
    }
}

Function.PlaceHud_Fr {
    Input: fi: Integer
    Output: Address
    Body: {
        IfCondition Or(LessThan(fi, 0), GreaterEqual(fi, PlaceHud.nfr)) ThenBlock: {
            ReturnValue(0)
        }
        ReturnValue(Add(PlaceHud.fr, Multiply(fi, PHConst.FR_SIZE)))
    }
}

Function.PlaceHud_Cell {
    Input: fi: Integer
    Input: r: Integer
    Input: c: Integer
    Output: Address
    Body: {
        PlaceHud.oi = PlaceHud_Fr(fi)
        IfCondition EqualTo(PlaceHud.oi, 0) ThenBlock: {
            ReturnValue(0)
        }
        PlaceHud.tc = Dereference(Add(PlaceHud.oi, PHFrOff.NCOL))
        PlaceHud.tr = Dereference(Add(PlaceHud.oi, PHFrOff.NROW))
        IfCondition Or(LessThan(c, 0), GreaterEqual(c, PlaceHud.tc)) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition Or(LessThan(r, 0), GreaterThan(r, PlaceHud.tr)) ThenBlock: {
            ReturnValue(0)
        }
        PlaceHud.cin = Dereference(Add(PlaceHud.oi, PHFrOff.CELLS))
        IfCondition EqualTo(PlaceHud.cin, 0) ThenBlock: {
            ReturnValue(0)
        }
        ReturnValue(Add(PlaceHud.cin, Multiply(Add(Multiply(r, PlaceHud.tc), c), PHConst.CELL_SIZE)))
    }
}

Function.PlaceHud_GrowRow {
    Input: fi: Integer
    Output: Integer
    Body: {
        PlaceHud.oi = PlaceHud_Fr(fi)
        IfCondition EqualTo(PlaceHud.oi, 0) ThenBlock: {
            ReturnValue(0)
        }
        PlaceHud.tc = Dereference(Add(PlaceHud.oi, PHFrOff.NCOL))
        PlaceHud.tr = Dereference(Add(PlaceHud.oi, PHFrOff.NROW))
        IfCondition GreaterEqual(PlaceHud.tr, PHConst.MAX_ROW) ThenBlock: {
            ReturnValue(0)
        }
        PlaceHud.cfr = Dereference(Add(PlaceHud.oi, PHFrOff.CELLS))
        PlaceHud.cin = Multiply(PlaceHud.tc, Add(PlaceHud.tr, 2))
        PlaceHud.np = Allocate(Multiply(PlaceHud.cin, PHConst.CELL_SIZE))
        IfCondition EqualTo(PlaceHud.np, 0) ThenBlock: {
            ReturnValue(0)
        }
        MemorySet(PlaceHud.np, 0, Multiply(PlaceHud.cin, PHConst.CELL_SIZE))
        PlaceHud.cin = Multiply(Multiply(PlaceHud.tc, Add(PlaceHud.tr, 1)), PHConst.CELL_SIZE)
        PlaceHud.lx = 0
        WhileLoop LessThan(PlaceHud.lx, PlaceHud.cin) {
            StoreValue(Add(PlaceHud.np, PlaceHud.lx), Dereference(Add(PlaceHud.cfr, PlaceHud.lx)))
            PlaceHud.lx = Add(PlaceHud.lx, 8)
        }
        IfCondition NotEqual(PlaceHud.cfr, 0) ThenBlock: {
            Deallocate(PlaceHud.cfr, PlaceHud.cin)
        }
        PlaceHud.tr = Add(PlaceHud.tr, 1)
        StoreValue(Add(PlaceHud.oi, PHFrOff.CELLS), PlaceHud.np)
        StoreValue(Add(PlaceHud.oi, PHFrOff.NROW), PlaceHud.tr)
        PlaceHud.cfr = Dereference(Add(PlaceHud.oi, PHFrOff.RH))
        StoreValue(Add(PlaceHud.oi, PHFrOff.H), Add(Dereference(Add(PlaceHud.oi, PHFrOff.H)), PlaceHud.cfr))
        ReturnValue(1)
    }
}

Function.PlaceHud_GrowCol {
    Input: fi: Integer
    Output: Integer
    Body: {
        PlaceHud.oi = PlaceHud_Fr(fi)
        IfCondition EqualTo(PlaceHud.oi, 0) ThenBlock: {
            ReturnValue(0)
        }
        PlaceHud.tc = Dereference(Add(PlaceHud.oi, PHFrOff.NCOL))
        PlaceHud.tr = Dereference(Add(PlaceHud.oi, PHFrOff.NROW))
        IfCondition GreaterEqual(PlaceHud.tc, PHConst.MAX_COL) ThenBlock: {
            ReturnValue(0)
        }
        PlaceHud.cfr = Dereference(Add(PlaceHud.oi, PHFrOff.CELLS))
        PlaceHud.cin = Multiply(Add(PlaceHud.tc, 1), Add(PlaceHud.tr, 1))
        PlaceHud.np = Allocate(Multiply(PlaceHud.cin, PHConst.CELL_SIZE))
        IfCondition EqualTo(PlaceHud.np, 0) ThenBlock: {
            ReturnValue(0)
        }
        MemorySet(PlaceHud.np, 0, Multiply(PlaceHud.cin, PHConst.CELL_SIZE))
        PlaceHud.lx = 0
        WhileLoop LessEqual(PlaceHud.lx, PlaceHud.tr) {
            PlaceHud.ly = 0
            WhileLoop LessThan(PlaceHud.ly, PlaceHud.tc) {
                PlaceHud.cp = Add(PlaceHud.cfr, Multiply(Add(Multiply(PlaceHud.lx, PlaceHud.tc), PlaceHud.ly), PHConst.CELL_SIZE))
                PlaceHud.cwh = Add(PlaceHud.np, Multiply(Add(Multiply(PlaceHud.lx, Add(PlaceHud.tc, 1)), PlaceHud.ly), PHConst.CELL_SIZE))
                StoreValue(Add(PlaceHud.cwh, PHCellOff.PTR), Dereference(Add(PlaceHud.cp, PHCellOff.PTR)))
                StoreValue(Add(PlaceHud.cwh, PHCellOff.LEN), Dereference(Add(PlaceHud.cp, PHCellOff.LEN)))
                StoreValue(Add(PlaceHud.cwh, PHCellOff.CAP), Dereference(Add(PlaceHud.cp, PHCellOff.CAP)))
                PlaceHud.ly = Add(PlaceHud.ly, 1)
            }
            PlaceHud.lx = Add(PlaceHud.lx, 1)
        }
        PlaceHud.cin = Multiply(Multiply(PlaceHud.tc, Add(PlaceHud.tr, 1)), PHConst.CELL_SIZE)
        IfCondition NotEqual(PlaceHud.cfr, 0) ThenBlock: {
            Deallocate(PlaceHud.cfr, PlaceHud.cin)
        }
        PlaceHud.tc = Add(PlaceHud.tc, 1)
        StoreValue(Add(PlaceHud.oi, PHFrOff.CELLS), PlaceHud.np)
        StoreValue(Add(PlaceHud.oi, PHFrOff.NCOL), PlaceHud.tc)
        ReturnValue(1)
    }
}

Function.PlaceHud_Insert {
    Input: ch: Integer
    Body: {
        PlaceHud.oi = PlaceHud_Cell(PlaceHud.sel_fi, PlaceHud.sel_r, PlaceHud.sel_c)
        IfCondition EqualTo(PlaceHud.oi, 0) ThenBlock: {
            ReturnValue(0)
        }
        PlaceHud.cin = Dereference(Add(PlaceHud.oi, PHCellOff.PTR))
        PlaceHud.cwh = Dereference(Add(PlaceHud.oi, PHCellOff.LEN))
        PlaceHud.cfr = Dereference(Add(PlaceHud.oi, PHCellOff.CAP))
        IfCondition EqualTo(PlaceHud.cin, 0) ThenBlock: {
            PlaceHud.cfr = 32
            PlaceHud.cin = Allocate(32)
            IfCondition EqualTo(PlaceHud.cin, 0) ThenBlock: {
                ReturnValue(0)
            }
            MemorySet(PlaceHud.cin, 0, 32)
            StoreValue(Add(PlaceHud.oi, PHCellOff.PTR), PlaceHud.cin)
            StoreValue(Add(PlaceHud.oi, PHCellOff.CAP), 32)
            PlaceHud.cwh = 0
        }
        IfCondition GreaterEqual(PlaceHud.cwh, PlaceHud.cfr) ThenBlock: {
            PlaceHud.np = Multiply(PlaceHud.cfr, 2)
            IfCondition LessThan(PlaceHud.np, 32) ThenBlock: {
                PlaceHud.np = 32
            }
            PlaceHud.cp = Allocate(PlaceHud.np)
            IfCondition EqualTo(PlaceHud.cp, 0) ThenBlock: {
                ReturnValue(0)
            }
            MemorySet(PlaceHud.cp, 0, PlaceHud.np)
            PlaceHud.lx = 0
            WhileLoop LessThan(PlaceHud.lx, PlaceHud.cwh) {
                SetByte(PlaceHud.cp, PlaceHud.lx, GetByte(PlaceHud.cin, PlaceHud.lx))
                PlaceHud.lx = Add(PlaceHud.lx, 1)
            }
            Deallocate(PlaceHud.cin, PlaceHud.cfr)
            PlaceHud.cin = PlaceHud.cp
            PlaceHud.cfr = PlaceHud.np
            StoreValue(Add(PlaceHud.oi, PHCellOff.PTR), PlaceHud.cin)
            StoreValue(Add(PlaceHud.oi, PHCellOff.CAP), PlaceHud.cfr)
        }
        IfCondition GreaterThan(PlaceHud.sel_off, PlaceHud.cwh) ThenBlock: {
            PlaceHud.sel_off = PlaceHud.cwh
        }
        PlaceHud.lx = PlaceHud.cwh
        WhileLoop GreaterThan(PlaceHud.lx, PlaceHud.sel_off) {
            SetByte(PlaceHud.cin, PlaceHud.lx, GetByte(PlaceHud.cin, Subtract(PlaceHud.lx, 1)))
            PlaceHud.lx = Subtract(PlaceHud.lx, 1)
        }
        SetByte(PlaceHud.cin, PlaceHud.sel_off, ch)
        PlaceHud.cwh = Add(PlaceHud.cwh, 1)
        PlaceHud.sel_off = Add(PlaceHud.sel_off, 1)
        StoreValue(Add(PlaceHud.oi, PHCellOff.LEN), PlaceHud.cwh)
    }
}

Function.PlaceHud_Backspace {
    Body: {
        IfCondition LessEqual(PlaceHud.sel_off, 0) ThenBlock: {
            ReturnValue(0)
        }
        PlaceHud.oi = PlaceHud_Cell(PlaceHud.sel_fi, PlaceHud.sel_r, PlaceHud.sel_c)
        IfCondition EqualTo(PlaceHud.oi, 0) ThenBlock: {
            ReturnValue(0)
        }
        PlaceHud.cin = Dereference(Add(PlaceHud.oi, PHCellOff.PTR))
        PlaceHud.cwh = Dereference(Add(PlaceHud.oi, PHCellOff.LEN))
        IfCondition Or(EqualTo(PlaceHud.cin, 0), LessEqual(PlaceHud.cwh, 0)) ThenBlock: {
            ReturnValue(0)
        }
        PlaceHud.sel_off = Subtract(PlaceHud.sel_off, 1)
        PlaceHud.lx = PlaceHud.sel_off
        WhileLoop LessThan(PlaceHud.lx, Subtract(PlaceHud.cwh, 1)) {
            SetByte(PlaceHud.cin, PlaceHud.lx, GetByte(PlaceHud.cin, Add(PlaceHud.lx, 1)))
            PlaceHud.lx = Add(PlaceHud.lx, 1)
        }
        PlaceHud.cwh = Subtract(PlaceHud.cwh, 1)
        StoreValue(Add(PlaceHud.oi, PHCellOff.LEN), PlaceHud.cwh)
    }
}

Function.PlaceHud_NextCell {
    Input: shift: Integer
    Body: {
        PlaceHud.oi = PlaceHud_Fr(PlaceHud.sel_fi)
        IfCondition EqualTo(PlaceHud.oi, 0) ThenBlock: {
            ReturnValue(0)
        }
        PlaceHud.tc = Dereference(Add(PlaceHud.oi, PHFrOff.NCOL))
        PlaceHud.tr = Dereference(Add(PlaceHud.oi, PHFrOff.NROW))
        IfCondition NotEqual(shift, 0) ThenBlock: {
            IfCondition GreaterThan(PlaceHud.sel_c, 0) ThenBlock: {
                PlaceHud.sel_c = Subtract(PlaceHud.sel_c, 1)
            }
            ElseBlock: {
                IfCondition GreaterThan(PlaceHud.sel_r, 0) ThenBlock: {
                    PlaceHud.sel_r = Subtract(PlaceHud.sel_r, 1)
                    PlaceHud.sel_c = Subtract(PlaceHud.tc, 1)
                }
            }
            PlaceHud.sel_off = 0
            ReturnValue(1)
        }
        IfCondition And(EqualTo(PlaceHud.sel_r, 0), EqualTo(PlaceHud.sel_c, Subtract(PlaceHud.tc, 1))) ThenBlock: {
            IfCondition LessThan(PlaceHud.tc, PHConst.MAX_COL) ThenBlock: {
                PlaceHud_GrowCol(PlaceHud.sel_fi)
                PlaceHud.oi = PlaceHud_Fr(PlaceHud.sel_fi)
                PlaceHud.sel_c = Subtract(Dereference(Add(PlaceHud.oi, PHFrOff.NCOL)), 1)
                PlaceHud.sel_off = 0
                ReturnValue(1)
            }
            PlaceHud.sel_r = 1
            PlaceHud.sel_c = 0
            PlaceHud.sel_off = 0
            ReturnValue(1)
        }
        IfCondition And(EqualTo(PlaceHud.sel_r, PlaceHud.tr), EqualTo(PlaceHud.sel_c, Subtract(PlaceHud.tc, 1))) ThenBlock: {
            PlaceHud_GrowRow(PlaceHud.sel_fi)
            PlaceHud.oi = PlaceHud_Fr(PlaceHud.sel_fi)
            PlaceHud.sel_r = Dereference(Add(PlaceHud.oi, PHFrOff.NROW))
            PlaceHud.sel_c = 0
            PlaceHud.sel_off = 0
            ReturnValue(1)
        }
        PlaceHud.sel_c = Add(PlaceHud.sel_c, 1)
        IfCondition GreaterEqual(PlaceHud.sel_c, PlaceHud.tc) ThenBlock: {
            PlaceHud.sel_c = 0
            PlaceHud.sel_r = Add(PlaceHud.sel_r, 1)
        }
        PlaceHud.sel_off = 0
        ReturnValue(1)
    }
}

Function.PlaceHud_Enter {
    Body: {
        PlaceHud.oi = PlaceHud_Fr(PlaceHud.sel_fi)
        IfCondition EqualTo(PlaceHud.oi, 0) ThenBlock: {
            ReturnValue(0)
        }
        PlaceHud.tr = Dereference(Add(PlaceHud.oi, PHFrOff.NROW))
        IfCondition EqualTo(PlaceHud.sel_r, 0) ThenBlock: {
            PlaceHud.sel_r = 1
            PlaceHud.sel_off = 0
            ReturnValue(1)
        }
        IfCondition GreaterEqual(PlaceHud.sel_r, PlaceHud.tr) ThenBlock: {
            PlaceHud_GrowRow(PlaceHud.sel_fi)
            PlaceHud.oi = PlaceHud_Fr(PlaceHud.sel_fi)
            PlaceHud.sel_r = Dereference(Add(PlaceHud.oi, PHFrOff.NROW))
            PlaceHud.sel_off = 0
            ReturnValue(1)
        }
        PlaceHud.sel_r = Add(PlaceHud.sel_r, 1)
        PlaceHud.sel_off = 0
        ReturnValue(1)
    }
}

Function.PlaceHud_Hit {
    Input: did: Integer
    Input: x: Integer
    Input: y: Integer
    Output: Integer
    Body: {
        PlaceHud_Init()
        PlaceHud.field = Subtract(PlaceHud.nfr, 1)
        WhileLoop GreaterEqual(PlaceHud.field, 0) {
            PlaceHud.oi = Add(PlaceHud.fr, Multiply(PlaceHud.field, PHConst.FR_SIZE))
            IfCondition EqualTo(Dereference(Add(PlaceHud.oi, PHFrOff.DID)), did) ThenBlock: {
                PlaceHud.xa = Dereference(Add(PlaceHud.oi, PHFrOff.X))
                PlaceHud.ya = Dereference(Add(PlaceHud.oi, PHFrOff.Y))
                PlaceHud.wpx = Dereference(Add(PlaceHud.oi, PHFrOff.W))
                PlaceHud.hpx = Dereference(Add(PlaceHud.oi, PHFrOff.H))
                IfCondition And(And(GreaterEqual(x, PlaceHud.xa), LessThan(x, Add(PlaceHud.xa, PlaceHud.wpx))), And(GreaterEqual(y, PlaceHud.ya), LessThan(y, Add(PlaceHud.ya, PlaceHud.hpx)))) ThenBlock: {
                    PlaceHud.sel_fi = PlaceHud.field
                    IfCondition NotEqual(Dereference(Add(PlaceHud.oi, PHFrOff.KIND)), PHConst.KIND_TABLE) ThenBlock: {
                        PlaceHud.sel_r = -1
                        PlaceHud.sel_c = 0
                        PlaceHud.sel_off = 0
                        ReturnValue(1)
                    }
                    PlaceHud.tc = Dereference(Add(PlaceHud.oi, PHFrOff.NCOL))
                    PlaceHud.tr = Dereference(Add(PlaceHud.oi, PHFrOff.NROW))
                    PlaceHud.cfr = Dereference(Add(PlaceHud.oi, PHFrOff.RH))
                    IfCondition LessThan(PlaceHud.tc, 1) ThenBlock: {
                        PlaceHud.tc = PHConst.DEF_COL
                    }
                    IfCondition LessThan(PlaceHud.cfr, 16) ThenBlock: {
                        PlaceHud.cfr = PHConst.DEF_RH
                    }
                    PlaceHud.np = PlaceHud_Gw(PlaceHud.cfr)
                    PlaceHud.cin = Subtract(PlaceHud.wpx, PlaceHud.np)
                    IfCondition LessThan(PlaceHud.cin, PlaceHud.tc) ThenBlock: {
                        PlaceHud.cin = PlaceHud.tc
                    }
                    PlaceHud.cwh = Divide(PlaceHud.cin, PlaceHud.tc)
                    PlaceHud.sel_r = Divide(Subtract(y, PlaceHud.ya), PlaceHud.cfr)
                    IfCondition LessThan(PlaceHud.sel_r, 0) ThenBlock: {
                        PlaceHud.sel_r = 0
                    }
                    IfCondition GreaterThan(PlaceHud.sel_r, PlaceHud.tr) ThenBlock: {
                        PlaceHud.sel_r = PlaceHud.tr
                    }
                    PlaceHud.sel_c = Divide(Subtract(Subtract(x, PlaceHud.xa), PlaceHud.np), PlaceHud.cwh)
                    IfCondition LessThan(PlaceHud.sel_c, 0) ThenBlock: {
                        PlaceHud.sel_c = 0
                    }
                    IfCondition GreaterEqual(PlaceHud.sel_c, PlaceHud.tc) ThenBlock: {
                        PlaceHud.sel_c = Subtract(PlaceHud.tc, 1)
                    }
                    PlaceHud.sel_fi = PlaceHud.field
                    PlaceHud.oi = PlaceHud_Cell(PlaceHud.sel_fi, PlaceHud.sel_r, PlaceHud.sel_c)
                    PlaceHud.sel_off = 0
                    IfCondition NotEqual(PlaceHud.oi, 0) ThenBlock: {
                        PlaceHud.sel_off = Dereference(Add(PlaceHud.oi, PHCellOff.LEN))
                    }
                    ReturnValue(1)
                }
            }
            PlaceHud.field = Subtract(PlaceHud.field, 1)
        }
        ReturnValue(0)
    }
}

Function.PlaceHud_Key {
    Input: keycode: Integer
    Input: ch: Integer
    Input: shift: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(PlaceHud.sel_fi, 0) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition Or(EqualTo(keycode, Key.TAB), EqualTo(ch, 9)) ThenBlock: {
            PlaceHud_NextCell(shift)
            ReturnValue(1)
        }
        IfCondition EqualTo(keycode, Key.ENTER) ThenBlock: {
            PlaceHud_Enter()
            ReturnValue(1)
        }
        IfCondition EqualTo(keycode, Key.BACKSPACE) ThenBlock: {
            PlaceHud_Backspace()
            ReturnValue(1)
        }
        IfCondition EqualTo(keycode, Key.LEFT) ThenBlock: {
            IfCondition GreaterThan(PlaceHud.sel_off, 0) ThenBlock: {
                PlaceHud.sel_off = Subtract(PlaceHud.sel_off, 1)
            }
            ElseBlock: {
                PlaceHud_NextCell(1)
            }
            ReturnValue(1)
        }
        IfCondition EqualTo(keycode, Key.RIGHT) ThenBlock: {
            PlaceHud.oi = PlaceHud_Cell(PlaceHud.sel_fi, PlaceHud.sel_r, PlaceHud.sel_c)
            PlaceHud.cwh = 0
            IfCondition NotEqual(PlaceHud.oi, 0) ThenBlock: {
                PlaceHud.cwh = Dereference(Add(PlaceHud.oi, PHCellOff.LEN))
            }
            IfCondition LessThan(PlaceHud.sel_off, PlaceHud.cwh) ThenBlock: {
                PlaceHud.sel_off = Add(PlaceHud.sel_off, 1)
            }
            ElseBlock: {
                PlaceHud_NextCell(0)
            }
            ReturnValue(1)
        }
        IfCondition EqualTo(keycode, Key.UP) ThenBlock: {
            IfCondition GreaterThan(PlaceHud.sel_r, 0) ThenBlock: {
                PlaceHud.sel_r = Subtract(PlaceHud.sel_r, 1)
                PlaceHud.sel_off = 0
            }
            ReturnValue(1)
        }
        IfCondition EqualTo(keycode, Key.DOWN) ThenBlock: {
            PlaceHud_Enter()
            ReturnValue(1)
        }
        IfCondition And(GreaterEqual(ch, 32), LessThan(ch, 127)) ThenBlock: {
            PlaceHud_Insert(ch)
            ReturnValue(1)
        }
        ReturnValue(0)
    }
}

