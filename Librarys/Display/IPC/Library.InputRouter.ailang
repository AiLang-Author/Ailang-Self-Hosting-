LibraryImport.Display.Render.DRingTypes
LibraryImport.Display.Render.DRing1
LibraryImport.Display.Render.DRing0
LibraryImport.Display.Input.DInputTypes
LibraryImport.Display.Input.Cursor
LibraryImport.Focus

// =============================================================================
// ROUTER STATE
// alt_held and dirty live here; dirty is also mirrored in SysDisplayState
// for the main loop blit decision.
// =============================================================================
FixedPool.RouterState {
    "alt_held": Initialize=0
    "dirty":    Initialize=0
}

Function.InputRouter_Init {
    Output: Integer
    Body: {
        RouterState.alt_held = 0
        RouterState.dirty    = 0
        ReturnValue(1)
    }
}

// Returns 1 if ESC was pressed (quit signal), 0 otherwise.
Function.InputRouter_Drain {
    Output: Integer
    Body: {
        entry = Allocate(RingEntry.SIZE)
        quit  = 0

        WhileLoop EqualTo(Ring1_IsEmpty(), 0) {
            Ring1_Drain(entry)
            ev   = Dereference(Add(entry, RingEntry.TYPE))
            pa   = Dereference(Add(entry, RingEntry.PARAM_A))
            pb   = Dereference(Add(entry, RingEntry.PARAM_B))
            data = Dereference(Add(entry, RingEntry.PARAM_C))

            // KEY DOWN
            IfCondition EqualTo(ev, Ring1Event.KEY_DOWN) ThenBlock: {
                IfCondition EqualTo(pa, 56)      ThenBlock: { RouterState.alt_held = 1 }
                IfCondition EqualTo(pa, 100)     ThenBlock: { RouterState.alt_held = 1 }
                IfCondition EqualTo(pa, Key.ESC) ThenBlock: { quit = 1 }

                IfCondition EqualTo(RouterState.alt_held, 1) ThenBlock: {
                    // Alt+V — vertical split
                    IfCondition EqualTo(pa, 47) ThenBlock: {
                        PrintMessage("[Key] Alt+V\n")
                        Ring0_Post(Ring0Cmd.TILE_SPLIT_V, 0, 0, 0)
                        RouterState.dirty = 1
                    }
                    // Alt+H — horizontal split
                    IfCondition EqualTo(pa, 35) ThenBlock: {
                        PrintMessage("[Key] Alt+H\n")
                        Ring0_Post(Ring0Cmd.TILE_SPLIT_H, 0, 0, 0)
                        RouterState.dirty = 1
                    }
                    // Alt+M — merge
                    IfCondition EqualTo(pa, 50) ThenBlock: {
                        PrintMessage("[Key] Alt+M\n")
                        Ring0_Post(Ring0Cmd.TILE_MERGE, 0, 0, 0)
                        RouterState.dirty = 1
                    }
                } ElseBlock: {
                    IfCondition NotEqual(pa, Key.ESC) ThenBlock: {
                        consumed = Focus_KeyDown(pa, KeyMod.shift)
                        IfCondition EqualTo(consumed, 1) ThenBlock: {
                            RouterState.dirty = 1
                        }
                    }
                }
            }

            // KEY UP
            IfCondition EqualTo(ev, Ring1Event.KEY_UP) ThenBlock: {
                IfCondition EqualTo(pa, 56)  ThenBlock: { RouterState.alt_held = 0 }
                IfCondition EqualTo(pa, 100) ThenBlock: { RouterState.alt_held = 0 }
            }

            // MOUSE MOVE
            IfCondition EqualTo(ev, Ring1Event.MOUSE_MOVE) ThenBlock: {
                Cursor_SetPos(pa, pb)
                Focus_MouseMove(pa, pb)
                new_shape = Focus_GetCursorShape(pa, pb)
                Cursor_SetShape(new_shape)
                RouterState.dirty = 1
            }

            // MOUSE DOWN
            IfCondition EqualTo(ev, Ring1Event.MOUSE_DOWN) ThenBlock: {
                changed = Focus_MouseDown(pa, pb, data)
                IfCondition EqualTo(changed, 1) ThenBlock: {
                    RouterState.dirty = 1
                }
            }
        }

        Deallocate(entry, RingEntry.SIZE)
        ReturnValue(quit)
    }
}