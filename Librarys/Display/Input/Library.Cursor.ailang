//
// Library.Cursor.ailang
// Unified cursor interface — config, dispatch, draw
// Uses save/restore pattern to erase trail artifacts.

LibraryImport.Display.Render.DSurfaceTypes
LibraryImport.Display.Render.Framebuffer

FixedPool.CursorType {
    "BITMAP": Initialize=0
    "HVIF":   Initialize=1
}

FixedPool.CursorShape {
    "ARROW":     Initialize=0
    "BEAM":      Initialize=1
    "CROSSHAIR": Initialize=2
    "HAND":      Initialize=3
    "WAIT":      Initialize=4
}

FixedPool.CursorConfig {
    "type":      Initialize=0
    "shape":     Initialize=0
    "path":      Initialize=0
    "hotspot_x": Initialize=0
    "hotspot_y": Initialize=0
}

FixedPool.CursorState {
    "initialized":  Initialize=0
    "x":            Initialize=0
    "y":            Initialize=0
    "shape":        Initialize=0
    "black_mask":   Initialize=0
    "white_mask":   Initialize=0
    "mask_w":       Initialize=0
    "mask_h":       Initialize=0
    "mask_stride":  Initialize=0
    "hotspot_x":    Initialize=0
    "hotspot_y":    Initialize=0
    "scr_w":        Initialize=0
    "scr_h":        Initialize=0
    "save_buf":     Initialize=0   // saved pixels under cursor
    "save_x":       Initialize=0   // position we saved from
    "save_y":       Initialize=0
    "save_valid":   Initialize=0   // 1 = save_buf has valid data
    "hidden":       Initialize=0   // 1 = hide cursor (IPC canvas capture)
}

// =============================================================================
// CURSOR INIT
// =============================================================================
Function.Cursor_Init {
    Input:  scr_w: Integer
    Input:  scr_h: Integer
    Output: Integer
    Body: {
        DebugLog_Push("cu.ini", 6)
        CursorState.scr_w = scr_w
        CursorState.scr_h = scr_h
        CursorState.x     = Divide(scr_w, 2)
        CursorState.y     = Divide(scr_h, 2)
        CursorState.save_valid = 0

        ctype = CursorConfig.type
        shape = CursorConfig.shape
        CursorState.shape     = shape
        CursorState.hotspot_x = CursorConfig.hotspot_x
        CursorState.hotspot_y = CursorConfig.hotspot_y

        IfCondition EqualTo(ctype, CursorType.BITMAP) ThenBlock: {
            ok = CursorBitmap_Load(shape)
            IfCondition EqualTo(ok, 0) ThenBlock: {
                PrintMessage("[Cursor] ERROR: CursorBitmap_Load failed\n")
                ReturnValue(0)
            }
        }
        IfCondition EqualTo(ctype, CursorType.HVIF) ThenBlock: {
            PrintMessage("[Cursor] HVIF not yet implemented, falling back to bitmap\n")
            CursorConfig.type = CursorType.BITMAP
            ok = CursorBitmap_Load(shape)
            IfCondition EqualTo(ok, 0) ThenBlock: { ReturnValue(0) }
        }

        // Allocate save buffer: mask_w * mask_h * 4 bytes
        save_size = Multiply(Multiply(CursorState.mask_w, CursorState.mask_h), SurfaceConst.PIXEL_BYTES)
        DebugLog_Push("cu.ini.a", 8)
        CursorState.save_buf = Allocate(save_size)
        DebugLog_Push("cu.ini.A", 8)

        CursorState.initialized = 1
        PrintMessage("[Cursor] initialized\n")
        ReturnValue(1)
    }
}

// =============================================================================
// CURSOR SHUTDOWN
// =============================================================================
Function.Cursor_Shutdown {
    Output: Integer
    Body: {
        DebugLog_Push("cu.shut", 7)
        IfCondition EqualTo(CursorState.initialized, 0) ThenBlock: {
            ReturnValue(0)
        }
        // Restore saved pixels before shutdown so screen is clean
        IfCondition EqualTo(CursorState.save_valid, 1) ThenBlock: {
            Cursor_Restore()
        }
        CursorBitmap_Free()
        IfCondition NotEqual(CursorState.save_buf, 0) ThenBlock: {
            save_size = Multiply(Multiply(CursorState.mask_w, CursorState.mask_h), SurfaceConst.PIXEL_BYTES)
            DebugLog_Push("cu.sht.d", 8)
            Deallocate(CursorState.save_buf, save_size)
            DebugLog_Push("cu.sht.D", 8)
            CursorState.save_buf = 0
        }
        CursorState.initialized = 0
        ReturnValue(1)
    }
}

// =============================================================================
// SET POSITION
// =============================================================================
Function.Cursor_SetPos {
    Input: x: Integer
    Input: y: Integer
    Body: {
        DebugLog_Push("cu.pos", 6)
        CursorState.x = x
        CursorState.y = y
        ReturnValue(0)
    }
}

// =============================================================================
// SET SHAPE
// =============================================================================
Function.Cursor_SetShape {
    Input:  shape: Integer
    Output: Integer
    Body: {
        DebugLog_Push("cu.shp", 6)
        IfCondition EqualTo(CursorState.shape, shape) ThenBlock: {
            ReturnValue(1)
        }
        // Restore before changing shape so old cursor area is clean
        IfCondition EqualTo(CursorState.save_valid, 1) ThenBlock: {
            Cursor_Restore()
            CursorState.save_valid = 0
        }
        // Free old save buf
        IfCondition NotEqual(CursorState.save_buf, 0) ThenBlock: {
            save_size = Multiply(Multiply(CursorState.mask_w, CursorState.mask_h), SurfaceConst.PIXEL_BYTES)
            DebugLog_Push("cu.shp.d", 8)
            Deallocate(CursorState.save_buf, save_size)
            DebugLog_Push("cu.shp.D", 8)
            CursorState.save_buf = 0
        }
        CursorBitmap_Free()
        CursorState.shape = shape
        ok = CursorBitmap_Load(shape)
        IfCondition EqualTo(ok, 0) ThenBlock: { ReturnValue(0) }
        // Alloc new save buf for new shape size
        save_size = Multiply(Multiply(CursorState.mask_w, CursorState.mask_h), SurfaceConst.PIXEL_BYTES)
        DebugLog_Push("cu.shp.a", 8)
        CursorState.save_buf = Allocate(save_size)
        DebugLog_Push("cu.shp.A", 8)
        ReturnValue(1)
    }
}

// =============================================================================
// SAVE pixels currently under cursor rect into save_buf
// =============================================================================
Function.Cursor_Save {
    Output: Integer
    Body: {
        DebugLog_Push("cu.sav", 6)
        cx  = Subtract(CursorState.x, CursorState.hotspot_x)
        cy  = Subtract(CursorState.y, CursorState.hotspot_y)
        mw  = CursorState.mask_w
        mh  = CursorState.mask_h
        sw  = CursorState.scr_w
        sh  = CursorState.scr_h
        buf = FB_GetDrawBuffer()
        pit = FB.pitch
        dst = CursorState.save_buf

        row = 0
        WhileLoop LessThan(row, mh) {
            py = Add(cy, row)
            col = 0
            WhileLoop LessThan(col, mw) {
                px      = Add(cx, col)
                dst_off = Multiply(Add(Multiply(row, mw), col), SurfaceConst.PIXEL_BYTES)
                IfCondition And(GreaterEqual(px, 0), LessThan(px, sw)) ThenBlock: {
                    IfCondition And(GreaterEqual(py, 0), LessThan(py, sh)) ThenBlock: {
                        src_off = Add(Multiply(py, pit), Multiply(px, SurfaceConst.PIXEL_BYTES))
                        px32 = Dereference(Add(buf, src_off))
                        StoreValue(Add(dst, dst_off), px32)
                    }
                }
                col = Add(col, 1)
            }
            row = Add(row, 1)
        }

        CursorState.save_x     = cx
        CursorState.save_y     = cy
        CursorState.save_valid = 1
        ReturnValue(1)
    }
}

// =============================================================================
// RESTORE saved pixels back to framebuffer
// =============================================================================
Function.Cursor_Restore {
    Output: Integer
    Body: {
        DebugLog_Push("cu.rst", 6)
        IfCondition EqualTo(CursorState.save_valid, 0) ThenBlock: {
            ReturnValue(0)
        }
        cx  = CursorState.save_x
        cy  = CursorState.save_y
        mw  = CursorState.mask_w
        mh  = CursorState.mask_h
        sw  = CursorState.scr_w
        sh  = CursorState.scr_h
        buf = FB_GetDrawBuffer()
        pit = FB.pitch
        src = CursorState.save_buf

        row = 0
        WhileLoop LessThan(row, mh) {
            py = Add(cy, row)
            col = 0
            WhileLoop LessThan(col, mw) {
                px      = Add(cx, col)
                src_off = Multiply(Add(Multiply(row, mw), col), SurfaceConst.PIXEL_BYTES)
                IfCondition And(GreaterEqual(px, 0), LessThan(px, sw)) ThenBlock: {
                    IfCondition And(GreaterEqual(py, 0), LessThan(py, sh)) ThenBlock: {
                        dst_off = Add(Multiply(py, pit), Multiply(px, SurfaceConst.PIXEL_BYTES))
                        px32 = Dereference(Add(src, src_off))
                        StoreValue(Add(buf, dst_off), px32)
                    }
                }
                col = Add(col, 1)
            }
            row = Add(row, 1)
        }
        ReturnValue(1)
    }
}

// =============================================================================
// DRAW — restore old, save new, draw cursor
// Call after all surfaces blitted, before FB_FlipFast
// =============================================================================
Function.Cursor_Draw {
    Output: Integer
    Body: {
        DebugLog_Push("cu.drw", 6)
        IfCondition EqualTo(CursorState.initialized, 0) ThenBlock: {
            ReturnValue(0)
        }

        // Step 1: restore pixels at old cursor position
        Cursor_Restore()

        // If cursor is hidden (IPC canvas capture mode), skip drawing
        IfCondition EqualTo(CursorState.hidden, 1) ThenBlock: {
            CursorState.save_valid = 0
            ReturnValue(1)
        }

        // Step 2: save pixels at new cursor position
        Cursor_Save()

        // Step 3: draw cursor at new position
        cx = Subtract(CursorState.x, CursorState.hotspot_x)
        cy = Subtract(CursorState.y, CursorState.hotspot_y)

        IfCondition EqualTo(CursorState.black_mask, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(CursorState.white_mask, 0) ThenBlock: { ReturnValue(0) }

        Cursor_BlitMask(cx, cy, 0x000000, CursorState.black_mask)
        Cursor_BlitMask(cx, cy, 0xFFFFFF, CursorState.white_mask)
        ReturnValue(1)
    }
}

// =============================================================================
// BLIT ONE MASK to framebuffer back buffer
// =============================================================================
Function.Cursor_BlitMask {
    Input: cx:    Integer
    Input: cy:    Integer
    Input: color: Integer
    Input: mask:  Address
    Output: Integer
    Body: {
        DebugLog_Push("cu.blt", 6)
        buf    = FB_GetDrawBuffer()
        pitch  = FB.pitch
        sw     = CursorState.scr_w
        sh     = CursorState.scr_h
        mw     = CursorState.mask_w
        mh     = CursorState.mask_h
        stride = CursorState.mask_stride

        row = 0
        WhileLoop LessThan(row, mh) {
            py = Add(cy, row)
            IfCondition And(GreaterEqual(py, 0), LessThan(py, sh)) ThenBlock: {
                row_base = Multiply(row, stride)
                col = 0
                WhileLoop LessThan(col, mw) {
                    byte_idx = Divide(col, 8)
                    bit_idx  = Subtract(7, Modulo(col, 8))
                    b        = GetByte(mask, Add(row_base, byte_idx))
                    bit      = BitwiseAnd(ShiftRight(b, bit_idx), 1)
                    IfCondition NotEqual(bit, 0) ThenBlock: {
                        px = Add(cx, col)
                        IfCondition And(GreaterEqual(px, 0), LessThan(px, sw)) ThenBlock: {
                            off = Add(Multiply(py, pitch), Multiply(px, SurfaceConst.PIXEL_BYTES))
                            FB_Write32(buf, off, color)
                        }
                    }
                    col = Add(col, 1)
                }
            }
            row = Add(row, 1)
        }
        ReturnValue(1)
    }
}