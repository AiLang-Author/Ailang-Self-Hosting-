// ─── Library.CascadeMenu.ailang ─────────────────────────────────────────────
// Cascade submenu — opens to the right of the Start Menu when a category
// (Programs, System) is clicked. Follows Menu.ailang pattern: own AKContext,
// own surface, positioned overlay, blitted in Win_BlitAll.
// Copyright © 2026 Sean Collins, 2 Paws Machine and Engineering. SCSL.

LibraryImport.Display.Render.DSurfaceTypes
LibraryImport.Display.Render.DSurface
LibraryImport.Display.Render.DDrawPixel
LibraryImport.Display.UI.Auckland
LibraryImport.Display.UI.AucklandEvent
LibraryImport.Display.Window.WinManager
LibraryImport.Display.Render.Fonts
LibraryImport.Display.UI.TextRegion
LibraryImport.Display.System.SysDisplay
LibraryImport.Display.System.EventRouter
LibraryImport.Display.Theme.UIScale
LibraryImport.Display.Theme.UITheme
LibraryImport.Display.Menu.Deskbar
LibraryImport.Display.Menu.StartMenu
LibraryImport.Display.Render.VIcon
LibraryImport.Display.Render.SurfaceBlit
LibraryImport.StringUtils

// =============================================================================
// STATE
// =============================================================================
FixedPool.CascadeMenuState {
    "open":      Initialize=0,  CanChange=True
    "menu_id":   Initialize=-1, CanChange=True
    "surface":   Initialize=0,  CanChange=True
    "ak_ctx":    Initialize=0,  CanChange=True
    "screen_x":  Initialize=0,  CanChange=True
    "screen_y":  Initialize=0,  CanChange=True
    "width":     Initialize=0,  CanChange=True
    "height":    Initialize=0,  CanChange=True
}

// =============================================================================
// INIT
// =============================================================================
Function.CascadeMenu_Init {
    Output: Integer
    Body: {
        DebugLog_Push("cm.init", 7)
        CascadeMenuState.open    = 0
        CascadeMenuState.menu_id = -1
        CascadeMenuState.ak_ctx  = 0
        CascadeMenuState.surface = 0
        ReturnValue(1)
    }
}

// =============================================================================
// ADD ITEM — create BUTTON node with label + action, attach to parent
// =============================================================================
Function.CascadeMenu_AddItem {
    Input: ctx: LinkagePool.AKContext
    Input: parent: Integer
    Input: label_ptr: Integer
    Input: label_len: Integer
    Input: action_ptr: Integer
    Input: action_len: Integer
    Output: Integer
    Body: {
        w = StartMenuConst.ITEM_W
        h = StartMenuConst.ITEM_H
        btn = AK_CreateNode(ctx, AKTag.BUTTON)
        AK_Set(ctx, btn, AKF.WIDTH, w)
        AK_Set(ctx, btn, AKF.HEIGHT, h)
        AK_ExtraSet(ctx, btn, AKExtra.STR_PTR, label_ptr)
        AK_ExtraSet(ctx, btn, AKExtra.STR_LEN, label_len)
        AK_ExtraSet(ctx, btn, AKExtra.ACTION_PTR, action_ptr)
        AK_ExtraSet(ctx, btn, AKExtra.ACTION_LEN, action_len)
        AK_ExtraSet(ctx, btn, AKExtra.TEXT_ALIGN, TRAlign.LEFT)
        AK_ExtraSet(ctx, btn, AKExtra.COLOR_BG, StartMenuConst.BG)
        AK_ExtraSet(ctx, btn, AKExtra.COLOR_FG, StartMenuConst.FG)
        AK_AddChild(ctx, parent, btn)
        ReturnValue(btn)
    }
}

// =============================================================================
// ADD SEPARATOR
// =============================================================================
Function.CascadeMenu_AddSeparator {
    Input: ctx: LinkagePool.AKContext
    Input: parent: Integer
    Body: {
        w = StartMenuConst.ITEM_W
        sep = AK_CreateNode(ctx, AKTag.SEPARATOR)
        AK_Set(ctx, sep, AKF.HEIGHT, UIScale.ak_separator_w)
        AK_Set(ctx, sep, AKF.WIDTH, w)
        AK_ExtraSet(ctx, sep, AKExtra.COLOR_FG, StartMenuConst.SEP_CLR)
        AK_AddChild(ctx, parent, sep)
    }
}

// =============================================================================
// COMPUTE HEIGHT — sum item heights + padding
// =============================================================================
Function.CascadeMenu_ComputeHeight {
    Input: ctx: LinkagePool.AKContext
    Input: root: Integer
    Output: Integer
    Body: {
        h = Multiply(StartMenuConst.PAD, 2)
        child = AK_Get(ctx, root, AKF.FIRST_CHILD)
        guard = 0
        WhileLoop NotEqual(child, -1) {
            guard = Add(guard, 1)
            IfCondition GreaterThan(guard, 64) ThenBlock: { ReturnValue(h) }
            tag = AK_Get(ctx, child, AKF.TAG)
            IfCondition EqualTo(tag, AKTag.SEPARATOR) ThenBlock: {
                h = Add(h, UIScale.ak_separator_w)
            } ElseBlock: {
                h = Add(h, StartMenuConst.ITEM_H)
            }
            child = AK_Get(ctx, child, AKF.NEXT_SIBLING)
        }
        ReturnValue(h)
    }
}

// =============================================================================
// BUILD PROGRAMS — app services from deskbar cache
// =============================================================================
Function.CascadeMenu_BuildPrograms {
    Input: ctx: LinkagePool.AKContext
    Input: root: Integer
    Body: {
        sc = DeskbarState.svc_count

        // Rasterize icons at menu item size (fits within ITEM_H with padding)
        old_icon_sz = VIconState.render_size
        icon_sz = Subtract(StartMenuConst.ITEM_H, UIScale.menu_icon_inset)
        IfCondition LessThan(icon_sz, UIScale.menu_icon_min_sz) ThenBlock: { icon_sz = UIScale.menu_icon_min_sz }
        VIcon_SetSize(icon_sz)

        si = 0
        WhileLoop LessThan(si, sc) {
            off = Multiply(si, 8)
            s_name = Dereference(Add(DeskbarState.svc_names, off))
            s_nlen = Dereference(Add(DeskbarState.svc_name_lens, off))

            action = Deskbar_BuildSvcAction(si)
            action_len = StringLength(action)

            btn = CascadeMenu_AddItem(ctx, root, s_name, s_nlen, action, action_len)

            // Resolve icon at menu size and set on button via ICON_SURF
            IfCondition GreaterEqual(btn, 0) ThenBlock: {
                iname = Dereference(Add(DeskbarState.svc_icon_names, off))
                ilen  = Dereference(Add(DeskbarState.svc_icon_nlens, off))
                icon_surf = 0
                IfCondition GreaterThan(ilen, 0) ThenBlock: {
                    icon_surf = VIcon_Resolve(iname)
                }
                IfCondition EqualTo(icon_surf, 0) ThenBlock: {
                    icon_surf = VIcon_Resolve("gear")
                }
                IfCondition NotEqual(icon_surf, 0) ThenBlock: {
                    AK_ExtraSet(ctx, btn, AKExtra.ICON_SURF, icon_surf)
                }
            }

            si = Add(si, 1)
        }

        // Built-in Auckland apps (not yet in services table)
        CascadeMenu_AddItem(ctx, root, "Telegram", 8, "app.telegram", 12)

        // Restore previous VIcon size
        VIcon_SetSize(old_icon_sz)
    }
}

// =============================================================================
// BUILD SYSTEM — hardcoded system items
// =============================================================================
Function.CascadeMenu_BuildSystem {
    Input: ctx: LinkagePool.AKContext
    Input: root: Integer
    Body: {
        CascadeMenu_AddItem(ctx, root, "About", 5, "app.about", 9)
        CascadeMenu_AddItem(ctx, root, "Screenshot", 10, "sys.screenshot", 14)
        CascadeMenu_AddSeparator(ctx, root)
        CascadeMenu_AddItem(ctx, root, "Dark Theme", 10, "sys.theme.dark", 14)
        CascadeMenu_AddItem(ctx, root, "Light Theme", 11, "sys.theme.light", 15)
        CascadeMenu_AddSeparator(ctx, root)
        CascadeMenu_AddItem(ctx, root, "Reboot", 6, "sys.reboot", 10)
        CascadeMenu_AddItem(ctx, root, "Shutdown", 8, "sys.shutdown", 12)
    }
}

// =============================================================================
// RENDER — fill bg + AK_Draw
// =============================================================================
Function.CascadeMenu_Render {
    Input: ctx: LinkagePool.AKContext
    Input: surf: Integer
    Input: w: Integer
    Input: h: Integer
    Body: {
        DebugLog_Push("cm.ren", 6)
        Draw_Pix_FillRect(surf, 0, 0, w, h, StartMenuConst.BG)
        VFont_UseSize(UIScale.font_menu)
        AK_Draw(ctx, surf, w, h)
        VFont_UseSize(UIScale.font_body)
    }
}

// =============================================================================
// SHOW — open cascade submenu at anchor position
// =============================================================================
Function.CascadeMenu_Show {
    Input: menu_id: Integer
    Input: anchor_x: Integer
    Input: anchor_y: Integer
    Output: Integer
    Body: {
        DebugLog_Push("cm.show", 7)

        // Toggle: if same menu_id already open, close it
        IfCondition EqualTo(CascadeMenuState.open, 1) ThenBlock: {
            IfCondition EqualTo(CascadeMenuState.menu_id, menu_id) ThenBlock: {
                CascadeMenu_Close()
                ReturnValue(0)
            }
            // Different menu — close old first
            CascadeMenu_Close()
        }

        // Free leftover context if any
        old_ctx = CascadeMenuState.ak_ctx
        IfCondition NotEqual(old_ctx, 0) ThenBlock: {
            AK_DestroyContext(old_ctx)
            CascadeMenuState.ak_ctx = 0
        }

        // Create AKContext
        ak_ctx = AK_CreateContext()
        IfCondition EqualTo(ak_ctx, 0) ThenBlock: {
            PrintMessage("[CascadeMenu] AKContext alloc failed\n")
            ReturnValue(0)
        }
        CascadeMenuState.ak_ctx = ak_ctx

        // Build tree — PANEL root with VBOX layout
        root = AK_CreateNode(ak_ctx, AKTag.PANEL)
        AK_Set(ak_ctx, root, AKF.LAYOUT_MODE, AKLayout.VBOX)
        AK_Set(ak_ctx, root, AKF.GAP, 0)
        AK_Set(ak_ctx, root, AKF.PAD_T, StartMenuConst.PAD)
        AK_Set(ak_ctx, root, AKF.PAD_R, StartMenuConst.PAD)
        AK_Set(ak_ctx, root, AKF.PAD_B, StartMenuConst.PAD)
        AK_Set(ak_ctx, root, AKF.PAD_L, StartMenuConst.PAD)
        AK_ExtraSet(ak_ctx, root, AKExtra.COLOR_BG, StartMenuConst.BG)
        AK_ExtraSet(ak_ctx, root, AKExtra.BORDER_W, UIScale.menu_border_w)
        AK_ExtraSet(ak_ctx, root, AKExtra.BORDER_CLR, StartMenuConst.SEP_CLR)
        AK_SetRoot(ak_ctx, root)

        // Dispatch to builder
        IfCondition EqualTo(menu_id, 0) ThenBlock: {
            CascadeMenu_BuildPrograms(ak_ctx, root)
        }
        IfCondition EqualTo(menu_id, 1) ThenBlock: {
            CascadeMenu_BuildSystem(ak_ctx, root)
        }

        // Compute surface size
        menu_w = Add(StartMenuConst.ITEM_W, Multiply(StartMenuConst.PAD, 2))
        menu_h = CascadeMenu_ComputeHeight(ak_ctx, root)

        // Create surface
        surf = Surface_Create(SurfaceFormat.PIXEL_32, menu_w, menu_h)
        IfCondition EqualTo(surf, 0) ThenBlock: {
            PrintMessage("[CascadeMenu] surface alloc failed\n")
            AK_DestroyContext(ak_ctx)
            CascadeMenuState.ak_ctx = 0
            ReturnValue(0)
        }

        // Set design dimensions
        AK_SetDesignW(ak_ctx, menu_w)
        AK_SetDesignH(ak_ctx, menu_h)

        // Store menu_id before render so icon overlay can check it
        CascadeMenuState.menu_id = menu_id

        // Render
        CascadeMenu_Render(ak_ctx, surf, menu_w, menu_h)

        // Position: anchor_x, anchor_y (caller provides right edge of parent)
        scr_x = anchor_x
        scr_y = anchor_y

        // Edge clamping: if goes off right, flip to left of parent
        scr_w = SysDisplayState.scr_w
        IfCondition GreaterThan(Add(scr_x, menu_w), scr_w) ThenBlock: {
            // Flip left: parent_x - menu_w - gap
            // anchor_x is parent_right + gap, so parent_right = anchor_x - 2
            // parent_left = parent_right - parent_w
            parent_w = StartMenuState.width
            scr_x = Subtract(Subtract(anchor_x, UIScale.cascade_menu_gap), Add(parent_w, menu_w))
            IfCondition LessThan(scr_x, 0) ThenBlock: { scr_x = 0 }
        }

        // Clamp bottom
        scr_h = SysDisplayState.scr_h
        IfCondition GreaterThan(Add(scr_y, menu_h), scr_h) ThenBlock: {
            scr_y = Subtract(scr_h, menu_h)
            IfCondition LessThan(scr_y, 0) ThenBlock: { scr_y = 0 }
        }

        CascadeMenuState.surface  = surf
        CascadeMenuState.width    = menu_w
        CascadeMenuState.height   = menu_h
        CascadeMenuState.screen_x = scr_x
        CascadeMenuState.screen_y = scr_y
        CascadeMenuState.menu_id  = menu_id
        CascadeMenuState.open     = 1

        SysDisplayState.dirty = 1

        PrintMessage("[CascadeMenu] opened id=")
        PrintNumber(menu_id)
        PrintMessage(" size=")
        PrintNumber(menu_w)
        PrintMessage("x")
        PrintNumber(menu_h)
        PrintMessage(" at ")
        PrintNumber(scr_x)
        PrintMessage(",")
        PrintNumber(scr_y)
        PrintMessage("\n")
        ReturnValue(1)
    }
}

// =============================================================================
// CLOSE
// =============================================================================
Function.CascadeMenu_Close {
    Body: {
        DebugLog_Push("cm.cls", 6)
        IfCondition EqualTo(CascadeMenuState.open, 0) ThenBlock: { ReturnValue(0) }

        surf = CascadeMenuState.surface
        IfCondition NotEqual(surf, 0) ThenBlock: {
            Surface_Destroy(surf)
            CascadeMenuState.surface = 0
        }

        ak_ctx = CascadeMenuState.ak_ctx
        IfCondition NotEqual(ak_ctx, 0) ThenBlock: {
            AK_DestroyContext(ak_ctx)
            CascadeMenuState.ak_ctx = 0
        }

        CascadeMenuState.open    = 0
        CascadeMenuState.menu_id = -1
        SysDisplayState.dirty = 1
    }
}

// =============================================================================
// HIT TEST
// =============================================================================
Function.CascadeMenu_HitTest {
    Input: mx: Integer
    Input: my: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(CascadeMenuState.open, 0) ThenBlock: { ReturnValue(0) }
        sx = CascadeMenuState.screen_x
        sy = CascadeMenuState.screen_y
        w  = CascadeMenuState.width
        h  = CascadeMenuState.height
        IfCondition And(
            And(GreaterEqual(mx, sx), LessThan(mx, Add(sx, w))),
            And(GreaterEqual(my, sy), LessThan(my, Add(sy, h)))
        ) ThenBlock: {
            ReturnValue(1)
        }
        ReturnValue(0)
    }
}

// =============================================================================
// EVENT — dispatch mouse into cascade AKContext
// =============================================================================
Function.CascadeMenu_Event {
    Input: screen_x: Integer
    Input: screen_y: Integer
    Input: mouse_ev: Integer
    Output: Integer
    Body: {
        DebugLog_Push("cm.evt", 6)
        IfCondition EqualTo(CascadeMenuState.open, 0) ThenBlock: { ReturnValue(0) }
        ak_ctx = CascadeMenuState.ak_ctx
        IfCondition EqualTo(ak_ctx, 0) ThenBlock: { ReturnValue(0) }
        surf = CascadeMenuState.surface
        IfCondition EqualTo(surf, 0) ThenBlock: { ReturnValue(0) }

        local_x = Subtract(screen_x, CascadeMenuState.screen_x)
        local_y = Subtract(screen_y, CascadeMenuState.screen_y)

        AK_SetActionCb(ak_ctx, AddressOf(EventRouter_NoOpCallback))
        AK_EventMouse(ak_ctx, local_x, local_y, mouse_ev, 0)

        // Redraw on hover/pressed state changes
        IfCondition GreaterThan(AK_GetDirtyCount(ak_ctx), 0) ThenBlock: {
            CascadeMenu_Render(ak_ctx, surf, CascadeMenuState.width, CascadeMenuState.height)
            AK_SetDirtyCount(ak_ctx, 0)
            SysDisplayState.dirty = 1
        }

        // Capture fired action on UP
        fired_ptr = 0
        fired_len = 0
        IfCondition EqualTo(mouse_ev, AKMouseEv.UP) ThenBlock: {
            fn = AK_GetFocusNode(ak_ctx)
            IfCondition GreaterEqual(fn, 0) ThenBlock: {
                ap = AK_ExtraGet(ak_ctx, fn, AKExtra.ACTION_PTR)
                al = AK_ExtraGet(ak_ctx, fn, AKExtra.ACTION_LEN)
                IfCondition And(NotEqual(ap, 0), GreaterThan(al, 0)) ThenBlock: {
                    fired_ptr = ap
                    fired_len = al
                }
            }
        }

        // Push action and close entire menu stack
        IfCondition NotEqual(fired_ptr, 0) ThenBlock: {
            EventRouter_Push(fired_ptr, fired_len, 0)
            CascadeMenu_Close()
            StartMenu_Close()
        }

        ReturnValue(0)
    }
}

// =============================================================================
// BLIT — draw cascade surface to framebuffer
// =============================================================================
Function.CascadeMenu_Blit {
    Body: {
        IfCondition EqualTo(CascadeMenuState.open, 0) ThenBlock: { ReturnValue(0) }
        surf = CascadeMenuState.surface
        IfCondition EqualTo(surf, 0) ThenBlock: { ReturnValue(0) }
        Win_BlitOne(surf, CascadeMenuState.screen_x, CascadeMenuState.screen_y)
    }
}
