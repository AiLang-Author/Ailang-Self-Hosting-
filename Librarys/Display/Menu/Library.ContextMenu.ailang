// ─── Library.ContextMenu.ailang ──────────────────────────────────────────────
// Right-click context menu for TEXTFIELDs — Cut, Copy, Paste, Select All.
// Follows CascadeMenu pattern: own AKContext, own surface, positioned overlay.
// Copyright © 2026 Sean Collins, 2 Paws Machine and Engineering. SCSL.

LibraryImport.Display.Render.DSurfaceTypes
LibraryImport.Display.Render.DSurface
LibraryImport.Display.Render.DDrawPixel
LibraryImport.Display.UI.Auckland
LibraryImport.Display.UI.AucklandEvent
LibraryImport.Display.Window.WinManager
LibraryImport.Display.Render.Fonts
LibraryImport.Display.UI.TextRegion
LibraryImport.Display.System.SysDisplay
LibraryImport.Display.System.EventRouter
LibraryImport.Display.Theme.UIScale
LibraryImport.Display.Theme.UITheme
LibraryImport.Display.Render.SurfaceBlit
LibraryImport.TextBuffer

// =============================================================================
// STATE
// =============================================================================
FixedPool.CtxMenuState {
    "open":        Initialize=0,  CanChange=True
    "surface":     Initialize=0,  CanChange=True
    "ak_ctx":      Initialize=0,  CanChange=True
    "screen_x":    Initialize=0,  CanChange=True
    "screen_y":    Initialize=0,  CanChange=True
    "width":       Initialize=0,  CanChange=True
    "height":      Initialize=0,  CanChange=True
    "source_win":  Initialize=0,  CanChange=True
    "source_ctx":  Initialize=0,  CanChange=True
    "source_node": Initialize=-1, CanChange=True
    "skip_up":     Initialize=0,  CanChange=True
}

// Menu item dimensions
FixedPool.CtxMenuConst {
    "ITEM_W":  Initialize=180
    "ITEM_H":  Initialize=26
    "PAD":     Initialize=4
    "BG":      Initialize=0xFF0E1730
    "FG":      Initialize=0xFFE8EEF8
    "SEP_CLR": Initialize=0xFF2A4068
}

// =============================================================================
// INIT
// =============================================================================
Function.ContextMenu_Init {
    Output: Integer
    Body: {
        CtxMenuState.open        = 0
        CtxMenuState.ak_ctx      = 0
        CtxMenuState.surface     = 0
        CtxMenuState.source_node = Negate(1)
        ReturnValue(1)
    }
}

// =============================================================================
// ADD ITEM — create BUTTON node with label + action
// =============================================================================
Function.ContextMenu_AddItem {
    Input: ctx: LinkagePool.AKContext
    Input: parent: Integer
    Input: label_ptr: Integer
    Input: label_len: Integer
    Input: action_ptr: Integer
    Input: action_len: Integer
    Output: Integer
    Body: {
        w = CtxMenuConst.ITEM_W
        h = CtxMenuConst.ITEM_H
        btn = AK_CreateNode(ctx, AKTag.BUTTON)
        AK_Set(ctx, btn, AKF.WIDTH, w)
        AK_Set(ctx, btn, AKF.HEIGHT, h)
        AK_ExtraSet(ctx, btn, AKExtra.STR_PTR, label_ptr)
        AK_ExtraSet(ctx, btn, AKExtra.STR_LEN, label_len)
        AK_ExtraSet(ctx, btn, AKExtra.ACTION_PTR, action_ptr)
        AK_ExtraSet(ctx, btn, AKExtra.ACTION_LEN, action_len)
        AK_ExtraSet(ctx, btn, AKExtra.TEXT_ALIGN, TRAlign.LEFT)
        AK_ExtraSet(ctx, btn, AKExtra.COLOR_BG, CtxMenuConst.BG)
        AK_ExtraSet(ctx, btn, AKExtra.COLOR_FG, CtxMenuConst.FG)
        AK_AddChild(ctx, parent, btn)
        ReturnValue(btn)
    }
}

// =============================================================================
// ADD SEPARATOR
// =============================================================================
Function.ContextMenu_AddSep {
    Input: ctx: LinkagePool.AKContext
    Input: parent: Integer
    Body: {
        w = CtxMenuConst.ITEM_W
        sep = AK_CreateNode(ctx, AKTag.SEPARATOR)
        AK_Set(ctx, sep, AKF.HEIGHT, UIScale.ak_separator_w)
        AK_Set(ctx, sep, AKF.WIDTH, w)
        AK_ExtraSet(ctx, sep, AKExtra.COLOR_FG, CtxMenuConst.SEP_CLR)
        AK_AddChild(ctx, parent, sep)
    }
}

// =============================================================================
// BUILD — add Cut/Copy/Paste/Select All items
// =============================================================================
Function.ContextMenu_Build {
    Input: ctx: LinkagePool.AKContext
    Input: root: Integer
    Body: {
        ContextMenu_AddItem(ctx, root, "Cut        Ctrl+X", 18, "ctx.cut", 7)
        ContextMenu_AddItem(ctx, root, "Copy       Ctrl+C", 18, "ctx.copy", 8)
        ContextMenu_AddItem(ctx, root, "Paste      Ctrl+V", 18, "ctx.paste", 9)
        ContextMenu_AddSep(ctx, root)
        ContextMenu_AddItem(ctx, root, "Select All Ctrl+A", 18, "ctx.selall", 10)
    }
}

// =============================================================================
// COMPUTE HEIGHT
// =============================================================================
Function.ContextMenu_ComputeH {
    Input: ctx: LinkagePool.AKContext
    Input: root: Integer
    Output: Integer
    Body: {
        h = Multiply(CtxMenuConst.PAD, 2)
        child = AK_Get(ctx, root, AKF.FIRST_CHILD)
        guard = 0
        WhileLoop NotEqual(child, -1) {
            guard = Add(guard, 1)
            IfCondition GreaterThan(guard, 32) ThenBlock: { ReturnValue(h) }
            tag = AK_Get(ctx, child, AKF.TAG)
            IfCondition EqualTo(tag, AKTag.SEPARATOR) ThenBlock: {
                h = Add(h, UIScale.ak_separator_w)
            } ElseBlock: {
                h = Add(h, CtxMenuConst.ITEM_H)
            }
            child = AK_Get(ctx, child, AKF.NEXT_SIBLING)
        }
        ReturnValue(h)
    }
}

// =============================================================================
// RENDER — fill bg + AK_Draw
// =============================================================================
Function.ContextMenu_Render {
    Input: ctx: LinkagePool.AKContext
    Input: surf: Integer
    Input: w: Integer
    Input: h: Integer
    Body: {
        Draw_Pix_FillRect(surf, 0, 0, w, h, CtxMenuConst.BG)
        VFont_UseSize(UIScale.font_menu)
        AK_Draw(ctx, surf, w, h)
        VFont_UseSize(UIScale.font_body)
    }
}

// =============================================================================
// SHOW — open context menu at screen position
// =============================================================================
Function.ContextMenu_Show {
    Input: scr_x: Integer
    Input: scr_y: Integer
    Output: Integer
    Body: {
        // Close any existing context menu
        IfCondition EqualTo(CtxMenuState.open, 1) ThenBlock: {
            ContextMenu_Close()
        }

        // Create AKContext
        ak_ctx = AK_CreateContext()
        IfCondition EqualTo(ak_ctx, 0) ThenBlock: {
            PrintMessage("[CtxMenu] AKContext alloc failed\n")
            ReturnValue(0)
        }
        CtxMenuState.ak_ctx = ak_ctx

        // Build tree — PANEL root with VBOX layout
        root = AK_CreateNode(ak_ctx, AKTag.PANEL)
        AK_Set(ak_ctx, root, AKF.LAYOUT_MODE, AKLayout.VBOX)
        AK_Set(ak_ctx, root, AKF.GAP, 0)
        AK_Set(ak_ctx, root, AKF.PAD_T, CtxMenuConst.PAD)
        AK_Set(ak_ctx, root, AKF.PAD_R, CtxMenuConst.PAD)
        AK_Set(ak_ctx, root, AKF.PAD_B, CtxMenuConst.PAD)
        AK_Set(ak_ctx, root, AKF.PAD_L, CtxMenuConst.PAD)
        AK_ExtraSet(ak_ctx, root, AKExtra.COLOR_BG, CtxMenuConst.BG)
        AK_ExtraSet(ak_ctx, root, AKExtra.BORDER_W, UIScale.menu_border_w)
        AK_ExtraSet(ak_ctx, root, AKExtra.BORDER_CLR, CtxMenuConst.SEP_CLR)
        AK_SetRoot(ak_ctx, root)

        // Add menu items
        ContextMenu_Build(ak_ctx, root)

        // Compute surface size
        menu_w = Add(CtxMenuConst.ITEM_W, Multiply(CtxMenuConst.PAD, 2))
        menu_h = ContextMenu_ComputeH(ak_ctx, root)

        // Create surface
        surf = Surface_Create(SurfaceFormat.PIXEL_32, menu_w, menu_h)
        IfCondition EqualTo(surf, 0) ThenBlock: {
            AK_DestroyContext(ak_ctx)
            CtxMenuState.ak_ctx = 0
            ReturnValue(0)
        }

        // Set design dimensions and render
        AK_SetDesignW(ak_ctx, menu_w)
        AK_SetDesignH(ak_ctx, menu_h)
        ContextMenu_Render(ak_ctx, surf, menu_w, menu_h)

        // Edge clamping
        IfCondition GreaterThan(Add(scr_x, menu_w), SysDisplayState.scr_w) ThenBlock: {
            scr_x = Subtract(SysDisplayState.scr_w, menu_w)
        }
        IfCondition GreaterThan(Add(scr_y, menu_h), SysDisplayState.scr_h) ThenBlock: {
            scr_y = Subtract(SysDisplayState.scr_h, menu_h)
        }
        IfCondition LessThan(scr_x, 0) ThenBlock: { scr_x = 0 }
        IfCondition LessThan(scr_y, 0) ThenBlock: { scr_y = 0 }

        CtxMenuState.surface  = surf
        CtxMenuState.width    = menu_w
        CtxMenuState.height   = menu_h
        CtxMenuState.screen_x = scr_x
        CtxMenuState.screen_y = scr_y
        CtxMenuState.open     = 1
        CtxMenuState.skip_up  = 1

        SysDisplayState.dirty = 1
        ReturnValue(1)
    }
}

// =============================================================================
// CLOSE
// =============================================================================
Function.ContextMenu_Close {
    Body: {
        IfCondition EqualTo(CtxMenuState.open, 0) ThenBlock: { ReturnValue(0) }

        surf = CtxMenuState.surface
        IfCondition NotEqual(surf, 0) ThenBlock: {
            Surface_Destroy(surf)
            CtxMenuState.surface = 0
        }

        ak_ctx = CtxMenuState.ak_ctx
        IfCondition NotEqual(ak_ctx, 0) ThenBlock: {
            AK_DestroyContext(ak_ctx)
            CtxMenuState.ak_ctx = 0
        }

        CtxMenuState.open        = 0
        CtxMenuState.source_node = Negate(1)
        SysDisplayState.dirty = 1
    }
}

// =============================================================================
// HIT TEST
// =============================================================================
Function.ContextMenu_HitTest {
    Input: mx: Integer
    Input: my: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(CtxMenuState.open, 0) ThenBlock: { ReturnValue(0) }
        sx = CtxMenuState.screen_x
        sy = CtxMenuState.screen_y
        w  = CtxMenuState.width
        h  = CtxMenuState.height
        IfCondition And(
            And(GreaterEqual(mx, sx), LessThan(mx, Add(sx, w))),
            And(GreaterEqual(my, sy), LessThan(my, Add(sy, h)))
        ) ThenBlock: {
            ReturnValue(1)
        }
        ReturnValue(0)
    }
}

// =============================================================================
// EVENT — dispatch mouse into context menu AKContext
// =============================================================================
Function.ContextMenu_Event {
    Input: screen_x: Integer
    Input: screen_y: Integer
    Input: mouse_ev: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(CtxMenuState.open, 0) ThenBlock: { ReturnValue(0) }
        ak_ctx = CtxMenuState.ak_ctx
        IfCondition EqualTo(ak_ctx, 0) ThenBlock: { ReturnValue(0) }
        surf = CtxMenuState.surface
        IfCondition EqualTo(surf, 0) ThenBlock: { ReturnValue(0) }

        local_x = Subtract(screen_x, CtxMenuState.screen_x)
        local_y = Subtract(screen_y, CtxMenuState.screen_y)

        IfCondition EqualTo(mouse_ev, AKMouseEv.DOWN) ThenBlock: { DebugLog_Push("cx.DN", 5) }
        IfCondition EqualTo(mouse_ev, AKMouseEv.UP) ThenBlock: { DebugLog_Push("cx.UP!", 6) }
        AK_SetActionCb(ak_ctx, AddressOf(EventRouter_NoOpCallback))
        AK_EventMouse(ak_ctx, local_x, local_y, mouse_ev, 0)

        // Redraw on hover/pressed state changes
        IfCondition GreaterThan(AK_GetDirtyCount(ak_ctx), 0) ThenBlock: {
            ContextMenu_Render(ak_ctx, surf, CtxMenuState.width, CtxMenuState.height)
            AK_SetDirtyCount(ak_ctx, 0)
            SysDisplayState.dirty = 1
        }

        // Capture fired action on UP
        // NOTE: skip_up for right-button release is handled at SysDisplay level
        // (line 1517) — it never routes here when skip_up=1, so we don't check it.
        IfCondition EqualTo(mouse_ev, AKMouseEv.UP) ThenBlock: {
            fn = AK_GetFocusNode(ak_ctx)
            IfCondition GreaterEqual(fn, 0) ThenBlock: {
                DebugLog_Push("cx.fY", 5)
                ap = AK_ExtraGet(ak_ctx, fn, AKExtra.ACTION_PTR)
                al = AK_ExtraGet(ak_ctx, fn, AKExtra.ACTION_LEN)
                IfCondition And(NotEqual(ap, 0), GreaterThan(al, 0)) ThenBlock: {
                    DebugLog_Push("cx.FR", 5)
                    ContextMenu_FireAction(ap, al)
                } ElseBlock: {
                    DebugLog_Push("cx.nA", 5)
                }
            } ElseBlock: {
                DebugLog_Push("cx.nF", 5)
            }
            ContextMenu_Close()
        }

        ReturnValue(0)
    }
}

// =============================================================================
// FIRE ACTION — execute clipboard operation on source textfield
// =============================================================================
Function.ContextMenu_FireAction {
    Input: action_ptr: Integer
    Input: action_len: Integer
    Body: {
        DebugLog_Push("cx.FA", 5)
        src_ctx = CtxMenuState.source_ctx
        src_node = CtxMenuState.source_node
        IfCondition EqualTo(src_ctx, 0) ThenBlock: { DebugLog_Push("cx.!c", 5)  ReturnValue(0) }
        IfCondition LessThan(src_node, 0) ThenBlock: { DebugLog_Push("cx.!n", 5)  ReturnValue(0) }
        tbh = AK_ExtraGet(src_ctx, src_node, AKExtra.TEXTBUF_H)
        IfCondition LessThan(tbh, 0) ThenBlock: { DebugLog_Push("cx.!t", 5)  ReturnValue(0) }
        DebugLog_Push("cx.ok", 5)

        // Compare action string to determine operation
        // "ctx.cut"    = 7 chars
        // "ctx.copy"   = 8 chars
        // "ctx.paste"  = 9 chars
        // "ctx.selall" = 10 chars
        IfCondition EqualTo(action_len, 8) ThenBlock: {
            // ctx.copy
            DebugLog_Push("cx.CP", 5)
            AK_CopySelection(src_ctx, src_node, tbh)
            IfCondition GreaterThan(Clipboard.len, 0) ThenBlock: {
                DebugLog_Push("cb.OK", 5)
            } ElseBlock: {
                DebugLog_Push("cb.E!", 5)
            }
        }
        IfCondition EqualTo(action_len, 7) ThenBlock: {
            // ctx.cut — copy then delete
            DebugLog_Push("cx.CU", 5)
            AK_CopySelection(src_ctx, src_node, tbh)
            AK_DeleteSelection(src_ctx, src_node, tbh)
            AK_ClearSelection(src_ctx, src_node)
        }
        IfCondition EqualTo(action_len, 9) ThenBlock: {
            // ctx.paste
            DebugLog_Push("cx.PA", 5)
            AK_EditDeleteSelIfAny(src_ctx, src_node, tbh)
            clip_ptr = Clipboard_Get()
            clip_len = Clipboard.len
            IfCondition GreaterThan(clip_len, 0) ThenBlock: {
                DebugLog_Push("cb.OK", 5)
            } ElseBlock: {
                DebugLog_Push("cb.0!", 5)
            }
            IfCondition And(NotEqual(clip_ptr, 0), GreaterThan(clip_len, 0)) ThenBlock: {
                DebugLog_Push("cx.IN", 5)
                TextBuf_InsertString(tbh, clip_ptr, clip_len)
            } ElseBlock: {
                DebugLog_Push("cx.E!", 5)
            }
        }
        IfCondition EqualTo(action_len, 10) ThenBlock: {
            // ctx.selall
            DebugLog_Push("cx.SA", 5)
            ContextMenu_DoSelAll(src_ctx, src_node, tbh)
        }

        // Mark source widget dirty for redraw
        DebugLog_Push("cx.RD", 5)
        AK_Set(src_ctx, src_node, AKF.DIRTY, 1)
        ContextMenu_RedrawSource()
        ReturnValue(0)
    }
}

// =============================================================================
// DO SELECT ALL — separate function to keep FireAction locals low
// =============================================================================
Function.ContextMenu_DoSelAll {
    Input: ctx: LinkagePool.AKContext
    Input: node: Integer
    Input: tbh: Integer
    Body: {
        last_row = Subtract(TextBuf_GetLineCount(tbh), 1)
        IfCondition LessThan(last_row, 0) ThenBlock: { last_row = 0 }
        last_line = TextBuf_GetLine(tbh, last_row)
        last_col = 0
        IfCondition NotEqual(last_line, 0) ThenBlock: {
            last_col = StringLength(last_line)
        }
        AK_ExtraSet(ctx, node, AKExtra.SEL_START_ROW, 0)
        AK_ExtraSet(ctx, node, AKExtra.SEL_START_COL, 0)
        AK_ExtraSet(ctx, node, AKExtra.SEL_END_ROW, last_row)
        AK_ExtraSet(ctx, node, AKExtra.SEL_END_COL, last_col)
        TextBuf_SetCursor(tbh, last_row, last_col)
    }
}

// =============================================================================
// REDRAW SOURCE — re-render source window's content after clipboard op
// =============================================================================
Function.ContextMenu_RedrawSource {
    Body: {
        src_win = CtxMenuState.source_win
        IfCondition LessEqual(src_win, 0) ThenBlock: { ReturnValue(0) }
        src_ctx = CtxMenuState.source_ctx
        IfCondition EqualTo(src_ctx, 0) ThenBlock: { ReturnValue(0) }
        surf = WinMgr_GetContent(src_win)
        IfCondition EqualTo(surf, 0) ThenBlock: { ReturnValue(0) }
        cw = Win_GetCanvasW(src_win)
        ch = Win_GetCanvasH(src_win)
        AK_SetDesignW(src_ctx, cw)
        AK_SetDesignH(src_ctx, ch)
        AK_Draw(src_ctx, surf, cw, ch)
        SysDisplayState.dirty = 1
    }
}

// =============================================================================
// HANDLE RIGHT CLICK — find window + textfield, show menu
// =============================================================================
Function.ContextMenu_HandleRightClick {
    Input: mx: Integer
    Input: my: Integer
    Body: {
        // Find which window was clicked
        win_idx = Win_HitTest(mx, my)
        IfCondition LessThan(win_idx, 0) ThenBlock: { ReturnValue(0) }

        // Get content AKContext
        ctx = WinView_GetContentCtx(win_idx)
        IfCondition EqualTo(ctx, 0) ThenBlock: { ReturnValue(0) }

        // Convert to content-local coordinates
        wx = Win_GetX(win_idx)
        wy = Win_GetY(win_idx)
        bw = DecorConfig.border_w
        lx = Subtract(mx, Add(wx, bw))
        ly = Subtract(my, Add(wy, bw))

        // Hit-test within the AKContext to find a TEXTFIELD
        node = AK_HitTest(ctx, lx, ly)
        IfCondition LessThan(node, 0) ThenBlock: { ReturnValue(0) }
        tag = AK_Get(ctx, node, AKF.TAG)
        IfCondition NotEqual(tag, AKTag.TEXTFIELD) ThenBlock: { ReturnValue(0) }

        // Store source info
        CtxMenuState.source_win  = win_idx
        CtxMenuState.source_ctx  = ctx
        CtxMenuState.source_node = node

        // Show context menu at mouse position
        ContextMenu_Show(mx, my)
        ReturnValue(0)
    }
}

// =============================================================================
// BLIT — draw context menu surface to framebuffer
// =============================================================================
Function.ContextMenu_Blit {
    Body: {
        IfCondition EqualTo(CtxMenuState.open, 0) ThenBlock: { ReturnValue(0) }
        surf = CtxMenuState.surface
        IfCondition EqualTo(surf, 0) ThenBlock: { ReturnValue(0) }
        Win_BlitOne(surf, CtxMenuState.screen_x, CtxMenuState.screen_y)
    }
}
