// Library.Deskbar.ailang
// Full system bar — 3-zone layout with live window list
//
// Layout: [App Launchers] | [Window List] | [System Tray]
//
// The deskbar is hidden by default. A 2px checkerboard strip at the
// bottom of the screen is always visible. When the mouse enters the
// hot zone, the deskbar surface appears above it. When the mouse leaves
// the deskbar area, it hides again.
//
// The window list auto-refreshes when windows are created, closed, or
// focused (via DeskbarState.needs_refresh flag set by WinManager).
//
// Copyright © 2026 Sean Collins, 2 Paws Machine and Engineering. SCSL.

LibraryImport.Display.Render.DSurfaceTypes
LibraryImport.Display.Render.DSurface
LibraryImport.Display.Render.DDrawPixel
LibraryImport.Display.Render.SurfaceBlit
LibraryImport.Display.Render.Framebuffer
LibraryImport.Display.Render.DRenderFB
LibraryImport.Display.UI.Auckland
LibraryImport.Display.UI.AucklandEvent
LibraryImport.Display.Window.WinManager
LibraryImport.Display.System.EventRouter
LibraryImport.Display.Theme.UIScale
LibraryImport.Display.Theme.UITheme
LibraryImport.StringUtils
LibraryImport.PostgreSQL_Complete
LibraryImport.Display.System.SysDisplay
LibraryImport.Display.Render.VIcon

// =============================================================================
// STATE
// =============================================================================
FixedPool.DeskbarState {
    "visible":       Initialize=0, CanChange=True
    "surface":       Initialize=0, CanChange=True
    "ak_ctx":        Initialize=0, CanChange=True
    "height":        Initialize=40, CanChange=True
    "hotzone_h":     Initialize=2, CanChange=True
    "screen_w":      Initialize=0, CanChange=True
    "screen_h":      Initialize=0, CanChange=True
    "left_zone":     Initialize=-1, CanChange=True
    "center_zone":   Initialize=-1, CanChange=True
    "right_zone":    Initialize=-1, CanChange=True
    "needs_refresh": Initialize=1,  CanChange=True

    // Service launcher cache (loaded from postgres)
    "svc_count":      Initialize=0,  CanChange=True
    "svc_ids":        Initialize=0,  CanChange=True
    "svc_names":      Initialize=0,  CanChange=True
    "svc_name_lens":  Initialize=0,  CanChange=True
    "svc_paths":      Initialize=0,  CanChange=True
    "svc_path_lens":  Initialize=0,  CanChange=True
    "svc_icon_names": Initialize=0,  CanChange=True
    "svc_icon_nlens": Initialize=0,  CanChange=True
    "svc_icon_surfs": Initialize=0,  CanChange=True
    "svc_btn_nodes":  Initialize=0,  CanChange=True
}

FixedPool.DeskbarConst {
    "MAX_SERVICES": Initialize=16
}

// =============================================================================
// INIT — create surface, build Auckland tree
// =============================================================================
Function.Deskbar_Init {
    Input: screen_w: Integer
    Input: screen_h: Integer
    Output: Integer
    Body: {
        DebugLog_Push("dk.ini", 6)
        DeskbarState.screen_w = screen_w
        DeskbarState.screen_h = screen_h
        DeskbarState.visible = 0

        // Copy scaled dimensions from UIScale
        DeskbarState.height   = UIScale.deskbar_h
        DeskbarState.hotzone_h = UIScale.deskbar_hotzone

        db_h = DeskbarState.height

        // Create deskbar surface
        DebugLog_Push("dk.ini.1", 8)
        surf = Surface_Create(SurfaceFormat.PIXEL_32, screen_w, db_h)
        IfCondition EqualTo(surf, 0) ThenBlock: {
            PrintMessage("[Deskbar] surface alloc fail\n")
            ReturnValue(0)
        }
        DeskbarState.surface = surf

        // Create Auckland context for deskbar
        ctx = AK_CreateContext()
        IfCondition EqualTo(ctx, 0) ThenBlock: {
            PrintMessage("[Deskbar] AKCtx alloc fail\n")
            ReturnValue(0)
        }
        DeskbarState.ak_ctx = ctx

        // Set design dimensions to match actual surface
        AK_SetDesignW(ctx, screen_w)
        AK_SetDesignH(ctx, db_h)

        // Load app launchers from postgres
        Deskbar_LoadServices()

        // Build deskbar UI
        Deskbar_BuildTree(ctx, screen_w, db_h)

        // Mark for first refresh (icon overlay happens in Deskbar_Refresh)
        DeskbarState.needs_refresh = 1

        PrintMessage("[Deskbar] initialized ")
        PrintNumber(screen_w)
        PrintMessage("x")
        PrintNumber(db_h)
        PrintMessage("\n")
        ReturnValue(1)
    }
}

// =============================================================================
// BUILD TREE — 3-zone deskbar layout
// Layout: [left: launchers] [sep] [center: window list, GROW] [sep] [right: system]
// Takes AKContext handle directly — no global swap needed.
// =============================================================================
Function.Deskbar_BuildTree {
    Input: ctx: LinkagePool.AKContext
    Input: width: Integer
    Input: height: Integer
    Output: Integer
    Body: {
        DebugLog_Push("dk.bt", 5)

        // Root HBOX
        root = AK_CreateNode(ctx, AKTag.GROUP)
        IfCondition LessThan(root, 0) ThenBlock: { ReturnValue(-1) }
        AK_Set(ctx, root, AKF.LAYOUT_MODE, AKLayout.HBOX)
        AK_Set(ctx, root, AKF.GAP, UIScale.deskbar_gap)
        AK_Set(ctx, root, AKF.PAD_T, UIScale.deskbar_pad)
        AK_Set(ctx, root, AKF.PAD_R, UIScale.deskbar_pad_lr)
        AK_Set(ctx, root, AKF.PAD_B, UIScale.deskbar_pad)
        AK_Set(ctx, root, AKF.PAD_L, UIScale.deskbar_pad_lr)
        AK_ExtraSet(ctx, root, AKExtra.COLOR_BG, Theme.deskbar_bg)
        AK_SetRoot(ctx, root)

        // ----- LEFT ZONE: App launchers -----
        left = AK_CreateNode(ctx, AKTag.GROUP)
        AK_Set(ctx, left, AKF.LAYOUT_MODE, AKLayout.HBOX)
        AK_Set(ctx, left, AKF.GAP, UIScale.deskbar_gap)
        AK_AddChild(ctx, root, left)
        DeskbarState.left_zone = left

        // Home button — [icon Start] opens Start Menu
        btn_home = AK_CreateNode(ctx, AKTag.BUTTON)
        // Icon fills nearly the full button height
        start_icon_sz = Subtract(UIScale.deskbar_btn_h, UIScale.deskbar_start_icon_inset)
        IfCondition LessThan(start_icon_sz, UIScale.deskbar_start_icon_min) ThenBlock: { start_icon_sz = UIScale.deskbar_start_icon_min }
        // Button width: icon + small gap + text "Start" — tight fit, no waste
        start_w = Add(start_icon_sz, UIScale.deskbar_start_text_w)
        AK_Set(ctx, btn_home, AKF.MIN_W, start_w)
        AK_Set(ctx, btn_home, AKF.HEIGHT, UIScale.deskbar_btn_h)
        AK_ExtraSet(ctx, btn_home, AKExtra.STR_PTR, "Start")
        AK_ExtraSet(ctx, btn_home, AKExtra.STR_LEN, 5)
        AK_ExtraSet(ctx, btn_home, AKExtra.ACTION_PTR, "app.home")
        AK_ExtraSet(ctx, btn_home, AKExtra.ACTION_LEN, 8)
        AK_ExtraSet(ctx, btn_home, AKExtra.COLOR_BG, Theme.deskbar_btn_bg)
        AK_ExtraSet(ctx, btn_home, AKExtra.COLOR_FG, Theme.deskbar_btn_fg)
        AK_ExtraSet(ctx, btn_home, AKExtra.TEXT_ALIGN, TRAlign.LEFT)
        VIcon_SetSize(start_icon_sz)
        start_icon = VIcon_Resolve("aos-logo")
        IfCondition NotEqual(start_icon, 0) ThenBlock: {
            AK_ExtraSet(ctx, btn_home, AKExtra.ICON_SURF, start_icon)
        }
        AK_AddChild(ctx, left, btn_home)

        // App launchers live in Start Menu > Programs cascade, not in deskbar
        // Deskbar_BuildLaunchers(ctx, left)

        // ----- LEFT SEPARATOR -----
        sep_l = AK_CreateNode(ctx, AKTag.SEPARATOR)
        AK_Set(ctx, sep_l, AKF.HEIGHT, UIScale.deskbar_btn_h)
        AK_ExtraSet(ctx, sep_l, AKExtra.COLOR_FG, Theme.deskbar_sep)
        AK_AddChild(ctx, root, sep_l)

        // ----- CENTER ZONE: Window list (GROW=1 absorbs remaining space) -----
        center = AK_CreateNode(ctx, AKTag.GROUP)
        AK_Set(ctx, center, AKF.LAYOUT_MODE, AKLayout.HBOX)
        AK_Set(ctx, center, AKF.GAP, UIScale.deskbar_gap)
        AK_Set(ctx, center, AKF.GROW, 1)
        AK_AddChild(ctx, root, center)
        DeskbarState.center_zone = center

        // Populate window buttons
        Deskbar_BuildWindowList(ctx)

        // ----- RIGHT SEPARATOR -----
        sep_r = AK_CreateNode(ctx, AKTag.SEPARATOR)
        AK_Set(ctx, sep_r, AKF.HEIGHT, UIScale.deskbar_btn_h)
        AK_ExtraSet(ctx, sep_r, AKExtra.COLOR_FG, Theme.deskbar_sep)
        AK_AddChild(ctx, root, sep_r)

        // ----- RIGHT ZONE: System tray -----
        right = AK_CreateNode(ctx, AKTag.GROUP)
        AK_Set(ctx, right, AKF.LAYOUT_MODE, AKLayout.HBOX)
        AK_Set(ctx, right, AKF.GAP, UIScale.deskbar_gap)
        AK_AddChild(ctx, root, right)
        DeskbarState.right_zone = right

        // User label
        lbl_user = AK_CreateNode(ctx, AKTag.LABEL)
        AK_Set(ctx, lbl_user, AKF.HEIGHT, UIScale.deskbar_btn_h)
        AK_ExtraSet(ctx, lbl_user, AKExtra.STR_PTR, "bob")
        AK_ExtraSet(ctx, lbl_user, AKExtra.STR_LEN, 3)
        AK_ExtraSet(ctx, lbl_user, AKExtra.COLOR_FG, Theme.deskbar_btn2_fg)
        AK_ExtraSet(ctx, lbl_user, AKExtra.TEXT_ALIGN, 2)
        AK_AddChild(ctx, right, lbl_user)

        // Screenshot button
        btn_ss = AK_CreateNode(ctx, AKTag.BUTTON)
        AK_Set(ctx, btn_ss, AKF.MIN_W, UIScale.deskbar_btn_w)
        AK_Set(ctx, btn_ss, AKF.HEIGHT, UIScale.deskbar_btn_h)
        AK_ExtraSet(ctx, btn_ss, AKExtra.STR_PTR, "Snap")
        AK_ExtraSet(ctx, btn_ss, AKExtra.STR_LEN, 4)
        AK_ExtraSet(ctx, btn_ss, AKExtra.ACTION_PTR, "sys.screenshot")
        AK_ExtraSet(ctx, btn_ss, AKExtra.ACTION_LEN, 14)
        AK_ExtraSet(ctx, btn_ss, AKExtra.COLOR_BG, Theme.deskbar_btn2_bg)
        AK_ExtraSet(ctx, btn_ss, AKExtra.COLOR_FG, Theme.deskbar_btn2_fg)
        AK_AddChild(ctx, right, btn_ss)

        // About button
        btn_about = AK_CreateNode(ctx, AKTag.BUTTON)
        AK_Set(ctx, btn_about, AKF.MIN_W, UIScale.deskbar_btn_w)
        AK_Set(ctx, btn_about, AKF.HEIGHT, UIScale.deskbar_btn_h)
        AK_ExtraSet(ctx, btn_about, AKExtra.STR_PTR, "About")
        AK_ExtraSet(ctx, btn_about, AKExtra.STR_LEN, 5)
        AK_ExtraSet(ctx, btn_about, AKExtra.ACTION_PTR, "app.about")
        AK_ExtraSet(ctx, btn_about, AKExtra.ACTION_LEN, 9)
        AK_ExtraSet(ctx, btn_about, AKExtra.COLOR_BG, Theme.deskbar_btn2_bg)
        AK_ExtraSet(ctx, btn_about, AKExtra.COLOR_FG, Theme.deskbar_btn2_fg)
        AK_AddChild(ctx, right, btn_about)

        PrintMessage("[Deskbar] tree built: ")
        PrintNumber(ctx@tree_count)
        PrintMessage(" nodes\n")
        ReturnValue(root)
    }
}

// =============================================================================
// BUILD WINDOW LIST — populate center zone with one button per active window
// =============================================================================
Function.Deskbar_BuildWindowList {
    Input: ctx: LinkagePool.AKContext
    Body: {
        DebugLog_Push("dk.bwl", 6)
        center = DeskbarState.center_zone
        IfCondition LessThan(center, 0) ThenBlock: { ReturnValue(0) }

        zi = 0
        WhileLoop LessThan(zi, WinMgr.z_count) {
            win_idx = WinMgr_ZGet(zi)
            IfCondition GreaterThan(win_idx, 0) ThenBlock: {
                IfCondition EqualTo(Win_IsActive(win_idx), 1) ThenBlock: {
                    title_ptr = WinMgr_GetTitle(win_idx)
                    title_len = 6
                    IfCondition NotEqual(title_ptr, 0) ThenBlock: {
                        title_len = StringLength(title_ptr)
                    } ElseBlock: {
                        title_ptr = "Window"
                    }

                    btn = AK_CreateNode(ctx, AKTag.BUTTON)
                    AK_Set(ctx, btn, AKF.MIN_W, UIScale.deskbar_win_btn_w)
                    AK_Set(ctx, btn, AKF.HEIGHT, UIScale.deskbar_btn_h)
                    AK_ExtraSet(ctx, btn, AKExtra.STR_PTR, title_ptr)
                    AK_ExtraSet(ctx, btn, AKExtra.STR_LEN, title_len)

                    // Action: pre-allocated "wf.N" string
                    action = Deskbar_BuildFocusAction(win_idx)
                    action_len = 4
                    AK_ExtraSet(ctx, btn, AKExtra.ACTION_PTR, action)
                    AK_ExtraSet(ctx, btn, AKExtra.ACTION_LEN, action_len)

                    // Highlight focused window, dim minimized
                    wfl = WinMgr_GetFlags(win_idx)
                    IfCondition NotEqual(BitwiseAnd(wfl, WinFlags.MINIMIZED), 0) ThenBlock: {
                        AK_ExtraSet(ctx, btn, AKExtra.COLOR_BG, Theme.deskbar_win_bg)
                        AK_ExtraSet(ctx, btn, AKExtra.COLOR_FG, Theme.text_disabled)
                    } ElseBlock: {
                    IfCondition EqualTo(win_idx, WinMgr.focused) ThenBlock: {
                        AK_ExtraSet(ctx, btn, AKExtra.COLOR_BG, Theme.deskbar_win_act_bg)
                        AK_ExtraSet(ctx, btn, AKExtra.COLOR_FG, Theme.deskbar_win_fg)
                    } ElseBlock: {
                        AK_ExtraSet(ctx, btn, AKExtra.COLOR_BG, Theme.deskbar_win_bg)
                        AK_ExtraSet(ctx, btn, AKExtra.COLOR_FG, Theme.deskbar_win_fg)
                    }
                    }

                    // Set app icon on window button via service ID lookup
                    svc_id = WinView_GetServiceId(win_idx)
                    IfCondition GreaterThan(svc_id, 0) ThenBlock: {
                        // Find this service ID in deskbar cache to get its icon surface
                        wi_sz = Subtract(UIScale.deskbar_btn_h, UIScale.deskbar_win_icon_inset)
                        IfCondition LessThan(wi_sz, UIScale.deskbar_win_icon_min) ThenBlock: { wi_sz = UIScale.deskbar_win_icon_min }
                        VIcon_SetSize(wi_sz)
                        win_icon = 0
                        sci = 0
                        WhileLoop LessThan(sci, DeskbarState.svc_count) {
                            soff = Multiply(sci, 8)
                            cached_id = Dereference(Add(DeskbarState.svc_ids, soff))
                            IfCondition EqualTo(cached_id, svc_id) ThenBlock: {
                                // Found — resolve icon by name
                                iname = Dereference(Add(DeskbarState.svc_icon_names, soff))
                                ilen  = Dereference(Add(DeskbarState.svc_icon_nlens, soff))
                                IfCondition GreaterThan(ilen, 0) ThenBlock: {
                                    win_icon = VIcon_Resolve(iname)
                                }
                                IfCondition EqualTo(win_icon, 0) ThenBlock: {
                                    win_icon = VIcon_Resolve("gear")
                                }
                                sci = DeskbarState.svc_count
                            }
                            sci = Add(sci, 1)
                        }
                        IfCondition NotEqual(win_icon, 0) ThenBlock: {
                            AK_ExtraSet(ctx, btn, AKExtra.ICON_SURF, win_icon)
                        }
                    }

                    AK_AddChild(ctx, center, btn)
                }
            }
            zi = Add(zi, 1)
        }
        ReturnValue(0)
    }
}

// =============================================================================
// BUILD FOCUS ACTION — return pre-allocated action string for window index
// Returns "wf.1" through "wf.7" (avoids allocation per refresh)
// =============================================================================
Function.Deskbar_BuildFocusAction {
    Input: win_idx: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(win_idx, 1) ThenBlock: { ReturnValue("wf.1") }
        IfCondition EqualTo(win_idx, 2) ThenBlock: { ReturnValue("wf.2") }
        IfCondition EqualTo(win_idx, 3) ThenBlock: { ReturnValue("wf.3") }
        IfCondition EqualTo(win_idx, 4) ThenBlock: { ReturnValue("wf.4") }
        IfCondition EqualTo(win_idx, 5) ThenBlock: { ReturnValue("wf.5") }
        IfCondition EqualTo(win_idx, 6) ThenBlock: { ReturnValue("wf.6") }
        IfCondition EqualTo(win_idx, 7) ThenBlock: { ReturnValue("wf.7") }
        ReturnValue("wf.0")
    }
}

// =============================================================================
// LOAD SERVICES — query postgres for enabled services, cache in DeskbarState
// Called once at init. Falls back gracefully if no database.
// =============================================================================
Function.Deskbar_LoadServices {
    Body: {
        DebugLog_Push("dk.lsv", 6)
        conn = SysDisplay_GetDBConn()
        IfCondition EqualTo(conn, 0) ThenBlock: {
            PrintMessage("[Deskbar] no DB — using fallback launchers\n")
            DeskbarState.svc_count = 0
            ReturnValue(0)
        }

        r = PG_Query(conn, "SELECT id, display_name, binary_path, icon_name FROM services WHERE enabled = true AND autostart = false ORDER BY priority, name")
        IfCondition EqualTo(r, 0) ThenBlock: {
            PrintMessage("[Deskbar] service query failed\n")
            DeskbarState.svc_count = 0
            ReturnValue(0)
        }

        rc = Array.Size(r)
        IfCondition GreaterThan(rc, DeskbarConst.MAX_SERVICES) ThenBlock: {
            rc = DeskbarConst.MAX_SERVICES
        }

        // Allocate cache arrays (8 bytes per slot)
        ids_buf    = Allocate(Multiply(DeskbarConst.MAX_SERVICES, 8))
        names_buf  = Allocate(Multiply(DeskbarConst.MAX_SERVICES, 8))
        nlens_buf  = Allocate(Multiply(DeskbarConst.MAX_SERVICES, 8))
        paths_buf  = Allocate(Multiply(DeskbarConst.MAX_SERVICES, 8))
        plens_buf  = Allocate(Multiply(DeskbarConst.MAX_SERVICES, 8))
        inames_buf = Allocate(Multiply(DeskbarConst.MAX_SERVICES, 8))
        inlens_buf = Allocate(Multiply(DeskbarConst.MAX_SERVICES, 8))
        isurfs_buf = Allocate(Multiply(DeskbarConst.MAX_SERVICES, 8))
        btnodes_buf = Allocate(Multiply(DeskbarConst.MAX_SERVICES, 8))
        MemorySet(isurfs_buf, 0, Multiply(DeskbarConst.MAX_SERVICES, 8))
        MemorySet(btnodes_buf, 0, Multiply(DeskbarConst.MAX_SERVICES, 8))

        si = 0
        WhileLoop LessThan(si, rc) {
            row = Array.Get(r, si)
            v_id   = Hash.Get(row, "id")
            v_name = Hash.Get(row, "display_name")
            v_path = Hash.Get(row, "binary_path")
            v_icon = Hash.Get(row, "icon_name")

            svc_id = 0
            IfCondition NotEqual(v_id, 0) ThenBlock: {
                svc_id = StringToNumber(v_id)
            }

            // Use service name as fallback if display_name is null
            IfCondition EqualTo(v_name, 0) ThenBlock: {
                v_name = Hash.Get(row, "name")
            }
            IfCondition EqualTo(v_name, 0) ThenBlock: {
                v_name = "???"
            }

            IfCondition EqualTo(v_path, 0) ThenBlock: {
                v_path = ""
            }
            IfCondition EqualTo(v_icon, 0) ThenBlock: {
                v_icon = ""
            }

            n_len = StringLength(v_name)
            p_len = StringLength(v_path)
            i_len = StringLength(v_icon)

            off = Multiply(si, 8)
            StoreValue(Add(ids_buf, off), svc_id)
            StoreValue(Add(names_buf, off), v_name)
            StoreValue(Add(nlens_buf, off), n_len)
            StoreValue(Add(paths_buf, off), v_path)
            StoreValue(Add(plens_buf, off), p_len)
            StoreValue(Add(inames_buf, off), v_icon)
            StoreValue(Add(inlens_buf, off), i_len)

            si = Add(si, 1)
        }

        PG_DestroyResult(r)

        DeskbarState.svc_count      = rc
        DeskbarState.svc_ids        = ids_buf
        DeskbarState.svc_names      = names_buf
        DeskbarState.svc_name_lens  = nlens_buf
        DeskbarState.svc_paths      = paths_buf
        DeskbarState.svc_path_lens  = plens_buf
        DeskbarState.svc_icon_names = inames_buf
        DeskbarState.svc_icon_nlens = inlens_buf
        DeskbarState.svc_icon_surfs = isurfs_buf
        DeskbarState.svc_btn_nodes  = btnodes_buf

        // Rasterize icons at deskbar button size
        icon_sz = Subtract(UIScale.deskbar_btn_h, UIScale.deskbar_launcher_icon_inset)
        IfCondition LessThan(icon_sz, UIScale.deskbar_launcher_icon_min) ThenBlock: { icon_sz = UIScale.deskbar_launcher_icon_min }
        VIcon_SetSize(icon_sz)
        si = 0
        WhileLoop LessThan(si, rc) {
            off = Multiply(si, 8)
            iname = Dereference(Add(inames_buf, off))
            ilen  = Dereference(Add(inlens_buf, off))
            icon_surf = 0
            IfCondition GreaterThan(ilen, 0) ThenBlock: {
                icon_surf = VIcon_Resolve(iname)
            }
            // Fallback: try "gear" if specific icon not found
            IfCondition EqualTo(icon_surf, 0) ThenBlock: {
                icon_surf = VIcon_Resolve("gear")
            }
            StoreValue(Add(isurfs_buf, off), icon_surf)
            si = Add(si, 1)
        }

        PrintMessage("[Deskbar] loaded ")
        PrintNumber(rc)
        PrintMessage(" services from DB\n")
        ReturnValue(rc)
    }
}

// =============================================================================
// BUILD LAUNCHERS — create buttons from cached services
// Falls back to hardcoded New/Files if no services loaded.
// =============================================================================
Function.Deskbar_BuildLaunchers {
    Input: ctx: LinkagePool.AKContext
    Input: parent: Integer
    Body: {
        DebugLog_Push("dk.bla", 6)
        sc = DeskbarState.svc_count
        IfCondition LessEqual(sc, 0) ThenBlock: {
            // Fallback: hardcoded launchers
            btn_new = AK_CreateNode(ctx, AKTag.BUTTON)
            AK_Set(ctx, btn_new, AKF.MIN_W, UIScale.deskbar_btn_w)
            AK_Set(ctx, btn_new, AKF.HEIGHT, UIScale.deskbar_btn_h)
            AK_ExtraSet(ctx, btn_new, AKExtra.STR_PTR, "New")
            AK_ExtraSet(ctx, btn_new, AKExtra.STR_LEN, 3)
            AK_ExtraSet(ctx, btn_new, AKExtra.ACTION_PTR, "win.new")
            AK_ExtraSet(ctx, btn_new, AKExtra.ACTION_LEN, 7)
            AK_ExtraSet(ctx, btn_new, AKExtra.COLOR_BG, Theme.deskbar_btn_bg)
            AK_ExtraSet(ctx, btn_new, AKExtra.COLOR_FG, Theme.deskbar_btn_fg)
            AK_AddChild(ctx, parent, btn_new)

            btn_files = AK_CreateNode(ctx, AKTag.BUTTON)
            AK_Set(ctx, btn_files, AKF.MIN_W, UIScale.deskbar_btn_w)
            AK_Set(ctx, btn_files, AKF.HEIGHT, UIScale.deskbar_btn_h)
            AK_ExtraSet(ctx, btn_files, AKExtra.STR_PTR, "Files")
            AK_ExtraSet(ctx, btn_files, AKExtra.STR_LEN, 5)
            AK_ExtraSet(ctx, btn_files, AKExtra.ACTION_PTR, "app.files")
            AK_ExtraSet(ctx, btn_files, AKExtra.ACTION_LEN, 9)
            AK_ExtraSet(ctx, btn_files, AKExtra.COLOR_BG, Theme.deskbar_btn_bg)
            AK_ExtraSet(ctx, btn_files, AKExtra.COLOR_FG, Theme.deskbar_btn_fg)
            AK_AddChild(ctx, parent, btn_files)

            ReturnValue(0)
        }

        // Dynamic launchers from postgres cache
        icon_pad = Subtract(UIScale.deskbar_btn_h, UIScale.deskbar_launcher_icon_inset)
        si = 0
        WhileLoop LessThan(si, sc) {
            off = Multiply(si, 8)
            s_name = Dereference(Add(DeskbarState.svc_names, off))
            s_nlen = Dereference(Add(DeskbarState.svc_name_lens, off))

            // Action: "svc.N" where N is the cache index
            action = Deskbar_BuildSvcAction(si)
            action_len = 5
            IfCondition GreaterEqual(si, 10) ThenBlock: { action_len = 6 }

            // Wider button to fit icon + text
            btn_w = Add(UIScale.deskbar_btn_w, icon_pad)

            btn = AK_CreateNode(ctx, AKTag.BUTTON)
            AK_Set(ctx, btn, AKF.MIN_W, btn_w)
            AK_Set(ctx, btn, AKF.HEIGHT, UIScale.deskbar_btn_h)
            AK_ExtraSet(ctx, btn, AKExtra.STR_PTR, s_name)
            AK_ExtraSet(ctx, btn, AKExtra.STR_LEN, s_nlen)
            AK_ExtraSet(ctx, btn, AKExtra.ACTION_PTR, action)
            AK_ExtraSet(ctx, btn, AKExtra.ACTION_LEN, action_len)
            AK_ExtraSet(ctx, btn, AKExtra.COLOR_BG, Theme.deskbar_btn_bg)
            AK_ExtraSet(ctx, btn, AKExtra.COLOR_FG, Theme.deskbar_btn_fg)
            AK_AddChild(ctx, parent, btn)

            // Cache button node for icon overlay after layout
            IfCondition NotEqual(DeskbarState.svc_btn_nodes, 0) ThenBlock: {
                StoreValue(Add(DeskbarState.svc_btn_nodes, off), btn)
            }

            si = Add(si, 1)
        }
        ReturnValue(sc)
    }
}

// =============================================================================
// BUILD SVC ACTION — pre-allocated action strings "svc.0" through "svc.F"
// =============================================================================
Function.Deskbar_BuildSvcAction {
    Input: idx: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(idx, 0)  ThenBlock: { ReturnValue("svc.0") }
        IfCondition EqualTo(idx, 1)  ThenBlock: { ReturnValue("svc.1") }
        IfCondition EqualTo(idx, 2)  ThenBlock: { ReturnValue("svc.2") }
        IfCondition EqualTo(idx, 3)  ThenBlock: { ReturnValue("svc.3") }
        IfCondition EqualTo(idx, 4)  ThenBlock: { ReturnValue("svc.4") }
        IfCondition EqualTo(idx, 5)  ThenBlock: { ReturnValue("svc.5") }
        IfCondition EqualTo(idx, 6)  ThenBlock: { ReturnValue("svc.6") }
        IfCondition EqualTo(idx, 7)  ThenBlock: { ReturnValue("svc.7") }
        IfCondition EqualTo(idx, 8)  ThenBlock: { ReturnValue("svc.8") }
        IfCondition EqualTo(idx, 9)  ThenBlock: { ReturnValue("svc.9") }
        IfCondition EqualTo(idx, 10) ThenBlock: { ReturnValue("svc.10") }
        IfCondition EqualTo(idx, 11) ThenBlock: { ReturnValue("svc.11") }
        IfCondition EqualTo(idx, 12) ThenBlock: { ReturnValue("svc.12") }
        IfCondition EqualTo(idx, 13) ThenBlock: { ReturnValue("svc.13") }
        IfCondition EqualTo(idx, 14) ThenBlock: { ReturnValue("svc.14") }
        IfCondition EqualTo(idx, 15) ThenBlock: { ReturnValue("svc.15") }
        ReturnValue("svc.0")
    }
}

// =============================================================================
// LAUNCH SERVICE — look up binary_path from cache, dispatch accordingly
// "internal:xxx" → push xxx as EventRouter action
// Otherwise → stub (Phase 4 implements fork/exec)
// =============================================================================
Function.Deskbar_LaunchService {
    Input: cache_idx: Integer
    Body: {
        DebugLog_Push("dk.lau", 6)
        IfCondition GreaterEqual(cache_idx, DeskbarState.svc_count) ThenBlock: {
            PrintMessage("[Deskbar] launch: invalid idx\n")
            ReturnValue(0)
        }

        off = Multiply(cache_idx, 8)
        s_path = Dereference(Add(DeskbarState.svc_paths, off))
        s_plen = Dereference(Add(DeskbarState.svc_path_lens, off))
        s_name = Dereference(Add(DeskbarState.svc_names, off))

        IfCondition LessEqual(s_plen, 0) ThenBlock: {
            PrintMessage("[Deskbar] launch: no binary_path for ")
            PrintString(s_name)
            PrintMessage("\n")
            ReturnValue(0)
        }

        // Check for "internal:" prefix (9 chars: 105 110 116 101 114 110 97 108 58)
        is_internal = 0
        IfCondition GreaterEqual(s_plen, 9) ThenBlock: {
            c0 = GetByte(s_path, 0)
            c1 = GetByte(s_path, 1)
            c2 = GetByte(s_path, 2)
            c3 = GetByte(s_path, 3)
            c4 = GetByte(s_path, 4)
            c5 = GetByte(s_path, 5)
            c6 = GetByte(s_path, 6)
            c7 = GetByte(s_path, 7)
            c8 = GetByte(s_path, 8)
            // "internal:" = 105 110 116 101 114 110 97 108 58
            IfCondition And(EqualTo(c0, 105), And(EqualTo(c1, 110), And(EqualTo(c2, 116), And(EqualTo(c3, 101), And(EqualTo(c4, 114), And(EqualTo(c5, 110), And(EqualTo(c6, 97), And(EqualTo(c7, 108), EqualTo(c8, 58))))))))) ThenBlock: {
                is_internal = 1
            }
        }

        IfCondition EqualTo(is_internal, 1) ThenBlock: {
            // Strip "internal:" prefix, push remainder as EventRouter action
            action_ptr = Add(s_path, 9)
            action_len = Subtract(s_plen, 9)
            PrintMessage("[Deskbar] internal launch: ")
            PrintString(action_ptr)
            PrintMessage("\n")
            EventRouter_Push(action_ptr, action_len, -1)
            ReturnValue(1)
        }

        // External binary — fork/exec
        PrintMessage("[Deskbar] launching: ")
        PrintString(s_path)
        PrintMessage("\n")

        // Build argv: [path, NULL]
        argv = Allocate(16)
        IfCondition EqualTo(argv, 0) ThenBlock: {
            PrintMessage("[Deskbar] argv alloc fail\n")
            ReturnValue(0)
        }
        StoreValue(argv, s_path)
        StoreValue(Add(argv, 8), 0)

        pid = SystemCall(57)
        IfCondition EqualTo(pid, 0) ThenBlock: {
            // Child process: close inherited fds (fb0, tty, input, sockets)
            // before exec so the launched app starts clean.
            cfd = 3
            WhileLoop LessThan(cfd, 64) {
                SystemCall(3, cfd, 0, 0, 0, 0)
                cfd = Add(cfd, 1)
            }
            // Exec the service binary
            SystemCall(59, s_path, argv, 0)
            // If exec fails, exit child
            SystemCall(60, 127)
        }

        IfCondition GreaterThan(pid, 0) ThenBlock: {
            // Parent: log the launched PID
            PrintMessage("[Deskbar] forked pid=")
            PrintNumber(pid)
            PrintMessage("\n")
            Deallocate(argv, 16)
            ReturnValue(1)
        }

        // Fork failed
        PrintMessage("[Deskbar] fork failed\n")
        Deallocate(argv, 16)
        ReturnValue(0)
    }
}

// =============================================================================
// REFRESH — rebuild tree and redraw if needs_refresh is set
// Called from main loop after EventRouter_Drain.
// =============================================================================
Function.Deskbar_Refresh {
    Body: {
        IfCondition EqualTo(DeskbarState.needs_refresh, 0) ThenBlock: { ReturnValue(0) }
        DeskbarState.needs_refresh = 0

        ctx = DeskbarState.ak_ctx
        IfCondition EqualTo(ctx, 0) ThenBlock: { ReturnValue(0) }

        surf = DeskbarState.surface
        IfCondition EqualTo(surf, 0) ThenBlock: { ReturnValue(0) }

        sw   = DeskbarState.screen_w
        db_h = DeskbarState.height

        // Reset context (zeros buffers, no realloc)
        DebugLog_Push("dk.rfr", 6)
        AK_ResetContext(ctx)
        AK_SetDesignW(ctx, sw)
        AK_SetDesignH(ctx, db_h)

        // Rebuild full tree
        Deskbar_BuildTree(ctx, sw, db_h)

        // Redraw surface
        Draw_Pix_FillRect(surf, 0, 0, sw, db_h, Theme.deskbar_bg)
        AK_Draw(ctx, surf, sw, db_h)

        // Logo is now rendered natively via ICON_SURF on the Start button

        ReturnValue(1)
    }
}

// =============================================================================
// DRAW HOTZONE — 2px checkerboard at bottom of framebuffer
// Call from Win_BlitAll, always last, always drawn.
// =============================================================================
Function.Deskbar_DrawHotzone {
    Body: {
        DebugLog_Push("dk.hz", 5)
        sw  = DeskbarState.screen_w
        sh  = DeskbarState.screen_h
        hzh = DeskbarState.hotzone_h

        buf = FB_GetDrawBuffer()
        pit = FB.pitch
        pb  = 4
        col_w = Theme.deskbar_hotzone_color_a
        col_d = Theme.deskbar_hotzone_color_b

        y = 0
        WhileLoop LessThan(y, hzh) {
            row_y = Add(Subtract(sh, hzh), y)
            row_addr = Add(buf, Multiply(row_y, pit))
            x = 0
            WhileLoop LessThan(x, sw) {
                parity = Modulo(Add(x, y), 2)
                addr = Add(row_addr, Multiply(x, pb))
                IfCondition EqualTo(parity, 0) ThenBlock: {
                    StoreValue(addr, col_w, "dword")
                } ElseBlock: {
                    StoreValue(addr, col_d, "dword")
                }
                x = Add(x, 1)
            }
            y = Add(y, 1)
        }
        ReturnValue(0)
    }
}

// =============================================================================
// DRAW DESKBAR — blit deskbar surface to framebuffer
// Only called when visible.
// =============================================================================
Function.Deskbar_Draw {
    Body: {
        DebugLog_Push("dk.drw", 6)
        IfCondition EqualTo(DeskbarState.visible, 0) ThenBlock: { ReturnValue(0) }

        surf = DeskbarState.surface
        IfCondition EqualTo(surf, 0) ThenBlock: { ReturnValue(0) }

        sw   = DeskbarState.screen_w
        sh   = DeskbarState.screen_h
        db_h = DeskbarState.height
        hzh  = DeskbarState.hotzone_h

        // Deskbar sits above the hotzone
        dst_y = Subtract(sh, Add(db_h, hzh))

        // Blit to framebuffer
        buf     = FB_GetDrawBuffer()
        pit     = FB.pitch
        pb      = 4
        src_data  = Surface_GetData(surf)
        src_pitch = Surface_GetPitch(surf)

        row_bytes = Multiply(sw, pb)
        y = 0
        WhileLoop LessThan(y, db_h) {
            src_row = Add(src_data, Multiply(y, src_pitch))
            dst_ptr = Add(buf, Multiply(Add(dst_y, y), pit))
            MemoryCopy(dst_ptr, src_row, row_bytes)
            y = Add(y, 1)
        }
        ReturnValue(1)
    }
}

// =============================================================================
// MOUSE CHECK — call from SysDisplay_DrainInput on MOUSE_MOVE
// Returns 1 if mouse is in deskbar zone (hotzone or visible deskbar area)
// =============================================================================
Function.Deskbar_MouseCheck {
    Input: mx: Integer
    Input: my: Integer
    Output: Integer
    Body: {
        DebugLog_Push("dk.mck", 6)
        sh   = DeskbarState.screen_h
        db_h = DeskbarState.height
        hzh  = DeskbarState.hotzone_h

        // Hot zone: bottom 2px of screen
        hz_top = Subtract(sh, hzh)

        IfCondition EqualTo(DeskbarState.visible, 0) ThenBlock: {
            // Not visible — check hot zone
            IfCondition GreaterEqual(my, hz_top) ThenBlock: {
                DeskbarState.visible = 1
                SysDisplayState.dirty = 1
                ReturnValue(1)
            }
            ReturnValue(0)
        }

        // Visible — check if mouse is still in deskbar + hotzone area
        db_top = Subtract(sh, Add(db_h, hzh))
        IfCondition GreaterEqual(my, db_top) ThenBlock: {
            ReturnValue(1)
        }

        // Mouse left deskbar area — hide
        DeskbarState.visible = 0
        SysDisplayState.dirty = 1
        ReturnValue(0)
    }
}

// =============================================================================
// EVENT — dispatch mouse event into deskbar Auckland tree
// Uses AKContext handle directly — no global save/restore needed.
// =============================================================================
Function.Deskbar_Event {
    Input: screen_x: Integer
    Input: screen_y: Integer
    Input: mouse_ev: Integer
    Output: Integer
    Body: {
        DebugLog_Push("dk.ev", 5)
        IfCondition EqualTo(DeskbarState.visible, 0) ThenBlock: { ReturnValue(0) }

        ctx = DeskbarState.ak_ctx
        IfCondition EqualTo(ctx, 0) ThenBlock: { ReturnValue(0) }

        surf = DeskbarState.surface
        IfCondition EqualTo(surf, 0) ThenBlock: { ReturnValue(0) }

        sh   = DeskbarState.screen_h
        db_h = DeskbarState.height
        hzh  = DeskbarState.hotzone_h

        // Convert to deskbar-local coordinates
        db_top = Subtract(sh, Add(db_h, hzh))
        local_x = screen_x
        local_y = Subtract(screen_y, db_top)

        // Clear action callback before dispatch
        AK_SetActionCb(ctx, 0)

        // Dispatch
        DebugLog_Push("dk.ev.2", 7)
        AK_EventMouse(ctx, local_x, local_y, mouse_ev)

        // Redraw if dirty
        drew = 0
        IfCondition GreaterThan(AK_GetDirtyCount(ctx), 0) ThenBlock: {
            sw = DeskbarState.screen_w
            DebugLog_Push("dk.ev.3", 7)
            Draw_Pix_FillRect(surf, 0, 0, sw, db_h, Theme.deskbar_bg)
            DebugLog_Push("dk.ev.4", 7)
            AK_Draw(ctx, surf, sw, db_h)

            // Logo is now rendered natively via ICON_SURF on the Start button

            drew = 1
        }

        // Capture action on UP
        fired_ptr = 0
        fired_len = 0
        IfCondition EqualTo(mouse_ev, AKMouseEv.UP) ThenBlock: {
            fn = AK_GetFocusNode(ctx)
            IfCondition GreaterEqual(fn, 0) ThenBlock: {
                ap = AK_ExtraGet(ctx, fn, AKExtra.ACTION_PTR)
                al = AK_ExtraGet(ctx, fn, AKExtra.ACTION_LEN)
                IfCondition And(NotEqual(ap, 0), GreaterThan(al, 0)) ThenBlock: {
                    fired_ptr = ap
                    fired_len = al
                }
            }
        }

        // Push action to EventRouter
        IfCondition NotEqual(fired_ptr, 0) ThenBlock: {
            DebugLog_Push("dk.ev.6", 7)
            EventRouter_Push(fired_ptr, fired_len, -1)
        }

        IfCondition EqualTo(drew, 1) ThenBlock: {
            SysDisplayState.dirty = 1
        }

        ReturnValue(drew)
    }
}
