// ─── Library.Menu.ailang ─────────────────────────────────────────────────────
// Dropdown menus for window toolbar. Deskbar-style overlay with own AKContext.
// One menu open at a time. F/E/V/H buttons fire menu:file etc., routed here.
// Copyright © 2025 Sean Collins, 2 Paws Machine and Engineering. All rights reserved. SCSL.

LibraryImport.Display.Render.DSurfaceTypes
LibraryImport.Display.Render.DSurface
LibraryImport.Display.Render.DDrawPixel
LibraryImport.Display.UI.Auckland
LibraryImport.Display.UI.AucklandEvent
LibraryImport.Display.Window.WinManager
LibraryImport.Display.Render.Fonts
LibraryImport.Display.UI.TextRegion
LibraryImport.Display.System.SysDisplay
LibraryImport.Display.System.EventRouter
LibraryImport.Display.Theme.UIScale
LibraryImport.Display.Theme.UITheme

// =============================================================================
// STATE
// =============================================================================
FixedPool.MenuState {
    "open":       Initialize=0, CanChange=True
    "menu_id":    Initialize=-1, CanChange=True
    "source_win": Initialize=-1, CanChange=True
    "screen_x":   Initialize=0, CanChange=True
    "screen_y":   Initialize=0, CanChange=True
    "width":      Initialize=160, CanChange=True
    "height":     Initialize=0, CanChange=True
    "surface":    Initialize=0, CanChange=True
    "ak_ctx":     Initialize=0, CanChange=True
}

FixedPool.MenuConst {
    "ITEM_W":  Initialize=160, CanChange=True
    "ITEM_H":  Initialize=26, CanChange=True
    "PAD":     Initialize=4, CanChange=True
    "BG":      Initialize=0xFF32323C, CanChange=True
    "FG":      Initialize=0xFFDCDCDC, CanChange=True
    "SEP_CLR": Initialize=0xFF505064, CanChange=True
}

// =============================================================================
// INIT
// =============================================================================
Function.Menu_Init {
    Output: Integer
    Body: {
        DebugLog_Push("mn.init", 7)
        MenuState.open = 0
        MenuState.ak_ctx = 0
        MenuState.surface = 0

        // Copy scaled menu dimensions from UIScale
        MenuConst.ITEM_W = UIScale.menu_item_w
        MenuConst.ITEM_H = UIScale.menu_item_h
        MenuConst.PAD    = UIScale.menu_pad
        MenuState.width  = UIScale.menu_item_w

        // Copy theme colors
        MenuConst.BG      = Theme.menu_bg
        MenuConst.FG      = Theme.menu_fg
        MenuConst.SEP_CLR = Theme.menu_sep

        ReturnValue(1)
    }
}

// =============================================================================
// ADD ITEM / SEPARATOR HELPERS
// =============================================================================
Function.Menu_AddItem {
    Input: ctx: LinkagePool.AKContext
    Input: parent: Integer
    Input: label_ptr: Integer
    Input: label_len: Integer
    Input: action_ptr: Integer
    Input: action_len: Integer
    Body: {
        DebugLog_Push("mn.add", 6)
        w = MenuConst.ITEM_W
        h = MenuConst.ITEM_H
        btn = AK_CreateNode(ctx, AKTag.BUTTON)
        AK_Set(ctx, btn, AKF.WIDTH, w)
        AK_Set(ctx, btn, AKF.MIN_W, w)
        AK_Set(ctx, btn, AKF.HEIGHT, h)
        AK_ExtraSet(ctx, btn, AKExtra.STR_PTR, label_ptr)
        AK_ExtraSet(ctx, btn, AKExtra.STR_LEN, label_len)
        AK_ExtraSet(ctx, btn, AKExtra.ACTION_PTR, action_ptr)
        AK_ExtraSet(ctx, btn, AKExtra.ACTION_LEN, action_len)
        AK_ExtraSet(ctx, btn, AKExtra.TEXT_ALIGN, TRAlign.LEFT)
        AK_ExtraSet(ctx, btn, AKExtra.COLOR_BG, Theme.toolbar_btn_bg)
        AK_ExtraSet(ctx, btn, AKExtra.COLOR_FG, Theme.menu_fg)
        AK_ExtraSet(ctx, btn, AKExtra.BORDER_CLR, Theme.toolbar_btn_bg)
        AK_ExtraSet(ctx, btn, AKExtra.BORDER_W, UIScale.toolbar_border_w)
        AK_AddChild(ctx, parent, btn)
    }
}

Function.Menu_AddSeparator {
    Input: ctx: LinkagePool.AKContext
    Input: parent: Integer
    Input: w: Integer
    Body: {
        DebugLog_Push("mn.sep", 6)
        sep = AK_CreateNode(ctx, AKTag.SEPARATOR)
        AK_Set(ctx, sep, AKF.HEIGHT, UIScale.ak_separator_w)
        AK_Set(ctx, sep, AKF.WIDTH, w)
        AK_ExtraSet(ctx, sep, AKExtra.COLOR_FG, Theme.toolbar_border)
        AK_AddChild(ctx, parent, sep)
    }
}

// =============================================================================
// BUILD MENU TREES
// =============================================================================
Function.Menu_BuildFile {
    Input: ctx: LinkagePool.AKContext
    Input: root: Integer
    Body: {
        DebugLog_Push("mn.bf", 5)
        Menu_AddItem(ctx, root, "New", 3, "doc.new", 7)
        Menu_AddItem(ctx, root, "Open", 4, "doc.open", 8)
        Menu_AddSeparator(ctx, root, MenuConst.ITEM_W)
        Menu_AddItem(ctx, root, "Save", 4, "doc.save", 8)
        Menu_AddItem(ctx, root, "Save As", 7, "doc.saveas", 10)
        Menu_AddSeparator(ctx, root, MenuConst.ITEM_W)
        Menu_AddItem(ctx, root, "Quit", 4, "win.close", 9)
    }
}

Function.Menu_BuildEdit {
    Input: ctx: LinkagePool.AKContext
    Input: root: Integer
    Body: {
        DebugLog_Push("mn.be", 5)
        Menu_AddItem(ctx, root, "Cut", 3, "edit.cut", 8)
        Menu_AddItem(ctx, root, "Copy", 4, "edit.copy", 9)
        Menu_AddItem(ctx, root, "Paste", 5, "edit.paste", 10)
        Menu_AddItem(ctx, root, "Select All", 10, "edit.selall", 11)
        Menu_AddSeparator(ctx, root, MenuConst.ITEM_W)
        Menu_AddItem(ctx, root, "Clear", 5, "doc.clear", 9)
    }
}

Function.Menu_BuildView {
    Input: ctx: LinkagePool.AKContext
    Input: root: Integer
    Body: {
        DebugLog_Push("mn.bv", 5)
        Menu_AddItem(ctx, root, "Zoom In", 7, "view.zoomin", 11)
        Menu_AddItem(ctx, root, "Zoom Out", 8, "view.zoomout", 12)
    }
}

Function.Menu_BuildHelp {
    Input: ctx: LinkagePool.AKContext
    Input: root: Integer
    Body: {
        DebugLog_Push("mn.bh", 5)
        Menu_AddItem(ctx, root, "About", 5, "app.about", 9)
    }
}

// =============================================================================
// COMPUTE HEIGHT — walk children to sum item heights + padding
// Reusable: works on any VBOX root with BUTTON (ITEM_H) and SEPARATOR (1px)
// children. Uses the provided AKContext handle.
// =============================================================================
Function.Menu_ComputeHeight {
    Input: ctx: LinkagePool.AKContext
    Input: root: Integer
    Output: Integer
    Body: {
        DebugLog_Push("mn.ch", 5)
        h = Multiply(MenuConst.PAD, 2)
        child = AK_Get(ctx, root, AKF.FIRST_CHILD)
        guard = 0
        WhileLoop NotEqual(child, -1) {
            guard = Add(guard, 1)
            IfCondition GreaterThan(guard, 64) ThenBlock: {
                PrintMessage("[Menu] LOOP in ComputeHeight child=")
                PrintNumber(child)
                PrintMessage("\n")
                ReturnValue(h)
            }
            tag = AK_Get(ctx, child, AKF.TAG)
            IfCondition EqualTo(tag, AKTag.SEPARATOR) ThenBlock: {
                h = Add(h, UIScale.ak_separator_w)
            } ElseBlock: {
                h = Add(h, MenuConst.ITEM_H)
            }
            child = AK_Get(ctx, child, AKF.NEXT_SIBLING)
        }
        ReturnValue(h)
    }
}

// =============================================================================
// RENDER — solve + draw menu tree into its surface
// Reusable: call after building/modifying items to re-render.
// Uses the provided AKContext handle.
// =============================================================================
Function.Menu_Render {
    Input: ctx: LinkagePool.AKContext
    Input: surf: Integer
    Input: w: Integer
    Input: h: Integer
    Body: {
        DebugLog_Push("mn.ren", 6)
        PrintMessage("[Menu_Render] surf=")
        PrintNumber(surf)
        PrintMessage(" w=")
        PrintNumber(w)
        PrintMessage(" h=")
        PrintNumber(h)
        PrintMessage("\n")

        DebugLog_Push("mn.ren.1", 8)
        WinChrome_FillSteelGrad(surf, w, h)
        VFont_UseSize(UIScale.toolbar_font_h)
        DebugLog_Push("mn.ren.2", 8)
        AK_Draw(ctx, surf, w, h)
        VFont_UseSize(UIScale.font_body)
    }
}

// =============================================================================
// SHOW — open a dropdown menu anchored to toolbar button
//
// menu_id:    0=File, 1=Edit, 2=View, 3=Help (builder dispatch)
// source_win: window whose toolbar spawned this menu
//
// Creates an AKContext, builds items via the builder, measures the tree,
// creates a surface, renders, and positions below the toolbar button.
// =============================================================================
Function.Menu_Show {
    Input: menu_id: Integer
    Input: source_win: Integer
    Output: Integer
    Body: {
        DebugLog_Push("MN.show", 7)
        PrintMessage("[Menu] Show id=")
        PrintNumber(menu_id)
        PrintMessage(" win=")
        PrintNumber(source_win)
        PrintMessage("\n")

        // Toggle — if same menu already open, close it
        IfCondition EqualTo(MenuState.open, 1) ThenBlock: {
            IfCondition EqualTo(MenuState.menu_id, menu_id) ThenBlock: {
                Menu_Close()
                ReturnValue(0)
            }
            Menu_Close()
        }

        // Free old context if leftover
        old_ctx = MenuState.ak_ctx
        IfCondition NotEqual(old_ctx, 0) ThenBlock: {
            AK_DestroyContext(old_ctx)
            MenuState.ak_ctx = 0
        }

        // Allocate AKContext for menu
        DebugLog_Push("mn.sho.2", 8)
        ak_ctx = AK_CreateContext()
        IfCondition EqualTo(ak_ctx, 0) ThenBlock: {
            PrintMessage("[Menu] AKContext alloc failed\n")
            DebugLog_Push("MN!ak", 5)
            ReturnValue(0)
        }
        MenuState.ak_ctx = ak_ctx
        DebugLog_Push("MN.ak", 5)

        // Build menu tree — PANEL root gets extra for bg/border
        root = AK_CreateNode(ak_ctx, AKTag.PANEL)
        AK_Set(ak_ctx, root, AKF.LAYOUT_MODE, AKLayout.VBOX)
        AK_Set(ak_ctx, root, AKF.GAP, 0)
        AK_Set(ak_ctx, root, AKF.PAD_T, MenuConst.PAD)
        AK_Set(ak_ctx, root, AKF.PAD_R, MenuConst.PAD)
        AK_Set(ak_ctx, root, AKF.PAD_B, MenuConst.PAD)
        AK_Set(ak_ctx, root, AKF.PAD_L, MenuConst.PAD)
        AK_ExtraSet(ak_ctx, root, AKExtra.COLOR_BG, 0)
        AK_ExtraSet(ak_ctx, root, AKExtra.BORDER_W, UIScale.toolbar_border_w)
        AK_ExtraSet(ak_ctx, root, AKExtra.BORDER_CLR, Theme.toolbar_border)
        AK_SetRoot(ak_ctx, root)
        DebugLog_Push("MN.tree", 7)

        // Dispatch to builder — each adds items to root
        IfCondition EqualTo(menu_id, 0) ThenBlock: { Menu_BuildFile(ak_ctx, root) }
        IfCondition EqualTo(menu_id, 1) ThenBlock: { Menu_BuildEdit(ak_ctx, root) }
        IfCondition EqualTo(menu_id, 2) ThenBlock: { Menu_BuildView(ak_ctx, root) }
        IfCondition EqualTo(menu_id, 3) ThenBlock: { Menu_BuildHelp(ak_ctx, root) }
        DebugLog_Push("MN.build", 8)

        // Compute surface size from tree content
        menu_w = Add(MenuConst.ITEM_W, Multiply(MenuConst.PAD, 2))
        menu_h = Menu_ComputeHeight(ak_ctx, root)
        // Create surface
        DebugLog_Push("mn.sho.1", 8)
        surf = Surface_Create(SurfaceFormat.PIXEL_32, menu_w, menu_h)
        IfCondition EqualTo(surf, 0) ThenBlock: {
            PrintMessage("[Menu] surface alloc failed\n")
            DebugLog_Push("MN!surf", 7)
            AK_DestroyContext(ak_ctx)
            MenuState.ak_ctx = 0
            ReturnValue(0)
        }
        DebugLog_Push("MN.surf", 7)

        // Set design dimensions to match actual surface — prevents
        // AK_ComputeScale from shrinking everything (default is 320x24).
        AK_SetDesignW(ak_ctx, menu_w)
        AK_SetDesignH(ak_ctx, menu_h)

        // Render tree into surface
        DebugLog_Push("mn.sho.4", 8)
        Menu_Render(ak_ctx, surf, menu_w, menu_h)
        DebugLog_Push("MN.rend", 7)

        // Drop from the matching toolbar chip (pad + n × (width+gap)).
        wx = Win_GetX(source_win)
        wy = Win_GetY(source_win)
        btn_x = UIScale.toolbar_pad
        IfCondition GreaterThan(menu_id, 0) ThenBlock: {
            btn_x = Add(btn_x, Multiply(menu_id, Add(UIScale.toolbar_btn_w, UIScale.toolbar_gap)))
        }
        scr_x = Add(wx, btn_x)
        scr_y = wy

        MenuState.surface    = surf
        MenuState.width      = menu_w
        MenuState.height     = menu_h
        MenuState.screen_x   = scr_x
        MenuState.screen_y   = scr_y
        MenuState.menu_id    = menu_id
        MenuState.source_win = source_win
        MenuState.open       = 1

        SysDisplayState.dirty = 1

        PrintMessage("[Menu] opened id=")
        PrintNumber(menu_id)
        PrintMessage(" size=")
        PrintNumber(menu_w)
        PrintMessage("x")
        PrintNumber(menu_h)
        PrintMessage(" at ")
        PrintNumber(scr_x)
        PrintMessage(",")
        PrintNumber(scr_y)
        PrintMessage("\n")
        ReturnValue(1)
    }
}

// =============================================================================
// CLOSE
// =============================================================================
Function.Menu_Close {
    Body: {
        DebugLog_Push("mn.cls", 6)
        IfCondition EqualTo(MenuState.open, 0) ThenBlock: { ReturnValue(0) }

        surf = MenuState.surface
        IfCondition NotEqual(surf, 0) ThenBlock: {
            DebugLog_Push("mn.cls.1", 8)
            Surface_Destroy(surf)
            MenuState.surface = 0
        }

        ak_ctx = MenuState.ak_ctx
        IfCondition NotEqual(ak_ctx, 0) ThenBlock: {
            DebugLog_Push("mn.cls.2", 8)
            AK_DestroyContext(ak_ctx)
            MenuState.ak_ctx = 0
        }

        MenuState.open       = 0
        MenuState.menu_id    = -1
        MenuState.source_win = -1
        SysDisplayState.dirty = 1
    }
}

// =============================================================================
// HIT TEST
// =============================================================================
Function.Menu_HitTest {
    Input: mx: Integer
    Input: my: Integer
    Output: Integer
    Body: {
        DebugLog_Push("mn.ht", 5)
        IfCondition EqualTo(MenuState.open, 0) ThenBlock: { ReturnValue(0) }
        sx = MenuState.screen_x
        sy = MenuState.screen_y
        w  = MenuState.width
        h  = MenuState.height
        IfCondition And(
            And(GreaterEqual(mx, sx), LessThan(mx, Add(sx, w))),
            And(GreaterEqual(my, sy), LessThan(my, Add(sy, h)))
        ) ThenBlock: {
            ReturnValue(1)
        }
        ReturnValue(0)
    }
}

// =============================================================================
// EVENT — dispatch mouse into menu AKContext
// =============================================================================
Function.Menu_Event {
    Input: screen_x: Integer
    Input: screen_y: Integer
    Input: mouse_ev: Integer
    Output: Integer
    Body: {
        DebugLog_Push("mn.evt", 6)
        IfCondition EqualTo(MenuState.open, 0) ThenBlock: { ReturnValue(0) }
        ak_ctx = MenuState.ak_ctx
        IfCondition EqualTo(ak_ctx, 0) ThenBlock: { ReturnValue(0) }
        surf = MenuState.surface
        IfCondition EqualTo(surf, 0) ThenBlock: { ReturnValue(0) }

        local_x = Subtract(screen_x, MenuState.screen_x)
        local_y = Subtract(screen_y, MenuState.screen_y)

        DebugLog_Push("mn.ev.1", 7)
        AK_SetActionCb(ak_ctx, AddressOf(EventRouter_NoOpCallback))

        DebugLog_Push("mn.ev.2", 7)
        AK_EventMouse(ak_ctx, local_x, local_y, mouse_ev, 0)

        // Redraw on state changes (hover/pressed visual feedback)
        IfCondition GreaterThan(AK_GetDirtyCount(ak_ctx), 0) ThenBlock: {
            DebugLog_Push("mn.ev.3", 7)
            Menu_Render(ak_ctx, surf, MenuState.width, MenuState.height)
            AK_SetDirtyCount(ak_ctx, 0)
            SysDisplayState.dirty = 1
        }

        // Capture fired action on UP
        fired_ptr = 0
        fired_len = 0
        IfCondition EqualTo(mouse_ev, AKMouseEv.UP) ThenBlock: {
            fn = AK_GetFocusNode(ak_ctx)
            IfCondition GreaterEqual(fn, 0) ThenBlock: {
                ap = AK_ExtraGet(ak_ctx, fn, AKExtra.ACTION_PTR)
                al = AK_ExtraGet(ak_ctx, fn, AKExtra.ACTION_LEN)
                IfCondition And(NotEqual(ap, 0), GreaterThan(al, 0)) ThenBlock: {
                    fired_ptr = ap
                    fired_len = al
                }
            }
        }

        DebugLog_Push("mn.ev.4", 7)

        // Push action and close menu
        IfCondition NotEqual(fired_ptr, 0) ThenBlock: {
            DebugLog_Push("mn.ev.5", 7)
            source = MenuState.source_win
            EventRouter_Push(fired_ptr, fired_len, source)
            Menu_Close()
        }

        ReturnValue(0)
    }
}

// =============================================================================
// BLIT — draw menu surface to framebuffer (called from Win_BlitAll)
// =============================================================================
Function.Menu_Blit {
    Body: {
        DebugLog_Push("mn.blt", 6)
        IfCondition EqualTo(MenuState.open, 0) ThenBlock: { ReturnValue(0) }
        surf = MenuState.surface
        IfCondition EqualTo(surf, 0) ThenBlock: { ReturnValue(0) }
        Win_BlitOne(surf, MenuState.screen_x, MenuState.screen_y)
    }
}
