// ─── Library.StartMenu.ailang ────────────────────────────────────────────────
// Windows XP/7-style Start Menu — popup panel above deskbar.
// Opened by "Home" button in deskbar left zone. Lists app services from
// PostgreSQL + system items (About, Screenshot, Quit).
// Follows Menu pattern: own AKContext, own surface, positioned overlay,
// blitted in Win_BlitAll.
// Copyright © 2026 Sean Collins, 2 Paws Machine and Engineering. SCSL.

LibraryImport.Display.Render.DSurfaceTypes
LibraryImport.Display.Render.DSurface
LibraryImport.Display.Render.DDrawPixel
LibraryImport.Display.Render.SurfaceBlit
LibraryImport.Display.UI.Auckland
LibraryImport.Display.UI.AucklandEvent
LibraryImport.Display.Window.WinManager
LibraryImport.Display.Render.Fonts
LibraryImport.Display.UI.TextRegion
LibraryImport.Display.System.SysDisplay
LibraryImport.Display.Render.VIcon
LibraryImport.Display.System.EventRouter
LibraryImport.Display.Theme.UIScale
LibraryImport.Display.Theme.UITheme
LibraryImport.Display.Menu.Deskbar
LibraryImport.Display.Menu.CascadeMenu

// =============================================================================
// STATE
// =============================================================================
FixedPool.StartMenuState {
    "open":       Initialize=0, CanChange=True
    "surface":    Initialize=0, CanChange=True
    "ak_ctx":     Initialize=0, CanChange=True
    "screen_x":   Initialize=0, CanChange=True
    "screen_y":   Initialize=0, CanChange=True
    "width":      Initialize=200, CanChange=True
    "height":     Initialize=0, CanChange=True
}

FixedPool.StartMenuConst {
    "ITEM_W":  Initialize=160, CanChange=True
    "ITEM_H":  Initialize=26, CanChange=True
    "PAD":     Initialize=4, CanChange=True
    "BG":      Initialize=0xFF0E1730, CanChange=True
    "FG":      Initialize=0xFFE8EEF8, CanChange=True
    "SEP_CLR": Initialize=0xFF2A4068, CanChange=True
}

// =============================================================================
// INIT
// =============================================================================
Function.StartMenu_Init {
    Output: Integer
    Body: {
        DebugLog_Push("sm.init", 7)
        StartMenuState.open    = 0
        StartMenuState.ak_ctx  = 0
        StartMenuState.surface = 0

        // Use menu dimensions from UIScale if available, else defaults
        StartMenuConst.ITEM_W = UIScale.menu_item_w
        StartMenuConst.ITEM_H = UIScale.menu_item_h
        StartMenuConst.PAD    = UIScale.menu_pad

        // Use menu theme colors (start menu shares menu palette)
        StartMenuConst.BG      = Theme.menu_bg
        StartMenuConst.FG      = Theme.menu_fg
        StartMenuConst.SEP_CLR = Theme.menu_sep

        ReturnValue(1)
    }
}

// =============================================================================
// ADD ITEM / SEPARATOR — same pattern as Menu
// =============================================================================
Function.StartMenu_AddItem {
    Input: ctx: LinkagePool.AKContext
    Input: parent: Integer
    Input: label_ptr: Integer
    Input: label_len: Integer
    Input: action_ptr: Integer
    Input: action_len: Integer
    Body: {
        w = StartMenuConst.ITEM_W
        h = StartMenuConst.ITEM_H
        btn = AK_CreateNode(ctx, AKTag.BUTTON)
        AK_Set(ctx, btn, AKF.WIDTH, w)
        AK_Set(ctx, btn, AKF.HEIGHT, h)
        AK_ExtraSet(ctx, btn, AKExtra.STR_PTR, label_ptr)
        AK_ExtraSet(ctx, btn, AKExtra.STR_LEN, label_len)
        AK_ExtraSet(ctx, btn, AKExtra.ACTION_PTR, action_ptr)
        AK_ExtraSet(ctx, btn, AKExtra.ACTION_LEN, action_len)
        AK_ExtraSet(ctx, btn, AKExtra.TEXT_ALIGN, TRAlign.LEFT)
        AK_ExtraSet(ctx, btn, AKExtra.COLOR_BG, StartMenuConst.BG)
        AK_ExtraSet(ctx, btn, AKExtra.COLOR_FG, StartMenuConst.FG)
        AK_AddChild(ctx, parent, btn)
    }
}

Function.StartMenu_AddSeparator {
    Input: ctx: LinkagePool.AKContext
    Input: parent: Integer
    Body: {
        w = StartMenuConst.ITEM_W
        sep = AK_CreateNode(ctx, AKTag.SEPARATOR)
        AK_Set(ctx, sep, AKF.HEIGHT, UIScale.ak_separator_w)
        AK_Set(ctx, sep, AKF.WIDTH, w)
        AK_ExtraSet(ctx, sep, AKExtra.COLOR_FG, StartMenuConst.SEP_CLR)
        AK_AddChild(ctx, parent, sep)
    }
}

// =============================================================================
// COMPUTE HEIGHT — sum item heights + padding (same as Menu_ComputeHeight)
// =============================================================================
Function.StartMenu_ComputeHeight {
    Input: ctx: LinkagePool.AKContext
    Input: root: Integer
    Output: Integer
    Body: {
        h = Multiply(StartMenuConst.PAD, 2)
        child = AK_Get(ctx, root, AKF.FIRST_CHILD)
        guard = 0
        WhileLoop NotEqual(child, -1) {
            guard = Add(guard, 1)
            IfCondition GreaterThan(guard, 64) ThenBlock: { ReturnValue(h) }
            tag = AK_Get(ctx, child, AKF.TAG)
            IfCondition EqualTo(tag, AKTag.SEPARATOR) ThenBlock: {
                h = Add(h, UIScale.ak_separator_w)
            } ElseBlock: {
                h = Add(h, StartMenuConst.ITEM_H)
            }
            child = AK_Get(ctx, child, AKF.NEXT_SIBLING)
        }
        ReturnValue(h)
    }
}

// =============================================================================
// BUILD TREE — apps from deskbar service cache + system items
// =============================================================================
Function.StartMenu_BuildTree {
    Input: ctx: LinkagePool.AKContext
    Input: root: Integer
    Body: {
        DebugLog_Push("sm.bld", 6)

        // Category: Programs — opens cascade submenu with app services
        StartMenu_AddItem(ctx, root, "Programs >", 10, "sm.programs", 11)

        // Category: System — opens cascade submenu with system tools
        StartMenu_AddItem(ctx, root, "System >", 8, "sm.system", 9)

        StartMenu_AddSeparator(ctx, root)

        // Search — placeholder for future PostgreSQL file search
        StartMenu_AddItem(ctx, root, "Search", 6, "app.search", 10)

        StartMenu_AddSeparator(ctx, root)

        // Restart Display (debug — restarts display.x via service daemon)
        StartMenu_AddItem(ctx, root, "Restart Display", 15, "app.quit", 8)
    }
}

// =============================================================================
// RENDER — solve + draw start menu tree into surface
// =============================================================================
Function.StartMenu_Render {
    Input: ctx: LinkagePool.AKContext
    Input: surf: Integer
    Input: w: Integer
    Input: h: Integer
    Body: {
        DebugLog_Push("sm.ren", 6)
        // Fill background
        Draw_Pix_FillRect(surf, 0, 0, w, h, StartMenuConst.BG)
        // Solve and draw the AK tree
        VFont_UseSize(UIScale.font_menu)
        AK_Draw(ctx, surf, w, h)
        VFont_UseSize(UIScale.font_body)

        // Logo is now rendered natively via ICON_SURF on the Start button
    }
}

// =============================================================================
// TOGGLE — open or close the start menu
// =============================================================================
Function.StartMenu_Toggle {
    Output: Integer
    Body: {
        DebugLog_Push("sm.tog", 6)

        // If already open, close
        IfCondition EqualTo(StartMenuState.open, 1) ThenBlock: {
            StartMenu_Close()
            ReturnValue(0)
        }

        // Close any open dropdown menu first
        IfCondition EqualTo(MenuState.open, 1) ThenBlock: {
            Menu_Close()
        }

        // Free leftover context if any
        old_ctx = StartMenuState.ak_ctx
        IfCondition NotEqual(old_ctx, 0) ThenBlock: {
            AK_DestroyContext(old_ctx)
            StartMenuState.ak_ctx = 0
        }

        // Create AKContext
        ak_ctx = AK_CreateContext()
        IfCondition EqualTo(ak_ctx, 0) ThenBlock: {
            PrintMessage("[StartMenu] AKContext alloc failed\n")
            ReturnValue(0)
        }
        StartMenuState.ak_ctx = ak_ctx

        // Build tree — PANEL root with VBOX layout
        root = AK_CreateNode(ak_ctx, AKTag.PANEL)
        AK_Set(ak_ctx, root, AKF.LAYOUT_MODE, AKLayout.VBOX)
        AK_Set(ak_ctx, root, AKF.GAP, 0)
        AK_Set(ak_ctx, root, AKF.PAD_T, StartMenuConst.PAD)
        AK_Set(ak_ctx, root, AKF.PAD_R, StartMenuConst.PAD)
        AK_Set(ak_ctx, root, AKF.PAD_B, StartMenuConst.PAD)
        AK_Set(ak_ctx, root, AKF.PAD_L, StartMenuConst.PAD)
        AK_ExtraSet(ak_ctx, root, AKExtra.COLOR_BG, StartMenuConst.BG)
        AK_ExtraSet(ak_ctx, root, AKExtra.BORDER_W, UIScale.menu_border_w)
        AK_ExtraSet(ak_ctx, root, AKExtra.BORDER_CLR, StartMenuConst.SEP_CLR)
        AK_SetRoot(ak_ctx, root)

        // Populate with app services + system items
        StartMenu_BuildTree(ak_ctx, root)

        // Compute surface size
        menu_w = Add(StartMenuConst.ITEM_W, Multiply(StartMenuConst.PAD, 2))
        menu_h = StartMenu_ComputeHeight(ak_ctx, root)

        // Create surface
        surf = Surface_Create(SurfaceFormat.PIXEL_32, menu_w, menu_h)
        IfCondition EqualTo(surf, 0) ThenBlock: {
            PrintMessage("[StartMenu] surface alloc failed\n")
            AK_DestroyContext(ak_ctx)
            StartMenuState.ak_ctx = 0
            ReturnValue(0)
        }

        // Set design dimensions to match surface
        AK_SetDesignW(ak_ctx, menu_w)
        AK_SetDesignH(ak_ctx, menu_h)

        // Render
        StartMenu_Render(ak_ctx, surf, menu_w, menu_h)

        // Position: anchored at bottom-left, above deskbar
        scr_x = UIScale.deskbar_pad_lr
        db_h = DeskbarState.height
        hot_h = DeskbarState.hotzone_h
        scr_h = DeskbarState.screen_h
        scr_y = Subtract(scr_h, Add(Add(db_h, hot_h), menu_h))

        StartMenuState.surface  = surf
        StartMenuState.width    = menu_w
        StartMenuState.height   = menu_h
        StartMenuState.screen_x = scr_x
        StartMenuState.screen_y = scr_y
        StartMenuState.open     = 1

        SysDisplayState.dirty = 1

        PrintMessage("[StartMenu] opened size=")
        PrintNumber(menu_w)
        PrintMessage("x")
        PrintNumber(menu_h)
        PrintMessage(" at ")
        PrintNumber(scr_x)
        PrintMessage(",")
        PrintNumber(scr_y)
        PrintMessage("\n")
        ReturnValue(1)
    }
}

// =============================================================================
// CLOSE
// =============================================================================
Function.StartMenu_Close {
    Body: {
        DebugLog_Push("sm.cls", 6)

        // Close cascade submenu if open
        CascadeMenu_Close()

        IfCondition EqualTo(StartMenuState.open, 0) ThenBlock: { ReturnValue(0) }

        surf = StartMenuState.surface
        IfCondition NotEqual(surf, 0) ThenBlock: {
            Surface_Destroy(surf)
            StartMenuState.surface = 0
        }

        ak_ctx = StartMenuState.ak_ctx
        IfCondition NotEqual(ak_ctx, 0) ThenBlock: {
            AK_DestroyContext(ak_ctx)
            StartMenuState.ak_ctx = 0
        }

        StartMenuState.open = 0
        SysDisplayState.dirty = 1
    }
}

// =============================================================================
// HIT TEST
// =============================================================================
Function.StartMenu_HitTest {
    Input: mx: Integer
    Input: my: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(StartMenuState.open, 0) ThenBlock: { ReturnValue(0) }
        sx = StartMenuState.screen_x
        sy = StartMenuState.screen_y
        w  = StartMenuState.width
        h  = StartMenuState.height
        IfCondition And(
            And(GreaterEqual(mx, sx), LessThan(mx, Add(sx, w))),
            And(GreaterEqual(my, sy), LessThan(my, Add(sy, h)))
        ) ThenBlock: {
            ReturnValue(1)
        }
        ReturnValue(0)
    }
}

// =============================================================================
// EVENT — dispatch mouse into start menu AKContext
// =============================================================================
Function.StartMenu_Event {
    Input: screen_x: Integer
    Input: screen_y: Integer
    Input: mouse_ev: Integer
    Output: Integer
    Body: {
        DebugLog_Push("sm.evt", 6)
        IfCondition EqualTo(StartMenuState.open, 0) ThenBlock: { ReturnValue(0) }
        ak_ctx = StartMenuState.ak_ctx
        IfCondition EqualTo(ak_ctx, 0) ThenBlock: { ReturnValue(0) }
        surf = StartMenuState.surface
        IfCondition EqualTo(surf, 0) ThenBlock: { ReturnValue(0) }

        local_x = Subtract(screen_x, StartMenuState.screen_x)
        local_y = Subtract(screen_y, StartMenuState.screen_y)

        AK_SetActionCb(ak_ctx, AddressOf(EventRouter_NoOpCallback))
        AK_EventMouse(ak_ctx, local_x, local_y, mouse_ev, 0)

        // Redraw on hover/pressed state changes
        IfCondition GreaterThan(AK_GetDirtyCount(ak_ctx), 0) ThenBlock: {
            StartMenu_Render(ak_ctx, surf, StartMenuState.width, StartMenuState.height)
            AK_SetDirtyCount(ak_ctx, 0)
            SysDisplayState.dirty = 1
        }

        // Capture fired action on UP
        fired_ptr = 0
        fired_len = 0
        IfCondition EqualTo(mouse_ev, AKMouseEv.UP) ThenBlock: {
            fn = AK_GetFocusNode(ak_ctx)
            IfCondition GreaterEqual(fn, 0) ThenBlock: {
                ap = AK_ExtraGet(ak_ctx, fn, AKExtra.ACTION_PTR)
                al = AK_ExtraGet(ak_ctx, fn, AKExtra.ACTION_LEN)
                IfCondition And(NotEqual(ap, 0), GreaterThan(al, 0)) ThenBlock: {
                    fired_ptr = ap
                    fired_len = al
                }
            }
        }

        // Handle fired action
        IfCondition NotEqual(fired_ptr, 0) ThenBlock: {
            // Check if this is a submenu action (sm.*)
            is_sm = 0
            IfCondition GreaterEqual(fired_len, 3) ThenBlock: {
                b0 = GetByte(fired_ptr, 0)
                b1 = GetByte(fired_ptr, 1)
                b2 = GetByte(fired_ptr, 2)
                // "sm." = 115 109 46
                IfCondition And(EqualTo(b0, 115), And(EqualTo(b1, 109), EqualTo(b2, 46))) ThenBlock: {
                    is_sm = 1
                }
            }
            IfCondition EqualTo(is_sm, 1) ThenBlock: {
                // Open cascade submenu — compute anchor to right of start menu
                anchor_x = Add(StartMenuState.screen_x, Add(StartMenuState.width, UIScale.cascade_menu_gap))
                // Determine which category was clicked for Y alignment
                // Programs = first item (offset = PAD)
                // System = second item (offset = PAD + ITEM_H)
                cmp_prg = StringCompare(fired_ptr, "sm.programs")
                IfCondition EqualTo(cmp_prg, 0) ThenBlock: {
                    anchor_y = Add(StartMenuState.screen_y, StartMenuConst.PAD)
                    CascadeMenu_Show(0, anchor_x, anchor_y)
                }
                cmp_sys = StringCompare(fired_ptr, "sm.system")
                IfCondition EqualTo(cmp_sys, 0) ThenBlock: {
                    anchor_y = Add(StartMenuState.screen_y, Add(StartMenuConst.PAD, StartMenuConst.ITEM_H))
                    CascadeMenu_Show(1, anchor_x, anchor_y)
                }
                SysDisplayState.dirty = 1
            } ElseBlock: {
                // Regular action — push to EventRouter and close
                EventRouter_Push(fired_ptr, fired_len, 0)
                StartMenu_Close()
            }
        }

        ReturnValue(0)
    }
}

// =============================================================================
// BLIT — draw start menu surface to framebuffer (called from Win_BlitAll)
// =============================================================================
Function.StartMenu_Blit {
    Body: {
        IfCondition EqualTo(StartMenuState.open, 0) ThenBlock: { ReturnValue(0) }
        surf = StartMenuState.surface
        IfCondition EqualTo(surf, 0) ThenBlock: { ReturnValue(0) }
        Win_BlitOne(surf, StartMenuState.screen_x, StartMenuState.screen_y)
    }
}
