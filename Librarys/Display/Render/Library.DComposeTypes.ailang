//
// Library.DComposeTypes.ailang
// BSP compositor type constants and field descriptors
// Phase 4: Axis 2 — Compose
//
// Usage: LibraryImport.DComposeTypes

// =============================================================================
// BSP NODE TYPE
// =============================================================================
FixedPool.BSPNodeType {
    "SPLIT_H": Initialize=0    // horizontal split — top/bottom children
    "SPLIT_V": Initialize=1    // vertical split — left/right children
    "LEAF":    Initialize=2    // contains a stack group
}

// =============================================================================
// BSP NODE FIELDS
// Every node is 88 bytes (11 fields × 8 bytes)
// Split nodes use: TYPE PARENT REGION_X REGION_Y REGION_W REGION_H SPLIT_POS SPLIT_MIN CHILD_A CHILD_B
// Leaf nodes use:  TYPE PARENT REGION_X REGION_Y REGION_W REGION_H STACK_GROUP
// =============================================================================
FixedPool.BSPNodeFields {
    "TYPE":        Initialize=0    // BSPNodeType value
    "PARENT":      Initialize=8    // parent node handle (0 = root)
    "REGION_X":    Initialize=16   // logical x of this node's region
    "REGION_Y":    Initialize=24   // logical y
    "REGION_W":    Initialize=32   // logical width
    "REGION_H":    Initialize=40   // logical height
    "SPLIT_POS":   Initialize=48   // split offset within region (split nodes)
    "SPLIT_MIN":   Initialize=56   // minimum split position
    "CHILD_A":     Initialize=64   // left/top child (split nodes)
    "CHILD_B":     Initialize=72   // right/bottom child (split nodes)
    "STACK_GROUP": Initialize=80   // pointer to stack group (leaf nodes)
}

FixedPool.BSPNodeConst {
    "SIZE": Initialize=88
}

// =============================================================================
// STACK GROUP FIELDS
// A BSP leaf points to one stack group
// Stack group holds 1..N surfaces (tabs)
// Only SURFACES[ACTIVE_INDEX] is composited
// =============================================================================
FixedPool.StackGroupFields {
    "SURFACE_COUNT": Initialize=0    // number of surfaces in group
    "SURFACES":      Initialize=8    // pointer to array of surface handles
    "ACTIVE_INDEX":  Initialize=16   // which surface is visible
    "TAB_NAMES":     Initialize=24   // pointer to array of name string pointers
    "BSP_LEAF":      Initialize=32   // back-pointer to owning BSP leaf
    "DECORATOR_ID":  Initialize=40   // which decorator draws chrome
}

FixedPool.StackGroupConst {
    "SIZE":     Initialize=48
    "MAX_TABS": Initialize=16    // max surfaces per stack group
}

// =============================================================================
// FLOAT ENTRY FIELDS
// Floating windows — transient, during drag or before snap
// 42 is enough. If you have 42 tables open, stop.
// =============================================================================
FixedPool.FloatEntryFields {
    "SURFACE":  Initialize=0
    "X":        Initialize=8
    "Y":        Initialize=16
    "W":        Initialize=24
    "H":        Initialize=32
    "Z_ORDER":  Initialize=40
    "DRAGGING": Initialize=48
}

FixedPool.FloatEntryConst {
    "SIZE":           Initialize=56
    "MAX_FLOATING":   Initialize=42
    "SNAP_THRESHOLD": Initialize=8
    "TAB_DROP_ZONE":  Initialize=24
}

// =============================================================================
// COMPOSITOR STATE
// Global compositor state — one instance
// =============================================================================
FixedPool.Compositor {
    "root":          Initialize=0    // BSP root node handle
    "screen_w":      Initialize=0    // logical screen width
    "screen_h":      Initialize=0    // logical screen height
    "focused_leaf":  Initialize=0    // currently focused BSP leaf
    "focus_mode":    Initialize=0    // 0=click 1=sloppy 2=sloppy+raise
    "float_count":   Initialize=0    // number of active floats
    "stack_pending": Initialize=0    // Alt+S stack mode active
    "initialized":   Initialize=0
}

// Focus modes
FixedPool.FocusMode {
    "CLICK_TO_FOCUS":      Initialize=0
    "FOCUS_FOLLOWS_MOUSE": Initialize=1
    "FOCUS_FOLLOWS_RAISE": Initialize=2
}