//
// Library.DDrawCell.ailang
// Draw primitives for CELL_32 surfaces
// Axis 1: Draw — put shapes/text into a surface
//
// All operations are bounds-checked. Nothing draws outside surface dimensions.
// INVARIANT 5: Draw operations that would exceed surface bounds are clamped/rejected.
//
// Usage: LibraryImport.DDrawCell

LibraryImport.Display.Render.DSurfaceTypes
LibraryImport.Display.Render.DSurface

// =============================================================================
// INTERNAL: write one cell — no bounds check, caller validates
// Split into two calls to stay within 6-arg ABI limit
// =============================================================================
Function.DCell_PutCell {
    Input: surf: Integer
    Input: x:    Integer
    Input: y:    Integer
    Input: ch:   Integer
    Input: fg:   Integer
    Input: bg:   Integer
    Body: {
        cell = Surface_CellAt(surf, x, y)
        SetByte(cell, CellOffset.CHAR, ch)
        SetByte(cell, CellOffset.FG,   fg)
        SetByte(cell, CellOffset.BG,   bg)
        SetByte(cell, CellOffset.ATTR, 0)
    }
}

Function.DCell_PutCellAttr {
    Input: surf: Integer
    Input: x:    Integer
    Input: y:    Integer
    Input: ch:   Integer
    Input: fg:   Integer
    Input: bg:   Integer
    Body: {
        // attr passed via global slot — caller sets DCell_Attr first
        cell = Surface_CellAt(surf, x, y)
        SetByte(cell, CellOffset.CHAR, ch)
        SetByte(cell, CellOffset.FG,   fg)
        SetByte(cell, CellOffset.BG,   bg)
        SetByte(cell, CellOffset.ATTR, DCell_State.attr)
    }
}

FixedPool.DCell_State {
    "attr": Initialize=0
}

// =============================================================================
// DRAW_FILLRECT
// Fill a rectangle with a single character and color
// Clamped to surface bounds
// =============================================================================
Function.Draw_FillRect {
    Input: surf: Integer
    Input: x:    Integer
    Input: y:    Integer
    Input: w:    Integer
    Input: h:    Integer
    Input: ch:   Integer
    Input: fg:   Integer
    Input: bg:   Integer
    Body: {
        sw = Surface_GetWidth(surf)
        sh = Surface_GetHeight(surf)

        // Clamp to surface bounds
        x0 = x
        y0 = y
        x1 = Add(x, w)
        y1 = Add(y, h)

        IfCondition LessThan(x0, 0)    ThenBlock: { x0 = 0 }
        IfCondition LessThan(y0, 0)    ThenBlock: { y0 = 0 }
        IfCondition GreaterThan(x1, sw) ThenBlock: { x1 = sw }
        IfCondition GreaterThan(y1, sh) ThenBlock: { y1 = sh }

        IfCondition Not(LessThan(x0, x1)) ThenBlock: { ReturnValue(0) }
        IfCondition Not(LessThan(y0, y1)) ThenBlock: { ReturnValue(0) }

        row = y0
        WhileLoop LessThan(row, y1) {
            col = x0
            WhileLoop LessThan(col, x1) {
                DCell_PutCell(surf, col, row, ch, fg, bg)
                col = Add(col, 1)
            }
            row = Add(row, 1)
        }
    }
}

// =============================================================================
// DRAW_RECT
// Draw a border rectangle — only the edges, interior untouched
// Uses ASCII box chars: + corners, - horizontal, | vertical
// =============================================================================
Function.Draw_Rect {
    Input: surf: Integer
    Input: x:    Integer
    Input: y:    Integer
    Input: w:    Integer
    Input: h:    Integer
    Input: fg:   Integer
    Input: bg:   Integer
    Body: {
        IfCondition LessThan(w, 2) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(h, 2) ThenBlock: { ReturnValue(0) }

        x1 = Subtract(Add(x, w), 1)
        y1 = Subtract(Add(y, h), 1)

        // Corners
        IfCondition EqualTo(Surface_InBounds(surf, x,  y),  1) ThenBlock: { DCell_PutCell(surf, x,  y,  43, fg, bg) }
        IfCondition EqualTo(Surface_InBounds(surf, x1, y),  1) ThenBlock: { DCell_PutCell(surf, x1, y,  43, fg, bg) }
        IfCondition EqualTo(Surface_InBounds(surf, x,  y1), 1) ThenBlock: { DCell_PutCell(surf, x,  y1, 43, fg, bg) }
        IfCondition EqualTo(Surface_InBounds(surf, x1, y1), 1) ThenBlock: { DCell_PutCell(surf, x1, y1, 43, fg, bg) }

        // Top and bottom edges
        col = Add(x, 1)
        WhileLoop LessThan(col, x1) {
            IfCondition EqualTo(Surface_InBounds(surf, col, y),  1) ThenBlock: { DCell_PutCell(surf, col, y,  45, fg, bg) }
            IfCondition EqualTo(Surface_InBounds(surf, col, y1), 1) ThenBlock: { DCell_PutCell(surf, col, y1, 45, fg, bg) }
            col = Add(col, 1)
        }

        // Left and right edges
        row = Add(y, 1)
        WhileLoop LessThan(row, y1) {
            IfCondition EqualTo(Surface_InBounds(surf, x,  row), 1) ThenBlock: { DCell_PutCell(surf, x,  row, 124, fg, bg) }
            IfCondition EqualTo(Surface_InBounds(surf, x1, row), 1) ThenBlock: { DCell_PutCell(surf, x1, row, 124, fg, bg) }
            row = Add(row, 1)
        }
    }
}

// =============================================================================
// DRAW_HLINE
// Draw a horizontal line
// =============================================================================
Function.Draw_HLine {
    Input: surf: Integer
    Input: x:    Integer
    Input: y:    Integer
    Input: len:  Integer
    Input: ch:   Integer
    Input: fg:   Integer
    Input: bg:   Integer
    Body: {
        i = 0
        WhileLoop LessThan(i, len) {
            cx = Add(x, i)
            IfCondition EqualTo(Surface_InBounds(surf, cx, y), 1) ThenBlock: {
                DCell_PutCell(surf, cx, y, ch, fg, bg)
            }
            i = Add(i, 1)
        }
    }
}

// =============================================================================
// DRAW_VLINE
// Draw a vertical line
// =============================================================================
Function.Draw_VLine {
    Input: surf: Integer
    Input: x:    Integer
    Input: y:    Integer
    Input: len:  Integer
    Input: ch:   Integer
    Input: fg:   Integer
    Input: bg:   Integer
    Body: {
        i = 0
        WhileLoop LessThan(i, len) {
            cy = Add(y, i)
            IfCondition EqualTo(Surface_InBounds(surf, x, cy), 1) ThenBlock: {
                DCell_PutCell(surf, x, cy, ch, fg, bg)
            }
            i = Add(i, 1)
        }
    }
}

// =============================================================================
// DRAW_TEXT
// Write a null-terminated string into the surface at (x, y)
// Stops at end of string or surface edge — never wraps
// =============================================================================
Function.Draw_Text {
    Input: surf: Integer
    Input: x:    Integer
    Input: y:    Integer
    Input: str:  Address
    Input: fg:   Integer
    Input: bg:   Integer
    Body: {
        IfCondition EqualTo(Surface_InBounds(surf, x, y), 0) ThenBlock: {
            ReturnValue(0)
        }

        sw = Surface_GetWidth(surf)
        i  = 0

        WhileLoop 1 {
            ch = GetByte(str, i)
            IfCondition EqualTo(ch, 0) ThenBlock: { BreakLoop }

            cx = Add(x, i)
            IfCondition Not(LessThan(cx, sw)) ThenBlock: { BreakLoop }

            IfCondition EqualTo(Surface_InBounds(surf, cx, y), 1) ThenBlock: {
                DCell_PutCell(surf, cx, y, ch, fg, bg)
            }

            i = Add(i, 1)
        }
    }
}

// =============================================================================
// DRAW_TEXT_ATTR
// Same as Draw_Text but with explicit attribute flags
// attr is stored in DCell_State.attr before each cell write
// =============================================================================
Function.Draw_TextAttr {
    Input: surf: Integer
    Input: x:    Integer
    Input: y:    Integer
    Input: str:  Address
    Input: fg:   Integer
    Input: bg:   Integer
    Input: attr: Integer
    Body: {
        IfCondition EqualTo(Surface_InBounds(surf, x, y), 0) ThenBlock: {
            ReturnValue(0)
        }

        DCell_State.attr = attr
        sw = Surface_GetWidth(surf)
        i  = 0

        WhileLoop 1 {
            ch = GetByte(str, i)
            IfCondition EqualTo(ch, 0) ThenBlock: { BreakLoop }

            cx = Add(x, i)
            IfCondition Not(LessThan(cx, sw)) ThenBlock: { BreakLoop }

            IfCondition EqualTo(Surface_InBounds(surf, cx, y), 1) ThenBlock: {
                DCell_PutCellAttr(surf, cx, y, ch, fg, bg)
            }

            i = Add(i, 1)
        }
    }
}