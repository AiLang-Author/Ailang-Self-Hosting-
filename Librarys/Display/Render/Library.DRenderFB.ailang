//
// Library.DRenderFB.ailang
// Framebuffer render backend — flushes a PIXEL_32 surface to /dev/fb0
//
// Wraps Library.Framebuffer for the display system surface model.
// Requires: /dev/fb0 access (run on TTY or add user to video group)
//
// Usage: LibraryImport.DRenderFB

LibraryImport.Display.Render.Framebuffer
LibraryImport.Display.Render.DSurfaceTypes
LibraryImport.Display.Render.DSurface

// =============================================================================
// STATE
// =============================================================================
FixedPool.RenderFB {
    "initialized": Initialize=0
    "surf_width":  Initialize=0
    "surf_height": Initialize=0
}

// =============================================================================
// INIT / SHUTDOWN
// =============================================================================
Function.RenderFB_Init {
    Output: Integer
    Body: {
        result = FB_Init()
        IfCondition EqualTo(result, 0) ThenBlock: {
            PrintMessage("[RenderFB] ERROR: FB_Init failed - check /dev/fb0 access\n")
            ReturnValue(0)
        }
        RenderFB.initialized = 1
        PrintMessage("[RenderFB] Framebuffer ready\n")
        ReturnValue(1)
    }
}

Function.RenderFB_InitDouble {
    Output: Integer
    Body: {
        result = FB_InitDouble()
        IfCondition EqualTo(result, 0) ThenBlock: {
            PrintMessage("[RenderFB] ERROR: FB_InitDouble failed\n")
            ReturnValue(0)
        }
        RenderFB.initialized = 1
        PrintMessage("[RenderFB] Framebuffer ready (double buffered)\n")
        ReturnValue(1)
    }
}

SubRoutine.RenderFB_Shutdown {
    FB_Close()
    RenderFB.initialized = 0
}

// =============================================================================
// SURFACE -> FRAMEBUFFER FLUSH
// Copies a PIXEL_32 surface directly into the framebuffer draw buffer.
// The surface must match or be smaller than the physical framebuffer.
// =============================================================================
Function.RenderFB_Flush {
    Input: surf: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(RenderFB.initialized, 0) ThenBlock: {
            PrintMessage("[RenderFB] ERROR: not initialized\n")
            ReturnValue(0)
        }
        IfCondition EqualTo(surf, 0) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition NotEqual(Surface_GetFormat(surf), SurfaceFormat.PIXEL_32) ThenBlock: {
            PrintMessage("[RenderFB] ERROR: surface is not PIXEL_32\n")
            ReturnValue(0)
        }

        sw = Surface_GetWidth(surf)
        sh = Surface_GetHeight(surf)
        fw = FB_GetWidth()
        fh = FB_GetHeight()

        // Clamp to framebuffer dimensions
        blit_w = sw
        blit_h = sh
        IfCondition GreaterThan(blit_w, fw) ThenBlock: { blit_w = fw }
        IfCondition GreaterThan(blit_h, fh) ThenBlock: { blit_h = fh }

        src_data  = Surface_GetData(surf)
        src_pitch = Surface_GetPitch(surf)
        dst_buf   = FB_GetDrawBuffer()
        dst_pitch = FB.pitch

        // Row-by-row memcpy — pitch may differ between surface and framebuffer
        row_bytes = Multiply(blit_w, SurfaceConst.PIXEL_BYTES)

        y = 0
        WhileLoop LessThan(y, blit_h) {
            src_row = Add(src_data, Multiply(y, src_pitch))
            dst_row = Add(dst_buf,  Multiply(y, dst_pitch))

            // Copy one row
            MemoryCopy(dst_row, src_row, row_bytes)

            y = Add(y, 1)
        }

        // Flip if double buffered
        IfCondition EqualTo(FB.double_buffered, 1) ThenBlock: {
            FB_FlipFast()
        }

        ReturnValue(1)
    }
}

// =============================================================================
// PARTIAL FLUSH — dirty rectangle only
// =============================================================================
Function.RenderFB_FlushRect {
    Input: surf: Integer
    Input: rx:   Integer
    Input: ry:   Integer
    Input: rw:   Integer
    Input: rh:   Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(surf, 0)                                               ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(Surface_GetFormat(surf), SurfaceFormat.PIXEL_32)      ThenBlock: { ReturnValue(0) }

        sw = Surface_GetWidth(surf)
        sh = Surface_GetHeight(surf)
        fw = FB_GetWidth()
        fh = FB_GetHeight()

        // Clamp rect to both surface and framebuffer bounds
        x0 = rx
        y0 = ry
        x1 = Add(rx, rw)
        y1 = Add(ry, rh)

        IfCondition LessThan(x0, 0)    ThenBlock: { x0 = 0 }
        IfCondition LessThan(y0, 0)    ThenBlock: { y0 = 0 }
        IfCondition GreaterThan(x1, sw) ThenBlock: { x1 = sw }
        IfCondition GreaterThan(y1, sh) ThenBlock: { y1 = sh }
        IfCondition GreaterThan(x1, fw) ThenBlock: { x1 = fw }
        IfCondition GreaterThan(y1, fh) ThenBlock: { y1 = fh }

        IfCondition Not(LessThan(x0, x1)) ThenBlock: { ReturnValue(0) }
        IfCondition Not(LessThan(y0, y1)) ThenBlock: { ReturnValue(0) }

        src_data  = Surface_GetData(surf)
        src_pitch = Surface_GetPitch(surf)
        dst_buf   = FB_GetDrawBuffer()
        dst_pitch = FB.pitch

        row_bytes = Multiply(Subtract(x1, x0), SurfaceConst.PIXEL_BYTES)
        x_offset  = Multiply(x0, SurfaceConst.PIXEL_BYTES)

        y = y0
        WhileLoop LessThan(y, y1) {
            src_row = Add(Add(src_data, Multiply(y, src_pitch)), x_offset)
            dst_row = Add(Add(dst_buf,  Multiply(y, dst_pitch)), x_offset)

            MemoryCopy(dst_row, src_row, row_bytes)

            y = Add(y, 1)
        }

        IfCondition EqualTo(FB.double_buffered, 1) ThenBlock: {
            FB_FlipFast()
        }

        ReturnValue(1)
    }
}

// =============================================================================
// HELPERS — surface dimensions matching framebuffer
// =============================================================================
Function.RenderFB_GetWidth {
    Output: Integer
    Body: { ReturnValue(FB_GetWidth()) }
}

Function.RenderFB_GetHeight {
    Output: Integer
    Body: { ReturnValue(FB_GetHeight()) }
}

Function.RenderFB_GetPitch {
    Output: Integer
    Body: { ReturnValue(FB.pitch) }
}