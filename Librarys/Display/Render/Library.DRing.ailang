//
// Library.DRing.ailang
// Ring buffer create/destroy/post/drain
// Phase 3: Four-ring event architecture
//
// All fields stored raw (no bias).

LibraryImport.Arena
LibraryImport.Display.Render.DRingTypes

Function.Ring_Create {
    Input:  capacity:   Integer
    Input:  entry_size: Integer
    Output: Integer
    Body: {
        IfCondition LessEqual(capacity, 0)   ThenBlock: { ReturnValue(0) }
        IfCondition LessEqual(entry_size, 0) ThenBlock: { ReturnValue(0) }

        hdr = Allocate(RingConst.HEADER_SIZE)
        IfCondition EqualTo(hdr, 0) ThenBlock: { ReturnValue(0) }

        buf_size = Multiply(capacity, entry_size)
        buf = Allocate(buf_size)
        IfCondition EqualTo(buf, 0) ThenBlock: {
            Deallocate(hdr, RingConst.HEADER_SIZE)
            ReturnValue(0)
        }

        i = 0
        WhileLoop LessThan(i, buf_size) {
            WRMEM_8(buf, i, 0)
            i = Add(i, 1)
        }

        WRMEM_64(hdr, RingFields.BUFFER, buf)
        WRMEM_64(hdr, RingFields.HEAD, 0)
        WRMEM_64(hdr, RingFields.TAIL, 0)
        WRMEM_64(hdr, RingFields.CAPACITY, capacity)
        WRMEM_64(hdr, RingFields.COUNT, 0)
        WRMEM_64(hdr, RingFields.ENTRY_SIZE, entry_size)

        ReturnValue(hdr)
    }
}

Function.Ring_Destroy {
    Input: ring: Integer
    Body: {
        IfCondition EqualTo(ring, 0) ThenBlock: { ReturnValue(0) }

        buf        = RDMEM_64(ring, RingFields.BUFFER)
        capacity   = RDMEM_64(ring, RingFields.CAPACITY)
        entry_size = RDMEM_64(ring, RingFields.ENTRY_SIZE)

        IfCondition NotEqual(buf, 0) ThenBlock: {
            Deallocate(buf, Multiply(capacity, entry_size))
        }
        Deallocate(ring, RingConst.HEADER_SIZE)
        ReturnValue(1)
    }
}

Function.Ring_GetHead {
    Input:  ring: Integer
    Output: Integer
    Body: { ReturnValue(RDMEM_64(ring, RingFields.HEAD)) }
}

Function.Ring_GetTail {
    Input:  ring: Integer
    Output: Integer
    Body: { ReturnValue(RDMEM_64(ring, RingFields.TAIL)) }
}

Function.Ring_GetCapacity {
    Input:  ring: Integer
    Output: Integer
    Body: { ReturnValue(RDMEM_64(ring, RingFields.CAPACITY)) }
}

Function.Ring_GetCount {
    Input:  ring: Integer
    Output: Integer
    Body: { ReturnValue(RDMEM_64(ring, RingFields.COUNT)) }
}

Function.Ring_GetEntrySize {
    Input:  ring: Integer
    Output: Integer
    Body: { ReturnValue(RDMEM_64(ring, RingFields.ENTRY_SIZE)) }
}

Function.Ring_IsEmpty {
    Input:  ring: Integer
    Output: Integer
    Body: {
        count = Ring_GetCount(ring)
        IfCondition EqualTo(count, 0) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

Function.Ring_IsFull {
    Input:  ring: Integer
    Output: Integer
    Body: {
        count    = Ring_GetCount(ring)
        capacity = Ring_GetCapacity(ring)
        IfCondition GreaterEqual(count, capacity) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

Function.Ring_Post {
    Input:  ring:      Integer
    Input:  entry_ptr: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(Ring_IsFull(ring), 1) ThenBlock: { ReturnValue(0) }

        buf        = RDMEM_64(ring, RingFields.BUFFER)
        tail       = Ring_GetTail(ring)
        capacity   = Ring_GetCapacity(ring)
        entry_size = Ring_GetEntrySize(ring)

        offset = Multiply(tail, entry_size)
        dst    = Add(buf, offset)

        i = 0
        WhileLoop LessThan(i, entry_size) {
            WRMEM_8(dst, i, RDMEM_8(entry_ptr, i))
            i = Add(i, 1)
        }

        new_tail = Modulo(Add(tail, 1), capacity)
        WRMEM_64(ring, RingFields.TAIL, new_tail)

        count = Ring_GetCount(ring)
        WRMEM_64(ring, RingFields.COUNT, Add(count, 1))

        ReturnValue(1)
    }
}

Function.Ring_Drain {
    Input:  ring:    Integer
    Input:  out_ptr: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(Ring_IsEmpty(ring), 1) ThenBlock: { ReturnValue(0) }

        buf        = RDMEM_64(ring, RingFields.BUFFER)
        head       = Ring_GetHead(ring)
        capacity   = Ring_GetCapacity(ring)
        entry_size = Ring_GetEntrySize(ring)

        offset = Multiply(head, entry_size)
        src    = Add(buf, offset)

        i = 0
        WhileLoop LessThan(i, entry_size) {
            WRMEM_8(out_ptr, i, RDMEM_8(src, i))
            i = Add(i, 1)
        }

        new_head = Modulo(Add(head, 1), capacity)
        WRMEM_64(ring, RingFields.HEAD, new_head)

        count = Ring_GetCount(ring)
        WRMEM_64(ring, RingFields.COUNT, Subtract(count, 1))

        ReturnValue(1)
    }
}

Function.Ring_DropOldest {
    Input:  ring: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(Ring_IsEmpty(ring), 1) ThenBlock: { ReturnValue(0) }

        head     = Ring_GetHead(ring)
        capacity = Ring_GetCapacity(ring)
        new_head = Modulo(Add(head, 1), capacity)

        WRMEM_64(ring, RingFields.HEAD, new_head)

        count = Ring_GetCount(ring)
        WRMEM_64(ring, RingFields.COUNT, Subtract(count, 1))

        ReturnValue(1)
    }
}

Function.Ring_Peek {
    Input:  ring:    Integer
    Input:  out_ptr: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(Ring_IsEmpty(ring), 1) ThenBlock: { ReturnValue(0) }

        buf        = RDMEM_64(ring, RingFields.BUFFER)
        head       = Ring_GetHead(ring)
        entry_size = Ring_GetEntrySize(ring)
        offset     = Multiply(head, entry_size)
        src        = Add(buf, offset)

        i = 0
        WhileLoop LessThan(i, entry_size) {
            WRMEM_8(out_ptr, i, RDMEM_8(src, i))
            i = Add(i, 1)
        }

        ReturnValue(1)
    }
}