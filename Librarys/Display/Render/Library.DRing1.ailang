//
// Library.DRing1.ailang
// Ring 1 — Input Events
// Overflow policy: drop oldest MOUSE_MOVE to protect key events.
// All fields stored raw (no bias).

LibraryImport.Display.Render.DRingTypes
LibraryImport.Display.Render.DRing

FixedPool.Ring1 {
    "handle": Initialize=0
}

SubRoutine.Ring1_Init {
    Ring1.handle = Ring_Create(RingCap.RING1, RingEntry.SIZE)
    IfCondition EqualTo(Ring1.handle, 0) ThenBlock: {
        PrintMessage("[Ring1] ERROR: failed to create\n")
    }
}

SubRoutine.Ring1_Shutdown {
    IfCondition NotEqual(Ring1.handle, 0) ThenBlock: {
        Ring_Destroy(Ring1.handle)
        Ring1.handle = 0
    }
}

Function.Ring1_Post {
    Input:  event_type: Integer
    Input:  x:          Integer
    Input:  y:          Integer
    Input:  data:       Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(Ring_IsFull(Ring1.handle), 1) ThenBlock: {
            Ring_DropOldest(Ring1.handle)
        }
        entry = Allocate(RingEntry.SIZE)
        StoreValue(Add(entry, RingEntry.TYPE),    event_type)
        StoreValue(Add(entry, RingEntry.PARAM_A), x)
        StoreValue(Add(entry, RingEntry.PARAM_B), y)
        StoreValue(Add(entry, RingEntry.PARAM_C), data)
        result = Ring_Post(Ring1.handle, entry)
        Deallocate(entry, RingEntry.SIZE)
        ReturnValue(result)
    }
}

Function.Ring1_Drain {
    Input:  out_ptr: Integer
    Output: Integer
    Body: { ReturnValue(Ring_Drain(Ring1.handle, out_ptr)) }
}

Function.Ring1_IsEmpty {
    Output: Integer
    Body: { ReturnValue(Ring_IsEmpty(Ring1.handle)) }
}

Function.Ring1_Count {
    Output: Integer
    Body: { ReturnValue(Ring_GetCount(Ring1.handle)) }
}