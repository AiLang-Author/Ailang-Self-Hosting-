//
// Library.DRing2.ailang
// Ring 2 — Draw Commands
// Back-pressure on overflow (returns 0 if full).
// All fields stored raw (no bias).

LibraryImport.Display.Render.DRingTypes
LibraryImport.Display.Render.DRing

FixedPool.Ring2Cmd {
    "FILL_RECT":    Initialize=1
    "DRAW_RECT":    Initialize=2
    "DRAW_TEXT":    Initialize=3
    "DRAW_LINE":    Initialize=4
    "BLIT":         Initialize=5
    "CLEAR":        Initialize=6
    "SET_PIXEL":    Initialize=7
    "SURFACE_DIRTY": Initialize=8
}

FixedPool.Ring2 {
    "handle": Initialize=0
}

SubRoutine.Ring2_Init {
    Ring2.handle = Ring_Create(RingCap.RING2, RingEntry.SIZE)
    IfCondition EqualTo(Ring2.handle, 0) ThenBlock: {
        PrintMessage("[Ring2] ERROR: failed to create\n")
    }
}

SubRoutine.Ring2_Shutdown {
    IfCondition NotEqual(Ring2.handle, 0) ThenBlock: {
        Ring_Destroy(Ring2.handle)
        Ring2.handle = 0
    }
}

Function.Ring2_Post {
    Input:  cmd:     Integer
    Input:  surface: Integer
    Input:  param_a: Integer
    Input:  param_b: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(Ring_IsFull(Ring2.handle), 1) ThenBlock: {
            ReturnValue(0)
        }
        entry = Allocate(RingEntry.SIZE)
        StoreValue(Add(entry, RingEntry.TYPE),    cmd)
        StoreValue(Add(entry, RingEntry.PARAM_A), surface)
        StoreValue(Add(entry, RingEntry.PARAM_B), param_a)
        StoreValue(Add(entry, RingEntry.PARAM_C), param_b)
        result = Ring_Post(Ring2.handle, entry)
        Deallocate(entry, RingEntry.SIZE)
        ReturnValue(result)
    }
}

Function.Ring2_Drain {
    Input:  out_ptr: Integer
    Output: Integer
    Body: { ReturnValue(Ring_Drain(Ring2.handle, out_ptr)) }
}

Function.Ring2_IsEmpty {
    Output: Integer
    Body: { ReturnValue(Ring_IsEmpty(Ring2.handle)) }
}

Function.Ring2_Count {
    Output: Integer
    Body: { ReturnValue(Ring_GetCount(Ring2.handle)) }
}