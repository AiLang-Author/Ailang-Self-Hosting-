//
// Library.DRingTypes.ailang
// Ring buffer type constants and field descriptors
// Phase 3: Four-ring event architecture
//
// Usage: LibraryImport.DRingTypes

// =============================================================================
// RING BUFFER FIELDS
// Header struct for any ring buffer instance
// All four rings use the same layout — 48 bytes
// =============================================================================
FixedPool.RingFields {
    "BUFFER":     Initialize=0    // pointer to entry array
    "HEAD":       Initialize=8    // read position (drain)
    "TAIL":       Initialize=16   // write position (post)
    "CAPACITY":   Initialize=24   // max entries (must be power of 2)
    "COUNT":      Initialize=32   // current entries in use
    "ENTRY_SIZE": Initialize=40   // bytes per entry
}

FixedPool.RingConst {
    "HEADER_SIZE": Initialize=48
}

// =============================================================================
// RING IDENTIFIERS
// =============================================================================
FixedPool.RingID {
    "RING0": Initialize=0    // Focus/Control
    "RING1": Initialize=1    // Input Events
    "RING2": Initialize=2    // Draw Commands
    "RING3": Initialize=3    // Output/Dirty
}

// =============================================================================
// RING CAPACITIES
// =============================================================================
FixedPool.RingCap {
    "RING0": Initialize=32
    "RING1": Initialize=128
    "RING2": Initialize=256
}

// =============================================================================
// RING OVERFLOW POLICIES
// =============================================================================
FixedPool.RingOverflow {
    "BLOCK":       Initialize=0   // Block poster (Ring 0, Ring 2)
    "DROP_OLDEST": Initialize=1   // Drop oldest entry (Ring 1 mouse-move)
    "DROP_NEW":    Initialize=2   // Drop incoming entry
}

// =============================================================================
// RING 0 — Focus/Control command types
// =============================================================================
FixedPool.Ring0Cmd {
    // Window lifecycle
    "WIN_CREATE":       Initialize=1
    "WIN_DESTROY":      Initialize=2
    // Stack operations
    "STACK_ADD":        Initialize=10
    "STACK_REMOVE":     Initialize=11
    "STACK_SWITCH":     Initialize=12
    // Tile operations
    "TILE_SPLIT_H":     Initialize=20
    "TILE_SPLIT_V":     Initialize=21
    "TILE_MERGE":       Initialize=22
    "TILE_RESIZE":      Initialize=23
    // Focus
    "FOCUS_SET":        Initialize=30
    "FOCUS_MODE":       Initialize=31
    // Zone management
    "ZONE_ADD":         Initialize=40
    "ZONE_REMOVE":      Initialize=41
    "ZONE_RECONFIGURE": Initialize=42
    // Deskbar
    "DESKBAR_UPDATE":   Initialize=50
    "DESKBAR_COLLAPSE": Initialize=51
    "DESKBAR_EXPAND":   Initialize=52
    // Global
    "QUIT":             Initialize=99
}

// =============================================================================
// RING 1 — Input event types
// =============================================================================
FixedPool.Ring1Event {
    "KEY_DOWN":    Initialize=1
    "KEY_UP":      Initialize=2
    "MOUSE_MOVE":  Initialize=3
    "MOUSE_DOWN":  Initialize=4
    "MOUSE_UP":    Initialize=5
    "MOUSE_WHEEL": Initialize=6
    "RESIZE":      Initialize=7
    "TIMER":       Initialize=8
}

// =============================================================================
// RING ENTRY — generic entry layout
// All entries are the same size: 32 bytes
// Layout depends on the ring
//
// Ring 0 entry:
//   [0]  cmd_type  (Ring0Cmd value)
//   [8]  param_a   (window handle, surface, etc.)
//   [16] param_b
//   [24] param_c
//
// Ring 1 entry:
//   [0]  event_type (Ring1Event value)
//   [8]  x          (mouse x or key code)
//   [16] y          (mouse y or modifier flags)
//   [24] data       (button index, wheel delta, etc.)
//
// Ring 2 entry:
//   [0]  cmd_type   (draw command enum)
//   [8]  surface    (target surface handle)
//   [16] param_a
//   [24] param_b
// =============================================================================
FixedPool.RingEntry {
    "SIZE":    Initialize=32
    "TYPE":    Initialize=0
    "PARAM_A": Initialize=8
    "PARAM_B": Initialize=16
    "PARAM_C": Initialize=24
}