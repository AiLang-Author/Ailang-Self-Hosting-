//
// Library.DSurface.ailang
// Surface create / destroy / accessors
// Axis 0: Surface — the universal primitive
//
// All fields stored raw (no bias). DATA is a pointer, all others are integers.

LibraryImport.Arena
LibraryImport.Display.Render.DSurfaceTypes

FixedPool.SurfTmp {
    "hdr": Initialize=0, CanChange=True
    "buf": Initialize=0, CanChange=True
    "sz":  Initialize=0, CanChange=True
}

// =============================================================================
// SURFACE CREATE
// =============================================================================
Function.Surface_Create {
    Input:  format: Integer
    Input:  width:  Integer
    Input:  height: Integer
    Output: Integer
    Body: {
        IfCondition GreaterThan(width, SurfaceConst.MAX_WIDTH) ThenBlock: {
            PrintMessage("[Surface] ERROR: width exceeds MAX_WIDTH\n")
            ReturnValue(0)
        }
        IfCondition GreaterThan(height, SurfaceConst.MAX_HEIGHT) ThenBlock: {
            PrintMessage("[Surface] ERROR: height exceeds MAX_HEIGHT\n")
            ReturnValue(0)
        }
        IfCondition LessEqual(width, 0) ThenBlock: {
            PrintMessage("[Surface] ERROR: width must be > 0\n")
            ReturnValue(0)
        }
        IfCondition LessEqual(height, 0) ThenBlock: {
            PrintMessage("[Surface] ERROR: height must be > 0\n")
            ReturnValue(0)
        }

        IfCondition EqualTo(format, SurfaceFormat.CELL_32) ThenBlock: {
            pitch = Multiply(width, SurfaceConst.CELL_BYTES)
        } ElseBlock: {
            pitch = Multiply(width, SurfaceConst.PIXEL_BYTES)
        }
        data_size = Multiply(pitch, height)

        SurfTmp.hdr = Allocate(SurfaceConst.HEADER_SIZE)
        IfCondition EqualTo(SurfTmp.hdr, 0) ThenBlock: {
            PrintMessage("[Surface] ERROR: header alloc failed\n")
            ReturnValue(0)
        }

        SurfTmp.sz = data_size
        SurfTmp.buf = Allocate(SurfTmp.sz)
        IfCondition EqualTo(SurfTmp.buf, 0) ThenBlock: {
            Deallocate(SurfTmp.hdr, SurfaceConst.HEADER_SIZE)
            PrintMessage("[Surface] ERROR: buffer alloc failed\n")
            ReturnValue(0)
        }

        StoreValue(Add(SurfTmp.hdr, SurfaceFields.FORMAT),    format)
        StoreValue(Add(SurfTmp.hdr, SurfaceFields.WIDTH),     width)
        StoreValue(Add(SurfTmp.hdr, SurfaceFields.HEIGHT),    height)
        StoreValue(Add(SurfTmp.hdr, SurfaceFields.PITCH),     pitch)
        StoreValue(Add(SurfTmp.hdr, SurfaceFields.DATA),      SurfTmp.buf)
        StoreValue(Add(SurfTmp.hdr, SurfaceFields.DATA_SIZE), SurfTmp.sz)
        Surface_ZeroBuffer(SurfTmp.buf, SurfTmp.sz)

        ReturnValue(SurfTmp.hdr)
    }
}

// =============================================================================
// SURFACE DESTROY
// =============================================================================
Function.Surface_Destroy {
    Input: surf: Integer
    Body: {
        IfCondition EqualTo(surf, 0) ThenBlock: {
            ReturnValue(0)
        }
        buf       = Dereference(Add(surf, SurfaceFields.DATA))
        data_size = Dereference(Add(surf, SurfaceFields.DATA_SIZE))
        IfCondition NotEqual(buf, 0) ThenBlock: {
            Deallocate(buf, data_size)
        }
        Deallocate(surf, SurfaceConst.HEADER_SIZE)
    }
}

// =============================================================================
// ACCESSORS — all fields stored raw
// =============================================================================
Function.Surface_GetFormat {
    Input:  surf: Integer
    Output: Integer
    Body: { ReturnValue(Dereference(Add(surf, SurfaceFields.FORMAT))) }
}

Function.Surface_GetWidth {
    Input:  surf: Integer
    Output: Integer
    Body: { ReturnValue(Dereference(Add(surf, SurfaceFields.WIDTH))) }
}

Function.Surface_GetHeight {
    Input:  surf: Integer
    Output: Integer
    Body: { ReturnValue(Dereference(Add(surf, SurfaceFields.HEIGHT))) }
}

Function.Surface_GetPitch {
    Input:  surf: Integer
    Output: Integer
    Body: { ReturnValue(Dereference(Add(surf, SurfaceFields.PITCH))) }
}

Function.Surface_GetData {
    Input:  surf: Integer
    Output: Integer
    Body: { ReturnValue(Dereference(Add(surf, SurfaceFields.DATA))) }
}

Function.Surface_GetDataSize {
    Input:  surf: Integer
    Output: Integer
    Body: { ReturnValue(Dereference(Add(surf, SurfaceFields.DATA_SIZE))) }
}

// =============================================================================
// BOUNDS CHECK
// =============================================================================
Function.Surface_InBounds {
    Input:  surf: Integer
    Input:  x:    Integer
    Input:  y:    Integer
    Output: Integer
    Body: {
        IfCondition LessThan(x, 0) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(y, 0) ThenBlock: { ReturnValue(0) }
        sw = Dereference(Add(surf, SurfaceFields.WIDTH))
        sh = Dereference(Add(surf, SurfaceFields.HEIGHT))
        IfCondition Not(LessThan(x, sw)) ThenBlock: { ReturnValue(0) }
        IfCondition Not(LessThan(y, sh)) ThenBlock: { ReturnValue(0) }
        ReturnValue(1)
    }
}

// =============================================================================
// PIXEL ADDRESS
// =============================================================================
Function.Surface_PixelAt {
    Input:  surf: Integer
    Input:  x:    Integer
    Input:  y:    Integer
    Output: Integer
    Body: {
        data  = Dereference(Add(surf, SurfaceFields.DATA))
        pitch = Dereference(Add(surf, SurfaceFields.PITCH))
        offset = Add(Multiply(y, pitch), Multiply(x, SurfaceConst.PIXEL_BYTES))
        ReturnValue(Add(data, offset))
    }
}

// =============================================================================
// CELL ADDRESS
// =============================================================================
Function.Surface_CellAt {
    Input:  surf: Integer
    Input:  x:    Integer
    Input:  y:    Integer
    Output: Integer
    Body: {
        data  = Dereference(Add(surf, SurfaceFields.DATA))
        pitch = Dereference(Add(surf, SurfaceFields.PITCH))
        offset = Add(Multiply(y, pitch), Multiply(x, SurfaceConst.CELL_BYTES))
        ReturnValue(Add(data, offset))
    }
}

// =============================================================================
// INTERNAL: zero a buffer (CELL_32 surfaces only)
// =============================================================================
Function.Surface_ZeroBuffer {
    Input: buf:  Integer
    Input: size: Integer
    Body: {
        MemorySet(buf, 0, size)
    }
}