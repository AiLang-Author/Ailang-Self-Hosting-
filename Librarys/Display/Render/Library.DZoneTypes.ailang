//
// Library.DZoneTypes.ailang
// Zone type constants and field offsets for the display system
// Phase 5: single-zone full-screen FB mode
// Location: Librarys/Display/Zone/Library.DZoneTypes.ailang

// =============================================================================
// SURFACE MODE — combined vs per-zone BSP
// =============================================================================
FixedPool.SurfaceMode {
    "COMBINED": Initialize=0
    "ZONED":    Initialize=1
}

// =============================================================================
// ZONE FIELDS — one zone entry (allocated via Allocate)
// All offsets in bytes, 8 bytes per field (64-bit aligned)
// =============================================================================
FixedPool.ZoneFields {
    "X":             Initialize=0    // position in unified surface (pixels)
    "Y":             Initialize=8
    "WIDTH":         Initialize=16   // physical resolution
    "HEIGHT":        Initialize=24
    "OUTPUT_DEVICE": Initialize=32   // render backend: 0=none 1=term 2=fb
    "REFRESH_RATE":  Initialize=40   // target Hz (0 = uncapped)
    "SCALE_NUM":     Initialize=48   // DPI scale numerator   (1 = 1:1)
    "SCALE_DEN":     Initialize=56   // DPI scale denominator (1 = 1:1)
    "LOGICAL_WIDTH":  Initialize=64  // WIDTH  * SCALE_DEN / SCALE_NUM
    "LOGICAL_HEIGHT": Initialize=72  // HEIGHT * SCALE_DEN / SCALE_NUM
}

FixedPool.ZoneConst {
    "SIZE":     Initialize=80   // bytes per zone entry
    "MAX_ZONES": Initialize=8
}

// Output device type IDs (stored in ZoneFields.OUTPUT_DEVICE)
FixedPool.ZoneOutput {
    "NONE": Initialize=0
    "TERM": Initialize=1
    "FB":   Initialize=2
    "DRM":  Initialize=3
}

// =============================================================================
// DISPLAY CONFIG — global single instance
// =============================================================================
FixedPool.DisplayConfig {
    "surface_mode":   Initialize=0   // SurfaceMode.COMBINED or ZONED
    "surface_width":  Initialize=0   // total unified width  (pixels)
    "surface_height": Initialize=0   // total unified height (pixels)
    "zone_count":     Initialize=0
    "zone_table":     Initialize=0   // pointer to zone array (Allocate block)
    "bsp_root":       Initialize=0   // combined mode: single BSP root
    "zone_bsp_roots": Initialize=0   // zoned mode: array of BSP roots
    "initialized":    Initialize=0
}