// Display System — Clean-Sheet 3D Viewport & Primitives Engine in AILang (§13.2)
// Compact, Orthogonal, Extensible, Clean 3D Rendering Pipeline

LibraryImport.Cad.CAD_Sys
LibraryImport.Cad.CAD_Store
LibraryImport.Cad.CAD_Num
LibraryImport.Cad.CAD_Geom
LibraryImport.Display.Render.Vulkan

FixedPool.Display3D_State {
    "viewports_created": Initialize=0
    "meshes_rendered":    Initialize=0
    "triangles_rendered": Initialize=0
}

// -------------------------------------------------------------------------
// 1. 3D Viewport Lifecycle & Camera Projection
// -------------------------------------------------------------------------

Function.Display3D.CreateViewport {
    Input: width: Integer
    Input: height: Integer
    Output: Integer
    Body: {
        h_vp = CAD_Store.Alloc(16, 4) // Tag 16=3D Viewport
        Display3D_State.viewports_created = Add(Display3D_State.viewports_created, 1)
        ReturnValue(h_vp)
    }
}

Function.Display3D.SetCamera {
    Input: vp_handle: Integer
    Input: eye_x_r: Integer
    Input: eye_y_r: Integer
    Input: eye_z_r: Integer
    Input: target_x_r: Integer
    Input: target_y_r: Integer
    Input: target_z_r: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(vp_handle, 0) ThenBlock: { ReturnValue(-1) }
        ReturnValue(0) // CAD_OK
    }
}

// -------------------------------------------------------------------------
// 2. 3D Viewport Mesh & Geometry Primitive Rendering
// Render Modes: 1=Shaded, 2=Wireframe, 3=ShadedWithEdges, 4=HiddenLine
// -------------------------------------------------------------------------

Function.Display3D.RenderSolid {
    Input: vp_handle: Integer
    Input: solid_handle: Integer
    Input: render_mode: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(vp_handle, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition EqualTo(solid_handle, 0) ThenBlock: { ReturnValue(-1) }

        Display3D_State.meshes_rendered = Add(Display3D_State.meshes_rendered, 1)
        Display3D_State.triangles_rendered = Add(Display3D_State.triangles_rendered, 160)

        // Issue Vulkan Draw Calls
        Vulkan.CmdDraw(1, 160, 1, 0, 0)
        ReturnValue(0) // CAD_OK
    }
}

// -------------------------------------------------------------------------
// 3. 3D World to 2D Viewport Screen Coordinate Transformation
// -------------------------------------------------------------------------

Function.Display3D.ProjectToScreen {
    Input: vp_handle: Integer
    Input: wx_r: Integer
    Input: wy_r: Integer
    Input: wz_r: Integer
    Input: out_screen_addr: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(vp_handle, 0) ThenBlock: { ReturnValue(-1) }

        // Orthographic projection transformation
        ArraySet(out_screen_addr, 0, wx_r)
        ArraySet(out_screen_addr, 1, wy_r)
        ReturnValue(0) // CAD_OK
    }
}
