// Library.Fonts.ailang v2
// Vector font engine — Face + Instance model.
// Face = loaded vector data. Instance = face at a specific size with cached bitmaps.
// Multiple faces, multiple sizes simultaneously. No global render_size.
// Copyright © 2026 Sean Collins, 2 Paws Machine and Engineering. SCSL.

LibraryImport.Display.Render.DSurfaceTypes
LibraryImport.Display.Render.DSurface
LibraryImport.Display.Render.DDrawPixel
LibraryImport.Arena
LibraryImport.Display.Render.VIF
LibraryImport.Display.Render.SurfaceBlit

// =============================================================================
// GLYPH ENTRY LAYOUT (per face, unchanged from v1)
// 64 bytes per glyph. TVG data is zero-copy from the VIF file buffer.
// =============================================================================
FixedPool.FontConst {
    "MAX_GLYPHS":    Initialize=512
    "GLYPH_SIZE":    Initialize=64
    "CP_OFS":        Initialize=0
    "ADV_OFS":       Initialize=8
    "BEAR_X_OFS":    Initialize=16
    "BEAR_Y_OFS":    Initialize=24
    "SURF_OFS":      Initialize=32
    "TVG_PTR_OFS":   Initialize=40
    "TVG_LEN_OFS":   Initialize=48
    "FLAGS_OFS":     Initialize=56
}

// =============================================================================
// FONT FACE — loaded vector font (one per .vif file)
//
// Fields per face (8 bytes each):
//   glyphs      — pointer to glyph table (512 × 64 bytes)
//   glyph_count — number of registered glyphs
//   em          — em size from font metrics
//   ascender    — ascent in design units
//   descender   — descent in design units
//   line_gap    — line gap in design units
//   name        — pointer to name string
//   file_buf    — pointer to VIF file buffer (kept alive for TVG zero-copy)
//   file_size   — size of file buffer (for dealloc)
// =============================================================================
FixedPool.FaceFields {
    "GLYPHS":      Initialize=0
    "GLYPH_COUNT": Initialize=8
    "EM":          Initialize=16
    "ASCENDER":    Initialize=24
    "DESCENDER":   Initialize=32
    "LINE_GAP":    Initialize=40
    "NAME":        Initialize=48
    "FILE_BUF":    Initialize=56
    "FILE_SIZE":   Initialize=64
}

FixedPool.FaceConst {
    "ENTRY_SIZE":  Initialize=72
    "MAX":         Initialize=8
}

FixedPool.FaceTable {
    "data":  Initialize=0
    "count": Initialize=0
}

// =============================================================================
// FONT INSTANCE — a face at a specific pixel size (cached bitmaps)
//
// Fields per instance (8 bytes each):
//   face         — face handle
//   size         — render size in pixels
//   surfs        — pointer to glyph surface cache (512 × 8 bytes)
//   line_height  — precomputed scaled line height
//   baseline     — precomputed scaled baseline
//   active       — 1 = in use, 0 = free slot
// =============================================================================
FixedPool.InstFields {
    "FACE":        Initialize=0
    "SIZE":        Initialize=8
    "SURFS":       Initialize=16
    "LINE_HEIGHT": Initialize=24
    "BASELINE":    Initialize=32
    "ACTIVE":      Initialize=40
}

FixedPool.InstConst {
    "ENTRY_SIZE":  Initialize=48
    "MAX":         Initialize=16
}

FixedPool.InstTable {
    "data":  Initialize=0
    "count": Initialize=0
}

// =============================================================================
// LEGACY COMPAT — old FontState maps to default face/instance
// =============================================================================
FixedPool.FontState {
    "glyphs":       Initialize=0
    "glyph_count":  Initialize=0
    "ascender":     Initialize=0
    "descender":    Initialize=0
    "line_gap":     Initialize=0
    "em":           Initialize=1024
    "render_size":  Initialize=0
    "name":         Initialize=0
    "default_face": Initialize=-1
    "default_inst": Initialize=-1
    "draw_color":   Initialize=0, CanChange=True
}

// =============================================================================
// FACE TABLE ACCESSORS
// =============================================================================
Function.Face_Ptr {
    Input:  idx: Integer
    Output: Integer
    Body: { ReturnValue(Add(FaceTable.data, Multiply(idx, FaceConst.ENTRY_SIZE))) }
}

Function.Face_Get {
    Input:  idx: Integer
    Input:  field: Integer
    Output: Integer
    Body: { ReturnValue(Dereference(Add(Face_Ptr(idx), field))) }
}

Function.Face_Set {
    Input: idx: Integer
    Input: field: Integer
    Input: val: Integer
    Body: { StoreValue(Add(Face_Ptr(idx), field), val) }
}

// =============================================================================
// INSTANCE TABLE ACCESSORS
// =============================================================================
Function.Inst_Ptr {
    Input:  idx: Integer
    Output: Integer
    Body: { ReturnValue(Add(InstTable.data, Multiply(idx, InstConst.ENTRY_SIZE))) }
}

Function.Inst_Get {
    Input:  idx: Integer
    Input:  field: Integer
    Output: Integer
    Body: { ReturnValue(Dereference(Add(Inst_Ptr(idx), field))) }
}

Function.Inst_Set {
    Input: idx: Integer
    Input: field: Integer
    Input: val: Integer
    Body: { StoreValue(Add(Inst_Ptr(idx), field), val) }
}

// =============================================================================
// INIT — allocate face and instance tables
// =============================================================================
Function.VFont_Init {
    Output: Integer
    Body: {
        // Face table
        fsz = Multiply(FaceConst.MAX, FaceConst.ENTRY_SIZE)
        fb = Allocate(fsz)
        MemorySet(fb, 0, fsz)
        FaceTable.data = fb
        FaceTable.count = 0

        // Instance table
        isz = Multiply(InstConst.MAX, InstConst.ENTRY_SIZE)
        ib = Allocate(isz)
        MemorySet(ib, 0, isz)
        InstTable.data = ib
        InstTable.count = 0

        FontState.default_face = -1
        FontState.default_inst = -1

        PrintMessage("[Font] init ok (face+instance model)\n")
        ReturnValue(1)
    }
}

// =============================================================================
// FACE: FIND GLYPH — linear scan by codepoint in a face's glyph table
// =============================================================================
Function.VFace_FindGlyph {
    Input: face: Integer
    Input: codepoint: Integer
    Output: Integer
    Body: {
        glyphs = Face_Get(face, FaceFields.GLYPHS)
        gc     = Face_Get(face, FaceFields.GLYPH_COUNT)
        i = 0
        WhileLoop LessThan(i, gc) {
            off = Multiply(i, FontConst.GLYPH_SIZE)
            gp = Add(glyphs, off)
            cp = Dereference(Add(gp, FontConst.CP_OFS))
            IfCondition EqualTo(cp, codepoint) ThenBlock: {
                ReturnValue(i)
            }
            i = Add(i, 1)
        }
        ReturnValue(-1)
    }
}

// =============================================================================
// FACE: SCALE METRIC — design units to pixels for a face at a given size
// =============================================================================
Function.VFace_ScaleMetric {
    Input: face: Integer
    Input: size: Integer
    Input: metric_val: Integer
    Output: Integer
    Body: {
        em = Face_Get(face, FaceFields.EM)
        IfCondition EqualTo(em, 0) ThenBlock: { ReturnValue(0) }
        num = Multiply(metric_val, size)
        ReturnValue(Divide(num, em))
    }
}

// =============================================================================
// LOAD FACE — read .vif file, register glyphs, return face handle
// Replaces VFont_LoadVIF. Face owns the file buffer for TVG zero-copy.
// =============================================================================
Function.VFont_ReadU32 {
    Input: buf: Integer
    Input: off: Integer
    Output: Integer
    Body: {
        b0 = GetByte(buf, off)
        t = Add(off, 1)
        b1 = GetByte(buf, t)
        t = Add(off, 2)
        b2 = GetByte(buf, t)
        t = Add(off, 3)
        b3 = GetByte(buf, t)
        val = b0
        t = Multiply(b1, 256)
        val = Add(val, t)
        t = Multiply(b2, 65536)
        val = Add(val, t)
        t = Multiply(b3, 16777216)
        val = Add(val, t)
        ReturnValue(val)
    }
}

Function.VFont_ReadI32 {
    Input: buf: Integer
    Input: off: Integer
    Output: Integer
    Body: {
        v = VFont_ReadU32(buf, off)
        IfCondition GreaterEqual(v, 2147483648) ThenBlock: {
            v = Subtract(v, 4294967296)
        }
        ReturnValue(v)
    }
}

Function.VFont_LoadFace {
    Input: path: Integer
    Output: Integer
    Body: {
        IfCondition GreaterEqual(FaceTable.count, FaceConst.MAX) ThenBlock: {
            PrintMessage("[Font] ERROR: max faces\n")
            ReturnValue(-1)
        }

        // Open file
        fd = SystemCall(2, path, 0, 0)
        IfCondition LessThan(fd, 0) ThenBlock: {
            PrintMessage("[Font] cannot open ")
            PrintMessage(path)
            PrintMessage("\n")
            ReturnValue(-1)
        }

        // Get file size
        file_size = SystemCall(8, fd, 0, 2)
        SystemCall(8, fd, 0, 0)

        // Read entire file
        file_buf = Allocate(file_size)
        SystemCall(0, fd, file_buf, file_size)
        SystemCall(3, fd, 0, 0)

        PrintMessage("[Font] loaded ")
        PrintNumber(file_size)
        PrintMessage(" bytes from ")
        PrintMessage(path)
        PrintMessage("\n")

        // Verify magic "VIF0" = 86, 73, 70, 48
        m0 = GetByte(file_buf, 0)
        IfCondition NotEqual(m0, 86) ThenBlock: {
            PrintMessage("[Font] bad magic\n")
            Deallocate(file_buf, file_size)
            ReturnValue(-1)
        }

        // Read header
        entry_count = VFont_ReadU32(file_buf, 8)
        em_size     = VFont_ReadU32(file_buf, 16)
        ascent      = VFont_ReadU32(file_buf, 20)
        descent     = VFont_ReadI32(file_buf, 24)
        line_gap    = VFont_ReadU32(file_buf, 28)

        PrintMessage("[Font] em=")
        PrintNumber(em_size)
        PrintMessage(" ascent=")
        PrintNumber(ascent)
        PrintMessage(" descent=")
        PrintNumber(descent)
        PrintMessage(" gap=")
        PrintNumber(line_gap)
        PrintMessage(" glyphs=")
        PrintNumber(entry_count)
        PrintMessage("\n")

        // Allocate glyph table for this face
        gsz = Multiply(FontConst.MAX_GLYPHS, FontConst.GLYPH_SIZE)
        glyphs = Allocate(gsz)
        MemorySet(glyphs, 0, gsz)

        // Claim face slot
        fidx = FaceTable.count
        Face_Set(fidx, FaceFields.GLYPHS,      glyphs)
        Face_Set(fidx, FaceFields.GLYPH_COUNT,  0)
        Face_Set(fidx, FaceFields.EM,           em_size)
        Face_Set(fidx, FaceFields.ASCENDER,     ascent)
        Face_Set(fidx, FaceFields.DESCENDER,    descent)
        Face_Set(fidx, FaceFields.LINE_GAP,     line_gap)
        Face_Set(fidx, FaceFields.NAME,         path)
        Face_Set(fidx, FaceFields.FILE_BUF,     file_buf)
        Face_Set(fidx, FaceFields.FILE_SIZE,    file_size)

        // Read glyph entries — register into this face's glyph table
        pos = 96
        gcount = 0

        gri = 0
        WhileLoop LessThan(gri, entry_count) {
            cp      = VFont_ReadU32(file_buf, pos)
            adv     = VFont_ReadU32(file_buf, Add(pos, 4))
            bear_x  = VFont_ReadI32(file_buf, Add(pos, 8))
            bear_y  = VFont_ReadI32(file_buf, Add(pos, 12))
            tvg_len = VFont_ReadU32(file_buf, Add(pos, 16))
            pos = Add(pos, 20)

            // Register glyph into face's table
            IfCondition LessThan(gcount, FontConst.MAX_GLYPHS) ThenBlock: {
                off = Multiply(gcount, FontConst.GLYPH_SIZE)
                gp = Add(glyphs, off)
                StoreValue(Add(gp, FontConst.CP_OFS),      cp)
                StoreValue(Add(gp, FontConst.ADV_OFS),     adv)
                StoreValue(Add(gp, FontConst.BEAR_X_OFS),  bear_x)
                StoreValue(Add(gp, FontConst.BEAR_Y_OFS),  bear_y)
                StoreValue(Add(gp, FontConst.SURF_OFS),    0)
                StoreValue(Add(gp, FontConst.TVG_PTR_OFS), Add(file_buf, pos))
                StoreValue(Add(gp, FontConst.TVG_LEN_OFS), tvg_len)
                gcount = Add(gcount, 1)
            }

            pos = Add(pos, tvg_len)
            gri = Add(gri, 1)
        }

        Face_Set(fidx, FaceFields.GLYPH_COUNT, gcount)
        FaceTable.count = Add(FaceTable.count, 1)

        PrintMessage("[Font] face ")
        PrintNumber(fidx)
        PrintMessage(" registered ")
        PrintNumber(gcount)
        PrintMessage(" glyphs\n")

        ReturnValue(fidx)
    }
}

// =============================================================================
// CREATE INSTANCE — rasterize a face at a specific size, cache all glyphs
// Returns instance handle.
// =============================================================================
Function.VFont_CreateInstance {
    Input: face: Integer
    Input: size: Integer
    Output: Integer
    Body: {
        // Check if instance already exists for this face+size
        ei = 0
        WhileLoop LessThan(ei, InstConst.MAX) {
            IfCondition EqualTo(Inst_Get(ei, InstFields.ACTIVE), 1) ThenBlock: {
                IfCondition EqualTo(Inst_Get(ei, InstFields.FACE), face) ThenBlock: {
                    IfCondition EqualTo(Inst_Get(ei, InstFields.SIZE), size) ThenBlock: {
                        PrintMessage("[Font] instance exists face=")
                        PrintNumber(face)
                        PrintMessage(" size=")
                        PrintNumber(size)
                        PrintMessage(" → inst=")
                        PrintNumber(ei)
                        PrintMessage("\n")
                        ReturnValue(ei)
                    }
                }
            }
            ei = Add(ei, 1)
        }

        // Find free slot
        iidx = -1
        si = 0
        WhileLoop LessThan(si, InstConst.MAX) {
            IfCondition EqualTo(Inst_Get(si, InstFields.ACTIVE), 0) ThenBlock: {
                iidx = si
                si = InstConst.MAX
            } ElseBlock: {
                si = Add(si, 1)
            }
        }
        IfCondition LessThan(iidx, 0) ThenBlock: {
            PrintMessage("[Font] ERROR: max instances\n")
            ReturnValue(-1)
        }

        // Allocate glyph surface cache (512 pointers)
        surfs_size = Multiply(FontConst.MAX_GLYPHS, 8)
        surfs = Allocate(surfs_size)
        sci = 0
        WhileLoop LessThan(sci, surfs_size) { SetByte(surfs, sci, 0)  sci = Add(sci, 1) }

        // Precompute scaled metrics
        asc  = Face_Get(face, FaceFields.ASCENDER)
        desc = Face_Get(face, FaceFields.DESCENDER)
        gap  = Face_Get(face, FaceFields.LINE_GAP)
        raw_lh = Add(Add(asc, desc), gap)
        lh = VFace_ScaleMetric(face, size, raw_lh)
        bl = VFace_ScaleMetric(face, size, asc)

        // Store instance
        Inst_Set(iidx, InstFields.FACE,        face)
        Inst_Set(iidx, InstFields.SIZE,        size)
        Inst_Set(iidx, InstFields.SURFS,       surfs)
        Inst_Set(iidx, InstFields.LINE_HEIGHT, lh)
        Inst_Set(iidx, InstFields.BASELINE,    bl)
        Inst_Set(iidx, InstFields.ACTIVE,      1)
        InstTable.count = Add(InstTable.count, 1)

        // Rasterize all glyphs at target size.  TVG_ScanFill provides
        // analytical horizontal AA (sub-pixel coverage at span edges) and
        // 8-sub-scanline vertical AA, so no external supersampling needed.
        glyphs = Face_Get(face, FaceFields.GLYPHS)
        gc     = Face_Get(face, FaceFields.GLYPH_COUNT)
        ri = 0
        WhileLoop LessThan(ri, gc) {
            off = Multiply(ri, FontConst.GLYPH_SIZE)
            gp = Add(glyphs, off)
            tvg_ptr = Dereference(Add(gp, FontConst.TVG_PTR_OFS))
            tvg_len = Dereference(Add(gp, FontConst.TVG_LEN_OFS))

            gsurf = 0
            IfCondition NotEqual(tvg_ptr, 0) ThenBlock: {
                IfCondition NotEqual(tvg_len, 0) ThenBlock: {
                    gsurf = TVG_Parse(tvg_ptr, tvg_len, size)
                }
            }
            StoreValue(Add(surfs, Multiply(ri, 8)), gsurf)
            ri = Add(ri, 1)
        }

        PrintMessage("[Font] instance ")
        PrintNumber(iidx)
        PrintMessage(" face=")
        PrintNumber(face)
        PrintMessage(" size=")
        PrintNumber(size)
        PrintMessage(" lh=")
        PrintNumber(lh)
        PrintMessage(" bl=")
        PrintNumber(bl)
        PrintMessage(" glyphs=")
        PrintNumber(gc)
        PrintMessage("\n")

        ReturnValue(iidx)
    }
}

// =============================================================================
// INSTANCE: GET GLYPH SURFACE — from instance cache
// =============================================================================
Function.VInst_GetGlyphSurf {
    Input: inst: Integer
    Input: glyph_idx: Integer
    Output: Integer
    Body: {
        surfs = Inst_Get(inst, InstFields.SURFS)
        ReturnValue(Dereference(Add(surfs, Multiply(glyph_idx, 8))))
    }
}

// =============================================================================
// INSTANCE: DRAW STRING
// =============================================================================
Function.VInst_DrawString {
    Input: inst: Integer
    Input: dst_surf: Integer
    Input: str_ptr: Integer
    Input: str_len: Integer
    Input: x: Integer
    Input: y: Integer
    Body: {
        color = FontState.draw_color
        face = Inst_Get(inst, InstFields.FACE)
        size = Inst_Get(inst, InstFields.SIZE)
        glyphs = Face_Get(face, FaceFields.GLYPHS)
        cur_x = x

        si = 0
        WhileLoop LessThan(si, str_len) {
            cp = GetByte(str_ptr, si)
            gidx = VFace_FindGlyph(face, cp)

            IfCondition EqualTo(gidx, -1) ThenBlock: {
                // Unknown glyph — advance by half size
                cur_x = Add(cur_x, Divide(size, 2))
            }

            IfCondition NotEqual(gidx, -1) ThenBlock: {
                // Get advance from face
                off = Multiply(gidx, FontConst.GLYPH_SIZE)
                gp = Add(glyphs, off)
                adv = Dereference(Add(gp, FontConst.ADV_OFS))
                sadv = VFace_ScaleMetric(face, size, adv)

                // Get cached surface from instance
                surf = VInst_GetGlyphSurf(inst, gidx)
                IfCondition NotEqual(surf, 0) ThenBlock: {
                    Surface_BlitTinted(dst_surf, surf, cur_x, y, color)
                }

                cur_x = Add(cur_x, sadv)
            }
            si = Add(si, 1)
        }
        ReturnValue(cur_x)
    }
}

// =============================================================================
// INSTANCE: MEASURE STRING WIDTH
// =============================================================================
Function.VInst_MeasureWidth {
    Input: inst: Integer
    Input: str_ptr: Integer
    Input: str_len: Integer
    Output: Integer
    Body: {
        face = Inst_Get(inst, InstFields.FACE)
        size = Inst_Get(inst, InstFields.SIZE)
        glyphs = Face_Get(face, FaceFields.GLYPHS)
        width = 0
        si = 0
        WhileLoop LessThan(si, str_len) {
            cp = GetByte(str_ptr, si)
            gidx = VFace_FindGlyph(face, cp)
            IfCondition NotEqual(gidx, -1) ThenBlock: {
                off = Multiply(gidx, FontConst.GLYPH_SIZE)
                gp = Add(glyphs, off)
                adv = Dereference(Add(gp, FontConst.ADV_OFS))
                width = Add(width, VFace_ScaleMetric(face, size, adv))
            }
            // Unknown glyph — advance by half size, matching VInst_DrawString
            IfCondition EqualTo(gidx, -1) ThenBlock: {
                width = Add(width, Divide(size, 2))
            }
            si = Add(si, 1)
        }
        ReturnValue(width)
    }
}

// =============================================================================
// INSTANCE: PIXEL-TO-COLUMN — reverse of MeasureWidth
// Given a target pixel offset, return the column (byte) index.
// Rounds to nearest character boundary (midpoint snap).
// =============================================================================
Function.VInst_PixelToCol {
    Input: inst: Integer
    Input: str_ptr: Integer
    Input: str_len: Integer
    Input: target_px: Integer
    Output: Integer
    Body: {
        face = Inst_Get(inst, InstFields.FACE)
        size = Inst_Get(inst, InstFields.SIZE)
        glyphs = Face_Get(face, FaceFields.GLYPHS)
        accum = 0
        si = 0
        WhileLoop LessThan(si, str_len) {
            cp = GetByte(str_ptr, si)
            gidx = VFace_FindGlyph(face, cp)
            adv = 0
            IfCondition NotEqual(gidx, -1) ThenBlock: {
                off = Multiply(gidx, FontConst.GLYPH_SIZE)
                gp = Add(glyphs, off)
                raw = Dereference(Add(gp, FontConst.ADV_OFS))
                adv = VFace_ScaleMetric(face, size, raw)
            }
            IfCondition EqualTo(gidx, -1) ThenBlock: {
                adv = Divide(size, 2)
            }
            mid = Add(accum, Divide(adv, 2))
            IfCondition GreaterEqual(mid, target_px) ThenBlock: {
                ReturnValue(si)
            }
            accum = Add(accum, adv)
            IfCondition GreaterEqual(accum, target_px) ThenBlock: {
                ReturnValue(Add(si, 1))
            }
            si = Add(si, 1)
        }
        ReturnValue(str_len)
    }
}

// =============================================================================
// INSTANCE: METRICS
// =============================================================================
Function.VInst_GetLineHeight {
    Input: inst: Integer
    Output: Integer
    Body: { ReturnValue(Inst_Get(inst, InstFields.LINE_HEIGHT)) }
}

Function.VInst_GetBaseline {
    Input: inst: Integer
    Output: Integer
    Body: { ReturnValue(Inst_Get(inst, InstFields.BASELINE)) }
}

Function.VInst_GetSize {
    Input: inst: Integer
    Output: Integer
    Body: { ReturnValue(Inst_Get(inst, InstFields.SIZE)) }
}

Function.VInst_GetFace {
    Input: inst: Integer
    Output: Integer
    Body: { ReturnValue(Inst_Get(inst, InstFields.FACE)) }
}

// =============================================================================
// DESTROY INSTANCE — free cached surfaces and slot
// =============================================================================
Function.VFont_DestroyInstance {
    Input: inst: Integer
    Body: {
        IfCondition EqualTo(Inst_Get(inst, InstFields.ACTIVE), 0) ThenBlock: {
            ReturnValue(0)
        }
        surfs = Inst_Get(inst, InstFields.SURFS)
        face  = Inst_Get(inst, InstFields.FACE)
        gc    = Face_Get(face, FaceFields.GLYPH_COUNT)

        // Free cached glyph surfaces
        di = 0
        WhileLoop LessThan(di, gc) {
            s = Dereference(Add(surfs, Multiply(di, 8)))
            IfCondition NotEqual(s, 0) ThenBlock: {
                Surface_Destroy(s)
            }
            di = Add(di, 1)
        }
        Deallocate(surfs, Multiply(FontConst.MAX_GLYPHS, 8))

        Inst_Set(inst, InstFields.ACTIVE, 0)
        Inst_Set(inst, InstFields.SURFS, 0)
        InstTable.count = Subtract(InstTable.count, 1)

        PrintMessage("[Font] destroyed instance ")
        PrintNumber(inst)
        PrintMessage("\n")
        ReturnValue(0)
    }
}

// =============================================================================
// LEGACY COMPAT — old API wraps default face/instance
//
// VFont_LoadVIF → VFont_LoadFace + set as default
// VFont_RasterAll → VFont_CreateInstance on default face
// VFont_DrawString → VInst_DrawString on default instance
// VFont_MeasureWidth → VInst_MeasureWidth on default instance
// VFont_FindGlyph → VFace_FindGlyph on default face
// VFont_ScaleMetric → VFace_ScaleMetric on default face at default size
// VFont_GetLineHeight → VInst_GetLineHeight on default instance
// VFont_GetBaseline → VInst_GetBaseline on default instance
// =============================================================================

Function.VFont_LoadVIF {
    Input: path: Integer
    Output: Integer
    Body: {
        fidx = VFont_LoadFace(path)
        IfCondition LessThan(fidx, 0) ThenBlock: { ReturnValue(0) }
        FontState.default_face = fidx

        // Sync legacy FontState for any code that reads it directly
        FontState.glyphs      = Face_Get(fidx, FaceFields.GLYPHS)
        FontState.glyph_count = Face_Get(fidx, FaceFields.GLYPH_COUNT)
        FontState.em          = Face_Get(fidx, FaceFields.EM)
        FontState.ascender    = Face_Get(fidx, FaceFields.ASCENDER)
        FontState.descender   = Face_Get(fidx, FaceFields.DESCENDER)
        FontState.line_gap    = Face_Get(fidx, FaceFields.LINE_GAP)

        ReturnValue(1)
    }
}

Function.VFont_RasterAll {
    Input: size: Integer
    Body: {
        face = FontState.default_face
        IfCondition LessThan(face, 0) ThenBlock: { ReturnValue(0) }
        FontState.render_size = size
        inst = VFont_CreateInstance(face, size)
        FontState.default_inst = inst
        ReturnValue(0)
    }
}

Function.VFont_FindGlyph {
    Input: codepoint: Integer
    Output: Integer
    Body: {
        face = FontState.default_face
        IfCondition LessThan(face, 0) ThenBlock: { ReturnValue(-1) }
        ReturnValue(VFace_FindGlyph(face, codepoint))
    }
}

Function.VFont_ScaleMetric {
    Input: metric_val: Integer
    Output: Integer
    Body: {
        face = FontState.default_face
        size = FontState.render_size
        IfCondition LessThan(face, 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(VFace_ScaleMetric(face, size, metric_val))
    }
}

Function.VFont_RasterGlyph {
    Input: idx: Integer
    Output: Integer
    Body: {
        inst = FontState.default_inst
        IfCondition LessThan(inst, 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(VInst_GetGlyphSurf(inst, idx))
    }
}

Function.VFont_DrawString {
    Input: dst_surf: Integer
    Input: str_ptr: Integer
    Input: str_len: Integer
    Input: x: Integer
    Input: y: Integer
    Input: color: Integer
    Body: {
        inst = FontState.default_inst
        IfCondition LessThan(inst, 0) ThenBlock: { ReturnValue(x) }
        FontState.draw_color = color
        ReturnValue(VInst_DrawString(inst, dst_surf, str_ptr, str_len, x, y))
    }
}

Function.VFont_MeasureWidth {
    Input: str_ptr: Integer
    Input: str_len: Integer
    Output: Integer
    Body: {
        inst = FontState.default_inst
        IfCondition LessThan(inst, 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(VInst_MeasureWidth(inst, str_ptr, str_len))
    }
}

Function.VFont_PixelToCol {
    Input: str_ptr: Integer
    Input: str_len: Integer
    Input: target_px: Integer
    Output: Integer
    Body: {
        inst = FontState.default_inst
        IfCondition LessThan(inst, 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(VInst_PixelToCol(inst, str_ptr, str_len, target_px))
    }
}

Function.VFont_GetLineHeight {
    Output: Integer
    Body: {
        inst = FontState.default_inst
        IfCondition LessThan(inst, 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(VInst_GetLineHeight(inst))
    }
}

Function.VFont_GetBaseline {
    Output: Integer
    Body: {
        inst = FontState.default_inst
        IfCondition LessThan(inst, 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(VInst_GetBaseline(inst))
    }
}

Function.VFont_FlushCache {
    Body: {
        // Legacy compat — flushes default instance only
        inst = FontState.default_inst
        IfCondition GreaterEqual(inst, 0) ThenBlock: {
            VFont_DestroyInstance(inst)
            FontState.default_inst = -1
        }
        ReturnValue(0)
    }
}

// =============================================================================
// USE SIZE — switch to face+size instance, create if needed, no flush
// =============================================================================
Function.VFont_UseSize {
    Input: size: Integer
    Body: {
        face = FontState.default_face
        IfCondition LessThan(face, 0) ThenBlock: { ReturnValue(0) }
        FontState.render_size = size
        inst = VFont_CreateInstance(face, size)
        FontState.default_inst = inst
        ReturnValue(inst)
    }
}

Function.VFont_Shutdown {
    Body: {
        // Destroy all instances
        di = 0
        WhileLoop LessThan(di, InstConst.MAX) {
            IfCondition EqualTo(Inst_Get(di, InstFields.ACTIVE), 1) ThenBlock: {
                VFont_DestroyInstance(di)
            }
            di = Add(di, 1)
        }
        PrintMessage("[Font] shutdown\n")
        ReturnValue(0)
    }
}