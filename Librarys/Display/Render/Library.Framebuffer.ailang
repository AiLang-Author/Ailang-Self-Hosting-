LibraryImport.Arena

// Library.Framebuffer.ailang
// Direct Linux Framebuffer Access
// Pure syscall implementation - no external dependencies
//
// Usage: LibraryImport.Framebuffer
//
// Requires: /dev/fb0 access (root or video group)
//           Running on Linux console (not X11/Wayland)
//
// Features:
//   - Direct pixel manipulation
//   - Line, rectangle, circle primitives
//   - Sprite blitting with transparency
//   - Double buffering support
//   - Keyboard input via /dev/input

// =============================================================================
// SYSCALL NUMBERS (x86-64 Linux)
// =============================================================================
FixedPool.FBSys {
    "SYS_READ": Initialize=0
    "SYS_WRITE": Initialize=1
    "SYS_OPEN": Initialize=2
    "SYS_CLOSE": Initialize=3
    "SYS_IOCTL": Initialize=16
    "SYS_MMAP": Initialize=9
    "SYS_MUNMAP": Initialize=11
}

// =============================================================================
// IOCTL CONSTANTS
// =============================================================================
FixedPool.FBIoctl {
    "FBIOGET_VSCREENINFO": Initialize=0x4600
    "FBIOPUT_VSCREENINFO": Initialize=0x4601
    "FBIOGET_FSCREENINFO": Initialize=0x4602
}

// =============================================================================
// OPEN FLAGS
// =============================================================================
FixedPool.FBFlags {
    "O_RDONLY": Initialize=0
    "O_WRONLY": Initialize=1
    "O_RDWR": Initialize=2
}

// =============================================================================
// MMAP CONSTANTS
// =============================================================================
FixedPool.FBMmap {
    "PROT_READ": Initialize=1
    "PROT_WRITE": Initialize=2
    "MAP_SHARED": Initialize=1
}

// =============================================================================
// FRAMEBUFFER STATE
// =============================================================================
FixedPool.FB {
    "fd": Initialize=-1
    "fb_ptr": Initialize=0
    "back_buffer": Initialize=0
    "width": Initialize=0
    "height": Initialize=0
    "bpp": Initialize=0
    "pitch": Initialize=0
    "size": Initialize=0
    "initialized": Initialize=0
    "double_buffered": Initialize=0
    "headless": Initialize=0, CanChange=True
}

// =============================================================================
// VSCREENINFO STRUCTURE (simplified - we read key fields)
// Linux struct fb_var_screeninfo is 160 bytes
// Key offsets:
//   0: xres (4 bytes)
//   4: yres (4 bytes)
//   8: xres_virtual (4 bytes)
//   12: yres_virtual (4 bytes)
//   24: bits_per_pixel (4 bytes)
// =============================================================================
FixedPool.FBInfo {
    "struct_ptr": Initialize=0
    "struct_size": Initialize=160
}

// =============================================================================
// FSCREENINFO STRUCTURE (for line_length/pitch)
// Linux struct fb_fix_screeninfo is 68 bytes
// Key offset:
//   48: line_length (4 bytes) - bytes per scanline
// =============================================================================
FixedPool.FBFixInfo {
    "struct_ptr": Initialize=0
    "struct_size": Initialize=68
}

// =============================================================================
// COLOR HELPERS
// =============================================================================

// Pack RGB into 32-bit color (assumes BGRA format, common for fb0)
Function.FB_RGB {
    Input: r: Integer
    Input: g: Integer
    Input: b: Integer
    Output: Integer
    Body: {
        DebugLog_Push("fb.rgb", 6)
        color = BitwiseOr(b, BitwiseOr(ShiftLeft(g, 8), ShiftLeft(r, 16)))
        ReturnValue(color)
    }
}

// C64 color palette (approximate RGB values)
Function.FB_C64Color {
    Input: index: Integer
    Output: Integer
    Body: {
        DebugLog_Push("fb.c64", 6)
        // C64 16-color palette
        IfCondition EqualTo(index, 0) ThenBlock: { ReturnValue(FB_RGB(0, 0, 0)) }         // Black
        IfCondition EqualTo(index, 1) ThenBlock: { ReturnValue(FB_RGB(255, 255, 255)) }   // White
        IfCondition EqualTo(index, 2) ThenBlock: { ReturnValue(FB_RGB(136, 57, 50)) }     // Red
        IfCondition EqualTo(index, 3) ThenBlock: { ReturnValue(FB_RGB(103, 182, 189)) }   // Cyan
        IfCondition EqualTo(index, 4) ThenBlock: { ReturnValue(FB_RGB(139, 63, 150)) }    // Purple
        IfCondition EqualTo(index, 5) ThenBlock: { ReturnValue(FB_RGB(85, 160, 73)) }     // Green
        IfCondition EqualTo(index, 6) ThenBlock: { ReturnValue(FB_RGB(64, 49, 141)) }     // Blue
        IfCondition EqualTo(index, 7) ThenBlock: { ReturnValue(FB_RGB(191, 206, 114)) }   // Yellow
        IfCondition EqualTo(index, 8) ThenBlock: { ReturnValue(FB_RGB(139, 84, 41)) }     // Orange
        IfCondition EqualTo(index, 9) ThenBlock: { ReturnValue(FB_RGB(87, 66, 0)) }       // Brown
        IfCondition EqualTo(index, 10) ThenBlock: { ReturnValue(FB_RGB(184, 105, 98)) }   // Light Red
        IfCondition EqualTo(index, 11) ThenBlock: { ReturnValue(FB_RGB(80, 80, 80)) }     // Dark Grey
        IfCondition EqualTo(index, 12) ThenBlock: { ReturnValue(FB_RGB(120, 120, 120)) }  // Grey
        IfCondition EqualTo(index, 13) ThenBlock: { ReturnValue(FB_RGB(148, 224, 137)) }  // Light Green
        IfCondition EqualTo(index, 14) ThenBlock: { ReturnValue(FB_RGB(120, 105, 196)) }  // Light Blue
        IfCondition EqualTo(index, 15) ThenBlock: { ReturnValue(FB_RGB(159, 159, 159)) }  // Light Grey
        
        // Default to black
        ReturnValue(FB_RGB(0, 0, 0))
    }
}

// =============================================================================
// INITIALIZATION
// =============================================================================

Function.FB_Init {
    Output: Integer
    Body: {
        DebugLog_Push("fb.ini", 6)
        // Already initialized?
        IfCondition EqualTo(FB.initialized, 1) ThenBlock: {
            ReturnValue(1)
        }

        // =================================================================
        // CHOICE PATH: Comment/uncomment ONE of the two blocks below.
        //
        // REAL FRAMEBUFFER (/dev/fb0) — use for production on TTY console
        // HEADLESS (anonymous mmap)   — use for testing without /dev/fb0
        // =================================================================

        // --- REAL FRAMEBUFFER (default) ---
        // If already initialized via FB_InitHeadless, skip
        IfCondition EqualTo(FB.headless, 1) ThenBlock: {
            ReturnValue(1)
        }

        // Allocate info structures
        DebugLog_Push("fb.ini.a", 8)
        FBInfo.struct_ptr = Allocate(FBInfo.struct_size)
        DebugLog_Push("fb.ini.A", 8)
        DebugLog_Push("fb.ini.b", 8)
        FBFixInfo.struct_ptr = Allocate(FBFixInfo.struct_size)
        DebugLog_Push("fb.ini.B", 8)

        // Zero them out
        MemorySet(FBInfo.struct_ptr, 0, FBInfo.struct_size)
        MemorySet(FBFixInfo.struct_ptr, 0, FBFixInfo.struct_size)

        // Open /dev/fb0
        fb_path = "/dev/fb0"
        FB.fd = SystemCall(FBSys.SYS_OPEN, fb_path, FBFlags.O_RDWR, 0)

        IfCondition LessThan(FB.fd, 0) ThenBlock: {
            PrintMessage("ERROR: Cannot open /dev/fb0\n")
            PrintMessage("  Make sure you're on Linux console (not X11)\n")
            PrintMessage("  And have permission (root or video group)\n")
            ReturnValue(0)
        }

        // Get variable screen info
        result = SystemCall(FBSys.SYS_IOCTL, FB.fd, FBIoctl.FBIOGET_VSCREENINFO, FBInfo.struct_ptr)
        IfCondition LessThan(result, 0) ThenBlock: {
            PrintMessage("ERROR: FBIOGET_VSCREENINFO failed\n")
            FB_Close()
            ReturnValue(0)
        }

        // Get fixed screen info (for pitch)
        result = SystemCall(FBSys.SYS_IOCTL, FB.fd, FBIoctl.FBIOGET_FSCREENINFO, FBFixInfo.struct_ptr)
        IfCondition LessThan(result, 0) ThenBlock: {
            PrintMessage("ERROR: FBIOGET_FSCREENINFO failed\n")
            FB_Close()
            ReturnValue(0)
        }

        // Extract screen parameters
        FB.width = FB_Read32(FBInfo.struct_ptr, 0)
        FB.height = FB_Read32(FBInfo.struct_ptr, 4)
        FB.bpp = FB_Read32(FBInfo.struct_ptr, 24)
        FB.pitch = FB_Read32(FBFixInfo.struct_ptr, 48)
        FB.size = Multiply(FB.pitch, FB.height)

        // Debug output
        PrintMessage("Framebuffer initialized:\n")
        PrintMessage("  Resolution: ")
        PrintNumber(FB.width)
        PrintMessage("x")
        PrintNumber(FB.height)
        PrintMessage("\n  BPP: ")
        PrintNumber(FB.bpp)
        PrintMessage("\n  Pitch: ")
        PrintNumber(FB.pitch)
        PrintMessage(" bytes\n  Total size: ")
        PrintNumber(FB.size)
        PrintMessage(" bytes\n")

        // mmap the framebuffer
        prot = BitwiseOr(FBMmap.PROT_READ, FBMmap.PROT_WRITE)
        FB.fb_ptr = SystemCall(FBSys.SYS_MMAP, 0, FB.size, prot, FBMmap.MAP_SHARED, FB.fd, 0)

        IfCondition LessThan(FB.fb_ptr, 0) ThenBlock: {
            PrintMessage("ERROR: mmap failed\n")
            FB_Close()
            ReturnValue(0)
        }

        // Clear the physical framebuffer — erase all console/fbcon text
        MemorySet(FB.fb_ptr, 0, FB.size)

        // --- END REAL FRAMEBUFFER ----------------------------------------

        FB.initialized = 1
        ReturnValue(1)
    }
}

// =============================================================================
// HEADLESS INIT — call BEFORE FB_Init/FB_InitDouble to use anonymous mmap
//
// Sets headless=1 so FB_Init skips /dev/fb0 and returns immediately.
// Test binaries call this; SysDisplay.x never does.
// =============================================================================
Function.FB_InitHeadless {
    Input: w: Integer
    Input: h: Integer
    Output: Integer
    Body: {
        FB.width  = w
        FB.height = h
        FB.bpp    = 32
        FB.pitch  = Multiply(w, 4)
        FB.size   = Multiply(FB.pitch, h)
        FB.fd     = -1
        FB.headless = 1
        FB.fb_ptr = SystemCall(9, 0, FB.size, 3, 34, -1, 0)
        IfCondition LessThan(FB.fb_ptr, 0) ThenBlock: {
            PrintMessage("[HeadlessFB] mmap failed\n")
            ReturnValue(0)
        }
        FB.initialized = 1
        PrintMessage("[HeadlessFB] ")
        PrintNumber(w)
        PrintMessage("x")
        PrintNumber(h)
        PrintMessage(" init\n")
        ReturnValue(1)
    }
}

// Initialize with double buffering
Function.FB_InitDouble {
    Output: Integer
    Body: {
        DebugLog_Push("fb.inid", 7)
        result = FB_Init()
        IfCondition EqualTo(result, 0) ThenBlock: {
            ReturnValue(0)
        }
        
        // Allocate back buffer
        DebugLog_Push("fb.ind.a", 8)
        FB.back_buffer = Allocate(FB.size)
        DebugLog_Push("fb.ind.A", 8)
        IfCondition EqualTo(FB.back_buffer, 0) ThenBlock: {
            PrintMessage("ERROR: Cannot allocate back buffer\n")
            ReturnValue(0)
        }
        
        // Clear back buffer
        FB_ClearBuffer(FB.back_buffer, FB_RGB(0, 0, 0))
        
        FB.double_buffered = 1
        PrintMessage("  Double buffering: enabled\n")
        ReturnValue(1)
    }
}

// Helper: Read 32-bit value from memory
Function.FB_Read32 {
    Input: ptr: Address
    Input: offset: Integer
    Output: Integer
    Body: {
        DebugLog_Push("fb.r32", 6)
        b0 = GetByte(ptr, offset)
        b1 = GetByte(ptr, Add(offset, 1))
        b2 = GetByte(ptr, Add(offset, 2))
        b3 = GetByte(ptr, Add(offset, 3))
        
        // Little-endian assembly
        value = BitwiseOr(b0, BitwiseOr(ShiftLeft(b1, 8), BitwiseOr(ShiftLeft(b2, 16), ShiftLeft(b3, 24))))
        ReturnValue(value)
    }
}

// =============================================================================
// SHUTDOWN
// =============================================================================

Function.FB_Close {
    Body: {
        DebugLog_Push("fb.cls", 6)
        IfCondition GreaterThan(FB.fb_ptr, 0) ThenBlock: {
            SystemCall(FBSys.SYS_MUNMAP, FB.fb_ptr, FB.size)
            FB.fb_ptr = 0
        }
        
        IfCondition GreaterEqual(FB.fd, 0) ThenBlock: {
            SystemCall(FBSys.SYS_CLOSE, FB.fd)
            FB.fd = -1
        }
        
        IfCondition NotEqual(FB.back_buffer, 0) ThenBlock: {
            Deallocate(FB.back_buffer, FB.size)
            FB.back_buffer = 0
        }
        
        IfCondition NotEqual(FBInfo.struct_ptr, 0) ThenBlock: {
            Deallocate(FBInfo.struct_ptr, FBInfo.struct_size)
            FBInfo.struct_ptr = 0
        }
        
        IfCondition NotEqual(FBFixInfo.struct_ptr, 0) ThenBlock: {
            Deallocate(FBFixInfo.struct_ptr, FBFixInfo.struct_size)
            FBFixInfo.struct_ptr = 0
        }
        
        FB.initialized = 0
        FB.double_buffered = 0
    }
}

// =============================================================================
// BUFFER MANAGEMENT
// =============================================================================

// Get the active drawing buffer
Function.FB_GetDrawBuffer {
    Output: Address
    Body: {
        DebugLog_Push("fb.gdb", 6)
        IfCondition EqualTo(FB.double_buffered, 1) ThenBlock: {
            ReturnValue(FB.back_buffer)
        }
        ReturnValue(FB.fb_ptr)
    }
}

// Flip buffers (copy back to front)
Function.FB_Flip {
    Body: {
        DebugLog_Push("fb.flp2", 7)
        IfCondition EqualTo(FB.double_buffered, 0) ThenBlock: {
            ReturnValue(0)
        }
        
        MemoryCopy(FB.fb_ptr, FB.back_buffer, FB.size)
        
        ReturnValue(0)
    }
}

// Fast flip using 64-bit copies
Function.FB_FlipFast {
    Body: {
        DebugLog_Push("fb.flp", 6)
        IfCondition EqualTo(FB.double_buffered, 0) ThenBlock: {
            ReturnValue(0)
        }
        
        MemoryCopy(FB.fb_ptr, FB.back_buffer, FB.size)
        
        ReturnValue(0)
    }
}

// Clear buffer to color
Function.FB_ClearBuffer {
    Input: buffer: Address
    Input: color: Integer
    Body: {
        DebugLog_Push("fb.clb", 6)
        bytes_per_pixel = Divide(FB.bpp, 8)
        
        IfCondition EqualTo(bytes_per_pixel, 4) ThenBlock: {
            // 32-bit color - write as dwords
            pixels = Divide(FB.size, 4)
            i = 0
            WhileLoop LessThan(i, pixels) {
                offset = Multiply(i, 4)
                FB_Write32(buffer, offset, color)
                i = Add(i, 1)
            }
        } ElseBlock: {
            // Fallback: byte-by-byte (slow)
            i = 0
            WhileLoop LessThan(i, FB.size) {
                SetByte(buffer, i, 0)
                i = Add(i, 1)
            }
        }
    }
}

// Clear screen
Function.FB_Clear {
    Input: color: Integer
    Body: {
        DebugLog_Push("fb.clr", 6)
        buffer = FB_GetDrawBuffer()
        FB_ClearBuffer(buffer, color)
    }
}

// Helper: Write 32-bit value to memory
Function.FB_Write32 {
    Input: ptr: Address
    Input: offset: Integer
    Input: value: Integer
    Body: {
        DebugLog_Push("fb.w32", 6)
        SetByte(ptr, offset, BitwiseAnd(value, 255))
        SetByte(ptr, Add(offset, 1), BitwiseAnd(ShiftRight(value, 8), 255))
        SetByte(ptr, Add(offset, 2), BitwiseAnd(ShiftRight(value, 16), 255))
        SetByte(ptr, Add(offset, 3), BitwiseAnd(ShiftRight(value, 24), 255))
    }
}

// =============================================================================
// PIXEL OPERATIONS
// =============================================================================

// Set pixel (bounds checked)
Function.FB_SetPixel {
    Input: x: Integer
    Input: y: Integer
    Input: color: Integer
    Body: {
        DebugLog_Push("fb.spx", 6)
        // Bounds check
        IfCondition Or(LessThan(x, 0), GreaterEqual(x, FB.width)) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition Or(LessThan(y, 0), GreaterEqual(y, FB.height)) ThenBlock: {
            ReturnValue(0)
        }
        
        buffer = FB_GetDrawBuffer()
        bytes_per_pixel = Divide(FB.bpp, 8)
        
        // Calculate offset: y * pitch + x * bytes_per_pixel
        offset = Add(Multiply(y, FB.pitch), Multiply(x, bytes_per_pixel))
        
        IfCondition EqualTo(bytes_per_pixel, 4) ThenBlock: {
            FB_Write32(buffer, offset, color)
        } ElseBlock: {
            IfCondition EqualTo(bytes_per_pixel, 3) ThenBlock: {
                // 24-bit color
                SetByte(buffer, offset, BitwiseAnd(color, 255))
                SetByte(buffer, Add(offset, 1), BitwiseAnd(ShiftRight(color, 8), 255))
                SetByte(buffer, Add(offset, 2), BitwiseAnd(ShiftRight(color, 16), 255))
            } ElseBlock: {
                IfCondition EqualTo(bytes_per_pixel, 2) ThenBlock: {
                    // 16-bit color (RGB565) - convert from 32-bit
                    r = BitwiseAnd(ShiftRight(color, 19), 0x1F)
                    g = BitwiseAnd(ShiftRight(color, 10), 0x3F)
                    b = BitwiseAnd(ShiftRight(color, 3), 0x1F)
                    rgb565 = BitwiseOr(ShiftLeft(r, 11), BitwiseOr(ShiftLeft(g, 5), b))
                    SetByte(buffer, offset, BitwiseAnd(rgb565, 255))
                    SetByte(buffer, Add(offset, 1), ShiftRight(rgb565, 8))
                }
            }
        }
        
        ReturnValue(1)
    }
}

// Set pixel (no bounds check - faster)
Function.FB_SetPixelFast {
    Input: x: Integer
    Input: y: Integer
    Input: color: Integer
    Body: {
        DebugLog_Push("fb.spf", 6)
        buffer = FB_GetDrawBuffer()
        offset = Add(Multiply(y, FB.pitch), Multiply(x, 4))
        FB_Write32(buffer, offset, color)
    }
}

// Get pixel
Function.FB_GetPixel {
    Input: x: Integer
    Input: y: Integer
    Output: Integer
    Body: {
        DebugLog_Push("fb.gpx", 6)
        IfCondition Or(LessThan(x, 0), GreaterEqual(x, FB.width)) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition Or(LessThan(y, 0), GreaterEqual(y, FB.height)) ThenBlock: {
            ReturnValue(0)
        }
        
        buffer = FB_GetDrawBuffer()
        bytes_per_pixel = Divide(FB.bpp, 8)
        offset = Add(Multiply(y, FB.pitch), Multiply(x, bytes_per_pixel))
        
        color = FB_Read32(buffer, offset)
        ReturnValue(color)
    }
}

// =============================================================================
// LINE DRAWING (Bresenham's Algorithm)
// =============================================================================

Function.FB_Line {
    Input: x1: Integer
    Input: y1: Integer
    Input: x2: Integer
    Input: y2: Integer
    Input: color: Integer
    Body: {
        DebugLog_Push("fb.lin", 6)
        dx = FB_Abs(Subtract(x2, x1))
        dy = FB_Abs(Subtract(y2, y1))
        
        // Direction
        IfCondition LessThan(x1, x2) ThenBlock: { sx = 1 } ElseBlock: { sx = -1 }
        IfCondition LessThan(y1, y2) ThenBlock: { sy = 1 } ElseBlock: { sy = -1 }
        
        err = Subtract(dx, dy)
        
        x = x1
        y = y1
        
        done = 0
        WhileLoop EqualTo(done, 0) {
            FB_SetPixel(x, y, color)
            
            IfCondition And(EqualTo(x, x2), EqualTo(y, y2)) ThenBlock: {
                done = 1
            } ElseBlock: {
                e2 = Multiply(err, 2)
                
                IfCondition GreaterThan(e2, Subtract(0, dy)) ThenBlock: {
                    err = Subtract(err, dy)
                    x = Add(x, sx)
                }
                
                IfCondition LessThan(e2, dx) ThenBlock: {
                    err = Add(err, dx)
                    y = Add(y, sy)
                }
            }
        }
    }
}

// Horizontal line (optimized)
Function.FB_HLine {
    Input: x1: Integer
    Input: x2: Integer
    Input: y: Integer
    Input: color: Integer
    Body: {
        DebugLog_Push("fb.hl", 5)
        IfCondition Or(LessThan(y, 0), GreaterEqual(y, FB.height)) ThenBlock: {
            ReturnValue(0)
        }
        
        // Ensure x1 <= x2
        IfCondition GreaterThan(x1, x2) ThenBlock: {
            temp = x1
            x1 = x2
            x2 = temp
        }
        
        // Clip
        IfCondition LessThan(x1, 0) ThenBlock: { x1 = 0 }
        IfCondition GreaterEqual(x2, FB.width) ThenBlock: { x2 = Subtract(FB.width, 1) }
        
        buffer = FB_GetDrawBuffer()
        row_addr = Add(buffer, Multiply(y, FB.pitch))

        x = x1
        WhileLoop LessEqual(x, x2) {
            StoreValue(Add(row_addr, Multiply(x, 4)), color, "dword")
            x = Add(x, 1)
        }

        ReturnValue(1)
    }
}

// Vertical line (optimized)
Function.FB_VLine {
    Input: x: Integer
    Input: y1: Integer
    Input: y2: Integer
    Input: color: Integer
    Body: {
        DebugLog_Push("fb.vl", 5)
        IfCondition Or(LessThan(x, 0), GreaterEqual(x, FB.width)) ThenBlock: {
            ReturnValue(0)
        }
        
        // Ensure y1 <= y2
        IfCondition GreaterThan(y1, y2) ThenBlock: {
            temp = y1
            y1 = y2
            y2 = temp
        }
        
        // Clip
        IfCondition LessThan(y1, 0) ThenBlock: { y1 = 0 }
        IfCondition GreaterEqual(y2, FB.height) ThenBlock: { y2 = Subtract(FB.height, 1) }
        
        buffer = FB_GetDrawBuffer()
        x_offset = Multiply(x, 4)

        y = y1
        WhileLoop LessEqual(y, y2) {
            addr = Add(buffer, Add(Multiply(y, FB.pitch), x_offset))
            StoreValue(addr, color, "dword")
            y = Add(y, 1)
        }

        ReturnValue(1)
    }
}

// =============================================================================
// RECTANGLES
// =============================================================================

// Outline rectangle
Function.FB_Rect {
    Input: x: Integer
    Input: y: Integer
    Input: w: Integer
    Input: h: Integer
    Input: color: Integer
    Body: {
        DebugLog_Push("fb.rct", 6)
        x2 = Subtract(Add(x, w), 1)
        y2 = Subtract(Add(y, h), 1)
        
        FB_HLine(x, x2, y, color)      // Top
        FB_HLine(x, x2, y2, color)     // Bottom
        FB_VLine(x, y, y2, color)      // Left
        FB_VLine(x2, y, y2, color)     // Right
    }
}

// Filled rectangle
Function.FB_FillRect {
    Input: x: Integer
    Input: y: Integer
    Input: w: Integer
    Input: h: Integer
    Input: color: Integer
    Body: {
        DebugLog_Push("fb.fr", 5)
        x2 = Subtract(Add(x, w), 1)
        y2 = Subtract(Add(y, h), 1)
        
        cy = y
        WhileLoop LessEqual(cy, y2) {
            FB_HLine(x, x2, cy, color)
            cy = Add(cy, 1)
        }
    }
}

Function.FB_FillRectFast {
    Input: x: Integer
    Input: y: Integer
    Input: w: Integer
    Input: h: Integer
    Input: color: Integer
    Body: {
        DebugLog_Push("fb.frf", 6)
        IfCondition LessEqual(w, 0) ThenBlock: { ReturnValue(0) }
        IfCondition LessEqual(h, 0) ThenBlock: { ReturnValue(0) }
        buffer = FB_GetDrawBuffer()
        row_bytes = Multiply(w, 4)

        // Fill first row with dword StoreValue
        first_addr = Add(buffer, Add(Multiply(y, FB.pitch), Multiply(x, 4)))
        ci = 0
        WhileLoop LessThan(ci, w) {
            StoreValue(Add(first_addr, Multiply(ci, 4)), color, "dword")
            ci = Add(ci, 1)
        }

        // MemoryCopy remaining rows from first row
        row = Add(y, 1)
        y_end = Add(y, h)
        WhileLoop LessThan(row, y_end) {
            dst = Add(buffer, Add(Multiply(row, FB.pitch), Multiply(x, 4)))
            MemoryCopy(dst, first_addr, row_bytes)
            row = Add(row, 1)
        }
    }
}

// =============================================================================
// CIRCLES (Midpoint Algorithm)
// =============================================================================

Function.FB_Circle {
    Input: cx: Integer
    Input: cy: Integer
    Input: r: Integer
    Input: color: Integer
    Body: {
        DebugLog_Push("fb.cir", 6)
        x = r
        y = 0
        err = Subtract(1, r)
        
        WhileLoop GreaterEqual(x, y) {
            // Draw 8 octants
            FB_SetPixel(Add(cx, x), Add(cy, y), color)
            FB_SetPixel(Add(cx, y), Add(cy, x), color)
            FB_SetPixel(Subtract(cx, y), Add(cy, x), color)
            FB_SetPixel(Subtract(cx, x), Add(cy, y), color)
            FB_SetPixel(Subtract(cx, x), Subtract(cy, y), color)
            FB_SetPixel(Subtract(cx, y), Subtract(cy, x), color)
            FB_SetPixel(Add(cx, y), Subtract(cy, x), color)
            FB_SetPixel(Add(cx, x), Subtract(cy, y), color)
            
            y = Add(y, 1)
            
            IfCondition LessEqual(err, 0) ThenBlock: {
                err = Add(err, Add(Multiply(2, y), 1))
            } ElseBlock: {
                x = Subtract(x, 1)
                err = Add(err, Add(Multiply(2, Subtract(y, x)), 1))
            }
        }
    }
}

// Filled circle
Function.FB_FillCircle {
    Input: cx: Integer
    Input: cy: Integer
    Input: r: Integer
    Input: color: Integer
    Body: {
        DebugLog_Push("fb.fcr", 6)
        x = r
        y = 0
        err = Subtract(1, r)
        
        WhileLoop GreaterEqual(x, y) {
            // Draw horizontal lines for each y
            FB_HLine(Subtract(cx, x), Add(cx, x), Add(cy, y), color)
            FB_HLine(Subtract(cx, x), Add(cx, x), Subtract(cy, y), color)
            FB_HLine(Subtract(cx, y), Add(cx, y), Add(cy, x), color)
            FB_HLine(Subtract(cx, y), Add(cx, y), Subtract(cy, x), color)
            
            y = Add(y, 1)
            
            IfCondition LessEqual(err, 0) ThenBlock: {
                err = Add(err, Add(Multiply(2, y), 1))
            } ElseBlock: {
                x = Subtract(x, 1)
                err = Add(err, Add(Multiply(2, Subtract(y, x)), 1))
            }
        }
    }
}

// =============================================================================
// SPRITE / BLIT OPERATIONS
// =============================================================================

// Blit from memory buffer to screen
// Assumes 32-bit BGRA source
Function.FB_Blit {
    Input: src: Address
    Input: src_w: Integer
    Input: src_h: Integer
    Input: dst_x: Integer
    Input: dst_y: Integer
    Body: {
        DebugLog_Push("fb.blt", 6)
        buffer = FB_GetDrawBuffer()
        
        sy = 0
        WhileLoop LessThan(sy, src_h) {
            dy = Add(dst_y, sy)
            
            IfCondition And(GreaterEqual(dy, 0), LessThan(dy, FB.height)) ThenBlock: {
                sx = 0
                WhileLoop LessThan(sx, src_w) {
                    dx = Add(dst_x, sx)
                    
                    IfCondition And(GreaterEqual(dx, 0), LessThan(dx, FB.width)) ThenBlock: {
                        src_offset = Multiply(Add(Multiply(sy, src_w), sx), 4)
                        color = FB_Read32(src, src_offset)
                        
                        dst_offset = Add(Multiply(dy, FB.pitch), Multiply(dx, 4))
                        FB_Write32(buffer, dst_offset, color)
                    }
                    
                    sx = Add(sx, 1)
                }
            }
            
            sy = Add(sy, 1)
        }
    }
}

// Blit with transparency (color key)
Function.FB_BlitTransparent {
    Input: src: Address
    Input: src_w: Integer
    Input: src_h: Integer
    Input: dst_x: Integer
    Input: dst_y: Integer
    Input: transparent_color: Integer
    Body: {
        DebugLog_Push("fb.btr", 6)
        buffer = FB_GetDrawBuffer()
        
        sy = 0
        WhileLoop LessThan(sy, src_h) {
            dy = Add(dst_y, sy)
            
            IfCondition And(GreaterEqual(dy, 0), LessThan(dy, FB.height)) ThenBlock: {
                sx = 0
                WhileLoop LessThan(sx, src_w) {
                    dx = Add(dst_x, sx)
                    
                    IfCondition And(GreaterEqual(dx, 0), LessThan(dx, FB.width)) ThenBlock: {
                        src_offset = Multiply(Add(Multiply(sy, src_w), sx), 4)
                        color = FB_Read32(src, src_offset)
                        
                        // Skip transparent pixels
                        IfCondition NotEqual(color, transparent_color) ThenBlock: {
                            dst_offset = Add(Multiply(dy, FB.pitch), Multiply(dx, 4))
                            FB_Write32(buffer, dst_offset, color)
                        }
                    }
                    
                    sx = Add(sx, 1)
                }
            }
            
            sy = Add(sy, 1)
        }
    }
}

// Blit with scaling (integer scale factors)
Function.FB_BlitScaled {
    Input: src: Address
    Input: src_w: Integer
    Input: src_h: Integer
    Input: dst_x: Integer
    Input: dst_y: Integer
    Input: scale: Integer
    Body: {
        DebugLog_Push("fb.bsc", 6)
        buffer = FB_GetDrawBuffer()
        
        sy = 0
        WhileLoop LessThan(sy, src_h) {
            sx = 0
            WhileLoop LessThan(sx, src_w) {
                src_offset = Multiply(Add(Multiply(sy, src_w), sx), 4)
                color = FB_Read32(src, src_offset)
                
                // Draw scaled pixel (scale x scale block)
                py = 0
                WhileLoop LessThan(py, scale) {
                    px = 0
                    WhileLoop LessThan(px, scale) {
                        dx = Add(dst_x, Add(Multiply(sx, scale), px))
                        dy = Add(dst_y, Add(Multiply(sy, scale), py))
                        
                        IfCondition And(And(GreaterEqual(dx, 0), LessThan(dx, FB.width)), And(GreaterEqual(dy, 0), LessThan(dy, FB.height))) ThenBlock: {
                            dst_offset = Add(Multiply(dy, FB.pitch), Multiply(dx, 4))
                            FB_Write32(buffer, dst_offset, color)
                        }
                        
                        px = Add(px, 1)
                    }
                    py = Add(py, 1)
                }
                
                sx = Add(sx, 1)
            }
            sy = Add(sy, 1)
        }
    }
}

// =============================================================================
// UTILITY FUNCTIONS
// =============================================================================

Function.FB_Abs {
    Input: x: Integer
    Output: Integer
    Body: {
        DebugLog_Push("fb.abs", 6)
        IfCondition LessThan(x, 0) ThenBlock: {
            ReturnValue(Subtract(0, x))
        }
        ReturnValue(x)
    }
}

Function.FB_GetWidth {
    Output: Integer
    Body: {
        DebugLog_Push("fb.gw", 5)
        ReturnValue(FB.width)
    }
}

Function.FB_GetHeight {
    Output: Integer
    Body: {
        DebugLog_Push("fb.gh", 5)
        ReturnValue(FB.height)
    }
}

Function.FB_GetBPP {
    Output: Integer
    Body: {
        DebugLog_Push("fb.bpp", 6)
        ReturnValue(FB.bpp)
    }
}

// =============================================================================
// TEXT RENDERING (8x8 bitmap font)
// =============================================================================

// Built-in 8x8 font data for ASCII 32-127
// Each character is 8 bytes (8 rows of 8 pixels)
// This is initialized on first use
FixedPool.FBFont {
    "data_ptr": Initialize=0
    "char_width": Initialize=8
    "char_height": Initialize=8
    "initialized": Initialize=0
}

// Initialize font (creates basic font in memory)
Function.FB_FontInit {
    Body: {
        DebugLog_Push("fb.fi", 5)
        IfCondition EqualTo(FBFont.initialized, 1) ThenBlock: {
            ReturnValue(1)
        }
        
        // Allocate font data: 96 chars * 8 bytes = 768 bytes
        DebugLog_Push("fb.fi.a", 7)
        FBFont.data_ptr = Allocate(768)
        DebugLog_Push("fb.fi.A", 7)
        
        // Initialize all to zero first
        i = 0
        WhileLoop LessThan(i, 768) {
            SetByte(FBFont.data_ptr, i, 0)
            i = Add(i, 1)
        }
        
        // Define characters — each packed as 8 bitmap bytes in a 64-bit LE int
        // Space (32) - all zeros, already done
        FB_FontDefineChar(33, 0x0018001818181818)  // !
        FB_FontDefineChar(34, 0x0000000000246C6C)  // "
        FB_FontDefineChar(40, 0x000C18303030180C)  // (
        FB_FontDefineChar(41, 0x0030180C0C0C1830)  // )
        FB_FontDefineChar(42, 0x0000663CFF3C6600)  // *
        FB_FontDefineChar(43, 0x000018187E181800)  // +
        FB_FontDefineChar(44, 0x3018180000000000)  // ,
        FB_FontDefineChar(45, 0x000000007E000000)  // -
        FB_FontDefineChar(46, 0x0018180000000000)  // .
        FB_FontDefineChar(47, 0x0000406030180C06)  // /
        FB_FontDefineChar(48, 0x003C6666766E663C)  // 0
        FB_FontDefineChar(49, 0x007E181818183818)  // 1
        FB_FontDefineChar(50, 0x007E30180C06663C)  // 2
        FB_FontDefineChar(51, 0x003C66061C06663C)  // 3
        FB_FontDefineChar(52, 0x000C0C7E4C2C1C0C)  // 4
        FB_FontDefineChar(53, 0x003C6606067C607E)  // 5
        FB_FontDefineChar(54, 0x003C66667C60301C)  // 6
        FB_FontDefineChar(55, 0x00303030180C067E)  // 7
        FB_FontDefineChar(56, 0x003C66663C66663C)  // 8
        FB_FontDefineChar(57, 0x00380C063E66663C)  // 9
        FB_FontDefineChar(58, 0x0018180000181800)  // :
        FB_FontDefineChar(61, 0x0000007E007E0000)  // =
        FB_FontDefineChar(63, 0x001800180C06663C)  // ?
        FB_FontDefineChar(65, 0x0066667E66663C18)  // A
        FB_FontDefineChar(66, 0x007C66667C66667C)  // B
        FB_FontDefineChar(67, 0x003C66606060663C)  // C
        FB_FontDefineChar(68, 0x00786C6666666C78)  // D
        FB_FontDefineChar(69, 0x007E60607C60607E)  // E
        FB_FontDefineChar(70, 0x006060607C60607E)  // F
        FB_FontDefineChar(71, 0x003E66666E60663C)  // G
        FB_FontDefineChar(72, 0x006666667E666666)  // H
        FB_FontDefineChar(73, 0x003C18181818183C)  // I
        FB_FontDefineChar(74, 0x003C66060606060E)  // J
        FB_FontDefineChar(75, 0x00666C7870786C66)  // K
        FB_FontDefineChar(76, 0x007E606060606060)  // L
        FB_FontDefineChar(77, 0x006363636B7F7763)  // M
        FB_FontDefineChar(78, 0x0066666E7E7E7666)  // N
        FB_FontDefineChar(79, 0x003C66666666663C)  // O
        FB_FontDefineChar(80, 0x006060607C66667C)  // P
        FB_FontDefineChar(81, 0x00366C6A6666663C)  // Q
        FB_FontDefineChar(82, 0x0066666C7C66667C)  // R
        FB_FontDefineChar(83, 0x003C66063C60663C)  // S
        FB_FontDefineChar(84, 0x001818181818187E)  // T
        FB_FontDefineChar(85, 0x003C666666666666)  // U
        FB_FontDefineChar(86, 0x00183C6666666666)  // V
        FB_FontDefineChar(87, 0x0063777F6B636363)  // W
        FB_FontDefineChar(88, 0x0066663C183C6666)  // X
        FB_FontDefineChar(89, 0x001818183C666666)  // Y
        FB_FontDefineChar(90, 0x007E6030180C067E)  // Z
        FB_FontDefineChar(97, 0x003E663E063C0000)  // a
        FB_FontDefineChar(98, 0x007C6666667C6060)  // b
        FB_FontDefineChar(99, 0x003C6660663C0000)  // c
        FB_FontDefineChar(100, 0x003E6666663E0606)  // d
        FB_FontDefineChar(101, 0x003C607E663C0000)  // e
        FB_FontDefineChar(102, 0x00303030307C301C)  // f
        FB_FontDefineChar(103, 0x3C063E66663E0000)  // g
        FB_FontDefineChar(104, 0x00666666667C6060)  // h
        FB_FontDefineChar(105, 0x003C181818380018)  // i
        FB_FontDefineChar(106, 0x386C0C0C0C1C000C)  // j
        FB_FontDefineChar(107, 0x00666C786C666060)  // k
        FB_FontDefineChar(108, 0x003C181818181838)  // l
        FB_FontDefineChar(109, 0x00636B6B7F760000)  // m
        FB_FontDefineChar(110, 0x00666666667C0000)  // n
        FB_FontDefineChar(111, 0x003C6666663C0000)  // o
        FB_FontDefineChar(112, 0x60607C66667C0000)  // p
        FB_FontDefineChar(113, 0x06063E66663E0000)  // q
        FB_FontDefineChar(114, 0x00606060667C0000)  // r
        FB_FontDefineChar(115, 0x007C063C603E0000)  // s
        FB_FontDefineChar(116, 0x001C3030307C3030)  // t
        FB_FontDefineChar(117, 0x003E666666660000)  // u
        FB_FontDefineChar(118, 0x00183C6666660000)  // v
        FB_FontDefineChar(119, 0x00367F6B6B630000)  // w
        FB_FontDefineChar(120, 0x00663C183C660000)  // x
        FB_FontDefineChar(121, 0x3C063E6666660000)  // y
        FB_FontDefineChar(122, 0x007E30180C7E0000)  // z
        
        FBFont.initialized = 1
        ReturnValue(1)
    }
}

// Helper to define a character — packed is 8 bitmap bytes in a 64-bit int (LE)
Function.FB_FontDefineChar {
    Input: ch: Integer
    Input: packed: Integer
    Body: {
        DebugLog_Push("fb.fdc", 6)
        idx = Subtract(ch, 32)
        IfCondition Or(LessThan(idx, 0), GreaterEqual(idx, 96)) ThenBlock: {
            ReturnValue(0)
        }
        dst = Add(FBFont.data_ptr, Multiply(idx, 8))
        StoreValue(dst, packed)
        ReturnValue(1)
    }
}

// Draw a single character
Function.FB_DrawChar {
    Input: x: Integer
    Input: y: Integer
    Input: ch: Integer
    Input: fg_color: Integer
    Input: bg_color: Integer
    Body: {
        DebugLog_Push("fb.dc", 5)
        IfCondition EqualTo(FBFont.initialized, 0) ThenBlock: {
            FB_FontInit()
        }
        
        // Get character index
        idx = Subtract(ch, 32)
        IfCondition Or(LessThan(idx, 0), GreaterEqual(idx, 96)) ThenBlock: {
            idx = 0  // Default to space
        }
        
        base = Multiply(idx, 8)
        
        // Draw 8x8 character
        row = 0
        WhileLoop LessThan(row, 8) {
            bits = GetByte(FBFont.data_ptr, Add(base, row))
            
            col = 0
            WhileLoop LessThan(col, 8) {
                px = Add(x, col)
                py = Add(y, row)
                
                // Check if bit is set (MSB first)
                mask = ShiftRight(0x80, col)
                IfCondition NotEqual(BitwiseAnd(bits, mask), 0) ThenBlock: {
                    FB_SetPixel(px, py, fg_color)
                } ElseBlock: {
                    // Only draw background if color is not -1 (transparent)
                    IfCondition NotEqual(bg_color, -1) ThenBlock: {
                        FB_SetPixel(px, py, bg_color)
                    }
                }
                
                col = Add(col, 1)
            }
            
            row = Add(row, 1)
        }
    }
}

// Draw a string
Function.FB_DrawString {
    Input: x: Integer
    Input: y: Integer
    Input: str: Address
    Input: fg_color: Integer
    Input: bg_color: Integer
    Body: {
        DebugLog_Push("fb.ds", 5)
        cx = x
        i = 0
        
        ch = GetByte(str, i)
        WhileLoop NotEqual(ch, 0) {
            FB_DrawChar(cx, y, ch, fg_color, bg_color)
            cx = Add(cx, 8)
            i = Add(i, 1)
            ch = GetByte(str, i)
        }
    }
}

// Draw string with scaling
Function.FB_DrawStringScaled {
    Input: x: Integer
    Input: y: Integer
    Input: str: Address
    Input: fg_color: Integer
    Input: bg_color: Integer
    Input: scale: Integer
    Body: {
        DebugLog_Push("fb.dss", 6)
        IfCondition EqualTo(FBFont.initialized, 0) ThenBlock: {
            FB_FontInit()
        }
        
        cx = x
        i = 0
        
        ch = GetByte(str, i)
        WhileLoop NotEqual(ch, 0) {
            // Get character data
            idx = Subtract(ch, 32)
            IfCondition Or(LessThan(idx, 0), GreaterEqual(idx, 96)) ThenBlock: {
                idx = 0
            }
            
            base = Multiply(idx, 8)
            
            // Draw scaled character
            row = 0
            WhileLoop LessThan(row, 8) {
                bits = GetByte(FBFont.data_ptr, Add(base, row))
                
                col = 0
                WhileLoop LessThan(col, 8) {
                    mask = ShiftRight(0x80, col)
                    
                    IfCondition NotEqual(BitwiseAnd(bits, mask), 0) ThenBlock: {
                        color = fg_color
                    } ElseBlock: {
                        color = bg_color
                    }
                    
                    IfCondition NotEqual(color, -1) ThenBlock: {
                        // Draw scale x scale block
                        py = 0
                        WhileLoop LessThan(py, scale) {
                            px = 0
                            WhileLoop LessThan(px, scale) {
                                FB_SetPixel(Add(cx, Add(Multiply(col, scale), px)), Add(y, Add(Multiply(row, scale), py)), color)
                                px = Add(px, 1)
                            }
                            py = Add(py, 1)
                        }
                    }
                    
                    col = Add(col, 1)
                }
                
                row = Add(row, 1)
            }
            
            cx = Add(cx, Multiply(8, scale))
            i = Add(i, 1)
            ch = GetByte(str, i)
        }
    }
}

// Draw number
Function.FB_DrawNumber {
    Input: x: Integer
    Input: y: Integer
    Input: num: Integer
    Input: fg_color: Integer
    Input: bg_color: Integer
    Body: {
        DebugLog_Push("fb.dn", 5)
        // Handle negative
        cx = x
        n = num
        
        IfCondition LessThan(n, 0) ThenBlock: {
            FB_DrawChar(cx, y, 45, fg_color, bg_color)  // '-'
            cx = Add(cx, 8)
            n = Subtract(0, n)
        }
        
        // Handle zero
        IfCondition EqualTo(n, 0) ThenBlock: {
            FB_DrawChar(cx, y, 48, fg_color, bg_color)  // '0'
            ReturnValue(0)
        }
        
        // Count digits and build in reverse
        DebugLog_Push("fb.dn.a", 7)
        digits = Allocate(16)
        DebugLog_Push("fb.dn.A", 7)
        count = 0
        
        WhileLoop GreaterThan(n, 0) {
            digit = Modulo(n, 10)
            SetByte(digits, count, Add(digit, 48))
            count = Add(count, 1)
            n = Divide(n, 10)
        }
        
        // Draw in reverse order
        i = Subtract(count, 1)
        WhileLoop GreaterEqual(i, 0) {
            ch = GetByte(digits, i)
            FB_DrawChar(cx, y, ch, fg_color, bg_color)
            cx = Add(cx, 8)
            i = Subtract(i, 1)
        }
        
        DebugLog_Push("fb.dn.d", 7)
        Deallocate(digits, 16)
    }
}

// =============================================================================
// KEYBOARD INPUT (via /dev/input or raw terminal)
// =============================================================================

FixedPool.FBInput {
    "fd": Initialize=-1
    "old_termios": Initialize=0
    "initialized": Initialize=0
}

// Simple keyboard init using terminal raw mode
// (More portable than /dev/input/eventX which needs device detection)
Function.FB_InputInit {
    Output: Integer
    Body: {
        DebugLog_Push("fb.ii", 5)
        // Allocate termios structures
        DebugLog_Push("fb.ii.a", 7)
        FBInput.old_termios = Allocate(60)
        DebugLog_Push("fb.ii.A", 7)
        DebugLog_Push("fb.ii.b", 7)
        new_termios = Allocate(60)
        DebugLog_Push("fb.ii.B", 7)
        
        // Get current terminal settings
        // ioctl(0, TCGETS, old_termios) - TCGETS = 0x5401
        SystemCall(FBSys.SYS_IOCTL, 0, 0x5401, FBInput.old_termios)
        
        // Copy to new
        i = 0
        WhileLoop LessThan(i, 60) {
            b = GetByte(FBInput.old_termios, i)
            SetByte(new_termios, i, b)
            i = Add(i, 1)
        }
        
        // Modify c_lflag (offset 12) - disable ICANON and ECHO
        // ICANON = 0x2, ECHO = 0x8
        lflag = FB_Read32(new_termios, 12)
        lflag = BitwiseAnd(lflag, BitwiseNot(0x0A))  // Clear ICANON | ECHO
        FB_Write32(new_termios, 12, lflag)
        
        // Set VMIN=1, VTIME=0 (offsets in c_cc array, typically at offset 17+)
        // c_cc[VMIN] = 1, c_cc[VTIME] = 0
        // VMIN is typically index 6 in c_cc (offset 17+6 = 23)
        // VTIME is typically index 5 in c_cc (offset 17+5 = 22)
        SetByte(new_termios, 23, 1)   // VMIN = 1
        SetByte(new_termios, 22, 0)   // VTIME = 0
        
        // Apply new settings
        // ioctl(0, TCSETS, new_termios) - TCSETS = 0x5402
        SystemCall(FBSys.SYS_IOCTL, 0, 0x5402, new_termios)
        
        DebugLog_Push("fb.ii.d", 7)
        Deallocate(new_termios, 60)
        FBInput.initialized = 1
        ReturnValue(1)
    }
}

// Restore terminal settings
Function.FB_InputClose {
    Body: {
        DebugLog_Push("fb.ic", 5)
        IfCondition NotEqual(FBInput.old_termios, 0) ThenBlock: {
            SystemCall(FBSys.SYS_IOCTL, 0, 0x5402, FBInput.old_termios)
            DebugLog_Push("fb.ic.d", 7)
            Deallocate(FBInput.old_termios, 60)
            FBInput.old_termios = 0
        }
        FBInput.initialized = 0
    }
}

// Check if key is available (non-blocking)
// Returns 1 if key available, 0 if not
Function.FB_KeyAvailable {
    Output: Integer
    Body: {
        DebugLog_Push("fb.ka", 5)
        // Use poll or select - here we'll use a simpler approach
        // Set non-blocking temporarily
        // For now, this is a blocking read wrapper
        // TODO: implement with poll() syscall for true non-blocking
        ReturnValue(1)
    }
}

// Read a single key (blocking)
// Returns ASCII code, or special codes for arrows/function keys
Function.FB_GetKey {
    Output: Integer
    Body: {
        DebugLog_Push("fb.gk", 5)
        DebugLog_Push("fb.gk.a", 7)
        buf = Allocate(8)
        DebugLog_Push("fb.gk.A", 7)
        
        // Read from stdin
        n = SystemCall(FBSys.SYS_READ, 0, buf, 1)
        
        IfCondition LessEqual(n, 0) ThenBlock: {
            DebugLog_Push("fb.gk.d", 7)
            Deallocate(buf, 8)
            ReturnValue(0)
        }
        
        ch = GetByte(buf, 0)
        
        // Check for escape sequence
        IfCondition EqualTo(ch, 27) ThenBlock: {
            // Try to read more (escape sequence)
            n2 = SystemCall(FBSys.SYS_READ, 0, buf, 2)
            
            IfCondition GreaterEqual(n2, 2) ThenBlock: {
                ch2 = GetByte(buf, 0)
                ch3 = GetByte(buf, 1)
                
                IfCondition EqualTo(ch2, 91) ThenBlock: {  // '['
                    // Arrow keys: A=up, B=down, C=right, D=left
                    IfCondition EqualTo(ch3, 65) ThenBlock: { DebugLog_Push("fb.gk.d", 7) Deallocate(buf, 8) ReturnValue(1001) }  // Up
                    IfCondition EqualTo(ch3, 66) ThenBlock: { DebugLog_Push("fb.gk.d", 7) Deallocate(buf, 8) ReturnValue(1002) }  // Down
                    IfCondition EqualTo(ch3, 67) ThenBlock: { DebugLog_Push("fb.gk.d", 7) Deallocate(buf, 8) ReturnValue(1003) }  // Right
                    IfCondition EqualTo(ch3, 68) ThenBlock: { DebugLog_Push("fb.gk.d", 7) Deallocate(buf, 8) ReturnValue(1004) }  // Left

                    // Home/End/etc with ~ suffix
                    IfCondition EqualTo(ch3, 72) ThenBlock: { DebugLog_Push("fb.gk.d", 7) Deallocate(buf, 8) ReturnValue(1005) }  // Home
                    IfCondition EqualTo(ch3, 70) ThenBlock: { DebugLog_Push("fb.gk.d", 7) Deallocate(buf, 8) ReturnValue(1006) }  // End
                }
            }
            
            // Just ESC key
            DebugLog_Push("fb.gk.d", 7)
            Deallocate(buf, 8)
            ReturnValue(27)
        }

        DebugLog_Push("fb.gk.d", 7)
        Deallocate(buf, 8)
        ReturnValue(ch)
    }
}

// Key constants
FixedPool.FBKeys {
    "KEY_UP": Initialize=1001
    "KEY_DOWN": Initialize=1002
    "KEY_RIGHT": Initialize=1003
    "KEY_LEFT": Initialize=1004
    "KEY_HOME": Initialize=1005
    "KEY_END": Initialize=1006
    "KEY_ESC": Initialize=27
    "KEY_ENTER": Initialize=10
    "KEY_BACKSPACE": Initialize=127
    "KEY_SPACE": Initialize=32
}

// =============================================================================
// SIMPLE TEST
// =============================================================================

SubRoutine.FB_Test {
    DebugLog_Push("fb.tst", 6)
    result = FB_InitDouble()
    IfCondition EqualTo(result, 0) ThenBlock: {
        PrintMessage("Framebuffer init failed\n")
        HaltProgram
    }
    
    // Clear to C64 blue
    FB_Clear(FB_C64Color(6))
    
    // Draw some shapes
    white = FB_C64Color(1)
    red = FB_C64Color(2)
    yellow = FB_C64Color(7)
    
    // Border
    FB_Rect(10, 10, Subtract(FB.width, 20), Subtract(FB.height, 20), white)
    
    // Some lines
    FB_Line(50, 50, 200, 150, red)
    FB_Line(200, 50, 50, 150, yellow)
    
    // Filled rectangle
    FB_FillRect(250, 50, 100, 80, FB_C64Color(5))
    
    // Circles
    FB_Circle(500, 100, 50, white)
    FB_FillCircle(600, 100, 40, FB_C64Color(3))
    
    // Flip to screen
    FB_FlipFast()
    
    // Wait for keypress (using syscall directly since ReadInput isn't compiled)
    PrintMessage("Press Enter to exit...\n")
    DebugLog_Push("fb.tst.a", 8)
    wait_buf = Allocate(8)
    DebugLog_Push("fb.tst.A", 8)
    SystemCall(FBSys.SYS_READ, 0, wait_buf, 1)
    DebugLog_Push("fb.tst.d", 8)
    Deallocate(wait_buf, 8)
    
    FB_Close()
}