// Library.StyleRaster.ailang
// Vector style file → PIXEL_32 surface (BMP-like pixel buffer) at a given size.
// TVG/VIF and SVG share this path. Cursor, widgets, and icons all consume surfaces.
// Copyright © 2026 Sean Collins, 2 Paws Machine and Engineering. SCSL.

LibraryImport.Display.Render.DSurfaceTypes
LibraryImport.Display.Render.DSurface
LibraryImport.Display.Render.VIF
LibraryImport.SVG

// Rasterize `path` to a pixel surface with height `px` (width from aspect).
// .tvg / standalone .vif → TVG_RenderFile
// .svg                   → SVG_RasterFile
Function.StyleRaster_LoadFile {
    Input: path: Address
    Input: px: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(path, 0) ThenBlock: { ReturnValue(0) }
        IfCondition LessEqual(px, 0) ThenBlock: { px = 16 }
        plen = StringLength(path)
        IfCondition LessThan(plen, 4) ThenBlock: { ReturnValue(0) }
        d = GetByte(path, Subtract(plen, 4))
        a = GetByte(path, Subtract(plen, 3))
        b = GetByte(path, Subtract(plen, 2))
        c = GetByte(path, Subtract(plen, 1))

        // .tvg or .vif
        IfCondition EqualTo(d, 46) ThenBlock: {
            IfCondition And(EqualTo(a, 116), And(EqualTo(b, 118), EqualTo(c, 103))) ThenBlock: {
                ReturnValue(TVG_RenderFile(path, px))
            }
            IfCondition And(EqualTo(a, 118), And(EqualTo(b, 105), EqualTo(c, 102))) ThenBlock: {
                ReturnValue(TVG_RenderFile(path, px))
            }
            IfCondition And(EqualTo(a, 115), And(EqualTo(b, 118), EqualTo(c, 103))) ThenBlock: {
                ReturnValue(SVG_RasterFile(path, px, px))
            }
        }
        ReturnValue(0)
    }
}

// Load SVG if present, else TVG. Size is explicit so tab pieces are not square.
Function.StyleRaster_LoadEither {
    Input: svg_path: Address
    Input: tvg_path: Address
    Input: w: Integer
    Input: h: Integer
    Output: Integer
    Body: {
        IfCondition LessEqual(h, 0) ThenBlock: { h = 16 }
        IfCondition LessEqual(w, 0) ThenBlock: { w = h }
        surf = 0
        IfCondition NotEqual(svg_path, 0) ThenBlock: {
            surf = SVG_RasterFile(svg_path, w, h)
        }
        IfCondition NotEqual(surf, 0) ThenBlock: {
            PrintMessage("[Style] svg ")
            PrintMessage(svg_path)
            PrintMessage("\n")
            ReturnValue(surf)
        }
        IfCondition NotEqual(tvg_path, 0) ThenBlock: {
            surf = TVG_RenderFile(tvg_path, h)
        }
        IfCondition NotEqual(surf, 0) ThenBlock: {
            PrintMessage("[Style] tvg ")
            PrintMessage(tvg_path)
            PrintMessage("\n")
            ReturnValue(surf)
        }
        PrintMessage("[Style] miss ")
        IfCondition NotEqual(svg_path, 0) ThenBlock: { PrintMessage(svg_path) }
        PrintMessage("\n")
        ReturnValue(0)
    }
}
