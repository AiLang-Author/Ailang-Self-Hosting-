// Library.SuperSample.ailang
// Resolution-independent supersampling / downsampling.
// Render at Nx, downsample to target. Reusable for any image pipeline.
// Copyright © 2026 Sean Collins, 2 Paws Machine and Engineering. SCSL.

LibraryImport.Display.Render.DSurfaceTypes
LibraryImport.Display.Render.DSurface
LibraryImport.Display.Render.DDrawPixel
LibraryImport.Arena

// =============================================================================
// DOWNSAMPLE 2X — average 2x2 blocks from src into dst
// src is (w*2, h*2), dst is (w, h)
// =============================================================================
Function.SS_Down2x {
    Input: src: Integer
    Input: dst: Integer
    Input: w: Integer
    Input: h: Integer
    Body: {
        src_data  = Surface_GetData(src)
        src_pitch = Surface_GetPitch(src)
        dst_data  = Surface_GetData(dst)
        dst_pitch = Surface_GetPitch(dst)

        dy = 0
        WhileLoop LessThan(dy, h) {
            // Two source rows
            sy0 = Multiply(dy, 2)
            sy1 = Add(sy0, 1)
            sr0 = Multiply(sy0, src_pitch)
            sr0 = Add(src_data, sr0)
            sr1 = Multiply(sy1, src_pitch)
            sr1 = Add(src_data, sr1)

            dr = Multiply(dy, dst_pitch)
            dr = Add(dst_data, dr)

            dx = 0
            WhileLoop LessThan(dx, w) {
                // Four source pixels: (sx, sy0), (sx+1, sy0), (sx, sy1), (sx+1, sy1)
                sx0 = Multiply(dx, 2)
                sx1 = Add(sx0, 1)
                off00 = Multiply(sx0, 4)
                off10 = Multiply(sx1, 4)

                // Row 0: pixels (sx0, sy0) and (sx1, sy0)
                b00 = GetByte(sr0, off00)
                t = Add(off00, 1)
                g00 = GetByte(sr0, t)
                t = Add(off00, 2)
                r00 = GetByte(sr0, t)
                t = Add(off00, 3)
                a00 = GetByte(sr0, t)

                b10 = GetByte(sr0, off10)
                t = Add(off10, 1)
                g10 = GetByte(sr0, t)
                t = Add(off10, 2)
                r10 = GetByte(sr0, t)
                t = Add(off10, 3)
                a10 = GetByte(sr0, t)

                // Row 1: pixels (sx0, sy1) and (sx1, sy1)
                b01 = GetByte(sr1, off00)
                t = Add(off00, 1)
                g01 = GetByte(sr1, t)
                t = Add(off00, 2)
                r01 = GetByte(sr1, t)
                t = Add(off00, 3)
                a01 = GetByte(sr1, t)

                b11 = GetByte(sr1, off10)
                t = Add(off10, 1)
                g11 = GetByte(sr1, t)
                t = Add(off10, 2)
                r11 = GetByte(sr1, t)
                t = Add(off10, 3)
                a11 = GetByte(sr1, t)

                // Average each channel: (p00 + p10 + p01 + p11 + 2) / 4
                sum = Add(r00, r10)
                sum = Add(sum, r01)
                sum = Add(sum, r11)
                sum = Add(sum, 2)
                ar = Divide(sum, 4)

                sum = Add(g00, g10)
                sum = Add(sum, g01)
                sum = Add(sum, g11)
                sum = Add(sum, 2)
                ag = Divide(sum, 4)

                sum = Add(b00, b10)
                sum = Add(sum, b01)
                sum = Add(sum, b11)
                sum = Add(sum, 2)
                ab = Divide(sum, 4)

                sum = Add(a00, a10)
                sum = Add(sum, a01)
                sum = Add(sum, a11)
                sum = Add(sum, 2)
                aa = Divide(sum, 4)

                // Write to dst
                doff = Multiply(dx, 4)
                SetByte(dr, doff, ab)
                t = Add(doff, 1)
                SetByte(dr, t, ag)
                t = Add(doff, 2)
                SetByte(dr, t, ar)
                t = Add(doff, 3)
                SetByte(dr, t, aa)

                dx = Add(dx, 1)
            }
            dy = Add(dy, 1)
        }
        ReturnValue(1)
    }
}

// =============================================================================
// DOWNSAMPLE 4X — average 4x4 blocks from src into dst
// src is (w*4, h*4), dst is (w, h)
// =============================================================================
Function.SS_Down4x {
    Input: src: Integer
    Input: dst: Integer
    Input: w: Integer
    Input: h: Integer
    Body: {
        src_data  = Surface_GetData(src)
        src_pitch = Surface_GetPitch(src)
        dst_data  = Surface_GetData(dst)
        dst_pitch = Surface_GetPitch(dst)

        dy = 0
        WhileLoop LessThan(dy, h) {
            sy_base = Multiply(dy, 4)
            dr = Multiply(dy, dst_pitch)
            dr = Add(dst_data, dr)

            dx = 0
            WhileLoop LessThan(dx, w) {
                sx_base = Multiply(dx, 4)

                // Accumulate 4x4 = 16 pixels
                sum_r = 0
                sum_g = 0
                sum_b = 0
                sum_a = 0

                ky = 0
                WhileLoop LessThan(ky, 4) {
                    sy = Add(sy_base, ky)
                    srow = Multiply(sy, src_pitch)
                    srow = Add(src_data, srow)

                    kx = 0
                    WhileLoop LessThan(kx, 4) {
                        sx = Add(sx_base, kx)
                        soff = Multiply(sx, 4)
                        pb = GetByte(srow, soff)
                        t = Add(soff, 1)
                        pg = GetByte(srow, t)
                        t = Add(soff, 2)
                        pr = GetByte(srow, t)
                        t = Add(soff, 3)
                        pa = GetByte(srow, t)
                        sum_r = Add(sum_r, pr)
                        sum_g = Add(sum_g, pg)
                        sum_b = Add(sum_b, pb)
                        sum_a = Add(sum_a, pa)
                        kx = Add(kx, 1)
                    }
                    ky = Add(ky, 1)
                }

                // Average: (sum + 8) / 16
                ar = Add(sum_r, 8)
                ar = Divide(ar, 16)
                ag = Add(sum_g, 8)
                ag = Divide(ag, 16)
                ab = Add(sum_b, 8)
                ab = Divide(ab, 16)
                aa = Add(sum_a, 8)
                aa = Divide(aa, 16)

                doff = Multiply(dx, 4)
                SetByte(dr, doff, ab)
                t = Add(doff, 1)
                SetByte(dr, t, ag)
                t = Add(doff, 2)
                SetByte(dr, t, ar)
                t = Add(doff, 3)
                SetByte(dr, t, aa)

                dx = Add(dx, 1)
            }
            dy = Add(dy, 1)
        }
        ReturnValue(1)
    }
}

// =============================================================================
// CONVENIENCE — render TVG at Nx, downsample, return final surface
// Caller passes the TVG_Parse function result at oversized resolution
// =============================================================================

// SS_RenderDown2x: takes oversize surface (2w x 2h), returns (w x h)
Function.SS_RenderDown2x {
    Input: src_surf: Integer
    Input: w: Integer
    Input: h: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(src_surf, 0) ThenBlock: { ReturnValue(0) }
        dst = Surface_Create(SurfaceFormat.PIXEL_32, w, h)
        IfCondition EqualTo(dst, 0) ThenBlock: { ReturnValue(0) }
        Draw_Pix_FillRect(dst, 0, 0, w, h, 0)
        SS_Down2x(src_surf, dst, w, h)
        ReturnValue(dst)
    }
}

// SS_RenderDown4x: takes oversize surface (4w x 4h), returns (w x h)
Function.SS_RenderDown4x {
    Input: src_surf: Integer
    Input: w: Integer
    Input: h: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(src_surf, 0) ThenBlock: { ReturnValue(0) }
        dst = Surface_Create(SurfaceFormat.PIXEL_32, w, h)
        IfCondition EqualTo(dst, 0) ThenBlock: { ReturnValue(0) }
        Draw_Pix_FillRect(dst, 0, 0, w, h, 0)
        SS_Down4x(src_surf, dst, w, h)
        ReturnValue(dst)
    }
}