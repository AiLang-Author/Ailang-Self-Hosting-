// Library.SurfaceBlit.ailang
// Surface-to-surface compositing: alpha blit, tinted blit, region blit.
// Foundation for text rendering, icon compositing, UI layering.
// All expressions flattened for 6-register ABI.
// Copyright © 2026 Sean Collins, 2 Paws Machine and Engineering. SCSL.

LibraryImport.Display.Render.DSurfaceTypes
LibraryImport.Display.Render.DSurface

// =============================================================================
// Surface_BlitAlpha — blit src onto dst with per-pixel alpha compositing
// Respects src alpha channel. Bounds-checked against both surfaces.
// =============================================================================
Function.Surface_BlitAlpha {
    Input: dst: Integer
    Input: src: Integer
    Input: dst_x: Integer
    Input: dst_y: Integer
    Body: {
        sw = Surface_GetWidth(src)
        sh = Surface_GetHeight(src)
        dw = Surface_GetWidth(dst)
        dh = Surface_GetHeight(dst)

        src_data  = Surface_GetData(src)
        src_pitch = Surface_GetPitch(src)
        dst_data  = Surface_GetData(dst)
        dst_pitch = Surface_GetPitch(dst)

        // Clip source rect to destination bounds
        sx_start = 0
        sy_start = 0
        sx_end = sw
        sy_end = sh

        // Clip left
        IfCondition LessThan(dst_x, 0) ThenBlock: {
            sx_start = Subtract(0, dst_x)
            dst_x = 0
        }
        // Clip top
        IfCondition LessThan(dst_y, 0) ThenBlock: {
            sy_start = Subtract(0, dst_y)
            dst_y = 0
        }
        // Clip right
        ovr = Subtract(Add(dst_x, sw), dw)
        IfCondition GreaterThan(ovr, 0) ThenBlock: {
            sx_end = Subtract(sw, ovr)
        }
        // Clip bottom
        ovb = Subtract(Add(dst_y, sh), dh)
        IfCondition GreaterThan(ovb, 0) ThenBlock: {
            sy_end = Subtract(sh, ovb)
        }

        // Nothing to draw
        IfCondition GreaterEqual(sx_start, sx_end) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterEqual(sy_start, sy_end) ThenBlock: { ReturnValue(0) }

        sy = sy_start
        WhileLoop LessThan(sy, sy_end) {
            // Source row pointer
            sr_off = Multiply(sy, src_pitch)
            sr_ptr = Add(src_data, sr_off)
            // Dest row pointer
            dy_actual = Add(dst_y, Subtract(sy, sy_start))
            dr_off = Multiply(dy_actual, dst_pitch)
            dr_ptr = Add(dst_data, dr_off)

            sx = sx_start
            WhileLoop LessThan(sx, sx_end) {
                // Read src pixel (BGRA)
                s_off = Multiply(sx, 4)
                sb = GetByte(sr_ptr, s_off)
                t = Add(s_off, 1)
                sg = GetByte(sr_ptr, t)
                t = Add(s_off, 2)
                sr = GetByte(sr_ptr, t)
                t = Add(s_off, 3)
                sa = GetByte(sr_ptr, t)

                // Skip fully transparent
                IfCondition NotEqual(sa, 0) ThenBlock: {
                    dx_actual = Add(dst_x, Subtract(sx, sx_start))
                    d_off = Multiply(dx_actual, 4)

                    // Fully opaque — direct write
                    IfCondition EqualTo(sa, 255) ThenBlock: {
                        SetByte(dr_ptr, d_off, sb)
                        t = Add(d_off, 1)
                        SetByte(dr_ptr, t, sg)
                        t = Add(d_off, 2)
                        SetByte(dr_ptr, t, sr)
                        t = Add(d_off, 3)
                        SetByte(dr_ptr, t, 255)
                    }

                    // Semi-transparent — linear blend
                    IfCondition LessThan(sa, 255) ThenBlock: {
                        // Read dst pixel
                        db = GetByte(dr_ptr, d_off)
                        t = Add(d_off, 1)
                        dg = GetByte(dr_ptr, t)
                        t = Add(d_off, 2)
                        dr2 = GetByte(dr_ptr, t)
                        t = Add(d_off, 3)
                        da = GetByte(dr_ptr, t)

                        inv = Subtract(255, sa)

                        t1 = Multiply(sr, sa)
                        t2 = Multiply(dr2, inv)
                        ob_r = Divide(Add(t1, t2), 255)

                        t1 = Multiply(sg, sa)
                        t2 = Multiply(dg, inv)
                        ob_g = Divide(Add(t1, t2), 255)

                        t1 = Multiply(sb, sa)
                        t2 = Multiply(db, inv)
                        ob_b = Divide(Add(t1, t2), 255)

                        t1 = Multiply(sa, 255)
                        t2 = Multiply(da, inv)
                        ob_a = Divide(Add(t1, t2), 255)

                        SetByte(dr_ptr, d_off, ob_b)
                        t = Add(d_off, 1)
                        SetByte(dr_ptr, t, ob_g)
                        t = Add(d_off, 2)
                        SetByte(dr_ptr, t, ob_r)
                        t = Add(d_off, 3)
                        SetByte(dr_ptr, t, ob_a)
                    }
                }
                sx = Add(sx, 1)
            }
            sy = Add(sy, 1)
        }
        ReturnValue(1)
    }
}

// =============================================================================
// Surface_BlitTinted — blit src onto dst, replacing src RGB with tint color
// Preserves src alpha. Used for colored text: glyph is black-on-transparent,
// tint replaces black with the desired text color.
// =============================================================================
Function.Surface_BlitTinted {
    Input: dst: Integer
    Input: src: Integer
    Input: dst_x: Integer
    Input: dst_y: Integer
    Input: tint: Integer
    Body: {
        // Unpack tint color (BGRA packed)
        tint_b = BitwiseAnd(tint, 255)
        t = ShiftRight(tint, 8)
        tint_g = BitwiseAnd(t, 255)
        t = ShiftRight(tint, 16)
        tint_r = BitwiseAnd(t, 255)

        sw = Surface_GetWidth(src)
        sh = Surface_GetHeight(src)
        dw = Surface_GetWidth(dst)
        dh = Surface_GetHeight(dst)

        src_data  = Surface_GetData(src)
        src_pitch = Surface_GetPitch(src)
        dst_data  = Surface_GetData(dst)
        dst_pitch = Surface_GetPitch(dst)

        // Clip
        sx_start = 0
        sy_start = 0
        sx_end = sw
        sy_end = sh

        IfCondition LessThan(dst_x, 0) ThenBlock: {
            sx_start = Subtract(0, dst_x)
            dst_x = 0
        }
        IfCondition LessThan(dst_y, 0) ThenBlock: {
            sy_start = Subtract(0, dst_y)
            dst_y = 0
        }
        ovr = Subtract(Add(dst_x, sw), dw)
        IfCondition GreaterThan(ovr, 0) ThenBlock: {
            sx_end = Subtract(sw, ovr)
        }
        ovb = Subtract(Add(dst_y, sh), dh)
        IfCondition GreaterThan(ovb, 0) ThenBlock: {
            sy_end = Subtract(sh, ovb)
        }

        IfCondition GreaterEqual(sx_start, sx_end) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterEqual(sy_start, sy_end) ThenBlock: { ReturnValue(0) }

        sy = sy_start
        WhileLoop LessThan(sy, sy_end) {
            sr_off = Multiply(sy, src_pitch)
            sr_ptr = Add(src_data, sr_off)
            dy_actual = Add(dst_y, Subtract(sy, sy_start))
            dr_off = Multiply(dy_actual, dst_pitch)
            dr_ptr = Add(dst_data, dr_off)

            sx = sx_start
            WhileLoop LessThan(sx, sx_end) {
                // Only read alpha from src — color comes from tint
                s_off = Multiply(sx, 4)
                t = Add(s_off, 3)
                sa = GetByte(sr_ptr, t)

                IfCondition NotEqual(sa, 0) ThenBlock: {
                    dx_actual = Add(dst_x, Subtract(sx, sx_start))
                    d_off = Multiply(dx_actual, 4)

                    IfCondition EqualTo(sa, 255) ThenBlock: {
                        SetByte(dr_ptr, d_off, tint_b)
                        t = Add(d_off, 1)
                        SetByte(dr_ptr, t, tint_g)
                        t = Add(d_off, 2)
                        SetByte(dr_ptr, t, tint_r)
                        t = Add(d_off, 3)
                        SetByte(dr_ptr, t, 255)
                    }

                    IfCondition LessThan(sa, 255) ThenBlock: {
                        db = GetByte(dr_ptr, d_off)
                        t = Add(d_off, 1)
                        dg = GetByte(dr_ptr, t)
                        t = Add(d_off, 2)
                        dr2 = GetByte(dr_ptr, t)
                        t = Add(d_off, 3)
                        da = GetByte(dr_ptr, t)

                        inv = Subtract(255, sa)

                        t1 = Multiply(tint_r, sa)
                        t2 = Multiply(dr2, inv)
                        ob_r = Divide(Add(t1, t2), 255)

                        t1 = Multiply(tint_g, sa)
                        t2 = Multiply(dg, inv)
                        ob_g = Divide(Add(t1, t2), 255)

                        t1 = Multiply(tint_b, sa)
                        t2 = Multiply(db, inv)
                        ob_b = Divide(Add(t1, t2), 255)

                        t1 = Multiply(sa, 255)
                        t2 = Multiply(da, inv)
                        ob_a = Divide(Add(t1, t2), 255)

                        SetByte(dr_ptr, d_off, ob_b)
                        t = Add(d_off, 1)
                        SetByte(dr_ptr, t, ob_g)
                        t = Add(d_off, 2)
                        SetByte(dr_ptr, t, ob_r)
                        t = Add(d_off, 3)
                        SetByte(dr_ptr, t, ob_a)
                    }
                }
                sx = Add(sx, 1)
            }
            sy = Add(sy, 1)
        }
        ReturnValue(1)
    }
}

// =============================================================================
// Surface_BlitRegion — blit a sub-rectangle of src onto dst
// For scrolling viewports, partial glyph clips, sprite sheets.
// =============================================================================
Function.Surface_BlitRegion {
    Input: dst: Integer
    Input: src: Integer
    Input: sx: Integer
    Input: sy: Integer
    Body: {
        // Remaining params via BlitRegionParams (6-register limit)
        bw = BlitRegionParams.w
        bh = BlitRegionParams.h
        bx = BlitRegionParams.dst_x
        by = BlitRegionParams.dst_y

        sw = Surface_GetWidth(src)
        sh = Surface_GetHeight(src)
        dw = Surface_GetWidth(dst)
        dh = Surface_GetHeight(dst)

        src_data  = Surface_GetData(src)
        src_pitch = Surface_GetPitch(src)
        dst_data  = Surface_GetData(dst)
        dst_pitch = Surface_GetPitch(dst)

        // Clamp source region to src bounds
        IfCondition LessThan(sx, 0) ThenBlock: {
            bw = Add(bw, sx)
            bx = Subtract(bx, sx)
            sx = 0
        }
        IfCondition LessThan(sy, 0) ThenBlock: {
            bh = Add(bh, sy)
            by = Subtract(by, sy)
            sy = 0
        }
        t = Add(sx, bw)
        IfCondition GreaterThan(t, sw) ThenBlock: { bw = Subtract(sw, sx) }
        t = Add(sy, bh)
        IfCondition GreaterThan(t, sh) ThenBlock: { bh = Subtract(sh, sy) }

        // Clamp dest region to dst bounds
        IfCondition LessThan(bx, 0) ThenBlock: {
            bw = Add(bw, bx)
            sx = Subtract(sx, bx)
            bx = 0
        }
        IfCondition LessThan(by, 0) ThenBlock: {
            bh = Add(bh, by)
            sy = Subtract(sy, by)
            by = 0
        }
        t = Add(bx, bw)
        IfCondition GreaterThan(t, dw) ThenBlock: { bw = Subtract(dw, bx) }
        t = Add(by, bh)
        IfCondition GreaterThan(t, dh) ThenBlock: { bh = Subtract(dh, by) }

        // Nothing to draw
        IfCondition LessEqual(bw, 0) ThenBlock: { ReturnValue(0) }
        IfCondition LessEqual(bh, 0) ThenBlock: { ReturnValue(0) }

        // Copy rows
        row = 0
        WhileLoop LessThan(row, bh) {
            sry = Add(sy, row)
            dry = Add(by, row)
            sr_off = Multiply(sry, src_pitch)
            sr_ptr = Add(src_data, sr_off)
            dr_off = Multiply(dry, dst_pitch)
            dr_ptr = Add(dst_data, dr_off)

            col = 0
            WhileLoop LessThan(col, bw) {
                srx = Add(sx, col)
                drx = Add(bx, col)
                s_off = Multiply(srx, 4)
                d_off = Multiply(drx, 4)

                // Read src BGRA
                pb = GetByte(sr_ptr, s_off)
                t = Add(s_off, 1)
                pg = GetByte(sr_ptr, t)
                t = Add(s_off, 2)
                pr = GetByte(sr_ptr, t)
                t = Add(s_off, 3)
                pa = GetByte(sr_ptr, t)

                // Alpha blend
                IfCondition NotEqual(pa, 0) ThenBlock: {
                    IfCondition EqualTo(pa, 255) ThenBlock: {
                        SetByte(dr_ptr, d_off, pb)
                        t = Add(d_off, 1)
                        SetByte(dr_ptr, t, pg)
                        t = Add(d_off, 2)
                        SetByte(dr_ptr, t, pr)
                        t = Add(d_off, 3)
                        SetByte(dr_ptr, t, 255)
                    }
                    IfCondition LessThan(pa, 255) ThenBlock: {
                        db = GetByte(dr_ptr, d_off)
                        t = Add(d_off, 1)
                        dg = GetByte(dr_ptr, t)
                        t = Add(d_off, 2)
                        dr2 = GetByte(dr_ptr, t)
                        t = Add(d_off, 3)
                        da = GetByte(dr_ptr, t)

                        inv = Subtract(255, pa)
                        t1 = Multiply(pr, pa)
                        t2 = Multiply(dr2, inv)
                        ob_r = Divide(Add(t1, t2), 255)
                        t1 = Multiply(pg, pa)
                        t2 = Multiply(dg, inv)
                        ob_g = Divide(Add(t1, t2), 255)
                        t1 = Multiply(pb, pa)
                        t2 = Multiply(db, inv)
                        ob_b = Divide(Add(t1, t2), 255)
                        t1 = Multiply(pa, 255)
                        t2 = Multiply(da, inv)
                        ob_a = Divide(Add(t1, t2), 255)

                        SetByte(dr_ptr, d_off, ob_b)
                        t = Add(d_off, 1)
                        SetByte(dr_ptr, t, ob_g)
                        t = Add(d_off, 2)
                        SetByte(dr_ptr, t, ob_r)
                        t = Add(d_off, 3)
                        SetByte(dr_ptr, t, ob_a)
                    }
                }
                col = Add(col, 1)
            }
            row = Add(row, 1)
        }
        ReturnValue(1)
    }
}

// Params for BlitRegion — set before calling (6-register workaround)
FixedPool.BlitRegionParams {
    "w":     Initialize=0
    "h":     Initialize=0
    "dst_x": Initialize=0
    "dst_y": Initialize=0
}

// =============================================================================
// Helper — set BlitRegion params before calling Surface_BlitRegion
// =============================================================================
Function.Surface_BlitRegionSetup {
    Input: w: Integer
    Input: h: Integer
    Input: dst_x: Integer
    Input: dst_y: Integer
    Body: {
        BlitRegionParams.w     = w
        BlitRegionParams.h     = h
        BlitRegionParams.dst_x = dst_x
        BlitRegionParams.dst_y = dst_y
        ReturnValue(0)
    }
}

// =============================================================================
// Surface_BlitOpaque — fast path, no alpha, direct copy
// For backgrounds, solid fills, non-transparent surfaces.
// =============================================================================
Function.Surface_BlitOpaque {
    Input: dst: Integer
    Input: src: Integer
    Input: dst_x: Integer
    Input: dst_y: Integer
    Body: {
        sw = Surface_GetWidth(src)
        sh = Surface_GetHeight(src)
        dw = Surface_GetWidth(dst)
        dh = Surface_GetHeight(dst)

        src_data  = Surface_GetData(src)
        src_pitch = Surface_GetPitch(src)
        dst_data  = Surface_GetData(dst)
        dst_pitch = Surface_GetPitch(dst)

        // Clip
        sx_start = 0
        sy_start = 0
        copy_w = sw
        copy_h = sh

        IfCondition LessThan(dst_x, 0) ThenBlock: {
            sx_start = Subtract(0, dst_x)
            copy_w = Subtract(copy_w, sx_start)
            dst_x = 0
        }
        IfCondition LessThan(dst_y, 0) ThenBlock: {
            sy_start = Subtract(0, dst_y)
            copy_h = Subtract(copy_h, sy_start)
            dst_y = 0
        }
        ovr = Subtract(Add(dst_x, copy_w), dw)
        IfCondition GreaterThan(ovr, 0) ThenBlock: { copy_w = Subtract(copy_w, ovr) }
        ovb = Subtract(Add(dst_y, copy_h), dh)
        IfCondition GreaterThan(ovb, 0) ThenBlock: { copy_h = Subtract(copy_h, ovb) }

        IfCondition LessEqual(copy_w, 0) ThenBlock: { ReturnValue(0) }
        IfCondition LessEqual(copy_h, 0) ThenBlock: { ReturnValue(0) }

        row_bytes = Multiply(copy_w, 4)
        row = 0
        WhileLoop LessThan(row, copy_h) {
            sry = Add(sy_start, row)
            dry = Add(dst_y, row)
            sr_off = Add(Multiply(sry, src_pitch), Multiply(sx_start, 4))
            sr_ptr = Add(src_data, sr_off)
            dr_off = Add(Multiply(dry, dst_pitch), Multiply(dst_x, 4))
            dr_ptr = Add(dst_data, dr_off)

            MemoryCopy(dr_ptr, sr_ptr, row_bytes)
            row = Add(row, 1)
        }
        ReturnValue(1)
    }
}

// ---------------------------------------------------------------------------
// Surface_DownsampleNx — N× box-filter downsample (PIXEL_32 BGRA)
//
// Takes a surface rendered at N× resolution and produces a 1/N size surface.
// Pure box-filter average — no artificial sharpening or contrast curves.
// At 8× (64 samples per pixel) the natural coverage produces smooth AA
// with enough alpha resolution to render thin strokes cleanly.
//
// The alpha channel is the only channel that matters for font glyph
// compositing (Surface_BlitTinted reads alpha only, applies tint color).
// We still average all 4 channels for correctness with non-font uses.
// ---------------------------------------------------------------------------
Function.Surface_DownsampleNx {
    Input:  src: Integer
    Input:  n: Integer
    Output: Integer
    Body: {
        sw = Surface_GetWidth(src)
        sh = Surface_GetHeight(src)
        dw = Divide(sw, n)
        dh = Divide(sh, n)
        IfCondition LessThan(dw, 1) ThenBlock: { dw = 1 }
        IfCondition LessThan(dh, 1) ThenBlock: { dh = 1 }
        n_sq = Multiply(n, n)

        dst = Surface_Create(SurfaceFormat.PIXEL_32, dw, dh)
        IfCondition EqualTo(dst, 0) ThenBlock: { ReturnValue(0) }

        src_data  = Surface_GetData(src)
        src_pitch = Surface_GetPitch(src)
        dst_data  = Surface_GetData(dst)
        dst_pitch = Surface_GetPitch(dst)

        dy = 0
        WhileLoop LessThan(dy, dh) {
            dx = 0
            WhileLoop LessThan(dx, dw) {
                sum_b = 0
                sum_g = 0
                sum_r = 0
                sum_a = 0

                // Sample N×N block
                by = 0
                WhileLoop LessThan(by, n) {
                    sy = Add(Multiply(dy, n), by)
                    IfCondition LessThan(sy, sh) ThenBlock: {
                        row_ptr = Add(src_data, Multiply(sy, src_pitch))
                        bx = 0
                        WhileLoop LessThan(bx, n) {
                            sx = Add(Multiply(dx, n), bx)
                            IfCondition LessThan(sx, sw) ThenBlock: {
                                off = Multiply(sx, 4)
                                sum_b = Add(sum_b, GetByte(row_ptr, off))
                                sum_g = Add(sum_g, GetByte(row_ptr, Add(off, 1)))
                                sum_r = Add(sum_r, GetByte(row_ptr, Add(off, 2)))
                                sum_a = Add(sum_a, GetByte(row_ptr, Add(off, 3)))
                            }
                            bx = Add(bx, 1)
                        }
                    }
                    by = Add(by, 1)
                }

                // Box-filter average (divide by N²)
                avg_b = Divide(sum_b, n_sq)
                avg_g = Divide(sum_g, n_sq)
                avg_r = Divide(sum_r, n_sq)
                avg_a = Divide(sum_a, n_sq)

                // Write output pixel
                dst_row = Add(dst_data, Multiply(dy, dst_pitch))
                d_off = Multiply(dx, 4)
                SetByte(dst_row, d_off, avg_b)
                SetByte(dst_row, Add(d_off, 1), avg_g)
                SetByte(dst_row, Add(d_off, 2), avg_r)
                SetByte(dst_row, Add(d_off, 3), avg_a)

                dx = Add(dx, 1)
            }
            dy = Add(dy, 1)
        }

        ReturnValue(dst)
    }
}

// =============================================================================
// Surface_FlipV — flip a surface vertically in-place (swap rows)
// =============================================================================
Function.Surface_FlipV {
    Input: surf: Integer
    Body: {
        IfCondition EqualTo(surf, 0) ThenBlock: { ReturnValue(0) }
        sw    = Surface_GetWidth(surf)
        sh    = Surface_GetHeight(surf)
        data  = Surface_GetData(surf)
        pitch = Surface_GetPitch(surf)
        IfCondition LessEqual(sh, 1) ThenBlock: { ReturnValue(0) }

        row_bytes = Multiply(sw, 4)
        tmp = Allocate(row_bytes)
        IfCondition EqualTo(tmp, 0) ThenBlock: { ReturnValue(0) }

        top = 0
        bot = Subtract(sh, 1)
        WhileLoop LessThan(top, bot) {
            top_ptr = Add(data, Multiply(top, pitch))
            bot_ptr = Add(data, Multiply(bot, pitch))
            // swap: tmp=top, top=bot, bot=tmp
            MemoryCopy(tmp, top_ptr, row_bytes)
            MemoryCopy(top_ptr, bot_ptr, row_bytes)
            MemoryCopy(bot_ptr, tmp, row_bytes)
            top = Add(top, 1)
            bot = Subtract(bot, 1)
        }
        Deallocate(tmp, row_bytes)
        ReturnValue(1)
    }
}