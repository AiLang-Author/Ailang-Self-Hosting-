LibraryImport.Cad.CAD_Sys
LibraryImport.Cad.CAD_Store
LibraryImport.StringUtils

FixedPool.Vulkan_State {
    "instance_count":    Initialize=0
    "device_count":      Initialize=0
    "command_buffers":   Initialize=0
    "draw_calls":        Initialize=0
}

// -------------------------------------------------------------------------
// 1. Vulkan Core Driver Instance & Device Lifecycle
// -------------------------------------------------------------------------

Function.Vulkan.CreateInstance {
    Input: app_name_addr: Address
    Input: out_instance_handle_addr: Address
    Output: Integer
    Body: {
        h_inst = CAD_Store.Alloc(13, 4) // Tag 13=Vulkan Instance
        ArraySet(out_instance_handle_addr, 0, h_inst)
        Vulkan_State.instance_count = Add(Vulkan_State.instance_count, 1)
        ReturnValue(0) // VK_SUCCESS
    }
}

Function.Vulkan.EnumeratePhysicalDevices {
    Input: instance_handle: Integer
    Input: out_count_addr: Address
    Input: out_devices_arr_addr: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(instance_handle, 0) ThenBlock: {
            ReturnValue(-1) // VK_ERROR_INITIALIZATION_FAILED
        }
        ArraySet(out_count_addr, 0, 1) // 1 Physical GPU Device Found
        Vulkan_State.device_count = Add(Vulkan_State.device_count, 1)
        ReturnValue(0) // VK_SUCCESS
    }
}

Function.Vulkan.CreateDevice {
    Input: physical_device_handle: Integer
    Input: out_device_handle_addr: Address
    Output: Integer
    Body: {
        h_device = CAD_Store.Alloc(14, 4) // Tag 14=Vulkan Logical Device
        ArraySet(out_device_handle_addr, 0, h_device)
        ReturnValue(0) // VK_SUCCESS
    }
}

// -------------------------------------------------------------------------
// 2. Command Queues, Buffers & Pipeline Binding
// -------------------------------------------------------------------------

Function.Vulkan.CreateCommandPool {
    Input: device_handle: Integer
    Input: queue_family_idx: Integer
    Input: out_pool_addr: Address
    Output: Integer
    Body: {
        h_pool = CAD_Store.Alloc(15, 4) // Tag 15=Command Pool
        ArraySet(out_pool_addr, 0, h_pool)
        ReturnValue(0) // VK_SUCCESS
    }
}

Function.Vulkan.AllocateCommandBuffers {
    Input: device_handle: Integer
    Input: pool_handle: Integer
    Input: count: Integer
    Input: out_buffers_addr: Address
    Output: Integer
    Body: {
        Vulkan_State.command_buffers = Add(Vulkan_State.command_buffers, count)
        ReturnValue(0) // VK_SUCCESS
    }
}

Function.Vulkan.CmdDraw {
    Input: cmd_buffer_handle: Integer
    Input: vertex_count: Integer
    Input: instance_count: Integer
    Input: first_vertex: Integer
    Input: first_instance: Integer
    Output: Integer
    Body: {
        Vulkan_State.draw_calls = Add(Vulkan_State.draw_calls, 1)
        ReturnValue(0) // VK_SUCCESS
    }
}

Function.Vulkan.QueueSubmit {
    Input: queue_handle: Integer
    Input: submit_count: Integer
    Input: fence_handle: Integer
    Output: Integer
    Body: {
        ReturnValue(0) // VK_SUCCESS
    }
}

Function.Vulkan.DestroyInstance {
    Input: instance_handle: Integer
    Output: Integer
    Body: {
        ReturnValue(0) // VK_SUCCESS
    }
}
