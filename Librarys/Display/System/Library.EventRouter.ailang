// Library.EventRouter.ailang
// Action queue and dispatch — the "what happens" side of event routing.
//
// InputRouter / Win_ToolbarEvent determine WHERE a click lands and push
// action strings onto the queue. EventRouter drains the queue in the main
// loop AFTER all Auckland contexts are restored, so it's safe to create
// windows, send IPC, modify any state.
//
// Copyright © 2026 Sean Collins, 2 Paws Machine and Engineering. SCSL.

LibraryImport.StringUtils
LibraryImport.Display.Window.WinManager
LibraryImport.Display.Menu.Menu
LibraryImport.Display.UI.FileDialog
LibraryImport.Display.Menu.Deskbar
LibraryImport.Display.UI.AboutDialog
LibraryImport.Display.System.Screenshot
LibraryImport.Display.UI.Auckland
LibraryImport.Display.UI.AucklandEvent
LibraryImport.TextBuffer
LibraryImport.Display.Content.DocView

// =============================================================================
// HANDLER REGISTRY
//
// Generic table of registered action handlers. Apps self-register during init.
// EventRouter_Internal checks this table FIRST before hardcoded handlers.
// Each entry: [action_str (8), callback (8)] = 16 bytes.
// Callback is called via CallIndirect(cb, action_ptr, action_len).
// =============================================================================

FixedPool.ERHandlerConst {
    "ENTRY_SIZE": Initialize=16
    "MAX":        Initialize=16
}

FixedPool.ERHandlerTable {
    "data":  Initialize=0, CanChange=True
    "count": Initialize=0, CanChange=True
}

// =============================================================================
// ACTION QUEUE
//
// Circular buffer of action entries.
// Each entry: [action_ptr (8), action_len (8), source_win (8)]
//   source_win: which window generated the action
//     -1 = desktop taskbar
//      0 = desktop (shouldn't generate actions)
//     1+ = window index
//
// Max 16 pending actions. Overflow drops oldest.
// =============================================================================

FixedPool.ActionQueueConst {
    "ENTRY_SIZE": Initialize=24
    "MAX":        Initialize=16
}

FixedPool.ActionQueueFields {
    "ACTION_PTR":  Initialize=0
    "ACTION_LEN":  Initialize=8
    "SOURCE_WIN":  Initialize=16
}

FixedPool.ActionQueue {
    "data":  Initialize=0
    "head":  Initialize=0, CanChange=True
    "tail":  Initialize=0, CanChange=True
    "count": Initialize=0, CanChange=True
}

// =============================================================================
// INIT
// =============================================================================
Function.EventRouter_Init {
    Output: Integer
    Body: {
        DebugLog_Push("er.ini", 6)
        sz = Multiply(ActionQueueConst.MAX, ActionQueueConst.ENTRY_SIZE)
        DebugLog_Push("er.ini.1", 8)
        buf = Allocate(sz)
        DebugLog_Push("er.ini.2", 8)
        IfCondition EqualTo(buf, 0) ThenBlock: {
            PrintMessage("[EventRouter] alloc fail\n")
            ReturnValue(0)
        }
        i = 0
        WhileLoop LessThan(i, sz) {
            SetByte(buf, i, 0)
            i = Add(i, 1)
        }
        ActionQueue.data  = buf
        ActionQueue.head  = 0
        ActionQueue.tail  = 0
        ActionQueue.count = 0

        // Allocate handler registry
        hsz = Multiply(ERHandlerConst.MAX, ERHandlerConst.ENTRY_SIZE)
        hbuf = Allocate(hsz)
        IfCondition EqualTo(hbuf, 0) ThenBlock: {
            PrintMessage("[EventRouter] handler table alloc fail\n")
            ReturnValue(0)
        }
        MemorySet(hbuf, 0, hsz)
        ERHandlerTable.data  = hbuf
        ERHandlerTable.count = 0

        PrintMessage("[EventRouter] initialized\n")
        ReturnValue(1)
    }
}

// =============================================================================
// REGISTER HANDLER — apps self-register action handlers
//
// action_str: null-terminated action string (e.g. "app.calc")
// callback:   function address, called via CallIndirect(cb, action_ptr, action_len)
// =============================================================================
Function.EventRouter_RegisterHandler {
    Input: action_str: Address
    Input: callback: Address
    Output: Integer
    Body: {
        DebugLog_Push("er.reg", 6)
        idx = ERHandlerTable.count
        IfCondition GreaterEqual(idx, ERHandlerConst.MAX) ThenBlock: {
            PrintMessage("[EventRouter] handler table full\n")
            ReturnValue(0)
        }
        off = Multiply(idx, ERHandlerConst.ENTRY_SIZE)
        base = Add(ERHandlerTable.data, off)
        StoreValue(base, action_str)
        StoreValue(Add(base, 8), callback)
        ERHandlerTable.count = Add(idx, 1)
        PrintMessage("[EventRouter] registered: ")
        PrintString(action_str)
        PrintMessage("\n")
        ReturnValue(1)
    }
}

// =============================================================================
// PUSH — add an action to the queue
//
// Called by:
//   - EventRouter_ActionCallback (desktop taskbar, via AK_FireAction)
//   - Win_ToolbarEvent (after context restore, reads action from node)
// =============================================================================
Function.EventRouter_Push {
    Input: action_ptr: Address
    Input: action_len: Integer
    Input: source_win: Integer
    Output: Integer
    Body: {
        DebugLog_Push("er.push", 7)
        IfCondition EqualTo(action_ptr, 0) ThenBlock: { ReturnValue(0) }
        IfCondition LessEqual(action_len, 0) ThenBlock: { ReturnValue(0) }

        // If full, drop oldest
        IfCondition GreaterEqual(ActionQueue.count, ActionQueueConst.MAX) ThenBlock: {
            PrintMessage("[EventRouter] WARNING: queue full, dropping oldest\n")
            ActionQueue.head = Modulo(Add(ActionQueue.head, 1), ActionQueueConst.MAX)
            ActionQueue.count = Subtract(ActionQueue.count, 1)
        }

        // Write at tail
        off = Multiply(ActionQueue.tail, ActionQueueConst.ENTRY_SIZE)
        base = Add(ActionQueue.data, off)
        StoreValue(Add(base, ActionQueueFields.ACTION_PTR), action_ptr)
        StoreValue(Add(base, ActionQueueFields.ACTION_LEN), action_len)
        StoreValue(Add(base, ActionQueueFields.SOURCE_WIN), source_win)

        ActionQueue.tail = Modulo(Add(ActionQueue.tail, 1), ActionQueueConst.MAX)
        ActionQueue.count = Add(ActionQueue.count, 1)
        ReturnValue(1)
    }
}

// =============================================================================
// ACTION CALLBACK — safe to call from inside AK_FireAction
//
// This is what AKEvent.action_callback points to. AK_FireAction calls
// it via CallIndirect. All it does is push to the queue — no window
// creation, no context manipulation.
//
// Used by the desktop taskbar (global AKTree context).
// Toolbar events use a different path (manual push after restore).
// =============================================================================
Function.EventRouter_ActionCallback {
    Input: action_ptr: Address
    Input: action_len: Integer
    Output: Integer
    Body: {
        DebugLog_Push("er.cb", 5)
        DebugLog_Push("er.cb.1", 7)
        EventRouter_Push(action_ptr, action_len, -1)
        DebugLog_Push("er.cb.2", 7)
        ReturnValue(1)
    }
}

// No-op callback — used by toolbar/menu/dialog to suppress AK_FireAction
// during event dispatch (action is read manually from focus_node instead)
Function.EventRouter_NoOpCallback {
    Input: action_ptr: Address
    Input: action_len: Integer
    Output: Integer
    Body: {
        DebugLog_Push("er.nop", 6)
        ReturnValue(0)
    }
}

// =============================================================================
// DRAIN — process all pending actions
//
// Called from main loop AFTER:
//   - SysDisplay_DrainInput returns (all mouse/key events processed)
//   - All Auckland contexts restored to main
//   - AK_DrawDirty done
//
// Returns number of actions processed.
// =============================================================================
Function.EventRouter_Drain {
    Output: Integer
    Body: {
        DebugLog_Push("er.drn", 6)
        processed = 0

        WhileLoop GreaterThan(ActionQueue.count, 0) {
            // Read from head
            off = Multiply(ActionQueue.head, ActionQueueConst.ENTRY_SIZE)
            base = Add(ActionQueue.data, off)
            action_ptr = Dereference(Add(base, ActionQueueFields.ACTION_PTR))
            action_len = Dereference(Add(base, ActionQueueFields.ACTION_LEN))
            source_win = Dereference(Add(base, ActionQueueFields.SOURCE_WIN))

            PrintMessage("[ER_DRAIN] ptr=")
PrintNumber(action_ptr)
PrintMessage(" len=")
PrintNumber(action_len)
PrintMessage(" win=")
PrintNumber(source_win)
PrintMessage(" count=")
PrintNumber(ActionQueue.count)
PrintMessage("\n")

            // Advance head
            ActionQueue.head = Modulo(Add(ActionQueue.head, 1), ActionQueueConst.MAX)
            ActionQueue.count = Subtract(ActionQueue.count, 1)

            // Dispatch
            IfCondition NotEqual(action_ptr, 0) ThenBlock: {
                DebugLog_Push("er.dra.1", 8)
                EventRouter_Dispatch(action_ptr, action_len, source_win)
                DebugLog_Push("er.dra.2", 8)
                processed = Add(processed, 1)
            }
        }

        ReturnValue(processed)
    }
}

// =============================================================================
// DISPATCH — route a single action
//
// Priority:
//   1. WinView.bindings for source_win (future: IPC to service binary)
//   2. Internal handlers
//   3. Log unknown
// =============================================================================
Function.EventRouter_Dispatch {
    Input: action_ptr: Address
    Input: action_len: Integer
    Input: source_win: Integer
    Body: {
        DebugLog_Push("er.disp", 7)
        // --- Priority 1: System actions always handled locally ---
        // Actions prefixed "win." "app." "menu:" "sys." "fd." are display
        // server commands — never forward to IPC app processes.
        is_system = 0
        IfCondition GreaterEqual(action_len, 4) ThenBlock: {
            b0 = GetByte(action_ptr, 0)
            b1 = GetByte(action_ptr, 1)
            b2 = GetByte(action_ptr, 2)
            b3 = GetByte(action_ptr, 3)
            // "win." = 119 105 110 46
            IfCondition And(EqualTo(b0, 119), And(EqualTo(b1, 105), And(EqualTo(b2, 110), EqualTo(b3, 46)))) ThenBlock: {
                is_system = 1
            }
            // "app." = 97 112 112 46
            IfCondition And(EqualTo(b0, 97), And(EqualTo(b1, 112), And(EqualTo(b2, 112), EqualTo(b3, 46)))) ThenBlock: {
                is_system = 1
            }
            // "sys." = 115 121 115 46
            IfCondition And(EqualTo(b0, 115), And(EqualTo(b1, 121), And(EqualTo(b2, 115), EqualTo(b3, 46)))) ThenBlock: {
                is_system = 1
            }
            // "fd."  = 102 100 46
            IfCondition And(EqualTo(b0, 102), And(EqualTo(b1, 100), EqualTo(b2, 46))) ThenBlock: {
                is_system = 1
            }
            // "sm."  = 115 109 46
            IfCondition And(EqualTo(b0, 115), And(EqualTo(b1, 109), EqualTo(b2, 46))) ThenBlock: {
                is_system = 1
            }
            // "doc." = 100 111 99 46
            IfCondition And(EqualTo(b0, 100), And(EqualTo(b1, 111), And(EqualTo(b2, 99), EqualTo(b3, 46)))) ThenBlock: {
                is_system = 1
            }
            // "fmt." = 102 109 116 46
            IfCondition And(EqualTo(b0, 102), And(EqualTo(b1, 109), And(EqualTo(b2, 116), EqualTo(b3, 46)))) ThenBlock: {
                is_system = 1
            }
        }
        IfCondition GreaterEqual(action_len, 5) ThenBlock: {
            m0 = GetByte(action_ptr, 0)
            m1 = GetByte(action_ptr, 1)
            m2 = GetByte(action_ptr, 2)
            m3 = GetByte(action_ptr, 3)
            m4 = GetByte(action_ptr, 4)
            // "menu:" = 109 101 110 117 58
            IfCondition And(EqualTo(m0, 109), And(EqualTo(m1, 101), And(EqualTo(m2, 110), And(EqualTo(m3, 117), EqualTo(m4, 58))))) ThenBlock: {
                is_system = 1
            }
        }

        // --- Priority 2: IPC routing for app-owned windows (non-system actions only) ---
        IfCondition And(EqualTo(is_system, 0), GreaterEqual(source_win, 1)) ThenBlock: {
            job = WinView_GetJobPtr(source_win)
            IfCondition GreaterThan(job, 0) ThenBlock: {
                IPCBroker_RouteAction(job, action_ptr, action_len, source_win)
                ReturnValue(0)
            }
        }

        // --- Priority 3: Internal handlers ---
        handled = EventRouter_Internal(action_ptr, action_len, source_win)
        IfCondition EqualTo(handled, 1) ThenBlock: { ReturnValue(0) }

        // --- Priority 4: Unknown ---
        PrintMessage("[EventRouter] unknown: ")
        PrintString(action_ptr)
        PrintMessage(" from win ")
        PrintNumber(source_win)
        PrintMessage("\n")
    }
}

// =============================================================================
// INTERNAL HANDLERS
// Returns 1 if handled, 0 if not recognized.
// =============================================================================
Function.EventRouter_Internal {
    Input: action_ptr: Address
    Input: action_len: Integer
    Input: source_win: Integer
    Output: Integer
    Body: {
        DebugLog_Push("er.int", 6)

        IfCondition EqualTo(EventRouter_Doc(action_ptr, source_win), 1) ThenBlock: {
            ReturnValue(1)
        }
        IfCondition EqualTo(EventRouter_Fmt(action_ptr, source_win), 1) ThenBlock: {
            ReturnValue(1)
        }

        // Check registered handlers first (generic dispatch)
        rhi = 0
        WhileLoop LessThan(rhi, ERHandlerTable.count) {
            rh_off = Multiply(rhi, ERHandlerConst.ENTRY_SIZE)
            rh_base = Add(ERHandlerTable.data, rh_off)
            rh_str = Dereference(rh_base)
            rh_cb  = Dereference(Add(rh_base, 8))
            rh_cmp = StringCompare(action_ptr, rh_str)
            IfCondition EqualTo(rh_cmp, 0) ThenBlock: {
                PrintMessage("[EventRouter] dispatch registered: ")
                PrintString(rh_str)
                PrintMessage("\n")
                CallIndirect(rh_cb, action_ptr, action_len)
                SysDisplayState.dirty = 1
                ReturnValue(1)
            }
            rhi = Add(rhi, 1)
        }

        // win.close
        cmp_close = StringCompare(action_ptr, "win.close")
        IfCondition EqualTo(cmp_close, 0) ThenBlock: {
            PrintMessage("[EventRouter] win.close\n")
            target = source_win





            PrintMessage("[ER_CLOSE] source=")
PrintNumber(source_win)
PrintMessage(" focused=")
PrintNumber(WinMgr.focused)
PrintMessage(" target=")
PrintNumber(target)
PrintMessage("\n")




            IfCondition LessEqual(target, 0) ThenBlock: {
                target = WinMgr.focused
            }
            IfCondition GreaterThan(target, 0) ThenBlock: {
                Win_Close(target)
                SysDisplayState.dirty = 1
            }
            ReturnValue(1)
        }

        // win.min
        cmp_min = StringCompare(action_ptr, "win.min")
        IfCondition EqualTo(cmp_min, 0) ThenBlock: {
            PrintMessage("[EventRouter] win.min\n")
            target = source_win
            IfCondition LessEqual(target, 0) ThenBlock: { target = WinMgr.focused }
            IfCondition GreaterThan(target, 0) ThenBlock: {
                Win_Minimize(target)
            }
            ReturnValue(1)
        }

        // win.max
        cmp_max = StringCompare(action_ptr, "win.max")
        IfCondition EqualTo(cmp_max, 0) ThenBlock: {
            PrintMessage("[EventRouter] win.max\n")
            target = source_win
            IfCondition LessEqual(target, 0) ThenBlock: { target = WinMgr.focused }
            IfCondition GreaterThan(target, 0) ThenBlock: {
                Win_Maximize(target)
            }
            ReturnValue(1)
        }

        // app.files
        cmp_files = StringCompare(action_ptr, "app.files")
        IfCondition EqualTo(cmp_files, 0) ThenBlock: {
            PrintMessage("[EventRouter] app.files\n")
            FileDialog_Open(0, 0, 14)
            SysDisplayState.dirty = 1
            ReturnValue(1)
        }

        // fd.* — file dialog actions (nav, select, back, cancel, ok)
        IfCondition GreaterEqual(action_len, 3) ThenBlock: {
            fd0 = GetByte(action_ptr, 0)
            fd1 = GetByte(action_ptr, 1)
            fd2 = GetByte(action_ptr, 2)
            // "fd." = 102 100 46
            IfCondition And(EqualTo(fd0, 102), And(EqualTo(fd1, 100), EqualTo(fd2, 46))) ThenBlock: {
                fd_handled = FD_HandleAction(action_ptr, action_len)
                IfCondition EqualTo(fd_handled, 1) ThenBlock: {
                    SysDisplayState.dirty = 1
                    ReturnValue(1)
                }
            }
        }

        // wf.N — window focus from deskbar window list
        IfCondition GreaterEqual(action_len, 4) ThenBlock: {
            wf0 = GetByte(action_ptr, 0)
            wf1 = GetByte(action_ptr, 1)
            wf2 = GetByte(action_ptr, 2)
            // "wf." = 119 102 46
            IfCondition And(EqualTo(wf0, 119), And(EqualTo(wf1, 102), EqualTo(wf2, 46))) ThenBlock: {
                wf_digit = Subtract(GetByte(action_ptr, 3), 48)
                IfCondition And(GreaterEqual(wf_digit, 1), LessEqual(wf_digit, 8)) ThenBlock: {
                    PrintMessage("[EventRouter] wf.")
                    PrintNumber(wf_digit)
                    PrintMessage("\n")
                    // Restore if minimized, then focus
                    wf_flags = WinMgr_GetFlags(wf_digit)
                    IfCondition NotEqual(BitwiseAnd(wf_flags, WinFlags.MINIMIZED), 0) ThenBlock: {
                        Win_Restore(wf_digit)
                    } ElseBlock: {
                        Win_Focus(wf_digit)
                    }
                    DeskbarState.needs_refresh = 1
                    SysDisplayState.dirty = 1
                    ReturnValue(1)
                }
            }
        }

        // svc.N — service launch from deskbar
        IfCondition GreaterEqual(action_len, 5) ThenBlock: {
            sv0 = GetByte(action_ptr, 0)
            sv1 = GetByte(action_ptr, 1)
            sv2 = GetByte(action_ptr, 2)
            sv3 = GetByte(action_ptr, 3)
            // "svc." = 115 118 99 46
            IfCondition And(EqualTo(sv0, 115), And(EqualTo(sv1, 118), And(EqualTo(sv2, 99), EqualTo(sv3, 46)))) ThenBlock: {
                // Parse index: 1 or 2 digit number after "svc."
                d0 = Subtract(GetByte(action_ptr, 4), 48)
                svc_idx = d0
                IfCondition GreaterEqual(action_len, 6) ThenBlock: {
                    d1 = Subtract(GetByte(action_ptr, 5), 48)
                    IfCondition And(GreaterEqual(d1, 0), LessEqual(d1, 9)) ThenBlock: {
                        svc_idx = Add(Multiply(d0, 10), d1)
                    }
                }
                IfCondition And(GreaterEqual(svc_idx, 0), LessThan(svc_idx, 16)) ThenBlock: {
                    PrintMessage("[EventRouter] svc.")
                    PrintNumber(svc_idx)
                    PrintMessage("\n")
                    Deskbar_LaunchService(svc_idx)
                    ReturnValue(1)
                }
            }
        }

        // app.home — toggle Start Menu
        cmp_home = StringCompare(action_ptr, "app.home")
        IfCondition EqualTo(cmp_home, 0) ThenBlock: {
            PrintMessage("[EventRouter] app.home\n")
            StartMenu_Toggle()
            SysDisplayState.dirty = 1
            ReturnValue(1)
        }

        // app.quit
        cmp_quit = StringCompare(action_ptr, "app.quit")
        IfCondition EqualTo(cmp_quit, 0) ThenBlock: {
            PrintMessage("[EventRouter] app.quit\n")
            StartMenu_Close()
            Menu_Close()
            SysDisplayState.running = 0
            ReturnValue(1)
        }

        // app.about
        cmp_about = StringCompare(action_ptr, "app.about")
        IfCondition EqualTo(cmp_about, 0) ThenBlock: {
            PrintMessage("[EventRouter] app.about\n")
            AboutDialog_Open()
            SysDisplayState.dirty = 1
            ReturnValue(1)
        }

        // sys.shutdown — power off the system
        cmp_sd = StringCompare(action_ptr, "sys.shutdown")
        IfCondition EqualTo(cmp_sd, 0) ThenBlock: {
            PrintMessage("[EventRouter] sys.shutdown — powering off\n")
            // sync filesystems: syscall 162 = sync
            SystemCall(162, 0, 0, 0, 0, 0)
            // reboot(LINUX_REBOOT_MAGIC1, LINUX_REBOOT_MAGIC2, POWER_OFF, NULL)
            // magic1 = 0xfee1dead = 4276215469
            // magic2 = 0x28121969 = 672274793
            // cmd    = 0x4321fedc = 1126301404  (LINUX_REBOOT_CMD_POWER_OFF)
            SystemCall(169, 4276215469, 672274793, 1126301404, 0, 0)
            ReturnValue(1)
        }

        // sys.reboot — restart the system
        cmp_rb = StringCompare(action_ptr, "sys.reboot")
        IfCondition EqualTo(cmp_rb, 0) ThenBlock: {
            PrintMessage("[EventRouter] sys.reboot — restarting\n")
            // sync filesystems
            SystemCall(162, 0, 0, 0, 0, 0)
            // reboot(LINUX_REBOOT_MAGIC1, LINUX_REBOOT_MAGIC2, RESTART, NULL)
            // cmd = 0x01234567 = 19088743  (LINUX_REBOOT_CMD_RESTART)
            SystemCall(169, 4276215469, 672274793, 19088743, 0, 0)
            ReturnValue(1)
        }

        // sys.screenshot
        cmp_ss = StringCompare(action_ptr, "sys.screenshot")
        IfCondition EqualTo(cmp_ss, 0) ThenBlock: {
            PrintMessage("[EventRouter] sys.screenshot\n")
            Screenshot_SavePPM()
            Screenshot_Save()
            ReturnValue(1)
        }

        // sys.theme.dark — switch to dark theme
        cmp_td = StringCompare(action_ptr, "sys.theme.dark")
        IfCondition EqualTo(cmp_td, 0) ThenBlock: {
            PrintMessage("[EventRouter] sys.theme.dark\n")
            UITheme_SwitchTo(SysDisplayState.db_conn, "dark")
            ReturnValue(1)
        }

        // sys.theme.light — switch to light theme
        cmp_tl = StringCompare(action_ptr, "sys.theme.light")
        IfCondition EqualTo(cmp_tl, 0) ThenBlock: {
            PrintMessage("[EventRouter] sys.theme.light\n")
            UITheme_SwitchTo(SysDisplayState.db_conn, "light")
            ReturnValue(1)
        }

        // sys.settings.apply — reload font/layout settings from DB and re-init
        cmp_sap = StringCompare(action_ptr, "sys.settings.apply")
        IfCondition EqualTo(cmp_sap, 0) ThenBlock: {
            PrintMessage("[EventRouter] sys.settings.apply\n")
            EventRouter_ApplySettings(SysDisplayState.db_conn)
            ReturnValue(1)
        }

        // about.close
        cmp_abcl = StringCompare(action_ptr, "about.close")
        IfCondition EqualTo(cmp_abcl, 0) ThenBlock: {
            PrintMessage("[EventRouter] about.close\n")
            AboutDialog_Close()
            SysDisplayState.dirty = 1
            ReturnValue(1)
        }

        // menu:file / menu:edit / menu:view / menu:help
        // RE-ENABLED for bisect step 3 — Menu_Show now has early-return inside
        cmp_mf = StringCompare(action_ptr, "menu:file")
        IfCondition EqualTo(cmp_mf, 0) ThenBlock: {
            PrintMessage("[EventRouter] menu:file\n")
            Menu_Show(0, source_win)
            ReturnValue(1)
        }
        cmp_me = StringCompare(action_ptr, "menu:edit")
        IfCondition EqualTo(cmp_me, 0) ThenBlock: {
            PrintMessage("[EventRouter] menu:edit\n")
            Menu_Show(1, source_win)
            ReturnValue(1)
        }
        cmp_mv = StringCompare(action_ptr, "menu:view")
        IfCondition EqualTo(cmp_mv, 0) ThenBlock: {
            PrintMessage("[EventRouter] menu:view\n")
            Menu_Show(2, source_win)
            ReturnValue(1)
        }
        cmp_mh = StringCompare(action_ptr, "menu:help")
        IfCondition EqualTo(cmp_mh, 0) ThenBlock: {
            PrintMessage("[EventRouter] menu:help\n")
            Menu_Show(3, source_win)
            ReturnValue(1)
        }

        IfCondition EqualTo(EventRouter_TryEdit(action_ptr, source_win), 1) ThenBlock: {
            ReturnValue(1)
        }

        ReturnValue(0)
    }
}

// Edit menu actions — find the window's textfield and run EditCmd_*.
// kind: 1 copy, 2 paste, 3 cut, 4 select-all
Function.EventRouter_TryEdit {
    Input: action_ptr: Address
    Input: source_win: Integer
    Output: Integer
    Body: {
        kind = 0
        IfCondition EqualTo(StringCompare(action_ptr, "edit.copy"), 0) ThenBlock: { kind = 1 }
        IfCondition EqualTo(StringCompare(action_ptr, "edit.paste"), 0) ThenBlock: { kind = 2 }
        IfCondition EqualTo(StringCompare(action_ptr, "edit.cut"), 0) ThenBlock: { kind = 3 }
        IfCondition EqualTo(StringCompare(action_ptr, "edit.selall"), 0) ThenBlock: { kind = 4 }
        IfCondition EqualTo(kind, 0) ThenBlock: { ReturnValue(0) }
        EventRouter_EditCmd(source_win, kind)
        ReturnValue(1)
    }
}

Function.EventRouter_EditCmd {
    Input: win_idx: Integer
    Input: kind: Integer
    Body: {
        IfCondition LessEqual(win_idx, 0) ThenBlock: {
            win_idx = WinMgr.focused
        }
        IfCondition LessEqual(win_idx, 0) ThenBlock: { ReturnValue(0) }
        ctx = WinView_GetContentCtx(win_idx)
        IfCondition EqualTo(ctx, 0) ThenBlock: { ReturnValue(0) }

        node = AK_GetFocusNode(ctx)
        tag = -1
        IfCondition GreaterEqual(node, 0) ThenBlock: {
            tag = AK_Get(ctx, node, AKF.TAG)
        }
        IfCondition And(NotEqual(tag, AKTag.TEXTFIELD), NotEqual(tag, AKTag.INPUT)) ThenBlock: {
            node = AK_FindTextField(ctx, AK_GetTreeRoot(ctx))
        }
        IfCondition LessThan(node, 0) ThenBlock: { ReturnValue(0) }

        IfCondition EqualTo(kind, 1) ThenBlock: { EditCmd_Copy(ctx, node) }
        IfCondition EqualTo(kind, 2) ThenBlock: { EditCmd_Paste(ctx, node) }
        IfCondition EqualTo(kind, 3) ThenBlock: { EditCmd_Cut(ctx, node) }
        IfCondition EqualTo(kind, 4) ThenBlock: { EditCmd_SelectAll(ctx, node) }

        AK_Set(ctx, node, AKF.DIRTY, 1)
        EventRouter_RedrawContent(win_idx)
        ReturnValue(0)
    }
}

Function.EventRouter_Fmt {
    Input: action_ptr: Address
    Input: source_win: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(action_ptr, 0) ThenBlock: {
            ReturnValue(0)
        }
        DocFmt.act = action_ptr
        win_idx = source_win
        IfCondition LessEqual(win_idx, 0) ThenBlock: {
            win_idx = WinMgr.focused
        }
        IfCondition LessEqual(win_idx, 0) ThenBlock: {
            ReturnValue(0)
        }
        ctx = WinView_GetContentCtx(win_idx)
        IfCondition EqualTo(ctx, 0) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition EqualTo(DocFmt_Apply(ctx, DocFmt.act), 0) ThenBlock: {
            ReturnValue(0)
        }
        EventRouter_RedrawContent(win_idx)
        ReturnValue(1)
    }
}

Function.EventRouter_RedrawContent {
    Input: win_idx: Integer
    Body: {
        ctx = WinView_GetContentCtx(win_idx)
        IfCondition EqualTo(ctx, 0) ThenBlock: { ReturnValue(0) }
        surf = WinMgr_GetContent(win_idx)
        cw = Win_GetCanvasW(win_idx)
        ch = Win_GetCanvasH(win_idx)
        AK_SetDesignW(ctx, cw)
        AK_SetDesignH(ctx, ch)
        AK_Draw(ctx, surf, cw, ch)
        SysDisplayState.dirty = 1
    }
}

Function.EventRouter_Doc {
    Input: action_ptr: Address
    Input: source_win: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(action_ptr, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(StringCompare(action_ptr, "doc.new"), 0) ThenBlock: {
            PrintMessage("[EventRouter] doc.new\n")
            FileDialog_DocNew(source_win)
            ReturnValue(1)
        }
        IfCondition EqualTo(StringCompare(action_ptr, "doc.open"), 0) ThenBlock: {
            PrintMessage("[EventRouter] doc.open\n")
            FileDialog_DocOpen(source_win)
            ReturnValue(1)
        }
        IfCondition EqualTo(StringCompare(action_ptr, "doc.save"), 0) ThenBlock: {
            PrintMessage("[EventRouter] doc.save\n")
            FileDialog_DocSave(source_win)
            ReturnValue(1)
        }
        IfCondition EqualTo(StringCompare(action_ptr, "doc.saveas"), 0) ThenBlock: {
            PrintMessage("[EventRouter] doc.saveas\n")
            FileDialog_DocSaveAs(source_win)
            ReturnValue(1)
        }
        ReturnValue(0)
    }
}

// =============================================================================
// APPLY SETTINGS — read display settings from DB and re-init UI subsystems
//
// Queries: SELECT key, value FROM settings WHERE app_id='display'
// For each row, stores key/value into UIConfig table, then re-runs
// UIScale_Init, PaneDecorator inits, and marks display dirty.
// =============================================================================
Function.EventRouter_ApplySettings {
    Input: conn: Integer
    Body: {
        IfCondition EqualTo(conn, 0) ThenBlock: { ReturnValue(0) }

        qr = PG_Query(conn, "SELECT key, value FROM settings WHERE app_id='display'")
        IfCondition EqualTo(qr, 0) ThenBlock: {
            PrintMessage("[EventRouter] settings.apply: no display settings\n")
            ReturnValue(0)
        }

        rc = Array.Size(qr)
        applied = 0
        i = 0
        WhileLoop LessThan(i, rc) {
            row = Array.Get(qr, i)
            k = Hash.Get(row, "key")
            v = Hash.Get(row, "value")
            IfCondition And(NotEqual(k, 0), NotEqual(v, 0)) ThenBlock: {
                int_val = UIConfig_ParseInt(v)
                UIConfig_Store(k, int_val)
                applied = Add(applied, 1)
            }
            i = Add(i, 1)
        }
        PG_DestroyResult(qr)

        PrintMessage("[EventRouter] settings.apply: stored ")
        PrintNumber(applied)
        PrintMessage(" keys\n")

        // Re-init UI subsystems to pick up new values
        sw = SysDisplayState.scr_w
        sh = SysDisplayState.scr_h
        UIScale_Init(sw, sh)
        PaneDecorator_ScaleInit()
        PaneDecorator_ThemeInit()
        DeskbarState.needs_refresh = 1
        SysDisplayState.dirty = 1

        PrintMessage("[EventRouter] settings.apply: UI re-initialized\n")
    }
}