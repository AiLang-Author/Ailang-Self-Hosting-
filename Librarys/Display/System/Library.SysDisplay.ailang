// =============================================================================
// STATE
// =============================================================================
FixedPool.SysDisplayState {
    "db_conn":      Initialize=0, CanChange=True
    "running":  Initialize=0, CanChange=True
    "scr_w":    Initialize=0, CanChange=True
    "scr_h":    Initialize=0, CanChange=True
    "tty_fd":   Initialize=0, CanChange=True
    "font":     Initialize=0, CanChange=True
    "alt_held": Initialize=0, CanChange=True
    "dirty":    Initialize=0, CanChange=True
    "desktop_surf": Initialize=0, CanChange=True
    "dbg_tr":       Initialize=0, CanChange=True
    "dbg_surf":     Initialize=0, CanChange=True
    "frame_count":  Initialize=0, CanChange=True
    "last_sec":     Initialize=0, CanChange=True
    "last_nsec":    Initialize=0, CanChange=True
    "frame_ms":     Initialize=0, CanChange=True
    "fps":          Initialize=0, CanChange=True
    "fps_accum":    Initialize=0, CanChange=True
    "fps_frames":   Initialize=0, CanChange=True
}

// =============================================================================
// DEBUG LOG — on-screen ring buffer, toggled with F12
// 16 entries, each: 8 bytes frame# + 8 bytes tag_ptr + 8 bytes tag_len = 24 bytes
// =============================================================================
FixedPool.DebugLogConst {
    "MAX_ENTRIES": Initialize=256
    "ENTRY_SIZE":  Initialize=24
    "F_FRAME":     Initialize=0
    "F_TAG_PTR":   Initialize=8
    "F_TAG_LEN":   Initialize=16
}

FixedPool.DebugLog {
    "data":    Initialize=0, CanChange=True
    "head":    Initialize=0, CanChange=True
    "count":   Initialize=0, CanChange=True
    "enabled": Initialize=0, CanChange=True
}

FixedPool.WinDefaults {
    "w": Initialize=0
    "h": Initialize=0
}


FixedPool.DefaultToolbar {
    "markup": Initialize=0
    "len":    Initialize=0
}

// =============================================================================
// INIT
// =============================================================================


Function.SysDisplay_InitFB {
    Output: Integer
    Body: {
        DebugLog_Push("sd.inFB", 7)
        ok = RenderFB_InitDouble()
        IfCondition EqualTo(ok, 0) ThenBlock: {
            PrintMessage("[FAIL] FB\n")
            ReturnValue(0)
        }
        w = FB_GetWidth()
        h = FB_GetHeight()
        SysDisplayState.scr_w  = w
        SysDisplayState.scr_h  = h
        // Load UI config and compute scale factor
        UIConfig_Load("/system/config/ui.cfg")
        UITheme_Init()
        UIScale_Init(w, h)
        PaneDecorator_ScaleInit()
        PaneDecorator_ThemeInit()
        // Canvas = 80% screen minus border on each side
        // Box = canvas + bw*2 — no header inside
        bw = UIScale.border_w
        WinDefaults.w = Subtract(Divide(Multiply(w, 80), 100), Multiply(bw, 2))
        WinDefaults.h = Subtract(Divide(Multiply(h, 80), 100), Multiply(bw, 2))
        PrintMessage("[FB] ")
        PrintNumber(w)
        PrintMessage("x")
        PrintNumber(h)
        PrintMessage("\n")
        ReturnValue(1)
    }
}


// =============================================================================
// DATABASE INIT — connect to PostgreSQL, bootstrap system schema
// =============================================================================
Function.SysDisplay_InitDB {
    Output: Integer
    Body: {
        DebugLog_Push("sd.inDB", 7)
        PrintMessage("[DB] Connecting to PostgreSQL...\n")

        conn = PG_Connect("127.0.0.1", 5432, "ailang_system", "bob", "")
        IfCondition EqualTo(conn, 0) ThenBlock: {
            PrintMessage("[DB] FAIL: cannot connect\n")
            PrintMessage("[DB] Display server running without database\n")
            ReturnValue(0)
        }

        SysDisplayState.db_conn = conn
        PrintMessage("[DB] Connected\n")

        // ----- Bootstrap schema (idempotent — IF NOT EXISTS) -----

        // --- services table ---
        r = PG_Query(conn, "CREATE TABLE IF NOT EXISTS services (id SERIAL PRIMARY KEY, name TEXT NOT NULL UNIQUE)")
        IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }

        // ALTER TABLE ADD COLUMN IF NOT EXISTS keeps us under 255 chars
        // and is safe to re-run on every boot
        r = PG_Query(conn, "ALTER TABLE services ADD COLUMN IF NOT EXISTS binary_path TEXT")
        IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }

        r = PG_Query(conn, "ALTER TABLE services ADD COLUMN IF NOT EXISTS args TEXT")
        IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }

        r = PG_Query(conn, "ALTER TABLE services ADD COLUMN IF NOT EXISTS autostart BOOLEAN DEFAULT false")
        IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }

        r = PG_Query(conn, "ALTER TABLE services ADD COLUMN IF NOT EXISTS restart_policy TEXT DEFAULT 'never'")
        IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }

        r = PG_Query(conn, "ALTER TABLE services ADD COLUMN IF NOT EXISTS depends_on TEXT")
        IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }

        r = PG_Query(conn, "ALTER TABLE services ADD COLUMN IF NOT EXISTS run_as TEXT DEFAULT 'nobody'")
        IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }

        r = PG_Query(conn, "ALTER TABLE services ADD COLUMN IF NOT EXISTS priority INTEGER DEFAULT 50")
        IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }

        r = PG_Query(conn, "ALTER TABLE services ADD COLUMN IF NOT EXISTS enabled BOOLEAN DEFAULT true")
        IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }

        r = PG_Query(conn, "ALTER TABLE services ADD COLUMN IF NOT EXISTS encryption_key_id INTEGER")
        IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }

        r = PG_Query(conn, "ALTER TABLE services ADD COLUMN IF NOT EXISTS display_name TEXT")
        IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }

        PrintMessage("[DB] services table ready\n")

        // Seed default deskbar services (ON CONFLICT DO UPDATE — always fix paths on boot)
        r = PG_Query(conn, "INSERT INTO services (name, display_name, binary_path, enabled, priority) VALUES ('notepad', 'Notepad', '/system/bin/notepad.x', true, 10) ON CONFLICT (name) DO UPDATE SET display_name='Notepad', binary_path='/system/bin/notepad.x'")
        IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }

        r = PG_Query(conn, "INSERT INTO services (name, display_name, binary_path, enabled, priority) VALUES ('files', 'Files', 'internal:app.files', true, 20) ON CONFLICT (name) DO NOTHING")
        IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }

        r = PG_Query(conn, "INSERT INTO services (name, display_name, binary_path, enabled, priority) VALUES ('calculator', 'Calc', '/system/bin/calc.x', true, 15) ON CONFLICT (name) DO UPDATE SET binary_path='/system/bin/calc.x'")
        IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }

        r = PG_Query(conn, "INSERT INTO services (name, display_name, binary_path, enabled, priority) VALUES ('terminal', 'Terminal', '/system/bin/terminal.x', true, 12) ON CONFLICT (name) DO UPDATE SET display_name='Terminal', binary_path='/system/bin/terminal.x'")
        IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }

        r = PG_Query(conn, "INSERT INTO services (name, display_name, binary_path, enabled, priority) VALUES ('grep', 'Grep', '/system/bin/grep.x', true, 25) ON CONFLICT (name) DO UPDATE SET binary_path='/system/bin/grep.x'")
        IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }

        r = PG_Query(conn, "INSERT INTO services (name, display_name, binary_path, enabled, priority) VALUES ('chrome', 'Chrome', '/system/bin/chrome.x', true, 40) ON CONFLICT (name) DO UPDATE SET binary_path='/system/bin/chrome.x'")
        IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }

        r = PG_Query(conn, "INSERT INTO services (name, display_name, binary_path, enabled, priority) VALUES ('browser', 'Browser', '/system/bin/browser.x', true, 42) ON CONFLICT (name) DO UPDATE SET binary_path='/system/bin/browser.x'")
        IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }

        r = PG_Query(conn, "INSERT INTO services (name, display_name, binary_path, enabled, priority) VALUES ('claude', 'Claude', '/system/bin/claude.x', true, 45) ON CONFLICT (name) DO UPDATE SET binary_path='/system/bin/claude.x'")
        IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }

        r = PG_Query(conn, "INSERT INTO services (name, display_name, binary_path, enabled, priority) VALUES ('vscode', 'Code', '/system/bin/vscode.x', true, 48) ON CONFLICT (name) DO UPDATE SET binary_path='/system/bin/vscode.x'")
        IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }

        r = PG_Query(conn, "INSERT INTO services (name, display_name, binary_path, enabled, priority) VALUES ('ladybird', 'Ladybird', '/system/bin/ladybird.x', true, 50) ON CONFLICT (name) DO UPDATE SET binary_path='/system/bin/ladybird.x'")
        IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }

        PrintMessage("[DB] default services seeded\n")

        // --- files table ---
        r = PG_Query(conn, "CREATE TABLE IF NOT EXISTS files (id SERIAL PRIMARY KEY, parent_id INTEGER, name TEXT NOT NULL)")
        IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }

        r = PG_Query(conn, "ALTER TABLE files ADD COLUMN IF NOT EXISTS type TEXT DEFAULT 'file'")
        IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }

        r = PG_Query(conn, "ALTER TABLE files ADD COLUMN IF NOT EXISTS blob_path TEXT")
        IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }

        r = PG_Query(conn, "ALTER TABLE files ADD COLUMN IF NOT EXISTS permissions TEXT DEFAULT 'rw-r--r--'")
        IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }

        r = PG_Query(conn, "ALTER TABLE files ADD COLUMN IF NOT EXISTS owner TEXT DEFAULT 'bob'")
        IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }

        r = PG_Query(conn, "ALTER TABLE files ADD COLUMN IF NOT EXISTS size INTEGER DEFAULT 0")
        IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }

        r = PG_Query(conn, "ALTER TABLE files ADD COLUMN IF NOT EXISTS created TIMESTAMP DEFAULT NOW()")
        IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }

        r = PG_Query(conn, "ALTER TABLE files ADD COLUMN IF NOT EXISTS modified TIMESTAMP DEFAULT NOW()")
        IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }

        PrintMessage("[DB] files table ready\n")

        // --- settings table (PK inline — fully idempotent, no 2nd-boot error) ---
        r = PG_Query(conn, "CREATE TABLE IF NOT EXISTS settings (app_id TEXT, key TEXT, value TEXT, PRIMARY KEY (app_id, key))")
        IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }

        PrintMessage("[DB] settings table ready\n")

        // --- users table ---
        r = PG_Query(conn, "CREATE TABLE IF NOT EXISTS users (id SERIAL PRIMARY KEY, username TEXT NOT NULL UNIQUE)")
        IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }

        r = PG_Query(conn, "ALTER TABLE users ADD COLUMN IF NOT EXISTS password_hash TEXT")
        IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }

        r = PG_Query(conn, "ALTER TABLE users ADD COLUMN IF NOT EXISTS role TEXT DEFAULT 'user'")
        IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }

        r = PG_Query(conn, "ALTER TABLE users ADD COLUMN IF NOT EXISTS created TIMESTAMP DEFAULT NOW()")
        IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }

        PrintMessage("[DB] users table ready\n")

        // --- windows table (window state persistence) ---
        r = PG_Query(conn, "CREATE TABLE IF NOT EXISTS windows (id SERIAL PRIMARY KEY, service_id INTEGER)")
        IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }

        r = PG_Query(conn, "ALTER TABLE windows ADD COLUMN IF NOT EXISTS title TEXT")
        IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }

        r = PG_Query(conn, "ALTER TABLE windows ADD COLUMN IF NOT EXISTS x INTEGER DEFAULT 0")
        IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }

        r = PG_Query(conn, "ALTER TABLE windows ADD COLUMN IF NOT EXISTS y INTEGER DEFAULT 0")
        IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }

        r = PG_Query(conn, "ALTER TABLE windows ADD COLUMN IF NOT EXISTS w INTEGER DEFAULT 640")
        IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }

        r = PG_Query(conn, "ALTER TABLE windows ADD COLUMN IF NOT EXISTS h INTEGER DEFAULT 480")
        IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }

        r = PG_Query(conn, "ALTER TABLE windows ADD COLUMN IF NOT EXISTS toolbar_type TEXT DEFAULT 'default'")
        IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }

        PrintMessage("[DB] windows table ready\n")

        // --- encryption_keys table ---
        r = PG_Query(conn, "CREATE TABLE IF NOT EXISTS encryption_keys (id SERIAL PRIMARY KEY, service_id INTEGER)")
        IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }

        r = PG_Query(conn, "ALTER TABLE encryption_keys ADD COLUMN IF NOT EXISTS key_data TEXT")
        IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }

        r = PG_Query(conn, "ALTER TABLE encryption_keys ADD COLUMN IF NOT EXISTS created TIMESTAMP DEFAULT NOW()")
        IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }

        r = PG_Query(conn, "ALTER TABLE encryption_keys ADD COLUMN IF NOT EXISTS expires TIMESTAMP")
        IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }

        PrintMessage("[DB] encryption_keys table ready\n")

        // --- service_status table (runtime state) ---
        r = PG_Query(conn, "CREATE TABLE IF NOT EXISTS service_status (service_id INTEGER PRIMARY KEY)")
        IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }

        r = PG_Query(conn, "ALTER TABLE service_status ADD COLUMN IF NOT EXISTS pid INTEGER")
        IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }

        r = PG_Query(conn, "ALTER TABLE service_status ADD COLUMN IF NOT EXISTS state TEXT DEFAULT 'stopped'")
        IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }

        r = PG_Query(conn, "ALTER TABLE service_status ADD COLUMN IF NOT EXISTS started_at TIMESTAMP")
        IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }

        r = PG_Query(conn, "ALTER TABLE service_status ADD COLUMN IF NOT EXISTS last_heartbeat TIMESTAMP")
        IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }

        PrintMessage("[DB] service_status table ready\n")

        // ----- Seed root filesystem if empty -----
        r = PG_Query(conn, "SELECT COUNT(*) AS cnt FROM files")
        IfCondition NotEqual(r, 0) ThenBlock: {
            row = Array.Get(r, 0)
            cv = Hash.Get(row, "cnt")
            is_empty = 0
            IfCondition NotEqual(cv, 0) ThenBlock: {
                cmp = StringCompare(cv, "0")
                IfCondition EqualTo(cmp, 0) ThenBlock: {
                    is_empty = 1
                }
            }
            PG_DestroyResult(r)

            IfCondition EqualTo(is_empty, 1) ThenBlock: {
                PrintMessage("[DB] Seeding root filesystem...\n")

                r = PG_Query(conn, "INSERT INTO files (parent_id, name, type) VALUES (NULL, '/', 'dir')")
                IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }

                r = PG_Query(conn, "INSERT INTO files (parent_id, name, type) VALUES (1, 'home', 'dir')")
                IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }

                r = PG_Query(conn, "INSERT INTO files (parent_id, name, type) VALUES (2, 'bob', 'dir')")
                IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }

                r = PG_Query(conn, "INSERT INTO files (parent_id, name, type) VALUES (1, 'etc', 'dir')")
                IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }

                r = PG_Query(conn, "INSERT INTO files (parent_id, name, type) VALUES (1, 'var', 'dir')")
                IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }

                r = PG_Query(conn, "INSERT INTO files (parent_id, name, type) VALUES (1, 'tmp', 'dir')")
                IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }

                PrintMessage("[DB] Root filesystem seeded\n")
            }
        }

        // ----- Seed default settings if empty -----
        r = PG_Query(conn, "SELECT COUNT(*) AS cnt FROM settings")
        IfCondition NotEqual(r, 0) ThenBlock: {
            row = Array.Get(r, 0)
            cv = Hash.Get(row, "cnt")
            is_empty = 0
            IfCondition NotEqual(cv, 0) ThenBlock: {
                cmp = StringCompare(cv, "0")
                IfCondition EqualTo(cmp, 0) ThenBlock: {
                    is_empty = 1
                }
            }
            PG_DestroyResult(r)

            IfCondition EqualTo(is_empty, 1) ThenBlock: {
                PrintMessage("[DB] Seeding default settings...\n")

                r = PG_Query(conn, "INSERT INTO settings VALUES ('system', 'theme', 'dark')")
                IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }

                r = PG_Query(conn, "INSERT INTO settings VALUES ('system', 'font_size', '16')")
                IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }

                r = PG_Query(conn, "INSERT INTO settings VALUES ('system', 'font_name', 'DejaVuSans')")
                IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }

                r = PG_Query(conn, "INSERT INTO settings VALUES ('system', 'cursor', 'bitmap')")
                IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }

                PrintMessage("[DB] Default settings seeded\n")
            }
        }

        PrintMessage("[DB] Schema bootstrap complete\n")
        ReturnValue(1)
    }
}

// =============================================================================
// DATABASE SHUTDOWN — disconnect cleanly
// =============================================================================
Function.SysDisplay_ShutdownDB {
    Body: {
        DebugLog_Push("sd.sdDB", 7)
        conn = SysDisplayState.db_conn
        IfCondition NotEqual(conn, 0) ThenBlock: {
            PrintMessage("[DB] Disconnecting...\n")
            PG_Disconnect(conn)
            SysDisplayState.db_conn = 0
            PrintMessage("[DB] Disconnected\n")
        }
    }
}


Function.SysDisplay_InitTTY {
    Output: Integer
    Body: {
        DebugLog_Push("sd.iTTY", 7)
        tty0_fd = SystemCall(2, "/dev/tty0", 2, 0)
        IfCondition LessThan(tty0_fd, 0) ThenBlock: {
            PrintMessage("[TTY] no tty0\n")
            ReturnValue(0)
        }
        vt_buf = Allocate(8)
        SystemCall(16, tty0_fd, 0x5603, vt_buf)
        vt_num = GetByte(vt_buf, 0)
        SystemCall(3, tty0_fd, 0, 0)
        Deallocate(vt_buf, 8)
        tty_path = StringConcat("/dev/tty", NumberToString(vt_num))
        tty_fd   = SystemCall(2, tty_path, 2, 0)
        IfCondition LessThan(tty_fd, 0) ThenBlock: {
            PrintMessage("[TTY] open failed\n")
            ReturnValue(0)
        }
        SystemCall(16, tty_fd, 19258, 1)
        SysDisplayState.tty_fd = tty_fd
        PrintMessage("[TTY] VT=")
        PrintNumber(vt_num)
        PrintMessage("\n")
        ReturnValue(1)
    }
}


Function.SysDisplay_InitFont {
    Output: Integer
    Body: {
        DebugLog_Push("sd.iFnt", 7)
        PrintMessage("[Font] vector init\n")
        ReturnValue(1)
    }
}


Function.SysDisplay_InitCursor {
    Output: Integer
    Body: {
        DebugLog_Push("sd.iCur", 7)
        CursorConfig.type      = CursorType.BITMAP
        CursorConfig.shape     = CursorShape.ARROW
        CursorConfig.hotspot_x = 0
        CursorConfig.hotspot_y = 0
        ok = Cursor_Init(SysDisplayState.scr_w, SysDisplayState.scr_h)
        IfCondition EqualTo(ok, 0) ThenBlock: {
            PrintMessage("[FAIL] Cursor\n")
            ReturnValue(0)
        }
        ReturnValue(1)
    }
}

Function.SysDisplay_InitInput {
    Output: Integer
    Body: {
        DebugLog_Push("sd.iInp", 7)
        Ring1_Init()
        Evdev_SetMouseBounds(
            Subtract(SysDisplayState.scr_w, 1),
            Subtract(SysDisplayState.scr_h, 1))
        opened = Discover_OpenAll()
        IfCondition EqualTo(opened, 0) ThenBlock: {
            PrintMessage("[FAIL] input\n")
            ReturnValue(0)
        }
        ReturnValue(1)
    }
}

// =============================================================================
// SHUTDOWN
// =============================================================================
Function.SysDisplay_RestoreTTY {
    Output: Integer
    Body: {
        DebugLog_Push("sd.rTTY", 7)
        tty_fd = SysDisplayState.tty_fd
        IfCondition GreaterEqual(tty_fd, 0) ThenBlock: {
            SystemCall(16, tty_fd, 19258, 0)
            SystemCall(3,  tty_fd, 0, 0)
        }
        ReturnValue(1)
    }
}

Function.SysDisplay_Shutdown {
    Output: Integer
    Body: {
        DebugLog_Push("sd.shut", 7)
        PrintMessage("[SysDisplay] shutting down...\n")

        // Close any open overlays (frees surfaces + AK contexts)
        CascadeMenu_Close()
        Menu_Close()

        // Deskbar cleanup
        IfCondition NotEqual(DeskbarState.ak_ctx, 0) ThenBlock: {
            AK_DestroyContext(DeskbarState.ak_ctx)
            DeskbarState.ak_ctx = 0
        }
        IfCondition NotEqual(DeskbarState.surface, 0) ThenBlock: {
            Surface_Destroy(DeskbarState.surface)
            DeskbarState.surface = 0
        }

        // Close all windows (frees surfaces, toolbar contexts, etc.)
        // Walk backwards — slots may be sparse, so check Win_IsActive
        wi = Subtract(FloatTable.count, 1)
        WhileLoop GreaterThan(wi, 0) {
            IfCondition EqualTo(Win_IsActive(wi), 1) ThenBlock: {
                Win_Close(wi)
            }
            wi = Subtract(wi, 1)
        }

        // Free EventRouter queue
        IfCondition NotEqual(ActionQueue.data, 0) ThenBlock: {
            esz = Multiply(ActionQueueConst.MAX, ActionQueueConst.ENTRY_SIZE)
            Deallocate(ActionQueue.data, esz)
            ActionQueue.data = 0
            ActionQueue.count = 0
        }

        // Free DebugLog buffer
        IfCondition NotEqual(DebugLog.data, 0) ThenBlock: {
            dsz = Multiply(DebugLogConst.MAX_ENTRIES, DebugLogConst.ENTRY_SIZE)
            Deallocate(DebugLog.data, dsz)
            DebugLog.data = 0
            DebugLog.count = 0
        }

        // Free debug overlay surface + TR
        dbg_tr = SysDisplayState.dbg_tr
        IfCondition GreaterEqual(dbg_tr, 0) ThenBlock: {
            TextRegion_Free(dbg_tr)
            SysDisplayState.dbg_tr = 0
        }
        dbg_s = SysDisplayState.dbg_surf
        IfCondition NotEqual(dbg_s, 0) ThenBlock: {
            Surface_Destroy(dbg_s)
            SysDisplayState.dbg_surf = 0
        }

        // Free desktop surface
        d_surf = SysDisplayState.desktop_surf
        IfCondition NotEqual(d_surf, 0) ThenBlock: {
            Surface_Destroy(d_surf)
            SysDisplayState.desktop_surf = 0
        }

        // Close Start Menu if open
        StartMenu_Close()

        // Shutdown IPC broker — close all client fds, unlink socket
        IPCBroker_Shutdown()

        // Hardware / system teardown
        Evdev_CloseAll()
        Cursor_Shutdown()
        SysDisplay_ShutdownDB()
        Compose_Shutdown()
        RenderFB_Shutdown()
        SysDisplay_RestoreTTY()
        PrintMessage("[SysDisplay] done\n")
        ReturnValue(1)
    }
}

// =============================================================================
// GETTER — cross-module access to db_conn
// =============================================================================
Function.SysDisplay_GetDBConn {
    Output: Integer
    Body: {
        DebugLog_Push("sd.gDBC", 7)
        ReturnValue(SysDisplayState.db_conn)
    }
}

// =============================================================================
// DEBUG LOG — ring buffer + on-screen overlay
// =============================================================================
Function.DebugLog_Init {
    Output: Integer
    Body: {
        DebugLog_Push("dlog.ini", 8)
        sz = Multiply(DebugLogConst.MAX_ENTRIES, DebugLogConst.ENTRY_SIZE)
        buf = Allocate(sz)
        IfCondition EqualTo(buf, 0) ThenBlock: {
            PrintMessage("[DebugLog] alloc fail\n")
            ReturnValue(0)
        }
        i = 0
        WhileLoop LessThan(i, sz) {
            SetByte(buf, i, 0)
            i = Add(i, 1)
        }
        DebugLog.data = buf
        DebugLog.head = 0
        DebugLog.count = 0
        DebugLog.enabled = 0
        PrintMessage("[DebugLog] initialized\n")
        ReturnValue(1)
    }
}

Function.DebugLog_Push {
    Input: tag: Address
    Input: len: Integer
    Body: {
        IfCondition EqualTo(DebugLog.enabled, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(DebugLog.data, 0) ThenBlock: { ReturnValue(0) }

        // Write at next slot (circular)
        slot = Modulo(Add(DebugLog.head, DebugLog.count), DebugLogConst.MAX_ENTRIES)
        IfCondition GreaterEqual(DebugLog.count, DebugLogConst.MAX_ENTRIES) ThenBlock: {
            // Full — overwrite oldest, advance head
            slot = DebugLog.head
            DebugLog.head = Modulo(Add(DebugLog.head, 1), DebugLogConst.MAX_ENTRIES)
        } ElseBlock: {
            DebugLog.count = Add(DebugLog.count, 1)
        }

        base = Add(DebugLog.data, Multiply(slot, DebugLogConst.ENTRY_SIZE))
        StoreValue(Add(base, DebugLogConst.F_FRAME), SysDisplayState.frame_count)
        StoreValue(Add(base, DebugLogConst.F_TAG_PTR), tag)
        StoreValue(Add(base, DebugLogConst.F_TAG_LEN), len)
    }
}

Function.DebugLog_Toggle {
    Body: {
        DebugLog_Push("dlog.tog", 8)
        IfCondition EqualTo(DebugLog.enabled, 0) ThenBlock: {
            DebugLog.enabled = 1
            PrintMessage("[DebugLog] ON\n")
        } ElseBlock: {
            DebugLog.enabled = 0
            PrintMessage("[DebugLog] OFF\n")
            // Free TR handle so it doesn't leak pool slots
            old_tr = SysDisplayState.dbg_tr
            IfCondition GreaterThan(old_tr, 0) ThenBlock: {
                TextRegion_Free(old_tr)
            }
            SysDisplayState.dbg_tr = 0
            // Free debug surface
            old_ds = SysDisplayState.dbg_surf
            IfCondition NotEqual(old_ds, 0) ThenBlock: {
                Surface_Destroy(old_ds)
            }
            SysDisplayState.dbg_surf = 0
        }
        SysDisplayState.dirty = 1
    }
}

Function.DebugLog_Render {
    Body: {
        DebugLog_Push("dlog.ren", 8)
        IfCondition EqualTo(DebugLog.enabled, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(DebugLog.data, 0) ThenBlock: { ReturnValue(0) }

        // Create dedicated debug surface on first call (700x400)
        ds = SysDisplayState.dbg_surf
        IfCondition EqualTo(ds, 0) ThenBlock: {
            ds = Surface_Create(SurfaceFormat.PIXEL_32, 700, 400)
            SysDisplayState.dbg_surf = ds
        }
        IfCondition EqualTo(ds, 0) ThenBlock: { ReturnValue(0) }

        // Fill debug surface with background color
        Draw_Pix_FillRect(ds, 0, 0, 700, 400, Theme.debug_bg)

        // Set font to debug size for compact overlay
        VFont_UseSize(UIScale.font_debug)

        // Create TextRegion once, reuse after (coordinates relative to debug surface)
        dbg_tr = SysDisplayState.dbg_tr
        IfCondition EqualTo(dbg_tr, 0) ThenBlock: {
            dbg_tr = TextRegion_Create(ds, 4, 4, 690, 390)
            TextRegion_SetColor(dbg_tr, TVG_PackColor(255, 255, 80, 255))
            TextRegion_SetWrap(dbg_tr, 0)
            SysDisplayState.dbg_tr = dbg_tr
        }

        // Reset cursor to origin each frame (surface-relative)
        trp = TR_Ptr(dbg_tr)
        StoreValue(Add(trp, TRConst.CURSOR_X_OFS), 4)
        StoreValue(Add(trp, TRConst.CURSOR_Y_OFS), 4)

        // Build entire log text into a flat buffer with newlines
        // Max: header(24) + 16 entries * ~40 chars + stats line = ~800 bytes
        buf = Allocate(1024)
        pos = 0

        // Header: "=== DEBUG LOG (F12) ===\n"
        hdr = "=== DEBUG LOG (F12) ==="
        hi = 0
        WhileLoop LessThan(hi, 23) {
            SetByte(buf, pos, GetByte(hdr, hi))
            pos = Add(pos, 1)
            hi = Add(hi, 1)
        }
        SetByte(buf, pos, 10)
        pos = Add(pos, 1)

        // Stats line 1: "FPS: <N>  Frame: <N>ms\n"
        fp = "FPS: "
        fpi = 0
        WhileLoop LessThan(fpi, 5) {
            SetByte(buf, pos, GetByte(fp, fpi))
            pos = Add(pos, 1)
            fpi = Add(fpi, 1)
        }
        fpstr = NumberToString(SysDisplayState.fps)
        fplen = StringLength(fpstr)
        fpi = 0
        WhileLoop LessThan(fpi, fplen) {
            SetByte(buf, pos, GetByte(fpstr, fpi))
            pos = Add(pos, 1)
            fpi = Add(fpi, 1)
        }
        fm = "  Frame: "
        fmi = 0
        WhileLoop LessThan(fmi, 9) {
            SetByte(buf, pos, GetByte(fm, fmi))
            pos = Add(pos, 1)
            fmi = Add(fmi, 1)
        }
        fmstr = NumberToString(SysDisplayState.frame_ms)
        fmlen = StringLength(fmstr)
        fmi = 0
        WhileLoop LessThan(fmi, fmlen) {
            SetByte(buf, pos, GetByte(fmstr, fmi))
            pos = Add(pos, 1)
            fmi = Add(fmi, 1)
        }
        ms = "ms"
        SetByte(buf, pos, GetByte(ms, 0))
        pos = Add(pos, 1)
        SetByte(buf, pos, GetByte(ms, 1))
        pos = Add(pos, 1)
        SetByte(buf, pos, 10)
        pos = Add(pos, 1)

        // Stats line 2: "Win: <N>  #<frame_count>\n"
        wh = "Win: "
        whi = 0
        WhileLoop LessThan(whi, 5) {
            SetByte(buf, pos, GetByte(wh, whi))
            pos = Add(pos, 1)
            whi = Add(whi, 1)
        }
        wcstr = NumberToString(FloatTable.count)
        wclen = StringLength(wcstr)
        wci = 0
        WhileLoop LessThan(wci, wclen) {
            SetByte(buf, pos, GetByte(wcstr, wci))
            pos = Add(pos, 1)
            wci = Add(wci, 1)
        }
        fc = "  #"
        fci = 0
        WhileLoop LessThan(fci, 3) {
            SetByte(buf, pos, GetByte(fc, fci))
            pos = Add(pos, 1)
            fci = Add(fci, 1)
        }
        fcstr = NumberToString(SysDisplayState.frame_count)
        fclen = StringLength(fcstr)
        fci = 0
        WhileLoop LessThan(fci, fclen) {
            SetByte(buf, pos, GetByte(fcstr, fci))
            pos = Add(pos, 1)
            fci = Add(fci, 1)
        }
        SetByte(buf, pos, 10)
        pos = Add(pos, 1)

        // Separator
        sep = "---\n"
        si = 0
        WhileLoop LessThan(si, 4) {
            SetByte(buf, pos, GetByte(sep, si))
            pos = Add(pos, 1)
            si = Add(si, 1)
        }

        // Walk ring buffer oldest to newest
        ri = 0
        WhileLoop LessThan(ri, DebugLog.count) {
            idx = Modulo(Add(DebugLog.head, ri), DebugLogConst.MAX_ENTRIES)
            base = Add(DebugLog.data, Multiply(idx, DebugLogConst.ENTRY_SIZE))
            frame = Dereference(Add(base, DebugLogConst.F_FRAME))
            tptr  = Dereference(Add(base, DebugLogConst.F_TAG_PTR))
            tlen  = Dereference(Add(base, DebugLogConst.F_TAG_LEN))

            // "F"
            SetByte(buf, pos, 70)
            pos = Add(pos, 1)

            // Frame number digits
            fstr = NumberToString(frame)
            flen = StringLength(fstr)
            fi = 0
            WhileLoop LessThan(fi, flen) {
                SetByte(buf, pos, GetByte(fstr, fi))
                pos = Add(pos, 1)
                fi = Add(fi, 1)
            }

            // ": "
            SetByte(buf, pos, 58)
            pos = Add(pos, 1)
            SetByte(buf, pos, 32)
            pos = Add(pos, 1)

            // Tag bytes
            IfCondition And(NotEqual(tptr, 0), GreaterThan(tlen, 0)) ThenBlock: {
                ti = 0
                WhileLoop LessThan(ti, tlen) {
                    SetByte(buf, pos, GetByte(tptr, ti))
                    pos = Add(pos, 1)
                    ti = Add(ti, 1)
                }
            }

            // Newline
            SetByte(buf, pos, 10)
            pos = Add(pos, 1)

            ri = Add(ri, 1)
        }

        // Null terminate
        SetByte(buf, pos, 0)

        // Render all text in one call
        TextRegion_Render(dbg_tr, buf, pos)

        Deallocate(buf, 1024)

        // Restore main font size
        VFont_UseSize(UIScale.font_body)
        SysDisplayState.dirty = 1
    }
}





// =============================================================================
// INPUT DRAIN — reads Ring1, routes to focused window
// Returns 1 = quit
// =============================================================================


Function.SysDisplay_DrainInput {
    Output: Integer
    Body: {
        DebugLog_Push("sd.drin", 7)
        entry = Allocate(RingEntry.SIZE)
        quit  = 0

        WhileLoop EqualTo(Ring1_IsEmpty(), 0) {
            Ring1_Drain(entry)
            ev   = Dereference(Add(entry, RingEntry.TYPE))
            pa   = Dereference(Add(entry, RingEntry.PARAM_A))
            pb   = Dereference(Add(entry, RingEntry.PARAM_B))
            data = Dereference(Add(entry, RingEntry.PARAM_C))

            // KEY DOWN
            IfCondition EqualTo(ev, Ring1Event.KEY_DOWN) ThenBlock: {
                PrintMessage("[KEY] sc=")
                PrintNumber(pa)
                PrintMessage("\n")
                // Alt tracking
                IfCondition EqualTo(pa, 56)  ThenBlock: { SysDisplayState.alt_held = 1 }
                IfCondition EqualTo(pa, 100) ThenBlock: { SysDisplayState.alt_held = 1 }
                // ESC = quit
                IfCondition EqualTo(pa, Key.ESC) ThenBlock: { quit = 1 }
                // F12 = toggle debug overlay (scancode 88)
                IfCondition EqualTo(pa, 88) ThenBlock: { DebugLog_Toggle() }
                // Caps Lock toggle (scancode 58)
                IfCondition EqualTo(pa, 58) ThenBlock: { KeyMap_ToggleCaps() }

                IfCondition EqualTo(SysDisplayState.alt_held, 1) ThenBlock: {
                    // Alt+V — create new window
                    IfCondition EqualTo(pa, 47) ThenBlock: {
                        PrintMessage("[Key] Alt+V — new window\n")
                        fb_w   = FB_GetWidth()
                        fb_h   = FB_GetHeight()
                        new_cw = Subtract(Divide(Multiply(fb_w, 80), 100), Multiply(DecorConfig.border_w, 2))
                        new_ch = Subtract(Divide(Multiply(fb_h, 80), 100), Multiply(DecorConfig.border_w, 2))
                        idx = Win_Create(new_cw, new_ch, WinColor.WINDOW, "Application")
                        SysDisplayState.dirty = 1
                    }
                    // Alt+Q — close focused window
                    IfCondition EqualTo(pa, 16) ThenBlock: {
                        PrintMessage("[Key] Alt+Q — close window\n")
                        closed = Win_Close(WinMgr.focused)
                        IfCondition EqualTo(closed, 1) ThenBlock: {
                            SysDisplayState.dirty = 1
                        }
                    }
                } ElseBlock: {
                    // Regular key — route to focused window
                    IfCondition NotEqual(pa, Key.ESC) ThenBlock: {
                        consumed = Win_KeyDown(pa, KeyMod.shift)
                        IfCondition EqualTo(consumed, 1) ThenBlock: {
                            SysDisplayState.dirty = 1
                        }
                    }
                }
            }

            // KEY UP
            IfCondition EqualTo(ev, Ring1Event.KEY_UP) ThenBlock: {
                IfCondition EqualTo(pa, 56)  ThenBlock: { SysDisplayState.alt_held = 0 }
                IfCondition EqualTo(pa, 100) ThenBlock: { SysDisplayState.alt_held = 0 }
            }

            // MOUSE MOVE
            IfCondition EqualTo(ev, Ring1Event.MOUSE_MOVE) ThenBlock: {
                DebugLog_Push("MV", 2)
                Cursor_SetPos(pa, pb)
                // Default: show cursor. Win_ContentEvent sets hidden=1 if over IPC canvas.
                CursorState.hidden = 0
                IfCondition GreaterEqual(WinInputState.drag_idx, 0) ThenBlock: {
                    Win_UpdateDrag(pa, pb)
                }
                IfCondition GreaterEqual(WinInputState.resize_idx, 0) ThenBlock: {
                    Win_UpdateResize(pa, pb)
                }
                // Update cursor shape based on border proximity
                border_hit = Win_BorderHitTest(pa, pb)
                IfCondition GreaterEqual(border_hit, 0) ThenBlock: {
                    Cursor_SetShape(CursorShape.CROSSHAIR)
                } ElseBlock: {
                    Cursor_SetShape(CursorShape.ARROW)
                }
                SysDisplayState.dirty = 1

                 // Deskbar show/hide check
                in_deskbar = Deskbar_MouseCheck(pa, pb)
                IfCondition EqualTo(in_deskbar, 1) ThenBlock: {
                    DebugLog_Push("sd.drin.3", 9)
                    Deskbar_Event(pa, pb, AKMouseEv.MOVE)
                }

                // Route MOVE to toolbar if cursor is over one
                tb_move = Win_ToolbarHitTest(pa, pb)
                IfCondition GreaterEqual(tb_move, 0) ThenBlock: {
                    DebugLog_Push("sd.drin.1", 9)
                    tb_drew = Win_ToolbarEvent(tb_move, pa, pb, AKMouseEv.MOVE)
                    IfCondition EqualTo(tb_drew, 1) ThenBlock: {
                        SysDisplayState.dirty = 1
                    }
                } ElseBlock: {
                    // Route MOVE to content area for hover effects
                    IfCondition And(LessThan(WinInputState.drag_idx, 0), LessThan(WinInputState.resize_idx, 0)) ThenBlock: {
                        ct_mv = Win_HitTest(pa, pb)
                        IfCondition GreaterEqual(ct_mv, 0) ThenBlock: {
                            ct_drew = Win_ContentEvent(ct_mv, pa, pb, AKMouseEv.MOVE, 0)
                            IfCondition EqualTo(ct_drew, 1) ThenBlock: {
                                SysDisplayState.dirty = 1
                            }
                        }
                    }
                }

                DebugLog_Push("sd.drin.4", 9)
            }

            // MOUSE DOWN
            IfCondition EqualTo(ev, Ring1Event.MOUSE_DOWN) ThenBlock: {
                DebugLog_Push("DN", 2)

                // Cascade submenu overlay — highest priority when open
                cm_hit = CascadeMenu_HitTest(pa, pb)
                IfCondition EqualTo(cm_hit, 1) ThenBlock: {
                    CascadeMenu_Event(pa, pb, AKMouseEv.DOWN)
                    SysDisplayState.dirty = 1
                } ElseBlock: {

                // Start Menu overlay — intercept clicks when open
                sm_hit = StartMenu_HitTest(pa, pb)
                IfCondition EqualTo(sm_hit, 1) ThenBlock: {
                    StartMenu_Event(pa, pb, AKMouseEv.DOWN)
                    SysDisplayState.dirty = 1
                } ElseBlock: {

                // Menu overlay — intercept clicks when open
                menu_hit = Menu_HitTest(pa, pb)
                IfCondition EqualTo(menu_hit, 1) ThenBlock: {
                    DebugLog_Push("sd.drin.2", 9)
                    Menu_Event(pa, pb, AKMouseEv.DOWN)
                    SysDisplayState.dirty = 1
                } ElseBlock: {
                    // Click outside all overlays — close them
                    IfCondition EqualTo(MenuState.open, 1) ThenBlock: {
                        Menu_Close()
                    }
                    IfCondition EqualTo(StartMenuState.open, 1) ThenBlock: {
                        StartMenu_Close()
                    }

                    // Deskbar click — if visible and mouse is in deskbar area
                    IfCondition EqualTo(DeskbarState.visible, 1) ThenBlock: {
                        db_top = Subtract(DeskbarState.screen_h, Add(DeskbarState.height, DeskbarState.hotzone_h))
                        IfCondition GreaterEqual(pb, db_top) ThenBlock: {
                            DebugLog_Push("sd.drin.3", 9)
                            Deskbar_Event(pa, pb, AKMouseEv.DOWN)
                        }
                    }

                    // Check border first — resize takes priority
                    border_hit = Win_BorderHitTest(pa, pb)
                    IfCondition GreaterEqual(border_hit, 0) ThenBlock: {
                        Win_Focus(border_hit)
                        Win_StartResize(border_hit, pa, pb)
                        SysDisplayState.dirty = 1
                    } ElseBlock: {
                        // Toolbar click — focus + dispatch into Auckland tree
                        tb_hit = Win_ToolbarHitTest(pa, pb)
                        IfCondition GreaterEqual(tb_hit, 0) ThenBlock: {
                            DebugLog_Push("dn>tb", 5)
                            Win_Focus(tb_hit)
                            WinInputState.addr_focused = 0
                            SysDisplayState.dirty = 1

                            // Route click into toolbar's Auckland context
                            DebugLog_Push("sd.drin.1", 9)
                            tb_drew = Win_ToolbarEvent(tb_hit, pa, pb, AKMouseEv.DOWN)
                            IfCondition EqualTo(tb_drew, 1) ThenBlock: {
                                SysDisplayState.dirty = 1
                            }
                        } ElseBlock: {
                        // Address bar click — focus + dispatch
                        ab_hit = Win_AddrBarHitTest(pa, pb)
                        IfCondition GreaterEqual(ab_hit, 0) ThenBlock: {
                            Win_Focus(ab_hit)
                            WinInputState.addr_focused = 1
                            Win_AddrBarEvent(ab_hit, pa, pb, AKMouseEv.DOWN)
                            SysDisplayState.dirty = 1
                        } ElseBlock: {
                            hdr_hit = Win_HeaderHitTest(pa, pb)
                            IfCondition GreaterEqual(hdr_hit, 0) ThenBlock: {
                                Win_Focus(hdr_hit)
                                WinInputState.addr_focused = 0
                                Win_StartDrag(hdr_hit, pa, pb)
                                SysDisplayState.dirty = 1
                            } ElseBlock: {
                                hit = Win_HitTest(pa, pb)
                                IfCondition GreaterEqual(hit, 0) ThenBlock: {
                                    Win_Focus(hit)
                                    WinInputState.addr_focused = 0
                                    ct_drew = Win_ContentEvent(hit, pa, pb, AKMouseEv.DOWN, data)
                                    IfCondition EqualTo(ct_drew, 1) ThenBlock: {
                                        SysDisplayState.dirty = 1
                                    }
                                    SysDisplayState.dirty = 1
                                }
                            }
                        }
                        }
                    }
                    DebugLog_Push("sd.drin.4", 9)
                }
                }
                }
            }

            // MOUSE UP — stop drag or apply resize
            IfCondition EqualTo(ev, Ring1Event.MOUSE_UP) ThenBlock: {
                DebugLog_Push("UP", 2)

                // Always clear resize/drag state on UP, regardless of menu
                IfCondition GreaterEqual(WinInputState.resize_idx, 0) ThenBlock: {
                    Win_ApplyResize()
                    SysDisplayState.dirty = 1
                }
                Win_StopDrag()

                // Cascade submenu overlay — intercept UP when open
                cm_up = CascadeMenu_HitTest(pa, pb)
                IfCondition EqualTo(cm_up, 1) ThenBlock: {
                    CascadeMenu_Event(pa, pb, AKMouseEv.UP)
                    SysDisplayState.dirty = 1
                } ElseBlock: {

                // Start Menu overlay — intercept UP when open
                sm_up = StartMenu_HitTest(pa, pb)
                IfCondition EqualTo(sm_up, 1) ThenBlock: {
                    StartMenu_Event(pa, pb, AKMouseEv.UP)
                    SysDisplayState.dirty = 1
                } ElseBlock: {

                // Menu overlay — intercept UP when open
                menu_up = Menu_HitTest(pa, pb)
                IfCondition EqualTo(menu_up, 1) ThenBlock: {
                    DebugLog_Push("sd.drin.2", 9)
                    Menu_Event(pa, pb, AKMouseEv.UP)
                    SysDisplayState.dirty = 1
                } ElseBlock: {
                    // Deskbar release
                    IfCondition EqualTo(DeskbarState.visible, 1) ThenBlock: {
                        db_top = Subtract(DeskbarState.screen_h, Add(DeskbarState.height, DeskbarState.hotzone_h))
                        IfCondition GreaterEqual(pb, db_top) ThenBlock: {
                            DebugLog_Push("sd.drin.3", 9)
                            Deskbar_Event(pa, pb, AKMouseEv.UP)
                        }
                    }

                    // Route UP to toolbar if cursor is over one
                    tb_up = Win_ToolbarHitTest(pa, pb)
                    IfCondition GreaterEqual(tb_up, 0) ThenBlock: {
                        DebugLog_Push("sd.drin.1", 9)
                        tb_drew = Win_ToolbarEvent(tb_up, pa, pb, AKMouseEv.UP)
                        IfCondition EqualTo(tb_drew, 1) ThenBlock: {
                            SysDisplayState.dirty = 1
                        }
                    } ElseBlock: {
                        // Route UP to address bar if cursor is over one
                        ab_up = Win_AddrBarHitTest(pa, pb)
                        IfCondition GreaterEqual(ab_up, 0) ThenBlock: {
                            Win_AddrBarEvent(ab_up, pa, pb, AKMouseEv.UP)
                            SysDisplayState.dirty = 1
                        } ElseBlock: {
                        // Route UP to content area
                        ct_up = Win_HitTest(pa, pb)
                        IfCondition GreaterEqual(ct_up, 0) ThenBlock: {
                            ct_drew = Win_ContentEvent(ct_up, pa, pb, AKMouseEv.UP, data)
                            IfCondition EqualTo(ct_drew, 1) ThenBlock: {
                                SysDisplayState.dirty = 1
                            }
                        }
                        }
                    }

                    DebugLog_Push("sd.drin.4", 9)
                }
                }
                }
            }

            // MOUSE WHEEL — forward to IPC canvas apps
            // data = wheel delta (positive=up, negative=down)
            // ev=3 (scroll), delta in button field
            IfCondition EqualTo(ev, Ring1Event.MOUSE_WHEEL) ThenBlock: {
                whl_idx = Win_HitTest(pa, pb)
                IfCondition GreaterEqual(whl_idx, 0) ThenBlock: {
                    Win_ContentEvent(whl_idx, pa, pb, 3, data)
                }
            }
        }

        Deallocate(entry, RingEntry.SIZE)
        ReturnValue(quit)
    }
}

// =============================================================================
// MAIN LOOP
// =============================================================================


Function.SysDisplay_Run {
    Output: Integer
    Body: {
        DebugLog_Push("sd.run", 6)
        // Allocate timespec for nanosleep: {tv_sec=0, tv_nsec=16666666} (~60Hz)
        ts = Allocate(16)
        StoreValue(ts, 0)
        StoreValue(Add(ts, 8), 16666666)

        // Allocate timespec for clock_gettime reads
        clk = Allocate(16)

        // Seed last time stamp
        SystemCall(228, 1, clk)
        SysDisplayState.last_sec  = Dereference(clk)
        SysDisplayState.last_nsec = Dereference(Add(clk, 8))

        SysDisplayState.running = 1
        WhileLoop EqualTo(SysDisplayState.running, 1) {
            DebugLog_Push("sd.run.1", 8)
            // --- Frame timing: read clock at frame start ---
            SystemCall(228, 1, clk)
            now_sec  = Dereference(clk)
            now_nsec = Dereference(Add(clk, 8))

            // delta_ms = (now_sec - last_sec)*1000 + (now_nsec - last_nsec)/1000000
            dsec  = Subtract(now_sec, SysDisplayState.last_sec)
            dnsec = Subtract(now_nsec, SysDisplayState.last_nsec)
            delta_ms = Add(Multiply(dsec, 1000), Divide(dnsec, 1000000))
            SysDisplayState.frame_ms  = delta_ms
            SysDisplayState.last_sec  = now_sec
            SysDisplayState.last_nsec = now_nsec

            // Accumulate for FPS (update every ~1 second)
            SysDisplayState.fps_accum  = Add(SysDisplayState.fps_accum, delta_ms)
            SysDisplayState.fps_frames = Add(SysDisplayState.fps_frames, 1)
            IfCondition GreaterEqual(SysDisplayState.fps_accum, 1000) ThenBlock: {
                // fps = frames * 1000 / accum_ms
                SysDisplayState.fps = Divide(Multiply(SysDisplayState.fps_frames, 1000), SysDisplayState.fps_accum)
                SysDisplayState.fps_accum  = 0
                SysDisplayState.fps_frames = 0
            }

            SysDisplayState.frame_count = Add(SysDisplayState.frame_count, 1)
            DebugLog_Push("LOOP", 4)

            DebugLog_Push("sd.run.2", 8)
            Evdev_Poll()
            DebugLog_Push("sd.run.3", 8)
            quit = SysDisplay_DrainInput()
            IfCondition EqualTo(quit, 1) ThenBlock: {
                SysDisplayState.running = 0
            }
            DebugLog_Push("DI.ok", 5)

            DebugLog_Push("sd.run.4", 8)
            DebugLog_Push("AKdd", 4)
            DebugLog_Push("sd.run.5", 8)
            any_dirty = Win_RenderDirty()

            // Drain action queue — safe, all contexts restored
            DebugLog_Push("sd.run.6", 8)
            action_count = EventRouter_Drain()
            IfCondition GreaterThan(action_count, 0) ThenBlock: {
                SysDisplayState.dirty = 1
            }
            DebugLog_Push("ERdr", 4)

            // Poll IPC broker — accept connections, receive messages
            ipc_count = IPCBroker_Poll()
            IfCondition GreaterThan(ipc_count, 0) ThenBlock: {
                SysDisplayState.dirty = 1
            }

            // Refresh deskbar window list if needed
            IfCondition EqualTo(DeskbarState.needs_refresh, 1) ThenBlock: {
                Deskbar_Refresh()
                SysDisplayState.dirty = 1
            }

            // Render debug overlay to its own surface (blitted in Win_BlitAll)
            DebugLog_Push("sd.run.7", 8)
            DebugLog_Render()

            // Force blit every frame when debug overlay is active (FPS/stats update)
            IfCondition EqualTo(DebugLog.enabled, 1) ThenBlock: {
                SysDisplayState.dirty = 1
            }

            DebugLog_Push("sd.run.8", 8)
            IfCondition EqualTo(SysDisplayState.dirty, 1) ThenBlock: {
                Win_BlitAll()
                SysDisplayState.dirty = 0
            } ElseBlock: {
                IfCondition EqualTo(any_dirty, 1) ThenBlock: {
                    Win_BlitAll()
                }
            }

            // ~60Hz frame sleep
            SystemCall(35, ts, 0)
        }
        Deallocate(ts, 16)
        Deallocate(clk, 16)
        ReturnValue(1)
    }
}

/// =============================================================================
// START
// =============================================================================
Function.SysDisplay_Init {
    Output: Integer
    Body: {
        DebugLog_Push("sd.ini", 6)

        PrintMessage("[SysDisplay] starting\n")
        SysDisplay_InitFB()
        ok = Compose_Init(FB_GetWidth(), FB_GetHeight())
        PrintMessage("[Compose_Init] screen_h=") PrintNumber(Compositor.screen_h) PrintMessage("\n")
        PrintMessage("[Compose_Init] screen_w=") PrintNumber(Compositor.screen_w) PrintMessage("\n")
        SysDisplay_InitFont()
        SysDisplay_InitCursor()
        WinMgr_Init()
        SysDisplay_InitDB()
        SysDisplay_InitTTY()
        SysDisplay_InitInput()

        // Vector font + TextRegion init
        VIF_Init()
        VFont_Init()
        TextRegion_Init()
        VFont_LoadVIF("/system/fonts/DejaVuSans.vif")

        // Tab bar font instance
        WinMgr.tab_inst = VFont_UseSize(UIScale.tab_font_h)
        PrintMessage("[SysDisplay] tab_inst=")
        PrintNumber(WinMgr.tab_inst)
        PrintMessage("\n")

        // Load Alteix Sans as face 1 (title/display font)
        alt_face = VFont_LoadFace("/system/fonts/AlteixSans.vif")
        PrintMessage("[SysDisplay] Alteix face result=")
        PrintNumber(alt_face)
        PrintMessage(" FaceTable.count=")
        PrintNumber(FaceTable.count)
        PrintMessage("\n")

        // Icon system — load Silver System Atoms widget pack
        VIcon_Init()
        icon_ok = VIcon_LoadVIF(IconTier.WIDGETS, "/system/icons/silver_atoms.vif")
        PrintMessage("[SysDisplay] VIcon load result=")
        PrintNumber(icon_ok)
        PrintMessage(" initialized=")
        PrintNumber(VIconState.initialized)
        PrintMessage("\n")

        // Debug overlay
        DebugLog_Init()

        // Desktop — raw full-screen surface, index 0, no border, no header
        fb_w = FB_GetWidth()
        fb_h = FB_GetHeight()
        d_surf = Surface_Create(SurfaceFormat.PIXEL_32, fb_w, fb_h)
        SysDisplayState.desktop_surf = d_surf
        Draw_Pix_FillRect(d_surf, 0, 0, fb_w, fb_h, WinColor.DESKTOP)

        idx = Float_Add(d_surf, 0, 0, fb_w, fb_h)
        Win_SetGeom(idx, 0, 0, fb_w, fb_h)
        fptr = Float_EntryPtr(idx)
        StoreValue(Add(fptr, FloatEntryFields.SURFACE), d_surf)

        WinMgr_SetHdr(idx,     -1)
        WinMgr_SetContent(idx, d_surf)
        WinMgr_SetTB(idx, -1)

        // Desktop text via TextRegion (vector fonts)
        VFont_UseSize(UIScale.font_title)

        // Title in Alteix Sans (face 1) if available, else DejaVu
        title_face = 1
        title_gc = Face_Get(title_face, FaceFields.GLYPH_COUNT)
        PrintMessage("[SysDisplay] title_face=1 glyph_count=")
        PrintNumber(title_gc)
        PrintMessage(" default_face=")
        PrintNumber(FontState.default_face)
        PrintMessage("\n")
        IfCondition GreaterThan(title_gc, 0) ThenBlock: {
            // Temporarily swap default face to Alteix for TextRegion
            saved_face = FontState.default_face
            saved_inst = FontState.default_inst
            FontState.default_face = title_face
            title_inst = VFont_CreateInstance(title_face, UIScale.font_title)
            FontState.default_inst = title_inst

            tr_title = TextRegion_Create(d_surf, 20, 20, 760, 40)
            TextRegion_SetColor(tr_title, TVG_PackColor(255, 255, 255, 255))
            TextRegion_SetWrap(tr_title, 0)
            TextRegion_Render(tr_title, "AILANG Display Server", 21)

            // Restore default face
            FontState.default_face = saved_face
            FontState.default_inst = saved_inst
        } ElseBlock: {
            tr_title = TextRegion_Create(d_surf, 20, 20, 760, 40)
            TextRegion_SetColor(tr_title, TVG_PackColor(255, 255, 255, 255))
            TextRegion_SetWrap(tr_title, 0)
            TextRegion_Render(tr_title, "AILANG Display Server", 21)
        }

        // Help text in default font (DejaVu Sans)
        tr_help = TextRegion_Create(d_surf, 20, 60, 760, 80)
        TextRegion_SetColor(tr_help, TVG_PackColor(180, 200, 220, 255))
        TextRegion_SetWrap(tr_help, 1)
        TextRegion_Render(tr_help, "Alt+V new window  ESC quit. Click window to focus.", 50)

        PrintMessage("[TextRegion] rendered on desktop\n")

        // Test icon rendering — blit a few widget icons onto desktop
        PrintMessage("[SysDisplay] VIcon check: initialized=")
        PrintNumber(VIconState.initialized)
        PrintMessage("\n")
        IfCondition EqualTo(VIconState.initialized, 1) ThenBlock: {
            VIcon_SetSize(32)
            icon_close = VIcon_Resolve("close_btn_normal")
            PrintMessage("[SysDisplay] icon_close surf=")
            PrintNumber(icon_close)
            PrintMessage("\n")
            IfCondition NotEqual(icon_close, 0) ThenBlock: {
                Surface_BlitAlpha(d_surf, icon_close, 20, 120)
                PrintMessage("[SysDisplay] icon close_btn_normal rendered\n")
            }
            icon_min = VIcon_Resolve("min_btn_normal")
            IfCondition NotEqual(icon_min, 0) ThenBlock: {
                Surface_BlitAlpha(d_surf, icon_min, 56, 120)
                PrintMessage("[SysDisplay] icon min_btn_normal rendered\n")
            }
            icon_max = VIcon_Resolve("max_btn_normal")
            IfCondition NotEqual(icon_max, 0) ThenBlock: {
                Surface_BlitAlpha(d_surf, icon_max, 92, 120)
                PrintMessage("[SysDisplay] icon max_btn_normal rendered\n")
            }
            icon_btn = VIcon_Resolve("button_body_normal")
            IfCondition NotEqual(icon_btn, 0) ThenBlock: {
                Surface_BlitAlpha(d_surf, icon_btn, 140, 120)
                PrintMessage("[SysDisplay] icon button_body_normal rendered\n")
            }
            icon_chk = VIcon_Resolve("checkbox_box_on")
            IfCondition NotEqual(icon_chk, 0) ThenBlock: {
                Surface_BlitAlpha(d_surf, icon_chk, 250, 120)
                PrintMessage("[SysDisplay] icon checkbox_box_on rendered\n")
            }
            icon_tab = VIcon_Resolve("tab_bg_active")
            IfCondition NotEqual(icon_tab, 0) ThenBlock: {
                Surface_BlitAlpha(d_surf, icon_tab, 296, 120)
                PrintMessage("[SysDisplay] icon tab_bg_active rendered\n")
            }
        }

        WinMgr.count = Add(WinMgr.count, 1)

        // Append desktop (idx 0) to z_order
        WinMgr_ZSet(0, idx)
        WinMgr.z_count = 1

        Win_Focus(idx)

        PrintMessage("[Desktop] idx=")   PrintNumber(idx)   PrintMessage("\n")
        PrintMessage("[Desktop] fb_w=")  PrintNumber(fb_w)  PrintMessage("\n")
        PrintMessage("[Desktop] fb_h=")  PrintNumber(fb_h)  PrintMessage("\n")

        SysDisplayState.dirty = 1
        Win_BlitAll()



        ReturnValue(1)
    }
}
