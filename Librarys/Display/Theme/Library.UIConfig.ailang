// Library.UIConfig.ailang — key=value config file loader for UI settings
// Loads config/ui.cfg at startup. Falls back to defaults if file missing.
// Copyright (c) 2026 Sean Collins, 2 Paws Machine and Engineering. SCSL.

LibraryImport.StringUtils

// =============================================================================
// CONSTANTS
// =============================================================================
FixedPool.UIConfigConst {
    "MAX_ENTRIES":  Initialize=256
    "KEY_LEN":      Initialize=32
    "BUFFER_SIZE":  Initialize=4096
    "ENTRY_SIZE":   Initialize=40
    "VAL_OFFSET":   Initialize=32
}

// Syscall numbers
FixedPool.UIConfigSys {
    "SYS_OPEN":  Initialize=2
    "SYS_READ":  Initialize=0
    "SYS_CLOSE": Initialize=3
    "O_RDONLY":   Initialize=0
}

// =============================================================================
// STATE
// =============================================================================
FixedPool.UIConfigState {
    "entries":    Initialize=0, CanChange=True
    "count":      Initialize=0, CanChange=True
    "loaded":     Initialize=0, CanChange=True
}

// =============================================================================
// INTERNAL: Parse integer from string
// =============================================================================
Function.UIConfig_ParseInt {
    Input: str: Address
    Output: Integer
    Body: {
        result = 0
        pos = 0
        neg = 0
        // Skip leading whitespace
        WhileLoop EqualTo(GetByte(str, pos), 32) { pos = Add(pos, 1) }
        // Check for minus sign
        IfCondition EqualTo(GetByte(str, pos), 45) ThenBlock: {
            neg = 1
            pos = Add(pos, 1)
        }
        // Check for 0x hex prefix
        IfCondition And(EqualTo(GetByte(str, pos), 48), EqualTo(GetByte(str, Add(pos, 1)), 120)) ThenBlock: {
            pos = Add(pos, 2)
            WhileLoop NotEqual(GetByte(str, pos), 0) {
                ch = GetByte(str, pos)
                IfCondition And(GreaterEqual(ch, 48), LessEqual(ch, 57)) ThenBlock: {
                    result = Add(Multiply(result, 16), Subtract(ch, 48))
                }
                IfCondition And(GreaterEqual(ch, 97), LessEqual(ch, 102)) ThenBlock: {
                    result = Add(Multiply(result, 16), Add(Subtract(ch, 97), 10))
                }
                IfCondition And(GreaterEqual(ch, 65), LessEqual(ch, 70)) ThenBlock: {
                    result = Add(Multiply(result, 16), Add(Subtract(ch, 65), 10))
                }
                pos = Add(pos, 1)
            }
        } ElseBlock: {
            WhileLoop NotEqual(GetByte(str, pos), 0) {
                ch = GetByte(str, pos)
                IfCondition And(GreaterEqual(ch, 48), LessEqual(ch, 57)) ThenBlock: {
                    result = Add(Multiply(result, 10), Subtract(ch, 48))
                }
                pos = Add(pos, 1)
            }
        }
        IfCondition EqualTo(neg, 1) ThenBlock: { result = Subtract(0, result) }
        ReturnValue(result)
    }
}

// =============================================================================
// INTERNAL: String compare (null-terminated, case-sensitive)
// =============================================================================
Function.UIConfig_StrEq {
    Input: a: Address
    Input: b: Address
    Output: Integer
    Body: {
        pos = 0
        WhileLoop 1 {
            ca = GetByte(a, pos)
            cb = GetByte(b, pos)
            IfCondition NotEqual(ca, cb) ThenBlock: { ReturnValue(0) }
            IfCondition EqualTo(ca, 0) ThenBlock: { ReturnValue(1) }
            pos = Add(pos, 1)
        }
        ReturnValue(0)
    }
}

// =============================================================================
// INTERNAL: Copy string into fixed-size slot
// =============================================================================
Function.UIConfig_CopyKey {
    Input: src: Address
    Input: dst: Address
    Input: max_len: Integer
    Body: {
        i = 0
        limit = Subtract(max_len, 1)
        WhileLoop LessThan(i, limit) {
            ch = GetByte(src, i)
            SetByte(dst, i, ch)
            IfCondition EqualTo(ch, 0) ThenBlock: { ReturnValue(0) }
            i = Add(i, 1)
        }
        SetByte(dst, i, 0)
        ReturnValue(0)
    }
}

// =============================================================================
// INTERNAL: Store a key=value entry
// =============================================================================
Function.UIConfig_Store {
    Input: key: Address
    Input: value: Integer
    Body: {
        entries = UIConfigState.entries
        count = UIConfigState.count
        entry_size = UIConfigConst.ENTRY_SIZE

        // Check if key already exists — overwrite value in-place if so
        i = 0
        WhileLoop LessThan(i, count) {
            off = Multiply(i, entry_size)
            slot = Add(entries, off)
            IfCondition EqualTo(UIConfig_StrEq(slot, key), 1) ThenBlock: {
                val_off = Add(slot, UIConfigConst.VAL_OFFSET)
                StoreValue(val_off, value)
                ReturnValue(1)
            }
            i = Add(i, 1)
        }

        // Not found — append new entry
        max = UIConfigConst.MAX_ENTRIES
        IfCondition GreaterEqual(count, max) ThenBlock: { ReturnValue(0) }
        off = Multiply(count, entry_size)
        slot = Add(entries, off)
        UIConfig_CopyKey(key, slot, UIConfigConst.KEY_LEN)
        val_off = Add(slot, UIConfigConst.VAL_OFFSET)
        StoreValue(val_off, value)
        UIConfigState.count = Add(count, 1)
        ReturnValue(1)
    }
}

// =============================================================================
// INTERNAL: Parse one line — skip comments/blanks, split on '='
// =============================================================================
Function.UIConfig_ParseLine {
    Input: buf: Address
    Input: start: Integer
    Input: end: Integer
    Body: {
        // Skip leading whitespace
        pos = start
        WhileLoop And(LessThan(pos, end), EqualTo(GetByte(buf, pos), 32)) {
            pos = Add(pos, 1)
        }
        // Empty or comment line
        IfCondition GreaterEqual(pos, end) ThenBlock: { ReturnValue(0) }
        ch = GetByte(buf, pos)
        IfCondition EqualTo(ch, 35) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(ch, 10) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(ch, 13) ThenBlock: { ReturnValue(0) }

        // Find '=' separator
        eq_pos = pos
        WhileLoop And(LessThan(eq_pos, end), NotEqual(GetByte(buf, eq_pos), 61)) {
            eq_pos = Add(eq_pos, 1)
        }
        IfCondition GreaterEqual(eq_pos, end) ThenBlock: { ReturnValue(0) }

        // Extract key (null-terminate in temp buffer on stack)
        key_buf = Allocate(UIConfigConst.KEY_LEN)
        key_len = Subtract(eq_pos, pos)
        IfCondition GreaterEqual(key_len, UIConfigConst.KEY_LEN) ThenBlock: {
            key_len = Subtract(UIConfigConst.KEY_LEN, 1)
        }
        i = 0
        WhileLoop LessThan(i, key_len) {
            SetByte(key_buf, i, GetByte(buf, Add(pos, i)))
            i = Add(i, 1)
        }
        // Trim trailing whitespace from key
        WhileLoop And(GreaterThan(key_len, 0), EqualTo(GetByte(key_buf, Subtract(key_len, 1)), 32)) {
            key_len = Subtract(key_len, 1)
        }
        SetByte(key_buf, key_len, 0)

        // Extract value (after '=')
        val_start = Add(eq_pos, 1)
        // Skip leading whitespace in value
        WhileLoop And(LessThan(val_start, end), EqualTo(GetByte(buf, val_start), 32)) {
            val_start = Add(val_start, 1)
        }
        // Null-terminate value for parser
        val_buf = Allocate(UIConfigConst.KEY_LEN)
        val_len = 0
        vp = val_start
        WhileLoop And(LessThan(vp, end), LessThan(val_len, Subtract(UIConfigConst.KEY_LEN, 1))) {
            ch = GetByte(buf, vp)
            IfCondition Or(EqualTo(ch, 10), EqualTo(ch, 13)) ThenBlock: { BreakLoop }
            SetByte(val_buf, val_len, ch)
            val_len = Add(val_len, 1)
            vp = Add(vp, 1)
        }
        // Trim trailing whitespace from value
        WhileLoop And(GreaterThan(val_len, 0), EqualTo(GetByte(val_buf, Subtract(val_len, 1)), 32)) {
            val_len = Subtract(val_len, 1)
        }
        SetByte(val_buf, val_len, 0)

        // Parse value as integer and store
        int_val = UIConfig_ParseInt(val_buf)
        UIConfig_Store(key_buf, int_val)

        Deallocate(key_buf, UIConfigConst.KEY_LEN)
        Deallocate(val_buf, UIConfigConst.KEY_LEN)
        ReturnValue(1)
    }
}

// =============================================================================
// LOAD — open file, read, parse all lines
// =============================================================================
Function.UIConfig_Load {
    Input: path: Address
    Output: Integer
    Body: {
        // Allocate entry table
        table_size = Multiply(UIConfigConst.MAX_ENTRIES, UIConfigConst.ENTRY_SIZE)
        UIConfigState.entries = Allocate(table_size)
        UIConfigState.count = 0
        UIConfigState.loaded = 0

        // Zero the table
        i = 0
        WhileLoop LessThan(i, table_size) {
            SetByte(UIConfigState.entries, i, 0)
            i = Add(i, 1)
        }

        // Open file
        fd = SystemCall(UIConfigSys.SYS_OPEN, path, UIConfigSys.O_RDONLY, 0)
        IfCondition LessThan(fd, 0) ThenBlock: {
            PrintMessage("[UIConfig] no config file, using defaults\n")
            ReturnValue(0)
        }

        // Read into buffer
        buf = Allocate(UIConfigConst.BUFFER_SIZE)
        bytes_read = SystemCall(UIConfigSys.SYS_READ, fd, buf, UIConfigConst.BUFFER_SIZE)
        SystemCall(UIConfigSys.SYS_CLOSE, fd, 0, 0)

        IfCondition LessEqual(bytes_read, 0) ThenBlock: {
            PrintMessage("[UIConfig] empty config file\n")
            Deallocate(buf, UIConfigConst.BUFFER_SIZE)
            ReturnValue(0)
        }

        // Parse line by line
        line_start = 0
        pos = 0
        WhileLoop LessThan(pos, bytes_read) {
            ch = GetByte(buf, pos)
            IfCondition EqualTo(ch, 10) ThenBlock: {
                UIConfig_ParseLine(buf, line_start, pos)
                line_start = Add(pos, 1)
            }
            pos = Add(pos, 1)
        }
        // Handle last line without trailing newline
        IfCondition LessThan(line_start, bytes_read) ThenBlock: {
            UIConfig_ParseLine(buf, line_start, bytes_read)
        }

        Deallocate(buf, UIConfigConst.BUFFER_SIZE)
        UIConfigState.loaded = 1

        PrintMessage("[UIConfig] loaded ")
        PrintNumber(UIConfigState.count)
        PrintMessage(" entries\n")
        ReturnValue(UIConfigState.count)
    }
}

// =============================================================================
// GET — look up a key, return its value or default if not found
// =============================================================================
Function.UIConfig_GetInt {
    Input: key: Address
    Input: default_val: Integer
    Output: Integer
    Body: {
        entries = UIConfigState.entries
        IfCondition EqualTo(entries, 0) ThenBlock: { ReturnValue(default_val) }

        count = UIConfigState.count
        entry_size = UIConfigConst.ENTRY_SIZE
        i = 0
        WhileLoop LessThan(i, count) {
            slot = Add(entries, Multiply(i, entry_size))
            IfCondition EqualTo(UIConfig_StrEq(slot, key), 1) ThenBlock: {
                val_ptr = Add(slot, UIConfigConst.VAL_OFFSET)
                ReturnValue(Dereference(val_ptr))
            }
            i = Add(i, 1)
        }
        ReturnValue(default_val)
    }
}
