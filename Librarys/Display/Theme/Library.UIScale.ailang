// Library.UIScale.ailang — DPI/canvas-aware sizing system
// Central registry for all UI dimensions. Computes scale factor from
// screen height relative to 96 DPI / 1080p reference. All UI libraries
// read from UIScale.* instead of hardcoded pixel values.
// Copyright (c) 2026 Sean Collins, 2 Paws Machine and Engineering. SCSL.

LibraryImport.Display.Theme.UIConfig

// =============================================================================
// STATE — all computed at init, readable by every UI library
// =============================================================================
FixedPool.UIScale {
    // Screen info
    "screen_w":       Initialize=0, CanChange=True
    "screen_h":       Initialize=0, CanChange=True
    "scale_num":      Initialize=1, CanChange=True
    "scale_den":      Initialize=1, CanChange=True

    // Grid (screen / 9)
    "grid_w":         Initialize=0, CanChange=True
    "grid_h":         Initialize=0, CanChange=True

    // Font sizes (scaled)
    "font_debug":     Initialize=24, CanChange=True
    "font_menu":      Initialize=14, CanChange=True
    "font_body":      Initialize=22, CanChange=True
    "font_title":     Initialize=24, CanChange=True
    "font_label":     Initialize=12, CanChange=True
    "font_doc":       Initialize=16, CanChange=True

    // Toolbar — sizes are logical; InitToolbar runs them through UIScale_Val.
    "toolbar_h":         Initialize=24, CanChange=True
    "toolbar_btn_w":     Initialize=48, CanChange=True
    "toolbar_btn_h":     Initialize=18, CanChange=True
    "toolbar_close_w":   Initialize=18, CanChange=True
    "toolbar_pad":       Initialize=3, CanChange=True
    "toolbar_gap":       Initialize=3, CanChange=True
    "toolbar_font_h":    Initialize=12, CanChange=True
    "toolbar_border_w":  Initialize=1, CanChange=True

    // Address bar
    "addr_h":         Initialize=28, CanChange=True

    // Deskbar
    "deskbar_h":       Initialize=40, CanChange=True
    "deskbar_hotzone": Initialize=2, CanChange=True
    "deskbar_btn_w":   Initialize=64, CanChange=True
    "deskbar_btn_h":   Initialize=32, CanChange=True
    "deskbar_pad":     Initialize=4, CanChange=True
    "deskbar_pad_lr":  Initialize=8, CanChange=True
    "deskbar_gap":     Initialize=4, CanChange=True
    "deskbar_win_btn_w": Initialize=96, CanChange=True

    // Menu
    "menu_item_w":    Initialize=160, CanChange=True
    "menu_item_h":    Initialize=26, CanChange=True
    "menu_pad":       Initialize=4, CanChange=True

    // Window decorations
    "border_w":       Initialize=4, CanChange=True
    "header_h":       Initialize=24, CanChange=True
    "cursor_size":    Initialize=24, CanChange=True

    // Tabs
    "tab_max_w":      Initialize=72, CanChange=True
    "tab_row_h":      Initialize=24, CanChange=True
    "tab_icon_w":     Initialize=10, CanChange=True
    "tab_pad":        Initialize=4, CanChange=True
    "tab_font_h":     Initialize=14, CanChange=True
    "tab_doc_font_h": Initialize=16, CanChange=True

    // Dialog/modal sizing
    "dialog_frac_num":Initialize=1, CanChange=True
    "dialog_frac_den":Initialize=3, CanChange=True
    "dialog_min_w":   Initialize=200, CanChange=True
    "dialog_min_h":   Initialize=150, CanChange=True

    // Auckland widget dimensions
    "ak_btn_hover_delta":      Initialize=30, CanChange=True
    "ak_btn_border_w":         Initialize=1, CanChange=True
    "ak_btn_icon_pad_l":       Initialize=2, CanChange=True
    "ak_btn_icon_gap":         Initialize=6, CanChange=True
    "ak_checkbox_sz":          Initialize=14, CanChange=True
    "ak_checkbox_pad_l":       Initialize=4, CanChange=True
    "ak_checkbox_inner_margin":Initialize=3, CanChange=True
    "ak_checkbox_label_gap":   Initialize=6, CanChange=True
    "ak_textfield_border_w":   Initialize=1, CanChange=True
    "ak_textfield_pad":        Initialize=4, CanChange=True
    "ak_cursor_w":             Initialize=2, CanChange=True
    "ak_separator_w":          Initialize=1, CanChange=True
    "ak_checkbox_border_w":    Initialize=1, CanChange=True
    "ak_gutter_w":             Initialize=44, CanChange=True
    "ak_gutter_pad_l":         Initialize=1, CanChange=True
    "ak_gutter_pad_r":         Initialize=4, CanChange=True
    "ak_input_h":              Initialize=28, CanChange=True
    "ak_input_pad":            Initialize=6, CanChange=True

    // Scrollbar
    "scrollbar_w":             Initialize=12, CanChange=True
    "scrollbar_min_thumb":     Initialize=20, CanChange=True

    // Deskbar fine-tuning
    "deskbar_start_text_w":    Initialize=46, CanChange=True
    "deskbar_start_icon_inset":Initialize=2, CanChange=True
    "deskbar_win_icon_inset":  Initialize=6, CanChange=True
    "deskbar_launcher_icon_inset": Initialize=4, CanChange=True

    // Deskbar icon minimums
    "deskbar_start_icon_min":  Initialize=14, CanChange=True
    "deskbar_win_icon_min":    Initialize=12, CanChange=True
    "deskbar_launcher_icon_min": Initialize=16, CanChange=True

    // Menu fine-tuning
    "cascade_menu_gap":        Initialize=2, CanChange=True
    "menu_icon_inset":         Initialize=6, CanChange=True
    "menu_border_w":           Initialize=1, CanChange=True
    "menu_icon_min_sz":        Initialize=12, CanChange=True

    // SysDisplay
    "debug_overlay_w":         Initialize=200, CanChange=True
    "debug_overlay_h":         Initialize=800, CanChange=True
    "debug_overlay_x":         Initialize=10, CanChange=True
    "debug_overlay_y":         Initialize=140, CanChange=True
    "default_win_pct":         Initialize=80, CanChange=True

    // Window dimensions
    "min_tab_w":               Initialize=40, CanChange=True
    "min_win_w":               Initialize=200, CanChange=True
    "min_win_h":               Initialize=200, CanChange=True
}

// =============================================================================
// SCALE HELPER — apply scale factor to a base value, minimum 1
// =============================================================================
Function.UIScale_Val {
    Input: base_val: Integer
    Output: Integer
    Body: {
        num = UIScale.scale_num
        den = UIScale.scale_den
        IfCondition EqualTo(den, 0) ThenBlock: { ReturnValue(base_val) }
        result = Divide(Multiply(base_val, num), den)
        IfCondition LessThan(result, 1) ThenBlock: { ReturnValue(1) }
        ReturnValue(result)
    }
}

// =============================================================================
// INIT — load config, compute scale, fill all fields
// Call once from SysDisplay_InitFB after screen dims are known.
// =============================================================================
Function.UIScale_Init {
    Input: screen_w: Integer
    Input: screen_h: Integer
    Output: Integer
    Body: {
        UIScale.screen_w = screen_w
        UIScale.screen_h = screen_h

        // Read reference height from config (default 1080)
        ref_h = UIConfig_GetInt("ref_height", 1080)
        IfCondition EqualTo(ref_h, 0) ThenBlock: { ref_h = 1080 }

        // Compute scale ratio: screen_h / ref_h, GCD-reduced
        sn = screen_h
        sd = ref_h
        a = sn
        b = sd
        WhileLoop NotEqual(b, 0) {
            t = Modulo(a, b)
            a = b
            b = t
        }
        // a is now GCD
        IfCondition EqualTo(a, 0) ThenBlock: { a = 1 }
        UIScale.scale_num = Divide(sn, a)
        UIScale.scale_den = Divide(sd, a)

        // Grid (rule of 9)
        UIScale.grid_w = Divide(screen_w, 9)
        UIScale.grid_h = Divide(screen_h, 9)

        // Load base values from config, then scale
        UIScale_InitFonts()
        UIScale_InitToolbar()
        UIScale_InitDeskbar()
        UIScale_InitMenu()
        UIScale_InitDecor()
        UIScale_InitTabs()
        UIScale_InitDialog()
        UIScale_InitWidgets()

        PrintMessage("[UIScale] ")
        PrintNumber(screen_w)
        PrintMessage("x")
        PrintNumber(screen_h)
        PrintMessage(" scale=")
        PrintNumber(UIScale.scale_num)
        PrintMessage("/")
        PrintNumber(UIScale.scale_den)
        PrintMessage(" grid=")
        PrintNumber(UIScale.grid_w)
        PrintMessage("x")
        PrintNumber(UIScale.grid_h)
        PrintMessage("\n")
        ReturnValue(1)
    }
}

// =============================================================================
// RECALC — re-derive from current screen dims (future resolution changes)
// =============================================================================
Function.UIScale_Recalc {
    Output: Integer
    Body: {
        ReturnValue(UIScale_Init(UIScale.screen_w, UIScale.screen_h))
    }
}

// =============================================================================
// INIT HELPERS — read config base value, scale it, store
// Split into sub-functions to keep each under 6 inputs.
// =============================================================================

Function.UIScale_InitFonts {
    Body: {
        UIScale.font_debug = UIConfig_GetInt("font_debug", 24)
        UIScale.font_menu  = UIScale_Val(UIConfig_GetInt("font_menu", 14))
        UIScale.font_body  = UIScale_Val(UIConfig_GetInt("font_body", 18))
        UIScale.font_title = UIScale_Val(UIConfig_GetInt("font_title", 24))
        UIScale.font_label = UIScale_Val(UIConfig_GetInt("font_label", 12))
        UIScale.font_doc   = UIScale_Val(UIConfig_GetInt("font_doc", 16))
        ReturnValue(0)
    }
}

Function.UIScale_InitToolbar {
    Body: {
        UIScale.toolbar_h        = UIScale_Val(UIConfig_GetInt("toolbar_h", 24))
        UIScale.toolbar_pad      = UIScale_Val(UIConfig_GetInt("toolbar_pad", 3))
        UIScale.toolbar_gap      = UIScale_Val(UIConfig_GetInt("toolbar_gap", 3))
        UIScale.toolbar_font_h   = UIScale_Val(UIConfig_GetInt("toolbar_font_h", 12))
        UIScale.toolbar_border_w = UIScale_Val(UIConfig_GetInt("toolbar_border_w", 1))
        UIScale.toolbar_btn_w    = UIScale_Val(UIConfig_GetInt("toolbar_btn_w", 44))
        // Button height tracks the strip minus pad so inset stays correct at any DPI.
        inner = Subtract(UIScale.toolbar_h, Multiply(UIScale.toolbar_pad, 2))
        IfCondition LessThan(inner, 10) ThenBlock: { inner = 10 }
        UIScale.toolbar_btn_h    = inner
        UIScale.toolbar_close_w  = inner
        UIScale.addr_h           = UIScale_Val(UIConfig_GetInt("addr_h", 28))
        ReturnValue(0)
    }
}

Function.UIScale_InitDeskbar {
    Body: {
        UIScale.deskbar_h       = UIScale_Val(UIConfig_GetInt("deskbar_h", 40))
        UIScale.deskbar_hotzone = UIScale_Val(UIConfig_GetInt("deskbar_hotzone", 2))
        UIScale.deskbar_btn_w   = UIScale_Val(UIConfig_GetInt("deskbar_btn_w", 64))
        UIScale.deskbar_btn_h   = UIScale_Val(UIConfig_GetInt("deskbar_btn_h", 32))
        UIScale.deskbar_pad     = UIScale_Val(UIConfig_GetInt("deskbar_pad", 4))
        UIScale.deskbar_pad_lr  = UIScale_Val(UIConfig_GetInt("deskbar_pad_lr", 8))
        ReturnValue(0)
    }
}

Function.UIScale_InitMenu {
    Body: {
        UIScale.deskbar_gap = UIScale_Val(UIConfig_GetInt("deskbar_gap", 4))
        UIScale.deskbar_win_btn_w = UIScale_Val(UIConfig_GetInt("deskbar_win_btn_w", 96))
        UIScale.menu_item_w = UIScale_Val(UIConfig_GetInt("menu_item_w", 148))
        UIScale.menu_pad    = UIScale.toolbar_pad
        // Rows track toolbar type + pad so a DPI change cannot leave a chunky Win32 menu.
        mh = Add(UIScale.toolbar_font_h, Multiply(UIScale.toolbar_pad, 3))
        IfCondition LessThan(mh, 12) ThenBlock: { mh = 12 }
        UIScale.menu_item_h = mh
        ReturnValue(0)
    }
}

Function.UIScale_InitDecor {
    Body: {
        UIScale.border_w = UIScale_Val(UIConfig_GetInt("border_w", 4))
        UIScale.header_h = UIScale_Val(UIConfig_GetInt("header_h", 24))
        UIScale.cursor_size = UIScale_Val(UIConfig_GetInt("cursor_size", 24))
        IfCondition LessThan(UIScale.cursor_size, 16) ThenBlock: { UIScale.cursor_size = 16 }
        ReturnValue(0)
    }
}

Function.UIScale_InitTabs {
    Body: {
        UIScale.tab_max_w  = UIScale_Val(UIConfig_GetInt("tab_max_w", 72))
        UIScale.tab_row_h  = UIScale_Val(UIConfig_GetInt("tab_row_h", 24))
        UIScale.tab_icon_w = UIScale_Val(UIConfig_GetInt("tab_icon_w", 10))
        UIScale.tab_pad    = UIScale_Val(UIConfig_GetInt("tab_pad", 4))
        UIScale.tab_font_h = UIScale_Val(UIConfig_GetInt("tab_font_h", 14))
        UIScale.tab_doc_font_h = Add(UIScale.tab_font_h, 2)
        ReturnValue(0)
    }
}

Function.UIScale_InitDialog {
    Body: {
        // Dialog fractions are not scaled — they're ratios
        UIScale.dialog_frac_num = UIConfig_GetInt("dialog_frac_num", 1)
        UIScale.dialog_frac_den = UIConfig_GetInt("dialog_frac_den", 3)
        // Minimums are scaled
        UIScale.dialog_min_w = UIScale_Val(UIConfig_GetInt("dialog_min_w", 200))
        UIScale.dialog_min_h = UIScale_Val(UIConfig_GetInt("dialog_min_h", 150))
        ReturnValue(0)
    }
}

// =============================================================================
// INIT WIDGETS — Auckland, Deskbar, Menu, SysDisplay fine-tuning values
// =============================================================================
Function.UIScale_InitWidgets {
    Body: {
        // Auckland widget dimensions (most are scaled)
        UIScale.ak_btn_hover_delta      = UIConfig_GetInt("ak_btn_hover_delta", 30)
        UIScale.ak_btn_border_w         = UIScale_Val(UIConfig_GetInt("ak_btn_border_w", 1))
        UIScale.ak_btn_icon_pad_l       = UIScale_Val(UIConfig_GetInt("ak_btn_icon_pad_l", 2))
        UIScale.ak_btn_icon_gap         = UIScale_Val(UIConfig_GetInt("ak_btn_icon_gap", 6))
        UIScale.ak_checkbox_sz          = UIScale_Val(UIConfig_GetInt("ak_checkbox_sz", 14))
        UIScale.ak_checkbox_pad_l       = UIScale_Val(UIConfig_GetInt("ak_checkbox_pad_l", 4))
        UIScale.ak_checkbox_inner_margin = UIScale_Val(UIConfig_GetInt("ak_checkbox_inner_margin", 3))
        UIScale.ak_checkbox_label_gap   = UIScale_Val(UIConfig_GetInt("ak_checkbox_label_gap", 6))
        UIScale.ak_textfield_border_w   = UIScale_Val(UIConfig_GetInt("ak_textfield_border_w", 1))
        UIScale.ak_textfield_pad        = UIScale_Val(UIConfig_GetInt("ak_textfield_pad", 4))
        UIScale.ak_cursor_w             = UIScale_Val(UIConfig_GetInt("ak_cursor_w", 2))
        UIScale.ak_separator_w          = UIScale_Val(UIConfig_GetInt("ak_separator_w", 1))
        UIScale.ak_checkbox_border_w    = UIScale_Val(UIConfig_GetInt("ak_checkbox_border_w", 1))
        UIScale.ak_gutter_w             = UIScale_Val(UIConfig_GetInt("ak_gutter_w", 44))
        UIScale.ak_gutter_pad_l         = UIScale_Val(UIConfig_GetInt("ak_gutter_pad_l", 1))
        UIScale.ak_gutter_pad_r         = UIScale_Val(UIConfig_GetInt("ak_gutter_pad_r", 4))

        // Scrollbar
        UIScale.scrollbar_w             = UIScale_Val(UIConfig_GetInt("scrollbar_w", 12))
        UIScale.scrollbar_min_thumb     = UIScale_Val(UIConfig_GetInt("scrollbar_min_thumb", 20))

        // Deskbar fine-tuning
        UIScale.deskbar_start_text_w    = UIScale_Val(UIConfig_GetInt("deskbar_start_text_w", 46))
        UIScale.deskbar_start_icon_inset = UIConfig_GetInt("deskbar_start_icon_inset", 2)
        UIScale.deskbar_win_icon_inset  = UIConfig_GetInt("deskbar_win_icon_inset", 6)
        UIScale.deskbar_launcher_icon_inset = UIConfig_GetInt("deskbar_launcher_icon_inset", 4)

        // Deskbar icon minimums
        UIScale.deskbar_start_icon_min  = UIScale_Val(UIConfig_GetInt("deskbar_start_icon_min", 14))
        UIScale.deskbar_win_icon_min    = UIScale_Val(UIConfig_GetInt("deskbar_win_icon_min", 12))
        UIScale.deskbar_launcher_icon_min = UIScale_Val(UIConfig_GetInt("deskbar_launcher_icon_min", 16))

        // Menu fine-tuning
        UIScale.cascade_menu_gap        = UIScale_Val(UIConfig_GetInt("cascade_menu_gap", 2))
        UIScale.menu_icon_inset         = UIConfig_GetInt("menu_icon_inset", 6)
        UIScale.menu_border_w           = UIScale_Val(UIConfig_GetInt("menu_border_w", 1))
        UIScale.menu_icon_min_sz        = UIScale_Val(UIConfig_GetInt("menu_icon_min_sz", 12))

        // SysDisplay — debug overlay not scaled, default_win_pct is a percentage
        UIScale.debug_overlay_w         = UIConfig_GetInt("debug_overlay_w", 200)
        UIScale.debug_overlay_h         = UIConfig_GetInt("debug_overlay_h", 500)
        UIScale.debug_overlay_x         = UIConfig_GetInt("debug_overlay_x", 10)
        UIScale.debug_overlay_y         = UIConfig_GetInt("debug_overlay_y", 140)
        UIScale.default_win_pct         = UIConfig_GetInt("default_win_pct", 80)

        // Window dimensions
        UIScale.min_tab_w              = UIScale_Val(UIConfig_GetInt("min_tab_w", 40))
        UIScale.min_win_w              = UIScale_Val(UIConfig_GetInt("min_win_w", 200))
        UIScale.min_win_h              = UIScale_Val(UIConfig_GetInt("min_win_h", 200))
        ReturnValue(0)
    }
}
