// Library.UITheme.ailang — Centralized UI color theme
// All UI colors in one FixedPool. Loaded from config/ui.cfg at startup.
// Defaults match current hardcoded values — zero visual change without config overrides.
//
// Copyright (c) 2026 Sean Collins, 2 Paws Machine and Engineering. SCSL.

LibraryImport.Display.Theme.UIConfig

// =============================================================================
// THEME — every UI color in one place
// All fields CanChange=True so UITheme_Init can override from config.
// =============================================================================
FixedPool.Theme {
    // --- Desktop / Window backgrounds (Workbench Reborn substrate) ---
    "desktop_bg":       Initialize=0xFF0A1020, CanChange=True
    "window_bg":        Initialize=0xFF0E1730, CanChange=True
    "dialog_bg":        Initialize=0xFF16223F, CanChange=True
    "panel_bg":         Initialize=0xFF0E1730, CanChange=True
    "terminal_bg":      Initialize=0xFF060912, CanChange=True

    // --- Borders / Chrome ---
    "border":           Initialize=0xFF2A4068, CanChange=True

    // --- Text (heritage ink) ---
    "text_fg":          Initialize=0xFFE8EEF8, CanChange=True
    "text_bg":          Initialize=0xFF0E1730, CanChange=True
    "text_secondary":   Initialize=0xFF7A8AAA, CanChange=True
    "text_disabled":    Initialize=0xFF4A5A72, CanChange=True
    "text_light":       Initialize=0xFFE8EEF8, CanChange=True

    // --- Toolbar ---
    "toolbar_bg":       Initialize=0xFF0E1730, CanChange=True
    "toolbar_close_bg": Initialize=0xFFCC3355, CanChange=True
    "toolbar_close_fg": Initialize=0xFFE8EEF8, CanChange=True
    "toolbar_min_bg":   Initialize=0xFF16223F, CanChange=True
    "toolbar_max_bg":   Initialize=0xFF16223F, CanChange=True

    // --- Deskbar ---
    "deskbar_bg":       Initialize=0xFF0E1730, CanChange=True
    "deskbar_btn_bg":   Initialize=0xFF4A8CFF, CanChange=True
    "deskbar_btn_fg":   Initialize=0xFFE8EEF8, CanChange=True
    "deskbar_btn2_bg":  Initialize=0xFF16223F, CanChange=True
    "deskbar_btn2_fg":  Initialize=0xFF7A8AAA, CanChange=True
    "deskbar_hot_fg":   Initialize=0xFF2AD4FF, CanChange=True
    "deskbar_hot_bg":   Initialize=0xFF0A1020, CanChange=True
    "deskbar_win_bg":   Initialize=0xFF16223F, CanChange=True
    "deskbar_win_fg":   Initialize=0xFFE8EEF8, CanChange=True
    "deskbar_win_act_bg": Initialize=0xFF2A4068, CanChange=True
    "deskbar_sep":      Initialize=0xFF2A4068, CanChange=True

    // --- Tab bar ---
    "tabbar_bg":        Initialize=0xFF0A1020, CanChange=True
    "tab_active_bg":    Initialize=0xFF16223F, CanChange=True
    "tab_icon":         Initialize=0xFF4A8CFF, CanChange=True
    "tab_text":         Initialize=0xFFE8EEF8, CanChange=True

    // --- Menu ---
    "menu_bg":          Initialize=0xFF0E1730, CanChange=True
    "menu_fg":          Initialize=0xFFE8EEF8, CanChange=True
    "menu_sep":         Initialize=0xFF2A4068, CanChange=True
    "menu_border":      Initialize=0xFF4A8CFF, CanChange=True

    // --- Auckland widget defaults ---
    "ak_sep":           Initialize=0xFF2A4068, CanChange=True
    "ak_btn_bg":        Initialize=0xFF16223F, CanChange=True
    "ak_btn_fg":        Initialize=0xFFE8EEF8, CanChange=True
    "ak_btn_border":    Initialize=0xFF2A4068, CanChange=True
    "ak_btn_hover":     Initialize=0xFF2AD4FF, CanChange=True
    "ak_btn_pressed":   Initialize=0xFF0A1020, CanChange=True

    // --- FileDialog ---
    "fd_path_text":     Initialize=0xFF7A8AAA, CanChange=True
    "fd_list_bg":       Initialize=0xFF060912, CanChange=True
    "fd_list_border":   Initialize=0xFF2A4068, CanChange=True
    "fd_sep":           Initialize=0xFF2A4068, CanChange=True
    "fd_dir_text":      Initialize=0xFF2AD4FF, CanChange=True
    "fd_file_text":     Initialize=0xFFE8EEF8, CanChange=True
    "fd_empty_text":    Initialize=0xFF4A5A72, CanChange=True
    "fd_sel_bg":        Initialize=0xFF2A2A50, CanChange=True
    "fd_sel_fg":        Initialize=0xFFFFFFFF, CanChange=True

    // --- Page / document surface ---
    "page_bg":          Initialize=0xFFFFFFFF, CanChange=True

    // --- Debug / SysDisplay ---
    "debug_bg":         Initialize=0xCC0A1020, CanChange=True
    "debug_text_color": Initialize=0xFFFFFF50, CanChange=True

    // --- Window header ---
    "header_color":     Initialize=0xFFE8EEF8, CanChange=True

    // --- Auckland widget rendering ---
    "ak_checkbox_box_bg":      Initialize=0xFF1C1C2E, CanChange=True
    "ak_checkmark_color":      Initialize=0xFF00CC66, CanChange=True
    "ak_gutter_bg":            Initialize=0xFF252535, CanChange=True
    "ak_current_line_bg":      Initialize=0xFF2A2A3A, CanChange=True
    "ak_linenum_color":        Initialize=0xFF606080, CanChange=True
    "ak_linenum_active_color": Initialize=0xFFD4D4D4, CanChange=True
    "ak_cursor_color":         Initialize=0xFFE8EEF8, CanChange=True

    // --- Auckland input widget ---
    "ak_input_bg":             Initialize=0xFF0A1020, CanChange=True
    "ak_input_border":         Initialize=0xFF2A4068, CanChange=True
    "ak_input_focus_border":   Initialize=0xFF2AD4FF, CanChange=True
    "ak_input_placeholder":    Initialize=0xFF4A5A72, CanChange=True

    // --- Scrollbar ---
    "scrollbar_track":         Initialize=0xFF1A2A40, CanChange=True
    "scrollbar_thumb":         Initialize=0xFF5588BB, CanChange=True

    // --- Deskbar hotzone ---
    "deskbar_hotzone_color_a": Initialize=0xFFFFFFFF, CanChange=True
    "deskbar_hotzone_color_b": Initialize=0xFF282828, CanChange=True

    // --- Syntax highlighting (Dracula palette) ---
    "syn_default":  Initialize=0xFFD4D4D4, CanChange=True
    "syn_keyword":  Initialize=0xFFFF79C6, CanChange=True
    "syn_builtin":  Initialize=0xFF8BE9FD, CanChange=True
    "syn_string":   Initialize=0xFFF1FA8C, CanChange=True
    "syn_number":   Initialize=0xFFBD93F9, CanChange=True
    "syn_comment":  Initialize=0xFF6272A4, CanChange=True
    "syn_type":     Initialize=0xFF50FA7B, CanChange=True
    "syn_punct":    Initialize=0xFFF8F8F2, CanChange=True
    "syn_property": Initialize=0xFFFFB86C, CanChange=True
}

// =============================================================================
// INIT — load overrides from UIConfig (already parsed from ui.cfg)
// Falls back to Initialize defaults for any missing keys.
// =============================================================================
Function.UITheme_Init {
    Body: {
        Theme.desktop_bg       = UIConfig_GetInt("desktop_bg",       Theme.desktop_bg)
        Theme.window_bg        = UIConfig_GetInt("window_bg",        Theme.window_bg)
        Theme.dialog_bg        = UIConfig_GetInt("dialog_bg",        Theme.dialog_bg)
        Theme.panel_bg         = UIConfig_GetInt("panel_bg",         Theme.panel_bg)
        Theme.terminal_bg      = UIConfig_GetInt("terminal_bg",      Theme.terminal_bg)
        Theme.border           = UIConfig_GetInt("border",           Theme.border)

        Theme.text_fg          = UIConfig_GetInt("text_fg",          Theme.text_fg)
        Theme.text_bg          = UIConfig_GetInt("text_bg",          Theme.text_bg)
        Theme.text_secondary   = UIConfig_GetInt("text_secondary",   Theme.text_secondary)
        Theme.text_disabled    = UIConfig_GetInt("text_disabled",    Theme.text_disabled)
        Theme.text_light       = UIConfig_GetInt("text_light",       Theme.text_light)

        Theme.toolbar_bg       = UIConfig_GetInt("toolbar_bg",       Theme.toolbar_bg)
        Theme.toolbar_close_bg = UIConfig_GetInt("toolbar_close_bg", Theme.toolbar_close_bg)
        Theme.toolbar_close_fg = UIConfig_GetInt("toolbar_close_fg", Theme.toolbar_close_fg)
        Theme.toolbar_min_bg   = UIConfig_GetInt("toolbar_min_bg",   Theme.toolbar_min_bg)
        Theme.toolbar_max_bg   = UIConfig_GetInt("toolbar_max_bg",   Theme.toolbar_max_bg)

        Theme.deskbar_bg       = UIConfig_GetInt("deskbar_bg",       Theme.deskbar_bg)
        Theme.deskbar_btn_bg   = UIConfig_GetInt("deskbar_btn_bg",   Theme.deskbar_btn_bg)
        Theme.deskbar_btn_fg   = UIConfig_GetInt("deskbar_btn_fg",   Theme.deskbar_btn_fg)
        Theme.deskbar_btn2_bg  = UIConfig_GetInt("deskbar_btn2_bg",  Theme.deskbar_btn2_bg)
        Theme.deskbar_btn2_fg  = UIConfig_GetInt("deskbar_btn2_fg",  Theme.deskbar_btn2_fg)
        Theme.deskbar_hot_fg   = UIConfig_GetInt("deskbar_hot_fg",   Theme.deskbar_hot_fg)
        Theme.deskbar_hot_bg   = UIConfig_GetInt("deskbar_hot_bg",   Theme.deskbar_hot_bg)
        Theme.deskbar_win_bg   = UIConfig_GetInt("deskbar_win_bg",   Theme.deskbar_win_bg)
        Theme.deskbar_win_fg   = UIConfig_GetInt("deskbar_win_fg",   Theme.deskbar_win_fg)
        Theme.deskbar_win_act_bg = UIConfig_GetInt("deskbar_win_act_bg", Theme.deskbar_win_act_bg)
        Theme.deskbar_sep      = UIConfig_GetInt("deskbar_sep",      Theme.deskbar_sep)

        Theme.tabbar_bg        = UIConfig_GetInt("tabbar_bg",        Theme.tabbar_bg)
        Theme.tab_active_bg    = UIConfig_GetInt("tab_active_bg",    Theme.tab_active_bg)
        Theme.tab_icon         = UIConfig_GetInt("tab_icon",         Theme.tab_icon)
        Theme.tab_text         = UIConfig_GetInt("tab_text",         Theme.tab_text)

        Theme.menu_bg          = UIConfig_GetInt("menu_bg",          Theme.menu_bg)
        Theme.menu_fg          = UIConfig_GetInt("menu_fg",          Theme.menu_fg)
        Theme.menu_sep         = UIConfig_GetInt("menu_sep",         Theme.menu_sep)
        Theme.menu_border      = UIConfig_GetInt("menu_border",      Theme.menu_border)

        Theme.ak_sep           = UIConfig_GetInt("ak_sep",           Theme.ak_sep)
        Theme.ak_btn_bg        = UIConfig_GetInt("ak_btn_bg",        Theme.ak_btn_bg)
        Theme.ak_btn_fg        = UIConfig_GetInt("ak_btn_fg",        Theme.ak_btn_fg)
        Theme.ak_btn_border    = UIConfig_GetInt("ak_btn_border",    Theme.ak_btn_border)
        Theme.ak_btn_hover     = UIConfig_GetInt("ak_btn_hover",     Theme.ak_btn_hover)
        Theme.ak_btn_pressed   = UIConfig_GetInt("ak_btn_pressed",   Theme.ak_btn_pressed)

        Theme.fd_path_text     = UIConfig_GetInt("fd_path_text",     Theme.fd_path_text)
        Theme.fd_list_bg       = UIConfig_GetInt("fd_list_bg",       Theme.fd_list_bg)
        Theme.fd_list_border   = UIConfig_GetInt("fd_list_border",   Theme.fd_list_border)
        Theme.fd_sep           = UIConfig_GetInt("fd_sep",           Theme.fd_sep)
        Theme.fd_dir_text      = UIConfig_GetInt("fd_dir_text",      Theme.fd_dir_text)
        Theme.fd_file_text     = UIConfig_GetInt("fd_file_text",     Theme.fd_file_text)
        Theme.fd_empty_text    = UIConfig_GetInt("fd_empty_text",    Theme.fd_empty_text)
        Theme.fd_sel_bg        = UIConfig_GetInt("fd_sel_bg",        Theme.fd_sel_bg)
        Theme.fd_sel_fg        = UIConfig_GetInt("fd_sel_fg",        Theme.fd_sel_fg)

        Theme.page_bg          = UIConfig_GetInt("page_bg",          Theme.page_bg)

        Theme.debug_bg         = UIConfig_GetInt("debug_bg",         Theme.debug_bg)
        Theme.debug_text_color = UIConfig_GetInt("debug_text_color", Theme.debug_text_color)
        Theme.header_color     = UIConfig_GetInt("header_color",     Theme.header_color)

        Theme.ak_checkbox_box_bg      = UIConfig_GetInt("ak_checkbox_box_bg",      Theme.ak_checkbox_box_bg)
        Theme.ak_checkmark_color      = UIConfig_GetInt("ak_checkmark_color",      Theme.ak_checkmark_color)
        Theme.ak_gutter_bg            = UIConfig_GetInt("ak_gutter_bg",            Theme.ak_gutter_bg)
        Theme.ak_current_line_bg      = UIConfig_GetInt("ak_current_line_bg",      Theme.ak_current_line_bg)
        Theme.ak_linenum_color        = UIConfig_GetInt("ak_linenum_color",        Theme.ak_linenum_color)
        Theme.ak_linenum_active_color = UIConfig_GetInt("ak_linenum_active_color", Theme.ak_linenum_active_color)
        Theme.ak_cursor_color         = UIConfig_GetInt("ak_cursor_color",         Theme.ak_cursor_color)

        Theme.ak_input_bg             = UIConfig_GetInt("ak_input_bg",             Theme.ak_input_bg)
        Theme.ak_input_border         = UIConfig_GetInt("ak_input_border",         Theme.ak_input_border)
        Theme.ak_input_focus_border   = UIConfig_GetInt("ak_input_focus_border",   Theme.ak_input_focus_border)
        Theme.ak_input_placeholder    = UIConfig_GetInt("ak_input_placeholder",    Theme.ak_input_placeholder)

        Theme.deskbar_hotzone_color_a = UIConfig_GetInt("deskbar_hotzone_color_a", Theme.deskbar_hotzone_color_a)
        Theme.deskbar_hotzone_color_b = UIConfig_GetInt("deskbar_hotzone_color_b", Theme.deskbar_hotzone_color_b)

        Theme.syn_default  = UIConfig_GetInt("syn_default",  Theme.syn_default)
        Theme.syn_keyword  = UIConfig_GetInt("syn_keyword",  Theme.syn_keyword)
        Theme.syn_builtin  = UIConfig_GetInt("syn_builtin",  Theme.syn_builtin)
        Theme.syn_string   = UIConfig_GetInt("syn_string",   Theme.syn_string)
        Theme.syn_number   = UIConfig_GetInt("syn_number",   Theme.syn_number)
        Theme.syn_comment  = UIConfig_GetInt("syn_comment",  Theme.syn_comment)
        Theme.syn_type     = UIConfig_GetInt("syn_type",     Theme.syn_type)
        Theme.syn_punct    = UIConfig_GetInt("syn_punct",    Theme.syn_punct)
        Theme.syn_property = UIConfig_GetInt("syn_property", Theme.syn_property)

        PrintMessage("[UITheme] initialized\n")
        ReturnValue(0)
    }
}

// =============================================================================
// LOAD FROM DB — query active theme from settings, load theme_values,
// inject into UIConfig table. Call before UITheme_Init() to apply DB overrides.
// =============================================================================
Function.UITheme_LoadFromDB {
    Input: conn: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(conn, 0) ThenBlock: { ReturnValue(0) }

        // 1. Get active theme name from settings
        tr = PG_Query(conn, "SELECT value FROM settings WHERE app_id='system' AND key='theme'")
        IfCondition EqualTo(tr, 0) ThenBlock: {
            PrintMessage("[UITheme] no theme setting, using defaults\n")
            ReturnValue(0)
        }
        trc = Array.Size(tr)
        IfCondition EqualTo(trc, 0) ThenBlock: {
            PG_DestroyResult(tr)
            PrintMessage("[UITheme] no theme setting row\n")
            ReturnValue(0)
        }
        trow = Array.Get(tr, 0)
        theme_name = Hash.Get(trow, "value")
        IfCondition EqualTo(theme_name, 0) ThenBlock: {
            PG_DestroyResult(tr)
            ReturnValue(0)
        }

        PrintMessage("[UITheme] active theme: ")
        PrintString(theme_name)
        PrintMessage("\n")

        // 2. Build query: SELECT key, value FROM theme_values WHERE theme_name='...'
        // We use a dispatch approach based on known theme names to avoid string concat
        qr = UITheme_QueryTheme(conn, theme_name)
        PG_DestroyResult(tr)

        IfCondition EqualTo(qr, 0) ThenBlock: {
            PrintMessage("[UITheme] no theme_values found\n")
            ReturnValue(0)
        }

        // 3. Iterate rows, inject each key/value into UIConfig
        rc = Array.Size(qr)
        applied = 0
        i = 0
        WhileLoop LessThan(i, rc) {
            row = Array.Get(qr, i)
            k = Hash.Get(row, "key")
            v = Hash.Get(row, "value")
            IfCondition And(NotEqual(k, 0), NotEqual(v, 0)) ThenBlock: {
                int_val = UIConfig_ParseInt(v)
                UIConfig_Store(k, int_val)
                applied = Add(applied, 1)
            }
            i = Add(i, 1)
        }
        PG_DestroyResult(qr)

        PrintMessage("[UITheme] applied ")
        PrintNumber(applied)
        PrintMessage(" theme overrides from DB\n")
        ReturnValue(applied)
    }
}

// =============================================================================
// QUERY THEME — dispatch to SQL query based on known theme name
// Returns PG result or 0. Caller must PG_DestroyResult.
// =============================================================================
Function.UITheme_QueryTheme {
    Input: conn: Address
    Input: name: Address
    Output: Address
    Body: {
        // Check known theme names
        IfCondition EqualTo(StringCompare(name, "dark"), 0) ThenBlock: {
            ReturnValue(PG_Query(conn, "SELECT key, value FROM theme_values WHERE theme_name='dark'"))
        }
        IfCondition EqualTo(StringCompare(name, "light"), 0) ThenBlock: {
            ReturnValue(PG_Query(conn, "SELECT key, value FROM theme_values WHERE theme_name='light'"))
        }
        IfCondition EqualTo(StringCompare(name, "retro"), 0) ThenBlock: {
            ReturnValue(PG_Query(conn, "SELECT key, value FROM theme_values WHERE theme_name='retro'"))
        }
        IfCondition EqualTo(StringCompare(name, "highcontrast"), 0) ThenBlock: {
            ReturnValue(PG_Query(conn, "SELECT key, value FROM theme_values WHERE theme_name='highcontrast'"))
        }
        // Unknown theme — try dark as fallback
        PrintMessage("[UITheme] unknown theme, falling back to dark\n")
        ReturnValue(PG_Query(conn, "SELECT key, value FROM theme_values WHERE theme_name='dark'"))
    }
}

// =============================================================================
// SWITCH TO — runtime theme change. Reloads config baseline, loads new theme
// from DB, re-applies all init functions, persists choice, triggers full redraw.
// =============================================================================
Function.UITheme_SwitchTo {
    Input: conn: Address
    Input: theme_name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(conn, 0) ThenBlock: { ReturnValue(0) }

        PrintMessage("[UITheme] switching to: ")
        PrintString(theme_name)
        PrintMessage("\n")

        // 1. Reload ui.cfg baseline (resets UIConfig table to file defaults)
        UIConfig_Load("/system/config/ui.cfg")

        // 2. Load DB theme values (overwrites UIConfig entries)
        qr = UITheme_QueryTheme(conn, theme_name)
        IfCondition NotEqual(qr, 0) ThenBlock: {
            rc = Array.Size(qr)
            i = 0
            WhileLoop LessThan(i, rc) {
                row = Array.Get(qr, i)
                k = Hash.Get(row, "key")
                v = Hash.Get(row, "value")
                IfCondition And(NotEqual(k, 0), NotEqual(v, 0)) ThenBlock: {
                    int_val = UIConfig_ParseInt(v)
                    UIConfig_Store(k, int_val)
                }
                i = Add(i, 1)
            }
            PG_DestroyResult(qr)
        }

        // 3. Re-apply all theme/scale init functions
        UITheme_Init()
        UIScale_Init(SysDisplayState.scr_w, SysDisplayState.scr_h)
        PaneDecorator_ScaleInit()
        PaneDecorator_ThemeInit()
        SynColor_ThemeInit()

        // 4. Persist choice in settings table
        UITheme_SaveActive(conn, theme_name)

        // 5. Trigger full UI redraw
        DeskbarState.needs_refresh = 1
        SysDisplayState.dirty = 1

        PrintMessage("[UITheme] theme switch complete\n")
        ReturnValue(1)
    }
}

// =============================================================================
// SAVE ACTIVE — persist theme name in settings table
// =============================================================================
Function.UITheme_SaveActive {
    Input: conn: Address
    Input: name: Address
    Body: {
        // Dispatch to known theme names for safe SQL
        IfCondition EqualTo(StringCompare(name, "dark"), 0) ThenBlock: {
            r = PG_Query(conn, "INSERT INTO settings VALUES ('system','theme','dark') ON CONFLICT (app_id,key) DO UPDATE SET value='dark'")
            IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }
            ReturnValue(0)
        }
        IfCondition EqualTo(StringCompare(name, "light"), 0) ThenBlock: {
            r = PG_Query(conn, "INSERT INTO settings VALUES ('system','theme','light') ON CONFLICT (app_id,key) DO UPDATE SET value='light'")
            IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }
            ReturnValue(0)
        }
        IfCondition EqualTo(StringCompare(name, "retro"), 0) ThenBlock: {
            r = PG_Query(conn, "INSERT INTO settings VALUES ('system','theme','retro') ON CONFLICT (app_id,key) DO UPDATE SET value='retro'")
            IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }
            ReturnValue(0)
        }
        IfCondition EqualTo(StringCompare(name, "highcontrast"), 0) ThenBlock: {
            r = PG_Query(conn, "INSERT INTO settings VALUES ('system','theme','highcontrast') ON CONFLICT (app_id,key) DO UPDATE SET value='highcontrast'")
            IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }
            ReturnValue(0)
        }
        ReturnValue(0)
    }
}
