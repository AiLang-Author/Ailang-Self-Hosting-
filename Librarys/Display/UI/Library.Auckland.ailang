// =============================================================================
// AKContext — replaces AKTree + AKExtraTable + AKEvent globals
// Each context is a self-contained Auckland instance with its own
// node buffer, extra table, and event state.
// =============================================================================
LinkagePool.AKContext {
    "tree_data":      Initialize=0
    "tree_count":     Initialize=0
    "tree_root":      Initialize=-1
    "scale_num":      Initialize=1
    "scale_den":      Initialize=1
    "design_w":       Initialize=320
    "design_h":       Initialize=480
    "canvas":         Initialize=0
    "extra_data":     Initialize=0
    "extra_count":    Initialize=0
    "hover_node":     Initialize=-1
    "pressed_node":   Initialize=-1
    "focus_node":     Initialize=-1
    "dirty_count":    Initialize=0
    "action_cb":      Initialize=0
    "toolbar_mode":   Initialize=1
    "addressbar":     Initialize=0
    "clip_x":         Initialize=0
    "clip_y":         Initialize=0
    "clip_w":         Initialize=9999
    "clip_h":         Initialize=9999
    "clip_stack":     Initialize=0
    "clip_depth":     Initialize=0
    "last_add_parent":Initialize=-1
    "last_add_child": Initialize=-1
    "scroll_offset_y":Initialize=0
    "scroll_offset_x":Initialize=0
    "scroll_grab_node":Initialize=-1
    "scroll_grab_axis":Initialize=0
    "scroll_grab_offset":Initialize=0
}

// Toolbar mode constants
FixedPool.TBMode {
    "NONE":     Initialize=0
    "ABOUT":    Initialize=1
    "FILE":     Initialize=2
    "FULL":     Initialize=3
    "BROWSER":  Initialize=4
}


// =============================================================================
// TAG TYPES
// =============================================================================
FixedPool.AKTag {
    "NONE":       Initialize=0
    "WINDOW":     Initialize=1
    "GROUP":      Initialize=2
    "PANEL":      Initialize=3
    "SCROLL":     Initialize=4
    "TABS":       Initialize=5
    "TAB":        Initialize=6
    "BUTTON":     Initialize=10
    "LABEL":      Initialize=11
    "TEXT":       Initialize=12
    "DISPLAY":    Initialize=13
    "CHECKBOX":   Initialize=14
    "RADIO":      Initialize=15
    "SLIDER":     Initialize=16
    "PROGRESS":   Initialize=17
    "IMAGE":      Initialize=18
    "CANVAS":     Initialize=19
    "SPACER":     Initialize=20
    "SEPARATOR":  Initialize=21
    "TEXTFIELD":  Initialize=22
    "INPUT":      Initialize=23
    "THEME":      Initialize=30
}

// =============================================================================
// LAYOUT MODES
// =============================================================================
FixedPool.AKLayout {
    "VBOX":  Initialize=0
    "HBOX":  Initialize=1
    "GRID":  Initialize=2
    "FLOW":  Initialize=3
}

// =============================================================================
// ALIGNMENT
// =============================================================================
FixedPool.AKAlign {
    "START":    Initialize=0
    "CENTER":   Initialize=1
    "END":      Initialize=2
    "STRETCH":  Initialize=3
}

// =============================================================================
// JUSTIFICATION
// =============================================================================
FixedPool.AKJustify {
    "START":         Initialize=0
    "CENTER":        Initialize=1
    "END":           Initialize=2
    "SPACE_BETWEEN": Initialize=3
    "SPACE_AROUND":  Initialize=4
}

// =============================================================================
// WIDGET STATES
// =============================================================================
FixedPool.AKState {
    "NORMAL":   Initialize=0
    "HOVER":    Initialize=1
    "PRESSED":  Initialize=2
    "DISABLED": Initialize=3
    "CHECKED":  Initialize=4
}

// =============================================================================
// NODE STRUCTURE — 256 bytes per node
// =============================================================================
FixedPool.AKNodeConst {
    "MAX_NODES":   Initialize=512
    "ENTRY_SIZE":  Initialize=256
}

// Field offsets within a node
FixedPool.AKF {
    // Identity — 0..23
    "TAG":            Initialize=0
    "ID_HASH":        Initialize=8
    "FLAGS":          Initialize=16

    // Tree links — 24..55
    "PARENT":         Initialize=24
    "FIRST_CHILD":    Initialize=32
    "NEXT_SIBLING":   Initialize=40
    "CHILD_COUNT":    Initialize=48

    // Layout input — 56..103
    "LAYOUT_MODE":    Initialize=56
    "COLS":           Initialize=64
    "GAP":            Initialize=72
    "PAD_T":          Initialize=80
    "PAD_R":          Initialize=88
    "PAD_B":          Initialize=96
    "PAD_L":          Initialize=104

    // Alignment — 112..119
    "ALIGN":          Initialize=112
    "JUSTIFY":        Initialize=120

    // Sizing input — 128..183
    "WIDTH":          Initialize=128
    "HEIGHT":         Initialize=136
    "MIN_W":          Initialize=144
    "MIN_H":          Initialize=152
    "MAX_W":          Initialize=160
    "MAX_H":          Initialize=168
    "GROW":           Initialize=176
    "SHRINK":         Initialize=184

    // Solved output — 192..223
    "SOLVED_X":       Initialize=192
    "SOLVED_Y":       Initialize=200
    "SOLVED_W":       Initialize=208
    "SOLVED_H":       Initialize=216

    // Render state — 224..239
    "DIRTY":          Initialize=224
    "VISIBLE":        Initialize=232
    "STATE":          Initialize=240

    // Extra data pointer — 248
    "EXTRA":          Initialize=248
}

// Flags
FixedPool.AKFlags {
    "ENABLED":    Initialize=1
    "HAS_BG":     Initialize=2
    "HAS_BORDER": Initialize=4
}

// Input-specific flags (stored in AKExtra.ROWS for INPUT tag)
FixedPool.AKInputFlags {
    "PASSWORD":  Initialize=1
    "READONLY":  Initialize=2
}

// =============================================================================
// EXTRA DATA — per-tag-type additional fields
// Each extra block is 192 bytes
// =============================================================================
FixedPool.AKExtraConst {
    "MAX":         Initialize=512
    "ENTRY_SIZE":  Initialize=200
}

// Extra field offsets — shared across types, meaning varies by tag
FixedPool.AKExtra {
    "COLOR_FG":    Initialize=0
    "COLOR_BG":    Initialize=8
    "BORDER_CLR":  Initialize=16
    "BORDER_W":    Initialize=24
    "FONT_SIZE":   Initialize=32
    "TEXT_ALIGN":  Initialize=40
    "LINE_SPACE":  Initialize=48
    "STR_PTR":     Initialize=56
    "STR_LEN":     Initialize=64
    "ACTION_PTR":  Initialize=72
    "ACTION_LEN":  Initialize=80
    "TR_HANDLE":   Initialize=88
    "VALUE":       Initialize=96
    "ROWS":        Initialize=104
    "BORDER_RAD":  Initialize=112
    "TEXTBUF_H":   Initialize=120
    "SCROLL_Y":    Initialize=128
    "SYNTAX_MODE": Initialize=136
    "LINE_NUMBERS":Initialize=144
    "GUTTER_W":    Initialize=152
    "SCROLL_X":    Initialize=160
    "SEL_START_ROW":Initialize=168
    "SEL_START_COL":Initialize=176
    "SEL_END_ROW": Initialize=184
    "ICON_SURF":   Initialize=192
}


// =============================================================================
// AK_CreateContext — allocate a new AKContext with its own node + extra buffers
// Returns context handle, or 0 on failure.
// =============================================================================
Function.AK_CreateContext {
    Output: Integer
    Body: {
        DebugLog_Push("ak.cctx", 7)

        // Allocate node table
        nsz = Multiply(AKNodeConst.MAX_NODES, AKNodeConst.ENTRY_SIZE)
        DebugLog_Push("ak.cctx1", 8)
        nb = Allocate(nsz)
        IfCondition EqualTo(nb, 0) ThenBlock: {
            PrintMessage("[AK] node alloc fail\n")
            ReturnValue(0)
        }
        ni = 0
        WhileLoop LessThan(ni, nsz) { SetByte(nb, ni, 0)  ni = Add(ni, 1) }

        // Allocate extra table
        esz = Multiply(AKExtraConst.MAX, AKExtraConst.ENTRY_SIZE)
        DebugLog_Push("ak.cctx2", 8)
        eb = Allocate(esz)
        IfCondition EqualTo(eb, 0) ThenBlock: {
            Deallocate(nb, nsz)
            PrintMessage("[AK] extra alloc fail\n")
            ReturnValue(0)
        }
        ei = 0
        WhileLoop LessThan(ei, esz) { SetByte(eb, ei, 0)  ei = Add(ei, 1) }

        // Allocate the context handle
        ctx = AllocateLinkage(LinkagePool.AKContext)

        // Store buffer pointers
        ctx@tree_data  = nb
        ctx@extra_data = eb

        PrintMessage("[AK] context created\n")
        ReturnValue(ctx)
    }
}

// =============================================================================
// AK_FreeContextTR — return all TR_HANDLEs in a context's extras to the pool
// Must be called BEFORE zeroing the extra buffer.
// =============================================================================
Function.AK_FreeContextTR {
    Input: ctx: LinkagePool.AKContext
    Body: {
        ec = ctx@extra_count
        eb = ctx@extra_data
        IfCondition EqualTo(eb, 0) ThenBlock: { ReturnValue(0) }
        ei = 0
        WhileLoop LessThan(ei, ec) {
            eoff = Multiply(ei, AKExtraConst.ENTRY_SIZE)
            ep = Add(eb, eoff)
            tr = Dereference(Add(ep, AKExtra.TR_HANDLE))
            IfCondition GreaterEqual(tr, 0) ThenBlock: {
                TextRegion_Free(tr)
            }
            ei = Add(ei, 1)
        }
        ReturnValue(0)
    }
}

// =============================================================================
// AK_DestroyContext — free buffers and the context handle
// =============================================================================
Function.AK_DestroyContext {
    Input: ctx: LinkagePool.AKContext
    Body: {
        DebugLog_Push("ak.dctx", 7)
        IfCondition EqualTo(ctx, 0) ThenBlock: { ReturnValue(0) }

        // Free TextRegion handles before destroying buffers
        AK_FreeContextTR(ctx)

        nb = ctx@tree_data
        IfCondition NotEqual(nb, 0) ThenBlock: {
            nsz = Multiply(AKNodeConst.MAX_NODES, AKNodeConst.ENTRY_SIZE)
            Deallocate(nb, nsz)
        }

        eb = ctx@extra_data
        IfCondition NotEqual(eb, 0) ThenBlock: {
            esz = Multiply(AKExtraConst.MAX, AKExtraConst.ENTRY_SIZE)
            Deallocate(eb, esz)
        }

        FreeLinkage(ctx, LinkagePool.AKContext)
        PrintMessage("[AK] context destroyed\n")
        ReturnValue(0)
    }
}

// =============================================================================
// AK_ResetContext — zero buffers and reset state without dealloc/realloc.
// Used by Deskbar to rebuild its tree on window list changes.
// =============================================================================
Function.AK_ResetContext {
    Input: ctx: LinkagePool.AKContext
    Body: {
        DebugLog_Push("ak.rctx", 7)
        IfCondition EqualTo(ctx, 0) ThenBlock: { ReturnValue(0) }

        // Free TextRegion handles before zeroing buffers
        AK_FreeContextTR(ctx)

        // Zero node buffer
        nb = ctx@tree_data
        nsz = Multiply(AKNodeConst.MAX_NODES, AKNodeConst.ENTRY_SIZE)
        MemorySet(nb, 0, nsz)

        // Zero extra buffer
        eb = ctx@extra_data
        esz = Multiply(AKExtraConst.MAX, AKExtraConst.ENTRY_SIZE)
        MemorySet(eb, 0, esz)

        // Reset counters and state
        ctx@tree_count   = 0
        ctx@tree_root    = -1
        ctx@extra_count  = 0
        ctx@hover_node   = -1
        ctx@pressed_node = -1
        ctx@focus_node   = -1
        ctx@dirty_count  = 0

        ReturnValue(0)
    }
}

// =============================================================================
// CONTEXT FIELD ACCESSORS — for callers that retrieve ctx from storage
// (FixedPool fields, Dereference returns, etc.) where the compiler cannot
// track the LinkagePool type.  These accept ctx as a typed parameter so
// the @ operator resolves correctly.
// =============================================================================
Function.AK_GetActionCb    { Input: ctx: LinkagePool.AKContext  Output: Integer  Body: { ReturnValue(ctx@action_cb) } }
Function.AK_SetActionCb    { Input: ctx: LinkagePool.AKContext  Input: v: Integer  Body: { ctx@action_cb = v } }
Function.AK_GetToolbarMode { Input: ctx: LinkagePool.AKContext  Output: Integer  Body: { ReturnValue(ctx@toolbar_mode) } }
Function.AK_SetToolbarMode { Input: ctx: LinkagePool.AKContext  Input: v: Integer  Body: { ctx@toolbar_mode = v } }
Function.AK_GetAddressBar  { Input: ctx: LinkagePool.AKContext  Output: Integer  Body: { ReturnValue(ctx@addressbar) } }
Function.AK_SetAddressBar  { Input: ctx: LinkagePool.AKContext  Input: v: Integer  Body: { ctx@addressbar = v } }
Function.AK_GetDirtyCount  { Input: ctx: LinkagePool.AKContext  Output: Integer  Body: { ReturnValue(ctx@dirty_count) } }
Function.AK_SetDirtyCount  { Input: ctx: LinkagePool.AKContext  Input: v: Integer  Body: { ctx@dirty_count = v } }
Function.AK_GetFocusNode   { Input: ctx: LinkagePool.AKContext  Output: Integer  Body: { ReturnValue(ctx@focus_node) } }
Function.AK_SetFocusNode   { Input: ctx: LinkagePool.AKContext  Input: v: Integer  Body: { ctx@focus_node = v } }
Function.AK_GetDesignW     { Input: ctx: LinkagePool.AKContext  Output: Integer  Body: { ReturnValue(ctx@design_w) } }
Function.AK_SetDesignW     { Input: ctx: LinkagePool.AKContext  Input: v: Integer  Body: { ctx@design_w = v } }
Function.AK_GetDesignH     { Input: ctx: LinkagePool.AKContext  Output: Integer  Body: { ReturnValue(ctx@design_h) } }
Function.AK_SetDesignH     { Input: ctx: LinkagePool.AKContext  Input: v: Integer  Body: { ctx@design_h = v } }
Function.AK_GetTreeData    { Input: ctx: LinkagePool.AKContext  Output: Integer  Body: { ReturnValue(ctx@tree_data) } }
Function.AK_GetTreeCount   { Input: ctx: LinkagePool.AKContext  Output: Integer  Body: { ReturnValue(ctx@tree_count) } }
Function.AK_GetTreeRoot    { Input: ctx: LinkagePool.AKContext  Output: Integer  Body: { ReturnValue(ctx@tree_root) } }

// =============================================================================
// NODE POINTER
// =============================================================================
Function.AK_Ptr {
    Input:  ctx: LinkagePool.AKContext
    Input:  idx: Integer
    Output: Integer
    Body: {
        DebugLog_Push("ak.ptr", 6)
        off = Multiply(idx, AKNodeConst.ENTRY_SIZE)
        ReturnValue(Add(ctx@tree_data, off))
    }
}

// =============================================================================
// EXTRA POINTER
// =============================================================================
Function.AK_ExtraPtr {
    Input:  ctx: LinkagePool.AKContext
    Input:  idx: Integer
    Output: Integer
    Body: {
        DebugLog_Push("ak.xpt", 6)
        off = Multiply(idx, AKExtraConst.ENTRY_SIZE)
        ReturnValue(Add(ctx@extra_data, off))
    }
}

// =============================================================================
// NODE GET/SET HELPERS
// =============================================================================
Function.AK_Get {
    Input: ctx: LinkagePool.AKContext
    Input: node: Integer
    Input: field: Integer
    Output: Integer
    Body: {
        DebugLog_Push("ak.get", 6)
        p = AK_Ptr(ctx, node)
        ReturnValue(Dereference(Add(p, field)))
    }
}

Function.AK_Set {
    Input: ctx: LinkagePool.AKContext
    Input: node: Integer
    Input: field: Integer
    Input: val: Integer
    Body: {
        DebugLog_Push("ak.set", 6)
        p = AK_Ptr(ctx, node)
        StoreValue(Add(p, field), val)
        ReturnValue(0)
    }
}

// =============================================================================
// EXTRA GET/SET HELPERS
// =============================================================================
Function.AK_ExtraGet {
    Input: ctx: LinkagePool.AKContext
    Input: node: Integer
    Input: field: Integer
    Output: Integer
    Body: {
        DebugLog_Push("ak.xg", 5)
        ext_idx = AK_Get(ctx, node, AKF.EXTRA)
        IfCondition LessThan(ext_idx, 0) ThenBlock: { ReturnValue(0) }
        ep = AK_ExtraPtr(ctx, ext_idx)
        ReturnValue(Dereference(Add(ep, field)))
    }
}

Function.AK_ExtraSet {
    Input: ctx: LinkagePool.AKContext
    Input: node: Integer
    Input: field: Integer
    Input: val: Integer
    Body: {
        DebugLog_Push("ak.xs", 5)
        ext_idx = AK_Get(ctx, node, AKF.EXTRA)
        IfCondition LessThan(ext_idx, 0) ThenBlock: { ReturnValue(0) }
        ep = AK_ExtraPtr(ctx, ext_idx)
        StoreValue(Add(ep, field), val)
        ReturnValue(0)
    }
}

// =============================================================================
// ALLOCATE EXTRA — creates extra data block for a node
// =============================================================================
Function.AK_AllocExtra {
    Input: ctx: LinkagePool.AKContext
    Input: node: Integer
    Output: Integer
    Body: {
        DebugLog_Push("ak.ae", 5)
        idx = ctx@extra_count
        IfCondition GreaterEqual(idx, AKExtraConst.MAX) ThenBlock: {
            PrintMessage("[AK] extra full\n")
            ReturnValue(-1)
        }
        ctx@extra_count = Add(idx, 1)
        AK_Set(ctx, node, AKF.EXTRA, idx)
        ep = AK_ExtraPtr(ctx, idx)
        StoreValue(Add(ep, AKExtra.TR_HANDLE), -1)
        ReturnValue(idx)
    }
}

// =============================================================================
// CREATE NODE — allocate a node, set tag type, defaults
// =============================================================================
Function.AK_CreateNode {
    Input: ctx: LinkagePool.AKContext
    Input: tag: Integer
    Output: Integer
    Body: {
        DebugLog_Push("ak.cn", 5)
        idx = ctx@tree_count
        IfCondition GreaterEqual(idx, AKNodeConst.MAX_NODES) ThenBlock: {
            PrintMessage("[AK] node full\n")
            ReturnValue(-1)
        }
        ctx@tree_count = Add(idx, 1)

        // Set tag
        AK_Set(ctx, idx, AKF.TAG, tag)

        // Default tree links
        AK_Set(ctx, idx, AKF.PARENT, -1)
        AK_Set(ctx, idx, AKF.FIRST_CHILD, -1)
        AK_Set(ctx, idx, AKF.NEXT_SIBLING, -1)
        AK_Set(ctx, idx, AKF.CHILD_COUNT, 0)

        // Default layout
        AK_Set(ctx, idx, AKF.LAYOUT_MODE, AKLayout.VBOX)
        AK_Set(ctx, idx, AKF.COLS, 1)
        AK_Set(ctx, idx, AKF.GAP, 0)
        AK_Set(ctx, idx, AKF.PAD_T, 0)
        AK_Set(ctx, idx, AKF.PAD_R, 0)
        AK_Set(ctx, idx, AKF.PAD_B, 0)
        AK_Set(ctx, idx, AKF.PAD_L, 0)
        AK_Set(ctx, idx, AKF.ALIGN, AKAlign.STRETCH)
        AK_Set(ctx, idx, AKF.JUSTIFY, AKJustify.START)

        // Default sizing — 0 = auto
        AK_Set(ctx, idx, AKF.WIDTH, 0)
        AK_Set(ctx, idx, AKF.HEIGHT, 0)
        AK_Set(ctx, idx, AKF.MIN_W, 0)
        AK_Set(ctx, idx, AKF.MIN_H, 0)
        AK_Set(ctx, idx, AKF.MAX_W, 0)
        AK_Set(ctx, idx, AKF.MAX_H, 0)
        AK_Set(ctx, idx, AKF.GROW, 0)
        AK_Set(ctx, idx, AKF.SHRINK, 1)

        // Solved = 0
        AK_Set(ctx, idx, AKF.SOLVED_X, 0)
        AK_Set(ctx, idx, AKF.SOLVED_Y, 0)
        AK_Set(ctx, idx, AKF.SOLVED_W, 0)
        AK_Set(ctx, idx, AKF.SOLVED_H, 0)

        // State
        AK_Set(ctx, idx, AKF.DIRTY, 1)
        AK_Set(ctx, idx, AKF.VISIBLE, 1)
        AK_Set(ctx, idx, AKF.STATE, AKState.NORMAL)
        AK_Set(ctx, idx, AKF.FLAGS, AKFlags.ENABLED)
        AK_Set(ctx, idx, AKF.EXTRA, -1)

        // Allocate extra for tags that need it
        needs_extra = 0
        IfCondition GreaterEqual(tag, AKTag.BUTTON) ThenBlock: { needs_extra = 1 }
        IfCondition EqualTo(tag, AKTag.PANEL) ThenBlock: { needs_extra = 1 }
        IfCondition EqualTo(tag, AKTag.WINDOW) ThenBlock: { needs_extra = 1 }
        IfCondition EqualTo(tag, AKTag.GROUP) ThenBlock: { needs_extra = 1 }
        IfCondition EqualTo(tag, AKTag.SCROLL) ThenBlock: { needs_extra = 1 }
        IfCondition EqualTo(tag, AKTag.TABS) ThenBlock: { needs_extra = 1 }
        IfCondition EqualTo(tag, AKTag.TAB) ThenBlock: { needs_extra = 1 }
        IfCondition EqualTo(needs_extra, 1) ThenBlock: {
            AK_AllocExtra(ctx, idx)
        }

        ReturnValue(idx)
    }
}

// =============================================================================
// ADD CHILD — append child to parent's child list
// =============================================================================
Function.AK_AddChild {
    Input: ctx: LinkagePool.AKContext
    Input: parent: Integer
    Input: child: Integer
    Body: {
        DebugLog_Push("ak.adc", 6)
        AK_Set(ctx, child, AKF.PARENT, parent)
        fc = AK_Get(ctx, parent, AKF.FIRST_CHILD)

        // No children yet — child becomes first
        IfCondition EqualTo(fc, -1) ThenBlock: {
            AK_Set(ctx, parent, AKF.FIRST_CHILD, child)
        }
        // Has children — fast path: use cached last child
        IfCondition NotEqual(fc, -1) ThenBlock: {
            IfCondition EqualTo(parent, ctx@last_add_parent) ThenBlock: {
                // O(1) append via cache
                AK_Set(ctx, ctx@last_add_child, AKF.NEXT_SIBLING, child)
            } ElseBlock: {
                // Slow path: walk to last sibling
                cur = fc
                ns = AK_Get(ctx, cur, AKF.NEXT_SIBLING)
                WhileLoop NotEqual(ns, -1) {
                    cur = ns
                    ns = AK_Get(ctx, cur, AKF.NEXT_SIBLING)
                }
                AK_Set(ctx, cur, AKF.NEXT_SIBLING, child)
            }
        }
        // Update cache
        ctx@last_add_parent = parent
        ctx@last_add_child = child

        cc = AK_Get(ctx, parent, AKF.CHILD_COUNT)
        AK_Set(ctx, parent, AKF.CHILD_COUNT, Add(cc, 1))
        ReturnValue(0)
    }
}

// =============================================================================
// SET ROOT
// =============================================================================
Function.AK_SetRoot {
    Input: ctx: LinkagePool.AKContext
    Input: node: Integer
    Body: {
        DebugLog_Push("ak.str", 6)
        ctx@tree_root = node
        ReturnValue(0)
    }
}

// =============================================================================
// CLIP RECT — push/pop/intersect for hierarchical clipping
// =============================================================================

// Allocate the clip stack on first use (8 levels × 4 values × 8 bytes = 256 bytes)
Function.AK_ClipInit {
    Input: ctx: LinkagePool.AKContext
    Body: {
        IfCondition EqualTo(ctx@clip_stack, 0) ThenBlock: {
            ctx@clip_stack = Allocate(256)
            MemorySet(ctx@clip_stack, 0, 256)
        }
        ctx@clip_depth = 0
    }
}

// Push current clip rect onto stack, then intersect with new bounds
Function.AK_ClipPush {
    Input: ctx: LinkagePool.AKContext
    Input: x: Integer
    Input: y: Integer
    Input: w: Integer
    Input: h: Integer
    Body: {
        depth = ctx@clip_depth
        IfCondition GreaterEqual(depth, 8) ThenBlock: { ReturnValue(0) }

        // Save current clip rect onto stack
        stk = ctx@clip_stack
        ofs = Multiply(depth, 32)
        StoreValue(Add(stk, ofs), ctx@clip_x)
        StoreValue(Add(stk, Add(ofs, 8)), ctx@clip_y)
        StoreValue(Add(stk, Add(ofs, 16)), ctx@clip_w)
        StoreValue(Add(stk, Add(ofs, 24)), ctx@clip_h)
        ctx@clip_depth = Add(depth, 1)

        // Intersect current clip with new rect
        cx = ctx@clip_x
        cy = ctx@clip_y
        cw = ctx@clip_w
        ch = ctx@clip_h

        // out_x = max(x, cx)
        ox = x
        IfCondition GreaterThan(cx, ox) ThenBlock: { ox = cx }
        // out_y = max(y, cy)
        oy = y
        IfCondition GreaterThan(cy, oy) ThenBlock: { oy = cy }
        // out_x2 = min(x+w, cx+cw)
        x2 = Add(x, w)
        cx2 = Add(cx, cw)
        ox2 = x2
        IfCondition LessThan(cx2, ox2) ThenBlock: { ox2 = cx2 }
        // out_y2 = min(y+h, cy+ch)
        y2 = Add(y, h)
        cy2 = Add(cy, ch)
        oy2 = y2
        IfCondition LessThan(cy2, oy2) ThenBlock: { oy2 = cy2 }

        // Compute width/height (clamp to 0)
        ow = Subtract(ox2, ox)
        oh = Subtract(oy2, oy)
        IfCondition LessThan(ow, 0) ThenBlock: { ow = 0 }
        IfCondition LessThan(oh, 0) ThenBlock: { oh = 0 }

        ctx@clip_x = ox
        ctx@clip_y = oy
        ctx@clip_w = ow
        ctx@clip_h = oh
    }
}

// Pop clip rect from stack (restore parent's clip)
Function.AK_ClipPop {
    Input: ctx: LinkagePool.AKContext
    Body: {
        depth = ctx@clip_depth
        IfCondition LessEqual(depth, 0) ThenBlock: { ReturnValue(0) }
        depth = Subtract(depth, 1)
        ctx@clip_depth = depth

        stk = ctx@clip_stack
        ofs = Multiply(depth, 32)
        ctx@clip_x = Dereference(Add(stk, ofs))
        ctx@clip_y = Dereference(Add(stk, Add(ofs, 8)))
        ctx@clip_w = Dereference(Add(stk, Add(ofs, 16)))
        ctx@clip_h = Dereference(Add(stk, Add(ofs, 24)))
    }
}

// =============================================================================
// CLIPPED DRAW — wrapper around Draw_Pix_FillRect that respects clip rect
// =============================================================================
Function.AK_FillRect {
    Input: ctx: LinkagePool.AKContext
    Input: x: Integer
    Input: y: Integer
    Input: w: Integer
    Input: h: Integer
    Input: color: Integer
    Body: {
        // Intersect with active clip rect
        cx = ctx@clip_x
        cy = ctx@clip_y
        cw = ctx@clip_w
        ch = ctx@clip_h

        // Early out if clip rect is zero
        IfCondition LessEqual(cw, 0) ThenBlock: { ReturnValue(0) }
        IfCondition LessEqual(ch, 0) ThenBlock: { ReturnValue(0) }

        // Intersect
        ox = x
        IfCondition GreaterThan(cx, ox) ThenBlock: { ox = cx }
        oy = y
        IfCondition GreaterThan(cy, oy) ThenBlock: { oy = cy }
        x2 = Add(x, w)
        cx2 = Add(cx, cw)
        ox2 = x2
        IfCondition LessThan(cx2, ox2) ThenBlock: { ox2 = cx2 }
        y2 = Add(y, h)
        cy2 = Add(cy, ch)
        oy2 = y2
        IfCondition LessThan(cy2, oy2) ThenBlock: { oy2 = cy2 }

        ow = Subtract(ox2, ox)
        oh = Subtract(oy2, oy)
        IfCondition LessEqual(ow, 0) ThenBlock: { ReturnValue(0) }
        IfCondition LessEqual(oh, 0) ThenBlock: { ReturnValue(0) }

        canvas = ctx@canvas
        Draw_Pix_FillRect(canvas, ox, oy, ow, oh, color)
    }
}

// =============================================================================
// SCALE — apply scale factor to a logical unit value
// result = val * scale_num / scale_den
// =============================================================================
Function.AK_Scale {
    Input: ctx: LinkagePool.AKContext
    Input: val: Integer
    Output: Integer
    Body: {
        DebugLog_Push("ak.scl", 6)
        sn = ctx@scale_num
        sd = ctx@scale_den
        IfCondition EqualTo(sd, 0) ThenBlock: { ReturnValue(val) }
        num = Multiply(val, sn)
        ReturnValue(Divide(num, sd))
    }
}

// =============================================================================
// COMPUTE SCALE — from current canvas size vs design size
// =============================================================================
Function.AK_ComputeScale {
    Input: ctx: LinkagePool.AKContext
    Input: canvas_w: Integer
    Input: canvas_h: Integer
    Body: {
        DebugLog_Push("ak.csc", 6)
        dw = ctx@design_w
        dh = ctx@design_h
        IfCondition EqualTo(dw, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(dh, 0) ThenBlock: { ReturnValue(0) }

        // scale = min(canvas_w/design_w, canvas_h/design_h)
        // Use integer ratio: scale_num/scale_den
        // Compare canvas_w * design_h vs canvas_h * design_w
        // to determine which axis is the limiting factor
        cross_w = Multiply(canvas_w, dh)
        cross_h = Multiply(canvas_h, dw)

        IfCondition LessEqual(cross_w, cross_h) ThenBlock: {
            // Width is limiting
            ctx@scale_num = canvas_w
            ctx@scale_den = dw
        } ElseBlock: {
            // Height is limiting
            ctx@scale_num = canvas_h
            ctx@scale_den = dh
        }
        ReturnValue(0)
    }
}

// =============================================================================
// MEASURE PASS — bottom-up intrinsic sizing
// Post-order traversal: children before parents
// Recursive via child/sibling links
// =============================================================================
Function.AK_MeasureNode {
    Input: ctx: LinkagePool.AKContext
    Input: node: Integer
    Body: {
        DebugLog_Push("ak.msn", 6)
        IfCondition LessThan(node, 0) ThenBlock: { ReturnValue(0) }
        // Skip invisible
        vis = AK_Get(ctx, node, AKF.VISIBLE)
        IfCondition EqualTo(vis, 0) ThenBlock: { ReturnValue(0) }

        tag = AK_Get(ctx, node, AKF.TAG)

        // Measure children first (post-order)
        child = AK_Get(ctx, node, AKF.FIRST_CHILD)
        WhileLoop NotEqual(child, -1) {
            AK_MeasureNode(ctx, child)
            child = AK_Get(ctx, child, AKF.NEXT_SIBLING)
        }

        // Explicit size overrides intrinsic
        expl_w = AK_Get(ctx, node, AKF.WIDTH)
        expl_h = AK_Get(ctx, node, AKF.HEIGHT)
        IfCondition And(NotEqual(expl_w, 0), NotEqual(expl_h, 0)) ThenBlock: {
            ReturnValue(0)
        }

        // Leaf nodes — measure content
        cc = AK_Get(ctx, node, AKF.CHILD_COUNT)
        IfCondition EqualTo(cc, 0) ThenBlock: {
            // Label / Display — measure text
            IfCondition EqualTo(tag, AKTag.LABEL) ThenBlock: {
                sp = AK_ExtraGet(ctx, node, AKExtra.STR_PTR)
                sl = AK_ExtraGet(ctx, node, AKExtra.STR_LEN)
                IfCondition And(NotEqual(sp, 0), GreaterThan(sl, 0)) ThenBlock: {
                    tw = TextRegion_MeasureWidth(sp, sl)
                    // Add small buffer for glyph right-bearing overshoot
                    tw = Add(tw, 4)
                    th = VFont_GetLineHeight()
                    IfCondition EqualTo(expl_w, 0) ThenBlock: { AK_Set(ctx, node, AKF.WIDTH, tw) }
                    IfCondition EqualTo(expl_h, 0) ThenBlock: { AK_Set(ctx, node, AKF.HEIGHT, th) }
                }
            }
            // INPUT — single-line text field, fixed height
            IfCondition EqualTo(tag, AKTag.INPUT) ThenBlock: {
                input_h = Add(VFont_GetLineHeight(), Multiply(UIScale.ak_input_pad, 2))
                IfCondition EqualTo(expl_h, 0) ThenBlock: { AK_Set(ctx, node, AKF.HEIGHT, input_h) }
            }
            ReturnValue(0)
        }

        // Container nodes — sum children
        layout = AK_Get(ctx, node, AKF.LAYOUT_MODE)
        gap = AK_Get(ctx, node, AKF.GAP)
        pad_t = AK_Get(ctx, node, AKF.PAD_T)
        pad_r = AK_Get(ctx, node, AKF.PAD_R)
        pad_b = AK_Get(ctx, node, AKF.PAD_B)
        pad_l = AK_Get(ctx, node, AKF.PAD_L)

        sum_main = 0
        max_cross = 0
        visible_count = 0

        child = AK_Get(ctx, node, AKF.FIRST_CHILD)
        WhileLoop NotEqual(child, -1) {
            cvis = AK_Get(ctx, child, AKF.VISIBLE)
            IfCondition EqualTo(cvis, 1) ThenBlock: {
                cw = AK_Get(ctx, child, AKF.WIDTH)
                ch = AK_Get(ctx, child, AKF.HEIGHT)
                // Fallback to MIN_W/MIN_H when WIDTH/HEIGHT is 0
                cminw = AK_Get(ctx, child, AKF.MIN_W)
                IfCondition And(EqualTo(cw, 0), GreaterThan(cminw, 0)) ThenBlock: { cw = cminw }
                cminh = AK_Get(ctx, child, AKF.MIN_H)
                IfCondition And(EqualTo(ch, 0), GreaterThan(cminh, 0)) ThenBlock: { ch = cminh }

                IfCondition EqualTo(layout, AKLayout.VBOX) ThenBlock: {
                    sum_main = Add(sum_main, ch)
                    IfCondition GreaterThan(cw, max_cross) ThenBlock: { max_cross = cw }
                }
                IfCondition EqualTo(layout, AKLayout.HBOX) ThenBlock: {
                    sum_main = Add(sum_main, cw)
                    IfCondition GreaterThan(ch, max_cross) ThenBlock: { max_cross = ch }
                }
                visible_count = Add(visible_count, 1)
            }
            child = AK_Get(ctx, child, AKF.NEXT_SIBLING)
        }

        // Add gaps between visible children
        IfCondition GreaterThan(visible_count, 1) ThenBlock: {
            gap_total = Multiply(gap, Subtract(visible_count, 1))
            sum_main = Add(sum_main, gap_total)
        }

        // Grid — compute from cols and children
        IfCondition EqualTo(layout, AKLayout.GRID) ThenBlock: {
            cols = AK_Get(ctx, node, AKF.COLS)
            IfCondition LessEqual(cols, 0) ThenBlock: { cols = 1 }
            t1 = Subtract(cols, 1)
            t2 = Add(visible_count, t1)
            rows = Divide(t2, cols)

            // Find max child width and height
            max_cw = 0
            max_ch = 0
            child = AK_Get(ctx, node, AKF.FIRST_CHILD)
            WhileLoop NotEqual(child, -1) {
                cvis = AK_Get(ctx, child, AKF.VISIBLE)
                IfCondition EqualTo(cvis, 1) ThenBlock: {
                    cw = AK_Get(ctx, child, AKF.WIDTH)
                    ch = AK_Get(ctx, child, AKF.HEIGHT)
                    IfCondition GreaterThan(cw, max_cw) ThenBlock: { max_cw = cw }
                    IfCondition GreaterThan(ch, max_ch) ThenBlock: { max_ch = ch }
                }
                child = AK_Get(ctx, child, AKF.NEXT_SIBLING)
            }
            col_gaps = Multiply(gap, Subtract(cols, 1))
            row_gaps = Multiply(gap, Subtract(rows, 1))
            t1 = Multiply(max_ch, rows)
            sum_main = Add(t1, row_gaps)
            t2 = Multiply(max_cw, cols)
            max_cross = Add(t2, col_gaps)
        }

        // Set intrinsic size (if not explicitly set)
        IfCondition EqualTo(layout, AKLayout.VBOX) ThenBlock: {
            intr_w = Add(max_cross, Add(pad_l, pad_r))
            intr_h = Add(sum_main, Add(pad_t, pad_b))
            IfCondition EqualTo(expl_w, 0) ThenBlock: { AK_Set(ctx, node, AKF.WIDTH, intr_w) }
            IfCondition EqualTo(expl_h, 0) ThenBlock: { AK_Set(ctx, node, AKF.HEIGHT, intr_h) }
        }
        IfCondition EqualTo(layout, AKLayout.HBOX) ThenBlock: {
            intr_w = Add(sum_main, Add(pad_l, pad_r))
            intr_h = Add(max_cross, Add(pad_t, pad_b))
            IfCondition EqualTo(expl_w, 0) ThenBlock: { AK_Set(ctx, node, AKF.WIDTH, intr_w) }
            IfCondition EqualTo(expl_h, 0) ThenBlock: { AK_Set(ctx, node, AKF.HEIGHT, intr_h) }
        }
        IfCondition EqualTo(layout, AKLayout.GRID) ThenBlock: {
            intr_w = Add(max_cross, Add(pad_l, pad_r))
            intr_h = Add(sum_main, Add(pad_t, pad_b))
            IfCondition EqualTo(expl_w, 0) ThenBlock: { AK_Set(ctx, node, AKF.WIDTH, intr_w) }
            IfCondition EqualTo(expl_h, 0) ThenBlock: { AK_Set(ctx, node, AKF.HEIGHT, intr_h) }
        }

        ReturnValue(0)
    }
}

// =============================================================================
// LAYOUT PASS — top-down space distribution
// Pre-order traversal: parents before children
// =============================================================================
Function.AK_LayoutNode {
    Input: ctx: LinkagePool.AKContext
    Input: node: Integer
    Body: {
        DebugLog_Push("ak.lyn", 6)
        IfCondition LessThan(node, 0) ThenBlock: { ReturnValue(0) }
        vis = AK_Get(ctx, node, AKF.VISIBLE)
        IfCondition EqualTo(vis, 0) ThenBlock: { ReturnValue(0) }

        cc = AK_Get(ctx, node, AKF.CHILD_COUNT)
        IfCondition EqualTo(cc, 0) ThenBlock: { ReturnValue(0) }

        layout = AK_Get(ctx, node, AKF.LAYOUT_MODE)
        gap = AK_Scale(ctx, AK_Get(ctx, node, AKF.GAP))
        pad_t = AK_Scale(ctx, AK_Get(ctx, node, AKF.PAD_T))
        pad_r = AK_Scale(ctx, AK_Get(ctx, node, AKF.PAD_R))
        pad_b = AK_Scale(ctx, AK_Get(ctx, node, AKF.PAD_B))
        pad_l = AK_Scale(ctx, AK_Get(ctx, node, AKF.PAD_L))
        align = AK_Get(ctx, node, AKF.ALIGN)

        // Content area = solved size minus padding
        px = AK_Get(ctx, node, AKF.SOLVED_X)
        py = AK_Get(ctx, node, AKF.SOLVED_Y)
        pw = AK_Get(ctx, node, AKF.SOLVED_W)
        ph = AK_Get(ctx, node, AKF.SOLVED_H)
        cx = Add(px, pad_l)
        cy = Add(py, pad_t)
        cw = Subtract(pw, Add(pad_l, pad_r))
        ch = Subtract(ph, Add(pad_t, pad_b))

        // =====================================================================
        // VBOX LAYOUT
        // =====================================================================
        IfCondition EqualTo(layout, AKLayout.VBOX) ThenBlock: {
            // Phase 1: sum base heights, count grow
            total_base = 0
            total_grow = 0
            vis_count = 0
            child = AK_Get(ctx, node, AKF.FIRST_CHILD)
            WhileLoop NotEqual(child, -1) {
                cvis = AK_Get(ctx, child, AKF.VISIBLE)
                IfCondition EqualTo(cvis, 1) ThenBlock: {
                    base_h = AK_Scale(ctx, AK_Get(ctx, child, AKF.HEIGHT))
                    total_base = Add(total_base, base_h)
                    gr = AK_Get(ctx, child, AKF.GROW)
                    total_grow = Add(total_grow, gr)
                    vis_count = Add(vis_count, 1)
                }
                child = AK_Get(ctx, child, AKF.NEXT_SIBLING)
            }

            // Auto-grow: WINDOW with single child, no height, no grow → fill
            auto_grow = 0
            ptag = AK_Get(ctx, node, AKF.TAG)
            IfCondition EqualTo(ptag, AKTag.WINDOW) ThenBlock: {
                IfCondition And(EqualTo(vis_count, 1), EqualTo(total_grow, 0)) ThenBlock: {
                    auto_grow = 1
                    total_grow = 1
                }
            }

            gap_total = 0
            IfCondition GreaterThan(vis_count, 1) ThenBlock: {
                gap_total = Multiply(gap, Subtract(vis_count, 1))
            }
            remaining = Subtract(ch, Add(total_base, gap_total))
            IfCondition LessThan(remaining, 0) ThenBlock: { remaining = 0 }

            // Phase 2: assign positions
            cur_y = cy
            child = AK_Get(ctx, node, AKF.FIRST_CHILD)
            WhileLoop NotEqual(child, -1) {
                cvis = AK_Get(ctx, child, AKF.VISIBLE)
                IfCondition EqualTo(cvis, 1) ThenBlock: {
                    base_h = AK_Scale(ctx, AK_Get(ctx, child, AKF.HEIGHT))
                    gr = AK_Get(ctx, child, AKF.GROW)
                    IfCondition And(EqualTo(auto_grow, 1), EqualTo(gr, 0)) ThenBlock: { gr = 1 }

                    // Distribute remaining space by grow
                    extra = 0
                    IfCondition And(GreaterThan(gr, 0), GreaterThan(total_grow, 0)) ThenBlock: {
                        extra = Divide(Multiply(remaining, gr), total_grow)
                    }
                    child_h = Add(base_h, extra)

                    // Cross-axis (width) — based on align
                    child_w = cw
                    child_x = cx
                    IfCondition NotEqual(align, AKAlign.STRETCH) ThenBlock: {
                        child_w = AK_Scale(ctx, AK_Get(ctx, child, AKF.WIDTH))
                        IfCondition EqualTo(child_w, 0) ThenBlock: { child_w = cw }
                        // Only clamp to container width for non-SCROLL parents
                        IfCondition NotEqual(ptag, AKTag.SCROLL) ThenBlock: {
                            IfCondition GreaterThan(child_w, cw) ThenBlock: { child_w = cw }
                        }
                        IfCondition EqualTo(align, AKAlign.CENTER) ThenBlock: {
                            t1 = Subtract(cw, child_w)
                            t2 = Divide(t1, 2)
                            child_x = Add(cx, t2)
                        }
                        IfCondition EqualTo(align, AKAlign.END) ThenBlock: {
                            child_x = Add(cx, Subtract(cw, child_w))
                        }
                    }

                    // Apply min/max width constraints (cross-axis)
                    min_w = AK_Scale(ctx, AK_Get(ctx, child, AKF.MIN_W))
                    max_w = AK_Scale(ctx, AK_Get(ctx, child, AKF.MAX_W))
                    IfCondition And(GreaterThan(min_w, 0), LessThan(child_w, min_w)) ThenBlock: {
                        child_w = min_w
                    }
                    IfCondition And(GreaterThan(max_w, 0), GreaterThan(child_w, max_w)) ThenBlock: {
                        child_w = max_w
                    }

                    // Apply min/max constraints
                    min_h = AK_Scale(ctx, AK_Get(ctx, child, AKF.MIN_H))
                    max_h = AK_Scale(ctx, AK_Get(ctx, child, AKF.MAX_H))
                    IfCondition And(GreaterThan(min_h, 0), LessThan(child_h, min_h)) ThenBlock: {
                        child_h = min_h
                    }
                    IfCondition And(GreaterThan(max_h, 0), GreaterThan(child_h, max_h)) ThenBlock: {
                        child_h = max_h
                    }

                    // Constrain to available remaining space (skip for SCROLL — children overflow)
                    IfCondition NotEqual(ptag, AKTag.SCROLL) ThenBlock: {
                        available = Subtract(Add(cy, ch), cur_y)
                        IfCondition GreaterThan(child_h, available) ThenBlock: {
                            child_h = available
                        }
                        IfCondition LessThan(child_h, 0) ThenBlock: { child_h = 0 }
                    }

                    AK_Set(ctx, child, AKF.SOLVED_X, child_x)
                    AK_Set(ctx, child, AKF.SOLVED_Y, cur_y)
                    AK_Set(ctx, child, AKF.SOLVED_W, child_w)
                    AK_Set(ctx, child, AKF.SOLVED_H, child_h)

                    cur_y = Add(cur_y, Add(child_h, gap))
                }
                child = AK_Get(ctx, child, AKF.NEXT_SIBLING)
            }
        }

        // =====================================================================
        // HBOX LAYOUT
        // =====================================================================
        IfCondition EqualTo(layout, AKLayout.HBOX) ThenBlock: {
            total_base = 0
            total_grow = 0
            vis_count = 0
            child = AK_Get(ctx, node, AKF.FIRST_CHILD)
            WhileLoop NotEqual(child, -1) {
                cvis = AK_Get(ctx, child, AKF.VISIBLE)
                IfCondition EqualTo(cvis, 1) ThenBlock: {
                    base_w = AK_Scale(ctx, AK_Get(ctx, child, AKF.WIDTH))
                    // Fallback to MIN_W when WIDTH is 0
                    IfCondition EqualTo(base_w, 0) ThenBlock: {
                        base_w = AK_Scale(ctx, AK_Get(ctx, child, AKF.MIN_W))
                    }
                    total_base = Add(total_base, base_w)
                    gr = AK_Get(ctx, child, AKF.GROW)
                    total_grow = Add(total_grow, gr)
                    vis_count = Add(vis_count, 1)
                }
                child = AK_Get(ctx, child, AKF.NEXT_SIBLING)
            }

            gap_total = 0
            IfCondition GreaterThan(vis_count, 1) ThenBlock: {
                gap_total = Multiply(gap, Subtract(vis_count, 1))
            }
            remaining = Subtract(cw, Add(total_base, gap_total))
            IfCondition LessThan(remaining, 0) ThenBlock: { remaining = 0 }

            cur_x = cx
            child = AK_Get(ctx, node, AKF.FIRST_CHILD)
            WhileLoop NotEqual(child, -1) {
                cvis = AK_Get(ctx, child, AKF.VISIBLE)
                IfCondition EqualTo(cvis, 1) ThenBlock: {
                    base_w = AK_Scale(ctx, AK_Get(ctx, child, AKF.WIDTH))
                    // Fallback to MIN_W when WIDTH is 0
                    IfCondition EqualTo(base_w, 0) ThenBlock: {
                        base_w = AK_Scale(ctx, AK_Get(ctx, child, AKF.MIN_W))
                    }
                    gr = AK_Get(ctx, child, AKF.GROW)

                    extra = 0
                    IfCondition And(GreaterThan(gr, 0), GreaterThan(total_grow, 0)) ThenBlock: {
                        extra = Divide(Multiply(remaining, gr), total_grow)
                    }
                    child_w = Add(base_w, extra)

                    // Cross-axis (height)
                    child_h = ch
                    child_y = cy
                    IfCondition NotEqual(align, AKAlign.STRETCH) ThenBlock: {
                        child_h = AK_Scale(ctx, AK_Get(ctx, child, AKF.HEIGHT))
                        IfCondition EqualTo(child_h, 0) ThenBlock: { child_h = ch }
                        IfCondition GreaterThan(child_h, ch) ThenBlock: { child_h = ch }
                        IfCondition EqualTo(align, AKAlign.CENTER) ThenBlock: {
                            t1 = Subtract(ch, child_h)
                            t2 = Divide(t1, 2)
                            child_y = Add(cy, t2)
                        }
                        IfCondition EqualTo(align, AKAlign.END) ThenBlock: {
                            child_y = Add(cy, Subtract(ch, child_h))
                        }
                    }

                    min_w = AK_Scale(ctx, AK_Get(ctx, child, AKF.MIN_W))
                    max_w = AK_Scale(ctx, AK_Get(ctx, child, AKF.MAX_W))
                    IfCondition And(GreaterThan(min_w, 0), LessThan(child_w, min_w)) ThenBlock: {
                        child_w = min_w
                    }
                    IfCondition And(GreaterThan(max_w, 0), GreaterThan(child_w, max_w)) ThenBlock: {
                        child_w = max_w
                    }

                    AK_Set(ctx, child, AKF.SOLVED_X, cur_x)
                    AK_Set(ctx, child, AKF.SOLVED_Y, child_y)
                    AK_Set(ctx, child, AKF.SOLVED_W, child_w)
                    AK_Set(ctx, child, AKF.SOLVED_H, child_h)

                    cur_x = Add(cur_x, Add(child_w, gap))
                }
                child = AK_Get(ctx, child, AKF.NEXT_SIBLING)
            }
        }


       PrintMessage("\n")

        // =====================================================================
        // GRID LAYOUT
        // =====================================================================
        IfCondition EqualTo(layout, AKLayout.GRID) ThenBlock: {
            cols = AK_Get(ctx, node, AKF.COLS)
            IfCondition LessEqual(cols, 0) ThenBlock: { cols = 1 }

            // Count visible children
            vis_count = 0
            cnode = AK_Get(ctx, node, AKF.FIRST_CHILD)
            WhileLoop NotEqual(cnode, -1) {
                cvis = AK_Get(ctx, cnode, AKF.VISIBLE)
                IfCondition EqualTo(cvis, 1) ThenBlock: {
                    vis_count = Add(vis_count, 1)
                }
                cnode = AK_Get(ctx, cnode, AKF.NEXT_SIBLING)
            }
            rows = Divide(Add(vis_count, Subtract(cols, 1)), cols)
            IfCondition LessEqual(rows, 0) ThenBlock: { rows = 1 }

            // Cell size
            col_gaps = Multiply(gap, Subtract(cols, 1))
            row_gaps = Multiply(gap, Subtract(rows, 1))
            cell_w = Divide(Subtract(cw, col_gaps), cols)
            cell_h = Divide(Subtract(ch, row_gaps), rows)

            // Place children in grid cells
            gi = 0
            child = AK_Get(ctx, node, AKF.FIRST_CHILD)
            WhileLoop NotEqual(child, -1) {
                cvis = AK_Get(ctx, child, AKF.VISIBLE)
                IfCondition EqualTo(cvis, 1) ThenBlock: {
                    col = gi
                    row_num = 0
                    WhileLoop GreaterEqual(col, cols) {
                        col = Subtract(col, cols)
                        row_num = Add(row_num, 1)
                    }
                    cell_step = Add(cell_w, gap)
                    cell_off = Multiply(col, cell_step)
                    cell_x = Add(cx, cell_off)
                    row_step = Add(cell_h, gap)
                    row_off = Multiply(row_num, row_step)
                    cell_y = Add(cy, row_off)

                    AK_Set(ctx, child, AKF.SOLVED_X, cell_x)
                    AK_Set(ctx, child, AKF.SOLVED_Y, cell_y)
                    AK_Set(ctx, child, AKF.SOLVED_W, cell_w)
                    AK_Set(ctx, child, AKF.SOLVED_H, cell_h)

                    gi = Add(gi, 1)
                }
                child = AK_Get(ctx, child, AKF.NEXT_SIBLING)
            }
        }

        // Recurse into children
        child = AK_Get(ctx, node, AKF.FIRST_CHILD)
        WhileLoop NotEqual(child, -1) {
            AK_LayoutNode(ctx, child)
            child = AK_Get(ctx, child, AKF.NEXT_SIBLING)
        }

        ReturnValue(0)
    }
}

// =============================================================================
// SOLVE — full measure + layout pass
// =============================================================================
Function.AK_Solve {
    Input: ctx: LinkagePool.AKContext
    Input: canvas_w: Integer
    Input: canvas_h: Integer
    Body: {
        DebugLog_Push("ak.slv", 6)
        root = ctx@tree_root
        IfCondition LessThan(root, 0) ThenBlock: { ReturnValue(0) }

        // Compute scale
        AK_ComputeScale(ctx, canvas_w, canvas_h)

        // Measure pass (bottom-up)
        AK_MeasureNode(ctx, root)

        // Set root to full canvas
        AK_Set(ctx, root, AKF.SOLVED_X, 0)
        AK_Set(ctx, root, AKF.SOLVED_Y, 0)
        AK_Set(ctx, root, AKF.SOLVED_W, canvas_w)
        AK_Set(ctx, root, AKF.SOLVED_H, canvas_h)

        // Layout pass (top-down)
        AK_LayoutNode(ctx, root)

        // Solve complete

        ReturnValue(1)
    }
}

// =============================================================================
// DRAW — render all nodes into canvas (pre-order, painter's algorithm)
// =============================================================================
Function.AK_DrawNode {
    Input: ctx: LinkagePool.AKContext
    Input: node: Integer
    Body: {
        DebugLog_Push("ak.drn", 6)
        IfCondition LessThan(node, 0) ThenBlock: { ReturnValue(0) }
        vis = AK_Get(ctx, node, AKF.VISIBLE)
        IfCondition EqualTo(vis, 0) ThenBlock: { ReturnValue(0) }

        tag = AK_Get(ctx, node, AKF.TAG)
        sx = Subtract(AK_Get(ctx, node, AKF.SOLVED_X), ctx@scroll_offset_x)
        sy = Subtract(AK_Get(ctx, node, AKF.SOLVED_Y), ctx@scroll_offset_y)
        sw = AK_Get(ctx, node, AKF.SOLVED_W)
        sh = AK_Get(ctx, node, AKF.SOLVED_H)
        canvas = ctx@canvas

        IfCondition EqualTo(canvas, 0) ThenBlock: { ReturnValue(0) }

        // Group / Window — fill background if bg color set
        IfCondition Or(EqualTo(tag, AKTag.GROUP), EqualTo(tag, AKTag.WINDOW)) ThenBlock: {
            bg = AK_ExtraGet(ctx, node, AKExtra.COLOR_BG)
            IfCondition NotEqual(bg, 0) ThenBlock: {
                AK_FillRect(ctx, sx, sy, sw, sh, bg)
            }
        }

        // Panel — fill background
        IfCondition EqualTo(tag, AKTag.PANEL) ThenBlock: {
            bg = AK_ExtraGet(ctx, node, AKExtra.COLOR_BG)
            IfCondition NotEqual(bg, 0) ThenBlock: {
                AK_FillRect(ctx, sx, sy, sw, sh, bg)
            }
            bw = AK_ExtraGet(ctx, node, AKExtra.BORDER_W)
            IfCondition GreaterThan(bw, 0) ThenBlock: {
                bc = AK_ExtraGet(ctx, node, AKExtra.BORDER_CLR)
                // Top border
                AK_FillRect(ctx, sx, sy, sw, bw, bc)
                // Bottom border
                AK_FillRect(ctx, sx, Add(sy, Subtract(sh, bw)), sw, bw, bc)
                // Left border
                AK_FillRect(ctx, sx, sy, bw, sh, bc)
                // Right border
                AK_FillRect(ctx, Add(sx, Subtract(sw, bw)), sy, bw, sh, bc)
            }
        }

        // Label — render text via TextRegion
        IfCondition EqualTo(tag, AKTag.LABEL) ThenBlock: {
            sp = AK_ExtraGet(ctx, node, AKExtra.STR_PTR)
            sl = AK_ExtraGet(ctx, node, AKExtra.STR_LEN)
            fg = AK_ExtraGet(ctx, node, AKExtra.COLOR_FG)
            ta = AK_ExtraGet(ctx, node, AKExtra.TEXT_ALIGN)
            IfCondition And(NotEqual(sp, 0), GreaterThan(sl, 0)) ThenBlock: {
                tr = AK_ExtraGet(ctx, node, AKExtra.TR_HANDLE)
                IfCondition LessThan(tr, 0) ThenBlock: {
                    // Create TextRegion on first draw
                    tr = TextRegion_Create(canvas, sx, sy, sw, sh)
                    AK_ExtraSet(ctx, node, AKExtra.TR_HANDLE, tr)
                }
                IfCondition GreaterEqual(tr, 0) ThenBlock: {
                    TextRegion_SetRect(tr, sx, sy, sw, sh)
                    TextRegion_SetSurface(tr, canvas)
                    TextRegion_SetColor(tr, fg)
                    TextRegion_SetAlign(tr, ta)
                    TextRegion_SetVAlign(tr, TRVAlign.MIDDLE)
                    TextRegion_SetClip(tr, ctx@clip_x, ctx@clip_y, ctx@clip_w, ctx@clip_h)
                    TextRegion_Render(tr, sp, sl)
                }
            }
        }

        // Separator — horizontal or vertical line
        IfCondition EqualTo(tag, AKTag.SEPARATOR) ThenBlock: {
            fg = AK_ExtraGet(ctx, node, AKExtra.COLOR_FG)
            IfCondition EqualTo(fg, 0) ThenBlock: {
                fg = Theme.ak_sep
            }
            // Determine orientation from parent layout
            par = AK_Get(ctx, node, AKF.PARENT)
            IfCondition GreaterEqual(par, 0) ThenBlock: {
                playout = AK_Get(ctx, par, AKF.LAYOUT_MODE)
                IfCondition EqualTo(playout, AKLayout.VBOX) ThenBlock: {
                    // Horizontal separator
                    sep_y = Add(sy, Divide(sh, 2))
                    AK_FillRect(ctx, sx, sep_y, sw, UIScale.ak_separator_w, fg)
                }
                IfCondition EqualTo(playout, AKLayout.HBOX) ThenBlock: {
                    // Vertical separator
                    sep_x = Add(sx, Divide(sw, 2))
                    AK_FillRect(ctx, sep_x, sy, UIScale.ak_separator_w, sh, fg)
                }
            }
        }

        // Button — fill + centered label with state-aware colors
        IfCondition EqualTo(tag, AKTag.BUTTON) ThenBlock: {
            bg = AK_ExtraGet(ctx, node, AKExtra.COLOR_BG)
            IfCondition EqualTo(bg, 0) ThenBlock: {
                bg = Theme.ak_btn_bg
            }

            state = AK_Get(ctx, node, AKF.STATE)

            // Unpack bg into channels for modification
            // BGRA packed: byte0=B, byte1=G, byte2=R, byte3=A
            bg_b = BitwiseAnd(bg, 255)
            bg_g = BitwiseAnd(Divide(bg, 256), 255)
            bg_r = BitwiseAnd(Divide(bg, 65536), 255)

            // HOVER — lighten
            hover_d = UIScale.ak_btn_hover_delta
            IfCondition EqualTo(state, AKState.HOVER) ThenBlock: {
                bg_r = Add(bg_r, hover_d)
                bg_g = Add(bg_g, hover_d)
                bg_b = Add(bg_b, hover_d)
                IfCondition GreaterThan(bg_r, 255) ThenBlock: { bg_r = 255 }
                IfCondition GreaterThan(bg_g, 255) ThenBlock: { bg_g = 255 }
                IfCondition GreaterThan(bg_b, 255) ThenBlock: { bg_b = 255 }
                bg = TVG_PackColor(bg_r, bg_g, bg_b, 255)
            }

            // PRESSED — darken
            IfCondition EqualTo(state, AKState.PRESSED) ThenBlock: {
                bg_r = Subtract(bg_r, hover_d)
                bg_g = Subtract(bg_g, hover_d)
                bg_b = Subtract(bg_b, hover_d)
                IfCondition LessThan(bg_r, 0) ThenBlock: { bg_r = 0 }
                IfCondition LessThan(bg_g, 0) ThenBlock: { bg_g = 0 }
                IfCondition LessThan(bg_b, 0) ThenBlock: { bg_b = 0 }
                bg = TVG_PackColor(bg_r, bg_g, bg_b, 255)
            }

            // DISABLED — gray out
            IfCondition EqualTo(state, AKState.DISABLED) ThenBlock: {
                avg = Divide(Add(Add(bg_r, bg_g), bg_b), 3)
                bg = TVG_PackColor(avg, avg, avg, 255)
            }

            AK_FillRect(ctx, sx, sy, sw, sh, bg)

            // Border — lighter on hover, darker on press
            bw = AK_ExtraGet(ctx, node, AKExtra.BORDER_W)
            IfCondition EqualTo(bw, 0) ThenBlock: { bw = UIScale.ak_btn_border_w }
            bc = AK_ExtraGet(ctx, node, AKExtra.BORDER_CLR)
            IfCondition EqualTo(bc, 0) ThenBlock: {
                bc = Theme.ak_btn_border
            }
            IfCondition EqualTo(state, AKState.HOVER) ThenBlock: {
                bc = Theme.ak_btn_hover
            }
            IfCondition EqualTo(state, AKState.PRESSED) ThenBlock: {
                bc = Theme.ak_btn_pressed
            }
            AK_FillRect(ctx, sx, sy, sw, bw, bc)
            AK_FillRect(ctx, sx, Add(sy, Subtract(sh, bw)), sw, bw, bc)
            AK_FillRect(ctx, sx, sy, bw, sh, bc)
            AK_FillRect(ctx, Add(sx, Subtract(sw, bw)), sy, bw, sh, bc)

            // Icon support — draw icon and offset text if ICON_SURF is set
            btn_icon = AK_ExtraGet(ctx, node, AKExtra.ICON_SURF)
            txt_x = sx
            txt_w = sw
            IfCondition NotEqual(btn_icon, 0) ThenBlock: {
                biw = Surface_GetWidth(btn_icon)
                bih = Surface_GetHeight(btn_icon)
                bix = Add(sx, UIScale.ak_btn_icon_pad_l)
                biy = Add(sy, Divide(Subtract(sh, bih), 2))
                Surface_BlitAlpha(canvas, btn_icon, bix, biy)
                btn_off = Add(biw, UIScale.ak_btn_icon_gap)
                txt_x = Add(sx, btn_off)
                txt_w = Subtract(sw, btn_off)
            }

            // Label — dim for disabled
            sp = AK_ExtraGet(ctx, node, AKExtra.STR_PTR)
            sl = AK_ExtraGet(ctx, node, AKExtra.STR_LEN)
            fg = AK_ExtraGet(ctx, node, AKExtra.COLOR_FG)
            IfCondition EqualTo(fg, 0) ThenBlock: {
                fg = Theme.ak_btn_fg
            }
            IfCondition EqualTo(state, AKState.DISABLED) ThenBlock: {
                fg = Theme.text_disabled
            }
            IfCondition And(NotEqual(sp, 0), GreaterThan(sl, 0)) ThenBlock: {
                tr = AK_ExtraGet(ctx, node, AKExtra.TR_HANDLE)
                IfCondition LessThan(tr, 0) ThenBlock: {
                    tr = TextRegion_Create(canvas, txt_x, sy, txt_w, sh)
                    AK_ExtraSet(ctx, node, AKExtra.TR_HANDLE, tr)
                }
                IfCondition GreaterEqual(tr, 0) ThenBlock: {
                    TextRegion_SetRect(tr, txt_x, sy, txt_w, sh)
                    TextRegion_SetSurface(tr, canvas)
                    TextRegion_SetColor(tr, fg)
                    btn_align = AK_ExtraGet(ctx, node, AKExtra.TEXT_ALIGN)
                    TextRegion_SetAlign(tr, btn_align)
                    TextRegion_SetVAlign(tr, TRVAlign.MIDDLE)
                    TextRegion_SetClip(tr, ctx@clip_x, ctx@clip_y, ctx@clip_w, ctx@clip_h)
                    TextRegion_Render(tr, sp, sl)
                }
            }
        }

        // CHECKBOX — box indicator + label text, toggles on click
        IfCondition EqualTo(tag, AKTag.CHECKBOX) ThenBlock: {
            bg = AK_ExtraGet(ctx, node, AKExtra.COLOR_BG)
            fg = AK_ExtraGet(ctx, node, AKExtra.COLOR_FG)
            IfCondition EqualTo(fg, 0) ThenBlock: { fg = Theme.ak_btn_fg }

            state = AK_Get(ctx, node, AKF.STATE)
            checked = AK_ExtraGet(ctx, node, AKExtra.VALUE)

            // Draw background if set
            IfCondition NotEqual(bg, 0) ThenBlock: {
                AK_FillRect(ctx, sx, sy, sw, sh, bg)
            }

            // Box dimensions: centered vertically
            box_sz = UIScale.ak_checkbox_sz
            box_x = Add(sx, UIScale.ak_checkbox_pad_l)
            box_y = Add(sy, Divide(Subtract(sh, box_sz), 2))

            // Box background — dark fill
            box_bg = Theme.ak_checkbox_box_bg
            AK_FillRect(ctx, box_x, box_y, box_sz, box_sz, box_bg)

            // Box border — state-aware
            bc = Theme.ak_btn_border
            IfCondition EqualTo(state, AKState.HOVER) ThenBlock: {
                bc = Theme.ak_btn_hover
            }
            IfCondition EqualTo(state, AKState.PRESSED) ThenBlock: {
                bc = Theme.ak_btn_pressed
            }
            // Top/bottom borders
            cb_bw = UIScale.ak_checkbox_border_w
            AK_FillRect(ctx, box_x, box_y, box_sz, cb_bw, bc)
            AK_FillRect(ctx, box_x, Add(box_y, Subtract(box_sz, cb_bw)), box_sz, cb_bw, bc)
            // Left/right borders
            AK_FillRect(ctx, box_x, box_y, cb_bw, box_sz, bc)
            AK_FillRect(ctx, Add(box_x, Subtract(box_sz, cb_bw)), box_y, cb_bw, box_sz, bc)

            // Checkmark — fill inner box with accent color when checked
            chk_margin = UIScale.ak_checkbox_inner_margin
            IfCondition EqualTo(checked, 1) ThenBlock: {
                chk_clr = Theme.ak_checkmark_color
                AK_FillRect(ctx, Add(box_x, chk_margin), Add(box_y, chk_margin),
                                  Subtract(box_sz, Multiply(chk_margin, 2)), Subtract(box_sz, Multiply(chk_margin, 2)), chk_clr)
            }

            // Label text — right of checkbox box
            sp = AK_ExtraGet(ctx, node, AKExtra.STR_PTR)
            sl = AK_ExtraGet(ctx, node, AKExtra.STR_LEN)
            IfCondition And(NotEqual(sp, 0), GreaterThan(sl, 0)) ThenBlock: {
                lbl_x = Add(box_x, Add(box_sz, UIScale.ak_checkbox_label_gap))
                lbl_w = Subtract(sw, Subtract(lbl_x, sx))
                IfCondition GreaterThan(lbl_w, 0) ThenBlock: {
                    tr = AK_ExtraGet(ctx, node, AKExtra.TR_HANDLE)
                    IfCondition LessThan(tr, 0) ThenBlock: {
                        tr = TextRegion_Create(canvas, lbl_x, sy, lbl_w, sh)
                        AK_ExtraSet(ctx, node, AKExtra.TR_HANDLE, tr)
                    }
                    IfCondition GreaterEqual(tr, 0) ThenBlock: {
                        TextRegion_SetRect(tr, lbl_x, sy, lbl_w, sh)
                        TextRegion_SetSurface(tr, canvas)
                        TextRegion_SetColor(tr, fg)
                        TextRegion_SetAlign(tr, TRAlign.LEFT)
                        TextRegion_SetVAlign(tr, TRVAlign.MIDDLE)
                        TextRegion_SetClip(tr, ctx@clip_x, ctx@clip_y, ctx@clip_w, ctx@clip_h)
                        TextRegion_Render(tr, sp, sl)
                    }
                }
            }
        }

        // TEXTFIELD — multi-line editable text area with cursor, viewport, syntax
        IfCondition EqualTo(tag, AKTag.TEXTFIELD) ThenBlock: {
            bg = AK_ExtraGet(ctx, node, AKExtra.COLOR_BG)
            fg = AK_ExtraGet(ctx, node, AKExtra.COLOR_FG)
            IfCondition EqualTo(bg, 0) ThenBlock: { bg = Theme.window_bg }
            IfCondition EqualTo(fg, 0) ThenBlock: { fg = Theme.text_fg }

            // Fill background
            AK_FillRect(ctx, sx, sy, sw, sh, bg)

            // Border
            tf_bw = UIScale.ak_textfield_border_w
            bclr = AK_ExtraGet(ctx, node, AKExtra.BORDER_CLR)
            IfCondition EqualTo(bclr, 0) ThenBlock: { bclr = Theme.ak_sep }
            AK_FillRect(ctx, sx, sy, sw, tf_bw, bclr)
            AK_FillRect(ctx, sx, Add(sy, Subtract(sh, tf_bw)), sw, tf_bw, bclr)
            AK_FillRect(ctx, sx, sy, tf_bw, sh, bclr)
            AK_FillRect(ctx, Add(sx, Subtract(sw, tf_bw)), sy, tf_bw, sh, bclr)

            // Get TextBuffer handle
            tbh = AK_ExtraGet(ctx, node, AKExtra.TEXTBUF_H)
            IfCondition GreaterEqual(tbh, 0) ThenBlock: {
                line_count = TextBuf_GetLineCount(tbh)
                crow = TextBuf_GetCursorRow(tbh)
                ccol = TextBuf_GetCursorCol(tbh)
                syntax = AK_ExtraGet(ctx, node, AKExtra.SYNTAX_MODE)
                show_ln = AK_ExtraGet(ctx, node, AKExtra.LINE_NUMBERS)
                scroll_y = AK_ExtraGet(ctx, node, AKExtra.SCROLL_Y)

                pad = UIScale.ak_textfield_pad
                line_h = VFont_GetLineHeight()
                IfCondition LessThan(line_h, 2) ThenBlock: { line_h = Add(UIScale.font_body, 2) }
                visible_lines = Divide(Subtract(sh, Multiply(pad, 2)), line_h)

                // Auto-scroll to keep cursor visible
                IfCondition LessThan(crow, scroll_y) ThenBlock: {
                    scroll_y = crow
                }
                IfCondition GreaterEqual(crow, Add(scroll_y, visible_lines)) ThenBlock: {
                    scroll_y = Subtract(crow, Subtract(visible_lines, 1))
                }
                IfCondition LessThan(scroll_y, 0) ThenBlock: { scroll_y = 0 }
                AK_ExtraSet(ctx, node, AKExtra.SCROLL_Y, scroll_y)

                // Compute gutter width for line numbers
                gutter_w = 0
                IfCondition EqualTo(show_ln, 1) ThenBlock: {
                    gutter_w = UIScale.ak_gutter_w
                    // Draw gutter background
                    AK_FillRect(ctx, Add(sx, tf_bw), Add(sy, tf_bw), gutter_w, Subtract(sh, Multiply(tf_bw, 2)), Theme.ak_gutter_bg)
                }

                // Render visible lines (viewport: scroll_y to scroll_y+visible)
                ry = Add(sy, pad)
                r = scroll_y
                // Small local buffer for line number rendering (8 bytes)
                ln_buf = Allocate(8)
                WhileLoop And(LessThan(r, line_count), LessThan(ry, Add(sy, Subtract(sh, pad)))) {
                    lptr = TextBuf_GetLine(tbh, r)
                    llen = StringLength(lptr)

                    // Current line highlight
                    IfCondition EqualTo(r, crow) ThenBlock: {
                        AK_FillRect(ctx, Add(sx, tf_bw), ry, Subtract(sw, Multiply(tf_bw, 2)), line_h, Theme.ak_current_line_bg)
                    }

                    // Line number gutter
                    IfCondition EqualTo(show_ln, 1) ThenBlock: {
                        ln_color = Theme.ak_linenum_color
                        IfCondition EqualTo(r, crow) ThenBlock: { ln_color = Theme.ak_linenum_active_color }
                        // Convert line number (r+1) to string in ln_buf
                        ln_num = Add(r, 1)
                        ln_i = 7
                        SetByte(ln_buf, ln_i, 0)
                        ln_i = Subtract(ln_i, 1)
                        IfCondition EqualTo(ln_num, 0) ThenBlock: {
                            SetByte(ln_buf, ln_i, 48)
                            ln_i = Subtract(ln_i, 1)
                        } ElseBlock: {
                            WhileLoop GreaterThan(ln_num, 0) {
                                ln_d = Subtract(ln_num, Multiply(Divide(ln_num, 10), 10))
                                SetByte(ln_buf, ln_i, Add(48, ln_d))
                                ln_i = Subtract(ln_i, 1)
                                ln_num = Divide(ln_num, 10)
                            }
                        }
                        ln_start = Add(ln_i, 1)
                        ln_str = Add(ln_buf, ln_start)
                        ln_slen = Subtract(7, ln_start)
                        // Right-align: measure width, offset from gutter right edge
                        ln_pw = VFont_MeasureWidth(ln_str, ln_slen)
                        ln_x = Add(Add(sx, UIScale.ak_gutter_pad_l), Subtract(Subtract(gutter_w, UIScale.ak_gutter_pad_r), ln_pw))
                        IfCondition LessThan(ln_x, Add(sx, UIScale.ak_gutter_pad_l)) ThenBlock: { ln_x = Add(sx, UIScale.ak_gutter_pad_l) }
                        VFont_DrawString(canvas, ln_str, ln_slen, ln_x, ry, ln_color)
                    }

                    // Text content area
                    text_x = Add(Add(sx, pad), gutter_w)
                    text_w = Subtract(sw, Add(Multiply(pad, 2), gutter_w))

                    IfCondition And(GreaterThan(syntax, 0), GreaterThan(llen, 0)) ThenBlock: {
                        // --- SYNTAX HIGHLIGHTING PATH ---
                        span_count = SynColor_Line(syntax, lptr, llen)
                        si = 0
                        draw_x = text_x
                        WhileLoop LessThan(si, span_count) {
                            sp = SynColor_GetSpan(si)
                            s_start = Dereference(sp)
                            s_end = Dereference(Add(sp, 8))
                            s_color = Dereference(Add(sp, 16))
                            s_len = Subtract(s_end, s_start)
                            IfCondition GreaterThan(s_len, 0) ThenBlock: {
                                // VFont_DrawString returns the final X position
                                draw_x = VFont_DrawString(canvas, Add(lptr, s_start), s_len, draw_x, ry, s_color)
                            }
                            si = Add(si, 1)
                        }
                    } ElseBlock: {
                        // --- PLAIN TEXT PATH (original behavior) ---
                        IfCondition GreaterThan(llen, 0) ThenBlock: {
                            tr = AK_ExtraGet(ctx, node, AKExtra.TR_HANDLE)
                            IfCondition LessThan(tr, 0) ThenBlock: {
                                tr = TextRegion_Create(canvas, text_x, ry, text_w, line_h)
                                AK_ExtraSet(ctx, node, AKExtra.TR_HANDLE, tr)
                            }
                            IfCondition GreaterEqual(tr, 0) ThenBlock: {
                                TextRegion_SetRect(tr, text_x, ry, text_w, line_h)
                                TextRegion_SetSurface(tr, canvas)
                                TextRegion_SetColor(tr, fg)
                                TextRegion_SetAlign(tr, TRAlign.LEFT)
                                TextRegion_SetVAlign(tr, TRVAlign.TOP)
                                TextRegion_SetClip(tr, ctx@clip_x, ctx@clip_y, ctx@clip_w, ctx@clip_h)
                                TextRegion_Render(tr, lptr, llen)
                            }
                        }
                    }

                    // Draw cursor on current line
                    IfCondition EqualTo(r, crow) ThenBlock: {
                        cur_w = 0
                        IfCondition GreaterThan(ccol, 0) ThenBlock: {
                            cur_w = VFont_MeasureWidth(lptr, ccol)
                        }
                        cx = Add(text_x, cur_w)
                        max_cx = Subtract(Add(sx, sw), pad)
                        IfCondition GreaterThan(cx, max_cx) ThenBlock: { cx = max_cx }
                        AK_FillRect(ctx, cx, ry, UIScale.ak_cursor_w, line_h, Theme.ak_cursor_color)
                    }

                    ry = Add(ry, line_h)
                    r = Add(r, 1)
                }
                Deallocate(ln_buf, 8)
            }
        }

        // INPUT — single-line text field with cursor, placeholder, password mask
        IfCondition EqualTo(tag, AKTag.INPUT) ThenBlock: {
            inp_bg = AK_ExtraGet(ctx, node, AKExtra.COLOR_BG)
            inp_fg = AK_ExtraGet(ctx, node, AKExtra.COLOR_FG)
            IfCondition EqualTo(inp_bg, 0) ThenBlock: { inp_bg = Theme.ak_input_bg }
            IfCondition EqualTo(inp_fg, 0) ThenBlock: { inp_fg = Theme.text_fg }

            // Border color — accent when focused
            inp_bclr = Theme.ak_input_border
            inp_focus = ctx@focus_node
            IfCondition EqualTo(inp_focus, node) ThenBlock: {
                inp_bclr = Theme.ak_input_focus_border
            }

            // Fill background
            AK_FillRect(ctx, sx, sy, sw, sh, inp_bg)

            // Border (1px)
            inp_bw = UIScale.ak_textfield_border_w
            AK_FillRect(ctx, sx, sy, sw, inp_bw, inp_bclr)
            AK_FillRect(ctx, sx, Add(sy, Subtract(sh, inp_bw)), sw, inp_bw, inp_bclr)
            AK_FillRect(ctx, sx, sy, inp_bw, sh, inp_bclr)
            AK_FillRect(ctx, Add(sx, Subtract(sw, inp_bw)), sy, inp_bw, sh, inp_bclr)

            // Content area
            inp_pad = UIScale.ak_input_pad
            inp_tx = Add(sx, inp_pad)
            inp_ty = Add(sy, inp_pad)
            inp_tw = Subtract(sw, Multiply(inp_pad, 2))
            inp_line_h = VFont_GetLineHeight()

            // Get TextBuffer
            inp_tbh = AK_ExtraGet(ctx, node, AKExtra.TEXTBUF_H)
            IfCondition GreaterEqual(inp_tbh, 0) ThenBlock: {
                inp_lptr = TextBuf_GetLine(inp_tbh, 0)
                inp_llen = 0
                IfCondition NotEqual(inp_lptr, 0) ThenBlock: {
                    inp_llen = StringLength(inp_lptr)
                }
                inp_flags = AK_ExtraGet(ctx, node, AKExtra.ROWS)

                // If empty and not focused, show placeholder
                IfCondition And(EqualTo(inp_llen, 0), NotEqual(inp_focus, node)) ThenBlock: {
                    ph_ptr = AK_ExtraGet(ctx, node, AKExtra.SCROLL_Y)
                    ph_len = AK_ExtraGet(ctx, node, AKExtra.SYNTAX_MODE)
                    IfCondition And(NotEqual(ph_ptr, 0), GreaterThan(ph_len, 0)) ThenBlock: {
                        VFont_DrawString(canvas, ph_ptr, ph_len, inp_tx, inp_ty, Theme.ak_input_placeholder)
                    }
                } ElseBlock: {
                    // Draw text (or masked for password)
                    inp_is_pw = BitwiseAnd(inp_flags, AKInputFlags.PASSWORD)
                    IfCondition And(NotEqual(inp_is_pw, 0), GreaterThan(inp_llen, 0)) ThenBlock: {
                        // Password mode: draw '*' for each character
                        inp_di = 0
                        inp_dx = inp_tx
                        WhileLoop LessThan(inp_di, inp_llen) {
                            VFont_DrawString(canvas, "*", 1, inp_dx, inp_ty, inp_fg)
                            inp_dx = Add(inp_dx, VFont_MeasureWidth("*", 1))
                            inp_di = Add(inp_di, 1)
                        }
                    } ElseBlock: {
                        // Plain text
                        IfCondition GreaterThan(inp_llen, 0) ThenBlock: {
                            VFont_DrawString(canvas, inp_lptr, inp_llen, inp_tx, inp_ty, inp_fg)
                        }
                    }

                    // Cursor (only when focused)
                    IfCondition EqualTo(inp_focus, node) ThenBlock: {
                        inp_ccol = TextBuf_GetCursorCol(inp_tbh)
                        inp_cur_px = 0
                        IfCondition GreaterThan(inp_ccol, 0) ThenBlock: {
                            IfCondition NotEqual(inp_is_pw, 0) ThenBlock: {
                                inp_cur_px = Multiply(inp_ccol, VFont_MeasureWidth("*", 1))
                            } ElseBlock: {
                                inp_cur_px = VFont_MeasureWidth(inp_lptr, inp_ccol)
                            }
                        }
                        inp_cx = Add(inp_tx, inp_cur_px)
                        AK_FillRect(ctx, inp_cx, inp_ty, UIScale.ak_cursor_w, inp_line_h, Theme.ak_cursor_color)
                    }
                }
            }
        }

        // SCROLL container — draw background, clip, offset children, scrollbars
        IfCondition EqualTo(tag, AKTag.SCROLL) ThenBlock: {
            bg = AK_ExtraGet(ctx, node, AKExtra.COLOR_BG)
            IfCondition NotEqual(bg, 0) ThenBlock: {
                AK_FillRect(ctx, sx, sy, sw, sh, bg)
            }

            // Scrollbar dimensions
            sb_w = 14
            sb_min_thumb = 20

            // Compute content extents from children
            sc_last_b = 0
            sc_last_r = 0
            sc_ch = AK_Get(ctx, node, AKF.FIRST_CHILD)
            WhileLoop NotEqual(sc_ch, -1) {
                sc_chv = AK_Get(ctx, sc_ch, AKF.VISIBLE)
                IfCondition EqualTo(sc_chv, 1) ThenBlock: {
                    sc_bot = Add(AK_Get(ctx, sc_ch, AKF.SOLVED_Y), AK_Get(ctx, sc_ch, AKF.SOLVED_H))
                    IfCondition GreaterThan(sc_bot, sc_last_b) ThenBlock: { sc_last_b = sc_bot }
                    sc_rgt = Add(AK_Get(ctx, sc_ch, AKF.SOLVED_X), AK_Get(ctx, sc_ch, AKF.SOLVED_W))
                    IfCondition GreaterThan(sc_rgt, sc_last_r) ThenBlock: { sc_last_r = sc_rgt }
                }
                sc_ch = AK_Get(ctx, sc_ch, AKF.NEXT_SIBLING)
            }
            sc_pad_b = AK_Get(ctx, node, AKF.PAD_B)
            sc_pad_r = AK_Get(ctx, node, AKF.PAD_R)
            sc_content_h = Add(Subtract(sc_last_b, sy), sc_pad_b)
            sc_content_w = Add(Subtract(sc_last_r, sx), sc_pad_r)
            IfCondition LessThan(sc_content_h, 1) ThenBlock: { sc_content_h = 1 }
            IfCondition LessThan(sc_content_w, 1) ThenBlock: { sc_content_w = 1 }

            // Determine which scrollbars are needed
            has_vscroll = 0
            has_hscroll = 0
            IfCondition GreaterThan(sc_content_h, sh) ThenBlock: { has_vscroll = 1 }
            IfCondition GreaterThan(sc_content_w, sw) ThenBlock: { has_hscroll = 1 }
            // Re-check: adding one bar may require the other
            IfCondition And(EqualTo(has_vscroll, 1), EqualTo(has_hscroll, 0)) ThenBlock: {
                IfCondition GreaterThan(sc_content_w, Subtract(sw, sb_w)) ThenBlock: { has_hscroll = 1 }
            }
            IfCondition And(EqualTo(has_hscroll, 1), EqualTo(has_vscroll, 0)) ThenBlock: {
                IfCondition GreaterThan(sc_content_h, Subtract(sh, sb_w)) ThenBlock: { has_vscroll = 1 }
            }

            // Viewport dimensions (reduced by scrollbar presence)
            vp_w = sw
            vp_h = sh
            IfCondition EqualTo(has_vscroll, 1) ThenBlock: { vp_w = Subtract(sw, sb_w) }
            IfCondition EqualTo(has_hscroll, 1) ThenBlock: { vp_h = Subtract(sh, sb_w) }

            // --- Vertical scrollbar ---
            IfCondition EqualTo(has_vscroll, 1) ThenBlock: {
                vtrack_x = Subtract(Add(sx, sw), sb_w)
                vtrack_h = vp_h
                AK_FillRect(ctx, vtrack_x, sy, sb_w, vtrack_h, Theme.scrollbar_track)

                sc_max_y = Subtract(sc_content_h, vp_h)
                IfCondition LessThan(sc_max_y, 1) ThenBlock: { sc_max_y = 1 }
                vthumb_h = Divide(Multiply(vp_h, vp_h), sc_content_h)
                IfCondition LessThan(vthumb_h, sb_min_thumb) ThenBlock: { vthumb_h = sb_min_thumb }
                vtrack_space = Subtract(vtrack_h, vthumb_h)
                scr_y_cur = AK_ExtraGet(ctx, node, AKExtra.SCROLL_Y)
                vthumb_off = Divide(Multiply(scr_y_cur, vtrack_space), sc_max_y)
                vthumb_y = Add(sy, vthumb_off)
                AK_FillRect(ctx, Add(vtrack_x, 1), vthumb_y, Subtract(sb_w, 2), vthumb_h, Theme.scrollbar_thumb)
            }

            // --- Horizontal scrollbar ---
            IfCondition EqualTo(has_hscroll, 1) ThenBlock: {
                htrack_y = Subtract(Add(sy, sh), sb_w)
                htrack_w = vp_w
                AK_FillRect(ctx, sx, htrack_y, htrack_w, sb_w, Theme.scrollbar_track)

                sc_max_x = Subtract(sc_content_w, vp_w)
                IfCondition LessThan(sc_max_x, 1) ThenBlock: { sc_max_x = 1 }
                hthumb_w = Divide(Multiply(vp_w, vp_w), sc_content_w)
                IfCondition LessThan(hthumb_w, sb_min_thumb) ThenBlock: { hthumb_w = sb_min_thumb }
                htrack_space = Subtract(htrack_w, hthumb_w)
                scr_x_cur = AK_ExtraGet(ctx, node, AKExtra.SCROLL_X)
                hthumb_off = Divide(Multiply(scr_x_cur, htrack_space), sc_max_x)
                hthumb_x = Add(sx, hthumb_off)
                AK_FillRect(ctx, hthumb_x, Add(htrack_y, 1), hthumb_w, Subtract(sb_w, 2), Theme.scrollbar_thumb)
            }

            // Corner fill when both scrollbars present
            IfCondition And(EqualTo(has_vscroll, 1), EqualTo(has_hscroll, 1)) ThenBlock: {
                AK_FillRect(ctx, Subtract(Add(sx, sw), sb_w), Subtract(Add(sy, sh), sb_w), sb_w, sb_w, Theme.scrollbar_track)
            }

            // Push clip for children (viewport minus scrollbars)
            AK_ClipPush(ctx, sx, sy, vp_w, vp_h)
            old_soy = ctx@scroll_offset_y
            old_sox = ctx@scroll_offset_x
            scr_y = AK_ExtraGet(ctx, node, AKExtra.SCROLL_Y)
            scr_x = AK_ExtraGet(ctx, node, AKExtra.SCROLL_X)
            ctx@scroll_offset_y = Add(old_soy, scr_y)
            ctx@scroll_offset_x = Add(old_sox, scr_x)
            child = AK_Get(ctx, node, AKF.FIRST_CHILD)
            WhileLoop NotEqual(child, -1) {
                AK_DrawNode(ctx, child)
                child = AK_Get(ctx, child, AKF.NEXT_SIBLING)
            }
            ctx@scroll_offset_y = old_soy
            ctx@scroll_offset_x = old_sox
            AK_ClipPop(ctx)
            ReturnValue(0)
        }

        // Recurse children — push clip for container nodes
        is_container = 0
        IfCondition Or(EqualTo(tag, AKTag.GROUP), EqualTo(tag, AKTag.WINDOW)) ThenBlock: { is_container = 1 }
        IfCondition EqualTo(tag, AKTag.PANEL) ThenBlock: { is_container = 1 }

        IfCondition EqualTo(is_container, 1) ThenBlock: {
            AK_ClipPush(ctx, sx, sy, sw, sh)
        }

        child = AK_Get(ctx, node, AKF.FIRST_CHILD)
        WhileLoop NotEqual(child, -1) {
            AK_DrawNode(ctx, child)
            child = AK_Get(ctx, child, AKF.NEXT_SIBLING)
        }

        IfCondition EqualTo(is_container, 1) ThenBlock: {
            AK_ClipPop(ctx)
        }
        ReturnValue(0)
    }
}

// =============================================================================
// DRAW ALL — solve + render entire tree
// =============================================================================
Function.AK_Draw {
    Input: ctx: LinkagePool.AKContext
    Input: canvas: Integer
    Input: canvas_w: Integer
    Input: canvas_h: Integer
    Body: {
        DebugLog_Push("ak.drw", 6)
        ctx@canvas = canvas

        // Initialize clip rect to full canvas
        AK_ClipInit(ctx)
        ctx@clip_x = 0
        ctx@clip_y = 0
        ctx@clip_w = canvas_w
        ctx@clip_h = canvas_h
        ctx@scroll_offset_y = 0
        ctx@scroll_offset_x = 0

        AK_Solve(ctx, canvas_w, canvas_h)
        AK_DrawNode(ctx, ctx@tree_root)
        ReturnValue(0)
    }
}

// =============================================================================
// AK_ClearChildren — remove all children from a node
// Resets FIRST_CHILD to -1 and detaches the child chain.
// Does NOT free node slots (they remain allocated but orphaned).
// =============================================================================
Function.AK_ClearChildren {
    Input: ctx: LinkagePool.AKContext
    Input: parent: Integer
    Body: {
        DebugLog_Push("ak.clc", 6)
        IfCondition LessThan(parent, 0) ThenBlock: { ReturnValue(0) }
        AK_Set(ctx, parent, AKF.FIRST_CHILD, -1)
    }
}

// =============================================================================
// AK_FindById — locate a node by its HTML id attribute (DJB2 hash match)
// Pass the raw id string; computes hash internally.
// Returns node index or -1 if not found.
// =============================================================================
Function.AK_FindById {
    Input: ctx: LinkagePool.AKContext
    Input: id_str: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(id_str, 0) ThenBlock: { ReturnValue(-1) }

        // Compute DJB2 hash of id string
        fid_hash = 5381
        fid_len = StringLength(id_str)
        fid_i = 0
        WhileLoop LessThan(fid_i, fid_len) {
            fid_c = GetByte(id_str, fid_i)
            fid_hash = Add(Multiply(fid_hash, 33), fid_c)
            fid_i = Add(fid_i, 1)
        }

        // Linear scan through all nodes
        fid_cnt = ctx@tree_count
        fid_n = 0
        WhileLoop LessThan(fid_n, fid_cnt) {
            fid_nh = AK_Get(ctx, fid_n, AKF.ID_HASH)
            IfCondition EqualTo(fid_nh, fid_hash) ThenBlock: {
                ReturnValue(fid_n)
            }
            fid_n = Add(fid_n, 1)
        }
        ReturnValue(-1)
    }
}

// =============================================================================
// AK_SetInputValue — set the text content of an INPUT node
// Clears existing TextBuffer content and replaces with new text.
// Works for any node that has a TextBuffer handle (INPUT, TEXTFIELD).
// =============================================================================
Function.AK_SetInputValue {
    Input: ctx: LinkagePool.AKContext
    Input: node: Integer
    Input: text: Address
    Input: text_len: Integer
    Body: {
        IfCondition LessThan(node, 0) ThenBlock: { ReturnValue(0) }

        tbh = AK_ExtraGet(ctx, node, AKExtra.TEXTBUF_H)
        IfCondition LessEqual(tbh, 0) ThenBlock: { ReturnValue(0) }

        // Clear existing content
        TextBuf_Clear(tbh)

        // Insert new text if non-empty
        IfCondition And(NotEqual(text, 0), GreaterThan(text_len, 0)) ThenBlock: {
            TextBuf_SetText(tbh, text, text_len)
        }

        // Mark dirty for redraw
        AK_Set(ctx, node, AKF.DIRTY, 1)
        dc = ctx@dirty_count
        ctx@dirty_count = Add(dc, 1)
    }
}
