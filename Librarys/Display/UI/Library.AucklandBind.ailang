LibraryImport.Arrays
LibraryImport.Display.Content.HTMLParse
LibraryImport.Display.UI.Auckland
LibraryImport.Display.UI.AucklandEvent
LibraryImport.TextBuffer
LibraryImport.Display.Content.DocSess
LibraryImport.Display.Render.VIcon

// =============================================================================
// BIND STATE
// =============================================================================
FixedPool.AKBind {
    "error":      Initialize=0, CanChange=True
    "error_msg":  Initialize=0, CanChange=True
    "node_count": Initialize=0, CanChange=True
    "doc_sess":   Initialize=0, CanChange=True
}

// =============================================================================
// COLOR PARSER — #RGB, #RRGGBB, #RRGGBBAA → packed BGRA
// =============================================================================
Function.AKBind_HexDigit {
    Input: ch: Integer
    Output: Integer
    Body: {
        // 0-9
        IfCondition And(GreaterEqual(ch, 48), LessEqual(ch, 57)) ThenBlock: {
            ReturnValue(Subtract(ch, 48))
        }
        // A-F
        IfCondition And(GreaterEqual(ch, 65), LessEqual(ch, 70)) ThenBlock: {
            ReturnValue(Add(Subtract(ch, 65), 10))
        }
        // a-f
        IfCondition And(GreaterEqual(ch, 97), LessEqual(ch, 102)) ThenBlock: {
            ReturnValue(Add(Subtract(ch, 97), 10))
        }
        ReturnValue(0)
    }
}

// Parse 2 hex digits at offset into a byte value
Function.AKBind_HexByte {
    Input: str: Address
    Input: offset: Integer
    Output: Integer
    Body: {
        hi = AKBind_HexDigit(GetByte(str, offset))
        lo = AKBind_HexDigit(GetByte(str, Add(offset, 1)))
        ReturnValue(Add(Multiply(hi, 16), lo))
    }
}

// Parse #RGB (4 chars) → packed color
Function.AKBind_ParseColorRGB {
    Input: str: Address
    Output: Integer
    Body: {
        h1 = AKBind_HexDigit(GetByte(str, 1))
        h2 = AKBind_HexDigit(GetByte(str, 2))
        h3 = AKBind_HexDigit(GetByte(str, 3))
        r = Add(Multiply(h1, 16), h1)
        g = Add(Multiply(h2, 16), h2)
        b = Add(Multiply(h3, 16), h3)
        ReturnValue(TVG_PackColor(r, g, b, 255))
    }
}

// Parse #RRGGBB (7 chars) → packed color
Function.AKBind_ParseColorRRGGBB {
    Input: str: Address
    Output: Integer
    Body: {
        r = AKBind_HexByte(str, 1)
        g = AKBind_HexByte(str, 3)
        b = AKBind_HexByte(str, 5)
        ReturnValue(TVG_PackColor(r, g, b, 255))
    }
}

// Parse #RRGGBBAA (9 chars) → packed color
Function.AKBind_ParseColorRRGGBBAA {
    Input: str: Address
    Output: Integer
    Body: {
        r = AKBind_HexByte(str, 1)
        g = AKBind_HexByte(str, 3)
        b = AKBind_HexByte(str, 5)
        a = AKBind_HexByte(str, 7)
        ReturnValue(TVG_PackColor(r, g, b, a))
    }
}

Function.AKBind_ParseColor {
    Input: str: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(str, 0) ThenBlock: { ReturnValue(0) }
        c0 = GetByte(str, 0)
        IfCondition NotEqual(c0, 35) ThenBlock: { ReturnValue(0) }
        len = StringLength(str)
        IfCondition EqualTo(len, 4) ThenBlock: { ReturnValue(AKBind_ParseColorRGB(str)) }
        IfCondition EqualTo(len, 7) ThenBlock: { ReturnValue(AKBind_ParseColorRRGGBB(str)) }
        IfCondition EqualTo(len, 9) ThenBlock: { ReturnValue(AKBind_ParseColorRRGGBBAA(str)) }
        ReturnValue(0)
    }
}

// =============================================================================
// NUMBER PARSER — string → integer
// =============================================================================
Function.AKBind_ParseInt {
    Input: str: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(str, 0) ThenBlock: { ReturnValue(0) }
        len = StringLength(str)
        IfCondition EqualTo(len, 0) ThenBlock: { ReturnValue(0) }

        result = 0
        neg = 0
        pi = 0

        // Check for negative
        fc = GetByte(str, 0)
        IfCondition EqualTo(fc, 45) ThenBlock: {
            neg = 1
            pi = 1
        }

        WhileLoop LessThan(pi, len) {
            dc = GetByte(str, pi)
            IfCondition And(GreaterEqual(dc, 48), LessEqual(dc, 57)) ThenBlock: {
                dv = Subtract(dc, 48)
                result = Add(Multiply(result, 10), dv)
            }
            pi = Add(pi, 1)
        }

        IfCondition EqualTo(neg, 1) ThenBlock: {
            result = Multiply(result, -1)
        }
        ReturnValue(result)
    }
}

// =============================================================================
// TAG NAME → AKTag MAPPING
// =============================================================================
// Split into two halves to keep locals under 20
Function.AKBind_TagNameToAKTag1 {
    Input: name: Address
    Output: Integer
    Body: {
        cmp = StringCompare(name, "window")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(AKTag.WINDOW) }
        cmp = StringCompare(name, "group")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(AKTag.GROUP) }
        cmp = StringCompare(name, "panel")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(AKTag.PANEL) }
        cmp = StringCompare(name, "scroll")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(AKTag.SCROLL) }
        cmp = StringCompare(name, "tabs")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(AKTag.TABS) }
        cmp = StringCompare(name, "tab")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(AKTag.TAB) }
        cmp = StringCompare(name, "button")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(AKTag.BUTTON) }
        cmp = StringCompare(name, "label")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(AKTag.LABEL) }
        cmp = StringCompare(name, "text")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(AKTag.TEXT) }
        cmp = StringCompare(name, "display")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(AKTag.DISPLAY) }
        ReturnValue(-1)
    }
}

Function.AKBind_TagNameToAKTag2 {
    Input: name: Address
    Output: Integer
    Body: {
        cmp = StringCompare(name, "checkbox")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(AKTag.CHECKBOX) }
        cmp = StringCompare(name, "radio")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(AKTag.RADIO) }
        cmp = StringCompare(name, "slider")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(AKTag.SLIDER) }
        cmp = StringCompare(name, "progress")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(AKTag.PROGRESS) }
        cmp = StringCompare(name, "image")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(AKTag.IMAGE) }
        cmp = StringCompare(name, "canvas")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(AKTag.CANVAS) }
        cmp = StringCompare(name, "spacer")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(AKTag.SPACER) }
        cmp = StringCompare(name, "separator")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(AKTag.SEPARATOR) }
        cmp = StringCompare(name, "textfield")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(AKTag.TEXTFIELD) }
        cmp = StringCompare(name, "input")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(AKTag.INPUT) }
        cmp = StringCompare(name, "docview")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(AKTag.DOCVIEW) }
        cmp = StringCompare(name, "theme")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(AKTag.THEME) }
        ReturnValue(-1)
    }
}

Function.AKBind_TagNameToAKTag {
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }
        r = AKBind_TagNameToAKTag1(name)
        IfCondition NotEqual(r, -1) ThenBlock: { ReturnValue(r) }
        r = AKBind_TagNameToAKTag2(name)
        IfCondition NotEqual(r, -1) ThenBlock: { ReturnValue(r) }
        // Unknown tag — print warning
        PrintMessage("[AKBind] unknown tag: ")
        PrintMessage(name)
        PrintMessage("\n")
        ReturnValue(0)
    }
}

// =============================================================================
// LAYOUT MODE PARSER
// =============================================================================
Function.AKBind_ParseLayout {
    Input: val: Address
    Output: Integer
    Body: {
        cmp_vb = StringCompare(val, "vbox")
        IfCondition EqualTo(cmp_vb, 0) ThenBlock: { ReturnValue(AKLayout.VBOX) }

        cmp_hb = StringCompare(val, "hbox")
        IfCondition EqualTo(cmp_hb, 0) ThenBlock: { ReturnValue(AKLayout.HBOX) }

        cmp_gr = StringCompare(val, "grid")
        IfCondition EqualTo(cmp_gr, 0) ThenBlock: { ReturnValue(AKLayout.GRID) }

        cmp_fl = StringCompare(val, "flow")
        IfCondition EqualTo(cmp_fl, 0) ThenBlock: { ReturnValue(AKLayout.FLOW) }

        ReturnValue(AKLayout.VBOX)
    }
}

// =============================================================================
// ALIGNMENT PARSER
// =============================================================================
Function.AKBind_ParseAlign {
    Input: val: Address
    Output: Integer
    Body: {
        cmp_st = StringCompare(val, "start")
        IfCondition EqualTo(cmp_st, 0) ThenBlock: { ReturnValue(AKAlign.START) }

        cmp_ct = StringCompare(val, "center")
        IfCondition EqualTo(cmp_ct, 0) ThenBlock: { ReturnValue(AKAlign.CENTER) }

        cmp_en = StringCompare(val, "end")
        IfCondition EqualTo(cmp_en, 0) ThenBlock: { ReturnValue(AKAlign.END) }

        cmp_sr = StringCompare(val, "stretch")
        IfCondition EqualTo(cmp_sr, 0) ThenBlock: { ReturnValue(AKAlign.STRETCH) }

        ReturnValue(AKAlign.STRETCH)
    }
}

// =============================================================================
// TEXT ALIGN PARSER
// =============================================================================
Function.AKBind_ParseTextAlign {
    Input: val: Address
    Output: Integer
    Body: {
        cmp_l = StringCompare(val, "left")
        IfCondition EqualTo(cmp_l, 0) ThenBlock: { ReturnValue(TRAlign.LEFT) }

        cmp_c = StringCompare(val, "center")
        IfCondition EqualTo(cmp_c, 0) ThenBlock: { ReturnValue(TRAlign.CENTER) }

        cmp_r = StringCompare(val, "right")
        IfCondition EqualTo(cmp_r, 0) ThenBlock: { ReturnValue(TRAlign.RIGHT) }

        ReturnValue(TRAlign.LEFT)
    }
}

// =============================================================================
// APPLY SINGLE ATTRIBUTE TO AK NODE — split into sub-dispatchers
// =============================================================================

// Layout attrs: layout, gap, padding, pad-t/r/b/l, grow, shrink, width, height
Function.AKBind_ApplyLayout {
    Input: ctx: LinkagePool.AKContext
    Input: ak_node: Integer
    Input: attr_name: Address
    Input: attr_val: Address
    Output: Integer
    Body: {
        cmp = StringCompare(attr_name, "layout")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            AK_Set(ctx, ak_node, AKF.LAYOUT_MODE, AKBind_ParseLayout(attr_val))
            ReturnValue(1)
        }
        cmp = StringCompare(attr_name, "gap")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            AK_Set(ctx, ak_node, AKF.GAP, AKBind_ParseInt(attr_val))
            ReturnValue(1)
        }
        cmp = StringCompare(attr_name, "padding")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            pv = AKBind_ParseInt(attr_val)
            AK_Set(ctx, ak_node, AKF.PAD_T, pv)
            AK_Set(ctx, ak_node, AKF.PAD_R, pv)
            AK_Set(ctx, ak_node, AKF.PAD_B, pv)
            AK_Set(ctx, ak_node, AKF.PAD_L, pv)
            ReturnValue(1)
        }
        cmp = StringCompare(attr_name, "pad-t")
        IfCondition EqualTo(cmp, 0) ThenBlock: { AK_Set(ctx, ak_node, AKF.PAD_T, AKBind_ParseInt(attr_val)) ReturnValue(1) }
        cmp = StringCompare(attr_name, "pad-r")
        IfCondition EqualTo(cmp, 0) ThenBlock: { AK_Set(ctx, ak_node, AKF.PAD_R, AKBind_ParseInt(attr_val)) ReturnValue(1) }
        cmp = StringCompare(attr_name, "pad-b")
        IfCondition EqualTo(cmp, 0) ThenBlock: { AK_Set(ctx, ak_node, AKF.PAD_B, AKBind_ParseInt(attr_val)) ReturnValue(1) }
        cmp = StringCompare(attr_name, "pad-l")
        IfCondition EqualTo(cmp, 0) ThenBlock: { AK_Set(ctx, ak_node, AKF.PAD_L, AKBind_ParseInt(attr_val)) ReturnValue(1) }
        cmp = StringCompare(attr_name, "grow")
        IfCondition EqualTo(cmp, 0) ThenBlock: { AK_Set(ctx, ak_node, AKF.GROW, AKBind_ParseInt(attr_val)) ReturnValue(1) }
        cmp = StringCompare(attr_name, "shrink")
        IfCondition EqualTo(cmp, 0) ThenBlock: { AK_Set(ctx, ak_node, AKF.SHRINK, AKBind_ParseInt(attr_val)) ReturnValue(1) }
        ReturnValue(0)
    }
}

// Size attrs: width, height, min-w/h, max-w/h, cols, align
Function.AKBind_ApplySize {
    Input: ctx: LinkagePool.AKContext
    Input: ak_node: Integer
    Input: attr_name: Address
    Input: attr_val: Address
    Output: Integer
    Body: {
        cmp = StringCompare(attr_name, "width")
        IfCondition EqualTo(cmp, 0) ThenBlock: { AK_Set(ctx, ak_node, AKF.WIDTH, AKBind_ParseInt(attr_val)) ReturnValue(1) }
        cmp = StringCompare(attr_name, "height")
        IfCondition EqualTo(cmp, 0) ThenBlock: { AK_Set(ctx, ak_node, AKF.HEIGHT, AKBind_ParseInt(attr_val)) ReturnValue(1) }
        cmp = StringCompare(attr_name, "min-w")
        IfCondition EqualTo(cmp, 0) ThenBlock: { AK_Set(ctx, ak_node, AKF.MIN_W, AKBind_ParseInt(attr_val)) ReturnValue(1) }
        cmp = StringCompare(attr_name, "min-h")
        IfCondition EqualTo(cmp, 0) ThenBlock: { AK_Set(ctx, ak_node, AKF.MIN_H, AKBind_ParseInt(attr_val)) ReturnValue(1) }
        cmp = StringCompare(attr_name, "max-w")
        IfCondition EqualTo(cmp, 0) ThenBlock: { AK_Set(ctx, ak_node, AKF.MAX_W, AKBind_ParseInt(attr_val)) ReturnValue(1) }
        cmp = StringCompare(attr_name, "max-h")
        IfCondition EqualTo(cmp, 0) ThenBlock: { AK_Set(ctx, ak_node, AKF.MAX_H, AKBind_ParseInt(attr_val)) ReturnValue(1) }
        cmp = StringCompare(attr_name, "cols")
        IfCondition EqualTo(cmp, 0) ThenBlock: { AK_Set(ctx, ak_node, AKF.COLS, AKBind_ParseInt(attr_val)) ReturnValue(1) }
        cmp = StringCompare(attr_name, "align")
        IfCondition EqualTo(cmp, 0) ThenBlock: { AK_Set(ctx, ak_node, AKF.ALIGN, AKBind_ParseAlign(attr_val)) ReturnValue(1) }
        ReturnValue(0)
    }
}

// ID + style extras: id, bg, fg, label, text, action, font-size, text-align, border, border-color
Function.AKBind_ApplyStyle {
    Input: ctx: LinkagePool.AKContext
    Input: ak_node: Integer
    Input: attr_name: Address
    Input: attr_val: Address
    Output: Integer
    Body: {
        cmp = StringCompare(attr_name, "id")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            id_hash = 5381
            id_len = StringLength(attr_val)
            id_i = 0
            WhileLoop LessThan(id_i, id_len) {
                id_c = GetByte(attr_val, id_i)
                id_hash = Add(Multiply(id_hash, 33), id_c)
                id_i = Add(id_i, 1)
            }
            AK_Set(ctx, ak_node, AKF.ID_HASH, id_hash)
            ReturnValue(1)
        }
        cmp = StringCompare(attr_name, "bg")
        IfCondition EqualTo(cmp, 0) ThenBlock: { AK_ExtraSet(ctx, ak_node, AKExtra.COLOR_BG, AKBind_ParseColor(attr_val)) ReturnValue(1) }
        cmp = StringCompare(attr_name, "fg")
        IfCondition EqualTo(cmp, 0) ThenBlock: { AK_ExtraSet(ctx, ak_node, AKExtra.COLOR_FG, AKBind_ParseColor(attr_val)) ReturnValue(1) }
        cmp = StringCompare(attr_name, "label")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            AK_ExtraSet(ctx, ak_node, AKExtra.STR_PTR, attr_val)
            AK_ExtraSet(ctx, ak_node, AKExtra.STR_LEN, StringLength(attr_val))
            ReturnValue(1)
        }
        cmp = StringCompare(attr_name, "text")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            AK_ExtraSet(ctx, ak_node, AKExtra.STR_PTR, attr_val)
            AK_ExtraSet(ctx, ak_node, AKExtra.STR_LEN, StringLength(attr_val))
            ReturnValue(1)
        }
        cmp = StringCompare(attr_name, "action")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            AK_ExtraSet(ctx, ak_node, AKExtra.ACTION_PTR, attr_val)
            AK_ExtraSet(ctx, ak_node, AKExtra.ACTION_LEN, StringLength(attr_val))
            ReturnValue(1)
        }
        cmp = StringCompare(attr_name, "font-size")
        IfCondition EqualTo(cmp, 0) ThenBlock: { AK_ExtraSet(ctx, ak_node, AKExtra.FONT_SIZE, AKBind_ParseInt(attr_val)) ReturnValue(1) }
        cmp = StringCompare(attr_name, "text-align")
        IfCondition EqualTo(cmp, 0) ThenBlock: { AK_ExtraSet(ctx, ak_node, AKExtra.TEXT_ALIGN, AKBind_ParseTextAlign(attr_val)) ReturnValue(1) }
        cmp = StringCompare(attr_name, "border")
        IfCondition EqualTo(cmp, 0) ThenBlock: { AK_ExtraSet(ctx, ak_node, AKExtra.BORDER_W, AKBind_ParseInt(attr_val)) ReturnValue(1) }
        cmp = StringCompare(attr_name, "border-color")
        IfCondition EqualTo(cmp, 0) ThenBlock: { AK_ExtraSet(ctx, ak_node, AKExtra.BORDER_CLR, AKBind_ParseColor(attr_val)) ReturnValue(1) }
        cmp = StringCompare(attr_name, "icon")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            isurf = VIcon_RasterNamed(IconTier.WIDGETS, attr_val, 16)
            IfCondition EqualTo(isurf, 0) ThenBlock: {
                isurf = VIcon_Resolve(attr_val)
            }
            AK_ExtraSet(ctx, ak_node, AKExtra.ICON_SURF, isurf)
            ReturnValue(1)
        }
        ReturnValue(0)
    }
}

// Window attrs: design-w/h, title, toolbar, addressbar
Function.AKBind_ApplyWindow {
    Input: ctx: LinkagePool.AKContext
    Input: ak_node: Integer
    Input: attr_name: Address
    Input: attr_val: Address
    Output: Integer
    Body: {
        cmp = StringCompare(attr_name, "design-w")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ctx@design_w = AKBind_ParseInt(attr_val) ReturnValue(1) }
        cmp = StringCompare(attr_name, "design-h")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ctx@design_h = AKBind_ParseInt(attr_val) ReturnValue(1) }
        cmp = StringCompare(attr_name, "title")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            AK_ExtraSet(ctx, ak_node, AKExtra.STR_PTR, attr_val)
            AK_ExtraSet(ctx, ak_node, AKExtra.STR_LEN, StringLength(attr_val))
            ReturnValue(1)
        }
        cmp = StringCompare(attr_name, "toolbar")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            ReturnValue(AKBind_ApplyToolbar(ctx, attr_val))
        }
        cmp = StringCompare(attr_name, "addressbar")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            cmp2 = StringCompare(attr_val, "true")
            IfCondition EqualTo(cmp2, 0) ThenBlock: { ctx@addressbar = 1 }
            ReturnValue(1)
        }
        cmp = StringCompare(attr_name, "shell")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            cmp2 = StringCompare(attr_val, "deskbar")
            IfCondition EqualTo(cmp2, 0) ThenBlock: { ctx@shell_mode = 1 }
            ReturnValue(1)
        }
        ReturnValue(0)
    }
}

// Toolbar value parser (sub-helper to keep locals low)
Function.AKBind_ApplyToolbar {
    Input: ctx: LinkagePool.AKContext
    Input: attr_val: Address
    Output: Integer
    Body: {
        cmp = StringCompare(attr_val, "none")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ctx@toolbar_mode = TBMode.NONE ReturnValue(1) }
        cmp = StringCompare(attr_val, "about")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ctx@toolbar_mode = TBMode.ABOUT ReturnValue(1) }
        cmp = StringCompare(attr_val, "file")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ctx@toolbar_mode = TBMode.FILE ReturnValue(1) }
        cmp = StringCompare(attr_val, "full")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ctx@toolbar_mode = TBMode.FULL ReturnValue(1) }
        cmp = StringCompare(attr_val, "browser")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ctx@toolbar_mode = TBMode.BROWSER ReturnValue(1) }
        ctx@toolbar_mode = TBMode.ABOUT
        ReturnValue(1)
    }
}

// Text widget attrs: syntax, line-numbers, current-line
Function.AKBind_ApplyTextWidget {
    Input: ctx: LinkagePool.AKContext
    Input: ak_node: Integer
    Input: attr_name: Address
    Input: attr_val: Address
    Output: Integer
    Body: {
        cmp = StringCompare(attr_name, "syntax")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            cmp2 = StringCompare(attr_val, "ailang")
            IfCondition EqualTo(cmp2, 0) ThenBlock: { AK_ExtraSet(ctx, ak_node, AKExtra.SYNTAX_MODE, 1) }
            ReturnValue(1)
        }
        cmp = StringCompare(attr_name, "line-numbers")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            cmp2 = StringCompare(attr_val, "1")
            IfCondition EqualTo(cmp2, 0) ThenBlock: { AK_ExtraSet(ctx, ak_node, AKExtra.LINE_NUMBERS, 1) }
            ReturnValue(1)
        }
        cmp = StringCompare(attr_name, "current-line")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            cmp2 = StringCompare(attr_val, "1")
            IfCondition EqualTo(cmp2, 0) ThenBlock: {
                old_flags = AK_Get(ctx, ak_node, AKF.FLAGS)
                AK_Set(ctx, ak_node, AKF.FLAGS, BitwiseOr(old_flags, AKFlags.HIGHLIGHT_LINE))
            }
            ReturnValue(1)
        }
        ReturnValue(0)
    }
}

// Input-specific attrs: placeholder, type, maxlength, value
Function.AKBind_ApplyInput {
    Input: ctx: LinkagePool.AKContext
    Input: ak_node: Integer
    Input: attr_name: Address
    Input: attr_val: Address
    Output: Integer
    Body: {
        cmp = StringCompare(attr_name, "placeholder")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            AK_ExtraSet(ctx, ak_node, AKExtra.SCROLL_Y, attr_val)
            AK_ExtraSet(ctx, ak_node, AKExtra.SYNTAX_MODE, StringLength(attr_val))
            ReturnValue(1)
        }
        cmp = StringCompare(attr_name, "type")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            cmp2 = StringCompare(attr_val, "password")
            IfCondition EqualTo(cmp2, 0) ThenBlock: {
                old_flags = AK_ExtraGet(ctx, ak_node, AKExtra.ROWS)
                AK_ExtraSet(ctx, ak_node, AKExtra.ROWS, BitwiseOr(old_flags, AKInputFlags.PASSWORD))
            }
            ReturnValue(1)
        }
        cmp = StringCompare(attr_name, "maxlength")
        IfCondition EqualTo(cmp, 0) ThenBlock: { AK_ExtraSet(ctx, ak_node, AKExtra.LINE_NUMBERS, AKBind_ParseInt(attr_val)) ReturnValue(1) }
        cmp = StringCompare(attr_name, "value")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            AK_ExtraSet(ctx, ak_node, AKExtra.STR_PTR, attr_val)
            AK_ExtraSet(ctx, ak_node, AKExtra.STR_LEN, StringLength(attr_val))
            ReturnValue(1)
        }
        ReturnValue(0)
    }
}

// Main dispatcher — tries each sub-handler in order
Function.AKBind_ApplyAttr {
    Input: ctx: LinkagePool.AKContext
    Input: ak_node: Integer
    Input: attr_name: Address
    Input: attr_val: Address
    Body: {
        r = AKBind_ApplyLayout(ctx, ak_node, attr_name, attr_val)
        IfCondition EqualTo(r, 1) ThenBlock: { ReturnValue(0) }
        r = AKBind_ApplySize(ctx, ak_node, attr_name, attr_val)
        IfCondition EqualTo(r, 1) ThenBlock: { ReturnValue(0) }
        r = AKBind_ApplyStyle(ctx, ak_node, attr_name, attr_val)
        IfCondition EqualTo(r, 1) ThenBlock: { ReturnValue(0) }
        r = AKBind_ApplyWindow(ctx, ak_node, attr_name, attr_val)
        IfCondition EqualTo(r, 1) ThenBlock: { ReturnValue(0) }
        r = AKBind_ApplyTextWidget(ctx, ak_node, attr_name, attr_val)
        IfCondition EqualTo(r, 1) ThenBlock: { ReturnValue(0) }
        r = AKBind_ApplyInput(ctx, ak_node, attr_name, attr_val)
        IfCondition EqualTo(r, 1) ThenBlock: { ReturnValue(0) }
        r = AKBind_ApplyDocViewAttr(ctx, ak_node, attr_name, attr_val)
        IfCondition EqualTo(r, 1) ThenBlock: { ReturnValue(0) }
        // Unknown attribute — silent skip
        ReturnValue(0)
    }
}

Function.AKBind_ApplyDocViewAttr {
    Input: ctx: LinkagePool.AKContext
    Input: ak_node: Integer
    Input: attr_name: Address
    Input: attr_val: Address
    Output: Integer
    Body: {
        tag = AK_Get(ctx, ak_node, AKF.TAG)
        IfCondition NotEqual(tag, AKTag.DOCVIEW) ThenBlock: {
            ReturnValue(0)
        }
        cmp = StringCompare(attr_name, "paper")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            AK_ExtraSet(ctx, ak_node, AKExtra.VALUE, AKBind_ParsePaper(attr_val))
            ReturnValue(1)
        }
        cmp = StringCompare(attr_name, "orientation")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            AK_ExtraSet(ctx, ak_node, AKExtra.ROWS, AKBind_ParseOrient(attr_val))
            ReturnValue(1)
        }
        cmp = StringCompare(attr_name, "readonly")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            AK_ExtraSet(ctx, ak_node, AKExtra.SYNTAX_MODE, 1)
            ReturnValue(1)
        }
        ReturnValue(0)
    }
}

Function.AKBind_ParsePaper {
    Input: val: Address
    Output: Integer
    Body: {
        cmp = StringCompare(val, "letter")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
        cmp = StringCompare(val, "legal")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(2) }
        cmp = StringCompare(val, "a4")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(3) }
        cmp = StringCompare(val, "a3")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(4) }
        PrintMessage("[AKBind] docview paper not named; using letter\n")
        ReturnValue(1)
    }
}

Function.AKBind_InitDocView {
    Input: ctx: LinkagePool.AKContext
    Input: ak_node: Integer
    Body: {
        paper = AK_ExtraGet(ctx, ak_node, AKExtra.VALUE)
        IfCondition EqualTo(paper, 0) ThenBlock: {
            paper = 1
        }
        orient = AK_ExtraGet(ctx, ak_node, AKExtra.ROWS)
        AKBind.doc_sess = DocSess_Create(paper, orient)
        AK_ExtraSet(ctx, ak_node, AKExtra.TEXTBUF_H, AKBind.doc_sess)
        DocSess_SetNode(AKBind.doc_sess, ak_node)
        ro = AK_ExtraGet(ctx, ak_node, AKExtra.SYNTAX_MODE)
        IfCondition EqualTo(ro, 1) ThenBlock: {
            DocSess_SetReadonly(AKBind.doc_sess)
        }
        IfCondition LessThan(ctx@focus_node, 0) ThenBlock: {
            ctx@focus_node = ak_node
        }
    }
}

Function.AKBind_ParseOrient {
    Input: val: Address
    Output: Integer
    Body: {
        cmp = StringCompare(val, "landscape")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

// =============================================================================
// BIND HTML NODE → AK NODE (recursive)
// =============================================================================
Function.AKBind_Node {
    Input: ctx: LinkagePool.AKContext
    Input: html_node: Integer
    Input: ak_parent: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(html_node, 0) ThenBlock: { ReturnValue(-1) }

        ntype = HTML_GetNodeType(html_node)

        // Skip text nodes — Auckland doesn't have inline text
        IfCondition EqualTo(ntype, HNode.TEXT) ThenBlock: { ReturnValue(-1) }

        // Skip non-element nodes
        IfCondition NotEqual(ntype, HNode.ELEMENT) ThenBlock: {
            // For ROOT node, process children directly
            IfCondition EqualTo(ntype, HNode.ROOT) ThenBlock: {
                rchild = HTML_GetFirstChild(html_node)
                WhileLoop NotEqual(rchild, -1) {
                    AKBind_Node(ctx, rchild, ak_parent)
                    rchild = HTML_GetNextSibling(rchild)
                }
            }
            ReturnValue(-1)
        }

        // Get tag name and map to AKTag
        tag_name = HTML_GetTagName(html_node)
        ak_tag = AKBind_TagNameToAKTag(tag_name)
        IfCondition EqualTo(ak_tag, 0) ThenBlock: {
            // Unknown tag — skip this node and its children
            ReturnValue(-1)
        }

        // Create AK node
        ak_node = AK_CreateNode(ctx, ak_tag)
        IfCondition LessThan(ak_node, 0) ThenBlock: {
            PrintMessage("[AKBind] AK_CreateNode failed\n")
            AKBind.error = 1
            ReturnValue(-1)
        }
        AKBind.node_count = Add(AKBind.node_count, 1)

        // Apply attributes — bounded by attr count
        attr_first = HTML_NodeAttrFirst(html_node)
        attr_count = HTML_NodeAttrCount(html_node)
        IfCondition GreaterThan(attr_count, 0) ThenBlock: {
            ba_i = attr_first
            ba_end = Add(attr_first, attr_count)
            WhileLoop LessThan(ba_i, ba_end) {
                ba_name = HTML_AttrGetName(ba_i)
                IfCondition NotEqual(ba_name, 0) ThenBlock: {
                    ba_val = HTML_AttrGetVal(ba_i)
                    AKBind_ApplyAttr(ctx, ak_node, ba_name, ba_val)
                }
                ba_i = Add(ba_i, 1)
            }
        }

        IfCondition EqualTo(ak_tag, AKTag.DOCVIEW) ThenBlock: {
            AKBind_InitDocView(ctx, ak_node)
        }

        // TEXTFIELD auto-init: create TextBuffer and attach
        IfCondition EqualTo(ak_tag, AKTag.TEXTFIELD) ThenBlock: {
            tbh = TextBuf_Create()
            AK_ExtraSet(ctx, ak_node, AKExtra.TEXTBUF_H, tbh)
            // Set focus to this node if no focus yet
            IfCondition LessThan(ctx@focus_node, 0) ThenBlock: {
                ctx@focus_node = ak_node
            }
        }

        // INPUT auto-init: create single-line TextBuffer and attach
        IfCondition EqualTo(ak_tag, AKTag.INPUT) ThenBlock: {
            inp_tbh = TextBuf_Create()
            AK_ExtraSet(ctx, ak_node, AKExtra.TEXTBUF_H, inp_tbh)
            // If value="" was set via attributes, populate the buffer
            inp_sp = AK_ExtraGet(ctx, ak_node, AKExtra.STR_PTR)
            inp_sl = AK_ExtraGet(ctx, ak_node, AKExtra.STR_LEN)
            IfCondition And(NotEqual(inp_sp, 0), GreaterThan(inp_sl, 0)) ThenBlock: {
                TextBuf_SetText(inp_tbh, inp_sp, inp_sl)
            }
            // Set focus to first input if no focus yet
            IfCondition LessThan(ctx@focus_node, 0) ThenBlock: {
                ctx@focus_node = ak_node
            }
        }

        // Add to parent (if not root-level)
        IfCondition GreaterEqual(ak_parent, 0) ThenBlock: {
            AK_AddChild(ctx, ak_parent, ak_node)
        }

        // Recurse into children
        bchild = HTML_GetFirstChild(html_node)
        WhileLoop NotEqual(bchild, -1) {
            AKBind_Node(ctx, bchild, ak_node)
            bchild = HTML_GetNextSibling(bchild)
        }

        ReturnValue(ak_node)
    }
}

// =============================================================================
// PUBLIC API — PARSE FILE AND BUILD AK TREE
// =============================================================================
Function.AKParse_File {
    Input: ctx: LinkagePool.AKContext
    Input: filename: Address
    Output: Integer
    Body: {
        AKBind.error = 0
        AKBind.node_count = 0

        // Parse HTML
        html_root = HTML_ParseFile(filename)
        IfCondition LessThan(html_root, 0) ThenBlock: {
            PrintMessage("[AKBind] HTML parse failed: ")
            PrintMessage(filename)
            PrintMessage("\n")
            ReturnValue(-1)
        }

        // Walk HTML AST, build AK tree
        // The root HTML node is virtual — its first element child becomes AK root
        first_elem = HTML_GetFirstChild(html_root)
        IfCondition LessThan(first_elem, 0) ThenBlock: {
            PrintMessage("[AKBind] no elements in markup\n")
            ReturnValue(-1)
        }

        // Bind first element as root
        ak_root = AKBind_Node(ctx, first_elem, -1)
        IfCondition LessThan(ak_root, 0) ThenBlock: {
            PrintMessage("[AKBind] root bind failed\n")
            ReturnValue(-1)
        }

        AK_SetRoot(ctx, ak_root)

        // Bind remaining siblings (unusual but allowed)
        next_elem = HTML_GetNextSibling(first_elem)
        WhileLoop NotEqual(next_elem, -1) {
            AKBind_Node(ctx, next_elem, ak_root)
            next_elem = HTML_GetNextSibling(next_elem)
        }

        PrintMessage("[AKBind] bound ")
        PrintNumber(AKBind.node_count)
        PrintMessage(" AK nodes from ")
        PrintMessage(filename)
        PrintMessage("\n")

        IfCondition EqualTo(AKBind.error, 1) ThenBlock: {
            ReturnValue(-1)
        }
        ReturnValue(ak_root)
    }
}

// =============================================================================
// PUBLIC API — PARSE STRING AND BUILD AK TREE
// =============================================================================
Function.AKParse_String {
    Input: ctx: LinkagePool.AKContext
    Input: source: Address
    Input: source_len: Integer
    Output: Integer
    Body: {
        AKBind.error = 0
        AKBind.node_count = 0

        html_root = HTML_ParseString(source, source_len)
        IfCondition LessThan(html_root, 0) ThenBlock: {
            PrintMessage("[AKBind] HTML parse failed from string\n")
            ReturnValue(-1)
        }

        first_elem2 = HTML_GetFirstChild(html_root)
        IfCondition LessThan(first_elem2, 0) ThenBlock: {
            PrintMessage("[AKBind] no elements in markup string\n")
            ReturnValue(-1)
        }

        ak_root2 = AKBind_Node(ctx, first_elem2, -1)
        IfCondition LessThan(ak_root2, 0) ThenBlock: {
            PrintMessage("[AKBind] root bind failed\n")
            ReturnValue(-1)
        }

        AK_SetRoot(ctx, ak_root2)

        next_elem2 = HTML_GetNextSibling(first_elem2)
        WhileLoop NotEqual(next_elem2, -1) {
            AKBind_Node(ctx, next_elem2, ak_root2)
            next_elem2 = HTML_GetNextSibling(next_elem2)
        }

        PrintMessage("[AKBind] bound ")
        PrintNumber(AKBind.node_count)
        PrintMessage(" AK nodes from string\n")

        IfCondition EqualTo(AKBind.error, 1) ThenBlock: {
            ReturnValue(-1)
        }
        ReturnValue(ak_root2)
    }
}
