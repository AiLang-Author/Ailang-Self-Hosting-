// Library.AucklandBind.ailang
// Walks HTML AST and builds Auckland AKNode tree
// Knows about AKTag, AKF, AKExtra — all Auckland-specific logic lives here
// Copyright © 2026 Sean Collins, 2 Paws Machine and Engineering. SCSL.

LibraryImport.XArrays
LibraryImport.Display.Content.HTMLParse
LibraryImport.Display.UI.Auckland
LibraryImport.Display.UI.AucklandEvent
LibraryImport.TextBuffer

// =============================================================================
// BIND STATE
// =============================================================================
FixedPool.AKBind {
    "error":      Initialize=0, CanChange=True
    "error_msg":  Initialize=0, CanChange=True
    "node_count": Initialize=0, CanChange=True
}

// =============================================================================
// COLOR PARSER — #RGB, #RRGGBB, #RRGGBBAA → packed BGRA
// =============================================================================
Function.AKBind_HexDigit {
    Input: ch: Integer
    Output: Integer
    Body: {
        // 0-9
        IfCondition And(GreaterEqual(ch, 48), LessEqual(ch, 57)) ThenBlock: {
            ReturnValue(Subtract(ch, 48))
        }
        // A-F
        IfCondition And(GreaterEqual(ch, 65), LessEqual(ch, 70)) ThenBlock: {
            ReturnValue(Add(Subtract(ch, 65), 10))
        }
        // a-f
        IfCondition And(GreaterEqual(ch, 97), LessEqual(ch, 102)) ThenBlock: {
            ReturnValue(Add(Subtract(ch, 97), 10))
        }
        ReturnValue(0)
    }
}

Function.AKBind_ParseColor {
    Input: str: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(str, 0) ThenBlock: { ReturnValue(0) }

        // Must start with #
        c0 = GetByte(str, 0)
        IfCondition NotEqual(c0, 35) ThenBlock: { ReturnValue(0) }

        len = StringLength(str)
        r = 0
        g = 0
        b = 0
        a = 255

        // #RGB — 4 chars
        IfCondition EqualTo(len, 4) ThenBlock: {
            h1 = AKBind_HexDigit(GetByte(str, 1))
            h2 = AKBind_HexDigit(GetByte(str, 2))
            h3 = AKBind_HexDigit(GetByte(str, 3))
            r = Add(Multiply(h1, 16), h1)
            g = Add(Multiply(h2, 16), h2)
            b = Add(Multiply(h3, 16), h3)
        }

        // #RRGGBB — 7 chars
        IfCondition EqualTo(len, 7) ThenBlock: {
            rh = AKBind_HexDigit(GetByte(str, 1))
            rl = AKBind_HexDigit(GetByte(str, 2))
            r = Add(Multiply(rh, 16), rl)
            gh = AKBind_HexDigit(GetByte(str, 3))
            gl = AKBind_HexDigit(GetByte(str, 4))
            g = Add(Multiply(gh, 16), gl)
            bh = AKBind_HexDigit(GetByte(str, 5))
            bl_v = AKBind_HexDigit(GetByte(str, 6))
            b = Add(Multiply(bh, 16), bl_v)
        }

        // #RRGGBBAA — 9 chars
        IfCondition EqualTo(len, 9) ThenBlock: {
            rh2 = AKBind_HexDigit(GetByte(str, 1))
            rl2 = AKBind_HexDigit(GetByte(str, 2))
            r = Add(Multiply(rh2, 16), rl2)
            gh2 = AKBind_HexDigit(GetByte(str, 3))
            gl2 = AKBind_HexDigit(GetByte(str, 4))
            g = Add(Multiply(gh2, 16), gl2)
            bh2 = AKBind_HexDigit(GetByte(str, 5))
            bl2 = AKBind_HexDigit(GetByte(str, 6))
            b = Add(Multiply(bh2, 16), bl2)
            ah = AKBind_HexDigit(GetByte(str, 7))
            al_v = AKBind_HexDigit(GetByte(str, 8))
            a = Add(Multiply(ah, 16), al_v)
        }

        packed = TVG_PackColor(r, g, b, a)
        ReturnValue(packed)
    }
}

// =============================================================================
// NUMBER PARSER — string → integer
// =============================================================================
Function.AKBind_ParseInt {
    Input: str: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(str, 0) ThenBlock: { ReturnValue(0) }
        len = StringLength(str)
        IfCondition EqualTo(len, 0) ThenBlock: { ReturnValue(0) }

        result = 0
        neg = 0
        pi = 0

        // Check for negative
        fc = GetByte(str, 0)
        IfCondition EqualTo(fc, 45) ThenBlock: {
            neg = 1
            pi = 1
        }

        WhileLoop LessThan(pi, len) {
            dc = GetByte(str, pi)
            IfCondition And(GreaterEqual(dc, 48), LessEqual(dc, 57)) ThenBlock: {
                dv = Subtract(dc, 48)
                result = Add(Multiply(result, 10), dv)
            }
            pi = Add(pi, 1)
        }

        IfCondition EqualTo(neg, 1) ThenBlock: {
            result = Multiply(result, -1)
        }
        ReturnValue(result)
    }
}

// =============================================================================
// TAG NAME → AKTag MAPPING
// =============================================================================
Function.AKBind_TagNameToAKTag {
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }

        cmp_w = StringCompare(name, "window")
        IfCondition EqualTo(cmp_w, 0) ThenBlock: { ReturnValue(AKTag.WINDOW) }

        cmp_g = StringCompare(name, "group")
        IfCondition EqualTo(cmp_g, 0) ThenBlock: { ReturnValue(AKTag.GROUP) }

        cmp_pn = StringCompare(name, "panel")
        IfCondition EqualTo(cmp_pn, 0) ThenBlock: { ReturnValue(AKTag.PANEL) }

        cmp_sc = StringCompare(name, "scroll")
        IfCondition EqualTo(cmp_sc, 0) ThenBlock: { ReturnValue(AKTag.SCROLL) }

        cmp_ts = StringCompare(name, "tabs")
        IfCondition EqualTo(cmp_ts, 0) ThenBlock: { ReturnValue(AKTag.TABS) }

        cmp_tb = StringCompare(name, "tab")
        IfCondition EqualTo(cmp_tb, 0) ThenBlock: { ReturnValue(AKTag.TAB) }

        cmp_bt = StringCompare(name, "button")
        IfCondition EqualTo(cmp_bt, 0) ThenBlock: { ReturnValue(AKTag.BUTTON) }

        cmp_lb = StringCompare(name, "label")
        IfCondition EqualTo(cmp_lb, 0) ThenBlock: { ReturnValue(AKTag.LABEL) }

        cmp_tx = StringCompare(name, "text")
        IfCondition EqualTo(cmp_tx, 0) ThenBlock: { ReturnValue(AKTag.TEXT) }

        cmp_dp = StringCompare(name, "display")
        IfCondition EqualTo(cmp_dp, 0) ThenBlock: { ReturnValue(AKTag.DISPLAY) }

        cmp_cb = StringCompare(name, "checkbox")
        IfCondition EqualTo(cmp_cb, 0) ThenBlock: { ReturnValue(AKTag.CHECKBOX) }

        cmp_rd = StringCompare(name, "radio")
        IfCondition EqualTo(cmp_rd, 0) ThenBlock: { ReturnValue(AKTag.RADIO) }

        cmp_sl = StringCompare(name, "slider")
        IfCondition EqualTo(cmp_sl, 0) ThenBlock: { ReturnValue(AKTag.SLIDER) }

        cmp_pr = StringCompare(name, "progress")
        IfCondition EqualTo(cmp_pr, 0) ThenBlock: { ReturnValue(AKTag.PROGRESS) }

        cmp_im = StringCompare(name, "image")
        IfCondition EqualTo(cmp_im, 0) ThenBlock: { ReturnValue(AKTag.IMAGE) }

        cmp_cv = StringCompare(name, "canvas")
        IfCondition EqualTo(cmp_cv, 0) ThenBlock: { ReturnValue(AKTag.CANVAS) }

        cmp_sp = StringCompare(name, "spacer")
        IfCondition EqualTo(cmp_sp, 0) ThenBlock: { ReturnValue(AKTag.SPACER) }

        cmp_se = StringCompare(name, "separator")
        IfCondition EqualTo(cmp_se, 0) ThenBlock: { ReturnValue(AKTag.SEPARATOR) }

        cmp_tf = StringCompare(name, "textfield")
        IfCondition EqualTo(cmp_tf, 0) ThenBlock: { ReturnValue(AKTag.TEXTFIELD) }

        cmp_th = StringCompare(name, "theme")
        IfCondition EqualTo(cmp_th, 0) ThenBlock: { ReturnValue(AKTag.THEME) }

        // Unknown tag — print warning
        PrintMessage("[AKBind] unknown tag: ")
        PrintMessage(name)
        PrintMessage("\n")
        ReturnValue(0)
    }
}

// =============================================================================
// LAYOUT MODE PARSER
// =============================================================================
Function.AKBind_ParseLayout {
    Input: val: Address
    Output: Integer
    Body: {
        cmp_vb = StringCompare(val, "vbox")
        IfCondition EqualTo(cmp_vb, 0) ThenBlock: { ReturnValue(AKLayout.VBOX) }

        cmp_hb = StringCompare(val, "hbox")
        IfCondition EqualTo(cmp_hb, 0) ThenBlock: { ReturnValue(AKLayout.HBOX) }

        cmp_gr = StringCompare(val, "grid")
        IfCondition EqualTo(cmp_gr, 0) ThenBlock: { ReturnValue(AKLayout.GRID) }

        cmp_fl = StringCompare(val, "flow")
        IfCondition EqualTo(cmp_fl, 0) ThenBlock: { ReturnValue(AKLayout.FLOW) }

        ReturnValue(AKLayout.VBOX)
    }
}

// =============================================================================
// ALIGNMENT PARSER
// =============================================================================
Function.AKBind_ParseAlign {
    Input: val: Address
    Output: Integer
    Body: {
        cmp_st = StringCompare(val, "start")
        IfCondition EqualTo(cmp_st, 0) ThenBlock: { ReturnValue(AKAlign.START) }

        cmp_ct = StringCompare(val, "center")
        IfCondition EqualTo(cmp_ct, 0) ThenBlock: { ReturnValue(AKAlign.CENTER) }

        cmp_en = StringCompare(val, "end")
        IfCondition EqualTo(cmp_en, 0) ThenBlock: { ReturnValue(AKAlign.END) }

        cmp_sr = StringCompare(val, "stretch")
        IfCondition EqualTo(cmp_sr, 0) ThenBlock: { ReturnValue(AKAlign.STRETCH) }

        ReturnValue(AKAlign.STRETCH)
    }
}

// =============================================================================
// TEXT ALIGN PARSER
// =============================================================================
Function.AKBind_ParseTextAlign {
    Input: val: Address
    Output: Integer
    Body: {
        cmp_l = StringCompare(val, "left")
        IfCondition EqualTo(cmp_l, 0) ThenBlock: { ReturnValue(TRAlign.LEFT) }

        cmp_c = StringCompare(val, "center")
        IfCondition EqualTo(cmp_c, 0) ThenBlock: { ReturnValue(TRAlign.CENTER) }

        cmp_r = StringCompare(val, "right")
        IfCondition EqualTo(cmp_r, 0) ThenBlock: { ReturnValue(TRAlign.RIGHT) }

        ReturnValue(TRAlign.LEFT)
    }
}

// =============================================================================
// APPLY SINGLE ATTRIBUTE TO AK NODE
// =============================================================================
Function.AKBind_ApplyAttr {
    Input: ctx: LinkagePool.AKContext
    Input: ak_node: Integer
    Input: attr_name: Address
    Input: attr_val: Address
    Body: {
        // ─── LAYOUT ATTRIBUTES → AK_Set ───

        cmp_layout = StringCompare(attr_name, "layout")
        IfCondition EqualTo(cmp_layout, 0) ThenBlock: {
            lm = AKBind_ParseLayout(attr_val)
            AK_Set(ctx, ak_node, AKF.LAYOUT_MODE, lm)
            ReturnValue(0)
        }

        cmp_gap = StringCompare(attr_name, "gap")
        IfCondition EqualTo(cmp_gap, 0) ThenBlock: {
            AK_Set(ctx, ak_node, AKF.GAP, AKBind_ParseInt(attr_val))
            ReturnValue(0)
        }

        cmp_padding = StringCompare(attr_name, "padding")
        IfCondition EqualTo(cmp_padding, 0) ThenBlock: {
            pv = AKBind_ParseInt(attr_val)
            AK_Set(ctx, ak_node, AKF.PAD_T, pv)
            AK_Set(ctx, ak_node, AKF.PAD_R, pv)
            AK_Set(ctx, ak_node, AKF.PAD_B, pv)
            AK_Set(ctx, ak_node, AKF.PAD_L, pv)
            ReturnValue(0)
        }

        cmp_padt = StringCompare(attr_name, "pad-t")
        IfCondition EqualTo(cmp_padt, 0) ThenBlock: {
            AK_Set(ctx, ak_node, AKF.PAD_T, AKBind_ParseInt(attr_val))
            ReturnValue(0)
        }

        cmp_padr = StringCompare(attr_name, "pad-r")
        IfCondition EqualTo(cmp_padr, 0) ThenBlock: {
            AK_Set(ctx, ak_node, AKF.PAD_R, AKBind_ParseInt(attr_val))
            ReturnValue(0)
        }

        cmp_padb = StringCompare(attr_name, "pad-b")
        IfCondition EqualTo(cmp_padb, 0) ThenBlock: {
            AK_Set(ctx, ak_node, AKF.PAD_B, AKBind_ParseInt(attr_val))
            ReturnValue(0)
        }

        cmp_padl = StringCompare(attr_name, "pad-l")
        IfCondition EqualTo(cmp_padl, 0) ThenBlock: {
            AK_Set(ctx, ak_node, AKF.PAD_L, AKBind_ParseInt(attr_val))
            ReturnValue(0)
        }

        cmp_grow = StringCompare(attr_name, "grow")
        IfCondition EqualTo(cmp_grow, 0) ThenBlock: {
            AK_Set(ctx, ak_node, AKF.GROW, AKBind_ParseInt(attr_val))
            ReturnValue(0)
        }

        cmp_shrink = StringCompare(attr_name, "shrink")
        IfCondition EqualTo(cmp_shrink, 0) ThenBlock: {
            AK_Set(ctx, ak_node, AKF.SHRINK, AKBind_ParseInt(attr_val))
            ReturnValue(0)
        }

        cmp_width = StringCompare(attr_name, "width")
        IfCondition EqualTo(cmp_width, 0) ThenBlock: {
            AK_Set(ctx, ak_node, AKF.WIDTH, AKBind_ParseInt(attr_val))
            ReturnValue(0)
        }

        cmp_height = StringCompare(attr_name, "height")
        IfCondition EqualTo(cmp_height, 0) ThenBlock: {
            AK_Set(ctx, ak_node, AKF.HEIGHT, AKBind_ParseInt(attr_val))
            ReturnValue(0)
        }

        cmp_minw = StringCompare(attr_name, "min-w")
        IfCondition EqualTo(cmp_minw, 0) ThenBlock: {
            AK_Set(ctx, ak_node, AKF.MIN_W, AKBind_ParseInt(attr_val))
            ReturnValue(0)
        }

        cmp_minh = StringCompare(attr_name, "min-h")
        IfCondition EqualTo(cmp_minh, 0) ThenBlock: {
            AK_Set(ctx, ak_node, AKF.MIN_H, AKBind_ParseInt(attr_val))
            ReturnValue(0)
        }

        cmp_maxw = StringCompare(attr_name, "max-w")
        IfCondition EqualTo(cmp_maxw, 0) ThenBlock: {
            AK_Set(ctx, ak_node, AKF.MAX_W, AKBind_ParseInt(attr_val))
            ReturnValue(0)
        }

        cmp_maxh = StringCompare(attr_name, "max-h")
        IfCondition EqualTo(cmp_maxh, 0) ThenBlock: {
            AK_Set(ctx, ak_node, AKF.MAX_H, AKBind_ParseInt(attr_val))
            ReturnValue(0)
        }

        cmp_cols = StringCompare(attr_name, "cols")
        IfCondition EqualTo(cmp_cols, 0) ThenBlock: {
            AK_Set(ctx, ak_node, AKF.COLS, AKBind_ParseInt(attr_val))
            ReturnValue(0)
        }

        cmp_align = StringCompare(attr_name, "align")
        IfCondition EqualTo(cmp_align, 0) ThenBlock: {
            AK_Set(ctx, ak_node, AKF.ALIGN, AKBind_ParseAlign(attr_val))
            ReturnValue(0)
        }

        cmp_id = StringCompare(attr_name, "id")
        IfCondition EqualTo(cmp_id, 0) ThenBlock: {
            id_hash = 5381
            id_len = StringLength(attr_val)
            id_i = 0
            WhileLoop LessThan(id_i, id_len) {
                id_c = GetByte(attr_val, id_i)
                id_hash = Add(Multiply(id_hash, 33), id_c)
                id_i = Add(id_i, 1)
            }
            AK_Set(ctx, ak_node, AKF.ID_HASH, id_hash)
            ReturnValue(0)
        }

        // ─── EXTRA ATTRIBUTES → AK_ExtraSet ───

        cmp_bg = StringCompare(attr_name, "bg")
        IfCondition EqualTo(cmp_bg, 0) ThenBlock: {
            bgc = AKBind_ParseColor(attr_val)
            AK_ExtraSet(ctx, ak_node, AKExtra.COLOR_BG, bgc)
            ReturnValue(0)
        }

        cmp_fg = StringCompare(attr_name, "fg")
        IfCondition EqualTo(cmp_fg, 0) ThenBlock: {
            fgc = AKBind_ParseColor(attr_val)
            AK_ExtraSet(ctx, ak_node, AKExtra.COLOR_FG, fgc)
            ReturnValue(0)
        }

        cmp_label = StringCompare(attr_name, "label")
        IfCondition EqualTo(cmp_label, 0) ThenBlock: {
            lbl_len = StringLength(attr_val)
            AK_ExtraSet(ctx, ak_node, AKExtra.STR_PTR, attr_val)
            AK_ExtraSet(ctx, ak_node, AKExtra.STR_LEN, lbl_len)
            ReturnValue(0)
        }

        cmp_text = StringCompare(attr_name, "text")
        IfCondition EqualTo(cmp_text, 0) ThenBlock: {
            txt_len = StringLength(attr_val)
            AK_ExtraSet(ctx, ak_node, AKExtra.STR_PTR, attr_val)
            AK_ExtraSet(ctx, ak_node, AKExtra.STR_LEN, txt_len)
            ReturnValue(0)
        }

        cmp_action = StringCompare(attr_name, "action")
        IfCondition EqualTo(cmp_action, 0) ThenBlock: {
            act_len = StringLength(attr_val)
            AK_ExtraSet(ctx, ak_node, AKExtra.ACTION_PTR, attr_val)
            AK_ExtraSet(ctx, ak_node, AKExtra.ACTION_LEN, act_len)
            ReturnValue(0)
        }

        cmp_fontsize = StringCompare(attr_name, "font-size")
        IfCondition EqualTo(cmp_fontsize, 0) ThenBlock: {
            AK_ExtraSet(ctx, ak_node, AKExtra.FONT_SIZE, AKBind_ParseInt(attr_val))
            ReturnValue(0)
        }

        cmp_txtalign = StringCompare(attr_name, "text-align")
        IfCondition EqualTo(cmp_txtalign, 0) ThenBlock: {
            AK_ExtraSet(ctx, ak_node, AKExtra.TEXT_ALIGN, AKBind_ParseTextAlign(attr_val))
            ReturnValue(0)
        }

        cmp_border = StringCompare(attr_name, "border")
        IfCondition EqualTo(cmp_border, 0) ThenBlock: {
            AK_ExtraSet(ctx, ak_node, AKExtra.BORDER_W, AKBind_ParseInt(attr_val))
            ReturnValue(0)
        }

        cmp_borderclr = StringCompare(attr_name, "border-color")
        IfCondition EqualTo(cmp_borderclr, 0) ThenBlock: {
            bc = AKBind_ParseColor(attr_val)
            AK_ExtraSet(ctx, ak_node, AKExtra.BORDER_CLR, bc)
            ReturnValue(0)
        }

        // ─── WINDOW-SPECIFIC: design-w, design-h ───

        cmp_dw = StringCompare(attr_name, "design-w")
        IfCondition EqualTo(cmp_dw, 0) ThenBlock: {
            ctx@design_w = AKBind_ParseInt(attr_val)
            ReturnValue(0)
        }

        cmp_dh = StringCompare(attr_name, "design-h")
        IfCondition EqualTo(cmp_dh, 0) ThenBlock: {
            ctx@design_h = AKBind_ParseInt(attr_val)
            ReturnValue(0)
        }

        // ─── TITLE (for window) ───
        cmp_title = StringCompare(attr_name, "title")
        IfCondition EqualTo(cmp_title, 0) ThenBlock: {
            // Store as label/text on the window node
            tl = StringLength(attr_val)
            AK_ExtraSet(ctx, ak_node, AKExtra.STR_PTR, attr_val)
            AK_ExtraSet(ctx, ak_node, AKExtra.STR_LEN, tl)
            ReturnValue(0)
        }

        // ─── TOOLBAR MODE (for window) ───
        cmp_tb = StringCompare(attr_name, "toolbar")
        IfCondition EqualTo(cmp_tb, 0) ThenBlock: {
            // Parse toolbar preset: "none", "about", "file", "full"
            tb_none = StringCompare(attr_val, "none")
            IfCondition EqualTo(tb_none, 0) ThenBlock: {
                ctx@toolbar_mode = TBMode.NONE
                ReturnValue(0)
            }
            tb_about = StringCompare(attr_val, "about")
            IfCondition EqualTo(tb_about, 0) ThenBlock: {
                ctx@toolbar_mode = TBMode.ABOUT
                ReturnValue(0)
            }
            tb_file = StringCompare(attr_val, "file")
            IfCondition EqualTo(tb_file, 0) ThenBlock: {
                ctx@toolbar_mode = TBMode.FILE
                ReturnValue(0)
            }
            tb_full = StringCompare(attr_val, "full")
            IfCondition EqualTo(tb_full, 0) ThenBlock: {
                ctx@toolbar_mode = TBMode.FULL
                ReturnValue(0)
            }
            // Unknown toolbar value — default to about
            ctx@toolbar_mode = TBMode.ABOUT
            ReturnValue(0)
        }

        // Unknown attribute — silent skip (future extensions)
        ReturnValue(0)
    }
}

// =============================================================================
// BIND HTML NODE → AK NODE (recursive)
// =============================================================================
Function.AKBind_Node {
    Input: ctx: LinkagePool.AKContext
    Input: html_node: Integer
    Input: ak_parent: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(html_node, 0) ThenBlock: { ReturnValue(-1) }

        ntype = HTML_GetNodeType(html_node)

        // Skip text nodes — Auckland doesn't have inline text
        IfCondition EqualTo(ntype, HNode.TEXT) ThenBlock: { ReturnValue(-1) }

        // Skip non-element nodes
        IfCondition NotEqual(ntype, HNode.ELEMENT) ThenBlock: {
            // For ROOT node, process children directly
            IfCondition EqualTo(ntype, HNode.ROOT) ThenBlock: {
                rchild = HTML_GetFirstChild(html_node)
                WhileLoop NotEqual(rchild, -1) {
                    AKBind_Node(ctx, rchild, ak_parent)
                    rchild = HTML_GetNextSibling(rchild)
                }
            }
            ReturnValue(-1)
        }

        // Get tag name and map to AKTag
        tag_name = HTML_GetTagName(html_node)
        ak_tag = AKBind_TagNameToAKTag(tag_name)
        IfCondition EqualTo(ak_tag, 0) ThenBlock: {
            // Unknown tag — skip this node and its children
            ReturnValue(-1)
        }

        // Create AK node
        ak_node = AK_CreateNode(ctx, ak_tag)
        IfCondition LessThan(ak_node, 0) ThenBlock: {
            PrintMessage("[AKBind] AK_CreateNode failed\n")
            AKBind.error = 1
            ReturnValue(-1)
        }
        AKBind.node_count = Add(AKBind.node_count, 1)

        // Apply attributes — bounded by attr count
        attr_first = HTML_NodeAttrFirst(html_node)
        attr_count = HTML_NodeAttrCount(html_node)
        IfCondition GreaterThan(attr_count, 0) ThenBlock: {
            ba_i = attr_first
            ba_end = Add(attr_first, attr_count)
            WhileLoop LessThan(ba_i, ba_end) {
                ba_name = HTML_AttrGetName(ba_i)
                IfCondition NotEqual(ba_name, 0) ThenBlock: {
                    ba_val = HTML_AttrGetVal(ba_i)
                    AKBind_ApplyAttr(ctx, ak_node, ba_name, ba_val)
                }
                ba_i = Add(ba_i, 1)
            }
        }

        // TEXTFIELD auto-init: create TextBuffer and attach
        IfCondition EqualTo(ak_tag, AKTag.TEXTFIELD) ThenBlock: {
            tbh = TextBuf_Create()
            AK_ExtraSet(ctx, ak_node, AKExtra.TEXTBUF_H, tbh)
            // Set focus to this node if no focus yet
            IfCondition LessThan(ctx@focus_node, 0) ThenBlock: {
                ctx@focus_node = ak_node
            }
        }

        // Add to parent (if not root-level)
        IfCondition GreaterEqual(ak_parent, 0) ThenBlock: {
            AK_AddChild(ctx, ak_parent, ak_node)
        }

        // Recurse into children
        bchild = HTML_GetFirstChild(html_node)
        WhileLoop NotEqual(bchild, -1) {
            AKBind_Node(ctx, bchild, ak_node)
            bchild = HTML_GetNextSibling(bchild)
        }

        ReturnValue(ak_node)
    }
}

// =============================================================================
// PUBLIC API — PARSE FILE AND BUILD AK TREE
// =============================================================================
Function.AKParse_File {
    Input: ctx: LinkagePool.AKContext
    Input: filename: Address
    Output: Integer
    Body: {
        AKBind.error = 0
        AKBind.node_count = 0

        // Parse HTML
        html_root = HTML_ParseFile(filename)
        IfCondition LessThan(html_root, 0) ThenBlock: {
            PrintMessage("[AKBind] HTML parse failed: ")
            PrintMessage(filename)
            PrintMessage("\n")
            ReturnValue(-1)
        }

        // Walk HTML AST, build AK tree
        // The root HTML node is virtual — its first element child becomes AK root
        first_elem = HTML_GetFirstChild(html_root)
        IfCondition LessThan(first_elem, 0) ThenBlock: {
            PrintMessage("[AKBind] no elements in markup\n")
            ReturnValue(-1)
        }

        // Bind first element as root
        ak_root = AKBind_Node(ctx, first_elem, -1)
        IfCondition LessThan(ak_root, 0) ThenBlock: {
            PrintMessage("[AKBind] root bind failed\n")
            ReturnValue(-1)
        }

        AK_SetRoot(ctx, ak_root)

        // Bind remaining siblings (unusual but allowed)
        next_elem = HTML_GetNextSibling(first_elem)
        WhileLoop NotEqual(next_elem, -1) {
            AKBind_Node(ctx, next_elem, ak_root)
            next_elem = HTML_GetNextSibling(next_elem)
        }

        PrintMessage("[AKBind] bound ")
        PrintNumber(AKBind.node_count)
        PrintMessage(" AK nodes from ")
        PrintMessage(filename)
        PrintMessage("\n")

        IfCondition EqualTo(AKBind.error, 1) ThenBlock: {
            ReturnValue(-1)
        }
        ReturnValue(ak_root)
    }
}

// =============================================================================
// PUBLIC API — PARSE STRING AND BUILD AK TREE
// =============================================================================
Function.AKParse_String {
    Input: ctx: LinkagePool.AKContext
    Input: source: Address
    Input: source_len: Integer
    Output: Integer
    Body: {
        AKBind.error = 0
        AKBind.node_count = 0

        html_root = HTML_ParseString(source, source_len)
        IfCondition LessThan(html_root, 0) ThenBlock: {
            PrintMessage("[AKBind] HTML parse failed from string\n")
            ReturnValue(-1)
        }

        first_elem2 = HTML_GetFirstChild(html_root)
        IfCondition LessThan(first_elem2, 0) ThenBlock: {
            PrintMessage("[AKBind] no elements in markup string\n")
            ReturnValue(-1)
        }

        ak_root2 = AKBind_Node(ctx, first_elem2, -1)
        IfCondition LessThan(ak_root2, 0) ThenBlock: {
            PrintMessage("[AKBind] root bind failed\n")
            ReturnValue(-1)
        }

        AK_SetRoot(ctx, ak_root2)

        next_elem2 = HTML_GetNextSibling(first_elem2)
        WhileLoop NotEqual(next_elem2, -1) {
            AKBind_Node(ctx, next_elem2, ak_root2)
            next_elem2 = HTML_GetNextSibling(next_elem2)
        }

        PrintMessage("[AKBind] bound ")
        PrintNumber(AKBind.node_count)
        PrintMessage(" AK nodes from string\n")

        IfCondition EqualTo(AKBind.error, 1) ThenBlock: {
            ReturnValue(-1)
        }
        ReturnValue(ak_root2)
    }
}
