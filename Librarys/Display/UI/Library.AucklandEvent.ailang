// Library.AucklandEvent.ailang
// Auckland Event Routing — hit testing, state machine, dirty redraw.
// Make it work, then make it pretty, then optimize.
// Copyright © 2026 Sean Collins, 2 Paws Machine and Engineering. SCSL.

LibraryImport.Display.UI.Auckland
LibraryImport.TextBuffer
LibraryImport.Display.Input.DInputTypes

// Mouse event types passed to AK_EventMouse
FixedPool.AKMouseEv {
    "MOVE":  Initialize=0
    "DOWN":  Initialize=1
    "UP":    Initialize=2
    "WHEEL": Initialize=3
}

// =============================================================================
// HIT TEST — find deepest visible+enabled node containing (x, y)
// Reverse pre-order: walk tree collecting hits, last match = deepest drawn.
// We do a forward pre-order walk and keep overwriting — last writer wins,
// same as painter's algorithm. Simplest correct approach.
// =============================================================================
Function.AK_HitTest {
    Input: ctx: LinkagePool.AKContext
    Input: x: Integer
    Input: y: Integer
    Output: Integer
    Body: {
        root = ctx@tree_root
        IfCondition LessThan(root, 0) ThenBlock: { ReturnValue(-1) }
        hit = AK_HitWalk(ctx, root, x, y, -1)
        ReturnValue(hit)
    }
}

// Recursive pre-order walk. Returns deepest hit so far.
Function.AK_HitWalk {
    Input: ctx: LinkagePool.AKContext
    Input: node: Integer
    Input: x: Integer
    Input: y: Integer
    Input: best: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(node, 0) ThenBlock: { ReturnValue(best) }

        vis = AK_Get(ctx, node, AKF.VISIBLE)
        IfCondition EqualTo(vis, 0) ThenBlock: { ReturnValue(best) }

        sx = AK_Get(ctx, node, AKF.SOLVED_X)
        sy = AK_Get(ctx, node, AKF.SOLVED_Y)
        sw = AK_Get(ctx, node, AKF.SOLVED_W)
        sh = AK_Get(ctx, node, AKF.SOLVED_H)

        // Point-in-rect test
        inside = 0
        IfCondition GreaterEqual(x, sx) ThenBlock: {
            ex = Add(sx, sw)
            IfCondition LessThan(x, ex) ThenBlock: {
                IfCondition GreaterEqual(y, sy) ThenBlock: {
                    ey = Add(sy, sh)
                    IfCondition LessThan(y, ey) ThenBlock: {
                        inside = 1
                    }
                }
            }
        }

        // Only interactive tags are hittable
        IfCondition EqualTo(inside, 1) ThenBlock: {
            tag = AK_Get(ctx, node, AKF.TAG)
            flags = AK_Get(ctx, node, AKF.FLAGS)
            enabled = BitwiseAnd(flags, AKFlags.ENABLED)
            hittable = 0
            IfCondition EqualTo(tag, AKTag.BUTTON)   ThenBlock: { hittable = 1 }
            IfCondition EqualTo(tag, AKTag.LABEL)     ThenBlock: { hittable = 1 }
            IfCondition EqualTo(tag, AKTag.TEXT)       ThenBlock: { hittable = 1 }
            IfCondition EqualTo(tag, AKTag.CHECKBOX)   ThenBlock: { hittable = 1 }
            IfCondition EqualTo(tag, AKTag.RADIO)      ThenBlock: { hittable = 1 }
            IfCondition EqualTo(tag, AKTag.SLIDER)     ThenBlock: { hittable = 1 }
            IfCondition EqualTo(tag, AKTag.CANVAS)     ThenBlock: { hittable = 1 }
            IfCondition EqualTo(tag, AKTag.DISPLAY)    ThenBlock: { hittable = 1 }
            IfCondition EqualTo(tag, AKTag.TEXTFIELD)  ThenBlock: { hittable = 1 }
            IfCondition EqualTo(tag, AKTag.INPUT)      ThenBlock: { hittable = 1 }
            IfCondition EqualTo(tag, AKTag.SCROLL)     ThenBlock: { hittable = 1 }
            IfCondition And(EqualTo(hittable, 1), NotEqual(enabled, 0)) ThenBlock: {
                best = node
            }
        }

        // Walk children — pre-order, so deeper nodes overwrite
        // For SCROLL containers, adjust x/y by scroll offset so hits map to content coords
        hit_x = x
        hit_y = y
        tag = AK_Get(ctx, node, AKF.TAG)
        IfCondition EqualTo(tag, AKTag.SCROLL) ThenBlock: {
            scr_ofs_y = AK_ExtraGet(ctx, node, AKExtra.SCROLL_Y)
            scr_ofs_x = AK_ExtraGet(ctx, node, AKExtra.SCROLL_X)
            hit_y = Add(y, scr_ofs_y)
            hit_x = Add(x, scr_ofs_x)
        }
        child = AK_Get(ctx, node, AKF.FIRST_CHILD)
        WhileLoop NotEqual(child, -1) {
            best = AK_HitWalk(ctx, child, hit_x, hit_y, best)
            child = AK_Get(ctx, child, AKF.NEXT_SIBLING)
        }

        ReturnValue(best)
    }
}

// =============================================================================
// SET STATE — update node state, mark dirty, return old state
// =============================================================================
Function.AK_SetState {
    Input: ctx: LinkagePool.AKContext
    Input: node: Integer
    Input: new_state: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(node, 0) ThenBlock: { ReturnValue(-1) }
        old = AK_Get(ctx, node, AKF.STATE)
        IfCondition NotEqual(old, new_state) ThenBlock: {
            AK_Set(ctx, node, AKF.STATE, new_state)
            AK_Set(ctx, node, AKF.DIRTY, 1)
            dc = ctx@dirty_count
            ctx@dirty_count = Add(dc, 1)
        }
        ReturnValue(old)
    }
}

// =============================================================================
// MOUSE EVENT DISPATCH — the state machine
//
// States per node: NORMAL -> HOVER -> PRESSED -> NORMAL (or action fire)
//
// MOVE: hit test. If target changed, old->NORMAL, new->HOVER.
//       If pressed_node is set and mouse leaves it, it stays PRESSED
//       (release outside = cancel, release inside = fire).
//
// DOWN: target -> PRESSED, record pressed_node.
//
// UP:   If over pressed_node -> fire action, -> HOVER.
//       If not over pressed_node -> pressed_node -> NORMAL.
//       Clear pressed_node.
// =============================================================================
Function.AK_EventMouse {
    Input: ctx: LinkagePool.AKContext
    Input: mx: Integer
    Input: my: Integer
    Input: ev: Integer
    Input: data: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(ev, AKMouseEv.WHEEL) ThenBlock: { DebugLog_Push("W.evm", 5) }
        target = AK_HitTest(ctx, mx, my)

        // =================================================================
        // MOUSE MOVE
        // =================================================================
        IfCondition EqualTo(ev, AKMouseEv.MOVE) ThenBlock: {
            old_hover = ctx@hover_node
            pressed = ctx@pressed_node

            // If we're in a press-drag, don't change hover state
            IfCondition GreaterEqual(pressed, 0) ThenBlock: {
                // Still track hover_node for release detection
                ctx@hover_node = target
                ReturnValue(0)
            }

            // Hover changed?
            IfCondition NotEqual(target, old_hover) ThenBlock: {
                // Old node leaves hover
                IfCondition GreaterEqual(old_hover, 0) ThenBlock: {
                    AK_SetState(ctx, old_hover, AKState.NORMAL)
                }
                // New node enters hover
                IfCondition GreaterEqual(target, 0) ThenBlock: {
                    AK_SetState(ctx, target, AKState.HOVER)
                }
                ctx@hover_node = target
            }
            ReturnValue(0)
        }

        // =================================================================
        // MOUSE DOWN
        // =================================================================
        IfCondition EqualTo(ev, AKMouseEv.DOWN) ThenBlock: {
            IfCondition GreaterEqual(target, 0) ThenBlock: {
                AK_SetState(ctx, target, AKState.PRESSED)
                ctx@pressed_node = target

                // Focus tracking — clicked element gets focus
                old_focus = ctx@focus_node
                IfCondition NotEqual(old_focus, target) ThenBlock: {
                    // Mark old focus dirty (remove focus highlight)
                    IfCondition GreaterEqual(old_focus, 0) ThenBlock: {
                        AK_Set(ctx, old_focus, AKF.DIRTY, 1)
                        dc1 = ctx@dirty_count
                        ctx@dirty_count = Add(dc1, 1)
                    }
                    ctx@focus_node = target
                    // Mark new focus dirty (add focus highlight)
                    AK_Set(ctx, target, AKF.DIRTY, 1)
                    dc2 = ctx@dirty_count
                    ctx@dirty_count = Add(dc2, 1)
                }
            }
            // Clicked empty space — clear focus
            IfCondition LessThan(target, 0) ThenBlock: {
                ctx@focus_node = -1
            }
            ReturnValue(0)
        }

        // =================================================================
        // MOUSE UP
        // =================================================================
        IfCondition EqualTo(ev, AKMouseEv.UP) ThenBlock: {
            pressed = ctx@pressed_node
            IfCondition GreaterEqual(pressed, 0) ThenBlock: {
                // Released over the same element we pressed?
                IfCondition EqualTo(target, pressed) ThenBlock: {
                    // CLICK — fire action, go to HOVER
                    AK_FireAction(ctx, pressed)
                    AK_SetState(ctx, pressed, AKState.HOVER)
                } ElseBlock: {
                    // Released outside — cancel, go to NORMAL
                    AK_SetState(ctx, pressed, AKState.NORMAL)
                }
            }
            ctx@pressed_node = -1

            // Whatever we're over now gets HOVER (if not the thing we just set)
            IfCondition GreaterEqual(target, 0) ThenBlock: {
                cur_state = AK_Get(ctx, target, AKF.STATE)
                IfCondition EqualTo(cur_state, AKState.NORMAL) ThenBlock: {
                    AK_SetState(ctx, target, AKState.HOVER)
                    ctx@hover_node = target
                }
            }
            ReturnValue(0)
        }

        // =================================================================
        // MOUSE WHEEL — scroll nearest SCROLL ancestor
        // =================================================================
        IfCondition EqualTo(ev, AKMouseEv.WHEEL) ThenBlock: {
            DebugLog_Push("W.WHL", 5)
            // Walk up from target to find nearest SCROLL container
            scroll_node = AK_FindScrollAncestor(ctx, target)
            IfCondition GreaterEqual(scroll_node, 0) ThenBlock: {
                DebugLog_Push("W.SCR", 5)

                // Compute content extents
                sc_top = AK_Get(ctx, scroll_node, AKF.SOLVED_Y)
                sc_left = AK_Get(ctx, scroll_node, AKF.SOLVED_X)
                sc_vw = AK_Get(ctx, scroll_node, AKF.SOLVED_W)
                sc_vh = AK_Get(ctx, scroll_node, AKF.SOLVED_H)
                sc_pb = AK_Get(ctx, scroll_node, AKF.PAD_B)
                sc_pr = AK_Get(ctx, scroll_node, AKF.PAD_R)
                sc_last_b = 0
                sc_last_r = 0
                sc_child = AK_Get(ctx, scroll_node, AKF.FIRST_CHILD)
                WhileLoop NotEqual(sc_child, -1) {
                    sc_cv = AK_Get(ctx, sc_child, AKF.VISIBLE)
                    IfCondition EqualTo(sc_cv, 1) ThenBlock: {
                        sc_cb = Add(AK_Get(ctx, sc_child, AKF.SOLVED_Y), AK_Get(ctx, sc_child, AKF.SOLVED_H))
                        IfCondition GreaterThan(sc_cb, sc_last_b) ThenBlock: { sc_last_b = sc_cb }
                        sc_cr = Add(AK_Get(ctx, sc_child, AKF.SOLVED_X), AK_Get(ctx, sc_child, AKF.SOLVED_W))
                        IfCondition GreaterThan(sc_cr, sc_last_r) ThenBlock: { sc_last_r = sc_cr }
                    }
                    sc_child = AK_Get(ctx, sc_child, AKF.NEXT_SIBLING)
                }
                sc_content_h = Add(Subtract(sc_last_b, sc_top), sc_pb)
                sc_content_w = Add(Subtract(sc_last_r, sc_left), sc_pr)
                max_scroll_y = Subtract(sc_content_h, sc_vh)
                IfCondition LessThan(max_scroll_y, 0) ThenBlock: { max_scroll_y = 0 }
                max_scroll_x = Subtract(sc_content_w, sc_vw)
                IfCondition LessThan(max_scroll_x, 0) ThenBlock: { max_scroll_x = 0 }

                // Each wheel tick = 3 lines worth of pixels
                line_h = VFont_GetLineHeight()
                IfCondition LessThan(line_h, 2) ThenBlock: { line_h = Add(UIScale.font_body, 2) }
                scroll_step = Multiply(line_h, 3)

                // Shift+wheel = horizontal scroll
                IfCondition EqualTo(KeyMod.shift, 1) ThenBlock: {
                    cur_sx = AK_ExtraGet(ctx, scroll_node, AKExtra.SCROLL_X)
                    IfCondition GreaterThan(data, 0) ThenBlock: {
                        cur_sx = Subtract(cur_sx, scroll_step)
                        IfCondition LessThan(cur_sx, 0) ThenBlock: { cur_sx = 0 }
                    }
                    IfCondition LessThan(data, 0) ThenBlock: {
                        cur_sx = Add(cur_sx, scroll_step)
                        IfCondition GreaterThan(cur_sx, max_scroll_x) ThenBlock: { cur_sx = max_scroll_x }
                    }
                    AK_ExtraSet(ctx, scroll_node, AKExtra.SCROLL_X, cur_sx)
                } ElseBlock: {
                    cur_scroll = AK_ExtraGet(ctx, scroll_node, AKExtra.SCROLL_Y)
                    IfCondition GreaterThan(data, 0) ThenBlock: {
                        cur_scroll = Subtract(cur_scroll, scroll_step)
                        IfCondition LessThan(cur_scroll, 0) ThenBlock: { cur_scroll = 0 }
                    }
                    IfCondition LessThan(data, 0) ThenBlock: {
                        cur_scroll = Add(cur_scroll, scroll_step)
                        IfCondition GreaterThan(cur_scroll, max_scroll_y) ThenBlock: { cur_scroll = max_scroll_y }
                    }
                    AK_ExtraSet(ctx, scroll_node, AKExtra.SCROLL_Y, cur_scroll)
                }
                // Mark entire scroll region dirty for redraw
                AK_Set(ctx, scroll_node, AKF.DIRTY, 1)
                dc = ctx@dirty_count
                ctx@dirty_count = Add(dc, 1)
            } ElseBlock: {
                DebugLog_Push("W.NOS", 5)
                // No SCROLL ancestor — check for TEXTFIELD (line-based scroll)
                tf_node = AK_FindTextfieldAncestor(ctx, target)
                IfCondition GreaterEqual(tf_node, 0) ThenBlock: {
                    tf_scroll = AK_ExtraGet(ctx, tf_node, AKExtra.SCROLL_Y)
                    tf_tbh = AK_ExtraGet(ctx, tf_node, AKExtra.TEXTBUF_H)
                    // Scroll step = 3 lines per wheel tick
                    IfCondition GreaterThan(data, 0) ThenBlock: {
                        // Scroll up
                        tf_scroll = Subtract(tf_scroll, 3)
                        IfCondition LessThan(tf_scroll, 0) ThenBlock: { tf_scroll = 0 }
                    }
                    IfCondition LessThan(data, 0) ThenBlock: {
                        // Scroll down — clamp to line_count - visible_lines
                        tf_scroll = Add(tf_scroll, 3)
                        IfCondition GreaterEqual(tf_tbh, 0) ThenBlock: {
                            tf_lc = TextBuf_GetLineCount(tf_tbh)
                            tf_sh = AK_Get(ctx, tf_node, AKF.SOLVED_H)
                            tf_lh = VFont_GetLineHeight()
                            IfCondition LessThan(tf_lh, 2) ThenBlock: { tf_lh = 16 }
                            tf_pad = UIScale.ak_textfield_pad
                            tf_vis = Divide(Subtract(tf_sh, Multiply(tf_pad, 2)), tf_lh)
                            tf_max = Subtract(tf_lc, tf_vis)
                            IfCondition LessThan(tf_max, 0) ThenBlock: { tf_max = 0 }
                            IfCondition GreaterThan(tf_scroll, tf_max) ThenBlock: { tf_scroll = tf_max }
                        }
                    }
                    AK_ExtraSet(ctx, tf_node, AKExtra.SCROLL_Y, tf_scroll)
                    AK_Set(ctx, tf_node, AKF.DIRTY, 1)
                    dc2 = ctx@dirty_count
                    ctx@dirty_count = Add(dc2, 1)
                }
            }
            ReturnValue(0)
        }

        ReturnValue(0)
    }
}

// =============================================================================
// FIND SCROLL ANCESTOR — walk up parent chain to find nearest SCROLL node
// =============================================================================
Function.AK_FindScrollAncestor {
    Input: ctx: LinkagePool.AKContext
    Input: node: Integer
    Output: Integer
    Body: {
        cur = node
        WhileLoop GreaterEqual(cur, 0) {
            t = AK_Get(ctx, cur, AKF.TAG)
            IfCondition EqualTo(t, AKTag.SCROLL) ThenBlock: { ReturnValue(cur) }
            cur = AK_Get(ctx, cur, AKF.PARENT)
        }
        ReturnValue(-1)
    }
}

// =============================================================================
// FIND TEXTFIELD ANCESTOR — walk up parent chain to find nearest TEXTFIELD node
// =============================================================================
Function.AK_FindTextfieldAncestor {
    Input: ctx: LinkagePool.AKContext
    Input: node: Integer
    Output: Integer
    Body: {
        cur = node
        WhileLoop GreaterEqual(cur, 0) {
            t = AK_Get(ctx, cur, AKF.TAG)
            IfCondition EqualTo(t, AKTag.TEXTFIELD) ThenBlock: { ReturnValue(cur) }
            cur = AK_Get(ctx, cur, AKF.PARENT)
        }
        ReturnValue(-1)
    }
}

// =============================================================================
// SCROLL CONTENT HEIGHT — sum solved heights of direct children + gaps
// =============================================================================
Function.AK_ScrollContentHeight {
    Input: ctx: LinkagePool.AKContext
    Input: scroll_node: Integer
    Output: Integer
    Body: {
        // Find the last visible child's bottom edge relative to scroll container
        pad_t = AK_Get(ctx, scroll_node, AKF.PAD_T)
        pad_b = AK_Get(ctx, scroll_node, AKF.PAD_B)
        scroll_top = AK_Get(ctx, scroll_node, AKF.SOLVED_Y)
        last_bottom = 0
        child = AK_Get(ctx, scroll_node, AKF.FIRST_CHILD)
        WhileLoop NotEqual(child, -1) {
            cvis = AK_Get(ctx, child, AKF.VISIBLE)
            IfCondition EqualTo(cvis, 1) ThenBlock: {
                cb = Add(AK_Get(ctx, child, AKF.SOLVED_Y), AK_Get(ctx, child, AKF.SOLVED_H))
                IfCondition GreaterThan(cb, last_bottom) ThenBlock: { last_bottom = cb }
            }
            child = AK_Get(ctx, child, AKF.NEXT_SIBLING)
        }
        // Content height = last child bottom - scroll top + bottom padding
        IfCondition EqualTo(last_bottom, 0) ThenBlock: { ReturnValue(0) }
        content_h = Add(Subtract(last_bottom, scroll_top), pad_b)
        ReturnValue(content_h)
    }
}

// =============================================================================
// FIRE ACTION — placeholder until Service Manager exists
// Reads action string from extra, prints "[ACTION] service.method"
// =============================================================================
Function.AK_FireAction {
    Input: ctx: LinkagePool.AKContext
    Input: node: Integer
    Body: {
        IfCondition LessThan(node, 0) ThenBlock: { ReturnValue(0) }

        // Toggle checkbox VALUE on click
        fire_tag = AK_Get(ctx, node, AKF.TAG)
        IfCondition EqualTo(fire_tag, AKTag.CHECKBOX) ThenBlock: {
            old_val = AK_ExtraGet(ctx, node, AKExtra.VALUE)
            IfCondition EqualTo(old_val, 0) ThenBlock: {
                AK_ExtraSet(ctx, node, AKExtra.VALUE, 1)
            } ElseBlock: {
                AK_ExtraSet(ctx, node, AKExtra.VALUE, 0)
            }
            AK_Set(ctx, node, AKF.DIRTY, 1)
        }

        ext = AK_Get(ctx, node, AKF.EXTRA)
        IfCondition LessThan(ext, 0) ThenBlock: { ReturnValue(0) }

        ap = AK_ExtraGet(ctx, node, AKExtra.ACTION_PTR)
        al = AK_ExtraGet(ctx, node, AKExtra.ACTION_LEN)
        IfCondition And(NotEqual(ap, 0), GreaterThan(al, 0)) ThenBlock: {
            PrintMessage("[ACTION] ")
            PrintString(ap)
            PrintMessage("\n")

            cb = ctx@action_cb
            IfCondition NotEqual(cb, 0) ThenBlock: {
                CallIndirect(cb, ap, al)
            }
        }
        ReturnValue(0)
    }
}

// =============================================================================
// DRAW DIRTY — repaint only changed nodes
// Walks full tree, redraws nodes with DIRTY=1, clears flag.
// Returns 1 if anything was drawn, 0 if clean.
// =============================================================================
Function.AK_DrawDirty {
    Input: ctx: LinkagePool.AKContext
    Input: canvas: Integer
    Output: Integer
    Body: {
        root = ctx@tree_root
        IfCondition LessThan(root, 0) ThenBlock: { ReturnValue(0) }

        ctx@canvas = canvas
        ctx@scroll_offset_y = 0
        AK_ClipInit(ctx)
        drew = AK_DrawDirtyWalk(ctx, root)
        ctx@dirty_count = 0
        ReturnValue(drew)
    }
}

Function.AK_DrawDirtyWalk {
    Input: ctx: LinkagePool.AKContext
    Input: node: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(node, 0) ThenBlock: { ReturnValue(0) }
        vis = AK_Get(ctx, node, AKF.VISIBLE)
        IfCondition EqualTo(vis, 0) ThenBlock: { ReturnValue(0) }

        drew = 0
        dirty = AK_Get(ctx, node, AKF.DIRTY)
        IfCondition EqualTo(dirty, 1) ThenBlock: {
            // Redraw this node — call existing AK_DrawNode
            AK_DrawNode(ctx, node)
            AK_Set(ctx, node, AKF.DIRTY, 0)
            drew = 1
        }

        // Walk children
        child = AK_Get(ctx, node, AKF.FIRST_CHILD)
        WhileLoop NotEqual(child, -1) {
            cd = AK_DrawDirtyWalk(ctx, child)
            IfCondition EqualTo(cd, 1) ThenBlock: { drew = 1 }
            child = AK_Get(ctx, child, AKF.NEXT_SIBLING)
        }

        ReturnValue(drew)
    }
}

// =============================================================================
// KEYBOARD EVENT — route key to focused TEXTFIELD node
// =============================================================================
Function.AK_FindTextField {
    Input: ctx: LinkagePool.AKContext
    Input: node: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(node, 0) ThenBlock: { ReturnValue(-1) }
        tag = AK_Get(ctx, node, AKF.TAG)
        IfCondition EqualTo(tag, AKTag.TEXTFIELD) ThenBlock: { ReturnValue(node) }
        // Search children
        child = AK_Get(ctx, node, AKF.FIRST_CHILD)
        WhileLoop NotEqual(child, -1) {
            found = AK_FindTextField(ctx, child)
            IfCondition GreaterEqual(found, 0) ThenBlock: { ReturnValue(found) }
            child = AK_Get(ctx, child, AKF.NEXT_SIBLING)
        }
        ReturnValue(-1)
    }
}

Function.AK_EventKey {
    Input: ctx: LinkagePool.AKContext
    Input: keycode: Integer
    Input: ch: Integer
    Input: shift: Integer
    Input: ctrl: Integer
    Body: {

        // Find focused text-input — must be TEXTFIELD or INPUT
        target = ctx@focus_node
        target_tag = -1
        IfCondition GreaterEqual(target, 0) ThenBlock: {
            target_tag = AK_Get(ctx, target, AKF.TAG)
            IfCondition And(NotEqual(target_tag, AKTag.TEXTFIELD), NotEqual(target_tag, AKTag.INPUT)) ThenBlock: {
                target = -1
                target_tag = -1
            }
        }
        // Fallback: search tree for first TEXTFIELD
        IfCondition LessThan(target, 0) ThenBlock: {
            root = ctx@tree_root
            target = AK_FindTextField(ctx, root)
            IfCondition GreaterEqual(target, 0) ThenBlock: {
                target_tag = AK_Get(ctx, target, AKF.TAG)
            }
        }
        IfCondition LessThan(target, 0) ThenBlock: { ReturnValue(0) }

        // Get TextBuffer handle
        tbh = AK_ExtraGet(ctx, target, AKExtra.TEXTBUF_H)
        IfCondition LessThan(tbh, 0) ThenBlock: { ReturnValue(0) }

        // Dispatch by keycode
        handled = 0

        // Tab (scancode 15) — context-dependent
        IfCondition EqualTo(keycode, Key.TAB) ThenBlock: {
            IfCondition EqualTo(target_tag, AKTag.TEXTFIELD) ThenBlock: {
                // TEXTFIELD: insert 4 spaces (code editor behavior)
                TextBuf_InsertChar(tbh, 32)
                TextBuf_InsertChar(tbh, 32)
                TextBuf_InsertChar(tbh, 32)
                TextBuf_InsertChar(tbh, 32)
                handled = 1
            }
            // INPUT: Tab could navigate, but for now just skip (no-op)
            // Tab navigation deferred until AK_TabFocus is added
        }

        // Enter (scancode 28) — context-dependent
        IfCondition EqualTo(keycode, Key.ENTER) ThenBlock: {
            IfCondition EqualTo(target_tag, AKTag.INPUT) ThenBlock: {
                // INPUT: fire action (form submit behavior)
                AK_FireAction(ctx, target)
                handled = 1
            } ElseBlock: {
                // TEXTFIELD: insert newline
                TextBuf_Enter(tbh)
                handled = 1
            }
        }

        // Printable character — only insert when ctrl is NOT held and not Tab/Enter
        IfCondition And(And(GreaterThan(ch, 0), EqualTo(ctrl, 0)), EqualTo(handled, 0)) ThenBlock: {
            TextBuf_InsertChar(tbh, ch)
            handled = 1
        }

        // Backspace (scancode 14)
        IfCondition EqualTo(keycode, Key.BACKSPACE) ThenBlock: {
            TextBuf_Backspace(tbh)
            handled = 1
        }

        // Delete (scancode 111)
        IfCondition EqualTo(keycode, Key.DELETE) ThenBlock: {
            TextBuf_Delete(tbh)
            handled = 1
        }

        // Arrow keys
        IfCondition EqualTo(keycode, Key.LEFT) ThenBlock: {
            TextBuf_MoveLeft(tbh)
            handled = 1
        }
        IfCondition EqualTo(keycode, Key.RIGHT) ThenBlock: {
            TextBuf_MoveRight(tbh)
            handled = 1
        }
        IfCondition EqualTo(keycode, Key.UP) ThenBlock: {
            TextBuf_MoveUp(tbh)
            handled = 1
        }
        IfCondition EqualTo(keycode, Key.DOWN) ThenBlock: {
            TextBuf_MoveDown(tbh)
            handled = 1
        }

        // Home / End
        IfCondition EqualTo(keycode, Key.HOME) ThenBlock: {
            TextBuf_Home(tbh)
            handled = 1
        }
        IfCondition EqualTo(keycode, Key.END) ThenBlock: {
            TextBuf_End(tbh)
            handled = 1
        }

        // PageUp / PageDown — move by 20 lines
        IfCondition EqualTo(keycode, Key.PAGEUP) ThenBlock: {
            TextBuf_PageUp(tbh, 20)
            handled = 1
        }
        IfCondition EqualTo(keycode, Key.PAGEDOWN) ThenBlock: {
            TextBuf_PageDown(tbh, 20)
            handled = 1
        }

        // Mark node dirty for redraw
        IfCondition EqualTo(handled, 1) ThenBlock: {
            AK_Set(ctx, target, AKF.DIRTY, 1)
            dc = ctx@dirty_count
            ctx@dirty_count = Add(dc, 1)
        }

        ReturnValue(handled)
    }
}
