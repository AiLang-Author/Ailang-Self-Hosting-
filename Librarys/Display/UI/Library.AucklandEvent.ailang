// Library.AucklandEvent.ailang
// Auckland Event Routing — hit testing, state machine, dirty redraw.
// Make it work, then make it pretty, then optimize.
// Copyright © 2026 Sean Collins, 2 Paws Machine and Engineering. SCSL.

LibraryImport.Display.UI.Auckland
LibraryImport.TextBuffer
LibraryImport.Display.Input.DInputTypes

// Mouse event types passed to AK_EventMouse
FixedPool.AKMouseEv {
    "MOVE":  Initialize=0
    "DOWN":  Initialize=1
    "UP":    Initialize=2
    "WHEEL": Initialize=3
}

// =============================================================================
// HIT TEST — find deepest visible+enabled node containing (x, y)
// Reverse pre-order: walk tree collecting hits, last match = deepest drawn.
// We do a forward pre-order walk and keep overwriting — last writer wins,
// same as painter's algorithm. Simplest correct approach.
// =============================================================================
Function.AK_HitTest {
    Input: ctx: LinkagePool.AKContext
    Input: x: Integer
    Input: y: Integer
    Output: Integer
    Body: {
        root = ctx@tree_root
        IfCondition LessThan(root, 0) ThenBlock: { ReturnValue(-1) }
        hit = AK_HitWalk(ctx, root, x, y, -1)
        ReturnValue(hit)
    }
}

// Point-in-rect check: returns 1 if (x,y) inside node bounds
Function.AK_PointInNode {
    Input: ctx: LinkagePool.AKContext
    Input: node: Integer
    Input: x: Integer
    Input: y: Integer
    Output: Integer
    Body: {
        sx = AK_Get(ctx, node, AKF.SOLVED_X)
        sy = AK_Get(ctx, node, AKF.SOLVED_Y)
        sw = AK_Get(ctx, node, AKF.SOLVED_W)
        sh = AK_Get(ctx, node, AKF.SOLVED_H)
        IfCondition LessThan(x, sx) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterEqual(x, Add(sx, sw)) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(y, sy) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterEqual(y, Add(sy, sh)) ThenBlock: { ReturnValue(0) }
        ReturnValue(1)
    }
}

// Check if a node tag is interactive (hittable)
Function.AK_IsHittable {
    Input: ctx: LinkagePool.AKContext
    Input: node: Integer
    Output: Integer
    Body: {
        tag = AK_Get(ctx, node, AKF.TAG)
        flags = AK_Get(ctx, node, AKF.FLAGS)
        enabled = BitwiseAnd(flags, AKFlags.ENABLED)
        IfCondition EqualTo(enabled, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(tag, AKTag.BUTTON)    ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(tag, AKTag.LABEL)     ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(tag, AKTag.TEXT)       ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(tag, AKTag.CHECKBOX)   ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(tag, AKTag.RADIO)      ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(tag, AKTag.SLIDER)     ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(tag, AKTag.CANVAS)     ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(tag, AKTag.DISPLAY)    ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(tag, AKTag.TEXTFIELD)  ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(tag, AKTag.INPUT)      ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(tag, AKTag.SCROLL)     ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

// Recursive pre-order walk. Returns deepest hit so far.
// Inputs=5, body=7 → 12 locals total
Function.AK_HitWalk {
    Input: ctx: LinkagePool.AKContext
    Input: node: Integer
    Input: x: Integer
    Input: y: Integer
    Input: best: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(node, 0) ThenBlock: { ReturnValue(best) }
        vis = AK_Get(ctx, node, AKF.VISIBLE)
        IfCondition EqualTo(vis, 0) ThenBlock: { ReturnValue(best) }

        // Point-in-rect + hittable check
        inside = AK_PointInNode(ctx, node, x, y)
        IfCondition EqualTo(inside, 1) ThenBlock: {
            hittable = AK_IsHittable(ctx, node)
            IfCondition EqualTo(hittable, 1) ThenBlock: { best = node }
        }

        // For SCROLL containers, adjust coords by scroll offset
        hit_x = x
        hit_y = y
        tag = AK_Get(ctx, node, AKF.TAG)
        IfCondition EqualTo(tag, AKTag.SCROLL) ThenBlock: {
            hit_y = Add(y, AK_ExtraGet(ctx, node, AKExtra.SCROLL_Y))
            hit_x = Add(x, AK_ExtraGet(ctx, node, AKExtra.SCROLL_X))
        }
        child = AK_Get(ctx, node, AKF.FIRST_CHILD)
        WhileLoop NotEqual(child, -1) {
            best = AK_HitWalk(ctx, child, hit_x, hit_y, best)
            child = AK_Get(ctx, child, AKF.NEXT_SIBLING)
        }

        ReturnValue(best)
    }
}

// =============================================================================
// SET STATE — update node state, mark dirty, return old state
// =============================================================================
Function.AK_SetState {
    Input: ctx: LinkagePool.AKContext
    Input: node: Integer
    Input: new_state: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(node, 0) ThenBlock: { ReturnValue(-1) }
        old = AK_Get(ctx, node, AKF.STATE)
        IfCondition NotEqual(old, new_state) ThenBlock: {
            AK_Set(ctx, node, AKF.STATE, new_state)
            AK_Set(ctx, node, AKF.DIRTY, 1)
            dc = ctx@dirty_count
            ctx@dirty_count = Add(dc, 1)
        }
        ReturnValue(old)
    }
}

// =============================================================================
// MOUSE EVENT DISPATCH — the state machine
//
// States per node: NORMAL -> HOVER -> PRESSED -> NORMAL (or action fire)
//
// MOVE: hit test. If target changed, old->NORMAL, new->HOVER.
//       If pressed_node is set and mouse leaves it, it stays PRESSED
//       (release outside = cancel, release inside = fire).
//
// DOWN: target -> PRESSED, record pressed_node.
//
// UP:   If over pressed_node -> fire action, -> HOVER.
//       If not over pressed_node -> pressed_node -> NORMAL.
//       Clear pressed_node.
// =============================================================================
Function.AK_EventMouse {
    Input: ctx: LinkagePool.AKContext
    Input: mx: Integer
    Input: my: Integer
    Input: ev: Integer
    Input: data: Integer
    Output: Integer
    Body: {
        // Pure dispatcher — each event type handled in its own function
        // to keep local variable count low (compiler codegen workaround).
        target = AK_HitTest(ctx, mx, my)
        IfCondition EqualTo(ev, AKMouseEv.MOVE) ThenBlock: {
            ReturnValue(AK_EventMouseMove(ctx, mx, my, target))
        }
        IfCondition EqualTo(ev, AKMouseEv.DOWN) ThenBlock: {
            ReturnValue(AK_EventMouseDown(ctx, mx, my, target))
        }
        IfCondition EqualTo(ev, AKMouseEv.UP) ThenBlock: {
            ReturnValue(AK_EventMouseUp(ctx, target))
        }
        IfCondition EqualTo(ev, AKMouseEv.WHEEL) ThenBlock: {
            ReturnValue(AK_EventMouseWheel(ctx, target, data))
        }
        ReturnValue(0)
    }
}

// =================================================================
// MOUSE MOVE
// =================================================================
Function.AK_EventMouseMove {
    Input: ctx: LinkagePool.AKContext
    Input: mx: Integer
    Input: my: Integer
    Input: target: Integer
    Output: Integer
    Body: {
        // Scrollbar grab-drag active — delegate to separate function
        sg_node = ctx@scroll_grab_node
        IfCondition GreaterEqual(sg_node, 0) ThenBlock: {
            AK_ScrollbarDrag(ctx, mx, my)
            ReturnValue(0)
        }

        old_hover = ctx@hover_node
        pressed = ctx@pressed_node

        // If we're in a press-drag, check for TEXTFIELD/INPUT drag-select
        IfCondition GreaterEqual(pressed, 0) ThenBlock: {
            // Safety: if left mouse button is no longer held, end the drag
            btn = BitwiseAnd(MouseState.buttons, 1)
            IfCondition EqualTo(btn, 0) ThenBlock: {
                AK_SetState(ctx, pressed, AKState.NORMAL)
                ctx@pressed_node = Negate(1)
            } ElseBlock: {
                ctx@hover_node = target
                p_tag = AK_Get(ctx, pressed, AKF.TAG)
                IfCondition EqualTo(p_tag, AKTag.TEXTFIELD) ThenBlock: {
                    AK_TextfieldDrag(ctx, pressed, mx, my)
                }
                IfCondition EqualTo(p_tag, AKTag.INPUT) ThenBlock: {
                    AK_InputDrag(ctx, pressed, mx)
                }
                ReturnValue(0)
            }
        }

        // Hover changed?
        IfCondition NotEqual(target, old_hover) ThenBlock: {
            IfCondition GreaterEqual(old_hover, 0) ThenBlock: {
                AK_SetState(ctx, old_hover, AKState.NORMAL)
            }
            IfCondition GreaterEqual(target, 0) ThenBlock: {
                AK_SetState(ctx, target, AKState.HOVER)
            }
            ctx@hover_node = target
        }
        ReturnValue(0)
    }
}

// =================================================================
// MOUSE DOWN
// =================================================================
Function.AK_EventMouseDown {
    Input: ctx: LinkagePool.AKContext
    Input: mx: Integer
    Input: my: Integer
    Input: target: Integer
    Output: Integer
    Body: {
        // Check if click lands on a SCROLL node's scrollbar
        sb_target = AK_FindScrollAncestor(ctx, target)
        IfCondition GreaterEqual(target, 0) ThenBlock: {
            t_tag = AK_Get(ctx, target, AKF.TAG)
            IfCondition EqualTo(t_tag, AKTag.SCROLL) ThenBlock: { sb_target = target }
        }
        IfCondition GreaterEqual(sb_target, 0) ThenBlock: {
            sb_hit = AK_ScrollbarGrab(ctx, sb_target, mx, my)
            IfCondition EqualTo(sb_hit, 1) ThenBlock: { ReturnValue(0) }
        }

        // Normal press handling (no scrollbar hit)
        IfCondition GreaterEqual(target, 0) ThenBlock: {
            AK_SetState(ctx, target, AKState.PRESSED)
            ctx@pressed_node = target

            // Focus tracking
            old_focus = ctx@focus_node
            IfCondition NotEqual(old_focus, target) ThenBlock: {
                IfCondition GreaterEqual(old_focus, 0) ThenBlock: {
                    AK_Set(ctx, old_focus, AKF.DIRTY, 1)
                    dc1 = ctx@dirty_count
                    ctx@dirty_count = Add(dc1, 1)
                }
                ctx@focus_node = target
                AK_Set(ctx, target, AKF.DIRTY, 1)
                dc2 = ctx@dirty_count
                ctx@dirty_count = Add(dc2, 1)
            }
        }
        IfCondition LessThan(target, 0) ThenBlock: {
            ctx@focus_node = -1
        }

        // Click-to-cursor for TEXTFIELD and INPUT
        IfCondition GreaterEqual(target, 0) ThenBlock: {
            click_tag = AK_Get(ctx, target, AKF.TAG)
            IfCondition EqualTo(click_tag, AKTag.TEXTFIELD) ThenBlock: {
                AK_TextfieldClick(ctx, target, mx, my)
            }
            IfCondition EqualTo(click_tag, AKTag.INPUT) ThenBlock: {
                AK_InputClick(ctx, target, mx)
            }
        }
        ReturnValue(0)
    }
}

// =================================================================
// MOUSE UP
// =================================================================
Function.AK_EventMouseUp {
    Input: ctx: LinkagePool.AKContext
    Input: target: Integer
    Output: Integer
    Body: {
        // Release scrollbar grab if active
        IfCondition GreaterEqual(ctx@scroll_grab_node, 0) ThenBlock: {
            ctx@scroll_grab_node = -1
            ctx@scroll_grab_axis = 0
            ReturnValue(0)
        }

        pressed = ctx@pressed_node
        IfCondition GreaterEqual(pressed, 0) ThenBlock: {
            IfCondition EqualTo(target, pressed) ThenBlock: {
                AK_FireAction(ctx, pressed)
                AK_SetState(ctx, pressed, AKState.HOVER)
            } ElseBlock: {
                AK_SetState(ctx, pressed, AKState.NORMAL)
            }
        }
        ctx@pressed_node = -1

        IfCondition GreaterEqual(target, 0) ThenBlock: {
            cur_state = AK_Get(ctx, target, AKF.STATE)
            IfCondition EqualTo(cur_state, AKState.NORMAL) ThenBlock: {
                AK_SetState(ctx, target, AKState.HOVER)
                ctx@hover_node = target
            }
        }
        ReturnValue(0)
    }
}

// =================================================================
// MOUSE WHEEL — dispatcher (small frame)
// =================================================================
Function.AK_EventMouseWheel {
    Input: ctx: LinkagePool.AKContext
    Input: target: Integer
    Input: data: Integer
    Output: Integer
    Body: {
        scroll_node = AK_FindScrollAncestor(ctx, target)
        IfCondition GreaterEqual(scroll_node, 0) ThenBlock: {
            AK_WheelScroll(ctx, scroll_node, data)
            ReturnValue(0)
        }
        // No SCROLL ancestor — check for TEXTFIELD (line-based scroll)
        tf_node = AK_FindTextfieldAncestor(ctx, target)
        IfCondition GreaterEqual(tf_node, 0) ThenBlock: {
            AK_WheelTextfield(ctx, tf_node, data)
        }
        ReturnValue(0)
    }
}

// Wheel scroll on SCROLL container (~18 locals)
Function.AK_WheelScroll {
    Input: ctx: LinkagePool.AKContext
    Input: scroll_node: Integer
    Input: data: Integer
    Body: {
        sc_top = AK_Get(ctx, scroll_node, AKF.SOLVED_Y)
        sc_left = AK_Get(ctx, scroll_node, AKF.SOLVED_X)
        sc_vw = AK_Get(ctx, scroll_node, AKF.SOLVED_W)
        sc_vh = AK_Get(ctx, scroll_node, AKF.SOLVED_H)
        cont_h = AK_ScrollExtentH(ctx, scroll_node)
        cont_w = AK_ScrollExtentW(ctx, scroll_node)
        max_scroll_y = Subtract(cont_h, sc_vh)
        IfCondition LessThan(max_scroll_y, 0) ThenBlock: { max_scroll_y = 0 }
        max_scroll_x = Subtract(cont_w, sc_vw)
        IfCondition LessThan(max_scroll_x, 0) ThenBlock: { max_scroll_x = 0 }

        line_h = VFont_GetLineHeight()
        IfCondition LessThan(line_h, 2) ThenBlock: { line_h = Add(UIScale.font_body, 2) }
        scroll_step = Multiply(line_h, 3)

        // Shift+wheel = horizontal scroll
        IfCondition EqualTo(KeyMod.shift, 1) ThenBlock: {
            cur_sx = AK_ExtraGet(ctx, scroll_node, AKExtra.SCROLL_X)
            IfCondition GreaterThan(data, 0) ThenBlock: {
                cur_sx = Subtract(cur_sx, scroll_step)
                IfCondition LessThan(cur_sx, 0) ThenBlock: { cur_sx = 0 }
            }
            IfCondition LessThan(data, 0) ThenBlock: {
                cur_sx = Add(cur_sx, scroll_step)
                IfCondition GreaterThan(cur_sx, max_scroll_x) ThenBlock: { cur_sx = max_scroll_x }
            }
            AK_ExtraSet(ctx, scroll_node, AKExtra.SCROLL_X, cur_sx)
        } ElseBlock: {
            cur_scroll = AK_ExtraGet(ctx, scroll_node, AKExtra.SCROLL_Y)
            IfCondition GreaterThan(data, 0) ThenBlock: {
                cur_scroll = Subtract(cur_scroll, scroll_step)
                IfCondition LessThan(cur_scroll, 0) ThenBlock: { cur_scroll = 0 }
            }
            IfCondition LessThan(data, 0) ThenBlock: {
                cur_scroll = Add(cur_scroll, scroll_step)
                IfCondition GreaterThan(cur_scroll, max_scroll_y) ThenBlock: { cur_scroll = max_scroll_y }
            }
            AK_ExtraSet(ctx, scroll_node, AKExtra.SCROLL_Y, cur_scroll)
        }
        AK_Set(ctx, scroll_node, AKF.DIRTY, 1)
        dc = ctx@dirty_count
        ctx@dirty_count = Add(dc, 1)
        ReturnValue(0)
    }
}

// Wheel scroll on TEXTFIELD (~14 locals)
Function.AK_WheelTextfield {
    Input: ctx: LinkagePool.AKContext
    Input: tf_node: Integer
    Input: data: Integer
    Body: {
        tf_scroll = AK_ExtraGet(ctx, tf_node, AKExtra.SCROLL_Y)
        tf_tbh = AK_ExtraGet(ctx, tf_node, AKExtra.TEXTBUF_H)
        IfCondition GreaterThan(data, 0) ThenBlock: {
            tf_scroll = Subtract(tf_scroll, 3)
            IfCondition LessThan(tf_scroll, 0) ThenBlock: { tf_scroll = 0 }
        }
        IfCondition LessThan(data, 0) ThenBlock: {
            tf_scroll = Add(tf_scroll, 3)
            IfCondition GreaterEqual(tf_tbh, 0) ThenBlock: {
                tf_lc = TextBuf_GetLineCount(tf_tbh)
                tf_sh = AK_Get(ctx, tf_node, AKF.SOLVED_H)
                tf_lh = VFont_GetLineHeight()
                IfCondition LessThan(tf_lh, 2) ThenBlock: { tf_lh = 16 }
                tf_pad = UIScale.ak_textfield_pad
                tf_vis = Divide(Subtract(tf_sh, Multiply(tf_pad, 2)), tf_lh)
                tf_max = Subtract(tf_lc, tf_vis)
                IfCondition LessThan(tf_max, 0) ThenBlock: { tf_max = 0 }
                IfCondition GreaterThan(tf_scroll, tf_max) ThenBlock: { tf_scroll = tf_max }
            }
        }
        AK_ExtraSet(ctx, tf_node, AKExtra.SCROLL_Y, tf_scroll)
        AK_Set(ctx, tf_node, AKF.DIRTY, 1)
        dc2 = ctx@dirty_count
        ctx@dirty_count = Add(dc2, 1)
        ReturnValue(0)
    }
}

// =============================================================================
// SCROLLBAR DRAG — dispatcher (small frame, ~8 locals)
// =============================================================================
Function.AK_ScrollbarDrag {
    Input: ctx: LinkagePool.AKContext
    Input: mx: Integer
    Input: my: Integer
    Body: {
        node = ctx@scroll_grab_node
        IfCondition LessThan(node, 0) ThenBlock: { ReturnValue(0) }
        DebugLog_Push("SG.MV", 5)
        axis = ctx@scroll_grab_axis
        IfCondition EqualTo(axis, 1) ThenBlock: {
            AK_ScrollbarDragV(ctx, node, my)
        }
        IfCondition EqualTo(axis, 2) ThenBlock: {
            AK_ScrollbarDragH(ctx, node, mx)
        }
        AK_Set(ctx, node, AKF.DIRTY, 1)
        dc = ctx@dirty_count
        ctx@dirty_count = Add(dc, 1)
        ReturnValue(0)
    }
}

// Vertical scrollbar drag (~16 locals)
Function.AK_ScrollbarDragV {
    Input: ctx: LinkagePool.AKContext
    Input: node: Integer
    Input: my: Integer
    Body: {
        DebugLog_Push("SG.VD", 5)
        goff = ctx@scroll_grab_offset
        sb_w = 14
        min_thumb = 20
        sy = AK_Get(ctx, node, AKF.SOLVED_Y)
        sw = AK_Get(ctx, node, AKF.SOLVED_W)
        sh = AK_Get(ctx, node, AKF.SOLVED_H)
        cont_h = AK_ScrollExtentH(ctx, node)
        IfCondition LessThan(cont_h, 1) ThenBlock: { cont_h = 1 }
        vp_h = sh
        cont_w = AK_ScrollExtentW(ctx, node)
        IfCondition GreaterThan(cont_w, sw) ThenBlock: { vp_h = Subtract(sh, sb_w) }
        max_y = Subtract(cont_h, vp_h)
        IfCondition LessThan(max_y, 1) ThenBlock: { max_y = 1 }
        thumb_h = Divide(Multiply(vp_h, vp_h), cont_h)
        IfCondition LessThan(thumb_h, min_thumb) ThenBlock: { thumb_h = min_thumb }
        tspace = Subtract(vp_h, thumb_h)
        IfCondition LessThan(tspace, 1) ThenBlock: { tspace = 1 }
        rel = Subtract(Subtract(my, sy), goff)
        IfCondition LessThan(rel, 0) ThenBlock: { rel = 0 }
        IfCondition GreaterThan(rel, tspace) ThenBlock: { rel = tspace }
        new_y = Divide(Multiply(rel, max_y), tspace)
        AK_ExtraSet(ctx, node, AKExtra.SCROLL_Y, new_y)
        ReturnValue(0)
    }
}

// Horizontal scrollbar drag (~16 locals)
Function.AK_ScrollbarDragH {
    Input: ctx: LinkagePool.AKContext
    Input: node: Integer
    Input: mx: Integer
    Body: {
        DebugLog_Push("SG.HD", 5)
        goff = ctx@scroll_grab_offset
        sb_w = 14
        min_thumb = 20
        sx = AK_Get(ctx, node, AKF.SOLVED_X)
        sw = AK_Get(ctx, node, AKF.SOLVED_W)
        sh = AK_Get(ctx, node, AKF.SOLVED_H)
        cont_w = AK_ScrollExtentW(ctx, node)
        IfCondition LessThan(cont_w, 1) ThenBlock: { cont_w = 1 }
        vp_w = sw
        cont_h = AK_ScrollExtentH(ctx, node)
        IfCondition GreaterThan(cont_h, sh) ThenBlock: { vp_w = Subtract(sw, sb_w) }
        max_x = Subtract(cont_w, vp_w)
        IfCondition LessThan(max_x, 1) ThenBlock: { max_x = 1 }
        thumb_w = Divide(Multiply(vp_w, vp_w), cont_w)
        IfCondition LessThan(thumb_w, min_thumb) ThenBlock: { thumb_w = min_thumb }
        tspace_h = Subtract(vp_w, thumb_w)
        IfCondition LessThan(tspace_h, 1) ThenBlock: { tspace_h = 1 }
        rel_x = Subtract(Subtract(mx, sx), goff)
        IfCondition LessThan(rel_x, 0) ThenBlock: { rel_x = 0 }
        IfCondition GreaterThan(rel_x, tspace_h) ThenBlock: { rel_x = tspace_h }
        new_x = Divide(Multiply(rel_x, max_x), tspace_h)
        AK_ExtraSet(ctx, node, AKExtra.SCROLL_X, new_x)
        ReturnValue(0)
    }
}

// =============================================================================
// SCROLLBAR GRAB — dispatcher (~16 locals)
// Checks if mouse-down hits a scrollbar, delegates to V or H grab.
// Returns 1 if scrollbar was hit, 0 otherwise.
// =============================================================================
Function.AK_ScrollbarGrab {
    Input: ctx: LinkagePool.AKContext
    Input: scroll_node: Integer
    Input: mx: Integer
    Input: my: Integer
    Output: Integer
    Body: {
        sb_w = 14
        sx = AK_Get(ctx, scroll_node, AKF.SOLVED_X)
        sy = AK_Get(ctx, scroll_node, AKF.SOLVED_Y)
        sw = AK_Get(ctx, scroll_node, AKF.SOLVED_W)
        sh = AK_Get(ctx, scroll_node, AKF.SOLVED_H)
        cont_h = AK_ScrollExtentH(ctx, scroll_node)
        IfCondition LessThan(cont_h, 1) ThenBlock: { cont_h = 1 }
        cont_w = AK_ScrollExtentW(ctx, scroll_node)
        IfCondition LessThan(cont_w, 1) ThenBlock: { cont_w = 1 }
        has_v = 0
        has_h = 0
        IfCondition GreaterThan(cont_h, sh) ThenBlock: { has_v = 1 }
        IfCondition GreaterThan(cont_w, sw) ThenBlock: { has_h = 1 }
        IfCondition And(EqualTo(has_v, 1), EqualTo(has_h, 0)) ThenBlock: {
            IfCondition GreaterThan(cont_w, Subtract(sw, sb_w)) ThenBlock: { has_h = 1 }
        }
        IfCondition And(EqualTo(has_h, 1), EqualTo(has_v, 0)) ThenBlock: {
            IfCondition GreaterThan(cont_h, Subtract(sh, sb_w)) ThenBlock: { has_v = 1 }
        }

        // Check vertical scrollbar hit: right edge strip
        IfCondition EqualTo(has_v, 1) ThenBlock: {
            vtrack_x = Subtract(Add(sx, sw), sb_w)
            IfCondition And(GreaterEqual(mx, vtrack_x), LessThan(mx, Add(sx, sw))) ThenBlock: {
                IfCondition And(GreaterEqual(my, sy), LessThan(my, Add(sy, sh))) ThenBlock: {
                    ReturnValue(AK_ScrollbarGrabV(ctx, scroll_node, my, cont_h, has_h))
                }
            }
        }

        // Check horizontal scrollbar hit: bottom edge strip
        IfCondition EqualTo(has_h, 1) ThenBlock: {
            htrack_y = Subtract(Add(sy, sh), sb_w)
            IfCondition And(GreaterEqual(my, htrack_y), LessThan(my, Add(sy, sh))) ThenBlock: {
                IfCondition And(GreaterEqual(mx, sx), LessThan(mx, Add(sx, sw))) ThenBlock: {
                    ReturnValue(AK_ScrollbarGrabH(ctx, scroll_node, mx, cont_w, has_v))
                }
            }
        }

        // No scrollbar hit
        ReturnValue(0)
    }
}

// Vertical scrollbar grab — thumb geometry + grab setup (~18 locals)
Function.AK_ScrollbarGrabV {
    Input: ctx: LinkagePool.AKContext
    Input: scroll_node: Integer
    Input: my: Integer
    Input: cont_h: Integer
    Input: has_h: Integer
    Output: Integer
    Body: {
        sb_w = 14
        min_thumb = 20
        sy = AK_Get(ctx, scroll_node, AKF.SOLVED_Y)
        sh = AK_Get(ctx, scroll_node, AKF.SOLVED_H)
        vp_h = sh
        IfCondition EqualTo(has_h, 1) ThenBlock: { vp_h = Subtract(sh, sb_w) }
        max_y = Subtract(cont_h, vp_h)
        IfCondition LessThan(max_y, 1) ThenBlock: { max_y = 1 }
        thumb_h = Divide(Multiply(vp_h, vp_h), cont_h)
        IfCondition LessThan(thumb_h, min_thumb) ThenBlock: { thumb_h = min_thumb }
        tspace = Subtract(vp_h, thumb_h)
        IfCondition LessThan(tspace, 1) ThenBlock: { tspace = 1 }
        cur_y = AK_ExtraGet(ctx, scroll_node, AKExtra.SCROLL_Y)
        toff = Divide(Multiply(cur_y, tspace), max_y)
        thumb_top = Add(sy, toff)
        goff = Subtract(my, thumb_top)
        // If clicked outside thumb (on track), jump
        IfCondition Or(LessThan(goff, 0), GreaterEqual(goff, thumb_h)) ThenBlock: {
            goff = Divide(thumb_h, 2)
            jrel = Subtract(Subtract(my, sy), goff)
            IfCondition LessThan(jrel, 0) ThenBlock: { jrel = 0 }
            IfCondition GreaterThan(jrel, tspace) ThenBlock: { jrel = tspace }
            jnew = Divide(Multiply(jrel, max_y), tspace)
            AK_ExtraSet(ctx, scroll_node, AKExtra.SCROLL_Y, jnew)
            AK_Set(ctx, scroll_node, AKF.DIRTY, 1)
            dc = ctx@dirty_count
            ctx@dirty_count = Add(dc, 1)
        }
        ctx@scroll_grab_node = scroll_node
        ctx@scroll_grab_axis = 1
        ctx@scroll_grab_offset = goff
        ReturnValue(1)
    }
}

// Horizontal scrollbar grab — thumb geometry + grab setup (~18 locals)
Function.AK_ScrollbarGrabH {
    Input: ctx: LinkagePool.AKContext
    Input: scroll_node: Integer
    Input: mx: Integer
    Input: cont_w: Integer
    Input: has_v: Integer
    Output: Integer
    Body: {
        sb_w = 14
        min_thumb = 20
        sx = AK_Get(ctx, scroll_node, AKF.SOLVED_X)
        sw = AK_Get(ctx, scroll_node, AKF.SOLVED_W)
        vp_w = sw
        IfCondition EqualTo(has_v, 1) ThenBlock: { vp_w = Subtract(sw, sb_w) }
        max_x = Subtract(cont_w, vp_w)
        IfCondition LessThan(max_x, 1) ThenBlock: { max_x = 1 }
        thumb_w = Divide(Multiply(vp_w, vp_w), cont_w)
        IfCondition LessThan(thumb_w, min_thumb) ThenBlock: { thumb_w = min_thumb }
        tspace_h = Subtract(vp_w, thumb_w)
        IfCondition LessThan(tspace_h, 1) ThenBlock: { tspace_h = 1 }
        cur_x = AK_ExtraGet(ctx, scroll_node, AKExtra.SCROLL_X)
        htoff = Divide(Multiply(cur_x, tspace_h), max_x)
        thumb_left = Add(sx, htoff)
        hgoff = Subtract(mx, thumb_left)
        // If clicked outside thumb (on track), jump
        IfCondition Or(LessThan(hgoff, 0), GreaterEqual(hgoff, thumb_w)) ThenBlock: {
            hgoff = Divide(thumb_w, 2)
            hjrel = Subtract(Subtract(mx, sx), hgoff)
            IfCondition LessThan(hjrel, 0) ThenBlock: { hjrel = 0 }
            IfCondition GreaterThan(hjrel, tspace_h) ThenBlock: { hjrel = tspace_h }
            hjnew = Divide(Multiply(hjrel, max_x), tspace_h)
            AK_ExtraSet(ctx, scroll_node, AKExtra.SCROLL_X, hjnew)
            AK_Set(ctx, scroll_node, AKF.DIRTY, 1)
            hdc = ctx@dirty_count
            ctx@dirty_count = Add(hdc, 1)
        }
        ctx@scroll_grab_node = scroll_node
        ctx@scroll_grab_axis = 2
        ctx@scroll_grab_offset = hgoff
        ReturnValue(1)
    }
}

// =============================================================================
// SCROLL EXTENT HELPERS — compute content height/width of SCROLL container
// These replace duplicated child-walk loops across Grab/Drag/Wheel functions.
// Each is small (~10 locals) to avoid compiler stack bug.
// =============================================================================
Function.AK_ScrollExtentH {
    Input: ctx: LinkagePool.AKContext
    Input: scroll_node: Integer
    Output: Integer
    Body: {
        sy = AK_Get(ctx, scroll_node, AKF.SOLVED_Y)
        pad_b = AK_Get(ctx, scroll_node, AKF.PAD_B)
        last_b = 0
        ch = AK_Get(ctx, scroll_node, AKF.FIRST_CHILD)
        WhileLoop NotEqual(ch, -1) {
            cv = AK_Get(ctx, ch, AKF.VISIBLE)
            IfCondition EqualTo(cv, 1) ThenBlock: {
                cb = Add(AK_Get(ctx, ch, AKF.SOLVED_Y), AK_Get(ctx, ch, AKF.SOLVED_H))
                IfCondition GreaterThan(cb, last_b) ThenBlock: { last_b = cb }
            }
            ch = AK_Get(ctx, ch, AKF.NEXT_SIBLING)
        }
        IfCondition EqualTo(last_b, 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(Add(Subtract(last_b, sy), pad_b))
    }
}

Function.AK_ScrollExtentW {
    Input: ctx: LinkagePool.AKContext
    Input: scroll_node: Integer
    Output: Integer
    Body: {
        sx = AK_Get(ctx, scroll_node, AKF.SOLVED_X)
        pad_r = AK_Get(ctx, scroll_node, AKF.PAD_R)
        last_r = 0
        ch = AK_Get(ctx, scroll_node, AKF.FIRST_CHILD)
        WhileLoop NotEqual(ch, -1) {
            cv = AK_Get(ctx, ch, AKF.VISIBLE)
            IfCondition EqualTo(cv, 1) ThenBlock: {
                cr = Add(AK_Get(ctx, ch, AKF.SOLVED_X), AK_Get(ctx, ch, AKF.SOLVED_W))
                IfCondition GreaterThan(cr, last_r) ThenBlock: { last_r = cr }
            }
            ch = AK_Get(ctx, ch, AKF.NEXT_SIBLING)
        }
        IfCondition EqualTo(last_r, 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(Add(Subtract(last_r, sx), pad_r))
    }
}

// =============================================================================
// FIND SCROLL ANCESTOR — walk up parent chain to find nearest SCROLL node
// =============================================================================
Function.AK_FindScrollAncestor {
    Input: ctx: LinkagePool.AKContext
    Input: node: Integer
    Output: Integer
    Body: {
        cur = node
        WhileLoop GreaterEqual(cur, 0) {
            t = AK_Get(ctx, cur, AKF.TAG)
            IfCondition EqualTo(t, AKTag.SCROLL) ThenBlock: { ReturnValue(cur) }
            cur = AK_Get(ctx, cur, AKF.PARENT)
        }
        ReturnValue(-1)
    }
}

// =============================================================================
// FIND TEXTFIELD ANCESTOR — walk up parent chain to find nearest TEXTFIELD node
// =============================================================================
Function.AK_FindTextfieldAncestor {
    Input: ctx: LinkagePool.AKContext
    Input: node: Integer
    Output: Integer
    Body: {
        cur = node
        WhileLoop GreaterEqual(cur, 0) {
            t = AK_Get(ctx, cur, AKF.TAG)
            IfCondition EqualTo(t, AKTag.TEXTFIELD) ThenBlock: { ReturnValue(cur) }
            cur = AK_Get(ctx, cur, AKF.PARENT)
        }
        ReturnValue(-1)
    }
}

// =============================================================================
// SCROLL CONTENT HEIGHT — sum solved heights of direct children + gaps
// =============================================================================
Function.AK_ScrollContentHeight {
    Input: ctx: LinkagePool.AKContext
    Input: scroll_node: Integer
    Output: Integer
    Body: {
        // Find the last visible child's bottom edge relative to scroll container
        pad_t = AK_Get(ctx, scroll_node, AKF.PAD_T)
        pad_b = AK_Get(ctx, scroll_node, AKF.PAD_B)
        scroll_top = AK_Get(ctx, scroll_node, AKF.SOLVED_Y)
        last_bottom = 0
        child = AK_Get(ctx, scroll_node, AKF.FIRST_CHILD)
        WhileLoop NotEqual(child, -1) {
            cvis = AK_Get(ctx, child, AKF.VISIBLE)
            IfCondition EqualTo(cvis, 1) ThenBlock: {
                cb = Add(AK_Get(ctx, child, AKF.SOLVED_Y), AK_Get(ctx, child, AKF.SOLVED_H))
                IfCondition GreaterThan(cb, last_bottom) ThenBlock: { last_bottom = cb }
            }
            child = AK_Get(ctx, child, AKF.NEXT_SIBLING)
        }
        // Content height = last child bottom - scroll top + bottom padding
        IfCondition EqualTo(last_bottom, 0) ThenBlock: { ReturnValue(0) }
        content_h = Add(Subtract(last_bottom, scroll_top), pad_b)
        ReturnValue(content_h)
    }
}

// =============================================================================
// FIRE ACTION — placeholder until Service Manager exists
// Reads action string from extra, prints "[ACTION] service.method"
// =============================================================================
Function.AK_FireAction {
    Input: ctx: LinkagePool.AKContext
    Input: node: Integer
    Body: {
        IfCondition LessThan(node, 0) ThenBlock: { ReturnValue(0) }

        // Toggle checkbox VALUE on click
        fire_tag = AK_Get(ctx, node, AKF.TAG)
        IfCondition EqualTo(fire_tag, AKTag.CHECKBOX) ThenBlock: {
            old_val = AK_ExtraGet(ctx, node, AKExtra.VALUE)
            IfCondition EqualTo(old_val, 0) ThenBlock: {
                AK_ExtraSet(ctx, node, AKExtra.VALUE, 1)
            } ElseBlock: {
                AK_ExtraSet(ctx, node, AKExtra.VALUE, 0)
            }
            AK_Set(ctx, node, AKF.DIRTY, 1)
        }

        ext = AK_Get(ctx, node, AKF.EXTRA)
        IfCondition LessThan(ext, 0) ThenBlock: { ReturnValue(0) }

        ap = AK_ExtraGet(ctx, node, AKExtra.ACTION_PTR)
        al = AK_ExtraGet(ctx, node, AKExtra.ACTION_LEN)
        IfCondition And(NotEqual(ap, 0), GreaterThan(al, 0)) ThenBlock: {
            PrintMessage("[ACTION] ")
            PrintString(ap)
            PrintMessage("\n")

            cb = ctx@action_cb
            IfCondition NotEqual(cb, 0) ThenBlock: {
                CallIndirect(cb, ap, al)
            }
        }
        ReturnValue(0)
    }
}

// =============================================================================
// DRAW DIRTY — repaint only changed nodes
// Walks full tree, redraws nodes with DIRTY=1, clears flag.
// Returns 1 if anything was drawn, 0 if clean.
// =============================================================================
Function.AK_DrawDirty {
    Input: ctx: LinkagePool.AKContext
    Input: canvas: Integer
    Output: Integer
    Body: {
        root = ctx@tree_root
        IfCondition LessThan(root, 0) ThenBlock: { ReturnValue(0) }

        ctx@canvas = canvas
        ctx@scroll_offset_y = 0
        AK_ClipInit(ctx)
        drew = AK_DrawDirtyWalk(ctx, root)
        ctx@dirty_count = 0
        ReturnValue(drew)
    }
}

Function.AK_DrawDirtyWalk {
    Input: ctx: LinkagePool.AKContext
    Input: node: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(node, 0) ThenBlock: { ReturnValue(0) }
        vis = AK_Get(ctx, node, AKF.VISIBLE)
        IfCondition EqualTo(vis, 0) ThenBlock: { ReturnValue(0) }

        drew = 0
        dirty = AK_Get(ctx, node, AKF.DIRTY)
        IfCondition EqualTo(dirty, 1) ThenBlock: {
            // Redraw this node — call existing AK_DrawNode
            AK_DrawNode(ctx, node)
            AK_Set(ctx, node, AKF.DIRTY, 0)
            drew = 1
        }

        // Walk children
        child = AK_Get(ctx, node, AKF.FIRST_CHILD)
        WhileLoop NotEqual(child, -1) {
            cd = AK_DrawDirtyWalk(ctx, child)
            IfCondition EqualTo(cd, 1) ThenBlock: { drew = 1 }
            child = AK_Get(ctx, child, AKF.NEXT_SIBLING)
        }

        ReturnValue(drew)
    }
}

// =============================================================================
// KEYBOARD EVENT — route key to focused TEXTFIELD node
// =============================================================================
Function.AK_FindTextField {
    Input: ctx: LinkagePool.AKContext
    Input: node: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(node, 0) ThenBlock: { ReturnValue(-1) }
        tag = AK_Get(ctx, node, AKF.TAG)
        IfCondition EqualTo(tag, AKTag.TEXTFIELD) ThenBlock: { ReturnValue(node) }
        // Search children
        child = AK_Get(ctx, node, AKF.FIRST_CHILD)
        WhileLoop NotEqual(child, -1) {
            found = AK_FindTextField(ctx, child)
            IfCondition GreaterEqual(found, 0) ThenBlock: { ReturnValue(found) }
            child = AK_Get(ctx, child, AKF.NEXT_SIBLING)
        }
        ReturnValue(-1)
    }
}

// =================================================================
// TEXTFIELD pixel → row
// =================================================================
Function.AK_TF_MouseToRow {
    Input: ctx: LinkagePool.AKContext
    Input: target: Integer
    Input: tbh: Integer
    Input: my: Integer
    Output: Integer
    Body: {
        sy = AK_Get(ctx, target, AKF.SOLVED_Y)
        pad = UIScale.ak_textfield_pad
        scroll_y = AK_ExtraGet(ctx, target, AKExtra.SCROLL_Y)
        line_h = VFont_GetLineHeight()
        IfCondition LessThan(line_h, 2) ThenBlock: { line_h = Add(UIScale.font_body, 2) }
        text_y = Add(sy, pad)
        row = Add(scroll_y, Divide(Subtract(my, text_y), line_h))
        line_count = TextBuf_GetLineCount(tbh)
        IfCondition LessThan(row, 0) ThenBlock: { row = 0 }
        IfCondition GreaterEqual(row, line_count) ThenBlock: { row = Subtract(line_count, 1) }
        ReturnValue(row)
    }
}

// =================================================================
// TEXTFIELD pixel → col
// =================================================================
Function.AK_TF_MouseToCol {
    Input: ctx: LinkagePool.AKContext
    Input: target: Integer
    Input: tbh: Integer
    Input: mx: Integer
    Input: row: Integer
    Output: Integer
    Body: {
        sx = AK_Get(ctx, target, AKF.SOLVED_X)
        pad = UIScale.ak_textfield_pad
        show_ln = AK_ExtraGet(ctx, target, AKExtra.LINE_NUMBERS)
        gutter_w = 0
        IfCondition EqualTo(show_ln, 1) ThenBlock: { gutter_w = UIScale.ak_gutter_w }
        text_x = Add(Add(sx, pad), gutter_w)
        rel_x = Subtract(mx, text_x)
        IfCondition LessThan(rel_x, 0) ThenBlock: { rel_x = 0 }
        lptr = TextBuf_GetLine(tbh, row)
        llen = StringLength(lptr)
        col = VFont_PixelToCol(lptr, llen, rel_x)
        ReturnValue(col)
    }
}

// =================================================================
// TEXTFIELD CLICK — place cursor + set selection anchor
// =================================================================
Function.AK_TextfieldClick {
    Input: ctx: LinkagePool.AKContext
    Input: target: Integer
    Input: mx: Integer
    Input: my: Integer
    Body: {
        tbh = AK_ExtraGet(ctx, target, AKExtra.TEXTBUF_H)
        IfCondition LessThan(tbh, 0) ThenBlock: { ReturnValue(0) }
        row = AK_TF_MouseToRow(ctx, target, tbh, my)
        col = AK_TF_MouseToCol(ctx, target, tbh, mx, row)
        TextBuf_SetCursor(tbh, row, col)
        AK_ExtraSet(ctx, target, AKExtra.SEL_START_ROW, row)
        AK_ExtraSet(ctx, target, AKExtra.SEL_START_COL, col)
        AK_ExtraSet(ctx, target, AKExtra.SEL_END_ROW, row)
        AK_ExtraSet(ctx, target, AKExtra.SEL_END_COL, col)
        AK_Set(ctx, target, AKF.DIRTY, 1)
        ctx@dirty_count = Add(ctx@dirty_count, 1)
        ReturnValue(0)
    }
}

// =================================================================
// TEXTFIELD DRAG — update selection end
// =================================================================
Function.AK_TextfieldDrag {
    Input: ctx: LinkagePool.AKContext
    Input: target: Integer
    Input: mx: Integer
    Input: my: Integer
    Body: {
        tbh = AK_ExtraGet(ctx, target, AKExtra.TEXTBUF_H)
        IfCondition LessThan(tbh, 0) ThenBlock: { ReturnValue(0) }
        row = AK_TF_MouseToRow(ctx, target, tbh, my)
        col = AK_TF_MouseToCol(ctx, target, tbh, mx, row)
        TextBuf_SetCursor(tbh, row, col)
        AK_ExtraSet(ctx, target, AKExtra.SEL_END_ROW, row)
        AK_ExtraSet(ctx, target, AKExtra.SEL_END_COL, col)
        AK_Set(ctx, target, AKF.DIRTY, 1)
        ctx@dirty_count = Add(ctx@dirty_count, 1)
        ReturnValue(0)
    }
}

// =================================================================
// INPUT CLICK — place cursor (single-line)
// =================================================================
Function.AK_InputClick {
    Input: ctx: LinkagePool.AKContext
    Input: target: Integer
    Input: mx: Integer
    Body: {
        tbh = AK_ExtraGet(ctx, target, AKExtra.TEXTBUF_H)
        IfCondition LessThan(tbh, 0) ThenBlock: { ReturnValue(0) }
        sx = AK_Get(ctx, target, AKF.SOLVED_X)
        text_x = Add(sx, UIScale.ak_input_pad)
        rel_x = Subtract(mx, text_x)
        IfCondition LessThan(rel_x, 0) ThenBlock: { rel_x = 0 }
        lptr = TextBuf_GetLine(tbh, 0)
        llen = 0
        IfCondition NotEqual(lptr, 0) ThenBlock: { llen = StringLength(lptr) }
        inp_flags = AK_ExtraGet(ctx, target, AKExtra.ROWS)
        inp_is_pw = BitwiseAnd(inp_flags, AKInputFlags.PASSWORD)
        col = 0
        IfCondition NotEqual(inp_is_pw, 0) ThenBlock: {
            star_w = VFont_MeasureWidth("*", 1)
            IfCondition GreaterThan(star_w, 0) ThenBlock: {
                col = Divide(Add(rel_x, Divide(star_w, 2)), star_w)
            }
            IfCondition GreaterThan(col, llen) ThenBlock: { col = llen }
        } ElseBlock: {
            IfCondition NotEqual(lptr, 0) ThenBlock: {
                col = VFont_PixelToCol(lptr, llen, rel_x)
            }
        }
        TextBuf_SetCursor(tbh, 0, col)
        AK_ExtraSet(ctx, target, AKExtra.SEL_START_ROW, 0)
        AK_ExtraSet(ctx, target, AKExtra.SEL_START_COL, col)
        AK_ExtraSet(ctx, target, AKExtra.SEL_END_ROW, 0)
        AK_ExtraSet(ctx, target, AKExtra.SEL_END_COL, col)
        AK_Set(ctx, target, AKF.DIRTY, 1)
        ctx@dirty_count = Add(ctx@dirty_count, 1)
        ReturnValue(0)
    }
}

// =================================================================
// INPUT DRAG — update selection end (single-line)
// =================================================================
Function.AK_InputDrag {
    Input: ctx: LinkagePool.AKContext
    Input: target: Integer
    Input: mx: Integer
    Body: {
        tbh = AK_ExtraGet(ctx, target, AKExtra.TEXTBUF_H)
        IfCondition LessThan(tbh, 0) ThenBlock: { ReturnValue(0) }
        sx = AK_Get(ctx, target, AKF.SOLVED_X)
        text_x = Add(sx, UIScale.ak_input_pad)
        rel_x = Subtract(mx, text_x)
        IfCondition LessThan(rel_x, 0) ThenBlock: { rel_x = 0 }
        lptr = TextBuf_GetLine(tbh, 0)
        llen = 0
        IfCondition NotEqual(lptr, 0) ThenBlock: { llen = StringLength(lptr) }
        inp_flags = AK_ExtraGet(ctx, target, AKExtra.ROWS)
        inp_is_pw = BitwiseAnd(inp_flags, AKInputFlags.PASSWORD)
        col = 0
        IfCondition NotEqual(inp_is_pw, 0) ThenBlock: {
            star_w = VFont_MeasureWidth("*", 1)
            IfCondition GreaterThan(star_w, 0) ThenBlock: {
                col = Divide(Add(rel_x, Divide(star_w, 2)), star_w)
            }
            IfCondition GreaterThan(col, llen) ThenBlock: { col = llen }
        } ElseBlock: {
            IfCondition NotEqual(lptr, 0) ThenBlock: {
                col = VFont_PixelToCol(lptr, llen, rel_x)
            }
        }
        TextBuf_SetCursor(tbh, 0, col)
        AK_ExtraSet(ctx, target, AKExtra.SEL_END_ROW, 0)
        AK_ExtraSet(ctx, target, AKExtra.SEL_END_COL, col)
        AK_Set(ctx, target, AKF.DIRTY, 1)
        ctx@dirty_count = Add(ctx@dirty_count, 1)
        ReturnValue(0)
    }
}

// =================================================================
// SELECTION HELPERS
// =================================================================

// Check if node has active selection (start != end)
Function.AK_HasSelection {
    Input: ctx: LinkagePool.AKContext
    Input: node: Integer
    Output: Integer
    Body: {
        sr = AK_ExtraGet(ctx, node, AKExtra.SEL_START_ROW)
        sc = AK_ExtraGet(ctx, node, AKExtra.SEL_START_COL)
        er = AK_ExtraGet(ctx, node, AKExtra.SEL_END_ROW)
        ec = AK_ExtraGet(ctx, node, AKExtra.SEL_END_COL)
        IfCondition Or(NotEqual(sr, er), NotEqual(sc, ec)) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

// Clear selection on a node
Function.AK_ClearSelection {
    Input: ctx: LinkagePool.AKContext
    Input: node: Integer
    Body: {
        AK_ExtraSet(ctx, node, AKExtra.SEL_START_ROW, 0)
        AK_ExtraSet(ctx, node, AKExtra.SEL_START_COL, 0)
        AK_ExtraSet(ctx, node, AKExtra.SEL_END_ROW, 0)
        AK_ExtraSet(ctx, node, AKExtra.SEL_END_COL, 0)
        ReturnValue(0)
    }
}

// Delete current selection text, collapse cursor to start
Function.AK_DeleteSelection {
    Input: ctx: LinkagePool.AKContext
    Input: node: Integer
    Input: tbh: Integer
    Body: {
        sr = AK_ExtraGet(ctx, node, AKExtra.SEL_START_ROW)
        sc = AK_ExtraGet(ctx, node, AKExtra.SEL_START_COL)
        er = AK_ExtraGet(ctx, node, AKExtra.SEL_END_ROW)
        ec = AK_ExtraGet(ctx, node, AKExtra.SEL_END_COL)
        TextBuf_DeleteRange(tbh, sr, sc, er, ec)
        AK_ClearSelection(ctx, node)
        ReturnValue(0)
    }
}

// Helper: delete selection if any exists (for insert operations)
Function.AK_EditDeleteSelIfAny {
    Input: ctx: LinkagePool.AKContext
    Input: target: Integer
    Input: tbh: Integer
    Body: {
        has_sel = AK_HasSelection(ctx, target)
        IfCondition EqualTo(has_sel, 1) ThenBlock: {
            AK_DeleteSelection(ctx, target, tbh)
        }
        ReturnValue(0)
    }
}

// =================================================================
// NAV KEYS — arrow/home/end/page with Shift selection
// Inputs=5, body=6 → 11 locals
// =================================================================
Function.AK_EventKeyNav {
    Input: ctx: LinkagePool.AKContext
    Input: target: Integer
    Input: tbh: Integer
    Input: keycode: Integer
    Input: shift: Integer
    Output: Integer
    Body: {
        // Check if this is a nav key
        is_nav = 0
        IfCondition EqualTo(keycode, Key.LEFT)     ThenBlock: { is_nav = 1 }
        IfCondition EqualTo(keycode, Key.RIGHT)    ThenBlock: { is_nav = 1 }
        IfCondition EqualTo(keycode, Key.UP)       ThenBlock: { is_nav = 1 }
        IfCondition EqualTo(keycode, Key.DOWN)     ThenBlock: { is_nav = 1 }
        IfCondition EqualTo(keycode, Key.HOME)     ThenBlock: { is_nav = 1 }
        IfCondition EqualTo(keycode, Key.END)      ThenBlock: { is_nav = 1 }
        IfCondition EqualTo(keycode, Key.PAGEUP)   ThenBlock: { is_nav = 1 }
        IfCondition EqualTo(keycode, Key.PAGEDOWN) ThenBlock: { is_nav = 1 }
        IfCondition EqualTo(is_nav, 0) ThenBlock: { ReturnValue(0) }

        // If shift held: set anchor if no existing selection
        IfCondition EqualTo(shift, 1) ThenBlock: {
            has_sel = AK_HasSelection(ctx, target)
            IfCondition EqualTo(has_sel, 0) ThenBlock: {
                crow = TextBuf_GetCursorRow(tbh)
                ccol = TextBuf_GetCursorCol(tbh)
                AK_ExtraSet(ctx, target, AKExtra.SEL_START_ROW, crow)
                AK_ExtraSet(ctx, target, AKExtra.SEL_START_COL, ccol)
                AK_ExtraSet(ctx, target, AKExtra.SEL_END_ROW, crow)
                AK_ExtraSet(ctx, target, AKExtra.SEL_END_COL, ccol)
            }
        }

        // Move cursor
        IfCondition EqualTo(keycode, Key.LEFT)     ThenBlock: { TextBuf_MoveLeft(tbh) }
        IfCondition EqualTo(keycode, Key.RIGHT)    ThenBlock: { TextBuf_MoveRight(tbh) }
        IfCondition EqualTo(keycode, Key.UP)       ThenBlock: { TextBuf_MoveUp(tbh) }
        IfCondition EqualTo(keycode, Key.DOWN)     ThenBlock: { TextBuf_MoveDown(tbh) }
        IfCondition EqualTo(keycode, Key.HOME)     ThenBlock: { TextBuf_Home(tbh) }
        IfCondition EqualTo(keycode, Key.END)      ThenBlock: { TextBuf_End(tbh) }
        IfCondition EqualTo(keycode, Key.PAGEUP)   ThenBlock: { TextBuf_PageUp(tbh, 20) }
        IfCondition EqualTo(keycode, Key.PAGEDOWN) ThenBlock: { TextBuf_PageDown(tbh, 20) }

        // After move: update selection end or clear
        IfCondition EqualTo(shift, 1) ThenBlock: {
            new_row = TextBuf_GetCursorRow(tbh)
            new_col = TextBuf_GetCursorCol(tbh)
            AK_ExtraSet(ctx, target, AKExtra.SEL_END_ROW, new_row)
            AK_ExtraSet(ctx, target, AKExtra.SEL_END_COL, new_col)
        } ElseBlock: {
            AK_ClearSelection(ctx, target)
        }
        ReturnValue(1)
    }
}

// =================================================================
// EDIT KEYS — char/backspace/delete/tab/enter (selection-aware)
// Inputs=6, body=3 → 9 locals
// =================================================================
Function.AK_EventKeyEdit {
    Input: ctx: LinkagePool.AKContext
    Input: target: Integer
    Input: tbh: Integer
    Input: keycode: Integer
    Input: ch: Integer
    Input: ctrl: Integer
    Output: Integer
    Body: {
        handled = 0
        target_tag = AK_Get(ctx, target, AKF.TAG)

        // Ctrl shortcuts
        IfCondition EqualTo(ctrl, 1) ThenBlock: {
            IfCondition Or(EqualTo(target_tag, AKTag.TEXTFIELD), EqualTo(target_tag, AKTag.INPUT)) ThenBlock: {
                ReturnValue(AK_EventKeyCtrl(ctx, target, tbh, ch))
            }
        }

        // Tab — context-dependent
        IfCondition EqualTo(keycode, Key.TAB) ThenBlock: {
            IfCondition EqualTo(target_tag, AKTag.TEXTFIELD) ThenBlock: {
                AK_EditDeleteSelIfAny(ctx, target, tbh)
                TextBuf_InsertChar(tbh, 32)
                TextBuf_InsertChar(tbh, 32)
                TextBuf_InsertChar(tbh, 32)
                TextBuf_InsertChar(tbh, 32)
                handled = 1
            }
        }

        // Enter — context-dependent
        IfCondition EqualTo(keycode, Key.ENTER) ThenBlock: {
            IfCondition EqualTo(target_tag, AKTag.INPUT) ThenBlock: {
                AK_FireAction(ctx, target)
                handled = 1
            } ElseBlock: {
                AK_EditDeleteSelIfAny(ctx, target, tbh)
                TextBuf_Enter(tbh)
                handled = 1
            }
        }

        // Printable character — only when ctrl NOT held and not Tab/Enter
        IfCondition And(And(GreaterThan(ch, 0), EqualTo(ctrl, 0)), EqualTo(handled, 0)) ThenBlock: {
            AK_EditDeleteSelIfAny(ctx, target, tbh)
            TextBuf_InsertChar(tbh, ch)
            handled = 1
        }

        // Backspace — delete selection if active, else normal backspace
        IfCondition EqualTo(keycode, Key.BACKSPACE) ThenBlock: {
            has_sel = AK_HasSelection(ctx, target)
            IfCondition EqualTo(has_sel, 1) ThenBlock: {
                AK_DeleteSelection(ctx, target, tbh)
            } ElseBlock: {
                TextBuf_Backspace(tbh)
            }
            handled = 1
        }

        // Delete — delete selection if active, else normal delete
        IfCondition EqualTo(keycode, Key.DELETE) ThenBlock: {
            has_sel = AK_HasSelection(ctx, target)
            IfCondition EqualTo(has_sel, 1) ThenBlock: {
                AK_DeleteSelection(ctx, target, tbh)
            } ElseBlock: {
                TextBuf_Delete(tbh)
            }
            handled = 1
        }

        ReturnValue(handled)
    }
}

// Copy selection text to clipboard
Function.AK_CopySelection {
    Input: ctx: LinkagePool.AKContext
    Input: target: Integer
    Input: tbh: Integer
    Body: {
        sr = AK_ExtraGet(ctx, target, AKExtra.SEL_START_ROW)
        sc = AK_ExtraGet(ctx, target, AKExtra.SEL_START_COL)
        er = AK_ExtraGet(ctx, target, AKExtra.SEL_END_ROW)
        ec = AK_ExtraGet(ctx, target, AKExtra.SEL_END_COL)
        txt = TextBuf_GetRangeText(tbh, sr, sc, er, ec)
        IfCondition NotEqual(txt, 0) ThenBlock: {
            tlen = StringLength(txt)
            Clipboard_Set(txt, tlen)
            Deallocate(txt, Add(tlen, 1))
        }
        ReturnValue(0)
    }
}

// =================================================================
// CTRL SHORTCUTS — C/V/X/A
// =================================================================
Function.AK_EventKeyCtrl {
    Input: ctx: LinkagePool.AKContext
    Input: target: Integer
    Input: tbh: Integer
    Input: ch: Integer
    Output: Integer
    Body: {
        // Ctrl+A — select all
        IfCondition Or(EqualTo(ch, 1), EqualTo(ch, 97)) ThenBlock: {
            AK_ExtraSet(ctx, target, AKExtra.SEL_START_ROW, 0)
            AK_ExtraSet(ctx, target, AKExtra.SEL_START_COL, 0)
            last_row = Subtract(TextBuf_GetLineCount(tbh), 1)
            IfCondition LessThan(last_row, 0) ThenBlock: { last_row = 0 }
            last_lptr = TextBuf_GetLine(tbh, last_row)
            last_col = StringLength(last_lptr)
            AK_ExtraSet(ctx, target, AKExtra.SEL_END_ROW, last_row)
            AK_ExtraSet(ctx, target, AKExtra.SEL_END_COL, last_col)
            TextBuf_SetCursor(tbh, last_row, last_col)
            ReturnValue(1)
        }

        // Ctrl+C — copy
        IfCondition Or(EqualTo(ch, 3), EqualTo(ch, 99)) ThenBlock: {
            has_sel = AK_HasSelection(ctx, target)
            IfCondition EqualTo(has_sel, 1) ThenBlock: {
                AK_CopySelection(ctx, target, tbh)
            }
            ReturnValue(1)
        }

        // Ctrl+X — cut
        IfCondition Or(EqualTo(ch, 24), EqualTo(ch, 120)) ThenBlock: {
            has_sel = AK_HasSelection(ctx, target)
            IfCondition EqualTo(has_sel, 1) ThenBlock: {
                AK_CopySelection(ctx, target, tbh)
                AK_DeleteSelection(ctx, target, tbh)
            }
            ReturnValue(1)
        }

        // Ctrl+V — paste
        IfCondition Or(EqualTo(ch, 22), EqualTo(ch, 118)) ThenBlock: {
            AK_EditDeleteSelIfAny(ctx, target, tbh)
            clip_ptr = Clipboard_Get()
            clip_len = Clipboard.len
            IfCondition And(NotEqual(clip_ptr, 0), GreaterThan(clip_len, 0)) ThenBlock: {
                TextBuf_InsertString(tbh, clip_ptr, clip_len)
            }
            ReturnValue(1)
        }

        ReturnValue(0)
    }
}

// =================================================================
// KEYBOARD EVENT — thin dispatcher
// Inputs=5, body=6 → 11 locals
// =================================================================
Function.AK_EventKey {
    Input: ctx: LinkagePool.AKContext
    Input: keycode: Integer
    Input: ch: Integer
    Input: shift: Integer
    Input: ctrl: Integer
    Body: {
        // Find focused text-input — must be TEXTFIELD or INPUT
        target = ctx@focus_node
        target_tag = -1
        IfCondition GreaterEqual(target, 0) ThenBlock: {
            target_tag = AK_Get(ctx, target, AKF.TAG)
            IfCondition And(NotEqual(target_tag, AKTag.TEXTFIELD), NotEqual(target_tag, AKTag.INPUT)) ThenBlock: {
                target = -1
                target_tag = -1
            }
        }
        // Fallback: search tree for first TEXTFIELD
        IfCondition LessThan(target, 0) ThenBlock: {
            root = ctx@tree_root
            target = AK_FindTextField(ctx, root)
            IfCondition GreaterEqual(target, 0) ThenBlock: {
                target_tag = AK_Get(ctx, target, AKF.TAG)
            }
        }
        IfCondition LessThan(target, 0) ThenBlock: { ReturnValue(0) }

        // Get TextBuffer handle
        tbh = AK_ExtraGet(ctx, target, AKExtra.TEXTBUF_H)
        IfCondition LessThan(tbh, 0) ThenBlock: { ReturnValue(0) }

        // Try nav keys first, then edit keys
        handled = AK_EventKeyNav(ctx, target, tbh, keycode, shift)
        IfCondition EqualTo(handled, 0) ThenBlock: {
            handled = AK_EventKeyEdit(ctx, target, tbh, keycode, ch, ctrl)
        }

        // Mark dirty
        IfCondition EqualTo(handled, 1) ThenBlock: {
            AK_Set(ctx, target, AKF.DIRTY, 1)
            dc = ctx@dirty_count
            ctx@dirty_count = Add(dc, 1)
        }

        ReturnValue(handled)
    }
}
