// Library.InputBar.ailang — wrapping blit input. Grows with text, clips to the bar.
// Word-wrap (do not split tokens). Scrollbar once the box hits max rows.
// Copy/paste via host IPC. GTK/Haiku only forward keys and clipboard files.
// Cap is 1MB so a ~1200 line paste is not silently truncated.
//
// Copyright (c) 2026 Sean Collins, 2 Paws Machine and Engineering. MIT.

LibraryImport.Arena
LibraryImport.Display.Render.Framebuffer
LibraryImport.Display.Render.Fonts

FixedPool.IBar {
    "buf":    Initialize=0, CanChange=True
    "len":    Initialize=0, CanChange=True
    "cap":    Initialize=1048576, CanChange=True
    "x":      Initialize=0, CanChange=True
    "y":      Initialize=0, CanChange=True
    "w":      Initialize=200, CanChange=True
    "h":      Initialize=24, CanChange=True
    "focus":  Initialize=1, CanChange=True
    "i":      Initialize=0, CanChange=True
    "c":      Initialize=0, CanChange=True
    "scroll": Initialize=0, CanChange=True
    "tot":    Initialize=1, CanChange=True
    "cr":     Initialize=0, CanChange=True
    "cc":     Initialize=0, CanChange=True
    "follow": Initialize=1, CanChange=True
    "maxr":   Initialize=8, CanChange=True
    "go":     Initialize=0, CanChange=True
    "cur":    Initialize=0, CanChange=True
    "cw":     Initialize=8, CanChange=True
    "lh":     Initialize=12, CanChange=True
    "eng":    Initialize=0, CanChange=True
    "surf":   Initialize=0, CanChange=True
    "sbw":    Initialize=8, CanChange=True
    "gt":     Initialize=0, CanChange=True
    "sa":     Initialize=0, CanChange=True
    "sb":     Initialize=0, CanChange=True
}

Function.InputBar.Init {
    Input: cap: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(cap, 16) ThenBlock: { cap = 16 }
        IBar.cap = cap
        IBar.buf = Allocate(Add(cap, 1))
        SetByte(IBar.buf, 0, 0)
        IBar.len = 0
        IBar.focus = 1
        IBar.scroll = 0
        IBar.tot = 1
        IBar.cr = 0
        IBar.cc = 0
        IBar.follow = 1
        IBar.maxr = 8
        IBar.cur = 0
        IBar.sa = 0
        IBar.sb = 0
        IBar.cw = 8
        IBar.lh = 12
        IBar.eng = 0
        IBar.sbw = 8
        IBar.gt = Allocate(2)
        SetByte(IBar.gt, 0, 62)
        SetByte(IBar.gt, 1, 0)
        ReturnValue(1)
    }
}

Function.InputBar.SetRect {
    Input: x: Integer
    Input: y: Integer
    Input: w: Integer
    Input: h: Integer
    Body: {
        IBar.x = x
        IBar.y = y
        IBar.w = w
        IBar.h = h
    }
}

Function.InputBar.Text {
    Output: Address
    Body: { ReturnValue(IBar.buf) }
}

Function.InputBar.Len {
    Output: Integer
    Body: { ReturnValue(IBar.len) }
}

Function.InputBar.Clear {
    Body: {
        IBar.len = 0
        IBar.scroll = 0
        IBar.tot = 1
        IBar.cr = 0
        IBar.cc = 0
        IBar.follow = 1
        IBar.cur = 0
        IBar.sa = 0
        IBar.sb = 0
        IfCondition NotEqual(IBar.buf, 0) ThenBlock: { SetByte(IBar.buf, 0, 0) }
    }
}

Function.InputBar.HasSel {
    Output: Integer
    Body: {
        IfCondition NotEqual(IBar.sa, IBar.sb) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

Function.InputBar.ClearSel {
    Body: {
        IBar.sa = IBar.cur
        IBar.sb = IBar.cur
    }
}

Function.InputBar.SelDel {
    Output: Integer
    Body: {
        IfCondition EqualTo(IBar.sa, IBar.sb) ThenBlock: { ReturnValue(0) }
        lo = IBar.sa
        hi = IBar.sb
        IfCondition GreaterThan(lo, hi) ThenBlock: {
            lo = IBar.sb
            hi = IBar.sa
        }
        IfCondition LessThan(lo, 0) ThenBlock: { lo = 0 }
        IfCondition GreaterThan(hi, IBar.len) ThenBlock: { hi = IBar.len }
        IBar.i = lo
        WhileLoop LessThan(Add(IBar.i, Subtract(hi, lo)), IBar.len) {
            SetByte(IBar.buf, IBar.i, GetByte(IBar.buf, Add(IBar.i, Subtract(hi, lo))))
            IBar.i = Add(IBar.i, 1)
        }
        IBar.len = Subtract(IBar.len, Subtract(hi, lo))
        SetByte(IBar.buf, IBar.len, 0)
        IBar.cur = lo
        IBar.sa = lo
        IBar.sb = lo
        IBar.follow = 1
        ReturnValue(1)
    }
}

Function.InputBar.Put {
    Input: ch: Integer
    Output: Integer
    Body: {
        InputBar.SelDel()
        IfCondition GreaterEqual(IBar.len, Subtract(IBar.cap, 1)) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(IBar.cur, 0) ThenBlock: { IBar.cur = 0 }
        IfCondition GreaterThan(IBar.cur, IBar.len) ThenBlock: { IBar.cur = IBar.len }
        IfCondition LessThan(IBar.cur, IBar.len) ThenBlock: {
            IBar.i = IBar.len
            WhileLoop GreaterThan(IBar.i, IBar.cur) {
                SetByte(IBar.buf, IBar.i, GetByte(IBar.buf, Subtract(IBar.i, 1)))
                IBar.i = Subtract(IBar.i, 1)
            }
        }
        SetByte(IBar.buf, IBar.cur, ch)
        IBar.cur = Add(IBar.cur, 1)
        IBar.len = Add(IBar.len, 1)
        SetByte(IBar.buf, IBar.len, 0)
        IBar.sa = IBar.cur
        IBar.sb = IBar.cur
        IBar.follow = 1
        ReturnValue(1)
    }
}

Function.InputBar.Char {
    Input: ch: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(ch, 32) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterEqual(ch, 127) ThenBlock: { ReturnValue(0) }
        ReturnValue(InputBar.Put(ch))
    }
}

Function.InputBar.Bs {
    Output: Integer
    Body: {
        IfCondition EqualTo(InputBar.SelDel(), 1) ThenBlock: { ReturnValue(1) }
        IfCondition LessEqual(IBar.cur, 0) ThenBlock: { ReturnValue(0) }
        IBar.cur = Subtract(IBar.cur, 1)
        IBar.i = IBar.cur
        WhileLoop LessThan(IBar.i, IBar.len) {
            SetByte(IBar.buf, IBar.i, GetByte(IBar.buf, Add(IBar.i, 1)))
            IBar.i = Add(IBar.i, 1)
        }
        IBar.len = Subtract(IBar.len, 1)
        SetByte(IBar.buf, IBar.len, 0)
        IBar.sa = IBar.cur
        IBar.sb = IBar.cur
        IBar.follow = 1
        ReturnValue(1)
    }
}

Function.InputBar.Del {
    Output: Integer
    Body: {
        IfCondition EqualTo(InputBar.SelDel(), 1) ThenBlock: { ReturnValue(1) }
        IfCondition GreaterEqual(IBar.cur, IBar.len) ThenBlock: { ReturnValue(0) }
        IBar.i = IBar.cur
        WhileLoop LessThan(IBar.i, IBar.len) {
            SetByte(IBar.buf, IBar.i, GetByte(IBar.buf, Add(IBar.i, 1)))
            IBar.i = Add(IBar.i, 1)
        }
        IBar.len = Subtract(IBar.len, 1)
        SetByte(IBar.buf, IBar.len, 0)
        IBar.sa = IBar.cur
        IBar.sb = IBar.cur
        IBar.follow = 1
        ReturnValue(1)
    }
}

Function.InputBar.Tab {
    Output: Integer
    Body: {
        IBar.c = 0
        WhileLoop LessThan(IBar.c, 4) {
            IfCondition EqualTo(InputBar.Put(32), 0) ThenBlock: { ReturnValue(0) }
            IBar.c = Add(IBar.c, 1)
        }
        ReturnValue(1)
    }
}

Function.InputBar.Paste {
    Input: src: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(src, 0) ThenBlock: { ReturnValue(0) }
        IBar.i = 0
        WhileLoop LessThan(IBar.len, Subtract(IBar.cap, 1)) {
            IBar.c = GetByte(src, IBar.i)
            IfCondition EqualTo(IBar.c, 0) ThenBlock: { ReturnValue(1) }
            IfCondition EqualTo(IBar.c, 13) ThenBlock: {
                IfCondition EqualTo(InputBar.Put(10), 0) ThenBlock: { ReturnValue(1) }
                IBar.i = Add(IBar.i, 1)
                IfCondition EqualTo(GetByte(src, IBar.i), 10) ThenBlock: {
                    IBar.i = Add(IBar.i, 1)
                }
            }
            ElseBlock: {
                IfCondition EqualTo(IBar.c, 10) ThenBlock: {
                    IfCondition EqualTo(InputBar.Put(10), 0) ThenBlock: { ReturnValue(1) }
                    IBar.i = Add(IBar.i, 1)
                }
                ElseBlock: {
                    IfCondition EqualTo(IBar.c, 9) ThenBlock: {
                        IBar.c = 0
                        WhileLoop LessThan(IBar.c, 4) {
                            IfCondition EqualTo(InputBar.Put(32), 0) ThenBlock: { ReturnValue(1) }
                            IBar.c = Add(IBar.c, 1)
                        }
                        IBar.i = Add(IBar.i, 1)
                    }
                    ElseBlock: {
                        IfCondition And(GreaterEqual(IBar.c, 32), LessThan(IBar.c, 127)) ThenBlock: {
                            IfCondition EqualTo(InputBar.Put(IBar.c), 0) ThenBlock: { ReturnValue(1) }
                        }
                        IBar.i = Add(IBar.i, 1)
                    }
                }
            }
        }
        ReturnValue(1)
    }
}

Function.InputBar.SetFocus {
    Input: on: Integer
    Body: {
        IBar.focus = on
    }
}

Function.InputBar.SetMetrics {
    Input: cw: Integer
    Input: lh: Integer
    Input: eng: Integer
    Input: surf: Integer
    Body: {
        IfCondition LessThan(cw, 4) ThenBlock: { cw = 4 }
        IfCondition LessThan(lh, 10) ThenBlock: { lh = 10 }
        IBar.cw = cw
        IBar.lh = lh
        IBar.eng = eng
        IBar.surf = surf
    }
}

Function.InputBar.Cols {
    Output: Integer
    Body: {
        n = Divide(Subtract(IBar.w, Add(Add(IBar.cw, 18), IBar.sbw)), IBar.cw)
        IfCondition LessThan(n, 8) ThenBlock: { n = 8 }
        ReturnValue(n)
    }
}

Function.InputBar.WordLen {
    Input: start: Integer
    Output: Integer
    Body: {
        n = 0
        more = 1
        WhileLoop And(EqualTo(more, 1), LessThan(Add(start, n), IBar.len)) {
            IBar.c = GetByte(IBar.buf, Add(start, n))
            IfCondition Or(EqualTo(IBar.c, 32), EqualTo(IBar.c, 10)) ThenBlock: {
                more = 0
            }
            ElseBlock: {
                n = Add(n, 1)
            }
        }
        ReturnValue(n)
    }
}

Function.InputBar.LineEnd {
    Input: start: Integer
    Output: Integer
    Body: {
        vis = InputBar.Cols()
        IfCondition GreaterEqual(start, IBar.len) ThenBlock: { ReturnValue(IBar.len) }
        IfCondition EqualTo(GetByte(IBar.buf, start), 10) ThenBlock: {
            ReturnValue(Add(start, 1))
        }
        i = start
        col = 0
        IBar.go = 1
        WhileLoop And(EqualTo(IBar.go, 1), LessThan(i, IBar.len)) {
            ch = GetByte(IBar.buf, i)
            IfCondition EqualTo(ch, 10) ThenBlock: {
                i = Add(i, 1)
                IBar.go = 0
            }
            ElseBlock: {
                IfCondition EqualTo(ch, 32) ThenBlock: {
                    IfCondition GreaterThan(Add(col, 1), vis) ThenBlock: {
                        IfCondition EqualTo(col, 0) ThenBlock: { i = Add(i, 1) }
                        IBar.go = 0
                    }
                    ElseBlock: {
                        col = Add(col, 1)
                        i = Add(i, 1)
                    }
                }
                ElseBlock: {
                    wlen = InputBar.WordLen(i)
                    IfCondition EqualTo(wlen, 0) ThenBlock: {
                        i = Add(i, 1)
                        IBar.go = 0
                    }
                    ElseBlock: {
                        IfCondition GreaterThan(wlen, vis) ThenBlock: {
                            IfCondition EqualTo(col, 0) ThenBlock: {
                                i = Add(i, vis)
                            }
                            IBar.go = 0
                        }
                        ElseBlock: {
                            IfCondition GreaterThan(Add(col, wlen), vis) ThenBlock: {
                                IBar.go = 0
                            }
                            ElseBlock: {
                                col = Add(col, wlen)
                                i = Add(i, wlen)
                            }
                        }
                    }
                }
            }
        }
        ReturnValue(i)
    }
}

Function.InputBar.PlaceCaret {
    Body: {
        IfCondition LessThan(IBar.cur, 0) ThenBlock: { IBar.cur = 0 }
        IfCondition GreaterThan(IBar.cur, IBar.len) ThenBlock: { IBar.cur = IBar.len }
        IBar.cr = 0
        IBar.cc = 0
        IfCondition EqualTo(IBar.len, 0) ThenBlock: { ReturnValue(0) }
        IBar.i = 0
        row = 0
        WhileLoop LessThan(IBar.i, IBar.len) {
            nxt = InputBar.LineEnd(IBar.i)
            IfCondition LessEqual(nxt, IBar.i) ThenBlock: { nxt = Add(IBar.i, 1) }
            dend = nxt
            IfCondition And(GreaterThan(dend, IBar.i), EqualTo(GetByte(IBar.buf, Subtract(dend, 1)), 10)) ThenBlock: {
                dend = Subtract(dend, 1)
            }
            dw = Subtract(dend, IBar.i)
            IfCondition LessThan(IBar.cur, nxt) ThenBlock: {
                IBar.cr = row
                IBar.cc = Subtract(IBar.cur, IBar.i)
                IfCondition GreaterThan(IBar.cc, dw) ThenBlock: { IBar.cc = dw }
                IfCondition LessThan(IBar.cc, 0) ThenBlock: { IBar.cc = 0 }
                ReturnValue(0)
            }
            IfCondition And(EqualTo(IBar.cur, nxt), EqualTo(nxt, IBar.len)) ThenBlock: {
                IfCondition NotEqual(GetByte(IBar.buf, Subtract(IBar.len, 1)), 10) ThenBlock: {
                    IBar.cr = row
                    IBar.cc = dw
                    ReturnValue(0)
                }
            }
            row = Add(row, 1)
            IBar.i = nxt
        }
        IBar.cr = row
        IBar.cc = 0
    }
}

Function.InputBar.Measure {
    Body: {
        IBar.tot = 0
        IfCondition EqualTo(IBar.len, 0) ThenBlock: {
            IBar.tot = 1
        }
        ElseBlock: {
            IBar.i = 0
            WhileLoop LessThan(IBar.i, IBar.len) {
                nxt = InputBar.LineEnd(IBar.i)
                IfCondition LessEqual(nxt, IBar.i) ThenBlock: { nxt = Add(IBar.i, 1) }
                IBar.tot = Add(IBar.tot, 1)
                IBar.i = nxt
            }
            IfCondition EqualTo(GetByte(IBar.buf, Subtract(IBar.len, 1)), 10) ThenBlock: {
                IBar.tot = Add(IBar.tot, 1)
            }
        }
        IfCondition LessThan(IBar.tot, 1) ThenBlock: { IBar.tot = 1 }
        InputBar.PlaceCaret()
        IfCondition LessThan(IBar.cr, 0) ThenBlock: { IBar.cr = 0 }
    }
}

Function.InputBar.RowStart {
    Input: idx: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(idx, 0) ThenBlock: { idx = 0 }
        IfCondition GreaterThan(idx, IBar.len) ThenBlock: { idx = IBar.len }
        IfCondition EqualTo(idx, 0) ThenBlock: { ReturnValue(0) }
        IfCondition And(EqualTo(idx, IBar.len), GreaterThan(IBar.len, 0)) ThenBlock: {
            IfCondition EqualTo(GetByte(IBar.buf, Subtract(IBar.len, 1)), 10) ThenBlock: {
                ReturnValue(IBar.len)
            }
        }
        IBar.i = 0
        WhileLoop LessThan(IBar.i, IBar.len) {
            nxt = InputBar.LineEnd(IBar.i)
            IfCondition LessEqual(nxt, IBar.i) ThenBlock: { nxt = Add(IBar.i, 1) }
            IfCondition LessThan(idx, nxt) ThenBlock: { ReturnValue(IBar.i) }
            IfCondition And(EqualTo(idx, nxt), EqualTo(nxt, IBar.len)) ThenBlock: { ReturnValue(IBar.i) }
            IBar.i = nxt
        }
        ReturnValue(0)
    }
}

Function.InputBar.Left {
    Body: {
        IfCondition GreaterThan(IBar.cur, 0) ThenBlock: { IBar.cur = Subtract(IBar.cur, 1) }
        IBar.follow = 1
    }
}

Function.InputBar.Right {
    Body: {
        IfCondition LessThan(IBar.cur, IBar.len) ThenBlock: { IBar.cur = Add(IBar.cur, 1) }
        IBar.follow = 1
    }
}

Function.InputBar.Home {
    Body: {
        IBar.cur = InputBar.RowStart(IBar.cur)
        IBar.follow = 1
    }
}

Function.InputBar.End {
    Body: {
        s = InputBar.RowStart(IBar.cur)
        IfCondition GreaterEqual(s, IBar.len) ThenBlock: {
            IBar.cur = IBar.len
        }
        ElseBlock: {
            e = InputBar.LineEnd(s)
            IfCondition And(GreaterThan(e, s), EqualTo(GetByte(IBar.buf, Subtract(e, 1)), 10)) ThenBlock: {
                e = Subtract(e, 1)
            }
            IBar.cur = e
        }
        IBar.follow = 1
    }
}

Function.InputBar.Up {
    Body: {
        s = InputBar.RowStart(IBar.cur)
        IfCondition EqualTo(s, 0) ThenBlock: {
            IBar.cur = 0
            IBar.follow = 1
            ReturnValue(0)
        }
        col = Subtract(IBar.cur, s)
        ps = 0
        IBar.i = 0
        WhileLoop LessThan(IBar.i, s) {
            ps = IBar.i
            nxt = InputBar.LineEnd(IBar.i)
            IfCondition LessEqual(nxt, IBar.i) ThenBlock: { nxt = Add(IBar.i, 1) }
            IBar.i = nxt
        }
        pe = InputBar.LineEnd(ps)
        dend = pe
        IfCondition And(GreaterThan(dend, ps), EqualTo(GetByte(IBar.buf, Subtract(dend, 1)), 10)) ThenBlock: {
            dend = Subtract(dend, 1)
        }
        dw = Subtract(dend, ps)
        IfCondition GreaterThan(col, dw) ThenBlock: { col = dw }
        IfCondition LessThan(col, 0) ThenBlock: { col = 0 }
        IBar.cur = Add(ps, col)
        IBar.follow = 1
    }
}

Function.InputBar.Down {
    Body: {
        s = InputBar.RowStart(IBar.cur)
        IfCondition GreaterEqual(s, IBar.len) ThenBlock: {
            IBar.cur = IBar.len
            IBar.follow = 1
            ReturnValue(0)
        }
        col = Subtract(IBar.cur, s)
        ns = InputBar.LineEnd(s)
        IfCondition LessEqual(ns, s) ThenBlock: { ns = Add(s, 1) }
        IfCondition GreaterEqual(ns, IBar.len) ThenBlock: {
            IfCondition And(GreaterThan(IBar.len, 0), EqualTo(GetByte(IBar.buf, Subtract(IBar.len, 1)), 10)) ThenBlock: {
                IBar.cur = IBar.len
            }
            ElseBlock: {
                IBar.cur = IBar.len
            }
            IBar.follow = 1
            ReturnValue(0)
        }
        ne = InputBar.LineEnd(ns)
        dend = ne
        IfCondition And(GreaterThan(dend, ns), EqualTo(GetByte(IBar.buf, Subtract(dend, 1)), 10)) ThenBlock: {
            dend = Subtract(dend, 1)
        }
        dw = Subtract(dend, ns)
        IfCondition GreaterThan(col, dw) ThenBlock: { col = dw }
        IfCondition LessThan(col, 0) ThenBlock: { col = 0 }
        IBar.cur = Add(ns, col)
        IBar.follow = 1
    }
}

Function.InputBar.ShowRows {
    Output: Integer
    Body: {
        n = Divide(Subtract(IBar.h, IBar.lh), IBar.lh)
        IfCondition LessThan(n, 1) ThenBlock: { n = 1 }
        IfCondition GreaterThan(n, IBar.maxr) ThenBlock: { n = IBar.maxr }
        ReturnValue(n)
    }
}

Function.InputBar.ClampScroll {
    Body: {
        show = InputBar.ShowRows()
        IfCondition GreaterThan(show, IBar.tot) ThenBlock: { show = IBar.tot }
        IfCondition LessThan(show, 1) ThenBlock: { show = 1 }
        maxs = Subtract(IBar.tot, show)
        IfCondition LessThan(maxs, 0) ThenBlock: { maxs = 0 }
        IfCondition LessThan(IBar.scroll, 0) ThenBlock: { IBar.scroll = 0 }
        IfCondition GreaterThan(IBar.scroll, maxs) ThenBlock: { IBar.scroll = maxs }
    }
}

Function.InputBar.NeedRows {
    Output: Integer
    Body: {
        InputBar.Measure()
        n = IBar.tot
        IfCondition GreaterThan(n, IBar.maxr) ThenBlock: { n = IBar.maxr }
        IfCondition LessThan(n, 1) ThenBlock: { n = 1 }
        ReturnValue(n)
    }
}

Function.InputBar.BoxH {
    Output: Integer
    Body: {
        ReturnValue(Add(IBar.lh, Multiply(InputBar.NeedRows(), IBar.lh)))
    }
}

Function.InputBar.Hit {
    Input: mx: Integer
    Input: my: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(mx, IBar.x) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(my, IBar.y) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterEqual(mx, Add(IBar.x, IBar.w)) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterEqual(my, Add(IBar.y, IBar.h)) ThenBlock: { ReturnValue(0) }
        ReturnValue(1)
    }
}

Function.InputBar.HitScroll {
    Input: mx: Integer
    Input: my: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(InputBar.Hit(mx, my), 0) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(mx, Subtract(Add(IBar.x, IBar.w), 10)) ThenBlock: { ReturnValue(0) }
        ReturnValue(1)
    }
}

Function.InputBar.IndexAt {
    Input: mx: Integer
    Input: my: Integer
    Output: Integer
    Body: {
        InputBar.Measure()
        tx = Add(IBar.x, Add(IBar.cw, 10))
        ty = Add(IBar.y, 2)
        row = Divide(Subtract(my, ty), IBar.lh)
        IfCondition LessThan(row, 0) ThenBlock: { row = 0 }
        row = Add(row, IBar.scroll)
        col = Divide(Subtract(mx, tx), IBar.cw)
        IfCondition LessThan(col, 0) ThenBlock: { col = 0 }
        IBar.i = 0
        r = 0
        WhileLoop LessThan(IBar.i, IBar.len) {
            nxt = InputBar.LineEnd(IBar.i)
            IfCondition LessEqual(nxt, IBar.i) ThenBlock: { nxt = Add(IBar.i, 1) }
            dend = nxt
            IfCondition And(GreaterThan(dend, IBar.i), EqualTo(GetByte(IBar.buf, Subtract(dend, 1)), 10)) ThenBlock: {
                dend = Subtract(dend, 1)
            }
            dw = Subtract(dend, IBar.i)
            IfCondition EqualTo(r, row) ThenBlock: {
                IfCondition GreaterThan(col, dw) ThenBlock: { col = dw }
                ReturnValue(Add(IBar.i, col))
            }
            r = Add(r, 1)
            IBar.i = nxt
        }
        ReturnValue(IBar.len)
    }
}

Function.InputBar.Click {
    Input: mx: Integer
    Input: my: Integer
    Body: {
        IBar.cur = InputBar.IndexAt(mx, my)
        IBar.sa = IBar.cur
        IBar.sb = IBar.cur
        IBar.follow = 1
    }
}

Function.InputBar.DragSel {
    Input: mx: Integer
    Input: my: Integer
    Body: {
        IBar.sb = InputBar.IndexAt(mx, my)
        IBar.cur = IBar.sb
        IBar.follow = 1
    }
}

Function.InputBar.SelectAll {
    Body: {
        IBar.sa = 0
        IBar.sb = IBar.len
        IBar.cur = IBar.len
        IBar.follow = 1
    }
}

Function.InputBar.ShiftLeft {
    Body: {
        IfCondition EqualTo(IBar.sa, IBar.sb) ThenBlock: { IBar.sa = IBar.cur }
        InputBar.Left()
        IBar.sb = IBar.cur
        IBar.follow = 1
    }
}

Function.InputBar.ShiftRight {
    Body: {
        IfCondition EqualTo(IBar.sa, IBar.sb) ThenBlock: { IBar.sa = IBar.cur }
        InputBar.Right()
        IBar.sb = IBar.cur
        IBar.follow = 1
    }
}

Function.InputBar.Collapse {
    Input: to_end: Integer
    Body: {
        IfCondition EqualTo(IBar.sa, IBar.sb) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(to_end, 1) ThenBlock: {
            IfCondition GreaterThan(IBar.sa, IBar.sb) ThenBlock: { IBar.cur = IBar.sa }
            ElseBlock: { IBar.cur = IBar.sb }
        }
        ElseBlock: {
            IfCondition LessThan(IBar.sa, IBar.sb) ThenBlock: { IBar.cur = IBar.sa }
            ElseBlock: { IBar.cur = IBar.sb }
        }
        IBar.sa = IBar.cur
        IBar.sb = IBar.cur
    }
}

Function.InputBar.SelLo {
    Output: Integer
    Body: {
        IfCondition LessThan(IBar.sa, IBar.sb) ThenBlock: { ReturnValue(IBar.sa) }
        ReturnValue(IBar.sb)
    }
}

Function.InputBar.SelHi {
    Output: Integer
    Body: {
        IfCondition GreaterThan(IBar.sa, IBar.sb) ThenBlock: { ReturnValue(IBar.sa) }
        ReturnValue(IBar.sb)
    }
}

Function.InputBar.Wheel {
    Input: n: Integer
    Body: {
        InputBar.Measure()
        IBar.follow = 0
        IBar.scroll = Add(IBar.scroll, n)
        InputBar.ClampScroll()
    }
}

Function.InputBar.Drag {
    Input: my: Integer
    Body: {
        InputBar.Measure()
        IBar.follow = 0
        sh = Subtract(IBar.h, 4)
        IfCondition LessThan(sh, 1) ThenBlock: { sh = 1 }
        rel = Subtract(my, Add(IBar.y, 2))
        IfCondition LessThan(rel, 0) ThenBlock: { rel = 0 }
        IfCondition GreaterThan(rel, sh) ThenBlock: { rel = sh }
        IBar.scroll = Divide(Multiply(rel, IBar.tot), sh)
        InputBar.ClampScroll()
    }
}

Function.InputBar.Draw {
    Body: {
        IfCondition LessThan(IBar.h, 24) ThenBlock: { IBar.h = 24 }
        InputBar.Measure()
        show = InputBar.ShowRows()
        IfCondition GreaterThan(show, IBar.tot) ThenBlock: { show = IBar.tot }
        IfCondition LessThan(show, 1) ThenBlock: { show = 1 }
        IfCondition EqualTo(IBar.follow, 1) ThenBlock: {
            IfCondition LessThan(IBar.cr, IBar.scroll) ThenBlock: { IBar.scroll = IBar.cr }
            IfCondition GreaterEqual(IBar.cr, Add(IBar.scroll, show)) ThenBlock: {
                IBar.scroll = Add(Subtract(IBar.cr, show), 1)
            }
        }
        InputBar.ClampScroll()
        IfCondition EqualTo(IBar.focus, 1) ThenBlock: {
            FB_FillRect(IBar.x, IBar.y, IBar.w, IBar.h, FB_RGB(40, 48, 28))
            FB_Rect(IBar.x, IBar.y, IBar.w, IBar.h, FB_RGB(0, 196, 198))
        }
        ElseBlock: {
            FB_FillRect(IBar.x, IBar.y, IBar.w, IBar.h, FB_RGB(28, 34, 44))
            FB_Rect(IBar.x, IBar.y, IBar.w, IBar.h, FB_RGB(80, 90, 110))
        }
        vis = InputBar.Cols()
        FB_SetClip(Add(IBar.x, 1), Add(IBar.y, 1), Subtract(IBar.w, 2), Subtract(IBar.h, 2))
        IfCondition And(EqualTo(IBar.eng, 1), NotEqual(IBar.surf, 0)) ThenBlock: {
            VFont_DrawString(IBar.surf, IBar.gt, 1, Add(IBar.x, 4), Add(IBar.y, 2), FB_RGB(0, 196, 198))
        }
        ElseBlock: {
            FB_DrawString(Add(IBar.x, 6), Add(IBar.y, 8), ">", FB_RGB(0, 196, 198), -1)
        }
        IBar.i = 0
        row = 0
        WhileLoop And(LessThan(row, IBar.scroll), LessThan(IBar.i, IBar.len)) {
            nxt = InputBar.LineEnd(IBar.i)
            IfCondition LessEqual(nxt, IBar.i) ThenBlock: { nxt = Add(IBar.i, 1) }
            IBar.i = nxt
            row = Add(row, 1)
        }
        row = 0
        WhileLoop And(LessThan(row, show), LessThan(IBar.i, IBar.len)) {
            nxt = InputBar.LineEnd(IBar.i)
            IfCondition LessEqual(nxt, IBar.i) ThenBlock: { nxt = Add(IBar.i, 1) }
            dend = nxt
            IfCondition And(GreaterThan(dend, IBar.i), EqualTo(GetByte(IBar.buf, Subtract(dend, 1)), 10)) ThenBlock: {
                dend = Subtract(dend, 1)
            }
            IfCondition NotEqual(IBar.sa, IBar.sb) ThenBlock: {
                lo = InputBar.SelLo()
                hi = InputBar.SelHi()
                IfCondition LessThan(lo, dend) ThenBlock: {
                    IfCondition GreaterThan(hi, IBar.i) ThenBlock: {
                        a = lo
                        IfCondition LessThan(a, IBar.i) ThenBlock: { a = IBar.i }
                        b = hi
                        IfCondition GreaterThan(b, dend) ThenBlock: { b = dend }
                        IfCondition GreaterThan(b, a) ThenBlock: {
                            c0 = Subtract(a, IBar.i)
                            c1 = Subtract(b, IBar.i)
                            px = Add(Add(IBar.x, Add(IBar.cw, 10)), Multiply(c0, IBar.cw))
                            py = Add(Add(IBar.y, 2), Multiply(row, IBar.lh))
                            FB_FillRect(px, py, Multiply(Subtract(c1, c0), IBar.cw), IBar.lh, FB_RGB(20, 78, 82))
                        }
                    }
                }
            }
            col = 0
            p = IBar.i
            WhileLoop And(LessThan(p, dend), LessThan(col, vis)) {
                IBar.c = GetByte(IBar.buf, p)
                IfCondition And(GreaterEqual(IBar.c, 32), LessThan(IBar.c, 127)) ThenBlock: {
                    px = Add(Add(IBar.x, Add(IBar.cw, 10)), Multiply(col, IBar.cw))
                    py = Add(Add(IBar.y, 2), Multiply(row, IBar.lh))
                    IfCondition And(EqualTo(IBar.eng, 1), NotEqual(IBar.surf, 0)) ThenBlock: {
                        VFont_DrawString(IBar.surf, Add(IBar.buf, p), 1, px, py, FB_RGB(232, 238, 248))
                    }
                    ElseBlock: {
                        FB_DrawChar(px, Add(py, 6), IBar.c, FB_RGB(232, 238, 248), -1)
                    }
                }
                col = Add(col, 1)
                p = Add(p, 1)
            }
            IBar.i = nxt
            row = Add(row, 1)
        }
        IfCondition EqualTo(IBar.focus, 1) ThenBlock: {
            crow = Subtract(IBar.cr, IBar.scroll)
            IfCondition And(GreaterEqual(crow, 0), LessThan(crow, show)) ThenBlock: {
                ccol = IBar.cc
                IfCondition GreaterThan(ccol, vis) ThenBlock: { ccol = vis }
                cx = Add(Add(IBar.x, Add(IBar.cw, 10)), Multiply(ccol, IBar.cw))
                cy = Add(Add(IBar.y, 2), Multiply(crow, IBar.lh))
                FB_FillRect(cx, cy, 2, IBar.lh, FB_RGB(0, 196, 198))
            }
        }
        sx = Subtract(Add(IBar.x, IBar.w), 10)
        sy = Add(IBar.y, 2)
        sh = Subtract(IBar.h, 4)
        IfCondition GreaterThan(sh, 8) ThenBlock: {
            FB_FillRect(sx, sy, IBar.sbw, sh, FB_RGB(16, 20, 28))
            tn = IBar.tot
            IfCondition LessThan(tn, show) ThenBlock: { tn = show }
            IfCondition LessThan(tn, 1) ThenBlock: { tn = 1 }
            th = Divide(Multiply(sh, show), tn)
            IfCondition LessThan(th, 10) ThenBlock: { th = 10 }
            IfCondition GreaterThan(th, sh) ThenBlock: { th = sh }
            ty = Divide(Multiply(sh, IBar.scroll), tn)
            IfCondition GreaterThan(Add(ty, th), sh) ThenBlock: { ty = Subtract(sh, th) }
            IfCondition LessThan(ty, 0) ThenBlock: { ty = 0 }
            FB_FillRect(sx, Add(sy, ty), IBar.sbw, th, FB_RGB(0, 196, 198))
        }
        FB_ClearClip()
    }
}
