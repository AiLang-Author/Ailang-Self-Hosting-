// Library.PicView.ailang
// Simple still-image viewer. Decode via ImgXlat, scale-to-window blit.
// Copyright © 2026 Sean Collins, 2 Paws Machine and Engineering. SCSL.

LibraryImport.Arena
LibraryImport.AppHost
LibraryImport.Display.System.EventRouter
LibraryImport.Display.Window.WinManager
LibraryImport.Display.UI.Auckland
LibraryImport.Display.Render.DDrawPixel
LibraryImport.Display.Render.DSurface
LibraryImport.Display.Content.ImgXlat
LibraryImport.Browser.ImageDecode
LibraryImport.Display.Theme.UITheme
LibraryImport.StringUtils
LibraryImport.Hash
LibraryImport.Arrays
LibraryImport.PostgreSQL_Complete
Import.OS.FileTree

FixedPool.PicView {
    "win":    Initialize=-1, CanChange=True
    "handle": Initialize=-1, CanChange=True
    "fid":    Initialize=-1, CanChange=True
}

Function.PicView_ActionCb {
    Input: action_ptr: Address
    Input: action_len: Integer
    Output: Integer
    Body: {
        EventRouter_Push(action_ptr, action_len, 0)
        ReturnValue(1)
    }
}

Function.PicView_Paint {
    Body: {
        IfCondition Or(LessThan(PicView.win, 0), LessThan(PicView.handle, 0)) ThenBlock: {
            ReturnValue(0)
        }
        surf = WinMgr_GetContent(PicView.win)
        IfCondition EqualTo(surf, 0) ThenBlock: {
            ReturnValue(0)
        }
        cw = Win_GetCanvasW(PicView.win)
        ch = Win_GetCanvasH(PicView.win)
        IfCondition Or(LessEqual(cw, 1), LessEqual(ch, 1)) ThenBlock: {
            ReturnValue(0)
        }
        Draw_Pix_FillRect(surf, 0, 0, cw, ch, 0xFF060912)
        ImgBlit.sw = IMG_GetWidth(PicView.handle)
        ImgBlit.sh = IMG_GetHeight(PicView.handle)
        IfCondition Or(LessEqual(ImgBlit.sw, 0), LessEqual(ImgBlit.sh, 0)) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition GreaterThan(Multiply(ImgBlit.sw, ch), Multiply(ImgBlit.sh, cw)) ThenBlock: {
            ImgBlit.dw = cw
            ImgBlit.dh = Divide(Multiply(ImgBlit.sh, cw), ImgBlit.sw)
        }
        ElseBlock: {
            ImgBlit.dh = ch
            ImgBlit.dw = Divide(Multiply(ImgBlit.sw, ch), ImgBlit.sh)
        }
        IfCondition LessThan(ImgBlit.dw, 1) ThenBlock: {
            ImgBlit.dw = 1
        }
        IfCondition LessThan(ImgBlit.dh, 1) ThenBlock: {
            ImgBlit.dh = 1
        }
        ImgBlit.surf = surf
        ImgBlit.dx = Divide(Subtract(cw, ImgBlit.dw), 2)
        ImgBlit.dy = Divide(Subtract(ch, ImgBlit.dh), 2)
        ImgBlit.cx0 = 0
        ImgBlit.cy0 = 0
        ImgBlit.cx1 = cw
        ImgBlit.cy1 = ch
        ImgXlat_Blit(PicView.handle)
        SysDisplayState.dirty = 1
    }
}

Function.PicView_Open {
    Input: fid: Integer
    Output: Integer
    Body: {
        conn = SysDisplay_GetDBConn()
        IfCondition EqualTo(conn, 0) ThenBlock: {
            ReturnValue(-1)
        }
        buf = Allocate(2097152)
        n = FileTree_ReadFile(conn, fid, buf, 2097152)
        IfCondition LessThan(n, 8) ThenBlock: {
            PrintMessage("[PicView] read fail\n")
            ReturnValue(-1)
        }
        PicView.handle = ImgXlat_Translate(buf, n)
        IfCondition LessThan(PicView.handle, 0) ThenBlock: {
            PrintMessage("[PicView] decode fail\n")
            ReturnValue(-1)
        }
        PicView.fid = fid
        IfCondition LessThan(PicView.win, 0) ThenBlock: {
            PicView.win = AppHost_Open("config/picview.html", AddressOf(PicView_ActionCb))
        }
        IfCondition LessThan(PicView.win, 0) ThenBlock: {
            PrintMessage("[PicView] window fail\n")
            ReturnValue(-1)
        }
        info = FileTree_GetInfo(conn, fid)
        IfCondition NotEqual(info, 0) ThenBlock: {
            irow = Array.Get(info, 0)
            nm = Hash.Get(irow, "name")
            IfCondition NotEqual(nm, 0) ThenBlock: {
                WinMgr_SetTitle(PicView.win, nm)
            }
            PG_DestroyResult(info)
        }
        PicView_Paint()
        PrintMessage("[PicView] opened fid=")
        PrintNumber(fid)
        PrintMessage(" win=")
        PrintNumber(PicView.win)
        PrintMessage("\n")
        ReturnValue(PicView.win)
    }
}
