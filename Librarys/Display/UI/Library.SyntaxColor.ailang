// Library.SyntaxColor.ailang — Lightweight per-line syntax colorizer
// Character-scanner approach: classifies spans within a single line.
// Does NOT import the full Lexer — designed for per-frame display rendering.
// Copyright (c) 2026 Sean Collins, 2 Paws Machine and Engineering. SCSL.

LibraryImport.StringUtils

// =============================================================================
// SYNTAX MODE CONSTANTS
// =============================================================================
FixedPool.SynMode {
    "NONE":    Initialize=0
    "AILANG":  Initialize=1
}

// =============================================================================
// COLOR PALETTE (BGRA 0xAARRGGBB)
// =============================================================================
FixedPool.SynColor {
    "DEFAULT":   Initialize=0xFFD4D4D4
    "KEYWORD":   Initialize=0xFFFF79C6
    "BUILTIN":   Initialize=0xFF8BE9FD
    "STRING":    Initialize=0xFFF1FA8C
    "NUMBER":    Initialize=0xFFBD93F9
    "COMMENT":   Initialize=0xFF6272A4
    "TYPE":      Initialize=0xFF50FA7B
    "PUNCT":     Initialize=0xFFF8F8F2
    "PROPERTY":  Initialize=0xFFFFB86C
}

// =============================================================================
// SPAN BUFFER — 64 spans × 16 bytes each = 1024 bytes
// Each span: [start_col:8][end_col:8][color:8][pad:8]
// Using 8-byte fields for natural alignment on 64-bit
// =============================================================================
FixedPool.SynConst {
    "MAX_SPANS":   Initialize=64
    "SPAN_SIZE":   Initialize=32
    "BUF_SIZE":    Initialize=2048
}

FixedPool.SynState {
    "span_buf":    Initialize=0, CanChange=True
    "span_count":  Initialize=0, CanChange=True
    "initialized": Initialize=0, CanChange=True
}

// =============================================================================
// INIT — allocate span buffer (called once at startup)
// =============================================================================
Function.SynColor_Init {
    Body: {
        IfCondition EqualTo(SynState.initialized, 1) ThenBlock: { ReturnValue(0) }
        SynState.span_buf = Allocate(SynConst.BUF_SIZE)
        SynState.initialized = 1
        PrintMessage("[SynColor] init\n")
    }
}

// =============================================================================
// INTERNAL: push a span into the buffer
// =============================================================================
Function.SynColor_PushSpan {
    Input: start: Integer
    Input: end: Integer
    Input: color: Integer
    Body: {
        sc = SynState.span_count
        IfCondition GreaterEqual(sc, SynConst.MAX_SPANS) ThenBlock: { ReturnValue(0) }
        off = Multiply(sc, SynConst.SPAN_SIZE)
        base = Add(SynState.span_buf, off)
        StoreValue(base, start)
        StoreValue(Add(base, 8), end)
        StoreValue(Add(base, 16), color)
        StoreValue(Add(base, 24), 0)
        SynState.span_count = Add(sc, 1)
    }
}

// =============================================================================
// GET SPAN — return pointer to span entry by index
// =============================================================================
Function.SynColor_GetSpan {
    Input: index: Integer
    Output: Integer
    Body: {
        ReturnValue(Add(SynState.span_buf, Multiply(index, SynConst.SPAN_SIZE)))
    }
}

// =============================================================================
// INTERNAL: classify an identifier word for AILang
// Returns the color for the word.
// Uses first-character + length dispatch (fast, no hash table).
// =============================================================================
Function.SynColor_ClassifyWord {
    Input: line: Address
    Input: start: Integer
    Input: wlen: Integer
    Output: Integer
    Body: {
        // Get pointer to word start
        wptr = Add(line, start)
        fc = GetByte(wptr, 0)

        // --- KEYWORDS (pink) ---
        // F: Function (8), FixedPool (9), ForEvery (8), False (5)
        IfCondition EqualTo(fc, 70) ThenBlock: {
            IfCondition And(EqualTo(wlen, 8), EqualTo(GetByte(wptr, 1), 117)) ThenBlock: {
                // Fu -> Function
                IfCondition And(EqualTo(GetByte(wptr, 2), 110), EqualTo(GetByte(wptr, 3), 99)) ThenBlock: {
                    ReturnValue(SynColor.KEYWORD)
                }
            }
            IfCondition And(EqualTo(wlen, 9), EqualTo(GetByte(wptr, 1), 105)) ThenBlock: {
                // Fi -> FixedPool
                IfCondition EqualTo(GetByte(wptr, 5), 80) ThenBlock: {
                    ReturnValue(SynColor.KEYWORD)
                }
            }
            IfCondition And(EqualTo(wlen, 8), EqualTo(GetByte(wptr, 1), 111)) ThenBlock: {
                // Fo -> ForEvery
                ReturnValue(SynColor.KEYWORD)
            }
            IfCondition And(EqualTo(wlen, 5), EqualTo(GetByte(wptr, 1), 97)) ThenBlock: {
                // Fa -> False
                ReturnValue(SynColor.KEYWORD)
            }
        }

        // I: IfCondition (11), Initialize (10), Input (5)
        IfCondition EqualTo(fc, 73) ThenBlock: {
            IfCondition And(EqualTo(wlen, 11), EqualTo(GetByte(wptr, 1), 102)) ThenBlock: {
                // If -> IfCondition
                ReturnValue(SynColor.KEYWORD)
            }
            IfCondition And(EqualTo(wlen, 10), EqualTo(GetByte(wptr, 1), 110)) ThenBlock: {
                // In -> Initialize
                IfCondition EqualTo(GetByte(wptr, 2), 105) ThenBlock: {
                    ReturnValue(SynColor.KEYWORD)
                }
            }
            IfCondition And(EqualTo(wlen, 5), EqualTo(GetByte(wptr, 1), 110)) ThenBlock: {
                // In -> Input
                IfCondition EqualTo(GetByte(wptr, 2), 112) ThenBlock: {
                    ReturnValue(SynColor.KEYWORD)
                }
            }
        }

        // T: ThenBlock (9), TryBlock (8), True (4)
        IfCondition EqualTo(fc, 84) ThenBlock: {
            IfCondition And(EqualTo(wlen, 9), EqualTo(GetByte(wptr, 1), 104)) ThenBlock: {
                // Th -> ThenBlock
                ReturnValue(SynColor.KEYWORD)
            }
            IfCondition And(EqualTo(wlen, 8), EqualTo(GetByte(wptr, 1), 114)) ThenBlock: {
                // Tr -> TryBlock
                IfCondition EqualTo(GetByte(wptr, 2), 121) ThenBlock: {
                    ReturnValue(SynColor.KEYWORD)
                }
            }
            IfCondition And(EqualTo(wlen, 4), EqualTo(GetByte(wptr, 1), 114)) ThenBlock: {
                // Tr -> True
                IfCondition EqualTo(GetByte(wptr, 2), 117) ThenBlock: {
                    ReturnValue(SynColor.KEYWORD)
                }
            }
        }

        // E: ElseBlock (9)
        IfCondition EqualTo(fc, 69) ThenBlock: {
            IfCondition And(EqualTo(wlen, 9), EqualTo(GetByte(wptr, 1), 108)) ThenBlock: {
                // El -> ElseBlock
                ReturnValue(SynColor.KEYWORD)
            }
        }

        // W: WhileLoop (9)
        IfCondition EqualTo(fc, 87) ThenBlock: {
            IfCondition And(EqualTo(wlen, 9), EqualTo(GetByte(wptr, 1), 104)) ThenBlock: {
                // Wh -> WhileLoop
                ReturnValue(SynColor.KEYWORD)
            }
        }

        // R: ReturnValue (11)
        IfCondition EqualTo(fc, 82) ThenBlock: {
            IfCondition And(EqualTo(wlen, 11), EqualTo(GetByte(wptr, 1), 101)) ThenBlock: {
                // Re -> ReturnValue
                ReturnValue(SynColor.KEYWORD)
            }
        }

        // B: Body (4), BreakLoop (9)
        IfCondition EqualTo(fc, 66) ThenBlock: {
            IfCondition And(EqualTo(wlen, 4), EqualTo(GetByte(wptr, 1), 111)) ThenBlock: {
                // Bo -> Body
                ReturnValue(SynColor.KEYWORD)
            }
            IfCondition And(EqualTo(wlen, 9), EqualTo(GetByte(wptr, 1), 114)) ThenBlock: {
                // Br -> BreakLoop
                ReturnValue(SynColor.KEYWORD)
            }
        }

        // O: Output (6)
        IfCondition EqualTo(fc, 79) ThenBlock: {
            IfCondition And(EqualTo(wlen, 6), EqualTo(GetByte(wptr, 1), 117)) ThenBlock: {
                // Ou -> Output
                ReturnValue(SynColor.KEYWORD)
            }
        }

        // L: LibraryImport (13)
        IfCondition EqualTo(fc, 76) ThenBlock: {
            IfCondition And(EqualTo(wlen, 13), EqualTo(GetByte(wptr, 1), 105)) ThenBlock: {
                // Li -> LibraryImport
                ReturnValue(SynColor.KEYWORD)
            }
        }

        // C: CanChange (9), CatchError (10), ContinueLoop (12)
        IfCondition EqualTo(fc, 67) ThenBlock: {
            IfCondition And(EqualTo(wlen, 9), EqualTo(GetByte(wptr, 1), 97)) ThenBlock: {
                // Ca -> CanChange
                IfCondition EqualTo(GetByte(wptr, 2), 110) ThenBlock: {
                    ReturnValue(SynColor.KEYWORD)
                }
            }
            IfCondition And(EqualTo(wlen, 10), EqualTo(GetByte(wptr, 1), 97)) ThenBlock: {
                // Ca -> CatchError
                IfCondition EqualTo(GetByte(wptr, 2), 116) ThenBlock: {
                    ReturnValue(SynColor.KEYWORD)
                }
            }
            IfCondition And(EqualTo(wlen, 12), EqualTo(GetByte(wptr, 1), 111)) ThenBlock: {
                // Co -> ContinueLoop
                ReturnValue(SynColor.KEYWORD)
            }
        }

        // N: Null (4)
        IfCondition EqualTo(fc, 78) ThenBlock: {
            IfCondition And(EqualTo(wlen, 4), EqualTo(GetByte(wptr, 1), 117)) ThenBlock: {
                // Nu -> Null
                ReturnValue(SynColor.KEYWORD)
            }
        }

        // S: SubRoutine (10)
        IfCondition EqualTo(fc, 83) ThenBlock: {
            IfCondition And(EqualTo(wlen, 10), EqualTo(GetByte(wptr, 1), 117)) ThenBlock: {
                // Su -> SubRoutine
                ReturnValue(SynColor.KEYWORD)
            }
            // S: StringLength (12), SystemCall (10), SetByte (7), StoreValue (10)
            IfCondition And(EqualTo(wlen, 12), EqualTo(GetByte(wptr, 1), 116)) ThenBlock: {
                // St -> StringLength
                IfCondition EqualTo(GetByte(wptr, 6), 76) ThenBlock: {
                    ReturnValue(SynColor.BUILTIN)
                }
            }
            IfCondition And(EqualTo(wlen, 10), EqualTo(GetByte(wptr, 1), 121)) ThenBlock: {
                // Sy -> SystemCall
                ReturnValue(SynColor.BUILTIN)
            }
            IfCondition And(EqualTo(wlen, 7), EqualTo(GetByte(wptr, 1), 101)) ThenBlock: {
                // Se -> SetByte
                ReturnValue(SynColor.BUILTIN)
            }
            IfCondition And(EqualTo(wlen, 10), EqualTo(GetByte(wptr, 1), 116)) ThenBlock: {
                // St -> StoreValue
                IfCondition EqualTo(GetByte(wptr, 5), 86) ThenBlock: {
                    ReturnValue(SynColor.BUILTIN)
                }
            }
        }

        // --- BUILTINS (cyan) ---
        // A: Add (3), And (3), Allocate (8)
        IfCondition EqualTo(fc, 65) ThenBlock: {
            IfCondition And(EqualTo(wlen, 3), EqualTo(GetByte(wptr, 1), 100)) ThenBlock: {
                // Ad -> Add
                ReturnValue(SynColor.BUILTIN)
            }
            IfCondition And(EqualTo(wlen, 3), EqualTo(GetByte(wptr, 1), 110)) ThenBlock: {
                // An -> And
                ReturnValue(SynColor.BUILTIN)
            }
            IfCondition And(EqualTo(wlen, 8), EqualTo(GetByte(wptr, 1), 108)) ThenBlock: {
                // Al -> Allocate
                ReturnValue(SynColor.BUILTIN)
            }
            // Address (7) - TYPE
            IfCondition And(EqualTo(wlen, 7), EqualTo(GetByte(wptr, 1), 100)) ThenBlock: {
                // Ad -> Address
                IfCondition EqualTo(GetByte(wptr, 2), 100) ThenBlock: {
                    ReturnValue(SynColor.TYPE)
                }
            }
        }

        // M: Multiply (8), MemoryCopy (10), MemorySet (9)
        IfCondition EqualTo(fc, 77) ThenBlock: {
            IfCondition And(EqualTo(wlen, 8), EqualTo(GetByte(wptr, 1), 117)) ThenBlock: {
                // Mu -> Multiply
                ReturnValue(SynColor.BUILTIN)
            }
            IfCondition And(EqualTo(wlen, 10), EqualTo(GetByte(wptr, 1), 101)) ThenBlock: {
                // Me -> MemoryCopy
                ReturnValue(SynColor.BUILTIN)
            }
            IfCondition And(EqualTo(wlen, 9), EqualTo(GetByte(wptr, 1), 101)) ThenBlock: {
                // Me -> MemorySet
                ReturnValue(SynColor.BUILTIN)
            }
        }

        // D: Divide (6), Dereference (11), Deallocate (10)
        IfCondition EqualTo(fc, 68) ThenBlock: {
            IfCondition And(EqualTo(wlen, 6), EqualTo(GetByte(wptr, 1), 105)) ThenBlock: {
                // Di -> Divide
                ReturnValue(SynColor.BUILTIN)
            }
            IfCondition And(EqualTo(wlen, 11), EqualTo(GetByte(wptr, 1), 101)) ThenBlock: {
                // De -> Dereference
                IfCondition EqualTo(GetByte(wptr, 2), 114) ThenBlock: {
                    ReturnValue(SynColor.BUILTIN)
                }
            }
            IfCondition And(EqualTo(wlen, 10), EqualTo(GetByte(wptr, 1), 101)) ThenBlock: {
                // De -> Deallocate
                IfCondition EqualTo(GetByte(wptr, 2), 97) ThenBlock: {
                    ReturnValue(SynColor.BUILTIN)
                }
            }
            IfCondition And(EqualTo(wlen, 12), EqualTo(GetByte(wptr, 1), 101)) ThenBlock: {
                // De -> DebugLog_Push
                IfCondition EqualTo(GetByte(wptr, 2), 98) ThenBlock: {
                    ReturnValue(SynColor.BUILTIN)
                }
            }
        }

        // E: EqualTo (7)
        IfCondition EqualTo(fc, 69) ThenBlock: {
            IfCondition And(EqualTo(wlen, 7), EqualTo(GetByte(wptr, 1), 113)) ThenBlock: {
                // Eq -> EqualTo
                ReturnValue(SynColor.BUILTIN)
            }
        }

        // N: NotEqual (8), Not (3)
        IfCondition EqualTo(fc, 78) ThenBlock: {
            IfCondition And(EqualTo(wlen, 8), EqualTo(GetByte(wptr, 1), 111)) ThenBlock: {
                // No -> NotEqual
                IfCondition EqualTo(GetByte(wptr, 3), 69) ThenBlock: {
                    ReturnValue(SynColor.BUILTIN)
                }
            }
            IfCondition And(EqualTo(wlen, 3), EqualTo(GetByte(wptr, 1), 111)) ThenBlock: {
                // No -> Not
                ReturnValue(SynColor.BUILTIN)
            }
        }

        // G: GreaterThan (11), GreaterEqual (12), GetByte (7)
        IfCondition EqualTo(fc, 71) ThenBlock: {
            IfCondition And(EqualTo(wlen, 11), EqualTo(GetByte(wptr, 1), 114)) ThenBlock: {
                // Gr -> GreaterThan
                ReturnValue(SynColor.BUILTIN)
            }
            IfCondition And(EqualTo(wlen, 12), EqualTo(GetByte(wptr, 1), 114)) ThenBlock: {
                // Gr -> GreaterEqual
                ReturnValue(SynColor.BUILTIN)
            }
            IfCondition And(EqualTo(wlen, 7), EqualTo(GetByte(wptr, 1), 101)) ThenBlock: {
                // Ge -> GetByte
                ReturnValue(SynColor.BUILTIN)
            }
        }

        // L: LessThan (8), LessEqual (9)
        IfCondition EqualTo(fc, 76) ThenBlock: {
            IfCondition And(EqualTo(wlen, 8), EqualTo(GetByte(wptr, 1), 101)) ThenBlock: {
                // Le -> LessThan
                ReturnValue(SynColor.BUILTIN)
            }
            IfCondition And(EqualTo(wlen, 9), EqualTo(GetByte(wptr, 1), 101)) ThenBlock: {
                // Le -> LessEqual
                ReturnValue(SynColor.BUILTIN)
            }
        }

        // O: Or (2)
        IfCondition EqualTo(fc, 79) ThenBlock: {
            IfCondition And(EqualTo(wlen, 2), EqualTo(GetByte(wptr, 1), 114)) ThenBlock: {
                // Or
                ReturnValue(SynColor.BUILTIN)
            }
        }

        // P: PrintMessage (12), PrintNumber (11)
        IfCondition EqualTo(fc, 80) ThenBlock: {
            IfCondition And(EqualTo(wlen, 12), EqualTo(GetByte(wptr, 1), 114)) ThenBlock: {
                // Pr -> PrintMessage
                IfCondition EqualTo(GetByte(wptr, 5), 77) ThenBlock: {
                    ReturnValue(SynColor.BUILTIN)
                }
            }
            IfCondition And(EqualTo(wlen, 11), EqualTo(GetByte(wptr, 1), 114)) ThenBlock: {
                // Pr -> PrintNumber
                ReturnValue(SynColor.BUILTIN)
            }
            // Pointer (7) - TYPE
            IfCondition And(EqualTo(wlen, 7), EqualTo(GetByte(wptr, 1), 111)) ThenBlock: {
                // Po -> Pointer
                ReturnValue(SynColor.TYPE)
            }
        }

        // --- TYPES (green) ---
        // I: Integer (7)
        IfCondition EqualTo(fc, 73) ThenBlock: {
            IfCondition And(EqualTo(wlen, 7), EqualTo(GetByte(wptr, 1), 110)) ThenBlock: {
                // In -> Integer
                IfCondition EqualTo(GetByte(wptr, 2), 116) ThenBlock: {
                    ReturnValue(SynColor.TYPE)
                }
            }
        }

        // B: Boolean (7), Byte (4)
        IfCondition EqualTo(fc, 66) ThenBlock: {
            IfCondition And(EqualTo(wlen, 7), EqualTo(GetByte(wptr, 1), 111)) ThenBlock: {
                // Bo -> Boolean
                IfCondition EqualTo(GetByte(wptr, 2), 111) ThenBlock: {
                    ReturnValue(SynColor.TYPE)
                }
            }
            IfCondition And(EqualTo(wlen, 4), EqualTo(GetByte(wptr, 1), 121)) ThenBlock: {
                // By -> Byte
                ReturnValue(SynColor.TYPE)
            }
        }

        // T: Text (4)
        IfCondition EqualTo(fc, 84) ThenBlock: {
            IfCondition And(EqualTo(wlen, 4), EqualTo(GetByte(wptr, 1), 101)) ThenBlock: {
                // Te -> Text
                IfCondition EqualTo(GetByte(wptr, 2), 120) ThenBlock: {
                    ReturnValue(SynColor.TYPE)
                }
            }
        }

        // R: RunTask (7)
        IfCondition EqualTo(fc, 82) ThenBlock: {
            IfCondition And(EqualTo(wlen, 7), EqualTo(GetByte(wptr, 1), 117)) ThenBlock: {
                // Ru -> RunTask
                ReturnValue(SynColor.KEYWORD)
            }
        }

        // Default — not a known keyword/builtin/type
        ReturnValue(SynColor.DEFAULT)
    }
}

// =============================================================================
// SYNCOLOR_LINE — colorize a single line, fill span buffer
// Returns span count.
// =============================================================================
Function.SynColor_Line {
    Input: mode: Integer
    Input: line: Address
    Input: len: Integer
    Output: Integer
    Body: {
        SynState.span_count = 0

        IfCondition EqualTo(mode, SynMode.NONE) ThenBlock: {
            // No syntax — single default span for entire line
            IfCondition GreaterThan(len, 0) ThenBlock: {
                SynColor_PushSpan(0, len, SynColor.DEFAULT)
            }
            ReturnValue(SynState.span_count)
        }

        // AILang mode
        i = 0
        after_dot = 0

        WhileLoop LessThan(i, len) {
            ch = GetByte(line, i)

            // --- Comment: // to end of line ---
            IfCondition And(EqualTo(ch, 47), LessThan(Add(i, 1), len)) ThenBlock: {
                ch2 = GetByte(line, Add(i, 1))
                IfCondition EqualTo(ch2, 47) ThenBlock: {
                    SynColor_PushSpan(i, len, SynColor.COMMENT)
                    ReturnValue(SynState.span_count)
                }
            }

            // --- String: "..." ---
            IfCondition EqualTo(ch, 34) ThenBlock: {
                str_start = i
                i = Add(i, 1)
                // Scan to closing quote
                WhileLoop LessThan(i, len) {
                    sc = GetByte(line, i)
                    IfCondition EqualTo(sc, 92) ThenBlock: {
                        // Backslash escape — skip next char
                        i = Add(i, 2)
                    } ElseBlock: {
                        IfCondition EqualTo(sc, 34) ThenBlock: {
                            i = Add(i, 1)
                            BreakLoop
                        }
                        i = Add(i, 1)
                    }
                }
                SynColor_PushSpan(str_start, i, SynColor.STRING)
                after_dot = 0
                ContinueLoop
            }

            // --- Number: digit or negative number ---
            is_digit = And(GreaterEqual(ch, 48), LessEqual(ch, 57))
            is_neg = 0
            IfCondition EqualTo(ch, 45) ThenBlock: {
                // Minus — check if next char is digit
                IfCondition LessThan(Add(i, 1), len) ThenBlock: {
                    nch = GetByte(line, Add(i, 1))
                    IfCondition And(GreaterEqual(nch, 48), LessEqual(nch, 57)) ThenBlock: {
                        is_neg = 1
                    }
                }
            }
            IfCondition Or(EqualTo(is_digit, 1), EqualTo(is_neg, 1)) ThenBlock: {
                num_start = i
                IfCondition EqualTo(is_neg, 1) ThenBlock: { i = Add(i, 1) }
                WhileLoop LessThan(i, len) {
                    nc = GetByte(line, i)
                    IfCondition And(GreaterEqual(nc, 48), LessEqual(nc, 57)) ThenBlock: {
                        i = Add(i, 1)
                    } ElseBlock: {
                        BreakLoop
                    }
                }
                // Check it's not part of an identifier (e.g. x86)
                IfCondition GreaterThan(i, num_start) ThenBlock: {
                    SynColor_PushSpan(num_start, i, SynColor.NUMBER)
                    after_dot = 0
                    ContinueLoop
                }
            }

            // --- Identifier: [A-Za-z_] ---
            is_alpha = 0
            IfCondition And(GreaterEqual(ch, 65), LessEqual(ch, 90)) ThenBlock: { is_alpha = 1 }
            IfCondition And(GreaterEqual(ch, 97), LessEqual(ch, 122)) ThenBlock: { is_alpha = 1 }
            IfCondition EqualTo(ch, 95) ThenBlock: { is_alpha = 1 }

            IfCondition EqualTo(is_alpha, 1) ThenBlock: {
                word_start = i
                WhileLoop LessThan(i, len) {
                    wc = GetByte(line, i)
                    is_wc = 0
                    IfCondition And(GreaterEqual(wc, 65), LessEqual(wc, 90)) ThenBlock: { is_wc = 1 }
                    IfCondition And(GreaterEqual(wc, 97), LessEqual(wc, 122)) ThenBlock: { is_wc = 1 }
                    IfCondition And(GreaterEqual(wc, 48), LessEqual(wc, 57)) ThenBlock: { is_wc = 1 }
                    IfCondition EqualTo(wc, 95) ThenBlock: { is_wc = 1 }
                    IfCondition EqualTo(is_wc, 0) ThenBlock: { BreakLoop }
                    i = Add(i, 1)
                }
                wlen = Subtract(i, word_start)

                // After a dot, color as property
                IfCondition EqualTo(after_dot, 1) ThenBlock: {
                    SynColor_PushSpan(word_start, i, SynColor.PROPERTY)
                    after_dot = 0
                } ElseBlock: {
                    // Classify the word
                    wcolor = SynColor_ClassifyWord(line, word_start, wlen)
                    SynColor_PushSpan(word_start, i, wcolor)
                }
                ContinueLoop
            }

            // --- Dot: mark next identifier as property ---
            IfCondition EqualTo(ch, 46) ThenBlock: {
                SynColor_PushSpan(i, Add(i, 1), SynColor.PUNCT)
                after_dot = 1
                i = Add(i, 1)
                ContinueLoop
            }

            // --- Punctuation: { } ( ) : , = @ ---
            is_punct = 0
            IfCondition EqualTo(ch, 123) ThenBlock: { is_punct = 1 }
            IfCondition EqualTo(ch, 125) ThenBlock: { is_punct = 1 }
            IfCondition EqualTo(ch, 40) ThenBlock: { is_punct = 1 }
            IfCondition EqualTo(ch, 41) ThenBlock: { is_punct = 1 }
            IfCondition EqualTo(ch, 58) ThenBlock: { is_punct = 1 }
            IfCondition EqualTo(ch, 44) ThenBlock: { is_punct = 1 }
            IfCondition EqualTo(ch, 61) ThenBlock: { is_punct = 1 }
            IfCondition EqualTo(ch, 64) ThenBlock: { is_punct = 1 }

            IfCondition EqualTo(is_punct, 1) ThenBlock: {
                SynColor_PushSpan(i, Add(i, 1), SynColor.PUNCT)
                after_dot = 0
                i = Add(i, 1)
                ContinueLoop
            }

            // --- Whitespace and other: emit DEFAULT span ---
            ws_start = i
            WhileLoop LessThan(i, len) {
                wsc = GetByte(line, i)
                is_ws = 0
                IfCondition EqualTo(wsc, 32) ThenBlock: { is_ws = 1 }
                IfCondition EqualTo(wsc, 9) ThenBlock: { is_ws = 1 }
                IfCondition EqualTo(is_ws, 0) ThenBlock: { BreakLoop }
                i = Add(i, 1)
            }
            // If we consumed whitespace, emit a span; otherwise skip one unknown char
            IfCondition GreaterThan(i, ws_start) ThenBlock: {
                SynColor_PushSpan(ws_start, i, SynColor.DEFAULT)
            } ElseBlock: {
                // Unknown non-whitespace character — emit as single DEFAULT span
                SynColor_PushSpan(i, Add(i, 1), SynColor.DEFAULT)
                i = Add(i, 1)
            }
            after_dot = 0
        }

        ReturnValue(SynState.span_count)
    }
}
