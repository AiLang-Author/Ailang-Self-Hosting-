// Library.TextRegion.ailang
// Region-bounded vector text rendering. Replaces TextBuffer.
// Does NOT own its target surface — draws into a rect on any canvas.
// Auckland assigns the rect. TextRegion renders text into it.
// All expressions flattened for 6-register ABI.
// Copyright © 2026 Sean Collins, 2 Paws Machine and Engineering. SCSL.

LibraryImport.Display.Render.DSurfaceTypes
LibraryImport.Display.Render.DSurface
LibraryImport.Display.Render.DDrawPixel
LibraryImport.Arena
LibraryImport.Display.Render.VIF
LibraryImport.Display.Render.SurfaceBlit
LibraryImport.Display.Render.Fonts

// =============================================================================
// CONSTANTS
// =============================================================================
FixedPool.TRConst {
    "MAX_REGIONS":  Initialize=256
    "ENTRY_SIZE":   Initialize=168
    "SURF_OFS":     Initialize=0
    "X_OFS":        Initialize=8
    "Y_OFS":        Initialize=16
    "W_OFS":        Initialize=24
    "H_OFS":        Initialize=32
    "COLOR_OFS":    Initialize=40
    "ALIGN_OFS":    Initialize=48
    "WRAP_OFS":     Initialize=56
    "SPACING_OFS":  Initialize=64
    "CURSOR_X_OFS": Initialize=72
    "CURSOR_Y_OFS": Initialize=80
    "DIRTY_OFS":    Initialize=88
    "BG_OFS":       Initialize=96
    "HAS_BG_OFS":   Initialize=104
    "FONT_SIZE_OFS": Initialize=112
    "VALIGN_OFS":    Initialize=120
    "CLIP_X_OFS":    Initialize=128
    "CLIP_Y_OFS":    Initialize=136
    "CLIP_W_OFS":    Initialize=144
    "CLIP_H_OFS":    Initialize=152
    "HAS_CLIP_OFS":  Initialize=160
}

FixedPool.TRAlign {
    "LEFT":   Initialize=0
    "CENTER": Initialize=1
    "RIGHT":  Initialize=2
}

FixedPool.TRVAlign {
    "TOP":    Initialize=0
    "MIDDLE": Initialize=1
    "BOTTOM": Initialize=2
}

FixedPool.TRState {
    "data":       Initialize=0
    "count":      Initialize=0
    "free_stack": Initialize=0
    "free_top":   Initialize=0
}

// =============================================================================
// INIT
// =============================================================================
Function.TextRegion_Init {
    Output: Integer
    Body: {
        sz = Multiply(TRConst.MAX_REGIONS, TRConst.ENTRY_SIZE)
        buf = Allocate(sz)
        IfCondition EqualTo(buf, 0) ThenBlock: {
            PrintMessage("[TR] alloc fail\n")
            ReturnValue(0)
        }
        MemorySet(buf, 0, sz)
        TRState.data = buf
        TRState.count = 0
        // Free stack: array of 256 ints (8 bytes each) for recycled handles
        fsz = Multiply(TRConst.MAX_REGIONS, 8)
        fs = Allocate(fsz)
        IfCondition EqualTo(fs, 0) ThenBlock: {
            PrintMessage("[TR] free stack alloc fail\n")
            ReturnValue(0)
        }
        TRState.free_stack = fs
        TRState.free_top = 0
        PrintMessage("[TR] init ok\n")
        ReturnValue(1)
    }
}

// =============================================================================
// POINTER HELPER
// =============================================================================
Function.TR_Ptr {
    Input:  handle: Integer
    Output: Integer
    Body: {
        off = Multiply(handle, TRConst.ENTRY_SIZE)
        ReturnValue(Add(TRState.data, off))
    }
}

// =============================================================================
// CREATE — allocate a region, returns handle
// Does NOT own dst_surf. Caller (Auckland/window) owns the canvas.
// =============================================================================
Function.TextRegion_Create {
    Input: dst_surf: Integer
    Input: x: Integer
    Input: y: Integer
    Input: w: Integer
    Input: h: Integer
    Output: Integer
    Body: {
        // Reuse a freed slot if available
        idx = -1
        IfCondition GreaterThan(TRState.free_top, 0) ThenBlock: {
            TRState.free_top = Subtract(TRState.free_top, 1)
            foff = Multiply(TRState.free_top, 8)
            idx = Dereference(Add(TRState.free_stack, foff))
        }
        IfCondition LessThan(idx, 0) ThenBlock: {
            idx = TRState.count
            IfCondition GreaterEqual(idx, TRConst.MAX_REGIONS) ThenBlock: {
                PrintMessage("[TR] max regions\n")
                ReturnValue(-1)
            }
            TRState.count = Add(idx, 1)
        }
        p = TR_Ptr(idx)
        t = Add(p, TRConst.SURF_OFS)
        StoreValue(t, dst_surf)
        t = Add(p, TRConst.X_OFS)
        StoreValue(t, x)
        t = Add(p, TRConst.Y_OFS)
        StoreValue(t, y)
        t = Add(p, TRConst.W_OFS)
        StoreValue(t, w)
        t = Add(p, TRConst.H_OFS)
        StoreValue(t, h)
        // Defaults
        t = Add(p, TRConst.COLOR_OFS)
        StoreValue(t, Theme.text_fg)
        t = Add(p, TRConst.ALIGN_OFS)
        StoreValue(t, TRAlign.LEFT)
        t = Add(p, TRConst.WRAP_OFS)
        StoreValue(t, 1)
        t = Add(p, TRConst.SPACING_OFS)
        StoreValue(t, 100)
        t = Add(p, TRConst.CURSOR_X_OFS)
        StoreValue(t, x)
        t = Add(p, TRConst.CURSOR_Y_OFS)
        StoreValue(t, y)
        t = Add(p, TRConst.DIRTY_OFS)
        StoreValue(t, 1)
        t = Add(p, TRConst.HAS_BG_OFS)
        StoreValue(t, 0)
        t = Add(p, TRConst.BG_OFS)
        StoreValue(t, 0)
        t = Add(p, TRConst.FONT_SIZE_OFS)
        StoreValue(t, 0)
        t = Add(p, TRConst.HAS_CLIP_OFS)
        StoreValue(t, 0)
        ReturnValue(idx)
    }
}

// =============================================================================
// FREE — return a handle to the free stack for reuse
// =============================================================================
Function.TextRegion_Free {
    Input: handle: Integer
    Body: {
        IfCondition LessThan(handle, 0) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterEqual(handle, TRConst.MAX_REGIONS) ThenBlock: { ReturnValue(0) }
        ft = TRState.free_top
        IfCondition GreaterEqual(ft, TRConst.MAX_REGIONS) ThenBlock: { ReturnValue(0) }
        foff = Multiply(ft, 8)
        StoreValue(Add(TRState.free_stack, foff), handle)
        TRState.free_top = Add(ft, 1)
        ReturnValue(0)
    }
}

// =============================================================================
// PROPERTY SETTERS
// =============================================================================
Function.TextRegion_SetColor {
    Input: handle: Integer
    Input: color: Integer
    Body: {
        p = TR_Ptr(handle)
        t = Add(p, TRConst.COLOR_OFS)
        StoreValue(t, color)
        ReturnValue(0)
    }
}

Function.TextRegion_SetAlign {
    Input: handle: Integer
    Input: align: Integer
    Body: {
        p = TR_Ptr(handle)
        t = Add(p, TRConst.ALIGN_OFS)
        StoreValue(t, align)
        ReturnValue(0)
    }
}

Function.TextRegion_SetWrap {
    Input: handle: Integer
    Input: wrap: Integer
    Body: {
        p = TR_Ptr(handle)
        t = Add(p, TRConst.WRAP_OFS)
        StoreValue(t, wrap)
        ReturnValue(0)
    }
}

Function.TextRegion_SetLineSpacing {
    Input: handle: Integer
    Input: spacing: Integer
    Body: {
        p = TR_Ptr(handle)
        t = Add(p, TRConst.SPACING_OFS)
        StoreValue(t, spacing)
        ReturnValue(0)
    }
}

Function.TextRegion_SetVAlign {
    Input: handle: Integer
    Input: valign: Integer
    Body: {
        p = TR_Ptr(handle)
        t = Add(p, TRConst.VALIGN_OFS)
        StoreValue(t, valign)
        ReturnValue(0)
    }
}

// =============================================================================
// SET CLIP — pass parent clip rect so glyphs outside are skipped
// =============================================================================
Function.TextRegion_SetClip {
    Input: handle: Integer
    Input: cx: Integer
    Input: cy: Integer
    Input: cw: Integer
    Input: ch: Integer
    Body: {
        p = TR_Ptr(handle)
        t = Add(p, TRConst.CLIP_X_OFS)
        StoreValue(t, cx)
        t = Add(p, TRConst.CLIP_Y_OFS)
        StoreValue(t, cy)
        t = Add(p, TRConst.CLIP_W_OFS)
        StoreValue(t, cw)
        t = Add(p, TRConst.CLIP_H_OFS)
        StoreValue(t, ch)
        t = Add(p, TRConst.HAS_CLIP_OFS)
        StoreValue(t, 1)
        ReturnValue(0)
    }
}

// =============================================================================
// SET RECT — called by Auckland on re-solve, or by window on resize
// =============================================================================
Function.TextRegion_SetRect {
    Input: handle: Integer
    Input: x: Integer
    Input: y: Integer
    Input: w: Integer
    Input: h: Integer
    Body: {
        p = TR_Ptr(handle)
        t = Add(p, TRConst.X_OFS)
        StoreValue(t, x)
        t = Add(p, TRConst.Y_OFS)
        StoreValue(t, y)
        t = Add(p, TRConst.W_OFS)
        StoreValue(t, w)
        t = Add(p, TRConst.H_OFS)
        StoreValue(t, h)
        t = Add(p, TRConst.DIRTY_OFS)
        StoreValue(t, 1)
        ReturnValue(0)
    }
}

// =============================================================================
// SET SURFACE — update target canvas (e.g., after window resize recreates it)
// =============================================================================
Function.TextRegion_SetSurface {
    Input: handle: Integer
    Input: surf: Integer
    Body: {
        p = TR_Ptr(handle)
        t = Add(p, TRConst.SURF_OFS)
        StoreValue(t, surf)
        t = Add(p, TRConst.DIRTY_OFS)
        StoreValue(t, 1)
        ReturnValue(0)
    }
}

// =============================================================================
// SET BACKGROUND — optional. If set, TextRegion fills its rect before drawing.
// If not set, TextRegion draws text only (transparent over existing canvas).
// =============================================================================
Function.TextRegion_SetBackground {
    Input: handle: Integer
    Input: color: Integer
    Body: {
        p = TR_Ptr(handle)
        t = Add(p, TRConst.BG_OFS)
        StoreValue(t, color)
        t = Add(p, TRConst.HAS_BG_OFS)
        StoreValue(t, 1)
        ReturnValue(0)
    }
}

Function.TextRegion_ClearBackground {
    Input: handle: Integer
    Body: {
        p = TR_Ptr(handle)
        t = Add(p, TRConst.HAS_BG_OFS)
        StoreValue(t, 0)
        ReturnValue(0)
    }
}

// =============================================================================
// MEASURE WIDTH — pixel width of string without wrapping, without rendering
// Used by Auckland for intrinsic sizing (Pass 1)
// =============================================================================
Function.TextRegion_MeasureWidth {
    Input: str_ptr: Integer
    Input: str_len: Integer
    Output: Integer
    Body: {
        ReturnValue(VFont_MeasureWidth(str_ptr, str_len))
    }
}

// =============================================================================
// MEASURE LINE WIDTH — width of text up to next newline or end
// Returns width in pixels and sets MeasureState.chars_consumed
// =============================================================================
FixedPool.MeasureState {
    "chars_consumed": Initialize=0
}

Function.TR_MeasureLineWidth {
    Input: str_ptr: Integer
    Input: start: Integer
    Input: str_len: Integer
    Output: Integer
    Body: {
        width = 0
        i = start
        WhileLoop LessThan(i, str_len) {
            cp = GetByte(str_ptr, i)
            // Stop at newline
            IfCondition EqualTo(cp, 10) ThenBlock: {
                t1 = Subtract(i, start)
        MeasureState.chars_consumed = Add(t1, 1)
                ReturnValue(width)
            }
            gidx = VFont_FindGlyph(cp)
            IfCondition NotEqual(gidx, -1) ThenBlock: {
                off = Multiply(gidx, FontConst.GLYPH_SIZE)
                gp = Add(FontState.glyphs, off)
                t = Add(gp, FontConst.ADV_OFS)
                adv = Dereference(t)
                sadv = VFont_ScaleMetric(adv)
                width = Add(width, sadv)
            }
            i = Add(i, 1)
        }
        MeasureState.chars_consumed = Subtract(i, start)
        ReturnValue(width)
    }
}

// =============================================================================
// MEASURE HEIGHT — pixel height of string with wrapping
// Used by Auckland for intrinsic sizing (Pass 1)
// =============================================================================
Function.TextRegion_MeasureHeight {
    Input: handle: Integer
    Input: str_ptr: Integer
    Input: str_len: Integer
    Output: Integer
    Body: {
        p = TR_Ptr(handle)
        t = Add(p, TRConst.W_OFS)
        max_w = Dereference(t)
        t = Add(p, TRConst.WRAP_OFS)
        wrap = Dereference(t)
        t = Add(p, TRConst.SPACING_OFS)
        spacing = Dereference(t)

        lh = VFont_GetLineHeight()
        // Apply line spacing: actual_lh = lh * spacing / 100
        actual_lh = Multiply(lh, spacing)
        actual_lh = Divide(actual_lh, 100)
        IfCondition LessEqual(actual_lh, 0) ThenBlock: { actual_lh = lh }

        lines = 1
        cur_x = 0
        i = 0
        WhileLoop LessThan(i, str_len) {
            cp = GetByte(str_ptr, i)

            // Newline
            IfCondition EqualTo(cp, 10) ThenBlock: {
                lines = Add(lines, 1)
                cur_x = 0
                i = Add(i, 1)
            }
            IfCondition NotEqual(cp, 10) ThenBlock: {
                gidx = VFont_FindGlyph(cp)
                adv_px = 0
                IfCondition NotEqual(gidx, -1) ThenBlock: {
                    off = Multiply(gidx, FontConst.GLYPH_SIZE)
                    gp = Add(FontState.glyphs, off)
                    t = Add(gp, FontConst.ADV_OFS)
                    adv = Dereference(t)
                    adv_px = VFont_ScaleMetric(adv)
                }
                IfCondition EqualTo(gidx, -1) ThenBlock: {
                    adv_px = Divide(FontState.render_size, 2)
                }

                // Check wrap
                next_x = Add(cur_x, adv_px)
                IfCondition And(EqualTo(wrap, 1), GreaterThan(next_x, max_w)) ThenBlock: {
                    lines = Add(lines, 1)
                    cur_x = adv_px
                } ElseBlock: {
                    cur_x = next_x
                }
                i = Add(i, 1)
            }
        }
        total = Multiply(lines, actual_lh)
        ReturnValue(total)
    }
}

// =============================================================================
// FIND WORD BREAK — scan backward from pos to find last space
// Returns the position after the space, or pos if no space found
// =============================================================================
Function.TR_FindWordBreak {
    Input: str_ptr: Integer
    Input: line_start: Integer
    Input: pos: Integer
    Output: Integer
    Body: {
        scan = Subtract(pos, 1)
        WhileLoop GreaterThan(scan, line_start) {
            cp = GetByte(str_ptr, scan)
            IfCondition EqualTo(cp, 32) ThenBlock: {
                // Found space — break after it
                ReturnValue(Add(scan, 1))
            }
            scan = Subtract(scan, 1)
        }
        // No space found — hard break at pos
        ReturnValue(pos)
    }
}

// =============================================================================
// RENDER — draw text into canvas at assigned rect
// =============================================================================
Function.TextRegion_Render {
    Input: handle: Integer
    Input: str_ptr: Integer
    Input: str_len: Integer
    Body: {
        p = TR_Ptr(handle)
        t = Add(p, TRConst.SURF_OFS)
        surf = Dereference(t)
        t = Add(p, TRConst.X_OFS)
        rx = Dereference(t)
        t = Add(p, TRConst.Y_OFS)
        ry = Dereference(t)
        t = Add(p, TRConst.W_OFS)
        rw = Dereference(t)
        t = Add(p, TRConst.H_OFS)
        rh = Dereference(t)
        t = Add(p, TRConst.COLOR_OFS)
        color = Dereference(t)
        t = Add(p, TRConst.ALIGN_OFS)
        align = Dereference(t)
        t = Add(p, TRConst.WRAP_OFS)
        wrap = Dereference(t)
        t = Add(p, TRConst.SPACING_OFS)
        spacing = Dereference(t)
        t = Add(p, TRConst.HAS_BG_OFS)
        has_bg = Dereference(t)
        t = Add(p, TRConst.HAS_CLIP_OFS)
        has_clip = Dereference(t)
        clip_x = 0
        clip_y = 0
        clip_r = 9999
        clip_b = 9999
        IfCondition EqualTo(has_clip, 1) ThenBlock: {
            t = Add(p, TRConst.CLIP_X_OFS)
            clip_x = Dereference(t)
            t = Add(p, TRConst.CLIP_Y_OFS)
            clip_y = Dereference(t)
            t = Add(p, TRConst.CLIP_W_OFS)
            clip_r = Add(clip_x, Dereference(t))
            t = Add(p, TRConst.CLIP_H_OFS)
            clip_b = Add(clip_y, Dereference(t))
        }

        IfCondition EqualTo(surf, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(str_len, 0) ThenBlock: { ReturnValue(0) }
        IfCondition LessEqual(rw, 0) ThenBlock: { ReturnValue(0) }
        IfCondition LessEqual(rh, 0) ThenBlock: { ReturnValue(0) }

        // Fill background if set
        IfCondition EqualTo(has_bg, 1) ThenBlock: {
            t = Add(p, TRConst.BG_OFS)
            bg = Dereference(t)
            Draw_Pix_FillRect(surf, rx, ry, rw, rh, bg)
        }

        lh = VFont_GetLineHeight()
        actual_lh = Multiply(lh, spacing)
        actual_lh = Divide(actual_lh, 100)
        IfCondition LessEqual(actual_lh, 0) ThenBlock: { actual_lh = lh }
        // Guard: if line height is still 0 after fallback, we cannot advance
        // vertically and the render loop would spin forever.  Bail out.
        IfCondition LessEqual(actual_lh, 0) ThenBlock: {
            PrintMessage("[TR] WARN line height 0, skipping render\n")
            ReturnValue(0)
        }

        baseline = VFont_GetBaseline()
        right_edge = Add(rx, rw)
        bottom_edge = Add(ry, rh)

        t = Add(p, TRConst.VALIGN_OFS)
        valign = Dereference(t)
        cur_y = Add(ry, baseline)
        IfCondition EqualTo(valign, TRVAlign.MIDDLE) ThenBlock: {
            text_h = VFont_GetLineHeight()
            t1 = Subtract(rh, text_h)
            vpad = Divide(t1, 2)
            t1 = Add(ry, vpad)
            cur_y = Add(t1, baseline)
        }
        IfCondition EqualTo(valign, TRVAlign.BOTTOM) ThenBlock: {
            text_h = VFont_GetLineHeight()
            t1 = Add(ry, rh)
            t2 = Subtract(t1, text_h)
            cur_y = Add(t2, baseline)
        }

        // Render line by line
        line_start = 0

        WhileLoop LessThan(line_start, str_len) {
            saved_start = line_start

            // Check vertical overflow
            IfCondition GreaterThan(cur_y, bottom_edge) ThenBlock: {
                line_start = str_len
            }
            IfCondition LessEqual(cur_y, bottom_edge) ThenBlock: {

                // Find line end — either newline, wrap point, or string end
                line_end = line_start
                line_w = 0
                found_end = 0

                WhileLoop And(LessThan(line_end, str_len), EqualTo(found_end, 0)) {
                    cp = GetByte(str_ptr, line_end)

                    // Newline terminates line
                    IfCondition EqualTo(cp, 10) ThenBlock: {
                        found_end = 1
                    }
                    IfCondition NotEqual(cp, 10) ThenBlock: {
                        // Measure glyph advance
                        gidx = VFont_FindGlyph(cp)
                        adv_px = 0
                        IfCondition NotEqual(gidx, -1) ThenBlock: {
                            off = Multiply(gidx, FontConst.GLYPH_SIZE)
                            gp = Add(FontState.glyphs, off)
                            t = Add(gp, FontConst.ADV_OFS)
                            adv = Dereference(t)
                            adv_px = VFont_ScaleMetric(adv)
                        }
                        IfCondition EqualTo(gidx, -1) ThenBlock: {
                            adv_px = Divide(FontState.render_size, 2)
                        }

                        next_w = Add(line_w, adv_px)

                        // Check wrap
                        IfCondition And(EqualTo(wrap, 1), GreaterThan(next_w, rw)) ThenBlock: {
                            // Try word break
                            IfCondition GreaterThan(line_end, line_start) ThenBlock: {
                                wb = TR_FindWordBreak(str_ptr, line_start, line_end)
                                line_end = wb
                            }
                            found_end = 2
                        }
                        IfCondition LessEqual(next_w, rw) ThenBlock: {
                            line_w = next_w
                            line_end = Add(line_end, 1)
                        }
                    }
                }

                // Compute line pixel width for alignment
                // Re-measure from line_start to line_end
                actual_line_w = 0
                mi = line_start
                WhileLoop LessThan(mi, line_end) {
                    mcp = GetByte(str_ptr, mi)
                    IfCondition NotEqual(mcp, 10) ThenBlock: {
                        mgidx = VFont_FindGlyph(mcp)
                        IfCondition NotEqual(mgidx, -1) ThenBlock: {
                            off = Multiply(mgidx, FontConst.GLYPH_SIZE)
                            gp = Add(FontState.glyphs, off)
                            t = Add(gp, FontConst.ADV_OFS)
                            madv = Dereference(t)
                            actual_line_w = Add(actual_line_w, VFont_ScaleMetric(madv))
                        }
                    }
                    mi = Add(mi, 1)
                }

                // Compute start X based on alignment
                start_x = rx
                IfCondition EqualTo(align, TRAlign.CENTER) ThenBlock: {
                    t1 = Subtract(rw, actual_line_w)
                    offset = Divide(t1, 2)
                    start_x = Add(rx, offset)
                }
                IfCondition EqualTo(align, TRAlign.RIGHT) ThenBlock: {
                    start_x = Subtract(right_edge, actual_line_w)
                }

                // Draw glyphs for this line
                cur_x = start_x
                gi = line_start
                WhileLoop LessThan(gi, line_end) {
                    gcp = GetByte(str_ptr, gi)
                    IfCondition NotEqual(gcp, 10) ThenBlock: {
                        ggidx = VFont_FindGlyph(gcp)
                        IfCondition NotEqual(ggidx, -1) ThenBlock: {
                            off = Multiply(ggidx, FontConst.GLYPH_SIZE)
                            gp = Add(FontState.glyphs, off)
                            t = Add(gp, FontConst.ADV_OFS)
                            gadv = Dereference(t)
                            g_adv_px = VFont_ScaleMetric(gadv)
                            // Clip check: skip glyph if entirely outside clip rect
                            g_gy = Subtract(cur_y, baseline)
                            g_visible = 1
                            IfCondition GreaterEqual(cur_x, clip_r) ThenBlock: { g_visible = 0 }
                            IfCondition LessEqual(Add(cur_x, g_adv_px), clip_x) ThenBlock: { g_visible = 0 }
                            IfCondition GreaterEqual(g_gy, clip_b) ThenBlock: { g_visible = 0 }
                            IfCondition LessEqual(Add(g_gy, actual_lh), clip_y) ThenBlock: { g_visible = 0 }
                            IfCondition EqualTo(g_visible, 1) ThenBlock: {
                                gsrf = VFont_RasterGlyph(ggidx)
                                IfCondition NotEqual(gsrf, 0) ThenBlock: {
                                    Surface_BlitTinted(surf, gsrf, cur_x, g_gy, color)
                                }
                            }
                            cur_x = Add(cur_x, g_adv_px)
                        }
                        IfCondition EqualTo(ggidx, -1) ThenBlock: {
                            // Unknown glyph — advance by half em
                            cur_x = Add(cur_x, Divide(FontState.render_size, 2))
                        }
                    }
                    gi = Add(gi, 1)
                }

                // Advance to next line
                cur_y = Add(cur_y, actual_lh)

                // Advance line_start past what we consumed
                IfCondition EqualTo(found_end, 1) ThenBlock: {
                    // Was newline — skip the newline char
                    line_start = Add(line_end, 1)
                }
                IfCondition EqualTo(found_end, 2) ThenBlock: {
                    // Was word wrap — line_end already at break point
                    line_start = line_end
                    // Skip leading space after wrap
                    IfCondition LessThan(line_start, str_len) ThenBlock: {
                        skip_cp = GetByte(str_ptr, line_start)
                        IfCondition EqualTo(skip_cp, 32) ThenBlock: {
                            line_start = Add(line_start, 1)
                        }
                    }
                }
                IfCondition EqualTo(found_end, 0) ThenBlock: {
                    // Reached end of string
                    line_start = line_end
                }

                // Safety: if line_start didn't advance, force +1 to prevent deadlock
                IfCondition EqualTo(line_start, saved_start) ThenBlock: {
                    line_start = Add(line_start, 1)
                }
            }
        }

        // Update cursor position
        t = Add(p, TRConst.CURSOR_X_OFS)
        StoreValue(t, cur_x)
        t = Add(p, TRConst.CURSOR_Y_OFS)
        StoreValue(t, cur_y)
        t = Add(p, TRConst.DIRTY_OFS)
        StoreValue(t, 0)

        ReturnValue(1)
    }
}

// =============================================================================
// RENDER AT — render at specific position override (ignores stored rect)
// =============================================================================
Function.TextRegion_RenderAt {
    Input: handle: Integer
    Input: str_ptr: Integer
    Input: str_len: Integer
    Input: x: Integer
    Input: y: Integer
    Body: {
        // Save current rect
        p = TR_Ptr(handle)
        t = Add(p, TRConst.X_OFS)
        old_x = Dereference(t)
        t = Add(p, TRConst.Y_OFS)
        old_y = Dereference(t)

        // Set temp position
        t = Add(p, TRConst.X_OFS)
        StoreValue(t, x)
        t = Add(p, TRConst.Y_OFS)
        StoreValue(t, y)

        // Render
        TextRegion_Render(handle, str_ptr, str_len)

        // Restore
        t = Add(p, TRConst.X_OFS)
        StoreValue(t, old_x)
        t = Add(p, TRConst.Y_OFS)
        StoreValue(t, old_y)

        ReturnValue(0)
    }
}

// =============================================================================
// GET CURSOR — returns current cursor X/Y after last render
// Useful for appending text or placing a cursor widget
// =============================================================================
Function.TextRegion_GetCursorX {
    Input: handle: Integer
    Output: Integer
    Body: {
        p = TR_Ptr(handle)
        t = Add(p, TRConst.CURSOR_X_OFS)
        ReturnValue(Dereference(t))
    }
}

Function.TextRegion_GetCursorY {
    Input: handle: Integer
    Output: Integer
    Body: {
        p = TR_Ptr(handle)
        t = Add(p, TRConst.CURSOR_Y_OFS)
        ReturnValue(Dereference(t))
    }
}

// =============================================================================
// IS DIRTY
// =============================================================================
Function.TextRegion_IsDirty {
    Input: handle: Integer
    Output: Integer
    Body: {
        p = TR_Ptr(handle)
        t = Add(p, TRConst.DIRTY_OFS)
        ReturnValue(Dereference(t))
    }
}

// =============================================================================
// MARK DIRTY — force re-render on next pass
// =============================================================================
Function.TextRegion_MarkDirty {
    Input: handle: Integer
    Body: {
        p = TR_Ptr(handle)
        t = Add(p, TRConst.DIRTY_OFS)
        StoreValue(t, 1)
        ReturnValue(0)
    }
}

// =============================================================================
// SHUTDOWN
// =============================================================================
Function.TextRegion_Shutdown {
    Body: {
        sz = Multiply(TRConst.MAX_REGIONS, TRConst.ENTRY_SIZE)
        buf = TRState.data
        IfCondition NotEqual(buf, 0) ThenBlock: {
            Deallocate(buf, sz)
            TRState.data = 0
        }
        fs = TRState.free_stack
        IfCondition NotEqual(fs, 0) ThenBlock: {
            fsz = Multiply(TRConst.MAX_REGIONS, 8)
            Deallocate(fs, fsz)
            TRState.free_stack = 0
        }
        TRState.count = 0
        TRState.free_top = 0
        PrintMessage("[TR] shutdown\n")
        ReturnValue(0)
    }
}