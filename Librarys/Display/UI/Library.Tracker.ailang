LibraryImport.Arena
LibraryImport.Display.UI.Auckland
LibraryImport.AppHost
LibraryImport.Display.System.EventRouter
LibraryImport.Display.Window.WinManager
LibraryImport.StringUtils
LibraryImport.Display.Render.Fonts
LibraryImport.Display.UI.TextRegion
LibraryImport.Display.Theme.UITheme
LibraryImport.Display.Theme.UIScale
LibraryImport.Hash
LibraryImport.Display.Content.HTMLParse
LibraryImport.Display.UI.AucklandBind
LibraryImport.Arrays
LibraryImport.PostgreSQL_Complete
Import.OS.FileTree
LibraryImport.Display.Content.ImgXlat

FixedPool.TrackerState {
    "win_idx":  Initialize=-1, CanChange=True
    "dir":      Initialize=0,  CanChange=True
    "selected": Initialize=-1, CanChange=True
    "grid":     Initialize=-1, CanChange=True
    "path":     Initialize=-1, CanChange=True
    "stat":     Initialize=-1, CanChange=True
    "count":    Initialize=0,  CanChange=True
    "dirs":     Initialize=0,  CanChange=True
    "lab":      Initialize=0,  CanChange=True
    "walk":     Initialize=-1, CanChange=True
    "child":    Initialize=-1, CanChange=True
}

FixedPool.TkPaint {
    "ap":  Initialize=0, CanChange=True
    "al":  Initialize=0, CanChange=True
    "bg":  Initialize=0, CanChange=True
    "fg":  Initialize=0, CanChange=True
    "fid": Initialize=0, CanChange=True
}

Function.Tracker_ActionCb {
    Input: action_ptr: Address
    Input: action_len: Integer
    Output: Integer
    Body: {
        EventRouter_Push(action_ptr, action_len, 0)
        ReturnValue(1)
    }
}

Function.Tracker_FindNodes {
    Input: ctx: LinkagePool.AKContext
    Body: {
        TrackerState.grid = AK_FindById(ctx, "tk_grid")
        TrackerState.path = AK_FindById(ctx, "tk_path")
        TrackerState.stat = AK_FindById(ctx, "tk_stat")
    }
}

Function.Tracker_SetLabel {
    Input: ctx: LinkagePool.AKContext
    Input: node: Integer
    Input: s: Address
    Body: {
        IfCondition Or(LessThan(node, 0), EqualTo(s, 0)) ThenBlock: {
            ReturnValue(0)
        }
        AK_ExtraSet(ctx, node, AKExtra.STR_PTR, s)
        AK_ExtraSet(ctx, node, AKExtra.STR_LEN, StringLength(s))
        AK_Set(ctx, node, AKF.DIRTY, 1)
    }
}

Function.Tracker_Redraw {
    Body: {
        IfCondition LessThan(TrackerState.win_idx, 0) ThenBlock: {
            ReturnValue(0)
        }
        ctx = WinView_GetContentCtx(TrackerState.win_idx)
        content = WinMgr_GetContent(TrackerState.win_idx)
        IfCondition Or(EqualTo(ctx, 0), EqualTo(content, 0)) ThenBlock: {
            ReturnValue(0)
        }
        cw = Win_GetCanvasW(TrackerState.win_idx)
        ch = Win_GetCanvasH(TrackerState.win_idx)
        AK_SetDesignW(ctx, cw)
        AK_SetDesignH(ctx, ch)
        VFont_UseSize(UIScale.font_body)
        AK_Draw(ctx, content, cw, ch)
        SysDisplayState.dirty = 1
    }
}

Function.Tracker_AddCell {
    Input: ctx: LinkagePool.AKContext
    Input: v_id: Address
    Input: v_name: Address
    Input: is_dir: Integer
    Body: {
        cell = AK_CreateNode(ctx, AKTag.GROUP)
        AK_Set(ctx, cell, AKF.LAYOUT_MODE, AKLayout.VBOX)
        AK_Set(ctx, cell, AKF.WIDTH, 112)
        AK_Set(ctx, cell, AKF.HEIGHT, 92)
        AK_Set(ctx, cell, AKF.GAP, 2)
        btn = AK_CreateNode(ctx, AKTag.BUTTON)
        AK_Set(ctx, btn, AKF.WIDTH, 108)
        AK_Set(ctx, btn, AKF.HEIGHT, 56)
        IfCondition EqualTo(is_dir, 1) ThenBlock: {
            AK_ExtraSet(ctx, btn, AKExtra.STR_PTR, "folder")
            AK_ExtraSet(ctx, btn, AKExtra.STR_LEN, 6)
            AK_ExtraSet(ctx, btn, AKExtra.COLOR_BG, 0xFF243656)
            AK_ExtraSet(ctx, btn, AKExtra.COLOR_FG, 0xFFE8C547)
            act = StringConcat("tk.nav:", v_id)
        }
        ElseBlock: {
            AK_ExtraSet(ctx, btn, AKExtra.STR_PTR, "file")
            AK_ExtraSet(ctx, btn, AKExtra.STR_LEN, 4)
            AK_ExtraSet(ctx, btn, AKExtra.COLOR_BG, 0xFF1A2740)
            AK_ExtraSet(ctx, btn, AKExtra.COLOR_FG, 0xFF7DD3FC)
            act = StringConcat("tk.sel:", v_id)
        }
        AK_ExtraSet(ctx, btn, AKExtra.ACTION_PTR, act)
        AK_ExtraSet(ctx, btn, AKExtra.ACTION_LEN, StringLength(act))
        AK_ExtraSet(ctx, btn, AKExtra.TEXT_ALIGN, TRAlign.CENTER)
        AK_AddChild(ctx, cell, btn)
        nm = AK_CreateNode(ctx, AKTag.LABEL)
        AK_Set(ctx, nm, AKF.WIDTH, 108)
        AK_Set(ctx, nm, AKF.HEIGHT, 28)
        nlen = StringLength(v_name)
        IfCondition GreaterThan(nlen, 14) ThenBlock: {
            nlen = 14
        }
        AK_ExtraSet(ctx, nm, AKExtra.STR_PTR, v_name)
        AK_ExtraSet(ctx, nm, AKExtra.STR_LEN, nlen)
        AK_ExtraSet(ctx, nm, AKExtra.COLOR_FG, 0xFFE8EEF8)
        AK_ExtraSet(ctx, nm, AKExtra.TEXT_ALIGN, TRAlign.CENTER)
        AK_ExtraSet(ctx, nm, AKExtra.ACTION_PTR, act)
        AK_ExtraSet(ctx, nm, AKExtra.ACTION_LEN, StringLength(act))
        AK_AddChild(ctx, cell, nm)
        AK_AddChild(ctx, TrackerState.grid, cell)
    }
}

Function.Tracker_Populate {
    Body: {
        IfCondition LessThan(TrackerState.win_idx, 0) ThenBlock: {
            ReturnValue(0)
        }
        ctx = WinView_GetContentCtx(TrackerState.win_idx)
        IfCondition EqualTo(ctx, 0) ThenBlock: {
            ReturnValue(0)
        }
        Tracker_FindNodes(ctx)
        IfCondition LessThan(TrackerState.grid, 0) ThenBlock: {
            ReturnValue(0)
        }
        AK_ClearChildren(ctx, TrackerState.grid)
        conn = SysDisplay_GetDBConn()
        IfCondition EqualTo(conn, 0) ThenBlock: {
            ReturnValue(0)
        }
        r = 0
        IfCondition EqualTo(TrackerState.dir, 0) ThenBlock: {
            r = PG_Query(conn, "SELECT id, name, type, blob_size FROM files WHERE parent_id IS NULL ORDER BY type DESC, name")
        }
        ElseBlock: {
            q1 = "SELECT id, name, type, blob_size FROM files WHERE parent_id = "
            q2 = StringConcat(q1, NumberToString(TrackerState.dir))
            q3 = StringConcat(q2, " ORDER BY type DESC, name")
            r = PG_Query(conn, q3)
        }
        IfCondition EqualTo(r, 0) ThenBlock: {
            ReturnValue(0)
        }
        rc = Array.Size(r)
        TrackerState.count = rc
        TrackerState.dirs = 0
        ri = 0
        WhileLoop And(LessThan(ri, rc), LessThan(ri, 24)) {
            row = Array.Get(r, ri)
            v_id = Hash.Get(row, "id")
            v_name = Hash.Get(row, "name")
            v_type = Hash.Get(row, "type")
            is_dir = 0
            IfCondition NotEqual(v_type, 0) ThenBlock: {
                IfCondition EqualTo(StringCompare(v_type, "dir"), 0) ThenBlock: {
                    is_dir = 1
                    TrackerState.dirs = Add(TrackerState.dirs, 1)
                }
            }
            Tracker_AddCell(ctx, v_id, v_name, is_dir)
            ri = Add(ri, 1)
        }
        PG_DestroyResult(r)
        pth = "/"
        IfCondition GreaterThan(TrackerState.dir, 0) ThenBlock: {
            info = FileTree_GetInfo(conn, TrackerState.dir)
            IfCondition NotEqual(info, 0) ThenBlock: {
                irow = Array.Get(info, 0)
                nm2 = Hash.Get(irow, "name")
                IfCondition NotEqual(nm2, 0) ThenBlock: {
                    pth = nm2
                }
                PG_DestroyResult(info)
            }
        }
        Tracker_SetLabel(ctx, TrackerState.path, pth)
        IfCondition EqualTo(TrackerState.lab, 0) ThenBlock: {
            TrackerState.lab = Allocate(32)
        }
        st = StringConcat(NumberToString(TrackerState.count), " items")
        Tracker_SetLabel(ctx, TrackerState.stat, st)
        Tracker_PaintSel()
        Tracker_Redraw()
    }
}

Function.Tracker_Open {
    Output: Integer
    Body: {
        IfCondition GreaterEqual(TrackerState.win_idx, 0) ThenBlock: {
            Tracker_Populate()
            ReturnValue(TrackerState.win_idx)
        }
        win_idx = AppHost_Open("config/tracker.html", AddressOf(Tracker_ActionCb))
        IfCondition LessEqual(win_idx, 0) ThenBlock: {
            PrintMessage("[Tracker] open fail\n")
            ReturnValue(-1)
        }
        TrackerState.win_idx = win_idx
        TrackerState.dir = 1
        TrackerState.selected = -1
        ctx = WinView_GetContentCtx(win_idx)
        Tracker_FindNodes(ctx)
        Tracker_Populate()
        PrintMessage("[Tracker] opened win=")
        PrintNumber(win_idx)
        PrintMessage("\n")
        ReturnValue(win_idx)
    }
}

Function.Tracker_Nav {
    Input: dir_id: Integer
    Body: {
        TrackerState.dir = dir_id
        TrackerState.selected = -1
        Tracker_Populate()
        PrintMessage("[Tracker] nav=")
        PrintNumber(dir_id)
        PrintMessage("\n")
    }
}

Function.Tracker_Up {
    Body: {
        IfCondition EqualTo(TrackerState.dir, 0) ThenBlock: {
            ReturnValue(0)
        }
        conn = SysDisplay_GetDBConn()
        IfCondition EqualTo(conn, 0) ThenBlock: {
            ReturnValue(0)
        }
        info = FileTree_GetInfo(conn, TrackerState.dir)
        IfCondition EqualTo(info, 0) ThenBlock: {
            ReturnValue(0)
        }
        irow = Array.Get(info, 0)
        pstr = Hash.Get(irow, "parent_id")
        PG_DestroyResult(info)
        pid = 0
        IfCondition NotEqual(pstr, 0) ThenBlock: {
            pid = StringToNumber(pstr)
        }
        Tracker_Nav(pid)
    }
}

Function.Tracker_LaunchPic {
    Input: fid: Integer
    Body: {
        conn = SysDisplay_GetDBConn()
        IfCondition EqualTo(conn, 0) ThenBlock: {
            ReturnValue(0)
        }
        info = FileTree_GetInfo(conn, fid)
        IfCondition EqualTo(info, 0) ThenBlock: {
            ReturnValue(0)
        }
        irow = Array.Get(info, 0)
        uuid = Hash.Get(irow, "blob_uuid")
        PG_DestroyResult(info)
        IfCondition EqualTo(uuid, 0) ThenBlock: {
            ReturnValue(0)
        }
        p1 = StringConcat("/data/blobs/", uuid)
        p2 = StringConcat(p1, ".blob")
        fd = SystemCall(2, "/tmp/picview.path", 577, 420, 0, 0)
        IfCondition LessThan(fd, 0) ThenBlock: {
            PrintMessage("[Tracker] picview.path write fail\n")
            ReturnValue(0)
        }
        SystemCall(1, fd, p2, StringLength(p2), 0, 0)
        SystemCall(3, fd, 0, 0, 0, 0)
        argv = Allocate(16)
        StoreValue(argv, "/system/bin/picview.x")
        StoreValue(Add(argv, 8), 0)
        pid = SystemCall(57)
        IfCondition EqualTo(pid, 0) ThenBlock: {
            cfd = 3
            WhileLoop LessThan(cfd, 64) {
                SystemCall(3, cfd, 0, 0, 0, 0)
                cfd = Add(cfd, 1)
            }
            SystemCall(59, "/system/bin/picview.x", argv, 0)
            SystemCall(60, 127)
        }
        IfCondition GreaterThan(pid, 0) ThenBlock: {
            PrintMessage("[Tracker] picview pid=")
            PrintNumber(pid)
            PrintMessage("\n")
        }
        Deallocate(argv, 16)
    }
}

Function.Tracker_StyleNode {
    Input: ctx: LinkagePool.AKContext
    Input: node: Integer
    Body: {
        IfCondition Or(EqualTo(ctx, 0), LessThan(node, 0)) ThenBlock: {
            ReturnValue(0)
        }
        TkPaint.ap = AK_ExtraGet(ctx, node, AKExtra.ACTION_PTR)
        TkPaint.al = AK_ExtraGet(ctx, node, AKExtra.ACTION_LEN)
        IfCondition Or(EqualTo(TkPaint.ap, 0), LessThan(TkPaint.al, 8)) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition NotEqual(GetByte(TkPaint.ap, 0), 116) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(GetByte(TkPaint.ap, 1), 107) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(GetByte(TkPaint.ap, 2), 46) ThenBlock: { ReturnValue(0) }
        TkPaint.fid = StringToNumber(Add(TkPaint.ap, 7))
        IfCondition EqualTo(GetByte(TkPaint.ap, 3), 110) ThenBlock: {
            TkPaint.bg = 0xFF243656
            TkPaint.fg = 0xFFE8C547
        }
        ElseBlock: {
            TkPaint.bg = 0xFF1A2740
            TkPaint.fg = 0xFF7DD3FC
        }
        IfCondition EqualTo(TkPaint.fid, TrackerState.selected) ThenBlock: {
            TkPaint.bg = 0xFF1B5EA8
            TkPaint.fg = 0xFFFFFFFF
        }
        AK_ExtraSet(ctx, node, AKExtra.COLOR_BG, TkPaint.bg)
        AK_ExtraSet(ctx, node, AKExtra.COLOR_FG, TkPaint.fg)
        AK_Set(ctx, node, AKF.DIRTY, 1)
    }
}

Function.Tracker_PaintSel {
    Body: {
        IfCondition LessThan(TrackerState.win_idx, 0) ThenBlock: {
            ReturnValue(0)
        }
        ctx = WinView_GetContentCtx(TrackerState.win_idx)
        IfCondition EqualTo(ctx, 0) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition LessThan(TrackerState.grid, 0) ThenBlock: {
            ReturnValue(0)
        }
        TrackerState.walk = AK_Get(ctx, TrackerState.grid, AKF.FIRST_CHILD)
        WhileLoop NotEqual(TrackerState.walk, -1) {
            TrackerState.child = AK_Get(ctx, TrackerState.walk, AKF.FIRST_CHILD)
            WhileLoop NotEqual(TrackerState.child, -1) {
                Tracker_StyleNode(ctx, TrackerState.child)
                TrackerState.child = AK_Get(ctx, TrackerState.child, AKF.NEXT_SIBLING)
            }
            TrackerState.walk = AK_Get(ctx, TrackerState.walk, AKF.NEXT_SIBLING)
        }
    }
}

Function.Tracker_Mark {
    Input: fid: Integer
    Body: {
        TrackerState.selected = fid
        PrintMessage("[Tracker] sel=")
        PrintNumber(fid)
        PrintMessage("\n")
        IfCondition LessThan(TrackerState.win_idx, 0) ThenBlock: {
            ReturnValue(0)
        }
        ctx = WinView_GetContentCtx(TrackerState.win_idx)
        IfCondition EqualTo(ctx, 0) ThenBlock: {
            ReturnValue(0)
        }
        conn = SysDisplay_GetDBConn()
        IfCondition EqualTo(conn, 0) ThenBlock: {
            ReturnValue(0)
        }
        info = FileTree_GetInfo(conn, fid)
        IfCondition EqualTo(info, 0) ThenBlock: {
            ReturnValue(0)
        }
        irow = Array.Get(info, 0)
        nm = Hash.Get(irow, "name")
        PG_DestroyResult(info)
        IfCondition NotEqual(nm, 0) ThenBlock: {
            Tracker_SetLabel(ctx, TrackerState.stat, nm)
        }
        Tracker_PaintSel()
        Tracker_Redraw()
    }
}

Function.Tracker_OpenSelected {
    Body: {
        fid = TrackerState.selected
        IfCondition LessThan(fid, 0) ThenBlock: {
            ReturnValue(0)
        }
        conn = SysDisplay_GetDBConn()
        IfCondition EqualTo(conn, 0) ThenBlock: {
            ReturnValue(0)
        }
        info = FileTree_GetInfo(conn, fid)
        IfCondition EqualTo(info, 0) ThenBlock: {
            ReturnValue(0)
        }
        irow = Array.Get(info, 0)
        v_type = Hash.Get(irow, "type")
        nm = Hash.Get(irow, "name")
        PG_DestroyResult(info)
        IfCondition NotEqual(v_type, 0) ThenBlock: {
            IfCondition EqualTo(StringCompare(v_type, "dir"), 0) ThenBlock: {
                Tracker_Nav(fid)
                ReturnValue(1)
            }
        }
        IfCondition EqualTo(ImgXlat_NameIsImage(nm), 1) ThenBlock: {
            Tracker_LaunchPic(fid)
            ReturnValue(1)
        }
        IfCondition LessThan(TrackerState.win_idx, 0) ThenBlock: {
            ReturnValue(0)
        }
        ctx = WinView_GetContentCtx(TrackerState.win_idx)
        IfCondition EqualTo(ctx, 0) ThenBlock: {
            ReturnValue(0)
        }
        Tracker_SetLabel(ctx, TrackerState.stat, "No application")
        Tracker_Redraw()
        ReturnValue(0)
    }
}

Function.Tracker_Sel {
    Input: fid: Integer
    Body: {
        IfCondition EqualTo(TrackerState.selected, fid) ThenBlock: {
            Tracker_OpenSelected()
            ReturnValue(1)
        }
        Tracker_Mark(fid)
    }
}

Function.Tracker_HandleAction {
    Input: action_ptr: Address
    Input: action_len: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(action_len, 3) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition NotEqual(GetByte(action_ptr, 0), 116) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition NotEqual(GetByte(action_ptr, 1), 107) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition NotEqual(GetByte(action_ptr, 2), 46) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition EqualTo(StringCompare(action_ptr, "tk.up"), 0) ThenBlock: {
            Tracker_Up()
            ReturnValue(1)
        }
        IfCondition EqualTo(StringCompare(action_ptr, "tk.open"), 0) ThenBlock: {
            Tracker_OpenSelected()
            ReturnValue(1)
        }
        IfCondition EqualTo(StringCompare(action_ptr, "tk.pic"), 0) ThenBlock: {
            IfCondition GreaterThan(TrackerState.selected, 0) ThenBlock: {
                Tracker_LaunchPic(TrackerState.selected)
            }
            ReturnValue(1)
        }
        IfCondition GreaterEqual(action_len, 9) ThenBlock: {
            IfCondition EqualTo(GetByte(action_ptr, 3), 117) ThenBlock: {
                IfCondition EqualTo(StringCompare(action_ptr, "tk.up"), 0) ThenBlock: {
                    Tracker_Up()
                    ReturnValue(1)
                }
            }
        }
        IfCondition GreaterEqual(action_len, 8) ThenBlock: {
            IfCondition And(And(EqualTo(GetByte(action_ptr, 3), 110), EqualTo(GetByte(action_ptr, 4), 97)), And(EqualTo(GetByte(action_ptr, 5), 118), EqualTo(GetByte(action_ptr, 6), 58))) ThenBlock: {
                Tracker_Nav(StringToNumber(Add(action_ptr, 7)))
                ReturnValue(1)
            }
        }
        IfCondition GreaterEqual(action_len, 8) ThenBlock: {
            IfCondition And(And(EqualTo(GetByte(action_ptr, 3), 115), EqualTo(GetByte(action_ptr, 4), 101)), And(EqualTo(GetByte(action_ptr, 5), 108), EqualTo(GetByte(action_ptr, 6), 58))) ThenBlock: {
                Tracker_Sel(StringToNumber(Add(action_ptr, 7)))
                ReturnValue(1)
            }
        }
        IfCondition GreaterEqual(action_len, 10) ThenBlock: {
            IfCondition And(EqualTo(GetByte(action_ptr, 3), 112), EqualTo(GetByte(action_ptr, 8), 58)) ThenBlock: {
                Tracker_Nav(StringToNumber(Add(action_ptr, 9)))
                ReturnValue(1)
            }
        }
        ReturnValue(0)
    }
}
