//
// WINGEOM — per-window authoritative geometry table
// One entry per window slot (max 8). Written ONLY by Win_SetGeom.
// Fields per entry (8 bytes each, 48 bytes per slot):
//   total_w, total_h, canvas_w, canvas_h, x, y
// =============================================================================

LibraryImport.Display.Render.DSurfaceTypes
LibraryImport.Display.Render.DSurface
LibraryImport.Display.Render.DDrawPixel
LibraryImport.Display.Render.DComposeTypes
LibraryImport.Display.Render.DComposeFloat
LibraryImport.Display.Input.Cursor
LibraryImport.Display.Window.WinStack
LibraryImport.Display.Window.WinRender
LibraryImport.Display.Window.WinInput
LibraryImport.Display.Menu.Deskbar

// =============================================================================
// FIXED POOLS — geometry, defaults, colors, WinView
// =============================================================================

FixedPool.WinGeomFields {
    "TOTAL_W":  Initialize=0
    "TOTAL_H":  Initialize=8
    "CANVAS_W": Initialize=16
    "CANVAS_H": Initialize=24
    "X":        Initialize=32
    "Y":        Initialize=40
}

FixedPool.WinGeomConst {
    "ENTRY_SIZE": Initialize=48
    "MAX":        Initialize=8
}

FixedPool.WinGeomTable {
    "data": Initialize=0
}

FixedPool.WinMgr {
    "focused":          Initialize=0
    "count":            Initialize=0
    "hdr_data":         Initialize=0
    "content_data":     Initialize=0
    "tb_data":          Initialize=0
    "title_data":       Initialize=0
    "tab_inst":         Initialize=-1, CanChange=True
    "toolbar_data":     Initialize=0
    "toolbar_h_data":   Initialize=0
    "toolbar_ctx_data": Initialize=0
    "addr_data":        Initialize=0
    "addr_h_data":      Initialize=0
    "addr_ctx_data":    Initialize=0
    "z_order":          Initialize=0
    "z_count":          Initialize=0, CanChange=True
    "flags_data":       Initialize=0
    "maxgeom_data":     Initialize=0
}

FixedPool.WinFlags {
    "MINIMIZED": Initialize=1
    "MAXIMIZED": Initialize=2
}

// NOTE: drag_*/resize_* fields removed — now in WinInputState (Library.WinInput.ailang)

FixedPool.WinViewFields {
    "JOB_PTR":       Initialize=0
    "SERVICE_ID":    Initialize=8
    "BINDINGS":      Initialize=16
    "BINDING_COUNT": Initialize=24
    "VIEW_TYPE":     Initialize=32
    "DOC_HANDLE":    Initialize=40
    "PAGE_HANDLE":   Initialize=48
    "CONTENT_CTX":   Initialize=56
}

FixedPool.WinViewConst {
    "ENTRY_SIZE": Initialize=64
    "MAX":        Initialize=8
}

FixedPool.WinViewTable {
    "data": Initialize=0
}

// =============================================================================
// CANVAS STATE — per-window shared memory canvas for IPC pixel streaming
// =============================================================================
FixedPool.CanvasFields {
    "ACTIVE":        Initialize=0
    "SHM_PTR":       Initialize=8
    "SHM_SIZE":      Initialize=16
    "SURF":          Initialize=24
    "MOUSE_CAPTURE": Initialize=32
    "DIRTY":         Initialize=40
    "CURSOR_NATIVE": Initialize=48
}

FixedPool.CanvasConst {
    "ENTRY_SIZE": Initialize=56
}

FixedPool.CanvasState {
    "data": Initialize=0
}


// =============================================================================
// WINMGR_INIT
// =============================================================================
Function.WinMgr_Init {
    Output: Integer
    Body: {
        DebugLog_Push("wm.ini", 6)
        WinMgr.focused      = -1
        WinMgr.count        = 0
        DebugLog_Push("wm.ini.1", 8)
        WinMgr.hdr_data     = Allocate(64)
        WinMgr.content_data = Allocate(64)
        WinMgr.tb_data      = Allocate(64)
        WinMgr.title_data   = Allocate(64)
        WinMgr.toolbar_data     = Allocate(64)
        WinMgr.toolbar_h_data   = Allocate(64)
        WinMgr.toolbar_ctx_data = Allocate(64)
        WinMgr.addr_data        = Allocate(64)
        WinMgr.addr_h_data      = Allocate(64)
        WinMgr.addr_ctx_data    = Allocate(64)
        DebugLog_Push("wm.ini.6", 8)

        i = 0
        WhileLoop LessThan(i, 8) {
            off = Multiply(i, 8)
            StoreValue(Add(WinMgr.hdr_data,         off), -1)
            StoreValue(Add(WinMgr.content_data,     off), -1)
            StoreValue(Add(WinMgr.tb_data,          off), -1)
            StoreValue(Add(WinMgr.title_data,       off), 0)
            StoreValue(Add(WinMgr.toolbar_data,     off), -1)
            StoreValue(Add(WinMgr.toolbar_h_data,   off), 0)
            StoreValue(Add(WinMgr.toolbar_ctx_data, off), 0)
            StoreValue(Add(WinMgr.addr_data,        off), -1)
            StoreValue(Add(WinMgr.addr_h_data,      off), 0)
            StoreValue(Add(WinMgr.addr_ctx_data,    off), 0)
            i = Add(i, 1)
        }

        geom_size = Multiply(WinGeomConst.MAX, WinGeomConst.ENTRY_SIZE)
        DebugLog_Push("wm.ini.2", 8)
        geom_buf  = Allocate(geom_size)
        DebugLog_Push("wm.ini.3", 8)
        gi = 0
        WhileLoop LessThan(gi, geom_size) {
            SetByte(geom_buf, gi, 0)
            gi = Add(gi, 1)
        }
        WinGeomTable.data = geom_buf

        // Z-order array (8 slots × 8 bytes)
        DebugLog_Push("wm.ini.4", 8)
        WinMgr.z_order = Allocate(64)
        DebugLog_Push("wm.ini.5", 8)
        zi = 0
        WhileLoop LessThan(zi, 8) {
            zoff = Multiply(zi, 8)
            StoreValue(Add(WinMgr.z_order, zoff), -1)
            zi = Add(zi, 1)
        }
        WinMgr.z_count = 0

        // Window flags (8 slots × 8 bytes) — minimize/maximize state
        WinMgr.flags_data = Allocate(64)
        fi = 0
        WhileLoop LessThan(fi, 64) {
            SetByte(WinMgr.flags_data, fi, 0)
            fi = Add(fi, 1)
        }

        // Max-geometry save (8 slots × 32 bytes: x, y, total_w, total_h)
        WinMgr.maxgeom_data = Allocate(256)
        mi = 0
        WhileLoop LessThan(mi, 256) {
            SetByte(WinMgr.maxgeom_data, mi, 0)
            mi = Add(mi, 1)
        }

        // Stack init (delegated to WinStack)
        WinStack_Init()

        PrintMessage("[WinMgr] stacks initialized\n")

        WinView_Init()

        // Canvas state (8 slots × 32 bytes)
        CanvasState.data = Allocate(256)
        ci2 = 0
        WhileLoop LessThan(ci2, 256) {
            SetByte(CanvasState.data, ci2, 0)
            ci2 = Add(ci2, 1)
        }

        ReturnValue(1)
    }
}


// =============================================================================
// GEOMETRY
// =============================================================================
Function.Win_GeomPtr {
    Input:  idx: Integer
    Output: Integer
    Body: {
        DebugLog_Push("wm.gp", 5)
        ReturnValue(Add(WinGeomTable.data, Multiply(idx, WinGeomConst.ENTRY_SIZE)))
    }
}

Function.Win_SetGeom {
    Input: idx:     Integer
    Input: x:       Integer
    Input: y:       Integer
    Input: total_w: Integer
    Input: total_h: Integer
    Output: Integer
    Body: {
        DebugLog_Push("wm.geo", 6)
        bw       = DecorConfig.border_w
        canvas_w = Subtract(total_w, Multiply(bw, 2))
        canvas_h = Subtract(total_h, Multiply(bw, 2))
        min_cw   = WinMinSize.w
        min_ch   = WinMinSize.h
        IfCondition LessThan(canvas_w, min_cw) ThenBlock: { canvas_w = min_cw }
        IfCondition LessThan(canvas_h, min_ch) ThenBlock: { canvas_h = min_ch }
        total_w = Add(canvas_w, Multiply(bw, 2))
        total_h = Add(canvas_h, Multiply(bw, 2))

        gptr = Win_GeomPtr(idx)
        StoreValue(Add(gptr, WinGeomFields.TOTAL_W),  total_w)
        StoreValue(Add(gptr, WinGeomFields.TOTAL_H),  total_h)
        StoreValue(Add(gptr, WinGeomFields.CANVAS_W), canvas_w)
        StoreValue(Add(gptr, WinGeomFields.CANVAS_H), canvas_h)
        StoreValue(Add(gptr, WinGeomFields.X),        x)
        StoreValue(Add(gptr, WinGeomFields.Y),        y)

        tbh       = Win_GetTabBarH_FromStack(idx)
        toolbar_h = WinMgr_GetToolbarH(idx)
        fptr = Float_EntryPtr(idx)
        StoreValue(Add(fptr, FloatEntryFields.X), x)
        StoreValue(Add(fptr, FloatEntryFields.Y), Subtract(Subtract(y, tbh), toolbar_h))
        StoreValue(Add(fptr, FloatEntryFields.W), total_w)
        StoreValue(Add(fptr, FloatEntryFields.H), Add(Add(total_h, tbh), toolbar_h))
        ReturnValue(1)
    }
}

Function.Win_GetTotalW  { Input: idx: Integer Output: Integer Body: { DebugLog_Push("wm.gtw", 6)  ReturnValue(Dereference(Add(Win_GeomPtr(idx), WinGeomFields.TOTAL_W)))  } }
Function.Win_GetTotalH  { Input: idx: Integer Output: Integer Body: { DebugLog_Push("wm.gth", 6)  ReturnValue(Dereference(Add(Win_GeomPtr(idx), WinGeomFields.TOTAL_H)))  } }
Function.Win_GetCanvasW { Input: idx: Integer Output: Integer Body: { DebugLog_Push("wm.gcw", 6)  ReturnValue(Dereference(Add(Win_GeomPtr(idx), WinGeomFields.CANVAS_W))) } }
Function.Win_GetCanvasH { Input: idx: Integer Output: Integer Body: { DebugLog_Push("wm.gch", 6)  ReturnValue(Dereference(Add(Win_GeomPtr(idx), WinGeomFields.CANVAS_H))) } }
Function.Win_GetX       { Input: idx: Integer Output: Integer Body: { DebugLog_Push("wm.gx", 5)   ReturnValue(Dereference(Add(Win_GeomPtr(idx), WinGeomFields.X)))        } }
Function.Win_GetY       { Input: idx: Integer Output: Integer Body: { DebugLog_Push("wm.gy", 5)   ReturnValue(Dereference(Add(Win_GeomPtr(idx), WinGeomFields.Y)))        } }


