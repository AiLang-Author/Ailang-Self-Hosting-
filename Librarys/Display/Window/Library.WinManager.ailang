Function.Canvas_SetCursorNative { Input: idx: Integer Input: val: Integer Body: { base = Canvas_Ptr(idx) StoreValue(Add(base, CanvasFields.CURSOR_NATIVE), val) } }

Function.WinView_Clear {
    Input: idx: Integer
    Body: {
        DebugLog_Push("wm.vcl", 6)
        bindings = WinView_GetBindings(idx)
        IfCondition NotEqual(bindings, 0) ThenBlock: {
            XArray.XDestroy(bindings)
        }
        base = WinView_Ptr(idx)
        StoreValue(Add(base, WinViewFields.JOB_PTR),       0)
        StoreValue(Add(base, WinViewFields.SERVICE_ID),    -1)
        StoreValue(Add(base, WinViewFields.BINDINGS),       0)
        StoreValue(Add(base, WinViewFields.BINDING_COUNT),  0)
        StoreValue(Add(base, WinViewFields.VIEW_TYPE),      0)
        StoreValue(Add(base, WinViewFields.DOC_HANDLE),    -1)
        StoreValue(Add(base, WinViewFields.PAGE_HANDLE),   -1)
        StoreValue(Add(base, WinViewFields.CONTENT_CTX),    0)
    }
}

Function.WinView_ShiftDown {
    Input: dst_idx: Integer
    Input: src_idx: Integer
    Body: {
        DebugLog_Push("wm.vsd", 6)
        src = WinView_Ptr(src_idx)
        dst = WinView_Ptr(dst_idx)
        j = 0
        WhileLoop LessThan(j, WinViewConst.ENTRY_SIZE) {
            SetByte(dst, j, GetByte(src, j))
            j = Add(j, 1)
        }
    }
}

Function.WinView_Save {
    Input: idx: Integer
    Output: Integer
    Body: {
        DebugLog_Push("wm.vsv", 6)
        DebugLog_Push("wm.vsv1", 7)
        buf = Allocate(WinViewConst.ENTRY_SIZE)
        DebugLog_Push("wm.vsv2", 7)
        src = WinView_Ptr(idx)
        j = 0
        WhileLoop LessThan(j, WinViewConst.ENTRY_SIZE) {
            SetByte(buf, j, GetByte(src, j))
            j = Add(j, 1)
        }
        ReturnValue(buf)
    }
}

Function.WinView_Restore {
    Input: idx: Integer
    Input: buf: Integer
    Body: {
        DebugLog_Push("wm.vrs", 6)
        dst = WinView_Ptr(idx)
        j = 0
        WhileLoop LessThan(j, WinViewConst.ENTRY_SIZE) {
            SetByte(dst, j, GetByte(buf, j))
            j = Add(j, 1)
        }
        Deallocate(buf, WinViewConst.ENTRY_SIZE)
    }
}


// =============================================================================
// WINDOW LIFECYCLE
// =============================================================================
Function.Win_Create {
    Input:  canvas_w: Integer
    Input:  canvas_h: Integer
    Input:  color:    Integer
    Input:  title:    Integer
    Output: Integer
    Body: {
        DebugLog_Push("win.cr", 6)
        // Find a free slot (scan inactive slots, or extend high-water mark)
        idx = -1
        ci = 1
        WhileLoop LessThan(ci, FloatTable.count) {
            active = Win_IsActive(ci)
            IfCondition EqualTo(active, 0) ThenBlock: {
                IfCondition LessThan(idx, 0) ThenBlock: { idx = ci }
            }
            ci = Add(ci, 1)
        }
        IfCondition LessThan(idx, 0) ThenBlock: {
            IfCondition GreaterEqual(FloatTable.count, FloatEntryConst.MAX_FLOATING) ThenBlock: {
                PrintMessage("[Win] ERROR: max windows\n")
                ReturnValue(-1)
            }
            idx = FloatTable.count
            FloatTable.count = Add(FloatTable.count, 1)
        }

        bw = DecorConfig.border_w
        total_w = Add(canvas_w, Multiply(bw, 2))
        total_h = Add(canvas_h, Multiply(bw, 2))

        sw = Compositor.screen_w
        sh = Compositor.screen_h
        fx = Divide(Subtract(sw, total_w), 2)
        fy = Divide(Subtract(sh, total_h), 2)

        // Write float entry directly at idx
        fptr = Float_EntryPtr(idx)
        StoreValue(Add(fptr, FloatEntryFields.SURFACE),  0)
        StoreValue(Add(fptr, FloatEntryFields.X),        fx)
        StoreValue(Add(fptr, FloatEntryFields.Y),        fy)
        StoreValue(Add(fptr, FloatEntryFields.W),        total_w)
        StoreValue(Add(fptr, FloatEntryFields.H),        total_h)
        StoreValue(Add(fptr, FloatEntryFields.Z_ORDER),  0)
        StoreValue(Add(fptr, FloatEntryFields.DRAGGING), 0)

        Win_SetGeom(idx, fx, fy, total_w, total_h)

        cw = Win_GetCanvasW(idx)
        ch = Win_GetCanvasH(idx)

        tbh = DecorConfig.header_h
        DebugLog_Push("wm.cr.1", 7)
        hdr_surf = Surface_Create(SurfaceFormat.PIXEL_32, Win_GetTotalW(idx), tbh)
        DebugLog_Push("wm.cr.2", 7)
        IfCondition EqualTo(hdr_surf, 0) ThenBlock: {
            PrintMessage("[Win] ERROR: header surface\n")
            ReturnValue(-1)
        }
        DebugLog_Push("wm.cr.3", 7)
        Draw_Pix_FillRect(hdr_surf, 0, 0, Win_GetTotalW(idx), tbh, 0xFF222222)
        DebugLog_Push("wm.cr.4", 7)

        bg = color
        IfCondition LessThan(color, 0) ThenBlock: { bg = WinColor.WINDOW }
        DebugLog_Push("wm.cr.5", 7)
        content_surf = Surface_Create(SurfaceFormat.PIXEL_32, cw, ch)
        DebugLog_Push("wm.cr.6", 7)
        IfCondition EqualTo(content_surf, 0) ThenBlock: {
            DebugLog_Push("wm.cr.7", 7)
            Surface_Destroy(hdr_surf)
            DebugLog_Push("wm.cr.8", 7)
            PrintMessage("[Win] ERROR: content surface\n")
            ReturnValue(-1)
        }
        DebugLog_Push("wm.cr.9", 7)
        Draw_Pix_FillRect(content_surf, 0, 0, cw, ch, bg)
        DebugLog_Push("wm.cr.a", 7)

        StoreValue(Add(fptr, FloatEntryFields.SURFACE), content_surf)

        WinMgr_SetHdr(idx, hdr_surf)
        WinMgr_SetContent(idx, content_surf)
        WinMgr_SetTB(idx, -1)
        WinMgr_SetTitle(idx, title)
        WinMgr_SetToolbar(idx, -1)
        WinMgr_SetToolbarH(idx, 0)
        WinMgr_SetAddr(idx, -1)
        WinMgr_SetAddrH(idx, 0)
        WinMgr_SetAddrCtx(idx, 0)
        WinMgr.count = Add(WinMgr.count, 1)

        // Append to z_order
        zp = WinMgr.z_count
        WinMgr_ZSet(zp, idx)
        WinMgr.z_count = Add(zp, 1)

        Win_DrawTabBar(idx)

        PrintMessage("[Win] created idx=")
        PrintNumber(idx)
        PrintMessage(" canvas=")
        PrintNumber(cw)
        PrintMessage("x")
        PrintNumber(ch)
        PrintMessage("\n")

        DeskbarState.needs_refresh = 1
        ReturnValue(idx)
    }
}

Function.Win_Close {
    Input:  idx: Integer
    Output: Integer
    Body: {
        DebugLog_Push("win.cls", 7)
        IfCondition EqualTo(idx, 0)        ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(idx, 0)       ThenBlock: { ReturnValue(0) }
        cnt = FloatTable.count
        IfCondition GreaterEqual(idx, cnt) ThenBlock: { ReturnValue(0) }

        active = Win_IsActive(idx)
        IfCondition EqualTo(active, 0) ThenBlock: { ReturnValue(0) }

        // Notify IPC client before destroying the window
        job = WinView_GetJobPtr(idx)
        IfCondition GreaterThan(job, 0) ThenBlock: {
            IPCBroker_NotifyWindowClosed(job, idx)
        }

        hdr_surf     = WinMgr_GetHdr(idx)
        content_surf = WinMgr_GetContent(idx)
        toolbar_surf = WinMgr_GetToolbar(idx)
        DebugLog_Push("wm.cls.1", 8)
        IfCondition GreaterEqual(hdr_surf, 0)     ThenBlock: { Surface_Destroy(hdr_surf) }
        IfCondition GreaterEqual(content_surf, 0) ThenBlock: { Surface_Destroy(content_surf) }
        IfCondition GreaterEqual(toolbar_surf, 0) ThenBlock: { Surface_Destroy(toolbar_surf) }
        addr_surf = WinMgr_GetAddr(idx)
        IfCondition GreaterEqual(addr_surf, 0) ThenBlock: { Surface_Destroy(addr_surf) }
        DebugLog_Push("wm.cls.2", 8)

        toolbar_ctx = WinMgr_GetToolbarCtx(idx)
        DebugLog_Push("wm.cls.3", 8)
        IfCondition NotEqual(toolbar_ctx, 0) ThenBlock: { AK_DestroyContext(toolbar_ctx) }
        addr_ctx = WinMgr_GetAddrCtx(idx)
        IfCondition NotEqual(addr_ctx, 0) ThenBlock: { AK_DestroyContext(addr_ctx) }
        DebugLog_Push("wm.cls.4", 8)

        WinView_Clear(idx)
        WinMgr_SetFlags(idx, 0)

        // Mark slot free — DO NOT compact
        WinMgr_SetHdr(idx,         -1)
        WinMgr_SetContent(idx,     -1)
        WinMgr_SetTB(idx,          -1)
        WinMgr_SetTitle(idx,        0)
        WinMgr_SetToolbar(idx,     -1)
        WinMgr_SetToolbarH(idx,     0)
        WinMgr_SetToolbarCtx(idx,   0)
        WinMgr_SetAddr(idx,        -1)
        WinMgr_SetAddrH(idx,        0)
        WinMgr_SetAddrCtx(idx,      0)

        // Zero float entry in place
        Float_Remove(idx)

        // Zero geometry for this slot
        gp = Win_GeomPtr(idx)
        gj = 0
        WhileLoop LessThan(gj, WinGeomConst.ENTRY_SIZE) {
            SetByte(gp, gj, 0)
            gj = Add(gj, 1)
        }

        // Remove idx from z_order, shift remainder down
        found = -1
        zi = 0
        WhileLoop LessThan(zi, WinMgr.z_count) {
            v = WinMgr_ZGet(zi)
            IfCondition EqualTo(v, idx) ThenBlock: { found = zi }
            zi = Add(zi, 1)
        }
        IfCondition GreaterEqual(found, 0) ThenBlock: {
            zj = found
            zlast = Subtract(WinMgr.z_count, 1)
            WhileLoop LessThan(zj, zlast) {
                znext = Add(zj, 1)
                WinMgr_ZSet(zj, WinMgr_ZGet(znext))
                zj = Add(zj, 1)
            }
            WinMgr_ZSet(zlast, -1)
            WinMgr.z_count = Subtract(WinMgr.z_count, 1)
        }

        // Refocus: top of z_order, or 0 (desktop) if no windows left
        IfCondition GreaterThan(WinMgr.z_count, 0) ThenBlock: {
            new_top = WinMgr_ZGet(Subtract(WinMgr.z_count, 1))
            WinMgr.focused = new_top
        } ElseBlock: {
            WinMgr.focused = 0
        }

        WinMgr.count = Subtract(WinMgr.count, 1)
        DeskbarState.needs_refresh = 1
        ReturnValue(1)
    }
}

Function.Win_Focus {
    Input:  idx: Integer
    Output: Integer
    Body: {
        DebugLog_Push("win.foc", 7)
        IfCondition EqualTo(idx, 0) ThenBlock: {
            WinMgr.focused = 0
            ReturnValue(1)
        }
        active = Win_IsActive(idx)
        IfCondition EqualTo(active, 0) ThenBlock: { ReturnValue(0) }

        // Find idx in z_order
        found = -1
        i = 0
        WhileLoop LessThan(i, WinMgr.z_count) {
            v = WinMgr_ZGet(i)
            IfCondition EqualTo(v, idx) ThenBlock: { found = i }
            i = Add(i, 1)
        }
        DebugLog_Push("wm.foc.1", 8)
        IfCondition LessThan(found, 0) ThenBlock: {
            // Not in z_order — recover gracefully
            zp = WinMgr.z_count
            WinMgr_ZSet(zp, idx)
            WinMgr.z_count = Add(zp, 1)
            WinMgr.focused = idx
            DeskbarState.needs_refresh = 1
            ReturnValue(1)
        }

        // Shift entries [found+1 .. z_count-1] down by 1, append idx at end
        j = found
        last = Subtract(WinMgr.z_count, 1)
        WhileLoop LessThan(j, last) {
            next = Add(j, 1)
            WinMgr_ZSet(j, WinMgr_ZGet(next))
            j = Add(j, 1)
        }
        WinMgr_ZSet(last, idx)
        DebugLog_Push("wm.foc.2", 8)
        WinMgr.focused = idx
        DeskbarState.needs_refresh = 1
        ReturnValue(1)
    }
}


// =============================================================================
// WINDOW FLAGS — minimize/maximize state
// =============================================================================
Function.WinMgr_GetFlags {
    Input: idx: Integer
    Output: Integer
    Body: {
        off = Multiply(idx, 8)
        ReturnValue(Dereference(Add(WinMgr.flags_data, off)))
    }
}

Function.WinMgr_SetFlags {
    Input: idx: Integer
    Input: val: Integer
    Body: {
        off = Multiply(idx, 8)
        StoreValue(Add(WinMgr.flags_data, off), val)
    }
}

// =============================================================================
// WIN_MINIMIZE — hide window, focus next visible
// =============================================================================
Function.Win_Minimize {
    Input: idx: Integer
    Body: {
        DebugLog_Push("win.min", 7)
        IfCondition LessEqual(idx, 0) ThenBlock: { ReturnValue(0) }
        flags = WinMgr_GetFlags(idx)
        new_flags = BitwiseOr(flags, WinFlags.MINIMIZED)
        WinMgr_SetFlags(idx, new_flags)

        // Focus next visible window (walk z_order from top)
        IfCondition EqualTo(WinMgr.focused, idx) ThenBlock: {
            new_focus = 0
            fzi = Subtract(WinMgr.z_count, 1)
            WhileLoop GreaterEqual(fzi, 0) {
                fv = WinMgr_ZGet(fzi)
                IfCondition GreaterThan(fv, 0) ThenBlock: {
                    IfCondition NotEqual(fv, idx) ThenBlock: {
                        ff = WinMgr_GetFlags(fv)
                        IfCondition EqualTo(BitwiseAnd(ff, WinFlags.MINIMIZED), 0) ThenBlock: {
                            new_focus = fv
                            fzi = -1
                        }
                    }
                }
                fzi = Subtract(fzi, 1)
            }
            WinMgr.focused = new_focus
        }
        DeskbarState.needs_refresh = 1
        SysDisplayState.dirty = 1
        PrintMessage("[WinMgr] minimize win=")
        PrintNumber(idx)
        PrintMessage("\n")
    }
}

// =============================================================================
// WIN_RESTORE — clear minimized flag, refocus
// =============================================================================
Function.Win_Restore {
    Input: idx: Integer
    Body: {
        DebugLog_Push("win.rst", 7)
        IfCondition LessEqual(idx, 0) ThenBlock: { ReturnValue(0) }
        flags = WinMgr_GetFlags(idx)
        new_flags = BitwiseAnd(flags, BitwiseNot(WinFlags.MINIMIZED))
        WinMgr_SetFlags(idx, new_flags)
        Win_Focus(idx)
        DeskbarState.needs_refresh = 1
        SysDisplayState.dirty = 1
        PrintMessage("[WinMgr] restore win=")
        PrintNumber(idx)
        PrintMessage("\n")
    }
}

// =============================================================================
// MAXIMIZE GEOMETRY — save/restore pre-maximize geometry
// =============================================================================
Function.WinMaxGeom_Ptr {
    Input: idx: Integer
    Output: Integer
    Body: {
        ReturnValue(Add(WinMgr.maxgeom_data, Multiply(idx, 32)))
    }
}

// =============================================================================
// WIN_MAXIMIZE — toggle maximize: fill screen or restore
// =============================================================================
Function.Win_Maximize {
    Input: idx: Integer
    Body: {
        DebugLog_Push("win.max", 7)
        IfCondition LessEqual(idx, 0) ThenBlock: { ReturnValue(0) }
        flags = WinMgr_GetFlags(idx)

        // Toggle: if already maximized, restore
        IfCondition NotEqual(BitwiseAnd(flags, WinFlags.MAXIMIZED), 0) ThenBlock: {
            Win_MaxRestore(idx)
            ReturnValue(0)
        }

        // Save pre-maximize geometry
        gp = WinMaxGeom_Ptr(idx)
        StoreValue(Add(gp, 0),  Win_GetX(idx))
        StoreValue(Add(gp, 8),  Win_GetY(idx))
        StoreValue(Add(gp, 16), Win_GetTotalW(idx))
        StoreValue(Add(gp, 24), Win_GetTotalH(idx))

        // Set MAXIMIZED flag, clear MINIMIZED
        new_flags = BitwiseOr(BitwiseAnd(flags, BitwiseNot(WinFlags.MINIMIZED)), WinFlags.MAXIMIZED)
        WinMgr_SetFlags(idx, new_flags)

        // Compute maximized geometry
        sw = FB_GetWidth()
        sh = FB_GetHeight()
        tbh = Win_GetTabBarH_FromStack(idx)
        toolbar_h = WinMgr_GetToolbarH(idx)
        chrome_top = Add(tbh, toolbar_h)
        deskbar_hz = UIScale.deskbar_hotzone

        // x=0, y=chrome_top (so tab starts at pixel 0)
        // total_h = screen_h - chrome_top - deskbar_hotzone
        max_w = sw
        max_h = Subtract(Subtract(sh, chrome_top), deskbar_hz)
        Win_SetGeom(idx, 0, chrome_top, max_w, max_h)

        // Recreate surfaces
        Win_ResizeSurfaces(idx)

        Win_Focus(idx)
        DeskbarState.needs_refresh = 1
        SysDisplayState.dirty = 1
        PrintMessage("[WinMgr] maximize win=")
        PrintNumber(idx)
        PrintMessage("\n")
    }
}

// =============================================================================
// WIN_MAXRESTORE — restore pre-maximize geometry
// =============================================================================
Function.Win_MaxRestore {
    Input: idx: Integer
    Body: {
        DebugLog_Push("wm.mxr", 7)
        IfCondition LessEqual(idx, 0) ThenBlock: { ReturnValue(0) }
        flags = WinMgr_GetFlags(idx)
        new_flags = BitwiseAnd(flags, BitwiseNot(WinFlags.MAXIMIZED))
        WinMgr_SetFlags(idx, new_flags)

        // Restore saved geometry
        gp = WinMaxGeom_Ptr(idx)
        old_x  = Dereference(Add(gp, 0))
        old_y  = Dereference(Add(gp, 8))
        old_tw = Dereference(Add(gp, 16))
        old_th = Dereference(Add(gp, 24))
        Win_SetGeom(idx, old_x, old_y, old_tw, old_th)

        // Recreate surfaces
        Win_ResizeSurfaces(idx)

        DeskbarState.needs_refresh = 1
        SysDisplayState.dirty = 1
        PrintMessage("[WinMgr] restore-max win=")
        PrintNumber(idx)
        PrintMessage("\n")
    }
}

// =============================================================================
// WIN_RESIZESURFACES — recreate header, content, toolbar surfaces
// Call after Win_SetGeom to rebuild surfaces matching current geometry.
// =============================================================================
Function.Win_ResizeSurfaces {
    Input: idx: Integer
    Body: {
        DebugLog_Push("wm.rsz", 7)
        canvas_w = Win_GetCanvasW(idx)
        canvas_h = Win_GetCanvasH(idx)
        total_w  = Win_GetTotalW(idx)

        old_hdr     = WinMgr_GetHdr(idx)
        old_content = WinMgr_GetContent(idx)

        // Sample bg from old content
        bg = WinColor.WINDOW
        IfCondition GreaterEqual(old_content, 0) ThenBlock: {
            bg = Dereference(Surface_GetData(old_content))
        }

        // New header surface
        tbh = Win_GetTabBarH_FromStack(idx)
        new_hdr = Surface_Create(SurfaceFormat.PIXEL_32, total_w, tbh)
        Draw_Pix_FillRect(new_hdr, 0, 0, total_w, tbh, 0xFF222222)

        // New content surface
        new_content = Surface_Create(SurfaceFormat.PIXEL_32, canvas_w, canvas_h)
        Draw_Pix_FillRect(new_content, 0, 0, canvas_w, canvas_h, bg)

        // Preserve content
        IfCondition GreaterEqual(old_content, 0) ThenBlock: {
            Surface_BlitOpaque(new_content, old_content, 0, 0)
        }

        WinMgr_SetHdr(idx, new_hdr)
        WinMgr_SetContent(idx, new_content)

        fptr = Float_EntryPtr(idx)
        StoreValue(Add(fptr, FloatEntryFields.SURFACE), new_content)

        // Destroy old surfaces
        IfCondition GreaterEqual(old_hdr, 0) ThenBlock: { Surface_Destroy(old_hdr) }
        IfCondition GreaterEqual(old_content, 0) ThenBlock: { Surface_Destroy(old_content) }

        WinMgr_SetTB(idx, -1)
        Win_DrawTabBar(idx)

        // Recreate toolbar surface
        Win_ResizeToolbar(idx)

        // Re-layout AppHost content at new size
        content_ctx = WinView_GetContentCtx(idx)
        IfCondition GreaterThan(content_ctx, 0) ThenBlock: {
            AK_SetDesignW(content_ctx, canvas_w)
            AK_SetDesignH(content_ctx, canvas_h)
            AK_Draw(content_ctx, new_content, canvas_w, canvas_h)
        }
    }
}

// =============================================================================
// WIN_RESIZETOOLBAR — recreate toolbar surface for current geometry
// =============================================================================
Function.Win_ResizeToolbar {
    Input: idx: Integer
    Body: {
        DebugLog_Push("wm.rtb", 7)
        old_tb = WinMgr_GetToolbar(idx)
        tb_h = WinMgr_GetToolbarH(idx)
        IfCondition GreaterThan(tb_h, 0) ThenBlock: {
            tw = Win_GetTotalW(idx)
            new_tb = Surface_Create(SurfaceFormat.PIXEL_32, tw, tb_h)
            IfCondition GreaterThan(new_tb, 0) ThenBlock: {
                Draw_Pix_FillRect(new_tb, 0, 0, tw, tb_h, 0xFF2A2A2A)
                WinMgr_SetToolbar(idx, new_tb)
                IfCondition GreaterEqual(old_tb, 0) ThenBlock: {
                    Surface_Destroy(old_tb)
                }
                ak_ctx = WinMgr_GetToolbarCtx(idx)
                IfCondition NotEqual(ak_ctx, 0) ThenBlock: {
                    AK_FreeContextTR(ak_ctx)
                }
                Win_RedrawToolbar(idx)
            }
        }
    }
}

// =============================================================================
// TOOLBAR CREATION — delegated to Library.WinToolbar.ailang (AKSlot-based)
// Old AKCtx-based Win_CreateToolbar/Win_CreateToolbarDefault/Win_BuildDefaultToolbar
// /Win_RedrawToolbar removed — they stored an AKCtx pointer where the new
// Win_ToolbarEvent expects an AKSlot index, causing a hang on first click.
// =============================================================================


// =============================================================================
// DEBUG HELPERS
// =============================================================================
Function.Win_DebugPrint {
    Input: msg: Integer
    Body: {
        DebugLog_Push("wm.dbp", 6)
        PrintMessage("[W] ")
        PrintMessage(msg)
        PrintMessage("\n")
        ReturnValue(0)
    }
}

Function.Win_DebugNum {
    Input: msg: Integer
    Input: val: Integer
    Body: {
        DebugLog_Push("wm.dbn", 6)
        PrintMessage("[W] ")
        PrintMessage(msg)
        PrintNumber(val)
        PrintMessage("\n")
        ReturnValue(0)
    }
}