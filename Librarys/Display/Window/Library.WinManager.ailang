Function.Win_IsActive {
    Input:  idx: Integer
    Output: Integer
    Body: {
        DebugLog_Push("wm.act", 6)
        IfCondition LessThan(idx, 0) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterEqual(idx, FloatTable.count) ThenBlock: { ReturnValue(0) }
        h = WinMgr_GetHdr(idx)
        c = WinMgr_GetContent(idx)
        // Desktop (idx 0) has hdr=-1 but content>=0, so check content too
        IfCondition And(LessThan(h, 0), LessThan(c, 0)) ThenBlock: { ReturnValue(0) }
        ReturnValue(1)
    }
}


// =============================================================================
// WINVIEW
// =============================================================================
Function.WinView_Init {
    Output: Integer
    Body: {
        DebugLog_Push("wm.vi", 5)
        sz = Multiply(WinViewConst.MAX, WinViewConst.ENTRY_SIZE)
        DebugLog_Push("wm.vi.1", 7)
        buf = Allocate(sz)
        DebugLog_Push("wm.vi.2", 7)
        IfCondition EqualTo(buf, 0) ThenBlock: {
            PrintMessage("[WinView] alloc fail\n")
            ReturnValue(0)
        }

        i = 0
        WhileLoop LessThan(i, sz) {
            SetByte(buf, i, 0)
            i = Add(i, 1)
        }

        s = 0
        WhileLoop LessThan(s, WinViewConst.MAX) {
            base = Add(buf, Multiply(s, WinViewConst.ENTRY_SIZE))
            StoreValue(Add(base, WinViewFields.JOB_PTR),       0)
            StoreValue(Add(base, WinViewFields.SERVICE_ID),    -1)
            StoreValue(Add(base, WinViewFields.BINDINGS),       0)
            StoreValue(Add(base, WinViewFields.BINDING_COUNT),  0)
            StoreValue(Add(base, WinViewFields.VIEW_TYPE),      0)
            StoreValue(Add(base, WinViewFields.DOC_HANDLE),    -1)
            StoreValue(Add(base, WinViewFields.PAGE_HANDLE),   -1)
            StoreValue(Add(base, WinViewFields.CONTENT_CTX),    0)
            s = Add(s, 1)
        }

        WinViewTable.data = buf
        PrintMessage("[WinView] initialized\n")
        ReturnValue(1)
    }
}

Function.WinView_Ptr {
    Input: idx: Integer
    Output: Integer
    Body: {
        DebugLog_Push("wm.vp", 5)
        ReturnValue(Add(WinViewTable.data, Multiply(idx, WinViewConst.ENTRY_SIZE)))
    }
}

