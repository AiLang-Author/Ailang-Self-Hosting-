// =============================================================================
// WIN_BLITALL — reads geometry from WinGeom, not FloatEntry, not surface header
// =============================================================================
Function.Win_BlitAll {
    Output: Integer
    Body: {
        DebugLog_Push("win.blt", 7)
        bw  = DecorConfig.border_w
        zi  = 0
        DebugLog_Push("wr.blt.1", 8)
        WhileLoop LessThan(zi, WinMgr.z_count) {
            i = WinMgr_ZGet(zi)
            IfCondition LessThan(i, 0) ThenBlock: {
                zi = Add(zi, 1)
            } ElseBlock: {

            // Skip minimized windows and shell strips (deskbar hosts those)
            wflags = WinMgr_GetFlags(i)
            IfCondition NotEqual(BitwiseAnd(wflags, WinFlags.MINIMIZED), 0) ThenBlock: {
                zi = Add(zi, 1)
            } ElseBlock: {
            IfCondition NotEqual(BitwiseAnd(wflags, WinFlags.SHELL), 0) ThenBlock: {
                zi = Add(zi, 1)
            } ElseBlock: {
            DebugLog_Push("wr.blt.2", 8)

            x        = Win_GetX(i)
            y        = Win_GetY(i)
            total_w  = Win_GetTotalW(i)
            total_h  = Win_GetTotalH(i)
            canvas_w = Win_GetCanvasW(i)
            canvas_h = Win_GetCanvasH(i)

            hdr_surf     = WinMgr_GetHdr(i)
            content_surf = WinMgr_GetContent(i)

            // Canvas override: use shared memory surface if attached
            IfCondition EqualTo(Canvas_GetActive(i), 1) ThenBlock: {
                content_surf = Canvas_GetSurf(i)
            }

            // Desktop (i==0): blit content at origin, no header, no border
            IfCondition EqualTo(i, 0) ThenBlock: {
                IfCondition GreaterEqual(content_surf, 0) ThenBlock: {
                    Win_BlitOne(content_surf, x, y)
                }
            } ElseBlock: {
                tbh       = Win_GetTabBarH_FromStack(i)
                toolbar_h = WinMgr_GetToolbarH(i)
                addr_h    = WinMgr_GetAddrH(i)

                // Tab bar — welded above addr bar + toolbar + box, full width
                IfCondition GreaterEqual(hdr_surf, 0) ThenBlock: {
                    Win_BlitOne(hdr_surf, x, Subtract(Subtract(Subtract(y, tbh), toolbar_h), addr_h))
                }

                // Address bar — between tab bar and toolbar
                addr_surf = WinMgr_GetAddr(i)
                IfCondition GreaterEqual(addr_surf, 0) ThenBlock: {
                    Win_BlitOne(addr_surf, x, Subtract(Subtract(y, toolbar_h), addr_h))
                }

                // Toolbar — between addr bar and box, full width
                toolbar_surf = WinMgr_GetToolbar(i)
                IfCondition GreaterEqual(toolbar_surf, 0) ThenBlock: {
                    Win_BlitOne(toolbar_surf, x, Subtract(y, toolbar_h))
                }

                // Content — inside box
                IfCondition GreaterEqual(content_surf, 0) ThenBlock: {
                    Win_BlitOne(content_surf, Add(x, bw), Add(y, bw))
                }

                // Border — the box itself
                Win_DrawBorderFB(x, y, total_w, total_h)
            }

            zi = Add(zi, 1)
            } // end SHELL ElseBlock
            } // end minimized ElseBlock
            } // end i >= 0 ElseBlock
        }
// Deskbar — always draw hotzone, draw surface if visible
        DebugLog_Push("wr.blt.3", 8)
        Deskbar_DrawHotzone()
        DebugLog_Push("wr.blt.4", 8)
        Deskbar_Draw()

        // Start Menu overlay — above deskbar, below menus
        StartMenu_Blit()

        // Cascade submenu overlay — above start menu, below dropdown menus
        CascadeMenu_Blit()

        // Menu overlay — drawn on top of everything except cursor
        DebugLog_Push("wr.blt.5", 8)
        Menu_Blit()

        // Context menu — drawn on top of dropdown menus
        ContextMenu_Blit()

        // Debug overlay — blit debug surface to framebuffer at (10, 140)
        IfCondition EqualTo(DebugLog.enabled, 1) ThenBlock: {
            dbg_s = SysDisplayState.dbg_surf
            IfCondition NotEqual(dbg_s, 0) ThenBlock: {
                Win_BlitOne(dbg_s, UIScale.debug_overlay_x, UIScale.debug_overlay_y)
            }
        }

        DebugLog_Push("wr.blt.6", 8)
        Cursor_Draw()
        DebugLog_Push("wr.blt.7", 8)
        FB_FlipFast()
        ReturnValue(0)
    }
}


// =============================================================================
// WIN_BLITONE — blit surface to framebuffer at (dst_x, dst_y)
// =============================================================================
Function.Win_BlitOne {
    Input: surf:  Integer
    Input: dst_x: Integer
    Input: dst_y: Integer
    Output: Integer
    Body: {
        DebugLog_Push("win.bl1", 7)
        sw        = Surface_GetWidth(surf)
        sh        = Surface_GetHeight(surf)
        src_data  = Surface_GetData(surf)
        src_pitch = Surface_GetPitch(surf)
        dst_buf   = FB_GetDrawBuffer()
        dst_pitch = FB.pitch
        fb_w      = FB_GetWidth()
        fb_h      = FB_GetHeight()
        pb        = SurfaceConst.PIXEL_BYTES

        // Clamp source rect to framebuffer bounds
        src_x0 = 0
        src_y0 = 0
        draw_w = sw
        draw_h = sh

        // Left edge: if dst_x < 0, skip leading source columns
        IfCondition LessThan(dst_x, 0) ThenBlock: {
            src_x0 = Subtract(0, dst_x)
            draw_w = Subtract(sw, src_x0)
            dst_x  = 0
        }
        // Top edge: if dst_y < 0, skip leading source rows
        IfCondition LessThan(dst_y, 0) ThenBlock: {
            src_y0 = Subtract(0, dst_y)
            draw_h = Subtract(sh, src_y0)
            dst_y  = 0
        }
        // Right edge: clamp width to framebuffer
        ovr_x = Subtract(Add(dst_x, draw_w), fb_w)
        IfCondition GreaterThan(ovr_x, 0) ThenBlock: {
            draw_w = Subtract(draw_w, ovr_x)
        }
        // Bottom edge: clamp height to framebuffer
        ovr_y = Subtract(Add(dst_y, draw_h), fb_h)
        IfCondition GreaterThan(ovr_y, 0) ThenBlock: {
            draw_h = Subtract(draw_h, ovr_y)
        }

        // Nothing visible after clamping
        IfCondition LessEqual(draw_w, 0) ThenBlock: { ReturnValue(0) }
        IfCondition LessEqual(draw_h, 0) ThenBlock: { ReturnValue(0) }

        row_bytes = Multiply(draw_w, pb)
        dst_x_off = Multiply(dst_x, pb)
        src_x_off = Multiply(src_x0, pb)
        y = 0
        WhileLoop LessThan(y, draw_h) {
            sry = Add(y, src_y0)
            dry = Add(y, dst_y)
            sr_off = Add(Multiply(sry, src_pitch), src_x_off)
            src_row = Add(src_data, sr_off)
            dr_off = Add(Multiply(dry, dst_pitch), dst_x_off)
            dst_row = Add(dst_buf, dr_off)
            MemoryCopy(dst_row, src_row, row_bytes)
            y = Add(y, 1)
        }
        ReturnValue(1)
    }
}


// =============================================================================
// WIN_BLITCLAMPED — blit surface clipped to clip_w x clip_h
// =============================================================================
Function.Win_BlitClamped {
    Input: surf:   Integer
    Input: dst_x:  Integer
    Input: dst_y:  Integer
    Input: clip_w: Integer
    Input: clip_h: Integer
    Output: Integer
    Body: {
        DebugLog_Push("wr.blc", 6)
        sw        = Surface_GetWidth(surf)
        sh        = Surface_GetHeight(surf)
        src_data  = Surface_GetData(surf)
        src_pitch = Surface_GetPitch(surf)
        dst_buf   = FB_GetDrawBuffer()
        dst_pitch = FB.pitch
        fb_w      = FB_GetWidth()
        fb_h      = FB_GetHeight()
        pb        = SurfaceConst.PIXEL_BYTES

        draw_w = sw
        draw_h = sh
        IfCondition LessThan(clip_w, sw) ThenBlock: { draw_w = clip_w }
        IfCondition LessThan(clip_h, sh) ThenBlock: { draw_h = clip_h }

        // Clamp to framebuffer bounds
        src_x0 = 0
        src_y0 = 0
        IfCondition LessThan(dst_x, 0) ThenBlock: {
            src_x0 = Subtract(0, dst_x)
            draw_w = Subtract(draw_w, src_x0)
            dst_x  = 0
        }
        IfCondition LessThan(dst_y, 0) ThenBlock: {
            src_y0 = Subtract(0, dst_y)
            draw_h = Subtract(draw_h, src_y0)
            dst_y  = 0
        }
        ovr_x = Subtract(Add(dst_x, draw_w), fb_w)
        IfCondition GreaterThan(ovr_x, 0) ThenBlock: {
            draw_w = Subtract(draw_w, ovr_x)
        }
        ovr_y = Subtract(Add(dst_y, draw_h), fb_h)
        IfCondition GreaterThan(ovr_y, 0) ThenBlock: {
            draw_h = Subtract(draw_h, ovr_y)
        }

        IfCondition LessEqual(draw_w, 0) ThenBlock: { ReturnValue(0) }
        IfCondition LessEqual(draw_h, 0) ThenBlock: { ReturnValue(0) }

        row_bytes = Multiply(draw_w, pb)
        dst_x_off = Multiply(dst_x, pb)
        src_x_off = Multiply(src_x0, pb)
        y = 0
        WhileLoop LessThan(y, draw_h) {
            sry = Add(y, src_y0)
            dry = Add(y, dst_y)
            sr_off = Add(Multiply(sry, src_pitch), src_x_off)
            src_row = Add(src_data, sr_off)
            dr_off = Add(Multiply(dry, dst_pitch), dst_x_off)
            dst_row = Add(dst_buf, dr_off)
            MemoryCopy(dst_row, src_row, row_bytes)
            y = Add(y, 1)
        }
        ReturnValue(1)
    }
}


// =============================================================================
// WIN_DRAWBORDERFB — draw border rect directly to framebuffer
// =============================================================================
Function.Win_DrawBorderFB {
    Input: x: Integer
    Input: y: Integer
    Input: w: Integer
    Input: h: Integer
    Output: Integer
    Body: {
        DebugLog_Push("wr.bdr", 6)
        bw  = DecorConfig.border_w
        buf = FB_GetDrawBuffer()
        pit = FB.pitch
        pb  = SurfaceConst.PIXEL_BYTES
        fb_w = FB_GetWidth()
        fb_h = FB_GetHeight()
        col = WinColor.BORDER

        // Clamp draw region to framebuffer
        x0 = x
        y0 = y
        x1 = Add(x, w)
        y1 = Add(y, h)
        IfCondition LessThan(x0, 0)       ThenBlock: { x0 = 0 }
        IfCondition LessThan(y0, 0)       ThenBlock: { y0 = 0 }
        IfCondition GreaterThan(x1, fb_w) ThenBlock: { x1 = fb_w }
        IfCondition GreaterThan(y1, fb_h) ThenBlock: { y1 = fb_h }
        IfCondition GreaterEqual(x0, x1)  ThenBlock: { ReturnValue(0) }
        IfCondition GreaterEqual(y0, y1)  ThenBlock: { ReturnValue(0) }

        row_px = Subtract(x1, x0)
        row_bytes = Multiply(row_px, pb)

        // — Top strip: rows y..y+bw-1, clamped —
        ty0 = y
        ty1 = Add(y, bw)
        IfCondition LessThan(ty0, y0) ThenBlock: { ty0 = y0 }
        IfCondition GreaterThan(ty1, y1) ThenBlock: { ty1 = y1 }
        IfCondition LessThan(ty0, ty1) ThenBlock: {
            // Fill first row with dword StoreValue
            first_addr = Add(buf, Add(Multiply(ty0, pit), Multiply(x0, pb)))
            ci = 0
            WhileLoop LessThan(ci, row_px) {
                StoreValue(Add(first_addr, Multiply(ci, pb)), col, "dword")
                ci = Add(ci, 1)
            }
            // MemoryCopy remaining rows from first row
            tr = Add(ty0, 1)
            WhileLoop LessThan(tr, ty1) {
                dst = Add(buf, Add(Multiply(tr, pit), Multiply(x0, pb)))
                MemoryCopy(dst, first_addr, row_bytes)
                tr = Add(tr, 1)
            }
        }

        // — Bottom strip: rows y+h-bw..y+h-1, clamped —
        by0 = Subtract(Add(y, h), bw)
        by1 = Add(y, h)
        IfCondition LessThan(by0, y0) ThenBlock: { by0 = y0 }
        IfCondition GreaterThan(by1, y1) ThenBlock: { by1 = y1 }
        IfCondition LessThan(by0, by1) ThenBlock: {
            first_addr = Add(buf, Add(Multiply(by0, pit), Multiply(x0, pb)))
            ci = 0
            WhileLoop LessThan(ci, row_px) {
                StoreValue(Add(first_addr, Multiply(ci, pb)), col, "dword")
                ci = Add(ci, 1)
            }
            br = Add(by0, 1)
            WhileLoop LessThan(br, by1) {
                dst = Add(buf, Add(Multiply(br, pit), Multiply(x0, pb)))
                MemoryCopy(dst, first_addr, row_bytes)
                br = Add(br, 1)
            }
        }

        // — Left strip: middle rows, cols x..x+bw-1, clamped —
        my0 = Add(y, bw)
        my1 = Subtract(Add(y, h), bw)
        IfCondition LessThan(my0, y0) ThenBlock: { my0 = y0 }
        IfCondition GreaterThan(my1, y1) ThenBlock: { my1 = y1 }
        lx0 = x
        lx1 = Add(x, bw)
        IfCondition LessThan(lx0, x0) ThenBlock: { lx0 = x0 }
        IfCondition GreaterThan(lx1, x1) ThenBlock: { lx1 = x1 }
        left_px = Subtract(lx1, lx0)
        IfCondition And(GreaterThan(left_px, 0), LessThan(my0, my1)) ThenBlock: {
            first_addr = Add(buf, Add(Multiply(my0, pit), Multiply(lx0, pb)))
            ci = 0
            WhileLoop LessThan(ci, left_px) {
                StoreValue(Add(first_addr, Multiply(ci, pb)), col, "dword")
                ci = Add(ci, 1)
            }
            left_bytes = Multiply(left_px, pb)
            lr = Add(my0, 1)
            WhileLoop LessThan(lr, my1) {
                dst = Add(buf, Add(Multiply(lr, pit), Multiply(lx0, pb)))
                MemoryCopy(dst, first_addr, left_bytes)
                lr = Add(lr, 1)
            }
        }

        // — Right strip: middle rows, cols x+w-bw..x+w-1, clamped —
        rx0 = Subtract(Add(x, w), bw)
        rx1 = Add(x, w)
        IfCondition LessThan(rx0, x0) ThenBlock: { rx0 = x0 }
        IfCondition GreaterThan(rx1, x1) ThenBlock: { rx1 = x1 }
        right_px = Subtract(rx1, rx0)
        IfCondition And(GreaterThan(right_px, 0), LessThan(my0, my1)) ThenBlock: {
            first_addr = Add(buf, Add(Multiply(my0, pit), Multiply(rx0, pb)))
            ci = 0
            WhileLoop LessThan(ci, right_px) {
                StoreValue(Add(first_addr, Multiply(ci, pb)), col, "dword")
                ci = Add(ci, 1)
            }
            right_bytes = Multiply(right_px, pb)
            rr = Add(my0, 1)
            WhileLoop LessThan(rr, my1) {
                dst = Add(buf, Add(Multiply(rr, pit), Multiply(rx0, pb)))
                MemoryCopy(dst, first_addr, right_bytes)
                rr = Add(rr, 1)
            }
        }

        ReturnValue(0)
    }
}


// =============================================================================
// WIN_DRAWHEADER — wrapper for Win_DrawTabBar
// =============================================================================
Function.Win_DrawHeader {
    Input: idx:   Integer
    Input: title: Integer
    Output: Integer
    Body: {
        DebugLog_Push("wr.hdr", 6)
        ReturnValue(Win_DrawTabBar(idx))
    }
}


// Monochrome TVG chrome. Shape lives in the pack; color comes from Theme
// at blit time (BlitTinted). Buttons are three layers: bg, border, glyph.
// A decorator restyle is a new chrome.vif + theme colors.
FixedPool.WinChrome {
    "titlebar":    Initialize=0, CanChange=True
    "tab_body":    Initialize=0, CanChange=True
    "tab_slant":   Initialize=0, CanChange=True
    "tab_lip":     Initialize=0, CanChange=True
    "btn_bg":      Initialize=0, CanChange=True
    "btn_border":  Initialize=0, CanChange=True
    "glyph_close":   Initialize=0, CanChange=True
    "glyph_rep":     Initialize=0, CanChange=True
    "glyph_expand":  Initialize=0, CanChange=True
    "glyph_compact": Initialize=0, CanChange=True
    "glyph_min":     Initialize=0, CanChange=True
    "chrome_dir":    Initialize=0, CanChange=True
    "path_buf":      Initialize=0, CanChange=True
    "blit_glyph":    Initialize=0, CanChange=True
    "label_buf":   Initialize=0, CanChange=True
    "label_len":   Initialize=0, CanChange=True
    "cap_mode":    Initialize=0, CanChange=True
    "box_color":   Initialize=0, CanChange=True
}

Function.WinChrome_Init {
    Body: {
        h = UIScale.tab_row_h
        IfCondition LessThan(h, 16) ThenBlock: { h = 16 }
        pad = UIScale.tab_pad
        btn = Subtract(h, Multiply(pad, 2))
        WinChrome.label_buf = Allocate(80)
        MemorySet(WinChrome.label_buf, 0, 80)
        WinChrome.chrome_dir = "/system/icons/chrome"
        WinChrome.path_buf = Allocate(96)
        MemorySet(WinChrome.path_buf, 0, 96)
        IfCondition LessThan(btn, 10) ThenBlock: { btn = 10 }

        WinChrome.titlebar    = VIcon_RasterNamed(IconTier.WIDGETS, "titlebar", h)
        WinChrome.tab_lip     = VIcon_RasterNamed(IconTier.WIDGETS, "tab_lip", h)
        WinChrome.btn_bg      = VIcon_RasterNamed(IconTier.WIDGETS, "btn_bg", btn)
        WinChrome.btn_border  = VIcon_RasterNamed(IconTier.WIDGETS, "btn_border", btn)
        WinChrome.glyph_close = VIcon_RasterNamed(IconTier.WIDGETS, "glyph_close", btn)
        WinChrome.glyph_rep   = VIcon_RasterNamed(IconTier.WIDGETS, "glyph_replicant", btn)

        body_w = Divide(h, 4)
        IfCondition LessThan(body_w, 4) ThenBlock: { body_w = 4 }
        slant_w = Divide(Multiply(h, TabConst.SLANT_NUM), TabConst.SLANT_DEN)
        IfCondition LessThan(slant_w, 8) ThenBlock: { slant_w = 8 }

        WinChrome.tab_body = StyleRaster_LoadEither("/system/icons/chrome/tab_body.svg", "/system/icons/chrome/tab_body.tvg", body_w, h)
        WinChrome.tab_slant = StyleRaster_LoadEither("/system/icons/chrome/tab_slant_r.svg", "/system/icons/chrome/tab_slant_r.tvg", slant_w, h)
        WinChrome_LoadToolbarGlyphs()

        PrintMessage("[WinChrome] svg/tvg body=")
        PrintNumber(WinChrome.tab_body)
        PrintMessage(" slant=")
        PrintNumber(WinChrome.tab_slant)
        PrintMessage(" slant_w=")
        PrintNumber(Surface_GetWidth(WinChrome.tab_slant))
        PrintMessage(" h=")
        PrintNumber(h)
        PrintMessage("\n")
        ReturnValue(1)
    }
}

// Theme chrome pack: {chrome_dir}/{name}.svg then .tvg. Size is already DPI-scaled.
Function.WinChrome_LoadNamed {
    Input: name: Address
    Input: sz: Integer
    Output: Integer
    Body: {
        dir = WinChrome.chrome_dir
        buf = WinChrome.path_buf
        IfCondition EqualTo(dir, 0) ThenBlock: { dir = "/system/icons/chrome" }
        IfCondition EqualTo(buf, 0) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(sz, 8) ThenBlock: { sz = 8 }
        dlen = StringLength(dir)
        nlen = StringLength(name)
        MemoryCopy(buf, dir, dlen)
        SetByte(buf, dlen, 47)
        MemoryCopy(Add(buf, Add(dlen, 1)), name, nlen)
        p = Add(Add(dlen, 1), nlen)
        SetByte(buf, p, 46)
        SetByte(buf, Add(p, 1), 115)
        SetByte(buf, Add(p, 2), 118)
        SetByte(buf, Add(p, 3), 103)
        SetByte(buf, Add(p, 4), 0)
        surf = StyleRaster_LoadFile(buf, sz)
        IfCondition NotEqual(surf, 0) ThenBlock: { ReturnValue(surf) }
        SetByte(buf, Add(p, 1), 116)
        SetByte(buf, Add(p, 2), 118)
        SetByte(buf, Add(p, 3), 103)
        ReturnValue(StyleRaster_LoadFile(buf, sz))
    }
}

Function.WinChrome_LoadToolbarGlyphs {
    Body: {
        gsz = Subtract(UIScale.toolbar_btn_h, Multiply(UIScale.toolbar_pad, 2))
        IfCondition LessThan(gsz, 8) ThenBlock: { gsz = 8 }
        WinChrome.glyph_expand  = WinChrome_LoadNamed("glyph_expand", gsz)
        WinChrome.glyph_compact = WinChrome_LoadNamed("glyph_compact", gsz)
        WinChrome.glyph_min     = WinChrome_LoadNamed("glyph_min", gsz)
        PrintMessage("[WinChrome] glyphs expand=")
        PrintNumber(WinChrome.glyph_expand)
        PrintMessage(" compact=")
        PrintNumber(WinChrome.glyph_compact)
        PrintMessage(" min=")
        PrintNumber(WinChrome.glyph_min)
        PrintMessage(" gsz=")
        PrintNumber(gsz)
        PrintMessage("\n")
        ReturnValue(1)
    }
}

Function.WinChrome_TileH {
    Input: dst: Integer
    Input: src: Integer
    Input: y: Integer
    Input: span: Integer
    Body: {
        IfCondition Or(EqualTo(dst, 0), EqualTo(src, 0)) ThenBlock: { ReturnValue(0) }
        sw = Surface_GetWidth(src)
        IfCondition LessEqual(sw, 0) ThenBlock: { ReturnValue(0) }
        x = 0
        WhileLoop LessThan(x, span) {
            Surface_BlitAlpha(dst, src, x, y)
            x = Add(x, sw)
        }
        ReturnValue(1)
    }
}

Function.WinChrome_TileHTinted {
    Input: dst: Integer
    Input: src: Integer
    Input: y: Integer
    Input: span: Integer
    Input: tint: Integer
    Body: {
        IfCondition Or(EqualTo(dst, 0), EqualTo(src, 0)) ThenBlock: { ReturnValue(0) }
        sw = Surface_GetWidth(src)
        IfCondition LessEqual(sw, 0) ThenBlock: { ReturnValue(0) }
        x = 0
        WhileLoop LessThan(x, span) {
            Surface_BlitTinted(dst, src, x, y, tint)
            x = Add(x, sw)
        }
        ReturnValue(1)
    }
}

Function.WinChrome_BlitButton {
    Input: dst: Integer
    Input: x: Integer
    Input: y: Integer
    Input: bg_color: Integer
    Input: border_color: Integer
    Input: glyph_color: Integer
    Body: {
        bg = WinChrome.btn_bg
        IfCondition NotEqual(bg, 0) ThenBlock: {
            Surface_BlitTinted(dst, bg, x, y, bg_color)
        }
        br = WinChrome.btn_border
        IfCondition NotEqual(br, 0) ThenBlock: {
            Surface_BlitTinted(dst, br, x, y, border_color)
        }
        g = WinChrome.blit_glyph
        IfCondition NotEqual(g, 0) ThenBlock: {
            Surface_BlitTinted(dst, g, x, y, glyph_color)
        }
        ReturnValue(0)
    }
}

// t is 0..256. Colors are 0xAARRGGBB.
Function.WinChrome_MixRGB {
    Input: c0: Integer
    Input: c1: Integer
    Input: t: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(t, 0) ThenBlock: { t = 0 }
        IfCondition GreaterThan(t, 256) ThenBlock: { t = 256 }
        r0 = BitwiseAnd(Divide(c0, 65536), 255)
        g0 = BitwiseAnd(Divide(c0, 256), 255)
        b0 = BitwiseAnd(c0, 255)
        r1 = BitwiseAnd(Divide(c1, 65536), 255)
        g1 = BitwiseAnd(Divide(c1, 256), 255)
        b1 = BitwiseAnd(c1, 255)
        r = Add(r0, Divide(Multiply(Subtract(r1, r0), t), 256))
        g = Add(g0, Divide(Multiply(Subtract(g1, g0), t), 256))
        b = Add(b0, Divide(Multiply(Subtract(b1, b0), t), 256))
        ReturnValue(TVG_PackColor(r, g, b, 255))
    }
}

// Diagonal steel: top-left Theme.toolbar_grad_a → bottom-right toolbar_grad_b.
// Chunk width follows toolbar_pad so the band size tracks DPI.
Function.WinChrome_FillSteelGrad {
    Input: surf: Integer
    Input: w: Integer
    Input: h: Integer
    Body: {
        IfCondition Or(EqualTo(surf, 0), Or(LessEqual(w, 0), LessEqual(h, 0))) ThenBlock: { ReturnValue(0) }
        step = UIScale.toolbar_pad
        IfCondition LessThan(step, 2) ThenBlock: { step = 2 }
        y = 0
        WhileLoop LessThan(y, h) {
            ty = Divide(Multiply(y, 256), h)
            x = 0
            WhileLoop LessThan(x, w) {
                tx = Divide(Multiply(x, 256), w)
                col = WinChrome_MixRGB(Theme.toolbar_grad_a, Theme.toolbar_grad_b, Divide(Add(tx, ty), 2))
                cw = step
                remain = Subtract(w, x)
                IfCondition GreaterThan(cw, remain) ThenBlock: { cw = remain }
                Draw_Pix_FillRect(surf, x, y, cw, 1, col)
                x = Add(x, step)
            }
            y = Add(y, 1)
        }
        ReturnValue(1)
    }
}

// Haiku ear: top of the cut is wider than the bottom. Width is a
// fraction of tab_h so it tracks DPI / tab_row_h, not a baked SVG size.
Function.WinChrome_FillTabSlant {
    Input: surf: Integer
    Input: x0: Integer
    Input: tab_h: Integer
    Input: color: Integer
    Body: {
        IfCondition Or(EqualTo(surf, 0), LessEqual(tab_h, 0)) ThenBlock: { ReturnValue(0) }
        slant_w = Divide(Multiply(tab_h, TabConst.SLANT_NUM), TabConst.SLANT_DEN)
        IfCondition LessThan(slant_w, 8) ThenBlock: { slant_w = 8 }
        y = 0
        WhileLoop LessThan(y, tab_h) {
            // Point at the top, full width at the bottom (Haiku / mockup).
            remain = Add(y, 1)
            row_w = Divide(Multiply(slant_w, remain), tab_h)
            IfCondition LessThan(row_w, 1) ThenBlock: { row_w = 1 }
            Draw_Pix_FillRect(surf, x0, y, row_w, 1, color)
            y = Add(y, 1)
        }
        ReturnValue(slant_w)
    }
}

// "Untitled - Notepad" → app name, then document name in a drawn box.
// cap_mode: 0 = whole title, 1 = app + boxed doc, 2 = boxed doc only.
Function.WinChrome_TitleSplit {
    Input: src: Integer
    Input: n: Integer
    Output: Integer
    Body: {
        split = -1
        IfCondition Or(EqualTo(src, 0), LessThan(n, 3)) ThenBlock: { ReturnValue(-1) }
        i = 0
        lim = Subtract(n, 2)
        WhileLoop LessThan(i, lim) {
            IfCondition EqualTo(GetByte(src, i), 32) ThenBlock: {
                IfCondition EqualTo(GetByte(src, Add(i, 1)), 45) ThenBlock: {
                    IfCondition EqualTo(GetByte(src, Add(i, 2)), 32) ThenBlock: {
                        split = i
                    }
                }
            }
            i = Add(i, 1)
        }
        ReturnValue(split)
    }
}

Function.WinChrome_DrawNameBox {
    Input: surf: Integer
    Input: x: Integer
    Input: y: Integer
    Input: w: Integer
    Input: h: Integer
    Body: {
        col = WinChrome.box_color
        Draw_Pix_FillRect(surf, x, y, w, h, Theme.tabbar_bg)
        Draw_Pix_FillRect(surf, x, y, w, 1, col)
        Draw_Pix_FillRect(surf, x, Add(y, Subtract(h, 1)), w, 1, col)
        Draw_Pix_FillRect(surf, x, y, 1, h, col)
        Draw_Pix_FillRect(surf, Add(x, Subtract(w, 1)), y, 1, h, col)
        ReturnValue(0)
    }
}

// Filename box: steel = new, red = unsaved, green = saved.
Function.WinChrome_LookupDocColor {
    Input: idx: Integer
    Output: Integer
    Body: {
        ctx = WinView_GetContentCtx(idx)
        IfCondition EqualTo(ctx, 0) ThenBlock: { ReturnValue(Theme.tab_doc_new) }
        tf = AK_FindTextField(ctx, AK_GetTreeRoot(ctx))
        IfCondition LessThan(tf, 0) ThenBlock: { ReturnValue(Theme.tab_doc_new) }
        tbh = AK_ExtraGet(ctx, tf, AKExtra.TEXTBUF_H)
        IfCondition LessThan(tbh, 0) ThenBlock: { ReturnValue(Theme.tab_doc_new) }
        IfCondition NotEqual(TextBuf_GetModified(tbh), 0) ThenBlock: {
            ReturnValue(Theme.tab_doc_dirty)
        }
        IfCondition NotEqual(TextBuf_GetNamed(tbh), 0) ThenBlock: {
            ReturnValue(Theme.tab_doc_saved)
        }
        ReturnValue(Theme.tab_doc_new)
    }
}

Function.WinChrome_DocInst {
    Input: fallback: Integer
    Output: Integer
    Body: {
        d = WinMgr.tab_doc_inst
        IfCondition LessThan(d, 0) ThenBlock: { ReturnValue(fallback) }
        ReturnValue(d)
    }
}

Function.WinChrome_MeasureCaption {
    Input: src: Integer
    Input: inst: Integer
    Input: avail: Integer
    Output: Integer
    Body: {
        WinChrome.cap_mode = 0
        IfCondition Or(EqualTo(src, 0), LessThan(inst, 0)) ThenBlock: { ReturnValue(0) }
        n = StringLength(src)
        IfCondition GreaterThan(n, 48) ThenBlock: { n = 48 }
        split = WinChrome_TitleSplit(src, n)
        IfCondition LessThan(split, 0) ThenBlock: {
            ReturnValue(VInst_MeasureWidth(inst, src, n))
        }
        aw = VInst_MeasureWidth(inst, Add(src, Add(split, 3)), Subtract(n, Add(split, 3)))
        dw = VInst_MeasureWidth(WinChrome_DocInst(inst), src, split)
        box_w = Add(dw, 12)
        full = Add(Add(aw, 8), box_w)
        IfCondition GreaterThan(full, avail) ThenBlock: {
            WinChrome.cap_mode = 2
            ReturnValue(box_w)
        }
        WinChrome.cap_mode = 1
        ReturnValue(full)
    }
}

Function.WinChrome_DrawDocBox {
    Input: surf: Integer
    Input: inst: Integer
    Input: x: Integer
    Input: tab_h: Integer
    Input: src: Integer
    Input: split: Integer
    Output: Integer
    Body: {
        dinst = WinChrome_DocInst(inst)
        dw = VInst_MeasureWidth(dinst, src, split)
        box_w = Add(dw, 12)
        box_h = Add(UIScale.tab_doc_font_h, 8)
        IfCondition GreaterThan(box_h, Subtract(tab_h, 4)) ThenBlock: {
            box_h = Subtract(tab_h, 4)
        }
        box_y = Divide(Subtract(tab_h, box_h), 2)
        WinChrome_DrawNameBox(surf, x, box_y, box_w, box_h)
        doc_y = Divide(Subtract(tab_h, UIScale.tab_doc_font_h), 2)
        FontState.draw_color = Theme.tab_text
        VInst_DrawString(dinst, surf, src, split, Add(x, 6), doc_y)
        ReturnValue(box_w)
    }
}

// App name, then document name inside a 1px rectangle. No brace glyphs.
Function.WinChrome_DrawCaption {
    Input: surf: Integer
    Input: inst: Integer
    Input: x: Integer
    Input: y: Integer
    Input: tab_h: Integer
    Input: src: Integer
    Output: Integer
    Body: {
        IfCondition Or(EqualTo(src, 0), LessThan(inst, 0)) ThenBlock: { ReturnValue(0) }
        n = StringLength(src)
        IfCondition GreaterThan(n, 48) ThenBlock: { n = 48 }
        FontState.draw_color = Theme.tab_text
        IfCondition EqualTo(WinChrome.cap_mode, 0) ThenBlock: {
            VInst_DrawString(inst, surf, src, n, x, y)
            ReturnValue(VInst_MeasureWidth(inst, src, n))
        }
        split = WinChrome_TitleSplit(src, n)
        IfCondition LessThan(split, 0) ThenBlock: {
            VInst_DrawString(inst, surf, src, n, x, y)
            ReturnValue(VInst_MeasureWidth(inst, src, n))
        }
        cur = x
        IfCondition EqualTo(WinChrome.cap_mode, 1) ThenBlock: {
            app_off = Add(split, 3)
            VInst_DrawString(inst, surf, Add(src, app_off), Subtract(n, app_off), cur, y)
            cur = Add(cur, Add(VInst_MeasureWidth(inst, Add(src, app_off), Subtract(n, app_off)), 8))
        }
        bw = WinChrome_DrawDocBox(surf, inst, cur, tab_h, src, split)
        ReturnValue(Subtract(Add(cur, bw), x))
    }
}

Function.Win_DrawTabBar {
    Input: idx: Integer
    Output: Integer
    Body: {
        DebugLog_Push("wr.tab", 6)
        surf = WinMgr_GetHdr(idx)
        IfCondition LessThan(surf, 0) ThenBlock: { ReturnValue(0) }

        tw = Win_GetTotalW(idx)
        tab_h = TabConst.TAB_ROW_H
        IfCondition LessThan(tab_h, 1) ThenBlock: { tab_h = Surface_GetHeight(surf) }
        inst = WinMgr.tab_inst
        pad = TabConst.TAB_PAD

        Draw_Pix_FillRect(surf, 0, 0, tw, tab_h, Theme.tabbar_bg)

        slant_est = Divide(Multiply(tab_h, TabConst.SLANT_NUM), TabConst.SLANT_DEN)
        avail = Subtract(tw, Add(slant_est, Multiply(pad, 4)))
        title_ptr = WinMgr_GetTitle(idx)
        WinChrome.box_color = WinChrome_LookupDocColor(idx)
        text_w = WinChrome_MeasureCaption(title_ptr, inst, avail)

        tab_w = Add(text_w, Multiply(pad, 4))
        IfCondition LessThan(tab_w, UIScale.min_tab_w) ThenBlock: { tab_w = UIScale.min_tab_w }

        IfCondition NotEqual(WinChrome.tab_body, 0) ThenBlock: {
            WinChrome_TileH(surf, WinChrome.tab_body, 0, tab_w)
        } ElseBlock: {
            Draw_Pix_FillRect(surf, 0, 0, tab_w, tab_h, Theme.tab_active_bg)
        }

        slant_w = 0
        IfCondition NotEqual(WinChrome.tab_slant, 0) ThenBlock: {
            Surface_BlitAlpha(surf, WinChrome.tab_slant, tab_w, 0)
            slant_w = Surface_GetWidth(WinChrome.tab_slant)
        } ElseBlock: {
            slant_w = WinChrome_FillTabSlant(surf, tab_w, tab_h, Theme.tab_active_bg)
        }

        PrintMessage("[TabBar] idx=")
        PrintNumber(idx)
        PrintMessage(" cap=")
        PrintNumber(WinChrome.cap_mode)
        PrintMessage(" tab_w=")
        PrintNumber(tab_w)
        PrintMessage("\n")

        lip_h = Divide(tab_h, 16)
        IfCondition LessThan(lip_h, 2) ThenBlock: { lip_h = 2 }
        lip_y = Subtract(tab_h, lip_h)
        lip_w = Add(tab_w, slant_w)
        Draw_Pix_FillRect(surf, 0, lip_y, lip_w, lip_h, Theme.tab_lip)

        IfCondition GreaterThan(text_w, 0) ThenBlock: {
            text_x = Multiply(pad, 2)
            text_y = Divide(Subtract(tab_h, UIScale.tab_font_h), 2)
            WinChrome_DrawCaption(surf, inst, text_x, text_y, tab_h, title_ptr)
        }

        ReturnValue(1)
    }
}


// =============================================================================
// WIN_RENDERDIRTY — stub for dirty buffer rendering
// =============================================================================
Function.Win_RenderDirty {
    Output: Integer
    Body: {
        DebugLog_Push("win.rdr", 7)
        ReturnValue(0)
    }
}