LibraryImport.Display.Window.WinManager
LibraryImport.Display.Theme.UIScale


// =============================================================================
// FIXED POOLS
// =============================================================================

FixedPool.TabConst {
    "TAB_MAX_W":   Initialize=72, CanChange=True
    "TAB_ROW_H":   Initialize=24, CanChange=True
    "TAB_ICON_W":  Initialize=10, CanChange=True
    "TAB_CLOSE_W": Initialize=0, CanChange=True
    "TAB_PAD":     Initialize=4, CanChange=True
    // Slant width = tab_h * SLANT_NUM / SLANT_DEN (Haiku ear, scales with row).
    "SLANT_NUM":   Initialize=2, CanChange=True
    "SLANT_DEN":   Initialize=1, CanChange=True
}

FixedPool.StackFields {
    "TAB_SURF":   Initialize=0
    "TAB_COUNT":  Initialize=8
    "TAB_BAR_H":  Initialize=16
    "ACTIVE_WIN": Initialize=24
    "WIN_LIST":   Initialize=32
    "ACTIVE":     Initialize=40
}

FixedPool.StackConst {
    "ENTRY_SIZE": Initialize=48
    "MAX":        Initialize=8
    "MAX_TABS":   Initialize=8
}

FixedPool.StackTable {
    "data":  Initialize=0
    "count": Initialize=0
}

FixedPool.WinStackMap {
    "data": Initialize=0
}


// =============================================================================
// WINSTACK_INIT — extracted from WinMgr_Init
// =============================================================================
Function.WinStack_Init {
    Output: Integer
    Body: {
        // Copy scaled tab dimensions from UIScale
        TabConst.TAB_MAX_W  = UIScale.tab_max_w
        TabConst.TAB_ROW_H  = UIScale.tab_row_h
        TabConst.TAB_ICON_W = UIScale.tab_icon_w
        TabConst.TAB_PAD    = UIScale.tab_pad

        stack_size = Multiply(StackConst.MAX, StackConst.ENTRY_SIZE)
        stack_buf  = Allocate(stack_size)
        si = 0
        WhileLoop LessThan(si, stack_size) {
            SetByte(stack_buf, si, 0)
            si = Add(si, 1)
        }
        StackTable.data  = stack_buf
        StackTable.count = 0

        map_buf = Allocate(64)
        mi = 0
        WhileLoop LessThan(mi, 8) {
            StoreValue(Add(map_buf, Multiply(mi, 8)), -1)
            mi = Add(mi, 1)
        }
        WinStackMap.data = map_buf

        PrintMessage("[WinStack] initialized\n")
        ReturnValue(1)
    }
}


// =============================================================================
// STACK TABLE ACCESSORS
// =============================================================================
Function.Stack_Ptr {
    Input:  idx: Integer
    Output: Integer
    Body: { ReturnValue(Add(StackTable.data, Multiply(idx, StackConst.ENTRY_SIZE))) }
}

Function.Stack_Get {
    Input:  idx: Integer
    Input:  field: Integer
    Output: Integer
    Body: {
        sp = Stack_Ptr(idx)
        ReturnValue(Dereference(Add(sp, field)))
    }
}

Function.Stack_Set {
    Input: idx: Integer
    Input: field: Integer
    Input: val: Integer
    Body: {
        sp = Stack_Ptr(idx)
        StoreValue(Add(sp, field), val)
    }
}

Function.WinStack_Get {
    Input:  win_idx: Integer
    Output: Integer
    Body: { ReturnValue(Dereference(Add(WinStackMap.data, Multiply(win_idx, 8)))) }
}

Function.WinStack_Set {
    Input: win_idx: Integer
    Input: stack_idx: Integer
    Body: { StoreValue(Add(WinStackMap.data, Multiply(win_idx, 8)), stack_idx) }
}


// =============================================================================
// STACK_CALCHEIGHT — tab bar height from tab count and canvas width
// =============================================================================
Function.Stack_CalcHeight {
    Input:  tab_count: Integer
    Input:  canvas_w:  Integer
    Output: Integer
    Body: {
        tabs_per_row = Divide(canvas_w, TabConst.TAB_MAX_W)
        IfCondition LessThan(tabs_per_row, 1) ThenBlock: { tabs_per_row = 1 }
        row_count = Divide(Add(tab_count, Subtract(tabs_per_row, 1)), tabs_per_row)
        IfCondition LessThan(row_count, 1) ThenBlock: { row_count = 1 }
        tab_bar_h = Multiply(row_count, TabConst.TAB_ROW_H)
        ReturnValue(tab_bar_h)
    }
}

Function.Win_GetTabBarH_FromStack {
    Input:  idx: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(idx, 0) ThenBlock: {
            ReturnValue(0)
        }
        stack_idx = WinStack_Get(idx)
        IfCondition LessThan(stack_idx, 0) ThenBlock: {
            ReturnValue(TabConst.TAB_ROW_H)
        }
        tab_count = Stack_Get(stack_idx, StackFields.TAB_COUNT)
        canvas_w  = Win_GetCanvasW(idx)
        tbh = Stack_CalcHeight(tab_count, canvas_w)
        ReturnValue(tbh)
    }
}


// =============================================================================
// STACK_CREATE — allocate a new stack for a window
// =============================================================================
Function.Stack_Create {
    Input:  win_idx: Integer
    Output: Integer
    Body: {
        sidx = -1
        si2 = 0
        WhileLoop LessThan(si2, StackConst.MAX) {
            act = Stack_Get(si2, StackFields.ACTIVE)
            IfCondition EqualTo(act, 0) ThenBlock: {
                sidx = si2
                si2 = StackConst.MAX
            } ElseBlock: {
                si2 = Add(si2, 1)
            }
        }
        IfCondition LessThan(sidx, 0) ThenBlock: {
            PrintMessage("[Stack] ERROR: table full\n")
            ReturnValue(-1)
        }

        wlist = Allocate(64)
        wi = 0
        WhileLoop LessThan(wi, 8) {
            StoreValue(Add(wlist, Multiply(wi, 8)), -1)
            wi = Add(wi, 1)
        }
        StoreValue(wlist, win_idx)

        Stack_Set(sidx, StackFields.TAB_SURF,   -1)
        Stack_Set(sidx, StackFields.TAB_COUNT,   1)
        Stack_Set(sidx, StackFields.TAB_BAR_H,   TabConst.TAB_ROW_H)
        Stack_Set(sidx, StackFields.ACTIVE_WIN,  0)
        Stack_Set(sidx, StackFields.WIN_LIST,    wlist)
        Stack_Set(sidx, StackFields.ACTIVE,      1)
        StackTable.count = Add(StackTable.count, 1)

        WinStack_Set(win_idx, sidx)

        PrintMessage("[Stack] created idx=")
        PrintNumber(sidx)
        PrintMessage(" win=")
        PrintNumber(win_idx)
        PrintMessage("\n")
        ReturnValue(sidx)
    }
}