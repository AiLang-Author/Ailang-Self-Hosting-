// ============================================
// DATA-FILE LOADER (items.dnddat)
// ============================================
//
// items.dnddat's TYPE column uses its own numbering
// (1=weapon, 2=armor, 3=potion, 4=scroll, 5=key, 7=food). The runtime
// Item_Types pool uses different ids (POTION=7, SCROLL=8, KEY=9,
// FOOD=11). Translate at load time so the data file stays unchanged
// while the runtime sees canonical types.
Function.Item_TypeFromFileCode {
    Input: code: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(code, 1) ThenBlock: { ReturnValue(Item_Types.WEAPON) }
        IfCondition EqualTo(code, 2) ThenBlock: { ReturnValue(Item_Types.ARMOR) }
        IfCondition EqualTo(code, 3) ThenBlock: { ReturnValue(Item_Types.POTION) }
        IfCondition EqualTo(code, 4) ThenBlock: { ReturnValue(Item_Types.SCROLL) }
        IfCondition EqualTo(code, 5) ThenBlock: { ReturnValue(Item_Types.KEY) }
        IfCondition EqualTo(code, 7) ThenBlock: { ReturnValue(Item_Types.FOOD) }
        ReturnValue(Item_Types.NONE)
    }
}

Function.Item_SlotFromFileCode {
    Input: code: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(code, 1) ThenBlock: { ReturnValue(Item_Slots.WEAPON) }
        IfCondition EqualTo(code, 2) ThenBlock: { ReturnValue(Item_Slots.ARMOR) }
        ReturnValue(Item_Slots.NONE)
    }
}

// Parse a PARAM spec from items.dnddat into a "stat value."
//   "1d6"  → 6   (1 six-sided die, take max — used as damage/heal cap)
//   "2d4"  → 8   (2 * 4)
//   "3"    → 3   (flat value, e.g. armor AC bonus)
//   ""     → 0
// Cheap approximation: `n*sides` gives the cap, not the average. Good
// enough for shop display and stat ordering; combat roll code can
// parse the raw string later if it wants the actual dice.
Function.Item_ParamToStat {
    Input: s: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(StringLength(s), 0) ThenBlock: { ReturnValue(0) }

        d_pos = StringIndexOf(s, "d")
        IfCondition EqualTo(d_pos, -1) ThenBlock: {
            ReturnValue(StringToInt(s))
        }

        // s is "NdM" — split on 'd' (ASCII 100).
        count_str = StringSplitField(s, 100, 0)
        sides_str = StringSplitField(s, 100, 1)
        dice_count = StringToInt(count_str)
        dice_sides = StringToInt(sides_str)
        IfCondition LessEqual(dice_count, 0) ThenBlock: { dice_count = 1 }
        ReturnValue(Multiply(dice_count, dice_sides))
    }
}

// Parses a CSV item database. Header row starts with "ID" and is
// skipped. Each data row: id,name,symbol,type,value,effect,param.
// Only id/name/type/value are consumed right now — symbol/effect/param
// are reserved for later passes (item glyph rendering, use-effect
// dispatch, damage-dice parsing into atk bonus).
//
// Returns the number of items loaded, or -1 on open error.
Function.Item_LoadFromFile {
    Input: filepath: Address
    Output: Integer
    Body: {
        fd = SystemCall(257, -100, filepath, 0, 0)
        IfCondition LessThan(fd, 0) ThenBlock: { ReturnValue(-1) }

        buffer = Allocate(16384)
        bytes = SystemCall(0, fd, buffer, 16384)
        SystemCall(3, fd)

        IfCondition LessEqual(bytes, 0) ThenBlock: {
            Deallocate(buffer, 16384)
            ReturnValue(-2)
        }

        count = 0
        line_buf = Allocate(256)
        pos = 0

        WhileLoop LessThan(pos, bytes) {
            line_len = 0
            reading = 1
            WhileLoop EqualTo(reading, 1) {
                IfCondition GreaterEqual(pos, bytes) ThenBlock: { reading = 0 } ElseBlock: {
                    ch = GetByte(buffer, pos)
                    pos = Add(pos, 1)
                    IfCondition EqualTo(ch, 10) ThenBlock: { reading = 0 } ElseBlock: {
                        not_cr = NotEqual(ch, 13)
                        IfCondition And(not_cr, LessThan(line_len, 255)) ThenBlock: {
                            SetByte(line_buf, line_len, ch)
                            line_len = Add(line_len, 1)
                        }
                    }
                }
            }
            SetByte(line_buf, line_len, 0)

            // Skip empty, comment (#), and header (ID,...) rows.
            IfCondition GreaterThan(line_len, 0) ThenBlock: {
                first_ch = GetByte(line_buf, 0)
                is_comment = EqualTo(first_ch, 35)
                is_header = EqualTo(StringStartsWith(line_buf, "ID,"), 1)
                skip = Or(is_comment, is_header)

                IfCondition EqualTo(skip, 0) ThenBlock: {
                    id_str    = StringSplitField(line_buf, 44, 0)
                    name_str  = StringSplitField(line_buf, 44, 1)
                    // field 2 is SYMBOL — reserved for item-glyph rendering
                    type_str  = StringSplitField(line_buf, 44, 3)
                    value_str = StringSplitField(line_buf, 44, 4)
                    // field 5 (EFFECT) — reserved for use-effect dispatch
                    param_str = StringSplitField(line_buf, 44, 6)

                    id = StringToInt(id_str)
                    file_type = StringToInt(type_str)
                    value = StringToInt(value_str)
                    stat = Item_ParamToStat(param_str)

                    item_type = Item_TypeFromFileCode(file_type)
                    slot = Item_SlotFromFileCode(file_type)

                    // Route PARAM into the right stat slot based on
                    // item kind. Defaults are 0, so items without a
                    // relevant stat (keys, etc) get all-zero stats.
                    Item_PendingStats.atk = 0
                    Item_PendingStats.def = 0
                    Item_PendingStats.mag = 0
                    IfCondition EqualTo(item_type, Item_Types.WEAPON) ThenBlock: {
                        Item_PendingStats.atk = stat
                    }
                    IfCondition EqualTo(item_type, Item_Types.ARMOR) ThenBlock: {
                        Item_PendingStats.def = stat
                    }
                    IfCondition EqualTo(item_type, Item_Types.POTION) ThenBlock: {
                        Item_PendingStats.mag = stat
                    }
                    IfCondition EqualTo(item_type, Item_Types.SCROLL) ThenBlock: {
                        Item_PendingStats.mag = stat
                    }
                    IfCondition EqualTo(item_type, Item_Types.FOOD) ThenBlock: {
                        Item_PendingStats.mag = stat
                    }

                    result = Item_Register(id, name_str, item_type, slot, value)
                    IfCondition GreaterEqual(result, 0) ThenBlock: {
                        count = Add(count, 1)
                    }
                }
            }
        }

        Deallocate(line_buf, 256)
        Deallocate(buffer, 16384)
        ReturnValue(count)
    }
}