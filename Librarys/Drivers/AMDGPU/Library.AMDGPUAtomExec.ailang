FixedPool.AEState {
    "entries":     Initialize=0
    "stacks":      Initialize=0
    "initialized": Initialize=0
    "mask_tbl":    Initialize=0
    "shift_tbl":   Initialize=0
    "dst2src_tbl": Initialize=0
    "defdst_tbl":  Initialize=0
}

// =============================================================================
// INITIALIZATION
// =============================================================================
Function.AtomExec_InitTables {
    Body: {
        IfCondition EqualTo(AEState.initialized, 1) ThenBlock: { ReturnValue(0) }

        mask_t = Allocate(64)
        StoreValue(mask_t, AtomMask.M0)
        StoreValue(Add(mask_t, 8), AtomMask.M1)
        StoreValue(Add(mask_t, 16), AtomMask.M2)
        StoreValue(Add(mask_t, 24), AtomMask.M3)
        StoreValue(Add(mask_t, 32), AtomMask.M4)
        StoreValue(Add(mask_t, 40), AtomMask.M5)
        StoreValue(Add(mask_t, 48), AtomMask.M6)
        StoreValue(Add(mask_t, 56), AtomMask.M7)
        AEState.mask_tbl = mask_t

        shift_t = Allocate(64)
        StoreValue(shift_t, AtomShift.S0)
        StoreValue(Add(shift_t, 8), AtomShift.S1)
        StoreValue(Add(shift_t, 16), AtomShift.S2)
        StoreValue(Add(shift_t, 24), AtomShift.S3)
        StoreValue(Add(shift_t, 32), AtomShift.S4)
        StoreValue(Add(shift_t, 40), AtomShift.S5)
        StoreValue(Add(shift_t, 48), AtomShift.S6)
        StoreValue(Add(shift_t, 56), AtomShift.S7)
        AEState.shift_tbl = shift_t

        dst_t = Allocate(256)
        StoreValue(dst_t, AtomDstToSrc.V00)
        StoreValue(Add(dst_t, 8), AtomDstToSrc.V01)
        StoreValue(Add(dst_t, 16), AtomDstToSrc.V02)
        StoreValue(Add(dst_t, 24), AtomDstToSrc.V03)
        StoreValue(Add(dst_t, 32), AtomDstToSrc.V10)
        StoreValue(Add(dst_t, 40), AtomDstToSrc.V11)
        StoreValue(Add(dst_t, 48), AtomDstToSrc.V12)
        StoreValue(Add(dst_t, 56), AtomDstToSrc.V13)
        StoreValue(Add(dst_t, 64), AtomDstToSrc.V20)
        StoreValue(Add(dst_t, 72), AtomDstToSrc.V21)
        StoreValue(Add(dst_t, 80), AtomDstToSrc.V22)
        StoreValue(Add(dst_t, 88), AtomDstToSrc.V23)
        StoreValue(Add(dst_t, 96), AtomDstToSrc.V30)
        StoreValue(Add(dst_t, 104), AtomDstToSrc.V31)
        StoreValue(Add(dst_t, 112), AtomDstToSrc.V32)
        StoreValue(Add(dst_t, 120), AtomDstToSrc.V33)
        StoreValue(Add(dst_t, 128), AtomDstToSrc.V40)
        StoreValue(Add(dst_t, 136), AtomDstToSrc.V41)
        StoreValue(Add(dst_t, 144), AtomDstToSrc.V42)
        StoreValue(Add(dst_t, 152), AtomDstToSrc.V43)
        StoreValue(Add(dst_t, 160), AtomDstToSrc.V50)
        StoreValue(Add(dst_t, 168), AtomDstToSrc.V51)
        StoreValue(Add(dst_t, 176), AtomDstToSrc.V52)
        StoreValue(Add(dst_t, 184), AtomDstToSrc.V53)
        StoreValue(Add(dst_t, 192), AtomDstToSrc.V60)
        StoreValue(Add(dst_t, 200), AtomDstToSrc.V61)
        StoreValue(Add(dst_t, 208), AtomDstToSrc.V62)
        StoreValue(Add(dst_t, 216), AtomDstToSrc.V63)
        StoreValue(Add(dst_t, 224), AtomDstToSrc.V70)
        StoreValue(Add(dst_t, 232), AtomDstToSrc.V71)
        StoreValue(Add(dst_t, 240), AtomDstToSrc.V72)
        StoreValue(Add(dst_t, 248), AtomDstToSrc.V73)
        AEState.dst2src_tbl = dst_t

        def_t = Allocate(64)
        StoreValue(def_t, AtomDefDst.DD0)
        StoreValue(Add(def_t, 8), AtomDefDst.DD1)
        StoreValue(Add(def_t, 16), AtomDefDst.DD2)
        StoreValue(Add(def_t, 24), AtomDefDst.DD3)
        StoreValue(Add(def_t, 32), AtomDefDst.DD4)
        StoreValue(Add(def_t, 40), AtomDefDst.DD5)
        StoreValue(Add(def_t, 48), AtomDefDst.DD6)
        StoreValue(Add(def_t, 56), AtomDefDst.DD7)
        AEState.defdst_tbl = def_t

        AEState.initialized = 1
        ReturnValue(0)
    }
}

// =============================================================================
// TABLE LOOKUP HELPERS
// =============================================================================
Function.AE_GetMask {
    Input: align: Integer
    Output: Integer
    Body: { ReturnValue(Dereference(Add(AEState.mask_tbl, Multiply(align, 8)))) }
}

Function.AE_GetShift {
    Input: align: Integer
    Output: Integer
    Body: { ReturnValue(Dereference(Add(AEState.shift_tbl, Multiply(align, 8)))) }
}

Function.AE_GetDstToSrc {
    Input: row: Integer
    Input: col: Integer
    Output: Integer
    Body: {
        idx = Add(Multiply(row, 4), col)
        ReturnValue(Dereference(Add(AEState.dst2src_tbl, Multiply(idx, 8))))
    }
}

Function.AE_GetDefDst {
    Input: idx: Integer
    Output: Integer
    Body: { ReturnValue(Dereference(Add(AEState.defdst_tbl, Multiply(idx, 8)))) }
}

// =============================================================================
// CONTEXT ACCESSORS
// =============================================================================
Function.AtomExec_GetCtx {
    Input: gpu: Integer
    Output: Address
    Body: {
        IfCondition EqualTo(AEState.entries, 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(Add(AEState.entries, Multiply(gpu, AEField.ENTRY_SIZE)))
    }
}

Function.AtomExec_GetFrame {
    Input: gpu: Integer
    Input: depth: Integer
    Output: Address
    Body: {
        IfCondition EqualTo(AEState.stacks, 0) ThenBlock: { ReturnValue(0) }
        gpu_stack = Add(AEState.stacks, Multiply(gpu, Multiply(AtomVM.MAX_CALL, AEFrame.FRAME_SIZE)))
        ReturnValue(Add(gpu_stack, Multiply(depth, AEFrame.FRAME_SIZE)))
    }
}

// =============================================================================
// AtomExec_Init
// =============================================================================
Function.AtomExec_Init {
    Input: gpu: Integer
    Output: Integer
    Body: {
        IfCondition NotEqual(AEState.initialized, 1) ThenBlock: {
            PrintMessage("AtomExec: Tables not initialized\n")
            ReturnValue(-1)
        }

        max_gpus = GPUBarConst.MAX_GPUS
        IfCondition EqualTo(AEState.entries, 0) ThenBlock: {
            total_ctx = Multiply(max_gpus, AEField.ENTRY_SIZE)
            AEState.entries = Allocate(total_ctx)
            i = 0
            WhileLoop LessThan(i, total_ctx) {
                SetByte(AEState.entries, i, 0)
                i = Add(i, 1)
            }
            total_stk = Multiply(max_gpus, Multiply(AtomVM.MAX_CALL, AEFrame.FRAME_SIZE))
            AEState.stacks = Allocate(total_stk)
            i = 0
            WhileLoop LessThan(i, total_stk) {
                SetByte(AEState.stacks, i, 0)
                i = Add(i, 1)
            }
        }

        ctx = AtomExec_GetCtx(gpu)
        IfCondition EqualTo(ctx, 0) ThenBlock: { ReturnValue(-1) }

        rom = AtomBIOS_GetROMPtr(gpu)
        IfCondition EqualTo(rom, 0) ThenBlock: { ReturnValue(-1) }

        rom_size = AtomBIOS_GetROMSize(gpu)
        StoreValue(Add(ctx, AEField.ROM_PTR), rom)
        StoreValue(Add(ctx, AEField.GPU_INDEX), gpu)

        atom_off = AtomBIOS_GetField(gpu, AtomField.ATOM_HDR_OFF)
        cmd_tbl_off = AtomBIOS_ReadU16(rom, Add(atom_off, 30))
        data_tbl_off = AtomBIOS_ReadU16(rom, Add(atom_off, 32))
        StoreValue(Add(ctx, AEField.CMD_TABLE), cmd_tbl_off)
        StoreValue(Add(ctx, AEField.DATA_TABLE), data_tbl_off)

        PrintMessage("AtomExec_Init GPU ")
        PrintNumber(gpu)
        PrintMessage(": CMD=0x")
        PrintHex(cmd_tbl_off)
        PrintMessage(" DATA=0x")
        PrintHex(data_tbl_off)
        PrintMessage("\n")

        // ATOM_DATA_IIO_PTR = 0x32 = 50; kernel adds +4 to skip common table header
        iio_off = AtomBIOS_ReadU16(rom, Add(data_tbl_off, 50))
        IfCondition NotEqual(iio_off, 0) ThenBlock: {
            AtomExec_ParseIIO(gpu, rom, Add(iio_off, 4))
        }

        scratch_size = 20480
        scratch = Allocate(scratch_size)
        i = 0
        WhileLoop LessThan(i, scratch_size) {
            SetByte(scratch, i, 0)
            i = Add(i, 1)
        }
        StoreValue(Add(ctx, AEField.SCRATCH_PTR), scratch)
        StoreValue(Add(ctx, AEField.SCRATCH_SIZE), scratch_size)
        StoreValue(Add(ctx, AEField.IO_MODE), AtomIO.MM)
        StoreValue(Add(ctx, AEField.REG_BLOCK), 0)
        StoreValue(Add(ctx, AEField.DATA_BLOCK), 0)
        StoreValue(Add(ctx, AEField.FB_BASE), 0)
        StoreValue(Add(ctx, AEField.CALL_DEPTH), 0)
        StoreValue(Add(ctx, AEField.INITIALIZED), 1)
        ReturnValue(0)
    }
}

// =============================================================================
// AtomExec_ParseIIO
// =============================================================================
Function.AtomExec_ParseIIO {
    Input: gpu: Integer
    Input: rom: Address
    Input: base: Integer
    Body: {
        ctx = AtomExec_GetCtx(gpu)
        iio_tbl = Allocate(2048)
        i = 0
        WhileLoop LessThan(i, 2048) {
            SetByte(iio_tbl, i, 0)
            i = Add(i, 1)
        }
        StoreValue(Add(ctx, AEField.IIO_PTR), iio_tbl)

        done = 0
        safety = 0
        WhileLoop EqualTo(done, 0) {
            start_byte = GetByte(rom, base)
            IfCondition EqualTo(start_byte, 0) ThenBlock: {
                next_op = GetByte(rom, Add(base, 1))
                IfCondition NotEqual(next_op, 1) ThenBlock: { done = 1 }
                ElseBlock: { base = Add(base, 1) }
            }
            ElseBlock: {
                IfCondition EqualTo(start_byte, 1) ThenBlock: {
                    idx = GetByte(rom, Add(base, 1))
                    StoreValue(Add(iio_tbl, Multiply(idx, 8)), Add(base, 2))
                    base = Add(base, 2)
                    inner_done = 0
                    WhileLoop EqualTo(inner_done, 0) {
                        iio_op = GetByte(rom, base)
                        IfCondition EqualTo(iio_op, 9) ThenBlock: {
                            inner_done = 1
                            base = Add(base, 3)
                        }
                        ElseBlock: {
                            IfCondition LessEqual(iio_op, 8) ThenBlock: {
                                len = 1
                                IfCondition EqualTo(iio_op, 2) ThenBlock: { len = 3 }
                                IfCondition EqualTo(iio_op, 3) ThenBlock: { len = 3 }
                                IfCondition EqualTo(iio_op, 4) ThenBlock: { len = 3 }
                                IfCondition EqualTo(iio_op, 5) ThenBlock: { len = 3 }
                                IfCondition EqualTo(iio_op, 6) ThenBlock: { len = 4 }
                                IfCondition EqualTo(iio_op, 7) ThenBlock: { len = 4 }
                                IfCondition EqualTo(iio_op, 8) ThenBlock: { len = 4 }
                                base = Add(base, len)
                            }
                            ElseBlock: {
                                inner_done = 1
                                done = 1
                            }
                        }
                    }
                }
                ElseBlock: { done = 1 }
            }
            safety = Add(safety, 1)
            IfCondition GreaterThan(safety, 1000) ThenBlock: { done = 1 }
        }
    }
}

// =============================================================================
// AtomExec_Shutdown
// =============================================================================
Function.AtomExec_Shutdown {
    Input: gpu: Integer
    Body: {
        ctx = AtomExec_GetCtx(gpu)
        IfCondition EqualTo(ctx, 0) ThenBlock: { ReturnValue(0) }
        iio = Dereference(Add(ctx, AEField.IIO_PTR))
        IfCondition NotEqual(iio, 0) ThenBlock: {
            Deallocate(iio, 2048)
            StoreValue(Add(ctx, AEField.IIO_PTR), 0)
        }
        scratch = Dereference(Add(ctx, AEField.SCRATCH_PTR))
        IfCondition NotEqual(scratch, 0) ThenBlock: {
            Deallocate(scratch, Dereference(Add(ctx, AEField.SCRATCH_SIZE)))
            StoreValue(Add(ctx, AEField.SCRATCH_PTR), 0)
        }
        StoreValue(Add(ctx, AEField.INITIALIZED), 0)
    }
}
