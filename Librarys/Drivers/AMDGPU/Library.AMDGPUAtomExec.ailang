    "DATA_TABLE":   Initialize=8
    "IIO_PTR":      Initialize=16
    "SCRATCH_PTR":  Initialize=24
    "SCRATCH_SIZE": Initialize=32
    "DATA_BLOCK":   Initialize=40
    "FB_BASE":      Initialize=48
    "REG_BLOCK":    Initialize=56
    "IO_MODE":      Initialize=64
    "IO_ATTR":      Initialize=72
    "DIVMUL_Q":     Initialize=80
    "DIVMUL_R":     Initialize=88
    "SHIFT":        Initialize=96
    "CS_EQUAL":     Initialize=104
    "CS_ABOVE":     Initialize=112
    "GPU_INDEX":    Initialize=120
    "CALL_DEPTH":   Initialize=128
    "INITIALIZED":  Initialize=136
    "ROM_PTR":      Initialize=144
    "ENTRY_SIZE":   Initialize=160
}

FixedPool.AEFrame {
    "PS_PTR":     Initialize=0
    "PS_SIZE":    Initialize=8
    "PS_SHIFT":   Initialize=16
    "WS_PTR":     Initialize=24
    "WS_SIZE":    Initialize=32
    "START":      Initialize=40
