// Library.AMDGPUAtomExec.ailang — ATOM BIOS Bytecode Interpreter
//
// Executes ATOM BIOS command tables from GPU VBIOS ROM.
// Reference: Linux kernel drivers/gpu/drm/radeon/atom.c

