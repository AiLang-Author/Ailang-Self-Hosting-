// Library.AMDGPUAtomExecDecode.ailang — ATOM BIOS operand decoder

LibraryImport.Drivers.AMDGPU.AMDGPUFamily
LibraryImport.Drivers.AMDGPU.AMDGPUDiscover
LibraryImport.Drivers.AMDGPU.AMDGPUBAR
LibraryImport.Drivers.AMDGPU.AMDGPUAtomBIOS
LibraryImport.Drivers.AMDGPU.AMDGPUPM4Regs
LibraryImport.Drivers.AMDGPU.AMDGPUAtomExec
LibraryImport.Drivers.AMDGPU.AMDGPUAtomExecIO

// =============================================================================
// AE_GetSrc — decode a source operand from the bytecode stream
//
// attr: attribute byte (bits[2:0]=arg type, bits[5:3]=alignment)
// ip_ptr: address of instruction pointer (updated in place)
// saved_ptr: address to store pre-masked value (0 = don't save)
// Returns: decoded, masked, shifted value
// =============================================================================
Function.AE_GetSrc {
    Input: gpu: Integer
    Input: attr: Integer
    Input: ip_ptr: Address
    Input: saved_ptr: Address
    Output: Integer
    Body: {
        ctx = AtomExec_GetCtx(gpu)
        rom = Dereference(Add(ctx, AEField.ROM_PTR))
        ip = Dereference(ip_ptr)

        arg = BitwiseAnd(attr, 7)
        align = BitwiseAnd(ShiftRight(attr, 3), 7)
        val = 0

        IfCondition EqualTo(arg, AtomArg.REG) ThenBlock: {
            idx = AtomBIOS_ReadU16(rom, ip)
            ip = Add(ip, 2)
            idx = Add(idx, Dereference(Add(ctx, AEField.REG_BLOCK)))
            val = AE_RegRead(gpu, idx)
        }
        ElseBlock: {
        IfCondition EqualTo(arg, AtomArg.PS) ThenBlock: {
            idx = GetByte(rom, ip)
            ip = Add(ip, 1)
            depth = Dereference(Add(ctx, AEField.CALL_DEPTH))
            frame = AtomExec_GetFrame(gpu, depth)
            ps = Dereference(Add(frame, AEFrame.PS_PTR))
            IfCondition NotEqual(ps, 0) ThenBlock: {
                val = Dereference(Add(ps, Multiply(idx, 4)), "dword")
            }
        }
        ElseBlock: {
        IfCondition EqualTo(arg, AtomArg.WS) ThenBlock: {
            idx = GetByte(rom, ip)
            ip = Add(ip, 1)
            IfCondition EqualTo(idx, AtomWS.QUOTIENT) ThenBlock: {
                val = Dereference(Add(ctx, AEField.DIVMUL_Q))
            }
            ElseBlock: {
            IfCondition EqualTo(idx, AtomWS.REMAINDER) ThenBlock: {
                val = Dereference(Add(ctx, AEField.DIVMUL_R))
            }
            ElseBlock: {
            IfCondition EqualTo(idx, AtomWS.DATAPTR) ThenBlock: {
                val = Dereference(Add(ctx, AEField.DATA_BLOCK))
            }
            ElseBlock: {
            IfCondition EqualTo(idx, AtomWS.SHIFT) ThenBlock: {
                val = Dereference(Add(ctx, AEField.SHIFT))
            }
            ElseBlock: {
            IfCondition EqualTo(idx, AtomWS.OR_MASK) ThenBlock: {
                val = ShiftLeft(1, Dereference(Add(ctx, AEField.SHIFT)))
            }
            ElseBlock: {
            IfCondition EqualTo(idx, AtomWS.AND_MASK) ThenBlock: {
                val = BitwiseNot(ShiftLeft(1, Dereference(Add(ctx, AEField.SHIFT))))
            }
            ElseBlock: {
            IfCondition EqualTo(idx, AtomWS.FB_WINDOW) ThenBlock: {
                val = Dereference(Add(ctx, AEField.FB_BASE))
            }
            ElseBlock: {
            IfCondition EqualTo(idx, AtomWS.ATTRIBUTES) ThenBlock: {
                val = Dereference(Add(ctx, AEField.IO_ATTR))
            }
            ElseBlock: {
            IfCondition EqualTo(idx, AtomWS.REGPTR) ThenBlock: {
                val = Dereference(Add(ctx, AEField.REG_BLOCK))
            }
            ElseBlock: {
                depth = Dereference(Add(ctx, AEField.CALL_DEPTH))
                frame = AtomExec_GetFrame(gpu, depth)
                ws = Dereference(Add(frame, AEFrame.WS_PTR))
                ws_size = Dereference(Add(frame, AEFrame.WS_SIZE))
                IfCondition LessThan(idx, ws_size) ThenBlock: {
                    val = Dereference(Add(ws, Multiply(idx, 4)), "dword")
                }
                ElseBlock: {
                    PrintMessage("AtomExec: WS index out of range: ")
                    PrintNumber(idx)
                    PrintMessage("\n")
                    val = 0
                }
            }
            }
            }
            }
            }
            }
            }
            }
            }
        }
        ElseBlock: {
        IfCondition EqualTo(arg, AtomArg.FB) ThenBlock: {
            idx = GetByte(rom, ip)
            ip = Add(ip, 1)
            fb_base = Dereference(Add(ctx, AEField.FB_BASE))
            scratch = Dereference(Add(ctx, AEField.SCRATCH_PTR))
            IfCondition NotEqual(scratch, 0) ThenBlock: {
                off = Multiply(Add(Divide(fb_base, 4), idx), 4)
                val = Dereference(Add(scratch, off), "dword")
            }
        }
        ElseBlock: {
        IfCondition EqualTo(arg, AtomArg.ID) ThenBlock: {
            off = AtomBIOS_ReadU16(rom, ip)
            ip = Add(ip, 2)
            data_block = Dereference(Add(ctx, AEField.DATA_BLOCK))
            val = AtomBIOS_ReadU32(rom, Add(data_block, off))
        }
        ElseBlock: {
        IfCondition EqualTo(arg, AtomArg.IMM) ThenBlock: {
            IfCondition EqualTo(align, AtomSrc.DWORD) ThenBlock: {
                val = AtomBIOS_ReadU32(rom, ip)
                ip = Add(ip, 4)
            }
            ElseBlock: {
            IfCondition LessEqual(align, AtomSrc.WORD16) ThenBlock: {
                val = AtomBIOS_ReadU16(rom, ip)
                ip = Add(ip, 2)
            }
            ElseBlock: {
                val = GetByte(rom, ip)
                ip = Add(ip, 1)
            }
            }
            StoreValue(ip_ptr, ip)
            ReturnValue(val)
        }
        ElseBlock: {
        IfCondition EqualTo(arg, AtomArg.PLL) ThenBlock: {
            idx = GetByte(rom, ip)
            ip = Add(ip, 1)
            val = AE_PLLRead(gpu, idx)
        }
        ElseBlock: {
        IfCondition EqualTo(arg, AtomArg.MC) ThenBlock: {
            idx = GetByte(rom, ip)
            ip = Add(ip, 1)
            val = AE_MCRead(gpu, idx)
        }
        ElseBlock: {
            val = 0
        }
        }
        }
        }
        }
        }
        }
        }

        // Save pre-masked value if requested
        IfCondition NotEqual(saved_ptr, 0) ThenBlock: {
            StoreValue(saved_ptr, val)
        }

        // Apply mask and shift
        mask = AE_GetMask(align)
        shift_v = AE_GetShift(align)
        val = BitwiseAnd(val, mask)
        val = ShiftRight(val, shift_v)

        StoreValue(ip_ptr, ip)
        ReturnValue(val)
    }
}

// =============================================================================
// AE_GetDst — decode destination operand (translates alignment via dst_to_src)
// =============================================================================
Function.AE_GetDst {
    Input: gpu: Integer
    Input: arg: Integer
    Input: attr: Integer
    Input: ip_ptr: Address
    Input: saved_ptr: Address
    Output: Integer
    Body: {
        row = BitwiseAnd(ShiftRight(attr, 3), 7)
        col = BitwiseAnd(ShiftRight(attr, 6), 3)
        src_align = AE_GetDstToSrc(row, col)
        new_attr = BitwiseOr(arg, ShiftLeft(src_align, 3))
        ReturnValue(AE_GetSrc(gpu, new_attr, ip_ptr, saved_ptr))
    }
}

// =============================================================================
// AE_SkipSrc — advance IP past a source operand without reading
// =============================================================================
Function.AE_SkipSrc {
    Input: attr: Integer
    Input: ip_ptr: Address
    Body: {
        arg = BitwiseAnd(attr, 7)
        align = BitwiseAnd(ShiftRight(attr, 3), 7)
        ip = Dereference(ip_ptr)

        IfCondition EqualTo(arg, AtomArg.REG) ThenBlock: { ip = Add(ip, 2) }
        ElseBlock: {
        IfCondition EqualTo(arg, AtomArg.ID) ThenBlock: { ip = Add(ip, 2) }
        ElseBlock: {
        IfCondition EqualTo(arg, AtomArg.IMM) ThenBlock: {
            IfCondition EqualTo(align, AtomSrc.DWORD) ThenBlock: { ip = Add(ip, 4) }
            ElseBlock: {
            IfCondition LessEqual(align, AtomSrc.WORD16) ThenBlock: { ip = Add(ip, 2) }
            ElseBlock: { ip = Add(ip, 1) }
            }
        }
        ElseBlock: {
            ip = Add(ip, 1)
        }
        }
        }

        StoreValue(ip_ptr, ip)
    }
}

// =============================================================================
// AE_SkipDst — advance IP past a destination operand
// =============================================================================
Function.AE_SkipDst {
    Input: arg: Integer
    Input: attr: Integer
    Input: ip_ptr: Address
    Body: {
        row = BitwiseAnd(ShiftRight(attr, 3), 7)
        col = BitwiseAnd(ShiftRight(attr, 6), 3)
        src_align = AE_GetDstToSrc(row, col)
        new_attr = BitwiseOr(arg, ShiftLeft(src_align, 3))
        AE_SkipSrc(new_attr, ip_ptr)
    }
}

// =============================================================================
// AE_PutDstFull — write value back to destination with read-modify-write
//
// gpu, arg, attr: destination specifiers
// ip_ptr: address pointing to destination operand location in ROM
// val: value to write (already masked/shifted by caller)
// saved: original pre-masked value from AE_GetDst
// =============================================================================
Function.AE_PutDstFull {
    Input: gpu: Integer
    Input: arg: Integer
    Input: ip_ptr: Address
    Input: val: Integer
    Input: saved: Integer
    Input: attr: Integer
    Body: {
        ctx = AtomExec_GetCtx(gpu)
        rom = Dereference(Add(ctx, AEField.ROM_PTR))
        ip = Dereference(ip_ptr)

        row = BitwiseAnd(ShiftRight(attr, 3), 7)
        col = BitwiseAnd(ShiftRight(attr, 6), 3)
        dst_align = AE_GetDstToSrc(row, col)
        shift_v = AE_GetShift(dst_align)
        mask = AE_GetMask(dst_align)

        val = ShiftLeft(val, shift_v)
        val = BitwiseAnd(val, mask)
        saved = BitwiseAnd(saved, BitwiseNot(mask))
        val = BitwiseOr(val, saved)

        dst_arg = BitwiseAnd(arg, 7)

        IfCondition EqualTo(dst_arg, AtomArg.REG) ThenBlock: {
            idx = AtomBIOS_ReadU16(rom, ip)
            idx = Add(idx, Dereference(Add(ctx, AEField.REG_BLOCK)))
            AE_RegWrite(gpu, idx, val)
        }
        ElseBlock: {
        IfCondition EqualTo(dst_arg, AtomArg.PS) ThenBlock: {
            idx = GetByte(rom, ip)
            depth = Dereference(Add(ctx, AEField.CALL_DEPTH))
            frame = AtomExec_GetFrame(gpu, depth)
            ps = Dereference(Add(frame, AEFrame.PS_PTR))
            IfCondition NotEqual(ps, 0) ThenBlock: {
                StoreValue(Add(ps, Multiply(idx, 4)), val, "dword")
            }
        }
        ElseBlock: {
        IfCondition EqualTo(dst_arg, AtomArg.WS) ThenBlock: {
            idx = GetByte(rom, ip)
            IfCondition EqualTo(idx, AtomWS.QUOTIENT) ThenBlock: {
                StoreValue(Add(ctx, AEField.DIVMUL_Q), val)
            }
            ElseBlock: {
            IfCondition EqualTo(idx, AtomWS.REMAINDER) ThenBlock: {
                StoreValue(Add(ctx, AEField.DIVMUL_R), val)
            }
            ElseBlock: {
            IfCondition EqualTo(idx, AtomWS.DATAPTR) ThenBlock: {
                StoreValue(Add(ctx, AEField.DATA_BLOCK), val)
            }
            ElseBlock: {
            IfCondition EqualTo(idx, AtomWS.SHIFT) ThenBlock: {
                StoreValue(Add(ctx, AEField.SHIFT), val)
            }
            ElseBlock: {
            IfCondition EqualTo(idx, AtomWS.FB_WINDOW) ThenBlock: {
                StoreValue(Add(ctx, AEField.FB_BASE), val)
            }
            ElseBlock: {
            IfCondition EqualTo(idx, AtomWS.ATTRIBUTES) ThenBlock: {
                StoreValue(Add(ctx, AEField.IO_ATTR), val)
            }
            ElseBlock: {
            IfCondition EqualTo(idx, AtomWS.REGPTR) ThenBlock: {
                StoreValue(Add(ctx, AEField.REG_BLOCK), val)
            }
            ElseBlock: {
                depth = Dereference(Add(ctx, AEField.CALL_DEPTH))
                frame = AtomExec_GetFrame(gpu, depth)
                ws = Dereference(Add(frame, AEFrame.WS_PTR))
                ws_size = Dereference(Add(frame, AEFrame.WS_SIZE))
                IfCondition LessThan(idx, ws_size) ThenBlock: {
                    StoreValue(Add(ws, Multiply(idx, 4)), val, "dword")
                }
            }
            }
            }
            }
            }
            }
            }
        }
        ElseBlock: {
        IfCondition EqualTo(dst_arg, AtomArg.FB) ThenBlock: {
            idx = GetByte(rom, ip)
            fb_base = Dereference(Add(ctx, AEField.FB_BASE))
            scratch = Dereference(Add(ctx, AEField.SCRATCH_PTR))
            IfCondition NotEqual(scratch, 0) ThenBlock: {
                off = Multiply(Add(Divide(fb_base, 4), idx), 4)
                StoreValue(Add(scratch, off), val, "dword")
            }
        }
        ElseBlock: {
        IfCondition EqualTo(dst_arg, AtomArg.PLL) ThenBlock: {
            idx = GetByte(rom, ip)
            AE_PLLWrite(gpu, idx, val)
        }
        ElseBlock: {
        IfCondition EqualTo(dst_arg, AtomArg.MC) ThenBlock: {
            idx = GetByte(rom, ip)
            AE_MCWrite(gpu, idx, val)
        }
        ElseBlock: {
            PrintMessage("AtomExec: PutDst unknown arg ")
            PrintNumber(dst_arg)
            PrintMessage("\n")
        }
        }
        }
        }
        }
        }

        StoreValue(ip_ptr, ip)
    }
}

// =============================================================================
// AE_GetSrcDirect — read an immediate value from ROM based on alignment
// Used by MASK to read inline mask, and SHIFT_LEFT/RIGHT for shift count
// =============================================================================
Function.AE_GetSrcDirect {
    Input: rom: Address
    Input: align: Integer
    Input: ip_ptr: Address
    Output: Integer
    Body: {
        ip = Dereference(ip_ptr)
        val = 0

        IfCondition EqualTo(align, AtomSrc.DWORD) ThenBlock: {
            val = AtomBIOS_ReadU32(rom, ip)
            ip = Add(ip, 4)
        }
        ElseBlock: {
        IfCondition LessEqual(align, AtomSrc.WORD16) ThenBlock: {
            val = AtomBIOS_ReadU16(rom, ip)
            ip = Add(ip, 2)
        }
        ElseBlock: {
            val = GetByte(rom, ip)
            ip = Add(ip, 1)
        }
        }

        StoreValue(ip_ptr, ip)
        ReturnValue(val)
    }
}
