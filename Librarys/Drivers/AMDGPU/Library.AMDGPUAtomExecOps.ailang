// AE_OpXor: dst = dst ^ src (via (a|b) & ~(a&b))
Function.AE_OpXor {
    Input: gpu: Integer
    Input: arg: Integer
    Body: {
        ctx = AtomExec_GetCtx(gpu)
        depth = Dereference(Add(ctx, AEField.CALL_DEPTH))
        frame = AtomExec_GetFrame(gpu, depth)
        ip_ptr = Add(frame, AEFrame.IP)
        rom = Dereference(Add(ctx, AEField.ROM_PTR))
        attr = GetByte(rom, Dereference(ip_ptr))
        StoreValue(ip_ptr, Add(Dereference(ip_ptr), 1))
        dptr = Allocate(8)
        StoreValue(dptr, Dereference(ip_ptr))
        saved = Allocate(8)
        StoreValue(saved, 0)
        dst = AE_GetDst(gpu, arg, attr, ip_ptr, saved)
        src = AE_GetSrc(gpu, attr, ip_ptr, 0)
        xor_or = BitwiseOr(dst, src)
        xor_and = BitwiseAnd(dst, src)
        dst = BitwiseAnd(xor_or, BitwiseNot(xor_and))
        AE_PutDstFull(gpu, arg, dptr, dst, Dereference(saved), attr)
        Deallocate(saved, 8)
        Deallocate(dptr, 8)
    }
}

// AE_OpShiftLeft: dst <<= shift_count (from stream, not src operand)
// Kernel: attr &= 0x38; attr |= atom_def_dst[attr>>3] << 6;
Function.AE_OpShiftLeft {
    Input: gpu: Integer
    Input: arg: Integer
    Body: {
        ctx = AtomExec_GetCtx(gpu)
        depth = Dereference(Add(ctx, AEField.CALL_DEPTH))
        frame = AtomExec_GetFrame(gpu, depth)
        ip_ptr = Add(frame, AEFrame.IP)
        rom = Dereference(Add(ctx, AEField.ROM_PTR))
        attr = GetByte(rom, Dereference(ip_ptr))
        StoreValue(ip_ptr, Add(Dereference(ip_ptr), 1))
        attr = BitwiseAnd(attr, 56)
        attr = BitwiseOr(attr, ShiftLeft(AE_GetDefDst(ShiftRight(attr, 3)), 6))
        dptr = Allocate(8)
        StoreValue(dptr, Dereference(ip_ptr))
        saved = Allocate(8)
        StoreValue(saved, 0)
        dst = AE_GetDst(gpu, arg, attr, ip_ptr, saved)
        shift_cnt = AE_GetSrcDirect(rom, AtomSrc.BYTE0, ip_ptr)
        dst = ShiftLeft(dst, shift_cnt)
        AE_PutDstFull(gpu, arg, dptr, dst, Dereference(saved), attr)
        Deallocate(saved, 8)
        Deallocate(dptr, 8)
    }
}

// AE_OpShiftRight: dst >>= shift_count (from stream)
// Kernel: attr &= 0x38; attr |= atom_def_dst[attr>>3] << 6;
Function.AE_OpShiftRight {
    Input: gpu: Integer
    Input: arg: Integer
    Body: {
        ctx = AtomExec_GetCtx(gpu)
        depth = Dereference(Add(ctx, AEField.CALL_DEPTH))
        frame = AtomExec_GetFrame(gpu, depth)
        ip_ptr = Add(frame, AEFrame.IP)
        rom = Dereference(Add(ctx, AEField.ROM_PTR))
        attr = GetByte(rom, Dereference(ip_ptr))
        StoreValue(ip_ptr, Add(Dereference(ip_ptr), 1))
        attr = BitwiseAnd(attr, 56)
        attr = BitwiseOr(attr, ShiftLeft(AE_GetDefDst(ShiftRight(attr, 3)), 6))
        dptr = Allocate(8)
        StoreValue(dptr, Dereference(ip_ptr))
        saved = Allocate(8)
        StoreValue(saved, 0)
        dst = AE_GetDst(gpu, arg, attr, ip_ptr, saved)
        shift_cnt = AE_GetSrcDirect(rom, AtomSrc.BYTE0, ip_ptr)
        dst = ShiftRight(dst, shift_cnt)
        AE_PutDstFull(gpu, arg, dptr, dst, Dereference(saved), attr)
        Deallocate(saved, 8)
        Deallocate(dptr, 8)
    }
}

// AE_OpShl: dst <<= src (shift count from source operand)
Function.AE_OpShl {
    Input: gpu: Integer
    Input: arg: Integer
    Body: {
        ctx = AtomExec_GetCtx(gpu)
        depth = Dereference(Add(ctx, AEField.CALL_DEPTH))
        frame = AtomExec_GetFrame(gpu, depth)
        ip_ptr = Add(frame, AEFrame.IP)
        rom = Dereference(Add(ctx, AEField.ROM_PTR))
        attr = GetByte(rom, Dereference(ip_ptr))
        StoreValue(ip_ptr, Add(Dereference(ip_ptr), 1))
        row = BitwiseAnd(ShiftRight(attr, 3), 7)
        col = BitwiseAnd(ShiftRight(attr, 6), 3)
        dst_align = AE_GetDstToSrc(row, col)
        dptr = Allocate(8)
        StoreValue(dptr, Dereference(ip_ptr))
        saved = Allocate(8)
        StoreValue(saved, 0)
        dst = AE_GetDst(gpu, arg, attr, ip_ptr, saved)
        dst = Dereference(saved)
        shift_cnt = AE_GetSrc(gpu, attr, ip_ptr, 0)
        dst = ShiftLeft(dst, shift_cnt)
        dst = BitwiseAnd(dst, AE_GetMask(dst_align))
        dst = ShiftRight(dst, AE_GetShift(dst_align))
        AE_PutDstFull(gpu, arg, dptr, dst, Dereference(saved), attr)
        Deallocate(saved, 8)
        Deallocate(dptr, 8)
    }
}

// AE_OpShr: dst >>= src (shift count from source operand)
Function.AE_OpShr {
    Input: gpu: Integer
    Input: arg: Integer
    Body: {
        ctx = AtomExec_GetCtx(gpu)
        depth = Dereference(Add(ctx, AEField.CALL_DEPTH))
        frame = AtomExec_GetFrame(gpu, depth)
        ip_ptr = Add(frame, AEFrame.IP)
        rom = Dereference(Add(ctx, AEField.ROM_PTR))
        attr = GetByte(rom, Dereference(ip_ptr))
        StoreValue(ip_ptr, Add(Dereference(ip_ptr), 1))
        row = BitwiseAnd(ShiftRight(attr, 3), 7)
        col = BitwiseAnd(ShiftRight(attr, 6), 3)
        dst_align = AE_GetDstToSrc(row, col)
        dptr = Allocate(8)
        StoreValue(dptr, Dereference(ip_ptr))
        saved = Allocate(8)
        StoreValue(saved, 0)
        dst = AE_GetDst(gpu, arg, attr, ip_ptr, saved)
        dst = Dereference(saved)
        shift_cnt = AE_GetSrc(gpu, attr, ip_ptr, 0)
        dst = ShiftRight(dst, shift_cnt)
        dst = BitwiseAnd(dst, AE_GetMask(dst_align))
        dst = ShiftRight(dst, AE_GetShift(dst_align))
        AE_PutDstFull(gpu, arg, dptr, dst, Dereference(saved), attr)
        Deallocate(saved, 8)
        Deallocate(dptr, 8)
    }
}

// AE_OpMove: dst = src
Function.AE_OpMove {
    Input: gpu: Integer
    Input: arg: Integer
    Body: {
        ctx = AtomExec_GetCtx(gpu)
        depth = Dereference(Add(ctx, AEField.CALL_DEPTH))
        frame = AtomExec_GetFrame(gpu, depth)
        ip_ptr = Add(frame, AEFrame.IP)
        rom = Dereference(Add(ctx, AEField.ROM_PTR))
        attr = GetByte(rom, Dereference(ip_ptr))
        StoreValue(ip_ptr, Add(Dereference(ip_ptr), 1))
        dptr = Allocate(8)
        StoreValue(dptr, Dereference(ip_ptr))
        saved = Allocate(8)
        StoreValue(saved, 3452816845)
        align_chk = BitwiseAnd(ShiftRight(attr, 3), 7)
        IfCondition NotEqual(align_chk, AtomSrc.DWORD) ThenBlock: {
            AE_GetDst(gpu, arg, attr, ip_ptr, saved)
        }
        ElseBlock: {
            AE_SkipDst(arg, attr, ip_ptr)
        }
        src = AE_GetSrc(gpu, attr, ip_ptr, 0)
        AE_PutDstFull(gpu, arg, dptr, src, Dereference(saved), attr)
        Deallocate(saved, 8)
        Deallocate(dptr, 8)
    }
}

// AE_OpClear: dst = 0
Function.AE_OpClear {
    Input: gpu: Integer
    Input: arg: Integer
    Body: {
        ctx = AtomExec_GetCtx(gpu)
        depth = Dereference(Add(ctx, AEField.CALL_DEPTH))
        frame = AtomExec_GetFrame(gpu, depth)
        ip_ptr = Add(frame, AEFrame.IP)
        rom = Dereference(Add(ctx, AEField.ROM_PTR))
        attr = GetByte(rom, Dereference(ip_ptr))
        StoreValue(ip_ptr, Add(Dereference(ip_ptr), 1))
        attr = BitwiseAnd(attr, 56)
        def_d = AE_GetDefDst(ShiftRight(attr, 3))
        attr = BitwiseOr(attr, ShiftLeft(def_d, 6))
        dptr = Allocate(8)
        StoreValue(dptr, Dereference(ip_ptr))
        saved = Allocate(8)
        StoreValue(saved, 0)
        AE_GetDst(gpu, arg, attr, ip_ptr, saved)
        AE_PutDstFull(gpu, arg, dptr, 0, Dereference(saved), attr)
        Deallocate(saved, 8)
        Deallocate(dptr, 8)
    }
}

// AE_OpMask: dst = (dst & mask) | src
Function.AE_OpMask {
    Input: gpu: Integer
    Input: arg: Integer
    Body: {
        ctx = AtomExec_GetCtx(gpu)
        depth = Dereference(Add(ctx, AEField.CALL_DEPTH))
        frame = AtomExec_GetFrame(gpu, depth)
        ip_ptr = Add(frame, AEFrame.IP)
        rom = Dereference(Add(ctx, AEField.ROM_PTR))
        attr = GetByte(rom, Dereference(ip_ptr))
        StoreValue(ip_ptr, Add(Dereference(ip_ptr), 1))
        dptr = Allocate(8)
        StoreValue(dptr, Dereference(ip_ptr))
        saved = Allocate(8)
        StoreValue(saved, 0)
        dst = AE_GetDst(gpu, arg, attr, ip_ptr, saved)
        align_v = BitwiseAnd(ShiftRight(attr, 3), 7)
        mask = AE_GetSrcDirect(rom, align_v, ip_ptr)
        src = AE_GetSrc(gpu, attr, ip_ptr, 0)
        dst = BitwiseOr(BitwiseAnd(dst, mask), src)
        AE_PutDstFull(gpu, arg, dptr, dst, Dereference(saved), attr)
        Deallocate(saved, 8)
        Deallocate(dptr, 8)
    }
}

// AE_OpCompare: set cs_equal and cs_above flags
Function.AE_OpCompare {
    Input: gpu: Integer
    Input: arg: Integer
    Body: {
        ctx = AtomExec_GetCtx(gpu)
        depth = Dereference(Add(ctx, AEField.CALL_DEPTH))
        frame = AtomExec_GetFrame(gpu, depth)
        ip_ptr = Add(frame, AEFrame.IP)
        rom = Dereference(Add(ctx, AEField.ROM_PTR))
        attr = GetByte(rom, Dereference(ip_ptr))
        StoreValue(ip_ptr, Add(Dereference(ip_ptr), 1))
        dst = AE_GetDst(gpu, arg, attr, ip_ptr, 0)
        src = AE_GetSrc(gpu, attr, ip_ptr, 0)
        IfCondition EqualTo(dst, src) ThenBlock: {
            StoreValue(Add(ctx, AEField.CS_EQUAL), 1)
        }
        ElseBlock: { StoreValue(Add(ctx, AEField.CS_EQUAL), 0) }
        IfCondition GreaterThan(dst, src) ThenBlock: {
            StoreValue(Add(ctx, AEField.CS_ABOVE), 1)
        }
        ElseBlock: { StoreValue(Add(ctx, AEField.CS_ABOVE), 0) }
    }
}

// AE_OpTest: set cs_equal = ((dst & src) == 0)
Function.AE_OpTest {
    Input: gpu: Integer
    Input: arg: Integer
    Body: {
        ctx = AtomExec_GetCtx(gpu)
        depth = Dereference(Add(ctx, AEField.CALL_DEPTH))
        frame = AtomExec_GetFrame(gpu, depth)
        ip_ptr = Add(frame, AEFrame.IP)
        rom = Dereference(Add(ctx, AEField.ROM_PTR))
        attr = GetByte(rom, Dereference(ip_ptr))
        StoreValue(ip_ptr, Add(Dereference(ip_ptr), 1))
        dst = AE_GetDst(gpu, arg, attr, ip_ptr, 0)
        src = AE_GetSrc(gpu, attr, ip_ptr, 0)
        StoreValue(Add(ctx, AEField.LAST_TEST_VAL), dst)
        StoreValue(Add(ctx, AEField.LAST_TEST_MASK), src)
        IfCondition EqualTo(BitwiseAnd(dst, src), 0) ThenBlock: {
            StoreValue(Add(ctx, AEField.CS_EQUAL), 1)
        }
        ElseBlock: { StoreValue(Add(ctx, AEField.CS_EQUAL), 0) }
    }
}

// AE_OpJump: conditional jump with loop detection
Function.AE_OpJump {
    Input: gpu: Integer
    Input: cond: Integer
    Body: {
        ctx = AtomExec_GetCtx(gpu)
        depth = Dereference(Add(ctx, AEField.CALL_DEPTH))
        frame = AtomExec_GetFrame(gpu, depth)
        ip_ptr = Add(frame, AEFrame.IP)
        rom = Dereference(Add(ctx, AEField.ROM_PTR))
        ip = Dereference(ip_ptr)
        target = AtomBIOS_ReadU16(rom, ip)
        StoreValue(ip_ptr, Add(ip, 2))

        cs_equal = Dereference(Add(ctx, AEField.CS_EQUAL))
        cs_above = Dereference(Add(ctx, AEField.CS_ABOVE))
        execute = 0

        IfCondition EqualTo(cond, AtomCond.ALWAYS) ThenBlock: { execute = 1 }
        IfCondition EqualTo(cond, AtomCond.EQUAL) ThenBlock: { execute = cs_equal }
        IfCondition EqualTo(cond, AtomCond.NOTEQUAL) ThenBlock: {
            IfCondition EqualTo(cs_equal, 0) ThenBlock: { execute = 1 }
        }
        IfCondition EqualTo(cond, AtomCond.ABOVE) ThenBlock: { execute = cs_above }
        IfCondition EqualTo(cond, AtomCond.ABOVEOREQUAL) ThenBlock: {
            IfCondition EqualTo(cs_above, 1) ThenBlock: { execute = 1 }
            ElseBlock: { execute = cs_equal }
        }
        IfCondition EqualTo(cond, AtomCond.BELOW) ThenBlock: {
            IfCondition EqualTo(cs_above, 0) ThenBlock: {
                IfCondition EqualTo(cs_equal, 0) ThenBlock: { execute = 1 }
            }
        }
        IfCondition EqualTo(cond, AtomCond.BELOWOREQUAL) ThenBlock: {
            IfCondition EqualTo(cs_above, 0) ThenBlock: { execute = 1 }
        }

        IfCondition EqualTo(execute, 1) ThenBlock: {
            tbl_start = Dereference(Add(frame, AEFrame.START))
            abs_target = Add(tbl_start, target)
            last_jump = Dereference(Add(frame, AEFrame.LAST_JUMP))
            IfCondition EqualTo(abs_target, last_jump) ThenBlock: {
                jc = Add(Dereference(Add(frame, AEFrame.JUMP_COUNT)), 1)
                StoreValue(Add(frame, AEFrame.JUMP_COUNT), jc)
                IfCondition GreaterThan(jc, AtomVM.LOOP_LIMIT) ThenBlock: {
                    poll_val = Dereference(Add(ctx, AEField.LAST_TEST_VAL))
                    poll_mask = Dereference(Add(ctx, AEField.LAST_TEST_MASK))
                    poll_reg = Dereference(Add(ctx, AEField.LAST_REG_READ))
                    poll_raw = Dereference(Add(ctx, AEField.LAST_REG_READ_VAL))
                    PrintMessage("AtomExec: Stuck in loop, aborting (")
                    PrintNumber(jc)
                    PrintMessage(" iters) polling reg=0x")
                    PrintHex(poll_reg)
                    PrintMessage(" raw_val=0x")
                    PrintHex(poll_raw)
                    PrintMessage(" poll_val=0x")
                    PrintHex(poll_val)
                    PrintMessage(" mask=0x")
                    PrintHex(poll_mask)
                    PrintMessage(" (val&mask)=0x")
                    PrintHex(BitwiseAnd(poll_val, poll_mask))
                    PrintMessage(" cond=")
                    PrintNumber(cond)
                    PrintMessage(" target_ip=0x")
                    PrintHex(abs_target)
                    PrintMessage("\n")
                    StoreValue(Add(frame, AEFrame.ABORT), 1)
                }
            }
            ElseBlock: {
                StoreValue(Add(frame, AEFrame.LAST_JUMP), abs_target)
                StoreValue(Add(frame, AEFrame.JUMP_COUNT), 0)
            }
            StoreValue(ip_ptr, abs_target)
        }
    }
}

// AE_OpSwitch: scan case entries, jump to match
Function.AE_OpSwitch {
    Input: gpu: Integer
    Body: {
        ctx = AtomExec_GetCtx(gpu)
        depth = Dereference(Add(ctx, AEField.CALL_DEPTH))
        frame = AtomExec_GetFrame(gpu, depth)
        ip_ptr = Add(frame, AEFrame.IP)
        rom = Dereference(Add(ctx, AEField.ROM_PTR))
        attr = GetByte(rom, Dereference(ip_ptr))
        StoreValue(ip_ptr, Add(Dereference(ip_ptr), 1))
        src = AE_GetSrc(gpu, attr, ip_ptr, 0)

        done = 0
        WhileLoop EqualTo(done, 0) {
            ip = Dereference(ip_ptr)
            marker = AtomBIOS_ReadU16(rom, ip)
            IfCondition EqualTo(marker, AtomVM.CASE_END) ThenBlock: {
                StoreValue(ip_ptr, Add(ip, 2))
                done = 1
            }
            ElseBlock: {
                case_byte = GetByte(rom, ip)
                IfCondition EqualTo(case_byte, AtomVM.CASE_MAGIC) ThenBlock: {
                    StoreValue(ip_ptr, Add(ip, 1))
                    case_attr = BitwiseOr(BitwiseAnd(attr, 56), AtomArg.IMM)
                    case_val = AE_GetSrc(gpu, case_attr, ip_ptr, 0)
                    ip = Dereference(ip_ptr)
                    case_target = AtomBIOS_ReadU16(rom, ip)
                    IfCondition EqualTo(case_val, src) ThenBlock: {
                        tbl_start = Dereference(Add(frame, AEFrame.START))
                        StoreValue(ip_ptr, Add(tbl_start, case_target))
                        done = 1
                    }
                    ElseBlock: { StoreValue(ip_ptr, Add(ip, 2)) }
                }
                ElseBlock: {
                    PrintMessage("AtomExec: Bad case in SWITCH\n")
                    done = 1
                }
            }
        }
    }
}

// AE_OpCallTable: nested table call
Function.AE_OpCallTable {
    Input: gpu: Integer
    Body: {
        ctx = AtomExec_GetCtx(gpu)
        depth = Dereference(Add(ctx, AEField.CALL_DEPTH))
        frame = AtomExec_GetFrame(gpu, depth)
        ip_ptr = Add(frame, AEFrame.IP)
        rom = Dereference(Add(ctx, AEField.ROM_PTR))
        ip = Dereference(ip_ptr)
        tbl_idx = GetByte(rom, ip)
        StoreValue(ip_ptr, Add(ip, 1))

        PrintMessage("[ATOM] CALLTABLE idx=")
        PrintNumber(tbl_idx)
        PrintMessage("\n")

        cmd_tbl = Dereference(Add(ctx, AEField.CMD_TABLE))
        tbl_base = AtomBIOS_ReadU16(rom, Add(cmd_tbl, Add(4, Multiply(tbl_idx, 2))))
        IfCondition NotEqual(tbl_base, 0) ThenBlock: {
            ps_ptr = Dereference(Add(frame, AEFrame.PS_PTR))
            ps_size = Dereference(Add(frame, AEFrame.PS_SIZE))
            ps_shift = Dereference(Add(frame, AEFrame.PS_SHIFT))
            child_ps = Add(ps_ptr, Multiply(ps_shift, 4))
            child_ps_size = Subtract(ps_size, ps_shift)
            IfCondition LessThan(child_ps_size, 0) ThenBlock: { child_ps_size = 0 }

            new_depth = Add(depth, 1)
            StoreValue(Add(ctx, AEField.CALL_DEPTH), new_depth)
            ret = AE_RunTable(gpu, tbl_idx, child_ps, child_ps_size)
            StoreValue(Add(ctx, AEField.CALL_DEPTH), depth)

            IfCondition NotEqual(ret, 0) ThenBlock: {
                StoreValue(Add(frame, AEFrame.ABORT), 1)
            }
        }
    }
}

// AE_OpDelay: busy-wait delay
// Each MMIO read (GRBM_STATUS @ 0x8010) takes ~200-500ns over PCI.
// Microsecond path: 5 reads per count unit ≈ 1-2.5µs per unit (conservative).
// Millisecond path: 5000 reads per count unit ≈ 1-2.5ms per unit (conservative).
// Overshooting is safe for POST; undershooting causes PLL lock / MC training failures.
Function.AE_OpDelay {
    Input: gpu: Integer
    Input: unit: Integer
    Body: {
        ctx = AtomExec_GetCtx(gpu)
        depth = Dereference(Add(ctx, AEField.CALL_DEPTH))
        frame = AtomExec_GetFrame(gpu, depth)
        ip_ptr = Add(frame, AEFrame.IP)
        rom = Dereference(Add(ctx, AEField.ROM_PTR))
        ip = Dereference(ip_ptr)
        count = GetByte(rom, ip)
        StoreValue(ip_ptr, Add(ip, 1))

        IfCondition EqualTo(unit, AtomUnit.MICROSEC) ThenBlock: {
            // ~5 MMIO reads per microsecond at ~200ns/read
            total_us = Multiply(count, 5)
            i = 0
            WhileLoop LessThan(i, total_us) {
                GPU_Rd32(gpu, 32784)
                i = Add(i, 1)
            }
        }
        ElseBlock: {
            // ~5000 MMIO reads per millisecond at ~200ns/read
            total_ms = Multiply(count, 5000)
            i = 0
            WhileLoop LessThan(i, total_ms) {
                GPU_Rd32(gpu, 32784)
                i = Add(i, 1)
            }
        }
    }
}

// AE_OpSetPort: set I/O mode
Function.AE_OpSetPort {
    Input: gpu: Integer
    Input: port_type: Integer
    Body: {
        ctx = AtomExec_GetCtx(gpu)
        depth = Dereference(Add(ctx, AEField.CALL_DEPTH))
        frame = AtomExec_GetFrame(gpu, depth)
        ip_ptr = Add(frame, AEFrame.IP)
        rom = Dereference(Add(ctx, AEField.ROM_PTR))

        IfCondition EqualTo(port_type, AtomPort.ATI) ThenBlock: {
            ip = Dereference(ip_ptr)
            port = AtomBIOS_ReadU16(rom, ip)
            StoreValue(ip_ptr, Add(ip, 2))
            IfCondition EqualTo(port, 0) ThenBlock: {
                StoreValue(Add(ctx, AEField.IO_MODE), AtomIO.MM)
            }
            ElseBlock: {
                StoreValue(Add(ctx, AEField.IO_MODE), BitwiseOr(AtomIO.IIO, port))
            }
        }
        ElseBlock: {
        IfCondition EqualTo(port_type, AtomPort.PCI) ThenBlock: {
            StoreValue(ip_ptr, Add(Dereference(ip_ptr), 1))
            StoreValue(Add(ctx, AEField.IO_MODE), AtomIO.PCI)
        }
        ElseBlock: {
            StoreValue(ip_ptr, Add(Dereference(ip_ptr), 1))
            StoreValue(Add(ctx, AEField.IO_MODE), AtomIO.SYSIO)
        }
        }
    }
}

// AE_OpSetRegBlock: set register block offset
Function.AE_OpSetRegBlock {
    Input: gpu: Integer
    Body: {
        ctx = AtomExec_GetCtx(gpu)
        depth = Dereference(Add(ctx, AEField.CALL_DEPTH))
        frame = AtomExec_GetFrame(gpu, depth)
        ip_ptr = Add(frame, AEFrame.IP)
        rom = Dereference(Add(ctx, AEField.ROM_PTR))
        ip = Dereference(ip_ptr)
        StoreValue(Add(ctx, AEField.REG_BLOCK), AtomBIOS_ReadU16(rom, ip))
        StoreValue(ip_ptr, Add(ip, 2))
    }
}

// AE_OpSetFBBase: set framebuffer base
Function.AE_OpSetFBBase {
    Input: gpu: Integer
    Body: {
        ctx = AtomExec_GetCtx(gpu)
        depth = Dereference(Add(ctx, AEField.CALL_DEPTH))
        frame = AtomExec_GetFrame(gpu, depth)
        ip_ptr = Add(frame, AEFrame.IP)
        rom = Dereference(Add(ctx, AEField.ROM_PTR))
        attr = GetByte(rom, Dereference(ip_ptr))
        StoreValue(ip_ptr, Add(Dereference(ip_ptr), 1))
        StoreValue(Add(ctx, AEField.FB_BASE), AE_GetSrc(gpu, attr, ip_ptr, 0))
    }
}

// AE_OpSetDataBlock: set data block offset
Function.AE_OpSetDataBlock {
    Input: gpu: Integer
    Body: {
        ctx = AtomExec_GetCtx(gpu)
        depth = Dereference(Add(ctx, AEField.CALL_DEPTH))
        frame = AtomExec_GetFrame(gpu, depth)
        ip_ptr = Add(frame, AEFrame.IP)
        rom = Dereference(Add(ctx, AEField.ROM_PTR))
        ip = Dereference(ip_ptr)
        idx = GetByte(rom, ip)
        StoreValue(ip_ptr, Add(ip, 1))

        IfCondition EqualTo(idx, 0) ThenBlock: {
            StoreValue(Add(ctx, AEField.DATA_BLOCK), 0)
        }
        ElseBlock: {
        IfCondition EqualTo(idx, 255) ThenBlock: {
            StoreValue(Add(ctx, AEField.DATA_BLOCK), Dereference(Add(frame, AEFrame.START)))
        }
        ElseBlock: {
            data_tbl = Dereference(Add(ctx, AEField.DATA_TABLE))
            StoreValue(Add(ctx, AEField.DATA_BLOCK), AtomBIOS_ReadU16(rom, Add(data_tbl, Add(4, Multiply(idx, 2)))))
        }
        }
    }
}
