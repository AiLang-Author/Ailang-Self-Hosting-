// Library.AMDGPUAtomExecOps.ailang — ATOM BIOS operation handlers

LibraryImport.Drivers.AMDGPU.AMDGPUFamily
LibraryImport.Drivers.AMDGPU.AMDGPUDiscover
LibraryImport.Drivers.AMDGPU.AMDGPUBAR
LibraryImport.Drivers.AMDGPU.AMDGPUAtomBIOS
LibraryImport.Drivers.AMDGPU.AMDGPUPM4Regs
LibraryImport.Drivers.AMDGPU.AMDGPUAtomExec
LibraryImport.Drivers.AMDGPU.AMDGPUAtomExecIO
LibraryImport.Drivers.AMDGPU.AMDGPUAtomExecDecode

// =============================================================================
// Helper: standard op preamble — get ctx/frame/ip/rom, read attr, advance IP
// Each op handler reads attr byte, decodes dst (with saved), reads src,
// computes result, writes back via PutDstFull.
// =============================================================================

// AE_OpAdd: dst = dst + src
Function.AE_OpAdd {
    Input: gpu: Integer
    Input: arg: Integer
    Body: {
        ctx = AtomExec_GetCtx(gpu)
        depth = Dereference(Add(ctx, AEField.CALL_DEPTH))
        frame = AtomExec_GetFrame(gpu, depth)
        ip_ptr = Add(frame, AEFrame.IP)
        rom = Dereference(Add(ctx, AEField.ROM_PTR))
        attr = GetByte(rom, Dereference(ip_ptr))
        StoreValue(ip_ptr, Add(Dereference(ip_ptr), 1))
        dptr = Allocate(8)
        StoreValue(dptr, Dereference(ip_ptr))
        saved = Allocate(8)
        StoreValue(saved, 0)
        dst = AE_GetDst(gpu, arg, attr, ip_ptr, saved)
        src = AE_GetSrc(gpu, attr, ip_ptr, 0)
        dst = Add(dst, src)
        AE_PutDstFull(gpu, arg, dptr, dst, Dereference(saved), attr)
        Deallocate(saved, 8)
        Deallocate(dptr, 8)
    }
}

// AE_OpSub: dst = dst - src
Function.AE_OpSub {
    Input: gpu: Integer
    Input: arg: Integer
    Body: {
        ctx = AtomExec_GetCtx(gpu)
        depth = Dereference(Add(ctx, AEField.CALL_DEPTH))
        frame = AtomExec_GetFrame(gpu, depth)
        ip_ptr = Add(frame, AEFrame.IP)
        rom = Dereference(Add(ctx, AEField.ROM_PTR))
        attr = GetByte(rom, Dereference(ip_ptr))
        StoreValue(ip_ptr, Add(Dereference(ip_ptr), 1))
        dptr = Allocate(8)
        StoreValue(dptr, Dereference(ip_ptr))
        saved = Allocate(8)
        StoreValue(saved, 0)
        dst = AE_GetDst(gpu, arg, attr, ip_ptr, saved)
        src = AE_GetSrc(gpu, attr, ip_ptr, 0)
        dst = Subtract(dst, src)
        AE_PutDstFull(gpu, arg, dptr, dst, Dereference(saved), attr)
        Deallocate(saved, 8)
        Deallocate(dptr, 8)
    }
}

// AE_OpMul: divmul_q = dst * src
Function.AE_OpMul {
    Input: gpu: Integer
    Input: arg: Integer
    Body: {
        ctx = AtomExec_GetCtx(gpu)
        depth = Dereference(Add(ctx, AEField.CALL_DEPTH))
        frame = AtomExec_GetFrame(gpu, depth)
        ip_ptr = Add(frame, AEFrame.IP)
        rom = Dereference(Add(ctx, AEField.ROM_PTR))
        attr = GetByte(rom, Dereference(ip_ptr))
        StoreValue(ip_ptr, Add(Dereference(ip_ptr), 1))
        dst = AE_GetDst(gpu, arg, attr, ip_ptr, 0)
        src = AE_GetSrc(gpu, attr, ip_ptr, 0)
        StoreValue(Add(ctx, AEField.DIVMUL_Q), Multiply(dst, src))
    }
}

// AE_OpDiv: divmul_q = dst / src, divmul_r = dst % src
Function.AE_OpDiv {
    Input: gpu: Integer
    Input: arg: Integer
    Body: {
        ctx = AtomExec_GetCtx(gpu)
        depth = Dereference(Add(ctx, AEField.CALL_DEPTH))
        frame = AtomExec_GetFrame(gpu, depth)
        ip_ptr = Add(frame, AEFrame.IP)
        rom = Dereference(Add(ctx, AEField.ROM_PTR))
        attr = GetByte(rom, Dereference(ip_ptr))
        StoreValue(ip_ptr, Add(Dereference(ip_ptr), 1))
        dst = AE_GetDst(gpu, arg, attr, ip_ptr, 0)
        src = AE_GetSrc(gpu, attr, ip_ptr, 0)
        IfCondition NotEqual(src, 0) ThenBlock: {
            StoreValue(Add(ctx, AEField.DIVMUL_Q), Divide(dst, src))
            StoreValue(Add(ctx, AEField.DIVMUL_R), Subtract(dst, Multiply(Divide(dst, src), src)))
        }
        ElseBlock: {
            StoreValue(Add(ctx, AEField.DIVMUL_Q), 0)
            StoreValue(Add(ctx, AEField.DIVMUL_R), 0)
        }
    }
}

// AE_OpAnd: dst = dst & src
Function.AE_OpAnd {
    Input: gpu: Integer
    Input: arg: Integer
    Body: {
        ctx = AtomExec_GetCtx(gpu)
        depth = Dereference(Add(ctx, AEField.CALL_DEPTH))
        frame = AtomExec_GetFrame(gpu, depth)
        ip_ptr = Add(frame, AEFrame.IP)
        rom = Dereference(Add(ctx, AEField.ROM_PTR))
        attr = GetByte(rom, Dereference(ip_ptr))
        StoreValue(ip_ptr, Add(Dereference(ip_ptr), 1))
        dptr = Allocate(8)
        StoreValue(dptr, Dereference(ip_ptr))
        saved = Allocate(8)
        StoreValue(saved, 0)
        dst = AE_GetDst(gpu, arg, attr, ip_ptr, saved)
        src = AE_GetSrc(gpu, attr, ip_ptr, 0)
        dst = BitwiseAnd(dst, src)
        AE_PutDstFull(gpu, arg, dptr, dst, Dereference(saved), attr)
        Deallocate(saved, 8)
        Deallocate(dptr, 8)
    }
}

