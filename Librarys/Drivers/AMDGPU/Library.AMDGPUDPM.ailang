//
// Library.AMDGPUDPM.ailang
//
// DPM (Dynamic Power Management) dispatch layer.
// Routes DPM operations to generation-specific backends based on GPUGen.
//
// Currently supports:
//   - GCN 1.0 (Southern Islands): Library.AMDGPUDPM_SI
//
// To add a new generation:
//   1. Create Library.AMDGPUDPM_<GEN>.ailang
//   2. Add LibraryImport below
//   3. Add IfCondition branch in each dispatch function
//
// USAGE
//   LibraryImport.Drivers.AMDGPU.AMDGPUDPM
//
// DEPENDS
//   LibraryImport.Drivers.AMDGPU.AMDGPUFamily
//   LibraryImport.Drivers.AMDGPU.AMDGPUDiscover
//   LibraryImport.Drivers.AMDGPU.AMDGPUDPM_SI

// =============================================================================
// DPM_Init — initialize DPM state for all GPUs
// =============================================================================
Function.DPM_Init {
    Body: {
        DPM_SI_Init()
    }
}

// =============================================================================
// DPM_Enable — enable DPM for a GPU
// =============================================================================
Function.DPM_Enable {
    Input: gpu: Integer
    Output: Integer
    Body: {
        gen = GPU_GetDeviceField(gpu, GPUDevField.GENERATION)
        IfCondition EqualTo(gen, GPUGen.SI) ThenBlock: {
            ReturnValue(DPM_SI_Enable(gpu))
        }
        PrintMessage("[DPM] Unsupported GPU generation for DPM\n")
        ReturnValue(0)
    }
}

// =============================================================================
// DPM_Disable — disable DPM for a GPU
// =============================================================================
Function.DPM_Disable {
    Input: gpu: Integer
    Output: Integer
    Body: {
        gen = GPU_GetDeviceField(gpu, GPUDevField.GENERATION)
        IfCondition EqualTo(gen, GPUGen.SI) ThenBlock: {
            ReturnValue(DPM_SI_Disable(gpu))
        }
        ReturnValue(0)
    }
}

// =============================================================================
// DPM_SetLevel — force a specific DPM level
// =============================================================================
Function.DPM_SetLevel {
    Input: gpu: Integer
    Input: level: Integer
    Output: Integer
    Body: {
        gen = GPU_GetDeviceField(gpu, GPUDevField.GENERATION)
        IfCondition EqualTo(gen, GPUGen.SI) ThenBlock: {
            ReturnValue(DPM_SI_SetLevel(gpu, level))
        }
        ReturnValue(0)
    }
}

// =============================================================================
// DPM_GetCurrentLevel — return current DPM level
// =============================================================================
Function.DPM_GetCurrentLevel {
    Input: gpu: Integer
    Output: Integer
    Body: {
        gen = GPU_GetDeviceField(gpu, GPUDevField.GENERATION)
        IfCondition EqualTo(gen, GPUGen.SI) ThenBlock: {
            ReturnValue(DPM_SI_GetCurrentLevel(gpu))
        }
        ReturnValue(-1)
    }
}

// =============================================================================
// DPM_PrintInfo — print DPM state
// =============================================================================
Function.DPM_PrintInfo {
    Input: gpu: Integer
    Body: {
        gen = GPU_GetDeviceField(gpu, GPUDevField.GENERATION)
        IfCondition EqualTo(gen, GPUGen.SI) ThenBlock: {
            DPM_SI_PrintInfo(gpu)
        }
    }
}

// =============================================================================
// DPM_Shutdown — full shutdown
// =============================================================================
Function.DPM_Shutdown {
    Input: gpu: Integer
    Body: {
        gen = GPU_GetDeviceField(gpu, GPUDevField.GENERATION)
        IfCondition EqualTo(gen, GPUGen.SI) ThenBlock: {
            DPM_SI_Shutdown(gpu)
        }
    }
}

// =============================================================================
// DPM_SetMode — set named performance mode
//   mode 0 = AUTO  (unforce, let SMC auto-throttle based on load)
//   mode 1 = LOW   (force level 0, idle/2D desktop, lowest clock)
//   mode 2 = HIGH  (force max level, compute/3D workload, max clock)
// =============================================================================
FixedPool.DPMMode {
    "AUTO":  Initialize=0
    "LOW":   Initialize=1
    "HIGH":  Initialize=2
}

Function.DPM_SetMode {
    Input: gpu: Integer
    Input: mode: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(mode, DPMMode.HIGH) ThenBlock: {
            // Force to highest level
            gen = GPU_GetDeviceField(gpu, GPUDevField.GENERATION)
            IfCondition EqualTo(gen, GPUGen.SI) ThenBlock: {
                dpm = DPM_SI_GetEntry(gpu)
                IfCondition EqualTo(dpm, 0) ThenBlock: { ReturnValue(0) }
                max_level = Subtract(Dereference(Add(dpm, DPMField.NUM_LEVELS)), 1)
                ReturnValue(DPM_SetLevel(gpu, max_level))
            }
        }
        IfCondition EqualTo(mode, DPMMode.LOW) ThenBlock: {
            ReturnValue(DPM_SetLevel(gpu, 0))
        }
        // AUTO: unforce all levels
        gen = GPU_GetDeviceField(gpu, GPUDevField.GENERATION)
        IfCondition EqualTo(gen, GPUGen.SI) ThenBlock: {
            dpm = DPM_SI_GetEntry(gpu)
            IfCondition EqualTo(dpm, 0) ThenBlock: { ReturnValue(0) }
            num_levels = Dereference(Add(dpm, DPMField.NUM_LEVELS))
            SMC_SendMessageArg(gpu, SMCMsg.SET_FORCED_LEVELS, 0)
            SMC_SendMessageArg(gpu, SMCMsg.SET_ENABLED_LEVELS, num_levels)
            ReturnValue(1)
        }
        ReturnValue(0)
    }
}
