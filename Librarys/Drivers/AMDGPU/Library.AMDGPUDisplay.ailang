//
// Library.AMDGPUDisplay.ailang
//
// DCE 6.x display engine helpers for Southern Islands (GCN 1.0).
// Provides CRTC pipe address lookup, active-pipe detection, and
// blank/unblank functions needed for safe SCLK reprogramming.
//
// CRTC pipe bases are non-uniform (evergreen_reg.h):
//   CRTC0=0x6DF0, CRTC1=0x79F0, CRTC2=0x105F0, CRTC3=0x111F0,
//   CRTC4=0x11DF0, CRTC5=0x129F0
//
// USAGE
//   LibraryImport.Drivers.AMDGPU.AMDGPUDisplay
// =============================================================================

LibraryImport.Drivers.AMDGPU.AMDGPUBAR
LibraryImport.Drivers.AMDGPU.AMDGPUPM4Regs
LibraryImport.Array

// =============================================================================
// DCE6_GetCRTCBase — return CRTC pipe base address for pipe 0-5
// Returns 0 for invalid pipe index.
// =============================================================================
Function.DCE6_GetCRTCBase {
    Input: pipe: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(pipe, 0) ThenBlock: { ReturnValue(DCE6Reg.CRTC0_BASE) }
        IfCondition EqualTo(pipe, 1) ThenBlock: { ReturnValue(DCE6Reg.CRTC1_BASE) }
        IfCondition EqualTo(pipe, 2) ThenBlock: { ReturnValue(DCE6Reg.CRTC2_BASE) }
        IfCondition EqualTo(pipe, 3) ThenBlock: { ReturnValue(DCE6Reg.CRTC3_BASE) }
        IfCondition EqualTo(pipe, 4) ThenBlock: { ReturnValue(DCE6Reg.CRTC4_BASE) }
        IfCondition EqualTo(pipe, 5) ThenBlock: { ReturnValue(DCE6Reg.CRTC5_BASE) }
        ReturnValue(0)
    }
}

// =============================================================================
// DCE6_GetGRPHBase — return graphics (DCP) base address for pipe 0-5
// Returns 0 for invalid pipe index.
// =============================================================================
Function.DCE6_GetGRPHBase {
    Input: pipe: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(pipe, 0) ThenBlock: { ReturnValue(DCE6Reg.GRPH0_BASE) }
        IfCondition EqualTo(pipe, 1) ThenBlock: { ReturnValue(DCE6Reg.GRPH1_BASE) }
        IfCondition EqualTo(pipe, 2) ThenBlock: { ReturnValue(DCE6Reg.GRPH2_BASE) }
        IfCondition EqualTo(pipe, 3) ThenBlock: { ReturnValue(DCE6Reg.GRPH3_BASE) }
        IfCondition EqualTo(pipe, 4) ThenBlock: { ReturnValue(DCE6Reg.GRPH4_BASE) }
        IfCondition EqualTo(pipe, 5) ThenBlock: { ReturnValue(DCE6Reg.GRPH5_BASE) }
        ReturnValue(0)
    }
}

// =============================================================================
// DCE6_IsCRTCActive — check if a CRTC pipe is enabled and has graphics output
// Returns 1 if CRTC_MASTER_EN is set, 0 otherwise.
// =============================================================================
Function.DCE6_IsCRTCActive {
    Input: gpu: Integer
    Input: pipe: Integer
    Output: Integer
    Body: {
        crtc_base = DCE6_GetCRTCBase(pipe)
        IfCondition EqualTo(crtc_base, 0) ThenBlock: { ReturnValue(0) }

        crtc_ctl = GPU_Rd32(gpu, Add(crtc_base, DCE6Reg.CRTC_CONTROL_OFF))
        master_en = BitwiseAnd(crtc_ctl, CRTCBits.CRTC_MASTER_EN)
        IfCondition EqualTo(master_en, 0) ThenBlock: { ReturnValue(0) }

        ReturnValue(1)
    }
}

// =============================================================================
// DCE6_BlankCRTC — force blank on a single CRTC pipe
//
// Sequence (from evergreen_mc_stop in radeon driver):
//   1. Wait for vblank first (so blank takes effect at frame boundary)
//   2. Lock CRTC updates
//   3. Set CRTC_BLANK_DATA_EN (bit 8) in CRTC_BLANK_CONTROL
//   4. Unlock CRTC updates
//
// Returns 1 on success, 0 on vblank timeout or invalid pipe.
// =============================================================================
Function.DCE6_BlankCRTC {
    Input: gpu: Integer
    Input: pipe: Integer
    Output: Integer
    Body: {
        crtc_base = DCE6_GetCRTCBase(pipe)
        IfCondition EqualTo(crtc_base, 0) ThenBlock: { ReturnValue(0) }

        // Check if already blanked
        blank_ctl = GPU_Rd32(gpu, Add(crtc_base, DCE6Reg.CRTC_BLANK_CONTROL_OFF))
        already = BitwiseAnd(blank_ctl, CRTCBits.CRTC_BLANK_DATA_EN)
        IfCondition NotEqual(already, 0) ThenBlock: { ReturnValue(1) }

        // Wait for vblank before blanking (radeon driver does this)
        vb_count = 0
        vb_ok = 0
        WhileLoop LessThan(vb_count, 100000) {
            status = GPU_Rd32(gpu, Add(crtc_base, DCE6Reg.CRTC_STATUS_OFF))
            IfCondition NotEqual(BitwiseAnd(status, CRTCBits.CRTC_V_BLANK), 0) ThenBlock: {
                vb_ok = 1
                ExitLoop
            }
            vb_count = Add(vb_count, 1)
        }

        // Lock CRTC update
        GPU_Wr32(gpu, Add(crtc_base, DCE6Reg.CRTC_UPDATE_LOCK_OFF), CRTCBits.CRTC_UPDATE_LOCK_BIT)

        // Set blank data enable
        blank_ctl = GPU_Rd32(gpu, Add(crtc_base, DCE6Reg.CRTC_BLANK_CONTROL_OFF))
        blank_ctl = BitwiseOr(blank_ctl, CRTCBits.CRTC_BLANK_DATA_EN)
        GPU_Wr32(gpu, Add(crtc_base, DCE6Reg.CRTC_BLANK_CONTROL_OFF), blank_ctl)

        // Unlock CRTC update
        GPU_Wr32(gpu, Add(crtc_base, DCE6Reg.CRTC_UPDATE_LOCK_OFF), 0)

        ReturnValue(vb_ok)
    }
}

// =============================================================================
// DCE6_UnblankCRTC — clear force-blank on a single CRTC pipe
//
// Sequence:
//   1. Lock CRTC updates
//   2. Clear CRTC_BLANK_DATA_EN in CRTC_BLANK_CONTROL
//   3. Unlock CRTC updates
//
// Returns 1 always.
// =============================================================================
Function.DCE6_UnblankCRTC {
    Input: gpu: Integer
    Input: pipe: Integer
    Output: Integer
    Body: {
        crtc_base = DCE6_GetCRTCBase(pipe)
        IfCondition EqualTo(crtc_base, 0) ThenBlock: { ReturnValue(0) }

        // Lock CRTC update
        GPU_Wr32(gpu, Add(crtc_base, DCE6Reg.CRTC_UPDATE_LOCK_OFF), CRTCBits.CRTC_UPDATE_LOCK_BIT)

        // Clear blank data enable
        blank_ctl = GPU_Rd32(gpu, Add(crtc_base, DCE6Reg.CRTC_BLANK_CONTROL_OFF))
        blank_ctl = BitwiseAnd(blank_ctl, Subtract(4294967295, CRTCBits.CRTC_BLANK_DATA_EN))
        GPU_Wr32(gpu, Add(crtc_base, DCE6Reg.CRTC_BLANK_CONTROL_OFF), blank_ctl)

        // Unlock CRTC update
        GPU_Wr32(gpu, Add(crtc_base, DCE6Reg.CRTC_UPDATE_LOCK_OFF), 0)

        ReturnValue(1)
    }
}

// =============================================================================
// DCE6_BlankAllActive — blank every active CRTC pipe (0-5)
// Returns number of CRTCs blanked.
// =============================================================================
Function.DCE6_BlankAllActive {
    Input: gpu: Integer
    Output: Integer
    Body: {
        blanked = 0
        pipe = 0
        WhileLoop LessThan(pipe, 6) {
            active = DCE6_IsCRTCActive(gpu, pipe)
            IfCondition EqualTo(active, 1) ThenBlock: {
                rc = DCE6_BlankCRTC(gpu, pipe)
                IfCondition EqualTo(rc, 1) ThenBlock: {
                    blanked = Add(blanked, 1)
                }
                IfCondition EqualTo(rc, 0) ThenBlock: {
                    PrintMessage("[DISPLAY] WARNING: vblank timeout on CRTC ")
                    PrintNumber(pipe)
                    PrintMessage(", blanked anyway\n")
                    blanked = Add(blanked, 1)
                }
            }
            pipe = Add(pipe, 1)
        }
        ReturnValue(blanked)
    }
}

// =============================================================================
// DCE6_UnblankAllActive — unblank every active CRTC pipe (0-5)
// Returns number of CRTCs unblanked.
// =============================================================================
Function.DCE6_UnblankAllActive {
    Input: gpu: Integer
    Output: Integer
    Body: {
        unblanked = 0
        pipe = 0
        WhileLoop LessThan(pipe, 6) {
            active = DCE6_IsCRTCActive(gpu, pipe)
            IfCondition EqualTo(active, 1) ThenBlock: {
                DCE6_UnblankCRTC(gpu, pipe)
                unblanked = Add(unblanked, 1)
            }
            pipe = Add(pipe, 1)
        }
        ReturnValue(unblanked)
    }
}

// =============================================================================
// DCE6_FullInit — full display controller initialization matching kernel dce6_resume
//
// The kernel initializes ALL display controller hardware even on headless cards.
// This includes: DCFE clock control per CRTC, CRTC_CONTROL disable, HPD interrupt
// disable, AFMT audio source control clear, DIG VBI/infoframe control, and
// interrupt status register clears.
//
// This matches kernel trace Phase 14 (lines 351762-352354) from bus2_all.txt.
// The I2C/EDID connector probing loop (~6700 writes) is skipped — not needed
// for compute and requires no hardware state changes.
//
// Must be called AFTER DPM is enabled (kernel does DCE init last in si_init).
// =============================================================================
Function.DCE6_FullInit {
    Input: gpu: Integer
    Output: Integer
    Body: {
        PrintMessage("[DCE6] Full display controller init...\n")

        // =================================================================
        // Step 1: DCFE clock control per CRTC — enable display front-end clocks
        // Kernel writes 0x00006260 to each CRTC's DCFE_CLOCK_CONTROL register
        // DCFE base addresses: CRTC0=0x6DF0, CRTC1=0x79F0, CRTC2=0x105F0,
        //   CRTC3=0x111F0, CRTC4=0x11DF0, CRTC5=0x129F0
        // =================================================================
        GPU_Wr32(gpu, 28144, 25184)     // 0x6DF0 = 0x00006260 (CRTC0 DCFE_CLOCK_CONTROL)
        GPU_Wr32(gpu, 31216, 25184)     // 0x79F0 = 0x00006260 (CRTC1)
        GPU_Wr32(gpu, 67056, 25184)     // 0x105F0 = 0x00006260 (CRTC2)
        GPU_Wr32(gpu, 70128, 25184)     // 0x111F0 = 0x00006260 (CRTC3)
        GPU_Wr32(gpu, 73200, 25184)     // 0x11DF0 = 0x00006260 (CRTC4)
        GPU_Wr32(gpu, 76272, 25184)     // 0x129F0 = 0x00006260 (CRTC5)

        // Companion register per CRTC (base + 0xB4 = status/config clear)
        GPU_Wr32(gpu, 28324, 0)         // 0x6EA4 = 0 (CRTC0)
        GPU_Wr32(gpu, 31396, 0)         // 0x7AA4 = 0 (CRTC1)
        GPU_Wr32(gpu, 67236, 0)         // 0x106A4 = 0 (CRTC2)
        GPU_Wr32(gpu, 70308, 0)         // 0x112A4 = 0 (CRTC3)
        GPU_Wr32(gpu, 73380, 0)         // 0x11EA4 = 0 (CRTC4)
        GPU_Wr32(gpu, 76452, 0)         // 0x12AA4 = 0 (CRTC5)

        // =================================================================
        // Step 2: Ensure all CRTCs disabled — write CRTC_CONTROL = 0x00400310
        // This value has CRTC_MASTER_EN=0 (bit 0 clear = CRTC off),
        // with default timing/pipeline settings preserved
        // CRTC_CONTROL = CRTC_base + 0x80
        // =================================================================
        GPU_Wr32(gpu, 28272, 4195088)   // 0x6E70 = 0x00400310 (CRTC0)
        GPU_Wr32(gpu, 31344, 4195088)   // 0x7A70 = 0x00400310 (CRTC1)
        GPU_Wr32(gpu, 67184, 4195088)   // 0x10670 = 0x00400310 (CRTC2)
        GPU_Wr32(gpu, 70256, 4195088)   // 0x11270 = 0x00400310 (CRTC3)
        GPU_Wr32(gpu, 73328, 4195088)   // 0x11E70 = 0x00400310 (CRTC4)
        GPU_Wr32(gpu, 76400, 4195088)   // 0x12A70 = 0x00400310 (CRTC5)

        // =================================================================
        // Step 3: Disable all HPD interrupts
        // DC_HPDx_INT_CONTROL = 0 for all 6 HPD pins
        // =================================================================
        GPU_Wr32(gpu, 3232, 0)          // 0x0CA0 = 0 (HPD1)
        GPU_Wr32(gpu, 3264, 0)          // 0x0CC0 = 0 (HPD2)
        GPU_Wr32(gpu, 3296, 0)          // 0x0CE0 = 0 (HPD3)
        GPU_Wr32(gpu, 3328, 0)          // 0x0D00 = 0 (HPD4)
        GPU_Wr32(gpu, 3360, 0)          // 0x0D20 = 0 (HPD5)
        GPU_Wr32(gpu, 3392, 0)          // 0x0D40 = 0 (HPD6)

        // =================================================================
        // Step 4: AFMT audio source control — clear/disable per connector
        // AFMT_AUDIO_SRC_CONTROL for connectors 0-5
        // Final kernel values: connectors 0-1 = 0x00030000, 2-5 = 0
        // =================================================================
        GPU_Wr32(gpu, 27848, 196608)    // 0x6CC8 = 0x00030000 (connector 0)
        GPU_Wr32(gpu, 30920, 196608)    // 0x78C8 = 0x00030000 (connector 1)
        GPU_Wr32(gpu, 66760, 0)         // 0x104C8 = 0 (connector 2)
        GPU_Wr32(gpu, 69832, 0)         // 0x110C8 = 0 (connector 3)
        GPU_Wr32(gpu, 72904, 0)         // 0x11CC8 = 0 (connector 4)
        GPU_Wr32(gpu, 75976, 0)         // 0x128C8 = 0 (connector 5)

        // AFMT companion register (all zero)
        GPU_Wr32(gpu, 27852, 0)         // 0x6CCC = 0
        GPU_Wr32(gpu, 30924, 0)         // 0x78CC = 0
        GPU_Wr32(gpu, 66764, 0)         // 0x104CC = 0
        GPU_Wr32(gpu, 69836, 0)         // 0x110CC = 0
        GPU_Wr32(gpu, 72908, 0)         // 0x11CCC = 0
        GPU_Wr32(gpu, 75980, 0)         // 0x128CC = 0

        // =================================================================
        // Step 5: DIG VBI packet control — clear all
        // AFMT_VBI_PACKET_CONTROL per DIG block
        // =================================================================
        GPU_Wr32(gpu, 27404, 0)         // 0x6B0C = 0 (DIG0)
        GPU_Wr32(gpu, 30476, 0)         // 0x770C = 0 (DIG1)
        GPU_Wr32(gpu, 66316, 0)         // 0x1030C = 0 (DIG2)
        GPU_Wr32(gpu, 69388, 0)         // 0x10F0C = 0 (DIG3)
        GPU_Wr32(gpu, 72460, 0)         // 0x11B0C = 0 (DIG4)
        GPU_Wr32(gpu, 75532, 0)         // 0x1270C = 0 (DIG5)

        // =================================================================
        // Step 6: DIG AFMT_INFOFRAME_CONTROL0 + AFMT_GENERIC
        // Kernel sets 0x00010000 for each
        // =================================================================
        GPU_Wr32(gpu, 27416, 65536)     // 0x6B18 = 0x00010000 (DIG0 INFOFRAME)
        GPU_Wr32(gpu, 27420, 65536)     // 0x6B1C = 0x00010000 (DIG0 GENERIC)
        GPU_Wr32(gpu, 30488, 65536)     // 0x7718 = 0x00010000 (DIG1)
        GPU_Wr32(gpu, 30492, 65536)     // 0x771C = 0x00010000 (DIG1)
        GPU_Wr32(gpu, 66328, 65536)     // 0x10318 = 0x00010000 (DIG2)
        GPU_Wr32(gpu, 66332, 65536)     // 0x1031C = 0x00010000 (DIG2)
        GPU_Wr32(gpu, 69400, 65536)     // 0x10F18 = 0x00010000 (DIG3)
        GPU_Wr32(gpu, 69404, 65536)     // 0x10F1C = 0x00010000 (DIG3)
        GPU_Wr32(gpu, 72472, 65536)     // 0x11B18 = 0x00010000 (DIG4)
        GPU_Wr32(gpu, 72476, 65536)     // 0x11B1C = 0x00010000 (DIG4)
        GPU_Wr32(gpu, 75544, 65536)     // 0x12718 = 0x00010000 (DIG5)
        GPU_Wr32(gpu, 75548, 65536)     // 0x1271C = 0x00010000 (DIG5)

        PrintMessage("[DCE6] Display controller init complete (6 CRTCs disabled, HPD/AFMT configured)\n")
        ReturnValue(1)
    }
}
