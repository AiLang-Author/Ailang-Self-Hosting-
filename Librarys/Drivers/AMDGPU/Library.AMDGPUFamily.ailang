//
// Library.AMDGPUFamily.ailang
//
// GPU family database: JSON-backed device identification.
// Loads gpu_devices.json for PCI device ID → generation/chip/ISA/CU mapping.
// AtomBIOS provides the definitive hardware config once BARs are mapped.
//
// USAGE
//   LibraryImport.Drivers.AMDGPU.AMDGPUFamily

LibraryImport.JSON

// =============================================================================
// GPU FAMILY / GENERATION CONSTANTS
// =============================================================================
FixedPool.GPUGen {
    "UNKNOWN":      Initialize=0
    "SI":           Initialize=1    // Southern Islands — GCN 1.0 (HD 7000)
    "CIK":          Initialize=2    // Sea Islands     — GCN 2.0 (R7/R9 2xx)
    "VI":           Initialize=3    // Volcanic Islands — GCN 3.0 (R9 Fury, 285/380)
    "POLARIS":      Initialize=4    // GCN 4.0 (RX 470/480/570/580)
    "VEGA":         Initialize=5    // GCN 5.0 (Vega 56/64)
    "NAVI10":       Initialize=6    // RDNA 1.0 (RX 5500/5600/5700)
    "NAVI2X":       Initialize=7    // RDNA 2.0 (RX 6x00)
    "NAVI3X":       Initialize=8    // RDNA 3.0 (RX 7x00)
}

// =============================================================================
// CHIP IDENTIFIERS (specific ASIC names)
// =============================================================================
FixedPool.GPUChip {
    "UNKNOWN":       Initialize=0
    // SI (GCN 1.0)
    "TAHITI":        Initialize=100   // HD 7970/7950
    "PITCAIRN":      Initialize=101   // HD 7870/7850
    "VERDE":         Initialize=102   // HD 7770/7750
    "OLAND":         Initialize=103   // HD 8570/8670, R5 240
    "HAINAN":        Initialize=104   // HD 8470
    // CIK (GCN 2.0)
    "BONAIRE":       Initialize=200   // R7 260X
    "HAWAII":        Initialize=201   // R9 290/290X
    "KAVERI":        Initialize=202   // APU
    "KABINI":        Initialize=203   // APU
    "MULLINS":       Initialize=204   // APU
    // VI (GCN 3.0)
    "ICELAND":       Initialize=300   // R7 340/350
    "TONGA":         Initialize=301   // R9 285/380
    "FIJI":          Initialize=302   // R9 Fury/Nano
    "CARRIZO":       Initialize=303   // APU
    "STONEY":        Initialize=304   // APU
    // POLARIS (GCN 4.0)
    "POLARIS10":     Initialize=400   // RX 480/470
    "POLARIS11":     Initialize=401   // RX 460
    "POLARIS12":     Initialize=402   // RX 540/550
    "VEGAM":         Initialize=403   // Vega-M (Intel+AMD)
    // VEGA (GCN 5.0)
    "VEGA10":        Initialize=500   // Vega 56/64
    "VEGA12":        Initialize=501   // Vega Pro (mobile)
    "VEGA20":        Initialize=502   // Radeon VII
    "RAVEN":         Initialize=503   // APU (2000/3000 series)
    "RENOIR":        Initialize=504   // APU (4000 series)
    // NAVI (RDNA 1.0)
    "NAVI10":        Initialize=600   // RX 5600/5700
    "NAVI12":        Initialize=601   // Pro 5600M
    "NAVI14":        Initialize=602   // RX 5500
    // NAVI2X (RDNA 2.0)
    "SIENNA":        Initialize=700   // RX 6800/6900 (Sienna Cichlid)
    "NAVY":          Initialize=701   // RX 6700 (Navy Flounder)
    "DIMGREY":       Initialize=702   // RX 6600 (Dimgrey Cavefish)
    "BEIGE":         Initialize=703   // RX 6400 (Beige Goby)
    // NAVI3X (RDNA 3.0)
    "NAVI31":        Initialize=800   // RX 7900
    "NAVI32":        Initialize=801   // RX 7800/7700
    "NAVI33":        Initialize=802   // RX 7600
}

// =============================================================================
// ISA VARIANT (determines shader compiler target)
// =============================================================================
FixedPool.GPUIsa {
    "UNKNOWN":       Initialize=0
    "GCN1":          Initialize=1    // SI: s_*, v_*, 64-wide wavefront
    "GCN2":          Initialize=2    // CIK: flat addressing, SDMA
    "GCN3":          Initialize=3    // VI: 16-bit packed, DPP
    "GCN4":          Initialize=4    // Polaris: minor GCN3 refinements
    "GCN5":          Initialize=5    // Vega: full FP16, NGG
    "RDNA1":         Initialize=6    // wave32/wave64 dual mode
    "RDNA2":         Initialize=7    // ray tracing, mesh shaders
    "RDNA3":         Initialize=8    // WMMA, dual-issue VALU
}

// =============================================================================
// DISPLAY ENGINE VERSION
// =============================================================================
FixedPool.GPUDce {
    "NONE":          Initialize=0
    "DCE6":          Initialize=1    // SI
    "DCE8":          Initialize=2    // CIK
    "DCE10":         Initialize=3    // VI
    "DCE11":         Initialize=4    // Polaris
    "DCN1":          Initialize=5    // Vega
    "DCN2":          Initialize=6    // RDNA1
    "DCN3":          Initialize=7    // RDNA2
    "DCN3_2":        Initialize=8    // RDNA3
}

// =============================================================================
// PER-GPU DETECTED STATE (one entry per discovered GPU)
// Max 8 GPUs supported.
// =============================================================================
FixedPool.GPUDevConst {
    "MAX_GPUS":       Initialize=8
    "ENTRY_SIZE":     Initialize=128   // bytes per GPU entry
    "VENDOR_AMD":     Initialize=4098  // 0x1002
}

// Layout of each 128-byte GPU entry in GPUDevList.entries:
//   +0:   pci_bus       (8 bytes)
//   +8:   pci_slot      (8 bytes)
//   +16:  pci_func      (8 bytes)
//   +24:  vendor_id     (8 bytes)
//   +32:  device_id     (8 bytes)
//   +40:  subsys_vendor (8 bytes)
//   +48:  subsys_device (8 bytes)
//   +56:  generation    (8 bytes) — GPUGen.*
//   +64:  chip          (8 bytes) — GPUChip.*
//   +72:  isa           (8 bytes) — GPUIsa.*
//   +80:  dce           (8 bytes) — GPUDce.*
//   +88:  max_cus       (8 bytes) — full chip CU count
//   +96:  vram_mb       (8 bytes) — detected VRAM in MB
//   +104: bar0_size     (8 bytes) — BAR0 size in bytes
//   +112: bar2_size     (8 bytes) — BAR2 (MMIO) size in bytes
//   +120: reserved      (8 bytes)
FixedPool.GPUDevField {
    "PCI_BUS":        Initialize=0
    "PCI_SLOT":       Initialize=8
    "PCI_FUNC":       Initialize=16
    "VENDOR_ID":      Initialize=24
    "DEVICE_ID":      Initialize=32
    "SUBSYS_VENDOR":  Initialize=40
    "SUBSYS_DEVICE":  Initialize=48
    "GENERATION":     Initialize=56
    "CHIP":           Initialize=64
    "ISA":            Initialize=72
    "DCE":            Initialize=80
    "MAX_CUS":        Initialize=88
    "VRAM_MB":        Initialize=96
    "BAR0_SIZE":      Initialize=104
    "BAR2_SIZE":      Initialize=112
}

FixedPool.GPUDevList {
    "entries":        Initialize=0, CanChange=True   // ptr to allocated buffer
    "count":          Initialize=0, CanChange=True   // number of discovered GPUs
}

// =============================================================================
// GPU FAMILY DATABASE — JSON-backed
// =============================================================================
FixedPool.GPUFamilyDB {
    "json_root":     Initialize=0, CanChange=True   // parsed JSON root tagged value
    "devices_obj":   Initialize=0, CanChange=True   // the "devices" SHash object
    "loaded":        Initialize=0, CanChange=True   // 1 if JSON loaded successfully
    "db_path":       Initialize=0, CanChange=True   // path to gpu_devices.json
}

// =============================================================================
// GPUFamily_IntToHex4 — convert integer to 4-char uppercase hex string
// e.g. 0x683D → "683D"
// =============================================================================
Function.GPUFamily_IntToHex4 {
    Input: val: Integer
    Output: Address
    Body: {
        hex = Allocate(5)
        i = 3
        WhileLoop GreaterEqual(i, 0) {
            nibble = BitwiseAnd(val, 15)
            IfCondition LessThan(nibble, 10) ThenBlock: {
                SetByte(hex, i, Add(48, nibble))    // '0'-'9'
            } ElseBlock: {
                SetByte(hex, i, Add(55, nibble))    // 'A'-'F'
            }
            val = Divide(val, 16)
            i = Subtract(i, 1)
        }
        SetByte(hex, 4, 0)
        ReturnValue(hex)
    }
}

// =============================================================================
// GPUFamily_LoadDB — load and parse gpu_devices.json
// Called once during discovery. Caches result in GPUFamilyDB.
// =============================================================================
Function.GPUFamily_LoadDB {
    Input: json_path: Address
    Body: {
        IfCondition EqualTo(GPUFamilyDB.loaded, 1) ThenBlock: {
            ReturnValue(0)
        }

        // Open and read the JSON file
        fd = SystemCall(2, json_path, 0, 0)   // SYS_OPEN, O_RDONLY
        IfCondition LessThan(fd, 0) ThenBlock: {
            PrintMessage("[AMDGPU] WARNING: cannot open gpu_devices.json\n")
            ReturnValue(0)
        }

        // Read up to 64KB
        buf = Allocate(65536)
        nread = SystemCall(0, fd, buf, 65535, 0, 0)   // SYS_READ
        SystemCall(3, fd, 0, 0, 0, 0)                 // SYS_CLOSE

        IfCondition LessEqual(nread, 0) ThenBlock: {
            Deallocate(buf, 65536)
            PrintMessage("[AMDGPU] WARNING: cannot read gpu_devices.json\n")
            ReturnValue(0)
        }

        // Null-terminate
        SetByte(buf, nread, 0)

        // Parse JSON
        GPUFamilyDB.json_root = ParseJSON(buf)
        Deallocate(buf, 65536)

        IfCondition EqualTo(GPUFamilyDB.json_root, 0) ThenBlock: {
            PrintMessage("[AMDGPU] WARNING: failed to parse gpu_devices.json\n")
            ReturnValue(0)
        }

        // Extract "devices" object
        root_obj = JSON.AsObject(GPUFamilyDB.json_root)
        IfCondition EqualTo(root_obj, 0) ThenBlock: {
            PrintMessage("[AMDGPU] WARNING: gpu_devices.json root is not an object\n")
            ReturnValue(0)
        }

        GPUFamilyDB.devices_obj = JSON.GetObject(root_obj, "devices")
        IfCondition EqualTo(GPUFamilyDB.devices_obj, 0) ThenBlock: {
            PrintMessage("[AMDGPU] WARNING: gpu_devices.json has no 'devices' key\n")
            ReturnValue(0)
        }

        GPUFamilyDB.loaded = 1
    }
}

// =============================================================================
// String → constant mappers
// =============================================================================
Function.GPUFamily_GenFromStr {
    Input: s: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(s, 0) ThenBlock: { ReturnValue(GPUGen.UNKNOWN) }
        IfCondition EqualTo(StringCompare(s, "SI"), 0)      ThenBlock: { ReturnValue(GPUGen.SI) }
        IfCondition EqualTo(StringCompare(s, "CIK"), 0)     ThenBlock: { ReturnValue(GPUGen.CIK) }
        IfCondition EqualTo(StringCompare(s, "VI"), 0)       ThenBlock: { ReturnValue(GPUGen.VI) }
        IfCondition EqualTo(StringCompare(s, "POLARIS"), 0)  ThenBlock: { ReturnValue(GPUGen.POLARIS) }
        IfCondition EqualTo(StringCompare(s, "VEGA"), 0)     ThenBlock: { ReturnValue(GPUGen.VEGA) }
        IfCondition EqualTo(StringCompare(s, "NAVI10"), 0)   ThenBlock: { ReturnValue(GPUGen.NAVI10) }
        IfCondition EqualTo(StringCompare(s, "NAVI2X"), 0)   ThenBlock: { ReturnValue(GPUGen.NAVI2X) }
        IfCondition EqualTo(StringCompare(s, "NAVI3X"), 0)   ThenBlock: { ReturnValue(GPUGen.NAVI3X) }
        ReturnValue(GPUGen.UNKNOWN)
    }
}

Function.GPUFamily_ChipFromStr {
    Input: s: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(s, 0) ThenBlock: { ReturnValue(GPUChip.UNKNOWN) }
        IfCondition EqualTo(StringCompare(s, "TAHITI"), 0)     ThenBlock: { ReturnValue(GPUChip.TAHITI) }
        IfCondition EqualTo(StringCompare(s, "PITCAIRN"), 0)   ThenBlock: { ReturnValue(GPUChip.PITCAIRN) }
        IfCondition EqualTo(StringCompare(s, "VERDE"), 0)      ThenBlock: { ReturnValue(GPUChip.VERDE) }
        IfCondition EqualTo(StringCompare(s, "OLAND"), 0)      ThenBlock: { ReturnValue(GPUChip.OLAND) }
        IfCondition EqualTo(StringCompare(s, "HAINAN"), 0)     ThenBlock: { ReturnValue(GPUChip.HAINAN) }
        IfCondition EqualTo(StringCompare(s, "BONAIRE"), 0)    ThenBlock: { ReturnValue(GPUChip.BONAIRE) }
        IfCondition EqualTo(StringCompare(s, "HAWAII"), 0)     ThenBlock: { ReturnValue(GPUChip.HAWAII) }
        IfCondition EqualTo(StringCompare(s, "TONGA"), 0)      ThenBlock: { ReturnValue(GPUChip.TONGA) }
        IfCondition EqualTo(StringCompare(s, "FIJI"), 0)       ThenBlock: { ReturnValue(GPUChip.FIJI) }
        IfCondition EqualTo(StringCompare(s, "POLARIS10"), 0)  ThenBlock: { ReturnValue(GPUChip.POLARIS10) }
        IfCondition EqualTo(StringCompare(s, "POLARIS11"), 0)  ThenBlock: { ReturnValue(GPUChip.POLARIS11) }
        IfCondition EqualTo(StringCompare(s, "POLARIS12"), 0)  ThenBlock: { ReturnValue(GPUChip.POLARIS12) }
        IfCondition EqualTo(StringCompare(s, "VEGA10"), 0)     ThenBlock: { ReturnValue(GPUChip.VEGA10) }
        IfCondition EqualTo(StringCompare(s, "VEGA20"), 0)     ThenBlock: { ReturnValue(GPUChip.VEGA20) }
        IfCondition EqualTo(StringCompare(s, "NAVI10"), 0)     ThenBlock: { ReturnValue(GPUChip.NAVI10) }
        IfCondition EqualTo(StringCompare(s, "NAVI14"), 0)     ThenBlock: { ReturnValue(GPUChip.NAVI14) }
        IfCondition EqualTo(StringCompare(s, "SIENNA"), 0)     ThenBlock: { ReturnValue(GPUChip.SIENNA) }
        IfCondition EqualTo(StringCompare(s, "NAVY"), 0)       ThenBlock: { ReturnValue(GPUChip.NAVY) }
        IfCondition EqualTo(StringCompare(s, "DIMGREY"), 0)    ThenBlock: { ReturnValue(GPUChip.DIMGREY) }
        IfCondition EqualTo(StringCompare(s, "BEIGE"), 0)      ThenBlock: { ReturnValue(GPUChip.BEIGE) }
        IfCondition EqualTo(StringCompare(s, "NAVI31"), 0)     ThenBlock: { ReturnValue(GPUChip.NAVI31) }
        IfCondition EqualTo(StringCompare(s, "NAVI32"), 0)     ThenBlock: { ReturnValue(GPUChip.NAVI32) }
        IfCondition EqualTo(StringCompare(s, "NAVI33"), 0)     ThenBlock: { ReturnValue(GPUChip.NAVI33) }
        ReturnValue(GPUChip.UNKNOWN)
    }
}

Function.GPUFamily_IsaFromStr {
    Input: s: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(s, 0) ThenBlock: { ReturnValue(GPUIsa.UNKNOWN) }
        IfCondition EqualTo(StringCompare(s, "GCN1"), 0)  ThenBlock: { ReturnValue(GPUIsa.GCN1) }
        IfCondition EqualTo(StringCompare(s, "GCN2"), 0)  ThenBlock: { ReturnValue(GPUIsa.GCN2) }
        IfCondition EqualTo(StringCompare(s, "GCN3"), 0)  ThenBlock: { ReturnValue(GPUIsa.GCN3) }
        IfCondition EqualTo(StringCompare(s, "GCN4"), 0)  ThenBlock: { ReturnValue(GPUIsa.GCN4) }
        IfCondition EqualTo(StringCompare(s, "GCN5"), 0)  ThenBlock: { ReturnValue(GPUIsa.GCN5) }
        IfCondition EqualTo(StringCompare(s, "RDNA1"), 0) ThenBlock: { ReturnValue(GPUIsa.RDNA1) }
        IfCondition EqualTo(StringCompare(s, "RDNA2"), 0) ThenBlock: { ReturnValue(GPUIsa.RDNA2) }
        IfCondition EqualTo(StringCompare(s, "RDNA3"), 0) ThenBlock: { ReturnValue(GPUIsa.RDNA3) }
        ReturnValue(GPUIsa.UNKNOWN)
    }
}

Function.GPUFamily_DceFromStr {
    Input: s: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(s, 0) ThenBlock: { ReturnValue(GPUDce.NONE) }
        IfCondition EqualTo(StringCompare(s, "NONE"), 0)    ThenBlock: { ReturnValue(GPUDce.NONE) }
        IfCondition EqualTo(StringCompare(s, "DCE6"), 0)    ThenBlock: { ReturnValue(GPUDce.DCE6) }
        IfCondition EqualTo(StringCompare(s, "DCE8"), 0)    ThenBlock: { ReturnValue(GPUDce.DCE8) }
        IfCondition EqualTo(StringCompare(s, "DCE10"), 0)   ThenBlock: { ReturnValue(GPUDce.DCE10) }
        IfCondition EqualTo(StringCompare(s, "DCE11"), 0)   ThenBlock: { ReturnValue(GPUDce.DCE11) }
        IfCondition EqualTo(StringCompare(s, "DCN1"), 0)    ThenBlock: { ReturnValue(GPUDce.DCN1) }
        IfCondition EqualTo(StringCompare(s, "DCN2"), 0)    ThenBlock: { ReturnValue(GPUDce.DCN2) }
        IfCondition EqualTo(StringCompare(s, "DCN3"), 0)    ThenBlock: { ReturnValue(GPUDce.DCN3) }
        IfCondition EqualTo(StringCompare(s, "DCN3.2"), 0)  ThenBlock: { ReturnValue(GPUDce.DCN3_2) }
        ReturnValue(GPUDce.NONE)
    }
}

// =============================================================================
// GPUFamily_Identify — look up device_id in JSON database
// Writes gen/chip/isa/dce/cus to entry_ptr.
// Falls back to UNKNOWN if device not in database.
// =============================================================================
Function.GPUFamily_Identify {
    Input: device_id: Integer
    Input: entry_ptr: Address
    Body: {
        gen  = GPUGen.UNKNOWN
        chip = GPUChip.UNKNOWN
        isa  = GPUIsa.UNKNOWN
        dce  = GPUDce.NONE
        cus  = 0

        IfCondition EqualTo(GPUFamilyDB.loaded, 1) ThenBlock: {
            // Convert device_id to hex key string
            hex_key = GPUFamily_IntToHex4(device_id)

            // Lookup in devices object
            dev_obj = JSON.GetObject(GPUFamilyDB.devices_obj, hex_key)
            Deallocate(hex_key, 5)

            IfCondition NotEqual(dev_obj, 0) ThenBlock: {
                // Read fields from JSON entry
                gen_str  = JSON.GetString(dev_obj, "gen")
                chip_str = JSON.GetString(dev_obj, "chip")
                isa_str  = JSON.GetString(dev_obj, "isa")
                dce_str  = JSON.GetString(dev_obj, "dce")
                cus      = JSON.GetNumber(dev_obj, "cus")

                gen  = GPUFamily_GenFromStr(gen_str)
                chip = GPUFamily_ChipFromStr(chip_str)
                isa  = GPUFamily_IsaFromStr(isa_str)
                dce  = GPUFamily_DceFromStr(dce_str)
            }
        }

        StoreValue(Add(entry_ptr, GPUDevField.GENERATION), gen)
        StoreValue(Add(entry_ptr, GPUDevField.CHIP), chip)
        StoreValue(Add(entry_ptr, GPUDevField.ISA), isa)
        StoreValue(Add(entry_ptr, GPUDevField.DCE), dce)
        StoreValue(Add(entry_ptr, GPUDevField.MAX_CUS), cus)
    }
}

// =============================================================================
// GPUFamily_Name — return human-readable chip name string
// =============================================================================
Function.GPUFamily_Name {
    Input: chip: Integer
    Output: Address
    Body: {
        IfCondition EqualTo(chip, GPUChip.TAHITI)     ThenBlock: { ReturnValue("Tahiti") }
        IfCondition EqualTo(chip, GPUChip.PITCAIRN)   ThenBlock: { ReturnValue("Pitcairn") }
        IfCondition EqualTo(chip, GPUChip.VERDE)      ThenBlock: { ReturnValue("Cape Verde") }
        IfCondition EqualTo(chip, GPUChip.OLAND)      ThenBlock: { ReturnValue("Oland") }
        IfCondition EqualTo(chip, GPUChip.HAINAN)     ThenBlock: { ReturnValue("Hainan") }
        IfCondition EqualTo(chip, GPUChip.BONAIRE)    ThenBlock: { ReturnValue("Bonaire") }
        IfCondition EqualTo(chip, GPUChip.HAWAII)     ThenBlock: { ReturnValue("Hawaii") }
        IfCondition EqualTo(chip, GPUChip.TONGA)      ThenBlock: { ReturnValue("Tonga") }
        IfCondition EqualTo(chip, GPUChip.FIJI)       ThenBlock: { ReturnValue("Fiji") }
        IfCondition EqualTo(chip, GPUChip.POLARIS10)  ThenBlock: { ReturnValue("Polaris 10") }
        IfCondition EqualTo(chip, GPUChip.POLARIS11)  ThenBlock: { ReturnValue("Polaris 11") }
        IfCondition EqualTo(chip, GPUChip.POLARIS12)  ThenBlock: { ReturnValue("Polaris 12") }
        IfCondition EqualTo(chip, GPUChip.VEGA10)     ThenBlock: { ReturnValue("Vega 10") }
        IfCondition EqualTo(chip, GPUChip.VEGA20)     ThenBlock: { ReturnValue("Vega 20") }
        IfCondition EqualTo(chip, GPUChip.NAVI10)     ThenBlock: { ReturnValue("Navi 10") }
        IfCondition EqualTo(chip, GPUChip.NAVI14)     ThenBlock: { ReturnValue("Navi 14") }
        IfCondition EqualTo(chip, GPUChip.SIENNA)     ThenBlock: { ReturnValue("Sienna Cichlid") }
        IfCondition EqualTo(chip, GPUChip.NAVY)       ThenBlock: { ReturnValue("Navy Flounder") }
        IfCondition EqualTo(chip, GPUChip.DIMGREY)    ThenBlock: { ReturnValue("Dimgrey Cavefish") }
        IfCondition EqualTo(chip, GPUChip.BEIGE)      ThenBlock: { ReturnValue("Beige Goby") }
        IfCondition EqualTo(chip, GPUChip.NAVI31)     ThenBlock: { ReturnValue("Navi 31") }
        IfCondition EqualTo(chip, GPUChip.NAVI32)     ThenBlock: { ReturnValue("Navi 32") }
        IfCondition EqualTo(chip, GPUChip.NAVI33)     ThenBlock: { ReturnValue("Navi 33") }
        ReturnValue("Unknown")
    }
}

// =============================================================================
// GPUFamily_GenName — return generation name string
// =============================================================================
Function.GPUFamily_GenName {
    Input: gen: Integer
    Output: Address
    Body: {
        IfCondition EqualTo(gen, GPUGen.SI)       ThenBlock: { ReturnValue("GCN 1.0 (Southern Islands)") }
        IfCondition EqualTo(gen, GPUGen.CIK)      ThenBlock: { ReturnValue("GCN 2.0 (Sea Islands)") }
        IfCondition EqualTo(gen, GPUGen.VI)        ThenBlock: { ReturnValue("GCN 3.0 (Volcanic Islands)") }
        IfCondition EqualTo(gen, GPUGen.POLARIS)   ThenBlock: { ReturnValue("GCN 4.0 (Polaris)") }
        IfCondition EqualTo(gen, GPUGen.VEGA)      ThenBlock: { ReturnValue("GCN 5.0 (Vega)") }
        IfCondition EqualTo(gen, GPUGen.NAVI10)    ThenBlock: { ReturnValue("RDNA 1.0 (Navi)") }
        IfCondition EqualTo(gen, GPUGen.NAVI2X)    ThenBlock: { ReturnValue("RDNA 2.0 (Navi 2x)") }
        IfCondition EqualTo(gen, GPUGen.NAVI3X)    ThenBlock: { ReturnValue("RDNA 3.0 (Navi 3x)") }
        ReturnValue("Unknown")
    }
}

// =============================================================================
// GPUFamily_IsaName — return ISA name string
// =============================================================================
Function.GPUFamily_IsaName {
    Input: isa: Integer
    Output: Address
    Body: {
        IfCondition EqualTo(isa, GPUIsa.GCN1)  ThenBlock: { ReturnValue("GCN 1 (gfx600)") }
        IfCondition EqualTo(isa, GPUIsa.GCN2)  ThenBlock: { ReturnValue("GCN 2 (gfx700)") }
        IfCondition EqualTo(isa, GPUIsa.GCN3)  ThenBlock: { ReturnValue("GCN 3 (gfx800)") }
        IfCondition EqualTo(isa, GPUIsa.GCN4)  ThenBlock: { ReturnValue("GCN 4 (gfx803)") }
        IfCondition EqualTo(isa, GPUIsa.GCN5)  ThenBlock: { ReturnValue("GCN 5 (gfx900)") }
        IfCondition EqualTo(isa, GPUIsa.RDNA1) ThenBlock: { ReturnValue("RDNA 1 (gfx1010)") }
        IfCondition EqualTo(isa, GPUIsa.RDNA2) ThenBlock: { ReturnValue("RDNA 2 (gfx1030)") }
        IfCondition EqualTo(isa, GPUIsa.RDNA3) ThenBlock: { ReturnValue("RDNA 3 (gfx1100)") }
        ReturnValue("Unknown")
    }
}
