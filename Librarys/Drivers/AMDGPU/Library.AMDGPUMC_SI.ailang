//
// Library.AMDGPUMC_SI.ailang — Memory Controller init for Southern Islands
//
// Implements MC firmware loading, VRAM training, and MC aperture programming
// for un-POSTed GPUs. On a POSTed GPU (system BIOS did the work), the MC
// sequencer is already running and training is already done — we skip.
//
// Reference: Linux kernel drivers/gpu/drm/radeon/si.c
//   - si_mc_load_microcode()
//   - si_mc_program()
//   - si_gpu_init() (subset)
//
// USAGE
//   LibraryImport.Drivers.AMDGPU.AMDGPUMC_SI

LibraryImport.Drivers.AMDGPU.AMDGPUFamily
LibraryImport.Drivers.AMDGPU.AMDGPUDiscover
LibraryImport.Drivers.AMDGPU.AMDGPUBAR
LibraryImport.Drivers.AMDGPU.AMDGPUPM4Regs

// =============================================================================
// VERDE IO MC REGISTER TABLE
// 36 pairs of (index, data) written via MC_SEQ_IO_DEBUG_INDEX/DATA
// before loading MC microcode. From si.c verde_io_mc_regs[36][2].
// =============================================================================
FixedPool.VerdeMCRegs {
    "COUNT":  Initialize=36
}

// MC_SI_LoadVerdeIORegs — write the 36 verde_io_mc_regs pairs
// Each pair: write index to MC_SEQ_IO_DEBUG_INDEX, data to MC_SEQ_IO_DEBUG_DATA
Function.MC_SI_LoadVerdeIORegs {
    Input: gpu: Integer
    Body: {
        // Pair 0-3
        GPU_Wr32(gpu, SIReg.MC_SEQ_IO_DEBUG_INDEX, 111)  // 0x6F
        GPU_Wr32(gpu, SIReg.MC_SEQ_IO_DEBUG_DATA, 50479104)  // 0x03044000
        GPU_Wr32(gpu, SIReg.MC_SEQ_IO_DEBUG_INDEX, 112)  // 0x70
        GPU_Wr32(gpu, SIReg.MC_SEQ_IO_DEBUG_DATA, 75579416)  // 0x0480C018
        GPU_Wr32(gpu, SIReg.MC_SEQ_IO_DEBUG_INDEX, 113)  // 0x71
        GPU_Wr32(gpu, SIReg.MC_SEQ_IO_DEBUG_DATA, 64)  // 0x00000040
        GPU_Wr32(gpu, SIReg.MC_SEQ_IO_DEBUG_INDEX, 114)  // 0x72
        GPU_Wr32(gpu, SIReg.MC_SEQ_IO_DEBUG_DATA, 16777216)  // 0x01000000

        // Pair 4-7
        GPU_Wr32(gpu, SIReg.MC_SEQ_IO_DEBUG_INDEX, 116)  // 0x74
        GPU_Wr32(gpu, SIReg.MC_SEQ_IO_DEBUG_DATA, 255)  // 0x000000FF
        GPU_Wr32(gpu, SIReg.MC_SEQ_IO_DEBUG_INDEX, 117)  // 0x75
        GPU_Wr32(gpu, SIReg.MC_SEQ_IO_DEBUG_DATA, 1324032)  // 0x00143400
        GPU_Wr32(gpu, SIReg.MC_SEQ_IO_DEBUG_INDEX, 118)  // 0x76
        GPU_Wr32(gpu, SIReg.MC_SEQ_IO_DEBUG_DATA, 149882880)  // 0x08EC0800
        GPU_Wr32(gpu, SIReg.MC_SEQ_IO_DEBUG_INDEX, 119)  // 0x77
        GPU_Wr32(gpu, SIReg.MC_SEQ_IO_DEBUG_DATA, 67108044)  // 0x040000CC

        // Pair 8-11
        GPU_Wr32(gpu, SIReg.MC_SEQ_IO_DEBUG_INDEX, 121)  // 0x79
        GPU_Wr32(gpu, SIReg.MC_SEQ_IO_DEBUG_DATA, 0)  // 0x00000000
        GPU_Wr32(gpu, SIReg.MC_SEQ_IO_DEBUG_INDEX, 122)  // 0x7A
        GPU_Wr32(gpu, SIReg.MC_SEQ_IO_DEBUG_DATA, 553648137)  // 0x21000409
        GPU_Wr32(gpu, SIReg.MC_SEQ_IO_DEBUG_INDEX, 124)  // 0x7C
        GPU_Wr32(gpu, SIReg.MC_SEQ_IO_DEBUG_DATA, 0)  // 0x00000000
        GPU_Wr32(gpu, SIReg.MC_SEQ_IO_DEBUG_INDEX, 125)  // 0x7D
        GPU_Wr32(gpu, SIReg.MC_SEQ_IO_DEBUG_DATA, 3892314112)  // 0xE8000000

        // Pair 12-15
        GPU_Wr32(gpu, SIReg.MC_SEQ_IO_DEBUG_INDEX, 126)  // 0x7E
        GPU_Wr32(gpu, SIReg.MC_SEQ_IO_DEBUG_DATA, 71895208)  // 0x044408A8
        GPU_Wr32(gpu, SIReg.MC_SEQ_IO_DEBUG_INDEX, 127)  // 0x7F
        GPU_Wr32(gpu, SIReg.MC_SEQ_IO_DEBUG_DATA, 3)  // 0x00000003
        GPU_Wr32(gpu, SIReg.MC_SEQ_IO_DEBUG_INDEX, 128)  // 0x80
        GPU_Wr32(gpu, SIReg.MC_SEQ_IO_DEBUG_DATA, 0)  // 0x00000000
        GPU_Wr32(gpu, SIReg.MC_SEQ_IO_DEBUG_INDEX, 129)  // 0x81
        GPU_Wr32(gpu, SIReg.MC_SEQ_IO_DEBUG_DATA, 16777216)  // 0x01000000

        // Pair 16-19
        GPU_Wr32(gpu, SIReg.MC_SEQ_IO_DEBUG_INDEX, 130)  // 0x82
        GPU_Wr32(gpu, SIReg.MC_SEQ_IO_DEBUG_DATA, 33554432)  // 0x02000000
        GPU_Wr32(gpu, SIReg.MC_SEQ_IO_DEBUG_INDEX, 131)  // 0x83
        GPU_Wr32(gpu, SIReg.MC_SEQ_IO_DEBUG_DATA, 0)  // 0x00000000
        GPU_Wr32(gpu, SIReg.MC_SEQ_IO_DEBUG_INDEX, 132)  // 0x84
        GPU_Wr32(gpu, SIReg.MC_SEQ_IO_DEBUG_DATA, 3824583924)  // 0xE3F3E4F4
        GPU_Wr32(gpu, SIReg.MC_SEQ_IO_DEBUG_INDEX, 133)  // 0x85
        GPU_Wr32(gpu, SIReg.MC_SEQ_IO_DEBUG_DATA, 335908)  // 0x00052024

        // Pair 20-23
        GPU_Wr32(gpu, SIReg.MC_SEQ_IO_DEBUG_INDEX, 135)  // 0x87
        GPU_Wr32(gpu, SIReg.MC_SEQ_IO_DEBUG_DATA, 0)  // 0x00000000
        GPU_Wr32(gpu, SIReg.MC_SEQ_IO_DEBUG_INDEX, 136)  // 0x88
        GPU_Wr32(gpu, SIReg.MC_SEQ_IO_DEBUG_DATA, 1711342083)  // 0x66036603
        GPU_Wr32(gpu, SIReg.MC_SEQ_IO_DEBUG_INDEX, 137)  // 0x89
        GPU_Wr32(gpu, SIReg.MC_SEQ_IO_DEBUG_DATA, 16777216)  // 0x01000000
        GPU_Wr32(gpu, SIReg.MC_SEQ_IO_DEBUG_INDEX, 139)  // 0x8B
        GPU_Wr32(gpu, SIReg.MC_SEQ_IO_DEBUG_DATA, 470286336)  // 0x1C0A0000

        // Pair 24-27
        GPU_Wr32(gpu, SIReg.MC_SEQ_IO_DEBUG_INDEX, 140)  // 0x8C
        GPU_Wr32(gpu, SIReg.MC_SEQ_IO_DEBUG_DATA, 4278255616)  // 0xFF010000
        GPU_Wr32(gpu, SIReg.MC_SEQ_IO_DEBUG_INDEX, 142)  // 0x8E
        GPU_Wr32(gpu, SIReg.MC_SEQ_IO_DEBUG_DATA, 4294963199)  // 0xFFFFEFFF
        GPU_Wr32(gpu, SIReg.MC_SEQ_IO_DEBUG_INDEX, 143)  // 0x8F
        GPU_Wr32(gpu, SIReg.MC_SEQ_IO_DEBUG_DATA, 4294377471)  // 0xFFF3EFFF
        GPU_Wr32(gpu, SIReg.MC_SEQ_IO_DEBUG_INDEX, 144)  // 0x90
        GPU_Wr32(gpu, SIReg.MC_SEQ_IO_DEBUG_DATA, 4294377407)  // 0xFFF3EFBF

        // Pair 28-31
        GPU_Wr32(gpu, SIReg.MC_SEQ_IO_DEBUG_INDEX, 148)  // 0x94
        GPU_Wr32(gpu, SIReg.MC_SEQ_IO_DEBUG_DATA, 1052929)  // 0x00101101
        GPU_Wr32(gpu, SIReg.MC_SEQ_IO_DEBUG_INDEX, 149)  // 0x95
        GPU_Wr32(gpu, SIReg.MC_SEQ_IO_DEBUG_DATA, 4095)  // 0x00000FFF
        GPU_Wr32(gpu, SIReg.MC_SEQ_IO_DEBUG_INDEX, 150)  // 0x96
        GPU_Wr32(gpu, SIReg.MC_SEQ_IO_DEBUG_DATA, 1142783)  // 0x00116FFF
        GPU_Wr32(gpu, SIReg.MC_SEQ_IO_DEBUG_INDEX, 151)  // 0x97
        GPU_Wr32(gpu, SIReg.MC_SEQ_IO_DEBUG_DATA, 1610678272)  // 0x60010000

        // Pair 32-35
        GPU_Wr32(gpu, SIReg.MC_SEQ_IO_DEBUG_INDEX, 152)  // 0x98
        GPU_Wr32(gpu, SIReg.MC_SEQ_IO_DEBUG_DATA, 268500992)  // 0x10010000
        GPU_Wr32(gpu, SIReg.MC_SEQ_IO_DEBUG_INDEX, 153)  // 0x99
        GPU_Wr32(gpu, SIReg.MC_SEQ_IO_DEBUG_DATA, 24576)  // 0x00006000
        GPU_Wr32(gpu, SIReg.MC_SEQ_IO_DEBUG_INDEX, 154)  // 0x9A
        GPU_Wr32(gpu, SIReg.MC_SEQ_IO_DEBUG_DATA, 4096)  // 0x00001000
        GPU_Wr32(gpu, SIReg.MC_SEQ_IO_DEBUG_INDEX, 159)  // 0x9F
        GPU_Wr32(gpu, SIReg.MC_SEQ_IO_DEBUG_DATA, 10711040)  // 0x00A37400

        PrintMessage("[MC_SI] Verde IO MC regs loaded (36 pairs)\n")
    }
}

// =============================================================================
// MC_SI_LoadMicrocode — load MC firmware and run VRAM training
//
// Follows kernel si_mc_load_microcode():
//   1. Check if MC sequencer already running (POSTed GPU) → skip
//   2. Reset sequencer (MC_SEQ_SUP_CNTL = 0x08)
//   3. Enable write (MC_SEQ_SUP_CNTL = 0x10)
//   4. Write verde_io_mc_regs via MC_SEQ_IO_DEBUG_INDEX/DATA
//   5. Stream MC firmware via MC_SEQ_SUP_PGM
//   6. Reset (0x08), load (0x04), start (0x01)
//   7. Poll MC_SEQ_TRAIN_WAKEUP_CNTL for TRAIN_DONE_D0/D1
//
// The firmware file (VERDE_mc2.bin) is old format: raw big-endian 32-bit words.
// Must byte-swap to LE before GPU_Wr32 (same as SMC firmware loading).
//
// Returns 1 on success, 0 if already running (skip), negative on error.
// =============================================================================
Function.MC_SI_LoadMicrocode {
    Input: gpu: Integer
    Output: Integer
    Body: {
        // DISPLAY GPU GUARD — never touch MC firmware on the display GPU.
        // The BIOS already loaded MC firmware and trained VRAM.  Reloading
        // resets the MC sequencer which kills the VESA framebuffer.
        IfCondition EqualTo(GPU_BAR_IsDisplayGPU(gpu), 1) ThenBlock: {
            PrintMessage("[MC_SI] LoadMicrocode: REFUSED — display GPU (BIOS already configured)\n")
            ReturnValue(0)
        }

        // Always reload firmware (kernel does this unconditionally on unposted cards)
        running = BitwiseAnd(GPU_Rd32(gpu, SIReg.MC_SEQ_SUP_CNTL), MCSeqBits.RUN_MASK)
        IfCondition NotEqual(running, 0) ThenBlock: {
            PrintMessage("[MC_SI] MC sequencer was running (SUP_CNTL=0x")
            PrintHex(GPU_Rd32(gpu, SIReg.MC_SEQ_SUP_CNTL))
            PrintMessage(") — reloading firmware anyway\n")
        }

        PrintMessage("[MC_SI] Loading MC sequencer firmware...\n")

        // Read pre-init state for diagnostics
        PrintMessage("[MC_SI] Pre-init: MC_SEQ_MISC0=0x")
        PrintHex(GPU_Rd32(gpu, SIReg.MC_SEQ_MISC0))
        PrintMessage(" CONFIG_MEMSIZE=")
        PrintNumber(GPU_Rd32(gpu, SIReg.CONFIG_MEMSIZE))
        PrintMessage("MB\n")

        // --- Step 1: Reset MC sequencer ---
        GPU_Wr32(gpu, SIReg.MC_SEQ_SUP_CNTL, 8)    // 0x08 = reset
        GPU_Wr32(gpu, SIReg.MC_SEQ_SUP_CNTL, 16)   // 0x10 = write enable

        // --- Step 2: Load Verde IO MC register table ---
        MC_SI_LoadVerdeIORegs(gpu)

        // --- Step 3: Load MC firmware from /lib/firmware/amdgpu/verde_mc.bin ---
        // amdgpu format: 40-byte header, io_mc_regs at offset 256, ucode at offset 544
        // All data is little-endian (no byte swap needed).
        // Header fields (LE32):
        //   [20] ucode_size_bytes    (= 31500 = 7875 dwords)
        //   [24] ucode_array_offset  (= 544 = 0x220)
        fw_path = Allocate(64)
        // "/lib/firmware/amdgpu/verde_mc.bin"
        SetByte(fw_path, 0, 47)   // /
        SetByte(fw_path, 1, 108)  // l
        SetByte(fw_path, 2, 105)  // i
        SetByte(fw_path, 3, 98)   // b
        SetByte(fw_path, 4, 47)   // /
        SetByte(fw_path, 5, 102)  // f
        SetByte(fw_path, 6, 105)  // i
        SetByte(fw_path, 7, 114)  // r
        SetByte(fw_path, 8, 109)  // m
        SetByte(fw_path, 9, 119)  // w
        SetByte(fw_path, 10, 97)  // a
        SetByte(fw_path, 11, 114) // r
        SetByte(fw_path, 12, 101) // e
        SetByte(fw_path, 13, 47)  // /
        SetByte(fw_path, 14, 97)  // a
        SetByte(fw_path, 15, 109) // m
        SetByte(fw_path, 16, 100) // d
        SetByte(fw_path, 17, 103) // g
        SetByte(fw_path, 18, 112) // p
        SetByte(fw_path, 19, 117) // u
        SetByte(fw_path, 20, 47)  // /
        SetByte(fw_path, 21, 118) // v
        SetByte(fw_path, 22, 101) // e
        SetByte(fw_path, 23, 114) // r
        SetByte(fw_path, 24, 100) // d
        SetByte(fw_path, 25, 101) // e
        SetByte(fw_path, 26, 95)  // _
        SetByte(fw_path, 27, 109) // m
        SetByte(fw_path, 28, 99)  // c
        SetByte(fw_path, 29, 46)  // .
        SetByte(fw_path, 30, 98)  // b
        SetByte(fw_path, 31, 105) // i
        SetByte(fw_path, 32, 110) // n
        SetByte(fw_path, 33, 0)   // NUL

        fw_fd = SystemCall(2, fw_path, 0, 0)    // open(path, O_RDONLY)
        IfCondition LessThan(fw_fd, 0) ThenBlock: {
            PrintMessage("[MC_SI] ERROR: Cannot open /lib/firmware/amdgpu/verde_mc.bin\n")
            Deallocate(fw_path, 64)
            ReturnValue(-1)
        }

        // Read entire firmware file (32044 bytes expected)
        fw_max = 33792
        fw_buf = Allocate(fw_max)
        fw_size = SystemCall(0, fw_fd, fw_buf, fw_max, 0, 0)  // read
        SystemCall(3, fw_fd, 0, 0, 0, 0)                       // close
        Deallocate(fw_path, 64)

        IfCondition LessEqual(fw_size, 544) ThenBlock: {
            PrintMessage("[MC_SI] ERROR: Firmware too small\n")
            Deallocate(fw_buf, fw_max)
            ReturnValue(-2)
        }

        PrintMessage("[MC_SI] Firmware loaded: ")
        PrintNumber(fw_size)
        PrintMessage(" bytes\n")

        // Parse header: ucode_size_bytes at offset 20, ucode_array_offset at offset 24
        uc_size_b0 = GetByte(fw_buf, 20)
        uc_size_b1 = GetByte(fw_buf, 21)
        uc_size_b2 = GetByte(fw_buf, 22)
        uc_size_b3 = GetByte(fw_buf, 23)
        uc_size = BitwiseOr(uc_size_b0, BitwiseOr(LeftShift(uc_size_b1, 8), BitwiseOr(LeftShift(uc_size_b2, 16), LeftShift(uc_size_b3, 24))))
        fw_dwords = Divide(uc_size, 4)

        uc_off_b0 = GetByte(fw_buf, 24)
        uc_off_b1 = GetByte(fw_buf, 25)
        uc_off_b2 = GetByte(fw_buf, 26)
        uc_off_b3 = GetByte(fw_buf, 27)
        uc_off = BitwiseOr(uc_off_b0, BitwiseOr(LeftShift(uc_off_b1, 8), BitwiseOr(LeftShift(uc_off_b2, 16), LeftShift(uc_off_b3, 24))))

        PrintMessage("[MC_SI] ucode: ")
        PrintNumber(fw_dwords)
        PrintMessage(" DWORDs at offset ")
        PrintNumber(uc_off)
        PrintMessage("\n")

        // Stream ucode words to MC_SEQ_SUP_PGM (little-endian, no swap)
        fi = 0
        WhileLoop LessThan(fi, fw_dwords) {
            off = Add(uc_off, Multiply(fi, 4))
            b0 = GetByte(fw_buf, off)
            b1 = GetByte(fw_buf, Add(off, 1))
            b2 = GetByte(fw_buf, Add(off, 2))
            b3 = GetByte(fw_buf, Add(off, 3))
            le_word = BitwiseOr(b0, BitwiseOr(LeftShift(b1, 8), BitwiseOr(LeftShift(b2, 16), LeftShift(b3, 24))))
            GPU_Wr32(gpu, SIReg.MC_SEQ_SUP_PGM, le_word)
            fi = Add(fi, 1)
        }

        PrintMessage("[MC_SI] Firmware uploaded: ")
        PrintNumber(fw_dwords)
        PrintMessage(" DWORDs\n")

        Deallocate(fw_buf, fw_max)

        // --- Step 4: Start MC sequencer ---
        GPU_Wr32(gpu, SIReg.MC_SEQ_SUP_CNTL, 8)    // 0x08 = reset
        GPU_Wr32(gpu, SIReg.MC_SEQ_SUP_CNTL, 4)    // 0x04 = load
        GPU_Wr32(gpu, SIReg.MC_SEQ_SUP_CNTL, 1)    // 0x01 = start (RUN)

        PrintMessage("[MC_SI] MC sequencer started, waiting for VRAM training...\n")

        // --- Step 5: Poll for VRAM training completion ---
        // Wait for TRAIN_DONE_D0 (bit 30) — timeout ~2 seconds
        d0_done = 0
        poll_i = 0
        WhileLoop LessThan(poll_i, 2000000) {
            train_val = GPU_Rd32(gpu, SIReg.MC_SEQ_TRAIN_WAKEUP_CNTL)
            IfCondition NotEqual(BitwiseAnd(train_val, MCSeqBits.TRAIN_DONE_D0), 0) ThenBlock: {
                d0_done = 1
                poll_i = 2000000  // break
            }
            // ~1us delay (busy-spin — AILang has no usleep)
            poll_i = Add(poll_i, 1)
        }

        IfCondition EqualTo(d0_done, 0) ThenBlock: {
            PrintMessage("[MC_SI] WARNING: TRAIN_DONE_D0 timeout\n")
        }
        ElseBlock: {
            PrintMessage("[MC_SI] TRAIN_DONE_D0 OK\n")
        }

        // Wait for TRAIN_DONE_D1 (bit 31)
        d1_done = 0
        poll_j = 0
        WhileLoop LessThan(poll_j, 2000000) {
            train_val2 = GPU_Rd32(gpu, SIReg.MC_SEQ_TRAIN_WAKEUP_CNTL)
            IfCondition NotEqual(BitwiseAnd(train_val2, MCSeqBits.TRAIN_DONE_D1), 0) ThenBlock: {
                d1_done = 1
                poll_j = 2000000  // break
            }
            poll_j = Add(poll_j, 1)
        }

        IfCondition EqualTo(d1_done, 0) ThenBlock: {
            PrintMessage("[MC_SI] WARNING: TRAIN_DONE_D1 timeout\n")
        }
        ElseBlock: {
            PrintMessage("[MC_SI] TRAIN_DONE_D1 OK\n")
        }

        // --- Diagnostics ---
        PrintMessage("[MC_SI] Post-training: MC_SEQ_MISC0=0x")
        PrintHex(GPU_Rd32(gpu, SIReg.MC_SEQ_MISC0))
        PrintMessage(" CONFIG_MEMSIZE=")
        PrintNumber(GPU_Rd32(gpu, SIReg.CONFIG_MEMSIZE))
        PrintMessage("MB\n")
        PrintMessage("[MC_SI] MC_SEQ_TRAIN_WAKEUP_CNTL=0x")
        PrintHex(GPU_Rd32(gpu, SIReg.MC_SEQ_TRAIN_WAKEUP_CNTL))
        PrintMessage("\n")

        IfCondition EqualTo(d0_done, 1) ThenBlock: {
            IfCondition EqualTo(d1_done, 1) ThenBlock: {
                PrintMessage("[MC_SI] VRAM training PASSED\n")
                ReturnValue(1)
            }
        }

        PrintMessage("[MC_SI] VRAM training INCOMPLETE\n")
        ReturnValue(-3)
    }
}

// =============================================================================
// MC_SI_Program — program MC aperture for un-POSTed GPU
//
// Follows kernel si_mc_program():
//   1. Zero 32 HDP protection buffer entries
//   2. Flush HDP coherency
//   3. Blackout MC: BIF_FB_EN=0, MC_SHARED_BLACKOUT_CNTL|=1
//   4. Lock out VGA aperture
//   5. Program MC_VM_FB_LOCATION, system aperture, HDP nonsurface, AGP
//   6. Unblackout: clear BLACKOUT_MODE, BIF_FB_EN = RW
//
// For un-POSTed headless compute GPUs there are no CRTCs to blank, so we skip
// the full evergreen_mc_stop/resume CRTC blanking sequence.
//
// Uses vram_start=0 (kernel default for SI).
// CONFIG_MEMSIZE must be valid (MC firmware must be loaded first).
//
// Returns 1 on success, negative on error.
// =============================================================================
Function.MC_SI_Program {
    Input: gpu: Integer
    Output: Integer
    Body: {
        // DISPLAY GPU GUARD — never reprogram MC aperture on the display GPU.
        // BIF_FB_EN=0 kills CPU VRAM access (VESA framebuffer goes black),
        // MC_VM_FB_LOCATION reprogram stomps the BIOS-configured aperture,
        // and MC blackout blocks all memory ops.  The display GPU is already
        // fully configured by the BIOS.
        IfCondition EqualTo(GPU_BAR_IsDisplayGPU(gpu), 1) ThenBlock: {
            PrintMessage("[MC_SI] Program: REFUSED — display GPU (BIOS already configured)\n")
            ReturnValue(0)
        }

        PrintMessage("[MC_SI] Programming MC aperture...\n")

        // Read BIOS-configured MC_VM_FB_LOCATION to get the existing base address.
        // The BIOS places VRAM at a specific MC address (e.g. 0xF400 in 16MB units
        // = physical 0xF4_0000_0000). We MUST preserve this base.
        bios_fb_loc = GPU_Rd32(gpu, SIReg.MC_VM_FB_LOCATION)
        fb_base_16mb = BitwiseAnd(bios_fb_loc, 65535)

        // Read VRAM size from CONFIG_MEMSIZE (set by MC firmware training)
        memsize_mb = GPU_Rd32(gpu, SIReg.CONFIG_MEMSIZE)
        IfCondition EqualTo(memsize_mb, 0) ThenBlock: {
            PrintMessage("[MC_SI] ERROR: CONFIG_MEMSIZE = 0 (MC firmware not loaded?)\n")
            ReturnValue(-1)
        }
        // Also handle garbage in upper 16 bits (kernel si_mc_init check)
        IfCondition NotEqual(BitwiseAnd(memsize_mb, 4294901760), 0) ThenBlock: {
            // 0xFFFF0000 = 4294901760
            IfCondition NotEqual(BitwiseAnd(memsize_mb, 65535), 0) ThenBlock: {
                memsize_mb = BitwiseAnd(memsize_mb, 65535)
            }
        }
        PrintMessage("[MC_SI] CONFIG_MEMSIZE = ")
        PrintNumber(memsize_mb)
        PrintMessage(" MB\n")

        // Compute top in 16MB units: base + (memsize/16) - 1
        // Kernel: mc_fb_top = mc_fb_base + rdev->mc.mc_vram_size >> 24
        // For 1GB: top = base + 64 - 1 = base + 63
        top_16mb = Subtract(Add(fb_base_16mb, Divide(memsize_mb, 16)), 1)

        // vram_end_bytes = (memsize_mb << 20) - 1
        // vram_end_page  = vram_end_bytes >> 12 = (memsize_mb << 8) - 1
        vram_end_page = Subtract(LeftShift(memsize_mb, 8), 1)

        // --- HDP protection registers REMOVED — all HDP writes crash RD990 ---

        // --- Step 2: MC blackout (simplified — no CRTCs on headless compute GPU) ---
        // Block CPU access to framebuffer
        GPU_Wr32(gpu, SIReg.BIF_FB_EN, 0)
        // Blackout MC
        blackout = GPU_Rd32(gpu, SIReg.MC_SHARED_BLACKOUT_CNTL)
        blackout = BitwiseAnd(blackout, 4294967294)  // clear bit 0 (BLACKOUT_MODE_MASK)
        GPU_Wr32(gpu, SIReg.MC_SHARED_BLACKOUT_CNTL, BitwiseOr(blackout, 1))

        // Brief delay for MC to settle (kernel does udelay(100))
        settle_i = 0
        WhileLoop LessThan(settle_i, 100000) {
            settle_i = Add(settle_i, 1)
        }

        // --- Step 3: Lock out VGA aperture ---
        GPU_Wr32(gpu, SIReg.VGA_HDP_CONTROL, MCSeqBits.VGA_MEMORY_DISABLE)

        // --- Step 4: Program MC_VM_FB_LOCATION ---
        // Kernel 3-step sequence (mmiotrace seq 2477-2482):
        //   1. Write base only (top=0): 0x0000F400
        //   2. Write base|base:         0xF400F400
        //   3. Write final top|base:    0xF43FF400
        GPU_Wr32(gpu, SIReg.MC_VM_FB_LOCATION, fb_base_16mb)
        GPU_Wr32(gpu, SIReg.MC_VM_FB_LOCATION, BitwiseOr(LeftShift(fb_base_16mb, 16), fb_base_16mb))
        fb_loc = BitwiseOr(LeftShift(top_16mb, 16), fb_base_16mb)
        GPU_Wr32(gpu, SIReg.MC_VM_FB_LOCATION, fb_loc)

        // HDP_NONSURFACE_BASE — kernel writes (vram_start >> 8) at seq 2483
        GPU_Wr32(gpu, SIReg.HDP_NONSURFACE_BASE, LeftShift(fb_base_16mb, 16))

        // NOTE: System aperture and AGP writes happen LATER in PM4_ConfigureVM
        // (kernel Phase 7, seq 4119-4124), NOT during MC blackout.

        PrintMessage("[MC_SI] MC_VM_FB_LOCATION = 0x")
        PrintHex(fb_loc)
        PrintMessage("  (top_16mb=")
        PrintNumber(top_16mb)
        PrintMessage(")\n")

        // --- Step 5: Un-blackout MC ---
        // Clear blackout mode
        blackout2 = GPU_Rd32(gpu, SIReg.MC_SHARED_BLACKOUT_CNTL)
        blackout2 = BitwiseAnd(blackout2, 4294967294)  // clear bit 0
        GPU_Wr32(gpu, SIReg.MC_SHARED_BLACKOUT_CNTL, blackout2)
        // Re-enable CPU access: FB_READ_EN | FB_WRITE_EN = 1 | 2 = 3
        GPU_Wr32(gpu, SIReg.BIF_FB_EN, 3)

        // --- Step 6: Verify ---
        PrintMessage("[MC_SI] Post-program: MC_VM_FB_LOCATION=0x")
        PrintHex(GPU_Rd32(gpu, SIReg.MC_VM_FB_LOCATION))
        PrintMessage("\n")
        PrintMessage("[MC_SI] SYSTEM_APERTURE: low=0x")
        PrintHex(GPU_Rd32(gpu, SIReg.MC_VM_SYSTEM_APERTURE_LOW_ADDR))
        PrintMessage(" high=0x")
        PrintHex(GPU_Rd32(gpu, SIReg.MC_VM_SYSTEM_APERTURE_HIGH_ADDR))
        PrintMessage("\n")

        PrintMessage("[MC_SI] MC aperture programmed OK\n")
        ReturnValue(1)
    }
}

// =============================================================================
// MC_SI_GpuInit — full si_gpu_init() equivalent for Cape Verde
//
// Programs the GPU engine configuration after MC firmware + aperture setup.
// This is a reimplementation of the kernel's si_gpu_init() from si.c.
//
// Includes:
//   1. GRBM_GFX_INDEX broadcast mode (CRITICAL — per-pipe regs need this)
//   2. GRBM_CNTL read timeout
//   3. SRBM interrupt init
//   4. BIF_FB_EN
//   5. MC_ARB_RAMCFG → ROW_SIZE adjustment for GB_ADDR_CONFIG
//   6. Address config broadcast (GB, DMIF, HDP, DMA)
//   7. Tiling mode table (GB_TILE_MODE0-31, Verde values)
//   8. Per-SE render backend setup (si_setup_rb)
//   9. Per-SE/SH SPI thread management (si_setup_spi)
//  10. 3D engine defaults
//  11. PA_CL_ENHANCE
//
// SKIPPED (deadlock risk on RD990 — see gpu-crash.md Fix #2):
//   - HDP_MISC_CNTL |= HDP_FLUSH_INVALIDATE_CACHE (CPU-side)
//   - HDP_HOST_PATH_CNTL read-modify-write (CPU-side)
//   These are done GPU-side via PM4 WRITE_DATA in the dispatch path.
//
// Returns 1 on success.
// =============================================================================
Function.MC_SI_GpuInit {
    Input: gpu: Integer
    Output: Integer
    Body: {
        // DISPLAY GPU GUARD — never run si_gpu_init on the display GPU.
        // Overwrites DMIF_ADDR_CONFIG (corrupts scanout address decode),
        // writes GRBM_GFX_INDEX broadcast mode, reprograms GB_TILE_MODE
        // table, PA_SC_RASTER_CONFIG, SPI thread mgmt, and 3D engine
        // defaults — all of which stomp the BIOS-configured display engine.
        IfCondition EqualTo(GPU_BAR_IsDisplayGPU(gpu), 1) ThenBlock: {
            PrintMessage("[MC_SI] GpuInit: REFUSED — display GPU (BIOS already configured)\n")
            ReturnValue(0)
        }

        PrintMessage("[MC_SI] GPU engine init (si_gpu_init)...\n")

        // ---------------------------------------------------------------
        // Golden registers — ordered to match kernel mmiotrace EXACTLY.
        //
        // Sequence follows amdgpu si_gpu_init (seq 3641-3809):
        //   1. Misc golden regs (0x5EF0, 0x0C78, 0x5BB0, 0x5BC0)
        //   2. Context regs (0x28A4C, 0x28350)
        //   3. GFX golden (SPI_CONFIG_CNTL, SX_DEBUG_1, TA/TCP)
        //   4. VM fault + HDP misc (0x15C0, 0x14B0-0x14BC)
        //   5. GB_ADDR_CONFIG + CP regs
        //   6. RLC_CGTT_MGCG_OVERRIDE (clock gating disable)
        //   7. GRBM_GFX_INDEX broadcast → CGTT per-block overrides
        //   8. GRBM_GFX_INDEX broadcast → CU steering table
        //   9. CGTS_SM_CTRL_REG + RLC_CGCG_CGLS_CTRL
        //  10. Tail regs (0x160C, 0x1024, 0x102C, 0x55E4, 0x55E8, 0x30CC)
        //
        // NOTE: AtomBIOS ASIC_INIT already set BIF_FB_EN=3.  GRBM writes
        // are posted (fire-and-forget) so no GRBM_CNTL timeout needed.
        // GRBM_CNTL/SRBM_INT/BIF_FB_EN re-written later at Phase 10.
        // ---------------------------------------------------------------

        // --- Part 1: Misc golden regs (seq 3641-3658) ---
        GPU_Wr32(gpu, 24304, 17)                   // 0x5EF0 = 0x00000011 (seq 3641)
        GPU_Wr32(gpu, 39440, 98824)                // 0x9A10 = 0x00018208 (seq 3643)
        GPU_Wr32(gpu, 38960, 0)                    // 0x9830 = 0x00000000 (seq 3644)
        GPU_Wr32(gpu, 38964, 1024)                 // 0x9834 = 0x00000400 (seq 3646)
        GPU_Wr32(gpu, 38968, 131584)               // 0x9838 = 0x00020200 (seq 3648)
        GPU_Wr32(gpu, 3192, 0)                     // 0x0C78 = 0x00000000 (seq 3650)
        GPU_Wr32(gpu, 53296, 8388672)              // 0xD030 = 0x00800040 (seq 3652)
        GPU_Wr32(gpu, 55344, 8388672)              // 0xD830 = 0x00800040 (seq 3654)
        GPU_Wr32(gpu, 23472, 112)                  // 0x5BB0 = 0x00000070 (seq 3656)
        GPU_Wr32(gpu, 23488, 1343225856)           // 0x5BC0 = 0x50100000 (seq 3658)
        GPU_Wr32(gpu, 28720, 17)                   // 0x7030 = 0x00000011 (seq 3660)

        // MC indirect golden registers via IIO index(0x30)/data(0x34) port
        // kernel verde_golden_registers: {0x30, 0xFF, 0x0040}, {0x34, 0x40, 0x4040}
        iio_idx = GPU_Rd32(gpu, 48)                // read 0x30 (IIO MC INDEX)
        iio_idx = BitwiseAnd(iio_idx, 4294967040)  // clear bits [7:0] = ~0xFF
        iio_idx = BitwiseOr(iio_idx, 64)           // set 0x40
        GPU_Wr32(gpu, 48, iio_idx)                 // 0x30 = (old & ~0xFF) | 0x40
        iio_dat = GPU_Rd32(gpu, 52)                // read 0x34 (IIO MC DATA)
        iio_dat = BitwiseAnd(iio_dat, 4294967231)  // clear bit 6 = ~0x40
        iio_dat = BitwiseOr(iio_dat, 16448)        // set 0x4040
        GPU_Wr32(gpu, 52, iio_dat)                 // 0x34 = (old & ~0x40) | 0x4040

        // --- Part 2: GFX regs (seq 3666-3692) ---
        GPU_Wr32(gpu, 35348, 7)                    // 0x8A14 = 0x00000007 (seq 3666)
        GPU_Wr32(gpu, 35620, 16777215)             // 0x8B24 = 0x00FFFFFF (seq 3667)
        GPU_Wr32(gpu, 35600, 0)                    // 0x8B10 = 0x00000000 (seq 3669)
        GPU_Wr32(gpu, 166476, 1308622848)          // 0x28A4C = 0x4E000000 (seq 3671)
        GPU_Wr32(gpu, 164688, 4682)                // 0x28350 = 0x0000124A PA_SC_RASTER_CONFIG (seq 3673)
        GPU_Wr32(gpu, SIReg.SPI_CONFIG_CNTL, 50331648)   // 0x03000000 (seq 3678)
        GPU_Wr32(gpu, 36488, 0)                    // 0x8E88 = 0x00000000 (seq 3680)
        GPU_Wr32(gpu, 36484, 0)                    // 0x8E84 = 0x00000000 (seq 3682)
        GPU_Wr32(gpu, SIReg.SX_DEBUG_1, 32)                  // 0x00000020 (seq 3684)
        GPU_Wr32(gpu, SIReg.TA_CNTL_AUX, 65536)              // 0x00010000 (seq 3686)
        GPU_Wr32(gpu, SIReg.TCP_ADDR_CONFIG, 3)               // 0x00000003 (seq 3688)
        GPU_Wr32(gpu, SIReg.TCP_CHAN_STEER_HI, 0)             // 0x00000000 (seq 3689)
        GPU_Wr32(gpu, SIReg.TCP_CHAN_STEER_LO, 4146)          // 0x00001032 (seq 3690)
        GPU_Wr32(gpu, 35028, 16)                   // 0x88D4 = 0x00000010 (seq 3692)

        // --- Part 3: VM fault + protection (seq 3694-3702) ---
        GPU_Wr32(gpu, 5568, 787456)                // 0x15C0 = 0x000C0400 (seq 3694)
        GPU_Wr32(gpu, 5296, 4294967295)            // 0x14B0 = 0xFFFFFFFF (seq 3696)
        GPU_Wr32(gpu, 5300, 268435455)             // 0x14B4 = 0x0FFFFFFF (seq 3698)
        GPU_Wr32(gpu, 5304, 268435455)             // 0x14B8 = 0x0FFFFFFF (seq 3700)
        GPU_Wr32(gpu, 5308, 268435455)             // 0x14BC = 0x0FFFFFFF (seq 3702)

        // --- Part 4: GB_ADDR_CONFIG + CP regs (seq 3703-3708) ---
        GPU_Wr32(gpu, SIReg.GB_ADDR_CONFIG, 33619970)          // 0x02010002 golden (trace seq 3703); the ROW_SIZE-adjusted 0x12010002 write happens later (trace seq 329279)
        GPU_Wr32(gpu, 50212, 54464517)             // 0xC424 = 0x033F1005 (was 54329349=0x033D0005, FIXED)
        GPU_Wr32(gpu, 50300, 276856864)            // 0xC47C = 0x10808020 (was 277348384=0x10880020, FIXED)
        GPU_Wr32(gpu, 50312, 8388616)              // 0xC488 = 0x00800008 (seq 3706)
        GPU_Wr32(gpu, 49940, 4096)                 // 0xC314 = 0x00001000 (seq 3707)
        GPU_Wr32(gpu, 49932, 2147549204)              // 0xC30C RLC_LB_CNTL = 0x80010014 (seq 3708; decoder mislabels 0xC30C as RLC_GPM_UCODE_ADDR — 49964/0xC32C is RLC_UCODE_ADDR, wrong reg)

        // --- Part 5: Clock gating disable (seq 3709) ---
        GPU_Wr32(gpu, SIReg.RLC_CGTT_MGCG_OVERRIDE, 4294967292)   // 0xFFFFFFFC (seq 3709)

        // --- Part 6: GRBM broadcast → CGTT per-block overrides (seq 3710-3734) ---
        gfx_broadcast = BitwiseOr(GFXIndexBits.INSTANCE_BROADCAST_WRITES, BitwiseOr(GFXIndexBits.SH_BROADCAST_WRITES, GFXIndexBits.SE_BROADCAST_WRITES))
        GPU_Wr32(gpu, SIReg.GRBM_GFX_INDEX, gfx_broadcast)    // 0xE0000000 (seq 3710)
        GPU_Wr32(gpu, 39520, 256)       // 0x9A60 = 0x00000100 (seq 3711)
        GPU_Wr32(gpu, 37540, 256)       // 0x92A4 = 0x00000100 (seq 3712)
        GPU_Wr32(gpu, 49508, 256)       // 0xC164 = 0x00000100 (seq 3713)
        GPU_Wr32(gpu, 38772, 256)       // 0x9774 = 0x00000100 (seq 3714)
        GPU_Wr32(gpu, 35204, 100663552) // 0x8984 = 0x06000100 (seq 3715)
        GPU_Wr32(gpu, 35352, 256)       // 0x8A18 = 0x00000100 (seq 3716)
        GPU_Wr32(gpu, 37536, 256)       // 0x92A0 = 0x00000100 (seq 3717)
        GPU_Wr32(gpu, 50048, 256)       // 0xC380 = 0x00000100 (seq 3718)
        GPU_Wr32(gpu, 35624, 256)       // 0x8B28 = 0x00000100 (seq 3719)
        GPU_Wr32(gpu, 37188, 256)       // 0x9144 = 0x00000100 (seq 3720)
        GPU_Wr32(gpu, 36232, 256)       // 0x8D88 = 0x00000100 (seq 3721)
        GPU_Wr32(gpu, 36236, 256)       // 0x8D8C = 0x00000100 (seq 3722)
        GPU_Wr32(gpu, 36912, 256)       // 0x9030 = 0x00000100 (seq 3723)
        GPU_Wr32(gpu, 36916, 256)       // 0x9034 = 0x00000100 (seq 3724)
        GPU_Wr32(gpu, 36920, 256)       // 0x9038 = 0x00000100 (seq 3725)
        GPU_Wr32(gpu, 36924, 256)       // 0x903C = 0x00000100 (seq 3726)
        GPU_Wr32(gpu, 44416, 256)       // 0xAD80 = 0x00000100 (seq 3727)
        GPU_Wr32(gpu, 44116, 256)       // 0xAC54 = 0x00000100 (seq 3728)
        GPU_Wr32(gpu, 35196, 100663552) // 0x897C = 0x06000100 (seq 3729)
        GPU_Wr32(gpu, 39016, 256)       // 0x9868 = 0x00000100 (seq 3730)
        GPU_Wr32(gpu, 38160, 256)       // 0x9510 = 0x00000100 (seq 3731)
        GPU_Wr32(gpu, 44804, 256)       // 0xAF04 = 0x00000100 (seq 3732)
        GPU_Wr32(gpu, 44548, 256)       // 0xAE04 = 0x00000100 (seq 3733)
        GPU_Wr32(gpu, 38044, 256)       // 0x949C = 0x00000100 (seq 3734)

        // --- Part 7: GRBM broadcast → CU steering table (seq 3735-3785) ---
        GPU_Wr32(gpu, SIReg.GRBM_GFX_INDEX, gfx_broadcast)    // 0xE0000000 (seq 3735)
        // CU0
        GPU_Wr32(gpu, 37216, 65536)     // 0x9160 = 0x00010000
        GPU_Wr32(gpu, 37220, 196610)    // 0x9164 = 0x00030002
        GPU_Wr32(gpu, 37224, 262151)    // 0x9168 = 0x00040007
        GPU_Wr32(gpu, 37228, 393221)    // 0x916C = 0x00060005
        GPU_Wr32(gpu, 37232, 589832)    // 0x9170 = 0x00090008
        // CU1
        GPU_Wr32(gpu, 37236, 131073)    // 0x9174 = 0x00020001
        GPU_Wr32(gpu, 37240, 262147)    // 0x9178 = 0x00040003
        GPU_Wr32(gpu, 37244, 7)         // 0x917C = 0x00000007
        GPU_Wr32(gpu, 37248, 393221)    // 0x9180 = 0x00060005
        GPU_Wr32(gpu, 37252, 589832)    // 0x9184 = 0x00090008
        // CU2
        GPU_Wr32(gpu, 37256, 196610)    // 0x9188 = 0x00030002
        GPU_Wr32(gpu, 37260, 327684)    // 0x918C = 0x00050004
        GPU_Wr32(gpu, 37264, 8)         // 0x9190 = 0x00000008
        GPU_Wr32(gpu, 37268, 458758)    // 0x9194 = 0x00070006
        GPU_Wr32(gpu, 37272, 655369)    // 0x9198 = 0x000A0009
        // CU3
        GPU_Wr32(gpu, 37276, 262147)    // 0x919C = 0x00040003
        GPU_Wr32(gpu, 37280, 393221)    // 0x91A0 = 0x00060005
        GPU_Wr32(gpu, 37284, 9)         // 0x91A4 = 0x00000009
        GPU_Wr32(gpu, 37288, 524295)    // 0x91A8 = 0x00080007
        GPU_Wr32(gpu, 37292, 720906)    // 0x91AC = 0x000B000A
        // CU4
        GPU_Wr32(gpu, 37296, 327684)    // 0x91B0 = 0x00050004
        GPU_Wr32(gpu, 37300, 458758)    // 0x91B4 = 0x00070006
        GPU_Wr32(gpu, 37304, 524299)    // 0x91B8 = 0x0008000B
        GPU_Wr32(gpu, 37308, 655369)    // 0x91BC = 0x000A0009
        GPU_Wr32(gpu, 37312, 851980)    // 0x91C0 = 0x000D000C
        // CU5 (offset jumps to 0x9200)
        GPU_Wr32(gpu, 37376, 589832)    // 0x9200 = 0x00090008
        GPU_Wr32(gpu, 37380, 720906)    // 0x9204 = 0x000B000A
        GPU_Wr32(gpu, 37384, 786447)    // 0x9208 = 0x000C000F
        GPU_Wr32(gpu, 37388, 917517)    // 0x920C = 0x000E000D
        GPU_Wr32(gpu, 37392, 1114128)   // 0x9210 = 0x00110010
        // CU6
        GPU_Wr32(gpu, 37396, 655369)    // 0x9214 = 0x000A0009
        GPU_Wr32(gpu, 37400, 786443)    // 0x9218 = 0x000C000B
        GPU_Wr32(gpu, 37404, 15)        // 0x921C = 0x0000000F
        GPU_Wr32(gpu, 37408, 917517)    // 0x9220 = 0x000E000D
        GPU_Wr32(gpu, 37412, 1114128)   // 0x9224 = 0x00110010
        // CU7
        GPU_Wr32(gpu, 37416, 720906)    // 0x9228 = 0x000B000A
        GPU_Wr32(gpu, 37420, 851980)    // 0x922C = 0x000D000C
        GPU_Wr32(gpu, 37424, 16)        // 0x9230 = 0x00000010
        GPU_Wr32(gpu, 37428, 983054)    // 0x9234 = 0x000F000E
        GPU_Wr32(gpu, 37432, 1179665)   // 0x9238 = 0x00120011
        // CU8
        GPU_Wr32(gpu, 37436, 786443)    // 0x923C = 0x000C000B
        GPU_Wr32(gpu, 37440, 917517)    // 0x9240 = 0x000E000D
        GPU_Wr32(gpu, 37444, 17)        // 0x9244 = 0x00000011
        GPU_Wr32(gpu, 37448, 1048591)   // 0x9248 = 0x0010000F
        GPU_Wr32(gpu, 37452, 1245202)   // 0x924C = 0x00130012
        // CU9
        GPU_Wr32(gpu, 37456, 851980)    // 0x9250 = 0x000D000C
        GPU_Wr32(gpu, 37460, 983054)    // 0x9254 = 0x000F000E
        GPU_Wr32(gpu, 37464, 1048595)   // 0x9258 = 0x00100013
        GPU_Wr32(gpu, 37468, 1179665)   // 0x925C = 0x00120011
        GPU_Wr32(gpu, 37472, 1376276)   // 0x9260 = 0x00150014

        // --- Part 8: CGTS + MGCG/CGCG init (verde_mgcg_cgcg_init) ---
        GPU_Wr32(gpu, SIReg.RLC_CGTT_MGCG_OVERRIDE, 4294967292)  // 0xC400 = 0xFFFFFFFC
        GPU_Wr32(gpu, SIReg.GRBM_GFX_INDEX, 3758096384)          // 0x802C = 0xE0000000 (broadcast)
        // Per-block CGTS overrides — all get 0x00000100 unless noted
        GPU_Wr32(gpu, 39520, 256)       // 0x9A60 = 0x00000100
        GPU_Wr32(gpu, 37540, 256)       // 0x92A4 = 0x00000100
        GPU_Wr32(gpu, 49508, 256)       // 0xC164 = 0x00000100
        GPU_Wr32(gpu, 38772, 256)       // 0x9774 = 0x00000100
        GPU_Wr32(gpu, 35204, 100663552) // 0x8984 = 0x06000100
        GPU_Wr32(gpu, 35352, 256)       // 0x8A18 = 0x00000100
        GPU_Wr32(gpu, 37536, 256)       // 0x92A0 = 0x00000100
        GPU_Wr32(gpu, 50048, 256)       // 0xC380 = 0x00000100
        GPU_Wr32(gpu, 35624, 256)       // 0x8B28 = 0x00000100
        GPU_Wr32(gpu, 37188, 256)       // 0x9144 = 0x00000100
        GPU_Wr32(gpu, 36232, 256)       // 0x8D88 = 0x00000100
        GPU_Wr32(gpu, 36236, 256)       // 0x8D8C = 0x00000100
        GPU_Wr32(gpu, 36912, 256)       // 0x9030 = 0x00000100
        GPU_Wr32(gpu, 36916, 256)       // 0x9034 = 0x00000100
        GPU_Wr32(gpu, 36920, 256)       // 0x9038 = 0x00000100
        GPU_Wr32(gpu, 36924, 256)       // 0x903C = 0x00000100
        GPU_Wr32(gpu, 44416, 256)       // 0xAD80 = 0x00000100
        GPU_Wr32(gpu, 44116, 256)       // 0xAC54 = 0x00000100
        GPU_Wr32(gpu, 35196, 100663552) // 0x897C = 0x06000100
        GPU_Wr32(gpu, 39016, 256)       // 0x9868 = 0x00000100
        GPU_Wr32(gpu, 38160, 256)       // 0x9510 = 0x00000100
        GPU_Wr32(gpu, 44804, 256)       // 0xAF04 = 0x00000100
        GPU_Wr32(gpu, 44548, 256)       // 0xAE04 = 0x00000100
        GPU_Wr32(gpu, 38044, 256)       // 0x949C = 0x00000100
        GPU_Wr32(gpu, SIReg.GRBM_GFX_INDEX, 3758096384)          // 0x802C = 0xE0000000 (broadcast)
        // REMOVED: duplicate CGTS block that overwrote correct CU steering table (lines 641-651)
        // with wrong simplified values (0x80008 instead of 0x90008 etc). The correct per-CU
        // values are already written in Part 7 above. Only CGTS_SM_CTRL_REG and RLC_CGCG_CGLS_CTRL
        // are kept as they are not duplicates.
        GPU_Wr32(gpu, SIReg.CGTS_SM_CTRL_REG, 2526282240)     // 0x9150 = 0x96940200
        GPU_Wr32(gpu, SIReg.RLC_CGCG_CGLS_CTRL, 2097215)     // 0xC404 = 0x0020003F

        PrintMessage("[MC_SI] Golden registers programmed (kernel order)\n")

        // --- Part 9: Tail init regs (seq 3793-3809) ---
        GPU_Wr32(gpu, 5644, 256)                   // 0x160C = 0x00000100 (seq 3793)
        GPU_Wr32(gpu, 4132, 256)                   // 0x1024 = 0x00000100 (seq 3794)
        GPU_Wr32(gpu, 4140, 0)                     // 0x102C = 0x00000000 (seq 3796)
        GPU_Wr32(gpu, 21988, 6291712)              // 0x55E4 = 0x00600100 (seq 3803)
        GPU_Wr32(gpu, 21992, 1)                    // 0x55E8 = 0x00000001 (seq 3805)
        GPU_Wr32(gpu, 12492, 260)                  // 0x30CC = 0x00000104 (seq 3809)
        GPU_Wr32(gpu, 13628, 262144)               // 0x353C = 0x00040000 (seq 3816)
        GPU_Wr32(gpu, 13624, 536875263)            // 0x3538 = 0x200010FF (seq 3817)

        // ---------------------------------------------------------------
        // Step 4: Read MC_ARB_RAMCFG, compute ROW_SIZE, adjust GB_ADDR_CONFIG
        // ---------------------------------------------------------------
        discard_chmap = GPU_Rd32(gpu, SIReg.MC_SHARED_CHMAP)
        ramcfg = GPU_Rd32(gpu, SIReg.MC_ARB_RAMCFG)

        PrintMessage("[MC_SI] MC_ARB_RAMCFG = 0x")
        PrintHex(ramcfg)

        // mem_row_size_in_kb = (4 * (1 << (8 + noofcols))) / 1024
        // NOOFCOLS = (ramcfg >> 6) & 0x3
        noofcols = BitwiseAnd(RightShift(ramcfg, 6), 3)
        // For noofcols=0: 1KB, =1: 2KB, =2: 4KB, =3: 8KB (clamped to 4KB)
        row_size_code = noofcols
        IfCondition GreaterThan(row_size_code, 2) ThenBlock: {
            row_size_code = 2       // clamp: max 4KB = ROW_SIZE(2)
        }

        PrintMessage(" NOOFCOLS=")
        PrintNumber(noofcols)
        PrintMessage(" ROW_SIZE=")
        PrintNumber(row_size_code)
        PrintMessage("\n")

        // Start with VERDE_GB_ADDR_CONFIG_GOLDEN = 0x12010002
        // Clear ROW_SIZE field (bits [29:28]) then set from ramcfg
        // ROW_SIZE_MASK = 0x30000000
        gb_addr = BitwiseAnd(302055426, 3489660927)     // 0x12010002 & ~0x30000000 = 0x12010002 & 0xCFFFFFFF
        gb_addr = BitwiseOr(gb_addr, LeftShift(row_size_code, 28))

        PrintMessage("[MC_SI] GB_ADDR_CONFIG = 0x")
        PrintHex(gb_addr)
        PrintMessage("\n")

        // ---------------------------------------------------------------
        // Step 4: Broadcast address config to all decode hardware
        // ---------------------------------------------------------------
        GPU_Wr32(gpu, SIReg.GB_ADDR_CONFIG, gb_addr)
        // DMIF_ADDR_CONFIG / DMIF_ADDR_CALC: use amdgpu mmiotrace values.
        // amdgpu second-pass writes 0x12010002 to both (matching GB_ADDR_CONFIG
        // golden value for Verde).  Our old radeon probe values from bus 1
        // (0x10010002 / 0x10000000) were stale BIOS defaults — the radeon driver
        // overwrites them during init.  DMIF must match GB_ADDR_CONFIG for
        // correct display/memory address decode routing.
        // 0x12010002 = 302055426 decimal
        GPU_Wr32(gpu, SIReg.DMIF_ADDR_CONFIG, gb_addr)      // matches GB_ADDR_CONFIG
        GPU_Wr32(gpu, SIReg.DMIF_ADDR_CALC, gb_addr)        // matches GB_ADDR_CONFIG
        GPU_Wr32(gpu, SIReg.HDP_ADDR_CONFIG, gb_addr)       // mmiotrace seq 329282
        GPU_Wr32(gpu, SIReg.DMA_TILING_CONFIG, gb_addr)                    // DMA0
        GPU_Wr32(gpu, Add(SIReg.DMA_TILING_CONFIG, 2048), gb_addr)         // DMA1 (+0x800)

        // NOTE: GB_ADDR_CONFIG is write-only on SI — readback returns
        // power-on defaults (0x10000000), NOT the value written.  The kernel
        // (si.c:si_gpu_init) never reads it back.  Don't treat mismatch as error.

        // ---------------------------------------------------------------
        // Step 5: Set GRBM_GFX_INDEX to broadcast mode
        //
        // MUST come AFTER GRBM_CNTL (timeout), BIF_FB_EN (bus interface),
        // and GB_ADDR_CONFIG (memory layout).  The kernel's si_gpu_init()
        // only first writes GRBM_GFX_INDEX inside si_setup_rb() which is
        // called AFTER all the above.  Writing it before those prereqs
        // causes the write to silently drop.
        // ---------------------------------------------------------------
        GPU_Wr32(gpu, SIReg.GRBM_GFX_INDEX, gfx_broadcast)

        // ---------------------------------------------------------------
        // Step 6: Tiling mode table — GB_TILE_MODE0 through GB_TILE_MODE31
        // Values from amdgpu mmiotrace (bus2_writes.txt seq 329285-329316).
        // These are gfx_v6_0_tiling_mode_table_init() values for Cape Verde.
        // ---------------------------------------------------------------
        GPU_Wr32(gpu, SIReg.GB_TILE_MODE0, 3801362)                          // 0x003A0112
        GPU_Wr32(gpu, Add(SIReg.GB_TILE_MODE0, 4), 3803410)                  // 0x003A0912
        GPU_Wr32(gpu, Add(SIReg.GB_TILE_MODE0, 8), 3805458)                  // 0x003A1112
        GPU_Wr32(gpu, Add(SIReg.GB_TILE_MODE0, 12), 2173202)                 // 0x00212912
        GPU_Wr32(gpu, Add(SIReg.GB_TILE_MODE0, 16), 266)                     // 0x0000010A
        GPU_Wr32(gpu, Add(SIReg.GB_TILE_MODE0, 20), 1120530)                 // 0x00111912
        GPU_Wr32(gpu, Add(SIReg.GB_TILE_MODE0, 24), 1184018)                 // 0x00121112
        GPU_Wr32(gpu, Add(SIReg.GB_TILE_MODE0, 28), 139538)                  // 0x00022112
        GPU_Wr32(gpu, Add(SIReg.GB_TILE_MODE0, 32), 4)                       // 0x00000004
        GPU_Wr32(gpu, Add(SIReg.GB_TILE_MODE0, 36), 264)                     // 0x00000108
        GPU_Wr32(gpu, Add(SIReg.GB_TILE_MODE0, 40), 3805456)                 // 0x003A1110
        GPU_Wr32(gpu, Add(SIReg.GB_TILE_MODE0, 44), 3477776)                 // 0x00351110
        GPU_Wr32(gpu, Add(SIReg.GB_TILE_MODE0, 48), 3414288)                 // 0x00341910
        GPU_Wr32(gpu, Add(SIReg.GB_TILE_MODE0, 52), 265)                     // 0x00000109
        GPU_Wr32(gpu, Add(SIReg.GB_TILE_MODE0, 56), 3543313)                 // 0x00361111
        GPU_Wr32(gpu, Add(SIReg.GB_TILE_MODE0, 60), 3477777)                 // 0x00351111
        GPU_Wr32(gpu, Add(SIReg.GB_TILE_MODE0, 64), 3414289)                 // 0x00341911
        GPU_Wr32(gpu, Add(SIReg.GB_TILE_MODE0, 68), 3418385)                 // 0x00342911
        GPU_Wr32(gpu, Add(SIReg.GB_TILE_MODE0, 72), 269)                     // 0x0000010D
        GPU_Wr32(gpu, Add(SIReg.GB_TILE_MODE0, 76), 3418401)                 // 0x00342921
        GPU_Wr32(gpu, Add(SIReg.GB_TILE_MODE0, 80), 3418397)                 // 0x0034291D
        GPU_Wr32(gpu, Add(SIReg.GB_TILE_MODE0, 84), 2232593)                 // 0x00221111
        GPU_Wr32(gpu, Add(SIReg.GB_TILE_MODE0, 88), 2167057)                 // 0x00211111
        GPU_Wr32(gpu, Add(SIReg.GB_TILE_MODE0, 92), 1184017)                 // 0x00121111
        GPU_Wr32(gpu, Add(SIReg.GB_TILE_MODE0, 96), 1120529)                 // 0x00111911
        GPU_Wr32(gpu, Add(SIReg.GB_TILE_MODE0, 100), 139537)                 // 0x00022111
        GPU_Wr32(gpu, Add(SIReg.GB_TILE_MODE0, 104), 139537)                 // 0x00022111
        GPU_Wr32(gpu, Add(SIReg.GB_TILE_MODE0, 108), 139537)                 // 0x00022111
        GPU_Wr32(gpu, Add(SIReg.GB_TILE_MODE0, 112), 139537)                 // 0x00022111
        GPU_Wr32(gpu, Add(SIReg.GB_TILE_MODE0, 116), 139537)                 // 0x00022111
        GPU_Wr32(gpu, Add(SIReg.GB_TILE_MODE0, 120), 76049)                  // 0x00012911
        GPU_Wr32(gpu, Add(SIReg.GB_TILE_MODE0, 124), 0)                      // 0x00000000

        PrintMessage("[MC_SI] Tile mode table programmed (32 entries)\n")

        // ---------------------------------------------------------------
        // Step 6: si_setup_rb — render backend setup for Verde
        // Verde: 1 SE, 2 SH/SE, 4 backends/SE (2 per SH)
        //
        // Read disabled RB mask, compute enabled RBs, program PA_SC_RASTER_CONFIG
        // ---------------------------------------------------------------

        // Select SE 0, broadcast to all SH to read disabled RBs
        // INSTANCE_BROADCAST | SH_BROADCAST | SE_INDEX(0)
        GPU_Wr32(gpu, SIReg.GRBM_GFX_INDEX, BitwiseOr(GFXIndexBits.INSTANCE_BROADCAST_WRITES, GFXIndexBits.SH_BROADCAST_WRITES))

        // Read disabled RBs from fuse registers
        rb_disable = GPU_Rd32(gpu, SIReg.CC_RB_BACKEND_DISABLE)
        IfCondition NotEqual(BitwiseAnd(rb_disable, 1), 0) ThenBlock: {
            // Bit 0 set means fuse data is valid, use BACKEND_DISABLE field
            rb_disable = BitwiseAnd(rb_disable, 16711680)    // BACKEND_DISABLE_MASK = 0x00FF0000
        }
        IfCondition EqualTo(BitwiseAnd(rb_disable, 1), 0) ThenBlock: {
            rb_disable = 0
        }
        rb_disable = BitwiseOr(rb_disable, GPU_Rd32(gpu, SIReg.GC_USER_RB_BACKEND_DISABLE))
        rb_disable = RightShift(BitwiseAnd(rb_disable, 16711680), 16)  // BACKEND_DISABLE_SHIFT = 16

        // Build enabled_rbs bitmask (4 backends for Verde, 2 per SH)
        enabled_rbs = BitwiseAnd(BitwiseNot(rb_disable), 15)   // mask to 4 bits

        PrintMessage("[MC_SI] RB enabled mask = 0x")
        PrintHex(enabled_rbs)
        PrintMessage("\n")

        // Compute PA_SC_RASTER_CONFIG for SE 0
        // Process 2 SH groups of 2 RBs each
        // RASTER_CONFIG_RB_MAP: 0=MAP_0, 2=MAP_2(both), 3=MAP_3
        raster_data = 0
        // SH 0: RBs [1:0]
        sh0_rbs = BitwiseAnd(enabled_rbs, 3)
        IfCondition EqualTo(sh0_rbs, 1) ThenBlock: { raster_data = BitwiseOr(raster_data, 0) }     // RB_MAP_0
        IfCondition EqualTo(sh0_rbs, 2) ThenBlock: { raster_data = BitwiseOr(raster_data, 3) }     // RB_MAP_3
        IfCondition EqualTo(sh0_rbs, 3) ThenBlock: { raster_data = BitwiseOr(raster_data, 2) }     // RB_MAP_2
        // SH 1: RBs [3:2]
        sh1_rbs = BitwiseAnd(RightShift(enabled_rbs, 2), 3)
        IfCondition EqualTo(sh1_rbs, 1) ThenBlock: { raster_data = BitwiseOr(raster_data, 0) }     // RB_MAP_0 << 2
        IfCondition EqualTo(sh1_rbs, 2) ThenBlock: { raster_data = BitwiseOr(raster_data, 12) }    // RB_MAP_3 << 2
        IfCondition EqualTo(sh1_rbs, 3) ThenBlock: { raster_data = BitwiseOr(raster_data, 8) }     // RB_MAP_2 << 2

        // Write raster config for SE 0
        // Value from amdgpu mmiotrace Phase 2 (seq 329324): 0x00001240
        GPU_Wr32(gpu, SIReg.GRBM_GFX_INDEX, BitwiseOr(GFXIndexBits.INSTANCE_BROADCAST_WRITES, BitwiseOr(GFXIndexBits.SH_BROADCAST_WRITES, 0)))
        GPU_Wr32(gpu, SIReg.PA_SC_RASTER_CONFIG, 4672)       // 0x00001240 (mmiotrace)

        PrintMessage("[MC_SI] PA_SC_RASTER_CONFIG = 0x")
        PrintHex(raster_data)
        PrintMessage("\n")

        // Restore broadcast mode
        GPU_Wr32(gpu, SIReg.GRBM_GFX_INDEX, gfx_broadcast)

        // ---------------------------------------------------------------
        // Step 7: si_setup_spi — SPI thread management for Verde
        // Verde: 1 SE, 2 SH/SE, 5 CU/SH
        // For each (SE, SH): read active CU mask, update SPI_STATIC_THREAD_MGMT_3
        // ---------------------------------------------------------------
        // SE 0, SH 0
        // INSTANCE_BROADCAST | SH_INDEX(0) | SE_INDEX(0)
        GPU_Wr32(gpu, SIReg.GRBM_GFX_INDEX, GFXIndexBits.INSTANCE_BROADCAST_WRITES)
        spi_data = GPU_Rd32(gpu, SIReg.SPI_STATIC_THREAD_MGMT_3)
        // Read active CU bitmap
        cu_cfg0 = GPU_Rd32(gpu, SIReg.CC_GC_SHADER_ARRAY_CONFIG)
        IfCondition NotEqual(BitwiseAnd(cu_cfg0, 1), 0) ThenBlock: {
            cu_cfg0 = BitwiseAnd(cu_cfg0, 4294901760)   // INACTIVE_CUS_MASK = 0xFFFF0000
        }
        IfCondition EqualTo(BitwiseAnd(cu_cfg0, 1), 0) ThenBlock: {
            cu_cfg0 = 0
        }
        cu_cfg0 = BitwiseOr(cu_cfg0, GPU_Rd32(gpu, SIReg.GC_USER_SHADER_ARRAY_CONFIG))
        cu_inactive0 = RightShift(cu_cfg0, 16)          // INACTIVE_CUS_SHIFT = 16
        cu_active0 = BitwiseAnd(BitwiseNot(cu_inactive0), 31)  // 5 CUs = mask 0x1F
        // Find first active CU and clear its bit in SPI_STATIC_THREAD_MGMT_3
        spi_k = 0
        spi_mask = 1
        WhileLoop LessThan(spi_k, 16) {
            spi_mask = LeftShift(1, spi_k)
            IfCondition NotEqual(BitwiseAnd(cu_active0, spi_mask), 0) ThenBlock: {
                spi_data = BitwiseAnd(spi_data, BitwiseNot(spi_mask))
                GPU_Wr32(gpu, SIReg.SPI_STATIC_THREAD_MGMT_3, spi_data)
                spi_k = 16  // break
            }
            spi_k = Add(spi_k, 1)
        }

        // SE 0, SH 1
        // INSTANCE_BROADCAST | SH_INDEX(1) | SE_INDEX(0)
        GPU_Wr32(gpu, SIReg.GRBM_GFX_INDEX, BitwiseOr(GFXIndexBits.INSTANCE_BROADCAST_WRITES, 256))  // SH_INDEX(1) = 1<<8 = 256
        spi_data2 = GPU_Rd32(gpu, SIReg.SPI_STATIC_THREAD_MGMT_3)
        cu_cfg1 = GPU_Rd32(gpu, SIReg.CC_GC_SHADER_ARRAY_CONFIG)
        IfCondition NotEqual(BitwiseAnd(cu_cfg1, 1), 0) ThenBlock: {
            cu_cfg1 = BitwiseAnd(cu_cfg1, 4294901760)
        }
        IfCondition EqualTo(BitwiseAnd(cu_cfg1, 1), 0) ThenBlock: {
            cu_cfg1 = 0
        }
        cu_cfg1 = BitwiseOr(cu_cfg1, GPU_Rd32(gpu, SIReg.GC_USER_SHADER_ARRAY_CONFIG))
        cu_inactive1 = RightShift(cu_cfg1, 16)
        cu_active1 = BitwiseAnd(BitwiseNot(cu_inactive1), 31)
        spi_k2 = 0
        WhileLoop LessThan(spi_k2, 16) {
            spi_mask2 = LeftShift(1, spi_k2)
            IfCondition NotEqual(BitwiseAnd(cu_active1, spi_mask2), 0) ThenBlock: {
                spi_data2 = BitwiseAnd(spi_data2, BitwiseNot(spi_mask2))
                GPU_Wr32(gpu, SIReg.SPI_STATIC_THREAD_MGMT_3, spi_data2)
                spi_k2 = 16  // break
            }
            spi_k2 = Add(spi_k2, 1)
        }

        // Restore broadcast mode
        GPU_Wr32(gpu, SIReg.GRBM_GFX_INDEX, gfx_broadcast)

        PrintMessage("[MC_SI] SPI thread mgmt programmed (1 SE, 2 SH)\n")

        // ---------------------------------------------------------------
        // Step 8: 3D engine defaults from si_gpu_init()
        // ---------------------------------------------------------------
        // CP queue thresholds: ROQ_IB1_START(0x16) | ROQ_IB2_START(0x2B)
        GPU_Wr32(gpu, SIReg.CP_QUEUE_THRESHOLDS, 11030)                      // 0x2B16
        // CP MEQ thresholds: from amdgpu mmiotrace (seq 329353)
        GPU_Wr32(gpu, SIReg.CP_MEQ_THRESHOLDS, 24624)                        // 0x00006030 (mmiotrace)

        // SX_DEBUG_1 = 0x20 (kernel mmiotrace seq 329355)
        GPU_Wr32(gpu, SIReg.SX_DEBUG_1, 32)

        // SPI_CONFIG_CNTL_1 = kernel/radeon value 0x00000004
        GPU_Wr32(gpu, SIReg.SPI_CONFIG_CNTL_1, 4)

        // PA_SC_FIFO_SIZE — Verde values:
        //   frontend=0x20, backend=0x40, hiz=0x30, earlyz=0x130
        //   = (0x20) | (0x40 << 6) | (0x30 << 15) | (0x130 << 23) = 0x98181020
        GPU_Wr32(gpu, SIReg.PA_SC_FIFO_SIZE, 2551713824)                     // 0x98181020

        GPU_Wr32(gpu, SIReg.VGT_NUM_INSTANCES, 1)
        GPU_Wr32(gpu, 34812, 0)                                           // 0x87FC VGT_TF_MEMORY_BASE = 0
        GPU_Wr32(gpu, SIReg.CP_PERFMON_CNTL, 0)                          // kernel writes 0, not 0x104
        GPU_Wr32(gpu, SIReg.SQ_CONFIG, 0)

        // PA_SC_FORCE_EOV_MAX_CNTS = CLK_CNT(0xFFF) | REZ_CNT(0xFF)
        GPU_Wr32(gpu, SIReg.PA_SC_FORCE_EOV_MAX_CNTS, 16715775)              // 0x00FF0FFF

        // VGT_CACHE_INVALIDATION = CACHE_INVALIDATION(VC_AND_TC=2) | AUTO_INVLD_EN(ES_AND_GS_AUTO=3)
        GPU_Wr32(gpu, SIReg.VGT_CACHE_INVALIDATION, 194)                     // 0xC2

        GPU_Wr32(gpu, SIReg.VGT_GS_VERTEX_REUSE, 16)
        GPU_Wr32(gpu, SIReg.PA_SC_LINE_STIPPLE_STATE, 0)

        // Zero CB performance counters
        GPU_Wr32(gpu, SIReg.CB_PERFCOUNTER0_SELECT0, 0)
        GPU_Wr32(gpu, SIReg.CB_PERFCOUNTER0_SELECT1, 0)
        GPU_Wr32(gpu, SIReg.CB_PERFCOUNTER1_SELECT0, 0)
        GPU_Wr32(gpu, SIReg.CB_PERFCOUNTER1_SELECT1, 0)
        GPU_Wr32(gpu, SIReg.CB_PERFCOUNTER2_SELECT0, 0)
        GPU_Wr32(gpu, SIReg.CB_PERFCOUNTER2_SELECT1, 0)
        GPU_Wr32(gpu, SIReg.CB_PERFCOUNTER3_SELECT0, 0)
        GPU_Wr32(gpu, SIReg.CB_PERFCOUNTER3_SELECT1, 0)

        // TA performance counters (kernel Phase 12, seq 329365-329372)
        // Zero all 8 TA_CNTL_AUX / TA_CS_BC_BASE registers
        GPU_Wr32(gpu, 39456, 0)    // 0x9A20
        GPU_Wr32(gpu, 39460, 0)    // 0x9A24
        GPU_Wr32(gpu, 39464, 0)    // 0x9A28
        GPU_Wr32(gpu, 39468, 0)    // 0x9A2C
        GPU_Wr32(gpu, 39472, 0)    // 0x9A30
        GPU_Wr32(gpu, 39476, 0)    // 0x9A34
        GPU_Wr32(gpu, 39480, 0)    // 0x9A38
        GPU_Wr32(gpu, 39484, 0)    // 0x9A3C

        // HDP_HOST_PATH_CNTL — kernel gfx_v6_0.c:1845-1846 does read-writeback
        // to trigger HDP cache flush side-effect. Old code hardcoded 0x0F200029
        // which overwrote BIOS config. (FIX 7)
        hdp_hpc_tmp = GPU_Rd32(gpu, SIReg.HDP_HOST_PATH_CNTL)
        GPU_Wr32(gpu, SIReg.HDP_HOST_PATH_CNTL, hdp_hpc_tmp)

        // PA_CL_ENHANCE = CLIP_VTX_REORDER_ENA | NUM_CLIP_SEQ(3)
        // (kernel seq 329375: 0x8A14 = 0x7)
        GPU_Wr32(gpu, SIReg.PA_CL_ENHANCE, 7)

        // ---------------------------------------------------------------
        // Step 8b: RLC Clear State / CGCG table (mmiotrace seq 3816-3938)
        // Programs the RLC's CGCG (Coarse Grain Clock Gating) table and
        // clear state register list via index/data register pairs.
        // ---------------------------------------------------------------

        // ── CGCG table (0x353C/0x3538 pairs) ──
        // 6 entries + terminator. Each entry: write data to 0x353C, then
        // commit via 0x3538 (upper nibble=block, 0x10FF=enable mask),
        // then 5 zero-padding writes to 0x353C.
        GPU_Wr32(gpu, 13628, 262144)                    // 0x353C = 0x00040000
        GPU_Wr32(gpu, 13624, 536875263)                 // 0x3538 = 0x200010FF
        GPU_Wr32(gpu, 13628, 0)                         // 0x353C = 0x00000000
        GPU_Wr32(gpu, 13628, 0)                         // 0x353C = 0x00000000
        GPU_Wr32(gpu, 13628, 0)                         // 0x353C = 0x00000000
        GPU_Wr32(gpu, 13628, 0)                         // 0x353C = 0x00000000
        GPU_Wr32(gpu, 13628, 0)                         // 0x353C = 0x00000000
        GPU_Wr32(gpu, 13628, 28679)                     // 0x353C = 0x00007007
        GPU_Wr32(gpu, 13624, 805310719)                 // 0x3538 = 0x300010FF
        GPU_Wr32(gpu, 13628, 0)                         // 0x353C = 0x00000000
        GPU_Wr32(gpu, 13628, 0)                         // 0x353C = 0x00000000
        GPU_Wr32(gpu, 13628, 0)                         // 0x353C = 0x00000000
        GPU_Wr32(gpu, 13628, 0)                         // 0x353C = 0x00000000
        GPU_Wr32(gpu, 13628, 0)                         // 0x353C = 0x00000000
        GPU_Wr32(gpu, 13628, 4194304)                   // 0x353C = 0x00400000
        GPU_Wr32(gpu, 13624, 268439807)                 // 0x3538 = 0x100010FF
        GPU_Wr32(gpu, 13628, 0)                         // 0x353C = 0x00000000
        GPU_Wr32(gpu, 13628, 0)                         // 0x353C = 0x00000000
        GPU_Wr32(gpu, 13628, 0)                         // 0x353C = 0x00000000
        GPU_Wr32(gpu, 13628, 0)                         // 0x353C = 0x00000000
        GPU_Wr32(gpu, 13628, 0)                         // 0x353C = 0x00000000
        GPU_Wr32(gpu, 13628, 1180160)                   // 0x353C = 0x00120200
        GPU_Wr32(gpu, 13624, 1342181631)                // 0x3538 = 0x500010FF
        GPU_Wr32(gpu, 13628, 0)                         // 0x353C = 0x00000000
        GPU_Wr32(gpu, 13628, 0)                         // 0x353C = 0x00000000
        GPU_Wr32(gpu, 13628, 0)                         // 0x353C = 0x00000000
        GPU_Wr32(gpu, 13628, 0)                         // 0x353C = 0x00000000
        GPU_Wr32(gpu, 13628, 0)                         // 0x353C = 0x00000000
        GPU_Wr32(gpu, 13628, 1973782)                   // 0x353C = 0x001E1E16
        GPU_Wr32(gpu, 13624, 1610617087)                // 0x3538 = 0x600010FF
        GPU_Wr32(gpu, 13628, 0)                         // 0x353C = 0x00000000
        GPU_Wr32(gpu, 13628, 0)                         // 0x353C = 0x00000000
        GPU_Wr32(gpu, 13628, 0)                         // 0x353C = 0x00000000
        GPU_Wr32(gpu, 13628, 0)                         // 0x353C = 0x00000000
        GPU_Wr32(gpu, 13628, 0)                         // 0x353C = 0x00000000
        GPU_Wr32(gpu, 13628, 1515294)                   // 0x353C = 0x00171F1E
        GPU_Wr32(gpu, 13624, 1879052543)                // 0x3538 = 0x700010FF
        GPU_Wr32(gpu, 13628, 0)                         // 0x353C = 0x00000000
        GPU_Wr32(gpu, 13628, 0)                         // 0x353C = 0x00000000
        GPU_Wr32(gpu, 13628, 0)                         // 0x353C = 0x00000000
        GPU_Wr32(gpu, 13628, 0)                         // 0x353C = 0x00000000
        GPU_Wr32(gpu, 13628, 0)                         // 0x353C = 0x00000000
        // Terminator entry
        GPU_Wr32(gpu, 13628, 0)                         // 0x353C = 0x00000000
        GPU_Wr32(gpu, 13624, 2559)                      // 0x3538 = 0x000009FF

        // ── Clear state register list (0x3500/0x3504 index/data pairs) ──
        GPU_Wr32(gpu, 13568, 0)                         // 0x3500 = 0x00000000
        GPU_Wr32(gpu, 13572, 268437504)                 // 0x3504 = 0x10000800
        GPU_Wr32(gpu, 13572, 15)                        // 0x3504 = 0x0000000F
        GPU_Wr32(gpu, 13572, 15)                        // 0x3504 = 0x0000000F
        GPU_Wr32(gpu, 13568, 4)                         // 0x3500 = 0x00000004
        GPU_Wr32(gpu, 13572, 268436766)                 // 0x3504 = 0x1000051E
        GPU_Wr32(gpu, 13572, 65535)                     // 0x3504 = 0x0000FFFF
        GPU_Wr32(gpu, 13572, 65535)                     // 0x3504 = 0x0000FFFF
        GPU_Wr32(gpu, 13568, 8)                         // 0x3500 = 0x00000008
        GPU_Wr32(gpu, 13572, 525568)                    // 0x3504 = 0x00080500
        GPU_Wr32(gpu, 13568, 18)                        // 0x3500 = 0x00000012
        GPU_Wr32(gpu, 13572, 591116)                    // 0x3504 = 0x0009050C
        GPU_Wr32(gpu, 13568, 29)                        // 0x3500 = 0x0000001D
        GPU_Wr32(gpu, 13572, 722220)                    // 0x3504 = 0x000B052C
        GPU_Wr32(gpu, 13568, 42)                        // 0x3500 = 0x0000002A
        GPU_Wr32(gpu, 13572, 66878)                     // 0x3504 = 0x0001053E
        GPU_Wr32(gpu, 13568, 45)                        // 0x3500 = 0x0000002D
        GPU_Wr32(gpu, 13572, 66886)                     // 0x3504 = 0x00010546
        GPU_Wr32(gpu, 13568, 48)                        // 0x3500 = 0x00000030
        GPU_Wr32(gpu, 13572, 656718)                    // 0x3504 = 0x000A054E
        GPU_Wr32(gpu, 13568, 60)                        // 0x3500 = 0x0000003C
        GPU_Wr32(gpu, 13572, 66911)                     // 0x3504 = 0x0001055F
        GPU_Wr32(gpu, 13568, 63)                        // 0x3500 = 0x0000003F
        GPU_Wr32(gpu, 13572, 66919)                     // 0x3504 = 0x00010567
        GPU_Wr32(gpu, 13568, 66)                        // 0x3500 = 0x00000042
        GPU_Wr32(gpu, 13572, 66927)                     // 0x3504 = 0x0001056F
        GPU_Wr32(gpu, 13568, 69)                        // 0x3500 = 0x00000045
        GPU_Wr32(gpu, 13572, 66930)                     // 0x3504 = 0x00010572
        GPU_Wr32(gpu, 13568, 72)                        // 0x3500 = 0x00000048
        GPU_Wr32(gpu, 13572, 132469)                    // 0x3504 = 0x00020575
        GPU_Wr32(gpu, 13568, 76)                        // 0x3500 = 0x0000004C
        GPU_Wr32(gpu, 13572, 1640449)                   // 0x3504 = 0x00190801
        GPU_Wr32(gpu, 13568, 103)                       // 0x3500 = 0x00000067
        GPU_Wr32(gpu, 13572, 67626)                     // 0x3504 = 0x0001082A
        GPU_Wr32(gpu, 13568, 106)                       // 0x3500 = 0x0000006A
        GPU_Wr32(gpu, 13572, 1771565)                   // 0x3504 = 0x001B082D
        GPU_Wr32(gpu, 13568, 135)                       // 0x3500 = 0x00000087
        GPU_Wr32(gpu, 13572, 3213393)                   // 0x3504 = 0x00310851
        GPU_Wr32(gpu, 13568, 186)                       // 0x3500 = 0x000000BA
        GPU_Wr32(gpu, 13572, 2193)                      // 0x3504 = 0x00000891
        GPU_Wr32(gpu, 13568, 188)                       // 0x3500 = 0x000000BC
        GPU_Wr32(gpu, 13572, 2195)                      // 0x3504 = 0x00000893
        GPU_Wr32(gpu, 13568, 190)                       // 0x3500 = 0x000000BE
        GPU_Wr32(gpu, 13572, 133269)                    // 0x3504 = 0x00020895
        GPU_Wr32(gpu, 13568, 194)                       // 0x3500 = 0x000000C2
        GPU_Wr32(gpu, 13572, 133273)                    // 0x3504 = 0x00020899
        GPU_Wr32(gpu, 13568, 198)                       // 0x3500 = 0x000000C6
        GPU_Wr32(gpu, 13572, 133277)                    // 0x3504 = 0x0002089D
        GPU_Wr32(gpu, 13568, 202)                       // 0x3500 = 0x000000CA
        GPU_Wr32(gpu, 13572, 2209)                      // 0x3504 = 0x000008A1
        GPU_Wr32(gpu, 13568, 204)                       // 0x3500 = 0x000000CC
        GPU_Wr32(gpu, 13572, 2211)                      // 0x3504 = 0x000008A3
        GPU_Wr32(gpu, 13568, 206)                       // 0x3500 = 0x000000CE
        GPU_Wr32(gpu, 13572, 198821)                    // 0x3504 = 0x000308A5
        GPU_Wr32(gpu, 13568, 211)                       // 0x3500 = 0x000000D3
        GPU_Wr32(gpu, 13572, 7145677)                   // 0x3504 = 0x006D08CD
        GPU_Wr32(gpu, 13568, 322)                       // 0x3500 = 0x00000142
        GPU_Wr32(gpu, 13572, 536873306)                 // 0x3504 = 0x2000095A
        GPU_Wr32(gpu, 13572, 1)                         // 0x3504 = 0x00000001
        GPU_Wr32(gpu, 13568, 324)                       // 0x3500 = 0x00000144
        GPU_Wr32(gpu, 13572, 807340379)                 // 0x3504 = 0x301F095B
        GPU_Wr32(gpu, 13568, 357)                       // 0x3500 = 0x00000165
        GPU_Wr32(gpu, 13572, 788813)                    // 0x3504 = 0x000C094D
        GPU_Wr32(gpu, 13568, 371)                       // 0x3500 = 0x00000173
        GPU_Wr32(gpu, 13572, 985453)                    // 0x3504 = 0x000F096D
        GPU_Wr32(gpu, 13568, 388)                       // 0x3500 = 0x00000184
        GPU_Wr32(gpu, 13572, 1378687)                   // 0x3504 = 0x0015097F
        GPU_Wr32(gpu, 13568, 411)                       // 0x3500 = 0x0000019B
        GPU_Wr32(gpu, 13572, 788888)                    // 0x3504 = 0x000C0998
        GPU_Wr32(gpu, 13568, 425)                       // 0x3500 = 0x000001A9
        GPU_Wr32(gpu, 13572, 264615)                    // 0x3504 = 0x000409A7
        GPU_Wr32(gpu, 13568, 431)                       // 0x3500 = 0x000001AF
        GPU_Wr32(gpu, 13572, 3292)                      // 0x3504 = 0x00000CDC
        GPU_Wr32(gpu, 13568, 433)                       // 0x3500 = 0x000001B1
        GPU_Wr32(gpu, 13572, 2048)                      // 0x3504 = 0x00000800

        // ── Final RLC clear state setup ──
        GPU_Wr32(gpu, 13576, 1822105600)                // 0x3508 = 0x6C9B2000
        GPU_Wr32(gpu, 13584, 268378624)                 // 0x3510 = 0x0FFF2200
        GPU_Wr32(gpu, 13636, 4032)                      // 0x3544 = 0x00000FC0

        // ---------------------------------------------------------------
        // Step 9: SDMA channel config (mmiotrace seq 13828-13839)
        // 6 pairs of (base_addr, size) for SDMA descriptor channels.
        // Stride=0x18 per channel, base_addr=0x154, size=0.
        // ---------------------------------------------------------------
        GPU_Wr32(gpu, 24064, 340)                  // 0x5E00 = 0x00000154
        GPU_Wr32(gpu, 24068, 0)                    // 0x5E04 = 0x00000000
        GPU_Wr32(gpu, 24088, 340)                  // 0x5E18 = 0x00000154
        GPU_Wr32(gpu, 24092, 0)                    // 0x5E1C = 0x00000000
        GPU_Wr32(gpu, 24112, 340)                  // 0x5E30 = 0x00000154
        GPU_Wr32(gpu, 24116, 0)                    // 0x5E34 = 0x00000000
        GPU_Wr32(gpu, 24136, 340)                  // 0x5E48 = 0x00000154
        GPU_Wr32(gpu, 24140, 0)                    // 0x5E4C = 0x00000000
        GPU_Wr32(gpu, 24160, 340)                  // 0x5E60 = 0x00000154
        GPU_Wr32(gpu, 24164, 0)                    // 0x5E64 = 0x00000000
        GPU_Wr32(gpu, 24180, 340)                  // 0x5E74 = 0x00000154
        GPU_Wr32(gpu, 24184, 0)                    // 0x5E78 = 0x00000000

        // ---------------------------------------------------------------
        // Step 10: Additional kernel init registers
        // These are written by the kernel but we were missing them.
        // Includes CP, SPI, DB, CB, RLC power management, and SDMA config.
        // ---------------------------------------------------------------
        GPU_Wr32(gpu, 28720, 17)                   // 0x7030 = 0x00000011 (HDMI_CONTROL)
        GPU_Wr32(gpu, 34568, 9437440)              // 0x8708 = 0x00900100 (CP_RB_WPTR_POLL_CNTL)
        GPU_Wr32(gpu, 36484, 0)                    // 0x8E84 = 0x00000000 (SQ_SEC_CNT clear)
        GPU_Wr32(gpu, 36488, 0)                    // 0x8E88 = 0x00000000 (SQ_DED_CNT clear)
        GPU_Wr32(gpu, 37716, 255)                  // 0x9354 = 0x000000FF (SPI_LB_CU_MASK)
        GPU_Wr32(gpu, 38960, 0)                    // 0x9830 = 0x00000000 (DB_DEBUG)
        GPU_Wr32(gpu, 38964, 1024)                 // 0x9834 = 0x00000400 (DB_DEBUG2)
        GPU_Wr32(gpu, 38968, 131584)               // 0x9838 = 0x00020200 (DB_DEBUG3)
        GPU_Wr32(gpu, 39440, 98824)                // 0x9A10 = 0x00018208 (CB_HW_CONTROL)
        GPU_Wr32(gpu, 49636, 131585)               // 0xC1E4 = 0x00020201 (CP_MEM_SLP_CNTL)
        GPU_Wr32(gpu, 49988, 0)                    // 0xC344 = 0x00000000 (RLC_MC_CNTL)
        GPU_Wr32(gpu, 49992, 0)                    // 0xC348 = 0x00000000 (RLC_UCODE_CNTL)
        GPU_Wr32(gpu, 50212, 54464517)             // 0xC424 = 0x033F1005 (RLC_CGCG_CGLS_CTRL)
        GPU_Wr32(gpu, 50296, 128)                  // 0xC478 = 0x00000080 (RLC_LB_CNTR_MAX)
        GPU_Wr32(gpu, 50300, 276856864)            // 0xC47C = 0x10808020 (RLC_LB_CNTR_INIT)
        GPU_Wr32(gpu, 50312, 8388616)              // 0xC488 = 0x00800008 (RLC_LB_INIT_CU_MASK)
        GPU_Wr32(gpu, 53248, 22)                   // 0xD000 = 0x00000016 (SDMA0_UCODE_ADDR)
        GPU_Wr32(gpu, 53256, 0)                    // 0xD008 = 0x00000000 (SDMA0_POWER_CNTL)
        GPU_Wr32(gpu, 53296, 8388672)              // 0xD030 = 0x00800040 (SDMA0_GFX_IB_CNTL)
        GPU_Wr32(gpu, 53316, 0)                    // 0xD044 = 0x00000000 (SDMA0_GFX_RB_BASE)
        GPU_Wr32(gpu, 53320, 0)                    // 0xD048 = 0x00000000 (SDMA0_GFX_RB_BASE_HI)
        GPU_Wr32(gpu, 53440, 256)                  // 0xD0C0 = 0x00000100 (SDMA0_CHICKEN_BITS)
        GPU_Wr32(gpu, 55344, 8388672)              // 0xD830 = 0x00800040 (SDMA1_GFX_IB_CNTL)
        GPU_Wr32(gpu, 55488, 256)                  // 0xD8C0 = 0x00000100 (SDMA1_CHICKEN_BITS)

        PrintMessage("[MC_SI] 3D engine defaults programmed\n")
        PrintMessage("[MC_SI] GPU engine init OK\n")
        ReturnValue(1)
    }
}
