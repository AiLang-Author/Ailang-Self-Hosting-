//
// Library.AMDGPUMC_SI.ailang — Memory Controller init for Southern Islands
//
// Implements MC firmware loading, VRAM training, and MC aperture programming
// for un-POSTed GPUs. On a POSTed GPU (system BIOS did the work), the MC
// sequencer is already running and training is already done — we skip.
//
// Reference: Linux kernel drivers/gpu/drm/radeon/si.c
//   - si_mc_load_microcode()
//   - si_mc_program()
//   - si_gpu_init() (subset)
//
// USAGE
//   LibraryImport.Drivers.AMDGPU.AMDGPUMC_SI

LibraryImport.Drivers.AMDGPU.AMDGPUFamily
LibraryImport.Drivers.AMDGPU.AMDGPUDiscover
LibraryImport.Drivers.AMDGPU.AMDGPUBAR
LibraryImport.Drivers.AMDGPU.AMDGPUPM4Regs

// =============================================================================
// VERDE IO MC REGISTER TABLE
// 36 pairs of (index, data) written via MC_SEQ_IO_DEBUG_INDEX/DATA
// before loading MC microcode. From si.c verde_io_mc_regs[36][2].
// =============================================================================
FixedPool.VerdeMCRegs {
    "COUNT":  Initialize=36
}

// MC_SI_LoadVerdeIORegs — write the 36 verde_io_mc_regs pairs
// Each pair: write index to MC_SEQ_IO_DEBUG_INDEX, data to MC_SEQ_IO_DEBUG_DATA
Function.MC_SI_LoadVerdeIORegs {
    Input: gpu: Integer
    Body: {
        // Pair 0-3
        GPU_Wr32(gpu, SIReg.MC_SEQ_IO_DEBUG_INDEX, 111)  // 0x6F
        GPU_Wr32(gpu, SIReg.MC_SEQ_IO_DEBUG_DATA, 50479104)  // 0x03044000
        GPU_Wr32(gpu, SIReg.MC_SEQ_IO_DEBUG_INDEX, 112)  // 0x70
        GPU_Wr32(gpu, SIReg.MC_SEQ_IO_DEBUG_DATA, 75579416)  // 0x0480C018
        GPU_Wr32(gpu, SIReg.MC_SEQ_IO_DEBUG_INDEX, 113)  // 0x71
        GPU_Wr32(gpu, SIReg.MC_SEQ_IO_DEBUG_DATA, 64)  // 0x00000040
        GPU_Wr32(gpu, SIReg.MC_SEQ_IO_DEBUG_INDEX, 114)  // 0x72
        GPU_Wr32(gpu, SIReg.MC_SEQ_IO_DEBUG_DATA, 16777216)  // 0x01000000

        // Pair 4-7
        GPU_Wr32(gpu, SIReg.MC_SEQ_IO_DEBUG_INDEX, 116)  // 0x74
        GPU_Wr32(gpu, SIReg.MC_SEQ_IO_DEBUG_DATA, 255)  // 0x000000FF
        GPU_Wr32(gpu, SIReg.MC_SEQ_IO_DEBUG_INDEX, 117)  // 0x75
        GPU_Wr32(gpu, SIReg.MC_SEQ_IO_DEBUG_DATA, 1324032)  // 0x00143400
        GPU_Wr32(gpu, SIReg.MC_SEQ_IO_DEBUG_INDEX, 118)  // 0x76
        GPU_Wr32(gpu, SIReg.MC_SEQ_IO_DEBUG_DATA, 149882880)  // 0x08EC0800
        GPU_Wr32(gpu, SIReg.MC_SEQ_IO_DEBUG_INDEX, 119)  // 0x77
        GPU_Wr32(gpu, SIReg.MC_SEQ_IO_DEBUG_DATA, 67108044)  // 0x040000CC

        // Pair 8-11
        GPU_Wr32(gpu, SIReg.MC_SEQ_IO_DEBUG_INDEX, 121)  // 0x79
        GPU_Wr32(gpu, SIReg.MC_SEQ_IO_DEBUG_DATA, 0)  // 0x00000000
        GPU_Wr32(gpu, SIReg.MC_SEQ_IO_DEBUG_INDEX, 122)  // 0x7A
        GPU_Wr32(gpu, SIReg.MC_SEQ_IO_DEBUG_DATA, 553648137)  // 0x21000409
        GPU_Wr32(gpu, SIReg.MC_SEQ_IO_DEBUG_INDEX, 124)  // 0x7C
        GPU_Wr32(gpu, SIReg.MC_SEQ_IO_DEBUG_DATA, 0)  // 0x00000000
        GPU_Wr32(gpu, SIReg.MC_SEQ_IO_DEBUG_INDEX, 125)  // 0x7D
        GPU_Wr32(gpu, SIReg.MC_SEQ_IO_DEBUG_DATA, 3892314112)  // 0xE8000000

        // Pair 12-15
        GPU_Wr32(gpu, SIReg.MC_SEQ_IO_DEBUG_INDEX, 126)  // 0x7E
        GPU_Wr32(gpu, SIReg.MC_SEQ_IO_DEBUG_DATA, 71895208)  // 0x044408A8
        GPU_Wr32(gpu, SIReg.MC_SEQ_IO_DEBUG_INDEX, 127)  // 0x7F
        GPU_Wr32(gpu, SIReg.MC_SEQ_IO_DEBUG_DATA, 3)  // 0x00000003
        GPU_Wr32(gpu, SIReg.MC_SEQ_IO_DEBUG_INDEX, 128)  // 0x80
        GPU_Wr32(gpu, SIReg.MC_SEQ_IO_DEBUG_DATA, 0)  // 0x00000000
        GPU_Wr32(gpu, SIReg.MC_SEQ_IO_DEBUG_INDEX, 129)  // 0x81
        GPU_Wr32(gpu, SIReg.MC_SEQ_IO_DEBUG_DATA, 16777216)  // 0x01000000

        // Pair 16-19
        GPU_Wr32(gpu, SIReg.MC_SEQ_IO_DEBUG_INDEX, 130)  // 0x82
        GPU_Wr32(gpu, SIReg.MC_SEQ_IO_DEBUG_DATA, 33554432)  // 0x02000000
        GPU_Wr32(gpu, SIReg.MC_SEQ_IO_DEBUG_INDEX, 131)  // 0x83
        GPU_Wr32(gpu, SIReg.MC_SEQ_IO_DEBUG_DATA, 0)  // 0x00000000
        GPU_Wr32(gpu, SIReg.MC_SEQ_IO_DEBUG_INDEX, 132)  // 0x84
        GPU_Wr32(gpu, SIReg.MC_SEQ_IO_DEBUG_DATA, 3824583924)  // 0xE3F3E4F4
        GPU_Wr32(gpu, SIReg.MC_SEQ_IO_DEBUG_INDEX, 133)  // 0x85
        GPU_Wr32(gpu, SIReg.MC_SEQ_IO_DEBUG_DATA, 335908)  // 0x00052024

        // Pair 20-23
        GPU_Wr32(gpu, SIReg.MC_SEQ_IO_DEBUG_INDEX, 135)  // 0x87
        GPU_Wr32(gpu, SIReg.MC_SEQ_IO_DEBUG_DATA, 0)  // 0x00000000
        GPU_Wr32(gpu, SIReg.MC_SEQ_IO_DEBUG_INDEX, 136)  // 0x88
        GPU_Wr32(gpu, SIReg.MC_SEQ_IO_DEBUG_DATA, 1711342083)  // 0x66036603
        GPU_Wr32(gpu, SIReg.MC_SEQ_IO_DEBUG_INDEX, 137)  // 0x89
        GPU_Wr32(gpu, SIReg.MC_SEQ_IO_DEBUG_DATA, 16777216)  // 0x01000000
        GPU_Wr32(gpu, SIReg.MC_SEQ_IO_DEBUG_INDEX, 139)  // 0x8B
        GPU_Wr32(gpu, SIReg.MC_SEQ_IO_DEBUG_DATA, 470286336)  // 0x1C0A0000

        // Pair 24-27
        GPU_Wr32(gpu, SIReg.MC_SEQ_IO_DEBUG_INDEX, 140)  // 0x8C
        GPU_Wr32(gpu, SIReg.MC_SEQ_IO_DEBUG_DATA, 4278255616)  // 0xFF010000
        GPU_Wr32(gpu, SIReg.MC_SEQ_IO_DEBUG_INDEX, 142)  // 0x8E
        GPU_Wr32(gpu, SIReg.MC_SEQ_IO_DEBUG_DATA, 4294963199)  // 0xFFFFEFFF
        GPU_Wr32(gpu, SIReg.MC_SEQ_IO_DEBUG_INDEX, 143)  // 0x8F
        GPU_Wr32(gpu, SIReg.MC_SEQ_IO_DEBUG_DATA, 4294377471)  // 0xFFF3EFFF
        GPU_Wr32(gpu, SIReg.MC_SEQ_IO_DEBUG_INDEX, 144)  // 0x90
        GPU_Wr32(gpu, SIReg.MC_SEQ_IO_DEBUG_DATA, 4294377407)  // 0xFFF3EFBF

        // Pair 28-31
        GPU_Wr32(gpu, SIReg.MC_SEQ_IO_DEBUG_INDEX, 148)  // 0x94
        GPU_Wr32(gpu, SIReg.MC_SEQ_IO_DEBUG_DATA, 1052929)  // 0x00101101
        GPU_Wr32(gpu, SIReg.MC_SEQ_IO_DEBUG_INDEX, 149)  // 0x95
        GPU_Wr32(gpu, SIReg.MC_SEQ_IO_DEBUG_DATA, 4095)  // 0x00000FFF
        GPU_Wr32(gpu, SIReg.MC_SEQ_IO_DEBUG_INDEX, 150)  // 0x96
        GPU_Wr32(gpu, SIReg.MC_SEQ_IO_DEBUG_DATA, 1142783)  // 0x00116FFF
        GPU_Wr32(gpu, SIReg.MC_SEQ_IO_DEBUG_INDEX, 151)  // 0x97
        GPU_Wr32(gpu, SIReg.MC_SEQ_IO_DEBUG_DATA, 1610678272)  // 0x60010000

        // Pair 32-35
        GPU_Wr32(gpu, SIReg.MC_SEQ_IO_DEBUG_INDEX, 152)  // 0x98
        GPU_Wr32(gpu, SIReg.MC_SEQ_IO_DEBUG_DATA, 268500992)  // 0x10010000
        GPU_Wr32(gpu, SIReg.MC_SEQ_IO_DEBUG_INDEX, 153)  // 0x99
        GPU_Wr32(gpu, SIReg.MC_SEQ_IO_DEBUG_DATA, 24576)  // 0x00006000
        GPU_Wr32(gpu, SIReg.MC_SEQ_IO_DEBUG_INDEX, 154)  // 0x9A
        GPU_Wr32(gpu, SIReg.MC_SEQ_IO_DEBUG_DATA, 4096)  // 0x00001000
        GPU_Wr32(gpu, SIReg.MC_SEQ_IO_DEBUG_INDEX, 159)  // 0x9F
        GPU_Wr32(gpu, SIReg.MC_SEQ_IO_DEBUG_DATA, 10711040)  // 0x00A37400

        PrintMessage("[MC_SI] Verde IO MC regs loaded (36 pairs)\n")
    }
}

// =============================================================================
// MC_SI_LoadMicrocode — load MC firmware and run VRAM training
//
// Follows kernel si_mc_load_microcode():
//   1. Check if MC sequencer already running (POSTed GPU) → skip
//   2. Reset sequencer (MC_SEQ_SUP_CNTL = 0x08)
//   3. Enable write (MC_SEQ_SUP_CNTL = 0x10)
//   4. Write verde_io_mc_regs via MC_SEQ_IO_DEBUG_INDEX/DATA
//   5. Stream MC firmware via MC_SEQ_SUP_PGM
//   6. Reset (0x08), load (0x04), start (0x01)
//   7. Poll MC_SEQ_TRAIN_WAKEUP_CNTL for TRAIN_DONE_D0/D1
//
// The firmware file (VERDE_mc2.bin) is old format: raw big-endian 32-bit words.
// Must byte-swap to LE before GPU_Wr32 (same as SMC firmware loading).
//
// Returns 1 on success, 0 if already running (skip), negative on error.
// =============================================================================
Function.MC_SI_LoadMicrocode {
    Input: gpu: Integer
    Output: Integer
    Body: {
        // DISPLAY GPU GUARD — never touch MC firmware on the display GPU.
        // The BIOS already loaded MC firmware and trained VRAM.  Reloading
        // resets the MC sequencer which kills the VESA framebuffer.
        IfCondition EqualTo(GPU_BAR_IsDisplayGPU(gpu), 1) ThenBlock: {
            PrintMessage("[MC_SI] LoadMicrocode: REFUSED — display GPU (BIOS already configured)\n")
            ReturnValue(0)
        }

        // Check if MC sequencer is already running
        running = BitwiseAnd(GPU_Rd32(gpu, SIReg.MC_SEQ_SUP_CNTL), MCSeqBits.RUN_MASK)
        IfCondition NotEqual(running, 0) ThenBlock: {
            PrintMessage("[MC_SI] MC sequencer already running, skip firmware load\n")
            // Read CONFIG_MEMSIZE for diagnostics
            memsize = GPU_Rd32(gpu, SIReg.CONFIG_MEMSIZE)
            PrintMessage("[MC_SI] CONFIG_MEMSIZE = ")
            PrintNumber(memsize)
            PrintMessage(" MB\n")
            ReturnValue(0)
        }

        PrintMessage("[MC_SI] MC sequencer NOT running — loading firmware\n")

        // Read pre-init state for diagnostics
        PrintMessage("[MC_SI] Pre-init: MC_SEQ_MISC0=0x")
        PrintHex(GPU_Rd32(gpu, SIReg.MC_SEQ_MISC0))
        PrintMessage(" CONFIG_MEMSIZE=")
        PrintNumber(GPU_Rd32(gpu, SIReg.CONFIG_MEMSIZE))
        PrintMessage("MB\n")

        // --- Step 1: Reset MC sequencer ---
        GPU_Wr32(gpu, SIReg.MC_SEQ_SUP_CNTL, 8)    // 0x08 = reset
        GPU_Wr32(gpu, SIReg.MC_SEQ_SUP_CNTL, 16)   // 0x10 = write enable

        // --- Step 2: Load Verde IO MC register table ---
        MC_SI_LoadVerdeIORegs(gpu)

        // --- Step 3: Load MC firmware from /lib/firmware/radeon/VERDE_mc2.bin ---
        fw_path = Allocate(64)
        // "/lib/firmware/radeon/VERDE_mc2.bin"
        SetByte(fw_path, 0, 47)   // /
        SetByte(fw_path, 1, 108)  // l
        SetByte(fw_path, 2, 105)  // i
        SetByte(fw_path, 3, 98)   // b
        SetByte(fw_path, 4, 47)   // /
        SetByte(fw_path, 5, 102)  // f
        SetByte(fw_path, 6, 105)  // i
        SetByte(fw_path, 7, 114)  // r
        SetByte(fw_path, 8, 109)  // m
        SetByte(fw_path, 9, 119)  // w
        SetByte(fw_path, 10, 97)  // a
        SetByte(fw_path, 11, 114) // r
        SetByte(fw_path, 12, 101) // e
        SetByte(fw_path, 13, 47)  // /
        SetByte(fw_path, 14, 114) // r
        SetByte(fw_path, 15, 97)  // a
        SetByte(fw_path, 16, 100) // d
        SetByte(fw_path, 17, 101) // e
        SetByte(fw_path, 18, 111) // o
        SetByte(fw_path, 19, 110) // n
        SetByte(fw_path, 20, 47)  // /
        SetByte(fw_path, 21, 86)  // V
        SetByte(fw_path, 22, 69)  // E
        SetByte(fw_path, 23, 82)  // R
        SetByte(fw_path, 24, 68)  // D
        SetByte(fw_path, 25, 69)  // E
        SetByte(fw_path, 26, 95)  // _
        SetByte(fw_path, 27, 109) // m
        SetByte(fw_path, 28, 99)  // c
        SetByte(fw_path, 29, 50)  // 2
        SetByte(fw_path, 30, 46)  // .
        SetByte(fw_path, 31, 98)  // b
        SetByte(fw_path, 32, 105) // i
        SetByte(fw_path, 33, 110) // n
        SetByte(fw_path, 34, 0)   // NUL

        fw_fd = SystemCall(2, fw_path, 0, 0)    // open(path, O_RDONLY)
        IfCondition LessThan(fw_fd, 0) ThenBlock: {
            PrintMessage("[MC_SI] ERROR: Cannot open VERDE_mc2.bin\n")
            Deallocate(fw_path, 64)
            ReturnValue(-1)
        }

        // Read firmware into buffer (31500 bytes expected)
        fw_max = 32768
        fw_buf = Allocate(fw_max)
        fw_size = SystemCall(0, fw_fd, fw_buf, fw_max, 0, 0)  // read
        SystemCall(3, fw_fd, 0, 0, 0, 0)                       // close
        Deallocate(fw_path, 64)

        IfCondition LessEqual(fw_size, 0) ThenBlock: {
            PrintMessage("[MC_SI] ERROR: Cannot read firmware\n")
            Deallocate(fw_buf, fw_max)
            ReturnValue(-2)
        }

        PrintMessage("[MC_SI] Firmware loaded: ")
        PrintNumber(fw_size)
        PrintMessage(" bytes\n")

        // Stream firmware words to MC_SEQ_SUP_PGM
        // Old format: big-endian 32-bit words, must byte-swap to LE
        fw_dwords = Divide(fw_size, 4)
        fi = 0
        WhileLoop LessThan(fi, fw_dwords) {
            off = Multiply(fi, 4)
            b0 = GetByte(fw_buf, off)
            b1 = GetByte(fw_buf, Add(off, 1))
            b2 = GetByte(fw_buf, Add(off, 2))
            b3 = GetByte(fw_buf, Add(off, 3))
            // BE→LE swap: file has [MSB..LSB], MMIO wants LE
            le_word = BitwiseOr(BitwiseOr(LeftShift(b0, 24), LeftShift(b1, 16)), BitwiseOr(LeftShift(b2, 8), b3))
            GPU_Wr32(gpu, SIReg.MC_SEQ_SUP_PGM, le_word)
            fi = Add(fi, 1)
        }

        PrintMessage("[MC_SI] Firmware uploaded: ")
        PrintNumber(fw_dwords)
        PrintMessage(" DWORDs\n")

        Deallocate(fw_buf, fw_max)

        // --- Step 4: Start MC sequencer ---
        GPU_Wr32(gpu, SIReg.MC_SEQ_SUP_CNTL, 8)    // 0x08 = reset
        GPU_Wr32(gpu, SIReg.MC_SEQ_SUP_CNTL, 4)    // 0x04 = load
        GPU_Wr32(gpu, SIReg.MC_SEQ_SUP_CNTL, 1)    // 0x01 = start (RUN)

        PrintMessage("[MC_SI] MC sequencer started, waiting for VRAM training...\n")

        // --- Step 5: Poll for VRAM training completion ---
        // Wait for TRAIN_DONE_D0 (bit 30) — timeout ~2 seconds
        d0_done = 0
        poll_i = 0
        WhileLoop LessThan(poll_i, 2000000) {
            train_val = GPU_Rd32(gpu, SIReg.MC_SEQ_TRAIN_WAKEUP_CNTL)
            IfCondition NotEqual(BitwiseAnd(train_val, MCSeqBits.TRAIN_DONE_D0), 0) ThenBlock: {
                d0_done = 1
                poll_i = 2000000  // break
            }
            // ~1us delay (busy-spin — AILang has no usleep)
            poll_i = Add(poll_i, 1)
        }

        IfCondition EqualTo(d0_done, 0) ThenBlock: {
            PrintMessage("[MC_SI] WARNING: TRAIN_DONE_D0 timeout\n")
        }
        ElseBlock: {
            PrintMessage("[MC_SI] TRAIN_DONE_D0 OK\n")
        }

        // Wait for TRAIN_DONE_D1 (bit 31)
        d1_done = 0
        poll_j = 0
        WhileLoop LessThan(poll_j, 2000000) {
            train_val2 = GPU_Rd32(gpu, SIReg.MC_SEQ_TRAIN_WAKEUP_CNTL)
            IfCondition NotEqual(BitwiseAnd(train_val2, MCSeqBits.TRAIN_DONE_D1), 0) ThenBlock: {
                d1_done = 1
                poll_j = 2000000  // break
            }
            poll_j = Add(poll_j, 1)
        }

        IfCondition EqualTo(d1_done, 0) ThenBlock: {
            PrintMessage("[MC_SI] WARNING: TRAIN_DONE_D1 timeout\n")
        }
        ElseBlock: {
            PrintMessage("[MC_SI] TRAIN_DONE_D1 OK\n")
        }

        // --- Diagnostics ---
        PrintMessage("[MC_SI] Post-training: MC_SEQ_MISC0=0x")
        PrintHex(GPU_Rd32(gpu, SIReg.MC_SEQ_MISC0))
        PrintMessage(" CONFIG_MEMSIZE=")
        PrintNumber(GPU_Rd32(gpu, SIReg.CONFIG_MEMSIZE))
        PrintMessage("MB\n")
        PrintMessage("[MC_SI] MC_SEQ_TRAIN_WAKEUP_CNTL=0x")
        PrintHex(GPU_Rd32(gpu, SIReg.MC_SEQ_TRAIN_WAKEUP_CNTL))
        PrintMessage("\n")

        IfCondition EqualTo(d0_done, 1) ThenBlock: {
            IfCondition EqualTo(d1_done, 1) ThenBlock: {
                PrintMessage("[MC_SI] VRAM training PASSED\n")
                ReturnValue(1)
            }
        }

        PrintMessage("[MC_SI] VRAM training INCOMPLETE\n")
        ReturnValue(-3)
    }
}

// =============================================================================
// MC_SI_Program — program MC aperture for un-POSTed GPU
//
// Follows kernel si_mc_program():
//   1. Zero 32 HDP protection buffer entries
//   2. Flush HDP coherency
//   3. Blackout MC: BIF_FB_EN=0, MC_SHARED_BLACKOUT_CNTL|=1
//   4. Lock out VGA aperture
//   5. Program MC_VM_FB_LOCATION, system aperture, HDP nonsurface, AGP
//   6. Unblackout: clear BLACKOUT_MODE, BIF_FB_EN = RW
//
// For un-POSTed headless compute GPUs there are no CRTCs to blank, so we skip
// the full evergreen_mc_stop/resume CRTC blanking sequence.
//
// Uses vram_start=0 (kernel default for SI).
// CONFIG_MEMSIZE must be valid (MC firmware must be loaded first).
//
// Returns 1 on success, negative on error.
// =============================================================================
Function.MC_SI_Program {
    Input: gpu: Integer
    Output: Integer
    Body: {
        // DISPLAY GPU GUARD — never reprogram MC aperture on the display GPU.
        // BIF_FB_EN=0 kills CPU VRAM access (VESA framebuffer goes black),
        // MC_VM_FB_LOCATION reprogram stomps the BIOS-configured aperture,
        // and MC blackout blocks all memory ops.  The display GPU is already
        // fully configured by the BIOS.
        IfCondition EqualTo(GPU_BAR_IsDisplayGPU(gpu), 1) ThenBlock: {
            PrintMessage("[MC_SI] Program: REFUSED — display GPU (BIOS already configured)\n")
            ReturnValue(0)
        }

        PrintMessage("[MC_SI] Programming MC aperture...\n")

        // Read VRAM size from CONFIG_MEMSIZE (set by MC firmware training)
        memsize_mb = GPU_Rd32(gpu, SIReg.CONFIG_MEMSIZE)
        IfCondition EqualTo(memsize_mb, 0) ThenBlock: {
            PrintMessage("[MC_SI] ERROR: CONFIG_MEMSIZE = 0 (MC firmware not loaded?)\n")
            ReturnValue(-1)
        }
        // Also handle garbage in upper 16 bits (kernel si_mc_init check)
        IfCondition NotEqual(BitwiseAnd(memsize_mb, 4294901760), 0) ThenBlock: {
            // 0xFFFF0000 = 4294901760
            IfCondition NotEqual(BitwiseAnd(memsize_mb, 65535), 0) ThenBlock: {
                memsize_mb = BitwiseAnd(memsize_mb, 65535)
            }
        }
        PrintMessage("[MC_SI] CONFIG_MEMSIZE = ")
        PrintNumber(memsize_mb)
        PrintMessage(" MB\n")

        // Compute vram_end: vram_start=0, vram_end = (memsize_mb * 1024 * 1024) - 1
        // But we need the value in 16MB units for FB_LOCATION, and in 4KB pages
        // for aperture registers.
        // top_16mb = (memsize_mb / 16) - 1  (in 16MB units)
        top_16mb = Subtract(Divide(memsize_mb, 16), 1)

        // vram_end_bytes = (memsize_mb << 20) - 1
        // vram_end_page  = vram_end_bytes >> 12 = (memsize_mb << 8) - 1
        vram_end_page = Subtract(LeftShift(memsize_mb, 8), 1)

        // --- Step 1: Initialize HDP protection registers ---
        // Zero 32 entries * 5 regs each, at 0x18 stride from base 0x2C14
        hdp_j = 0
        WhileLoop LessThan(hdp_j, 32) {
            hdp_base = Add(11284, Multiply(hdp_j, 24))  // 0x2C14 = 11284, stride 0x18 = 24
            GPU_Wr32(gpu, hdp_base, 0)                   // +0x00
            GPU_Wr32(gpu, Add(hdp_base, 4), 0)           // +0x04
            GPU_Wr32(gpu, Add(hdp_base, 8), 0)           // +0x08
            GPU_Wr32(gpu, Add(hdp_base, 12), 0)          // +0x0C
            GPU_Wr32(gpu, Add(hdp_base, 16), 0)          // +0x10
            hdp_j = Add(hdp_j, 1)
        }
        GPU_Wr32(gpu, SIReg.HDP_REG_COHERENCY_FLUSH_CNTL, 0)

        // --- Step 2: MC blackout (simplified — no CRTCs on headless compute GPU) ---
        // Block CPU access to framebuffer
        GPU_Wr32(gpu, SIReg.BIF_FB_EN, 0)
        // Blackout MC
        blackout = GPU_Rd32(gpu, SIReg.MC_SHARED_BLACKOUT_CNTL)
        blackout = BitwiseAnd(blackout, 4294967294)  // clear bit 0 (BLACKOUT_MODE_MASK)
        GPU_Wr32(gpu, SIReg.MC_SHARED_BLACKOUT_CNTL, BitwiseOr(blackout, 1))

        // Brief delay for MC to settle (kernel does udelay(100))
        settle_i = 0
        WhileLoop LessThan(settle_i, 100000) {
            settle_i = Add(settle_i, 1)
        }

        // --- Step 3: Lock out VGA aperture ---
        GPU_Wr32(gpu, SIReg.VGA_HDP_CONTROL, MCSeqBits.VGA_MEMORY_DISABLE)

        // --- Step 4: Program MC aperture ---
        // vram_start = 0, so:
        //   MC_VM_SYSTEM_APERTURE_LOW_ADDR  = 0
        //   MC_VM_SYSTEM_APERTURE_HIGH_ADDR = vram_end >> 12
        //   MC_VM_SYSTEM_APERTURE_DEFAULT_ADDR = 0  (vram_scratch page)
        GPU_Wr32(gpu, SIReg.MC_VM_SYSTEM_APERTURE_LOW_ADDR, 0)
        GPU_Wr32(gpu, SIReg.MC_VM_SYSTEM_APERTURE_HIGH_ADDR, vram_end_page)
        GPU_Wr32(gpu, SIReg.MC_VM_SYSTEM_APERTURE_DEFAULT_ADDR, 0)

        // MC_VM_FB_LOCATION = (top << 16) | base
        // top = top_16mb, base = 0 (vram_start >> 24 = 0)
        fb_loc = LeftShift(top_16mb, 16)
        GPU_Wr32(gpu, SIReg.MC_VM_FB_LOCATION, fb_loc)

        // HDP nonsurface: base = vram_start >> 8 = 0
        //   INFO = (2 << 7) | (1 << 30) = 256 | 1073741824 = 1073742080
        //   SIZE = 0x3FFFFFFF = 1073741823
        GPU_Wr32(gpu, SIReg.HDP_NONSURFACE_BASE, 0)
        GPU_Wr32(gpu, SIReg.HDP_NONSURFACE_INFO, 1073742080)
        GPU_Wr32(gpu, SIReg.HDP_NONSURFACE_SIZE, 1073741823)

        // AGP aperture: disabled (base=0, both top and bot = 0x0FFFFFFF)
        GPU_Wr32(gpu, SIReg.MC_VM_AGP_BASE, 0)
        GPU_Wr32(gpu, SIReg.MC_VM_AGP_TOP, 268435455)
        GPU_Wr32(gpu, SIReg.MC_VM_AGP_BOT, 268435455)

        PrintMessage("[MC_SI] MC_VM_FB_LOCATION = 0x")
        PrintHex(fb_loc)
        PrintMessage("  (top_16mb=")
        PrintNumber(top_16mb)
        PrintMessage(")\n")

        // --- Step 5: Un-blackout MC ---
        // Clear blackout mode
        blackout2 = GPU_Rd32(gpu, SIReg.MC_SHARED_BLACKOUT_CNTL)
        blackout2 = BitwiseAnd(blackout2, 4294967294)  // clear bit 0
        GPU_Wr32(gpu, SIReg.MC_SHARED_BLACKOUT_CNTL, blackout2)
        // Re-enable CPU access: FB_READ_EN | FB_WRITE_EN = 1 | 2 = 3
        GPU_Wr32(gpu, SIReg.BIF_FB_EN, 3)

        // --- Step 6: Verify ---
        PrintMessage("[MC_SI] Post-program: MC_VM_FB_LOCATION=0x")
        PrintHex(GPU_Rd32(gpu, SIReg.MC_VM_FB_LOCATION))
        PrintMessage("\n")
        PrintMessage("[MC_SI] SYSTEM_APERTURE: low=0x")
        PrintHex(GPU_Rd32(gpu, SIReg.MC_VM_SYSTEM_APERTURE_LOW_ADDR))
        PrintMessage(" high=0x")
        PrintHex(GPU_Rd32(gpu, SIReg.MC_VM_SYSTEM_APERTURE_HIGH_ADDR))
        PrintMessage("\n")

        PrintMessage("[MC_SI] MC aperture programmed OK\n")
        ReturnValue(1)
    }
}

// =============================================================================
// MC_SI_GpuInit — full si_gpu_init() equivalent for Cape Verde
//
// Programs the GPU engine configuration after MC firmware + aperture setup.
// This is a reimplementation of the kernel's si_gpu_init() from si.c.
//
// Includes:
//   1. GRBM_GFX_INDEX broadcast mode (CRITICAL — per-pipe regs need this)
//   2. GRBM_CNTL read timeout
//   3. SRBM interrupt init
//   4. BIF_FB_EN
//   5. MC_ARB_RAMCFG → ROW_SIZE adjustment for GB_ADDR_CONFIG
//   6. Address config broadcast (GB, DMIF, HDP, DMA)
//   7. Tiling mode table (GB_TILE_MODE0-31, Verde values)
//   8. Per-SE render backend setup (si_setup_rb)
//   9. Per-SE/SH SPI thread management (si_setup_spi)
//  10. 3D engine defaults
//  11. PA_CL_ENHANCE
//
// SKIPPED (deadlock risk on RD990 — see gpu-crash.md Fix #2):
//   - HDP_MISC_CNTL |= HDP_FLUSH_INVALIDATE_CACHE (CPU-side)
//   - HDP_HOST_PATH_CNTL read-modify-write (CPU-side)
//   These are done GPU-side via PM4 WRITE_DATA in the dispatch path.
//
// Returns 1 on success.
// =============================================================================
Function.MC_SI_GpuInit {
    Input: gpu: Integer
    Output: Integer
    Body: {
        // DISPLAY GPU GUARD — never run si_gpu_init on the display GPU.
        // Overwrites DMIF_ADDR_CONFIG (corrupts scanout address decode),
        // writes GRBM_GFX_INDEX broadcast mode, reprograms GB_TILE_MODE
        // table, PA_SC_RASTER_CONFIG, SPI thread mgmt, and 3D engine
        // defaults — all of which stomp the BIOS-configured display engine.
        IfCondition EqualTo(GPU_BAR_IsDisplayGPU(gpu), 1) ThenBlock: {
            PrintMessage("[MC_SI] GpuInit: REFUSED — display GPU (BIOS already configured)\n")
            ReturnValue(0)
        }

        PrintMessage("[MC_SI] GPU engine init (si_gpu_init)...\n")

        // ---------------------------------------------------------------
        // Step 0: Disable ALL clock gating before any GRBM-domain writes.
        //
        // On an un-POSTed GPU, MGCG/CGCG gate the GRBM block clock.
        // Without disabling them first, writes to GRBM-routed registers
        // silently vanish (reads return power-on defaults).
        //
        // Matches kernel si_init_golden_registers() → verde_mgcg_cgcg_init[]:
        //   { 0xC400, 0xFFFFFFFF, 0xFFFFFFFC }  ← RLC_CGTT_MGCG_OVERRIDE
        //   { 0xC404 }                           ← RLC_CGCG_CGLS_CTRL = 0
        //   { 0x9150 }                           ← CGTS_SM_CTRL_REG
        //
        // These are SRBM-routed (always-on domain), so they work even
        // when GRBM is clock-gated.
        // ---------------------------------------------------------------
        GPU_Wr32(gpu, SIReg.RLC_CGTT_MGCG_OVERRIDE, 4294967292)   // 0xFFFFFFFC
        GPU_Wr32(gpu, SIReg.RLC_CGCG_CGLS_CTRL, 0)               // disable CGCG + CGLS
        GPU_Wr32(gpu, SIReg.CGTS_SM_CTRL_REG, 6291456)            // 0x600000 = LS_OVERRIDE|OVERRIDE
        PrintMessage("[MC_SI] Clock gating disabled: MGCG=0x")
        PrintHex(GPU_Rd32(gpu, SIReg.RLC_CGTT_MGCG_OVERRIDE))
        PrintMessage(" CGCG_CGLS=0x")
        PrintHex(GPU_Rd32(gpu, SIReg.RLC_CGCG_CGLS_CTRL))
        PrintMessage(" CGTS=0x")
        PrintHex(GPU_Rd32(gpu, SIReg.CGTS_SM_CTRL_REG))
        PrintMessage("\n")

        // ---------------------------------------------------------------
        // Step 0b: Verde golden registers (si_init_golden_registers)
        //
        // These are chip-specific errata workarounds that the BIOS programs
        // during POST on the display GPU.  On the un-POSTed compute GPU,
        // these are at power-on defaults (likely all zeros), which breaks
        // the texture cache pipeline (buffer_load_dword → 0xFFFFFFFF).
        //
        // From verde_golden_registers[] in si.c — read-modify-write with mask.
        // Only the registers critical for compute are listed here.
        // ---------------------------------------------------------------

        // TA_CNTL_AUX (0x9508): set bit 16 — Texture Address unit control
        // Required for buffer_load to route through TA correctly.
        // mask=0x00010000, val=0x00010000
        ta_aux = GPU_Rd32(gpu, SIReg.TA_CNTL_AUX)
        ta_aux = BitwiseAnd(ta_aux, BitwiseNot(65536))    // ~0x10000
        ta_aux = BitwiseOr(ta_aux, 65536)                  // 0x10000
        GPU_Wr32(gpu, SIReg.TA_CNTL_AUX, ta_aux)

        // TCP_ADDR_CONFIG (0xAC14): NUM_TCC_BLOCKS for Verde
        // mask=0x000003FF, val=0x00000003 (4 TCC blocks)
        // Must match memory channel config for TC to route correctly.
        tcp_cfg = GPU_Rd32(gpu, SIReg.TCP_ADDR_CONFIG)
        tcp_cfg = BitwiseAnd(tcp_cfg, BitwiseNot(1023))    // ~0x3FF
        tcp_cfg = BitwiseOr(tcp_cfg, 3)                     // 0x3
        GPU_Wr32(gpu, SIReg.TCP_ADDR_CONFIG, tcp_cfg)

        // TCP_CHAN_STEER_HI (0xAC10): all zeros for Verde (2 pipes)
        // mask=0xFFFFFFFF, val=0x00000000
        GPU_Wr32(gpu, SIReg.TCP_CHAN_STEER_HI, 0)

        // TCP_CHAN_STEER_LO (0xAC0C): channel steering for Verde
        // mask=0xFFFFFFFF, val=0x00001032
        GPU_Wr32(gpu, SIReg.TCP_CHAN_STEER_LO, 4146)       // 0x1032

        // SPI_CONFIG_CNTL (0x9100): GPR_WRITE_PRIORITY=3 (bits [25:24])
        // mask=0x07FFFFFF, val=0x03000000 — critical for wavefront dispatch
        spi_cfg = GPU_Rd32(gpu, SIReg.SPI_CONFIG_CNTL)
        spi_cfg = BitwiseAnd(spi_cfg, BitwiseNot(134217727))  // ~0x07FFFFFF
        spi_cfg = BitwiseOr(spi_cfg, 50331648)                // 0x03000000
        GPU_Wr32(gpu, SIReg.SPI_CONFIG_CNTL, spi_cfg)

        // SX_DEBUG_1 (0x9060): bit 5
        // mask=0x0000007F, val=0x00000020
        sx_dbg = GPU_Rd32(gpu, SIReg.SX_DEBUG_1)
        sx_dbg = BitwiseAnd(sx_dbg, BitwiseNot(127))       // ~0x7F
        sx_dbg = BitwiseOr(sx_dbg, 32)                      // 0x20
        GPU_Wr32(gpu, SIReg.SX_DEBUG_1, sx_dbg)

        PrintMessage("[MC_SI] Verde golden registers programmed (TA, TCP, SPI, SX)\n")

        // ---------------------------------------------------------------
        // Step 1: Initialize HDP (Host Data Path) protection buffers.
        //
        // HDP bridges CPU MMIO to GPU internal register bus.  On an
        // un-POSTed GPU, HDP protection buffers contain garbage from
        // power-on defaults, which can block or misdirect register writes.
        // The kernel zeros 32 entries × 5 regs each at 0x2C14 stride 0x18.
        // ---------------------------------------------------------------
        hdp_i = 0
        WhileLoop LessThan(hdp_i, 32) {
            hdp_base = Add(11284, Multiply(hdp_i, 24))   // 0x2C14 + i*0x18
            GPU_Wr32(gpu, hdp_base, 0)
            GPU_Wr32(gpu, Add(hdp_base, 4), 0)           // +0x04
            GPU_Wr32(gpu, Add(hdp_base, 8), 0)           // +0x08
            GPU_Wr32(gpu, Add(hdp_base, 12), 0)          // +0x0C
            GPU_Wr32(gpu, Add(hdp_base, 16), 0)          // +0x10
            hdp_i = Add(hdp_i, 1)
        }
        PrintMessage("[MC_SI] HDP protection buffers zeroed (32 entries)\n")

        // ---------------------------------------------------------------
        // Step 2: GRBM read timeout + SRBM interrupts + BIF_FB_EN
        //
        // CRITICAL: These MUST be set BEFORE writing GRBM_GFX_INDEX.
        // Without GRBM_CNTL timeout, GRBM writes have no timeout and
        // silently drop.  Without BIF_FB_EN, the bus interface doesn't
        // forward FB accesses.  Matches kernel si_gpu_init() ordering.
        // ---------------------------------------------------------------
        GPU_Wr32(gpu, SIReg.GRBM_CNTL, 255)           // GRBM_READ_TIMEOUT(0xFF)
        GPU_Wr32(gpu, SIReg.SRBM_INT_CNTL, 1)
        GPU_Wr32(gpu, SIReg.SRBM_INT_ACK, 1)
        GPU_Wr32(gpu, SIReg.BIF_FB_EN, 3)              // FB_READ_EN | FB_WRITE_EN

        PrintMessage("[MC_SI] GRBM_CNTL=0x")
        PrintHex(GPU_Rd32(gpu, SIReg.GRBM_CNTL))
        PrintMessage(" BIF_FB_EN=0x")
        PrintHex(GPU_Rd32(gpu, SIReg.BIF_FB_EN))
        PrintMessage("\n")

        // ---------------------------------------------------------------
        // Step 3: Read MC_ARB_RAMCFG, compute ROW_SIZE, adjust GB_ADDR_CONFIG
        // ---------------------------------------------------------------
        discard_chmap = GPU_Rd32(gpu, SIReg.MC_SHARED_CHMAP)
        ramcfg = GPU_Rd32(gpu, SIReg.MC_ARB_RAMCFG)

        PrintMessage("[MC_SI] MC_ARB_RAMCFG = 0x")
        PrintHex(ramcfg)

        // mem_row_size_in_kb = (4 * (1 << (8 + noofcols))) / 1024
        // NOOFCOLS = (ramcfg >> 6) & 0x3
        noofcols = BitwiseAnd(RightShift(ramcfg, 6), 3)
        // For noofcols=0: 1KB, =1: 2KB, =2: 4KB, =3: 8KB (clamped to 4KB)
        row_size_code = noofcols
        IfCondition GreaterThan(row_size_code, 2) ThenBlock: {
            row_size_code = 2       // clamp: max 4KB = ROW_SIZE(2)
        }

        PrintMessage(" NOOFCOLS=")
        PrintNumber(noofcols)
        PrintMessage(" ROW_SIZE=")
        PrintNumber(row_size_code)
        PrintMessage("\n")

        // Start with VERDE_GB_ADDR_CONFIG_GOLDEN = 0x12010002
        // Clear ROW_SIZE field (bits [29:28]) then set from ramcfg
        // ROW_SIZE_MASK = 0x30000000
        gb_addr = BitwiseAnd(302055426, 3489660927)     // 0x12010002 & ~0x30000000 = 0x12010002 & 0xCFFFFFFF
        gb_addr = BitwiseOr(gb_addr, LeftShift(row_size_code, 28))

        PrintMessage("[MC_SI] GB_ADDR_CONFIG = 0x")
        PrintHex(gb_addr)
        PrintMessage("\n")

        // ---------------------------------------------------------------
        // Step 4: Broadcast address config to all decode hardware
        // ---------------------------------------------------------------
        GPU_Wr32(gpu, SIReg.GB_ADDR_CONFIG, gb_addr)
        GPU_Wr32(gpu, SIReg.DMIF_ADDR_CONFIG, gb_addr)
        GPU_Wr32(gpu, SIReg.DMIF_ADDR_CALC, gb_addr)
        GPU_Wr32(gpu, SIReg.HDP_ADDR_CONFIG, gb_addr)
        GPU_Wr32(gpu, SIReg.DMA_TILING_CONFIG, gb_addr)                    // DMA0
        GPU_Wr32(gpu, Add(SIReg.DMA_TILING_CONFIG, 2048), gb_addr)         // DMA1 (+0x800)

        // NOTE: GB_ADDR_CONFIG is write-only on SI — readback returns
        // power-on defaults (0x10000000), NOT the value written.  The kernel
        // (si.c:si_gpu_init) never reads it back.  Don't treat mismatch as error.

        // ---------------------------------------------------------------
        // Step 5: Set GRBM_GFX_INDEX to broadcast mode
        //
        // MUST come AFTER GRBM_CNTL (timeout), BIF_FB_EN (bus interface),
        // and GB_ADDR_CONFIG (memory layout).  The kernel's si_gpu_init()
        // only first writes GRBM_GFX_INDEX inside si_setup_rb() which is
        // called AFTER all the above.  Writing it before those prereqs
        // causes the write to silently drop.
        // ---------------------------------------------------------------
        gfx_broadcast = BitwiseOr(GFXIndexBits.INSTANCE_BROADCAST_WRITES, BitwiseOr(GFXIndexBits.SH_BROADCAST_WRITES, GFXIndexBits.SE_BROADCAST_WRITES))
        GPU_Wr32(gpu, SIReg.GRBM_GFX_INDEX, gfx_broadcast)
        // NOTE: GRBM_GFX_INDEX is write-only — readback returns 0x0.
        // The kernel (si.c) never reads it back.  Write is trusted.

        // ---------------------------------------------------------------
        // Step 6: Tiling mode table — GB_TILE_MODE0 through GB_TILE_MODE31
        // Verde-specific values from kernel si_tiling_mode_table_init().
        // split_equal_to_row_size is determined at runtime from row_size_code.
        // ---------------------------------------------------------------
        // Compute split_equal_to_row_size: ROW_SIZE 0=1KB→4, 1=2KB→5, 2=4KB→6
        split_row = Add(row_size_code, 4)

        // Precompute the split_row contribution shifted into TILE_SPLIT position (bits [13:11])
        split_row_shifted = LeftShift(split_row, 11)

        // Base tile values without TILE_SPLIT (for entries using split_equal_to_row_size)
        // These have TILE_SPLIT=0 in the base; we OR in split_row_shifted
        // tile[0]: 2D_THIN1, DEPTH, P4_8x16, SPLIT_64B, 16BANK, W1, H4, ASPECT4
        GPU_Wr32(gpu, SIReg.GB_TILE_MODE0, 3801362)                          // 0x003A0112
        // tile[1]: same, SPLIT_128B
        GPU_Wr32(gpu, Add(SIReg.GB_TILE_MODE0, 4), 3803410)                  // 0x003A0912
        // tile[2]: same, SPLIT_256B
        GPU_Wr32(gpu, Add(SIReg.GB_TILE_MODE0, 8), 3805458)                  // 0x003A1112
        // tile[3]: same as [1]
        GPU_Wr32(gpu, Add(SIReg.GB_TILE_MODE0, 12), 3803410)                 // 0x003A0912
        // tile[4]: 1D_THIN1, DEPTH, P4_8x16, SPLIT_64B, 16BANK, W1, H2, ASPECT2
        GPU_Wr32(gpu, Add(SIReg.GB_TILE_MODE0, 16), 3473674)                 // 0x0035010A
        // tile[5]: 2D_THIN1, DEPTH, P4_8x16, split_row, 16BANK, W1, H2, ASPECT2
        //   base without split = 0x00350112, OR in split_row_shifted
        GPU_Wr32(gpu, Add(SIReg.GB_TILE_MODE0, 20), BitwiseOr(3473682, split_row_shifted))
        // tile[6]: 2D_THIN1, DEPTH, P4_8x16, split_row, 16BANK, W1, H1, ASPECT2
        //   base without split = 0x00340112
        GPU_Wr32(gpu, Add(SIReg.GB_TILE_MODE0, 24), BitwiseOr(3408146, split_row_shifted))
        // tile[7]: 2D_THIN1, DEPTH, P4_8x16, split_row, 16BANK, W1, H4, ASPECT4
        //   base without split = 0x003A0112
        GPU_Wr32(gpu, Add(SIReg.GB_TILE_MODE0, 28), BitwiseOr(3801362, split_row_shifted))
        // tile[8]: LINEAR_ALIGNED, DISPLAY, P4_8x16, SPLIT_64B, 16BANK, W1, H2, ASPECT2
        GPU_Wr32(gpu, Add(SIReg.GB_TILE_MODE0, 32), 3473668)                 // 0x00350104
        // tile[9]: 1D_THIN1, DISPLAY, P4_8x16, SPLIT_64B, 16BANK, W1, H2, ASPECT2
        GPU_Wr32(gpu, Add(SIReg.GB_TILE_MODE0, 36), 3473672)                 // 0x00350108
        // tile[10]: 2D_THIN1, DISPLAY, P4_8x16, SPLIT_256B, 16BANK, W1, H4, ASPECT4
        GPU_Wr32(gpu, Add(SIReg.GB_TILE_MODE0, 40), 3805456)                 // 0x003A1110
        // tile[11]: 2D_THIN1, DISPLAY, P4_8x16, SPLIT_256B, 16BANK, W1, H2, ASPECT2
        GPU_Wr32(gpu, Add(SIReg.GB_TILE_MODE0, 44), 3477776)                 // 0x00351110
        // tile[12]: 2D_THIN1, DISPLAY, P4_8x16, SPLIT_512B, 16BANK, W1, H1, ASPECT2
        GPU_Wr32(gpu, Add(SIReg.GB_TILE_MODE0, 48), 3414288)                 // 0x00341910
        // tile[13]: 1D_THIN1, THIN, P4_8x16, SPLIT_64B, 16BANK, W1, H2, ASPECT2
        GPU_Wr32(gpu, Add(SIReg.GB_TILE_MODE0, 52), 3473673)                 // 0x00350109
        // tile[14]: 2D_THIN1, THIN, P4_8x16, SPLIT_256B, 16BANK, W1, H4, ASPECT2
        GPU_Wr32(gpu, Add(SIReg.GB_TILE_MODE0, 56), 3543313)                 // 0x00361111
        // tile[15]: 2D_THIN1, THIN, P4_8x16, SPLIT_256B, 16BANK, W1, H2, ASPECT2
        GPU_Wr32(gpu, Add(SIReg.GB_TILE_MODE0, 60), 3477777)                 // 0x00351111
        // tile[16]: 2D_THIN1, THIN, P4_8x16, SPLIT_512B, 16BANK, W1, H1, ASPECT2
        GPU_Wr32(gpu, Add(SIReg.GB_TILE_MODE0, 64), 3414289)                 // 0x00341911
        // tile[17]: 2D_THIN1, THIN, P4_8x16, split_row, 16BANK, W1, H1, ASPECT2
        //   base without split = 0x00340111
        GPU_Wr32(gpu, Add(SIReg.GB_TILE_MODE0, 68), BitwiseOr(3408145, split_row_shifted))
        // tile[18-20]: unused (0)
        GPU_Wr32(gpu, Add(SIReg.GB_TILE_MODE0, 72), 0)
        GPU_Wr32(gpu, Add(SIReg.GB_TILE_MODE0, 76), 0)
        GPU_Wr32(gpu, Add(SIReg.GB_TILE_MODE0, 80), 0)
        // tile[21]: 2D_THIN1, THIN, P8_32x32_8x16, SPLIT_256B, 16BANK, W2, H4, ASPECT2
        GPU_Wr32(gpu, Add(SIReg.GB_TILE_MODE0, 84), 3560081)                 // 0x00365291
        // tile[22]: 2D_THIN1, THIN, P8_32x32_8x16, SPLIT_256B, 16BANK, W1, H4, ASPECT4
        GPU_Wr32(gpu, Add(SIReg.GB_TILE_MODE0, 88), 3805841)                 // 0x003A1291
        // tile[23]: 2D_THIN1, THIN, P8_32x32_8x16, SPLIT_256B, 16BANK, W1, H2, ASPECT2
        GPU_Wr32(gpu, Add(SIReg.GB_TILE_MODE0, 92), 3478161)                 // 0x00351291
        // tile[24]: 2D_THIN1, THIN, P8_32x32_8x16, SPLIT_512B, 16BANK, W1, H1, ASPECT2
        GPU_Wr32(gpu, Add(SIReg.GB_TILE_MODE0, 96), 3414673)                 // 0x00341A91
        // tile[25]: 2D_THIN1, THIN, P8_32x32_8x16, SPLIT_1KB, 8BANK, W1, H1, ASPECT1
        GPU_Wr32(gpu, Add(SIReg.GB_TILE_MODE0, 100), 2106001)                // 0x00202291
        // tile[26-31]: unused
        GPU_Wr32(gpu, Add(SIReg.GB_TILE_MODE0, 104), 0)
        GPU_Wr32(gpu, Add(SIReg.GB_TILE_MODE0, 108), 0)
        GPU_Wr32(gpu, Add(SIReg.GB_TILE_MODE0, 112), 0)
        GPU_Wr32(gpu, Add(SIReg.GB_TILE_MODE0, 116), 0)
        GPU_Wr32(gpu, Add(SIReg.GB_TILE_MODE0, 120), 0)
        GPU_Wr32(gpu, Add(SIReg.GB_TILE_MODE0, 124), 0)

        PrintMessage("[MC_SI] Tile mode table programmed (32 entries)\n")

        // ---------------------------------------------------------------
        // Step 6: si_setup_rb — render backend setup for Verde
        // Verde: 1 SE, 2 SH/SE, 4 backends/SE (2 per SH)
        //
        // Read disabled RB mask, compute enabled RBs, program PA_SC_RASTER_CONFIG
        // ---------------------------------------------------------------

        // Select SE 0, broadcast to all SH to read disabled RBs
        // INSTANCE_BROADCAST | SH_BROADCAST | SE_INDEX(0)
        GPU_Wr32(gpu, SIReg.GRBM_GFX_INDEX, BitwiseOr(GFXIndexBits.INSTANCE_BROADCAST_WRITES, GFXIndexBits.SH_BROADCAST_WRITES))

        // Read disabled RBs from fuse registers
        rb_disable = GPU_Rd32(gpu, SIReg.CC_RB_BACKEND_DISABLE)
        IfCondition NotEqual(BitwiseAnd(rb_disable, 1), 0) ThenBlock: {
            // Bit 0 set means fuse data is valid, use BACKEND_DISABLE field
            rb_disable = BitwiseAnd(rb_disable, 16711680)    // BACKEND_DISABLE_MASK = 0x00FF0000
        }
        IfCondition EqualTo(BitwiseAnd(rb_disable, 1), 0) ThenBlock: {
            rb_disable = 0
        }
        rb_disable = BitwiseOr(rb_disable, GPU_Rd32(gpu, SIReg.GC_USER_RB_BACKEND_DISABLE))
        rb_disable = RightShift(BitwiseAnd(rb_disable, 16711680), 16)  // BACKEND_DISABLE_SHIFT = 16

        // Build enabled_rbs bitmask (4 backends for Verde, 2 per SH)
        enabled_rbs = BitwiseAnd(BitwiseNot(rb_disable), 15)   // mask to 4 bits

        PrintMessage("[MC_SI] RB enabled mask = 0x")
        PrintHex(enabled_rbs)
        PrintMessage("\n")

        // Compute PA_SC_RASTER_CONFIG for SE 0
        // Process 2 SH groups of 2 RBs each
        // RASTER_CONFIG_RB_MAP: 0=MAP_0, 2=MAP_2(both), 3=MAP_3
        raster_data = 0
        // SH 0: RBs [1:0]
        sh0_rbs = BitwiseAnd(enabled_rbs, 3)
        IfCondition EqualTo(sh0_rbs, 1) ThenBlock: { raster_data = BitwiseOr(raster_data, 0) }     // RB_MAP_0
        IfCondition EqualTo(sh0_rbs, 2) ThenBlock: { raster_data = BitwiseOr(raster_data, 3) }     // RB_MAP_3
        IfCondition EqualTo(sh0_rbs, 3) ThenBlock: { raster_data = BitwiseOr(raster_data, 2) }     // RB_MAP_2
        // SH 1: RBs [3:2]
        sh1_rbs = BitwiseAnd(RightShift(enabled_rbs, 2), 3)
        IfCondition EqualTo(sh1_rbs, 1) ThenBlock: { raster_data = BitwiseOr(raster_data, 0) }     // RB_MAP_0 << 2
        IfCondition EqualTo(sh1_rbs, 2) ThenBlock: { raster_data = BitwiseOr(raster_data, 12) }    // RB_MAP_3 << 2
        IfCondition EqualTo(sh1_rbs, 3) ThenBlock: { raster_data = BitwiseOr(raster_data, 8) }     // RB_MAP_2 << 2

        // Write raster config for SE 0
        // Select SE 0, all SH
        GPU_Wr32(gpu, SIReg.GRBM_GFX_INDEX, BitwiseOr(GFXIndexBits.INSTANCE_BROADCAST_WRITES, BitwiseOr(GFXIndexBits.SH_BROADCAST_WRITES, 0)))
        GPU_Wr32(gpu, SIReg.PA_SC_RASTER_CONFIG, raster_data)

        PrintMessage("[MC_SI] PA_SC_RASTER_CONFIG = 0x")
        PrintHex(raster_data)
        PrintMessage("\n")

        // Restore broadcast mode
        GPU_Wr32(gpu, SIReg.GRBM_GFX_INDEX, gfx_broadcast)

        // ---------------------------------------------------------------
        // Step 7: si_setup_spi — SPI thread management for Verde
        // Verde: 1 SE, 2 SH/SE, 5 CU/SH
        // For each (SE, SH): read active CU mask, update SPI_STATIC_THREAD_MGMT_3
        // ---------------------------------------------------------------
        // SE 0, SH 0
        // INSTANCE_BROADCAST | SH_INDEX(0) | SE_INDEX(0)
        GPU_Wr32(gpu, SIReg.GRBM_GFX_INDEX, GFXIndexBits.INSTANCE_BROADCAST_WRITES)
        spi_data = GPU_Rd32(gpu, SIReg.SPI_STATIC_THREAD_MGMT_3)
        // Read active CU bitmap
        cu_cfg0 = GPU_Rd32(gpu, SIReg.CC_GC_SHADER_ARRAY_CONFIG)
        IfCondition NotEqual(BitwiseAnd(cu_cfg0, 1), 0) ThenBlock: {
            cu_cfg0 = BitwiseAnd(cu_cfg0, 4294901760)   // INACTIVE_CUS_MASK = 0xFFFF0000
        }
        IfCondition EqualTo(BitwiseAnd(cu_cfg0, 1), 0) ThenBlock: {
            cu_cfg0 = 0
        }
        cu_cfg0 = BitwiseOr(cu_cfg0, GPU_Rd32(gpu, SIReg.GC_USER_SHADER_ARRAY_CONFIG))
        cu_inactive0 = RightShift(cu_cfg0, 16)          // INACTIVE_CUS_SHIFT = 16
        cu_active0 = BitwiseAnd(BitwiseNot(cu_inactive0), 31)  // 5 CUs = mask 0x1F
        // Find first active CU and clear its bit in SPI_STATIC_THREAD_MGMT_3
        spi_k = 0
        spi_mask = 1
        WhileLoop LessThan(spi_k, 16) {
            spi_mask = LeftShift(1, spi_k)
            IfCondition NotEqual(BitwiseAnd(cu_active0, spi_mask), 0) ThenBlock: {
                spi_data = BitwiseAnd(spi_data, BitwiseNot(spi_mask))
                GPU_Wr32(gpu, SIReg.SPI_STATIC_THREAD_MGMT_3, spi_data)
                spi_k = 16  // break
            }
            spi_k = Add(spi_k, 1)
        }

        // SE 0, SH 1
        // INSTANCE_BROADCAST | SH_INDEX(1) | SE_INDEX(0)
        GPU_Wr32(gpu, SIReg.GRBM_GFX_INDEX, BitwiseOr(GFXIndexBits.INSTANCE_BROADCAST_WRITES, 256))  // SH_INDEX(1) = 1<<8 = 256
        spi_data2 = GPU_Rd32(gpu, SIReg.SPI_STATIC_THREAD_MGMT_3)
        cu_cfg1 = GPU_Rd32(gpu, SIReg.CC_GC_SHADER_ARRAY_CONFIG)
        IfCondition NotEqual(BitwiseAnd(cu_cfg1, 1), 0) ThenBlock: {
            cu_cfg1 = BitwiseAnd(cu_cfg1, 4294901760)
        }
        IfCondition EqualTo(BitwiseAnd(cu_cfg1, 1), 0) ThenBlock: {
            cu_cfg1 = 0
        }
        cu_cfg1 = BitwiseOr(cu_cfg1, GPU_Rd32(gpu, SIReg.GC_USER_SHADER_ARRAY_CONFIG))
        cu_inactive1 = RightShift(cu_cfg1, 16)
        cu_active1 = BitwiseAnd(BitwiseNot(cu_inactive1), 31)
        spi_k2 = 0
        WhileLoop LessThan(spi_k2, 16) {
            spi_mask2 = LeftShift(1, spi_k2)
            IfCondition NotEqual(BitwiseAnd(cu_active1, spi_mask2), 0) ThenBlock: {
                spi_data2 = BitwiseAnd(spi_data2, BitwiseNot(spi_mask2))
                GPU_Wr32(gpu, SIReg.SPI_STATIC_THREAD_MGMT_3, spi_data2)
                spi_k2 = 16  // break
            }
            spi_k2 = Add(spi_k2, 1)
        }

        // Restore broadcast mode
        GPU_Wr32(gpu, SIReg.GRBM_GFX_INDEX, gfx_broadcast)

        PrintMessage("[MC_SI] SPI thread mgmt programmed (1 SE, 2 SH)\n")

        // ---------------------------------------------------------------
        // Step 8: 3D engine defaults from si_gpu_init()
        // ---------------------------------------------------------------
        // CP queue thresholds: ROQ_IB1_START(0x16) | ROQ_IB2_START(0x2B)
        GPU_Wr32(gpu, SIReg.CP_QUEUE_THRESHOLDS, 11030)                      // 0x2B16
        // CP MEQ thresholds: MEQ1_START(0x30) | MEQ2_START(0x60)
        GPU_Wr32(gpu, SIReg.CP_MEQ_THRESHOLDS, 24624)                        // 0x6030

        // SX_DEBUG_1: read-modify-write (kernel just reads and writes back)
        sx_dbg = GPU_Rd32(gpu, SIReg.SX_DEBUG_1)
        GPU_Wr32(gpu, SIReg.SX_DEBUG_1, sx_dbg)

        // SPI_CONFIG_CNTL_1 = VTX_DONE_DELAY(4)
        GPU_Wr32(gpu, SIReg.SPI_CONFIG_CNTL_1, 4)

        // PA_SC_FIFO_SIZE — Verde values:
        //   frontend=0x20, backend=0x40, hiz=0x30, earlyz=0x130
        //   = (0x20) | (0x40 << 6) | (0x30 << 15) | (0x130 << 23) = 0x98181020
        GPU_Wr32(gpu, SIReg.PA_SC_FIFO_SIZE, 2551713824)                     // 0x98181020

        GPU_Wr32(gpu, SIReg.VGT_NUM_INSTANCES, 1)
        GPU_Wr32(gpu, SIReg.CP_PERFMON_CNTL, 0)
        GPU_Wr32(gpu, SIReg.SQ_CONFIG, 0)

        // PA_SC_FORCE_EOV_MAX_CNTS = CLK_CNT(0xFFF) | REZ_CNT(0xFF)
        GPU_Wr32(gpu, SIReg.PA_SC_FORCE_EOV_MAX_CNTS, 16715775)              // 0x00FF0FFF

        // VGT_CACHE_INVALIDATION = CACHE_INVALIDATION(VC_AND_TC=2) | AUTO_INVLD_EN(ES_AND_GS_AUTO=3)
        GPU_Wr32(gpu, SIReg.VGT_CACHE_INVALIDATION, 194)                     // 0xC2

        GPU_Wr32(gpu, SIReg.VGT_GS_VERTEX_REUSE, 16)
        GPU_Wr32(gpu, SIReg.PA_SC_LINE_STIPPLE_STATE, 0)

        // Zero CB performance counters
        GPU_Wr32(gpu, SIReg.CB_PERFCOUNTER0_SELECT0, 0)
        GPU_Wr32(gpu, SIReg.CB_PERFCOUNTER0_SELECT1, 0)
        GPU_Wr32(gpu, SIReg.CB_PERFCOUNTER1_SELECT0, 0)
        GPU_Wr32(gpu, SIReg.CB_PERFCOUNTER1_SELECT1, 0)
        GPU_Wr32(gpu, SIReg.CB_PERFCOUNTER2_SELECT0, 0)
        GPU_Wr32(gpu, SIReg.CB_PERFCOUNTER2_SELECT1, 0)
        GPU_Wr32(gpu, SIReg.CB_PERFCOUNTER3_SELECT0, 0)
        GPU_Wr32(gpu, SIReg.CB_PERFCOUNTER3_SELECT1, 0)

        // PA_CL_ENHANCE = CLIP_VTX_REORDER_ENA | NUM_CLIP_SEQ(3)
        GPU_Wr32(gpu, SIReg.PA_CL_ENHANCE, 7)

        PrintMessage("[MC_SI] 3D engine defaults programmed\n")
        PrintMessage("[MC_SI] GPU engine init OK\n")
        ReturnValue(1)
    }
}
