// =============================================================================
// PM4_Destroy — free ring resources
// =============================================================================
Function.PM4_Destroy {
    Input: ring_idx: Integer
    Body: {
        ring = PM4_GetRing(ring_idx)
        IfCondition EqualTo(ring, 0) ThenBlock: { ReturnValue(0) }

        pkt_buf = Dereference(Add(ring, RingField.PKT_BUF))
        IfCondition NotEqual(pkt_buf, 0) ThenBlock: {
            Deallocate(pkt_buf, 1024)
            StoreValue(Add(ring, RingField.PKT_BUF), 0)
        }

        StoreValue(Add(ring, RingField.INITIALIZED), 0)
        // PrintMessage("[PM4] Ring ")
        // PrintNumber(ring_idx)
        // PrintMessage(" destroyed\n")
    }
}
