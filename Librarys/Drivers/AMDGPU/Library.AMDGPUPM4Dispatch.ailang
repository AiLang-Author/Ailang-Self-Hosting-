//
// Library.AMDGPUPM4Dispatch.ailang
//
// High-level compute dispatch, fencing, CP start, and ring utilities.
// Split from Library.AMDGPUPM4.ailang for maintainability.
//
// USAGE
//   LibraryImport.Drivers.AMDGPU.AMDGPUPM4Dispatch
//
// DEPENDS
//   LibraryImport.Drivers.AMDGPU.AMDGPUPM4Regs
//   LibraryImport.Drivers.AMDGPU.AMDGPUPM4Ring
//   LibraryImport.Drivers.AMDGPU.AMDGPUPM4FW
//   LibraryImport.Drivers.AMDGPU.AMDGPUPM4Pkt
//   LibraryImport.Drivers.AMDGPU.AMDGPUBAR
// =============================================================================
// HIGH-LEVEL COMPUTE DISPATCH
// =============================================================================

// Dispatch carrier — fill fields before calling PM4_SubmitCompute(ring_idx).
// Uses FixedPool instead of >6 function args (SystemV ABI limit = 6 registers).
FixedPool.PM4Dispatch {
    "pgm_addr":     Initialize=0, CanChange=True   // GPU address of shader (256-byte aligned)
    "num_vgprs":    Initialize=4, CanChange=True   // VGPRs used (actual count, granulated internally)
    "num_sgprs":    Initialize=8, CanChange=True   // SGPRs used (actual count, granulated internally)
    "tg_size_x":    Initialize=64, CanChange=True  // threads per group X
    "tg_size_y":    Initialize=1, CanChange=True   // threads per group Y
    "tg_size_z":    Initialize=1, CanChange=True   // threads per group Z
    "grid_x":       Initialize=1, CanChange=True   // number of thread groups X
    "grid_y":       Initialize=1, CanChange=True   // number of thread groups Y
    "grid_z":       Initialize=1, CanChange=True   // number of thread groups Z
    "buf_vram_off": Initialize=0, CanChange=True   // VRAM offset of combined data buffer
    "buf_total_size": Initialize=0, CanChange=True // total byte size of combined data buffer
    "ib_vram_off":  Initialize=0, CanChange=True   // VRAM offset of IB scratch area (legacy)
    "ib_host_ptr":  Initialize=0, CanChange=True   // host pointer to GART-backed IB page
    "ib_gart_va":   Initialize=0, CanChange=True   // GPU GART VA of IB page
}

// -----------------------------------------------------------------------------
// PM4_SubmitCompute — set up and dispatch a compute shader
//
// Reads dispatch parameters from FixedPool.PM4Dispatch.
// Caller must fill PM4Dispatch fields before calling.
//
// Returns 1 on success, 0 on failure.
// -----------------------------------------------------------------------------
Function.PM4_SubmitCompute {
    Input: ring_idx: Integer
    Output: Integer
    Body: {
        ring = PM4_GetRing(ring_idx)
        IfCondition EqualTo(ring, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Dereference(Add(ring, RingField.INITIALIZED)), 0) ThenBlock: {
            PrintMessage("[PM4] Ring not initialized\n")
            ReturnValue(0)
        }

        // Read dispatch parameters from carrier
        pgm_addr       = PM4Dispatch.pgm_addr
        num_vgprs      = PM4Dispatch.num_vgprs
        num_sgprs      = PM4Dispatch.num_sgprs
        tg_size_x      = PM4Dispatch.tg_size_x
        tg_size_y      = PM4Dispatch.tg_size_y
        tg_size_z      = PM4Dispatch.tg_size_z
        grid_x         = PM4Dispatch.grid_x
        grid_y         = PM4Dispatch.grid_y
        grid_z         = PM4Dispatch.grid_z
        buf_vram_off   = PM4Dispatch.buf_vram_off
        buf_total_size = PM4Dispatch.buf_total_size
        ib_vram_off    = PM4Dispatch.ib_vram_off
        ib_host_ptr    = PM4Dispatch.ib_host_ptr
        ib_gart_va     = PM4Dispatch.ib_gart_va

        // Calculate total packet DWORDs needed:
        //   SET_CONFIG_REG for CP_COHER_CNTL2 (3 DWORDs)
        //   SURFACE_SYNC for cache invalidation (5 DWORDs)
        //   SET_SH_REG for PGM_LO/HI (4 DWORDs)
        //   SET_SH_REG for PGM_RSRC1 (3 DWORDs)
        //   SET_SH_REG for PGM_RSRC2 (3 DWORDs)
        //   SET_SH_REG for RESOURCE_LIMITS (3 DWORDs)
        //   SET_SH_REG for NUM_THREAD_X (3 DWORDs)
        //   SET_SH_REG for NUM_THREAD_Y (3 DWORDs)
        //   SET_SH_REG for NUM_THREAD_Z (3 DWORDs)
        //   DISPATCH_DIRECT (4 DWORDs)
        //   EVENT_WRITE_EOP for fence (7 DWORDs)
        //   SET_CONFIG_REG + SURFACE_SYNC before fence (8 DWORDs)
        //   Total: ~78 DWORDs
        // Pre-read fence_off for breadcrumb WRITE_DATA packets
        bc_off = Dereference(Add(ring, RingField.FENCE_WB_OFF))

        needed = 145  // base + BC0-BC4 breadcrumbs + full SYNC + HDP flush (1×5) + double EOP fence

        IfCondition EqualTo(PM4_WaitForSpace(ring_idx, needed), 0) ThenBlock: {
            PrintMessage("[PM4] No ring space for compute dispatch\n")
            ReturnValue(0)
        }

        // CONTEXT_CONTROL is now emitted in PM4_CPStart (after CLEAR_STATE)

        // --- Packet offset instrumentation: log WPTR before each section ---
        wptr_start = Dereference(Add(ring, RingField.WPTR))
        PrintMessage("[PKT-MAP] ring=")
        PrintNumber(ring_idx)
        PrintMessage(" start_wptr=")
        PrintNumber(wptr_start)
        PrintMessage("\n")

        // --- Cache invalidation ---
        // Invalidate I$ + K$ only.  No TC/TCL1 — GLC=1 on all shader MUBUF
        // ops bypasses L2.  TC_ACTION_ENA livelocks after ~25 dispatches
        // when display CRTCs are active (scanout refills evicted L2 lines).
        // This SURFACE_SYNC also acts as PFP→ME barrier for SET_SH_REG.
        PM4_EmitSetConfigReg(ring_idx, PM4.CP_COHER_CNTL2, 0)
        coher = Add(PM4.SH_ICACHE_ACTION_ENA, PM4.SH_KCACHE_ACTION_ENA)
        PM4_EmitSurfaceSync(ring_idx, coher, 4294967295, 0, 10)
        PM4_EmitWriteDataVRAM(ring_idx, Add(bc_off, 20), 1)   // BC1: after I$/K$ sync
        PrintMessage("[PKT-MAP] after_cacheinval wptr=")
        PrintNumber(Dereference(Add(ring, RingField.WPTR)))
        PrintMessage("\n")

        // §29-6: commits + proves retirement of breadcrumb WRITE_DATA + cacheinval
        // (SET_CONFIG_REG + SURFACE_SYNC). Note: before §29 these packets were not
        // committed until the §27 commit below, so §28's pre-SET_SH CP_STAT sample
        // reflected CPStart-only ring content.
        PM4_ScratchProbe(ring_idx, 2835349510, 6)   // 0xA9000006: after cacheinval

        // --- §27 GFX-bank SET_SH split test (handoff §26.5) ---
        // Every packet class except SET_SH is proven consumed (NOP/config/context/
        // CLEAR_STATE); the ME wedges executing the first COMPUTE-bank SET_SH.
        // This emits one GFX-bank SET_SH (shader_type=0) first to split
        // compute-bank-dead vs all-SH-dead. SPI_SHADER_PGM_LO_PS is inert here —
        // no gfx work is ever launched.
        gpu27 = Dereference(Add(ring, RingField.GPU_INDEX))
        // §28: WaitIdle's idle=1 only proves RPTR==WPTR (fetch, not execution) —
        // 15:53 run showed RPTR pins at the END of the first SET_SH of either bank,
        // so idle=1 here was a false positive and the GFX SET_SH may itself be the
        // wedge packet. Sample CP_STAT BEFORE emitting anything else: 0x800001E3
        // here = ME wedged executing the GFX SET_SH (all-SH-dead proven); 0x0 =
        // GFX SET_SH genuinely executed and the wedge is downstream.
        PrintMessage("[§28] pre-SET_SH 0xB020 rb=0x")
        PrintHex(GPU_Rd32(gpu27, 45088))
        PrintMessage(" CP_STAT=0x")
        PrintHex(GPU_Rd32(gpu27, SIReg.CP_STAT))
        PrintMessage("\n")
        PM4_EmitSetSHReg(ring_idx, 45088, 1515870810, 0)  // 0xB020 = 0x5A5A5A5A, GFX bank
        PM4_Commit(ring_idx)
        gfx_sh_ok = PM4_WaitIdle(ring_idx)
        PrintMessage("[§27] GFX-bank SET_SH (PGM_LO_PS 0xB020): idle=")
        PrintNumber(gfx_sh_ok)
        PrintMessage(" RPTR=")
        PrintNumber(PM4_ReadRPTR_MMIO(ring_idx))
        PrintMessage(" WPTR=")
        PrintNumber(Dereference(Add(ring, RingField.WPTR)))
        PrintMessage(" mmio-rb=0x")
        PrintHex(GPU_Rd32(gpu27, 45088))
        PrintMessage("\n")
        PrintMessage("[§28] post-SET_SH CP_STAT=0x")
        PrintHex(GPU_Rd32(gpu27, SIReg.CP_STAT))
        PrintMessage(" CP_BUSY_STAT=0x")
        PrintHex(GPU_Rd32(gpu27, SIReg.CP_BUSY_STAT))
        PrintMessage(" GRBM_STATUS=0x")
        PrintHex(GPU_Rd32(gpu27, SIReg.GRBM_STATUS))
        PrintMessage(" rb2=0x")
        PrintHex(GPU_Rd32(gpu27, 45088))
        PrintMessage("\n")

        PM4_ScratchProbe(ring_idx, 2835349511, 7)   // 0xA9000007: after §27 GFX-bank SET_SH

        // --- Emit compute CLEAR_STATE just before the compute SET_SH_REGs ---
        // Per handoff doc §14 lead on ordering: the compute CS must be close to the
        // compute SET_SHs to make the compute context live so that the SET_SH_REGs
        // for compute land in the live pipe (instead of gfx context or nowhere).
        // The CS in CPStart is early; re-emit here for the dispatch to switch context
        // before setting the compute SH regs. This is the key to "get the pipe up"
        // in cold state so waves launch.
        IfCondition EqualTo(ring_idx, 0) ThenBlock: {
            cs_hdr = PM4_BuildHeader(PM4.OP_CLEAR_STATE, 1, PM4.SHADER_TYPE_COMPUTE)
            PM4_EmitDWord(ring_idx, cs_hdr)
            PM4_EmitDWord(ring_idx, 0)
            PrintMessage("[PKT-MAP] emitted compute CLEAR_STATE before SET_SHs wptr=")
            PrintNumber(Dereference(Add(ring, RingField.WPTR)))
            PrintMessage("\n")
        }

        // --- Build shader program address ---
        // PGM_LO = bits [31:0] of (addr >> 8)
        // PGM_HI = bits [39:32] of (addr >> 8)
        pgm_shifted = Divide(pgm_addr, 256)
        pgm_lo = BitwiseAnd(pgm_shifted, 4294967295)
        pgm_hi = Divide(pgm_shifted, 4294967296)

        PrintMessage("[DBG-SUBMIT] pgm_addr=0x")
        PrintHex(pgm_addr)
        PrintMessage(" shifted8=0x")
        PrintHex(pgm_shifted)
        PrintMessage(" PGM_LO=0x")
        PrintHex(pgm_lo)
        PrintMessage(" PGM_HI=0x")
        PrintHex(pgm_hi)
        PrintMessage("\n")
        // (SRBM_GFX_CNTL set removed for now -- previous attempts with 0x1/0x3 resulted in immediate readback=0 and CP_STALLED_STAT3=0xFFFFFFFF (bad read, stall).
        // The packet shader_type=compute should route the SET_SH to the right context on gfx ring.
        // If still not landing, the cold pipe bringup is the issue (missing SPI/compute MMIO in init).
        // Left the probe reads in ILR to monitor.
        gpu_probe = Dereference(Add(ring, RingField.GPU_INDEX))

        PM4_EmitSetSHRegPair(ring_idx, SICompute.PGM_LO, pgm_lo, pgm_hi, PM4.SHADER_TYPE_COMPUTE)

        // --- §14 INTERLEAVED READBACK: SRBM_GFX_CNTL + each reg after SET_SH_REG ---
        PrintMessage("[§14-ILR] SRBM_GFX_CNTL=0x")
        PrintHex(GPU_Rd32(gpu_probe, SIReg.SRBM_GFX_CNTL))
        PrintMessage(" CP_STALLED_STAT3=0x")
        PrintHex(GPU_Rd32(gpu_probe, SIReg.CP_STALLED_STAT3))
        PrintMessage("\n")
        // Commit + WaitIdle so CP consumes the PGM_LO/HI pair before MMIO readback
        PM4_Commit(ring_idx)
        PM4_WaitIdle(ring_idx)
        PrintMessage("[§14-ILR] PGM_LO  wrote=0x")
        PrintHex(pgm_lo)
        PrintMessage(" readback=0x")
        PrintHex(GPU_Rd32(gpu_probe, SICompute.PGM_LO))
        PrintMessage("\n")
        PrintMessage("[§14-ILR] PGM_HI  wrote=0x")
        PrintHex(pgm_hi)
        PrintMessage(" readback=0x")
        PrintHex(GPU_Rd32(gpu_probe, SICompute.PGM_HI))
        PrintMessage("\n")

        // --- Build PGM_RSRC1 ---
        // bits [5:0] = (num_vgprs / 4) - 1  (granularity 4 for GCN1)
        // bits [9:6] = (num_sgprs / 8) - 1  (granularity 8 for GCN1)
        // For simplicity: float_mode = 0 (default), no DX10 clamp, no IEEE
        vgpr_field = Subtract(Divide(num_vgprs, 4), 1)
        IfCondition LessThan(vgpr_field, 0) ThenBlock: { vgpr_field = 0 }
        sgpr_field = Subtract(Divide(num_sgprs, 8), 1)
        IfCondition LessThan(sgpr_field, 0) ThenBlock: { sgpr_field = 0 }

        rsrc1 = Add(vgpr_field, Multiply(sgpr_field, 64))   // sgpr at bits [9:6]
        PM4_EmitSetSHReg(ring_idx, SICompute.PGM_RSRC1, rsrc1, PM4.SHADER_TYPE_COMPUTE)
        PM4_Commit(ring_idx)
        PM4_WaitIdle(ring_idx)
        PrintMessage("[§14-ILR] RSRC1   wrote=0x")
        PrintHex(rsrc1)
        PrintMessage(" readback=0x")
        PrintHex(GPU_Rd32(gpu_probe, SICompute.PGM_RSRC1))
        PrintMessage("\n")

        // --- Build PGM_RSRC2 ---
        // bit 0:      SCRATCH_EN (0 = no scratch)
        // bits [5:1]:  USER_SGPR count (number of USER_DATA SGPRs)
        // bit 6:      TRAP_PRESENT (0 = no trap handler)
        // bit 7:      TGID_X_EN (1 = load thread group ID X into SGPR)
        // bit 8:      TGID_Y_EN
        // bit 9:      TGID_Z_EN
        // bit 10:     TG_SIZE_EN (1 = load total TG size into SGPR)
        // bits[12:11]: TIDIG_COMP_CNT (0 = X only, 1 = X+Y, 2 = X+Y+Z)
        // bits [17:12]: LDS_SIZE (in 256-byte units)
        rsrc2 = 0
        rsrc2 = Add(rsrc2, Multiply(4, 2))    // USER_SGPR = 4, at bits [5:1] (s[0:3] = V#)
        // bit 6 = TRAP_PRESENT — leave 0 (no trap handler)
        rsrc2 = Add(rsrc2, 128)                // TGID_X_EN (bit 7)
        PrintMessage("[DBG-SUBMIT] rsrc1=0x")
        PrintHex(rsrc1)
        PrintMessage(" rsrc2=0x")
        PrintHex(rsrc2)
        PrintMessage("\n")
        PM4_EmitSetSHReg(ring_idx, SICompute.PGM_RSRC2, rsrc2, PM4.SHADER_TYPE_COMPUTE)
        PM4_Commit(ring_idx)
        PM4_WaitIdle(ring_idx)
        PrintMessage("[§14-ILR] RSRC2   wrote=0x")
        PrintHex(rsrc2)
        PrintMessage(" readback=0x")
        PrintHex(GPU_Rd32(gpu_probe, SICompute.PGM_RSRC2))
        PrintMessage("\n")

        // --- COMPUTE_VMID — use VMID 0 (physical/system aperture addressing) ---
        PM4_EmitSetSHReg(ring_idx, SICompute.VMID, 0, PM4.SHADER_TYPE_COMPUTE)

        // --- RESOURCE_LIMITS (0xB854) ---
        // bit 0     = FORCE_SIMD_DIST (1 = force uniform wavefront distribution)
        // bits[5:1] = WAVES_PER_SH (0 = no limit; nonzero = max waves per SH)
        // Mesa sets FORCE_SIMD_DIST=1 to keep the SPI dispatch tracker from
        // over-allocating tracking slots. Without it, the HW dispatch FIFO
        // may leak entries after ~25 dispatches on the GFX ring.
        // Cape Verde: 10 CUs, 40 wave slots each = 400 total.
        // Set WAVES_PER_SH=2 (very conservative, 1 wave per SH × 2 SH) in bits[5:1]
        // plus FORCE_SIMD_DIST=1 at bit 0. Value = (2 << 1) | 1 = 5.
        // Actually, keep WAVES_PER_SH=0 (no limit) + FORCE_SIMD_DIST=1 → value = 1.
        PM4_EmitSetSHReg(ring_idx, SICompute.RESOURCE_LIMITS, 1, PM4.SHADER_TYPE_COMPUTE)

        // --- STATIC_THREAD_MGMT — enable all CUs for compute ---
        // 0xFFFFFFFF = all CU thread slots enabled on each shader engine
        // Without these, no CUs are assigned to compute and the wavefront hangs.
        PM4_EmitSetSHReg(ring_idx, SICompute.STATIC_THREAD_MGMT_SE0, 4294967295, PM4.SHADER_TYPE_COMPUTE)
        PM4_EmitSetSHReg(ring_idx, SICompute.STATIC_THREAD_MGMT_SE1, 4294967295, PM4.SHADER_TYPE_COMPUTE)

        // --- TMPRING_SIZE — scratch ring size (0 = no scratch) ---
        PM4_EmitSetSHReg(ring_idx, SICompute.TMPRING_SIZE, 0, PM4.SHADER_TYPE_COMPUTE)

        // --- COMPUTE_START_X/Y/Z — must be zeroed (work-group grid origin) ---
        PM4_EmitSetSHReg(ring_idx, SICompute.START_X, 0, PM4.SHADER_TYPE_COMPUTE)
        PM4_EmitSetSHReg(ring_idx, SICompute.START_Y, 0, PM4.SHADER_TYPE_COMPUTE)
        PM4_EmitSetSHReg(ring_idx, SICompute.START_Z, 0, PM4.SHADER_TYPE_COMPUTE)

        // --- Thread group dimensions ---
        PM4_EmitSetSHReg(ring_idx, SICompute.NUM_THREAD_X, tg_size_x, PM4.SHADER_TYPE_COMPUTE)
        PM4_EmitSetSHReg(ring_idx, SICompute.NUM_THREAD_Y, tg_size_y, PM4.SHADER_TYPE_COMPUTE)
        PM4_EmitSetSHReg(ring_idx, SICompute.NUM_THREAD_Z, tg_size_z, PM4.SHADER_TYPE_COMPUTE)

        // --- §14 INTERLEAVED READBACK: remaining regs (VMID→NUM_THREAD_Z) ---
        PM4_Commit(ring_idx)
        PM4_WaitIdle(ring_idx)
        PrintMessage("[§14-ILR] VMID    wrote=0x0 readback=0x")
        PrintHex(GPU_Rd32(gpu_probe, SICompute.VMID))
        PrintMessage("\n")
        PrintMessage("[§14-ILR] RES_LIM wrote=0x1 readback=0x")
        PrintHex(GPU_Rd32(gpu_probe, SICompute.RESOURCE_LIMITS))
        PrintMessage("\n")
        PrintMessage("[§14-ILR] TMGMT0  wrote=0xFFFFFFFF readback=0x")
        PrintHex(GPU_Rd32(gpu_probe, SICompute.STATIC_THREAD_MGMT_SE0))
        PrintMessage("\n")
        PrintMessage("[§14-ILR] TMGMT1  wrote=0xFFFFFFFF readback=0x")
        PrintHex(GPU_Rd32(gpu_probe, SICompute.STATIC_THREAD_MGMT_SE1))
        PrintMessage("\n")
        PrintMessage("[§14-ILR] TMPRING wrote=0x0 readback=0x")
        PrintHex(GPU_Rd32(gpu_probe, SICompute.TMPRING_SIZE))
        PrintMessage("\n")
        PrintMessage("[§14-ILR] START_X wrote=0x0 readback=0x")
        PrintHex(GPU_Rd32(gpu_probe, SICompute.START_X))
        PrintMessage("\n")
        PrintMessage("[§14-ILR] NUM_X   wrote=0x")
        PrintHex(tg_size_x)
        PrintMessage(" readback=0x")
        PrintHex(GPU_Rd32(gpu_probe, SICompute.NUM_THREAD_X))
        PrintMessage("\n")
        PrintMessage("[§14-ILR] NUM_Y   wrote=0x")
        PrintHex(tg_size_y)
        PrintMessage(" readback=0x")
        PrintHex(GPU_Rd32(gpu_probe, SICompute.NUM_THREAD_Y))
        PrintMessage("\n")
        PrintMessage("[§14-ILR] NUM_Z   wrote=0x")
        PrintHex(tg_size_z)
        PrintMessage(" readback=0x")
        PrintHex(GPU_Rd32(gpu_probe, SICompute.NUM_THREAD_Z))
        PrintMessage("\n")
        PrintMessage("[§14-ILR] === end interleaved readback ===\n")

        // FIX A3: DISPATCH_ID reset — REMOVED — confirmed no effect (BC7 fired, wall stayed at 25)

        PrintMessage("[PKT-MAP] after_SET_SH_REGs wptr=")
        PrintNumber(Dereference(Add(ring, RingField.WPTR)))
        PrintMessage("\n")

        PM4_ScratchProbe(ring_idx, 2835349512, 8)   // 0xA9000008: after compute SET_SH_REGs

        // --- PROBE: flush SET_SH_REGs and read back compute registers via MMIO ---
        // Commit + WaitIdle to ensure the CP has consumed all SET_SH_REG packets
        // before we read the registers back. Without this, MMIO reads may see
        // stale values from before the packets were processed.
        PM4_Commit(ring_idx)
        probe_idle = PM4_WaitIdle(ring_idx)
        gpu_probe = Dereference(Add(ring, RingField.GPU_INDEX))
        PrintMessage("[PROBE] SET_SH_REG consumed (idle=")
        PrintNumber(probe_idle)
        PrintMessage(") — MMIO readback:\n")
        PrintMessage("[PROBE] PGM_LO=0x")
        PrintHex(GPU_Rd32(gpu_probe, SICompute.PGM_LO))
        PrintMessage(" PGM_HI=0x")
        PrintHex(GPU_Rd32(gpu_probe, Add(SICompute.PGM_LO, 4)))
        PrintMessage(" RSRC1=0x")
        PrintHex(GPU_Rd32(gpu_probe, SICompute.PGM_RSRC1))
        PrintMessage(" RSRC2=0x")
        PrintHex(GPU_Rd32(gpu_probe, SICompute.PGM_RSRC2))
        PrintMessage("\n")
        PrintMessage("[PROBE] THREAD_MGMT_SE0=0x")
        PrintHex(GPU_Rd32(gpu_probe, SICompute.STATIC_THREAD_MGMT_SE0))
        PrintMessage(" SE1=0x")
        PrintHex(GPU_Rd32(gpu_probe, SICompute.STATIC_THREAD_MGMT_SE1))
        PrintMessage(" RESOURCE_LIMITS=0x")
        PrintHex(GPU_Rd32(gpu_probe, SICompute.RESOURCE_LIMITS))
        PrintMessage("\n")
        PrintMessage("[PROBE] NUM_THREAD_X=")
        PrintNumber(GPU_Rd32(gpu_probe, SICompute.NUM_THREAD_X))
        PrintMessage(" Y=")
        PrintNumber(GPU_Rd32(gpu_probe, SICompute.NUM_THREAD_Y))
        PrintMessage(" Z=")
        PrintNumber(GPU_Rd32(gpu_probe, SICompute.NUM_THREAD_Z))
        PrintMessage(" VMID=")
        PrintNumber(GPU_Rd32(gpu_probe, SICompute.VMID))
        PrintMessage("\n")
        PrintMessage("[PROBE] TMPRING=0x")
        PrintHex(GPU_Rd32(gpu_probe, SICompute.TMPRING_SIZE))
        PrintMessage(" DISPATCH_INITIATOR=0x")
        PrintHex(GPU_Rd32(gpu_probe, SICompute.DISPATCH_INITIATOR))
        PrintMessage(" START_X=")
        PrintNumber(GPU_Rd32(gpu_probe, SICompute.START_X))
        PrintMessage("\n")

        // --- Dispatch via Indirect Buffer (IB) ---
        // The kernel driver wraps DISPATCH_DIRECT inside an IB.
        // IB is now in GART-backed system RAM (coherent, no VRAM cold-boot issue).
        //
        // IB content (7 DWORDs, written to host memory via StoreValue):
        //   [0] DISPATCH_DIRECT header
        //   [1] grid_x
        //   [2] grid_y
        //   [3] grid_z
        //   [4] initiator (COMPUTE_SHADER_EN=1)
        //   [5] CS_PARTIAL_FLUSH header (EVENT_WRITE)
        //   [6] event_type=7 | event_index=4<<8 = 0x407

        // Build DISPATCH_DIRECT header: opcode=0x15, count=4, shader_type=compute
        ib_disp_hdr = PM4_BuildHeader(PM4.OP_DISPATCH_DIRECT, 4, PM4.SHADER_TYPE_COMPUTE)

        // Build CS_PARTIAL_FLUSH header: EVENT_WRITE, count=1, shader_type=0
        ib_flush_hdr = PM4_BuildHeader(PM4.OP_EVENT_WRITE, 1, 0)
        ib_flush_body = Add(7, Multiply(4, 256))   // event_type=7, event_index=4

        // Write 7 DWORDs to IB via GART host pointer (coherent system RAM)
        StoreValue(ib_host_ptr, ib_disp_hdr, "dword")
        StoreValue(Add(ib_host_ptr, 4), grid_x, "dword")
        StoreValue(Add(ib_host_ptr, 8), grid_y, "dword")
        StoreValue(Add(ib_host_ptr, 12), grid_z, "dword")
        StoreValue(Add(ib_host_ptr, 16), 1, "dword")
        StoreValue(Add(ib_host_ptr, 20), ib_flush_hdr, "dword")
        StoreValue(Add(ib_host_ptr, 24), ib_flush_body, "dword")

        // sfence to ensure all stores are visible before GPU fetches
        InlineAsm["0f ae f8"]

        // Debug: read back IB content to confirm writes landed (32-bit reads!)
        PrintMessage("[IB-GART] disp_hdr=0x")
        PrintHex(Dereference(ib_host_ptr, "dword"))
        PrintMessage(" grid=")
        PrintNumber(Dereference(Add(ib_host_ptr, 4), "dword"))
        PrintMessage(",")
        PrintNumber(Dereference(Add(ib_host_ptr, 8), "dword"))
        PrintMessage(",")
        PrintNumber(Dereference(Add(ib_host_ptr, 12), "dword"))
        PrintMessage(" initiator=0x")
        PrintHex(Dereference(Add(ib_host_ptr, 16), "dword"))
        PrintMessage(" flush_hdr=0x")
        PrintHex(Dereference(Add(ib_host_ptr, 20), "dword"))
        PrintMessage(" flush_body=0x")
        PrintHex(Dereference(Add(ib_host_ptr, 24), "dword"))
        PrintMessage("\n")

        // Emit INDIRECT_BUFFER on the ring pointing to IB in GART
        ib_addr_lo = BitwiseAnd(ib_gart_va, 4294967295)
        ib_addr_hi = BitwiseAnd(Divide(ib_gart_va, 4294967296), 255)
        ib_size_dw = 7   // DISPATCH_DIRECT(5) + CS_PARTIAL_FLUSH(2) = 7 DWORDs

        ib_hdr = PM4_BuildHeader(PM4.OP_INDIRECT_BUFFER, 3, 0)
        PM4_EmitDWord(ring_idx, ib_hdr)
        PM4_EmitDWord(ring_idx, ib_addr_lo)
        PM4_EmitDWord(ring_idx, ib_addr_hi)
        PM4_EmitDWord(ring_idx, ib_size_dw)   // VMID=0, size=7

        PM4_EmitWriteDataVRAM(ring_idx, Add(bc_off, 24), 2)   // BC2: after IB (dispatch+flush)
        PM4_EmitWriteDataVRAM(ring_idx, Add(bc_off, 28), 3)   // BC3: after IB return

        PrintMessage("[PKT-MAP] after_IB+BC wptr=")
        PrintNumber(Dereference(Add(ring, RingField.WPTR)))
        PrintMessage("\n")

        // --- WAVE-LAUNCH PROBE: commit IB, then poll SPI/SQ while dispatch runs ---
        // This catches whether a wavefront actually gets scheduled by the SPI.
        // We commit the ring (makes IB visible to CP) then immediately sample
        // wave-launch registers.  The fence hasn't been emitted yet, so the GPU
        // should be actively processing the DISPATCH_DIRECT inside the IB.
        PM4_Commit(ring_idx)
        // Small spin to let the dispatch propagate through CP → SPI
        wave_spin = 0
        WhileLoop LessThan(wave_spin, 500) {
            wave_spin = Add(wave_spin, 1)
        }
        wave_gpu = Dereference(Add(ring, RingField.GPU_INDEX))
        PrintMessage("\n[WAVE-PROBE] === Post-IB / Pre-fence wave-launch check ===\n")
        PrintMessage("[WAVE-PROBE] GRBM_STATUS=0x")
        PrintHex(GPU_Rd32(wave_gpu, SIReg.GRBM_STATUS))
        PrintMessage("\n")
        PrintMessage("[WAVE-PROBE] GRBM_STATUS2=0x")
        PrintHex(GPU_Rd32(wave_gpu, SIReg.GRBM_STATUS2))
        PrintMessage("\n")
        PrintMessage("[WAVE-PROBE] SPI_DEBUG_BUSY=0x")
        PrintHex(GPU_Rd32(wave_gpu, SIReg.SPI_DEBUG_BUSY))
        PrintMessage("\n")
        PrintMessage("[WAVE-PROBE] SQ_DEBUG_STS_GLOBAL=0x")
        PrintHex(GPU_Rd32(wave_gpu, SIReg.SQ_DEBUG_STS_GLOBAL))
        PrintMessage("\n")
        PrintMessage("[WAVE-PROBE] COMPUTE_DISPATCH_ID=0x")
        PrintHex(GPU_Rd32(wave_gpu, SIReg.COMPUTE_DISPATCH_ID))
        PrintMessage("\n")
        PrintMessage("[WAVE-PROBE] CP_BUSY_STAT=0x")
        PrintHex(GPU_Rd32(wave_gpu, SIReg.CP_BUSY_STAT))
        PrintMessage("\n")
        PrintMessage("[WAVE-PROBE] CP_STAT=0x")
        PrintHex(GPU_Rd32(wave_gpu, SIReg.CP_STAT))
        PrintMessage("\n")
        // SH_MEM — the critical question: is it still 0?
        PrintMessage("[WAVE-PROBE] SH_MEM_CONFIG=0x")
        PrintHex(GPU_Rd32(wave_gpu, SIReg.SH_MEM_CONFIG))
        PrintMessage(" SH_MEM_BASES=0x")
        PrintHex(GPU_Rd32(wave_gpu, SIReg.SH_MEM_BASES))
        PrintMessage("\n")
        // SRBM_GFX_CNTL — which VMID context is targeted for SH_MEM reads?
        PrintMessage("[WAVE-PROBE] SRBM_GFX_CNTL=0x")
        PrintHex(GPU_Rd32(wave_gpu, SIReg.SRBM_GFX_CNTL))
        PrintMessage("\n")
        // Compute regs via MMIO (may be shadowed, but worth checking during dispatch)
        PrintMessage("[WAVE-PROBE] DISPATCH_INITIATOR=0x")
        PrintHex(GPU_Rd32(wave_gpu, SICompute.DISPATCH_INITIATOR))
        PrintMessage(" PGM_LO=0x")
        PrintHex(GPU_Rd32(wave_gpu, SICompute.PGM_LO))
        PrintMessage(" PGM_HI=0x")
        PrintHex(GPU_Rd32(wave_gpu, SICompute.PGM_HI))
        PrintMessage("\n")
        PrintMessage("[WAVE-PROBE] RSRC1=0x")
        PrintHex(GPU_Rd32(wave_gpu, SICompute.PGM_RSRC1))
        PrintMessage(" RSRC2=0x")
        PrintHex(GPU_Rd32(wave_gpu, SICompute.PGM_RSRC2))
        PrintMessage(" RESOURCE_LIMITS=0x")
        PrintHex(GPU_Rd32(wave_gpu, SICompute.RESOURCE_LIMITS))
        PrintMessage("\n")
        PrintMessage("[WAVE-PROBE] STATIC_THREAD_MGMT_SE0=0x")
        PrintHex(GPU_Rd32(wave_gpu, SICompute.STATIC_THREAD_MGMT_SE0))
        PrintMessage(" SE1=0x")
        PrintHex(GPU_Rd32(wave_gpu, SICompute.STATIC_THREAD_MGMT_SE1))
        PrintMessage("\n")
        PrintMessage("[WAVE-PROBE] NUM_THREAD_X=")
        PrintNumber(GPU_Rd32(wave_gpu, SICompute.NUM_THREAD_X))
        PrintMessage(" Y=")
        PrintNumber(GPU_Rd32(wave_gpu, SICompute.NUM_THREAD_Y))
        PrintMessage(" Z=")
        PrintNumber(GPU_Rd32(wave_gpu, SICompute.NUM_THREAD_Z))
        PrintMessage("\n")
        // VM fault check during dispatch
        PrintMessage("[WAVE-PROBE] VM_FAULT_STATUS=0x")
        PrintHex(GPU_Rd32(wave_gpu, SIReg.VM_CONTEXT1_PROTECTION_FAULT_STATUS))
        PrintMessage(" VM_FAULT_ADDR=0x")
        PrintHex(GPU_Rd32(wave_gpu, SIReg.VM_CONTEXT1_PROTECTION_FAULT_ADDR))
        PrintMessage("\n")
        // Second sample after more time (wave may have already completed)
        wave_spin2 = 0
        WhileLoop LessThan(wave_spin2, 5000) {
            wave_spin2 = Add(wave_spin2, 1)
        }
        PrintMessage("[WAVE-PROBE] (2nd sample) SPI_DEBUG_BUSY=0x")
        PrintHex(GPU_Rd32(wave_gpu, SIReg.SPI_DEBUG_BUSY))
        PrintMessage(" SQ_DEBUG_STS_GLOBAL=0x")
        PrintHex(GPU_Rd32(wave_gpu, SIReg.SQ_DEBUG_STS_GLOBAL))
        PrintMessage(" GRBM_STATUS=0x")
        PrintHex(GPU_Rd32(wave_gpu, SIReg.GRBM_STATUS))
        PrintMessage("\n")
        PrintMessage("[WAVE-PROBE] === end ===\n\n")

        // --- Fence (based on kernel si_fence_ring_emit + Mesa eop_bug) ---
        // 1. SET_CONFIG_REG(CP_COHER_CNTL2, 0)   — select VMID 0 for coherence
        // 2. SURFACE_SYNC(ALL caches, FULL range) — flush everything
        // 3. Double EVENT_WRITE_EOP (dummy to scratch, then real fence)
        gpu = Dereference(Add(ring, RingField.GPU_INDEX))
        fence_val = Add(Dereference(Add(ring, RingField.FENCE_VAL)), 1)
        StoreValue(Add(ring, RingField.FENCE_VAL), fence_val)
        fence_off = Dereference(Add(ring, RingField.FENCE_WB_OFF))

        // Clear fence location before submit
        GPU_VramWr32(gpu, fence_off, 0)

        // Step 1: CP_COHER_CNTL2 = 0 (VMID 0)
        PM4_EmitSetConfigReg(ring_idx, PM4.CP_COHER_CNTL2, 0)

        // Step 2: SURFACE_SYNC — full range, ALL cache flags
        coher_all = Add(PM4.TCL1_ACTION_ENA, Add(PM4.TC_ACTION_ENA, Add(PM4.SH_KCACHE_ACTION_ENA, PM4.SH_ICACHE_ACTION_ENA)))
        PM4_EmitSurfaceSync(ring_idx, coher_all, 4294967295, 0, 10)
        PM4_EmitWriteDataVRAM(ring_idx, Add(bc_off, 32), 4)   // BC4: after full SURFACE_SYNC

        // HDP invalidation REMOVED — all HDP register writes (CPU or GPU-side)
        // crash the RD990 PCI fabric.  Keep only the write-cache flush at 0x5480
        // which is in a different register block and has never caused a crash.
        PM4_EmitWriteDataReg(ring_idx, SIReg.HDP_MEM_COHERENCY_FLUSH_CNTL, 1)

        // Step 3: Double EVENT_WRITE_EOP workaround (Mesa eop_bug pattern)
        // "Two EOP events are required to make all engines go idle (and
        //  optional cache flushes executed) before the timestamp is written."
        // First EOP: dummy write to scratch VRAM (fence_off + 8), value=0
        // Second EOP: real fence write with actual value
        // Mesa applies this to CIK/VI/GFX9 but SI (Cape Verde) appears to
        // need it too — without it, the event engine silently drops the
        // fence write after ~36 dispatches.
        fence_gpu = PM4_VramToGPU(fence_off)
        fence_addr_lo = BitwiseAnd(fence_gpu, 4294967295)
        fence_addr_hi = Divide(fence_gpu, 4294967296)

        // Dummy EOP target: fence_off + 8 (unused space between fence and breadcrumbs)
        scratch_gpu = PM4_VramToGPU(Add(fence_off, 8))
        scratch_addr_lo = BitwiseAnd(scratch_gpu, 4294967295)
        scratch_addr_hi = Divide(scratch_gpu, 4294967296)

        // Dummy EOP — flushes event engine pipeline, writes 0 to scratch
        PM4_EmitEventWriteEOP(ring_idx, scratch_addr_lo, scratch_addr_hi, 0)

        // Real EOP — writes fence_val after dummy completes
        PM4_EmitEventWriteEOP(ring_idx, fence_addr_lo, fence_addr_hi, fence_val)

        PrintMessage("[PKT-MAP] after_fence wptr=")
        PrintNumber(Dereference(Add(ring, RingField.WPTR)))
        PrintMessage(" (total_dw=")
        PrintNumber(Subtract(Dereference(Add(ring, RingField.WPTR)), wptr_start))
        PrintMessage(")\n")

        // --- Commit: bump WPTR hardware register ---
        PM4_Commit(ring_idx)
        ReturnValue(1)
    }
}

// =============================================================================
// PM4_WaitFence — wait for fence value in SCRATCH_REG0 (MMIO poll)
// The GPU writes fence_val to SCRATCH_REG0 via SET_CONFIG_REG after
// CS_PARTIAL_FLUSH guarantees all wavefronts have retired.
// =============================================================================
Function.PM4_WaitFence {
    Input: ring_idx: Integer
    Input: expected: Integer
    Output: Integer
    Body: {
        ring = PM4_GetRing(ring_idx)
        IfCondition EqualTo(ring, 0) ThenBlock: { ReturnValue(0) }

        gpu = Dereference(Add(ring, RingField.GPU_INDEX))

        attempts = 0
        max = 50000000

        WhileLoop LessThan(attempts, max) {
            val = GPU_Rd32(gpu, SIReg.SCRATCH_REG0)
            IfCondition GreaterEqual(val, expected) ThenBlock: {
                ReturnValue(1)
            }
            attempts = Add(attempts, 1)
        }

        PrintMessage("[PM4] Fence timeout: expected=")
        PrintNumber(expected)
        PrintMessage(" got=")
        PrintNumber(GPU_Rd32(gpu, SIReg.SCRATCH_REG0))
        PrintMessage("\n")
        // Print final diagnostic
        PrintMessage("[DBG:FENCE] final RPTR(mmio)=")
        PrintNumber(PM4_ReadRPTR_MMIO(ring_idx))
        PrintMessage(" GRBM_STATUS=0x")
        PrintHex(GPU_Rd32(gpu, SIReg.GRBM_STATUS))
        PrintMessage("\n")
        ReturnValue(0)
    }
}

// =============================================================================
// PM4_WaitFenceVRAM — wait for fence value in VRAM (authoritative path)
// Polls FENCE_WB_OFF via GPU_VramRd32 — same observable path as RPTR writeback.
// Prints all four signals (VRAMfence, SCRATCH_REG0, RPTR_wb, RPTR_mmio) for
// A/B comparison on every progress tick.
// =============================================================================
Function.PM4_WaitFenceVRAM {
    Input: ring_idx: Integer
    Input: expected: Integer
    Output: Integer
    Body: {
        ring = PM4_GetRing(ring_idx)
        IfCondition EqualTo(ring, 0) ThenBlock: { ReturnValue(0) }
        gpu = Dereference(Add(ring, RingField.GPU_INDEX))
        fence_off = Dereference(Add(ring, RingField.FENCE_WB_OFF))

        attempts = 0
        max = 20000000
        WhileLoop LessThan(attempts, max) {
            val = GPU_VramRd32(gpu, fence_off)
            IfCondition GreaterEqual(val, expected) ThenBlock: {
                ReturnValue(1)
            }
            attempts = Add(attempts, 1)
        }
        PrintMessage("[DBG:FENCE] VRAM fence TIMEOUT last=")
        PrintNumber(GPU_VramRd32(gpu, fence_off))
        PrintMessage(" RPTR(wb)=")
        PrintNumber(PM4_ReadRPTR(ring_idx))
        PrintMessage("\n")
        PrintMessage("  BC0(entry)=")
        PrintNumber(GPU_VramRd32(gpu, Add(fence_off, 16)))
        PrintMessage(" BC1(I$/K$)=")
        PrintNumber(GPU_VramRd32(gpu, Add(fence_off, 20)))
        PrintMessage(" BC2(DISP)=")
        PrintNumber(GPU_VramRd32(gpu, Add(fence_off, 24)))
        PrintMessage(" BC3(CSFLUSH)=")
        PrintNumber(GPU_VramRd32(gpu, Add(fence_off, 28)))
        PrintMessage(" BC4(TC)=")
        PrintNumber(GPU_VramRd32(gpu, Add(fence_off, 32)))
        PrintMessage("\n")

        // --- VRAM CANARY at timeout ---
        canary_base2 = 67444992    // 0x4052100
        PrintMessage("  dst[0..3]=0x")
        PrintHex(GPU_VramRd32(gpu, canary_base2))
        PrintMessage(" 0x")
        PrintHex(GPU_VramRd32(gpu, Add(canary_base2, 4)))
        PrintMessage(" 0x")
        PrintHex(GPU_VramRd32(gpu, Add(canary_base2, 8)))
        PrintMessage(" 0x")
        PrintHex(GPU_VramRd32(gpu, Add(canary_base2, 12)))
        PrintMessage("\n")

        // =============================================================
        // GPU HANG DUMP — read hardware state while wedged
        // =============================================================
        PrintMessage("\n=== GPU HANG DUMP (fence expected=")
        PrintNumber(expected)
        PrintMessage(") ===\n")

        // --- GRBM status (may be 0 if GRBM routing dead) ---
        PrintMessage("GRBM_STATUS     = 0x")
        PrintHex(GPU_Rd32(gpu, SIReg.GRBM_STATUS))
        PrintMessage("\n")
        PrintMessage("GRBM_STATUS2    = 0x")
        PrintHex(GPU_Rd32(gpu, SIReg.GRBM_STATUS2))
        PrintMessage("\n")
        PrintMessage("GRBM_STATUS_SE1 = 0x")
        PrintHex(GPU_Rd32(gpu, SIReg.GRBM_STATUS_SE1))
        PrintMessage("\n")

        // --- SRBM status (NOT routed through GRBM — should work) ---
        PrintMessage("SRBM_STATUS     = 0x")
        PrintHex(GPU_Rd32(gpu, SIReg.SRBM_STATUS))
        PrintMessage("\n")
        PrintMessage("SRBM_STATUS2    = 0x")
        PrintHex(GPU_Rd32(gpu, SIReg.SRBM_STATUS2))
        PrintMessage("\n")

        // --- CP stall diagnostics (THE GOLDMINE) ---
        PrintMessage("CP_STALLED_STAT1= 0x")
        PrintHex(GPU_Rd32(gpu, SIReg.CP_STALLED_STAT1))
        PrintMessage("\n")
        PrintMessage("CP_STALLED_STAT2= 0x")
        PrintHex(GPU_Rd32(gpu, SIReg.CP_STALLED_STAT2))
        PrintMessage("\n")
        PrintMessage("CP_STALLED_STAT3= 0x")
        PrintHex(GPU_Rd32(gpu, SIReg.CP_STALLED_STAT3))
        PrintMessage("\n")

        // --- CP busy/stat ---
        PrintMessage("CP_BUSY_STAT    = 0x")
        PrintHex(GPU_Rd32(gpu, SIReg.CP_BUSY_STAT))
        PrintMessage("\n")
        PrintMessage("CP_STAT         = 0x")
        PrintHex(GPU_Rd32(gpu, SIReg.CP_STAT))
        PrintMessage("\n")

        // --- CP control and ring pointers (hardware read) ---
        PrintMessage("CP_ME_CNTL      = 0x")
        PrintHex(GPU_Rd32(gpu, SIReg.CP_ME_CNTL))
        PrintMessage("\n")
        PrintMessage("CP_RB0_RPTR(hw) = 0x")
        PrintHex(GPU_Rd32(gpu, SIReg.CP_RB0_RPTR))
        PrintMessage("\n")
        PrintMessage("CP_RB1_RPTR(hw) = 0x")
        PrintHex(GPU_Rd32(gpu, SIReg.CP_RB1_RPTR))
        PrintMessage("\n")
        PrintMessage("CP_RB2_RPTR(hw) = 0x")
        PrintHex(GPU_Rd32(gpu, SIReg.CP_RB2_RPTR))
        PrintMessage("\n")

        // --- CP interrupt/error ---
        PrintMessage("CP_INT_STAT_R0  = 0x")
        PrintHex(GPU_Rd32(gpu, SIReg.CP_INT_STATUS_RING0))
        PrintMessage("\n")
        PrintMessage("CP_DEBUG        = 0x")
        PrintHex(GPU_Rd32(gpu, SIReg.CP_DEBUG))
        PrintMessage("\n")

        // --- SPI / SQ (shader dispatch state) ---
        PrintMessage("SPI_DEBUG_BUSY  = 0x")
        PrintHex(GPU_Rd32(gpu, SIReg.SPI_DEBUG_BUSY))
        PrintMessage("\n")
        PrintMessage("SQ_DEBUG_STS_GL = 0x")
        PrintHex(GPU_Rd32(gpu, SIReg.SQ_DEBUG_STS_GLOBAL))
        PrintMessage("\n")
        PrintMessage("SPI_CONFIG_CNTL = 0x")
        PrintHex(GPU_Rd32(gpu, SIReg.SPI_CONFIG_CNTL))
        PrintMessage("\n")

        // --- Compute tracking ---
        PrintMessage("COMP_DISPATCH_ID= 0x")
        PrintHex(GPU_Rd32(gpu, SIReg.COMPUTE_DISPATCH_ID))
        PrintMessage("\n")

        // --- GRBM index (what SE/SH is targeted) ---
        PrintMessage("GRBM_GFX_INDEX  = 0x")
        PrintHex(GPU_Rd32(gpu, SIReg.GRBM_GFX_INDEX))
        PrintMessage("\n")

        // --- GRBM_SOFT_RESET / SRBM_SOFT_RESET (should be 0 = deasserted) ---
        PrintMessage("GRBM_SOFT_RESET = 0x")
        PrintHex(GPU_Rd32(gpu, SIReg.GRBM_SOFT_RESET))
        PrintMessage("\n")
        PrintMessage("SRBM_SOFT_RESET = 0x")
        PrintHex(GPU_Rd32(gpu, SIReg.SRBM_SOFT_RESET))
        PrintMessage("\n")

        PrintMessage("=== END HANG DUMP ===\n\n")
        ReturnValue(0)
    }
}

// =============================================================================
// PM4_RingTest — basic ring test: submit a NOP and verify GPU consumes it
// Returns 1 if the ring is working.
// =============================================================================
// =============================================================================
// PM4_ScratchProbe — §29 through-ring ME-execution probe (kernel ring_test,
// bus2_all.txt seqs 439967-439972: MMIO scratch=CAFEDEAD, ring SET_CONFIG_REG
// scratch=DEADBEEF, poll — kernel's ME lands it within 3 polls).
// RPTR==WPTR only proves FETCH (§28); this is direct proof of ME retirement.
// Placed as breadcrumbs through the stream, the first probe that does NOT
// land fingers the wedge packet class exactly. Returns 1 if marker landed.
// =============================================================================
Function.PM4_ScratchProbe {
    Input: ring_idx: Integer
    Input: marker: Integer
    Input: tag: Integer
    Output: Integer
    Body: {
        ring = PM4_GetRing(ring_idx)
        IfCondition EqualTo(ring, 0) ThenBlock: { ReturnValue(0) }
        gpu = Dereference(Add(ring, RingField.GPU_INDEX))

        GPU_Wr32(gpu, SIReg.SCRATCH_REG0, 3405700781)   // 0xCAFEDEAD preset
        IfCondition EqualTo(PM4_WaitForSpace(ring_idx, 4), 0) ThenBlock: {
            PrintMessage("[§29] scratch probe: no ring space\n")
            ReturnValue(0)
        }
        PM4_EmitSetConfigReg(ring_idx, SIReg.SCRATCH_REG0, marker)
        PM4_Commit(ring_idx)

        landed = 0
        polls_used = 0
        sc = 0
        polls = 0
        WhileLoop LessThan(polls, 200000) {
            sc = GPU_Rd32(gpu, SIReg.SCRATCH_REG0)
            IfCondition EqualTo(sc, marker) ThenBlock: {
                landed = 1
                polls_used = polls
                polls = 200000
            }
            polls = Add(polls, 1)
        }
        PrintMessage("[§29-")
        PrintNumber(tag)
        PrintMessage("] scratch: landed=")
        PrintNumber(landed)
        PrintMessage(" rb=0x")
        PrintHex(sc)
        PrintMessage(" polls=")
        PrintNumber(polls_used)
        PrintMessage(" CP_STAT=0x")
        PrintHex(GPU_Rd32(gpu, SIReg.CP_STAT))
        PrintMessage(" RPTR=")
        PrintNumber(PM4_ReadRPTR_MMIO(ring_idx))
        PrintMessage(" WPTR=")
        PrintNumber(Dereference(Add(ring, RingField.WPTR)))
        PrintMessage("\n")
        ReturnValue(landed)
    }
}

Function.PM4_RingTest {
    Input: ring_idx: Integer
    Output: Integer
    Body: {
        ring = PM4_GetRing(ring_idx)
        IfCondition EqualTo(ring, 0) ThenBlock: { ReturnValue(0) }

        // PrintMessage("[PM4] Ring test: submitting NOP... ")

        // Wait for 8 DWORDs of space
        IfCondition EqualTo(PM4_WaitForSpace(ring_idx, 8), 0) ThenBlock: {
            PrintMessage("no space!\n")
            ReturnValue(0)
        }

        // Emit a NOP packet (2 DWORDs)
        PM4_EmitNOP(ring_idx, 2)

        // Commit WPTR
        PM4_Commit(ring_idx)

        // Wait for GPU to consume
        IfCondition EqualTo(PM4_WaitIdle(ring_idx), 1) ThenBlock: {
            // PrintMessage("OK\n")
            ReturnValue(1)
        }

        PrintMessage("TIMEOUT\n")
        ReturnValue(0)
    }
}

// =============================================================================
// PM4_CPStart — initialize CP micro-engine and clear compute context
//
// Sequence adjusted to better match kernel mmiotrace phase 16 (ring setup already done
// in PM4_SetupRing; here: unhalt early, emit ME_INIT+SET_BASE to ring, commit WPTR bump,
// wait, then the GFX+compute CLEAR_STATE + CONTEXT_CONTROL + brackets).
// Removed prior duplicate ME_INIT/SET_BASE (pre + post unhalt) that was left from reorder edit.
//
// Must be called AFTER PM4_SetupRing and before compute dispatch.
// =============================================================================
Function.PM4_CPStart {
    Input: gpu: Integer
    Input: ring_idx: Integer
    Output: Integer
    Body: {
        // CPStart: kernel order (gfx_v6_0_cp_gfx_start + bus2 trace seqs 439962-439964):
        // ME_INIT + SET_BASE are committed to the ring — including the MMIO WPTR
        // write — while the CP is still HALTED, and only then CP_ME_CNTL=0.
        // (Trace: WR CP_RB0_WPTR=0x100 at seq 439962, WR CP_ME_CNTL=0 at 439964.)
        // The earlier "unhalt first" reading of the trace was wrong.
        // The ring setup (PM4_SetupRing) has already done BASE/CNTL/RPTR_ADDR.
        IfCondition EqualTo(PM4_WaitForSpace(ring_idx, 16), 0) ThenBlock: {
            PrintMessage("[PM4] CPStart: no ring space\n")
            ReturnValue(0)
        }
        hdr_me = PM4_BuildHeader(PM4.OP_ME_INITIALIZE, 6, 0)
        PM4_EmitDWord(ring_idx, hdr_me)
        PM4_EmitDWord(ring_idx, 1)
        PM4_EmitDWord(ring_idx, 0)
        PM4_EmitDWord(ring_idx, 7)
        PM4_EmitDWord(ring_idx, 65536)
        PM4_EmitDWord(ring_idx, 0)
        PM4_EmitDWord(ring_idx, 0)

        // SET_BASE for CE
        hdr_sb = PM4_BuildHeader(PM4.OP_SET_BASE, 3, 0)
        PM4_EmitDWord(ring_idx, hdr_sb)
        PM4_EmitDWord(ring_idx, 3)
        PM4_EmitDWord(ring_idx, 49152)
        PM4_EmitDWord(ring_idx, 57344)

        // Commit WPTR while still halted (packets sit in ring)
        PM4_Commit(ring_idx)

        // ---- Unhalt: CP fetches the pending ME_INIT immediately ----
        PM4_UnhaltCP(gpu)

        // udelay(50)-ish settle after unhalt (kernel cp_gfx_enable)
        di = 0
        WhileLoop LessThan(di, 2000) {
            scratch = GPU_Rd32(gpu, SIReg.GRBM_STATUS)
            di = Add(di, 1)
        }

        // Wait for CP to consume ME_INITIALIZE
        IfCondition EqualTo(PM4_WaitIdle(ring_idx), 0) ThenBlock: {
            PrintMessage("[PM4] CPStart: ME_INITIALIZE not consumed\n")
            ReturnValue(0)
        }

        // §29-1: first-ever direct ME-execution proof, right where the kernel
        // runs its ring test (trace 439967-439972, immediately post-unhalt).
        PM4_ScratchProbe(ring_idx, 2835349505, 1)   // 0xA9000001: after ME_INIT+SET_BASE

        // ---- Phase 2: CLEAR_STATE on ring 0 ----
        // (rest unchanged, CS after the ME_INIT consumption, as before)

        // --- §14 CLEAR_STATE BRACKET: read compute regs BEFORE ---
        PrintMessage("[§14-CS] === BEFORE CLEAR_STATE ===\n")
        PrintMessage("[§14-CS] PGM_LO=0x")
        PrintHex(GPU_Rd32(gpu, SICompute.PGM_LO))
        PrintMessage(" RSRC1=0x")
        PrintHex(GPU_Rd32(gpu, SICompute.PGM_RSRC1))
        PrintMessage(" RSRC2=0x")
        PrintHex(GPU_Rd32(gpu, SICompute.PGM_RSRC2))
        PrintMessage("\n")
        PrintMessage("[§14-CS] TMGMT0=0x")
        PrintHex(GPU_Rd32(gpu, SICompute.STATIC_THREAD_MGMT_SE0))
        PrintMessage(" TMGMT1=0x")
        PrintHex(GPU_Rd32(gpu, SICompute.STATIC_THREAD_MGMT_SE1))
        PrintMessage(" RES_LIM=0x")
        PrintHex(GPU_Rd32(gpu, SICompute.RESOURCE_LIMITS))
        PrintMessage("\n")
        PrintMessage("[§14-CS] NUM_X=0x")
        PrintHex(GPU_Rd32(gpu, SICompute.NUM_THREAD_X))
        PrintMessage(" DISPATCH_INIT=0x")
        PrintHex(GPU_Rd32(gpu, SICompute.DISPATCH_INITIATOR))
        PrintMessage(" SH_MEM_CONFIG=0x")
        PrintHex(GPU_Rd32(gpu, SIReg.SH_MEM_CONFIG))
        PrintMessage("\n")
        PrintMessage("[§14-CS] SRBM_GFX_CNTL=0x")
        PrintHex(GPU_Rd32(gpu, SIReg.SRBM_GFX_CNTL))
        PrintMessage("\n")

        // --- PREAMBLE + CLEAR_STATE (matches kernel si_cp_start) ---
        IfCondition NotEqual(PM4_WaitForSpace(0, 16), 0) ThenBlock: {
            pre_begin = PM4_BuildHeader(PM4.OP_PREAMBLE_CNTL, 1, 0)
            PM4_EmitDWord(0, pre_begin)
            PM4_EmitDWord(0, PM4.PREAMBLE_BEGIN_CLEAR_STATE)

            pre_end = PM4_BuildHeader(PM4.OP_PREAMBLE_CNTL, 1, 0)
            PM4_EmitDWord(0, pre_end)
            PM4_EmitDWord(0, PM4.PREAMBLE_END_CLEAR_STATE)

            gfx_hdr = PM4_BuildHeader(PM4.OP_CLEAR_STATE, 1, 0)
            PM4_EmitDWord(0, gfx_hdr)
            PM4_EmitDWord(0, 0)

            vgt_hdr = PM4_BuildHeader(PM4.OP_SET_CONTEXT_REG, 3, 0)
            PM4_EmitDWord(0, vgt_hdr)
            PM4_EmitDWord(0, 790)
            PM4_EmitDWord(0, 14)
            PM4_EmitDWord(0, 16)

            PM4_Commit(0)
        }
        preamble_ok = PM4_WaitIdle(0)
        PrintMessage("[PM4] Preamble + GFX CLEAR_STATE + VGT dealloc: idle=")
        PrintNumber(preamble_ok)
        PrintMessage(" CP_STALLED_STAT3=0x")
        PrintHex(GPU_Rd32(gpu, SIReg.CP_STALLED_STAT3))
        PrintMessage("\n")

        PM4_ScratchProbe(0, 2835349506, 2)   // 0xA9000002: after preamble+GFX CS+VGT dealloc

        // --- §14: read between GFX and Compute CLEAR_STATE ---
        PrintMessage("[§14-CS] === AFTER GFX CLEAR_STATE, BEFORE Compute CLEAR_STATE ===\n")
        PrintMessage("[§14-CS] PGM_LO=0x")
        PrintHex(GPU_Rd32(gpu, SICompute.PGM_LO))
        PrintMessage(" RSRC1=0x")
        PrintHex(GPU_Rd32(gpu, SICompute.PGM_RSRC1))
        PrintMessage(" TMGMT0=0x")
        PrintHex(GPU_Rd32(gpu, SICompute.STATIC_THREAD_MGMT_SE0))
        PrintMessage(" NUM_X=0x")
        PrintHex(GPU_Rd32(gpu, SICompute.NUM_THREAD_X))
        PrintMessage("\n")

        // Compute CLEAR_STATE (SHADER_TYPE=compute) on ring 0
        IfCondition NotEqual(PM4_WaitForSpace(0, 4), 0) ThenBlock: {
            cs_hdr = PM4_BuildHeader(PM4.OP_CLEAR_STATE, 1, PM4.SHADER_TYPE_COMPUTE)
            PM4_EmitDWord(0, cs_hdr)
            PM4_EmitDWord(0, 0)
            PM4_Commit(0)
        }
        PM4_WaitIdle(0)

        PM4_ScratchProbe(0, 2835349507, 3)   // 0xA9000003: after compute CLEAR_STATE

        // ---- Phase 3: CONTEXT_CONTROL ----
        IfCondition NotEqual(PM4_WaitForSpace(0, 4), 0) ThenBlock: {
            cc_hdr = PM4_BuildHeader(PM4.OP_CONTEXT_CONTROL, 2, 0)
            PM4_EmitDWord(0, cc_hdr)
            PM4_EmitDWord(0, 2147483648)
            PM4_EmitDWord(0, 2147483648)
            PM4_Commit(0)
        }
        PM4_WaitIdle(0)

        PM4_ScratchProbe(0, 2835349508, 4)   // 0xA9000004: after CONTEXT_CONTROL (CPStart end)

        // --- §14 CLEAR_STATE BRACKET: read compute regs AFTER ---
        PrintMessage("[§14-CS] === AFTER BOTH CLEAR_STATEs ===\n")
        PrintMessage("[§14-CS] PGM_LO=0x")
        PrintHex(GPU_Rd32(gpu, SICompute.PGM_LO))
        PrintMessage(" RSRC1=0x")
        PrintHex(GPU_Rd32(gpu, SICompute.PGM_RSRC1))
        PrintMessage(" RSRC2=0x")
        PrintHex(GPU_Rd32(gpu, SICompute.PGM_RSRC2))
        PrintMessage("\n")
        PrintMessage("[§14-CS] TMGMT0=0x")
        PrintHex(GPU_Rd32(gpu, SICompute.STATIC_THREAD_MGMT_SE0))
        PrintMessage(" TMGMT1=0x")
        PrintHex(GPU_Rd32(gpu, SICompute.STATIC_THREAD_MGMT_SE1))
        PrintMessage(" RES_LIM=0x")
        PrintHex(GPU_Rd32(gpu, SICompute.RESOURCE_LIMITS))
        PrintMessage("\n")
        PrintMessage("[§14-CS] NUM_X=0x")
        PrintHex(GPU_Rd32(gpu, SICompute.NUM_THREAD_X))
        PrintMessage(" DISPATCH_INIT=0x")
        PrintHex(GPU_Rd32(gpu, SICompute.DISPATCH_INITIATOR))
        PrintMessage(" SH_MEM_CONFIG=0x")
        PrintHex(GPU_Rd32(gpu, SIReg.SH_MEM_CONFIG))
        PrintMessage("\n")

        ReturnValue(1)
    }
}

// =============================================================================
// PM4_PrintStatus — print ring buffer status
// =============================================================================
Function.PM4_PrintStatus {
    Input: ring_idx: Integer
    Body: {
        ring = PM4_GetRing(ring_idx)
        IfCondition EqualTo(ring, 0) ThenBlock: { ReturnValue(0) }

        gpu = Dereference(Add(ring, RingField.GPU_INDEX))
        rid = Dereference(Add(ring, RingField.RING_ID))

        // PrintMessage("Ring ")
        // PrintNumber(rid)
        // PrintMessage(" [GPU ")
        // PrintNumber(gpu)
