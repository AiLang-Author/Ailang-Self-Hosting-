//
// Library.AMDGPUPM4FW.ailang
//
// CP/RLC firmware loading, IH ring setup, and soft reset.
// Split from Library.AMDGPUPM4.ailang for maintainability.
//
// USAGE
//   LibraryImport.Drivers.AMDGPU.AMDGPUPM4FW
//
// DEPENDS
//   LibraryImport.Arena
//   LibraryImport.Drivers.AMDGPU.AMDGPUPM4Regs
//   LibraryImport.Drivers.AMDGPU.AMDGPUPM4Ring
//   LibraryImport.Drivers.AMDGPU.AMDGPUBAR
// =============================================================================
// CP FIRMWARE PATHS (Southern Islands / Cape Verde)
// The old-format radeon firmware files are arrays of big-endian 32-bit words.
// PFP = Pre-Fetch Parser, ME = Micro Engine, CE = Constant Engine.
// All three must be loaded while CP is halted, before ring setup.
// =============================================================================
// 2026-07-01: the /lib/firmware files (Nov 2025 linux-firmware) are a NEWER
// build than what the proven-working kernel boot uploaded — bus2_all.txt
// records different words for all four images (RLC 1930/2048 words differ,
// ME 1436/2144, CE 1443/2144, PFP 411/2144; the working boot loaded from an
// older initramfs bundle). fw_trace/*.bin are extracted verbatim from the
// bus2_all.txt upload streams: ME/PFP/CE as raw big-endian (old radeon
// format), RLC wrapped in a minimal new-format header (LE words @ 256).
// Regenerate with fw_trace/extract_trace_fw.py if bus2_all.txt changes.
FixedPool.CPFWPaths {
    "pfp":    Initialize="/home/bob/Ailang-Self-Hosting-/fw_trace/TRACE_VERDE_pfp.bin"
    "me":     Initialize="/home/bob/Ailang-Self-Hosting-/fw_trace/TRACE_VERDE_me.bin"
    "ce":     Initialize="/home/bob/Ailang-Self-Hosting-/fw_trace/TRACE_VERDE_ce.bin"
    "rlc":    Initialize="/home/bob/Ailang-Self-Hosting-/fw_trace/TRACE_verde_rlc.bin"
}

// =============================================================================
// PM4_LoadUcodeFile — load one CP microcode firmware file into an engine
//
// Opens the firmware .bin file, reads it into a buffer, byte-swaps each
// 32-bit word from big-endian to native (little-endian x86), and streams
// to the engine's data register via MMIO.
//
// This mirrors the Linux kernel's si_cp_load_microcode() which does
// be32_to_cpup() on each firmware word before WREG32 to the data register.
//
// gpu:       GPU index
// addr_reg:  engine address register (e.g. SIReg.CP_PFP_UCODE_ADDR)
// data_reg:  engine data register (e.g. SIReg.CP_PFP_UCODE_DATA)
// fw_path:   address of firmware file path string
//
// Returns word count on success, negative on error.
// =============================================================================
Function.PM4_LoadUcodeFile {
    Input: gpu: Integer
    Input: addr_reg: Integer
    Input: data_reg: Integer
    Input: fw_path: Integer
    Output: Integer
    Body: {
        // Open firmware file (syscall 2 = open, O_RDONLY = 0)
        ufw_fd = SystemCall(2, fw_path, 0, 0)
        IfCondition LessThan(ufw_fd, 0) ThenBlock: {
            PrintMessage("[PM4] cannot open firmware file\n")
            ReturnValue(-1)
        }

        // Get file size: lseek(fd, 0, SEEK_END) then lseek(fd, 0, SEEK_SET)
        ufw_size = SystemCall(8, ufw_fd, 0, 2)
        SystemCall(8, ufw_fd, 0, 0)

        IfCondition LessThan(ufw_size, 4) ThenBlock: {
            PrintMessage("[PM4] firmware file too small\n")
            SystemCall(3, ufw_fd)
            ReturnValue(-2)
        }

        // Allocate buffer and read entire file
        ufw_buf = Allocate(ufw_size)
        IfCondition EqualTo(ufw_buf, 0) ThenBlock: {
            PrintMessage("[PM4] firmware alloc failed\n")
            SystemCall(3, ufw_fd)
            ReturnValue(-3)
        }

        ufw_read = SystemCall(0, ufw_fd, ufw_buf, ufw_size)
        SystemCall(3, ufw_fd)

        IfCondition NotEqual(ufw_read, ufw_size) ThenBlock: {
            PrintMessage("[PM4] firmware read incomplete: got ")
            PrintNumber(ufw_read)
            PrintMessage(" expected ")
            PrintNumber(ufw_size)
            PrintMessage("\n")
            Deallocate(ufw_buf, ufw_size)
            ReturnValue(-4)
        }

        // Reset engine address counter to 0
        GPU_Wr32(gpu, addr_reg, 0)

        // Stream firmware words — big-endian to little-endian byte swap
        // Big-endian layout: byte[0]=MSB, byte[1], byte[2], byte[3]=LSB
        // Reconstruct native value: (b0 << 24) | (b1 << 16) | (b2 << 8) | b3
        ufw_words = Divide(ufw_size, 4)
        ufw_i = 0
        ufw_last = 0
        WhileLoop LessThan(ufw_i, ufw_words) {
            ufw_off = Multiply(ufw_i, 4)
            ufw_b0 = GetByte(ufw_buf, ufw_off)
            ufw_b1 = GetByte(ufw_buf, Add(ufw_off, 1))
            ufw_b2 = GetByte(ufw_buf, Add(ufw_off, 2))
            ufw_b3 = GetByte(ufw_buf, Add(ufw_off, 3))
            ufw_word = Add(LeftShift(ufw_b0, 24), Add(LeftShift(ufw_b1, 16), Add(LeftShift(ufw_b2, 8), ufw_b3)))
            GPU_Wr32(gpu, data_reg, ufw_word)
            ufw_last = ufw_word
            ufw_i = Add(ufw_i, 1)
        }
        // §24 tell: image→port mapping check against kernel trace tails
        // (PFP@0xC154 tail 0x7, CE@0xC16C tail 0x2, ME@0xC160 tail 0xF0601)
        PrintMessage("[§24] ucode port ")
        PrintHex(data_reg)
        PrintMessage(" words=")
        PrintNumber(ufw_words)
        PrintMessage(" tail=")
        PrintHex(ufw_last)
        PrintMessage("\n")

        // Reset address counter back to 0 (kernel does this after each engine load)
        GPU_Wr32(gpu, addr_reg, 0)

        Deallocate(ufw_buf, ufw_size)
        ReturnValue(ufw_words)
    }
}

// =============================================================================
// PM4_LoadCPFirmware — load PFP, ME, and CE microcode for the Command Processor
//
// Must be called while CP is halted (after PM4_HaltCP, before PM4_UnhaltCP).
// Reads firmware from /lib/firmware/radeon/VERDE_{pfp,me,ce}.bin.
// These are the same firmware files the radeon/amdgpu kernel driver uses.
//
// Without firmware, the CP engines have no microcode and cannot parse PM4
// packets — the ring test NOP will hang forever waiting for RPTR to advance.
//
// Returns 0 on success, negative on error.
// =============================================================================
Function.PM4_LoadCPFirmware {
    Input: gpu: Integer
    Output: Integer
    Body: {
        //PrintMessage("[PM4] Loading CP firmware...\n")

        // Halt CP first (matches kernel gfx_v6_0_cp_gfx_enable(false))
        // CP_ME_CNTL = ME_HALT | PFP_HALT | CE_HALT
        GPU_Wr32(gpu, SIReg.CP_ME_CNTL, 352321536)  // 0x15000000
        GPU_Wr32(gpu, SIReg.SCRATCH_UMSK, 0)

        // Load order per kernel trace: PFP@433508, CE@435654, ME@437800
        // (§18's "ME first" was a port misread — 0xC154 is the PFP data port;
        // the same misread rotated the fw_trace/ image labels until §24.)
        // Load PFP (Pre-Fetch Parser) — FIRST per trace
        cpfw_rc = PM4_LoadUcodeFile(gpu, SIReg.CP_PFP_UCODE_ADDR, SIReg.CP_PFP_UCODE_DATA, CPFWPaths.pfp)
        IfCondition LessThan(cpfw_rc, 0) ThenBlock: {
            PrintMessage("[PM4] PFP firmware FAILED\n")
            ReturnValue(-1)
        }

        // Load CE (Constant Engine) — SECOND per trace
        cpfw_rc = PM4_LoadUcodeFile(gpu, SIReg.CP_CE_UCODE_ADDR, SIReg.CP_CE_UCODE_DATA, CPFWPaths.ce)
        IfCondition LessThan(cpfw_rc, 0) ThenBlock: {
            PrintMessage("[PM4] CE firmware FAILED\n")
            ReturnValue(-2)
        }

        // Load ME (Micro Engine) — THIRD per trace
        cpfw_rc = PM4_LoadUcodeFile(gpu, SIReg.CP_ME_RAM_WADDR, SIReg.CP_ME_RAM_DATA, CPFWPaths.me)
        IfCondition LessThan(cpfw_rc, 0) ThenBlock: {
            PrintMessage("[PM4] ME firmware FAILED\n")
            ReturnValue(-3)
        }

        // Addr register zeroing after all engines loaded
        // Matches mmiotrace seq 439944-439948 exactly:
        //   CE_UCODE_ADDR=0, ME_RAM_WADDR=0, PFP_UCODE_ADDR=0, CE_UCODE_ADDR=0, ME_RAM_RADDR=0
        // Note: LoadUcodeFile already zeros the addr reg at end of each load,
        // so CE_UCODE_ADDR=0 at 439944 is from the CE loader.
        // The remaining zeroes are the explicit cleanup:
        GPU_Wr32(gpu, SIReg.CP_ME_RAM_WADDR, 0)
        GPU_Wr32(gpu, SIReg.CP_PFP_UCODE_ADDR, 0)
        GPU_Wr32(gpu, SIReg.CP_CE_UCODE_ADDR, 0)
        GPU_Wr32(gpu, SIReg.CP_ME_RAM_RADDR, 0)

        ReturnValue(0)
    }
}

// =============================================================================
// PM4_LoadRLCFirmware — load RLC microcode and start the Run List Controller
//
// The RLC is required for compute dispatch tracking: without it, the ME's
// internal dispatch FIFO (~25 entries per ring) never drains, causing
// dispatch 26 to hang.  The RLC processes EOP interrupt signals and tells
// the ME to free FIFO entries.
//
// verde_rlc.bin uses the new firmware header format:
//   - Little-endian header (52 bytes)
//   - ucode_array_offset_bytes at header[24] = 256
//   - ucode_size_bytes at header[20] = 8192 (2048 DWORDs)
//   - Microcode is LITTLE-ENDIAN (no byte swap on x86)
//
// Mirrors si_rlc_load_microcode() + si_rlc_resume() from Linux si.c.
// =============================================================================
Function.PM4_LoadRLCFirmware {
    Input: gpu: Integer
    Output: Integer
    Body: {
        //PrintMessage("[PM4] Loading RLC firmware...\n")

        // --- Stop RLC first ---
        GPU_Wr32(gpu, SIReg.RLC_CNTL, 0)
        rlc_flush = GPU_Rd32(gpu, SIReg.RLC_CNTL)

        // --- Clock gating: LEAVE AT TRACE-GOLDEN STATE (§22) ---
        // The §18 "disable path" here (CGLS_CTRL &= ~3, MGCG_OVERRIDE |= 3,
        // CP_MEM_SLP bit0 clear, CGTS overrides, SERDES broadcast) copied the
        // working card's STEADY-STATE values — but bus2_all.txt shows the
        // working boot starts the RLC with the GOLDEN values still in place
        // (seq 3709 MGCG_OVERRIDE=0xFFFFFFFC, seq 3789 CGCG_CGLS_CTRL=0x0020003F,
        // seq 3786 CGTS=0x96940200, seq 3811 C1E4=0x00020201) and only moves to
        // the disable/steady values AFTER CP bringup (seqs 567039+/667061).
        // Between RLC_CNTL=0 (seq 329376) and the ucode upload the kernel
        // writes NO CG registers. Our golden phase already wrote the same
        // values the kernel golden did, so: touch nothing here.
        cg_ovr = GPU_Rd32(gpu, SIReg.RLC_CGTT_MGCG_OVERRIDE)
        cg_ctrl = GPU_Rd32(gpu, SIReg.RLC_CGCG_CGLS_CTRL)
        PrintMessage("[§22] CG left at golden: MGCG_OVR=0x")
        PrintHex(cg_ovr)
        PrintMessage(" CGLS_CTRL=0x")
        PrintHex(cg_ctrl)
        PrintMessage(" (expect 0xFFFFFFFC / 0x0020003F)\n")

        // --- Open firmware file ---
        rlc_fd = SystemCall(2, CPFWPaths.rlc, 0, 0)
        IfCondition LessThan(rlc_fd, 0) ThenBlock: {
            PrintMessage("[PM4] cannot open RLC firmware file\n")
            ReturnValue(-1)
        }

        // Get file size
        rlc_fsize = SystemCall(8, rlc_fd, 0, 2)
        SystemCall(8, rlc_fd, 0, 0)
        IfCondition LessThan(rlc_fsize, 260) ThenBlock: {
            PrintMessage("[PM4] RLC firmware too small\n")
            SystemCall(3, rlc_fd)
            ReturnValue(-2)
        }

        // Allocate and read
        rlc_buf = Allocate(rlc_fsize)
        IfCondition EqualTo(rlc_buf, 0) ThenBlock: {
            PrintMessage("[PM4] RLC firmware alloc failed\n")
            SystemCall(3, rlc_fd)
            ReturnValue(-3)
        }
        rlc_got = SystemCall(0, rlc_fd, rlc_buf, rlc_fsize)
        SystemCall(3, rlc_fd)
        IfCondition NotEqual(rlc_got, rlc_fsize) ThenBlock: {
            PrintMessage("[PM4] RLC firmware read incomplete\n")
            Deallocate(rlc_buf, rlc_fsize)
            ReturnValue(-4)
        }

        // --- Parse header: ucode starts at offset 256, size 8192 bytes ---
        // header[20] = ucode_size_bytes (LE32)
        // header[24] = ucode_array_offset_bytes (LE32)
        rlc_ucode_off_b0 = GetByte(rlc_buf, 24)
        rlc_ucode_off_b1 = GetByte(rlc_buf, 25)
        rlc_ucode_off_b2 = GetByte(rlc_buf, 26)
        rlc_ucode_off_b3 = GetByte(rlc_buf, 27)
        rlc_ucode_off = Add(rlc_ucode_off_b0, Add(LeftShift(rlc_ucode_off_b1, 8), Add(LeftShift(rlc_ucode_off_b2, 16), LeftShift(rlc_ucode_off_b3, 24))))

        rlc_usize_b0 = GetByte(rlc_buf, 20)
        rlc_usize_b1 = GetByte(rlc_buf, 21)
        rlc_usize_b2 = GetByte(rlc_buf, 22)
        rlc_usize_b3 = GetByte(rlc_buf, 23)
        rlc_ucode_size = Add(rlc_usize_b0, Add(LeftShift(rlc_usize_b1, 8), Add(LeftShift(rlc_usize_b2, 16), LeftShift(rlc_usize_b3, 24))))
        rlc_fw_dwords = Divide(rlc_ucode_size, 4)

        //PrintMessage("[PM4]   RLC: ucode_off=")
        //PrintNumber(rlc_ucode_off)
        //PrintMessage(" size=")
        //PrintNumber(rlc_ucode_size)
        //PrintMessage(" (")
        //PrintNumber(rlc_fw_dwords)
        //PrintMessage(" DWORDs)\n")

        // --- Program RLC registers ---
        // Both bases need valid GPU addresses (kernel sets both, not 0).
        // RLC_SR = save/restore register list, RLC_CS = clear state data.
        // §23: moved from VRAM (0x6034000/0x6038000 — CPU writes there are
        // unreliable on cold boot, so contents were garbage GPU-side) to GART
        // system-RAM pages populated by PM4_PopulateCSB via host pointers.
        // Reg value = full 40-bit GPU VA >> 8.
        GPU_Wr32(gpu, SIReg.RLC_SAVE_AND_RESTORE_BASE, 4097836576)   // 0xF4400620 = 0xF4_40062000 >> 8
        GPU_Wr32(gpu, SIReg.RLC_CLEAR_STATE_RESTORE_BASE, 4097836592) // 0xF4400630 = 0xF4_40063000 >> 8

        GPU_Wr32(gpu, SIReg.RLC_RL_BASE, 0)
        GPU_Wr32(gpu, SIReg.RLC_RL_SIZE, 0)

        // verde_golden_rlc_registers — kernel programs these before RLC start
        GPU_Wr32(gpu, 50212, 54464517)      // 0xC424 = 0x033F1005 (was 54329349=0x033D0005, FIXED2)
        GPU_Wr32(gpu, 50300, 276856864)     // 0xC47C = 0x10808020 (was 277348384=0x10880020, FIXED)
        GPU_Wr32(gpu, 50312, 8388616)       // 0xC488 = 0x00800008
        GPU_Wr32(gpu, SIReg.RLC_LB_CNTR_MAX, 4294967295)        // 0xC314 = 0xFFFFFFFF (rlc_resume override, was 4096=0x1000 golden, FIXED)
        GPU_Wr32(gpu, SIReg.RLC_LB_CNTL, 0)                     // 0xC30C = 0x00000000 (rlc_resume override, was 0x80010014 golden, FIXED)
        GPU_Wr32(gpu, SIReg.RLC_LB_CNTR_INIT, 0)
        GPU_Wr32(gpu, SIReg.RLC_LB_INIT_CU_MASK, 4294967295)  // 0xFFFFFFFF

        GPU_Wr32(gpu, SIReg.RLC_MC_CNTL, 0)
        GPU_Wr32(gpu, SIReg.RLC_UCODE_CNTL, 0)

        // --- Stream firmware to RLC SRAM ---
        // New-format: LITTLE-ENDIAN on x86, no byte swap needed.
        // Read 4 bytes as LE32 and write directly.
        // RLC_UCODE_ADDR does NOT autoincrement on SI: the kernel writes ADDR
        // before EVERY data word (gfx_v6_0_rlc_resume, confirmed in bus2 trace
        // seqs 329397-333493: 2048 alternating ADDR/DATA pairs). Writing ADDR
        // once and streaming DATA loads the whole firmware into word 0.
        rlc_i = 0
        WhileLoop LessThan(rlc_i, rlc_fw_dwords) {
            rlc_off = Add(rlc_ucode_off, Multiply(rlc_i, 4))
            rlc_b0 = GetByte(rlc_buf, rlc_off)
            rlc_b1 = GetByte(rlc_buf, Add(rlc_off, 1))
            rlc_b2 = GetByte(rlc_buf, Add(rlc_off, 2))
            rlc_b3 = GetByte(rlc_buf, Add(rlc_off, 3))
            rlc_word = Add(rlc_b0, Add(LeftShift(rlc_b1, 8), Add(LeftShift(rlc_b2, 16), LeftShift(rlc_b3, 24))))
            GPU_Wr32(gpu, SIReg.RLC_UCODE_ADDR, rlc_i)
            GPU_Wr32(gpu, SIReg.RLC_UCODE_DATA, rlc_word)
            rlc_i = Add(rlc_i, 1)
        }
        GPU_Wr32(gpu, SIReg.RLC_UCODE_ADDR, 0)

        // [§23-FWVER] Verify the ENTIRE image landed in RLC SRAM (replaces the
        // §21 4-word sample): write ADDR, read DATA back, compare against the
        // file buffer for all words. §21 only sampled words 0..2 + last.
        rlc_vbad = 0
        rlc_vfirst = -1
        rlc_vexp = 0
        rlc_vgot = 0
        rlc_v = 0
        WhileLoop LessThan(rlc_v, rlc_fw_dwords) {
            GPU_Wr32(gpu, SIReg.RLC_UCODE_ADDR, rlc_v)
            rlc_vrd = GPU_Rd32(gpu, SIReg.RLC_UCODE_DATA)
            rlc_voff = Add(rlc_ucode_off, Multiply(rlc_v, 4))
            rlc_vb0 = GetByte(rlc_buf, rlc_voff)
            rlc_vb1 = GetByte(rlc_buf, Add(rlc_voff, 1))
            rlc_vb2 = GetByte(rlc_buf, Add(rlc_voff, 2))
            rlc_vb3 = GetByte(rlc_buf, Add(rlc_voff, 3))
            rlc_vword = Add(rlc_vb0, Add(LeftShift(rlc_vb1, 8), Add(LeftShift(rlc_vb2, 16), LeftShift(rlc_vb3, 24))))
            IfCondition NotEqual(rlc_vrd, rlc_vword) ThenBlock: {
                rlc_vbad = Add(rlc_vbad, 1)
                IfCondition EqualTo(rlc_vfirst, -1) ThenBlock: {
                    rlc_vfirst = rlc_v
                    rlc_vexp = rlc_vword
                    rlc_vgot = rlc_vrd
                }
            }
            rlc_v = Add(rlc_v, 1)
        }
        GPU_Wr32(gpu, SIReg.RLC_UCODE_ADDR, 0)
        PrintMessage("[§23-FWVER] RLC SRAM verify: ")
        PrintNumber(rlc_vbad)
        PrintMessage(" mismatches of ")
        PrintNumber(rlc_fw_dwords)
        IfCondition NotEqual(rlc_vbad, 0) ThenBlock: {
            PrintMessage(" first at [")
            PrintNumber(rlc_vfirst)
            PrintMessage("] exp=0x")
            PrintHex(rlc_vexp)
            PrintMessage(" got=0x")
            PrintHex(rlc_vgot)
        }
        PrintMessage("\n")

        Deallocate(rlc_buf, rlc_fsize)

        // enable_lbpw: check if DDR3 (MC_SEQ_MISC0 bits[31:28] == 0xB)
        rlc_misc0 = GPU_Rd32(gpu, SIReg.MC_SEQ_MISC0)
        rlc_mem_type = BitwiseAnd(rlc_misc0, 4026531840)  // 0xF0000000
        IfCondition EqualTo(rlc_mem_type, 2952790016) ThenBlock: {  // 0xB0000000
            // DDR3: enable load balance
            rlc_lb = GPU_Rd32(gpu, SIReg.RLC_LB_CNTL)
            GPU_Wr32(gpu, SIReg.RLC_LB_CNTL, BitwiseOr(rlc_lb, 1))
        }
        IfCondition NotEqual(rlc_mem_type, 2952790016) ThenBlock: {
            // Not DDR3: disable load balance
            rlc_lb = GPU_Rd32(gpu, SIReg.RLC_LB_CNTL)
            GPU_Wr32(gpu, SIReg.RLC_LB_CNTL, BitwiseAnd(rlc_lb, 4294967294))  // ~1
        }

        // --- Pre-RLC writes (kernel si_rlc_resume / si_gpu_init tail) ---
        // GRBM_GFX_INDEX = 0xE0000000 → broadcast to all SE/SH/instances
        GPU_Wr32(gpu, SIReg.GRBM_GFX_INDEX, 3758096384)  // 0xE0000000

        // SPI_LB_CU_MASK = 0xFF → enable all CUs for load balancing
        GPU_Wr32(gpu, 37716, 255)                          // 0x9354 = 0xFF

        // PA_CL_ENHANCE = CLIP_VTX_REORDER_ENA | NUM_CLIP_SEQ(3) = 0x7
        GPU_Wr32(gpu, SIReg.PA_CL_ENHANCE, 7)             // 0x8A14 = 0x7

        // --- Start RLC ---
        // RLC_CNTL bit 0 = RLC_ENABLE
        GPU_Wr32(gpu, SIReg.RLC_CNTL, 1)
        rlc_rb = GPU_Rd32(gpu, SIReg.RLC_CNTL)

        // si_enable_gui_idle_interrupt pulse immediately after RLC start —
        // trace seqs 333500-333503: RD C1A8=0, WR C1A8=0x00180000
        // (CNTX_BUSY_INT_ENABLE|CNTX_EMPTY_INT_ENABLE), RD back, WR C1A8=0.
        rlc_gui = GPU_Rd32(gpu, 49576)     // 0xC1A8 CP_INT_CNTL_RING0
        GPU_Wr32(gpu, 49576, 1572864)      // 0x00180000
        rlc_gui = GPU_Rd32(gpu, 49576)
        GPU_Wr32(gpu, 49576, 0)

        // Wait for RLC firmware boot — kernel trace shows ~100k register reads
        // between RLC_CNTL=1 and CP FW load (Phase 14→15 gap). Do NOT halt the
        // RLC during this window; the firmware is initializing SERDES/SH hardware.
        // CG disable was already sent while RLC was halted (pre-load); the kernel
        // only does halt-SERDES-restart much later (Phase 19, post-DPM).
        rlc_boot = 0
        rlc_ready = 0
        WhileLoop LessThan(rlc_boot, 100000) {
            rlc_boot_rd = GPU_Rd32(gpu, SIReg.RLC_STAT)  // 0xC34C (§23: was literal 50000=0xC350, wrong reg)
            IfCondition NotEqual(rlc_boot_rd, 0) ThenBlock: {
                IfCondition EqualTo(rlc_ready, 0) ThenBlock: {
                    rlc_ready = 1
                    PrintMessage("[PM4] RLC_STAT went non-zero at iteration ")
                    PrintNumber(rlc_boot)
                    PrintMessage(": 0x")
                    PrintHex(rlc_boot_rd)
                    PrintMessage("\n")
                }
            }
            rlc_boot = Add(rlc_boot, 1)
        }

        rlc_stat = GPU_Rd32(gpu, SIReg.RLC_STAT)
        PrintMessage("[PM4] RLC started, RLC_STAT=0x")
        PrintHex(rlc_stat)
        IfCondition EqualTo(rlc_ready, 0) ThenBlock: {
            PrintMessage(" (never went non-zero during 100k poll)")
        }
        PrintMessage("\n")

        ReturnValue(0)
    }
}

// =============================================================================
// PM4_PopulateCSB — write RLC Clear State Block + save/restore list (GART, §23)
//
// Implements the equivalent of kernel si_get_csb_buffer() / sumo_rlc_init().
// The RLC's CLEAR_STATE_RESTORE_BASE register points to a VRAM region that
// must contain valid PM4 packets.  When the CP executes a CLEAR_STATE packet,
// the ME replays the CSB data to initialise context registers to safe defaults.
//
// Without this, CLEAR_STATE replays random (zero/garbage) VRAM → the ME's
// context register file has undefined state → compute dispatches can fail to
// launch because the ME/SPI is in an inconsistent state.
//
// CSB layout (908 DWORDs = 3632 bytes, fits in 16KB allocation):
//   PREAMBLE_CNTL(BEGIN) + CONTEXT_CONTROL(load,shadow)
//   7 × SET_CONTEXT_REG extents (si_SECT_CONTEXT_def_1..7)
//   SET_CONTEXT_REG(PA_SC_RASTER_CONFIG = 0x124A for Verde)
//   PREAMBLE_CNTL(END) + CLEAR_STATE(0)
//
// Must be called BEFORE PM4_LoadRLCFirmware (which starts the RLC).
// §23: CSB at GART VA 0xF4_40063000 (page GARTState.rlc_cs_host_ptr), with the
// kernel 256-byte descriptor header; SR list at GART VA 0xF4_40062000.
//
// Source data: drivers/gpu/drm/amd/amdgpu/clearstate_si.h (kernel 6.1)
// =============================================================================
Function.PM4_PopulateCSB {
    Input: gpu: Integer
    Output: Integer
    Body: {
        // §23: buffers moved from VRAM (0x6034000/0x6038000) to GART system-RAM
        // pages — CPU BAR0 writes to VRAM are unreliable on cold boot, so the
        // GPU-visible CSB was garbage. Written via host pointers (mmap'd, GART
        // PTE-mapped in GART_Init), read by RLC/CP through VM like the CP rings.
        csb_host = GARTState.rlc_cs_host_ptr
        IfCondition EqualTo(csb_host, 0) ThenBlock: {
            PrintMessage("[PM4] PopulateCSB: GART RLC pages not allocated!\n")
            ReturnValue(-1)
        }

        // --- Step 1: Zero the 4KB CSB page ---
        MemorySet(csb_host, 0, 4096)

        // --- Step 1b: 256-byte descriptor header (kernel gfx_v6_0_rlc_init):
        //   DW0 = upper 32 bits of (clear_state_gpu_addr + 256)
        //   DW1 = lower 32 bits of (clear_state_gpu_addr + 256)
        //   DW2 = clear_state_size in DWORDs
        //   CSB packet data starts at byte offset 256.
        // Without this header (pre-§23 code wrote packets at offset 0) the
        // consumer reads packet dwords as an address descriptor.
        StoreValue(csb_host, 244, "dword")                  // DW0: hi = 0xF4
        StoreValue(Add(csb_host, 4), 1074147584, "dword")   // DW1: lo = 0x40063100
        StoreValue(Add(csb_host, 8), 908, "dword")          // DW2: size
        csb_data = Add(csb_host, 256)

        // --- Step 2: Write non-zero CSB DWORDs ---
        // Pre-zeroed region means we only need to write non-zero values.
        // DWORD positions are absolute indices into the 908-DWORD CSB buffer.
        // Each DWORD N is at byte offset csb_data + N*4 (csb_data = page + 256).

        // ---- Preamble + Context Control (DWORDs 0-4) ----
        StoreValue(csb_data, 3221243392, "dword")                        // DW0: PREAMBLE_CNTL hdr 0xC0004A00
        StoreValue(Add(csb_data, 4), 536870912, "dword")                 // DW1: BEGIN_CLEAR_STATE 0x20000000
        StoreValue(Add(csb_data, 8), 3221301248, "dword")                // DW2: CONTEXT_CONTROL hdr 0xC0012800
        StoreValue(Add(csb_data, 12), 2147483648, "dword")               // DW3: 0x80000000
        StoreValue(Add(csb_data, 16), 2147483648, "dword")               // DW4: 0x80000000

        // ---- Extent 1: SET_CONTEXT_REG, 212 values @ 0xA000 (DWORDs 5-218) ----
        StoreValue(Add(csb_data, 20), 3234367744, "dword")               // DW5:  hdr 0xC0D46900
        // DW6 = reg_offset 0 (already zero)
        StoreValue(Add(csb_data, 80), 1073758208, "dword")               // DW20: PA_SC_SCREEN_SCISSOR_BR 0x40004000
        StoreValue(Add(csb_data, 544), 2147483648, "dword")              // DW136: PA_SC_WINDOW_SCISSOR_TL 0x80000000
        StoreValue(Add(csb_data, 548), 1073758208, "dword")              // DW137: PA_SC_WINDOW_SCISSOR_BR 0x40004000
        StoreValue(Add(csb_data, 552), 65535, "dword")                   // DW138: PA_SC_CLIPRECT_RULE 0x0000FFFF
        StoreValue(Add(csb_data, 560), 1073758208, "dword")              // DW140: PA_SC_CLIPRECT_0_BR 0x40004000
        StoreValue(Add(csb_data, 568), 1073758208, "dword")              // DW142: PA_SC_CLIPRECT_1_BR 0x40004000
        StoreValue(Add(csb_data, 576), 1073758208, "dword")              // DW144: PA_SC_CLIPRECT_2_BR 0x40004000
        StoreValue(Add(csb_data, 584), 1073758208, "dword")              // DW146: PA_SC_CLIPRECT_3_BR 0x40004000
        StoreValue(Add(csb_data, 588), 2862627498, "dword")              // DW147: PA_SC_EDGERULE 0xAA99AAAA
        StoreValue(Add(csb_data, 596), 4294967295, "dword")              // DW149: CB_TARGET_MASK 0xFFFFFFFF
        StoreValue(Add(csb_data, 600), 4294967295, "dword")              // DW150: CB_SHADER_MASK 0xFFFFFFFF
        StoreValue(Add(csb_data, 604), 2147483648, "dword")              // DW151: PA_SC_GENERIC_SCISSOR_TL 0x80000000
        StoreValue(Add(csb_data, 608), 1073758208, "dword")              // DW152: PA_SC_GENERIC_SCISSOR_BR 0x40004000
        // DW153-154 = COHER_DEST_BASE = 0 (already zero)
        // PA_SC_VPORT_SCISSOR 0..15: alternating TL=0x80000000, BR=0x40004000
        StoreValue(Add(csb_data, 620), 2147483648, "dword")              // DW155: VPORT_SCISSOR_0_TL
        StoreValue(Add(csb_data, 624), 1073758208, "dword")              // DW156: VPORT_SCISSOR_0_BR
        StoreValue(Add(csb_data, 628), 2147483648, "dword")              // DW157: VPORT_SCISSOR_1_TL
        StoreValue(Add(csb_data, 632), 1073758208, "dword")              // DW158: VPORT_SCISSOR_1_BR
        StoreValue(Add(csb_data, 636), 2147483648, "dword")              // DW159: VPORT_SCISSOR_2_TL
        StoreValue(Add(csb_data, 640), 1073758208, "dword")              // DW160: VPORT_SCISSOR_2_BR
        StoreValue(Add(csb_data, 644), 2147483648, "dword")              // DW161: VPORT_SCISSOR_3_TL
        StoreValue(Add(csb_data, 648), 1073758208, "dword")              // DW162: VPORT_SCISSOR_3_BR
        StoreValue(Add(csb_data, 652), 2147483648, "dword")              // DW163: VPORT_SCISSOR_4_TL
        StoreValue(Add(csb_data, 656), 1073758208, "dword")              // DW164: VPORT_SCISSOR_4_BR
        StoreValue(Add(csb_data, 660), 2147483648, "dword")              // DW165: VPORT_SCISSOR_5_TL
        StoreValue(Add(csb_data, 664), 1073758208, "dword")              // DW166: VPORT_SCISSOR_5_BR
        StoreValue(Add(csb_data, 668), 2147483648, "dword")              // DW167: VPORT_SCISSOR_6_TL
        StoreValue(Add(csb_data, 672), 1073758208, "dword")              // DW168: VPORT_SCISSOR_6_BR
        StoreValue(Add(csb_data, 676), 2147483648, "dword")              // DW169: VPORT_SCISSOR_7_TL
        StoreValue(Add(csb_data, 680), 1073758208, "dword")              // DW170: VPORT_SCISSOR_7_BR
        StoreValue(Add(csb_data, 684), 2147483648, "dword")              // DW171: VPORT_SCISSOR_8_TL
        StoreValue(Add(csb_data, 688), 1073758208, "dword")              // DW172: VPORT_SCISSOR_8_BR
        StoreValue(Add(csb_data, 692), 2147483648, "dword")              // DW173: VPORT_SCISSOR_9_TL
        StoreValue(Add(csb_data, 696), 1073758208, "dword")              // DW174: VPORT_SCISSOR_9_BR
        StoreValue(Add(csb_data, 700), 2147483648, "dword")              // DW175: VPORT_SCISSOR_10_TL
        StoreValue(Add(csb_data, 704), 1073758208, "dword")              // DW176: VPORT_SCISSOR_10_BR
        StoreValue(Add(csb_data, 708), 2147483648, "dword")              // DW177: VPORT_SCISSOR_11_TL
        StoreValue(Add(csb_data, 712), 1073758208, "dword")              // DW178: VPORT_SCISSOR_11_BR
        StoreValue(Add(csb_data, 716), 2147483648, "dword")              // DW179: VPORT_SCISSOR_12_TL
        StoreValue(Add(csb_data, 720), 1073758208, "dword")              // DW180: VPORT_SCISSOR_12_BR
        StoreValue(Add(csb_data, 724), 2147483648, "dword")              // DW181: VPORT_SCISSOR_13_TL
        StoreValue(Add(csb_data, 728), 1073758208, "dword")              // DW182: VPORT_SCISSOR_13_BR
        StoreValue(Add(csb_data, 732), 2147483648, "dword")              // DW183: VPORT_SCISSOR_14_TL
        StoreValue(Add(csb_data, 736), 1073758208, "dword")              // DW184: VPORT_SCISSOR_14_BR
        StoreValue(Add(csb_data, 740), 2147483648, "dword")              // DW185: VPORT_SCISSOR_15_TL
        StoreValue(Add(csb_data, 744), 1073758208, "dword")              // DW186: VPORT_SCISSOR_15_BR
        // PA_SC_VPORT_ZMIN/ZMAX 0..15: ZMIN=0 (already zero), ZMAX=0x3F800000
        StoreValue(Add(csb_data, 752), 1065353216, "dword")              // DW188: VPORT_ZMAX_0  0x3F800000
        StoreValue(Add(csb_data, 760), 1065353216, "dword")              // DW190: VPORT_ZMAX_1
        StoreValue(Add(csb_data, 768), 1065353216, "dword")              // DW192: VPORT_ZMAX_2
        StoreValue(Add(csb_data, 776), 1065353216, "dword")              // DW194: VPORT_ZMAX_3
        StoreValue(Add(csb_data, 784), 1065353216, "dword")              // DW196: VPORT_ZMAX_4
        StoreValue(Add(csb_data, 792), 1065353216, "dword")              // DW198: VPORT_ZMAX_5
        StoreValue(Add(csb_data, 800), 1065353216, "dword")              // DW200: VPORT_ZMAX_6
        StoreValue(Add(csb_data, 808), 1065353216, "dword")              // DW202: VPORT_ZMAX_7
        StoreValue(Add(csb_data, 816), 1065353216, "dword")              // DW204: VPORT_ZMAX_8
        StoreValue(Add(csb_data, 824), 1065353216, "dword")              // DW206: VPORT_ZMAX_9
        StoreValue(Add(csb_data, 832), 1065353216, "dword")              // DW208: VPORT_ZMAX_10
        StoreValue(Add(csb_data, 840), 1065353216, "dword")              // DW210: VPORT_ZMAX_11
        StoreValue(Add(csb_data, 848), 1065353216, "dword")              // DW212: VPORT_ZMAX_12
        StoreValue(Add(csb_data, 856), 1065353216, "dword")              // DW214: VPORT_ZMAX_13
        StoreValue(Add(csb_data, 864), 1065353216, "dword")              // DW216: VPORT_ZMAX_14
        StoreValue(Add(csb_data, 872), 1065353216, "dword")              // DW218: VPORT_ZMAX_15

        // ---- Extent 2: SET_CONTEXT_REG, 272 values @ 0xA0D8 (DWORDs 219-492) ----
        StoreValue(Add(csb_data, 876), 3238887680, "dword")              // DW219: hdr 0xC1106900
        StoreValue(Add(csb_data, 880), 216, "dword")                     // DW220: reg_offset 0xD8
        StoreValue(Add(csb_data, 1044), 4294967295, "dword")             // DW261: VGT_MAX_VTX_INDX 0xFFFFFFFF
        StoreValue(Add(csb_data, 1772), 2, "dword")                      // DW443: SPI_PS_IN_CONTROL 0x00000002

        // ---- Extent 3: SET_CONTEXT_REG, 6 values @ 0xA1F5 (DWORDs 493-500) ----
        StoreValue(Add(csb_data, 1972), 3221614848, "dword")             // DW493: hdr 0xC0066900
        StoreValue(Add(csb_data, 1976), 501, "dword")                    // DW494: reg_offset 0x1F5
        // All 6 values are zero (already zeroed)

        // ---- Extent 4: SET_CONTEXT_REG, 157 values @ 0xA200 (DWORDs 501-659) ----
        StoreValue(Add(csb_data, 2004), 3231693056, "dword")             // DW501: hdr 0xC09D6900
        StoreValue(Add(csb_data, 2008), 512, "dword")                    // DW502: reg_offset 0x200
        StoreValue(Add(csb_data, 2028), 589824, "dword")                 // DW507: PA_CL_CLIP_CNTL 0x00090000
        StoreValue(Add(csb_data, 2032), 4, "dword")                      // DW508: PA_SU_SC_MODE_CNTL 0x00000004
        StoreValue(Add(csb_data, 2608), 256, "dword")                    // DW652: VGT_GS_PER_ES 0x00000100
        StoreValue(Add(csb_data, 2612), 128, "dword")                    // DW653: VGT_ES_PER_GS 0x00000080
        StoreValue(Add(csb_data, 2616), 2, "dword")                      // DW654: VGT_GS_PER_VS 0x00000002

        // ---- Extent 5: SET_CONTEXT_REG, 1 value @ 0xA2A1 (DWORDs 660-662) ----
        StoreValue(Add(csb_data, 2640), 3221366016, "dword")             // DW660: hdr 0xC0016900
        StoreValue(Add(csb_data, 2644), 673, "dword")                    // DW661: reg_offset 0x2A1
        // DW662 = VGT_PRIMITIVEID_EN = 0 (already zero)

        // ---- Extent 6: SET_CONTEXT_REG, 1 value @ 0xA2A3 (DWORDs 663-665) ----
        StoreValue(Add(csb_data, 2652), 3221366016, "dword")             // DW663: hdr 0xC0016900
        StoreValue(Add(csb_data, 2656), 675, "dword")                    // DW664: reg_offset 0x2A3
        // DW665 = VGT_PRIMITIVEID_RESET = 0 (already zero)

        // ---- Extent 7: SET_CONTEXT_REG, 233 values @ 0xA2A5 (DWORDs 666-900) ----
        StoreValue(Add(csb_data, 2664), 3235743488, "dword")             // DW666: hdr 0xC0E96900
        StoreValue(Add(csb_data, 2668), 677, "dword")                    // DW667: reg_offset 0x2A5
        StoreValue(Add(csb_data, 2692), 255, "dword")                    // DW673: IA_MULTI_VGT_PARAM 0x000000FF
        StoreValue(Add(csb_data, 3000), 4096, "dword")                   // DW750: PA_SC_LINE_CNTL 0x00001000
        StoreValue(Add(csb_data, 3008), 5, "dword")                      // DW752: PA_SU_VTX_CNTL 0x00000005
        StoreValue(Add(csb_data, 3012), 1065353216, "dword")             // DW753: PA_CL_GB_VERT_CLIP_ADJ 0x3F800000
        StoreValue(Add(csb_data, 3016), 1065353216, "dword")             // DW754: PA_CL_GB_VERT_DISC_ADJ
        StoreValue(Add(csb_data, 3020), 1065353216, "dword")             // DW755: PA_CL_GB_HORZ_CLIP_ADJ
        StoreValue(Add(csb_data, 3024), 1065353216, "dword")             // DW756: PA_CL_GB_HORZ_DISC_ADJ
        StoreValue(Add(csb_data, 3092), 4294967295, "dword")             // DW773: PA_SC_AA_MASK_X0Y0 0xFFFFFFFF
        StoreValue(Add(csb_data, 3096), 4294967295, "dword")             // DW774: PA_SC_AA_MASK_X0Y1 0xFFFFFFFF
        StoreValue(Add(csb_data, 3124), 14, "dword")                     // DW781: VGT_VERTEX_REUSE_BLOCK_CNTL 0x0E
        StoreValue(Add(csb_data, 3128), 16, "dword")                     // DW782: VGT_OUT_DEALLOC_CNTL 0x10

        // ---- PA_SC_RASTER_CONFIG (DWORDs 901-903) ----
        StoreValue(Add(csb_data, 3604), 3221366016, "dword")             // DW901: hdr 0xC0016900
        StoreValue(Add(csb_data, 3608), 212, "dword")                    // DW902: reg_offset 0xD4 (PA_SC_RASTER_CONFIG - 0xA000)
        StoreValue(Add(csb_data, 3612), 4682, "dword")                   // DW903: 0x0000124A (Verde)

        // ---- Trailer (DWORDs 904-907) ----
        StoreValue(Add(csb_data, 3616), 3221243392, "dword")             // DW904: PREAMBLE_CNTL hdr 0xC0004A00
        StoreValue(Add(csb_data, 3620), 805306368, "dword")              // DW905: END_CLEAR_STATE 0x30000000
        StoreValue(Add(csb_data, 3624), 3221229056, "dword")             // DW906: CLEAR_STATE hdr 0xC0001200
        // DW907 = 0 (already zero)

        PrintMessage("[PM4] CSB populated: 256B descriptor + 908 DWORDs at GART VA 0xF4_40063000\n")

        // --- Populate RLC save/restore list (verde_rlc_save_restore_register_list,
        //     amdgpu gfx_v6_0.c, 218 DWORDs, copied verbatim per amdgpu_gfx_rlc_init_sr) ---
        sr_host = GARTState.rlc_sr_host_ptr
        StoreValue(Add(sr_host, 0), 2147493437, "dword")    // [0] 0x8000263D
        StoreValue(Add(sr_host, 4), 0, "dword")    // [1] 0x00000000
        StoreValue(Add(sr_host, 8), 2151687741, "dword")    // [2] 0x8040263D
        StoreValue(Add(sr_host, 12), 0, "dword")    // [3] 0x00000000
        StoreValue(Add(sr_host, 16), 2147484576, "dword")    // [4] 0x800003A0
        StoreValue(Add(sr_host, 20), 0, "dword")    // [5] 0x00000000
        StoreValue(Add(sr_host, 24), 2151678880, "dword")    // [6] 0x804003A0
        StoreValue(Add(sr_host, 28), 0, "dword")    // [7] 0x00000000
        StoreValue(Add(sr_host, 32), 2147492463, "dword")    // [8] 0x8000226F
        StoreValue(Add(sr_host, 36), 0, "dword")    // [9] 0x00000000
        StoreValue(Add(sr_host, 40), 2151686767, "dword")    // [10] 0x8040226F
        StoreValue(Add(sr_host, 44), 0, "dword")    // [11] 0x00000000
        StoreValue(Add(sr_host, 48), 2147492615, "dword")    // [12] 0x80002307
        StoreValue(Add(sr_host, 52), 0, "dword")    // [13] 0x00000000
        StoreValue(Add(sr_host, 56), 2151686919, "dword")    // [14] 0x80402307
        StoreValue(Add(sr_host, 60), 0, "dword")    // [15] 0x00000000
        StoreValue(Add(sr_host, 64), 2617255484, "dword")    // [16] 0x9C00263C
        StoreValue(Add(sr_host, 68), 0, "dword")    // [17] 0x00000000
        StoreValue(Add(sr_host, 72), 2617246623, "dword")    // [18] 0x9C00039F
        StoreValue(Add(sr_host, 76), 0, "dword")    // [19] 0x00000000
        StoreValue(Add(sr_host, 80), 2147492946, "dword")    // [20] 0x80002452
        StoreValue(Add(sr_host, 84), 0, "dword")    // [21] 0x00000000
        StoreValue(Add(sr_host, 88), 2151687250, "dword")    // [22] 0x80402452
        StoreValue(Add(sr_host, 92), 0, "dword")    // [23] 0x00000000
        StoreValue(Add(sr_host, 96), 2617254996, "dword")    // [24] 0x9C002454
        StoreValue(Add(sr_host, 100), 0, "dword")    // [25] 0x00000000
        StoreValue(Add(sr_host, 104), 2617254495, "dword")    // [26] 0x9C00225F
        StoreValue(Add(sr_host, 108), 0, "dword")    // [27] 0x00000000
        StoreValue(Add(sr_host, 112), 2617254755, "dword")    // [28] 0x9C002363
        StoreValue(Add(sr_host, 116), 0, "dword")    // [29] 0x00000000
        StoreValue(Add(sr_host, 120), 2617256725, "dword")    // [30] 0x9C002B15
        StoreValue(Add(sr_host, 124), 0, "dword")    // [31] 0x00000000
        StoreValue(Add(sr_host, 128), 3, "dword")    // [32] 0x00000003
        StoreValue(Add(sr_host, 132), 2617255486, "dword")    // [33] 0x9C00263E
        StoreValue(Add(sr_host, 136), 0, "dword")    // [34] 0x00000000
        StoreValue(Add(sr_host, 140), 2617255492, "dword")    // [35] 0x9C002644
        StoreValue(Add(sr_host, 144), 0, "dword")    // [36] 0x00000000
        StoreValue(Add(sr_host, 148), 2617255493, "dword")    // [37] 0x9C002645
        StoreValue(Add(sr_host, 152), 0, "dword")    // [38] 0x00000000
        StoreValue(Add(sr_host, 156), 2617255494, "dword")    // [39] 0x9C002646
        StoreValue(Add(sr_host, 160), 0, "dword")    // [40] 0x00000000
        StoreValue(Add(sr_host, 164), 2617255495, "dword")    // [41] 0x9C002647
        StoreValue(Add(sr_host, 168), 0, "dword")    // [42] 0x00000000
        StoreValue(Add(sr_host, 172), 2617255496, "dword")    // [43] 0x9C002648
        StoreValue(Add(sr_host, 176), 0, "dword")    // [44] 0x00000000
        StoreValue(Add(sr_host, 180), 2617255497, "dword")    // [45] 0x9C002649
        StoreValue(Add(sr_host, 184), 0, "dword")    // [46] 0x00000000
        StoreValue(Add(sr_host, 188), 2617255498, "dword")    // [47] 0x9C00264A
        StoreValue(Add(sr_host, 192), 0, "dword")    // [48] 0x00000000
