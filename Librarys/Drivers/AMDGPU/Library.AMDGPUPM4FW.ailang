//
// Library.AMDGPUPM4FW.ailang
//
// CP/RLC firmware loading, IH ring setup, and soft reset.
// Split from Library.AMDGPUPM4.ailang for maintainability.
//
// USAGE
//   LibraryImport.Drivers.AMDGPU.AMDGPUPM4FW
//
// DEPENDS
//   LibraryImport.Arena
//   LibraryImport.Drivers.AMDGPU.AMDGPUPM4Regs
//   LibraryImport.Drivers.AMDGPU.AMDGPUPM4Ring
//   LibraryImport.Drivers.AMDGPU.AMDGPUBAR
// =============================================================================
// CP FIRMWARE PATHS (Southern Islands / Cape Verde)
// The old-format radeon firmware files are arrays of big-endian 32-bit words.
// PFP = Pre-Fetch Parser, ME = Micro Engine, CE = Constant Engine.
// All three must be loaded while CP is halted, before ring setup.
// =============================================================================
FixedPool.CPFWPaths {
    "pfp":    Initialize="/lib/firmware/radeon/VERDE_pfp.bin"
    "me":     Initialize="/lib/firmware/radeon/VERDE_me.bin"
    "ce":     Initialize="/lib/firmware/radeon/VERDE_ce.bin"
    "rlc":    Initialize="/lib/firmware/radeon/verde_rlc.bin"
}

// =============================================================================
// PM4_LoadUcodeFile — load one CP microcode firmware file into an engine
//
// Opens the firmware .bin file, reads it into a buffer, byte-swaps each
// 32-bit word from big-endian to native (little-endian x86), and streams
// to the engine's data register via MMIO.
//
// This mirrors the Linux kernel's si_cp_load_microcode() which does
// be32_to_cpup() on each firmware word before WREG32 to the data register.
//
// gpu:       GPU index
// addr_reg:  engine address register (e.g. SIReg.CP_PFP_UCODE_ADDR)
// data_reg:  engine data register (e.g. SIReg.CP_PFP_UCODE_DATA)
// fw_path:   address of firmware file path string
//
// Returns word count on success, negative on error.
// =============================================================================
Function.PM4_LoadUcodeFile {
    Input: gpu: Integer
    Input: addr_reg: Integer
    Input: data_reg: Integer
    Input: fw_path: Integer
    Output: Integer
    Body: {
        // Open firmware file (syscall 2 = open, O_RDONLY = 0)
        ufw_fd = SystemCall(2, fw_path, 0, 0)
        IfCondition LessThan(ufw_fd, 0) ThenBlock: {
            PrintMessage("[PM4] cannot open firmware file\n")
            ReturnValue(-1)
        }

        // Get file size: lseek(fd, 0, SEEK_END) then lseek(fd, 0, SEEK_SET)
        ufw_size = SystemCall(8, ufw_fd, 0, 2)
        SystemCall(8, ufw_fd, 0, 0)

        IfCondition LessThan(ufw_size, 4) ThenBlock: {
            PrintMessage("[PM4] firmware file too small\n")
            SystemCall(3, ufw_fd)
            ReturnValue(-2)
        }

        // Allocate buffer and read entire file
        ufw_buf = Allocate(ufw_size)
        IfCondition EqualTo(ufw_buf, 0) ThenBlock: {
            PrintMessage("[PM4] firmware alloc failed\n")
            SystemCall(3, ufw_fd)
            ReturnValue(-3)
        }

        ufw_read = SystemCall(0, ufw_fd, ufw_buf, ufw_size)
        SystemCall(3, ufw_fd)

        IfCondition NotEqual(ufw_read, ufw_size) ThenBlock: {
            PrintMessage("[PM4] firmware read incomplete: got ")
            PrintNumber(ufw_read)
            PrintMessage(" expected ")
            PrintNumber(ufw_size)
            PrintMessage("\n")
            Deallocate(ufw_buf, ufw_size)
            ReturnValue(-4)
        }

        // Reset engine address counter to 0
        GPU_Wr32(gpu, addr_reg, 0)

        // Stream firmware words — big-endian to little-endian byte swap
        // Big-endian layout: byte[0]=MSB, byte[1], byte[2], byte[3]=LSB
        // Reconstruct native value: (b0 << 24) | (b1 << 16) | (b2 << 8) | b3
        ufw_words = Divide(ufw_size, 4)
        ufw_i = 0
        WhileLoop LessThan(ufw_i, ufw_words) {
            ufw_off = Multiply(ufw_i, 4)
            ufw_b0 = GetByte(ufw_buf, ufw_off)
            ufw_b1 = GetByte(ufw_buf, Add(ufw_off, 1))
            ufw_b2 = GetByte(ufw_buf, Add(ufw_off, 2))
            ufw_b3 = GetByte(ufw_buf, Add(ufw_off, 3))
            ufw_word = Add(LeftShift(ufw_b0, 24), Add(LeftShift(ufw_b1, 16), Add(LeftShift(ufw_b2, 8), ufw_b3)))
            GPU_Wr32(gpu, data_reg, ufw_word)
            ufw_i = Add(ufw_i, 1)
        }

        // Reset address counter back to 0 (kernel does this after each engine load)
        GPU_Wr32(gpu, addr_reg, 0)

        Deallocate(ufw_buf, ufw_size)
        ReturnValue(ufw_words)
    }
}

// =============================================================================
// PM4_LoadCPFirmware — load PFP, ME, and CE microcode for the Command Processor
//
// Must be called while CP is halted (after PM4_HaltCP, before PM4_UnhaltCP).
// Reads firmware from /lib/firmware/radeon/VERDE_{pfp,me,ce}.bin.
// These are the same firmware files the radeon/amdgpu kernel driver uses.
//
// Without firmware, the CP engines have no microcode and cannot parse PM4
// packets — the ring test NOP will hang forever waiting for RPTR to advance.
//
// Returns 0 on success, negative on error.
// =============================================================================
Function.PM4_LoadCPFirmware {
    Input: gpu: Integer
    Output: Integer
    Body: {
        //PrintMessage("[PM4] Loading CP firmware...\n")

        // Halt CP first (matches kernel gfx_v6_0_cp_gfx_enable(false))
        // CP_ME_CNTL = ME_HALT | PFP_HALT | CE_HALT
        GPU_Wr32(gpu, SIReg.CP_ME_CNTL, 352321536)  // 0x15000000
        GPU_Wr32(gpu, SIReg.SCRATCH_UMSK, 0)

        // Load order to match kernel mmiotrace trace for working cold init: ME, PFP, CE
        // (source comment says PFP CE ME, but the trace that worked used ME first; user wants matching behavior from logs)
        // Load ME (Micro Engine) — FIRST per trace
        cpfw_rc = PM4_LoadUcodeFile(gpu, SIReg.CP_ME_RAM_WADDR, SIReg.CP_ME_RAM_DATA, CPFWPaths.me)
        IfCondition LessThan(cpfw_rc, 0) ThenBlock: {
            PrintMessage("[PM4] ME firmware FAILED\n")
            ReturnValue(-3)
        }

        // Load PFP (Pre-Fetch Parser) — SECOND per trace
        cpfw_rc = PM4_LoadUcodeFile(gpu, SIReg.CP_PFP_UCODE_ADDR, SIReg.CP_PFP_UCODE_DATA, CPFWPaths.pfp)
        IfCondition LessThan(cpfw_rc, 0) ThenBlock: {
            PrintMessage("[PM4] PFP firmware FAILED\n")
            ReturnValue(-1)
        }

        // Load CE (Constant Engine) — THIRD per trace
        cpfw_rc = PM4_LoadUcodeFile(gpu, SIReg.CP_CE_UCODE_ADDR, SIReg.CP_CE_UCODE_DATA, CPFWPaths.ce)
        IfCondition LessThan(cpfw_rc, 0) ThenBlock: {
            PrintMessage("[PM4] CE firmware FAILED\n")
            ReturnValue(-2)
        }

        // Addr register zeroing after all engines loaded
        // Matches mmiotrace seq 439944-439948 exactly:
        //   CE_UCODE_ADDR=0, ME_RAM_WADDR=0, PFP_UCODE_ADDR=0, CE_UCODE_ADDR=0, ME_RAM_RADDR=0
        // Note: LoadUcodeFile already zeros the addr reg at end of each load,
        // so CE_UCODE_ADDR=0 at 439944 is from the CE loader.
        // The remaining zeroes are the explicit cleanup:
        GPU_Wr32(gpu, SIReg.CP_ME_RAM_WADDR, 0)
        GPU_Wr32(gpu, SIReg.CP_PFP_UCODE_ADDR, 0)
        GPU_Wr32(gpu, SIReg.CP_CE_UCODE_ADDR, 0)
        GPU_Wr32(gpu, SIReg.CP_ME_RAM_RADDR, 0)

        ReturnValue(0)
    }
}

// =============================================================================
// PM4_LoadRLCFirmware — load RLC microcode and start the Run List Controller
//
// The RLC is required for compute dispatch tracking: without it, the ME's
// internal dispatch FIFO (~25 entries per ring) never drains, causing
// dispatch 26 to hang.  The RLC processes EOP interrupt signals and tells
// the ME to free FIFO entries.
//
// verde_rlc.bin uses the new firmware header format:
//   - Little-endian header (52 bytes)
//   - ucode_array_offset_bytes at header[24] = 256
//   - ucode_size_bytes at header[20] = 8192 (2048 DWORDs)
//   - Microcode is LITTLE-ENDIAN (no byte swap on x86)
//
// Mirrors si_rlc_load_microcode() + si_rlc_resume() from Linux si.c.
// =============================================================================
Function.PM4_LoadRLCFirmware {
    Input: gpu: Integer
    Output: Integer
    Body: {
        //PrintMessage("[PM4] Loading RLC firmware...\n")

        // --- Stop RLC first ---
        GPU_Wr32(gpu, SIReg.RLC_CNTL, 0)
        rlc_flush = GPU_Rd32(gpu, SIReg.RLC_CNTL)

        // --- si_init_cg() equivalent: RLC SERDES clock-gating handshake ---
        // The kernel's si_rlc_resume() calls si_init_cg() between RLC reset
        // and RLC firmware load.  si_init_cg() → si_enable_mgcg(true) +
        // si_enable_cgcg(true) distribute clock-gating config to ALL GFX
        // sub-blocks (SPI, SQ, TA, TC, etc.) via the RLC SERDES bus.
        //
        // Without this handshake, compute sub-blocks (SPI/SQ) remain in
        // indeterminate clock state after PCI reset → GRBM writes to
        // SET_SH_REG compute registers hang with GRBM_WR_PENDING because
        // the target block never acknowledges the write.
        //
        // Step 1: MGCG enable (si_enable_mgcg, matched from mmiotrace seq 567043+)
        //   CGTS_SM_CTRL_REG = 0x96940200 (already set by MC_SI_GpuInit)
        //   RLC_CGTT_MGCG_OVERRIDE = 0xFFFFFFC0 (clear bits [5:0])
        GPU_Wr32(gpu, SIReg.CGTS_SM_CTRL_REG, 2526282240)       // 0x96940200 (was 2525528576=0x96888200, FIXED)
        GPU_Wr32(gpu, SIReg.RLC_CGTT_MGCG_OVERRIDE, 4294967232) // 0xFFFFFFC0

        //   SERDES MGCG handshake: MASK_0/1 = 0xFFFFFFFF, CTRL = 0x00D000FF
        GPU_Wr32(gpu, SIReg.RLC_SERDES_WR_MASTER_MASK_0, 4294967295)  // 0xFFFFFFFF
        GPU_Wr32(gpu, SIReg.RLC_SERDES_WR_MASTER_MASK_1, 4294967295)  // 0xFFFFFFFF
        GPU_Wr32(gpu, SIReg.RLC_SERDES_WR_CTRL, 13631743)            // 0x00D000FF

        //   Poll SERDES_MASTER_BUSY until both = 0 (si_wait_for_rlc_serdes)
        cg_wait = 0
        WhileLoop LessThan(cg_wait, 5000) {
            cg_b0 = GPU_Rd32(gpu, SIReg.RLC_SERDES_MASTER_BUSY_0)
            IfCondition EqualTo(cg_b0, 0) ThenBlock: {
                cg_wait = 5000
            }
            cg_wait = Add(cg_wait, 1)
        }
        cg_wait = 0
        WhileLoop LessThan(cg_wait, 5000) {
            cg_b1 = GPU_Rd32(gpu, SIReg.RLC_SERDES_MASTER_BUSY_1)
            IfCondition EqualTo(cg_b1, 0) ThenBlock: {
                cg_wait = 5000
            }
            cg_wait = Add(cg_wait, 1)
        }

        // Step 2: CGCG enable (si_enable_cgcg)
        //   SERDES CGCG handshake: CTRL = 0x00B000FF
        GPU_Wr32(gpu, SIReg.RLC_SERDES_WR_MASTER_MASK_0, 4294967295)  // 0xFFFFFFFF
        GPU_Wr32(gpu, SIReg.RLC_SERDES_WR_MASTER_MASK_1, 4294967295)  // 0xFFFFFFFF
        GPU_Wr32(gpu, SIReg.RLC_SERDES_WR_CTRL, 11534591)            // 0x00B000FF

        //   Poll busy again
        cg_wait = 0
        WhileLoop LessThan(cg_wait, 5000) {
            cg_b0 = GPU_Rd32(gpu, SIReg.RLC_SERDES_MASTER_BUSY_0)
            IfCondition EqualTo(cg_b0, 0) ThenBlock: {
                cg_wait = 5000
            }
            cg_wait = Add(cg_wait, 1)
        }
        cg_wait = 0
        WhileLoop LessThan(cg_wait, 5000) {
            cg_b1 = GPU_Rd32(gpu, SIReg.RLC_SERDES_MASTER_BUSY_1)
            IfCondition EqualTo(cg_b1, 0) ThenBlock: {
                cg_wait = 5000
            }
            cg_wait = Add(cg_wait, 1)
        }

        //   Final SERDES write + enable CGCG/CGLS
        GPU_Wr32(gpu, SIReg.RLC_SERDES_WR_CTRL, 7340287)             // 0x007000FF

        //   RLC_CGCG_CGLS_CTRL |= CGCG_EN(bit0) | CGLS_EN(bit1)
        cg_ctrl = GPU_Rd32(gpu, SIReg.RLC_CGCG_CGLS_CTRL)
        GPU_Wr32(gpu, SIReg.RLC_CGCG_CGLS_CTRL, BitwiseOr(cg_ctrl, 3))  // |= 0x3

        PrintMessage("[PM4] RLC SERDES CG handshake done (MGCG+CGCG)\n")

        // --- Open firmware file ---
        rlc_fd = SystemCall(2, CPFWPaths.rlc, 0, 0)
        IfCondition LessThan(rlc_fd, 0) ThenBlock: {
            PrintMessage("[PM4] cannot open RLC firmware file\n")
            ReturnValue(-1)
        }

        // Get file size
        rlc_fsize = SystemCall(8, rlc_fd, 0, 2)
        SystemCall(8, rlc_fd, 0, 0)
        IfCondition LessThan(rlc_fsize, 260) ThenBlock: {
            PrintMessage("[PM4] RLC firmware too small\n")
            SystemCall(3, rlc_fd)
            ReturnValue(-2)
        }

        // Allocate and read
        rlc_buf = Allocate(rlc_fsize)
        IfCondition EqualTo(rlc_buf, 0) ThenBlock: {
            PrintMessage("[PM4] RLC firmware alloc failed\n")
            SystemCall(3, rlc_fd)
            ReturnValue(-3)
        }
        rlc_got = SystemCall(0, rlc_fd, rlc_buf, rlc_fsize)
        SystemCall(3, rlc_fd)
        IfCondition NotEqual(rlc_got, rlc_fsize) ThenBlock: {
            PrintMessage("[PM4] RLC firmware read incomplete\n")
            Deallocate(rlc_buf, rlc_fsize)
            ReturnValue(-4)
        }

        // --- Parse header: ucode starts at offset 256, size 8192 bytes ---
        // header[20] = ucode_size_bytes (LE32)
        // header[24] = ucode_array_offset_bytes (LE32)
        rlc_ucode_off_b0 = GetByte(rlc_buf, 24)
        rlc_ucode_off_b1 = GetByte(rlc_buf, 25)
        rlc_ucode_off_b2 = GetByte(rlc_buf, 26)
        rlc_ucode_off_b3 = GetByte(rlc_buf, 27)
        rlc_ucode_off = Add(rlc_ucode_off_b0, Add(LeftShift(rlc_ucode_off_b1, 8), Add(LeftShift(rlc_ucode_off_b2, 16), LeftShift(rlc_ucode_off_b3, 24))))

        rlc_usize_b0 = GetByte(rlc_buf, 20)
        rlc_usize_b1 = GetByte(rlc_buf, 21)
        rlc_usize_b2 = GetByte(rlc_buf, 22)
        rlc_usize_b3 = GetByte(rlc_buf, 23)
        rlc_ucode_size = Add(rlc_usize_b0, Add(LeftShift(rlc_usize_b1, 8), Add(LeftShift(rlc_usize_b2, 16), LeftShift(rlc_usize_b3, 24))))
        rlc_fw_dwords = Divide(rlc_ucode_size, 4)

        //PrintMessage("[PM4]   RLC: ucode_off=")
        //PrintNumber(rlc_ucode_off)
        //PrintMessage(" size=")
        //PrintNumber(rlc_ucode_size)
        //PrintMessage(" (")
        //PrintNumber(rlc_fw_dwords)
        //PrintMessage(" DWORDs)\n")

        // --- Program RLC registers ---
        // Both bases need valid VRAM addresses (kernel sets both, not 0).
        // RLC_SR = save/restore register list, RLC_CS = clear state data.
        rlc_sr_gpu = PM4_VramToGPU(100876288)      // 0x6034000 = AccelGCNLayout.RLC_SR_OFFSET
        rlc_cs_gpu = PM4_VramToGPU(100892672)      // 0x6038000 = AccelGCNLayout.RLC_CS_OFFSET
        GPU_Wr32(gpu, SIReg.RLC_SAVE_AND_RESTORE_BASE, Divide(rlc_sr_gpu, 256))
        GPU_Wr32(gpu, SIReg.RLC_CLEAR_STATE_RESTORE_BASE, Divide(rlc_cs_gpu, 256))

        GPU_Wr32(gpu, SIReg.RLC_RL_BASE, 0)
        GPU_Wr32(gpu, SIReg.RLC_RL_SIZE, 0)

        // verde_golden_rlc_registers — kernel programs these before RLC start
        GPU_Wr32(gpu, 50212, 54464517)      // 0xC424 = 0x033F1005 (was 54329349=0x033D0005, FIXED2)
        GPU_Wr32(gpu, 50300, 276856864)     // 0xC47C = 0x10808020 (was 277348384=0x10880020, FIXED)
        GPU_Wr32(gpu, 50312, 8388616)       // 0xC488 = 0x00800008
        GPU_Wr32(gpu, SIReg.RLC_LB_CNTR_MAX, 4294967295)        // 0xC314 = 0xFFFFFFFF (rlc_resume override, was 4096=0x1000 golden, FIXED)
        GPU_Wr32(gpu, SIReg.RLC_LB_CNTL, 0)                     // 0xC30C = 0x00000000 (rlc_resume override, was 0x80010014 golden, FIXED)
        GPU_Wr32(gpu, SIReg.RLC_LB_CNTR_INIT, 0)
        GPU_Wr32(gpu, SIReg.RLC_LB_INIT_CU_MASK, 4294967295)  // 0xFFFFFFFF

        GPU_Wr32(gpu, SIReg.RLC_MC_CNTL, 0)
        GPU_Wr32(gpu, SIReg.RLC_UCODE_CNTL, 0)

        // --- Stream firmware to RLC SRAM ---
        // New-format: LITTLE-ENDIAN on x86, no byte swap needed.
        // Read 4 bytes as LE32 and write directly.
        GPU_Wr32(gpu, SIReg.RLC_UCODE_ADDR, 0)
        rlc_i = 0
        WhileLoop LessThan(rlc_i, rlc_fw_dwords) {
            rlc_off = Add(rlc_ucode_off, Multiply(rlc_i, 4))
            rlc_b0 = GetByte(rlc_buf, rlc_off)
            rlc_b1 = GetByte(rlc_buf, Add(rlc_off, 1))
            rlc_b2 = GetByte(rlc_buf, Add(rlc_off, 2))
            rlc_b3 = GetByte(rlc_buf, Add(rlc_off, 3))
            rlc_word = Add(rlc_b0, Add(LeftShift(rlc_b1, 8), Add(LeftShift(rlc_b2, 16), LeftShift(rlc_b3, 24))))
            GPU_Wr32(gpu, SIReg.RLC_UCODE_DATA, rlc_word)
            rlc_i = Add(rlc_i, 1)
        }
        GPU_Wr32(gpu, SIReg.RLC_UCODE_ADDR, 0)

        Deallocate(rlc_buf, rlc_fsize)

        // enable_lbpw: check if DDR3 (MC_SEQ_MISC0 bits[31:28] == 0xB)
        rlc_misc0 = GPU_Rd32(gpu, SIReg.MC_SEQ_MISC0)
        rlc_mem_type = BitwiseAnd(rlc_misc0, 4026531840)  // 0xF0000000
        IfCondition EqualTo(rlc_mem_type, 2952790016) ThenBlock: {  // 0xB0000000
            // DDR3: enable load balance
            rlc_lb = GPU_Rd32(gpu, SIReg.RLC_LB_CNTL)
            GPU_Wr32(gpu, SIReg.RLC_LB_CNTL, BitwiseOr(rlc_lb, 1))
        }
        IfCondition NotEqual(rlc_mem_type, 2952790016) ThenBlock: {
            // Not DDR3: disable load balance
            rlc_lb = GPU_Rd32(gpu, SIReg.RLC_LB_CNTL)
            GPU_Wr32(gpu, SIReg.RLC_LB_CNTL, BitwiseAnd(rlc_lb, 4294967294))  // ~1
        }

        // --- Pre-RLC writes (kernel si_rlc_resume / si_gpu_init tail) ---
        // GRBM_GFX_INDEX = 0xE0000000 → broadcast to all SE/SH/instances
        GPU_Wr32(gpu, SIReg.GRBM_GFX_INDEX, 3758096384)  // 0xE0000000

        // SPI_LB_CU_MASK = 0xFF → enable all CUs for load balancing
        GPU_Wr32(gpu, 37716, 255)                          // 0x9354 = 0xFF

        // PA_CL_ENHANCE = CLIP_VTX_REORDER_ENA | NUM_CLIP_SEQ(3) = 0x7
        GPU_Wr32(gpu, SIReg.PA_CL_ENHANCE, 7)             // 0x8A14 = 0x7

        // --- Start RLC ---
        // RLC_CNTL bit 0 = RLC_ENABLE
        GPU_Wr32(gpu, SIReg.RLC_CNTL, 1)
        rlc_rb = GPU_Rd32(gpu, SIReg.RLC_CNTL)
        //PrintMessage("[PM4] RLC started (RLC_CNTL=0x")
        //PrintHex(rlc_rb)
        //PrintMessage(")\n")

        // enable_gui_idle_interrupt(true) — matches kernel rlc_start
        rlc_int = GPU_Rd32(gpu, SIReg.CP_INT_CNTL_RING0)
        GPU_Wr32(gpu, SIReg.CP_INT_CNTL_RING0, BitwiseOr(rlc_int, 1572864))  // CNTX_BUSY(1<<19) | CNTX_EMPTY(1<<20) = 0x180000

        ReturnValue(0)
    }
}

// =============================================================================
// PM4_PopulateCSB — write RLC Clear State Block PM4 packets to VRAM
//
// Implements the equivalent of kernel si_get_csb_buffer() / sumo_rlc_init().
// The RLC's CLEAR_STATE_RESTORE_BASE register points to a VRAM region that
// must contain valid PM4 packets.  When the CP executes a CLEAR_STATE packet,
// the ME replays the CSB data to initialise context registers to safe defaults.
//
// Without this, CLEAR_STATE replays random (zero/garbage) VRAM → the ME's
// context register file has undefined state → compute dispatches can fail to
// launch because the ME/SPI is in an inconsistent state.
//
// CSB layout (908 DWORDs = 3632 bytes, fits in 16KB allocation):
//   PREAMBLE_CNTL(BEGIN) + CONTEXT_CONTROL(load,shadow)
//   7 × SET_CONTEXT_REG extents (si_SECT_CONTEXT_def_1..7)
//   SET_CONTEXT_REG(PA_SC_RASTER_CONFIG = 0x124A for Verde)
//   PREAMBLE_CNTL(END) + CLEAR_STATE(0)
//
// Must be called BEFORE PM4_LoadRLCFirmware (which starts the RLC).
// The CSB VRAM region is at AccelGCNLayout.RLC_CS_OFFSET = 0x6038000.
//
// Source data: drivers/gpu/drm/amd/amdgpu/clearstate_si.h (kernel 6.1)
// =============================================================================
Function.PM4_PopulateCSB {
    Input: gpu: Integer
    Output: Integer
    Body: {
        csb_base = 100892672    // 0x6038000 = AccelGCNLayout.RLC_CS_OFFSET

        // --- Step 1: Zero the entire 16KB CSB region ---
        // 16384 bytes / 4 = 4096 DWORDs
        csb_i = 0
        WhileLoop LessThan(csb_i, 4096) {
            GPU_VramWr32(gpu, Add(csb_base, Multiply(csb_i, 4)), 0)
            csb_i = Add(csb_i, 1)
        }

        // --- Step 2: Write non-zero CSB DWORDs ---
        // Pre-zeroed region means we only need to write non-zero values.
        // DWORD positions are absolute indices into the 908-DWORD CSB buffer.
        // Each DWORD N is at VRAM byte offset csb_base + N*4.

        // ---- Preamble + Context Control (DWORDs 0-4) ----
        GPU_VramWr32(gpu, csb_base, 3221243392)                        // DW0: PREAMBLE_CNTL hdr 0xC0004A00
        GPU_VramWr32(gpu, Add(csb_base, 4), 536870912)                 // DW1: BEGIN_CLEAR_STATE 0x20000000
        GPU_VramWr32(gpu, Add(csb_base, 8), 3221301248)                // DW2: CONTEXT_CONTROL hdr 0xC0012800
        GPU_VramWr32(gpu, Add(csb_base, 12), 2147483648)               // DW3: 0x80000000
        GPU_VramWr32(gpu, Add(csb_base, 16), 2147483648)               // DW4: 0x80000000

        // ---- Extent 1: SET_CONTEXT_REG, 212 values @ 0xA000 (DWORDs 5-218) ----
        GPU_VramWr32(gpu, Add(csb_base, 20), 3234367744)               // DW5:  hdr 0xC0D46900
        // DW6 = reg_offset 0 (already zero)
        GPU_VramWr32(gpu, Add(csb_base, 80), 1073758208)               // DW20: PA_SC_SCREEN_SCISSOR_BR 0x40004000
        GPU_VramWr32(gpu, Add(csb_base, 544), 2147483648)              // DW136: PA_SC_WINDOW_SCISSOR_TL 0x80000000
        GPU_VramWr32(gpu, Add(csb_base, 548), 1073758208)              // DW137: PA_SC_WINDOW_SCISSOR_BR 0x40004000
        GPU_VramWr32(gpu, Add(csb_base, 552), 65535)                   // DW138: PA_SC_CLIPRECT_RULE 0x0000FFFF
        GPU_VramWr32(gpu, Add(csb_base, 560), 1073758208)              // DW140: PA_SC_CLIPRECT_0_BR 0x40004000
        GPU_VramWr32(gpu, Add(csb_base, 568), 1073758208)              // DW142: PA_SC_CLIPRECT_1_BR 0x40004000
        GPU_VramWr32(gpu, Add(csb_base, 576), 1073758208)              // DW144: PA_SC_CLIPRECT_2_BR 0x40004000
        GPU_VramWr32(gpu, Add(csb_base, 584), 1073758208)              // DW146: PA_SC_CLIPRECT_3_BR 0x40004000
        GPU_VramWr32(gpu, Add(csb_base, 588), 2862627498)              // DW147: PA_SC_EDGERULE 0xAA99AAAA
        GPU_VramWr32(gpu, Add(csb_base, 596), 4294967295)              // DW149: CB_TARGET_MASK 0xFFFFFFFF
        GPU_VramWr32(gpu, Add(csb_base, 600), 4294967295)              // DW150: CB_SHADER_MASK 0xFFFFFFFF
        GPU_VramWr32(gpu, Add(csb_base, 604), 2147483648)              // DW151: PA_SC_GENERIC_SCISSOR_TL 0x80000000
        GPU_VramWr32(gpu, Add(csb_base, 608), 1073758208)              // DW152: PA_SC_GENERIC_SCISSOR_BR 0x40004000
        // DW153-154 = COHER_DEST_BASE = 0 (already zero)
        // PA_SC_VPORT_SCISSOR 0..15: alternating TL=0x80000000, BR=0x40004000
        GPU_VramWr32(gpu, Add(csb_base, 620), 2147483648)              // DW155: VPORT_SCISSOR_0_TL
        GPU_VramWr32(gpu, Add(csb_base, 624), 1073758208)              // DW156: VPORT_SCISSOR_0_BR
        GPU_VramWr32(gpu, Add(csb_base, 628), 2147483648)              // DW157: VPORT_SCISSOR_1_TL
        GPU_VramWr32(gpu, Add(csb_base, 632), 1073758208)              // DW158: VPORT_SCISSOR_1_BR
        GPU_VramWr32(gpu, Add(csb_base, 636), 2147483648)              // DW159: VPORT_SCISSOR_2_TL
        GPU_VramWr32(gpu, Add(csb_base, 640), 1073758208)              // DW160: VPORT_SCISSOR_2_BR
        GPU_VramWr32(gpu, Add(csb_base, 644), 2147483648)              // DW161: VPORT_SCISSOR_3_TL
        GPU_VramWr32(gpu, Add(csb_base, 648), 1073758208)              // DW162: VPORT_SCISSOR_3_BR
        GPU_VramWr32(gpu, Add(csb_base, 652), 2147483648)              // DW163: VPORT_SCISSOR_4_TL
        GPU_VramWr32(gpu, Add(csb_base, 656), 1073758208)              // DW164: VPORT_SCISSOR_4_BR
        GPU_VramWr32(gpu, Add(csb_base, 660), 2147483648)              // DW165: VPORT_SCISSOR_5_TL
        GPU_VramWr32(gpu, Add(csb_base, 664), 1073758208)              // DW166: VPORT_SCISSOR_5_BR
        GPU_VramWr32(gpu, Add(csb_base, 668), 2147483648)              // DW167: VPORT_SCISSOR_6_TL
        GPU_VramWr32(gpu, Add(csb_base, 672), 1073758208)              // DW168: VPORT_SCISSOR_6_BR
        GPU_VramWr32(gpu, Add(csb_base, 676), 2147483648)              // DW169: VPORT_SCISSOR_7_TL
        GPU_VramWr32(gpu, Add(csb_base, 680), 1073758208)              // DW170: VPORT_SCISSOR_7_BR
        GPU_VramWr32(gpu, Add(csb_base, 684), 2147483648)              // DW171: VPORT_SCISSOR_8_TL
        GPU_VramWr32(gpu, Add(csb_base, 688), 1073758208)              // DW172: VPORT_SCISSOR_8_BR
        GPU_VramWr32(gpu, Add(csb_base, 692), 2147483648)              // DW173: VPORT_SCISSOR_9_TL
        GPU_VramWr32(gpu, Add(csb_base, 696), 1073758208)              // DW174: VPORT_SCISSOR_9_BR
        GPU_VramWr32(gpu, Add(csb_base, 700), 2147483648)              // DW175: VPORT_SCISSOR_10_TL
        GPU_VramWr32(gpu, Add(csb_base, 704), 1073758208)              // DW176: VPORT_SCISSOR_10_BR
        GPU_VramWr32(gpu, Add(csb_base, 708), 2147483648)              // DW177: VPORT_SCISSOR_11_TL
        GPU_VramWr32(gpu, Add(csb_base, 712), 1073758208)              // DW178: VPORT_SCISSOR_11_BR
        GPU_VramWr32(gpu, Add(csb_base, 716), 2147483648)              // DW179: VPORT_SCISSOR_12_TL
        GPU_VramWr32(gpu, Add(csb_base, 720), 1073758208)              // DW180: VPORT_SCISSOR_12_BR
        GPU_VramWr32(gpu, Add(csb_base, 724), 2147483648)              // DW181: VPORT_SCISSOR_13_TL
        GPU_VramWr32(gpu, Add(csb_base, 728), 1073758208)              // DW182: VPORT_SCISSOR_13_BR
        GPU_VramWr32(gpu, Add(csb_base, 732), 2147483648)              // DW183: VPORT_SCISSOR_14_TL
        GPU_VramWr32(gpu, Add(csb_base, 736), 1073758208)              // DW184: VPORT_SCISSOR_14_BR
        GPU_VramWr32(gpu, Add(csb_base, 740), 2147483648)              // DW185: VPORT_SCISSOR_15_TL
        GPU_VramWr32(gpu, Add(csb_base, 744), 1073758208)              // DW186: VPORT_SCISSOR_15_BR
        // PA_SC_VPORT_ZMIN/ZMAX 0..15: ZMIN=0 (already zero), ZMAX=0x3F800000
        GPU_VramWr32(gpu, Add(csb_base, 752), 1065353216)              // DW188: VPORT_ZMAX_0  0x3F800000
        GPU_VramWr32(gpu, Add(csb_base, 760), 1065353216)              // DW190: VPORT_ZMAX_1
        GPU_VramWr32(gpu, Add(csb_base, 768), 1065353216)              // DW192: VPORT_ZMAX_2
        GPU_VramWr32(gpu, Add(csb_base, 776), 1065353216)              // DW194: VPORT_ZMAX_3
        GPU_VramWr32(gpu, Add(csb_base, 784), 1065353216)              // DW196: VPORT_ZMAX_4
        GPU_VramWr32(gpu, Add(csb_base, 792), 1065353216)              // DW198: VPORT_ZMAX_5
        GPU_VramWr32(gpu, Add(csb_base, 800), 1065353216)              // DW200: VPORT_ZMAX_6
        GPU_VramWr32(gpu, Add(csb_base, 808), 1065353216)              // DW202: VPORT_ZMAX_7
        GPU_VramWr32(gpu, Add(csb_base, 816), 1065353216)              // DW204: VPORT_ZMAX_8
        GPU_VramWr32(gpu, Add(csb_base, 824), 1065353216)              // DW206: VPORT_ZMAX_9
        GPU_VramWr32(gpu, Add(csb_base, 832), 1065353216)              // DW208: VPORT_ZMAX_10
        GPU_VramWr32(gpu, Add(csb_base, 840), 1065353216)              // DW210: VPORT_ZMAX_11
        GPU_VramWr32(gpu, Add(csb_base, 848), 1065353216)              // DW212: VPORT_ZMAX_12
        GPU_VramWr32(gpu, Add(csb_base, 856), 1065353216)              // DW214: VPORT_ZMAX_13
        GPU_VramWr32(gpu, Add(csb_base, 864), 1065353216)              // DW216: VPORT_ZMAX_14
        GPU_VramWr32(gpu, Add(csb_base, 872), 1065353216)              // DW218: VPORT_ZMAX_15

        // ---- Extent 2: SET_CONTEXT_REG, 272 values @ 0xA0D8 (DWORDs 219-492) ----
        GPU_VramWr32(gpu, Add(csb_base, 876), 3238887680)              // DW219: hdr 0xC1106900
        GPU_VramWr32(gpu, Add(csb_base, 880), 216)                     // DW220: reg_offset 0xD8
        GPU_VramWr32(gpu, Add(csb_base, 1044), 4294967295)             // DW261: VGT_MAX_VTX_INDX 0xFFFFFFFF
        GPU_VramWr32(gpu, Add(csb_base, 1772), 2)                      // DW443: SPI_PS_IN_CONTROL 0x00000002

        // ---- Extent 3: SET_CONTEXT_REG, 6 values @ 0xA1F5 (DWORDs 493-500) ----
        GPU_VramWr32(gpu, Add(csb_base, 1972), 3221614848)             // DW493: hdr 0xC0066900
        GPU_VramWr32(gpu, Add(csb_base, 1976), 501)                    // DW494: reg_offset 0x1F5
        // All 6 values are zero (already zeroed)

        // ---- Extent 4: SET_CONTEXT_REG, 157 values @ 0xA200 (DWORDs 501-659) ----
        GPU_VramWr32(gpu, Add(csb_base, 2004), 3231693056)             // DW501: hdr 0xC09D6900
        GPU_VramWr32(gpu, Add(csb_base, 2008), 512)                    // DW502: reg_offset 0x200
        GPU_VramWr32(gpu, Add(csb_base, 2028), 589824)                 // DW507: PA_CL_CLIP_CNTL 0x00090000
        GPU_VramWr32(gpu, Add(csb_base, 2032), 4)                      // DW508: PA_SU_SC_MODE_CNTL 0x00000004
        GPU_VramWr32(gpu, Add(csb_base, 2608), 256)                    // DW652: VGT_GS_PER_ES 0x00000100
        GPU_VramWr32(gpu, Add(csb_base, 2612), 128)                    // DW653: VGT_ES_PER_GS 0x00000080
        GPU_VramWr32(gpu, Add(csb_base, 2616), 2)                      // DW654: VGT_GS_PER_VS 0x00000002

        // ---- Extent 5: SET_CONTEXT_REG, 1 value @ 0xA2A1 (DWORDs 660-662) ----
        GPU_VramWr32(gpu, Add(csb_base, 2640), 3221366016)             // DW660: hdr 0xC0016900
        GPU_VramWr32(gpu, Add(csb_base, 2644), 673)                    // DW661: reg_offset 0x2A1
        // DW662 = VGT_PRIMITIVEID_EN = 0 (already zero)

        // ---- Extent 6: SET_CONTEXT_REG, 1 value @ 0xA2A3 (DWORDs 663-665) ----
        GPU_VramWr32(gpu, Add(csb_base, 2652), 3221366016)             // DW663: hdr 0xC0016900
        GPU_VramWr32(gpu, Add(csb_base, 2656), 675)                    // DW664: reg_offset 0x2A3
        // DW665 = VGT_PRIMITIVEID_RESET = 0 (already zero)

        // ---- Extent 7: SET_CONTEXT_REG, 233 values @ 0xA2A5 (DWORDs 666-900) ----
        GPU_VramWr32(gpu, Add(csb_base, 2664), 3235743488)             // DW666: hdr 0xC0E96900
        GPU_VramWr32(gpu, Add(csb_base, 2668), 677)                    // DW667: reg_offset 0x2A5
        GPU_VramWr32(gpu, Add(csb_base, 2692), 255)                    // DW673: IA_MULTI_VGT_PARAM 0x000000FF
        GPU_VramWr32(gpu, Add(csb_base, 3000), 4096)                   // DW750: PA_SC_LINE_CNTL 0x00001000
        GPU_VramWr32(gpu, Add(csb_base, 3008), 5)                      // DW752: PA_SU_VTX_CNTL 0x00000005
        GPU_VramWr32(gpu, Add(csb_base, 3012), 1065353216)             // DW753: PA_CL_GB_VERT_CLIP_ADJ 0x3F800000
        GPU_VramWr32(gpu, Add(csb_base, 3016), 1065353216)             // DW754: PA_CL_GB_VERT_DISC_ADJ
        GPU_VramWr32(gpu, Add(csb_base, 3020), 1065353216)             // DW755: PA_CL_GB_HORZ_CLIP_ADJ
        GPU_VramWr32(gpu, Add(csb_base, 3024), 1065353216)             // DW756: PA_CL_GB_HORZ_DISC_ADJ
        GPU_VramWr32(gpu, Add(csb_base, 3092), 4294967295)             // DW773: PA_SC_AA_MASK_X0Y0 0xFFFFFFFF
        GPU_VramWr32(gpu, Add(csb_base, 3096), 4294967295)             // DW774: PA_SC_AA_MASK_X0Y1 0xFFFFFFFF
        GPU_VramWr32(gpu, Add(csb_base, 3124), 14)                     // DW781: VGT_VERTEX_REUSE_BLOCK_CNTL 0x0E
        GPU_VramWr32(gpu, Add(csb_base, 3128), 16)                     // DW782: VGT_OUT_DEALLOC_CNTL 0x10

        // ---- PA_SC_RASTER_CONFIG (DWORDs 901-903) ----
        GPU_VramWr32(gpu, Add(csb_base, 3604), 3221366016)             // DW901: hdr 0xC0016900
        GPU_VramWr32(gpu, Add(csb_base, 3608), 212)                    // DW902: reg_offset 0xD4 (PA_SC_RASTER_CONFIG - 0xA000)
        GPU_VramWr32(gpu, Add(csb_base, 3612), 4682)                   // DW903: 0x0000124A (Verde)

        // ---- Trailer (DWORDs 904-907) ----
        GPU_VramWr32(gpu, Add(csb_base, 3616), 3221243392)             // DW904: PREAMBLE_CNTL hdr 0xC0004A00
        GPU_VramWr32(gpu, Add(csb_base, 3620), 805306368)              // DW905: END_CLEAR_STATE 0x30000000
        GPU_VramWr32(gpu, Add(csb_base, 3624), 3221229056)             // DW906: CLEAR_STATE hdr 0xC0001200
        // DW907 = 0 (already zero)

        PrintMessage("[PM4] CSB populated: 908 DWORDs at VRAM 0x6038000\n")
        ReturnValue(0)
    }
}

// =============================================================================
// PM4_SetupIHRing — set up a minimal Interrupt Handler ring in VRAM
//
// The IH ring is required for the RLC to drain the ME's dispatch tracking
// FIFO.  EVENT_WRITE_EOP with INT_SEL=2 writes an interrupt packet to the
// IH ring; the RLC firmware reads it and tells the ME to free the dispatch
// slot.  Without a live IH ring, the FIFO fills after ~25 dispatches and
// the CP hangs.
//
// We don't need a real ISR — we just need the ring to exist so the GPU
// can write interrupt packets into it.  We poll-drain RPTR to keep up
// with WPTR so the ring never overflows.
//
// VRAM layout: 4KB ring at 0x403C000 (256 entries × 16 bytes each)
//              WPTR writeback at 0x403D000 (4 bytes)
//
// Mirrors si_irq_init() from Linux radeon/si.c.
// =============================================================================
Function.PM4_SetupIHRing {
    Input: gpu: Integer
    Output: Integer
    Body: {
        // IH ring and WPTR writeback are now in system RAM, mapped through GART.
        // Dummy page uses its physical address directly (not through GART).
        // GART_Init() must have been called before this function.

        // Zero the system RAM buffers
        MemorySet(GARTState.ih_ring_host_ptr, 0, GARTConf.IH_RING_SIZE)
        MemorySet(GARTState.ih_wb_host_ptr, 0, GARTConf.IH_WB_SIZE)
        MemorySet(GARTState.dummy_host_ptr, 0, GARTConf.DUMMY_SIZE)

        // =========================================================
        // Step 1: Disable interrupts (si_disable_interrupts)
        // =========================================================
        ih_rb_tmp = GPU_Rd32(gpu, SIReg.IH_RB_CNTL)
        ih_rb_tmp = BitwiseAnd(ih_rb_tmp, 4294967294)   // clear IH_RB_ENABLE (bit 0)
        GPU_Wr32(gpu, SIReg.IH_RB_CNTL, ih_rb_tmp)

        ih_cntl_tmp = GPU_Rd32(gpu, SIReg.IH_CNTL)
        ih_cntl_tmp = BitwiseAnd(ih_cntl_tmp, 4294967294) // clear ENABLE_INTR (bit 0)
        GPU_Wr32(gpu, SIReg.IH_CNTL, ih_cntl_tmp)

        GPU_Wr32(gpu, SIReg.IH_RB_RPTR, 0)
        GPU_Wr32(gpu, SIReg.IH_RB_WPTR, 0)

        // =========================================================
        // Step 2: Disable interrupt sources (si_disable_interrupt_state)
        // Clear TIME_STAMP_INT_ENABLE, keep only CNTX_BUSY/EMPTY
        // =========================================================
        cntx_mask = Add(524288, 1048576)    // 1572864 = 0x180000
        r0_tmp = BitwiseAnd(GPU_Rd32(gpu, SIReg.CP_INT_CNTL_RING0), cntx_mask)
        GPU_Wr32(gpu, SIReg.CP_INT_CNTL_RING0, r0_tmp)
        r1_tmp = BitwiseAnd(GPU_Rd32(gpu, SIReg.CP_INT_CNTL_RING1), cntx_mask)
        GPU_Wr32(gpu, SIReg.CP_INT_CNTL_RING1, r1_tmp)
        r2_tmp = BitwiseAnd(GPU_Rd32(gpu, SIReg.CP_INT_CNTL_RING2), cntx_mask)
        GPU_Wr32(gpu, SIReg.CP_INT_CNTL_RING2, r2_tmp)

        // =========================================================
        // Step 3: INTERRUPT_CNTL2 = dummy page PHYSICAL addr >> 8
        // The dummy page is NOT mapped through GART — it uses raw physical.
        // =========================================================
        GPU_Wr32(gpu, SIReg.INTERRUPT_CNTL2, Divide(GARTState.dummy_phys, 256))

        // =========================================================
        // Step 4: INTERRUPT_CNTL — clear IH_DUMMY_RD_OVERRIDE (bit 0)
        //   and IH_REQ_NONSNOOP_EN (bit 3), matching kernel exactly
        // =========================================================
        int_cntl = GPU_Rd32(gpu, SIReg.INTERRUPT_CNTL)
        int_cntl = BitwiseAnd(int_cntl, 4294967286)   // ~(1|8) = ~9 = 0xFFFFFFF6
        GPU_Wr32(gpu, SIReg.INTERRUPT_CNTL, int_cntl)

        // =========================================================
        // Step 5: IH_RB_BASE = GART GPU VA >> 8
        // IH ring mapped via GART at GPU VA 0xF4_4000_0000
        // IH_RB_BASE = 0xF440000000 >> 8 = combine hi|lo >> 8
        // =========================================================
        // GPU VA = (IH_RING_GPU_VA_HI << 32) | IH_RING_GPU_VA_LO
        //        = (0xF4 << 32) | 0x40000000 = 0xF440000000
        // >> 8   = (0xF4 << 24) | (0x40000000 >> 8) = 0xF4400000
        ih_base_val = BitwiseOr(LeftShift(GARTConf.IH_RING_GPU_VA_HI, 24), Divide(GARTConf.IH_RING_GPU_VA_LO, 256))
        GPU_Wr32(gpu, SIReg.IH_RB_BASE, ih_base_val)

        // =========================================================
        // Step 6: IH_RB_CNTL (without IH_RB_ENABLE yet)
        //   rb_bufsz = log2(65536/4) = log2(16384) = 14
        //   IH_WPTR_OVERFLOW_ENABLE = (1<<16) = 65536
        //   IH_WPTR_OVERFLOW_CLEAR  = (1<<31) = 2147483648
        //   IH_WPTR_WRITEBACK_ENABLE = (1<<8) = 256
        //   rb_bufsz << 1 = 14 << 1 = 28
        // =========================================================
        ih_rb_cntl = Add(28, Add(65536, Add(2147483648, 256)))  // 0x8001011C
        GPU_Wr32(gpu, SIReg.IH_RB_CNTL, ih_rb_cntl)

        // =========================================================
        // Step 7: WPTR writeback address (GART GPU VA)
        // IH WPTR writeback at GPU VA 0xF4_4001_0000
        // IH_RB_WPTR_ADDR_LO = low 32 bits of GPU VA = 0x40010000
        // IH_RB_WPTR_ADDR_HI = high 8 bits = 0xF4
        // =========================================================
        GPU_Wr32(gpu, SIReg.IH_RB_WPTR_ADDR_LO, GARTConf.IH_WB_GPU_VA_LO)
        GPU_Wr32(gpu, SIReg.IH_RB_WPTR_ADDR_HI, GARTConf.IH_WB_GPU_VA_HI)

        // =========================================================
        // Step 8: RPTR = WPTR = 0
        // =========================================================
        GPU_Wr32(gpu, SIReg.IH_RB_RPTR, 0)
        GPU_Wr32(gpu, SIReg.IH_RB_WPTR, 0)

        // =========================================================
        // Step 9: IH_CNTL
        //   RPTR_REARM (bit 4) = 16 — kernel sets this for MSI re-arm
        //   MC_WRREQ_CREDIT(0x10) = 16 << 15 = 524288 = 0x80000
        //   MC_WR_CLEAN_CNT(0x10) = 16 << 20 = 16777216 = 0x1000000
        //   Total without ENABLE_INTR = 0x1080010
        // =========================================================
        ih_cntl_val = Add(16, Add(524288, 16777216))   // 17301520 = 0x1080010
        GPU_Wr32(gpu, SIReg.IH_CNTL, ih_cntl_val)

        // =========================================================
        // Step 10: Enable interrupts (si_enable_interrupts)
        //   IH_CNTL  |= ENABLE_INTR   (bit 0) → 0x01080011
        //   IH_RB_CNTL |= IH_RB_ENABLE (bit 0) → 0x0001011D
        // =========================================================
        ih_cntl_en = BitwiseOr(GPU_Rd32(gpu, SIReg.IH_CNTL), 1)
        GPU_Wr32(gpu, SIReg.IH_CNTL, ih_cntl_en)

        ih_rb_en = BitwiseOr(GPU_Rd32(gpu, SIReg.IH_RB_CNTL), 1)
        GPU_Wr32(gpu, SIReg.IH_RB_CNTL, ih_rb_en)

        // =========================================================
        // Step 11: Enable TIME_STAMP_INT on all 3 rings
        //   MUST be AFTER IH_RB_ENABLE + ENABLE_INTR
        //   TIME_STAMP_INT_ENABLE = (1 << 26) = 67108864
        // =========================================================
        ts_int_en = 67108864     // 1 << 26
        r0_int = GPU_Rd32(gpu, SIReg.CP_INT_CNTL_RING0)
        GPU_Wr32(gpu, SIReg.CP_INT_CNTL_RING0, BitwiseOr(r0_int, ts_int_en))
        r1_int = GPU_Rd32(gpu, SIReg.CP_INT_CNTL_RING1)
        GPU_Wr32(gpu, SIReg.CP_INT_CNTL_RING1, BitwiseOr(r1_int, ts_int_en))
        r2_int = GPU_Rd32(gpu, SIReg.CP_INT_CNTL_RING2)
        GPU_Wr32(gpu, SIReg.CP_INT_CNTL_RING2, BitwiseOr(r2_int, ts_int_en))

        PrintMessage("[PM4] IH ring: GART VA=0xF440000000, dummy_phys=0x")
        PrintHex(GARTState.dummy_phys)
        PrintMessage("\n")

        ReturnValue(0)
    }
}

// =============================================================================
// PM4_DrainIH — advance IH RPTR to match WPTR, preventing overflow
//
// Called after each dispatch fence completes. We don't process the
// interrupt packets — we just need to keep the ring from overflowing
// so the GPU can keep writing new entries.
// =============================================================================
Function.PM4_DrainIH {
    Input: gpu: Integer
    Body: {
        ih_wptr = GPU_Rd32(gpu, SIReg.IH_RB_WPTR)
        ih_rptr = GPU_Rd32(gpu, SIReg.IH_RB_RPTR)
        IfCondition NotEqual(ih_rptr, ih_wptr) ThenBlock: {
            //PrintMessage("[IH:drain] RPTR=")
            //PrintNumber(ih_rptr)
            //PrintMessage(" WPTR=")
            //PrintNumber(ih_wptr)
            //PrintMessage(" (")
            //PrintNumber(Divide(Subtract(ih_wptr, ih_rptr), 4))
            //PrintMessage(" entries)\n")
            // Advance RPTR to WPTR (discard all entries)
            GPU_Wr32(gpu, SIReg.IH_RB_RPTR, ih_wptr)
        }
    }
}

// =============================================================================
// PM4_SoftResetCP — Reset the RLC block (matches amdgpu gfx_v6_0_rlc_reset)
//
// Sequence (from mmiotrace of amdgpu on bus 2, seq 329376-329386):
//   1. Halt RLC  (RLC_CNTL = 0)
//   2. Assert GRBM_SOFT_RESET bit 2 (SOFT_RESET_RLC = 0x4)
//   3. Wait ~50us
//   4. Deassert GRBM_SOFT_RESET (= 0)
//
// amdgpu NEVER resets the CP via GRBM_SOFT_RESET — it controls CP via
// CP_ME_CNTL halt/unhalt only.  amdgpu NEVER does SRBM_SOFT_RESET during
// normal init (mmiotrace shows only a 0x0 write = no-op at seq 466852).
// amdgpu NEVER does MC blackout or BIF_FB_EN toggle during the GFX init
// phase — that only happens during MC reprogramming in the early ATOMBIOS
// phase (seq 715-3639).
//
// Golden regs, tile modes, SPI setup, SH_MEM config, and CG overrides are
// all programmed by MC_SI_GpuInit BEFORE this function is called (matching
// amdgpu's gfx_v6_0_gpu_init running before gfx_v6_0_rlc_resume).
//
// Must be called while CP is halted.  RLC firmware is loaded AFTER this.
// =============================================================================
Function.PM4_SoftResetCP {
    Input: gpu: Integer
    Body: {
        // DISPLAY GPU GUARD
        IfCondition EqualTo(GPU_BAR_IsDisplayGPU(gpu), 1) ThenBlock: {
            PrintMessage("[PM4] SoftResetCP: REFUSED — display GPU\n")
        }
        IfCondition EqualTo(GPU_BAR_IsDisplayGPU(gpu), 0) ThenBlock: {

        // --- Step 0: REMOVED ---
        // Previously did GRBM_SOFT_RESET = 0x10001 (CP + GFX pipeline reset).
        // This DESTROYED all golden registers (SPI, TA, TC, SX, PA, SC, DB, CB)
        // that MC_SI_GpuInit had just programmed. The kernel NEVER does
        // SOFT_RESET_CP or SOFT_RESET_GFX — it just halts CP via CP_ME_CNTL.
        // Mmiotrace Phase 13 ONLY does SOFT_RESET_RLC (0x4).

        // --- Step 1: Halt RLC ---
        // Matches amdgpu gfx_v6_0_rlc_stop(): WREG32(mmRLC_CNTL, 0)
        // mmiotrace seq 329376: RLC_CNTL = 0x00000000
        GPU_Wr32(gpu, SIReg.RLC_CNTL, 0)
        rst_flush = GPU_Rd32(gpu, SIReg.RLC_CNTL)

        // Disable CP_INT_CNTL_RING0 before reset (mmiotrace seq 329378)
        GPU_Wr32(gpu, SIReg.CP_INT_CNTL_RING0, 0)

        // --- Step 2: RLC soft reset ---
        // Matches amdgpu gfx_v6_0_rlc_reset():
        //   WREG32_FIELD(GRBM_SOFT_RESET, SOFT_RESET_RLC, 1)  = bit 2 = 0x4
        //   udelay(50)
        //   WREG32_FIELD(GRBM_SOFT_RESET, SOFT_RESET_RLC, 0)  = 0x0
        //   udelay(50)
        // mmiotrace seq 329384: GRBM_SOFT_RESET = 0x00000004
        // mmiotrace seq 329386: GRBM_SOFT_RESET = 0x00000000
        GPU_Wr32(gpu, SIReg.GRBM_SOFT_RESET, GRBMResetBits.SOFT_RESET_RLC)
        rst_flush = GPU_Rd32(gpu, SIReg.GRBM_SOFT_RESET)
        // Hold assert ~50us
        rst_i = 0
        WhileLoop LessThan(rst_i, 200) {
            rst_flush = GPU_Rd32(gpu, SIReg.GRBM_STATUS)
            rst_i = Add(rst_i, 1)
        }
        GPU_Wr32(gpu, SIReg.GRBM_SOFT_RESET, 0)
        rst_flush = GPU_Rd32(gpu, SIReg.GRBM_SOFT_RESET)

        // Post-reset settle ~50us
        rst_i = 0
        WhileLoop LessThan(rst_i, 200) {
            rst_flush = GPU_Rd32(gpu, SIReg.GRBM_STATUS)
            rst_i = Add(rst_i, 1)
        }

        PrintMessage("[PM4] RLC reset complete (SOFT_RESET_RLC=0x4)\n")

        // NOTE: RLC firmware is loaded after this function returns.
        // RLC_CNTL = 1 (start) happens after firmware upload in
        // PM4_LoadRLCFirmware.  No golden regs, no SRBM reset, no MC
        // blackout — all handled elsewhere matching amdgpu ordering.

        } // end display GPU guard
    }
}

// =============================================================================
// PM4_DMAResume — initialize both DMA/SDMA engines (cayman_dma_resume)
//
// Matches kernel ni_dma.c:cayman_dma_resume() exactly.
// Both DMA0 (base 0xD000) and DMA1 (base 0xD800) get identical treatment:
//   1. Clear semaphore timers
//   2. Configure ring buffer (GART-mapped system RAM)
//   3. Set RPTR writeback address
//   4. Set ring base address
//   5. Enable IB processing
//   6. Clear CTXEMPTY_INT_ENABLE in DMA_CNTL
//   7. Enable ring with writeback
//
// Must be called AFTER:
//   - GART_Init (DMA ring buffers and WB need GART PTEs)
//   - PM4_ConfigureVM (VM contexts must be enabled for GART lookups)
//   - CP ring tests (kernel does DMA init after si_cp_resume)
//
// Display GPU guard: skip on bus 1 (BIOS manages DMA on display GPU).
// =============================================================================
Function.PM4_DMAResume {
    Input: gpu: Integer
    Output: Integer
    Body: {
        is_display = GPU_BAR_IsDisplayGPU(gpu)
        IfCondition EqualTo(is_display, 1) ThenBlock: {
            PrintMessage("[PM4] DMA resume skipped (display GPU)\n")
            ReturnValue(1)
        }

        PrintMessage("[PM4] DMA engine init (cayman_dma_resume)...\n")

        // =====================================================================
        // DMA Engine 0 — base 0xD000
        // =====================================================================

        // Step 1-2: Clear semaphore timers
        GPU_Wr32(gpu, 53316, 0)                  // 0xD044 = DMA_SEM_INCOMPLETE_TIMER_CNTL
        GPU_Wr32(gpu, 53320, 0)                  // 0xD048 = DMA_SEM_WAIT_FAIL_TIMER_CNTL

        // Step 3: RB_CNTL — rb_bufsz=11 (2048 dwords = 8KB), shifted left 1
        //   0x16 = 22 = 11 << 1
        GPU_Wr32(gpu, 53248, 22)                  // 0xD000 = DMA_RB_CNTL (size only, no enable)

        // Step 4-5: Clear pointers
        GPU_Wr32(gpu, 53256, 0)                   // 0xD008 = DMA_RB_RPTR
        GPU_Wr32(gpu, 53260, 0)                   // 0xD00C = DMA_RB_WPTR

        // Step 6-7: RPTR writeback address (GART GPU VA for DMA0 WB)
        // DMA0_WB GPU VA = 0xF4_4006_0000
        // HI = 0xFF (upper 8 bits), LO = lower 32 bits & ~3
        dma0_wb_hi = GARTConf.DMA0_WB_GPU_VA_HI                    // 0xF4
        dma0_wb_lo = BitwiseAnd(GARTConf.DMA0_WB_GPU_VA_LO, 4294967292)  // & ~3 = 0xFFFFFFFC
        GPU_Wr32(gpu, 53276, dma0_wb_hi)          // 0xD01C = DMA_RB_RPTR_ADDR_HI
        GPU_Wr32(gpu, 53280, dma0_wb_lo)          // 0xD020 = DMA_RB_RPTR_ADDR_LO

        // Step 8: Ring base address (GART GPU VA >> 8)
        // DMA0_RING GPU VA = 0xF4_4002_0000
        // DMA_RB_BASE = (hi << 24) | (lo >> 8)
        dma0_base = BitwiseOr(LeftShift(GARTConf.DMA0_RING_GPU_VA_HI, 24), Divide(GARTConf.DMA0_RING_GPU_VA_LO, 256))
        GPU_Wr32(gpu, 53252, dma0_base)           // 0xD004 = DMA_RB_BASE

        // Step 9: IB enable — DMA_IB_ENABLE (bit 0) | CMD_VMID_FORCE (bit 31)
        GPU_Wr32(gpu, 53284, 2147483649)          // 0xD024 = DMA_IB_CNTL = 0x80000001

        // Step 10: DMA_CNTL — read-modify-write, clear CTXEMPTY_INT_ENABLE (bit 28)
        dma0_cntl = GPU_Rd32(gpu, 53292)          // 0xD02C = DMA_CNTL
        dma0_cntl = BitwiseAnd(dma0_cntl, 4026531839)  // & ~(1<<28) = & 0xEFFFFFFF
        GPU_Wr32(gpu, 53292, dma0_cntl)           // 0xD02C

        // Step 11: Clear WPTR again
        GPU_Wr32(gpu, 53260, 0)                   // 0xD00C = DMA_RB_WPTR

        // Step 12: Enable ring — rb_bufsz=11<<1=22, DMA_RB_ENABLE(bit 0)=1, DMA_RPTR_WRITEBACK_ENABLE(bit 12)=4096
        // 22 | 1 | 4096 = 4119 = 0x1017
        GPU_Wr32(gpu, 53248, 4119)                // 0xD000 = DMA_RB_CNTL = 0x1017

        PrintMessage("[PM4] DMA0 ring base=0x")
        PrintHex(dma0_base)
        PrintMessage(" WB=0x")
        PrintHex(dma0_wb_hi)
        PrintMessage(":")
        PrintHex(dma0_wb_lo)
        PrintMessage("\n")

        // =====================================================================
        // DMA Engine 1 — base 0xD800 (DMA0 + 0x800 = + 2048)
        // =====================================================================

        // Step 1-2: Clear semaphore timers
        GPU_Wr32(gpu, 55364, 0)                   // 0xD844 = DMA1_SEM_INCOMPLETE_TIMER_CNTL
        GPU_Wr32(gpu, 55368, 0)                   // 0xD848 = DMA1_SEM_WAIT_FAIL_TIMER_CNTL

        // Step 3: RB_CNTL — size only
        GPU_Wr32(gpu, 55296, 22)                  // 0xD800 = DMA1_RB_CNTL

        // Step 4-5: Clear pointers
        GPU_Wr32(gpu, 55304, 0)                   // 0xD808 = DMA1_RB_RPTR
        GPU_Wr32(gpu, 55308, 0)                   // 0xD80C = DMA1_RB_WPTR

        // Step 6-7: RPTR writeback address (GART GPU VA for DMA1 WB)
        // DMA1_WB GPU VA = 0xF4_4006_1000
        dma1_wb_hi = GARTConf.DMA1_WB_GPU_VA_HI
        dma1_wb_lo = BitwiseAnd(GARTConf.DMA1_WB_GPU_VA_LO, 4294967292)
        GPU_Wr32(gpu, 55324, dma1_wb_hi)          // 0xD81C = DMA1_RB_RPTR_ADDR_HI
        GPU_Wr32(gpu, 55328, dma1_wb_lo)          // 0xD820 = DMA1_RB_RPTR_ADDR_LO

        // Step 8: Ring base address
        // DMA1_RING GPU VA = 0xF4_4004_0000
        dma1_base = BitwiseOr(LeftShift(GARTConf.DMA1_RING_GPU_VA_HI, 24), Divide(GARTConf.DMA1_RING_GPU_VA_LO, 256))
        GPU_Wr32(gpu, 55300, dma1_base)           // 0xD804 = DMA1_RB_BASE

        // Step 9: IB enable
        GPU_Wr32(gpu, 55332, 2147483649)          // 0xD824 = DMA1_IB_CNTL = 0x80000001

        // Step 10: DMA1_CNTL — RMW clear CTXEMPTY_INT_ENABLE
        dma1_cntl = GPU_Rd32(gpu, 55340)          // 0xD82C = DMA1_CNTL
        dma1_cntl = BitwiseAnd(dma1_cntl, 4026531839)
        GPU_Wr32(gpu, 55340, dma1_cntl)

        // Step 11: Clear WPTR again
        GPU_Wr32(gpu, 55308, 0)                   // 0xD80C = DMA1_RB_WPTR

        // Step 12: Enable ring
        GPU_Wr32(gpu, 55296, 4119)                // 0xD800 = DMA1_RB_CNTL = 0x1017

        PrintMessage("[PM4] DMA1 ring base=0x")
        PrintHex(dma1_base)
        PrintMessage(" WB=0x")
        PrintHex(dma1_wb_hi)
        PrintMessage(":")
        PrintHex(dma1_wb_lo)
        PrintMessage("\n")

        PrintMessage("[PM4] DMA0 + DMA1 engines initialized\n")
        ReturnValue(1)
    }
}
