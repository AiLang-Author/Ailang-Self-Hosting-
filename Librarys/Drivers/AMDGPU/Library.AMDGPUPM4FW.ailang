        StoreValue(Add(sr_host, 252), 2617255506, "dword")    // [63] 0x9C002652
        StoreValue(Add(sr_host, 256), 0, "dword")    // [64] 0x00000000
        StoreValue(Add(sr_host, 260), 2617255507, "dword")    // [65] 0x9C002653
