//
// Library.AMDGPUPM4Pkt.ailang
//
// PM4 packet builders, ring idle/reset, and cache sync helpers.
// Split from Library.AMDGPUPM4.ailang for maintainability.
//
// USAGE
//   LibraryImport.Drivers.AMDGPU.AMDGPUPM4Pkt
//
// DEPENDS
//   LibraryImport.Drivers.AMDGPU.AMDGPUPM4Regs
//   LibraryImport.Drivers.AMDGPU.AMDGPUPM4Ring
//   LibraryImport.Drivers.AMDGPU.AMDGPUBAR

// =============================================================================
// PM4_WaitIdle — spin until GPU has consumed all commands (RPTR == WPTR)
// This is "poll head until it matches tail" — same as ThreadPool dispatch.
// =============================================================================
Function.PM4_WaitIdle {
    Input: ring_idx: Integer
    Output: Integer
    Body: {
        ring = PM4_GetRing(ring_idx)
        IfCondition EqualTo(ring, 0) ThenBlock: { ReturnValue(0) }

        wptr = Dereference(Add(ring, RingField.WPTR))
        size = Dereference(Add(ring, RingField.RING_SIZE))
        wptr_masked = BitwiseAnd(wptr, Subtract(size, 1))

        attempts = 0
        max_attempts = 5000000   // 5M spins

        WhileLoop LessThan(attempts, max_attempts) {
            // Try VRAM writeback first (fast path)
            rptr = PM4_ReadRPTR(ring_idx)
            IfCondition EqualTo(rptr, wptr_masked) ThenBlock: {
                ReturnValue(1)
            }
            // Every 100K spins, try MMIO register (RPTR writeback may be broken)
            wi_mod = Modulo(attempts, 100000)
            IfCondition EqualTo(wi_mod, 0) ThenBlock: {
                rptr = PM4_ReadRPTR_MMIO(ring_idx)
                IfCondition EqualTo(rptr, wptr_masked) ThenBlock: {
                    ReturnValue(1)
                }
            }
            attempts = Add(attempts, 1)
        }

        // Final fallback: MMIO register read
        rptr = PM4_ReadRPTR_MMIO(ring_idx)
        IfCondition EqualTo(rptr, wptr_masked) ThenBlock: {
            ReturnValue(1)
        }
        gpu_dbg = Dereference(Add(ring, RingField.GPU_INDEX))
        rid_dbg = Dereference(Add(ring, RingField.RING_ID))
        PrintMessage("[PM4] WaitIdle timeout: ring=")
        PrintNumber(rid_dbg)
        PrintMessage(" RPTR=")
        PrintNumber(rptr)
        PrintMessage(" WPTR=")
        PrintNumber(wptr_masked)
        PrintMessage("\n")
        PrintMessage("[PM4:DBG] GRBM_STATUS=0x")
        PrintHex(GPU_Rd32(gpu_dbg, SIReg.GRBM_STATUS))
        PrintMessage(" GRBM_STATUS2=0x")
        PrintHex(GPU_Rd32(gpu_dbg, SIReg.GRBM_STATUS2))
        PrintMessage(" CP_ME_CNTL=0x")
        PrintHex(GPU_Rd32(gpu_dbg, SIReg.CP_ME_CNTL))
        PrintMessage("\n")

        // Print registers for the ACTUAL failing ring (not hardcoded RB0)
        IfCondition EqualTo(rid_dbg, 0) ThenBlock: {
            PrintMessage("[PM4:DBG] CP_RB0: CNTL=0x")
            PrintHex(GPU_Rd32(gpu_dbg, SIReg.CP_RB0_CNTL))
            PrintMessage(" BASE=0x")
            PrintHex(GPU_Rd32(gpu_dbg, SIReg.CP_RB0_BASE))
            PrintMessage(" RPTR=")
            PrintNumber(GPU_Rd32(gpu_dbg, SIReg.CP_RB0_RPTR))
            PrintMessage(" WPTR=")
            PrintNumber(GPU_Rd32(gpu_dbg, SIReg.CP_RB0_WPTR))
            PrintMessage("\n")
        }
        IfCondition EqualTo(rid_dbg, 1) ThenBlock: {
            PrintMessage("[PM4:DBG] CP_RB1: CNTL=0x")
            PrintHex(GPU_Rd32(gpu_dbg, SIReg.CP_RB1_CNTL))
            PrintMessage(" BASE=0x")
            PrintHex(GPU_Rd32(gpu_dbg, SIReg.CP_RB1_BASE))
            PrintMessage(" RPTR=")
            PrintNumber(GPU_Rd32(gpu_dbg, SIReg.CP_RB1_RPTR))
            PrintMessage(" WPTR=")
            PrintNumber(GPU_Rd32(gpu_dbg, SIReg.CP_RB1_WPTR))
            PrintMessage("\n")
        }
        IfCondition EqualTo(rid_dbg, 2) ThenBlock: {
            PrintMessage("[PM4:DBG] CP_RB2: CNTL=0x")
            PrintHex(GPU_Rd32(gpu_dbg, SIReg.CP_RB2_CNTL))
            PrintMessage(" BASE=0x")
            PrintHex(GPU_Rd32(gpu_dbg, SIReg.CP_RB2_BASE))
            PrintMessage(" RPTR=")
            PrintNumber(GPU_Rd32(gpu_dbg, SIReg.CP_RB2_RPTR))
            PrintMessage(" WPTR=")
            PrintNumber(GPU_Rd32(gpu_dbg, SIReg.CP_RB2_WPTR))
            PrintMessage("\n")
        }

        // Compute/wavefront status — is a wavefront launched and stuck?
        PrintMessage("[PM4:DBG] SRBM_STATUS=0x")
        PrintHex(GPU_Rd32(gpu_dbg, SIReg.SRBM_STATUS))
        PrintMessage(" SRBM_STATUS2=0x")
        PrintHex(GPU_Rd32(gpu_dbg, SIReg.SRBM_STATUS2))
        PrintMessage("\n")
        PrintMessage("[PM4:DBG] CP_STALLED_STAT1=0x")
        PrintHex(GPU_Rd32(gpu_dbg, SIReg.CP_STALLED_STAT1))
        PrintMessage(" STAT2=0x")
        PrintHex(GPU_Rd32(gpu_dbg, SIReg.CP_STALLED_STAT2))
        PrintMessage(" STAT3=0x")
        PrintHex(GPU_Rd32(gpu_dbg, SIReg.CP_STALLED_STAT3))
        PrintMessage("\n")
        PrintMessage("[PM4:DBG] CP_BUSY_STAT=0x")
        PrintHex(GPU_Rd32(gpu_dbg, SIReg.CP_BUSY_STAT))
        PrintMessage(" SPI_DEBUG_BUSY=0x")
        PrintHex(GPU_Rd32(gpu_dbg, SIReg.SPI_DEBUG_BUSY))
        PrintMessage(" SQ_DEBUG_STS_GLOBAL=0x")
        PrintHex(GPU_Rd32(gpu_dbg, SIReg.SQ_DEBUG_STS_GLOBAL))
        PrintMessage("\n")

        // Also print ring 0 for cross-reference
        IfCondition NotEqual(rid_dbg, 0) ThenBlock: {
            PrintMessage("[PM4:DBG] (xref) CP_RB0: RPTR=")
            PrintNumber(GPU_Rd32(gpu_dbg, SIReg.CP_RB0_RPTR))
            PrintMessage(" WPTR=")
            PrintNumber(GPU_Rd32(gpu_dbg, SIReg.CP_RB0_WPTR))
            PrintMessage("\n")
        }
        ReturnValue(0)
    }
}

// =============================================================================
// PM4_ResetRing — reset a ring's RPTR/WPTR to 0, clearing ME dispatch tracking
//
// Call this on a FULLY IDLE ring (all dispatches completed, RPTR == WPTR).
// Resets the hardware pointers and software state so the ME's per-ring
// dispatch tracking FIFO starts fresh.  Does NOT halt the CP.
//
// The SI ME tracks ~25 outstanding dispatches per ring.  CS_PARTIAL_FLUSH
// and EVENT_WRITE_EOP do NOT free these slots.  The only known way to
// reclaim them is to reset the ring pointers.
// =============================================================================
Function.PM4_ResetRing {
    Input: ring_idx: Integer
    Output: Integer
    Body: {
        ring = PM4_GetRing(ring_idx)
        IfCondition EqualTo(ring, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Dereference(Add(ring, RingField.INITIALIZED)), 0) ThenBlock: {
            ReturnValue(0)
        }

        gpu = Dereference(Add(ring, RingField.GPU_INDEX))
        rid = Dereference(Add(ring, RingField.RING_ID))

        // --- Phase 1: Wait for ring to go fully idle ---
        PM4_EmitNOP(ring_idx, 1)
        PM4_Commit(ring_idx)
        rc = PM4_WaitIdle(ring_idx)

        // --- Phase 2: Halt CP ---
        PM4_HaltCP(gpu)

        // --- Phase 3: Full ring reconfiguration (GART-backed) ---
        // Reconfigure all 3 rings after CP halt. Rings are in GART now.
        rst_r = 0
        WhileLoop LessThan(rst_r, 3) {
            rst_ring = PM4_GetRing(rst_r)
            IfCondition NotEqual(rst_ring, 0) ThenBlock: {
                IfCondition NotEqual(Dereference(Add(rst_ring, RingField.INITIALIZED)), 0) ThenBlock: {
                    // Zero ring buffer via host pointer (GART system RAM)
                    rst_host = Dereference(Add(rst_ring, RingField.HOST_PTR))
                    IfCondition NotEqual(rst_host, 0) ThenBlock: {
                        MemorySet(rst_host, 0, RingConf.RING_SIZE_BYTES)
                    }

                    // Zero RPTR writeback via host pointer
                    rst_wb_host = Dereference(Add(rst_ring, RingField.WB_HOST_PTR))
                    IfCondition NotEqual(rst_wb_host, 0) ThenBlock: {
                        MemorySet(rst_wb_host, 0, 256)
                    }

                    // Zero fence writeback in VRAM (fence still lives in VRAM)
                    rst_fo = Dereference(Add(rst_ring, RingField.FENCE_WB_OFF))
                    GPU_VramWr32(gpu, rst_fo, 0)

                    // Per-ring CNTL: ring 0 = 0x90B, rings 1/2 = 0x90A
                    IfCondition EqualTo(rst_r, 0) ThenBlock: {
                        rst_cntl = 2315   // 0x90B
                    }
                    IfCondition NotEqual(rst_r, 0) ThenBlock: {
                        rst_cntl = 2314   // 0x90A
                    }

                    // Get GART VA for ring base
                    rst_gart_va = Dereference(Add(rst_ring, RingField.GART_VA))

                    // Compute RPTR WB GART VA from WB page base + ring_idx*256
                    rst_wb_va = BitwiseOr(LeftShift(GARTConf.CPRB_WB_GPU_VA_HI, 32), Add(GARTConf.CPRB_WB_GPU_VA_LO, Multiply(rst_r, 256)))
                    rst_wb_lo = BitwiseAnd(rst_wb_va, 4294967292)
                    rst_wb_hi = BitwiseAnd(RightShift(rst_wb_va, 32), 255)

                    // Select register set and program
                    IfCondition EqualTo(rst_r, 0) ThenBlock: {
                        GPU_Wr32(gpu, SIReg.CP_RB0_CNTL, Add(rst_cntl, CntlBits.RB_RPTR_WR_ENA))
                        GPU_Wr32(gpu, SIReg.CP_RB0_RPTR, 0)
                        GPU_Wr32(gpu, SIReg.CP_RB0_WPTR, 0)
                        GPU_Wr32(gpu, SIReg.CP_RB0_RPTR_ADDR, rst_wb_lo)
                        GPU_Wr32(gpu, SIReg.CP_RB0_RPTR_ADDR_HI, rst_wb_hi)
                        GPU_Wr32(gpu, SIReg.CP_RB0_CNTL, rst_cntl)
                        GPU_Wr32(gpu, SIReg.CP_RB0_BASE, Divide(rst_gart_va, 256))
                    }
                    IfCondition EqualTo(rst_r, 1) ThenBlock: {
                        GPU_Wr32(gpu, SIReg.CP_RB1_CNTL, Add(rst_cntl, CntlBits.RB_RPTR_WR_ENA))
                        GPU_Wr32(gpu, SIReg.CP_RB1_RPTR, 0)
                        GPU_Wr32(gpu, SIReg.CP_RB1_WPTR, 0)
                        GPU_Wr32(gpu, SIReg.CP_RB1_RPTR_ADDR, rst_wb_lo)
                        GPU_Wr32(gpu, SIReg.CP_RB1_RPTR_ADDR_HI, rst_wb_hi)
                        GPU_Wr32(gpu, SIReg.CP_RB1_CNTL, rst_cntl)
                        GPU_Wr32(gpu, SIReg.CP_RB1_BASE, Divide(rst_gart_va, 256))
                    }
                    IfCondition EqualTo(rst_r, 2) ThenBlock: {
                        GPU_Wr32(gpu, SIReg.CP_RB2_CNTL, Add(rst_cntl, CntlBits.RB_RPTR_WR_ENA))
                        GPU_Wr32(gpu, SIReg.CP_RB2_RPTR, 0)
                        GPU_Wr32(gpu, SIReg.CP_RB2_WPTR, 0)
                        GPU_Wr32(gpu, SIReg.CP_RB2_RPTR_ADDR, rst_wb_lo)
                        GPU_Wr32(gpu, SIReg.CP_RB2_RPTR_ADDR_HI, rst_wb_hi)
                        GPU_Wr32(gpu, SIReg.CP_RB2_CNTL, rst_cntl)
                        GPU_Wr32(gpu, SIReg.CP_RB2_BASE, Divide(rst_gart_va, 256))
                    }

                    // Reset software state
                    StoreValue(Add(rst_ring, RingField.WPTR), 0)
                    StoreValue(Add(rst_ring, RingField.FENCE_VAL), 0)
                }
            }
            rst_r = Add(rst_r, 1)
        }

        // --- Phase 4: Full CPStart (unhalt + ME_INIT + SET_BASE + CLEAR_STATE) ---
        PM4_CPStart(gpu, 0)

        // --- Phase 5: Warm-up SURFACE_SYNC + ring test NOP ---
        PM4_EmitSurfaceSync(0, 671088640, 4294967295, 0, 10)   // SH I$/K$ inval
        PM4_EmitNOP(0, 1)
        PM4_Commit(0)
        rc = PM4_WaitIdle(0)

        ReturnValue(1)
    }
}

// =============================================================================
// PM4 PACKET BUILDERS
// =============================================================================

// -----------------------------------------------------------------------------
// PM4_BuildHeader — build a PM4 Type 3 packet header
//   opcode: PM4 opcode (e.g. PM4.OP_SET_SH_REG)
//   count:  number of DWORDs following the header (body count)
//   shader_type: 0 for GFX, PM4.SHADER_TYPE_COMPUTE for compute
// Returns the 32-bit header DWORD.
// -----------------------------------------------------------------------------
Function.PM4_BuildHeader {
    Input: opcode: Integer
    Input: count: Integer
    Input: shader_type: Integer
    Output: Integer
    Body: {
        // header = (3 << 30) | ((count - 1) << 16) | (opcode << 8) | shader_type
        hdr = Add(Multiply(3, 1073741824), 0)   // 3 << 30 = 0xC0000000
        hdr = Add(hdr, Multiply(Subtract(count, 1), 65536))   // (count-1) << 16
        hdr = Add(hdr, Multiply(opcode, 256))                  // opcode << 8
        hdr = Add(hdr, shader_type)
        ReturnValue(hdr)
    }
}

// -----------------------------------------------------------------------------
// PM4_EmitNOP — emit a NOP packet (useful for padding/alignment)
//   ndwords: number of NOP DWORDs (including header)
// -----------------------------------------------------------------------------
Function.PM4_EmitNOP {
    Input: ring_idx: Integer
    Input: ndwords: Integer
    Body: {
        IfCondition LessThan(ndwords, 2) ThenBlock: {
            // Type 2 NOP: single DWORD, all zeros except type field
            // Type 2 header: (2 << 30) = 0x80000000
            PM4_EmitDWord(ring_idx, 2147483648)
            ReturnValue(0)
        }

        // Type 3 NOP: header + (ndwords-1) padding DWORDs
        hdr = PM4_BuildHeader(PM4.OP_NOP, Subtract(ndwords, 1), 0)
        PM4_EmitDWord(ring_idx, hdr)

        i = 1
        WhileLoop LessThan(i, ndwords) {
            PM4_EmitDWord(ring_idx, 0)
            i = Add(i, 1)
        }
    }
}

// -----------------------------------------------------------------------------
// PM4_EmitSetSHReg — emit a SET_SH_REG packet to write shader registers
//   reg_byte_offset: byte offset of the target register (e.g. SICompute.PGM_LO)
//   value: 32-bit value to write
//   shader_type: 0 or PM4.SHADER_TYPE_COMPUTE
// -----------------------------------------------------------------------------
Function.PM4_EmitSetSHReg {
    Input: ring_idx: Integer
    Input: reg_byte_offset: Integer
    Input: value: Integer
    Input: shader_type: Integer
    Body: {
        // Convert byte offset to DWORD offset, subtract SH_REG_BASE
        reg_dword = Divide(reg_byte_offset, 4)
        sh_offset = Subtract(reg_dword, PM4.SH_REG_BASE)

        // SET_SH_REG packet: header + offset + value = 3 DWORDs total
        hdr = PM4_BuildHeader(PM4.OP_SET_SH_REG, 2, shader_type)
        PM4_EmitDWord(ring_idx, hdr)
        PM4_EmitDWord(ring_idx, sh_offset)
        PM4_EmitDWord(ring_idx, value)
    }
}

// -----------------------------------------------------------------------------
// PM4_EmitSetSHRegPair — write two consecutive SH registers
//   reg_byte_offset: byte offset of the first register
//   val_lo, val_hi: values for first and second register
// -----------------------------------------------------------------------------
Function.PM4_EmitSetSHRegPair {
    Input: ring_idx: Integer
    Input: reg_byte_offset: Integer
    Input: val_lo: Integer
    Input: val_hi: Integer
    Input: shader_type: Integer
    Body: {
        reg_dword = Divide(reg_byte_offset, 4)
        sh_offset = Subtract(reg_dword, PM4.SH_REG_BASE)

        // SET_SH_REG packet: header + offset + val_lo + val_hi = 4 DWORDs
        hdr = PM4_BuildHeader(PM4.OP_SET_SH_REG, 3, shader_type)
        PM4_EmitDWord(ring_idx, hdr)
        PM4_EmitDWord(ring_idx, sh_offset)
        PM4_EmitDWord(ring_idx, val_lo)
        PM4_EmitDWord(ring_idx, val_hi)
    }
}

// -----------------------------------------------------------------------------
// PM4_EmitSetConfigReg — emit a SET_CONFIG_REG packet
//   reg_byte_offset: byte offset of the config register (e.g. 0x85E8)
//   value: 32-bit value to write
// -----------------------------------------------------------------------------
Function.PM4_EmitSetConfigReg {
    Input: ring_idx: Integer
    Input: reg_byte_offset: Integer
    Input: value: Integer
    Body: {
        reg_dword = Divide(reg_byte_offset, 4)
        cfg_offset = Subtract(reg_dword, PM4.CONFIG_REG_BASE)

        hdr = PM4_BuildHeader(PM4.OP_SET_CONFIG_REG, 2, 0)
        PM4_EmitDWord(ring_idx, hdr)
        PM4_EmitDWord(ring_idx, cfg_offset)
        PM4_EmitDWord(ring_idx, value)
    }
}

// -----------------------------------------------------------------------------
// PM4_EmitSurfaceSync — emit a SURFACE_SYNC packet to invalidate caches
//   coher_cntl: cache invalidation flags (e.g. PM4.SH_ICACHE_ACTION_ENA)
//   size: address range size in 256-byte blocks (0xFFFFFFFF = all)
//   base: base address in 256-byte blocks (0 = all)
//   poll_interval: poll interval (10 typical)
//
// Must be emitted before compute dispatch so the shader fetches
// fresh instructions and data from VRAM after CPU BAR writes.
// The kernel (si.c) emits this before every IB with:
//   TCL1_ACTION_ENA | TC_ACTION_ENA | SH_KCACHE_ACTION_ENA | SH_ICACHE_ACTION_ENA
// -----------------------------------------------------------------------------
Function.PM4_EmitSurfaceSync {
    Input: ring_idx: Integer
    Input: coher_cntl: Integer
    Input: size: Integer
    Input: base: Integer
    Input: poll_interval: Integer
    Body: {
        // SURFACE_SYNC: header + coher_cntl + size + base + poll = 5 DWORDs
        hdr = PM4_BuildHeader(PM4.OP_SURFACE_SYNC, 4, 0)
        PM4_EmitDWord(ring_idx, hdr)
        PM4_EmitDWord(ring_idx, coher_cntl)
        PM4_EmitDWord(ring_idx, size)
        PM4_EmitDWord(ring_idx, base)
        PM4_EmitDWord(ring_idx, poll_interval)
    }
}

// -----------------------------------------------------------------------------
// PM4_EmitDispatchDirect — emit a DISPATCH_DIRECT packet
//   dim_x, dim_y, dim_z: thread group counts
//   initiator: dispatch initiator flags (1 = COMPUTE_SHADER_EN)
//
// GCN DISPATCH_DIRECT format (5 DWORDs total):
//   header:    type3 | opcode=0x15 | count=3 (4 body DWORDs)
//   DWORD 1:   dim_x
//   DWORD 2:   dim_y
//   DWORD 3:   dim_z
//   DWORD 4:   dispatch_initiator
// -----------------------------------------------------------------------------
Function.PM4_EmitDispatchDirect {
    Input: ring_idx: Integer
    Input: dim_x: Integer
    Input: dim_y: Integer
    Input: dim_z: Integer
    Input: initiator: Integer
    Body: {
        // DISPATCH_DIRECT: 4 body DWORDs — each dimension is a separate DWORD.
        // Kernel: PACKET3(PACKET3_DISPATCH_DIRECT, 3) → count=4 body DWORDs
        //   DIM_X, DIM_Y, DIM_Z, DISPATCH_INITIATOR
        hdr = PM4_BuildHeader(PM4.OP_DISPATCH_DIRECT, 4, PM4.SHADER_TYPE_COMPUTE)
        PM4_EmitDWord(ring_idx, hdr)
        PM4_EmitDWord(ring_idx, dim_x)
        PM4_EmitDWord(ring_idx, dim_y)
        PM4_EmitDWord(ring_idx, dim_z)
        PM4_EmitDWord(ring_idx, initiator)
    }
}

// -----------------------------------------------------------------------------
// PM4_EmitWriteDataVRAM — emit a WRITE_DATA packet that writes a single DWORD
//   directly to VRAM (DST_SEL=5 = memory async/direct, WR_CONFIRM=1).
//   Used for fence writeback — CPU polls with GPU_VramRd32.
// -----------------------------------------------------------------------------
Function.PM4_EmitWriteDataVRAM {
    Input: ring_idx: Integer
    Input: vram_off: Integer
    Input: value: Integer
    Body: {
        gpu_addr = PM4_VramToGPU(vram_off)
        addr_lo  = BitwiseAnd(gpu_addr, 4294967292)
        addr_hi  = BitwiseAnd(RightShift(gpu_addr, 32), 255)

        // header: WRITE_DATA, 4 body dwords, shader_type=0
        hdr = PM4_BuildHeader(PM4.OP_WRITE_DATA, 4, 0)
        PM4_EmitDWord(ring_idx, hdr)

        // control: DST_SEL=5 (memory async direct) = 5<<8 = 1280
        //          WR_CONFIRM=1 (bit 20) = 1048576
        //          ENGINE_SEL=0 (ME)
        control = Add(1280, 1048576)
        PM4_EmitDWord(ring_idx, control)
        PM4_EmitDWord(ring_idx, addr_lo)
        PM4_EmitDWord(ring_idx, addr_hi)
        PM4_EmitDWord(ring_idx, value)
    }
}

// -----------------------------------------------------------------------------
// PM4_EmitWriteDataReg — emit a WRITE_DATA packet targeting an MMIO register.
//   The GPU's ME writes the value to the register (DST_SEL=0).
//   Used for GPU-side HDP read-cache invalidation (write back HDP_HOST_PATH_CNTL)
//   which deadlocks when done from the CPU side post-dispatch.
//   reg_offset: byte offset of the register (e.g. 11264 for HDP_HOST_PATH_CNTL)
//   value: DWORD value to write
// -----------------------------------------------------------------------------
Function.PM4_EmitWriteDataReg {
    Input: ring_idx: Integer
    Input: reg_offset: Integer
    Input: value: Integer
    Body: {
        // header: WRITE_DATA, 4 body dwords, shader_type=0
        hdr = PM4_BuildHeader(PM4.OP_WRITE_DATA, 4, 0)
        PM4_EmitDWord(ring_idx, hdr)

        // control: DST_SEL=0 (register) = 0<<8 = 0
        //          WR_CONFIRM=1 (bit 20) = 1048576
        //          ENGINE_SEL=1 (PFP) — kernel si.c uses PFP for HDP register
        //          writes via WRITE_DATA; ME (0) may not reach HDP registers.
        control = Add(1048576, 1073741824)
        PM4_EmitDWord(ring_idx, control)

        // Register DWORD address (byte offset >> 2)
        PM4_EmitDWord(ring_idx, Divide(reg_offset, 4))
        PM4_EmitDWord(ring_idx, 0)
        PM4_EmitDWord(ring_idx, value)
    }
}

// -----------------------------------------------------------------------------
// PM4_EmitEventWriteEOP — emit an EVENT_WRITE_EOP for fence/completion
//   addr_lo, addr_hi: GPU address for fence writeback (VRAM offset)
//   value: fence value to write
// -----------------------------------------------------------------------------
Function.PM4_EmitEventWriteEOP {
    Input: ring_idx: Integer
    Input: addr_lo: Integer
    Input: addr_hi: Integer
    Input: value: Integer
    Body: {
        // EVENT_WRITE_EOP: header + event_type + addr_lo + addr_hi + data_lo + data_hi
        // data_sel: 1 = send 32-bit data, addr in bytes
        // shader_type=0: the kernel sends EVENT_WRITE_EOP without SHADER_TYPE bit
        hdr = PM4_BuildHeader(PM4.OP_EVENT_WRITE_EOP, 5, 0)
        PM4_EmitDWord(ring_idx, hdr)

        // Event type: CACHE_FLUSH_AND_INV_TS_EVENT = 0x14 (20)
        // Flushes GPU L2 cache and invalidates, then signals fence.
        // Must use this (not BOTTOM_OF_PIPE_TS=0x28) so CPU reads
        // see compute shader writes that went through TC/L2.
        // event_index = 5 (EOP timestamp/fence style)
        event = Add(20, Multiply(5, 256))   // 0x14 | (5 << 8) = 0x514
        PM4_EmitDWord(ring_idx, event)

        // Address low (byte address)
        PM4_EmitDWord(ring_idx, addr_lo)

        // Address high + DATA_SEL + INT_SEL
        // DATA_SEL=1 (32-bit imm) at bits [31:29]: 1 << 29 = 536870912
        // INT_SEL=3 (send data after write confirmation, no interrupt):
        //   3 << 24 = 50331648
        // Mesa/Vulkan use INT_SEL=3 (EOP_INT_SEL_SEND_DATA_AFTER_WR_CONFIRM)
        // for fence writes.  INT_SEL=2 generates IH interrupts which may
        // exhaust internal event engine slots after ~36 dispatches on SI.
        // INT_SEL=3 ensures the L2 flush completes and fence is visible
        // in VRAM without allocating interrupt delivery resources.
        data_sel_bits = 536870912    // 1 << 29 = DATA_SEL(1)
        int_sel_bits = 50331648      // 3 << 24 = INT_SEL(3)
        PM4_EmitDWord(ring_idx, Add(addr_hi, Add(data_sel_bits, int_sel_bits)))

        // Data value low
        PM4_EmitDWord(ring_idx, value)

        // Data value high (0 for 32-bit write)
        PM4_EmitDWord(ring_idx, 0)
    }
}

// -----------------------------------------------------------------------------
// PM4_EmitWaitRegMem — emit WAIT_REG_MEM to poll a memory/register location
//   mem_or_reg: 0 = register, 1 = memory
//   addr: address to poll (byte offset for reg, GPU addr for mem)
//   ref_val: reference value
//   mask: mask applied before compare
//   func: compare function (3 = equal, 5 = >=)
// -----------------------------------------------------------------------------
Function.PM4_EmitWaitRegMem {
    Input: ring_idx: Integer
    Input: mem_or_reg: Integer
    Input: addr: Integer
    Input: ref_val: Integer
    Input: mask: Integer
    Input: func: Integer
    Body: {
        // WAIT_REG_MEM: header + engine_sel|func|mem_space + addr_lo + addr_hi + ref + mask + poll_interval
        hdr = PM4_BuildHeader(PM4.OP_WAIT_REG_MEM, 6, PM4.SHADER_TYPE_COMPUTE)
        PM4_EmitDWord(ring_idx, hdr)

        // DWORD1: function(bits [2:0]) | mem_space(bit 4) | engine(bit 8, 0=ME)
        dw1 = Add(func, Multiply(mem_or_reg, 16))
        PM4_EmitDWord(ring_idx, dw1)

        // Address lo/hi
        PM4_EmitDWord(ring_idx, addr)
        PM4_EmitDWord(ring_idx, 0)

        // Reference value
        PM4_EmitDWord(ring_idx, ref_val)

        // Mask
        PM4_EmitDWord(ring_idx, mask)

        // Poll interval (in 16-clock units)
        PM4_EmitDWord(ring_idx, 10)
    }
}
