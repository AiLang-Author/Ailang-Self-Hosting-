//
// Library.AMDGPUPM4Regs.ailang
//
// Hardware register definitions and bit constants for AMD GCN 1.0 (Southern Islands).
// Split from Library.AMDGPUPM4.ailang for maintainability.
//
// USAGE
//   LibraryImport.Drivers.AMDGPU.AMDGPUPM4Regs
// =============================================================================
// SOUTHERN ISLANDS CP RING BUFFER REGISTERS (byte offsets into MMIO BAR)
// =============================================================================
FixedPool.SIReg {
    // GRBM
    "GRBM_CNTL":            Initialize=32768      // 0x8000 — GRBM_READ_TIMEOUT in bits [7:0]
    "GRBM_STATUS":          Initialize=32784      // 0x8010
    "GRBM_SOFT_RESET":      Initialize=32800      // 0x8020
    "GRBM_GFX_INDEX":       Initialize=32812      // 0x802C

    // CP Ring 0 (GFX/Compute)
    "CP_RB0_CNTL":          Initialize=49412      // 0xC104
    "CP_RB0_BASE":          Initialize=49408      // 0xC100
    "CP_RB0_BASE_HI":       Initialize=0          // not used on SI (32-bit GPU addr)
    "CP_RB0_RPTR":          Initialize=34560      // 0x8700  (read from HW)
    "CP_RB0_RPTR_ADDR":     Initialize=49420      // 0xC10C
    "CP_RB0_RPTR_ADDR_HI":  Initialize=49424      // 0xC110
    "CP_RB0_WPTR":          Initialize=49428      // 0xC114

    // CP Ring 1 (Compute)
    "CP_RB1_CNTL":          Initialize=49540      // 0xC184
    "CP_RB1_BASE":          Initialize=49536      // 0xC180
    "CP_RB1_RPTR":          Initialize=34556      // 0x86FC  (read from HW)
    "CP_RB1_RPTR_ADDR":     Initialize=49544      // 0xC188
    "CP_RB1_RPTR_ADDR_HI":  Initialize=49548      // 0xC18C
    "CP_RB1_WPTR":          Initialize=49552      // 0xC190

    // CP Ring 2 (Compute)
    "CP_RB2_CNTL":          Initialize=49560      // 0xC198
    "CP_RB2_BASE":          Initialize=49556      // 0xC194
    "CP_RB2_RPTR":          Initialize=34552      // 0x86F8  (read from HW)
    "CP_RB2_RPTR_ADDR":     Initialize=49564      // 0xC19C
    "CP_RB2_RPTR_ADDR_HI":  Initialize=49568      // 0xC1A0
    "CP_RB2_WPTR":          Initialize=49572      // 0xC1A4

    // CP Control
    "CP_ME_CNTL":           Initialize=34520      // 0x86D8
    "CP_RB_WPTR_DELAY":     Initialize=34564      // 0x8704
    "CP_INT_CNTL_RING0":    Initialize=49576      // 0xC1A8

    // CP Misc (required for firmware startup)
    "CP_SEM_WAIT_TIMER":    Initialize=34236      // 0x85BC
    "CP_SEM_INCOMPLETE_TIMER": Initialize=34248   // 0x85C8
    "CP_MAX_CONTEXT":       Initialize=34464      // 0x86A0
    "CP_ENDIAN_SWAP":       Initialize=34512      // 0x86D0
    "CP_DEVICE_ID":         Initialize=34516      // 0x86D4
    "CP_DEBUG":             Initialize=49660      // 0xC1FC

    // Scratch registers
    "SCRATCH_REG0":         Initialize=34048      // 0x8500
    "SCRATCH_REG1":         Initialize=34052      // 0x8504
    "SCRATCH_REG2":         Initialize=34056      // 0x8508
    "SCRATCH_REG3":         Initialize=34060      // 0x850C
    "SCRATCH_REG4":         Initialize=34064      // 0x8510
    "SCRATCH_REG5":         Initialize=34068      // 0x8514
    "SCRATCH_REG6":         Initialize=34072      // 0x8518
    "SCRATCH_REG7":         Initialize=34076      // 0x851C
    "SCRATCH_UMSK":         Initialize=34112      // 0x8540
    "SCRATCH_ADDR":         Initialize=34116      // 0x8544

    // Memory Controller
    "MC_VM_FB_LOCATION":    Initialize=8228       // 0x2024
    "MC_VM_SYSTEM_APERTURE_LOW_ADDR":  Initialize=8244   // 0x2034
    "MC_VM_SYSTEM_APERTURE_HIGH_ADDR": Initialize=8248   // 0x2038
    "MC_VM_SYSTEM_APERTURE_DEFAULT_ADDR": Initialize=8252 // 0x203C

    // VM Context (VMID 0)
    "VM_CONTEXT0_CNTL":               Initialize=5136    // 0x1410
    "VM_CONTEXT0_PAGE_TABLE_BASE_ADDR": Initialize=5436  // 0x153C
    "VM_CONTEXT0_PAGE_TABLE_START_ADDR": Initialize=5452 // 0x154C
    "VM_CONTEXT0_PAGE_TABLE_END_ADDR":  Initialize=5468  // 0x155C
    "VM_L2_CNTL":                     Initialize=5120    // 0x1400
    "VM_L2_CNTL2":                    Initialize=5124    // 0x1404
    "VM_L2_CNTL3":                    Initialize=5128    // 0x1408
    "VM_INVALIDATE_REQUEST":          Initialize=5240    // 0x1478
    "VM_INVALIDATE_RESPONSE":         Initialize=5244    // 0x147C

    // MC VM L1 TLB — controls address routing (aperture check, PA mode, etc.)
    "MC_VM_MX_L1_TLB_CNTL":          Initialize=8292    // 0x2064

    // RLC (Run List Controller)
    "RLC_CNTL":             Initialize=49920      // 0xC300
    "RLC_RL_BASE":          Initialize=49924      // 0xC304
    "RLC_RL_SIZE":          Initialize=49928      // 0xC308
    "RLC_LB_CNTL":          Initialize=49932      // 0xC30C
    "RLC_SAVE_AND_RESTORE_BASE": Initialize=49936 // 0xC310
    "RLC_LB_CNTR_MAX":      Initialize=49940      // 0xC314
    "RLC_LB_CNTR_INIT":     Initialize=49944      // 0xC318
    "RLC_CLEAR_STATE_RESTORE_BASE": Initialize=49952 // 0xC320
    "RLC_UCODE_ADDR":       Initialize=49964      // 0xC32C
    "RLC_UCODE_DATA":       Initialize=49968      // 0xC330
    "RLC_MC_CNTL":          Initialize=50004      // 0xC344
    "RLC_UCODE_CNTL":       Initialize=50008      // 0xC348
    "RLC_LB_INIT_CU_MASK":  Initialize=50204      // 0xC41C

    // Clock Gating — must be disabled for bare-metal compute without RLC firmware
    "RLC_CGTT_MGCG_OVERRIDE": Initialize=50176    // 0xC400 — MGCG per-block override
    "RLC_CGCG_CGLS_CTRL":     Initialize=50180    // 0xC404 — bit0=CGCG_EN bit1=CGLS_EN
    "CGTS_SM_CTRL_REG":       Initialize=37200    // 0x9150 — CGTS state machine control

    // SPLL (System/Engine PLL) — controls SCLK frequency
    // Direct MMIO programming when no SMC firmware is present.
    "CG_SPLL_FUNC_CNTL":       Initialize=1536    // 0x0600
    "CG_SPLL_FUNC_CNTL_2":     Initialize=1540    // 0x0604
    "CG_SPLL_FUNC_CNTL_3":     Initialize=1544    // 0x0608
    "CG_SPLL_FUNC_CNTL_4":     Initialize=1548    // 0x060C
    "SPLL_STATUS":              Initialize=1556    // 0x0614
    "SPLL_CNTL_MODE":          Initialize=1560    // 0x0618
    "CG_SPLL_SPREAD_SPECTRUM":  Initialize=1568    // 0x0620
    "CG_SPLL_SPREAD_SPECTRUM_2": Initialize=1572   // 0x0624

    // MPLL (Memory PLL) — controls MCLK frequency
    "MPLL_FUNC_CNTL":          Initialize=11188   // 0x2BB4
    "MPLL_FUNC_CNTL_1":        Initialize=11192   // 0x2BB8
    "MPLL_FUNC_CNTL_2":        Initialize=11196   // 0x2BBC
    "MPLL_AD_FUNC_CNTL":       Initialize=11200   // 0x2BC0
    "MPLL_DQ_FUNC_CNTL":       Initialize=11204   // 0x2BC4
    "MCLK_PWRMGT_CNTL":        Initialize=11168   // 0x2BA0
    "DLL_CNTL":                Initialize=11172   // 0x2BA4
    "MPLL_SS1":                Initialize=11212   // 0x2BCC
    "MPLL_SS2":                Initialize=11216   // 0x2BD0

    // SRBM (System Register Bus Manager)
    "SRBM_STATUS":          Initialize=3664       // 0x0E50
    "SRBM_SOFT_RESET":      Initialize=3680       // 0x0E60
    "SRBM_STATUS2":         Initialize=3700       // 0x0E74

    // MC / Display / Bus Interface (needed for safe GPU reset sequence)
    // GPU reset REQUIRES MC blackout + BAR fence before writing GRBM/SRBM
    // soft reset registers. Without this the bus deadlocks → system lockup.
    "VGA_RENDER_CONTROL":      Initialize=768      // 0x0300
    "BIF_FB_EN":               Initialize=21648    // 0x5490
    "MC_SHARED_BLACKOUT_CNTL": Initialize=8364     // 0x20AC

    // CP Microcode/Firmware
    "CP_PFP_UCODE_ADDR":   Initialize=49488      // 0xC150
    "CP_PFP_UCODE_DATA":   Initialize=49492      // 0xC154
    "CP_ME_RAM_WADDR":      Initialize=49500      // 0xC15C
    "CP_ME_RAM_DATA":       Initialize=49504      // 0xC160
    "CP_CE_UCODE_ADDR":    Initialize=49512      // 0xC168
    "CP_CE_UCODE_DATA":    Initialize=49516      // 0xC16C

    // SPI (Shader Processor Input) — controls wavefront dispatch to CUs
    // These are CONFIG registers that GRBM_SOFT_RESET clears.
    // Must be reprogrammed after reset (kernel does si_init_golden_registers).
    "SPI_CONFIG_CNTL":       Initialize=37120     // 0x9100
    "SPI_CONFIG_CNTL_1":     Initialize=37180     // 0x913C

    // SPI thread management -- per-SE/SH CU enable for wavefront dispatch
    // Must be programmed via GRBM_GFX_INDEX targeting each (SE,SH) pair.
    // If CUs are masked out here, no compute wavefronts will launch.
    "SPI_STATIC_THREAD_MGMT_3": Initialize=37096  // 0x90E8

    // GRBM_GFX_INDEX -- selects which SE/SH/instance gets MMIO register writes
    "GRBM_GFX_INDEX":       Initialize=32812     // 0x802C

    // CP queue thresholds -- partition ROQ and MEQ for dispatch processing
    "CP_QUEUE_THRESHOLDS":   Initialize=34656     // 0x8760
    "CP_MEQ_THRESHOLDS":     Initialize=34660     // 0x8764

    // Shader queue and memory addressing
    "SQ_CONFIG":             Initialize=35840     // 0x8C00
    "GB_ADDR_CONFIG":        Initialize=39160     // 0x98F8
    "DMIF_ADDR_CONFIG":      Initialize=3028      // 0x0BD4
    "DMIF_ADDR_CALC":        Initialize=3072      // 0x0C00
    "HDP_ADDR_CONFIG":       Initialize=12104     // 0x2F48
    "HDP_MEM_COHERENCY_FLUSH_CNTL": Initialize=21632 // 0x5480
    "HDP_HOST_PATH_CNTL":    Initialize=11264     // 0x2C00
    "HDP_MISC_CNTL":         Initialize=12108     // 0x2F4C
    "HDP_NONSURFACE_BASE":   Initialize=11268     // 0x2C04
    "HDP_NONSURFACE_INFO":   Initialize=11272     // 0x2C08
    "HDP_NONSURFACE_SIZE":   Initialize=11276     // 0x2C0C
    "DMA_TILING_CONFIG":     Initialize=53432     // 0xD0B8 (DMA0 offset)
    "CP_PERFMON_CNTL":       Initialize=34812     // 0x87FC

    // Shader memory config (per-VMID, selected via SRBM_GFX_CNTL)
    // From sid.h — kernel programs these in si_init_compute() for each VMID
    "SH_MEM_BASES":          Initialize=35880     // 0x8C28
    "SH_MEM_APE1_BASE":      Initialize=35884     // 0x8C2C
    "SH_MEM_APE1_LIMIT":     Initialize=35888     // 0x8C30
    "SH_MEM_CONFIG":         Initialize=35892     // 0x8C34

    // SRBM context select — bits: VMID[3:0], QUEUEID[7:4], MEID[9:8], PIPEID[11:10]
    // Writing this register selects which VMID context SH_MEM_* writes target
    "SRBM_GFX_CNTL":        Initialize=3652      // 0x0E44

    // CU active mask -- read-only, used to detect disabled CUs
    "CC_GC_SHADER_ARRAY_CONFIG": Initialize=35260 // 0x89BC

    // === HANG DIAGNOSTIC REGISTERS ===
    // GRBM extended status (may return 0 if GRBM routing is dead)
    "GRBM_STATUS2":         Initialize=32788      // 0x8014
    "GRBM_STATUS_SE0":      Initialize=32788      // 0x8014 (same as STATUS2 on SI)
    "GRBM_STATUS_SE1":      Initialize=32792      // 0x8018

    // CP stall diagnostics — shows exactly what is blocking the CP
    "CP_STALLED_STAT1":     Initialize=34420      // 0x8674
    "CP_STALLED_STAT2":     Initialize=34424      // 0x8678
    "CP_STALLED_STAT3":     Initialize=34428      // 0x867C
    "CP_BUSY_STAT":         Initialize=34432      // 0x8680
    "CP_STAT":              Initialize=34436      // 0x8684

    // CP interrupt / error status
    "CP_INT_STATUS_RING0":  Initialize=49588      // 0xC1B4

    // SPI debug (shader dispatch state)
    "SPI_DEBUG_BUSY":       Initialize=37184      // 0x9140

    // SQ (shader quad) debug
    "SQ_DEBUG_STS_GLOBAL":  Initialize=35848      // 0x8C08

    // Compute dispatch tracking
    "COMPUTE_DISPATCH_ID":  Initialize=47128      // 0xB818

    // Interrupt Handler (IH) ring — required for RLC to drain ME dispatch FIFO
    // Without a live IH ring, EVENT_WRITE_EOP with INT_SEL=2 has nowhere to
    // write the interrupt packet, so the RLC never sees dispatch completions
    // and the ME's ~25-entry tracking FIFO never drains.
    "IH_RB_CNTL":          Initialize=15872       // 0x3E00 — ring size + control
    "IH_RB_BASE":          Initialize=15876       // 0x3E04 — ring base addr (GPU MC >> 8)
    "IH_RB_RPTR":          Initialize=15880       // 0x3E08 — read pointer (entries)
    "IH_RB_WPTR":          Initialize=15884       // 0x3E0C — write pointer (entries)
    "IH_RB_WPTR_ADDR_HI":  Initialize=15888       // 0x3E10 — WPTR writeback addr hi
    "IH_RB_WPTR_ADDR_LO":  Initialize=15892       // 0x3E14 — WPTR writeback addr lo
    "IH_CNTL":             Initialize=15896       // 0x3E18 — IH control

    // Global interrupt routing (BIF block)
    "INTERRUPT_CNTL":      Initialize=21608       // 0x5468 — interrupt routing control
    "INTERRUPT_CNTL2":     Initialize=21612       // 0x546C — IH doorbell / GPU addr for IH

    // CP interrupt control — enable specific interrupt sources per ring
    // CP_INT_CNTL_RING0 already defined above at 0xC1A8
    "CP_INT_CNTL_RING1":   Initialize=49580       // 0xC1AC
    "CP_INT_CNTL_RING2":   Initialize=49584       // 0xC1B0

    // TIME_STAMP_INT_ENABLE = (1 << 26) = 67108864 = 0x04000000
    // Set this bit in CP_INT_CNTL_RINGx to generate an IH interrupt
    // when EVENT_WRITE_EOP with INT_SEL=2 completes its fence write.
}

// =============================================================================
// CP_ME_CNTL BIT DEFINITIONS
// =============================================================================
FixedPool.CPMEBits {
    "CE_HALT":              Initialize=16777216   // 1 << 24
    "PFP_HALT":             Initialize=67108864   // 1 << 26
    "ME_HALT":              Initialize=268435456  // 1 << 28
}

// =============================================================================
// CP_RB_CNTL BIT DEFINITIONS
// =============================================================================
FixedPool.CntlBits {
    // RB_BUFSZ: bits [5:0] — log2(ring_size_in_dwords)
    // RB_BLKSZ: bits [13:8] — log2(page_size / 8)
    "BUF_SWAP_32BIT":      Initialize=131072     // 2 << 16
    "RB_NO_UPDATE":        Initialize=134217728   // 1 << 27
    "RB_RPTR_WR_ENA":      Initialize=2147483648  // 1 << 31
}

// =============================================================================
// GRBM_SOFT_RESET BITS  (from radeon/sid.h — Southern Islands)
// =============================================================================
FixedPool.GRBMResetBits {
    "SOFT_RESET_CP":       Initialize=1           // 1 << 0
    "SOFT_RESET_CB":       Initialize=2           // 1 << 1
    "SOFT_RESET_RLC":      Initialize=4           // 1 << 2
    "SOFT_RESET_DB":       Initialize=8           // 1 << 3
    "SOFT_RESET_GDS":      Initialize=16          // 1 << 4
    "SOFT_RESET_PA":       Initialize=32          // 1 << 5
    "SOFT_RESET_SC":       Initialize=64          // 1 << 6
    "SOFT_RESET_BCI":      Initialize=128         // 1 << 7
    "SOFT_RESET_SPI":      Initialize=256         // 1 << 8
    "SOFT_RESET_SX":       Initialize=1024        // 1 << 10
    "SOFT_RESET_TC":       Initialize=2048        // 1 << 11
    "SOFT_RESET_TA":       Initialize=4096        // 1 << 12
    "SOFT_RESET_VGT":      Initialize=16384       // 1 << 14
    "SOFT_RESET_IA":       Initialize=32768       // 1 << 15
}

// =============================================================================
// SRBM_SOFT_RESET BITS  (from radeon/sid.h — Southern Islands)
// =============================================================================
FixedPool.SRBMResetBits {
    "SOFT_RESET_BIF":      Initialize=2           // 1 << 1   Bus Interface
    "SOFT_RESET_DC":       Initialize=32          // 1 << 5   Display Controller
    "SOFT_RESET_DMA1":     Initialize=64          // 1 << 6   DMA Engine 1
    "SOFT_RESET_GRBM":     Initialize=256         // 1 << 8   Graphics Reg Bus Manager
    "SOFT_RESET_HDP":      Initialize=512         // 1 << 9   Host Data Path
    "SOFT_RESET_IH":       Initialize=1024        // 1 << 10  Interrupt Handler
    "SOFT_RESET_MC":       Initialize=2048        // 1 << 11  Memory Controller
    "SOFT_RESET_ROM":      Initialize=16384       // 1 << 14  ROM
    "SOFT_RESET_SEM":      Initialize=32768       // 1 << 15  Semaphore
    "SOFT_RESET_VMC":      Initialize=131072      // 1 << 17  VM Controller
    "SOFT_RESET_DMA":      Initialize=1048576     // 1 << 20  DMA Engine 0
}

// =============================================================================
// SPLL BIT DEFINITIONS (CG_SPLL_FUNC_CNTL family)
// =============================================================================
FixedPool.SPLLBits {
    // CG_SPLL_FUNC_CNTL (0x600) bit definitions
    "SPLL_RESET":       Initialize=1           // bit 0
    "SPLL_SLEEP":       Initialize=2           // bit 1
    "SPLL_BYPASS_EN":   Initialize=8           // bit 3
    "SPLL_REF_DIV_SHIFT": Initialize=4         // bits [9:4] — ref divider
    "SPLL_REF_DIV_MASK":  Initialize=1008      // 0x3F0 = 63 << 4
    "SPLL_PDIV_A_SHIFT":  Initialize=20        // bits [26:20] — post divider
    "SPLL_PDIV_A_MASK":   Initialize=133169152 // 0x7F00000 = 127 << 20

    // CG_SPLL_FUNC_CNTL_2 (0x604) bit definitions
    "SCLK_MUX_SEL_MASK":  Initialize=511        // 0x1FF = bits [8:0]
    "SPLL_CTLREQ_CHG":    Initialize=8388608    // 1 << 23 — request clock change
    "SCLK_MUX_UPDATE":    Initialize=67108864   // 1 << 26 — mux update trigger

    // CG_SPLL_FUNC_CNTL_3 (0x608) bit definitions
    "SPLL_FB_DIV_MASK":   Initialize=67108863  // 0x3FFFFFF = bits [25:0]
    "SPLL_DITHEN":        Initialize=268435456 // bit 28 — dithering enable

    // SPLL_STATUS (0x614)
    "SPLL_CHG_STATUS":    Initialize=2          // bit 1 — PLL change status (locked)

    // SPLL_CNTL_MODE (0x618) bit definitions
    "SPLL_SW_DIR_CONTROL": Initialize=1         // bit 0 — software direct PLL control
    "SPLL_REFCLK_SEL_MASK": Initialize=201326592  // 0x0C000000 = bits [27:26]
    "SPLL_REFCLK_SEL_SHIFT": Initialize=26        // shift for REFCLK_SEL field

    // CG_SPLL_SPREAD_SPECTRUM (0x620)
    "SSEN":               Initialize=1          // bit 0 — spread spectrum enable
}

// =============================================================================
// COMPUTE DISPATCH REGISTERS (byte offsets)
// These are in the SH (shader) register space: base 0xB000 (DWORD 0x2C00)
// =============================================================================
FixedPool.SICompute {
    "DISPATCH_INITIATOR":   Initialize=47104      // 0xB800
    "DIM_X":                Initialize=47108      // 0xB804
    "DIM_Y":                Initialize=47112      // 0xB808
    "DIM_Z":                Initialize=47116      // 0xB80C
    "START_X":              Initialize=47120      // 0xB810
    "START_Y":              Initialize=47124      // 0xB814
    "START_Z":              Initialize=47128      // 0xB818
    "NUM_THREAD_X":         Initialize=47132      // 0xB81C
    "NUM_THREAD_Y":         Initialize=47136      // 0xB820
    "NUM_THREAD_Z":         Initialize=47140      // 0xB824
    "PGM_LO":               Initialize=47152      // 0xB830
    "PGM_HI":               Initialize=47156      // 0xB834
    "PGM_RSRC1":            Initialize=47176      // 0xB848
    "PGM_RSRC2":            Initialize=47180      // 0xB84C
    "VMID":                 Initialize=47184      // 0xB850
    "RESOURCE_LIMITS":      Initialize=47188      // 0xB854
    "STATIC_THREAD_MGMT_SE0": Initialize=47192    // 0xB858
    "STATIC_THREAD_MGMT_SE1": Initialize=47196    // 0xB85C
    "TMPRING_SIZE":         Initialize=47200      // 0xB860
    "USER_DATA_0":          Initialize=47360      // 0xB900
    "USER_DATA_1":          Initialize=47364      // 0xB904
    "USER_DATA_2":          Initialize=47368      // 0xB908
    "USER_DATA_3":          Initialize=47372      // 0xB90C
}

// =============================================================================
// DCE 6.x DISPLAY ENGINE REGISTERS (Southern Islands / Evergreen-family)
//
// CRTC pipe bases have non-uniform strides:
//   CRTC0→CRTC1: +0x0C00
//   CRTC1→CRTC2: +0x8C00  (large gap)
//   CRTC2→CRTC3: +0x0C00
//   CRTC3→CRTC4: +0x0C00
//   CRTC4→CRTC5: +0x0C00
//
// Per-CRTC registers are at pipe_base + offset.
// Per-pipe graphics (DCP) registers follow the same offset pattern.
//
// Sources: evergreen_reg.h, dce_6_0_d.h (Linux kernel)
// =============================================================================
FixedPool.DCE6Reg {
    // CRTC pipe base addresses (byte offsets into MMIO BAR)
    "CRTC0_BASE":           Initialize=28144      // 0x6DF0
    "CRTC1_BASE":           Initialize=31216      // 0x79F0
    "CRTC2_BASE":           Initialize=67056      // 0x105F0
    "CRTC3_BASE":           Initialize=70128      // 0x111F0
    "CRTC4_BASE":           Initialize=73200      // 0x11DF0
    "CRTC5_BASE":           Initialize=76272      // 0x129F0

    // Per-CRTC register offsets (add to pipe base)
    "CRTC_CONTROL_OFF":     Initialize=128        // 0x80 — CRTC_CONTROL
    "CRTC_BLANK_CONTROL_OFF": Initialize=132      // 0x84 — CRTC_BLANK_CONTROL
    "CRTC_STATUS_OFF":      Initialize=156        // 0x9C — CRTC_STATUS
    "CRTC_STATUS_POS_OFF":  Initialize=160        // 0xA0 — CRTC_STATUS_POSITION
    "CRTC_UPDATE_LOCK_OFF": Initialize=228        // 0xE4 — CRTC_UPDATE_LOCK

    // Per-pipe graphics (DCP) base addresses (byte offsets)
    "GRPH0_BASE":           Initialize=26624      // 0x6800
    "GRPH1_BASE":           Initialize=29696      // 0x7400
    "GRPH2_BASE":           Initialize=65536      // 0x10000
    "GRPH3_BASE":           Initialize=68608      // 0x10C00
    "GRPH4_BASE":           Initialize=71680      // 0x11800
    "GRPH5_BASE":           Initialize=74752      // 0x12400

    // Per-pipe graphics register offsets (add to GRPH base)
    "GRPH_ENABLE_OFF":      Initialize=0          // 0x00 — GRPH_ENABLE
    "GRPH_UPDATE_OFF":      Initialize=68         // 0x44 — GRPH_UPDATE
}

// =============================================================================
// DCE6 CRTC BIT DEFINITIONS
// =============================================================================
FixedPool.CRTCBits {
    // CRTC_CONTROL (base + 0x80)
    "CRTC_MASTER_EN":       Initialize=1          // bit 0 — CRTC enabled
    "CRTC_DISP_READ_REQ_DIS": Initialize=16777216 // bit 24 — disable display read (pre-DCE6)

    // CRTC_BLANK_CONTROL (base + 0x84) — DCE6+ blanking method
    "CRTC_BLANK_DATA_EN":   Initialize=256        // bit 8 — force blank data

    // CRTC_STATUS (base + 0x9C)
    "CRTC_V_BLANK":         Initialize=1          // bit 0 — in vertical blank

    // CRTC_UPDATE_LOCK (base + 0xE4)
    "CRTC_UPDATE_LOCK_BIT": Initialize=1          // bit 0 — lock CRTC updates

    // GRPH_ENABLE (GRPH base + 0x00)
    "GRPH_ENABLE_BIT":      Initialize=1          // bit 0 — graphics output enabled
}
