//
// Library.AMDGPUPM4Ring.ailang
//
// PM4 ring buffer configuration, setup, and low-level ring operations.
// Split from Library.AMDGPUPM4.ailang for maintainability.
//
// USAGE
//   LibraryImport.Drivers.AMDGPU.AMDGPUPM4Ring
//
// DEPENDS
//   LibraryImport.Drivers.AMDGPU.AMDGPUPM4Regs
//   LibraryImport.Drivers.AMDGPU.AMDGPUBAR
// =============================================================================
// PM4 PACKET TYPES AND OPCODES
// =============================================================================
FixedPool.PM4 {
    // Packet type identifiers (bits [31:30])
    "TYPE0":                Initialize=0          // Register write (legacy)
    "TYPE2":                Initialize=2          // NOP filler
    "TYPE3":                Initialize=3          // Command packet

    // Type 3 opcodes (bits [15:8] of header)
    "OP_NOP":               Initialize=16         // 0x10
    "OP_SET_BASE":          Initialize=17         // 0x11
    "OP_CLEAR_STATE":       Initialize=18         // 0x12
    "OP_DISPATCH_DIRECT":   Initialize=21         // 0x15
    "OP_WRITE_DATA":        Initialize=55         // 0x37
    "OP_ME_INITIALIZE":     Initialize=68         // 0x44
    "OP_WAIT_REG_MEM":      Initialize=60         // 0x3C
    "OP_INDIRECT_BUFFER":   Initialize=63         // 0x3F
    "OP_CONTEXT_CONTROL":   Initialize=40         // 0x28
    "OP_EVENT_WRITE":       Initialize=70         // 0x46
    "OP_EVENT_WRITE_EOP":   Initialize=71         // 0x47
    "OP_EVENT_WRITE_EOS":   Initialize=72         // 0x48
    "OP_RELEASE_MEM":       Initialize=73         // 0x49
    "OP_ACQUIRE_MEM":       Initialize=88         // 0x58
    "OP_SET_CONFIG_REG":    Initialize=104        // 0x68
    "OP_SET_CONTEXT_REG":   Initialize=105        // 0x69
    "OP_SURFACE_SYNC":      Initialize=67         // 0x43
    "OP_PREAMBLE_CNTL":     Initialize=74         // 0x4A
    "OP_SET_SH_REG":        Initialize=118        // 0x76

    // SET_SH_REG base (DWORD offset subtracted from target register)
    "SH_REG_BASE":          Initialize=11264      // 0x2C00 (DWORD base of SH regs)
    // SET_CONFIG_REG base (DWORD offset subtracted from target register)
    "CONFIG_REG_BASE":      Initialize=8192       // 0x2000 (DWORD base = 0x8000 / 4)

    // SHADER_TYPE bit for compute (bit 1 of header)
    "SHADER_TYPE_COMPUTE":  Initialize=2          // 1 << 1

    // PREAMBLE_CNTL body values
    "PREAMBLE_BEGIN_CLEAR_STATE": Initialize=536870912   // 2 << 28 = 0x20000000
    "PREAMBLE_END_CLEAR_STATE":   Initialize=805306368   // 3 << 28 = 0x30000000

    // SET_CONTEXT_REG base (DWORD offset subtracted from target register)
    "CONTEXT_REG_BASE":     Initialize=40960      // 0xA000 (DWORD base = 0x28000 / 4)

    // SURFACE_SYNC cache invalidation flags (coher_cntl bits)
    "TCL1_ACTION_ENA":      Initialize=4194304    // 1 << 22
    "TC_ACTION_ENA":        Initialize=8388608    // 1 << 23
    "SH_KCACHE_ACTION_ENA": Initialize=134217728  // 1 << 27
    "SH_ICACHE_ACTION_ENA": Initialize=536870912  // 1 << 29

    // CP_COHER_CNTL2 register (used to set VMID for cache flush scope)
    "CP_COHER_CNTL2":       Initialize=34280      // 0x85E8
}

// =============================================================================
// RING BUFFER CONFIGURATION
// =============================================================================
FixedPool.RingConf {
    "RING_SIZE_DWORDS":     Initialize=16384      // 64KB ring = 16K DWORDs
    "RING_SIZE_BYTES":      Initialize=65536      // 64KB
    "RING_LOG2":            Initialize=13         // log2(65536/8) = log2(8192) = 13 (QW units)
    "RING_MASK":            Initialize=16383      // RING_SIZE_DWORDS - 1
    "PAGE_LOG2":            Initialize=9          // log2(4096/8) = log2(512) = 9
    "RPTR_WB_OFFSET":       Initialize=65536      // Relative offset from ring start (= ring size bytes)
    "VRAM_RING_OFFSET":     Initialize=100663296  // Ring starts at 96MB into VRAM (past 90MB GART page table)
    "VRAM_TOTAL_ALLOC":     Initialize=69632      // 64KB ring + 4KB writeback area
    "MAX_RINGS":            Initialize=4          // We support up to 4 rings
    // §44c bisect: 1 = rings + RPTR writeback live in VRAM (the pre-7800e83c
    // working layout, CP fetch bypasses GART PTEs via the system aperture);
    // 0 = GART-backed system RAM. IB/data/shader/CSB placement unaffected.
    "RINGS_IN_VRAM":        Initialize=1
}

// =============================================================================
// PER-RING STATE — stored in a flat array
// =============================================================================
// Layout of each 128-byte ring state entry:
//   +0:   gpu_index    (8 bytes) — which GPU this ring belongs to
//   +8:   ring_id      (8 bytes) — 0=GFX, 1=Compute1, 2=Compute2
//   +16:  vram_base    (8 bytes) — VRAM byte offset where ring buffer lives
//   +24:  ring_size    (8 bytes) — size in DWORDs
//   +32:  wptr         (8 bytes) — software write pointer (DWORDs, monotonic)
//   +40:  rptr_wb_addr (8 bytes) — VRAM byte offset of RPTR writeback location
//   +48:  initialized  (8 bytes) — 1 if ring is set up
//   +56:  reserved     (8 bytes)
//   +64:  pkt_buf      (8 bytes) — scratch buffer for building packets
//   +72:  pkt_pos      (8 bytes) — current position in pkt_buf
//   +80:  fence_val    (8 bytes) — monotonic fence counter
//   +88:  fence_wb_off (8 bytes) — VRAM offset for fence writeback
//   +96:  halted       (8 bytes) — 1 if CP is halted for this ring
//   +104: reserved2    (8 bytes)
//   +112: reserved3    (8 bytes)
//   +120: reserved4    (8 bytes)

FixedPool.RingField {
    "GPU_INDEX":        Initialize=0
    "RING_ID":          Initialize=8
    "VRAM_BASE":        Initialize=16
    "RING_SIZE":        Initialize=24
    "WPTR":             Initialize=32
    "RPTR_WB_ADDR":     Initialize=40
    "INITIALIZED":      Initialize=48
    "HOST_PTR":         Initialize=56    // host pointer to GART-backed ring buffer (0 = use VRAM)
    "PKT_BUF":          Initialize=64
    "PKT_POS":          Initialize=72
    "FENCE_VAL":        Initialize=80
    "FENCE_WB_OFF":     Initialize=88
    "HALTED":           Initialize=96
    "GART_VA":          Initialize=104   // ring's GART VA byte address (for CP_RB*_BASE)
    "WB_HOST_PTR":      Initialize=112   // host pointer to RPTR writeback location in GART WB page
    "ENTRY_SIZE":       Initialize=128
}

FixedPool.PM4State {
    "rings":            Initialize=0, CanChange=True   // ptr to ring state array
    "initialized":      Initialize=0, CanChange=True
    "mc_fb_base":       Initialize=0, CanChange=True   // GPU MC address of VRAM start
    "hdp_hpc_val":      Initialize=0, CanChange=True   // BIOS HDP_HOST_PATH_CNTL (for GPU-side read-cache invalidation)
    "hdp_misc_val":     Initialize=0, CanChange=True   // BIOS HDP_MISC_CNTL (for GPU-side read-cache flush)
}

// =============================================================================
// PM4_Init — allocate ring state array
// =============================================================================
Function.PM4_Init {
    Body: {
        IfCondition EqualTo(PM4State.initialized, 1) ThenBlock: {
            ReturnValue(0)
        }
        total = Multiply(RingConf.MAX_RINGS, RingField.ENTRY_SIZE)
        PM4State.rings = Allocate(total)
        MemorySet(PM4State.rings, 0, total)
        PM4State.initialized = 1
    }
}

// =============================================================================
// PM4_GetRing — return pointer to ring state for given ring index
// =============================================================================
Function.PM4_GetRing {
    Input: ring_idx: Integer
    Output: Address
    Body: {
        IfCondition GreaterEqual(ring_idx, RingConf.MAX_RINGS) ThenBlock: {
            ReturnValue(0)
        }
        ReturnValue(Add(PM4State.rings, Multiply(ring_idx, RingField.ENTRY_SIZE)))
    }
}

// =============================================================================
// PM4_HaltCP — halt the command processor (all three MEs)
// Must be called before reprogramming ring registers.
// =============================================================================
Function.PM4_HaltCP {
    Input: gpu: Integer
    Body: {
        // DISPLAY GPU GUARD — never halt the CP on the display GPU.
        // The display GPU's CP is actively used by the radeon driver for
        // scanout and display engine operations.  Halting it can freeze
        // or corrupt the VESA framebuffer.
        IfCondition EqualTo(GPU_BAR_IsDisplayGPU(gpu), 1) ThenBlock: {
            PrintMessage("[PM4] HaltCP: REFUSED — display GPU\n")
        }
        IfCondition EqualTo(GPU_BAR_IsDisplayGPU(gpu), 0) ThenBlock: {
            // Halt CE + PFP + ME
            halt = Add(CPMEBits.CE_HALT, Add(CPMEBits.PFP_HALT, CPMEBits.ME_HALT))
            GPU_Wr32(gpu, SIReg.CP_ME_CNTL, halt)

            // Brief spin to let CP drain
            i = 0
            WhileLoop LessThan(i, 1000) {
                scratch = GPU_Rd32(gpu, SIReg.GRBM_STATUS)
                i = Add(i, 1)
            }

            //PrintMessage("[PM4] CP halted\n")
        }
    }
}

// =============================================================================
// PM4_UnhaltCP — release the command processor
// =============================================================================
Function.PM4_UnhaltCP {
    Input: gpu: Integer
    Body: {
        GPU_Wr32(gpu, SIReg.CP_ME_CNTL, 0)
        //PrintMessage("[PM4] CP unhalted")
        //PrintMessage(" (ME_CNTL readback=0x")
        //PrintHex(GPU_Rd32(gpu, SIReg.CP_ME_CNTL))
        //PrintMessage(" GRBM_STATUS=0x")
        //PrintHex(GPU_Rd32(gpu, SIReg.GRBM_STATUS))
        //PrintMessage(")\n")
    }
}

// =============================================================================
// PM4_InitMCBase — read MC_VM_FB_LOCATION to find VRAM GPU base address
//
// The GPU sees VRAM at MC address (FB_BASE << 24), not at offset 0.
// All GPU-side addresses (CP_RB_BASE, RPTR writeback, fence, shader, buffers)
// must include this base. Host-side BAR mmap uses VRAM offsets directly.
// =============================================================================
Function.PM4_InitMCBase {
    Input: gpu: Integer
    Body: {
        mc_raw = GPU_Rd32(gpu, SIReg.MC_VM_FB_LOCATION)
        mc_base_units = BitwiseAnd(mc_raw, 65535)
        mc_top_units = BitwiseAnd(RightShift(mc_raw, 16), 65535)
        PM4State.mc_fb_base = LeftShift(mc_base_units, 24)

        // --- HDP non-surface path setup (REVERTED) ---
        // GPU_Wr32(gpu, SIReg.HDP_HOST_PATH_CNTL, 0)  <-- REMOVED: zeroing this
        //   register destroys the BIOS-configured HDP routing.  The Linux kernel
        //   does a read-modify-write on specific bits, never a blind zero.
        //   Combined with WC BAR0 mapping, this deadlocked the PCI fabric
        //   and hard-locked the system (Jun 16 2026).
        // GPU_Wr32(gpu, SIReg.HDP_NONSURFACE_BASE, ...)  <-- REMOVED: keep BIOS
        //   defaults until we can do a proper read-modify-write sequence.
        // GPU_Wr32(gpu, SIReg.HDP_NONSURFACE_INFO, ...)
        // GPU_Wr32(gpu, SIReg.HDP_NONSURFACE_SIZE, ...)

        // HDP snapshots REMOVED — no longer writing HDP regs from dispatch path.
        // All HDP register writes (CPU or GPU-side) crash the RD990 PCI fabric.

        PrintMessage("[PM4] mc_fb_base=0x")
        PrintHex(PM4State.mc_fb_base)
        PrintMessage("\n")

        //PrintMessage("[PM4] MC_VM_FB_LOCATION = 0x")
        //PrintHex(mc_raw)
        //PrintMessage("  VRAM GPU base = 0x")
        //PrintHex(PM4State.mc_fb_base)
        //PrintMessage("\n")

        // VM/TLB setup moved to PM4_ConfigureVM — must be called AFTER
        // PM4_SoftResetCP, which wipes VM registers via GRBM/SRBM reset.
    }
}

// =============================================================================
// PM4_ConfigureVM — program VM/TLB registers and system aperture
//
// Matches kernel gmc_v6_0_mc_program() + gmc_v6_0_gart_enable() EXACTLY.
// MUST be called AFTER PM4_SoftResetCP and MC_SI_GpuInit.
//
// Requires PM4_InitMCBase to have been called first (needs mc_fb_base).
// =============================================================================
Function.PM4_ConfigureVM {
    Input: gpu: Integer
    Body: {
        // Re-read MC_VM_FB_LOCATION for aperture bounds
        mc_raw = GPU_Rd32(gpu, SIReg.MC_VM_FB_LOCATION)
        mc_base_units = BitwiseAnd(mc_raw, 65535)
        mc_top_units = BitwiseAnd(RightShift(mc_raw, 16), 65535)

        vram_start_page = RightShift(LeftShift(mc_base_units, 24), 12)
        vram_end_page = Subtract(LeftShift(Add(mc_top_units, 1), 12), 1)

        // =====================================================================
        // PART A — gmc_v6_0_mc_program() / si_mc_program()
        // =====================================================================

        // 1. Zero HDP non-surface entries (32 slots × 5 regs each)
        //    Kernel: for (i=0,j=0; i<32; i++,j+=0x18) WREG32(0x2c14+j, 0)×5
        //    Byte offsets: 0x2C14=11284, stride=0x18=24, 5 regs per slot
        hdp_i = 0
        WhileLoop LessThan(hdp_i, 32) {
            hdp_base = Add(11284, Multiply(hdp_i, 24))
            GPU_Wr32(gpu, hdp_base, 0)
            GPU_Wr32(gpu, Add(hdp_base, 4), 0)
            GPU_Wr32(gpu, Add(hdp_base, 8), 0)
            GPU_Wr32(gpu, Add(hdp_base, 12), 0)
            GPU_Wr32(gpu, Add(hdp_base, 16), 0)
            hdp_i = Add(hdp_i, 1)
        }

        // 2. HDP_REG_COHERENCY_FLUSH_CNTL = 0
        GPU_Wr32(gpu, SIReg.HDP_REG_COHERENCY_FLUSH_CNTL, 0)

        // 3. VGA_HDP_CONTROL |= VGA_MEMORY_DISABLE (bit 4)
        //    Lockout access through VGA aperture
        vga_hdp = GPU_Rd32(gpu, SIReg.VGA_HDP_CONTROL)
        GPU_Wr32(gpu, SIReg.VGA_HDP_CONTROL, BitwiseOr(vga_hdp, 16))

        // 4. VGA_RENDER_CONTROL &= VGA_VSTATUS_CNTL_MASK (0x30000 = 196608)
        //    Disable VGA render, keep only VSTATUS_CNTL bits
        vga_render = GPU_Rd32(gpu, SIReg.VGA_RENDER_CONTROL)
        GPU_Wr32(gpu, SIReg.VGA_RENDER_CONTROL, BitwiseAnd(vga_render, 196608))

        // 5. System aperture — cover entire VRAM range
        GPU_Wr32(gpu, SIReg.MC_VM_SYSTEM_APERTURE_LOW_ADDR, vram_start_page)
        GPU_Wr32(gpu, SIReg.MC_VM_SYSTEM_APERTURE_HIGH_ADDR, vram_end_page)
        GPU_Wr32(gpu, SIReg.MC_VM_SYSTEM_APERTURE_DEFAULT_ADDR, Add(vram_start_page, 512))

        // 6. Disable AGP aperture
        //    Mmiotrace seq 4122-4124: AGP_BASE=0, AGP_TOP=0, AGP_BOT=0x03FFFFFF
        GPU_Wr32(gpu, SIReg.MC_VM_AGP_BASE, 0)
        GPU_Wr32(gpu, SIReg.MC_VM_AGP_TOP, 0)                        // 0x00000000
        GPU_Wr32(gpu, SIReg.MC_VM_AGP_BOT, 67108863)                 // 0x03FFFFFF

        // 7. HDP_NONSURFACE_BASE — mmiotrace seq 2483 = vram_start >> 8
        //    Required for HDP to route non-surface VRAM access correctly
        GPU_Wr32(gpu, SIReg.HDP_NONSURFACE_BASE, RightShift(LeftShift(mc_base_units, 24), 8))

        // =====================================================================
        // PART B — gmc_v6_0_gart_enable() / si_pcie_gart_enable()
        // =====================================================================

        // 1. L1 TLB control
        //    MC_VM_MX_L1_TLB_CNTL = 0x055B:
        //      ENABLE_L1_TLB(bit0) | ENABLE_L1_FRAGMENT_PROCESSING(bit1) |
        //      SYSTEM_ACCESS_MODE=NOT_IN_SYS(3<<2) |
        //      ENABLE_ADVANCED_DRIVER_MODEL(bit4) |
        //      (0xA << 7) | SYSTEM_APERTURE_UNMAPPED_ACCESS_PASS_THRU(0<<5)
        GPU_Wr32(gpu, SIReg.MC_VM_MX_L1_TLB_CNTL, 1371)             // 0x055B

        // 2. L2 cache control
        //    VM_L2_CNTL = ENABLE_L2_CACHE | ENABLE_L2_FRAGMENT_PROCESSING |
        //      ENABLE_L2_PTE_CACHE_LRU_UPDATE_BY_WRITE |
        //      ENABLE_L2_PDE0_CACHE_LRU_UPDATE_BY_WRITE |
        //      EFFECTIVE_L2_QUEUE_SIZE(7) | CONTEXT1_IDENTITY_ACCESS_MODE(1)
        GPU_Wr32(gpu, SIReg.VM_L2_CNTL, 755203)                      // 0x000B8603

        //    VM_L2_CNTL2 = INVALIDATE_ALL_L1_TLBS | INVALIDATE_L2_CACHE
        GPU_Wr32(gpu, SIReg.VM_L2_CNTL2, 3)                          // 0x00000003

        //    VM_L2_CNTL3 = L2_CACHE_BIGK_ASSOCIATIVITY |
        //      BANK_SELECT(4) | L2_CACHE_BIGK_FRAGMENT_SIZE(4)
        GPU_Wr32(gpu, SIReg.VM_L2_CNTL3, 1343497)                    // 0x00148009

        // 3. Context 0 setup (VMID 0 — kernel/compute context)
        //    ORDER MATTERS: set page table addresses BEFORE enabling context
        //    CTX0 covers the full GART range from VRAM start to 0xFF_3FFF_F000.
        //    VRAM access bypasses page tables via the system aperture.
        //    Addresses outside system aperture go through page table lookup.
        //    Kernel: START_ADDR = gtt_start >> 12 = vram_start_page
        //    END_ADDR = gtt_end >> 12 = 0x0FF3FFFF
        //    BASE_ADDR = page table physical location = vram_start_page
        //    START_ADDR must equal vram_start_page (0x0F400000), NOT the GART VA.
        //    The page table covers the entire range from VRAM start through GART end.
        //    VRAM accesses bypass via system aperture; GART accesses use PTEs.
        GPU_Wr32(gpu, SIReg.VM_CONTEXT0_PAGE_TABLE_START_ADDR, vram_start_page)  // 0x0F400000
        GPU_Wr32(gpu, SIReg.VM_CONTEXT0_PAGE_TABLE_END_ADDR, 267649023)     // 0x0FF3FFFF
        GPU_Wr32(gpu, SIReg.VM_CONTEXT0_PAGE_TABLE_BASE_ADDR, vram_start_page)

        //    Protection fault default addr = dummy page in MC address space
        //    Must match kernel value exactly: 0x000AF50C
        GPU_Wr32(gpu, SIReg.VM_CONTEXT0_PROTECTION_FAULT_DEFAULT_ADDR, 718092)

        //    VM_CONTEXT0_CNTL2 = 0
        GPU_Wr32(gpu, SIReg.VM_CONTEXT0_CNTL2, 0)

        //    VM_CONTEXT0_CNTL = ENABLE_CONTEXT | PAGE_TABLE_DEPTH(0) |
        //      RANGE_PROTECTION_FAULT_ENABLE_DEFAULT = 0x11
        //    Enable LAST after all page table regs are set
        GPU_Wr32(gpu, SIReg.VM_CONTEXT0_CNTL, 17)                    // 0x00000011

        PrintMessage("\n=== [VM CONFIG] readback ===\n")
        PrintMessage("[VMDBG] mc_raw=0x")
        PrintHex(mc_raw)
        PrintMessage(" vram_start_page=0x")
        PrintHex(vram_start_page)
        PrintMessage(" vram_end_page=0x")
        PrintHex(vram_end_page)
        PrintMessage("\n")
        PrintMessage("[VMDBG] APERTURE_LOW=0x")
        PrintHex(GPU_Rd32(gpu, SIReg.MC_VM_SYSTEM_APERTURE_LOW_ADDR))
        PrintMessage(" APERTURE_HIGH=0x")
        PrintHex(GPU_Rd32(gpu, SIReg.MC_VM_SYSTEM_APERTURE_HIGH_ADDR))
        PrintMessage(" APERTURE_DEFAULT=0x")
        PrintHex(GPU_Rd32(gpu, SIReg.MC_VM_SYSTEM_APERTURE_DEFAULT_ADDR))
        PrintMessage("\n")
        PrintMessage("[VMDBG] CTX0_START=0x")
        PrintHex(GPU_Rd32(gpu, SIReg.VM_CONTEXT0_PAGE_TABLE_START_ADDR))
        PrintMessage(" CTX0_END=0x")
        PrintHex(GPU_Rd32(gpu, SIReg.VM_CONTEXT0_PAGE_TABLE_END_ADDR))
        PrintMessage(" CTX0_BASE=0x")
        PrintHex(GPU_Rd32(gpu, SIReg.VM_CONTEXT0_PAGE_TABLE_BASE_ADDR))
        PrintMessage("\n")
        PrintMessage("[VMDBG] CTX0_CNTL=0x")
        PrintHex(GPU_Rd32(gpu, SIReg.VM_CONTEXT0_CNTL))
        PrintMessage(" L1_TLB_CNTL=0x")
        PrintHex(GPU_Rd32(gpu, SIReg.MC_VM_MX_L1_TLB_CNTL))
        PrintMessage(" L2_CNTL=0x")
        PrintHex(GPU_Rd32(gpu, SIReg.VM_L2_CNTL))
        PrintMessage("\n")

        // 4. Mystery registers (unnamed in sid.h, both radeon and amdgpu zero them)
        //    0x15D4 = 5588, 0x15D8 = 5592, 0x15DC = 5596
        GPU_Wr32(gpu, 5588, 0)                                        // 0x15D4
        GPU_Wr32(gpu, 5592, 0)                                        // 0x15D8
        GPU_Wr32(gpu, 5596, 0)                                        // 0x15DC

        // 5. Context 1-15 setup (user VMIDs)
        //    Kernel trace: CTX1_START = vram_start_page, CTX1_END = max_pfn
        GPU_Wr32(gpu, SIReg.VM_CONTEXT1_PAGE_TABLE_START_ADDR, vram_start_page)  // 0x0F400000
        GPU_Wr32(gpu, SIReg.VM_CONTEXT1_PAGE_TABLE_END_ADDR, 33554431)  // 0x01FFFFFF

        //    Set page table base for VMIDs 1-7 (VM_CONTEXT0_PAGE_TABLE_BASE_ADDR + i*4)
        //    VMID 1: 0x153C + 4 = 0x1540 = 5440
        //    VMID 2: 0x153C + 8 = 0x1544 = 5444
        //    ...
        //    VMID 7: 0x153C + 28 = 0x1558 = 5464
        ctx_i = 1
        WhileLoop LessThan(ctx_i, 8) {
            ctx_reg = Add(5436, Multiply(ctx_i, 4))
            GPU_Wr32(gpu, ctx_reg, vram_start_page)
            ctx_i = Add(ctx_i, 1)
        }

        //    Set page table base for VMIDs 8-15 (VM_CONTEXT8_PAGE_TABLE_BASE_ADDR + (i-8)*4)
        //    VMID 8:  0x1438 + 0 = 0x1438 = 5176
        //    VMID 9:  0x1438 + 4 = 0x143C = 5180
        //    ...
        //    VMID 15: 0x1438 + 28 = 0x1454 = 5204
        ctx_i = 8
        WhileLoop LessThan(ctx_i, 16) {
            ctx_reg = Add(5176, Multiply(Subtract(ctx_i, 8), 4))
            GPU_Wr32(gpu, ctx_reg, vram_start_page)
            ctx_i = Add(ctx_i, 1)
        }

        //    Protection fault default addr for contexts 1-15 (match kernel: 0x000AF50C)
        GPU_Wr32(gpu, SIReg.VM_CONTEXT1_PROTECTION_FAULT_DEFAULT_ADDR, 718092)

        //    VM_CONTEXT1_CNTL2 = 4
        GPU_Wr32(gpu, SIReg.VM_CONTEXT1_CNTL2, 4)

        //    VM_CONTEXT1_CNTL — kernel writes this twice (seq 12114 then 12116):
        //    First: 0x01000003 (ENABLE + PAGE_TABLE_DEPTH=1 + PAGE_TABLE_BLOCK_SIZE=1)
        //    Then:  0x01092493 (full protection fault enables)
        GPU_Wr32(gpu, SIReg.VM_CONTEXT1_CNTL, 16777219)              // 0x01000003
        GPU_Wr32(gpu, SIReg.VM_CONTEXT1_CNTL, 17376403)              // 0x01092493

        // 6. TLB flush — si_pcie_gart_tlb_flush() / gmc_v6_0_flush_gpu_tlb()
        //    HDP flush first, then invalidate all VM contexts
        GPU_Wr32(gpu, SIReg.HDP_MEM_COHERENCY_FLUSH_CNTL, 1)
        GPU_Wr32(gpu, SIReg.VM_INVALIDATE_REQUEST, 1)

        // 7. SDMA channel config (kernel Phase 9, seq 13828-13839)
        //    MC_SEQ_IO_DEBUG_INDEX = 0x0B (selects calibration reg)
        //    Then 6 channel pairs: base=0x154, size=0
        GPU_Wr32(gpu, 24064, 340)     // 0x5E00 = 0x154
        GPU_Wr32(gpu, 24068, 0)       // 0x5E04 = 0
        GPU_Wr32(gpu, 24088, 340)     // 0x5E18 = 0x154
        GPU_Wr32(gpu, 24092, 0)       // 0x5E1C = 0
        GPU_Wr32(gpu, 24112, 340)     // 0x5E30 = 0x154
        GPU_Wr32(gpu, 24116, 0)       // 0x5E34 = 0
        GPU_Wr32(gpu, 24136, 340)     // 0x5E48 = 0x154
        GPU_Wr32(gpu, 24140, 0)       // 0x5E4C = 0
        GPU_Wr32(gpu, 24160, 340)     // 0x5E60 = 0x154
        GPU_Wr32(gpu, 24164, 0)       // 0x5E64 = 0
        GPU_Wr32(gpu, 24180, 340)     // 0x5E74 = 0x154
        GPU_Wr32(gpu, 24184, 0)       // 0x5E78 = 0

        // 8. Additional HDP flush + VM invalidate cycles (kernel does 8+ pairs)
        GPU_Wr32(gpu, SIReg.HDP_MEM_COHERENCY_FLUSH_CNTL, 1)
        GPU_Wr32(gpu, SIReg.VM_INVALIDATE_REQUEST, 1)

        // Readback verify
        rb_hi = GPU_Rd32(gpu, SIReg.MC_VM_SYSTEM_APERTURE_HIGH_ADDR)
        IfCondition EqualTo(rb_hi, 0) ThenBlock: {
            PrintMessage("[PM4] WARNING: aperture HIGH readback is 0 — MC register write may have failed!\n")
        }
    }
}

// =============================================================================
// PM4_VramToGPU — convert a VRAM BAR offset to a GPU MC address
//
// The GPU sees VRAM at MC_VM_FB_LOCATION base, not at offset 0.
// All GPU-side addresses (ring base, RPTR writeback, fence, shader, buffers)
// must use MC addresses. Host-side BAR access uses VRAM offsets directly.
//
// Call PM4_InitMCBase first to populate PM4State.mc_fb_base.
// =============================================================================
Function.PM4_VramToGPU {
    Input: vram_offset: Integer
    Output: Integer
    Body: {
        ReturnValue(Add(PM4State.mc_fb_base, vram_offset))
    }
}

// =============================================================================
// PM4_SetupRing — configure a ring buffer in VRAM and program CP registers
//
// ring_idx: 0=GFX/Ring0, 1=Compute1/Ring1, 2=Compute2/Ring2
// vram_offset: byte offset into VRAM aperture for ring placement
//
// This follows the exact sequence from si_cp_resume() in the Linux kernel:
//   1. Halt CP
//   2. Set WPTR delay to 0
//   3. Write CP_RB_CNTL with size (+ RB_RPTR_WR_ENA)
//   4. Zero WPTR
//   5. Set RPTR writeback address
//   6. Write CP_RB_CNTL without RB_RPTR_WR_ENA
//   7. Set CP_RB_BASE (GPU addr >> 8)
//   8. Read back RPTR
//   9. Unhalt CP
//
// Returns 1 on success.
// =============================================================================
Function.PM4_SetupRing {
    Input: gpu: Integer
    Input: ring_idx: Integer
    Input: vram_offset: Integer
    Output: Integer
    Body: {
        PM4_Init()

        ring = PM4_GetRing(ring_idx)
        IfCondition EqualTo(ring, 0) ThenBlock: {
            PrintMessage("[PM4] Invalid ring index\n")
            ReturnValue(0)
        }

        // Ensure MMIO and VRAM BARs are mapped
        IfCondition EqualTo(GPU_BAR_MapMMIO(gpu), 0) ThenBlock: {
            PrintMessage("[PM4] MMIO not available\n")
            ReturnValue(0)
        }
        IfCondition EqualTo(GPU_BAR_MapVRAM(gpu), 0) ThenBlock: {
            PrintMessage("[PM4] VRAM not available\n")
            ReturnValue(0)
        }

        // ---- Pull GART buffer for this ring from GARTState ----
        // Rings now live in GART-backed system RAM, not VRAM.
        // Each ring has a host_ptr (mmap'd system RAM) and a GART VA.
        gart_host = 0
        gart_va = 0
        IfCondition EqualTo(ring_idx, 0) ThenBlock: {
            gart_host = GARTState.cprb0_host_ptr
            gart_va = BitwiseOr(LeftShift(GARTConf.CPRB0_GPU_VA_HI, 32), GARTConf.CPRB0_GPU_VA_LO)
        }
        IfCondition EqualTo(ring_idx, 1) ThenBlock: {
            gart_host = GARTState.cprb1_host_ptr
            gart_va = BitwiseOr(LeftShift(GARTConf.CPRB1_GPU_VA_HI, 32), GARTConf.CPRB1_GPU_VA_LO)
        }
        IfCondition EqualTo(ring_idx, 2) ThenBlock: {
            gart_host = GARTState.cprb2_host_ptr
            gart_va = BitwiseOr(LeftShift(GARTConf.CPRB2_GPU_VA_HI, 32), GARTConf.CPRB2_GPU_VA_LO)
        }

        // §44c: VRAM mode — override the GART placement. Ring at vram_offset,
        // RPTR writeback right after it. MC addresses land inside the system
        // aperture, so CP fetch/writeback bypass the page table entirely.
        wb_vram_off = Add(vram_offset, RingConf.RPTR_WB_OFFSET)
        IfCondition EqualTo(RingConf.RINGS_IN_VRAM, 1) ThenBlock: {
            gart_host = 0
            gart_va = PM4_VramToGPU(vram_offset)
        }

        // Zero the ring buffer + writeback slot
        IfCondition NotEqual(gart_host, 0) ThenBlock: {
            // GART path: host pointer into system RAM
            MemorySet(gart_host, 0, RingConf.RING_SIZE_BYTES)
            wb_gart_va = BitwiseOr(LeftShift(GARTConf.CPRB_WB_GPU_VA_HI, 32), Add(GARTConf.CPRB_WB_GPU_VA_LO, Multiply(ring_idx, 256)))
            wb_host = Add(GARTState.cprb_wb_host_ptr, Multiply(ring_idx, 256))
            MemorySet(wb_host, 0, 256)
        }
        IfCondition EqualTo(gart_host, 0) ThenBlock: {
            // VRAM path: zero via BAR0
            z_i = 0
            WhileLoop LessThan(z_i, RingConf.RING_SIZE_BYTES) {
                GPU_VramWr32(gpu, Add(vram_offset, z_i), 0)
                z_i = Add(z_i, 4)
            }
            z_i = 0
            WhileLoop LessThan(z_i, 256) {
                GPU_VramWr32(gpu, Add(wb_vram_off, z_i), 0)
                z_i = Add(z_i, 4)
            }
            wb_gart_va = PM4_VramToGPU(wb_vram_off)
            wb_host = 0
        }

        // Select registers
        IfCondition EqualTo(ring_idx, 0) ThenBlock: {
            reg_cntl = SIReg.CP_RB0_CNTL
            reg_base = SIReg.CP_RB0_BASE
            reg_wptr = SIReg.CP_RB0_WPTR
            reg_rptr = SIReg.CP_RB0_RPTR
            reg_rptr_addr = SIReg.CP_RB0_RPTR_ADDR
            reg_rptr_addr_hi = SIReg.CP_RB0_RPTR_ADDR_HI
        }
        IfCondition EqualTo(ring_idx, 1) ThenBlock: {
            reg_cntl = SIReg.CP_RB1_CNTL
            reg_base = SIReg.CP_RB1_BASE
            reg_wptr = SIReg.CP_RB1_WPTR
            reg_rptr = SIReg.CP_RB1_RPTR
            reg_rptr_addr = SIReg.CP_RB1_RPTR_ADDR
            reg_rptr_addr_hi = SIReg.CP_RB1_RPTR_ADDR_HI
        }
        IfCondition EqualTo(ring_idx, 2) ThenBlock: {
            reg_cntl = SIReg.CP_RB2_CNTL
            reg_base = SIReg.CP_RB2_BASE
            reg_wptr = SIReg.CP_RB2_WPTR
            reg_rptr = SIReg.CP_RB2_RPTR
            reg_rptr_addr = SIReg.CP_RB2_RPTR_ADDR
            reg_rptr_addr_hi = SIReg.CP_RB2_RPTR_ADDR_HI
        }

        // --- Begin CP ring programming sequence (matches kernel gfx_v6_0_cp_gfx_resume) ---

        // 1. Build CNTL value matching kernel per-ring:
        //    Ring 0: 0x90B (BUFSZ=0xB=11, BLK_SIZE=9<<8=0x900)
        //    Ring 1/2: 0x90A (BUFSZ=0xA=10, BLK_SIZE=9<<8=0x900)
        IfCondition EqualTo(ring_idx, 0) ThenBlock: {
            cntl_val = 2315    // 0x90B
        }
        IfCondition NotEqual(ring_idx, 0) ThenBlock: {
            cntl_val = 2314    // 0x90A
        }

        // 2. Write CNTL WITHOUT WR_ENA first (kernel step A: latch size config)
        GPU_Wr32(gpu, reg_cntl, cntl_val)

        // 3. Write CNTL WITH RB_RPTR_WR_ENA (enables RPTR write + writeback setup)
        GPU_Wr32(gpu, reg_cntl, Add(cntl_val, CntlBits.RB_RPTR_WR_ENA))

        // 4. Zero write pointer (kernel writes WPTR=0 here)
        GPU_Wr32(gpu, reg_wptr, 0)

        // 5. Set RPTR writeback address — now a GART VA, not VRAM MC address
        rptr_wb_lo = BitwiseAnd(wb_gart_va, 4294967292)     // lower 32 bits, aligned
        rptr_wb_hi = BitwiseAnd(RightShift(wb_gart_va, 32), 255)  // upper 8 bits
        GPU_Wr32(gpu, reg_rptr_addr, rptr_wb_lo)
        GPU_Wr32(gpu, reg_rptr_addr_hi, rptr_wb_hi)

        // 6. SCRATCH_UMSK=0 (kernel does this here)
        GPU_Wr32(gpu, SIReg.SCRATCH_UMSK, 0)

        // 7. 1ms delay — kernel mdelay(1) lets CP latch RPTR writeback config
        delay_i = 0
        WhileLoop LessThan(delay_i, 100000) {
            GPU_Rd32(gpu, SIReg.GRBM_STATUS)
            delay_i = Add(delay_i, 1)
        }

        // 8. Write CNTL again WITHOUT RB_RPTR_WR_ENA (lock it in)
        GPU_Wr32(gpu, reg_cntl, cntl_val)

        // 9. Set ring base address — GART VA >> 8
        ring_base_gpu = Divide(gart_va, 256)   // >> 8
        GPU_Wr32(gpu, reg_base, ring_base_gpu)

        // 10. Read back initial RPTR
        initial_rptr = GPU_Rd32(gpu, reg_rptr)

        // --- Store ring state ---
        StoreValue(Add(ring, RingField.GPU_INDEX), gpu)
        StoreValue(Add(ring, RingField.RING_ID), ring_idx)
        StoreValue(Add(ring, RingField.VRAM_BASE), vram_offset)
        StoreValue(Add(ring, RingField.RING_SIZE), RingConf.RING_SIZE_DWORDS)
        StoreValue(Add(ring, RingField.WPTR), 0)
        // RPTR_WB_ADDR: host pointer (GART mode) or VRAM byte offset (VRAM
        // mode, WB_HOST_PTR==0 selects the GPU_VramRd32 path in ReadRPTR)
        IfCondition NotEqual(wb_host, 0) ThenBlock: {
            StoreValue(Add(ring, RingField.RPTR_WB_ADDR), wb_host)
        }
        IfCondition EqualTo(wb_host, 0) ThenBlock: {
            StoreValue(Add(ring, RingField.RPTR_WB_ADDR), wb_vram_off)
        }
        StoreValue(Add(ring, RingField.FENCE_VAL), 0)
        // Fence writeback stays in VRAM (dispatch path uses GPU_VramWr32 + PM4_VramToGPU)
        // Place it at vram_offset + RING_SIZE_BYTES + 64 (just past where RPTR WB used to be)
        StoreValue(Add(ring, RingField.FENCE_WB_OFF), Add(vram_offset, Add(RingConf.RPTR_WB_OFFSET, 64)))
        StoreValue(Add(ring, RingField.HALTED), 0)
        StoreValue(Add(ring, RingField.HOST_PTR), gart_host)
        StoreValue(Add(ring, RingField.GART_VA), gart_va)
        StoreValue(Add(ring, RingField.WB_HOST_PTR), wb_host)
        StoreValue(Add(ring, RingField.INITIALIZED), 1)

        // Allocate scratch packet buffer (1KB for building PM4 packets)
        pkt_buf = Allocate(1024)
        MemorySet(pkt_buf, 0, 1024)
        StoreValue(Add(ring, RingField.PKT_BUF), pkt_buf)
        StoreValue(Add(ring, RingField.PKT_POS), 0)

        PrintMessage("[PM4] Ring ")
        PrintNumber(ring_idx)
        PrintMessage(" GART: BASE=0x")
        PrintHex(ring_base_gpu)
        PrintMessage(" RPTR_ADDR=0x")
        PrintHex(rptr_wb_lo)
        PrintMessage(" HI=0x")
        PrintHex(rptr_wb_hi)
        PrintMessage(" CNTL=0x")
        PrintHex(cntl_val)
        PrintMessage("\n")

        ReturnValue(1)
    }
}

// =============================================================================
// PM4_ReadRPTR — read the current GPU read pointer for a ring
// Reads from RPTR writeback location in VRAM (GPU writes this).
// This is the "head" in the head/tail mailbox model.
// =============================================================================
Function.PM4_ReadRPTR {
    Input: ring_idx: Integer
    Output: Integer
    Body: {
        ring = PM4_GetRing(ring_idx)
        IfCondition EqualTo(ring, 0) ThenBlock: { ReturnValue(0) }

        // GART mode: RPTR_WB_ADDR is a host pointer into the GART WB page.
        // VRAM mode (WB_HOST_PTR==0): RPTR_WB_ADDR is a VRAM byte offset.
        rptr_wb = Dereference(Add(ring, RingField.RPTR_WB_ADDR))
        IfCondition NotEqual(Dereference(Add(ring, RingField.WB_HOST_PTR)), 0) ThenBlock: {
            ReturnValue(Dereference(rptr_wb, "dword"))
        }
        gpu = Dereference(Add(ring, RingField.GPU_INDEX))
        ReturnValue(GPU_VramRd32(gpu, rptr_wb))
    }
}

// =============================================================================
// PM4_ReadRPTR_MMIO — read RPTR directly from hardware register (slower)
// =============================================================================
Function.PM4_ReadRPTR_MMIO {
    Input: ring_idx: Integer
    Output: Integer
    Body: {
        ring = PM4_GetRing(ring_idx)
        IfCondition EqualTo(ring, 0) ThenBlock: { ReturnValue(0) }

        gpu = Dereference(Add(ring, RingField.GPU_INDEX))
        rid = Dereference(Add(ring, RingField.RING_ID))

        IfCondition EqualTo(rid, 0) ThenBlock: {
            ReturnValue(GPU_Rd32(gpu, SIReg.CP_RB0_RPTR))
        }
        IfCondition EqualTo(rid, 1) ThenBlock: {
            ReturnValue(GPU_Rd32(gpu, SIReg.CP_RB1_RPTR))
        }
        IfCondition EqualTo(rid, 2) ThenBlock: {
            ReturnValue(GPU_Rd32(gpu, SIReg.CP_RB2_RPTR))
        }
        ReturnValue(0)
    }
}

// =============================================================================
// PM4_GetWPTR — return current software write pointer
// =============================================================================
Function.PM4_GetWPTR {
    Input: ring_idx: Integer
    Output: Integer
    Body: {
        ring = PM4_GetRing(ring_idx)
        IfCondition EqualTo(ring, 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(Dereference(Add(ring, RingField.WPTR)))
    }
}

// =============================================================================
// PM4_RingSpace — calculate available DWORDs in the ring
// Returns number of DWORDs that can be written before ring is full.
// Mirrors ThreadPool's head/tail distance calculation.
// =============================================================================
Function.PM4_RingSpace {
    Input: ring_idx: Integer
    Output: Integer
    Body: {
        ring = PM4_GetRing(ring_idx)
        IfCondition EqualTo(ring, 0) ThenBlock: { ReturnValue(0) }

        wptr = Dereference(Add(ring, RingField.WPTR))
        rptr = PM4_ReadRPTR(ring_idx)
        size = Dereference(Add(ring, RingField.RING_SIZE))

        // Available = size - 1 - (wptr - rptr) mod size
        // We keep 1 DWORD gap to distinguish full from empty
        used = BitwiseAnd(Subtract(wptr, rptr), Subtract(size, 1))
        ReturnValue(Subtract(Subtract(size, 1), used))
    }
}

// =============================================================================
// PM4_WaitForSpace — spin-poll until enough ring space is available
// This mirrors the ThreadPool worker's spin-poll on tail.
// =============================================================================
Function.PM4_WaitForSpace {
    Input: ring_idx: Integer
    Input: ndwords: Integer
    Output: Integer
    Body: {
        attempts = 0
        max_attempts = 10000000   // ~10M spins before giving up

        WhileLoop LessThan(attempts, max_attempts) {
            space = PM4_RingSpace(ring_idx)
            IfCondition GreaterEqual(space, ndwords) ThenBlock: {
                ReturnValue(1)
            }
            // Spin — like ThreadPool's StoreValue-to-scratch barrier trick,
            // reading from VRAM forces a fresh load each iteration
            attempts = Add(attempts, 1)
        }

        PrintMessage("[PM4] Ring ")
        PrintNumber(ring_idx)
        PrintMessage(" timed out waiting for ")
        PrintNumber(ndwords)
        PrintMessage(" DWORDs\n")
        ReturnValue(0)
    }
}

// =============================================================================
// PM4_EmitDWord — write a single DWORD into the ring buffer
// Does NOT update WPTR register — call PM4_Commit after building a packet.
// =============================================================================
Function.PM4_EmitDWord {
    Input: ring_idx: Integer
    Input: value: Integer
    Body: {
        ring = PM4_GetRing(ring_idx)
        IfCondition EqualTo(ring, 0) ThenBlock: { ReturnValue(0) }

        wptr = Dereference(Add(ring, RingField.WPTR))
        size = Dereference(Add(ring, RingField.RING_SIZE))

        // Wrap wptr within ring
        slot = BitwiseAnd(wptr, Subtract(size, 1))

        // Write to GART-backed host memory (system RAM) if HOST_PTR is set
        host_ptr = Dereference(Add(ring, RingField.HOST_PTR))
        IfCondition NotEqual(host_ptr, 0) ThenBlock: {
            StoreValue(Add(host_ptr, Multiply(slot, 4)), value, "dword")
        }
        IfCondition EqualTo(host_ptr, 0) ThenBlock: {
            // Fallback: write to VRAM (legacy path)
            gpu = Dereference(Add(ring, RingField.GPU_INDEX))
            vram_base = Dereference(Add(ring, RingField.VRAM_BASE))
            offset = Add(vram_base, Multiply(slot, 4))
            GPU_VramWr32(gpu, offset, value)
        }

        // Advance software WPTR (monotonic, wraps via mask on read)
        StoreValue(Add(ring, RingField.WPTR), Add(wptr, 1))
    }
}

// =============================================================================
// PM4_Commit — write the current WPTR to the hardware register
// This is the "bump tail" signal — tells the GPU new commands are ready.
// Mirrors ThreadPool's tail bump that wakes a worker.
// =============================================================================
Function.PM4_Commit {
    Input: ring_idx: Integer
    Body: {
        ring = PM4_GetRing(ring_idx)
        IfCondition EqualTo(ring, 0) ThenBlock: { ReturnValue(0) }

        gpu = Dereference(Add(ring, RingField.GPU_INDEX))
        rid = Dereference(Add(ring, RingField.RING_ID))
        wptr = Dereference(Add(ring, RingField.WPTR))

        // Write WPTR to hardware — masked to ring size
        wptr_masked = BitwiseAnd(wptr, Subtract(Dereference(Add(ring, RingField.RING_SIZE)), 1))

        // CRITICAL: Flush WC (write-combining) store buffer before bumping WPTR.
        // Ring buffer lives in VRAM mapped through a WC BAR — stores may be
        // buffered in the CPU's WC buffer and NOT yet visible to the GPU.
        // Without SFENCE, the GPU may read stale/zero data from the ring.
        // The Linux kernel relies on writel() which includes a barrier.
        InlineAsm["0f ae f8"]

        IfCondition EqualTo(rid, 0) ThenBlock: {
            GPU_Wr32(gpu, SIReg.CP_RB0_WPTR, wptr_masked)
        }
        IfCondition EqualTo(rid, 1) ThenBlock: {
            GPU_Wr32(gpu, SIReg.CP_RB1_WPTR, wptr_masked)
        }
        IfCondition EqualTo(rid, 2) ThenBlock: {
            GPU_Wr32(gpu, SIReg.CP_RB2_WPTR, wptr_masked)
        }
    }
}
