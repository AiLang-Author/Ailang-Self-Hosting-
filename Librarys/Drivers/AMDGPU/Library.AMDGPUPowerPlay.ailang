// =============================================================================
// PP_FindBootState — return index of boot state in state array
// Returns -1 if not found.
// =============================================================================
Function.PP_FindBootState {
    Input: gpu: Integer
    Output: Integer
    Body: {
        entry = PP_GetEntry(gpu)
        IfCondition EqualTo(entry, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition NotEqual(Dereference(Add(entry, PPField.PARSED)), 1) ThenBlock: { ReturnValue(-1) }
        ReturnValue(Dereference(Add(entry, PPField.BOOT_STATE_IDX)))
    }
}

// =============================================================================
// PP_FindPerformanceState — return index of 3D performance state
// Returns -1 if not found.
// =============================================================================
Function.PP_FindPerformanceState {
    Input: gpu: Integer
    Output: Integer
    Body: {
        entry = PP_GetEntry(gpu)
        IfCondition EqualTo(entry, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition NotEqual(Dereference(Add(entry, PPField.PARSED)), 1) ThenBlock: { ReturnValue(-1) }
        ReturnValue(Dereference(Add(entry, PPField.PERF_STATE_IDX)))
    }
}

// =============================================================================
// PP_GetMaxSCLK — return max engine clock from extended header (kHz)
// Falls back to AtomBIOS MAX_ENGINE_CLK if no extended header.
// =============================================================================
Function.PP_GetMaxSCLK {
    Input: gpu: Integer
    Output: Integer
    Body: {
        entry = PP_GetEntry(gpu)
        IfCondition EqualTo(entry, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(Dereference(Add(entry, PPField.PARSED)), 1) ThenBlock: { ReturnValue(0) }

        ext = Dereference(Add(entry, PPField.EXT_MAX_SCLK))
        IfCondition GreaterThan(ext, 0) ThenBlock: { ReturnValue(ext) }

        // Fallback to AtomBIOS parsed value
        ReturnValue(AtomBIOS_GetField(gpu, AtomField.MAX_ENGINE_CLK))
    }
}

// =============================================================================
// PP_GetMaxMCLK — return max memory clock from extended header (kHz)
// =============================================================================
Function.PP_GetMaxMCLK {
    Input: gpu: Integer
    Output: Integer
    Body: {
        entry = PP_GetEntry(gpu)
        IfCondition EqualTo(entry, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(Dereference(Add(entry, PPField.PARSED)), 1) ThenBlock: { ReturnValue(0) }

        ext = Dereference(Add(entry, PPField.EXT_MAX_MCLK))
        IfCondition GreaterThan(ext, 0) ThenBlock: { ReturnValue(ext) }
        ReturnValue(0)
    }
}

// =============================================================================
// PP_GetStateDPMClockIdx — get clock info index for a DPM level in a state
//
// state_idx: index into state array
// dpm_level: DPM level within that state (0-based)
// Returns the clock info array index, or -1 on error.
// =============================================================================
Function.PP_GetStateDPMClockIdx {
    Input: gpu: Integer
    Input: state_idx: Integer
    Input: dpm_level: Integer
    Output: Integer
    Body: {
        entry = PP_GetEntry(gpu)
        IfCondition EqualTo(entry, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition NotEqual(Dereference(Add(entry, PPField.PARSED)), 1) ThenBlock: { ReturnValue(-1) }

        num_states = Dereference(Add(entry, PPField.NUM_STATES))
        IfCondition GreaterEqual(state_idx, num_states) ThenBlock: { ReturnValue(-1) }

        sa_ptr = Dereference(Add(entry, PPField.STATE_ARRAY_PTR))
        state = Add(sa_ptr, Multiply(state_idx, PPStateEntry.SIZE))

        ndpm = Dereference(Add(state, PPStateEntry.NUM_DPM_LEVELS))
        IfCondition GreaterEqual(dpm_level, ndpm) ThenBlock: { ReturnValue(-1) }

        // DPM indices are packed as u8 bytes at DPM_IDX_0 offset
        ci_idx = GetByte(Add(state, PPStateEntry.DPM_IDX_0), dpm_level)
        ReturnValue(ci_idx)
    }
}

// =============================================================================
// PP_PrintInfo — print complete parsed PowerPlay information
// =============================================================================
Function.PP_PrintInfo {
    Input: gpu: Integer
    Body: {
        entry = PP_GetEntry(gpu)
        IfCondition EqualTo(entry, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(Dereference(Add(entry, PPField.PARSED)), 1) ThenBlock: {
            PrintMessage("[PP] Not parsed\n")
            ReturnValue(0)
        }

        PrintMessage("--- PowerPlay Table Info ---\n")
        PrintMessage("  PP offset:    0x")
        PrintHex(Dereference(Add(entry, PPField.PP_OFF)))
        PrintMessage("\n")
        PrintMessage("  Revision:     fmt=")
        PrintNumber(Dereference(Add(entry, PPField.FMT_REV)))
        PrintMessage(" cnt=")
        PrintNumber(Dereference(Add(entry, PPField.CNT_REV)))
        PrintMessage(" data=")
        PrintNumber(Dereference(Add(entry, PPField.DATA_REV)))
        PrintMessage("\n")
        PrintMessage("  Table size:   ")
        PrintNumber(Dereference(Add(entry, PPField.TBL_SIZE)))
        PrintMessage(" bytes\n")
        PrintMessage("  ClockInfo sz: ")
        PrintNumber(Dereference(Add(entry, PPField.CLOCK_INFO_SIZE)))
        PrintMessage(" bytes/entry\n")
        PrintMessage("  Platform:     0x")
        PrintHex(Dereference(Add(entry, PPField.PLATFORM_CAPS)))
        PrintMessage("\n\n")

        // Print clock entries
        num_ci = Dereference(Add(entry, PPField.NUM_CLOCK_ENTRIES))
        PrintMessage("  Clock Info Entries: ")
        PrintNumber(num_ci)
        PrintMessage("\n")

        ci_ptr = Dereference(Add(entry, PPField.CLOCK_ARRAY_PTR))
        j = 0
        WhileLoop LessThan(j, num_ci) {
            ce = Add(ci_ptr, Multiply(j, PPClkEntry.SIZE))
            PrintMessage("    [")
            PrintNumber(j)
            PrintMessage("] SCLK=")
            sclk = Dereference(Add(ce, PPClkEntry.SCLK))
            PrintNumber(Divide(sclk, 1000))
            PrintMessage("MHz  MCLK=")
            mclk = Dereference(Add(ce, PPClkEntry.MCLK))
            PrintNumber(Divide(mclk, 1000))
            PrintMessage("MHz  VDDC=")
            PrintNumber(Dereference(Add(ce, PPClkEntry.VDDC)))
            PrintMessage("mV  VDDCI=")
            PrintNumber(Dereference(Add(ce, PPClkEntry.VDDCI)))
            PrintMessage("mV  PCIe=Gen")
            PrintNumber(Dereference(Add(ce, PPClkEntry.PCIE_GEN)))
            PrintMessage("  flags=0x")
            PrintHex(Dereference(Add(ce, PPClkEntry.FLAGS)))
            PrintMessage("\n")
            j = Add(j, 1)
        }
        PrintMessage("\n")

        // Print states
        num_states = Dereference(Add(entry, PPField.NUM_STATES))
        boot_idx = Dereference(Add(entry, PPField.BOOT_STATE_IDX))
        perf_idx = Dereference(Add(entry, PPField.PERF_STATE_IDX))

        PrintMessage("  States: ")
        PrintNumber(num_states)
        PrintMessage("  (boot=")
        PrintNumber(boot_idx)
        PrintMessage(" perf=")
        PrintNumber(perf_idx)
        PrintMessage(")\n")

        sa_ptr = Dereference(Add(entry, PPField.STATE_ARRAY_PTR))
        j = 0
        WhileLoop LessThan(j, num_states) {
            se = Add(sa_ptr, Multiply(j, PPStateEntry.SIZE))
            PrintMessage("    [")
            PrintNumber(j)
            PrintMessage("] ")

            cls = Dereference(Add(se, PPStateEntry.CLASSIFICATION))
            IfCondition NotEqual(BitwiseAnd(cls, PPClass.BOOT), 0) ThenBlock: {
                PrintMessage("BOOT ")
            }
            IfCondition NotEqual(BitwiseAnd(cls, PPClass.PERF_3D), 0) ThenBlock: {
                PrintMessage("3DPERF ")
            }
            IfCondition NotEqual(BitwiseAnd(cls, PPClass.ACPI), 0) ThenBlock: {
                PrintMessage("ACPI ")
            }
            IfCondition NotEqual(BitwiseAnd(cls, PPClass.UVD), 0) ThenBlock: {
                PrintMessage("UVD ")
            }
            IfCondition NotEqual(BitwiseAnd(cls, PPClass.HD), 0) ThenBlock: {
                PrintMessage("HD ")
            }

            // UI class
            ui = Divide(BitwiseAnd(cls, PPClass.UI_MASK), 2048)
            IfCondition EqualTo(ui, PPClass.UI_PERFORMANCE) ThenBlock: {
                PrintMessage("[Perf] ")
            }
            IfCondition EqualTo(ui, PPClass.UI_BALANCED) ThenBlock: {
                PrintMessage("[Balanced] ")
            }
            IfCondition EqualTo(ui, PPClass.UI_BATTERY) ThenBlock: {
                PrintMessage("[Battery] ")
            }

            PrintMessage("class=0x")
            PrintHex(cls)
            PrintMessage("  DPM levels: ")
            ndpm = Dereference(Add(se, PPStateEntry.NUM_DPM_LEVELS))
            PrintNumber(ndpm)
            PrintMessage(" -> clk[")
            k = 0
            WhileLoop LessThan(k, ndpm) {
                IfCondition GreaterThan(k, 0) ThenBlock: { PrintMessage(",") }
                ci_idx = GetByte(Add(se, PPStateEntry.DPM_IDX_0), k)
                PrintNumber(ci_idx)
                k = Add(k, 1)
            }
            PrintMessage("]\n")
            j = Add(j, 1)
        }
        PrintMessage("\n")

        // Print non-clock info
        num_nc = Dereference(Add(entry, PPField.NUM_NONCLOCK))
        PrintMessage("  Non-Clock Info: ")
        PrintNumber(num_nc)
        PrintMessage(" entries\n")

        nc_ptr = Dereference(Add(entry, PPField.NONCLOCK_ARRAY_PTR))
        j = 0
        WhileLoop LessThan(j, num_nc) {
            nce = Add(nc_ptr, Multiply(j, PPNonClkEntry.SIZE))
            PrintMessage("    [")
            PrintNumber(j)
            PrintMessage("] class=0x")
            PrintHex(Dereference(Add(nce, PPNonClkEntry.CLASSIFICATION)))
            PrintMessage("  temp=")
            PrintNumber(Dereference(Add(nce, PPNonClkEntry.MIN_TEMP)))
            PrintMessage("-")
            PrintNumber(Dereference(Add(nce, PPNonClkEntry.MAX_TEMP)))
            PrintMessage("  caps=0x")
            PrintHex(Dereference(Add(nce, PPNonClkEntry.CAPS_AND_SETTINGS)))
            PrintMessage("\n")
            j = Add(j, 1)
        }
        PrintMessage("\n")

        // Print SCLK-VDDC dependency table
        svd_count = Dereference(Add(entry, PPField.SCLK_DEP_COUNT))
        IfCondition GreaterThan(svd_count, 0) ThenBlock: {
            PrintMessage("  SCLK-VDDC Dependency: ")
            PrintNumber(svd_count)
            PrintMessage(" entries\n")
            svd_ptr = Dereference(Add(entry, PPField.SCLK_DEP_PTR))
            j = 0
            WhileLoop LessThan(j, svd_count) {
                de = Add(svd_ptr, Multiply(j, PPDepEntry.SIZE))
                PrintMessage("    [")
                PrintNumber(j)
                PrintMessage("] SCLK=")
                PrintNumber(Divide(Dereference(Add(de, PPDepEntry.CLK)), 1000))
                PrintMessage("MHz  VDDC=")
                PrintNumber(Dereference(Add(de, PPDepEntry.VOLTAGE)))
                PrintMessage("mV\n")
                j = Add(j, 1)
            }
            PrintMessage("\n")
        }

        // Print MCLK-VDDCI dependency table
        mvd_count = Dereference(Add(entry, PPField.MCLK_DEP_COUNT))
        IfCondition GreaterThan(mvd_count, 0) ThenBlock: {
            PrintMessage("  MCLK-VDDCI Dependency: ")
            PrintNumber(mvd_count)
            PrintMessage(" entries\n")
            mvd_ptr = Dereference(Add(entry, PPField.MCLK_DEP_PTR))
            j = 0
            WhileLoop LessThan(j, mvd_count) {
                de = Add(mvd_ptr, Multiply(j, PPDepEntry.SIZE))
                PrintMessage("    [")
                PrintNumber(j)
                PrintMessage("] MCLK=")
                PrintNumber(Divide(Dereference(Add(de, PPDepEntry.CLK)), 1000))
                PrintMessage("MHz  VDDCI=")
                PrintNumber(Dereference(Add(de, PPDepEntry.VOLTAGE)))
                PrintMessage("mV\n")
                j = Add(j, 1)
            }
            PrintMessage("\n")
        }

        // Extended header max clocks
        ext_sclk = Dereference(Add(entry, PPField.EXT_MAX_SCLK))
        ext_mclk = Dereference(Add(entry, PPField.EXT_MAX_MCLK))
        IfCondition GreaterThan(ext_sclk, 0) ThenBlock: {
            PrintMessage("  Extended Max SCLK: ")
            PrintNumber(Divide(ext_sclk, 1000))
            PrintMessage("MHz\n")
        }
        IfCondition GreaterThan(ext_mclk, 0) ThenBlock: {
            PrintMessage("  Extended Max MCLK: ")
            PrintNumber(Divide(ext_mclk, 1000))
            PrintMessage("MHz\n")
        }

        PrintMessage("--- End PowerPlay Info ---\n")
    }
}

// =============================================================================
// PP_Free — deallocate all parsed PP data for a GPU
// =============================================================================
Function.PP_Free {
    Input: gpu: Integer
    Body: {
        entry = PP_GetEntry(gpu)
        IfCondition EqualTo(entry, 0) ThenBlock: { ReturnValue(0) }

        // Free clock array
        ci_ptr = Dereference(Add(entry, PPField.CLOCK_ARRAY_PTR))
        IfCondition NotEqual(ci_ptr, 0) ThenBlock: {
            num = Dereference(Add(entry, PPField.NUM_CLOCK_ENTRIES))
            Deallocate(ci_ptr, Multiply(num, PPClkEntry.SIZE))
        }

        // Free non-clock array
        nc_ptr = Dereference(Add(entry, PPField.NONCLOCK_ARRAY_PTR))
        IfCondition NotEqual(nc_ptr, 0) ThenBlock: {
            num = Dereference(Add(entry, PPField.NUM_NONCLOCK))
            Deallocate(nc_ptr, Multiply(num, PPNonClkEntry.SIZE))
        }

        // Free state array
        sa_ptr = Dereference(Add(entry, PPField.STATE_ARRAY_PTR))
        IfCondition NotEqual(sa_ptr, 0) ThenBlock: {
            num = Dereference(Add(entry, PPField.NUM_STATES))
            Deallocate(sa_ptr, Multiply(num, PPStateEntry.SIZE))
        }

        // Free dependency arrays
        svd_ptr = Dereference(Add(entry, PPField.SCLK_DEP_PTR))
        IfCondition NotEqual(svd_ptr, 0) ThenBlock: {
            num = Dereference(Add(entry, PPField.SCLK_DEP_COUNT))
            Deallocate(svd_ptr, Multiply(num, PPDepEntry.SIZE))
        }

        mvd_ptr = Dereference(Add(entry, PPField.MCLK_DEP_PTR))
        IfCondition NotEqual(mvd_ptr, 0) ThenBlock: {
            num = Dereference(Add(entry, PPField.MCLK_DEP_COUNT))
            Deallocate(mvd_ptr, Multiply(num, PPDepEntry.SIZE))
        }

        // Zero the entry
        MemorySet(entry, 0, PPField.ENTRY_SIZE)
    }
}
