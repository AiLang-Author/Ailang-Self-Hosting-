    Body: {
        entry = PP_GetEntry(gpu)
        IfCondition EqualTo(entry, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(Dereference(Add(entry, PPField.PARSED)), 1) ThenBlock: { ReturnValue(0) }
        ReturnValue(Dereference(Add(entry, PPField.SCLK_DEP_COUNT)))
    }
}

// =============================================================================
// PP_GetSclkDepEntry — copy one SCLK-VDDC dependency entry
// =============================================================================
Function.PP_GetSclkDepEntry {
    Input: gpu: Integer
    Input: idx: Integer
    Input: out_ptr: Address
    Output: Integer
    Body: {
        entry = PP_GetEntry(gpu)
        IfCondition EqualTo(entry, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(Dereference(Add(entry, PPField.PARSED)), 1) ThenBlock: { ReturnValue(0) }

        num = Dereference(Add(entry, PPField.SCLK_DEP_COUNT))
        IfCondition GreaterEqual(idx, num) ThenBlock: { ReturnValue(0) }

        ptr = Dereference(Add(entry, PPField.SCLK_DEP_PTR))
        IfCondition EqualTo(ptr, 0) ThenBlock: { ReturnValue(0) }

        src = Add(ptr, Multiply(idx, PPDepEntry.SIZE))
        MemoryCopy(out_ptr, src, PPDepEntry.SIZE)
        ReturnValue(1)
    }
}

