//
// Library.AMDGPUSMC.ailang
//
// SMC (System Management Controller) dispatch layer.
// Routes SMC operations to generation-specific backends based on GPUGen.
//
// Currently supports:
//   - GCN 1.0 (Southern Islands): Library.AMDGPUSMC_SI
//
// To add a new generation:
//   1. Create Library.AMDGPUSMC_<GEN>.ailang
//   2. Add LibraryImport below
//   3. Add IfCondition branch in each dispatch function
//
// USAGE
//   LibraryImport.Drivers.AMDGPU.AMDGPUSMC
//
// DEPENDS
//   LibraryImport.Drivers.AMDGPU.AMDGPUSMCRegs
//   LibraryImport.Drivers.AMDGPU.AMDGPUSMC_SI
//   LibraryImport.Drivers.AMDGPU.AMDGPUFamily
//   LibraryImport.Drivers.AMDGPU.AMDGPUDiscover

// =============================================================================
// SMC_Init — initialize SMC state for all GPUs
// =============================================================================
Function.SMC_Init {
    Body: {
        SMC_SI_Init()
    }
}

// =============================================================================
// SMC_LoadFirmware — load and upload SMC firmware for a GPU
// Returns 1 on success, negative on error.
// =============================================================================
Function.SMC_LoadFirmware {
    Input: gpu: Integer
    Output: Integer
    Body: {
        gen = GPU_GetDeviceField(gpu, GPUDevField.GENERATION)
        IfCondition EqualTo(gen, GPUGen.SI) ThenBlock: {
            ReturnValue(SMC_SI_LoadFirmware(gpu))
        }
        // Future:
        // IfCondition EqualTo(gen, GPUGen.CIK) ThenBlock: {
        //     ReturnValue(SMC_CIK_LoadFirmware(gpu))
        // }
        PrintMessage("[SMC] Unsupported GPU generation: ")
        PrintNumber(gen)
        PrintMessage("\n")
        ReturnValue(-1)
    }
}

// =============================================================================
// SMC_StartSMC — deassert reset and enable SMC clock
// =============================================================================
Function.SMC_StartSMC {
    Input: gpu: Integer
    Output: Integer
    Body: {
        gen = GPU_GetDeviceField(gpu, GPUDevField.GENERATION)
        IfCondition EqualTo(gen, GPUGen.SI) ThenBlock: {
            ReturnValue(SMC_SI_StartSMC(gpu))
        }
        ReturnValue(-1)
    }
}

// =============================================================================
// SMC_StopSMC — disable SMC clock and assert reset
// =============================================================================
Function.SMC_StopSMC {
    Input: gpu: Integer
    Output: Integer
    Body: {
        gen = GPU_GetDeviceField(gpu, GPUDevField.GENERATION)
        IfCondition EqualTo(gen, GPUGen.SI) ThenBlock: {
            ReturnValue(SMC_SI_StopSMC(gpu))
        }
        ReturnValue(-1)
    }
}

// =============================================================================
// SMC_SendMessage — send a PPSMC command and wait for response
// Returns response code (1=OK, 0xFF=failed, 0=timeout)
// =============================================================================
Function.SMC_SendMessage {
    Input: gpu: Integer
    Input: msg: Integer
    Output: Integer
    Body: {
        gen = GPU_GetDeviceField(gpu, GPUDevField.GENERATION)
        IfCondition EqualTo(gen, GPUGen.SI) ThenBlock: {
            ReturnValue(SMC_SI_SendMessage(gpu, msg))
        }
        ReturnValue(SMCResp.FAILED)
    }
}

// =============================================================================
// SMC_SendMessageArg — send a PPSMC command with parameter
// =============================================================================
Function.SMC_SendMessageArg {
    Input: gpu: Integer
    Input: msg: Integer
    Input: arg: Integer
    Output: Integer
    Body: {
        gen = GPU_GetDeviceField(gpu, GPUDevField.GENERATION)
        IfCondition EqualTo(gen, GPUGen.SI) ThenBlock: {
            ReturnValue(SMC_SI_SendMessageArg(gpu, msg, arg))
        }
        ReturnValue(SMCResp.FAILED)
    }
}

// =============================================================================
// SMC_IsRunning — check if SMC is alive
// =============================================================================
Function.SMC_IsRunning {
    Input: gpu: Integer
    Output: Integer
    Body: {
        gen = GPU_GetDeviceField(gpu, GPUDevField.GENERATION)
        IfCondition EqualTo(gen, GPUGen.SI) ThenBlock: {
            ReturnValue(SMC_SI_IsRunning(gpu))
        }
        ReturnValue(0)
    }
}

// =============================================================================
// SMC_ReadSRAM — read a 32-bit word from SMC SRAM
// =============================================================================
Function.SMC_ReadSRAM {
    Input: gpu: Integer
    Input: addr: Integer
    Output: Integer
    Body: {
        gen = GPU_GetDeviceField(gpu, GPUDevField.GENERATION)
        IfCondition EqualTo(gen, GPUGen.SI) ThenBlock: {
            ReturnValue(SMC_SI_ReadSRAM32(gpu, addr))
        }
        ReturnValue(0)
    }
}

// =============================================================================
// SMC_WriteSRAM — write a 32-bit word to SMC SRAM
// =============================================================================
Function.SMC_WriteSRAM {
    Input: gpu: Integer
    Input: addr: Integer
    Input: value: Integer
    Body: {
        gen = GPU_GetDeviceField(gpu, GPUDevField.GENERATION)
        IfCondition EqualTo(gen, GPUGen.SI) ThenBlock: {
            SMC_SI_WriteSRAM32(gpu, addr, value)
        }
    }
}

// =============================================================================
// SMC_WriteSRAMBlock — bulk write to SMC SRAM with auto-increment
// =============================================================================
Function.SMC_WriteSRAMBlock {
    Input: gpu: Integer
    Input: addr: Integer
    Input: src_ptr: Address
    Input: num_dwords: Integer
    Body: {
        gen = GPU_GetDeviceField(gpu, GPUDevField.GENERATION)
        IfCondition EqualTo(gen, GPUGen.SI) ThenBlock: {
            SMC_SI_WriteSRAMBlock(gpu, addr, src_ptr, num_dwords)
        }
    }
}

// =============================================================================
// SMC_ReadSRAMBlock — bulk read from SMC SRAM with auto-increment
// =============================================================================
Function.SMC_ReadSRAMBlock {
    Input: gpu: Integer
    Input: addr: Integer
    Input: dst_ptr: Address
    Input: num_dwords: Integer
    Body: {
        gen = GPU_GetDeviceField(gpu, GPUDevField.GENERATION)
        IfCondition EqualTo(gen, GPUGen.SI) ThenBlock: {
            SMC_SI_ReadSRAMBlock(gpu, addr, dst_ptr, num_dwords)
        }
    }
}

// =============================================================================
// SMC_WaitInactive — wait for SMC to become inactive after HALT
// =============================================================================
Function.SMC_WaitInactive {
    Input: gpu: Integer
    Output: Integer
    Body: {
        gen = GPU_GetDeviceField(gpu, GPUDevField.GENERATION)
        IfCondition EqualTo(gen, GPUGen.SI) ThenBlock: {
            ReturnValue(SMC_SI_WaitInactive(gpu))
        }
        ReturnValue(0)
    }
}
