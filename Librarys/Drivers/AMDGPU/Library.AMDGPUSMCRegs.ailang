//
// Library.AMDGPUSMCRegs.ailang
//
// SMC (System Management Controller) register constants, message codes,
// and bit field definitions for AMD GPU power/clock management.
//
// The SMC is an ARM-derived core embedded on the GPU die that manages
// clocks, voltages, and thermal sensors autonomously.
//
// REGISTER ACCESS METHODS:
//   Direct MMIO:   GPU_Rd32(gpu, SMCReg.*)   — registers at BAR2 offsets
//   SMC Indirect:  Write addr to IND_INDEX_0, read/write IND_DATA_0
//                  Used for SMC_SYSCON_* registers (addr >= 0x80000000)
//   SMC SRAM:      Same indirect path, addresses 0x00000-0x20000
//
// USAGE
//   LibraryImport.Drivers.AMDGPU.AMDGPUSMCRegs
//

// =============================================================================
// SMC INDIRECT ACCESS REGISTERS (Direct MMIO)
// =============================================================================
// These are BAR2 MMIO-mapped registers for accessing SMC SRAM and
// SMC internal registers (syscon) via indirect read/write.
FixedPool.SMCReg {
    // Indirect access pair — write target address to INDEX, read/write DATA
    "IND_INDEX_0":          Initialize=512       // 0x200
    "IND_DATA_0":           Initialize=516       // 0x204
    "IND_INDEX_1":          Initialize=520       // 0x208
    "IND_DATA_1":           Initialize=524       // 0x20C
    "IND_ACCESS_CNTL":      Initialize=552       // 0x228

    // SMC message interface (direct MMIO)
    "MESSAGE_0":            Initialize=556       // 0x22C — write PPSMC command here
    "RESP_0":               Initialize=560       // 0x230 — read response here

    // SMC scratch register (direct MMIO) — used for message parameters
    "SCRATCH0":             Initialize=2180      // 0x884

    // CB_CGTT_SCLK_CTRL (direct MMIO) — used for dummy reads during reset
    "CB_CGTT_SCLK_CTRL":   Initialize=39520     // 0x9A60
}

// =============================================================================
// SMC INDIRECT REGISTER ADDRESSES (via IND_INDEX_0/IND_DATA_0 path)
// =============================================================================
// These registers live in the SMC's internal address space (>= 0x80000000).
// Access: GPU_Wr32(gpu, SMCReg.IND_INDEX_0, SMCSyscon.*)
//         GPU_Rd32(gpu, SMCReg.IND_DATA_0)  or  GPU_Wr32(gpu, SMCReg.IND_DATA_0, val)
FixedPool.SMCSyscon {
    "RESET_CNTL":           Initialize=2147483648   // 0x80000000
    "CLOCK_CNTL_0":         Initialize=2147483652   // 0x80000004
    "MISC_CNTL":            Initialize=2147483664   // 0x80000010
}

// =============================================================================
// BIT FIELD CONSTANTS
// =============================================================================
FixedPool.SMCAccessBits {
    "AUTO_INCREMENT":       Initialize=1         // bit 0 of IND_ACCESS_CNTL
}

FixedPool.SMCSysconBits {
    "RST_REG":              Initialize=1         // bit 0 of RESET_CNTL: assert reset
    "CK_DISABLE":           Initialize=1         // bit 0 of CLOCK_CNTL_0: disable clock
    "CKEN":                 Initialize=16777216  // bit 24 of CLOCK_CNTL_0: clock active indicator
}

// =============================================================================
// SMC SRAM CONSTANTS
// =============================================================================
FixedPool.SMCConst {
    "SRAM_END":             Initialize=131072    // 0x20000 (128KB SRAM)
    "BOOTSTRAP_INST":       Initialize=234897472 // 0x0E004040 — Thumb branch to firmware entry
    "SI_UCODE_START":       Initialize=65536     // 0x10000 — all SI chips (Verde/Tahiti/Pitcairn/Oland/Hainan)
    "CIK_UCODE_START":      Initialize=131072    // 0x20000 — CI chips (Bonaire/Hawaii) (future)
}

// =============================================================================
// FIRMWARE PATHS PER CHIP (Southern Islands)
// =============================================================================
FixedPool.SMCFWPath {
    "VERDE":                Initialize="/lib/firmware/radeon/VERDE_smc.bin"
    "VERDE_K":              Initialize="/lib/firmware/radeon/verde_k_smc.bin"
    "TAHITI":               Initialize="/lib/firmware/radeon/TAHITI_smc.bin"
    "PITCAIRN":             Initialize="/lib/firmware/radeon/PITCAIRN_smc.bin"
    "OLAND":                Initialize="/lib/firmware/radeon/OLAND_smc.bin"
    "HAINAN":               Initialize="/lib/firmware/radeon/HAINAN_smc.bin"
}

// =============================================================================
// PPSMC MESSAGE CODES (PPSMC_MSG_*)
// =============================================================================
// Commands sent to the SMC via SMCReg.MESSAGE_0.
// Response read from SMCReg.RESP_0: 1=OK, 0xFF=failed.
FixedPool.SMCMsg {
    // Basic control
    "TEST":                 Initialize=1         // 0x01 — test if SMC is alive
    "HALT":                 Initialize=16        // 0x10 — halt SMC execution
    "RESUME":               Initialize=17        // 0x11 — resume SMC execution

    // DPM level control
    "ZERO_LEVELS_DISABLED": Initialize=19        // 0x13 — all DPM levels enabled
    "ONE_LEVEL_DISABLED":   Initialize=20        // 0x14 — 1 DPM level disabled
    "TWO_LEVELS_DISABLED":  Initialize=21        // 0x15 — 2 DPM levels disabled
    "ENABLE_THERMAL_INT":   Initialize=22        // 0x16

    // Power source
    "RUNNING_ON_AC":        Initialize=23        // 0x17
    "RUNNING_ON_DC":        Initialize=24        // 0x18

    // State switching
    "SWITCH_TO_SWSTATE":    Initialize=32        // 0x20 — activate driver state table
    "SWITCH_TO_INITIAL":    Initialize=64        // 0x40 — switch to boot state
    "NO_FORCED_LEVEL":      Initialize=65        // 0x41 — remove forced DPM level
    "FORCE_HIGH":           Initialize=66        // 0x42 — force highest DPM level
    "FORCE_MEDIUM_OR_HIGH": Initialize=67        // 0x43

    // Power management
    "SWITCH_TO_MIN_POWER":  Initialize=81        // 0x51
    "RESUME_FROM_MIN_POWER":Initialize=82        // 0x52
    "ENABLE_CAC":           Initialize=83        // 0x53 — enable CAC monitoring
    "DISABLE_CAC":          Initialize=84        // 0x54
    "TDP_CLAMPING_ACTIVE":  Initialize=89        // 0x59 — enable TDP power clamping
    "TDP_CLAMPING_INACTIVE":Initialize=90        // 0x5A — disable TDP power clamping

    // Fan control
    "START_FAN_CONTROL":    Initialize=91        // 0x5B
    "STOP_FAN_CONTROL":     Initialize=92        // 0x5C

    // Display notification
    "NO_DISPLAY":           Initialize=93        // 0x5D
    "HAS_DISPLAY":          Initialize=94        // 0x5E

    // UVD (video decoder) power
    "UVD_POWER_OFF":        Initialize=96        // 0x60
    "UVD_POWER_ON":         Initialize=97        // 0x61

    // Ultra Low Voltage
    "ENABLE_ULV":           Initialize=98        // 0x62
    "DISABLE_ULV":          Initialize=99        // 0x63
    "ENTER_ULV":            Initialize=100       // 0x64
    "EXIT_ULV":             Initialize=101       // 0x65

    // CAC long term averaging
    "CAC_LTA_ENABLE":       Initialize=110       // 0x6E
    "CAC_LTA_DISABLE":      Initialize=111       // 0x6F

    // Cache and data management
    "FLUSH_DATA_CACHE":     Initialize=128       // 0x80

    // Advanced DPM control (use with SMC_SCRATCH0 parameter)
    "SET_ENABLED_LEVELS":   Initialize=130       // 0x82
    "SET_FORCED_LEVELS":    Initialize=131       // 0x83
    "RESET_TO_DEFAULTS":    Initialize=132       // 0x84

    // DTE (Digital Thermal Estimation)
    "ENABLE_DTE":           Initialize=135       // 0x87
    "DISABLE_DTE":          Initialize=136       // 0x88

    // SCLK deep sleep throttle
    "THROTTLE_SCLK_DS":     Initialize=150       // 0x96
    "CANCEL_THROTTLE_DS":   Initialize=151       // 0x97
}

// =============================================================================
// PPSMC RESPONSE CODES
// =============================================================================
FixedPool.SMCResp {
    "OK":                   Initialize=1         // 0x01 — command succeeded
    "FAILED":               Initialize=255       // 0xFF — command failed
}

// =============================================================================
// DPM-RELATED POWER MANAGEMENT REGISTERS (Direct MMIO)
// =============================================================================
// These are NOT in Library.AMDGPUPM4Regs.ailang — separate to keep files focused.
FixedPool.DPMReg {
    "GENERAL_PWRMGT":       Initialize=1920      // 0x780
    "CG_TPC":               Initialize=1924      // 0x784
    "SCLK_PWRMGT_CNTL":    Initialize=1928      // 0x788
    "TARGET_AND_CURRENT_PROFILE_INDEX": Initialize=1944  // 0x798

    // Thermal
    "CG_THERMAL_CTRL":      Initialize=1792      // 0x700
    "CG_THERMAL_STATUS":    Initialize=1796      // 0x704
    "CG_THERMAL_INT":       Initialize=1800      // 0x708
    "CG_MULT_THERMAL_CTRL": Initialize=1808      // 0x710
    "CG_MULT_THERMAL_STATUS": Initialize=1812    // 0x714

    // Fan
    "CG_FDO_CTRL0":        Initialize=1876      // 0x754
    "CG_FDO_CTRL1":        Initialize=1880      // 0x758
    "CG_FDO_CTRL2":        Initialize=1884      // 0x75C

    // DPM clock control registers
    "CG_SPLL_AUTOSCALE_CNTL": Initialize=1580   // 0x62C
    "MISC_CLK_CNTL":       Initialize=1648      // 0x670
    "CG_FTV":              Initialize=1980      // 0x7BC
    "CG_FFCT_0":           Initialize=1984      // 0x7C0
    "CG_BSP":              Initialize=2044      // 0x7FC
    "CG_GIT":              Initialize=2052      // 0x804
    "CG_SSP":              Initialize=2060      // 0x80C
    "CG_DISPLAY_GAP_CNTL": Initialize=2088      // 0x828

    // MC ARB registers (memory controller arbitration)
    "MC_CG_CONFIG":        Initialize=9660      // 0x25BC
    "MC_ARB_DRAM_TIMING":  Initialize=10100     // 0x2774
    "MC_ARB_DRAM_TIMING2": Initialize=10104     // 0x2778
    "MC_ARB_CG":           Initialize=10216     // 0x27E8
    "MC_ARB_DRAM_TIMING_1":  Initialize=10224   // 0x27F0
    "MC_ARB_DRAM_TIMING2_1": Initialize=10236   // 0x27FC
    "MC_ARB_BURST_TIME":   Initialize=10248     // 0x2808
}

// =============================================================================
// GENERAL_PWRMGT BIT FIELDS
// =============================================================================
FixedPool.PwrMgtBits {
    "GLOBAL_PWRMGT_EN":     Initialize=1         // bit 0: global power management enable
    "STATIC_PM_EN":         Initialize=2         // bit 1
    "THERMAL_PROTECTION_DIS": Initialize=4       // bit 2
    "GPU_COUNTER_CLK":      Initialize=16        // bit 4: GPU counter clock source
    "DYN_SPREAD_SPECTRUM_EN": Initialize=8388608 // bit 23
    "VOLT_PWRMGT_EN":       Initialize=1024      // bit 10: master voltage management
}

// =============================================================================
// SCLK_PWRMGT_CNTL BIT FIELDS
// =============================================================================
FixedPool.SclkPwrBits {
    "SCLK_PWRMGT_OFF":      Initialize=1         // bit 0: disable SCLK power management
    "FIR_RESET":             Initialize=16        // bit 4
    "DYN_GFX_CLK_OFF_EN":  Initialize=128       // bit 7
    "DYN_LIGHT_SLEEP_EN":   Initialize=16384     // bit 14
    "RESET_BUSY_CNT":       Initialize=65536     // bit 16
    "RESET_SCLK_CNT":       Initialize=131072    // bit 17
}

// =============================================================================
// SMC FIRMWARE HEADER OFFSETS (at SRAM 0x10000)
// =============================================================================
FixedPool.SMCFWHdr {
    "VERSION":              Initialize=0         // u32
    "FLAGS":                Initialize=4         // u32
    "SOFT_REGS":            Initialize=12        // u32: SRAM addr of soft registers
    "STATE_TABLE":          Initialize=16        // u32: SRAM addr of state table
    "FAN_TABLE":            Initialize=20        // u32: SRAM addr of fan table
    "CAC_CONFIG":           Initialize=24        // u32: SRAM addr of CAC config
    "MC_REG_TABLE":         Initialize=36        // u32: SRAM addr of MC reg table
    "MC_ARB_TABLE":         Initialize=48        // u32: SRAM addr of ARB table
    "SPLL_TABLE":           Initialize=56        // u32: SRAM addr of SPLL table
}

// =============================================================================
// SMC SOFT REGISTER OFFSETS (relative to soft_regs_start)
// =============================================================================
FixedPool.SMCSoftReg {
    "MCLK_CHG_TIMEOUT":    Initialize=0         // 0x00
    "DELAY_VREG":           Initialize=12        // 0x0C
    "DELAY_ACPI":           Initialize=40        // 0x28
    "SEQ_INDEX":            Initialize=92        // 0x5C
    "MVDD_CHG_TIME":        Initialize=96        // 0x60
    "MCLK_SWITCH_LIM":     Initialize=112       // 0x70
    "WM_THRESHOLD":         Initialize=120       // 0x78
    "PHASE_SHED_DELAY":    Initialize=136       // 0x88
    "MC_BLOCK_DELAY":      Initialize=152       // 0x98
    "TICKS_PER_US":         Initialize=168       // 0xA8
    "CRTC_INDEX":           Initialize=196       // 0xC4
    "NON_ULV_PCIE_WIDTH":  Initialize=244       // 0xF4
    "VR_HOT_GPIO":          Initialize=256       // 0x100
}
