// =============================================================================
// Volt_GetVDDCIGPIOID — return GPIO ID for a VDDCI voltage step
// =============================================================================
Function.Volt_GetVDDCIGPIOID {
    Input: gpu: Integer
    Input: idx: Integer
    Output: Integer
    Body: {
        entry = Volt_GetEntry(gpu)
        IfCondition EqualTo(entry, 0) ThenBlock: { ReturnValue(0) }

        count = Dereference(Add(entry, VoltField.VDDCI_COUNT))
