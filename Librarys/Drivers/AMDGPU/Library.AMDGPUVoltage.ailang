        ptr = Dereference(Add(entry, VoltField.VDDCI_PTR))
        ve = Add(ptr, Multiply(idx, VoltEntry.SIZE))
        ReturnValue(Dereference(Add(ve, VoltEntry.GPIO_ID)))
