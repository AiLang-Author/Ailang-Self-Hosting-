// =============================================================================
// Volt_PrintInfo — print voltage table information
// =============================================================================
Function.Volt_PrintInfo {
    Input: gpu: Integer
    Body: {
        entry = Volt_GetEntry(gpu)
        IfCondition EqualTo(entry, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(Dereference(Add(entry, VoltField.PARSED)), 1) ThenBlock: {
            PrintMessage("[Volt] Not parsed\n")
            ReturnValue(0)
        }

        PrintMessage("--- Voltage Info ---\n")
        PrintMessage("  Boot VDDC:    ")
        PrintNumber(Dereference(Add(entry, VoltField.BOOT_VDDC)))
        PrintMessage(" mV\n")

        // VDDC info
        vddc_mode = Dereference(Add(entry, VoltField.VDDC_MODE))
        PrintMessage("  VDDC mode:    ")
        IfCondition EqualTo(vddc_mode, VoltMode.GPIO_LUT) ThenBlock: {
            PrintMessage("GPIO LUT\n")
        }
        IfCondition EqualTo(vddc_mode, VoltMode.SVID2) ThenBlock: {
            PrintMessage("SVID2\n")
            PrintMessage("  LoadLine/PSI: 0x")
            PrintHex(Dereference(Add(entry, VoltField.SVID2_LOADLINE)))
            PrintMessage("\n")
            PrintMessage("  SVD GPIO:     ")
            PrintNumber(Dereference(Add(entry, VoltField.SVID2_SVD_GPIO)))
            PrintMessage("\n")
            PrintMessage("  SVC GPIO:     ")
            PrintNumber(Dereference(Add(entry, VoltField.SVID2_SVC_GPIO)))
            PrintMessage("\n")
        }
        IfCondition EqualTo(vddc_mode, 0) ThenBlock: {
            IfCondition NotEqual(vddc_mode, VoltMode.GPIO_LUT) ThenBlock: {
                // Mode 0 but not GPIO (which is also 0) — only hit if no VDDC object found
                PrintMessage("None\n")
            }
        }

        // VDDC GPIO LUT entries
        vddc_count = Dereference(Add(entry, VoltField.VDDC_COUNT))
        IfCondition GreaterThan(vddc_count, 0) ThenBlock: {
            PrintMessage("  VDDC entries: ")
            PrintNumber(vddc_count)
            PrintMessage("  mask=0x")
            PrintHex(Dereference(Add(entry, VoltField.VDDC_MASK)))
            PrintMessage("  delay=")
            PrintNumber(Dereference(Add(entry, VoltField.VDDC_PHASE_DELAY)))
            PrintMessage("us\n")

            ptr = Dereference(Add(entry, VoltField.VDDC_PTR))
            j = 0
            WhileLoop LessThan(j, vddc_count) {
                ve = Add(ptr, Multiply(j, VoltEntry.SIZE))
                PrintMessage("    [")
                PrintNumber(j)
                PrintMessage("] ")
                PrintNumber(Dereference(Add(ve, VoltEntry.VOLTAGE)))
                PrintMessage("mV  gpio_id=0x")
                PrintHex(Dereference(Add(ve, VoltEntry.GPIO_ID)))
                PrintMessage("\n")
                j = Add(j, 1)
            }

            PrintMessage("  Min VDDC:     ")
            PrintNumber(Dereference(Add(entry, VoltField.MIN_VDDC)))
            PrintMessage(" mV\n")
            PrintMessage("  Max VDDC:     ")
            PrintNumber(Dereference(Add(entry, VoltField.MAX_VDDC)))
            PrintMessage(" mV\n")
        }

        // VDDCI info
        vddci_count = Dereference(Add(entry, VoltField.VDDCI_COUNT))
        IfCondition GreaterThan(vddci_count, 0) ThenBlock: {
            PrintMessage("  VDDCI entries: ")
            PrintNumber(vddci_count)
            PrintMessage("  mask=0x")
            PrintHex(Dereference(Add(entry, VoltField.VDDCI_MASK)))
            PrintMessage("\n")
        }

        // Phase shedding
        phase_count = Dereference(Add(entry, VoltField.PHASE_COUNT))
        IfCondition GreaterThan(phase_count, 0) ThenBlock: {
            PrintMessage("  Phase entries: ")
            PrintNumber(phase_count)
            PrintMessage("  mask=0x")
            PrintHex(Dereference(Add(entry, VoltField.PHASE_MASK)))
            PrintMessage("\n")

            phase_ptr = Dereference(Add(entry, VoltField.PHASE_PTR))
            j = 0
            WhileLoop LessThan(j, phase_count) {
                ve = Add(phase_ptr, Multiply(j, VoltEntry.SIZE))
                PrintMessage("    [")
                PrintNumber(j)
                PrintMessage("] ")
                PrintNumber(Dereference(Add(ve, VoltEntry.VOLTAGE)))
                PrintMessage("mV  gpio_id=0x")
                PrintHex(Dereference(Add(ve, VoltEntry.GPIO_ID)))
                PrintMessage("\n")
                j = Add(j, 1)
            }
        }

        // Leakage table
        leak_count = Dereference(Add(entry, VoltField.LEAK_COUNT))
        IfCondition GreaterThan(leak_count, 0) ThenBlock: {
            PrintMessage("  Leakage entries: ")
            PrintNumber(leak_count)
            PrintMessage("\n")

            leak_ptr = Dereference(Add(entry, VoltField.LEAK_PTR))
            j = 0
            WhileLoop LessThan(j, leak_count) {
                le = Add(leak_ptr, Multiply(j, LeakEntry.SIZE))
                PrintMessage("    [")
                PrintNumber(j)
                PrintMessage("] ")
                PrintNumber(Dereference(Add(le, LeakEntry.VOLTAGE)))
                PrintMessage("mV  vid=0x")
                PrintHex(Dereference(Add(le, LeakEntry.VOLTAGE_ID)))
                PrintMessage("  leak_id=0x")
                PrintHex(Dereference(Add(le, LeakEntry.LEAKAGE_ID)))
                PrintMessage("\n")
                j = Add(j, 1)
            }
        }

        PrintMessage("--- End Voltage Info ---\n")
    }
}

// =============================================================================
// Volt_Free — deallocate voltage data for a GPU
// =============================================================================
Function.Volt_Free {
    Input: gpu: Integer
    Body: {
        entry = Volt_GetEntry(gpu)
        IfCondition EqualTo(entry, 0) ThenBlock: { ReturnValue(0) }

        // Free VDDC table
        ptr = Dereference(Add(entry, VoltField.VDDC_PTR))
        IfCondition NotEqual(ptr, 0) ThenBlock: {
            Deallocate(ptr, Multiply(Dereference(Add(entry, VoltField.VDDC_COUNT)), VoltEntry.SIZE))
        }

        // Free VDDCI table
        ptr = Dereference(Add(entry, VoltField.VDDCI_PTR))
        IfCondition NotEqual(ptr, 0) ThenBlock: {
            Deallocate(ptr, Multiply(Dereference(Add(entry, VoltField.VDDCI_COUNT)), VoltEntry.SIZE))
        }

        // Free MVDD table
        ptr = Dereference(Add(entry, VoltField.MVDD_PTR))
        IfCondition NotEqual(ptr, 0) ThenBlock: {
            Deallocate(ptr, Multiply(Dereference(Add(entry, VoltField.MVDD_COUNT)), VoltEntry.SIZE))
        }

        // Free phase table
        ptr = Dereference(Add(entry, VoltField.PHASE_PTR))
        IfCondition NotEqual(ptr, 0) ThenBlock: {
            Deallocate(ptr, Multiply(Dereference(Add(entry, VoltField.PHASE_COUNT)), VoltEntry.SIZE))
        }

        // Free leakage table
        ptr = Dereference(Add(entry, VoltField.LEAK_PTR))
        IfCondition NotEqual(ptr, 0) ThenBlock: {
            Deallocate(ptr, Multiply(Dereference(Add(entry, VoltField.LEAK_COUNT)), LeakEntry.SIZE))
        }

        MemorySet(entry, 0, VoltField.ENTRY_SIZE)
    }
}
