// Encoding identifier bits (top bits of first DWORD)
// SOP2:  [31:30] = 10
// SOPK:  [31:28] = 1011
// SOP1:  [31:23] = 101111101
// SOPC:  [31:23] = 101111110
// SOPP:  [31:23] = 101111111
// SMRD:  [31:27] = 11000
// VOP2:  [31]    = 0, [30:25] != 0x3F/0x3E
// VOP1:  [31:25] = 0111111
// VOPC:  [31:25] = 0111110
// VOP3:  [31:26] = 110100
// MUBUF: [31:26] = 111000
// MTBUF: [31:26] = 111010
// DS:    [31:26] = 110110
// EXP:   [31:26] = 110001

FixedPool.GCNEncState {
    "desc":   Initialize=0, CanChange=True
    "word0":  Initialize=0, CanChange=True
    "word1":  Initialize=0, CanChange=True
}

Function.GCNEnc_Opcode {
    Input: desc: Integer
    Output: Integer
    Body: { ReturnValue(BitwiseAnd(desc, 511)) }
}

Function.GCNEnc_EncFmt {
    Input: desc: Integer
    Output: Integer
    Body: { ReturnValue(BitwiseAnd(RightShift(desc, 9), 15)) }
}

Function.GCNEnc_Group {
    Input: desc: Integer
    Output: Integer
    Body: { ReturnValue(BitwiseAnd(RightShift(desc, 13), 7)) }
}

Function.GCNEnc_Is64Bit {
    Input: desc: Integer
    Output: Integer
    Body: { ReturnValue(BitwiseAnd(RightShift(desc, 16), 1)) }
}

Function.GCNEnc_NumOps {
    Input: desc: Integer
    Output: Integer
    Body: { ReturnValue(BitwiseAnd(RightShift(desc, 17), 7)) }
}

// GCNEnc_RegNum: register name → encoding number
// v0-v255 → 256-511, s0-s103 → 0-103
// Special: vcc_lo=106, vcc_hi=107, exec_lo=126, exec_hi=127, m0=124
// Inline constants: 0=128, 1-64=129-192, -1-(-16)=193-208
// 0.5=240, -0.5=241, 1.0=242, -1.0=243, 2.0=244, -2.0=245, 4.0=246, -4.0=247
// literal=255
Function.GCNEnc_RegNum {
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(StringCompare(name, "vcc_lo"), 0) ThenBlock: { ReturnValue(106) }
        IfCondition EqualTo(StringCompare(name, "vcc_hi"), 0) ThenBlock: { ReturnValue(107) }
        IfCondition EqualTo(StringCompare(name, "vcc"), 0) ThenBlock: { ReturnValue(106) }
        IfCondition EqualTo(StringCompare(name, "exec_lo"), 0) ThenBlock: { ReturnValue(126) }
        IfCondition EqualTo(StringCompare(name, "exec_hi"), 0) ThenBlock: { ReturnValue(127) }
        IfCondition EqualTo(StringCompare(name, "exec"), 0) ThenBlock: { ReturnValue(126) }
        IfCondition EqualTo(StringCompare(name, "m0"), 0) ThenBlock: { ReturnValue(124) }
        IfCondition EqualTo(StringCompare(name, "scc"), 0) ThenBlock: { ReturnValue(253) }
        IfCondition EqualTo(StringCompare(name, "literal"), 0) ThenBlock: { ReturnValue(255) }
        IfCondition EqualTo(StringCompare(name, "null"), 0) ThenBlock: { ReturnValue(125) }
        IfCondition EqualTo(StringCompare(name, "s0"), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(StringCompare(name, "s1"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "s2"), 0) ThenBlock: { ReturnValue(2) }
        IfCondition EqualTo(StringCompare(name, "s3"), 0) ThenBlock: { ReturnValue(3) }
        IfCondition EqualTo(StringCompare(name, "s4"), 0) ThenBlock: { ReturnValue(4) }
