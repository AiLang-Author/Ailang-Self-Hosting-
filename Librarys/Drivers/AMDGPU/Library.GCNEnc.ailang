        IfCondition EqualTo(StringCompare(name, "v252"), 0) ThenBlock: { ReturnValue(508) }
        IfCondition EqualTo(StringCompare(name, "v253"), 0) ThenBlock: { ReturnValue(509) }
        IfCondition EqualTo(StringCompare(name, "v254"), 0) ThenBlock: { ReturnValue(510) }
        IfCondition EqualTo(StringCompare(name, "v255"), 0) ThenBlock: { ReturnValue(511) }
        ReturnValue(-1)
    }
}

Function.GCNEnc_Emit_SOP2 {
    Input: op: Integer
    Input: sdst: Integer
    Input: ssrc0: Integer
    Input: ssrc1: Integer
    Output: Integer
    Body: {
        w = ssrc0
        w = BitwiseOr(w, LeftShift(ssrc1, 8))
        w = BitwiseOr(w, LeftShift(sdst, 16))
        w = BitwiseOr(w, LeftShift(op, 23))
        w = BitwiseOr(w, LeftShift(2, 30))
        GCNEncState.word0 = w
        ReturnValue(4)
    }
}

Function.GCNEnc_Emit_SOP1 {
    Input: op: Integer
    Input: sdst: Integer
    Input: ssrc0: Integer
    Output: Integer
    Body: {
        w = ssrc0
        w = BitwiseOr(w, LeftShift(op, 8))
        w = BitwiseOr(w, LeftShift(sdst, 16))
        w = BitwiseOr(w, LeftShift(381, 23))
        GCNEncState.word0 = w
        ReturnValue(4)
    }
}

Function.GCNEnc_Emit_SOPC {
    Input: op: Integer
    Input: ssrc0: Integer
    Input: ssrc1: Integer
    Output: Integer
    Body: {
        w = ssrc0
        w = BitwiseOr(w, LeftShift(ssrc1, 8))
        w = BitwiseOr(w, LeftShift(op, 16))
        w = BitwiseOr(w, LeftShift(382, 23))
        GCNEncState.word0 = w
        ReturnValue(4)
    }
}

Function.GCNEnc_Emit_SOPK {
    Input: op: Integer
    Input: sdst: Integer
    Input: simm16: Integer
    Output: Integer
    Body: {
        w = BitwiseAnd(simm16, 65535)
        w = BitwiseOr(w, LeftShift(sdst, 16))
        w = BitwiseOr(w, LeftShift(op, 23))
        w = BitwiseOr(w, LeftShift(11, 28))
        GCNEncState.word0 = w
        ReturnValue(4)
    }
}

Function.GCNEnc_Emit_SOPP {
    Input: op: Integer
    Input: simm16: Integer
    Output: Integer
    Body: {
        w = BitwiseAnd(simm16, 65535)
        w = BitwiseOr(w, LeftShift(op, 16))
        w = BitwiseOr(w, LeftShift(383, 23))
        GCNEncState.word0 = w
        ReturnValue(4)
    }
}

Function.GCNEnc_Emit_SMRD {
    Input: op: Integer
    Input: sdst: Integer
    Input: sbase: Integer
    Input: offset: Integer
    Input: imm: Integer
    Output: Integer
    Body: {
        w = BitwiseAnd(offset, 255)
        w = BitwiseOr(w, LeftShift(BitwiseAnd(imm, 1), 8))
        w = BitwiseOr(w, LeftShift(BitwiseAnd(sbase, 63), 9))
        w = BitwiseOr(w, LeftShift(BitwiseAnd(sdst, 127), 15))
        w = BitwiseOr(w, LeftShift(op, 22))
        w = BitwiseOr(w, LeftShift(24, 27))
        GCNEncState.word0 = w
        ReturnValue(4)
    }
}

Function.GCNEnc_Emit_VOP1 {
    Input: op: Integer
    Input: vdst: Integer
    Input: src0: Integer
    Output: Integer
    Body: {
        w = BitwiseAnd(src0, 511)
        w = BitwiseOr(w, LeftShift(op, 9))
        w = BitwiseOr(w, LeftShift(vdst, 17))
        w = BitwiseOr(w, LeftShift(63, 25))
        GCNEncState.word0 = w
        ReturnValue(4)
    }
}

Function.GCNEnc_Emit_VOP2 {
    Input: op: Integer
    Input: vdst: Integer
    Input: src0: Integer
    Input: vsrc1: Integer
    Output: Integer
    Body: {
        w = BitwiseAnd(src0, 511)
        w = BitwiseOr(w, LeftShift(vsrc1, 9))
        w = BitwiseOr(w, LeftShift(vdst, 17))
        w = BitwiseOr(w, LeftShift(op, 25))
        // bit 31 = 0 (implicit)
        GCNEncState.word0 = w
        ReturnValue(4)
    }
}

Function.GCNEnc_Emit_VOPC {
    Input: op: Integer
    Input: src0: Integer
    Input: vsrc1: Integer
    Output: Integer
    Body: {
        w = BitwiseAnd(src0, 511)
        w = BitwiseOr(w, LeftShift(vsrc1, 9))
        w = BitwiseOr(w, LeftShift(op, 17))
        w = BitwiseOr(w, LeftShift(62, 25))
        GCNEncState.word0 = w
        ReturnValue(4)
    }
}

// GCNEnc_Emit_VOP3: 6 args (was 9)
// mods = clamp[0] | abs[3:1] | neg[6:4] | omod[8:7]
// Helper: GCNEnc_VOP3Mods(clamp, abs, neg, omod) packs for you
Function.GCNEnc_Emit_VOP3 {
    Input: op: Integer
    Input: vdst: Integer
    Input: src0: Integer
    Input: src1: Integer
    Input: src2: Integer
    Input: mods: Integer
    Output: Integer
    Body: {
        clamp = BitwiseAnd(mods, 1)
        abs_bits = BitwiseAnd(RightShift(mods, 1), 7)
        neg_bits = BitwiseAnd(RightShift(mods, 4), 7)
        omod = BitwiseAnd(RightShift(mods, 7), 3)
        w0 = BitwiseAnd(vdst, 255)
        w0 = BitwiseOr(w0, LeftShift(abs_bits, 8))
        w0 = BitwiseOr(w0, LeftShift(clamp, 11))
        w0 = BitwiseOr(w0, LeftShift(op, 17))
        w0 = BitwiseOr(w0, LeftShift(52, 26))
        GCNEncState.word0 = w0
        w1 = BitwiseAnd(src0, 511)
        w1 = BitwiseOr(w1, LeftShift(BitwiseAnd(src1, 511), 9))
        w1 = BitwiseOr(w1, LeftShift(BitwiseAnd(src2, 511), 18))
        w1 = BitwiseOr(w1, LeftShift(omod, 27))
        w1 = BitwiseOr(w1, LeftShift(neg_bits, 29))
        GCNEncState.word1 = w1
        ReturnValue(8)
    }
}

Function.GCNEnc_VOP3Mods {
    Input: clamp: Integer
    Input: abs_bits: Integer
    Input: neg_bits: Integer
    Input: omod: Integer
    Output: Integer
    Body: {
        m = BitwiseAnd(clamp, 1)
        m = BitwiseOr(m, LeftShift(BitwiseAnd(abs_bits, 7), 1))
        m = BitwiseOr(m, LeftShift(BitwiseAnd(neg_bits, 7), 4))
        m = BitwiseOr(m, LeftShift(BitwiseAnd(omod, 3), 7))
        ReturnValue(m)
    }
}

// GCNEnc_Emit_MUBUF: 6 args (was 11)
// flags = offset[11:0] | offen[12] | idxen[13] | glc[14] | addr64[15] | slc[22]
// Helper: GCNEnc_MUBUFFlags(offset, offen, idxen, glc, addr64, slc) packs for you
Function.GCNEnc_Emit_MUBUF {
    Input: op: Integer
    Input: vdata: Integer
    Input: vaddr: Integer
    Input: srsrc: Integer
    Input: soffset: Integer
    Input: flags: Integer
    Output: Integer
    Body: {
        // Extract flag fields
        offset = BitwiseAnd(flags, 4095)
        offen = BitwiseAnd(RightShift(flags, 12), 1)
        idxen = BitwiseAnd(RightShift(flags, 13), 1)
        glc = BitwiseAnd(RightShift(flags, 14), 1)
        addr64 = BitwiseAnd(RightShift(flags, 15), 1)
        slc = BitwiseAnd(RightShift(flags, 22), 1)
        w0 = offset
        w0 = BitwiseOr(w0, LeftShift(offen, 12))
        w0 = BitwiseOr(w0, LeftShift(idxen, 13))
        w0 = BitwiseOr(w0, LeftShift(glc, 14))
        w0 = BitwiseOr(w0, LeftShift(addr64, 15))
        w0 = BitwiseOr(w0, LeftShift(op, 18))
        w0 = BitwiseOr(w0, LeftShift(56, 26))
        GCNEncState.word0 = w0
        w1 = BitwiseAnd(vaddr, 255)
        w1 = BitwiseOr(w1, LeftShift(BitwiseAnd(vdata, 255), 8))
        w1 = BitwiseOr(w1, LeftShift(BitwiseAnd(srsrc, 31), 16))
        w1 = BitwiseOr(w1, LeftShift(slc, 22))
        w1 = BitwiseOr(w1, LeftShift(BitwiseAnd(soffset, 255), 24))
        GCNEncState.word1 = w1
        ReturnValue(8)
    }
}

Function.GCNEnc_MUBUFFlags {
    Input: offset: Integer
    Input: offen: Integer
    Input: idxen: Integer
    Input: glc: Integer
    Input: addr64: Integer
    Input: slc: Integer
    Output: Integer
    Body: {
        f = BitwiseAnd(offset, 4095)
        f = BitwiseOr(f, LeftShift(BitwiseAnd(offen, 1), 12))
        f = BitwiseOr(f, LeftShift(BitwiseAnd(idxen, 1), 13))
        f = BitwiseOr(f, LeftShift(BitwiseAnd(glc, 1), 14))
        f = BitwiseOr(f, LeftShift(BitwiseAnd(addr64, 1), 15))
        f = BitwiseOr(f, LeftShift(BitwiseAnd(slc, 1), 22))
        ReturnValue(f)
    }
}

// GCNEnc_Emit_MTBUF: 6 args
// flags = offset[11:0] | offen[12] | idxen[13] | glc[14] | dfmt[22:19] | nfmt[25:23] | slc[26]
Function.GCNEnc_Emit_MTBUF {
    Input: op: Integer
    Input: vdata: Integer
    Input: vaddr: Integer
    Input: srsrc: Integer
    Input: soffset: Integer
    Input: flags: Integer
    Output: Integer
    Body: {
        offset = BitwiseAnd(flags, 4095)
        offen = BitwiseAnd(RightShift(flags, 12), 1)
        idxen = BitwiseAnd(RightShift(flags, 13), 1)
        glc = BitwiseAnd(RightShift(flags, 14), 1)
        dfmt = BitwiseAnd(RightShift(flags, 19), 15)
        nfmt = BitwiseAnd(RightShift(flags, 23), 7)
        slc = BitwiseAnd(RightShift(flags, 26), 1)
        w0 = offset
        w0 = BitwiseOr(w0, LeftShift(offen, 12))
        w0 = BitwiseOr(w0, LeftShift(idxen, 13))
        w0 = BitwiseOr(w0, LeftShift(glc, 14))
        w0 = BitwiseOr(w0, LeftShift(op, 16))
        w0 = BitwiseOr(w0, LeftShift(dfmt, 19))
        w0 = BitwiseOr(w0, LeftShift(nfmt, 23))
        w0 = BitwiseOr(w0, LeftShift(58, 26))
        GCNEncState.word0 = w0
        w1 = BitwiseAnd(vaddr, 255)
        w1 = BitwiseOr(w1, LeftShift(BitwiseAnd(vdata, 255), 8))
        w1 = BitwiseOr(w1, LeftShift(BitwiseAnd(srsrc, 31), 16))
        w1 = BitwiseOr(w1, LeftShift(slc, 22))
        w1 = BitwiseOr(w1, LeftShift(BitwiseAnd(soffset, 255), 24))
        GCNEncState.word1 = w1
        ReturnValue(8)
    }
}

// GCNEnc_Emit_DS: 5 args (was 8)
// offsets = offset0[7:0] | offset1[15:8] | gds[16]
// Helper: GCNEnc_DSOffsets(offset0, offset1, gds) packs for you
Function.GCNEnc_Emit_DS {
    Input: op: Integer
    Input: addr: Integer
    Input: data0: Integer
    Input: vdst: Integer
    Input: offsets: Integer
    Output: Integer
    Body: {
        offset0 = BitwiseAnd(offsets, 255)
        offset1 = BitwiseAnd(RightShift(offsets, 8), 255)
        gds = BitwiseAnd(RightShift(offsets, 16), 1)
        data1 = BitwiseAnd(RightShift(offsets, 17), 255)
        w0 = offset0
        w0 = BitwiseOr(w0, LeftShift(offset1, 8))
        w0 = BitwiseOr(w0, LeftShift(gds, 17))
        w0 = BitwiseOr(w0, LeftShift(op, 18))
        w0 = BitwiseOr(w0, LeftShift(54, 26))
        GCNEncState.word0 = w0
        w1 = BitwiseAnd(addr, 255)
        w1 = BitwiseOr(w1, LeftShift(BitwiseAnd(data0, 255), 8))
        w1 = BitwiseOr(w1, LeftShift(data1, 16))
        w1 = BitwiseOr(w1, LeftShift(BitwiseAnd(vdst, 255), 24))
        GCNEncState.word1 = w1
        ReturnValue(8)
    }
}

Function.GCNEnc_DSOffsets {
    Input: offset0: Integer
    Input: offset1: Integer
    Input: gds: Integer
    Output: Integer
    Body: {
        f = BitwiseAnd(offset0, 255)
        f = BitwiseOr(f, LeftShift(BitwiseAnd(offset1, 255), 8))
        f = BitwiseOr(f, LeftShift(BitwiseAnd(gds, 1), 16))
        ReturnValue(f)
    }
}

Function.GCNEnc_DSOffsetsD1 {
    Input: offset0: Integer
    Input: offset1: Integer
    Input: gds: Integer
    Input: data1: Integer
    Output: Integer
    Body: {
        f = BitwiseAnd(offset0, 255)
        f = BitwiseOr(f, LeftShift(BitwiseAnd(offset1, 255), 8))
        f = BitwiseOr(f, LeftShift(BitwiseAnd(gds, 1), 16))
        f = BitwiseOr(f, LeftShift(BitwiseAnd(data1, 255), 17))
        ReturnValue(f)
    }
}

// GCNEnc_Emit_EXP: 6 args (was 9)
// flags = en[3:0] | compr[4] | done[5] | vm[6]
Function.GCNEnc_Emit_EXP {
    Input: tgt: Integer
    Input: vsrc0: Integer
    Input: vsrc1: Integer
    Input: vsrc2: Integer
    Input: vsrc3: Integer
    Input: flags: Integer
    Output: Integer
    Body: {
        en = BitwiseAnd(flags, 15)
        compr = BitwiseAnd(RightShift(flags, 4), 1)
        done = BitwiseAnd(RightShift(flags, 5), 1)
        vm = BitwiseAnd(RightShift(flags, 6), 1)
        w0 = en
        w0 = BitwiseOr(w0, LeftShift(BitwiseAnd(tgt, 63), 4))
        w0 = BitwiseOr(w0, LeftShift(compr, 10))
        w0 = BitwiseOr(w0, LeftShift(done, 11))
        w0 = BitwiseOr(w0, LeftShift(vm, 12))
        w0 = BitwiseOr(w0, LeftShift(49, 26))
        GCNEncState.word0 = w0
        w1 = BitwiseAnd(vsrc0, 255)
        w1 = BitwiseOr(w1, LeftShift(BitwiseAnd(vsrc1, 255), 8))
        w1 = BitwiseOr(w1, LeftShift(BitwiseAnd(vsrc2, 255), 16))
        w1 = BitwiseOr(w1, LeftShift(BitwiseAnd(vsrc3, 255), 24))
        GCNEncState.word1 = w1
        ReturnValue(8)
    }
}

Function.GCNEnc_EXPFlags {
    Input: en: Integer
    Input: compr: Integer
    Input: done: Integer
    Input: vm: Integer
    Output: Integer
    Body: {
        f = BitwiseAnd(en, 15)
        f = BitwiseOr(f, LeftShift(BitwiseAnd(compr, 1), 4))
        f = BitwiseOr(f, LeftShift(BitwiseAnd(done, 1), 5))
        f = BitwiseOr(f, LeftShift(BitwiseAnd(vm, 1), 6))
        ReturnValue(f)
    }
}

Function.GCNEnc_Emit_S_ENDPGM {
    Output: Integer
    Body: { ReturnValue(GCNEnc_Emit_SOPP(1, 0)) }
}

Function.GCNEnc_Emit_S_WAITCNT {
    Input: vmcnt: Integer
    Input: expcnt: Integer
    Input: lgkmcnt: Integer
    Output: Integer
    Body: {
        // SI: simm16 = vmcnt[3:0] | expcnt[6:4] | lgkmcnt[12:8]
        imm = BitwiseAnd(vmcnt, 15)
        imm = BitwiseOr(imm, LeftShift(BitwiseAnd(expcnt, 7), 4))
        imm = BitwiseOr(imm, LeftShift(BitwiseAnd(lgkmcnt, 31), 8))
        ReturnValue(GCNEnc_Emit_SOPP(12, imm))
    }
}

Function.GCNEnc_Emit_S_BARRIER {
    Output: Integer
    Body: { ReturnValue(GCNEnc_Emit_SOPP(10, 0)) }
}

Function.GCNEnc_Emit_S_NOP {
    Input: count: Integer
    Output: Integer
    Body: { ReturnValue(GCNEnc_Emit_SOPP(0, count)) }
}

Function.GCNEnc_Emit_V_MOV_B32 {
    Input: vdst: Integer
    Input: src0: Integer
    Output: Integer
    Body: { ReturnValue(GCNEnc_Emit_VOP1(1, vdst, src0)) }
}

Function.GCNEnc_Emit_S_MOV_B32 {
    Input: sdst: Integer
    Input: ssrc0: Integer
    Output: Integer
    Body: { ReturnValue(GCNEnc_Emit_SOP1(3, sdst, ssrc0)) }
}

Function.GCNEnc_Emit_S_LOAD_DWORD_IMM {
    Input: sdst: Integer
    Input: sbase_pair: Integer
    Input: byte_offset: Integer
    Output: Integer
    Body: {
        // SMRD: sbase = SGPR pair number / 2
        ReturnValue(GCNEnc_Emit_SMRD(0, sdst, Divide(sbase_pair, 2), byte_offset, 1))
    }
}

Function.GCNEnc_Emit_BUFFER_LOAD_DWORD {
    Input: vdst: Integer
    Input: vaddr: Integer
    Input: srsrc_x4: Integer
    Input: soffset: Integer
    Input: inst_offset: Integer
    Output: Integer
    Body: {
        // srsrc field = SGPR number / 4
        // flags: offset=inst_offset, offen=1, idxen=0, glc=0, addr64=0, slc=0
        flags = BitwiseOr(BitwiseAnd(inst_offset, 4095), LeftShift(1, 12))
        ReturnValue(GCNEnc_Emit_MUBUF(12, vdst, vaddr, Divide(srsrc_x4, 4), soffset, flags))
    }
}

Function.GCNEnc_Emit_BUFFER_STORE_DWORD {
    Input: vdata: Integer
    Input: vaddr: Integer
    Input: srsrc_x4: Integer
    Input: soffset: Integer
    Input: inst_offset: Integer
    Output: Integer
    Body: {
        flags = BitwiseOr(BitwiseAnd(inst_offset, 4095), LeftShift(1, 12))
        ReturnValue(GCNEnc_Emit_MUBUF(28, vdata, vaddr, Divide(srsrc_x4, 4), soffset, flags))
    }
}

