//
// Library.MX3Constants.ailang
//
// MemryX MX3 hardware register addresses, sizes, and magic numbers.
// All values sourced from the public MX3 reference driver:
//   https://github.com/memryx/mx3_driver_pub
//
// USAGE
//   LibraryImport.Drivers.Memryx.MX3Constants

// =============================================================================
// PCI IDENTITY
// =============================================================================

FixedPool.MX3_PCI {
    "VENDOR_ID":                Initialize=8169         // 0x1FE9
    "DEVICE_ID":                Initialize=256          // 0x0100
}

// =============================================================================
// BAR SIZES
// =============================================================================

FixedPool.MX3_BAR {
    "SIZE_256MB":               Initialize=268435456    // 0x10000000
    "SIZE_128MB":               Initialize=134217728    // 0x08000000
    "SIZE_64MB":                Initialize=67108864     // 0x04000000
    "SIZE_16MB":                Initialize=16777216     // 0x01000000
    "SIZE_1MB":                 Initialize=1048576      // 0x00100000
    "SIZE_512KB":               Initialize=524288       // 0x00080000
    "SIZE_256KB":               Initialize=262144       // 0x00040000
    "SIZE_4KB":                 Initialize=4096         // 0x00001000
}

// =============================================================================
// BAR MODE ENUM
// Detected at probe time based on BAR sizes.
// =============================================================================

FixedPool.MX3_BARMODE {
    "XFLOW256MB_SRAM1MB":       Initialize=0    // BAR0=256MB(XFLOW) + BAR1=1MB(SRAM)
    "SRAM1MB":                  Initialize=1    // BAR0=1MB only
    "XFLOW128MB64B_SRAM1MB":    Initialize=2    // BAR0=128MB(offset) + BAR2=1MB(SRAM)
    "THREE_BAR_16MB":           Initialize=3    // BAR0=16MB + BAR2=16MB + BAR4=1MB
    "THREE_BAR_64MB":           Initialize=4    // BAR0=64MB + BAR2=64MB + BAR4=1MB
    "FOUR_BAR":                 Initialize=5    // BAR0=512KB + BAR2=256KB + BAR4=4KB + BAR5=1MB
    "NOT_VALID":                Initialize=255
}

// =============================================================================
// BASE ADDRESSES (MPU view, accessed via XFLOW/SRAM BAR)
// =============================================================================

FixedPool.MX3_ADDR {
    "MPU_BASE":                 Initialize=805306368    // 0x30000000
    "SRAM_BASE":                Initialize=1073741824   // 0x40000000
    "FW_DL_BASE":               Initialize=1073987584   // 0x40040000
    "FW_CMD_BASE":              Initialize=1074036224   // 0x40046E00
    "FW_ZSBL_INITVAL":          Initialize=1297109325   // 0x4D4D4D4D ("MMMM")
    "FW_SYS_TICK":              Initialize=1074036500   // 0x40046F14
    "PCIE_LOCINTR":             Initialize=554172940    // 0x2110020C
    "TEMP_BASE":                Initialize=1074035008   // 0x40046D40
    "MPUUTIL_BASE":             Initialize=1074034944   // 0x40046D00
    "IGR_BUF_WPTR":             Initialize=1074036616   // 0x40046F88
    "BOOT_MODE":                Initialize=536871168    // 0x20000100
    "CHIP_VERSION":             Initialize=536872192    // 0x20000500
}

// =============================================================================
// XFLOW ADDRESSING
// The XFLOW interface provides unified register access across cascaded chips.
// chip_id is embedded in bits [25:22] of the XFLOW offset.
// =============================================================================

FixedPool.MX3_XFLOW {
    "CFG_PREFIX":               Initialize=201326592    // 0x0C000000
    "VBUF_PREFIX":              Initialize=134217728    // 0x08000000
    "CHIP_ID_SHIFT":            Initialize=22
    "CHIP_ID_MASK":             Initialize=15           // 0xF
    "BASE_REG_OFS":             Initialize=0            // BAR address register
    "CTRL_REG_OFS":             Initialize=4            // access mode register
    "RP_XFLOW_ADDR":            Initialize=1610612736   // 0x60000000
}

// =============================================================================
// XFLOW SOFTWARE IRQ INDICES (for memx_pcie_trigger_device_irq)
// =============================================================================

FixedPool.MX3_SW_IRQ {
    "EGRESS_DCORE_DONE":        Initialize=0
    "DUMP_XFLOW_ERR":           Initialize=1
    "RESERVE":                  Initialize=2
    "RESET_DEVICE":             Initialize=3
    "FW_CMD":                   Initialize=4
    "MOVE_SRAM_TO_DI":          Initialize=5
    "INIT_WTMEM_FMEM":          Initialize=6
    "RESET_MPU":                Initialize=7
}

// =============================================================================
// DEVICE IRQ OFFSET CALCULATION
// IRQ register offset = (((15 - chip_id) * DEVICE_IRQ_COUNT) + irq_idx) * 4 + 0x200
// =============================================================================

FixedPool.MX3_IRQ {
    "OFFSET_BASE":              Initialize=512          // 0x200
    "DEVICE_IRQ_COUNT":         Initialize=8
    "MAX_MSIX_VECTORS":         Initialize=33
    "PCI_IRQ_MSIX":             Initialize=4
    "PCI_IRQ_MSI":              Initialize=2
    "PCI_IRQ_LEGACY":           Initialize=1
}

// =============================================================================
// DMA (ARM DMAC)
// =============================================================================

FixedPool.MX3_DMA {
    "BASE":                     Initialize=537132032    // 0x20040000
    "COHERENT_SIZE_2MB":        Initialize=2097152      // 0x200000
    "RX_SIZE_512KB":            Initialize=524288       // 0x80000 (egress)
    "TX_SIZE_512KB":            Initialize=524288       // 0x80000 (ingress, at +512KB)
    "FW_LOG_SIZE_1MB":          Initialize=1048576      // 0x100000 (at +1MB)
    "DMAC_EN":                  Initialize=1
    "INT_EN":                   Initialize=2
    "SLICE_SIZE":               Initialize=16384        // 0x4000 (16KB per LL entry)
}

// =============================================================================
// DMA DIRECTION (for dma_sync_* calls)
// =============================================================================

FixedPool.MX3_DMA_DIR {
    "BIDIRECTIONAL":            Initialize=0
    "TO_DEVICE":                Initialize=1
    "FROM_DEVICE":              Initialize=2
}

// =============================================================================
// FIRMWARE COMMANDS
// =============================================================================

FixedPool.MX3_FW_CMD {
    "WAIT_FOR_ACK":             Initialize=0
    "VENDOR_1":                 Initialize=1
    "INIT_HOST_BUF_MAPPING":    Initialize=2
    "GET_HW_INFO":              Initialize=3
    "VENDOR_0":                 Initialize=4
    "INIT_WTMEM_FMAP":          Initialize=5
    "RESET_MPU":                Initialize=6
    "CONFIG_MPU_GROUP":         Initialize=7
    "SET_FEATURE":              Initialize=8
}

// =============================================================================
// CHIP ROLES (from firmware hw_info)
// =============================================================================

FixedPool.MX3_ROLE {
    "SINGLE":                   Initialize=0
    "MULTI_FIRST":              Initialize=1
    "MULTI_LAST":               Initialize=2
    "MULTI_MIDDLE":             Initialize=3
    "UNCONFIGURED":             Initialize=255
}

// =============================================================================
// ADMIN COMMAND OPCODES (for transport_cmd SQ)
// =============================================================================

FixedPool.MX3_ADMIN {
    "SET_FEATURE":              Initialize=1
    "GET_FEATURE":              Initialize=2
    "DOWNLOAD_DFP":             Initialize=3
    "SELFTEST":                 Initialize=4
    "DEVIOCTRL":                Initialize=5
    "SQ_BASE":                  Initialize=1074035712   // 0x40046C00
    "CQ_STATUS_OFFSET":         Initialize=16           // u32 offset in transport_cmd
    "TASK_EN_ADR":              Initialize=1074035908   // 0x40046CC4
}

// =============================================================================
// EXTENDED INFO COMMANDS (for single-BAR mode)
// =============================================================================

FixedPool.MX3_EXTCMD {
    "CMD_BASE":                 Initialize=1074035072   // 0x40046D80
    "DATA_BASE":                Initialize=1074035080   // 0x40046D88
    "RESULT_BASE":              Initialize=1074035084   // 0x40046D8C
    "COMPLETE":                 Initialize=0
    "XFLOW_WRITE_SRAM":         Initialize=1
    "XFLOW_READ_SRAM":          Initialize=2
    "XFLOW_WRITE_REG":          Initialize=3
    "XFLOW_READ_REG":           Initialize=4
}

// =============================================================================
// CASCADE LIMITS
// =============================================================================

FixedPool.MX3_CASCADE {
    "MAX_CHIPS":                Initialize=16
    "DEFAULT_CHIPS":            Initialize=4    // M.2 module has 4 chips
    "MAX_GROUPS":               Initialize=8
    "MAX_FLOWS":                Initialize=32
}

// =============================================================================
// SRAM DATA OFFSETS
// =============================================================================

FixedPool.MX3_SRAM {
    "DATA_SRAM_OFFS":           Initialize=262144       // 0x40000
    "MAX_SIZE":                 Initialize=1048576      // 0x100000 (1MB)
    "DATASRAM_BASE":            Initialize=1073938432   // 0x40080000
}

// =============================================================================
// GFP FLAGS (kernel memory allocation)
// =============================================================================

FixedPool.MX3_GFP {
    "KERNEL":                   Initialize=3264         // GFP_KERNEL
}

// =============================================================================
// IOCTL MAGIC AND COMMAND NUMBERS
// Matching the reference driver's Linux IOCTL definitions.
// Magic = 'u' (0x75)
// =============================================================================

FixedPool.MX3_IOCTL {
    "MAGIC":                    Initialize=117          // 'u'
    "DOWNLOAD_FIRMWARE":        Initialize=4            // cmd nr 4
    "ABORT_TRANSFER":           Initialize=10           // cmd nr 10
    "WAIT_FW_MSIX_ACK":         Initialize=14           // cmd nr 14
    "GET_HW_INFO":              Initialize=15           // cmd nr 15
    "CONFIG_MPU_GROUP":         Initialize=16           // cmd nr 16
    "INIT_WTMEM_FMAP":          Initialize=17           // cmd nr 17
    "RESET_DEVICE":             Initialize=18           // cmd nr 18
    "GET_DEVICE_FEATURE":       Initialize=19           // cmd nr 19
    "SET_DEVICE_FEATURE":       Initialize=20           // cmd nr 20
    "DUMMY_READ":               Initialize=23           // cmd nr 23
    "SET_ABORT_READ":           Initialize=24           // cmd nr 24
    "ADMIN_COMMAND":            Initialize=26           // cmd nr 26
}
