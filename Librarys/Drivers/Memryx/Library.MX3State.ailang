//
// Library.MX3State.ailang
//
// Per-device mutable state for the MX3 driver.
// Uses module-level FixedPool globals (single-device for now).
// For multi-device support, probe() would kmalloc per-device structs.
//
// USAGE
//   LibraryImport.Drivers.Memryx.MX3State

// =============================================================================
// DEVICE STATE
// =============================================================================

FixedPool.MX3Dev {
    // PCI device pointers (opaque, never dereferenced in Ailang)
    "pdev":             Initialize=0, CanChange=True    // struct pci_dev*
    "dev":              Initialize=0, CanChange=True    // &pdev->dev (struct device*)

    // BAR mappings (ioremap'd virtual addresses)
    "bar0":             Initialize=0, CanChange=True    // XFLOW config BAR iobase
    "bar1":             Initialize=0, CanChange=True    // secondary BAR iobase
    "sram_bar":         Initialize=0, CanChange=True    // SRAM BAR iobase
    "bar_mode":         Initialize=255, CanChange=True  // MX3_BARMODE enum (255=NOT_VALID)

    // BAR index tracking (which BAR# maps to which function)
    "xflow_conf_bar":   Initialize=0, CanChange=True    // BAR index for XFLOW config
    "xflow_vbuf_bar":   Initialize=0, CanChange=True    // BAR index for XFLOW vbuf
    "sram_bar_idx":     Initialize=1, CanChange=True    // BAR index for SRAM
    "xflow_conf_ofs":   Initialize=0, CanChange=True    // offset within BAR for XFLOW config
    "xflow_vbuf_ofs":   Initialize=0, CanChange=True    // offset within BAR for XFLOW vbuf

    // Chip cascade info
    "num_chips":        Initialize=0, CanChange=True    // detected chip count
    "chip_generation":  Initialize=0, CanChange=True    // chip generation from FW

    // Char device context (from ail_chardev_register)
    "chardev_ctx":      Initialize=0, CanChange=True

    // Interrupt state
    "num_irqs":         Initialize=0, CanChange=True    // allocated IRQ vectors
    "rx_fifo":          Initialize=0, CanChange=True    // kfifo for RX events

    // Firmware state
    "fw_loaded":        Initialize=0, CanChange=True    // 1 if firmware is running
    "fw_cmd_buf":       Initialize=0, CanChange=True    // mapped FW command buffer

    // DMA state
    "dma_buf_virt":     Initialize=0, CanChange=True    // DMA coherent buffer virtual addr
    "dma_buf_phys":     Initialize=0, CanChange=True    // DMA coherent buffer physical addr
    "dma_buf_size":     Initialize=0, CanChange=True    // DMA buffer size

    // Synchronization
    "completion_rx":    Initialize=0, CanChange=True    // completion for RX (egress)
    "completion_tx":    Initialize=0, CanChange=True    // completion for TX (ingress)
    "completion_fw":    Initialize=0, CanChange=True    // completion for FW commands
    "sema":             Initialize=0, CanChange=True    // device semaphore
    "spinlock":         Initialize=0, CanChange=True    // IRQ spinlock

    // File operation state
    "open_count":       Initialize=0, CanChange=True    // number of active opens
    "is_abort":         Initialize=0, CanChange=True    // abort flag for transfers
}
