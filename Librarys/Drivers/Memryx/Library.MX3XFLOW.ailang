//
// Library.MX3XFLOW.ailang
//
// XFLOW register access layer for the MX3 PCIe driver.
// XFLOW provides unified register/SRAM access across cascaded chips.
// Chip 0 is accessed directly; chips 1-15 are accessed indirectly
// through chip 0's base address register + virtual buffer.
//
// USAGE
//   LibraryImport.Drivers.Memryx.MX3XFLOW

LibraryImport.KernelShim
LibraryImport.Drivers.Memryx.MX3Constants
LibraryImport.Drivers.Memryx.MX3State

// =============================================================================
// XFLOW OFFSET COMPUTATION
// =============================================================================

// Compute XFLOW BAR offset for a given chip_id.
// is_config: 1 = configuration registers, 0 = virtual buffer
// Returns offset within BAR to add to iobase.
Function.MX3.XflowOffset {
    Input: chip_id: Integer
    Input: is_config: Integer
    Output: Integer
    Body: {
        // prefix = is_config ? CFG_PREFIX : VBUF_PREFIX
        IfCondition NotEqual(is_config, 0) ThenBlock: {
            prefix = MX3_XFLOW.CFG_PREFIX
        } ElseBlock: {
            prefix = MX3_XFLOW.VBUF_PREFIX
        }

        // chip_offset = (chip_id & MASK) << SHIFT
        chip_masked = BitwiseAnd(chip_id, MX3_XFLOW.CHIP_ID_MASK)
        chip_offset = ShiftLeft(chip_masked, MX3_XFLOW.CHIP_ID_SHIFT)

        // result = prefix | chip_offset
        ReturnValue(BitwiseOr(prefix, chip_offset))
    }
}

// =============================================================================
// SRAM ACCESS (via SRAM BAR — direct, no XFLOW indirection)
// =============================================================================

// Read a 32-bit value from SRAM address.
// addr is in the MPU address space (e.g., 0x40046E00).
// Translates to BAR offset: addr - SRAM_BASE.
Function.MX3.SramRead {
    Input: addr: Integer
    Output: Integer
    Body: {
        offset = Subtract(addr, MX3_ADDR.SRAM_BASE)
        io_addr = Add(MX3Dev.sram_bar, offset)
        ReturnValue(ail_readl(io_addr))
    }
}

// Write a 32-bit value to SRAM address.
Function.MX3.SramWrite {
    Input: addr: Integer
    Input: val: Integer
    Body: {
        offset = Subtract(addr, MX3_ADDR.SRAM_BASE)
        io_addr = Add(MX3Dev.sram_bar, offset)
        ail_writel(val, io_addr)
    }
}

// =============================================================================
// XFLOW REGISTER ACCESS (multi-chip)
// =============================================================================

// Set the XFLOW base address register for a given chip.
// For chip 0: write directly to chip 0's config space.
// For chip N>0: indirect through chip 0.
Function.MX3.XflowSetBase {
    Input: chip_id: Integer
    Input: base_addr: Integer
    Body: {
        IfCondition EqualTo(chip_id, 0) ThenBlock: {
            // Direct: write to chip 0 config base register
            cfg_offset = MX3.XflowOffset(0, 1)
            reg_addr = Add(MX3Dev.bar0, Add(cfg_offset, MX3_XFLOW.BASE_REG_OFS))
            ail_writel(base_addr, reg_addr)
        } ElseBlock: {
            // Indirect: set chip 0's base to point at chip N's base register
            cfg0_offset = MX3.XflowOffset(0, 1)
            base_reg_addr = Add(MX3Dev.bar0, Add(cfg0_offset, MX3_XFLOW.BASE_REG_OFS))

            // Target = RP_XFLOW_ADDR + chip_N_config_offset + BASE_REG_OFS
            chip_n_cfg = MX3.XflowOffset(chip_id, 1)
            target = Add(MX3_XFLOW.RP_XFLOW_ADDR, Add(chip_n_cfg, MX3_XFLOW.BASE_REG_OFS))
            ail_writel(target, base_reg_addr)

            // Now write the actual base_addr through chip 0's virtual buffer
            vbuf0_offset = MX3.XflowOffset(0, 0)
            vbuf_addr = Add(MX3Dev.bar0, vbuf0_offset)
            ail_writel(base_addr, vbuf_addr)
        }
    }
}

// Set the XFLOW access mode register for a given chip.
// access_mpu: 1 = MPU register access, 0 = SRAM/peripheral access
Function.MX3.XflowSetMode {
    Input: chip_id: Integer
    Input: access_mpu: Integer
    Body: {
        // Mode value: 0 for MPU, 1 for SRAM
        IfCondition NotEqual(access_mpu, 0) ThenBlock: {
            mode_val = 0
        } ElseBlock: {
            mode_val = 1
        }

        IfCondition EqualTo(chip_id, 0) ThenBlock: {
            cfg_offset = MX3.XflowOffset(0, 1)
            ctrl_addr = Add(MX3Dev.bar0, Add(cfg_offset, MX3_XFLOW.CTRL_REG_OFS))
            ail_writel(mode_val, ctrl_addr)
        } ElseBlock: {
            // Indirect through chip 0
            cfg0_offset = MX3.XflowOffset(0, 1)
            base_reg_addr = Add(MX3Dev.bar0, Add(cfg0_offset, MX3_XFLOW.BASE_REG_OFS))

            chip_n_cfg = MX3.XflowOffset(chip_id, 1)
            target = Add(MX3_XFLOW.RP_XFLOW_ADDR, Add(chip_n_cfg, MX3_XFLOW.CTRL_REG_OFS))
            ail_writel(target, base_reg_addr)

            vbuf0_offset = MX3.XflowOffset(0, 0)
            vbuf_addr = Add(MX3Dev.bar0, vbuf0_offset)
            ail_writel(mode_val, vbuf_addr)
        }
    }
}

// Write a 32-bit value via XFLOW.
// chip_id: target chip (0-15)
// base_addr: MPU-space base address (e.g., 0x30000000)
// offset: offset from base
// value: data to write
Function.MX3.XflowWrite {
    Input: chip_id: Integer
    Input: base_addr: Integer
    Input: offset: Integer
    Input: value: Integer
    Body: {
        // Set base address register
        MX3.XflowSetBase(chip_id, base_addr)

        // Set access mode (non-MPU for SRAM, MPU for registers)
        IfCondition GreaterEqual(base_addr, MX3_ADDR.SRAM_BASE) ThenBlock: {
            MX3.XflowSetMode(chip_id, 0)
        } ElseBlock: {
            MX3.XflowSetMode(chip_id, 1)
        }

        // Write value through virtual buffer at offset
        IfCondition EqualTo(chip_id, 0) ThenBlock: {
            vbuf_offset = MX3.XflowOffset(0, 0)
            write_addr = Add(MX3Dev.bar0, Add(vbuf_offset, offset))
            ail_writel(value, write_addr)
        } ElseBlock: {
            // For indirect: set chip 0 base to point at chip N's target
            cfg0_offset = MX3.XflowOffset(0, 1)
            base_reg_addr = Add(MX3Dev.bar0, Add(cfg0_offset, MX3_XFLOW.BASE_REG_OFS))

            chip_n_vbuf = MX3.XflowOffset(chip_id, 0)
            target = Add(MX3_XFLOW.RP_XFLOW_ADDR, Add(chip_n_vbuf, offset))
            ail_writel(target, base_reg_addr)

            vbuf0_offset = MX3.XflowOffset(0, 0)
            vbuf_addr = Add(MX3Dev.bar0, vbuf0_offset)
            ail_writel(value, vbuf_addr)
        }
    }
}

// Read a 32-bit value via XFLOW.
// Returns the value read from the register/SRAM.
Function.MX3.XflowRead {
    Input: chip_id: Integer
    Input: base_addr: Integer
    Input: offset: Integer
    Output: Integer
    Body: {
        // Set base address register
        MX3.XflowSetBase(chip_id, base_addr)

        // Set access mode
        IfCondition GreaterEqual(base_addr, MX3_ADDR.SRAM_BASE) ThenBlock: {
            MX3.XflowSetMode(chip_id, 0)
        } ElseBlock: {
            MX3.XflowSetMode(chip_id, 1)
        }

        // Read value through virtual buffer
        IfCondition EqualTo(chip_id, 0) ThenBlock: {
            vbuf_offset = MX3.XflowOffset(0, 0)
            read_addr = Add(MX3Dev.bar0, Add(vbuf_offset, offset))
            ReturnValue(ail_readl(read_addr))
        } ElseBlock: {
            cfg0_offset = MX3.XflowOffset(0, 1)
            base_reg_addr = Add(MX3Dev.bar0, Add(cfg0_offset, MX3_XFLOW.BASE_REG_OFS))

            chip_n_vbuf = MX3.XflowOffset(chip_id, 0)
            target = Add(MX3_XFLOW.RP_XFLOW_ADDR, Add(chip_n_vbuf, offset))
            ail_writel(target, base_reg_addr)

            vbuf0_offset = MX3.XflowOffset(0, 0)
            vbuf_addr = Add(MX3Dev.bar0, vbuf0_offset)
            ReturnValue(ail_readl(vbuf_addr))
        }
    }
}

// =============================================================================
// DEVICE IRQ TRIGGER
// Triggers a software interrupt on a specific chip.
// =============================================================================

Function.MX3.TriggerDeviceIRQ {
    Input: chip_id: Integer
    Input: sw_irq_idx: Integer
    Body: {
        // IRQ offset = (((15 - chip_id) * DEVICE_IRQ_COUNT) + sw_irq_idx) * 4 + 0x200
        chip_slot = Subtract(15, chip_id)
        slot_base = Multiply(chip_slot, MX3_IRQ.DEVICE_IRQ_COUNT)
        irq_index = Add(slot_base, sw_irq_idx)
        byte_offset = Add(Multiply(irq_index, 4), MX3_IRQ.OFFSET_BASE)

        // Write 1 to the IRQ trigger register via SRAM BAR
        // The IRQ registers are at a fixed location accessible via the device IRQ BAR
        irq_addr = Add(MX3Dev.bar0, byte_offset)
        ail_writel(1, irq_addr)
    }
}

// =============================================================================
// BAR MODE DETECTION
// Reads BAR sizes to determine the hardware configuration.
// =============================================================================

Function.MX3.DetectBarMode {
    Input: pdev: Address
    Output: Integer
    Body: {
        bar0_len = ail_pci_resource_len(pdev, 0)
        bar1_len = ail_pci_resource_len(pdev, 1)
        bar2_len = ail_pci_resource_len(pdev, 2)
        bar4_len = ail_pci_resource_len(pdev, 4)
        bar5_len = ail_pci_resource_len(pdev, 5)

        // Mode 0: BAR0=256MB, BAR1=1MB
        IfCondition EqualTo(bar0_len, MX3_BAR.SIZE_256MB) ThenBlock: {
            MX3Dev.xflow_conf_bar = 0
            MX3Dev.xflow_vbuf_bar = 0
            MX3Dev.sram_bar_idx = 1
            ReturnValue(MX3_BARMODE.XFLOW256MB_SRAM1MB)
        }

        // Mode 1: BAR0=1MB only (single BAR)
        IfCondition EqualTo(bar0_len, MX3_BAR.SIZE_1MB) ThenBlock: {
            IfCondition EqualTo(bar1_len, 0) ThenBlock: {
                MX3Dev.sram_bar_idx = 0
                ReturnValue(MX3_BARMODE.SRAM1MB)
            }
        }

        // Mode 2: BAR0=128MB, BAR2=1MB
        IfCondition EqualTo(bar0_len, MX3_BAR.SIZE_128MB) ThenBlock: {
            MX3Dev.xflow_conf_bar = 0
            MX3Dev.xflow_vbuf_bar = 0
            MX3Dev.sram_bar_idx = 2
            ReturnValue(MX3_BARMODE.XFLOW128MB64B_SRAM1MB)
        }

        // Mode 5: BAR0=512KB, BAR2=256KB, BAR4=4KB, BAR5=1MB (4-BAR)
        IfCondition EqualTo(bar0_len, MX3_BAR.SIZE_512KB) ThenBlock: {
            MX3Dev.xflow_conf_bar = 0
            MX3Dev.xflow_vbuf_bar = 0
            MX3Dev.sram_bar_idx = 5
            ReturnValue(MX3_BARMODE.FOUR_BAR)
        }

        // Mode 3/4: BAR0=16MB or 64MB, BAR2=16MB or 64MB, BAR4=1MB
        IfCondition EqualTo(bar0_len, MX3_BAR.SIZE_64MB) ThenBlock: {
            MX3Dev.xflow_conf_bar = 2
            MX3Dev.xflow_vbuf_bar = 0
            MX3Dev.sram_bar_idx = 4
            ReturnValue(MX3_BARMODE.THREE_BAR_64MB)
        }

        IfCondition EqualTo(bar0_len, MX3_BAR.SIZE_16MB) ThenBlock: {
            MX3Dev.xflow_conf_bar = 2
            MX3Dev.xflow_vbuf_bar = 0
            MX3Dev.sram_bar_idx = 4
            ReturnValue(MX3_BARMODE.THREE_BAR_16MB)
        }

        // Unknown configuration
        ReturnValue(MX3_BARMODE.NOT_VALID)
    }
}
