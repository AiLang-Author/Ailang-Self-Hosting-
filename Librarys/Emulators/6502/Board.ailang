// Library.Board6502.ailang
// Runtime for a JSON-described motherboard: LinkagePool chips + nets.
// Method plug is AddressOf / CallIndirect stored on LinkagePool.Chip.
// JSON is the description file only; this is the live board.

LibraryImport.Arena
Import.Librarys.Emulators.6502.Bus
LibraryImport.JSON

// One plugged chip instance (CPU, VIC, CIA, homebrew ASIC, …).
LinkagePool.Chip {
    "name":  Initialize=""
    "devid": Initialize=0
    "lo":    Initialize=0
    "hi":    Initialize=0
    "state": Initialize=0
    "read":  Initialize=0
    "write": Initialize=0
    "tick":  Initialize=0
    "pin":   Initialize=0
    "next":  Initialize=0
}

// One end of a net: chip.pin
LinkagePool.PinRef {
    "chip": Initialize=0
    "pin":  Initialize=""
    "next": Initialize=0
}

LinkagePool.Net {
    "name":    Initialize=""
    "combine": Initialize=0
    "srcs":    Initialize=0
    "dsts":    Initialize=0
    "next":    Initialize=0
}

LinkagePool.Board {
    "clock_hz": Initialize=0
    "chips":    Initialize=0
    "nets":     Initialize=0
}

// Named silicon: JSON "model" string -> four function addresses.
LinkagePool.ChipModel {
    "name":  Initialize=""
    "read":  Initialize=0
    "write": Initialize=0
    "tick":  Initialize=0
    "pin":   Initialize=0
    "next":  Initialize=0
}

FixedPool.BoardReg {
    "models": Initialize=0
    "live":   Initialize=0
}

Function.Board_RegisterModel {
    Input: name: Address
    Input: read_fn: Integer
    Input: write_fn: Integer
    Input: tick_fn: Integer
    Body: {
        m = AllocateLinkage(LinkagePool.ChipModel)
        m@name = name
        m@read = read_fn
        m@write = write_fn
        m@tick = tick_fn
        m@next = BoardReg.models
        BoardReg.models = m
    }
}

Function.Board_FindModel {
    Input: name: Address
    Output: Integer
    Body: {
        m = BoardReg.models
        name_off = PoolFieldOffset(LinkagePool.ChipModel, "name")
        next_off = PoolFieldOffset(LinkagePool.ChipModel, "next")
        WhileLoop NotEqual(m, 0) {
            nm = Dereference(Add(m, name_off))
            cmp = 1
            IfCondition NotEqual(nm, 0) ThenBlock: {
                cmp = StringCompare(nm, name)
            }
            IfCondition EqualTo(cmp, 0) ThenBlock: {
                ReturnValue(m)
            }
            m = Dereference(Add(m, next_off))
        }
        ReturnValue(0)
    }
}

Function.Board_AddChip {
    Input: name: Address
    Input: model_name: Address
    Input: devid: Integer
    Input: lo: Integer
    Input: hi: Integer
    Output: Integer
    Body: {
        model = Board_FindModel(model_name)
        IfCondition EqualTo(model, 0) ThenBlock: {
            ReturnValue(0)
        }
        read_off = PoolFieldOffset(LinkagePool.ChipModel, "read")
        write_off = PoolFieldOffset(LinkagePool.ChipModel, "write")
        tick_off = PoolFieldOffset(LinkagePool.ChipModel, "tick")
        pin_off = PoolFieldOffset(LinkagePool.ChipModel, "pin")
        c = AllocateLinkage(LinkagePool.Chip)
        c@name = name
        c@devid = devid
        c@lo = lo
        c@hi = hi
        c@read = Dereference(Add(model, read_off))
        c@write = Dereference(Add(model, write_off))
        c@tick = Dereference(Add(model, tick_off))
        c@pin = Dereference(Add(model, pin_off))
        b = BoardReg.live
        chips_off = PoolFieldOffset(LinkagePool.Board, "chips")
        IfCondition EqualTo(b, 0) ThenBlock: {
            nb = AllocateLinkage(LinkagePool.Board)
            BoardReg.live = nb
            c@next = 0
            nb@chips = c
        } ElseBlock: {
            old = Dereference(Add(b, chips_off))
            c@next = old
            StoreValue(Add(b, chips_off), c)
        }
        IfCondition NotEqual(devid, 0) ThenBlock: {
            pg = Divide(lo, 256)
            last = Divide(hi, 256)
            WhileLoop LessEqual(pg, last) {
                Bus6502_MapIO(pg, devid)
                pg = Add(pg, 1)
            }
        }
        ReturnValue(c)
    }
}

Function.Board_ChipForDevid {
    Input: devid: Integer
    Output: Integer
    Body: {
        b = BoardReg.live
        IfCondition EqualTo(b, 0) ThenBlock: {
            ReturnValue(0)
        }
        chips_off = PoolFieldOffset(LinkagePool.Board, "chips")
        devid_off = PoolFieldOffset(LinkagePool.Chip, "devid")
        next_off = PoolFieldOffset(LinkagePool.Chip, "next")
        c = Dereference(Add(b, chips_off))
        WhileLoop NotEqual(c, 0) {
            cd = Dereference(Add(c, devid_off))
            IfCondition EqualTo(cd, devid) ThenBlock: {
                ReturnValue(c)
            }
            c = Dereference(Add(c, next_off))
        }
        ReturnValue(0)
    }
}

Function.Board_RamRead {
    Input: addr: Integer
    Output: Integer
    Body: {
        a = BitwiseAnd(addr, 65535)
        v = GetByte(Bus6502.ram, a)
        ReturnValue(v)
    }
}

Function.Board_RamWrite {
    Input: addr: Integer
    Input: value: Integer
    Body: {
        a = BitwiseAnd(addr, 65535)
        b = BitwiseAnd(value, 255)
        SetByte(Bus6502.ram, a, b)
    }
}

Function.Board_DevRead {
    Input: devid: Integer
    Input: addr: Integer
    Output: Integer
    Body: {
        c = Board_ChipForDevid(devid)
        IfCondition EqualTo(c, 0) ThenBlock: {
            v0 = Board_RamRead(addr)
            ReturnValue(v0)
        }
        lo_off = PoolFieldOffset(LinkagePool.Chip, "lo")
        hi_off = PoolFieldOffset(LinkagePool.Chip, "hi")
        lo = Dereference(Add(c, lo_off))
        hi = Dereference(Add(c, hi_off))
        IfCondition LessThan(addr, lo) ThenBlock: {
            v1 = Board_RamRead(addr)
            ReturnValue(v1)
        }
        IfCondition GreaterThan(addr, hi) ThenBlock: {
            v2 = Board_RamRead(addr)
            ReturnValue(v2)
        }
        read_off = PoolFieldOffset(LinkagePool.Chip, "read")
        fn = Dereference(Add(c, read_off))
        IfCondition EqualTo(fn, 0) ThenBlock: {
            ReturnValue(255)
        }
        val = CallIndirect(fn, c, addr)
        ReturnValue(val)
    }
}

Function.Board_DevWrite {
    Input: devid: Integer
    Input: addr: Integer
    Input: value: Integer
    Body: {
        c = Board_ChipForDevid(devid)
        IfCondition EqualTo(c, 0) ThenBlock: {
            Board_RamWrite(addr, value)
            ReturnValue(0)
        }
        lo_off = PoolFieldOffset(LinkagePool.Chip, "lo")
        hi_off = PoolFieldOffset(LinkagePool.Chip, "hi")
        lo = Dereference(Add(c, lo_off))
        hi = Dereference(Add(c, hi_off))
        IfCondition LessThan(addr, lo) ThenBlock: {
            Board_RamWrite(addr, value)
            ReturnValue(0)
        }
        IfCondition GreaterThan(addr, hi) ThenBlock: {
            Board_RamWrite(addr, value)
            ReturnValue(0)
        }
        write_off = PoolFieldOffset(LinkagePool.Chip, "write")
        fn = Dereference(Add(c, write_off))
        IfCondition EqualTo(fn, 0) ThenBlock: {
            ReturnValue(0)
        }
        CallIndirect(fn, c, addr, value)
    }
}

Function.Board_BindBus {
    Body: {
        Bus6502.io_read = AddressOf(Board_DevRead)
        Bus6502.io_write = AddressOf(Board_DevWrite)
    }
}

Function.Board_HexDigit {
    Input: ch: Integer
    Output: Integer
    Body: {
        IfCondition And(GreaterEqual(ch, 48), LessEqual(ch, 57)) ThenBlock: {
            ReturnValue(Subtract(ch, 48))
        }
        IfCondition And(GreaterEqual(ch, 65), LessEqual(ch, 70)) ThenBlock: {
            ReturnValue(Subtract(ch, 55))
        }
        IfCondition And(GreaterEqual(ch, 97), LessEqual(ch, 102)) ThenBlock: {
            ReturnValue(Subtract(ch, 87))
        }
        ReturnValue(-1)
    }
}

Function.Board_ParseHex {
    Input: s: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(s, 0) ThenBlock: {
            ReturnValue(0)
        }
        n = StringLength(s)
        i = 0
        IfCondition GreaterEqual(n, 2) ThenBlock: {
            c0 = GetByte(s, 0)
            c1 = GetByte(s, 1)
            IfCondition EqualTo(c0, 48) ThenBlock: {
                IfCondition Or(EqualTo(c1, 120), EqualTo(c1, 88)) ThenBlock: {
                    i = 2
                }
            }
        }
        v = 0
        WhileLoop LessThan(i, n) {
            ch = GetByte(s, i)
            d = Board_HexDigit(ch)
            IfCondition LessThan(d, 0) ThenBlock: {
                i = n
            } ElseBlock: {
                v = Multiply(v, 16)
                v = Add(v, d)
                i = Add(i, 1)
            }
        }
        ReturnValue(v)
    }
}

Function.Board_AddrField {
    Input: obj: Address
    Input: key: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(obj, 0) ThenBlock: {
            ReturnValue(0)
        }
        t = JSON.GetType(obj, key)
        IfCondition EqualTo(t, JType.NUMBER) ThenBlock: {
            num = JSON.GetNumber(obj, key)
            ReturnValue(num)
        }
        IfCondition EqualTo(t, JType.STRING) ThenBlock: {
            hs = JSON.GetString(obj, key)
            hx = Board_ParseHex(hs)
            ReturnValue(hx)
        }
        ReturnValue(0)
    }
}

Function.Board_ReadFile {
    Input: path: Address
    Output: Address
    Body: {
        fd = SystemCall(2, path, 0, 0)
        IfCondition LessThan(fd, 0) ThenBlock: {
            ReturnValue(0)
        }
        buf = Allocate(65536)
        IfCondition EqualTo(buf, 0) ThenBlock: {
            SystemCall(3, fd)
            ReturnValue(0)
        }
        n = SystemCall(0, fd, buf, 65535)
        SystemCall(3, fd)
        IfCondition LessThan(n, 1) ThenBlock: {
            Deallocate(buf, 65536)
            ReturnValue(0)
        }
        SetByte(buf, n, 0)
        ReturnValue(buf)
    }
}

Function.Board_ModelForId {
    Input: chips: Address
    Input: cid: Address
    Output: Address
    Body: {
        IfCondition Or(EqualTo(chips, 0), EqualTo(cid, 0)) ThenBlock: {
            ReturnValue(0)
        }
        n = JSON.ArrayLength(chips)
        i = 0
        WhileLoop LessThan(i, n) {
            tagged = JSON.ArrayGet(chips, i)
            obj = JSON.AsObject(tagged)
            iid = JSON.GetString(obj, "id")
            cmp = 1
            IfCondition NotEqual(iid, 0) ThenBlock: {
                cmp = StringCompare(iid, cid)
            }
            IfCondition EqualTo(cmp, 0) ThenBlock: {
                mname = JSON.GetString(obj, "model")
                ReturnValue(mname)
            }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

Function.Board_LoadMaps {
    Input: root: Address
    Output: Integer
    Body: {
        chips = JSON.GetArray(root, "chips")
        maps = JSON.GetArray(root, "maps")
        IfCondition EqualTo(maps, 0) ThenBlock: {
            ReturnValue(0)
        }
        n = JSON.ArrayLength(maps)
        added = 0
        i = 0
        WhileLoop LessThan(i, n) {
            tagged = JSON.ArrayGet(maps, i)
            obj = JSON.AsObject(tagged)
            cid = JSON.GetString(obj, "chip")
            devid = JSON.GetNumber(obj, "devid")
            lo = Board_AddrField(obj, "lo")
            hi = Board_AddrField(obj, "hi")
            model = Board_ModelForId(chips, cid)
            IfCondition EqualTo(model, 0) ThenBlock: {
                model = JSON.GetString(obj, "model")
            }
            IfCondition And(NotEqual(model, 0), NotEqual(devid, 0)) ThenBlock: {
                c = Board_AddChip(cid, model, devid, lo, hi)
                IfCondition NotEqual(c, 0) ThenBlock: {
                    added = Add(added, 1)
                }
            }
            i = Add(i, 1)
        }
        ReturnValue(added)
    }
}

Function.Board_LoadChips {
    Input: root: Address
    Output: Integer
    Body: {
        chips = JSON.GetArray(root, "chips")
        IfCondition EqualTo(chips, 0) ThenBlock: {
            ReturnValue(0)
        }
        n = JSON.ArrayLength(chips)
        added = 0
        i = 0
        WhileLoop LessThan(i, n) {
            tagged = JSON.ArrayGet(chips, i)
            obj = JSON.AsObject(tagged)
            cid = JSON.GetString(obj, "id")
            model = JSON.GetString(obj, "model")
            devid = JSON.GetNumber(obj, "devid")
            lo = Board_AddrField(obj, "lo")
            hi = Board_AddrField(obj, "hi")
            IfCondition EqualTo(hi, 0) ThenBlock: {
                IfCondition NotEqual(lo, 0) ThenBlock: {
                    hi = lo
                }
            }
            IfCondition And(NotEqual(model, 0), NotEqual(devid, 0)) ThenBlock: {
                c = Board_AddChip(cid, model, devid, lo, hi)
                IfCondition NotEqual(c, 0) ThenBlock: {
                    added = Add(added, 1)
                }
            }
            i = Add(i, 1)
        }
        ReturnValue(added)
    }
}

Function.Board_LoadJSON {
    Input: path: Address
    Output: Integer
    Body: {
        txt = Board_ReadFile(path)
        IfCondition EqualTo(txt, 0) ThenBlock: {
            PrintMessage("board: cannot read file\n")
            ReturnValue(0)
        }
        tagged = ParseJSON(txt)
        IfCondition EqualTo(tagged, 0) ThenBlock: {
            PrintMessage("board: JSON parse failed\n")
            ReturnValue(0)
        }
        root = JSON.AsObject(tagged)
        IfCondition EqualTo(root, 0) ThenBlock: {
            PrintMessage("board: root is not an object\n")
            ReturnValue(0)
        }
        b = BoardReg.live
        IfCondition EqualTo(b, 0) ThenBlock: {
            nb = AllocateLinkage(LinkagePool.Board)
            BoardReg.live = nb
            hz = JSON.GetNumber(root, "clock_hz")
            nb@clock_hz = hz
        } ElseBlock: {
            hz = JSON.GetNumber(root, "clock_hz")
            hz_off = PoolFieldOffset(LinkagePool.Board, "clock_hz")
            StoreValue(Add(b, hz_off), hz)
        }
        from_maps = Board_LoadMaps(root)
        from_chips = 0
        IfCondition EqualTo(from_maps, 0) ThenBlock: {
            from_chips = Board_LoadChips(root)
        }
        added = Add(from_maps, from_chips)
        Board_BindBus()
        PrintMessage("board chips plugged=")
        PrintNumber(added)
        PrintMessage("\n")
        ReturnValue(added)
    }
}
