// Library.Bus6502.ailang
// Pluggable 16-bit address bus for a 6502-family machine.
//
// The CPU talks only to Bus6502_Read / Bus6502_Write.
// A machine (C64, NES, Apple II, raw 64K) registers 16-byte pages
// or a full 64K image. Unmapped reads return 0xFF; writes are ignored
// unless a page is installed.
//
LibraryImport.Arena

// Page table: 256 entries of 256 bytes (64K). A zero pointer means
// open bus. Devices that need side effects (VIC, CIA, PPU) install
// a handler id in Bus6502.io_id[page] and implement Bus6502_IORead /
// Bus6502_IOWrite in the machine layer.

FixedPool.Bus6502 {
    "pages": Initialize=0
    "io_id": Initialize=0
    "ram": Initialize=0
    "ready": Initialize=0
    "io_read": Initialize=0
    "io_write": Initialize=0
    "cpu_read": Initialize=0
    "cpu_write": Initialize=0
    "phi2": Initialize=0
    "cpu_cycle": Initialize=0
    "phi2_count": Initialize=0
}

Function.Bus6502_Init {
    Body: {
        IfCondition EqualTo(Bus6502.ready, 1) ThenBlock: {
            ReturnValue(0)
        }
        Bus6502.pages = Allocate(2048)
        Bus6502.io_id = Allocate(2048)
        i = 0
        WhileLoop LessThan(i, 256) {
            off = Multiply(i, 8)
            StoreValue(Add(Bus6502.pages, off), 0)
            StoreValue(Add(Bus6502.io_id, off), 0)
            i = Add(i, 1)
        }
        Bus6502.ram = Allocate(65536)
        j = 0
        WhileLoop LessThan(j, 65536) {
            SetByte(Bus6502.ram, j, 0)
            j = Add(j, 1)
        }
        p = 0
        WhileLoop LessThan(p, 256) {
            base = Add(Bus6502.ram, Multiply(p, 256))
            StoreValue(Add(Bus6502.pages, Multiply(p, 8)), base)
            p = Add(p, 1)
        }
        Bus6502.ready = 1
    }
}

Function.Bus6502_MapRam {
    Input: page: Integer
    Input: ptr: Integer
    Body: {
        IfCondition Or(LessThan(page, 0), GreaterThan(page, 255)) ThenBlock: {
            ReturnValue(0)
        }
        StoreValue(Add(Bus6502.pages, Multiply(page, 8)), ptr)
        StoreValue(Add(Bus6502.io_id, Multiply(page, 8)), 0)
    }
}

Function.Bus6502_MapIO {
    Input: page: Integer
    Input: devid: Integer
    Body: {
        IfCondition Or(LessThan(page, 0), GreaterThan(page, 255)) ThenBlock: {
            ReturnValue(0)
        }
        StoreValue(Add(Bus6502.io_id, Multiply(page, 8)), devid)
    }
}

Function.Bus6502_Phi2 {
    Body: {
        IfCondition EqualTo(Bus6502.cpu_cycle, 0) ThenBlock: {
            ReturnValue(0)
        }
        n = Bus6502.phi2_count
        Bus6502.phi2_count = Add(n, 1)
        fn = Bus6502.phi2
        IfCondition NotEqual(fn, 0) ThenBlock: {
            CallIndirect(fn)
        }
    }
}

Function.Bus6502_Read {
    Input: addr: Integer
    Output: Integer
    Body: {
        Bus6502_Phi2()
        a = BitwiseAnd(addr, 65535)
        href0 = Bus6502.cpu_read
        IfCondition NotEqual(href0, 0) ThenBlock: {
            rv0 = CallIndirect(href0, a)
            ReturnValue(rv0)
        }
        page = Divide(a, 256)
        off = Modulo(a, 256)
        io = Dereference(Add(Bus6502.io_id, Multiply(page, 8)))
        IfCondition NotEqual(io, 0) ThenBlock: {
            href = Bus6502.io_read
            IfCondition NotEqual(href, 0) ThenBlock: {
                rv = CallIndirect(href, io, a)
                ReturnValue(rv)
            }
            ReturnValue(Bus6502_IORead(io, a))
        }
        blk = Dereference(Add(Bus6502.pages, Multiply(page, 8)))
        IfCondition EqualTo(blk, 0) ThenBlock: {
            ReturnValue(255)
        }
        v = GetByte(blk, off)
        ReturnValue(v)
    }
}

Function.Bus6502_Write {
    Input: addr: Integer
    Input: value: Integer
    Body: {
        Bus6502_Phi2()
        a = BitwiseAnd(addr, 65535)
        hw0 = Bus6502.cpu_write
        IfCondition NotEqual(hw0, 0) ThenBlock: {
            CallIndirect(hw0, a, value)
            ReturnValue(0)
        }
        page = Divide(a, 256)
        off = Modulo(a, 256)
        io = Dereference(Add(Bus6502.io_id, Multiply(page, 8)))
        IfCondition NotEqual(io, 0) ThenBlock: {
            hw = Bus6502.io_write
            IfCondition NotEqual(hw, 0) ThenBlock: {
                CallIndirect(hw, io, a, value)
                ReturnValue(0)
            }
            Bus6502_IOWrite(io, a, value)
            ReturnValue(0)
        }
        blk = Dereference(Add(Bus6502.pages, Multiply(page, 8)))
        IfCondition EqualTo(blk, 0) ThenBlock: {
            ReturnValue(0)
        }
        b = BitwiseAnd(value, 255)
        SetByte(blk, off, b)
    }
}

Function.Bus6502_IORead {
    Input: devid: Integer
    Input: addr: Integer
    Output: Integer
    Body: {
        ReturnValue(255)
    }
}

Function.Bus6502_IOWrite {
    Input: devid: Integer
    Input: addr: Integer
    Input: value: Integer
    Body: {
        ReturnValue(0)
    }
}

Function.Bus6502_Load {
    Input: addr: Integer
    Input: src: Integer
    Input: n: Integer
    Body: {
        i = 0
        WhileLoop LessThan(i, n) {
            b = GetByte(src, i)
            dest = Add(addr, i)
            Bus6502_Write(dest, b)
            i = Add(i, 1)
        }
    }
}
