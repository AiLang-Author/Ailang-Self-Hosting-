// Library.C64Pack.ailang
// C64 machine pack: register-file VIC/SID/CIA, 6510 port, Lorenz/Palm KERNAL stubs.
// Not the copyrighted ROM. Register models, load c64.board.json, fill $FFxx stubs.

Import.Librarys.Emulators.6502.Board
Import.Librarys.Emulators.6502.CPU
Import.Librarys.Emulators.6502.MOS6526
Import.Librarys.Emulators.6502.MOS6569
Import.Librarys.Emulators.6502.MOS6581

FixedPool.C64PLA {
    "basic": Initialize=0
    "kernal": Initialize=0
    "chargen": Initialize=0
    "ready": Initialize=0
    "cia2_irq_last": Initialize=0
}

Function.C64PLA_Fill {
    Input: buf: Address
    Input: n: Integer
    Body: {
        i = 0
        WhileLoop LessThan(i, n) {
            SetByte(buf, i, 96)
            i = Add(i, 1)
        }
    }
}

Function.C64PLA_Init {
    Body: {
        IfCondition EqualTo(C64PLA.ready, 1) ThenBlock: {
            ReturnValue(0)
        }
        C64PLA.basic = Allocate(8192)
        C64PLA.kernal = Allocate(8192)
        C64PLA.chargen = Allocate(4096)
        C64PLA_Fill(C64PLA.basic, 8192)
        C64PLA_Fill(C64PLA.kernal, 8192)
        C64PLA_Fill(C64PLA.chargen, 4096)
        SetByte(C64PLA.basic, 0, 148)
        SetByte(C64PLA.kernal, 0, 133)
        SetByte(C64PLA.chargen, 0, 60)
        SetByte(C64PLA.kernal, 2609, 173)
        SetByte(C64PLA.kernal, 2610, 13)
        SetByte(C64PLA.kernal, 2611, 220)
        SetByte(C64PLA.kernal, 2612, 64)
        C64PLA.ready = 1
    }
}

Function.C64PLA_Read {
    Input: addr: Integer
    Output: Integer
    Body: {
        a = BitwiseAnd(addr, 65535)
        IfCondition LessEqual(a, 1) ThenBlock: {
            c = Board_ChipForDevid(5)
            v = C64Pack_PortRead(c, a)
            ReturnValue(v)
        }
        p01 = C64Pack_Port01()
        IfCondition And(GreaterEqual(a, 40960), LessThan(a, 49152)) ThenBlock: {
            IfCondition EqualTo(BitwiseAnd(p01, 3), 3) ThenBlock: {
                off = Subtract(a, 40960)
                v = GetByte(C64PLA.basic, off)
                ReturnValue(v)
            }
            v = Board_RamRead(a)
            ReturnValue(v)
        }
        IfCondition And(GreaterEqual(a, 53248), LessThan(a, 57344)) ThenBlock: {
            IfCondition EqualTo(BitwiseAnd(p01, 3), 0) ThenBlock: {
                v = Board_RamRead(a)
                ReturnValue(v)
            }
            IfCondition NotEqual(BitwiseAnd(p01, 4), 0) ThenBlock: {
                page = Divide(a, 256)
                io = Dereference(Add(Bus6502.io_id, Multiply(page, 8)))
                IfCondition And(NotEqual(io, 0), NotEqual(io, 7)) ThenBlock: {
                    v = Board_DevRead(io, a)
                    ReturnValue(v)
                }
                v = Board_RamRead(a)
                ReturnValue(v)
            }
            off = Subtract(a, 53248)
            v = GetByte(C64PLA.chargen, off)
            ReturnValue(v)
        }
        IfCondition GreaterEqual(a, 57344) ThenBlock: {
            IfCondition NotEqual(BitwiseAnd(p01, 2), 0) ThenBlock: {
                IfCondition GreaterEqual(a, 65280) ThenBlock: {
                    c = Board_ChipForDevid(7)
                    st = C64Pack_Ensure(c, 256)
                    off = BitwiseAnd(a, 255)
                    v = GetByte(st, off)
                    ReturnValue(v)
                }
                off = Subtract(a, 57344)
                v = GetByte(C64PLA.kernal, off)
                ReturnValue(v)
            }
            v = Board_RamRead(a)
            ReturnValue(v)
        }
        v = Board_RamRead(a)
        ReturnValue(v)
    }
}

Function.C64PLA_Write {
    Input: addr: Integer
    Input: value: Integer
    Body: {
        a = BitwiseAnd(addr, 65535)
        IfCondition LessEqual(a, 1) ThenBlock: {
            c = Board_ChipForDevid(5)
            C64Pack_PortWrite(c, a, value)
            ReturnValue(0)
        }
        p01 = C64Pack_Port01()
        IfCondition And(GreaterEqual(a, 53248), LessThan(a, 57344)) ThenBlock: {
            IfCondition NotEqual(BitwiseAnd(p01, 3), 0) ThenBlock: {
                IfCondition NotEqual(BitwiseAnd(p01, 4), 0) ThenBlock: {
                    page = Divide(a, 256)
                    io = Dereference(Add(Bus6502.io_id, Multiply(page, 8)))
                    IfCondition And(NotEqual(io, 0), NotEqual(io, 7)) ThenBlock: {
                        Board_DevWrite(io, a, value)
                        ReturnValue(0)
                    }
                }
            }
        }
        Board_RamWrite(a, value)
    }
}

Function.C64Pack_Ensure {
    Input: chip: Address
    Input: nbytes: Integer
    Output: Integer
    Body: {
        st_off = PoolFieldOffset(LinkagePool.Chip, "state")
        st = Dereference(Add(chip, st_off))
        IfCondition NotEqual(st, 0) ThenBlock: {
            ReturnValue(st)
        }
        st = Allocate(nbytes)
        zi = 0
        WhileLoop LessThan(zi, nbytes) {
            SetByte(st, zi, 0)
            zi = Add(zi, 1)
        }
        StoreValue(Add(chip, st_off), st)
        ReturnValue(st)
    }
}

Function.C64Pack_RegRead {
    Input: chip: Address
    Input: addr: Integer
    Input: mask: Integer
    Output: Integer
    Body: {
        st = C64Pack_Ensure(chip, 256)
        off = BitwiseAnd(addr, mask)
        v = GetByte(st, off)
        ReturnValue(v)
    }
}

Function.C64Pack_RegWrite {
    Input: chip: Address
    Input: addr: Integer
    Input: value: Integer
    Body: {
        st = C64Pack_Ensure(chip, 256)
        off = BitwiseAnd(addr, 255)
        b = BitwiseAnd(value, 255)
        SetByte(st, off, b)
    }
}

Function.C64Pack_VICRead {
    Input: chip: Address
    Input: addr: Integer
    Output: Integer
    Body: {
        v = C64Pack_RegRead(chip, addr, 63)
        ReturnValue(v)
    }
}

Function.C64Pack_VICWrite {
    Input: chip: Address
    Input: addr: Integer
    Input: value: Integer
    Body: {
        C64Pack_RegWrite(chip, addr, value)
    }
}

Function.C64Pack_SIDRead {
    Input: chip: Address
    Input: addr: Integer
    Output: Integer
    Body: {
        v = C64Pack_RegRead(chip, addr, 31)
        ReturnValue(v)
    }
}

Function.C64Pack_SIDWrite {
    Input: chip: Address
    Input: addr: Integer
    Input: value: Integer
    Body: {
        C64Pack_RegWrite(chip, addr, value)
    }
}

Function.C64Pack_CIARead {
    Input: chip: Address
    Input: addr: Integer
    Output: Integer
    Body: {
        st = C64Pack_Ensure(chip, 16)
        off = BitwiseAnd(addr, 15)
        v = GetByte(st, off)
        IfCondition EqualTo(v, 0) ThenBlock: {
            IfCondition Or(EqualTo(off, 0), EqualTo(off, 1)) ThenBlock: {
                ReturnValue(255)
            }
        }
        ReturnValue(v)
    }
}

Function.C64Pack_CIAWrite {
    Input: chip: Address
    Input: addr: Integer
    Input: value: Integer
    Body: {
        C64Pack_RegWrite(chip, addr, value)
    }
}

Function.C64Pack_PortRead {
    Input: chip: Address
    Input: addr: Integer
    Output: Integer
    Body: {
        st = C64Pack_Ensure(chip, 2)
        b0 = GetByte(st, 0)
        b1 = GetByte(st, 1)
        IfCondition EqualTo(b0, 0) ThenBlock: {
            IfCondition EqualTo(b1, 0) ThenBlock: {
                SetByte(st, 0, 47)
                SetByte(st, 1, 55)
            }
        }
        off = BitwiseAnd(addr, 1)
        v = GetByte(st, off)
        ReturnValue(v)
    }
}

Function.C64Pack_PortWrite {
    Input: chip: Address
    Input: addr: Integer
    Input: value: Integer
    Body: {
        st = C64Pack_Ensure(chip, 2)
        off = BitwiseAnd(addr, 1)
        b = BitwiseAnd(value, 255)
        SetByte(st, off, b)
    }
}

Function.C64Pack_Port01 {
    Output: Integer
    Body: {
        c = Board_ChipForDevid(5)
        IfCondition EqualTo(c, 0) ThenBlock: {
            ReturnValue(55)
        }
        st_off = PoolFieldOffset(LinkagePool.Chip, "state")
        st = Dereference(Add(c, st_off))
        IfCondition EqualTo(st, 0) ThenBlock: {
            ReturnValue(55)
        }
        v = GetByte(st, 1)
        ReturnValue(v)
    }
}

Function.C64Pack_KernalRead {
    Input: chip: Address
    Input: addr: Integer
    Output: Integer
    Body: {
        p01 = C64Pack_Port01()
        IfCondition EqualTo(BitwiseAnd(p01, 2), 0) ThenBlock: {
            v = Board_RamRead(addr)
            ReturnValue(v)
        }
        st = C64Pack_Ensure(chip, 256)
        off = BitwiseAnd(addr, 255)
        v = GetByte(st, off)
        ReturnValue(v)
    }
}

Function.C64Pack_KernalWrite {
    Input: chip: Address
    Input: addr: Integer
    Input: value: Integer
    Body: {
        // Writes always hit RAM under the KERNAL overlay (ROM is read-only).
        Board_RamWrite(addr, value)
    }
}

Function.C64Pack_PokeFF {
    Input: st: Address
    Input: off: Integer
    Input: b: Integer
    Body: {
        SetByte(st, off, b)
    }
}

Function.C64Pack_FillKernal {
    Body: {
        chip = Board_ChipForDevid(7)
        IfCondition EqualTo(chip, 0) ThenBlock: {
            ReturnValue(0)
        }
        st = C64Pack_Ensure(chip, 256)
        i = 0
        WhileLoop LessThan(i, 256) {
            SetByte(st, i, 96)
            i = Add(i, 1)
        }
        // GETIN $FFE4: LDA #0 / RTS
        C64Pack_PokeFF(st, 228, 169)
        C64Pack_PokeFF(st, 229, 32)
        C64Pack_PokeFF(st, 230, 96)
        // Palm IRQ $FF48
        C64Pack_PokeFF(st, 72, 72)
        C64Pack_PokeFF(st, 73, 138)
        C64Pack_PokeFF(st, 74, 72)
        C64Pack_PokeFF(st, 75, 152)
        C64Pack_PokeFF(st, 76, 72)
        C64Pack_PokeFF(st, 77, 186)
        C64Pack_PokeFF(st, 78, 189)
        C64Pack_PokeFF(st, 79, 4)
        C64Pack_PokeFF(st, 80, 1)
        C64Pack_PokeFF(st, 81, 41)
        C64Pack_PokeFF(st, 82, 16)
        C64Pack_PokeFF(st, 83, 240)
        C64Pack_PokeFF(st, 84, 3)
        C64Pack_PokeFF(st, 85, 108)
        C64Pack_PokeFF(st, 86, 22)
        C64Pack_PokeFF(st, 87, 3)
        C64Pack_PokeFF(st, 88, 108)
        C64Pack_PokeFF(st, 89, 20)
        C64Pack_PokeFF(st, 90, 3)
        // IRQ vector $FFFE/$FFFF -> $FF48
        C64Pack_PokeFF(st, 254, 72)
        C64Pack_PokeFF(st, 255, 255)
        // NMI $FFFA/$FFFB -> $FF48
        C64Pack_PokeFF(st, 250, 72)
        C64Pack_PokeFF(st, 251, 255)
        ReturnValue(1)
    }
}

Function.C64Pack_PalmRAM {
    Body: {
        Bus6502_Write(0, 47)
        Bus6502_Write(1, 55)
        Bus6502_Write(2, 0)
        Bus6502_Write(40962, 0)
        Bus6502_Write(40963, 128)
        Bus6502_Write(510, 255)
        Bus6502_Write(511, 127)
        Bus6502_Write(788, 64)
        Bus6502_Write(789, 3)
        Bus6502_Write(790, 64)
        Bus6502_Write(791, 3)
        Bus6502_Write(780, 0)
    }
}

Function.C64Pack_Register {
    Body: {
        rv = AddressOf(MOS6569_Read)
        wv = AddressOf(MOS6569_Write)
        tv = AddressOf(MOS6569_Tick)
        Board_RegisterModel("C64VIC", rv, wv, tv)
        rs = AddressOf(MOS6581_Read)
        ws = AddressOf(MOS6581_Write)
        Board_RegisterModel("C64SID", rs, ws, 0)
        rc = AddressOf(MOS6526_Read)
        wc = AddressOf(MOS6526_Write)
        tc = AddressOf(MOS6526_Tick)
        Board_RegisterModel("C64CIA", rc, wc, tc)
        rp = AddressOf(C64Pack_PortRead)
        wp = AddressOf(C64Pack_PortWrite)
        Board_RegisterModel("Port6510", rp, wp, 0)
        rk = AddressOf(C64Pack_KernalRead)
        wk = AddressOf(C64Pack_KernalWrite)
        Board_RegisterModel("KernalStub", rk, wk, 0)
    }
}

Function.C64Pack_RTS {
    Body: {
        sp = CPU.SP
        sp = BitwiseAnd(Add(sp, 1), 255)
        a1 = BitwiseOr(256, sp)
        lo = Bus6502_Read(a1)
        sp = BitwiseAnd(Add(sp, 1), 255)
        a2 = BitwiseOr(256, sp)
        hi = Bus6502_Read(a2)
        CPU.SP = sp
        dest = BitwiseOr(lo, ShiftLeft(hi, 8))
        CPU.PC = BitwiseAnd(Add(dest, 1), 65535)
    }
}

Function.C64Pack_PetsciiChar {
    Input: a: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(a, 13) ThenBlock: {
            ReturnValue(10)
        }
        IfCondition And(GreaterEqual(a, 193), LessEqual(a, 218)) ThenBlock: {
            ReturnValue(Subtract(a, 128))
        }
        ReturnValue(a)
    }
}

Function.C64Pack_CHROUT {
    Body: {
        Bus6502_Write(780, 0)
        a = CPU.A
        ch = C64Pack_PetsciiChar(a)
        IfCondition EqualTo(ch, 10) ThenBlock: {
            PrintMessage("\n")
        } ElseBlock: {
            IfCondition And(GreaterEqual(ch, 32), LessEqual(ch, 126)) ThenBlock: {
                buf = Allocate(2)
                SetByte(buf, 0, ch)
                SetByte(buf, 1, 0)
                PrintMessage(buf)
                Deallocate(buf, 2)
            }
        }
        C64Pack_RTS()
    }
}

Function.C64Pack_GETIN {
    Body: {
        CPU.A = 32
        CPU.F_ZERO = 0
        CPU.F_NEG = 0
        C64Pack_RTS()
    }
}

Function.C64Pack_PollIRQ {
    Body: {
        irq = 0
        c1 = Board_ChipForDevid(3)
        v1 = MOS6526_IRQLevel(c1)
        IfCondition EqualTo(v1, 1) ThenBlock: { irq = 1 }
        cv = Board_ChipForDevid(1)
        vv = MOS6569_IRQLevel(cv)
        IfCondition EqualTo(vv, 1) ThenBlock: { irq = 1 }
        CPU.irq_pending = irq
        c2 = Board_ChipForDevid(4)
        v2 = MOS6526_IRQLevel(c2)
        last = C64PLA.cia2_irq_last
        IfCondition And(EqualTo(v2, 1), EqualTo(last, 0)) ThenBlock: {
            CPU.nmi_pending = 1
        }
        C64PLA.cia2_irq_last = v2
    }
}

Function.C64Pack_Phi2 {
    Body: {
        Board_TickAll(1)
        C64Pack_PollIRQ()
    }
}

Function.C64Pack_AfterStep {
    Input: cycles: Integer
    Body: {
        IfCondition GreaterThan(cycles, 0) ThenBlock: {
            Board_TickAll(cycles)
        }
        C64Pack_PollIRQ()
    }
}

Function.C64Pack_BringUp {
    Input: path: Address
    Output: Integer
    Body: {
        C64Pack_Register()
        n = Board_LoadJSON(path)
        C64Pack_FillKernal()
        C64PLA_Init()
        Bus6502.cpu_read = AddressOf(C64PLA_Read)
        Bus6502.cpu_write = AddressOf(C64PLA_Write)
        Bus6502.phi2 = AddressOf(C64Pack_Phi2)
        C64Pack_PalmRAM()
        ReturnValue(n)
    }
}
