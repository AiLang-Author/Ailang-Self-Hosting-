// Library.CPU6502.ailang
// MOS 6502/6510 CPU Interpreter
//
// Features:
//   - All documented 6502 opcodes
//   - All addressing modes
//   - Accurate flag handling
//   - Cycle counting (for future timing)
//   - BCD mode support
//
// Usage: Import.Librarys.Emulators.6502.CPU
//
// This is a reusable 6502 core - works for C64, NES, Atari, Apple II, etc.
// Memory access goes through external Read/Write functions.
//
// Copyright (c) 2025-2026 Sean Collins, 2 Paws Machine and Engineering. All rights reserved.
// Licensed under the Sean Collins Software License (SCSL v1.0).

Import.Librarys.Emulators.6502.Bus

// =============================================================================
// CPU STATE
// =============================================================================

FixedPool.CPU {
    // Registers
    "A": Initialize=0           // Accumulator
    "X": Initialize=0           // X Index Register
    "Y": Initialize=0           // Y Index Register
    "SP": Initialize=0xFF       // Stack Pointer (offset in page 1)
    "PC": Initialize=0          // Program Counter
    
    // Status Register Flags (bits in P register)
    "F_CARRY": Initialize=0     // Bit 0: Carry
    "F_ZERO": Initialize=0      // Bit 1: Zero
    "F_IRQ": Initialize=1       // Bit 2: IRQ Disable (starts disabled)
    "F_DECIMAL": Initialize=0   // Bit 3: Decimal Mode
    "F_BREAK": Initialize=0     // Bit 4: Break (not a real flag, set on BRK push)
    "F_UNUSED": Initialize=1    // Bit 5: Unused (always 1)
    "F_OVERFLOW": Initialize=0  // Bit 6: Overflow
    "F_NEGATIVE": Initialize=0  // Bit 7: Negative
    
    // Cycle counter
    "cycles": Initialize=0
    "total_cycles": Initialize=0
    
    // Halt flag
    "halted": Initialize=0
    
    // IRQ/NMI pending
    "irq_pending": Initialize=0
    "nmi_pending": Initialize=0
    "ane_magic": Initialize=238
    "phi0": Initialize=0
}

// =============================================================================
// INITIALIZATION
// =============================================================================

Function.CPU_Init {
    Body: {
        CPU.A = 0
        CPU.X = 0
        CPU.Y = 0
        CPU.SP = 0xFF
        CPU.PC = 0
        
        CPU.F_CARRY = 0
        CPU.F_ZERO = 0
        CPU.F_IRQ = 1
        CPU.F_DECIMAL = 0
        CPU.F_BREAK = 0
        CPU.F_UNUSED = 1
        CPU.F_OVERFLOW = 0
        CPU.F_NEGATIVE = 0
        
        CPU.cycles = 0
        CPU.total_cycles = 0
        CPU.halted = 0
        CPU.irq_pending = 0
        CPU.nmi_pending = 0
        CPU.ane_magic = 238
        
        Bus6502_Init()
        PrintMessage("6502 CPU initialized\n")
    }
}

// Reset CPU - reads reset vector from FFFC/FFFD
Function.CPU_Reset {
    Body: {
        CPU_Init()
        
        // Read reset vector
        lo = Bus6502_Read(0xFFFC)
        hi = Bus6502_Read(0xFFFD)
        CPU.PC = BitwiseOr(lo, ShiftLeft(hi, 8))
        
        PrintMessage("CPU Reset - PC=$")
        PrintHex(CPU.PC)
        PrintMessage("\n")
    }
}

// Set PC directly (for running PRG files)
Function.CPU_SetPC {
    Input: addr: Integer
    Body: {
        CPU.PC = BitwiseAnd(addr, 0xFFFF)
    }
}

// =============================================================================
// STATUS REGISTER HELPERS
// =============================================================================

// Pack flags into P register byte
Function.CPU_GetP {
    Output: Integer
    Body: {
        p = 0
        p = BitwiseOr(p, CPU.F_CARRY)
        p = BitwiseOr(p, ShiftLeft(CPU.F_ZERO, 1))
        p = BitwiseOr(p, ShiftLeft(CPU.F_IRQ, 2))
        p = BitwiseOr(p, ShiftLeft(CPU.F_DECIMAL, 3))
        p = BitwiseOr(p, ShiftLeft(CPU.F_BREAK, 4))
        p = BitwiseOr(p, ShiftLeft(1, 5))  // Unused always 1
        p = BitwiseOr(p, ShiftLeft(CPU.F_OVERFLOW, 6))
        p = BitwiseOr(p, ShiftLeft(CPU.F_NEGATIVE, 7))
        ReturnValue(p)
    }
}

// Unpack P register byte into flags
Function.CPU_SetP {
    Input: p: Integer
    Body: {
        CPU.F_CARRY = BitwiseAnd(p, 0x01)
        CPU.F_ZERO = BitwiseAnd(ShiftRight(p, 1), 0x01)
        CPU.F_IRQ = BitwiseAnd(ShiftRight(p, 2), 0x01)
        CPU.F_DECIMAL = BitwiseAnd(ShiftRight(p, 3), 0x01)
        CPU.F_BREAK = BitwiseAnd(ShiftRight(p, 4), 0x01)
        CPU.F_UNUSED = 1
        CPU.F_OVERFLOW = BitwiseAnd(ShiftRight(p, 6), 0x01)
        CPU.F_NEGATIVE = BitwiseAnd(ShiftRight(p, 7), 0x01)
    }
}

// Update N and Z flags based on value
Function.CPU_UpdateNZ {
    Input: value: Integer
    Body: {
        v = BitwiseAnd(value, 0xFF)
        CPU.F_ZERO = 0
        CPU.F_NEGATIVE = 0
        IfCondition EqualTo(v, 0) ThenBlock: {
            CPU.F_ZERO = 1
        }
        IfCondition NotEqual(BitwiseAnd(v, 0x80), 0) ThenBlock: {
            CPU.F_NEGATIVE = 1
        }
    }
}

// =============================================================================
// STACK OPERATIONS
// =============================================================================

Function.CPU_Push {
    Input: value: Integer
    Body: {
        addr = BitwiseOr(0x0100, CPU.SP)
        Bus6502_Write(addr, value)
        CPU.SP = BitwiseAnd(Subtract(CPU.SP, 1), 0xFF)
    }
}

Function.CPU_Pull {
    Output: Integer
    Body: {
        CPU.SP = BitwiseAnd(Add(CPU.SP, 1), 0xFF)
        addr = BitwiseOr(0x0100, CPU.SP)
        ReturnValue(Bus6502_Read(addr))
    }
}

Function.CPU_Push16 {
    Input: value: Integer
    Body: {
        CPU_Push(BitwiseAnd(ShiftRight(value, 8), 0xFF))
        CPU_Push(BitwiseAnd(value, 0xFF))
    }
}

Function.CPU_Pull16 {
    Output: Integer
    Body: {
        lo = CPU_Pull()
        hi = CPU_Pull()
        ReturnValue(BitwiseOr(lo, ShiftLeft(hi, 8)))
    }
}

// =============================================================================
// ADDRESSING MODES
// =============================================================================

// Immediate: next byte is the operand
Function.CPU_Addr_Imm {
    Output: Integer
    Body: {
        addr = CPU.PC
        CPU.PC = Add(CPU.PC, 1)
        ReturnValue(addr)
    }
}

// Zero Page: next byte is ZP address
Function.CPU_Addr_ZP {
    Output: Integer
    Body: {
        addr = Bus6502_Read(CPU.PC)
        CPU.PC = Add(CPU.PC, 1)
        ReturnValue(addr)
    }
}

// Zero Page,X: ZP address + X (wraps in ZP)
Function.CPU_Addr_ZPX {
    Output: Integer
    Body: {
        base = Bus6502_Read(CPU.PC)
        CPU.PC = Add(CPU.PC, 1)
        ReturnValue(BitwiseAnd(Add(base, CPU.X), 0xFF))
    }
}

// Zero Page,Y: ZP address + Y (wraps in ZP)
Function.CPU_Addr_ZPY {
    Output: Integer
    Body: {
        base = Bus6502_Read(CPU.PC)
        CPU.PC = Add(CPU.PC, 1)
        ReturnValue(BitwiseAnd(Add(base, CPU.Y), 0xFF))
    }
}

// Absolute: next two bytes are address
Function.CPU_Addr_Abs {
    Output: Integer
    Body: {
        lo = Bus6502_Read(CPU.PC)
        hi = Bus6502_Read(Add(CPU.PC, 1))
        CPU.PC = Add(CPU.PC, 2)
        ReturnValue(BitwiseOr(lo, ShiftLeft(hi, 8)))
    }
}

// Absolute,X: absolute + X
Function.CPU_Addr_AbsX {
    Output: Integer
    Body: {
        lo = Bus6502_Read(CPU.PC)
        hi = Bus6502_Read(Add(CPU.PC, 1))
        CPU.PC = Add(CPU.PC, 2)
        base = BitwiseOr(lo, ShiftLeft(hi, 8))
        ReturnValue(BitwiseAnd(Add(base, CPU.X), 0xFFFF))
    }
}

// Absolute,Y: absolute + Y
Function.CPU_Addr_AbsY {
    Output: Integer
    Body: {
        lo = Bus6502_Read(CPU.PC)
        hi = Bus6502_Read(Add(CPU.PC, 1))
        CPU.PC = Add(CPU.PC, 2)
        base = BitwiseOr(lo, ShiftLeft(hi, 8))
        ReturnValue(BitwiseAnd(Add(base, CPU.Y), 0xFFFF))
    }
}

// Indirect: (addr) - used only by JMP
Function.CPU_Addr_Ind {
    Output: Integer
    Body: {
        ptr_lo = Bus6502_Read(CPU.PC)
        ptr_hi = Bus6502_Read(Add(CPU.PC, 1))
        CPU.PC = Add(CPU.PC, 2)
        ptr = BitwiseOr(ptr_lo, ShiftLeft(ptr_hi, 8))
        
        // 6502 bug: wraps within page
        lo = Bus6502_Read(ptr)
        ptr_next = BitwiseOr(BitwiseAnd(Add(ptr, 1), 0xFF), BitwiseAnd(ptr, 0xFF00))
        hi = Bus6502_Read(ptr_next)
        
        ReturnValue(BitwiseOr(lo, ShiftLeft(hi, 8)))
    }
}

// Indexed Indirect: (ZP,X)
Function.CPU_Addr_IndX {
    Output: Integer
    Body: {
        base = Bus6502_Read(CPU.PC)
        CPU.PC = Add(CPU.PC, 1)
        ptr = BitwiseAnd(Add(base, CPU.X), 0xFF)
        
        lo = Bus6502_Read(ptr)
        hi = Bus6502_Read(BitwiseAnd(Add(ptr, 1), 0xFF))
        
        ReturnValue(BitwiseOr(lo, ShiftLeft(hi, 8)))
    }
}

// Indirect Indexed: (ZP),Y
Function.CPU_Addr_IndY {
    Output: Integer
    Body: {
        ptr = Bus6502_Read(CPU.PC)
        CPU.PC = Add(CPU.PC, 1)
        
        lo = Bus6502_Read(ptr)
        hi = Bus6502_Read(BitwiseAnd(Add(ptr, 1), 0xFF))
        base = BitwiseOr(lo, ShiftLeft(hi, 8))
        
        ReturnValue(BitwiseAnd(Add(base, CPU.Y), 0xFFFF))
    }
}

// Relative: signed offset for branches
Function.CPU_Addr_Rel {
    Output: Integer
    Body: {
        offset = Bus6502_Read(CPU.PC)
        CPU.PC = Add(CPU.PC, 1)
        
        // Sign extend
        IfCondition NotEqual(BitwiseAnd(offset, 0x80), 0) ThenBlock: {
            offset = Subtract(offset, 256)
        }
        
        ReturnValue(BitwiseAnd(Add(CPU.PC, offset), 0xFFFF))
    }
}

// =============================================================================
// INSTRUCTION HELPERS
// =============================================================================

// ADC - Add with Carry
Function.CPU_ADC {
    Input: value: Integer
    Body: {
        IfCondition EqualTo(CPU.F_DECIMAL, 1) ThenBlock: {
            // BCD mode
            CPU_ADC_BCD(value)
        } ElseBlock: {
            // Binary mode
            result = Add(Add(CPU.A, value), CPU.F_CARRY)
            
            // Overflow: sign changed incorrectly
            ov = BitwiseAnd(BitwiseAnd(BitwiseXor(CPU.A, result), BitwiseXor(value, result)), 0x80)
            IfCondition NotEqual(ov, 0) ThenBlock: {
                CPU.F_OVERFLOW = 1
            } ElseBlock: {
                CPU.F_OVERFLOW = 0
            }
            
            // Carry
            IfCondition GreaterThan(result, 255) ThenBlock: {
                CPU.F_CARRY = 1
            } ElseBlock: {
                CPU.F_CARRY = 0
            }
            
            CPU.A = BitwiseAnd(result, 0xFF)
            CPU_UpdateNZ(CPU.A)
        }
    }
}

// ADC in BCD mode
Function.CPU_ADC_BCD {
    Input: value: Integer
    Body: {
        lo = Add(Add(BitwiseAnd(CPU.A, 0x0F), BitwiseAnd(value, 0x0F)), CPU.F_CARRY)
        hi = Add(BitwiseAnd(CPU.A, 0xF0), BitwiseAnd(value, 0xF0))
        
        IfCondition GreaterThan(lo, 9) ThenBlock: {
            lo = Add(lo, 6)
        }
        IfCondition GreaterThan(lo, 0x0F) ThenBlock: {
            hi = Add(hi, 0x10)
        }
        
        IfCondition GreaterThan(hi, 0x90) ThenBlock: {
            hi = Add(hi, 0x60)
        }
        
        IfCondition GreaterThan(hi, 0xFF) ThenBlock: {
            CPU.F_CARRY = 1
        } ElseBlock: {
            CPU.F_CARRY = 0
        }
        
        CPU.A = BitwiseAnd(BitwiseOr(BitwiseAnd(lo, 0x0F), hi), 0xFF)
        CPU_UpdateNZ(CPU.A)
    }
}

// SBC - Subtract with Borrow
Function.CPU_SBC {
    Input: value: Integer
    Body: {
        IfCondition EqualTo(CPU.F_DECIMAL, 1) ThenBlock: {
            CPU_SBC_BCD(value)
        } ElseBlock: {
            // SBC is ADC with inverted operand
            CPU_ADC(BitwiseXor(value, 0xFF))
        }
    }
}

// SBC in BCD mode
Function.CPU_SBC_BCD {
    Input: value: Integer
    Body: {
        borrow = Subtract(1, CPU.F_CARRY)
        lo = Subtract(Subtract(BitwiseAnd(CPU.A, 0x0F), BitwiseAnd(value, 0x0F)), borrow)
        hi = Subtract(BitwiseAnd(CPU.A, 0xF0), BitwiseAnd(value, 0xF0))
        
        IfCondition LessThan(lo, 0) ThenBlock: {
            lo = Subtract(lo, 6)
            hi = Subtract(hi, 0x10)
        }
        
        IfCondition LessThan(hi, 0) ThenBlock: {
            hi = Subtract(hi, 0x60)
        }
        
        IfCondition GreaterEqual(Subtract(Subtract(CPU.A, value), borrow), 0) ThenBlock: {
            CPU.F_CARRY = 1
        } ElseBlock: {
            CPU.F_CARRY = 0
        }
        
        CPU.A = BitwiseAnd(BitwiseOr(BitwiseAnd(lo, 0x0F), BitwiseAnd(hi, 0xF0)), 0xFF)
        CPU_UpdateNZ(CPU.A)
    }
}

// Compare helper
Function.CPU_Compare {
    Input: reg: Integer
    Input: value: Integer
    Body: {
        result = Subtract(reg, value)
        
        IfCondition GreaterEqual(reg, value) ThenBlock: {
            CPU.F_CARRY = 1
        } ElseBlock: {
            CPU.F_CARRY = 0
        }
        
        CPU_UpdateNZ(BitwiseAnd(result, 0xFF))
    }
}

Function.CPU_SLO {
    Input: addr: Integer
    Body: {
        val = Bus6502_Read(addr)
        CPU.F_CARRY = BitwiseAnd(ShiftRight(val, 7), 1)
        val = BitwiseAnd(ShiftLeft(val, 1), 0xFF)
        Bus6502_Write(addr, val)
        CPU.A = BitwiseOr(CPU.A, val)
        CPU_UpdateNZ(CPU.A)
    }
}

Function.CPU_RLA {
    Input: addr: Integer
    Body: {
        val = Bus6502_Read(addr)
        oldc = CPU.F_CARRY
        CPU.F_CARRY = BitwiseAnd(ShiftRight(val, 7), 1)
        val = BitwiseAnd(ShiftLeft(val, 1), 0xFF)
        val = BitwiseOr(val, oldc)
        Bus6502_Write(addr, val)
        CPU.A = BitwiseAnd(CPU.A, val)
        CPU_UpdateNZ(CPU.A)
    }
}

Function.CPU_SRE {
    Input: addr: Integer
    Body: {
        val = Bus6502_Read(addr)
        CPU.F_CARRY = BitwiseAnd(val, 1)
        val = ShiftRight(val, 1)
        Bus6502_Write(addr, val)
        CPU.A = BitwiseXor(CPU.A, val)
        CPU_UpdateNZ(CPU.A)
    }
}

Function.CPU_RRA {
    Input: addr: Integer
    Body: {
        val = Bus6502_Read(addr)
        oldc = CPU.F_CARRY
        CPU.F_CARRY = BitwiseAnd(val, 1)
        val = ShiftRight(val, 1)
        val = BitwiseOr(val, ShiftLeft(oldc, 7))
        Bus6502_Write(addr, val)
        CPU_ADC(val)
    }
}

Function.CPU_DCP {
    Input: addr: Integer
    Body: {
        val = BitwiseAnd(Subtract(Bus6502_Read(addr), 1), 0xFF)
        Bus6502_Write(addr, val)
        CPU_Compare(CPU.A, val)
    }
}

Function.CPU_ISC {
    Input: addr: Integer
    Body: {
        val = BitwiseAnd(Add(Bus6502_Read(addr), 1), 0xFF)
        Bus6502_Write(addr, val)
        CPU_SBC(val)
    }
}

Function.CPU_LAX {
    Input: addr: Integer
    Body: {
        val = Bus6502_Read(addr)
        CPU.A = val
        CPU.X = val
        CPU_UpdateNZ(val)
    }
}

Function.CPU_SAX {
    Input: addr: Integer
    Body: {
        sax = BitwiseAnd(CPU.A, CPU.X)
        Bus6502_Write(addr, sax)
    }
}

Function.CPU_NOPSkip {
    Input: extra: Integer
    Body: {
        CPU.PC = BitwiseAnd(Add(CPU.PC, extra), 0xFFFF)
    }
}

// Undocumented NMOS opcodes. Return 0 if `op` is not unofficial.
Function.CPU_ExecuteUndoc {
    Input: op: Integer
    Output: Integer
    Body: {
        // SLO / ASO: ASL mem then ORA
        IfCondition EqualTo(op, 7) ThenBlock: {
            uaddr = CPU_Addr_ZP()
            CPU_SLO(uaddr)
            ReturnValue(5)
        }
        IfCondition EqualTo(op, 23) ThenBlock: {
            uaddr = CPU_Addr_ZPX()
            CPU_SLO(uaddr)
            ReturnValue(6)
        }
        IfCondition EqualTo(op, 15) ThenBlock: {
            uaddr = CPU_Addr_Abs()
            CPU_SLO(uaddr)
            ReturnValue(6)
        }
        IfCondition EqualTo(op, 31) ThenBlock: {
            uaddr = CPU_Addr_AbsX()
            CPU_SLO(uaddr)
            ReturnValue(7)
        }
        IfCondition EqualTo(op, 27) ThenBlock: {
            uaddr = CPU_Addr_AbsY()
            CPU_SLO(uaddr)
            ReturnValue(7)
        }
        IfCondition EqualTo(op, 3) ThenBlock: {
            uaddr = CPU_Addr_IndX()
            CPU_SLO(uaddr)
            ReturnValue(8)
        }
        IfCondition EqualTo(op, 19) ThenBlock: {
            uaddr = CPU_Addr_IndY()
            CPU_SLO(uaddr)
            ReturnValue(8)
        }

        // RLA: ROL mem then AND
        IfCondition EqualTo(op, 39) ThenBlock: {
            uaddr = CPU_Addr_ZP()
            CPU_RLA(uaddr)
            ReturnValue(5)
        }
        IfCondition EqualTo(op, 55) ThenBlock: {
            uaddr = CPU_Addr_ZPX()
            CPU_RLA(uaddr)
            ReturnValue(6)
        }
        IfCondition EqualTo(op, 47) ThenBlock: {
            uaddr = CPU_Addr_Abs()
            CPU_RLA(uaddr)
            ReturnValue(6)
        }
        IfCondition EqualTo(op, 63) ThenBlock: {
            uaddr = CPU_Addr_AbsX()
            CPU_RLA(uaddr)
            ReturnValue(7)
        }
        IfCondition EqualTo(op, 59) ThenBlock: {
            uaddr = CPU_Addr_AbsY()
            CPU_RLA(uaddr)
            ReturnValue(7)
        }
        IfCondition EqualTo(op, 35) ThenBlock: {
            uaddr = CPU_Addr_IndX()
            CPU_RLA(uaddr)
            ReturnValue(8)
        }
        IfCondition EqualTo(op, 51) ThenBlock: {
            uaddr = CPU_Addr_IndY()
            CPU_RLA(uaddr)
            ReturnValue(8)
        }

        // SRE / LSE: LSR mem then EOR
        IfCondition EqualTo(op, 71) ThenBlock: {
            uaddr = CPU_Addr_ZP()
            CPU_SRE(uaddr)
            ReturnValue(5)
        }
        IfCondition EqualTo(op, 87) ThenBlock: {
            uaddr = CPU_Addr_ZPX()
            CPU_SRE(uaddr)
            ReturnValue(6)
        }
        IfCondition EqualTo(op, 79) ThenBlock: {
            uaddr = CPU_Addr_Abs()
            CPU_SRE(uaddr)
            ReturnValue(6)
        }
        IfCondition EqualTo(op, 95) ThenBlock: {
            uaddr = CPU_Addr_AbsX()
            CPU_SRE(uaddr)
            ReturnValue(7)
        }
        IfCondition EqualTo(op, 91) ThenBlock: {
            uaddr = CPU_Addr_AbsY()
            CPU_SRE(uaddr)
            ReturnValue(7)
        }
        IfCondition EqualTo(op, 67) ThenBlock: {
            uaddr = CPU_Addr_IndX()
            CPU_SRE(uaddr)
            ReturnValue(8)
        }
        IfCondition EqualTo(op, 83) ThenBlock: {
            uaddr = CPU_Addr_IndY()
            CPU_SRE(uaddr)
            ReturnValue(8)
        }

        // RRA: ROR mem then ADC
        IfCondition EqualTo(op, 103) ThenBlock: {
            uaddr = CPU_Addr_ZP()
            CPU_RRA(uaddr)
            ReturnValue(5)
        }
        IfCondition EqualTo(op, 119) ThenBlock: {
            uaddr = CPU_Addr_ZPX()
            CPU_RRA(uaddr)
            ReturnValue(6)
        }
        IfCondition EqualTo(op, 111) ThenBlock: {
            uaddr = CPU_Addr_Abs()
            CPU_RRA(uaddr)
            ReturnValue(6)
        }
        IfCondition EqualTo(op, 127) ThenBlock: {
            uaddr = CPU_Addr_AbsX()
            CPU_RRA(uaddr)
            ReturnValue(7)
        }
        IfCondition EqualTo(op, 123) ThenBlock: {
            uaddr = CPU_Addr_AbsY()
            CPU_RRA(uaddr)
            ReturnValue(7)
        }
        IfCondition EqualTo(op, 99) ThenBlock: {
            uaddr = CPU_Addr_IndX()
            CPU_RRA(uaddr)
            ReturnValue(8)
        }
        IfCondition EqualTo(op, 115) ThenBlock: {
            uaddr = CPU_Addr_IndY()
            CPU_RRA(uaddr)
            ReturnValue(8)
        }

        // SAX / AXS store: write A&X
        IfCondition EqualTo(op, 135) ThenBlock: {
            uaddr = CPU_Addr_ZP()
            CPU_SAX(uaddr)
            ReturnValue(3)
        }
        IfCondition EqualTo(op, 151) ThenBlock: {
            uaddr = CPU_Addr_ZPY()
            CPU_SAX(uaddr)
            ReturnValue(4)
        }
        IfCondition EqualTo(op, 143) ThenBlock: {
            uaddr = CPU_Addr_Abs()
            CPU_SAX(uaddr)
            ReturnValue(4)
        }
        IfCondition EqualTo(op, 131) ThenBlock: {
            uaddr = CPU_Addr_IndX()
            CPU_SAX(uaddr)
            ReturnValue(6)
        }

        // LAX: LDA + LDX
        IfCondition EqualTo(op, 167) ThenBlock: {
            uaddr = CPU_Addr_ZP()
            CPU_LAX(uaddr)
            ReturnValue(3)
        }
        IfCondition EqualTo(op, 183) ThenBlock: {
            uaddr = CPU_Addr_ZPY()
            CPU_LAX(uaddr)
            ReturnValue(4)
        }
        IfCondition EqualTo(op, 175) ThenBlock: {
            uaddr = CPU_Addr_Abs()
            CPU_LAX(uaddr)
            ReturnValue(4)
        }
        IfCondition EqualTo(op, 191) ThenBlock: {
            uaddr = CPU_Addr_AbsY()
            CPU_LAX(uaddr)
            ReturnValue(4)
        }
        IfCondition EqualTo(op, 163) ThenBlock: {
            uaddr = CPU_Addr_IndX()
            CPU_LAX(uaddr)
            ReturnValue(6)
        }
        IfCondition EqualTo(op, 179) ThenBlock: {
            uaddr = CPU_Addr_IndY()
            CPU_LAX(uaddr)
            ReturnValue(5)
        }

        // DCP / DCM: DEC then CMP
        IfCondition EqualTo(op, 199) ThenBlock: {
            uaddr = CPU_Addr_ZP()
            CPU_DCP(uaddr)
            ReturnValue(5)
        }
        IfCondition EqualTo(op, 215) ThenBlock: {
            uaddr = CPU_Addr_ZPX()
            CPU_DCP(uaddr)
            ReturnValue(6)
        }
        IfCondition EqualTo(op, 207) ThenBlock: {
            uaddr = CPU_Addr_Abs()
            CPU_DCP(uaddr)
            ReturnValue(6)
        }
        IfCondition EqualTo(op, 223) ThenBlock: {
            uaddr = CPU_Addr_AbsX()
            CPU_DCP(uaddr)
            ReturnValue(7)
        }
        IfCondition EqualTo(op, 219) ThenBlock: {
            uaddr = CPU_Addr_AbsY()
            CPU_DCP(uaddr)
            ReturnValue(7)
        }
        IfCondition EqualTo(op, 195) ThenBlock: {
            uaddr = CPU_Addr_IndX()
            CPU_DCP(uaddr)
            ReturnValue(8)
        }
        IfCondition EqualTo(op, 211) ThenBlock: {
            uaddr = CPU_Addr_IndY()
            CPU_DCP(uaddr)
            ReturnValue(8)
        }

        // ISC / ISB / INS: INC then SBC
        IfCondition EqualTo(op, 231) ThenBlock: {
            uaddr = CPU_Addr_ZP()
            CPU_ISC(uaddr)
            ReturnValue(5)
        }
        IfCondition EqualTo(op, 247) ThenBlock: {
            uaddr = CPU_Addr_ZPX()
            CPU_ISC(uaddr)
            ReturnValue(6)
        }
        IfCondition EqualTo(op, 239) ThenBlock: {
            uaddr = CPU_Addr_Abs()
            CPU_ISC(uaddr)
            ReturnValue(6)
        }
        IfCondition EqualTo(op, 255) ThenBlock: {
            uaddr = CPU_Addr_AbsX()
            CPU_ISC(uaddr)
            ReturnValue(7)
        }
        IfCondition EqualTo(op, 251) ThenBlock: {
            uaddr = CPU_Addr_AbsY()
            CPU_ISC(uaddr)
            ReturnValue(7)
        }
        IfCondition EqualTo(op, 227) ThenBlock: {
            uaddr = CPU_Addr_IndX()
            CPU_ISC(uaddr)
            ReturnValue(8)
        }
        IfCondition EqualTo(op, 243) ThenBlock: {
            uaddr = CPU_Addr_IndY()
            CPU_ISC(uaddr)
            ReturnValue(8)
        }

        // ANC # : AND then C=N
        IfCondition Or(EqualTo(op, 11), EqualTo(op, 43)) ThenBlock: {
            imm = Bus6502_Read(CPU.PC)
            CPU.PC = Add(CPU.PC, 1)
            CPU.A = BitwiseAnd(CPU.A, imm)
            CPU_UpdateNZ(CPU.A)
            CPU.F_CARRY = CPU.F_NEGATIVE
            ReturnValue(2)
        }

        // ALR / ASR # : AND then LSR
        IfCondition EqualTo(op, 75) ThenBlock: {
            imm = Bus6502_Read(CPU.PC)
            CPU.PC = Add(CPU.PC, 1)
            CPU.A = BitwiseAnd(CPU.A, imm)
            CPU.F_CARRY = BitwiseAnd(CPU.A, 1)
            CPU.A = ShiftRight(CPU.A, 1)
            CPU_UpdateNZ(CPU.A)
            ReturnValue(2)
        }

        // ARR # : AND then ROR (C from bit 6, V from bit6 xor bit5)
        IfCondition EqualTo(op, 107) ThenBlock: {
            imm = Bus6502_Read(CPU.PC)
            CPU.PC = Add(CPU.PC, 1)
            CPU.A = BitwiseAnd(CPU.A, imm)
            oldc = CPU.F_CARRY
            CPU.A = BitwiseOr(ShiftRight(CPU.A, 1), ShiftLeft(oldc, 7))
            CPU.A = BitwiseAnd(CPU.A, 0xFF)
            CPU.F_CARRY = BitwiseAnd(ShiftRight(CPU.A, 6), 1)
            b6 = BitwiseAnd(ShiftRight(CPU.A, 6), 1)
            b5 = BitwiseAnd(ShiftRight(CPU.A, 5), 1)
            CPU.F_OVERFLOW = BitwiseAnd(BitwiseXor(b6, b5), 1)
            CPU_UpdateNZ(CPU.A)
            ReturnValue(2)
        }

        // SBX / AXS # : X = (A&X) - imm, flags like CMP
        IfCondition EqualTo(op, 203) ThenBlock: {
            imm = Bus6502_Read(CPU.PC)
            CPU.PC = Add(CPU.PC, 1)
            ax = BitwiseAnd(CPU.A, CPU.X)
            CPU_Compare(ax, imm)
            CPU.X = BitwiseAnd(Subtract(ax, imm), 0xFF)
            ReturnValue(2)
        }

        // SBC # unofficial (EB) same as E9
        IfCondition EqualTo(op, 235) ThenBlock: {
            imm = Bus6502_Read(CPU.PC)
            CPU.PC = Add(CPU.PC, 1)
            CPU_SBC(imm)
            ReturnValue(2)
        }

        // ANE / XAA #  ($8B)  C64: A = (A | $EE) & X & imm
        IfCondition EqualTo(op, 139) ThenBlock: {
            imm = Bus6502_Read(CPU.PC)
            CPU.PC = Add(CPU.PC, 1)
            t = BitwiseOr(CPU.A, CPU.ane_magic)
            t = BitwiseAnd(t, CPU.X)
            t = BitwiseAnd(t, imm)
            CPU.A = t
            CPU_UpdateNZ(CPU.A)
            ReturnValue(2)
        }

        // LXA / LAX #  ($AB)  C64: A = X = (A | $EE) & imm
        IfCondition EqualTo(op, 171) ThenBlock: {
            imm = Bus6502_Read(CPU.PC)
            CPU.PC = Add(CPU.PC, 1)
            t = BitwiseOr(CPU.A, CPU.ane_magic)
            t = BitwiseAnd(t, imm)
            CPU.A = t
            CPU.X = t
            CPU_UpdateNZ(t)
            ReturnValue(2)
        }

        // SHA abs,Y ($9F): store A&X&(hi+1)
        IfCondition EqualTo(op, 159) ThenBlock: {
            lo = Bus6502_Read(CPU.PC)
            CPU.PC = Add(CPU.PC, 1)
            hi = Bus6502_Read(CPU.PC)
            CPU.PC = Add(CPU.PC, 1)
            base = BitwiseOr(lo, ShiftLeft(hi, 8))
            addr = BitwiseAnd(Add(base, CPU.Y), 65535)
            hp = BitwiseAnd(Add(hi, 1), 255)
            v = BitwiseAnd(CPU.A, CPU.X)
            v = BitwiseAnd(v, hp)
            Bus6502_Write(addr, v)
            ReturnValue(5)
        }

        // SHA (zp),Y ($93)
        IfCondition EqualTo(op, 147) ThenBlock: {
            zp = Bus6502_Read(CPU.PC)
            CPU.PC = Add(CPU.PC, 1)
            lo = Bus6502_Read(zp)
            hi = Bus6502_Read(BitwiseAnd(Add(zp, 1), 255))
            base = BitwiseOr(lo, ShiftLeft(hi, 8))
            addr = BitwiseAnd(Add(base, CPU.Y), 65535)
            hp = BitwiseAnd(Add(hi, 1), 255)
            v = BitwiseAnd(CPU.A, CPU.X)
            v = BitwiseAnd(v, hp)
            Bus6502_Write(addr, v)
            ReturnValue(6)
        }

        // SHX abs,Y ($9E): store X&(hi+1)
        IfCondition EqualTo(op, 158) ThenBlock: {
            lo = Bus6502_Read(CPU.PC)
            CPU.PC = Add(CPU.PC, 1)
            hi = Bus6502_Read(CPU.PC)
            CPU.PC = Add(CPU.PC, 1)
            base = BitwiseOr(lo, ShiftLeft(hi, 8))
            addr = BitwiseAnd(Add(base, CPU.Y), 65535)
            hp = BitwiseAnd(Add(hi, 1), 255)
            v = BitwiseAnd(CPU.X, hp)
            Bus6502_Write(addr, v)
            ReturnValue(5)
        }

        // SHY abs,X ($9C): store Y&(hi+1)
        IfCondition EqualTo(op, 156) ThenBlock: {
            lo = Bus6502_Read(CPU.PC)
            CPU.PC = Add(CPU.PC, 1)
            hi = Bus6502_Read(CPU.PC)
            CPU.PC = Add(CPU.PC, 1)
            base = BitwiseOr(lo, ShiftLeft(hi, 8))
            addr = BitwiseAnd(Add(base, CPU.X), 65535)
            hp = BitwiseAnd(Add(hi, 1), 255)
            v = BitwiseAnd(CPU.Y, hp)
            Bus6502_Write(addr, v)
            ReturnValue(5)
        }

        // TAS / SHS abs,Y ($9B): SP=A&X, store SP&(hi+1)
        IfCondition EqualTo(op, 155) ThenBlock: {
            lo = Bus6502_Read(CPU.PC)
            CPU.PC = Add(CPU.PC, 1)
            hi = Bus6502_Read(CPU.PC)
            CPU.PC = Add(CPU.PC, 1)
            base = BitwiseOr(lo, ShiftLeft(hi, 8))
            addr = BitwiseAnd(Add(base, CPU.Y), 65535)
            hp = BitwiseAnd(Add(hi, 1), 255)
            spv = BitwiseAnd(CPU.A, CPU.X)
            CPU.SP = spv
            v = BitwiseAnd(spv, hp)
            Bus6502_Write(addr, v)
            ReturnValue(5)
        }

        // LAS abs,Y ($BB): A=X=SP = mem & SP
        IfCondition EqualTo(op, 187) ThenBlock: {
            lo = Bus6502_Read(CPU.PC)
            CPU.PC = Add(CPU.PC, 1)
            hi = Bus6502_Read(CPU.PC)
            CPU.PC = Add(CPU.PC, 1)
            base = BitwiseOr(lo, ShiftLeft(hi, 8))
            addr = BitwiseAnd(Add(base, CPU.Y), 65535)
            memv = Bus6502_Read(addr)
            v = BitwiseAnd(memv, CPU.SP)
            CPU.A = v
            CPU.X = v
            CPU.SP = v
            CPU_UpdateNZ(v)
            ReturnValue(4)
        }

        // JAM / KIL
        IfCondition Or(EqualTo(op, 2), EqualTo(op, 18)) ThenBlock: { CPU.halted = 1 ReturnValue(2) }
        IfCondition Or(EqualTo(op, 34), EqualTo(op, 50)) ThenBlock: { CPU.halted = 1 ReturnValue(2) }
        IfCondition Or(EqualTo(op, 66), EqualTo(op, 82)) ThenBlock: { CPU.halted = 1 ReturnValue(2) }
        IfCondition Or(EqualTo(op, 98), EqualTo(op, 114)) ThenBlock: { CPU.halted = 1 ReturnValue(2) }
        IfCondition Or(EqualTo(op, 146), EqualTo(op, 178)) ThenBlock: { CPU.halted = 1 ReturnValue(2) }
        IfCondition Or(EqualTo(op, 210), EqualTo(op, 242)) ThenBlock: { CPU.halted = 1 ReturnValue(2) }

        // NOP implied extra
        IfCondition Or(EqualTo(op, 26), EqualTo(op, 58)) ThenBlock: { ReturnValue(2) }
        IfCondition Or(EqualTo(op, 90), EqualTo(op, 122)) ThenBlock: { ReturnValue(2) }
        IfCondition Or(EqualTo(op, 218), EqualTo(op, 250)) ThenBlock: { ReturnValue(2) }

        // NOP zp / DOP
        IfCondition Or(EqualTo(op, 4), EqualTo(op, 68)) ThenBlock: { CPU_NOPSkip(1) ReturnValue(3) }
        IfCondition EqualTo(op, 100) ThenBlock: { CPU_NOPSkip(1) ReturnValue(3) }
        IfCondition Or(EqualTo(op, 20), EqualTo(op, 52)) ThenBlock: { CPU_NOPSkip(1) ReturnValue(4) }
        IfCondition Or(EqualTo(op, 84), EqualTo(op, 116)) ThenBlock: { CPU_NOPSkip(1) ReturnValue(4) }
        IfCondition Or(EqualTo(op, 212), EqualTo(op, 244)) ThenBlock: { CPU_NOPSkip(1) ReturnValue(4) }
        IfCondition Or(EqualTo(op, 128), EqualTo(op, 130)) ThenBlock: { CPU_NOPSkip(1) ReturnValue(2) }
        IfCondition Or(EqualTo(op, 137), EqualTo(op, 194)) ThenBlock: { CPU_NOPSkip(1) ReturnValue(2) }
        IfCondition EqualTo(op, 226) ThenBlock: { CPU_NOPSkip(1) ReturnValue(2) }

        // NOP abs / TOP
        IfCondition EqualTo(op, 12) ThenBlock: { CPU_NOPSkip(2) ReturnValue(4) }
        IfCondition Or(EqualTo(op, 28), EqualTo(op, 60)) ThenBlock: { CPU_NOPSkip(2) ReturnValue(4) }
        IfCondition Or(EqualTo(op, 92), EqualTo(op, 124)) ThenBlock: { CPU_NOPSkip(2) ReturnValue(4) }
        IfCondition Or(EqualTo(op, 220), EqualTo(op, 252)) ThenBlock: { CPU_NOPSkip(2) ReturnValue(4) }

        ReturnValue(0)
    }
}

// =============================================================================
// SINGLE STEP EXECUTION
// =============================================================================

Function.CPU_FinishCycles {
    Input: cycles: Integer
    Body: {
        IfCondition EqualTo(Bus6502.phi2, 0) ThenBlock: {
            ReturnValue(0)
        }
        used = Subtract(Bus6502.phi2_count, CPU.phi0)
        WhileLoop LessThan(used, cycles) {
            Bus6502_Phi2()
            used = Add(used, 1)
        }
    }
}

Function.CPU_ServiceNMI {
    Output: Integer
    Body: {
        IfCondition EqualTo(CPU.nmi_pending, 0) ThenBlock: {
            ReturnValue(0)
        }
        CPU.nmi_pending = 0
        CPU_Push16(CPU.PC)
        p = CPU_GetP()
        p = BitwiseAnd(p, 239)
        CPU_Push(p)
        CPU.F_IRQ = 1
        lo = Bus6502_Read(65530)
        hi = Bus6502_Read(65531)
        CPU.PC = BitwiseOr(lo, ShiftLeft(hi, 8))
        CPU_FinishCycles(7)
        ReturnValue(7)
    }
}

Function.CPU_ServiceIRQ {
    Output: Integer
    Body: {
        IfCondition EqualTo(CPU.irq_pending, 0) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition EqualTo(CPU.F_IRQ, 1) ThenBlock: {
            ReturnValue(0)
        }
        CPU_Push16(CPU.PC)
        p = CPU_GetP()
        p = BitwiseAnd(p, 239)
        CPU_Push(p)
        CPU.F_IRQ = 1
        lo = Bus6502_Read(65534)
        hi = Bus6502_Read(65535)
        CPU.PC = BitwiseOr(lo, ShiftLeft(hi, 8))
        CPU_FinishCycles(7)
        ReturnValue(7)
    }
}

Function.CPU_Step {
    Output: Integer
    Body: {
        IfCondition EqualTo(CPU.halted, 1) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition NotEqual(Bus6502.phi2, 0) ThenBlock: {
            Bus6502.cpu_cycle = 1
        }
        CPU.phi0 = Bus6502.phi2_count
        nmi_c = CPU_ServiceNMI()
        IfCondition NotEqual(nmi_c, 0) ThenBlock: {
            Bus6502.cpu_cycle = 0
            CPU.cycles = Add(CPU.cycles, nmi_c)
            CPU.total_cycles = Add(CPU.total_cycles, nmi_c)
            ReturnValue(nmi_c)
        }
        irq_c = CPU_ServiceIRQ()
        IfCondition NotEqual(irq_c, 0) ThenBlock: {
            Bus6502.cpu_cycle = 0
            CPU.cycles = Add(CPU.cycles, irq_c)
            CPU.total_cycles = Add(CPU.total_cycles, irq_c)
            ReturnValue(irq_c)
        }
        
        opcode = Bus6502_Read(CPU.PC)
        CPU.PC = BitwiseAnd(Add(CPU.PC, 1), 0xFFFF)
        
        cycles = CPU_Execute(opcode)
        CPU_FinishCycles(cycles)
        Bus6502.cpu_cycle = 0
        
        CPU.cycles = Add(CPU.cycles, cycles)
        CPU.total_cycles = Add(CPU.total_cycles, cycles)
        
        ReturnValue(cycles)
    }
}

// Execute N cycles worth of instructions
Function.CPU_Run {
    Input: target_cycles: Integer
    Output: Integer
    Body: {
        CPU.cycles = 0
        
        WhileLoop And(LessThan(CPU.cycles, target_cycles), EqualTo(CPU.halted, 0)) {
            CPU_Step()
        }
        
        ReturnValue(CPU.cycles)
    }
}

// =============================================================================
// OPCODE EXECUTION
// This is the big dispatch table
// =============================================================================

Function.CPU_Execute {
    Input: op: Integer
    Output: Integer
    Body: {
        // Default cycles (will be adjusted per instruction)
        cycles = 2
        
        // === LOAD/STORE ===
        
        // LDA - Load Accumulator
        IfCondition EqualTo(op, 0xA9) ThenBlock: {  // LDA #imm
            ea = CPU_Addr_Imm()
            CPU.A = Bus6502_Read(ea)
            CPU_UpdateNZ(CPU.A)
            ReturnValue(2)
        }
        IfCondition EqualTo(op, 0xA5) ThenBlock: {  // LDA zp
            ea = CPU_Addr_ZP()
            CPU.A = Bus6502_Read(ea)
            CPU_UpdateNZ(CPU.A)
            ReturnValue(3)
        }
        IfCondition EqualTo(op, 0xB5) ThenBlock: {  // LDA zp,X
            ea = CPU_Addr_ZPX()
            CPU.A = Bus6502_Read(ea)
            CPU_UpdateNZ(CPU.A)
            ReturnValue(4)
        }
        IfCondition EqualTo(op, 0xAD) ThenBlock: {  // LDA abs
            ea = CPU_Addr_Abs()
            CPU.A = Bus6502_Read(ea)
            CPU_UpdateNZ(CPU.A)
            ReturnValue(4)
        }
        IfCondition EqualTo(op, 0xBD) ThenBlock: {  // LDA abs,X
            ea = CPU_Addr_AbsX()
            CPU.A = Bus6502_Read(ea)
            CPU_UpdateNZ(CPU.A)
            ReturnValue(4)
        }
        IfCondition EqualTo(op, 0xB9) ThenBlock: {  // LDA abs,Y
            ea = CPU_Addr_AbsY()
            CPU.A = Bus6502_Read(ea)
            CPU_UpdateNZ(CPU.A)
            ReturnValue(4)
        }
        IfCondition EqualTo(op, 0xA1) ThenBlock: {  // LDA (zp,X)
            ea = CPU_Addr_IndX()
            CPU.A = Bus6502_Read(ea)
            CPU_UpdateNZ(CPU.A)
            ReturnValue(6)
        }
        IfCondition EqualTo(op, 0xB1) ThenBlock: {  // LDA (zp),Y
            ea = CPU_Addr_IndY()
            CPU.A = Bus6502_Read(ea)
            CPU_UpdateNZ(CPU.A)
            ReturnValue(5)
        }
        
        // LDX - Load X Register
        IfCondition EqualTo(op, 0xA2) ThenBlock: {  // LDX #imm
            ea = CPU_Addr_Imm()
            CPU.X = Bus6502_Read(ea)
            CPU_UpdateNZ(CPU.X)
            ReturnValue(2)
        }
        IfCondition EqualTo(op, 0xA6) ThenBlock: {  // LDX zp
            ea = CPU_Addr_ZP()
            CPU.X = Bus6502_Read(ea)
            CPU_UpdateNZ(CPU.X)
            ReturnValue(3)
        }
        IfCondition EqualTo(op, 0xB6) ThenBlock: {  // LDX zp,Y
            ea = CPU_Addr_ZPY()
            CPU.X = Bus6502_Read(ea)
            CPU_UpdateNZ(CPU.X)
            ReturnValue(4)
        }
        IfCondition EqualTo(op, 0xAE) ThenBlock: {  // LDX abs
            ea = CPU_Addr_Abs()
            CPU.X = Bus6502_Read(ea)
            CPU_UpdateNZ(CPU.X)
            ReturnValue(4)
        }
        IfCondition EqualTo(op, 0xBE) ThenBlock: {  // LDX abs,Y
            ea = CPU_Addr_AbsY()
            CPU.X = Bus6502_Read(ea)
            CPU_UpdateNZ(CPU.X)
            ReturnValue(4)
        }
        
        // LDY - Load Y Register
        IfCondition EqualTo(op, 0xA0) ThenBlock: {  // LDY #imm
            ea = CPU_Addr_Imm()
            CPU.Y = Bus6502_Read(ea)
            CPU_UpdateNZ(CPU.Y)
            ReturnValue(2)
        }
        IfCondition EqualTo(op, 0xA4) ThenBlock: {  // LDY zp
            ea = CPU_Addr_ZP()
            CPU.Y = Bus6502_Read(ea)
            CPU_UpdateNZ(CPU.Y)
            ReturnValue(3)
        }
        IfCondition EqualTo(op, 0xB4) ThenBlock: {  // LDY zp,X
            ea = CPU_Addr_ZPX()
            CPU.Y = Bus6502_Read(ea)
            CPU_UpdateNZ(CPU.Y)
            ReturnValue(4)
        }
        IfCondition EqualTo(op, 0xAC) ThenBlock: {  // LDY abs
            ea = CPU_Addr_Abs()
            CPU.Y = Bus6502_Read(ea)
            CPU_UpdateNZ(CPU.Y)
            ReturnValue(4)
        }
        IfCondition EqualTo(op, 0xBC) ThenBlock: {  // LDY abs,X
            ea = CPU_Addr_AbsX()
            CPU.Y = Bus6502_Read(ea)
            CPU_UpdateNZ(CPU.Y)
            ReturnValue(4)
        }
        
        // STA - Store Accumulator
        IfCondition EqualTo(op, 0x85) ThenBlock: {  // STA zp
            ea = CPU_Addr_ZP()
            Bus6502_Write(ea, CPU.A)
            ReturnValue(3)
        }
        IfCondition EqualTo(op, 0x95) ThenBlock: {  // STA zp,X
            ea = CPU_Addr_ZPX()
            Bus6502_Write(ea, CPU.A)
            ReturnValue(4)
        }
        IfCondition EqualTo(op, 0x8D) ThenBlock: {  // STA abs
            ea = CPU_Addr_Abs()
            Bus6502_Write(ea, CPU.A)
            ReturnValue(4)
        }
        IfCondition EqualTo(op, 0x9D) ThenBlock: {  // STA abs,X
            ea = CPU_Addr_AbsX()
            Bus6502_Write(ea, CPU.A)
            ReturnValue(5)
        }
        IfCondition EqualTo(op, 0x99) ThenBlock: {  // STA abs,Y
            ea = CPU_Addr_AbsY()
            Bus6502_Write(ea, CPU.A)
            ReturnValue(5)
        }
        IfCondition EqualTo(op, 0x81) ThenBlock: {  // STA (zp,X)
            ea = CPU_Addr_IndX()
            Bus6502_Write(ea, CPU.A)
            ReturnValue(6)
        }
        IfCondition EqualTo(op, 0x91) ThenBlock: {  // STA (zp),Y
            ea = CPU_Addr_IndY()
            Bus6502_Write(ea, CPU.A)
            ReturnValue(6)
        }
        
        // STX - Store X Register
        IfCondition EqualTo(op, 0x86) ThenBlock: {  // STX zp
            ea = CPU_Addr_ZP()
            Bus6502_Write(ea, CPU.X)
            ReturnValue(3)
        }
        IfCondition EqualTo(op, 0x96) ThenBlock: {  // STX zp,Y
            ea = CPU_Addr_ZPY()
            Bus6502_Write(ea, CPU.X)
            ReturnValue(4)
        }
        IfCondition EqualTo(op, 0x8E) ThenBlock: {  // STX abs
            ea = CPU_Addr_Abs()
            Bus6502_Write(ea, CPU.X)
            ReturnValue(4)
        }
        
        // STY - Store Y Register
        IfCondition EqualTo(op, 0x84) ThenBlock: {  // STY zp
            ea = CPU_Addr_ZP()
            Bus6502_Write(ea, CPU.Y)
            ReturnValue(3)
        }
        IfCondition EqualTo(op, 0x94) ThenBlock: {  // STY zp,X
            ea = CPU_Addr_ZPX()
            Bus6502_Write(ea, CPU.Y)
            ReturnValue(4)
        }
        IfCondition EqualTo(op, 0x8C) ThenBlock: {  // STY abs
            ea = CPU_Addr_Abs()
            Bus6502_Write(ea, CPU.Y)
            ReturnValue(4)
        }
        
        // === TRANSFER ===
        IfCondition EqualTo(op, 0xAA) ThenBlock: {  // TAX
            CPU.X = CPU.A
            CPU_UpdateNZ(CPU.X)
            ReturnValue(2)
        }
        IfCondition EqualTo(op, 0xA8) ThenBlock: {  // TAY
            CPU.Y = CPU.A
            CPU_UpdateNZ(CPU.Y)
            ReturnValue(2)
        }
        IfCondition EqualTo(op, 0x8A) ThenBlock: {  // TXA
            CPU.A = CPU.X
            CPU_UpdateNZ(CPU.A)
            ReturnValue(2)
        }
        IfCondition EqualTo(op, 0x98) ThenBlock: {  // TYA
            CPU.A = CPU.Y
            CPU_UpdateNZ(CPU.A)
            ReturnValue(2)
        }
        IfCondition EqualTo(op, 0xBA) ThenBlock: {  // TSX
            CPU.X = CPU.SP
            CPU_UpdateNZ(CPU.X)
            ReturnValue(2)
        }
        IfCondition EqualTo(op, 0x9A) ThenBlock: {  // TXS
            CPU.SP = CPU.X
            ReturnValue(2)
        }
        
        // === STACK ===
        IfCondition EqualTo(op, 0x48) ThenBlock: {  // PHA
            CPU_Push(CPU.A)
            ReturnValue(3)
        }
        IfCondition EqualTo(op, 0x08) ThenBlock: {  // PHP
            CPU_Push(BitwiseOr(CPU_GetP(), 0x10))  // B flag set on push
            ReturnValue(3)
        }
        IfCondition EqualTo(op, 0x68) ThenBlock: {  // PLA
            CPU.A = CPU_Pull()
            CPU_UpdateNZ(CPU.A)
            ReturnValue(4)
        }
        IfCondition EqualTo(op, 0x28) ThenBlock: {  // PLP
            CPU_SetP(CPU_Pull())
            ReturnValue(4)
        }
        
        // === ARITHMETIC ===
        
        // ADC
        IfCondition EqualTo(op, 0x69) ThenBlock: {  // ADC #imm
            ea = CPU_Addr_Imm()
            ev = Bus6502_Read(ea)
            CPU_ADC(ev)
            ReturnValue(2)
        }
        IfCondition EqualTo(op, 0x65) ThenBlock: {  // ADC zp
            ea = CPU_Addr_ZP()
            ev = Bus6502_Read(ea)
            CPU_ADC(ev)
            ReturnValue(3)
        }
        IfCondition EqualTo(op, 0x75) ThenBlock: {  // ADC zp,X
            ea = CPU_Addr_ZPX()
            ev = Bus6502_Read(ea)
            CPU_ADC(ev)
            ReturnValue(4)
        }
        IfCondition EqualTo(op, 0x6D) ThenBlock: {  // ADC abs
            ea = CPU_Addr_Abs()
            ev = Bus6502_Read(ea)
            CPU_ADC(ev)
            ReturnValue(4)
        }
        IfCondition EqualTo(op, 0x7D) ThenBlock: {  // ADC abs,X
            ea = CPU_Addr_AbsX()
            ev = Bus6502_Read(ea)
            CPU_ADC(ev)
            ReturnValue(4)
        }
        IfCondition EqualTo(op, 0x79) ThenBlock: {  // ADC abs,Y
            ea = CPU_Addr_AbsY()
            ev = Bus6502_Read(ea)
            CPU_ADC(ev)
            ReturnValue(4)
        }
        IfCondition EqualTo(op, 0x61) ThenBlock: {  // ADC (zp,X)
            ea = CPU_Addr_IndX()
            ev = Bus6502_Read(ea)
            CPU_ADC(ev)
            ReturnValue(6)
        }
        IfCondition EqualTo(op, 0x71) ThenBlock: {  // ADC (zp),Y
            ea = CPU_Addr_IndY()
            ev = Bus6502_Read(ea)
            CPU_ADC(ev)
            ReturnValue(5)
        }
        
        // SBC
        IfCondition EqualTo(op, 0xE9) ThenBlock: {  // SBC #imm
            ea = CPU_Addr_Imm()
            ev = Bus6502_Read(ea)
            CPU_SBC(ev)
            ReturnValue(2)
        }
        IfCondition EqualTo(op, 0xE5) ThenBlock: {  // SBC zp
            ea = CPU_Addr_ZP()
            ev = Bus6502_Read(ea)
            CPU_SBC(ev)
            ReturnValue(3)
        }
        IfCondition EqualTo(op, 0xF5) ThenBlock: {  // SBC zp,X
            ea = CPU_Addr_ZPX()
            ev = Bus6502_Read(ea)
            CPU_SBC(ev)
            ReturnValue(4)
        }
        IfCondition EqualTo(op, 0xED) ThenBlock: {  // SBC abs
            ea = CPU_Addr_Abs()
            ev = Bus6502_Read(ea)
            CPU_SBC(ev)
            ReturnValue(4)
        }
        IfCondition EqualTo(op, 0xFD) ThenBlock: {  // SBC abs,X
            ea = CPU_Addr_AbsX()
            ev = Bus6502_Read(ea)
            CPU_SBC(ev)
            ReturnValue(4)
        }
        IfCondition EqualTo(op, 0xF9) ThenBlock: {  // SBC abs,Y
            ea = CPU_Addr_AbsY()
            ev = Bus6502_Read(ea)
            CPU_SBC(ev)
            ReturnValue(4)
        }
        IfCondition EqualTo(op, 0xE1) ThenBlock: {  // SBC (zp,X)
            ea = CPU_Addr_IndX()
            ev = Bus6502_Read(ea)
            CPU_SBC(ev)
            ReturnValue(6)
        }
        IfCondition EqualTo(op, 0xF1) ThenBlock: {  // SBC (zp),Y
            ea = CPU_Addr_IndY()
            ev = Bus6502_Read(ea)
            CPU_SBC(ev)
            ReturnValue(5)
        }
        
        // === COMPARE ===
        
        // CMP
        IfCondition EqualTo(op, 0xC9) ThenBlock: {  // CMP #imm
            ea = CPU_Addr_Imm()
            ev = Bus6502_Read(ea)
            CPU_Compare(CPU.A, ev)
            ReturnValue(2)
        }
        IfCondition EqualTo(op, 0xC5) ThenBlock: {  // CMP zp
            ea = CPU_Addr_ZP()
            ev = Bus6502_Read(ea)
            CPU_Compare(CPU.A, ev)
            ReturnValue(3)
        }
        IfCondition EqualTo(op, 0xD5) ThenBlock: {  // CMP zp,X
            ea = CPU_Addr_ZPX()
            ev = Bus6502_Read(ea)
            CPU_Compare(CPU.A, ev)
            ReturnValue(4)
        }
        IfCondition EqualTo(op, 0xCD) ThenBlock: {  // CMP abs
            ea = CPU_Addr_Abs()
            ev = Bus6502_Read(ea)
            CPU_Compare(CPU.A, ev)
            ReturnValue(4)
        }
        IfCondition EqualTo(op, 0xDD) ThenBlock: {  // CMP abs,X
            ea = CPU_Addr_AbsX()
            ev = Bus6502_Read(ea)
            CPU_Compare(CPU.A, ev)
            ReturnValue(4)
        }
        IfCondition EqualTo(op, 0xD9) ThenBlock: {  // CMP abs,Y
            ea = CPU_Addr_AbsY()
            ev = Bus6502_Read(ea)
            CPU_Compare(CPU.A, ev)
            ReturnValue(4)
        }
        IfCondition EqualTo(op, 0xC1) ThenBlock: {  // CMP (zp,X)
            ea = CPU_Addr_IndX()
            ev = Bus6502_Read(ea)
            CPU_Compare(CPU.A, ev)
            ReturnValue(6)
        }
        IfCondition EqualTo(op, 0xD1) ThenBlock: {  // CMP (zp),Y
            ea = CPU_Addr_IndY()
            ev = Bus6502_Read(ea)
            CPU_Compare(CPU.A, ev)
            ReturnValue(5)
        }
        
        // CPX
        IfCondition EqualTo(op, 0xE0) ThenBlock: {  // CPX #imm
            ea = CPU_Addr_Imm()
            ev = Bus6502_Read(ea)
            CPU_Compare(CPU.X, ev)
            ReturnValue(2)
        }
        IfCondition EqualTo(op, 0xE4) ThenBlock: {  // CPX zp
            ea = CPU_Addr_ZP()
            ev = Bus6502_Read(ea)
            CPU_Compare(CPU.X, ev)
            ReturnValue(3)
        }
        IfCondition EqualTo(op, 0xEC) ThenBlock: {  // CPX abs
            ea = CPU_Addr_Abs()
            ev = Bus6502_Read(ea)
            CPU_Compare(CPU.X, ev)
            ReturnValue(4)
        }
        
        // CPY
        IfCondition EqualTo(op, 0xC0) ThenBlock: {  // CPY #imm
            ea = CPU_Addr_Imm()
            ev = Bus6502_Read(ea)
            CPU_Compare(CPU.Y, ev)
            ReturnValue(2)
        }
        IfCondition EqualTo(op, 0xC4) ThenBlock: {  // CPY zp
            ea = CPU_Addr_ZP()
            ev = Bus6502_Read(ea)
            CPU_Compare(CPU.Y, ev)
            ReturnValue(3)
        }
        IfCondition EqualTo(op, 0xCC) ThenBlock: {  // CPY abs
            ea = CPU_Addr_Abs()
            ev = Bus6502_Read(ea)
            CPU_Compare(CPU.Y, ev)
            ReturnValue(4)
        }
        
        // === LOGICAL ===
        
        // AND
        IfCondition EqualTo(op, 0x29) ThenBlock: {  // AND #imm
            ea = CPU_Addr_Imm()
            ev = Bus6502_Read(ea)
            CPU.A = BitwiseAnd(CPU.A, ev)
            CPU_UpdateNZ(CPU.A)
            ReturnValue(2)
        }
        IfCondition EqualTo(op, 0x25) ThenBlock: {  // AND zp
            ea = CPU_Addr_ZP()
            ev = Bus6502_Read(ea)
            CPU.A = BitwiseAnd(CPU.A, ev)
            CPU_UpdateNZ(CPU.A)
            ReturnValue(3)
        }
        IfCondition EqualTo(op, 0x35) ThenBlock: {  // AND zp,X
            ea = CPU_Addr_ZPX()
            ev = Bus6502_Read(ea)
            CPU.A = BitwiseAnd(CPU.A, ev)
            CPU_UpdateNZ(CPU.A)
            ReturnValue(4)
        }
        IfCondition EqualTo(op, 0x2D) ThenBlock: {  // AND abs
            ea = CPU_Addr_Abs()
            ev = Bus6502_Read(ea)
            CPU.A = BitwiseAnd(CPU.A, ev)
            CPU_UpdateNZ(CPU.A)
            ReturnValue(4)
        }
        IfCondition EqualTo(op, 0x3D) ThenBlock: {  // AND abs,X
            ea = CPU_Addr_AbsX()
            ev = Bus6502_Read(ea)
            CPU.A = BitwiseAnd(CPU.A, ev)
            CPU_UpdateNZ(CPU.A)
            ReturnValue(4)
        }
        IfCondition EqualTo(op, 0x39) ThenBlock: {  // AND abs,Y
            ea = CPU_Addr_AbsY()
            ev = Bus6502_Read(ea)
            CPU.A = BitwiseAnd(CPU.A, ev)
            CPU_UpdateNZ(CPU.A)
            ReturnValue(4)
        }
        IfCondition EqualTo(op, 0x21) ThenBlock: {  // AND (zp,X)
            ea = CPU_Addr_IndX()
            ev = Bus6502_Read(ea)
            CPU.A = BitwiseAnd(CPU.A, ev)
            CPU_UpdateNZ(CPU.A)
            ReturnValue(6)
        }
        IfCondition EqualTo(op, 0x31) ThenBlock: {  // AND (zp),Y
            ea = CPU_Addr_IndY()
            ev = Bus6502_Read(ea)
            CPU.A = BitwiseAnd(CPU.A, ev)
            CPU_UpdateNZ(CPU.A)
            ReturnValue(5)
        }
        
        // ORA
        IfCondition EqualTo(op, 0x09) ThenBlock: {  // ORA #imm
            ea = CPU_Addr_Imm()
            ev = Bus6502_Read(ea)
            CPU.A = BitwiseOr(CPU.A, ev)
            CPU_UpdateNZ(CPU.A)
            ReturnValue(2)
        }
        IfCondition EqualTo(op, 0x05) ThenBlock: {  // ORA zp
            ea = CPU_Addr_ZP()
            ev = Bus6502_Read(ea)
            CPU.A = BitwiseOr(CPU.A, ev)
            CPU_UpdateNZ(CPU.A)
            ReturnValue(3)
        }
        IfCondition EqualTo(op, 0x15) ThenBlock: {  // ORA zp,X
            ea = CPU_Addr_ZPX()
            ev = Bus6502_Read(ea)
            CPU.A = BitwiseOr(CPU.A, ev)
            CPU_UpdateNZ(CPU.A)
            ReturnValue(4)
        }
        IfCondition EqualTo(op, 0x0D) ThenBlock: {  // ORA abs
            ea = CPU_Addr_Abs()
            ev = Bus6502_Read(ea)
            CPU.A = BitwiseOr(CPU.A, ev)
            CPU_UpdateNZ(CPU.A)
            ReturnValue(4)
        }
        IfCondition EqualTo(op, 0x1D) ThenBlock: {  // ORA abs,X
            ea = CPU_Addr_AbsX()
            ev = Bus6502_Read(ea)
            CPU.A = BitwiseOr(CPU.A, ev)
            CPU_UpdateNZ(CPU.A)
            ReturnValue(4)
        }
        IfCondition EqualTo(op, 0x19) ThenBlock: {  // ORA abs,Y
            ea = CPU_Addr_AbsY()
            ev = Bus6502_Read(ea)
            CPU.A = BitwiseOr(CPU.A, ev)
            CPU_UpdateNZ(CPU.A)
            ReturnValue(4)
        }
        IfCondition EqualTo(op, 0x01) ThenBlock: {  // ORA (zp,X)
            ea = CPU_Addr_IndX()
            ev = Bus6502_Read(ea)
            CPU.A = BitwiseOr(CPU.A, ev)
            CPU_UpdateNZ(CPU.A)
            ReturnValue(6)
        }
        IfCondition EqualTo(op, 0x11) ThenBlock: {  // ORA (zp),Y
            ea = CPU_Addr_IndY()
            ev = Bus6502_Read(ea)
            CPU.A = BitwiseOr(CPU.A, ev)
            CPU_UpdateNZ(CPU.A)
            ReturnValue(5)
        }
        
        // EOR
        IfCondition EqualTo(op, 0x49) ThenBlock: {  // EOR #imm
            ea = CPU_Addr_Imm()
            ev = Bus6502_Read(ea)
            CPU.A = BitwiseXor(CPU.A, ev)
            CPU_UpdateNZ(CPU.A)
            ReturnValue(2)
        }
        IfCondition EqualTo(op, 0x45) ThenBlock: {  // EOR zp
            ea = CPU_Addr_ZP()
            ev = Bus6502_Read(ea)
            CPU.A = BitwiseXor(CPU.A, ev)
            CPU_UpdateNZ(CPU.A)
            ReturnValue(3)
        }
        IfCondition EqualTo(op, 0x55) ThenBlock: {  // EOR zp,X
            ea = CPU_Addr_ZPX()
            ev = Bus6502_Read(ea)
            CPU.A = BitwiseXor(CPU.A, ev)
            CPU_UpdateNZ(CPU.A)
            ReturnValue(4)
        }
        IfCondition EqualTo(op, 0x4D) ThenBlock: {  // EOR abs
            ea = CPU_Addr_Abs()
            ev = Bus6502_Read(ea)
            CPU.A = BitwiseXor(CPU.A, ev)
            CPU_UpdateNZ(CPU.A)
            ReturnValue(4)
        }
        IfCondition EqualTo(op, 0x5D) ThenBlock: {  // EOR abs,X
            ea = CPU_Addr_AbsX()
            ev = Bus6502_Read(ea)
            CPU.A = BitwiseXor(CPU.A, ev)
            CPU_UpdateNZ(CPU.A)
            ReturnValue(4)
        }
        IfCondition EqualTo(op, 0x59) ThenBlock: {  // EOR abs,Y
            ea = CPU_Addr_AbsY()
            ev = Bus6502_Read(ea)
            CPU.A = BitwiseXor(CPU.A, ev)
            CPU_UpdateNZ(CPU.A)
            ReturnValue(4)
        }
        IfCondition EqualTo(op, 0x41) ThenBlock: {  // EOR (zp,X)
            ea = CPU_Addr_IndX()
            ev = Bus6502_Read(ea)
            CPU.A = BitwiseXor(CPU.A, ev)
            CPU_UpdateNZ(CPU.A)
            ReturnValue(6)
        }
        IfCondition EqualTo(op, 0x51) ThenBlock: {  // EOR (zp),Y
            ea = CPU_Addr_IndY()
            ev = Bus6502_Read(ea)
            CPU.A = BitwiseXor(CPU.A, ev)
            CPU_UpdateNZ(CPU.A)
            ReturnValue(5)
        }
        
        // BIT
        IfCondition EqualTo(op, 0x24) ThenBlock: {  // BIT zp
            ea = CPU_Addr_ZP()
            val = Bus6502_Read(ea)
            CPU.F_ZERO = 0
            IfCondition EqualTo(BitwiseAnd(CPU.A, val), 0) ThenBlock: { CPU.F_ZERO = 1 }
            CPU.F_NEGATIVE = BitwiseAnd(ShiftRight(val, 7), 1)
            CPU.F_OVERFLOW = BitwiseAnd(ShiftRight(val, 6), 1)
            ReturnValue(3)
        }
        IfCondition EqualTo(op, 0x2C) ThenBlock: {  // BIT abs
            ea = CPU_Addr_Abs()
            val = Bus6502_Read(ea)
            CPU.F_ZERO = 0
            IfCondition EqualTo(BitwiseAnd(CPU.A, val), 0) ThenBlock: { CPU.F_ZERO = 1 }
            CPU.F_NEGATIVE = BitwiseAnd(ShiftRight(val, 7), 1)
            CPU.F_OVERFLOW = BitwiseAnd(ShiftRight(val, 6), 1)
            ReturnValue(4)
        }
        
        // === INCREMENT/DECREMENT ===
        
        IfCondition EqualTo(op, 0xE8) ThenBlock: {  // INX
            CPU.X = BitwiseAnd(Add(CPU.X, 1), 0xFF)
            CPU_UpdateNZ(CPU.X)
            ReturnValue(2)
        }
        IfCondition EqualTo(op, 0xC8) ThenBlock: {  // INY
            CPU.Y = BitwiseAnd(Add(CPU.Y, 1), 0xFF)
            CPU_UpdateNZ(CPU.Y)
            ReturnValue(2)
        }
        IfCondition EqualTo(op, 0xCA) ThenBlock: {  // DEX
            CPU.X = BitwiseAnd(Subtract(CPU.X, 1), 0xFF)
            CPU_UpdateNZ(CPU.X)
            ReturnValue(2)
        }
        IfCondition EqualTo(op, 0x88) ThenBlock: {  // DEY
            CPU.Y = BitwiseAnd(Subtract(CPU.Y, 1), 0xFF)
            CPU_UpdateNZ(CPU.Y)
            ReturnValue(2)
        }
        
        // INC memory
        IfCondition EqualTo(op, 0xE6) ThenBlock: {  // INC zp
            addr = CPU_Addr_ZP()
            val = BitwiseAnd(Add(Bus6502_Read(addr), 1), 0xFF)
            Bus6502_Write(addr, val)
            CPU_UpdateNZ(val)
            ReturnValue(5)
        }
        IfCondition EqualTo(op, 0xF6) ThenBlock: {  // INC zp,X
            addr = CPU_Addr_ZPX()
            val = BitwiseAnd(Add(Bus6502_Read(addr), 1), 0xFF)
            Bus6502_Write(addr, val)
            CPU_UpdateNZ(val)
            ReturnValue(6)
        }
        IfCondition EqualTo(op, 0xEE) ThenBlock: {  // INC abs
            addr = CPU_Addr_Abs()
            val = BitwiseAnd(Add(Bus6502_Read(addr), 1), 0xFF)
            Bus6502_Write(addr, val)
            CPU_UpdateNZ(val)
            ReturnValue(6)
        }
        IfCondition EqualTo(op, 0xFE) ThenBlock: {  // INC abs,X
            addr = CPU_Addr_AbsX()
            val = BitwiseAnd(Add(Bus6502_Read(addr), 1), 0xFF)
            Bus6502_Write(addr, val)
            CPU_UpdateNZ(val)
            ReturnValue(7)
        }
        
        // DEC memory
        IfCondition EqualTo(op, 0xC6) ThenBlock: {  // DEC zp
            addr = CPU_Addr_ZP()
            val = BitwiseAnd(Subtract(Bus6502_Read(addr), 1), 0xFF)
            Bus6502_Write(addr, val)
            CPU_UpdateNZ(val)
            ReturnValue(5)
        }
        IfCondition EqualTo(op, 0xD6) ThenBlock: {  // DEC zp,X
            addr = CPU_Addr_ZPX()
            val = BitwiseAnd(Subtract(Bus6502_Read(addr), 1), 0xFF)
            Bus6502_Write(addr, val)
            CPU_UpdateNZ(val)
            ReturnValue(6)
        }
        IfCondition EqualTo(op, 0xCE) ThenBlock: {  // DEC abs
            addr = CPU_Addr_Abs()
            val = BitwiseAnd(Subtract(Bus6502_Read(addr), 1), 0xFF)
            Bus6502_Write(addr, val)
            CPU_UpdateNZ(val)
            ReturnValue(6)
        }
        IfCondition EqualTo(op, 0xDE) ThenBlock: {  // DEC abs,X
            addr = CPU_Addr_AbsX()
            val = BitwiseAnd(Subtract(Bus6502_Read(addr), 1), 0xFF)
            Bus6502_Write(addr, val)
            CPU_UpdateNZ(val)
            ReturnValue(7)
        }
        
        // === SHIFTS ===
        
        // ASL (Arithmetic Shift Left)
        IfCondition EqualTo(op, 0x0A) ThenBlock: {  // ASL A
            CPU.F_CARRY = BitwiseAnd(ShiftRight(CPU.A, 7), 1)
            CPU.A = BitwiseAnd(ShiftLeft(CPU.A, 1), 0xFF)
            CPU_UpdateNZ(CPU.A)
            ReturnValue(2)
        }
        IfCondition EqualTo(op, 0x06) ThenBlock: {  // ASL zp
            addr = CPU_Addr_ZP()
            val = Bus6502_Read(addr)
            CPU.F_CARRY = BitwiseAnd(ShiftRight(val, 7), 1)
            val = BitwiseAnd(ShiftLeft(val, 1), 0xFF)
            Bus6502_Write(addr, val)
            CPU_UpdateNZ(val)
            ReturnValue(5)
        }
        IfCondition EqualTo(op, 0x16) ThenBlock: {  // ASL zp,X
            addr = CPU_Addr_ZPX()
            val = Bus6502_Read(addr)
            CPU.F_CARRY = BitwiseAnd(ShiftRight(val, 7), 1)
            val = BitwiseAnd(ShiftLeft(val, 1), 0xFF)
            Bus6502_Write(addr, val)
            CPU_UpdateNZ(val)
            ReturnValue(6)
        }
        IfCondition EqualTo(op, 0x0E) ThenBlock: {  // ASL abs
            addr = CPU_Addr_Abs()
            val = Bus6502_Read(addr)
            CPU.F_CARRY = BitwiseAnd(ShiftRight(val, 7), 1)
            val = BitwiseAnd(ShiftLeft(val, 1), 0xFF)
            Bus6502_Write(addr, val)
            CPU_UpdateNZ(val)
            ReturnValue(6)
        }
        IfCondition EqualTo(op, 0x1E) ThenBlock: {  // ASL abs,X
            addr = CPU_Addr_AbsX()
            val = Bus6502_Read(addr)
            CPU.F_CARRY = BitwiseAnd(ShiftRight(val, 7), 1)
            val = BitwiseAnd(ShiftLeft(val, 1), 0xFF)
            Bus6502_Write(addr, val)
            CPU_UpdateNZ(val)
            ReturnValue(7)
        }
        
        // LSR (Logical Shift Right)
        IfCondition EqualTo(op, 0x4A) ThenBlock: {  // LSR A
            CPU.F_CARRY = BitwiseAnd(CPU.A, 1)
            CPU.A = ShiftRight(CPU.A, 1)
            CPU_UpdateNZ(CPU.A)
            ReturnValue(2)
        }
        IfCondition EqualTo(op, 0x46) ThenBlock: {  // LSR zp
            addr = CPU_Addr_ZP()
            val = Bus6502_Read(addr)
            CPU.F_CARRY = BitwiseAnd(val, 1)
            val = ShiftRight(val, 1)
            Bus6502_Write(addr, val)
            CPU_UpdateNZ(val)
            ReturnValue(5)
        }
        IfCondition EqualTo(op, 0x56) ThenBlock: {  // LSR zp,X
            addr = CPU_Addr_ZPX()
            val = Bus6502_Read(addr)
            CPU.F_CARRY = BitwiseAnd(val, 1)
            val = ShiftRight(val, 1)
            Bus6502_Write(addr, val)
            CPU_UpdateNZ(val)
            ReturnValue(6)
        }
        IfCondition EqualTo(op, 0x4E) ThenBlock: {  // LSR abs
            addr = CPU_Addr_Abs()
            val = Bus6502_Read(addr)
            CPU.F_CARRY = BitwiseAnd(val, 1)
            val = ShiftRight(val, 1)
            Bus6502_Write(addr, val)
            CPU_UpdateNZ(val)
            ReturnValue(6)
        }
        IfCondition EqualTo(op, 0x5E) ThenBlock: {  // LSR abs,X
            addr = CPU_Addr_AbsX()
            val = Bus6502_Read(addr)
            CPU.F_CARRY = BitwiseAnd(val, 1)
            val = ShiftRight(val, 1)
            Bus6502_Write(addr, val)
            CPU_UpdateNZ(val)
            ReturnValue(7)
        }
        
        // ROL (Rotate Left)
        IfCondition EqualTo(op, 0x2A) ThenBlock: {  // ROL A
            old_carry = CPU.F_CARRY
            CPU.F_CARRY = BitwiseAnd(ShiftRight(CPU.A, 7), 1)
            CPU.A = BitwiseAnd(BitwiseOr(ShiftLeft(CPU.A, 1), old_carry), 0xFF)
            CPU_UpdateNZ(CPU.A)
            ReturnValue(2)
        }
        IfCondition EqualTo(op, 0x26) ThenBlock: {  // ROL zp
            addr = CPU_Addr_ZP()
            val = Bus6502_Read(addr)
            old_carry = CPU.F_CARRY
            CPU.F_CARRY = BitwiseAnd(ShiftRight(val, 7), 1)
            val = BitwiseAnd(BitwiseOr(ShiftLeft(val, 1), old_carry), 0xFF)
            Bus6502_Write(addr, val)
            CPU_UpdateNZ(val)
            ReturnValue(5)
        }
        IfCondition EqualTo(op, 0x36) ThenBlock: {  // ROL zp,X
            addr = CPU_Addr_ZPX()
            val = Bus6502_Read(addr)
            old_carry = CPU.F_CARRY
            CPU.F_CARRY = BitwiseAnd(ShiftRight(val, 7), 1)
            val = BitwiseAnd(BitwiseOr(ShiftLeft(val, 1), old_carry), 0xFF)
            Bus6502_Write(addr, val)
            CPU_UpdateNZ(val)
            ReturnValue(6)
        }
        IfCondition EqualTo(op, 0x2E) ThenBlock: {  // ROL abs
            addr = CPU_Addr_Abs()
            val = Bus6502_Read(addr)
            old_carry = CPU.F_CARRY
            CPU.F_CARRY = BitwiseAnd(ShiftRight(val, 7), 1)
            val = BitwiseAnd(BitwiseOr(ShiftLeft(val, 1), old_carry), 0xFF)
            Bus6502_Write(addr, val)
            CPU_UpdateNZ(val)
            ReturnValue(6)
        }
        IfCondition EqualTo(op, 0x3E) ThenBlock: {  // ROL abs,X
            addr = CPU_Addr_AbsX()
            val = Bus6502_Read(addr)
            old_carry = CPU.F_CARRY
            CPU.F_CARRY = BitwiseAnd(ShiftRight(val, 7), 1)
            val = BitwiseAnd(BitwiseOr(ShiftLeft(val, 1), old_carry), 0xFF)
            Bus6502_Write(addr, val)
            CPU_UpdateNZ(val)
            ReturnValue(7)
        }
        
        // ROR (Rotate Right)
        IfCondition EqualTo(op, 0x6A) ThenBlock: {  // ROR A
            old_carry = CPU.F_CARRY
            CPU.F_CARRY = BitwiseAnd(CPU.A, 1)
            CPU.A = BitwiseOr(ShiftRight(CPU.A, 1), ShiftLeft(old_carry, 7))
            CPU_UpdateNZ(CPU.A)
            ReturnValue(2)
        }
        IfCondition EqualTo(op, 0x66) ThenBlock: {  // ROR zp
            addr = CPU_Addr_ZP()
            val = Bus6502_Read(addr)
            old_carry = CPU.F_CARRY
            CPU.F_CARRY = BitwiseAnd(val, 1)
            val = BitwiseOr(ShiftRight(val, 1), ShiftLeft(old_carry, 7))
            Bus6502_Write(addr, val)
            CPU_UpdateNZ(val)
            ReturnValue(5)
        }
        IfCondition EqualTo(op, 0x76) ThenBlock: {  // ROR zp,X
            addr = CPU_Addr_ZPX()
            val = Bus6502_Read(addr)
            old_carry = CPU.F_CARRY
            CPU.F_CARRY = BitwiseAnd(val, 1)
            val = BitwiseOr(ShiftRight(val, 1), ShiftLeft(old_carry, 7))
            Bus6502_Write(addr, val)
            CPU_UpdateNZ(val)
            ReturnValue(6)
        }
        IfCondition EqualTo(op, 0x6E) ThenBlock: {  // ROR abs
            addr = CPU_Addr_Abs()
            val = Bus6502_Read(addr)
            old_carry = CPU.F_CARRY
            CPU.F_CARRY = BitwiseAnd(val, 1)
            val = BitwiseOr(ShiftRight(val, 1), ShiftLeft(old_carry, 7))
            Bus6502_Write(addr, val)
            CPU_UpdateNZ(val)
            ReturnValue(6)
        }
        IfCondition EqualTo(op, 0x7E) ThenBlock: {  // ROR abs,X
            addr = CPU_Addr_AbsX()
            val = Bus6502_Read(addr)
            old_carry = CPU.F_CARRY
            CPU.F_CARRY = BitwiseAnd(val, 1)
            val = BitwiseOr(ShiftRight(val, 1), ShiftLeft(old_carry, 7))
            Bus6502_Write(addr, val)
            CPU_UpdateNZ(val)
            ReturnValue(7)
        }
        
        // === BRANCHES ===
        
        IfCondition EqualTo(op, 0x10) ThenBlock: {  // BPL
            addr = CPU_Addr_Rel()
            IfCondition EqualTo(CPU.F_NEGATIVE, 0) ThenBlock: { CPU.PC = addr }
            ReturnValue(2)
        }
        IfCondition EqualTo(op, 0x30) ThenBlock: {  // BMI
            addr = CPU_Addr_Rel()
            IfCondition EqualTo(CPU.F_NEGATIVE, 1) ThenBlock: { CPU.PC = addr }
            ReturnValue(2)
        }
        IfCondition EqualTo(op, 0x50) ThenBlock: {  // BVC
            addr = CPU_Addr_Rel()
            IfCondition EqualTo(CPU.F_OVERFLOW, 0) ThenBlock: { CPU.PC = addr }
            ReturnValue(2)
        }
        IfCondition EqualTo(op, 0x70) ThenBlock: {  // BVS
            addr = CPU_Addr_Rel()
            IfCondition EqualTo(CPU.F_OVERFLOW, 1) ThenBlock: { CPU.PC = addr }
            ReturnValue(2)
        }
        IfCondition EqualTo(op, 0x90) ThenBlock: {  // BCC
            addr = CPU_Addr_Rel()
            IfCondition EqualTo(CPU.F_CARRY, 0) ThenBlock: { CPU.PC = addr }
            ReturnValue(2)
        }
        IfCondition EqualTo(op, 0xB0) ThenBlock: {  // BCS
            addr = CPU_Addr_Rel()
            IfCondition EqualTo(CPU.F_CARRY, 1) ThenBlock: { CPU.PC = addr }
            ReturnValue(2)
        }
        IfCondition EqualTo(op, 0xD0) ThenBlock: {  // BNE
            addr = CPU_Addr_Rel()
            IfCondition EqualTo(CPU.F_ZERO, 0) ThenBlock: { CPU.PC = addr }
            ReturnValue(2)
        }
        IfCondition EqualTo(op, 0xF0) ThenBlock: {  // BEQ
            addr = CPU_Addr_Rel()
            IfCondition EqualTo(CPU.F_ZERO, 1) ThenBlock: { CPU.PC = addr }
            ReturnValue(2)
        }
        
        // === JUMPS/CALLS ===
        
        IfCondition EqualTo(op, 0x4C) ThenBlock: {  // JMP abs
            CPU.PC = CPU_Addr_Abs()
            ReturnValue(3)
        }
        IfCondition EqualTo(op, 0x6C) ThenBlock: {  // JMP (ind)
            CPU.PC = CPU_Addr_Ind()
            ReturnValue(5)
        }
        IfCondition EqualTo(op, 0x20) ThenBlock: {  // JSR
            addr = CPU_Addr_Abs()
            CPU_Push16(Subtract(CPU.PC, 1))
            CPU.PC = addr
            ReturnValue(6)
        }
        IfCondition EqualTo(op, 0x60) ThenBlock: {  // RTS
            CPU.PC = BitwiseAnd(Add(CPU_Pull16(), 1), 0xFFFF)
            ReturnValue(6)
        }
        IfCondition EqualTo(op, 0x40) ThenBlock: {  // RTI
            CPU_SetP(CPU_Pull())
            CPU.PC = CPU_Pull16()
            ReturnValue(6)
        }
        
        // === FLAGS ===
        
        IfCondition EqualTo(op, 0x18) ThenBlock: {  // CLC
            CPU.F_CARRY = 0
            ReturnValue(2)
        }
        IfCondition EqualTo(op, 0x38) ThenBlock: {  // SEC
            CPU.F_CARRY = 1
            ReturnValue(2)
        }
        IfCondition EqualTo(op, 0x58) ThenBlock: {  // CLI
            CPU.F_IRQ = 0
            ReturnValue(2)
        }
        IfCondition EqualTo(op, 0x78) ThenBlock: {  // SEI
            CPU.F_IRQ = 1
            ReturnValue(2)
        }
        IfCondition EqualTo(op, 0xB8) ThenBlock: {  // CLV
            CPU.F_OVERFLOW = 0
            ReturnValue(2)
        }
        IfCondition EqualTo(op, 0xD8) ThenBlock: {  // CLD
            CPU.F_DECIMAL = 0
            ReturnValue(2)
        }
        IfCondition EqualTo(op, 0xF8) ThenBlock: {  // SED
            CPU.F_DECIMAL = 1
            ReturnValue(2)
        }
        
        // === MISC ===
        
        IfCondition EqualTo(op, 0xEA) ThenBlock: {  // NOP
            ReturnValue(2)
        }
        
        IfCondition EqualTo(op, 0x00) ThenBlock: {  // BRK
            CPU.PC = Add(CPU.PC, 1)  // Skip padding byte
            CPU_Push16(CPU.PC)
            CPU_Push(BitwiseOr(CPU_GetP(), 0x10))
            CPU.F_IRQ = 1
            brk_lo = Bus6502_Read(65534)
            brk_hi = Bus6502_Read(65535)
            CPU.PC = BitwiseOr(brk_lo, ShiftLeft(brk_hi, 8))
            ReturnValue(7)
        }
        
        undoc_c = CPU_ExecuteUndoc(op)
        IfCondition NotEqual(undoc_c, 0) ThenBlock: {
            ReturnValue(undoc_c)
        }

        // === UNKNOWN OPCODE ===
        PrintMessage("Unknown opcode: $")
        PrintHex(op)
        PrintMessage(" at $")
        PrintHex(Subtract(CPU.PC, 1))
        PrintMessage("\n")
        CPU.halted = 1
        ReturnValue(2)
    }
}

// =============================================================================
// DEBUG / UTILITIES
// =============================================================================

Function.CPU_DumpState {
    Body: {
        PrintMessage("CPU State:\n")
        PrintMessage("  A=$")
        PrintHex(CPU.A)
        PrintMessage(" X=$")
        PrintHex(CPU.X)
        PrintMessage(" Y=$")
        PrintHex(CPU.Y)
        PrintMessage(" SP=$")
        PrintHex(CPU.SP)
        PrintMessage(" PC=$")
        PrintHex(CPU.PC)
        PrintMessage("\n  Flags: ")
        IfCondition EqualTo(CPU.F_NEGATIVE, 1) ThenBlock: { PrintMessage("N") } ElseBlock: { PrintMessage("-") }
        IfCondition EqualTo(CPU.F_OVERFLOW, 1) ThenBlock: { PrintMessage("V") } ElseBlock: { PrintMessage("-") }
        PrintMessage("-")
        IfCondition EqualTo(CPU.F_BREAK, 1) ThenBlock: { PrintMessage("B") } ElseBlock: { PrintMessage("-") }
        IfCondition EqualTo(CPU.F_DECIMAL, 1) ThenBlock: { PrintMessage("D") } ElseBlock: { PrintMessage("-") }
        IfCondition EqualTo(CPU.F_IRQ, 1) ThenBlock: { PrintMessage("I") } ElseBlock: { PrintMessage("-") }
        IfCondition EqualTo(CPU.F_ZERO, 1) ThenBlock: { PrintMessage("Z") } ElseBlock: { PrintMessage("-") }
        IfCondition EqualTo(CPU.F_CARRY, 1) ThenBlock: { PrintMessage("C") } ElseBlock: { PrintMessage("-") }
        PrintMessage("\n  Cycles: ")
        PrintNumber(CPU.total_cycles)
        PrintMessage("\n")
    }
}

// Disassemble single instruction at address (returns bytes consumed)
Function.CPU_Disasm {
    Input: addr: Integer
    Output: Integer
    Body: {
        op = Bus6502_Read(addr)
        
        PrintHex(addr)
        PrintMessage(": ")
        PrintHex(op)
        PrintMessage(" ")
        
        // This is a simplified disassembler - just shows hex for now
        // A full one would decode mnemonics and operands
        
        // Determine instruction length based on opcode
        // Most instructions are 1-3 bytes
        len = 1
        
        // Immediate, ZP, ZP,X, ZP,Y, (ZP,X), (ZP),Y = 2 bytes
        // Absolute, Absolute,X, Absolute,Y, Indirect = 3 bytes
        
        // Quick length determination (simplified)
        mode = BitwiseAnd(op, 0x1F)
        IfCondition Or(EqualTo(mode, 0x09), EqualTo(mode, 0x05)) ThenBlock: { len = 2 }
        IfCondition Or(EqualTo(mode, 0x0D), EqualTo(mode, 0x19)) ThenBlock: { len = 3 }
        IfCondition Or(EqualTo(mode, 0x01), EqualTo(mode, 0x11)) ThenBlock: { len = 2 }
        IfCondition Or(EqualTo(mode, 0x15), EqualTo(mode, 0x1D)) ThenBlock: { len = 2 }
        
        // Branches are 2 bytes
        IfCondition EqualTo(BitwiseAnd(op, 0x1F), 0x10) ThenBlock: { len = 2 }
        
        // JSR, JMP abs = 3 bytes
        IfCondition Or(EqualTo(op, 0x20), EqualTo(op, 0x4C)) ThenBlock: { len = 3 }
        IfCondition EqualTo(op, 0x6C) ThenBlock: { len = 3 }
        
        // Print remaining bytes
        IfCondition GreaterEqual(len, 2) ThenBlock: {
            PrintHex(Bus6502_Read(Add(addr, 1)))
            PrintMessage(" ")
        }
        IfCondition GreaterEqual(len, 3) ThenBlock: {
            PrintHex(Bus6502_Read(Add(addr, 2)))
            PrintMessage(" ")
        }
        
        PrintMessage("\n")
        ReturnValue(len)
    }
}

// Single step with trace output
Function.CPU_StepTrace {
    Output: Integer
    Body: {
        // Print current instruction
        CPU_Disasm(CPU.PC)
        
        // Execute
        cycles = CPU_Step()
        
        // Print resulting state
        CPU_DumpState()
        
        ReturnValue(cycles)
    }
}