// Library.MOS6526.ailang
// MOS 6526 CIA — Ailang chip model.
// Register map and pin names follow floooh/chips m6526.h (zlib).
// TOD/serial/CNT not in this pass. Each instance is a board Chip@state blob.

Import.Librarys.Emulators.6502.Board

Function.MOS6526_Ensure {
    Input: chip: Address
    Output: Integer
    Body: {
        st_off = PoolFieldOffset(LinkagePool.Chip, "state")
        st = Dereference(Add(chip, st_off))
        IfCondition NotEqual(st, 0) ThenBlock: {
            ReturnValue(st)
        }
        st = Allocate(32)
        zi = 0
        WhileLoop LessThan(zi, 32) {
            SetByte(st, zi, 0)
            zi = Add(zi, 1)
        }
        SetByte(st, 0, 255)
        SetByte(st, 1, 255)
        StoreValue(Add(chip, st_off), st)
        ReturnValue(st)
    }
}

Function.MOS6526_Read {
    Input: chip: Address
    Input: addr: Integer
    Output: Integer
    Body: {
        st = MOS6526_Ensure(chip)
        rs = BitwiseAnd(addr, 15)
        v = GetByte(st, rs)
        ReturnValue(v)
    }
}

Function.MOS6526_Write {
    Input: chip: Address
    Input: addr: Integer
    Input: value: Integer
    Body: {
        st = MOS6526_Ensure(chip)
        rs = BitwiseAnd(addr, 15)
        b = BitwiseAnd(value, 255)
        SetByte(st, rs, b)
        IfCondition EqualTo(rs, 4) ThenBlock: {
            SetByte(st, 16, b)
        }
        IfCondition EqualTo(rs, 5) ThenBlock: {
            SetByte(st, 17, b)
        }
        IfCondition EqualTo(rs, 6) ThenBlock: {
            SetByte(st, 18, b)
        }
        IfCondition EqualTo(rs, 7) ThenBlock: {
            SetByte(st, 19, b)
        }
    }
}

Function.MOS6526_Tick {
    Input: chip: Address
    Input: cycles: Integer
    Body: {
        st = MOS6526_Ensure(chip)
        cra = GetByte(st, 14)
        IfCondition EqualTo(BitwiseAnd(cra, 1), 1) ThenBlock: {
            lo = GetByte(st, 16)
            hi = GetByte(st, 17)
            t = Add(lo, ShiftLeft(hi, 8))
            IfCondition GreaterThan(t, cycles) ThenBlock: {
                t = Subtract(t, cycles)
            } ElseBlock: {
                t = 0
                icr = GetByte(st, 13)
                icr = BitwiseOr(icr, 1)
                SetByte(st, 13, icr)
            }
            SetByte(st, 16, BitwiseAnd(t, 255))
            SetByte(st, 17, BitwiseAnd(ShiftRight(t, 8), 255))
        }
    }
}
