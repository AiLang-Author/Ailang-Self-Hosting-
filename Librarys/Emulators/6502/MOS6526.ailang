// MOS 6526 CIA — timers, ICR/IMR, IRQ pin.
// Register map follows floooh/chips m6526.h (zlib). TOD/serial/CNT later.

Import.Librarys.Emulators.6502.Board

Function.MOS6526_Ensure {
    Input: chip: Address
    Output: Integer
    Body: {
        st_off = PoolFieldOffset(LinkagePool.Chip, "state")
        st = Dereference(Add(chip, st_off))
        IfCondition NotEqual(st, 0) ThenBlock: {
            ReturnValue(st)
        }
        st = Allocate(32)
        zi = 0
        WhileLoop LessThan(zi, 32) {
            SetByte(st, zi, 0)
            zi = Add(zi, 1)
        }
        SetByte(st, 0, 255)
        SetByte(st, 1, 255)
        StoreValue(Add(chip, st_off), st)
        ReturnValue(st)
    }
}

Function.MOS6526_SetIRQ {
    Input: st: Address
    Body: {
        icr = GetByte(st, 25)
        imr = GetByte(st, 24)
        hit = BitwiseAnd(icr, imr)
        IfCondition NotEqual(hit, 0) ThenBlock: {
            SetByte(st, 26, 1)
        }
    }
}

Function.MOS6526_UnderflowB {
    Input: st: Address
    Body: {
        icr = GetByte(st, 25)
        icr = BitwiseOr(icr, 2)
        SetByte(st, 25, icr)
        crb = GetByte(st, 15)
        IfCondition NotEqual(BitwiseAnd(crb, 8), 0) ThenBlock: {
            crb = BitwiseAnd(crb, 254)
            SetByte(st, 15, crb)
        }
        lo = GetByte(st, 22)
        hi = GetByte(st, 23)
        SetByte(st, 18, lo)
        SetByte(st, 19, hi)
        MOS6526_SetIRQ(st)
    }
}

Function.MOS6526_PulseB {
    Input: st: Address
    Body: {
        crb = GetByte(st, 15)
        IfCondition EqualTo(BitwiseAnd(crb, 1), 0) ThenBlock: {
            ReturnValue(0)
        }
        dly = GetByte(st, 28)
        IfCondition GreaterThan(dly, 0) ThenBlock: {
            SetByte(st, 28, Subtract(dly, 1))
            ReturnValue(0)
        }
        lo = GetByte(st, 18)
        hi = GetByte(st, 19)
        t = Add(lo, ShiftLeft(hi, 8))
        IfCondition EqualTo(t, 0) ThenBlock: {
            MOS6526_UnderflowB(st)
            ReturnValue(0)
        }
        t = Subtract(t, 1)
        IfCondition EqualTo(t, 0) ThenBlock: {
            MOS6526_UnderflowB(st)
        } ElseBlock: {
            SetByte(st, 18, BitwiseAnd(t, 255))
            sr = ShiftRight(t, 8)
            SetByte(st, 19, BitwiseAnd(sr, 255))
        }
    }
}

Function.MOS6526_UnderflowA {
    Input: st: Address
    Body: {
        icr = GetByte(st, 25)
        icr = BitwiseOr(icr, 1)
        SetByte(st, 25, icr)
        cra = GetByte(st, 14)
        IfCondition NotEqual(BitwiseAnd(cra, 8), 0) ThenBlock: {
            cra = BitwiseAnd(cra, 254)
            SetByte(st, 14, cra)
        }
        lo = GetByte(st, 20)
        hi = GetByte(st, 21)
        SetByte(st, 16, lo)
        SetByte(st, 17, hi)
        MOS6526_SetIRQ(st)
        crb = GetByte(st, 15)
        inmode = BitwiseAnd(crb, 96)
        IfCondition EqualTo(inmode, 64) ThenBlock: {
            MOS6526_PulseB(st)
        }
        IfCondition EqualTo(inmode, 96) ThenBlock: {
            MOS6526_PulseB(st)
        }
    }
}

Function.MOS6526_TickA {
    Input: st: Address
    Input: cycles: Integer
    Body: {
        cra = GetByte(st, 14)
        IfCondition EqualTo(BitwiseAnd(cra, 1), 0) ThenBlock: {
            ReturnValue(0)
        }
        dly = GetByte(st, 27)
        IfCondition GreaterThan(dly, 0) ThenBlock: {
            IfCondition GreaterEqual(cycles, dly) ThenBlock: {
                cycles = Subtract(cycles, dly)
                SetByte(st, 27, 0)
            } ElseBlock: {
                SetByte(st, 27, Subtract(dly, cycles))
                ReturnValue(0)
            }
        }
        left = cycles
        WhileLoop GreaterThan(left, 0) {
            cra = GetByte(st, 14)
            IfCondition EqualTo(BitwiseAnd(cra, 1), 0) ThenBlock: {
                ReturnValue(0)
            }
            lo = GetByte(st, 16)
            hi = GetByte(st, 17)
            t = Add(lo, ShiftLeft(hi, 8))
            IfCondition EqualTo(t, 0) ThenBlock: {
                MOS6526_UnderflowA(st)
                left = Subtract(left, 1)
            } ElseBlock: {
                IfCondition GreaterThan(t, left) ThenBlock: {
                    t = Subtract(t, left)
                    SetByte(st, 16, BitwiseAnd(t, 255))
                    sr = ShiftRight(t, 8)
                    SetByte(st, 17, BitwiseAnd(sr, 255))
                    left = 0
                } ElseBlock: {
                    left = Subtract(left, t)
                    MOS6526_UnderflowA(st)
                }
            }
        }
    }
}

Function.MOS6526_TickB {
    Input: st: Address
    Input: cycles: Integer
    Body: {
        crb = GetByte(st, 15)
        IfCondition EqualTo(BitwiseAnd(crb, 1), 0) ThenBlock: {
            ReturnValue(0)
        }
        inmode = BitwiseAnd(crb, 96)
        IfCondition NotEqual(inmode, 0) ThenBlock: {
            ReturnValue(0)
        }
        dly = GetByte(st, 28)
        IfCondition GreaterThan(dly, 0) ThenBlock: {
            IfCondition GreaterEqual(cycles, dly) ThenBlock: {
                cycles = Subtract(cycles, dly)
                SetByte(st, 28, 0)
            } ElseBlock: {
                SetByte(st, 28, Subtract(dly, cycles))
                ReturnValue(0)
            }
        }
        left = cycles
        WhileLoop GreaterThan(left, 0) {
            crb = GetByte(st, 15)
            IfCondition EqualTo(BitwiseAnd(crb, 1), 0) ThenBlock: {
                ReturnValue(0)
            }
            lo = GetByte(st, 18)
            hi = GetByte(st, 19)
            t = Add(lo, ShiftLeft(hi, 8))
            IfCondition EqualTo(t, 0) ThenBlock: {
                MOS6526_UnderflowB(st)
                left = Subtract(left, 1)
            } ElseBlock: {
                IfCondition GreaterThan(t, left) ThenBlock: {
                    t = Subtract(t, left)
                    SetByte(st, 18, BitwiseAnd(t, 255))
                    sr = ShiftRight(t, 8)
                    SetByte(st, 19, BitwiseAnd(sr, 255))
                    left = 0
                } ElseBlock: {
                    left = Subtract(left, t)
                    MOS6526_UnderflowB(st)
                }
            }
        }
    }
}

Function.MOS6526_LoadA {
    Input: st: Address
    Body: {
        lo = GetByte(st, 20)
        hi = GetByte(st, 21)
        SetByte(st, 16, lo)
        SetByte(st, 17, hi)
    }
}

Function.MOS6526_LoadB {
    Input: st: Address
    Body: {
        lo = GetByte(st, 22)
        hi = GetByte(st, 23)
        SetByte(st, 18, lo)
        SetByte(st, 19, hi)
    }
}

Function.MOS6526_Read {
    Input: chip: Address
    Input: addr: Integer
    Output: Integer
    Body: {
        st = MOS6526_Ensure(chip)
        rs = BitwiseAnd(addr, 15)
        IfCondition EqualTo(rs, 4) ThenBlock: {
            ReturnValue(GetByte(st, 16))
        }
        IfCondition EqualTo(rs, 5) ThenBlock: {
            ReturnValue(GetByte(st, 17))
        }
        IfCondition EqualTo(rs, 6) ThenBlock: {
            ReturnValue(GetByte(st, 18))
        }
        IfCondition EqualTo(rs, 7) ThenBlock: {
            ReturnValue(GetByte(st, 19))
        }
        IfCondition EqualTo(rs, 13) ThenBlock: {
            icr = GetByte(st, 25)
            irq = GetByte(st, 26)
            v = icr
            IfCondition EqualTo(irq, 1) ThenBlock: {
                v = BitwiseOr(v, 128)
            }
            SetByte(st, 25, 0)
            SetByte(st, 26, 0)
            ReturnValue(v)
        }
        v = GetByte(st, rs)
        ReturnValue(v)
    }
}

Function.MOS6526_Write {
    Input: chip: Address
    Input: addr: Integer
    Input: value: Integer
    Body: {
        st = MOS6526_Ensure(chip)
        rs = BitwiseAnd(addr, 15)
        b = BitwiseAnd(value, 255)
        IfCondition EqualTo(rs, 4) ThenBlock: {
            SetByte(st, 20, b)
            ReturnValue(0)
        }
        IfCondition EqualTo(rs, 5) ThenBlock: {
            SetByte(st, 21, b)
            cra = GetByte(st, 14)
            IfCondition EqualTo(BitwiseAnd(cra, 1), 0) ThenBlock: {
                MOS6526_LoadA(st)
            }
            ReturnValue(0)
        }
        IfCondition EqualTo(rs, 6) ThenBlock: {
            SetByte(st, 22, b)
            ReturnValue(0)
        }
        IfCondition EqualTo(rs, 7) ThenBlock: {
            SetByte(st, 23, b)
            crb = GetByte(st, 15)
            IfCondition EqualTo(BitwiseAnd(crb, 1), 0) ThenBlock: {
                MOS6526_LoadB(st)
            }
            ReturnValue(0)
        }
        IfCondition EqualTo(rs, 13) ThenBlock: {
            imr = GetByte(st, 24)
            bits = BitwiseAnd(b, 31)
            IfCondition NotEqual(BitwiseAnd(b, 128), 0) ThenBlock: {
                imr = BitwiseOr(imr, bits)
            } ElseBlock: {
                imr = BitwiseAnd(imr, BitwiseXor(bits, 255))
            }
            SetByte(st, 24, imr)
            MOS6526_SetIRQ(st)
            ReturnValue(0)
        }
        IfCondition EqualTo(rs, 14) ThenBlock: {
            IfCondition NotEqual(BitwiseAnd(b, 16), 0) ThenBlock: {
                MOS6526_LoadA(st)
                b = BitwiseAnd(b, 239)
            }
            old = GetByte(st, 14)
            SetByte(st, 14, b)
            IfCondition And(EqualTo(BitwiseAnd(old, 1), 0), NotEqual(BitwiseAnd(b, 1), 0)) ThenBlock: {
                SetByte(st, 27, 2)
            }
            ReturnValue(0)
        }
        IfCondition EqualTo(rs, 15) ThenBlock: {
            IfCondition NotEqual(BitwiseAnd(b, 16), 0) ThenBlock: {
                MOS6526_LoadB(st)
                b = BitwiseAnd(b, 239)
            }
            old = GetByte(st, 15)
            SetByte(st, 15, b)
            IfCondition And(EqualTo(BitwiseAnd(old, 1), 0), NotEqual(BitwiseAnd(b, 1), 0)) ThenBlock: {
                SetByte(st, 28, 2)
            }
            ReturnValue(0)
        }
        SetByte(st, rs, b)
    }
}

Function.MOS6526_Tick {
    Input: chip: Address
    Input: cycles: Integer
    Body: {
        st = MOS6526_Ensure(chip)
        MOS6526_TickA(st, cycles)
        MOS6526_TickB(st, cycles)
    }
}

Function.MOS6526_IRQLevel {
    Input: chip: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(chip, 0) ThenBlock: {
            ReturnValue(0)
        }
        st_off = PoolFieldOffset(LinkagePool.Chip, "state")
        st = Dereference(Add(chip, st_off))
        IfCondition EqualTo(st, 0) ThenBlock: {
            ReturnValue(0)
        }
        v = GetByte(st, 26)
        ReturnValue(v)
    }
}
