// Library.MOS6569.ailang
// MOS 6569 VIC-II — Ailang chip model (register file this pass).
// Pin names follow floooh/chips m6569.h (zlib). Raster/badline later.

Import.Librarys.Emulators.6502.Board

Function.MOS6569_Ensure {
    Input: chip: Address
    Output: Integer
    Body: {
        st_off = PoolFieldOffset(LinkagePool.Chip, "state")
        st = Dereference(Add(chip, st_off))
        IfCondition NotEqual(st, 0) ThenBlock: {
            ReturnValue(st)
        }
        st = Allocate(64)
        zi = 0
        WhileLoop LessThan(zi, 64) {
            SetByte(st, zi, 0)
            zi = Add(zi, 1)
        }
        SetByte(st, 32, 14)
        SetByte(st, 33, 6)
        StoreValue(Add(chip, st_off), st)
        ReturnValue(st)
    }
}

Function.MOS6569_Read {
    Input: chip: Address
    Input: addr: Integer
    Output: Integer
    Body: {
        st = MOS6569_Ensure(chip)
        rs = BitwiseAnd(addr, 63)
        v = GetByte(st, rs)
        ReturnValue(v)
    }
}

Function.MOS6569_Write {
    Input: chip: Address
    Input: addr: Integer
    Input: value: Integer
    Body: {
        st = MOS6569_Ensure(chip)
        rs = BitwiseAnd(addr, 63)
        b = BitwiseAnd(value, 255)
        SetByte(st, rs, b)
    }
}
