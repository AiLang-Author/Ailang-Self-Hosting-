// MOS 6569/6567 VIC-II — raster counter now; frame blit uses FB_C64Color later.
// NTSC: 263 lines, 65 cycles/line. $D011 bit7 / $D012 are the raster.

Import.Librarys.Emulators.6502.Board

Function.MOS6569_Ensure {
    Input: chip: Address
    Output: Integer
    Body: {
        st_off = PoolFieldOffset(LinkagePool.Chip, "state")
        st = Dereference(Add(chip, st_off))
        IfCondition NotEqual(st, 0) ThenBlock: {
            ReturnValue(st)
        }
        st = Allocate(72)
        zi = 0
        WhileLoop LessThan(zi, 72) {
            SetByte(st, zi, 0)
            zi = Add(zi, 1)
        }
        SetByte(st, 17, 27)
        SetByte(st, 32, 14)
        SetByte(st, 33, 6)
        StoreValue(Add(chip, st_off), st)
        ReturnValue(st)
    }
}

Function.MOS6569_Read {
    Input: chip: Address
    Input: addr: Integer
    Output: Integer
    Body: {
        st = MOS6569_Ensure(chip)
        rs = BitwiseAnd(addr, 63)
        rast_lo = GetByte(st, 64)
        rast_hi = GetByte(st, 65)
        raster = Add(rast_lo, ShiftLeft(rast_hi, 8))
        IfCondition EqualTo(rs, 18) ThenBlock: {
            ReturnValue(BitwiseAnd(raster, 255))
        }
        IfCondition EqualTo(rs, 17) ThenBlock: {
            v = BitwiseAnd(GetByte(st, 17), 127)
            IfCondition GreaterEqual(raster, 256) ThenBlock: {
                v = BitwiseOr(v, 128)
            }
            ReturnValue(v)
        }
        IfCondition EqualTo(rs, 25) ThenBlock: {
            ReturnValue(GetByte(st, 25))
        }
        v = GetByte(st, rs)
        ReturnValue(v)
    }
}

Function.MOS6569_Write {
    Input: chip: Address
    Input: addr: Integer
    Input: value: Integer
    Body: {
        st = MOS6569_Ensure(chip)
        rs = BitwiseAnd(addr, 63)
        b = BitwiseAnd(value, 255)
        IfCondition EqualTo(rs, 18) ThenBlock: {
            SetByte(st, 68, b)
            ReturnValue(0)
        }
        IfCondition EqualTo(rs, 17) ThenBlock: {
            SetByte(st, 17, b)
            IfCondition NotEqual(BitwiseAnd(b, 128), 0) ThenBlock: {
                SetByte(st, 69, 1)
            } ElseBlock: {
                SetByte(st, 69, 0)
            }
            ReturnValue(0)
        }
        IfCondition EqualTo(rs, 25) ThenBlock: {
            old = GetByte(st, 25)
            ack = BitwiseXor(b, 255)
            SetByte(st, 25, BitwiseAnd(old, ack))
            ReturnValue(0)
        }
        SetByte(st, rs, b)
    }
}

Function.MOS6569_Tick {
    Input: chip: Address
    Input: cycles: Integer
    Body: {
        st = MOS6569_Ensure(chip)
        cyl = GetByte(st, 66)
        rast_lo = GetByte(st, 64)
        rast_hi = GetByte(st, 65)
        raster = Add(rast_lo, ShiftLeft(rast_hi, 8))
        cyl = Add(cyl, cycles)
        WhileLoop GreaterEqual(cyl, 65) {
            cyl = Subtract(cyl, 65)
            raster = Add(raster, 1)
            IfCondition GreaterEqual(raster, 263) ThenBlock: {
                raster = 0
            }
            cmp = GetByte(st, 68)
            cmp8 = GetByte(st, 69)
            want = cmp
            IfCondition EqualTo(cmp8, 1) ThenBlock: {
                want = Add(cmp, 256)
            }
            IfCondition EqualTo(raster, want) ThenBlock: {
                irqst = GetByte(st, 25)
                irqst = BitwiseOr(irqst, 1)
                SetByte(st, 25, irqst)
                mask = GetByte(st, 26)
                IfCondition NotEqual(BitwiseAnd(mask, 1), 0) ThenBlock: {
                    SetByte(st, 67, 1)
                }
            }
        }
        SetByte(st, 66, cyl)
        SetByte(st, 64, BitwiseAnd(raster, 255))
        SetByte(st, 65, BitwiseAnd(ShiftRight(raster, 8), 255))
    }
}

Function.MOS6569_IRQLevel {
    Input: chip: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(chip, 0) ThenBlock: {
            ReturnValue(0)
        }
        st_off = PoolFieldOffset(LinkagePool.Chip, "state")
        st = Dereference(Add(chip, st_off))
        IfCondition EqualTo(st, 0) ThenBlock: {
            ReturnValue(0)
        }
        v = GetByte(st, 67)
        ReturnValue(v)
    }
}
