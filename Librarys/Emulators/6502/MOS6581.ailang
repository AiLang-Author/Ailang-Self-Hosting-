// Library.MOS6581.ailang
// MOS 6581 SID — Ailang chip model (register file this pass).
// Follows floooh/chips m6581.h (zlib). Analog later.

Import.Librarys.Emulators.6502.Board

Function.MOS6581_Ensure {
    Input: chip: Address
    Output: Integer
    Body: {
        st_off = PoolFieldOffset(LinkagePool.Chip, "state")
        st = Dereference(Add(chip, st_off))
        IfCondition NotEqual(st, 0) ThenBlock: {
            ReturnValue(st)
        }
        st = Allocate(32)
        zi = 0
        WhileLoop LessThan(zi, 32) {
            SetByte(st, zi, 0)
            zi = Add(zi, 1)
        }
        StoreValue(Add(chip, st_off), st)
        ReturnValue(st)
    }
}

Function.MOS6581_Read {
    Input: chip: Address
    Input: addr: Integer
    Output: Integer
    Body: {
        st = MOS6581_Ensure(chip)
        rs = BitwiseAnd(addr, 31)
        v = GetByte(st, rs)
        ReturnValue(v)
    }
}

Function.MOS6581_Write {
    Input: chip: Address
    Input: addr: Integer
    Input: value: Integer
    Body: {
        st = MOS6581_Ensure(chip)
        rs = BitwiseAnd(addr, 31)
        b = BitwiseAnd(value, 255)
        SetByte(st, rs, b)
    }
}
