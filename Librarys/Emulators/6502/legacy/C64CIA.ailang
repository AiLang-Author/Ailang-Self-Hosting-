// Library.C64CIA.ailang
// MOS 6526 CIA (Complex Interface Adapter) Emulation
//
// The C64 has two CIA chips:
//   CIA1 ($DC00-$DCFF): Keyboard matrix, joystick ports, tape
//   CIA2 ($DD00-$DDFF): VIC bank, serial bus, RS-232
//
// This implementation focuses on:
//   - Keyboard matrix scanning (CIA1)
//   - Joystick reading (CIA1)
//   - VIC bank selection (CIA2)
//   - Basic timer support
//
// Usage: LibraryImport.C64CIA
// Replaces stubs in C64Memory
//
// Copyright (c) 2025-2026 Sean Collins, 2 Paws Machine and Engineering. All rights reserved.
// Licensed under the Sean Collins Software License (SCSL v1.0).

LibraryImport.C64Memory
LibraryImport.Framebuffer  // For keyboard input

// =============================================================================
// CIA REGISTER MAP (16 registers, mirrored)
// =============================================================================
// $x0: PRA  - Port A data
// $x1: PRB  - Port B data
// $x2: DDRA - Data Direction A (1=output)
// $x3: DDRB - Data Direction B
// $x4: TALO - Timer A Low byte
// $x5: TAHI - Timer A High byte
// $x6: TBLO - Timer B Low byte
// $x7: TBHI - Timer B High byte
// $x8: TOD 10ths - Time of Day (1/10 sec)
// $x9: TOD Sec
// $xA: TOD Min
// $xB: TOD Hr
// $xC: SDR  - Serial Data Register
// $xD: ICR  - Interrupt Control Register
// $xE: CRA  - Control Register A
// $xF: CRB  - Control Register B

// =============================================================================
// CIA1 STATE (Keyboard/Joystick)
// =============================================================================

FixedPool.CIA1 {
    // Port registers
    "pra": Initialize=0xFF          // Port A (directly accent keyboard columns)
    "prb": Initialize=0xFF          // Port B (keyboard rows, accent joystick 1)
    "ddra": Initialize=0            // Data direction A
    "ddrb": Initialize=0            // Data direction B
    
    // Timers
    "timer_a": Initialize=0xFFFF
    "timer_a_latch": Initialize=0xFFFF
    "timer_b": Initialize=0xFFFF
    "timer_b_latch": Initialize=0xFFFF
    
    // Control
    "cra": Initialize=0
    "crb": Initialize=0
    
    // Interrupt
    "icr_data": Initialize=0
    "icr_mask": Initialize=0
}

// =============================================================================
// CIA2 STATE (VIC Bank/Serial)
// =============================================================================

FixedPool.CIA2 {
    "pra": Initialize=0x03          // Bits 0-1: VIC bank (inverted)
    "prb": Initialize=0xFF
    "ddra": Initialize=0x03
    "ddrb": Initialize=0
    
    "timer_a": Initialize=0xFFFF
    "timer_a_latch": Initialize=0xFFFF
    "timer_b": Initialize=0xFFFF
    "timer_b_latch": Initialize=0xFFFF
    
    "cra": Initialize=0
    "crb": Initialize=0
    
    "icr_data": Initialize=0
    "icr_mask": Initialize=0
}

// =============================================================================
// KEYBOARD MATRIX STATE
// =============================================================================
// C64 keyboard is 8×8 matrix, accent accent accent accent accent accent accent accent accent accent accent accent accent accent accent accent accent accent accent accent accent accent accent by CIA1
// CIA1 PRA = column select (accent output), PRB = row read (input)
// When a key is pressed, the corresponding row bit goes LOW

FixedPool.KeyMatrix {
    "rows": Initialize=0            // Pointer to 8-byte matrix state
    "current_key": Initialize=0     // Most recent key pressed
    "shift_pressed": Initialize=0
    "ctrl_pressed": Initialize=0
    "commodore_pressed": Initialize=0
    "initialized": Initialize=0
}

// =============================================================================
// INITIALIZATION
// =============================================================================

Function.CIA_Init {
    Body: {
        // Allocate keyboard matrix (8 rows)
        KeyMatrix.rows = Allocate(8)
        
        // Initialize all rows to 0xFF (no keys pressed)
        i = 0
        WhileLoop LessThan(i, 8) {
            SetByte(KeyMatrix.rows, i, 0xFF)
            i = Add(i, 1)
        }
        
        KeyMatrix.initialized = 1
        PrintMessage("CIA chips initialized\n")
    }
}

Function.CIA_Shutdown {
    Body: {
        IfCondition NotEqual(KeyMatrix.rows, 0) ThenBlock: {
            Deallocate(KeyMatrix.rows, 8)
            KeyMatrix.rows = 0
        }
    }
}

// =============================================================================
// CIA1 READ/WRITE (Keyboard/Joystick)
// =============================================================================

Function.C64CIA1_Read {
    Input: reg: Integer
    Output: Integer
    Body: {
        r = BitwiseAnd(reg, 0x0F)
        
        // Port A (directly accent columns)
        IfCondition EqualTo(r, 0) ThenBlock: {
            ReturnValue(CIA1.pra)
        }
        
        // Port B (keyboard rows / joystick 1)
        IfCondition EqualTo(r, 1) ThenBlock: {
            // Scan keyboard matrix based on column selection in PRA
            result = CIA1_ScanKeyboard()
            ReturnValue(result)
        }
        
        // Data Direction A
        IfCondition EqualTo(r, 2) ThenBlock: {
            ReturnValue(CIA1.ddra)
        }
        
        // Data Direction B
        IfCondition EqualTo(r, 3) ThenBlock: {
            ReturnValue(CIA1.ddrb)
        }
        
        // Timer A Low
        IfCondition EqualTo(r, 4) ThenBlock: {
            ReturnValue(BitwiseAnd(CIA1.timer_a, 0xFF))
        }
        
        // Timer A High
        IfCondition EqualTo(r, 5) ThenBlock: {
            ReturnValue(BitwiseAnd(ShiftRight(CIA1.timer_a, 8), 0xFF))
        }
        
        // Timer B Low
        IfCondition EqualTo(r, 6) ThenBlock: {
            ReturnValue(BitwiseAnd(CIA1.timer_b, 0xFF))
        }
        
        // Timer B High
        IfCondition EqualTo(r, 7) ThenBlock: {
            ReturnValue(BitwiseAnd(ShiftRight(CIA1.timer_b, 8), 0xFF))
        }
        
        // ICR (clears on read)
        IfCondition EqualTo(r, 13) ThenBlock: {
            result = CIA1.icr_data
            CIA1.icr_data = 0
            ReturnValue(result)
        }
        
        // CRA
        IfCondition EqualTo(r, 14) ThenBlock: {
            ReturnValue(CIA1.cra)
        }
        
        // CRB
        IfCondition EqualTo(r, 15) ThenBlock: {
            ReturnValue(CIA1.crb)
        }
        
        ReturnValue(0xFF)
    }
}

Function.C64CIA1_Write {
    Input: reg: Integer
    Input: value: Integer
    Body: {
        r = BitwiseAnd(reg, 0x0F)
        v = BitwiseAnd(value, 0xFF)
        
        // Port A (column select for keyboard)
        IfCondition EqualTo(r, 0) ThenBlock: {
            CIA1.pra = v
            ReturnValue(0)
        }
        
        // Port B
        IfCondition EqualTo(r, 1) ThenBlock: {
            CIA1.prb = v
            ReturnValue(0)
        }
        
        // Data Direction A
        IfCondition EqualTo(r, 2) ThenBlock: {
            CIA1.ddra = v
            ReturnValue(0)
        }
        
        // Data Direction B
        IfCondition EqualTo(r, 3) ThenBlock: {
            CIA1.ddrb = v
            ReturnValue(0)
        }
        
        // Timer A Latch Low
        IfCondition EqualTo(r, 4) ThenBlock: {
            CIA1.timer_a_latch = BitwiseOr(BitwiseAnd(CIA1.timer_a_latch, 0xFF00), v)
            ReturnValue(0)
        }
        
        // Timer A Latch High
        IfCondition EqualTo(r, 5) ThenBlock: {
            CIA1.timer_a_latch = BitwiseOr(BitwiseAnd(CIA1.timer_a_latch, 0x00FF), ShiftLeft(v, 8))
            ReturnValue(0)
        }
        
        // Timer B Latch Low
        IfCondition EqualTo(r, 6) ThenBlock: {
            CIA1.timer_b_latch = BitwiseOr(BitwiseAnd(CIA1.timer_b_latch, 0xFF00), v)
            ReturnValue(0)
        }
        
        // Timer B Latch High
        IfCondition EqualTo(r, 7) ThenBlock: {
            CIA1.timer_b_latch = BitwiseOr(BitwiseAnd(CIA1.timer_b_latch, 0x00FF), ShiftLeft(v, 8))
            ReturnValue(0)
        }
        
        // ICR (write sets mask)
        IfCondition EqualTo(r, 13) ThenBlock: {
            IfCondition NotEqual(BitwiseAnd(v, 0x80), 0) ThenBlock: {
                // Set bits
                CIA1.icr_mask = BitwiseOr(CIA1.icr_mask, BitwiseAnd(v, 0x7F))
            } ElseBlock: {
                // Clear bits
                CIA1.icr_mask = BitwiseAnd(CIA1.icr_mask, BitwiseNot(BitwiseAnd(v, 0x7F)))
            }
            ReturnValue(0)
        }
        
        // CRA
        IfCondition EqualTo(r, 14) ThenBlock: {
            CIA1.cra = v
            // Force load bit
            IfCondition NotEqual(BitwiseAnd(v, 0x10), 0) ThenBlock: {
                CIA1.timer_a = CIA1.timer_a_latch
            }
            ReturnValue(0)
        }
        
        // CRB
        IfCondition EqualTo(r, 15) ThenBlock: {
            CIA1.crb = v
            IfCondition NotEqual(BitwiseAnd(v, 0x10), 0) ThenBlock: {
                CIA1.timer_b = CIA1.timer_b_latch
            }
            ReturnValue(0)
        }
    }
}

// =============================================================================
// CIA2 READ/WRITE (VIC Bank/Serial)
// =============================================================================

Function.C64CIA2_Read {
    Input: reg: Integer
    Output: Integer
    Body: {
        r = BitwiseAnd(reg, 0x0F)
        
        // Port A (VIC bank bits 0-1, accent serial bits)
        IfCondition EqualTo(r, 0) ThenBlock: {
            ReturnValue(CIA2.pra)
        }
        
        // Port B
        IfCondition EqualTo(r, 1) ThenBlock: {
            ReturnValue(CIA2.prb)
        }
        
        // Data Direction A
        IfCondition EqualTo(r, 2) ThenBlock: {
            ReturnValue(CIA2.ddra)
        }
        
        // Data Direction B
        IfCondition EqualTo(r, 3) ThenBlock: {
            ReturnValue(CIA2.ddrb)
        }
        
        // Timer A Low
        IfCondition EqualTo(r, 4) ThenBlock: {
            ReturnValue(BitwiseAnd(CIA2.timer_a, 0xFF))
        }
        
        // Timer A High
        IfCondition EqualTo(r, 5) ThenBlock: {
            ReturnValue(BitwiseAnd(ShiftRight(CIA2.timer_a, 8), 0xFF))
        }
        
        // ICR
        IfCondition