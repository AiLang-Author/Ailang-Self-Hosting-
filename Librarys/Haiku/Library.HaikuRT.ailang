// Library.HaikuRT.ailang - Linux syscall ABI on native Haiku (--haiku).
//
// The compiler routes every Linux syscall of a --haiku program here:
// SystemCall(n, ...) and the Sys_* emitters call HaikuSys_Call(n, a1..a5),
// with a6 parked in HaikuRT.a6 (see Library.CHaikuEmit). This file turns
// Linux numbers, arguments, open flags, /proc/self paths and error codes
// into Haiku kernel calls. Numbers come from Library.HaikuNr (generated
// from the target's libroot.so).
//
// Rules for this file: no Allocate, no SystemCall, no Print*. Only the raw
// HaikuSyscall / HaikuAnonMap builtins, or the shim calls itself.
//
// Copyright (c) 2026 Sean Collins, 2 Paws Machine and Engineering. All rights reserved.
// Licensed under the Sean Collins Software License (SCSL v1.0).

LibraryImport.Haiku.HaikuNr

FixedPool.HaikuRT {
    "a6": Initialize=0, CanChange=True
    "argc": Initialize=0, CanChange=True
    "argv": Initialize=0, CanChange=True
    "envp": Initialize=0, CanChange=True
    // NUL-separated argv and environ, as /proc/self/cmdline and environ read
    "cmd": Initialize=0, CanChange=True
    "cmd_len": Initialize=0, CanChange=True
    "env": Initialize=0, CanChange=True
    "env_len": Initialize=0, CanChange=True
    // Read positions of the two pseudo files; -1 when not open
    "cmd_pos": Initialize=-1, CanChange=True
    "env_pos": Initialize=-1, CanChange=True
    "blob_len": Initialize=0, CanChange=True
    // One anonymous page-group for stat, siginfo, poll, dirent, and
    // sigaction scratch. New fields stay at the end so HaikuRT.a6's
    // pool index does not move.
    "scratch": Initialize=0, CanChange=True
    "seq": Initialize=0, CanChange=True
}

FixedPool.HaikuLx {
    "FD_CMDLINE": Initialize=2147418113
    "FD_ENVIRON": Initialize=2147418114
    "AT_FDCWD": Initialize=-100
    "MAP_FIXED": Initialize=16
    "MAP_ANONYMOUS": Initialize=32
    "U32": Initialize=4294967295
    "S32_SPAN": Initialize=4294967296
    "S32_MIN": Initialize=2147483648
    "B_RELATIVE_TIMEOUT": Initialize=8
    "EPERM": Initialize=-1
    "ENOENT": Initialize=-2
    "EINTR": Initialize=-4
    "EIO": Initialize=-5
    "EBADF": Initialize=-9
    "EAGAIN": Initialize=-11
    "ENOMEM": Initialize=-12
    "EACCES": Initialize=-13
    "EFAULT": Initialize=-14
    "EBUSY": Initialize=-16
    "EEXIST": Initialize=-17
    "EXDEV": Initialize=-18
    "ENOTDIR": Initialize=-20
    "EISDIR": Initialize=-21
    "EINVAL": Initialize=-22
    "EMFILE": Initialize=-24
    "ENOSPC": Initialize=-28
    "ESPIPE": Initialize=-29
    "EROFS": Initialize=-30
    "EPIPE": Initialize=-32
    "ENAMETOOLONG": Initialize=-36
    "ENOSYS": Initialize=-38
    "ENOTEMPTY": Initialize=-39
    "ELOOP": Initialize=-40
    "ETIMEDOUT": Initialize=-110
    "ESRCH": Initialize=-3
    "ECHILD": Initialize=-10
}

// =============================================================================
// RESULTS AND ERRORS
// =============================================================================

// Haiku error code (its POSIX errno values are B_* codes) -> Linux -errno.
Function.HaikuRT_Errno {
    Input: e: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(e, -2147459069) ThenBlock: { ReturnValue(HaikuLx.ENOENT) }
        IfCondition EqualTo(e, -2147483646) ThenBlock: { ReturnValue(HaikuLx.EACCES) }
        IfCondition EqualTo(e, -2147459070) ThenBlock: { ReturnValue(HaikuLx.EEXIST) }
        IfCondition EqualTo(e, -2147459072) ThenBlock: { ReturnValue(HaikuLx.EBADF) }
        IfCondition EqualTo(e, -2147483643) ThenBlock: { ReturnValue(HaikuLx.EINVAL) }
        IfCondition EqualTo(e, -2147483648) ThenBlock: { ReturnValue(HaikuLx.ENOMEM) }
        IfCondition EqualTo(e, -2147459067) ThenBlock: { ReturnValue(HaikuLx.ENOTDIR) }
        IfCondition EqualTo(e, -2147459063) ThenBlock: { ReturnValue(HaikuLx.EISDIR) }
        IfCondition EqualTo(e, -2147483638) ThenBlock: { ReturnValue(HaikuLx.EINTR) }
        IfCondition EqualTo(e, -2147483637) ThenBlock: { ReturnValue(HaikuLx.EAGAIN) }
        IfCondition EqualTo(e, -2147459065) ThenBlock: { ReturnValue(HaikuLx.ENOSPC) }
        IfCondition EqualTo(e, -2147459059) ThenBlock: { ReturnValue(HaikuLx.EPIPE) }
        IfCondition EqualTo(e, -2147459066) ThenBlock: { ReturnValue(HaikuLx.ENOTEMPTY) }
        IfCondition EqualTo(e, -2147459068) ThenBlock: { ReturnValue(HaikuLx.ENAMETOOLONG) }
        IfCondition EqualTo(e, -2147483633) ThenBlock: { ReturnValue(HaikuLx.EPERM) }
        IfCondition EqualTo(e, -2147483647) ThenBlock: { ReturnValue(HaikuLx.EIO) }
        IfCondition EqualTo(e, -2147459062) ThenBlock: { ReturnValue(HaikuLx.EMFILE) }
        IfCondition EqualTo(e, -2147459064) ThenBlock: { ReturnValue(HaikuLx.EROFS) }
        IfCondition EqualTo(e, -2147454964) ThenBlock: { ReturnValue(HaikuLx.ESPIPE) }
        IfCondition EqualTo(e, -2147454967) ThenBlock: { ReturnValue(HaikuLx.ENOSYS) }
        IfCondition EqualTo(e, -2147483634) ThenBlock: { ReturnValue(HaikuLx.EBUSY) }
        IfCondition EqualTo(e, -2147459060) ThenBlock: { ReturnValue(HaikuLx.ELOOP) }
        IfCondition EqualTo(e, -2147483639) ThenBlock: { ReturnValue(HaikuLx.ETIMEDOUT) }
        IfCondition EqualTo(e, -2147478783) ThenBlock: { ReturnValue(HaikuLx.EFAULT) }
        IfCondition EqualTo(e, -2147459061) ThenBlock: { ReturnValue(HaikuLx.EXDEV) }
        // B_BAD_THREAD_ID / B_BAD_TEAM_ID. kill() reports these as ESRCH.
        IfCondition EqualTo(e, -2147479296) ThenBlock: { ReturnValue(HaikuLx.ESRCH) }
        IfCondition EqualTo(e, -2147479293) ThenBlock: { ReturnValue(HaikuLx.ESRCH) }
        // B_NAME_NOT_FOUND (find_port after delete).
        IfCondition EqualTo(e, -2147483641) ThenBlock: { ReturnValue(HaikuLx.ENOENT) }
        // B_BAD_PORT_ID.
        IfCondition EqualTo(e, -2147479040) ThenBlock: { ReturnValue(HaikuLx.EINVAL) }
        // POSIX ECHILD and ESRCH as Haiku status_t (B_POSIX_ERROR_BASE + n).
        IfCondition EqualTo(e, -2147454974) ThenBlock: { ReturnValue(HaikuLx.ECHILD) }
        IfCondition EqualTo(e, -2147454963) ThenBlock: { ReturnValue(HaikuLx.ESRCH) }
        ReturnValue(HaikuLx.EIO)
    }
}

// Result of a call returning ssize_t / off_t (already 64-bit signed).
Function.HaikuRT_R64 {
    Input: r: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(r, 0) ThenBlock: {
            ReturnValue(HaikuRT_Errno(r))
        }
        ReturnValue(r)
    }
}

// Result of a call returning int / status_t: only EAX is defined.
Function.HaikuRT_R32 {
    Input: r: Integer
    Output: Integer
    Body: {
        v = BitwiseAnd(r, HaikuLx.U32)
        IfCondition GreaterEqual(v, HaikuLx.S32_MIN) ThenBlock: {
            v = Subtract(v, HaikuLx.S32_SPAN)
            ReturnValue(HaikuRT_Errno(v))
        }
        ReturnValue(v)
    }
}

// =============================================================================
// STRINGS (no library dependencies)
// =============================================================================
Function.HaikuRT_StrLen {
    Input: s: Address
    Output: Integer
    Body: {
        n = 0
        WhileLoop NotEqual(GetByte(s, n), 0) {
            n = Add(n, 1)
        }
        ReturnValue(n)
    }
}

Function.HaikuRT_StrEq {
    Input: a: Address
    Input: b: Address
    Output: Integer
    Body: {
        i = 0
        WhileLoop 1 {
            ca = GetByte(a, i)
            IfCondition NotEqual(ca, GetByte(b, i)) ThenBlock: {
                ReturnValue(0)
            }
            IfCondition EqualTo(ca, 0) ThenBlock: {
                ReturnValue(1)
            }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

// Pack a NULL-terminated string vector as NUL-separated bytes.
// Returns the buffer; length in HaikuRT.blob_len.
Function.HaikuRT_Blob {
    Input: vec: Address
    Output: Address
    Body: {
        total = 0
        i = 0
        WhileLoop NotEqual(vec, 0) {
            s = Dereference(Add(vec, Multiply(i, 8)))
            IfCondition EqualTo(s, 0) ThenBlock: {
                BreakLoop
            }
            total = Add(total, Add(HaikuRT_StrLen(s), 1))
            i = Add(i, 1)
        }
        HaikuRT.blob_len = total
        buf = HaikuAnonMap(Add(total, 1), 3)
        IfCondition LessThan(buf, 0) ThenBlock: {
            HaikuRT.blob_len = 0
            ReturnValue(0)
        }
        pos = 0
        j = 0
        WhileLoop LessThan(j, i) {
            s = Dereference(Add(vec, Multiply(j, 8)))
            k = 0
            WhileLoop 1 {
                c = GetByte(s, k)
                SetByte(buf, pos, c)
                pos = Add(pos, 1)
                IfCondition EqualTo(c, 0) ThenBlock: {
                    BreakLoop
                }
                k = Add(k, 1)
            }
            j = Add(j, 1)
        }
        ReturnValue(buf)
    }
}

// Called once from the --haiku entry, after the pools exist.
Function.HaikuRT_Init {
    Input: argc: Integer
    Input: argv: Address
    Input: envp: Address
    Body: {
        HaikuRT.argc = argc
        HaikuRT.argv = argv
        HaikuRT.envp = envp
        HaikuRT.cmd = HaikuRT_Blob(argv)
        HaikuRT.cmd_len = HaikuRT.blob_len
        HaikuRT.env = HaikuRT_Blob(envp)
        HaikuRT.env_len = HaikuRT.blob_len
    }
}

// =============================================================================
// FILES
// =============================================================================

// Linux O_* -> Haiku O_*. Access mode bits are the same.
Function.HaikuRT_OpenFlags {
    Input: f: Integer
    Output: Integer
    Body: {
        h = BitwiseAnd(f, 3)
        IfCondition NotEqual(BitwiseAnd(f, 64), 0) ThenBlock: { h = BitwiseOr(h, 512) }
        IfCondition NotEqual(BitwiseAnd(f, 128), 0) ThenBlock: { h = BitwiseOr(h, 256) }
        IfCondition NotEqual(BitwiseAnd(f, 256), 0) ThenBlock: { h = BitwiseOr(h, 4096) }
        IfCondition NotEqual(BitwiseAnd(f, 512), 0) ThenBlock: { h = BitwiseOr(h, 1024) }
        IfCondition NotEqual(BitwiseAnd(f, 1024), 0) ThenBlock: { h = BitwiseOr(h, 2048) }
        IfCondition NotEqual(BitwiseAnd(f, 2048), 0) ThenBlock: { h = BitwiseOr(h, 128) }
        IfCondition NotEqual(BitwiseAnd(f, 65536), 0) ThenBlock: { h = BitwiseOr(h, 2097152) }
        IfCondition NotEqual(BitwiseAnd(f, 524288), 0) ThenBlock: { h = BitwiseOr(h, 64) }
        ReturnValue(h)
    }
}

Function.HaikuRT_Open {
    Input: dirfd: Integer
    Input: path: Address
    Input: flags: Integer
    Input: mode: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(HaikuRT_StrEq(path, "/proc/self/cmdline"), 1) ThenBlock: {
            HaikuRT.cmd_pos = 0
            ReturnValue(HaikuLx.FD_CMDLINE)
        }
        IfCondition EqualTo(HaikuRT_StrEq(path, "/proc/self/environ"), 1) ThenBlock: {
            HaikuRT.env_pos = 0
            ReturnValue(HaikuLx.FD_ENVIRON)
        }
        IfCondition EqualTo(dirfd, HaikuLx.AT_FDCWD) ThenBlock: {
            dirfd = -1
        }
        // A Haiku fd from _kern_open cannot read_dir. Linux getdents needs
        // the directory fd that _kern_open_dir returns. fd < 0 is legal there.
        dirbit = BitwiseAnd(flags, 65536)
        IfCondition NotEqual(dirbit, 0) ThenBlock: {
            raw = HaikuSyscall(HaikuNr.OPEN_DIR, dirfd, path)
            r = HaikuRT_R32(raw)
            IfCondition LessThan(r, 0) ThenBlock: { ReturnValue(r) }
            clo = BitwiseAnd(flags, 524288)
            IfCondition NotEqual(clo, 0) ThenBlock: {
                HaikuSyscall(HaikuNr.FCNTL, r, 4, 1)
            }
            ReturnValue(r)
        }
        raw = HaikuSyscall(HaikuNr.OPEN, dirfd, path, HaikuRT_OpenFlags(flags), mode)
        r = HaikuRT_R32(raw)
        ReturnValue(r)
    }
}

// Copy from a pseudo file. pos is the current offset, -1 when closed.
Function.HaikuRT_PseudoRead {
    Input: src: Address
    Input: src_len: Integer
    Input: pos: Integer
    Input: buf: Address
    Input: len: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(pos, 0) ThenBlock: {
            ReturnValue(HaikuLx.EBADF)
        }
        n = Subtract(src_len, pos)
        IfCondition GreaterThan(n, len) ThenBlock: {
            n = len
        }
        IfCondition LessThan(n, 0) ThenBlock: {
            n = 0
        }
        i = 0
        WhileLoop LessThan(i, n) {
            SetByte(buf, i, GetByte(src, Add(pos, i)))
            i = Add(i, 1)
        }
        ReturnValue(n)
    }
}

Function.HaikuRT_Read {
    Input: fd: Integer
    Input: buf: Address
    Input: len: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(fd, HaikuLx.FD_CMDLINE) ThenBlock: {
            n = HaikuRT_PseudoRead(HaikuRT.cmd, HaikuRT.cmd_len, HaikuRT.cmd_pos, buf, len)
            IfCondition GreaterThan(n, 0) ThenBlock: {
                HaikuRT.cmd_pos = Add(HaikuRT.cmd_pos, n)
            }
            ReturnValue(n)
        }
        IfCondition EqualTo(fd, HaikuLx.FD_ENVIRON) ThenBlock: {
            n = HaikuRT_PseudoRead(HaikuRT.env, HaikuRT.env_len, HaikuRT.env_pos, buf, len)
            IfCondition GreaterThan(n, 0) ThenBlock: {
                HaikuRT.env_pos = Add(HaikuRT.env_pos, n)
            }
            ReturnValue(n)
        }
        ReturnValue(HaikuRT_R64(HaikuSyscall(HaikuNr.READ, fd, -1, buf, len)))
    }
}

Function.HaikuRT_Close {
    Input: fd: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(fd, HaikuLx.FD_CMDLINE) ThenBlock: {
            HaikuRT.cmd_pos = -1
            ReturnValue(0)
        }
        IfCondition EqualTo(fd, HaikuLx.FD_ENVIRON) ThenBlock: {
            HaikuRT.env_pos = -1
            ReturnValue(0)
        }
        ReturnValue(HaikuRT_R32(HaikuSyscall(HaikuNr.CLOSE, fd)))
    }
}

Function.HaikuRT_Seek {
    Input: fd: Integer
    Input: off: Integer
    Input: whence: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(fd, HaikuLx.FD_CMDLINE) ThenBlock: {
            IfCondition NotEqual(whence, 0) ThenBlock: { ReturnValue(HaikuLx.EINVAL) }
            HaikuRT.cmd_pos = off
            ReturnValue(off)
        }
        IfCondition EqualTo(fd, HaikuLx.FD_ENVIRON) ThenBlock: {
            IfCondition NotEqual(whence, 0) ThenBlock: { ReturnValue(HaikuLx.EINVAL) }
            HaikuRT.env_pos = off
            ReturnValue(off)
        }
        ReturnValue(HaikuRT_R64(HaikuSyscall(HaikuNr.SEEK, fd, off, whence)))
    }
}

// readlink: /proc/self/exe answers argv[0]; other links are not wired yet.
Function.HaikuRT_ReadLink {
    Input: path: Address
    Input: buf: Address
    Input: size: Integer
    Output: Integer
    Body: {
        IfCondition NotEqual(HaikuRT_StrEq(path, "/proc/self/exe"), 1) ThenBlock: {
            ReturnValue(HaikuLx.EINVAL)
        }
        IfCondition EqualTo(HaikuRT.argv, 0) ThenBlock: {
            ReturnValue(HaikuLx.ENOENT)
        }
        exe = Dereference(HaikuRT.argv)
        n = HaikuRT_StrLen(exe)
        IfCondition GreaterThan(n, size) ThenBlock: {
            n = size
        }
        i = 0
        WhileLoop LessThan(i, n) {
            SetByte(buf, i, GetByte(exe, i))
            i = Add(i, 1)
        }
        ReturnValue(n)
    }
}

Function.HaikuRT_GetRandom {
    Input: buf: Address
    Input: len: Integer
    Output: Integer
    Body: {
        fd = HaikuRT_R32(HaikuSyscall(HaikuNr.OPEN, -1, "/dev/urandom", 0, 0))
        IfCondition LessThan(fd, 0) ThenBlock: {
            ReturnValue(fd)
        }
        n = HaikuRT_R64(HaikuSyscall(HaikuNr.READ, fd, -1, buf, len))
        HaikuSyscall(HaikuNr.CLOSE, fd)
        ReturnValue(n)
    }
}

Function.HaikuRT_GetCwd {
    Input: buf: Address
    Input: size: Integer
    Output: Integer
    Body: {
        r = HaikuRT_R32(HaikuSyscall(HaikuNr.GETCWD, buf, size))
        IfCondition LessThan(r, 0) ThenBlock: {
            ReturnValue(r)
        }
        ReturnValue(Add(HaikuRT_StrLen(buf), 1))
    }
}

// =============================================================================
// MEMORY
// =============================================================================
Function.HaikuRT_Mmap {
    Input: addr: Integer
    Input: len: Integer
    Input: prot: Integer
    Input: flags: Integer
    Output: Integer
    Body: {
        // File-backed and fixed-address maps need _kern_map_file (9 args,
        // three on the stack); not wired yet.
        IfCondition EqualTo(BitwiseAnd(flags, HaikuLx.MAP_ANONYMOUS), 0) ThenBlock: {
            ReturnValue(HaikuLx.ENOSYS)
        }
        IfCondition NotEqual(BitwiseAnd(flags, HaikuLx.MAP_FIXED), 0) ThenBlock: {
            ReturnValue(HaikuLx.ENOSYS)
        }
        ReturnValue(HaikuAnonMap(len, BitwiseAnd(prot, 7)))
    }
}

// =============================================================================
// SCRATCH AND BYTE HELPERS
// StoreValue writes 8 bytes, so 2-byte and 4-byte fields go through these.
// Scratch map (8192 bytes), filled on first use:
//   0..255      Haiku struct stat
//   256..511    siginfo
//   512..1023   pollfd copy (64 entries)
//   2048..2559  one Haiku dirent
//   3072..3199  sigaction pair
//   4000..4031  clock / time slots
// =============================================================================

Function.HaikuRT_Ld32 {
    Input: p: Address
    Output: Integer
    Body: {
        b0 = GetByte(p, 0)
        b1 = GetByte(p, 1)
        b2 = GetByte(p, 2)
        b3 = GetByte(p, 3)
        s1 = LeftShift(b1, 8)
        s2 = LeftShift(b2, 16)
        s3 = LeftShift(b3, 24)
        v = BitwiseOr(b0, s1)
        v = BitwiseOr(v, s2)
        v = BitwiseOr(v, s3)
        ReturnValue(v)
    }
}

Function.HaikuRT_St32 {
    Input: p: Address
    Input: v: Integer
    Body: {
        b = BitwiseAnd(v, 255)
        SetByte(p, 0, b)
        t = RightShift(v, 8)
        b = BitwiseAnd(t, 255)
        SetByte(p, 1, b)
        t = RightShift(v, 16)
        b = BitwiseAnd(t, 255)
        SetByte(p, 2, b)
        t = RightShift(v, 24)
        b = BitwiseAnd(t, 255)
        SetByte(p, 3, b)
    }
}

Function.HaikuRT_Ld16 {
    Input: p: Address
    Output: Integer
    Body: {
        b0 = GetByte(p, 0)
        b1 = GetByte(p, 1)
        s = LeftShift(b1, 8)
        v = BitwiseOr(b0, s)
        ReturnValue(v)
    }
}

Function.HaikuRT_St16 {
    Input: p: Address
    Input: v: Integer
    Body: {
        b = BitwiseAnd(v, 255)
        SetByte(p, 0, b)
        t = RightShift(v, 8)
        b = BitwiseAnd(t, 255)
        SetByte(p, 1, b)
    }
}

Function.HaikuRT_Zero {
    Input: p: Address
    Input: n: Integer
    Body: {
        i = 0
        WhileLoop LessThan(i, n) {
            SetByte(p, i, 0)
            i = Add(i, 1)
        }
    }
}

Function.HaikuRT_CopyBytes {
    Input: src: Address
    Input: dst: Address
    Input: n: Integer
    Body: {
        i = 0
        WhileLoop LessThan(i, n) {
            b = GetByte(src, i)
            SetByte(dst, i, b)
            i = Add(i, 1)
        }
    }
}

Function.HaikuRT_Align8 {
    Input: n: Integer
    Output: Integer
    Body: {
        t = Add(n, 7)
        m = BitwiseNot(7)
        a = BitwiseAnd(t, m)
        ReturnValue(a)
    }
}

Function.HaikuRT_Scratch {
    Output: Address
    Body: {
        IfCondition GreaterThan(HaikuRT.scratch, 0) ThenBlock: {
            ReturnValue(HaikuRT.scratch)
        }
        IfCondition LessThan(HaikuRT.scratch, 0) ThenBlock: {
            ReturnValue(0)
        }
        p = HaikuAnonMap(8192, 3)
        IfCondition LessThan(p, 1) ThenBlock: {
            HaikuRT.scratch = -1
            ReturnValue(0)
        }
        HaikuRT.scratch = p
        HaikuRT_Zero(p, 8192)
        ReturnValue(p)
    }
}

// Haiku struct stat (128 bytes, measured on hrev59866) into the Linux
// x86_64 struct stat (144). Mode lives at Linux offset 24, which is
// where HalCode reads S_IFMT.
Function.HaikuRT_CopyStat {
    Input: hs: Address
    Input: ls: Address
    Body: {
        HaikuRT_Zero(ls, 144)
        v = Dereference(hs)
        StoreValue(ls, v)
        p = Add(hs, 8)
        v = Dereference(p)
        q = Add(ls, 8)
        StoreValue(q, v)
        p = Add(hs, 20)
        v = HaikuRT_Ld32(p)
        q = Add(ls, 16)
        StoreValue(q, v)
        p = Add(hs, 16)
        v = HaikuRT_Ld32(p)
        q = Add(ls, 24)
        HaikuRT_St32(q, v)
        p = Add(hs, 24)
        v = HaikuRT_Ld32(p)
        q = Add(ls, 28)
        HaikuRT_St32(q, v)
        p = Add(hs, 28)
        v = HaikuRT_Ld32(p)
        q = Add(ls, 32)
        HaikuRT_St32(q, v)
        p = Add(hs, 40)
        v = HaikuRT_Ld32(p)
        q = Add(ls, 40)
        StoreValue(q, v)
        p = Add(hs, 32)
        v = Dereference(p)
        q = Add(ls, 48)
        StoreValue(q, v)
        p = Add(hs, 44)
        v = HaikuRT_Ld32(p)
        q = Add(ls, 56)
        StoreValue(q, v)
        p = Add(hs, 120)
        v = Dereference(p)
        q = Add(ls, 64)
        StoreValue(q, v)
        p = Add(hs, 48)
        v = Dereference(p)
        q = Add(ls, 72)
        StoreValue(q, v)
        p = Add(hs, 56)
        v = Dereference(p)
        q = Add(ls, 80)
        StoreValue(q, v)
        p = Add(hs, 64)
        v = Dereference(p)
        q = Add(ls, 88)
        StoreValue(q, v)
        p = Add(hs, 72)
        v = Dereference(p)
        q = Add(ls, 96)
        StoreValue(q, v)
        p = Add(hs, 80)
        v = Dereference(p)
        q = Add(ls, 104)
        StoreValue(q, v)
        p = Add(hs, 88)
        v = Dereference(p)
        q = Add(ls, 112)
        StoreValue(q, v)
    }
}

// fd is kept as passed. AT_FDCWD (-100) must reach _kern_read_stat
// unchanged; the open path is the one that rewrites it to -1.
Function.HaikuRT_ReadStat {
    Input: fd: Integer
    Input: path: Address
    Input: traverse: Integer
    Input: linux_st: Address
    Output: Integer
    Body: {
        sc = HaikuRT_Scratch()
        IfCondition EqualTo(sc, 0) ThenBlock: { ReturnValue(HaikuLx.ENOMEM) }
        HaikuRT_Zero(sc, 128)
        raw = HaikuSyscall(HaikuNr.READ_STAT, fd, path, traverse, sc, 128)
        r = HaikuRT_R32(raw)
        IfCondition LessThan(r, 0) ThenBlock: { ReturnValue(r) }
        HaikuRT_CopyStat(sc, linux_st)
        ReturnValue(0)
    }
}

// flags bit 0x100 is Linux AT_SYMLINK_NOFOLLOW (Haiku's value is 0x01,
// so the bit is not passed through). Any other flag is ignored.
Function.HaikuRT_StatAt {
    Input: dirfd: Integer
    Input: path: Address
    Input: buf: Address
    Input: flags: Integer
    Output: Integer
    Body: {
        trav = 1
        bit = BitwiseAnd(flags, 256)
        IfCondition NotEqual(bit, 0) ThenBlock: { trav = 0 }
        r = HaikuRT_ReadStat(dirfd, path, trav, buf)
        ReturnValue(r)
    }
}

// Linux poll bits to Haiku. POLLRDHUP (8192) becomes POLLHUP.
Function.HaikuRT_PollL2H {
    Input: ev: Integer
    Output: Integer
    Body: {
        h = 0
        IfCondition NotEqual(BitwiseAnd(ev, 1), 0) ThenBlock: { h = BitwiseOr(h, 1) }
        IfCondition NotEqual(BitwiseAnd(ev, 2), 0) ThenBlock: { h = BitwiseOr(h, 32) }
        IfCondition NotEqual(BitwiseAnd(ev, 4), 0) ThenBlock: { h = BitwiseOr(h, 2) }
        IfCondition NotEqual(BitwiseAnd(ev, 8), 0) ThenBlock: { h = BitwiseOr(h, 4) }
        IfCondition NotEqual(BitwiseAnd(ev, 16), 0) ThenBlock: { h = BitwiseOr(h, 128) }
        IfCondition NotEqual(BitwiseAnd(ev, 32), 0) ThenBlock: { h = BitwiseOr(h, 4096) }
        IfCondition NotEqual(BitwiseAnd(ev, 8192), 0) ThenBlock: { h = BitwiseOr(h, 128) }
        ReturnValue(h)
    }
}

Function.HaikuRT_PollH2L {
    Input: ev: Integer
    Output: Integer
    Body: {
        h = 0
        IfCondition NotEqual(BitwiseAnd(ev, 1), 0) ThenBlock: { h = BitwiseOr(h, 1) }
        IfCondition NotEqual(BitwiseAnd(ev, 32), 0) ThenBlock: { h = BitwiseOr(h, 2) }
        IfCondition NotEqual(BitwiseAnd(ev, 2), 0) ThenBlock: { h = BitwiseOr(h, 4) }
        IfCondition NotEqual(BitwiseAnd(ev, 4), 0) ThenBlock: { h = BitwiseOr(h, 8) }
        IfCondition NotEqual(BitwiseAnd(ev, 128), 0) ThenBlock: { h = BitwiseOr(h, 16) }
        IfCondition NotEqual(BitwiseAnd(ev, 4096), 0) ThenBlock: { h = BitwiseOr(h, 32) }
        ReturnValue(h)
    }
}

// Timeout is milliseconds on Linux and microseconds on Haiku. A negative
// timeout is infinite on both. At most 64 fds: the scratch copy is 512 bytes.
Function.HaikuRT_Poll {
    Input: fds: Address
    Input: nfds: Integer
    Input: timeout: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(nfds, 0) ThenBlock: { ReturnValue(HaikuLx.EINVAL) }
        IfCondition GreaterThan(nfds, 64) ThenBlock: { ReturnValue(HaikuLx.EINVAL) }
        sc = HaikuRT_Scratch()
        IfCondition EqualTo(sc, 0) ThenBlock: { ReturnValue(HaikuLx.ENOMEM) }
        base = Add(sc, 512)
        i = 0
        WhileLoop LessThan(i, nfds) {
            off = Multiply(i, 8)
            src = Add(fds, off)
            dst = Add(base, off)
            fd = HaikuRT_Ld32(src)
            HaikuRT_St32(dst, fd)
            ep = Add(src, 4)
            ev = HaikuRT_Ld16(ep)
            hev = HaikuRT_PollL2H(ev)
            dp = Add(dst, 4)
            HaikuRT_St16(dp, hev)
            rp = Add(dst, 6)
            HaikuRT_St16(rp, 0)
            i = Add(i, 1)
        }
        us = -1
        IfCondition GreaterEqual(timeout, 0) ThenBlock: {
            us = Multiply(timeout, 1000)
        }
        raw = HaikuSyscall(HaikuNr.POLL, base, nfds, us, 0)
        r = HaikuRT_R32(raw)
        IfCondition LessThan(r, 0) ThenBlock: { ReturnValue(r) }
        i = 0
        WhileLoop LessThan(i, nfds) {
            off = Multiply(i, 8)
            src = Add(base, off)
            dst = Add(fds, off)
            rp = Add(src, 6)
            rev = HaikuRT_Ld16(rp)
            lrev = HaikuRT_PollH2L(rev)
            dp = Add(dst, 6)
            HaikuRT_St16(dp, lrev)
            i = Add(i, 1)
        }
        ReturnValue(r)
    }
}

// F_SETFL status flags. Access-mode bits are not passed: Linux ignores
// them on F_SETFL, and Haiku might not.
Function.HaikuRT_FlToHaiku {
    Input: f: Integer
    Output: Integer
    Body: {
        h = 0
        IfCondition NotEqual(BitwiseAnd(f, 1024), 0) ThenBlock: { h = BitwiseOr(h, 2048) }
        IfCondition NotEqual(BitwiseAnd(f, 2048), 0) ThenBlock: { h = BitwiseOr(h, 128) }
        ReturnValue(h)
    }
}

Function.HaikuRT_FlFromHaiku {
    Input: h: Integer
    Output: Integer
    Body: {
        f = BitwiseAnd(h, 3)
        IfCondition NotEqual(BitwiseAnd(h, 2048), 0) ThenBlock: { f = BitwiseOr(f, 1024) }
        IfCondition NotEqual(BitwiseAnd(h, 128), 0) ThenBlock: { f = BitwiseOr(f, 2048) }
        ReturnValue(f)
    }
}

// Linux fcntl command to Haiku. 0 is a valid Linux command (F_DUPFD),
// so "unmapped" is tracked separately from the Haiku command value.
Function.HaikuRT_Fcntl {
    Input: fd: Integer
    Input: cmd: Integer
    Input: arg: Integer
    Output: Integer
    Body: {
        known = 0
        hcmd = 0
        harg = arg
        IfCondition EqualTo(cmd, 0) ThenBlock: {
            known = 1
            hcmd = 1
        }
        IfCondition EqualTo(cmd, 1) ThenBlock: {
            known = 1
            hcmd = 2
        }
        IfCondition EqualTo(cmd, 2) ThenBlock: {
            known = 1
            hcmd = 4
        }
        IfCondition EqualTo(cmd, 3) ThenBlock: {
            known = 1
            hcmd = 8
        }
        IfCondition EqualTo(cmd, 4) ThenBlock: {
            known = 1
            hcmd = 16
            harg = HaikuRT_FlToHaiku(arg)
        }
        IfCondition EqualTo(cmd, 1030) ThenBlock: {
            known = 1
            hcmd = 512
        }
        IfCondition EqualTo(known, 0) ThenBlock: { ReturnValue(HaikuLx.EINVAL) }
        raw = HaikuSyscall(HaikuNr.FCNTL, fd, hcmd, harg)
        r = HaikuRT_R32(raw)
        IfCondition LessThan(r, 0) ThenBlock: { ReturnValue(r) }
        IfCondition EqualTo(cmd, 3) ThenBlock: {
            f = HaikuRT_FlFromHaiku(r)
            ReturnValue(f)
        }
        ReturnValue(r)
    }
}

// pipe and pipe2. Linux O_CLOEXEC is 524288 (Haiku 64) and O_NONBLOCK
// is 2048 (Haiku 128). Any other flag is EINVAL, matching Linux pipe2.
Function.HaikuRT_Pipe2 {
    Input: fds: Address
    Input: flags: Integer
    Output: Integer
    Body: {
        mask = BitwiseNot(526336)
        extra = BitwiseAnd(flags, mask)
        IfCondition NotEqual(extra, 0) ThenBlock: { ReturnValue(HaikuLx.EINVAL) }
        h = 0
        IfCondition NotEqual(BitwiseAnd(flags, 524288), 0) ThenBlock: { h = BitwiseOr(h, 64) }
        IfCondition NotEqual(BitwiseAnd(flags, 2048), 0) ThenBlock: { h = BitwiseOr(h, 128) }
        raw = HaikuSyscall(HaikuNr.CREATE_PIPE, fds, h)
        r = HaikuRT_R32(raw)
        ReturnValue(r)
    }
}

// =============================================================================
// TIME
// =============================================================================

// Linux CLOCK_REALTIME is 0. Haiku's CLOCK_REALTIME is -1, and
// _kern_get_clock writes epoch microseconds. Linux CLOCK_MONOTONIC is 1
// and matches Haiku system_time (microseconds since boot).
Function.HaikuRT_ClockGetTime {
    Input: clk: Integer
    Input: ts: Address
    Output: Integer
    Body: {
        sc = HaikuRT_Scratch()
        IfCondition EqualTo(sc, 0) ThenBlock: { ReturnValue(HaikuLx.ENOMEM) }
        us = 0
        IfCondition EqualTo(clk, 0) ThenBlock: {
            slot = Add(sc, 4016)
            raw = HaikuSyscall(HaikuNr.GET_CLOCK, -1, slot)
            r = HaikuRT_R32(raw)
            IfCondition LessThan(r, 0) ThenBlock: { ReturnValue(r) }
            us = Dereference(slot)
        } ElseBlock: {
            IfCondition NotEqual(clk, 1) ThenBlock: { ReturnValue(HaikuLx.EINVAL) }
            us = HaikuSyscall(HaikuNr.SYSTEM_TIME)
        }
        sec = Divide(us, 1000000)
        StoreValue(ts, sec)
        usec = Modulo(us, 1000000)
        nsec = Multiply(usec, 1000)
        tp = Add(ts, 8)
        StoreValue(tp, nsec)
        ReturnValue(0)
    }
}

Function.HaikuRT_NanoSleep {
    Input: req: Address
    Output: Integer
    Body: {
        us = Add(Multiply(Dereference(req), 1000000), Divide(Dereference(Add(req, 8)), 1000))
        ReturnValue(HaikuRT_R32(HaikuSyscall(HaikuNr.SNOOZE_ETC, us, 0, HaikuLx.B_RELATIVE_TIMEOUT)))
    }
}

// =============================================================================
// SIGNALS, WAIT, DIRECTORIES
// Linux and Haiku share 1,2,3,4,6,8,9,11,14,15. The rest are translated.
// 16 (STKFLT) and 30 (PWR) have no Haiku number.
// =============================================================================

Function.HaikuRT_SigSame {
    Input: sig: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(sig, 1) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(sig, 2) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(sig, 3) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(sig, 4) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(sig, 6) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(sig, 8) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(sig, 9) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(sig, 11) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(sig, 14) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(sig, 15) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

Function.HaikuRT_SigL2H {
    Input: sig: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(sig, 0) ThenBlock: { ReturnValue(0) }
        same = HaikuRT_SigSame(sig)
        IfCondition EqualTo(same, 1) ThenBlock: { ReturnValue(sig) }
        IfCondition EqualTo(sig, 5) ThenBlock: { ReturnValue(22) }
        IfCondition EqualTo(sig, 7) ThenBlock: { ReturnValue(30) }
        IfCondition EqualTo(sig, 10) ThenBlock: { ReturnValue(18) }
        IfCondition EqualTo(sig, 12) ThenBlock: { ReturnValue(19) }
        IfCondition EqualTo(sig, 13) ThenBlock: { ReturnValue(7) }
        IfCondition EqualTo(sig, 17) ThenBlock: { ReturnValue(5) }
        IfCondition EqualTo(sig, 18) ThenBlock: { ReturnValue(12) }
        IfCondition EqualTo(sig, 19) ThenBlock: { ReturnValue(10) }
        IfCondition EqualTo(sig, 20) ThenBlock: { ReturnValue(13) }
        IfCondition EqualTo(sig, 21) ThenBlock: { ReturnValue(16) }
        IfCondition EqualTo(sig, 22) ThenBlock: { ReturnValue(17) }
        IfCondition EqualTo(sig, 23) ThenBlock: { ReturnValue(26) }
        IfCondition EqualTo(sig, 24) ThenBlock: { ReturnValue(28) }
        IfCondition EqualTo(sig, 25) ThenBlock: { ReturnValue(29) }
        IfCondition EqualTo(sig, 26) ThenBlock: { ReturnValue(27) }
        IfCondition EqualTo(sig, 27) ThenBlock: { ReturnValue(24) }
        IfCondition EqualTo(sig, 28) ThenBlock: { ReturnValue(20) }
        IfCondition EqualTo(sig, 29) ThenBlock: { ReturnValue(23) }
        IfCondition EqualTo(sig, 31) ThenBlock: { ReturnValue(25) }
        ReturnValue(-1)
    }
}

Function.HaikuRT_SigH2L {
    Input: sig: Integer
    Output: Integer
    Body: {
        same = HaikuRT_SigSame(sig)
        IfCondition EqualTo(same, 1) ThenBlock: { ReturnValue(sig) }
        IfCondition EqualTo(sig, 22) ThenBlock: { ReturnValue(5) }
        IfCondition EqualTo(sig, 30) ThenBlock: { ReturnValue(7) }
        IfCondition EqualTo(sig, 18) ThenBlock: { ReturnValue(10) }
        IfCondition EqualTo(sig, 19) ThenBlock: { ReturnValue(12) }
        IfCondition EqualTo(sig, 7) ThenBlock: { ReturnValue(13) }
        IfCondition EqualTo(sig, 5) ThenBlock: { ReturnValue(17) }
        IfCondition EqualTo(sig, 12) ThenBlock: { ReturnValue(18) }
        IfCondition EqualTo(sig, 10) ThenBlock: { ReturnValue(19) }
        IfCondition EqualTo(sig, 13) ThenBlock: { ReturnValue(20) }
        IfCondition EqualTo(sig, 16) ThenBlock: { ReturnValue(21) }
        IfCondition EqualTo(sig, 17) ThenBlock: { ReturnValue(22) }
        IfCondition EqualTo(sig, 26) ThenBlock: { ReturnValue(23) }
        IfCondition EqualTo(sig, 28) ThenBlock: { ReturnValue(24) }
        IfCondition EqualTo(sig, 29) ThenBlock: { ReturnValue(25) }
        IfCondition EqualTo(sig, 27) ThenBlock: { ReturnValue(26) }
        IfCondition EqualTo(sig, 24) ThenBlock: { ReturnValue(27) }
        IfCondition EqualTo(sig, 20) ThenBlock: { ReturnValue(28) }
        IfCondition EqualTo(sig, 23) ThenBlock: { ReturnValue(29) }
        IfCondition EqualTo(sig, 25) ThenBlock: { ReturnValue(31) }
        ReturnValue(sig)
    }
}

Function.HaikuRT_Kill {
    Input: pid: Integer
    Input: sig: Integer
    Output: Integer
    Body: {
        hsig = HaikuRT_SigL2H(sig)
        IfCondition LessThan(hsig, 0) ThenBlock: { ReturnValue(HaikuLx.EINVAL) }
        raw = HaikuSyscall(HaikuNr.SEND_SIGNAL, pid, hsig, 0, 0)
        r = HaikuRT_R32(raw)
        ReturnValue(r)
    }
}

// Copy a Haiku sigaction (handler, mask, flags, userdata) into the
// Linux rt_sigaction layout (handler, flags, restorer, mask). Flags are
// written as 0: the numeric values do not match, and this port only
// installs SIG_DFL and SIG_IGN.
Function.HaikuRT_SigToLinux {
    Input: hs: Address
    Input: ls: Address
    Body: {
        HaikuRT_Zero(ls, 32)
        h = Dereference(hs)
        StoreValue(ls, h)
        mp = Add(hs, 8)
        mask = Dereference(mp)
        dp = Add(ls, 24)
        StoreValue(dp, mask)
    }
}

// A real user handler returns ENOSYS. Delivery frames differ. Ignore
// and default succeed even when the Linux sa_flags word is nonzero.
Function.HaikuRT_SigAction {
    Input: sig: Integer
    Input: act: Address
    Input: oldact: Address
    Input: setsz: Integer
    Output: Integer
    Body: {
        IfCondition NotEqual(setsz, 0) ThenBlock: {
            IfCondition NotEqual(setsz, 8) ThenBlock: {
                ReturnValue(HaikuLx.EINVAL)
            }
        }
        hsig = HaikuRT_SigL2H(sig)
        IfCondition LessThan(hsig, 1) ThenBlock: { ReturnValue(HaikuLx.EINVAL) }
        sc = HaikuRT_Scratch()
        IfCondition EqualTo(sc, 0) ThenBlock: { ReturnValue(HaikuLx.ENOMEM) }
        hact = 0
        IfCondition NotEqual(act, 0) ThenBlock: {
            handler = Dereference(act)
            IfCondition GreaterThan(handler, 1) ThenBlock: {
                ReturnValue(HaikuLx.ENOSYS)
            }
            hact = Add(sc, 3072)
            HaikuRT_Zero(hact, 32)
            StoreValue(hact, handler)
            mp = Add(act, 24)
            mask = Dereference(mp)
            hp = Add(hact, 8)
            StoreValue(hp, mask)
        }
        hold = 0
        IfCondition NotEqual(oldact, 0) ThenBlock: {
            hold = Add(sc, 3120)
            HaikuRT_Zero(hold, 32)
        }
        raw = HaikuSyscall(HaikuNr.SIGACTION, hsig, hact, hold)
        r = HaikuRT_R32(raw)
        IfCondition LessThan(r, 0) ThenBlock: { ReturnValue(r) }
        IfCondition NotEqual(oldact, 0) ThenBlock: {
            HaikuRT_SigToLinux(hold, oldact)
        }
        ReturnValue(0)
    }
}

// Haiku's wait status is not Linux's. CLD_EXITED stores the code in
// si_status; CLD_KILLED stores the Haiku signal there. Linux wants
// (code<<8) for exit and (signal & 0x7f) for a signal death.
Function.HaikuRT_WaitStatus {
    Input: code: Integer
    Input: st: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(code, 60) ThenBlock: {
            c = BitwiseAnd(st, 255)
            w = LeftShift(c, 8)
            ReturnValue(w)
        }
        IfCondition EqualTo(code, 61) ThenBlock: {
            sig = HaikuRT_SigH2L(st)
            w = BitwiseAnd(sig, 127)
            ReturnValue(w)
        }
        IfCondition EqualTo(code, 62) ThenBlock: {
            sig = HaikuRT_SigH2L(st)
            s = BitwiseAnd(sig, 127)
            w = BitwiseOr(s, 128)
            ReturnValue(w)
        }
        IfCondition EqualTo(code, 64) ThenBlock: {
            sig = HaikuRT_SigH2L(st)
            sb = BitwiseAnd(sig, 255)
            s = LeftShift(sb, 8)
            w = BitwiseOr(s, 127)
            ReturnValue(w)
        }
        IfCondition EqualTo(code, 65) ThenBlock: { ReturnValue(65535) }
        c = BitwiseAnd(st, 255)
        w = LeftShift(c, 8)
        ReturnValue(w)
    }
}

// Linux WCONTINUED is bit 8; Haiku's is bit 4. WEXITED (8) is always
// set, which is what libroot does. B_WOULD_BLOCK with WNOHANG is 0,
// not EAGAIN.
Function.HaikuRT_Wait4 {
    Input: pid: Integer
    Input: status: Address
    Input: opt: Integer
    Output: Integer
    Body: {
        sc = HaikuRT_Scratch()
        IfCondition EqualTo(sc, 0) ThenBlock: { ReturnValue(HaikuLx.ENOMEM) }
        info = Add(sc, 256)
        HaikuRT_Zero(info, 64)
        hopt = BitwiseAnd(opt, 3)
        bit = BitwiseAnd(opt, 8)
        IfCondition NotEqual(bit, 0) ThenBlock: {
            hopt = BitwiseOr(hopt, 4)
        }
        hopt = BitwiseOr(hopt, 8)
        raw = HaikuSyscall(HaikuNr.WAIT_FOR_CHILD, pid, hopt, info, 0)
        low = BitwiseAnd(raw, HaikuLx.U32)
        IfCondition GreaterEqual(low, HaikuLx.S32_MIN) ThenBlock: {
            low = Subtract(low, HaikuLx.S32_SPAN)
        }
        IfCondition EqualTo(low, -2147483637) ThenBlock: {
            nowait = BitwiseAnd(opt, 1)
            IfCondition NotEqual(nowait, 0) ThenBlock: {
                ReturnValue(0)
            }
        }
        IfCondition LessThan(low, 0) ThenBlock: {
            e = HaikuRT_Errno(low)
            ReturnValue(e)
        }
        IfCondition NotEqual(status, 0) ThenBlock: {
            cp = Add(info, 4)
            code = HaikuRT_Ld32(cp)
            sp = Add(info, 32)
            st = HaikuRT_Ld32(sp)
            lx = HaikuRT_WaitStatus(code, st)
            HaikuRT_St32(status, lx)
        }
        ReturnValue(low)
    }
}

// The kernel returns the process group id on success. Linux returns 0.
Function.HaikuRT_SetPgid {
    Input: pid: Integer
    Input: pgid: Integer
    Output: Integer
    Body: {
        raw = HaikuSyscall(HaikuNr.SETPGID, pid, pgid)
        r = HaikuRT_R32(raw)
        IfCondition GreaterThan(r, 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(r)
    }
}

Function.HaikuRT_Time {
    Input: tloc: Address
    Output: Integer
    Body: {
        sc = HaikuRT_Scratch()
        IfCondition EqualTo(sc, 0) ThenBlock: { ReturnValue(HaikuLx.ENOMEM) }
        slot = Add(sc, 4000)
        raw = HaikuSyscall(HaikuNr.GET_CLOCK, -1, slot)
        r = HaikuRT_R32(raw)
        IfCondition LessThan(r, 0) ThenBlock: { ReturnValue(r) }
        us = Dereference(slot)
        sec = Divide(us, 1000000)
        IfCondition NotEqual(tloc, 0) ThenBlock: {
            StoreValue(tloc, sec)
        }
        ReturnValue(sec)
    }
}

// B_STAT_SIZE is 0x0008. The size field of a Haiku stat is at offset 32.
Function.HaikuRT_Ftruncate {
    Input: fd: Integer
    Input: length: Integer
    Output: Integer
    Body: {
        sc = HaikuRT_Scratch()
        IfCondition EqualTo(sc, 0) ThenBlock: { ReturnValue(HaikuLx.ENOMEM) }
        HaikuRT_Zero(sc, 128)
        sp = Add(sc, 32)
        StoreValue(sp, length)
        raw = HaikuSyscall(HaikuNr.WRITE_STAT, fd, 0, 0, sc, 128, 8)
        r = HaikuRT_R32(raw)
        ReturnValue(r)
    }
}

// Linux fchmod. B_STAT_MODE is 0x0001. BFS keeps the file type and
// applies only the permission bits (S_IUMSK) from st_mode at offset 16.
Function.HaikuRT_Fchmod {
    Input: fd: Integer
    Input: mode: Integer
    Output: Integer
    Body: {
        sc = HaikuRT_Scratch()
        IfCondition EqualTo(sc, 0) ThenBlock: { ReturnValue(HaikuLx.ENOMEM) }
        HaikuRT_Zero(sc, 128)
        sp = Add(sc, 16)
        HaikuRT_St32(sp, mode)
        raw = HaikuSyscall(HaikuNr.WRITE_STAT, fd, 0, 0, sc, 128, 1)
        r = HaikuRT_R32(raw)
        ReturnValue(r)
    }
}

// kind 0 is the old getdents layout (name at 18, type at reclen-1).
// kind 1 is getdents64 (type at 18, name at 19). _kern_read_dir returns
// a count of entries, not a byte count, so this reads one entry at a
// time and only when the caller still has 280 bytes free. That is the
// largest aligned record for a 255-byte name, so the entry that was
// consumed always fits. d_type comes from lstat of the name: a symlink
// must stay DT_LNK, so the link is not followed.
Function.HaikuRT_GetDents {
    Input: kind: Integer
    Input: fd: Integer
    Input: buf: Address
    Input: len: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(len, 280) ThenBlock: { ReturnValue(HaikuLx.EINVAL) }
        sc = HaikuRT_Scratch()
        IfCondition EqualTo(sc, 0) ThenBlock: { ReturnValue(HaikuLx.ENOMEM) }
        dent = Add(sc, 2048)
        written = 0
        WhileLoop 1 {
            remain = Subtract(len, written)
            IfCondition LessThan(remain, 280) ThenBlock: { BreakLoop }
            HaikuRT_Zero(dent, 512)
            raw = HaikuSyscall(HaikuNr.READ_DIR, fd, dent, 512, 1)
            cnt = HaikuRT_R32(raw)
            IfCondition LessThan(cnt, 0) ThenBlock: {
                IfCondition GreaterThan(written, 0) ThenBlock: { ReturnValue(written) }
                ReturnValue(cnt)
            }
            IfCondition EqualTo(cnt, 0) ThenBlock: { BreakLoop }
            ip = Add(dent, 8)
            ino = Dereference(ip)
            np = Add(dent, 26)
            nlen = HaikuRT_StrLen(np)
            IfCondition GreaterThan(nlen, 255) ThenBlock: { nlen = 255 }
            HaikuRT_Zero(sc, 128)
            sraw = HaikuSyscall(HaikuNr.READ_STAT, fd, np, 0, sc, 128)
            sr = HaikuRT_R32(sraw)
            dtype = 0
            IfCondition GreaterEqual(sr, 0) ThenBlock: {
                mp = Add(sc, 16)
                mode = HaikuRT_Ld32(mp)
                sh = RightShift(mode, 12)
                dtype = BitwiseAnd(sh, 15)
            }
            total = Add(20, nlen)
            reclen = HaikuRT_Align8(total)
            dst = Add(buf, written)
            HaikuRT_Zero(dst, reclen)
            StoreValue(dst, ino)
            HaikuRT.seq = Add(HaikuRT.seq, 1)
            op = Add(dst, 8)
            StoreValue(op, HaikuRT.seq)
            rp = Add(dst, 16)
            HaikuRT_St16(rp, reclen)
            nc = Add(nlen, 1)
            IfCondition EqualTo(kind, 1) ThenBlock: {
                SetByte(dst, 18, dtype)
                nd = Add(dst, 19)
                HaikuRT_CopyBytes(np, nd, nc)
            } ElseBlock: {
                nd = Add(dst, 18)
                HaikuRT_CopyBytes(np, nd, nc)
                last = Subtract(reclen, 1)
                SetByte(dst, last, dtype)
            }
            written = Add(written, reclen)
        }
        ReturnValue(written)
    }
}

// Linux sigset bit (signal-1) to the Haiku bit. Numbers that have no
// Haiku equivalent are dropped.
Function.HaikuRT_MaskL2H {
    Input: bits: Integer
    Output: Integer
    Body: {
        out = 0
        sig = 1
        WhileLoop LessEqual(sig, 31) {
            shift = Subtract(sig, 1)
            bitv = LeftShift(1, shift)
            on = BitwiseAnd(bits, bitv)
            IfCondition NotEqual(on, 0) ThenBlock: {
                hsig = HaikuRT_SigL2H(sig)
                IfCondition GreaterThan(hsig, 0) ThenBlock: {
                    hshift = Subtract(hsig, 1)
                    hbit = LeftShift(1, hshift)
                    out = BitwiseOr(out, hbit)
                }
            }
            sig = Add(sig, 1)
        }
        ReturnValue(out)
    }
}

Function.HaikuRT_MaskH2L {
    Input: bits: Integer
    Output: Integer
    Body: {
        out = 0
        sig = 1
        WhileLoop LessEqual(sig, 31) {
            shift = Subtract(sig, 1)
            bitv = LeftShift(1, shift)
            on = BitwiseAnd(bits, bitv)
            IfCondition NotEqual(on, 0) ThenBlock: {
                lsig = HaikuRT_SigH2L(sig)
                IfCondition GreaterThan(lsig, 0) ThenBlock: {
                    IfCondition LessEqual(lsig, 31) ThenBlock: {
                        lshift = Subtract(lsig, 1)
                        lbit = LeftShift(1, lshift)
                        out = BitwiseOr(out, lbit)
                    }
                }
            }
            sig = Add(sig, 1)
        }
        ReturnValue(out)
    }
}

// Linux how is 0/1/2. Haiku's SIG_BLOCK/UNBLOCK/SETMASK are 1/2/3.
Function.HaikuRT_SigProcMask {
    Input: how: Integer
    Input: set: Address
    Input: oldset: Address
    Input: setsz: Integer
    Output: Integer
    Body: {
        IfCondition NotEqual(setsz, 8) ThenBlock: {
            IfCondition NotEqual(setsz, 0) ThenBlock: {
                ReturnValue(HaikuLx.EINVAL)
            }
        }
        known = 0
        hhow = 0
        IfCondition EqualTo(how, 0) ThenBlock: {
            known = 1
            hhow = 1
        }
        IfCondition EqualTo(how, 1) ThenBlock: {
            known = 1
            hhow = 2
        }
        IfCondition EqualTo(how, 2) ThenBlock: {
            known = 1
            hhow = 3
        }
        IfCondition EqualTo(known, 0) ThenBlock: { ReturnValue(HaikuLx.EINVAL) }
        sc = HaikuRT_Scratch()
        IfCondition EqualTo(sc, 0) ThenBlock: { ReturnValue(HaikuLx.ENOMEM) }
        hset = 0
        IfCondition NotEqual(set, 0) ThenBlock: {
            bits = Dereference(set)
            hb = HaikuRT_MaskL2H(bits)
            hset = Add(sc, 3232)
            StoreValue(hset, hb)
        }
        hold = 0
        IfCondition NotEqual(oldset, 0) ThenBlock: {
            hold = Add(sc, 3248)
            StoreValue(hold, 0)
        }
        raw = HaikuSyscall(HaikuNr.SET_SIGNAL_MASK, hhow, hset, hold)
        r = HaikuRT_R32(raw)
        IfCondition LessThan(r, 0) ThenBlock: { ReturnValue(r) }
        IfCondition NotEqual(oldset, 0) ThenBlock: {
            hb = Dereference(hold)
            lb = HaikuRT_MaskH2L(hb)
            StoreValue(oldset, lb)
        }
        ReturnValue(0)
    }
}

Function.HaikuRT_Chdir {
    Input: path: Address
    Output: Integer
    Body: {
        raw = HaikuSyscall(HaikuNr.SETCWD, HaikuLx.AT_FDCWD, path)
        r = HaikuRT_R32(raw)
        ReturnValue(r)
    }
}

// =============================================================================
// ENTRY: Linux syscall number + Linux arguments -> Linux-style result
// =============================================================================
Function.HaikuSys_Call {
    Input: n: Integer
    Input: a1: Integer
    Input: a2: Integer
    Input: a3: Integer
    Input: a4: Integer
    Input: a5: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(n, 0) ThenBlock: { ReturnValue(HaikuRT_Read(a1, a2, a3)) }
        IfCondition EqualTo(n, 1) ThenBlock: {
            ReturnValue(HaikuRT_R64(HaikuSyscall(HaikuNr.WRITE, a1, -1, a2, a3)))
        }
        IfCondition EqualTo(n, 2) ThenBlock: {
            ReturnValue(HaikuRT_Open(HaikuLx.AT_FDCWD, a1, a2, a3))
        }
        IfCondition EqualTo(n, 3) ThenBlock: { ReturnValue(HaikuRT_Close(a1)) }
        IfCondition EqualTo(n, 8) ThenBlock: { ReturnValue(HaikuRT_Seek(a1, a2, a3)) }
        IfCondition EqualTo(n, 9) ThenBlock: { ReturnValue(HaikuRT_Mmap(a1, a2, a3, a4)) }
        IfCondition EqualTo(n, 10) ThenBlock: {
            ReturnValue(HaikuRT_R32(HaikuSyscall(HaikuNr.SET_MEMORY_PROTECTION, a1, a2, BitwiseAnd(a3, 7))))
        }
        IfCondition EqualTo(n, 11) ThenBlock: {
            ReturnValue(HaikuRT_R32(HaikuSyscall(HaikuNr.UNMAP_MEMORY, a1, a2)))
        }
        IfCondition EqualTo(n, 12) ThenBlock: { ReturnValue(HaikuLx.ENOMEM) }
        IfCondition EqualTo(n, 17) ThenBlock: {
            ReturnValue(HaikuRT_R64(HaikuSyscall(HaikuNr.READ, a1, a4, a2, a3)))
        }
        IfCondition EqualTo(n, 18) ThenBlock: {
            ReturnValue(HaikuRT_R64(HaikuSyscall(HaikuNr.WRITE, a1, a4, a2, a3)))
        }
        IfCondition EqualTo(n, 21) ThenBlock: {
            ReturnValue(HaikuRT_R32(HaikuSyscall(HaikuNr.ACCESS, -1, a1, a2, 0)))
        }
        IfCondition EqualTo(n, 32) ThenBlock: { ReturnValue(HaikuRT_R32(HaikuSyscall(HaikuNr.DUP, a1))) }
        IfCondition EqualTo(n, 33) ThenBlock: { ReturnValue(HaikuRT_R32(HaikuSyscall(HaikuNr.DUP2, a1, a2))) }
        IfCondition EqualTo(n, 35) ThenBlock: { ReturnValue(HaikuRT_NanoSleep(a1)) }
        IfCondition EqualTo(n, 39) ThenBlock: { ReturnValue(HaikuSyscall(HaikuNr.GET_CURRENT_TEAM)) }
        IfCondition EqualTo(n, 60) ThenBlock: { HaikuSyscall(HaikuNr.EXIT_TEAM, a1) }
        IfCondition EqualTo(n, 74) ThenBlock: { ReturnValue(HaikuRT_R32(HaikuSyscall(HaikuNr.FSYNC, a1))) }
        IfCondition EqualTo(n, 79) ThenBlock: { ReturnValue(HaikuRT_GetCwd(a1, a2)) }
        IfCondition EqualTo(n, 80) ThenBlock: { ReturnValue(HaikuRT_Chdir(a1)) }
        IfCondition EqualTo(n, 82) ThenBlock: {
            ReturnValue(HaikuRT_R32(HaikuSyscall(HaikuNr.RENAME, -1, a1, -1, a2)))
        }
        IfCondition EqualTo(n, 83) ThenBlock: {
            ReturnValue(HaikuRT_R32(HaikuSyscall(HaikuNr.CREATE_DIR, -1, a1, a2)))
        }
        IfCondition EqualTo(n, 84) ThenBlock: {
            ReturnValue(HaikuRT_R32(HaikuSyscall(HaikuNr.REMOVE_DIR, -1, a1)))
        }
        IfCondition EqualTo(n, 87) ThenBlock: {
            ReturnValue(HaikuRT_R32(HaikuSyscall(HaikuNr.UNLINK, -1, a1)))
        }
        IfCondition EqualTo(n, 89) ThenBlock: { ReturnValue(HaikuRT_ReadLink(a1, a2, a3)) }
        IfCondition EqualTo(n, 228) ThenBlock: { ReturnValue(HaikuRT_ClockGetTime(a1, a2)) }
        IfCondition EqualTo(n, 231) ThenBlock: { HaikuSyscall(HaikuNr.EXIT_TEAM, a1) }
        IfCondition EqualTo(n, 257) ThenBlock: { ReturnValue(HaikuRT_Open(a1, a2, a3, a4)) }
        IfCondition EqualTo(n, 318) ThenBlock: { ReturnValue(HaikuRT_GetRandom(a1, a2)) }
        IfCondition EqualTo(n, 4) ThenBlock: {
            ReturnValue(HaikuRT_StatAt(HaikuLx.AT_FDCWD, a1, a2, 0))
        }
        IfCondition EqualTo(n, 5) ThenBlock: { ReturnValue(HaikuRT_ReadStat(a1, 0, 0, a2)) }
        IfCondition EqualTo(n, 6) ThenBlock: {
            ReturnValue(HaikuRT_StatAt(HaikuLx.AT_FDCWD, a1, a2, 256))
        }
        IfCondition EqualTo(n, 7) ThenBlock: { ReturnValue(HaikuRT_Poll(a1, a2, a3)) }
        IfCondition EqualTo(n, 13) ThenBlock: { ReturnValue(HaikuRT_SigAction(a1, a2, a3, a4)) }
        IfCondition EqualTo(n, 14) ThenBlock: { ReturnValue(HaikuRT_SigProcMask(a1, a2, a3, a4)) }
        IfCondition EqualTo(n, 22) ThenBlock: { ReturnValue(HaikuRT_Pipe2(a1, 0)) }
        IfCondition EqualTo(n, 24) ThenBlock: {
            HaikuSyscall(HaikuNr.THREAD_YIELD)
            ReturnValue(0)
        }
        IfCondition EqualTo(n, 61) ThenBlock: { ReturnValue(HaikuRT_Wait4(a1, a2, a3)) }
        IfCondition EqualTo(n, 62) ThenBlock: { ReturnValue(HaikuRT_Kill(a1, a2)) }
        IfCondition EqualTo(n, 72) ThenBlock: { ReturnValue(HaikuRT_Fcntl(a1, a2, a3)) }
        IfCondition EqualTo(n, 77) ThenBlock: { ReturnValue(HaikuRT_Ftruncate(a1, a2)) }
        IfCondition EqualTo(n, 91) ThenBlock: { ReturnValue(HaikuRT_Fchmod(a1, a2)) }
        IfCondition EqualTo(n, 78) ThenBlock: { ReturnValue(HaikuRT_GetDents(0, a1, a2, a3)) }
        IfCondition EqualTo(n, 109) ThenBlock: { ReturnValue(HaikuRT_SetPgid(a1, a2)) }
        IfCondition EqualTo(n, 201) ThenBlock: { ReturnValue(HaikuRT_Time(a1)) }
        IfCondition EqualTo(n, 217) ThenBlock: { ReturnValue(HaikuRT_GetDents(1, a1, a2, a3)) }
        IfCondition EqualTo(n, 262) ThenBlock: { ReturnValue(HaikuRT_StatAt(a1, a2, a3, a4)) }
        IfCondition EqualTo(n, 293) ThenBlock: { ReturnValue(HaikuRT_Pipe2(a1, a2)) }
        IfCondition EqualTo(n, 186) ThenBlock: {
            raw = HaikuSyscall(HaikuNr.FIND_THREAD, 0)
            ReturnValue(HaikuRT_R32(raw))
        }
        // Explicitly untranslated: ioctl 16, clone 56, fork 57, execve 59,
        // prctl 157, signalfd 289, epoll 291/232/233, futex 202, and the
        // socket calls (41, 42, 43, 49, 50, 51, 54, 288).
        // fork/exec/clone belong to load_image in the platform layer.
        // A real rt_sigaction handler is ENOSYS inside HaikuRT_SigAction.
        ReturnValue(HaikuLx.ENOSYS)
    }
}
