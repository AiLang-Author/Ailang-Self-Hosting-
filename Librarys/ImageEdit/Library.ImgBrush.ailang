// Library.ImgBrush.ailang
// Circular stamp. Pencil = hardness 255. Airbrush = soft + low opacity.
// Integer isqrt + squared distance — no SquareRoot in the inner loop.
// Copyright © 2026 Sean Collins, 2 Paws Machine and Engineering. SCSL.

LibraryImport.Display.Render.DSurfaceTypes
LibraryImport.Display.Render.DSurface
LibraryImport.ImageEdit.ImgPixels

FixedPool.ImgBrush {
    "size":     Initialize=16, CanChange=True
    "opacity":  Initialize=255, CanChange=True
    "hardness": Initialize=255, CanChange=True
    "spacing":  Initialize=25, CanChange=True
    "color":    Initialize=0xFF000000, CanChange=True
    "eraser":   Initialize=0, CanChange=True
    "lx":       Initialize=0, CanChange=True
    "ly":       Initialize=0, CanChange=True
    "armed":    Initialize=0, CanChange=True
    "cx":       Initialize=0, CanChange=True
    "cy":       Initialize=0, CanChange=True
    "dx":       Initialize=0, CanChange=True
    "dy":       Initialize=0, CanChange=True
    "dist2":    Initialize=0, CanChange=True
    "r":        Initialize=0, CanChange=True
    "r2":       Initialize=0, CanChange=True
    "inner":    Initialize=0, CanChange=True
    "a":        Initialize=0, CanChange=True
    "d":        Initialize=0, CanChange=True
    "lo":       Initialize=0, CanChange=True
    "hi":       Initialize=0, CanChange=True
    "mid":      Initialize=0, CanChange=True
    "col":      Initialize=0, CanChange=True
    "space2":   Initialize=0, CanChange=True
    "surf":     Initialize=0, CanChange=True
}

Function.ImgISqrt {
    Input: n: Integer
    Output: Integer
    Body: {
        IfCondition LessEqual(n, 0) ThenBlock: {
            ReturnValue(0)
        }
        ImgBrush.lo = 0
        ImgBrush.hi = Add(n, 1)
        IfCondition GreaterThan(ImgBrush.hi, 4096) ThenBlock: {
            ImgBrush.hi = 4096
        }
        WhileLoop LessThan(Add(ImgBrush.lo, 1), ImgBrush.hi) {
            ImgBrush.mid = Divide(Add(ImgBrush.lo, ImgBrush.hi), 2)
            IfCondition LessEqual(Multiply(ImgBrush.mid, ImgBrush.mid), n) ThenBlock: {
                ImgBrush.lo = ImgBrush.mid
            }
            ElseBlock: {
                ImgBrush.hi = ImgBrush.mid
            }
        }
        ReturnValue(ImgBrush.lo)
    }
}

Function.ImgBrush_Begin {
    Body: {
        ImgBrush.armed = 0
    }
}

Function.ImgBrush_Set {
    Input: size: Integer
    Input: opacity: Integer
    Input: hardness: Integer
    Input: color: Integer
    Body: {
        ImgBrush.size = size
        IfCondition LessThan(ImgBrush.size, 1) ThenBlock: {
            ImgBrush.size = 1
        }
        IfCondition GreaterThan(ImgBrush.size, 128) ThenBlock: {
            ImgBrush.size = 128
        }
        ImgBrush.opacity = opacity
        ImgBrush.hardness = hardness
        ImgBrush.color = color
        ImgBrush.spacing = 25
    }
}

Function.ImgBrush_Stamp {
    Input: surf: Integer
    Input: x: Integer
    Input: y: Integer
    Body: {
        ImgBrush.surf = surf
        ImgBrush.cx = x
        ImgBrush.cy = y
        ImgBrush.r = Divide(ImgBrush.size, 2)
        IfCondition LessThan(ImgBrush.r, 1) ThenBlock: {
            ImgBrush.r = 1
        }
        ImgBrush.r2 = Multiply(ImgBrush.r, ImgBrush.r)
        ImgBrush.inner = Divide(Multiply(ImgBrush.r, ImgBrush.hardness), 255)
        ImgBrush.dy = Subtract(0, ImgBrush.r)
        WhileLoop LessEqual(ImgBrush.dy, ImgBrush.r) {
            ImgBrush.dx = Subtract(0, ImgBrush.r)
            WhileLoop LessEqual(ImgBrush.dx, ImgBrush.r) {
                ImgBrush.dist2 = Add(Multiply(ImgBrush.dx, ImgBrush.dx), Multiply(ImgBrush.dy, ImgBrush.dy))
                IfCondition LessThan(ImgBrush.dist2, ImgBrush.r2) ThenBlock: {
                    ImgBrush.a = 255
                    IfCondition And(NotEqual(ImgBrush.hardness, 255), GreaterThan(ImgBrush.dist2, Multiply(ImgBrush.inner, ImgBrush.inner))) ThenBlock: {
                        ImgBrush.d = ImgISqrt(ImgBrush.dist2)
                        ImgBrush.a = Subtract(ImgBrush.r, ImgBrush.d)
                        ImgBrush.d = Subtract(ImgBrush.r, ImgBrush.inner)
                        IfCondition LessThan(ImgBrush.d, 1) ThenBlock: {
                            ImgBrush.d = 1
                        }
                        ImgBrush.a = Divide(Multiply(255, ImgBrush.a), ImgBrush.d)
                    }
                    ImgBrush.a = Divide(Multiply(ImgBrush.a, ImgBrush.opacity), 255)
                    IfCondition GreaterThan(ImgBrush.a, 0) ThenBlock: {
                        ImgBrush.col = BitwiseAnd(ImgBrush.color, 16777215)
                        ImgBrush.col = BitwiseOr(ImgBrush.col, ShiftLeft(ImgBrush.a, 24))
                        ImgPixels_SrcOverPixel(ImgBrush.surf, Add(ImgBrush.cx, ImgBrush.dx), Add(ImgBrush.cy, ImgBrush.dy), ImgBrush.col)
                    }
                }
                ImgBrush.dx = Add(ImgBrush.dx, 1)
            }
            ImgBrush.dy = Add(ImgBrush.dy, 1)
        }
    }
}

Function.ImgBrush_StrokePoint {
    Input: surf: Integer
    Input: x: Integer
    Input: y: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(ImgBrush.armed, 0) ThenBlock: {
            ImgBrush_Stamp(surf, x, y)
            ImgBrush.lx = ImgBrush.cx
            ImgBrush.ly = ImgBrush.cy
            ImgBrush.armed = 1
            ReturnValue(1)
        }
        ImgBrush.dx = Subtract(x, ImgBrush.lx)
        ImgBrush.dy = Subtract(y, ImgBrush.ly)
        ImgBrush.dist2 = Add(Multiply(ImgBrush.dx, ImgBrush.dx), Multiply(ImgBrush.dy, ImgBrush.dy))
        ImgBrush.d = Divide(Multiply(ImgBrush.size, ImgBrush.spacing), 100)
        IfCondition LessThan(ImgBrush.d, 1) ThenBlock: {
            ImgBrush.d = 1
        }
        ImgBrush.space2 = Multiply(ImgBrush.d, ImgBrush.d)
        IfCondition LessThan(ImgBrush.dist2, ImgBrush.space2) ThenBlock: {
            ReturnValue(0)
        }
        ImgBrush_Stamp(surf, x, y)
        ImgBrush.lx = ImgBrush.cx
        ImgBrush.ly = ImgBrush.cy
        ReturnValue(1)
    }
}
