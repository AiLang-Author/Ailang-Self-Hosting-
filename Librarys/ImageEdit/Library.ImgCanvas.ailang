// Library.ImgCanvas.ailang
// ImageEdit facade: paper + dpi + PIXEL_32 canvas. Program kernel, not a display.x facility.
// P0 duplicates ImgPaper ids + SizePt (do not import DocLayout or AilangDoc — they pull Fonts).
// Copyright © 2026 Sean Collins, 2 Paws Machine and Engineering. SCSL.

LibraryImport.Display.Render.DSurfaceTypes
LibraryImport.Display.Render.DSurface
LibraryImport.Display.Render.DDrawPixel
LibraryImport.ImageEdit.ImgLayer
LibraryImport.ImageEdit.ImgPixels
LibraryImport.ImageEdit.ImgIO
LibraryImport.ImageEdit.ImgBrush
LibraryImport.ImageEdit.ImgSketch

FixedPool.ImgPaper {
    "LETTER":    Initialize=1
    "LEGAL":     Initialize=2
    "A4":        Initialize=3
    "A3":        Initialize=4
    "FREE":      Initialize=5
    "CUSTOM":    Initialize=6
    "PORTRAIT":  Initialize=0
    "LANDSCAPE": Initialize=1
}

FixedPool.ImgCnvConst {
    "REC_SIZE":      Initialize=128
    "MAX_CANVAS":    Initialize=8
    "MAX_DIM":       Initialize=4096
    "DEF_DPI":       Initialize=96
    "MIN_DPI":       Initialize=1
    "MAX_DPI":       Initialize=600
    "MAX_LAYER_PER": Initialize=16
}

FixedPool.ImgCnvField {
    "PAPER":   Initialize=0
    "ORIENT":  Initialize=8
    "DPI":     Initialize=16
    "PIX_W":   Initialize=24
    "PIX_H":   Initialize=32
    "PHYS_W":  Initialize=40
    "PHYS_H":  Initialize=48
    "BG":      Initialize=56
    "LAYERS":  Initialize=64
    "LAYER_N": Initialize=72
    "ACTIVE":  Initialize=80
    "DIRTY":   Initialize=88
    "FLAGS":   Initialize=96
    "UNDO":    Initialize=104
    "VIEW":    Initialize=112
    "GEN":     Initialize=120
}

FixedPool.ImgCnvFlag {
    "NAMED":      Initialize=1
    "FROM_FILE":  Initialize=2
    "HAS_STROKE": Initialize=4
}

FixedPool.ImgCnvTable {
    "data":      Initialize=0, CanChange=True
    "free_head": Initialize=-1, CanChange=True
    "used":      Initialize=0, CanChange=True
    "next":      Initialize=0, CanChange=True
}

FixedPool.ImgCnvMk {
    "paper":  Initialize=0, CanChange=True
    "orient": Initialize=0, CanChange=True
    "dpi":    Initialize=0, CanChange=True
    "pix_w":  Initialize=0, CanChange=True
    "pix_h":  Initialize=0, CanChange=True
    "phys_w": Initialize=0, CanChange=True
    "phys_h": Initialize=0, CanChange=True
    "flags":  Initialize=0, CanChange=True
    "bg":     Initialize=0, CanChange=True
    "idx":    Initialize=0, CanChange=True
    "gen":    Initialize=0, CanChange=True
    "p":      Initialize=0, CanChange=True
    "h":      Initialize=0, CanChange=True
    "lay":    Initialize=0, CanChange=True
    "arr":    Initialize=0, CanChange=True
    "surf":   Initialize=0, CanChange=True
    "maxpt":  Initialize=0, CanChange=True
    "field":  Initialize=0, CanChange=True
    "val":    Initialize=0, CanChange=True
    "i":      Initialize=0, CanChange=True
}

FixedPool.ImgHit {
    "cx": Initialize=0, CanChange=True
    "cy": Initialize=0, CanChange=True
    "ok": Initialize=0, CanChange=True
}

Function.ImgPaper_SizePt {
    Input: paper: Integer
    Input: orient: Integer
    Input: custom_w_pt: Integer
    Input: custom_h_pt: Integer
    Output: Integer
    Body: {
        ImgCnvOut.phys_w = 0
        ImgCnvOut.phys_h = 0
        IfCondition EqualTo(paper, ImgPaper.LETTER) ThenBlock: {
            ImgCnvOut.phys_w = 612
            ImgCnvOut.phys_h = 792
        }
        IfCondition EqualTo(paper, ImgPaper.LEGAL) ThenBlock: {
            ImgCnvOut.phys_w = 612
            ImgCnvOut.phys_h = 1008
        }
        IfCondition EqualTo(paper, ImgPaper.A4) ThenBlock: {
            ImgCnvOut.phys_w = 595
            ImgCnvOut.phys_h = 842
        }
        IfCondition EqualTo(paper, ImgPaper.A3) ThenBlock: {
            ImgCnvOut.phys_w = 842
            ImgCnvOut.phys_h = 1191
        }
        IfCondition EqualTo(paper, ImgPaper.CUSTOM) ThenBlock: {
            IfCondition Or(LessEqual(custom_w_pt, 0), LessEqual(custom_h_pt, 0)) ThenBlock: {
                ReturnValue(0)
            }
            ImgCnvOut.phys_w = custom_w_pt
            ImgCnvOut.phys_h = custom_h_pt
        }
        IfCondition EqualTo(ImgCnvOut.phys_w, 0) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition EqualTo(orient, ImgPaper.LANDSCAPE) ThenBlock: {
            ImgCnvMk.val = ImgCnvOut.phys_w
            ImgCnvOut.phys_w = ImgCnvOut.phys_h
            ImgCnvOut.phys_h = ImgCnvMk.val
        }
        ReturnValue(1)
    }
}

Function.ImgCanvas_Init {
    Output: Integer
    Body: {
        IfCondition NotEqual(ImgCnvTable.data, 0) ThenBlock: {
            ReturnValue(1)
        }
        ImgCnvMk.val = Multiply(ImgCnvConst.MAX_CANVAS, ImgCnvConst.REC_SIZE)
        ImgCnvTable.data = Allocate(ImgCnvMk.val)
        IfCondition EqualTo(ImgCnvTable.data, 0) ThenBlock: {
            PrintMessage("[ImgCanvas] data alloc fail\n")
            ReturnValue(0)
        }
        MemorySet(ImgCnvTable.data, 0, ImgCnvMk.val)
        ImgCnvTable.next = Allocate(Multiply(ImgCnvConst.MAX_CANVAS, 8))
        IfCondition EqualTo(ImgCnvTable.next, 0) ThenBlock: {
            PrintMessage("[ImgCanvas] next alloc fail\n")
            ReturnValue(0)
        }
        ImgCnvMk.i = 0
        WhileLoop LessThan(ImgCnvMk.i, Subtract(ImgCnvConst.MAX_CANVAS, 1)) {
            StoreValue(Add(ImgCnvTable.next, Multiply(ImgCnvMk.i, 8)), Add(ImgCnvMk.i, 1))
            ImgCnvMk.i = Add(ImgCnvMk.i, 1)
        }
        StoreValue(Add(ImgCnvTable.next, Multiply(Subtract(ImgCnvConst.MAX_CANVAS, 1), 8)), -1)
        ImgCnvTable.free_head = 0
        ImgCnvTable.used = 0
        IfCondition EqualTo(ImgLayer_Init(), 0) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition EqualTo(ImgSketch_Init(), 0) ThenBlock: {
            ReturnValue(0)
        }
        PrintMessage("[ImgCanvas] init ok\n")
        ReturnValue(1)
    }
}

Function.ImgCanvas_Ptr {
    Input: idx: Integer
    Output: Address
    Body: {
        ReturnValue(Add(ImgCnvTable.data, Multiply(idx, ImgCnvConst.REC_SIZE)))
    }
}

Function.ImgCanvas_LiveIdx {
    Input: h: Integer
    Output: Integer
    Body: {
        IfCondition LessEqual(h, 0) ThenBlock: {
            ReturnValue(-1)
        }
        IfCondition EqualTo(ImgCnvTable.data, 0) ThenBlock: {
            ReturnValue(-1)
        }
        ImgCnvMk.h = h
        ImgCnvMk.idx = BitwiseAnd(ImgCnvMk.h, 65535)
        ImgCnvMk.gen = ShiftRight(ImgCnvMk.h, 16)
        IfCondition GreaterEqual(ImgCnvMk.idx, ImgCnvConst.MAX_CANVAS) ThenBlock: {
            ReturnValue(-1)
        }
        ImgCnvMk.p = ImgCanvas_Ptr(ImgCnvMk.idx)
        ImgCnvMk.val = Dereference(Add(ImgCnvMk.p, ImgCnvField.GEN))
        IfCondition EqualTo(ImgCnvMk.val, 0) ThenBlock: {
            ReturnValue(-1)
        }
        IfCondition NotEqual(ImgCnvMk.val, ImgCnvMk.gen) ThenBlock: {
            ReturnValue(-1)
        }
        ReturnValue(ImgCnvMk.idx)
    }
}

Function.ImgCanvas_Get {
    Input: h: Integer
    Input: field: Integer
    Output: Integer
    Body: {
        ImgCnvMk.idx = ImgCanvas_LiveIdx(h)
        IfCondition LessThan(ImgCnvMk.idx, 0) ThenBlock: {
            ReturnValue(0)
        }
        ImgCnvMk.field = field
        ReturnValue(Dereference(Add(ImgCanvas_Ptr(ImgCnvMk.idx), ImgCnvMk.field)))
    }
}

Function.ImgCanvas_Set {
    Input: h: Integer
    Input: field: Integer
    Input: val: Integer
    Output: Integer
    Body: {
        ImgCnvMk.idx = ImgCanvas_LiveIdx(h)
        IfCondition LessThan(ImgCnvMk.idx, 0) ThenBlock: {
            ReturnValue(0)
        }
        ImgCnvMk.field = field
        ImgCnvMk.val = val
        IfCondition EqualTo(ImgCnvMk.field, ImgCnvField.BG) ThenBlock: {
            StoreValue(Add(ImgCanvas_Ptr(ImgCnvMk.idx), ImgCnvField.BG), ImgCnvMk.val)
            ReturnValue(1)
        }
        IfCondition EqualTo(ImgCnvMk.field, ImgCnvField.DIRTY) ThenBlock: {
            StoreValue(Add(ImgCanvas_Ptr(ImgCnvMk.idx), ImgCnvField.DIRTY), ImgCnvMk.val)
            ReturnValue(1)
        }
        IfCondition EqualTo(ImgCnvMk.field, ImgCnvField.ACTIVE) ThenBlock: {
            IfCondition Or(LessThan(ImgCnvMk.val, 0), GreaterEqual(ImgCnvMk.val, Dereference(Add(ImgCanvas_Ptr(ImgCnvMk.idx), ImgCnvField.LAYER_N)))) ThenBlock: {
                ReturnValue(0)
            }
            StoreValue(Add(ImgCanvas_Ptr(ImgCnvMk.idx), ImgCnvField.ACTIVE), ImgCnvMk.val)
            ReturnValue(1)
        }
        IfCondition EqualTo(ImgCnvMk.field, ImgCnvField.FLAGS) ThenBlock: {
            StoreValue(Add(ImgCanvas_Ptr(ImgCnvMk.idx), ImgCnvField.FLAGS), ImgCnvMk.val)
            ReturnValue(1)
        }
        ReturnValue(0)
    }
}

Function.ImgCanvas_SetView {
    Input: h: Integer
    Input: view: Integer
    Output: Integer
    Body: {
        ImgCnvMk.idx = ImgCanvas_LiveIdx(h)
        IfCondition LessThan(ImgCnvMk.idx, 0) ThenBlock: {
            ReturnValue(0)
        }
        StoreValue(Add(ImgCanvas_Ptr(ImgCnvMk.idx), ImgCnvField.VIEW), view)
        ReturnValue(1)
    }
}

Function.ImgCanvas_ActiveSurf {
    Input: h: Integer
    Output: Integer
    Body: {
        ImgCnvMk.idx = ImgCanvas_LiveIdx(h)
        IfCondition LessThan(ImgCnvMk.idx, 0) ThenBlock: {
            ReturnValue(0)
        }
        ImgCnvMk.p = ImgCanvas_Ptr(ImgCnvMk.idx)
        ImgCnvMk.arr = Dereference(Add(ImgCnvMk.p, ImgCnvField.LAYERS))
        IfCondition EqualTo(ImgCnvMk.arr, 0) ThenBlock: {
            ReturnValue(0)
        }
        ImgCnvMk.val = Dereference(Add(ImgCnvMk.p, ImgCnvField.ACTIVE))
        ImgCnvMk.lay = Dereference(Add(ImgCnvMk.arr, Multiply(ImgCnvMk.val, 8)))
        ReturnValue(ImgLayer_GetSurf(ImgCnvMk.lay))
    }
}

Function.ImgCanvas_Mk {
    Output: Integer
    Body: {
        IfCondition EqualTo(ImgCnvTable.data, 0) ThenBlock: {
            IfCondition EqualTo(ImgCanvas_Init(), 0) ThenBlock: {
                ReturnValue(-1)
            }
        }
        IfCondition LessThan(ImgCnvTable.free_head, 0) ThenBlock: {
            PrintMessage("[ImgCanvas] table full\n")
            ReturnValue(-1)
        }
        IfCondition Or(LessThan(ImgCnvMk.pix_w, 1), LessThan(ImgCnvMk.pix_h, 1)) ThenBlock: {
            ReturnValue(-1)
        }
        IfCondition Or(GreaterThan(ImgCnvMk.pix_w, ImgCnvConst.MAX_DIM), GreaterThan(ImgCnvMk.pix_h, ImgCnvConst.MAX_DIM)) ThenBlock: {
            ReturnValue(-1)
        }
        IfCondition Or(GreaterThan(ImgCnvMk.pix_w, SurfaceConst.MAX_WIDTH), GreaterThan(ImgCnvMk.pix_h, SurfaceConst.MAX_HEIGHT)) ThenBlock: {
            ReturnValue(-1)
        }
        ImgCnvMk.idx = ImgCnvTable.free_head
        ImgCnvTable.free_head = Dereference(Add(ImgCnvTable.next, Multiply(ImgCnvMk.idx, 8)))
        ImgCnvMk.p = ImgCanvas_Ptr(ImgCnvMk.idx)
        ImgCnvMk.gen = Dereference(Add(ImgCnvMk.p, ImgCnvField.GEN))
        MemorySet(ImgCnvMk.p, 0, ImgCnvConst.REC_SIZE)
        ImgCnvMk.arr = Allocate(Multiply(ImgCnvConst.MAX_LAYER_PER, 8))
        IfCondition EqualTo(ImgCnvMk.arr, 0) ThenBlock: {
            StoreValue(Add(ImgCnvTable.next, Multiply(ImgCnvMk.idx, 8)), ImgCnvTable.free_head)
            ImgCnvTable.free_head = ImgCnvMk.idx
            ReturnValue(-1)
        }
        MemorySet(ImgCnvMk.arr, 0, Multiply(ImgCnvConst.MAX_LAYER_PER, 8))
        StoreValue(Add(ImgCnvMk.p, ImgCnvField.PAPER), ImgCnvMk.paper)
        StoreValue(Add(ImgCnvMk.p, ImgCnvField.ORIENT), ImgCnvMk.orient)
        StoreValue(Add(ImgCnvMk.p, ImgCnvField.DPI), ImgCnvMk.dpi)
        StoreValue(Add(ImgCnvMk.p, ImgCnvField.PIX_W), ImgCnvMk.pix_w)
        StoreValue(Add(ImgCnvMk.p, ImgCnvField.PIX_H), ImgCnvMk.pix_h)
        StoreValue(Add(ImgCnvMk.p, ImgCnvField.PHYS_W), ImgCnvMk.phys_w)
        StoreValue(Add(ImgCnvMk.p, ImgCnvField.PHYS_H), ImgCnvMk.phys_h)
        StoreValue(Add(ImgCnvMk.p, ImgCnvField.BG), ImgCnvMk.bg)
        StoreValue(Add(ImgCnvMk.p, ImgCnvField.LAYERS), ImgCnvMk.arr)
        StoreValue(Add(ImgCnvMk.p, ImgCnvField.LAYER_N), 1)
        StoreValue(Add(ImgCnvMk.p, ImgCnvField.ACTIVE), 0)
        StoreValue(Add(ImgCnvMk.p, ImgCnvField.DIRTY), 1)
        StoreValue(Add(ImgCnvMk.p, ImgCnvField.FLAGS), ImgCnvMk.flags)
        StoreValue(Add(ImgCnvMk.p, ImgCnvField.UNDO), 0)
        StoreValue(Add(ImgCnvMk.p, ImgCnvField.VIEW), 0)
        ImgCnvMk.gen = Add(ImgCnvMk.gen, 1)
        IfCondition EqualTo(ImgCnvMk.gen, 0) ThenBlock: {
            ImgCnvMk.gen = 1
        }
        StoreValue(Add(ImgCnvMk.p, ImgCnvField.GEN), ImgCnvMk.gen)
        ImgCnvMk.h = BitwiseOr(ImgCnvMk.idx, ShiftLeft(ImgCnvMk.gen, 16))
        ImgCnvMk.lay = ImgLayer_Alloc(ImgCnvMk.h, ImgCnvMk.pix_w, ImgCnvMk.pix_h)
        IfCondition LessThan(ImgCnvMk.lay, 0) ThenBlock: {
            Deallocate(ImgCnvMk.arr, Multiply(ImgCnvConst.MAX_LAYER_PER, 8))
            MemorySet(ImgCnvMk.p, 0, ImgCnvConst.REC_SIZE)
            StoreValue(Add(ImgCnvTable.next, Multiply(ImgCnvMk.idx, 8)), ImgCnvTable.free_head)
            ImgCnvTable.free_head = ImgCnvMk.idx
            ReturnValue(-1)
        }
        StoreValue(ImgCnvMk.arr, ImgCnvMk.lay)
        ImgCnvMk.surf = ImgLayer_GetSurf(ImgCnvMk.lay)
        ImgPixels_Fill(ImgCnvMk.surf, 0, 0, ImgCnvMk.pix_w, ImgCnvMk.pix_h, ImgCnvMk.bg)
        ImgCnvTable.used = Add(ImgCnvTable.used, 1)
        ReturnValue(ImgCnvMk.h)
    }
}

Function.ImgCanvas_PxOk {
    Input: dpi: Integer
    Input: phys_w: Integer
    Input: phys_h: Integer
    Output: Integer
    Body: {
        IfCondition Or(LessThan(dpi, ImgCnvConst.MIN_DPI), GreaterThan(dpi, ImgCnvConst.MAX_DPI)) ThenBlock: {
            ReturnValue(0)
        }
        ImgCnvMk.maxpt = Divide(Multiply(ImgCnvConst.MAX_DIM, 72), dpi)
        IfCondition GreaterThan(phys_w, ImgCnvMk.maxpt) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition GreaterThan(phys_h, ImgCnvMk.maxpt) ThenBlock: {
            ReturnValue(0)
        }
        ReturnValue(1)
    }
}

Function.ImgCanvas_CreatePaper {
    Input: paper: Integer
    Input: orient: Integer
    Input: dpi: Integer
    Output: Integer
    Body: {
        IfCondition Or(EqualTo(paper, ImgPaper.FREE), EqualTo(paper, ImgPaper.CUSTOM)) ThenBlock: {
            ReturnValue(-1)
        }
        ImgCnvMk.dpi = dpi
        IfCondition EqualTo(ImgCnvMk.dpi, 0) ThenBlock: {
            ImgCnvMk.dpi = ImgCnvConst.DEF_DPI
        }
        IfCondition EqualTo(ImgPaper_SizePt(paper, orient, 0, 0), 0) ThenBlock: {
            ReturnValue(-1)
        }
        ImgCnvMk.phys_w = ImgCnvOut.phys_w
        ImgCnvMk.phys_h = ImgCnvOut.phys_h
        IfCondition EqualTo(ImgCanvas_PxOk(ImgCnvMk.dpi, ImgCnvMk.phys_w, ImgCnvMk.phys_h), 0) ThenBlock: {
            ReturnValue(-1)
        }
        ImgCnvMk.pix_w = Divide(Multiply(ImgCnvMk.phys_w, ImgCnvMk.dpi), 72)
        ImgCnvMk.pix_h = Divide(Multiply(ImgCnvMk.phys_h, ImgCnvMk.dpi), 72)
        ImgCnvOut.pix_w = ImgCnvMk.pix_w
        ImgCnvOut.pix_h = ImgCnvMk.pix_h
        ImgCnvMk.paper = paper
        ImgCnvMk.orient = orient
        ImgCnvMk.flags = ImgCnvFlag.NAMED
        ImgCnvMk.bg = 0xFFFFFFFF
        ReturnValue(ImgCanvas_Mk())
    }
}

Function.ImgCanvas_CreateCustom {
    Input: w_pt: Integer
    Input: h_pt: Integer
    Input: orient: Integer
    Input: dpi: Integer
    Output: Integer
    Body: {
        ImgCnvMk.dpi = dpi
        IfCondition EqualTo(ImgCnvMk.dpi, 0) ThenBlock: {
            ImgCnvMk.dpi = ImgCnvConst.DEF_DPI
        }
        IfCondition EqualTo(ImgPaper_SizePt(ImgPaper.CUSTOM, orient, w_pt, h_pt), 0) ThenBlock: {
            ReturnValue(-1)
        }
        ImgCnvMk.phys_w = ImgCnvOut.phys_w
        ImgCnvMk.phys_h = ImgCnvOut.phys_h
        IfCondition EqualTo(ImgCanvas_PxOk(ImgCnvMk.dpi, ImgCnvMk.phys_w, ImgCnvMk.phys_h), 0) ThenBlock: {
            ReturnValue(-1)
        }
        ImgCnvMk.pix_w = Divide(Multiply(ImgCnvMk.phys_w, ImgCnvMk.dpi), 72)
        ImgCnvMk.pix_h = Divide(Multiply(ImgCnvMk.phys_h, ImgCnvMk.dpi), 72)
        ImgCnvOut.pix_w = ImgCnvMk.pix_w
        ImgCnvOut.pix_h = ImgCnvMk.pix_h
        ImgCnvMk.paper = ImgPaper.CUSTOM
        ImgCnvMk.orient = orient
        ImgCnvMk.flags = ImgCnvFlag.NAMED
        ImgCnvMk.bg = 0xFFFFFFFF
        ReturnValue(ImgCanvas_Mk())
    }
}

Function.ImgCanvas_CreateFree {
    Input: pix_w: Integer
    Input: pix_h: Integer
    Input: dpi: Integer
    Output: Integer
    Body: {
        ImgCnvMk.dpi = dpi
        IfCondition EqualTo(ImgCnvMk.dpi, 0) ThenBlock: {
            ImgCnvMk.dpi = ImgCnvConst.DEF_DPI
        }
        IfCondition Or(LessThan(ImgCnvMk.dpi, ImgCnvConst.MIN_DPI), GreaterThan(ImgCnvMk.dpi, ImgCnvConst.MAX_DPI)) ThenBlock: {
            ReturnValue(-1)
        }
        ImgCnvMk.pix_w = pix_w
        ImgCnvMk.pix_h = pix_h
        ImgCnvMk.phys_w = Divide(Multiply(pix_w, 72), ImgCnvMk.dpi)
        ImgCnvMk.phys_h = Divide(Multiply(pix_h, 72), ImgCnvMk.dpi)
        ImgCnvOut.pix_w = ImgCnvMk.pix_w
        ImgCnvOut.pix_h = ImgCnvMk.pix_h
        ImgCnvOut.phys_w = ImgCnvMk.phys_w
        ImgCnvOut.phys_h = ImgCnvMk.phys_h
        ImgCnvMk.paper = ImgPaper.FREE
        ImgCnvMk.orient = ImgPaper.PORTRAIT
        ImgCnvMk.flags = 0
        ImgCnvMk.bg = 0xFFFFFFFF
        ReturnValue(ImgCanvas_Mk())
    }
}

Function.ImgCanvas_Destroy {
    Input: h: Integer
    Body: {
        ImgCnvMk.idx = ImgCanvas_LiveIdx(h)
        IfCondition LessThan(ImgCnvMk.idx, 0) ThenBlock: {
            ReturnValue(0)
        }
        ImgCnvMk.p = ImgCanvas_Ptr(ImgCnvMk.idx)
        ImgCnvMk.arr = Dereference(Add(ImgCnvMk.p, ImgCnvField.LAYERS))
        ImgCnvMk.val = Dereference(Add(ImgCnvMk.p, ImgCnvField.LAYER_N))
        ImgCnvMk.i = 0
        WhileLoop LessThan(ImgCnvMk.i, ImgCnvMk.val) {
            IfCondition NotEqual(ImgCnvMk.arr, 0) ThenBlock: {
                ImgCnvMk.lay = Dereference(Add(ImgCnvMk.arr, Multiply(ImgCnvMk.i, 8)))
                IfCondition GreaterThan(ImgCnvMk.lay, 0) ThenBlock: {
                    ImgLayer_Destroy(ImgCnvMk.lay)
                }
            }
            ImgCnvMk.i = Add(ImgCnvMk.i, 1)
        }
        IfCondition NotEqual(ImgCnvMk.arr, 0) ThenBlock: {
            Deallocate(ImgCnvMk.arr, Multiply(ImgCnvConst.MAX_LAYER_PER, 8))
        }
        ImgCnvMk.gen = Dereference(Add(ImgCnvMk.p, ImgCnvField.GEN))
        ImgCnvMk.gen = Add(ImgCnvMk.gen, 1)
        IfCondition EqualTo(ImgCnvMk.gen, 0) ThenBlock: {
            ImgCnvMk.gen = 1
        }
        MemorySet(ImgCnvMk.p, 0, ImgCnvConst.REC_SIZE)
        StoreValue(Add(ImgCnvMk.p, ImgCnvField.GEN), ImgCnvMk.gen)
        StoreValue(Add(ImgCnvTable.next, Multiply(ImgCnvMk.idx, 8)), ImgCnvTable.free_head)
        ImgCnvTable.free_head = ImgCnvMk.idx
        ImgCnvTable.used = Subtract(ImgCnvTable.used, 1)
    }
}

Function.ImgCanvas_SetDpi {
    Input: h: Integer
    Input: dpi: Integer
    Output: Integer
    Body: {
        IfCondition Or(LessThan(dpi, ImgCnvConst.MIN_DPI), GreaterThan(dpi, ImgCnvConst.MAX_DPI)) ThenBlock: {
            ReturnValue(0)
        }
        ImgCnvMk.idx = ImgCanvas_LiveIdx(h)
        IfCondition LessThan(ImgCnvMk.idx, 0) ThenBlock: {
            ReturnValue(0)
        }
        ImgCnvMk.p = ImgCanvas_Ptr(ImgCnvMk.idx)
        ImgCnvMk.dpi = dpi
        ImgCnvMk.pix_w = Dereference(Add(ImgCnvMk.p, ImgCnvField.PIX_W))
        ImgCnvMk.pix_h = Dereference(Add(ImgCnvMk.p, ImgCnvField.PIX_H))
        StoreValue(Add(ImgCnvMk.p, ImgCnvField.DPI), ImgCnvMk.dpi)
        StoreValue(Add(ImgCnvMk.p, ImgCnvField.PHYS_W), Divide(Multiply(ImgCnvMk.pix_w, 72), ImgCnvMk.dpi))
        StoreValue(Add(ImgCnvMk.p, ImgCnvField.PHYS_H), Divide(Multiply(ImgCnvMk.pix_h, 72), ImgCnvMk.dpi))
        StoreValue(Add(ImgCnvMk.p, ImgCnvField.PAPER), ImgPaper.FREE)
        ImgCnvMk.flags = Dereference(Add(ImgCnvMk.p, ImgCnvField.FLAGS))
        IfCondition EqualTo(BitwiseAnd(ImgCnvMk.flags, ImgCnvFlag.NAMED), ImgCnvFlag.NAMED) ThenBlock: {
            StoreValue(Add(ImgCnvMk.p, ImgCnvField.FLAGS), Subtract(ImgCnvMk.flags, ImgCnvFlag.NAMED))
        }
        ReturnValue(1)
    }
}

Function.ImgIO_SaveBMP {
    Input: h: Integer
    Input: path: Address
    Output: Integer
    Body: {
        ImgCnvMk.surf = ImgCanvas_ActiveSurf(h)
        IfCondition EqualTo(ImgCnvMk.surf, 0) ThenBlock: {
            ReturnValue(0)
        }
        ReturnValue(ImgIO_WriteSurfBMP(ImgCnvMk.surf, path))
    }
}

Function.ImgIO_LoadBMPBytes {
    Input: buf: Address
    Input: n: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(ImgIO_PeekDim(buf, n), 0) ThenBlock: {
            ReturnValue(-1)
        }
        ImgCnvMk.h = ImgCanvas_CreateFree(ImgCnvOut.pix_w, ImgCnvOut.pix_h, 96)
        IfCondition LessThan(ImgCnvMk.h, 0) ThenBlock: {
            ReturnValue(-1)
        }
        ImgCnvMk.surf = ImgCanvas_ActiveSurf(ImgCnvMk.h)
        IfCondition EqualTo(ImgIO_BlitBMP(buf, n, ImgCnvMk.surf), 0) ThenBlock: {
            ImgCanvas_Destroy(ImgCnvMk.h)
            ReturnValue(-1)
        }
        ImgCanvas_Set(ImgCnvMk.h, ImgCnvField.FLAGS, ImgCnvFlag.FROM_FILE)
        ReturnValue(ImgCnvMk.h)
    }
}

Function.ImgIO_LoadBMP {
    Input: path: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(ImgIO_ReadPath(path, ImgIOCap.BMP), 0) ThenBlock: {
            ReturnValue(-1)
        }
        ImgCnvMk.h = ImgIO_LoadBMPBytes(ImgIO.buf, ImgIO.len)
        Deallocate(ImgIO.buf, ImgIO.len)
        ImgIO.buf = 0
        ReturnValue(ImgCnvMk.h)
    }
}
