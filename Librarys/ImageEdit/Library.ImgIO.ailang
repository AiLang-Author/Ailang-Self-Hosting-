// Library.ImgIO.ailang
// P0: BMP peek / write-from-surface / blit-to-surface / path read.
// Canvas wrappers (SaveBMP/LoadBMP) live on the ImgCanvas facade (no import cycle).
// BMP is flatten-opaque. Copyright © 2026 Sean Collins, 2 Paws Machine and Engineering. SCSL.

LibraryImport.Display.Render.DSurfaceTypes
LibraryImport.Display.Render.DSurface
LibraryImport.Display.Render.DDrawPixel

FixedPool.ImgIOCap {
    "BMP":  Initialize=67108864
    "JPEG": Initialize=16777216
}

FixedPool.ImgIO {
    "buf":     Initialize=0, CanChange=True
    "len":     Initialize=0, CanChange=True
    "fd":      Initialize=0, CanChange=True
    "w":       Initialize=0, CanChange=True
    "h":       Initialize=0, CanChange=True
    "off":     Initialize=0, CanChange=True
    "stride":  Initialize=0, CanChange=True
    "rowb":    Initialize=0, CanChange=True
    "pad":     Initialize=0, CanChange=True
    "topdown": Initialize=0, CanChange=True
    "bits":    Initialize=0, CanChange=True
    "comp":    Initialize=0, CanChange=True
    "got":     Initialize=0, CanChange=True
    "need":    Initialize=0, CanChange=True
    "hdr":     Initialize=0, CanChange=True
    "row":     Initialize=0, CanChange=True
    "y":       Initialize=0, CanChange=True
    "x":       Initialize=0, CanChange=True
    "src":     Initialize=0, CanChange=True
    "dst":     Initialize=0, CanChange=True
    "pitch":   Initialize=0, CanChange=True
    "data":    Initialize=0, CanChange=True
    "si":      Initialize=0, CanChange=True
    "di":      Initialize=0, CanChange=True
    "v":       Initialize=0, CanChange=True
}

FixedPool.ImgCnvOut {
    "pix_w":  Initialize=0, CanChange=True
    "pix_h":  Initialize=0, CanChange=True
    "phys_w": Initialize=0, CanChange=True
    "phys_h": Initialize=0, CanChange=True
}

Function.ImgIO_ReadI32LE {
    Input: buf: Address
    Input: off: Integer
    Output: Integer
    Body: {
        ImgIO.v = GetByte(buf, off)
        ImgIO.v = Add(ImgIO.v, ShiftLeft(GetByte(buf, Add(off, 1)), 8))
        ImgIO.v = Add(ImgIO.v, ShiftLeft(GetByte(buf, Add(off, 2)), 16))
        ImgIO.v = Add(ImgIO.v, ShiftLeft(GetByte(buf, Add(off, 3)), 24))
        IfCondition GreaterEqual(GetByte(buf, Add(off, 3)), 128) ThenBlock: {
            ImgIO.v = Subtract(ImgIO.v, 4294967296)
        }
        ReturnValue(ImgIO.v)
    }
}

Function.ImgIO_ReadU16LE {
    Input: buf: Address
    Input: off: Integer
    Output: Integer
    Body: {
        ReturnValue(Add(GetByte(buf, off), ShiftLeft(GetByte(buf, Add(off, 1)), 8)))
    }
}

Function.ImgIO_WriteLE16 {
    Input: buf: Address
    Input: off: Integer
    Input: val: Integer
    Body: {
        SetByte(buf, off, BitwiseAnd(val, 255))
        SetByte(buf, Add(off, 1), BitwiseAnd(ShiftRight(val, 8), 255))
    }
}

Function.ImgIO_WriteLE32 {
    Input: buf: Address
    Input: off: Integer
    Input: val: Integer
    Body: {
        SetByte(buf, off, BitwiseAnd(val, 255))
        SetByte(buf, Add(off, 1), BitwiseAnd(ShiftRight(val, 8), 255))
        SetByte(buf, Add(off, 2), BitwiseAnd(ShiftRight(val, 16), 255))
        SetByte(buf, Add(off, 3), BitwiseAnd(ShiftRight(val, 24), 255))
    }
}

Function.ImgIO_Abs {
    Input: n: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(n, 0) ThenBlock: {
            ReturnValue(Subtract(0, n))
        }
        ReturnValue(n)
    }
}

Function.ImgIO_PeekDim {
    Input: buf: Address
    Input: n: Integer
    Output: Integer
    Body: {
        IfCondition Or(EqualTo(buf, 0), LessThan(n, 26)) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition And(EqualTo(GetByte(buf, 0), 66), EqualTo(GetByte(buf, 1), 77)) ThenBlock: {
            ImgIO.w = ImgIO_ReadI32LE(buf, 18)
            ImgIO.w = ImgIO_Abs(ImgIO.w)
            ImgIO.h = ImgIO_ReadI32LE(buf, 22)
            ImgIO.h = ImgIO_Abs(ImgIO.h)
            IfCondition Or(LessThan(ImgIO.w, 1), LessThan(ImgIO.h, 1)) ThenBlock: {
                ReturnValue(0)
            }
            IfCondition Or(GreaterThan(ImgIO.w, 4096), GreaterThan(ImgIO.h, 4096)) ThenBlock: {
                ReturnValue(0)
            }
            ImgCnvOut.pix_w = ImgIO.w
            ImgCnvOut.pix_h = ImgIO.h
            ReturnValue(1)
        }
        ReturnValue(0)
    }
}

Function.ImgIO_WriteSurfBMP {
    Input: surf: Integer
    Input: path: Address
    Output: Integer
    Body: {
        IfCondition Or(EqualTo(surf, 0), EqualTo(path, 0)) ThenBlock: {
            ReturnValue(0)
        }
        ImgIO.w = Surface_GetWidth(surf)
        ImgIO.h = Surface_GetHeight(surf)
        ImgIO.data = Surface_GetData(surf)
        ImgIO.pitch = Surface_GetPitch(surf)
        IfCondition Or(EqualTo(ImgIO.data, 0), Or(LessThan(ImgIO.w, 1), LessThan(ImgIO.h, 1))) ThenBlock: {
            ReturnValue(0)
        }
        ImgIO.rowb = Multiply(ImgIO.w, 3)
        ImgIO.pad = Modulo(ImgIO.rowb, 4)
        IfCondition NotEqual(ImgIO.pad, 0) ThenBlock: {
            ImgIO.pad = Subtract(4, ImgIO.pad)
        }
        ImgIO.stride = Add(ImgIO.rowb, ImgIO.pad)
        ImgIO.need = Add(54, Multiply(ImgIO.stride, ImgIO.h))
        IfCondition GreaterThan(ImgIO.need, ImgIOCap.BMP) ThenBlock: {
            PrintMessage("[ImgIO] BMP too large to write\n")
            ReturnValue(0)
        }
        ImgIO.fd = SystemCall(2, path, 577, 420)
        IfCondition LessThan(ImgIO.fd, 0) ThenBlock: {
            PrintMessage("[ImgIO] open write fail\n")
            ReturnValue(0)
        }
        ImgIO.hdr = Allocate(64)
        IfCondition EqualTo(ImgIO.hdr, 0) ThenBlock: {
            SystemCall(3, ImgIO.fd)
            ReturnValue(0)
        }
        MemorySet(ImgIO.hdr, 0, 54)
        SetByte(ImgIO.hdr, 0, 66)
        SetByte(ImgIO.hdr, 1, 77)
        ImgIO_WriteLE32(ImgIO.hdr, 2, ImgIO.need)
        ImgIO_WriteLE32(ImgIO.hdr, 10, 54)
        ImgIO_WriteLE32(ImgIO.hdr, 14, 40)
        ImgIO_WriteLE32(ImgIO.hdr, 18, ImgIO.w)
        ImgIO_WriteLE32(ImgIO.hdr, 22, ImgIO.h)
        ImgIO_WriteLE16(ImgIO.hdr, 26, 1)
        ImgIO_WriteLE16(ImgIO.hdr, 28, 24)
        ImgIO_WriteLE32(ImgIO.hdr, 34, Multiply(ImgIO.stride, ImgIO.h))
        SystemCall(1, ImgIO.fd, ImgIO.hdr, 54)
        Deallocate(ImgIO.hdr, 64)
        ImgIO.row = Allocate(Add(ImgIO.stride, 8))
        IfCondition EqualTo(ImgIO.row, 0) ThenBlock: {
            SystemCall(3, ImgIO.fd)
            ReturnValue(0)
        }
        ImgIO.y = Subtract(ImgIO.h, 1)
        WhileLoop GreaterEqual(ImgIO.y, 0) {
            ImgIO.src = Add(ImgIO.data, Multiply(ImgIO.y, ImgIO.pitch))
            ImgIO.x = 0
            WhileLoop LessThan(ImgIO.x, ImgIO.w) {
                ImgIO.si = Multiply(ImgIO.x, 4)
                ImgIO.di = Multiply(ImgIO.x, 3)
                SetByte(ImgIO.row, ImgIO.di, GetByte(ImgIO.src, ImgIO.si))
                SetByte(ImgIO.row, Add(ImgIO.di, 1), GetByte(ImgIO.src, Add(ImgIO.si, 1)))
                SetByte(ImgIO.row, Add(ImgIO.di, 2), GetByte(ImgIO.src, Add(ImgIO.si, 2)))
                ImgIO.x = Add(ImgIO.x, 1)
            }
            ImgIO.x = 0
            WhileLoop LessThan(ImgIO.x, ImgIO.pad) {
                SetByte(ImgIO.row, Add(ImgIO.rowb, ImgIO.x), 0)
                ImgIO.x = Add(ImgIO.x, 1)
            }
            SystemCall(1, ImgIO.fd, ImgIO.row, ImgIO.stride)
            ImgIO.y = Subtract(ImgIO.y, 1)
        }
        Deallocate(ImgIO.row, Add(ImgIO.stride, 8))
        SystemCall(3, ImgIO.fd)
        ReturnValue(1)
    }
}

Function.ImgIO_BlitBMP {
    Input: buf: Address
    Input: n: Integer
    Input: surf: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(ImgIO_PeekDim(buf, n), 0) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition NotEqual(Surface_GetWidth(surf), ImgCnvOut.pix_w) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition NotEqual(Surface_GetHeight(surf), ImgCnvOut.pix_h) ThenBlock: {
            ReturnValue(0)
        }
        ImgIO.bits = ImgIO_ReadU16LE(buf, 28)
        ImgIO.comp = ImgIO_ReadI32LE(buf, 30)
        IfCondition NotEqual(ImgIO.bits, 24) ThenBlock: {
            PrintMessage("[ImgIO] BMP not 24-bit\n")
            ReturnValue(0)
        }
        IfCondition NotEqual(ImgIO.comp, 0) ThenBlock: {
            PrintMessage("[ImgIO] BMP compressed\n")
            ReturnValue(0)
        }
        ImgIO.off = ImgIO_ReadI32LE(buf, 10)
        IfCondition LessThan(ImgIO.off, 54) ThenBlock: {
            ReturnValue(0)
        }
        ImgIO.w = ImgCnvOut.pix_w
        ImgIO.h = ImgCnvOut.pix_h
        ImgIO.topdown = 0
        IfCondition LessThan(ImgIO_ReadI32LE(buf, 22), 0) ThenBlock: {
            ImgIO.topdown = 1
        }
        ImgIO.rowb = Multiply(ImgIO.w, 3)
        ImgIO.pad = Modulo(ImgIO.rowb, 4)
        IfCondition NotEqual(ImgIO.pad, 0) ThenBlock: {
            ImgIO.pad = Subtract(4, ImgIO.pad)
        }
        ImgIO.stride = Add(ImgIO.rowb, ImgIO.pad)
        ImgIO.need = Add(ImgIO.off, Multiply(ImgIO.stride, ImgIO.h))
        IfCondition GreaterThan(ImgIO.need, n) ThenBlock: {
            PrintMessage("[ImgIO] BMP truncated\n")
            ReturnValue(0)
        }
        ImgIO.data = Surface_GetData(surf)
        ImgIO.pitch = Surface_GetPitch(surf)
        ImgIO.y = 0
        WhileLoop LessThan(ImgIO.y, ImgIO.h) {
            IfCondition EqualTo(ImgIO.topdown, 1) ThenBlock: {
                ImgIO.row = ImgIO.y
            }
            ElseBlock: {
                ImgIO.row = Subtract(Subtract(ImgIO.h, 1), ImgIO.y)
            }
            ImgIO.src = Add(buf, Add(ImgIO.off, Multiply(ImgIO.y, ImgIO.stride)))
            ImgIO.dst = Add(ImgIO.data, Multiply(ImgIO.row, ImgIO.pitch))
            ImgIO.x = 0
            WhileLoop LessThan(ImgIO.x, ImgIO.w) {
                ImgIO.si = Multiply(ImgIO.x, 3)
                ImgIO.di = Multiply(ImgIO.x, 4)
                SetByte(ImgIO.dst, ImgIO.di, GetByte(ImgIO.src, ImgIO.si))
                SetByte(ImgIO.dst, Add(ImgIO.di, 1), GetByte(ImgIO.src, Add(ImgIO.si, 1)))
                SetByte(ImgIO.dst, Add(ImgIO.di, 2), GetByte(ImgIO.src, Add(ImgIO.si, 2)))
                SetByte(ImgIO.dst, Add(ImgIO.di, 3), 255)
                ImgIO.x = Add(ImgIO.x, 1)
            }
            ImgIO.y = Add(ImgIO.y, 1)
        }
        ReturnValue(1)
    }
}

Function.ImgIO_ReadPath {
    Input: path: Address
    Input: cap: Integer
    Output: Integer
    Body: {
        IfCondition Or(EqualTo(path, 0), LessEqual(cap, 0)) ThenBlock: {
            ReturnValue(0)
        }
        ImgIO.fd = SystemCall(2, path, 0, 0)
        IfCondition LessThan(ImgIO.fd, 0) ThenBlock: {
            PrintMessage("[ImgIO] open read fail\n")
            ReturnValue(0)
        }
        ImgIO.hdr = Allocate(54)
        IfCondition EqualTo(ImgIO.hdr, 0) ThenBlock: {
            SystemCall(3, ImgIO.fd)
            ReturnValue(0)
        }
        ImgIO.got = SystemCall(0, ImgIO.fd, ImgIO.hdr, 54)
        IfCondition LessThan(ImgIO.got, 26) ThenBlock: {
            Deallocate(ImgIO.hdr, 54)
            SystemCall(3, ImgIO.fd)
            ReturnValue(0)
        }
        IfCondition EqualTo(ImgIO_PeekDim(ImgIO.hdr, ImgIO.got), 0) ThenBlock: {
            Deallocate(ImgIO.hdr, 54)
            SystemCall(3, ImgIO.fd)
            ReturnValue(0)
        }
        ImgIO.w = ImgCnvOut.pix_w
        ImgIO.h = ImgCnvOut.pix_h
        ImgIO.off = 54
        IfCondition GreaterEqual(ImgIO.got, 54) ThenBlock: {
            ImgIO.off = ImgIO_ReadI32LE(ImgIO.hdr, 10)
            IfCondition LessThan(ImgIO.off, 54) ThenBlock: {
                ImgIO.off = 54
            }
        }
        ImgIO.rowb = Multiply(ImgIO.w, 3)
        ImgIO.pad = Modulo(ImgIO.rowb, 4)
        IfCondition NotEqual(ImgIO.pad, 0) ThenBlock: {
            ImgIO.pad = Subtract(4, ImgIO.pad)
        }
        ImgIO.stride = Add(ImgIO.rowb, ImgIO.pad)
        ImgIO.need = Add(ImgIO.off, Multiply(ImgIO.stride, ImgIO.h))
        IfCondition GreaterThan(ImgIO.need, cap) ThenBlock: {
            PrintMessage("[ImgIO] file exceeds cap\n")
            Deallocate(ImgIO.hdr, 54)
            SystemCall(3, ImgIO.fd)
            ReturnValue(0)
        }
        ImgIO.buf = Allocate(ImgIO.need)
        IfCondition EqualTo(ImgIO.buf, 0) ThenBlock: {
            Deallocate(ImgIO.hdr, 54)
            SystemCall(3, ImgIO.fd)
            ReturnValue(0)
        }
        MemoryCopy(ImgIO.buf, ImgIO.hdr, ImgIO.got)
        Deallocate(ImgIO.hdr, 54)
        WhileLoop LessThan(ImgIO.got, ImgIO.need) {
            ImgIO.v = SystemCall(0, ImgIO.fd, Add(ImgIO.buf, ImgIO.got), Subtract(ImgIO.need, ImgIO.got))
            IfCondition LessEqual(ImgIO.v, 0) ThenBlock: {
                Deallocate(ImgIO.buf, ImgIO.need)
                ImgIO.buf = 0
                SystemCall(3, ImgIO.fd)
                ReturnValue(0)
            }
            ImgIO.got = Add(ImgIO.got, ImgIO.v)
        }
        SystemCall(3, ImgIO.fd)
        ImgIO.len = ImgIO.need
        ReturnValue(1)
    }
}
