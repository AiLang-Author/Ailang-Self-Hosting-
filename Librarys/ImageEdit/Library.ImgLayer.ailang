// Library.ImgLayer.ailang
// PIXEL_32 layer pool for ImageEdit. Recycled slots. v1: one layer per canvas.
// Copyright © 2026 Sean Collins, 2 Paws Machine and Engineering. SCSL.

LibraryImport.Display.Render.DSurfaceTypes
LibraryImport.Display.Render.DSurface
LibraryImport.Display.Render.DDrawPixel

FixedPool.ImgLayerConst {
    "REC_SIZE": Initialize=96
    "MAX_SLOT": Initialize=32
}

FixedPool.ImgLayerOff {
    "SURF":    Initialize=0
    "W":       Initialize=8
    "H":       Initialize=16
    "OX":      Initialize=24
    "OY":      Initialize=32
    "OPACITY": Initialize=40
    "VISIBLE": Initialize=48
    "BLEND":   Initialize=56
    "NAME":    Initialize=64
    "GEN":     Initialize=72
    "CANVAS":  Initialize=80
    "pad":     Initialize=88
}

FixedPool.ImgLayerTable {
    "data":      Initialize=0, CanChange=True
    "free_head": Initialize=-1, CanChange=True
    "used":      Initialize=0, CanChange=True
    "next":      Initialize=0, CanChange=True
}

FixedPool.ImgBlend {
    "SRC_OVER": Initialize=0
    "DEST_OUT": Initialize=1
}

FixedPool.ImgLayAcc {
    "idx":   Initialize=0, CanChange=True
    "field": Initialize=0, CanChange=True
    "val":   Initialize=0, CanChange=True
    "h":     Initialize=0, CanChange=True
    "gen":   Initialize=0, CanChange=True
    "p":     Initialize=0, CanChange=True
    "i":     Initialize=0, CanChange=True
}

Function.ImgLayer_Init {
    Output: Integer
    Body: {
        IfCondition NotEqual(ImgLayerTable.data, 0) ThenBlock: {
            ReturnValue(1)
        }
        ImgLayAcc.val = Multiply(ImgLayerConst.MAX_SLOT, ImgLayerConst.REC_SIZE)
        ImgLayerTable.data = Allocate(ImgLayAcc.val)
        IfCondition EqualTo(ImgLayerTable.data, 0) ThenBlock: {
            PrintMessage("[ImgLayer] data alloc fail\n")
            ReturnValue(0)
        }
        MemorySet(ImgLayerTable.data, 0, ImgLayAcc.val)
        ImgLayerTable.next = Allocate(Multiply(ImgLayerConst.MAX_SLOT, 8))
        IfCondition EqualTo(ImgLayerTable.next, 0) ThenBlock: {
            PrintMessage("[ImgLayer] next alloc fail\n")
            ReturnValue(0)
        }
        ImgLayAcc.i = 0
        WhileLoop LessThan(ImgLayAcc.i, Subtract(ImgLayerConst.MAX_SLOT, 1)) {
            StoreValue(Add(ImgLayerTable.next, Multiply(ImgLayAcc.i, 8)), Add(ImgLayAcc.i, 1))
            ImgLayAcc.i = Add(ImgLayAcc.i, 1)
        }
        StoreValue(Add(ImgLayerTable.next, Multiply(Subtract(ImgLayerConst.MAX_SLOT, 1), 8)), -1)
        ImgLayerTable.free_head = 0
        ImgLayerTable.used = 0
        PrintMessage("[ImgLayer] init ok\n")
        ReturnValue(1)
    }
}

Function.ImgLayer_Ptr {
    Input: idx: Integer
    Output: Address
    Body: {
        ReturnValue(Add(ImgLayerTable.data, Multiply(idx, ImgLayerConst.REC_SIZE)))
    }
}

Function.ImgLayer_LiveIdx {
    Input: h: Integer
    Output: Integer
    Body: {
        IfCondition LessEqual(h, 0) ThenBlock: {
            ReturnValue(-1)
        }
        ImgLayAcc.h = h
        ImgLayAcc.idx = BitwiseAnd(ImgLayAcc.h, 65535)
        ImgLayAcc.gen = ShiftRight(ImgLayAcc.h, 16)
        IfCondition GreaterEqual(ImgLayAcc.idx, ImgLayerConst.MAX_SLOT) ThenBlock: {
            ReturnValue(-1)
        }
        IfCondition EqualTo(ImgLayerTable.data, 0) ThenBlock: {
            ReturnValue(-1)
        }
        ImgLayAcc.p = ImgLayer_Ptr(ImgLayAcc.idx)
        ImgLayAcc.val = Dereference(Add(ImgLayAcc.p, ImgLayerOff.GEN))
        IfCondition EqualTo(ImgLayAcc.val, 0) ThenBlock: {
            ReturnValue(-1)
        }
        IfCondition NotEqual(ImgLayAcc.val, ImgLayAcc.gen) ThenBlock: {
            ReturnValue(-1)
        }
        ReturnValue(ImgLayAcc.idx)
    }
}

Function.ImgLayer_Get {
    Input: h: Integer
    Input: field: Integer
    Output: Integer
    Body: {
        ImgLayAcc.idx = ImgLayer_LiveIdx(h)
        IfCondition LessThan(ImgLayAcc.idx, 0) ThenBlock: {
            ReturnValue(0)
        }
        ImgLayAcc.field = field
        ReturnValue(Dereference(Add(ImgLayer_Ptr(ImgLayAcc.idx), ImgLayAcc.field)))
    }
}

Function.ImgLayer_GetSurf {
    Input: h: Integer
    Output: Integer
    Body: {
        ReturnValue(ImgLayer_Get(h, ImgLayerOff.SURF))
    }
}

Function.ImgLayer_Alloc {
    Input: cnv: Integer
    Input: w: Integer
    Input: h: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(ImgLayerTable.data, 0) ThenBlock: {
            IfCondition EqualTo(ImgLayer_Init(), 0) ThenBlock: {
                ReturnValue(-1)
            }
        }
        IfCondition LessThan(ImgLayerTable.free_head, 0) ThenBlock: {
            PrintMessage("[ImgLayer] table full\n")
            ReturnValue(-1)
        }
        ImgLayAcc.idx = ImgLayerTable.free_head
        ImgLayerTable.free_head = Dereference(Add(ImgLayerTable.next, Multiply(ImgLayAcc.idx, 8)))
        ImgLayAcc.p = ImgLayer_Ptr(ImgLayAcc.idx)
        ImgLayAcc.gen = Dereference(Add(ImgLayAcc.p, ImgLayerOff.GEN))
        MemorySet(ImgLayAcc.p, 0, ImgLayerConst.REC_SIZE)
        ImgLayAcc.val = Surface_Create(SurfaceFormat.PIXEL_32, w, h)
        IfCondition EqualTo(ImgLayAcc.val, 0) ThenBlock: {
            StoreValue(Add(ImgLayerTable.next, Multiply(ImgLayAcc.idx, 8)), ImgLayerTable.free_head)
            ImgLayerTable.free_head = ImgLayAcc.idx
            PrintMessage("[ImgLayer] surface alloc fail\n")
            ReturnValue(-1)
        }
        StoreValue(Add(ImgLayAcc.p, ImgLayerOff.SURF), ImgLayAcc.val)
        StoreValue(Add(ImgLayAcc.p, ImgLayerOff.W), w)
        StoreValue(Add(ImgLayAcc.p, ImgLayerOff.H), h)
        StoreValue(Add(ImgLayAcc.p, ImgLayerOff.OX), 0)
        StoreValue(Add(ImgLayAcc.p, ImgLayerOff.OY), 0)
        StoreValue(Add(ImgLayAcc.p, ImgLayerOff.OPACITY), 255)
        StoreValue(Add(ImgLayAcc.p, ImgLayerOff.VISIBLE), 1)
        StoreValue(Add(ImgLayAcc.p, ImgLayerOff.BLEND), ImgBlend.SRC_OVER)
        StoreValue(Add(ImgLayAcc.p, ImgLayerOff.NAME), 0)
        StoreValue(Add(ImgLayAcc.p, ImgLayerOff.CANVAS), cnv)
        ImgLayAcc.gen = Add(ImgLayAcc.gen, 1)
        IfCondition EqualTo(ImgLayAcc.gen, 0) ThenBlock: {
            ImgLayAcc.gen = 1
        }
        StoreValue(Add(ImgLayAcc.p, ImgLayerOff.GEN), ImgLayAcc.gen)
        ImgLayerTable.used = Add(ImgLayerTable.used, 1)
        ReturnValue(BitwiseOr(ImgLayAcc.idx, ShiftLeft(ImgLayAcc.gen, 16)))
    }
}

Function.ImgLayer_Destroy {
    Input: h: Integer
    Body: {
        ImgLayAcc.idx = ImgLayer_LiveIdx(h)
        IfCondition LessThan(ImgLayAcc.idx, 0) ThenBlock: {
            ReturnValue(0)
        }
        ImgLayAcc.p = ImgLayer_Ptr(ImgLayAcc.idx)
        ImgLayAcc.val = Dereference(Add(ImgLayAcc.p, ImgLayerOff.SURF))
        IfCondition NotEqual(ImgLayAcc.val, 0) ThenBlock: {
            Surface_Destroy(ImgLayAcc.val)
        }
        ImgLayAcc.gen = Dereference(Add(ImgLayAcc.p, ImgLayerOff.GEN))
        ImgLayAcc.gen = Add(ImgLayAcc.gen, 1)
        IfCondition EqualTo(ImgLayAcc.gen, 0) ThenBlock: {
            ImgLayAcc.gen = 1
        }
        MemorySet(ImgLayAcc.p, 0, ImgLayerConst.REC_SIZE)
        StoreValue(Add(ImgLayAcc.p, ImgLayerOff.GEN), ImgLayAcc.gen)
        StoreValue(Add(ImgLayerTable.next, Multiply(ImgLayAcc.idx, 8)), ImgLayerTable.free_head)
        ImgLayerTable.free_head = ImgLayAcc.idx
        ImgLayerTable.used = Subtract(ImgLayerTable.used, 1)
    }
}
