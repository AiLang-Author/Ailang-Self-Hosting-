LibraryImport.Display.Render.DSurfaceTypes
LibraryImport.Display.Render.DSurface
LibraryImport.Display.Render.DDrawPixel

FixedPool.ImgPix {
    "surf":  Initialize=0, CanChange=True
    "clipx": Initialize=0, CanChange=True
    "clipy": Initialize=0, CanChange=True
    "clipw": Initialize=0, CanChange=True
    "cliph": Initialize=0, CanChange=True
    "ptr":   Initialize=0, CanChange=True
    "pitch": Initialize=0, CanChange=True
    "color": Initialize=0, CanChange=True
    "x":     Initialize=0, CanChange=True
    "y":     Initialize=0, CanChange=True
    "w":     Initialize=0, CanChange=True
    "h":     Initialize=0, CanChange=True
    "x1":    Initialize=0, CanChange=True
    "y1":    Initialize=0, CanChange=True
    "sw":    Initialize=0, CanChange=True
    "sh":    Initialize=0, CanChange=True
    "row":   Initialize=0, CanChange=True
    "tmp":   Initialize=0, CanChange=True
    "sa":    Initialize=0, CanChange=True
    "inv":   Initialize=0, CanChange=True
    "db":    Initialize=0, CanChange=True
    "dg":    Initialize=0, CanChange=True
    "dr":    Initialize=0, CanChange=True
    "da":    Initialize=0, CanChange=True
    "t1":    Initialize=0, CanChange=True
    "t2":    Initialize=0, CanChange=True
}

// Bresenham walk (copied from FB_Line — same 8192 cap).
FixedPool.ImgWalk {
    "surf":  Initialize=0, CanChange=True
    "color": Initialize=0, CanChange=True
    "thick": Initialize=1, CanChange=True
    "x":     Initialize=0, CanChange=True
    "y":     Initialize=0, CanChange=True
    "x2":    Initialize=0, CanChange=True
    "y2":    Initialize=0, CanChange=True
    "dx":    Initialize=0, CanChange=True
    "dy":    Initialize=0, CanChange=True
    "sx":    Initialize=0, CanChange=True
    "sy":    Initialize=0, CanChange=True
    "err":   Initialize=0, CanChange=True
    "e2":    Initialize=0, CanChange=True
    "steps": Initialize=0, CanChange=True
    "done":  Initialize=0, CanChange=True
    "half":  Initialize=0, CanChange=True
}

Function.ImgPixels_Clip {
    Input: surf: Integer
    Input: x: Integer
    Input: y: Integer
    Input: w: Integer
    Input: h: Integer
    Body: {
        IfCondition EqualTo(surf, 0) ThenBlock: {
            ImgPix.clipw = 0
            ReturnValue(0)
        }
        ImgPix.surf = surf
        ImgPix.sw = Surface_GetWidth(surf)
        ImgPix.sh = Surface_GetHeight(surf)
        ImgPix.x = x
        ImgPix.y = y
        ImgPix.w = w
        ImgPix.h = h
        IfCondition LessThan(ImgPix.x, 0) ThenBlock: {
            ImgPix.w = Add(ImgPix.w, ImgPix.x)
            ImgPix.x = 0
        }
        IfCondition LessThan(ImgPix.y, 0) ThenBlock: {
            ImgPix.h = Add(ImgPix.h, ImgPix.y)
            ImgPix.y = 0
        }
        IfCondition LessThan(ImgPix.w, 1) ThenBlock: {
            ImgPix.clipw = 0
            ReturnValue(0)
        }
        IfCondition LessThan(ImgPix.h, 1) ThenBlock: {
            ImgPix.clipw = 0
            ReturnValue(0)
        }
        ImgPix.x1 = Add(ImgPix.x, ImgPix.w)
        ImgPix.y1 = Add(ImgPix.y, ImgPix.h)
        IfCondition GreaterThan(ImgPix.x1, ImgPix.sw) ThenBlock: {
            ImgPix.x1 = ImgPix.sw
        }
        IfCondition GreaterThan(ImgPix.y1, ImgPix.sh) ThenBlock: {
            ImgPix.y1 = ImgPix.sh
        }
        IfCondition Not(LessThan(ImgPix.x, ImgPix.x1)) ThenBlock: {
            ImgPix.clipw = 0
            ReturnValue(0)
        }
        IfCondition Not(LessThan(ImgPix.y, ImgPix.y1)) ThenBlock: {
            ImgPix.clipw = 0
            ReturnValue(0)
        }
        ImgPix.clipx = ImgPix.x
        ImgPix.clipy = ImgPix.y
        ImgPix.clipw = Subtract(ImgPix.x1, ImgPix.x)
        ImgPix.cliph = Subtract(ImgPix.y1, ImgPix.y)
    }
}

Function.ImgPixels_InClip {
    Input: surf: Integer
    Input: x: Integer
    Input: y: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(Surface_InBounds(surf, x, y), 0) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition NotEqual(ImgPix.surf, surf) ThenBlock: {
            ReturnValue(1)
        }
        IfCondition LessEqual(ImgPix.clipw, 0) ThenBlock: {
            ReturnValue(1)
        }
        IfCondition LessThan(x, ImgPix.clipx) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition LessThan(y, ImgPix.clipy) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition GreaterEqual(x, Add(ImgPix.clipx, ImgPix.clipw)) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition GreaterEqual(y, Add(ImgPix.clipy, ImgPix.cliph)) ThenBlock: {
            ReturnValue(0)
        }
        ReturnValue(1)
    }
}

Function.ImgPixels_Get {
    Input: surf: Integer
    Input: x: Integer
    Input: y: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(ImgPixels_InClip(surf, x, y), 0) ThenBlock: {
            ReturnValue(0)
        }
        ImgPix.ptr = Surface_PixelAt(surf, x, y)
        ReturnValue(Dereference(ImgPix.ptr, "dword"))
    }
}

Function.ImgPixels_Put {
    Input: surf: Integer
    Input: x: Integer
    Input: y: Integer
    Input: color: Integer
    Body: {
        IfCondition EqualTo(ImgPixels_InClip(surf, x, y), 0) ThenBlock: {
            ReturnValue(0)
        }
        ImgPix.ptr = Surface_PixelAt(surf, x, y)
        StoreValue(ImgPix.ptr, color, "dword")
    }
}

Function.ImgPixels_Fill {
    Input: surf: Integer
    Input: x: Integer
    Input: y: Integer
    Input: w: Integer
    Input: h: Integer
    Input: color: Integer
    Body: {
        ImgPix.x = x
        ImgPix.y = y
        ImgPix.w = w
        ImgPix.h = h
        IfCondition And(EqualTo(ImgPix.surf, surf), GreaterThan(ImgPix.clipw, 0)) ThenBlock: {
            ImgPix.x1 = Add(ImgPix.x, ImgPix.w)
            ImgPix.y1 = Add(ImgPix.y, ImgPix.h)
            IfCondition LessThan(ImgPix.x, ImgPix.clipx) ThenBlock: {
                ImgPix.x = ImgPix.clipx
            }
            IfCondition LessThan(ImgPix.y, ImgPix.clipy) ThenBlock: {
                ImgPix.y = ImgPix.clipy
            }
            IfCondition GreaterThan(ImgPix.x1, Add(ImgPix.clipx, ImgPix.clipw)) ThenBlock: {
                ImgPix.x1 = Add(ImgPix.clipx, ImgPix.clipw)
            }
            IfCondition GreaterThan(ImgPix.y1, Add(ImgPix.clipy, ImgPix.cliph)) ThenBlock: {
                ImgPix.y1 = Add(ImgPix.clipy, ImgPix.cliph)
            }
            ImgPix.w = Subtract(ImgPix.x1, ImgPix.x)
            ImgPix.h = Subtract(ImgPix.y1, ImgPix.y)
        }
        IfCondition LessThan(ImgPix.w, 1) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition LessThan(ImgPix.h, 1) ThenBlock: {
            ReturnValue(0)
        }
        Draw_Pix_FillRect(surf, ImgPix.x, ImgPix.y, ImgPix.w, ImgPix.h, color)
    }
}

Function.ImgPixels_Copy {
    Input: dst: Integer
    Input: src: Integer
    Input: dx: Integer
    Input: dy: Integer
    Body: {
        IfCondition Or(EqualTo(dst, 0), EqualTo(src, 0)) ThenBlock: {
            ReturnValue(0)
        }
        ImgPix.sw = Surface_GetWidth(src)
        ImgPix.sh = Surface_GetHeight(src)
        ImgPix.w = Surface_GetWidth(dst)
        ImgPix.h = Surface_GetHeight(dst)
        ImgPix.x = dx
        ImgPix.y = dy
        IfCondition LessThan(ImgPix.x, 0) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition LessThan(ImgPix.y, 0) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition GreaterThan(Add(ImgPix.x, ImgPix.sw), ImgPix.w) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition GreaterThan(Add(ImgPix.y, ImgPix.sh), ImgPix.h) ThenBlock: {
            ReturnValue(0)
        }
        ImgPix.pitch = Surface_GetPitch(src)
        ImgPix.ptr = Surface_GetData(src)
        ImgPix.color = Surface_GetPitch(dst)
        ImgPix.tmp = Surface_GetData(dst)
        ImgPix.row = 0
        WhileLoop LessThan(ImgPix.row, ImgPix.sh) {
            ImgPix.x1 = Multiply(Add(ImgPix.y, ImgPix.row), ImgPix.color)
            ImgPix.x1 = Add(ImgPix.x1, Multiply(ImgPix.x, 4))
            ImgPix.y1 = Add(ImgPix.tmp, ImgPix.x1)
            ImgPix.x1 = Add(ImgPix.ptr, Multiply(ImgPix.row, ImgPix.pitch))
            MemoryCopy(ImgPix.y1, ImgPix.x1, Multiply(ImgPix.sw, 4))
            ImgPix.row = Add(ImgPix.row, 1)
        }
    }
}

Function.ImgPixels_SrcOverPixel {
    Input: surf: Integer
    Input: x: Integer
    Input: y: Integer
    Input: color: Integer
    Body: {
        IfCondition EqualTo(ImgPixels_InClip(surf, x, y), 0) ThenBlock: {
            ReturnValue(0)
        }
        ImgPix.sa = BitwiseAnd(ShiftRight(color, 24), 255)
        IfCondition EqualTo(ImgPix.sa, 0) ThenBlock: {
            ReturnValue(0)
        }
        ImgPix.ptr = Surface_PixelAt(surf, x, y)
        IfCondition EqualTo(ImgPix.sa, 255) ThenBlock: {
            StoreValue(ImgPix.ptr, color, "dword")
            ReturnValue(0)
        }
        ImgPix.color = Dereference(ImgPix.ptr, "dword")
        ImgPix.inv = Subtract(255, ImgPix.sa)
        ImgPix.db = BitwiseAnd(ImgPix.color, 255)
        ImgPix.dg = BitwiseAnd(ShiftRight(ImgPix.color, 8), 255)
        ImgPix.dr = BitwiseAnd(ShiftRight(ImgPix.color, 16), 255)
        ImgPix.da = BitwiseAnd(ShiftRight(ImgPix.color, 24), 255)
        ImgPix.t1 = Multiply(BitwiseAnd(color, 255), ImgPix.sa)
        ImgPix.t2 = Multiply(ImgPix.db, ImgPix.inv)
        ImgPix.db = Divide(Add(ImgPix.t1, ImgPix.t2), 255)
        ImgPix.t1 = Multiply(BitwiseAnd(ShiftRight(color, 8), 255), ImgPix.sa)
        ImgPix.t2 = Multiply(ImgPix.dg, ImgPix.inv)
        ImgPix.dg = Divide(Add(ImgPix.t1, ImgPix.t2), 255)
        ImgPix.t1 = Multiply(BitwiseAnd(ShiftRight(color, 16), 255), ImgPix.sa)
        ImgPix.t2 = Multiply(ImgPix.dr, ImgPix.inv)
        ImgPix.dr = Divide(Add(ImgPix.t1, ImgPix.t2), 255)
        ImgPix.t1 = Multiply(ImgPix.sa, 255)
        ImgPix.t2 = Multiply(ImgPix.da, ImgPix.inv)
        ImgPix.da = Divide(Add(ImgPix.t1, ImgPix.t2), 255)
        ImgPix.t1 = ShiftLeft(ImgPix.dg, 8)
        ImgPix.t2 = ShiftLeft(ImgPix.dr, 16)
        ImgPix.color = BitwiseOr(ImgPix.db, ImgPix.t1)
        ImgPix.color = BitwiseOr(ImgPix.color, ImgPix.t2)
        ImgPix.t1 = ShiftLeft(ImgPix.da, 24)
        ImgPix.color = BitwiseOr(ImgPix.color, ImgPix.t1)
        StoreValue(ImgPix.ptr, ImgPix.color, "dword")
    }
}

Function.ImgPixels_LineDot {
    Body: {
        IfCondition LessEqual(ImgWalk.thick, 1) ThenBlock: {
            ImgPixels_Put(ImgWalk.surf, ImgWalk.x, ImgWalk.y, ImgWalk.color)
        }
        ElseBlock: {
            ImgWalk.half = Divide(ImgWalk.thick, 2)
            ImgPixels_Fill(ImgWalk.surf, Subtract(ImgWalk.x, ImgWalk.half), Subtract(ImgWalk.y, ImgWalk.half), ImgWalk.thick, ImgWalk.thick, ImgWalk.color)
        }
    }
}

Function.ImgPixels_Line {
    Input: surf: Integer
    Input: x0: Integer
    Input: y0: Integer
    Input: x1: Integer
    Input: y1: Integer
    Input: color: Integer
    Body: {
        ImgWalk.thick = 1
        ImgWalk.color = color
        ImgPixels_ThickLine(surf, x0, y0, x1, y1)
    }
}

Function.ImgPixels_ThickLine {
    Input: surf: Integer
    Input: x0: Integer
    Input: y0: Integer
    Input: x1: Integer
    Input: y1: Integer
    Body: {
        IfCondition EqualTo(surf, 0) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition GreaterThan(x0, 100000) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterThan(y0, 100000) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterThan(x1, 100000) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterThan(y1, 100000) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(x0, -100000) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(y0, -100000) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(x1, -100000) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(y1, -100000) ThenBlock: { ReturnValue(0) }
        ImgWalk.surf = surf
        IfCondition LessThan(ImgWalk.thick, 1) ThenBlock: {
            ImgWalk.thick = 1
        }
        ImgWalk.x = x0
        ImgWalk.y = y0
        ImgWalk.x2 = x1
        ImgWalk.y2 = y1
        ImgWalk.dx = Subtract(ImgWalk.x2, ImgWalk.x)
        IfCondition LessThan(ImgWalk.dx, 0) ThenBlock: {
            ImgWalk.dx = Subtract(0, ImgWalk.dx)
        }
        ImgWalk.dy = Subtract(ImgWalk.y2, ImgWalk.y)
        IfCondition LessThan(ImgWalk.dy, 0) ThenBlock: {
            ImgWalk.dy = Subtract(0, ImgWalk.dy)
        }
        IfCondition LessThan(ImgWalk.x, ImgWalk.x2) ThenBlock: {
            ImgWalk.sx = 1
        }
        ElseBlock: {
            ImgWalk.sx = -1
        }
        IfCondition LessThan(ImgWalk.y, ImgWalk.y2) ThenBlock: {
            ImgWalk.sy = 1
        }
        ElseBlock: {
            ImgWalk.sy = -1
        }
        ImgWalk.err = Subtract(ImgWalk.dx, ImgWalk.dy)
        ImgWalk.done = 0
        ImgWalk.steps = 0
        WhileLoop EqualTo(ImgWalk.done, 0) {
            ImgPixels_LineDot()
            IfCondition And(EqualTo(ImgWalk.x, ImgWalk.x2), EqualTo(ImgWalk.y, ImgWalk.y2)) ThenBlock: {
                ImgWalk.done = 1
            }
            ElseBlock: {
                ImgWalk.e2 = Multiply(ImgWalk.err, 2)
                IfCondition GreaterThan(ImgWalk.e2, Subtract(0, ImgWalk.dy)) ThenBlock: {
                    ImgWalk.err = Subtract(ImgWalk.err, ImgWalk.dy)
                    ImgWalk.x = Add(ImgWalk.x, ImgWalk.sx)
                }
                IfCondition LessThan(ImgWalk.e2, ImgWalk.dx) ThenBlock: {
                    ImgWalk.err = Add(ImgWalk.err, ImgWalk.dx)
                    ImgWalk.y = Add(ImgWalk.y, ImgWalk.sy)
                }
                ImgWalk.steps = Add(ImgWalk.steps, 1)
                IfCondition GreaterThan(ImgWalk.steps, 8192) ThenBlock: {
                    ImgWalk.done = 1
                }
            }
        }
    }
}
