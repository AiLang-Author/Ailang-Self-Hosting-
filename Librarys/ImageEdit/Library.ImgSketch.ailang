// Library.ImgSketch.ailang
// Hard-line drawings. Copied from CAD sketch's line table, not the solver:
//   CAD_Sketch.AddLine stores 4 coords (x1,y1,x2,y2) and draws with Bresenham.
// Pixel-integer, no CAD_Store, no floats, no constraints, no workplane.
// Copyright © 2026 Sean Collins, 2 Paws Machine and Engineering. SCSL.

LibraryImport.Display.Render.DSurfaceTypes
LibraryImport.Display.Render.DSurface
LibraryImport.ImageEdit.ImgPixels
LibraryImport.ImageEdit.ImgBrush

FixedPool.ImgSkConst {
    "MAX":      Initialize=256
    "REC":      Initialize=32
    "X0":       Initialize=0
    "Y0":       Initialize=8
    "X1":       Initialize=16
    "Y1":       Initialize=24
    "MAXPT":    Initialize=32
    "PTREC":    Initialize=16
    "PX":       Initialize=0
    "PY":       Initialize=8
}

FixedPool.ImgSketch {
    "lines": Initialize=0, CanChange=True
    "n":     Initialize=0, CanChange=True
    "i":     Initialize=0, CanChange=True
    "p":     Initialize=0, CanChange=True
    "x0":    Initialize=0, CanChange=True
    "y0":    Initialize=0, CanChange=True
    "x1":    Initialize=0, CanChange=True
    "y1":    Initialize=0, CanChange=True
    "pts":   Initialize=0, CanChange=True
    "npts":  Initialize=0, CanChange=True
    "cx":    Initialize=0, CanChange=True
    "cy":    Initialize=0, CanChange=True
    "r":     Initialize=0, CanChange=True
    "a0":    Initialize=0, CanChange=True
    "a1":    Initialize=0, CanChange=True
    "at":    Initialize=0, CanChange=True
    "deg":   Initialize=0, CanChange=True
    "step":  Initialize=0, CanChange=True
    "k":     Initialize=0, CanChange=True
    "t":     Initialize=0, CanChange=True
    "u":     Initialize=0, CanChange=True
    "qx":    Initialize=0, CanChange=True
    "qy":    Initialize=0, CanChange=True
    "px":    Initialize=0, CanChange=True
    "py":    Initialize=0, CanChange=True
    "d":     Initialize=0, CanChange=True
    "a2":    Initialize=0, CanChange=True
    "b2":    Initialize=0, CanChange=True
    "c2":    Initialize=0, CanChange=True
    "ccw":   Initialize=0, CanChange=True
}

Function.ImgSketch_Init {
    Output: Integer
    Body: {
        IfCondition NotEqual(ImgSketch.lines, 0) ThenBlock: {
            ReturnValue(1)
        }
        ImgSketch.lines = Allocate(Multiply(ImgSkConst.MAX, ImgSkConst.REC))
        IfCondition EqualTo(ImgSketch.lines, 0) ThenBlock: {
            PrintMessage("[ImgSketch] alloc fail\n")
            ReturnValue(0)
        }
        MemorySet(ImgSketch.lines, 0, Multiply(ImgSkConst.MAX, ImgSkConst.REC))
        ImgSketch.n = 0
        ImgSketch.pts = Allocate(Multiply(ImgSkConst.MAXPT, ImgSkConst.PTREC))
        IfCondition EqualTo(ImgSketch.pts, 0) ThenBlock: {
            ReturnValue(0)
        }
        MemorySet(ImgSketch.pts, 0, Multiply(ImgSkConst.MAXPT, ImgSkConst.PTREC))
        ImgSketch.npts = 0
        PrintMessage("[ImgSketch] init ok\n")
        ReturnValue(1)
    }
}

Function.ImgSketch_Clear {
    Body: {
        ImgSketch.n = 0
        ImgSketch.npts = 0
    }
}

Function.ImgSketch_ClearPts {
    Body: {
        ImgSketch.npts = 0
    }
}

Function.ImgSketch_NPts {
    Output: Integer
    Body: {
        ReturnValue(ImgSketch.npts)
    }
}

Function.ImgSketch_AddPt {
    Input: x: Integer
    Input: y: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(ImgSketch.pts, 0) ThenBlock: {
            IfCondition EqualTo(ImgSketch_Init(), 0) ThenBlock: {
                ReturnValue(-1)
            }
        }
        IfCondition GreaterEqual(ImgSketch.npts, ImgSkConst.MAXPT) ThenBlock: {
            ReturnValue(-1)
        }
        ImgSketch.p = Add(ImgSketch.pts, Multiply(ImgSketch.npts, ImgSkConst.PTREC))
        StoreValue(Add(ImgSketch.p, ImgSkConst.PX), x)
        StoreValue(Add(ImgSketch.p, ImgSkConst.PY), y)
        ImgSketch.npts = Add(ImgSketch.npts, 1)
        ReturnValue(ImgSketch.npts)
    }
}

Function.ImgSketch_LoadPt {
    Input: i: Integer
    Body: {
        IfCondition Or(LessThan(i, 0), GreaterEqual(i, ImgSketch.npts)) ThenBlock: {
            ImgSketch.x0 = 0
            ImgSketch.y0 = 0
            ReturnValue(0)
        }
        ImgSketch.p = Add(ImgSketch.pts, Multiply(i, ImgSkConst.PTREC))
        ImgSketch.x0 = Dereference(Add(ImgSketch.p, ImgSkConst.PX))
        ImgSketch.y0 = Dereference(Add(ImgSketch.p, ImgSkConst.PY))
    }
}

Function.ImgSketch_SetPt {
    Input: i: Integer
    Input: x: Integer
    Input: y: Integer
    Body: {
        IfCondition LessThan(i, 0) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterEqual(i, ImgSketch.npts) ThenBlock: { ReturnValue(0) }
        ImgSketch.p = Add(ImgSketch.pts, Multiply(i, ImgSkConst.PTREC))
        StoreValue(Add(ImgSketch.p, ImgSkConst.PX), x)
        StoreValue(Add(ImgSketch.p, ImgSkConst.PY), y)
    }
}

Function.ImgSketch_Count {
    Output: Integer
    Body: {
        ReturnValue(ImgSketch.n)
    }
}

Function.ImgSketch_AddLine {
    Input: x0: Integer
    Input: y0: Integer
    Input: x1: Integer
    Input: y1: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(ImgSketch.lines, 0) ThenBlock: {
            IfCondition EqualTo(ImgSketch_Init(), 0) ThenBlock: {
                ReturnValue(-1)
            }
        }
        IfCondition GreaterEqual(ImgSketch.n, ImgSkConst.MAX) ThenBlock: {
            ReturnValue(-1)
        }
        ImgSketch.p = Add(ImgSketch.lines, Multiply(ImgSketch.n, ImgSkConst.REC))
        StoreValue(Add(ImgSketch.p, ImgSkConst.X0), x0)
        StoreValue(Add(ImgSketch.p, ImgSkConst.Y0), y0)
        StoreValue(Add(ImgSketch.p, ImgSkConst.X1), x1)
        StoreValue(Add(ImgSketch.p, ImgSkConst.Y1), y1)
        ImgSketch.n = Add(ImgSketch.n, 1)
        ReturnValue(ImgSketch.n)
    }
}

Function.ImgSketch_DrawAll {
    Input: surf: Integer
    Input: color: Integer
    Input: thick: Integer
    Body: {
        IfCondition Or(EqualTo(surf, 0), EqualTo(ImgSketch.lines, 0)) ThenBlock: {
            ReturnValue(0)
        }
        ImgWalk.color = color
        ImgWalk.thick = thick
        ImgSketch.i = 0
        WhileLoop LessThan(ImgSketch.i, ImgSketch.n) {
            ImgSketch.p = Add(ImgSketch.lines, Multiply(ImgSketch.i, ImgSkConst.REC))
            ImgSketch.x0 = Dereference(Add(ImgSketch.p, ImgSkConst.X0))
            ImgSketch.y0 = Dereference(Add(ImgSketch.p, ImgSkConst.Y0))
            ImgSketch.x1 = Dereference(Add(ImgSketch.p, ImgSkConst.X1))
            ImgSketch.y1 = Dereference(Add(ImgSketch.p, ImgSkConst.Y1))
            ImgPixels_ThickLine(surf, ImgSketch.x0, ImgSketch.y0, ImgSketch.x1, ImgSketch.y1)
            ImgSketch.i = Add(ImgSketch.i, 1)
        }
    }
}

Function.ImgSketch_Sin10000 {
    Input: deg: Integer
    Output: Integer
    Body: {
        ImgSketch.deg = deg
        WhileLoop LessThan(ImgSketch.deg, 0) {
            ImgSketch.deg = Add(ImgSketch.deg, 360)
        }
        WhileLoop GreaterEqual(ImgSketch.deg, 360) {
            ImgSketch.deg = Subtract(ImgSketch.deg, 360)
        }
        ImgSketch.d = 1
        IfCondition GreaterThan(ImgSketch.deg, 180) ThenBlock: {
            ImgSketch.d = -1
            ImgSketch.deg = Subtract(ImgSketch.deg, 180)
        }
        IfCondition GreaterThan(ImgSketch.deg, 90) ThenBlock: {
            ImgSketch.deg = Subtract(180, ImgSketch.deg)
        }
        IfCondition GreaterEqual(ImgSketch.deg, 90) ThenBlock: { ReturnValue(Multiply(ImgSketch.d, 10000)) }
        IfCondition GreaterEqual(ImgSketch.deg, 85) ThenBlock: { ReturnValue(Multiply(ImgSketch.d, 9962)) }
        IfCondition GreaterEqual(ImgSketch.deg, 80) ThenBlock: { ReturnValue(Multiply(ImgSketch.d, 9848)) }
        IfCondition GreaterEqual(ImgSketch.deg, 75) ThenBlock: { ReturnValue(Multiply(ImgSketch.d, 9659)) }
        IfCondition GreaterEqual(ImgSketch.deg, 70) ThenBlock: { ReturnValue(Multiply(ImgSketch.d, 9397)) }
        IfCondition GreaterEqual(ImgSketch.deg, 65) ThenBlock: { ReturnValue(Multiply(ImgSketch.d, 9063)) }
        IfCondition GreaterEqual(ImgSketch.deg, 60) ThenBlock: { ReturnValue(Multiply(ImgSketch.d, 8660)) }
        IfCondition GreaterEqual(ImgSketch.deg, 55) ThenBlock: { ReturnValue(Multiply(ImgSketch.d, 8192)) }
        IfCondition GreaterEqual(ImgSketch.deg, 50) ThenBlock: { ReturnValue(Multiply(ImgSketch.d, 7660)) }
        IfCondition GreaterEqual(ImgSketch.deg, 45) ThenBlock: { ReturnValue(Multiply(ImgSketch.d, 7071)) }
        IfCondition GreaterEqual(ImgSketch.deg, 40) ThenBlock: { ReturnValue(Multiply(ImgSketch.d, 6428)) }
        IfCondition GreaterEqual(ImgSketch.deg, 35) ThenBlock: { ReturnValue(Multiply(ImgSketch.d, 5736)) }
        IfCondition GreaterEqual(ImgSketch.deg, 30) ThenBlock: { ReturnValue(Multiply(ImgSketch.d, 5000)) }
        IfCondition GreaterEqual(ImgSketch.deg, 25) ThenBlock: { ReturnValue(Multiply(ImgSketch.d, 4226)) }
        IfCondition GreaterEqual(ImgSketch.deg, 20) ThenBlock: { ReturnValue(Multiply(ImgSketch.d, 3420)) }
        IfCondition GreaterEqual(ImgSketch.deg, 15) ThenBlock: { ReturnValue(Multiply(ImgSketch.d, 2588)) }
        IfCondition GreaterEqual(ImgSketch.deg, 10) ThenBlock: { ReturnValue(Multiply(ImgSketch.d, 1736)) }
        IfCondition GreaterEqual(ImgSketch.deg, 5) ThenBlock: { ReturnValue(Multiply(ImgSketch.d, 872)) }
        ReturnValue(0)
    }
}

Function.ImgSketch_Atan2Deg {
    Input: y: Integer
    Input: x: Integer
    Output: Integer
    Body: {
        ImgSketch.a2 = x
        ImgSketch.b2 = y
        IfCondition EqualTo(ImgSketch.a2, 0) ThenBlock: {
            IfCondition GreaterEqual(ImgSketch.b2, 0) ThenBlock: { ReturnValue(90) }
            ReturnValue(270)
        }
        ImgSketch.ccw = 0
        IfCondition LessThan(ImgSketch.a2, 0) ThenBlock: { ImgSketch.ccw = 1 }
        IfCondition LessThan(ImgSketch.a2, 0) ThenBlock: { ImgSketch.a2 = Subtract(0, ImgSketch.a2) }
        IfCondition LessThan(ImgSketch.b2, 0) ThenBlock: { ImgSketch.d = 1 }
        ElseBlock: { ImgSketch.d = 0 }
        IfCondition EqualTo(ImgSketch.d, 1) ThenBlock: {
            IfCondition LessThan(ImgSketch.b2, 0) ThenBlock: { ImgSketch.b2 = Subtract(0, ImgSketch.b2) }
        }
        IfCondition GreaterThan(ImgSketch.a2, ImgSketch.b2) ThenBlock: {
            ImgSketch.deg = Divide(Multiply(45, ImgSketch.b2), ImgSketch.a2)
        }
        ElseBlock: {
            ImgSketch.deg = Subtract(90, Divide(Multiply(45, ImgSketch.a2), ImgSketch.b2))
        }
        IfCondition EqualTo(ImgSketch.ccw, 0) ThenBlock: {
            IfCondition EqualTo(ImgSketch.d, 1) ThenBlock: {
                ImgSketch.deg = Subtract(360, ImgSketch.deg)
            }
        }
        ElseBlock: {
            IfCondition EqualTo(ImgSketch.d, 0) ThenBlock: {
                ImgSketch.deg = Subtract(180, ImgSketch.deg)
            }
            ElseBlock: {
                ImgSketch.deg = Add(180, ImgSketch.deg)
            }
        }
        ReturnValue(ImgSketch.deg)
    }
}

Function.ImgSketch_Seg {
    Body: {
        ImgSketch_AddLine(ImgSketch.px, ImgSketch.py, ImgSketch.qx, ImgSketch.qy)
        ImgPixels_ThickLine(ImgWalk.surf, ImgSketch.px, ImgSketch.py, ImgSketch.qx, ImgSketch.qy)
    }
}

Function.ImgSketch_ArcFit {
    Output: Integer
    Body: {
        ImgSketch.a2 = Divide(Add(ImgSketch.x0, ImgSketch.px), 2)
        ImgSketch.b2 = Divide(Add(ImgSketch.y0, ImgSketch.qy), 2)
        ImgSketch.u = Subtract(ImgSketch.y0, ImgSketch.qy)
        ImgSketch.t = Subtract(ImgSketch.px, ImgSketch.x0)
        ImgSketch.c2 = Divide(Add(ImgSketch.x0, ImgSketch.x1), 2)
        ImgSketch.d = Divide(Add(ImgSketch.y0, ImgSketch.y1), 2)
        ImgSketch.i = Subtract(ImgSketch.y0, ImgSketch.y1)
        ImgSketch.r = Subtract(ImgSketch.x1, ImgSketch.x0)
        ImgSketch.ccw = Subtract(Multiply(ImgSketch.u, ImgSketch.r), Multiply(ImgSketch.t, ImgSketch.i))
        IfCondition EqualTo(ImgSketch.ccw, 0) ThenBlock: {
            ReturnValue(0)
        }
        ImgSketch.k = Subtract(ImgSketch.c2, ImgSketch.a2)
        ImgSketch.k = Multiply(ImgSketch.k, ImgSketch.r)
        ImgSketch.c2 = Subtract(ImgSketch.d, ImgSketch.b2)
        ImgSketch.c2 = Multiply(ImgSketch.c2, ImgSketch.i)
        ImgSketch.k = Subtract(ImgSketch.k, ImgSketch.c2)
        ImgSketch.cx = Add(ImgSketch.a2, Divide(Multiply(ImgSketch.k, ImgSketch.u), ImgSketch.ccw))
        ImgSketch.cy = Add(ImgSketch.b2, Divide(Multiply(ImgSketch.k, ImgSketch.t), ImgSketch.ccw))
        ImgSketch.r = ImgISqrt(Add(Multiply(Subtract(ImgSketch.x0, ImgSketch.cx), Subtract(ImgSketch.x0, ImgSketch.cx)), Multiply(Subtract(ImgSketch.y0, ImgSketch.cy), Subtract(ImgSketch.y0, ImgSketch.cy))))
        IfCondition LessThan(ImgSketch.r, 1) ThenBlock: {
            ReturnValue(0)
        }
        ReturnValue(1)
    }
}

Function.ImgSketch_RasterArc3 {
    Input: surf: Integer
    Output: Integer
    Body: {
        ImgWalk.surf = surf
        ImgSketch_RasterQuad(surf)
        ReturnValue(1)
    }
}

Function.ImgSketch_RasterQuad {
    Input: surf: Integer
    Body: {
        ImgWalk.surf = surf
        ImgSketch.u = Divide(Subtract(Subtract(Multiply(ImgSketch.px, 4), ImgSketch.x0), ImgSketch.x1), 2)
        ImgSketch.t = Divide(Subtract(Subtract(Multiply(ImgSketch.qy, 4), ImgSketch.y0), ImgSketch.y1), 2)
        ImgSketch.px = ImgSketch.x0
        ImgSketch.py = ImgSketch.y0
        ImgSketch.k = 1
        WhileLoop LessEqual(ImgSketch.k, 16) {
            ImgSketch.i = Divide(ImgSketch.k, 16)
            ImgSketch.d = Subtract(16, ImgSketch.k)
            ImgSketch.qx = Multiply(ImgSketch.d, ImgSketch.d)
            ImgSketch.qx = Multiply(ImgSketch.qx, ImgSketch.x0)
            ImgSketch.qy = Multiply(Multiply(2, ImgSketch.d), ImgSketch.k)
            ImgSketch.a2 = Multiply(ImgSketch.qy, ImgSketch.u)
            ImgSketch.b2 = Multiply(Multiply(ImgSketch.k, ImgSketch.k), ImgSketch.x1)
            ImgSketch.qx = Divide(Add(Add(ImgSketch.qx, ImgSketch.a2), ImgSketch.b2), 256)
            ImgSketch.c2 = Multiply(ImgSketch.d, ImgSketch.d)
            ImgSketch.c2 = Multiply(ImgSketch.c2, ImgSketch.y0)
            ImgSketch.a2 = Multiply(Multiply(Multiply(2, ImgSketch.d), ImgSketch.k), ImgSketch.t)
            ImgSketch.b2 = Multiply(Multiply(ImgSketch.k, ImgSketch.k), ImgSketch.y1)
            ImgSketch.qy = Divide(Add(Add(ImgSketch.c2, ImgSketch.a2), ImgSketch.b2), 256)
            ImgSketch_Seg()
            ImgSketch.px = ImgSketch.qx
            ImgSketch.py = ImgSketch.qy
            ImgSketch.k = Add(ImgSketch.k, 1)
        }
    }
}

Function.ImgSketch_RasterPoly {
    Input: surf: Integer
    Body: {
        ImgWalk.surf = surf
        IfCondition LessThan(ImgSketch.npts, 2) ThenBlock: {
            ReturnValue(0)
        }
        ImgSketch.i = 1
        WhileLoop LessThan(ImgSketch.i, ImgSketch.npts) {
            ImgSketch_LoadPt(Subtract(ImgSketch.i, 1))
            ImgSketch.px = ImgSketch.x0
            ImgSketch.py = ImgSketch.y0
            ImgSketch_LoadPt(ImgSketch.i)
            ImgSketch.qx = ImgSketch.x0
            ImgSketch.qy = ImgSketch.y0
            ImgSketch_Seg()
            ImgSketch.i = Add(ImgSketch.i, 1)
        }
    }
}

Function.ImgSketch_RasterSpline {
    Input: surf: Integer
    Body: {
        ImgWalk.surf = surf
        IfCondition LessThan(ImgSketch.npts, 2) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition LessThan(ImgSketch.npts, 3) ThenBlock: {
            ImgSketch_RasterPoly(surf)
            ReturnValue(0)
        }
        ImgSketch.i = 0
        WhileLoop LessThan(ImgSketch.i, Subtract(ImgSketch.npts, 1)) {
            ImgSketch.k = Subtract(ImgSketch.i, 1)
            IfCondition LessThan(ImgSketch.k, 0) ThenBlock: { ImgSketch.k = 0 }
            ImgSketch_LoadPt(ImgSketch.k)
            ImgSketch.a2 = ImgSketch.x0
            ImgSketch.b2 = ImgSketch.y0
            ImgSketch_LoadPt(ImgSketch.i)
            ImgSketch.x1 = ImgSketch.x0
            ImgSketch.y1 = ImgSketch.y0
            ImgSketch.k = Add(ImgSketch.i, 1)
            IfCondition GreaterEqual(ImgSketch.k, ImgSketch.npts) ThenBlock: {
                ImgSketch.k = Subtract(ImgSketch.npts, 1)
            }
            ImgSketch_LoadPt(ImgSketch.k)
            ImgSketch.u = ImgSketch.x0
            ImgSketch.t = ImgSketch.y0
            ImgSketch.k = Add(ImgSketch.i, 2)
            IfCondition GreaterEqual(ImgSketch.k, ImgSketch.npts) ThenBlock: {
                ImgSketch.k = Subtract(ImgSketch.npts, 1)
            }
            ImgSketch_LoadPt(ImgSketch.k)
            ImgSketch.cx = ImgSketch.x0
            ImgSketch.cy = ImgSketch.y0
            ImgSketch.px = ImgSketch.x1
            ImgSketch.py = ImgSketch.y1
            ImgSketch.k = 1
            WhileLoop LessEqual(ImgSketch.k, 8) {
                ImgSketch.d = Multiply(Multiply(ImgSketch.k, ImgSketch.k), ImgSketch.k)
                ImgSketch.qx = Multiply(1024, ImgSketch.x1)
                ImgSketch.qx = Add(ImgSketch.qx, Multiply(Multiply(Subtract(ImgSketch.u, ImgSketch.a2), ImgSketch.k), 64))
                ImgSketch.c2 = Subtract(Multiply(ImgSketch.a2, 2), Multiply(ImgSketch.x1, 5))
                ImgSketch.c2 = Add(ImgSketch.c2, Multiply(ImgSketch.u, 4))
                ImgSketch.c2 = Subtract(ImgSketch.c2, ImgSketch.cx)
                ImgSketch.qx = Add(ImgSketch.qx, Multiply(ImgSketch.c2, Multiply(Multiply(ImgSketch.k, ImgSketch.k), 8)))
                ImgSketch.c2 = Add(Subtract(0, ImgSketch.a2), Multiply(ImgSketch.x1, 3))
                ImgSketch.c2 = Subtract(ImgSketch.c2, Multiply(ImgSketch.u, 3))
                ImgSketch.c2 = Add(ImgSketch.c2, ImgSketch.cx)
                ImgSketch.qx = Divide(Add(ImgSketch.qx, Multiply(ImgSketch.c2, ImgSketch.d)), 1024)
                ImgSketch.qy = Multiply(1024, ImgSketch.y1)
                ImgSketch.qy = Add(ImgSketch.qy, Multiply(Multiply(Subtract(ImgSketch.t, ImgSketch.b2), ImgSketch.k), 64))
                ImgSketch.c2 = Subtract(Multiply(ImgSketch.b2, 2), Multiply(ImgSketch.y1, 5))
                ImgSketch.c2 = Add(ImgSketch.c2, Multiply(ImgSketch.t, 4))
                ImgSketch.c2 = Subtract(ImgSketch.c2, ImgSketch.cy)
                ImgSketch.qy = Add(ImgSketch.qy, Multiply(ImgSketch.c2, Multiply(Multiply(ImgSketch.k, ImgSketch.k), 8)))
                ImgSketch.c2 = Add(Subtract(0, ImgSketch.b2), Multiply(ImgSketch.y1, 3))
                ImgSketch.c2 = Subtract(ImgSketch.c2, Multiply(ImgSketch.t, 3))
                ImgSketch.c2 = Add(ImgSketch.c2, ImgSketch.cy)
                ImgSketch.qy = Divide(Add(ImgSketch.qy, Multiply(ImgSketch.c2, ImgSketch.d)), 1024)
                ImgSketch_Seg()
                ImgSketch.px = ImgSketch.qx
                ImgSketch.py = ImgSketch.qy
                ImgSketch.k = Add(ImgSketch.k, 1)
            }
            ImgSketch.i = Add(ImgSketch.i, 1)
        }
    }
}
