// Library.GGUF.ailang
// GGUF v3 binary format parser. Reads header, metadata KV pairs, tensor directory.
// No external dependencies beyond syscalls and LLM/State.ailang FixedPools.
// Copyright (c) 2026 Sean Collins, 2 Paws Machine and Engineering. All rights reserved. SCSL.
//
// USAGE
//   LibraryImport.LLM.GGUF

// =============================================================================
// GGUF CONSTANTS
// =============================================================================
FixedPool.GGUFConst {
    "MAGIC":            Initialize=1179993927   // 0x46554747 = "GGUF" LE
    "VERSION":          Initialize=3
    "HEADER_SIZE":      Initialize=24           // 4+4+8+8 bytes
    "DEFAULT_ALIGN":    Initialize=32
}

// =============================================================================
// GGUF PARSE STATE — tracks file position and read buffers
// =============================================================================
FixedPool.GGUFParse {
    "fd":               Initialize=0, CanChange=True
    "pos":              Initialize=0, CanChange=True   // current file position
    "read_buf":         Initialize=0, CanChange=True   // 4KB scratch buffer
    "str_buf":          Initialize=0, CanChange=True   // 1KB string scratch
    "initialized":      Initialize=0, CanChange=True
}

// =============================================================================
// GGUF TYPE CONSTANTS — metadata value types
// =============================================================================
FixedPool.GGUFType {
    "UINT8":    Initialize=0
    "INT8":     Initialize=1
    "UINT16":   Initialize=2
    "INT16":    Initialize=3
    "UINT32":   Initialize=4
    "INT32":    Initialize=5
    "FLOAT32":  Initialize=6
    "BOOL":     Initialize=7
    "STRING":   Initialize=8
    "ARRAY":    Initialize=9
    "UINT64":   Initialize=10
    "INT64":    Initialize=11
    "FLOAT64":  Initialize=12
}

// =============================================================================
// GGML QUANTIZATION TYPE CONSTANTS
// =============================================================================
FixedPool.GGMLType {
    "F32":      Initialize=0
    "F16":      Initialize=1
    "Q4_0":     Initialize=2
    "Q4_1":     Initialize=3
    "Q5_0":     Initialize=6
    "Q5_1":     Initialize=7
    "Q8_0":     Initialize=8
    "Q8_1":     Initialize=9
    "Q2_K":     Initialize=10
    "Q3_K":     Initialize=11
    "Q4_K":     Initialize=12
    "Q5_K":     Initialize=13
    "Q6_K":     Initialize=14
    "Q8_K":     Initialize=15
    "I8":       Initialize=24
    "I16":      Initialize=25
    "I32":      Initialize=26
    "I64":      Initialize=27
    "F64":      Initialize=28
    "BF16":     Initialize=30
}

// =============================================================================
// GGUF BLOCK SIZES — elements per quantization block
// =============================================================================
FixedPool.GGMLBlock {
    "QK4_0":    Initialize=32
    "QK8_0":    Initialize=32
    "QK_K":     Initialize=256
    // Bytes per block (for stride calculation)
    "BPB_F32":    Initialize=4     // 1 element * 4 bytes
    "BPB_F16":    Initialize=2     // 1 element * 2 bytes
    "BPB_Q4_0":   Initialize=18    // 2 (f16 scale) + 16 (nibbles)
    "BPB_Q8_0":   Initialize=34    // 2 (f16 scale) + 32 (int8 values)
    "BPB_Q4_K":   Initialize=144   // 256-element super-block
    "BPB_Q6_K":   Initialize=210   // 256-element super-block
}

// =============================================================================
// GGUF HEADER STATE — populated during parse
// =============================================================================
FixedPool.GGUFHeader {
    "magic":            Initialize=0, CanChange=True
    "version":          Initialize=0, CanChange=True
    "n_tensors":        Initialize=0, CanChange=True
    "n_kv":             Initialize=0, CanChange=True
}

// =============================================================================
// TENSOR DIRECTORY — flat array of tensor metadata entries
// Each entry: 64 bytes
//   +0:  name_hash    (8 bytes) — hash of tensor name for fast lookup
//   +8:  name_ptr     (8 bytes) — pointer to name string (null-terminated)
//   +16: n_dims       (8 bytes)
//   +24: dim0         (8 bytes)
//   +32: dim1         (8 bytes)
//   +40: type         (8 bytes) — GGMLType
//   +48: data_offset  (8 bytes) — offset from data section start
//   +56: data_size    (8 bytes) — total bytes for this tensor
// =============================================================================
FixedPool.TensorDir {
    "entries":      Initialize=0, CanChange=True   // ptr to allocated array
    "count":        Initialize=0, CanChange=True
    "max_entries":  Initialize=1024, CanChange=False
    "ENTRY_SIZE":   Initialize=64, CanChange=False
}

FixedPool.TensorField {
    "NAME_HASH":    Initialize=0
    "NAME_PTR":     Initialize=8
    "N_DIMS":       Initialize=16
    "DIM0":         Initialize=24
    "DIM1":         Initialize=32
    "TYPE":         Initialize=40
    "DATA_OFFSET":  Initialize=48
    "DATA_SIZE":    Initialize=56
}

// =============================================================================
// MODEL CONFIGURATION — populated from GGUF metadata at load time
// Shared between library and LLM runtime files
// =============================================================================
FixedPool.LLMConfig {
    "arch":             Initialize=0, CanChange=True   // architecture string ptr
    "vocab_size":       Initialize=0, CanChange=True
    "context_length":   Initialize=2048, CanChange=True
    "d_model":          Initialize=0, CanChange=True   // embedding_length
    "d_ff":             Initialize=0, CanChange=True   // feed_forward_length
    "n_layers":         Initialize=0, CanChange=True   // block_count
    "n_heads":          Initialize=0, CanChange=True   // attention.head_count
    "n_kv_heads":       Initialize=0, CanChange=True   // attention.head_count_kv (GQA)
    "head_dim":         Initialize=0, CanChange=True   // d_model / n_heads
    "rope_dim":         Initialize=0, CanChange=True   // rope.dimension_count
    "rope_freq_base":   Initialize=10000, CanChange=True  // rope.freq_base (stored as int * 100)
    "rms_norm_eps":     Initialize=1, CanChange=True   // layer_norm_rms_epsilon (stored as int, scaled)
    "n_tensors":        Initialize=0, CanChange=True   // total tensor count from GGUF header
    "file_size":        Initialize=0, CanChange=True   // total file size in bytes
    "data_offset":      Initialize=0, CanChange=True   // byte offset where tensor data begins
    "quant_type":       Initialize=8, CanChange=True   // dominant quantization type (default Q8_0)
}

// =============================================================================
// TOKENIZER STATE — populated from GGUF metadata
// =============================================================================
FixedPool.LLMTokenizer {
    "vocab":        Initialize=0, CanChange=True   // ptr to vocab table (id → string ptr, 8 bytes each)
    "vocab_len":    Initialize=0, CanChange=True   // ptr to token length table (8 bytes each)
    "merges":       Initialize=0, CanChange=True   // ptr to merge string table (string ptr, 8 bytes each)
    "merge_count":  Initialize=0, CanChange=True   // number of merges
    "vocab_size":   Initialize=0, CanChange=True
    "bos_id":       Initialize=1, CanChange=True   // beginning of sequence
    "eos_id":       Initialize=2, CanChange=True   // end of sequence
    "unk_id":       Initialize=0, CanChange=True   // unknown token
    "pad_id":       Initialize=2, CanChange=True
    "initialized":  Initialize=0, CanChange=True
}

// =============================================================================
// GGUF ARRAY READ CARRIER — working state for reading tokenizer arrays
// =============================================================================
FixedPool.GGUFArrayW {
    "idx":          Initialize=0, CanChange=True
    "count":        Initialize=0, CanChange=True
    "elem_type":    Initialize=0, CanChange=True
    "slen":         Initialize=0, CanChange=True
    "str_ptr":      Initialize=0, CanChange=True
}

// =============================================================================
// SYSCALL CONSTANTS
// =============================================================================
FixedPool.LLMSys {
    "SYS_READ":     Initialize=0
    "SYS_WRITE":    Initialize=1
    "SYS_OPEN":     Initialize=2
    "SYS_CLOSE":    Initialize=3
    "SYS_STAT":     Initialize=4
    "SYS_MMAP":     Initialize=9
    "SYS_MUNMAP":   Initialize=11
    "O_RDONLY":      Initialize=0
    "PROT_READ":     Initialize=1
    "MAP_PRIVATE":   Initialize=2
    "STDOUT":        Initialize=1
}

// =============================================================================
// GGUF_Init — allocate parse buffers
// =============================================================================
Function.GGUF_Init {
    Body: {
        IfCondition EqualTo(GGUFParse.initialized, 1) ThenBlock: {
            ReturnValue(0)
        }
        GGUFParse.read_buf = Allocate(4096)
        GGUFParse.str_buf  = Allocate(1024)
        MemorySet(GGUFParse.read_buf, 0, 4096)
        MemorySet(GGUFParse.str_buf, 0, 1024)
        GGUFParse.initialized = 1
        ReturnValue(0)
    }
}

// =============================================================================
// GGUF_ReadBytes — read exactly N bytes from GGUFParse.fd
// Returns bytes read, advances GGUFParse.pos
// =============================================================================
Function.GGUF_ReadBytes {
    Input: dst: Address
    Input: nbytes: Integer
    Output: Integer
    Body: {
        total = 0
        WhileLoop LessThan(total, nbytes) {
            remain = Subtract(nbytes, total)
            got = SystemCall(0, GGUFParse.fd, Add(dst, total), remain, 0, 0)
            IfCondition LessEqual(got, 0) ThenBlock: {
                ReturnValue(total)
            }
            total = Add(total, got)
        }
        GGUFParse.pos = Add(GGUFParse.pos, total)
        ReturnValue(total)
    }
}

// =============================================================================
// GGUF_ReadU32 — read a little-endian uint32
// =============================================================================
Function.GGUF_ReadU32 {
    Output: Integer
    Body: {
        buf = GGUFParse.read_buf
        MemorySet(buf, 0, 8)
        GGUF_ReadBytes(buf, 4)
        b0 = GetByte(buf, 0)
        b1 = GetByte(buf, 1)
        b2 = GetByte(buf, 2)
        b3 = GetByte(buf, 3)
        ReturnValue(BitwiseOr(b0, BitwiseOr(LeftShift(b1, 8), BitwiseOr(LeftShift(b2, 16), LeftShift(b3, 24)))))
    }
}

// =============================================================================
// GGUF_ReadU64 — read a little-endian uint64/int64
// =============================================================================
Function.GGUF_ReadU64 {
    Output: Integer
    Body: {
        buf = GGUFParse.read_buf
        MemorySet(buf, 0, 8)
        GGUF_ReadBytes(buf, 8)
        ReturnValue(Dereference(buf))
    }
}

// =============================================================================
// GGUF_ReadF32 — read a 32-bit float, return as integer bits
// =============================================================================
Function.GGUF_ReadF32 {
    Output: Integer
    Body: {
        buf = GGUFParse.read_buf
        MemorySet(buf, 0, 8)
        GGUF_ReadBytes(buf, 4)
        b0 = GetByte(buf, 0)
        b1 = GetByte(buf, 1)
        b2 = GetByte(buf, 2)
        b3 = GetByte(buf, 3)
        ReturnValue(BitwiseOr(b0, BitwiseOr(LeftShift(b1, 8), BitwiseOr(LeftShift(b2, 16), LeftShift(b3, 24)))))
    }
}

// =============================================================================
// GGUF_ReadString — read a GGUF string (uint64 len + bytes) into str_buf
// Returns length of string. String is null-terminated in str_buf.
// =============================================================================
Function.GGUF_ReadString {
    Output: Integer
    Body: {
        slen = GGUF_ReadU64()
        read_len = slen
        IfCondition GreaterThan(read_len, 1023) ThenBlock: {
            read_len = 1023
        }
        buf = GGUFParse.str_buf
        MemorySet(buf, 0, 1024)
        GGUF_ReadBytes(buf, read_len)
        SetByte(buf, read_len, 0)
        // If string was longer than 1023, skip remaining bytes
        IfCondition GreaterThan(slen, 1023) ThenBlock: {
            skip = Subtract(slen, 1023)
            WhileLoop GreaterThan(skip, 0) {
                chunk = skip
                IfCondition GreaterThan(chunk, 4096) ThenBlock: {
                    chunk = 4096
                }
                GGUF_ReadBytes(GGUFParse.read_buf, chunk)
                skip = Subtract(skip, chunk)
            }
        }
        ReturnValue(slen)
    }
}

// =============================================================================
// GGUF_AllocString — copy str_buf to a fresh heap allocation, return ptr
// =============================================================================
Function.GGUF_AllocString {
    Input: slen: Integer
    Output: Address
    Body: {
        alloc_len = Add(slen, 1)
        alloc_len = Multiply(Divide(Add(alloc_len, 7), 8), 8)
        dst = Allocate(alloc_len)
        MemorySet(dst, 0, alloc_len)
        i = 0
        WhileLoop LessThan(i, slen) {
            SetByte(dst, i, GetByte(GGUFParse.str_buf, i))
            i = Add(i, 1)
        }
        ReturnValue(dst)
    }
}

// =============================================================================
// GGUF_SkipValue — skip over a metadata value of given type
// =============================================================================
Function.GGUF_SkipValue {
    Input: vtype: Integer
    Body: {
        skip_buf = GGUFParse.read_buf

        IfCondition EqualTo(vtype, GGUFType.UINT8)   ThenBlock: { GGUF_ReadBytes(skip_buf, 1) ReturnValue(0) }
        IfCondition EqualTo(vtype, GGUFType.INT8)    ThenBlock: { GGUF_ReadBytes(skip_buf, 1) ReturnValue(0) }
        IfCondition EqualTo(vtype, GGUFType.BOOL)    ThenBlock: { GGUF_ReadBytes(skip_buf, 1) ReturnValue(0) }
        IfCondition EqualTo(vtype, GGUFType.UINT16)  ThenBlock: { GGUF_ReadBytes(skip_buf, 2) ReturnValue(0) }
        IfCondition EqualTo(vtype, GGUFType.INT16)   ThenBlock: { GGUF_ReadBytes(skip_buf, 2) ReturnValue(0) }
        IfCondition EqualTo(vtype, GGUFType.UINT32)  ThenBlock: { GGUF_ReadBytes(skip_buf, 4) ReturnValue(0) }
        IfCondition EqualTo(vtype, GGUFType.INT32)   ThenBlock: { GGUF_ReadBytes(skip_buf, 4) ReturnValue(0) }
        IfCondition EqualTo(vtype, GGUFType.FLOAT32) ThenBlock: { GGUF_ReadBytes(skip_buf, 4) ReturnValue(0) }
        IfCondition EqualTo(vtype, GGUFType.UINT64)  ThenBlock: { GGUF_ReadBytes(skip_buf, 8) ReturnValue(0) }
        IfCondition EqualTo(vtype, GGUFType.INT64)   ThenBlock: { GGUF_ReadBytes(skip_buf, 8) ReturnValue(0) }
        IfCondition EqualTo(vtype, GGUFType.FLOAT64) ThenBlock: { GGUF_ReadBytes(skip_buf, 8) ReturnValue(0) }

        IfCondition EqualTo(vtype, GGUFType.STRING) ThenBlock: {
            GGUF_ReadString()
            ReturnValue(0)
        }

        // Array — read element type + count, then skip each element
        IfCondition EqualTo(vtype, GGUFType.ARRAY) ThenBlock: {
            elem_type = GGUF_ReadU32()
            elem_count = GGUF_ReadU64()
            i = 0
            WhileLoop LessThan(i, elem_count) {
                GGUF_SkipValue(elem_type)
                i = Add(i, 1)
            }
            ReturnValue(0)
        }

        PrintMessage("[GGUF] WARNING: unknown value type ")
        PrintNumber(vtype)
        PrintMessage(", cannot skip\n")
        ReturnValue(-1)
    }
}

// =============================================================================
// GGUF_StringMatch — compare str_buf against a literal suffix
// Returns 1 if match, 0 if not.
// =============================================================================
Function.GGUF_StringMatch {
    Input: target: Address
    Input: target_len: Integer
    Input: key_len: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(key_len, target_len) ThenBlock: {
            ReturnValue(0)
        }
        start = Subtract(key_len, target_len)
        i = 0
        WhileLoop LessThan(i, target_len) {
            kc = GetByte(GGUFParse.str_buf, Add(start, i))
            tc = GetByte(target, i)
            IfCondition NotEqual(kc, tc) ThenBlock: {
                ReturnValue(0)
            }
            i = Add(i, 1)
        }
        ReturnValue(1)
    }
}

// =============================================================================
// GGUF_ParseHeader — read and validate the GGUF file header
// GGUFParse.fd and GGUFParse.pos must be set before calling.
// Returns 0 on success, -1 on error
// =============================================================================
Function.GGUF_ParseHeader {
    Output: Integer
    Body: {
        GGUF_Init()
        GGUFParse.pos = 0

        magic = GGUF_ReadU32()
        IfCondition NotEqual(magic, GGUFConst.MAGIC) ThenBlock: {
            PrintMessage("[GGUF] ERROR: bad magic\n")
            ReturnValue(-1)
        }

        version = GGUF_ReadU32()
        IfCondition LessThan(version, 2) ThenBlock: {
            PrintMessage("[GGUF] ERROR: unsupported version\n")
            ReturnValue(-1)
        }

        GGUFHeader.magic = magic
        GGUFHeader.version = version
        GGUFHeader.n_tensors = GGUF_ReadU64()
        GGUFHeader.n_kv = GGUF_ReadU64()

        PrintMessage("[GGUF] Header: version=")
        PrintNumber(GGUFHeader.version)
        PrintMessage(" tensors=")
        PrintNumber(GGUFHeader.n_tensors)
        PrintMessage(" kv_pairs=")
        PrintNumber(GGUFHeader.n_kv)
        PrintMessage("\n")

        ReturnValue(0)
    }
}

// =============================================================================
// GGUF_ParseMetadata — read all KV pairs, extract model config
// Must be called after GGUF_ParseHeader. All reads use GGUFParse.fd.
// Returns 0 on success.
// =============================================================================
Function.GGUF_ParseMetadata {
    Output: Integer
    Body: {
        kv_idx = 0

        WhileLoop LessThan(kv_idx, GGUFHeader.n_kv) {
            key_len = GGUF_ReadString()
            vtype = GGUF_ReadU32()
            matched = 0

            // --- general.architecture ---
            IfCondition EqualTo(GGUF_StringMatch("general.architecture", 20, key_len), 1) ThenBlock: {
                IfCondition EqualTo(vtype, GGUFType.STRING) ThenBlock: {
                    slen = GGUF_ReadString()
                    LLMConfig.arch = GGUF_AllocString(slen)
                    PrintMessage("[GGUF] architecture: ")
                    PrintString(LLMConfig.arch)
                    PrintMessage("\n")
                    matched = 1
                }
            }

            // --- .block_count (n_layers) ---
            IfCondition EqualTo(matched, 0) ThenBlock: {
                IfCondition EqualTo(GGUF_StringMatch("block_count", 11, key_len), 1) ThenBlock: {
                    IfCondition EqualTo(vtype, GGUFType.UINT32) ThenBlock: {
                        LLMConfig.n_layers = GGUF_ReadU32()
                        matched = 1
                    }
                }
            }

            // --- .embedding_length (d_model) ---
            IfCondition EqualTo(matched, 0) ThenBlock: {
                IfCondition EqualTo(GGUF_StringMatch("embedding_length", 16, key_len), 1) ThenBlock: {
                    IfCondition EqualTo(vtype, GGUFType.UINT32) ThenBlock: {
                        LLMConfig.d_model = GGUF_ReadU32()
                        matched = 1
                    }
                }
            }

            // --- .feed_forward_length (d_ff) ---
            IfCondition EqualTo(matched, 0) ThenBlock: {
                IfCondition EqualTo(GGUF_StringMatch("feed_forward_length", 19, key_len), 1) ThenBlock: {
                    IfCondition EqualTo(vtype, GGUFType.UINT32) ThenBlock: {
                        LLMConfig.d_ff = GGUF_ReadU32()
                        matched = 1
                    }
                }
            }

            // --- .attention.head_count (n_heads) ---
            IfCondition EqualTo(matched, 0) ThenBlock: {
                IfCondition EqualTo(GGUF_StringMatch("attention.head_count", 20, key_len), 1) ThenBlock: {
                    IfCondition EqualTo(vtype, GGUFType.UINT32) ThenBlock: {
                        kv_check = GGUF_StringMatch("head_count_kv", 13, key_len)
                        IfCondition EqualTo(kv_check, 0) ThenBlock: {
                            LLMConfig.n_heads = GGUF_ReadU32()
                            matched = 1
                        }
                    }
                }
            }

            // --- .attention.head_count_kv (n_kv_heads for GQA) ---
            IfCondition EqualTo(matched, 0) ThenBlock: {
                IfCondition EqualTo(GGUF_StringMatch("head_count_kv", 13, key_len), 1) ThenBlock: {
                    IfCondition EqualTo(vtype, GGUFType.UINT32) ThenBlock: {
                        LLMConfig.n_kv_heads = GGUF_ReadU32()
                        matched = 1
                    }
                }
            }

            // --- .vocab_size ---
            IfCondition EqualTo(matched, 0) ThenBlock: {
                IfCondition EqualTo(GGUF_StringMatch("vocab_size", 10, key_len), 1) ThenBlock: {
                    IfCondition EqualTo(vtype, GGUFType.UINT32) ThenBlock: {
                        LLMConfig.vocab_size = GGUF_ReadU32()
                        matched = 1
                    }
                }
            }

            // --- .context_length ---
            IfCondition EqualTo(matched, 0) ThenBlock: {
                IfCondition EqualTo(GGUF_StringMatch("context_length", 14, key_len), 1) ThenBlock: {
                    IfCondition EqualTo(vtype, GGUFType.UINT32) ThenBlock: {
                        LLMConfig.context_length = GGUF_ReadU32()
                        matched = 1
                    }
                }
            }

            // --- .rope.dimension_count ---
            IfCondition EqualTo(matched, 0) ThenBlock: {
                IfCondition EqualTo(GGUF_StringMatch("rope.dimension_count", 20, key_len), 1) ThenBlock: {
                    IfCondition EqualTo(vtype, GGUFType.UINT32) ThenBlock: {
                        LLMConfig.rope_dim = GGUF_ReadU32()
                        matched = 1
                    }
                }
            }

            // --- .attention.layer_norm_rms_epsilon ---
            IfCondition EqualTo(matched, 0) ThenBlock: {
                IfCondition EqualTo(GGUF_StringMatch("layer_norm_rms_epsilon", 22, key_len), 1) ThenBlock: {
                    IfCondition EqualTo(vtype, GGUFType.FLOAT32) ThenBlock: {
                        LLMConfig.rms_norm_eps = GGUF_ReadF32()
                        matched = 1
                    }
                }
            }

            // --- tokenizer.ggml.bos_token_id ---
            IfCondition EqualTo(matched, 0) ThenBlock: {
                IfCondition EqualTo(GGUF_StringMatch("bos_token_id", 12, key_len), 1) ThenBlock: {
                    IfCondition EqualTo(vtype, GGUFType.UINT32) ThenBlock: {
                        LLMTokenizer.bos_id = GGUF_ReadU32()
                        matched = 1
                    }
                }
            }

            // --- tokenizer.ggml.eos_token_id ---
            IfCondition EqualTo(matched, 0) ThenBlock: {
                IfCondition EqualTo(GGUF_StringMatch("eos_token_id", 12, key_len), 1) ThenBlock: {
                    IfCondition EqualTo(vtype, GGUFType.UINT32) ThenBlock: {
                        LLMTokenizer.eos_id = GGUF_ReadU32()
                        matched = 1
                    }
                }
            }

            // --- tokenizer.ggml.unknown_token_id ---
            IfCondition EqualTo(matched, 0) ThenBlock: {
                IfCondition EqualTo(GGUF_StringMatch("unknown_token_id", 16, key_len), 1) ThenBlock: {
                    IfCondition EqualTo(vtype, GGUFType.UINT32) ThenBlock: {
                        LLMTokenizer.unk_id = GGUF_ReadU32()
                        matched = 1
                    }
                }
            }

            // --- tokenizer.ggml.tokens (string array → vocab table) ---
            IfCondition EqualTo(matched, 0) ThenBlock: {
                IfCondition EqualTo(GGUF_StringMatch("tokenizer.ggml.tokens", 21, key_len), 1) ThenBlock: {
                    IfCondition EqualTo(vtype, GGUFType.ARRAY) ThenBlock: {
                        GGUFArrayW.elem_type = GGUF_ReadU32()
                        GGUFArrayW.count = GGUF_ReadU64()
                        LLMTokenizer.vocab_size = GGUFArrayW.count

                        // Allocate pointer array and length array
                        LLMTokenizer.vocab = Allocate(Multiply(GGUFArrayW.count, 8))
                        LLMTokenizer.vocab_len = Allocate(Multiply(GGUFArrayW.count, 8))
                        MemorySet(LLMTokenizer.vocab, 0, Multiply(GGUFArrayW.count, 8))
                        MemorySet(LLMTokenizer.vocab_len, 0, Multiply(GGUFArrayW.count, 8))

                        GGUFArrayW.idx = 0
                        WhileLoop LessThan(GGUFArrayW.idx, GGUFArrayW.count) {
                            GGUFArrayW.slen = GGUF_ReadString()
                            GGUFArrayW.str_ptr = GGUF_AllocString(GGUFArrayW.slen)
                            StoreValue(Add(LLMTokenizer.vocab, Multiply(GGUFArrayW.idx, 8)), GGUFArrayW.str_ptr)
                            StoreValue(Add(LLMTokenizer.vocab_len, Multiply(GGUFArrayW.idx, 8)), GGUFArrayW.slen)
                            GGUFArrayW.idx = Add(GGUFArrayW.idx, 1)
                        }

                        PrintMessage("[GGUF] Loaded vocab: ")
                        PrintNumber(GGUFArrayW.count)
                        PrintMessage(" tokens\n")
                        matched = 1
                    }
                }
            }

            // --- tokenizer.ggml.merges (string array → merge table) ---
            IfCondition EqualTo(matched, 0) ThenBlock: {
                IfCondition EqualTo(GGUF_StringMatch("tokenizer.ggml.merges", 21, key_len), 1) ThenBlock: {
                    IfCondition EqualTo(vtype, GGUFType.ARRAY) ThenBlock: {
                        GGUFArrayW.elem_type = GGUF_ReadU32()
                        GGUFArrayW.count = GGUF_ReadU64()
                        LLMTokenizer.merge_count = GGUFArrayW.count

                        // Allocate pointer array for merge strings
                        LLMTokenizer.merges = Allocate(Multiply(GGUFArrayW.count, 8))
                        MemorySet(LLMTokenizer.merges, 0, Multiply(GGUFArrayW.count, 8))

                        GGUFArrayW.idx = 0
                        WhileLoop LessThan(GGUFArrayW.idx, GGUFArrayW.count) {
                            GGUFArrayW.slen = GGUF_ReadString()
                            GGUFArrayW.str_ptr = GGUF_AllocString(GGUFArrayW.slen)
                            StoreValue(Add(LLMTokenizer.merges, Multiply(GGUFArrayW.idx, 8)), GGUFArrayW.str_ptr)
                            GGUFArrayW.idx = Add(GGUFArrayW.idx, 1)
                        }

                        PrintMessage("[GGUF] Loaded merges: ")
                        PrintNumber(GGUFArrayW.count)
                        PrintMessage(" rules\n")
                        matched = 1
                    }
                }
            }

            // If not matched, skip the value
            IfCondition EqualTo(matched, 0) ThenBlock: {
                GGUF_SkipValue(vtype)
            }

            kv_idx = Add(kv_idx, 1)
        }

        // Derive head_dim
        IfCondition GreaterThan(LLMConfig.n_heads, 0) ThenBlock: {
            LLMConfig.head_dim = Divide(LLMConfig.d_model, LLMConfig.n_heads)
        }

        IfCondition EqualTo(LLMConfig.n_kv_heads, 0) ThenBlock: {
            LLMConfig.n_kv_heads = LLMConfig.n_heads
        }

        IfCondition EqualTo(LLMConfig.rope_dim, 0) ThenBlock: {
            LLMConfig.rope_dim = LLMConfig.head_dim
        }

        LLMConfig.n_tensors = GGUFHeader.n_tensors

        PrintMessage("[GGUF] Metadata parsed: ")
        PrintNumber(GGUFHeader.n_kv)
        PrintMessage(" KV pairs\n")

        ReturnValue(0)
    }
}

// =============================================================================
// GGUF_TypeSize — return bytes per element for a given ggml type
// For block types, returns bytes per BLOCK (not per element)
// =============================================================================
Function.GGUF_TypeSize {
    Input: qtype: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(qtype, GGMLType.F32)   ThenBlock: { ReturnValue(4) }
        IfCondition EqualTo(qtype, GGMLType.F16)   ThenBlock: { ReturnValue(2) }
        IfCondition EqualTo(qtype, GGMLType.BF16)  ThenBlock: { ReturnValue(2) }
        IfCondition EqualTo(qtype, GGMLType.Q4_0)  ThenBlock: { ReturnValue(18) }
        IfCondition EqualTo(qtype, GGMLType.Q4_1)  ThenBlock: { ReturnValue(20) }
        IfCondition EqualTo(qtype, GGMLType.Q5_0)  ThenBlock: { ReturnValue(22) }
        IfCondition EqualTo(qtype, GGMLType.Q5_1)  ThenBlock: { ReturnValue(24) }
        IfCondition EqualTo(qtype, GGMLType.Q8_0)  ThenBlock: { ReturnValue(34) }
        IfCondition EqualTo(qtype, GGMLType.Q8_1)  ThenBlock: { ReturnValue(36) }
        IfCondition EqualTo(qtype, GGMLType.Q2_K)  ThenBlock: { ReturnValue(84) }
        IfCondition EqualTo(qtype, GGMLType.Q3_K)  ThenBlock: { ReturnValue(110) }
        IfCondition EqualTo(qtype, GGMLType.Q4_K)  ThenBlock: { ReturnValue(144) }
        IfCondition EqualTo(qtype, GGMLType.Q5_K)  ThenBlock: { ReturnValue(184) }
        IfCondition EqualTo(qtype, GGMLType.Q6_K)  ThenBlock: { ReturnValue(210) }
        IfCondition EqualTo(qtype, GGMLType.Q8_K)  ThenBlock: { ReturnValue(292) }
        IfCondition EqualTo(qtype, GGMLType.I8)    ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(qtype, GGMLType.I16)   ThenBlock: { ReturnValue(2) }
        IfCondition EqualTo(qtype, GGMLType.I32)   ThenBlock: { ReturnValue(4) }
        IfCondition EqualTo(qtype, GGMLType.I64)   ThenBlock: { ReturnValue(8) }
        IfCondition EqualTo(qtype, GGMLType.F64)   ThenBlock: { ReturnValue(8) }
        // Unknown
        ReturnValue(0)
    }
}

// =============================================================================
// GGUF_BlockSize — elements per quantization block for a given type
// =============================================================================
Function.GGUF_BlockSize {
    Input: qtype: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(qtype, GGMLType.F32)   ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(qtype, GGMLType.F16)   ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(qtype, GGMLType.BF16)  ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(qtype, GGMLType.Q4_0)  ThenBlock: { ReturnValue(32) }
        IfCondition EqualTo(qtype, GGMLType.Q4_1)  ThenBlock: { ReturnValue(32) }
        IfCondition EqualTo(qtype, GGMLType.Q5_0)  ThenBlock: { ReturnValue(32) }
        IfCondition EqualTo(qtype, GGMLType.Q5_1)  ThenBlock: { ReturnValue(32) }
        IfCondition EqualTo(qtype, GGMLType.Q8_0)  ThenBlock: { ReturnValue(32) }
        IfCondition EqualTo(qtype, GGMLType.Q8_1)  ThenBlock: { ReturnValue(32) }
        IfCondition EqualTo(qtype, GGMLType.Q2_K)  ThenBlock: { ReturnValue(256) }
        IfCondition EqualTo(qtype, GGMLType.Q3_K)  ThenBlock: { ReturnValue(256) }
        IfCondition EqualTo(qtype, GGMLType.Q4_K)  ThenBlock: { ReturnValue(256) }
        IfCondition EqualTo(qtype, GGMLType.Q5_K)  ThenBlock: { ReturnValue(256) }
        IfCondition EqualTo(qtype, GGMLType.Q6_K)  ThenBlock: { ReturnValue(256) }
        IfCondition EqualTo(qtype, GGMLType.Q8_K)  ThenBlock: { ReturnValue(256) }
        IfCondition EqualTo(qtype, GGMLType.I8)    ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(qtype, GGMLType.I16)   ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(qtype, GGMLType.I32)   ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(qtype, GGMLType.I64)   ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(qtype, GGMLType.F64)   ThenBlock: { ReturnValue(1) }
        ReturnValue(1)
    }
}

// =============================================================================
// GGUF_TensorDataSize — compute total bytes for a tensor given type and dims
// =============================================================================
Function.GGUF_TensorDataSize {
    Input: qtype: Integer
    Input: n_elements: Integer
    Output: Integer
    Body: {
        block_size = GGUF_BlockSize(qtype)
        type_size = GGUF_TypeSize(qtype)
        IfCondition EqualTo(block_size, 0) ThenBlock: {
            ReturnValue(0)
        }
        // n_blocks = n_elements / block_size (must be evenly divisible for block types)
        n_blocks = Divide(n_elements, block_size)
        ReturnValue(Multiply(n_blocks, type_size))
    }
}

// =============================================================================
// TENSOR PARSE CARRIER — working state for GGUF_ParseOneTensor
// Avoids too many locals in a single function (compiler stack limit)
// =============================================================================
FixedPool.GGUFTensorW {
    "idx":          Initialize=0, CanChange=True    // loop counter
    "entry":        Initialize=0, CanChange=True
    "name_len":     Initialize=0, CanChange=True
    "name_ptr":     Initialize=0, CanChange=True
    "hash":         Initialize=0, CanChange=True
    "n_dims":       Initialize=0, CanChange=True
    "dim0":         Initialize=0, CanChange=True
    "dim1":         Initialize=0, CanChange=True
    "ttype":        Initialize=0, CanChange=True
    "data_off":     Initialize=0, CanChange=True
    "data_size":    Initialize=0, CanChange=True
    "ne":           Initialize=0, CanChange=True    // total elements
    "ed":           Initialize=0, CanChange=True    // extra dims skip counter
}

// =============================================================================
// GGUF_ParseOneTensor — read one tensor info entry from fd
// Entry pointer must be set in GGUFTensorW.entry before calling.
// =============================================================================
Function.GGUF_ParseOneTensor {
    Body: {
        // ALL state in GGUFTensorW carrier — zero local variables

        // Read tensor name
        GGUFTensorW.name_len = GGUF_ReadString()
        GGUFTensorW.name_ptr = GGUF_AllocString(GGUFTensorW.name_len)
        StoreValue(Add(GGUFTensorW.entry, TensorField.NAME_PTR), GGUFTensorW.name_ptr)

        // Hash name using proven Library.Hash CRC32 implementation
        GGUFTensorW.hash = Hash.HashString(GGUFTensorW.name_ptr)
        StoreValue(Add(GGUFTensorW.entry, TensorField.NAME_HASH), GGUFTensorW.hash)

        // Read n_dims
        GGUFTensorW.n_dims = GGUF_ReadU32()
        StoreValue(Add(GGUFTensorW.entry, TensorField.N_DIMS), GGUFTensorW.n_dims)

        // Read dimensions
        GGUFTensorW.dim0 = 1
        GGUFTensorW.dim1 = 1
        IfCondition GreaterEqual(GGUFTensorW.n_dims, 1) ThenBlock: {
            GGUFTensorW.dim0 = GGUF_ReadU64()
        }
        IfCondition GreaterEqual(GGUFTensorW.n_dims, 2) ThenBlock: {
            GGUFTensorW.dim1 = GGUF_ReadU64()
        }
        // Skip any dims beyond 2
        GGUFTensorW.ed = 2
        WhileLoop LessThan(GGUFTensorW.ed, GGUFTensorW.n_dims) {
            GGUF_ReadU64()
            GGUFTensorW.ed = Add(GGUFTensorW.ed, 1)
        }
        StoreValue(Add(GGUFTensorW.entry, TensorField.DIM0), GGUFTensorW.dim0)
        StoreValue(Add(GGUFTensorW.entry, TensorField.DIM1), GGUFTensorW.dim1)

        // Read type
        GGUFTensorW.ttype = GGUF_ReadU32()
        StoreValue(Add(GGUFTensorW.entry, TensorField.TYPE), GGUFTensorW.ttype)

        // Read data offset
        GGUFTensorW.data_off = GGUF_ReadU64()
        StoreValue(Add(GGUFTensorW.entry, TensorField.DATA_OFFSET), GGUFTensorW.data_off)

        // Compute data size
        GGUFTensorW.ne = Multiply(GGUFTensorW.dim0, GGUFTensorW.dim1)
        GGUFTensorW.data_size = GGUF_TensorDataSize(GGUFTensorW.ttype, GGUFTensorW.ne)
        StoreValue(Add(GGUFTensorW.entry, TensorField.DATA_SIZE), GGUFTensorW.data_size)
    }
}

// =============================================================================
// GGUF_ParseTensors — read tensor info entries, populate TensorDir
// Must be called after GGUF_ParseMetadata.
// Returns 0 on success.
// =============================================================================
Function.GGUF_ParseTensors {
    Output: Integer
    Body: {
        // ALL loop state in carriers — zero locals that survive across calls

        // Allocate tensor directory
        TensorDir.entries = Allocate(Multiply(TensorDir.max_entries, TensorDir.ENTRY_SIZE))
        MemorySet(TensorDir.entries, 0, Multiply(TensorDir.max_entries, TensorDir.ENTRY_SIZE))
        TensorDir.count = 0

        GGUFTensorW.idx = 0
        WhileLoop LessThan(GGUFTensorW.idx, GGUFHeader.n_tensors) {
            IfCondition GreaterEqual(GGUFTensorW.idx, TensorDir.max_entries) ThenBlock: {
                PrintMessage("[GGUF] WARNING: tensor count exceeds max_entries\n")
                BreakLoop
            }

            GGUFTensorW.entry = Add(TensorDir.entries, Multiply(GGUFTensorW.idx, TensorDir.ENTRY_SIZE))
            GGUF_ParseOneTensor()

            TensorDir.count = Add(TensorDir.count, 1)
            GGUFTensorW.idx = Add(GGUFTensorW.idx, 1)
        }

        // Align to data section boundary — use inline expressions, no locals
        IfCondition NotEqual(Modulo(GGUFParse.pos, GGUFConst.DEFAULT_ALIGN), 0) ThenBlock: {
            GGUF_ReadBytes(GGUFParse.read_buf, Subtract(GGUFConst.DEFAULT_ALIGN, Modulo(GGUFParse.pos, GGUFConst.DEFAULT_ALIGN)))
        }
        LLMConfig.data_offset = GGUFParse.pos

        PrintMessage("[GGUF] Tensor directory: ")
        PrintNumber(TensorDir.count)
        PrintMessage(" tensors, data starts at offset ")
        PrintNumber(LLMConfig.data_offset)
        PrintMessage("\n")

        ReturnValue(0)
    }
}

// =============================================================================
// GGUF_FindTensor — find a tensor by name suffix match
// Returns entry pointer, or 0 if not found.
// =============================================================================
Function.GGUF_FindTensor {
    Input: suffix: Address
    Input: suffix_len: Integer
    Output: Address
    Body: {
        i = 0
        WhileLoop LessThan(i, TensorDir.count) {
            entry = Add(TensorDir.entries, Multiply(i, TensorDir.ENTRY_SIZE))
            name_ptr = Dereference(Add(entry, TensorField.NAME_PTR))

            // Get name length
            nlen = StringLength(name_ptr)

            // Check suffix match
            IfCondition GreaterEqual(nlen, suffix_len) ThenBlock: {
                start = Subtract(nlen, suffix_len)
                match = 1
                j = 0
                WhileLoop LessThan(j, suffix_len) {
                    nc = GetByte(name_ptr, Add(start, j))
                    sc = GetByte(suffix, j)
                    IfCondition NotEqual(nc, sc) ThenBlock: {
                        match = 0
                        BreakLoop
                    }
                    j = Add(j, 1)
                }
                IfCondition EqualTo(match, 1) ThenBlock: {
                    ReturnValue(entry)
                }
            }

            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}
