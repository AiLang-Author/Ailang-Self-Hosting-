// Library.AKSlot.ailang
// Centralized AK context slot system — replaces manual save/restore boilerplate.
//
// 16 pre-allocated slots (128 bytes each). Slot 0 = main context.
// Two functions replace all per-module save/restore:
//   AKSlot_SwapIn(slot)  — saves globals → current slot, loads target, pushes stack
//   AKSlot_SwapOut()     — saves globals → current slot, pops stack, restores parent
//
// Swap stack: depth-8 parent-slot stack (s0..s7) replaces the old 2-deep
// current/previous pair. Supports nested swaps (e.g. menu opened from
// inside a toolbar handler). Overflow/underflow prints a diagnostic and
// returns without corrupting state.
//
// 15 fields per slot (14 existing + dirty_count):
//   0:DATA  8:COUNT  16:ROOT  24:SCALE_NUM  32:SCALE_DEN
//   40:DESIGN_W  48:DESIGN_H  56:CANVAS  64:EXTRA_DATA  72:EXTRA_COUNT
//   80:HOVER  88:PRESSED  96:FOCUS  104:ACTION_CB  112:DIRTY_COUNT
//   120:IN_USE
//
// Copyright © 2026 Sean Collins, 2 Paws Machine and Engineering. SCSL.

LibraryImport.Auckland
LibraryImport.AucklandEvent

// =============================================================================
// CONSTANTS
// =============================================================================
FixedPool.AKSlotFields {
    "DATA":        Initialize=0
    "COUNT":       Initialize=8
    "ROOT":        Initialize=16
    "SCALE_NUM":   Initialize=24
    "SCALE_DEN":   Initialize=32
    "DESIGN_W":    Initialize=40
    "DESIGN_H":    Initialize=48
    "CANVAS":      Initialize=56
    "EXTRA_DATA":  Initialize=64
    "EXTRA_COUNT": Initialize=72
    "HOVER":       Initialize=80
    "PRESSED":     Initialize=88
    "FOCUS":       Initialize=96
    "ACTION_CB":   Initialize=104
    "DIRTY_COUNT": Initialize=112
    "IN_USE":      Initialize=120
}

FixedPool.AKSlotConst {
    "MAX":        Initialize=16
    "SIZE":       Initialize=128
    "STACK_MAX":  Initialize=8
}

FixedPool.AKSlotState {
    "table":    Initialize=0
    "current":  Initialize=0, CanChange=True
    "depth":    Initialize=0, CanChange=True
    "s0":       Initialize=0, CanChange=True
    "s1":       Initialize=0, CanChange=True
    "s2":       Initialize=0, CanChange=True
    "s3":       Initialize=0, CanChange=True
    "s4":       Initialize=0, CanChange=True
    "s5":       Initialize=0, CanChange=True
    "s6":       Initialize=0, CanChange=True
    "s7":       Initialize=0, CanChange=True
}


// =============================================================================
// AKSlot_EntryPtr — base address for a given slot index
// =============================================================================
Function.AKSlot_EntryPtr {
    Input: slot: Integer
    Output: Integer
    Body: {
        DebugLog_Push("sl.ptr", 6)
        ReturnValue(Add(AKSlotState.table, Multiply(slot, AKSlotConst.SIZE)))
    }
}


// =============================================================================
// AKSlot_Init — allocate table, snapshot main globals into slot 0
// Call after AK_Init + AKEvent_Init, before anything that creates sub-contexts.
// =============================================================================
Function.AKSlot_Init {
    Output: Integer
    Body: {
        DebugLog_Push("sl.ini", 6)
        tsz = Multiply(AKSlotConst.MAX, AKSlotConst.SIZE)
        tbl = Allocate(tsz)
        IfCondition EqualTo(tbl, 0) ThenBlock: {
            PrintMessage("[AKSlot] alloc fail\n")
            ReturnValue(0)
        }

        // Zero-fill entire table
        zi = 0
        WhileLoop LessThan(zi, tsz) {
            SetByte(tbl, zi, 0)
            zi = Add(zi, 1)
        }
        AKSlotState.table = tbl

        // Snapshot current main globals into slot 0
        s0 = tbl
        StoreValue(Add(s0, AKSlotFields.DATA),        AKTree.data)
        StoreValue(Add(s0, AKSlotFields.COUNT),       AKTree.count)
        StoreValue(Add(s0, AKSlotFields.ROOT),        AKTree.root)
        StoreValue(Add(s0, AKSlotFields.SCALE_NUM),   AKTree.scale_num)
        StoreValue(Add(s0, AKSlotFields.SCALE_DEN),   AKTree.scale_den)
        StoreValue(Add(s0, AKSlotFields.DESIGN_W),    AKTree.design_w)
        StoreValue(Add(s0, AKSlotFields.DESIGN_H),    AKTree.design_h)
        StoreValue(Add(s0, AKSlotFields.CANVAS),      AKTree.canvas)
        StoreValue(Add(s0, AKSlotFields.EXTRA_DATA),  AKExtraTable.data)
        StoreValue(Add(s0, AKSlotFields.EXTRA_COUNT), AKExtraTable.count)
        StoreValue(Add(s0, AKSlotFields.HOVER),       AKEvent.hover_node)
        StoreValue(Add(s0, AKSlotFields.PRESSED),     AKEvent.pressed_node)
        StoreValue(Add(s0, AKSlotFields.FOCUS),       AKEvent.focus_node)
        StoreValue(Add(s0, AKSlotFields.ACTION_CB),   AKEvent.action_callback)
        StoreValue(Add(s0, AKSlotFields.DIRTY_COUNT), AKEvent.dirty_count)
        StoreValue(Add(s0, AKSlotFields.IN_USE),      1)

        AKSlotState.current = 0
        AKSlotState.depth   = 0

        PrintMessage("[AKSlot] initialized, slot 0 = main\n")
        ReturnValue(1)
    }
}


// =============================================================================
// AKSlot_Alloc — find free slot, allocate node + extra buffers, return index
// Returns slot index (1..15), or -1 on failure.
// =============================================================================
Function.AKSlot_Alloc {
    Output: Integer
    Body: {
        DebugLog_Push("ak.alc", 6)
        // Find first free slot (skip 0 = main)
        slot = -1
        si = 1
        WhileLoop LessThan(si, AKSlotConst.MAX) {
            sp = AKSlot_EntryPtr(si)
            in_use = Dereference(Add(sp, AKSlotFields.IN_USE))
            IfCondition EqualTo(in_use, 0) ThenBlock: {
                IfCondition LessThan(slot, 0) ThenBlock: {
                    slot = si
                }
            }
            si = Add(si, 1)
        }
        IfCondition LessThan(slot, 0) ThenBlock: {
            PrintMessage("[AKSlot] no free slots\n")
            ReturnValue(-1)
        }

        // Allocate node buffer (512 × 256 = 131072)
        nsz = Multiply(AKNodeConst.MAX_NODES, AKNodeConst.ENTRY_SIZE)
        nb = Allocate(nsz)
        IfCondition EqualTo(nb, 0) ThenBlock: {
            PrintMessage("[AKSlot] node alloc fail\n")
            ReturnValue(-1)
        }
        ni = 0
        WhileLoop LessThan(ni, nsz) { SetByte(nb, ni, 0)  ni = Add(ni, 1) }

        // Allocate extra buffer (512 × 128 = 65536)
        esz = Multiply(AKExtraConst.MAX, AKExtraConst.ENTRY_SIZE)
        eb = Allocate(esz)
        IfCondition EqualTo(eb, 0) ThenBlock: {
            Deallocate(nb, nsz)
            PrintMessage("[AKSlot] extra alloc fail\n")
            ReturnValue(-1)
        }
        ei = 0
        WhileLoop LessThan(ei, esz) { SetByte(eb, ei, 0)  ei = Add(ei, 1) }

        // Initialize slot fields
        sp = AKSlot_EntryPtr(slot)
        StoreValue(Add(sp, AKSlotFields.DATA),        nb)
        StoreValue(Add(sp, AKSlotFields.COUNT),       0)
        StoreValue(Add(sp, AKSlotFields.ROOT),        -1)
        StoreValue(Add(sp, AKSlotFields.SCALE_NUM),   1)
        StoreValue(Add(sp, AKSlotFields.SCALE_DEN),   1)
        StoreValue(Add(sp, AKSlotFields.DESIGN_W),    320)
        StoreValue(Add(sp, AKSlotFields.DESIGN_H),    24)
        StoreValue(Add(sp, AKSlotFields.CANVAS),      0)
        StoreValue(Add(sp, AKSlotFields.EXTRA_DATA),  eb)
        StoreValue(Add(sp, AKSlotFields.EXTRA_COUNT), 0)
        StoreValue(Add(sp, AKSlotFields.HOVER),       -1)
        StoreValue(Add(sp, AKSlotFields.PRESSED),     -1)
        StoreValue(Add(sp, AKSlotFields.FOCUS),       -1)
        StoreValue(Add(sp, AKSlotFields.ACTION_CB),   0)
        StoreValue(Add(sp, AKSlotFields.DIRTY_COUNT), 0)
        StoreValue(Add(sp, AKSlotFields.IN_USE),      1)

        PrintMessage("[AKSlot] allocated slot ")
        PrintNumber(slot)
        PrintMessage("\n")
        DebugLog_Push("sl.alc.ok", 9)
        ReturnValue(slot)
    }
}


// =============================================================================
// AKSlot_Free — deallocate buffers, clear slot
// =============================================================================
Function.AKSlot_Free {
    Input: slot: Integer
    Body: {
        DebugLog_Push("ak.fre", 6)
        IfCondition LessEqual(slot, 0) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterEqual(slot, AKSlotConst.MAX) ThenBlock: { ReturnValue(0) }

        sp = AKSlot_EntryPtr(slot)
        in_use = Dereference(Add(sp, AKSlotFields.IN_USE))
        IfCondition EqualTo(in_use, 0) ThenBlock: { ReturnValue(0) }

        // Deallocate node buffer
        nb = Dereference(Add(sp, AKSlotFields.DATA))
        IfCondition NotEqual(nb, 0) ThenBlock: {
            nsz = Multiply(AKNodeConst.MAX_NODES, AKNodeConst.ENTRY_SIZE)
            Deallocate(nb, nsz)
        }

        // Deallocate extra buffer
        eb = Dereference(Add(sp, AKSlotFields.EXTRA_DATA))
        IfCondition NotEqual(eb, 0) ThenBlock: {
            esz = Multiply(AKExtraConst.MAX, AKExtraConst.ENTRY_SIZE)
            Deallocate(eb, esz)
        }

        // Clear all fields
        StoreValue(Add(sp, AKSlotFields.DATA),        0)
        StoreValue(Add(sp, AKSlotFields.COUNT),       0)
        StoreValue(Add(sp, AKSlotFields.ROOT),        -1)
        StoreValue(Add(sp, AKSlotFields.SCALE_NUM),   0)
        StoreValue(Add(sp, AKSlotFields.SCALE_DEN),   0)
        StoreValue(Add(sp, AKSlotFields.DESIGN_W),    0)
        StoreValue(Add(sp, AKSlotFields.DESIGN_H),    0)
        StoreValue(Add(sp, AKSlotFields.CANVAS),      0)
        StoreValue(Add(sp, AKSlotFields.EXTRA_DATA),  0)
        StoreValue(Add(sp, AKSlotFields.EXTRA_COUNT), 0)
        StoreValue(Add(sp, AKSlotFields.HOVER),       -1)
        StoreValue(Add(sp, AKSlotFields.PRESSED),     -1)
        StoreValue(Add(sp, AKSlotFields.FOCUS),       -1)
        StoreValue(Add(sp, AKSlotFields.ACTION_CB),   0)
        StoreValue(Add(sp, AKSlotFields.DIRTY_COUNT), 0)
        StoreValue(Add(sp, AKSlotFields.IN_USE),      0)

        PrintMessage("[AKSlot] freed slot ")
        PrintNumber(slot)
        PrintMessage("\n")
    }
}


// =============================================================================
// AKSlot_SwapIn — save globals → current slot, load target slot → globals
// =============================================================================
Function.AKSlot_SwapIn {
    Input: slot: Integer
    Body: {
        DebugLog_Push("ak.swi", 6)
        // Save current globals into current slot
        cur = AKSlot_EntryPtr(AKSlotState.current)
        StoreValue(Add(cur, AKSlotFields.DATA),        AKTree.data)
        StoreValue(Add(cur, AKSlotFields.COUNT),       AKTree.count)
        StoreValue(Add(cur, AKSlotFields.ROOT),        AKTree.root)
        StoreValue(Add(cur, AKSlotFields.SCALE_NUM),   AKTree.scale_num)
        StoreValue(Add(cur, AKSlotFields.SCALE_DEN),   AKTree.scale_den)
        StoreValue(Add(cur, AKSlotFields.DESIGN_W),    AKTree.design_w)
        StoreValue(Add(cur, AKSlotFields.DESIGN_H),    AKTree.design_h)
        StoreValue(Add(cur, AKSlotFields.CANVAS),      AKTree.canvas)
        StoreValue(Add(cur, AKSlotFields.EXTRA_DATA),  AKExtraTable.data)
        StoreValue(Add(cur, AKSlotFields.EXTRA_COUNT), AKExtraTable.count)
        StoreValue(Add(cur, AKSlotFields.HOVER),       AKEvent.hover_node)
        StoreValue(Add(cur, AKSlotFields.PRESSED),     AKEvent.pressed_node)
        StoreValue(Add(cur, AKSlotFields.FOCUS),       AKEvent.focus_node)
        StoreValue(Add(cur, AKSlotFields.ACTION_CB),   AKEvent.action_callback)
        StoreValue(Add(cur, AKSlotFields.DIRTY_COUNT), AKEvent.dirty_count)

        // Load target slot into globals
        tgt = AKSlot_EntryPtr(slot)
        AKTree.data            = Dereference(Add(tgt, AKSlotFields.DATA))
        AKTree.count           = Dereference(Add(tgt, AKSlotFields.COUNT))
        AKTree.root            = Dereference(Add(tgt, AKSlotFields.ROOT))
        AKTree.scale_num       = Dereference(Add(tgt, AKSlotFields.SCALE_NUM))
        AKTree.scale_den       = Dereference(Add(tgt, AKSlotFields.SCALE_DEN))
        AKTree.design_w        = Dereference(Add(tgt, AKSlotFields.DESIGN_W))
        AKTree.design_h        = Dereference(Add(tgt, AKSlotFields.DESIGN_H))
        AKTree.canvas          = Dereference(Add(tgt, AKSlotFields.CANVAS))
        AKExtraTable.data      = Dereference(Add(tgt, AKSlotFields.EXTRA_DATA))
        AKExtraTable.count     = Dereference(Add(tgt, AKSlotFields.EXTRA_COUNT))
        AKEvent.hover_node     = Dereference(Add(tgt, AKSlotFields.HOVER))
        AKEvent.pressed_node   = Dereference(Add(tgt, AKSlotFields.PRESSED))
        AKEvent.focus_node     = Dereference(Add(tgt, AKSlotFields.FOCUS))
        AKEvent.action_callback = Dereference(Add(tgt, AKSlotFields.ACTION_CB))
        AKEvent.dirty_count    = Dereference(Add(tgt, AKSlotFields.DIRTY_COUNT))

        // Push current slot onto parent stack
        DebugLog_Push("sl.in.1", 7)
        d = AKSlotState.depth
        IfCondition GreaterEqual(d, AKSlotConst.STACK_MAX) ThenBlock: {
            PrintMessage("[AKSlot] SwapIn overflow — stack full\n")
            ReturnValue(0)
        }
        IfCondition EqualTo(d, 0) ThenBlock: { AKSlotState.s0 = AKSlotState.current }
        IfCondition EqualTo(d, 1) ThenBlock: { AKSlotState.s1 = AKSlotState.current }
        IfCondition EqualTo(d, 2) ThenBlock: { AKSlotState.s2 = AKSlotState.current }
        IfCondition EqualTo(d, 3) ThenBlock: { AKSlotState.s3 = AKSlotState.current }
        IfCondition EqualTo(d, 4) ThenBlock: { AKSlotState.s4 = AKSlotState.current }
        IfCondition EqualTo(d, 5) ThenBlock: { AKSlotState.s5 = AKSlotState.current }
        IfCondition EqualTo(d, 6) ThenBlock: { AKSlotState.s6 = AKSlotState.current }
        IfCondition EqualTo(d, 7) ThenBlock: { AKSlotState.s7 = AKSlotState.current }
        AKSlotState.depth = Add(d, 1)
        swap_from = AKSlotState.current
        AKSlotState.current = slot

        PrintMessage("[SWAP.IN] depth=")
        PrintNumber(d)
        PrintMessage(" ")
        PrintNumber(swap_from)
        PrintMessage("->")
        PrintNumber(slot)
        PrintMessage(" data=")
        PrintNumber(AKTree.data)
        PrintMessage(" root=")
        PrintNumber(AKTree.root)
        PrintMessage(" cnt=")
        PrintNumber(AKTree.count)
        PrintMessage("\n")
        DebugLog_Push("sl.in.ok", 8)
    }
}


// =============================================================================
// AKSlot_SwapOut — save globals → current slot, pop stack, restore parent → globals
// =============================================================================
Function.AKSlot_SwapOut {
    Body: {
        DebugLog_Push("ak.swo", 6)
        // Save current globals into current slot
        cur = AKSlot_EntryPtr(AKSlotState.current)
        StoreValue(Add(cur, AKSlotFields.DATA),        AKTree.data)
        StoreValue(Add(cur, AKSlotFields.COUNT),       AKTree.count)
        StoreValue(Add(cur, AKSlotFields.ROOT),        AKTree.root)
        StoreValue(Add(cur, AKSlotFields.SCALE_NUM),   AKTree.scale_num)
        StoreValue(Add(cur, AKSlotFields.SCALE_DEN),   AKTree.scale_den)
        StoreValue(Add(cur, AKSlotFields.DESIGN_W),    AKTree.design_w)
        StoreValue(Add(cur, AKSlotFields.DESIGN_H),    AKTree.design_h)
        StoreValue(Add(cur, AKSlotFields.CANVAS),      AKTree.canvas)
        StoreValue(Add(cur, AKSlotFields.EXTRA_DATA),  AKExtraTable.data)
        StoreValue(Add(cur, AKSlotFields.EXTRA_COUNT), AKExtraTable.count)
        StoreValue(Add(cur, AKSlotFields.HOVER),       AKEvent.hover_node)
        StoreValue(Add(cur, AKSlotFields.PRESSED),     AKEvent.pressed_node)
        StoreValue(Add(cur, AKSlotFields.FOCUS),       AKEvent.focus_node)
        StoreValue(Add(cur, AKSlotFields.ACTION_CB),   AKEvent.action_callback)
        StoreValue(Add(cur, AKSlotFields.DIRTY_COUNT), AKEvent.dirty_count)

        // Pop parent slot from stack
        DebugLog_Push("sl.out.1", 8)
        d = AKSlotState.depth
        IfCondition LessEqual(d, 0) ThenBlock: {
            PrintMessage("[AKSlot] SwapOut underflow — no swap to unwind\n")
            ReturnValue(0)
        }
        d = Subtract(d, 1)
        parent = 0
        IfCondition EqualTo(d, 0) ThenBlock: { parent = AKSlotState.s0 }
        IfCondition EqualTo(d, 1) ThenBlock: { parent = AKSlotState.s1 }
        IfCondition EqualTo(d, 2) ThenBlock: { parent = AKSlotState.s2 }
        IfCondition EqualTo(d, 3) ThenBlock: { parent = AKSlotState.s3 }
        IfCondition EqualTo(d, 4) ThenBlock: { parent = AKSlotState.s4 }
        IfCondition EqualTo(d, 5) ThenBlock: { parent = AKSlotState.s5 }
        IfCondition EqualTo(d, 6) ThenBlock: { parent = AKSlotState.s6 }
        IfCondition EqualTo(d, 7) ThenBlock: { parent = AKSlotState.s7 }
        AKSlotState.depth = d

        // Load parent slot into globals
        parent_ptr = AKSlot_EntryPtr(parent)
        AKTree.data            = Dereference(Add(parent_ptr, AKSlotFields.DATA))
        AKTree.count           = Dereference(Add(parent_ptr, AKSlotFields.COUNT))
        AKTree.root            = Dereference(Add(parent_ptr, AKSlotFields.ROOT))
        AKTree.scale_num       = Dereference(Add(parent_ptr, AKSlotFields.SCALE_NUM))
        AKTree.scale_den       = Dereference(Add(parent_ptr, AKSlotFields.SCALE_DEN))
        AKTree.design_w        = Dereference(Add(parent_ptr, AKSlotFields.DESIGN_W))
        AKTree.design_h        = Dereference(Add(parent_ptr, AKSlotFields.DESIGN_H))
        AKTree.canvas          = Dereference(Add(parent_ptr, AKSlotFields.CANVAS))
        AKExtraTable.data      = Dereference(Add(parent_ptr, AKSlotFields.EXTRA_DATA))
        AKExtraTable.count     = Dereference(Add(parent_ptr, AKSlotFields.EXTRA_COUNT))
        AKEvent.hover_node     = Dereference(Add(parent_ptr, AKSlotFields.HOVER))
        AKEvent.pressed_node   = Dereference(Add(parent_ptr, AKSlotFields.PRESSED))
        AKEvent.focus_node     = Dereference(Add(parent_ptr, AKSlotFields.FOCUS))
        AKEvent.action_callback = Dereference(Add(parent_ptr, AKSlotFields.ACTION_CB))
        AKEvent.dirty_count    = Dereference(Add(parent_ptr, AKSlotFields.DIRTY_COUNT))

        // Update current
        old_cur = AKSlotState.current
        AKSlotState.current = parent

        PrintMessage("[SWAP.OUT] depth=")
        PrintNumber(d)
        PrintMessage(" ")
        PrintNumber(old_cur)
        PrintMessage("->")
        PrintNumber(parent)
        PrintMessage(" data=")
        PrintNumber(AKTree.data)
        PrintMessage(" root=")
        PrintNumber(AKTree.root)
        PrintMessage(" cnt=")
        PrintNumber(AKTree.count)
        PrintMessage("\n")
        DebugLog_Push("sl.out.ok", 9)
    }
}
