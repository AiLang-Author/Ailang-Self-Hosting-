// Library.AboutDialog.ailang — About system dialog
// Uses AppHost_Open — same design as Calculator.
// HTML layout in config/about.html. Action callback pushes to EventRouter.
//
// Copyright (c) 2026 Sean Collins, 2 Paws Machine and Engineering. SCSL.

LibraryImport.AppHost
LibraryImport.EventRouter
LibraryImport.WinManager
LibraryImport.Auckland

FixedPool.AboutDialogState {
    "win_idx": Initialize=-1, CanChange=True
}

// =============================================================================
// ACTION CALLBACK — pushes actions to EventRouter for dispatch
// =============================================================================
Function.AboutApp_ActionCb {
    Input: action_ptr: Address
    Input: action_len: Integer
    Output: Integer
    Body: {
        EventRouter_Push(action_ptr, action_len, 0)
        ReturnValue(1)
    }
}

// =============================================================================
// OPEN — launch About window via AppHost
// =============================================================================
Function.AboutDialog_Open {
    Output: Integer
    Body: {
        DebugLog_Push("ab.opn", 6)

        // Don't open twice
        IfCondition GreaterEqual(AboutDialogState.win_idx, 0) ThenBlock: {
            PrintMessage("[About] already open\n")
            ReturnValue(AboutDialogState.win_idx)
        }

        win_idx = AppHost_Open("config/about.html", AddressOf(AboutApp_ActionCb))
        IfCondition LessEqual(win_idx, 0) ThenBlock: {
            PrintMessage("[About] AppHost_Open fail\n")
            ReturnValue(-1)
        }
        AboutDialogState.win_idx = win_idx

        DeskbarState.needs_refresh = 1

        PrintMessage("[About] opened win=")
        PrintNumber(win_idx)
        PrintMessage("\n")
        ReturnValue(win_idx)
    }
}

// =============================================================================
// CLOSE — close via AppHost
// =============================================================================
Function.AboutDialog_Close {
    Body: {
        DebugLog_Push("ab.cls", 6)
        IfCondition LessThan(AboutDialogState.win_idx, 0) ThenBlock: { ReturnValue(0) }

        AppHost_Close(AboutDialogState.win_idx)
        AboutDialogState.win_idx = -1
        DeskbarState.needs_refresh = 1
        PrintMessage("[About] closed\n")
    }
}
