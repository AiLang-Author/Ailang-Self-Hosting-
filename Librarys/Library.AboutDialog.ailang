// Library.AboutDialog.ailang — About system dialog
// Shows system info: name, version, copyright, license.
// Close button dismisses.
//
// Copyright (c) 2026 Sean Collins, 2 Paws Machine and Engineering. SCSL.

LibraryImport.Dialog
LibraryImport.Auckland
LibraryImport.UITheme
LibraryImport.UIScale
LibraryImport.EventRouter

FixedPool.AboutDialogState {
    "dialog_slot": Initialize=-1, CanChange=True
}

// =============================================================================
// OPEN — create and show the about dialog
// =============================================================================
Function.AboutDialog_Open {
    Output: Integer
    Body: {
        DebugLog_Push("ab.opn", 6)

        // Don't open twice
        IfCondition GreaterEqual(AboutDialogState.dialog_slot, 0) ThenBlock: {
            PrintMessage("[About] already open\n")
            ReturnValue(AboutDialogState.dialog_slot)
        }

        dlg_w = 300
        dlg_h = 220
        fs = UIScale.font_body

        slot = Dialog_Create("About", dlg_w, dlg_h, fs)
        IfCondition LessThan(slot, 0) ThenBlock: {
            PrintMessage("[About] Dialog_Create failed\n")
            ReturnValue(-1)
        }
        AboutDialogState.dialog_slot = slot

        // Build content tree
        AboutDialog_BuildTree(slot, fs)

        // Render
        Dialog_Render(slot)

        PrintMessage("[About] opened slot=")
        PrintNumber(slot)
        PrintMessage("\n")
        ReturnValue(slot)
    }
}

// =============================================================================
// BUILD TREE — VBOX with labels and a close button
// =============================================================================
Function.AboutDialog_BuildTree {
    Input: slot: Integer
    Input: font_size: Integer
    Body: {
        DebugLog_Push("ab.bt", 5)
        ak_ctx = Dialog_SwapIn(slot)

        // Root VBOX
        root = AK_CreateNode(ak_ctx, AKTag.GROUP)
        AK_Set(ak_ctx, root, AKF.LAYOUT_MODE, AKLayout.VBOX)
        AK_Set(ak_ctx, root, AKF.GAP, 6)
        AK_Set(ak_ctx, root, AKF.PAD_T, 16)
        AK_Set(ak_ctx, root, AKF.PAD_R, 16)
        AK_Set(ak_ctx, root, AKF.PAD_B, 16)
        AK_Set(ak_ctx, root, AKF.PAD_L, 16)
        AK_ExtraSet(ak_ctx, root, AKExtra.COLOR_BG, Theme.dialog_bg)
        AK_SetRoot(ak_ctx, root)

        fg = Theme.text_fg
        fg2 = Theme.text_secondary

        // Title
        lbl1 = AK_CreateNode(ak_ctx, AKTag.LABEL)
        AK_Set(ak_ctx, lbl1, AKF.HEIGHT, Add(font_size, 4))
        AK_ExtraSet(ak_ctx, lbl1, AKExtra.STR_PTR, "Ailang Display Server")
        AK_ExtraSet(ak_ctx, lbl1, AKExtra.STR_LEN, 21)
        AK_ExtraSet(ak_ctx, lbl1, AKExtra.COLOR_FG, fg)
        AK_ExtraSet(ak_ctx, lbl1, AKExtra.TEXT_ALIGN, 2)
        AK_AddChild(ak_ctx, root, lbl1)

        // Version
        lbl2 = AK_CreateNode(ak_ctx, AKTag.LABEL)
        AK_Set(ak_ctx, lbl2, AKF.HEIGHT, font_size)
        AK_ExtraSet(ak_ctx, lbl2, AKExtra.STR_PTR, "Version 1.0")
        AK_ExtraSet(ak_ctx, lbl2, AKExtra.STR_LEN, 11)
        AK_ExtraSet(ak_ctx, lbl2, AKExtra.COLOR_FG, fg2)
        AK_ExtraSet(ak_ctx, lbl2, AKExtra.TEXT_ALIGN, 2)
        AK_AddChild(ak_ctx, root, lbl2)

        // Copyright
        lbl3 = AK_CreateNode(ak_ctx, AKTag.LABEL)
        AK_Set(ak_ctx, lbl3, AKF.HEIGHT, font_size)
        AK_ExtraSet(ak_ctx, lbl3, AKExtra.STR_PTR, "Copyright 2026 Sean Collins")
        AK_ExtraSet(ak_ctx, lbl3, AKExtra.STR_LEN, 27)
        AK_ExtraSet(ak_ctx, lbl3, AKExtra.COLOR_FG, fg)
        AK_ExtraSet(ak_ctx, lbl3, AKExtra.TEXT_ALIGN, 2)
        AK_AddChild(ak_ctx, root, lbl3)

        // Company
        lbl4 = AK_CreateNode(ak_ctx, AKTag.LABEL)
        AK_Set(ak_ctx, lbl4, AKF.HEIGHT, font_size)
        AK_ExtraSet(ak_ctx, lbl4, AKExtra.STR_PTR, "2 Paws Machine and Engineering")
        AK_ExtraSet(ak_ctx, lbl4, AKExtra.STR_LEN, 30)
        AK_ExtraSet(ak_ctx, lbl4, AKExtra.COLOR_FG, fg)
        AK_ExtraSet(ak_ctx, lbl4, AKExtra.TEXT_ALIGN, 2)
        AK_AddChild(ak_ctx, root, lbl4)

        // License
        lbl5 = AK_CreateNode(ak_ctx, AKTag.LABEL)
        AK_Set(ak_ctx, lbl5, AKF.HEIGHT, font_size)
        AK_ExtraSet(ak_ctx, lbl5, AKExtra.STR_PTR, "SCSL License")
        AK_ExtraSet(ak_ctx, lbl5, AKExtra.STR_LEN, 12)
        AK_ExtraSet(ak_ctx, lbl5, AKExtra.COLOR_FG, fg2)
        AK_ExtraSet(ak_ctx, lbl5, AKExtra.TEXT_ALIGN, 2)
        AK_AddChild(ak_ctx, root, lbl5)

        // Spacer (absorbs remaining vertical space)
        spacer = AK_CreateNode(ak_ctx, AKTag.SPACER)
        AK_Set(ak_ctx, spacer, AKF.GROW, 1)
        AK_AddChild(ak_ctx, root, spacer)

        // Close button
        btn_close = AK_CreateNode(ak_ctx, AKTag.BUTTON)
        AK_Set(ak_ctx, btn_close, AKF.MIN_W, 80)
        AK_Set(ak_ctx, btn_close, AKF.HEIGHT, 28)
        AK_ExtraSet(ak_ctx, btn_close, AKExtra.STR_PTR, "Close")
        AK_ExtraSet(ak_ctx, btn_close, AKExtra.STR_LEN, 5)
        AK_ExtraSet(ak_ctx, btn_close, AKExtra.ACTION_PTR, "about.close")
        AK_ExtraSet(ak_ctx, btn_close, AKExtra.ACTION_LEN, 11)
        AK_ExtraSet(ak_ctx, btn_close, AKExtra.COLOR_BG, Theme.ak_btn_bg)
        AK_ExtraSet(ak_ctx, btn_close, AKExtra.COLOR_FG, Theme.ak_btn_fg)
        AK_AddChild(ak_ctx, root, btn_close)

        Dialog_SwapOut(slot)
        ReturnValue(0)
    }
}

// =============================================================================
// CLOSE — dismiss the about dialog
// =============================================================================
Function.AboutDialog_Close {
    Body: {
        DebugLog_Push("ab.cls", 6)
        slot = AboutDialogState.dialog_slot
        IfCondition GreaterEqual(slot, 0) ThenBlock: {
            Dialog_Close(slot)
        }
        AboutDialogState.dialog_slot = -1
        PrintMessage("[About] closed\n")
    }
}
