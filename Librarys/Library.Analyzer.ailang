// Library.Analyzer.ailang
// Pass 1 — memory and structure. Does not own the pipeline.
//
// The CLI Applications/Analyzer/ailang_analyzer.ailang does
// Load → Resolve → Lex → Parse, then:
//   Analyzer.Init
//   Analyzer.WalkNode(ast)
//   Analyzer.PostAnalysis
//   Analyzer.Cleanup
//
// Features:
//   - Memory leak detection for Allocate, Arena_Alloc, ArrayCreate, AllocateLinkage
//   - Dropped live blocks (overwrite without a free)
//   - Allocations whose result is not stored
//   - Returned and freed in the same function
//   - Function-scoped tracking
//   - Nesting-depth warning via PostAnalysis
//
// Copyright (c) 2025-2026 Sean Collins, 2 Paws Machine and Engineering. All rights reserved.
// Licensed under the Sean Collins Software License (SCSL v1.0).

LibraryImport.Arrays

LibraryImport.Compiler.Frontend.Lexer.CLexerCore
LibraryImport.Compiler.Frontend.Lexer.CLexerMain
LibraryImport.Compiler.Frontend.Parser.CParserCore
LibraryImport.Compiler.Frontend.Parser.CParserMain
LibraryImport.Compiler.Frontend.AST.CASTCore
LibraryImport.Compiler.Frontend.AST.CASTTypes
LibraryImport.Compiler.Import.CImportResolver
LibraryImport.Compiler.Import.CFileMap


// =============================================================================
// ANALYZER STATE
// =============================================================================
FixedPool.Analyzer {
    // Pipeline state (owned by analyzer)
    "source": Initialize=0, CanChange=True
    "source_len": Initialize=0, CanChange=True
    "resolved_source": Initialize=0, CanChange=True
    "ast": Initialize=0, CanChange=True
    "owns_source": Initialize=0, CanChange=True
    
    // Results
    "warnings": Initialize=0, CanChange=True
    "errors": Initialize=0, CanChange=True
    "warning_count": Initialize=0, CanChange=True
    "error_count": Initialize=0, CanChange=True
    
    // Per-function tracking
    "current_func": Initialize=0, CanChange=True
    "current_func_line": Initialize=0, CanChange=True
    "func_alloc_vars": Initialize=0, CanChange=True
    "func_alloc_lines": Initialize=0, CanChange=True
    "func_alloc_sizes": Initialize=0, CanChange=True
    "func_alloc_kinds": Initialize=0, CanChange=True
    "func_params": Initialize=0, CanChange=True
    "func_arena_vars": Initialize=0, CanChange=True
    "func_partial_allocs": Initialize=0, CanChange=True
    "snap_then_names": Initialize=0, CanChange=True
    "snap_then_lines": Initialize=0, CanChange=True
    "snap_then_sizes": Initialize=0, CanChange=True
    "snap_then_kinds": Initialize=0, CanChange=True
    "snap_else_names": Initialize=0, CanChange=True
    "snap_else_sizes": Initialize=0, CanChange=True
    "snap_else_kinds": Initialize=0, CanChange=True
    "snap_then_frees": Initialize=0, CanChange=True
    "snap_else_frees": Initialize=0, CanChange=True
    "func_dealloc_vars": Initialize=0, CanChange=True
    "func_dealloc_lines": Initialize=0, CanChange=True
    "func_dealloc_marks": Initialize=0, CanChange=True
    "func_alias_names": Initialize=0, CanChange=True
    "func_alias_roots": Initialize=0, CanChange=True
    "func_const_names": Initialize=0, CanChange=True
    "func_const_values": Initialize=0, CanChange=True
    "func_partial_vars": Initialize=0, CanChange=True
    "snap_then_exits": Initialize=0, CanChange=True
    "snap_else_exits": Initialize=0, CanChange=True
    "snap_cond": Initialize=0, CanChange=True
    "snap_then_block": Initialize=0, CanChange=True
    "snap_else_block": Initialize=0, CanChange=True
    "func_loop_depth": Initialize=0, CanChange=True
    "func_loop_written": Initialize=0, CanChange=True
    "func_has_output": Initialize=0, CanChange=True
    "func_has_return": Initialize=0, CanChange=True
    "func_returned_vars": Initialize=0, CanChange=True
    
    // Variable tracking (per function)
    "func_assigned_vars": Initialize=0, CanChange=True
    "func_used_vars": Initialize=0, CanChange=True
    
    // Function definition/call tracking (global)
    "defined_funcs": Initialize=0, CanChange=True
    "called_funcs": Initialize=0, CanChange=True
    "func_call_counts": Initialize=0, CanChange=True
    
    // Nesting tracking
    "block_depth": Initialize=0, CanChange=True
    "max_block_depth": Initialize=0, CanChange=True
    "max_depth_func": Initialize=0, CanChange=True
    "max_depth_line": Initialize=0, CanChange=True
    
    // Stats
    "total_allocs": Initialize=0, CanChange=True
    "total_deallocs": Initialize=0, CanChange=True
    "functions_analyzed": Initialize=0, CanChange=True
    "subroutines_analyzed": Initialize=0, CanChange=True
    "leak_warnings": Initialize=0, CanChange=True
    "drop_warnings": Initialize=0, CanChange=True
    "discard_warnings": Initialize=0, CanChange=True
    "both_warnings": Initialize=0, CanChange=True
    "path_warnings": Initialize=0, CanChange=True
    "size_warnings": Initialize=0, CanChange=True
    "arena_warnings": Initialize=0, CanChange=True
    "kind_warnings": Initialize=0, CanChange=True
    "free_warnings": Initialize=0, CanChange=True

    // Cross-function ownership. free_keys holds "Name#index" for a
    // parameter freed on every path. ret_alloc_funcs holds functions
    // that return a fresh allocation. col_* is the collect walk only.
    "free_keys": Initialize=0, CanChange=True
    "ret_alloc_funcs": Initialize=0, CanChange=True
    "col_params": Initialize=0, CanChange=True
    "col_allocs": Initialize=0, CanChange=True
    "col_dealloc": Initialize=0, CanChange=True
    "col_returns_alloc": Initialize=0, CanChange=True
    "walking": Initialize=0, CanChange=True
    "inside_args": Initialize=0, CanChange=True

    // Walk state. skip_discard is 1 while the direct RHS of an
    // assignment is itself an allocating call, so that call is stored
    // rather than reported as discarded.
    "last_valid_line": Initialize=0, CanChange=True
    "skip_discard": Initialize=0, CanChange=True
    
    // Config
    "enabled": Initialize=0, CanChange=True
    "check_memory": Initialize=1, CanChange=True
    "check_style": Initialize=1, CanChange=True
    "check_unused": Initialize=1, CanChange=True
    "check_undefined": Initialize=1, CanChange=True
    "check_returns": Initialize=1, CanChange=True
    "max_nesting": Initialize=5
    "max_params": Initialize=6
    "max_func_lines": Initialize=100
    "verbose": Initialize=0, CanChange=True
}


// =============================================================================
// FILE LOADING
// =============================================================================
Function.Analyzer.LoadFile {
    Input: filename: Address
    Output: Address
    Body: {
        // Open file
        fd = SystemCall(2, filename, 0, 0)  // O_RDONLY
        IfCondition LessThan(fd, 0) ThenBlock: {
            ReturnValue(0)
        }
        
        // Get file size
        size = SystemCall(8, fd, 0, 2)  // lseek SEEK_END
        SystemCall(8, fd, 0, 0)          // lseek SEEK_SET
        
        IfCondition LessEqual(size, 0) ThenBlock: {
            SystemCall(3, fd)  // close
            ReturnValue(0)
        }
        
        // Allocate buffer
        buffer = Allocate(Add(size, 1))
        IfCondition EqualTo(buffer, 0) ThenBlock: {
            SystemCall(3, fd)
            ReturnValue(0)
        }
        
        // Read file
        bytes_read = SystemCall(0, fd, buffer, size)
        SystemCall(3, fd)
        
        IfCondition LessThan(bytes_read, 0) ThenBlock: {
            Deallocate(buffer, Add(size, 1))
            ReturnValue(0)
        }
        
        // Null terminate
        SetByte(buffer, bytes_read, 0)
        
        ReturnValue(buffer)
    }
}

// =============================================================================
// PIPELINE CLEANUP
// =============================================================================
Function.Analyzer.PipelineCleanup {
    Body: {
        // Free resolved source if different from original
        IfCondition NotEqual(Analyzer.resolved_source, Analyzer.source) ThenBlock: {
            IfCondition NotEqual(Analyzer.resolved_source, 0) ThenBlock: {
                // resolved_source is allocated by Import_ResolveAll
                // Deallocate it
                res_len = StringLength(Analyzer.resolved_source)
                Deallocate(Analyzer.resolved_source, Add(res_len, 1))
            }
        }
        
        // Free source if we own it
        IfCondition EqualTo(Analyzer.owns_source, 1) ThenBlock: {
            IfCondition NotEqual(Analyzer.source, 0) ThenBlock: {
                Deallocate(Analyzer.source, Add(Analyzer.source_len, 1))
            }
        }
        
        Analyzer.source = 0
        Analyzer.source_len = 0
        Analyzer.resolved_source = 0
        Analyzer.ast = 0
        Analyzer.owns_source = 0
    }
}

// =============================================================================
// ANALYSIS STATE INITIALIZATION
// =============================================================================
Function.Analyzer.Init {
    Body: {
        Analyzer.warnings = Array.Create(128)
        Analyzer.errors = Array.Create(32)
        Analyzer.warning_count = 0
        Analyzer.error_count = 0
        
        // Per-function memory tracking
        Analyzer.func_alloc_vars = Array.Create(32)
        Analyzer.func_alloc_lines = Array.Create(32)
        Analyzer.func_alloc_sizes = Array.Create(32)
        Analyzer.func_alloc_kinds = Array.Create(32)
        Analyzer.func_params = Array.Create(8)
        Analyzer.func_arena_vars = Array.Create(16)
        Analyzer.func_partial_allocs = Array.Create(16)
        Analyzer.func_dealloc_vars = Array.Create(32)
        Analyzer.func_dealloc_lines = Array.Create(32)
        Analyzer.func_dealloc_marks = Array.Create(32)
        Analyzer.func_alias_names = Array.Create(16)
        Analyzer.func_alias_roots = Array.Create(16)
        Analyzer.func_const_names = Array.Create(16)
        Analyzer.func_const_values = Array.Create(16)
        Analyzer.func_loop_written = Array.Create(16)
        Analyzer.func_partial_vars = Array.Create(32)
        Analyzer.snap_then_exits = 0
        Analyzer.snap_else_exits = 0
        Analyzer.snap_cond = 0
        Analyzer.snap_then_block = 0
        Analyzer.snap_else_block = 0
        Analyzer.func_loop_depth = 0
        Analyzer.func_returned_vars = Array.Create(16)
        
        // Per-function variable tracking
        Analyzer.func_assigned_vars = Array.Create(64)
        Analyzer.func_used_vars = Array.Create(64)
        
        // Global function tracking
        Analyzer.defined_funcs = Array.Create(256)
        Analyzer.called_funcs = Array.Create(256)
        Analyzer.func_call_counts = Array.Create(256)
        Analyzer.free_keys = Array.Create(64)
        Analyzer.ret_alloc_funcs = Array.Create(32)
        Analyzer.col_params = Array.Create(8)
        Analyzer.col_allocs = Array.Create(16)
        Analyzer.col_dealloc = Array.Create(16)
        
        Analyzer.current_func = 0
        Analyzer.current_func_line = 0
        Analyzer.func_has_output = 0
        Analyzer.func_has_return = 0
        Analyzer.block_depth = 0
        Analyzer.max_block_depth = 0
        Analyzer.max_depth_func = 0
        Analyzer.max_depth_line = 0
        
        Analyzer.total_allocs = 0
        Analyzer.total_deallocs = 0
        Analyzer.functions_analyzed = 0
        Analyzer.subroutines_analyzed = 0
        Analyzer.leak_warnings = 0
        Analyzer.drop_warnings = 0
        Analyzer.discard_warnings = 0
        Analyzer.both_warnings = 0
        Analyzer.path_warnings = 0
        Analyzer.size_warnings = 0
        Analyzer.arena_warnings = 0
        Analyzer.kind_warnings = 0
        Analyzer.free_warnings = 0
        Analyzer.col_returns_alloc = 0
        Analyzer.walking = 0
        Analyzer.inside_args = 0
        Analyzer.last_valid_line = 0
        Analyzer.skip_discard = 0
        
        ReturnValue(1)
    }
}

// =============================================================================
// DIAGNOSTICS
// =============================================================================
Function.Analyzer.AddWarning {
    Input: msg: Address
    Body: {
        Array.Push(Analyzer.warnings, msg)
        Analyzer.warning_count = Add(Analyzer.warning_count, 1)
    }
}

Function.Analyzer.AddError {
    Input: msg: Address
    Body: {
        Array.Push(Analyzer.errors, msg)
        Analyzer.error_count = Add(Analyzer.error_count, 1)
    }
}

// =============================================================================
// STRING HELPERS
// =============================================================================
Function.Analyzer.StrEqual {
    Input: a: Address
    Input: b: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(a, 0) ThenBlock: {
            IfCondition EqualTo(b, 0) ThenBlock: {
                ReturnValue(1)
            }
            ReturnValue(0)
        }
        IfCondition EqualTo(b, 0) ThenBlock: {
            ReturnValue(0)
        }
        cmp = StringCompare(a, b)
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            ReturnValue(1)
        }
        ReturnValue(0)
    }
}

// =============================================================================
// PER-FUNCTION TRACKING
// =============================================================================
Function.Analyzer.EnterFunction {
    Input: name: Address
    Input: line: Integer
    Input: is_subroutine: Integer
    Body: {
        // Clear per-function tracking
        Array.Clear(Analyzer.func_alloc_vars)
        Array.Clear(Analyzer.func_alloc_lines)
        Array.Clear(Analyzer.func_alloc_sizes)
        Array.Clear(Analyzer.func_alloc_kinds)
        Array.Clear(Analyzer.func_params)
        Array.Clear(Analyzer.func_arena_vars)
        Array.Clear(Analyzer.func_partial_allocs)
        Array.Clear(Analyzer.func_dealloc_vars)
        Array.Clear(Analyzer.func_dealloc_lines)
        Array.Clear(Analyzer.func_dealloc_marks)
        Array.Clear(Analyzer.func_alias_names)
        Array.Clear(Analyzer.func_alias_roots)
        Array.Clear(Analyzer.func_const_names)
        Array.Clear(Analyzer.func_const_values)
        Array.Clear(Analyzer.func_loop_written)
        Array.Clear(Analyzer.func_partial_vars)
        Analyzer.func_loop_depth = 0
        Analyzer.snap_cond = 0
        Analyzer.snap_then_block = 0
        Analyzer.snap_else_block = 0
        Array.Clear(Analyzer.func_returned_vars)
        Array.Clear(Analyzer.func_assigned_vars)
        Array.Clear(Analyzer.func_used_vars)
        
        Analyzer.current_func = name
        Analyzer.current_func_line = line
        Analyzer.func_has_output = 0
        Analyzer.func_has_return = 0
        Analyzer.block_depth = 0
        
        IfCondition EqualTo(is_subroutine, 1) ThenBlock: {
            Analyzer.subroutines_analyzed = Add(Analyzer.subroutines_analyzed, 1)
        } ElseBlock: {
            Analyzer.functions_analyzed = Add(Analyzer.functions_analyzed, 1)
        }
        
        // Record as defined
        IfCondition NotEqual(name, 0) ThenBlock: {
            Analyzer.RecordDefinedFunc(name)
        }
        
        IfCondition EqualTo(Analyzer.verbose, 1) ThenBlock: {
            PrintMessage("  >> Entering: ")
            IfCondition NotEqual(name, 0) ThenBlock: {
                PrintMessage(name)
            } ElseBlock: {
                PrintMessage("<anonymous>")
            }
            PrintMessage("\n")
        }
    }
}

Function.Analyzer.RecordDefinedFunc {
    Input: name: Address
    Body: {
        // Check if already in list
        count = Array.Size(Analyzer.defined_funcs)
        i = 0
        WhileLoop LessThan(i, count) {
            existing = Array.Get(Analyzer.defined_funcs, i)
            IfCondition EqualTo(Analyzer.StrEqual(existing, name), 1) ThenBlock: {
                ReturnValue(0)
            }
            i = Add(i, 1)
        }
        Array.Push(Analyzer.defined_funcs, name)
    }
}

Function.Analyzer.RecordCalledFunc {
    Input: name: Address
    Body: {
        // Check if already in list and increment count
        count = Array.Size(Analyzer.called_funcs)
        i = 0
        WhileLoop LessThan(i, count) {
            existing = Array.Get(Analyzer.called_funcs, i)
            IfCondition EqualTo(Analyzer.StrEqual(existing, name), 1) ThenBlock: {
                // Increment call count
                curr = Array.Get(Analyzer.func_call_counts, i)
                Array.Set(Analyzer.func_call_counts, i, Add(curr, 1))
                ReturnValue(0)
            }
            i = Add(i, 1)
        }
        Array.Push(Analyzer.called_funcs, name)
        Array.Push(Analyzer.func_call_counts, 1)
    }
}

Function.Analyzer.RecordAssignment {
    Input: var_name: Address
    Body: {
        IfCondition EqualTo(var_name, 0) ThenBlock: {
            ReturnValue(0)
        }
        // Check if already tracked
        count = Array.Size(Analyzer.func_assigned_vars)
        i = 0
        WhileLoop LessThan(i, count) {
            existing = Array.Get(Analyzer.func_assigned_vars, i)
            IfCondition EqualTo(Analyzer.StrEqual(existing, var_name), 1) ThenBlock: {
                ReturnValue(0)
            }
            i = Add(i, 1)
        }
        Array.Push(Analyzer.func_assigned_vars, var_name)
    }
}

Function.Analyzer.RecordUsage {
    Input: var_name: Address
    Body: {
        IfCondition EqualTo(var_name, 0) ThenBlock: {
            ReturnValue(0)
        }
        // Check if already tracked
        count = Array.Size(Analyzer.func_used_vars)
        i = 0
        WhileLoop LessThan(i, count) {
            existing = Array.Get(Analyzer.func_used_vars, i)
            IfCondition EqualTo(Analyzer.StrEqual(existing, var_name), 1) ThenBlock: {
                ReturnValue(0)
            }
            i = Add(i, 1)
        }
        Array.Push(Analyzer.func_used_vars, var_name)
    }
}

Function.Analyzer.RecordReturnedVar {
    Input: var_name: Address
    Body: {
        IfCondition EqualTo(var_name, 0) ThenBlock: {
            ReturnValue(0)
        }
        Array.Push(Analyzer.func_returned_vars, var_name)
    }
}

Function.Analyzer.RecordAlloc {
    Input: var_name: Address
    Input: line: Integer
    Input: size_text: Address
    Input: kind: Integer
    Body: {
        Array.Push(Analyzer.func_alloc_vars, var_name)
        Array.Push(Analyzer.func_alloc_lines, line)
        Array.Push(Analyzer.func_alloc_sizes, size_text)
        Array.Push(Analyzer.func_alloc_kinds, kind)
        Analyzer.total_allocs = Add(Analyzer.total_allocs, 1)
        
        IfCondition EqualTo(Analyzer.verbose, 1) ThenBlock: {
            PrintMessage("     [ALLOC] ")
            IfCondition NotEqual(var_name, 0) ThenBlock: {
                PrintMessage(var_name)
            }
            PrintMessage(" @ line ")
            PrintNumber(line)
            PrintMessage("\n")
        }
    }
}

Function.Analyzer.RecordDealloc {
    Input: var_name: Address
    Input: line: Integer
    Body: {
        Array.Push(Analyzer.func_dealloc_vars, var_name)
        Array.Push(Analyzer.func_dealloc_lines, line)
        mark = Array.Size(Analyzer.func_alloc_vars)
        Array.Push(Analyzer.func_dealloc_marks, mark)
        Analyzer.total_deallocs = Add(Analyzer.total_deallocs, 1)
        
        IfCondition EqualTo(Analyzer.verbose, 1) ThenBlock: {
            PrintMessage("     [DEALLOC] ")
            IfCondition NotEqual(var_name, 0) ThenBlock: {
                PrintMessage(var_name)
            }
            PrintMessage(" @ line ")
            PrintNumber(line)
            PrintMessage("\n")
        }
    }
}

Function.Analyzer.ExitFunction {
    Body: {
        // === CHECK: Missing return value ===
        IfCondition EqualTo(Analyzer.check_returns, 1) ThenBlock: {
            IfCondition EqualTo(Analyzer.func_has_output, 1) ThenBlock: {
                IfCondition EqualTo(Analyzer.func_has_return, 0) ThenBlock: {
                    msg = StringConcat("Function '", "")
                    IfCondition NotEqual(Analyzer.current_func, 0) ThenBlock: {
                        msg = StringConcat(msg, Analyzer.current_func)
                    } ElseBlock: {
                        msg = StringConcat(msg, "<unknown>")
                    }
                    msg = StringConcat(msg, "' declares Output but has no ReturnValue")
                    Analyzer.AddWarning(msg)
                }
            }
        }
        
        // === CHECK: Unused variables ===
        IfCondition EqualTo(Analyzer.check_unused, 1) ThenBlock: {
            assigned_count = Array.Size(Analyzer.func_assigned_vars)
            i = 0
            WhileLoop LessThan(i, assigned_count) {
                var = Array.Get(Analyzer.func_assigned_vars, i)
                is_used = Analyzer.IsVarUsed(var)
                IfCondition EqualTo(is_used, 0) ThenBlock: {
                    is_ignorable = Analyzer.IsIgnorableVar(var)
                    IfCondition EqualTo(is_ignorable, 0) ThenBlock: {
                        msg = StringConcat("Variable '", "")
                        IfCondition NotEqual(var, 0) ThenBlock: {
                            msg = StringConcat(msg, var)
                        }
                        msg = StringConcat(msg, "' assigned but never used in '")
                        IfCondition NotEqual(Analyzer.current_func, 0) ThenBlock: {
                            msg = StringConcat(msg, Analyzer.current_func)
                        }
                        msg = StringConcat(msg, "'")
                        Analyzer.AddWarning(msg)
                    }
                }
                i = Add(i, 1)
            }
        }
        
        // === CHECK: Memory leaks (skip if returned or FixedPool member) ===
        IfCondition EqualTo(Analyzer.check_memory, 1) ThenBlock: {
            alloc_count = Array.Size(Analyzer.func_alloc_vars)
            
            i = 0
            WhileLoop LessThan(i, alloc_count) {
                alloc_var = Array.Get(Analyzer.func_alloc_vars, i)
                alloc_line = Array.Get(Analyzer.func_alloc_lines, i)
                
                // Skip FixedPool members (contain dot) - managed globally
                is_pool_member = Analyzer.IsPoolMember(alloc_var)
                IfCondition EqualTo(is_pool_member, 0) ThenBlock: {
                    // Check if deallocated
                    found_dealloc = Analyzer.AllocIsCovered(i)
                    
                    // Check if returned (not a leak if returned)
                    is_returned = Analyzer.IsVarReturned(alloc_var)
                    latest = Analyzer.IsLatestAlloc(i)
                    
                    IfCondition EqualTo(found_dealloc, 1) ThenBlock: {
                        IfCondition EqualTo(is_returned, 1) ThenBlock: {
                            IfCondition EqualTo(latest, 1) ThenBlock: {
                                Analyzer.WarnMem("MEM-BOTH", alloc_line, alloc_var, "returned and freed")
                                Analyzer.both_warnings = Add(Analyzer.both_warnings, 1)
                            }
                        }
                    }
                    IfCondition EqualTo(found_dealloc, 0) ThenBlock: {
                        IfCondition EqualTo(is_returned, 0) ThenBlock: {
                            // A one-sided free already reported MEM-PATH.
                            is_partial = Analyzer.ListHas(Analyzer.func_partial_vars, alloc_var)
                            IfCondition EqualTo(is_partial, 0) ThenBlock: {
                                Analyzer.WarnMem("MEM-LEAK", alloc_line, alloc_var, "allocated but not freed")
                                Analyzer.leak_warnings = Add(Analyzer.leak_warnings, 1)
                            }
                        }
                    }
                }
                
                i = Add(i, 1)
            }
        }
        
        IfCondition EqualTo(Analyzer.verbose, 1) ThenBlock: {
            PrintMessage("  << Exiting: ")
            IfCondition NotEqual(Analyzer.current_func, 0) ThenBlock: {
                PrintMessage(Analyzer.current_func)
            }
            PrintMessage(" — ")
            PrintNumber(Array.Size(Analyzer.func_alloc_vars))
            PrintMessage(" allocs, ")
            PrintNumber(Array.Size(Analyzer.func_dealloc_vars))
            PrintMessage(" deallocs, ")
            PrintNumber(Array.Size(Analyzer.func_assigned_vars))
            PrintMessage(" assigns, ")
            PrintNumber(Array.Size(Analyzer.func_used_vars))
            PrintMessage(" uses\n")
        }
    }
}

Function.Analyzer.IsAllocName {
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }
        cmp = StringCompare(name, "Allocate")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
        cmp = StringCompare(name, "Arena_Alloc")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
        cmp = StringCompare(name, "ArrayCreate")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
        cmp = StringCompare(name, "Array.Create")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
        cmp = StringCompare(name, "AllocateLinkage")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

Function.Analyzer.IsFreeName {
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }
        cmp = StringCompare(name, "Deallocate")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
        cmp = StringCompare(name, "Arena_Free")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
        cmp = StringCompare(name, "ArrayDestroy")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
        cmp = StringCompare(name, "Array.Destroy")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
        cmp = StringCompare(name, "FreeLinkage")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

Function.Analyzer.IsLiveAlloc {
    Input: var_name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(var_name, 0) ThenBlock: { ReturnValue(0) }
        is_pool = Analyzer.IsPoolMember(var_name)
        IfCondition EqualTo(is_pool, 1) ThenBlock: { ReturnValue(0) }

        latest = Subtract(0, 1)
        count = Array.Size(Analyzer.func_alloc_vars)
        i = 0
        WhileLoop LessThan(i, count) {
            existing = Array.Get(Analyzer.func_alloc_vars, i)
            same = Analyzer.StrEqual(existing, var_name)
            IfCondition EqualTo(same, 1) ThenBlock: { latest = i }
            i = Add(i, 1)
        }
        IfCondition LessThan(latest, 0) ThenBlock: { ReturnValue(0) }

        freed = Analyzer.AllocIsCovered(latest)
        IfCondition EqualTo(freed, 1) ThenBlock: { ReturnValue(0) }
        ReturnValue(1)
    }
}

Function.Analyzer.WarnMem {
    Input: code: Address
    Input: line: Integer
    Input: var_name: Address
    Input: detail: Address
    Body: {
        loc = FileMap_Format(line)
        msg = StringConcat(code, " ")
        msg = StringConcat(msg, loc)
        msg = StringConcat(msg, ": '")
        IfCondition NotEqual(var_name, 0) ThenBlock: {
            msg = StringConcat(msg, var_name)
        } ElseBlock: {
            msg = StringConcat(msg, "<expr>")
        }
        msg = StringConcat(msg, "' ")
        IfCondition NotEqual(detail, 0) ThenBlock: {
            msg = StringConcat(msg, detail)
        }
        IfCondition NotEqual(Analyzer.current_func, 0) ThenBlock: {
            msg = StringConcat(msg, " in '")
            msg = StringConcat(msg, Analyzer.current_func)
            msg = StringConcat(msg, "'")
        }
        Analyzer.AddWarning(msg)
    }
}

Function.Analyzer.IsPoolMember {
    Input: var_name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(var_name, 0) ThenBlock: {
            ReturnValue(0)
        }
        
        len = StringLength(var_name)
        i = 0
        WhileLoop LessThan(i, len) {
            ch = GetByte(var_name, i)
            IfCondition EqualTo(ch, 46) ThenBlock: {
                ReturnValue(1)
            }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

Function.Analyzer.IsVarDeallocated {
    Input: var_name: Address
    Output: Integer
    Body: {
        dealloc_count = Array.Size(Analyzer.func_dealloc_vars)
        j = 0
        WhileLoop LessThan(j, dealloc_count) {
            dealloc_var = Array.Get(Analyzer.func_dealloc_vars, j)
            IfCondition EqualTo(Analyzer.StrEqual(var_name, dealloc_var), 1) ThenBlock: {
                ReturnValue(1)
            }
            j = Add(j, 1)
        }
        ReturnValue(0)
    }
}

Function.Analyzer.IsVarReturned {
    Input: var_name: Address
    Output: Integer
    Body: {
        ret_count = Array.Size(Analyzer.func_returned_vars)
        j = 0
        WhileLoop LessThan(j, ret_count) {
            ret_var = Array.Get(Analyzer.func_returned_vars, j)
            IfCondition EqualTo(Analyzer.StrEqual(var_name, ret_var), 1) ThenBlock: {
                ReturnValue(1)
            }
            j = Add(j, 1)
        }
        ReturnValue(0)
    }
}

Function.Analyzer.IsVarUsed {
    Input: var_name: Address
    Output: Integer
    Body: {
        used_count = Array.Size(Analyzer.func_used_vars)
        j = 0
        WhileLoop LessThan(j, used_count) {
            used_var = Array.Get(Analyzer.func_used_vars, j)
            IfCondition EqualTo(Analyzer.StrEqual(var_name, used_var), 1) ThenBlock: {
                ReturnValue(1)
            }
            j = Add(j, 1)
        }
        ReturnValue(0)
    }
}

Function.Analyzer.IsIgnorableVar {
    Input: var_name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(var_name, 0) ThenBlock: {
            ReturnValue(1)
        }
        
        len = StringLength(var_name)
        
        // Single char vars like i, j, k are often loop counters
        IfCondition EqualTo(len, 1) ThenBlock: {
            ReturnValue(1)
        }
        
        // Variables starting with underscore are intentionally unused
        first = GetByte(var_name, 0)
        IfCondition EqualTo(first, 95) ThenBlock: {
            ReturnValue(1)
        }
        
        // FixedPool members (contain a dot) - these are global state
        i = 0
        WhileLoop LessThan(i, len) {
            ch = GetByte(var_name, i)
            IfCondition EqualTo(ch, 46) ThenBlock: {
                // Found a dot - it's Pool.member syntax
                ReturnValue(1)
            }
            i = Add(i, 1)
        }
        
        ReturnValue(0)
    }
}

// =============================================================================
// SIZES, PATHS, ARENA TEMPS, OWNERSHIP
// =============================================================================
Function.Analyzer.ListHas {
    Input: list: Address
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(list, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }
        count = Array.Size(list)
        i = 0
        WhileLoop LessThan(i, count) {
            existing = Array.Get(list, i)
            same = Analyzer.StrEqual(existing, name)
            IfCondition EqualTo(same, 1) ThenBlock: { ReturnValue(1) }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

Function.Analyzer.PopTo {
    Input: list: Address
    Input: start: Integer
    Body: {
        IfCondition EqualTo(list, 0) ThenBlock: { ReturnValue(0) }
        sz = Array.Size(list)
        WhileLoop GreaterThan(sz, start) {
            Array.Pop(list)
            sz = Array.Size(list)
        }
    }
}

Function.Analyzer.TakeNames {
    Input: list: Address
    Input: start: Integer
    Output: Address
    Body: {
        out = Array.Create(8)
        IfCondition EqualTo(list, 0) ThenBlock: { ReturnValue(out) }
        count = Array.Size(list)
        i = start
        WhileLoop LessThan(i, count) {
            item = Array.Get(list, i)
            Array.Push(out, item)
            i = Add(i, 1)
        }
        Analyzer.PopTo(list, start)
        ReturnValue(out)
    }
}

Function.Analyzer.IsArenaTemp {
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }
        cmp = StringCompare(name, "StringConcat")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
        cmp = StringCompare(name, "NumberToString")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
        cmp = StringCompare(name, "StringCopy")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
        cmp = StringCompare(name, "StringSubstring")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

Function.Analyzer.IsByteAlloc {
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }
        cmp = StringCompare(name, "Allocate")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
        cmp = StringCompare(name, "Arena_Alloc")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

Function.Analyzer.IsByteFree {
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }
        cmp = StringCompare(name, "Deallocate")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
        cmp = StringCompare(name, "Arena_Free")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

Function.Analyzer.LastSize {
    Input: var_name: Address
    Output: Address
    Body: {
        found = 0
        key = Analyzer.RootOf(var_name)
        IfCondition EqualTo(key, 0) ThenBlock: { ReturnValue(0) }
        count = Array.Size(Analyzer.func_alloc_vars)
        i = 0
        WhileLoop LessThan(i, count) {
            existing = Array.Get(Analyzer.func_alloc_vars, i)
            same = Analyzer.StrEqual(existing, key)
            IfCondition EqualTo(same, 1) ThenBlock: {
                found = Array.Get(Analyzer.func_alloc_sizes, i)
            }
            i = Add(i, 1)
        }
        ReturnValue(found)
    }
}

Function.Analyzer.LastKind {
    Input: var_name: Address
    Output: Integer
    Body: {
        found = 0
        key = Analyzer.RootOf(var_name)
        IfCondition EqualTo(key, 0) ThenBlock: { ReturnValue(0) }
        count = Array.Size(Analyzer.func_alloc_vars)
        i = 0
        WhileLoop LessThan(i, count) {
            existing = Array.Get(Analyzer.func_alloc_vars, i)
            same = Analyzer.StrEqual(existing, key)
            IfCondition EqualTo(same, 1) ThenBlock: {
                found = Array.Get(Analyzer.func_alloc_kinds, i)
            }
            i = Add(i, 1)
        }
        ReturnValue(found)
    }
}

Function.Analyzer.AllocKind {
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }
        cmp = StringCompare(name, "Allocate")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
        cmp = StringCompare(name, "Arena_Alloc")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
        cmp = StringCompare(name, "ArrayCreate")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(2) }
        cmp = StringCompare(name, "Array.Create")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(2) }
        cmp = StringCompare(name, "AllocateLinkage")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(3) }
        ReturnValue(0)
    }
}

Function.Analyzer.FreeKind {
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }
        cmp = StringCompare(name, "Deallocate")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
        cmp = StringCompare(name, "Arena_Free")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
        cmp = StringCompare(name, "ArrayDestroy")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(2) }
        cmp = StringCompare(name, "Array.Destroy")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(2) }
        cmp = StringCompare(name, "FreeLinkage")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(3) }
        ReturnValue(0)
    }
}

Function.Analyzer.IndexOf {
    Input: list: Address
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(list, 0) ThenBlock: { ReturnValue(Subtract(0, 1)) }
        count = Array.Size(list)
        i = 0
        WhileLoop LessThan(i, count) {
            existing = Array.Get(list, i)
            same = Analyzer.StrEqual(existing, name)
            IfCondition EqualTo(same, 1) ThenBlock: { ReturnValue(i) }
            i = Add(i, 1)
        }
        ReturnValue(Subtract(0, 1))
    }
}

// A free covers allocations recorded before it. A later allocate of the
// same name is a new block and still needs its own free.
Function.Analyzer.AllocIsCovered {
    Input: index: Integer
    Output: Integer
    Body: {
        name = Array.Get(Analyzer.func_alloc_vars, index)
        dcount = Array.Size(Analyzer.func_dealloc_vars)
        j = 0
        WhileLoop LessThan(j, dcount) {
            dname = Array.Get(Analyzer.func_dealloc_vars, j)
            mark = Array.Get(Analyzer.func_dealloc_marks, j)
            same = Analyzer.StrEqual(dname, name)
            IfCondition EqualTo(same, 1) ThenBlock: {
                IfCondition GreaterThan(mark, index) ThenBlock: {
                    ReturnValue(1)
                }
            }
            j = Add(j, 1)
        }
        ReturnValue(0)
    }
}

Function.Analyzer.IsLatestAlloc {
    Input: index: Integer
    Output: Integer
    Body: {
        name = Array.Get(Analyzer.func_alloc_vars, index)
        count = Array.Size(Analyzer.func_alloc_vars)
        j = Add(index, 1)
        WhileLoop LessThan(j, count) {
            other = Array.Get(Analyzer.func_alloc_vars, j)
            same = Analyzer.StrEqual(other, name)
            IfCondition EqualTo(same, 1) ThenBlock: { ReturnValue(0) }
            j = Add(j, 1)
        }
        ReturnValue(1)
    }
}

Function.Analyzer.RootOf {
    Input: name: Address
    Output: Address
    Body: {
        current = name
        steps = 0
        WhileLoop LessThan(steps, 8) {
            idx = Analyzer.IndexOf(Analyzer.func_alias_names, current)
            IfCondition LessThan(idx, 0) ThenBlock: { ReturnValue(current) }
            current = Array.Get(Analyzer.func_alias_roots, idx)
            steps = Add(steps, 1)
        }
        ReturnValue(current)
    }
}

Function.Analyzer.ClearAlias {
    Input: name: Address
    Body: {
        idx = Analyzer.IndexOf(Analyzer.func_alias_names, name)
        IfCondition LessThan(idx, 0) ThenBlock: { ReturnValue(0) }
        last = Array.Size(Analyzer.func_alias_names)
        last = Subtract(last, 1)
        IfCondition NotEqual(idx, last) ThenBlock: {
            Array.Swap(Analyzer.func_alias_names, idx, last)
            Array.Swap(Analyzer.func_alias_roots, idx, last)
        }
        Array.Pop(Analyzer.func_alias_names)
        Array.Pop(Analyzer.func_alias_roots)
    }
}

Function.Analyzer.BindAlias {
    Input: name: Address
    Input: root: Address
    Body: {
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(root, 0) ThenBlock: { ReturnValue(0) }
        same = Analyzer.StrEqual(name, root)
        IfCondition EqualTo(same, 1) ThenBlock: {
            Analyzer.ClearAlias(name)
            ReturnValue(0)
        }
        idx = Analyzer.IndexOf(Analyzer.func_alias_names, name)
        IfCondition GreaterEqual(idx, 0) ThenBlock: {
            Array.Set(Analyzer.func_alias_roots, idx, root)
            ReturnValue(0)
        }
        Array.Push(Analyzer.func_alias_names, name)
        Array.Push(Analyzer.func_alias_roots, root)
    }
}

Function.Analyzer.ConstClear {
    Input: name: Address
    Body: {
        idx = Analyzer.IndexOf(Analyzer.func_const_names, name)
        IfCondition LessThan(idx, 0) ThenBlock: { ReturnValue(0) }
        last = Array.Size(Analyzer.func_const_names)
        last = Subtract(last, 1)
        IfCondition NotEqual(idx, last) ThenBlock: {
            Array.Swap(Analyzer.func_const_names, idx, last)
            Array.Swap(Analyzer.func_const_values, idx, last)
        }
        Array.Pop(Analyzer.func_const_names)
        Array.Pop(Analyzer.func_const_values)
    }
}

Function.Analyzer.ConstSet {
    Input: name: Address
    Input: text: Address
    Body: {
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(text, 0) ThenBlock: { ReturnValue(0) }
        idx = Analyzer.IndexOf(Analyzer.func_const_names, name)
        IfCondition GreaterEqual(idx, 0) ThenBlock: {
            Array.Set(Analyzer.func_const_values, idx, text)
            ReturnValue(0)
        }
        Array.Push(Analyzer.func_const_names, name)
        Array.Push(Analyzer.func_const_values, text)
    }
}

Function.Analyzer.ConstGet {
    Input: name: Address
    Output: Address
    Body: {
        // A name written in a loop is not the value of one trip.
        tainted = Analyzer.ListHas(Analyzer.func_loop_written, name)
        IfCondition EqualTo(tainted, 1) ThenBlock: { ReturnValue(0) }
        idx = Analyzer.IndexOf(Analyzer.func_const_names, name)
        IfCondition LessThan(idx, 0) ThenBlock: { ReturnValue(0) }
        found = Array.Get(Analyzer.func_const_values, idx)
        ReturnValue(found)
    }
}

Function.Analyzer.UnmarkLoopWrite {
    Input: name: Address
    Body: {
        idx = Analyzer.IndexOf(Analyzer.func_loop_written, name)
        IfCondition LessThan(idx, 0) ThenBlock: { ReturnValue(0) }
        last = Array.Size(Analyzer.func_loop_written)
        last = Subtract(last, 1)
        IfCondition NotEqual(idx, last) ThenBlock: {
            Array.Swap(Analyzer.func_loop_written, idx, last)
        }
        Array.Pop(Analyzer.func_loop_written)
    }
}

Function.Analyzer.MarkLoopWrite {
    Input: name: Address
    Body: {
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }
        Analyzer.ConstClear(name)
        seen = Analyzer.ListHas(Analyzer.func_loop_written, name)
        IfCondition EqualTo(seen, 0) ThenBlock: {
            Array.Push(Analyzer.func_loop_written, name)
        }
    }
}

Function.Analyzer.CollectLoopWrites {
    Input: node: Address
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        node_type = AST_GetType(node)
        IfCondition EqualTo(node_type, AST.FUNCTION) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(node_type, AST.SUBROUTINE) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(node_type, AST.ASSIGNMENT) ThenBlock: {
            target = AST_GetData1(node)
            Analyzer.MarkLoopWrite(target)
        }
        count = AST_GetChildCount(node)
        i = 0
        WhileLoop LessThan(i, count) {
            child = AST_GetChild(node, i)
            Analyzer.CollectLoopWrites(child)
            i = Add(i, 1)
        }
    }
}

Function.Analyzer.ParseDigits {
    Input: text: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(text, 0) ThenBlock: { ReturnValue(Subtract(0, 1)) }
        len = StringLength(text)
        IfCondition EqualTo(len, 0) ThenBlock: { ReturnValue(Subtract(0, 1)) }
        n = 0
        i = 0
        WhileLoop LessThan(i, len) {
            ch = GetByte(text, i)
            below = LessThan(ch, 48)
            above = GreaterThan(ch, 57)
            IfCondition EqualTo(below, 1) ThenBlock: { ReturnValue(Subtract(0, 1)) }
            IfCondition EqualTo(above, 1) ThenBlock: { ReturnValue(Subtract(0, 1)) }
            scaled = Multiply(n, 10)
            digit = Subtract(ch, 48)
            n = Add(scaled, digit)
            i = Add(i, 1)
        }
        ReturnValue(n)
    }
}

Function.Analyzer.ConstText {
    Input: node: Address
    Output: Address
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        node_type = AST_GetType(node)
        IfCondition EqualTo(node_type, AST.NUMBER) ThenBlock: {
            ReturnValue(AST_GetData1(node))
        }
        IfCondition EqualTo(node_type, AST.IDENTIFIER) ThenBlock: {
            ident = AST_GetData1(node)
            found = Analyzer.ConstGet(ident)
            ReturnValue(found)
        }
        IfCondition EqualTo(node_type, AST.CALL) ThenBlock: {
            call_name = AST_GetData1(node)
            is_add = Analyzer.StrEqual(call_name, "Add")
            is_sub = Analyzer.StrEqual(call_name, "Subtract")
            IfCondition EqualTo(is_add, 0) ThenBlock: {
                IfCondition EqualTo(is_sub, 0) ThenBlock: { ReturnValue(0) }
            }
            count = AST_GetChildCount(node)
            IfCondition LessThan(count, 2) ThenBlock: { ReturnValue(0) }
            left_node = AST_GetChild(node, 0)
            right_node = AST_GetChild(node, 1)
            left_text = Analyzer.ConstText(left_node)
            right_text = Analyzer.ConstText(right_node)
            left_n = Analyzer.ParseDigits(left_text)
            right_n = Analyzer.ParseDigits(right_text)
            IfCondition LessThan(left_n, 0) ThenBlock: { ReturnValue(0) }
            IfCondition LessThan(right_n, 0) ThenBlock: { ReturnValue(0) }
            result = 0
            IfCondition EqualTo(is_add, 1) ThenBlock: {
                result = Add(left_n, right_n)
            }
            IfCondition EqualTo(is_sub, 1) ThenBlock: {
                result = Subtract(left_n, right_n)
            }
            IfCondition LessThan(result, 0) ThenBlock: { ReturnValue(0) }
            text = NumberToString(result)
            ReturnValue(text)
        }
        ReturnValue(0)
    }
}

Function.Analyzer.LiteralText {
    Input: call_node: Address
    Input: index: Integer
    Output: Address
    Body: {
        IfCondition EqualTo(call_node, 0) ThenBlock: { ReturnValue(0) }
        count = AST_GetChildCount(call_node)
        IfCondition LessEqual(count, index) ThenBlock: { ReturnValue(0) }
        child = AST_GetChild(call_node, index)
        text = Analyzer.ConstText(child)
        ReturnValue(text)
    }
}

Function.Analyzer.NoteAssignValue {
    Input: target: Address
    Input: value: Address
    Input: direct_alloc: Integer
    Body: {
        IfCondition EqualTo(direct_alloc, 1) ThenBlock: {
            Analyzer.ClearAlias(target)
            Analyzer.ConstClear(target)
            ReturnValue(0)
        }
        value_type = AST_GetType(value)
        IfCondition EqualTo(value_type, AST.IDENTIFIER) ThenBlock: {
            rhs = AST_GetData1(value)
            root = Analyzer.RootOf(rhs)
            tracked = Analyzer.ListHas(Analyzer.func_alloc_vars, root)
            IfCondition EqualTo(tracked, 0) ThenBlock: {
                tracked = Analyzer.ListHas(Analyzer.func_params, root)
            }
            IfCondition EqualTo(tracked, 0) ThenBlock: {
                tracked = Analyzer.ListHas(Analyzer.func_arena_vars, root)
            }
            IfCondition EqualTo(tracked, 0) ThenBlock: {
                tracked = Analyzer.ListHas(Analyzer.func_alias_names, rhs)
            }
            IfCondition EqualTo(tracked, 1) ThenBlock: {
                Analyzer.ConstClear(target)
                Analyzer.BindAlias(target, root)
                ReturnValue(0)
            }
        }
        Analyzer.ClearAlias(target)
        tainted = 0
        IfCondition GreaterThan(Analyzer.func_loop_depth, 0) ThenBlock: {
            tainted = Analyzer.ListHas(Analyzer.func_loop_written, target)
        }
        IfCondition EqualTo(tainted, 1) ThenBlock: {
            Analyzer.ConstClear(target)
            ReturnValue(0)
        }
        text = Analyzer.ConstText(value)
        IfCondition NotEqual(text, 0) ThenBlock: {
            Analyzer.ConstSet(target, text)
            IfCondition EqualTo(Analyzer.func_loop_depth, 0) ThenBlock: {
                Analyzer.UnmarkLoopWrite(target)
            }
            ReturnValue(0)
        }
        Analyzer.ConstClear(target)
        IfCondition EqualTo(Analyzer.func_loop_depth, 0) ThenBlock: {
            Analyzer.UnmarkLoopWrite(target)
        }
    }
}

// 1 when text is SYS_EXIT or Pool.SYS_EXIT. The lexer often keeps the dot in one identifier.
Function.Analyzer.IsSysExitName {
    Input: text: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(text, 0) ThenBlock: { ReturnValue(0) }
        len = StringLength(text)
        IfCondition LessThan(len, 8) ThenBlock: { ReturnValue(0) }
        start = Subtract(len, 8)
        IfCondition GreaterThan(len, 8) ThenBlock: {
            dot_at = Subtract(start, 1)
            dot = GetByte(text, dot_at)
            IfCondition NotEqual(dot, 46) ThenBlock: { ReturnValue(0) }
        }
        i = 0
        ok = 1
        WhileLoop LessThan(i, 8) {
            pos = Add(start, i)
            ch = GetByte(text, pos)
            expect = 0
            IfCondition EqualTo(i, 0) ThenBlock: { expect = 83 }
            IfCondition EqualTo(i, 1) ThenBlock: { expect = 89 }
            IfCondition EqualTo(i, 2) ThenBlock: { expect = 83 }
            IfCondition EqualTo(i, 3) ThenBlock: { expect = 95 }
            IfCondition EqualTo(i, 4) ThenBlock: { expect = 69 }
            IfCondition EqualTo(i, 5) ThenBlock: { expect = 88 }
            IfCondition EqualTo(i, 6) ThenBlock: { expect = 73 }
            IfCondition EqualTo(i, 7) ThenBlock: { expect = 84 }
            IfCondition NotEqual(ch, expect) ThenBlock: { ok = 0 }
            i = Add(i, 1)
        }
        ReturnValue(ok)
    }
}

// Linux exit is syscall 60. HaltProgram and a SYS_EXIT member end the process.
Function.Analyzer.IsExitArg {
    Input: node: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        node_type = AST_GetType(node)
        IfCondition EqualTo(node_type, AST.NUMBER) ThenBlock: {
            text = AST_GetData1(node)
            IfCondition EqualTo(text, 0) ThenBlock: { ReturnValue(0) }
            cmp = StringCompare(text, "60")
            IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
            ReturnValue(0)
        }
        IfCondition EqualTo(node_type, AST.IDENTIFIER) ThenBlock: {
            ident = AST_GetData1(node)
            named = Analyzer.IsSysExitName(ident)
            IfCondition EqualTo(named, 1) ThenBlock: { ReturnValue(1) }
            text = Analyzer.ConstGet(ident)
            IfCondition EqualTo(text, 0) ThenBlock: { ReturnValue(0) }
            cmp = StringCompare(text, "60")
            IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
            ReturnValue(0)
        }
        IfCondition EqualTo(node_type, AST.MEMBER_ACCESS) ThenBlock: {
            member = AST_GetData1(node)
            named = Analyzer.IsSysExitName(member)
            ReturnValue(named)
        }
        ReturnValue(0)
    }
}

Function.Analyzer.IsExitCall {
    Input: node: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        node_type = AST_GetType(node)
        IfCondition NotEqual(node_type, AST.CALL) ThenBlock: { ReturnValue(0) }
        name = AST_GetData1(node)
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }
        cmp = StringCompare(name, "HaltProgram")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
        cmp = StringCompare(name, "Exit")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
        cmp = StringCompare(name, "ProcessExit")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
        cmp = StringCompare(name, "SystemCall")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            count = AST_GetChildCount(node)
            IfCondition LessThan(count, 1) ThenBlock: { ReturnValue(0) }
            arg = AST_GetChild(node, 0)
            hit = Analyzer.IsExitArg(arg)
            ReturnValue(hit)
        }
        ReturnValue(0)
    }
}

// 1 when the node ends in HaltProgram or an exit syscall.
Function.Analyzer.ArmHalts {
    Input: node: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        node_type = AST_GetType(node)
        IfCondition EqualTo(node_type, AST.HALT) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(node_type, AST.CALL) ThenBlock: {
            hit = Analyzer.IsExitCall(node)
            ReturnValue(hit)
        }
        is_block = 0
        IfCondition EqualTo(node_type, AST.BLOCK) ThenBlock: { is_block = 1 }
        IfCondition EqualTo(node_type, AST.BODY) ThenBlock: { is_block = 1 }
        IfCondition EqualTo(is_block, 1) ThenBlock: {
            count = AST_GetChildCount(node)
            IfCondition EqualTo(count, 0) ThenBlock: { ReturnValue(0) }
            last_i = Subtract(count, 1)
            last = AST_GetChild(node, last_i)
            hit = Analyzer.ArmHalts(last)
            ReturnValue(hit)
        }
        is_branch = 0
        IfCondition EqualTo(node_type, AST.IF) ThenBlock: { is_branch = 1 }
        IfCondition EqualTo(node_type, AST.FORK) ThenBlock: { is_branch = 1 }
        IfCondition EqualTo(is_branch, 1) ThenBlock: {
            count = AST_GetChildCount(node)
            IfCondition LessThan(count, 3) ThenBlock: { ReturnValue(0) }
            then_node = AST_GetChild(node, 1)
            else_node = AST_GetChild(node, 2)
            then_hit = Analyzer.ArmHalts(then_node)
            IfCondition EqualTo(then_hit, 0) ThenBlock: { ReturnValue(0) }
            else_hit = Analyzer.ArmHalts(else_node)
            ReturnValue(else_hit)
        }
        ReturnValue(0)
    }
}

// The identifier returned on every path, or 0 when the node does not
// hand one name back.
Function.Analyzer.ReturnedIdent {
    Input: node: Address
    Output: Address
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        node_type = AST_GetType(node)
        IfCondition EqualTo(node_type, AST.RETURN) ThenBlock: {
            count = AST_GetChildCount(node)
            IfCondition LessThan(count, 1) ThenBlock: { ReturnValue(0) }
            expr = AST_GetChild(node, 0)
            IfCondition EqualTo(expr, 0) ThenBlock: { ReturnValue(0) }
            expr_type = AST_GetType(expr)
            IfCondition NotEqual(expr_type, AST.IDENTIFIER) ThenBlock: { ReturnValue(0) }
            ident = AST_GetData1(expr)
            ReturnValue(ident)
        }
        is_block = 0
        IfCondition EqualTo(node_type, AST.BLOCK) ThenBlock: { is_block = 1 }
        IfCondition EqualTo(node_type, AST.BODY) ThenBlock: { is_block = 1 }
        IfCondition EqualTo(is_block, 1) ThenBlock: {
            count = AST_GetChildCount(node)
            IfCondition EqualTo(count, 0) ThenBlock: { ReturnValue(0) }
            last_i = Subtract(count, 1)
            last = AST_GetChild(node, last_i)
            found = Analyzer.ReturnedIdent(last)
            ReturnValue(found)
        }
        is_branch = 0
        IfCondition EqualTo(node_type, AST.IF) ThenBlock: { is_branch = 1 }
        IfCondition EqualTo(node_type, AST.FORK) ThenBlock: { is_branch = 1 }
        IfCondition EqualTo(is_branch, 1) ThenBlock: {
            count = AST_GetChildCount(node)
            IfCondition LessThan(count, 3) ThenBlock: { ReturnValue(0) }
            then_node = AST_GetChild(node, 1)
            else_node = AST_GetChild(node, 2)
            then_exits = Analyzer.ArmExits(then_node)
            IfCondition EqualTo(then_exits, 0) ThenBlock: { ReturnValue(0) }
            else_exits = Analyzer.ArmExits(else_node)
            IfCondition EqualTo(else_exits, 0) ThenBlock: { ReturnValue(0) }
            then_name = Analyzer.ReturnedIdent(then_node)
            else_name = Analyzer.ReturnedIdent(else_node)
            same = Analyzer.StrEqual(then_name, else_name)
            IfCondition EqualTo(same, 0) ThenBlock: { ReturnValue(0) }
            ReturnValue(then_name)
        }
        ReturnValue(0)
    }
}

// 1 when a one-sided alloc should still be reported. An arm that returns
// this name, or that halts, does not merge the block into the other path.
Function.Analyzer.PartialAllocStays {
    Input: name: Address
    Input: arm: Address
    Output: Integer
    Body: {
        exits = Analyzer.ArmExits(arm)
        IfCondition EqualTo(exits, 0) ThenBlock: { ReturnValue(1) }
        handed = Analyzer.ReturnedIdent(arm)
        same = Analyzer.StrEqual(handed, name)
        IfCondition EqualTo(same, 1) ThenBlock: { ReturnValue(0) }
        halts = Analyzer.ArmHalts(arm)
        IfCondition EqualTo(halts, 1) ThenBlock: { ReturnValue(0) }
        ReturnValue(1)
    }
}

Function.Analyzer.IsZeroNode {
    Input: node: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        node_type = AST_GetType(node)
        IfCondition NotEqual(node_type, AST.NUMBER) ThenBlock: { ReturnValue(0) }
        text = AST_GetData1(node)
        IfCondition EqualTo(text, 0) ThenBlock: { ReturnValue(0) }
        cmp = StringCompare(text, "0")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

// 1 when this one-sided free is the non-null side of a null check.
// on_then is 1 when the free is only in the then arm.
Function.Analyzer.NullGuardFree {
    Input: name: Address
    Input: on_then: Integer
    Output: Integer
    Body: {
        cond = Analyzer.snap_cond
        IfCondition EqualTo(cond, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }
        node_type = AST_GetType(cond)
        IfCondition NotEqual(node_type, AST.CALL) ThenBlock: { ReturnValue(0) }
        call_name = AST_GetData1(cond)
        is_eq = Analyzer.StrEqual(call_name, "EqualTo")
        is_ne = Analyzer.StrEqual(call_name, "NotEqual")
        IfCondition EqualTo(is_eq, 0) ThenBlock: {
            IfCondition EqualTo(is_ne, 0) ThenBlock: { ReturnValue(0) }
        }
        count = AST_GetChildCount(cond)
        IfCondition LessThan(count, 2) ThenBlock: { ReturnValue(0) }
        left = AST_GetChild(cond, 0)
        right = AST_GetChild(cond, 1)
        left_name = 0
        right_name = 0
        IfCondition EqualTo(AST_GetType(left), AST.IDENTIFIER) ThenBlock: {
            left_name = AST_GetData1(left)
        }
        IfCondition EqualTo(AST_GetType(right), AST.IDENTIFIER) ThenBlock: {
            right_name = AST_GetData1(right)
        }
        name_is_left = Analyzer.StrEqual(left_name, name)
        name_is_right = Analyzer.StrEqual(right_name, name)
        zero_right = Analyzer.IsZeroNode(right)
        zero_left = Analyzer.IsZeroNode(left)
        matched = 0
        IfCondition EqualTo(name_is_left, 1) ThenBlock: {
            IfCondition EqualTo(zero_right, 1) ThenBlock: { matched = 1 }
        }
        IfCondition EqualTo(name_is_right, 1) ThenBlock: {
            IfCondition EqualTo(zero_left, 1) ThenBlock: { matched = 1 }
        }
        IfCondition EqualTo(matched, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(is_eq, 1) ThenBlock: {
            IfCondition EqualTo(on_then, 0) ThenBlock: { ReturnValue(1) }
            ReturnValue(0)
        }
        IfCondition EqualTo(on_then, 1) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

Function.Analyzer.NoteSureFree {
    Input: name: Address
    Body: {
        already = Analyzer.ListHas(Analyzer.func_dealloc_vars, name)
        IfCondition EqualTo(already, 0) ThenBlock: {
            Array.Push(Analyzer.func_dealloc_vars, name)
            Array.Push(Analyzer.func_dealloc_lines, 0)
            join_mark = Array.Size(Analyzer.func_alloc_vars)
            Array.Push(Analyzer.func_dealloc_marks, join_mark)
        }
    }
}

// 1 when every path through this node returns or halts, so the node does not
// fall through into the statement after it.
Function.Analyzer.ArmExits {
    Input: node: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        node_type = AST_GetType(node)
        IfCondition EqualTo(node_type, AST.RETURN) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(node_type, AST.HALT) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(node_type, AST.CALL) ThenBlock: {
            exits = Analyzer.IsExitCall(node)
            ReturnValue(exits)
        }
        is_block = 0
        IfCondition EqualTo(node_type, AST.BLOCK) ThenBlock: { is_block = 1 }
        IfCondition EqualTo(node_type, AST.BODY) ThenBlock: { is_block = 1 }
        IfCondition EqualTo(is_block, 1) ThenBlock: {
            count = AST_GetChildCount(node)
            IfCondition EqualTo(count, 0) ThenBlock: { ReturnValue(0) }
            last_i = Subtract(count, 1)
            last = AST_GetChild(node, last_i)
            exits = Analyzer.ArmExits(last)
            ReturnValue(exits)
        }
        is_branch = 0
        IfCondition EqualTo(node_type, AST.IF) ThenBlock: { is_branch = 1 }
        IfCondition EqualTo(node_type, AST.FORK) ThenBlock: { is_branch = 1 }
        IfCondition EqualTo(is_branch, 1) ThenBlock: {
            count = AST_GetChildCount(node)
            IfCondition LessThan(count, 3) ThenBlock: { ReturnValue(0) }
            then_node = AST_GetChild(node, 1)
            else_node = AST_GetChild(node, 2)
            then_exits = Analyzer.ArmExits(then_node)
            else_exits = Analyzer.ArmExits(else_node)
            IfCondition EqualTo(then_exits, 1) ThenBlock: {
                IfCondition EqualTo(else_exits, 1) ThenBlock: { ReturnValue(1) }
            }
            ReturnValue(0)
        }
        ReturnValue(0)
    }
}

Function.Analyzer.PushAllocRecord {
    Input: name: Address
    Input: line: Integer
    Input: size_text: Address
    Input: kind: Integer
    Body: {
        already = Analyzer.ListHas(Analyzer.func_alloc_vars, name)
        IfCondition EqualTo(already, 1) ThenBlock: { ReturnValue(0) }
        Array.Push(Analyzer.func_alloc_vars, name)
        Array.Push(Analyzer.func_alloc_lines, line)
        Array.Push(Analyzer.func_alloc_sizes, size_text)
        Array.Push(Analyzer.func_alloc_kinds, kind)
    }
}

Function.Analyzer.NotePartialAlloc {
    Input: name: Address
    Input: if_line: Integer
    Body: {
        seen = Analyzer.ListHas(Analyzer.func_partial_allocs, name)
        IfCondition EqualTo(seen, 0) ThenBlock: {
            Array.Push(Analyzer.func_partial_allocs, name)
            Analyzer.WarnMem("MEM-PATH", if_line, name, "allocated on some paths only")
            Analyzer.path_warnings = Add(Analyzer.path_warnings, 1)
        }
    }
}

Function.Analyzer.NoteFree {
    Input: var_name: Address
    Input: call_name: Address
    Input: line: Integer
    Body: {
        root = Analyzer.RootOf(var_name)
        is_arena = Analyzer.ListHas(Analyzer.func_arena_vars, var_name)
        IfCondition EqualTo(is_arena, 0) ThenBlock: {
            is_arena = Analyzer.ListHas(Analyzer.func_arena_vars, root)
        }
        IfCondition EqualTo(is_arena, 1) ThenBlock: {
            Analyzer.WarnMem("MEM-ARENA", line, var_name, "arena temporary passed to a free")
            Analyzer.arena_warnings = Add(Analyzer.arena_warnings, 1)
            ReturnValue(0)
        }
        last_k = Analyzer.LastKind(root)
        free_k = Analyzer.FreeKind(call_name)
        IfCondition NotEqual(last_k, 0) ThenBlock: {
            IfCondition NotEqual(free_k, 0) ThenBlock: {
                IfCondition NotEqual(last_k, free_k) ThenBlock: {
                    Analyzer.WarnMem("MEM-KIND", line, var_name, "free does not match the allocation kind")
                    Analyzer.kind_warnings = Add(Analyzer.kind_warnings, 1)
                    ReturnValue(0)
                }
            }
        }
        owned = Analyzer.ListHas(Analyzer.func_alloc_vars, root)
        IfCondition EqualTo(owned, 1) ThenBlock: { ReturnValue(0) }
        is_param = Analyzer.ListHas(Analyzer.func_params, root)
        IfCondition EqualTo(is_param, 0) ThenBlock: {
            is_param = Analyzer.ListHas(Analyzer.func_params, var_name)
        }
        IfCondition EqualTo(is_param, 1) ThenBlock: { ReturnValue(0) }
        is_pool = Analyzer.IsPoolMember(var_name)
        IfCondition EqualTo(is_pool, 1) ThenBlock: { ReturnValue(0) }
        partial = Analyzer.ListHas(Analyzer.func_partial_allocs, var_name)
        IfCondition EqualTo(partial, 1) ThenBlock: {
            Analyzer.WarnMem("MEM-FREE", line, var_name, "freed where that block is only allocated on some paths")
            Analyzer.free_warnings = Add(Analyzer.free_warnings, 1)
            ReturnValue(0)
        }
        Analyzer.WarnMem("MEM-FREE", line, var_name, "freed but this function did not allocate it")
        Analyzer.free_warnings = Add(Analyzer.free_warnings, 1)
    }
}

Function.Analyzer.JoinAlloc {
    Input: has_else: Integer
    Input: if_line: Integer
    Body: {
        then_names = Analyzer.snap_then_names
        then_lines = Analyzer.snap_then_lines
        then_sizes = Analyzer.snap_then_sizes
        then_kinds = Analyzer.snap_then_kinds
        else_names = Analyzer.snap_else_names
        else_sizes = Analyzer.snap_else_sizes
        else_kinds = Analyzer.snap_else_kinds
        then_frees = Analyzer.snap_then_frees
        else_frees = Analyzer.snap_else_frees
        tcount = Array.Size(then_names)
        ti = 0
        WhileLoop LessThan(ti, tcount) {
            name = Array.Get(then_names, ti)
            in_else = 0
            IfCondition EqualTo(has_else, 1) ThenBlock: {
                in_else = Analyzer.ListHas(else_names, name)
            }
            IfCondition EqualTo(in_else, 1) ThenBlock: {
                line = Array.Get(then_lines, ti)
                size_text = Array.Get(then_sizes, ti)
                kind = Array.Get(then_kinds, ti)
                Analyzer.PushAllocRecord(name, line, size_text, kind)
                else_i = Analyzer.IndexOf(else_names, name)
                IfCondition GreaterEqual(else_i, 0) ThenBlock: {
                    else_sz = Array.Get(else_sizes, else_i)
                    IfCondition NotEqual(size_text, 0) ThenBlock: {
                        IfCondition NotEqual(else_sz, 0) ThenBlock: {
                            sz_cmp = StringCompare(size_text, else_sz)
                            IfCondition NotEqual(sz_cmp, 0) ThenBlock: {
                                Analyzer.WarnMem("MEM-SIZE", if_line, name, "allocation size differs between paths")
                                Analyzer.size_warnings = Add(Analyzer.size_warnings, 1)
                            }
                        }
                    }
                    else_k = Array.Get(else_kinds, else_i)
                    IfCondition NotEqual(kind, 0) ThenBlock: {
                        IfCondition NotEqual(else_k, 0) ThenBlock: {
                            IfCondition NotEqual(kind, else_k) ThenBlock: {
                                Analyzer.WarnMem("MEM-KIND", if_line, name, "allocation kind differs between paths")
                                Analyzer.kind_warnings = Add(Analyzer.kind_warnings, 1)
                            }
                        }
                    }
                }
            }
            IfCondition EqualTo(in_else, 0) ThenBlock: {
                freed_here = Analyzer.ListHas(then_frees, name)
                IfCondition EqualTo(freed_here, 0) ThenBlock: {
                    stays = Analyzer.PartialAllocStays(name, Analyzer.snap_then_block)
                    IfCondition EqualTo(stays, 1) ThenBlock: {
                        Analyzer.NotePartialAlloc(name, if_line)
                    }
                }
            }
            ti = Add(ti, 1)
        }
        IfCondition EqualTo(has_else, 1) ThenBlock: {
            ecount = Array.Size(else_names)
            ei = 0
            WhileLoop LessThan(ei, ecount) {
                ename = Array.Get(else_names, ei)
                in_then = Analyzer.ListHas(then_names, ename)
                IfCondition EqualTo(in_then, 0) ThenBlock: {
                    freed_here = Analyzer.ListHas(else_frees, ename)
                    IfCondition EqualTo(freed_here, 0) ThenBlock: {
                        stays = Analyzer.PartialAllocStays(ename, Analyzer.snap_else_block)
                        IfCondition EqualTo(stays, 1) ThenBlock: {
                            Analyzer.NotePartialAlloc(ename, if_line)
                        }
                    }
                }
                ei = Add(ei, 1)
            }
        }
    }
}

Function.Analyzer.JoinBranch {
    Input: then_names: Address
    Input: else_names: Address
    Input: has_else: Integer
    Input: if_line: Integer
    Body: {
        tcount = Array.Size(then_names)
        ti = 0
        WhileLoop LessThan(ti, tcount) {
            name = Array.Get(then_names, ti)
            in_else = 0
            IfCondition EqualTo(has_else, 1) ThenBlock: {
                in_else = Analyzer.ListHas(else_names, name)
            }
            IfCondition EqualTo(in_else, 1) ThenBlock: {
                Analyzer.NoteSureFree(name)
            }
            IfCondition EqualTo(in_else, 0) ThenBlock: {
                guarded = Analyzer.NullGuardFree(name, 1)
                IfCondition EqualTo(guarded, 1) ThenBlock: {
                    Analyzer.NoteSureFree(name)
                }
                IfCondition EqualTo(guarded, 0) ThenBlock: {
                    covered = Analyzer.ListHas(Analyzer.snap_then_names, name)
                    arm_done = Analyzer.snap_then_exits
                    IfCondition EqualTo(covered, 0) ThenBlock: {
                        IfCondition EqualTo(arm_done, 0) ThenBlock: {
                            seen = Analyzer.ListHas(Analyzer.func_partial_vars, name)
                            IfCondition EqualTo(seen, 0) ThenBlock: {
                                Array.Push(Analyzer.func_partial_vars, name)
                                Analyzer.WarnMem("MEM-PATH", if_line, name, "freed on some paths only")
                                Analyzer.path_warnings = Add(Analyzer.path_warnings, 1)
                            }
                        }
                    }
                }
            }
            ti = Add(ti, 1)
        }
        IfCondition EqualTo(has_else, 1) ThenBlock: {
            ecount = Array.Size(else_names)
            ei = 0
            WhileLoop LessThan(ei, ecount) {
                ename = Array.Get(else_names, ei)
                in_then = Analyzer.ListHas(then_names, ename)
                IfCondition EqualTo(in_then, 0) ThenBlock: {
                    guarded = Analyzer.NullGuardFree(ename, 0)
                    IfCondition EqualTo(guarded, 1) ThenBlock: {
                        Analyzer.NoteSureFree(ename)
                    }
                    IfCondition EqualTo(guarded, 0) ThenBlock: {
                        covered = Analyzer.ListHas(Analyzer.snap_else_names, ename)
                        arm_done = Analyzer.snap_else_exits
                        IfCondition EqualTo(covered, 0) ThenBlock: {
                            IfCondition EqualTo(arm_done, 0) ThenBlock: {
                                seen = Analyzer.ListHas(Analyzer.func_partial_vars, ename)
                                IfCondition EqualTo(seen, 0) ThenBlock: {
                                    Array.Push(Analyzer.func_partial_vars, ename)
                                    Analyzer.WarnMem("MEM-PATH", if_line, ename, "freed on some paths only")
                                    Analyzer.path_warnings = Add(Analyzer.path_warnings, 1)
                                }
                            }
                        }
                    }
                }
                ei = Add(ei, 1)
            }
        }
    }
}

Function.Analyzer.OwnKey {
    Input: name: Address
    Input: index: Integer
    Output: Address
    Body: {
        key = StringConcat(name, "#")
        idx_text = NumberToString(index)
        key = StringConcat(key, idx_text)
        ReturnValue(key)
    }
}

Function.Analyzer.FreesParam {
    Input: func_name: Address
    Input: index: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(Analyzer.free_keys, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(func_name, 0) ThenBlock: { ReturnValue(0) }
        key = Analyzer.OwnKey(func_name, index)
        found = Analyzer.ListHas(Analyzer.free_keys, key)
        ReturnValue(found)
    }
}

Function.Analyzer.ReturnsAlloc {
    Input: func_name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(Analyzer.ret_alloc_funcs, 0) ThenBlock: { ReturnValue(0) }
        found = Analyzer.ListHas(Analyzer.ret_alloc_funcs, func_name)
        ReturnValue(found)
    }
}

Function.Analyzer.CommitOwnership {
    Input: func_name: Address
    Body: {
        IfCondition EqualTo(func_name, 0) ThenBlock: { ReturnValue(0) }
        pcount = Array.Size(Analyzer.col_params)
        pi = 0
        WhileLoop LessThan(pi, pcount) {
            pname = Array.Get(Analyzer.col_params, pi)
            freed = Analyzer.ListHas(Analyzer.col_dealloc, pname)
            IfCondition EqualTo(freed, 1) ThenBlock: {
                key = Analyzer.OwnKey(func_name, pi)
                Array.Push(Analyzer.free_keys, key)
            }
            pi = Add(pi, 1)
        }
        IfCondition EqualTo(Analyzer.col_returns_alloc, 1) ThenBlock: {
            Array.Push(Analyzer.ret_alloc_funcs, func_name)
        }
    }
}

Function.Analyzer.JoinCollect {
    Input: then_names: Address
    Input: else_names: Address
    Input: has_else: Integer
    Body: {
        IfCondition EqualTo(has_else, 0) ThenBlock: { ReturnValue(0) }
        tcount = Array.Size(then_names)
        ti = 0
        WhileLoop LessThan(ti, tcount) {
            name = Array.Get(then_names, ti)
            in_else = Analyzer.ListHas(else_names, name)
            IfCondition EqualTo(in_else, 1) ThenBlock: {
                already = Analyzer.ListHas(Analyzer.col_dealloc, name)
                IfCondition EqualTo(already, 0) ThenBlock: {
                    Array.Push(Analyzer.col_dealloc, name)
                }
            }
            ti = Add(ti, 1)
        }
    }
}

Function.Analyzer.CollectChildren {
    Input: node: Address
    Body: {
        child_count = AST_GetChildCount(node)
        i = 0
        WhileLoop LessThan(i, child_count) {
            child = AST_GetChild(node, i)
            Analyzer.CollectNode(child)
            i = Add(i, 1)
        }
    }
}

Function.Analyzer.CollectIf {
    Input: node: Address
    Body: {
        child_count = AST_GetChildCount(node)
        IfCondition GreaterThan(child_count, 0) ThenBlock: {
            cond = AST_GetChild(node, 0)
            Analyzer.CollectNode(cond)
        }
        start = Array.Size(Analyzer.col_dealloc)
        IfCondition GreaterThan(child_count, 1) ThenBlock: {
            then_block = AST_GetChild(node, 1)
            Analyzer.CollectNode(then_block)
        }
        then_names = Analyzer.TakeNames(Analyzer.col_dealloc, start)
        has_else = 0
        IfCondition GreaterThan(child_count, 2) ThenBlock: {
            has_else = 1
            else_block = AST_GetChild(node, 2)
            Analyzer.CollectNode(else_block)
        }
        else_names = Analyzer.TakeNames(Analyzer.col_dealloc, start)
        Analyzer.JoinCollect(then_names, else_names, has_else)
        Array.Destroy(then_names)
        Array.Destroy(else_names)
    }
}

Function.Analyzer.CollectNode {
    Input: node: Address
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        node_type = AST_GetType(node)

        IfCondition EqualTo(node_type, AST.FUNCTION) ThenBlock: {
            Array.Clear(Analyzer.col_params)
            Array.Clear(Analyzer.col_allocs)
            Array.Clear(Analyzer.col_dealloc)
            Analyzer.col_returns_alloc = 0
            fname = AST_GetData1(node)
            Analyzer.CollectChildren(node)
            Analyzer.CommitOwnership(fname)
            ReturnValue(0)
        }
        IfCondition EqualTo(node_type, AST.SUBROUTINE) ThenBlock: {
            Array.Clear(Analyzer.col_params)
            Array.Clear(Analyzer.col_allocs)
            Array.Clear(Analyzer.col_dealloc)
            Analyzer.col_returns_alloc = 0
            fname = AST_GetData1(node)
            Analyzer.CollectChildren(node)
            Analyzer.CommitOwnership(fname)
            ReturnValue(0)
        }
        IfCondition EqualTo(node_type, AST.PARAMETER) ThenBlock: {
            pname = AST_GetData1(node)
            IfCondition NotEqual(pname, 0) ThenBlock: {
                Array.Push(Analyzer.col_params, pname)
            }
            ReturnValue(0)
        }
        is_branch = 0
        IfCondition EqualTo(node_type, AST.IF) ThenBlock: { is_branch = 1 }
        IfCondition EqualTo(node_type, AST.FORK) ThenBlock: { is_branch = 1 }
        IfCondition EqualTo(is_branch, 1) ThenBlock: {
            Analyzer.CollectIf(node)
            ReturnValue(0)
        }
        IfCondition EqualTo(node_type, AST.ASSIGNMENT) ThenBlock: {
            target = AST_GetData1(node)
            child_count = AST_GetChildCount(node)
            IfCondition GreaterThan(child_count, 0) ThenBlock: {
                value = AST_GetChild(node, 0)
                IfCondition NotEqual(value, 0) ThenBlock: {
                    value_type = AST_GetType(value)
                    IfCondition EqualTo(value_type, AST.CALL) ThenBlock: {
                        call_name = AST_GetData1(value)
                        is_alloc = Analyzer.IsAllocName(call_name)
                        IfCondition EqualTo(is_alloc, 1) ThenBlock: {
                            Array.Push(Analyzer.col_allocs, target)
                        }
                    }
                }
            }
            Analyzer.CollectChildren(node)
            ReturnValue(0)
        }
        IfCondition EqualTo(node_type, AST.RETURN) ThenBlock: {
            child_count = AST_GetChildCount(node)
            IfCondition GreaterThan(child_count, 0) ThenBlock: {
                ret_expr = AST_GetChild(node, 0)
                IfCondition NotEqual(ret_expr, 0) ThenBlock: {
                    ret_type = AST_GetType(ret_expr)
                    IfCondition EqualTo(ret_type, AST.IDENTIFIER) ThenBlock: {
                        ret_var = AST_GetData1(ret_expr)
                        holds = Analyzer.ListHas(Analyzer.col_allocs, ret_var)
                        IfCondition EqualTo(holds, 1) ThenBlock: {
                            Analyzer.col_returns_alloc = 1
                        }
                    }
                }
            }
            Analyzer.CollectChildren(node)
            ReturnValue(0)
        }
        IfCondition EqualTo(node_type, AST.CALL) ThenBlock: {
            call_name = AST_GetData1(node)
            is_free = Analyzer.IsFreeName(call_name)
            IfCondition EqualTo(is_free, 1) ThenBlock: {
                child_count = AST_GetChildCount(node)
                IfCondition GreaterThan(child_count, 0) ThenBlock: {
                    arg = AST_GetChild(node, 0)
                    IfCondition NotEqual(arg, 0) ThenBlock: {
                        arg_type = AST_GetType(arg)
                        IfCondition EqualTo(arg_type, AST.IDENTIFIER) ThenBlock: {
                            aname = AST_GetData1(arg)
                            Array.Push(Analyzer.col_dealloc, aname)
                        }
                    }
                }
            }
            Analyzer.CollectChildren(node)
            ReturnValue(0)
        }
        Analyzer.CollectChildren(node)
    }
}

Function.Analyzer.CollectOwnership {
    Input: node: Address
    Body: {
        IfCondition NotEqual(Analyzer.free_keys, 0) ThenBlock: {
            Array.Clear(Analyzer.free_keys)
        }
        IfCondition NotEqual(Analyzer.ret_alloc_funcs, 0) ThenBlock: {
            Array.Clear(Analyzer.ret_alloc_funcs)
        }
        Analyzer.CollectNode(node)
    }
}

// =============================================================================
// AST WALKER
// =============================================================================
Function.Analyzer.WalkNode {
    Input: node: Address
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: {
            ReturnValue(0)
        }
        // First entry collects ownership, then the same walk emits warnings.
        IfCondition EqualTo(Analyzer.walking, 0) ThenBlock: {
            Analyzer.walking = 1
            Analyzer.CollectOwnership(node)
            Analyzer.WalkNode(node)
            Analyzer.walking = 0
            ReturnValue(0)
        }
        
        node_type = AST_GetType(node)
        node_line = AST_GetLine(node)
        IfCondition GreaterThan(node_line, 0) ThenBlock: {
            Analyzer.last_valid_line = node_line
        } ElseBlock: {
            node_line = Analyzer.last_valid_line
        }
        
        // === FUNCTION ENTRY ===
        IfCondition EqualTo(node_type, AST.FUNCTION) ThenBlock: {
            func_name = AST_GetData1(node)
            Analyzer.EnterFunction(func_name, node_line, 0)
            
            // Check for Output declaration and parameter count
            Analyzer.ScanFunctionHeader(node)
            
            // Walk children
            Analyzer.WalkChildren(node)
            
            // Exit function - run all checks
            Analyzer.ExitFunction()
            ReturnValue(0)
        }
        
        // === SUBROUTINE ===
        IfCondition EqualTo(node_type, AST.SUBROUTINE) ThenBlock: {
            func_name = AST_GetData1(node)
            Analyzer.EnterFunction(func_name, node_line, 1)
            Analyzer.WalkChildren(node)
            Analyzer.ExitFunction()
            ReturnValue(0)
        }
        
        // === OUTPUT DECLARATION ===
        IfCondition EqualTo(node_type, AST.OUTPUT_DECL) ThenBlock: {
            Analyzer.func_has_output = 1
            ReturnValue(0)
        }
        
        // === RETURN VALUE ===
        IfCondition EqualTo(node_type, AST.RETURN) ThenBlock: {
            Analyzer.func_has_return = 1
            
            // Track what variable is returned (for memory analysis)
            child_count = AST_GetChildCount(node)
            IfCondition GreaterThan(child_count, 0) ThenBlock: {
                ret_expr = AST_GetChild(node, 0)
                IfCondition NotEqual(ret_expr, 0) ThenBlock: {
                    ret_type = AST_GetType(ret_expr)
                    IfCondition EqualTo(ret_type, AST.IDENTIFIER) ThenBlock: {
                        ret_var = AST_GetData1(ret_expr)
                        Analyzer.RecordReturnedVar(ret_var)
                        ret_root = Analyzer.RootOf(ret_var)
                        same_root = Analyzer.StrEqual(ret_root, ret_var)
                        IfCondition EqualTo(same_root, 0) ThenBlock: {
                            Analyzer.RecordReturnedVar(ret_root)
                        }
                        Analyzer.RecordUsage(ret_var)
                    } ElseBlock: {
                        // Walk the return expression to track any var usage
                        Analyzer.WalkNode(ret_expr)
                    }
                }
            }
            ReturnValue(0)
        }
        
        // === BLOCK NESTING ===
        IfCondition EqualTo(node_type, AST.BODY) ThenBlock: {
            Analyzer.block_depth = Add(Analyzer.block_depth, 1)
            IfCondition GreaterThan(Analyzer.block_depth, Analyzer.max_block_depth) ThenBlock: {
                Analyzer.max_block_depth = Analyzer.block_depth
                Analyzer.max_depth_func = Analyzer.current_func
                Analyzer.max_depth_line = node_line
            }
            Analyzer.WalkChildren(node)
            Analyzer.block_depth = Subtract(Analyzer.block_depth, 1)
            ReturnValue(0)
        }
        
        IfCondition EqualTo(node_type, AST.BLOCK) ThenBlock: {
            Analyzer.block_depth = Add(Analyzer.block_depth, 1)
            IfCondition GreaterThan(Analyzer.block_depth, Analyzer.max_block_depth) ThenBlock: {
                Analyzer.max_block_depth = Analyzer.block_depth
                Analyzer.max_depth_func = Analyzer.current_func
                Analyzer.max_depth_line = node_line
            }
            Analyzer.WalkChildren(node)
            Analyzer.block_depth = Subtract(Analyzer.block_depth, 1)
            ReturnValue(0)
        }

        // === IF and FORK: a free counts only when both arms free it ===
        is_branch = 0
        IfCondition EqualTo(node_type, AST.IF) ThenBlock: { is_branch = 1 }
        IfCondition EqualTo(node_type, AST.FORK) ThenBlock: { is_branch = 1 }
        IfCondition EqualTo(is_branch, 1) ThenBlock: {
            child_count = AST_GetChildCount(node)
            cond = 0
            IfCondition GreaterThan(child_count, 0) ThenBlock: {
                cond = AST_GetChild(node, 0)
                Analyzer.WalkNode(cond)
            }
            start = Array.Size(Analyzer.func_dealloc_vars)
            start_alloc = Array.Size(Analyzer.func_alloc_vars)
            then_block = 0
            else_block = 0
            IfCondition GreaterThan(child_count, 1) ThenBlock: {
                then_block = AST_GetChild(node, 1)
                Analyzer.WalkNode(then_block)
            }
            then_names = Analyzer.TakeNames(Analyzer.func_dealloc_vars, start)
            Analyzer.PopTo(Analyzer.func_dealloc_lines, start)
            Analyzer.PopTo(Analyzer.func_dealloc_marks, start)
            then_allocs = Analyzer.TakeNames(Analyzer.func_alloc_vars, start_alloc)
            then_alines = Analyzer.TakeNames(Analyzer.func_alloc_lines, start_alloc)
            then_asizes = Analyzer.TakeNames(Analyzer.func_alloc_sizes, start_alloc)
            then_akinds = Analyzer.TakeNames(Analyzer.func_alloc_kinds, start_alloc)
            has_else = 0
            IfCondition GreaterThan(child_count, 2) ThenBlock: {
                has_else = 1
                else_block = AST_GetChild(node, 2)
                Analyzer.WalkNode(else_block)
            }
            else_names = Analyzer.TakeNames(Analyzer.func_dealloc_vars, start)
            Analyzer.PopTo(Analyzer.func_dealloc_lines, start)
            Analyzer.PopTo(Analyzer.func_dealloc_marks, start)
            else_allocs = Analyzer.TakeNames(Analyzer.func_alloc_vars, start_alloc)
            else_alines = Analyzer.TakeNames(Analyzer.func_alloc_lines, start_alloc)
            else_asizes = Analyzer.TakeNames(Analyzer.func_alloc_sizes, start_alloc)
            else_akinds = Analyzer.TakeNames(Analyzer.func_alloc_kinds, start_alloc)
            Analyzer.snap_then_names = then_allocs
            Analyzer.snap_then_lines = then_alines
            Analyzer.snap_then_sizes = then_asizes
            Analyzer.snap_then_kinds = then_akinds
            Analyzer.snap_else_names = else_allocs
            Analyzer.snap_else_sizes = else_asizes
            Analyzer.snap_else_kinds = else_akinds
            Analyzer.snap_then_frees = then_names
            Analyzer.snap_else_frees = else_names
            Analyzer.snap_cond = cond
            Analyzer.snap_then_block = then_block
            Analyzer.snap_else_block = else_block
            Analyzer.snap_then_exits = Analyzer.ArmExits(then_block)
            Analyzer.snap_else_exits = Analyzer.ArmExits(else_block)
            Analyzer.JoinAlloc(has_else, node_line)
            Analyzer.JoinBranch(then_names, else_names, has_else, node_line)
            Array.Destroy(then_names)
            Array.Destroy(else_names)
            Array.Destroy(then_allocs)
            Array.Destroy(then_alines)
            Array.Destroy(then_asizes)
            Array.Destroy(then_akinds)
            Array.Destroy(else_allocs)
            Array.Destroy(else_alines)
            Array.Destroy(else_asizes)
            Array.Destroy(else_akinds)
            ReturnValue(0)
        }
        
        // === ASSIGNMENT - check for Allocate, track variable ===
        IfCondition EqualTo(node_type, AST.ASSIGNMENT) ThenBlock: {
            target = AST_GetData1(node)
            Analyzer.RecordAssignment(target)
            
            child_count = AST_GetChildCount(node)
            IfCondition GreaterThan(child_count, 0) ThenBlock: {
                value = AST_GetChild(node, 0)
                IfCondition NotEqual(value, 0) ThenBlock: {
                    value_type = AST_GetType(value)

                    // Overwrite of a block this function still holds.
                    live = Analyzer.IsLiveAlloc(target)
                    IfCondition EqualTo(live, 1) ThenBlock: {
                        Analyzer.WarnMem("MEM-DROP", node_line, target, "previous allocation overwritten without a free")
                        Analyzer.drop_warnings = Add(Analyzer.drop_warnings, 1)
                    }
                    
                    // A direct allocating call is stored in target.
                    // Nested allocating calls inside the value are not.
                    // A direct arena temp is stored too, so it is not MEM-ARENA.
                    direct_alloc = 0
                    IfCondition EqualTo(value_type, AST.CALL) ThenBlock: {
                        call_name = AST_GetData1(value)
                        is_alloc = Analyzer.IsAllocName(call_name)
                        IfCondition EqualTo(is_alloc, 1) ThenBlock: {
                            size_text = 0
                            is_byte = Analyzer.IsByteAlloc(call_name)
                            IfCondition EqualTo(is_byte, 1) ThenBlock: {
                                size_text = Analyzer.LiteralText(value, 0)
                            }
                            kind = Analyzer.AllocKind(call_name)
                            Analyzer.RecordAlloc(target, node_line, size_text, kind)
                            direct_alloc = 1
                        }
                        IfCondition EqualTo(is_alloc, 0) ThenBlock: {
                            returns_new = Analyzer.ReturnsAlloc(call_name)
                            IfCondition EqualTo(returns_new, 1) ThenBlock: {
                                Analyzer.RecordAlloc(target, node_line, 0, 0)
                                direct_alloc = 1
                            }
                            IfCondition EqualTo(returns_new, 0) ThenBlock: {
                                is_temp = Analyzer.IsArenaTemp(call_name)
                                IfCondition EqualTo(is_temp, 1) ThenBlock: {
                                    direct_alloc = 1
                                    seen_temp = Analyzer.ListHas(Analyzer.func_arena_vars, target)
                                    IfCondition EqualTo(seen_temp, 0) ThenBlock: {
                                        Array.Push(Analyzer.func_arena_vars, target)
                                    }
                                }
                            }
                        }
                    }
                    
                    Analyzer.skip_discard = direct_alloc
                    Analyzer.WalkNode(value)
                    Analyzer.skip_discard = 0
                    Analyzer.NoteAssignValue(target, value, direct_alloc)
                }
            }
            ReturnValue(0)
        }
        
        // === IDENTIFIER - track variable usage ===
        IfCondition EqualTo(node_type, AST.IDENTIFIER) ThenBlock: {
            var_name = AST_GetData1(node)
            Analyzer.RecordUsage(var_name)
            ReturnValue(0)
        }
        
        // === FUNCTION CALL ===
        IfCondition EqualTo(node_type, AST.CALL) ThenBlock: {
            call_name = AST_GetData1(node)
            
            IfCondition NotEqual(call_name, 0) ThenBlock: {
                // Record as called
                Analyzer.RecordCalledFunc(call_name)

                // Allocate() whose result is not the direct assignment target.
                is_alloc_call = Analyzer.IsAllocName(call_name)
                IfCondition EqualTo(is_alloc_call, 1) ThenBlock: {
                    IfCondition EqualTo(Analyzer.skip_discard, 0) ThenBlock: {
                        Analyzer.WarnMem("MEM-DISCARD", node_line, call_name, "result is not stored")
                        Analyzer.discard_warnings = Add(Analyzer.discard_warnings, 1)
                    }
                }

                // A bare arena temp. Stored results and call arguments stay quiet.
                is_temp = Analyzer.IsArenaTemp(call_name)
                IfCondition EqualTo(is_temp, 1) ThenBlock: {
                    IfCondition EqualTo(Analyzer.skip_discard, 0) ThenBlock: {
                        IfCondition EqualTo(Analyzer.inside_args, 0) ThenBlock: {
                            Analyzer.WarnMem("MEM-ARENA", node_line, call_name, "arena temporary is not stored or passed on")
                            Analyzer.arena_warnings = Add(Analyzer.arena_warnings, 1)
                        }
                    }
                }
                
                // Check for a free of a named pointer
                is_dealloc = Analyzer.IsFreeName(call_name)
                IfCondition EqualTo(is_dealloc, 1) ThenBlock: {
                    child_count = AST_GetChildCount(node)
                    IfCondition GreaterThan(child_count, 0) ThenBlock: {
                        arg = AST_GetChild(node, 0)
                        IfCondition NotEqual(arg, 0) ThenBlock: {
                            arg_type = AST_GetType(arg)
                            IfCondition EqualTo(arg_type, AST.IDENTIFIER) ThenBlock: {
                                var_name = AST_GetData1(arg)
                                is_byte_free = Analyzer.IsByteFree(call_name)
                                IfCondition EqualTo(is_byte_free, 1) ThenBlock: {
                                    free_text = Analyzer.LiteralText(node, 1)
                                    IfCondition NotEqual(free_text, 0) ThenBlock: {
                                        last_sz = Analyzer.LastSize(var_name)
                                        IfCondition NotEqual(last_sz, 0) ThenBlock: {
                                            sz_cmp = StringCompare(free_text, last_sz)
                                            IfCondition NotEqual(sz_cmp, 0) ThenBlock: {
                                                Analyzer.WarnMem("MEM-SIZE", node_line, var_name, "free size does not match the allocation")
                                                Analyzer.size_warnings = Add(Analyzer.size_warnings, 1)
                                            }
                                        }
                                    }
                                }
                                root_name = Analyzer.RootOf(var_name)
                                Analyzer.NoteFree(var_name, call_name, node_line)
                                Analyzer.RecordDealloc(root_name, node_line)
                                Analyzer.RecordUsage(var_name)
                            }
                        }
                    }
                }

                // Callee frees this argument on every path.
                child_count = AST_GetChildCount(node)
                ai = 0
                WhileLoop LessThan(ai, child_count) {
                    own_arg = AST_GetChild(node, ai)
                    IfCondition NotEqual(own_arg, 0) ThenBlock: {
                        own_type = AST_GetType(own_arg)
                        IfCondition EqualTo(own_type, AST.IDENTIFIER) ThenBlock: {
                            own_name = AST_GetData1(own_arg)
                            takes = Analyzer.FreesParam(call_name, ai)
                            IfCondition EqualTo(takes, 1) ThenBlock: {
                                own_root = Analyzer.RootOf(own_name)
                                Analyzer.RecordDealloc(own_root, node_line)
                                Analyzer.RecordUsage(own_name)
                            }
                        }
                    }
                    ai = Add(ai, 1)
                }
            }
            
            // Arguments are not bare statements.
            saved_inside = Analyzer.inside_args
            Analyzer.inside_args = 1
            Analyzer.WalkChildren(node)
            Analyzer.inside_args = saved_inside
            ReturnValue(0)
        }
        
        // Names written in a loop are not constants after one trip.
        is_loop = 0
        IfCondition EqualTo(node_type, AST.WHILE) ThenBlock: { is_loop = 1 }
        IfCondition EqualTo(node_type, AST.UNTIL) ThenBlock: { is_loop = 1 }
        IfCondition EqualTo(node_type, AST.FOR_EVERY) ThenBlock: { is_loop = 1 }
        IfCondition EqualTo(node_type, AST.LOOP_MAIN) ThenBlock: { is_loop = 1 }
        IfCondition EqualTo(is_loop, 1) ThenBlock: {
            Analyzer.func_loop_depth = Add(Analyzer.func_loop_depth, 1)
            Analyzer.CollectLoopWrites(node)
            Analyzer.WalkChildren(node)
            Analyzer.func_loop_depth = Subtract(Analyzer.func_loop_depth, 1)
            ReturnValue(0)
        }

        // === DEFAULT: recurse ===
        Analyzer.WalkChildren(node)
    }
}

Function.Analyzer.ScanFunctionHeader {
    Input: func_node: Address
    Body: {
        child_count = AST_GetChildCount(func_node)
        param_count = 0
        
        i = 0
        WhileLoop LessThan(i, child_count) {
            child = AST_GetChild(func_node, i)
            IfCondition NotEqual(child, 0) ThenBlock: {
                child_type = AST_GetType(child)
                
                // Count parameters
                IfCondition EqualTo(child_type, AST.PARAMETER) ThenBlock: {
                    param_count = Add(param_count, 1)
                    // Record parameter as assigned (it has a value from caller)
                    param_name = AST_GetData1(child)
                    Analyzer.RecordAssignment(param_name)
                    Array.Push(Analyzer.func_params, param_name)
                }
                
                // Check for output declaration
                IfCondition EqualTo(child_type, AST.OUTPUT_DECL) ThenBlock: {
                    Analyzer.func_has_output = 1
                }
            }
            i = Add(i, 1)
        }
        
        // Arity is Analyzer2 / Sem_Analyze. Pass 1 does not warn on it.
    }
}

Function.Analyzer.WalkChildren {
    Input: node: Address
    Body: {
        child_count = AST_GetChildCount(node)
        i = 0
        WhileLoop LessThan(i, child_count) {
            child = AST_GetChild(node, i)
            Analyzer.WalkNode(child)
            i = Add(i, 1)
        }
    }
}

// =============================================================================
// POST-ANALYSIS CHECKS
// =============================================================================
Function.Analyzer.PostAnalysis {
    Body: {
        // Check for undefined functions (called but not defined)
        called_count = Array.Size(Analyzer.called_funcs)
        i = 0
        WhileLoop LessThan(i, called_count) {
            called = Array.Get(Analyzer.called_funcs, i)
            is_defined = Analyzer.IsFuncDefined(called)
            IfCondition EqualTo(is_defined, 0) ThenBlock: {
                // Check if it's a builtin
                is_builtin = Analyzer.IsBuiltinFunc(called)
                IfCondition EqualTo(is_builtin, 0) ThenBlock: {
                    msg = StringConcat("Function '", "")
                    IfCondition NotEqual(called, 0) ThenBlock: {
                        msg = StringConcat(msg, called)
                    }
                    msg = StringConcat(msg, "' called but not defined")
                    Analyzer.AddWarning(msg)
                }
            }
            i = Add(i, 1)
        }
        
        // Check for unused functions (defined but never called)
        // Skip entry points like Main, Init, Run*, Test*
        defined_count = Array.Size(Analyzer.defined_funcs)
        i = 0
        WhileLoop LessThan(i, defined_count) {
            defined = Array.Get(Analyzer.defined_funcs, i)
            is_called = Analyzer.IsFuncCalled(defined)
            IfCondition EqualTo(is_called, 0) ThenBlock: {
                is_entry = Analyzer.IsEntryPoint(defined)
                IfCondition EqualTo(is_entry, 0) ThenBlock: {
                    msg = StringConcat("Function '", "")
                    IfCondition NotEqual(defined, 0) ThenBlock: {
                        msg = StringConcat(msg, defined)
                    }
                    msg = StringConcat(msg, "' defined but never called")
                    Analyzer.AddWarning(msg)
                }
            }
            i = Add(i, 1)
        }

        Analyzer.CheckNestingDepth()
    }
}

Function.Analyzer.CheckNestingDepth {
    Body: {
        IfCondition GreaterThan(Analyzer.max_block_depth, Analyzer.max_nesting) ThenBlock: {
            depth_str = NumberToString(Analyzer.max_block_depth)
            limit_str = NumberToString(Analyzer.max_nesting)
            msg = StringConcat("Max nesting depth ", depth_str)
            msg = StringConcat(msg, " exceeds limit of ")
            msg = StringConcat(msg, limit_str)
            IfCondition NotEqual(Analyzer.max_depth_func, 0) ThenBlock: {
                msg = StringConcat(msg, " in '")
                msg = StringConcat(msg, Analyzer.max_depth_func)
                msg = StringConcat(msg, "'")
            }
            Analyzer.AddWarning(msg)
        }
    }
}

Function.Analyzer.IsFuncDefined {
    Input: name: Address
    Output: Integer
    Body: {
        count = Array.Size(Analyzer.defined_funcs)
        i = 0
        WhileLoop LessThan(i, count) {
            defined = Array.Get(Analyzer.defined_funcs, i)
            IfCondition EqualTo(Analyzer.StrEqual(name, defined), 1) ThenBlock: {
                ReturnValue(1)
            }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

Function.Analyzer.IsFuncCalled {
    Input: name: Address
    Output: Integer
    Body: {
        count = Array.Size(Analyzer.called_funcs)
        i = 0
        WhileLoop LessThan(i, count) {
            called = Array.Get(Analyzer.called_funcs, i)
            IfCondition EqualTo(Analyzer.StrEqual(name, called), 1) ThenBlock: {
                ReturnValue(1)
            }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

Function.Analyzer.IsEntryPoint {
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(name, 0) ThenBlock: {
            ReturnValue(0)
        }
        
        len = StringLength(name)
        IfCondition LessThan(len, 3) ThenBlock: {
            ReturnValue(0)
        }
        
        // Check common prefixes
        c0 = GetByte(name, 0)
        c1 = GetByte(name, 1)
        c2 = GetByte(name, 2)
        
        // "Run" = 82,117,110
        IfCondition And(EqualTo(c0, 82), And(EqualTo(c1, 117), EqualTo(c2, 110))) ThenBlock: {
            ReturnValue(1)
        }
        
        IfCondition GreaterEqual(len, 4) ThenBlock: {
            c3 = GetByte(name, 3)
            // "Main" = 77,97,105,110
            IfCondition And(EqualTo(c0, 77), And(EqualTo(c1, 97), And(EqualTo(c2, 105), EqualTo(c3, 110)))) ThenBlock: {
                ReturnValue(1)
            }
            // "Init" = 73,110,105,116
            IfCondition And(EqualTo(c0, 73), And(EqualTo(c1, 110), And(EqualTo(c2, 105), EqualTo(c3, 116)))) ThenBlock: {
                ReturnValue(1)
            }
            // "Test" = 84,101,115,116
            IfCondition And(EqualTo(c0, 84), And(EqualTo(c1, 101), And(EqualTo(c2, 115), EqualTo(c3, 116)))) ThenBlock: {
                ReturnValue(1)
            }
        }
        
        ReturnValue(0)
    }
}

Function.Analyzer.IsBuiltinFunc {
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(name, 0) ThenBlock: {
            ReturnValue(0)
        }
        
        // Common builtins
        cmp = StringCompare(name, "Add")
