// =============================================================================
// HELPERS
// =============================================================================
Function.Analyzer.CountParams {
    Input: func_node: Address
    Output: Integer
    Body: {
        count = 0
        child_count = AST_GetChildCount(func_node)
        
        i = 0
        WhileLoop LessThan(i, child_count) {
            child = AST_GetChild(func_node, i)
            IfCondition NotEqual(child, 0) ThenBlock: {
                child_type = AST_GetType(child)
                IfCondition EqualTo(child_type, AST.PARAMETER) ThenBlock: {
                    count = Add(count, 1)
                }
            }
            i = Add(i, 1)
        }
        
        ReturnValue(count)
    }
}

// =============================================================================
// REPORT
// =============================================================================
Function.Analyzer.Report {
    Body: {
        PrintMessage("\n")
        PrintMessage("========================================\n")
        PrintMessage("        Code Analysis Report\n")
        PrintMessage("========================================\n")
        PrintMessage("NOTE: Line numbers show 0 when AST lacks\n")
        PrintMessage("      position info. Use 'dump' to get\n")
        PrintMessage("      combined_source.ailang for reference.\n")
        PrintMessage("========================================\n\n")
        
        // Stats
        PrintMessage("--- Statistics ---\n")
        PrintMessage("Functions analyzed: ")
        PrintNumber(Analyzer.functions_analyzed)
        PrintMessage("\n")
        PrintMessage("SubRoutines analyzed: ")
        PrintNumber(Analyzer.subroutines_analyzed)
        PrintMessage("\n")
        PrintMessage("Functions defined: ")
        PrintNumber(Array.Size(Analyzer.defined_funcs))
        PrintMessage("\n")
        PrintMessage("Functions called: ")
        PrintNumber(Array.Size(Analyzer.called_funcs))
        PrintMessage("\n\n")
        
        PrintMessage("--- Memory ---\n")
        PrintMessage("Total Allocate calls: ")
        PrintNumber(Analyzer.total_allocs)
        PrintMessage("\n")
        PrintMessage("Total Deallocate calls: ")
        PrintNumber(Analyzer.total_deallocs)
        PrintMessage("\n")
        
        diff = Subtract(Analyzer.total_allocs, Analyzer.total_deallocs)
        IfCondition GreaterThan(diff, 0) ThenBlock: {
            PrintMessage("Allocation imbalance: +")
            PrintNumber(diff)
            PrintMessage(" — review warnings\n")
        }
        IfCondition LessThan(diff, 0) ThenBlock: {
            neg_diff = Subtract(0, diff)
            PrintMessage("Deallocation excess: +")
            PrintNumber(neg_diff)
            PrintMessage(" — possible double-free risk\n")
        }
        IfCondition EqualTo(diff, 0) ThenBlock: {
            PrintMessage("Allocation balance: OK\n")
        }
        PrintMessage("\n")
        
        PrintMessage("--- Style ---\n")
        PrintMessage("Max nesting depth: ")
        PrintNumber(Analyzer.max_block_depth)
        IfCondition NotEqual(Analyzer.max_depth_func, 0) ThenBlock: {
            PrintMessage(" in '")
            PrintMessage(Analyzer.max_depth_func)
            PrintMessage("'")
        }
        PrintMessage("\n")
        // Nesting-limit warning is Analyzer.CheckNestingDepth in PostAnalysis.
        
        PrintMessage("\n")
        
        // Errors
        IfCondition GreaterThan(Analyzer.error_count, 0) ThenBlock: {
            PrintMessage("========================================\n")
            PrintMessage("ERRORS:\n")
            PrintMessage("========================================\n")
            
            i = 0
            WhileLoop LessThan(i, Analyzer.error_count) {
                msg = Array.Get(Analyzer.errors, i)
                PrintMessage("  [ERROR] ")
                PrintMessage(msg)
                PrintMessage("\n")
                i = Add(i, 1)
            }
            PrintMessage("\n")
        }
        
        // Warnings
        IfCondition GreaterThan(Analyzer.warning_count, 0) ThenBlock: {
            PrintMessage("========================================\n")
            PrintMessage("WARNINGS:\n")
            PrintMessage("========================================\n")
            
            i = 0
            WhileLoop LessThan(i, Analyzer.warning_count) {
                msg = Array.Get(Analyzer.warnings, i)
                PrintMessage("  [WARN] ")
                PrintMessage(msg)
                PrintMessage("\n")
                i = Add(i, 1)
            }
            PrintMessage("\n")
        }
        
        // Summary
        PrintMessage("========================================\n")
        IfCondition And(EqualTo(Analyzer.error_count, 0), EqualTo(Analyzer.warning_count, 0)) ThenBlock: {
            PrintMessage("  No issues found!\n")
        } ElseBlock: {
            PrintMessage("  Summary: ")
            PrintNumber(Analyzer.error_count)
            PrintMessage(" errors, ")
            PrintNumber(Analyzer.warning_count)
            PrintMessage(" warnings\n")
        }
        PrintMessage("========================================\n\n")
    }
}

// =============================================================================
// CLEANUP
// =============================================================================
Function.Analyzer.Cleanup {
    Body: {
        IfCondition NotEqual(Analyzer.warnings, 0) ThenBlock: {
            Array.Destroy(Analyzer.warnings)
            Analyzer.warnings = 0
        }
        IfCondition NotEqual(Analyzer.errors, 0) ThenBlock: {
            Array.Destroy(Analyzer.errors)
            Analyzer.errors = 0
        }
        IfCondition NotEqual(Analyzer.func_alloc_vars, 0) ThenBlock: {
            Array.Destroy(Analyzer.func_alloc_vars)
            Analyzer.func_alloc_vars = 0
        }
        IfCondition NotEqual(Analyzer.func_alloc_lines, 0) ThenBlock: {
            Array.Destroy(Analyzer.func_alloc_lines)
            Analyzer.func_alloc_lines = 0
        }
        IfCondition NotEqual(Analyzer.func_alloc_sizes, 0) ThenBlock: {
            Array.Destroy(Analyzer.func_alloc_sizes)
            Analyzer.func_alloc_sizes = 0
        }
        IfCondition NotEqual(Analyzer.func_alloc_kinds, 0) ThenBlock: {
            Array.Destroy(Analyzer.func_alloc_kinds)
            Analyzer.func_alloc_kinds = 0
        }
        IfCondition NotEqual(Analyzer.func_params, 0) ThenBlock: {
            Array.Destroy(Analyzer.func_params)
            Analyzer.func_params = 0
        }
        IfCondition NotEqual(Analyzer.func_arena_vars, 0) ThenBlock: {
            Array.Destroy(Analyzer.func_arena_vars)
            Analyzer.func_arena_vars = 0
        }
        IfCondition NotEqual(Analyzer.func_partial_allocs, 0) ThenBlock: {
            Array.Destroy(Analyzer.func_partial_allocs)
            Analyzer.func_partial_allocs = 0
        }
        IfCondition NotEqual(Analyzer.func_partial_vars, 0) ThenBlock: {
            Array.Destroy(Analyzer.func_partial_vars)
            Analyzer.func_partial_vars = 0
        }
        IfCondition NotEqual(Analyzer.free_keys, 0) ThenBlock: {
            Array.Destroy(Analyzer.free_keys)
            Analyzer.free_keys = 0
        }
        IfCondition NotEqual(Analyzer.ret_alloc_funcs, 0) ThenBlock: {
            Array.Destroy(Analyzer.ret_alloc_funcs)
            Analyzer.ret_alloc_funcs = 0
        }
        IfCondition NotEqual(Analyzer.col_params, 0) ThenBlock: {
            Array.Destroy(Analyzer.col_params)
            Analyzer.col_params = 0
        }
        IfCondition NotEqual(Analyzer.col_allocs, 0) ThenBlock: {
            Array.Destroy(Analyzer.col_allocs)
            Analyzer.col_allocs = 0
        }
        IfCondition NotEqual(Analyzer.col_dealloc, 0) ThenBlock: {
            Array.Destroy(Analyzer.col_dealloc)
            Analyzer.col_dealloc = 0
        }
        IfCondition NotEqual(Analyzer.func_dealloc_vars, 0) ThenBlock: {
            Array.Destroy(Analyzer.func_dealloc_vars)
            Analyzer.func_dealloc_vars = 0
        }
        IfCondition NotEqual(Analyzer.func_dealloc_lines, 0) ThenBlock: {
            Array.Destroy(Analyzer.func_dealloc_lines)
            Analyzer.func_dealloc_lines = 0
        }
        IfCondition NotEqual(Analyzer.func_dealloc_marks, 0) ThenBlock: {
            Array.Destroy(Analyzer.func_dealloc_marks)
            Analyzer.func_dealloc_marks = 0
        }
        IfCondition NotEqual(Analyzer.func_alias_names, 0) ThenBlock: {
            Array.Destroy(Analyzer.func_alias_names)
            Analyzer.func_alias_names = 0
        }
        IfCondition NotEqual(Analyzer.func_alias_roots, 0) ThenBlock: {
            Array.Destroy(Analyzer.func_alias_roots)
            Analyzer.func_alias_roots = 0
        }
        IfCondition NotEqual(Analyzer.func_const_names, 0) ThenBlock: {
            Array.Destroy(Analyzer.func_const_names)
            Analyzer.func_const_names = 0
        }
        IfCondition NotEqual(Analyzer.func_const_values, 0) ThenBlock: {
            Array.Destroy(Analyzer.func_const_values)
            Analyzer.func_const_values = 0
        }
        IfCondition NotEqual(Analyzer.func_loop_written, 0) ThenBlock: {
            Array.Destroy(Analyzer.func_loop_written)
            Analyzer.func_loop_written = 0
        }
        IfCondition NotEqual(Analyzer.func_returned_vars, 0) ThenBlock: {
            Array.Destroy(Analyzer.func_returned_vars)
            Analyzer.func_returned_vars = 0
        }
        IfCondition NotEqual(Analyzer.func_assigned_vars, 0) ThenBlock: {
            Array.Destroy(Analyzer.func_assigned_vars)
            Analyzer.func_assigned_vars = 0
        }
        IfCondition NotEqual(Analyzer.func_used_vars, 0) ThenBlock: {
            Array.Destroy(Analyzer.func_used_vars)
            Analyzer.func_used_vars = 0
        }
        IfCondition NotEqual(Analyzer.defined_funcs, 0) ThenBlock: {
            Array.Destroy(Analyzer.defined_funcs)
            Analyzer.defined_funcs = 0
        }
        IfCondition NotEqual(Analyzer.called_funcs, 0) ThenBlock: {
            Array.Destroy(Analyzer.called_funcs)
            Analyzer.called_funcs = 0
        }
        IfCondition NotEqual(Analyzer.func_call_counts, 0) ThenBlock: {
            Array.Destroy(Analyzer.func_call_counts)
            Analyzer.func_call_counts = 0
        }
        
        Analyzer.warning_count = 0
        Analyzer.error_count = 0
    }
}

// =============================================================================
// CONFIGURATION
// =============================================================================
Function.Analyzer.Enable {
    Body: {
        Analyzer.enabled = 1
    }
}

Function.Analyzer.Disable {
    Body: {
        Analyzer.enabled = 0
    }
}

Function.Analyzer.SetVerbose {
    Input: val: Integer
    Body: {
        Analyzer.verbose = val
    }
}

Function.Analyzer.IsEnabled {
    Output: Integer
    Body: {
        ReturnValue(Analyzer.enabled)
    }
}