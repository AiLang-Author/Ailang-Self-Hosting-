// Library.Analyzer.ailang
// Self-Contained Code Analysis Tool for AILang
// Owns its own pipeline: Load → Resolve → Lex → Parse → Analyze
//
// Features:
//   - Memory leak detection (Allocate/Deallocate pairing)
//   - Unmatched deallocation detection
//   - Function-scoped tracking
//   - Style warnings (nesting depth, param count)
//   - Standalone operation - no dependency on compiler state
//
// Usage:
//   Analyzer.AnalyzeFile("myfile.ailang")
//   -- or --
//   Analyzer.AnalyzeSource(source_string, source_len)

LibraryImport.XArrays
LibraryImport.DiagnosticStore

LibraryImport.Compiler.Frontend.Lexer.CLexerCore
LibraryImport.Compiler.Frontend.Lexer.CLexerMain
LibraryImport.Compiler.Frontend.Parser.CParserCore
LibraryImport.Compiler.Frontend.Parser.CParserMain
LibraryImport.Compiler.Frontend.AST.CASTCore
LibraryImport.Compiler.Frontend.AST.CASTTypes
LibraryImport.Compiler.Import.CImportResolver


// =============================================================================
// ANALYZER STATE
// =============================================================================
FixedPool.Analyzer {
    // Pipeline state (owned by analyzer)
    "source": Initialize=0, CanChange=True
    "source_len": Initialize=0, CanChange=True
    "resolved_source": Initialize=0, CanChange=True
    "ast": Initialize=0, CanChange=True
    "owns_source": Initialize=0, CanChange=True
    
    // Results
    "warnings": Initialize=0, CanChange=True
    "errors": Initialize=0, CanChange=True
    "warning_count": Initialize=0, CanChange=True
    "error_count": Initialize=0, CanChange=True
    
    // Per-function tracking
    "current_func": Initialize=0, CanChange=True
    "current_func_line": Initialize=0, CanChange=True
    "func_alloc_vars": Initialize=0, CanChange=True
    "func_alloc_lines": Initialize=0, CanChange=True
    "func_dealloc_vars": Initialize=0, CanChange=True
    "func_dealloc_lines": Initialize=0, CanChange=True
    "func_has_output": Initialize=0, CanChange=True
    "func_has_return": Initialize=0, CanChange=True
    "func_returned_vars": Initialize=0, CanChange=True
    
    // Variable tracking (per function)
    "func_assigned_vars": Initialize=0, CanChange=True
    "func_used_vars": Initialize=0, CanChange=True
    
    // Function definition/call tracking (global)
    "defined_funcs": Initialize=0, CanChange=True
    "called_funcs": Initialize=0, CanChange=True
    "func_call_counts": Initialize=0, CanChange=True
    
    // Nesting tracking
    "block_depth": Initialize=0, CanChange=True
    "max_block_depth": Initialize=0, CanChange=True
    "max_depth_func": Initialize=0, CanChange=True
    "max_depth_line": Initialize=0, CanChange=True
    
    // Stats
    "total_allocs": Initialize=0, CanChange=True
    "total_deallocs": Initialize=0, CanChange=True
    "functions_analyzed": Initialize=0, CanChange=True
    "subroutines_analyzed": Initialize=0, CanChange=True
    
    // Config
    "enabled": Initialize=0, CanChange=True
    "check_memory": Initialize=1, CanChange=True
    "check_style": Initialize=1, CanChange=True
    "check_unused": Initialize=1, CanChange=True
    "check_undefined": Initialize=1, CanChange=True
    "check_returns": Initialize=1, CanChange=True
    "max_nesting": Initialize=5
    "max_params": Initialize=6
    "max_func_lines": Initialize=100
    "verbose": Initialize=0, CanChange=True
}


// =============================================================================
// FILE LOADING
// =============================================================================
Function.Analyzer.LoadFile {
    Input: filename: Address
    Output: Address
    Body: {
        // Open file
        fd = SystemCall(2, filename, 0, 0)  // O_RDONLY
        IfCondition LessThan(fd, 0) ThenBlock: {
            ReturnValue(0)
        }
        
        // Get file size
        size = SystemCall(8, fd, 0, 2)  // lseek SEEK_END
        SystemCall(8, fd, 0, 0)          // lseek SEEK_SET
        
        IfCondition LessEqual(size, 0) ThenBlock: {
            SystemCall(3, fd)  // close
            ReturnValue(0)
        }
        
        // Allocate buffer
        buffer = Allocate(Add(size, 1))
        IfCondition EqualTo(buffer, 0) ThenBlock: {
            SystemCall(3, fd)
            ReturnValue(0)
        }
        
        // Read file
        bytes_read = SystemCall(0, fd, buffer, size)
        SystemCall(3, fd)
        
        IfCondition LessThan(bytes_read, 0) ThenBlock: {
            Deallocate(buffer, Add(size, 1))
            ReturnValue(0)
        }
        
        // Null terminate
        SetByte(buffer, bytes_read, 0)
        
        ReturnValue(buffer)
    }
}

// =============================================================================
// PIPELINE CLEANUP
// =============================================================================
Function.Analyzer.PipelineCleanup {
    Body: {
        // Free resolved source if different from original
        IfCondition NotEqual(Analyzer.resolved_source, Analyzer.source) ThenBlock: {
            IfCondition NotEqual(Analyzer.resolved_source, 0) ThenBlock: {
                // resolved_source is allocated by Import_ResolveAll
                // Deallocate it
                res_len = StringLength(Analyzer.resolved_source)
                Deallocate(Analyzer.resolved_source, Add(res_len, 1))
            }
        }
        
        // Free source if we own it
        IfCondition EqualTo(Analyzer.owns_source, 1) ThenBlock: {
            IfCondition NotEqual(Analyzer.source, 0) ThenBlock: {
                Deallocate(Analyzer.source, Add(Analyzer.source_len, 1))
            }
        }
        
        Analyzer.source = 0
        Analyzer.source_len = 0
        Analyzer.resolved_source = 0
        Analyzer.ast = 0
        Analyzer.owns_source = 0
    }
}

// =============================================================================
// ANALYSIS STATE INITIALIZATION
// =============================================================================
Function.Analyzer.Init {
    Body: {
        Analyzer.warnings = XArray.XCreate(128)
        Analyzer.errors = XArray.XCreate(32)
        Analyzer.warning_count = 0
        Analyzer.error_count = 0
        
        // Per-function memory tracking
        Analyzer.func_alloc_vars = XArray.XCreate(32)
        Analyzer.func_alloc_lines = XArray.XCreate(32)
        Analyzer.func_dealloc_vars = XArray.XCreate(32)
        Analyzer.func_dealloc_lines = XArray.XCreate(32)
        Analyzer.func_returned_vars = XArray.XCreate(16)
        
        // Per-function variable tracking
        Analyzer.func_assigned_vars = XArray.XCreate(64)
        Analyzer.func_used_vars = XArray.XCreate(64)
        
        // Global function tracking
        Analyzer.defined_funcs = XArray.XCreate(256)
        Analyzer.called_funcs = XArray.XCreate(256)
        Analyzer.func_call_counts = XArray.XCreate(256)
        
        Analyzer.current_func = 0
        Analyzer.current_func_line = 0
        Analyzer.func_has_output = 0
        Analyzer.func_has_return = 0
        Analyzer.block_depth = 0
        Analyzer.max_block_depth = 0
        Analyzer.max_depth_func = 0
        Analyzer.max_depth_line = 0
        
        Analyzer.total_allocs = 0
        Analyzer.total_deallocs = 0
        Analyzer.functions_analyzed = 0
        Analyzer.subroutines_analyzed = 0
        
        ReturnValue(1)
    }
}

// =============================================================================
// DIAGNOSTICS
// =============================================================================
Function.Analyzer.AddWarning {
    Input: msg: Address
    Body: {
        XArray.XPush(Analyzer.warnings, msg)
        Analyzer.warning_count = Add(Analyzer.warning_count, 1)
    }
}

Function.Analyzer.AddError {
    Input: msg: Address
    Body: {
        XArray.XPush(Analyzer.errors, msg)
        Analyzer.error_count = Add(Analyzer.error_count, 1)
    }
}

// =============================================================================
// STRING HELPERS
// =============================================================================
Function.Analyzer.StrEqual {
    Input: a: Address
    Input: b: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(a, 0) ThenBlock: {
            IfCondition EqualTo(b, 0) ThenBlock: {
                ReturnValue(1)
            }
            ReturnValue(0)
        }
        IfCondition EqualTo(b, 0) ThenBlock: {
            ReturnValue(0)
        }
        cmp = StringCompare(a, b)
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            ReturnValue(1)
        }
        ReturnValue(0)
    }
}

// =============================================================================
// PER-FUNCTION TRACKING
// =============================================================================
Function.Analyzer.EnterFunction {
    Input: name: Address
    Input: line: Integer
    Input: is_subroutine: Integer
    Body: {
        // Clear per-function tracking
        XArray.XClear(Analyzer.func_alloc_vars)
        XArray.XClear(Analyzer.func_alloc_lines)
        XArray.XClear(Analyzer.func_dealloc_vars)
        XArray.XClear(Analyzer.func_dealloc_lines)
        XArray.XClear(Analyzer.func_returned_vars)
        XArray.XClear(Analyzer.func_assigned_vars)
        XArray.XClear(Analyzer.func_used_vars)
        
        Analyzer.current_func = name
        Analyzer.current_func_line = line
        Analyzer.func_has_output = 0
        Analyzer.func_has_return = 0
        Analyzer.block_depth = 0
        
        IfCondition EqualTo(is_subroutine, 1) ThenBlock: {
            Analyzer.subroutines_analyzed = Add(Analyzer.subroutines_analyzed, 1)
        } ElseBlock: {
            Analyzer.functions_analyzed = Add(Analyzer.functions_analyzed, 1)
        }
        
        // Record as defined
        IfCondition NotEqual(name, 0) ThenBlock: {
            Analyzer.RecordDefinedFunc(name)
        }
        
        IfCondition EqualTo(Analyzer.verbose, 1) ThenBlock: {
            PrintMessage("  >> Entering: ")
            IfCondition NotEqual(name, 0) ThenBlock: {
                PrintMessage(name)
            } ElseBlock: {
                PrintMessage("<anonymous>")
            }
            PrintMessage("\n")
        }
    }
}

Function.Analyzer.RecordDefinedFunc {
    Input: name: Address
    Body: {
        // Check if already in list
        count = XArray.XSize(Analyzer.defined_funcs)
        i = 0
        WhileLoop LessThan(i, count) {
            existing = XArray.XGet(Analyzer.defined_funcs, i)
            IfCondition EqualTo(Analyzer.StrEqual(existing, name), 1) ThenBlock: {
                ReturnValue(0)
            }
            i = Add(i, 1)
        }
        XArray.XPush(Analyzer.defined_funcs, name)
    }
}

Function.Analyzer.RecordCalledFunc {
    Input: name: Address
    Body: {
        // Check if already in list and increment count
        count = XArray.XSize(Analyzer.called_funcs)
        i = 0
        WhileLoop LessThan(i, count) {
            existing = XArray.XGet(Analyzer.called_funcs, i)
            IfCondition EqualTo(Analyzer.StrEqual(existing, name), 1) ThenBlock: {
                // Increment call count
                curr = XArray.XGet(Analyzer.func_call_counts, i)
                XArray.XSet(Analyzer.func_call_counts, i, Add(curr, 1))
                ReturnValue(0)
            }
            i = Add(i, 1)
        }
        XArray.XPush(Analyzer.called_funcs, name)
        XArray.XPush(Analyzer.func_call_counts, 1)
    }
}

Function.Analyzer.RecordAssignment {
    Input: var_name: Address
    Body: {
        IfCondition EqualTo(var_name, 0) ThenBlock: {
            ReturnValue(0)
        }
        // Check if already tracked
        count = XArray.XSize(Analyzer.func_assigned_vars)
        i = 0
        WhileLoop LessThan(i, count) {
            existing = XArray.XGet(Analyzer.func_assigned_vars, i)
            IfCondition EqualTo(Analyzer.StrEqual(existing, var_name), 1) ThenBlock: {
                ReturnValue(0)
            }
            i = Add(i, 1)
        }
        XArray.XPush(Analyzer.func_assigned_vars, var_name)
    }
}

Function.Analyzer.RecordUsage {
    Input: var_name: Address
    Body: {
        IfCondition EqualTo(var_name, 0) ThenBlock: {
            ReturnValue(0)
        }
        // Check if already tracked
        count = XArray.XSize(Analyzer.func_used_vars)
        i = 0
        WhileLoop LessThan(i, count) {
            existing = XArray.XGet(Analyzer.func_used_vars, i)
            IfCondition EqualTo(Analyzer.StrEqual(existing, var_name), 1) ThenBlock: {
                ReturnValue(0)
            }
            i = Add(i, 1)
        }
        XArray.XPush(Analyzer.func_used_vars, var_name)
    }
}

Function.Analyzer.RecordReturnedVar {
    Input: var_name: Address
    Body: {
        IfCondition EqualTo(var_name, 0) ThenBlock: {
            ReturnValue(0)
        }
        XArray.XPush(Analyzer.func_returned_vars, var_name)
    }
}

Function.Analyzer.RecordAlloc {
    Input: var_name: Address
    Input: line: Integer
    Body: {
        XArray.XPush(Analyzer.func_alloc_vars, var_name)
        XArray.XPush(Analyzer.func_alloc_lines, line)
        Analyzer.total_allocs = Add(Analyzer.total_allocs, 1)
        
        IfCondition EqualTo(Analyzer.verbose, 1) ThenBlock: {
            PrintMessage("     [ALLOC] ")
            IfCondition NotEqual(var_name, 0) ThenBlock: {
                PrintMessage(var_name)
            }
            PrintMessage(" @ line ")
            PrintNumber(line)
            PrintMessage("\n")
        }
    }
}

Function.Analyzer.RecordDealloc {
    Input: var_name: Address
    Input: line: Integer
    Body: {
        XArray.XPush(Analyzer.func_dealloc_vars, var_name)
        XArray.XPush(Analyzer.func_dealloc_lines, line)
        Analyzer.total_deallocs = Add(Analyzer.total_deallocs, 1)
        
        IfCondition EqualTo(Analyzer.verbose, 1) ThenBlock: {
            PrintMessage("     [DEALLOC] ")
            IfCondition NotEqual(var_name, 0) ThenBlock: {
                PrintMessage(var_name)
            }
            PrintMessage(" @ line ")
            PrintNumber(line)
            PrintMessage("\n")
        }
    }
}

Function.Analyzer.ExitFunction {
    Body: {
        // === CHECK: Missing return value ===
        IfCondition EqualTo(Analyzer.check_returns, 1) ThenBlock: {
            IfCondition EqualTo(Analyzer.func_has_output, 1) ThenBlock: {
                IfCondition EqualTo(Analyzer.func_has_return, 0) ThenBlock: {
                    msg = StringConcat("Function '", "")
                    IfCondition NotEqual(Analyzer.current_func, 0) ThenBlock: {
                        msg = StringConcat(msg, Analyzer.current_func)
                    } ElseBlock: {
                        msg = StringConcat(msg, "<unknown>")
                    }
                    msg = StringConcat(msg, "' declares Output but has no ReturnValue")
                    Analyzer.AddWarning(msg)
                }
            }
        }
        
        // === CHECK: Unused variables ===
        IfCondition EqualTo(Analyzer.check_unused, 1) ThenBlock: {
            assigned_count = XArray.XSize(Analyzer.func_assigned_vars)
            i = 0
            WhileLoop LessThan(i, assigned_count) {
                var = XArray.XGet(Analyzer.func_assigned_vars, i)
                is_used = Analyzer.IsVarUsed(var)
                IfCondition EqualTo(is_used, 0) ThenBlock: {
                    is_ignorable = Analyzer.IsIgnorableVar(var)
                    IfCondition EqualTo(is_ignorable, 0) ThenBlock: {
                        msg = StringConcat("Variable '", "")
                        IfCondition NotEqual(var, 0) ThenBlock: {
                            msg = StringConcat(msg, var)
                        }
                        msg = StringConcat(msg, "' assigned but never used in '")
                        IfCondition NotEqual(Analyzer.current_func, 0) ThenBlock: {
                            msg = StringConcat(msg, Analyzer.current_func)
                        }
                        msg = StringConcat(msg, "'")
                        Analyzer.AddWarning(msg)
                    }
                }
                i = Add(i, 1)
            }
        }
        
        // === CHECK: Memory leaks (skip if returned or FixedPool member) ===
        IfCondition EqualTo(Analyzer.check_memory, 1) ThenBlock: {
            alloc_count = XArray.XSize(Analyzer.func_alloc_vars)
            
            i = 0
            WhileLoop LessThan(i, alloc_count) {
                alloc_var = XArray.XGet(Analyzer.func_alloc_vars, i)
                alloc_line = XArray.XGet(Analyzer.func_alloc_lines, i)
                
                // Skip FixedPool members (contain dot) - managed globally
                is_pool_member = Analyzer.IsPoolMember(alloc_var)
                IfCondition EqualTo(is_pool_member, 0) ThenBlock: {
                    // Check if deallocated
                    found_dealloc = Analyzer.IsVarDeallocated(alloc_var)
                    
                    // Check if returned (not a leak if returned)
                    is_returned = Analyzer.IsVarReturned(alloc_var)
                    
                    IfCondition EqualTo(found_dealloc, 0) ThenBlock: {
                        IfCondition EqualTo(is_returned, 0) ThenBlock: {
                            msg = StringConcat("Line ", NumberToString(alloc_line))
                            msg = StringConcat(msg, ": '")
                            IfCondition NotEqual(alloc_var, 0) ThenBlock: {
                                msg = StringConcat(msg, alloc_var)
                            } ElseBlock: {
                                msg = StringConcat(msg, "<expr>")
                            }
                            msg = StringConcat(msg, "' allocated but not deallocated/returned in '")
                            IfCondition NotEqual(Analyzer.current_func, 0) ThenBlock: {
                                msg = StringConcat(msg, Analyzer.current_func)
                            } ElseBlock: {
                                msg = StringConcat(msg, "<unknown>")
                            }
                            msg = StringConcat(msg, "'")
                            Analyzer.AddWarning(msg)
                        }
                    }
                }
                
                i = Add(i, 1)
            }
        }
        
        IfCondition EqualTo(Analyzer.verbose, 1) ThenBlock: {
            PrintMessage("  << Exiting: ")
            IfCondition NotEqual(Analyzer.current_func, 0) ThenBlock: {
                PrintMessage(Analyzer.current_func)
            }
            PrintMessage(" (")
            PrintNumber(XArray.XSize(Analyzer.func_alloc_vars))
            PrintMessage(" allocs, ")
            PrintNumber(XArray.XSize(Analyzer.func_dealloc_vars))
            PrintMessage(" deallocs, ")
            PrintNumber(XArray.XSize(Analyzer.func_assigned_vars))
            PrintMessage(" assigns, ")
            PrintNumber(XArray.XSize(Analyzer.func_used_vars))
            PrintMessage(" uses)\n")
        }
    }
}

Function.Analyzer.IsPoolMember {
    Input: var_name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(var_name, 0) ThenBlock: {
            ReturnValue(0)
        }
        
        len = StringLength(var_name)
        i = 0
        WhileLoop LessThan(i, len) {
            ch = GetByte(var_name, i)
            IfCondition EqualTo(ch, 46) ThenBlock: {
                ReturnValue(1)
            }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

Function.Analyzer.IsVarDeallocated {
    Input: var_name: Address
    Output: Integer
    Body: {
        dealloc_count = XArray.XSize(Analyzer.func_dealloc_vars)
        j = 0
        WhileLoop LessThan(j, dealloc_count) {
            dealloc_var = XArray.XGet(Analyzer.func_dealloc_vars, j)
            IfCondition EqualTo(Analyzer.StrEqual(var_name, dealloc_var), 1) ThenBlock: {
                ReturnValue(1)
            }
            j = Add(j, 1)
        }
        ReturnValue(0)
    }
}

Function.Analyzer.IsVarReturned {
    Input: var_name: Address
    Output: Integer
    Body: {
        ret_count = XArray.XSize(Analyzer.func_returned_vars)
        j = 0
        WhileLoop LessThan(j, ret_count) {
            ret_var = XArray.XGet(Analyzer.func_returned_vars, j)
            IfCondition EqualTo(Analyzer.StrEqual(var_name, ret_var), 1) ThenBlock: {
                ReturnValue(1)
            }
            j = Add(j, 1)
        }
        ReturnValue(0)
    }
}

Function.Analyzer.IsVarUsed {
    Input: var_name: Address
    Output: Integer
    Body: {
        used_count = XArray.XSize(Analyzer.func_used_vars)
        j = 0
        WhileLoop LessThan(j, used_count) {
            used_var = XArray.XGet(Analyzer.func_used_vars, j)
            IfCondition EqualTo(Analyzer.StrEqual(var_name, used_var), 1) ThenBlock: {
                ReturnValue(1)
            }
            j = Add(j, 1)
        }
        ReturnValue(0)
    }
}

Function.Analyzer.IsIgnorableVar {
    Input: var_name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(var_name, 0) ThenBlock: {
            ReturnValue(1)
        }
        
        len = StringLength(var_name)
        
        // Single char vars like i, j, k are often loop counters
        IfCondition EqualTo(len, 1) ThenBlock: {
            ReturnValue(1)
        }
        
        // Variables starting with underscore are intentionally unused
        first = GetByte(var_name, 0)
        IfCondition EqualTo(first, 95) ThenBlock: {
            ReturnValue(1)
        }
        
        // FixedPool members (contain a dot) - these are global state
        i = 0
        WhileLoop LessThan(i, len) {
            ch = GetByte(var_name, i)
            IfCondition EqualTo(ch, 46) ThenBlock: {
                // Found a dot - it's Pool.member syntax
                ReturnValue(1)
            }
            i = Add(i, 1)
        }
        
        ReturnValue(0)
    }
}

// =============================================================================
// AST WALKER
// =============================================================================
Function.Analyzer.WalkNode {
    Input: node: Address
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: {
            ReturnValue(0)
        }
        
        node_type = AST_GetType(node)
        node_line = AST_GetLine(node)
        
        // === FUNCTION ENTRY ===
        IfCondition EqualTo(node_type, AST.FUNCTION) ThenBlock: {
            func_name = AST_GetData1(node)
            Analyzer.EnterFunction(func_name, node_line, 0)
            
            // Check for Output declaration and parameter count
            Analyzer.ScanFunctionHeader(node)
            
            // Walk children
            Analyzer.WalkChildren(node)
            
            // Exit function - run all checks
            Analyzer.ExitFunction()
            ReturnValue(0)
        }
        
        // === SUBROUTINE ===
        IfCondition EqualTo(node_type, AST.SUBROUTINE) ThenBlock: {
            func_name = AST_GetData1(node)
            Analyzer.EnterFunction(func_name, node_line, 1)
            Analyzer.WalkChildren(node)
            Analyzer.ExitFunction()
            ReturnValue(0)
        }
        
        // === OUTPUT DECLARATION ===
        IfCondition EqualTo(node_type, AST.OUTPUT_DECL) ThenBlock: {
            Analyzer.func_has_output = 1
            ReturnValue(0)
        }
        
        // === RETURN VALUE ===
        IfCondition EqualTo(node_type, AST.RETURN) ThenBlock: {
            Analyzer.func_has_return = 1
            
            // Track what variable is returned (for memory analysis)
            child_count = AST_GetChildCount(node)
            IfCondition GreaterThan(child_count, 0) ThenBlock: {
                ret_expr = AST_GetChild(node, 0)
                IfCondition NotEqual(ret_expr, 0) ThenBlock: {
                    ret_type = AST_GetType(ret_expr)
                    IfCondition EqualTo(ret_type, AST.IDENTIFIER) ThenBlock: {
                        ret_var = AST_GetData1(ret_expr)
                        Analyzer.RecordReturnedVar(ret_var)
                        Analyzer.RecordUsage(ret_var)
                    } ElseBlock: {
                        // Walk the return expression to track any var usage
                        Analyzer.WalkNode(ret_expr)
                    }
                }
            }
            ReturnValue(0)
        }
        
        // === BLOCK NESTING ===
        IfCondition EqualTo(node_type, AST.BODY) ThenBlock: {
            Analyzer.block_depth = Add(Analyzer.block_depth, 1)
            IfCondition GreaterThan(Analyzer.block_depth, Analyzer.max_block_depth) ThenBlock: {
                Analyzer.max_block_depth = Analyzer.block_depth
                Analyzer.max_depth_func = Analyzer.current_func
                Analyzer.max_depth_line = node_line
            }
            Analyzer.WalkChildren(node)
            Analyzer.block_depth = Subtract(Analyzer.block_depth, 1)
            ReturnValue(0)
        }
        
        IfCondition EqualTo(node_type, AST.BLOCK) ThenBlock: {
            Analyzer.block_depth = Add(Analyzer.block_depth, 1)
            IfCondition GreaterThan(Analyzer.block_depth, Analyzer.max_block_depth) ThenBlock: {
                Analyzer.max_block_depth = Analyzer.block_depth
                Analyzer.max_depth_func = Analyzer.current_func
                Analyzer.max_depth_line = node_line
            }
            Analyzer.WalkChildren(node)
            Analyzer.block_depth = Subtract(Analyzer.block_depth, 1)
            ReturnValue(0)
        }
        
        // === ASSIGNMENT - check for Allocate, track variable ===
        IfCondition EqualTo(node_type, AST.ASSIGNMENT) ThenBlock: {
            target = AST_GetData1(node)
            Analyzer.RecordAssignment(target)
            
            child_count = AST_GetChildCount(node)
            IfCondition GreaterThan(child_count, 0) ThenBlock: {
                value = AST_GetChild(node, 0)
                IfCondition NotEqual(value, 0) ThenBlock: {
                    value_type = AST_GetType(value)
                    
                    // Check if RHS is Allocate call
                    IfCondition EqualTo(value_type, AST.CALL) ThenBlock: {
                        call_name = AST_GetData1(value)
                        IfCondition NotEqual(call_name, 0) ThenBlock: {
                            is_alloc = Analyzer.StrEqual(call_name, "Allocate")
                            IfCondition EqualTo(is_alloc, 1) ThenBlock: {
                                Analyzer.RecordAlloc(target, node_line)
                            }
                        }
                    }
                    
                    // Walk RHS to track variable usage
                    Analyzer.WalkNode(value)
                }
            }
            ReturnValue(0)
        }
        
        // === IDENTIFIER - track variable usage ===
        IfCondition EqualTo(node_type, AST.IDENTIFIER) ThenBlock: {
            var_name = AST_GetData1(node)
            Analyzer.RecordUsage(var_name)
            ReturnValue(0)
        }
        
        // === FUNCTION CALL ===
        IfCondition EqualTo(node_type, AST.CALL) ThenBlock: {
            call_name = AST_GetData1(node)
            
            IfCondition NotEqual(call_name, 0) ThenBlock: {
                // Record as called
                Analyzer.RecordCalledFunc(call_name)
                
                // Check for Deallocate
                is_dealloc = Analyzer.StrEqual(call_name, "Deallocate")
                IfCondition EqualTo(is_dealloc, 1) ThenBlock: {
                    child_count = AST_GetChildCount(node)
                    IfCondition GreaterThan(child_count, 0) ThenBlock: {
                        arg = AST_GetChild(node, 0)
                        IfCondition NotEqual(arg, 0) ThenBlock: {
                            arg_type = AST_GetType(arg)
                            IfCondition EqualTo(arg_type, AST.IDENTIFIER) ThenBlock: {
                                var_name = AST_GetData1(arg)
                                Analyzer.RecordDealloc(var_name, node_line)
                                Analyzer.RecordUsage(var_name)
                            }
                        }
                    }
                }
            }
            
            // Walk arguments to track usage
            Analyzer.WalkChildren(node)
            ReturnValue(0)
        }
        
        // === DEFAULT: recurse ===
        Analyzer.WalkChildren(node)
    }
}

Function.Analyzer.ScanFunctionHeader {
    Input: func_node: Address
    Body: {
        child_count = AST_GetChildCount(func_node)
        param_count = 0
        
        i = 0
        WhileLoop LessThan(i, child_count) {
            child = AST_GetChild(func_node, i)
            IfCondition NotEqual(child, 0) ThenBlock: {
                child_type = AST_GetType(child)
                
                // Count parameters
                IfCondition EqualTo(child_type, AST.PARAMETER) ThenBlock: {
                    param_count = Add(param_count, 1)
                    // Record parameter as assigned (it has a value from caller)
                    param_name = AST_GetData1(child)
                    Analyzer.RecordAssignment(param_name)
                }
                
                // Check for output declaration
                IfCondition EqualTo(child_type, AST.OUTPUT_DECL) ThenBlock: {
                    Analyzer.func_has_output = 1
                }
            }
            i = Add(i, 1)
        }
        
        // Check parameter count
        IfCondition EqualTo(Analyzer.check_style, 1) ThenBlock: {
            IfCondition GreaterThan(param_count, Analyzer.max_params) ThenBlock: {
                func_name = AST_GetData1(func_node)
                node_line = AST_GetLine(func_node)
                msg = StringConcat("Line ", NumberToString(node_line))
                msg = StringConcat(msg, ": Function '")
                IfCondition NotEqual(func_name, 0) ThenBlock: {
                    msg = StringConcat(msg, func_name)
                }
                msg = StringConcat(msg, "' has ")
                msg = StringConcat(msg, NumberToString(param_count))
                msg = StringConcat(msg, " params (max: ")
                msg = StringConcat(msg, NumberToString(Analyzer.max_params))
                msg = StringConcat(msg, ")")
                Analyzer.AddWarning(msg)
            }
        }
    }
}

Function.Analyzer.WalkChildren {
    Input: node: Address
    Body: {
        child_count = AST_GetChildCount(node)
        i = 0
        WhileLoop LessThan(i, child_count) {
            child = AST_GetChild(node, i)
            Analyzer.WalkNode(child)
            i = Add(i, 1)
        }
    }
}

// =============================================================================
// POST-ANALYSIS CHECKS
// =============================================================================
Function.Analyzer.PostAnalysis {
    Body: {
        // Check for undefined functions (called but not defined)
        called_count = XArray.XSize(Analyzer.called_funcs)
        i = 0
        WhileLoop LessThan(i, called_count) {
            called = XArray.XGet(Analyzer.called_funcs, i)
            is_defined = Analyzer.IsFuncDefined(called)
            IfCondition EqualTo(is_defined, 0) ThenBlock: {
                // Check if it's a builtin
                is_builtin = Analyzer.IsBuiltinFunc(called)
                IfCondition EqualTo(is_builtin, 0) ThenBlock: {
                    msg = StringConcat("Function '", "")
                    IfCondition NotEqual(called, 0) ThenBlock: {
                        msg = StringConcat(msg, called)
                    }
                    msg = StringConcat(msg, "' called but not defined")
                    Analyzer.AddWarning(msg)
                }
            }
            i = Add(i, 1)
        }
        
        // Check for unused functions (defined but never called)
        // Skip entry points like Main, Init, Run*, Test*
        defined_count = XArray.XSize(Analyzer.defined_funcs)
        i = 0
        WhileLoop LessThan(i, defined_count) {
            defined = XArray.XGet(Analyzer.defined_funcs, i)
            is_called = Analyzer.IsFuncCalled(defined)
            IfCondition EqualTo(is_called, 0) ThenBlock: {
                is_entry = Analyzer.IsEntryPoint(defined)
                IfCondition EqualTo(is_entry, 0) ThenBlock: {
                    msg = StringConcat("Function '", "")
                    IfCondition NotEqual(defined, 0) ThenBlock: {
                        msg = StringConcat(msg, defined)
                    }
                    msg = StringConcat(msg, "' defined but never called")
                    Analyzer.AddWarning(msg)
                }
            }
            i = Add(i, 1)
        }
    }
}

Function.Analyzer.IsFuncDefined {
    Input: name: Address
    Output: Integer
    Body: {
        count = XArray.XSize(Analyzer.defined_funcs)
        i = 0
        WhileLoop LessThan(i, count) {
            defined = XArray.XGet(Analyzer.defined_funcs, i)
            IfCondition EqualTo(Analyzer.StrEqual(name, defined), 1) ThenBlock: {
                ReturnValue(1)
            }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

Function.Analyzer.IsFuncCalled {
    Input: name: Address
    Output: Integer
    Body: {
        count = XArray.XSize(Analyzer.called_funcs)
        i = 0
        WhileLoop LessThan(i, count) {
            called = XArray.XGet(Analyzer.called_funcs, i)
            IfCondition EqualTo(Analyzer.StrEqual(name, called), 1) ThenBlock: {
                ReturnValue(1)
            }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

Function.Analyzer.IsEntryPoint {
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(name, 0) ThenBlock: {
            ReturnValue(0)
        }
        
        len = StringLength(name)
        IfCondition LessThan(len, 3) ThenBlock: {
            ReturnValue(0)
        }
        
        // Check common prefixes
        c0 = GetByte(name, 0)
        c1 = GetByte(name, 1)
        c2 = GetByte(name, 2)
        
        // "Run" = 82,117,110
        IfCondition And(EqualTo(c0, 82), And(EqualTo(c1, 117), EqualTo(c2, 110))) ThenBlock: {
            ReturnValue(1)
        }
        
        IfCondition GreaterEqual(len, 4) ThenBlock: {
            c3 = GetByte(name, 3)
            // "Main" = 77,97,105,110
            IfCondition And(EqualTo(c0, 77), And(EqualTo(c1, 97), And(EqualTo(c2, 105), EqualTo(c3, 110)))) ThenBlock: {
                ReturnValue(1)
            }
            // "Init" = 73,110,105,116
            IfCondition And(EqualTo(c0, 73), And(EqualTo(c1, 110), And(EqualTo(c2, 105), EqualTo(c3, 116)))) ThenBlock: {
                ReturnValue(1)
            }
            // "Test" = 84,101,115,116
            IfCondition And(EqualTo(c0, 84), And(EqualTo(c1, 101), And(EqualTo(c2, 115), EqualTo(c3, 116)))) ThenBlock: {
                ReturnValue(1)
            }
        }
        
        ReturnValue(0)
    }
}

Function.Analyzer.IsBuiltinFunc {
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(name, 0) ThenBlock: {
            ReturnValue(0)
        }
        
        // Common builtins
        cmp = StringCompare(name, "Add")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
        cmp = StringCompare(name, "Subtract")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
        cmp = StringCompare(name, "Multiply")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
        cmp = StringCompare(name, "Divide")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
        cmp = StringCompare(name, "Modulo")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
        cmp = StringCompare(name, "EqualTo")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
        cmp = StringCompare(name, "NotEqual")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
        cmp = StringCompare(name, "LessThan")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
        cmp = StringCompare(name, "GreaterThan")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
        cmp = StringCompare(name, "LessEqual")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
        cmp = StringCompare(name, "GreaterEqual")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
        cmp = StringCompare(name, "And")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
        cmp = StringCompare(name, "Or")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
        cmp = StringCompare(name, "Not")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
        cmp = StringCompare(name, "BitwiseAnd")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
        cmp = StringCompare(name, "BitwiseOr")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
        cmp = StringCompare(name, "BitwiseXor")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
        cmp = StringCompare(name, "ShiftLeft")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
        cmp = StringCompare(name, "ShiftRight")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
        cmp = StringCompare(name, "PrintMessage")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
        cmp = StringCompare(name, "PrintNumber")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
        cmp = StringCompare(name, "PrintChar")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
        cmp = StringCompare(name, "PrintString")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
        cmp = StringCompare(name, "StringLength")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
        cmp = StringCompare(name, "StringCompare")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
        cmp = StringCompare(name, "StringConcat")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
        cmp = StringCompare(name, "NumberToString")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
        cmp = StringCompare(name, "GetByte")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
        cmp = StringCompare(name, "SetByte")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
        cmp = StringCompare(name, "Allocate")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
        cmp = StringCompare(name, "Deallocate")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
        cmp = StringCompare(name, "ArrayCreate")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
        cmp = StringCompare(name, "ArrayGet")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
        cmp = StringCompare(name, "ArraySet")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
        cmp = StringCompare(name, "ArrayDestroy")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
        cmp = StringCompare(name, "Dereference")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
        cmp = StringCompare(name, "StoreValue")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
        cmp = StringCompare(name, "SystemCall")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
        cmp = StringCompare(name, "Exit")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
        
        ReturnValue(0)
    }
}

// =============================================================================
// HELPERS
// =============================================================================
Function.Analyzer.CountParams {
    Input: func_node: Address
    Output: Integer
    Body: {
        count = 0
        child_count = AST_GetChildCount(func_node)
        
        i = 0
        WhileLoop LessThan(i, child_count) {
            child = AST_GetChild(func_node, i)
            IfCondition NotEqual(child, 0) ThenBlock: {
                child_type = AST_GetType(child)
                IfCondition EqualTo(child_type, AST.PARAMETER) ThenBlock: {
                    count = Add(count, 1)
                }
            }
            i = Add(i, 1)
        }
        
        ReturnValue(count)
    }
}

// =============================================================================
// REPORT
// =============================================================================
Function.Analyzer.Report {
    Body: {
        PrintMessage("\n")
        PrintMessage("========================================\n")
        PrintMessage("        Code Analysis Report\n")
        PrintMessage("========================================\n")
        PrintMessage("NOTE: Line numbers show 0 when AST lacks\n")
        PrintMessage("      position info. Use 'dump' to get\n")
        PrintMessage("      combined_source.ailang for reference.\n")
        PrintMessage("========================================\n\n")
        
        // Stats
        PrintMessage("--- Statistics ---\n")
        PrintMessage("Functions analyzed: ")
        PrintNumber(Analyzer.functions_analyzed)
        PrintMessage("\n")
        PrintMessage("SubRoutines analyzed: ")
        PrintNumber(Analyzer.subroutines_analyzed)
        PrintMessage("\n")
        PrintMessage("Functions defined: ")
        PrintNumber(XArray.XSize(Analyzer.defined_funcs))
        PrintMessage("\n")
        PrintMessage("Functions called: ")
        PrintNumber(XArray.XSize(Analyzer.called_funcs))
        PrintMessage("\n\n")
        
        PrintMessage("--- Memory ---\n")
        PrintMessage("Total Allocate() calls: ")
        PrintNumber(Analyzer.total_allocs)
        PrintMessage("\n")
        PrintMessage("Total Deallocate() calls: ")
        PrintNumber(Analyzer.total_deallocs)
        PrintMessage("\n")
        
        diff = Subtract(Analyzer.total_allocs, Analyzer.total_deallocs)
        IfCondition GreaterThan(diff, 0) ThenBlock: {
            PrintMessage("Allocation imbalance: +")
            PrintNumber(diff)
            PrintMessage(" (review warnings)\n")
        }
        IfCondition LessThan(diff, 0) ThenBlock: {
            neg_diff = Subtract(0, diff)
            PrintMessage("Deallocation excess: +")
            PrintNumber(neg_diff)
            PrintMessage(" (possible double-free risk)\n")
        }
        IfCondition EqualTo(diff, 0) ThenBlock: {
            PrintMessage("Allocation balance: OK\n")
        }
        PrintMessage("\n")
        
        PrintMessage("--- Style ---\n")
        PrintMessage("Max nesting depth: ")
        PrintNumber(Analyzer.max_block_depth)
        IfCondition NotEqual(Analyzer.max_depth_func, 0) ThenBlock: {
            PrintMessage(" (in '")
            PrintMessage(Analyzer.max_depth_func)
            PrintMessage("')")
        }
        PrintMessage("\n")
        
        // Check nesting limit
        IfCondition GreaterThan(Analyzer.max_block_depth, Analyzer.max_nesting) ThenBlock: {
            msg = StringConcat("Max nesting depth ", NumberToString(Analyzer.max_block_depth))
            msg = StringConcat(msg, " exceeds limit of ")
            msg = StringConcat(msg, NumberToString(Analyzer.max_nesting))
            Analyzer.AddWarning(msg)
        }
        
        PrintMessage("\n")
        
        // Errors
        IfCondition GreaterThan(Analyzer.error_count, 0) ThenBlock: {
            PrintMessage("========================================\n")
            PrintMessage("ERRORS (")
            PrintNumber(Analyzer.error_count)
            PrintMessage("):\n")
            PrintMessage("========================================\n")
            
            i = 0
            WhileLoop LessThan(i, Analyzer.error_count) {
                msg = XArray.XGet(Analyzer.errors, i)
                PrintMessage("  [ERROR] ")
                PrintMessage(msg)
                PrintMessage("\n")
                i = Add(i, 1)
            }
            PrintMessage("\n")
        }
        
        // Warnings
        IfCondition GreaterThan(Analyzer.warning_count, 0) ThenBlock: {
            PrintMessage("========================================\n")
            PrintMessage("WARNINGS (")
            PrintNumber(Analyzer.warning_count)
            PrintMessage("):\n")
            PrintMessage("========================================\n")
            
            i = 0
            WhileLoop LessThan(i, Analyzer.warning_count) {
                msg = XArray.XGet(Analyzer.warnings, i)
                PrintMessage("  [WARN] ")
                PrintMessage(msg)
                PrintMessage("\n")
                i = Add(i, 1)
            }
            PrintMessage("\n")
        }
        
        // Summary
        PrintMessage("========================================\n")
        IfCondition And(EqualTo(Analyzer.error_count, 0), EqualTo(Analyzer.warning_count, 0)) ThenBlock: {
            PrintMessage("  No issues found!\n")
        } ElseBlock: {
            PrintMessage("  Summary: ")
            PrintNumber(Analyzer.error_count)
            PrintMessage(" error(s), ")
            PrintNumber(Analyzer.warning_count)
            PrintMessage(" warning(s)\n")
        }
        PrintMessage("========================================\n\n")
    }
}

// =============================================================================
// CLEANUP
// =============================================================================
Function.Analyzer.Cleanup {
    Body: {
        IfCondition NotEqual(Analyzer.warnings, 0) ThenBlock: {
            XArray.XDestroy(Analyzer.warnings)
            Analyzer.warnings = 0
        }
        IfCondition NotEqual(Analyzer.errors, 0) ThenBlock: {
            XArray.XDestroy(Analyzer.errors)
            Analyzer.errors = 0
        }
        IfCondition NotEqual(Analyzer.func_alloc_vars, 0) ThenBlock: {
            XArray.XDestroy(Analyzer.func_alloc_vars)
            Analyzer.func_alloc_vars = 0
        }
        IfCondition NotEqual(Analyzer.func_alloc_lines, 0) ThenBlock: {
            XArray.XDestroy(Analyzer.func_alloc_lines)
            Analyzer.func_alloc_lines = 0
        }
        IfCondition NotEqual(Analyzer.func_dealloc_vars, 0) ThenBlock: {
            XArray.XDestroy(Analyzer.func_dealloc_vars)
            Analyzer.func_dealloc_vars = 0
        }
        IfCondition NotEqual(Analyzer.func_dealloc_lines, 0) ThenBlock: {
            XArray.XDestroy(Analyzer.func_dealloc_lines)
            Analyzer.func_dealloc_lines = 0
        }
        IfCondition NotEqual(Analyzer.func_returned_vars, 0) ThenBlock: {
            XArray.XDestroy(Analyzer.func_returned_vars)
            Analyzer.func_returned_vars = 0
        }
        IfCondition NotEqual(Analyzer.func_assigned_vars, 0) ThenBlock: {
            XArray.XDestroy(Analyzer.func_assigned_vars)
            Analyzer.func_assigned_vars = 0
        }
        IfCondition NotEqual(Analyzer.func_used_vars, 0) ThenBlock: {
            XArray.XDestroy(Analyzer.func_used_vars)
            Analyzer.func_used_vars = 0
        }
        IfCondition NotEqual(Analyzer.defined_funcs, 0) ThenBlock: {
            XArray.XDestroy(Analyzer.defined_funcs)
            Analyzer.defined_funcs = 0
        }
        IfCondition NotEqual(Analyzer.called_funcs, 0) ThenBlock: {
            XArray.XDestroy(Analyzer.called_funcs)
            Analyzer.called_funcs = 0
        }
        IfCondition NotEqual(Analyzer.func_call_counts, 0) ThenBlock: {
            XArray.XDestroy(Analyzer.func_call_counts)
            Analyzer.func_call_counts = 0
        }
        
        Analyzer.warning_count = 0
        Analyzer.error_count = 0
    }
}

// =============================================================================
// CONFIGURATION
// =============================================================================
Function.Analyzer.Enable {
    Body: {
        Analyzer.enabled = 1
    }
}

Function.Analyzer.Disable {
    Body: {
        Analyzer.enabled = 0
    }
}

Function.Analyzer.SetVerbose {
    Input: val: Integer
    Body: {
        Analyzer.verbose = val
    }
}

Function.Analyzer.IsEnabled {
    Output: Integer
    Body: {
        ReturnValue(Analyzer.enabled)
    }
}