// Library.Analyzer2.ailang
// Extended Static Analysis - Control Flow & Type Tracking
// Complements Library.Analyzer.ailang
//
// Features:
//   - Unreachable code detection
//   - Infinite loop detection  
//   - Missing else warnings for functions with Output
//   - Constant expression detection (optimization hints)
//   - Null pointer dereference warnings
//   - Argument count validation
//   - Return value ignored warnings

LibraryImport.Arrays
LibraryImport.Compiler.Frontend.AST.CASTCore
LibraryImport.Compiler.Frontend.AST.CASTTypes
LibraryImport.Compiler.Import.CFileMap

// =============================================================================
// ANALYZER2 STATE
// =============================================================================
FixedPool.Analyzer2 {
    // Control flow state
    "unreachable_warnings": Initialize=0, CanChange=True
    "infinite_loop_warnings": Initialize=0, CanChange=True
    "missing_else_warnings": Initialize=0, CanChange=True
    
    // Type tracking (per function)
    "var_types": Initialize=0, CanChange=True       // XArray of var names
    "var_type_vals": Initialize=0, CanChange=True   // XArray of type constants
    
    // Function signatures (global)
    "func_names": Initialize=0, CanChange=True
    "func_param_counts": Initialize=0, CanChange=True
    "func_has_output": Initialize=0, CanChange=True
    "func_def_lines": Initialize=0, CanChange=True
    
    // Null tracking
    "possibly_null_vars": Initialize=0, CanChange=True
    "checked_null_vars": Initialize=0, CanChange=True
    
    // Constant propagation hints
    "const_vars": Initialize=0, CanChange=True
    "const_values": Initialize=0, CanChange=True
    
    // Results
    "warnings": Initialize=0, CanChange=True
    "hints": Initialize=0, CanChange=True
    "warning_count": Initialize=0, CanChange=True
    "hint_count": Initialize=0, CanChange=True
    
    // Current context
    "current_func": Initialize=0, CanChange=True
    "current_func_has_output": Initialize=0, CanChange=True
    "after_terminator": Initialize=0, CanChange=True
    "in_loop": Initialize=0, CanChange=True
    "last_valid_line": Initialize=0, CanChange=True
    "loop_has_break": Initialize=0, CanChange=True
    "loop_has_condition_var": Initialize=0, CanChange=True
    
    // Config
    "check_unreachable": Initialize=1, CanChange=True
    "check_infinite_loops": Initialize=1, CanChange=True
    "check_missing_else": Initialize=1, CanChange=True
    "check_null_deref": Initialize=1, CanChange=True
    "check_arg_counts": Initialize=1, CanChange=True
    "check_ignored_return": Initialize=1, CanChange=True
    "check_excessive_arity": Initialize=1, CanChange=True
    "check_duplicate_symbol": Initialize=1, CanChange=True
    "check_multi_output": Initialize=1, CanChange=True
    "emit_const_hints": Initialize=1, CanChange=True
    "verbose": Initialize=0, CanChange=True

    // Thresholds
    "max_func_arity": Initialize=6, CanChange=True

    // Counters
    "arity_warnings": Initialize=0, CanChange=True
    "duplicate_warnings": Initialize=0, CanChange=True
    "multi_output_warnings": Initialize=0, CanChange=True
}

// =============================================================================
// TYPE CONSTANTS
// =============================================================================
FixedPool.VarType {
    "UNKNOWN": Initialize=0
    "INTEGER": Initialize=1
    "ADDRESS": Initialize=2
    "STRING": Initialize=3
    "BOOLEAN": Initialize=4
    "NULLABLE": Initialize=5
}

// =============================================================================
// INITIALIZATION
// =============================================================================
Function.Analyzer2.Init {
    Body: {
        Analyzer2.warnings = Array.Create(128)
        Analyzer2.hints = Array.Create(64)
        Analyzer2.warning_count = 0
        Analyzer2.hint_count = 0
        
        // Type tracking
        Analyzer2.var_types = Array.Create(64)
        Analyzer2.var_type_vals = Array.Create(64)
        
        // Function signatures
        Analyzer2.func_names = Array.Create(256)
        Analyzer2.func_param_counts = Array.Create(256)
        Analyzer2.func_has_output = Array.Create(256)
        Analyzer2.func_def_lines = Array.Create(256)
        
        // Null tracking
        Analyzer2.possibly_null_vars = Array.Create(32)
        Analyzer2.checked_null_vars = Array.Create(32)
        
        // Constant tracking
        Analyzer2.const_vars = Array.Create(32)
        Analyzer2.const_values = Array.Create(32)
        
        // Reset state
        Analyzer2.current_func = 0
        Analyzer2.current_func_has_output = 0
        Analyzer2.after_terminator = 0
        Analyzer2.in_loop = 0
        Analyzer2.loop_has_break = 0
        Analyzer2.last_valid_line = 0
        
        Analyzer2.unreachable_warnings = 0
        Analyzer2.infinite_loop_warnings = 0
        Analyzer2.missing_else_warnings = 0
        Analyzer2.arity_warnings = 0
        Analyzer2.duplicate_warnings = 0
        Analyzer2.multi_output_warnings = 0
    }
}

// =============================================================================
// DIAGNOSTICS
// =============================================================================
Function.Analyzer2.AddWarning {
    Input: msg: Address
    Body: {
        // Deduplicate: Check if message already exists
        count = Array.Size(Analyzer2.warnings)
        i = 0
        WhileLoop LessThan(i, count) {
            existing = Array.Get(Analyzer2.warnings, i)
            IfCondition EqualTo(StringCompare(existing, msg), 0) ThenBlock: { ReturnValue(0) }
            i = Add(i, 1)
        }
        
        Array.Push(Analyzer2.warnings, msg)
        Analyzer2.warning_count = Add(Analyzer2.warning_count, 1)
    }
}

Function.Analyzer2.AddHint {
    Input: msg: Address
    Body: {
        // Deduplicate
        count = Array.Size(Analyzer2.hints)
        i = 0
        WhileLoop LessThan(i, count) {
            existing = Array.Get(Analyzer2.hints, i)
            IfCondition EqualTo(StringCompare(existing, msg), 0) ThenBlock: { ReturnValue(0) }
            i = Add(i, 1)
        }
        
        Array.Push(Analyzer2.hints, msg)
        Analyzer2.hint_count = Add(Analyzer2.hint_count, 1)
    }
}

// =============================================================================
// STRING HELPERS
// =============================================================================
Function.Analyzer2.StrEqual {
    Input: a: Address
    Input: b: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(a, 0) ThenBlock: {
            IfCondition EqualTo(b, 0) ThenBlock: { ReturnValue(1) }
            ReturnValue(0)
        }
        IfCondition EqualTo(b, 0) ThenBlock: { ReturnValue(0) }
        cmp = StringCompare(a, b)
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

// =============================================================================
// TYPE TRACKING
// =============================================================================
Function.Analyzer2.SetVarType {
    Input: name: Address
    Input: vtype: Integer
    Body: {
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }
        
        // Check if already tracked
        count = Array.Size(Analyzer2.var_types)
        i = 0
        WhileLoop LessThan(i, count) {
            existing = Array.Get(Analyzer2.var_types, i)
            IfCondition EqualTo(Analyzer2.StrEqual(existing, name), 1) ThenBlock: {
                // Update existing
                Array.Set(Analyzer2.var_type_vals, i, vtype)
                ReturnValue(0)
            }
            i = Add(i, 1)
        }
        
        // Add new
        Array.Push(Analyzer2.var_types, name)
        Array.Push(Analyzer2.var_type_vals, vtype)
    }
}

Function.Analyzer2.GetVarType {
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(VarType.UNKNOWN) }
        
        count = Array.Size(Analyzer2.var_types)
        i = 0
        WhileLoop LessThan(i, count) {
            existing = Array.Get(Analyzer2.var_types, i)
            IfCondition EqualTo(Analyzer2.StrEqual(existing, name), 1) ThenBlock: {
                ReturnValue(Array.Get(Analyzer2.var_type_vals, i))
            }
            i = Add(i, 1)
        }
        ReturnValue(VarType.UNKNOWN)
    }
}

Function.Analyzer2.ClearVarTypes {
    Body: {
        Array.Clear(Analyzer2.var_types)
        Array.Clear(Analyzer2.var_type_vals)
    }
}

// =============================================================================
// NULL TRACKING
// =============================================================================
Function.Analyzer2.MarkPossiblyNull {
    Input: name: Address
    Body: {
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }
        
        // Check if already tracked
        count = Array.Size(Analyzer2.possibly_null_vars)
        i = 0
        WhileLoop LessThan(i, count) {
            existing = Array.Get(Analyzer2.possibly_null_vars, i)
            IfCondition EqualTo(Analyzer2.StrEqual(existing, name), 1) ThenBlock: {
                ReturnValue(0)
            }
            i = Add(i, 1)
        }
        Array.Push(Analyzer2.possibly_null_vars, name)
    }
}

Function.Analyzer2.MarkNullChecked {
    Input: name: Address
    Body: {
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }
        
        count = Array.Size(Analyzer2.checked_null_vars)
        i = 0
        WhileLoop LessThan(i, count) {
            existing = Array.Get(Analyzer2.checked_null_vars, i)
            IfCondition EqualTo(Analyzer2.StrEqual(existing, name), 1) ThenBlock: {
                ReturnValue(0)
            }
            i = Add(i, 1)
        }
        Array.Push(Analyzer2.checked_null_vars, name)
    }
}

Function.Analyzer2.IsNullChecked {
    Input: name: Address
    Output: Integer
    Body: {
        count = Array.Size(Analyzer2.checked_null_vars)
        i = 0
        WhileLoop LessThan(i, count) {
            existing = Array.Get(Analyzer2.checked_null_vars, i)
            IfCondition EqualTo(Analyzer2.StrEqual(existing, name), 1) ThenBlock: {
                ReturnValue(1)
            }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

Function.Analyzer2.IsPossiblyNull {
    Input: name: Address
    Output: Integer
    Body: {
        count = Array.Size(Analyzer2.possibly_null_vars)
        i = 0
        WhileLoop LessThan(i, count) {
            existing = Array.Get(Analyzer2.possibly_null_vars, i)
            IfCondition EqualTo(Analyzer2.StrEqual(existing, name), 1) ThenBlock: {
                ReturnValue(1)
            }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

Function.Analyzer2.ClearNullTracking {
    Body: {
        Array.Clear(Analyzer2.possibly_null_vars)
        Array.Clear(Analyzer2.checked_null_vars)
    }
}

// =============================================================================
// FUNCTION SIGNATURE TRACKING
// =============================================================================
Function.Analyzer2.RegisterFunction {
    Input: name: Address
    Input: param_count: Integer
    Input: has_output: Integer
    Input: line: Integer
    Body: {
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }

        // Duplicate-symbol check: same Function.X / SubRoutine.X defined
        // twice in the same file. Compiler's behavior on duplicates is
        // unpredictable (Library.Item.ailang had 9 Item_Get* accessors
        // defined twice, causing the "E for equip" segfault). We still
        // bail after warning so the arity check below doesn't fire
        // twice for the same name.
        count = Array.Size(Analyzer2.func_names)
        i = 0
        WhileLoop LessThan(i, count) {
            existing = Array.Get(Analyzer2.func_names, i)
            IfCondition EqualTo(Analyzer2.StrEqual(existing, name), 1) ThenBlock: {
                IfCondition EqualTo(Analyzer2.check_duplicate_symbol, 1) ThenBlock: {
                    first_line = Array.Get(Analyzer2.func_def_lines, i)
                    first_loc = FileMap_Format(first_line)
                    dup_loc = FileMap_Format(line)
                    msg = dup_loc
                    msg = StringConcat(msg, ": duplicate definition of '")
                    msg = StringConcat(msg, name)
                    msg = StringConcat(msg, "' (first seen at ")
                    msg = StringConcat(msg, first_loc)
                    msg = StringConcat(msg, ") — compiler's choice between copies is unpredictable")
                    Analyzer2.AddWarning(msg)
                    Analyzer2.duplicate_warnings = Add(Analyzer2.duplicate_warnings, 1)
                }
                ReturnValue(0)
            }
            i = Add(i, 1)
        }
        
        Array.Push(Analyzer2.func_names, name)
        Array.Push(Analyzer2.func_param_counts, param_count)
        Array.Push(Analyzer2.func_has_output, has_output)
        Array.Push(Analyzer2.func_def_lines, line)

        // Arity check — function/subroutine has too many inputs.
        // Usual refactor: group related params into a FixedPool/struct
        // and pass the pool instead.
        IfCondition EqualTo(Analyzer2.check_excessive_arity, 1) ThenBlock: {
            IfCondition GreaterThan(param_count, Analyzer2.max_func_arity) ThenBlock: {
                location = FileMap_Format(line)
                msg = location
                msg = StringConcat(msg, ": '")
                msg = StringConcat(msg, name)
                msg = StringConcat(msg, "' has ")
                msg = StringConcat(msg, NumberToString(param_count))
                msg = StringConcat(msg, " inputs (threshold ")
                msg = StringConcat(msg, NumberToString(Analyzer2.max_func_arity))
                msg = StringConcat(msg, ") — consider grouping into a FixedPool")
                Analyzer2.AddWarning(msg)
                Analyzer2.arity_warnings = Add(Analyzer2.arity_warnings, 1)
            }
        }
    }
}

Function.Analyzer2.GetFuncParamCount {
    Input: name: Address
    Output: Integer
    Body: {
        count = Array.Size(Analyzer2.func_names)
        i = 0
        WhileLoop LessThan(i, count) {
            existing = Array.Get(Analyzer2.func_names, i)
            IfCondition EqualTo(Analyzer2.StrEqual(existing, name), 1) ThenBlock: {
                ReturnValue(Array.Get(Analyzer2.func_param_counts, i))
            }
            i = Add(i, 1)
        }
        ReturnValue(-1)  // Unknown
    }
}

Function.Analyzer2.FuncHasOutput {
    Input: name: Address
    Output: Integer
    Body: {
        count = Array.Size(Analyzer2.func_names)
        i = 0
        WhileLoop LessThan(i, count) {
            existing = Array.Get(Analyzer2.func_names, i)
            IfCondition EqualTo(Analyzer2.StrEqual(existing, name), 1) ThenBlock: {
                ReturnValue(Array.Get(Analyzer2.func_has_output, i))
            }
            i = Add(i, 1)
        }
        ReturnValue(-1)  // Unknown
    }
}

// =============================================================================
// CONSTANT EXPRESSION DETECTION
// =============================================================================
Function.Analyzer2.IsConstantExpr {
    Input: node: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        
        node_type = AST_GetType(node)
        
        // Literals are constant
        IfCondition EqualTo(node_type, AST.NUMBER) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(node_type, AST.STRING) ThenBlock: { ReturnValue(1) }
        
        // Check if it's a pure math call with constant args
        IfCondition EqualTo(node_type, AST.CALL) ThenBlock: {
            func_name = AST_GetData1(node)
            is_pure = Analyzer2.IsPureMathFunc(func_name)
            IfCondition EqualTo(is_pure, 0) ThenBlock: { ReturnValue(0) }
            
            // Check all args are constant
            child_count = AST_GetChildCount(node)
            i = 0
            WhileLoop LessThan(i, child_count) {
                child = AST_GetChild(node, i)
                IfCondition EqualTo(Analyzer2.IsConstantExpr(child), 0) ThenBlock: {
                    ReturnValue(0)
                }
                i = Add(i, 1)
            }
            ReturnValue(1)
        }
        
        ReturnValue(0)
    }
}

Function.Analyzer2.IsPureMathFunc {
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }
        
        IfCondition EqualTo(StringCompare(name, "Add"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "Subtract"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "Multiply"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "Divide"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "Modulo"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "BitwiseAnd"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "BitwiseOr"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "BitwiseXor"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "ShiftLeft"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "ShiftRight"), 0) ThenBlock: { ReturnValue(1) }
        
        ReturnValue(0)
    }
}

// =============================================================================
// PASS 1: COLLECT FUNCTION SIGNATURES
// =============================================================================
Function.Analyzer2.CollectSignatures {
    Input: node: Address
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        
        node_type = AST_GetType(node)
        node_line = AST_GetLine(node)
        
        IfCondition EqualTo(node_type, AST.FUNCTION) ThenBlock: {
            name = AST_GetData1(node)
            param_count = 0
            output_count = 0

            child_count = AST_GetChildCount(node)
            i = 0
            WhileLoop LessThan(i, child_count) {
                child = AST_GetChild(node, i)
                IfCondition NotEqual(child, 0) ThenBlock: {
                    child_type = AST_GetType(child)
                    IfCondition EqualTo(child_type, AST.PARAMETER) ThenBlock: {
                        param_count = Add(param_count, 1)
                    }
                    IfCondition EqualTo(child_type, AST.OUTPUT_DECL) ThenBlock: {
                        output_count = Add(output_count, 1)
                    }
                }
                i = Add(i, 1)
            }

            // Multiple-Output check: a refactor that left two Output:
            // lines on the same function compiles but produces
            // undefined behavior. Flag it.
            IfCondition And(EqualTo(Analyzer2.check_multi_output, 1), GreaterThan(output_count, 1)) ThenBlock: {
                location = FileMap_Format(node_line)
                msg = location
                msg = StringConcat(msg, ": '")
                IfCondition NotEqual(name, 0) ThenBlock: {
                    msg = StringConcat(msg, name)
                }
                msg = StringConcat(msg, "' has ")
                msg = StringConcat(msg, NumberToString(output_count))
                msg = StringConcat(msg, " Output: declarations — only the first is well-defined")
                Analyzer2.AddWarning(msg)
                Analyzer2.multi_output_warnings = Add(Analyzer2.multi_output_warnings, 1)
            }

            has_output = 0
            IfCondition GreaterThan(output_count, 0) ThenBlock: { has_output = 1 }
            Analyzer2.RegisterFunction(name, param_count, has_output, node_line)
        }
        
        IfCondition EqualTo(node_type, AST.SUBROUTINE) ThenBlock: {
            name = AST_GetData1(node)
            param_count = 0
            
            child_count = AST_GetChildCount(node)
            i = 0
            WhileLoop LessThan(i, child_count) {
                child = AST_GetChild(node, i)
                IfCondition NotEqual(child, 0) ThenBlock: {
                    child_type = AST_GetType(child)
                    IfCondition EqualTo(child_type, AST.PARAMETER) ThenBlock: {
                        param_count = Add(param_count, 1)
                    }
                }
                i = Add(i, 1)
            }
            
            Analyzer2.RegisterFunction(name, param_count, 0, node_line)
        }
        
        // Recurse into children
        child_count = AST_GetChildCount(node)
        i = 0
        WhileLoop LessThan(i, child_count) {
            child = AST_GetChild(node, i)
            Analyzer2.CollectSignatures(child)
            i = Add(i, 1)
        }
    }
}

// =============================================================================
// MAIN WALK
// =============================================================================
Function.Analyzer2.WalkNode {
    Input: node: Address
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        
        node_type = AST_GetType(node)
        node_line = AST_GetLine(node)
        
        // Fix for "Line 0" issues: propagate last known valid line
        IfCondition GreaterThan(node_line, 0) ThenBlock: {
            Analyzer2.last_valid_line = node_line
        } ElseBlock: {
            node_line = Analyzer2.last_valid_line
        }
        
        // PrintMessage("[W:") PrintNumber(node_type) PrintMessage("]")
        // IfCondition EqualTo(Analyzer2.after_terminator, 1) ThenBlock: {
        //     PrintMessage("[Term]")
        // }
        
        
        // === CHECK: Unreachable code ===
        is_declaration = 0
        IfCondition EqualTo(node_type, AST.FUNCTION) ThenBlock: { is_declaration = 1 }
        IfCondition EqualTo(node_type, AST.SUBROUTINE) ThenBlock: { is_declaration = 1 }
        IfCondition EqualTo(node_type, AST.POOL_FIXED) ThenBlock: { is_declaration = 1 }
        IfCondition EqualTo(node_type, AST.POOL_DYNAMIC) ThenBlock: { is_declaration = 1 }
        IfCondition EqualTo(node_type, AST.POOL_TEMPORAL) ThenBlock: { is_declaration = 1 }
        IfCondition EqualTo(node_type, AST.POOL_NEURAL) ThenBlock: { is_declaration = 1 }
        IfCondition EqualTo(node_type, AST.POOL_KERNEL) ThenBlock: { is_declaration = 1 }
        IfCondition EqualTo(node_type, AST.POOL_ACTOR) ThenBlock: { is_declaration = 1 }
        IfCondition EqualTo(node_type, AST.POOL_SECURITY) ThenBlock: { is_declaration = 1 }
        IfCondition EqualTo(node_type, AST.POOL_CONSTRAINED) ThenBlock: { is_declaration = 1 }
        IfCondition EqualTo(node_type, AST.POOL_FILE) ThenBlock: { is_declaration = 1 }
        IfCondition EqualTo(node_type, AST.POOL_LINKAGE) ThenBlock: { is_declaration = 1 }
        IfCondition EqualTo(node_type, AST.PROGRAM) ThenBlock: { is_declaration = 1 }
        IfCondition EqualTo(node_type, AST.LIBRARY_IMPORT) ThenBlock: { is_declaration = 1 }
        IfCondition EqualTo(node_type, AST.ACRONYM_DEFS) ThenBlock: { is_declaration = 1 }
        IfCondition EqualTo(node_type, AST.MODULE) ThenBlock: { is_declaration = 1 }
        IfCondition EqualTo(node_type, AST.EXPORT) ThenBlock: { is_declaration = 1 }
        IfCondition EqualTo(node_type, AST.LOOP_MAIN) ThenBlock: { is_declaration = 1 }
        IfCondition EqualTo(node_type, AST.LOOP_ACTOR) ThenBlock: { is_declaration = 1 }
        IfCondition EqualTo(node_type, AST.LOOP_START) ThenBlock: { is_declaration = 1 }
        IfCondition EqualTo(node_type, AST.MACRO_DEFINE) ThenBlock: { is_declaration = 1 }

        // Reset terminator state on declarations — module boundaries are not unreachable
        IfCondition EqualTo(is_declaration, 1) ThenBlock: {
            Analyzer2.after_terminator = 0
        }
        
        
        IfCondition EqualTo(Analyzer2.check_unreachable, 1) ThenBlock: {
            IfCondition EqualTo(Analyzer2.after_terminator, 1) ThenBlock: {
                IfCondition EqualTo(is_declaration, 0) ThenBlock: {
                    location = FileMap_Format(node_line)
                    msg = location
                    msg = StringConcat(msg, ": Unreachable code after return/break/halt")
                    IfCondition NotEqual(Analyzer2.current_func, 0) ThenBlock: {
                        msg = StringConcat(msg, " in '")
                        msg = StringConcat(msg, Analyzer2.current_func)
                        msg = StringConcat(msg, "'")
                    }
                    Analyzer2.AddWarning(msg)
                    Analyzer2.unreachable_warnings = Add(Analyzer2.unreachable_warnings, 1)
                    // Only warn once per block
                    Analyzer2.after_terminator = 0
                }
            }
        }
        
        // === FUNCTION ENTRY ===
        IfCondition EqualTo(node_type, AST.FUNCTION) ThenBlock: {
            // PrintMessage("[FuncEntry]")
            Analyzer2.current_func = AST_GetData1(node)
            // PrintMessage("[FuncData:") PrintNumber(Analyzer2.current_func) PrintMessage("]")
            Analyzer2.ClearVarTypes()
            // PrintMessage("[ClearVars]")
            Analyzer2.ClearNullTracking()
            // PrintMessage("[ClearNull]")
            Analyzer2.after_terminator = 0
            
            // Check if has Output
            Analyzer2.current_func_has_output = 0
            child_count = AST_GetChildCount(node)
            // PrintMessage("[ChildCount:") PrintNumber(child_count) PrintMessage("]")
            
            i = 0
            WhileLoop LessThan(i, child_count) {
                child = AST_GetChild(node, i)
                IfCondition NotEqual(child, 0) ThenBlock: {
                    child_type = AST_GetType(child)
                    // PrintMessage("[CT:") PrintNumber(child_type) PrintMessage("]")
                    
                    IfCondition EqualTo(child_type, AST.OUTPUT_DECL) ThenBlock: {
                        Analyzer2.current_func_has_output = 1
                    }
                    // Track parameter types
                    IfCondition EqualTo(child_type, AST.PARAMETER) ThenBlock: {
                        // PrintMessage("[Param]")
                        param_name = AST_GetData1(child)
                        // PrintMessage("[Name:") PrintNumber(param_name) PrintMessage("]")
                        param_type_node = AST_GetChild(child, 0)
                        // PrintMessage("[TypeNode:") PrintNumber(param_type_node) PrintMessage("]")
                        
                        // Check for valid node pointer (positive) to avoid error codes like -999999
                        IfCondition GreaterThan(param_type_node, 0) ThenBlock: {
                            ptype = Analyzer2.NodeToVarType(param_type_node)
                            // PrintMessage("[PType:") PrintNumber(ptype) PrintMessage("]")
                            Analyzer2.SetVarType(param_name, ptype)
                            // PrintMessage("[Set]")
                        }
                    }
                }
                i = Add(i, 1)
            }
            
            // PrintMessage("[WalkFuncBody]")
            Analyzer2.WalkChildren(node)
            Analyzer2.current_func = 0
            ReturnValue(0)
        }
        
        // === SUBROUTINE ===
        IfCondition EqualTo(node_type, AST.SUBROUTINE) ThenBlock: {
            Analyzer2.current_func = AST_GetData1(node)
            Analyzer2.current_func_has_output = 0
            Analyzer2.ClearVarTypes()
            Analyzer2.ClearNullTracking()
            Analyzer2.after_terminator = 0
            Analyzer2.WalkChildren(node)
            Analyzer2.current_func = 0
            ReturnValue(0)
        }
        
        // === RETURN - marks code after as unreachable ===
        IfCondition EqualTo(node_type, AST.RETURN) ThenBlock: {
            Analyzer2.WalkChildren(node)        // walk the return expression FIRST
            Analyzer2.after_terminator = 1      // THEN mark as terminated
            ReturnValue(0)
        }
        
        // === HALT - marks code after as unreachable ===
        IfCondition EqualTo(node_type, AST.OP_HALT) ThenBlock: {
            Analyzer2.after_terminator = 1
            ReturnValue(0)
        }
        
        // === BREAK - marks code after as unreachable (in loop) ===
        IfCondition EqualTo(node_type, AST.EXIT_LOOP) ThenBlock: {
            Analyzer2.after_terminator = 1
            Analyzer2.loop_has_break = 1
            ReturnValue(0)
        }
        
        // === WHILE LOOP ===
        IfCondition EqualTo(node_type, AST.WHILE) ThenBlock: {
            // PrintMessage("[While]")
            old_in_loop = Analyzer2.in_loop
            old_has_break = Analyzer2.loop_has_break
            Analyzer2.in_loop = 1
            Analyzer2.loop_has_break = 0
            
            // Check condition
            child_count = AST_GetChildCount(node)
            IfCondition GreaterThan(child_count, 0) ThenBlock: {
                cond = AST_GetChild(node, 0)
                Analyzer2.CheckLoopCondition(cond, node_line)
            }
            
            Analyzer2.WalkChildren(node)
            
            // Check for infinite loop (True condition, no break)
            IfCondition EqualTo(Analyzer2.check_infinite_loops, 1) ThenBlock: {
                IfCondition GreaterThan(child_count, 0) ThenBlock: {
                    cond = AST_GetChild(node, 0)
                    IfCondition EqualTo(Analyzer2.IsAlwaysTrue(cond), 1) ThenBlock: {
                        IfCondition EqualTo(Analyzer2.loop_has_break, 0) ThenBlock: {
                            location = FileMap_Format(node_line)
                            msg = location
                            msg = StringConcat(msg, ": Potential infinite loop (condition always true, no BreakLoop)")
                            IfCondition NotEqual(Analyzer2.current_func, 0) ThenBlock: {
                                msg = StringConcat(msg, " in '")
                                msg = StringConcat(msg, Analyzer2.current_func)
                                msg = StringConcat(msg, "'")
                            }
                            Analyzer2.AddWarning(msg)
                            Analyzer2.infinite_loop_warnings = Add(Analyzer2.infinite_loop_warnings, 1)
                        }
                    }
                }
            }
            
            Analyzer2.in_loop = old_in_loop
            Analyzer2.loop_has_break = old_has_break
            Analyzer2.after_terminator = 0  // After loop, code is reachable
            ReturnValue(0)
        }
        
        // === IF CONDITION ===
        IfCondition EqualTo(node_type, AST.IF) ThenBlock: {
            // PrintMessage("[If]")
            child_count = AST_GetChildCount(node)
            
            // Check for null checks in condition
            IfCondition GreaterThan(child_count, 0) ThenBlock: {
                cond = AST_GetChild(node, 0)
                Analyzer2.ExtractNullChecks(cond)
            }
            
            // Check for missing else when function has Output
            IfCondition EqualTo(Analyzer2.check_missing_else, 1) ThenBlock: {
                IfCondition EqualTo(Analyzer2.current_func_has_output, 1) ThenBlock: {
                    has_else = 0
                    IfCondition GreaterThan(child_count, 2) ThenBlock: {
                        else_block = AST_GetChild(node, 2)
                        IfCondition NotEqual(else_block, 0) ThenBlock: {
                            has_else = 1
                        }
                    }
                    IfCondition EqualTo(has_else, 0) ThenBlock: {
                        // Check if then block contains return
                        IfCondition GreaterThan(child_count, 1) ThenBlock: {
                            then_block = AST_GetChild(node, 1)
                            has_return = Analyzer2.BlockHasReturn(then_block)
                            IfCondition EqualTo(has_return, 1) ThenBlock: {
                                location = FileMap_Format(node_line)
                                msg = location
                                msg = StringConcat(msg, ": IfCondition with ReturnValue but no ElseBlock in '")
                                IfCondition NotEqual(Analyzer2.current_func, 0) ThenBlock: {
                                    msg = StringConcat(msg, Analyzer2.current_func)
                                }
                                msg = StringConcat(msg, "' - may not return on all paths")
                                Analyzer2.AddWarning(msg)
                                Analyzer2.missing_else_warnings = Add(Analyzer2.missing_else_warnings, 1)
                            }
                        }
                    }
                }
            }
            
            Analyzer2.WalkChildren(node)
            Analyzer2.after_terminator = 0  // After if, code is reachable
            ReturnValue(0)
        }
        
        // === ASSIGNMENT ===
        IfCondition EqualTo(node_type, AST.ASSIGNMENT) ThenBlock: {
            target = AST_GetData1(node)
            // PrintMessage(" [Assign T:") PrintNumber(target) PrintMessage("]")
            child_count = AST_GetChildCount(node)
            
            IfCondition GreaterThan(child_count, 0) ThenBlock: {
                value = AST_GetChild(node, 0)
                // PrintMessage(" [Val:") PrintNumber(value) PrintMessage("]")
                
                // Track type from RHS
                // PrintMessage(" [Infer]")
                rhs_type = Analyzer2.InferType(value)
                // PrintMessage(" [Type:") PrintNumber(rhs_type) PrintMessage("]")
                
                // PrintMessage(" [SetVar]")
                Analyzer2.SetVarType(target, rhs_type)
                
                // Check if assigning from nullable source
                // Skip fixed-size Allocate calls — they never fail in practice
                // Clear null status when reassigned from non-nullable source
                is_nullable_assign = 0
                IfCondition EqualTo(AST_GetType(value), AST.CALL) ThenBlock: {
                    func_name = AST_GetData1(value)
                    IfCondition EqualTo(Analyzer2.IsNullableFunc(func_name), 1) ThenBlock: {
                        is_nullable_assign = 1
                        should_mark = 1
                        IfCondition NotEqual(func_name, 0) ThenBlock: {
                            IfCondition EqualTo(StringCompare(func_name, "Allocate"), 0) ThenBlock: {
                                alloc_child_count = AST_GetChildCount(value)
                                IfCondition GreaterThan(alloc_child_count, 0) ThenBlock: {
                                    alloc_arg = AST_GetChild(value, 0)
                                    IfCondition NotEqual(alloc_arg, 0) ThenBlock: {
                                        IfCondition EqualTo(AST_GetType(alloc_arg), AST.NUMBER) ThenBlock: {
                                            should_mark = 0
                                        }
                                    }
                                }
                            }
                        }
                        IfCondition EqualTo(should_mark, 1) ThenBlock: {
                            Analyzer2.MarkPossiblyNull(target)
                        }
                    }
                }
                IfCondition EqualTo(is_nullable_assign, 0) ThenBlock: {
                    Analyzer2.ClearPossiblyNull(target)
                }

                // Check for constant expression hint
                IfCondition EqualTo(Analyzer2.emit_const_hints, 1) ThenBlock: {
                    IfCondition EqualTo(Analyzer2.IsConstantExpr(value), 1) ThenBlock: {
                        IfCondition NotEqual(AST_GetType(value), AST.NUMBER) ThenBlock: {
                            IfCondition NotEqual(AST_GetType(value), AST.STRING) ThenBlock: {
                                location = FileMap_Format(node_line)
                                msg = location
                                msg = StringConcat(msg, ": Expression could be evaluated at compile time")
                                Analyzer2.AddHint(msg)
                            }
                        }
                    }
                }
                
                Analyzer2.WalkNode(value)
            }
            ReturnValue(0)
        }
        
        // === FUNCTION CALL ===
        IfCondition EqualTo(node_type, AST.CALL) ThenBlock: {
            // PrintMessage("[Call]")
            func_name = AST_GetData1(node)
            child_count = AST_GetChildCount(node)
            
            // Check argument count
            IfCondition EqualTo(Analyzer2.check_arg_counts, 1) ThenBlock: {
                expected = Analyzer2.GetFuncParamCount(func_name)
                IfCondition NotEqual(expected, -1) ThenBlock: {
                    IfCondition NotEqual(child_count, expected) ThenBlock: {
                        location = FileMap_Format(node_line)
                        msg = location
                        msg = StringConcat(msg, ": '")
                        IfCondition NotEqual(func_name, 0) ThenBlock: {
                            msg = StringConcat(msg, func_name)
                        }
                        msg = StringConcat(msg, "' expects ")
                        msg = StringConcat(msg, NumberToString(expected))
                        msg = StringConcat(msg, " args, got ")
                        msg = StringConcat(msg, NumberToString(child_count))
                        Analyzer2.AddWarning(msg)
                    }
                }
            }
            
            // Check for null dereference
            IfCondition EqualTo(Analyzer2.check_null_deref, 1) ThenBlock: {
                IfCondition EqualTo(Analyzer2.IsDereferenceFunc(func_name), 1) ThenBlock: {
                    IfCondition GreaterThan(child_count, 0) ThenBlock: {
                        arg = AST_GetChild(node, 0)
                        IfCondition EqualTo(AST_GetType(arg), AST.IDENTIFIER) ThenBlock: {
                            arg_name = AST_GetData1(arg)
                            IfCondition EqualTo(Analyzer2.IsPossiblyNull(arg_name), 1) ThenBlock: {
                                IfCondition EqualTo(Analyzer2.IsNullChecked(arg_name), 0) ThenBlock: {
                                    location = FileMap_Format(node_line)
                                    msg = location
                                    msg = StringConcat(msg, ": Potential null dereference of '")
                                    IfCondition NotEqual(arg_name, 0) ThenBlock: {
                                        msg = StringConcat(msg, arg_name)
                                    }
                                    msg = StringConcat(msg, "' without null check")
                                    IfCondition NotEqual(Analyzer2.current_func, 0) ThenBlock: {
                                        msg = StringConcat(msg, " in '")
                                        msg = StringConcat(msg, Analyzer2.current_func)
                                        msg = StringConcat(msg, "'")
                                    }
                                    Analyzer2.AddWarning(msg)
                                }
                            }
                        }
                    }
                }
            }
            
            Analyzer2.WalkChildren(node)
            ReturnValue(0)
        }
        
        // === DEFAULT: recurse ===
        // PrintMessage("[Def]")
        Analyzer2.WalkChildren(node)
    }
}

Function.Analyzer2.WalkChildren {
    Input: node: Address
    Body: {
        // PrintMessage("[WC]")
        child_count = AST_GetChildCount(node)
        i = 0
        WhileLoop LessThan(i, child_count) {
            child = AST_GetChild(node, i)
            // PrintMessage("[C:") PrintNumber(i) PrintMessage("]")
            Analyzer2.WalkNode(child)
            i = Add(i, 1)
        }
        // PrintMessage("[/WC]")
    }
}

// =============================================================================
// HELPER FUNCTIONS
// =============================================================================
Function.Analyzer2.IsAlwaysTrue {
    Input: node: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        
        node_type = AST_GetType(node)
        
        // Check for True identifier
        IfCondition EqualTo(node_type, AST.IDENTIFIER) ThenBlock: {
            name = AST_GetData1(node)
            IfCondition NotEqual(name, 0) ThenBlock: {
                IfCondition EqualTo(StringCompare(name, "True"), 0) ThenBlock: {
                    ReturnValue(1)
                }
            }
        }
        
        // Check for number 1
        IfCondition EqualTo(node_type, AST.NUMBER) ThenBlock: {
            val = AST_GetData1(node)
            IfCondition NotEqual(val, 0) ThenBlock: {
                num = StringToNumber(val)
                IfCondition EqualTo(num, 1) ThenBlock: {
                    ReturnValue(1)
                }
            }
        }
        
        ReturnValue(0)
    }
}

Function.Analyzer2.BlockHasReturn {
    Input: block: Address
    Output: Integer
    Body: {
        // PrintMessage("[BHR]")
        IfCondition EqualTo(block, 0) ThenBlock: { ReturnValue(0) }
        
        block_type = AST_GetType(block)
        IfCondition EqualTo(block_type, AST.RETURN) ThenBlock: { ReturnValue(1) }
        
        child_count = AST_GetChildCount(block)
        i = 0
        WhileLoop LessThan(i, child_count) {
            child = AST_GetChild(block, i)
            IfCondition EqualTo(Analyzer2.BlockHasReturn(child), 1) ThenBlock: {
                ReturnValue(1)
            }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

Function.Analyzer2.CheckLoopCondition {
    Input: cond: Address
    Input: line: Integer
    Body: {
        // Placeholder for more complex loop analysis
        // Could track which variables affect the condition
        
        // Silence unused variable warnings
        IfCondition EqualTo(cond, 0) ThenBlock: { }
        IfCondition EqualTo(line, 0) ThenBlock: { }
    }
}

Function.Analyzer2.ExtractNullChecks {
    Input: cond: Address
    Body: {
        // PrintMessage("[ENC]")
        IfCondition EqualTo(cond, 0) ThenBlock: { ReturnValue(0) }
        
        cond_type = AST_GetType(cond)
        
        // Look for EqualTo(var, 0) or NotEqual(var, 0)
        IfCondition EqualTo(cond_type, AST.CALL) ThenBlock: {
            func_name = AST_GetData1(cond)
            IfCondition NotEqual(func_name, 0) ThenBlock: {
                is_eq = StringCompare(func_name, "EqualTo")
                is_neq = StringCompare(func_name, "NotEqual")
                
                IfCondition Or(EqualTo(is_eq, 0), EqualTo(is_neq, 0)) ThenBlock: {
                    child_count = AST_GetChildCount(cond)
                    IfCondition EqualTo(child_count, 2) ThenBlock: {
                        arg0 = AST_GetChild(cond, 0)
                        arg1 = AST_GetChild(cond, 1)
                        
                        // Check if comparing identifier to 0
                        IfCondition EqualTo(AST_GetType(arg0), AST.IDENTIFIER) ThenBlock: {
                            IfCondition EqualTo(AST_GetType(arg1), AST.NUMBER) ThenBlock: {
                                val = AST_GetData1(arg1)
                                IfCondition NotEqual(val, 0) ThenBlock: {
                                    num = StringToNumber(val)
                                    IfCondition EqualTo(num, 0) ThenBlock: {
                                        var_name = AST_GetData1(arg0)
                                        Analyzer2.MarkNullChecked(var_name)
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

Function.Analyzer2.IsNullableFunc {
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }
        
        // Functions that can return 0/null
        IfCondition EqualTo(StringCompare(name, "Allocate"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "ArrayCreate"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "Array.Create"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "Array.Get"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "Sem_Lookup"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "AST_GetChild"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "AST_GetData1"), 0) ThenBlock: { ReturnValue(1) }
        
        ReturnValue(0)
    }
}

Function.Analyzer2.ClearPossiblyNull {
    Input: name: Address
    Body: {
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }
        
        count = Array.Size(Analyzer2.possibly_null_vars)
        i = 0
        WhileLoop LessThan(i, count) {
            existing = Array.Get(Analyzer2.possibly_null_vars, i)
            IfCondition EqualTo(Analyzer2.StrEqual(existing, name), 1) ThenBlock: {
                Array.Set(Analyzer2.possibly_null_vars, i, 0)
                ReturnValue(0)
            }
            i = Add(i, 1)
        }
    }
}


Function.Analyzer2.IsDereferenceFunc {
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }
        
        IfCondition EqualTo(StringCompare(name, "Dereference"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "GetByte"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "SetByte"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "ArrayGet"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "ArraySet"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "StringLength"), 0) ThenBlock: { ReturnValue(1) }
        
        ReturnValue(0)
    }
}

Function.Analyzer2.InferType {
    Input: node: Address
    Output: Integer
    Body: {
        // PrintMessage(" [IT:") PrintNumber(node) PrintMessage("]")
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(VarType.UNKNOWN) }
        
        node_type = AST_GetType(node)
        
        IfCondition EqualTo(node_type, AST.NUMBER) ThenBlock: { ReturnValue(VarType.INTEGER) }
        IfCondition EqualTo(node_type, AST.STRING) ThenBlock: { ReturnValue(VarType.ADDRESS) }
        
        IfCondition EqualTo(node_type, AST.IDENTIFIER) ThenBlock: {
            name = AST_GetData1(node)
            IfCondition NotEqual(name, 0) ThenBlock: {
                IfCondition EqualTo(StringCompare(name, "True"), 0) ThenBlock: { ReturnValue(VarType.BOOLEAN) }
                IfCondition EqualTo(StringCompare(name, "False"), 0) ThenBlock: { ReturnValue(VarType.BOOLEAN) }
            }
            ReturnValue(Analyzer2.GetVarType(name))
        }
        
        IfCondition EqualTo(node_type, AST.CALL) ThenBlock: {
            func_name = AST_GetData1(node)
            ReturnValue(Analyzer2.FuncReturnType(func_name))
        }
        
        ReturnValue(VarType.UNKNOWN)
    }
}

Function.Analyzer2.FuncReturnType {
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(VarType.UNKNOWN) }
        
        // Math ops return Integer
        IfCondition EqualTo(StringCompare(name, "Add"), 0) ThenBlock: { ReturnValue(VarType.INTEGER) }
        IfCondition EqualTo(StringCompare(name, "Subtract"), 0) ThenBlock: { ReturnValue(VarType.INTEGER) }
        IfCondition EqualTo(StringCompare(name, "Multiply"), 0) ThenBlock: { ReturnValue(VarType.INTEGER) }
        IfCondition EqualTo(StringCompare(name, "Divide"), 0) ThenBlock: { ReturnValue(VarType.INTEGER) }
        IfCondition EqualTo(StringCompare(name, "Modulo"), 0) ThenBlock: { ReturnValue(VarType.INTEGER) }
        
        // Comparisons return Boolean
        IfCondition EqualTo(StringCompare(name, "EqualTo"), 0) ThenBlock: { ReturnValue(VarType.BOOLEAN) }
        IfCondition EqualTo(StringCompare(name, "NotEqual"), 0) ThenBlock: { ReturnValue(VarType.BOOLEAN) }
        IfCondition EqualTo(StringCompare(name, "LessThan"), 0) ThenBlock: { ReturnValue(VarType.BOOLEAN) }
        IfCondition EqualTo(StringCompare(name, "GreaterThan"), 0) ThenBlock: { ReturnValue(VarType.BOOLEAN) }
        IfCondition EqualTo(StringCompare(name, "LessEqual"), 0) ThenBlock: { ReturnValue(VarType.BOOLEAN) }
        IfCondition EqualTo(StringCompare(name, "GreaterEqual"), 0) ThenBlock: { ReturnValue(VarType.BOOLEAN) }
        
        // Memory ops return Address
        IfCondition EqualTo(StringCompare(name, "Allocate"), 0) ThenBlock: { ReturnValue(VarType.ADDRESS) }
        IfCondition EqualTo(StringCompare(name, "StringConcat"), 0) ThenBlock: { ReturnValue(VarType.ADDRESS) }
        
        // String ops return Integer
        IfCondition EqualTo(StringCompare(name, "StringLength"), 0) ThenBlock: { ReturnValue(VarType.INTEGER) }
        IfCondition EqualTo(StringCompare(name, "StringCompare"), 0) ThenBlock: { ReturnValue(VarType.INTEGER) }
        
        ReturnValue(VarType.UNKNOWN)
    }
}

Function.Analyzer2.NodeToVarType {
    Input: type_node: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(type_node, 0) ThenBlock: { ReturnValue(VarType.UNKNOWN) }
        
        type_kind = AST_GetType(type_node)
        
        IfCondition EqualTo(type_kind, AST.TYPE_INTEGER) ThenBlock: { ReturnValue(VarType.INTEGER) }
        IfCondition EqualTo(type_kind, AST.TYPE_ADDRESS) ThenBlock: { ReturnValue(VarType.ADDRESS) }
        IfCondition EqualTo(type_kind, AST.TYPE_TEXT) ThenBlock: { ReturnValue(VarType.STRING) }
        IfCondition EqualTo(type_kind, AST.TYPE_BOOLEAN) ThenBlock: { ReturnValue(VarType.BOOLEAN) }
        
        ReturnValue(VarType.UNKNOWN)
    }
}


// =============================================================================
// CLEANUP
// =============================================================================
Function.Analyzer2.Cleanup {
    Body: {
        IfCondition NotEqual(Analyzer2.warnings, 0) ThenBlock: {
            Array.Destroy(Analyzer2.warnings)
            Analyzer2.warnings = 0
        }
        IfCondition NotEqual(Analyzer2.hints, 0) ThenBlock: {
            Array.Destroy(Analyzer2.hints)
            Analyzer2.hints = 0
        }
        IfCondition NotEqual(Analyzer2.var_types, 0) ThenBlock: {
            Array.Destroy(Analyzer2.var_types)
            Analyzer2.var_types = 0
        }
        IfCondition NotEqual(Analyzer2.var_type_vals, 0) ThenBlock: {
            Array.Destroy(Analyzer2.var_type_vals)
            Analyzer2.var_type_vals = 0
        }
        IfCondition NotEqual(Analyzer2.func_names, 0) ThenBlock: {
            Array.Destroy(Analyzer2.func_names)
            Analyzer2.func_names = 0
        }
        IfCondition NotEqual(Analyzer2.func_param_counts, 0) ThenBlock: {
            Array.Destroy(Analyzer2.func_param_counts)
            Analyzer2.func_param_counts = 0
        }
        IfCondition NotEqual(Analyzer2.func_has_output, 0) ThenBlock: {
            Array.Destroy(Analyzer2.func_has_output)
            Analyzer2.func_has_output = 0
        }
        IfCondition NotEqual(Analyzer2.func_def_lines, 0) ThenBlock: {
            Array.Destroy(Analyzer2.func_def_lines)
            Analyzer2.func_def_lines = 0
        }
        IfCondition NotEqual(Analyzer2.possibly_null_vars, 0) ThenBlock: {
            Array.Destroy(Analyzer2.possibly_null_vars)
            Analyzer2.possibly_null_vars = 0
        }
        IfCondition NotEqual(Analyzer2.checked_null_vars, 0) ThenBlock: {
            Array.Destroy(Analyzer2.checked_null_vars)
            Analyzer2.checked_null_vars = 0
        }
        IfCondition NotEqual(Analyzer2.const_vars, 0) ThenBlock: {
            Array.Destroy(Analyzer2.const_vars)
            Analyzer2.const_vars = 0
        }
        IfCondition NotEqual(Analyzer2.const_values, 0) ThenBlock: {
            Array.Destroy(Analyzer2.const_values)
            Analyzer2.const_values = 0
        }
        
        Analyzer2.warning_count = 0
        Analyzer2.hint_count = 0
    }
}

// =============================================================================
// MAIN ENTRY POINT
// =============================================================================
Function.Analyzer2.Run {
    Input: ast: Address
    Output: Integer
    Body: {
        // PrintMessage("[DEBUG] Analyzer2.Init\n")
        Analyzer2.Init()
        
        // Pass 1: Collect function signatures
        // PrintMessage("[DEBUG] Analyzer2.CollectSignatures\n")
        Analyzer2.CollectSignatures(ast)
        
        // Pass 2: Walk and analyze
        // PrintMessage("[DEBUG] Analyzer2.WalkNode\n")
        Analyzer2.WalkNode(ast)
        
        ReturnValue(1)
    }
}