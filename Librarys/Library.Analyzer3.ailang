// Library.Analyzer3.ailang
// Advanced Static Analysis - Data Flow, Shadowing, FixedPool Validation
// Complements Analyzer + Analyzer2
//
// Features:
//   - Read-before-write detection (uninitialized variable use)
//   - Variable shadowing detection (nested scope name collision)
//   - Loop variable modification warnings
//   - FixedPool member validation
//   - Recursive call cycle detection
//   - Dead assignment detection (assigned but overwritten before use)
//   - Double deallocation detection
//   - StringConcat leak detection (common pattern)
//
// Copyright (c) 2025-2026 Sean Collins, 2 Paws Machine and Engineering. All rights reserved.
// Licensed under the Sean Collins Software License (SCSL v1.0).

LibraryImport.Arrays
LibraryImport.Compiler.Frontend.AST.CASTCore
LibraryImport.Compiler.Frontend.AST.CASTTypes
LibraryImport.Compiler.Import.CFileMap
LibraryImport.Compiler.Import.CImportResolver
LibraryImport.Analyzer

// =============================================================================
// ANALYZER3 STATE
// =============================================================================
FixedPool.Analyzer3 {
    // Scope tracking for shadowing
    "scope_stack": Initialize=0, CanChange=True      // XArray of scope markers
    "scope_vars": Initialize=0, CanChange=True       // XArray of [name, scope_level]
    "scope_depth": Initialize=0, CanChange=True
    
    // Read-before-write tracking
    "written_vars": Initialize=0, CanChange=True     // Vars that have been assigned
    "read_vars": Initialize=0, CanChange=True        // Vars that have been read
    "write_before_read": Initialize=0, CanChange=True // Vars written then read
    
    // Loop variable tracking
    "loop_vars": Initialize=0, CanChange=True        // Loop counter vars
    "loop_depth": Initialize=0, CanChange=True
    
    // FixedPool tracking
    "known_pools": Initialize=0, CanChange=True      // Pool names
    "pool_members": Initialize=0, CanChange=True     // Pool.member strings
    
    // Call graph for recursion
    "call_graph_from": Initialize=0, CanChange=True  // Caller function names
    "call_graph_to": Initialize=0, CanChange=True    // Callee function names
    "current_func": Initialize=0, CanChange=True
    
    // Dead assignment tracking
    "last_assign_var": Initialize=0, CanChange=True
    "last_assign_line": Initialize=0, CanChange=True
    "var_was_read": Initialize=0, CanChange=True     // Track if var read since assign
    
    // Double dealloc tracking
    "deallocated_vars": Initialize=0, CanChange=True
    "dealloc_warned_vars": Initialize=0, CanChange=True
    "maybe_freed_vars": Initialize=0, CanChange=True     // Freed on some paths only
    "alias_names": Initialize=0, CanChange=True          // Name copied from another pointer
    "alias_roots": Initialize=0, CanChange=True
    "ptr_names": Initialize=0, CanChange=True            // Names that hold a block
    
    "loop_alloc_vars": Initialize=0, CanChange=True      // Vars that received allocations in current loop body
    "loop_alloc_lines": Initialize=0, CanChange=True     // Line numbers of those allocations
    "loop_alloc_funcs": Initialize=0, CanChange=True     // Which allocating function was called
    "loop_dealloc_vars": Initialize=0, CanChange=True    // Vars deallocated in current loop body
    "loop_dealloc_lines": Initialize=0, CanChange=True
    "loop_alloc_seq": Initialize=0, CanChange=True       // Walk order of each loop alloc
    "loop_dealloc_seq": Initialize=0, CanChange=True
    "loop_alloc_leave": Initialize=0, CanChange=True    // 1 when this alloc returns or halts
    "leave_names": Initialize=0, CanChange=True         // Names returned by the current loop block
    "halt_depth": Initialize=0, CanChange=True          // Nested blocks that halt before the next trip
    "loop_seq": Initialize=0, CanChange=True
    "pending_names": Initialize=0, CanChange=True        // Freed then allocated again, still open
    "pending_lines": Initialize=0, CanChange=True
    "pending_funcs": Initialize=0, CanChange=True
    "loop_alloc_mark": Initialize=0, CanChange=True      // Stack of outer alloc-list sizes
    "loop_dealloc_mark": Initialize=0, CanChange=True    // Stack of outer dealloc-list sizes
    "in_loop_body": Initialize=0, CanChange=True         // Nesting depth inside loops (>0 = in loop)
    "alloc_in_loop_warnings": Initialize=0, CanChange=True
    "repeat_warnings": Initialize=0, CanChange=True
    "last_valid_line": Initialize=0, CanChange=True

    // Import usage tracking (unused-LibraryImport detection)
    "imported_modules": Initialize=0, CanChange=True     // XArray of Address (dotted paths from AST)
    "import_lines": Initialize=0, CanChange=True         // XArray of Integer (combined-source line of the declaration)
    "module_used": Initialize=0, CanChange=True          // XArray of Integer (0/1 parallel to imported_modules)
    "unused_import_warnings": Initialize=0, CanChange=True

    // Results
    "warnings": Initialize=0, CanChange=True
    "errors": Initialize=0, CanChange=True
    "warning_count": Initialize=0, CanChange=True
    "error_count": Initialize=0, CanChange=True

    // Stats
    "shadow_warnings": Initialize=0, CanChange=True
    "uninit_warnings": Initialize=0, CanChange=True
    "loop_mod_warnings": Initialize=0, CanChange=True
    "dead_assign_warnings": Initialize=0, CanChange=True
    "double_dealloc_warnings": Initialize=0, CanChange=True
    "concat_leak_warnings": Initialize=0, CanChange=True
    "uaf_warnings": Initialize=0, CanChange=True
    "recursive_cycles": Initialize=0, CanChange=True

    // Concat / long-running loop state. Init writes these.
    "concat_results": Initialize=0, CanChange=True
    "concat_in_loop": Initialize=0, CanChange=True
    "concat_lines": Initialize=0, CanChange=True
    "in_main_loop": Initialize=0, CanChange=True
    "in_while_loop": Initialize=0, CanChange=True
    "loop_concat_count": Initialize=0, CanChange=True

    // Config
    "check_shadow": Initialize=0, CanChange=True
    "check_uaf": Initialize=1, CanChange=True
    "check_uninit": Initialize=1, CanChange=True
    "check_loop_mod": Initialize=1, CanChange=True
    "check_dead_assign": Initialize=1, CanChange=True
    "check_double_dealloc": Initialize=1, CanChange=True
    "check_concat_leaks": Initialize=1, CanChange=True
    "check_recursion": Initialize=1, CanChange=True
    "check_pools": Initialize=1, CanChange=True
    "check_unused_imports": Initialize=1, CanChange=True
    "verbose": Initialize=0, CanChange=True
}

// =============================================================================
// INITIALIZATION
// =============================================================================
Function.Analyzer3.Init {
    Body: {
        Analyzer3.warnings = Array.Create(128)
        Analyzer3.errors = Array.Create(32)
        Analyzer3.warning_count = 0
        Analyzer3.error_count = 0
        
        // Scope tracking
        Analyzer3.scope_stack = Array.Create(32)
        Analyzer3.scope_vars = Array.Create(128)
        Analyzer3.scope_depth = 0
        
        // Data flow
        Analyzer3.written_vars = Array.Create(64)
        Analyzer3.read_vars = Array.Create(64)
        Analyzer3.write_before_read = Array.Create(64)
        
        // Loop vars
        Analyzer3.loop_vars = Array.Create(16)
        Analyzer3.loop_depth = 0
        
        Analyzer3.loop_alloc_vars = Array.Create(32)
        Analyzer3.loop_alloc_lines = Array.Create(32)
        Analyzer3.loop_alloc_funcs = Array.Create(32)
        Analyzer3.loop_dealloc_vars = Array.Create(32)
        Analyzer3.loop_dealloc_lines = Array.Create(32)
        Analyzer3.dealloc_warned_vars = Array.Create(32)
        Analyzer3.maybe_freed_vars = Array.Create(32)
        Analyzer3.alias_names = Array.Create(16)
        Analyzer3.alias_roots = Array.Create(16)
        Analyzer3.ptr_names = Array.Create(16)
        Analyzer3.loop_alloc_seq = Array.Create(32)
        Analyzer3.loop_dealloc_seq = Array.Create(32)
        Analyzer3.loop_alloc_leave = Array.Create(32)
        Analyzer3.leave_names = Array.Create(8)
        Analyzer3.halt_depth = 0
        Analyzer3.pending_names = Array.Create(8)
        Analyzer3.pending_lines = Array.Create(8)
        Analyzer3.pending_funcs = Array.Create(8)
        Analyzer3.loop_seq = 0
        Analyzer3.loop_alloc_mark = Array.Create(16)
        Analyzer3.loop_dealloc_mark = Array.Create(16)
        Analyzer3.in_loop_body = 0
        Analyzer3.alloc_in_loop_warnings = 0
        Analyzer3.repeat_warnings = 0


        // Pools
        Analyzer3.known_pools = Array.Create(64)
        Analyzer3.pool_members = Array.Create(256)
        
        // Call graph
        Analyzer3.call_graph_from = Array.Create(256)
        Analyzer3.call_graph_to = Array.Create(256)
        Analyzer3.current_func = 0
        
        // Dead assign
        Analyzer3.last_assign_var = Array.Create(32)
        Analyzer3.last_assign_line = Array.Create(32)
        Analyzer3.var_was_read = Array.Create(32)
        
        // Double dealloc
        Analyzer3.deallocated_vars = Array.Create(32)
        
        // Concat tracking (for long-running contexts)
        Analyzer3.concat_results = Array.Create(32)
        Analyzer3.concat_in_loop = Array.Create(32)
        Analyzer3.concat_lines = Array.Create(32)
        Analyzer3.in_main_loop = 0
        Analyzer3.in_while_loop = 0
        Analyzer3.loop_concat_count = 0
        
        // Import usage tracking
        Analyzer3.imported_modules = Array.Create(64)
        Analyzer3.import_lines = Array.Create(64)
        Analyzer3.module_used = Array.Create(64)
        Analyzer3.unused_import_warnings = 0

        // Stats
        Analyzer3.shadow_warnings = 0
        Analyzer3.uninit_warnings = 0
        Analyzer3.loop_mod_warnings = 0
        Analyzer3.dead_assign_warnings = 0
        Analyzer3.double_dealloc_warnings = 0
        Analyzer3.concat_leak_warnings = 0
        Analyzer3.uaf_warnings = 0
        Analyzer3.recursive_cycles = 0
        Analyzer3.last_valid_line = 0
    }
}

// =============================================================================
// DIAGNOSTICS
// =============================================================================
Function.Analyzer3.AddWarning {
    Input: msg: Address
    Body: {
        // Deduplicate
        count = Array.Size(Analyzer3.warnings)
        i = 0
        WhileLoop LessThan(i, count) {
            existing = Array.Get(Analyzer3.warnings, i)
            IfCondition EqualTo(StringCompare(existing, msg), 0) ThenBlock: { ReturnValue(0) }
            i = Add(i, 1)
        }
        
        Array.Push(Analyzer3.warnings, msg)
        Analyzer3.warning_count = Add(Analyzer3.warning_count, 1)
    }
}

Function.Analyzer3.AddError {
    Input: msg: Address
    Body: {
        // Deduplicate
        count = Array.Size(Analyzer3.errors)
        i = 0
        WhileLoop LessThan(i, count) {
            existing = Array.Get(Analyzer3.errors, i)
            IfCondition EqualTo(StringCompare(existing, msg), 0) ThenBlock: { ReturnValue(0) }
            i = Add(i, 1)
        }
        
        Array.Push(Analyzer3.errors, msg)
        Analyzer3.error_count = Add(Analyzer3.error_count, 1)
    }
}

// =============================================================================
// STRING HELPERS
// =============================================================================
Function.Analyzer3.StrEqual {
    Input: a: Address
    Input: b: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(a, 0) ThenBlock: {
            IfCondition EqualTo(b, 0) ThenBlock: { ReturnValue(1) }
            ReturnValue(0)
        }
        IfCondition EqualTo(b, 0) ThenBlock: { ReturnValue(0) }
        cmp = StringCompare(a, b)
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

Function.Analyzer3.ContainsDot {
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }
        len = StringLength(name)
        i = 0
        WhileLoop LessThan(i, len) {
            ch = GetByte(name, i)
            IfCondition EqualTo(ch, 46) ThenBlock: { ReturnValue(1) }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

Function.Analyzer3.ExtractPoolName {
    Input: dotted_name: Address
    Output: Address
    Body: {
        IfCondition EqualTo(dotted_name, 0) ThenBlock: { ReturnValue(0) }
        len = StringLength(dotted_name)
        i = 0
        WhileLoop LessThan(i, len) {
            ch = GetByte(dotted_name, i)
            IfCondition EqualTo(ch, 46) ThenBlock: {
                // Return substring before dot
                result = Allocate(Add(i, 1))
                j = 0
                WhileLoop LessThan(j, i) {
                    SetByte(result, j, GetByte(dotted_name, j))
                    j = Add(j, 1)
                }
                SetByte(result, i, 0)
                ReturnValue(result)
            }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

// =============================================================================
// SCOPE MANAGEMENT
// =============================================================================
Function.Analyzer3.PushScope {
    Body: {
        // Record current var count as scope marker
        current_count = Array.Size(Analyzer3.scope_vars)
        Array.Push(Analyzer3.scope_stack, current_count)
        Analyzer3.scope_depth = Add(Analyzer3.scope_depth, 1)
    }
}

Function.Analyzer3.PopScope {
    Body: {
        IfCondition GreaterThan(Analyzer3.scope_depth, 0) ThenBlock: {
            Analyzer3.scope_depth = Subtract(Analyzer3.scope_depth, 1)
            
            // Get scope start marker
            marker = Array.Get(Analyzer3.scope_stack, Analyzer3.scope_depth)
            
            // Remove vars added in this scope
            current_count = Array.Size(Analyzer3.scope_vars)
            WhileLoop GreaterThan(current_count, marker) {
                Array.Pop(Analyzer3.scope_vars)
                current_count = Subtract(current_count, 1)
            }
            
            Array.Pop(Analyzer3.scope_stack)
        }
    }
}

Function.Analyzer3.TrackScopeVar {
    Input: name: Address
    Input: line: Integer
    Body: {
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }
        
        // Silence unused warning
        IfCondition EqualTo(line, 0) ThenBlock: { }
        
        // Check if variable is already tracked in ANY scope (current or outer)
        // If it exists, we treat this as an update/assignment, not a new declaration/shadowing
        count = Array.Size(Analyzer3.scope_vars)
        i = 0
        WhileLoop LessThan(i, count) {
            existing = Array.Get(Analyzer3.scope_vars, i)
            IfCondition EqualTo(Analyzer3.StrEqual(existing, name), 1) ThenBlock: {
                ReturnValue(0) // Found, so it's an update
            }
            i = Add(i, 1)
        }
        
        // Not found in any scope, so it's a new declaration in the current scope
        Array.Push(Analyzer3.scope_vars, name)
    }
}

// =============================================================================
// DATA FLOW TRACKING
// =============================================================================
Function.Analyzer3.MarkWritten {
    Input: name: Address
    Body: {
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }
        
        // Check if already in list
        count = Array.Size(Analyzer3.written_vars)
        i = 0
        WhileLoop LessThan(i, count) {
            existing = Array.Get(Analyzer3.written_vars, i)
            IfCondition EqualTo(Analyzer3.StrEqual(existing, name), 1) ThenBlock: {
                ReturnValue(0)
            }
            i = Add(i, 1)
        }
        Array.Push(Analyzer3.written_vars, name)
    }
}

Function.Analyzer3.MarkRead {
    Input: name: Address
    Input: line: Integer
    Body: {
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }

        // A name freed earlier in this function, and not written since.
        // A copy of that name is the same block.
        IfCondition EqualTo(Analyzer3.check_uaf, 1) ThenBlock: {
            root = Analyzer3.RootOf(name)
            freed = Analyzer3.ListHas(Analyzer3.deallocated_vars, name)
            IfCondition EqualTo(freed, 0) ThenBlock: {
                freed = Analyzer3.ListHas(Analyzer3.deallocated_vars, root)
            }
            IfCondition EqualTo(freed, 1) ThenBlock: {
                already = Analyzer3.ListHas(Analyzer3.dealloc_warned_vars, name)
                IfCondition EqualTo(already, 0) ThenBlock: {
                    location = FileMap_Format(line)
                    msg = StringConcat("MEM-UAF ", location)
                    msg = StringConcat(msg, ": '")
                    msg = StringConcat(msg, name)
                    msg = StringConcat(msg, "' may be used after free")
                    IfCondition NotEqual(Analyzer3.current_func, 0) ThenBlock: {
                        msg = StringConcat(msg, " in '")
                        msg = StringConcat(msg, Analyzer3.current_func)
                        msg = StringConcat(msg, "'")
                    }
                    Analyzer3.AddWarning(msg)
                    Analyzer3.uaf_warnings = Add(Analyzer3.uaf_warnings, 1)
                    Array.Push(Analyzer3.dealloc_warned_vars, name)
                }
            }
            IfCondition EqualTo(freed, 0) ThenBlock: {
                maybe = Analyzer3.ListHas(Analyzer3.maybe_freed_vars, name)
                IfCondition EqualTo(maybe, 0) ThenBlock: {
                    maybe = Analyzer3.ListHas(Analyzer3.maybe_freed_vars, root)
                }
                IfCondition EqualTo(maybe, 1) ThenBlock: {
                    already = Analyzer3.ListHas(Analyzer3.dealloc_warned_vars, name)
                    IfCondition EqualTo(already, 0) ThenBlock: {
                        location = FileMap_Format(line)
                        msg = StringConcat("MEM-UAF ", location)
                        msg = StringConcat(msg, ": '")
                        msg = StringConcat(msg, name)
                        msg = StringConcat(msg, "' may be used after a free on another path")
                        IfCondition NotEqual(Analyzer3.current_func, 0) ThenBlock: {
                            msg = StringConcat(msg, " in '")
                            msg = StringConcat(msg, Analyzer3.current_func)
                            msg = StringConcat(msg, "'")
                        }
                        Analyzer3.AddWarning(msg)
                        Analyzer3.uaf_warnings = Add(Analyzer3.uaf_warnings, 1)
                        Array.Push(Analyzer3.dealloc_warned_vars, name)
                    }
                }
            }
        }
        
        // Check if written
        was_written = 0
        count = Array.Size(Analyzer3.written_vars)
        i = 0
        WhileLoop LessThan(i, count) {
            existing = Array.Get(Analyzer3.written_vars, i)
            IfCondition EqualTo(Analyzer3.StrEqual(existing, name), 1) ThenBlock: {
                was_written = 1
            }
            i = Add(i, 1)
        }
        
        // Check for uninitialized read
        IfCondition EqualTo(Analyzer3.check_uninit, 1) ThenBlock: {
            IfCondition EqualTo(was_written, 0) ThenBlock: {
                // Skip pool members (they're global)
                is_pool = Analyzer3.ContainsDot(name)
                IfCondition EqualTo(is_pool, 0) ThenBlock: {
                    // Skip common globals/builtins
                    is_builtin = Analyzer3.IsBuiltinOrGlobal(name)
                    IfCondition EqualTo(is_builtin, 0) ThenBlock: {
                        location = FileMap_Format(line)
                        msg = location
                        msg = StringConcat(msg, ": Variable '")
                        msg = StringConcat(msg, name)
                        msg = StringConcat(msg, "' may be used before initialization")
                        Analyzer3.AddWarning(msg)
                        Analyzer3.uninit_warnings = Add(Analyzer3.uninit_warnings, 1)
                    }
                }
            }
        }
        
        // Mark as read
        count = Array.Size(Analyzer3.read_vars)
        i = 0
        WhileLoop LessThan(i, count) {
            existing = Array.Get(Analyzer3.read_vars, i)
            IfCondition EqualTo(Analyzer3.StrEqual(existing, name), 1) ThenBlock: {
                ReturnValue(0)
            }
            i = Add(i, 1)
        }
        Array.Push(Analyzer3.read_vars, name)
    }
}

Function.Analyzer3.IsBuiltinOrGlobal {
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }
        
        // Common globals
        IfCondition EqualTo(StringCompare(name, "True"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "False"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "Null"), 0) ThenBlock: { ReturnValue(1) }
        
        ReturnValue(0)
    }
}

Function.Analyzer3.ClearDataFlow {
    Body: {
        Array.Clear(Analyzer3.written_vars)
        Array.Clear(Analyzer3.read_vars)
        Array.Clear(Analyzer3.deallocated_vars)
        Array.Clear(Analyzer3.dealloc_warned_vars)
        Array.Clear(Analyzer3.maybe_freed_vars)
        Array.Clear(Analyzer3.alias_names)
        Array.Clear(Analyzer3.alias_roots)
        Array.Clear(Analyzer3.ptr_names)
        Array.Clear(Analyzer3.pending_names)
        Array.Clear(Analyzer3.pending_lines)
        Array.Clear(Analyzer3.pending_funcs)
        Array.Clear(Analyzer3.leave_names)
        Array.Clear(Analyzer3.loop_alloc_leave)
        Analyzer3.halt_depth = 0
        Analyzer3.loop_seq = 0
        Array.Clear(Analyzer3.last_assign_var)
        Array.Clear(Analyzer3.last_assign_line)
        Array.Clear(Analyzer3.var_was_read)
    }
}

// =============================================================================
// LOOP VARIABLE TRACKING
// =============================================================================
Function.Analyzer3.EnterLoop {
    Input: counter_var: Address
    Body: {
        Analyzer3.loop_depth = Add(Analyzer3.loop_depth, 1)
        IfCondition NotEqual(counter_var, 0) ThenBlock: {
            Array.Push(Analyzer3.loop_vars, counter_var)
        }
    }
}

Function.Analyzer3.ExitLoop {
    Body: {
        IfCondition GreaterThan(Analyzer3.loop_depth, 0) ThenBlock: {
            Analyzer3.loop_depth = Subtract(Analyzer3.loop_depth, 1)
            // Pop loop var if any
            count = Array.Size(Analyzer3.loop_vars)
            IfCondition GreaterThan(count, Analyzer3.loop_depth) ThenBlock: {
                Array.Pop(Analyzer3.loop_vars)
            }
        }
    }
}

Function.Analyzer3.IsLoopVar {
    Input: name: Address
    Output: Integer
    Body: {
        count = Array.Size(Analyzer3.loop_vars)
        i = 0
        WhileLoop LessThan(i, count) {
            existing = Array.Get(Analyzer3.loop_vars, i)
            IfCondition EqualTo(Analyzer3.StrEqual(existing, name), 1) ThenBlock: {
                ReturnValue(1)
            }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

// =============================================================================
// CALL GRAPH TRACKING
// =============================================================================
Function.Analyzer3.RecordCall {
    Input: caller: Address
    Input: callee: Address
    Body: {
        IfCondition EqualTo(caller, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(callee, 0) ThenBlock: { ReturnValue(0) }

        Array.Push(Analyzer3.call_graph_from, caller)
        Array.Push(Analyzer3.call_graph_to, callee)
    }
}

// =============================================================================
// IMPORT USAGE TRACKING — cross-references AST LibraryImport declarations
// against the resolver's per-module symbol tables so we can warn about
// imports whose symbols are never referenced from user code.
// =============================================================================

// Returns 1 if the FileMap says `name` is the user's main module (or if the
// map has no entry — conservatively treat unmapped as main).
Function.Analyzer3.IsUserMainFile {
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(1) }
        ReturnValue(Analyzer3.StrEqual(name, "main"))
    }
}

// Register an import declaration seen in the AST.
Function.Analyzer3.RegisterImport {
    Input: module_path: Address
    Input: line: Integer
    Body: {
        IfCondition EqualTo(module_path, 0) ThenBlock: { ReturnValue(0) }

        // Deduplicate — Parse may visit the same LibraryImport twice in
        // rare edge cases (combined imports etc.).
        count = Array.Size(Analyzer3.imported_modules)
        i = 0
        WhileLoop LessThan(i, count) {
            existing = Array.Get(Analyzer3.imported_modules, i)
            IfCondition EqualTo(StringCompare(existing, module_path), 0) ThenBlock: {
                ReturnValue(0)
            }
            i = Add(i, 1)
        }

        Array.Push(Analyzer3.imported_modules, module_path)
        Array.Push(Analyzer3.import_lines, line)
        Array.Push(Analyzer3.module_used, 0)
    }
}

// Mark the module that owns `sym_name` as used — but only if the reference
// occurs inside the user's main module. References from library code don't
// count (the library handles its own imports).
Function.Analyzer3.MarkModuleUsed {
    Input: sym_name: Address
    Input: ref_line: Integer
    Body: {
        IfCondition EqualTo(sym_name, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Import.last_state, 0) ThenBlock: { ReturnValue(0) }

        // Filter: only references from the user's main file count.
        IfCondition GreaterThan(ref_line, 0) ThenBlock: {
            FileMap_Lookup(ref_line)
            IfCondition NotEqual(FileMap.result_file, 0) ThenBlock: {
                is_main = Analyzer3.IsUserMainFile(FileMap.result_file)
                IfCondition EqualTo(is_main, 0) ThenBlock: { ReturnValue(0) }
            }
        }

        mod_idx = Import_FindSymbolModule(Import.last_state, sym_name)
        IfCondition LessThan(mod_idx, 0) ThenBlock: { ReturnValue(0) }

        mod_name = Import_GetModuleNameByIdx(Import.last_state, mod_idx)
        IfCondition EqualTo(mod_name, 0) ThenBlock: { ReturnValue(0) }

        // Match against our tracked imports. Resolver's loaded_names and
        // AST's LibraryImport path strings are both the full dotted path,
        // so direct compare works.
        count = Array.Size(Analyzer3.imported_modules)
        i = 0
        WhileLoop LessThan(i, count) {
            tracked = Array.Get(Analyzer3.imported_modules, i)
            IfCondition EqualTo(StringCompare(tracked, mod_name), 0) ThenBlock: {
                Array.Set(Analyzer3.module_used, i, 1)
                ReturnValue(0)
            }
            i = Add(i, 1)
        }
    }
}

// Post-analysis: emit a warning for each registered import that ended
// the run with module_used == 0.
Function.Analyzer3.CheckUnusedImports {
    Body: {
        IfCondition EqualTo(Analyzer3.check_unused_imports, 0) ThenBlock: { ReturnValue(0) }

        count = Array.Size(Analyzer3.imported_modules)
        i = 0
        WhileLoop LessThan(i, count) {
            used = Array.Get(Analyzer3.module_used, i)
            IfCondition EqualTo(used, 0) ThenBlock: {
                mod_path = Array.Get(Analyzer3.imported_modules, i)
                line = Array.Get(Analyzer3.import_lines, i)

                location = FileMap_Format(line)
                msg = location
                msg = StringConcat(msg, ": LibraryImport.")
                msg = StringConcat(msg, mod_path)
                msg = StringConcat(msg, " is unused — no symbol from this module is referenced")
                Analyzer3.AddWarning(msg)
                Analyzer3.unused_import_warnings = Add(Analyzer3.unused_import_warnings, 1)
            }
            i = Add(i, 1)
        }
    }
}

Function.Analyzer3.DetectRecursiveCycles {
    Body: {
        IfCondition EqualTo(Analyzer3.check_recursion, 0) ThenBlock: { ReturnValue(0) }
        
        count = Array.Size(Analyzer3.call_graph_from)
        i = 0
        WhileLoop LessThan(i, count) {
            caller = Array.Get(Analyzer3.call_graph_from, i)
            callee = Array.Get(Analyzer3.call_graph_to, i)
            
            IfCondition EqualTo(Analyzer3.StrEqual(caller, callee), 1) ThenBlock: {
                Analyzer3.recursive_cycles = Add(Analyzer3.recursive_cycles, 1)
            }
            i = Add(i, 1)
        }
    }
}

// =============================================================================
// POOL TRACKING
// =============================================================================
Function.Analyzer3.RegisterPool {
    Input: pool_name: Address
    Body: {
        IfCondition EqualTo(pool_name, 0) ThenBlock: { ReturnValue(0) }
        Array.Push(Analyzer3.known_pools, pool_name)
    }
}

Function.Analyzer3.RegisterPoolMember {
    Input: full_name: Address
    Body: {
        IfCondition EqualTo(full_name, 0) ThenBlock: { ReturnValue(0) }
        Array.Push(Analyzer3.pool_members, full_name)
    }
}

Function.Analyzer3.IsKnownPoolMember {
    Input: name: Address
    Output: Integer
    Body: {
        count = Array.Size(Analyzer3.pool_members)
        i = 0
        WhileLoop LessThan(i, count) {
            existing = Array.Get(Analyzer3.pool_members, i)
            IfCondition EqualTo(Analyzer3.StrEqual(existing, name), 1) ThenBlock: {
                ReturnValue(1)
            }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

// =============================================================================
// DOUBLE DEALLOC TRACKING
// =============================================================================
Function.Analyzer3.RecordDealloc {
    Input: var_name: Address
    Input: line: Integer
    Body: {
        IfCondition EqualTo(var_name, 0) ThenBlock: { ReturnValue(0) }
        root = Analyzer3.RootOf(var_name)
        
        // Check if already deallocated on every path.
        IfCondition EqualTo(Analyzer3.check_double_dealloc, 1) ThenBlock: {
            already = Analyzer3.ListHas(Analyzer3.deallocated_vars, var_name)
            IfCondition EqualTo(already, 0) ThenBlock: {
                already = Analyzer3.ListHas(Analyzer3.deallocated_vars, root)
            }
            IfCondition EqualTo(already, 1) ThenBlock: {
                location = FileMap_Format(line)
                msg = StringConcat("MEM-DOUBLE ", location)
                msg = StringConcat(msg, ": '")
                msg = StringConcat(msg, var_name)
                msg = StringConcat(msg, "' freed again")
                IfCondition NotEqual(Analyzer3.current_func, 0) ThenBlock: {
                    msg = StringConcat(msg, " in '")
                    msg = StringConcat(msg, Analyzer3.current_func)
                    msg = StringConcat(msg, "'")
                }
                Analyzer3.AddWarning(msg)
                Analyzer3.double_dealloc_warnings = Add(Analyzer3.double_dealloc_warnings, 1)
                ReturnValue(0)
            }
            // A free that only happened on one branch, then a later free.
            maybe = Analyzer3.ListHas(Analyzer3.maybe_freed_vars, var_name)
            IfCondition EqualTo(maybe, 0) ThenBlock: {
                maybe = Analyzer3.ListHas(Analyzer3.maybe_freed_vars, root)
            }
            IfCondition EqualTo(maybe, 1) ThenBlock: {
                location = FileMap_Format(line)
                msg = StringConcat("MEM-DOUBLE ", location)
                msg = StringConcat(msg, ": '")
                msg = StringConcat(msg, var_name)
                msg = StringConcat(msg, "' freed again after a one-sided free")
                IfCondition NotEqual(Analyzer3.current_func, 0) ThenBlock: {
                    msg = StringConcat(msg, " in '")
                    msg = StringConcat(msg, Analyzer3.current_func)
                    msg = StringConcat(msg, "'")
                }
                Analyzer3.AddWarning(msg)
                Analyzer3.double_dealloc_warnings = Add(Analyzer3.double_dealloc_warnings, 1)
                Analyzer3.RemoveMaybe(var_name)
                Analyzer3.RemoveMaybe(root)
                Analyzer3.MarkFreedGroup(var_name, root)
                Analyzer3.ClearPending(root)
                ReturnValue(0)
            }
        }
        
        Analyzer3.MarkFreedGroup(var_name, root)
        Analyzer3.ClearPending(root)
    }
}

Function.Analyzer3.IndexOf {
    Input: list: Address
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(list, 0) ThenBlock: { ReturnValue(Subtract(0, 1)) }
        count = Array.Size(list)
        i = 0
        WhileLoop LessThan(i, count) {
            existing = Array.Get(list, i)
            same = Analyzer3.StrEqual(existing, name)
            IfCondition EqualTo(same, 1) ThenBlock: { ReturnValue(i) }
            i = Add(i, 1)
        }
        ReturnValue(Subtract(0, 1))
    }
}

Function.Analyzer3.RootOf {
    Input: name: Address
    Output: Address
    Body: {
        current = name
        steps = 0
        WhileLoop LessThan(steps, 8) {
            idx = Analyzer3.IndexOf(Analyzer3.alias_names, current)
            IfCondition LessThan(idx, 0) ThenBlock: { ReturnValue(current) }
            current = Array.Get(Analyzer3.alias_roots, idx)
            steps = Add(steps, 1)
        }
        ReturnValue(current)
    }
}

Function.Analyzer3.ClearAlias {
    Input: name: Address
    Body: {
        idx = Analyzer3.IndexOf(Analyzer3.alias_names, name)
        IfCondition LessThan(idx, 0) ThenBlock: { ReturnValue(0) }
        last = Array.Size(Analyzer3.alias_names)
        last = Subtract(last, 1)
        IfCondition NotEqual(idx, last) ThenBlock: {
            Array.Swap(Analyzer3.alias_names, idx, last)
            Array.Swap(Analyzer3.alias_roots, idx, last)
        }
        Array.Pop(Analyzer3.alias_names)
        Array.Pop(Analyzer3.alias_roots)
    }
}

Function.Analyzer3.BindAlias {
    Input: name: Address
    Input: root: Address
    Body: {
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(root, 0) ThenBlock: { ReturnValue(0) }
        same = Analyzer3.StrEqual(name, root)
        IfCondition EqualTo(same, 1) ThenBlock: {
            Analyzer3.ClearAlias(name)
            ReturnValue(0)
        }
        idx = Analyzer3.IndexOf(Analyzer3.alias_names, name)
        IfCondition GreaterEqual(idx, 0) ThenBlock: {
            Array.Set(Analyzer3.alias_roots, idx, root)
            ReturnValue(0)
        }
        Array.Push(Analyzer3.alias_names, name)
        Array.Push(Analyzer3.alias_roots, root)
    }
}

Function.Analyzer3.NotePtr {
    Input: name: Address
    Body: {
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }
        seen = Analyzer3.ListHas(Analyzer3.ptr_names, name)
        IfCondition EqualTo(seen, 0) ThenBlock: {
            Array.Push(Analyzer3.ptr_names, name)
        }
    }
}

Function.Analyzer3.PushFresh {
    Input: list: Address
    Input: name: Address
    Body: {
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }
        seen = Analyzer3.ListHas(list, name)
        IfCondition EqualTo(seen, 0) ThenBlock: {
            Array.Push(list, name)
        }
    }
}

Function.Analyzer3.MarkFreedGroup {
    Input: var_name: Address
    Input: root: Address
    Body: {
        Analyzer3.PushFresh(Analyzer3.deallocated_vars, var_name)
        Analyzer3.PushFresh(Analyzer3.deallocated_vars, root)
        count = Array.Size(Analyzer3.alias_names)
        i = 0
        WhileLoop LessThan(i, count) {
            aname = Array.Get(Analyzer3.alias_names, i)
            aroot = Analyzer3.RootOf(aname)
            same = Analyzer3.StrEqual(aroot, root)
            IfCondition EqualTo(same, 1) ThenBlock: {
                Analyzer3.PushFresh(Analyzer3.deallocated_vars, aname)
            }
            i = Add(i, 1)
        }
    }
}

Function.Analyzer3.NoteAlias {
    Input: target: Address
    Input: value: Address
    Body: {
        IfCondition EqualTo(value, 0) ThenBlock: { ReturnValue(0) }
        value_type = AST_GetType(value)
        IfCondition EqualTo(value_type, AST.CALL) ThenBlock: {
            fname = AST_GetData1(value)
            is_alloc = Analyzer3.IsAllocatingFunc(fname)
            returns_new = Analyzer.ReturnsAlloc(fname)
            IfCondition EqualTo(is_alloc, 1) ThenBlock: {
                Analyzer3.ClearAlias(target)
                Analyzer3.NotePtr(target)
                ReturnValue(0)
            }
            IfCondition EqualTo(returns_new, 1) ThenBlock: {
                Analyzer3.ClearAlias(target)
                Analyzer3.NotePtr(target)
                ReturnValue(0)
            }
        }
        IfCondition EqualTo(value_type, AST.IDENTIFIER) ThenBlock: {
            rhs = AST_GetData1(value)
            root = Analyzer3.RootOf(rhs)
            tracked = Analyzer3.ListHas(Analyzer3.ptr_names, root)
            IfCondition EqualTo(tracked, 0) ThenBlock: {
                tracked = Analyzer3.ListHas(Analyzer3.alias_names, rhs)
            }
            IfCondition EqualTo(tracked, 1) ThenBlock: {
                Analyzer3.BindAlias(target, root)
                ReturnValue(0)
            }
        }
        Analyzer3.ClearAlias(target)
    }
}

Function.Analyzer3.ClearPending {
    Input: name: Address
    Body: {
        idx = Analyzer3.IndexOf(Analyzer3.pending_names, name)
        IfCondition LessThan(idx, 0) ThenBlock: { ReturnValue(0) }
        last = Array.Size(Analyzer3.pending_names)
        last = Subtract(last, 1)
        IfCondition NotEqual(idx, last) ThenBlock: {
            Array.Swap(Analyzer3.pending_names, idx, last)
            Array.Swap(Analyzer3.pending_lines, idx, last)
            Array.Swap(Analyzer3.pending_funcs, idx, last)
        }
        Array.Pop(Analyzer3.pending_names)
        Array.Pop(Analyzer3.pending_lines)
        Array.Pop(Analyzer3.pending_funcs)
    }
}

Function.Analyzer3.NoteReallocTail {
    Input: name: Address
    Input: line: Integer
    Input: func_name: Address
    Body: {
        seen = Analyzer3.ListHas(Analyzer3.pending_names, name)
        IfCondition EqualTo(seen, 1) ThenBlock: { ReturnValue(0) }
        Array.Push(Analyzer3.pending_names, name)
        Array.Push(Analyzer3.pending_lines, line)
        Array.Push(Analyzer3.pending_funcs, func_name)
    }
}

Function.Analyzer3.DropExitingFrees {
    Input: names: Address
    Input: other: Address
    Input: arm_exits: Integer
    Body: {
        IfCondition EqualTo(arm_exits, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(names, 0) ThenBlock: { ReturnValue(0) }
        i = 0
        count = Array.Size(names)
        WhileLoop LessThan(i, count) {
            name = Array.Get(names, i)
            keep = 0
            IfCondition NotEqual(other, 0) ThenBlock: {
                keep = Analyzer3.ListHas(other, name)
            }
            IfCondition EqualTo(keep, 0) ThenBlock: {
                last = Subtract(count, 1)
                IfCondition NotEqual(i, last) ThenBlock: {
                    Array.Swap(names, i, last)
                }
                Array.Pop(names)
                count = Array.Size(names)
            }
            IfCondition EqualTo(keep, 1) ThenBlock: {
                i = Add(i, 1)
            }
        }
    }
}

Function.Analyzer3.RestoreMaybe {
    Input: names: Address
    Body: {
        IfCondition EqualTo(names, 0) ThenBlock: { ReturnValue(0) }
        count = Array.Size(names)
        i = 0
        WhileLoop LessThan(i, count) {
            name = Array.Get(names, i)
            seen = Analyzer3.ListHas(Analyzer3.maybe_freed_vars, name)
            IfCondition EqualTo(seen, 0) ThenBlock: {
                Array.Push(Analyzer3.maybe_freed_vars, name)
            }
            i = Add(i, 1)
        }
        Array.Destroy(names)
    }
}

Function.Analyzer3.RemoveDealloc {
    Input: var_name: Address
    Body: {
        IfCondition EqualTo(var_name, 0) ThenBlock: { ReturnValue(0) }
        Analyzer3.RemoveFrom(Analyzer3.deallocated_vars, var_name)
        Analyzer3.RemoveMaybe(var_name)
    }
}

Function.Analyzer3.RemoveFrom {
    Input: list: Address
    Input: var_name: Address
    Body: {
        IfCondition EqualTo(list, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(var_name, 0) ThenBlock: { ReturnValue(0) }
        count = Array.Size(list)
        i = 0
        WhileLoop LessThan(i, count) {
            existing = Array.Get(list, i)
            IfCondition EqualTo(Analyzer3.StrEqual(existing, var_name), 1) ThenBlock: {
                last_idx = Subtract(count, 1)
                Array.Swap(list, i, last_idx)
                Array.Pop(list)
                ReturnValue(0)
            }
            i = Add(i, 1)
        }
    }
}

Function.Analyzer3.RemoveMaybe {
    Input: var_name: Address
    Body: {
        Analyzer3.RemoveFrom(Analyzer3.maybe_freed_vars, var_name)
    }
}



// =============================================================================
// PASS 1: COLLECT POOLS
// =============================================================================
Function.Analyzer3.CollectPools {
    Input: node: Address
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        
        node_type = AST_GetType(node)
        
        // FixedPool declaration
        IfCondition EqualTo(node_type, AST.POOL_FIXED) ThenBlock: {
            pool_name = AST_GetData1(node)
            Analyzer3.RegisterPool(pool_name)
            
            // Collect members
            child_count = AST_GetChildCount(node)
            i = 0
            WhileLoop LessThan(i, child_count) {
                child = AST_GetChild(node, i)
                IfCondition NotEqual(child, 0) ThenBlock: {
                    child_type = AST_GetType(child)
                    IfCondition EqualTo(child_type, AST.POOL_MEMBER) ThenBlock: {
                        member_name = AST_GetData1(child)
                        IfCondition NotEqual(member_name, 0) ThenBlock: {
                            // Build full name Pool.member
                            full = StringConcat(pool_name, ".")
                            full = StringConcat(full, member_name)
                            Analyzer3.RegisterPoolMember(full)
                        }
                    }
                }
                i = Add(i, 1)
            }
        }
        
        // DynamicPool
        IfCondition EqualTo(node_type, AST.POOL_DYNAMIC) ThenBlock: {
            pool_name = AST_GetData1(node)
            Analyzer3.RegisterPool(pool_name)
        }
        
        // Recurse
        child_count = AST_GetChildCount(node)
        i = 0
        WhileLoop LessThan(i, child_count) {
            child = AST_GetChild(node, i)
            Analyzer3.CollectPools(child)
            i = Add(i, 1)
        }
    }
}

// =============================================================================
// MAIN WALK
// =============================================================================
Function.Analyzer3.WalkNode {
    Input: node: Address
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        
        node_type = AST_GetType(node)
        node_line = AST_GetLine(node)
        
        // Fix for "Line 0" issues: propagate last known valid line
        IfCondition GreaterThan(node_line, 0) ThenBlock: {
            Analyzer3.last_valid_line = node_line
        } ElseBlock: {
            node_line = Analyzer3.last_valid_line
        }
        
        // === FUNCTION ENTRY ===
        IfCondition EqualTo(node_type, AST.FUNCTION) ThenBlock: {
            Analyzer3.current_func = AST_GetData1(node)
            Analyzer3.ClearDataFlow()
            Analyzer3.PushScope()
            
            // Mark parameters as written
            child_count = AST_GetChildCount(node)
            i = 0
            WhileLoop LessThan(i, child_count) {
                child = AST_GetChild(node, i)
                IfCondition NotEqual(child, 0) ThenBlock: {
                    child_type = AST_GetType(child)
                    IfCondition EqualTo(child_type, AST.PARAMETER) ThenBlock: {
                        param_name = AST_GetData1(child)
                        Analyzer3.MarkWritten(param_name)
                        Analyzer3.TrackScopeVar(param_name, node_line)
                    }
                }
                i = Add(i, 1)
            }
            
            Analyzer3.WalkChildren(node)
            Analyzer3.FlushPending()
            
            Analyzer3.PopScope()
            Analyzer3.current_func = 0
            ReturnValue(0)
        }
        
        // === SUBROUTINE ===
        IfCondition EqualTo(node_type, AST.SUBROUTINE) ThenBlock: {
            Analyzer3.current_func = AST_GetData1(node)
            Analyzer3.ClearDataFlow()
            Analyzer3.PushScope()
            
            Analyzer3.WalkChildren(node)
            Analyzer3.FlushPending()
            
            Analyzer3.PopScope()
            Analyzer3.current_func = 0
            ReturnValue(0)
        }
        
        // === BLOCK/BODY - new scope ===
        IfCondition EqualTo(node_type, AST.BLOCK) ThenBlock: {
            leave_flag = Analyzer3.PushLeave(node)
            Analyzer3.PushScope()
            Analyzer3.WalkChildren(node)
            Analyzer3.PopScope()
            Analyzer3.PopLeave(leave_flag)
            ReturnValue(0)
        }
        
        IfCondition EqualTo(node_type, AST.BODY) ThenBlock: {
            leave_flag = Analyzer3.PushLeave(node)
            Analyzer3.PushScope()
            Analyzer3.WalkChildren(node)
            Analyzer3.PopScope()
            Analyzer3.PopLeave(leave_flag)
            ReturnValue(0)
        }
        
        // === IF and FORK (Branching Analysis) ===
        is_branch = 0
        IfCondition EqualTo(node_type, AST.IF) ThenBlock: { is_branch = 1 }
        IfCondition EqualTo(node_type, AST.FORK) ThenBlock: { is_branch = 1 }
        IfCondition EqualTo(is_branch, 1) ThenBlock: {
            child_count = AST_GetChildCount(node)
            
            // 1. Analyze Condition
            IfCondition GreaterThan(child_count, 0) ThenBlock: {
                cond = AST_GetChild(node, 0)
                Analyzer3.WalkNode(cond)
            }
            
            // Snapshot state before branches. Maybes added in one arm
            // must not be visible while the other arm is walked.
            start_dealloc_count = Array.Size(Analyzer3.deallocated_vars)
            maybe_start = Array.Size(Analyzer3.maybe_freed_vars)
            then_block = 0
            else_block = 0
            
            // 2. Analyze Then Block
            IfCondition GreaterThan(child_count, 1) ThenBlock: {
                then_block = AST_GetChild(node, 1)
                Analyzer3.WalkNode(then_block)
            }
            
            // Names freed only in Then. Pop them so Else does not see them.
            then_names = Analyzer3.TakeSince(Analyzer3.deallocated_vars, start_dealloc_count)
            then_maybe = Analyzer3.TakeSince(Analyzer3.maybe_freed_vars, maybe_start)
            has_else = 0
            IfCondition GreaterThan(child_count, 2) ThenBlock: {
                has_else = 1
                else_block = AST_GetChild(node, 2)
                Analyzer3.WalkNode(else_block)
            }
            else_names = Analyzer3.TakeSince(Analyzer3.deallocated_vars, start_dealloc_count)
            else_maybe = Analyzer3.TakeSince(Analyzer3.maybe_freed_vars, maybe_start)
            then_exits = Analyzer.ArmExits(then_block)
            else_exits = Analyzer.ArmExits(else_block)
            // A free on a path that returns does not reach the code after the If,
            // unless every arm frees that name.
            Analyzer3.DropExitingFrees(then_names, else_names, then_exits)
            Analyzer3.DropExitingFrees(else_names, then_names, else_exits)
            // Intersection is definite. One side only is maybe-freed.
            Analyzer3.JoinFrees(then_names, else_names, has_else)
            IfCondition EqualTo(then_exits, 0) ThenBlock: {
                Analyzer3.RestoreMaybe(then_maybe)
            }
            IfCondition EqualTo(then_exits, 1) ThenBlock: {
                Array.Destroy(then_maybe)
            }
            IfCondition EqualTo(has_else, 1) ThenBlock: {
                IfCondition EqualTo(else_exits, 0) ThenBlock: {
                    Analyzer3.RestoreMaybe(else_maybe)
                }
                IfCondition EqualTo(else_exits, 1) ThenBlock: {
                    Array.Destroy(else_maybe)
                }
            }
            IfCondition EqualTo(has_else, 0) ThenBlock: {
                Array.Destroy(else_maybe)
            }
            Array.Destroy(then_names)
            Array.Destroy(else_names)
            
            ReturnValue(0)
        }
        
        // === WHILE LOOP ===
        IfCondition EqualTo(node_type, AST.WHILE) ThenBlock: {
            Analyzer3.BeginLoopAlloc()
            loop_var = 0
            Analyzer3.EnterLoop(loop_var)
            Analyzer3.WalkChildren(node)
            Analyzer3.ExitLoop()
            Analyzer3.EndLoopAlloc()
            ReturnValue(0)
        }
        
        // === LOOP MAIN (long-running server pattern) ===
        IfCondition EqualTo(node_type, AST.LOOP_MAIN) ThenBlock: {
            Analyzer3.in_main_loop = 1
            Analyzer3.BeginLoopAlloc()
            Analyzer3.WalkChildren(node)
            Analyzer3.EndLoopAlloc()
            Analyzer3.in_main_loop = 0
            ReturnValue(0)
        }
        
        // === FOR LOOP ===
        IfCondition EqualTo(node_type, AST.FOR_EVERY) ThenBlock: {
            loop_var = AST_GetData1(node)
            Analyzer3.BeginLoopAlloc()
            Analyzer3.EnterLoop(loop_var)
            Analyzer3.MarkWritten(loop_var)
            Analyzer3.WalkChildren(node)
            Analyzer3.ExitLoop()
            Analyzer3.EndLoopAlloc()
            ReturnValue(0)
        }
        
        // === ASSIGNMENT ===
        IfCondition EqualTo(node_type, AST.ASSIGNMENT) ThenBlock: {
            target = AST_GetData1(node)
            
            // Check for loop variable modification
            IfCondition EqualTo(Analyzer3.check_loop_mod, 1) ThenBlock: {
                IfCondition GreaterThan(Analyzer3.loop_depth, 0) ThenBlock: {
                    IfCondition EqualTo(Analyzer3.IsLoopVar(target), 1) ThenBlock: {
                        // Check if it's the expected increment pattern
                        // For now, just warn
                        child_count = AST_GetChildCount(node)
                        IfCondition GreaterThan(child_count, 0) ThenBlock: {
                            rhs = AST_GetChild(node, 0)
                            is_increment = Analyzer3.IsIncrementPattern(target, rhs)
                            IfCondition EqualTo(is_increment, 0) ThenBlock: {
                                location = FileMap_Format(node_line)
                                msg = location
                                msg = StringConcat(msg, ": Loop variable '")
                                msg = StringConcat(msg, target)
                                msg = StringConcat(msg, "' modified in unexpected way")
                                Analyzer3.AddWarning(msg)
                                Analyzer3.loop_mod_warnings = Add(Analyzer3.loop_mod_warnings, 1)
                            }
                        }
                    }
                }
            }
            

           // Check for allocation in loop
            child_count = AST_GetChildCount(node)
            IfCondition GreaterThan(child_count, 0) ThenBlock: {
                rhs = AST_GetChild(node, 0)
                IfCondition NotEqual(rhs, 0) ThenBlock: {
                    IfCondition EqualTo(AST_GetType(rhs), AST.CALL) ThenBlock: {
                        func_name = AST_GetData1(rhs)
                        IfCondition NotEqual(func_name, 0) ThenBlock: {
                            // Track allocations inside loop bodies
                            IfCondition GreaterThan(Analyzer3.in_loop_body, 0) ThenBlock: {
                                IfCondition EqualTo(Analyzer3.IsAllocatingFunc(func_name), 1) ThenBlock: {
                                    alloc_seq = Analyzer3.loop_seq
                                    Analyzer3.loop_seq = Add(alloc_seq, 1)
                                    Array.Push(Analyzer3.loop_alloc_vars, target)
                                    Array.Push(Analyzer3.loop_alloc_lines, node_line)
                                    Array.Push(Analyzer3.loop_alloc_funcs, func_name)
                                    Array.Push(Analyzer3.loop_alloc_seq, alloc_seq)
                                    hands = Analyzer3.HandsBack(target)
                                    IfCondition GreaterThan(Analyzer3.halt_depth, 0) ThenBlock: {
                                        hands = 1
                                    }
                                    Array.Push(Analyzer3.loop_alloc_leave, hands)
                                }
                            }
                        }
                    }
                }
                
                // Walk RHS first. A read of a freed name is use-after-free.
                // The write below then clears the freed mark.
                Analyzer3.WalkNode(rhs)
            }

            Analyzer3.RemoveDealloc(target)
            alias_value = 0
            alias_count = AST_GetChildCount(node)
            IfCondition GreaterThan(alias_count, 0) ThenBlock: {
                alias_value = AST_GetChild(node, 0)
            }
            Analyzer3.NoteAlias(target, alias_value)

            // Mark written and add to scope
            Analyzer3.MarkWritten(target)
            Analyzer3.TrackScopeVar(target, node_line)
            ReturnValue(0)
        }
        
        // === LIBRARY IMPORT ===
        IfCondition EqualTo(node_type, AST.LIBRARY_IMPORT) ThenBlock: {
            import_path = AST_GetData1(node)
            Analyzer3.RegisterImport(import_path, node_line)
            ReturnValue(0)
        }

        // === IDENTIFIER (read) ===
        IfCondition EqualTo(node_type, AST.IDENTIFIER) ThenBlock: {
            name = AST_GetData1(node)
            Analyzer3.MarkRead(name, node_line)
            Analyzer3.MarkModuleUsed(name, node_line)
            ReturnValue(0)
        }

        // === FUNCTION CALL ===
        IfCondition EqualTo(node_type, AST.CALL) ThenBlock: {
            func_name = AST_GetData1(node)

            // Record in call graph
            Analyzer3.RecordCall(Analyzer3.current_func, func_name)
            Analyzer3.MarkModuleUsed(func_name, node_line)
            
            // Read the arguments before recording the free, so the pointer
            // passed to the free is not itself a use-after-free.
            Analyzer3.WalkChildren(node)

            is_free = Analyzer3.IsFreeingFunc(func_name)
            IfCondition EqualTo(is_free, 1) ThenBlock: {
                child_count = AST_GetChildCount(node)
                IfCondition GreaterThan(child_count, 0) ThenBlock: {
                    dealloc_arg = AST_GetChild(node, 0)
                    IfCondition NotEqual(dealloc_arg, 0) ThenBlock: {
                        IfCondition EqualTo(AST_GetType(dealloc_arg), AST.IDENTIFIER) ThenBlock: {
                            dealloc_name = AST_GetData1(dealloc_arg)
                            Analyzer3.RecordDealloc(dealloc_name, node_line)
                            
                            // Track deallocation inside loop bodies
                            IfCondition GreaterThan(Analyzer3.in_loop_body, 0) ThenBlock: {
                                loop_name = Analyzer3.RootOf(dealloc_name)
                                free_seq = Analyzer3.loop_seq
                                Analyzer3.loop_seq = Add(free_seq, 1)
                                Array.Push(Analyzer3.loop_dealloc_vars, loop_name)
                                Array.Push(Analyzer3.loop_dealloc_lines, node_line)
                                Array.Push(Analyzer3.loop_dealloc_seq, free_seq)
                            }
                        }
                    }
                }
            }

            // A callee that frees one of its parameters takes that argument.
            child_count = AST_GetChildCount(node)
            ai = 0
            WhileLoop LessThan(ai, child_count) {
                arg = AST_GetChild(node, ai)
                IfCondition NotEqual(arg, 0) ThenBlock: {
                    arg_type = AST_GetType(arg)
                    IfCondition EqualTo(arg_type, AST.IDENTIFIER) ThenBlock: {
                        aname = AST_GetData1(arg)
                        takes = Analyzer.FreesParam(func_name, ai)
                        IfCondition EqualTo(takes, 1) ThenBlock: {
                            Analyzer3.RecordDealloc(aname, node_line)
                            IfCondition GreaterThan(Analyzer3.in_loop_body, 0) ThenBlock: {
                                loop_name = Analyzer3.RootOf(aname)
                                free_seq = Analyzer3.loop_seq
                                Analyzer3.loop_seq = Add(free_seq, 1)
                                Array.Push(Analyzer3.loop_dealloc_vars, loop_name)
                                Array.Push(Analyzer3.loop_dealloc_lines, node_line)
                                Array.Push(Analyzer3.loop_dealloc_seq, free_seq)
                            }
                        }
                    }
                }
                ai = Add(ai, 1)
            }
            ReturnValue(0)
        }
        
        // === DEFAULT: recurse ===
        Analyzer3.WalkChildren(node)
    }
}

Function.Analyzer3.WalkChildren {
    Input: node: Address
    Body: {
        child_count = AST_GetChildCount(node)
        i = 0
        WhileLoop LessThan(i, child_count) {
            child = AST_GetChild(node, i)
            Analyzer3.WalkNode(child)
            i = Add(i, 1)
        }
    }
}

// =============================================================================
// HELPERS
// =============================================================================
Function.Analyzer3.ExtractLoopVar {
    Input: cond: Address
    Output: Address
    Body: {
        // Look for LessThan(var, ...) or similar patterns
        IfCondition EqualTo(cond, 0) ThenBlock: { ReturnValue(0) }
        
        cond_type = AST_GetType(cond)
        IfCondition EqualTo(cond_type, AST.CALL) ThenBlock: {
            func_name = AST_GetData1(cond)
            IfCondition EqualTo(func_name, 0) ThenBlock: { ReturnValue(0) }
            
            // Check for comparison functions
            is_cmp = 0
            IfCondition EqualTo(StringCompare(func_name, "LessThan"), 0) ThenBlock: { is_cmp = 1 }
            IfCondition EqualTo(StringCompare(func_name, "LessEqual"), 0) ThenBlock: { is_cmp = 1 }
            IfCondition EqualTo(StringCompare(func_name, "GreaterThan"), 0) ThenBlock: { is_cmp = 1 }
            IfCondition EqualTo(StringCompare(func_name, "GreaterEqual"), 0) ThenBlock: { is_cmp = 1 }
            IfCondition EqualTo(StringCompare(func_name, "NotEqual"), 0) ThenBlock: { is_cmp = 1 }
            
            IfCondition EqualTo(is_cmp, 1) ThenBlock: {
                child_count = AST_GetChildCount(cond)
                IfCondition GreaterThan(child_count, 0) ThenBlock: {
                    first_arg = AST_GetChild(cond, 0)
                    IfCondition NotEqual(first_arg, 0) ThenBlock: {
                        IfCondition EqualTo(AST_GetType(first_arg), AST.IDENTIFIER) ThenBlock: {
                            ReturnValue(AST_GetData1(first_arg))
                        }
                    }
                }
            }
        }
        
        ReturnValue(0)
    }
}

Function.Analyzer3.IsIncrementPattern {
    Input: var_name: Address
    Input: rhs: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(rhs, 0) ThenBlock: { ReturnValue(0) }
        
        rhs_type = AST_GetType(rhs)
        IfCondition NotEqual(rhs_type, AST.CALL) ThenBlock: { ReturnValue(0) }
        
        func_name = AST_GetData1(rhs)
        IfCondition EqualTo(func_name, 0) ThenBlock: { ReturnValue(0) }
        
        // Counter increment/decrement: var = Add(var, N) or Subtract(var, N)
        is_add = StringCompare(func_name, "Add")
        is_sub = StringCompare(func_name, "Subtract")
        IfCondition Or(EqualTo(is_add, 0), EqualTo(is_sub, 0)) ThenBlock: {
            ReturnValue(Analyzer3.FirstArgMatches(var_name, rhs))
        }
        
        // Numeric convergence: Divide, Multiply, Modulo
        IfCondition EqualTo(StringCompare(func_name, "Divide"), 0) ThenBlock: {
            ReturnValue(Analyzer3.FirstArgMatches(var_name, rhs))
        }
        IfCondition EqualTo(StringCompare(func_name, "Multiply"), 0) ThenBlock: {
            ReturnValue(Analyzer3.FirstArgMatches(var_name, rhs))
        }
        IfCondition EqualTo(StringCompare(func_name, "Modulo"), 0) ThenBlock: {
            ReturnValue(Analyzer3.FirstArgMatches(var_name, rhs))
        }
        
        // Linked list traversal: var = Dereference(...)
        IfCondition EqualTo(StringCompare(func_name, "Dereference"), 0) ThenBlock: {
            ReturnValue(1)
        }
        
        // Byte scanning: var = GetByte(...)
        IfCondition EqualTo(StringCompare(func_name, "GetByte"), 0) ThenBlock: {
            ReturnValue(1)
        }
        
        // Bit scanning: RightShift(var, N), LeftShift(var, N)
        IfCondition EqualTo(StringCompare(func_name, "RightShift"), 0) ThenBlock: {
            ReturnValue(Analyzer3.FirstArgMatches(var_name, rhs))
        }
        IfCondition EqualTo(StringCompare(func_name, "LeftShift"), 0) ThenBlock: {
            ReturnValue(Analyzer3.FirstArgMatches(var_name, rhs))
        }
        
        ReturnValue(0)
    }
}


Function.Analyzer3.FirstArgMatches {
    Input: var_name: Address
    Input: call_node: Address
    Output: Integer
    Body: {
        child_count = AST_GetChildCount(call_node)
        IfCondition GreaterThan(child_count, 0) ThenBlock: {
            first_arg = AST_GetChild(call_node, 0)
            IfCondition NotEqual(first_arg, 0) ThenBlock: {
                IfCondition EqualTo(AST_GetType(first_arg), AST.IDENTIFIER) ThenBlock: {
                    arg_name = AST_GetData1(first_arg)
                    IfCondition EqualTo(Analyzer3.StrEqual(arg_name, var_name), 1) ThenBlock: {
                        ReturnValue(1)
                    }
                }
            }
        }
        ReturnValue(0)
    }
}


Function.Analyzer3.IsArenaManaged {
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }
        
        IfCondition EqualTo(StringCompare(name, "StringConcat"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "NumberToString"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "StringCopy"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "StringSubstring"), 0) ThenBlock: { ReturnValue(1) }
        
        ReturnValue(0)
    }
}

Function.Analyzer3.ListHas {
    Input: list: Address
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(list, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }
        count = Array.Size(list)
        i = 0
        WhileLoop LessThan(i, count) {
            existing = Array.Get(list, i)
            same = Analyzer3.StrEqual(existing, name)
            IfCondition EqualTo(same, 1) ThenBlock: { ReturnValue(1) }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

Function.Analyzer3.IsFreeingFunc {
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }
        cmp = StringCompare(name, "Deallocate")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
        cmp = StringCompare(name, "Arena_Free")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
        cmp = StringCompare(name, "ArrayDestroy")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
        cmp = StringCompare(name, "Array.Destroy")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
        cmp = StringCompare(name, "FreeLinkage")
        IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

Function.Analyzer3.IsAllocatingFunc {
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }
        
        IfCondition EqualTo(StringCompare(name, "Allocate"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "StringConcat"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "NumberToString"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "Array.Create"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "ArrayCreate"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "StringCopy"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "StringSubstring"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringCompare(name, "ReadFile"), 0) ThenBlock: { ReturnValue(1) }
        
        ReturnValue(0)
    }
}


Function.Analyzer3.PopTo {
    Input: list: Address
    Input: start: Integer
    Body: {
        IfCondition EqualTo(list, 0) ThenBlock: { ReturnValue(0) }
        sz = Array.Size(list)
        WhileLoop GreaterThan(sz, start) {
            Array.Pop(list)
            sz = Array.Size(list)
        }
    }
}

// flag bits: 1 = pushed a returned name, 2 = this block halts.
Function.Analyzer3.PushLeave {
    Input: node: Address
    Output: Integer
    Body: {
        handed = 0
        halts = 0
        IfCondition GreaterThan(Analyzer3.in_loop_body, 0) ThenBlock: {
            handed = Analyzer.ReturnedIdent(node)
            halts = Analyzer.ArmHalts(node)
        }
        flag = 0
        IfCondition NotEqual(handed, 0) ThenBlock: {
            Array.Push(Analyzer3.leave_names, handed)
            flag = 1
        }
        IfCondition EqualTo(halts, 1) ThenBlock: {
            Analyzer3.halt_depth = Add(Analyzer3.halt_depth, 1)
            flag = Add(flag, 2)
        }
        ReturnValue(flag)
    }
}

Function.Analyzer3.PopLeave {
    Input: flag: Integer
    Body: {
        halt_part = 0
        IfCondition GreaterEqual(flag, 2) ThenBlock: { halt_part = 1 }
        name_part = flag
        IfCondition EqualTo(halt_part, 1) ThenBlock: {
            name_part = Subtract(flag, 2)
            IfCondition GreaterThan(Analyzer3.halt_depth, 0) ThenBlock: {
                Analyzer3.halt_depth = Subtract(Analyzer3.halt_depth, 1)
            }
        }
        IfCondition EqualTo(name_part, 1) ThenBlock: {
            Array.Pop(Analyzer3.leave_names)
        }
    }
}

Function.Analyzer3.HandsBack {
    Input: name: Address
    Output: Integer
    Body: {
        count = Array.Size(Analyzer3.leave_names)
        i = 0
        WhileLoop LessThan(i, count) {
            item = Array.Get(Analyzer3.leave_names, i)
            same = Analyzer3.StrEqual(item, name)
            IfCondition EqualTo(same, 1) ThenBlock: { ReturnValue(1) }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

Function.Analyzer3.BeginLoopAlloc {
    Body: {
        mark_a = Array.Size(Analyzer3.loop_alloc_vars)
        Array.Push(Analyzer3.loop_alloc_mark, mark_a)
        mark_d = Array.Size(Analyzer3.loop_dealloc_vars)
        Array.Push(Analyzer3.loop_dealloc_mark, mark_d)
        Analyzer3.in_loop_body = Add(Analyzer3.in_loop_body, 1)
    }
}

Function.Analyzer3.EndLoopAlloc {
    Body: {
        start = Array.Pop(Analyzer3.loop_alloc_mark)
        dstart = Array.Pop(Analyzer3.loop_dealloc_mark)
        Analyzer3.CheckLoopAllocBalance(start, dstart)
        Analyzer3.CheckLoopFreeOutside(start, dstart)
        Analyzer3.PopTo(Analyzer3.loop_alloc_vars, start)
        Analyzer3.PopTo(Analyzer3.loop_alloc_lines, start)
        Analyzer3.PopTo(Analyzer3.loop_alloc_funcs, start)
        Analyzer3.PopTo(Analyzer3.loop_dealloc_vars, dstart)
        Analyzer3.PopTo(Analyzer3.loop_dealloc_lines, dstart)
        Analyzer3.PopTo(Analyzer3.loop_alloc_seq, start)
        Analyzer3.PopTo(Analyzer3.loop_dealloc_seq, dstart)
        Analyzer3.PopTo(Analyzer3.loop_alloc_leave, start)
        IfCondition GreaterThan(Analyzer3.in_loop_body, 0) ThenBlock: {
            Analyzer3.in_loop_body = Subtract(Analyzer3.in_loop_body, 1)
        }
    }
}

Function.Analyzer3.TakeSince {
    Input: list: Address
    Input: start: Integer
    Output: Address
    Body: {
        out = Array.Create(8)
        IfCondition EqualTo(list, 0) ThenBlock: { ReturnValue(out) }
        count = Array.Size(list)
        i = start
        WhileLoop LessThan(i, count) {
            item = Array.Get(list, i)
            Array.Push(out, item)
            i = Add(i, 1)
        }
        Analyzer3.PopTo(list, start)
        ReturnValue(out)
    }
}

Function.Analyzer3.JoinFrees {
    Input: then_names: Address
    Input: else_names: Address
    Input: has_else: Integer
    Body: {
        tcount = Array.Size(then_names)
        ti = 0
        WhileLoop LessThan(ti, tcount) {
            name = Array.Get(then_names, ti)
            in_else = 0
            IfCondition EqualTo(has_else, 1) ThenBlock: {
                in_else = Analyzer3.ListHas(else_names, name)
            }
            IfCondition EqualTo(in_else, 1) ThenBlock: {
                already = Analyzer3.ListHas(Analyzer3.deallocated_vars, name)
                IfCondition EqualTo(already, 0) ThenBlock: {
                    Array.Push(Analyzer3.deallocated_vars, name)
                }
            }
            IfCondition EqualTo(in_else, 0) ThenBlock: {
                already_m = Analyzer3.ListHas(Analyzer3.maybe_freed_vars, name)
                IfCondition EqualTo(already_m, 0) ThenBlock: {
                    Array.Push(Analyzer3.maybe_freed_vars, name)
                }
            }
            ti = Add(ti, 1)
        }
        IfCondition EqualTo(has_else, 1) ThenBlock: {
            ecount = Array.Size(else_names)
            ei = 0
            WhileLoop LessThan(ei, ecount) {
                ename = Array.Get(else_names, ei)
                in_then = Analyzer3.ListHas(then_names, ename)
                IfCondition EqualTo(in_then, 0) ThenBlock: {
                    already_m = Analyzer3.ListHas(Analyzer3.maybe_freed_vars, ename)
                    IfCondition EqualTo(already_m, 0) ThenBlock: {
                        Array.Push(Analyzer3.maybe_freed_vars, ename)
                    }
                }
                ei = Add(ei, 1)
            }
        }
    }
}

Function.Analyzer3.InSlice {
    Input: list: Address
    Input: name: Address
    Input: start: Integer
    Input: end: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(list, 0) ThenBlock: { ReturnValue(0) }
        i = start
        WhileLoop LessThan(i, end) {
            existing = Array.Get(list, i)
            same = Analyzer3.StrEqual(existing, name)
            IfCondition EqualTo(same, 1) ThenBlock: { ReturnValue(1) }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

Function.Analyzer3.CheckLoopFreeOutside {
    Input: start: Integer
    Input: dstart: Integer
    Body: {
        alloc_end = Array.Size(Analyzer3.loop_alloc_vars)
        dcount = Array.Size(Analyzer3.loop_dealloc_vars)
        di = dstart
        WhileLoop LessThan(di, dcount) {
            name = Array.Get(Analyzer3.loop_dealloc_vars, di)
            inside = Analyzer3.InSlice(Analyzer3.loop_alloc_vars, name, start, alloc_end)
            IfCondition EqualTo(inside, 0) ThenBlock: {
                earlier = Analyzer3.InSlice(Analyzer3.loop_dealloc_vars, name, dstart, di)
                IfCondition EqualTo(earlier, 0) ThenBlock: {
                    line = Array.Get(Analyzer3.loop_dealloc_lines, di)
                    location = FileMap_Format(line)
                    msg = StringConcat("MEM-REPEAT ", location)
                    msg = StringConcat(msg, ": '")
                    IfCondition NotEqual(name, 0) ThenBlock: {
                        msg = StringConcat(msg, name)
                    }
                    msg = StringConcat(msg, "' freed inside a loop but allocated outside it")
                    IfCondition NotEqual(Analyzer3.current_func, 0) ThenBlock: {
                        msg = StringConcat(msg, " in '")
                        msg = StringConcat(msg, Analyzer3.current_func)
                        msg = StringConcat(msg, "'")
                    }
                    Analyzer3.AddWarning(msg)
                    Analyzer3.repeat_warnings = Add(Analyzer3.repeat_warnings, 1)
                }
            }
            di = Add(di, 1)
        }
    }
}

Function.Analyzer3.EmitLoopWarn {
    Input: var_name: Address
    Input: line: Integer
    Input: alloc_func: Address
    Body: {
        location = FileMap_Format(line)
        msg = StringConcat("MEM-LOOP ", location)
        msg = StringConcat(msg, ": '")
        IfCondition NotEqual(var_name, 0) ThenBlock: {
            msg = StringConcat(msg, var_name)
        }
        msg = StringConcat(msg, "' allocated by ")
        IfCondition NotEqual(alloc_func, 0) ThenBlock: {
            msg = StringConcat(msg, alloc_func)
        }
        is_arena = Analyzer3.IsArenaManaged(alloc_func)
        IfCondition EqualTo(is_arena, 1) ThenBlock: {
            msg = StringConcat(msg, " inside a loop; the arena grows each iteration")
        }
        IfCondition EqualTo(is_arena, 0) ThenBlock: {
            msg = StringConcat(msg, " inside a loop and not freed before the next iteration")
        }
        IfCondition NotEqual(Analyzer3.current_func, 0) ThenBlock: {
            msg = StringConcat(msg, " in '")
            msg = StringConcat(msg, Analyzer3.current_func)
            msg = StringConcat(msg, "'")
        }
        Analyzer3.AddWarning(msg)
        Analyzer3.alloc_in_loop_warnings = Add(Analyzer3.alloc_in_loop_warnings, 1)
    }
}

Function.Analyzer3.FlushPending {
    Body: {
        count = Array.Size(Analyzer3.pending_names)
        i = 0
        WhileLoop LessThan(i, count) {
            name = Array.Get(Analyzer3.pending_names, i)
            line = Array.Get(Analyzer3.pending_lines, i)
            func_name = Array.Get(Analyzer3.pending_funcs, i)
            Analyzer3.EmitLoopWarn(name, line, func_name)
            i = Add(i, 1)
        }
        Array.Clear(Analyzer3.pending_names)
        Array.Clear(Analyzer3.pending_lines)
        Array.Clear(Analyzer3.pending_funcs)
    }
}

Function.Analyzer3.CheckLoopAllocBalance {
    Input: start: Integer
    Input: dstart: Integer
    Body: {
        count = Array.Size(Analyzer3.loop_alloc_vars)
        i = start
        WhileLoop LessThan(i, count) {
            var_name = Array.Get(Analyzer3.loop_alloc_vars, i)
            
            later_free = 0
            earlier_free = 0
            alloc_seq = Array.Get(Analyzer3.loop_alloc_seq, i)
            dcount = Array.Size(Analyzer3.loop_dealloc_vars)
            di = dstart
            WhileLoop LessThan(di, dcount) {
                dvar = Array.Get(Analyzer3.loop_dealloc_vars, di)
                IfCondition EqualTo(Analyzer3.StrEqual(dvar, var_name), 1) ThenBlock: {
                    dseq = Array.Get(Analyzer3.loop_dealloc_seq, di)
                    IfCondition GreaterThan(dseq, alloc_seq) ThenBlock: {
                        later_free = 1
                    }
                    IfCondition LessEqual(dseq, alloc_seq) ThenBlock: {
                        earlier_free = 1
                    }
                }
                di = Add(di, 1)
            }
            
            hands = Array.Get(Analyzer3.loop_alloc_leave, i)
            IfCondition EqualTo(hands, 0) ThenBlock: {
                IfCondition EqualTo(later_free, 0) ThenBlock: {
                    line = Array.Get(Analyzer3.loop_alloc_lines, i)
                    alloc_func = Array.Get(Analyzer3.loop_alloc_funcs, i)
                    // Free then allocate is the realloc shape. The free after
                    // the loop, if there is one, releases the last block.
                    IfCondition EqualTo(earlier_free, 1) ThenBlock: {
                        Analyzer3.NoteReallocTail(var_name, line, alloc_func)
                    }
                    IfCondition EqualTo(earlier_free, 0) ThenBlock: {
                        Analyzer3.EmitLoopWarn(var_name, line, alloc_func)
                    }
                }
            }
            
            i = Add(i, 1)
        }
    }
}


// =============================================================================
// CLEANUP
// =============================================================================
Function.Analyzer3.Cleanup {
    Body: {
        IfCondition NotEqual(Analyzer3.warnings, 0) ThenBlock: {
            Array.Destroy(Analyzer3.warnings)
            Analyzer3.warnings = 0
        }
        IfCondition NotEqual(Analyzer3.errors, 0) ThenBlock: {
            Array.Destroy(Analyzer3.errors)
            Analyzer3.errors = 0
        }
        IfCondition NotEqual(Analyzer3.scope_stack, 0) ThenBlock: {
            Array.Destroy(Analyzer3.scope_stack)
            Analyzer3.scope_stack = 0
        }
        IfCondition NotEqual(Analyzer3.scope_vars, 0) ThenBlock: {
            Array.Destroy(Analyzer3.scope_vars)
            Analyzer3.scope_vars = 0
        }
        IfCondition NotEqual(Analyzer3.written_vars, 0) ThenBlock: {
            Array.Destroy(Analyzer3.written_vars)
            Analyzer3.written_vars = 0
        }
        IfCondition NotEqual(Analyzer3.read_vars, 0) ThenBlock: {
            Array.Destroy(Analyzer3.read_vars)
            Analyzer3.read_vars = 0
        }
        IfCondition NotEqual(Analyzer3.write_before_read, 0) ThenBlock: {
            Array.Destroy(Analyzer3.write_before_read)
            Analyzer3.write_before_read = 0
        }
        IfCondition NotEqual(Analyzer3.loop_vars, 0) ThenBlock: {
            Array.Destroy(Analyzer3.loop_vars)
            Analyzer3.loop_vars = 0
        }
        IfCondition NotEqual(Analyzer3.known_pools, 0) ThenBlock: {
            Array.Destroy(Analyzer3.known_pools)
            Analyzer3.known_pools = 0
        }
        IfCondition NotEqual(Analyzer3.pool_members, 0) ThenBlock: {
            Array.Destroy(Analyzer3.pool_members)
            Analyzer3.pool_members = 0
        }
        IfCondition NotEqual(Analyzer3.call_graph_from, 0) ThenBlock: {
            Array.Destroy(Analyzer3.call_graph_from)
            Analyzer3.call_graph_from = 0
        }
        IfCondition NotEqual(Analyzer3.call_graph_to, 0) ThenBlock: {
            Array.Destroy(Analyzer3.call_graph_to)
            Analyzer3.call_graph_to = 0
        }
        IfCondition NotEqual(Analyzer3.deallocated_vars, 0) ThenBlock: {
            Array.Destroy(Analyzer3.deallocated_vars)
            Analyzer3.deallocated_vars = 0
        }
        IfCondition NotEqual(Analyzer3.last_assign_var, 0) ThenBlock: {
            Array.Destroy(Analyzer3.last_assign_var)
            Analyzer3.last_assign_var = 0
        }
        IfCondition NotEqual(Analyzer3.last_assign_line, 0) ThenBlock: {
            Array.Destroy(Analyzer3.last_assign_line)
            Analyzer3.last_assign_line = 0
        }
        IfCondition NotEqual(Analyzer3.var_was_read, 0) ThenBlock: {
            Array.Destroy(Analyzer3.var_was_read)
            Analyzer3.var_was_read = 0
        }
        
         IfCondition NotEqual(Analyzer3.loop_alloc_vars, 0) ThenBlock: {
            Array.Destroy(Analyzer3.loop_alloc_vars)
            Analyzer3.loop_alloc_vars = 0
        }
        IfCondition NotEqual(Analyzer3.loop_alloc_lines, 0) ThenBlock: {
            Array.Destroy(Analyzer3.loop_alloc_lines)
            Analyzer3.loop_alloc_lines = 0
        }
        IfCondition NotEqual(Analyzer3.loop_alloc_funcs, 0) ThenBlock: {
            Array.Destroy(Analyzer3.loop_alloc_funcs)
            Analyzer3.loop_alloc_funcs = 0
        }
        IfCondition NotEqual(Analyzer3.loop_dealloc_vars, 0) ThenBlock: {
            Array.Destroy(Analyzer3.loop_dealloc_vars)
            Analyzer3.loop_dealloc_vars = 0
        }
        IfCondition NotEqual(Analyzer3.loop_dealloc_lines, 0) ThenBlock: {
            Array.Destroy(Analyzer3.loop_dealloc_lines)
            Analyzer3.loop_dealloc_lines = 0
        }
        IfCondition NotEqual(Analyzer3.dealloc_warned_vars, 0) ThenBlock: {
            Array.Destroy(Analyzer3.dealloc_warned_vars)
            Analyzer3.dealloc_warned_vars = 0
        }
        IfCondition NotEqual(Analyzer3.maybe_freed_vars, 0) ThenBlock: {
            Array.Destroy(Analyzer3.maybe_freed_vars)
            Analyzer3.maybe_freed_vars = 0
        }
        IfCondition NotEqual(Analyzer3.alias_names, 0) ThenBlock: {
            Array.Destroy(Analyzer3.alias_names)
            Analyzer3.alias_names = 0
        }
        IfCondition NotEqual(Analyzer3.alias_roots, 0) ThenBlock: {
            Array.Destroy(Analyzer3.alias_roots)
            Analyzer3.alias_roots = 0
        }
        IfCondition NotEqual(Analyzer3.ptr_names, 0) ThenBlock: {
            Array.Destroy(Analyzer3.ptr_names)
            Analyzer3.ptr_names = 0
        }
        IfCondition NotEqual(Analyzer3.loop_alloc_seq, 0) ThenBlock: {
            Array.Destroy(Analyzer3.loop_alloc_seq)
            Analyzer3.loop_alloc_seq = 0
        }
        IfCondition NotEqual(Analyzer3.loop_dealloc_seq, 0) ThenBlock: {
            Array.Destroy(Analyzer3.loop_dealloc_seq)
            Analyzer3.loop_dealloc_seq = 0
        }
        IfCondition NotEqual(Analyzer3.loop_alloc_leave, 0) ThenBlock: {
