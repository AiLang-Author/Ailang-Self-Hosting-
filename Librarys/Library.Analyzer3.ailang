        }
        IfCondition NotEqual(Analyzer3.loop_alloc_mark, 0) ThenBlock: {
            Array.Destroy(Analyzer3.loop_alloc_mark)
            Analyzer3.loop_alloc_mark = 0
        }
        IfCondition NotEqual(Analyzer3.loop_dealloc_mark, 0) ThenBlock: {
            Array.Destroy(Analyzer3.loop_dealloc_mark)
            Analyzer3.loop_dealloc_mark = 0
        }

        Analyzer3.warning_count = 0
        Analyzer3.error_count = 0
    }
}

// =============================================================================
// MAIN ENTRY POINT
// =============================================================================
Function.Analyzer3.Run {
    Input: ast: Address
    Output: Integer
    Body: {
        Analyzer3.Init()

        // Pass 1: Collect pool definitions
        Analyzer3.CollectPools(ast)

        // Pass 2: Walk and analyze
        Analyzer3.WalkNode(ast)

        // Post-analysis: Check for recursive cycles
        Analyzer3.DetectRecursiveCycles()

        // Post-analysis: Warn about LibraryImport.X where no symbol from X
        // was referenced from the user's main file.
        Analyzer3.CheckUnusedImports()

        ReturnValue(1)
    }
}