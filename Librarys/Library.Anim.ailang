// Anim — raster-once, place-forever sprite animation.
//
// SVG / TVG / VIF (or any PIXEL_32 surface) become sheets. A clip is a
// frame range on a sheet. A sprite is a clip placed at (x,y). Draw is an
// alpha blit of the current cell. Tick advances playing clips. MapSpan
// indexes frames from a value (needles, bars, stepped gauges).
//
// Nothing here owns serial, XDF, or a window. BindFB or BindSurf, then
// Place / Tick / DrawAll. Same path for ECU dash, CAD HUD, desk widgets.
// Host must provide DebugLog_Push (Framebuffer calls it). ECU_View already does.
//
// Copyright (c) 2026 Sean Collins, 2 Paws Machine and Engineering. All rights reserved.
// Licensed under the Sean Collins Software License (SCSL v1.0).

LibraryImport.Arena
LibraryImport.Display.Render.DSurfaceTypes
LibraryImport.Display.Render.DSurface
LibraryImport.Display.Render.SurfaceBlit
LibraryImport.Display.Render.Framebuffer
LibraryImport.Display.Render.StyleRaster
LibraryImport.Display.Render.VIF
LibraryImport.SVG

// Sheet record (8 words): 0 surf 1 w 2 h 3 cols 4 rows 5 fw 6 fh 7 nframes
// Clip  record (8 words): 0 sheet 1 f0 2 f1 3 dt_ms 4 flags 5 _ 6 _ 7 _
// Sprite record (8 words): 0 clip 1 x 2 y 3 frame 4 acc 5 flags 6 ox 7 oy

FixedPool.AnimClipFlag {
    "LOOP": Initialize=1
}

FixedPool.AnimSprFlag {
    "PLAY": Initialize=1
    "VIS":  Initialize=2
}

FixedPool.Anim_State {
    "ok":      Initialize=0, CanChange=True
    "sheets":  Initialize=0, CanChange=True
    "clips":   Initialize=0, CanChange=True
    "spr":     Initialize=0, CanChange=True
    "nsh":     Initialize=0, CanChange=True
    "ncl":     Initialize=0, CanChange=True
    "nsp":     Initialize=0, CanChange=True
    "cap_sh":  Initialize=64, CanChange=True
    "cap_cl":  Initialize=128, CanChange=True
    "cap_sp":  Initialize=256, CanChange=True
    "dst":     Initialize=0, CanChange=True
    "fb_ds":   Initialize=0, CanChange=True
    "gen":     Initialize=0, CanChange=True
    "genb":    Initialize=0, CanChange=True
    "ts":      Initialize=0, CanChange=True
    "cmd":     Initialize=0, CanChange=True
    "hdr":     Initialize=0, CanChange=True
}

Function.Anim.WSet {
    Input: base: Integer
    Input: idx: Integer
    Input: f: Integer
    Input: v: Integer
    Output: Integer
    Body: {
        StoreValue(Add(base, Add(Multiply(idx, 64), Multiply(f, 8))), v)
        ReturnValue(0)
    }
}

Function.Anim.WGet {
    Input: base: Integer
    Input: idx: Integer
    Input: f: Integer
    Output: Integer
    Body: {
        ReturnValue(Dereference(Add(base, Add(Multiply(idx, 64), Multiply(f, 8)))))
    }
}

Function.Anim.Init {
    Output: Integer
    Body: {
        IfCondition EqualTo(Anim_State.ok, 1) ThenBlock: { ReturnValue(1) }
        SVG_Init()
        VIF_Init()
        Anim_State.cap_sh = 64
        Anim_State.cap_cl = 128
        Anim_State.cap_sp = 256
        Anim_State.sheets = Allocate(4096)
        Anim_State.clips = Allocate(8192)
        Anim_State.spr = Allocate(16384)
        IfCondition EqualTo(Anim_State.sheets, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Anim_State.clips, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Anim_State.spr, 0) ThenBlock: { ReturnValue(0) }
        Anim_State.nsh = 0
        Anim_State.ncl = 0
        Anim_State.nsp = 0
        Anim_State.dst = 0
        Anim_State.ok = 1
        ReturnValue(1)
    }
}

Function.Anim.BindFB {
    Output: Integer
    Body: {
        IfCondition EqualTo(Anim.Init(), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Anim_State.fb_ds, 0) ThenBlock: {
            Anim_State.fb_ds = Allocate(SurfaceConst.HEADER_SIZE)
        }
        ds = Anim_State.fb_ds
        buf = FB_GetDrawBuffer()
        IfCondition EqualTo(ds, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(buf, 0) ThenBlock: { ReturnValue(0) }
        StoreValue(Add(ds, SurfaceFields.FORMAT), SurfaceFormat.PIXEL_32)
        StoreValue(Add(ds, SurfaceFields.WIDTH), FB.width)
        StoreValue(Add(ds, SurfaceFields.HEIGHT), FB.height)
        StoreValue(Add(ds, SurfaceFields.PITCH), FB.pitch)
        StoreValue(Add(ds, SurfaceFields.DATA), buf)
        Anim_State.dst = ds
        ReturnValue(1)
    }
}

Function.Anim.BindSurf {
    Input: surf: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(Anim.Init(), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(surf, 0) ThenBlock: { ReturnValue(0) }
        Anim_State.dst = surf
        ReturnValue(1)
    }
}

Function.Anim.Dest {
    Output: Integer
    Body: { ReturnValue(Anim_State.dst) }
}

Function.Anim.AddSurf {
    Input: surf: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(Anim.Init(), 0) ThenBlock: { ReturnValue(-1) }
        IfCondition EqualTo(surf, 0) ThenBlock: { ReturnValue(-1) }
        i = Anim_State.nsh
        IfCondition GreaterEqual(i, Anim_State.cap_sh) ThenBlock: { ReturnValue(-1) }
        w = Surface_GetWidth(surf)
        h = Surface_GetHeight(surf)
        IfCondition LessThan(w, 1) ThenBlock: { ReturnValue(-1) }
        IfCondition LessThan(h, 1) ThenBlock: { ReturnValue(-1) }
        Anim.WSet(Anim_State.sheets, i, 0, surf)
        Anim.WSet(Anim_State.sheets, i, 1, w)
        Anim.WSet(Anim_State.sheets, i, 2, h)
        Anim.WSet(Anim_State.sheets, i, 3, 1)
        Anim.WSet(Anim_State.sheets, i, 4, 1)
        Anim.WSet(Anim_State.sheets, i, 5, w)
        Anim.WSet(Anim_State.sheets, i, 6, h)
        Anim.WSet(Anim_State.sheets, i, 7, 1)
        Anim_State.nsh = Add(i, 1)
        ReturnValue(i)
    }
}

Function.Anim.SetSurf {
    Input: sheet: Integer
    Input: surf: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(sheet, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition GreaterEqual(sheet, Anim_State.nsh) ThenBlock: { ReturnValue(-1) }
        IfCondition EqualTo(surf, 0) ThenBlock: { ReturnValue(-1) }
        w = Surface_GetWidth(surf)
        h = Surface_GetHeight(surf)
        IfCondition LessThan(w, 1) ThenBlock: { ReturnValue(-1) }
        IfCondition LessThan(h, 1) ThenBlock: { ReturnValue(-1) }
        old = Anim.WGet(Anim_State.sheets, sheet, 0)
        IfCondition NotEqual(old, 0) ThenBlock: {
            IfCondition NotEqual(old, surf) ThenBlock: { Surface_Destroy(old) }
        }
        cols = Anim.WGet(Anim_State.sheets, sheet, 3)
        rows = Anim.WGet(Anim_State.sheets, sheet, 4)
        IfCondition LessThan(cols, 1) ThenBlock: { cols = 1 }
        IfCondition LessThan(rows, 1) ThenBlock: { rows = 1 }
        Anim.WSet(Anim_State.sheets, sheet, 0, surf)
        Anim.WSet(Anim_State.sheets, sheet, 1, w)
        Anim.WSet(Anim_State.sheets, sheet, 2, h)
        fw = Divide(w, cols)
        fh = Divide(h, rows)
        IfCondition LessThan(fw, 1) ThenBlock: { fw = w }
        IfCondition LessThan(fh, 1) ThenBlock: { fh = h }
        Anim.WSet(Anim_State.sheets, sheet, 5, fw)
        Anim.WSet(Anim_State.sheets, sheet, 6, fh)
        ReturnValue(0)
    }
}

Function.Anim.KindOf {
    Input: path: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(path, 0) ThenBlock: { ReturnValue(0) }
        n = StringLength(path)
        IfCondition LessThan(n, 4) ThenBlock: { ReturnValue(0) }
        d = GetByte(path, Subtract(n, 4))
        a = GetByte(path, Subtract(n, 3))
        b = GetByte(path, Subtract(n, 2))
        c = GetByte(path, Subtract(n, 1))
        IfCondition NotEqual(d, 46) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(a, 115) ThenBlock: {
            IfCondition EqualTo(b, 118) ThenBlock: {
                IfCondition EqualTo(c, 103) ThenBlock: { ReturnValue(1) }
            }
        }
        IfCondition EqualTo(a, 116) ThenBlock: {
            IfCondition EqualTo(b, 118) ThenBlock: {
                IfCondition EqualTo(c, 103) ThenBlock: { ReturnValue(2) }
            }
        }
        IfCondition EqualTo(a, 118) ThenBlock: {
            IfCondition EqualTo(b, 105) ThenBlock: {
                IfCondition EqualTo(c, 102) ThenBlock: { ReturnValue(3) }
            }
        }
        ReturnValue(0)
    }
}

Function.Anim.LoadFile {
    Input: path: Address
    Input: px: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(Anim.Init(), 0) ThenBlock: { ReturnValue(-1) }
        IfCondition EqualTo(path, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition LessEqual(px, 0) ThenBlock: { px = 32 }
        surf = StyleRaster_LoadFile(path, px)
        IfCondition EqualTo(surf, 0) ThenBlock: { ReturnValue(-1) }
        ReturnValue(Anim.AddSurf(surf))
    }
}

Function.Anim.LoadWH {
    Input: path: Address
    Input: w: Integer
    Input: h: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(Anim.Init(), 0) ThenBlock: { ReturnValue(-1) }
        IfCondition EqualTo(path, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition LessEqual(w, 0) ThenBlock: { w = 32 }
        IfCondition LessEqual(h, 0) ThenBlock: { h = w }
        k = Anim.KindOf(path)
        surf = 0
        IfCondition EqualTo(k, 1) ThenBlock: {
            surf = SVG_RasterFile(path, w, h)
        }
        IfCondition EqualTo(k, 2) ThenBlock: {
            surf = TVG_RenderFile(path, h)
        }
        IfCondition EqualTo(k, 3) ThenBlock: {
            surf = TVG_RenderFile(path, h)
        }
        IfCondition EqualTo(surf, 0) ThenBlock: { ReturnValue(-1) }
        ReturnValue(Anim.AddSurf(surf))
    }
}

Function.Anim.Grid {
    Input: sheet: Integer
    Input: cols: Integer
    Input: rows: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(sheet, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition GreaterEqual(sheet, Anim_State.nsh) ThenBlock: { ReturnValue(-1) }
        IfCondition LessThan(cols, 1) ThenBlock: { cols = 1 }
        IfCondition LessThan(rows, 1) ThenBlock: { rows = 1 }
        w = Anim.WGet(Anim_State.sheets, sheet, 1)
        h = Anim.WGet(Anim_State.sheets, sheet, 2)
        fw = Divide(w, cols)
        fh = Divide(h, rows)
        IfCondition LessThan(fw, 1) ThenBlock: { ReturnValue(-1) }
        IfCondition LessThan(fh, 1) ThenBlock: { ReturnValue(-1) }
        Anim.WSet(Anim_State.sheets, sheet, 3, cols)
        Anim.WSet(Anim_State.sheets, sheet, 4, rows)
        Anim.WSet(Anim_State.sheets, sheet, 5, fw)
        Anim.WSet(Anim_State.sheets, sheet, 6, fh)
        Anim.WSet(Anim_State.sheets, sheet, 7, Multiply(cols, rows))
        ReturnValue(Anim.WGet(Anim_State.sheets, sheet, 7))
    }
}

Function.Anim.Clip {
    Input: sheet: Integer
    Input: f0: Integer
    Input: f1: Integer
    Input: dt_ms: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(sheet, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition GreaterEqual(sheet, Anim_State.nsh) ThenBlock: { ReturnValue(-1) }
        nf = Anim.WGet(Anim_State.sheets, sheet, 7)
        IfCondition LessThan(nf, 1) ThenBlock: { nf = 1 }
        IfCondition LessThan(f0, 0) ThenBlock: { f0 = 0 }
        IfCondition GreaterEqual(f0, nf) ThenBlock: { f0 = Subtract(nf, 1) }
        IfCondition LessThan(f1, f0) ThenBlock: { f1 = f0 }
        IfCondition GreaterEqual(f1, nf) ThenBlock: { f1 = Subtract(nf, 1) }
        i = Anim_State.ncl
        IfCondition GreaterEqual(i, Anim_State.cap_cl) ThenBlock: { ReturnValue(-1) }
        Anim.WSet(Anim_State.clips, i, 0, sheet)
        Anim.WSet(Anim_State.clips, i, 1, f0)
        Anim.WSet(Anim_State.clips, i, 2, f1)
        Anim.WSet(Anim_State.clips, i, 3, dt_ms)
        Anim.WSet(Anim_State.clips, i, 4, AnimClipFlag.LOOP)
        Anim_State.ncl = Add(i, 1)
        ReturnValue(i)
    }
}

Function.Anim.ClipLoop {
    Input: clip: Integer
    Input: on: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(clip, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition GreaterEqual(clip, Anim_State.ncl) ThenBlock: { ReturnValue(-1) }
        fl = 0
        IfCondition NotEqual(on, 0) ThenBlock: { fl = AnimClipFlag.LOOP }
        Anim.WSet(Anim_State.clips, clip, 4, fl)
        ReturnValue(0)
    }
}

Function.Anim.Spawn {
    Input: clip: Integer
    Input: x: Integer
    Input: y: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(clip, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition GreaterEqual(clip, Anim_State.ncl) ThenBlock: { ReturnValue(-1) }
        i = Anim_State.nsp
        IfCondition GreaterEqual(i, Anim_State.cap_sp) ThenBlock: { ReturnValue(-1) }
        dt = Anim.WGet(Anim_State.clips, clip, 3)
        fl = AnimSprFlag.VIS
        IfCondition GreaterThan(dt, 0) ThenBlock: {
            fl = Add(fl, AnimSprFlag.PLAY)
        }
        Anim.WSet(Anim_State.spr, i, 0, clip)
        Anim.WSet(Anim_State.spr, i, 1, x)
        Anim.WSet(Anim_State.spr, i, 2, y)
        Anim.WSet(Anim_State.spr, i, 3, 0)
        Anim.WSet(Anim_State.spr, i, 4, 0)
        Anim.WSet(Anim_State.spr, i, 5, fl)
        Anim.WSet(Anim_State.spr, i, 6, 0)
        Anim.WSet(Anim_State.spr, i, 7, 0)
        Anim_State.nsp = Add(i, 1)
        ReturnValue(i)
    }
}

Function.Anim.Place {
    Input: id: Integer
    Input: x: Integer
    Input: y: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(id, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition GreaterEqual(id, Anim_State.nsp) ThenBlock: { ReturnValue(-1) }
        Anim.WSet(Anim_State.spr, id, 1, x)
        Anim.WSet(Anim_State.spr, id, 2, y)
        ReturnValue(0)
    }
}

Function.Anim.Hot {
    Input: id: Integer
    Input: ox: Integer
    Input: oy: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(id, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition GreaterEqual(id, Anim_State.nsp) ThenBlock: { ReturnValue(-1) }
        Anim.WSet(Anim_State.spr, id, 6, ox)
        Anim.WSet(Anim_State.spr, id, 7, oy)
        ReturnValue(0)
    }
}

Function.Anim.Show {
    Input: id: Integer
    Input: on: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(id, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition GreaterEqual(id, Anim_State.nsp) ThenBlock: { ReturnValue(-1) }
        fl = Anim.WGet(Anim_State.spr, id, 5)
        bit = AnimSprFlag.VIS
        IfCondition EqualTo(on, 0) ThenBlock: {
            IfCondition NotEqual(BitwiseAnd(fl, bit), 0) ThenBlock: {
                fl = Subtract(fl, bit)
            }
        }
        IfCondition NotEqual(on, 0) ThenBlock: {
            IfCondition EqualTo(BitwiseAnd(fl, bit), 0) ThenBlock: {
                fl = Add(fl, bit)
            }
        }
        Anim.WSet(Anim_State.spr, id, 5, fl)
        ReturnValue(0)
    }
}

Function.Anim.Play {
    Input: id: Integer
    Input: on: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(id, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition GreaterEqual(id, Anim_State.nsp) ThenBlock: { ReturnValue(-1) }
        fl = Anim.WGet(Anim_State.spr, id, 5)
        bit = AnimSprFlag.PLAY
        IfCondition EqualTo(on, 0) ThenBlock: {
            IfCondition NotEqual(BitwiseAnd(fl, bit), 0) ThenBlock: {
                fl = Subtract(fl, bit)
            }
        }
        IfCondition NotEqual(on, 0) ThenBlock: {
            IfCondition EqualTo(BitwiseAnd(fl, bit), 0) ThenBlock: {
                fl = Add(fl, bit)
            }
        }
        Anim.WSet(Anim_State.spr, id, 5, fl)
        ReturnValue(0)
    }
}

Function.Anim.Span {
    Input: clip: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(clip, 0) ThenBlock: { ReturnValue(1) }
        IfCondition GreaterEqual(clip, Anim_State.ncl) ThenBlock: { ReturnValue(1) }
        f0 = Anim.WGet(Anim_State.clips, clip, 1)
        f1 = Anim.WGet(Anim_State.clips, clip, 2)
        n = Add(Subtract(f1, f0), 1)
        IfCondition LessThan(n, 1) ThenBlock: { n = 1 }
        ReturnValue(n)
    }
}

Function.Anim.SetFrame {
    Input: id: Integer
    Input: f: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(id, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition GreaterEqual(id, Anim_State.nsp) ThenBlock: { ReturnValue(-1) }
        clip = Anim.WGet(Anim_State.spr, id, 0)
        n = Anim.Span(clip)
        IfCondition LessThan(f, 0) ThenBlock: { f = 0 }
        IfCondition GreaterEqual(f, n) ThenBlock: { f = Subtract(n, 1) }
        Anim.WSet(Anim_State.spr, id, 3, f)
        ReturnValue(f)
    }
}

Function.Anim.MapSpan {
    Input: id: Integer
    Input: v: Integer
    Input: lo: Integer
    Input: hi: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(id, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition GreaterEqual(id, Anim_State.nsp) ThenBlock: { ReturnValue(-1) }
        clip = Anim.WGet(Anim_State.spr, id, 0)
        n = Anim.Span(clip)
        last = Subtract(n, 1)
        IfCondition LessThan(last, 0) ThenBlock: { last = 0 }
        span = Subtract(hi, lo)
        IfCondition EqualTo(span, 0) ThenBlock: {
            ReturnValue(Anim.SetFrame(id, 0))
        }
        t = Subtract(v, lo)
        IfCondition LessThan(t, 0) ThenBlock: { t = 0 }
        IfCondition GreaterThan(t, span) ThenBlock: { t = span }
        IfCondition LessThan(span, 0) ThenBlock: {
            t = Subtract(lo, v)
            span = Subtract(lo, hi)
            IfCondition LessThan(t, 0) ThenBlock: { t = 0 }
            IfCondition GreaterThan(t, span) ThenBlock: { t = span }
        }
        f = Divide(Multiply(t, last), span)
        ReturnValue(Anim.SetFrame(id, f))
    }
}

Function.Anim.TickOne {
    Input: id: Integer
    Input: dt_ms: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(id, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition GreaterEqual(id, Anim_State.nsp) ThenBlock: { ReturnValue(-1) }
        IfCondition LessEqual(dt_ms, 0) ThenBlock: { ReturnValue(0) }
        fl = Anim.WGet(Anim_State.spr, id, 5)
        IfCondition EqualTo(BitwiseAnd(fl, AnimSprFlag.PLAY), 0) ThenBlock: { ReturnValue(0) }
        clip = Anim.WGet(Anim_State.spr, id, 0)
        step = Anim.WGet(Anim_State.clips, clip, 3)
        IfCondition LessEqual(step, 0) ThenBlock: { ReturnValue(0) }
        acc = Add(Anim.WGet(Anim_State.spr, id, 4), dt_ms)
        f = Anim.WGet(Anim_State.spr, id, 3)
        n = Anim.Span(clip)
        loop = Anim.WGet(Anim_State.clips, clip, 4)
        more = 1
        WhileLoop EqualTo(more, 1) {
            IfCondition LessThan(acc, step) ThenBlock: { more = 0 }
            IfCondition EqualTo(more, 1) ThenBlock: {
                acc = Subtract(acc, step)
                f = Add(f, 1)
                IfCondition GreaterEqual(f, n) ThenBlock: {
                    IfCondition NotEqual(BitwiseAnd(loop, AnimClipFlag.LOOP), 0) ThenBlock: {
                        f = 0
                    }
                    IfCondition EqualTo(BitwiseAnd(loop, AnimClipFlag.LOOP), 0) ThenBlock: {
                        f = Subtract(n, 1)
                        IfCondition NotEqual(BitwiseAnd(fl, AnimSprFlag.PLAY), 0) ThenBlock: {
                            fl = Subtract(fl, AnimSprFlag.PLAY)
                        }
                        Anim.WSet(Anim_State.spr, id, 5, fl)
                        more = 0
                    }
                }
            }
        }
        Anim.WSet(Anim_State.spr, id, 3, f)
        Anim.WSet(Anim_State.spr, id, 4, acc)
        ReturnValue(f)
    }
}

Function.Anim.Tick {
    Input: dt_ms: Integer
    Output: Integer
    Body: {
        i = 0
        n = Anim_State.nsp
        WhileLoop LessThan(i, n) {
            Anim.TickOne(i, dt_ms)
            i = Add(i, 1)
        }
        ReturnValue(n)
    }
}

Function.Anim.Draw {
    Input: id: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(Anim_State.dst, 0) ThenBlock: {
            IfCondition EqualTo(Anim.BindFB(), 0) ThenBlock: { ReturnValue(-1) }
        }
        IfCondition LessThan(id, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition GreaterEqual(id, Anim_State.nsp) ThenBlock: { ReturnValue(-1) }
        fl = Anim.WGet(Anim_State.spr, id, 5)
        IfCondition EqualTo(BitwiseAnd(fl, AnimSprFlag.VIS), 0) ThenBlock: { ReturnValue(0) }
        clip = Anim.WGet(Anim_State.spr, id, 0)
        sheet = Anim.WGet(Anim_State.clips, clip, 0)
        f0 = Anim.WGet(Anim_State.clips, clip, 1)
        fr = Anim.WGet(Anim_State.spr, id, 3)
        absf = Add(f0, fr)
        cols = Anim.WGet(Anim_State.sheets, sheet, 3)
        fw = Anim.WGet(Anim_State.sheets, sheet, 5)
        fh = Anim.WGet(Anim_State.sheets, sheet, 6)
        surf = Anim.WGet(Anim_State.sheets, sheet, 0)
        IfCondition EqualTo(surf, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition LessThan(cols, 1) ThenBlock: { cols = 1 }
        sx = Multiply(Modulo(absf, cols), fw)
        sy = Multiply(Divide(absf, cols), fh)
        dx = Subtract(Anim.WGet(Anim_State.spr, id, 1), Anim.WGet(Anim_State.spr, id, 6))
        dy = Subtract(Anim.WGet(Anim_State.spr, id, 2), Anim.WGet(Anim_State.spr, id, 7))
        Surface_BlitRegionSetup(fw, fh, dx, dy)
        Surface_BlitRegion(Anim_State.dst, surf, sx, sy)
        ReturnValue(1)
    }
}

Function.Anim.DrawClipped {
    Input: id: Integer
    Input: cx: Integer
    Input: cy: Integer
    Input: cw: Integer
    Input: ch: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(Anim_State.dst, 0) ThenBlock: {
            IfCondition EqualTo(Anim.BindFB(), 0) ThenBlock: { ReturnValue(-1) }
        }
        IfCondition LessThan(id, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition GreaterEqual(id, Anim_State.nsp) ThenBlock: { ReturnValue(-1) }
        fl = Anim.WGet(Anim_State.spr, id, 5)
        IfCondition EqualTo(BitwiseAnd(fl, AnimSprFlag.VIS), 0) ThenBlock: { ReturnValue(0) }
        clip = Anim.WGet(Anim_State.spr, id, 0)
        sheet = Anim.WGet(Anim_State.clips, clip, 0)
        f0 = Anim.WGet(Anim_State.clips, clip, 1)
        fr = Anim.WGet(Anim_State.spr, id, 3)
        absf = Add(f0, fr)
        cols = Anim.WGet(Anim_State.sheets, sheet, 3)
        fw = Anim.WGet(Anim_State.sheets, sheet, 5)
        fh = Anim.WGet(Anim_State.sheets, sheet, 6)
        surf = Anim.WGet(Anim_State.sheets, sheet, 0)
        IfCondition EqualTo(surf, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition LessThan(cols, 1) ThenBlock: { cols = 1 }
        sx = Multiply(Modulo(absf, cols), fw)
        sy = Multiply(Divide(absf, cols), fh)
        dx = Subtract(Anim.WGet(Anim_State.spr, id, 1), Anim.WGet(Anim_State.spr, id, 6))
        dy = Subtract(Anim.WGet(Anim_State.spr, id, 2), Anim.WGet(Anim_State.spr, id, 7))
        IfCondition LessThan(dx, cx) ThenBlock: {
            d = Subtract(cx, dx)
            sx = Add(sx, d)
            fw = Subtract(fw, d)
            dx = cx
        }
        IfCondition LessThan(dy, cy) ThenBlock: {
            d = Subtract(cy, dy)
            sy = Add(sy, d)
            fh = Subtract(fh, d)
            dy = cy
        }
        IfCondition GreaterThan(Add(dx, fw), Add(cx, cw)) ThenBlock: {
            fw = Subtract(Add(cx, cw), dx)
        }
        IfCondition GreaterThan(Add(dy, fh), Add(cy, ch)) ThenBlock: {
            fh = Subtract(Add(cy, ch), dy)
        }
        IfCondition LessThan(fw, 1) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(fh, 1) ThenBlock: { ReturnValue(0) }
        Surface_BlitRegionSetup(fw, fh, dx, dy)
        Surface_BlitRegion(Anim_State.dst, surf, sx, sy)
        ReturnValue(1)
    }
}

Function.Anim.DrawAll {
    Output: Integer
    Body: {
        IfCondition EqualTo(Anim_State.dst, 0) ThenBlock: {
            IfCondition EqualTo(Anim.BindFB(), 0) ThenBlock: { ReturnValue(-1) }
        }
        i = 0
        n = Anim_State.nsp
        d = 0
        WhileLoop LessThan(i, n) {
            r = Anim.Draw(i)
            IfCondition EqualTo(r, 1) ThenBlock: { d = Add(d, 1) }
            i = Add(i, 1)
        }
        ReturnValue(d)
    }
}

Function.Anim.SheetCount {
    Output: Integer
    Body: { ReturnValue(Anim_State.nsh) }
}

Function.Anim.ClipCount {
    Output: Integer
    Body: { ReturnValue(Anim_State.ncl) }
}

Function.Anim.SpriteCount {
    Output: Integer
    Body: { ReturnValue(Anim_State.nsp) }
}

Function.Anim.X {
    Input: id: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(id, 0) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterEqual(id, Anim_State.nsp) ThenBlock: { ReturnValue(0) }
        ReturnValue(Anim.WGet(Anim_State.spr, id, 1))
    }
}

Function.Anim.Y {
    Input: id: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(id, 0) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterEqual(id, Anim_State.nsp) ThenBlock: { ReturnValue(0) }
        ReturnValue(Anim.WGet(Anim_State.spr, id, 2))
    }
}

Function.Anim.FrameOf {
    Input: id: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(id, 0) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterEqual(id, Anim_State.nsp) ThenBlock: { ReturnValue(0) }
        ReturnValue(Anim.WGet(Anim_State.spr, id, 3))
    }
}

// IPC present — same contract as ecu_app: meta.bin + frame.raw + gen.txt.
// Thin GTK host blits /tmp/anim_app/frame.raw when gen.txt changes.

Function.Anim.LE32 {
    Input: buf: Address
    Input: off: Integer
    Input: val: Integer
    Output: Integer
    Body: {
        SetByte(buf, off, BitwiseAnd(val, 255))
        SetByte(buf, Add(off, 1), BitwiseAnd(ShiftRight(val, 8), 255))
        SetByte(buf, Add(off, 2), BitwiseAnd(ShiftRight(val, 16), 255))
        SetByte(buf, Add(off, 3), BitwiseAnd(ShiftRight(val, 24), 255))
        ReturnValue(0)
    }
}

Function.Anim.EnsureIpc {
    Output: Integer
    Body: {
        SystemCall(83, "/tmp/anim_app", 493)
        fd = SystemCall(2, "/tmp/anim_app/cmd.txt", 577, 420)
        IfCondition GreaterEqual(fd, 0) ThenBlock: { SystemCall(3, fd, 0, 0) }
        ReturnValue(1)
    }
}

Function.Anim.Present {
    Output: Integer
    Body: {
        IfCondition EqualTo(Anim.Init(), 0) ThenBlock: { ReturnValue(-1) }
        Anim.EnsureIpc()
        w = FB.width
        h = FB.height
        pitch = FB.pitch
        buf = FB_GetDrawBuffer()
        IfCondition EqualTo(buf, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition EqualTo(Anim_State.hdr, 0) ThenBlock: { Anim_State.hdr = Allocate(16) }
        hdr = Anim_State.hdr
        Anim.LE32(hdr, 0, w)
        Anim.LE32(hdr, 4, h)
        Anim.LE32(hdr, 8, pitch)
        fd = SystemCall(2, "/tmp/anim_app/meta.bin", 577, 420)
        IfCondition LessThan(fd, 0) ThenBlock: { ReturnValue(-2) }
        SystemCall(1, fd, hdr, 12)
        SystemCall(3, fd, 0, 0)
        fd = SystemCall(2, "/tmp/anim_app/frame.tmp", 577, 420)
        IfCondition LessThan(fd, 0) ThenBlock: { ReturnValue(-3) }
        SystemCall(1, fd, buf, Multiply(pitch, h))
        SystemCall(3, fd, 0, 0)
        SystemCall(82, "/tmp/anim_app/frame.tmp", "/tmp/anim_app/frame.raw")
        Anim_State.gen = Add(Anim_State.gen, 1)
        IfCondition EqualTo(Anim_State.genb, 0) ThenBlock: {
            Anim_State.genb = Allocate(32)
        }
        gbuf = Anim_State.genb
        tmp = Add(gbuf, 16)
        g = Anim_State.gen
        IfCondition LessThan(g, 1) ThenBlock: { g = 1 }
        n = 0
        WhileLoop GreaterThan(g, 0) {
            IfCondition LessThan(n, 12) ThenBlock: {
                SetByte(tmp, n, Add(48, Modulo(g, 10)))
                n = Add(n, 1)
            }
            g = Divide(g, 10)
        }
        i = 0
        WhileLoop LessThan(i, n) {
            SetByte(gbuf, i, GetByte(tmp, Subtract(Subtract(n, 1), i)))
            i = Add(i, 1)
        }
        SetByte(gbuf, n, 10)
        fd = SystemCall(2, "/tmp/anim_app/gen.tmp", 577, 420)
        IfCondition LessThan(fd, 0) ThenBlock: { ReturnValue(-4) }
        SystemCall(1, fd, gbuf, Add(n, 1))
        SystemCall(3, fd, 0, 0)
        SystemCall(82, "/tmp/anim_app/gen.tmp", "/tmp/anim_app/gen.txt")
        ReturnValue(0)
    }
}

Function.Anim.NowMs {
    Output: Integer
    Body: {
        IfCondition EqualTo(Anim_State.ts, 0) ThenBlock: {
            Anim_State.ts = Allocate(16)
        }
        SystemCall(228, 1, Anim_State.ts)
        sec = Dereference(Anim_State.ts)
        nsec = Dereference(Add(Anim_State.ts, 8))
        ReturnValue(Add(Multiply(sec, 1000), Divide(nsec, 1000000)))
    }
}

Function.Anim.Sleep {
    Input: ms: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(Anim_State.ts, 0) ThenBlock: {
            Anim_State.ts = Allocate(16)
        }
        IfCondition LessThan(ms, 1) ThenBlock: { ms = 1 }
        sec = Divide(ms, 1000)
        nsec = Multiply(Modulo(ms, 1000), 1000000)
        StoreValue(Anim_State.ts, sec)
        StoreValue(Add(Anim_State.ts, 8), nsec)
        SystemCall(35, Anim_State.ts, 0)
        ReturnValue(0)
    }
}

Function.Anim.PollQuit {
    Output: Integer
    Body: {
        IfCondition EqualTo(Anim_State.cmd, 0) ThenBlock: {
            Anim_State.cmd = Allocate(64)
        }
        fd = SystemCall(2, "/tmp/anim_app/cmd.txt", 0, 0)
        IfCondition LessThan(fd, 0) ThenBlock: { ReturnValue(0) }
        n = SystemCall(0, fd, Anim_State.cmd, 32)
        SystemCall(3, fd, 0, 0)
        IfCondition LessEqual(n, 0) ThenBlock: { ReturnValue(0) }
        c = GetByte(Anim_State.cmd, 0)
        IfCondition EqualTo(c, 0) ThenBlock: { ReturnValue(0) }
        fd2 = SystemCall(2, "/tmp/anim_app/cmd.txt", 577, 420)
        IfCondition GreaterEqual(fd2, 0) ThenBlock: { SystemCall(3, fd2, 0, 0) }
        IfCondition EqualTo(c, 113) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}
