// Library.AppHost.ailang
// Generic HTML application host — opens any app from an HTML file
//
// The HTML file is the single source of truth:
//   <window title="..." design-w="..." design-h="...">
//     ... UI markup ...
//   </window>
//
// AppHost handles all generic plumbing: window creation, toolbar,
// AK context, HTML parsing, rendering, content context registration.
// Apps only provide an action callback for their domain logic.
//
// Copyright 2026 Sean Collins, 2 Paws Machine and Engineering. SCSL.

LibraryImport.Display.Render.DSurfaceTypes
LibraryImport.Display.Render.DSurface
LibraryImport.Display.Render.DDrawPixel
LibraryImport.Display.Window.WinManager
LibraryImport.Display.Window.WinToolbar
LibraryImport.Display.UI.Auckland
LibraryImport.Display.UI.AucklandEvent
LibraryImport.Display.UI.AucklandBind
LibraryImport.Display.Content.HTMLParse
LibraryImport.Display.Render.Fonts
LibraryImport.Display.UI.TextRegion
LibraryImport.Display.Theme.UIScale
LibraryImport.Display.Theme.UITheme
LibraryImport.Display.UI.PaneDecorator

// =============================================================================
// APPHOST_OPEN — open a window from an HTML file
//
// Parses the HTML, extracts window metadata (title, dimensions) from
// the <window> root tag, creates the window, wires up the action
// callback, renders, and registers the content context.
//
// Returns window index (>= 1) on success, 0 on failure.
// =============================================================================
Function.AppHost_Open {
    Input: html_file: Address
    Input: action_cb: Address
    Output: Integer
    Body: {
        DebugLog_Push("ah.open", 7)

        // Create Auckland context
        ak_ctx = AK_CreateContext()
        IfCondition EqualTo(ak_ctx, 0) ThenBlock: {
            PrintMessage("[AppHost] AK_CreateContext fail\n")
            ReturnValue(0)
        }

        // Resolve relative config paths for VM deployment.
        // "config/foo.html" → "/system/config/foo.html"
        resolved = html_file
        c0 = GetByte(html_file, 0)
        IfCondition EqualTo(c0, 99) ThenBlock: {
            c1 = GetByte(html_file, 1)
            c2 = GetByte(html_file, 2)
            c3 = GetByte(html_file, 3)
            c4 = GetByte(html_file, 4)
            c5 = GetByte(html_file, 5)
            c6 = GetByte(html_file, 6)
            // Check "config/" = 99 111 110 102 105 103 47
            IfCondition And(EqualTo(c1, 111), And(EqualTo(c2, 110), And(EqualTo(c3, 102), And(EqualTo(c4, 105), And(EqualTo(c5, 103), EqualTo(c6, 47)))))) ThenBlock: {
                // Prepend "/system/" — build "/system/config/..."
                flen = StringLength(html_file)
                rbuf = Allocate(Add(flen, 9))
                prefix = "/system/"
                pi = 0
                WhileLoop LessThan(pi, 8) {
                    SetByte(rbuf, pi, GetByte(prefix, pi))
                    pi = Add(pi, 1)
                }
                fi = 0
                WhileLoop LessThan(fi, flen) {
                    SetByte(rbuf, Add(8, fi), GetByte(html_file, fi))
                    fi = Add(fi, 1)
                }
                SetByte(rbuf, Add(8, flen), 0)
                resolved = rbuf
            }
        }

        // Parse HTML file — builds AK tree, sets design_w/design_h
        HTML_Reset()
        root = AKParse_File(ak_ctx, resolved)
        IfCondition LessThan(root, 0) ThenBlock: {
            PrintMessage("[AppHost] HTML parse fail: ")
            PrintMessage(html_file)
            PrintMessage("\n")
            AK_DestroyContext(ak_ctx)
            ReturnValue(0)
        }

        // Read window dimensions from context (set by design-w/design-h attrs)
        win_w = AK_GetDesignW(ak_ctx)
        win_h = AK_GetDesignH(ak_ctx)

        // Read title from root node if it's a WINDOW tag
        title = "Application"
        tag = AK_Get(ak_ctx, root, AKF.TAG)
        IfCondition EqualTo(tag, AKTag.WINDOW) ThenBlock: {
            t = AK_ExtraGet(ak_ctx, root, AKExtra.STR_PTR)
            IfCondition NotEqual(t, 0) ThenBlock: {
                title = t
            }
        }

        // Read toolbar mode (set by toolbar= attribute, defaults to ABOUT)
        tb_mode = AK_GetToolbarMode(ak_ctx)

        // Create window
        win_idx = Win_Create(win_w, win_h, WinColor.WINDOW, title)
        IfCondition LessEqual(win_idx, 0) ThenBlock: {
            PrintMessage("[AppHost] Win_Create fail\n")
            AK_DestroyContext(ak_ctx)
            ReturnValue(0)
        }

        // Create toolbar from HTML-declared mode (shell windows have none)
        IfCondition EqualTo(AK_GetShellMode(ak_ctx), 0) ThenBlock: {
            Win_CreateToolbarApp(win_idx, tb_mode, title)
        }
        IfCondition EqualTo(AK_GetShellMode(ak_ctx), 1) ThenBlock: {
            Win_BecomeShell(win_idx)
        }

        // Create address bar if requested by HTML config
        has_addr = AK_GetAddressBar(ak_ctx)
        IfCondition EqualTo(has_addr, 1) ThenBlock: {
            Win_CreateAddressBar(win_idx)
        }

        // Update design dimensions to actual canvas size (post-toolbar)
        cw = Win_GetCanvasW(win_idx)
        ch = Win_GetCanvasH(win_idx)
        AK_SetDesignW(ak_ctx, cw)
        AK_SetDesignH(ak_ctx, ch)

        // Set action callback
        AK_SetActionCb(ak_ctx, action_cb)

        // Initial render
        content = WinMgr_GetContent(win_idx)
        VFont_UseSize(UIScale.font_body)
        AK_Draw(ak_ctx, content, cw, ch)

        // Register content context on window (for generic mouse routing)
        WinView_SetContentCtx(win_idx, ak_ctx)

        SysDisplayState.dirty = 1
        PrintMessage("[AppHost] opened '")
        PrintMessage(html_file)
        PrintMessage("' win=")
        PrintNumber(win_idx)
        PrintMessage(" size=")
        PrintNumber(cw)
        PrintMessage("x")
        PrintNumber(ch)
        PrintMessage("\n")
        ReturnValue(win_idx)
    }
}

// =============================================================================
// APPHOST_CLOSE — destroy context and close window
//
// Generic teardown for any AppHost-opened window.
// =============================================================================
Function.AppHost_Close {
    Input: win_idx: Integer
    Body: {
        DebugLog_Push("ah.cls", 6)
        IfCondition LessEqual(win_idx, 0) ThenBlock: { ReturnValue(0) }

        // Unregister content context
        ctx = WinView_GetContentCtx(win_idx)
        WinView_SetContentCtx(win_idx, 0)

        // Destroy Auckland context
        IfCondition NotEqual(ctx, 0) ThenBlock: {
            AK_FreeContextTR(ctx)
            AK_DestroyContext(ctx)
        }

        // Close window
        Win_Close(win_idx)
        SysDisplayState.dirty = 1
        PrintMessage("[AppHost] closed win=")
        PrintNumber(win_idx)
        PrintMessage("\n")
    }
}
