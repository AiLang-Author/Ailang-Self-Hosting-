// Library.Arena.ailang
// Slab allocator for fixed-size allocations
// Eliminates per-allocation mmap overhead
//
// Design:
//   - mmap large chunks (4MB) once
//   - Divide into fixed-size blocks (24, 32, 64, 128 bytes)
//   - Free list per size class
//   - Allocate = pop from free list or bump pointer
//   - Deallocate = push to free list (instant reuse)

// =============================================================================
// CONSTANTS
// =============================================================================
FixedPool.ArenaConst {
    "CHUNK_SIZE": Initialize=4194304    // 4MB per chunk
    "SLAB_24": Initialize=24
    "SLAB_32": Initialize=32
    "SLAB_64": Initialize=64
    "SLAB_128": Initialize=128
    "SLAB_256": Initialize=256
}

// =============================================================================
// SLAB STATE - One per size class
// =============================================================================
FixedPool.Slab24 {
    "chunk": Initialize=0           // Current chunk base address
    "next": Initialize=0            // Next free slot (bump pointer)
    "end": Initialize=0             // End of current chunk
    "free_list": Initialize=0       // Head of free list (reusable blocks)
    "alloc_count": Initialize=0     // Stats
    "free_count": Initialize=0
    "chunk_count": Initialize=0
}

FixedPool.Slab32 {
    "chunk": Initialize=0
    "next": Initialize=0
    "end": Initialize=0
    "free_list": Initialize=0
    "alloc_count": Initialize=0
    "free_count": Initialize=0
    "chunk_count": Initialize=0
}

FixedPool.Slab64 {
    "chunk": Initialize=0
    "next": Initialize=0
    "end": Initialize=0
    "free_list": Initialize=0
    "alloc_count": Initialize=0
    "free_count": Initialize=0
    "chunk_count": Initialize=0
}

FixedPool.Slab128 {
    "chunk": Initialize=0
    "next": Initialize=0
    "end": Initialize=0
    "free_list": Initialize=0
    "alloc_count": Initialize=0
    "free_count": Initialize=0
    "chunk_count": Initialize=0
}

// General arena for large/variable allocations
FixedPool.ArenaGeneral {
    "chunk": Initialize=0
    "next": Initialize=0
    "end": Initialize=0
    "alloc_count": Initialize=0
    "chunk_count": Initialize=0
    "fallback_count": Initialize=0  // Times we fell back to raw mmap
}

// =============================================================================
// INITIALIZATION
// =============================================================================
Function.Arena_Init {
    Body: {
        // Initialize 24-byte slab
        Arena_InitSlab24()
        
        // Initialize 32-byte slab
        Arena_InitSlab32()
        
        // Initialize 64-byte slab  
        Arena_InitSlab64()
        
        // Initialize 128-byte slab
        Arena_InitSlab128()
        
        // Initialize general arena
        Arena_InitGeneral()
        
        ReturnValue(1)
    }
}

Function.Arena_InitSlab24 {
    Body: {
        chunk = Arena_MmapChunk()
        Slab24.chunk = chunk
        Slab24.next = chunk
        Slab24.end = Add(chunk, ArenaConst.CHUNK_SIZE)
        Slab24.free_list = 0
        Slab24.alloc_count = 0
        Slab24.free_count = 0
        Slab24.chunk_count = 1
    }
}

Function.Arena_InitSlab32 {
    Body: {
        chunk = Arena_MmapChunk()
        Slab32.chunk = chunk
        Slab32.next = chunk
        Slab32.end = Add(chunk, ArenaConst.CHUNK_SIZE)
        Slab32.free_list = 0
        Slab32.alloc_count = 0
        Slab32.free_count = 0
        Slab32.chunk_count = 1
    }
}

Function.Arena_InitSlab64 {
    Body: {
        chunk = Arena_MmapChunk()
        Slab64.chunk = chunk
        Slab64.next = chunk
        Slab64.end = Add(chunk, ArenaConst.CHUNK_SIZE)
        Slab64.free_list = 0
        Slab64.alloc_count = 0
        Slab64.free_count = 0
        Slab64.chunk_count = 1
    }
}

Function.Arena_InitSlab128 {
    Body: {
        chunk = Arena_MmapChunk()
        Slab128.chunk = chunk
        Slab128.next = chunk
        Slab128.end = Add(chunk, ArenaConst.CHUNK_SIZE)
        Slab128.free_list = 0
        Slab128.alloc_count = 0
        Slab128.free_count = 0
        Slab128.chunk_count = 1
    }
}

Function.Arena_InitGeneral {
    Body: {
        chunk = Arena_MmapChunk()
        ArenaGeneral.chunk = chunk
        ArenaGeneral.next = chunk
        ArenaGeneral.end = Add(chunk, ArenaConst.CHUNK_SIZE)
        ArenaGeneral.alloc_count = 0
        ArenaGeneral.chunk_count = 1
        ArenaGeneral.fallback_count = 0
    }
}

// =============================================================================
// RAW MMAP - Get a new chunk from kernel
// =============================================================================
Function.Arena_MmapChunk {
    Output: Address
    Body: {
        // mmap(NULL, CHUNK_SIZE, PROT_READ|PROT_WRITE, MAP_PRIVATE|MAP_ANONYMOUS, -1, 0)
        // syscall 9: rdi=addr, rsi=len, rdx=prot, r10=flags, r8=fd, r9=offset
        addr = SystemCall(9, 0, ArenaConst.CHUNK_SIZE, 3, 34, -1, 0)
        
        IfCondition LessThan(addr, 0) ThenBlock: {
            PrintMessage("[ARENA] FATAL: mmap failed!\n")
            Exit(1)
        }
        
        ReturnValue(addr)
    }
}

// =============================================================================
// SLAB 24 - Allocate/Free 24-byte blocks
// =============================================================================
Function.Arena_Alloc24 {
    Output: Address
    Body: {
        Slab24.alloc_count = Add(Slab24.alloc_count, 1)
        
        // Check free list first (instant reuse)
        IfCondition NotEqual(Slab24.free_list, 0) ThenBlock: {
            ptr = Slab24.free_list
            // Free list stores next pointer at [ptr]
            Slab24.free_list = Dereference(ptr)
            ReturnValue(ptr)
        }
        
        // Bump allocate
        IfCondition GreaterEqual(Add(Slab24.next, 24), Slab24.end) ThenBlock: {
            // Need new chunk
            Arena_GrowSlab24()
        }
        
        ptr = Slab24.next
        Slab24.next = Add(Slab24.next, 24)
        ReturnValue(ptr)
    }
}

Function.Arena_Free24 {
    Input: ptr: Address
    Body: {
        Slab24.free_count = Add(Slab24.free_count, 1)
        
        // Push to free list (store current head at ptr, update head)
        StoreValue(ptr, Slab24.free_list)
        Slab24.free_list = ptr
    }
}

Function.Arena_GrowSlab24 {
    Body: {
        // Allocate new chunk
        chunk = Arena_MmapChunk()
        Slab24.chunk = chunk
        Slab24.next = chunk
        Slab24.end = Add(chunk, ArenaConst.CHUNK_SIZE)
        Slab24.chunk_count = Add(Slab24.chunk_count, 1)
    }
}

// =============================================================================
// SLAB 32 - Allocate/Free 32-byte blocks
// =============================================================================
Function.Arena_Alloc32 {
    Output: Address
    Body: {
        Slab32.alloc_count = Add(Slab32.alloc_count, 1)
        
        IfCondition NotEqual(Slab32.free_list, 0) ThenBlock: {
            ptr = Slab32.free_list
            Slab32.free_list = Dereference(ptr)
            ReturnValue(ptr)
        }
        
        IfCondition GreaterEqual(Add(Slab32.next, 32), Slab32.end) ThenBlock: {
            Arena_GrowSlab32()
        }
        
        ptr = Slab32.next
        Slab32.next = Add(Slab32.next, 32)
        ReturnValue(ptr)
    }
}

Function.Arena_Free32 {
    Input: ptr: Address
    Body: {
        Slab32.free_count = Add(Slab32.free_count, 1)
        StoreValue(ptr, Slab32.free_list)
        Slab32.free_list = ptr
    }
}

Function.Arena_GrowSlab32 {
    Body: {
        chunk = Arena_MmapChunk()
        Slab32.chunk = chunk
        Slab32.next = chunk
        Slab32.end = Add(chunk, ArenaConst.CHUNK_SIZE)
