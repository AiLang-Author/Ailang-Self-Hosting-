// =============================================================================
// GENERAL ALLOCATOR - For variable/large sizes
// =============================================================================
Function.Arena_AllocGeneral {
    Input: size: Integer
    Output: Address
    Body: {
        ArenaGeneral.alloc_count = Add(ArenaGeneral.alloc_count, 1)
        
        // Align to 8 bytes
        aligned = BitwiseAnd(Add(size, 7), -8)
        
        // If too large, fall back to direct mmap
        IfCondition GreaterThan(aligned, 65536) ThenBlock: {
            ArenaGeneral.fallback_count = Add(ArenaGeneral.fallback_count, 1)
            ReturnValue(Arena_MmapDirect(aligned))
        }
        
        // Check if fits in current chunk
        IfCondition GreaterEqual(Add(ArenaGeneral.next, aligned), ArenaGeneral.end) ThenBlock: {
            Arena_GrowGeneral()
        }
        
        ptr = ArenaGeneral.next
        ArenaGeneral.next = Add(ArenaGeneral.next, aligned)
        ReturnValue(ptr)
    }
}

Function.Arena_GrowGeneral {
    Body: {
        chunk = Arena_MmapChunk()
        ArenaGeneral.chunk = chunk
        ArenaGeneral.next = chunk
        ArenaGeneral.end = Add(chunk, ArenaConst.CHUNK_SIZE)
        ArenaGeneral.chunk_count = Add(ArenaGeneral.chunk_count, 1)
    }
}

Function.Arena_MmapDirect {
    Input: size: Integer
    Output: Address
    Body: {
        // Round up to page size
        page_size = 4096
        pages = Divide(Add(size, 4095), 4096)
        total = Multiply(pages, page_size)
        
        addr = SystemCall(9, 0, total, 3, 34, -1, 0)
        ReturnValue(addr)
    }
}

// =============================================================================
// UNIFIED ALLOCATOR - Replaces Allocate()
// Routes to appropriate slab based on size
// =============================================================================
Function.Arena_Alloc {
    Input: size: Integer
    Output: Address
    Body: {
        // Route to appropriate slab
        IfCondition LessEqual(size, 24) ThenBlock: {
            ReturnValue(Arena_Alloc24())
        }
        
        IfCondition LessEqual(size, 32) ThenBlock: {
            ReturnValue(Arena_Alloc32())
        }
        
        IfCondition LessEqual(size, 64) ThenBlock: {
            ReturnValue(Arena_Alloc64())
        }
        
        IfCondition LessEqual(size, 128) ThenBlock: {
            ReturnValue(Arena_Alloc128())
        }
        
        // Larger sizes go to general arena
        ReturnValue(Arena_AllocGeneral(size))
    }
}

// =============================================================================
// UNIFIED FREE - Replaces Deallocate()
// Routes to appropriate slab based on size
// =============================================================================
Function.Arena_Free {
    Input: ptr: Address
    Input: size: Integer
    Body: {
        IfCondition EqualTo(ptr, 0) ThenBlock: {
            ReturnValue(0)
        }
        
        IfCondition LessEqual(size, 24) ThenBlock: {
            Arena_Free24(ptr)
            ReturnValue(1)
        }
        
        IfCondition LessEqual(size, 32) ThenBlock: {
            Arena_Free32(ptr)
            ReturnValue(1)
        }
        
        IfCondition LessEqual(size, 64) ThenBlock: {
            Arena_Free64(ptr)
            ReturnValue(1)
        }
        
        IfCondition LessEqual(size, 128) ThenBlock: {
            Arena_Free128(ptr)
            ReturnValue(1)
        }
        
        // Large allocations: can't easily free (would need tracking)
        // For now, just leak - arena cleanup handles it
        ReturnValue(0)
    }
}

// =============================================================================
// DIAGNOSTICS
// =============================================================================
Function.Arena_Report {
    Body: {
        PrintMessage("\n========== ARENA MEMORY REPORT ==========\n")
        
        PrintMessage("Slab 24-byte:\n")
        PrintMessage("  Chunks: ")
        PrintNumber(Slab24.chunk_count)
        PrintMessage(" (")
        PrintNumber(Multiply(Slab24.chunk_count, 4))
        PrintMessage(" MB)\n")
        PrintMessage("  Allocs: ")
        PrintNumber(Slab24.alloc_count)
        PrintMessage("\n  Frees: ")
        PrintNumber(Slab24.free_count)
        PrintMessage("\n  In use: ")
        PrintNumber(Subtract(Slab24.alloc_count, Slab24.free_count))
        PrintMessage("\n")
        
        PrintMessage("Slab 32-byte:\n")
        PrintMessage("  Chunks: ")
        PrintNumber(Slab32.chunk_count)
        PrintMessage("\n  Allocs: ")
        PrintNumber(Slab32.alloc_count)
        PrintMessage("\n  Frees: ")
        PrintNumber(Slab32.free_count)
        PrintMessage("\n")
        
        PrintMessage("Slab 64-byte:\n")
        PrintMessage("  Chunks: ")
        PrintNumber(Slab64.chunk_count)
        PrintMessage("\n  Allocs: ")
        PrintNumber(Slab64.alloc_count)
        PrintMessage("\n  Frees: ")
        PrintNumber(Slab64.free_count)
        PrintMessage("\n")
        
        PrintMessage("Slab 128-byte:\n")
        PrintMessage("  Chunks: ")
        PrintNumber(Slab128.chunk_count)
        PrintMessage("\n  Allocs: ")
        PrintNumber(Slab128.alloc_count)
        PrintMessage("\n  Frees: ")
        PrintNumber(Slab128.free_count)
        PrintMessage("\n")
        
        PrintMessage("General arena:\n")
        PrintMessage("  Chunks: ")
        PrintNumber(ArenaGeneral.chunk_count)
        PrintMessage("\n  Allocs: ")
        PrintNumber(ArenaGeneral.alloc_count)
        PrintMessage("\n  Fallbacks: ")
        PrintNumber(ArenaGeneral.fallback_count)
        PrintMessage("\n")
        
        total_chunks = Add(Slab24.chunk_count, Slab32.chunk_count)
        total_chunks = Add(total_chunks, Slab64.chunk_count)
        total_chunks = Add(total_chunks, Slab128.chunk_count)
        total_chunks = Add(total_chunks, ArenaGeneral.chunk_count)
        
        PrintMessage("Total: ")
        PrintNumber(total_chunks)
        PrintMessage(" chunks = ")
        PrintNumber(Multiply(total_chunks, 4))
        PrintMessage(" MB\n")
        PrintMessage("=========================================\n")
    }
}