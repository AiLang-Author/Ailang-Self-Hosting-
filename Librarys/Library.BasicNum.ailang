// Library.BasicNum.ailang
// IEEE-754 numeric helpers for Minimal BASIC / ECMA-55.
// Values are float bit-patterns stored in Integer.

FixedPool.BasicNum {
    "ten": Initialize=0
    "one": Initialize=0
    "zero": Initialize=0
    "half": Initialize=0
    "ready": Initialize=0
    "fmt_ptr": Initialize=0
    "fmt_len": Initialize=0
    "rng": Initialize=123456789
    "last_rnd": Initialize=0
}

Function.BasicNum.Init {
    Body: {
        BasicNum.zero = Float_FromInt(0)
        BasicNum.one = Float_FromInt(1)
        BasicNum.ten = Float_FromInt(10)
        two = Float_FromInt(2)
        BasicNum.half = Float_Div(BasicNum.one, two)
        IfCondition EqualTo(BasicNum.fmt_ptr, 0) ThenBlock: {
            BasicNum.fmt_ptr = Allocate(64)
        }
        i = 0
        WhileLoop LessThan(i, 64) {
            SetByte(BasicNum.fmt_ptr, i, 0)
            i = Add(i, 1)
        }
        BasicNum.fmt_len = 0
        BasicNum.ready = 1
        BasicNum.last_rnd = BasicNum.zero
    }
}

Function.BasicNum.ToInt {
    Input: x: Integer
    Output: Integer
    Body: {
        z = BasicNum.zero
        eqz = Float_Eq(x, z)
        IfCondition EqualTo(eqz, 1) ThenBlock: {
            ReturnValue(0)
        }
        neg = 0
        lt = Float_Lt(x, z)
        IfCondition EqualTo(lt, 1) ThenBlock: {
            neg = 1
            x = Float_Abs(x)
        }
        x = Float_Add(x, BasicNum.half)
        n = 0
        one = BasicNum.one
        ge = Float_Ge(x, one)
        guard = 0
        WhileLoop And(EqualTo(ge, 1), LessThan(guard, 2000000)) {
            x = Float_Sub(x, one)
            n = Add(n, 1)
            guard = Add(guard, 1)
            ge = Float_Ge(x, one)
        }
        IfCondition EqualTo(neg, 1) ThenBlock: {
            n = Subtract(0, n)
        }
        ReturnValue(n)
    }
}

Function.BasicNum.TruncInt {
    Input: x: Integer
    Output: Integer
    Body: {
        t = Float_Trunc(x)
        n = Float_ToInt(t)
        ReturnValue(n)
    }
}

Function.BasicNum.IsInt {
    Input: x: Integer
    Output: Integer
    Body: {
        t = Float_Trunc(x)
        eq = Float_Eq(x, t)
        ReturnValue(eq)
    }
}

Function.BasicNum.Abs {
    Input: x: Integer
    Output: Integer
    Body: {
        a = Float_Abs(x)
        ReturnValue(a)
    }
}

Function.BasicNum.Sgn {
    Input: x: Integer
    Output: Integer
    Body: {
        z = BasicNum.zero
        IfCondition EqualTo(Float_Eq(x, z), 1) ThenBlock: {
            ReturnValue(z)
        }
        IfCondition EqualTo(Float_Lt(x, z), 1) ThenBlock: {
            m = Float_FromInt(-1)
            ReturnValue(m)
        }
        ReturnValue(BasicNum.one)
    }
}

Function.BasicNum.IntFloor {
    Input: x: Integer
    Output: Integer
    Body: {
        f = Float_Floor(x)
        ReturnValue(f)
    }
}

Function.BasicNum.Pow {
    Input: a: Integer
    Input: b: Integer
    Output: Integer
    Body: {
        z = BasicNum.zero
        one = BasicNum.one
        IfCondition EqualTo(Float_Eq(b, z), 1) ThenBlock: {
            ReturnValue(one)
        }
        is_int = BasicNum.IsInt(b)
        IfCondition EqualTo(is_int, 1) ThenBlock: {
            n = BasicNum.TruncInt(b)
            negexp = 0
            IfCondition LessThan(n, 0) ThenBlock: {
                negexp = 1
                n = Subtract(0, n)
            }
            r = one
            i = 0
            WhileLoop LessThan(i, n) {
                r = Float_Mul(r, a)
                i = Add(i, 1)
            }
            IfCondition EqualTo(negexp, 1) ThenBlock: {
                IfCondition EqualTo(Float_Eq(r, z), 1) ThenBlock: {
                    ReturnValue(0x7FF0000000000000)
                }
                r = Float_Div(one, r)
            }
            ReturnValue(r)
        }
        IfCondition EqualTo(Float_Lt(a, z), 1) ThenBlock: {
            ReturnValue(0x7FF8000000000000)
        }
        IfCondition EqualTo(Float_Eq(a, z), 1) ThenBlock: {
            IfCondition EqualTo(Float_Lt(b, z), 1) ThenBlock: {
                ReturnValue(0x7FF0000000000000)
            }
            ReturnValue(z)
        }
        p = Float_Pow(a, b)
        ReturnValue(p)
    }
}

Function.BasicNum.Rnd {
    Output: Integer
    Body: {
        s = BasicNum.rng
        m = Multiply(s, 1103515245)
        s = Add(m, 12345)
        IfCondition LessThan(s, 0) ThenBlock: {
            s = BitwiseAnd(s, 2147483647)
        }
        BasicNum.rng = s
        fv = Float_FromInt(s)
        den = Float_FromInt(2147483647)
        u = Float_Div(fv, den)
        IfCondition EqualTo(Float_Eq(u, BasicNum.zero), 1) ThenBlock: {
            u = Float_Div(BasicNum.one, den)
        }
        IfCondition EqualTo(Float_Eq(u, BasicNum.one), 1) ThenBlock: {
            u = Float_Sub(BasicNum.one, Float_Div(BasicNum.one, den))
        }
        BasicNum.last_rnd = u
        ReturnValue(u)
    }
}

Function.BasicNum.Randomize {
    Input: seed: Integer
    Body: {
        IfCondition EqualTo(seed, 0) ThenBlock: {
            BasicNum.rng = 123456789
        } ElseBlock: {
            BasicNum.rng = seed
        }
    }
}

Function.BasicNum.PutChar {
    Input: ch: Integer
    Body: {
        n = BasicNum.fmt_len
        IfCondition LessThan(n, 63) ThenBlock: {
            SetByte(BasicNum.fmt_ptr, n, ch)
            BasicNum.fmt_len = Add(n, 1)
        }
    }
}

Function.BasicNum.PutDigit {
    Input: d: Integer
    Body: {
        c = Add(48, d)
        BasicNum.PutChar(c)
    }
}

Function.BasicNum.ScaleTo1 {
    Input: x: Integer
    Output: Integer
    Body: {
        ten = BasicNum.ten
        one = BasicNum.one
        absx = x
        expn = 0
        guard = 0
        ge = Float_Ge(absx, ten)
        WhileLoop And(EqualTo(ge, 1), LessThan(guard, 400)) {
            absx = Float_Div(absx, ten)
            expn = Add(expn, 1)
            guard = Add(guard, 1)
            ge = Float_Ge(absx, ten)
        }
        guard = 0
        z = BasicNum.zero
        lt = Float_Lt(absx, one)
        ez = Float_Eq(absx, z)
        WhileLoop And(EqualTo(lt, 1), LessThan(guard, 400)) {
            IfCondition EqualTo(ez, 1) ThenBlock: {
                guard = 400
            } ElseBlock: {
                absx = Float_Mul(absx, ten)
                expn = Subtract(expn, 1)
                guard = Add(guard, 1)
            }
            lt = Float_Lt(absx, one)
            ez = Float_Eq(absx, z)
        }
        BasicNum.last_rnd = absx
        ReturnValue(expn)
    }
}

Function.BasicNum.SixDigits {
    Input: sig: Integer
    Output: Integer
    Body: {
        ten = BasicNum.ten
        acc = 0
        cur = sig
        i = 0
        WhileLoop LessThan(i, 6) {
            tr = Float_Trunc(cur)
            d = Float_ToInt(tr)
            IfCondition LessThan(d, 0) ThenBlock: { d = 0 }
            IfCondition GreaterThan(d, 9) ThenBlock: { d = 9 }
            acc = Multiply(acc, 10)
            acc = Add(acc, d)
            df = Float_FromInt(d)
            cur = Float_Sub(cur, df)
            cur = Float_Mul(cur, ten)
            i = Add(i, 1)
        }
        IfCondition GreaterThan(acc, 999999) ThenBlock: {
            acc = 100000
        }
        ReturnValue(acc)
    }
}

Function.BasicNum.PutIntExp {
    Input: e: Integer
    Body: {
        IfCondition LessThan(e, 0) ThenBlock: {
            BasicNum.PutChar(45)
            e = Subtract(0, e)
        } ElseBlock: {
            BasicNum.PutChar(43)
        }
        IfCondition GreaterEqual(e, 100) ThenBlock: {
            h = Divide(e, 100)
            BasicNum.PutDigit(h)
            e = Subtract(e, Multiply(h, 100))
        }
        IfCondition GreaterEqual(e, 10) ThenBlock: {
            t = Divide(e, 10)
            BasicNum.PutDigit(t)
            e = Subtract(e, Multiply(t, 10))
        }
        BasicNum.PutDigit(e)
    }
}

Function.BasicNum.Format {
    Input: x: Integer
    Output: Address
    Body: {
        IfCondition EqualTo(BasicNum.ready, 0) ThenBlock: {
            BasicNum.Init()
        }
        BasicNum.fmt_len = 0
        i = 0
        WhileLoop LessThan(i, 64) {
            SetByte(BasicNum.fmt_ptr, i, 0)
            i = Add(i, 1)
        }

        nan = Float_IsNan(x)
        inf = Float_IsInf(x)
        zchk = Float_Eq(x, BasicNum.zero)
        IfCondition EqualTo(nan, 1) ThenBlock: {
            BasicNum.PutChar(32)
            BasicNum.PutChar(78)
            BasicNum.PutChar(65)
            BasicNum.PutChar(78)
            BasicNum.PutChar(32)
            SetByte(BasicNum.fmt_ptr, BasicNum.fmt_len, 0)
            ReturnValue(BasicNum.fmt_ptr)
        }
        IfCondition EqualTo(inf, 1) ThenBlock: {
            sb = Float_SignBit(x)
            IfCondition EqualTo(sb, 1) ThenBlock: {
                BasicNum.PutChar(45)
            } ElseBlock: {
                BasicNum.PutChar(32)
            }
            BasicNum.PutChar(73)
            BasicNum.PutChar(78)
            BasicNum.PutChar(70)
            BasicNum.PutChar(32)
            SetByte(BasicNum.fmt_ptr, BasicNum.fmt_len, 0)
            ReturnValue(BasicNum.fmt_ptr)
        }

        IfCondition EqualTo(zchk, 1) ThenBlock: {
            BasicNum.PutChar(32)
            BasicNum.PutChar(48)
            BasicNum.PutChar(32)
            SetByte(BasicNum.fmt_ptr, BasicNum.fmt_len, 0)
            ReturnValue(BasicNum.fmt_ptr)
        }

        neg = Float_SignBit(x)
        IfCondition EqualTo(neg, 1) ThenBlock: {
            BasicNum.PutChar(45)
            ax = Float_Abs(x)
        } ElseBlock: {
            BasicNum.PutChar(32)
            ax = x
        }

        expn = BasicNum.ScaleTo1(ax)
        sig = BasicNum.last_rnd
        digs = BasicNum.SixDigits(sig)
        IfCondition EqualTo(digs, 100000) ThenBlock: {
            // rounding 9.99999 -> 10.0000
            nine = Float_FromInt(9)
            chk = Float_Ge(sig, nine)
            IfCondition EqualTo(chk, 1) ThenBlock: {
                IfCondition GreaterThan(digs, 999999) ThenBlock: {
                    digs = 100000
                    expn = Add(expn, 1)
                }
            }
        }
        IfCondition GreaterThan(digs, 999999) ThenBlock: {
            digs = 100000
            expn = Add(expn, 1)
        }

        // Strip trailing zeros from 6-digit significand: d0..d5
        d0 = Divide(digs, 100000)
        r = Subtract(digs, Multiply(d0, 100000))
        d1 = Divide(r, 10000)
        r = Subtract(r, Multiply(d1, 10000))
        d2 = Divide(r, 1000)
        r = Subtract(r, Multiply(d2, 1000))
        d3 = Divide(r, 100)
        r = Subtract(r, Multiply(d3, 100))
        d4 = Divide(r, 10)
        d5 = Subtract(r, Multiply(d4, 10))

        nd = 6
        IfCondition EqualTo(d5, 0) ThenBlock: {
            nd = 5
            IfCondition EqualTo(d4, 0) ThenBlock: {
                nd = 4
                IfCondition EqualTo(d3, 0) ThenBlock: {
                    nd = 3
                    IfCondition EqualTo(d2, 0) ThenBlock: {
                        nd = 2
                        IfCondition EqualTo(d1, 0) ThenBlock: {
                            nd = 1
                        }
                    }
                }
            }
        }

        use_nr3 = 0
        IfCondition GreaterThan(expn, 5) ThenBlock: { use_nr3 = 1 }
        IfCondition LessThan(expn, -6) ThenBlock: { use_nr3 = 1 }

        IfCondition EqualTo(use_nr3, 1) ThenBlock: {
            BasicNum.PutDigit(d0)
            BasicNum.PutChar(46)
            IfCondition GreaterThan(nd, 1) ThenBlock: {
                BasicNum.PutDigit(d1)
                IfCondition GreaterThan(nd, 2) ThenBlock: {
                    BasicNum.PutDigit(d2)
                    IfCondition GreaterThan(nd, 3) ThenBlock: {
                        BasicNum.PutDigit(d3)
                        IfCondition GreaterThan(nd, 4) ThenBlock: {
                            BasicNum.PutDigit(d4)
                            IfCondition GreaterThan(nd, 5) ThenBlock: {
                                BasicNum.PutDigit(d5)
                            }
                        }
                    }
                }
            }
            BasicNum.PutChar(69)
            BasicNum.PutIntExp(expn)
        } ElseBlock: {
            is_intform = 0
            IfCondition GreaterEqual(expn, 0) ThenBlock: {
                IfCondition LessThan(Add(expn, 1), nd) ThenBlock: {
                    is_intform = 0
                } ElseBlock: {
                    is_intform = 1
                }
            }
            IfCondition EqualTo(is_intform, 1) ThenBlock: {
                BasicNum.PutDigit(d0)
                k = 1
                WhileLoop LessEqual(k, expn) {
                    IfCondition EqualTo(k, 1) ThenBlock: { BasicNum.PutDigit(d1) }
                    IfCondition EqualTo(k, 2) ThenBlock: { BasicNum.PutDigit(d2) }
                    IfCondition EqualTo(k, 3) ThenBlock: { BasicNum.PutDigit(d3) }
                    IfCondition EqualTo(k, 4) ThenBlock: { BasicNum.PutDigit(d4) }
                    IfCondition EqualTo(k, 5) ThenBlock: { BasicNum.PutDigit(d5) }
                    IfCondition GreaterThan(k, 5) ThenBlock: { BasicNum.PutDigit(0) }
                    k = Add(k, 1)
                }
            } ElseBlock: {
                IfCondition LessThan(expn, 0) ThenBlock: {
                    BasicNum.PutChar(46)
                    zc = Subtract(-1, expn)
                    zi = 0
                    WhileLoop LessThan(zi, zc) {
                        BasicNum.PutDigit(0)
                        zi = Add(zi, 1)
                    }
                    BasicNum.PutDigit(d0)
                    IfCondition GreaterThan(nd, 1) ThenBlock: { BasicNum.PutDigit(d1) }
                    IfCondition GreaterThan(nd, 2) ThenBlock: { BasicNum.PutDigit(d2) }
                    IfCondition GreaterThan(nd, 3) ThenBlock: { BasicNum.PutDigit(d3) }
                    IfCondition GreaterThan(nd, 4) ThenBlock: { BasicNum.PutDigit(d4) }
                    IfCondition GreaterThan(nd, 5) ThenBlock: { BasicNum.PutDigit(d5) }
                } ElseBlock: {
                    BasicNum.PutDigit(d0)
                    k = 1
                    WhileLoop LessEqual(k, expn) {
                        IfCondition EqualTo(k, 1) ThenBlock: { BasicNum.PutDigit(d1) }
                        IfCondition EqualTo(k, 2) ThenBlock: { BasicNum.PutDigit(d2) }
                        IfCondition EqualTo(k, 3) ThenBlock: { BasicNum.PutDigit(d3) }
                        IfCondition EqualTo(k, 4) ThenBlock: { BasicNum.PutDigit(d4) }
                        IfCondition EqualTo(k, 5) ThenBlock: { BasicNum.PutDigit(d5) }
                        k = Add(k, 1)
                    }
                    BasicNum.PutChar(46)
                    k = Add(expn, 1)
                    WhileLoop LessThan(k, nd) {
                        IfCondition EqualTo(k, 1) ThenBlock: { BasicNum.PutDigit(d1) }
                        IfCondition EqualTo(k, 2) ThenBlock: { BasicNum.PutDigit(d2) }
                        IfCondition EqualTo(k, 3) ThenBlock: { BasicNum.PutDigit(d3) }
                        IfCondition EqualTo(k, 4) ThenBlock: { BasicNum.PutDigit(d4) }
                        IfCondition EqualTo(k, 5) ThenBlock: { BasicNum.PutDigit(d5) }
                        k = Add(k, 1)
                    }
                }
            }
        }

        BasicNum.PutChar(32)
        SetByte(BasicNum.fmt_ptr, BasicNum.fmt_len, 0)
        ReturnValue(BasicNum.fmt_ptr)
    }
}

Function.BasicNum.ParseStr {
    Input: s: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(BasicNum.ready, 0) ThenBlock: {
            BasicNum.Init()
        }
        IfCondition EqualTo(s, 0) ThenBlock: {
            ReturnValue(BasicNum.zero)
        }
        n = StringLength(s)
        p = 0
        sk = 1
        WhileLoop And(LessThan(p, n), EqualTo(sk, 1)) {
            chs = GetByte(s, p)
            IfCondition EqualTo(chs, 32) ThenBlock: {
                p = Add(p, 1)
            } ElseBlock: {
                sk = 0
            }
        }
        IfCondition GreaterEqual(p, n) ThenBlock: {
            ReturnValue(BasicNum.zero)
        }
        neg = 0
        ch = GetByte(s, p)
        IfCondition EqualTo(ch, 43) ThenBlock: {
            p = Add(p, 1)
        } ElseBlock: {
            IfCondition EqualTo(ch, 45) ThenBlock: {
                neg = 1
                p = Add(p, 1)
            }
        }
        ten = BasicNum.ten
        val = BasicNum.zero
        saw = 0
        frac = 0
        fdiv = BasicNum.one
        WhileLoop LessThan(p, n) {
            ch = GetByte(s, p)
            IfCondition And(GreaterEqual(ch, 48), LessEqual(ch, 57)) ThenBlock: {
                d = Float_FromInt(Subtract(ch, 48))
                IfCondition EqualTo(frac, 0) ThenBlock: {
                    t1 = Float_Mul(val, ten)
                    val = Float_Add(t1, d)
                } ElseBlock: {
                    fdiv = Float_Mul(fdiv, ten)
                    t1 = Float_Div(d, fdiv)
                    val = Float_Add(val, t1)
                }
                saw = 1
                p = Add(p, 1)
            } ElseBlock: {
                IfCondition And(EqualTo(ch, 46), EqualTo(frac, 0)) ThenBlock: {
                    frac = 1
                    p = Add(p, 1)
                } ElseBlock: {
                    p = n
                }
            }
        }
        // restart E scan: find E from start of remaining
        // p was set to n on non-digit. Re-scan from original leftover.
        // Simpler: second pass for E from 0.
        p = 0
        WhileLoop LessThan(p, n) {
            ch = GetByte(s, p)
            uch = ch
            IfCondition And(GreaterEqual(ch, 97), LessEqual(ch, 122)) ThenBlock: {
                uch = Subtract(ch, 32)
            }
            IfCondition EqualTo(uch, 69) ThenBlock: {
                p = Add(p, 1)
                esign = 1
                IfCondition LessThan(p, n) ThenBlock: {
                    ch = GetByte(s, p)
                    IfCondition EqualTo(ch, 43) ThenBlock: {
                        p = Add(p, 1)
                    } ElseBlock: {
                        IfCondition EqualTo(ch, 45) ThenBlock: {
                            esign = -1
                            p = Add(p, 1)
                        }
                    }
                }
                ev = 0
                WhileLoop LessThan(p, n) {
                    ch = GetByte(s, p)
                    IfCondition And(GreaterEqual(ch, 48), LessEqual(ch, 57)) ThenBlock: {
                        ev = Multiply(ev, 10)
                        ev = Add(ev, Subtract(ch, 48))
                        p = Add(p, 1)
                    } ElseBlock: {
                        p = n
                    }
                }
                k = 0
                WhileLoop LessThan(k, ev) {
                    IfCondition EqualTo(esign, 1) ThenBlock: {
                        val = Float_Mul(val, ten)
                    } ElseBlock: {
                        val = Float_Div(val, ten)
                    }
                    k = Add(k, 1)
                }
            }
            p = Add(p, 1)
        }
        IfCondition EqualTo(saw, 0) ThenBlock: {
            ReturnValue(BasicNum.zero)
        }
        IfCondition EqualTo(neg, 1) ThenBlock: {
            val = Float_Neg(val)
        }
        ReturnValue(val)
    }
}
