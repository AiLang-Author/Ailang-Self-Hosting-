// Library.C64Memory.ailang
// C64 Memory Bus - Address routing and memory map
//
// Memory Map:
//   0000-9FFF: RAM (40KB)
//   A000-BFFF: BASIC ROM (banked) / RAM
//   C000-CFFF: RAM (4KB)
//   D000-DFFF: I/O Area / Character ROM / RAM (banked)
//     D000-D3FF: VIC-II (video)
//     D400-D7FF: SID (sound)
//     D800-DBFF: Color RAM
//     DC00-DCFF: CIA1 (keyboard, joystick)
//     DD00-DDFF: CIA2 (serial, userport)
//     DE00-DEFF: I/O expansion 1
//     DF00-DFFF: I/O expansion 2
//   E000-FFFF: KERNAL ROM (banked) / RAM
//
// Usage: LibraryImport.C64Memory
//
// The memory bus routes reads/writes to appropriate handlers.
// External modules register callbacks for I/O ranges.

// =============================================================================
// MEMORY CONFIGURATION
// =============================================================================

FixedPool.C64Mem {
    // Memory pointers
    "ram": Initialize=0              // 64KB main RAM
    "basic_rom": Initialize=0        // 8KB BASIC ROM
    "kernal_rom": Initialize=0       // 8KB KERNAL ROM  
    "char_rom": Initialize=0         // 4KB Character ROM
    "color_ram": Initialize=0        // 1KB Color RAM (nybbles)
    
    // Memory sizes
    "RAM_SIZE": Initialize=65536
    "BASIC_SIZE": Initialize=8192
    "KERNAL_SIZE": Initialize=8192
    "CHAR_SIZE": Initialize=4096
    "COLOR_SIZE": Initialize=1024
    
    // Banking control (directly from 6510 port at $0001)
    // Bits: x x x CHAREN HIRAM LORAM
    "bank_config": Initialize=0x37   // Default: all ROMs visible
    
    // Initialization flag
    "initialized": Initialize=0
}

// =============================================================================
// I/O HANDLER REGISTRATION
// Allows VIC, SID, CIA modules to register their read/write handlers
// =============================================================================

FixedPool.C64IO {
    // Handler function pointers (set by chip modules)
    "vic_read": Initialize=0
    "vic_write": Initialize=0
    "sid_read": Initialize=0
    "sid_write": Initialize=0
    "cia1_read": Initialize=0
    "cia1_write": Initialize=0
    "cia2_read": Initialize=0
    "cia2_write": Initialize=0
    
    // I/O enabled flag
    "io_enabled": Initialize=1
}

// =============================================================================
// INITIALIZATION
// =============================================================================

Function.C64Mem_Init {
    Output: Integer
    Body: {
        IfCondition EqualTo(C64Mem.initialized, 1) ThenBlock: {
            ReturnValue(1)
        }
        
        // Allocate main RAM (64KB)
        C64Mem.ram = Allocate(C64Mem.RAM_SIZE)
        IfCondition EqualTo(C64Mem.ram, 0) ThenBlock: {
            PrintMessage("ERROR: Cannot allocate C64 RAM\n")
            ReturnValue(0)
        }
        
        // Clear RAM
        i = 0
        WhileLoop LessThan(i, C64Mem.RAM_SIZE) {
            SetByte(C64Mem.ram, i, 0)
            i = Add(i, 1)
        }
        
        // Allocate Color RAM (1KB)
        C64Mem.color_ram = Allocate(C64Mem.COLOR_SIZE)
        IfCondition EqualTo(C64Mem.color_ram, 0) ThenBlock: {
            PrintMessage("ERROR: Cannot allocate Color RAM\n")
            ReturnValue(0)
        }
        
        // Clear Color RAM to light blue (default)
        i = 0
        WhileLoop LessThan(i, C64Mem.COLOR_SIZE) {
            SetByte(C64Mem.color_ram, i, 14)
            i = Add(i, 1)
        }
        
        // Allocate ROM areas (will be loaded from files or use built-in)
        C64Mem.basic_rom = Allocate(C64Mem.BASIC_SIZE)
        C64Mem.kernal_rom = Allocate(C64Mem.KERNAL_SIZE)
        C64Mem.char_rom = Allocate(C64Mem.CHAR_SIZE)
        
        // Initialize 6510 CPU port
        // $0000 = Data Direction Register
        // $0001 = Port value
        SetByte(C64Mem.ram, 0, 0x2F)    // DDR: bits 0-5 output
        SetByte(C64Mem.ram, 1, 0x37)    // Port: BASIC+KERNAL+I/O visible
        C64Mem.bank_config = 0x37
        
        C64Mem.initialized = 1
        PrintMessage("C64 Memory initialized (64KB RAM)\n")
        ReturnValue(1)
    }
}

Function.C64Mem_Shutdown {
    Body: {
        IfCondition NotEqual(C64Mem.ram, 0) ThenBlock: {
            Deallocate(C64Mem.ram, C64Mem.RAM_SIZE)
            C64Mem.ram = 0
        }
        IfCondition NotEqual(C64Mem.color_ram, 0) ThenBlock: {
            Deallocate(C64Mem.color_ram, C64Mem.COLOR_SIZE)
            C64Mem.color_ram = 0
        }
        IfCondition NotEqual(C64Mem.basic_rom, 0) ThenBlock: {
            Deallocate(C64Mem.basic_rom, C64Mem.BASIC_SIZE)
            C64Mem.basic_rom = 0
        }
        IfCondition NotEqual(C64Mem.kernal_rom, 0) ThenBlock: {
            Deallocate(C64Mem.kernal_rom, C64Mem.KERNAL_SIZE)
            C64Mem.kernal_rom = 0
        }
        IfCondition NotEqual(C64Mem.char_rom, 0) ThenBlock: {
            Deallocate(C64Mem.char_rom, C64Mem.CHAR_SIZE)
            C64Mem.char_rom = 0
        }
        C64Mem.initialized = 0
    }
}

// =============================================================================
// BANKING HELPERS
// =============================================================================

// Check if BASIC ROM is visible (A000-BFFF)
Function.C64Mem_BasicVisible {
    Output: Integer
    Body: {
        // LORAM (bit 0) and HIRAM (bit 1) both must be set
        loram = BitwiseAnd(C64Mem.bank_config, 0x01)
        hiram = BitwiseAnd(C64Mem.bank_config, 0x02)
        IfCondition And(NotEqual(loram, 0), NotEqual(hiram, 0)) ThenBlock: {
            ReturnValue(1)
        }
        ReturnValue(0)
    }
}

// Check if KERNAL ROM is visible (E000-FFFF)
Function.C64Mem_KernalVisible {
    Output: Integer
    Body: {
        // HIRAM (bit 1) must be set
        hiram = BitwiseAnd(C64Mem.bank_config, 0x02)
        IfCondition NotEqual(hiram, 0) ThenBlock: {
            ReturnValue(1)
        }
        ReturnValue(0)
    }
}

// Check if I/O is visible (D000-DFFF) vs Character ROM
Function.C64Mem_IOVisible {
    Output: Integer
    Body: {
        // CHAREN (bit 2) = 1 means I/O visible, 0 means Char ROM
        charen = BitwiseAnd(C64Mem.bank_config, 0x04)
        // Also need HIRAM or LORAM set
        loram = BitwiseAnd(C64Mem.bank_config, 0x01)
        hiram = BitwiseAnd(C64Mem.bank_config, 0x02)
        
        IfCondition And(NotEqual(charen, 0), Or(NotEqual(loram, 0), NotEqual(hiram, 0))) ThenBlock: {
            ReturnValue(1)
        }
        ReturnValue(0)
    }
}

// =============================================================================
// MEMORY READ
// =============================================================================

Function.C64Mem_Read {
    Input: addr: Integer
    Output: Integer
    Body: {
        // Mask to 16-bit address
        addr = BitwiseAnd(addr, 0xFFFF)
        
        // Special case: CPU port at $0000-$0001
        IfCondition EqualTo(addr, 0) ThenBlock: {
            ReturnValue(GetByte(C64Mem.ram, 0))
        }
        IfCondition EqualTo(addr, 1) ThenBlock: {
            ReturnValue(C64Mem.bank_config)
        }
        
        // I/O Area: D000-DFFF
        IfCondition And(GreaterEqual(addr, 0xD000), LessThan(addr, 0xE000)) ThenBlock: {
            io_visible = C64Mem_IOVisible()
            
            IfCondition EqualTo(io_visible, 1) ThenBlock: {
                // Route to I/O chips
                ReturnValue(C64Mem_ReadIO(addr))
            } ElseBlock: {
                // Character ROM visible
                rom_offset = Subtract(addr, 0xD000)
                ReturnValue(GetByte(C64Mem.char_rom, rom_offset))
            }
        }
        
        // BASIC ROM: A000-BFFF
        IfCondition And(GreaterEqual(addr, 0xA000), LessThan(addr, 0xC000)) ThenBlock: {
            basic_visible = C64Mem_BasicVisible()
            IfCondition EqualTo(basic_visible, 1) ThenBlock: {
                rom_offset = Subtract(addr, 0xA000)
                ReturnValue(GetByte(C64Mem.basic_rom, rom_offset))
            }
            // Fall through to RAM
        }
        
        // KERNAL ROM: E000-FFFF
        IfCondition GreaterEqual(addr, 0xE000) ThenBlock: {
            kernal_visible = C64Mem_KernalVisible()
            IfCondition EqualTo(kernal_visible, 1) ThenBlock: {
                rom_offset = Subtract(addr, 0xE000)
                ReturnValue(GetByte(C64Mem.kernal_rom, rom_offset))
            }
            // Fall through to RAM
        }
        
        // Default: RAM
        ReturnValue(GetByte(C64Mem.ram, addr))
    }
}

// Read 16-bit word (little-endian)
Function.C64Mem_Read16 {
    Input: addr: Integer
    Output: Integer
    Body: {
        lo = C64Mem_Read(addr)
        hi = C64Mem_Read(Add(addr, 1))
        ReturnValue(BitwiseOr(lo, ShiftLeft(hi, 8)))
    }
}

// =============================================================================
// MEMORY WRITE
// =============================================================================

Function.C64Mem_Write {
    Input: addr: Integer
    Input: value: Integer
    Body: {
        // Mask to 16-bit address and 8-bit value
        addr = BitwiseAnd(addr, 0xFFFF)
        value = BitwiseAnd(value, 0xFF)
        
        // Special case: CPU port at $0001
        IfCondition EqualTo(addr, 1) ThenBlock: {
            C64Mem.bank_config = value
            SetByte(C64Mem.ram, 1, value)
            ReturnValue(0)
        }
        
        // I/O Area: D000-DFFF
        IfCondition And(GreaterEqual(addr, 0xD000), LessThan(addr, 0xE000)) ThenBlock: {
            io_visible = C64Mem_IOVisible()
            
            IfCondition EqualTo(io_visible, 1) ThenBlock: {
                C64Mem_WriteIO(addr, value)
                ReturnValue(0)
            }
            // If I/O not visible, write goes to RAM underneath
        }
        
        // ROM areas: writes always go to RAM underneath
        // (This is correct C64 behavior)
        
        // Write to RAM
        SetByte(C64Mem.ram, addr, value)
    }
}

// Write 16-bit word (little-endian)
Function.C64Mem_Write16 {
    Input: addr: Integer
    Input: value: Integer
    Body: {
        C64Mem_Write(addr, BitwiseAnd(value, 0xFF))
        C64Mem_Write(Add(addr, 1), BitwiseAnd(ShiftRight(value, 8), 0xFF))
    }
}

// =============================================================================
// I/O ROUTING
// =============================================================================

Function.C64Mem_ReadIO {
    Input: addr: Integer
    Output: Integer
    Body: {
        // VIC-II: D000-D3FF
        IfCondition LessThan(addr, 0xD400) ThenBlock: {
            reg = BitwiseAnd(Subtract(addr, 0xD000), 0x3F)  // Mirror every 64 bytes
            ReturnValue(C64VIC_Read(reg))
        }
        
        // SID: D400-D7FF
        IfCondition LessThan(addr, 0xD800) ThenBlock: {
            reg = BitwiseAnd(Subtract(addr, 0xD400), 0x1F)  // 32 registers
            ReturnValue(C64SID_Read(reg))
        }
        
        // Color RAM: D800-DBFF
        IfCondition LessThan(addr, 0xDC00) ThenBlock: {
            offset = Subtract(addr, 0xD800)
            // Color RAM is only 4 bits wide, upper bits are "floating"
            ReturnValue(BitwiseOr(GetByte(C64Mem.color_ram, offset), 0xF0))
        }
        
        // CIA1: DC00-DCFF
        IfCondition LessThan(addr, 0xDD00) ThenBlock: {
            reg = BitwiseAnd(Subtract(addr, 0xDC00), 0x0F)  // 16 registers
            ReturnValue(C64CIA1_Read(reg))
        }
        
        // CIA2: DD00-DDFF
        IfCondition LessThan(addr, 0xDE00) ThenBlock: {
            reg = BitwiseAnd(Subtract(addr, 0xDD00), 0x0F)  // 16 registers
            ReturnValue(C64CIA2_Read(reg))
        }
        
        // I/O Expansion: DE00-DFFF
        // Return open bus (last value on data bus, typically 0xFF)
        ReturnValue(0xFF)
    }
}

Function.C64Mem_WriteIO {
    Input: addr: Integer
    Input: value: Integer
    Body: {
        // VIC-II: D000-D3FF
        IfCondition LessThan(addr, 0xD400) ThenBlock: {
            reg = BitwiseAnd(Subtract(addr, 0xD000), 0x3F)
            C64VIC_Write(reg, value)
            ReturnValue(0)
        }
        
        // SID: D400-D7FF
        IfCondition LessThan(addr, 0xD800) ThenBlock: {
            reg = BitwiseAnd(Subtract(addr, 0xD400), 0x1F)
            C64SID_Write(reg, value)
            ReturnValue(0)
        }
        
        // Color RAM: D800-DBFF
        IfCondition LessThan(addr, 0xDC00) ThenBlock: {
            offset = Subtract(addr, 0xD800)
            SetByte(C64Mem.color_ram, offset, BitwiseAnd(value, 0x0F))
            ReturnValue(0)
        }
        
        // CIA1: DC00-DCFF
        IfCondition LessThan(addr, 0xDD00) ThenBlock: {
            reg = BitwiseAnd(Subtract(addr, 0xDC00), 0x0F)
            C64CIA1_Write(reg, value)
            ReturnValue(0)
        }
        
        // CIA2: DD00-DDFF
        IfCondition LessThan(addr, 0xDE00) ThenBlock: {
            reg = BitwiseAnd(Subtract(addr, 0xDD00), 0x0F)
            C64CIA2_Write(reg, value)
            ReturnValue(0)
        }
        
        // I/O Expansion: writes ignored
    }
}

