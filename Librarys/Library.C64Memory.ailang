// =============================================================================
// ROM LOADING
// =============================================================================

Function.C64Mem_LoadROM {
    Input: filename: Address
    Input: dest: Address
    Input: size: Integer
    Output: Integer
    Body: {
        // Open file
        fd = SystemCall(2, filename, 0, 0)  // SYS_OPEN, O_RDONLY
        IfCondition LessThan(fd, 0) ThenBlock: {
            PrintMessage("Cannot open ROM: ")
            PrintString(filename)
            PrintMessage("\n")
            ReturnValue(0)
        }
        
        // Read into destination
        bytes_read = SystemCall(0, fd, dest, size)  // SYS_READ
        
        // Close
        SystemCall(3, fd, 0, 0)  // SYS_CLOSE
        
        IfCondition NotEqual(bytes_read, size) ThenBlock: {
            PrintMessage("ROM size mismatch: ")
            PrintString(filename)
            PrintMessage("\n")
            ReturnValue(0)
        }
        
        ReturnValue(1)
    }
}

Function.C64Mem_LoadBasicROM {
    Input: filename: Address
    Output: Integer
    Body: {
        ReturnValue(C64Mem_LoadROM(filename, C64Mem.basic_rom, C64Mem.BASIC_SIZE))
    }
}

Function.C64Mem_LoadKernalROM {
    Input: filename: Address
    Output: Integer
    Body: {
        ReturnValue(C64Mem_LoadROM(filename, C64Mem.kernal_rom, C64Mem.KERNAL_SIZE))
    }
}

Function.C64Mem_LoadCharROM {
    Input: filename: Address
    Output: Integer
    Body: {
        ReturnValue(C64Mem_LoadROM(filename, C64Mem.char_rom, C64Mem.CHAR_SIZE))
    }
}

// =============================================================================
// PRG FILE LOADING
// =============================================================================

// Load a .PRG file (standard C64 program format)
// First 2 bytes = load address (little-endian)
// Remaining bytes = program data
Function.C64Mem_LoadPRG {
    Input: filename: Address
    Output: Integer
    Body: {
        // Open file
        fd = SystemCall(2, filename, 0, 0)
        IfCondition LessThan(fd, 0) ThenBlock: {
            PrintMessage("Cannot open PRG: ")
            PrintString(filename)
            PrintMessage("\n")
            ReturnValue(0)
        }
        
        // Read load address (2 bytes)
        header = Allocate(2)
        bytes = SystemCall(0, fd, header, 2)
        IfCondition NotEqual(bytes, 2) ThenBlock: {
            PrintMessage("Cannot read PRG header\n")
            Deallocate(header, 2)
            SystemCall(3, fd, 0, 0)
            ReturnValue(0)
        }
        
        load_addr = BitwiseOr(GetByte(header, 0), ShiftLeft(GetByte(header, 1), 8))
        Deallocate(header, 2)
        
        PrintMessage("Loading PRG at $")
        PrintHex(load_addr)
        PrintMessage("\n")
        
        // Read rest of file directly into C64 RAM
        // Read in chunks to handle any size
        total_bytes = 0
        chunk = Allocate(256)
        done = 0
        
        WhileLoop EqualTo(done, 0) {
            bytes = SystemCall(0, fd, chunk, 256)
            IfCondition LessEqual(bytes, 0) ThenBlock: {
                done = 1
            } ElseBlock: {
                // Copy to C64 RAM
                i = 0
                WhileLoop LessThan(i, bytes) {
                    dest_addr = Add(load_addr, Add(total_bytes, i))
                    IfCondition LessThan(dest_addr, 0x10000) ThenBlock: {
                        SetByte(C64Mem.ram, dest_addr, GetByte(chunk, i))
                    }
                    i = Add(i, 1)
                }
                total_bytes = Add(total_bytes, bytes)
            }
        }
        
        Deallocate(chunk, 256)
        SystemCall(3, fd, 0, 0)
        
        PrintMessage("Loaded ")
        PrintNumber(total_bytes)
        PrintMessage(" bytes\n")
        
        // Return load address
        ReturnValue(load_addr)
    }
}

// =============================================================================
// DEBUG HELPERS
// =============================================================================

Function.C64Mem_Dump {
    Input: start: Integer
    Input: length: Integer
    Body: {
        PrintMessage("Memory dump from $")
        PrintHex(start)
        PrintMessage(":\n")
        
        i = 0
        WhileLoop LessThan(i, length) {
            // Print address at start of line
            IfCondition EqualTo(Modulo(i, 16), 0) ThenBlock: {
                PrintHex(Add(start, i))
                PrintMessage(": ")
            }
            
            val = C64Mem_Read(Add(start, i))
            PrintHex(val)
            PrintMessage(" ")
            
            // Newline every 16 bytes
            IfCondition EqualTo(Modulo(Add(i, 1), 16), 0) ThenBlock: {
                PrintMessage("\n")
            }
            
            i = Add(i, 1)
        }
        PrintMessage("\n")
    }
}