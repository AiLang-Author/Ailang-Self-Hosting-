// Library.C64VIC.ailang
// VIC-II Video Interface Chip - Functional Emulation
//
// This is NOT cycle-accurate emulation. Instead, we:
//   1. Capture register writes from the CPU
//   2. Render a complete frame when requested
//   3. Output to the Framebuffer library
//
// Supports:
//   - Text mode (40x25 characters)
//   - Bitmap mode (320x200 hi-res, 160x200 multicolor)
//   - 8 hardware sprites
//   - Border and background colors
//   - Smooth scrolling
//   - Character ROM or custom fonts
//
// Does NOT support (would require cycle-accuracy):
//   - Raster interrupts
//   - Sprite-background collision timing
//   - FLI/FLD tricks
//   - VSP/DMA tricks
//
// Usage: LibraryImport.C64VIC
// Requires: Library.Framebuffer, Library.C64Memory

LibraryImport.Framebuffer
LibraryImport.C64Memory

// =============================================================================
// VIC-II REGISTER MAP ($D000-$D3FF, mirrors every 64 bytes)
// =============================================================================
//
// $D000-$D00F: Sprite X/Y positions (8 sprites × 2 bytes)
// $D010: Sprite X MSB (bit 8 for each sprite)
// $D011: Control register 1 (YSCROLL, RSEL, DEN, BMM, ECM, RST8)
// $D012: Raster counter
// $D013-$D014: Light pen X/Y
// $D015: Sprite enable
// $D016: Control register 2 (XSCROLL, CSEL, MCM, RES)
// $D017: Sprite Y expansion
// $D018: Memory pointers (screen, character/bitmap base)
// $D019: Interrupt register
// $D01A: Interrupt enable
// $D01B: Sprite-background priority
// $D01C: Sprite multicolor mode
// $D01D: Sprite X expansion
// $D01E: Sprite-sprite collision
// $D01F: Sprite-background collision
// $D020: Border color
// $D021: Background color 0
// $D022: Background color 1 (multicolor/ECM)
// $D023: Background color 2 (multicolor/ECM)
// $D024: Background color 3 (ECM)
// $D025: Sprite multicolor 0
// $D026: Sprite multicolor 1
// $D027-$D02E: Sprite colors (8 sprites)

// =============================================================================
// VIC STATE
// =============================================================================

FixedPool.VIC {
    // Register storage (64 bytes, mirrored)
    "regs": Initialize=0
    
    // Decoded state (updated on register write)
    "border_color": Initialize=14       // Light blue
    "bg_color_0": Initialize=6          // Blue
    "bg_color_1": Initialize=1
    "bg_color_2": Initialize=2
    "bg_color_3": Initialize=3
    
    // Screen geometry
    "x_scroll": Initialize=0
    "y_scroll": Initialize=3
    "rows_25": Initialize=1             // 1=25 rows, 0=24 rows
    "cols_40": Initialize=1             // 1=40 cols, 0=38 cols
    
    // Display mode
    "display_enable": Initialize=1
    "bitmap_mode": Initialize=0
    "multicolor_mode": Initialize=0
    "extended_color": Initialize=0
    
    // Memory configuration
    "screen_base": Initialize=0x0400    // Default screen at $0400
    "char_base": Initialize=0x1000      // Character ROM at $1000 (really $D000)
    "bitmap_base": Initialize=0x0000
    "bank": Initialize=0                // VIC bank (0-3, set by CIA2)
    
    // Sprite enable mask
    "sprite_enable": Initialize=0
    
    // Display metrics for framebuffer
    "scale": Initialize=2               // 2x scaling (320→640, 200→400)
    "offset_x": Initialize=0            // Centering offset
    "offset_y": Initialize=0
    
    // Frame counter
    "frame_count": Initialize=0
    
    // Initialization flag
    "initialized": Initialize=0
}

// Sprite state (8 sprites)
FixedPool.VIC_Sprites {
    "x": Initialize=0          // X positions (array of 8)
    "y": Initialize=0          // Y positions (array of 8)
    "color": Initialize=0      // Colors (array of 8)
    "x_expand": Initialize=0   // X expansion bits
    "y_expand": Initialize=0   // Y expansion bits
    "multicolor": Initialize=0 // Multicolor mode bits
    "priority": Initialize=0   // Behind background bits
    "mc_color_0": Initialize=0 // Shared multicolor 0
    "mc_color_1": Initialize=0 // Shared multicolor 1
}

// =============================================================================
// INITIALIZATION
// =============================================================================

Function.VIC_Init {
    Output: Integer
    Body: {
        IfCondition EqualTo(VIC.initialized, 1) ThenBlock: {
            ReturnValue(1)
        }
        
        // Allocate register storage
        VIC.regs = Allocate(64)
        i = 0
        WhileLoop LessThan(i, 64) {
            SetByte(VIC.regs, i, 0)
            i = Add(i, 1)
        }
        
        // Allocate sprite coordinate arrays
        VIC_Sprites.x = Allocate(16)      // 8 × 2 bytes (need 9 bits)
        VIC_Sprites.y = Allocate(8)
        VIC_Sprites.color = Allocate(8)
        
        // Initialize sprite positions off-screen
        i = 0
        WhileLoop LessThan(i, 8) {
            SetByte(VIC_Sprites.y, i, 0xFF)
            SetByte(VIC_Sprites.color, i, 1)
            i = Add(i, 1)
        }
        
        // Set default register values (power-on state)
        SetByte(VIC.regs, 0x11, 0x1B)  // $D011: DEN=1, RSEL=1, YSCROLL=3
        SetByte(VIC.regs, 0x16, 0xC8)  // $D016: CSEL=1, XSCROLL=0
        SetByte(VIC.regs, 0x18, 0x14)  // $D018: Screen=$0400, Char=$1000
        SetByte(VIC.regs, 0x20, 14)    // Border: light blue
        SetByte(VIC.regs, 0x21, 6)     // Background: blue
        
        // Decode initial state
        VIC_DecodeRegisters()
        
        // Calculate display offsets for centering
        VIC_CalculateOffsets()
        
        VIC.initialized = 1
        PrintMessage("VIC-II initialized\n")
        ReturnValue(1)
    }
}

Function.VIC_Shutdown {
    Body: {
        IfCondition NotEqual(VIC.regs, 0) ThenBlock: {
            Deallocate(VIC.regs, 64)
            VIC.regs = 0
        }
        IfCondition NotEqual(VIC_Sprites.x, 0) ThenBlock: {
            Deallocate(VIC_Sprites.x, 16)
            VIC_Sprites.x = 0
        }
        IfCondition NotEqual(VIC_Sprites.y, 0) ThenBlock: {
            Deallocate(VIC_Sprites.y, 8)
            VIC_Sprites.y = 0
        }
        IfCondition NotEqual(VIC_Sprites.color, 0) ThenBlock: {
            Deallocate(VIC_Sprites.color, 8)
            VIC_Sprites.color = 0
        }
        VIC.initialized = 0
    }
}

// =============================================================================
// REGISTER ACCESS (called from Memory Bus)
// =============================================================================

// Replace stub in C64Memory with this
Function.C64VIC_Read {
    Input: reg: Integer
    Output: Integer
    Body: {
        r = BitwiseAnd(reg, 0x3F)  // Mirror every 64 bytes
        
        // Some registers have special read behavior
        IfCondition EqualTo(r, 0x12) ThenBlock: {
            // Raster counter - return current raster line
            // For simplicity, return a cycling value
            ReturnValue(BitwiseAnd(VIC.frame_count, 0xFF))
        }
        
        IfCondition EqualTo(r, 0x1E) ThenBlock: {
            // Sprite-sprite collision - cleared on read
            val = GetByte(VIC.regs, r)
            SetByte(VIC.regs, r, 0)
            ReturnValue(val)
        }
        
        IfCondition EqualTo(r, 0x1F) ThenBlock: {
            // Sprite-background collision - cleared on read
            val = GetByte(VIC.regs, r)
            SetByte(VIC.regs, r, 0)
            ReturnValue(val)
        }
        
        ReturnValue(GetByte(VIC.regs, r))
    }
}

Function.C64VIC_Write {
    Input: reg: Integer
    Input: value: Integer
    Body: {
        r = BitwiseAnd(reg, 0x3F)
        v = BitwiseAnd(value, 0xFF)
        
        // Store raw value
        SetByte(VIC.regs, r, v)
        
        // Decode specific registers immediately for performance
        
        // Sprite X low bytes
        IfCondition LessThan(r, 0x10) ThenBlock: {
            sprite = Divide(r, 2)
            IfCondition EqualTo(Modulo(r, 2), 0) ThenBlock: {
                // X low byte
                VIC_SetSpriteX(sprite, v)
            } ElseBlock: {
                // Y position
                SetByte(VIC_Sprites.y, sprite, v)
            }
            ReturnValue(0)
        }
        
        // Sprite X MSB
        IfCondition EqualTo(r, 0x10) ThenBlock: {
            // Update high bit of each sprite's X
            i = 0
            WhileLoop LessThan(i, 8) {
                bit = BitwiseAnd(ShiftRight(v, i), 1)
                x_lo = GetByte(VIC_Sprites.x, i)
                x_full = BitwiseOr(x_lo, ShiftLeft(bit, 8))
                // Store full X in 16-bit slot
                SetByte(VIC_Sprites.x, i, BitwiseAnd(x_full, 0xFF))
                SetByte(VIC_Sprites.x, Add(i, 8), bit)
                i = Add(i, 1)
            }
            ReturnValue(0)
        }
        
        // Control register 1 ($D011)
        IfCondition EqualTo(r, 0x11) ThenBlock: {
            VIC.y_scroll = BitwiseAnd(v, 0x07)
            VIC.rows_25 = BitwiseAnd(ShiftRight(v, 3), 1)
            VIC.display_enable = BitwiseAnd(ShiftRight(v, 4), 1)
            VIC.bitmap_mode = BitwiseAnd(ShiftRight(v, 5), 1)
            VIC.extended_color = BitwiseAnd(ShiftRight(v, 6), 1)
            ReturnValue(0)
        }
        
        // Sprite enable ($D015)
        IfCondition EqualTo(r, 0x15) ThenBlock: {
            VIC.sprite_enable = v
            ReturnValue(0)
        }
        
        // Control register 2 ($D016)
        IfCondition EqualTo(r, 0x16) ThenBlock: {
            VIC.x_scroll = BitwiseAnd(v, 0x07)
            VIC.cols_40 = BitwiseAnd(ShiftRight(v, 3), 1)
            VIC.multicolor_mode = BitwiseAnd(ShiftRight(v, 4), 1)
            ReturnValue(0)
        }
        
        // Sprite Y expansion ($D017)
        IfCondition EqualTo(r, 0x17) ThenBlock: {
            VIC_Sprites.y_expand = v
            ReturnValue(0)
        }
        
        // Memory pointers ($D018)
        IfCondition EqualTo(r, 0x18) ThenBlock: {
            // Bits 1-3: Character base (×$800)
            // Bits 4-7: Screen base (×$400)
            char_ptr = BitwiseAnd(ShiftRight(v, 1), 0x07)
            screen_ptr = BitwiseAnd(ShiftRight(v, 4), 0x0F)
            
            VIC.char_base = Multiply(char_ptr, 0x800)
            VIC.screen_base = Multiply(screen_ptr, 0x400)
            
            // In bitmap mode, bit 3 selects bitmap base
            IfCondition NotEqual(BitwiseAnd(v, 0x08), 0) ThenBlock: {
                VIC.bitmap_base = 0x2000
            } ElseBlock: {
                VIC.bitmap_base = 0x0000
            }
            ReturnValue(0)
        }
        
        // Sprite priority ($D01B)
        IfCondition EqualTo(r, 0x1B) ThenBlock: {
            VIC_Sprites.priority = v
            ReturnValue(0)
        }
        
        // Sprite multicolor ($D01C)
        IfCondition EqualTo(r, 0x1C) ThenBlock: {
            VIC_Sprites.multicolor = v
            ReturnValue(0)
        }
        
        // Sprite X expansion ($D01D)
        IfCondition EqualTo(r, 0x1D) ThenBlock: {
            VIC_Sprites.x_expand = v
            ReturnValue(0)
        }
        
        // Border color ($D020)
        IfCondition EqualTo(r, 0x20) ThenBlock: {
            VIC.border_color = BitwiseAnd(v, 0x0F)
            ReturnValue(0)
        }
        
        // Background colors ($D021-$D024)
        IfCondition EqualTo(r, 0x21) ThenBlock: {
            VIC.bg_color_0 = BitwiseAnd(v, 0x0F)
            ReturnValue(0)
        }
        IfCondition EqualTo(r, 0x22) ThenBlock: {
            VIC.bg_color_1 = BitwiseAnd(v, 0x0F)
            ReturnValue(0)
        }
        IfCondition EqualTo(r, 0x23) ThenBlock: {
            VIC.bg_color_2 = BitwiseAnd(v, 0x0F)
            ReturnValue(0)
        }
        IfCondition EqualTo(r, 0x24) ThenBlock: {
            VIC.bg_color_3 = BitwiseAnd(v, 0x0F)
            ReturnValue(0)
        }
        
        // Sprite multicolor colors ($D025-$D026)
        IfCondition EqualTo(r, 0x25) ThenBlock: {
            VIC_Sprites.mc_color_0 = BitwiseAnd(v, 0x0F)
            ReturnValue(0)
        }
        IfCondition EqualTo(r, 0x26) ThenBlock: {
            VIC_Sprites.mc_color_1 = BitwiseAnd(v, 0x0F)
            ReturnValue(0)
        }
        
        // Sprite colors ($D027-$D02E)
        IfCondition And(GreaterEqual(r, 0x27), LessEqual(r, 0x2E)) ThenBlock: {
            sprite = Subtract(r, 0x27)
            SetByte(VIC_Sprites.color, sprite, BitwiseAnd(v, 0x0F))
            ReturnValue(0)
        }
    }
}

// Helper to set sprite X with MSB handling
Function.VIC_SetSpriteX {
    Input: sprite: Integer
    Input: x_lo: Integer
    Body: {
        // Preserve high bit from MSB register
        msb_reg = GetByte(VIC.regs, 0x10)
        x_hi = BitwiseAnd(ShiftRight(msb_reg, sprite), 1)
        
        SetByte(VIC_Sprites.x, sprite, x_lo)
        SetByte(VIC_Sprites.x, Add(sprite, 8), x_hi)
    }
}

// Decode all registers (used at init)
Function.VIC_DecodeRegisters {
    Body: {
        // Read and decode $D011
        v = GetByte(VIC.regs, 0x11)
        VIC.y_scroll = BitwiseAnd(v, 0x07)
        VIC.rows_25 = BitwiseAnd(ShiftRight(v, 3), 1)
        VIC.display_enable = BitwiseAnd(ShiftRight(v, 4), 1)
        VIC.bitmap_mode = BitwiseAnd(ShiftRight(v, 5), 1)
        VIC.extended_color = BitwiseAnd(ShiftRight(v, 6), 1)
        
        // Read and decode $D016
        v = GetByte(VIC.regs, 0x16)
        VIC.x_scroll = BitwiseAnd(v, 0x07)
        VIC.cols_40 = BitwiseAnd(ShiftRight(v, 3), 1)
        VIC.multicolor_mode = BitwiseAnd(ShiftRight(v, 4), 1)
        
        // Colors
        VIC.border_color = BitwiseAnd(GetByte(VIC.regs, 0x20), 0x0F)
        VIC.bg_color_0 = BitwiseAnd(GetByte(VIC.regs, 0x21), 0x0F)
    }
}

// Calculate framebuffer offsets for centering
Function.VIC_CalculateOffsets {
    Body: {
        fb_width = FB_GetWidth()
        fb_height = FB_GetHeight()
        
        // C64 visible area: 320x200
        // With 2x scale: 640x400
        c64_width = Multiply(320, VIC.scale)
        c64_height = Multiply(200, VIC.scale)
        
        VIC.offset_x = Divide(Subtract(fb_width, c64_width), 2)
        VIC.offset_y = Divide(Subtract(fb_height, c64_height), 2)
        
        // Ensure non-negative
        IfCondition LessThan(VIC.offset_x, 0) ThenBlock: { VIC.offset_x = 0 }
        IfCondition LessThan(VIC.offset_y, 0) ThenBlock: { VIC.offset_y = 0 }
    }
}

// =============================================================================
// FRAME RENDERING
// =============================================================================

Function.VIC_RenderFrame {
    Body: {
        // Draw border (full screen)
        border = FB_C64Color(VIC.border_color)
        FB_Clear(border)
        
        // Draw main display area if enabled
        IfCondition EqualTo(VIC.display_enable, 1) ThenBlock: {
            // Background
            bg = FB_C64Color(VIC.bg_color_0)
            main_x = VIC.offset_x
            main_y = VIC.offset_y
            main_w = Multiply(320, VIC.scale)
            main_h = Multiply(200, VIC.scale)
            FB_FillRect(main_x, main_y, main_w, main_h, bg)
            
            // Render screen content
            IfCondition EqualTo(VIC.bitmap_mode, 0) ThenBlock: {
                VIC_RenderTextMode()
            } ElseBlock: {
                VIC_RenderBitmapMode()
            }
            
            // Render sprites (front to back, 0 is frontmost)
            VIC_RenderSprites()
        }
        
        VIC.frame_count = Add(VIC.frame_count, 1)
        
        // Flip to display
        FB_FlipFast()
    }
}

// =============================================================================
// TEXT MODE RENDERING
// =============================================================================

Function.VIC_RenderTextMode {
    Body: {
        // 40 columns × 25 rows
        // Each character is 8×8 pixels
        
        rows = 25
        cols = 40
        IfCondition EqualTo(VIC.rows_25, 0) ThenBlock: { rows = 24 }
        IfCondition EqualTo(VIC.cols_40, 0) ThenBlock: { cols = 38 }
        
        // Calculate actual memory addresses (apply VIC bank)
        bank_base = Multiply(VIC.bank, 0x4000)
        screen_addr = Add(bank_base, VIC.screen_base)
        char_addr = Add(bank_base, VIC.char_base)
        
        // Color RAM is always at $D800
        color_base = 0xD800
        
        row = 0
        WhileLoop LessThan(row, rows) {
            col = 0
            WhileLoop LessThan(col, cols) {
                // Get character code
                screen_offset = Add(Multiply(row, 40), col)
                char_code = C64Mem_Read(Add(screen_addr, screen_offset))
                
                // Get color from Color RAM
                color_index = BitwiseAnd(C64Mem_Read(Add(color_base, screen_offset)), 0x0F)
                fg_color = FB_C64Color(color_index)
                bg_color = FB_C64Color(VIC.bg_color_0)
                
                // Calculate screen position
                screen_x = Add(VIC.offset_x, Multiply(Multiply(col, 8), VIC.scale))
                screen_y = Add(VIC.offset_y, Multiply(Multiply(row, 8), VIC.scale))
                
                // Render character
                VIC_RenderChar(screen_x, screen_y, char_code, fg_color, bg_color)
                
                col = Add(col, 1)
            }
            row = Add(row, 1)
        }
    }
}

// Render single character from Character ROM/RAM
Function.VIC_RenderChar {
    Input: screen_x: Integer
    Input: screen_y: Integer
    Input: char_code: Integer
    Input: fg_color: Integer
    Input: bg_color: Integer
    Body: {
        // Character data is 8 bytes per character
        // Located at char_base + (char_code × 8)
        
        bank_base = Multiply(VIC.bank, 0x4000)
        char_addr = Add(bank_base, VIC.char_base)
        
        // Special case: if char_base points to $1000-$1FFF or $9000-$9FFF,
        // VIC sees Character ROM (normally at $D000)
        // For now, read from our char_rom copy
        char_data_addr = Add(char_addr, Multiply(char_code, 8))
        
        // Check if we should use Character ROM
        use_char_rom = 0
        char_rel = BitwiseAnd(VIC.char_base, 0x3FFF)
        IfCondition Or(EqualTo(char_rel, 0x1000), EqualTo(char_rel, 0x1800)) ThenBlock: {
            use_char_rom = 1
        }
        
        pixel_row = 0
        WhileLoop LessThan(pixel_row, 8) {
            // Get row bitmap
            IfCondition EqualTo(use_char_rom, 1) ThenBlock: {
                row_data = GetByte(C64Mem.char_rom, Add(Multiply(char_code, 8), pixel_row))
            } ElseBlock: {
                row_data = C64Mem_Read(Add(char_data_addr, pixel_row))
            }
            
            pixel_col = 0
            WhileLoop LessThan(pixel_col, 8) {
                // Check if pixel is set (MSB first)
                bit = BitwiseAnd(ShiftRight(row_data, Subtract(7, pixel_col)), 1)
                
                IfCondition NotEqual(bit, 0) ThenBlock: {
                    color = fg_color
                } ElseBlock: {
                    color = bg_color
                }
                
                // Draw scaled pixel
                px = Add(screen_x, Multiply(pixel_col, VIC.scale))
                py = Add(screen_y, Multiply(pixel_row, VIC.scale))
                
                // Draw scale×scale block
                sy = 0
                WhileLoop LessThan(sy, VIC.scale) {
                    sx = 0
                    WhileLoop LessThan(sx, VIC.scale) {
                        FB_SetPixel(Add(px, sx), Add(py, sy), color)
                        sx = Add(sx, 1)
                    }
                    sy = Add(sy, 1)
                }
                
                pixel_col = Add(pixel_col, 1)
            }
            pixel_row = Add(pixel_row, 1)
        }
    }
}

// =============================================================================
// BITMAP MODE RENDERING
// =============================================================================

Function.VIC_RenderBitmapMode {
    Body: {
        // 320×200 bitmap (40×25 cells × 8×8 pixels)
        // Each cell: 8 bytes of bitmap data, 1 byte of color
        
        bank_base = Multiply(VIC.bank, 0x4000)
        bitmap_addr = Add(bank_base, VIC.bitmap_base)
        screen_addr = Add(bank_base, VIC.screen_base)  // Color info
        
        cell_row = 0
        WhileLoop LessThan(cell_row, 25) {
            cell_col = 0
            WhileLoop LessThan(cell_col, 40) {
                cell_index = Add(Multiply(cell_row, 40), cell_col)
                
                // Get colors for this cell from screen RAM
                color_byte = C64Mem_Read(Add(screen_addr, cell_index))
                fg_index = BitwiseAnd(ShiftRight(color_byte, 4), 0x0F)
                bg_index = BitwiseAnd(color_byte, 0x0F)
                fg_color = FB_C64Color(fg_index)
                bg_color = FB_C64Color(bg_index)
                
                // Bitmap data: 8 bytes per cell
                bitmap_offset = Multiply(cell_index, 8)
                
                pixel_row = 0
                WhileLoop LessThan(pixel_row, 8) {
                    row_data = C64Mem_Read(Add(bitmap_addr, Add(bitmap_offset, pixel_row)))
                    
                    pixel_col = 0
                    WhileLoop LessThan(pixel_col, 8) {
                        bit = BitwiseAnd(ShiftRight(row_data, Subtract(7, pixel_col)), 1)
                        
                        IfCondition NotEqual(bit, 0) ThenBlock: {
                            color = fg_color
                        } ElseBlock: {
                            color = bg_color
                        }
                        
                        // Calculate screen position
                        x = Add(Multiply(cell_col, 8), pixel_col)
                        y = Add(Multiply(cell_row, 8), pixel_row)
                        
                        px = Add(VIC.offset_x, Multiply(x, VIC.scale))
                        py = Add(VIC.offset_y, Multiply(y, VIC.scale))
                        
                        // Draw scaled pixel
                        sy = 0
                        WhileLoop LessThan(sy, VIC.scale) {
                            sx = 0
                            WhileLoop LessThan(sx, VIC.scale) {
                                FB_SetPixel(Add(px, sx), Add(py, sy), color)
                                sx = Add(sx, 1)
                            }
                            sy = Add(sy, 1)
                        }
                        
                        pixel_col = Add(pixel_col, 1)
                    }
                    pixel_row = Add(pixel_row, 1)
                }
                
                cell_col = Add(cell_col, 1)
            }
            cell_row = Add(cell_row, 1)
        }
    }
}

// =============================================================================
// SPRITE RENDERING
// =============================================================================

Function.VIC_RenderSprites {
    Body: {
        // Render sprites 7 down to 0 (0 has highest priority, drawn last)
        sprite = 7
        WhileLoop GreaterEqual(sprite, 0) {
            // Check if sprite is enabled
            enabled = BitwiseAnd(ShiftRight(VIC.sprite_enable, sprite), 1)
            
            IfCondition NotEqual(enabled, 0) ThenBlock: {
                VIC_RenderSprite(sprite)
            }
            
            sprite = Subtract(sprite, 1)
        }
    }
}

Function.VIC_RenderSprite {
    Input: sprite: Integer
    Body: {
        // Get sprite position
        x_lo = GetByte(VIC_Sprites.x, sprite)
        x_hi = GetByte(VIC_Sprites.x, Add(sprite, 8))
        sprite_x = BitwiseOr(x_lo, ShiftLeft(x_hi, 8))
        sprite_y = GetByte(VIC_Sprites.y, sprite)
        
        // Get sprite color
        color_index = GetByte(VIC_Sprites.color, sprite)
        sprite_color = FB_C64Color(color_index)
        
        // Check expansion
        x_expand = BitwiseAnd(ShiftRight(VIC_Sprites.x_expand, sprite), 1)
        y_expand = BitwiseAnd(ShiftRight(VIC_Sprites.y_expand, sprite), 1)
        
        // Sprite dimensions
        width = 24
        height = 21
        IfCondition NotEqual(x_expand, 0) ThenBlock: { width = 48 }
        IfCondition NotEqual(y_expand, 0) ThenBlock: { height = 42 }
        
        // Get sprite data pointer from screen RAM
        // Sprite pointers are at screen_base + $3F8 + sprite_num
        bank_base = Multiply(VIC.bank, 0x4000)
        pointer_addr = Add(Add(bank_base, VIC.screen_base), Add(0x3F8, sprite))
        sprite_pointer = C64Mem_Read(pointer_addr)
        
        // Sprite data is at bank_base + pointer × 64
        sprite_data_addr = Add(bank_base, Multiply(sprite_pointer, 64))
        
        // Convert C64 coordinates to screen coordinates
        // C64 sprite X starts at 24, Y starts at 50 for visible area
        screen_x = Add(VIC.offset_x, Multiply(Subtract(sprite_x, 24), VIC.scale))
        screen_y = Add(VIC.offset_y, Multiply(Subtract(sprite_y, 50), VIC.scale))
        
        // Render sprite (24×21 pixels, 3 bytes per row)
        row = 0
        WhileLoop LessThan(row, 21) {
            byte_num = 0
            WhileLoop LessThan(byte_num, 3) {
                row_data = C64Mem_Read(Add(sprite_data_addr, Add(Multiply(row, 3), byte_num)))
                
                bit = 0
                WhileLoop LessThan(bit, 8) {
                    pixel_set = BitwiseAnd(ShiftRight(row_data, Subtract(7, bit)), 1)
                    
                    IfCondition NotEqual(pixel_set, 0) ThenBlock: {
                        // Calculate pixel position
                        px_col = Add(Multiply(byte_num, 8), bit)
                        
                        // Apply expansion
                        x_mult = VIC.scale
                        y_mult = VIC.scale
                        IfCondition NotEqual(x_expand, 0) ThenBlock: { x_mult = Multiply(x_mult, 2) }
                        IfCondition NotEqual(y_expand, 0) ThenBlock: { y_mult = Multiply(y_mult, 2) }
                        
                        px = Add(screen_x, Multiply(px_col, x_mult))
                        py = Add(screen_y, Multiply(row, y_mult))
                        
                        // Draw expanded pixel
                        sy = 0
                        WhileLoop LessThan(sy, y_mult) {
                            sx = 0
                            WhileLoop LessThan(sx, x_mult) {
                                FB_SetPixel(Add(px, sx), Add(py, sy), sprite_color)
                                sx = Add(sx, 1)
                            }
                            sy = Add(sy, 1)
                        }
                    }
                    
                    bit = Add(bit, 1)
                }
                byte_num = Add(byte_num, 1)
            }
            row = Add(row, 1)
        }
    }
}

// =============================================================================
// CONVENIENCE FUNCTIONS
// =============================================================================

// Set border color (equivalent to POKE 53280, color)
Function.VIC_SetBorder {
    Input: color: Integer
    Body: {
        C64Mem_Write(0xD020, color)
    }
}

// Set background color (equivalent to POKE 53281, color)
Function.VIC_SetBackground {
    Input: color: Integer
    Body: {
        C64Mem_Write(0xD021, color)
    }
}

// Print character at screen position
Function.VIC_PrintAt {
    Input: col: Integer
    Input: row: Integer
    Input: char_code: Integer
    Input: color: Integer
    Body: {
        offset = Add(Multiply(row, 40), col)
        C64Mem_Write(Add(VIC.screen_base, offset), char_code)
        C64Mem_Write(Add(0xD800, offset), color)
    }
}

// Print string at screen position
Function.VIC_PrintString {
    Input: col: Integer
    Input: row: Integer
    Input: str: Address
    Input: color: Integer
    Body: {
        i = 0
        c = col
        
        ch = GetByte(str, i)
        WhileLoop NotEqual(ch, 0) {
            // Convert ASCII to PETSCII screen codes (simplified)
            screen_code = ch
            IfCondition And(GreaterEqual(ch, 65), LessEqual(ch, 90)) ThenBlock: {
                // Uppercase A-Z
                screen_code = Subtract(ch, 64)
            }
            IfCondition And(GreaterEqual(ch, 97), LessEqual(ch, 122)) ThenBlock: {
                // Lowercase a-z
                screen_code = Subtract(ch, 96)
            }
            
            VIC_PrintAt(c, row, screen_code, color)
            c = Add(c, 1)
            i = Add(i, 1)
            ch = GetByte(str, i)
        }
    }
}

// Clear screen
Function.VIC_ClearScreen {
    Input: char_code: Integer
    Input: color: Integer
    Body: {
        i = 0
        WhileLoop LessThan(i, 1000) {
            C64Mem_Write(Add(VIC.screen_base, i), char_code)
            C64Mem_Write(Add(0xD800, i), color)
            i = Add(i, 1)
        }
    }
}