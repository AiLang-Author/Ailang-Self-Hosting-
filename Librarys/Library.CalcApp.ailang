// Library.CalcApp.ailang
// Calculator app shell — action callback + JSON messaging glue
//
// Uses AppHost_Open to launch from HTML. Only contains:
//   - Self-registration with EventRouter
//   - Action callback: converts button actions to JSON requests
//   - Response handler: updates display label from JSON response
//
// ZERO window/context/toolbar/rendering code — that's all AppHost.
// ZERO arithmetic logic — that's all Library.Calculator.
//
// Copyright 2026 Sean Collins, 2 Paws Machine and Engineering. SCSL.

LibraryImport.WinManager
LibraryImport.Auckland
LibraryImport.JSON
LibraryImport.StringUtils
LibraryImport.Calculator
LibraryImport.EventRouter
LibraryImport.AppHost

// =============================================================================
// APP STATE — UI-side state for the calculator window
// =============================================================================
FixedPool.CalcAppState {
    "win_idx":       Initialize=-1, CanChange=True
    "display_node":  Initialize=-1, CanChange=True
    "display_buf":   Initialize=0, CanChange=True
    "display_len":   Initialize=0, CanChange=True
    "initialized":   Initialize=0, CanChange=True
}

// =============================================================================
// CALCAPP_INIT — register with EventRouter
// =============================================================================
Function.CalcApp_Init {
    Body: {
        EventRouter_RegisterHandler("app.calc", AddressOf(CalcApp_Open))
    }
}

// =============================================================================
// CALCAPP_OPEN — launch calculator window via AppHost
// =============================================================================
Function.CalcApp_Open {
    Body: {
        DebugLog_Push("capp.op", 7)

        // Guard: only one calculator at a time
        IfCondition GreaterEqual(CalcAppState.win_idx, 0) ThenBlock: {
            PrintMessage("[CalcApp] already open\n")
            ReturnValue(0)
        }

        // Lazy init: allocate display buffer on first open
        IfCondition EqualTo(CalcAppState.initialized, 0) ThenBlock: {
            CalcAppState.display_buf = Allocate(32)
            IfCondition EqualTo(CalcAppState.display_buf, 0) ThenBlock: {
                PrintMessage("[CalcApp] display_buf alloc fail\n")
                ReturnValue(0)
            }
            SetByte(CalcAppState.display_buf, 0, 48)
            SetByte(CalcAppState.display_buf, 1, 0)
            CalcAppState.display_len = 1
            CalcAppState.initialized = 1
        }

        // Open window from HTML — AppHost handles everything generic
        win_idx = AppHost_Open("config/calculator.html", AddressOf(CalcApp_ActionCb))
        IfCondition LessEqual(win_idx, 0) ThenBlock: {
            PrintMessage("[CalcApp] AppHost_Open fail\n")
            ReturnValue(0)
        }
        CalcAppState.win_idx = win_idx

        // Find display label node (first LABEL in tree)
        ctx = WinView_GetContentCtx(win_idx)
        CalcAppState.display_node = CalcApp_FindDisplayNode(ctx)

        // Reset calculator state via JSON
        CalcApp_SendJson("{\"method\":\"clear\"}", 18)

        PrintMessage("[CalcApp] ready\n")
        ReturnValue(1)
    }
}

// =============================================================================
// FIND DISPLAY NODE — scan tree for first LABEL tag
// =============================================================================
Function.CalcApp_FindDisplayNode {
    Input: ctx: LinkagePool.AKContext
    Output: Integer
    Body: {
        cnt = ctx@tree_count
        i = 0
        WhileLoop LessThan(i, cnt) {
            tag = AK_Get(ctx, i, AKF.TAG)
            IfCondition EqualTo(tag, AKTag.LABEL) ThenBlock: {
                ReturnValue(i)
            }
            i = Add(i, 1)
        }
        ReturnValue(-1)
    }
}

// =============================================================================
// ACTION CALLBACK — called from AK_FireAction inside AK_EventMouse
//
// Converts button action string to JSON, sends to Calc_JsonHandle,
// parses response, updates display.
// =============================================================================
Function.CalcApp_ActionCb {
    Input: action_ptr: Address
    Input: action_len: Integer
    Output: Integer
    Body: {
        DebugLog_Push("capp.ac", 7)

        // Build JSON request from action string
        json_req = CalcApp_ActionToJson(action_ptr, action_len)
        IfCondition EqualTo(json_req, 0) ThenBlock: {
            ReturnValue(0)
        }

        // Send to calculator and get response
        json_len = StringLength(json_req)
        resp = Calc_JsonHandle(json_req, json_len)

        // Parse response and update display
        IfCondition NotEqual(resp, 0) ThenBlock: {
            CalcApp_HandleResponse(resp)
        }

        ReturnValue(1)
    }
}

// =============================================================================
// ACTION TO JSON — convert "c.*" action string to JSON request
// =============================================================================
Function.CalcApp_ActionToJson {
    Input: action_ptr: Address
    Input: action_len: Integer
    Output: Address
    Body: {
        // Digit: action_len==3 and byte[2] is '0'-'9'
        IfCondition EqualTo(action_len, 3) ThenBlock: {
            d = Subtract(GetByte(action_ptr, 2), 48)
            IfCondition And(GreaterEqual(d, 0), LessEqual(d, 9)) ThenBlock: {
                req = JSON.NewObject()
                JSON.SetString(req, "method", "digit")
                JSON.SetNumber(req, "value", d)
                s = JSON.SerializeObject(req)
                JSON.Free(req)
                ReturnValue(s)
            }
        }

        // Operators
        IfCondition EqualTo(StringCompare(action_ptr, "c.add"), 0) ThenBlock: {
            ReturnValue(CalcApp_OpJson(CalcOp.ADD))
        }
        IfCondition EqualTo(StringCompare(action_ptr, "c.sub"), 0) ThenBlock: {
            ReturnValue(CalcApp_OpJson(CalcOp.SUB))
        }
        IfCondition EqualTo(StringCompare(action_ptr, "c.mul"), 0) ThenBlock: {
            ReturnValue(CalcApp_OpJson(CalcOp.MUL))
        }
        IfCondition EqualTo(StringCompare(action_ptr, "c.div"), 0) ThenBlock: {
            ReturnValue(CalcApp_OpJson(CalcOp.DIV))
        }

        // Simple actions
        IfCondition EqualTo(StringCompare(action_ptr, "c.eq"), 0) ThenBlock: {
            ReturnValue(CalcApp_MethodJson("equals"))
        }
        IfCondition EqualTo(StringCompare(action_ptr, "c.clr"), 0) ThenBlock: {
            ReturnValue(CalcApp_MethodJson("clear"))
        }
        IfCondition EqualTo(StringCompare(action_ptr, "c.neg"), 0) ThenBlock: {
            ReturnValue(CalcApp_MethodJson("negate"))
        }
        IfCondition EqualTo(StringCompare(action_ptr, "c.pct"), 0) ThenBlock: {
            ReturnValue(CalcApp_MethodJson("percent"))
        }
        IfCondition EqualTo(StringCompare(action_ptr, "c.bk"), 0) ThenBlock: {
            ReturnValue(CalcApp_MethodJson("backspace"))
        }

        ReturnValue(0)
    }
}

// =============================================================================
// JSON HELPERS — build request objects
// =============================================================================
Function.CalcApp_MethodJson {
    Input: method_str: Address
    Output: Address
    Body: {
        req = JSON.NewObject()
        JSON.SetString(req, "method", method_str)
        s = JSON.SerializeObject(req)
        JSON.Free(req)
        ReturnValue(s)
    }
}

Function.CalcApp_OpJson {
    Input: op: Integer
    Output: Address
    Body: {
        req = JSON.NewObject()
        JSON.SetString(req, "method", "operator")
        JSON.SetNumber(req, "op", op)
        s = JSON.SerializeObject(req)
        JSON.Free(req)
        ReturnValue(s)
    }
}

// =============================================================================
// SEND JSON — convenience for sending a literal JSON string
// =============================================================================
Function.CalcApp_SendJson {
    Input: json_str: Address
    Input: json_len: Integer
    Body: {
        resp = Calc_JsonHandle(json_str, json_len)
        IfCondition NotEqual(resp, 0) ThenBlock: {
            CalcApp_HandleResponse(resp)
        }
    }
}

// =============================================================================
// HANDLE RESPONSE — parse JSON response, update display label
// =============================================================================
Function.CalcApp_HandleResponse {
    Input: resp_str: Address
    Body: {
        parsed = ParseJSON(resp_str)
        IfCondition EqualTo(parsed, 0) ThenBlock: { ReturnValue(0) }

        obj = JSON.AsObject(parsed)
        display = JSON.GetString(obj, "display")
        IfCondition NotEqual(display, 0) ThenBlock: {
            CalcApp_SetDisplayText(display)
        }

        JSON.Free(parsed)
    }
}

// =============================================================================
// SET DISPLAY TEXT — update label node with new text string
// =============================================================================
Function.CalcApp_SetDisplayText {
    Input: text: Address
    Body: {
        len = StringLength(text)
        IfCondition GreaterThan(len, 30) ThenBlock: { len = 30 }
        MemoryCopy(CalcAppState.display_buf, text, len)
        SetByte(CalcAppState.display_buf, len, 0)
        CalcAppState.display_len = len

        // Update the label node
        IfCondition LessThan(CalcAppState.win_idx, 0) ThenBlock: { ReturnValue(0) }
        ctx = WinView_GetContentCtx(CalcAppState.win_idx)
        dn = CalcAppState.display_node
        IfCondition GreaterEqual(dn, 0) ThenBlock: {
            AK_ExtraSet(ctx, dn, AKExtra.STR_PTR, CalcAppState.display_buf)
            AK_ExtraSet(ctx, dn, AKExtra.STR_LEN, len)
            AK_Set(ctx, dn, AKF.DIRTY, 1)
        }
    }
}

// =============================================================================
// CALCAPP_CLOSE — close via AppHost
// =============================================================================
Function.CalcApp_Close {
    Body: {
        DebugLog_Push("capp.cl", 7)
        IfCondition LessThan(CalcAppState.win_idx, 0) ThenBlock: { ReturnValue(0) }

        AppHost_Close(CalcAppState.win_idx)
        CalcAppState.win_idx = -1
        CalcAppState.display_node = -1
        PrintMessage("[CalcApp] closed\n")
    }
}
