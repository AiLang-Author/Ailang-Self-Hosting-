// Library.Calculator.ailang
// Calculator — pure JSON state machine, ZERO UI code
//
// Interface:
//   Calc_JsonHandle(json_str, json_len) → json_response_str
//
// JSON Protocol:
//   Request:  {"method":"digit",     "value":5}
//   Request:  {"method":"operator",  "op":1}       (1=add,2=sub,3=mul,4=div)
//   Request:  {"method":"equals"}
//   Request:  {"method":"clear"}
//   Request:  {"method":"negate"}
//   Request:  {"method":"percent"}
//   Request:  {"method":"backspace"}
//   Response: {"display":"42"}
//
// This contract is language-agnostic. Any external process can implement
// it and communicate via IPC/MessagePort/socket.
//
// Copyright 2026 Sean Collins, 2 Paws Machine and Engineering. SCSL.

LibraryImport.JSON
LibraryImport.StringUtils

// =============================================================================
// STATE
// =============================================================================
FixedPool.CalcState {
    "display_val":   Initialize=0, CanChange=True
    "pending_op":    Initialize=0, CanChange=True
    "pending_val":   Initialize=0, CanChange=True
    "input_mode":    Initialize=0, CanChange=True
}

FixedPool.CalcOp {
    "NONE": Initialize=0
    "ADD":  Initialize=1
    "SUB":  Initialize=2
    "MUL":  Initialize=3
    "DIV":  Initialize=4
}

// =============================================================================
// JSON HANDLE — the single entry point
//
// Receives a JSON request string, dispatches to state machine, returns
// a JSON response string. Caller owns the returned string.
// =============================================================================
Function.Calc_JsonHandle {
    Input: json_str: Address
    Input: json_len: Integer
    Output: Address
    Body: {
        PrintMessage("[Calc.JSON] >> ")
        PrintString(json_str)
        PrintMessage("\n")

        parsed = ParseJSON(json_str)
        IfCondition EqualTo(parsed, 0) ThenBlock: {
            PrintMessage("[Calc] JSON parse fail\n")
            ReturnValue(0)
        }
        req = JSON.AsObject(parsed)
        method = JSON.GetString(req, "method")

        // Dispatch by method name
        IfCondition EqualTo(StringCompare(method, "digit"), 0) ThenBlock: {
            val = JSON.GetNumber(req, "value")
            Calc_Digit(val)
        }
        IfCondition EqualTo(StringCompare(method, "operator"), 0) ThenBlock: {
            op = JSON.GetNumber(req, "op")
            Calc_Operator(op)
        }
        IfCondition EqualTo(StringCompare(method, "equals"), 0) ThenBlock: {
            Calc_Equals()
        }
        IfCondition EqualTo(StringCompare(method, "clear"), 0) ThenBlock: {
            Calc_Clear()
        }
        IfCondition EqualTo(StringCompare(method, "negate"), 0) ThenBlock: {
            Calc_Negate()
        }
        IfCondition EqualTo(StringCompare(method, "percent"), 0) ThenBlock: {
            Calc_Percent()
        }
        IfCondition EqualTo(StringCompare(method, "backspace"), 0) ThenBlock: {
            Calc_Backspace()
        }

        // Build response: {"display":"N"}
        resp = JSON.NewObject()
        ds = NumberToString(CalcState.display_val)
        JSON.SetString(resp, "display", ds)
        resp_str = JSON.SerializeObject(resp)

        PrintMessage("[Calc.JSON] << ")
        PrintString(resp_str)
        PrintMessage("\n")

        JSON.Free(parsed)
        JSON.Free(resp)
        ReturnValue(resp_str)
    }
}

// =============================================================================
// STATE MACHINE — internal, called from Calc_JsonHandle
// =============================================================================

Function.Calc_Digit {
    Input: d: Integer
    Body: {
        IfCondition EqualTo(CalcState.input_mode, 0) ThenBlock: {
            CalcState.display_val = d
            CalcState.input_mode = 1
        } ElseBlock: {
            CalcState.display_val = Add(Multiply(CalcState.display_val, 10), d)
        }
    }
}

Function.Calc_Operator {
    Input: op: Integer
    Body: {
        // Chain: if pending op and user was entering digits, evaluate first
        IfCondition And(NotEqual(CalcState.pending_op, CalcOp.NONE), EqualTo(CalcState.input_mode, 1)) ThenBlock: {
            Calc_Evaluate()
        }
        CalcState.pending_val = CalcState.display_val
        CalcState.pending_op  = op
        CalcState.input_mode  = 0
    }
}

Function.Calc_Equals {
    Body: {
        Calc_Evaluate()
        CalcState.pending_op = CalcOp.NONE
        CalcState.input_mode = 0
    }
}

Function.Calc_Clear {
    Body: {
        CalcState.display_val = 0
        CalcState.pending_op  = CalcOp.NONE
        CalcState.pending_val = 0
        CalcState.input_mode  = 0
    }
}

Function.Calc_Negate {
    Body: {
        CalcState.display_val = Subtract(0, CalcState.display_val)
    }
}

Function.Calc_Percent {
    Body: {
        CalcState.display_val = Divide(CalcState.display_val, 100)
    }
}

Function.Calc_Backspace {
    Body: {
        CalcState.display_val = Divide(CalcState.display_val, 10)
    }
}

// =============================================================================
// EVALUATE — execute pending arithmetic operation
// =============================================================================
Function.Calc_Evaluate {
    Body: {
        a = CalcState.pending_val
        b = CalcState.display_val
        result = b

        IfCondition EqualTo(CalcState.pending_op, CalcOp.ADD) ThenBlock: {
            result = Add(a, b)
        }
        IfCondition EqualTo(CalcState.pending_op, CalcOp.SUB) ThenBlock: {
            result = Subtract(a, b)
        }
        IfCondition EqualTo(CalcState.pending_op, CalcOp.MUL) ThenBlock: {
            result = Multiply(a, b)
        }
        IfCondition EqualTo(CalcState.pending_op, CalcOp.DIV) ThenBlock: {
            IfCondition NotEqual(b, 0) ThenBlock: {
                result = Divide(a, b)
            } ElseBlock: {
                PrintMessage("[Calc] divide by zero\n")
                result = 0
            }
        }

        CalcState.display_val = result
        CalcState.pending_val = result
    }
}
