// Library.ChatLog.Rotate.ailang
// Session rotation for the NDJSON chat log.
// Split from Library.ChatLog to stay under 300 LOC.
//
// Copyright (c) 2025-2026 Sean Collins, 2 Paws Machine and Engineering. All rights reserved.
// Licensed under the Sean Collins Software License (SCSL v1.0).

LibraryImport.ChatLog

// Rotate current chat log to a timestamped file.
// Closes the append fd, renames chat_current.ndjson → chat_NNNN.ndjson.
// Call before ChatLog_Init on session start, and on /clear.
Function.ChatLog_Rotate {
    Body: {
        IfCondition GreaterEqual(ChatLog_State.fd, 0) ThenBlock: {
            SystemCall(ChatLog_Sys.SYS_CLOSE, ChatLog_State.fd, 0, 0, 0, 0)
            ChatLog_State.fd = -1
        }
        IfCondition EqualTo(ChatLog_State.path, 0) ThenBlock: { ReturnValue(0) }

        ts_buf = Allocate(16)
        SystemCall(ChatLog_Sys.SYS_CLOCK, 0, ts_buf, 0, 0, 0)
        ts0 = GetByte(ts_buf, 0) ts1 = GetByte(ts_buf, 1)
        ts2 = GetByte(ts_buf, 2) ts3 = GetByte(ts_buf, 3)
        ts_sec = Add(ts0, Add(Multiply(ts1, 256), Add(Multiply(ts2, 65536), Multiply(ts3, 16777216))))
        Deallocate(ts_buf, 16)

        home = ChatLog_GetHome()
        IfCondition EqualTo(home, 0) ThenBlock: { home = "/root" }
        halcode_dir = StringConcat(home, "/.halcode")

        new_name_buf = Allocate(ChatLog_Config.PATH_MAX)
        p = ChatLog_BufStr(new_name_buf, 0, halcode_dir)
        p = ChatLog_BufStr(new_name_buf, p, "/chat_")
        p = ChatLog_BufNum(new_name_buf, p, ts_sec)
        p = ChatLog_BufStr(new_name_buf, p, ".ndjson")
        SetByte(new_name_buf, p, 0)

        SystemCall(ChatLog_Sys.SYS_RENAME, ChatLog_State.path, new_name_buf, 0, 0, 0)
        Deallocate(new_name_buf, ChatLog_Config.PATH_MAX)
        ReturnValue(0)
    }
}
