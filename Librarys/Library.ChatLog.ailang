// Library.ChatLog.ailang — NDJSON append log for chat scroll back.
// {"r":"a","t":"text","ts":1234567890}  r: u=user a=assistant t=tool s=separator

LibraryImport.TUI
LibraryImport.TuiWidget

FixedPool.ChatLog_Config {
    "PATH_MAX":   Initialize=256
    "LINE_MAX":   Initialize=512
    "READ_BUF":   Initialize=4096
    "KEEP_FILES": Initialize=5
}

FixedPool.ChatLog_State {
    "fd":          Initialize=-1, CanChange=True
    "path":        Initialize=0,  CanChange=True
    "read_buf":    Initialize=0,  CanChange=True
    "line_buf":    Initialize=0,  CanChange=True
    "file_pos":    Initialize=0,  CanChange=True
    "at_bottom":   Initialize=1,  CanChange=True
}

FixedPool.ChatLog_Sys {
    "SYS_READ":     Initialize=0
    "SYS_WRITE":    Initialize=1
    "SYS_OPEN":     Initialize=2
    "SYS_CLOSE":    Initialize=3
    "SYS_LSEEK":    Initialize=8
    "SYS_RENAME":   Initialize=82
    "SYS_MKDIR":    Initialize=83
    "SYS_UNLINK":   Initialize=87
    "SYS_CLOCK":    Initialize=228
}

// Copy string s into buf at pos, return new pos.
Function.ChatLog_BufStr {
    Input: buf: Address
    Input: pos: Integer
    Input: s: Address
    Output: Integer
    Body: {
        i = 0
        WhileLoop 1 {
            ch = GetByte(s, i)
            IfCondition EqualTo(ch, 0) ThenBlock: { BreakLoop }
            SetByte(buf, Add(pos, i), ch)
            i = Add(i, 1)
        }
        ReturnValue(Add(pos, i))
    }
}

// Write integer n as decimal into buf at pos, return new pos.
Function.ChatLog_BufNum {
    Input: buf: Address
    Input: pos: Integer
    Input: n: Integer
    Output: Integer
    Body: {
        digits = Allocate(24)
        d_count = 0
        IfCondition EqualTo(n, 0) ThenBlock: {
            SetByte(digits, 0, 48)
            d_count = 1
        } ElseBlock: {
            WhileLoop GreaterThan(n, 0) {
                SetByte(digits, d_count, Add(48, Modulo(n, 10)))
                d_count = Add(d_count, 1)
                n = Divide(n, 10)
            }
        }
        i = Subtract(d_count, 1)
        WhileLoop GreaterEqual(i, 0) {
            SetByte(buf, pos, GetByte(digits, i))
            pos = Add(pos, 1)
            i = Subtract(i, 1)
        }
        Deallocate(digits, 24)
        ReturnValue(pos)
    }
}

// Return $HOME from /proc/self/environ, or 0 if not found.
Function.ChatLog_GetHome {
    Output: Address
    Body: {
        fd = SystemCall(ChatLog_Sys.SYS_OPEN, "/proc/self/environ", 0, 0, 0, 0)
        IfCondition LessThan(fd, 0) ThenBlock: { ReturnValue(0) }
        buf = Allocate(65536)
        n = SystemCall(ChatLog_Sys.SYS_READ, fd, buf, 65536, 0, 0)
        SystemCall(ChatLog_Sys.SYS_CLOSE, fd, 0, 0, 0, 0)
        i = 0
        WhileLoop LessThan(i, Subtract(n, 5)) {
            b0 = GetByte(buf, i)           b1 = GetByte(buf, Add(i,1))
            b2 = GetByte(buf, Add(i,2))    b3 = GetByte(buf, Add(i,3))
            b4 = GetByte(buf, Add(i,4))
            // H=72 O=79 M=77 E=69 ==61
            IfCondition And(And(EqualTo(b0,72),EqualTo(b1,79)),And(EqualTo(b2,77),And(EqualTo(b3,69),EqualTo(b4,61)))) ThenBlock: {
                start = Add(i, 5)
                end = start
                WhileLoop LessThan(end, n) {
                    IfCondition EqualTo(GetByte(buf, end), 0) ThenBlock: { BreakLoop }
                    end = Add(end, 1)
                }
                len = Subtract(end, start)
                result = Allocate(Add(len, 1))
                j = 0
                WhileLoop LessThan(j, len) {
                    SetByte(result, j, GetByte(buf, Add(start, j)))
                    j = Add(j, 1)
                }
                SetByte(result, len, 0)
                Deallocate(buf, 65536)
                ReturnValue(result)
            }
            i = Add(i, 1)
        }
        Deallocate(buf, 65536)
        ReturnValue(0)
    }
}

// Open ~/.halcode/chat_current.ndjson for append, seek to EOF for scroll anchor.
Function.ChatLog_Init {
    Body: {
        ChatLog_State.path     = Allocate(ChatLog_Config.PATH_MAX)
        ChatLog_State.read_buf = Allocate(ChatLog_Config.READ_BUF)
        ChatLog_State.line_buf = Allocate(ChatLog_Config.LINE_MAX)
        home = ChatLog_GetHome()
        IfCondition EqualTo(home, 0) ThenBlock: { home = "/root" }
        halcode_dir = StringConcat(home, "/.halcode")
        SystemCall(ChatLog_Sys.SYS_MKDIR, halcode_dir, 493, 0, 0, 0)
        full_path = StringConcat(halcode_dir, "/chat_current.ndjson")
        plen = StringLength(full_path)
        i = 0
        WhileLoop LessEqual(i, plen) {
            SetByte(ChatLog_State.path, i, GetByte(full_path, i))
            i = Add(i, 1)
        }
        // O_WRONLY=1 | O_CREAT=64 | O_APPEND=1024 = 1089, mode 0600=384
        ChatLog_State.fd = SystemCall(ChatLog_Sys.SYS_OPEN, ChatLog_State.path, 1089, 384, 0, 0)
        IfCondition GreaterEqual(ChatLog_State.fd, 0) ThenBlock: {
            sz = SystemCall(ChatLog_Sys.SYS_LSEEK, ChatLog_State.fd, 0, 2, 0, 0)
            ChatLog_State.file_pos = sz
        }
        ChatLog_State.at_bottom = 1
        ReturnValue(0)
    }
}

// Close the append fd.
Function.ChatLog_Shutdown {
    Body: {
        IfCondition GreaterEqual(ChatLog_State.fd, 0) ThenBlock: {
            SystemCall(ChatLog_Sys.SYS_CLOSE, ChatLog_State.fd, 0, 0, 0, 0)
            ChatLog_State.fd = -1
        }
        ReturnValue(0)
    }
}

Function.ChatLog_Append {
    Input: role: Integer
    Input: text: Address
    Body: {
        IfCondition LessThan(ChatLog_State.fd, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition EqualTo(text, 0) ThenBlock: { ReturnValue(0) }
        buf = ChatLog_State.line_buf
        pos = ChatLog_BufStr(buf, 0, "{\"r\":\"")
        SetByte(buf, pos, role) pos = Add(pos, 1)
        pos = ChatLog_BufStr(buf, pos, "\",\"t\":\"")
        i = 0
        WhileLoop 1 {
            ch = GetByte(text, i)
            IfCondition EqualTo(ch, 0) ThenBlock: { BreakLoop }
            IfCondition GreaterEqual(pos, Subtract(ChatLog_Config.LINE_MAX, 30)) ThenBlock: { BreakLoop }
            IfCondition EqualTo(ch, 92) ThenBlock: {
                SetByte(buf, pos, 92) pos = Add(pos, 1)
                SetByte(buf, pos, 92) pos = Add(pos, 1)
            } ElseBlock: {
                IfCondition EqualTo(ch, 34) ThenBlock: {
                    SetByte(buf, pos, 92) pos = Add(pos, 1)
                    SetByte(buf, pos, 34) pos = Add(pos, 1)
                } ElseBlock: {
                    IfCondition LessThan(ch, 32) ThenBlock: {
                        SetByte(buf, pos, 32) pos = Add(pos, 1)
                    } ElseBlock: {
                        SetByte(buf, pos, ch) pos = Add(pos, 1)
                    }
                }
            }
            i = Add(i, 1)
        }
        ts_buf = Allocate(16)
        SystemCall(ChatLog_Sys.SYS_CLOCK, 0, ts_buf, 0, 0, 0)
        t0=GetByte(ts_buf,0) t1=GetByte(ts_buf,1) t2=GetByte(ts_buf,2) t3=GetByte(ts_buf,3)
        ts_sec = Add(t0, Add(Multiply(t1,256), Add(Multiply(t2,65536), Multiply(t3,16777216))))
        Deallocate(ts_buf, 16)
        pos = ChatLog_BufStr(buf, pos, "\",\"ts\":")
        pos = ChatLog_BufNum(buf, pos, ts_sec)
        SetByte(buf, pos, 125) pos = Add(pos, 1)
        SetByte(buf, pos, 10)  pos = Add(pos, 1)
        SetByte(buf, pos, 0)
        SystemCall(ChatLog_Sys.SYS_WRITE, ChatLog_State.fd, buf, pos, 0, 0)
        ReturnValue(0)
    }
}

Function.ChatLog_RenderLine {
    Input: row: Integer
    Input: buf: Address
    Input: len: Integer
    Body: {
        role = 97   text_start = 0   text_len = 0
        i = 0
        WhileLoop LessThan(i, Subtract(len, 5)) {
            b0=GetByte(buf,i) b1=GetByte(buf,Add(i,1)) b2=GetByte(buf,Add(i,2))
            b3=GetByte(buf,Add(i,3)) b4=GetByte(buf,Add(i,4))
            // "r":" = 34,114,34,58,34
            IfCondition And(And(EqualTo(b0,34),EqualTo(b1,114)),And(EqualTo(b2,34),And(EqualTo(b3,58),EqualTo(b4,34)))) ThenBlock: {
                role = GetByte(buf, Add(i, 5))
            }
            // "t":" = 34,116,34,58,34
            IfCondition And(And(EqualTo(b0,34),EqualTo(b1,116)),And(EqualTo(b2,34),And(EqualTo(b3,58),EqualTo(b4,34)))) ThenBlock: {
                text_start = Add(i, 5)
                k = text_start
                WhileLoop LessThan(k, len) {
                    ck = GetByte(buf, k)
                    IfCondition EqualTo(ck, 92) ThenBlock: { k = Add(k, 2) } ElseBlock: {
                        IfCondition EqualTo(ck, 34) ThenBlock: { text_len = Subtract(k, text_start)  BreakLoop }
                        k = Add(k, 1)
                    }
                }
            }
            i = Add(i, 1)
        }
        IfCondition EqualTo(role, 117) ThenBlock: { TUI_SetFG(TUI_Colors.WHITE)  TUI_Bold() } ElseBlock: {
            IfCondition EqualTo(role, 116) ThenBlock: { TUI_SetFG(TUI_Colors.GREEN) } ElseBlock: {
                IfCondition EqualTo(role, 115) ThenBlock: { TUI_SetFG(TUI_Colors.BLACK)  TUI_Bold() } ElseBlock: { TUI_ResetAttr() }
            }
        }
        TUI_Draw_PrintClipped(row, UILayout.chat_x, Add(buf, text_start), UILayout.chat_w)
        TUI_ResetAttr()
        ReturnValue(0)
    }
}

Function.ChatLog_ReadBack {
    Input: n_lines: Integer
    Output: Integer
    Body: {
        rfd = SystemCall(ChatLog_Sys.SYS_OPEN, ChatLog_State.path, 0, 0, 0, 0)
        IfCondition LessThan(rfd, 0) ThenBlock: { ReturnValue(0) }
        offsets  = Allocate(Multiply(n_lines, 4))
        found    = 0
        scan_pos = ChatLog_State.file_pos
        WhileLoop And(GreaterThan(scan_pos, 0), LessThan(found, n_lines)) {
            chunk = ChatLog_Config.READ_BUF
            IfCondition LessThan(scan_pos, chunk) ThenBlock: { chunk = scan_pos }
            scan_pos = Subtract(scan_pos, chunk)
            SystemCall(ChatLog_Sys.SYS_LSEEK, rfd, scan_pos, 0, 0, 0)
            bytes = SystemCall(ChatLog_Sys.SYS_READ, rfd, ChatLog_State.read_buf, chunk, 0, 0)
            i = Subtract(bytes, 1)
            WhileLoop And(GreaterEqual(i, 0), LessThan(found, n_lines)) {
                IfCondition EqualTo(GetByte(ChatLog_State.read_buf, i), 10) ThenBlock: {
                    ls = Add(scan_pos, Add(i, 1))
                    oi = Multiply(found, 4)
                    SetByte(offsets, oi,            BitwiseAnd(ls, 255))
                    SetByte(offsets, Add(oi,1),     BitwiseAnd(RightShift(ls,8),255))
                    SetByte(offsets, Add(oi,2),     BitwiseAnd(RightShift(ls,16),255))
                    SetByte(offsets, Add(oi,3),     BitwiseAnd(RightShift(ls,24),255))
                    found = Add(found, 1)
                }
                i = Subtract(i, 1)
            }
        }
        // Clear chat area
        r = UILayout.chat_top
        WhileLoop LessEqual(r, UILayout.chat_bot) {
            TUI_MoveTo(r, UILayout.chat_x) TUI_BufferChar(27) TUI_BufferWriteStr("[K")
            r = Add(r, 1)
        }
        render_row = UILayout.chat_top
        j = Subtract(found, 1)
        WhileLoop And(GreaterEqual(j, 0), LessEqual(render_row, UILayout.chat_bot)) {
            oi = Multiply(j, 4)
            lo0=GetByte(offsets,oi) lo1=GetByte(offsets,Add(oi,1))
            lo2=GetByte(offsets,Add(oi,2)) lo3=GetByte(offsets,Add(oi,3))
            lo = Add(lo0, Add(Multiply(lo1,256), Add(Multiply(lo2,65536), Multiply(lo3,16777216))))
            SystemCall(ChatLog_Sys.SYS_LSEEK, rfd, lo, 0, 0, 0)
            bytes = SystemCall(ChatLog_Sys.SYS_READ, rfd, ChatLog_State.read_buf, ChatLog_Config.READ_BUF, 0, 0)
            ChatLog_RenderLine(render_row, ChatLog_State.read_buf, bytes)
            render_row = Add(render_row, 1)
            j = Subtract(j, 1)
        }
        SystemCall(ChatLog_Sys.SYS_CLOSE, rfd, 0, 0, 0, 0)
        Deallocate(offsets, Multiply(n_lines, 4))
        ReturnValue(found)
    }
}

// Rotate current log to timestamped name. Close append fd first.
Function.ChatLog_Rotate {
    Body: {
        IfCondition GreaterEqual(ChatLog_State.fd, 0) ThenBlock: {
            SystemCall(ChatLog_Sys.SYS_CLOSE, ChatLog_State.fd, 0, 0, 0, 0)
            ChatLog_State.fd = -1
        }
        IfCondition EqualTo(ChatLog_State.path, 0) ThenBlock: { ReturnValue(0) }
        ts_buf = Allocate(16)
        SystemCall(ChatLog_Sys.SYS_CLOCK, 0, ts_buf, 0, 0, 0)
        t0=GetByte(ts_buf,0) t1=GetByte(ts_buf,1) t2=GetByte(ts_buf,2) t3=GetByte(ts_buf,3)
        ts_sec = Add(t0, Add(Multiply(t1,256), Add(Multiply(t2,65536), Multiply(t3,16777216))))
        Deallocate(ts_buf, 16)
        home = ChatLog_GetHome()
        IfCondition EqualTo(home, 0) ThenBlock: { home = "/root" }
        halcode_dir = StringConcat(home, "/.halcode")
        new_name = Allocate(ChatLog_Config.PATH_MAX)
        p = ChatLog_BufStr(new_name, 0, halcode_dir)
        p = ChatLog_BufStr(new_name, p, "/chat_")
        p = ChatLog_BufNum(new_name, p, ts_sec)
        p = ChatLog_BufStr(new_name, p, ".ndjson")
        SetByte(new_name, p, 0)
        SystemCall(ChatLog_Sys.SYS_RENAME, ChatLog_State.path, new_name, 0, 0, 0)
        Deallocate(new_name, ChatLog_Config.PATH_MAX)
        ReturnValue(0)
    }
}
