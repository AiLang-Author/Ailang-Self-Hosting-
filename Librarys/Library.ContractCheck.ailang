// Library.ContractCheck.ailang
// Shared allow-list for file-scope constructs.
// Used by Sem_Analyze and Analyzer2. Callers walk the AST; this library
// only classifies a node type and a FileMap module name.
//
// Legal at file scope:
//   declarations, Debug blocks, and RunTask in the main module only.
// Assignments, prints, if/while, and bare calls compile onto _start
// with no stack frame and crash.
//
// Copyright (c) 2026 Sean Collins, 2 Paws Machine and Engineering. All rights reserved.
// Licensed under the Sean Collins Software License (SCSL).

LibraryImport.Compiler.Frontend.AST.CASTTypes


FixedPool.Contract {
    "MaxArity": Initialize=6
}


Function.Contract_IsTopLevelDecl {
    Input: node_type: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(node_type, AST.LIBRARY_IMPORT) ThenBlock: {
            ReturnValue(1)
        }
        IfCondition EqualTo(node_type, AST.ACRONYM_DEFS) ThenBlock: {
            ReturnValue(1)
        }
        IfCondition EqualTo(node_type, AST.MODULE) ThenBlock: {
            ReturnValue(1)
        }
        IfCondition EqualTo(node_type, AST.EXPORT) ThenBlock: {
            ReturnValue(1)
        }
        IfCondition EqualTo(node_type, AST.FUNCTION) ThenBlock: {
            ReturnValue(1)
        }
        IfCondition EqualTo(node_type, AST.SUBROUTINE) ThenBlock: {
            ReturnValue(1)
        }
        IfCondition EqualTo(node_type, AST.INLINE_FUNCTION) ThenBlock: {
            ReturnValue(1)
        }
        IfCondition EqualTo(node_type, AST.EXTERN_KFUNC) ThenBlock: {
            ReturnValue(1)
        }
        IfCondition EqualTo(node_type, AST.COMBINATOR) ThenBlock: {
            ReturnValue(1)
        }
        IfCondition EqualTo(node_type, AST.POOL) ThenBlock: {
            ReturnValue(1)
        }
        IfCondition EqualTo(node_type, AST.POOL_FIXED) ThenBlock: {
            ReturnValue(1)
        }
        IfCondition EqualTo(node_type, AST.POOL_DYNAMIC) ThenBlock: {
            ReturnValue(1)
        }
        IfCondition EqualTo(node_type, AST.POOL_TEMPORAL) ThenBlock: {
            ReturnValue(1)
        }
        IfCondition EqualTo(node_type, AST.POOL_NEURAL) ThenBlock: {
            ReturnValue(1)
        }
        IfCondition EqualTo(node_type, AST.POOL_KERNEL) ThenBlock: {
            ReturnValue(1)
        }
        IfCondition EqualTo(node_type, AST.POOL_ACTOR) ThenBlock: {
            ReturnValue(1)
        }
        IfCondition EqualTo(node_type, AST.POOL_SECURITY) ThenBlock: {
            ReturnValue(1)
        }
        IfCondition EqualTo(node_type, AST.POOL_CONSTRAINED) ThenBlock: {
            ReturnValue(1)
        }
        IfCondition EqualTo(node_type, AST.POOL_FILE) ThenBlock: {
            ReturnValue(1)
        }
        IfCondition EqualTo(node_type, AST.POOL_LINKAGE) ThenBlock: {
            ReturnValue(1)
        }
        IfCondition EqualTo(node_type, AST.LOOP_MAIN) ThenBlock: {
            ReturnValue(1)
        }
        IfCondition EqualTo(node_type, AST.LOOP_ACTOR) ThenBlock: {
            ReturnValue(1)
        }
        IfCondition EqualTo(node_type, AST.LOOP_START) ThenBlock: {
            ReturnValue(1)
        }
        IfCondition EqualTo(node_type, AST.LOOP_SHADOW) ThenBlock: {
            ReturnValue(1)
        }
        IfCondition EqualTo(node_type, AST.MACRO_BLOCK) ThenBlock: {
            ReturnValue(1)
        }
        IfCondition EqualTo(node_type, AST.MACRO_DEFINE) ThenBlock: {
            ReturnValue(1)
        }
        IfCondition EqualTo(node_type, AST.NODE_COMMENT) ThenBlock: {
            ReturnValue(1)
        }
        IfCondition EqualTo(node_type, AST.NODE_DOC_COMMENT) ThenBlock: {
            ReturnValue(1)
        }
        IfCondition EqualTo(node_type, AST.NODE_EMPTY) ThenBlock: {
            ReturnValue(1)
        }
        ReturnValue(0)
    }
}


Function.Contract_IsTopLevelEntry {
    Input: node_type: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(node_type, AST.RUN_TASK) ThenBlock: {
            ReturnValue(1)
        }
        ReturnValue(0)
    }
}


Function.Contract_IsTopLevelDebug {
    Input: node_type: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(node_type, AST.DEBUG_BLOCK) ThenBlock: {
            ReturnValue(1)
        }
        ReturnValue(0)
    }
}


// FileMap names "main" for the consumer file after Import_EmitAll.
// Analyzer fallback names the sole file with its .ailang path.
Function.Contract_IsMainModule {
    Input: file_name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(file_name, 0) ThenBlock: {
            ReturnValue(1)
        }
        cmp_main = StringCompare(file_name, "main")
        IfCondition EqualTo(cmp_main, 0) ThenBlock: {
            ReturnValue(1)
        }
        has_ext = Contract_NameHasAilangExt(file_name)
        IfCondition EqualTo(has_ext, 1) ThenBlock: {
            ReturnValue(1)
        }
        ReturnValue(0)
    }
}


Function.Contract_NameHasAilangExt {
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(name, 0) ThenBlock: {
            ReturnValue(0)
        }
        nlen = StringLength(name)
        IfCondition LessThan(nlen, 7) ThenBlock: {
            ReturnValue(0)
        }
        limit = Subtract(nlen, 7)
        i = 0
        WhileLoop LessEqual(i, limit) {
            c0 = GetByte(name, i)
            IfCondition EqualTo(c0, 46) ThenBlock: {
                i1 = Add(i, 1)
                i2 = Add(i, 2)
                i3 = Add(i, 3)
                i4 = Add(i, 4)
                i5 = Add(i, 5)
                i6 = Add(i, 6)
                c1 = GetByte(name, i1)
                c2 = GetByte(name, i2)
                c3 = GetByte(name, i3)
                c4 = GetByte(name, i4)
                c5 = GetByte(name, i5)
                c6 = GetByte(name, i6)
                IfCondition EqualTo(c1, 97) ThenBlock: {
                    IfCondition EqualTo(c2, 105) ThenBlock: {
                        IfCondition EqualTo(c3, 108) ThenBlock: {
                            IfCondition EqualTo(c4, 97) ThenBlock: {
                                IfCondition EqualTo(c5, 110) ThenBlock: {
                                    IfCondition EqualTo(c6, 103) ThenBlock: {
                                        ReturnValue(1)
                                    }
                                }
                            }
                        }
                    }
                }
            }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}


Function.Contract_IsTopLevelAllowed {
    Input: node_type: Integer
    Input: is_main: Integer
    Output: Integer
    Body: {
        is_decl = Contract_IsTopLevelDecl(node_type)
        IfCondition EqualTo(is_decl, 1) ThenBlock: {
            ReturnValue(1)
        }
        is_dbg = Contract_IsTopLevelDebug(node_type)
        IfCondition EqualTo(is_dbg, 1) ThenBlock: {
            ReturnValue(1)
        }
        is_entry = Contract_IsTopLevelEntry(node_type)
        IfCondition EqualTo(is_entry, 1) ThenBlock: {
            IfCondition EqualTo(is_main, 1) ThenBlock: {
                ReturnValue(1)
            }
            ReturnValue(0)
        }
        ReturnValue(0)
    }
}
