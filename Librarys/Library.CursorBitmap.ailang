//
// Library.CursorBitmap.ailang
// Built-in bitmap cursor shapes.
// Masks allocated once at CursorBitmap_Load, freed at CursorBitmap_Free.
// No per-frame allocation.
//
// Mask format: rows * ceil(w/8) bytes, MSB = leftmost pixel
// Black outline mask drawn first, white fill on top.

LibraryImport.Cursor

// =============================================================================
// SHAPE DIMENSIONS
// Each shape can have different w/h
// stride = ceil(w / 8)
// =============================================================================

// Arrow: 12x20, stride=2
FixedPool.ArrowDim  { "W": Initialize=12  "H": Initialize=20  "STRIDE": Initialize=2 }
// Beam:  3x18, stride=1
FixedPool.BeamDim   { "W": Initialize=3   "H": Initialize=18  "STRIDE": Initialize=1 }
// Crosshair: 15x15, stride=2
FixedPool.CrossDim  { "W": Initialize=15  "H": Initialize=15  "STRIDE": Initialize=2 }
// Hand: 14x20, stride=2
FixedPool.HandDim   { "W": Initialize=14  "H": Initialize=20  "STRIDE": Initialize=2 }

// =============================================================================
// LOAD — allocate and populate mask data for a shape
// Stores pointers into CursorState
// =============================================================================
Function.CursorBitmap_Load {
    Input:  shape: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(shape, CursorShape.ARROW)     ThenBlock: { ReturnValue(CursorBitmap_LoadArrow())     }
        IfCondition EqualTo(shape, CursorShape.BEAM)      ThenBlock: { ReturnValue(CursorBitmap_LoadBeam())      }
        IfCondition EqualTo(shape, CursorShape.CROSSHAIR) ThenBlock: { ReturnValue(CursorBitmap_LoadCrosshair()) }
        IfCondition EqualTo(shape, CursorShape.HAND)      ThenBlock: { ReturnValue(CursorBitmap_LoadHand())      }
        // Default to arrow
        ReturnValue(CursorBitmap_LoadArrow())
    }
}

// =============================================================================
// FREE — deallocate current mask data
// =============================================================================
Function.CursorBitmap_Free {
    Output: Integer
    Body: {
        mh     = CursorState.mask_h
        stride = CursorState.mask_stride
        size   = Multiply(mh, stride)

        black = CursorState.black_mask
        white = CursorState.white_mask

        IfCondition NotEqual(black, 0) ThenBlock: {
            Deallocate(black, size)
            CursorState.black_mask = 0
        }
        IfCondition NotEqual(white, 0) ThenBlock: {
            Deallocate(white, size)
            CursorState.white_mask = 0
        }
        ReturnValue(1)
    }
}

// =============================================================================
// INTERNAL: set CursorState dims and alloc mask buffers
// Returns size of each mask buffer
// =============================================================================
Function.CursorBitmap_AllocMasks {
    Input:  w:      Integer
    Input:  h:      Integer
    Input:  stride: Integer
    Output: Integer
    Body: {
        CursorState.mask_w      = w
        CursorState.mask_h      = h
        CursorState.mask_stride = stride
        size = Multiply(h, stride)
        CursorState.black_mask = Allocate(size)
        CursorState.white_mask = Allocate(size)
        i = 0
        WhileLoop LessThan(i, size) {
            SetByte(CursorState.black_mask, i, 0)
            SetByte(CursorState.white_mask, i, 0)
            i = Add(i, 1)
        }
        ReturnValue(size)
    }
}

// Helper: set one row in a mask (stride=2, 12-bit wide)
Function.CursorBitmap_SetRow2 {
    Input: mask: Address
    Input: row:  Integer
    Input: b0:   Integer
    Input: b1:   Integer
    Body: {
        base = Multiply(row, 2)
        SetByte(mask, base,           b0)
        SetByte(mask, Add(base, 1),   b1)
        ReturnValue(0)
    }
}

// Helper: set one row in a mask (stride=1, 8-bit wide)
Function.CursorBitmap_SetRow1 {
    Input: mask: Address
    Input: row:  Integer
    Input: b0:   Integer
    Body: {
        SetByte(mask, row, b0)
        ReturnValue(0)
    }
}

// =============================================================================
// ARROW — 12x20, hotspot (0,0)
// Classic top-left pointing arrow with black outline
// =============================================================================
Function.CursorBitmap_LoadArrow {
    Output: Integer
    Body: {
        CursorBitmap_AllocMasks(ArrowDim.W, ArrowDim.H, ArrowDim.STRIDE)
        w = CursorState.white_mask
        b = CursorState.black_mask

        // White fill — arrow body
        CursorBitmap_SetRow2(w, 0,  0x80, 0x00)
        CursorBitmap_SetRow2(w, 1,  0xC0, 0x00)
        CursorBitmap_SetRow2(w, 2,  0xE0, 0x00)
        CursorBitmap_SetRow2(w, 3,  0xF0, 0x00)
        CursorBitmap_SetRow2(w, 4,  0xF8, 0x00)
        CursorBitmap_SetRow2(w, 5,  0xFC, 0x00)
        CursorBitmap_SetRow2(w, 6,  0xFE, 0x00)
        CursorBitmap_SetRow2(w, 7,  0xFF, 0x00)
        CursorBitmap_SetRow2(w, 8,  0xFF, 0x80)
        CursorBitmap_SetRow2(w, 9,  0xFF, 0xC0)
        CursorBitmap_SetRow2(w, 10, 0xFC, 0x00)
        CursorBitmap_SetRow2(w, 11, 0xDC, 0x00)
        CursorBitmap_SetRow2(w, 12, 0x8E, 0x00)
        CursorBitmap_SetRow2(w, 13, 0x0E, 0x00)
        CursorBitmap_SetRow2(w, 14, 0x0E, 0x00)
        CursorBitmap_SetRow2(w, 15, 0x0E, 0x00)
        CursorBitmap_SetRow2(w, 16, 0x0E, 0x00)
        CursorBitmap_SetRow2(w, 17, 0x0E, 0x00)
        CursorBitmap_SetRow2(w, 18, 0x0E, 0x00)
        CursorBitmap_SetRow2(w, 19, 0x0E, 0x00)

        // Black outline — dilated by 1px
        CursorBitmap_SetRow2(b, 0,  0xC0, 0x00)
        CursorBitmap_SetRow2(b, 1,  0xE0, 0x00)
        CursorBitmap_SetRow2(b, 2,  0xF0, 0x00)
        CursorBitmap_SetRow2(b, 3,  0xF8, 0x00)
        CursorBitmap_SetRow2(b, 4,  0xFC, 0x00)
        CursorBitmap_SetRow2(b, 5,  0xFE, 0x00)
        CursorBitmap_SetRow2(b, 6,  0xFF, 0x00)
        CursorBitmap_SetRow2(b, 7,  0xFF, 0x80)
        CursorBitmap_SetRow2(b, 8,  0xFF, 0xC0)
        CursorBitmap_SetRow2(b, 9,  0xFF, 0xE0)
        CursorBitmap_SetRow2(b, 10, 0xFF, 0xE0)
        CursorBitmap_SetRow2(b, 11, 0xFF, 0x00)
        CursorBitmap_SetRow2(b, 12, 0xDF, 0x00)
        CursorBitmap_SetRow2(b, 13, 0x1F, 0x00)
        CursorBitmap_SetRow2(b, 14, 0x1F, 0x00)
        CursorBitmap_SetRow2(b, 15, 0x1F, 0x00)
        CursorBitmap_SetRow2(b, 16, 0x1F, 0x00)
        CursorBitmap_SetRow2(b, 17, 0x1F, 0x00)
        CursorBitmap_SetRow2(b, 18, 0x1F, 0x00)
        CursorBitmap_SetRow2(b, 19, 0x00, 0x00)

        CursorState.hotspot_x = 0
        CursorState.hotspot_y = 0
        ReturnValue(1)
    }
}

// =============================================================================
// BEAM — 3x18, hotspot (1,9) — vertical I-beam for text editing
// =============================================================================
Function.CursorBitmap_LoadBeam {
    Output: Integer
    Body: {
        CursorBitmap_AllocMasks(BeamDim.W, BeamDim.H, BeamDim.STRIDE)
        w = CursorState.white_mask
        b = CursorState.black_mask

        // White: top serif, stem, bottom serif
        CursorBitmap_SetRow1(w, 0,  0xE0)   // XXX top serif
        CursorBitmap_SetRow1(w, 1,  0x40)   // .X.
        CursorBitmap_SetRow1(w, 2,  0x40)
        CursorBitmap_SetRow1(w, 3,  0x40)
        CursorBitmap_SetRow1(w, 4,  0x40)
        CursorBitmap_SetRow1(w, 5,  0x40)
        CursorBitmap_SetRow1(w, 6,  0x40)
        CursorBitmap_SetRow1(w, 7,  0x40)
        CursorBitmap_SetRow1(w, 8,  0x40)
        CursorBitmap_SetRow1(w, 9,  0x40)
        CursorBitmap_SetRow1(w, 10, 0x40)
        CursorBitmap_SetRow1(w, 11, 0x40)
        CursorBitmap_SetRow1(w, 12, 0x40)
        CursorBitmap_SetRow1(w, 13, 0x40)
        CursorBitmap_SetRow1(w, 14, 0x40)
        CursorBitmap_SetRow1(w, 15, 0x40)
        CursorBitmap_SetRow1(w, 16, 0x40)
        CursorBitmap_SetRow1(w, 17, 0xE0)   // XXX bottom serif

        // Black outline
        CursorBitmap_SetRow1(b, 0,  0xE0)
        CursorBitmap_SetRow1(b, 1,  0xE0)
        CursorBitmap_SetRow1(b, 2,  0xE0)
        CursorBitmap_SetRow1(b, 3,  0xE0)
        CursorBitmap_SetRow1(b, 4,  0xE0)
        CursorBitmap_SetRow1(b, 5,  0xE0)
        CursorBitmap_SetRow1(b, 6,  0xE0)
        CursorBitmap_SetRow1(b, 7,  0xE0)
        CursorBitmap_SetRow1(b, 8,  0xE0)
        CursorBitmap_SetRow1(b, 9,  0xE0)
        CursorBitmap_SetRow1(b, 10, 0xE0)
        CursorBitmap_SetRow1(b, 11, 0xE0)
        CursorBitmap_SetRow1(b, 12, 0xE0)
        CursorBitmap_SetRow1(b, 13, 0xE0)
        CursorBitmap_SetRow1(b, 14, 0xE0)
        CursorBitmap_SetRow1(b, 15, 0xE0)
        CursorBitmap_SetRow1(b, 16, 0xE0)
        CursorBitmap_SetRow1(b, 17, 0xE0)

        CursorState.hotspot_x = 1
        CursorState.hotspot_y = 9
        ReturnValue(1)
    }
}

// =============================================================================
// CROSSHAIR — 15x15, hotspot (7,7) — center pixel
// =============================================================================
Function.CursorBitmap_LoadCrosshair {
    Output: Integer
    Body: {
        CursorBitmap_AllocMasks(CrossDim.W, CrossDim.H, CrossDim.STRIDE)
        w = CursorState.white_mask
        b = CursorState.black_mask

        // White: plus sign, gap at center
        CursorBitmap_SetRow2(w, 0,  0x01, 0x00)   // ......X.........
        CursorBitmap_SetRow2(w, 1,  0x01, 0x00)
        CursorBitmap_SetRow2(w, 2,  0x01, 0x00)
        CursorBitmap_SetRow2(w, 3,  0x01, 0x00)
        CursorBitmap_SetRow2(w, 4,  0x01, 0x00)
        CursorBitmap_SetRow2(w, 5,  0x01, 0x00)
        CursorBitmap_SetRow2(w, 6,  0x00, 0x00)   // gap
        CursorBitmap_SetRow2(w, 7,  0xFF, 0x7E)   // full horizontal, gap center
        CursorBitmap_SetRow2(w, 8,  0x00, 0x00)   // gap
        CursorBitmap_SetRow2(w, 9,  0x01, 0x00)
        CursorBitmap_SetRow2(w, 10, 0x01, 0x00)
        CursorBitmap_SetRow2(w, 11, 0x01, 0x00)
        CursorBitmap_SetRow2(w, 12, 0x01, 0x00)
        CursorBitmap_SetRow2(w, 13, 0x01, 0x00)
        CursorBitmap_SetRow2(w, 14, 0x01, 0x00)

        // Black outline — same but 1px wider
        CursorBitmap_SetRow2(b, 0,  0x03, 0x80)
        CursorBitmap_SetRow2(b, 1,  0x03, 0x80)
        CursorBitmap_SetRow2(b, 2,  0x03, 0x80)
        CursorBitmap_SetRow2(b, 3,  0x03, 0x80)
        CursorBitmap_SetRow2(b, 4,  0x03, 0x80)
        CursorBitmap_SetRow2(b, 5,  0xFF, 0xFE)
        CursorBitmap_SetRow2(b, 6,  0xFF, 0xFE)
        CursorBitmap_SetRow2(b, 7,  0xFF, 0xFE)
        CursorBitmap_SetRow2(b, 8,  0xFF, 0xFE)
        CursorBitmap_SetRow2(b, 9,  0xFF, 0xFE)
        CursorBitmap_SetRow2(b, 10, 0x03, 0x80)
        CursorBitmap_SetRow2(b, 11, 0x03, 0x80)
        CursorBitmap_SetRow2(b, 12, 0x03, 0x80)
        CursorBitmap_SetRow2(b, 13, 0x03, 0x80)
        CursorBitmap_SetRow2(b, 14, 0x03, 0x80)

        CursorState.hotspot_x = 7
        CursorState.hotspot_y = 7
        ReturnValue(1)
    }
}

// =============================================================================
// HAND — 14x20, hotspot (4,0) — pointing finger tip
// =============================================================================
Function.CursorBitmap_LoadHand {
    Output: Integer
    Body: {
        CursorBitmap_AllocMasks(HandDim.W, HandDim.H, HandDim.STRIDE)
        w = CursorState.white_mask
        b = CursorState.black_mask

        // White: pointing hand outline
        CursorBitmap_SetRow2(w, 0,  0x08, 0x00)   // ..X.............
        CursorBitmap_SetRow2(w, 1,  0x14, 0x00)   // .X.X............
        CursorBitmap_SetRow2(w, 2,  0x14, 0x00)
        CursorBitmap_SetRow2(w, 3,  0x14, 0x00)
        CursorBitmap_SetRow2(w, 4,  0x14, 0x00)
        CursorBitmap_SetRow2(w, 5,  0x1C, 0x00)   // ..XXX...........
        CursorBitmap_SetRow2(w, 6,  0x3E, 0x00)   // .XXXXX..........
        CursorBitmap_SetRow2(w, 7,  0x7F, 0x00)   // XXXXXXX.........
        CursorBitmap_SetRow2(w, 8,  0x7F, 0x00)
        CursorBitmap_SetRow2(w, 9,  0x7F, 0x80)
        CursorBitmap_SetRow2(w, 10, 0x7F, 0xC0)
        CursorBitmap_SetRow2(w, 11, 0x3F, 0xC0)
        CursorBitmap_SetRow2(w, 12, 0x1F, 0xC0)
        CursorBitmap_SetRow2(w, 13, 0x0F, 0xC0)
        CursorBitmap_SetRow2(w, 14, 0x07, 0xC0)
        CursorBitmap_SetRow2(w, 15, 0x03, 0xC0)
        CursorBitmap_SetRow2(w, 16, 0x01, 0xC0)
        CursorBitmap_SetRow2(w, 17, 0x00, 0xC0)
        CursorBitmap_SetRow2(w, 18, 0x00, 0x80)
        CursorBitmap_SetRow2(w, 19, 0x00, 0x00)

        // Black outline
        CursorBitmap_SetRow2(b, 0,  0x08, 0x00)
        CursorBitmap_SetRow2(b, 1,  0x1C, 0x00)
        CursorBitmap_SetRow2(b, 2,  0x1C, 0x00)
        CursorBitmap_SetRow2(b, 3,  0x1C, 0x00)
        CursorBitmap_SetRow2(b, 4,  0x1C, 0x00)
        CursorBitmap_SetRow2(b, 5,  0x3E, 0x00)
        CursorBitmap_SetRow2(b, 6,  0x7F, 0x00)
        CursorBitmap_SetRow2(b, 7,  0xFF, 0x80)
        CursorBitmap_SetRow2(b, 8,  0xFF, 0x80)
        CursorBitmap_SetRow2(b, 9,  0xFF, 0xC0)
        CursorBitmap_SetRow2(b, 10, 0xFF, 0xE0)
        CursorBitmap_SetRow2(b, 11, 0x7F, 0xE0)
        CursorBitmap_SetRow2(b, 12, 0x3F, 0xE0)
        CursorBitmap_SetRow2(b, 13, 0x1F, 0xE0)
        CursorBitmap_SetRow2(b, 14, 0x0F, 0xE0)
        CursorBitmap_SetRow2(b, 15, 0x07, 0xE0)
        CursorBitmap_SetRow2(b, 16, 0x03, 0xE0)
        CursorBitmap_SetRow2(b, 17, 0x01, 0xE0)
        CursorBitmap_SetRow2(b, 18, 0x00, 0xC0)
        CursorBitmap_SetRow2(b, 19, 0x00, 0x00)

        CursorState.hotspot_x = 4
        CursorState.hotspot_y = 0
        ReturnValue(1)
    }
}