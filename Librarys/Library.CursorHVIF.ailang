//
// Library.CursorHVIF.ailang
// HVIF (Haiku Vector Icon Format) cursor loader — STUB
//
// STATUS: Architecture defined, implementation pending.
//
// HVIF is Haiku's native vector icon format used for cursors and icons.
// Files are compact binary with bezier paths, gradients, and transforms.
//
// Reference: src/libs/icon/flat_icon/ in Haiku source tree
//
// When implemented this will:
//   1. Read .hvif file via SystemCall read
//   2. Parse path/style/transform data
//   3. Rasterize to a pixel mask at the requested size
//   4. Store black/white masks in CursorState same as CursorBitmap
//
// The rasterizer will reuse Library.FontTTF bezier infrastructure
// once that is implemented.

LibraryImport.Display.Input.Cursor

Function.CursorHVIF_Load {
    Input:  path:  Address
    Input:  shape: Integer
    Input:  size:  Integer
    Output: Integer
    Body: {
        PrintMessage("[CursorHVIF] Not yet implemented\n")
        PrintMessage("[CursorHVIF] Falling back to bitmap cursor\n")
        ReturnValue(0)
    }
}

Function.CursorHVIF_Free {
    Output: Integer
    Body: {
        ReturnValue(0)
    }
}