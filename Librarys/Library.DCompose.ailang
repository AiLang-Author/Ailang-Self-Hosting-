//
// Library.DCompose.ailang
// Compositor tick loop — connects Ring2 → dirty → BSP → blit
// Phase 7b: Ring0 window handlers + WinTable + WinColors

LibraryImport.DSurfaceTypes
LibraryImport.DSurface
LibraryImport.DDrawPixel
LibraryImport.Framebuffer
LibraryImport.DRenderFB
LibraryImport.DRingTypes
LibraryImport.DRing
LibraryImport.DRing0
LibraryImport.DRing1
LibraryImport.DRing2
LibraryImport.DRing3
LibraryImport.DComposeTypes
LibraryImport.DComposeBSP
LibraryImport.DComposeStack
LibraryImport.DComposeFloat
LibraryImport.Font
LibraryImport.FontBitmap

// =============================================================================
// COMPOSITOR INIT
// =============================================================================
Function.Compose_Init {
    Input:  screen_w: Integer
    Input:  screen_h: Integer
    Output: Integer
    Body: {
        root = BSP_Init(screen_w, screen_h)
        IfCondition EqualTo(root, 0) ThenBlock: {
            PrintMessage("[Compose] ERROR: BSP_Init failed\n")
            ReturnValue(0)
        }

        Float_Init()
        Ring0_Init()
        Ring1_Init()
        Ring2_Init()
        Ring3_Init()
        WinTable_Init()

        Compositor.focused_leaf  = root
        Compositor.focus_mode    = FocusMode.CLICK_TO_FOCUS
        Compositor.stack_pending = 0

        PrintMessage("[Compose] initialized ")
        PrintNumber(screen_w)
        PrintMessage("x")
        PrintNumber(screen_h)
        PrintMessage("\n")
        ReturnValue(1)
    }
}

Function.Compose_Shutdown {
    Output: Integer
    Body: {
        Ring0_Shutdown()
        Ring1_Shutdown()
        Ring2_Shutdown()
        Ring3_Shutdown()
        Float_Shutdown()
        IfCondition NotEqual(Compositor.root, 0) ThenBlock: {
            BSP_Free(Compositor.root)
            Compositor.root = 0
        }
        Compositor.initialized = 0
        ReturnValue(1)
    }
}

// =============================================================================
// Compose_InitFB
// =============================================================================
Function.Compose_InitFB {
    Input: offset_x: Integer
    Input: offset_y: Integer
    Output: Integer
    Body: {
        ComposeOutput.mode        = 2
        ComposeOutput.fb_offset_x = offset_x
        ComposeOutput.fb_offset_y = offset_y
        PrintMessage("[Compose] FB blit mode enabled\n")
        ReturnValue(1)
    }
}


// =============================================================================
// WIN TABLE
// =============================================================================
FixedPool.WinTable {
    "entries": Initialize=0
    "count":   Initialize=0
}

FixedPool.WinTableConst {
    "MAX":        Initialize=16
    "ENTRY_SIZE": Initialize=24
    "LEAF_OFS":   Initialize=0
    "SURF_OFS":   Initialize=8
    "COLOR_OFS":  Initialize=16
}

Function.WinTable_Init {
    Output: Integer
    Body: {
        WinTable.entries = Allocate(384)   // 16 * 24 bytes
        WinTable.count   = 0
        i = 0
        WhileLoop LessThan(i, 256) {
            SetByte(WinTable.entries, i, 0)
            i = Add(i, 1)
        }
        PrintMessage("[WinTable] initialized\n")
        ReturnValue(1)
    }
}

Function.WinTable_Add {
    Input:  leaf:    Integer
    Input:  surface: Integer
    Input:  color:   Integer
    Output: Integer
    Body: {
        cnt = WinTable.count
        IfCondition GreaterEqual(cnt, WinTableConst.MAX) ThenBlock: {
            PrintMessage("[WinTable] ERROR: table full\n")
            ReturnValue(0)
        }
        base = Add(WinTable.entries, Multiply(cnt, WinTableConst.ENTRY_SIZE))
        StoreValue(Add(base, WinTableConst.LEAF_OFS),  leaf)
        StoreValue(Add(base, WinTableConst.SURF_OFS),  surface)
        StoreValue(Add(base, WinTableConst.COLOR_OFS), color)
        WinTable.count = Add(cnt, 1)
        ReturnValue(1)
    }
}

Function.WinTable_GetSurface {
    Input:  leaf: Integer
    Output: Integer
    Body: {
        cnt    = WinTable.count
        i      = 0
        result = 0
        WhileLoop LessThan(i, cnt) {
            base       = Add(WinTable.entries, Multiply(i, WinTableConst.ENTRY_SIZE))
            entry_leaf = Dereference(Add(base, WinTableConst.LEAF_OFS))
            IfCondition EqualTo(entry_leaf, leaf) ThenBlock: {
                result = Dereference(Add(base, WinTableConst.SURF_OFS))
                i = cnt
            } ElseBlock: {
                i = Add(i, 1)
            }
        }
        ReturnValue(result)
    }
}


Function.WinCreate_ForLeaf {
    Input:  leaf: Integer
    Output: Integer
    Body: {
        w = BSP_GetRegionW(leaf)
        h = BSP_GetRegionH(leaf)
        IfCondition EqualTo(w, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(h, 0) ThenBlock: { ReturnValue(0) }

        surf = Surface_Create(SurfaceFormat.PIXEL_32, w, h)
        IfCondition EqualTo(surf, 0) ThenBlock: {
            PrintMessage("[WinCreate] ERROR: Surface_Create failed\n")
            ReturnValue(0)
        }

        // Neutral clear only — caller decorates
        Draw_Pix_FillRect(surf, 0, 0, w, h, 0x000000)

        WinTable_Add(leaf, surf, 0)

        PrintMessage("[WinCreate] leaf=")
        PrintNumber(leaf)
        PrintMessage(" ")
        PrintNumber(w)
        PrintMessage("x")
        PrintNumber(h)
        PrintMessage("\n")

        ReturnValue(surf)
    }
}

Function.WinTable_SetColor {
    Input:  leaf:  Integer
    Input:  color: Integer
    Output: Integer
    Body: {
        cnt = WinTable.count
        i   = 0
        WhileLoop LessThan(i, cnt) {
            base       = Add(WinTable.entries, Multiply(i, WinTableConst.ENTRY_SIZE))
            entry_leaf = Dereference(Add(base, WinTableConst.LEAF_OFS))
            IfCondition EqualTo(entry_leaf, leaf) ThenBlock: {
                StoreValue(Add(base, WinTableConst.COLOR_OFS), color)
                ReturnValue(1)
            }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

Function.WinTable_Remove {
    Input:  leaf: Integer
    Output: Integer
    Body: {
        cnt   = WinTable.count
        found = 0
        i     = 0
        WhileLoop LessThan(i, cnt) {
            base       = Add(WinTable.entries, Multiply(i, WinTableConst.ENTRY_SIZE))
            entry_leaf = Dereference(Add(base, WinTableConst.LEAF_OFS))
            IfCondition EqualTo(entry_leaf, leaf) ThenBlock: {
                found = 1
                // Shift all entries above i down by one slot,
                // copying ALL three fields: LEAF, SURF, COLOR
                j = Add(i, 1)
                WhileLoop LessThan(j, cnt) {
                    src = Add(WinTable.entries, Multiply(j,            WinTableConst.ENTRY_SIZE))
                    dst = Add(WinTable.entries, Multiply(Subtract(j,1), WinTableConst.ENTRY_SIZE))
                    lv  = Dereference(Add(src, WinTableConst.LEAF_OFS))
                    sv  = Dereference(Add(src, WinTableConst.SURF_OFS))
                    cv  = Dereference(Add(src, WinTableConst.COLOR_OFS))
                    StoreValue(Add(dst, WinTableConst.LEAF_OFS),  lv)
                    StoreValue(Add(dst, WinTableConst.SURF_OFS),  sv)
                    StoreValue(Add(dst, WinTableConst.COLOR_OFS), cv)
                    j = Add(j, 1)
                }
                // Zero out the vacated last slot to avoid stale reads
                last_base = Add(WinTable.entries, Multiply(Subtract(cnt,1), WinTableConst.ENTRY_SIZE))
                StoreValue(Add(last_base, WinTableConst.LEAF_OFS),  0)
                StoreValue(Add(last_base, WinTableConst.SURF_OFS),  0)
                StoreValue(Add(last_base, WinTableConst.COLOR_OFS), 0)
                WinTable.count = Subtract(cnt, 1)
                i = cnt  // break
            } ElseBlock: {
                i = Add(i, 1)
            }
        }
        ReturnValue(found)
    }
}

Function.WinTable_MarkAllDirty {
    Output: Integer
    Body: {
        cnt = WinTable.count
        i   = 0
        WhileLoop LessThan(i, cnt) {
            base = Add(WinTable.entries, Multiply(i, WinTableConst.ENTRY_SIZE))
            surf = Dereference(Add(base, WinTableConst.SURF_OFS))
            IfCondition NotEqual(surf, 0) ThenBlock: {
                w = Surface_GetWidth(surf)
                h = Surface_GetHeight(surf)
                Ring3_MarkDirty(surf, 0, 0, w, h)
            }
            i = Add(i, 1)
        }
        ReturnValue(1)
    }
}



// =============================================================================
// WIN CREATE FOR LEAF
// =============================================================================
Function.WinCreate_ForLeaf {
    Input:  leaf: Integer
    Output: Integer
    Body: {
        w = BSP_GetRegionW(leaf)
        h = BSP_GetRegionH(leaf)
        IfCondition EqualTo(w, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(h, 0) ThenBlock: { ReturnValue(0) }

        surf = Surface_Create(SurfaceFormat.PIXEL_32, w, h)
        IfCondition EqualTo(surf, 0) ThenBlock: {
            PrintMessage("[WinCreate] ERROR: Surface_Create failed\n")
            ReturnValue(0)
        }

        // Neutral clear only — decorator layer owns color and borders
        Draw_Pix_FillRect(surf, 0, 0, w, h, 0x000000)

        WinTable_Add(leaf, surf, 0)

        PrintMessage("[WinCreate] leaf=")
        PrintNumber(leaf)
        PrintMessage(" ")
        PrintNumber(w)
        PrintMessage("x")
        PrintNumber(h)
        PrintMessage("\n")

        ReturnValue(surf)
    }
}

// =============================================================================
// TICK PHASE 1 — Ring 0 helpers (one focused action per Function)
// Each handler is a separate Function to keep local count low.
// =============================================================================

Function.Compose_Ring0_FocusSet {
    Input: pa: Integer
    Output: Integer
    Body: {
        Compositor.focused_leaf = pa
        ReturnValue(1)
    }
}

Function.Compose_Ring0_Quit {
    Output: Integer
    Body: {
        Compositor.initialized = 0
        ReturnValue(1)
    }
}

Function.Compose_Ring0_FocusMode {
    Input: pa: Integer
    Output: Integer
    Body: {
        Compositor.focus_mode = pa
        ReturnValue(1)
    }
}

Function.Compose_Ring0_WinCreate {
    Input: pa: Integer
    Input: pb: Integer
    Output: Integer
    Body: {
        focused = Compositor.focused_leaf
        IfCondition EqualTo(focused, 0) ThenBlock: { ReturnValue(0) }
        split_type = pa
        split_pos  = pb
        IfCondition EqualTo(split_pos, 0) ThenBlock: {
            IfCondition EqualTo(split_type, BSPNodeType.SPLIT_V) ThenBlock: {
                split_pos = Divide(BSP_GetRegionW(focused), 2)
            } ElseBlock: {
                split_pos = Divide(BSP_GetRegionH(focused), 2)
            }
        }
        old_surf = WinTable_GetSurface(focused)
        IfCondition NotEqual(old_surf, 0) ThenBlock: {
            Surface_Destroy(old_surf)
            WinTable_Remove(focused)
        }
        new_leaf = BSP_Split(focused, split_type, split_pos)
        IfCondition NotEqual(new_leaf, 0) ThenBlock: {
            child_a = BSP_GetChildA(focused)
            child_b = BSP_GetChildB(focused)
            WinCreate_ForLeaf(child_a)
            WinCreate_ForLeaf(child_b)
            Compositor.focused_leaf = child_a
            WinTable_MarkAllDirty()
        }
        ReturnValue(1)
    }
}

Function.Compose_Ring0_WinDestroy {
    Input: pa: Integer
    Output: Integer
    Body: {
        target = pa
        IfCondition EqualTo(target, 0) ThenBlock: {
            target = Compositor.focused_leaf
        }
        IfCondition EqualTo(target, 0) ThenBlock: {
            ReturnValue(0)
        }
        surf = WinTable_GetSurface(target)
        IfCondition NotEqual(surf, 0) ThenBlock: {
            Surface_Destroy(surf)
            WinTable_Remove(target)
        }
        parent = BSP_GetParent(target)
        IfCondition NotEqual(parent, 0) ThenBlock: {
            BSP_Merge(parent)
            Compositor.focused_leaf = parent
            WinTable_MarkAllDirty()
        }
        ReturnValue(1)
    }
}

Function.Compose_Ring0_SplitV {
    Input: pa: Integer
    Output: Integer
    Body: {
        focused = Compositor.focused_leaf
        IfCondition EqualTo(focused, 0) ThenBlock: { ReturnValue(0) }
        split_pos = pa
        IfCondition EqualTo(split_pos, 0) ThenBlock: {
            split_pos = Divide(BSP_GetRegionW(focused), 2)
        }
        old_surf = WinTable_GetSurface(focused)
        IfCondition NotEqual(old_surf, 0) ThenBlock: {
            Surface_Destroy(old_surf)
            WinTable_Remove(focused)
        }
        new_leaf = BSP_Split(focused, BSPNodeType.SPLIT_V, split_pos)
        IfCondition NotEqual(new_leaf, 0) ThenBlock: {
            child_a = BSP_GetChildA(focused)
            child_b = BSP_GetChildB(focused)
            WinCreate_ForLeaf(child_a)
            WinCreate_ForLeaf(child_b)
            Compositor.focused_leaf = child_a
            WinTable_MarkAllDirty()
        }
        ReturnValue(1)
    }
}

Function.Compose_Ring0_SplitH {
    Input: pa: Integer
    Output: Integer
    Body: {
        focused = Compositor.focused_leaf
        IfCondition EqualTo(focused, 0) ThenBlock: { ReturnValue(0) }
        split_pos = pa
        IfCondition EqualTo(split_pos, 0) ThenBlock: {
            split_pos = Divide(BSP_GetRegionH(focused), 2)
        }
        old_surf = WinTable_GetSurface(focused)
        IfCondition NotEqual(old_surf, 0) ThenBlock: {
            Surface_Destroy(old_surf)
            WinTable_Remove(focused)
        }
        new_leaf = BSP_Split(focused, BSPNodeType.SPLIT_H, split_pos)
        IfCondition NotEqual(new_leaf, 0) ThenBlock: {
            child_a = BSP_GetChildA(focused)
            child_b = BSP_GetChildB(focused)
            WinCreate_ForLeaf(child_a)
            WinCreate_ForLeaf(child_b)
            Compositor.focused_leaf = child_a
            WinTable_MarkAllDirty()
        }
        ReturnValue(1)
    }
}

Function.Compose_Ring0_Merge {
    Output: Integer
    Body: {
        focused = Compositor.focused_leaf
        IfCondition EqualTo(focused, 0) ThenBlock: {
            ReturnValue(0)
        }
        parent = BSP_GetParent(focused)
        IfCondition EqualTo(parent, 0) ThenBlock: {
            ReturnValue(0)
        }
        ca = BSP_GetChildA(parent)
        cb = BSP_GetChildB(parent)
        sa = WinTable_GetSurface(ca)
        sb = WinTable_GetSurface(cb)
        IfCondition NotEqual(sa, 0) ThenBlock: {
            Surface_Destroy(sa)
            WinTable_Remove(ca)
        }
        IfCondition NotEqual(sb, 0) ThenBlock: {
            Surface_Destroy(sb)
            WinTable_Remove(cb)
        }
        BSP_Merge(parent)
        WinCreate_ForLeaf(parent)
        Compositor.focused_leaf = parent
        WinTable_MarkAllDirty()
        ReturnValue(1)
    }
}

// =============================================================================
// TICK PHASE 1 — Drain Ring 0
// Kept thin: reads entry fields, dispatches to per-command Functions above.
// =============================================================================
Function.Compose_TickRing0 {
    Output: Integer
    Body: {
        entry = Allocate(RingEntry.SIZE)
        WhileLoop EqualTo(Ring0_IsEmpty(), 0) {
            Ring0_Drain(entry)
            cmd = Dereference(Add(entry, RingEntry.TYPE))
            pa  = Dereference(Add(entry, RingEntry.PARAM_A))
            pb  = Dereference(Add(entry, RingEntry.PARAM_B))

            IfCondition EqualTo(cmd, Ring0Cmd.FOCUS_SET)    ThenBlock: { Compose_Ring0_FocusSet(pa) }
            IfCondition EqualTo(cmd, Ring0Cmd.QUIT)         ThenBlock: { Compose_Ring0_Quit() }
            IfCondition EqualTo(cmd, Ring0Cmd.FOCUS_MODE)   ThenBlock: { Compose_Ring0_FocusMode(pa) }
            IfCondition EqualTo(cmd, Ring0Cmd.WIN_CREATE)   ThenBlock: { Compose_Ring0_WinCreate(pa, pb) }
            IfCondition EqualTo(cmd, Ring0Cmd.WIN_DESTROY)  ThenBlock: { Compose_Ring0_WinDestroy(pa) }
            IfCondition EqualTo(cmd, Ring0Cmd.TILE_SPLIT_H) ThenBlock: { Compose_Ring0_SplitH(pa) }
            IfCondition EqualTo(cmd, Ring0Cmd.TILE_SPLIT_V) ThenBlock: { Compose_Ring0_SplitV(pa) }
            IfCondition EqualTo(cmd, Ring0Cmd.TILE_MERGE)   ThenBlock: { Compose_Ring0_Merge() }
        }
        Deallocate(entry, RingEntry.SIZE)
        ReturnValue(1)
    }
}

// =============================================================================
// TICK PHASE 3 — Drain Ring 2 (draw commands → mark dirty)
// =============================================================================
Function.Compose_TickRing2 {
    Output: Integer
    Body: {
        entry = Allocate(RingEntry.SIZE)
        WhileLoop EqualTo(Ring2_IsEmpty(), 0) {
            Ring2_Drain(entry)
            surface = Dereference(Add(entry, RingEntry.PARAM_A))
            IfCondition NotEqual(surface, 0) ThenBlock: {
                w = Surface_GetWidth(surface)
                h = Surface_GetHeight(surface)
                Ring3_MarkDirty(surface, 0, 0, w, h)
            }
        }
        Deallocate(entry, RingEntry.SIZE)
        ReturnValue(1)
    }
}

// =============================================================================
// DIRTY ENTRY READ — isolate per-slot reads into clean Functions
// =============================================================================
Function.Compose_BlitDirtySlot {
    Input: slot: Integer
    Output: Integer
    Body: {
        surf = 0
        dx   = 0
        dy   = 0
        dw   = 0
        dh   = 0

        IfCondition EqualTo(slot, 0) ThenBlock: {
            surf = DirtyState.surf0
            dx   = DirtyState.x0
            dy   = DirtyState.y0
            dw   = DirtyState.w0
            dh   = DirtyState.h0
        }
        IfCondition EqualTo(slot, 1) ThenBlock: {
            surf = DirtyState.surf1
            dx   = DirtyState.x1
            dy   = DirtyState.y1
            dw   = DirtyState.w1
            dh   = DirtyState.h1
        }
        IfCondition EqualTo(slot, 2) ThenBlock: {
            surf = DirtyState.surf2
            dx   = DirtyState.x2
            dy   = DirtyState.y2
            dw   = DirtyState.w2
            dh   = DirtyState.h2
        }
        IfCondition EqualTo(slot, 3) ThenBlock: {
            surf = DirtyState.surf3
            dx   = DirtyState.x3
            dy   = DirtyState.y3
            dw   = DirtyState.w3
            dh   = DirtyState.h3
        }

        IfCondition NotEqual(surf, 0) ThenBlock: {
            Compose_Blit(surf, dx, dy, dw, dh)
        }
        ReturnValue(1)
    }
}

// =============================================================================
// TICK PHASE 4 — Process Ring 3 (dirty regions → blit to output)
// =============================================================================
Function.Compose_TickRing3 {
    Output: Integer
    Body: {
        IfCondition EqualTo(Ring3_IsDirty(), 0) ThenBlock: {
            ReturnValue(0)
        }
        count = Ring3_GetCount()
        i = 0
        WhileLoop LessThan(i, count) {
            Compose_BlitDirtySlot(i)
            i = Add(i, 1)
        }
        Ring3_Clear()
        ReturnValue(1)
    }
}

// =============================================================================
// COMPOSE BLIT — copy surface region to output
// =============================================================================
FixedPool.ComposeOutput {
    "mode":        Initialize=0
    "fb_offset_x": Initialize=0
    "fb_offset_y": Initialize=0
}

Function.Compose_Blit {
    Input: surf: Integer
    Input: x:    Integer
    Input: y:    Integer
    Input: w:    Integer
    Input: h:    Integer
    Output: Integer
    Body: {
        mode = ComposeOutput.mode
        IfCondition EqualTo(mode, 0) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition EqualTo(mode, 2) ThenBlock: {
            format = Surface_GetFormat(surf)
            IfCondition NotEqual(format, SurfaceFormat.PIXEL_32) ThenBlock: {
                ReturnValue(0)
            }
            ox = ComposeOutput.fb_offset_x
            oy = ComposeOutput.fb_offset_y
            RenderFB_FlushRect(surf, Add(x, ox), Add(y, oy), w, h)
            ReturnValue(1)
        }
        ReturnValue(0)
    }
}

// =============================================================================
// FULL TICK — call once per frame
// =============================================================================
Function.Compose_Tick {
    Output: Integer
    Body: {
        Compose_TickRing0()
        Compose_TickRing2()
        Compose_TickRing3()
        ReturnValue(1)
    }
}