//
// Library.DCompose.ailang
// Compositor tick loop — connects Ring2 → dirty → BSP → blit
// Phase 7b: Ring0 window handlers + WinTable + WinColors
//
// Tick order (every frame):
//   1. Drain Ring 0 (focus/control/BSP changes)
//   2. Drain Ring 1 (input — not yet wired, placeholder)
//   3. Process Ring 2 (draw commands → mark dirty)
//   4. Process Ring 3 (dirty regions → BSP query → blit)

LibraryImport.DSurfaceTypes
LibraryImport.DSurface
LibraryImport.DDrawPixel
LibraryImport.Framebuffer
LibraryImport.DRenderFB
LibraryImport.DRingTypes
LibraryImport.DRing
LibraryImport.DRing0
LibraryImport.DRing1
LibraryImport.DRing2
LibraryImport.DRing3
LibraryImport.DComposeTypes
LibraryImport.DComposeBSP
LibraryImport.DComposeStack
LibraryImport.DComposeFloat

// =============================================================================
// COMPOSITOR INIT
// =============================================================================
Function.Compose_Init {
    Input:  screen_w: Integer
    Input:  screen_h: Integer
    Output: Integer
    Body: {
        root = BSP_Init(screen_w, screen_h)
        IfCondition EqualTo(root, 0) ThenBlock: {
            PrintMessage("[Compose] ERROR: BSP_Init failed\n")
            ReturnValue(0)
        }

        Float_Init()
        Ring0_Init()
        Ring1_Init()
        Ring2_Init()
        Ring3_Init()
        WinTable_Init()

        Compositor.focused_leaf  = root
        Compositor.focus_mode    = Add(FocusMode.CLICK_TO_FOCUS, 65536)
        Compositor.stack_pending = Add(0, 65536)

        PrintMessage("[Compose] initialized ")
        PrintNumber(screen_w)
        PrintMessage("x")
        PrintNumber(screen_h)
        PrintMessage("\n")
        ReturnValue(1)
    }
}

SubRoutine.Compose_Shutdown {
    Ring0_Shutdown()
    Ring1_Shutdown()
    Ring2_Shutdown()
    Ring3_Shutdown()
    Float_Shutdown()
    IfCondition NotEqual(Compositor.root, 0) ThenBlock: {
        BSP_Free(Compositor.root)
        Compositor.root = 0
    }
    Compositor.initialized = Add(0, 65536)
}

// =============================================================================
// Compose_InitFB
// Call after RenderFB_Init (or RenderFB_InitDouble) to enable FB blit path.
// =============================================================================
Function.Compose_InitFB {
    Input: offset_x: Integer
    Input: offset_y: Integer
    Output: Integer
    Body: {
        ComposeOutput.mode        = Add(2, 65536)
        ComposeOutput.fb_offset_x = Add(offset_x, 65536)
        ComposeOutput.fb_offset_y = Add(offset_y, 65536)
        PrintMessage("[Compose] FB blit mode enabled\n")
        ReturnValue(1)
    }
}

// =============================================================================
// WIN TABLE — maps BSP leaf → surface handle
// 16 entries max. Each entry: [leaf_ptr(8), surface_ptr(8)] = 16 bytes
// Total = 256 bytes allocated once on init.
// =============================================================================
FixedPool.WinTable {
    "entries": Initialize=0
    "count":   Initialize=0
}

FixedPool.WinTableConst {
    "MAX":        Initialize=16
    "ENTRY_SIZE": Initialize=16
    "LEAF_OFS":   Initialize=0
    "SURF_OFS":   Initialize=8
}

SubRoutine.WinTable_Init {
    WinTable.entries = Allocate(256)
    WinTable.count   = 0
    i = 0
    WhileLoop LessThan(i, 256) {
        SetByte(WinTable.entries, i, 0)
        i = Add(i, 1)
    }
    PrintMessage("[WinTable] initialized\n")
}

Function.WinTable_Add {
    Input:  leaf:    Integer
    Input:  surface: Integer
    Output: Integer
    Body: {
        cnt = WinTable.count
        IfCondition GreaterEqual(cnt, WinTableConst.MAX) ThenBlock: {
            PrintMessage("[WinTable] ERROR: table full\n")
            ReturnValue(0)
        }
        base = Add(WinTable.entries, Multiply(cnt, WinTableConst.ENTRY_SIZE))
        StoreValue(Add(base, WinTableConst.LEAF_OFS), leaf)
        StoreValue(Add(base, WinTableConst.SURF_OFS), surface)
        WinTable.count = Add(cnt, 1)
        ReturnValue(1)
    }
}

Function.WinTable_GetSurface {
    Input:  leaf: Integer
    Output: Integer
    Body: {
        cnt    = WinTable.count
        i      = 0
        result = 0
        WhileLoop LessThan(i, cnt) {
            base       = Add(WinTable.entries, Multiply(i, WinTableConst.ENTRY_SIZE))
            entry_leaf = Dereference(Add(base, WinTableConst.LEAF_OFS))
            IfCondition EqualTo(entry_leaf, leaf) ThenBlock: {
                result = Dereference(Add(base, WinTableConst.SURF_OFS))
                i = cnt
            } ElseBlock: {
                i = Add(i, 1)
            }
        }
        ReturnValue(result)
    }
}

Function.WinTable_Remove {
    Input:  leaf: Integer
    Output: Integer
    Body: {
        cnt   = WinTable.count
        found = 0
        i     = 0
        WhileLoop LessThan(i, cnt) {
            base       = Add(WinTable.entries, Multiply(i, WinTableConst.ENTRY_SIZE))
            entry_leaf = Dereference(Add(base, WinTableConst.LEAF_OFS))
            IfCondition EqualTo(entry_leaf, leaf) ThenBlock: {
                found = 1
                j = Add(i, 1)
                WhileLoop LessThan(j, cnt) {
                    src      = Add(WinTable.entries, Multiply(j,             WinTableConst.ENTRY_SIZE))
                    dst      = Add(WinTable.entries, Multiply(Subtract(j,1), WinTableConst.ENTRY_SIZE))
                    lv       = Dereference(Add(src, WinTableConst.LEAF_OFS))
                    sv       = Dereference(Add(src, WinTableConst.SURF_OFS))
                    StoreValue(Add(dst, WinTableConst.LEAF_OFS), lv)
                    StoreValue(Add(dst, WinTableConst.SURF_OFS), sv)
                    j = Add(j, 1)
                }
                WinTable.count = Subtract(cnt, 1)
                i = cnt
            } ElseBlock: {
                i = Add(i, 1)
            }
        }
        ReturnValue(found)
    }
}

SubRoutine.WinTable_MarkAllDirty {
    cnt = WinTable.count
    i   = 0
    WhileLoop LessThan(i, cnt) {
        base = Add(WinTable.entries, Multiply(i, WinTableConst.ENTRY_SIZE))
        surf = Dereference(Add(base, WinTableConst.SURF_OFS))
        IfCondition NotEqual(surf, 0) ThenBlock: {
            w = Surface_GetWidth(surf)
            h = Surface_GetHeight(surf)
            Ring3_MarkDirty(surf, 0, 0, w, h)
        }
        i = Add(i, 1)
    }
}

// =============================================================================
// COLOR TABLE — cycle through distinct window colors
// =============================================================================
FixedPool.WinColors {
    "idx": Initialize=0
    "c0":  Initialize=0x1A3A5C
    "c1":  Initialize=0x3A1A1A
    "c2":  Initialize=0x1A3A1A
    "c3":  Initialize=0x3A3A1A
    "c4":  Initialize=0x2A1A3A
    "c5":  Initialize=0x1A3A3A
    "c6":  Initialize=0x3A2A1A
    "c7":  Initialize=0x2A2A2A
}

Function.WinColors_Next {
    Output: Integer
    Body: {
        idx = WinColors.idx
        col = WinColors.c0
        IfCondition EqualTo(idx, 1) ThenBlock: { col = WinColors.c1 }
        IfCondition EqualTo(idx, 2) ThenBlock: { col = WinColors.c2 }
        IfCondition EqualTo(idx, 3) ThenBlock: { col = WinColors.c3 }
        IfCondition EqualTo(idx, 4) ThenBlock: { col = WinColors.c4 }
        IfCondition EqualTo(idx, 5) ThenBlock: { col = WinColors.c5 }
        IfCondition EqualTo(idx, 6) ThenBlock: { col = WinColors.c6 }
        IfCondition EqualTo(idx, 7) ThenBlock: { col = WinColors.c7 }
        next = Add(idx, 1)
        IfCondition GreaterEqual(next, 8) ThenBlock: { next = 0 }
        WinColors.idx = next
        ReturnValue(col)
    }
}

// =============================================================================
// WIN CREATE FOR LEAF — allocate surface, fill color, white border, register
// =============================================================================
Function.WinCreate_ForLeaf {
    Input:  leaf: Integer
    Output: Integer
    Body: {
        w = BSP_GetRegionW(leaf)
        h = BSP_GetRegionH(leaf)
        IfCondition EqualTo(w, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(h, 0) ThenBlock: { ReturnValue(0) }

        surf = Surface_Create(w, h, SurfaceFormat.PIXEL_32)
        IfCondition EqualTo(surf, 0) ThenBlock: {
            PrintMessage("[WinCreate] ERROR: Surface_Create failed\n")
            ReturnValue(0)
        }

        col = WinColors_Next()
        Draw_Pix_FillRect(surf, 0, 0, w, h, col)

        // White border
        bw = Subtract(w, 1)
        bh = Subtract(h, 1)
        Draw_Pix_HLine(surf, 0, bw, 0,  0xFFFFFF)
        Draw_Pix_HLine(surf, 0, bw, bh, 0xFFFFFF)
        Draw_Pix_VLine(surf, 0,  0, bh, 0xFFFFFF)
        Draw_Pix_VLine(surf, bw, 0, bh, 0xFFFFFF)

        WinTable_Add(leaf, surf)

        PrintMessage("[WinCreate] leaf=")
        PrintNumber(leaf)
        PrintMessage(" ")
        PrintNumber(w)
        PrintMessage("x")
        PrintNumber(h)
        PrintMessage("\n")

        ReturnValue(surf)
    }
}

// =============================================================================
// TICK PHASE 1 — Drain Ring 0 (focus/control/window management)
// =============================================================================
SubRoutine.Compose_TickRing0 {
    entry = Allocate(RingEntry.SIZE)

    WhileLoop EqualTo(Ring0_IsEmpty(), 0) {
        Ring0_Drain(entry)
        cmd = Subtract(Dereference(Add(entry, RingEntry.TYPE)),    65536)
        pa  = Subtract(Dereference(Add(entry, RingEntry.PARAM_A)), 65536)
        pb  = Subtract(Dereference(Add(entry, RingEntry.PARAM_B)), 65536)

        IfCondition EqualTo(cmd, Ring0Cmd.FOCUS_SET) ThenBlock: {
            Compositor.focused_leaf = pa
        }

        IfCondition EqualTo(cmd, Ring0Cmd.QUIT) ThenBlock: {
            Compositor.initialized = Add(0, 65536)
        }

        IfCondition EqualTo(cmd, Ring0Cmd.FOCUS_MODE) ThenBlock: {
            Compositor.focus_mode = Add(pa, 65536)
        }

        IfCondition EqualTo(cmd, Ring0Cmd.WIN_CREATE) ThenBlock: {
            focused = Compositor.focused_leaf
            IfCondition NotEqual(focused, 0) ThenBlock: {
                split_type = pa
                split_pos  = pb
                IfCondition EqualTo(split_pos, 0) ThenBlock: {
                    IfCondition EqualTo(split_type, BSPNodeType.SPLIT_V) ThenBlock: {
                        split_pos = Divide(BSP_GetRegionW(focused), 2)
                    } ElseBlock: {
                        split_pos = Divide(BSP_GetRegionH(focused), 2)
                    }
                }
                new_leaf = BSP_Split(focused, split_type, split_pos)
                IfCondition NotEqual(new_leaf, 0) ThenBlock: {
                    WinCreate_ForLeaf(new_leaf)
                    Compositor.focused_leaf = new_leaf
                    WinTable_MarkAllDirty()
                }
            }
        }

        IfCondition EqualTo(cmd, Ring0Cmd.WIN_DESTROY) ThenBlock: {
            target = pa
            IfCondition EqualTo(target, 0) ThenBlock: {
                target = Compositor.focused_leaf
            }
            IfCondition NotEqual(target, 0) ThenBlock: {
                surf = WinTable_GetSurface(target)
                IfCondition NotEqual(surf, 0) ThenBlock: {
                    Surface_Destroy(surf)
                    WinTable_Remove(target)
                }
                parent = BSP_GetParent(target)
                IfCondition NotEqual(parent, 0) ThenBlock: {
                    BSP_Merge(parent)
                    Compositor.focused_leaf = parent
                    WinTable_MarkAllDirty()
                }
            }
        }

        IfCondition EqualTo(cmd, Ring0Cmd.TILE_SPLIT_H) ThenBlock: {
            focused = Compositor.focused_leaf
            IfCondition NotEqual(focused, 0) ThenBlock: {
                split_pos = pa
                IfCondition EqualTo(split_pos, 0) ThenBlock: {
                    split_pos = Divide(BSP_GetRegionH(focused), 2)
                }
                new_leaf = BSP_Split(focused, BSPNodeType.SPLIT_H, split_pos)
                IfCondition NotEqual(new_leaf, 0) ThenBlock: {
                    WinCreate_ForLeaf(new_leaf)
                    Compositor.focused_leaf = new_leaf
                    WinTable_MarkAllDirty()
                }
            }
        }

        IfCondition EqualTo(cmd, Ring0Cmd.TILE_SPLIT_V) ThenBlock: {
            focused = Compositor.focused_leaf
            IfCondition NotEqual(focused, 0) ThenBlock: {
                split_pos = pa
                IfCondition EqualTo(split_pos, 0) ThenBlock: {
                    split_pos = Divide(BSP_GetRegionW(focused), 2)
                }
                new_leaf = BSP_Split(focused, BSPNodeType.SPLIT_V, split_pos)
                IfCondition NotEqual(new_leaf, 0) ThenBlock: {
                    WinCreate_ForLeaf(new_leaf)
                    Compositor.focused_leaf = new_leaf
                    WinTable_MarkAllDirty()
                }
            }
        }

        IfCondition EqualTo(cmd, Ring0Cmd.TILE_MERGE) ThenBlock: {
            focused = Compositor.focused_leaf
            IfCondition NotEqual(focused, 0) ThenBlock: {
                parent = BSP_GetParent(focused)
                IfCondition NotEqual(parent, 0) ThenBlock: {
                    ca = BSP_GetChildA(parent)
                    cb = BSP_GetChildB(parent)
                    sa = WinTable_GetSurface(ca)
                    sb = WinTable_GetSurface(cb)
                    IfCondition NotEqual(sa, 0) ThenBlock: {
                        Surface_Destroy(sa)
                        WinTable_Remove(ca)
                    }
                    IfCondition NotEqual(sb, 0) ThenBlock: {
                        Surface_Destroy(sb)
                        WinTable_Remove(cb)
                    }
                    BSP_Merge(parent)
                    WinCreate_ForLeaf(parent)
                    Compositor.focused_leaf = parent
                    WinTable_MarkAllDirty()
                }
            }
        }
    }

    Deallocate(entry, RingEntry.SIZE)
}

// =============================================================================
// TICK PHASE 3 — Drain Ring 2 (draw commands → mark dirty)
// Each command targets a surface and marks the affected region dirty
// =============================================================================
SubRoutine.Compose_TickRing2 {
    entry = Allocate(RingEntry.SIZE)
    WhileLoop EqualTo(Ring2_IsEmpty(), 0) {
        Ring2_Drain(entry)
        cmd     = Subtract(Dereference(Add(entry, RingEntry.TYPE)),    65536)
        surface = Subtract(Dereference(Add(entry, RingEntry.PARAM_A)), 65536)

        IfCondition EqualTo(surface, 0) ThenBlock: {
            // Invalid surface — skip
        } ElseBlock: {
            w = Surface_GetWidth(surface)
            h = Surface_GetHeight(surface)
            Ring3_MarkDirty(surface, 0, 0, w, h)
        }
    }
    Deallocate(entry, RingEntry.SIZE)
}

// =============================================================================
// TICK PHASE 4 — Process Ring 3 (dirty regions → blit to output)
// =============================================================================
SubRoutine.Compose_TickRing3 {
    IfCondition EqualTo(Ring3_IsDirty(), 0) ThenBlock: {
        ReturnValue(0)
    }

    count = Ring3_GetCount()
    i = 0
    WhileLoop LessThan(i, count) {
        surf = 0
        dx   = 0
        dy   = 0
        dw   = 0
        dh   = 0

        IfCondition EqualTo(i, 0) ThenBlock: {
            surf = DirtyState.surf0
            dx   = DirtyState.x0
            dy   = DirtyState.y0
            dw   = Subtract(DirtyState.w0, 65536)
            dh   = Subtract(DirtyState.h0, 65536)
        }
        IfCondition EqualTo(i, 1) ThenBlock: {
            surf = DirtyState.surf1
            dx   = DirtyState.x1
            dy   = DirtyState.y1
            dw   = Subtract(DirtyState.w1, 65536)
            dh   = Subtract(DirtyState.h1, 65536)
        }
        IfCondition EqualTo(i, 2) ThenBlock: {
            surf = DirtyState.surf2
            dx   = DirtyState.x2
            dy   = DirtyState.y2
            dw   = Subtract(DirtyState.w2, 65536)
            dh   = Subtract(DirtyState.h2, 65536)
        }
        IfCondition EqualTo(i, 3) ThenBlock: {
            surf = DirtyState.surf3
            dx   = DirtyState.x3
            dy   = DirtyState.y3
            dw   = Subtract(DirtyState.w3, 65536)
            dh   = Subtract(DirtyState.h3, 65536)
        }

        IfCondition NotEqual(surf, 0) ThenBlock: {
            Compose_Blit(surf, dx, dy, dw, dh)
        }

        i = Add(i, 1)
    }

    Ring3_Clear()
}

// =============================================================================
// COMPOSE BLIT — copy surface region to output
// =============================================================================
FixedPool.ComposeOutput {
    "mode":        Initialize=0
    "fb_offset_x": Initialize=0
    "fb_offset_y": Initialize=0
}

Function.Compose_Blit {
    Input: surf: Integer
    Input: x:    Integer
    Input: y:    Integer
    Input: w:    Integer
    Input: h:    Integer
    Body: {
        mode = ComposeOutput.mode
        IfCondition EqualTo(mode, Add(0, 65536)) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition EqualTo(mode, Add(2, 65536)) ThenBlock: {
            format = Surface_GetFormat(surf)
            IfCondition NotEqual(format, SurfaceFormat.PIXEL_32) ThenBlock: {
                ReturnValue(0)
            }
            ox = Subtract(ComposeOutput.fb_offset_x, 65536)
            oy = Subtract(ComposeOutput.fb_offset_y, 65536)
            RenderFB_FlushRect(surf, Add(x, ox), Add(y, oy), w, h)
            ReturnValue(1)
        }
        ReturnValue(0)
    }
}

// =============================================================================
// FULL TICK — call once per frame
// =============================================================================
SubRoutine.Compose_Tick {
    Compose_TickRing0()
    Compose_TickRing2()
    Compose_TickRing3()
}