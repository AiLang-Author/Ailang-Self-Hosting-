//
// Library.DCompose.ailang
// Compositor tick loop — connects Ring2 → dirty → BSP → blit
// Phase 4: Axis 2 — Compose
//
// Tick order (every frame):
//   1. Drain Ring 0 (focus/control/BSP changes)
//   2. Drain Ring 1 (input — not yet wired, placeholder)
//   3. Process Ring 2 (draw commands → mark dirty)
//   4. Process Ring 3 (dirty regions → BSP query → blit)
//
// Usage: LibraryImport.DCompose

LibraryImport.DSurfaceTypes
LibraryImport.DSurface
LibraryImport.Framebuffer
LibraryImport.DRingTypes
LibraryImport.DRing
LibraryImport.DRing0
LibraryImport.DRing1
LibraryImport.DRing2
LibraryImport.DRing3
LibraryImport.DComposeTypes
LibraryImport.DComposeBSP
LibraryImport.DComposeStack
LibraryImport.DComposeFloat

// =============================================================================
// COMPOSITOR INIT
// =============================================================================
Function.Compose_Init {
    Input:  screen_w: Integer
    Input:  screen_h: Integer
    Output: Integer
    Body: {
        root = BSP_Init(screen_w, screen_h)
        IfCondition EqualTo(root, 0) ThenBlock: {
            PrintMessage("[Compose] ERROR: BSP_Init failed\n")
            ReturnValue(0)
        }

        Float_Init()
        Ring0_Init()
        Ring1_Init()
        Ring2_Init()
        Ring3_Init()

        Compositor.focused_leaf  = root
        Compositor.focus_mode    = Add(FocusMode.CLICK_TO_FOCUS, 65536)
        Compositor.stack_pending = Add(0, 65536)

        PrintMessage("[Compose] initialized ")
        PrintNumber(screen_w)
        PrintMessage("x")
        PrintNumber(screen_h)
        PrintMessage("\n")
        ReturnValue(1)
    }
}

SubRoutine.Compose_Shutdown {
    Ring0_Shutdown()
    Ring1_Shutdown()
    Ring2_Shutdown()
    Ring3_Shutdown()
    Float_Shutdown()
    IfCondition NotEqual(Compositor.root, 0) ThenBlock: {
        BSP_Free(Compositor.root)
        Compositor.root = 0
    }
    Compositor.initialized = Add(0, 65536)
}

// =============================================================================
// TICK PHASE 1 — Drain Ring 0 (focus/control)
// =============================================================================
SubRoutine.Compose_TickRing0 {
    entry = Allocate(RingEntry.SIZE)
    WhileLoop EqualTo(Ring0_IsEmpty(), 0) {
        Ring0_Drain(entry)
        cmd = Subtract(Dereference(Add(entry, RingEntry.TYPE)),    65536)
        pa  = Subtract(Dereference(Add(entry, RingEntry.PARAM_A)), 65536)

        IfCondition EqualTo(cmd, Ring0Cmd.FOCUS_SET) ThenBlock: {
            Compositor.focused_leaf = pa
        }
        IfCondition EqualTo(cmd, Ring0Cmd.QUIT) ThenBlock: {
            Compositor.initialized = Add(0, 65536)
        }
        // Additional Ring0 commands wired in future phases
    }
    Deallocate(entry, RingEntry.SIZE)
}

// =============================================================================
// TICK PHASE 3 — Drain Ring 2 (draw commands → mark dirty)
// Each command targets a surface and marks the affected region dirty
// =============================================================================
SubRoutine.Compose_TickRing2 {
    entry = Allocate(RingEntry.SIZE)
    WhileLoop EqualTo(Ring2_IsEmpty(), 0) {
        Ring2_Drain(entry)
        cmd     = Subtract(Dereference(Add(entry, RingEntry.TYPE)),    65536)
        surface = Subtract(Dereference(Add(entry, RingEntry.PARAM_A)), 65536)

        IfCondition EqualTo(surface, 0) ThenBlock: {
            // Invalid surface — skip
        } ElseBlock: {
            // Mark entire surface dirty — compositor will blit it
            w = Surface_GetWidth(surface)
            h = Surface_GetHeight(surface)
            Ring3_MarkDirty(surface, 0, 0, w, h)
        }
    }
    Deallocate(entry, RingEntry.SIZE)
}

// =============================================================================
// TICK PHASE 4 — Process Ring 3 (dirty regions → blit to output)
// For each dirty region: BSP query → get active surface → blit
// This is the compositor's core: opaque copy, no blending
// =============================================================================
SubRoutine.Compose_TickRing3 {
    IfCondition EqualTo(Ring3_IsDirty(), 0) ThenBlock: {
        ReturnValue(0)   // nothing to do — zero cost idle
    }

    count = Ring3_GetCount()
    i = 0
    WhileLoop LessThan(i, count) {
        // Read dirty entry from DirtyState
        surf = 0
        dx   = 0
        dy   = 0
        dw   = 0
        dh   = 0

        IfCondition EqualTo(i, 0) ThenBlock: {
            surf = DirtyState.surf0
            dx   = DirtyState.x0
            dy   = DirtyState.y0
            dw   = Subtract(DirtyState.w0, 65536)
            dh   = Subtract(DirtyState.h0, 65536)
        }
        IfCondition EqualTo(i, 1) ThenBlock: {
            surf = DirtyState.surf1
            dx   = DirtyState.x1
            dy   = DirtyState.y1
            dw   = Subtract(DirtyState.w1, 65536)
            dh   = Subtract(DirtyState.h1, 65536)
        }
        IfCondition EqualTo(i, 2) ThenBlock: {
            surf = DirtyState.surf2
            dx   = DirtyState.x2
            dy   = DirtyState.y2
            dw   = Subtract(DirtyState.w2, 65536)
            dh   = Subtract(DirtyState.h2, 65536)
        }
        IfCondition EqualTo(i, 3) ThenBlock: {
            surf = DirtyState.surf3
            dx   = DirtyState.x3
            dy   = DirtyState.y3
            dw   = Subtract(DirtyState.w3, 65536)
            dh   = Subtract(DirtyState.h3, 65536)
        }
        IfCondition EqualTo(i, 4) ThenBlock: {
            surf = DirtyState.surf4
            dx   = DirtyState.x4
            dy   = DirtyState.y4
            dw   = Subtract(DirtyState.w4, 65536)
            dh   = Subtract(DirtyState.h4, 65536)
        }
        IfCondition EqualTo(i, 5) ThenBlock: {
            surf = DirtyState.surf5
            dx   = DirtyState.x5
            dy   = DirtyState.y5
            dw   = Subtract(DirtyState.w5, 65536)
            dh   = Subtract(DirtyState.h5, 65536)
        }
        IfCondition EqualTo(i, 6) ThenBlock: {
            surf = DirtyState.surf6
            dx   = DirtyState.x6
            dy   = DirtyState.y6
            dw   = Subtract(DirtyState.w6, 65536)
            dh   = Subtract(DirtyState.h6, 65536)
        }
        IfCondition EqualTo(i, 7) ThenBlock: {
            surf = DirtyState.surf7
            dx   = DirtyState.x7
            dy   = DirtyState.y7
            dw   = Subtract(DirtyState.w7, 65536)
            dh   = Subtract(DirtyState.h7, 65536)
        }

        // Blit dirty region — caller provides output function via Compose_SetBlitFn
        IfCondition NotEqual(surf, 0) ThenBlock: {
            Compose_Blit(surf, dx, dy, dw, dh)
        }

        i = Add(i, 1)
    }

    Ring3_Clear()
}

// =============================================================================
// COMPOSE BLIT — copy surface region to output
// Override this for terminal vs framebuffer output
// Default: does nothing (output backend wires in DRenderFB or DRenderTerm)
// =============================================================================
FixedPool.ComposeOutput {
    "mode":      Initialize=0    // 0=none 1=term 2=fb
    "fb_offset_x": Initialize=0
    "fb_offset_y": Initialize=0
}

Function.Compose_Blit {
    Input: surf: Integer
    Input: x:    Integer
    Input: y:    Integer
    Input: w:    Integer
    Input: h:    Integer
    Body: {
        mode = ComposeOutput.mode
        IfCondition EqualTo(mode, 0) ThenBlock: { ReturnValue(0) }

        // Framebuffer mode — blit surface pixels to FB
        IfCondition EqualTo(mode, Add(2, 65536)) ThenBlock: {
            format = Surface_GetFormat(surf)
            IfCondition NotEqual(format, SurfaceFormat.PIXEL_32) ThenBlock: {
                ReturnValue(0)
            }

            src_data  = Surface_GetData(surf)
            src_pitch = Surface_GetPitch(surf)
            dst_buf   = FB_GetDrawBuffer()

            row = y
            WhileLoop LessThan(row, Add(y, h)) {
                src_row = Add(src_data, Multiply(row, src_pitch))
                dst_row = Add(dst_buf,  Multiply(row, FB.pitch))
                col_bytes = Multiply(w, 4)
                bi = 0
                WhileLoop LessThan(bi, col_bytes) {
                    SetByte(dst_row, Add(Multiply(x, 4), bi), GetByte(src_row, Add(Multiply(x, 4), bi)))
                    bi = Add(bi, 1)
                }
                row = Add(row, 1)
            }
        }

        ReturnValue(1)
    }
}

// =============================================================================
// FULL TICK — call once per frame
// =============================================================================
SubRoutine.Compose_Tick {
    Compose_TickRing0()
    Compose_TickRing2()
    Compose_TickRing3()
}