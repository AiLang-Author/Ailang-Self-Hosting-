//
// Library.DComposeBSP.ailang
// BSP tree operations: create, split, merge, query, resize
// Phase 4: Axis 2 — Compose
//
// Usage: LibraryImport.DComposeBSP

LibraryImport.Arena
LibraryImport.DComposeTypes

// =============================================================================
// INTERNAL: allocate a BSP node, zero it, store type+65536 bias
// =============================================================================
Function.BSP_AllocNode {
    Input:  node_type: Integer
    Output: Integer
    Body: {
        node = Allocate(BSPNodeConst.SIZE)
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }

        // Zero
        i = 0
        WhileLoop LessThan(i, BSPNodeConst.SIZE) {
            SetByte(node, i, 0)
            i = Add(i, 1)
        }

        // Store type with bias so StoreValue writes 8 bytes
        StoreValue(Add(node, BSPNodeFields.TYPE), Add(node_type, 65536))
        ReturnValue(node)
    }
}

// =============================================================================
// FIELD ACCESSORS — all use +65536 bias on write, subtract on read
// =============================================================================
Function.BSP_GetType {
    Input: node: Integer  Output: Integer
    Body: { ReturnValue(Subtract(Dereference(Add(node, BSPNodeFields.TYPE)), 65536)) }
}
Function.BSP_GetParent {
    Input: node: Integer  Output: Integer
    Body: { ReturnValue(Dereference(Add(node, BSPNodeFields.PARENT))) }
}
Function.BSP_GetRegionX {
    Input: node: Integer  Output: Integer
    Body: { ReturnValue(Subtract(Dereference(Add(node, BSPNodeFields.REGION_X)), 65536)) }
}
Function.BSP_GetRegionY {
    Input: node: Integer  Output: Integer
    Body: { ReturnValue(Subtract(Dereference(Add(node, BSPNodeFields.REGION_Y)), 65536)) }
}
Function.BSP_GetRegionW {
    Input: node: Integer  Output: Integer
    Body: { ReturnValue(Subtract(Dereference(Add(node, BSPNodeFields.REGION_W)), 65536)) }
}
Function.BSP_GetRegionH {
    Input: node: Integer  Output: Integer
    Body: { ReturnValue(Subtract(Dereference(Add(node, BSPNodeFields.REGION_H)), 65536)) }
}
Function.BSP_GetSplitPos {
    Input: node: Integer  Output: Integer
    Body: { ReturnValue(Subtract(Dereference(Add(node, BSPNodeFields.SPLIT_POS)), 65536)) }
}
Function.BSP_GetChildA {
    Input: node: Integer  Output: Integer
    Body: { ReturnValue(Dereference(Add(node, BSPNodeFields.CHILD_A))) }
}
Function.BSP_GetChildB {
    Input: node: Integer  Output: Integer
    Body: { ReturnValue(Dereference(Add(node, BSPNodeFields.CHILD_B))) }
}
Function.BSP_GetStackGroup {
    Input: node: Integer  Output: Integer
    Body: { ReturnValue(Dereference(Add(node, BSPNodeFields.STACK_GROUP))) }
}

// Write helpers
Function.BSP_SetRegion {
    Input: node: Integer
    Input: x: Integer  Input: y: Integer
    Input: w: Integer  Input: h: Integer
    Body: {
        StoreValue(Add(node, BSPNodeFields.REGION_X), Add(x, 65536))
        StoreValue(Add(node, BSPNodeFields.REGION_Y), Add(y, 65536))
        StoreValue(Add(node, BSPNodeFields.REGION_W), Add(w, 65536))
        StoreValue(Add(node, BSPNodeFields.REGION_H), Add(h, 65536))
        ReturnValue(0)
    }
}

// =============================================================================
// BSP INIT — create root leaf covering full screen
// =============================================================================
Function.BSP_Init {
    Input:  screen_w: Integer
    Input:  screen_h: Integer
    Output: Integer
    Body: {
        root = BSP_AllocNode(BSPNodeType.LEAF)
        IfCondition EqualTo(root, 0) ThenBlock: { ReturnValue(0) }

        BSP_SetRegion(root, 0, 0, screen_w, screen_h)
        StoreValue(Add(root, BSPNodeFields.PARENT),      0)
        StoreValue(Add(root, BSPNodeFields.STACK_GROUP), 0)

        Compositor.root     = root
        Compositor.screen_w = Add(screen_w, 65536)
        Compositor.screen_h = Add(screen_h, 65536)
        Compositor.initialized = Add(1, 65536)

        ReturnValue(root)
    }
}

// =============================================================================
// BSP SPLIT — split a leaf node into two children
// split_type: BSPNodeType.SPLIT_H or SPLIT_V
// split_pos: offset from region origin where split occurs
// Returns the new split node (the leaf becomes a child)
// =============================================================================
Function.BSP_Split {
    Input:  leaf:       Integer
    Input:  split_type: Integer
    Input:  split_pos:  Integer
    Output: Integer
    Body: {
        IfCondition NotEqual(BSP_GetType(leaf), BSPNodeType.LEAF) ThenBlock: {
            PrintMessage("[BSP] ERROR: Split called on non-leaf\n")
            ReturnValue(0)
        }

        rx = BSP_GetRegionX(leaf)
        ry = BSP_GetRegionY(leaf)
        rw = BSP_GetRegionW(leaf)
        rh = BSP_GetRegionH(leaf)

        // Create two child leaves
        child_a = BSP_AllocNode(BSPNodeType.LEAF)
        child_b = BSP_AllocNode(BSPNodeType.LEAF)
        IfCondition EqualTo(child_a, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(child_b, 0) ThenBlock: {
            Deallocate(child_a, BSPNodeConst.SIZE)
            ReturnValue(0)
        }

        // Set child regions based on split type
        IfCondition EqualTo(split_type, BSPNodeType.SPLIT_H) ThenBlock: {
            // Horizontal split: top/bottom
            BSP_SetRegion(child_a, rx, ry,              rw, split_pos)
            BSP_SetRegion(child_b, rx, Add(ry, split_pos), rw, Subtract(rh, split_pos))
        } ElseBlock: {
            // Vertical split: left/right
            BSP_SetRegion(child_a, rx,              ry, split_pos,              rh)
            BSP_SetRegion(child_b, Add(rx, split_pos), ry, Subtract(rw, split_pos), rh)
        }

        // Move stack group from leaf to child_a
        sg = BSP_GetStackGroup(leaf)
        StoreValue(Add(child_a, BSPNodeFields.STACK_GROUP), sg)
        IfCondition NotEqual(sg, 0) ThenBlock: {
            StoreValue(Add(sg, StackGroupFields.BSP_LEAF), child_a)
        }

        // Set parent pointers
        StoreValue(Add(child_a, BSPNodeFields.PARENT), leaf)
        StoreValue(Add(child_b, BSPNodeFields.PARENT), leaf)

        // Convert leaf to split node
        StoreValue(Add(leaf, BSPNodeFields.TYPE),       Add(split_type, 65536))
        StoreValue(Add(leaf, BSPNodeFields.SPLIT_POS),  Add(split_pos,  65536))
        StoreValue(Add(leaf, BSPNodeFields.STACK_GROUP), 0)
        StoreValue(Add(leaf, BSPNodeFields.CHILD_A),    child_a)
        StoreValue(Add(leaf, BSPNodeFields.CHILD_B),    child_b)

        ReturnValue(child_b)   // new empty leaf for caller to use
    }
}

// =============================================================================
// BSP MERGE — undo a split, collapse two children back into parent leaf
// parent must be a split node whose children are both leaves
// =============================================================================
Function.BSP_Merge {
    Input:  parent: Integer
    Output: Integer
    Body: {
        t = BSP_GetType(parent)
        IfCondition EqualTo(t, BSPNodeType.LEAF) ThenBlock: {
            PrintMessage("[BSP] ERROR: Merge called on leaf\n")
            ReturnValue(0)
        }

        child_a = BSP_GetChildA(parent)
        child_b = BSP_GetChildB(parent)

        IfCondition NotEqual(BSP_GetType(child_a), BSPNodeType.LEAF) ThenBlock: {
            PrintMessage("[BSP] ERROR: Merge child_a is not a leaf\n")
            ReturnValue(0)
        }
        IfCondition NotEqual(BSP_GetType(child_b), BSPNodeType.LEAF) ThenBlock: {
            PrintMessage("[BSP] ERROR: Merge child_b is not a leaf\n")
            ReturnValue(0)
        }

        // Move child_a's stack group to parent
        sg = BSP_GetStackGroup(child_a)
        StoreValue(Add(parent, BSPNodeFields.TYPE),        Add(BSPNodeType.LEAF, 65536))
        StoreValue(Add(parent, BSPNodeFields.STACK_GROUP), sg)
        StoreValue(Add(parent, BSPNodeFields.CHILD_A),     0)
        StoreValue(Add(parent, BSPNodeFields.CHILD_B),     0)
        StoreValue(Add(parent, BSPNodeFields.SPLIT_POS),   Add(0, 65536))

        IfCondition NotEqual(sg, 0) ThenBlock: {
            StoreValue(Add(sg, StackGroupFields.BSP_LEAF), parent)
        }

        Deallocate(child_a, BSPNodeConst.SIZE)
        Deallocate(child_b, BSPNodeConst.SIZE)

        ReturnValue(1)
    }
}

// =============================================================================
// BSP QUERY — find the leaf node containing point (px, py)
// Returns leaf node handle, or 0 if not found
// O(log n) — recurse down the tree
// =============================================================================
Function.BSP_Query {
    Input:  node: Integer
    Input:  px:   Integer
    Input:  py:   Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }

        t = BSP_GetType(node)

        // At a leaf — check if point is inside this region
        IfCondition EqualTo(t, BSPNodeType.LEAF) ThenBlock: {
            rx = BSP_GetRegionX(node)
            ry = BSP_GetRegionY(node)
            rw = BSP_GetRegionW(node)
            rh = BSP_GetRegionH(node)
            IfCondition LessThan(px, rx)             ThenBlock: { ReturnValue(0) }
            IfCondition LessThan(py, ry)             ThenBlock: { ReturnValue(0) }
            IfCondition Not(LessThan(px, Add(rx, rw))) ThenBlock: { ReturnValue(0) }
            IfCondition Not(LessThan(py, Add(ry, rh))) ThenBlock: { ReturnValue(0) }
            ReturnValue(node)
        }

        // Split node — recurse into correct child
        IfCondition EqualTo(t, BSPNodeType.SPLIT_H) ThenBlock: {
            // Horizontal split: top/bottom
            ry       = BSP_GetRegionY(node)
            split_pos = BSP_GetSplitPos(node)
            IfCondition LessThan(py, Add(ry, split_pos)) ThenBlock: {
                ReturnValue(BSP_Query(BSP_GetChildA(node), px, py))
            } ElseBlock: {
                ReturnValue(BSP_Query(BSP_GetChildB(node), px, py))
            }
        }

        // SPLIT_V — vertical split: left/right
        rx        = BSP_GetRegionX(node)
        split_pos = BSP_GetSplitPos(node)
        IfCondition LessThan(px, Add(rx, split_pos)) ThenBlock: {
            ReturnValue(BSP_Query(BSP_GetChildA(node), px, py))
        } ElseBlock: {
            ReturnValue(BSP_Query(BSP_GetChildB(node), px, py))
        }
    }
}

// =============================================================================
// BSP FREE — recursively free a subtree
// =============================================================================
Function.BSP_Free {
    Input: node: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }

        t = BSP_GetType(node)
        IfCondition NotEqual(t, BSPNodeType.LEAF) ThenBlock: {
            BSP_Free(BSP_GetChildA(node))
            BSP_Free(BSP_GetChildB(node))
        }

        Deallocate(node, BSPNodeConst.SIZE)
        ReturnValue(1)
    }
}