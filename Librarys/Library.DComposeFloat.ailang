//
// Library.DComposeFloat.ailang
// Floating window list — transient windows during drag / pre-snap
// Max 8 floats. Hard-clamped to screen bounds always.
// Phase 4: Axis 2 — Compose
//
// Usage: LibraryImport.DComposeFloat

LibraryImport.Arena
LibraryImport.DComposeTypes

// Float table — fixed array of MAX_FLOATING entries
// Each entry is FloatEntryConst.SIZE bytes
FixedPool.FloatTable {
    "entries":   Initialize=0    // pointer to entry array
    "count":     Initialize=0
    "initialized": Initialize=0
}

// =============================================================================
// INIT
// =============================================================================
SubRoutine.Float_Init {
    size = Multiply(FloatEntryConst.MAX_FLOATING, FloatEntryConst.SIZE)
    buf  = Allocate(size)
    i = 0
    WhileLoop LessThan(i, size) {
        SetByte(buf, i, 0)
        i = Add(i, 1)
    }
    FloatTable.entries     = buf
    FloatTable.count       = Add(0, 65536)
    FloatTable.initialized = Add(1, 65536)
}

SubRoutine.Float_Shutdown {
    IfCondition NotEqual(FloatTable.entries, 0) ThenBlock: {
        Deallocate(FloatTable.entries, Multiply(FloatEntryConst.MAX_FLOATING, FloatEntryConst.SIZE))
        FloatTable.entries = 0
    }
    FloatTable.count = Add(0, 65536)
    FloatTable.initialized = Add(0, 65536)
}

// =============================================================================
// INTERNAL: get pointer to float entry at index
// =============================================================================
Function.Float_EntryPtr {
    Input:  idx: Integer
    Output: Integer
    Body: {
        ReturnValue(Add(FloatTable.entries, Multiply(idx, FloatEntryConst.SIZE)))
    }
}

// =============================================================================
// FLOAT ADD — add a floating window
// Clamps position to screen bounds immediately
// Returns index, or -1 if full
// =============================================================================
Function.Float_Add {
    Input:  surface:  Integer
    Input:  x:        Integer
    Input:  y:        Integer
    Input:  w:        Integer
    Input:  h:        Integer
    Output: Integer
    Body: {
        count = Subtract(FloatTable.count, 65536)
        IfCondition GreaterEqual(count, FloatEntryConst.MAX_FLOATING) ThenBlock: {
            PrintMessage("[Float] ERROR: float list full\n")
            ReturnValue(-1)
        }

        sw = Subtract(Compositor.screen_w, 65536)
        sh = Subtract(Compositor.screen_h, 65536)

        cx = x
        cy = y
        IfCondition LessThan(cx, 0)                ThenBlock: { cx = 0 }
        IfCondition LessThan(cy, 0)                ThenBlock: { cy = 0 }
        IfCondition GreaterThan(Add(cx, w), sw)    ThenBlock: { cx = Subtract(sw, w) }
        IfCondition GreaterThan(Add(cy, h), sh)    ThenBlock: { cy = Subtract(sh, h) }
        IfCondition LessThan(cx, 0)                ThenBlock: { cx = 0 }
        IfCondition LessThan(cy, 0)                ThenBlock: { cy = 0 }

        ptr = Float_EntryPtr(count)
        StoreValue(Add(ptr, FloatEntryFields.SURFACE),  surface)
        StoreValue(Add(ptr, FloatEntryFields.X),        Add(cx, 65536))
        StoreValue(Add(ptr, FloatEntryFields.Y),        Add(cy, 65536))
        StoreValue(Add(ptr, FloatEntryFields.W),        Add(w,  65536))
        StoreValue(Add(ptr, FloatEntryFields.H),        Add(h,  65536))
        StoreValue(Add(ptr, FloatEntryFields.Z_ORDER),  Add(count, 65536))
        StoreValue(Add(ptr, FloatEntryFields.DRAGGING), Add(0, 65536))

        FloatTable.count = Add(Add(count, 1), 65536)
        ReturnValue(count)
    }
}

// =============================================================================
// FLOAT REMOVE — remove by index, compact list
// =============================================================================
Function.Float_Remove {
    Input:  idx: Integer
    Output: Integer
    Body: {
        count = Subtract(FloatTable.count, 65536)
        IfCondition Not(LessThan(idx, count)) ThenBlock: { ReturnValue(0) }

        entries = FloatTable.entries

        i = idx
        WhileLoop LessThan(i, Subtract(count, 1)) {
            src = Float_EntryPtr(Add(i, 1))
            dst = Float_EntryPtr(i)
            j = 0
            WhileLoop LessThan(j, FloatEntryConst.SIZE) {
                SetByte(dst, j, GetByte(src, j))
                j = Add(j, 1)
            }
            i = Add(i, 1)
        }

        last_ptr = Float_EntryPtr(Subtract(count, 1))
        j = 0
        WhileLoop LessThan(j, FloatEntryConst.SIZE) {
            SetByte(last_ptr, j, 0)
            j = Add(j, 1)
        }

        FloatTable.count = Add(Subtract(count, 1), 65536)
        ReturnValue(1)
    }
}

// =============================================================================
// FLOAT MOVE — update position, clamp to screen
// =============================================================================
Function.Float_Move {
    Input:  idx: Integer
    Input:  x:   Integer
    Input:  y:   Integer
    Body: {
        IfCondition Not(LessThan(idx, FloatTable.count)) ThenBlock: { ReturnValue(0) }

        ptr = Float_EntryPtr(idx)
        w   = Subtract(Dereference(Add(ptr, FloatEntryFields.W)), 65536)
        h   = Subtract(Dereference(Add(ptr, FloatEntryFields.H)), 65536)
        sw  = Subtract(Compositor.screen_w, 65536)
        sh  = Subtract(Compositor.screen_h, 65536)

        cx = x
        cy = y
        IfCondition LessThan(cx, 0)             ThenBlock: { cx = 0 }
        IfCondition LessThan(cy, 0)             ThenBlock: { cy = 0 }
        IfCondition GreaterThan(Add(cx, w), sw) ThenBlock: { cx = Subtract(sw, w) }
        IfCondition GreaterThan(Add(cy, h), sh) ThenBlock: { cy = Subtract(sh, h) }
        IfCondition LessThan(cx, 0)             ThenBlock: { cx = 0 }
        IfCondition LessThan(cy, 0)             ThenBlock: { cy = 0 }

        StoreValue(Add(ptr, FloatEntryFields.X), Add(cx, 65536))
        StoreValue(Add(ptr, FloatEntryFields.Y), Add(cy, 65536))
        ReturnValue(1)
    }
}

// =============================================================================
// FLOAT HIT TEST — find topmost float containing point (px, py)
// Returns index, or -1 if none
// =============================================================================
Function.Float_HitTest {
    Input:  px: Integer
    Input:  py: Integer
    Output: Integer
    Body: {
        count = FloatTable.count
        // Scan top-down (highest z_order = last added = topmost)
        i = Subtract(count, 1)
        WhileLoop GreaterEqual(i, 0) {
            ptr = Float_EntryPtr(i)
            fx = Subtract(Dereference(Add(ptr, FloatEntryFields.X)), 65536)
            fy = Subtract(Dereference(Add(ptr, FloatEntryFields.Y)), 65536)
            fw = Subtract(Dereference(Add(ptr, FloatEntryFields.W)), 65536)
            fh = Subtract(Dereference(Add(ptr, FloatEntryFields.H)), 65536)

            IfCondition And(
                And(GreaterEqual(px, fx), LessThan(px, Add(fx, fw))),
                And(GreaterEqual(py, fy), LessThan(py, Add(fy, fh)))
            ) ThenBlock: {
                ReturnValue(i)
            }
            i = Subtract(i, 1)
        }
        ReturnValue(-1)
    }
}

Function.Float_GetCount {
    Output: Integer
    Body: { ReturnValue(Subtract(FloatTable.count, 65536)) }
}