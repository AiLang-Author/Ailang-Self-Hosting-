//
// Library.DComposeFloat.ailang
// Floating window list — transient windows during drag / pre-snap
// All fields stored raw (no bias).

LibraryImport.Arena
LibraryImport.DComposeTypes

FixedPool.FloatTable {
    "entries":     Initialize=0
    "count":       Initialize=0
    "initialized": Initialize=0
}

SubRoutine.Float_Init {
    DebugLog_Push("fl.ini", 6)
    size = Multiply(FloatEntryConst.MAX_FLOATING, FloatEntryConst.SIZE)
    DebugLog_Push("fl.ini.a", 8)
    buf  = Allocate(size)
    DebugLog_Push("fl.ini.A", 8)
    i = 0
    WhileLoop LessThan(i, size) {
        SetByte(buf, i, 0)
        i = Add(i, 1)
    }
    FloatTable.entries     = buf
    FloatTable.count       = 0
    FloatTable.initialized = 1
}

SubRoutine.Float_Shutdown {
    DebugLog_Push("fl.shut", 7)
    IfCondition NotEqual(FloatTable.entries, 0) ThenBlock: {
        Deallocate(FloatTable.entries, Multiply(FloatEntryConst.MAX_FLOATING, FloatEntryConst.SIZE))
        FloatTable.entries = 0
    }
    FloatTable.count       = 0
    FloatTable.initialized = 0
}

Function.Float_EntryPtr {
    Input:  idx: Integer
    Output: Integer
    Body: {
        DebugLog_Push("fl.ptr", 6)
        ReturnValue(Add(FloatTable.entries, Multiply(idx, FloatEntryConst.SIZE)))
    }
}

Function.Float_Add {
    Input:  surface: Integer
    Input:  x:       Integer
    Input:  y:       Integer
    Input:  w:       Integer
    Input:  h:       Integer
    Output: Integer
    Body: {
        DebugLog_Push("fl.add", 6)
        count = FloatTable.count
        IfCondition GreaterEqual(count, FloatEntryConst.MAX_FLOATING) ThenBlock: {
            PrintMessage("[Float] ERROR: float list full\n")
            ReturnValue(-1)
        }

        sw = FB_GetWidth()
        sh = FB_GetHeight()

        cx = x
        cy = y
        IfCondition LessThan(cx, 0)             ThenBlock: { cx = 0 }
        IfCondition LessThan(cy, 0)             ThenBlock: { cy = 0 }
        IfCondition GreaterThan(Add(cx, w), sw) ThenBlock: { cx = Subtract(sw, w) }
        IfCondition GreaterThan(Add(cy, h), sh) ThenBlock: { cy = Subtract(sh, h) }
        IfCondition LessThan(cx, 0)             ThenBlock: { cx = 0 }
        IfCondition LessThan(cy, 0)             ThenBlock: { cy = 0 }

        ptr = Float_EntryPtr(count)
        StoreValue(Add(ptr, FloatEntryFields.SURFACE),  surface)
        StoreValue(Add(ptr, FloatEntryFields.X),        cx)
        StoreValue(Add(ptr, FloatEntryFields.Y),        cy)
        StoreValue(Add(ptr, FloatEntryFields.W),        w)
        StoreValue(Add(ptr, FloatEntryFields.H),        h)
        StoreValue(Add(ptr, FloatEntryFields.Z_ORDER),  count)
        StoreValue(Add(ptr, FloatEntryFields.DRAGGING), 0)

        FloatTable.count = Add(count, 1)
        ReturnValue(count)
    }
}

Function.Float_Remove {
    Input:  idx: Integer
    Output: Integer
    Body: {
        DebugLog_Push("fl.rem", 6)
        count = FloatTable.count
        IfCondition Not(LessThan(idx, count)) ThenBlock: { ReturnValue(0) }

        // Zero the entry in place — do NOT shift, do NOT decrement count
        ptr = Float_EntryPtr(idx)
        j = 0
        WhileLoop LessThan(j, FloatEntryConst.SIZE) {
            SetByte(ptr, j, 0)
            j = Add(j, 1)
        }

        ReturnValue(1)
    }
}

Function.Float_Move {
    Input:  idx: Integer
    Input:  x:   Integer
    Input:  y:   Integer
    Body: {
        DebugLog_Push("fl.mov", 6)
        IfCondition Not(LessThan(idx, FloatTable.count)) ThenBlock: { ReturnValue(0) }

        ptr = Float_EntryPtr(idx)
        w   = Dereference(Add(ptr, FloatEntryFields.W))
        h   = Dereference(Add(ptr, FloatEntryFields.H))
        sw  = FB_GetWidth()
        sh  = FB_GetHeight()

        cx = x
        cy = y
        IfCondition LessThan(cx, 0)             ThenBlock: { cx = 0 }
        IfCondition LessThan(cy, 0)             ThenBlock: { cy = 0 }
        IfCondition GreaterThan(Add(cx, w), sw) ThenBlock: { cx = Subtract(sw, w) }
        IfCondition GreaterThan(Add(cy, h), sh) ThenBlock: { cy = Subtract(sh, h) }
        IfCondition LessThan(cx, 0)             ThenBlock: { cx = 0 }
        IfCondition LessThan(cy, 0)             ThenBlock: { cy = 0 }

        StoreValue(Add(ptr, FloatEntryFields.X), cx)
        StoreValue(Add(ptr, FloatEntryFields.Y), cy)
        ReturnValue(1)
    }
}

Function.Float_HitTest {
    Input:  px: Integer
    Input:  py: Integer
    Output: Integer
    Body: {
        DebugLog_Push("fl.hit", 6)
        // Iterate z_order back-to-front (topmost first)
        zi = Subtract(WinMgr.z_count, 1)
        WhileLoop GreaterEqual(zi, 0) {
            i = WinMgr_ZGet(zi)
            IfCondition GreaterEqual(i, 0) ThenBlock: {
                ptr = Float_EntryPtr(i)
                fx = Dereference(Add(ptr, FloatEntryFields.X))
                fy = Dereference(Add(ptr, FloatEntryFields.Y))
                fw = Dereference(Add(ptr, FloatEntryFields.W))
                fh = Dereference(Add(ptr, FloatEntryFields.H))

                IfCondition And(
                    And(GreaterEqual(px, fx), LessThan(px, Add(fx, fw))),
                    And(GreaterEqual(py, fy), LessThan(py, Add(fy, fh)))
                ) ThenBlock: {
                    ReturnValue(i)
                }
            }
            zi = Subtract(zi, 1)
        }
        ReturnValue(-1)
    }
}

Function.Float_GetCount {
    Output: Integer
    Body: { DebugLog_Push("fl.cnt", 6) ReturnValue(FloatTable.count) }
}