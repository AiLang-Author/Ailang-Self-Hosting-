//
// Library.DComposeStack.ailang
// Stack group management — tabbed surface groups at BSP leaves
// Phase 4: Axis 2 — Compose
//
// Usage: LibraryImport.DComposeStack

LibraryImport.Arena
LibraryImport.DComposeTypes

// =============================================================================
// STACK GROUP CREATE
// Allocates a stack group and a surface handle array
// Returns stack group handle or 0 on failure
// =============================================================================
Function.Stack_Create {
    Input:  leaf:         Integer
    Input:  decorator_id: Integer
    Output: Integer
    Body: {
        sg = Allocate(StackGroupConst.SIZE)
        IfCondition EqualTo(sg, 0) ThenBlock: { ReturnValue(0) }

        // Zero
        i = 0
        WhileLoop LessThan(i, StackGroupConst.SIZE) {
            SetByte(sg, i, 0)
            i = Add(i, 1)
        }

        // Allocate surface handle array
        arr_size = Multiply(StackGroupConst.MAX_TABS, 8)
        surfaces = Allocate(arr_size)
        IfCondition EqualTo(surfaces, 0) ThenBlock: {
            Deallocate(sg, StackGroupConst.SIZE)
            ReturnValue(0)
        }

        // Zero array
        j = 0
        WhileLoop LessThan(j, arr_size) {
            SetByte(surfaces, j, 0)
            j = Add(j, 1)
        }

        // Allocate tab name array
        names_size = Multiply(StackGroupConst.MAX_TABS, 8)
        tab_names = Allocate(names_size)
        IfCondition EqualTo(tab_names, 0) ThenBlock: {
            Deallocate(surfaces, arr_size)
            Deallocate(sg, StackGroupConst.SIZE)
            ReturnValue(0)
        }
        k = 0
        WhileLoop LessThan(k, names_size) {
            SetByte(tab_names, k, 0)
            k = Add(k, 1)
        }

        StoreValue(Add(sg, StackGroupFields.SURFACE_COUNT), Add(0, 65536))
        StoreValue(Add(sg, StackGroupFields.SURFACES),      surfaces)
        StoreValue(Add(sg, StackGroupFields.ACTIVE_INDEX),  Add(0, 65536))
        StoreValue(Add(sg, StackGroupFields.TAB_NAMES),     tab_names)
        StoreValue(Add(sg, StackGroupFields.BSP_LEAF),      leaf)
        StoreValue(Add(sg, StackGroupFields.DECORATOR_ID),  Add(decorator_id, 65536))

        // Wire leaf back to this stack group
        IfCondition NotEqual(leaf, 0) ThenBlock: {
            StoreValue(Add(leaf, BSPNodeFields.STACK_GROUP), sg)
        }

        ReturnValue(sg)
    }
}

// =============================================================================
// STACK GROUP DESTROY
// =============================================================================
Function.Stack_Destroy {
    Input: sg: Integer
    Body: {
        IfCondition EqualTo(sg, 0) ThenBlock: { ReturnValue(0) }

        surfaces   = Dereference(Add(sg, StackGroupFields.SURFACES))
        tab_names  = Dereference(Add(sg, StackGroupFields.TAB_NAMES))
        arr_size   = Multiply(StackGroupConst.MAX_TABS, 8)

        IfCondition NotEqual(surfaces,  0) ThenBlock: { Deallocate(surfaces,  arr_size) }
        IfCondition NotEqual(tab_names, 0) ThenBlock: { Deallocate(tab_names, arr_size) }
        Deallocate(sg, StackGroupConst.SIZE)
        ReturnValue(1)
    }
}

// =============================================================================
// ACCESSORS
// =============================================================================
Function.Stack_GetCount {
    Input: sg: Integer  Output: Integer
    Body: { ReturnValue(Subtract(Dereference(Add(sg, StackGroupFields.SURFACE_COUNT)), 65536)) }
}

Function.Stack_GetActiveIndex {
    Input: sg: Integer  Output: Integer
    Body: { ReturnValue(Subtract(Dereference(Add(sg, StackGroupFields.ACTIVE_INDEX)), 65536)) }
}

Function.Stack_GetActiveSurface {
    Input:  sg: Integer
    Output: Integer
    Body: {
        idx      = Stack_GetActiveIndex(sg)
        surfaces = Dereference(Add(sg, StackGroupFields.SURFACES))
        ReturnValue(Dereference(Add(surfaces, Multiply(idx, 8))))
    }
}

Function.Stack_GetSurface {
    Input:  sg:  Integer
    Input:  idx: Integer
    Output: Integer
    Body: {
        count = Stack_GetCount(sg)
        IfCondition Not(LessThan(idx, count)) ThenBlock: { ReturnValue(0) }
        surfaces = Dereference(Add(sg, StackGroupFields.SURFACES))
        ReturnValue(Dereference(Add(surfaces, Multiply(idx, 8))))
    }
}

// =============================================================================
// STACK ADD — add a surface to the group, make it active
// Returns 1 on success, 0 if full
// =============================================================================
Function.Stack_Add {
    Input:  sg:      Integer
    Input:  surface: Integer
    Input:  name:    Integer
    Output: Integer
    Body: {
        count = Stack_GetCount(sg)
        IfCondition GreaterEqual(count, StackGroupConst.MAX_TABS) ThenBlock: {
            PrintMessage("[Stack] ERROR: group full\n")
            ReturnValue(0)
        }

        surfaces  = Dereference(Add(sg, StackGroupFields.SURFACES))
        tab_names = Dereference(Add(sg, StackGroupFields.TAB_NAMES))

        // Store surface handle at index count
        StoreValue(Add(surfaces,  Multiply(count, 8)), surface)
        StoreValue(Add(tab_names, Multiply(count, 8)), name)

        // New count
        StoreValue(Add(sg, StackGroupFields.SURFACE_COUNT), Add(Add(count, 1), 65536))

        // Make new surface active
        StoreValue(Add(sg, StackGroupFields.ACTIVE_INDEX), Add(count, 65536))

        ReturnValue(1)
    }
}

// =============================================================================
// STACK REMOVE — remove surface at idx, compact array
// =============================================================================
Function.Stack_Remove {
    Input:  sg:  Integer
    Input:  idx: Integer
    Output: Integer
    Body: {
        count = Stack_GetCount(sg)
        IfCondition EqualTo(count, 0)               ThenBlock: { ReturnValue(0) }
        IfCondition Not(LessThan(idx, count))        ThenBlock: { ReturnValue(0) }

        surfaces  = Dereference(Add(sg, StackGroupFields.SURFACES))
        tab_names = Dereference(Add(sg, StackGroupFields.TAB_NAMES))

        // Shift entries down
        i = idx
        WhileLoop LessThan(i, Subtract(count, 1)) {
            next = Add(i, 1)
            s = Dereference(Add(surfaces,  Multiply(next, 8)))
            n = Dereference(Add(tab_names, Multiply(next, 8)))
            StoreValue(Add(surfaces,  Multiply(i, 8)), s)
            StoreValue(Add(tab_names, Multiply(i, 8)), n)
            i = Add(i, 1)
        }

        // Zero last slot
        last = Subtract(count, 1)
        StoreValue(Add(surfaces,  Multiply(last, 8)), 0)
        StoreValue(Add(tab_names, Multiply(last, 8)), 0)

        new_count = Subtract(count, 1)
        StoreValue(Add(sg, StackGroupFields.SURFACE_COUNT), Add(new_count, 65536))

        // Fix active index if needed
        active = Stack_GetActiveIndex(sg)
        IfCondition GreaterEqual(active, new_count) ThenBlock: {
            IfCondition GreaterThan(new_count, 0) ThenBlock: {
                StoreValue(Add(sg, StackGroupFields.ACTIVE_INDEX), Add(Subtract(new_count, 1), 65536))
            } ElseBlock: {
                StoreValue(Add(sg, StackGroupFields.ACTIVE_INDEX), Add(0, 65536))
            }
        }

        ReturnValue(1)
    }
}

// =============================================================================
// STACK SWITCH — change active tab
// =============================================================================
Function.Stack_Switch {
    Input:  sg:  Integer
    Input:  idx: Integer
    Output: Integer
    Body: {
        count = Stack_GetCount(sg)
        IfCondition Not(LessThan(idx, count)) ThenBlock: { ReturnValue(0) }
        StoreValue(Add(sg, StackGroupFields.ACTIVE_INDEX), Add(idx, 65536))
        ReturnValue(1)
    }
}