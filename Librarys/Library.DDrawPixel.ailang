//
// Library.DDrawPixel.ailang
// Draw primitives for PIXEL_32 surfaces
// Axis 1: Draw — pixel operations
//
// Color format: BGRA 32-bit (matches /dev/fb0 native format)
// Use FB_RGB(r, g, b) from Library.Framebuffer to build colors.
//
// Usage: LibraryImport.DDrawPixel

LibraryImport.DSurfaceTypes
LibraryImport.DSurface

// =============================================================================
// INTERNAL: write one pixel — no bounds check
// =============================================================================
Function.DPix_PutPixel {
    Input: surf:  Integer
    Input: x:     Integer
    Input: y:     Integer
    Input: color: Integer
    Body: {
        ptr = Surface_PixelAt(surf, x, y)
        // Write BGRA 32-bit little-endian
        SetByte(ptr, 0, BitwiseAnd(color, 255))
        SetByte(ptr, 1, BitwiseAnd(ShiftRight(color, 8),  255))
        SetByte(ptr, 2, BitwiseAnd(ShiftRight(color, 16), 255))
        SetByte(ptr, 3, BitwiseAnd(ShiftRight(color, 24), 255))
    }
}

// =============================================================================
// DRAW_PIX_FILLRECT
// Fill a rectangle with a solid color
// =============================================================================
Function.Draw_Pix_FillRect {
    Input: surf:  Integer
    Input: x:     Integer
    Input: y:     Integer
    Input: w:     Integer
    Input: h:     Integer
    Input: color: Integer
    Body: {
        sw = Surface_GetWidth(surf)
        sh = Surface_GetHeight(surf)

        x0 = x
        y0 = y
        x1 = Add(x, w)
        y1 = Add(y, h)

        IfCondition LessThan(x0, 0)     ThenBlock: { x0 = 0 }
        IfCondition LessThan(y0, 0)     ThenBlock: { y0 = 0 }
        IfCondition GreaterThan(x1, sw)  ThenBlock: { x1 = sw }
        IfCondition GreaterThan(y1, sh)  ThenBlock: { y1 = sh }

        IfCondition Not(LessThan(x0, x1)) ThenBlock: { ReturnValue(0) }
        IfCondition Not(LessThan(y0, y1)) ThenBlock: { ReturnValue(0) }

        row = y0
        WhileLoop LessThan(row, y1) {
            col = x0
            WhileLoop LessThan(col, x1) {
                DPix_PutPixel(surf, col, row, color)
                col = Add(col, 1)
            }
            row = Add(row, 1)
        }
    }
}

// =============================================================================
// DRAW_PIX_RECT
// Draw a rectangle outline
// =============================================================================
Function.Draw_Pix_Rect {
    Input: surf:  Integer
    Input: x:     Integer
    Input: y:     Integer
    Input: w:     Integer
    Input: h:     Integer
    Input: color: Integer
    Body: {
        IfCondition LessThan(w, 2) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(h, 2) ThenBlock: { ReturnValue(0) }

        x1 = Subtract(Add(x, w), 1)
        y1 = Subtract(Add(y, h), 1)

        // Top and bottom
        col = x
        WhileLoop LessEqual(col, x1) {
            IfCondition EqualTo(Surface_InBounds(surf, col, y),  1) ThenBlock: { DPix_PutPixel(surf, col, y,  color) }
            IfCondition EqualTo(Surface_InBounds(surf, col, y1), 1) ThenBlock: { DPix_PutPixel(surf, col, y1, color) }
            col = Add(col, 1)
        }

        // Left and right
        row = Add(y, 1)
        WhileLoop LessThan(row, y1) {
            IfCondition EqualTo(Surface_InBounds(surf, x,  row), 1) ThenBlock: { DPix_PutPixel(surf, x,  row, color) }
            IfCondition EqualTo(Surface_InBounds(surf, x1, row), 1) ThenBlock: { DPix_PutPixel(surf, x1, row, color) }
            row = Add(row, 1)
        }
    }
}

// =============================================================================
// DRAW_PIX_HLINE / DRAW_PIX_VLINE
// =============================================================================
Function.Draw_Pix_HLine {
    Input: surf:  Integer
    Input: x:     Integer
    Input: y:     Integer
    Input: len:   Integer
    Input: color: Integer
    Body: {
        i = 0
        WhileLoop LessThan(i, len) {
            cx = Add(x, i)
            IfCondition EqualTo(Surface_InBounds(surf, cx, y), 1) ThenBlock: {
                DPix_PutPixel(surf, cx, y, color)
            }
            i = Add(i, 1)
        }
    }
}

Function.Draw_Pix_VLine {
    Input: surf:  Integer
    Input: x:     Integer
    Input: y:     Integer
    Input: len:   Integer
    Input: color: Integer
    Body: {
        i = 0
        WhileLoop LessThan(i, len) {
            cy = Add(y, i)
            IfCondition EqualTo(Surface_InBounds(surf, x, cy), 1) ThenBlock: {
                DPix_PutPixel(surf, x, cy, color)
            }
            i = Add(i, 1)
        }
    }
}

// =============================================================================
// DRAW_PIX_PIXEL — single pixel, bounds checked
// =============================================================================
Function.Draw_Pix_Pixel {
    Input: surf:  Integer
    Input: x:     Integer
    Input: y:     Integer
    Input: color: Integer
    Body: {
        IfCondition EqualTo(Surface_InBounds(surf, x, y), 1) ThenBlock: {
            DPix_PutPixel(surf, x, y, color)
        }
    }
}