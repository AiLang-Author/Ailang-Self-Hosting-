//
// Library.DInputEvdev.ailang
// Evdev input backend — reads /dev/input/eventX for keyboard + mouse
// Phase 6: non-blocking O_NONBLOCK reads, posts to Ring1

LibraryImport.DInputTypes
LibraryImport.DRingTypes
LibraryImport.DRing1

FixedPool.EvdevSys {
    "SYS_OPEN":   Initialize=2
    "SYS_READ":   Initialize=0
    "SYS_CLOSE":  Initialize=3
    "O_RDONLY":   Initialize=0
    "O_NONBLOCK": Initialize=2048
}

// =============================================================================
// OPEN A DEVICE
// =============================================================================
Function.Evdev_OpenDevice {
    Input:  path:     Address
    Input:  dev_type: Integer
    Output: Integer
    Body: {
        flags = Add(EvdevSys.O_RDONLY, EvdevSys.O_NONBLOCK)
        fd    = SystemCall(EvdevSys.SYS_OPEN, path, flags, 0)
        IfCondition LessThan(fd, 0) ThenBlock: {
            PrintMessage("[Evdev] ERROR: cannot open ")
            PrintString(path)
            PrintMessage("\n")
            ReturnValue(-1)
        }

        IfCondition EqualTo(InputDevTable.initialized, 0) ThenBlock: {
            tbl_ptr = Allocate(Multiply(InputDevConst.MAX_DEVICES, InputDevConst.RECORD_SIZE))
            InputDevTable.table       = tbl_ptr
            InputDevTable.count       = 0
            InputDevTable.initialized = 1
        }

        count = InputDevTable.count
        IfCondition GreaterEqual(count, InputDevConst.MAX_DEVICES) ThenBlock: {
            PrintMessage("[Evdev] ERROR: device table full\n")
            SystemCall(EvdevSys.SYS_CLOSE, fd, 0, 0)
            ReturnValue(-1)
        }

        tbl    = InputDevTable.table
        offset = Multiply(count, InputDevConst.RECORD_SIZE)
        StoreValue(Add(tbl, offset),         fd)
        StoreValue(Add(tbl, Add(offset, 8)), dev_type)
        InputDevTable.count = Add(count, 1)

        PrintMessage("[Evdev] Opened ")
        PrintString(path)
        PrintMessage(" fd=")
        PrintNumber(fd)
        PrintMessage("\n")
        ReturnValue(fd)
    }
}


// =============================================================================
// CLOSE ALL DEVICES
// =============================================================================
Function.Evdev_CloseAll {
    Output: Integer
    Body: {
        IfCondition EqualTo(InputDevTable.initialized, 0) ThenBlock: {
            ReturnValue(0)
        }
        count = InputDevTable.count
        tbl   = InputDevTable.table
        i = 0
        WhileLoop LessThan(i, count) {
            offset = Multiply(i, InputDevConst.RECORD_SIZE)
            fd     = Dereference(Add(tbl, offset))
            IfCondition GreaterThan(fd, 0) ThenBlock: {
                SystemCall(EvdevSys.SYS_CLOSE, fd, 0, 0)
            }
            i = Add(i, 1)
        }
        Deallocate(tbl, Multiply(InputDevConst.MAX_DEVICES, InputDevConst.RECORD_SIZE))
        InputDevTable.initialized = 0
        InputDevTable.count       = 0
        InputDevTable.table       = 0
        ReturnValue(1)
    }
}

// =============================================================================
// READ ONE EVENT — returns 1 if full event read, 0 if no data (EAGAIN)
// =============================================================================
Function.Evdev_ReadOne {
    Input:  fd:  Integer
    Input:  buf: Address
    Output: Integer
    Body: {
        n = SystemCall(EvdevSys.SYS_READ, fd, buf, EvdevEvent.SIZE)
        IfCondition EqualTo(n, EvdevEvent.SIZE) ThenBlock: {
            ReturnValue(1)
        }
        ReturnValue(0)
    }
}

// =============================================================================
// READ 16-BIT LITTLE-ENDIAN
// =============================================================================
Function.Evdev_Read16 {
    Input:  buf: Address
    Input:  off: Integer
    Output: Integer
    Body: {
        lo = GetByte(buf, off)
        hi = GetByte(buf, Add(off, 1))
        ReturnValue(Add(lo, Multiply(hi, 256)))
    }
}

// =============================================================================
// READ 32-BIT LITTLE-ENDIAN
// =============================================================================
Function.Evdev_Read32 {
    Input:  buf: Address
    Input:  off: Integer
    Output: Integer
    Body: {
        b0 = GetByte(buf, off)
        b1 = GetByte(buf, Add(off, 1))
        b2 = GetByte(buf, Add(off, 2))
        b3 = GetByte(buf, Add(off, 3))
        ReturnValue(Add(Add(Add(b0,
                    Multiply(b1, 256)),
                    Multiply(b2, 65536)),
                    Multiply(b3, 16777216)))
    }
}

// =============================================================================
// SIGN-EXTEND 32-BIT
// =============================================================================
Function.Evdev_SignExtend32 {
    Input:  v: Integer
    Output: Integer
    Body: {
        IfCondition GreaterEqual(v, 2147483648) ThenBlock: {
            ReturnValue(Subtract(v, 4294967296))
        }
        ReturnValue(v)
    }
}

// =============================================================================
// PROCESS EV_KEY — keyboard keys and mouse buttons
// Mouse buttons: BTN_LEFT=272, BTN_RIGHT=273, BTN_MIDDLE=274
// bit manipulation via multiply/divide (no LeftShift/BitwiseNot needed)
// btn_idx 0=left 1=right 2=middle → bit value = 2^idx = 1,2,4
// =============================================================================
Function.Evdev_BtnBit {
    Input:  btn_idx: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(btn_idx, 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(btn_idx, 1) ThenBlock: { ReturnValue(2) }
        ReturnValue(4)
    }
}

Function.Evdev_HandleKey {
    Input:  ev_code:  Integer
    Input:  ev_value: Integer
    Output: Integer
    Body: {
        // Mouse buttons 272-274
        is_btn = 0
        IfCondition GreaterEqual(ev_code, 272) ThenBlock: {
            IfCondition LessEqual(ev_code, 274) ThenBlock: {
                is_btn = 1
            }
        }
        IfCondition EqualTo(is_btn, 1) ThenBlock: {
            btn_idx = Subtract(ev_code, 272)
            bit     = Evdev_BtnBit(btn_idx)
            IfCondition EqualTo(ev_value, EvVal.PRESS) ThenBlock: {
                MouseState.buttons = BitwiseOr(MouseState.buttons, bit)
                Ring1_Post(Ring1Event.MOUSE_DOWN, MouseState.x, MouseState.y, btn_idx)
            }
            IfCondition EqualTo(ev_value, EvVal.RELEASE) ThenBlock: {
                // Clear bit: buttons AND (255 XOR bit) for 3-bit mask
                cleared = BitwiseAnd(MouseState.buttons, BitwiseXor(7, bit))
                MouseState.buttons = cleared
                Ring1_Post(Ring1Event.MOUSE_UP, MouseState.x, MouseState.y, btn_idx)
            }
            ReturnValue(1)
        }

        // Modifier tracking
        IfCondition EqualTo(ev_code, Key.LEFTSHIFT)  ThenBlock: { IfCondition EqualTo(ev_value, EvVal.PRESS) ThenBlock: { KeyMod.shift = 1 } IfCondition EqualTo(ev_value, EvVal.RELEASE) ThenBlock: { KeyMod.shift = 0 } }
        IfCondition EqualTo(ev_code, Key.RIGHTSHIFT) ThenBlock: { IfCondition EqualTo(ev_value, EvVal.PRESS) ThenBlock: { KeyMod.shift = 1 } IfCondition EqualTo(ev_value, EvVal.RELEASE) ThenBlock: { KeyMod.shift = 0 } }
        IfCondition EqualTo(ev_code, Key.LEFTCTRL)   ThenBlock: { IfCondition EqualTo(ev_value, EvVal.PRESS) ThenBlock: { KeyMod.ctrl  = 1 } IfCondition EqualTo(ev_value, EvVal.RELEASE) ThenBlock: { KeyMod.ctrl  = 0 } }
        IfCondition EqualTo(ev_code, Key.RIGHTCTRL)  ThenBlock: { IfCondition EqualTo(ev_value, EvVal.PRESS) ThenBlock: { KeyMod.ctrl  = 1 } IfCondition EqualTo(ev_value, EvVal.RELEASE) ThenBlock: { KeyMod.ctrl  = 0 } }
        IfCondition EqualTo(ev_code, Key.LEFTALT)    ThenBlock: { IfCondition EqualTo(ev_value, EvVal.PRESS) ThenBlock: { KeyMod.alt   = 1 } IfCondition EqualTo(ev_value, EvVal.RELEASE) ThenBlock: { KeyMod.alt   = 0 } }
        IfCondition EqualTo(ev_code, Key.RIGHTALT)   ThenBlock: { IfCondition EqualTo(ev_value, EvVal.PRESS) ThenBlock: { KeyMod.alt   = 1 } IfCondition EqualTo(ev_value, EvVal.RELEASE) ThenBlock: { KeyMod.alt   = 0 } }

        mods = Add(Add(KeyMod.shift, Multiply(KeyMod.ctrl, 2)), Multiply(KeyMod.alt, 4))

        IfCondition EqualTo(ev_value, EvVal.PRESS)   ThenBlock: {
            PrintMessage("[EvKey] DOWN sc=")
            PrintNumber(ev_code)
            PrintMessage("\n")
            Ring1_Post(Ring1Event.KEY_DOWN, ev_code, mods, 0) ReturnValue(1)
        }
        IfCondition EqualTo(ev_value, EvVal.RELEASE) ThenBlock: { Ring1_Post(Ring1Event.KEY_UP,   ev_code, mods, 0) ReturnValue(1) }
        IfCondition EqualTo(ev_value, EvVal.REPEAT)  ThenBlock: { Ring1_Post(Ring1Event.KEY_DOWN, ev_code, mods, 1) ReturnValue(1) }
        ReturnValue(0)
    }
}

// =============================================================================
// PROCESS EV_REL — mouse relative movement
// =============================================================================
Function.Evdev_HandleRel {
    Input:  ev_code:  Integer
    Input:  ev_value: Integer
    Output: Integer
    Body: {
        delta = Evdev_SignExtend32(ev_value)

        IfCondition EqualTo(ev_code, RelAxis.X) ThenBlock: {
            new_x = Add(MouseState.x, delta)
            IfCondition LessThan(new_x, MouseState.min_x) ThenBlock: { new_x = MouseState.min_x }
            IfCondition GreaterThan(new_x, MouseState.max_x) ThenBlock: { new_x = MouseState.max_x }
            MouseState.x = new_x
            ReturnValue(1)
        }
        IfCondition EqualTo(ev_code, RelAxis.Y) ThenBlock: {
            new_y = Add(MouseState.y, delta)
            IfCondition LessThan(new_y, MouseState.min_y) ThenBlock: { new_y = MouseState.min_y }
            IfCondition GreaterThan(new_y, MouseState.max_y) ThenBlock: { new_y = MouseState.max_y }
            MouseState.y = new_y
            Ring1_Post(Ring1Event.MOUSE_MOVE, MouseState.x, MouseState.y, MouseState.buttons)
            ReturnValue(1)
        }
        IfCondition EqualTo(ev_code, RelAxis.WHEEL) ThenBlock: {
            Ring1_Post(Ring1Event.MOUSE_WHEEL, MouseState.x, MouseState.y, delta)
            ReturnValue(1)
        }
        ReturnValue(0)
    }
}

// =============================================================================
// PROCESS ONE EVENT
// =============================================================================
Function.Evdev_ProcessEvent {
    Input:  buf:      Address
    Input:  dev_type: Integer
    Output: Integer
    Body: {
        ev_type  = Evdev_Read16(buf, EvdevEvent.TYPE)
        ev_code  = Evdev_Read16(buf, EvdevEvent.CODE)
        ev_value = Evdev_Read32(buf, EvdevEvent.VALUE)

        IfCondition EqualTo(ev_type, EvType.KEY) ThenBlock: {
            ReturnValue(Evdev_HandleKey(ev_code, ev_value))
        }
        IfCondition EqualTo(ev_type, EvType.REL) ThenBlock: {
            ReturnValue(Evdev_HandleRel(ev_code, ev_value))
        }
        ReturnValue(0)
    }
}

// =============================================================================
// POLL ALL OPEN DEVICES
// Function (not SubRoutine) — SubRoutine call sites crash with many locals
// =============================================================================
Function.Evdev_Poll {
    Output: Integer
    Body: {
        IfCondition EqualTo(InputDevTable.initialized, 0) ThenBlock: {
            ReturnValue(0)
        }

        count = InputDevTable.count
        tbl   = InputDevTable.table
        buf   = Allocate(EvdevEvent.SIZE)

        i = 0
        WhileLoop LessThan(i, count) {
            offset = Multiply(i, InputDevConst.RECORD_SIZE)
            fd     = Dereference(Add(tbl, offset))

            got = Evdev_ReadOne(fd, buf)
            WhileLoop EqualTo(got, 1) {
                Evdev_ProcessEvent(buf, 0)
                got = Evdev_ReadOne(fd, buf)
            }

            i = Add(i, 1)
        }

        Deallocate(buf, EvdevEvent.SIZE)
        ReturnValue(1)
    }
}

// =============================================================================
// INIT MOUSE BOUNDS
// =============================================================================
Function.Evdev_SetMouseBounds {
    Input:  max_x: Integer
    Input:  max_y: Integer
    Output: Integer
    Body: {
        MouseState.min_x   = 0
        MouseState.min_y   = 0
        MouseState.max_x   = max_x
        MouseState.max_y   = max_y
        MouseState.x       = Divide(max_x, 2)
        MouseState.y       = Divide(max_y, 2)
        MouseState.buttons = 0
        ReturnValue(1)
    }
}