// Mouse button codes (BTN_*)
FixedPool.Btn {
    "LEFT":   Initialize=272
    "RIGHT":  Initialize=273
    "MIDDLE": Initialize=274
}

// =============================================================================
// INPUT DEVICE STATE — one record per open device fd
// Max 8 devices (2 should be enough: keyboard + mouse)
// =============================================================================
FixedPool.InputDevConst {
    "MAX_DEVICES": Initialize=8
    "RECORD_SIZE": Initialize=16   // fd(8) + type(8)
}

FixedPool.InputDevType {
    "NONE":     Initialize=0
    "KEYBOARD": Initialize=1
    "MOUSE":    Initialize=2
}

// Device table — flat array, 8 slots × 16 bytes
// [0] fd, [8] type
FixedPool.InputDevTable {
    "initialized": Initialize=0
    "table":       Initialize=0    // pointer to Allocate(8*16)
    "count":       Initialize=0
}

// =============================================================================
// MOUSE STATE — accumulated position + buttons
// =============================================================================
FixedPool.MouseState {
    "x":       Initialize=0
    "y":       Initialize=0
    "buttons": Initialize=0    // bitmask: bit0=left bit1=right bit2=middle
    "min_x":   Initialize=0
    "min_y":   Initialize=0
    "max_x":   Initialize=0
    "max_y":   Initialize=0
}

// =============================================================================
// MODIFIER KEY STATE
// =============================================================================
FixedPool.KeyMod {
    "shift":   Initialize=0
    "ctrl":    Initialize=0
    "alt":     Initialize=0
    "caps":    Initialize=0
}