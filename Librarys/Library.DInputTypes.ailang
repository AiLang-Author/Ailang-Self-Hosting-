    "K":          Initialize=37
    "L":          Initialize=38
    "ENTER":      Initialize=28
    "LEFTSHIFT":  Initialize=42
    "RIGHTSHIFT": Initialize=54
    "LEFTCTRL":   Initialize=29
    "RIGHTCTRL":  Initialize=97
    "LEFTALT":    Initialize=56
    "RIGHTALT":   Initialize=100
    "SPACE":      Initialize=57
    "CAPSLOCK":   Initialize=58
