    "F4":         Initialize=62
    "F5":         Initialize=63
    "F6":         Initialize=64
    "F7":         Initialize=65
    "F8":         Initialize=66
    "F9":         Initialize=67
    "F10":        Initialize=68
    "F11":        Initialize=87
    "F12":        Initialize=88
    "UP":         Initialize=103
    "LEFT":       Initialize=105
    "RIGHT":      Initialize=106
    "DOWN":       Initialize=108
    "PAGEUP":     Initialize=104
    "PAGEDOWN":   Initialize=109
