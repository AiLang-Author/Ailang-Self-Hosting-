//
// Library.DInputTypes.ailang
// Input system type constants — evdev structs, key codes, mouse state
// Phase 6: Keyboard + mouse via /dev/input/eventX

// =============================================================================
// LINUX INPUT EVENT STRUCT — 24 bytes
// struct input_event {
//   struct timeval time;   // 16 bytes (tv_sec 8 + tv_usec 8)
//   __u16 type;            // 2 bytes
//   __u16 code;            // 2 bytes
//   __s32 value;           // 4 bytes
// }
// Total: 24 bytes
// =============================================================================
FixedPool.EvdevEvent {
    "SIZE":    Initialize=24
    "TV_SEC":  Initialize=0    // timeval seconds (8 bytes, read as 64-bit)
    "TV_USEC": Initialize=8    // timeval microseconds
    "TYPE":    Initialize=16   // event type (2 bytes, read as 16-bit)
    "CODE":    Initialize=18   // event code (2 bytes)
    "VALUE":   Initialize=20   // event value (4 bytes, signed)
}

// Linux input event types
FixedPool.EvType {
    "SYN":       Initialize=0
    "KEY":       Initialize=1   // keyboard + mouse buttons
    "REL":       Initialize=2   // relative movement (mouse)
    "ABS":       Initialize=3   // absolute position (touchpad)
    "MSC":       Initialize=4
}

// Relative axes (EV_REL codes)
FixedPool.RelAxis {
    "X":     Initialize=0
    "Y":     Initialize=1
    "WHEEL": Initialize=8
}

// Key/button values
FixedPool.EvVal {
    "RELEASE": Initialize=0
    "PRESS":   Initialize=1
    "REPEAT":  Initialize=2
}

// Common Linux key codes (KEY_*)
FixedPool.Key {
    "ESC":        Initialize=1
    "1":          Initialize=2
