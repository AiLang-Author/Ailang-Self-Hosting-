//
// Library.DRenderTerm.ailang
// Terminal render backend — flushes a CELL_32 surface to stdout via ANSI escapes

LibraryImport.TUI
LibraryImport.DSurfaceTypes
LibraryImport.DSurface

// =============================================================================
// RENDER STATE
// =============================================================================
FixedPool.RenderTerm {
    "last_fg":     Initialize=255
    "last_bg":     Initialize=255
    "last_attr":   Initialize=0
    "initialized": Initialize=0
}

// =============================================================================
// INIT / SHUTDOWN
// =============================================================================
SubRoutine.RenderTerm_Init {
    TUI_Init()
    RenderTerm.last_fg     = 255
    RenderTerm.last_bg     = 255
    RenderTerm.last_attr   = 0
    RenderTerm.initialized = 1
}

SubRoutine.RenderTerm_Shutdown {
    TUI_Shutdown()
    RenderTerm.initialized = 0
}

// =============================================================================
// FLUSH — write entire CELL_32 surface to terminal
// =============================================================================
Function.RenderTerm_Flush {
    Input: surf: Integer
    Body: {
        IfCondition EqualTo(surf, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(Surface_GetFormat(surf), SurfaceFormat.CELL_32) ThenBlock: {
            PrintMessage("[RenderTerm] ERROR: surface is not CELL_32\n")
            ReturnValue(0)
        }

        w = Surface_GetWidth(surf)
        h = Surface_GetHeight(surf)

        TUI_Home()
        RenderTerm_ResetAttrs()

        y = 0
        WhileLoop LessThan(y, h) {
            TUI_MoveTo(Add(y, 1), 1)
            x = 0
            WhileLoop LessThan(x, w) {
                cell = Surface_CellAt(surf, x, y)
                ch   = GetByte(cell, CellOffset.CHAR)
                fg   = GetByte(cell, CellOffset.FG)
                bg   = GetByte(cell, CellOffset.BG)
                attr = GetByte(cell, CellOffset.ATTR)

                IfCondition NotEqual(attr, RenderTerm.last_attr) ThenBlock: {
                    RenderTerm_EmitAttr(attr)
                    RenderTerm.last_attr = attr
                    RenderTerm.last_fg   = 255
                    RenderTerm.last_bg   = 255
                }
                IfCondition NotEqual(fg, RenderTerm.last_fg) ThenBlock: {
                    RenderTerm_EmitFg(fg)
                    RenderTerm.last_fg = fg
                }
                IfCondition NotEqual(bg, RenderTerm.last_bg) ThenBlock: {
                    RenderTerm_EmitBg(bg)
                    RenderTerm.last_bg = bg
                }
                IfCondition EqualTo(ch, 0) ThenBlock: {
                    TUI_BufferChar(32)
                } ElseBlock: {
                    TUI_BufferChar(ch)
                }
                x = Add(x, 1)
            }
            y = Add(y, 1)
        }
        TUI_Flush()
    }
}

// =============================================================================
// PARTIAL FLUSH — dirty rectangle only
// =============================================================================
Function.RenderTerm_FlushRect {
    Input: surf: Integer
    Input: rx:   Integer
    Input: ry:   Integer
    Input: rw:   Integer
    Input: rh:   Integer
    Body: {
        IfCondition EqualTo(surf, 0) ThenBlock: { ReturnValue(0) }

        w = Surface_GetWidth(surf)
        h = Surface_GetHeight(surf)

        x0 = rx
        y0 = ry
        x1 = Add(rx, rw)
        y1 = Add(ry, rh)

        IfCondition LessThan(x0, 0)    ThenBlock: { x0 = 0 }
        IfCondition LessThan(y0, 0)    ThenBlock: { y0 = 0 }
        IfCondition GreaterThan(x1, w) ThenBlock: { x1 = w }
        IfCondition GreaterThan(y1, h) ThenBlock: { y1 = h }

        IfCondition Not(LessThan(x0, x1)) ThenBlock: { ReturnValue(0) }
        IfCondition Not(LessThan(y0, y1)) ThenBlock: { ReturnValue(0) }

        y = y0
        WhileLoop LessThan(y, y1) {
            TUI_MoveTo(Add(y, 1), Add(x0, 1))
            x = x0
            WhileLoop LessThan(x, x1) {
                cell = Surface_CellAt(surf, x, y)
                ch   = GetByte(cell, CellOffset.CHAR)
                fg   = GetByte(cell, CellOffset.FG)
                bg   = GetByte(cell, CellOffset.BG)
                attr = GetByte(cell, CellOffset.ATTR)

                IfCondition NotEqual(attr, RenderTerm.last_attr) ThenBlock: {
                    RenderTerm_EmitAttr(attr)
                    RenderTerm.last_attr = attr
                    RenderTerm.last_fg   = 255
                    RenderTerm.last_bg   = 255
                }
                IfCondition NotEqual(fg, RenderTerm.last_fg) ThenBlock: {
                    RenderTerm_EmitFg(fg)
                    RenderTerm.last_fg = fg
                }
                IfCondition NotEqual(bg, RenderTerm.last_bg) ThenBlock: {
                    RenderTerm_EmitBg(bg)
                    RenderTerm.last_bg = bg
                }
                IfCondition EqualTo(ch, 0) ThenBlock: {
                    TUI_BufferChar(32)
                } ElseBlock: {
                    TUI_BufferChar(ch)
                }
                x = Add(x, 1)
            }
            y = Add(y, 1)
        }
        TUI_Flush()
    }
}

// =============================================================================
// ANSI ESCAPE EMITTERS
// =============================================================================

SubRoutine.RenderTerm_ResetAttrs {
    TUI_BufferChar(27)
    TUI_BufferWriteStr("[0m")
    RenderTerm.last_fg   = 255
    RenderTerm.last_bg   = 255
    RenderTerm.last_attr = 0
}

Function.RenderTerm_EmitAttr {
    Input: attr: Integer
    Body: {
        TUI_BufferChar(27)
        TUI_BufferWriteStr("[0")
        IfCondition NotEqual(BitwiseAnd(attr, CellAttr.BOLD), 0) ThenBlock: {
            TUI_BufferWriteStr(";1")
        }
        IfCondition NotEqual(BitwiseAnd(attr, CellAttr.UNDERLINE), 0) ThenBlock: {
            TUI_BufferWriteStr(";4")
        }
        IfCondition NotEqual(BitwiseAnd(attr, CellAttr.REVERSE), 0) ThenBlock: {
            TUI_BufferWriteStr(";7")
        }
        IfCondition NotEqual(BitwiseAnd(attr, CellAttr.BLINK), 0) ThenBlock: {
            TUI_BufferWriteStr(";5")
        }
        TUI_BufferChar(109)
    }
}

Function.RenderTerm_EmitFg {
    Input: fg: Integer
    Body: {
        TUI_BufferChar(27)
        TUI_BufferChar(91)
        IfCondition EqualTo(fg, Color16.DEFAULT) ThenBlock: {
            TUI_BufferWriteStr("39m")
            ReturnValue(0)
        }
        IfCondition LessThan(fg, 8) ThenBlock: {
            TUI_BufferChar(51)
            TUI_BufferChar(Add(48, fg))
            TUI_BufferChar(109)
            ReturnValue(0)
        }
        TUI_BufferChar(57)
        TUI_BufferChar(Add(48, Subtract(fg, 8)))
        TUI_BufferChar(109)
    }
}

Function.RenderTerm_EmitBg {
    Input: bg: Integer
    Body: {
        TUI_BufferChar(27)
        TUI_BufferChar(91)
        IfCondition EqualTo(bg, Color16.DEFAULT) ThenBlock: {
            TUI_BufferWriteStr("49m")
            ReturnValue(0)
        }
        IfCondition LessThan(bg, 8) ThenBlock: {
            TUI_BufferChar(52)
            TUI_BufferChar(Add(48, bg))
            TUI_BufferChar(109)
            ReturnValue(0)
        }
        TUI_BufferWriteStr("10")
        TUI_BufferChar(Add(48, Subtract(bg, 8)))
        TUI_BufferChar(109)
    }
}