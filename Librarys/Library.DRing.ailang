//
// Library.DRing.ailang
// Ring buffer create/destroy/post/drain
// Phase 3: Four-ring event architecture
//
// Usage: LibraryImport.DRing

LibraryImport.Arena
LibraryImport.DRingTypes

// =============================================================================
// RING CREATE
// Allocates header + entry buffer
// capacity must be power of 2
// Returns ring handle (pointer to header), or 0 on failure
// =============================================================================
Function.Ring_Create {
    Input:  capacity:   Integer
    Input:  entry_size: Integer
    Output: Integer
    Body: {
        IfCondition LessEqual(capacity, 0)   ThenBlock: { ReturnValue(0) }
        IfCondition LessEqual(entry_size, 0) ThenBlock: { ReturnValue(0) }

        hdr = Allocate(RingConst.HEADER_SIZE)
        IfCondition EqualTo(hdr, 0) ThenBlock: { ReturnValue(0) }

        buf_size = Multiply(capacity, entry_size)
        buf = Allocate(buf_size)
        IfCondition EqualTo(buf, 0) ThenBlock: {
            Deallocate(hdr, RingConst.HEADER_SIZE)
            ReturnValue(0)
        }

        // Zero the buffer
        i = 0
        WhileLoop LessThan(i, buf_size) {
            SetByte(buf, i, 0)
            i = Add(i, 1)
        }

        StoreValue(Add(hdr, RingFields.BUFFER),     buf)
        StoreValue(Add(hdr, RingFields.HEAD),        Add(0, 65536))
        StoreValue(Add(hdr, RingFields.TAIL),        Add(0, 65536))
        StoreValue(Add(hdr, RingFields.CAPACITY),    Add(capacity,   65536))
        StoreValue(Add(hdr, RingFields.COUNT),       Add(0, 65536))
        StoreValue(Add(hdr, RingFields.ENTRY_SIZE),  Add(entry_size, 65536))

        ReturnValue(hdr)
    }
}

// =============================================================================
// RING DESTROY
// =============================================================================
Function.Ring_Destroy {
    Input: ring: Integer
    Body: {
        IfCondition EqualTo(ring, 0) ThenBlock: { ReturnValue(0) }

        buf        = Dereference(Add(ring, RingFields.BUFFER))
        capacity   = Subtract(Dereference(Add(ring, RingFields.CAPACITY)),   65536)
        entry_size = Subtract(Dereference(Add(ring, RingFields.ENTRY_SIZE)), 65536)

        IfCondition NotEqual(buf, 0) ThenBlock: {
            Deallocate(buf, Multiply(capacity, entry_size))
        }
        Deallocate(ring, RingConst.HEADER_SIZE)
        ReturnValue(1)
    }
}

// =============================================================================
// RING ACCESSORS — subtract 65536 bias on read
// =============================================================================
Function.Ring_GetHead {
    Input:  ring: Integer
    Output: Integer
    Body: { ReturnValue(Subtract(Dereference(Add(ring, RingFields.HEAD)),       65536)) }
}

Function.Ring_GetTail {
    Input:  ring: Integer
    Output: Integer
    Body: { ReturnValue(Subtract(Dereference(Add(ring, RingFields.TAIL)),       65536)) }
}

Function.Ring_GetCapacity {
    Input:  ring: Integer
    Output: Integer
    Body: { ReturnValue(Subtract(Dereference(Add(ring, RingFields.CAPACITY)),   65536)) }
}

Function.Ring_GetCount {
    Input:  ring: Integer
    Output: Integer
    Body: { ReturnValue(Subtract(Dereference(Add(ring, RingFields.COUNT)),      65536)) }
}

Function.Ring_GetEntrySize {
    Input:  ring: Integer
    Output: Integer
    Body: { ReturnValue(Subtract(Dereference(Add(ring, RingFields.ENTRY_SIZE)), 65536)) }
}

// =============================================================================
// RING EMPTY / FULL
// =============================================================================
Function.Ring_IsEmpty {
    Input:  ring: Integer
    Output: Integer
    Body: {
        count = Ring_GetCount(ring)
        IfCondition EqualTo(count, 0) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

Function.Ring_IsFull {
    Input:  ring: Integer
    Output: Integer
    Body: {
        count    = Ring_GetCount(ring)
        capacity = Ring_GetCapacity(ring)
        IfCondition GreaterEqual(count, capacity) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

// =============================================================================
// RING POST — write one entry to tail
// entry_ptr: pointer to RingEntry.SIZE bytes of data to copy in
// Returns 1 on success, 0 if full
// =============================================================================
Function.Ring_Post {
    Input:  ring:      Integer
    Input:  entry_ptr: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(Ring_IsFull(ring), 1) ThenBlock: { ReturnValue(0) }

        buf        = Dereference(Add(ring, RingFields.BUFFER))
        tail       = Ring_GetTail(ring)
        capacity   = Ring_GetCapacity(ring)
        entry_size = Ring_GetEntrySize(ring)

        // Offset into buffer: tail * entry_size
        offset = Multiply(tail, entry_size)
        dst    = Add(buf, offset)

        // Copy entry bytes
        i = 0
        WhileLoop LessThan(i, entry_size) {
            SetByte(dst, i, GetByte(entry_ptr, i))
            i = Add(i, 1)
        }

        // Advance tail (wrap using modulo — capacity is power of 2)
        new_tail = Modulo(Add(tail, 1), capacity)
        StoreValue(Add(ring, RingFields.TAIL),  Add(new_tail, 65536))

        // Increment count
        count = Ring_GetCount(ring)
        StoreValue(Add(ring, RingFields.COUNT), Add(Add(count, 1), 65536))

        ReturnValue(1)
    }
}

// =============================================================================
// RING DRAIN — read one entry from head into out_ptr
// out_ptr: caller-allocated buffer of at least RingEntry.SIZE bytes
// Returns 1 on success, 0 if empty
// =============================================================================
Function.Ring_Drain {
    Input:  ring:    Integer
    Input:  out_ptr: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(Ring_IsEmpty(ring), 1) ThenBlock: { ReturnValue(0) }

        buf        = Dereference(Add(ring, RingFields.BUFFER))
        head       = Ring_GetHead(ring)
        capacity   = Ring_GetCapacity(ring)
        entry_size = Ring_GetEntrySize(ring)

        // Copy entry bytes to caller
        offset = Multiply(head, entry_size)
        src    = Add(buf, offset)

        i = 0
        WhileLoop LessThan(i, entry_size) {
            SetByte(out_ptr, i, GetByte(src, i))
            i = Add(i, 1)
        }

        // Advance head
        new_head = Modulo(Add(head, 1), capacity)
        StoreValue(Add(ring, RingFields.HEAD),  Add(new_head, 65536))

        // Decrement count
        count = Ring_GetCount(ring)
        StoreValue(Add(ring, RingFields.COUNT), Add(Subtract(count, 1), 65536))

        ReturnValue(1)
    }
}

// =============================================================================
// RING DROP OLDEST — remove head entry without reading it
// Used by Ring 1 overflow policy for mouse-move events
// =============================================================================
Function.Ring_DropOldest {
    Input:  ring: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(Ring_IsEmpty(ring), 1) ThenBlock: { ReturnValue(0) }

        head       = Ring_GetHead(ring)
        capacity   = Ring_GetCapacity(ring)
        new_head   = Modulo(Add(head, 1), capacity)

        StoreValue(Add(ring, RingFields.HEAD),  Add(new_head, 65536))

        count = Ring_GetCount(ring)
        StoreValue(Add(ring, RingFields.COUNT), Add(Subtract(count, 1), 65536))

        ReturnValue(1)
    }
}

// =============================================================================
// RING PEEK — read head entry without consuming it
// =============================================================================
Function.Ring_Peek {
    Input:  ring:    Integer
    Input:  out_ptr: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(Ring_IsEmpty(ring), 1) ThenBlock: { ReturnValue(0) }

        buf        = Dereference(Add(ring, RingFields.BUFFER))
        head       = Ring_GetHead(ring)
        entry_size = Ring_GetEntrySize(ring)
        offset     = Multiply(head, entry_size)
        src        = Add(buf, offset)

        i = 0
        WhileLoop LessThan(i, entry_size) {
            SetByte(out_ptr, i, GetByte(src, i))
            i = Add(i, 1)
        }

        ReturnValue(1)
    }
}