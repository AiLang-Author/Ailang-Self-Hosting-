//
// Library.DRing0.ailang
// Ring 0 — Focus/Control
// Lowest frequency, highest authority. Processed first every tick.
// Overflow policy: block (should never happen — indicates a bug)
//
// Usage: LibraryImport.DRing0

LibraryImport.DRingTypes
LibraryImport.DRing

FixedPool.Ring0 {
    "handle": Initialize=0
}

SubRoutine.Ring0_Init {
    Ring0.handle = Ring_Create(RingCap.RING0, RingEntry.SIZE)
    IfCondition EqualTo(Ring0.handle, 0) ThenBlock: {
        PrintMessage("[Ring0] ERROR: failed to create\n")
    }
}

SubRoutine.Ring0_Shutdown {
    IfCondition NotEqual(Ring0.handle, 0) ThenBlock: {
        Ring_Destroy(Ring0.handle)
        Ring0.handle = 0
    }
}

// Post a control command — blocks if full (bug condition)
Function.Ring0_Post {
    Input:  cmd:     Integer
    Input:  param_a: Integer
    Input:  param_b: Integer
    Input:  param_c: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(Ring_IsFull(Ring0.handle), 1) ThenBlock: {
            PrintMessage("[Ring0] WARNING: ring full — overflow indicates a bug\n")
            ReturnValue(0)
        }
        entry = Allocate(RingEntry.SIZE)
        StoreValue(Add(entry, RingEntry.TYPE),    Add(cmd,     65536))
        StoreValue(Add(entry, RingEntry.PARAM_A), Add(param_a, 65536))
        StoreValue(Add(entry, RingEntry.PARAM_B), Add(param_b, 65536))
        StoreValue(Add(entry, RingEntry.PARAM_C), Add(param_c, 65536))
        result = Ring_Post(Ring0.handle, entry)
        Deallocate(entry, RingEntry.SIZE)
        ReturnValue(result)
    }
}

// Drain one command — returns 1 if entry was available
Function.Ring0_Drain {
    Input:  out_ptr: Integer
    Output: Integer
    Body: {
        ReturnValue(Ring_Drain(Ring0.handle, out_ptr))
    }
}

Function.Ring0_IsEmpty {
    Output: Integer
    Body: { ReturnValue(Ring_IsEmpty(Ring0.handle)) }
}

Function.Ring0_Count {
    Output: Integer
    Body: { ReturnValue(Ring_GetCount(Ring0.handle)) }
}