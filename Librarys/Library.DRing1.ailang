//
// Library.DRing1.ailang
// Ring 1 — Input Events
// Highest frequency, time-sensitive.
// Overflow policy: drop oldest MOUSE_MOVE only — never drop key events.
//
// Usage: LibraryImport.DRing1

LibraryImport.DRingTypes
LibraryImport.DRing

FixedPool.Ring1 {
    "handle": Initialize=0
}

SubRoutine.Ring1_Init {
    Ring1.handle = Ring_Create(RingCap.RING1, RingEntry.SIZE)
    IfCondition EqualTo(Ring1.handle, 0) ThenBlock: {
        PrintMessage("[Ring1] ERROR: failed to create\n")
    }
}

SubRoutine.Ring1_Shutdown {
    IfCondition NotEqual(Ring1.handle, 0) ThenBlock: {
        Ring_Destroy(Ring1.handle)
        Ring1.handle = 0
    }
}

// Post an input event
// If full and event is MOUSE_MOVE: drop oldest mouse-move to make room
// If full and event is KEY: drop oldest mouse-move to make room
// Never silently drop key events
Function.Ring1_Post {
    Input:  event_type: Integer
    Input:  x:          Integer
    Input:  y:          Integer
    Input:  data:       Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(Ring_IsFull(Ring1.handle), 1) ThenBlock: {
            IfCondition EqualTo(event_type, Ring1Event.MOUSE_MOVE) ThenBlock: {
                // Drop oldest to make room for new mouse-move
                Ring_DropOldest(Ring1.handle)
            } ElseBlock: {
                // Key event — drop oldest (likely mouse-move) to protect key
                Ring_DropOldest(Ring1.handle)
            }
        }
        entry = Allocate(RingEntry.SIZE)
        StoreValue(Add(entry, RingEntry.TYPE),    Add(event_type, 65536))
        StoreValue(Add(entry, RingEntry.PARAM_A), Add(x,          65536))
        StoreValue(Add(entry, RingEntry.PARAM_B), Add(y,          65536))
        StoreValue(Add(entry, RingEntry.PARAM_C), Add(data,       65536))
        result = Ring_Post(Ring1.handle, entry)
        Deallocate(entry, RingEntry.SIZE)
        ReturnValue(result)
    }
}

Function.Ring1_Drain {
    Input:  out_ptr: Integer
    Output: Integer
    Body: {
        ReturnValue(Ring_Drain(Ring1.handle, out_ptr))
    }
}

Function.Ring1_IsEmpty {
    Output: Integer
    Body: { ReturnValue(Ring_IsEmpty(Ring1.handle)) }
}

Function.Ring1_Count {
    Output: Integer
    Body: { ReturnValue(Ring_GetCount(Ring1.handle)) }
}