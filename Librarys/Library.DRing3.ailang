//
// Library.DRing3.ailang
// Ring 3 — dirty region work list.
// All fields stored raw (no bias).

LibraryImport.DRingTypes
LibraryImport.DRing

FixedPool.DirtyEntry {
    "SURFACE": Initialize=0
    "X":       Initialize=8
    "Y":       Initialize=16
    "W":       Initialize=24
    "H":       Initialize=32
}

FixedPool.Ring3 {
    "handle":      Initialize=0
    "dirty_count": Initialize=0
}

FixedPool.DirtyState {
    "surf0":  Initialize=0
    "x0":     Initialize=0
    "y0":     Initialize=0
    "w0":     Initialize=0
    "h0":     Initialize=0
    "surf1":  Initialize=0
    "x1":     Initialize=0
    "y1":     Initialize=0
    "w1":     Initialize=0
    "h1":     Initialize=0
    "surf2":  Initialize=0
    "x2":     Initialize=0
    "y2":     Initialize=0
    "w2":     Initialize=0
    "h2":     Initialize=0
    "surf3":  Initialize=0
    "x3":     Initialize=0
    "y3":     Initialize=0
    "w3":     Initialize=0
    "h3":     Initialize=0
    "surf4":  Initialize=0
    "x4":     Initialize=0
    "y4":     Initialize=0
    "w4":     Initialize=0
    "h4":     Initialize=0
    "surf5":  Initialize=0
    "x5":     Initialize=0
    "y5":     Initialize=0
    "w5":     Initialize=0
    "h5":     Initialize=0
    "surf6":  Initialize=0
    "x6":     Initialize=0
    "y6":     Initialize=0
    "w6":     Initialize=0
    "h6":     Initialize=0
    "surf7":  Initialize=0
    "x7":     Initialize=0
    "y7":     Initialize=0
    "w7":     Initialize=0
    "h7":     Initialize=0
    "count":  Initialize=0
    "MAX":    Initialize=8
}

SubRoutine.Ring3_Init {
    DirtyState.count = 0
}

SubRoutine.Ring3_Shutdown {
    DirtyState.count = 0
}

Function.Ring3_MarkDirty {
    Input: surf: Integer
    Input: x:    Integer
    Input: y:    Integer
    Input: w:    Integer
    Input: h:    Integer
    Body: {
        count = DirtyState.count
        IfCondition GreaterEqual(count, DirtyState.MAX) ThenBlock: {
            ReturnValue(0)
        }

        IfCondition EqualTo(count, 0) ThenBlock: {
            DirtyState.surf0 = surf
            DirtyState.x0    = x
            DirtyState.y0    = y
            DirtyState.w0    = w
            DirtyState.h0    = h
        }
        IfCondition EqualTo(count, 1) ThenBlock: {
            DirtyState.surf1 = surf
            DirtyState.x1    = x
            DirtyState.y1    = y
            DirtyState.w1    = w
            DirtyState.h1    = h
        }
        IfCondition EqualTo(count, 2) ThenBlock: {
            DirtyState.surf2 = surf
            DirtyState.x2    = x
            DirtyState.y2    = y
            DirtyState.w2    = w
            DirtyState.h2    = h
        }
        IfCondition EqualTo(count, 3) ThenBlock: {
            DirtyState.surf3 = surf
            DirtyState.x3    = x
            DirtyState.y3    = y
            DirtyState.w3    = w
            DirtyState.h3    = h
        }
        IfCondition EqualTo(count, 4) ThenBlock: {
            DirtyState.surf4 = surf
            DirtyState.x4    = x
            DirtyState.y4    = y
            DirtyState.w4    = w
            DirtyState.h4    = h
        }
        IfCondition EqualTo(count, 5) ThenBlock: {
            DirtyState.surf5 = surf
            DirtyState.x5    = x
            DirtyState.y5    = y
            DirtyState.w5    = w
            DirtyState.h5    = h
        }
        IfCondition EqualTo(count, 6) ThenBlock: {
            DirtyState.surf6 = surf
            DirtyState.x6    = x
            DirtyState.y6    = y
            DirtyState.w6    = w
            DirtyState.h6    = h
        }
        IfCondition EqualTo(count, 7) ThenBlock: {
            DirtyState.surf7 = surf
            DirtyState.x7    = x
            DirtyState.y7    = y
            DirtyState.w7    = w
            DirtyState.h7    = h
        }

        DirtyState.count = Add(count, 1)
    }
}

SubRoutine.Ring3_Clear {
    DirtyState.count = 0
}

Function.Ring3_IsDirty {
    Output: Integer
    Body: {
        IfCondition GreaterThan(DirtyState.count, 0) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

Function.Ring3_GetCount {
    Output: Integer
    Body: { ReturnValue(DirtyState.count) }
}