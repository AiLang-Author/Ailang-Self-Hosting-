//
// Library.DSurface.ailang
// Surface create / destroy / accessors
// Axis 0: Surface — the universal primitive
//
// BIAS NOTE: WIDTH, HEIGHT, PITCH, FORMAT, DATA_SIZE stored with +65536 bias.
//            DATA stored raw (pointer value, no bias).
//            All accessors subtract 65536 on read except Surface_GetData.

LibraryImport.Arena
LibraryImport.DSurfaceTypes

// =============================================================================
// SURFACE CREATE
// =============================================================================
Function.Surface_Create {
    Input:  format: Integer
    Input:  width:  Integer
    Input:  height: Integer
    Output: Integer
    Body: {
        IfCondition GreaterThan(width, SurfaceConst.MAX_WIDTH) ThenBlock: {
            PrintMessage("[Surface] ERROR: width exceeds MAX_WIDTH\n")
            ReturnValue(0)
        }
        IfCondition GreaterThan(height, SurfaceConst.MAX_HEIGHT) ThenBlock: {
            PrintMessage("[Surface] ERROR: height exceeds MAX_HEIGHT\n")
            ReturnValue(0)
        }
        IfCondition LessEqual(width, 0) ThenBlock: {
            PrintMessage("[Surface] ERROR: width must be > 0\n")
            ReturnValue(0)
        }
        IfCondition LessEqual(height, 0) ThenBlock: {
            PrintMessage("[Surface] ERROR: height must be > 0\n")
            ReturnValue(0)
        }

        IfCondition EqualTo(format, SurfaceFormat.CELL_32) ThenBlock: {
            pitch = Multiply(width, SurfaceConst.CELL_BYTES)
        } ElseBlock: {
            pitch = Multiply(width, SurfaceConst.PIXEL_BYTES)
        }
        data_size = Multiply(pitch, height)

        hdr = Allocate(SurfaceConst.HEADER_SIZE)
        IfCondition EqualTo(hdr, 0) ThenBlock: {
            PrintMessage("[Surface] ERROR: header alloc failed\n")
            ReturnValue(0)
        }

        buf = Allocate(data_size)
        IfCondition EqualTo(buf, 0) ThenBlock: {
            Deallocate(hdr, SurfaceConst.HEADER_SIZE)
            PrintMessage("[Surface] ERROR: buffer alloc failed\n")
            ReturnValue(0)
        }

        // Skip zero for pixel surfaces — caller fills before reading
        IfCondition EqualTo(format, SurfaceFormat.CELL_32) ThenBlock: {
            Surface_ZeroBuffer(buf, data_size)
        }

        StoreValue(Add(hdr, SurfaceFields.FORMAT),    Add(format,    65536))
        StoreValue(Add(hdr, SurfaceFields.WIDTH),     Add(width,     65536))
        StoreValue(Add(hdr, SurfaceFields.HEIGHT),    Add(height,    65536))
        StoreValue(Add(hdr, SurfaceFields.PITCH),     Add(pitch,     65536))
        StoreValue(Add(hdr, SurfaceFields.DATA),      buf)
        StoreValue(Add(hdr, SurfaceFields.DATA_SIZE), Add(data_size, 65536))

        ReturnValue(hdr)
    }
}

// =============================================================================
// SURFACE DESTROY
// =============================================================================
Function.Surface_Destroy {
    Input: surf: Integer
    Body: {
        IfCondition EqualTo(surf, 0) ThenBlock: {
            ReturnValue(0)
        }
        buf       = Dereference(Add(surf, SurfaceFields.DATA))
        // DATA_SIZE stored with bias — subtract on read
        data_size = Subtract(Dereference(Add(surf, SurfaceFields.DATA_SIZE)), 65536)
        IfCondition NotEqual(buf, 0) ThenBlock: {
            Deallocate(buf, data_size)
        }
        Deallocate(surf, SurfaceConst.HEADER_SIZE)
    }
}

// =============================================================================
// ACCESSORS
// WIDTH, HEIGHT, PITCH, FORMAT, DATA_SIZE all stored with +65536 bias
// DATA stored raw (pointer — no bias)
// =============================================================================
Function.Surface_GetFormat {
    Input:  surf: Integer
    Output: Integer
    Body: { ReturnValue(Subtract(Dereference(Add(surf, SurfaceFields.FORMAT)),    65536)) }
}

Function.Surface_GetWidth {
    Input:  surf: Integer
    Output: Integer
    Body: { ReturnValue(Subtract(Dereference(Add(surf, SurfaceFields.WIDTH)),     65536)) }
}

Function.Surface_GetHeight {
    Input:  surf: Integer
    Output: Integer
    Body: { ReturnValue(Subtract(Dereference(Add(surf, SurfaceFields.HEIGHT)),    65536)) }
}

Function.Surface_GetPitch {
    Input:  surf: Integer
    Output: Integer
    Body: { ReturnValue(Subtract(Dereference(Add(surf, SurfaceFields.PITCH)),     65536)) }
}

Function.Surface_GetData {
    Input:  surf: Integer
    Output: Integer
    Body: { ReturnValue(Dereference(Add(surf, SurfaceFields.DATA))) }
}

Function.Surface_GetDataSize {
    Input:  surf: Integer
    Output: Integer
    Body: { ReturnValue(Subtract(Dereference(Add(surf, SurfaceFields.DATA_SIZE)), 65536)) }
}

// =============================================================================
// BOUNDS CHECK
// Reads WIDTH/HEIGHT with bias correction inline
// =============================================================================
Function.Surface_InBounds {
    Input:  surf: Integer
    Input:  x:    Integer
    Input:  y:    Integer
    Output: Integer
    Body: {
        IfCondition LessThan(x, 0) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(y, 0) ThenBlock: { ReturnValue(0) }
        sw = Subtract(Dereference(Add(surf, SurfaceFields.WIDTH)),  65536)
        sh = Subtract(Dereference(Add(surf, SurfaceFields.HEIGHT)), 65536)
        IfCondition Not(LessThan(x, sw)) ThenBlock: { ReturnValue(0) }
        IfCondition Not(LessThan(y, sh)) ThenBlock: { ReturnValue(0) }
        ReturnValue(1)
    }
}

// =============================================================================
// PIXEL ADDRESS — pitch stored with bias
// =============================================================================
Function.Surface_PixelAt {
    Input:  surf: Integer
    Input:  x:    Integer
    Input:  y:    Integer
    Output: Integer
    Body: {
        data  = Dereference(Add(surf, SurfaceFields.DATA))
        pitch = Subtract(Dereference(Add(surf, SurfaceFields.PITCH)), 65536)
        offset = Add(Multiply(y, pitch), Multiply(x, SurfaceConst.PIXEL_BYTES))
        ReturnValue(Add(data, offset))
    }
}

// =============================================================================
// CELL ADDRESS — pitch stored with bias
// =============================================================================
Function.Surface_CellAt {
    Input:  surf: Integer
    Input:  x:    Integer
    Input:  y:    Integer
    Output: Integer
    Body: {
        data  = Dereference(Add(surf, SurfaceFields.DATA))
        pitch = Subtract(Dereference(Add(surf, SurfaceFields.PITCH)), 65536)
        offset = Add(Multiply(y, pitch), Multiply(x, SurfaceConst.CELL_BYTES))
        ReturnValue(Add(data, offset))
    }
}

// =============================================================================
// INTERNAL: zero a buffer (CELL_32 surfaces only)
// =============================================================================
Function.Surface_ZeroBuffer {
    Input: buf:  Integer
    Input: size: Integer
    Body: {
        i = 0
        WhileLoop LessThan(i, size) {
            SetByte(buf, i, 0)
            i = Add(i, 1)
        }
    }
}