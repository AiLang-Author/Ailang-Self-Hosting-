//
// Library.DSurface.ailang
// Surface create / destroy / accessors
// Axis 0: Surface — the universal primitive
//
// INVARIANT 1: No surface pixel exists outside its allocated dimensions
// INVARIANT 5: Draw operations that would exceed surface bounds are clamped/rejected
//
// Usage: LibraryImport.Display.Core.DSurface

LibraryImport.Arena
LibraryImport.Display.Core.DSurfaceTypes

// =============================================================================
// SURFACE CREATE
// Returns surface handle (pointer to header struct), or 0 on failure
// Hard boundaries enforced here — nothing outside MAX_WIDTH/MAX_HEIGHT allocated
// =============================================================================
Function.Surface_Create {
    Input:  format: Integer
    Input:  width:  Integer
    Input:  height: Integer
    Output: Integer
    Body: {
        // Hard boundary — reject oversized requests
        IfCondition GreaterThan(width, SurfaceConst.MAX_WIDTH) ThenBlock: {
            PrintMessage("[Surface] ERROR: width exceeds MAX_WIDTH\n")
            ReturnValue(0)
        }
        IfCondition GreaterThan(height, SurfaceConst.MAX_HEIGHT) ThenBlock: {
            PrintMessage("[Surface] ERROR: height exceeds MAX_HEIGHT\n")
            ReturnValue(0)
        }
        IfCondition LessEqual(width, 0) ThenBlock: {
            PrintMessage("[Surface] ERROR: width must be > 0\n")
            ReturnValue(0)
        }
        IfCondition LessEqual(height, 0) ThenBlock: {
            PrintMessage("[Surface] ERROR: height must be > 0\n")
            ReturnValue(0)
        }

        // Compute pitch and buffer size
        IfCondition EqualTo(format, SurfaceFormat.CELL_32) ThenBlock: {
            pitch = Multiply(width, SurfaceConst.CELL_BYTES)
        } ElseBlock: {
            pitch = Multiply(width, SurfaceConst.PIXEL_BYTES)
        }
        data_size = Multiply(pitch, height)

        // Allocate header
        hdr = Allocate(SurfaceConst.HEADER_SIZE)
        IfCondition EqualTo(hdr, 0) ThenBlock: {
            PrintMessage("[Surface] ERROR: header alloc failed\n")
            ReturnValue(0)
        }

        // Allocate data buffer
        buf = Allocate(data_size)
        IfCondition EqualTo(buf, 0) ThenBlock: {
            Deallocate(hdr, SurfaceConst.HEADER_SIZE)
            PrintMessage("[Surface] ERROR: buffer alloc failed\n")
            ReturnValue(0)
        }

        // Zero the buffer (clean surface)
        Surface_ZeroBuffer(buf, data_size)

        // Write header fields
        StoreValue(Add(hdr, SurfaceFields.FORMAT),    format)
        StoreValue(Add(hdr, SurfaceFields.WIDTH),     width)
        StoreValue(Add(hdr, SurfaceFields.HEIGHT),    height)
        StoreValue(Add(hdr, SurfaceFields.PITCH),     pitch)
        StoreValue(Add(hdr, SurfaceFields.DATA),      buf)
        StoreValue(Add(hdr, SurfaceFields.DATA_SIZE), data_size)

        ReturnValue(hdr)
    }
}

// =============================================================================
// SURFACE DESTROY
// =============================================================================
SubRoutine.Surface_Destroy {
    Input: surf: Integer
    Body: {
        IfCondition EqualTo(surf, 0) ThenBlock: {
            ReturnValue(0)
        }
        buf       = Dereference(Add(surf, SurfaceFields.DATA))
        data_size = Dereference(Add(surf, SurfaceFields.DATA_SIZE))
        IfCondition NotEqual(buf, 0) ThenBlock: {
            Deallocate(buf, data_size)
        }
        Deallocate(surf, SurfaceConst.HEADER_SIZE)
    }
}

// =============================================================================
// ACCESSORS — inline reads from header
// =============================================================================
Function.Surface_GetFormat {
    Input:  surf: Integer
    Output: Integer
    Body: { ReturnValue(Dereference(Add(surf, SurfaceFields.FORMAT))) }
}

Function.Surface_GetWidth {
    Input:  surf: Integer
    Output: Integer
    Body: { ReturnValue(Dereference(Add(surf, SurfaceFields.WIDTH))) }
}

Function.Surface_GetHeight {
    Input:  surf: Integer
    Output: Integer
    Body: { ReturnValue(Dereference(Add(surf, SurfaceFields.HEIGHT))) }
}

Function.Surface_GetPitch {
    Input:  surf: Integer
    Output: Integer
    Body: { ReturnValue(Dereference(Add(surf, SurfaceFields.PITCH))) }
}

Function.Surface_GetData {
    Input:  surf: Integer
    Output: Integer
    Body: { ReturnValue(Dereference(Add(surf, SurfaceFields.DATA))) }
}

// =============================================================================
// BOUNDS CHECK — used by every draw call
// Returns 1 if (x, y) is inside surface, 0 if out of bounds
// =============================================================================
Function.Surface_InBounds {
    Input:  surf: Integer
    Input:  x:    Integer
    Input:  y:    Integer
    Output: Integer
    Body: {
        IfCondition LessThan(x, 0)                                          ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(y, 0)                                          ThenBlock: { ReturnValue(0) }
        IfCondition Not(LessThan(x, Dereference(Add(surf, SurfaceFields.WIDTH))))  ThenBlock: { ReturnValue(0) }
        IfCondition Not(LessThan(y, Dereference(Add(surf, SurfaceFields.HEIGHT)))) ThenBlock: { ReturnValue(0) }
        ReturnValue(1)
    }
}

// =============================================================================
// CELL ADDRESS — pointer to cell at (x, y) in a CELL_32 surface
// No bounds check — caller must validate first
// =============================================================================
Function.Surface_CellAt {
    Input:  surf: Integer
    Input:  x:    Integer
    Input:  y:    Integer
    Output: Integer
    Body: {
        data  = Dereference(Add(surf, SurfaceFields.DATA))
        pitch = Dereference(Add(surf, SurfaceFields.PITCH))
        // offset = y * pitch + x * CELL_BYTES
        offset = Add(Multiply(y, pitch), Multiply(x, SurfaceConst.CELL_BYTES))
        ReturnValue(Add(data, offset))
    }
}

// =============================================================================
// PIXEL ADDRESS — pointer to pixel at (x, y) in a PIXEL_32 surface
// No bounds check — caller must validate first
// =============================================================================
Function.Surface_PixelAt {
    Input:  surf: Integer
    Input:  x:    Integer
    Input:  y:    Integer
    Output: Integer
    Body: {
        data  = Dereference(Add(surf, SurfaceFields.DATA))
        pitch = Dereference(Add(surf, SurfaceFields.PITCH))
        offset = Add(Multiply(y, pitch), Multiply(x, SurfaceConst.PIXEL_BYTES))
        ReturnValue(Add(data, offset))
    }
}

// =============================================================================
// INTERNAL: zero a buffer
// =============================================================================
SubRoutine.Surface_ZeroBuffer {
    Input: buf:  Integer
    Input: size: Integer
    Body: {
        i = 0
        WhileLoop LessThan(i, size) {
            SetByte(buf, i, 0)
            i = Add(i, 1)
        }
    }
}