//
// Library.DSurfaceTypes.ailang
// Surface type constants and field descriptors
// Axis 0: Surface — the universal primitive
//
// Usage: LibraryImport.Display.Core.DSurfaceTypes

// =============================================================================
// SURFACE FORMAT
// =============================================================================
// CELL_32  — terminal cell surface: each slot is { char(1) fg(1) bg(1) attr(1) }
// PIXEL_32 — pixel surface: each slot is BGRA 32-bit (matches framebuffer native)

FixedPool.SurfaceFormat {
    "CELL_32":  Initialize=0
    "PIXEL_32": Initialize=1
}

// =============================================================================
// SURFACE FIELDS
// Surface handle is a pointer to this struct (allocated via Arena)
// Total: 48 bytes — fits in Arena_Alloc64 slot
// =============================================================================
FixedPool.SurfaceFields {
    "FORMAT":    Initialize=0   // 0=CELL_32 1=PIXEL_32
    "WIDTH":     Initialize=8   // logical width (cols or pixels)
    "HEIGHT":    Initialize=16  // logical height (rows or pixels)
    "PITCH":     Initialize=24  // bytes per row
    "DATA":      Initialize=32  // pointer to pixel/cell buffer
    "DATA_SIZE": Initialize=40  // total buffer bytes (for dealloc)
}

// =============================================================================
// SURFACE CONSTANTS
// =============================================================================
FixedPool.SurfaceConst {
    "HEADER_SIZE":    Initialize=48   // bytes for the surface struct itself
    "CELL_BYTES":     Initialize=4    // bytes per cell in CELL_32
    "PIXEL_BYTES":    Initialize=4    // bytes per pixel in PIXEL_32
    "MAX_WIDTH":      Initialize=7680 // hard limit — 8K horizontal
    "MAX_HEIGHT":     Initialize=4320 // hard limit — 8K vertical
}

// =============================================================================
// CELL LAYOUT (CELL_32 format)
// Each cell is 4 bytes packed:
//   byte 0: codepoint (ASCII, extended later)
//   byte 1: fg color index (0-255)
//   byte 2: bg color index (0-255)
//   byte 3: attribute flags
// =============================================================================
FixedPool.CellOffset {
    "CHAR": Initialize=0
    "FG":   Initialize=1
    "BG":   Initialize=2
    "ATTR": Initialize=3
}

FixedPool.CellAttr {
    "BOLD":      Initialize=1
    "UNDERLINE": Initialize=2
    "REVERSE":   Initialize=4
    "BLINK":     Initialize=8
}

// =============================================================================
// ANSI 16-COLOR INDICES (for CELL_32 fg/bg)
// =============================================================================
FixedPool.Color16 {
    "BLACK":          Initialize=0
    "RED":            Initialize=1
    "GREEN":          Initialize=2
    "YELLOW":         Initialize=3
    "BLUE":           Initialize=4
    "MAGENTA":        Initialize=5
    "CYAN":           Initialize=6
    "WHITE":          Initialize=7
    "BRIGHT_BLACK":   Initialize=8
    "BRIGHT_RED":     Initialize=9
    "BRIGHT_GREEN":   Initialize=10
    "BRIGHT_YELLOW":  Initialize=11
    "BRIGHT_BLUE":    Initialize=12
    "BRIGHT_MAGENTA": Initialize=13
    "BRIGHT_CYAN":    Initialize=14
    "BRIGHT_WHITE":   Initialize=15
    "DEFAULT":        Initialize=255  // terminal default color
}