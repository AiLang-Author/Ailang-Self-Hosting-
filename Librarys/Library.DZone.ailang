//
// Library.DZone.ailang
// Zone management — add/remove/configure display zones
// Phase 5: Zone_InitSingle — one full-screen FB zone, no DPI scaling
// Location: Librarys/Display/Zone/Library.DZone.ailang

LibraryImport.Framebuffer
LibraryImport.DZoneTypes

// =============================================================================
// ZONE FIELD ACCESSORS
// All stored with +65536 bias (StoreValue byte bug workaround)
// =============================================================================
Function.Zone_GetField {
    Input: zone: Address
    Input: field: Integer
    Output: Integer
    Body: {
        raw = Dereference(Add(zone, field))
        ReturnValue(Subtract(raw, 65536))
    }
}

SubRoutine.Zone_SetField {
    // Can't use SubRoutine with args — use Function pattern
}

Function.Zone_SetField {
    Input: zone:  Address
    Input: field: Integer
    Input: val:   Integer
    Output: Integer
    Body: {
        StoreValue(Add(zone, field), Add(val, 65536))
        ReturnValue(0)
    }
}

// Convenience accessors
Function.Zone_GetX      { Input: z: Address  Output: Integer  Body: { ReturnValue(Zone_GetField(z, ZoneFields.X))      } }
Function.Zone_GetY      { Input: z: Address  Output: Integer  Body: { ReturnValue(Zone_GetField(z, ZoneFields.Y))      } }
Function.Zone_GetWidth  { Input: z: Address  Output: Integer  Body: { ReturnValue(Zone_GetField(z, ZoneFields.WIDTH))  } }
Function.Zone_GetHeight { Input: z: Address  Output: Integer  Body: { ReturnValue(Zone_GetField(z, ZoneFields.HEIGHT)) } }
Function.Zone_GetLogicalWidth  { Input: z: Address  Output: Integer  Body: { ReturnValue(Zone_GetField(z, ZoneFields.LOGICAL_WIDTH))  } }
Function.Zone_GetLogicalHeight { Input: z: Address  Output: Integer  Body: { ReturnValue(Zone_GetField(z, ZoneFields.LOGICAL_HEIGHT)) } }
Function.Zone_GetOutput { Input: z: Address  Output: Integer  Body: { ReturnValue(Zone_GetField(z, ZoneFields.OUTPUT_DEVICE)) } }

// =============================================================================
// ZONE_ALLOC — allocate and zero a zone entry
// =============================================================================
Function.Zone_Alloc {
    Output: Address
    Body: {
        z = Allocate(ZoneConst.SIZE)
        // Zero all fields (store 65536 bias = value 0)
        Zone_SetField(z, ZoneFields.X,              0)
        Zone_SetField(z, ZoneFields.Y,              0)
        Zone_SetField(z, ZoneFields.WIDTH,          0)
        Zone_SetField(z, ZoneFields.HEIGHT,         0)
        Zone_SetField(z, ZoneFields.OUTPUT_DEVICE,  0)
        Zone_SetField(z, ZoneFields.REFRESH_RATE,   0)
        Zone_SetField(z, ZoneFields.SCALE_NUM,      1)
        Zone_SetField(z, ZoneFields.SCALE_DEN,      1)
        Zone_SetField(z, ZoneFields.LOGICAL_WIDTH,  0)
        Zone_SetField(z, ZoneFields.LOGICAL_HEIGHT, 0)
        ReturnValue(z)
    }
}

// =============================================================================
// ZONE_FREE
// =============================================================================
SubRoutine.Zone_Free {
    // caller passes address — can't take args in SubRoutine
    // Use Zone_FreeZ function form
}

Function.Zone_FreeZ {
    Input: z: Address
    Output: Integer
    Body: {
        Deallocate(z, ZoneConst.SIZE)
        ReturnValue(0)
    }
}

// =============================================================================
// ZONE_INITSINGLE — Phase 5 bootstrap
// Creates one full-screen zone from FB dimensions.
// Sets DisplayConfig to COMBINED mode, one zone at (0,0), 1:1 scale, FB output.
// Call AFTER FB_Init or FB_InitDouble.
// =============================================================================
Function.Zone_InitSingle {
    Output: Integer
    Body: {
        IfCondition EqualTo(DisplayConfig.initialized, Add(1, 65536)) ThenBlock: {
            // Already initialized — nothing to do
            ReturnValue(1)
        }

        w = FB_GetWidth()
        h = FB_GetHeight()

        IfCondition EqualTo(w, 0) ThenBlock: {
            PrintMessage("[Zone] ERROR: FB not initialized — call FB_Init first\n")
            ReturnValue(0)
        }

        // Allocate zone table: 1 zone
        table = Allocate(ZoneConst.SIZE)
        z = table

        Zone_SetField(z, ZoneFields.X,              0)
        Zone_SetField(z, ZoneFields.Y,              0)
        Zone_SetField(z, ZoneFields.WIDTH,          w)
        Zone_SetField(z, ZoneFields.HEIGHT,         h)
        Zone_SetField(z, ZoneFields.OUTPUT_DEVICE,  ZoneOutput.FB)
        Zone_SetField(z, ZoneFields.REFRESH_RATE,   60)
        Zone_SetField(z, ZoneFields.SCALE_NUM,      1)
        Zone_SetField(z, ZoneFields.SCALE_DEN,      1)
        Zone_SetField(z, ZoneFields.LOGICAL_WIDTH,  w)
        Zone_SetField(z, ZoneFields.LOGICAL_HEIGHT, h)

        // Wire up DisplayConfig
        DisplayConfig.surface_mode   = Add(SurfaceMode.COMBINED, 65536)
        DisplayConfig.surface_width  = Add(w, 65536)
        DisplayConfig.surface_height = Add(h, 65536)
        DisplayConfig.zone_count     = Add(1, 65536)
        DisplayConfig.zone_table     = Add(table, 65536)
        DisplayConfig.initialized    = Add(1, 65536)

        PrintMessage("[Zone] Single zone initialized: ")
        PrintNumber(w)
        PrintMessage("x")
        PrintNumber(h)
        PrintMessage(" FB output\n")
        ReturnValue(1)
    }
}

// =============================================================================
// ZONE_SHUTDOWN — free zone table
// =============================================================================
SubRoutine.Zone_Shutdown {
    IfCondition NotEqual(DisplayConfig.initialized, Add(1, 65536)) ThenBlock: {
        ReturnValue(0)
    }
    table = Subtract(DisplayConfig.zone_table, 65536)
    IfCondition NotEqual(table, 0) ThenBlock: {
        Deallocate(table, ZoneConst.SIZE)
    }
    DisplayConfig.zone_table     = Add(0, 65536)
    DisplayConfig.zone_count     = Add(0, 65536)
    DisplayConfig.initialized    = Add(0, 65536)
}

// =============================================================================
// ZONE_GETPRIMARY — returns pointer to first zone entry
// =============================================================================
Function.Zone_GetPrimary {
    Output: Address
    Body: {
        IfCondition NotEqual(DisplayConfig.initialized, Add(1, 65536)) ThenBlock: {
            ReturnValue(0)
        }
        table = Subtract(DisplayConfig.zone_table, 65536)
        ReturnValue(table)
    }
}

// =============================================================================
// ZONE_GETCOUNT
// =============================================================================
Function.Zone_GetCount {
    Output: Integer
    Body: {
        ReturnValue(Subtract(DisplayConfig.zone_count, 65536))
    }
}