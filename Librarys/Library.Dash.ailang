// Dash — MDI datalog viewer. JSON template → AppDesk windows + Gauge widgets.
// Playback is a playhead over a synthetic sample buffer (same Wave() traces
// that used to tick live). Host writes /tmp/anim_app/cmd.txt:
//   1=start 2=stop 3=pause 4=fwd 5=rev | seek N | quit
// Kernel writes /tmp/anim_app/play.txt:  pos nlog play dir
// Logs stay JSONL (one sample per line) when a file is dumped.
//
// Copyright (c) 2026 Sean Collins, 2 Paws Machine and Engineering. All rights reserved.
// Licensed under the Sean Collins Software License (SCSL v1.0).

LibraryImport.Arena
LibraryImport.JSON
LibraryImport.Anim
LibraryImport.Gauge
LibraryImport.Applications.AppDesk
LibraryImport.Display.Render.Framebuffer
LibraryImport.TextGrid

FixedPool.DashKind {
    "ARC":  Initialize=1
    "BAR":  Initialize=2
    "BARH": Initialize=3
    "PLOT":  Initialize=4
    "TABLE": Initialize=5
}

FixedPool.Dash_State {
    "ok":     Initialize=0, CanChange=True
    "panes":  Initialize=0, CanChange=True
    "n":      Initialize=0, CanChange=True
    "cap":    Initialize=16, CanChange=True
    "chn":    Initialize=0, CanChange=True
    "chdec":  Initialize=0, CanChange=True
    "chlo":   Initialize=0, CanChange=True
    "chhi":   Initialize=0, CanChange=True
    "tr":     Initialize=0, CanChange=True
    "nch":    Initialize=0, CanChange=True
    "logp":   Initialize=0, CanChange=True
    "tick":   Initialize=0, CanChange=True
    "title":  Initialize=0, CanChange=True
    "jbuf":   Initialize=0, CanChange=True
    "log":    Initialize=0, CanChange=True
    "nlog":   Initialize=1800, CanChange=True
    "pos":    Initialize=0, CanChange=True
    "play":   Initialize=1, CanChange=True
    "dir":    Initialize=1, CanChange=True
    "cmd":    Initialize=0, CanChange=True
    "st":     Initialize=0, CanChange=True
    "dirty":  Initialize=1, CanChange=True
    "path":   Initialize=0, CanChange=True
    "mx":     Initialize=0, CanChange=True
    "my":     Initialize=0, CanChange=True
    "ptr":    Initialize=0, CanChange=True
    "ptrhit": Initialize=0, CanChange=True
    "edit":   Initialize=0, CanChange=True
    "barhit": Initialize=0, CanChange=True
    "barup":  Initialize=0, CanChange=True
    "modal":  Initialize=0, CanChange=True
    "file":   Initialize=0, CanChange=True
    "view0":  Initialize=0, CanChange=True
    "scrub":  Initialize=0, CanChange=True
    "spane":  Initialize=-1, CanChange=True
    "pslot":  Initialize=0, CanChange=True
    "tb":     Initialize=0, CanChange=True
    "pick":   Initialize=0, CanChange=True
    "chblu":  Initialize=0, CanChange=True
    "chyel":  Initialize=0, CanChange=True
    "chred":  Initialize=0, CanChange=True
    "drop":   Initialize=0, CanChange=True
    "dpane":  Initialize=-1, CanChange=True
    "dslot":  Initialize=0, CanChange=True
    "dtop":   Initialize=0, CanChange=True
    "dx":     Initialize=0, CanChange=True
    "dy":     Initialize=0, CanChange=True
    "dw":     Initialize=0, CanChange=True
    "dh":     Initialize=0, CanChange=True
}

FixedPool.DashPlot {
    "x":  Initialize=0, CanChange=True
    "y":  Initialize=0, CanChange=True
    "w":  Initialize=0, CanChange=True
    "h":  Initialize=0, CanChange=True
    "ix": Initialize=0, CanChange=True
    "iy": Initialize=0, CanChange=True
    "iw": Initialize=0, CanChange=True
    "ih": Initialize=0, CanChange=True
    "t0": Initialize=0, CanChange=True
    "np": Initialize=0, CanChange=True
    "bx": Initialize=0, CanChange=True
    "by": Initialize=0, CanChange=True
    "bw": Initialize=0, CanChange=True
}

Function.Dash.PWSet {
    Input: idx: Integer
    Input: f: Integer
    Input: v: Integer
    Output: Integer
    Body: {
        StoreValue(Add(Dash_State.panes, Add(Multiply(idx, 64), Multiply(f, 8))), v)
        ReturnValue(0)
    }
}

Function.Dash.PWGet {
    Input: idx: Integer
    Input: f: Integer
    Output: Integer
    Body: {
        ReturnValue(Dereference(Add(Dash_State.panes, Add(Multiply(idx, 64), Multiply(f, 8)))))
    }
}

Function.Dash.Init {
    Output: Integer
    Body: {
        IfCondition EqualTo(Dash_State.ok, 1) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(Anim.Init(), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Gauge.Init(), 0) ThenBlock: { ReturnValue(0) }
        AppDesk.Init()
        Dash_State.cap = 16
        Dash_State.panes = Allocate(1024)
        Dash_State.chn = Allocate(512)
        Dash_State.chdec = Allocate(256)
        Dash_State.chlo = Allocate(256)
        Dash_State.chhi = Allocate(256)
        Dash_State.chblu = Allocate(256)
        Dash_State.chyel = Allocate(256)
        Dash_State.chred = Allocate(256)
        Dash_State.tr = Allocate(768)
        zi = 0
        WhileLoop LessThan(zi, 768) {
            SetByte(Dash_State.tr, zi, 0)
            zi = Add(zi, 1)
        }
        Dash_State.tb = Allocate(4096)
        zi = 0
        WhileLoop LessThan(zi, 4096) {
            SetByte(Dash_State.tb, zi, 0)
            zi = Add(zi, 1)
        }
        Dash_State.n = 0
        Dash_State.nch = 0
        Dash_State.tick = 0
        Dash_State.log = 0
        Dash_State.nlog = 1800
        Dash_State.pos = 0
        Dash_State.play = 1
        Dash_State.dir = 1
        Dash_State.ok = 1
        ReturnValue(1)
    }
}

Function.Dash.ChanPut {
    Input: name: Address
    Input: v: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition EqualTo(GetByte(name, 0), 0) ThenBlock: { ReturnValue(-1) }
        i = 0
        WhileLoop LessThan(i, Dash_State.nch) {
            t = Dereference(Add(Dash_State.chn, Multiply(i, 16)))
            IfCondition EqualTo(StringCompare(t, name), 0) ThenBlock: {
                StoreValue(Add(Dash_State.chn, Add(Multiply(i, 16), 8)), v)
                ReturnValue(i)
            }
            i = Add(i, 1)
        }
        IfCondition GreaterEqual(Dash_State.nch, 32) ThenBlock: { ReturnValue(-1) }
        i = Dash_State.nch
        StoreValue(Add(Dash_State.chn, Multiply(i, 16)), name)
        StoreValue(Add(Dash_State.chn, Add(Multiply(i, 16), 8)), v)
        StoreValue(Add(Dash_State.chdec, Multiply(i, 8)), 0)
        StoreValue(Add(Dash_State.chlo, Multiply(i, 8)), 0)
        StoreValue(Add(Dash_State.chhi, Multiply(i, 8)), 1000)
        Dash.GuessRange(name, i)
        Dash_State.nch = Add(i, 1)
        ReturnValue(i)
    }
}

Function.Dash.ChanGet {
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }
        i = 0
        WhileLoop LessThan(i, Dash_State.nch) {
            t = Dereference(Add(Dash_State.chn, Multiply(i, 16)))
            IfCondition EqualTo(StringCompare(t, name), 0) ThenBlock: {
                ReturnValue(Dereference(Add(Dash_State.chn, Add(Multiply(i, 16), 8))))
            }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

Function.Dash.ChanDec {
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }
        i = Dash.ChanIdx(name)
        IfCondition GreaterEqual(i, 0) ThenBlock: {
            d = Dereference(Add(Dash_State.chdec, Multiply(i, 8)))
            IfCondition GreaterThan(d, 0) ThenBlock: { ReturnValue(d) }
        }
        i = 0
        WhileLoop LessThan(i, Dash_State.n) {
            ch = Dash.PWGet(i, 3)
            IfCondition NotEqual(ch, 0) ThenBlock: {
                IfCondition EqualTo(StringCompare(ch, name), 0) ThenBlock: {
                    ReturnValue(Dash.PWGet(i, 7))
                }
            }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

Function.Dash.ChanSetDec {
    Input: name: Address
    Input: d: Integer
    Output: Integer
    Body: {
        i = Dash.ChanIdx(name)
        IfCondition LessThan(i, 0) ThenBlock: { ReturnValue(-1) }
        StoreValue(Add(Dash_State.chdec, Multiply(i, 8)), d)
        ReturnValue(0)
    }
}

Function.Dash.ChanLo {
    Input: name: Address
    Output: Integer
    Body: {
        i = Dash.ChanIdx(name)
        IfCondition LessThan(i, 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(Dereference(Add(Dash_State.chlo, Multiply(i, 8))))
    }
}

Function.Dash.ChanHi {
    Input: name: Address
    Output: Integer
    Body: {
        i = Dash.ChanIdx(name)
        IfCondition LessThan(i, 0) ThenBlock: { ReturnValue(1000) }
        ReturnValue(Dereference(Add(Dash_State.chhi, Multiply(i, 8))))
    }
}

Function.Dash.ChanSetRange {
    Input: name: Address
    Input: lo: Integer
    Input: hi: Integer
    Output: Integer
    Body: {
        i = Dash.ChanIdx(name)
        IfCondition LessThan(i, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition GreaterEqual(lo, hi) ThenBlock: { hi = Add(lo, 1) }
        StoreValue(Add(Dash_State.chlo, Multiply(i, 8)), lo)
        StoreValue(Add(Dash_State.chhi, Multiply(i, 8)), hi)
        ReturnValue(0)
    }
}

Function.Dash.GuessRange {
    Input: name: Address
    Input: i: Integer
    Output: Integer
    Body: {
        lo = 0
        hi = 1000
        IfCondition EqualTo(StringCompare(name, "rpm"), 0) ThenBlock: { hi = 4000 }
        IfCondition EqualTo(StringCompare(name, "map"), 0) ThenBlock: { hi = 105 }
        IfCondition EqualTo(StringCompare(name, "tps"), 0) ThenBlock: { hi = 100 }
        IfCondition EqualTo(StringCompare(name, "clt"), 0) ThenBlock: { hi = 120 }
        IfCondition EqualTo(StringCompare(name, "iat"), 0) ThenBlock: { hi = 80 }
        IfCondition EqualTo(StringCompare(name, "afr"), 0) ThenBlock: {
            lo = 1000
            hi = 2000
        }
        IfCondition EqualTo(StringCompare(name, "batt"), 0) ThenBlock: {
            lo = 1000
            hi = 1600
        }
        IfCondition EqualTo(StringCompare(name, "spark"), 0) ThenBlock: { hi = 450 }
        IfCondition EqualTo(StringCompare(name, "o2"), 0) ThenBlock: { hi = 1000 }
        IfCondition EqualTo(StringCompare(name, "blm"), 0) ThenBlock: {
            lo = 100
            hi = 160
        }
        IfCondition EqualTo(StringCompare(name, "vss"), 0) ThenBlock: { hi = 120 }
        IfCondition EqualTo(StringCompare(name, "pw"), 0) ThenBlock: { hi = 2000 }
        IfCondition EqualTo(StringCompare(name, "iac"), 0) ThenBlock: { hi = 200 }
        IfCondition EqualTo(StringCompare(name, "intg"), 0) ThenBlock: {
            lo = 80
            hi = 180
        }
        IfCondition EqualTo(StringCompare(name, "knk"), 0) ThenBlock: { hi = 250 }
        IfCondition EqualTo(StringCompare(name, "krt"), 0) ThenBlock: { hi = 150 }
        IfCondition EqualTo(StringCompare(name, "idle"), 0) ThenBlock: { hi = 2000 }
        IfCondition EqualTo(StringCompare(name, "egr"), 0) ThenBlock: { hi = 100 }
        IfCondition EqualTo(StringCompare(name, "ccp"), 0) ThenBlock: { hi = 100 }
        IfCondition EqualTo(StringCompare(name, "mapv"), 0) ThenBlock: { hi = 500 }
        IfCondition EqualTo(StringCompare(name, "run"), 0) ThenBlock: { hi = 4000 }
        StoreValue(Add(Dash_State.chlo, Multiply(i, 8)), lo)
        StoreValue(Add(Dash_State.chhi, Multiply(i, 8)), hi)
        span = Subtract(hi, lo)
        IfCondition LessThan(span, 1) ThenBlock: { span = 1 }
        c0 = Add(lo, Divide(span, 5))
        c1 = Add(lo, Divide(Multiply(span, 7), 10))
        c2 = Add(lo, Divide(Multiply(span, 9), 10))
        IfCondition EqualTo(StringCompare(name, "clt"), 0) ThenBlock: {
            c0 = 40
            c1 = 90
            c2 = 105
        }
        IfCondition EqualTo(StringCompare(name, "iat"), 0) ThenBlock: {
            c0 = 10
            c1 = 50
            c2 = 70
        }
        StoreValue(Add(Dash_State.chblu, Multiply(i, 8)), c0)
        StoreValue(Add(Dash_State.chyel, Multiply(i, 8)), c1)
        StoreValue(Add(Dash_State.chred, Multiply(i, 8)), c2)
        ReturnValue(0)
    }
}

Function.Dash.ChanCool {
    Input: name: Address
    Output: Integer
    Body: {
        i = Dash.ChanIdx(name)
        IfCondition LessThan(i, 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(Dereference(Add(Dash_State.chblu, Multiply(i, 8))))
    }
}

Function.Dash.ChanWarn {
    Input: name: Address
    Output: Integer
    Body: {
        i = Dash.ChanIdx(name)
        IfCondition LessThan(i, 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(Dereference(Add(Dash_State.chyel, Multiply(i, 8))))
    }
}

Function.Dash.ChanHot {
    Input: name: Address
    Output: Integer
    Body: {
        i = Dash.ChanIdx(name)
        IfCondition LessThan(i, 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(Dereference(Add(Dash_State.chred, Multiply(i, 8))))
    }
}

Function.Dash.ChanSetBand {
    Input: name: Address
    Input: c0: Integer
    Input: c1: Integer
    Input: c2: Integer
    Output: Integer
    Body: {
        i = Dash.ChanIdx(name)
        IfCondition LessThan(i, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition GreaterThan(c0, c1) ThenBlock: { c1 = Add(c0, 1) }
        IfCondition GreaterThan(c1, c2) ThenBlock: { c2 = Add(c1, 1) }
        StoreValue(Add(Dash_State.chblu, Multiply(i, 8)), c0)
        StoreValue(Add(Dash_State.chyel, Multiply(i, 8)), c1)
        StoreValue(Add(Dash_State.chred, Multiply(i, 8)), c2)
        ReturnValue(0)
    }
}

Function.Dash.Mix {
    Input: a: Integer
    Input: b: Integer
    Input: t: Integer
    Input: s: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(s, 1) ThenBlock: { s = 1 }
        IfCondition LessThan(t, 0) ThenBlock: { t = 0 }
        IfCondition GreaterThan(t, s) ThenBlock: { t = s }
        ReturnValue(Add(a, Divide(Multiply(Subtract(b, a), t), s)))
    }
}

Function.Dash.ChanColor {
    Input: name: Address
    Input: v: Integer
    Output: Integer
    Body: {
        lo = Dash.ChanLo(name)
        hi = Dash.ChanHi(name)
        c0 = Dash.ChanCool(name)
        c1 = Dash.ChanWarn(name)
        c2 = Dash.ChanHot(name)
        IfCondition EqualTo(Add(Add(c0, c1), c2), 0) ThenBlock: {
            span = Subtract(hi, lo)
            IfCondition LessThan(span, 1) ThenBlock: { span = 1 }
            c0 = Add(lo, Divide(span, 5))
            c1 = Add(lo, Divide(Multiply(span, 7), 10))
            c2 = Add(lo, Divide(Multiply(span, 9), 10))
        }
        br = 50
        bg = 140
        bb = 255
        gr = 50
        gg = 210
        gb = 90
        yr = 240
        yg = 200
        yb = 40
        rr = 220
        rg = 50
        rb = 55
        IfCondition LessEqual(v, c0) ThenBlock: { ReturnValue(FB_RGB(br, bg, bb)) }
        IfCondition LessEqual(v, c1) ThenBlock: {
            s = Subtract(c1, c0)
            t = Subtract(v, c0)
            ReturnValue(FB_RGB(Dash.Mix(br, gr, t, s), Dash.Mix(bg, gg, t, s), Dash.Mix(bb, gb, t, s)))
        }
        IfCondition LessEqual(v, c2) ThenBlock: {
            s = Subtract(c2, c1)
            t = Subtract(v, c1)
            ReturnValue(FB_RGB(Dash.Mix(gr, yr, t, s), Dash.Mix(gg, yg, t, s), Dash.Mix(gb, yb, t, s)))
        }
        s = Subtract(hi, c2)
        t = Subtract(v, c2)
        ReturnValue(FB_RGB(Dash.Mix(yr, rr, t, s), Dash.Mix(yg, rg, t, s), Dash.Mix(yb, rb, t, s)))
    }
}

Function.Dash.TraceGet {
    Input: pane: Integer
    Input: slot: Integer
    Output: Address
    Body: {
        IfCondition LessThan(pane, 0) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(slot, 0) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterThan(slot, 5) ThenBlock: { ReturnValue(0) }
        ReturnValue(Dereference(Add(Dash_State.tr, Multiply(Add(Multiply(pane, 6), slot), 8))))
    }
}

Function.Dash.TraceSet {
    Input: pane: Integer
    Input: slot: Integer
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition LessThan(pane, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition LessThan(slot, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition GreaterThan(slot, 5) ThenBlock: { ReturnValue(-1) }
        StoreValue(Add(Dash_State.tr, Multiply(Add(Multiply(pane, 6), slot), 8)), name)
        ReturnValue(0)
    }
}

Function.Dash.TraceCol {
    Input: slot: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(slot, 0) ThenBlock: { ReturnValue(FB_RGB(42, 212, 255)) }
        IfCondition EqualTo(slot, 1) ThenBlock: { ReturnValue(FB_RGB(232, 189, 80)) }
        IfCondition EqualTo(slot, 2) ThenBlock: { ReturnValue(FB_RGB(255, 90, 90)) }
        IfCondition EqualTo(slot, 3) ThenBlock: { ReturnValue(FB_RGB(80, 220, 120)) }
        IfCondition EqualTo(slot, 4) ThenBlock: { ReturnValue(FB_RGB(220, 110, 255)) }
        ReturnValue(FB_RGB(230, 230, 240))
    }
}

Function.Dash.TraceUsed {
    Input: pane: Integer
    Input: name: Address
    Input: skip: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }
        s = 0
        WhileLoop LessThan(s, 6) {
            IfCondition NotEqual(s, skip) ThenBlock: {
                t = Dash.TraceGet(pane, s)
                IfCondition NotEqual(t, 0) ThenBlock: {
                    IfCondition EqualTo(StringCompare(t, name), 0) ThenBlock: { ReturnValue(1) }
                }
            }
            s = Add(s, 1)
        }
        ReturnValue(0)
    }
}

Function.Dash.TblGet {
    Input: pane: Integer
    Input: slot: Integer
    Output: Address
    Body: {
        IfCondition LessThan(pane, 0) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(slot, 0) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterThan(slot, 31) ThenBlock: { ReturnValue(0) }
        ReturnValue(Dereference(Add(Dash_State.tb, Multiply(Add(Multiply(pane, 32), slot), 8))))
    }
}

Function.Dash.TblSet {
    Input: pane: Integer
    Input: slot: Integer
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition LessThan(pane, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition LessThan(slot, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition GreaterThan(slot, 31) ThenBlock: { ReturnValue(-1) }
        StoreValue(Add(Dash_State.tb, Multiply(Add(Multiply(pane, 32), slot), 8)), name)
        ReturnValue(0)
    }
}

Function.Dash.TblCount {
    Input: pane: Integer
    Output: Integer
    Body: {
        last = -1
        i = 0
        WhileLoop LessThan(i, 32) {
            IfCondition NotEqual(Dash.TblGet(pane, i), 0) ThenBlock: { last = i }
            i = Add(i, 1)
        }
        ReturnValue(Add(last, 1))
    }
}

Function.Dash.TblFill {
    Input: pane: Integer
    Output: Integer
    Body: {
        si = 0
        ci = 0
        WhileLoop And(LessThan(ci, Dash_State.nch), LessThan(si, 32)) {
            nm = Dereference(Add(Dash_State.chn, Multiply(ci, 16)))
            IfCondition GreaterThan(Dash.SLen(nm), 0) ThenBlock: {
                Dash.TblSet(pane, si, nm)
                si = Add(si, 1)
            }
            ci = Add(ci, 1)
        }
        WhileLoop LessThan(si, 32) {
            Dash.TblSet(pane, si, 0)
            si = Add(si, 1)
        }
        ReturnValue(Dash.TblCount(pane))
    }
}

Function.Dash.TblUsed {
    Input: pane: Integer
    Input: name: Address
    Input: skip: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }
        s = 0
        WhileLoop LessThan(s, 32) {
            IfCondition NotEqual(s, skip) ThenBlock: {
                t = Dash.TblGet(pane, s)
                IfCondition NotEqual(t, 0) ThenBlock: {
                    IfCondition EqualTo(StringCompare(t, name), 0) ThenBlock: { ReturnValue(1) }
                }
            }
            s = Add(s, 1)
        }
        ReturnValue(0)
    }
}

Function.Dash.TblMove {
    Input: pane: Integer
    Input: slot: Integer
    Input: dir: Integer
    Output: Integer
    Body: {
        n = Add(slot, dir)
        IfCondition LessThan(n, 0) ThenBlock: { ReturnValue(slot) }
        IfCondition GreaterThan(n, 31) ThenBlock: { ReturnValue(slot) }
        a = Dash.TblGet(pane, slot)
        b = Dash.TblGet(pane, n)
        Dash.TblSet(pane, slot, b)
        Dash.TblSet(pane, n, a)
        Dash_State.pslot = n
        Dash_State.dirty = 1
        ReturnValue(n)
    }
}

Function.Dash.TblPick {
    Input: pane: Integer
    Input: slot: Integer
    Input: nm: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(nm, 0) ThenBlock: {
            Dash.TblSet(pane, slot, 0)
            Dash_State.dirty = 1
            ReturnValue(0)
        }
        o = 0
        found = -1
        WhileLoop LessThan(o, 32) {
            IfCondition NotEqual(o, slot) ThenBlock: {
                t = Dash.TblGet(pane, o)
                IfCondition NotEqual(t, 0) ThenBlock: {
                    IfCondition EqualTo(StringCompare(t, nm), 0) ThenBlock: { found = o }
                }
            }
            o = Add(o, 1)
        }
        IfCondition GreaterEqual(found, 0) ThenBlock: {
            cur = Dash.TblGet(pane, slot)
            Dash.TblSet(pane, found, cur)
            Dash.TblSet(pane, slot, nm)
        }
        IfCondition LessThan(found, 0) ThenBlock: {
            Dash.TblSet(pane, slot, nm)
        }
        Dash_State.pick = nm
        Dash_State.pslot = slot
        Dash_State.dirty = 1
        ReturnValue(1)
    }
}

Function.Dash.DropOpen {
    Input: pane: Integer
    Input: slot: Integer
    Output: Integer
    Body: {
        Dash_State.drop = 1
        Dash_State.dpane = pane
        Dash_State.dslot = slot
        Dash_State.dtop = 0
        Dash_State.pslot = slot
        x = TextGrid_State.x
        y = TextGrid_State.y
        w = TextGrid_State.w
        rh = TextGrid_State.rh
        IfCondition LessThan(rh, 1) ThenBlock: { rh = 22 }
        vis = TextGrid_State.vis
        rel = Subtract(slot, TextGrid_State.top)
        IfCondition LessThan(rel, 0) ThenBlock: { rel = 0 }
        IfCondition GreaterThan(rel, vis) ThenBlock: { rel = vis }
        Dash_State.dx = x
        Dash_State.dy = Add(y, Multiply(Add(rel, 1), rh))
        Dash_State.dw = Subtract(w, 16)
        IfCondition LessThan(Dash_State.dw, 80) ThenBlock: { Dash_State.dw = 80 }
        n = Add(Dash_State.nch, 1)
        nh = Multiply(n, 18)
        IfCondition GreaterThan(nh, 200) ThenBlock: { nh = 200 }
        Dash_State.dh = nh
        IfCondition GreaterThan(Add(Dash_State.dy, Dash_State.dh), FB.height) ThenBlock: {
            Dash_State.dy = Subtract(FB.height, Add(Dash_State.dh, 4))
        }
        IfCondition LessThan(Dash_State.dy, 44) ThenBlock: { Dash_State.dy = 44 }
        Dash_State.dirty = 1
        ReturnValue(1)
    }
}

Function.Dash.DropClose {
    Output: Integer
    Body: {
        Dash_State.drop = 0
        Dash_State.dirty = 1
        ReturnValue(0)
    }
}

Function.Dash.DrawDrop {
    Output: Integer
    Body: {
        IfCondition EqualTo(Dash_State.drop, 0) ThenBlock: { ReturnValue(0) }
        dest = Anim.Dest()
        IfCondition EqualTo(dest, 0) ThenBlock: { ReturnValue(0) }
        x = Dash_State.dx
        y = Dash_State.dy
        w = Dash_State.dw
        h = Dash_State.dh
        FB_FillRect(x, y, w, h, FB_RGB(14, 23, 48))
        FB_Rect(x, y, w, h, FB_RGB(42, 212, 255))
        VFont_UseSize(13)
        rh = 18
        vis = Divide(h, rh)
        IfCondition LessThan(vis, 1) ThenBlock: { vis = 1 }
        n = Add(Dash_State.nch, 1)
        max = Subtract(n, vis)
        IfCondition LessThan(max, 0) ThenBlock: { max = 0 }
        IfCondition GreaterThan(Dash_State.dtop, max) ThenBlock: { Dash_State.dtop = max }
        i = 0
        WhileLoop LessThan(i, vis) {
            idx = Add(Dash_State.dtop, i)
            ry = Add(y, Multiply(i, rh))
            nm = "-"
            IfCondition LessThan(idx, Dash_State.nch) ThenBlock: {
                nm = Dereference(Add(Dash_State.chn, Multiply(idx, 16)))
                IfCondition EqualTo(nm, 0) ThenBlock: { nm = "-" }
            }
            fg = FB_RGB(216, 224, 240)
            IfCondition EqualTo(idx, Dash_State.nch) ThenBlock: {
                nm = "-"
                fg = FB_RGB(90, 100, 120)
            }
            cur = Dash.TblGet(Dash_State.dpane, Dash_State.dslot)
            IfCondition NotEqual(cur, 0) ThenBlock: {
                IfCondition EqualTo(StringCompare(cur, nm), 0) ThenBlock: {
                    FB_FillRect(Add(x, 1), ry, Subtract(w, 2), rh, FB_RGB(22, 54, 80))
                    fg = FB_RGB(42, 212, 255)
                }
            }
            VFont_DrawString(dest, nm, Dash.SLen(nm), Add(x, 8), Add(ry, 2), fg)
            i = Add(i, 1)
        }
        ReturnValue(1)
    }
}

Function.Dash.HitDrop {
    Input: px: Integer
    Input: py: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(Dash_State.drop, 0) ThenBlock: { ReturnValue(0) }
        x = Dash_State.dx
        y = Dash_State.dy
        w = Dash_State.dw
        h = Dash_State.dh
        IfCondition LessThan(px, x) ThenBlock: {
            Dash.DropClose()
            ReturnValue(1)
        }
        IfCondition GreaterEqual(px, Add(x, w)) ThenBlock: {
            Dash.DropClose()
            ReturnValue(1)
        }
        IfCondition LessThan(py, y) ThenBlock: {
            Dash.DropClose()
            ReturnValue(1)
        }
        IfCondition GreaterEqual(py, Add(y, h)) ThenBlock: {
            Dash.DropClose()
            ReturnValue(1)
        }
        rh = 18
        vis = Divide(h, rh)
        IfCondition LessThan(vis, 1) ThenBlock: { vis = 1 }
        row = Divide(Subtract(py, y), rh)
        idx = Add(Dash_State.dtop, row)
        nm = 0
        IfCondition LessThan(idx, Dash_State.nch) ThenBlock: {
            nm = Dereference(Add(Dash_State.chn, Multiply(idx, 16)))
        }
        Dash.TblPick(Dash_State.dpane, Dash_State.dslot, nm)
        Dash.DropClose()
        ReturnValue(1)
    }
}

Function.Dash.CycleTbl {
    Input: pane: Integer
    Input: slot: Integer
    Output: Integer
    Body: {
        cur = Dash.TblGet(pane, slot)
        start = Add(Dash.ChanIdx(cur), 1)
        k = 0
        WhileLoop LessEqual(k, Dash_State.nch) {
            j = Modulo(Add(start, k), Add(Dash_State.nch, 1))
            IfCondition EqualTo(j, Dash_State.nch) ThenBlock: {
                Dash.TblSet(pane, slot, 0)
                Dash_State.dirty = 1
                ReturnValue(0)
            }
            nm = Dereference(Add(Dash_State.chn, Multiply(j, 16)))
            IfCondition GreaterThan(Dash.SLen(nm), 0) ThenBlock: {
                IfCondition EqualTo(Dash.TblUsed(pane, nm, slot), 0) ThenBlock: {
                    Dash.TblSet(pane, slot, nm)
                    Dash_State.dirty = 1
                    ReturnValue(1)
                }
            }
            k = Add(k, 1)
        }
        Dash.TblSet(pane, slot, 0)
        Dash_State.dirty = 1
        ReturnValue(0)
    }
}

Function.Dash.CycleTrace {
    Input: pane: Integer
    Input: slot: Integer
    Output: Integer
    Body: {
        cur = Dash.TraceGet(pane, slot)
        start = Add(Dash.ChanIdx(cur), 1)
        k = 0
        WhileLoop LessEqual(k, Dash_State.nch) {
            j = Modulo(Add(start, k), Add(Dash_State.nch, 1))
            IfCondition EqualTo(j, Dash_State.nch) ThenBlock: {
                Dash.TraceSet(pane, slot, 0)
                Dash_State.dirty = 1
                ReturnValue(0)
            }
            nm = Dereference(Add(Dash_State.chn, Multiply(j, 16)))
            IfCondition EqualTo(Dash.TraceUsed(pane, nm, slot), 0) ThenBlock: {
                Dash.TraceSet(pane, slot, nm)
                Dash_State.dirty = 1
                ReturnValue(1)
            }
            k = Add(k, 1)
        }
        Dash.TraceSet(pane, slot, 0)
        Dash_State.dirty = 1
        ReturnValue(0)
    }
}

Function.Dash.PaneOfDesk {
    Input: desk: Integer
    Output: Integer
    Body: {
        i = 0
        WhileLoop LessThan(i, Dash_State.n) {
            IfCondition EqualTo(Dash.PWGet(i, 0), desk) ThenBlock: { ReturnValue(i) }
            i = Add(i, 1)
        }
        ReturnValue(-1)
    }
}

Function.Dash.ChanIdx {
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(-1) }
        i = 0
        WhileLoop LessThan(i, Dash_State.nch) {
            t = Dereference(Add(Dash_State.chn, Multiply(i, 16)))
            IfCondition EqualTo(StringCompare(t, name), 0) ThenBlock: {
                ReturnValue(i)
            }
            i = Add(i, 1)
        }
        ReturnValue(-1)
    }
}

Function.Dash.KindOf {
    Input: s: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(s, 0) ThenBlock: { ReturnValue(DashKind.ARC) }
        IfCondition EqualTo(StringCompare(s, "bar"), 0) ThenBlock: { ReturnValue(DashKind.BAR) }
        IfCondition EqualTo(StringCompare(s, "barh"), 0) ThenBlock: { ReturnValue(DashKind.BARH) }
        IfCondition EqualTo(StringCompare(s, "plot"), 0) ThenBlock: { ReturnValue(DashKind.PLOT) }
        IfCondition EqualTo(StringCompare(s, "strip"), 0) ThenBlock: { ReturnValue(DashKind.PLOT) }
        IfCondition EqualTo(StringCompare(s, "scope"), 0) ThenBlock: { ReturnValue(DashKind.PLOT) }
        IfCondition EqualTo(StringCompare(s, "gauge"), 0) ThenBlock: { ReturnValue(DashKind.ARC) }
        IfCondition EqualTo(StringCompare(s, "analog"), 0) ThenBlock: { ReturnValue(DashKind.ARC) }
        IfCondition EqualTo(StringCompare(s, "table"), 0) ThenBlock: { ReturnValue(DashKind.TABLE) }
        IfCondition EqualTo(StringCompare(s, "text"), 0) ThenBlock: { ReturnValue(DashKind.TABLE) }
        IfCondition EqualTo(StringCompare(s, "grid"), 0) ThenBlock: { ReturnValue(DashKind.TABLE) }
        ReturnValue(DashKind.ARC)
    }
}

Function.Dash.AddPane {
    Input: title: Address
    Input: kind: Integer
    Input: ch: Address
    Output: Integer
    Body: {
        i = Dash_State.n
        IfCondition GreaterEqual(i, Dash_State.cap) ThenBlock: { ReturnValue(-1) }
        desk = AppDesk.Open(Add(100, i), title, 0)
        IfCondition LessThan(desk, 0) ThenBlock: { ReturnValue(-1) }
        AppDesk.Set(desk, AppDeskWin.KIND, 10)
        Dash.PWSet(i, 0, desk)
        Dash.PWSet(i, 1, kind)
        Dash.PWSet(i, 2, -1)
        Dash.PWSet(i, 3, ch)
        Dash.ChanPut(ch, 0)
        Dash_State.n = Add(i, 1)
        ReturnValue(i)
    }
}

Function.Dash.BindChan {
    Input: pane: Integer
    Input: nm: Address
    Output: Integer
    Body: {
        IfCondition LessThan(pane, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition EqualTo(nm, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition EqualTo(GetByte(nm, 0), 0) ThenBlock: { ReturnValue(-1) }
        Dash.PWSet(pane, 3, nm)
        AppDesk.Set(Dash.PWGet(pane, 0), AppDeskWin.TITLE, nm)
        lo = Dash.ChanLo(nm)
        hi = Dash.ChanHi(nm)
        dc = Dash.ChanDec(nm)
        IfCondition GreaterThan(hi, lo) ThenBlock: {
            Dash.PWSet(pane, 4, lo)
            Dash.PWSet(pane, 5, hi)
        }
        Dash.PWSet(pane, 7, dc)
        Dash.Rebuild(pane)
        Dash_State.dirty = 1
        ReturnValue(0)
    }
}

Function.Dash.HitBind {
    Output: Integer
    Body: {
        IfCondition EqualTo(Dash_State.pick, 0) ThenBlock: { ReturnValue(0) }
        desk = AppDesk.hit_idx
        IfCondition LessThan(desk, 0) ThenBlock: { ReturnValue(0) }
        pane = Dash.PaneOfDesk(desk)
        IfCondition LessThan(pane, 0) ThenBlock: { ReturnValue(0) }
        kind = Dash.PWGet(pane, 1)
        IfCondition EqualTo(kind, DashKind.TABLE) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(kind, DashKind.PLOT) ThenBlock: { ReturnValue(0) }
        ReturnValue(Dash.BindChan(pane, Dash_State.pick))
    }
}

Function.Dash.ApplyGeom {
    Input: pane: Integer
    Input: x: Integer
    Input: y: Integer
    Input: w: Integer
    Input: h: Integer
    Output: Integer
    Body: {
        desk = Dash.PWGet(pane, 0)
        IfCondition LessThan(w, 48) ThenBlock: { w = 48 }
        IfCondition LessThan(h, 48) ThenBlock: { h = 48 }
        AppDesk.Set(desk, AppDeskWin.X, x)
        AppDesk.Set(desk, AppDeskWin.Y, y)
        AppDesk.Set(desk, AppDeskWin.W, w)
        AppDesk.Set(desk, AppDeskWin.H, h)
        ReturnValue(0)
    }
}

Function.Dash.MakeWidget {
    Input: pane: Integer
    Output: Integer
    Body: {
        desk = Dash.PWGet(pane, 0)
        kind = Dash.PWGet(pane, 1)
        cx = AppDesk.CX(desk)
        cy = AppDesk.CY(desk)
        cw = AppDesk.CW(desk)
        ch = AppDesk.CH(desk)
        wid = -1
        IfCondition EqualTo(kind, DashKind.ARC) ThenBlock: {
            sz = cw
            IfCondition GreaterThan(sz, ch) ThenBlock: { sz = ch }
            sz = Subtract(sz, 8)
            lo = Dash.PWGet(pane, 4)
            hi = Dash.PWGet(pane, 5)
            div = Dash.PWGet(pane, 6)
            Gauge.Scale(lo, hi, div)
            wid = Gauge.Arc(Add(cx, 4), Add(cy, 4), sz)
        }
        IfCondition EqualTo(kind, DashKind.BAR) ThenBlock: {
            wid = Gauge.Bar(Add(cx, 8), Add(cy, 8), Subtract(cw, 16), Subtract(ch, 16))
        }
        IfCondition EqualTo(kind, DashKind.BARH) ThenBlock: {
            wid = Gauge.BarH(Add(cx, 8), Add(cy, 8), Subtract(cw, 16), Subtract(ch, 16))
        }
        IfCondition EqualTo(kind, DashKind.PLOT) ThenBlock: {
            lo = Dash.PWGet(pane, 4)
            hi = Dash.PWGet(pane, 5)
            div = Dash.PWGet(pane, 6)
            Gauge.PlotScale(lo, hi, div)
            Gauge_State.pnums = 0
            wid = Gauge.Plot(Add(cx, 4), Add(cy, 4), Subtract(cw, 8), Subtract(ch, 8))
            Gauge_State.pnums = 1
        }
        IfCondition EqualTo(kind, DashKind.TABLE) ThenBlock: {
            IfCondition LessThan(Dash.TblCount(pane), 1) ThenBlock: { Dash.TblFill(pane) }
            TextGrid.Place(Add(cx, 4), Add(cy, 4), Subtract(cw, 8), Subtract(ch, 8))
            vis = Divide(Subtract(Subtract(ch, 8), 22), 22)
            IfCondition LessThan(vis, 1) ThenBlock: { vis = 1 }
            TextGrid.Layout(2, Add(vis, 1))
            TextGrid_State.rh = 22
            TextGrid.Set(0, 0, "Name", FB_RGB(180, 190, 210))
            TextGrid.Set(0, 1, "Value", FB_RGB(180, 190, 210))
            TextGrid.SetScroll(TextGrid_State.top, vis, Dash.TblCount(pane))
            wid = 0
        }
        Dash.PWSet(pane, 2, wid)
        ReturnValue(wid)
    }
}

Function.Dash.HideWidget {
    Input: pane: Integer
    Output: Integer
    Body: {
        kind = Dash.PWGet(pane, 1)
        wid = Dash.PWGet(pane, 2)
        IfCondition LessThan(wid, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(kind, DashKind.ARC) ThenBlock: {
            Anim.Show(Gauge.AWGet(wid, 3), 0)
            Anim.Show(Gauge.AWGet(wid, 4), 0)
        }
        IfCondition EqualTo(kind, DashKind.BAR) ThenBlock: {
            Anim.Show(Dereference(Add(Gauge_State.btsp, Multiply(wid, 8))), 0)
        }
        IfCondition EqualTo(kind, DashKind.BARH) ThenBlock: {
            Anim.Show(Dereference(Add(Gauge_State.btsp, Multiply(wid, 8))), 0)
        }
        IfCondition EqualTo(kind, DashKind.PLOT) ThenBlock: {
            Anim.Show(Dereference(Add(Gauge_State.ptsp, Multiply(wid, 8))), 0)
        }
        ReturnValue(0)
    }
}

Function.Dash.Rebuild {
    Input: pane: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(pane, 0) ThenBlock: { ReturnValue(-1) }
        kind = Dash.PWGet(pane, 1)
        wid = Dash.PWGet(pane, 2)
        ch = Dash.PWGet(pane, 3)
        lo = Dash.PWGet(pane, 4)
        hi = Dash.PWGet(pane, 5)
        div = Dash.PWGet(pane, 6)
        dec = Dash.PWGet(pane, 7)
        IfCondition NotEqual(ch, 0) ThenBlock: {
            Dash.ChanSetDec(ch, dec)
            IfCondition GreaterThan(hi, lo) ThenBlock: { Dash.ChanSetRange(ch, lo, hi) }
        }
        IfCondition EqualTo(kind, DashKind.ARC) ThenBlock: {
            IfCondition GreaterEqual(wid, 0) ThenBlock: {
                Gauge.AWSet(wid, 2, 0)
                desk = Dash.PWGet(pane, 0)
                sz = AppDesk.CW(desk)
                chh = AppDesk.CH(desk)
                IfCondition GreaterThan(sz, chh) ThenBlock: { sz = chh }
                sz = Subtract(sz, 8)
                Gauge.ArcResize(wid, sz, lo, hi, div)
            }
        }
        Dash_State.dirty = 1
        ReturnValue(0)
    }
}

Function.Dash.Reset {
    Output: Integer
    Body: {
        i = 0
        WhileLoop LessThan(i, Dash_State.n) {
            Dash.HideWidget(i)
            desk = Dash.PWGet(i, 0)
            IfCondition GreaterEqual(desk, 0) ThenBlock: { AppDesk.Close(desk) }
            i = Add(i, 1)
        }
        Dash_State.n = 0
        Dash_State.nch = 0
        Dash_State.pos = 0
        Dash_State.nlog = 0
        ReturnValue(0)
    }
}

Function.Dash.HitPane {
    Input: px: Integer
    Input: py: Integer
    Output: Integer
    Body: {
        zi = Subtract(AppDesk.n, 1)
        WhileLoop GreaterEqual(zi, 0) {
            desk = AppDesk.AtZ(zi)
            IfCondition EqualTo(AppDesk.Get(desk, AppDeskWin.LIVE), 1) ThenBlock: {
                x = AppDesk.Get(desk, AppDeskWin.X)
                y = AppDesk.Get(desk, AppDeskWin.Y)
                w = AppDesk.Get(desk, AppDeskWin.W)
                h = AppDesk.Get(desk, AppDeskWin.H)
                IfCondition GreaterEqual(px, x) ThenBlock: {
                    IfCondition GreaterEqual(py, y) ThenBlock: {
                        IfCondition LessThan(px, Add(x, w)) ThenBlock: {
                            IfCondition LessThan(py, Add(y, h)) ThenBlock: {
                                pane = Dash.PaneOfDesk(desk)
                                IfCondition GreaterEqual(pane, 0) ThenBlock: { ReturnValue(pane) }
                            }
                        }
                    }
                }
            }
            zi = Subtract(zi, 1)
        }
        ReturnValue(-1)
    }
}

Function.Dash.LoadJSON {
    Input: path: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(Dash.Init(), 0) ThenBlock: { ReturnValue(-1) }
        IfCondition GreaterThan(Dash_State.n, 0) ThenBlock: { Dash.Reset() }
        fd = SystemCall(2, path, 0, 0)
        IfCondition LessThan(fd, 0) ThenBlock: { ReturnValue(-2) }
        IfCondition EqualTo(Dash_State.jbuf, 0) ThenBlock: {
            Dash_State.jbuf = Allocate(16384)
        }
        n = SystemCall(0, fd, Dash_State.jbuf, 16380)
        SystemCall(3, fd, 0, 0)
        IfCondition LessEqual(n, 0) ThenBlock: { ReturnValue(-3) }
        SetByte(Dash_State.jbuf, n, 0)
        tagged = ParseJSON(Dash_State.jbuf)
        obj = JSON.AsObject(tagged)
        IfCondition EqualTo(obj, 0) ThenBlock: { ReturnValue(-4) }
        Dash_State.title = JSON.GetString(obj, "name")
        chs = JSON.GetArray(obj, "channels")
        IfCondition NotEqual(chs, 0) ThenBlock: {
            nc = JSON.ArrayLength(chs)
            ci = 0
            WhileLoop LessThan(ci, nc) {
                Dash.ChanPut(JSON.AsString(JSON.ArrayGet(chs, ci)), 0)
                ci = Add(ci, 1)
            }
        }
        arr = JSON.GetArray(obj, "windows")
        IfCondition EqualTo(arr, 0) ThenBlock: { ReturnValue(-5) }
        nw = JSON.ArrayLength(arr)
        i = 0
        WhileLoop LessThan(i, nw) {
            wt = JSON.ArrayGet(arr, i)
            wo = JSON.AsObject(wt)
            title = JSON.GetString(wo, "title")
            kind = Dash.KindOf(JSON.GetString(wo, "kind"))
            ch = JSON.GetString(wo, "channel")
            pane = Dash.AddPane(title, kind, ch)
            IfCondition GreaterEqual(pane, 0) ThenBlock: {
                x = JSON.GetNumber(wo, "x")
                y = JSON.GetNumber(wo, "y")
                w = JSON.GetNumber(wo, "w")
                h = JSON.GetNumber(wo, "h")
                Dash.ApplyGeom(pane, x, y, w, h)
                lo = JSON.GetNumber(wo, "lo")
                hi = JSON.GetNumber(wo, "hi")
                div = JSON.GetNumber(wo, "div")
                Dash.PWSet(pane, 4, lo)
                Dash.PWSet(pane, 5, hi)
                Dash.PWSet(pane, 6, div)
                dec = JSON.GetNumber(wo, "dec")
                Dash.PWSet(pane, 7, dec)
                IfCondition NotEqual(ch, 0) ThenBlock: {
                    Dash.ChanSetDec(ch, dec)
                    IfCondition GreaterThan(hi, lo) ThenBlock: { Dash.ChanSetRange(ch, lo, hi) }
                    IfCondition EqualTo(JSON.GetType(wo, "cool"), JType.NUMBER) ThenBlock: {
                        Dash.ChanSetBand(ch, JSON.GetNumber(wo, "cool"), JSON.GetNumber(wo, "warn"), JSON.GetNumber(wo, "hot"))
                    }
                }
                Dash.MakeWidget(pane)
                wid = Dash.PWGet(pane, 2)
                IfCondition EqualTo(kind, DashKind.PLOT) ThenBlock: {
                    Gauge.PlotRange(wid, lo, hi)
                    trs = JSON.GetArray(wo, "traces")
                    IfCondition NotEqual(trs, 0) ThenBlock: {
                        nt = JSON.ArrayLength(trs)
                        IfCondition GreaterThan(nt, 6) ThenBlock: { nt = 6 }
                        si = 0
                        WhileLoop LessThan(si, nt) {
                            tn = JSON.AsString(JSON.ArrayGet(trs, si))
                            IfCondition EqualTo(Dash.SLen(tn), 0) ThenBlock: { tn = 0 }
                            Dash.TraceSet(pane, si, tn)
                            si = Add(si, 1)
                        }
                    }
                    IfCondition EqualTo(trs, 0) ThenBlock: {
                        Dash.TraceSet(pane, 0, ch)
                    }
                }
                IfCondition EqualTo(kind, DashKind.TABLE) ThenBlock: {
                    rws = JSON.GetArray(wo, "rows")
                    IfCondition NotEqual(rws, 0) ThenBlock: {
                        nt = JSON.ArrayLength(rws)
                        IfCondition GreaterThan(nt, 32) ThenBlock: { nt = 32 }
                        si = 0
                        WhileLoop LessThan(si, 32) {
                            Dash.TblSet(pane, si, 0)
                            si = Add(si, 1)
                        }
                        si = 0
                        WhileLoop LessThan(si, nt) {
                            tn = JSON.AsString(JSON.ArrayGet(rws, si))
                            IfCondition EqualTo(Dash.SLen(tn), 0) ThenBlock: { tn = 0 }
                            Dash.TblSet(pane, si, tn)
                            si = Add(si, 1)
                        }
                    }
                    IfCondition EqualTo(rws, 0) ThenBlock: { Dash.TblFill(pane) }
                }
            }
            i = Add(i, 1)
        }
        deco = JSON.GetObject(obj, "dec")
        IfCondition NotEqual(deco, 0) ThenBlock: {
            ci = 0
            WhileLoop LessThan(ci, Dash_State.nch) {
                nm = Dereference(Add(Dash_State.chn, Multiply(ci, 16)))
                IfCondition EqualTo(JSON.GetType(deco, nm), JType.NUMBER) ThenBlock: {
                    Dash.ChanSetDec(nm, JSON.GetNumber(deco, nm))
                }
                ci = Add(ci, 1)
            }
        }
        Dash_State.path = path
        logp = JSON.GetString(obj, "log")
        Dash_State.logp = logp
        IfCondition NotEqual(logp, 0) ThenBlock: {
            IfCondition LessThan(Dash.LoadJSONL(logp), 1) ThenBlock: {
                Dash.Synth()
            }
        }
        IfCondition EqualTo(logp, 0) ThenBlock: {
            Dash.Synth()
        }
        ReturnValue(Dash_State.n)
    }
}

Function.Dash.LoadJSONL {
    Input: path: Address
    Output: Integer
    Body: {
        fd = SystemCall(2, path, 0, 0)
        IfCondition LessThan(fd, 0) ThenBlock: { ReturnValue(-1) }
        cap = 2097152
        raw = Allocate(cap)
        IfCondition EqualTo(raw, 0) ThenBlock: {
            SystemCall(3, fd, 0, 0)
            ReturnValue(-1)
        }
        n = SystemCall(0, fd, raw, Subtract(cap, 1))
        SystemCall(3, fd, 0, 0)
        IfCondition LessEqual(n, 0) ThenBlock: {
            Deallocate(raw, cap)
            ReturnValue(-2)
        }
        SetByte(raw, n, 0)
        nlog = 0
        i = 0
        WhileLoop LessThan(i, n) {
            IfCondition EqualTo(GetByte(raw, i), 10) ThenBlock: { nlog = Add(nlog, 1) }
            i = Add(i, 1)
        }
        IfCondition NotEqual(GetByte(raw, Subtract(n, 1)), 10) ThenBlock: {
            nlog = Add(nlog, 1)
        }
        IfCondition LessThan(nlog, 1) ThenBlock: {
            Deallocate(raw, cap)
            ReturnValue(-3)
        }
        IfCondition GreaterThan(nlog, 8000) ThenBlock: { nlog = 8000 }
        nch = Dash_State.nch
        IfCondition LessThan(nch, 1) ThenBlock: {
            Deallocate(raw, cap)
            ReturnValue(-4)
        }
        Dash_State.nlog = nlog
        Dash_State.log = Allocate(Multiply(Multiply(nlog, nch), 8))
        IfCondition EqualTo(Dash_State.log, 0) ThenBlock: {
            Deallocate(raw, cap)
            ReturnValue(-5)
        }
        line = Allocate(256)
        t = 0
        i = 0
        WhileLoop And(LessThan(i, n), LessThan(t, nlog)) {
            ln = 0
            WhileLoop And(LessThan(i, n), NotEqual(GetByte(raw, i), 10)) {
                IfCondition LessThan(ln, 254) ThenBlock: {
                    SetByte(line, ln, GetByte(raw, i))
                    ln = Add(ln, 1)
                }
                i = Add(i, 1)
            }
            SetByte(line, ln, 0)
            IfCondition GreaterThan(ln, 2) ThenBlock: {
                tagged = ParseJSON(line)
                obj = JSON.AsObject(tagged)
                IfCondition NotEqual(obj, 0) ThenBlock: {
                    ci = 0
                    WhileLoop LessThan(ci, nch) {
                        nm = Dereference(Add(Dash_State.chn, Multiply(ci, 16)))
                        Dash.SampPut(t, ci, JSON.GetNumber(obj, nm))
                        ci = Add(ci, 1)
                    }
                    t = Add(t, 1)
                }
            }
            IfCondition LessThan(i, n) ThenBlock: { i = Add(i, 1) }
        }
        Deallocate(line, 256)
        Deallocate(raw, cap)
        Dash_State.nlog = t
        Dash_State.pos = 0
        Dash.FollowView()
        Dash.Apply()
        Dash.FillPlots()
        Dash.WritePlay()
        PrintMessage("jsonl n=")
        PrintNumber(t)
        PrintMessage(" ch=")
        PrintNumber(nch)
        PrintMessage("\n")
        ReturnValue(t)
    }
}

Function.Dash.SaveJSONL {
    Output: Integer
    Body: {
        IfCondition EqualTo(Dash_State.log, 0) ThenBlock: { ReturnValue(-1) }
        fd = SystemCall(2, "ECU/dash/logs/play.jsonl", 577, 420)
        IfCondition LessThan(fd, 0) ThenBlock: { ReturnValue(-1) }
        t = 0
        WhileLoop LessThan(t, Dash_State.nlog) {
            s = "{\"t\":"
            SystemCall(1, fd, s, Dash.SLen(s))
            IfCondition EqualTo(Dash_State.st, 0) ThenBlock: { Dash_State.st = Allocate(64) }
            buf = Dash_State.st
            off = Dash.DecPut(buf, 0, t)
            SystemCall(1, fd, buf, off)
            ci = 0
            WhileLoop LessThan(ci, Dash_State.nch) {
                s = ",\""
                SystemCall(1, fd, s, Dash.SLen(s))
                nm = Dereference(Add(Dash_State.chn, Multiply(ci, 16)))
                IfCondition NotEqual(nm, 0) ThenBlock: {
                    SystemCall(1, fd, nm, Dash.SLen(nm))
                }
                s = "\":"
                SystemCall(1, fd, s, Dash.SLen(s))
                off = Dash.DecPut(buf, 0, Dash.SampGet(t, ci))
                SystemCall(1, fd, buf, off)
                ci = Add(ci, 1)
            }
            s = "}\n"
            SystemCall(1, fd, s, Dash.SLen(s))
            t = Add(t, 1)
        }
        SystemCall(3, fd, 0, 0)
        PrintMessage("jsonl save\n")
        ReturnValue(0)
    }
}

Function.Dash.Wave {
    Input: tick: Integer
    Input: phase: Integer
    Input: lo: Integer
    Input: hi: Integer
    Output: Integer
    Body: {
        d2r = Float_Div(0x400921FB54442D18, Float_FromInt(180))
        deg = Modulo(Add(Multiply(tick, 4), phase), 360)
        a = Float_Mul(d2r, Float_FromInt(deg))
        s = Gauge.Sin(a)
        mid = Divide(Add(lo, hi), 2)
        amp = Divide(Subtract(hi, lo), 2)
        ReturnValue(Add(mid, Float_ToInt(Float_Mul(s, Float_FromInt(amp)))))
    }
}

Function.Dash.SampPut {
    Input: t: Integer
    Input: ci: Integer
    Input: v: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(Dash_State.log, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition LessThan(ci, 0) ThenBlock: { ReturnValue(-1) }
        off = Add(Multiply(t, Dash_State.nch), ci)
        StoreValue(Add(Dash_State.log, Multiply(off, 8)), v)
        ReturnValue(0)
    }
}

Function.Dash.SampGet {
    Input: t: Integer
    Input: ci: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(Dash_State.log, 0) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(ci, 0) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(t, 0) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterEqual(t, Dash_State.nlog) ThenBlock: { ReturnValue(0) }
        off = Add(Multiply(t, Dash_State.nch), ci)
        ReturnValue(Dereference(Add(Dash_State.log, Multiply(off, 8))))
    }
}

Function.Dash.DecPut {
    Input: buf: Address
    Input: off: Integer
    Input: n: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(n, 0) ThenBlock: {
            SetByte(buf, off, 45)
            off = Add(off, 1)
            n = Subtract(0, n)
        }
        IfCondition EqualTo(n, 0) ThenBlock: {
            SetByte(buf, off, 48)
            ReturnValue(Add(off, 1))
        }
        tmp = Allocate(16)
        k = 0
        WhileLoop GreaterThan(n, 0) {
            SetByte(tmp, k, Add(48, Modulo(n, 10)))
            n = Divide(n, 10)
            k = Add(k, 1)
        }
        i = Subtract(k, 1)
        WhileLoop GreaterEqual(i, 0) {
            SetByte(buf, off, GetByte(tmp, i))
            off = Add(off, 1)
            i = Subtract(i, 1)
        }
        Deallocate(tmp, 16)
        ReturnValue(off)
    }
}

Function.Dash.Atoi {
    Input: s: Address
    Output: Integer
    Body: {
        i = 0
        sign = 1
        n = 0
        WhileLoop LessThan(i, 80) {
            c = GetByte(s, i)
            IfCondition EqualTo(c, 0) ThenBlock: { BreakLoop }
            IfCondition EqualTo(c, 45) ThenBlock: { BreakLoop }
            IfCondition And(GreaterEqual(c, 48), LessEqual(c, 57)) ThenBlock: { BreakLoop }
            i = Add(i, 1)
        }
        c = GetByte(s, i)
        IfCondition EqualTo(c, 45) ThenBlock: {
            sign = -1
            i = Add(i, 1)
        }
        WhileLoop LessThan(i, 80) {
            c = GetByte(s, i)
            IfCondition EqualTo(c, 0) ThenBlock: { BreakLoop }
            IfCondition LessThan(c, 48) ThenBlock: { BreakLoop }
            IfCondition GreaterThan(c, 57) ThenBlock: { BreakLoop }
            n = Add(Multiply(n, 10), Subtract(c, 48))
            i = Add(i, 1)
        }
        ReturnValue(Multiply(n, sign))
    }
}

Function.Dash.WritePlay {
    Output: Integer
    Body: {
        IfCondition EqualTo(Dash_State.st, 0) ThenBlock: {
            Dash_State.st = Allocate(64)
        }
        buf = Dash_State.st
        off = 0
        off = Dash.DecPut(buf, off, Dash_State.pos)
        SetByte(buf, off, 32)
        off = Add(off, 1)
        off = Dash.DecPut(buf, off, Dash_State.nlog)
        SetByte(buf, off, 32)
        off = Add(off, 1)
        off = Dash.DecPut(buf, off, Dash_State.play)
        SetByte(buf, off, 32)
        off = Add(off, 1)
        off = Dash.DecPut(buf, off, Dash_State.dir)
        SetByte(buf, off, 10)
        off = Add(off, 1)
        fd = SystemCall(2, "/tmp/anim_app/play.txt", 577, 420)
        IfCondition LessThan(fd, 0) ThenBlock: { ReturnValue(-1) }
        SystemCall(1, fd, buf, off)
        SystemCall(3, fd, 0, 0)
        ReturnValue(0)
    }
}

Function.Dash.Apply {
    Output: Integer
    Body: {
        t = Dash_State.pos
        i = 0
        WhileLoop LessThan(i, Dash_State.nch) {
            nm = Dereference(Add(Dash_State.chn, Multiply(i, 16)))
            v = Dash.SampGet(t, i)
            StoreValue(Add(Dash_State.chn, Add(Multiply(i, 16), 8)), v)
            i = Add(i, 1)
        }
        ReturnValue(t)
    }
}

Function.Dash.FillPlots {
    Output: Integer
    Body: {
        t1 = Dash_State.pos
        win = Gauge_State.pcap
        t0 = Subtract(Add(t1, 1), win)
        IfCondition LessThan(t0, 0) ThenBlock: { t0 = 0 }
        i = 0
        WhileLoop LessThan(i, Dash_State.n) {
            IfCondition EqualTo(Dash.PWGet(i, 1), DashKind.PLOT) ThenBlock: {
                Gauge.PlotClear(Dash.PWGet(i, 2))
            }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

Function.Dash.PushPlots {
    Output: Integer
    Body: {
        ReturnValue(0)
    }
}

Function.Dash.Seek {
    Input: p: Integer
    Output: Integer
    Body: {
        last = Subtract(Dash_State.nlog, 1)
        IfCondition LessThan(last, 0) ThenBlock: { last = 0 }
        IfCondition LessThan(p, 0) ThenBlock: { p = 0 }
        IfCondition GreaterThan(p, last) ThenBlock: { p = last }
        Dash_State.pos = p
        Dash_State.play = 0
        Dash_State.dirty = 1
        Dash.FollowView()
        Dash.Apply()
        Dash.FillPlots()
        Dash.WritePlay()
        ReturnValue(p)
    }
}

Function.Dash.FollowView {
    Output: Integer
    Body: {
        win = Gauge_State.pcap
        IfCondition LessThan(win, 2) ThenBlock: { win = 256 }
        v = Subtract(Add(Dash_State.pos, 1), win)
        IfCondition LessThan(v, 0) ThenBlock: { v = 0 }
        last = Subtract(Dash_State.nlog, 1)
        IfCondition LessThan(last, 0) ThenBlock: { last = 0 }
        maxv = Subtract(Add(last, 1), win)
        IfCondition LessThan(maxv, 0) ThenBlock: { maxv = 0 }
        IfCondition GreaterThan(v, maxv) ThenBlock: { v = maxv }
        Dash_State.view0 = v
        ReturnValue(v)
    }
}

Function.Dash.Scrub {
    Input: p: Integer
    Input: follow: Integer
    Output: Integer
    Body: {
        last = Subtract(Dash_State.nlog, 1)
        IfCondition LessThan(last, 0) ThenBlock: { last = 0 }
        IfCondition LessThan(p, 0) ThenBlock: { p = 0 }
        IfCondition GreaterThan(p, last) ThenBlock: { p = last }
        Dash_State.pos = p
        Dash_State.play = 0
        Dash_State.dirty = 1
        IfCondition EqualTo(follow, 1) ThenBlock: { Dash.FollowView() }
        Dash.Apply()
        Dash.WritePlay()
        ReturnValue(p)
    }
}

Function.Dash.Go {
    Input: d: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(d, 0) ThenBlock: { d = 1 }
        Dash_State.dir = d
        Dash_State.play = 1
        Dash_State.dirty = 1
        last = Subtract(Dash_State.nlog, 1)
        IfCondition LessThan(last, 0) ThenBlock: { last = 0 }
        IfCondition And(GreaterThan(d, 0), GreaterEqual(Dash_State.pos, last)) ThenBlock: {
            Dash_State.pos = 0
        }
        IfCondition And(LessThan(d, 0), LessEqual(Dash_State.pos, 0)) ThenBlock: {
            Dash_State.pos = last
        }
        Dash.FollowView()
        Dash.Apply()
        Dash.FillPlots()
        Dash.WritePlay()
        ReturnValue(0)
    }
}

Function.Dash.Stop {
    Output: Integer
    Body: {
        Dash_State.play = 0
        Dash_State.dir = 1
        Dash_State.pos = 0
        Dash_State.dirty = 1
        Dash.FollowView()
        Dash.Apply()
        Dash.FillPlots()
        Dash.WritePlay()
        ReturnValue(0)
    }
}

Function.Dash.Pause {
    Output: Integer
    Body: {
        Dash_State.play = 0
        Dash_State.dirty = 1
        Dash.WritePlay()
        ReturnValue(0)
    }
}

Function.Dash.Synth {
    Output: Integer
    Body: {
        nch = Dash_State.nch
        IfCondition LessThan(nch, 1) ThenBlock: { ReturnValue(0) }
        n = Dash_State.nlog
        IfCondition LessThan(n, 16) ThenBlock: { n = 1800 }
        Dash_State.nlog = n
        bytes = Multiply(Multiply(n, nch), 8)
        Dash_State.log = Allocate(bytes)
        IfCondition EqualTo(Dash_State.log, 0) ThenBlock: { ReturnValue(-1) }
        t = 0
        WhileLoop LessThan(t, n) {
            i = 0
            WhileLoop LessThan(i, Dash_State.n) {
                ch = Dash.PWGet(i, 3)
                IfCondition NotEqual(ch, 0) ThenBlock: {
                    ci = Dash.ChanIdx(ch)
                    IfCondition GreaterEqual(ci, 0) ThenBlock: {
                        lo = Dash.PWGet(i, 4)
                        hi = Dash.PWGet(i, 5)
                        phase = Multiply(i, 37)
                        Dash.SampPut(t, ci, Dash.Wave(t, phase, lo, hi))
                    }
                }
                i = Add(i, 1)
            }
            t = Add(t, 1)
        }
        Dash_State.pos = 0
        Dash_State.play = 1
        Dash_State.dir = 1
        Dash.Apply()
        Dash.FillPlots()
        Dash.WritePlay()
        PrintMessage("synth n=")
        PrintNumber(n)
        PrintMessage(" ch=")
        PrintNumber(nch)
        PrintMessage("\n")
        ReturnValue(n)
    }
}

Function.Dash.SLen {
    Input: s: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(s, 0) ThenBlock: { ReturnValue(0) }
        i = 0
        WhileLoop LessThan(i, 80) {
            IfCondition EqualTo(GetByte(s, i), 0) ThenBlock: { ReturnValue(i) }
            i = Add(i, 1)
        }
        ReturnValue(i)
    }
}

Function.Dash.KindName {
    Input: kind: Integer
    Output: Address
    Body: {
        IfCondition EqualTo(kind, DashKind.BAR) ThenBlock: { ReturnValue("bar") }
        IfCondition EqualTo(kind, DashKind.BARH) ThenBlock: { ReturnValue("barh") }
        IfCondition EqualTo(kind, DashKind.PLOT) ThenBlock: { ReturnValue("plot") }
        IfCondition EqualTo(kind, DashKind.TABLE) ThenBlock: { ReturnValue("table") }
        ReturnValue("arc")
    }
}

Function.Dash.SaveJSON {
    Output: Integer
    Body: {
        dest = Dash_State.path
        IfCondition EqualTo(dest, 0) ThenBlock: { dest = "ECU/dash/ls1_synth.json" }
        fd = SystemCall(2, dest, 577, 420)
        IfCondition LessThan(fd, 0) ThenBlock: { ReturnValue(-1) }
        s = "{\n"
        SystemCall(1, fd, s, Dash.SLen(s))
        s = "  \"windows\": [\n"
        SystemCall(1, fd, s, Dash.SLen(s))
        i = 0
        first = 1
        WhileLoop LessThan(i, Dash_State.n) {
            desk = Dash.PWGet(i, 0)
            IfCondition EqualTo(AppDesk.Get(desk, AppDeskWin.LIVE), 1) ThenBlock: {
                IfCondition EqualTo(first, 0) ThenBlock: {
                    s = ",\n"
                    SystemCall(1, fd, s, Dash.SLen(s))
                }
                first = 0
                s = "    {\n      \"title\": \""
                SystemCall(1, fd, s, Dash.SLen(s))
                t = AppDesk.Get(desk, AppDeskWin.TITLE)
                IfCondition NotEqual(t, 0) ThenBlock: {
                    SystemCall(1, fd, t, Dash.SLen(t))
                }
                s = "\",\n      \"kind\": \""
                SystemCall(1, fd, s, Dash.SLen(s))
                kn = Dash.KindName(Dash.PWGet(i, 1))
                SystemCall(1, fd, kn, Dash.SLen(kn))
                s = "\",\n      \"channel\": \""
                SystemCall(1, fd, s, Dash.SLen(s))
                ch = Dash.PWGet(i, 3)
                IfCondition NotEqual(ch, 0) ThenBlock: {
                    SystemCall(1, fd, ch, Dash.SLen(ch))
                }
                s = "\",\n      \"lo\": "
                SystemCall(1, fd, s, Dash.SLen(s))
                IfCondition EqualTo(Dash_State.st, 0) ThenBlock: { Dash_State.st = Allocate(64) }
                buf = Dash_State.st
                off = Dash.DecPut(buf, 0, Dash.PWGet(i, 4))
                SystemCall(1, fd, buf, off)
                s = ",\n      \"hi\": "
                SystemCall(1, fd, s, Dash.SLen(s))
                off = Dash.DecPut(buf, 0, Dash.PWGet(i, 5))
                SystemCall(1, fd, buf, off)
                s = ",\n      \"div\": "
                SystemCall(1, fd, s, Dash.SLen(s))
                off = Dash.DecPut(buf, 0, Dash.PWGet(i, 6))
                SystemCall(1, fd, buf, off)
                s = ",\n      \"dec\": "
                SystemCall(1, fd, s, Dash.SLen(s))
                off = Dash.DecPut(buf, 0, Dash.PWGet(i, 7))
                SystemCall(1, fd, buf, off)
                chb = Dash.PWGet(i, 3)
                IfCondition NotEqual(chb, 0) ThenBlock: {
                    s = ",\n      \"cool\": "
                    SystemCall(1, fd, s, Dash.SLen(s))
                    off = Dash.DecPut(buf, 0, Dash.ChanCool(chb))
                    SystemCall(1, fd, buf, off)
                    s = ",\n      \"warn\": "
                    SystemCall(1, fd, s, Dash.SLen(s))
                    off = Dash.DecPut(buf, 0, Dash.ChanWarn(chb))
                    SystemCall(1, fd, buf, off)
                    s = ",\n      \"hot\": "
                    SystemCall(1, fd, s, Dash.SLen(s))
                    off = Dash.DecPut(buf, 0, Dash.ChanHot(chb))
                    SystemCall(1, fd, buf, off)
                }
                IfCondition EqualTo(Dash.PWGet(i, 1), DashKind.PLOT) ThenBlock: {
                    s = ",\n      \"traces\": ["
                    SystemCall(1, fd, s, Dash.SLen(s))
                    si = 0
                    tf = 1
                    WhileLoop LessThan(si, 6) {
                        tn = Dash.TraceGet(i, si)
                        IfCondition EqualTo(tf, 0) ThenBlock: {
                            s = ", "
                            SystemCall(1, fd, s, Dash.SLen(s))
                        }
                        tf = 0
                        s = "\""
                        SystemCall(1, fd, s, Dash.SLen(s))
                        IfCondition NotEqual(tn, 0) ThenBlock: {
                            SystemCall(1, fd, tn, Dash.SLen(tn))
                        }
                        s = "\""
                        SystemCall(1, fd, s, Dash.SLen(s))
                        si = Add(si, 1)
                    }
                    s = "]"
                    SystemCall(1, fd, s, Dash.SLen(s))
                }
                IfCondition EqualTo(Dash.PWGet(i, 1), DashKind.TABLE) ThenBlock: {
                    s = ",\n      \"rows\": ["
                    SystemCall(1, fd, s, Dash.SLen(s))
                    si = 0
                    tf = 1
                    nt = Dash.TblCount(i)
                    WhileLoop LessThan(si, nt) {
                        IfCondition EqualTo(tf, 0) ThenBlock: {
                            s = ", "
                            SystemCall(1, fd, s, Dash.SLen(s))
                        }
                        tf = 0
                        s = "\""
                        SystemCall(1, fd, s, Dash.SLen(s))
                        tn = Dash.TblGet(i, si)
                        IfCondition NotEqual(tn, 0) ThenBlock: {
                            SystemCall(1, fd, tn, Dash.SLen(tn))
                        }
                        s = "\""
                        SystemCall(1, fd, s, Dash.SLen(s))
                        si = Add(si, 1)
                    }
                    s = "]"
                    SystemCall(1, fd, s, Dash.SLen(s))
                }
                s = ",\n      \"x\": "
                SystemCall(1, fd, s, Dash.SLen(s))
                off = Dash.DecPut(buf, 0, AppDesk.Get(desk, AppDeskWin.X))
                SystemCall(1, fd, buf, off)
                s = ",\n      \"y\": "
                SystemCall(1, fd, s, Dash.SLen(s))
                off = Dash.DecPut(buf, 0, AppDesk.Get(desk, AppDeskWin.Y))
                SystemCall(1, fd, buf, off)
                s = ",\n      \"w\": "
                SystemCall(1, fd, s, Dash.SLen(s))
                off = Dash.DecPut(buf, 0, AppDesk.Get(desk, AppDeskWin.W))
                SystemCall(1, fd, buf, off)
                s = ",\n      \"h\": "
                SystemCall(1, fd, s, Dash.SLen(s))
                off = Dash.DecPut(buf, 0, AppDesk.Get(desk, AppDeskWin.H))
                SystemCall(1, fd, buf, off)
                s = "\n    }"
                SystemCall(1, fd, s, Dash.SLen(s))
            }
            i = Add(i, 1)
        }
        s = "\n  ]"
        SystemCall(1, fd, s, Dash.SLen(s))
        IfCondition GreaterThan(Dash_State.nch, 0) ThenBlock: {
            s = ",\n  \"channels\": ["
            SystemCall(1, fd, s, Dash.SLen(s))
            ci = 0
            WhileLoop LessThan(ci, Dash_State.nch) {
                IfCondition GreaterThan(ci, 0) ThenBlock: {
                    s = ", "
                    SystemCall(1, fd, s, Dash.SLen(s))
                }
                s = "\""
                SystemCall(1, fd, s, Dash.SLen(s))
                nm = Dereference(Add(Dash_State.chn, Multiply(ci, 16)))
                IfCondition NotEqual(nm, 0) ThenBlock: {
                    SystemCall(1, fd, nm, Dash.SLen(nm))
                }
                s = "\""
                SystemCall(1, fd, s, Dash.SLen(s))
                ci = Add(ci, 1)
            }
            s = "]"
            SystemCall(1, fd, s, Dash.SLen(s))
            s = ",\n  \"dec\": {"
            SystemCall(1, fd, s, Dash.SLen(s))
            df = 1
            ci = 0
            WhileLoop LessThan(ci, Dash_State.nch) {
                nm = Dereference(Add(Dash_State.chn, Multiply(ci, 16)))
                dc = Dash.ChanDec(nm)
                IfCondition GreaterThan(dc, 0) ThenBlock: {
                    IfCondition EqualTo(df, 0) ThenBlock: {
                        s = ", "
                        SystemCall(1, fd, s, Dash.SLen(s))
                    }
                    df = 0
                    s = "\""
                    SystemCall(1, fd, s, Dash.SLen(s))
                    IfCondition NotEqual(nm, 0) ThenBlock: {
                        SystemCall(1, fd, nm, Dash.SLen(nm))
                    }
                    s = "\": "
                    SystemCall(1, fd, s, Dash.SLen(s))
                    off = Dash.DecPut(buf, 0, dc)
                    SystemCall(1, fd, buf, off)
                }
                ci = Add(ci, 1)
            }
            s = "}"
            SystemCall(1, fd, s, Dash.SLen(s))
        }
        IfCondition NotEqual(Dash_State.logp, 0) ThenBlock: {
            s = ",\n  \"log\": \""
            SystemCall(1, fd, s, Dash.SLen(s))
            SystemCall(1, fd, Dash_State.logp, Dash.SLen(Dash_State.logp))
            s = "\""
            SystemCall(1, fd, s, Dash.SLen(s))
        }
        s = "\n}\n"
        SystemCall(1, fd, s, Dash.SLen(s))
        SystemCall(3, fd, 0, 0)
        PrintMessage("dash save\n")
        ReturnValue(0)
    }
}

Function.Dash.AddKind {
    Input: kind: Integer
    Output: Integer
    Body: {
        ch = "rpm"
        title = "Gauge"
        IfCondition EqualTo(kind, DashKind.BAR) ThenBlock: { title = "Bar" }
        IfCondition EqualTo(kind, DashKind.PLOT) ThenBlock: { title = "Plot" }
        IfCondition EqualTo(kind, DashKind.TABLE) ThenBlock: {
            title = "Table"
            ch = 0
        }
        pane = Dash.AddPane(title, kind, ch)
        IfCondition LessThan(pane, 0) ThenBlock: { ReturnValue(-1) }
        ox = Add(24, Multiply(Modulo(pane, 6), 28))
        oy = Add(24, Multiply(Modulo(pane, 5), 24))
        Dash.ApplyGeom(pane, ox, oy, 300, 280)
        IfCondition EqualTo(kind, DashKind.ARC) ThenBlock: {
            Dash.PWSet(pane, 4, 0)
            Dash.PWSet(pane, 5, 7000)
            Dash.PWSet(pane, 6, 1000)
            Gauge.Scale(0, 7000, 1000)
        }
        IfCondition EqualTo(kind, DashKind.BAR) ThenBlock: {
            Dash.PWSet(pane, 4, 0)
            Dash.PWSet(pane, 5, 100)
            Dash.PWSet(pane, 6, 10)
        }
        IfCondition EqualTo(kind, DashKind.PLOT) ThenBlock: {
            Dash.PWSet(pane, 4, 0)
            Dash.PWSet(pane, 5, 7000)
            Dash.PWSet(pane, 6, 1000)
            Gauge.PlotScale(0, 7000, 1000)
        }
        Dash.MakeWidget(pane)
        wid = Dash.PWGet(pane, 2)
        IfCondition EqualTo(kind, DashKind.PLOT) ThenBlock: {
            Gauge.PlotRange(wid, 0, 7000)
            Dash.TraceSet(pane, 0, ch)
        }
        IfCondition EqualTo(kind, DashKind.TABLE) ThenBlock: { Dash.TblFill(pane) }
        Dash_State.dirty = 1
        ReturnValue(pane)
    }
}

Function.Dash.ParseXY {
    Input: s: Address
    Output: Integer
    Body: {
        Dash_State.mx = Dash.Atoi(s)
        i = 1
        nums = 0
        WhileLoop LessThan(i, 80) {
            c = GetByte(s, i)
            IfCondition EqualTo(c, 0) ThenBlock: { i = 80 }
            IfCondition And(GreaterEqual(c, 48), LessEqual(c, 57)) ThenBlock: {
                IfCondition EqualTo(nums, 0) ThenBlock: { nums = 1 }
            }
            IfCondition EqualTo(nums, 1) ThenBlock: {
                IfCondition EqualTo(c, 32) ThenBlock: {
                    Dash_State.my = Dash.Atoi(Add(s, Add(i, 1)))
                    ReturnValue(1)
                }
                IfCondition EqualTo(c, 0) ThenBlock: {
                    ReturnValue(0)
                }
            }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

Function.Dash.PollPtr {
    Output: Integer
    Body: {
        IfCondition EqualTo(Dash_State.ptr, 0) ThenBlock: {
            Dash_State.ptr = Allocate(64)
        }
        buf = Dash_State.ptr
        fd = SystemCall(2, "/tmp/anim_app/ptr.txt", 0, 0)
        IfCondition LessThan(fd, 0) ThenBlock: { ReturnValue(0) }
        n = SystemCall(0, fd, buf, 63)
        SystemCall(3, fd, 0, 0)
        IfCondition LessEqual(n, 0) ThenBlock: { ReturnValue(0) }
        SetByte(buf, n, 0)
        fd2 = SystemCall(2, "/tmp/anim_app/ptr.txt", 577, 420)
        IfCondition GreaterEqual(fd2, 0) ThenBlock: { SystemCall(3, fd2, 0, 0) }
        c0 = GetByte(buf, 0)
        IfCondition EqualTo(c0, 100) ThenBlock: {
            Dash.ParseXY(buf)
            IfCondition EqualTo(Dash_State.drop, 1) ThenBlock: {
                Dash.HitDrop(Dash_State.mx, Dash_State.my)
                Dash_State.ptrhit = 0
                Dash_State.dirty = 1
                ReturnValue(1)
            }
            IfCondition LessThan(Dash_State.my, 40) ThenBlock: {
                Dash_State.barhit = 1
                Dash_State.ptrhit = 0
                Dash_State.dirty = 1
                ReturnValue(1)
            }
            IfCondition NotEqual(Dash_State.modal, 0) ThenBlock: {
                Dash_State.ptrhit = 1
                Dash_State.dirty = 1
                ReturnValue(1)
            }
            AppDesk.Down(Dash_State.mx, Dash_State.my)
            Dash_State.ptrhit = 1
            IfCondition EqualTo(AppDesk.hit, AppDeskConst.HIT_CONTENT) ThenBlock: {
                hs = Dash.HitScope(Dash_State.mx, Dash_State.my)
                ht = Dash.HitTable(Dash_State.mx, Dash_State.my)
                IfCondition And(EqualTo(hs, 0), EqualTo(ht, 0)) ThenBlock: {
                    Dash.HitBind()
                }
            }
            Dash_State.dirty = 1
            ReturnValue(1)
        }
        IfCondition EqualTo(c0, 109) ThenBlock: {
            Dash.ParseXY(buf)
            IfCondition GreaterEqual(Dash_State.my, 40) ThenBlock: {
                AppDesk.Move(Dash_State.mx, Dash_State.my)
            }
            IfCondition GreaterThan(Dash_State.scrub, 0) ThenBlock: {
                Dash.ScrubMove(Dash_State.mx, Dash_State.my)
            }
            Dash_State.dirty = 1
            ReturnValue(1)
        }
        IfCondition EqualTo(c0, 117) ThenBlock: {
            Dash.ParseXY(buf)
            AppDesk.Up()
            Dash_State.scrub = 0
            Dash_State.barup = 1
            Dash_State.dirty = 1
            ReturnValue(1)
        }
        ReturnValue(0)
    }
}

Function.Dash.PollCmd {
    Output: Integer
    Body: {
        IfCondition EqualTo(Dash_State.cmd, 0) ThenBlock: {
            Dash_State.cmd = Allocate(80)
        }
        buf = Dash_State.cmd
        fd = SystemCall(2, "/tmp/anim_app/cmd.txt", 0, 0)
        IfCondition LessThan(fd, 0) ThenBlock: { ReturnValue(0) }
        n = SystemCall(0, fd, buf, 79)
        SystemCall(3, fd, 0, 0)
        IfCondition LessEqual(n, 0) ThenBlock: { ReturnValue(0) }
        SetByte(buf, n, 0)
        ln = n
        WhileLoop GreaterThan(ln, 0) {
            c = GetByte(buf, Subtract(ln, 1))
            strip = 0
            IfCondition EqualTo(c, 10) ThenBlock: { strip = 1 }
            IfCondition EqualTo(c, 13) ThenBlock: { strip = 1 }
            IfCondition EqualTo(c, 32) ThenBlock: { strip = 1 }
            IfCondition EqualTo(strip, 1) ThenBlock: {
                ln = Subtract(ln, 1)
                SetByte(buf, ln, 0)
            }
            IfCondition EqualTo(strip, 0) ThenBlock: { ln = 0 }
        }
        IfCondition EqualTo(GetByte(buf, 0), 0) ThenBlock: { ReturnValue(0) }
        fd2 = SystemCall(2, "/tmp/anim_app/cmd.txt", 577, 420)
        IfCondition GreaterEqual(fd2, 0) ThenBlock: { SystemCall(3, fd2, 0, 0) }
        c0 = GetByte(buf, 0)
        c1 = GetByte(buf, 1)
        c2 = GetByte(buf, 2)
        IfCondition EqualTo(StringCompare(buf, "quit"), 0) ThenBlock: { ReturnValue(1) }
        IfCondition And(GreaterEqual(c0, 48), LessEqual(c0, 57)) ThenBlock: {
            d = Subtract(c0, 48)
            neg = Subtract(0, 1)
            Branch d {
                Case 1: {
                    Dash.Go(1)
                    ReturnValue(2)
                }
                Case 2: {
                    Dash.Stop()
                    ReturnValue(2)
                }
                Case 3: {
                    Dash.Pause()
                    ReturnValue(2)
                }
                Case 4: {
                    Dash.Go(1)
                    ReturnValue(2)
                }
                Case 5: {
                    Dash.Go(neg)
                    ReturnValue(2)
                }
                Default: { }
            }
        }
        IfCondition EqualTo(c0, 101) ThenBlock: {
            Dash_State.edit = 1
            ReturnValue(2)
        }
        IfCondition EqualTo(c0, 119) ThenBlock: {
            Dash.SaveJSON()
            ReturnValue(2)
        }
        IfCondition EqualTo(c0, 106) ThenBlock: {
            Dash.SaveJSONL()
            ReturnValue(2)
        }
        IfCondition EqualTo(c0, 110) ThenBlock: {
            nk = Subtract(c1, 48)
            IfCondition EqualTo(nk, 1) ThenBlock: { Dash.AddKind(DashKind.ARC) }
            IfCondition EqualTo(nk, 2) ThenBlock: { Dash.AddKind(DashKind.BAR) }
            IfCondition EqualTo(nk, 4) ThenBlock: { Dash.AddKind(DashKind.PLOT) }
            IfCondition EqualTo(nk, 5) ThenBlock: { Dash.AddKind(DashKind.TABLE) }
            ReturnValue(2)
        }
        IfCondition EqualTo(c0, 115) ThenBlock: {
            IfCondition EqualTo(c1, 101) ThenBlock: {
                Dash.Seek(Dash.Atoi(buf))
                ReturnValue(2)
            }
            IfCondition EqualTo(c2, 97) ThenBlock: {
                Dash.Go(1)
                ReturnValue(2)
            }
            Dash.Stop()
            ReturnValue(2)
        }
        ReturnValue(0)
    }
}

Function.Dash.Tick {
    Output: Integer
    Body: {
        IfCondition EqualTo(Dash_State.log, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Dash_State.play, 0) ThenBlock: { ReturnValue(0) }
        last = Subtract(Dash_State.nlog, 1)
        IfCondition LessThan(last, 0) ThenBlock: { last = 0 }
        nxt = Add(Dash_State.pos, Dash_State.dir)
        IfCondition LessThan(nxt, 0) ThenBlock: {
            nxt = 0
            Dash_State.play = 0
        }
        IfCondition GreaterThan(nxt, last) ThenBlock: {
            nxt = last
            Dash_State.play = 0
        }
        Dash_State.pos = nxt
        Dash_State.dirty = 1
        Dash.FollowView()
        Dash.Apply()
        Dash.PushPlots()
        ReturnValue(Dash_State.pos)
    }
}

Function.Dash.DrawNum {
    Input: dest: Integer
    Input: x: Integer
    Input: y: Integer
    Input: v: Integer
    Input: dec: Integer
    Input: col: Integer
    Output: Integer
    Body: {
        ln = Gauge.Fmt(v, dec)
        VFont_DrawString(dest, Gauge_State.lab, ln, x, y, col)
        ReturnValue(ln)
    }
}

Function.Dash.DrawTraces {
    Output: Integer
    Body: {
        i = 0
        WhileLoop LessThan(i, Dash_State.n) {
            Dash.DrawTracesPane(i)
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

Function.Dash.PlotGeom {
    Input: pane: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(pane, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(Dash.PWGet(pane, 1), DashKind.PLOT) ThenBlock: { ReturnValue(0) }
        desk = Dash.PWGet(pane, 0)
        IfCondition EqualTo(AppDesk.Get(desk, AppDeskWin.LIVE), 0) ThenBlock: { ReturnValue(0) }
        wid = Dash.PWGet(pane, 2)
        IfCondition LessThan(wid, 0) ThenBlock: { ReturnValue(0) }
        cx = AppDesk.CX(desk)
        cy = AppDesk.CY(desk)
        cw = AppDesk.CW(desk)
        ch = AppDesk.CH(desk)
        x = Gauge.PWGet(wid, 0)
        y = Gauge.PWGet(wid, 1)
        w = Gauge.PWGet(wid, 2)
        h = Gauge.PWGet(wid, 3)
        IfCondition LessThan(x, cx) ThenBlock: { x = cx }
        IfCondition LessThan(y, cy) ThenBlock: { y = cy }
        IfCondition GreaterThan(Add(x, w), Add(cx, cw)) ThenBlock: { w = Subtract(Add(cx, cw), x) }
        IfCondition GreaterThan(Add(y, h), Add(cy, ch)) ThenBlock: { h = Subtract(Add(cy, ch), y) }
        IfCondition LessThan(w, 16) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(h, 16) ThenBlock: { ReturnValue(0) }
        gut = Gauge_State.pgut
        IfCondition LessThan(gut, 24) ThenBlock: { gut = 56 }
        rg = 52
        leg = 18
        pad = 4
        barh = 12
        ix = Add(x, gut)
        iy = Add(Add(y, pad), leg)
        iw = Subtract(Subtract(Subtract(w, gut), rg), pad)
        ih = Subtract(Subtract(Subtract(h, Multiply(pad, 2)), leg), barh)
        IfCondition LessThan(iw, 8) ThenBlock: { iw = 8 }
        IfCondition LessThan(ih, 8) ThenBlock: { ih = 8 }
        win = Gauge_State.pcap
        IfCondition LessThan(win, 2) ThenBlock: { win = 256 }
        t0 = Dash_State.view0
        IfCondition LessThan(t0, 0) ThenBlock: { t0 = 0 }
        last = Subtract(Dash_State.nlog, 1)
        IfCondition LessThan(last, 0) ThenBlock: { last = 0 }
        t1w = Add(t0, Subtract(win, 1))
        IfCondition GreaterThan(t1w, last) ThenBlock: { t1w = last }
        np = Subtract(t1w, t0)
        IfCondition LessThan(np, 1) ThenBlock: { np = 1 }
        DashPlot.x = x
        DashPlot.y = y
        DashPlot.w = w
        DashPlot.h = h
        DashPlot.ix = ix
        DashPlot.iy = iy
        DashPlot.iw = iw
        DashPlot.ih = ih
        DashPlot.t0 = t0
        DashPlot.np = np
        DashPlot.bx = ix
        DashPlot.by = Subtract(Add(y, h), 12)
        DashPlot.bw = iw
        ReturnValue(1)
    }
}

Function.Dash.ScrubPlot {
    Input: pane: Integer
    Input: px: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(Dash.PlotGeom(pane), 0) ThenBlock: { ReturnValue(0) }
        t = Subtract(px, DashPlot.ix)
        IfCondition LessThan(t, 0) ThenBlock: { t = 0 }
        IfCondition GreaterThan(t, DashPlot.iw) ThenBlock: { t = DashPlot.iw }
        p = Add(DashPlot.t0, Divide(Multiply(t, DashPlot.np), DashPlot.iw))
        Dash_State.scrub = 1
        Dash_State.spane = pane
        ReturnValue(Dash.Scrub(p, 0))
    }
}

Function.Dash.ScrubLog {
    Input: pane: Integer
    Input: px: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(Dash.PlotGeom(pane), 0) ThenBlock: { ReturnValue(0) }
        last = Subtract(Dash_State.nlog, 1)
        IfCondition LessThan(last, 1) ThenBlock: { last = 1 }
        t = Subtract(px, DashPlot.bx)
        IfCondition LessThan(t, 0) ThenBlock: { t = 0 }
        IfCondition GreaterThan(t, DashPlot.bw) ThenBlock: { t = DashPlot.bw }
        p = Divide(Multiply(t, last), DashPlot.bw)
        Dash_State.scrub = 2
        Dash_State.spane = pane
        ReturnValue(Dash.Scrub(p, 1))
    }
}

Function.Dash.ScrubMove {
    Input: px: Integer
    Input: py: Integer
    Output: Integer
    Body: {
        pane = Dash_State.spane
        IfCondition LessThan(pane, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Dash_State.scrub, 1) ThenBlock: {
            ReturnValue(Dash.ScrubPlot(pane, px))
        }
        IfCondition EqualTo(Dash_State.scrub, 2) ThenBlock: {
            ReturnValue(Dash.ScrubLog(pane, px))
        }
        IfCondition EqualTo(Dash_State.scrub, 3) ThenBlock: {
            TextGrid.ScrollAt(py)
            Dash_State.dirty = 1
            ReturnValue(1)
        }
        ReturnValue(0)
    }
}

Function.Dash.FmtPos {
    Output: Integer
    Body: {
        IfCondition EqualTo(Dash_State.st, 0) ThenBlock: { Dash_State.st = Allocate(64) }
        buf = Dash_State.st
        SetByte(buf, 0, 115)
        SetByte(buf, 1, 32)
        off = Dash.DecPut(buf, 2, Dash_State.pos)
        SetByte(buf, off, 47)
        off = Add(off, 1)
        off = Dash.DecPut(buf, off, Dash_State.nlog)
        ReturnValue(off)
    }
}

Function.Dash.DrawTracesPane {
    Input: i: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(Dash.PlotGeom(i), 0) ThenBlock: { ReturnValue(0) }
        dest = Anim.Dest()
        IfCondition EqualTo(dest, 0) ThenBlock: { ReturnValue(0) }
        VFont_UseSize(13)
        t0 = DashPlot.t0
        np = DashPlot.np
        x = DashPlot.x
        y = DashPlot.y
        w = DashPlot.w
        h = DashPlot.h
        ix = DashPlot.ix
        iy = DashPlot.iy
        iw = DashPlot.iw
        ih = DashPlot.ih
        t1 = Dash_State.pos
        chipw = Divide(w, 6)
        IfCondition LessThan(chipw, 40) ThenBlock: { chipw = 40 }
                a0 = -1
                a1 = -1
                slot = 0
                WhileLoop LessThan(slot, 6) {
                    nm = Dash.TraceGet(i, slot)
                    col = Dash.TraceCol(slot)
                    cx0 = Add(x, Multiply(slot, chipw))
                    FB_FillRect(Add(cx0, 2), Add(y, 2), Subtract(chipw, 4), 16, FB_RGB(10, 16, 32))
                    IfCondition EqualTo(slot, Dash_State.pslot) ThenBlock: {
                        FB_Rect(Add(cx0, 2), Add(y, 2), Subtract(chipw, 4), 16, FB_RGB(42, 212, 255))
                    }
                    IfCondition EqualTo(nm, 0) ThenBlock: {
                        VFont_DrawString(dest, "+", 1, Add(cx0, 8), Add(y, 4), FB_RGB(90, 100, 120))
                    }
                    IfCondition NotEqual(nm, 0) ThenBlock: {
                        IfCondition LessThan(a0, 0) ThenBlock: { a0 = slot }
                        IfCondition And(GreaterEqual(a0, 0), NotEqual(a0, slot)) ThenBlock: {
                            IfCondition LessThan(a1, 0) ThenBlock: { a1 = slot }
                        }
                        ln = Dash.SLen(nm)
                        VFont_DrawString(dest, nm, ln, Add(cx0, 6), Add(y, 4), col)
                        ci = Dash.ChanIdx(nm)
                        IfCondition GreaterEqual(ci, 0) ThenBlock: {
                            vv = Dash.SampGet(t1, ci)
                            dc = Dash.ChanDec(nm)
                            n2 = Gauge.Fmt(vv, dc)
                            mw = VFont_MeasureWidth(Gauge_State.lab, n2)
                            VFont_DrawString(dest, Gauge_State.lab, n2, Subtract(Add(cx0, chipw), Add(mw, 6)), Add(y, 4), col)
                        }
                        IfCondition GreaterThan(np, 0) ThenBlock: {
                            lo = Dash.ChanLo(nm)
                            hi = Dash.ChanHi(nm)
                            span = Subtract(hi, lo)
                            IfCondition EqualTo(span, 0) ThenBlock: { span = 1 }
                            k = 0
                            last = np
                            WhileLoop LessThan(k, last) {
                                v0 = Dash.SampGet(Add(t0, k), ci)
                                v1 = Dash.SampGet(Add(t0, Add(k, 1)), ci)
                                u0 = Subtract(v0, lo)
                                u1 = Subtract(v1, lo)
                                IfCondition LessThan(u0, 0) ThenBlock: { u0 = 0 }
                                IfCondition LessThan(u1, 0) ThenBlock: { u1 = 0 }
                                IfCondition GreaterThan(u0, span) ThenBlock: { u0 = span }
                                IfCondition GreaterThan(u1, span) ThenBlock: { u1 = span }
                                x0 = Add(ix, Divide(Multiply(k, iw), last))
                                x1 = Add(ix, Divide(Multiply(Add(k, 1), iw), last))
                                y0 = Subtract(Add(iy, ih), Divide(Multiply(u0, ih), span))
                                y1 = Subtract(Add(iy, ih), Divide(Multiply(u1, ih), span))
                                FB_Line(x0, y0, x1, y1, col)
                                k = Add(k, 1)
                            }
                            pc = Subtract(t1, t0)
                            IfCondition LessThan(pc, 0) ThenBlock: { pc = 0 }
                            IfCondition GreaterThan(pc, last) ThenBlock: { pc = last }
                            u = Subtract(Dash.SampGet(t1, ci), lo)
                            IfCondition LessThan(u, 0) ThenBlock: { u = 0 }
                            IfCondition GreaterThan(u, span) ThenBlock: { u = span }
                            pxc = Add(ix, Divide(Multiply(pc, iw), last))
                            pyc = Subtract(Add(iy, ih), Divide(Multiply(u, ih), span))
                            FB_FillRect(Subtract(pxc, 2), Subtract(pyc, 2), 5, 5, col)
                        }
                    }
                    slot = Add(slot, 1)
                }
                IfCondition GreaterEqual(a0, 0) ThenBlock: {
                    nm = Dash.TraceGet(i, a0)
                    col = Dash.TraceCol(a0)
                    lo = Dash.ChanLo(nm)
                    hi = Dash.ChanHi(nm)
                    dc = Dash.ChanDec(nm)
                    Dash.DrawNum(dest, Add(x, 4), iy, hi, dc, col)
                    Dash.DrawNum(dest, Add(x, 4), Add(iy, Divide(ih, 2)), Divide(Add(lo, hi), 2), dc, col)
                    Dash.DrawNum(dest, Add(x, 4), Subtract(Add(iy, ih), 12), lo, dc, col)
                }
                IfCondition GreaterEqual(a1, 0) ThenBlock: {
                    nm = Dash.TraceGet(i, a1)
                    col = Dash.TraceCol(a1)
                    lo = Dash.ChanLo(nm)
                    hi = Dash.ChanHi(nm)
                    dc = Dash.ChanDec(nm)
                    rx = Subtract(Add(x, w), 50)
                    Dash.DrawNum(dest, rx, iy, hi, dc, col)
                    Dash.DrawNum(dest, rx, Add(iy, Divide(ih, 2)), Divide(Add(lo, hi), 2), dc, col)
                    Dash.DrawNum(dest, rx, Subtract(Add(iy, ih), 12), lo, dc, col)
                }
        pc = Subtract(t1, t0)
        IfCondition LessThan(pc, 0) ThenBlock: { pc = 0 }
        IfCondition GreaterThan(pc, np) ThenBlock: { pc = np }
        lx = Add(ix, Divide(Multiply(pc, iw), np))
        FB_Line(lx, iy, lx, Add(iy, ih), FB_RGB(42, 212, 255))
        ln = Dash.FmtPos()
        VFont_DrawString(dest, Dash_State.st, ln, Add(ix, 4), Subtract(Add(iy, ih), 14), FB_RGB(42, 212, 255))
        bx = DashPlot.bx
        by = DashPlot.by
        bw = DashPlot.bw
        FB_FillRect(bx, by, bw, 8, FB_RGB(22, 34, 63))
        FB_Rect(bx, by, bw, 8, FB_RGB(58, 80, 128))
        lastn = Subtract(Dash_State.nlog, 1)
        IfCondition LessThan(lastn, 1) ThenBlock: { lastn = 1 }
        fw = Divide(Multiply(t1, bw), lastn)
        IfCondition LessThan(fw, 1) ThenBlock: { fw = 1 }
        IfCondition GreaterThan(fw, bw) ThenBlock: { fw = bw }
        FB_FillRect(bx, by, fw, 8, FB_RGB(32, 90, 120))
        tx = Add(bx, Divide(Multiply(t1, Subtract(bw, 4)), lastn))
        FB_FillRect(tx, Subtract(by, 1), 4, 10, FB_RGB(42, 212, 255))
        ReturnValue(0)
    }
}

Function.Dash.HitScope {
    Input: px: Integer
    Input: py: Integer
    Output: Integer
    Body: {
        desk = AppDesk.hit_idx
        IfCondition LessThan(desk, 0) ThenBlock: { ReturnValue(0) }
        pane = Dash.PaneOfDesk(desk)
        IfCondition LessThan(pane, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Dash.PlotGeom(pane), 0) ThenBlock: { ReturnValue(0) }
        x = DashPlot.x
        y = DashPlot.y
        w = DashPlot.w
        h = DashPlot.h
        IfCondition LessThan(px, x) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterEqual(px, Add(x, w)) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(py, y) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterEqual(py, Add(y, h)) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(py, Add(y, 20)) ThenBlock: {
            chipw = Divide(w, 6)
            IfCondition LessThan(chipw, 1) ThenBlock: { chipw = 1 }
            slot = Divide(Subtract(px, x), chipw)
            IfCondition GreaterThan(slot, 5) ThenBlock: { slot = 5 }
            Dash_State.pslot = slot
            IfCondition NotEqual(Dash_State.pick, 0) ThenBlock: {
                Dash.TraceSet(pane, slot, Dash_State.pick)
                Dash_State.dirty = 1
                ReturnValue(1)
            }
            IfCondition EqualTo(Dash_State.modal, 0) ThenBlock: {
                Dash.CycleTrace(pane, slot)
            }
            Dash_State.dirty = 1
            ReturnValue(1)
        }
        IfCondition GreaterEqual(py, DashPlot.by) ThenBlock: {
            ReturnValue(Dash.ScrubLog(pane, px))
        }
        ReturnValue(Dash.ScrubPlot(pane, px))
    }
}

Function.Dash.HitTable {
    Input: px: Integer
    Input: py: Integer
    Output: Integer
    Body: {
        desk = AppDesk.hit_idx
        IfCondition LessThan(desk, 0) ThenBlock: { ReturnValue(0) }
        pane = Dash.PaneOfDesk(desk)
        IfCondition LessThan(pane, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(Dash.PWGet(pane, 1), DashKind.TABLE) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(TextGrid.HitScroll(px, py), 1) ThenBlock: {
            TextGrid.ScrollGrab(py)
            Dash_State.scrub = 3
            Dash_State.spane = pane
            Dash_State.dirty = 1
            ReturnValue(1)
        }
        x = TextGrid_State.x
        y = TextGrid_State.y
        w = TextGrid_State.w
        h = TextGrid_State.h
        IfCondition LessThan(px, x) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterEqual(px, Add(x, w)) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(py, y) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterEqual(py, Add(y, h)) ThenBlock: { ReturnValue(0) }
        rh = TextGrid_State.rh
        IfCondition LessThan(rh, 1) ThenBlock: { rh = 22 }
        row = Divide(Subtract(py, y), rh)
        IfCondition GreaterThan(row, 0) ThenBlock: {
            slot = Add(TextGrid_State.top, Subtract(row, 1))
            IfCondition GreaterThan(slot, 31) ThenBlock: { slot = 31 }
            IfCondition LessThan(slot, 0) ThenBlock: { slot = 0 }
            Dash_State.pslot = slot
            gw = TextGrid_State.w
            IfCondition EqualTo(TextGrid.NeedBar(), 1) ThenBlock: {
                gw = Subtract(gw, TextGrid_State.sbw)
            }
            IfCondition LessThan(px, Add(x, Divide(gw, 2))) ThenBlock: {
                Dash.DropOpen(pane, slot)
            }
            IfCondition GreaterEqual(px, Add(x, Divide(gw, 2))) ThenBlock: {
                Dash_State.pick = Dash.TblGet(pane, slot)
            }
            Dash_State.dirty = 1
        }
        ReturnValue(1)
    }
}

Function.Dash.DrawBarPane {
    Input: pane: Integer
    Input: horiz: Integer
    Output: Integer
    Body: {
        desk = Dash.PWGet(pane, 0)
        wid = Dash.PWGet(pane, 2)
        IfCondition LessThan(wid, 0) ThenBlock: { ReturnValue(0) }
        chn = Dash.PWGet(pane, 3)
        lo = Dash.PWGet(pane, 4)
        hi = Dash.PWGet(pane, 5)
        v = Dash.ChanGet(chn)
        dec = Dash.PWGet(pane, 7)
        cx = AppDesk.CX(desk)
        cy = AppDesk.CY(desk)
        cw = AppDesk.CW(desk)
        ch = AppDesk.CH(desk)
        foot = 22
        bx = Add(cx, 8)
        by = Add(cy, 8)
        bw = Subtract(cw, 16)
        bh = Subtract(ch, Add(16, foot))
        IfCondition LessThan(bh, 24) ThenBlock: { bh = Subtract(ch, 16) }
        IfCondition LessThan(bw, 8) ThenBlock: { bw = 8 }
        Gauge.BarMove(wid, bx, by)
        Gauge.BWSet(wid, 2, bw)
        Gauge.BWSet(wid, 3, bh)
        Gauge.BarSet(wid, v, lo, hi)
        Gauge_State.tint = Dash.ChanColor(chn, v)
        sp = Dereference(Add(Gauge_State.btsp, Multiply(wid, 8)))
        Anim.DrawClipped(sp, cx, cy, cw, ch)
        Gauge.DrawBarOne(wid)
        Gauge_State.tint = 0
        dest = Anim.Dest()
        IfCondition EqualTo(dest, 0) ThenBlock: { ReturnValue(1) }
        VFont_UseSize(13)
        ink = FB_RGB(180, 190, 210)
        valc = Dash.ChanColor(chn, v)
        n = Gauge.Fmt(hi, dec)
        mw = VFont_MeasureWidth(Gauge_State.lab, n)
        IfCondition EqualTo(horiz, 0) ThenBlock: {
            tx = Add(bx, Divide(Subtract(bw, mw), 2))
            IfCondition LessThan(tx, bx) ThenBlock: { tx = bx }
            VFont_DrawString(dest, Gauge_State.lab, n, tx, Add(by, 2), ink)
            n = Gauge.Fmt(lo, dec)
            mw = VFont_MeasureWidth(Gauge_State.lab, n)
            tx = Add(bx, Divide(Subtract(bw, mw), 2))
            IfCondition LessThan(tx, bx) ThenBlock: { tx = bx }
            VFont_DrawString(dest, Gauge_State.lab, n, tx, Subtract(Add(by, bh), 16), ink)
        }
        IfCondition EqualTo(horiz, 1) ThenBlock: {
            n = Gauge.Fmt(lo, dec)
            VFont_DrawString(dest, Gauge_State.lab, n, Add(bx, 4), Add(by, 2), ink)
            n = Gauge.Fmt(hi, dec)
            mw = VFont_MeasureWidth(Gauge_State.lab, n)
            VFont_DrawString(dest, Gauge_State.lab, n, Subtract(Add(bx, bw), Add(mw, 4)), Add(by, 2), ink)
        }
        n = Gauge.Fmt(v, dec)
        fs = Gauge.FaceFont(bw, 5, 12, 22)
        VFont_UseSize(fs)
        mw = VFont_MeasureWidth(Gauge_State.lab, n)
        tx = Add(bx, Divide(Subtract(bw, mw), 2))
        IfCondition LessThan(tx, cx) ThenBlock: { tx = Add(cx, 2) }
        ty = Add(by, Add(bh, 4))
        IfCondition GreaterThan(Add(ty, fs), Add(cy, ch)) ThenBlock: {
            ty = Subtract(Add(cy, ch), Add(fs, 2))
        }
        VFont_DrawString(dest, Gauge_State.lab, n, tx, ty, valc)
        ReturnValue(1)
    }
}

Function.Dash.DrawPane {
    Input: i: Integer
    Output: Integer
    Body: {
        desk = Dash.PWGet(i, 0)
        IfCondition EqualTo(AppDesk.Get(desk, AppDeskWin.LIVE), 0) ThenBlock: { ReturnValue(0) }
        kind = Dash.PWGet(i, 1)
        wid = Dash.PWGet(i, 2)
        chn = Dash.PWGet(i, 3)
        lo = Dash.PWGet(i, 4)
        hi = Dash.PWGet(i, 5)
        v = Dash.ChanGet(chn)
        cx = AppDesk.CX(desk)
        cy = AppDesk.CY(desk)
        cw = AppDesk.CW(desk)
        ch = AppDesk.CH(desk)
        IfCondition EqualTo(kind, DashKind.ARC) ThenBlock: {
            sz = cw
            IfCondition GreaterThan(sz, ch) ThenBlock: { sz = ch }
            sz = Subtract(sz, 8)
            div = Dash.PWGet(i, 6)
            Gauge.ArcResize(wid, sz, lo, hi, div)
            Gauge.ArcMove(wid, Add(cx, 4), Add(cy, 4))
            Gauge.ArcSet(wid, v, lo, hi)
            IfCondition GreaterEqual(wid, 0) ThenBlock: {
                Anim.DrawClipped(Gauge.AWGet(wid, 3), cx, cy, cw, ch)
                Anim.DrawClipped(Gauge.AWGet(wid, 4), cx, cy, cw, ch)
            }
            Gauge.DrawOneReadout(Add(cx, 4), Add(cy, 4), sz, v, Dash.PWGet(i, 7))
        }
        IfCondition EqualTo(kind, DashKind.BAR) ThenBlock: {
            Dash.DrawBarPane(i, 0)
        }
        IfCondition EqualTo(kind, DashKind.BARH) ThenBlock: {
            Dash.DrawBarPane(i, 1)
        }
        IfCondition EqualTo(kind, DashKind.PLOT) ThenBlock: {
            Gauge.PlotMove(wid, Add(cx, 4), Add(cy, 4))
            IfCondition GreaterEqual(wid, 0) ThenBlock: {
                Gauge.PWSet(wid, 2, Subtract(cw, 8))
                Gauge.PWSet(wid, 3, Subtract(ch, 8))
                sp = Dereference(Add(Gauge_State.ptsp, Multiply(wid, 8)))
                Anim.DrawClipped(sp, cx, cy, cw, ch)
            }
            Dash.DrawTracesPane(i)
        }
        IfCondition EqualTo(kind, DashKind.TABLE) ThenBlock: {
            TextGrid.Place(Add(cx, 4), Add(cy, 4), Subtract(cw, 8), Subtract(ch, 8))
            vis = Divide(Subtract(Subtract(ch, 8), 22), 22)
            IfCondition LessThan(vis, 1) ThenBlock: { vis = 1 }
            nt = Dash.TblCount(i)
            TextGrid.Layout(2, Add(vis, 1))
            TextGrid_State.rh = 22
            TextGrid.SetScroll(TextGrid_State.top, vis, nt)
            TextGrid.Set(0, 0, "Name", FB_RGB(180, 190, 210))
            hv = "Value"
            hc = FB_RGB(180, 190, 210)
            IfCondition NotEqual(Dash_State.pick, 0) ThenBlock: {
                hv = Dash_State.pick
                hc = FB_RGB(42, 212, 255)
            }
            TextGrid.Set(0, 1, hv, hc)
            ri = 0
            WhileLoop LessThan(ri, vis) {
                nm = Dash.TblGet(i, Add(TextGrid_State.top, ri))
                IfCondition EqualTo(nm, 0) ThenBlock: {
                    TextGrid.Set(Add(ri, 1), 0, "+", FB_RGB(90, 100, 120))
                    TextGrid.Set(Add(ri, 1), 1, "", FB_RGB(90, 100, 120))
                }
                IfCondition NotEqual(nm, 0) ThenBlock: {
                    TextGrid.Set(Add(ri, 1), 0, nm, FB_RGB(255, 255, 255))
                    vv = Dash.ChanGet(nm)
                    dc = Dash.ChanDec(nm)
                    IfCondition LessThan(dc, 1) ThenBlock: {
                        TextGrid.SetInt(Add(ri, 1), 1, vv, FB_RGB(42, 212, 255))
                    }
                    IfCondition GreaterThan(dc, 0) ThenBlock: {
                        ln = Gauge.Fmt(vv, dc)
                        idx = Add(Multiply(Add(ri, 1), TextGrid_State.capc), 1)
                        dst = Add(TextGrid_State.nbuf, Multiply(idx, 12))
                        k = 0
                        WhileLoop LessEqual(k, ln) {
                            SetByte(dst, k, GetByte(Gauge_State.lab, k))
                            k = Add(k, 1)
                        }
                        TextGrid.Set(Add(ri, 1), 1, dst, FB_RGB(42, 212, 255))
                    }
                }
                IfCondition EqualTo(Add(TextGrid_State.top, ri), Dash_State.pslot) ThenBlock: {
                    IfCondition NotEqual(nm, 0) ThenBlock: {
                        TextGrid.Set(Add(ri, 1), 0, nm, FB_RGB(42, 212, 255))
                    }
                }
                ri = Add(ri, 1)
            }
            TextGrid.Draw()
        }
        ReturnValue(0)
    }
}

Function.Dash.Draw {
    Output: Integer
    Body: {
        FB_FillRect(0, 0, FB.width, FB.height, FB_RGB(14, 23, 48))
        zi = 0
        n = AppDesk.Count()
        WhileLoop LessThan(zi, n) {
            desk = AppDesk.AtZ(zi)
            AppDesk.DrawChrome(desk)
            cx = AppDesk.CX(desk)
            cy = AppDesk.CY(desk)
            cw = AppDesk.CW(desk)
            ch = AppDesk.CH(desk)
            FB_FillRect(cx, cy, cw, ch, FB_RGB(10, 16, 32))
            pane = Dash.PaneOfDesk(desk)
            IfCondition GreaterEqual(pane, 0) ThenBlock: {
                Dash.DrawPane(pane)
            }
            zi = Add(zi, 1)
        }
        ReturnValue(0)
    }
}
