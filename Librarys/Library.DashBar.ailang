LibraryImport.Arena
LibraryImport.Anim
LibraryImport.Gauge
LibraryImport.Dash
LibraryImport.Display.Render.Framebuffer
LibraryImport.Display.Render.Fonts

FixedPool.GBar {
    "ok":   Initialize=0, CanChange=True
    "h":    Initialize=40, CanChange=True
    "bw":   Initialize=52, CanChange=True
    "bh":   Initialize=26, CanChange=True
    "sx":   Initialize=0, CanChange=True
    "sy":   Initialize=0, CanChange=True
    "sw":   Initialize=0, CanChange=True
    "drag": Initialize=0, CanChange=True
    "arm":  Initialize=0, CanChange=True
    "bx":   Initialize=0, CanChange=True
}

Function.DashBar.Init {
    Output: Integer
    Body: {
        IfCondition EqualTo(GBar.ok, 1) ThenBlock: { ReturnValue(1) }
        GBar.bx = Allocate(96)
        GBar.h = 40
        GBar.bw = 52
        GBar.bh = 26
        GBar.ok = 1
        ReturnValue(1)
    }
}

Function.DashBar.Layout {
    Output: Integer
    Body: {
        DashBar.Init()
        w = FB.width
        bw = GBar.bw
        gap = 4
        x = 4
        i = 0
        WhileLoop LessThan(i, 5) {
            StoreValue(Add(GBar.bx, Multiply(i, 8)), x)
            x = Add(x, Add(bw, gap))
            i = Add(i, 1)
        }
        rx = Subtract(Subtract(w, 4), Multiply(6, Add(bw, gap)))
        rx = Add(rx, gap)
        IfCondition LessThan(rx, Add(x, 80)) ThenBlock: { rx = Add(x, 80) }
        GBar.sx = Add(x, 6)
        GBar.sw = Subtract(Subtract(rx, GBar.sx), 118)
        IfCondition LessThan(GBar.sw, 40) ThenBlock: { GBar.sw = 40 }
        GBar.sy = 16
        i = 0
        WhileLoop LessThan(i, 6) {
            StoreValue(Add(GBar.bx, Multiply(Add(i, 5), 8)), Add(rx, Multiply(i, Add(bw, gap))))
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

Function.DashBar.Lab {
    Input: i: Integer
    Output: Address
    Body: {
        IfCondition EqualTo(i, 0) ThenBlock: { ReturnValue("Start") }
        IfCondition EqualTo(i, 1) ThenBlock: { ReturnValue("Stop") }
        IfCondition EqualTo(i, 2) ThenBlock: { ReturnValue("Pause") }
        IfCondition EqualTo(i, 3) ThenBlock: { ReturnValue("Fwd") }
        IfCondition EqualTo(i, 4) ThenBlock: { ReturnValue("Rev") }
        IfCondition EqualTo(i, 5) ThenBlock: { ReturnValue("Save") }
        IfCondition EqualTo(i, 6) ThenBlock: { ReturnValue("Open") }
        IfCondition EqualTo(i, 7) ThenBlock: { ReturnValue("+Dial") }
        IfCondition EqualTo(i, 8) ThenBlock: { ReturnValue("+Bar") }
        IfCondition EqualTo(i, 9) ThenBlock: { ReturnValue("+Plot") }
        ReturnValue("Edit")
    }
}

Function.DashBar.Fire {
    Input: i: Integer
    Output: Integer
    Body: {
        neg = Subtract(0, 1)
        IfCondition EqualTo(i, 0) ThenBlock: { Dash.Go(1) }
        IfCondition EqualTo(i, 1) ThenBlock: { Dash.Stop() }
        IfCondition EqualTo(i, 2) ThenBlock: { Dash.Pause() }
        IfCondition EqualTo(i, 3) ThenBlock: { Dash.Go(1) }
        IfCondition EqualTo(i, 4) ThenBlock: { Dash.Go(neg) }
        IfCondition EqualTo(i, 5) ThenBlock: { Dash.SaveJSON() }
        IfCondition EqualTo(i, 6) ThenBlock: { Dash_State.file = 1 }
        IfCondition EqualTo(i, 7) ThenBlock: { Dash.AddKind(DashKind.ARC) }
        IfCondition EqualTo(i, 8) ThenBlock: { Dash.AddKind(DashKind.BAR) }
        IfCondition EqualTo(i, 9) ThenBlock: { Dash.AddKind(DashKind.PLOT) }
        IfCondition EqualTo(i, 10) ThenBlock: { Dash_State.edit = 1 }
        Dash_State.dirty = 1
        ReturnValue(0)
    }
}

Function.DashBar.SeekAt {
    Input: px: Integer
    Output: Integer
    Body: {
        last = Subtract(Dash_State.nlog, 1)
        IfCondition LessThan(last, 1) ThenBlock: { last = 1 }
        t = Subtract(px, GBar.sx)
        IfCondition LessThan(t, 0) ThenBlock: { t = 0 }
        IfCondition GreaterThan(t, GBar.sw) ThenBlock: { t = GBar.sw }
        p = Divide(Multiply(t, last), GBar.sw)
        Dash.Seek(p)
        ReturnValue(p)
    }
}

Function.DashBar.HitBtn {
    Input: px: Integer
    Output: Integer
    Body: {
        bw = GBar.bw
        i = 0
        WhileLoop LessThan(i, 11) {
            x = Dereference(Add(GBar.bx, Multiply(i, 8)))
            IfCondition GreaterEqual(px, x) ThenBlock: {
                IfCondition LessThan(px, Add(x, bw)) ThenBlock: { ReturnValue(i) }
            }
            i = Add(i, 1)
        }
        ReturnValue(-1)
    }
}

Function.DashBar.Down {
    Input: px: Integer
    Input: py: Integer
    Output: Integer
    Body: {
        DashBar.Layout()
        IfCondition GreaterEqual(py, GBar.h) ThenBlock: { ReturnValue(0) }
        GBar.arm = 0
        GBar.drag = 0
        IfCondition GreaterEqual(px, GBar.sx) ThenBlock: {
            IfCondition LessThan(px, Add(GBar.sx, GBar.sw)) ThenBlock: {
                GBar.drag = 1
                DashBar.SeekAt(px)
                ReturnValue(1)
            }
        }
        b = DashBar.HitBtn(px)
        IfCondition GreaterEqual(b, 0) ThenBlock: {
            GBar.arm = Add(b, 1)
            ReturnValue(1)
        }
        ReturnValue(1)
    }
}

Function.DashBar.Up {
    Input: px: Integer
    Input: py: Integer
    Output: Integer
    Body: {
        DashBar.Layout()
        a = GBar.arm
        GBar.arm = 0
        GBar.drag = 0
        IfCondition GreaterThan(a, 0) ThenBlock: {
            DashBar.Fire(Subtract(a, 1))
            ReturnValue(1)
        }
        IfCondition GreaterEqual(py, GBar.h) ThenBlock: { ReturnValue(0) }
        b = DashBar.HitBtn(px)
        IfCondition GreaterEqual(b, 0) ThenBlock: {
            DashBar.Fire(b)
            ReturnValue(1)
        }
        ReturnValue(0)
    }
}

Function.DashBar.Pump {
    Output: Integer
    Body: {
        DashBar.Init()
        IfCondition EqualTo(Dash_State.barhit, 1) ThenBlock: {
            Dash_State.barhit = 0
            DashBar.Down(Dash_State.mx, Dash_State.my)
        }
        IfCondition EqualTo(GBar.drag, 1) ThenBlock: {
            IfCondition EqualTo(Dash_State.barup, 0) ThenBlock: {
                DashBar.SeekAt(Dash_State.mx)
            }
        }
        IfCondition EqualTo(Dash_State.barup, 1) ThenBlock: {
            DashBar.Up(Dash_State.mx, Dash_State.my)
            GBar.drag = 0
            Dash_State.barup = 0
        }
        ReturnValue(0)
    }
}

Function.DashBar.DrawBtn {
    Input: dest: Integer
    Input: i: Integer
    Input: on: Integer
    Output: Integer
    Body: {
        x = Dereference(Add(GBar.bx, Multiply(i, 8)))
        y = 7
        bw = GBar.bw
        bh = GBar.bh
        bg = FB_RGB(26, 39, 68)
        fg = FB_RGB(216, 224, 240)
        bd = FB_RGB(58, 80, 128)
        IfCondition EqualTo(on, 1) ThenBlock: {
            bg = FB_RGB(36, 54, 92)
            bd = FB_RGB(42, 212, 255)
            fg = FB_RGB(42, 212, 255)
        }
        FB_FillRect(x, y, bw, bh, bg)
        FB_Rect(x, y, bw, bh, bd)
        s = DashBar.Lab(i)
        ln = Dash.SLen(s)
        mw = VFont_MeasureWidth(s, ln)
        tx = Add(x, Divide(Subtract(bw, mw), 2))
        IfCondition LessThan(tx, Add(x, 2)) ThenBlock: { tx = Add(x, 2) }
        VFont_DrawString(dest, s, ln, tx, Add(y, 6), fg)
        ReturnValue(0)
    }
}

Function.DashBar.Draw {
    Output: Integer
    Body: {
        DashBar.Layout()
        dest = Anim.Dest()
        IfCondition EqualTo(dest, 0) ThenBlock: { ReturnValue(0) }
        w = FB.width
        h = GBar.h
        FB_FillRect(0, 0, w, h, FB_RGB(14, 23, 48))
        FB_HLine(0, Subtract(w, 1), Subtract(h, 1), FB_RGB(42, 64, 96))
        VFont_UseSize(13)
        play = Dash_State.play
        dir = Dash_State.dir
        i = 0
        WhileLoop LessThan(i, 11) {
            on = 0
            IfCondition And(EqualTo(i, 3), EqualTo(play, 1)) ThenBlock: {
                IfCondition GreaterThan(dir, 0) ThenBlock: { on = 1 }
            }
            IfCondition And(EqualTo(i, 4), EqualTo(play, 1)) ThenBlock: {
                IfCondition LessThan(dir, 0) ThenBlock: { on = 1 }
            }
            DashBar.DrawBtn(dest, i, on)
            i = Add(i, 1)
        }
        sx = GBar.sx
        sy = GBar.sy
        sw = GBar.sw
        FB_FillRect(sx, sy, sw, 8, FB_RGB(22, 34, 63))
        FB_Rect(sx, sy, sw, 8, FB_RGB(58, 80, 128))
        last = Subtract(Dash_State.nlog, 1)
        IfCondition LessThan(last, 1) ThenBlock: { last = 1 }
        fw = Divide(Multiply(Dash_State.pos, Subtract(sw, 2)), last)
        IfCondition LessThan(fw, 1) ThenBlock: { fw = 1 }
        IfCondition GreaterThan(fw, Subtract(sw, 2)) ThenBlock: { fw = Subtract(sw, 2) }
        FB_FillRect(Add(sx, 1), Add(sy, 1), fw, 6, FB_RGB(42, 212, 255))
        IfCondition EqualTo(Dash_State.st, 0) ThenBlock: { Dash_State.st = Allocate(64) }
        buf = Dash_State.st
        off = 0
        IfCondition EqualTo(play, 1) ThenBlock: {
            IfCondition LessThan(dir, 0) ThenBlock: {
                SetByte(buf, 0, 82)
                SetByte(buf, 1, 69)
                SetByte(buf, 2, 86)
                SetByte(buf, 3, 32)
                off = 4
            }
            IfCondition GreaterThan(dir, 0) ThenBlock: {
                SetByte(buf, 0, 80)
                SetByte(buf, 1, 76)
                SetByte(buf, 2, 65)
                SetByte(buf, 3, 89)
                SetByte(buf, 4, 32)
                off = 5
            }
        }
        IfCondition EqualTo(play, 0) ThenBlock: {
            SetByte(buf, 0, 83)
            SetByte(buf, 1, 84)
            SetByte(buf, 2, 79)
            SetByte(buf, 3, 80)
            SetByte(buf, 4, 32)
            off = 5
        }
        n1 = Gauge.ItoA(Dash_State.pos)
        k = 0
        WhileLoop LessThan(k, n1) {
            SetByte(buf, Add(off, k), GetByte(Gauge_State.lab, k))
            k = Add(k, 1)
        }
        off = Add(off, n1)
        SetByte(buf, off, 47)
        off = Add(off, 1)
        n2 = Gauge.ItoA(Dash_State.nlog)
        k = 0
        WhileLoop LessThan(k, n2) {
            SetByte(buf, Add(off, k), GetByte(Gauge_State.lab, k))
            k = Add(k, 1)
        }
        off = Add(off, n2)
        SetByte(buf, off, 0)
        lx = Add(Add(sx, sw), 8)
        VFont_DrawString(dest, buf, off, lx, 12, FB_RGB(42, 212, 255))
        ReturnValue(0)
    }
}
