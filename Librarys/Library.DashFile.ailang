LibraryImport.Arena
LibraryImport.Anim
LibraryImport.Dash
LibraryImport.Display.Render.Framebuffer
LibraryImport.Display.Render.Fonts

FixedPool.DFile {
    "live":  Initialize=0, CanChange=True
    "n":     Initialize=0, CanChange=True
    "sel":   Initialize=0, CanChange=True
    "names": Initialize=0, CanChange=True
    "paths": Initialize=0, CanChange=True
    "pool":  Initialize=0, CanChange=True
    "poff":  Initialize=0, CanChange=True
    "x":     Initialize=0, CanChange=True
    "y":     Initialize=0, CanChange=True
    "w":     Initialize=420, CanChange=True
    "h":     Initialize=360, CanChange=True
}

Function.DashFile.Init {
    Output: Integer
    Body: {
        IfCondition NotEqual(DFile.names, 0) ThenBlock: { ReturnValue(1) }
        DFile.names = Allocate(256)
        DFile.paths = Allocate(256)
        DFile.pool = Allocate(4096)
        DFile.n = 0
        ReturnValue(1)
    }
}

Function.DashFile.Copy {
    Input: s: Address
    Output: Address
    Body: {
        p = Add(DFile.pool, DFile.poff)
        i = 0
        WhileLoop LessThan(i, 96) {
            c = GetByte(s, i)
            SetByte(p, i, c)
            IfCondition EqualTo(c, 0) ThenBlock: {
                DFile.poff = Add(DFile.poff, Add(i, 1))
                ReturnValue(p)
            }
            i = Add(i, 1)
        }
        SetByte(p, 96, 0)
        DFile.poff = Add(DFile.poff, 97)
        ReturnValue(p)
    }
}

Function.DashFile.Join {
    Input: dir: Address
    Input: name: Address
    Output: Address
    Body: {
        p = Add(DFile.pool, DFile.poff)
        i = 0
        WhileLoop LessThan(i, 80) {
            c = GetByte(dir, i)
            IfCondition EqualTo(c, 0) ThenBlock: { i = 80 }
            IfCondition LessThan(i, 80) ThenBlock: {
                IfCondition NotEqual(c, 0) ThenBlock: {
                    SetByte(p, i, c)
                    i = Add(i, 1)
                }
            }
        }
        dn = 0
        WhileLoop LessThan(dn, 80) {
            IfCondition EqualTo(GetByte(dir, dn), 0) ThenBlock: {
                i = dn
                dn = 80
            }
            IfCondition LessThan(dn, 80) ThenBlock: {
                IfCondition NotEqual(GetByte(dir, dn), 0) ThenBlock: { dn = Add(dn, 1) }
            }
        }
        SetByte(p, i, 47)
        i = Add(i, 1)
        k = 0
        WhileLoop LessThan(k, 80) {
            c = GetByte(name, k)
            IfCondition EqualTo(c, 0) ThenBlock: { k = 80 }
            IfCondition LessThan(k, 80) ThenBlock: {
                IfCondition NotEqual(c, 0) ThenBlock: {
                    SetByte(p, i, c)
                    i = Add(i, 1)
                    k = Add(k, 1)
                }
            }
        }
        SetByte(p, i, 0)
        DFile.poff = Add(DFile.poff, Add(i, 1))
        ReturnValue(p)
    }
}

Function.DashFile.Ends {
    Input: s: Address
    Input: a: Integer
    Input: b: Integer
    Input: c: Integer
    Input: d: Integer
    Output: Integer
    Body: {
        n = 0
        WhileLoop LessThan(n, 80) {
            IfCondition EqualTo(GetByte(s, n), 0) ThenBlock: {
                IfCondition LessThan(n, 4) ThenBlock: { ReturnValue(0) }
                IfCondition NotEqual(GetByte(s, Subtract(n, 4)), a) ThenBlock: { ReturnValue(0) }
                IfCondition NotEqual(GetByte(s, Subtract(n, 3)), b) ThenBlock: { ReturnValue(0) }
                IfCondition NotEqual(GetByte(s, Subtract(n, 2)), c) ThenBlock: { ReturnValue(0) }
                IfCondition NotEqual(GetByte(s, Subtract(n, 1)), d) ThenBlock: { ReturnValue(0) }
                ReturnValue(1)
            }
            n = Add(n, 1)
        }
        ReturnValue(0)
    }
}

Function.DashFile.Add {
    Input: dir: Address
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition GreaterEqual(DFile.n, 32) ThenBlock: { ReturnValue(-1) }
        IfCondition EqualTo(GetByte(name, 0), 46) ThenBlock: { ReturnValue(0) }
        js = DashFile.Ends(name, 106, 115, 111, 110)
        jl = DashFile.Ends(name, 115, 111, 110, 108)
        IfCondition And(EqualTo(js, 0), EqualTo(jl, 0)) ThenBlock: { ReturnValue(0) }
        i = DFile.n
        StoreValue(Add(DFile.names, Multiply(i, 8)), DashFile.Copy(name))
        StoreValue(Add(DFile.paths, Multiply(i, 8)), DashFile.Join(dir, name))
        DFile.n = Add(i, 1)
        ReturnValue(1)
    }
}

Function.DashFile.Scan {
    Input: dir: Address
    Output: Integer
    Body: {
        fd = SystemCall(2, dir, 0, 0)
        IfCondition LessThan(fd, 0) ThenBlock: { ReturnValue(-1) }
        buf = Allocate(4096)
        nbytes = SystemCall(217, fd, buf, 4096)
        IfCondition LessEqual(nbytes, 0) ThenBlock: {
            nbytes = SystemCall(78, fd, buf, 4096)
        }
        SystemCall(3, fd, 0, 0)
        IfCondition LessEqual(nbytes, 0) ThenBlock: {
            Deallocate(buf, 4096)
            ReturnValue(0)
        }
        pos = 0
        WhileLoop LessThan(pos, nbytes) {
            reclen = Add(GetByte(buf, Add(pos, 16)), Multiply(GetByte(buf, Add(pos, 17)), 256))
            IfCondition LessThan(reclen, 20) ThenBlock: { pos = nbytes }
            IfCondition GreaterEqual(reclen, 20) ThenBlock: {
                DashFile.Add(dir, Add(buf, Add(pos, 19)))
                pos = Add(pos, reclen)
            }
        }
        Deallocate(buf, 4096)
        ReturnValue(DFile.n)
    }
}

Function.DashFile.Refresh {
    Output: Integer
    Body: {
        DashFile.Init()
        DFile.n = 0
        DFile.poff = 0
        DFile.sel = 0
        DashFile.Scan("ECU/dash")
        DashFile.Scan("ECU/dash/logs")
        ReturnValue(DFile.n)
    }
}

Function.DashFile.Open {
    Output: Integer
    Body: {
        DashFile.Refresh()
        DFile.live = 1
        Dash_State.modal = 2
        DFile.w = 420
        DFile.h = 360
        DFile.x = Subtract(FB.width, 428)
        IfCondition LessThan(DFile.x, 8) ThenBlock: { DFile.x = 8 }
        DFile.y = 44
        Dash_State.dirty = 1
        ReturnValue(1)
    }
}

Function.DashFile.Close {
    Output: Integer
    Body: {
        DFile.live = 0
        IfCondition EqualTo(Dash_State.modal, 2) ThenBlock: { Dash_State.modal = 0 }
        Dash_State.dirty = 1
        ReturnValue(0)
    }
}

Function.DashFile.Load {
    Input: path: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(path, 0) ThenBlock: { ReturnValue(-1) }
        jl = DashFile.Ends(path, 115, 111, 110, 108)
        IfCondition EqualTo(jl, 1) ThenBlock: {
            Dash_State.logp = path
            n = Dash.LoadJSONL(path)
            Dash_State.dirty = 1
            ReturnValue(n)
        }
        n = Dash.LoadJSON(path)
        Dash_State.dirty = 1
        ReturnValue(n)
    }
}

Function.DashFile.OnPtr {
    Output: Integer
    Body: {
        IfCondition EqualTo(Dash_State.file, 1) ThenBlock: {
            Dash_State.file = 0
            was = DFile.live
            IfCondition EqualTo(was, 1) ThenBlock: { DashFile.Close() }
            IfCondition EqualTo(was, 0) ThenBlock: {
                IfCondition EqualTo(Dash_State.modal, 0) ThenBlock: { DashFile.Open() }
            }
        }
        IfCondition EqualTo(DFile.live, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Dash_State.ptrhit, 0) ThenBlock: { ReturnValue(0) }
        Dash_State.ptrhit = 0
        px = Dash_State.mx
        py = Dash_State.my
        x = DFile.x
        y = DFile.y
        w = DFile.w
        h = DFile.h
        IfCondition LessThan(px, x) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(py, y) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterEqual(px, Add(x, w)) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterEqual(py, Add(y, h)) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterEqual(px, Subtract(Add(x, w), 28)) ThenBlock: {
            IfCondition LessThan(py, Add(y, 24)) ThenBlock: {
                DashFile.Close()
                ReturnValue(1)
            }
        }
        row = Divide(Subtract(py, Add(y, 28)), 18)
        IfCondition LessThan(row, 0) ThenBlock: { ReturnValue(1) }
        IfCondition GreaterEqual(row, DFile.n) ThenBlock: { ReturnValue(1) }
        DFile.sel = row
        p = Dereference(Add(DFile.paths, Multiply(row, 8)))
        DashFile.Load(p)
        DashFile.Close()
        ReturnValue(1)
    }
}

Function.DashFile.Draw {
    Output: Integer
    Body: {
        IfCondition EqualTo(DFile.live, 0) ThenBlock: { ReturnValue(0) }
        dest = Anim.Dest()
        IfCondition EqualTo(dest, 0) ThenBlock: { ReturnValue(0) }
        x = DFile.x
        y = DFile.y
        w = DFile.w
        h = DFile.h
        FB_FillRect(x, y, w, h, FB_RGB(14, 23, 48))
        FB_Rect(x, y, w, h, FB_RGB(42, 212, 255))
        FB_FillRect(x, y, w, 24, FB_RGB(0, 160, 220))
        VFont_UseSize(13)
        VFont_DrawString(dest, "Open", 4, Add(x, 10), Add(y, 5), FB_RGB(0, 0, 0))
        FB_FillRect(Subtract(Add(x, w), 22), Add(y, 4), 16, 16, FB_RGB(255, 255, 255))
        FB_Rect(Subtract(Add(x, w), 22), Add(y, 4), 16, 16, FB_RGB(0, 0, 0))
        VFont_DrawString(dest, "X", 1, Subtract(Add(x, w), 18), Add(y, 6), FB_RGB(0, 0, 0))
        i = 0
        WhileLoop LessThan(i, DFile.n) {
            ry = Add(Add(y, 28), Multiply(i, 18))
            IfCondition LessThan(Add(ry, 18), Add(y, h)) ThenBlock: {
                fg = FB_RGB(216, 224, 240)
                IfCondition EqualTo(i, DFile.sel) ThenBlock: {
                    FB_FillRect(Add(x, 4), ry, Subtract(w, 8), 18, FB_RGB(26, 39, 68))
                    fg = FB_RGB(42, 212, 255)
                }
                nm = Dereference(Add(DFile.names, Multiply(i, 8)))
                IfCondition NotEqual(nm, 0) ThenBlock: {
                    ln = Dash.SLen(nm)
                    VFont_DrawString(dest, nm, ln, Add(x, 10), Add(ry, 2), fg)
                }
            }
            i = Add(i, 1)
        }
        IfCondition EqualTo(DFile.n, 0) ThenBlock: {
            VFont_DrawString(dest, "no json / jsonl in ECU/dash", 27, Add(x, 10), Add(y, 40), FB_RGB(140, 150, 170))
        }
        ReturnValue(1)
    }
}
