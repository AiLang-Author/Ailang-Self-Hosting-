// Library.Editor.ailang v2.0
// Nano-like text editor for AILang Console
// Usage: Editor_Open("file.ailang") from console
//
// CHANGES v2.0:
//   - Dynamic screen size detection
//   - Page Up/Down navigation
//   - Delete key support
//   - Horizontal scrolling for long lines
//   - Go-to-line (Ctrl+G)
//   - Search (Ctrl+F)
//   - Fixed syntax highlighting loops
//   - Better terminal handling

LibraryImport.XArrays
LibraryImport.TUI

// =============================================================================
// EDITOR STATE
// =============================================================================
FixedPool.Editor {
    "lines": Initialize=0, CanChange=True        
    "line_count": Initialize=0, CanChange=True
    "max_lines": Initialize=10000
    
    "cursor_row": Initialize=0, CanChange=True   
    "cursor_col": Initialize=0, CanChange=True   
    
    "view_top": Initialize=0, CanChange=True     
    "view_height": Initialize=20, CanChange=True   
    "view_width": Initialize=80, CanChange=True    
    "view_left": Initialize=0, CanChange=True
    "line_num_width": Initialize=5, CanChange=True
    
    "filename": Initialize=0, CanChange=True
    "modified": Initialize=0, CanChange=True
    
    "running": Initialize=0, CanChange=True
    "mode": Initialize=0, CanChange=True         
    
    "status_msg": Initialize=0, CanChange=True
    "status_time": Initialize=0, CanChange=True
    
    // Search state
    "search_buf": Initialize=0, CanChange=True
    "search_len": Initialize=0, CanChange=True
    "search_active": Initialize=0, CanChange=True
    
    // Input buffer for prompts
    "input_buf": Initialize=0, CanChange=True
    "input_pos": Initialize=0, CanChange=True
    "input_max": Initialize=64
}

// =============================================================================
// ANSI COLOR CONSTANTS
// =============================================================================
FixedPool.ANSI {
    "BLACK": Initialize=0
    "RED": Initialize=1
    "GREEN": Initialize=2
    "YELLOW": Initialize=3
    "BLUE": Initialize=4
    "MAGENTA": Initialize=5
    "CYAN": Initialize=6
    "WHITE": Initialize=7
}

// =============================================================================
// F-KEY CONSTANTS (need matching values in TUI_Keys)
// =============================================================================
FixedPool.FKeys {
    "F1": Initialize=1101
    "F2": Initialize=1102
    "F3": Initialize=1103
    "F4": Initialize=1104
    "F5": Initialize=1105
    "F6": Initialize=1106
    "F7": Initialize=1107
    "F8": Initialize=1108
    "F9": Initialize=1109
    "F10": Initialize=1110
    "F11": Initialize=1111
    "F12": Initialize=1112
}

// =============================================================================
// TERMINAL CONTROL (wrappers to TUI library)
// =============================================================================

Function.Term_Clear {
    Body: {
        TUI_Clear()
    }
}

Function.Term_MoveTo {
    Input: row: Integer
    Input: col: Integer
    Body: {
        TUI_MoveTo(Add(row, 1), Add(col, 1))
    }
}

Function.Term_HideCursor {
    Body: {
        TUI_HideCursor()
    }
}

Function.Term_ShowCursor {
    Body: {
        TUI_ShowCursor()
    }
}

Function.Term_SetColor {
    Input: color: Integer
    Body: {
        TUI_SetFG(color)
    }
}

Function.Term_ResetColor {
    Body: {
        TUI_ResetColor()
    }
}

Function.Term_Invert {
    Body: {
        TUI_Reverse()
    }
}

Function.Term_Bold {
    Body: {
        TUI_Bold()
    }
}

Function.Term_ClearEOL {
    Body: {
        TUI_BufferChar(27)
        TUI_BufferWriteStr("[K")
    }
}

Function.Term_Flush {
    Body: {
        TUI_Flush()
    }
}

// =============================================================================
// INITIALIZATION
// =============================================================================

Function.Editor_Init {
    Body: {
        Editor.lines = XArray.XCreate(Editor.max_lines)
        Editor.line_count = 0
        Editor.cursor_row = 0
        Editor.cursor_col = 0
        Editor.view_top = 0
        Editor.view_left = 0
        Editor.modified = 0
        Editor.running = 0
        Editor.mode = 0
        Editor.filename = 0
        Editor.status_msg = "F1=Help"
        Editor.search_active = 0
        Editor.search_len = 0
        
        // Detect terminal size
        Editor.view_width = TUI_GetWidth()
        Editor.view_height = Subtract(TUI_GetHeight(), 3)  // Reserve 3 lines: status + menu
        
        // Calculate line number width based on max lines
        Editor.line_num_width = 5
        
        // Allocate search buffer
        Editor.search_buf = Allocate(256)
        SetByte(Editor.search_buf, 0, 0)
        
        // Allocate input buffer
        Editor.input_buf = Allocate(Editor.input_max)
        Editor.input_pos = 0
        
        // Add one empty line to start
        empty = Allocate(1)
        SetByte(empty, 0, 0)
        XArray.XPush(Editor.lines, empty)
        Editor.line_count = 1
    }
}

Function.Editor_Free {
    Body: {
        // Free all line buffers
        i = 0
        WhileLoop LessThan(i, Editor.line_count) {
            line = XArray.XGet(Editor.lines, i)
            IfCondition NotEqual(line, 0) ThenBlock: {
                Deallocate(line, Add(StringLength(line), 1))
            }
            i = Add(i, 1)
        }
        XArray.XDestroy(Editor.lines)
        Editor.lines = 0
        
        IfCondition NotEqual(Editor.search_buf, 0) ThenBlock: {
            Deallocate(Editor.search_buf, 256)
            Editor.search_buf = 0
        }
        IfCondition NotEqual(Editor.input_buf, 0) ThenBlock: {
            Deallocate(Editor.input_buf, Editor.input_max)
            Editor.input_buf = 0
        }
    }
}

// =============================================================================
// FILE OPERATIONS
// =============================================================================

Function.Editor_Load {
    Input: filename: Address
    Output: Integer
    Body: {
        fd = SystemCall(2, filename, 0, 0)
        IfCondition LessThan(fd, 0) ThenBlock: {
            // File doesn't exist - that's OK, start new file with this name
            Editor.filename = filename
            Editor.status_msg = "New file"
            ReturnValue(1)
        }
        
        size = SystemCall(8, fd, 0, 2)
        SystemCall(8, fd, 0, 0)
        
        buffer = Allocate(Add(size, 1))
        bytes_read = SystemCall(0, fd, buffer, size)
        SystemCall(3, fd)
        SetByte(buffer, bytes_read, 0)
        
        Editor_ClearBuffer()
        
        line_start = 0
        i = 0
        WhileLoop LessEqual(i, bytes_read) {
            ch = GetByte(buffer, i)
            
            IfCondition Or(EqualTo(ch, 10), EqualTo(ch, 0)) ThenBlock: {
                line_len = Subtract(i, line_start)
                line = Allocate(Add(line_len, 1))
                
                j = 0
                k = 0
                WhileLoop LessThan(j, line_len) {
                    c = GetByte(buffer, Add(line_start, j))
                    IfCondition NotEqual(c, 13) ThenBlock: {
                        SetByte(line, k, c)
                        k = Add(k, 1)
                    }
                    j = Add(j, 1)
                }
                SetByte(line, k, 0)
                
                XArray.XPush(Editor.lines, line)
                Editor.line_count = Add(Editor.line_count, 1)
                
                line_start = Add(i, 1)
            }
            
            i = Add(i, 1)
        }
        
        Deallocate(buffer, Add(size, 1))
        
        Editor.filename = filename
        Editor.modified = 0
        Editor.cursor_row = 0
        Editor.cursor_col = 0
        Editor.view_top = 0
        Editor.view_left = 0
        Editor.status_msg = "Loaded"
        
        ReturnValue(1)
    }
}

Function.Editor_Save {
    Output: Integer
    Body: {
        IfCondition EqualTo(Editor.filename, 0) ThenBlock: {
            // No filename - prompt for one
            Editor_SaveAs()
            ReturnValue(1)
        }
        
        fd = SystemCall(2, Editor.filename, 577, 420)
        IfCondition LessThan(fd, 0) ThenBlock: {
            Editor.status_msg = "Error: Cannot save file"
            ReturnValue(0)
        }
        
        i = 0
        WhileLoop LessThan(i, Editor.line_count) {
            line = XArray.XGet(Editor.lines, i)
            len = StringLength(line)
            SystemCall(1, fd, line, len)
            SystemCall(1, fd, "\n", 1)
            i = Add(i, 1)
        }
        
        SystemCall(3, fd)
        
        Editor.modified = 0
        Editor.status_msg = "File saved"
        ReturnValue(1)
    }
}

Function.Editor_SaveAs {
    Body: {
        Editor.status_msg = "Save as: "
        Editor_Draw()
        Term_Flush()
        
        Editor.input_pos = 0
        i = 0
        WhileLoop LessThan(i, Editor.input_max) {
            SetByte(Editor.input_buf, i, 0)
            i = Add(i, 1)
        }
        
        done = 0
        WhileLoop EqualTo(done, 0) {
            key = TUI_GetKey()
            
            IfCondition EqualTo(key, TUI_Keys.KEY_ENTER) ThenBlock: {
                done = 1
            } ElseBlock: {
                IfCondition EqualTo(key, TUI_Keys.KEY_ESC) ThenBlock: {
                    Editor.status_msg = "Save cancelled"
                    ReturnValue(0)
                } ElseBlock: {
                    IfCondition EqualTo(key, TUI_Keys.KEY_BACKSPACE) ThenBlock: {
                        IfCondition GreaterThan(Editor.input_pos, 0) ThenBlock: {
                            Editor.input_pos = Subtract(Editor.input_pos, 1)
                            SetByte(Editor.input_buf, Editor.input_pos, 0)
                        }
                    } ElseBlock: {
                        IfCondition And(GreaterEqual(key, 32), LessThan(key, 127)) ThenBlock: {
                            IfCondition LessThan(Editor.input_pos, Subtract(Editor.input_max, 1)) ThenBlock: {
                                SetByte(Editor.input_buf, Editor.input_pos, key)
                                Editor.input_pos = Add(Editor.input_pos, 1)
                            }
                        }
                    }
                }
            }
            
            Term_MoveTo(Add(Editor.view_height, 1), 0)
            TUI_Print("Save as: ")
            TUI_Print(Editor.input_buf)
            Term_ClearEOL()
            Term_Flush()
        }
        
        IfCondition EqualTo(Editor.input_pos, 0) ThenBlock: {
            Editor.status_msg = "No filename given"
            ReturnValue(0)
        }
        
        // Copy input to filename buffer
        fname_buf = Allocate(Add(Editor.input_pos, 1))
        i = 0
        WhileLoop LessEqual(i, Editor.input_pos) {
            SetByte(fname_buf, i, GetByte(Editor.input_buf, i))
            i = Add(i, 1)
        }
        
        Editor.filename = fname_buf
        
        // Now save with the new filename
        fd = SystemCall(2, Editor.filename, 577, 420)
        IfCondition LessThan(fd, 0) ThenBlock: {
            Editor.status_msg = "Error: Cannot save file"
            ReturnValue(0)
        }
        
        i = 0
        WhileLoop LessThan(i, Editor.line_count) {
            line = XArray.XGet(Editor.lines, i)
            len = StringLength(line)
            SystemCall(1, fd, line, len)
            SystemCall(1, fd, "\n", 1)
            i = Add(i, 1)
        }
        
        SystemCall(3, fd)
        
        Editor.modified = 0
        Editor.status_msg = "File saved"
        ReturnValue(1)
    }
}

// =============================================================================
// OPEN FILE DIALOG
// =============================================================================

Function.Editor_OpenFile {
    Body: {
        // Warn if modified
        IfCondition EqualTo(Editor.modified, 1) ThenBlock: {
            Editor.status_msg = "Discard changes? (Y/N)"
            Editor_Draw()
            Term_Flush()
            
            key = TUI_GetKey()
            IfCondition And(NotEqual(key, 89), NotEqual(key, 121)) ThenBlock: {
                Editor.status_msg = "Open cancelled"
                ReturnValue(0)
            }
        }
        
        Editor.status_msg = "Open file: "
        Editor_Draw()
        Term_Flush()
        
        Editor.input_pos = 0
        i = 0
        WhileLoop LessThan(i, Editor.input_max) {
            SetByte(Editor.input_buf, i, 0)
            i = Add(i, 1)
        }
        
        done = 0
        WhileLoop EqualTo(done, 0) {
            key = TUI_GetKey()
            
            IfCondition EqualTo(key, TUI_Keys.KEY_ENTER) ThenBlock: {
                done = 1
            } ElseBlock: {
                IfCondition EqualTo(key, TUI_Keys.KEY_ESC) ThenBlock: {
                    Editor.status_msg = "Open cancelled"
                    ReturnValue(0)
                } ElseBlock: {
                    IfCondition EqualTo(key, TUI_Keys.KEY_BACKSPACE) ThenBlock: {
                        IfCondition GreaterThan(Editor.input_pos, 0) ThenBlock: {
                            Editor.input_pos = Subtract(Editor.input_pos, 1)
                            SetByte(Editor.input_buf, Editor.input_pos, 0)
                        }
                    } ElseBlock: {
                        IfCondition And(GreaterEqual(key, 32), LessThan(key, 127)) ThenBlock: {
                            IfCondition LessThan(Editor.input_pos, Subtract(Editor.input_max, 1)) ThenBlock: {
                                SetByte(Editor.input_buf, Editor.input_pos, key)
                                Editor.input_pos = Add(Editor.input_pos, 1)
                            }
                        }
                    }
                }
            }
            
            Term_MoveTo(Add(Editor.view_height, 1), 0)
            TUI_Print("Open file: ")
            TUI_Print(Editor.input_buf)
            Term_ClearEOL()
            Term_Flush()
        }
        
        IfCondition EqualTo(Editor.input_pos, 0) ThenBlock: {
            Editor.status_msg = "No filename given"
            ReturnValue(0)
        }
        
        // Copy input to filename buffer
        fname_buf = Allocate(Add(Editor.input_pos, 1))
        i = 0
        WhileLoop LessEqual(i, Editor.input_pos) {
            SetByte(fname_buf, i, GetByte(Editor.input_buf, i))
            i = Add(i, 1)
        }
        
        // Clear current buffer and load new file
        Editor_ClearBuffer()
        
        // Add one empty line
        empty = Allocate(1)
        SetByte(empty, 0, 0)
        XArray.XPush(Editor.lines, empty)
        Editor.line_count = 1
        
        Editor.cursor_row = 0
        Editor.cursor_col = 0
        Editor.view_top = 0
        Editor.view_left = 0
        Editor.modified = 0
        
        // Load the file
        Editor_Load(fname_buf)
    }
}

Function.Editor_ClearBuffer {
    Body: {
        i = 0
        WhileLoop LessThan(i, Editor.line_count) {
            line = XArray.XGet(Editor.lines, i)
            IfCondition NotEqual(line, 0) ThenBlock: {
                Deallocate(line, Add(StringLength(line), 1))
            }
            i = Add(i, 1)
        }
        XArray.XDestroy(Editor.lines)
        Editor.lines = XArray.XCreate(Editor.max_lines)
        Editor.line_count = 0
    }
}

// =============================================================================
// DISPLAY
// =============================================================================

Function.Editor_Draw {
    Body: {
        Term_HideCursor()
        Term_MoveTo(0, 0)

        screen_row = 0
        WhileLoop LessThan(screen_row, Editor.view_height) {
            file_row = Add(Editor.view_top, screen_row)
            Term_MoveTo(screen_row, 0)

            IfCondition LessThan(file_row, Editor.line_count) ThenBlock: {
                Term_SetColor(ANSI.CYAN)
                Editor_DrawLineNum(file_row)
                Term_ResetColor()
                TUI_PrintChar(32)

                line = XArray.XGet(Editor.lines, file_row)
                Editor_DrawLineContent(line)
            } ElseBlock: {
                Term_SetColor(ANSI.BLUE)
                TUI_PrintChar(126)
                Term_ResetColor()
            }

            Term_ClearEOL()
            screen_row = Add(screen_row, 1)
        }

        Editor_DrawStatusBar()

        screen_cursor_row = Subtract(Editor.cursor_row, Editor.view_top)
        screen_cursor_col = Add(Subtract(Editor.cursor_col, Editor.view_left), Editor.line_num_width)
        screen_cursor_col = Add(screen_cursor_col, 1)
        Term_MoveTo(screen_cursor_row, screen_cursor_col)

        Term_ShowCursor()
    }
}

Function.Editor_DrawLineNum {
    Input: num: Integer
    Body: {
        display_num = Add(num, 1)

        IfCondition LessThan(display_num, 10) ThenBlock: {
            TUI_Print("   ")
        } ElseBlock: {
            IfCondition LessThan(display_num, 100) ThenBlock: {
                TUI_Print("  ")
            } ElseBlock: {
                IfCondition LessThan(display_num, 1000) ThenBlock: {
                    TUI_Print(" ")
                }
            }
        }
        TUI_PrintNum(display_num)
    }
}

// Draw line content with horizontal scroll support
Function.Editor_DrawLineContent {
    Input: line: Address
    Body: {
        len = StringLength(line)
        avail_width = Subtract(Editor.view_width, Add(Editor.line_num_width, 1))
        
        // Start from view_left position
        i = Editor.view_left
        chars_drawn = 0
        
        WhileLoop And(LessThan(i, len), LessThan(chars_drawn, avail_width)) {
            ch = GetByte(line, i)
            
            // Handle tabs
            IfCondition EqualTo(ch, 9) ThenBlock: {
                spaces = Subtract(4, Modulo(chars_drawn, 4))
                j = 0
                WhileLoop And(LessThan(j, spaces), LessThan(chars_drawn, avail_width)) {
                    TUI_PrintChar(32)
                    chars_drawn = Add(chars_drawn, 1)
                    j = Add(j, 1)
                }
            } ElseBlock: {
                // Simple syntax coloring
                IfCondition And(GreaterEqual(ch, 48), LessEqual(ch, 57)) ThenBlock: {
                    Term_SetColor(ANSI.YELLOW)
                } ElseBlock: {
                    IfCondition EqualTo(ch, 34) ThenBlock: {
                        Term_SetColor(ANSI.GREEN)
                    }
                }
                TUI_PrintChar(ch)
                Term_ResetColor()
                chars_drawn = Add(chars_drawn, 1)
            }
            
            i = Add(i, 1)
        }
    }
}

Function.Editor_DrawStatusBar {
    Body: {
        // Status line
        Term_MoveTo(Editor.view_height, 0)
        Term_Invert()

        IfCondition NotEqual(Editor.filename, 0) ThenBlock: {
            TUI_Print(Editor.filename)
        } ElseBlock: {
            TUI_Print("[No Name]")
        }

        IfCondition EqualTo(Editor.modified, 1) ThenBlock: {
            TUI_Print(" [Modified]")
        }

        TUI_Print(" | Ln ")
        TUI_PrintNum(Add(Editor.cursor_row, 1))
        TUI_Print("/")
        TUI_PrintNum(Editor.line_count)
        TUI_Print(" Col ")
        TUI_PrintNum(Add(Editor.cursor_col, 1))

        Term_ClearEOL()
        Term_ResetColor()

        // Message line
        Term_MoveTo(Add(Editor.view_height, 1), 0)
        IfCondition NotEqual(Editor.status_msg, 0) ThenBlock: {
            TUI_Print(Editor.status_msg)
        }
        Term_ClearEOL()
        
        // F-key menu bar
        Editor_DrawMenuBar()
    }
}

Function.Editor_DrawMenuBar {
    Body: {
        // Always draw at absolute bottom of screen
        screen_height = TUI_GetHeight()
        Term_MoveTo(Subtract(screen_height, 1), 0)
        
        // F1 Help
        Term_Invert()
        TUI_Print("F1")
        Term_ResetColor()
        TUI_Print("Help ")
        
        // F2 Save
        Term_Invert()
        TUI_Print("F2")
        Term_ResetColor()
        TUI_Print("Save ")
        
        // F3 Open
        Term_Invert()
        TUI_Print("F3")
        Term_ResetColor()
        TUI_Print("Open ")
        
        // F5 Find
        Term_Invert()
        TUI_Print("F5")
        Term_ResetColor()
        TUI_Print("Find ")
        
        // F6 Next
        Term_Invert()
        TUI_Print("F6")
        Term_ResetColor()
        TUI_Print("Next ")
        
        // F7 GoTo
        Term_Invert()
        TUI_Print("F7")
        Term_ResetColor()
        TUI_Print("GoTo ")
        
        // F8 Cut
        Term_Invert()
        TUI_Print("F8")
        Term_ResetColor()
        TUI_Print("Cut ")
        
        // F10 Exit
        Term_Invert()
        TUI_Print("F10")
        Term_ResetColor()
        TUI_Print("Exit")
        
        Term_ClearEOL()
    }
}

// =============================================================================
// CURSOR MOVEMENT
// =============================================================================

Function.Editor_MoveUp {
    Body: {
        IfCondition GreaterThan(Editor.cursor_row, 0) ThenBlock: {
            Editor.cursor_row = Subtract(Editor.cursor_row, 1)
            Editor_ClampCursorCol()
            Editor_ScrollIfNeeded()
        }
    }
}

Function.Editor_MoveDown {
    Body: {
        IfCondition LessThan(Editor.cursor_row, Subtract(Editor.line_count, 1)) ThenBlock: {
            Editor.cursor_row = Add(Editor.cursor_row, 1)
            Editor_ClampCursorCol()
            Editor_ScrollIfNeeded()
        }
    }
}

Function.Editor_MoveLeft {
    Body: {
        IfCondition GreaterThan(Editor.cursor_col, 0) ThenBlock: {
            Editor.cursor_col = Subtract(Editor.cursor_col, 1)
            Editor_ScrollHorizontalIfNeeded()
        } ElseBlock: {
            IfCondition GreaterThan(Editor.cursor_row, 0) ThenBlock: {
                Editor.cursor_row = Subtract(Editor.cursor_row, 1)
                line = XArray.XGet(Editor.lines, Editor.cursor_row)
                Editor.cursor_col = StringLength(line)
                Editor_ScrollIfNeeded()
                Editor_ScrollHorizontalIfNeeded()
            }
        }
    }
}

Function.Editor_MoveRight {
    Body: {
        line = XArray.XGet(Editor.lines, Editor.cursor_row)
        line_len = StringLength(line)
        
        IfCondition LessThan(Editor.cursor_col, line_len) ThenBlock: {
            Editor.cursor_col = Add(Editor.cursor_col, 1)
            Editor_ScrollHorizontalIfNeeded()
        } ElseBlock: {
            IfCondition LessThan(Editor.cursor_row, Subtract(Editor.line_count, 1)) ThenBlock: {
                Editor.cursor_row = Add(Editor.cursor_row, 1)
                Editor.cursor_col = 0
                Editor.view_left = 0
                Editor_ScrollIfNeeded()
            }
        }
    }
}

Function.Editor_PageUp {
    Body: {
        jump = Subtract(Editor.view_height, 2)
        IfCondition GreaterEqual(Editor.cursor_row, jump) ThenBlock: {
            Editor.cursor_row = Subtract(Editor.cursor_row, jump)
        } ElseBlock: {
            Editor.cursor_row = 0
        }
        Editor_ClampCursorCol()
        Editor_ScrollIfNeeded()
    }
}

Function.Editor_PageDown {
    Body: {
        jump = Subtract(Editor.view_height, 2)
        new_row = Add(Editor.cursor_row, jump)
        max_row = Subtract(Editor.line_count, 1)
        
        IfCondition LessEqual(new_row, max_row) ThenBlock: {
            Editor.cursor_row = new_row
        } ElseBlock: {
            Editor.cursor_row = max_row
        }
        Editor_ClampCursorCol()
        Editor_ScrollIfNeeded()
    }
}

Function.Editor_ClampCursorCol {
    Body: {
        line = XArray.XGet(Editor.lines, Editor.cursor_row)
        line_len = StringLength(line)
        IfCondition GreaterThan(Editor.cursor_col, line_len) ThenBlock: {
            Editor.cursor_col = line_len
        }
        Editor_ScrollHorizontalIfNeeded()
    }
}

Function.Editor_ScrollIfNeeded {
    Body: {
        IfCondition LessThan(Editor.cursor_row, Editor.view_top) ThenBlock: {
            Editor.view_top = Editor.cursor_row
        }
        
        view_bottom = Add(Editor.view_top, Subtract(Editor.view_height, 1))
        IfCondition GreaterThan(Editor.cursor_row, view_bottom) ThenBlock: {
            Editor.view_top = Subtract(Editor.cursor_row, Subtract(Editor.view_height, 1))
        }
    }
}

Function.Editor_ScrollHorizontalIfNeeded {
    Body: {
        avail = Subtract(Editor.view_width, Add(Editor.line_num_width, 2))
        
        IfCondition LessThan(Editor.cursor_col, Editor.view_left) ThenBlock: {
            Editor.view_left = Editor.cursor_col
        }
        
        IfCondition GreaterEqual(Editor.cursor_col, Add(Editor.view_left, avail)) ThenBlock: {
            Editor.view_left = Subtract(Editor.cursor_col, Subtract(avail, 1))
        }
    }
}

// =============================================================================
// EDITING
// =============================================================================

Function.Editor_InsertChar {
    Input: ch: Integer
    Body: {
        line = XArray.XGet(Editor.lines, Editor.cursor_row)
        old_len = StringLength(line)
        new_len = Add(old_len, 1)
        
        new_line = Allocate(Add(new_len, 1))
        
        i = 0
        WhileLoop LessThan(i, Editor.cursor_col) {
            SetByte(new_line, i, GetByte(line, i))
            i = Add(i, 1)
        }
        
        SetByte(new_line, Editor.cursor_col, ch)
        
        i = Editor.cursor_col
        WhileLoop LessThan(i, old_len) {
            SetByte(new_line, Add(i, 1), GetByte(line, i))
            i = Add(i, 1)
        }
        SetByte(new_line, new_len, 0)
        
        Deallocate(line, Add(old_len, 1))
        XArray.XSet(Editor.lines, Editor.cursor_row, new_line)
        
        Editor.cursor_col = Add(Editor.cursor_col, 1)
        Editor.modified = 1
        Editor_ScrollHorizontalIfNeeded()
    }
}

Function.Editor_Backspace {
    Body: {
        IfCondition GreaterThan(Editor.cursor_col, 0) ThenBlock: {
            line = XArray.XGet(Editor.lines, Editor.cursor_row)
            old_len = StringLength(line)
            new_len = Subtract(old_len, 1)
            
            new_line = Allocate(Add(new_len, 1))
            
            i = 0
            WhileLoop LessThan(i, Subtract(Editor.cursor_col, 1)) {
                SetByte(new_line, i, GetByte(line, i))
                i = Add(i, 1)
            }
            
            i = Editor.cursor_col
            WhileLoop LessThan(i, old_len) {
                SetByte(new_line, Subtract(i, 1), GetByte(line, i))
                i = Add(i, 1)
            }
            SetByte(new_line, new_len, 0)
            
            Deallocate(line, Add(old_len, 1))
            XArray.XSet(Editor.lines, Editor.cursor_row, new_line)
            
            Editor.cursor_col = Subtract(Editor.cursor_col, 1)
            Editor.modified = 1
            Editor_ScrollHorizontalIfNeeded()
        } ElseBlock: {
            IfCondition GreaterThan(Editor.cursor_row, 0) ThenBlock: {
                Editor_JoinLines(Subtract(Editor.cursor_row, 1))
            }
        }
    }
}

Function.Editor_Delete {
    Body: {
        line = XArray.XGet(Editor.lines, Editor.cursor_row)
        line_len = StringLength(line)
        
        IfCondition LessThan(Editor.cursor_col, line_len) ThenBlock: {
            // Delete char at cursor
            old_len = line_len
            new_len = Subtract(old_len, 1)
            
            new_line = Allocate(Add(new_len, 1))
            
            i = 0
            WhileLoop LessThan(i, Editor.cursor_col) {
                SetByte(new_line, i, GetByte(line, i))
                i = Add(i, 1)
            }
            
            i = Add(Editor.cursor_col, 1)
            WhileLoop LessThan(i, old_len) {
                SetByte(new_line, Subtract(i, 1), GetByte(line, i))
                i = Add(i, 1)
            }
            SetByte(new_line, new_len, 0)
            
            Deallocate(line, Add(old_len, 1))
            XArray.XSet(Editor.lines, Editor.cursor_row, new_line)
            Editor.modified = 1
        } ElseBlock: {
            // Join with next line
            IfCondition LessThan(Editor.cursor_row, Subtract(Editor.line_count, 1)) ThenBlock: {
                Editor_JoinLines(Editor.cursor_row)
            }
        }
    }
}

Function.Editor_Enter {
    Body: {
        line = XArray.XGet(Editor.lines, Editor.cursor_row)
        old_len = StringLength(line)
        
        first_len = Editor.cursor_col
        first = Allocate(Add(first_len, 1))
        i = 0
        WhileLoop LessThan(i, first_len) {
            SetByte(first, i, GetByte(line, i))
            i = Add(i, 1)
        }
        SetByte(first, first_len, 0)
        
        second_len = Subtract(old_len, Editor.cursor_col)
        second = Allocate(Add(second_len, 1))
        i = 0
        WhileLoop LessThan(i, second_len) {
            SetByte(second, i, GetByte(line, Add(Editor.cursor_col, i)))
            i = Add(i, 1)
        }
        SetByte(second, second_len, 0)
        
        Deallocate(line, Add(old_len, 1))
        XArray.XSet(Editor.lines, Editor.cursor_row, first)
        
        Editor_InsertLineAt(Add(Editor.cursor_row, 1), second)
        
        Editor.cursor_row = Add(Editor.cursor_row, 1)
        Editor.cursor_col = 0
        Editor.view_left = 0
        Editor.modified = 1
        Editor_ScrollIfNeeded()
    }
}

Function.Editor_InsertLineAt {
    Input: row: Integer
    Input: line: Address
    Body: {
        // First, push a placeholder to grow the array
        XArray.XPush(Editor.lines, 0)
        
        // Now shift elements down (from end to insertion point)
        i = Editor.line_count  // This is the NEW last index after push
        WhileLoop GreaterThan(i, row) {
            prev = XArray.XGet(Editor.lines, Subtract(i, 1))
            XArray.XSet(Editor.lines, i, prev)
            i = Subtract(i, 1)
        }
        
        // Insert the new line
        XArray.XSet(Editor.lines, row, line)
        Editor.line_count = Add(Editor.line_count, 1)
    }
}

Function.Editor_JoinLines {
    Input: row: Integer
    Body: {
        IfCondition GreaterEqual(row, Subtract(Editor.line_count, 1)) ThenBlock: {
            ReturnValue(0)
        }
        
        line1 = XArray.XGet(Editor.lines, row)
        line2 = XArray.XGet(Editor.lines, Add(row, 1))
        
        len1 = StringLength(line1)
        len2 = StringLength(line2)
        new_len = Add(len1, len2)
        
        new_line = Allocate(Add(new_len, 1))
        
        i = 0
        WhileLoop LessThan(i, len1) {
            SetByte(new_line, i, GetByte(line1, i))
            i = Add(i, 1)
        }
        
        i = 0
        WhileLoop LessThan(i, len2) {
            SetByte(new_line, Add(len1, i), GetByte(line2, i))
            i = Add(i, 1)
        }
        SetByte(new_line, new_len, 0)
        
        Deallocate(line1, Add(len1, 1))
        XArray.XSet(Editor.lines, row, new_line)
        
        Deallocate(line2, Add(len2, 1))
        Editor_DeleteLineAt(Add(row, 1))
        
        Editor.cursor_row = row
        Editor.cursor_col = len1
        Editor.modified = 1
        Editor_ScrollHorizontalIfNeeded()
    }
}

Function.Editor_DeleteLineAt {
    Input: row: Integer
    Body: {
        i = row
        WhileLoop LessThan(i, Subtract(Editor.line_count, 1)) {
            next = XArray.XGet(Editor.lines, Add(i, 1))
            XArray.XSet(Editor.lines, i, next)
            i = Add(i, 1)
        }
        Editor.line_count = Subtract(Editor.line_count, 1)
    }
}

// =============================================================================
// GO TO LINE (Ctrl+G)
// =============================================================================

Function.Editor_GotoLine {
    Body: {
        Editor.status_msg = "Go to line: "
        Editor_Draw()
        Term_Flush()
        
        // Read line number
        Editor.input_pos = 0
        i = 0
        WhileLoop LessThan(i, Editor.input_max) {
            SetByte(Editor.input_buf, i, 0)
            i = Add(i, 1)
        }
        
        done = 0
        WhileLoop EqualTo(done, 0) {
            key = TUI_GetKey()
            
            IfCondition EqualTo(key, TUI_Keys.KEY_ENTER) ThenBlock: {
                done = 1
            } ElseBlock: {
                IfCondition EqualTo(key, TUI_Keys.KEY_ESC) ThenBlock: {
                    Editor.status_msg = "Cancelled"
                    ReturnValue(0)
                } ElseBlock: {
                    IfCondition EqualTo(key, TUI_Keys.KEY_BACKSPACE) ThenBlock: {
                        IfCondition GreaterThan(Editor.input_pos, 0) ThenBlock: {
                            Editor.input_pos = Subtract(Editor.input_pos, 1)
                            SetByte(Editor.input_buf, Editor.input_pos, 0)
                        }
                    } ElseBlock: {
                        IfCondition And(GreaterEqual(key, 48), LessEqual(key, 57)) ThenBlock: {
                            IfCondition LessThan(Editor.input_pos, Subtract(Editor.input_max, 1)) ThenBlock: {
                                SetByte(Editor.input_buf, Editor.input_pos, key)
                                Editor.input_pos = Add(Editor.input_pos, 1)
                            }
                        }
                    }
                }
            }
            
            // Redraw prompt
            Term_MoveTo(Add(Editor.view_height, 1), 0)
            TUI_Print("Go to line: ")
            TUI_Print(Editor.input_buf)
            Term_ClearEOL()
            Term_Flush()
        }
        
        // Parse number
        target = 0
        i = 0
        WhileLoop LessThan(i, Editor.input_pos) {
            ch = GetByte(Editor.input_buf, i)
            digit = Subtract(ch, 48)
            target = Add(Multiply(target, 10), digit)
            i = Add(i, 1)
        }
        
        // Go to line (1-indexed input, 0-indexed internal)
        target = Subtract(target, 1)
        IfCondition LessThan(target, 0) ThenBlock: {
            target = 0
        }
        IfCondition GreaterEqual(target, Editor.line_count) ThenBlock: {
            target = Subtract(Editor.line_count, 1)
        }
        
        Editor.cursor_row = target
        Editor.cursor_col = 0
        Editor.view_left = 0
        Editor_ScrollIfNeeded()
        Editor.status_msg = "^S Save  ^G Goto  ^F Find  ^Q Quit"
    }
}

// =============================================================================
// SEARCH (Ctrl+F)
// =============================================================================

Function.Editor_Search {
    Body: {
        Editor.status_msg = "Search: "
        Editor_Draw()
        Term_Flush()
        
        Editor.input_pos = 0
        i = 0
        WhileLoop LessThan(i, Editor.input_max) {
            SetByte(Editor.input_buf, i, 0)
            i = Add(i, 1)
        }
        
        done = 0
        WhileLoop EqualTo(done, 0) {
            key = TUI_GetKey()
            
            IfCondition EqualTo(key, TUI_Keys.KEY_ENTER) ThenBlock: {
                done = 1
            } ElseBlock: {
                IfCondition EqualTo(key, TUI_Keys.KEY_ESC) ThenBlock: {
                    Editor.status_msg = "Cancelled"
                    ReturnValue(0)
                } ElseBlock: {
                    IfCondition EqualTo(key, TUI_Keys.KEY_BACKSPACE) ThenBlock: {
                        IfCondition GreaterThan(Editor.input_pos, 0) ThenBlock: {
                            Editor.input_pos = Subtract(Editor.input_pos, 1)
                            SetByte(Editor.input_buf, Editor.input_pos, 0)
                        }
                    } ElseBlock: {
                        IfCondition And(GreaterEqual(key, 32), LessThan(key, 127)) ThenBlock: {
                            IfCondition LessThan(Editor.input_pos, Subtract(Editor.input_max, 1)) ThenBlock: {
                                SetByte(Editor.input_buf, Editor.input_pos, key)
                                Editor.input_pos = Add(Editor.input_pos, 1)
                            }
                        }
                    }
                }
            }
            
            Term_MoveTo(Add(Editor.view_height, 1), 0)
            TUI_Print("Search: ")
            TUI_Print(Editor.input_buf)
            Term_ClearEOL()
            Term_Flush()
        }
        
        IfCondition EqualTo(Editor.input_pos, 0) ThenBlock: {
            Editor.status_msg = "Empty search"
            ReturnValue(0)
        }
        
        // Copy to search buffer
        i = 0
        WhileLoop LessEqual(i, Editor.input_pos) {
            SetByte(Editor.search_buf, i, GetByte(Editor.input_buf, i))
            i = Add(i, 1)
        }
        Editor.search_len = Editor.input_pos
        
        Editor_FindNext()
    }
}

Function.Editor_FindNext {
    Body: {
        IfCondition EqualTo(Editor.search_len, 0) ThenBlock: {
            Editor.status_msg = "No search pattern"
            ReturnValue(0)
        }
        
        // Start from current position
        start_row = Editor.cursor_row
        start_col = Add(Editor.cursor_col, 1)
        
        row = start_row
        WhileLoop LessThan(row, Editor.line_count) {
            line = XArray.XGet(Editor.lines, row)
            line_len = StringLength(line)
            
            col = 0
            IfCondition EqualTo(row, start_row) ThenBlock: {
                col = start_col
            }
            
            WhileLoop LessEqual(col, Subtract(line_len, Editor.search_len)) {
                match = 1
                i = 0
                WhileLoop LessThan(i, Editor.search_len) {
                    c1 = GetByte(line, Add(col, i))
                    c2 = GetByte(Editor.search_buf, i)
                    IfCondition NotEqual(c1, c2) ThenBlock: {
                        match = 0
                        ExitLoop
                    }
                    i = Add(i, 1)
                }
                
                IfCondition EqualTo(match, 1) ThenBlock: {
                    Editor.cursor_row = row
                    Editor.cursor_col = col
                    Editor_ScrollIfNeeded()
                    Editor_ScrollHorizontalIfNeeded()
                    Editor.status_msg = "Found. Ctrl+N next"
                    ReturnValue(1)
                }
                
                col = Add(col, 1)
            }
            
            row = Add(row, 1)
        }
        
        Editor.status_msg = "Not found"
        ReturnValue(0)
    }
}

// =============================================================================
// HELP SCREEN
// =============================================================================

Function.Editor_ShowHelp {
    Body: {
        Term_Clear()
        Term_MoveTo(0, 0)
        
        TUI_Print("  AILang Editor Help")
        Term_MoveTo(1, 0)
        TUI_Print("  ==================")
        
        Term_MoveTo(3, 0)
        TUI_Print("  Navigation:")
        Term_MoveTo(4, 0)
        TUI_Print("    Arrow Keys    Move cursor")
        Term_MoveTo(5, 0)
        TUI_Print("    Home/End      Start/end of line")
        Term_MoveTo(6, 0)
        TUI_Print("    Page Up/Down  Page navigation")
        
        Term_MoveTo(8, 0)
        TUI_Print("  Editing:")
        Term_MoveTo(9, 0)
        TUI_Print("    Enter         New line")
        Term_MoveTo(10, 0)
        TUI_Print("    Backspace     Delete before cursor")
        Term_MoveTo(11, 0)
        TUI_Print("    Delete        Delete at cursor")
        Term_MoveTo(12, 0)
        TUI_Print("    Tab           Insert 4 spaces")
        
        Term_MoveTo(14, 0)
        TUI_Print("  Commands:")
        Term_MoveTo(15, 0)
        TUI_Print("    F1  Help        F2  Save file")
        Term_MoveTo(16, 0)
        TUI_Print("    F3  Open file   F5  Search")
        Term_MoveTo(17, 0)
        TUI_Print("    F6  Find next   F7  Go to line")
        Term_MoveTo(18, 0)
        TUI_Print("    F8  Cut line    F10 Exit")
        
        Term_MoveTo(20, 0)
        TUI_Print("  Press any key to return...")
        Term_Flush()
        
        TUI_GetKey()
        Editor.status_msg = ""
    }
}

// =============================================================================
// CUT LINE
// =============================================================================

Function.Editor_CutLine {
    Body: {
        IfCondition EqualTo(Editor.line_count, 1) ThenBlock: {
            // Only one line - clear it instead
            line = XArray.XGet(Editor.lines, 0)
            Deallocate(line, Add(StringLength(line), 1))
            empty = Allocate(1)
            SetByte(empty, 0, 0)
            XArray.XSet(Editor.lines, 0, empty)
            Editor.cursor_col = 0
            Editor.modified = 1
            Editor.status_msg = "Line cleared"
            ReturnValue(0)
        }
        
        // Free the current line
        line = XArray.XGet(Editor.lines, Editor.cursor_row)
        Deallocate(line, Add(StringLength(line), 1))
        
        // Shift all lines up
        i = Editor.cursor_row
        WhileLoop LessThan(i, Subtract(Editor.line_count, 1)) {
            next = XArray.XGet(Editor.lines, Add(i, 1))
            XArray.XSet(Editor.lines, i, next)
            i = Add(i, 1)
        }
        
        Editor.line_count = Subtract(Editor.line_count, 1)
        
        // Adjust cursor if at end
        IfCondition GreaterEqual(Editor.cursor_row, Editor.line_count) ThenBlock: {
            Editor.cursor_row = Subtract(Editor.line_count, 1)
        }
        
        Editor_ClampCursorCol()
        Editor.modified = 1
        Editor.status_msg = "Line cut"
    }
}

// =============================================================================
// CONFIRM EXIT
// =============================================================================

Function.Editor_ConfirmExit {
    Body: {
        IfCondition EqualTo(Editor.modified, 0) ThenBlock: {
            Editor.running = 0
            ReturnValue(0)
        }
        
        // File modified - ask to save
        Editor.status_msg = "Save modified buffer? (Y/N/C)"
        Editor_Draw()
        Term_Flush()
        
        key = TUI_GetKey()
        
        // Y = save and exit
        IfCondition Or(EqualTo(key, 89), EqualTo(key, 121)) ThenBlock: {
            Editor_Save()
            Editor.running = 0
            ReturnValue(0)
        }
        
        // N = exit without saving
        IfCondition Or(EqualTo(key, 78), EqualTo(key, 110)) ThenBlock: {
            Editor.running = 0
            ReturnValue(0)
        }
        
        // C or anything else = cancel
        Editor.status_msg = "Exit cancelled"
    }
}

// =============================================================================
// INPUT HANDLING
// =============================================================================

Function.Editor_ProcessKey {
    Input: key: Integer
    Body: {
        // Arrow keys
        IfCondition EqualTo(key, TUI_Keys.KEY_UP) ThenBlock: { Editor_MoveUp() ReturnValue(0) }
        IfCondition EqualTo(key, TUI_Keys.KEY_DOWN) ThenBlock: { Editor_MoveDown() ReturnValue(0) }
        IfCondition EqualTo(key, TUI_Keys.KEY_LEFT) ThenBlock: { Editor_MoveLeft() ReturnValue(0) }
        IfCondition EqualTo(key, TUI_Keys.KEY_RIGHT) ThenBlock: { Editor_MoveRight() ReturnValue(0) }
        
        // Page keys
        IfCondition EqualTo(key, TUI_Keys.KEY_PGUP) ThenBlock: { Editor_PageUp() ReturnValue(0) }
        IfCondition EqualTo(key, TUI_Keys.KEY_PGDN) ThenBlock: { Editor_PageDown() ReturnValue(0) }
        
        // Home/End
        IfCondition EqualTo(key, TUI_Keys.KEY_HOME) ThenBlock: {
            Editor.cursor_col = 0
            Editor.view_left = 0
            ReturnValue(0)
        }
        IfCondition EqualTo(key, TUI_Keys.KEY_END) ThenBlock: {
            line = XArray.XGet(Editor.lines, Editor.cursor_row)
            Editor.cursor_col = StringLength(line)
            Editor_ScrollHorizontalIfNeeded()
            ReturnValue(0)
        }

        // ===========================================
        // F-KEY COMMANDS
        // ===========================================
        
        // F1 = Help
        IfCondition EqualTo(key, FKeys.F1) ThenBlock: {
            Editor_ShowHelp()
            ReturnValue(0)
        }
        
        // F2 = Save
        IfCondition EqualTo(key, FKeys.F2) ThenBlock: {
            Editor_Save()
            ReturnValue(0)
        }
        
        // F3 = Open
        IfCondition EqualTo(key, FKeys.F3) ThenBlock: {
            Editor_OpenFile()
            ReturnValue(0)
        }
        
        // F5 = Search
        IfCondition EqualTo(key, FKeys.F5) ThenBlock: {
            Editor_Search()
            ReturnValue(0)
        }
        
        // F6 = Find next
        IfCondition EqualTo(key, FKeys.F6) ThenBlock: {
            Editor_FindNext()
            ReturnValue(0)
        }
        
        // F7 = Go to line
        IfCondition EqualTo(key, FKeys.F7) ThenBlock: {
            Editor_GotoLine()
            ReturnValue(0)
        }
        
        // F8 = Cut line
        IfCondition EqualTo(key, FKeys.F8) ThenBlock: {
            Editor_CutLine()
            ReturnValue(0)
        }
        
        // F10 = Exit
        IfCondition EqualTo(key, FKeys.F10) ThenBlock: {
            Editor_ConfirmExit()
            ReturnValue(0)
        }

        // Backspace
        IfCondition EqualTo(key, TUI_Keys.KEY_BACKSPACE) ThenBlock: {
            Editor_Backspace()
            ReturnValue(0)
        }
        IfCondition EqualTo(key, 8) ThenBlock: {
            Editor_Backspace()
            ReturnValue(0)
        }
        
        // Delete
        IfCondition EqualTo(key, TUI_Keys.KEY_DELETE) ThenBlock: {
            Editor_Delete()
            ReturnValue(0)
        }

        // Enter
        IfCondition EqualTo(key, TUI_Keys.KEY_ENTER) ThenBlock: {
            Editor_Enter()
            ReturnValue(0)
        }
        IfCondition EqualTo(key, 13) ThenBlock: {
            Editor_Enter()
            ReturnValue(0)
        }

        // Tab -> 4 spaces
        IfCondition EqualTo(key, TUI_Keys.KEY_TAB) ThenBlock: {
            Editor_InsertChar(32)
            Editor_InsertChar(32)
            Editor_InsertChar(32)
            Editor_InsertChar(32)
            ReturnValue(0)
        }

        // ESC = Clear message
        IfCondition EqualTo(key, TUI_Keys.KEY_ESC) ThenBlock: {
            Editor.status_msg = ""
            ReturnValue(0)
        }

        // Printable characters
        IfCondition And(GreaterEqual(key, 32), LessThan(key, 127)) ThenBlock: {
            Editor_InsertChar(key)
        }
    }
}

// =============================================================================
// MAIN ENTRY POINT
// =============================================================================

Function.Editor_Open {
    Input: filename: Address
    Body: {
        Editor_Init()

        TUI_Init()
        
        // Show startup dialog if no filename provided
        IfCondition EqualTo(filename, 0) ThenBlock: {
            Editor_StartupDialog()
        } ElseBlock: {
            Editor_Load(filename)
        }

        Editor.running = 1

        WhileLoop EqualTo(Editor.running, 1) {
            Editor_Draw()
            Term_Flush()
            key = TUI_GetKey()
            Editor_ProcessKey(key)
        }

        TUI_Shutdown()
        Editor_Free()
    }
}

// =============================================================================
// STARTUP DIALOG
// =============================================================================

Function.Editor_StartupDialog {
    Body: {
        // Calculate center position
        dialog_width = 40
        dialog_height = 12
        start_col = Divide(Subtract(Editor.view_width, dialog_width), 2)
        start_row = Divide(Subtract(Editor.view_height, dialog_height), 2)
        
        // Draw dialog
        Editor_DrawStartupDialog(start_row, start_col, dialog_width, dialog_height)
        Term_Flush()
        
        // Wait for selection
        done = 0
        WhileLoop EqualTo(done, 0) {
            key = TUI_GetKey()
            
            // 1 or N = New file
            IfCondition Or(EqualTo(key, 49), Or(EqualTo(key, 78), EqualTo(key, 110))) ThenBlock: {
                Editor.filename = 0
                Editor.status_msg = "New file"
                done = 1
            }
            
            // 2 or O = Open file
            IfCondition Or(EqualTo(key, 50), Or(EqualTo(key, 79), EqualTo(key, 111))) ThenBlock: {
                Editor_PromptOpenFile()
                done = 1
            }
            
            // ESC or Q = Quit
            IfCondition Or(EqualTo(key, TUI_Keys.KEY_ESC), Or(EqualTo(key, 81), EqualTo(key, 113))) ThenBlock: {
                Editor.running = 0
                done = 1
            }
        }
    }
}

Function.Editor_DrawStartupDialog {
    Input: row: Integer
    Input: col: Integer
    Input: width: Integer
    Input: height: Integer
    Body: {
        // Clear screen first
        Term_Clear()
        
        // Draw box top
        Term_MoveTo(row, col)
        TUI_PrintChar(43)  // +
        i = 0
        WhileLoop LessThan(i, Subtract(width, 2)) {
            TUI_PrintChar(45)  // -
            i = Add(i, 1)
        }
        TUI_PrintChar(43)  // +
        
        // Draw sides and fill
        i = 1
        WhileLoop LessThan(i, Subtract(height, 1)) {
            Term_MoveTo(Add(row, i), col)
            TUI_PrintChar(124)  // |
            j = 0
            WhileLoop LessThan(j, Subtract(width, 2)) {
                TUI_PrintChar(32)  // space
                j = Add(j, 1)
            }
            TUI_PrintChar(124)  // |
            i = Add(i, 1)
        }
        
        // Draw box bottom
        Term_MoveTo(Add(row, Subtract(height, 1)), col)
        TUI_PrintChar(43)  // +
        i = 0
        WhileLoop LessThan(i, Subtract(width, 2)) {
            TUI_PrintChar(45)  // -
            i = Add(i, 1)
        }
        TUI_PrintChar(43)  // +
        
        // Title
        Term_MoveTo(Add(row, 1), Add(col, 2))
        Term_Bold()
        TUI_Print("      AILang Editor v2.0")
        Term_ResetColor()
        
        // Divider
        Term_MoveTo(Add(row, 3), Add(col, 1))
        i = 0
        WhileLoop LessThan(i, Subtract(width, 2)) {
            TUI_PrintChar(45)
            i = Add(i, 1)
        }
        
        // Options
        Term_MoveTo(Add(row, 5), Add(col, 4))
        Term_Invert()
        TUI_Print(" 1 ")
        Term_ResetColor()
        TUI_Print("  New File")
        
        Term_MoveTo(Add(row, 7), Add(col, 4))
        Term_Invert()
        TUI_Print(" 2 ")
        Term_ResetColor()
        TUI_Print("  Open File")
        
        Term_MoveTo(Add(row, 9), Add(col, 4))
        Term_Invert()
        TUI_Print(" Q ")
        Term_ResetColor()
        TUI_Print("  Quit")
        
        // Draw the menu bar at bottom
        Editor_DrawMenuBar()
    }
}

Function.Editor_PromptOpenFile {
    Body: {
        // Calculate center for input
        input_row = Divide(Editor.view_height, 2)
        
        Term_MoveTo(input_row, 0)
        Term_ClearEOL()
        TUI_Print("  Open file: ")
        Term_Flush()
        
        Editor.input_pos = 0
        i = 0
        WhileLoop LessThan(i, Editor.input_max) {
            SetByte(Editor.input_buf, i, 0)
            i = Add(i, 1)
        }
        
        done = 0
        WhileLoop EqualTo(done, 0) {
            key = TUI_GetKey()
            
            IfCondition EqualTo(key, TUI_Keys.KEY_ENTER) ThenBlock: {
                done = 1
            } ElseBlock: {
                IfCondition EqualTo(key, TUI_Keys.KEY_ESC) ThenBlock: {
                    Editor.status_msg = "Cancelled"
                    ReturnValue(0)
                } ElseBlock: {
                    IfCondition EqualTo(key, TUI_Keys.KEY_BACKSPACE) ThenBlock: {
                        IfCondition GreaterThan(Editor.input_pos, 0) ThenBlock: {
                            Editor.input_pos = Subtract(Editor.input_pos, 1)
                            SetByte(Editor.input_buf, Editor.input_pos, 0)
                        }
                    } ElseBlock: {
                        IfCondition And(GreaterEqual(key, 32), LessThan(key, 127)) ThenBlock: {
                            IfCondition LessThan(Editor.input_pos, Subtract(Editor.input_max, 1)) ThenBlock: {
                                SetByte(Editor.input_buf, Editor.input_pos, key)
                                Editor.input_pos = Add(Editor.input_pos, 1)
                            }
                        }
                    }
                }
            }
            
            Term_MoveTo(input_row, 0)
            Term_ClearEOL()
            TUI_Print("  Open file: ")
            TUI_Print(Editor.input_buf)
            Term_Flush()
        }
        
        IfCondition EqualTo(Editor.input_pos, 0) ThenBlock: {
            Editor.status_msg = "No filename"
            ReturnValue(0)
        }
        
        // Copy to filename
        fname_buf = Allocate(Add(Editor.input_pos, 1))
        i = 0
        WhileLoop LessEqual(i, Editor.input_pos) {
            SetByte(fname_buf, i, GetByte(Editor.input_buf, i))
            i = Add(i, 1)
        }
        
        Editor_Load(fname_buf)
    }
}

Function.Editor_Command {
    Input: args: Address
    Body: {
        IfCondition EqualTo(StringLength(args), 0) ThenBlock: {
            Editor_Open(0)
        } ElseBlock: {
            Editor_Open(args)
        }
    }
}