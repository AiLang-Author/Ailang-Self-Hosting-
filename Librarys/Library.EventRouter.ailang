// Library.EventRouter.ailang
// Action queue and dispatch — the "what happens" side of event routing.
//
// InputRouter / Win_ToolbarEvent determine WHERE a click lands and push
// action strings onto the queue. EventRouter drains the queue in the main
// loop AFTER all Auckland contexts are restored, so it's safe to create
// windows, send IPC, modify any state.
//
// Copyright © 2026 Sean Collins, 2 Paws Machine and Engineering. SCSL.

LibraryImport.StringUtils
LibraryImport.WinManager

// =============================================================================
// ACTION QUEUE
//
// Circular buffer of action entries.
// Each entry: [action_ptr (8), action_len (8), source_win (8)]
//   source_win: which window generated the action
//     -1 = desktop taskbar
//      0 = desktop (shouldn't generate actions)
//     1+ = window index
//
// Max 16 pending actions. Overflow drops oldest.
// =============================================================================

FixedPool.ActionQueueConst {
    "ENTRY_SIZE": Initialize=24
    "MAX":        Initialize=16
}

FixedPool.ActionQueueFields {
    "ACTION_PTR":  Initialize=0
    "ACTION_LEN":  Initialize=8
    "SOURCE_WIN":  Initialize=16
}

FixedPool.ActionQueue {
    "data":  Initialize=0
    "head":  Initialize=0, CanChange=True
    "tail":  Initialize=0, CanChange=True
    "count": Initialize=0, CanChange=True
}

// =============================================================================
// INIT
// =============================================================================
Function.EventRouter_Init {
    Output: Integer
    Body: {
        sz = Multiply(ActionQueueConst.MAX, ActionQueueConst.ENTRY_SIZE)
        buf = Allocate(sz)
        IfCondition EqualTo(buf, 0) ThenBlock: {
            PrintMessage("[EventRouter] alloc fail\n")
            ReturnValue(0)
        }
        i = 0
        WhileLoop LessThan(i, sz) {
            SetByte(buf, i, 0)
            i = Add(i, 1)
        }
        ActionQueue.data  = buf
        ActionQueue.head  = 0
        ActionQueue.tail  = 0
        ActionQueue.count = 0
        PrintMessage("[EventRouter] initialized\n")
        ReturnValue(1)
    }
}

// =============================================================================
// PUSH — add an action to the queue
//
// Called by:
//   - EventRouter_ActionCallback (desktop taskbar, via AK_FireAction)
//   - Win_ToolbarEvent (after context restore, reads action from node)
// =============================================================================
Function.EventRouter_Push {
    Input: action_ptr: Address
    Input: action_len: Integer
    Input: source_win: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(action_ptr, 0) ThenBlock: { ReturnValue(0) }
        IfCondition LessEqual(action_len, 0) ThenBlock: { ReturnValue(0) }

        // If full, drop oldest
        IfCondition GreaterEqual(ActionQueue.count, ActionQueueConst.MAX) ThenBlock: {
            PrintMessage("[EventRouter] WARNING: queue full, dropping oldest\n")
            ActionQueue.head = Modulo(Add(ActionQueue.head, 1), ActionQueueConst.MAX)
            ActionQueue.count = Subtract(ActionQueue.count, 1)
        }

        // Write at tail
        off = Multiply(ActionQueue.tail, ActionQueueConst.ENTRY_SIZE)
        base = Add(ActionQueue.data, off)
        StoreValue(Add(base, ActionQueueFields.ACTION_PTR), action_ptr)
        StoreValue(Add(base, ActionQueueFields.ACTION_LEN), action_len)
        StoreValue(Add(base, ActionQueueFields.SOURCE_WIN), source_win)

        ActionQueue.tail = Modulo(Add(ActionQueue.tail, 1), ActionQueueConst.MAX)
        ActionQueue.count = Add(ActionQueue.count, 1)
        ReturnValue(1)
    }
}

// =============================================================================
// ACTION CALLBACK — safe to call from inside AK_FireAction
//
// This is what AKEvent.action_callback points to. AK_FireAction calls
// it via CallIndirect. All it does is push to the queue — no window
// creation, no context manipulation.
//
// Used by the desktop taskbar (global AKTree context).
// Toolbar events use a different path (manual push after restore).
// =============================================================================
Function.EventRouter_ActionCallback {
    Input: action_ptr: Address
    Input: action_len: Integer
    Output: Integer
    Body: {
        EventRouter_Push(action_ptr, action_len, -1)
        ReturnValue(1)
    }
}

// =============================================================================
// DRAIN — process all pending actions
//
// Called from main loop AFTER:
//   - SysDisplay_DrainInput returns (all mouse/key events processed)
//   - All Auckland contexts restored to main
//   - AK_DrawDirty done
//
// Returns number of actions processed.
// =============================================================================
Function.EventRouter_Drain {
    Output: Integer
    Body: {
        processed = 0

        WhileLoop GreaterThan(ActionQueue.count, 0) {
            // Read from head
            off = Multiply(ActionQueue.head, ActionQueueConst.ENTRY_SIZE)
            base = Add(ActionQueue.data, off)
            action_ptr = Dereference(Add(base, ActionQueueFields.ACTION_PTR))
            action_len = Dereference(Add(base, ActionQueueFields.ACTION_LEN))
            source_win = Dereference(Add(base, ActionQueueFields.SOURCE_WIN))

            PrintMessage("[ER_DRAIN] ptr=")
PrintNumber(action_ptr)
PrintMessage(" len=")
PrintNumber(action_len)
PrintMessage(" win=")
PrintNumber(source_win)
PrintMessage(" count=")
PrintNumber(ActionQueue.count)
PrintMessage("\n")

            // Advance head
            ActionQueue.head = Modulo(Add(ActionQueue.head, 1), ActionQueueConst.MAX)
            ActionQueue.count = Subtract(ActionQueue.count, 1)

            // Dispatch
            IfCondition NotEqual(action_ptr, 0) ThenBlock: {
                EventRouter_Dispatch(action_ptr, action_len, source_win)
                processed = Add(processed, 1)
            }
        }

        ReturnValue(processed)
    }
}

// =============================================================================
// DISPATCH — route a single action
//
// Priority:
//   1. WinView.bindings for source_win (future: IPC to service binary)
//   2. Internal handlers
//   3. Log unknown
// =============================================================================
Function.EventRouter_Dispatch {
    Input: action_ptr: Address
    Input: action_len: Integer
    Input: source_win: Integer
    Body: {
        // --- Priority 1: WinView bindings (future IPC) ---
        // When JobInstance is wired:
        //   if source_win >= 1:
        //     bindings = WinView_GetBindings(source_win)
        //     if bindings != 0: lookup action → build JSON → send socket
        //     return

        // --- Priority 2: Internal handlers ---
        handled = EventRouter_Internal(action_ptr, action_len, source_win)
        IfCondition EqualTo(handled, 1) ThenBlock: { ReturnValue(0) }

        // --- Priority 3: Unknown ---
        PrintMessage("[EventRouter] unknown: ")
        PrintString(action_ptr)
        PrintMessage(" from win ")
        PrintNumber(source_win)
        PrintMessage("\n")
    }
}

// =============================================================================
// INTERNAL HANDLERS
// Returns 1 if handled, 0 if not recognized.
// =============================================================================
Function.EventRouter_Internal {
    Input: action_ptr: Address
    Input: action_len: Integer
    Input: source_win: Integer
    Output: Integer
    Body: {
        // win.new
        cmp_new = StringCompare(action_ptr, "win.new")
        IfCondition EqualTo(cmp_new, 0) ThenBlock: {
            PrintMessage("[EventRouter] win.new\n")
            App_CreateDocWindow()
            SysDisplayState.dirty = 1
            ReturnValue(1)
        }

        // win.close
        cmp_close = StringCompare(action_ptr, "win.close")
        IfCondition EqualTo(cmp_close, 0) ThenBlock: {
            PrintMessage("[EventRouter] win.close\n")
            target = source_win





            PrintMessage("[ER_CLOSE] source=")
PrintNumber(source_win)
PrintMessage(" focused=")
PrintNumber(WinMgr.focused)
PrintMessage(" target=")
PrintNumber(target)
PrintMessage("\n")




            IfCondition LessEqual(target, 0) ThenBlock: {
                target = WinMgr.focused
            }
            IfCondition GreaterThan(target, 0) ThenBlock: {
                Win_Close(target)
                SysDisplayState.dirty = 1
            }
            ReturnValue(1)
        }

        // doc.addtext
        cmp_add = StringCompare(action_ptr, "doc.addtext")
        IfCondition EqualTo(cmp_add, 0) ThenBlock: {
            PrintMessage("[EventRouter] doc.addtext\n")
            App_AddLine()
            SysDisplayState.dirty = 1
            ReturnValue(1)
        }

        // doc.newpage
        cmp_np = StringCompare(action_ptr, "doc.newpage")
        IfCondition EqualTo(cmp_np, 0) ThenBlock: {
            PrintMessage("[EventRouter] doc.newpage — not yet\n")
            ReturnValue(1)
        }

        // doc.clear
        cmp_clr = StringCompare(action_ptr, "doc.clear")
        IfCondition EqualTo(cmp_clr, 0) ThenBlock: {
            PrintMessage("[EventRouter] doc.clear — not yet\n")
            ReturnValue(1)
        }

        // app.about
        cmp_about = StringCompare(action_ptr, "app.about")
        IfCondition EqualTo(cmp_about, 0) ThenBlock: {
            PrintMessage("[EventRouter] app.about\n")
            ReturnValue(1)
        }

        // menu:* prefix — future dropdown menus
        IfCondition GreaterEqual(action_len, 5) ThenBlock: {
            m0 = GetByte(action_ptr, 0)
            m1 = GetByte(action_ptr, 1)
            m2 = GetByte(action_ptr, 2)
            m3 = GetByte(action_ptr, 3)
            m4 = GetByte(action_ptr, 4)
            IfCondition And(
                And(EqualTo(m0, 109), EqualTo(m1, 101)),
                And(EqualTo(m2, 110), And(EqualTo(m3, 117), EqualTo(m4, 58)))
            ) ThenBlock: {
                PrintMessage("[EventRouter] menu: ")
                PrintString(action_ptr)
                PrintMessage("\n")
                ReturnValue(1)
            }
        }

        ReturnValue(0)
    }
}