// Library.FileDialog.ailang
// Two-pane file open/save dialog — Windows XP/7 style.
// Left pane: folder tree. Right pane: file list. Navigation bar + action bar.
// HTML layout in config/filedialog.html. PostgreSQL VFS backend.
//
// Copyright 2026 Sean Collins, 2 Paws Machine and Engineering. SCSL.

LibraryImport.Arena
LibraryImport.Auckland
LibraryImport.AppHost
LibraryImport.EventRouter
LibraryImport.WinManager
LibraryImport.WinToolbar
LibraryImport.StringUtils
LibraryImport.Fonts
LibraryImport.TextRegion
LibraryImport.DSurfaceTypes
LibraryImport.DSurface
LibraryImport.DDrawPixel
LibraryImport.UITheme
LibraryImport.UIScale
LibraryImport.HashMap
LibraryImport.HTMLParse
LibraryImport.AucklandBind

// =============================================================================
// CONSTANTS
// =============================================================================
FixedPool.FileDialogConst {
    "MAX_ROWS":      Initialize=64
    "MAX_TREE":      Initialize=64
    "MAX_EXPANDED":  Initialize=16
    "MAX_HISTORY":   Initialize=16
    "MAX_DEPTH":     Initialize=8
    "MAX_VISIBLE":   Initialize=20
    "MODE_OPEN":     Initialize=0
    "MODE_SAVE":     Initialize=1
}

// DJB2 hashes for node id= attributes
FixedPool.FDHash {
    "treepane":     Initialize=7572979818075641
    "filelist":     Initialize=7572371810475137
    "pathbar":      Initialize=229478423619207
    "filename_lbl": Initialize=15117130102298936799
}

// =============================================================================
// STATE
// =============================================================================
FixedPool.FileDialogState {
    "win_idx":         Initialize=-1, CanChange=True
    "current_dir":     Initialize=0,  CanChange=True
    "selected_id":     Initialize=-1, CanChange=True
    "mode":            Initialize=0,  CanChange=True

    // Node indices (found by tree scan after each rebuild)
    "treepane_node":   Initialize=-1, CanChange=True
    "filelist_node":   Initialize=-1, CanChange=True
    "pathbar_label":   Initialize=-1, CanChange=True
    "filename_label":  Initialize=-1, CanChange=True

    // Right pane: file list
    "row_ids":         Initialize=0,  CanChange=True
    "row_count":       Initialize=0,  CanChange=True
    "list_offset":     Initialize=0,  CanChange=True

    // Left pane: tree data (linearized)
    "tree_ids":        Initialize=0,  CanChange=True
    "tree_depths":     Initialize=0,  CanChange=True
    "tree_count":      Initialize=0,  CanChange=True
    "tree_offset":     Initialize=0,  CanChange=True

    // Expand state (persistent across rebuilds)
    "exp_ids":         Initialize=0,  CanChange=True
    "exp_count":       Initialize=0,  CanChange=True

    // Navigation history
    "history":         Initialize=0,  CanChange=True
    "history_count":   Initialize=0,  CanChange=True
    "history_pos":     Initialize=-1, CanChange=True
}


// =============================================================================
// ACTION CALLBACK — pushes fd.* actions to EventRouter
// =============================================================================
Function.FDApp_ActionCb {
    Input: action_ptr: Address
    Input: action_len: Integer
    Output: Integer
    Body: {
        EventRouter_Push(action_ptr, action_len, 0)
        ReturnValue(1)
    }
}


// =============================================================================
// FIND NODE BY ID HASH — scan AK tree for a node with matching ID_HASH
// =============================================================================
Function.FD_FindNodeById {
    Input: ctx: LinkagePool.AKContext
    Input: id_hash: Integer
    Output: Integer
    Body: {
        cnt = ctx@tree_count
        i = 0
        WhileLoop LessThan(i, cnt) {
            h = AK_Get(ctx, i, AKF.ID_HASH)
            IfCondition EqualTo(h, id_hash) ThenBlock: {
                ReturnValue(i)
            }
            i = Add(i, 1)
        }
        ReturnValue(-1)
    }
}


// =============================================================================
// FIND ALL PANE NODES — locate treepane, filelist, pathbar, filename_lbl
// =============================================================================
Function.FD_FindAllNodes {
    Input: ctx: LinkagePool.AKContext
    Body: {
        FileDialogState.treepane_node  = FD_FindNodeById(ctx, FDHash.treepane)
        FileDialogState.filelist_node  = FD_FindNodeById(ctx, FDHash.filelist)
        FileDialogState.pathbar_label  = FD_FindNodeById(ctx, FDHash.pathbar)
        FileDialogState.filename_label = FD_FindNodeById(ctx, FDHash.filename_lbl)

        PrintMessage("[FD] nodes: tree=")
        PrintNumber(FileDialogState.treepane_node)
        PrintMessage(" list=")
        PrintNumber(FileDialogState.filelist_node)
        PrintMessage(" path=")
        PrintNumber(FileDialogState.pathbar_label)
        PrintMessage(" fname=")
        PrintNumber(FileDialogState.filename_label)
        PrintMessage("\n")
    }
}


// =============================================================================
// EXPAND STATE — track which directories are expanded in tree pane
// =============================================================================
Function.FD_IsExpanded {
    Input: dir_id: Integer
    Output: Integer
    Body: {
        cnt = FileDialogState.exp_count
        buf = FileDialogState.exp_ids
        i = 0
        WhileLoop LessThan(i, cnt) {
            v = Dereference(Add(buf, Multiply(i, 8)))
            IfCondition EqualTo(v, dir_id) ThenBlock: {
                ReturnValue(1)
            }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

Function.FD_AddExpanded {
    Input: dir_id: Integer
    Body: {
        cnt = FileDialogState.exp_count
        IfCondition GreaterEqual(cnt, FileDialogConst.MAX_EXPANDED) ThenBlock: { ReturnValue(0) }
        buf = FileDialogState.exp_ids
        StoreValue(Add(buf, Multiply(cnt, 8)), dir_id)
        FileDialogState.exp_count = Add(cnt, 1)
    }
}

Function.FD_RemoveExpanded {
    Input: dir_id: Integer
    Body: {
        cnt = FileDialogState.exp_count
        buf = FileDialogState.exp_ids
        i = 0
        WhileLoop LessThan(i, cnt) {
            v = Dereference(Add(buf, Multiply(i, 8)))
            IfCondition EqualTo(v, dir_id) ThenBlock: {
                // Move last entry into this slot
                last = Subtract(cnt, 1)
                IfCondition NotEqual(i, last) ThenBlock: {
                    last_v = Dereference(Add(buf, Multiply(last, 8)))
                    StoreValue(Add(buf, Multiply(i, 8)), last_v)
                }
                FileDialogState.exp_count = last
                ReturnValue(0)
            }
            i = Add(i, 1)
        }
    }
}

Function.FD_ToggleExpand {
    Input: dir_id: Integer
    Body: {
        is_exp = FD_IsExpanded(dir_id)
        IfCondition EqualTo(is_exp, 1) ThenBlock: {
            FD_RemoveExpanded(dir_id)
        } ElseBlock: {
            FD_AddExpanded(dir_id)
        }
    }
}


// =============================================================================
// HISTORY STACK — for back/forward navigation
// =============================================================================
Function.FD_HistoryPush {
    Input: dir_id: Integer
    Body: {
        pos = FileDialogState.history_pos
        buf = FileDialogState.history
        new_pos = Add(pos, 1)
        IfCondition GreaterEqual(new_pos, FileDialogConst.MAX_HISTORY) ThenBlock: { ReturnValue(0) }
        StoreValue(Add(buf, Multiply(new_pos, 8)), dir_id)
        FileDialogState.history_pos = new_pos
        // Truncate forward history
        FileDialogState.history_count = Add(new_pos, 1)
    }
}


// =============================================================================
// BUILD TREE DATA — recursive linearization of folder hierarchy
// =============================================================================
Function.FD_BuildTreeData {
    Input: parent_id: Integer
    Input: depth: Integer
    Body: {
        IfCondition GreaterEqual(depth, FileDialogConst.MAX_DEPTH) ThenBlock: { ReturnValue(0) }

        conn = SysDisplay_GetDBConn()
        IfCondition EqualTo(conn, 0) ThenBlock: { ReturnValue(0) }

        // Query subdirectories
        r = 0
        IfCondition EqualTo(parent_id, 0) ThenBlock: {
            r = PG_Query(conn, "SELECT id, name FROM files WHERE parent_id IS NULL AND type = 'dir' ORDER BY name")
        } ElseBlock: {
            q1 = "SELECT id, name FROM files WHERE parent_id = "
            id_str = NumberToString(parent_id)
            q2 = StringConcat(q1, id_str)
            q3 = StringConcat(q2, " AND type = 'dir' ORDER BY name")
            r = PG_Query(conn, q3)
        }

        IfCondition EqualTo(r, 0) ThenBlock: { ReturnValue(0) }

        rc = XArray.XSize(r)
        ri = 0
        WhileLoop LessThan(ri, rc) {
            tc = FileDialogState.tree_count
            IfCondition GreaterEqual(tc, FileDialogConst.MAX_TREE) ThenBlock: {
                PG_DestroyResult(r)
                ReturnValue(0)
            }

            row = XArray.XGet(r, ri)
            v_id   = HashMap.HGetSimple(row, "id")
            v_name = HashMap.HGetSimple(row, "name")
            dir_id = StringToNumber(v_id)

            // Store in tree arrays
            ids_buf = FileDialogState.tree_ids
            dep_buf = FileDialogState.tree_depths
            StoreValue(Add(ids_buf, Multiply(tc, 8)), dir_id)
            StoreValue(Add(dep_buf, Multiply(tc, 8)), depth)
            FileDialogState.tree_count = Add(tc, 1)

            // Recurse into expanded directories
            is_exp = FD_IsExpanded(dir_id)
            IfCondition EqualTo(is_exp, 1) ThenBlock: {
                FD_BuildTreeData(dir_id, Add(depth, 1))
            }

            ri = Add(ri, 1)
        }

        PG_DestroyResult(r)
    }
}


// =============================================================================
// BUILD INDENT STRING — creates "  v dirname" or "  > dirname"
// =============================================================================
Function.FD_BuildTreeLabel {
    Input: name: Address
    Input: depth: Integer
    Input: is_expanded: Integer
    Output: Address
    Body: {
        // Build indent: depth * 2 spaces
        indent_len = Multiply(depth, 2)
        name_len = StringLength(name)
        // Format: <indent><indicator> <name>
        // indicator is "v " or "> " = 2 chars
        total = Add(Add(indent_len, 2), name_len)

        buf = Allocate(Add(total, 1))
        pos = 0

        // Write indent spaces
        si = 0
        WhileLoop LessThan(si, indent_len) {
            SetByte(buf, pos, 32)
            pos = Add(pos, 1)
            si = Add(si, 1)
        }

        // Write indicator
        IfCondition EqualTo(is_expanded, 1) ThenBlock: {
            SetByte(buf, pos, 118)
            pos = Add(pos, 1)
        } ElseBlock: {
            SetByte(buf, pos, 62)
            pos = Add(pos, 1)
        }
        SetByte(buf, pos, 32)
        pos = Add(pos, 1)

        // Copy name
        ni = 0
        WhileLoop LessThan(ni, name_len) {
            ch = GetByte(name, ni)
            SetByte(buf, pos, ch)
            pos = Add(pos, 1)
            ni = Add(ni, 1)
        }

        SetByte(buf, pos, 0)
        ReturnValue(buf)
    }
}


// =============================================================================
// POPULATE TREE PANE — create BUTTON nodes from linearized tree data
// =============================================================================
Function.FD_PopulateTreePane {
    Input: ctx: LinkagePool.AKContext
    Body: {
        tp = FileDialogState.treepane_node
        IfCondition LessThan(tp, 0) ThenBlock: { ReturnValue(0) }

        conn = SysDisplay_GetDBConn()
        IfCondition EqualTo(conn, 0) ThenBlock: { ReturnValue(0) }

        rh = Add(UIScale.font_body, Divide(UIScale.font_body, 3))
        IfCondition LessThan(rh, Add(UIScale.font_body, 2)) ThenBlock: { rh = Add(UIScale.font_body, 2) }

        // Add scroll-up button if offset > 0
        off = FileDialogState.tree_offset
        IfCondition GreaterThan(off, 0) ThenBlock: {
            up_btn = AK_CreateNode(ctx, AKTag.BUTTON)
            AK_Set(ctx, up_btn, AKF.HEIGHT, rh)
            AK_ExtraSet(ctx, up_btn, AKExtra.STR_PTR, "  ^ ^ ^")
            AK_ExtraSet(ctx, up_btn, AKExtra.STR_LEN, 7)
            AK_ExtraSet(ctx, up_btn, AKExtra.TEXT_ALIGN, TRAlign.CENTER)
            AK_ExtraSet(ctx, up_btn, AKExtra.ACTION_PTR, "fd.tup")
            AK_ExtraSet(ctx, up_btn, AKExtra.ACTION_LEN, 6)
            AK_ExtraSet(ctx, up_btn, AKExtra.COLOR_FG, Theme.fd_file_text)
            AK_AddChild(ctx, tp, up_btn)
        }

        // Visible items
        tc = FileDialogState.tree_count
        cur_dir = FileDialogState.current_dir
        visible = 0
        max_vis = FileDialogConst.MAX_VISIBLE
        i = off

        WhileLoop And(LessThan(i, tc), LessThan(visible, max_vis)) {
            ids_buf = FileDialogState.tree_ids
            dep_buf = FileDialogState.tree_depths
            dir_id = Dereference(Add(ids_buf, Multiply(i, 8)))
            depth  = Dereference(Add(dep_buf, Multiply(i, 8)))
            is_exp = FD_IsExpanded(dir_id)

            // Query name for this directory
            q1 = "SELECT name FROM files WHERE id = "
            id_str = NumberToString(dir_id)
            q2 = StringConcat(q1, id_str)
            nr = PG_Query(conn, q2)
            dir_name = "???"
            IfCondition NotEqual(nr, 0) ThenBlock: {
                nrc = XArray.XSize(nr)
                IfCondition GreaterThan(nrc, 0) ThenBlock: {
                    nrow = XArray.XGet(nr, 0)
                    nv = HashMap.HGetSimple(nrow, "name")
                    IfCondition NotEqual(nv, 0) ThenBlock: { dir_name = nv }
                }
                PG_DestroyResult(nr)
            }

            label = FD_BuildTreeLabel(dir_name, depth, is_exp)
            label_len = StringLength(label)

            // Build action string "fd.tree:N"
            action_str = StringConcat("fd.tree:", id_str)
            action_len = StringLength(action_str)

            row_node = AK_CreateNode(ctx, AKTag.BUTTON)
            AK_Set(ctx, row_node, AKF.HEIGHT, rh)
            AK_ExtraSet(ctx, row_node, AKExtra.STR_PTR, label)
            AK_ExtraSet(ctx, row_node, AKExtra.STR_LEN, label_len)
            AK_ExtraSet(ctx, row_node, AKExtra.TEXT_ALIGN, TRAlign.LEFT)
            AK_ExtraSet(ctx, row_node, AKExtra.ACTION_PTR, action_str)
            AK_ExtraSet(ctx, row_node, AKExtra.ACTION_LEN, action_len)

            // Highlight current directory
            IfCondition EqualTo(dir_id, cur_dir) ThenBlock: {
                AK_ExtraSet(ctx, row_node, AKExtra.COLOR_BG, 0xFF2A2A50)
                AK_ExtraSet(ctx, row_node, AKExtra.COLOR_FG, 0xFFFFFFFF)
            } ElseBlock: {
                AK_ExtraSet(ctx, row_node, AKExtra.COLOR_FG, Theme.fd_dir_text)
            }

            AK_AddChild(ctx, tp, row_node)
            visible = Add(visible, 1)
            i = Add(i, 1)
        }

        // Add scroll-down button if more items below
        IfCondition LessThan(i, tc) ThenBlock: {
            dn_btn = AK_CreateNode(ctx, AKTag.BUTTON)
            AK_Set(ctx, dn_btn, AKF.HEIGHT, rh)
            AK_ExtraSet(ctx, dn_btn, AKExtra.STR_PTR, "  v v v")
            AK_ExtraSet(ctx, dn_btn, AKExtra.STR_LEN, 7)
            AK_ExtraSet(ctx, dn_btn, AKExtra.TEXT_ALIGN, TRAlign.CENTER)
            AK_ExtraSet(ctx, dn_btn, AKExtra.ACTION_PTR, "fd.tdn")
            AK_ExtraSet(ctx, dn_btn, AKExtra.ACTION_LEN, 6)
            AK_ExtraSet(ctx, dn_btn, AKExtra.COLOR_FG, Theme.fd_file_text)
            AK_AddChild(ctx, tp, dn_btn)
        }

        // Show root "/" entry if tree is empty (no subdirs)
        IfCondition EqualTo(tc, 0) ThenBlock: {
            root_btn = AK_CreateNode(ctx, AKTag.BUTTON)
            AK_Set(ctx, root_btn, AKF.HEIGHT, rh)
            AK_ExtraSet(ctx, root_btn, AKExtra.STR_PTR, "v /")
            AK_ExtraSet(ctx, root_btn, AKExtra.STR_LEN, 3)
            AK_ExtraSet(ctx, root_btn, AKExtra.TEXT_ALIGN, TRAlign.LEFT)
            AK_ExtraSet(ctx, root_btn, AKExtra.ACTION_PTR, "fd.tree:0")
            AK_ExtraSet(ctx, root_btn, AKExtra.ACTION_LEN, 9)
            AK_ExtraSet(ctx, root_btn, AKExtra.COLOR_FG, Theme.fd_dir_text)
            AK_AddChild(ctx, tp, root_btn)
        }

        PrintMessage("[FD] tree: ")
        PrintNumber(tc)
        PrintMessage(" entries, vis=")
        PrintNumber(visible)
        PrintMessage("\n")
    }
}


// =============================================================================
// POPULATE FILES — query DB, add rows to file list panel
// =============================================================================
Function.FD_PopulateFiles {
    Input: parent_id: Integer
    Body: {
        DebugLog_Push("fd.pop", 6)
        conn = SysDisplay_GetDBConn()
        IfCondition EqualTo(conn, 0) ThenBlock: { ReturnValue(0) }

        FileDialogState.current_dir = parent_id
        FileDialogState.row_count = 0

        rh = Add(UIScale.font_body, Divide(UIScale.font_body, 3))
        IfCondition LessThan(rh, Add(UIScale.font_body, 2)) ThenBlock: { rh = Add(UIScale.font_body, 2) }

        // Query DB
        r = 0
        IfCondition EqualTo(parent_id, 0) ThenBlock: {
            r = PG_Query(conn, "SELECT id, name, type, size FROM files WHERE parent_id IS NULL ORDER BY type DESC, name")
        } ElseBlock: {
            q1 = "SELECT id, name, type, size FROM files WHERE parent_id = "
            id_str = NumberToString(parent_id)
            q2 = StringConcat(q1, id_str)
            q3 = StringConcat(q2, " ORDER BY type DESC, name")
            r = PG_Query(conn, q3)
        }

        IfCondition EqualTo(r, 0) ThenBlock: {
            PrintMessage("[FD] query failed\n")
            ReturnValue(0)
        }

        rc = XArray.XSize(r)

        win_idx = FileDialogState.win_idx
        ctx = WinView_GetContentCtx(win_idx)
        fl = FileDialogState.filelist_node
        IfCondition LessThan(fl, 0) ThenBlock: {
            PG_DestroyResult(r)
            ReturnValue(0)
        }

        off = FileDialogState.list_offset
        max_vis = FileDialogConst.MAX_VISIBLE

        // Add scroll-up button if offset > 0
        IfCondition GreaterThan(off, 0) ThenBlock: {
            up_btn = AK_CreateNode(ctx, AKTag.BUTTON)
            AK_Set(ctx, up_btn, AKF.HEIGHT, rh)
            AK_ExtraSet(ctx, up_btn, AKExtra.STR_PTR, "  ^ ^ ^")
            AK_ExtraSet(ctx, up_btn, AKExtra.STR_LEN, 7)
            AK_ExtraSet(ctx, up_btn, AKExtra.TEXT_ALIGN, TRAlign.CENTER)
            AK_ExtraSet(ctx, up_btn, AKExtra.ACTION_PTR, "fd.lup")
            AK_ExtraSet(ctx, up_btn, AKExtra.ACTION_LEN, 6)
            AK_ExtraSet(ctx, up_btn, AKExtra.COLOR_FG, Theme.fd_file_text)
            AK_AddChild(ctx, fl, up_btn)
        }

        visible = 0
        ri = off
        WhileLoop And(LessThan(ri, rc), LessThan(visible, max_vis)) {
            row = XArray.XGet(r, ri)
            v_id   = HashMap.HGetSimple(row, "id")
            v_name = HashMap.HGetSimple(row, "name")
            v_type = HashMap.HGetSimple(row, "type")

            is_dir = 0
            IfCondition NotEqual(v_type, 0) ThenBlock: {
                cmp = StringCompare(v_type, "dir")
                IfCondition EqualTo(cmp, 0) ThenBlock: { is_dir = 1 }
            }

            // Build display text with type prefix
            display = v_name
            display_len = StringLength(v_name)
            IfCondition EqualTo(is_dir, 1) ThenBlock: {
                display = StringConcat("[D] ", v_name)
                display_len = Add(display_len, 4)
            } ElseBlock: {
                display = StringConcat("    ", v_name)
                display_len = Add(display_len, 4)
            }

            action_prefix = "fd.select:"
            IfCondition EqualTo(is_dir, 1) ThenBlock: {
                action_prefix = "fd.nav:"
            }
            action_str = StringConcat(action_prefix, v_id)
            action_len = StringLength(action_str)

            file_id = StringToNumber(v_id)
            StoreValue(Add(FileDialogState.row_ids, Multiply(visible, 8)), file_id)

            row_node = AK_CreateNode(ctx, AKTag.BUTTON)
            AK_Set(ctx, row_node, AKF.HEIGHT, rh)
            AK_ExtraSet(ctx, row_node, AKExtra.STR_PTR, display)
            AK_ExtraSet(ctx, row_node, AKExtra.STR_LEN, display_len)
            AK_ExtraSet(ctx, row_node, AKExtra.TEXT_ALIGN, TRAlign.LEFT)
            AK_ExtraSet(ctx, row_node, AKExtra.ACTION_PTR, action_str)
            AK_ExtraSet(ctx, row_node, AKExtra.ACTION_LEN, action_len)

            IfCondition EqualTo(is_dir, 1) ThenBlock: {
                AK_ExtraSet(ctx, row_node, AKExtra.COLOR_FG, Theme.fd_dir_text)
            } ElseBlock: {
                AK_ExtraSet(ctx, row_node, AKExtra.COLOR_FG, Theme.fd_file_text)
            }

            // Highlight selected file
            IfCondition EqualTo(file_id, FileDialogState.selected_id) ThenBlock: {
                AK_ExtraSet(ctx, row_node, AKExtra.COLOR_BG, 0xFF2A2A50)
            }

            AK_AddChild(ctx, fl, row_node)
            FileDialogState.row_count = Add(visible, 1)
            visible = Add(visible, 1)
            ri = Add(ri, 1)
        }

        // Add scroll-down button if more items below
        IfCondition LessThan(ri, rc) ThenBlock: {
            dn_btn = AK_CreateNode(ctx, AKTag.BUTTON)
            AK_Set(ctx, dn_btn, AKF.HEIGHT, rh)
            AK_ExtraSet(ctx, dn_btn, AKExtra.STR_PTR, "  v v v")
            AK_ExtraSet(ctx, dn_btn, AKExtra.STR_LEN, 7)
            AK_ExtraSet(ctx, dn_btn, AKExtra.TEXT_ALIGN, TRAlign.CENTER)
            AK_ExtraSet(ctx, dn_btn, AKExtra.ACTION_PTR, "fd.ldn")
            AK_ExtraSet(ctx, dn_btn, AKExtra.ACTION_LEN, 6)
            AK_ExtraSet(ctx, dn_btn, AKExtra.COLOR_FG, Theme.fd_file_text)
            AK_AddChild(ctx, fl, dn_btn)
        }

        IfCondition EqualTo(FileDialogState.row_count, 0) ThenBlock: {
            empty_lbl = AK_CreateNode(ctx, AKTag.LABEL)
            AK_Set(ctx, empty_lbl, AKF.HEIGHT, rh)
            AK_ExtraSet(ctx, empty_lbl, AKExtra.STR_PTR, "(empty)")
            AK_ExtraSet(ctx, empty_lbl, AKExtra.STR_LEN, 7)
            AK_ExtraSet(ctx, empty_lbl, AKExtra.COLOR_FG, Theme.fd_empty_text)
            AK_ExtraSet(ctx, empty_lbl, AKExtra.TEXT_ALIGN, TRAlign.CENTER)
            AK_AddChild(ctx, fl, empty_lbl)
        }

        PG_DestroyResult(r)

        PrintMessage("[FD] files: ")
        PrintNumber(FileDialogState.row_count)
        PrintMessage(" entries\n")
    }
}


// =============================================================================
// UPDATE PATH LABEL — build breadcrumb by walking parent chain
// =============================================================================
Function.FD_UpdatePathLabel {
    Input: dir_id: Integer
    Body: {
        lbl = FileDialogState.pathbar_label
        IfCondition LessThan(lbl, 0) ThenBlock: { ReturnValue(0) }

        win_idx = FileDialogState.win_idx
        IfCondition LessThan(win_idx, 0) ThenBlock: { ReturnValue(0) }

        ctx = WinView_GetContentCtx(win_idx)

        IfCondition EqualTo(dir_id, 0) ThenBlock: {
            AK_ExtraSet(ctx, lbl, AKExtra.STR_PTR, "/")
            AK_ExtraSet(ctx, lbl, AKExtra.STR_LEN, 1)
            ReturnValue(0)
        }

        // Walk parent chain to build path (up to MAX_DEPTH levels)
        conn = SysDisplay_GetDBConn()
        IfCondition EqualTo(conn, 0) ThenBlock: { ReturnValue(0) }

        path_str = ""
        cur = dir_id
        depth = 0
        WhileLoop And(GreaterThan(cur, 0), LessThan(depth, FileDialogConst.MAX_DEPTH)) {
            q1 = "SELECT parent_id, name FROM files WHERE id = "
            id_str = NumberToString(cur)
            q2 = StringConcat(q1, id_str)
            r = PG_Query(conn, q2)

            IfCondition EqualTo(r, 0) ThenBlock: { cur = 0 }
            IfCondition NotEqual(r, 0) ThenBlock: {
                rc = XArray.XSize(r)
                IfCondition EqualTo(rc, 0) ThenBlock: {
                    PG_DestroyResult(r)
                    cur = 0
                }
                IfCondition GreaterThan(rc, 0) ThenBlock: {
                    row = XArray.XGet(r, 0)
                    v_name = HashMap.HGetSimple(row, "name")
                    v_pid  = HashMap.HGetSimple(row, "parent_id")

                    segment = StringConcat("/", v_name)
                    path_str = StringConcat(segment, path_str)

                    IfCondition NotEqual(v_pid, 0) ThenBlock: {
                        cur = StringToNumber(v_pid)
                    } ElseBlock: {
                        cur = 0
                    }
                    PG_DestroyResult(r)
                }
            }
            depth = Add(depth, 1)
        }

        // Ensure starts with /
        IfCondition EqualTo(StringLength(path_str), 0) ThenBlock: {
            path_str = "/"
        }

        AK_ExtraSet(ctx, lbl, AKExtra.STR_PTR, path_str)
        AK_ExtraSet(ctx, lbl, AKExtra.STR_LEN, StringLength(path_str))
    }
}


// =============================================================================
// UPDATE FILENAME LABEL — show selected file name in action bar
// =============================================================================
Function.FD_UpdateFilenameLabel {
    Input: file_id: Integer
    Body: {
        lbl = FileDialogState.filename_label
        IfCondition LessThan(lbl, 0) ThenBlock: { ReturnValue(0) }

        win_idx = FileDialogState.win_idx
        ctx = WinView_GetContentCtx(win_idx)

        conn = SysDisplay_GetDBConn()
        IfCondition EqualTo(conn, 0) ThenBlock: { ReturnValue(0) }

        q1 = "SELECT name FROM files WHERE id = "
        id_str = NumberToString(file_id)
        q2 = StringConcat(q1, id_str)
        r = PG_Query(conn, q2)

        name_str = ""
        IfCondition NotEqual(r, 0) ThenBlock: {
            rc = XArray.XSize(r)
            IfCondition GreaterThan(rc, 0) ThenBlock: {
                row = XArray.XGet(r, 0)
                v = HashMap.HGetSimple(row, "name")
                IfCondition NotEqual(v, 0) ThenBlock: { name_str = v }
            }
            PG_DestroyResult(r)
        }

        AK_ExtraSet(ctx, lbl, AKExtra.STR_PTR, name_str)
        AK_ExtraSet(ctx, lbl, AKExtra.STR_LEN, StringLength(name_str))
    }
}


// =============================================================================
// FULL REBUILD — reset context, re-parse HTML, repopulate both panes
// =============================================================================
Function.FD_FullRebuild {
    Body: {
        DebugLog_Push("fd.rbld", 7)
        win_idx = FileDialogState.win_idx
        IfCondition LessThan(win_idx, 0) ThenBlock: { ReturnValue(0) }

        ctx = WinView_GetContentCtx(win_idx)
        IfCondition EqualTo(ctx, 0) ThenBlock: { ReturnValue(0) }

        // Reset context (zeros buffers, frees TextRegions)
        AK_ResetContext(ctx)

        // Re-parse HTML
        HTML_Reset()
        root = AKParse_File(ctx, "config/filedialog.html")
        IfCondition LessThan(root, 0) ThenBlock: {
            PrintMessage("[FD] rebuild parse failed\n")
            ReturnValue(0)
        }

        // Restore action callback
        AK_SetActionCb(ctx, AddressOf(FDApp_ActionCb))

        // Find pane nodes by id hash
        FD_FindAllNodes(ctx)

        // Build tree data
        FileDialogState.tree_count = 0
        FD_BuildTreeData(0, 0)

        // Populate tree pane
        FD_PopulateTreePane(ctx)

        // Populate file list
        FD_PopulateFiles(FileDialogState.current_dir)

        // Update path label
        FD_UpdatePathLabel(FileDialogState.current_dir)

        // Render
        content = WinMgr_GetContent(win_idx)
        cw = Win_GetCanvasW(win_idx)
        ch = Win_GetCanvasH(win_idx)
        AK_SetDesignW(ctx, cw)
        AK_SetDesignH(ctx, ch)
        VFont_UseSize(UIScale.font_body)
        AK_Draw(ctx, content, cw, ch)
        SysDisplayState.dirty = 1
    }
}


// =============================================================================
// NAVIGATE — go to a directory
// =============================================================================
Function.FD_Navigate {
    Input: dir_id: Integer
    Body: {
        DebugLog_Push("fd.nav", 6)
        win_idx = FileDialogState.win_idx
        IfCondition LessThan(win_idx, 0) ThenBlock: { ReturnValue(0) }

        PrintMessage("[FD] nav dir=")
        PrintNumber(dir_id)
        PrintMessage("\n")

        // Push current dir to history before navigating
        FD_HistoryPush(FileDialogState.current_dir)

        FileDialogState.current_dir = dir_id
        FileDialogState.selected_id = -1
        FileDialogState.list_offset = 0

        FD_FullRebuild()
    }
}


// =============================================================================
// TREE SELECT — click on tree entry: navigate + toggle expand
// =============================================================================
Function.FD_TreeSelect {
    Input: dir_id: Integer
    Body: {
        DebugLog_Push("fd.tsel", 7)
        PrintMessage("[FD] tree select=")
        PrintNumber(dir_id)
        PrintMessage("\n")

        // Toggle expand state
        FD_ToggleExpand(dir_id)

        // Navigate to this directory
        FD_HistoryPush(FileDialogState.current_dir)
        FileDialogState.current_dir = dir_id
        FileDialogState.selected_id = -1
        FileDialogState.list_offset = 0

        FD_FullRebuild()
    }
}


// =============================================================================
// BACK — go back in history
// =============================================================================
Function.FD_Back {
    Body: {
        DebugLog_Push("fd.back", 7)
        pos = FileDialogState.history_pos
        IfCondition LessThan(pos, 0) ThenBlock: {
            // No history — try parent directory
            cur = FileDialogState.current_dir
            IfCondition EqualTo(cur, 0) ThenBlock: { ReturnValue(0) }

            conn = SysDisplay_GetDBConn()
            IfCondition EqualTo(conn, 0) ThenBlock: { ReturnValue(0) }

            q1 = "SELECT parent_id FROM files WHERE id = "
            id_str = NumberToString(cur)
            q2 = StringConcat(q1, id_str)
            r = PG_Query(conn, q2)

            parent_id = 0
            IfCondition NotEqual(r, 0) ThenBlock: {
                rc = XArray.XSize(r)
                IfCondition GreaterThan(rc, 0) ThenBlock: {
                    row = XArray.XGet(r, 0)
                    v = HashMap.HGetSimple(row, "parent_id")
                    IfCondition NotEqual(v, 0) ThenBlock: {
                        parent_id = StringToNumber(v)
                    }
                }
                PG_DestroyResult(r)
            }

            FileDialogState.current_dir = parent_id
            FileDialogState.selected_id = -1
            FileDialogState.list_offset = 0
            FD_FullRebuild()
            ReturnValue(0)
        }

        // Go back in history
        buf = FileDialogState.history
        dir_id = Dereference(Add(buf, Multiply(pos, 8)))
        FileDialogState.history_pos = Subtract(pos, 1)

        FileDialogState.current_dir = dir_id
        FileDialogState.selected_id = -1
        FileDialogState.list_offset = 0
        FD_FullRebuild()
    }
}


// =============================================================================
// FORWARD — go forward in history
// =============================================================================
Function.FD_Forward {
    Body: {
        DebugLog_Push("fd.fwd", 6)
        pos = FileDialogState.history_pos
        cnt = FileDialogState.history_count
        next_pos = Add(pos, 2)
        IfCondition GreaterEqual(next_pos, cnt) ThenBlock: {
            PrintMessage("[FD] no forward history\n")
            ReturnValue(0)
        }

        buf = FileDialogState.history
        // Forward entry is at pos+2 (pos+1 is where we pushed, pos+2 is the next nav)
        // Actually: history tracks where we came FROM. Forward means go to pos+1 + 1
        // Simpler: just go to current_dir from the entry after current pos
        fwd_idx = Add(pos, 1)
        IfCondition GreaterEqual(fwd_idx, cnt) ThenBlock: { ReturnValue(0) }

        // The entry at fwd_idx+1 was the destination of the next forward nav
        // But we stored the FROM directory, not the TO directory...
        // Let's just report not implemented for now
        PrintMessage("[FD] forward not yet implemented\n")
        ReturnValue(0)
    }
}


// =============================================================================
// SELECT — mark a file as selected
// =============================================================================
Function.FD_Select {
    Input: file_id: Integer
    Body: {
        DebugLog_Push("fd.sel", 6)
        FileDialogState.selected_id = file_id
        FD_UpdateFilenameLabel(file_id)
        PrintMessage("[FD] selected=")
        PrintNumber(file_id)
        PrintMessage("\n")
        // Rebuild to show selection highlight
        FD_FullRebuild()
    }
}


// =============================================================================
// OK — confirm selection
// =============================================================================
Function.FD_Ok {
    Body: {
        DebugLog_Push("fd.ok", 5)
        sel = FileDialogState.selected_id
        IfCondition LessThan(sel, 0) ThenBlock: {
            PrintMessage("[FD] nothing selected\n")
            ReturnValue(0)
        }
        PrintMessage("[FD] confirmed=")
        PrintNumber(sel)
        PrintMessage("\n")
        FD_CloseDialog()
    }
}


// =============================================================================
// CANCEL
// =============================================================================
Function.FD_Cancel {
    Body: {
        DebugLog_Push("fd.canc", 7)
        PrintMessage("[FD] cancelled\n")
        FD_CloseDialog()
    }
}


// =============================================================================
// CLOSE — cleanup and close window
// =============================================================================
Function.FD_CloseDialog {
    Body: {
        DebugLog_Push("fd.cls", 6)
        IfCondition GreaterEqual(FileDialogState.win_idx, 0) ThenBlock: {
            AppHost_Close(FileDialogState.win_idx)
        }
        FileDialogState.win_idx        = -1
        FileDialogState.treepane_node  = -1
        FileDialogState.filelist_node  = -1
        FileDialogState.pathbar_label  = -1
        FileDialogState.filename_label = -1
        FileDialogState.selected_id    = -1
        FileDialogState.current_dir    = 0
        FileDialogState.row_count      = 0
        FileDialogState.list_offset    = 0
        FileDialogState.tree_count     = 0
        FileDialogState.tree_offset    = 0
        FileDialogState.exp_count      = 0
        FileDialogState.history_count  = 0
        FileDialogState.history_pos    = -1
        DeskbarState.needs_refresh     = 1
    }
}


// =============================================================================
// SCROLL HANDLERS
// =============================================================================
Function.FD_TreeScrollUp {
    Body: {
        off = FileDialogState.tree_offset
        IfCondition GreaterThan(off, 0) ThenBlock: {
            FileDialogState.tree_offset = Subtract(off, FileDialogConst.MAX_VISIBLE)
            IfCondition LessThan(FileDialogState.tree_offset, 0) ThenBlock: {
                FileDialogState.tree_offset = 0
            }
            FD_FullRebuild()
        }
    }
}

Function.FD_TreeScrollDown {
    Body: {
        off = FileDialogState.tree_offset
        tc = FileDialogState.tree_count
        new_off = Add(off, FileDialogConst.MAX_VISIBLE)
        IfCondition LessThan(new_off, tc) ThenBlock: {
            FileDialogState.tree_offset = new_off
            FD_FullRebuild()
        }
    }
}

Function.FD_ListScrollUp {
    Body: {
        off = FileDialogState.list_offset
        IfCondition GreaterThan(off, 0) ThenBlock: {
            FileDialogState.list_offset = Subtract(off, FileDialogConst.MAX_VISIBLE)
            IfCondition LessThan(FileDialogState.list_offset, 0) ThenBlock: {
                FileDialogState.list_offset = 0
            }
            FD_FullRebuild()
        }
    }
}

Function.FD_ListScrollDown {
    Body: {
        off = FileDialogState.list_offset
        // We need the total count from DB, but row_count is capped. Use a rebuild.
        new_off = Add(off, FileDialogConst.MAX_VISIBLE)
        FileDialogState.list_offset = new_off
        FD_FullRebuild()
    }
}


// =============================================================================
// OPEN — initialize and show dialog
// =============================================================================
Function.FileDialog_Open {
    Input: mode: Integer
    Input: start_dir: Integer
    Input: font_size: Integer
    Output: Integer
    Body: {
        DebugLog_Push("fd.open", 7)
        IfCondition GreaterEqual(FileDialogState.win_idx, 0) ThenBlock: {
            PrintMessage("[FD] already open\n")
            ReturnValue(FileDialogState.win_idx)
        }

        FileDialogState.mode = mode
        FileDialogState.current_dir = start_dir
        FileDialogState.selected_id = -1
        FileDialogState.row_count = 0
        FileDialogState.list_offset = 0
        FileDialogState.tree_count = 0
        FileDialogState.tree_offset = 0
        FileDialogState.history_count = 0
        FileDialogState.history_pos = -1

        // Allocate arrays if needed
        IfCondition EqualTo(FileDialogState.row_ids, 0) ThenBlock: {
            FileDialogState.row_ids = Allocate(Multiply(FileDialogConst.MAX_ROWS, 8))
        }
        IfCondition EqualTo(FileDialogState.tree_ids, 0) ThenBlock: {
            FileDialogState.tree_ids = Allocate(Multiply(FileDialogConst.MAX_TREE, 8))
        }
        IfCondition EqualTo(FileDialogState.tree_depths, 0) ThenBlock: {
            FileDialogState.tree_depths = Allocate(Multiply(FileDialogConst.MAX_TREE, 8))
        }
        IfCondition EqualTo(FileDialogState.exp_ids, 0) ThenBlock: {
            FileDialogState.exp_ids = Allocate(Multiply(FileDialogConst.MAX_EXPANDED, 8))
        }
        IfCondition EqualTo(FileDialogState.history, 0) ThenBlock: {
            FileDialogState.history = Allocate(Multiply(FileDialogConst.MAX_HISTORY, 8))
        }

        // Expand root by default so tree shows top-level dirs
        FileDialogState.exp_count = 0
        // Query root dir id (parent_id IS NULL) and expand it
        fd_conn = SysDisplay_GetDBConn()
        IfCondition NotEqual(fd_conn, 0) ThenBlock: {
            fd_rr = PG_Query(fd_conn, "SELECT id FROM files WHERE parent_id IS NULL AND type = 'dir' LIMIT 1")
            IfCondition NotEqual(fd_rr, 0) ThenBlock: {
                fd_rrc = XArray.XSize(fd_rr)
                IfCondition GreaterThan(fd_rrc, 0) ThenBlock: {
                    fd_rrow = XArray.XGet(fd_rr, 0)
                    fd_rid_str = HashMap.HGetSimple(fd_rrow, "id")
                    IfCondition NotEqual(fd_rid_str, 0) ThenBlock: {
                        fd_root_id = StringToNumber(fd_rid_str)
                        FD_AddExpanded(fd_root_id)
                    }
                }
                PG_DestroyResult(fd_rr)
            }
        }

        // Open window from HTML
        win_idx = AppHost_Open("config/filedialog.html", AddressOf(FDApp_ActionCb))
        IfCondition LessEqual(win_idx, 0) ThenBlock: {
            PrintMessage("[FD] AppHost_Open fail\n")
            ReturnValue(-1)
        }
        FileDialogState.win_idx = win_idx

        // Find nodes by id hash
        ctx = WinView_GetContentCtx(win_idx)
        FD_FindAllNodes(ctx)

        // Build tree data (root level expanded by default)
        FD_BuildTreeData(0, 0)

        // Populate tree pane
        FD_PopulateTreePane(ctx)

        // Populate file list
        FD_PopulateFiles(start_dir)

        // Update path label
        FD_UpdatePathLabel(start_dir)

        // Render
        content = WinMgr_GetContent(win_idx)
        cw = Win_GetCanvasW(win_idx)
        ch = Win_GetCanvasH(win_idx)
        AK_SetDesignW(ctx, cw)
        AK_SetDesignH(ctx, ch)
        VFont_UseSize(UIScale.font_body)
        AK_Draw(ctx, content, cw, ch)
        SysDisplayState.dirty = 1

        DeskbarState.needs_refresh = 1

        PrintMessage("[FD] opened win=")
        PrintNumber(win_idx)
        PrintMessage("\n")
        ReturnValue(win_idx)
    }
}


// =============================================================================
// TEST HELPER — find Cancel button node in AK tree
// =============================================================================
Function.FD_FindCancelButton {
    Input: ctx: LinkagePool.AKContext
    Output: Integer
    Body: {
        tc = ctx@tree_count
        i = 0
        WhileLoop LessThan(i, tc) {
            tag = AK_Get(ctx, i, AKF.TAG)
            IfCondition EqualTo(tag, AKTag.BUTTON) ThenBlock: {
                ext = AK_Get(ctx, i, AKF.EXTRA)
                IfCondition GreaterEqual(ext, 0) ThenBlock: {
                    ap = AK_ExtraGet(ctx, i, AKExtra.ACTION_PTR)
                    IfCondition NotEqual(ap, 0) ThenBlock: {
                        cmp = StringCompare(ap, "fd.cancel")
                        IfCondition EqualTo(cmp, 0) ThenBlock: {
                            ReturnValue(i)
                        }
                    }
                }
            }
            i = Add(i, 1)
        }
        ReturnValue(-1)
    }
}

// =============================================================================
// ACTION HANDLER — called from EventRouter_Internal
// =============================================================================
Function.FD_HandleAction {
    Input: action_ptr: Address
    Input: action_len: Integer
    Output: Integer
    Body: {
        DebugLog_Push("fd.hand", 7)

        // fd.back
        cmp = StringCompare(action_ptr, "fd.back")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            FD_Back()
            ReturnValue(1)
        }

        // fd.fwd
        cmp2 = StringCompare(action_ptr, "fd.fwd")
        IfCondition EqualTo(cmp2, 0) ThenBlock: {
            FD_Forward()
            ReturnValue(1)
        }

        // fd.cancel
        cmp3 = StringCompare(action_ptr, "fd.cancel")
        IfCondition EqualTo(cmp3, 0) ThenBlock: {
            FD_Cancel()
            ReturnValue(1)
        }

        // fd.ok
        cmp4 = StringCompare(action_ptr, "fd.ok")
        IfCondition EqualTo(cmp4, 0) ThenBlock: {
            FD_Ok()
            ReturnValue(1)
        }

        // fd.tup / fd.tdn — tree scroll
        cmp5 = StringCompare(action_ptr, "fd.tup")
        IfCondition EqualTo(cmp5, 0) ThenBlock: {
            FD_TreeScrollUp()
            ReturnValue(1)
        }
        cmp6 = StringCompare(action_ptr, "fd.tdn")
        IfCondition EqualTo(cmp6, 0) ThenBlock: {
            FD_TreeScrollDown()
            ReturnValue(1)
        }

        // fd.lup / fd.ldn — list scroll
        cmp7 = StringCompare(action_ptr, "fd.lup")
        IfCondition EqualTo(cmp7, 0) ThenBlock: {
            FD_ListScrollUp()
            ReturnValue(1)
        }
        cmp8 = StringCompare(action_ptr, "fd.ldn")
        IfCondition EqualTo(cmp8, 0) ThenBlock: {
            FD_ListScrollDown()
            ReturnValue(1)
        }

        // fd.tree:N — tree pane click
        IfCondition GreaterEqual(action_len, 8) ThenBlock: {
            t0 = GetByte(action_ptr, 0)
            t1 = GetByte(action_ptr, 1)
            t2 = GetByte(action_ptr, 2)
            t3 = GetByte(action_ptr, 3)
            t4 = GetByte(action_ptr, 4)
            t5 = GetByte(action_ptr, 5)
            t6 = GetByte(action_ptr, 6)
            t7 = GetByte(action_ptr, 7)
            // "fd.tree:" = 102 100 46 116 114 101 101 58
            IfCondition And(
                And(EqualTo(t0, 102), EqualTo(t1, 100)),
                And(EqualTo(t2, 46), And(EqualTo(t3, 116),
                    And(EqualTo(t4, 114), And(EqualTo(t5, 101),
                        And(EqualTo(t6, 101), EqualTo(t7, 58))))))
            ) ThenBlock: {
                num_ptr = Add(action_ptr, 8)
                dir_id = StringToNumber(num_ptr)
                FD_TreeSelect(dir_id)
                ReturnValue(1)
            }
        }

        // fd.nav:N — file list folder click
        IfCondition GreaterEqual(action_len, 7) ThenBlock: {
            f0 = GetByte(action_ptr, 0)
            f1 = GetByte(action_ptr, 1)
            f2 = GetByte(action_ptr, 2)
            f3 = GetByte(action_ptr, 3)
            f4 = GetByte(action_ptr, 4)
            f5 = GetByte(action_ptr, 5)
            f6 = GetByte(action_ptr, 6)
            // "fd.nav:" = 102 100 46 110 97 118 58
            IfCondition And(
                And(EqualTo(f0, 102), EqualTo(f1, 100)),
                And(EqualTo(f2, 46), And(EqualTo(f3, 110),
                    And(EqualTo(f4, 97), And(EqualTo(f5, 118), EqualTo(f6, 58)))))
            ) ThenBlock: {
                num_ptr2 = Add(action_ptr, 7)
                nav_dir_id = StringToNumber(num_ptr2)
                // Also expand this dir in tree
                is_exp = FD_IsExpanded(nav_dir_id)
                IfCondition EqualTo(is_exp, 0) ThenBlock: {
                    FD_AddExpanded(nav_dir_id)
                }
                FD_Navigate(nav_dir_id)
                ReturnValue(1)
            }
        }

        // fd.select:N — file list file click
        IfCondition GreaterEqual(action_len, 10) ThenBlock: {
            s0 = GetByte(action_ptr, 0)
            s1 = GetByte(action_ptr, 1)
            s2 = GetByte(action_ptr, 2)
            s3 = GetByte(action_ptr, 3)
            s4 = GetByte(action_ptr, 4)
            s5 = GetByte(action_ptr, 5)
            s6 = GetByte(action_ptr, 6)
            s7 = GetByte(action_ptr, 7)
            s8 = GetByte(action_ptr, 8)
            s9 = GetByte(action_ptr, 9)
            // "fd.select:" = 102 100 46 115 101 108 101 99 116 58
            IfCondition And(
                And(EqualTo(s0, 102), EqualTo(s1, 100)),
                And(EqualTo(s2, 46), And(EqualTo(s3, 115),
                    And(EqualTo(s4, 101), And(EqualTo(s5, 108),
                        And(EqualTo(s6, 101), And(EqualTo(s7, 99),
                            And(EqualTo(s8, 116), EqualTo(s9, 58))))))))
            ) ThenBlock: {
                num_ptr3 = Add(action_ptr, 10)
                sel_file_id = StringToNumber(num_ptr3)
                FD_Select(sel_file_id)
                ReturnValue(1)
            }
        }

        ReturnValue(0)
    }
}
