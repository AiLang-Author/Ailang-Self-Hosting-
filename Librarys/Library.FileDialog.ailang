// Library.FileDialog.ailang
// File open/save dialog — built on Library.Dialog.
// Navigation enabled — crash was caused by Win_CreateToolbarDefault
// not saving/restoring AKEvent state (fixed in Library.WinManager.ailang).
//
// Copyright © 2026 Sean Collins, 2 Paws Machine and Engineering. SCSL.

LibraryImport.Arena
LibraryImport.Auckland
LibraryImport.Dialog
LibraryImport.EventRouter
LibraryImport.WinManager
LibraryImport.StringUtils
LibraryImport.Fonts
LibraryImport.TextRegion
LibraryImport.DSurfaceTypes
LibraryImport.DSurface
LibraryImport.DDrawPixel

// =============================================================================
// STATE
// =============================================================================
FixedPool.FileDialogConst {
    "MAX_ROWS":      Initialize=64
    "MODE_OPEN":     Initialize=0
    "MODE_SAVE":     Initialize=1
}

FixedPool.FileDialogState {
    "dialog_slot":   Initialize=-1, CanChange=True
    "current_dir":   Initialize=0,  CanChange=True
    "selected_id":   Initialize=-1, CanChange=True
    "mode":          Initialize=0,  CanChange=True
    "filelist_node": Initialize=-1, CanChange=True
    "pathbar_label": Initialize=-1, CanChange=True
    "path_str":      Initialize=0,  CanChange=True
    "path_len":      Initialize=0,  CanChange=True
    "row_ids":       Initialize=0,  CanChange=True
    "row_count":     Initialize=0,  CanChange=True
}


// =============================================================================
// OPEN
// =============================================================================
Function.FileDialog_Open {
    Input: mode: Integer
    Input: start_dir: Integer
    Input: font_size: Integer
    Output: Integer
    Body: {
        DebugLog_Push("fd.open", 7)
        IfCondition GreaterEqual(FileDialogState.dialog_slot, 0) ThenBlock: {
            PrintMessage("[FileDialog] already open\n")
            ReturnValue(FileDialogState.dialog_slot)
        }

        FileDialogState.mode = mode
        FileDialogState.current_dir = start_dir
        FileDialogState.selected_id = -1
        FileDialogState.row_count = 0

        IfCondition EqualTo(FileDialogState.row_ids, 0) ThenBlock: {
            FileDialogState.row_ids = Allocate(Multiply(FileDialogConst.MAX_ROWS, 8))
        }

        rh = Dialog_CalcRowHeight(font_size)
        pad = Dialog_CalcPad(font_size)
        gap = Dialog_CalcGap(font_size)

        dlg_w = Multiply(font_size, 22)
        path_bar_h = Add(rh, 4)
        list_h = Multiply(rh, 10)
        btn_bar_h = Add(rh, 8)
        dlg_h = Add(Multiply(pad, 2), path_bar_h)
        dlg_h = Add(dlg_h, Add(gap, list_h))
        dlg_h = Add(dlg_h, Add(gap, 1))
        dlg_h = Add(dlg_h, Add(gap, btn_bar_h))

        dlg_title = "Open File"
        IfCondition EqualTo(mode, FileDialogConst.MODE_SAVE) ThenBlock: {
            dlg_title = "Save File"
        }

        DebugLog_Push("fd.dc.b", 7)
        slot = Dialog_Create(dlg_title, dlg_w, dlg_h, font_size)
        IfCondition LessThan(slot, 0) ThenBlock: {
            PrintMessage("[FileDialog] Dialog_Create failed\n")
            ReturnValue(-1)
        }
        DebugLog_Push("fd.dc.a", 7)
        FileDialogState.dialog_slot = slot

        DebugLog_Push("fd.bt.b", 7)
        FD_BuildTree(slot, font_size)
        DebugLog_Push("fd.pop.b", 8)
        FD_PopulateFiles(start_dir, slot, font_size)
        DebugLog_Push("fd.pop.a", 8)
        DebugLog_Push("fd.ren.b", 8)
        Dialog_Render(slot)
        DebugLog_Push("fd.ren.a", 8)

        PrintMessage("[FileDialog] opened slot=")
        PrintNumber(slot)
        PrintMessage("\n")
        ReturnValue(slot)
    }
}


// =============================================================================
// BUILD TREE — skeleton only (path bar, file list container, button bar)
// =============================================================================
Function.FD_BuildTree {
    Input: slot: Integer
    Input: fs: Integer
    Body: {
        DebugLog_Push("fd.bt", 5)
        rh  = Dialog_CalcRowHeight(fs)
        pad = Dialog_CalcPad(fs)
        gap = Dialog_CalcGap(fs)

        Dialog_SwapIn(slot)

        win_idx = Dialog_GetWinIdx(slot)
        cw = Win_GetCanvasW(win_idx)
        ch = Win_GetCanvasH(win_idx)
        AKTree.design_w = cw
        AKTree.design_h = ch

        // Root VBOX
        root = AK_CreateNode(AKTag.WINDOW)
        AK_Set(root, AKF.LAYOUT_MODE, AKLayout.VBOX)
        AK_Set(root, AKF.PAD_T, pad)
        AK_Set(root, AKF.PAD_R, pad)
        AK_Set(root, AKF.PAD_B, pad)
        AK_Set(root, AKF.PAD_L, pad)
        AK_Set(root, AKF.GAP, gap)
        AK_SetRoot(root)

        // Path bar HBOX
        path_bar = AK_CreateNode(AKTag.GROUP)
        AK_Set(path_bar, AKF.LAYOUT_MODE, AKLayout.HBOX)
        AK_Set(path_bar, AKF.GAP, gap)
        AK_Set(path_bar, AKF.HEIGHT, Add(rh, 4))
        AK_AddChild(root, path_bar)

        btn_back = AK_CreateNode(AKTag.BUTTON)
        AK_Set(btn_back, AKF.WIDTH, Multiply(rh, 2))
        AK_Set(btn_back, AKF.HEIGHT, rh)
        AK_ExtraSet(btn_back, AKExtra.STR_PTR, "<-")
        AK_ExtraSet(btn_back, AKExtra.STR_LEN, 2)
        AK_ExtraSet(btn_back, AKExtra.ACTION_PTR, "fd.back")
        AK_ExtraSet(btn_back, AKExtra.ACTION_LEN, 7)
        AK_AddChild(path_bar, btn_back)

        path_lbl = AK_CreateNode(AKTag.LABEL)
        AK_Set(path_lbl, AKF.GROW, 1)
        AK_Set(path_lbl, AKF.HEIGHT, rh)
        AK_ExtraSet(path_lbl, AKExtra.STR_PTR, "/")
        AK_ExtraSet(path_lbl, AKExtra.STR_LEN, 1)
        AK_ExtraSet(path_lbl, AKExtra.COLOR_FG, TVG_PackColor(200, 200, 200, 255))
        AK_ExtraSet(path_lbl, AKExtra.TEXT_ALIGN, TRAlign.LEFT)
        AK_AddChild(path_bar, path_lbl)
        FileDialogState.pathbar_label = path_lbl

        // File list PANEL — VBOX, grows to fill
        file_list = AK_CreateNode(AKTag.PANEL)
        AK_Set(file_list, AKF.LAYOUT_MODE, AKLayout.VBOX)
        AK_Set(file_list, AKF.GROW, 1)
        AK_Set(file_list, AKF.GAP, 2)
        AK_ExtraSet(file_list, AKExtra.COLOR_BG, TVG_PackColor(20, 20, 35, 255))
        AK_ExtraSet(file_list, AKExtra.BORDER_W, 1)
        AK_ExtraSet(file_list, AKExtra.BORDER_CLR, TVG_PackColor(60, 60, 90, 255))
        AK_Set(file_list, AKF.PAD_T, 2)
        AK_Set(file_list, AKF.PAD_R, 2)
        AK_Set(file_list, AKF.PAD_B, 2)
        AK_Set(file_list, AKF.PAD_L, 2)
        AK_AddChild(root, file_list)
        FileDialogState.filelist_node = file_list
        Dialog_SetContentNode(slot, file_list)

        // Separator
        sep = AK_CreateNode(AKTag.SEPARATOR)
        AK_Set(sep, AKF.HEIGHT, 1)
        AK_ExtraSet(sep, AKExtra.COLOR_FG, TVG_PackColor(80, 80, 120, 255))
        AK_AddChild(root, sep)

        // Button bar HBOX
        btn_bar = AK_CreateNode(AKTag.GROUP)
        AK_Set(btn_bar, AKF.LAYOUT_MODE, AKLayout.HBOX)
        AK_Set(btn_bar, AKF.GAP, gap)
        AK_Set(btn_bar, AKF.HEIGHT, Add(rh, 8))
        AK_AddChild(root, btn_bar)

        // Spacer pushes buttons right
        spc = AK_CreateNode(AKTag.SPACER)
        AK_Set(spc, AKF.GROW, 1)
        AK_AddChild(btn_bar, spc)

        // Cancel
        btn_cancel = AK_CreateNode(AKTag.BUTTON)
        AK_Set(btn_cancel, AKF.WIDTH, Multiply(fs, 5))
        AK_Set(btn_cancel, AKF.HEIGHT, rh)
        AK_ExtraSet(btn_cancel, AKExtra.STR_PTR, "Cancel")
        AK_ExtraSet(btn_cancel, AKExtra.STR_LEN, 6)
        AK_ExtraSet(btn_cancel, AKExtra.ACTION_PTR, "fd.cancel")
        AK_ExtraSet(btn_cancel, AKExtra.ACTION_LEN, 9)
        AK_AddChild(btn_bar, btn_cancel)

        // OK
        ok_label = "Open"
        ok_len = 4
        IfCondition EqualTo(FileDialogState.mode, FileDialogConst.MODE_SAVE) ThenBlock: {
            ok_label = "Save"
            ok_len = 4
        }
        btn_ok = AK_CreateNode(AKTag.BUTTON)
        AK_Set(btn_ok, AKF.WIDTH, Multiply(fs, 5))
        AK_Set(btn_ok, AKF.HEIGHT, rh)
        AK_ExtraSet(btn_ok, AKExtra.STR_PTR, ok_label)
        AK_ExtraSet(btn_ok, AKExtra.STR_LEN, ok_len)
        AK_ExtraSet(btn_ok, AKExtra.ACTION_PTR, "fd.ok")
        AK_ExtraSet(btn_ok, AKExtra.ACTION_LEN, 5)
        AK_AddChild(btn_bar, btn_ok)

        Dialog_SwapOut(slot)
        PrintMessage("[FileDialog] tree built\n")
    }
}


// =============================================================================
// POPULATE FILES — query DB, add rows to file list
// Called AFTER FD_BuildTree. Assumes filelist_node is set.
// =============================================================================
Function.FD_PopulateFiles {
    Input: parent_id: Integer
    Input: slot: Integer
    Input: font_size: Integer
    Body: {
        DebugLog_Push("fd.pop", 6)
        conn = SysDisplay_GetDBConn()
        IfCondition EqualTo(conn, 0) ThenBlock: {
            PrintMessage("[FileDialog] no DB\n")
            ReturnValue(0)
        }

        FileDialogState.current_dir = parent_id
        FileDialogState.row_count = 0
        rh = Dialog_CalcRowHeight(font_size)

        // Query BEFORE swap
        r = 0
        IfCondition EqualTo(parent_id, 0) ThenBlock: {
            r = PG_Query(conn, "SELECT id, name, type, size FROM files WHERE parent_id IS NULL ORDER BY type DESC, name")
        } ElseBlock: {
            q1 = "SELECT id, name, type, size FROM files WHERE parent_id = "
            id_str = NumberToString(parent_id)
            q2 = StringConcat(q1, id_str)
            q3 = StringConcat(q2, " ORDER BY type DESC, name")
            r = PG_Query(conn, q3)
        }

        IfCondition EqualTo(r, 0) ThenBlock: {
            PrintMessage("[FileDialog] query failed\n")
            ReturnValue(0)
        }

        rc = XArray.XSize(r)

        // Swap in to add nodes
        Dialog_SwapIn(slot)

        fl = FileDialogState.filelist_node
        dir_fg  = TVG_PackColor(60, 160, 240, 255)
        file_fg = TVG_PackColor(190, 190, 190, 255)

        ri = 0
        WhileLoop And(LessThan(ri, rc), LessThan(ri, FileDialogConst.MAX_ROWS)) {
            row = XArray.XGet(r, ri)
            v_id   = HashMap.HGetSimple(row, "id")
            v_name = HashMap.HGetSimple(row, "name")
            v_type = HashMap.HGetSimple(row, "type")

            is_dir = 0
            IfCondition NotEqual(v_type, 0) ThenBlock: {
                cmp = StringCompare(v_type, "dir")
                IfCondition EqualTo(cmp, 0) ThenBlock: { is_dir = 1 }
            }

            display = v_name
            display_len = StringLength(v_name)
            IfCondition EqualTo(is_dir, 1) ThenBlock: {
                display = StringConcat(v_name, "/")
                display_len = Add(display_len, 1)
            }

            action_prefix = "fd.select:"
            IfCondition EqualTo(is_dir, 1) ThenBlock: {
                action_prefix = "fd.nav:"
            }
            action_str = StringConcat(action_prefix, v_id)
            action_len = StringLength(action_str)

            file_id = StringToNumber(v_id)
            StoreValue(Add(FileDialogState.row_ids, Multiply(ri, 8)), file_id)

            row_node = AK_CreateNode(AKTag.BUTTON)
            AK_Set(row_node, AKF.HEIGHT, rh)
            AK_ExtraSet(row_node, AKExtra.STR_PTR, display)
            AK_ExtraSet(row_node, AKExtra.STR_LEN, display_len)
            AK_ExtraSet(row_node, AKExtra.TEXT_ALIGN, TRAlign.LEFT)
            AK_ExtraSet(row_node, AKExtra.ACTION_PTR, action_str)
            AK_ExtraSet(row_node, AKExtra.ACTION_LEN, action_len)

            IfCondition EqualTo(is_dir, 1) ThenBlock: {
                AK_ExtraSet(row_node, AKExtra.COLOR_FG, dir_fg)
            } ElseBlock: {
                AK_ExtraSet(row_node, AKExtra.COLOR_FG, file_fg)
            }

            AK_AddChild(fl, row_node)
            FileDialogState.row_count = Add(ri, 1)
            ri = Add(ri, 1)
        }

        IfCondition EqualTo(FileDialogState.row_count, 0) ThenBlock: {
            empty_lbl = AK_CreateNode(AKTag.LABEL)
            AK_Set(empty_lbl, AKF.HEIGHT, rh)
            AK_ExtraSet(empty_lbl, AKExtra.STR_PTR, "(empty)")
            AK_ExtraSet(empty_lbl, AKExtra.STR_LEN, 7)
            AK_ExtraSet(empty_lbl, AKExtra.COLOR_FG, TVG_PackColor(100, 100, 100, 255))
            AK_ExtraSet(empty_lbl, AKExtra.TEXT_ALIGN, TRAlign.CENTER)
            AK_AddChild(fl, empty_lbl)
        }

        Dialog_SwapOut(slot)
        PG_DestroyResult(r)

        PrintMessage("[FileDialog] populated ")
        PrintNumber(FileDialogState.row_count)
        PrintMessage(" entries\n")
    }
}


// =============================================================================
// NAVIGATE — clear file list, repopulate with new directory, re-render
// =============================================================================
Function.FD_Navigate {
    Input: dir_id: Integer
    Body: {
        DebugLog_Push("fd.nav", 6)
        slot = FileDialogState.dialog_slot
        IfCondition LessThan(slot, 0) ThenBlock: { ReturnValue(0) }

        fl = FileDialogState.filelist_node
        IfCondition LessThan(fl, 0) ThenBlock: { ReturnValue(0) }

        fs = Dialog_GetFontSize(slot)

        PrintMessage("[FD_Nav] dir=")
        PrintNumber(dir_id)
        PrintMessage("\n")

        // Clear old rows from file list
        Dialog_SwapIn(slot)
        AK_ClearChildren(fl)
        Dialog_SwapOut(slot)

        // Populate with new directory contents
        FD_PopulateFiles(dir_id, slot, fs)

        // Update path bar label with directory name
        FD_UpdatePathLabel(dir_id)

        // Re-render
        Dialog_Render(slot)
        SysDisplayState.dirty = 1
    }
}


// =============================================================================
// BACK — navigate to parent directory
// =============================================================================
Function.FD_Back {
    Body: {
        DebugLog_Push("fd.back", 7)
        slot = FileDialogState.dialog_slot
        IfCondition LessThan(slot, 0) ThenBlock: { ReturnValue(0) }

        cur = FileDialogState.current_dir
        IfCondition EqualTo(cur, 0) ThenBlock: {
            PrintMessage("[FD_Back] already at root\n")
            ReturnValue(0)
        }

        // Query parent_id of current directory
        conn = SysDisplay_GetDBConn()
        IfCondition EqualTo(conn, 0) ThenBlock: { ReturnValue(0) }

        q1 = "SELECT parent_id FROM files WHERE id = "
        id_str = NumberToString(cur)
        q2 = StringConcat(q1, id_str)
        r = PG_Query(conn, q2)

        parent_id = 0
        IfCondition NotEqual(r, 0) ThenBlock: {
            rc = XArray.XSize(r)
            IfCondition GreaterThan(rc, 0) ThenBlock: {
                row = XArray.XGet(r, 0)
                v = HashMap.HGetSimple(row, "parent_id")
                IfCondition NotEqual(v, 0) ThenBlock: {
                    parent_id = StringToNumber(v)
                }
            }
            PG_DestroyResult(r)
        }

        PrintMessage("[FD_Back] parent=")
        PrintNumber(parent_id)
        PrintMessage("\n")

        FD_Navigate(parent_id)
    }
}


// =============================================================================
// UPDATE PATH LABEL — query name of current dir and update label node
// =============================================================================
Function.FD_UpdatePathLabel {
    Input: dir_id: Integer
    Body: {
        DebugLog_Push("fd.upl", 6)
        lbl = FileDialogState.pathbar_label
        IfCondition LessThan(lbl, 0) ThenBlock: { ReturnValue(0) }

        slot = FileDialogState.dialog_slot
        IfCondition LessThan(slot, 0) ThenBlock: { ReturnValue(0) }

        // Root directory
        IfCondition EqualTo(dir_id, 0) ThenBlock: {
            Dialog_SwapIn(slot)
            AK_ExtraSet(lbl, AKExtra.STR_PTR, "/")
            AK_ExtraSet(lbl, AKExtra.STR_LEN, 1)
            Dialog_SwapOut(slot)
            ReturnValue(0)
        }

        // Query directory name
        conn = SysDisplay_GetDBConn()
        IfCondition EqualTo(conn, 0) ThenBlock: { ReturnValue(0) }

        q1 = "SELECT name FROM files WHERE id = "
        id_str = NumberToString(dir_id)
        q2 = StringConcat(q1, id_str)
        r = PG_Query(conn, q2)

        path_str = "/"
        path_len = 1
        IfCondition NotEqual(r, 0) ThenBlock: {
            rc = XArray.XSize(r)
            IfCondition GreaterThan(rc, 0) ThenBlock: {
                row = XArray.XGet(r, 0)
                v = HashMap.HGetSimple(row, "name")
                IfCondition NotEqual(v, 0) ThenBlock: {
                    p1 = StringConcat("/", v)
                    p2 = StringConcat(p1, "/")
                    path_str = p2
                    path_len = StringLength(p2)
                }
            }
            PG_DestroyResult(r)
        }

        Dialog_SwapIn(slot)
        AK_ExtraSet(lbl, AKExtra.STR_PTR, path_str)
        AK_ExtraSet(lbl, AKExtra.STR_LEN, path_len)
        Dialog_SwapOut(slot)
    }
}


// =============================================================================
// SELECT
// =============================================================================
Function.FD_Select {
    Input: file_id: Integer
    Body: {
        DebugLog_Push("fd.sel", 6)
        FileDialogState.selected_id = file_id
        PrintMessage("[FileDialog] selected=")
        PrintNumber(file_id)
        PrintMessage("\n")
    }
}


// =============================================================================
// OK
// =============================================================================
Function.FD_Ok {
    Body: {
        DebugLog_Push("fd.ok", 5)
        sel = FileDialogState.selected_id
        IfCondition LessThan(sel, 0) ThenBlock: {
            PrintMessage("[FileDialog] nothing selected\n")
            ReturnValue(0)
        }
        PrintMessage("[FileDialog] confirmed=")
        PrintNumber(sel)
        PrintMessage("\n")
        FD_CloseDialog()
    }
}


// =============================================================================
// CANCEL
// =============================================================================
Function.FD_Cancel {
    Body: {
        DebugLog_Push("fd.canc", 7)
        PrintMessage("[FileDialog] cancelled\n")
        FD_CloseDialog()
    }
}


// =============================================================================
// CLOSE
// =============================================================================
Function.FD_CloseDialog {
    Body: {
        DebugLog_Push("fd.cls", 6)
        slot = FileDialogState.dialog_slot
        IfCondition GreaterEqual(slot, 0) ThenBlock: {
            Dialog_Close(slot)
        }
        FileDialogState.dialog_slot = -1
        FileDialogState.filelist_node = -1
        FileDialogState.pathbar_label = -1
        FileDialogState.selected_id = -1
        FileDialogState.current_dir = 0
    }
}


// =============================================================================
// ACTION HANDLER — called from EventRouter_Internal
// =============================================================================
Function.FD_HandleAction {
    Input: action_ptr: Address
    Input: action_len: Integer
    Output: Integer
    Body: {
        DebugLog_Push("fd.hand", 7)
        // fd.back
        cmp = StringCompare(action_ptr, "fd.back")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            FD_Back()
            ReturnValue(1)
        }

        // fd.cancel
        cmp2 = StringCompare(action_ptr, "fd.cancel")
        IfCondition EqualTo(cmp2, 0) ThenBlock: {
            FD_Cancel()
            ReturnValue(1)
        }

        // fd.ok
        cmp3 = StringCompare(action_ptr, "fd.ok")
        IfCondition EqualTo(cmp3, 0) ThenBlock: {
            FD_Ok()
            ReturnValue(1)
        }

        // fd.nav:N
        IfCondition GreaterEqual(action_len, 7) ThenBlock: {
            f0 = GetByte(action_ptr, 0)
            f1 = GetByte(action_ptr, 1)
            f2 = GetByte(action_ptr, 2)
            f3 = GetByte(action_ptr, 3)
            f4 = GetByte(action_ptr, 4)
            f5 = GetByte(action_ptr, 5)
            f6 = GetByte(action_ptr, 6)
            // "fd.nav:" = 102 100 46 110 97 118 58
            IfCondition And(
                And(EqualTo(f0, 102), EqualTo(f1, 100)),
                And(EqualTo(f2, 46), And(EqualTo(f3, 110),
                    And(EqualTo(f4, 97), And(EqualTo(f5, 118), EqualTo(f6, 58)))))
            ) ThenBlock: {
                num_ptr = Add(action_ptr, 7)
                dir_id = StringToNumber(num_ptr)
                FD_Navigate(dir_id)
                ReturnValue(1)
            }
        }

        // fd.select:N
        IfCondition GreaterEqual(action_len, 10) ThenBlock: {
            s0 = GetByte(action_ptr, 0)
            s1 = GetByte(action_ptr, 1)
            s2 = GetByte(action_ptr, 2)
            s3 = GetByte(action_ptr, 3)
            s4 = GetByte(action_ptr, 4)
            s5 = GetByte(action_ptr, 5)
            s6 = GetByte(action_ptr, 6)
            s7 = GetByte(action_ptr, 7)
            s8 = GetByte(action_ptr, 8)
            s9 = GetByte(action_ptr, 9)
            // "fd.select:" = 102 100 46 115 101 108 101 99 116 58
            IfCondition And(
                And(EqualTo(s0, 102), EqualTo(s1, 100)),
                And(EqualTo(s2, 46), And(EqualTo(s3, 115),
                    And(EqualTo(s4, 101), And(EqualTo(s5, 108),
                        And(EqualTo(s6, 101), And(EqualTo(s7, 99),
                            And(EqualTo(s8, 116), EqualTo(s9, 58))))))))
            ) ThenBlock: {
                num_ptr2 = Add(action_ptr, 10)
                file_id = StringToNumber(num_ptr2)
                FD_Select(file_id)
                ReturnValue(1)
            }
        }

        ReturnValue(0)
    }
}