//
// Library.Font.ailang
// Unified font interface — registry, dispatch, surface-aware draw calls.
// All draw functions take a PIXEL_32 surface as first argument.

// =============================================================================
// FONT TYPES
// =============================================================================
FixedPool.FontType {
    "AUTO":   Initialize=0
    "BITMAP": Initialize=1
    "PSF":    Initialize=2
    "BDF":    Initialize=3
    "TTF":    Initialize=4
    "OTF":    Initialize=5
}

FixedPool.FontLimits {
    "MAX_FONTS": Initialize=16
}

FixedPool.FontRegistry {
    "types":       Initialize=0
    "names":       Initialize=0
    "heights":     Initialize=0
    "widths":      Initialize=0
    "baselines":   Initialize=0
    "data_ptrs":   Initialize=0
    "num_loaded":  Initialize=0
    "initialized": Initialize=0
}

// =============================================================================
// INIT / SHUTDOWN
// =============================================================================
Function.Font_Init {
    Output: Integer
    Body: {
        IfCondition EqualTo(FontRegistry.initialized, 1) ThenBlock: { ReturnValue(1) }
        max = FontLimits.MAX_FONTS
        FontRegistry.types     = Allocate(Multiply(max, 8))
        FontRegistry.names     = Allocate(Multiply(max, 8))
        FontRegistry.heights   = Allocate(Multiply(max, 8))
        FontRegistry.widths    = Allocate(Multiply(max, 8))
        FontRegistry.baselines = Allocate(Multiply(max, 8))
        FontRegistry.data_ptrs = Allocate(Multiply(max, 8))
        i = 0
        WhileLoop LessThan(i, max) {
            Font_SetRegistryInt(FontRegistry.types,     i, 0)
            Font_SetRegistryInt(FontRegistry.names,     i, 0)
            Font_SetRegistryInt(FontRegistry.heights,   i, 0)
            Font_SetRegistryInt(FontRegistry.widths,    i, 0)
            Font_SetRegistryInt(FontRegistry.baselines, i, 0)
            Font_SetRegistryInt(FontRegistry.data_ptrs, i, 0)
            i = Add(i, 1)
        }
        FontRegistry.num_loaded  = 0
        FontRegistry.initialized = 1
        PrintMessage("[Font] initialized\n")
        ReturnValue(1)
    }
}

Function.Font_Shutdown {
    Body: {
        i = 0
        WhileLoop LessThan(i, FontRegistry.num_loaded) {
            Font_Unload(i)
            i = Add(i, 1)
        }
        max = FontLimits.MAX_FONTS
        IfCondition NotEqual(FontRegistry.types,     0) ThenBlock: { Deallocate(FontRegistry.types,     Multiply(max, 8)) }
        IfCondition NotEqual(FontRegistry.names,     0) ThenBlock: { Deallocate(FontRegistry.names,     Multiply(max, 8)) }
        IfCondition NotEqual(FontRegistry.heights,   0) ThenBlock: { Deallocate(FontRegistry.heights,   Multiply(max, 8)) }
        IfCondition NotEqual(FontRegistry.widths,    0) ThenBlock: { Deallocate(FontRegistry.widths,    Multiply(max, 8)) }
        IfCondition NotEqual(FontRegistry.baselines, 0) ThenBlock: { Deallocate(FontRegistry.baselines, Multiply(max, 8)) }
        IfCondition NotEqual(FontRegistry.data_ptrs, 0) ThenBlock: { Deallocate(FontRegistry.data_ptrs, Multiply(max, 8)) }
        FontRegistry.initialized = 0
        ReturnValue(0)
    }
}

// =============================================================================
// REGISTRY HELPERS
// =============================================================================
Function.Font_SetRegistryInt {
    Input: arr:   Address
    Input: index: Integer
    Input: value: Integer
    Body: {
        StoreValue(Add(arr, Multiply(index, 8)), value)
        ReturnValue(0)
    }
}

Function.Font_GetRegistryInt {
    Input:  arr:   Address
    Input:  index: Integer
    Output: Integer
    Body: {
        ReturnValue(Dereference(Add(arr, Multiply(index, 8))))
    }
}

// =============================================================================
// LOAD
// =============================================================================
Function.Font_Load {
    Input:  filename: Address
    Output: Integer
    Body: { ReturnValue(Font_LoadTyped(filename, FontType.AUTO)) }
}

Function.Font_LoadTyped {
    Input:  filename:  Address
    Input:  font_type: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(FontRegistry.initialized, 0) ThenBlock: { Font_Init() }
        IfCondition GreaterEqual(FontRegistry.num_loaded, FontLimits.MAX_FONTS) ThenBlock: {
            PrintMessage("[Font] ERROR: max fonts loaded\n")
            ReturnValue(-1)
        }
        handle      = FontRegistry.num_loaded
        actual_type = font_type
        IfCondition EqualTo(font_type, FontType.AUTO) ThenBlock: {
            actual_type = Font_DetectType(filename)
        }
        result = 0
        IfCondition EqualTo(actual_type, FontType.BITMAP) ThenBlock: { result = FontBitmap_Load(handle, filename) }
        IfCondition EqualTo(actual_type, FontType.PSF)    ThenBlock: { result = FontPSF_Load(handle, filename)    }
        IfCondition EqualTo(actual_type, FontType.BDF)    ThenBlock: { result = FontBDF_Load(handle, filename)    }
        IfCondition EqualTo(actual_type, FontType.TTF)    ThenBlock: { result = FontTTF_Load(handle, filename)    }
        IfCondition EqualTo(actual_type, FontType.OTF)    ThenBlock: { result = FontTTF_Load(handle, filename)    }
        IfCondition EqualTo(result, 0) ThenBlock: {
            PrintMessage("[Font] ERROR: load failed\n")
            ReturnValue(-1)
        }
        Font_SetRegistryInt(FontRegistry.types, handle, actual_type)
        FontRegistry.num_loaded = Add(FontRegistry.num_loaded, 1)
        ReturnValue(handle)
    }
}

Function.Font_CreateBuiltin {
    Input:  size: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(FontRegistry.initialized, 0) ThenBlock: { Font_Init() }
        handle = FontRegistry.num_loaded
        result = FontBitmap_CreateBuiltin(handle, size)
        IfCondition EqualTo(result, 0) ThenBlock: { ReturnValue(-1) }
        Font_SetRegistryInt(FontRegistry.types, handle, FontType.BITMAP)
        FontRegistry.num_loaded = Add(FontRegistry.num_loaded, 1)
        ReturnValue(handle)
    }
}

Function.Font_Unload {
    Input: handle: Integer
    Body: {
        IfCondition Or(LessThan(handle, 0), GreaterEqual(handle, FontRegistry.num_loaded)) ThenBlock: { ReturnValue(0) }
        font_type = Font_GetRegistryInt(FontRegistry.types, handle)
        IfCondition EqualTo(font_type, FontType.BITMAP) ThenBlock: { FontBitmap_Unload(handle) }
        IfCondition EqualTo(font_type, FontType.PSF)    ThenBlock: { FontPSF_Unload(handle)    }
        IfCondition EqualTo(font_type, FontType.BDF)    ThenBlock: { FontBDF_Unload(handle)    }
        IfCondition EqualTo(font_type, FontType.TTF)    ThenBlock: { FontTTF_Unload(handle)    }
        Font_SetRegistryInt(FontRegistry.types,     handle, 0)
        Font_SetRegistryInt(FontRegistry.data_ptrs, handle, 0)
        ReturnValue(0)
    }
}

// =============================================================================
// TYPE DETECTION
// =============================================================================
Function.Font_DetectType {
    Input:  filename: Address
    Output: Integer
    Body: {
        len = StringLength(filename)
        IfCondition GreaterEqual(len, 4) ThenBlock: {
            s = Subtract(len, 4)
            c1 = GetByte(filename, s)
            c2 = BitwiseOr(GetByte(filename, Add(s, 1)), 32)
            c3 = BitwiseOr(GetByte(filename, Add(s, 2)), 32)
            c4 = BitwiseOr(GetByte(filename, Add(s, 3)), 32)
            // .bdf
            IfCondition And(EqualTo(c1, 46), And(EqualTo(c2, 98), And(EqualTo(c3, 100), EqualTo(c4, 102)))) ThenBlock: { ReturnValue(FontType.BDF) }
            // .psf
            IfCondition And(EqualTo(c1, 46), And(EqualTo(c2, 112), And(EqualTo(c3, 115), EqualTo(c4, 102)))) ThenBlock: { ReturnValue(FontType.PSF) }
            // .ttf
            IfCondition And(EqualTo(c1, 46), And(EqualTo(c2, 116), And(EqualTo(c3, 116), EqualTo(c4, 102)))) ThenBlock: { ReturnValue(FontType.TTF) }
            // .otf
            IfCondition And(EqualTo(c1, 46), And(EqualTo(c2, 111), And(EqualTo(c3, 116), EqualTo(c4, 102)))) ThenBlock: { ReturnValue(FontType.OTF) }
        }
        ReturnValue(FontType.BITMAP)
    }
}

// =============================================================================
// QUERIES
// =============================================================================
Function.Font_GetHeight {
    Input:  handle: Integer
    Output: Integer
    Body: {
        IfCondition Or(LessThan(handle, 0), GreaterEqual(handle, FontRegistry.num_loaded)) ThenBlock: { ReturnValue(0) }
        ReturnValue(Font_GetRegistryInt(FontRegistry.heights, handle))
    }
}

Function.Font_GetWidth {
    Input:  handle: Integer
    Output: Integer
    Body: {
        IfCondition Or(LessThan(handle, 0), GreaterEqual(handle, FontRegistry.num_loaded)) ThenBlock: { ReturnValue(0) }
        ReturnValue(Font_GetRegistryInt(FontRegistry.widths, handle))
    }
}

Function.Font_GetBaseline {
    Input:  handle: Integer
    Output: Integer
    Body: {
        IfCondition Or(LessThan(handle, 0), GreaterEqual(handle, FontRegistry.num_loaded)) ThenBlock: { ReturnValue(0) }
        ReturnValue(Font_GetRegistryInt(FontRegistry.baselines, handle))
    }
}

Function.Font_GetCharWidth {
    Input:  handle: Integer
    Input:  ch:     Integer
    Output: Integer
    Body: {
        font_type = Font_GetRegistryInt(FontRegistry.types, handle)
        IfCondition EqualTo(font_type, FontType.BITMAP) ThenBlock: { ReturnValue(FontBitmap_GetCharWidth(handle, ch)) }
        IfCondition EqualTo(font_type, FontType.PSF)    ThenBlock: { ReturnValue(FontPSF_GetCharWidth(handle, ch))    }
        IfCondition EqualTo(font_type, FontType.BDF)    ThenBlock: { ReturnValue(FontBDF_GetCharWidth(handle, ch))    }
        ReturnValue(8)
    }
}

Function.Font_GetStringWidth {
    Input:  handle: Integer
    Input:  str:    Address
    Output: Integer
    Body: {
        width = 0
        i     = 0
        ch    = GetByte(str, i)
        WhileLoop NotEqual(ch, 0) {
            width = Add(width, Font_GetCharWidth(handle, ch))
            i     = Add(i, 1)
            ch    = GetByte(str, i)
        }
        ReturnValue(width)
    }
}

// =============================================================================
// DRAW — all take surf as first arg
// =============================================================================
Function.Font_DrawChar {
    Input:  surf:   Integer
    Input:  handle: Integer
    Input:  x:      Integer
    Input:  y:      Integer
    Input:  ch:     Integer
    Input:  color:  Integer
    Output: Integer
    Body: {
        font_type = Font_GetRegistryInt(FontRegistry.types, handle)
        IfCondition EqualTo(font_type, FontType.BITMAP) ThenBlock: { ReturnValue(FontBitmap_DrawChar(surf, handle, x, y, ch, color)) }
        IfCondition EqualTo(font_type, FontType.PSF)    ThenBlock: { ReturnValue(FontPSF_DrawChar(surf, handle, x, y, ch, color))    }
        IfCondition EqualTo(font_type, FontType.BDF)    ThenBlock: { ReturnValue(FontBDF_DrawChar(surf, handle, x, y, ch, color))    }
        ReturnValue(0)
    }
}

Function.Font_DrawString {
    Input: surf:   Integer
    Input: handle: Integer
    Input: x:      Integer
    Input: y:      Integer
    Input: str:    Address
    Input: color:  Integer
    Body: {
        cx = x
        i  = 0
        ch = GetByte(str, i)
        WhileLoop NotEqual(ch, 0) {
            Font_DrawChar(surf, handle, cx, y, ch, color)
            cx = Add(cx, Font_GetCharWidth(handle, ch))
            i  = Add(i, 1)
            ch = GetByte(str, i)
        }
        ReturnValue(cx)
    }
}

Function.Font_DrawStringCentered {
    Input: surf:         Integer
    Input: handle:       Integer
    Input: y:            Integer
    Input: str:          Address
    Input: color:        Integer
    Input: surface_width: Integer
    Body: {
        str_width = Font_GetStringWidth(handle, str)
        x = Divide(Subtract(surface_width, str_width), 2)
        IfCondition LessThan(x, 0) ThenBlock: { x = 0 }
        Font_DrawString(surf, handle, x, y, str, color)
        ReturnValue(0)
    }
}

// =============================================================================
// STUBS — overridden when child libraries are imported
// =============================================================================
Function.FontBitmap_Load {
    Input: handle: Integer  Input: filename: Address  Output: Integer
    Body: { PrintMessage("[Font] FontBitmap_Load stub\n")  ReturnValue(0) }
}

Function.FontPSF_Load {
    Input: handle: Integer  Input: filename: Address  Output: Integer
    Body: { PrintMessage("[Font] FontPSF_Load not implemented\n")  ReturnValue(0) }
}
Function.FontPSF_Unload    { Input: handle: Integer  Body: { ReturnValue(0) } }
Function.FontPSF_GetCharWidth { Input: handle: Integer  Input: ch: Integer  Output: Integer  Body: { ReturnValue(8) } }
Function.FontPSF_DrawChar {
    Input: surf: Integer  Input: handle: Integer
    Input: x: Integer     Input: y: Integer
    Input: ch: Integer    Input: color: Integer
    Output: Integer
    Body: { ReturnValue(8) }
}

Function.FontBDF_Load {
    Input: handle: Integer  Input: filename: Address  Output: Integer
    Body: { PrintMessage("[Font] FontBDF_Load not implemented\n")  ReturnValue(0) }
}
Function.FontBDF_Unload    { Input: handle: Integer  Body: { ReturnValue(0) } }
Function.FontBDF_GetCharWidth { Input: handle: Integer  Input: ch: Integer  Output: Integer  Body: { ReturnValue(8) } }
Function.FontBDF_DrawChar {
    Input: surf: Integer  Input: handle: Integer
    Input: x: Integer     Input: y: Integer
    Input: ch: Integer    Input: color: Integer
    Output: Integer
    Body: { ReturnValue(8) }
}

Function.FontTTF_Load {
    Input: handle: Integer  Input: filename: Address  Output: Integer
    Body: { PrintMessage("[Font] FontTTF_Load not implemented\n")  ReturnValue(0) }
}
Function.FontTTF_Unload    { Input: handle: Integer  Body: { ReturnValue(0) } }
Function.FontTTF_GetCharWidth { Input: handle: Integer  Input: ch: Integer  Output: Integer  Body: { ReturnValue(8) } }
Function.FontTTF_DrawChar {
    Input: surf: Integer  Input: handle: Integer
    Input: x: Integer     Input: y: Integer
    Input: ch: Integer    Input: color: Integer
    Output: Integer
    Body: { ReturnValue(8) }
}