// Library.Font.ailang
// Unified Font Rendering System for AILang
//
// Architecture:
//   Library.Font.ailang         - Main interface, common functions
//   Library.FontBitmap.ailang   - 8x8, 8x16 fixed bitmap fonts
//   Library.FontPSF.ailang      - Linux console fonts (PSF1/PSF2)
//   Library.FontBDF.ailang      - Bitmap Distribution Format
//   Library.FontTTF.ailang      - TrueType/OpenType (vector)
//
// Usage:
//   LibraryImport.Font
//   Font_Init()
//   font = Font_Load("terminus.bdf", FONT_TYPE_BDF)
//   Font_DrawString(font, x, y, "Hello", color)
//
// The system auto-detects format or you can specify explicitly.

// =============================================================================
// FONT TYPES
// =============================================================================

FixedPool.FontType {
    "BITMAP": Initialize=1      // Built-in bitmap (8x8, 8x16)
    "PSF": Initialize=2         // Linux PSF1/PSF2
    "BDF": Initialize=3         // Bitmap Distribution Format
    "TTF": Initialize=4         // TrueType
    "OTF": Initialize=5         // OpenType
    "AUTO": Initialize=0        // Auto-detect from file
}

// =============================================================================
// FONT HANDLE STRUCTURE
// Each loaded font gets a handle with metadata
// =============================================================================

FixedPool.FontLimits {
    "MAX_FONTS": Initialize=16
    "MAX_GLYPHS": Initialize=65536
    "MAX_NAME": Initialize=64
}

// Font instance data (one per loaded font)
// In a real implementation, this would be a struct/record
// For now, we use parallel arrays indexed by font handle

FixedPool.FontRegistry {
    "types": Initialize=0        // Array: font type per handle
    "names": Initialize=0        // Array: font name pointers
    "heights": Initialize=0      // Array: font height per handle
    "widths": Initialize=0       // Array: default width (0 = proportional)
    "baselines": Initialize=0    // Array: baseline offset
    "data_ptrs": Initialize=0    // Array: pointer to glyph data
    "num_loaded": Initialize=0   // Count of loaded fonts
    "initialized": Initialize=0
}

// =============================================================================
// INITIALIZATION
// =============================================================================

Function.Font_Init {
    Output: Integer
    Body: {
        IfCondition EqualTo(FontRegistry.initialized, 1) ThenBlock: {
            ReturnValue(1)
        }
        
        max = FontLimits.MAX_FONTS
        
        // Allocate registry arrays
        FontRegistry.types = Allocate(Multiply(max, 8))
        FontRegistry.names = Allocate(Multiply(max, 8))
        FontRegistry.heights = Allocate(Multiply(max, 8))
        FontRegistry.widths = Allocate(Multiply(max, 8))
        FontRegistry.baselines = Allocate(Multiply(max, 8))
        FontRegistry.data_ptrs = Allocate(Multiply(max, 8))
        
        // Zero out
        i = 0
        WhileLoop LessThan(i, max) {
            Font_SetRegistryInt(FontRegistry.types, i, 0)
            Font_SetRegistryInt(FontRegistry.names, i, 0)
            Font_SetRegistryInt(FontRegistry.heights, i, 0)
            Font_SetRegistryInt(FontRegistry.widths, i, 0)
            Font_SetRegistryInt(FontRegistry.baselines, i, 0)
            Font_SetRegistryInt(FontRegistry.data_ptrs, i, 0)
            i = Add(i, 1)
        }
        
        FontRegistry.num_loaded = 0
        FontRegistry.initialized = 1
        
        PrintMessage("Font system initialized\n")
        ReturnValue(1)
    }
}

Function.Font_Shutdown {
    Body: {
        // Free all loaded fonts
        i = 0
        WhileLoop LessThan(i, FontRegistry.num_loaded) {
            Font_Unload(i)
            i = Add(i, 1)
        }
        
        // Free registry arrays
        max = FontLimits.MAX_FONTS
        IfCondition NotEqual(FontRegistry.types, 0) ThenBlock: {
            Deallocate(FontRegistry.types, Multiply(max, 8))
        }
        IfCondition NotEqual(FontRegistry.names, 0) ThenBlock: {
            Deallocate(FontRegistry.names, Multiply(max, 8))
        }
        IfCondition NotEqual(FontRegistry.heights, 0) ThenBlock: {
            Deallocate(FontRegistry.heights, Multiply(max, 8))
        }
        IfCondition NotEqual(FontRegistry.widths, 0) ThenBlock: {
            Deallocate(FontRegistry.widths, Multiply(max, 8))
        }
        IfCondition NotEqual(FontRegistry.baselines, 0) ThenBlock: {
            Deallocate(FontRegistry.baselines, Multiply(max, 8))
        }
        IfCondition NotEqual(FontRegistry.data_ptrs, 0) ThenBlock: {
            Deallocate(FontRegistry.data_ptrs, Multiply(max, 8))
        }
        
        FontRegistry.initialized = 0
    }
}

// Helper: set integer in registry array
Function.Font_SetRegistryInt {
    Input: arr: Address
    Input: index: Integer
    Input: value: Integer
    Body: {
        StoreValue(Add(arr, Multiply(index, 8)), value)
    }
}

// Helper: get integer from registry array
Function.Font_GetRegistryInt {
    Input: arr: Address
    Input: index: Integer
    Output: Integer
    Body: {
        ReturnValue(Dereference(Add(arr, Multiply(index, 8))))
    }
}

// =============================================================================
// FONT LOADING
// =============================================================================

// Load font from file (auto-detect type)
Function.Font_Load {
    Input: filename: Address
    Output: Integer
    Body: {
        ReturnValue(Font_LoadTyped(filename, FontType.AUTO))
    }
}

// Load font with explicit type
Function.Font_LoadTyped {
    Input: filename: Address
    Input: font_type: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(FontRegistry.initialized, 0) ThenBlock: {
            Font_Init()
        }
        
        // Check capacity
        IfCondition GreaterEqual(FontRegistry.num_loaded, FontLimits.MAX_FONTS) ThenBlock: {
            PrintMessage("ERROR: Maximum fonts loaded\n")
            ReturnValue(-1)
        }
        
        // Allocate handle
        handle = FontRegistry.num_loaded
        
        // Auto-detect type if needed
        actual_type = font_type
        IfCondition EqualTo(font_type, FontType.AUTO) ThenBlock: {
            actual_type = Font_DetectType(filename)
        }
        
        // Dispatch to appropriate loader
        result = 0
        
        IfCondition EqualTo(actual_type, FontType.BITMAP) ThenBlock: {
            result = FontBitmap_Load(handle, filename)
        }
        IfCondition EqualTo(actual_type, FontType.PSF) ThenBlock: {
            result = FontPSF_Load(handle, filename)
        }
        IfCondition EqualTo(actual_type, FontType.BDF) ThenBlock: {
            result = FontBDF_Load(handle, filename)
        }
        IfCondition EqualTo(actual_type, FontType.TTF) ThenBlock: {
            result = FontTTF_Load(handle, filename)
        }
        IfCondition EqualTo(actual_type, FontType.OTF) ThenBlock: {
            result = FontTTF_Load(handle, filename)  // Same loader for OTF
        }
        
        IfCondition EqualTo(result, 0) ThenBlock: {
            PrintMessage("ERROR: Failed to load font\n")
            ReturnValue(-1)
        }
        
        // Store type
        Font_SetRegistryInt(FontRegistry.types, handle, actual_type)
        
        FontRegistry.num_loaded = Add(FontRegistry.num_loaded, 1)
        ReturnValue(handle)
    }
}

// Create built-in bitmap font (no file needed)
Function.Font_CreateBuiltin {
    Input: size: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(FontRegistry.initialized, 0) ThenBlock: {
            Font_Init()
        }
        
        handle = FontRegistry.num_loaded
        
        result = FontBitmap_CreateBuiltin(handle, size)
        IfCondition EqualTo(result, 0) ThenBlock: {
            ReturnValue(-1)
        }
        
        Font_SetRegistryInt(FontRegistry.types, handle, FontType.BITMAP)
        FontRegistry.num_loaded = Add(FontRegistry.num_loaded, 1)
        
        ReturnValue(handle)
    }
}

// Unload font
Function.Font_Unload {
    Input: handle: Integer
    Body: {
        IfCondition Or(LessThan(handle, 0), GreaterEqual(handle, FontRegistry.num_loaded)) ThenBlock: {
            ReturnValue(0)
        }
        
        font_type = Font_GetRegistryInt(FontRegistry.types, handle)
        
        // Dispatch to appropriate unloader
        IfCondition EqualTo(font_type, FontType.BITMAP) ThenBlock: {
            FontBitmap_Unload(handle)
        }
        IfCondition EqualTo(font_type, FontType.PSF) ThenBlock: {
            FontPSF_Unload(handle)
        }
        IfCondition EqualTo(font_type, FontType.BDF) ThenBlock: {
            FontBDF_Unload(handle)
        }
        IfCondition EqualTo(font_type, FontType.TTF) ThenBlock: {
            FontTTF_Unload(handle)
        }
        
        // Clear registry entry
        Font_SetRegistryInt(FontRegistry.types, handle, 0)
        Font_SetRegistryInt(FontRegistry.data_ptrs, handle, 0)
    }
}

// Detect font type from filename/magic bytes
Function.Font_DetectType {
    Input: filename: Address
    Output: Integer
    Body: {
        // First try by extension
        len = StringLength(filename)
        
        // Check last 4 characters
        IfCondition GreaterEqual(len, 4) ThenBlock: {
            ext_start = Subtract(len, 4)
            
            // .bdf
            c1 = GetByte(filename, ext_start)
            c2 = GetByte(filename, Add(ext_start, 1))
            c3 = GetByte(filename, Add(ext_start, 2))
            c4 = GetByte(filename, Add(ext_start, 3))
            
            IfCondition And(EqualTo(c1, 46), And(EqualTo(BitwiseOr(c2, 32), 98), And(EqualTo(BitwiseOr(c3, 32), 100), EqualTo(BitwiseOr(c4, 32), 102)))) ThenBlock: {
                ReturnValue(FontType.BDF)
            }
            
            // .psf
            IfCondition And(EqualTo(c1, 46), And(EqualTo(BitwiseOr(c2, 32), 112), And(EqualTo(BitwiseOr(c3, 32), 115), EqualTo(BitwiseOr(c4, 32), 102)))) ThenBlock: {
                ReturnValue(FontType.PSF)
            }
            
            // .ttf
            IfCondition And(EqualTo(c1, 46), And(EqualTo(BitwiseOr(c2, 32), 116), And(EqualTo(BitwiseOr(c3, 32), 116), EqualTo(BitwiseOr(c4, 32), 102)))) ThenBlock: {
                ReturnValue(FontType.TTF)
            }
            
            // .otf
            IfCondition And(EqualTo(c1, 46), And(EqualTo(BitwiseOr(c2, 32), 111), And(EqualTo(BitwiseOr(c3, 32), 116), EqualTo(BitwiseOr(c4, 32), 102)))) ThenBlock: {
                ReturnValue(FontType.OTF)
            }
        }
        
        // TODO: Read file header magic bytes for better detection
        
        // Default to bitmap
        ReturnValue(FontType.BITMAP)
    }
}

// =============================================================================
// FONT QUERIES
// =============================================================================

Function.Font_GetHeight {
    Input: handle: Integer
    Output: Integer
    Body: {
        IfCondition Or(LessThan(handle, 0), GreaterEqual(handle, FontRegistry.num_loaded)) ThenBlock: {
            ReturnValue(0)
        }
        ReturnValue(Font_GetRegistryInt(FontRegistry.heights, handle))
    }
}

Function.Font_GetWidth {
    Input: handle: Integer
    Output: Integer
    Body: {
        IfCondition Or(LessThan(handle, 0), GreaterEqual(handle, FontRegistry.num_loaded)) ThenBlock: {
            ReturnValue(0)
        }
        ReturnValue(Font_GetRegistryInt(FontRegistry.widths, handle))
    }
}

Function.Font_GetBaseline {
    Input: handle: Integer
    Output: Integer
    Body: {
        IfCondition Or(LessThan(handle, 0), GreaterEqual(handle, FontRegistry.num_loaded)) ThenBlock: {
            ReturnValue(0)
        }
        ReturnValue(Font_GetRegistryInt(FontRegistry.baselines, handle))
    }
}

Function.Font_IsProportional {
    Input: handle: Integer
    Output: Integer
    Body: {
        width = Font_GetWidth(handle)
        IfCondition EqualTo(width, 0) ThenBlock: {
            ReturnValue(1)  // Width 0 = proportional
        }
        ReturnValue(0)
    }
}

// Get width of specific character
Function.Font_GetCharWidth {
    Input: handle: Integer
    Input: ch: Integer
    Output: Integer
    Body: {
        font_type = Font_GetRegistryInt(FontRegistry.types, handle)
        
        IfCondition EqualTo(font_type, FontType.BITMAP) ThenBlock: {
            ReturnValue(FontBitmap_GetCharWidth(handle, ch))
        }
        IfCondition EqualTo(font_type, FontType.PSF) ThenBlock: {
            ReturnValue(FontPSF_GetCharWidth(handle, ch))
        }
        IfCondition EqualTo(font_type, FontType.BDF) ThenBlock: {
            ReturnValue(FontBDF_GetCharWidth(handle, ch))
        }
        IfCondition EqualTo(font_type, FontType.TTF) ThenBlock: {
            ReturnValue(FontTTF_GetCharWidth(handle, ch))
        }
        
        ReturnValue(8)  // Default
    }
}

// Get width of string in pixels
Function.Font_GetStringWidth {
    Input: handle: Integer
    Input: str: Address
    Output: Integer
    Body: {
        width = 0
        i = 0
        
        ch = GetByte(str, i)
        WhileLoop NotEqual(ch, 0) {
            width = Add(width, Font_GetCharWidth(handle, ch))
            i = Add(i, 1)
            ch = GetByte(str, i)
        }
        
        ReturnValue(width)
    }
}

// =============================================================================
// RENDERING
// =============================================================================

// Draw single character
Function.Font_DrawChar {
    Input: handle: Integer
    Input: x: Integer
    Input: y: Integer
    Input: ch: Integer
    Input: color: Integer
    Output: Integer
    Body: {
        font_type = Font_GetRegistryInt(FontRegistry.types, handle)
        
        IfCondition EqualTo(font_type, FontType.BITMAP) ThenBlock: {
            ReturnValue(FontBitmap_DrawChar(handle, x, y, ch, color))
        }
        IfCondition EqualTo(font_type, FontType.PSF) ThenBlock: {
            ReturnValue(FontPSF_DrawChar(handle, x, y, ch, color))
        }
        IfCondition EqualTo(font_type, FontType.BDF) ThenBlock: {
            ReturnValue(FontBDF_DrawChar(handle, x, y, ch, color))
        }
        IfCondition EqualTo(font_type, FontType.TTF) ThenBlock: {
            ReturnValue(FontTTF_DrawChar(handle, x, y, ch, color))
        }
        
        ReturnValue(0)
    }
}

// Draw string
Function.Font_DrawString {
    Input: handle: Integer
    Input: x: Integer
    Input: y: Integer
    Input: str: Address
    Input: color: Integer
    Body: {
        cx = x
        i = 0
        
        ch = GetByte(str, i)
        WhileLoop NotEqual(ch, 0) {
            Font_DrawChar(handle, cx, y, ch, color)
            cx = Add(cx, Font_GetCharWidth(handle, ch))
            i = Add(i, 1)
            ch = GetByte(str, i)
        }
    }
}

// Draw string with background color
Function.Font_DrawStringBg {
    Input: handle: Integer
    Input: x: Integer
    Input: y: Integer
    Input: str: Address
    Input: fg_color: Integer
    Input: bg_color: Integer
    Body: {
        // Draw background rectangle first
        width = Font_GetStringWidth(handle, str)
        height = Font_GetHeight(handle)
        FB_FillRect(x, y, width, height, bg_color)
        
        // Then draw text
        Font_DrawString(handle, x, y, str, fg_color)
    }
}

// Draw string centered horizontally
Function.Font_DrawStringCentered {
    Input: handle: Integer
    Input: y: Integer
    Input: str: Address
    Input: color: Integer
    Input: screen_width: Integer
    Body: {
        str_width = Font_GetStringWidth(handle, str)
        x = Divide(Subtract(screen_width, str_width), 2)
        IfCondition LessThan(x, 0) ThenBlock: { x = 0 }
        Font_DrawString(handle, x, y, str, color)
    }
}

// Draw string scaled (for bitmap fonts)
Function.Font_DrawStringScaled {
    Input: handle: Integer
    Input: x: Integer
    Input: y: Integer
    Input: str: Address
    Input: color: Integer
    Input: scale: Integer
    Body: {
        font_type = Font_GetRegistryInt(FontRegistry.types, handle)
        
        // Only bitmap fonts support simple scaling
        IfCondition EqualTo(font_type, FontType.BITMAP) ThenBlock: {
            FontBitmap_DrawStringScaled(handle, x, y, str, color, scale)
        } ElseBlock: {
            // For other fonts, just draw normal (would need resampling)
            Font_DrawString(handle, x, y, str, color)
        }
    }
}

