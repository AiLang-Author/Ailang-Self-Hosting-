// Library.FontBDF.ailang
// BDF (Bitmap Distribution Format) Font Loader
//
// BDF is a text-based bitmap font format, easy to parse.
// Widely used, many free fonts available (Terminus, Unifont, etc.)
//
// Format overview:
//   STARTFONT 2.1
//   FONT -misc-fixed-medium-r-...
//   SIZE 16 75 75
//   FONTBOUNDINGBOX 8 16 0 -4
//   STARTPROPERTIES n
//   ...properties...
//   ENDPROPERTIES
//   CHARS 256
//   STARTCHAR <name>
//   ENCODING <ascii_code>
//   SWIDTH ...
//   DWIDTH <width> 0
//   BBX <w> <h> <xoff> <yoff>
//   BITMAP
//   <hex_row>
//   <hex_row>
//   ...
//   ENDCHAR
//   ...more chars...
//   ENDFONT
//
// Usage: Loaded through Library.Font interface

LibraryImport.Font
LibraryImport.Framebuffer

// =============================================================================
// BDF FONT DATA STRUCTURE
// =============================================================================

FixedPool.BDFLimits {
    "MAX_GLYPH_HEIGHT": Initialize=64
    "MAX_GLYPH_WIDTH": Initialize=64
    "LINE_BUFFER_SIZE": Initialize=256
}

// Per-font BDF data (stored via Font registry data_ptr)
// Structure layout:
//   [0-7]:   default_width
//   [8-15]:  height
//   [16-23]: baseline
//   [24-31]: num_glyphs
//   [32+]:   glyph table (256 entries × glyph_entry_size)
//
// Glyph entry (32 bytes each):
//   [0-3]:   width
//   [4-7]:   height  
//   [8-11]:  xoffset
//   [12-15]: yoffset
//   [16-23]: data_ptr (pointer to bitmap data)
//   [24-31]: data_size

FixedPool.BDFOffsets {
    "DEFAULT_WIDTH": Initialize=0
    "HEIGHT": Initialize=8
    "BASELINE": Initialize=16
    "NUM_GLYPHS": Initialize=24
    "GLYPH_TABLE": Initialize=32
    "GLYPH_ENTRY_SIZE": Initialize=32
}

// =============================================================================
// BDF LOADER
// =============================================================================

Function.FontBDF_Load {
    Input: handle: Integer
    Input: filename: Address
    Output: Integer
    Body: {
        // Open file
        fd = SystemCall(2, filename, 0, 0)  // SYS_OPEN, O_RDONLY
        IfCondition LessThan(fd, 0) ThenBlock: {
            PrintMessage("BDF: Cannot open file: ")
            PrintString(filename)
            PrintMessage("\n")
            ReturnValue(0)
        }
        
        // Allocate line buffer
        line_buf = Allocate(BDFLimits.LINE_BUFFER_SIZE)
        
        // Allocate font data structure
        // Header (32 bytes) + glyph table (256 × 32 bytes) = 8224 bytes
        data_size = Add(BDFOffsets.GLYPH_TABLE, Multiply(256, BDFOffsets.GLYPH_ENTRY_SIZE))
        font_data = Allocate(data_size)
        
        // Zero initialize
        i = 0
        WhileLoop LessThan(i, data_size) {
            SetByte(font_data, i, 0)
            i = Add(i, 1)
        }
        
        // Parse state
        in_char = 0
        in_bitmap = 0
        current_encoding = 0
        current_width = 8
        current_height = 16
        current_xoff = 0
        current_yoff = 0
        bitmap_row = 0
        glyph_bitmap = 0
        
        default_width = 8
        default_height = 16
        baseline = 12
        
        // Read and parse file line by line
        done = 0
        WhileLoop EqualTo(done, 0) {
            // Read line
            bytes = BDF_ReadLine(fd, line_buf, BDFLimits.LINE_BUFFER_SIZE)
            IfCondition LessEqual(bytes, 0) ThenBlock: {
                done = 1
            } ElseBlock: {
                // Parse line
                IfCondition EqualTo(in_bitmap, 1) ThenBlock: {
                    // Check for ENDCHAR
                    IfCondition EqualTo(BDF_StartsWith(line_buf, "ENDCHAR"), 1) ThenBlock: {
                        in_bitmap = 0
                        in_char = 0
                        
                        // Store glyph in table
                        IfCondition And(GreaterEqual(current_encoding, 0), LessThan(current_encoding, 256)) ThenBlock: {
                            glyph_offset = Add(BDFOffsets.GLYPH_TABLE, Multiply(current_encoding, BDFOffsets.GLYPH_ENTRY_SIZE))
                            
                            // Store glyph metadata
                            BDF_StoreInt(font_data, glyph_offset, current_width)
                            BDF_StoreInt(font_data, Add(glyph_offset, 4), current_height)
                            BDF_StoreInt(font_data, Add(glyph_offset, 8), current_xoff)
                            BDF_StoreInt(font_data, Add(glyph_offset, 12), current_yoff)
                            BDF_StoreInt(font_data, Add(glyph_offset, 16), glyph_bitmap)
                            BDF_StoreInt(font_data, Add(glyph_offset, 24), Multiply(current_height, Divide(Add(current_width, 7), 8)))
                        }
                    } ElseBlock: {
                        // Parse hex bitmap row
                        IfCondition LessThan(bitmap_row, current_height) ThenBlock: {
                            hex_val = BDF_ParseHex(line_buf)
                            bytes_per_row = Divide(Add(current_width, 7), 8)
                            
                            // Store in glyph bitmap
                            row_offset = Multiply(bitmap_row, bytes_per_row)
                            b = 0
                            WhileLoop LessThan(b, bytes_per_row) {
                                shift = Multiply(Subtract(Subtract(bytes_per_row, 1), b), 8)
                                byte_val = BitwiseAnd(ShiftRight(hex_val, shift), 0xFF)
                                SetByte(glyph_bitmap, Add(row_offset, b), byte_val)
                                b = Add(b, 1)
                            }
                            
                            bitmap_row = Add(bitmap_row, 1)
                        }
                    }
                } ElseBlock: {
                    // Not in bitmap section
                    
                    // FONTBOUNDINGBOX w h xoff yoff
                    IfCondition EqualTo(BDF_StartsWith(line_buf, "FONTBOUNDINGBOX"), 1) ThenBlock: {
                        default_width = BDF_ParseNthInt(line_buf, 1)
                        default_height = BDF_ParseNthInt(line_buf, 2)
                        // xoff = BDF_ParseNthInt(line_buf, 3)
                        yoff = BDF_ParseNthInt(line_buf, 4)
                        baseline = Add(default_height, yoff)
                    }
                    
                    // STARTCHAR name
                    IfCondition EqualTo(BDF_StartsWith(line_buf, "STARTCHAR"), 1) ThenBlock: {
                        in_char = 1
                        current_width = default_width
                        current_height = default_height
                    }
                    
                    // ENCODING n
                    IfCondition EqualTo(BDF_StartsWith(line_buf, "ENCODING"), 1) ThenBlock: {
                        current_encoding = BDF_ParseNthInt(line_buf, 1)
                    }
                    
                    // DWIDTH w 0
                    IfCondition EqualTo(BDF_StartsWith(line_buf, "DWIDTH"), 1) ThenBlock: {
                        current_width = BDF_ParseNthInt(line_buf, 1)
                    }
                    
                    // BBX w h xoff yoff
                    IfCondition EqualTo(BDF_StartsWith(line_buf, "BBX"), 1) ThenBlock: {
                        current_width = BDF_ParseNthInt(line_buf, 1)
                        current_height = BDF_ParseNthInt(line_buf, 2)
                        current_xoff = BDF_ParseNthInt(line_buf, 3)
                        current_yoff = BDF_ParseNthInt(line_buf, 4)
                    }
                    
                    // BITMAP
                    IfCondition EqualTo(BDF_StartsWith(line_buf, "BITMAP"), 1) ThenBlock: {
                        in_bitmap = 1
                        bitmap_row = 0
                        
                        // Allocate bitmap for this glyph
                        bytes_per_row = Divide(Add(current_width, 7), 8)
                        bitmap_size = Multiply(current_height, bytes_per_row)
                        glyph_bitmap = Allocate(bitmap_size)
                        
                        // Zero it
                        i = 0
                        WhileLoop LessThan(i, bitmap_size) {
                            SetByte(glyph_bitmap, i, 0)
                            i = Add(i, 1)
                        }
                    }
                }
            }
        }
        
        // Store font metadata
        BDF_StoreInt(font_data, BDFOffsets.DEFAULT_WIDTH, default_width)
        BDF_StoreInt(font_data, BDFOffsets.HEIGHT, default_height)
        BDF_StoreInt(font_data, BDFOffsets.BASELINE, baseline)
        BDF_StoreInt(font_data, BDFOffsets.NUM_GLYPHS, 256)
        
        // Register with font system
        Font_SetRegistryInt(FontRegistry.data_ptrs, handle, font_data)
        Font_SetRegistryInt(FontRegistry.heights, handle, default_height)
        Font_SetRegistryInt(FontRegistry.widths, handle, default_width)
        Font_SetRegistryInt(FontRegistry.baselines, handle, baseline)
        
        // Cleanup
        Deallocate(line_buf, BDFLimits.LINE_BUFFER_SIZE)
        SystemCall(3, fd, 0, 0)  // SYS_CLOSE
        
        PrintMessage("BDF: Loaded font, height=")
        PrintNumber(default_height)
        PrintMessage("\n")
        
        ReturnValue(1)
    }
}

// =============================================================================
// BDF UNLOAD
// =============================================================================

Function.FontBDF_Unload {
    Input: handle: Integer
    Body: {
        font_data = Font_GetRegistryInt(FontRegistry.data_ptrs, handle)
        IfCondition EqualTo(font_data, 0) ThenBlock: {
            ReturnValue(0)
        }
        
        // Free glyph bitmaps
        i = 0
        WhileLoop LessThan(i, 256) {
            glyph_offset = Add(BDFOffsets.GLYPH_TABLE, Multiply(i, BDFOffsets.GLYPH_ENTRY_SIZE))
            bitmap_ptr = BDF_LoadInt(font_data, Add(glyph_offset, 16))
            bitmap_size = BDF_LoadInt(font_data, Add(glyph_offset, 24))
            
            IfCondition NotEqual(bitmap_ptr, 0) ThenBlock: {
                Deallocate(bitmap_ptr, bitmap_size)
            }
            
            i = Add(i, 1)
        }
        
        // Free font data
        data_size = Add(BDFOffsets.GLYPH_TABLE, Multiply(256, BDFOffsets.GLYPH_ENTRY_SIZE))
        Deallocate(font_data, data_size)
    }
}

// =============================================================================
// BDF RENDERING
// =============================================================================

Function.FontBDF_GetCharWidth {
    Input: handle: Integer
    Input: ch: Integer
    Output: Integer
    Body: {
        font_data = Font_GetRegistryInt(FontRegistry.data_ptrs, handle)
        IfCondition EqualTo(font_data, 0) ThenBlock: {
            ReturnValue(8)
        }
        
        IfCondition Or(LessThan(ch, 0), GreaterEqual(ch, 256)) ThenBlock: {
            ReturnValue(BDF_LoadInt(font_data, BDFOffsets.DEFAULT_WIDTH))
        }
        
        glyph_offset = Add(BDFOffsets.GLYPH_TABLE, Multiply(ch, BDFOffsets.GLYPH_ENTRY_SIZE))
        width = BDF_LoadInt(font_data, glyph_offset)
        
        IfCondition EqualTo(width, 0) ThenBlock: {
            ReturnValue(BDF_LoadInt(font_data, BDFOffsets.DEFAULT_WIDTH))
        }
        
        ReturnValue(width)
    }
}

Function.FontBDF_DrawChar {
    Input: handle: Integer
    Input: x: Integer
    Input: y: Integer
    Input: ch: Integer
    Input: color: Integer
    Output: Integer
    Body: {
        font_data = Font_GetRegistryInt(FontRegistry.data_ptrs, handle)
        IfCondition EqualTo(font_data, 0) ThenBlock: {
            ReturnValue(8)
        }
        
        IfCondition Or(LessThan(ch, 0), GreaterEqual(ch, 256)) ThenBlock: {
            ReturnValue(BDF_LoadInt(font_data, BDFOffsets.DEFAULT_WIDTH))
        }
        
        // Get glyph data
        glyph_offset = Add(BDFOffsets.GLYPH_TABLE, Multiply(ch, BDFOffsets.GLYPH_ENTRY_SIZE))
        
        glyph_width = BDF_LoadInt(font_data, glyph_offset)
        glyph_height = BDF_LoadInt(font_data, Add(glyph_offset, 4))
        xoff = BDF_LoadInt(font_data, Add(glyph_offset, 8))
        yoff = BDF_LoadInt(font_data, Add(glyph_offset, 12))
        bitmap_ptr = BDF_LoadInt(font_data, Add(glyph_offset, 16))
        
        IfCondition EqualTo(bitmap_ptr, 0) ThenBlock: {
            // No bitmap for this glyph
            ReturnValue(BDF_LoadInt(font_data, BDFOffsets.DEFAULT_WIDTH))
        }
        
        // Calculate drawing position
        font_height = BDF_LoadInt(font_data, BDFOffsets.HEIGHT)
        baseline = BDF_LoadInt(font_data, BDFOffsets.BASELINE)
        
        draw_x = Add(x, xoff)
        draw_y = Add(y, Subtract(Subtract(baseline, glyph_height), yoff))
        
        // Draw bitmap
        bytes_per_row = Divide(Add(glyph_width, 7), 8)
        
        row = 0
        WhileLoop LessThan(row, glyph_height) {
            col = 0
            WhileLoop LessThan(col, glyph_width) {
                // Get bit from bitmap
                byte_idx = Divide(col, 8)
                bit_idx = Subtract(7, Modulo(col, 8))
                
                row_offset = Multiply(row, bytes_per_row)
                byte_val = GetByte(bitmap_ptr, Add(row_offset, byte_idx))
                bit_set = BitwiseAnd(ShiftRight(byte_val, bit_idx), 1)
                
                IfCondition NotEqual(bit_set, 0) ThenBlock: {
                    FB_SetPixel(Add(draw_x, col), Add(draw_y, row), color)
                }
                
                col = Add(col, 1)
            }
            row = Add(row, 1)
        }
        
        ReturnValue(glyph_width)
    }
}

// =============================================================================
// BDF PARSING HELPERS
// =============================================================================

// Read line from file (returns bytes read, strips newline)
Function.BDF_ReadLine {
    Input: fd: Integer
    Input: buf: Address
    Input: max_len: Integer
    Output: Integer
    Body: {
        pos = 0
        done = 0
        
        WhileLoop And(EqualTo(done, 0), LessThan(pos, Subtract(max_len, 1))) {
            // Read one byte
            bytes = SystemCall(0, fd, Add(buf, pos), 1)
            
            IfCondition LessEqual(bytes, 0) ThenBlock: {
                done = 1
            } ElseBlock: {
                ch = GetByte(buf, pos)
                
                // Newline ends line
                IfCondition EqualTo(ch, 10) ThenBlock: {
                    done = 1
                } ElseBlock: {
                    // Skip carriage return
                    IfCondition NotEqual(ch, 13) ThenBlock: {
                        pos = Add(pos, 1)
                    }
                }
            }
        }
        
        // Null terminate
        SetByte(buf, pos, 0)
        ReturnValue(pos)
    }
}

// Check if string starts with prefix
Function.BDF_StartsWith {
    Input: str: Address
    Input: prefix: Address
    Output: Integer
    Body: {
        i = 0
        p_ch = GetByte(prefix, i)
        
        WhileLoop NotEqual(p_ch, 0) {
            s_ch = GetByte(str, i)
            IfCondition NotEqual(s_ch, p_ch) ThenBlock: {
                ReturnValue(0)
            }
            i = Add(i, 1)
            p_ch = GetByte(prefix, i)
        }
        
        ReturnValue(1)
    }
}

// Parse nth integer from space-separated line (0-indexed)
Function.BDF_ParseNthInt {
    Input: str: Address
    Input: n: Integer
    Output: Integer
    Body: {
        pos = 0
        field = 0
        
        // Skip to nth field
        WhileLoop LessThan(field, n) {
            // Skip current field (non-space)
            ch = GetByte(str, pos)
            WhileLoop And(NotEqual(ch, 0), NotEqual(ch, 32)) {
                pos = Add(pos, 1)
                ch = GetByte(str, pos)
            }
            // Skip spaces
            WhileLoop EqualTo(ch, 32) {
                pos = Add(pos, 1)
                ch = GetByte(str, pos)
            }
            field = Add(field, 1)
        }
        
        // Parse integer at current position
        result = 0
        negative = 0
        
        ch = GetByte(str, pos)
        IfCondition EqualTo(ch, 45) ThenBlock: {  // '-'
            negative = 1
            pos = Add(pos, 1)
            ch = GetByte(str, pos)
        }
        
        WhileLoop And(GreaterEqual(ch, 48), LessEqual(ch, 57)) {
            result = Add(Multiply(result, 10), Subtract(ch, 48))
            pos = Add(pos, 1)
            ch = GetByte(str, pos)
        }
        
        IfCondition EqualTo(negative, 1) ThenBlock: {
            result = Subtract(0, result)
        }
        
        ReturnValue(result)
    }
}

// Parse hex string (for bitmap rows)
Function.BDF_ParseHex {
    Input: str: Address
    Output: Integer
    Body: {
        result = 0
        pos = 0
        
        ch = GetByte(str, pos)
        WhileLoop NotEqual(ch, 0) {
            digit = 0
            
            IfCondition And(GreaterEqual(ch, 48), LessEqual(ch, 57)) ThenBlock: {
                digit = Subtract(ch, 48)
            }
            IfCondition And(GreaterEqual(ch, 65), LessEqual(ch, 70)) ThenBlock: {
                digit = Add(Subtract(ch, 65), 10)
            }
            IfCondition And(GreaterEqual(ch, 97), LessEqual(ch, 102)) ThenBlock: {
                digit = Add(Subtract(ch, 97), 10)
            }
            
            result = BitwiseOr(ShiftLeft(result, 4), digit)
            
            pos = Add(pos, 1)
            ch = GetByte(str, pos)
        }
        
        ReturnValue(result)
    }
}

// Store 32-bit integer at offset
Function.BDF_StoreInt {
    Input: ptr: Address
    Input: offset: Integer
    Input: value: Integer
    Body: {
        SetByte(ptr, offset, BitwiseAnd(value, 0xFF))
        SetByte(ptr, Add(offset, 1), BitwiseAnd(ShiftRight(value, 8), 0xFF))
        SetByte(ptr, Add(offset, 2), BitwiseAnd(ShiftRight(value, 16), 0xFF))
        SetByte(ptr, Add(offset, 3), BitwiseAnd(ShiftRight(value, 24), 0xFF))
    }
}

// Load 32-bit integer from offset
Function.BDF_LoadInt {
    Input: ptr: Address
    Input: offset: Integer
    Output: Integer
    Body: {
        b0 = GetByte(ptr, offset)
        b1 = GetByte(ptr, Add(offset, 1))
        b2 = GetByte(ptr, Add(offset, 2))
        b3 = GetByte(ptr, Add(offset, 3))
        
        result = BitwiseOr(b0, BitwiseOr(ShiftLeft(b1, 8), BitwiseOr(ShiftLeft(b2, 16), ShiftLeft(b3, 24))))
        ReturnValue(result)
    }
}