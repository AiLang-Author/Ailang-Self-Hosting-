//
// Library.FontBitmap.ailang
// Built-in bitmap fonts — no file loading required.
// 8x8 and 8x16, full ASCII coverage (32-126).
// Draws into PIXEL_32 surfaces via DPix_PutPixel.

LibraryImport.Font
LibraryImport.DSurfaceTypes
LibraryImport.DSurface
LibraryImport.DDrawPixel

FixedPool.BitmapFontData {
    "font_8x8":     Initialize=0
    "font_8x16":    Initialize=0
    "initialized":  Initialize=0
}

FixedPool.BitmapOffsets {
    "WIDTH":       Initialize=0
    "HEIGHT":      Initialize=8
    "DATA_PTR":    Initialize=16
    "STRUCT_SIZE": Initialize=24
}

// =============================================================================
// INIT
// =============================================================================
Function.FontBitmap_Init {
    Output: Integer
    Body: {
        IfCondition EqualTo(BitmapFontData.initialized, 1) ThenBlock: {
            ReturnValue(1)
        }
        BitmapFontData.font_8x8  = Allocate(768)
        BitmapFontData.font_8x16 = Allocate(1536)
        FontBitmap_Generate8x8(BitmapFontData.font_8x8)
        FontBitmap_Generate8x16(BitmapFontData.font_8x16)
        BitmapFontData.initialized = 1
        ReturnValue(1)
    }
}

// =============================================================================
// CREATE / UNLOAD
// =============================================================================
Function.FontBitmap_CreateBuiltin {
    Input:  handle: Integer
    Input:  size:   Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(BitmapFontData.initialized, 0) ThenBlock: {
            FontBitmap_Init()
        }
        font_data = Allocate(BitmapOffsets.STRUCT_SIZE)
        IfCondition EqualTo(size, 8) ThenBlock: {
            StoreValue(Add(font_data, BitmapOffsets.WIDTH),    8)
            StoreValue(Add(font_data, BitmapOffsets.HEIGHT),   8)
            StoreValue(Add(font_data, BitmapOffsets.DATA_PTR), BitmapFontData.font_8x8)
        } ElseBlock: {
            StoreValue(Add(font_data, BitmapOffsets.WIDTH),    8)
            StoreValue(Add(font_data, BitmapOffsets.HEIGHT),   16)
            StoreValue(Add(font_data, BitmapOffsets.DATA_PTR), BitmapFontData.font_8x16)
        }
        Font_SetRegistryInt(FontRegistry.data_ptrs, handle, font_data)
        Font_SetRegistryInt(FontRegistry.heights,   handle, size)
        Font_SetRegistryInt(FontRegistry.widths,    handle, 8)
        Font_SetRegistryInt(FontRegistry.baselines, handle, Subtract(size, 2))
        ReturnValue(1)
    }
}

Function.FontBitmap_Unload {
    Input: handle: Integer
    Body: {
        font_data = Font_GetRegistryInt(FontRegistry.data_ptrs, handle)
        IfCondition NotEqual(font_data, 0) ThenBlock: {
            Deallocate(font_data, BitmapOffsets.STRUCT_SIZE)
        }
        ReturnValue(0)
    }
}

Function.FontBitmap_GetCharWidth {
    Input:  handle: Integer
    Input:  ch:     Integer
    Output: Integer
    Body: { ReturnValue(8) }
}

// =============================================================================
// DRAW CHAR INTO SURFACE
// =============================================================================
Function.FontBitmap_DrawChar {
    Input:  surf:   Integer
    Input:  handle: Integer
    Input:  x:      Integer
    Input:  y:      Integer
    Input:  ch:     Integer
    Input:  color:  Integer
    Output: Integer
    Body: {
        font_data = Font_GetRegistryInt(FontRegistry.data_ptrs, handle)
        IfCondition EqualTo(font_data, 0) ThenBlock: { ReturnValue(0) }

        height   = Dereference(Add(font_data, BitmapOffsets.HEIGHT))
        data_ptr = Dereference(Add(font_data, BitmapOffsets.DATA_PTR))

        idx = Subtract(ch, 32)
        IfCondition LessThan(idx, 0)   ThenBlock: { idx = 0 }
        IfCondition GreaterEqual(idx, 96) ThenBlock: { idx = 0 }

        char_offset = Multiply(idx, height)

        row = 0
        WhileLoop LessThan(row, height) {
            row_data = GetByte(data_ptr, Add(char_offset, row))
            col = 0
            WhileLoop LessThan(col, 8) {
                bit = BitwiseAnd(ShiftRight(row_data, Subtract(7, col)), 1)
                IfCondition NotEqual(bit, 0) ThenBlock: {
                    DPix_PutPixel(surf, Add(x, col), Add(y, row), color)
                }
                col = Add(col, 1)
            }
            row = Add(row, 1)
        }
        ReturnValue(8)
    }
}

// =============================================================================
// DRAW STRING INTO SURFACE
// =============================================================================
Function.FontBitmap_DrawString {
    Input:  surf:   Integer
    Input:  handle: Integer
    Input:  x:      Integer
    Input:  y:      Integer
    Input:  str:    Address
    Input:  color:  Integer
    Body: {
        cx = x
        i  = 0
        ch = GetByte(str, i)
        WhileLoop NotEqual(ch, 0) {
            FontBitmap_DrawChar(surf, handle, cx, y, ch, color)
            cx = Add(cx, 8)
            i  = Add(i, 1)
            ch = GetByte(str, i)
        }
        ReturnValue(cx)
    }
}

// =============================================================================
// CHAR DEFINITION HELPERS — split to stay within 6-arg limit
// Lo writes rows 0-3, Hi writes rows 4-7
// =============================================================================
Function.FontBitmap_DefLo {
    Input: data: Address
    Input: ch:   Integer
    Input: b0:   Integer
    Input: b1:   Integer
    Input: b2:   Integer
    Input: b3:   Integer
    Body: {
        idx = Subtract(ch, 32)
        IfCondition LessThan(idx, 0)      ThenBlock: { ReturnValue(0) }
        IfCondition GreaterEqual(idx, 96) ThenBlock: { ReturnValue(0) }
        base = Multiply(idx, 8)
        SetByte(data, base,           b0)
        SetByte(data, Add(base, 1),   b1)
        SetByte(data, Add(base, 2),   b2)
        SetByte(data, Add(base, 3),   b3)
        ReturnValue(1)
    }
}

Function.FontBitmap_DefHi {
    Input: data: Address
    Input: ch:   Integer
    Input: b4:   Integer
    Input: b5:   Integer
    Input: b6:   Integer
    Input: b7:   Integer
    Body: {
        idx = Subtract(ch, 32)
        IfCondition LessThan(idx, 0)      ThenBlock: { ReturnValue(0) }
        IfCondition GreaterEqual(idx, 96) ThenBlock: { ReturnValue(0) }
        base = Multiply(idx, 8)
        SetByte(data, Add(base, 4),   b4)
        SetByte(data, Add(base, 5),   b5)
        SetByte(data, Add(base, 6),   b6)
        SetByte(data, Add(base, 7),   b7)
        ReturnValue(1)
    }
}

// =============================================================================
// 8x8 FONT DATA
// =============================================================================
Function.FontBitmap_Generate8x8 {
    Input: data: Address
    Body: {
        i = 0
        WhileLoop LessThan(i, 768) { SetByte(data, i, 0)  i = Add(i, 1) }

        // ! 33
        FontBitmap_DefLo(data, 33, 0x18, 0x18, 0x18, 0x18)
        FontBitmap_DefHi(data, 33, 0x18, 0x00, 0x18, 0x00)
        // " 34
        FontBitmap_DefLo(data, 34, 0x6C, 0x6C, 0x24, 0x00)
        FontBitmap_DefHi(data, 34, 0x00, 0x00, 0x00, 0x00)
        // # 35
        FontBitmap_DefLo(data, 35, 0x24, 0x24, 0x7E, 0x24)
        FontBitmap_DefHi(data, 35, 0x7E, 0x24, 0x24, 0x00)
        // $ 36
        FontBitmap_DefLo(data, 36, 0x18, 0x3E, 0x60, 0x3C)
        FontBitmap_DefHi(data, 36, 0x06, 0x7C, 0x18, 0x00)
        // % 37
        FontBitmap_DefLo(data, 37, 0x00, 0x66, 0x6C, 0x18)
        FontBitmap_DefHi(data, 37, 0x30, 0x66, 0x46, 0x00)
        // & 38
        FontBitmap_DefLo(data, 38, 0x1C, 0x36, 0x1C, 0x38)
        FontBitmap_DefHi(data, 38, 0x6F, 0x66, 0x3B, 0x00)
        // ' 39
        FontBitmap_DefLo(data, 39, 0x18, 0x18, 0x30, 0x00)
        FontBitmap_DefHi(data, 39, 0x00, 0x00, 0x00, 0x00)
        // ( 40
        FontBitmap_DefLo(data, 40, 0x0C, 0x18, 0x30, 0x30)
        FontBitmap_DefHi(data, 40, 0x30, 0x18, 0x0C, 0x00)
        // ) 41
        FontBitmap_DefLo(data, 41, 0x30, 0x18, 0x0C, 0x0C)
        FontBitmap_DefHi(data, 41, 0x0C, 0x18, 0x30, 0x00)
        // * 42
        FontBitmap_DefLo(data, 42, 0x00, 0x66, 0x3C, 0xFF)
        FontBitmap_DefHi(data, 42, 0x3C, 0x66, 0x00, 0x00)
        // + 43
        FontBitmap_DefLo(data, 43, 0x00, 0x18, 0x18, 0x7E)
        FontBitmap_DefHi(data, 43, 0x18, 0x18, 0x00, 0x00)
        // , 44
        FontBitmap_DefLo(data, 44, 0x00, 0x00, 0x00, 0x00)
        FontBitmap_DefHi(data, 44, 0x00, 0x18, 0x18, 0x30)
        // - 45
        FontBitmap_DefLo(data, 45, 0x00, 0x00, 0x00, 0x7E)
        FontBitmap_DefHi(data, 45, 0x00, 0x00, 0x00, 0x00)
        // . 46
        FontBitmap_DefLo(data, 46, 0x00, 0x00, 0x00, 0x00)
        FontBitmap_DefHi(data, 46, 0x00, 0x18, 0x18, 0x00)
        // / 47
        FontBitmap_DefLo(data, 47, 0x06, 0x0C, 0x18, 0x30)
        FontBitmap_DefHi(data, 47, 0x60, 0x40, 0x00, 0x00)
        // 0 48
        FontBitmap_DefLo(data, 48, 0x3C, 0x66, 0x6E, 0x7E)
        FontBitmap_DefHi(data, 48, 0x76, 0x66, 0x3C, 0x00)
        // 1 49
        FontBitmap_DefLo(data, 49, 0x18, 0x38, 0x18, 0x18)
        FontBitmap_DefHi(data, 49, 0x18, 0x18, 0x7E, 0x00)
        // 2 50
        FontBitmap_DefLo(data, 50, 0x3C, 0x66, 0x06, 0x0C)
        FontBitmap_DefHi(data, 50, 0x18, 0x30, 0x7E, 0x00)
        // 3 51
        FontBitmap_DefLo(data, 51, 0x3C, 0x66, 0x06, 0x1C)
        FontBitmap_DefHi(data, 51, 0x06, 0x66, 0x3C, 0x00)
        // 4 52
        FontBitmap_DefLo(data, 52, 0x0C, 0x1C, 0x2C, 0x4C)
        FontBitmap_DefHi(data, 52, 0x7E, 0x0C, 0x0C, 0x00)
        // 5 53
        FontBitmap_DefLo(data, 53, 0x7E, 0x60, 0x7C, 0x06)
        FontBitmap_DefHi(data, 53, 0x06, 0x66, 0x3C, 0x00)
        // 6 54
        FontBitmap_DefLo(data, 54, 0x1C, 0x30, 0x60, 0x7C)
        FontBitmap_DefHi(data, 54, 0x66, 0x66, 0x3C, 0x00)
        // 7 55
        FontBitmap_DefLo(data, 55, 0x7E, 0x06, 0x0C, 0x18)
        FontBitmap_DefHi(data, 55, 0x30, 0x30, 0x30, 0x00)
        // 8 56
        FontBitmap_DefLo(data, 56, 0x3C, 0x66, 0x66, 0x3C)
        FontBitmap_DefHi(data, 56, 0x66, 0x66, 0x3C, 0x00)
        // 9 57
        FontBitmap_DefLo(data, 57, 0x3C, 0x66, 0x66, 0x3E)
        FontBitmap_DefHi(data, 57, 0x06, 0x0C, 0x38, 0x00)
        // : 58
        FontBitmap_DefLo(data, 58, 0x00, 0x18, 0x18, 0x00)
        FontBitmap_DefHi(data, 58, 0x00, 0x18, 0x18, 0x00)
        // ; 59
        FontBitmap_DefLo(data, 59, 0x00, 0x18, 0x18, 0x00)
        FontBitmap_DefHi(data, 59, 0x00, 0x18, 0x18, 0x30)
        // < 60
        FontBitmap_DefLo(data, 60, 0x06, 0x0C, 0x18, 0x30)
        FontBitmap_DefHi(data, 60, 0x18, 0x0C, 0x06, 0x00)
        // = 61
        FontBitmap_DefLo(data, 61, 0x00, 0x00, 0x7E, 0x00)
        FontBitmap_DefHi(data, 61, 0x7E, 0x00, 0x00, 0x00)
        // > 62
        FontBitmap_DefLo(data, 62, 0x60, 0x30, 0x18, 0x0C)
        FontBitmap_DefHi(data, 62, 0x18, 0x30, 0x60, 0x00)
        // ? 63
        FontBitmap_DefLo(data, 63, 0x3C, 0x66, 0x06, 0x0C)
        FontBitmap_DefHi(data, 63, 0x18, 0x00, 0x18, 0x00)
        // @ 64
        FontBitmap_DefLo(data, 64, 0x3C, 0x66, 0x6E, 0x6A)
        FontBitmap_DefHi(data, 64, 0x6E, 0x60, 0x3C, 0x00)
        // A 65
        FontBitmap_DefLo(data, 65, 0x18, 0x3C, 0x66, 0x66)
        FontBitmap_DefHi(data, 65, 0x7E, 0x66, 0x66, 0x00)
        // B 66
        FontBitmap_DefLo(data, 66, 0x7C, 0x66, 0x66, 0x7C)
        FontBitmap_DefHi(data, 66, 0x66, 0x66, 0x7C, 0x00)
        // C 67
        FontBitmap_DefLo(data, 67, 0x3C, 0x66, 0x60, 0x60)
        FontBitmap_DefHi(data, 67, 0x60, 0x66, 0x3C, 0x00)
        // D 68
        FontBitmap_DefLo(data, 68, 0x78, 0x6C, 0x66, 0x66)
        FontBitmap_DefHi(data, 68, 0x66, 0x6C, 0x78, 0x00)
        // E 69
        FontBitmap_DefLo(data, 69, 0x7E, 0x60, 0x60, 0x7C)
        FontBitmap_DefHi(data, 69, 0x60, 0x60, 0x7E, 0x00)
        // F 70
        FontBitmap_DefLo(data, 70, 0x7E, 0x60, 0x60, 0x7C)
        FontBitmap_DefHi(data, 70, 0x60, 0x60, 0x60, 0x00)
        // G 71
        FontBitmap_DefLo(data, 71, 0x3C, 0x66, 0x60, 0x6E)
        FontBitmap_DefHi(data, 71, 0x66, 0x66, 0x3E, 0x00)
        // H 72
        FontBitmap_DefLo(data, 72, 0x66, 0x66, 0x66, 0x7E)
        FontBitmap_DefHi(data, 72, 0x66, 0x66, 0x66, 0x00)
        // I 73
        FontBitmap_DefLo(data, 73, 0x3C, 0x18, 0x18, 0x18)
        FontBitmap_DefHi(data, 73, 0x18, 0x18, 0x3C, 0x00)
        // J 74
        FontBitmap_DefLo(data, 74, 0x0E, 0x06, 0x06, 0x06)
        FontBitmap_DefHi(data, 74, 0x06, 0x66, 0x3C, 0x00)
        // K 75
        FontBitmap_DefLo(data, 75, 0x66, 0x6C, 0x78, 0x70)
        FontBitmap_DefHi(data, 75, 0x78, 0x6C, 0x66, 0x00)
        // L 76
        FontBitmap_DefLo(data, 76, 0x60, 0x60, 0x60, 0x60)
        FontBitmap_DefHi(data, 76, 0x60, 0x60, 0x7E, 0x00)
        // M 77
        FontBitmap_DefLo(data, 77, 0x63, 0x77, 0x7F, 0x6B)
        FontBitmap_DefHi(data, 77, 0x63, 0x63, 0x63, 0x00)
        // N 78
        FontBitmap_DefLo(data, 78, 0x66, 0x76, 0x7E, 0x7E)
        FontBitmap_DefHi(data, 78, 0x6E, 0x66, 0x66, 0x00)
        // O 79
        FontBitmap_DefLo(data, 79, 0x3C, 0x66, 0x66, 0x66)
        FontBitmap_DefHi(data, 79, 0x66, 0x66, 0x3C, 0x00)
        // P 80
        FontBitmap_DefLo(data, 80, 0x7C, 0x66, 0x66, 0x7C)
        FontBitmap_DefHi(data, 80, 0x60, 0x60, 0x60, 0x00)
        // Q 81
        FontBitmap_DefLo(data, 81, 0x3C, 0x66, 0x66, 0x66)
        FontBitmap_DefHi(data, 81, 0x6A, 0x6C, 0x36, 0x00)
        // R 82
        FontBitmap_DefLo(data, 82, 0x7C, 0x66, 0x66, 0x7C)
        FontBitmap_DefHi(data, 82, 0x6C, 0x66, 0x66, 0x00)
        // S 83
        FontBitmap_DefLo(data, 83, 0x3C, 0x66, 0x60, 0x3C)
        FontBitmap_DefHi(data, 83, 0x06, 0x66, 0x3C, 0x00)
        // T 84
        FontBitmap_DefLo(data, 84, 0x7E, 0x18, 0x18, 0x18)
        FontBitmap_DefHi(data, 84, 0x18, 0x18, 0x18, 0x00)
        // U 85
        FontBitmap_DefLo(data, 85, 0x66, 0x66, 0x66, 0x66)
        FontBitmap_DefHi(data, 85, 0x66, 0x66, 0x3C, 0x00)
        // V 86
        FontBitmap_DefLo(data, 86, 0x66, 0x66, 0x66, 0x66)
        FontBitmap_DefHi(data, 86, 0x66, 0x3C, 0x18, 0x00)
        // W 87
        FontBitmap_DefLo(data, 87, 0x63, 0x63, 0x63, 0x6B)
        FontBitmap_DefHi(data, 87, 0x7F, 0x77, 0x63, 0x00)
        // X 88
        FontBitmap_DefLo(data, 88, 0x66, 0x66, 0x3C, 0x18)
        FontBitmap_DefHi(data, 88, 0x3C, 0x66, 0x66, 0x00)
        // Y 89
        FontBitmap_DefLo(data, 89, 0x66, 0x66, 0x66, 0x3C)
        FontBitmap_DefHi(data, 89, 0x18, 0x18, 0x18, 0x00)
        // Z 90
        FontBitmap_DefLo(data, 90, 0x7E, 0x06, 0x0C, 0x18)
        FontBitmap_DefHi(data, 90, 0x30, 0x60, 0x7E, 0x00)
        // [ 91
        FontBitmap_DefLo(data, 91, 0x3C, 0x30, 0x30, 0x30)
        FontBitmap_DefHi(data, 91, 0x30, 0x30, 0x3C, 0x00)
        // \ 92
        FontBitmap_DefLo(data, 92, 0x60, 0x30, 0x18, 0x0C)
        FontBitmap_DefHi(data, 92, 0x06, 0x02, 0x00, 0x00)
        // ] 93
        FontBitmap_DefLo(data, 93, 0x3C, 0x0C, 0x0C, 0x0C)
        FontBitmap_DefHi(data, 93, 0x0C, 0x0C, 0x3C, 0x00)
        // ^ 94
        FontBitmap_DefLo(data, 94, 0x18, 0x3C, 0x66, 0x00)
        FontBitmap_DefHi(data, 94, 0x00, 0x00, 0x00, 0x00)
        // _ 95
        FontBitmap_DefLo(data, 95, 0x00, 0x00, 0x00, 0x00)
        FontBitmap_DefHi(data, 95, 0x00, 0x00, 0x7E, 0x00)
        // ` 96
        FontBitmap_DefLo(data, 96, 0x30, 0x18, 0x0C, 0x00)
        FontBitmap_DefHi(data, 96, 0x00, 0x00, 0x00, 0x00)
        // a 97
        FontBitmap_DefLo(data, 97, 0x00, 0x00, 0x3C, 0x06)
        FontBitmap_DefHi(data, 97, 0x3E, 0x66, 0x3E, 0x00)
        // b 98
        FontBitmap_DefLo(data, 98, 0x60, 0x60, 0x7C, 0x66)
        FontBitmap_DefHi(data, 98, 0x66, 0x66, 0x7C, 0x00)
        // c 99
        FontBitmap_DefLo(data, 99, 0x00, 0x00, 0x3C, 0x66)
        FontBitmap_DefHi(data, 99, 0x60, 0x66, 0x3C, 0x00)
        // d 100
        FontBitmap_DefLo(data, 100, 0x06, 0x06, 0x3E, 0x66)
        FontBitmap_DefHi(data, 100, 0x66, 0x66, 0x3E, 0x00)
        // e 101
        FontBitmap_DefLo(data, 101, 0x00, 0x00, 0x3C, 0x66)
        FontBitmap_DefHi(data, 101, 0x7E, 0x60, 0x3C, 0x00)
        // f 102
        FontBitmap_DefLo(data, 102, 0x1C, 0x30, 0x7C, 0x30)
        FontBitmap_DefHi(data, 102, 0x30, 0x30, 0x30, 0x00)
        // g 103
        FontBitmap_DefLo(data, 103, 0x00, 0x00, 0x3E, 0x66)
        FontBitmap_DefHi(data, 103, 0x66, 0x3E, 0x06, 0x3C)
        // h 104
        FontBitmap_DefLo(data, 104, 0x60, 0x60, 0x7C, 0x66)
        FontBitmap_DefHi(data, 104, 0x66, 0x66, 0x66, 0x00)
        // i 105
        FontBitmap_DefLo(data, 105, 0x18, 0x00, 0x38, 0x18)
        FontBitmap_DefHi(data, 105, 0x18, 0x18, 0x3C, 0x00)
        // j 106
        FontBitmap_DefLo(data, 106, 0x0C, 0x00, 0x1C, 0x0C)
        FontBitmap_DefHi(data, 106, 0x0C, 0x0C, 0x6C, 0x38)
        // k 107
        FontBitmap_DefLo(data, 107, 0x60, 0x60, 0x66, 0x6C)
        FontBitmap_DefHi(data, 107, 0x78, 0x6C, 0x66, 0x00)
        // l 108
        FontBitmap_DefLo(data, 108, 0x38, 0x18, 0x18, 0x18)
        FontBitmap_DefHi(data, 108, 0x18, 0x18, 0x3C, 0x00)
        // m 109
        FontBitmap_DefLo(data, 109, 0x00, 0x00, 0x76, 0x7F)
        FontBitmap_DefHi(data, 109, 0x6B, 0x6B, 0x63, 0x00)
        // n 110
        FontBitmap_DefLo(data, 110, 0x00, 0x00, 0x7C, 0x66)
        FontBitmap_DefHi(data, 110, 0x66, 0x66, 0x66, 0x00)
        // o 111
        FontBitmap_DefLo(data, 111, 0x00, 0x00, 0x3C, 0x66)
        FontBitmap_DefHi(data, 111, 0x66, 0x66, 0x3C, 0x00)
        // p 112
        FontBitmap_DefLo(data, 112, 0x00, 0x00, 0x7C, 0x66)
        FontBitmap_DefHi(data, 112, 0x66, 0x7C, 0x60, 0x60)
        // q 113
        FontBitmap_DefLo(data, 113, 0x00, 0x00, 0x3E, 0x66)
        FontBitmap_DefHi(data, 113, 0x66, 0x3E, 0x06, 0x06)
        // r 114
        FontBitmap_DefLo(data, 114, 0x00, 0x00, 0x7C, 0x66)
        FontBitmap_DefHi(data, 114, 0x60, 0x60, 0x60, 0x00)
        // s 115
        FontBitmap_DefLo(data, 115, 0x00, 0x00, 0x3E, 0x60)
        FontBitmap_DefHi(data, 115, 0x3C, 0x06, 0x7C, 0x00)
        // t 116
        FontBitmap_DefLo(data, 116, 0x30, 0x30, 0x7C, 0x30)
        FontBitmap_DefHi(data, 116, 0x30, 0x30, 0x1C, 0x00)
        // u 117
        FontBitmap_DefLo(data, 117, 0x00, 0x00, 0x66, 0x66)
        FontBitmap_DefHi(data, 117, 0x66, 0x66, 0x3E, 0x00)
        // v 118
        FontBitmap_DefLo(data, 118, 0x00, 0x00, 0x66, 0x66)
        FontBitmap_DefHi(data, 118, 0x66, 0x3C, 0x18, 0x00)
        // w 119
        FontBitmap_DefLo(data, 119, 0x00, 0x00, 0x63, 0x6B)
        FontBitmap_DefHi(data, 119, 0x6B, 0x7F, 0x36, 0x00)
        // x 120
        FontBitmap_DefLo(data, 120, 0x00, 0x00, 0x66, 0x3C)
        FontBitmap_DefHi(data, 120, 0x18, 0x3C, 0x66, 0x00)
        // y 121
        FontBitmap_DefLo(data, 121, 0x00, 0x00, 0x66, 0x66)
        FontBitmap_DefHi(data, 121, 0x66, 0x3E, 0x06, 0x3C)
        // z 122
        FontBitmap_DefLo(data, 122, 0x00, 0x00, 0x7E, 0x0C)
        FontBitmap_DefHi(data, 122, 0x18, 0x30, 0x7E, 0x00)
        // { 123
        FontBitmap_DefLo(data, 123, 0x0C, 0x18, 0x18, 0x30)
        FontBitmap_DefHi(data, 123, 0x18, 0x18, 0x0C, 0x00)
        // | 124
        FontBitmap_DefLo(data, 124, 0x18, 0x18, 0x18, 0x18)
        FontBitmap_DefHi(data, 124, 0x18, 0x18, 0x18, 0x00)
        // } 125
        FontBitmap_DefLo(data, 125, 0x30, 0x18, 0x18, 0x0C)
        FontBitmap_DefHi(data, 125, 0x18, 0x18, 0x30, 0x00)
        // ~ 126
        FontBitmap_DefLo(data, 126, 0x31, 0x6B, 0x46, 0x00)
        FontBitmap_DefHi(data, 126, 0x00, 0x00, 0x00, 0x00)
    }
}

// =============================================================================
// 8x16 — double each 8x8 row vertically
// =============================================================================
Function.FontBitmap_Generate8x16 {
    Input: data: Address
    Body: {
        i = 0
        WhileLoop LessThan(i, 1536) { SetByte(data, i, 0)  i = Add(i, 1) }

        temp = Allocate(768)
        FontBitmap_Generate8x8(temp)

        ch = 0
        WhileLoop LessThan(ch, 96) {
            src = Multiply(ch, 8)
            dst = Multiply(ch, 16)
            row = 0
            WhileLoop LessThan(row, 8) {
                b        = GetByte(temp, Add(src, row))
                dst_row  = Multiply(row, 2)
                SetByte(data, Add(dst, dst_row),        b)
                SetByte(data, Add(dst, Add(dst_row, 1)), b)
                row = Add(row, 1)
            }
            ch = Add(ch, 1)
        }
        Deallocate(temp, 768)
    }
}