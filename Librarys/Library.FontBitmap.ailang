// Library.FontBitmap.ailang
// Built-in Bitmap Fonts (no file loading required)
//
// Provides immediate font access without external files.
// Includes 8x8 and 8x16 fonts with full ASCII coverage.
//
// Usage: Loaded through Library.Font interface
//   font = Font_CreateBuiltin(8)   // 8x8 font
//   font = Font_CreateBuiltin(16)  // 8x16 font

LibraryImport.Font
LibraryImport.Framebuffer

// =============================================================================
// BITMAP FONT DATA STRUCTURE
// =============================================================================

FixedPool.BitmapFontData {
    "font_8x8": Initialize=0       // Pointer to 8x8 font data
    "font_8x16": Initialize=0      // Pointer to 8x16 font data
    "initialized": Initialize=0
}

// Per-font instance data (stored via Font registry)
// [0-7]:   width
// [8-15]:  height
// [16-23]: data_ptr (pointer to glyph data)
FixedPool.BitmapOffsets {
    "WIDTH": Initialize=0
    "HEIGHT": Initialize=8
    "DATA_PTR": Initialize=16
    "STRUCT_SIZE": Initialize=24
}

// =============================================================================
// INITIALIZATION
// =============================================================================

Function.FontBitmap_Init {
    Body: {
        IfCondition EqualTo(BitmapFontData.initialized, 1) ThenBlock: {
            ReturnValue(1)
        }
        
        // Create 8x8 font (96 chars × 8 bytes = 768 bytes)
        BitmapFontData.font_8x8 = Allocate(768)
        FontBitmap_Generate8x8(BitmapFontData.font_8x8)
        
        // Create 8x16 font (96 chars × 16 bytes = 1536 bytes)
        BitmapFontData.font_8x16 = Allocate(1536)
        FontBitmap_Generate8x16(BitmapFontData.font_8x16)
        
        BitmapFontData.initialized = 1
        ReturnValue(1)
    }
}

// =============================================================================
// BUILT-IN FONT CREATION
// =============================================================================

Function.FontBitmap_CreateBuiltin {
    Input: handle: Integer
    Input: size: Integer
    Output: Integer
    Body: {
        // Initialize font data if needed
        IfCondition EqualTo(BitmapFontData.initialized, 0) ThenBlock: {
            FontBitmap_Init()
        }
        
        // Allocate instance data
        font_data = Allocate(BitmapOffsets.STRUCT_SIZE)
        
        // Set up based on size
        IfCondition EqualTo(size, 8) ThenBlock: {
            Bitmap_StoreInt(font_data, BitmapOffsets.WIDTH, 8)
            Bitmap_StoreInt(font_data, BitmapOffsets.HEIGHT, 8)
            Bitmap_StoreInt(font_data, BitmapOffsets.DATA_PTR, BitmapFontData.font_8x8)
        } ElseBlock: {
            // Default to 8x16
            Bitmap_StoreInt(font_data, BitmapOffsets.WIDTH, 8)
            Bitmap_StoreInt(font_data, BitmapOffsets.HEIGHT, 16)
            Bitmap_StoreInt(font_data, BitmapOffsets.DATA_PTR, BitmapFontData.font_8x16)
        }
        
        // Register with font system
        Font_SetRegistryInt(FontRegistry.data_ptrs, handle, font_data)
        Font_SetRegistryInt(FontRegistry.heights, handle, size)
        Font_SetRegistryInt(FontRegistry.widths, handle, 8)
        Font_SetRegistryInt(FontRegistry.baselines, handle, Subtract(size, 2))
        
        ReturnValue(1)
    }
}

Function.FontBitmap_Load {
    Input: handle: Integer
    Input: filename: Address
    Output: Integer
    Body: {
        // Bitmap fonts don't load from files, use CreateBuiltin
        PrintMessage("FontBitmap: Use Font_CreateBuiltin() instead\n")
        ReturnValue(0)
    }
}

Function.FontBitmap_Unload {
    Input: handle: Integer
    Body: {
        font_data = Font_GetRegistryInt(FontRegistry.data_ptrs, handle)
        IfCondition NotEqual(font_data, 0) ThenBlock: {
            Deallocate(font_data, BitmapOffsets.STRUCT_SIZE)
        }
        // Note: Don't free the shared font data (8x8, 8x16)
    }
}

// =============================================================================
// RENDERING
// =============================================================================

Function.FontBitmap_GetCharWidth {
    Input: handle: Integer
    Input: ch: Integer
    Output: Integer
    Body: {
        // Fixed width
        ReturnValue(8)
    }
}

Function.FontBitmap_DrawChar {
    Input: handle: Integer
    Input: x: Integer
    Input: y: Integer
    Input: ch: Integer
    Input: color: Integer
    Output: Integer
    Body: {
        font_data = Font_GetRegistryInt(FontRegistry.data_ptrs, handle)
        IfCondition EqualTo(font_data, 0) ThenBlock: {
            ReturnValue(8)
        }
        
        height = Bitmap_LoadInt(font_data, BitmapOffsets.HEIGHT)
        data_ptr = Bitmap_LoadInt(font_data, BitmapOffsets.DATA_PTR)
        
        // Character index (ASCII 32-127)
        idx = Subtract(ch, 32)
        IfCondition Or(LessThan(idx, 0), GreaterEqual(idx, 96)) ThenBlock: {
            idx = 0  // Space for invalid chars
        }
        
        // Calculate offset into font data
        bytes_per_char = height
        char_offset = Multiply(idx, bytes_per_char)
        
        // Draw character
        row = 0
        WhileLoop LessThan(row, height) {
            row_data = GetByte(data_ptr, Add(char_offset, row))
            
            col = 0
            WhileLoop LessThan(col, 8) {
                // MSB is leftmost pixel
                bit = BitwiseAnd(ShiftRight(row_data, Subtract(7, col)), 1)
                IfCondition NotEqual(bit, 0) ThenBlock: {
                    FB_SetPixel(Add(x, col), Add(y, row), color)
                }
                col = Add(col, 1)
            }
            row = Add(row, 1)
        }
        
        ReturnValue(8)
    }
}

Function.FontBitmap_DrawStringScaled {
    Input: handle: Integer
    Input: x: Integer
    Input: y: Integer
    Input: str: Address
    Input: color: Integer
    Input: scale: Integer
    Body: {
        font_data = Font_GetRegistryInt(FontRegistry.data_ptrs, handle)
        IfCondition EqualTo(font_data, 0) ThenBlock: {
            ReturnValue(0)
        }
        
        height = Bitmap_LoadInt(font_data, BitmapOffsets.HEIGHT)
        data_ptr = Bitmap_LoadInt(font_data, BitmapOffsets.DATA_PTR)
        
        cx = x
        i = 0
        
        ch = GetByte(str, i)
        WhileLoop NotEqual(ch, 0) {
            idx = Subtract(ch, 32)
            IfCondition Or(LessThan(idx, 0), GreaterEqual(idx, 96)) ThenBlock: {
                idx = 0
            }
            
            char_offset = Multiply(idx, height)
            
            // Draw scaled character
            row = 0
            WhileLoop LessThan(row, height) {
                row_data = GetByte(data_ptr, Add(char_offset, row))
                
                col = 0
                WhileLoop LessThan(col, 8) {
                    bit = BitwiseAnd(ShiftRight(row_data, Subtract(7, col)), 1)
                    
                    IfCondition NotEqual(bit, 0) ThenBlock: {
                        // Draw scale×scale block
                        px = Add(cx, Multiply(col, scale))
                        py = Add(y, Multiply(row, scale))
                        
                        sy = 0
                        WhileLoop LessThan(sy, scale) {
                            sx = 0
                            WhileLoop LessThan(sx, scale) {
                                FB_SetPixel(Add(px, sx), Add(py, sy), color)
                                sx = Add(sx, 1)
                            }
                            sy = Add(sy, 1)
                        }
                    }
                    col = Add(col, 1)
                }
                row = Add(row, 1)
            }
            
            cx = Add(cx, Multiply(8, scale))
            i = Add(i, 1)
            ch = GetByte(str, i)
        }
    }
}

// =============================================================================
// HELPER FUNCTIONS
// =============================================================================

Function.Bitmap_StoreInt {
    Input: ptr: Address
    Input: offset: Integer
    Input: value: Integer
    Body: {
        StoreValue(Add(ptr, offset), value)
    }
}

Function.Bitmap_LoadInt {
    Input: ptr: Address
    Input: offset: Integer
    Output: Integer
    Body: {
        ReturnValue(Dereference(Add(ptr, offset)))
    }
}

// =============================================================================
// 8x8 FONT GENERATION
// =============================================================================

Function.FontBitmap_Generate8x8 {
    Input: data: Address
    Body: {
        // Initialize all to zero
        i = 0
        WhileLoop LessThan(i, 768) {
            SetByte(data, i, 0)
            i = Add(i, 1)
        }
        
        // Define characters (ASCII 32-127)
        // Each character is 8 bytes, one per row
        
        // Space (32) - already zero
        
        // ! (33)
        FontBitmap_DefineChar8(data, 33, 0x18, 0x18, 0x18, 0x18, 0x18, 0x00, 0x18, 0x00)
        
        // " (34)
        FontBitmap_DefineChar8(data, 34, 0x6C, 0x6C, 0x24, 0x00, 0x00, 0x00, 0x00, 0x00)
        
        // # (35)
        FontBitmap_DefineChar8(data, 35, 0x24, 0x24, 0x7E, 0x24, 0x7E, 0x24, 0x24, 0x00)
        
        // $ (36)
        FontBitmap_DefineChar8(data, 36, 0x18, 0x3E, 0x60, 0x3C, 0x06, 0x7C, 0x18, 0x00)
        
        // % (37)
        FontBitmap_DefineChar8(data, 37, 0x00, 0x66, 0x6C, 0x18, 0x30, 0x66, 0x46, 0x00)
        
        // & (38)
        FontBitmap_DefineChar8(data, 38, 0x1C, 0x36, 0x1C, 0x38, 0x6F, 0x66, 0x3B, 0x00)
        
        // ' (39)
        FontBitmap_DefineChar8(data, 39, 0x18, 0x18, 0x30, 0x00, 0x00, 0x00, 0x00, 0x00)
        
        // ( (40)
        FontBitmap_DefineChar8(data, 40, 0x0C, 0x18, 0x30, 0x30, 0x30, 0x18, 0x0C, 0x00)
        
        // ) (41)
        FontBitmap_DefineChar8(data, 41, 0x30, 0x18, 0x0C, 0x0C, 0x0C, 0x18, 0x30, 0x00)
        
        // * (42)
        FontBitmap_DefineChar8(data, 42, 0x00, 0x66, 0x3C, 0xFF, 0x3C, 0x66, 0x00, 0x00)
        
        // + (43)
        FontBitmap_DefineChar8(data, 43, 0x00, 0x18, 0x18, 0x7E, 0x18, 0x18, 0x00, 0x00)
        
        // , (44)
        FontBitmap_DefineChar8(data, 44, 0x00, 0x00, 0x00, 0x00, 0x00, 0x18, 0x18, 0x30)
        
        // - (45)
        FontBitmap_DefineChar8(data, 45, 0x00, 0x00, 0x00, 0x7E, 0x00, 0x00, 0x00, 0x00)
        
        // . (46)
        FontBitmap_DefineChar8(data, 46, 0x00, 0x00, 0x00, 0x00, 0x00, 0x18, 0x18, 0x00)
        
        // / (47)
        FontBitmap_DefineChar8(data, 47, 0x06, 0x0C, 0x18, 0x30, 0x60, 0x40, 0x00, 0x00)
        
        // 0-9 (48-57)
        FontBitmap_DefineChar8(data, 48, 0x3C, 0x66, 0x6E, 0x7E, 0x76, 0x66, 0x3C, 0x00)
        FontBitmap_DefineChar8(data, 49, 0x18, 0x38, 0x18, 0x18, 0x18, 0x18, 0x7E, 0x00)
        FontBitmap_DefineChar8(data, 50, 0x3C, 0x66, 0x06, 0x0C, 0x18, 0x30, 0x7E, 0x00)
        FontBitmap_DefineChar8(data, 51, 0x3C, 0x66, 0x06, 0x1C, 0x06, 0x66, 0x3C, 0x00)
        FontBitmap_DefineChar8(data, 52, 0x0C, 0x1C, 0x2C, 0x4C, 0x7E, 0x0C, 0x0C, 0x00)
        FontBitmap_DefineChar8(data, 53, 0x7E, 0x60, 0x7C, 0x06, 0x06, 0x66, 0x3C, 0x00)
        FontBitmap_DefineChar8(data, 54, 0x1C, 0x30, 0x60, 0x7C, 0x66, 0x66, 0x3C, 0x00)
        FontBitmap_DefineChar8(data, 55, 0x7E, 0x06, 0x0C, 0x18, 0x30, 0x30, 0x30, 0x00)
        FontBitmap_DefineChar8(data, 56, 0x3C, 0x66, 0x66, 0x3C, 0x66, 0x66, 0x3C, 0x00)
        FontBitmap_DefineChar8(data, 57, 0x3C, 0x66, 0x66, 0x3E, 0x06, 0x0C, 0x38, 0x00)
        
        // : (58)
        FontBitmap_DefineChar8(data, 58, 0x00, 0x18, 0x18, 0x00, 0x00, 0x18, 0x18, 0x00)
        
        // ; (59)
        FontBitmap_DefineChar8(data, 59, 0x00, 0x18, 0x18, 0x00, 0x00, 0x18, 0x18, 0x30)
        
        // < (60)
        FontBitmap_DefineChar8(data, 60, 0x06, 0x0C, 0x18, 0x30, 0x18, 0x0C, 0x06, 0x00)
        
        // = (61)
        FontBitmap_DefineChar8(data, 61, 0x00, 0x00, 0x7E, 0x00, 0x7E, 0x00, 0x00, 0x00)
        
        // > (62)
        FontBitmap_DefineChar8(data, 62, 0x60, 0x30, 0x18, 0x0C, 0x18, 0x30, 0x60, 0x00)
        
        // ? (63)
        FontBitmap_DefineChar8(data, 63, 0x3C, 0x66, 0x06, 0x0C, 0x18, 0x00, 0x18, 0x00)
        
        // @ (64)
        FontBitmap_DefineChar8(data, 64, 0x3C, 0x66, 0x6E, 0x6A, 0x6E, 0x60, 0x3C, 0x00)
        
        // A-Z (65-90)
        FontBitmap_DefineChar8(data, 65, 0x18, 0x3C, 0x66, 0x66, 0x7E, 0x66, 0x66, 0x00)
        FontBitmap_DefineChar8(data, 66, 0x7C, 0x66, 0x66, 0x7C, 0x66, 0x66, 0x7C, 0x00)
        FontBitmap_DefineChar8(data, 67, 0x3C, 0x66, 0x60, 0x60, 0x60, 0x66, 0x3C, 0x00)
        FontBitmap_DefineChar8(data, 68, 0x78, 0x6C, 0x66, 0x66, 0x66, 0x6C, 0x78, 0x00)
        FontBitmap_DefineChar8(data, 69, 0x7E, 0x60, 0x60, 0x7C, 0x60, 0x60, 0x7E, 0x00)
        FontBitmap_DefineChar8(data, 70, 0x7E, 0x60, 0x60, 0x7C, 0x60, 0x60, 0x60, 0x00)
        FontBitmap_DefineChar8(data, 71, 0x3C, 0x66, 0x60, 0x6E, 0x66, 0x66, 0x3E, 0x00)
        FontBitmap_DefineChar8(data, 72, 0x66, 0x66, 0x66, 0x7E, 0x66, 0x66, 0x66, 0x00)
        FontBitmap_DefineChar8(data, 73, 0x3C, 0x18, 0x18, 0x18, 0x18, 0x18, 0x3C, 0x00)
        FontBitmap_DefineChar8(data, 74, 0x0E, 0x06, 0x06, 0x06, 0x06, 0x66, 0x3C, 0x00)
        FontBitmap_DefineChar8(data, 75, 0x66, 0x6C, 0x78, 0x70, 0x78, 0x6C, 0x66, 0x00)
        FontBitmap_DefineChar8(data, 76, 0x60, 0x60, 0x60, 0x60, 0x60, 0x60, 0x7E, 0x00)
        FontBitmap_DefineChar8(data, 77, 0x63, 0x77, 0x7F, 0x6B, 0x63, 0x63, 0x63, 0x00)
        FontBitmap_DefineChar8(data, 78, 0x66, 0x76, 0x7E, 0x7E, 0x6E, 0x66, 0x66, 0x00)
        FontBitmap_DefineChar8(data, 79, 0x3C, 0x66, 0x66, 0x66, 0x66, 0x66, 0x3C, 0x00)
        FontBitmap_DefineChar8(data, 80, 0x7C, 0x66, 0x66, 0x7C, 0x60, 0x60, 0x60, 0x00)
        FontBitmap_DefineChar8(data, 81, 0x3C, 0x66, 0x66, 0x66, 0x6A, 0x6C, 0x36, 0x00)
        FontBitmap_DefineChar8(data, 82, 0x7C, 0x66, 0x66, 0x7C, 0x6C, 0x66, 0x66, 0x00)
        FontBitmap_DefineChar8(data, 83, 0x3C, 0x66, 0x60, 0x3C, 0x06, 0x66, 0x3C, 0x00)
        FontBitmap_DefineChar8(data, 84, 0x7E, 0x18, 0x18, 0x18, 0x18, 0x18, 0x18, 0x00)
        FontBitmap_DefineChar8(data, 85, 0x66, 0x66, 0x66, 0x66, 0x66, 0x66, 0x3C, 0x00)
        FontBitmap_DefineChar8(data, 86, 0x66, 0x66, 0x66, 0x66, 0x66, 0x3C, 0x18, 0x00)
        FontBitmap_DefineChar8(data, 87, 0x63, 0x63, 0x63, 0x6B, 0x7F, 0x77, 0x63, 0x00)
        FontBitmap_DefineChar8(data, 88, 0x66, 0x66, 0x3C, 0x18, 0x3C, 0x66, 0x66, 0x00)
        FontBitmap_DefineChar8(data, 89, 0x66, 0x66, 0x66, 0x3C, 0x18, 0x18, 0x18, 0x00)
        FontBitmap_DefineChar8(data, 90, 0x7E, 0x06, 0x0C, 0x18, 0x30, 0x60, 0x7E, 0x00)
        
        // [ (91)
        FontBitmap_DefineChar8(data, 91, 0x3C, 0x30, 0x30, 0x30, 0x30, 0x30, 0x3C, 0x00)
        
        // \ (92)
        FontBitmap_DefineChar8(data, 92, 0x60, 0x30, 0x18, 0x0C, 0x06, 0x02, 0x00, 0x00)
        
        // ] (93)
        FontBitmap_DefineChar8(data, 93, 0x3C, 0x0C, 0x0C, 0x0C, 0x0C, 0x0C, 0x3C, 0x00)
        
        // ^ (94)
        FontBitmap_DefineChar8(data, 94, 0x18, 0x3C, 0x66, 0x00, 0x00, 0x00, 0x00, 0x00)
        
        // _ (95)
        FontBitmap_DefineChar8(data, 95, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x7E, 0x00)
        
        // ` (96)
        FontBitmap_DefineChar8(data, 96, 0x30, 0x18, 0x0C, 0x00, 0x00, 0x00, 0x00, 0x00)
        
        // a-z (97-122)
        FontBitmap_DefineChar8(data, 97, 0x00, 0x00, 0x3C, 0x06, 0x3E, 0x66, 0x3E, 0x00)
        FontBitmap_DefineChar8(data, 98, 0x60, 0x60, 0x7C, 0x66, 0x66, 0x66, 0x7C, 0x00)
        FontBitmap_DefineChar8(data, 99, 0x00, 0x00, 0x3C, 0x66, 0x60, 0x66, 0x3C, 0x00)
        FontBitmap_DefineChar8(data, 100, 0x06, 0x06, 0x3E, 0x66, 0x66, 0x66, 0x3E, 0x00)
        FontBitmap_DefineChar8(data, 101, 0x00, 0x00, 0x3C, 0x66, 0x7E, 0x60, 0x3C, 0x00)
        FontBitmap_DefineChar8(data, 102, 0x1C, 0x30, 0x7C, 0x30, 0x30, 0x30, 0x30, 0x00)
        FontBitmap_DefineChar8(data, 103, 0x00, 0x00, 0x3E, 0x66, 0x66, 0x3E, 0x06, 0x3C)
        FontBitmap_DefineChar8(data, 104, 0x60, 0x60, 0x7C, 0x66, 0x66, 0x66, 0x66, 0x00)
        FontBitmap_DefineChar8(data, 105, 0x18, 0x00, 0x38, 0x18, 0x18, 0x18, 0x3C, 0x00)
        FontBitmap_DefineChar8(data, 106, 0x0C, 0x00, 0x1C, 0x0C, 0x0C, 0x0C, 0x6C, 0x38)
        FontBitmap_DefineChar8(data, 107, 0x60, 0x60, 0x66, 0x6C, 0x78, 0x6C, 0x66, 0x00)
        FontBitmap_DefineChar8(data, 108, 0x38, 0x18, 0x18, 0x18, 0x18, 0x18, 0x3C, 0x00)
        FontBitmap_DefineChar8(data, 109, 0x00, 0x00, 0x76, 0x7F, 0x6B, 0x6B, 0x63, 0x00)
        FontBitmap_DefineChar8(data, 110, 0x00, 0x00, 0x7C, 0x66, 0x66, 0x66, 0x66, 0x00)
        FontBitmap_DefineChar8(data, 111, 0x00, 0x00, 0x3C, 0x66, 0x66, 0x66, 0x3C, 0x00)
        FontBitmap_DefineChar8(data, 112, 0x00, 0x00, 0x7C, 0x66, 0x66, 0x7C, 0x60, 0x60)
        FontBitmap_DefineChar8(data, 113, 0x00, 0x00, 0x3E, 0x66, 0x66, 0x3E, 0x06, 0x06)
        FontBitmap_DefineChar8(data, 114, 0x00, 0x00, 0x7C, 0x66, 0x60, 0x60, 0x60, 0x00)
        FontBitmap_DefineChar8(data, 115, 0x00, 0x00, 0x3E, 0x60, 0x3C, 0x06, 0x7C, 0x00)
        FontBitmap_DefineChar8(data, 116, 0x30, 0x30, 0x7C, 0x30, 0x30, 0x30, 0x1C, 0x00)
        FontBitmap_DefineChar8(data, 117, 0x00, 0x00, 0x66, 0x66, 0x66, 0x66, 0x3E, 0x00)
        FontBitmap_DefineChar8(data, 118, 0x00, 0x00, 0x66, 0x66, 0x66, 0x3C, 0x18, 0x00)
        FontBitmap_DefineChar8(data, 119, 0x00, 0x00, 0x63, 0x6B, 0x6B, 0x7F, 0x36, 0x00)
        FontBitmap_DefineChar8(data, 120, 0x00, 0x00, 0x66, 0x3C, 0x18, 0x3C, 0x66, 0x00)
        FontBitmap_DefineChar8(data, 121, 0x00, 0x00, 0x66, 0x66, 0x66, 0x3E, 0x06, 0x3C)
        FontBitmap_DefineChar8(data, 122, 0x00, 0x00, 0x7E, 0x0C, 0x18, 0x30, 0x7E, 0x00)
        
        // { (123)
        FontBitmap_DefineChar8(data, 123, 0x0C, 0x18, 0x18, 0x30, 0x18, 0x18, 0x0C, 0x00)
        
        // | (124)
        FontBitmap_DefineChar8(data, 124, 0x18, 0x18, 0x18, 0x18, 0x18, 0x18, 0x18, 0x00)
        
        // } (125)
        FontBitmap_DefineChar8(data, 125, 0x30, 0x18, 0x18, 0x0C, 0x18, 0x18, 0x30, 0x00)
        
        // ~ (126)
        FontBitmap_DefineChar8(data, 126, 0x31, 0x6B, 0x46, 0x00, 0x00, 0x00, 0x00, 0x00)
    }
}

Function.FontBitmap_DefineChar8 {
    Input: data: Address
    Input: ch: Integer
    Input: b0: Integer
    Input: b1: Integer
    Input: b2: Integer
    Input: b3: Integer
    Input: b4: Integer
    Input: b5: Integer
    Input: b6: Integer
    Input: b7: Integer
    Body: {
        idx = Subtract(ch, 32)
        IfCondition Or(LessThan(idx, 0), GreaterEqual(idx, 96)) ThenBlock: {
            ReturnValue(0)
        }
        
        base = Multiply(idx, 8)
        SetByte(data, base, b0)
        SetByte(data, Add(base, 1), b1)
        SetByte(data, Add(base, 2), b2)
        SetByte(data, Add(base, 3), b3)
        SetByte(data, Add(base, 4), b4)
        SetByte(data, Add(base, 5), b5)
        SetByte(data, Add(base, 6), b6)
        SetByte(data, Add(base, 7), b7)
    }
}

// =============================================================================
// 8x16 FONT GENERATION
// =============================================================================

Function.FontBitmap_Generate8x16 {
    Input: data: Address
    Body: {
        // Initialize all to zero
        i = 0
        WhileLoop LessThan(i, 1536) {
            SetByte(data, i, 0)
            i = Add(i, 1)
        }
        
        // Generate 8x16 by doubling 8x8 vertically
        // Each 8x8 row becomes 2 rows in 8x16
        
        // First, generate the 8x8 data
        temp_8x8 = Allocate(768)
        FontBitmap_Generate8x8(temp_8x8)
        
        // Double each character
        ch = 0
        WhileLoop LessThan(ch, 96) {
            src_offset = Multiply(ch, 8)
            dst_offset = Multiply(ch, 16)
            
            row = 0
            WhileLoop LessThan(row, 8) {
                row_data = GetByte(temp_8x8, Add(src_offset, row))
                
                // Write twice (double vertical resolution)
                dst_row = Multiply(row, 2)
                SetByte(data, Add(dst_offset, dst_row), row_data)
                SetByte(data, Add(dst_offset, Add(dst_row, 1)), row_data)
                
                row = Add(row, 1)
            }
            
            ch = Add(ch, 1)
        }
        
        Deallocate(temp_8x8, 768)
    }
}