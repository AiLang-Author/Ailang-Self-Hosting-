// Library.FontPSF.ailang
// PSF (PC Screen Font) Loader - Linux Console Fonts
//
// PSF is the native font format for Linux console.
// Two versions exist:
//   PSF1: Simple, 256 or 512 glyphs, fixed metrics
//   PSF2: Extended, variable glyph count, Unicode table
//
// Font files typically at /usr/share/consolefonts/
// Common sizes: 8x8, 8x14, 8x16, 16x32
//
// Usage: Loaded through Library.Font interface

LibraryImport.Font
LibraryImport.Framebuffer

// =============================================================================
// PSF FORMAT CONSTANTS
// =============================================================================

FixedPool.PSF1 {
    "MAGIC0": Initialize=0x36
    "MAGIC1": Initialize=0x04
    "MODE_512": Initialize=0x01
    "MODE_HASTAB": Initialize=0x02
    "HEADER_SIZE": Initialize=4
}

FixedPool.PSF2 {
    "MAGIC0": Initialize=0x72
    "MAGIC1": Initialize=0xB5
    "MAGIC2": Initialize=0x4A
    "MAGIC3": Initialize=0x86
    "HEADER_SIZE": Initialize=32
}

// Per-font PSF data structure
FixedPool.PSFOffsets {
    "VERSION": Initialize=0         // 1 or 2
    "WIDTH": Initialize=8
    "HEIGHT": Initialize=16
    "NUM_GLYPHS": Initialize=24
    "BYTES_PER_GLYPH": Initialize=32
    "DATA_PTR": Initialize=40       // Pointer to glyph data
    "DATA_SIZE": Initialize=48
    "STRUCT_SIZE": Initialize=56
}

// =============================================================================
// PSF LOADER
// =============================================================================

Function.FontPSF_Load {
    Input: handle: Integer
    Input: filename: Address
    Output: Integer
    Body: {
        // Open file
        fd = SystemCall(2, filename, 0, 0)  // SYS_OPEN, O_RDONLY
        IfCondition LessThan(fd, 0) ThenBlock: {
            PrintMessage("PSF: Cannot open file: ")
            PrintString(filename)
            PrintMessage("\n")
            ReturnValue(0)
        }
        
        // Read header to detect version
        header = Allocate(32)
        bytes = SystemCall(0, fd, header, 32)
        
        IfCondition LessThan(bytes, 4) ThenBlock: {
            PrintMessage("PSF: File too small\n")
            Deallocate(header, 32)
            SystemCall(3, fd, 0, 0)
            ReturnValue(0)
        }
        
        // Check magic bytes
        m0 = GetByte(header, 0)
        m1 = GetByte(header, 1)
        m2 = GetByte(header, 2)
        m3 = GetByte(header, 3)
        
        version = 0
        width = 8
        height = 16
        num_glyphs = 256
        bytes_per_glyph = 16
        header_size = 4
        
        // Check for PSF1
        IfCondition And(EqualTo(m0, PSF1.MAGIC0), EqualTo(m1, PSF1.MAGIC1)) ThenBlock: {
            version = 1
            mode = m2
            height = m3
            bytes_per_glyph = m3  // In PSF1, charsize = height (assumes width 8)
            width = 8
            header_size = PSF1.HEADER_SIZE
            
            IfCondition NotEqual(BitwiseAnd(mode, PSF1.MODE_512), 0) ThenBlock: {
                num_glyphs = 512
            } ElseBlock: {
                num_glyphs = 256
            }
            
            PrintMessage("PSF1: ")
        }
        
        // Check for PSF2
        IfCondition And(And(EqualTo(m0, PSF2.MAGIC0), EqualTo(m1, PSF2.MAGIC1)), And(EqualTo(m2, PSF2.MAGIC2), EqualTo(m3, PSF2.MAGIC3))) ThenBlock: {
            version = 2
            header_size = PSF_ReadU32(header, 8)
            // flags at offset 12
            num_glyphs = PSF_ReadU32(header, 16)
            bytes_per_glyph = PSF_ReadU32(header, 20)
            height = PSF_ReadU32(header, 24)
            width = PSF_ReadU32(header, 28)
            
            PrintMessage("PSF2: ")
        }
        
        IfCondition EqualTo(version, 0) ThenBlock: {
            PrintMessage("PSF: Unknown format\n")
            Deallocate(header, 32)
            SystemCall(3, fd, 0, 0)
            ReturnValue(0)
        }
        
        Deallocate(header, 32)
        
        PrintMessage("size=")
        PrintNumber(width)
        PrintMessage("x")
        PrintNumber(height)
        PrintMessage(", glyphs=")
        PrintNumber(num_glyphs)
        PrintMessage("\n")
        
        // Calculate data size and allocate
        data_size = Multiply(num_glyphs, bytes_per_glyph)
        glyph_data = Allocate(data_size)
        
        // Seek to glyph data
        SystemCall(8, fd, header_size, 0)  // SEEK_SET
        
        // Read glyph data
        bytes = SystemCall(0, fd, glyph_data, data_size)
        SystemCall(3, fd, 0, 0)
        
        IfCondition NotEqual(bytes, data_size) ThenBlock: {
            PrintMessage("PSF: Read error\n")
            Deallocate(glyph_data, data_size)
            ReturnValue(0)
        }
        
        // Allocate font structure
        font_data = Allocate(PSFOffsets.STRUCT_SIZE)
        
        PSF_StoreInt(font_data, PSFOffsets.VERSION, version)
        PSF_StoreInt(font_data, PSFOffsets.WIDTH, width)
        PSF_StoreInt(font_data, PSFOffsets.HEIGHT, height)
        PSF_StoreInt(font_data, PSFOffsets.NUM_GLYPHS, num_glyphs)
        PSF_StoreInt(font_data, PSFOffsets.BYTES_PER_GLYPH, bytes_per_glyph)
        PSF_StoreInt(font_data, PSFOffsets.DATA_PTR, glyph_data)
        PSF_StoreInt(font_data, PSFOffsets.DATA_SIZE, data_size)
        
        // Register with font system
        Font_SetRegistryInt(FontRegistry.data_ptrs, handle, font_data)
        Font_SetRegistryInt(FontRegistry.heights, handle, height)
        Font_SetRegistryInt(FontRegistry.widths, handle, width)
        Font_SetRegistryInt(FontRegistry.baselines, handle, Subtract(height, 2))
        
        ReturnValue(1)
    }
}

// =============================================================================
// PSF UNLOAD
// =============================================================================

Function.FontPSF_Unload {
    Input: handle: Integer
    Body: {
        font_data = Font_GetRegistryInt(FontRegistry.data_ptrs, handle)
        IfCondition EqualTo(font_data, 0) ThenBlock: {
            ReturnValue(0)
        }
        
        // Free glyph data
        glyph_data = PSF_LoadInt(font_data, PSFOffsets.DATA_PTR)
        data_size = PSF_LoadInt(font_data, PSFOffsets.DATA_SIZE)
        IfCondition NotEqual(glyph_data, 0) ThenBlock: {
            Deallocate(glyph_data, data_size)
        }
        
        // Free font structure
        Deallocate(font_data, PSFOffsets.STRUCT_SIZE)
    }
}

// =============================================================================
// PSF RENDERING
// =============================================================================

Function.FontPSF_GetCharWidth {
    Input: handle: Integer
    Input: ch: Integer
    Output: Integer
    Body: {
        font_data = Font_GetRegistryInt(FontRegistry.data_ptrs, handle)
        IfCondition EqualTo(font_data, 0) ThenBlock: {
            ReturnValue(8)
        }
        
        ReturnValue(PSF_LoadInt(font_data, PSFOffsets.WIDTH))
    }
}

Function.FontPSF_DrawChar {
    Input: handle: Integer
    Input: x: Integer
    Input: y: Integer
    Input: ch: Integer
    Input: color: Integer
    Output: Integer
    Body: {
        font_data = Font_GetRegistryInt(FontRegistry.data_ptrs, handle)
        IfCondition EqualTo(font_data, 0) ThenBlock: {
            ReturnValue(8)
        }
        
        width = PSF_LoadInt(font_data, PSFOffsets.WIDTH)
        height = PSF_LoadInt(font_data, PSFOffsets.HEIGHT)
        num_glyphs = PSF_LoadInt(font_data, PSFOffsets.NUM_GLYPHS)
        bytes_per_glyph = PSF_LoadInt(font_data, PSFOffsets.BYTES_PER_GLYPH)
        glyph_data = PSF_LoadInt(font_data, PSFOffsets.DATA_PTR)
        
        // Validate character index
        glyph_idx = ch
        IfCondition GreaterEqual(glyph_idx, num_glyphs) ThenBlock: {
            glyph_idx = 0  // Use first glyph for invalid chars
        }
        
        // Calculate glyph offset
        glyph_offset = Multiply(glyph_idx, bytes_per_glyph)
        
        // Calculate bytes per row
        bytes_per_row = Divide(Add(width, 7), 8)
        
        // Draw glyph
        row = 0
        WhileLoop LessThan(row, height) {
            col = 0
            WhileLoop LessThan(col, width) {
                // Find bit in glyph data
                byte_in_row = Divide(col, 8)
                bit_in_byte = Subtract(7, Modulo(col, 8))
                
                data_offset = Add(glyph_offset, Add(Multiply(row, bytes_per_row), byte_in_row))
                byte_val = GetByte(glyph_data, data_offset)
                
                bit_set = BitwiseAnd(ShiftRight(byte_val, bit_in_byte), 1)
                
                IfCondition NotEqual(bit_set, 0) ThenBlock: {
                    FB_SetPixel(Add(x, col), Add(y, row), color)
                }
                
                col = Add(col, 1)
            }
            row = Add(row, 1)
        }
        
        ReturnValue(width)
    }
}

// =============================================================================
// PSF HELPER FUNCTIONS
// =============================================================================

Function.PSF_ReadU32 {
    Input: data: Address
    Input: offset: Integer
    Output: Integer
    Body: {
        // Little-endian
        b0 = GetByte(data, offset)
        b1 = GetByte(data, Add(offset, 1))
        b2 = GetByte(data, Add(offset, 2))
        b3 = GetByte(data, Add(offset, 3))
        ReturnValue(BitwiseOr(b0, BitwiseOr(ShiftLeft(b1, 8), BitwiseOr(ShiftLeft(b2, 16), ShiftLeft(b3, 24)))))
    }
}

Function.PSF_StoreInt {
    Input: ptr: Address
    Input: offset: Integer
    Input: value: Integer
    Body: {
        StoreValue(Add(ptr, offset), value)
    }
}

Function.PSF_LoadInt {
    Input: ptr: Address
    Input: offset: Integer
    Output: Integer
    Body: {
        ReturnValue(Dereference(Add(ptr, offset)))
    }
}