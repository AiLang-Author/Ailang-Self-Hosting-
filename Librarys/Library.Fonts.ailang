// Library.Fonts.ailang
// Vector font engine — TVG-backed glyph rendering.
// Loads .vif packed font files. Renders through VIF/TVG pipeline.
// Copyright © 2026 Sean Collins, 2 Paws Machine and Engineering. SCSL.

LibraryImport.DSurfaceTypes
LibraryImport.DSurface
LibraryImport.DDrawPixel
LibraryImport.Arena
LibraryImport.VIF
LibraryImport.SurfaceBlit

// =============================================================================
// FONT CONSTANTS
// =============================================================================
FixedPool.FontConst {
    "MAX_GLYPHS":    Initialize=512
    "GLYPH_SIZE":    Initialize=64
    "CP_OFS":        Initialize=0
    "ADV_OFS":       Initialize=8
    "BEAR_X_OFS":    Initialize=16
    "BEAR_Y_OFS":    Initialize=24
    "SURF_OFS":      Initialize=32
    "TVG_PTR_OFS":   Initialize=40
    "TVG_LEN_OFS":   Initialize=48
    "FLAGS_OFS":     Initialize=56
}

// =============================================================================
// FONT STATE
// =============================================================================
FixedPool.FontState {
    "glyphs":       Initialize=0
    "glyph_count":  Initialize=0
    "ascender":     Initialize=0
    "descender":    Initialize=0
    "line_gap":     Initialize=0
    "em":           Initialize=1024
    "render_size":  Initialize=0
    "name":         Initialize=0
}

// =============================================================================
// FONT INIT
// =============================================================================
Function.VFont_Init {
    Output: Integer
    Body: {
        gsz = Multiply(FontConst.MAX_GLYPHS, FontConst.GLYPH_SIZE)
        gb  = Allocate(gsz)
        IfCondition EqualTo(gb, 0) ThenBlock: {
            PrintMessage("[Font] glyph alloc fail\n")
            ReturnValue(0)
        }
        gi = 0
        WhileLoop LessThan(gi, gsz) { SetByte(gb, gi, 0)  gi = Add(gi, 1) }
        FontState.glyphs = gb
        FontState.glyph_count = 0
        PrintMessage("[Font] init ok\n")
        ReturnValue(1)
    }
}

// =============================================================================
// REGISTER GLYPH
// =============================================================================
Function.VFont_AddGlyph {
    Input: codepoint: Integer
    Input: advance: Integer
    Input: bearing_x: Integer
    Input: bearing_y: Integer
    Output: Integer
    Body: {
        idx = FontState.glyph_count
        IfCondition GreaterEqual(idx, FontConst.MAX_GLYPHS) ThenBlock: {
            ReturnValue(0)
        }
        off = Multiply(idx, FontConst.GLYPH_SIZE)
        gp = Add(FontState.glyphs, off)
        t = Add(gp, FontConst.CP_OFS)
        StoreValue(t, codepoint)
        t = Add(gp, FontConst.ADV_OFS)
        StoreValue(t, advance)
        t = Add(gp, FontConst.BEAR_X_OFS)
        StoreValue(t, bearing_x)
        t = Add(gp, FontConst.BEAR_Y_OFS)
        StoreValue(t, bearing_y)
        t = Add(gp, FontConst.SURF_OFS)
        StoreValue(t, 0)
        t = Add(gp, FontConst.TVG_PTR_OFS)
        StoreValue(t, 0)
        t = Add(gp, FontConst.TVG_LEN_OFS)
        StoreValue(t, 0)
        FontState.glyph_count = Add(idx, 1)
        ReturnValue(idx)
    }
}

// =============================================================================
// SET GLYPH TVG DATA
// =============================================================================
Function.VFont_SetGlyphTVG {
    Input: idx: Integer
    Input: tvg_data: Integer
    Input: tvg_len: Integer
    Body: {
        off = Multiply(idx, FontConst.GLYPH_SIZE)
        gp = Add(FontState.glyphs, off)
        t = Add(gp, FontConst.TVG_PTR_OFS)
        StoreValue(t, tvg_data)
        t = Add(gp, FontConst.TVG_LEN_OFS)
        StoreValue(t, tvg_len)
        ReturnValue(0)
    }
}

// =============================================================================
// FIND GLYPH — linear scan by codepoint
// =============================================================================
Function.VFont_FindGlyph {
    Input: codepoint: Integer
    Output: Integer
    Body: {
        gc = FontState.glyph_count
        i = 0
        WhileLoop LessThan(i, gc) {
            off = Multiply(i, FontConst.GLYPH_SIZE)
            gp = Add(FontState.glyphs, off)
            t = Add(gp, FontConst.CP_OFS)
            cp = Dereference(t)
            IfCondition EqualTo(cp, codepoint) ThenBlock: {
                ReturnValue(i)
            }
            i = Add(i, 1)
        }
        ReturnValue(-1)
    }
}

// =============================================================================
// SCALE METRIC — convert design units to pixels
// metric_val * render_size / em
// =============================================================================
Function.VFont_ScaleMetric {
    Input: metric_val: Integer
    Output: Integer
    Body: {
        rs = FontState.render_size
        em = FontState.em
        IfCondition EqualTo(em, 0) ThenBlock: { ReturnValue(0) }
        num = Multiply(metric_val, rs)
        ReturnValue(Divide(num, em))
    }
}

// =============================================================================
// RASTERIZE GLYPH — parse TVG, render at current size, cache
// =============================================================================
Function.VFont_RasterGlyph {
    Input: idx: Integer
    Output: Integer
    Body: {
        off = Multiply(idx, FontConst.GLYPH_SIZE)
        gp = Add(FontState.glyphs, off)

        // Check cache
        t = Add(gp, FontConst.SURF_OFS)
        existing = Dereference(t)
        IfCondition NotEqual(existing, 0) ThenBlock: {
            ReturnValue(existing)
        }

        // Get TVG data
        t = Add(gp, FontConst.TVG_PTR_OFS)
        tvg_ptr = Dereference(t)
        t = Add(gp, FontConst.TVG_LEN_OFS)
        tvg_len = Dereference(t)
        IfCondition EqualTo(tvg_ptr, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(tvg_len, 0) ThenBlock: { ReturnValue(0) }

        // Render through TVG pipeline at current render_size
        rs = FontState.render_size
        surf = TVG_Parse(tvg_ptr, tvg_len, rs)
        IfCondition EqualTo(surf, 0) ThenBlock: { ReturnValue(0) }

        // Cache
        t = Add(gp, FontConst.SURF_OFS)
        StoreValue(t, surf)
        ReturnValue(surf)
    }
}

// =============================================================================
// RASTERIZE ALL
// =============================================================================
Function.VFont_RasterAll {
    Input: size: Integer
    Body: {
        FontState.render_size = size
        gc = FontState.glyph_count
        i = 0
        WhileLoop LessThan(i, gc) {
            VFont_RasterGlyph(i)
            i = Add(i, 1)
        }
        PrintMessage("[Font] rasterized ")
        PrintNumber(gc)
        PrintMessage(" glyphs at ")
        PrintNumber(size)
        PrintMessage("px\n")
        ReturnValue(0)
    }
}

// =============================================================================
// FLUSH CACHE
// =============================================================================
Function.VFont_FlushCache {
    Body: {
        gc = FontState.glyph_count
        i = 0
        WhileLoop LessThan(i, gc) {
            off = Multiply(i, FontConst.GLYPH_SIZE)
            gp = Add(FontState.glyphs, off)
            t = Add(gp, FontConst.SURF_OFS)
            s = Dereference(t)
            IfCondition NotEqual(s, 0) ThenBlock: {
                StoreValue(t, 0)
            }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

// =============================================================================
// GET LINE HEIGHT — ascender - descender + line_gap, scaled
// =============================================================================
Function.VFont_GetLineHeight {
    Output: Integer
    Body: {
        raw = Subtract(FontState.ascender, FontState.descender)
        raw = Add(raw, FontState.line_gap)
        ReturnValue(VFont_ScaleMetric(raw))
    }
}

// =============================================================================
// GET BASELINE — ascender distance from top, scaled
// =============================================================================
Function.VFont_GetBaseline {
    Output: Integer
    Body: {
        ReturnValue(VFont_ScaleMetric(FontState.ascender))
    }
}

// =============================================================================
// LOAD VIF — read packed .vif font file
//
// VIF format:
//   [4] magic "VIF0"
//   [4] version
//   [4] entry_count
//   [4] kern_count (ignored for now)
//   [4] em_size
//   [4] ascent
//   [4] descent (signed)
//   [4] line_gap
//   [64] font_name
//   per entry:
//     [4] codepoint
//     [4] advance
//     [4] bearing_x (signed)
//     [4] bearing_y (signed)
//     [4] tvg_length
//     [N] tvg_data
// =============================================================================
Function.VFont_ReadU32 {
    Input: buf: Integer
    Input: off: Integer
    Output: Integer
    Body: {
        b0 = GetByte(buf, off)
        t = Add(off, 1)
        b1 = GetByte(buf, t)
        t = Add(off, 2)
        b2 = GetByte(buf, t)
        t = Add(off, 3)
        b3 = GetByte(buf, t)
        val = b0
        t = Multiply(b1, 256)
        val = Add(val, t)
        t = Multiply(b2, 65536)
        val = Add(val, t)
        t = Multiply(b3, 16777216)
        val = Add(val, t)
        ReturnValue(val)
    }
}

Function.VFont_ReadI32 {
    Input: buf: Integer
    Input: off: Integer
    Output: Integer
    Body: {
        v = VFont_ReadU32(buf, off)
        IfCondition GreaterEqual(v, 2147483648) ThenBlock: {
            v = Subtract(v, 4294967296)
        }
        ReturnValue(v)
    }
}

Function.VFont_LoadVIF {
    Input: path: Integer
    Output: Integer
    Body: {
        // Open file
        fd = SystemCall(2, path, 0, 0)
        IfCondition LessThan(fd, 0) ThenBlock: {
            PrintMessage("[Font] cannot open ")
            PrintMessage(path)
            PrintMessage("\n")
            ReturnValue(0)
        }

        // Get file size
        file_size = SystemCall(8, fd, 0, 2)
        SystemCall(8, fd, 0, 0)

        // Read entire file
        file_buf = Allocate(file_size)
        SystemCall(0, fd, file_buf, file_size)
        SystemCall(3, fd, 0, 0)

        PrintMessage("[Font] loaded ")
        PrintNumber(file_size)
        PrintMessage(" bytes from ")
        PrintMessage(path)
        PrintMessage("\n")

        // Verify magic "VIF0" = 86, 73, 70, 48
        m0 = GetByte(file_buf, 0)
        m1 = GetByte(file_buf, 1)
        m2 = GetByte(file_buf, 2)
        m3 = GetByte(file_buf, 3)
        IfCondition NotEqual(m0, 86) ThenBlock: {
            PrintMessage("[Font] bad magic\n")
            Deallocate(file_buf, file_size)
            ReturnValue(0)
        }

        // Read header
        entry_count = VFont_ReadU32(file_buf, 8)
        em_size     = VFont_ReadU32(file_buf, 16)
        ascent      = VFont_ReadU32(file_buf, 20)
        descent     = VFont_ReadI32(file_buf, 24)
        line_gap    = VFont_ReadU32(file_buf, 28)

        FontState.em        = em_size
        FontState.ascender  = ascent
        FontState.descender = descent
        FontState.line_gap  = line_gap

        PrintMessage("[Font] em=")
        PrintNumber(em_size)
        PrintMessage(" ascent=")
        PrintNumber(ascent)
        PrintMessage(" descent=")
        PrintNumber(descent)
        PrintMessage(" gap=")
        PrintNumber(line_gap)
        PrintMessage(" glyphs=")
        PrintNumber(entry_count)
        PrintMessage("\n")

        // Skip header: 4+4+4+4+4+4+4+4+64 = 96 bytes
        pos = 96

        // Read glyph entries
        gi = 0
        WhileLoop LessThan(gi, entry_count) {
            cp      = VFont_ReadU32(file_buf, pos)
            adv     = VFont_ReadU32(file_buf, Add(pos, 4))
            bear_x  = VFont_ReadI32(file_buf, Add(pos, 8))
            bear_y  = VFont_ReadI32(file_buf, Add(pos, 12))
            tvg_len = VFont_ReadU32(file_buf, Add(pos, 16))
            pos = Add(pos, 20)

            // Register glyph
            idx = VFont_AddGlyph(cp, adv, bear_x, bear_y)

            // Point TVG data into the file buffer (zero-copy)
            tvg_ptr = Add(file_buf, pos)
            VFont_SetGlyphTVG(idx, tvg_ptr, tvg_len)

            pos = Add(pos, tvg_len)
            gi = Add(gi, 1)
        }

        PrintMessage("[Font] registered ")
        PrintNumber(FontState.glyph_count)
        PrintMessage(" glyphs\n")

        // NOTE: file_buf stays allocated — TVG data points into it
        // It's freed on Font_Shutdown

        ReturnValue(1)
    }
}

// =============================================================================
// DRAW STRING — blit glyphs with advance + bearing
// =============================================================================
Function.VFont_DrawString {
    Input: dst_surf: Integer
    Input: str_ptr: Integer
    Input: str_len: Integer
    Input: x: Integer
    Input: y: Integer
    Input: color: Integer
    Body: {
        rs = FontState.render_size
        em = FontState.em
        cur_x = x

        si = 0
        WhileLoop LessThan(si, str_len) {
            cp = GetByte(str_ptr, si)

            gidx = VFont_FindGlyph(cp)

            // Glyph not found — skip
            IfCondition EqualTo(gidx, -1) ThenBlock: {
                // Unknown character — advance by half em as fallback
                half_em = Divide(rs, 2)
                cur_x = Add(cur_x, half_em)
            }

            IfCondition NotEqual(gidx, -1) ThenBlock: {
                // Get advance
                off = Multiply(gidx, FontConst.GLYPH_SIZE)
                gp = Add(FontState.glyphs, off)
                t = Add(gp, FontConst.ADV_OFS)
                adv = Dereference(t)
                sadv = VFont_ScaleMetric(adv)

                // Try to render glyph
                surf = VFont_RasterGlyph(gidx)

                IfCondition NotEqual(surf, 0) ThenBlock: {
                    // Blit at (cur_x, y) — glyph surface is full EM height
                    // so baseline alignment is built into the surface
                    Surface_BlitTinted(dst_surf, surf, cur_x, y, color)
                }

                // Always advance cursor, even if no surface (space character)
                cur_x = Add(cur_x, sadv)
            }
            si = Add(si, 1)
        }
        ReturnValue(cur_x)
    }
}

// =============================================================================
// MEASURE STRING WIDTH — returns pixel width without rendering
// =============================================================================
Function.VFont_MeasureWidth {
    Input: str_ptr: Integer
    Input: str_len: Integer
    Output: Integer
    Body: {
        width = 0
        si = 0
        WhileLoop LessThan(si, str_len) {
            cp = GetByte(str_ptr, si)
            gidx = VFont_FindGlyph(cp)
            IfCondition NotEqual(gidx, -1) ThenBlock: {
                off = Multiply(gidx, FontConst.GLYPH_SIZE)
                gp = Add(FontState.glyphs, off)
                t = Add(gp, FontConst.ADV_OFS)
                adv = Dereference(t)
                sadv = VFont_ScaleMetric(adv)
                width = Add(width, sadv)
            }
            si = Add(si, 1)
        }
        ReturnValue(width)
    }
}

// =============================================================================
// SHUTDOWN
// =============================================================================
Function.VFont_Shutdown {
    Body: {
        VFont_FlushCache()
        PrintMessage("[Font] shutdown\n")
        ReturnValue(0)
    }
}