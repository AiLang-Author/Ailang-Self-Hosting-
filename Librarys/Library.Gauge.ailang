// Gauge — analog 270° sweep + bar graphs.
// Face / track / needle strip are baked once. Set() is MapSpan on the
// needle. BarSet() fills a baked track. DrawBars() after Anim.DrawAll.
//
// Analog sweep is clockwise from lower-left (empty) to lower-right (full).
//
// Copyright (c) 2026 Sean Collins, 2 Paws Machine and Engineering. All rights reserved.
// Licensed under the Sean Collins Software License (SCSL v1.0).

LibraryImport.Arena
LibraryImport.Anim
LibraryImport.Display.Render.DSurfaceTypes
LibraryImport.Display.Render.DSurface
LibraryImport.Display.Render.DDrawPixel
LibraryImport.Display.Render.Framebuffer
LibraryImport.Display.Render.Fonts
LibraryImport.Display.Render.VIF
LibraryImport.SVG

FixedPool.Gauge_State {
    "ok":     Initialize=0, CanChange=True
    "surf":   Initialize=0, CanChange=True
    "face":   Initialize=-1, CanChange=True
    "needle": Initialize=-1, CanChange=True
    "x":      Initialize=0, CanChange=True
    "y":      Initialize=0, CanChange=True
    "size":   Initialize=0, CanChange=True
    "cell":   Initialize=0, CanChange=True
    "cols":   Initialize=10, CanChange=True
    "nfr":    Initialize=90, CanChange=True
    "cx":     Initialize=0, CanChange=True
    "cy":     Initialize=0, CanChange=True
    "v":      Initialize=0, CanChange=True
    "bars":   Initialize=0, CanChange=True
    "btsp":   Initialize=0, CanChange=True
    "nbar":   Initialize=0, CanChange=True
    "capb":   Initialize=16, CanChange=True
    "plots":  Initialize=0, CanChange=True
    "pbuf":   Initialize=0, CanChange=True
    "ptsp":   Initialize=0, CanChange=True
    "nplot":  Initialize=0, CanChange=True
    "capp":   Initialize=8, CanChange=True
    "pcap":   Initialize=256, CanChange=True
    "lo":     Initialize=0, CanChange=True
    "hi":     Initialize=100, CanChange=True
    "div":    Initialize=10, CanChange=True
    "dec":    Initialize=0, CanChange=True
    "svg":    Initialize=0, CanChange=True
    "svg_n":  Initialize=0, CanChange=True
    "svg_cap": Initialize=12288, CanChange=True
    "lab":    Initialize=0, CanChange=True
    "sdig":   Initialize=0, CanChange=True
    "font_ok": Initialize=0, CanChange=True
    "face_sh": Initialize=-1, CanChange=True
    "sw":     Initialize=2, CanChange=True
    "plo":    Initialize=0, CanChange=True
    "phi":    Initialize=1000, CanChange=True
    "pdiv":   Initialize=250, CanChange=True
    "pgut":   Initialize=56, CanChange=True
    "pnums":  Initialize=1, CanChange=True
    "arcs":   Initialize=0, CanChange=True
    "narc":   Initialize=0, CanChange=True
    "capa":   Initialize=8, CanChange=True
    "ndl_sh": Initialize=-1, CanChange=True
    "tint":   Initialize=0, CanChange=True
}

FixedPool.GaugeBarFlag {
    "HORIZ": Initialize=1
}

Function.Gauge.RGBA {
    Input: r: Integer
    Input: g: Integer
    Input: b: Integer
    Output: Integer
    Body: {
        c = FB_RGB(r, g, b)
        ReturnValue(BitwiseOr(c, ShiftLeft(255, 24)))
    }
}

Function.Gauge.Scale {
    Input: lo: Integer
    Input: hi: Integer
    Input: div: Integer
    Output: Integer
    Body: {
        IfCondition GreaterEqual(lo, hi) ThenBlock: { hi = Add(lo, 1) }
        IfCondition LessThan(div, 1) ThenBlock: {
            span = Subtract(hi, lo)
            div = Divide(span, 7)
            IfCondition LessThan(div, 1) ThenBlock: { div = 1 }
        }
        n = Divide(Subtract(hi, lo), div)
        IfCondition GreaterThan(n, 16) ThenBlock: {
            div = Divide(Subtract(hi, lo), 8)
            IfCondition LessThan(div, 1) ThenBlock: { div = 1 }
        }
        Gauge_State.lo = lo
        Gauge_State.hi = hi
        Gauge_State.div = div
        Gauge_State.dec = 0
        IfCondition EqualTo(div, 10) ThenBlock: { Gauge_State.dec = 1 }
        ReturnValue(div)
    }
}

Function.Gauge.SvgReset {
    Output: Integer
    Body: {
        IfCondition EqualTo(Gauge_State.svg, 0) ThenBlock: {
            Gauge_State.svg = Allocate(Gauge_State.svg_cap)
        }
        IfCondition EqualTo(Gauge_State.lab, 0) ThenBlock: {
            Gauge_State.lab = Allocate(24)
        }
        IfCondition EqualTo(Gauge_State.sdig, 0) ThenBlock: {
            Gauge_State.sdig = Allocate(24)
        }
        Gauge_State.svg_n = 0
        ReturnValue(1)
    }
}

Function.Gauge.SvgC {
    Input: c: Integer
    Output: Integer
    Body: {
        IfCondition GreaterEqual(Gauge_State.svg_n, Subtract(Gauge_State.svg_cap, 2)) ThenBlock: { ReturnValue(0) }
        SetByte(Gauge_State.svg, Gauge_State.svg_n, c)
        Gauge_State.svg_n = Add(Gauge_State.svg_n, 1)
        ReturnValue(1)
    }
}

Function.Gauge.SvgS {
    Input: s: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(s, 0) ThenBlock: { ReturnValue(0) }
        i = 0
        WhileLoop NotEqual(GetByte(s, i), 0) {
            Gauge.SvgC(GetByte(s, i))
            i = Add(i, 1)
            IfCondition GreaterThan(i, 400) ThenBlock: { ReturnValue(0) }
        }
        ReturnValue(1)
    }
}

Function.Gauge.SvgI {
    Input: n: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(n, 0) ThenBlock: {
            Gauge.SvgC(45)
            n = Subtract(0, n)
        }
        IfCondition EqualTo(n, 0) ThenBlock: {
            Gauge.SvgC(48)
            ReturnValue(1)
        }
        tmp = Gauge_State.sdig
        IfCondition EqualTo(tmp, 0) ThenBlock: {
            Gauge_State.sdig = Allocate(24)
            tmp = Gauge_State.sdig
        }
        k = 0
        WhileLoop GreaterThan(n, 0) {
            SetByte(tmp, k, Add(48, Modulo(n, 10)))
            n = Divide(n, 10)
            k = Add(k, 1)
            IfCondition GreaterThan(k, 12) ThenBlock: { n = 0 }
        }
        WhileLoop GreaterThan(k, 0) {
            k = Subtract(k, 1)
            Gauge.SvgC(GetByte(tmp, k))
        }
        ReturnValue(1)
    }
}

Function.Gauge.ItoA {
    Input: n: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(Gauge_State.lab, 0) ThenBlock: {
            Gauge_State.lab = Allocate(24)
        }
        buf = Gauge_State.lab
        IfCondition LessThan(n, 0) ThenBlock: {
            SetByte(buf, 0, 45)
            n = Subtract(0, n)
            IfCondition EqualTo(n, 0) ThenBlock: {
                SetByte(buf, 1, 48)
                SetByte(buf, 2, 0)
                ReturnValue(2)
            }
            k = 0
            WhileLoop GreaterThan(n, 0) {
                SetByte(Add(buf, 1), k, Add(48, Modulo(n, 10)))
                n = Divide(n, 10)
                k = Add(k, 1)
            }
            i = 0
            j = Subtract(k, 1)
            WhileLoop LessThan(i, j) {
                a = GetByte(Add(buf, 1), i)
                SetByte(Add(buf, 1), i, GetByte(Add(buf, 1), j))
                SetByte(Add(buf, 1), j, a)
                i = Add(i, 1)
                j = Subtract(j, 1)
            }
            SetByte(buf, Add(k, 1), 0)
            ReturnValue(Add(k, 1))
        }
        IfCondition EqualTo(n, 0) ThenBlock: {
            SetByte(buf, 0, 48)
            SetByte(buf, 1, 0)
            ReturnValue(1)
        }
        k = 0
        WhileLoop GreaterThan(n, 0) {
            SetByte(buf, k, Add(48, Modulo(n, 10)))
            n = Divide(n, 10)
            k = Add(k, 1)
        }
        i = 0
        j = Subtract(k, 1)
        WhileLoop LessThan(i, j) {
            a = GetByte(buf, i)
            SetByte(buf, i, GetByte(buf, j))
            SetByte(buf, j, a)
            i = Add(i, 1)
            j = Subtract(j, 1)
        }
        SetByte(buf, k, 0)
        ReturnValue(k)
    }
}

Function.Gauge.SvgTick {
    Input: x1: Integer
    Input: y1: Integer
    Input: x2: Integer
    Input: y2: Integer
    Output: Integer
    Body: {
        Gauge.SvgS("<line x1=\"")
        Gauge.SvgI(x1)
        Gauge.SvgS("\" y1=\"")
        Gauge.SvgI(y1)
        Gauge.SvgS("\" x2=\"")
        Gauge.SvgI(x2)
        Gauge.SvgS("\" y2=\"")
        Gauge.SvgI(y2)
        IfCondition EqualTo(Gauge_State.sw, 2) ThenBlock: {
            Gauge.SvgS("\" stroke=\"#ffffff\" stroke-width=\"2\"/>")
        }
        IfCondition EqualTo(Gauge_State.sw, 1) ThenBlock: {
            Gauge.SvgS("\" stroke=\"#7a8aaa\" stroke-width=\"1\"/>")
        }
        IfCondition EqualTo(Gauge_State.sw, 3) ThenBlock: {
            Gauge.SvgS("\" stroke=\"#cc3355\" stroke-width=\"2\"/>")
        }
        ReturnValue(1)
    }
}

Function.Gauge.Sin {
    Input: x: Integer
    Output: Integer
    Body: {
        pi = 0x400921FB54442D18
        twopi = 0x401921FB54442D18
        q = Float_ToInt(Float_Div(x, twopi))
        x = Float_Sub(x, Float_Mul(Float_FromInt(q), twopi))
        i = 0
        WhileLoop LessThan(i, 4) {
            IfCondition EqualTo(Float_Le(pi, x), 1) ThenBlock: { x = Float_Sub(x, twopi) }
            IfCondition EqualTo(Float_Le(x, Float_Sub(0, pi)), 1) ThenBlock: { x = Float_Add(x, twopi) }
            i = Add(i, 1)
        }
        x2 = Float_Mul(x, x)
        t = x
        s = x
        t = Float_Div(Float_Mul(t, x2), 0x4018000000000000)
        s = Float_Sub(s, t)
        t = Float_Div(Float_Mul(t, x2), 0x4034000000000000)
        s = Float_Add(s, t)
        t = Float_Div(Float_Mul(t, x2), 0x4045000000000000)
        s = Float_Sub(s, t)
        t = Float_Div(Float_Mul(t, x2), 0x4052000000000000)
        s = Float_Add(s, t)
        ReturnValue(s)
    }
}

Function.Gauge.Cos {
    Input: x: Integer
    Output: Integer
    Body: {
        ReturnValue(Gauge.Sin(Float_Add(x, 0x3FF921FB54442D18)))
    }
}

Function.Gauge.SweepRad {
    Input: i: Integer
    Input: n: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(n, 2) ThenBlock: { n = 2 }
        IfCondition LessThan(i, 0) ThenBlock: { i = 0 }
        last = Subtract(n, 1)
        IfCondition GreaterThan(i, last) ThenBlock: { i = last }
        d2r = Float_Div(0x400921FB54442D18, Float_FromInt(180))
        a0 = Float_Mul(d2r, Float_FromInt(225))
        sw = Float_Mul(d2r, Float_FromInt(270))
        t = Float_Div(Float_FromInt(i), Float_FromInt(last))
        ReturnValue(Float_Sub(a0, Float_Mul(t, sw)))
    }
}

Function.Gauge.Put {
    Input: x: Integer
    Input: y: Integer
    Input: color: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(Gauge_State.surf, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Surface_InBounds(Gauge_State.surf, x, y), 0) ThenBlock: { ReturnValue(0) }
        DPix_PutPixel(Gauge_State.surf, x, y, color)
        ReturnValue(1)
    }
}

Function.Gauge.HLine {
    Input: x0: Integer
    Input: x1: Integer
    Input: y: Integer
    Input: color: Integer
    Output: Integer
    Body: {
        IfCondition GreaterThan(x0, x1) ThenBlock: {
            t = x0
            x0 = x1
            x1 = t
        }
        x = x0
        WhileLoop LessEqual(x, x1) {
            Gauge.Put(x, y, color)
            x = Add(x, 1)
        }
        ReturnValue(0)
    }
}

Function.Gauge.Disk {
    Input: cx: Integer
    Input: cy: Integer
    Input: r: Integer
    Input: color: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(r, 1) ThenBlock: { ReturnValue(0) }
        x = r
        y = 0
        err = Subtract(1, r)
        WhileLoop GreaterEqual(x, y) {
            Gauge.HLine(Subtract(cx, x), Add(cx, x), Add(cy, y), color)
            Gauge.HLine(Subtract(cx, x), Add(cx, x), Subtract(cy, y), color)
            Gauge.HLine(Subtract(cx, y), Add(cx, y), Add(cy, x), color)
            Gauge.HLine(Subtract(cx, y), Add(cx, y), Subtract(cy, x), color)
            y = Add(y, 1)
            IfCondition LessEqual(err, 0) ThenBlock: {
                err = Add(err, Add(Multiply(2, y), 1))
            } ElseBlock: {
                x = Subtract(x, 1)
                err = Add(err, Add(Multiply(2, Subtract(y, x)), 1))
            }
        }
        ReturnValue(0)
    }
}

Function.Gauge.Line {
    Input: x0: Integer
    Input: y0: Integer
    Input: x1: Integer
    Input: y1: Integer
    Input: color: Integer
    Output: Integer
    Body: {
        dx = Subtract(x1, x0)
        IfCondition LessThan(dx, 0) ThenBlock: { dx = Subtract(0, dx) }
        dy = Subtract(y1, y0)
        IfCondition LessThan(dy, 0) ThenBlock: { dy = Subtract(0, dy) }
        sx = 1
        IfCondition GreaterThan(x0, x1) ThenBlock: { sx = Subtract(0, 1) }
        sy = 1
        IfCondition GreaterThan(y0, y1) ThenBlock: { sy = Subtract(0, 1) }
        err = Subtract(dx, dy)
        x = x0
        y = y0
        more = 1
        WhileLoop EqualTo(more, 1) {
            Gauge.Put(x, y, color)
            IfCondition EqualTo(x, x1) ThenBlock: {
                IfCondition EqualTo(y, y1) ThenBlock: { more = 0 }
            }
            IfCondition EqualTo(more, 1) ThenBlock: {
                e2 = Multiply(err, 2)
                IfCondition GreaterThan(e2, Subtract(0, dy)) ThenBlock: {
                    err = Subtract(err, dy)
                    x = Add(x, sx)
                }
                IfCondition LessThan(e2, dx) ThenBlock: {
                    err = Add(err, dx)
                    y = Add(y, sy)
                }
            }
        }
        ReturnValue(0)
    }
}

Function.Gauge.Spoke {
    Input: i: Integer
    Input: n: Integer
    Input: r0: Integer
    Input: r1: Integer
    Input: color: Integer
    Output: Integer
    Body: {
        a = Gauge.SweepRad(i, n)
        c = Gauge.Cos(a)
        s = Gauge.Sin(a)
        cx = Gauge_State.cx
        cy = Gauge_State.cy
        x0 = Add(cx, Float_ToInt(Float_Mul(c, Float_FromInt(r0))))
        y0 = Subtract(cy, Float_ToInt(Float_Mul(s, Float_FromInt(r0))))
        x1 = Add(cx, Float_ToInt(Float_Mul(c, Float_FromInt(r1))))
        y1 = Subtract(cy, Float_ToInt(Float_Mul(s, Float_FromInt(r1))))
        Gauge.Line(x0, y0, x1, y1, color)
        Gauge.Line(Add(x0, 1), y0, Add(x1, 1), y1, color)
        ReturnValue(0)
    }
}

Function.Gauge.ValRad {
    Input: v: Integer
    Output: Integer
    Body: {
        lo = Gauge_State.lo
        hi = Gauge_State.hi
        span = Subtract(hi, lo)
        IfCondition LessThan(span, 1) ThenBlock: { span = 1 }
        t = Subtract(v, lo)
        IfCondition LessThan(t, 0) ThenBlock: { t = 0 }
        IfCondition GreaterThan(t, span) ThenBlock: { t = span }
        d2r = Float_Div(0x400921FB54442D18, Float_FromInt(180))
        a0 = Float_Mul(d2r, Float_FromInt(225))
        sw = Float_Mul(d2r, Float_FromInt(270))
        tf = Float_Div(Float_FromInt(t), Float_FromInt(span))
        ReturnValue(Float_Sub(a0, Float_Mul(tf, sw)))
    }
}

Function.Gauge.FaceFont {
    Input: sz: Integer
    Input: den: Integer
    Input: lo: Integer
    Input: hi: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(den, 1) ThenBlock: { den = 1 }
        fs = Divide(sz, den)
        IfCondition LessThan(fs, lo) ThenBlock: { fs = lo }
        IfCondition GreaterThan(fs, hi) ThenBlock: { fs = hi }
        q = Multiply(Divide(fs, 2), 2)
        IfCondition LessThan(q, lo) ThenBlock: { q = lo }
        ReturnValue(q)
    }
}

Function.Gauge.StampLabels {
    Input: surf: Integer
    Input: sz: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(Gauge_State.font_ok, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(surf, 0) ThenBlock: { ReturnValue(0) }
        fs = Gauge.FaceFont(sz, 12, 8, 22)
        VFont_UseSize(fs)
        lo = Gauge_State.lo
        hi = Gauge_State.hi
        div = Gauge_State.div
        IfCondition LessThan(div, 1) ThenBlock: { div = 1 }
        ink = FB_RGB(255, 255, 255)
        v = lo
        WhileLoop LessEqual(v, hi) {
            a = Gauge.ValRad(v)
            c = Gauge.Cos(a)
            s = Gauge.Sin(a)
            lx = Add(128, Float_ToInt(Float_Mul(c, Float_FromInt(76))))
            ly = Subtract(128, Float_ToInt(Float_Mul(s, Float_FromInt(76))))
            px = Divide(Multiply(lx, sz), 256)
            py = Divide(Multiply(ly, sz), 256)
            labv = v
            IfCondition GreaterThan(div, 1) ThenBlock: { labv = Divide(v, div) }
            ln = Gauge.ItoA(labv)
            mw = VFont_MeasureWidth(Gauge_State.lab, ln)
            VFont_DrawString(surf, Gauge_State.lab, ln, Subtract(px, Divide(mw, 2)), Subtract(py, Divide(fs, 3)), ink)
            v = Add(v, div)
        }
        ReturnValue(1)
    }
}

Function.Gauge.RenderFace {
    Output: Integer
    Body: {
        sz = Gauge_State.size
        IfCondition LessThan(sz, 48) ThenBlock: { sz = 48 }
        surf = Surface_Create(SurfaceFormat.PIXEL_32, sz, sz)
        IfCondition EqualTo(surf, 0) ThenBlock: { ReturnValue(0) }
        Gauge_State.surf = surf
        Gauge_State.cx = Divide(sz, 2)
        Gauge_State.cy = Divide(sz, 2)
        lo = Gauge_State.lo
        hi = Gauge_State.hi
        div = Gauge_State.div
        IfCondition LessThan(div, 1) ThenBlock: { div = 10 }
        minor = div
        IfCondition GreaterEqual(div, 10) ThenBlock: { minor = Divide(div, 10) }
        IfCondition LessThan(minor, 1) ThenBlock: { minor = 1 }
        Gauge.SvgReset()
        Gauge.SvgS("<svg viewBox=\"0 0 256 256\">")
        Gauge.SvgS("<circle cx=\"128\" cy=\"128\" r=\"124\" fill=\"#7a8496\"/>")
        Gauge.SvgS("<circle cx=\"128\" cy=\"128\" r=\"118\" fill=\"#0a1020\"/>")
        Gauge.SvgS("<circle cx=\"128\" cy=\"128\" r=\"108\" fill=\"#0e1730\"/>")
        v = lo
        warn = Subtract(hi, Divide(Subtract(hi, lo), 10))
        WhileLoop LessEqual(v, hi) {
            a = Gauge.ValRad(v)
            c = Gauge.Cos(a)
            s = Gauge.Sin(a)
            maj = EqualTo(Modulo(Subtract(v, lo), div), 0)
            r0 = 100
            r1 = 112
            Gauge_State.sw = 1
            IfCondition EqualTo(maj, 1) ThenBlock: {
                r0 = 92
                r1 = 116
                Gauge_State.sw = 2
                IfCondition GreaterEqual(v, warn) ThenBlock: { Gauge_State.sw = 3 }
            }
            x0 = Add(128, Float_ToInt(Float_Mul(c, Float_FromInt(r0))))
            y0 = Subtract(128, Float_ToInt(Float_Mul(s, Float_FromInt(r0))))
            x1 = Add(128, Float_ToInt(Float_Mul(c, Float_FromInt(r1))))
            y1 = Subtract(128, Float_ToInt(Float_Mul(s, Float_FromInt(r1))))
            Gauge.SvgTick(x0, y0, x1, y1)
            v = Add(v, minor)
        }
        Gauge.SvgS("<circle cx=\"128\" cy=\"128\" r=\"16\" fill=\"#7a8496\"/>")
        Gauge.SvgS("<circle cx=\"128\" cy=\"128\" r=\"12\" fill=\"#2ad4ff\"/>")
        Gauge.SvgS("<circle cx=\"128\" cy=\"128\" r=\"4\" fill=\"#ffffff\"/>")
        Gauge.SvgS("</svg>")
        SetByte(Gauge_State.svg, Gauge_State.svg_n, 0)
        SVG_Render(Gauge_State.svg, Gauge_State.svg_n, surf, sz, sz)
        Gauge.StampLabels(surf, sz)
        ReturnValue(surf)
    }
}

Function.Gauge.BakeFace {
    Output: Integer
    Body: {
        surf = Gauge.RenderFace()
        IfCondition EqualTo(surf, 0) ThenBlock: { ReturnValue(-1) }
        sh = Anim.AddSurf(surf)
        IfCondition LessThan(sh, 0) ThenBlock: { ReturnValue(-1) }
        Gauge_State.face_sh = sh
        cl = Anim.Clip(sh, 0, 0, 0)
        sp = Anim.Spawn(cl, Gauge_State.x, Gauge_State.y)
        Anim.Play(sp, 0)
        Gauge_State.face = sp
        ReturnValue(0)
    }
}

Function.Gauge.Resize {
    Input: size: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(size, 48) ThenBlock: { size = 48 }
        d = Subtract(size, Gauge_State.size)
        IfCondition LessThan(d, 0) ThenBlock: { d = Subtract(0, d) }
        IfCondition LessThan(d, 12) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(Gauge_State.face_sh, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition EqualTo(Gauge_State.svg, 0) ThenBlock: { ReturnValue(-1) }
        Gauge_State.size = size
        Gauge_State.cell = size
        surf = Surface_Create(SurfaceFormat.PIXEL_32, size, size)
        IfCondition EqualTo(surf, 0) ThenBlock: { ReturnValue(-1) }
        fs = Gauge.FaceFont(size, 8, 8, 32)
        IfCondition EqualTo(Gauge_State.font_ok, 1) ThenBlock: {
            inst = VFont_UseSize(fs)
            SVGTextState.font_inst = inst
        }
        SVG_Render(Gauge_State.svg, Gauge_State.svg_n, surf, size, size)
        Gauge.StampLabels(surf, size)
        sh = Gauge_State.face_sh
        Anim.WSet(Anim_State.sheets, sh, 0, surf)
        Anim.WSet(Anim_State.sheets, sh, 1, size)
        Anim.WSet(Anim_State.sheets, sh, 2, size)
        Anim.WSet(Anim_State.sheets, sh, 5, size)
        Anim.WSet(Anim_State.sheets, sh, 6, size)
        ReturnValue(1)
    }
}

Function.Gauge.RenderNeedle {
    Output: Integer
    Body: {
        nfr = Gauge_State.nfr
        cols = Gauge_State.cols
        cell = Gauge_State.cell
        IfCondition LessThan(nfr, 1) ThenBlock: { nfr = 90 }
        IfCondition LessThan(cols, 1) ThenBlock: { cols = 10 }
        IfCondition LessThan(cell, 48) ThenBlock: { cell = 48 }
        rows = Divide(Add(nfr, Subtract(cols, 1)), cols)
        surf = Surface_Create(SurfaceFormat.PIXEL_32, Multiply(cols, cell), Multiply(rows, cell))
        IfCondition EqualTo(surf, 0) ThenBlock: { ReturnValue(0) }
        Gauge_State.surf = surf
        cyan = Gauge.RGBA(42, 212, 255)
        ink = Gauge.RGBA(255, 255, 255)
        len = Divide(Multiply(cell, 38), 100)
        tail = Divide(cell, 10)
        half = Divide(cell, 2)
        i = 0
        WhileLoop LessThan(i, nfr) {
            col = Modulo(i, cols)
            row = Divide(i, cols)
            ox = Multiply(col, cell)
            oy = Multiply(row, cell)
            cx = Add(ox, half)
            cy = Add(oy, half)
            a = Gauge.SweepRad(i, nfr)
            c = Gauge.Cos(a)
            s = Gauge.Sin(a)
            x1 = Add(cx, Float_ToInt(Float_Mul(c, Float_FromInt(len))))
            y1 = Subtract(cy, Float_ToInt(Float_Mul(s, Float_FromInt(len))))
            x0 = Subtract(cx, Float_ToInt(Float_Mul(c, Float_FromInt(tail))))
            y0 = Add(cy, Float_ToInt(Float_Mul(s, Float_FromInt(tail))))
            Gauge.Line(x0, y0, x1, y1, cyan)
            Gauge.Line(Add(x0, 1), y0, Add(x1, 1), y1, cyan)
            Gauge.Line(x0, Add(y0, 1), x1, Add(y1, 1), ink)
            i = Add(i, 1)
        }
        ReturnValue(surf)
    }
}

Function.Gauge.BakeNeedle {
    Output: Integer
    Body: {
        surf = Gauge.RenderNeedle()
        IfCondition EqualTo(surf, 0) ThenBlock: { ReturnValue(-1) }
        nfr = Gauge_State.nfr
        cols = Gauge_State.cols
        cell = Gauge_State.cell
        IfCondition LessThan(nfr, 1) ThenBlock: { nfr = 90 }
        IfCondition LessThan(cols, 1) ThenBlock: { cols = 10 }
        rows = Divide(Add(nfr, Subtract(cols, 1)), cols)
        half = Divide(cell, 2)
        sh = Anim.AddSurf(surf)
        IfCondition LessThan(sh, 0) ThenBlock: { ReturnValue(-1) }
        Gauge_State.ndl_sh = sh
        Anim.Grid(sh, cols, rows)
        cl = Anim.Clip(sh, 0, Subtract(nfr, 1), 0)
        fx = Add(Gauge_State.x, Divide(Gauge_State.size, 2))
        fy = Add(Gauge_State.y, Divide(Gauge_State.size, 2))
        sp = Anim.Spawn(cl, fx, fy)
        Anim.Play(sp, 0)
        Anim.Hot(sp, half, half)
        Gauge_State.needle = sp
        ReturnValue(0)
    }
}

Function.Gauge.Init {
    Output: Integer
    Body: {
        IfCondition EqualTo(Gauge_State.ok, 1) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(Anim.Init(), 0) ThenBlock: { ReturnValue(0) }
        VFont_Init()
        fok = VFont_LoadVIF("fonts/DejaVuSans.vif")
        IfCondition EqualTo(fok, 0) ThenBlock: {
            fok = VFont_LoadVIF("fonts/AlteixSans.vif")
        }
        IfCondition NotEqual(fok, 0) ThenBlock: {
            VFont_UseSize(13)
            Gauge_State.font_ok = 1
        }
        Gauge.Scale(0, 100, 10)
        Gauge_State.capb = 16
        Gauge_State.bars = Allocate(1024)
        Gauge_State.btsp = Allocate(128)
        Gauge_State.nbar = 0
        Gauge_State.capp = 16
        Gauge_State.pcap = 256
        Gauge_State.plots = Allocate(1024)
        Gauge_State.pbuf = Allocate(128)
        Gauge_State.ptsp = Allocate(128)
        Gauge_State.nplot = 0
        Gauge_State.capa = 16
        Gauge_State.arcs = Allocate(1024)
        Gauge_State.narc = 0
        Gauge_State.ok = 1
        ReturnValue(1)
    }
}

Function.Gauge.AWSet {
    Input: idx: Integer
    Input: f: Integer
    Input: v: Integer
    Output: Integer
    Body: {
        StoreValue(Add(Gauge_State.arcs, Add(Multiply(idx, 64), Multiply(f, 8))), v)
        ReturnValue(0)
    }
}

Function.Gauge.AWGet {
    Input: idx: Integer
    Input: f: Integer
    Output: Integer
    Body: {
        ReturnValue(Dereference(Add(Gauge_State.arcs, Add(Multiply(idx, 64), Multiply(f, 8)))))
    }
}

Function.Gauge.Arc {
    Input: x: Integer
    Input: y: Integer
    Input: size: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(Gauge.Init(), 0) ThenBlock: { ReturnValue(-1) }
        IfCondition LessThan(size, 48) ThenBlock: { size = 48 }
        i = Gauge_State.narc
        IfCondition GreaterEqual(i, Gauge_State.capa) ThenBlock: { ReturnValue(-1) }
        Gauge_State.x = x
        Gauge_State.y = y
        Gauge_State.size = size
        Gauge_State.cell = size
        Gauge_State.cols = 10
        Gauge_State.nfr = 90
        IfCondition NotEqual(Gauge.BakeFace(), 0) ThenBlock: { ReturnValue(-2) }
        IfCondition NotEqual(Gauge.BakeNeedle(), 0) ThenBlock: { ReturnValue(-3) }
        Gauge.AWSet(i, 0, x)
        Gauge.AWSet(i, 1, y)
        Gauge.AWSet(i, 2, size)
        Gauge.AWSet(i, 3, Gauge_State.face)
        Gauge.AWSet(i, 4, Gauge_State.needle)
        Gauge.AWSet(i, 5, Gauge_State.face_sh)
        Gauge.AWSet(i, 6, 0)
        Gauge.AWSet(i, 7, Gauge_State.ndl_sh)
        Gauge_State.narc = Add(i, 1)
        ReturnValue(i)
    }
}

Function.Gauge.ArcSet {
    Input: id: Integer
    Input: v: Integer
    Input: lo: Integer
    Input: hi: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(id, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition GreaterEqual(id, Gauge_State.narc) ThenBlock: { ReturnValue(-1) }
        Gauge.AWSet(id, 6, v)
        nd = Gauge.AWGet(id, 4)
        IfCondition LessThan(nd, 0) ThenBlock: { ReturnValue(-1) }
        ReturnValue(Anim.MapSpan(nd, v, lo, hi))
    }
}

Function.Gauge.ArcMove {
    Input: id: Integer
    Input: x: Integer
    Input: y: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(id, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition GreaterEqual(id, Gauge_State.narc) ThenBlock: { ReturnValue(-1) }
        Gauge.AWSet(id, 0, x)
        Gauge.AWSet(id, 1, y)
        sz = Gauge.AWGet(id, 2)
        fc = Gauge.AWGet(id, 3)
        nd = Gauge.AWGet(id, 4)
        IfCondition GreaterEqual(fc, 0) ThenBlock: { Anim.Place(fc, x, y) }
        IfCondition GreaterEqual(nd, 0) ThenBlock: {
            Anim.Place(nd, Add(x, Divide(sz, 2)), Add(y, Divide(sz, 2)))
        }
        ReturnValue(0)
    }
}

Function.Gauge.ArcResize {
    Input: id: Integer
    Input: size: Integer
    Input: lo: Integer
    Input: hi: Integer
    Input: div: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(id, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition GreaterEqual(id, Gauge_State.narc) ThenBlock: { ReturnValue(-1) }
        IfCondition LessThan(size, 48) ThenBlock: { size = 48 }
        old = Gauge.AWGet(id, 2)
        d = Subtract(size, old)
        IfCondition LessThan(d, 0) ThenBlock: { d = Subtract(0, d) }
        IfCondition LessThan(d, 12) ThenBlock: { ReturnValue(0) }
        Gauge.Scale(lo, hi, div)
        x = Gauge.AWGet(id, 0)
        y = Gauge.AWGet(id, 1)
        Gauge_State.x = x
        Gauge_State.y = y
        Gauge_State.size = size
        Gauge_State.cell = size
        Gauge.AWSet(id, 2, size)
        fsh = Gauge.AWGet(id, 5)
        nsh = Gauge.AWGet(id, 7)
        fc = Gauge.AWGet(id, 3)
        nd = Gauge.AWGet(id, 4)
        fsurf = Gauge.RenderFace()
        IfCondition EqualTo(fsurf, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition GreaterEqual(fsh, 0) ThenBlock: {
            Anim.SetSurf(fsh, fsurf)
            Gauge_State.face_sh = fsh
            Gauge_State.face = fc
        }
        IfCondition LessThan(fsh, 0) ThenBlock: {
            fsh = Anim.AddSurf(fsurf)
            IfCondition LessThan(fsh, 0) ThenBlock: { ReturnValue(-2) }
            cl = Anim.Clip(fsh, 0, 0, 0)
            fc = Anim.Spawn(cl, x, y)
            Anim.Play(fc, 0)
            Gauge_State.face_sh = fsh
            Gauge_State.face = fc
        }
        nsurf = Gauge.RenderNeedle()
        IfCondition EqualTo(nsurf, 0) ThenBlock: { ReturnValue(-1) }
        cols = Gauge_State.cols
        nfr = Gauge_State.nfr
        IfCondition LessThan(cols, 1) ThenBlock: { cols = 10 }
        IfCondition LessThan(nfr, 1) ThenBlock: { nfr = 90 }
        rows = Divide(Add(nfr, Subtract(cols, 1)), cols)
        half = Divide(size, 2)
        IfCondition GreaterEqual(nsh, 0) ThenBlock: {
            Anim.SetSurf(nsh, nsurf)
            Anim.Grid(nsh, cols, rows)
            Gauge_State.ndl_sh = nsh
            Gauge_State.needle = nd
        }
        IfCondition LessThan(nsh, 0) ThenBlock: {
            nsh = Anim.AddSurf(nsurf)
            IfCondition LessThan(nsh, 0) ThenBlock: { ReturnValue(-3) }
            Anim.Grid(nsh, cols, rows)
            ncl = Anim.Clip(nsh, 0, Subtract(nfr, 1), 0)
            nd = Anim.Spawn(ncl, Add(x, half), Add(y, half))
            Anim.Play(nd, 0)
            Anim.Hot(nd, half, half)
            Gauge_State.ndl_sh = nsh
            Gauge_State.needle = nd
        }
        IfCondition GreaterEqual(fc, 0) ThenBlock: { Anim.Show(fc, 1) }
        IfCondition GreaterEqual(nd, 0) ThenBlock: {
            Anim.Show(nd, 1)
            Anim.Hot(nd, half, half)
        }
        Gauge.AWSet(id, 3, fc)
        Gauge.AWSet(id, 4, nd)
        Gauge.AWSet(id, 5, fsh)
        Gauge.AWSet(id, 7, nsh)
        ReturnValue(1)
    }
}

Function.Gauge.Make {
    Input: x: Integer
    Input: y: Integer
    Input: size: Integer
    Output: Integer
    Body: {
        id = Gauge.Arc(x, y, size)
        IfCondition LessThan(id, 0) ThenBlock: { ReturnValue(id) }
        ReturnValue(0)
    }
}

Function.Gauge.Set {
    Input: v: Integer
    Input: lo: Integer
    Input: hi: Integer
    Output: Integer
    Body: {
        Gauge_State.v = v
        IfCondition LessThan(Gauge_State.narc, 1) ThenBlock: {
            IfCondition LessThan(Gauge_State.needle, 0) ThenBlock: { ReturnValue(-1) }
            ReturnValue(Anim.MapSpan(Gauge_State.needle, v, lo, hi))
        }
        ReturnValue(Gauge.ArcSet(0, v, lo, hi))
    }
}

Function.Gauge.Value {
    Output: Integer
    Body: { ReturnValue(Gauge_State.v) }
}

Function.Gauge.Move {
    Input: x: Integer
    Input: y: Integer
    Output: Integer
    Body: {
        IfCondition GreaterThan(Gauge_State.narc, 0) ThenBlock: {
            ReturnValue(Gauge.ArcMove(0, x, y))
        }
        Gauge_State.x = x
        Gauge_State.y = y
        IfCondition GreaterEqual(Gauge_State.face, 0) ThenBlock: {
            Anim.Place(Gauge_State.face, x, y)
        }
        IfCondition GreaterEqual(Gauge_State.needle, 0) ThenBlock: {
            Anim.Place(Gauge_State.needle, Add(x, Divide(Gauge_State.size, 2)), Add(y, Divide(Gauge_State.size, 2)))
        }
        ReturnValue(0)
    }
}

Function.Gauge.Fmt {
    Input: v: Integer
    Input: dec: Integer
    Output: Integer
    Body: {
        neg = 0
        IfCondition LessThan(v, 0) ThenBlock: {
            neg = 1
            v = Subtract(0, v)
        }
        IfCondition LessThan(dec, 1) ThenBlock: {
            n1 = Gauge.ItoA(v)
            IfCondition EqualTo(neg, 0) ThenBlock: { ReturnValue(n1) }
            buf = Gauge_State.lab
            i = n1
            WhileLoop GreaterEqual(i, 0) {
                SetByte(buf, Add(i, 1), GetByte(buf, i))
                i = Subtract(i, 1)
            }
            SetByte(buf, 0, 45)
            ReturnValue(Add(n1, 1))
        }
        scale = 10
        IfCondition GreaterThan(dec, 1) ThenBlock: { scale = 100 }
        ip = Divide(v, scale)
        fr = Modulo(v, scale)
        n1 = Gauge.ItoA(ip)
        buf = Gauge_State.lab
        SetByte(buf, n1, 46)
        n = Add(n1, 2)
        IfCondition GreaterThan(dec, 1) ThenBlock: {
            SetByte(buf, Add(n1, 1), Add(48, Divide(fr, 10)))
            SetByte(buf, Add(n1, 2), Add(48, Modulo(fr, 10)))
            SetByte(buf, Add(n1, 3), 0)
            n = Add(n1, 3)
        }
        IfCondition LessThan(dec, 2) ThenBlock: {
            SetByte(buf, Add(n1, 1), Add(48, fr))
            SetByte(buf, Add(n1, 2), 0)
            n = Add(n1, 2)
        }
        IfCondition EqualTo(neg, 0) ThenBlock: { ReturnValue(n) }
        i = n
        WhileLoop GreaterEqual(i, 0) {
            SetByte(buf, Add(i, 1), GetByte(buf, i))
            i = Subtract(i, 1)
        }
        SetByte(buf, 0, 45)
        ReturnValue(Add(n, 1))
    }
}

Function.Gauge.DrawOneReadout {
    Input: x: Integer
    Input: y: Integer
    Input: sz: Integer
    Input: v: Integer
    Input: dec: Integer
    Output: Integer
    Body: {
        Anim.BindFB()
        dest = Anim.Dest()
        IfCondition EqualTo(dest, 0) ThenBlock: { ReturnValue(0) }
        fs = Gauge.FaceFont(sz, 8, 8, 32)
        IfCondition EqualTo(Gauge_State.font_ok, 1) ThenBlock: {
            VFont_UseSize(fs)
        }
        n1 = Gauge.Fmt(v, dec)
        mw = Multiply(n1, 8)
        IfCondition EqualTo(Gauge_State.font_ok, 1) ThenBlock: {
            mw = VFont_MeasureWidth(Gauge_State.lab, n1)
        }
        IfCondition GreaterThan(mw, Divide(sz, 2)) ThenBlock: { mw = Divide(sz, 3) }
        cx = Add(x, Divide(sz, 2))
        cy = Add(y, Divide(Multiply(sz, 58), 100))
        ink = FB_RGB(42, 212, 255)
        IfCondition EqualTo(Gauge_State.font_ok, 1) ThenBlock: {
            VFont_DrawString(dest, Gauge_State.lab, n1, Subtract(cx, Divide(mw, 2)), cy, ink)
            ReturnValue(1)
        }
        FB_DrawNumber(Subtract(cx, Divide(Multiply(n1, 8), 2)), cy, v, ink, FB_RGB(10, 16, 32))
        ReturnValue(1)
    }
}

Function.Gauge.DrawReadout {
    Output: Integer
    Body: {
        IfCondition GreaterThan(Gauge_State.narc, 0) ThenBlock: {
            i = 0
            WhileLoop LessThan(i, Gauge_State.narc) {
                Gauge.DrawOneReadout(Gauge.AWGet(i, 0), Gauge.AWGet(i, 1), Gauge.AWGet(i, 2), Gauge.AWGet(i, 6), Gauge_State.dec)
                i = Add(i, 1)
            }
            ReturnValue(Gauge_State.narc)
        }
        IfCondition LessThan(Gauge_State.face, 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(Gauge.DrawOneReadout(Gauge_State.x, Gauge_State.y, Gauge_State.size, Gauge_State.v, Gauge_State.dec))
    }
}

Function.Gauge.BWSet {
    Input: idx: Integer
    Input: f: Integer
    Input: v: Integer
    Output: Integer
    Body: {
        StoreValue(Add(Gauge_State.bars, Add(Multiply(idx, 64), Multiply(f, 8))), v)
        ReturnValue(0)
    }
}

Function.Gauge.BWGet {
    Input: idx: Integer
    Input: f: Integer
    Output: Integer
    Body: {
        ReturnValue(Dereference(Add(Gauge_State.bars, Add(Multiply(idx, 64), Multiply(f, 8)))))
    }
}

Function.Gauge.BakeTrack {
    Input: w: Integer
    Input: h: Integer
    Input: horiz: Integer
    Output: Integer
    Body: {
        surf = Surface_Create(SurfaceFormat.PIXEL_32, w, h)
        IfCondition EqualTo(surf, 0) ThenBlock: { ReturnValue(0) }
        steel = Gauge.RGBA(122, 132, 150)
        abyss = Gauge.RGBA(10, 16, 32)
        dim = Gauge.RGBA(80, 92, 112)
        Draw_Pix_FillRect(surf, 0, 0, w, h, steel)
        Draw_Pix_FillRect(surf, 3, 3, Subtract(w, 6), Subtract(h, 6), abyss)
        Gauge_State.surf = surf
        IfCondition EqualTo(horiz, 0) ThenBlock: {
            i = 0
            WhileLoop LessEqual(i, 10) {
                yy = Add(4, Divide(Multiply(Subtract(10, i), Subtract(h, 10)), 10))
                tw = 5
                IfCondition EqualTo(Modulo(i, 5), 0) ThenBlock: { tw = 9 }
                Gauge.HLine(Subtract(Subtract(w, 4), tw), Subtract(w, 5), yy, dim)
                i = Add(i, 1)
            }
        }
        IfCondition EqualTo(horiz, 1) ThenBlock: {
            i = 0
            WhileLoop LessEqual(i, 10) {
                xx = Add(4, Divide(Multiply(i, Subtract(w, 10)), 10))
                th = 5
                IfCondition EqualTo(Modulo(i, 5), 0) ThenBlock: { th = 9 }
                Gauge.Line(xx, Subtract(Subtract(h, 4), th), xx, Subtract(h, 5), dim)
                i = Add(i, 1)
            }
        }
        ReturnValue(surf)
    }
}

Function.Gauge.Bar {
    Input: x: Integer
    Input: y: Integer
    Input: w: Integer
    Input: h: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(Gauge.Init(), 0) ThenBlock: { ReturnValue(-1) }
        IfCondition LessThan(w, 12) ThenBlock: { w = 12 }
        IfCondition LessThan(h, 12) ThenBlock: { h = 12 }
        i = Gauge_State.nbar
        IfCondition GreaterEqual(i, Gauge_State.capb) ThenBlock: { ReturnValue(-1) }
        surf = Gauge.BakeTrack(w, h, 0)
        IfCondition EqualTo(surf, 0) ThenBlock: { ReturnValue(-1) }
        sh = Anim.AddSurf(surf)
        cl = Anim.Clip(sh, 0, 0, 0)
        sp = Anim.Spawn(cl, x, y)
        Anim.Play(sp, 0)
        Gauge.BWSet(i, 0, x)
        Gauge.BWSet(i, 1, y)
        Gauge.BWSet(i, 2, w)
        Gauge.BWSet(i, 3, h)
        Gauge.BWSet(i, 4, 0)
        Gauge.BWSet(i, 5, 0)
        Gauge.BWSet(i, 6, 0)
        Gauge.BWSet(i, 7, 1000)
        StoreValue(Add(Gauge_State.btsp, Multiply(i, 8)), sp)
        Gauge_State.nbar = Add(i, 1)
        ReturnValue(i)
    }
}

Function.Gauge.BarH {
    Input: x: Integer
    Input: y: Integer
    Input: w: Integer
    Input: h: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(Gauge.Init(), 0) ThenBlock: { ReturnValue(-1) }
        IfCondition LessThan(w, 12) ThenBlock: { w = 12 }
        IfCondition LessThan(h, 12) ThenBlock: { h = 12 }
        i = Gauge_State.nbar
        IfCondition GreaterEqual(i, Gauge_State.capb) ThenBlock: { ReturnValue(-1) }
        surf = Gauge.BakeTrack(w, h, 1)
        IfCondition EqualTo(surf, 0) ThenBlock: { ReturnValue(-1) }
        sh = Anim.AddSurf(surf)
        cl = Anim.Clip(sh, 0, 0, 0)
        sp = Anim.Spawn(cl, x, y)
        Anim.Play(sp, 0)
        Gauge.BWSet(i, 0, x)
        Gauge.BWSet(i, 1, y)
        Gauge.BWSet(i, 2, w)
        Gauge.BWSet(i, 3, h)
        Gauge.BWSet(i, 4, GaugeBarFlag.HORIZ)
        Gauge.BWSet(i, 5, 0)
        Gauge.BWSet(i, 6, 0)
        Gauge.BWSet(i, 7, 1000)
        StoreValue(Add(Gauge_State.btsp, Multiply(i, 8)), sp)
        Gauge_State.nbar = Add(i, 1)
        ReturnValue(i)
    }
}

Function.Gauge.BarSet {
    Input: id: Integer
    Input: v: Integer
    Input: lo: Integer
    Input: hi: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(id, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition GreaterEqual(id, Gauge_State.nbar) ThenBlock: { ReturnValue(-1) }
        Gauge.BWSet(id, 5, v)
        Gauge.BWSet(id, 6, lo)
        Gauge.BWSet(id, 7, hi)
        ReturnValue(0)
    }
}

Function.Gauge.BarMove {
    Input: id: Integer
    Input: x: Integer
    Input: y: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(id, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition GreaterEqual(id, Gauge_State.nbar) ThenBlock: { ReturnValue(-1) }
        Gauge.BWSet(id, 0, x)
        Gauge.BWSet(id, 1, y)
        sp = Dereference(Add(Gauge_State.btsp, Multiply(id, 8)))
        Anim.Place(sp, x, y)
        ReturnValue(0)
    }
}

Function.Gauge.DrawBarOne {
    Input: i: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(i, 0) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterEqual(i, Gauge_State.nbar) ThenBlock: { ReturnValue(0) }
        cyan = FB_RGB(42, 212, 255)
        red = FB_RGB(204, 51, 85)
        x = Gauge.BWGet(i, 0)
        y = Gauge.BWGet(i, 1)
        w = Gauge.BWGet(i, 2)
        h = Gauge.BWGet(i, 3)
        fl = Gauge.BWGet(i, 4)
        v = Gauge.BWGet(i, 5)
        lo = Gauge.BWGet(i, 6)
        hi = Gauge.BWGet(i, 7)
        pad = 5
        ix = Add(x, pad)
        iy = Add(y, pad)
        iw = Subtract(w, Multiply(pad, 2))
        ih = Subtract(h, Multiply(pad, 2))
        IfCondition LessThan(iw, 1) ThenBlock: { iw = 1 }
        IfCondition LessThan(ih, 1) ThenBlock: { ih = 1 }
        span = Subtract(hi, lo)
        IfCondition EqualTo(span, 0) ThenBlock: { span = 1 }
        t = Subtract(v, lo)
        IfCondition LessThan(t, 0) ThenBlock: { t = 0 }
        IfCondition GreaterThan(t, span) ThenBlock: { t = span }
        col = cyan
        IfCondition GreaterEqual(Multiply(t, 10), Multiply(span, 9)) ThenBlock: { col = red }
        IfCondition NotEqual(Gauge_State.tint, 0) ThenBlock: { col = Gauge_State.tint }
        IfCondition EqualTo(BitwiseAnd(fl, GaugeBarFlag.HORIZ), 0) ThenBlock: {
            fh = Divide(Multiply(t, ih), span)
            IfCondition LessThan(fh, 1) ThenBlock: {
                IfCondition GreaterThan(t, 0) ThenBlock: { fh = 1 }
            }
            IfCondition GreaterThan(fh, 0) ThenBlock: {
                FB_FillRect(ix, Subtract(Add(iy, ih), fh), iw, fh, col)
            }
        }
        IfCondition NotEqual(BitwiseAnd(fl, GaugeBarFlag.HORIZ), 0) ThenBlock: {
            fw = Divide(Multiply(t, iw), span)
            IfCondition LessThan(fw, 1) ThenBlock: {
                IfCondition GreaterThan(t, 0) ThenBlock: { fw = 1 }
            }
            IfCondition GreaterThan(fw, 0) ThenBlock: {
                FB_FillRect(ix, iy, fw, ih, col)
            }
        }
        ReturnValue(1)
    }
}

Function.Gauge.DrawBars {
    Output: Integer
    Body: {
        cyan = FB_RGB(42, 212, 255)
        red = FB_RGB(204, 51, 85)
        i = 0
        n = Gauge_State.nbar
        WhileLoop LessThan(i, n) {
            x = Gauge.BWGet(i, 0)
            y = Gauge.BWGet(i, 1)
            w = Gauge.BWGet(i, 2)
            h = Gauge.BWGet(i, 3)
            fl = Gauge.BWGet(i, 4)
            v = Gauge.BWGet(i, 5)
            lo = Gauge.BWGet(i, 6)
            hi = Gauge.BWGet(i, 7)
            pad = 5
            ix = Add(x, pad)
            iy = Add(y, pad)
            iw = Subtract(w, Multiply(pad, 2))
            ih = Subtract(h, Multiply(pad, 2))
            IfCondition LessThan(iw, 1) ThenBlock: { iw = 1 }
            IfCondition LessThan(ih, 1) ThenBlock: { ih = 1 }
            span = Subtract(hi, lo)
            IfCondition EqualTo(span, 0) ThenBlock: { span = 1 }
            t = Subtract(v, lo)
            IfCondition LessThan(t, 0) ThenBlock: { t = 0 }
            IfCondition GreaterThan(t, span) ThenBlock: { t = span }
            col = cyan
            IfCondition GreaterEqual(Multiply(t, 10), Multiply(span, 9)) ThenBlock: { col = red }
            IfCondition EqualTo(BitwiseAnd(fl, GaugeBarFlag.HORIZ), 0) ThenBlock: {
                fh = Divide(Multiply(t, ih), span)
                IfCondition LessThan(fh, 1) ThenBlock: {
                    IfCondition GreaterThan(t, 0) ThenBlock: { fh = 1 }
                }
                IfCondition GreaterThan(fh, 0) ThenBlock: {
                    FB_FillRect(ix, Subtract(Add(iy, ih), fh), iw, fh, col)
                }
            }
            IfCondition NotEqual(BitwiseAnd(fl, GaugeBarFlag.HORIZ), 0) ThenBlock: {
                fw = Divide(Multiply(t, iw), span)
                IfCondition LessThan(fw, 1) ThenBlock: {
                    IfCondition GreaterThan(t, 0) ThenBlock: { fw = 1 }
                }
                IfCondition GreaterThan(fw, 0) ThenBlock: {
                    FB_FillRect(ix, iy, fw, ih, col)
                }
            }
            i = Add(i, 1)
        }
        ReturnValue(n)
    }
}

Function.Gauge.PWSet {
    Input: idx: Integer
    Input: f: Integer
    Input: v: Integer
    Output: Integer
    Body: {
        StoreValue(Add(Gauge_State.plots, Add(Multiply(idx, 64), Multiply(f, 8))), v)
        ReturnValue(0)
    }
}

Function.Gauge.PWGet {
    Input: idx: Integer
    Input: f: Integer
    Output: Integer
    Body: {
        ReturnValue(Dereference(Add(Gauge_State.plots, Add(Multiply(idx, 64), Multiply(f, 8)))))
    }
}

Function.Gauge.PlotScale {
    Input: lo: Integer
    Input: hi: Integer
    Input: div: Integer
    Output: Integer
    Body: {
        IfCondition GreaterEqual(lo, hi) ThenBlock: { hi = Add(lo, 1) }
        IfCondition LessThan(div, 1) ThenBlock: { div = Divide(Subtract(hi, lo), 4) }
        IfCondition LessThan(div, 1) ThenBlock: { div = 1 }
        Gauge_State.plo = lo
        Gauge_State.phi = hi
        Gauge_State.pdiv = div
        ReturnValue(0)
    }
}

Function.Gauge.BakeGrid {
    Input: w: Integer
    Input: h: Integer
    Output: Integer
    Body: {
        surf = Surface_Create(SurfaceFormat.PIXEL_32, w, h)
        IfCondition EqualTo(surf, 0) ThenBlock: { ReturnValue(0) }
        gut = 56
        IfCondition GreaterThan(w, 400) ThenBlock: { gut = 64 }
        Gauge_State.pgut = gut
        lo = Gauge_State.plo
        hi = Gauge_State.phi
        div = Gauge_State.pdiv
        IfCondition LessThan(div, 1) ThenBlock: { div = Divide(Subtract(hi, lo), 8) }
        IfCondition LessThan(div, 1) ThenBlock: { div = 1 }
        span = Subtract(hi, lo)
        IfCondition LessThan(span, 1) ThenBlock: { span = 1 }
        px = gut
        py = 4
        pw = Subtract(Subtract(w, gut), 4)
        ph = Subtract(h, 8)
        Gauge.SvgReset()
        Gauge.SvgS("<svg viewBox=\"0 0 ")
        Gauge.SvgI(w)
        Gauge.SvgS(" ")
        Gauge.SvgI(h)
        Gauge.SvgS("\">")
        Gauge.SvgS("<rect width=\"")
        Gauge.SvgI(w)
        Gauge.SvgS("\" height=\"")
        Gauge.SvgI(h)
        Gauge.SvgS("\" fill=\"#16223f\"/>")
        Gauge.SvgS("<rect x=\"")
        Gauge.SvgI(px)
        Gauge.SvgS("\" y=\"")
        Gauge.SvgI(py)
        Gauge.SvgS("\" width=\"")
        Gauge.SvgI(pw)
        Gauge.SvgS("\" height=\"")
        Gauge.SvgI(ph)
        Gauge.SvgS("\" fill=\"#0a1020\"/>")
        Gauge_State.sw = 1
        val = hi
        nln = 0
        WhileLoop GreaterEqual(val, lo) {
            yy = Add(py, Divide(Multiply(Subtract(hi, val), ph), span))
            Gauge.SvgTick(px, yy, Add(px, pw), yy)
            val = Subtract(val, div)
            nln = Add(nln, 1)
            IfCondition GreaterThan(nln, 16) ThenBlock: { val = Subtract(lo, 1) }
        }
        k = 1
        WhileLoop LessThan(k, 8) {
            xx = Add(px, Divide(Multiply(k, pw), 8))
            Gauge.SvgTick(xx, py, xx, Add(py, ph))
            k = Add(k, 1)
        }
        Gauge.SvgS("</svg>")
        SetByte(Gauge_State.svg, Gauge_State.svg_n, 0)
        SVG_Render(Gauge_State.svg, Gauge_State.svg_n, surf, w, h)
        IfCondition And(EqualTo(Gauge_State.font_ok, 1), EqualTo(Gauge_State.pnums, 1)) ThenBlock: {
            fs = 13
            IfCondition GreaterThan(h, 220) ThenBlock: { fs = 15 }
            VFont_UseSize(fs)
            ink = FB_RGB(180, 190, 210)
            val = hi
            nln = 0
            WhileLoop GreaterEqual(val, lo) {
                yy = Add(py, Divide(Multiply(Subtract(hi, val), ph), span))
                ln = Gauge.ItoA(val)
                mw = VFont_MeasureWidth(Gauge_State.lab, ln)
                tx = Subtract(Subtract(gut, 6), mw)
                IfCondition LessThan(tx, 2) ThenBlock: { tx = 2 }
                VFont_DrawString(surf, Gauge_State.lab, ln, tx, Subtract(yy, 6), ink)
                val = Subtract(val, div)
                nln = Add(nln, 1)
                IfCondition GreaterThan(nln, 16) ThenBlock: { val = Subtract(lo, 1) }
            }
        }
        ReturnValue(surf)
    }
}

Function.Gauge.Plot {
    Input: x: Integer
    Input: y: Integer
    Input: w: Integer
    Input: h: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(Gauge.Init(), 0) ThenBlock: { ReturnValue(-1) }
        IfCondition LessThan(w, 40) ThenBlock: { w = 40 }
        IfCondition LessThan(h, 40) ThenBlock: { h = 40 }
        i = Gauge_State.nplot
        IfCondition GreaterEqual(i, Gauge_State.capp) ThenBlock: { ReturnValue(-1) }
        surf = Gauge.BakeGrid(w, h)
        IfCondition EqualTo(surf, 0) ThenBlock: { ReturnValue(-1) }
        sh = Anim.AddSurf(surf)
        cl = Anim.Clip(sh, 0, 0, 0)
        sp = Anim.Spawn(cl, x, y)
        Anim.Play(sp, 0)
        cap = Gauge_State.pcap
        buf = Allocate(Multiply(cap, 8))
        IfCondition EqualTo(buf, 0) ThenBlock: { ReturnValue(-1) }
        StoreValue(Add(Gauge_State.pbuf, Multiply(i, 8)), buf)
        StoreValue(Add(Gauge_State.ptsp, Multiply(i, 8)), sp)
        Gauge.PWSet(i, 0, x)
        Gauge.PWSet(i, 1, y)
        Gauge.PWSet(i, 2, w)
        Gauge.PWSet(i, 3, h)
        Gauge.PWSet(i, 4, 0)
        Gauge.PWSet(i, 5, 0)
        Gauge.PWSet(i, 6, 0)
        Gauge.PWSet(i, 7, 1000)
        Gauge_State.nplot = Add(i, 1)
        ReturnValue(i)
    }
}

Function.Gauge.PlotRange {
    Input: id: Integer
    Input: lo: Integer
    Input: hi: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(id, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition GreaterEqual(id, Gauge_State.nplot) ThenBlock: { ReturnValue(-1) }
        Gauge.PWSet(id, 6, lo)
        Gauge.PWSet(id, 7, hi)
        ReturnValue(0)
    }
}

Function.Gauge.PlotMove {
    Input: id: Integer
    Input: x: Integer
    Input: y: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(id, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition GreaterEqual(id, Gauge_State.nplot) ThenBlock: { ReturnValue(-1) }
        Gauge.PWSet(id, 0, x)
        Gauge.PWSet(id, 1, y)
        sp = Dereference(Add(Gauge_State.ptsp, Multiply(id, 8)))
        Anim.Place(sp, x, y)
        ReturnValue(0)
    }
}

Function.Gauge.PlotPush {
    Input: id: Integer
    Input: v: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(id, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition GreaterEqual(id, Gauge_State.nplot) ThenBlock: { ReturnValue(-1) }
        buf = Dereference(Add(Gauge_State.pbuf, Multiply(id, 8)))
        IfCondition EqualTo(buf, 0) ThenBlock: { ReturnValue(-1) }
        cap = Gauge_State.pcap
        head = Gauge.PWGet(id, 4)
        n = Gauge.PWGet(id, 5)
        StoreValue(Add(buf, Multiply(head, 8)), v)
        head = Add(head, 1)
        IfCondition GreaterEqual(head, cap) ThenBlock: { head = 0 }
        IfCondition LessThan(n, cap) ThenBlock: { n = Add(n, 1) }
        Gauge.PWSet(id, 4, head)
        Gauge.PWSet(id, 5, n)
        ReturnValue(n)
    }
}

Function.Gauge.PlotClear {
    Input: id: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(id, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition GreaterEqual(id, Gauge_State.nplot) ThenBlock: { ReturnValue(-1) }
        Gauge.PWSet(id, 4, 0)
        Gauge.PWSet(id, 5, 0)
        ReturnValue(0)
    }
}

Function.Gauge.PSamp {
    Input: id: Integer
    Input: k: Integer
    Output: Integer
    Body: {
        buf = Dereference(Add(Gauge_State.pbuf, Multiply(id, 8)))
        cap = Gauge_State.pcap
        head = Gauge.PWGet(id, 4)
        n = Gauge.PWGet(id, 5)
        idx = k
        IfCondition EqualTo(n, cap) ThenBlock: {
            idx = Modulo(Add(head, k), cap)
        }
        ReturnValue(Dereference(Add(buf, Multiply(idx, 8))))
    }
}

Function.Gauge.DrawPlots {
    Output: Integer
    Body: {
        cyan = FB_RGB(42, 212, 255)
        gold = FB_RGB(232, 189, 80)
        i = 0
        np = Gauge_State.nplot
        WhileLoop LessThan(i, np) {
            x = Gauge.PWGet(i, 0)
            y = Gauge.PWGet(i, 1)
            w = Gauge.PWGet(i, 2)
            h = Gauge.PWGet(i, 3)
            n = Gauge.PWGet(i, 5)
            lo = Gauge.PWGet(i, 6)
            hi = Gauge.PWGet(i, 7)
            IfCondition GreaterThan(n, 1) ThenBlock: {
                gut = Gauge_State.pgut
                IfCondition LessThan(gut, 24) ThenBlock: { gut = 56 }
                pad = 4
                ix = Add(x, gut)
                iy = Add(y, pad)
                iw = Subtract(Subtract(w, gut), pad)
                ih = Subtract(h, Multiply(pad, 2))
                span = Subtract(hi, lo)
                IfCondition EqualTo(span, 0) ThenBlock: { span = 1 }
                last = Subtract(n, 1)
                col = cyan
                IfCondition EqualTo(Modulo(i, 2), 1) ThenBlock: { col = gold }
                k = 0
                WhileLoop LessThan(k, last) {
                    v0 = Gauge.PSamp(i, k)
                    v1 = Gauge.PSamp(i, Add(k, 1))
                    t0 = Subtract(v0, lo)
                    t1 = Subtract(v1, lo)
                    IfCondition LessThan(t0, 0) ThenBlock: { t0 = 0 }
                    IfCondition LessThan(t1, 0) ThenBlock: { t1 = 0 }
                    IfCondition GreaterThan(t0, span) ThenBlock: { t0 = span }
                    IfCondition GreaterThan(t1, span) ThenBlock: { t1 = span }
                    x0 = Add(ix, Divide(Multiply(k, iw), last))
                    x1 = Add(ix, Divide(Multiply(Add(k, 1), iw), last))
                    y0 = Subtract(Add(iy, ih), Divide(Multiply(t0, ih), span))
                    y1 = Subtract(Add(iy, ih), Divide(Multiply(t1, ih), span))
                    FB_Line(x0, y0, x1, y1, col)
                    k = Add(k, 1)
                }
            }
            i = Add(i, 1)
        }
        ReturnValue(np)
    }
}
