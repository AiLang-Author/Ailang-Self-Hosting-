LibraryImport.Arena
LibraryImport.Anim
LibraryImport.Gauge
LibraryImport.Dash
LibraryImport.Applications.AppDesk
LibraryImport.Display.Render.Framebuffer
LibraryImport.Display.Render.Fonts

FixedPool.GEdit {
    "live":  Initialize=0, CanChange=True
    "pane":  Initialize=-1, CanChange=True
    "field": Initialize=1, CanChange=True
    "x":     Initialize=0, CanChange=True
    "y":     Initialize=0, CanChange=True
    "w":     Initialize=320, CanChange=True
    "h":     Initialize=300, CanChange=True
}

Function.GaugeEdit.Geom {
    Output: Integer
    Body: {
        GEdit.w = 320
        GEdit.h = 300
        IfCondition GreaterEqual(GEdit.pane, 0) ThenBlock: {
            IfCondition EqualTo(Dash.PWGet(GEdit.pane, 1), DashKind.PLOT) ThenBlock: { GEdit.h = 240 }
            IfCondition EqualTo(Dash.PWGet(GEdit.pane, 1), DashKind.TABLE) ThenBlock: { GEdit.h = 200 }
            IfCondition EqualTo(Dash.PWGet(GEdit.pane, 1), DashKind.BAR) ThenBlock: { GEdit.h = 300 }
            IfCondition EqualTo(Dash.PWGet(GEdit.pane, 1), DashKind.BARH) ThenBlock: { GEdit.h = 300 }
        }
        GEdit.x = Subtract(FB.width, 328)
        IfCondition LessThan(GEdit.x, 8) ThenBlock: { GEdit.x = 8 }
        GEdit.y = 44
        ReturnValue(0)
    }
}

Function.GaugeEdit.Open {
    Output: Integer
    Body: {
        GaugeEdit.Geom()
        GEdit.live = 1
        Dash_State.modal = 1
        desk = AppDesk.focus
        IfCondition GreaterEqual(desk, 0) ThenBlock: {
            p = Dash.PaneOfDesk(desk)
            IfCondition GreaterEqual(p, 0) ThenBlock: { GEdit.pane = p }
        }
        IfCondition LessThan(GEdit.pane, 0) ThenBlock: {
            IfCondition GreaterThan(Dash_State.n, 0) ThenBlock: { GEdit.pane = 0 }
        }
        GEdit.field = 1
        Dash_State.dirty = 1
        ReturnValue(1)
    }
}

Function.GaugeEdit.Close {
    Output: Integer
    Body: {
        GEdit.live = 0
        IfCondition EqualTo(Dash_State.modal, 1) ThenBlock: { Dash_State.modal = 0 }
        Dash_State.dirty = 1
        ReturnValue(0)
    }
}

Function.GaugeEdit.Select {
    Input: pane: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(GEdit.live, 0) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(pane, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition GreaterEqual(pane, Dash_State.n) ThenBlock: { ReturnValue(-1) }
        GEdit.pane = pane
        GEdit.field = 1
        desk = Dash.PWGet(pane, 0)
        IfCondition GreaterEqual(desk, 0) ThenBlock: { AppDesk.Raise(desk) }
        Dash_State.dirty = 1
        ReturnValue(pane)
    }
}

Function.GaugeEdit.NextDiv {
    Input: d: Integer
    Input: dir: Integer
    Output: Integer
    Body: {
        IfCondition GreaterThan(dir, 0) ThenBlock: {
            IfCondition LessThan(d, 2) ThenBlock: { ReturnValue(2) }
            IfCondition LessThan(d, 5) ThenBlock: { ReturnValue(5) }
            IfCondition LessThan(d, 10) ThenBlock: { ReturnValue(10) }
            IfCondition LessThan(d, 20) ThenBlock: { ReturnValue(20) }
            IfCondition LessThan(d, 50) ThenBlock: { ReturnValue(50) }
            IfCondition LessThan(d, 100) ThenBlock: { ReturnValue(100) }
            IfCondition LessThan(d, 200) ThenBlock: { ReturnValue(200) }
            IfCondition LessThan(d, 250) ThenBlock: { ReturnValue(250) }
            IfCondition LessThan(d, 500) ThenBlock: { ReturnValue(500) }
            IfCondition LessThan(d, 1000) ThenBlock: { ReturnValue(1000) }
            ReturnValue(2000)
        }
        IfCondition GreaterThan(d, 1000) ThenBlock: { ReturnValue(1000) }
        IfCondition GreaterThan(d, 500) ThenBlock: { ReturnValue(500) }
        IfCondition GreaterThan(d, 250) ThenBlock: { ReturnValue(250) }
        IfCondition GreaterThan(d, 200) ThenBlock: { ReturnValue(200) }
        IfCondition GreaterThan(d, 100) ThenBlock: { ReturnValue(100) }
        IfCondition GreaterThan(d, 50) ThenBlock: { ReturnValue(50) }
        IfCondition GreaterThan(d, 20) ThenBlock: { ReturnValue(20) }
        IfCondition GreaterThan(d, 10) ThenBlock: { ReturnValue(10) }
        IfCondition GreaterThan(d, 5) ThenBlock: { ReturnValue(5) }
        IfCondition GreaterThan(d, 2) ThenBlock: { ReturnValue(2) }
        ReturnValue(1)
    }
}

Function.GaugeEdit.ApplyChan {
    Input: pane: Integer
    Input: nm: Address
    Output: Integer
    Body: {
        Dash.BindChan(pane, nm)
        IfCondition EqualTo(Dash.PWGet(pane, 1), DashKind.PLOT) ThenBlock: {
            Dash.TraceSet(pane, 0, nm)
        }
        ReturnValue(0)
    }
}

Function.GaugeEdit.CycleKind {
    Input: pane: Integer
    Output: Integer
    Body: {
        k = Dash.PWGet(pane, 1)
        nk = DashKind.ARC
        IfCondition EqualTo(k, DashKind.ARC) ThenBlock: { nk = DashKind.BAR }
        IfCondition EqualTo(k, DashKind.BAR) ThenBlock: { nk = DashKind.PLOT }
        IfCondition EqualTo(k, DashKind.BARH) ThenBlock: { nk = DashKind.PLOT }
        IfCondition EqualTo(k, DashKind.PLOT) ThenBlock: { nk = DashKind.TABLE }
        IfCondition EqualTo(k, DashKind.TABLE) ThenBlock: { nk = DashKind.ARC }
        IfCondition EqualTo(nk, k) ThenBlock: { ReturnValue(0) }
        Dash.HideWidget(pane)
        Dash.PWSet(pane, 1, nk)
        ch = Dash.PWGet(pane, 3)
        IfCondition EqualTo(ch, 0) ThenBlock: {
            IfCondition GreaterThan(Dash_State.nch, 0) ThenBlock: {
                ch = Dereference(Dash_State.chn)
                Dash.PWSet(pane, 3, ch)
            }
        }
        t = ch
        IfCondition EqualTo(t, 0) ThenBlock: { t = Dash.KindName(nk) }
        AppDesk.Set(Dash.PWGet(pane, 0), AppDeskWin.TITLE, t)
        IfCondition EqualTo(nk, DashKind.PLOT) ThenBlock: { Dash.TraceSet(pane, 0, ch) }
        IfCondition EqualTo(nk, DashKind.TABLE) ThenBlock: { Dash.TblFill(pane) }
        Dash.MakeWidget(pane)
        wid = Dash.PWGet(pane, 2)
        IfCondition EqualTo(nk, DashKind.PLOT) ThenBlock: {
            Gauge.PlotRange(wid, Dash.PWGet(pane, 4), Dash.PWGet(pane, 5))
        }
        Dash.Rebuild(pane)
        ReturnValue(nk)
    }
}

Function.GaugeEdit.CycleChan {
    Input: pane: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(Dash_State.nch, 1) ThenBlock: { ReturnValue(-1) }
        cur = Dash.PWGet(pane, 3)
        i = Add(Dash.ChanIdx(cur), 1)
        IfCondition GreaterEqual(i, Dash_State.nch) ThenBlock: { i = 0 }
        nm = Dereference(Add(Dash_State.chn, Multiply(i, 16)))
        GaugeEdit.ApplyChan(pane, nm)
        ReturnValue(i)
    }
}

Function.GaugeEdit.Nudge {
    Input: pane: Integer
    Input: field: Integer
    Input: dir: Integer
    Output: Integer
    Body: {
        lo = Dash.PWGet(pane, 4)
        hi = Dash.PWGet(pane, 5)
        div = Dash.PWGet(pane, 6)
        dec = Dash.PWGet(pane, 7)
        st = div
        IfCondition LessThan(st, 1) ThenBlock: { st = 10 }
        IfCondition EqualTo(field, 3) ThenBlock: {
            lo = Add(lo, Multiply(dir, st))
            IfCondition GreaterEqual(lo, hi) ThenBlock: { lo = Subtract(hi, st) }
            Dash.PWSet(pane, 4, lo)
        }
        IfCondition EqualTo(field, 4) ThenBlock: {
            hi = Add(hi, Multiply(dir, st))
            IfCondition LessEqual(hi, lo) ThenBlock: { hi = Add(lo, st) }
            Dash.PWSet(pane, 5, hi)
        }
        IfCondition EqualTo(field, 5) ThenBlock: {
            kind = Dash.PWGet(pane, 1)
            IfCondition EqualTo(kind, DashKind.BAR) ThenBlock: {
                ch = Dash.PWGet(pane, 3)
                Dash.ChanSetBand(ch, Add(Dash.ChanCool(ch), Multiply(dir, st)), Dash.ChanWarn(ch), Dash.ChanHot(ch))
            }
            IfCondition EqualTo(kind, DashKind.BARH) ThenBlock: {
                ch = Dash.PWGet(pane, 3)
                Dash.ChanSetBand(ch, Add(Dash.ChanCool(ch), Multiply(dir, st)), Dash.ChanWarn(ch), Dash.ChanHot(ch))
            }
            IfCondition EqualTo(kind, DashKind.ARC) ThenBlock: {
                Dash.PWSet(pane, 6, GaugeEdit.NextDiv(div, dir))
            }
        }
        IfCondition EqualTo(field, 6) ThenBlock: {
            kind = Dash.PWGet(pane, 1)
            IfCondition EqualTo(kind, DashKind.BAR) ThenBlock: {
                ch = Dash.PWGet(pane, 3)
                Dash.ChanSetBand(ch, Dash.ChanCool(ch), Add(Dash.ChanWarn(ch), Multiply(dir, st)), Dash.ChanHot(ch))
            }
            IfCondition EqualTo(kind, DashKind.BARH) ThenBlock: {
                ch = Dash.PWGet(pane, 3)
                Dash.ChanSetBand(ch, Dash.ChanCool(ch), Add(Dash.ChanWarn(ch), Multiply(dir, st)), Dash.ChanHot(ch))
            }
            IfCondition EqualTo(kind, DashKind.ARC) ThenBlock: {
                nd = Add(dec, dir)
                IfCondition LessThan(nd, 0) ThenBlock: { nd = 2 }
                IfCondition GreaterThan(nd, 2) ThenBlock: { nd = 0 }
                Dash.PWSet(pane, 7, nd)
            }
        }
        IfCondition EqualTo(field, 7) ThenBlock: {
            ch = Dash.PWGet(pane, 3)
            Dash.ChanSetBand(ch, Dash.ChanCool(ch), Dash.ChanWarn(ch), Add(Dash.ChanHot(ch), Multiply(dir, st)))
        }
        IfCondition EqualTo(field, 8) ThenBlock: {
            nd = Add(dec, dir)
            IfCondition LessThan(nd, 0) ThenBlock: { nd = 2 }
            IfCondition GreaterThan(nd, 2) ThenBlock: { nd = 0 }
            Dash.PWSet(pane, 7, nd)
        }
        ch = Dash.PWGet(pane, 3)
        IfCondition NotEqual(ch, 0) ThenBlock: {
            Dash.ChanSetRange(ch, Dash.PWGet(pane, 4), Dash.PWGet(pane, 5))
            Dash.ChanSetDec(ch, Dash.PWGet(pane, 7))
        }
        Dash.Rebuild(pane)
        ReturnValue(0)
    }
}

Function.GaugeEdit.NudgeTrace {
    Input: pane: Integer
    Input: field: Integer
    Input: dir: Integer
    Output: Integer
    Body: {
        slot = Dash_State.pslot
        IfCondition LessThan(slot, 0) ThenBlock: { slot = 0 }
        IfCondition GreaterThan(slot, 5) ThenBlock: { slot = 5 }
        nm = Dash.TraceGet(pane, slot)
        IfCondition EqualTo(nm, 0) ThenBlock: { ReturnValue(0) }
        lo = Dash.ChanLo(nm)
        hi = Dash.ChanHi(nm)
        dc = Dash.ChanDec(nm)
        st = Divide(Subtract(hi, lo), 10)
        IfCondition LessThan(st, 1) ThenBlock: { st = 1 }
        IfCondition EqualTo(field, 3) ThenBlock: {
            lo = Add(lo, Multiply(dir, st))
            IfCondition GreaterEqual(lo, hi) ThenBlock: { lo = Subtract(hi, st) }
            Dash.ChanSetRange(nm, lo, hi)
        }
        IfCondition EqualTo(field, 4) ThenBlock: {
            hi = Add(hi, Multiply(dir, st))
            IfCondition LessEqual(hi, lo) ThenBlock: { hi = Add(lo, st) }
            Dash.ChanSetRange(nm, lo, hi)
        }
        IfCondition EqualTo(field, 5) ThenBlock: {
            nd = Add(dc, dir)
            IfCondition LessThan(nd, 0) ThenBlock: { nd = 2 }
            IfCondition GreaterThan(nd, 2) ThenBlock: { nd = 0 }
            Dash.ChanSetDec(nm, nd)
        }
        Dash_State.dirty = 1
        ReturnValue(0)
    }
}

Function.GaugeEdit.InPanel {
    Input: px: Integer
    Input: py: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(px, GEdit.x) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(py, GEdit.y) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterEqual(px, Add(GEdit.x, GEdit.w)) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterEqual(py, Add(GEdit.y, GEdit.h)) ThenBlock: { ReturnValue(0) }
        ReturnValue(1)
    }
}

Function.GaugeEdit.Click {
    Input: px: Integer
    Input: py: Integer
    Output: Integer
    Body: {
        pane = GEdit.pane
        x = GEdit.x
        y = GEdit.y
        w = GEdit.w
        IfCondition GreaterEqual(px, Subtract(Add(x, w), 28)) ThenBlock: {
            IfCondition LessThan(py, Add(y, 24)) ThenBlock: {
                GaugeEdit.Close()
                ReturnValue(1)
            }
        }
        IfCondition LessThan(pane, 0) ThenBlock: { ReturnValue(1) }
        rh = 28
        row = Divide(Subtract(py, Add(y, 28)), rh)
        IfCondition LessThan(row, 0) ThenBlock: { ReturnValue(1) }
        kind = Dash.PWGet(pane, 1)
        IfCondition EqualTo(kind, DashKind.TABLE) ThenBlock: {
            IfCondition GreaterThan(row, 3) ThenBlock: { ReturnValue(1) }
            GEdit.field = Add(row, 1)
            IfCondition EqualTo(row, 0) ThenBlock: { GaugeEdit.CycleKind(pane) }
            IfCondition EqualTo(row, 1) ThenBlock: {
                Dash.DropOpen(pane, Dash_State.pslot)
            }
            IfCondition EqualTo(row, 2) ThenBlock: {
                Dash.TblMove(pane, Dash_State.pslot, Subtract(0, 1))
            }
            IfCondition EqualTo(row, 3) ThenBlock: {
                Dash.TblMove(pane, Dash_State.pslot, 1)
            }
            Dash_State.dirty = 1
            ReturnValue(1)
        }
        IfCondition EqualTo(kind, DashKind.PLOT) ThenBlock: {
            IfCondition GreaterThan(row, 5) ThenBlock: { ReturnValue(1) }
            GEdit.field = Add(row, 1)
            plus = Subtract(Add(x, w), 28)
            minus = Subtract(plus, 28)
            dir = 1
            IfCondition And(GreaterEqual(px, minus), LessThan(px, plus)) ThenBlock: { dir = Subtract(0, 1) }
            IfCondition EqualTo(row, 0) ThenBlock: { GaugeEdit.CycleKind(pane) }
            IfCondition EqualTo(row, 1) ThenBlock: {
                ns = Add(Dash_State.pslot, 1)
                IfCondition GreaterThan(ns, 5) ThenBlock: { ns = 0 }
                Dash_State.pslot = ns
            }
            IfCondition EqualTo(row, 2) ThenBlock: { Dash.CycleTrace(pane, Dash_State.pslot) }
            IfCondition GreaterThan(row, 2) ThenBlock: {
                GaugeEdit.NudgeTrace(pane, row, dir)
            }
            Dash_State.dirty = 1
            ReturnValue(1)
        }
        kind = Dash.PWGet(pane, 1)
        IfCondition EqualTo(kind, DashKind.BAR) ThenBlock: {
            IfCondition GreaterThan(row, 7) ThenBlock: { ReturnValue(1) }
        }
        IfCondition EqualTo(kind, DashKind.BARH) ThenBlock: {
            IfCondition GreaterThan(row, 7) ThenBlock: { ReturnValue(1) }
        }
        IfCondition EqualTo(kind, DashKind.ARC) ThenBlock: {
            IfCondition GreaterThan(row, 5) ThenBlock: { ReturnValue(1) }
        }
        GEdit.field = Add(row, 1)
        plus = Subtract(Add(x, w), 28)
        minus = Subtract(plus, 28)
        IfCondition EqualTo(row, 0) ThenBlock: { GaugeEdit.CycleKind(pane) }
        IfCondition EqualTo(row, 1) ThenBlock: { GaugeEdit.CycleChan(pane) }
        IfCondition GreaterThan(row, 1) ThenBlock: {
            dir = 1
            IfCondition LessThan(px, minus) ThenBlock: { dir = 1 }
            IfCondition And(GreaterEqual(px, minus), LessThan(px, plus)) ThenBlock: { dir = Subtract(0, 1) }
            IfCondition GreaterEqual(px, plus) ThenBlock: { dir = 1 }
            IfCondition LessThan(px, minus) ThenBlock: {
                IfCondition EqualTo(row, 5) ThenBlock: { GaugeEdit.Nudge(pane, 6, 1) }
            }
            IfCondition GreaterEqual(px, minus) ThenBlock: {
                GaugeEdit.Nudge(pane, Add(row, 1), dir)
            }
        }
        Dash_State.dirty = 1
        ReturnValue(1)
    }
}

Function.GaugeEdit.OnPtr {
    Output: Integer
    Body: {
        IfCondition EqualTo(Dash_State.edit, 1) ThenBlock: {
            Dash_State.edit = 0
            was = GEdit.live
            IfCondition EqualTo(was, 1) ThenBlock: { GaugeEdit.Close() }
            IfCondition EqualTo(was, 0) ThenBlock: {
                IfCondition EqualTo(Dash_State.modal, 0) ThenBlock: { GaugeEdit.Open() }
            }
        }
        IfCondition EqualTo(GEdit.live, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Dash_State.ptrhit, 0) ThenBlock: { ReturnValue(0) }
        px = Dash_State.mx
        py = Dash_State.my
        IfCondition EqualTo(Dash_State.drop, 1) ThenBlock: {
            Dash_State.ptrhit = 0
            ReturnValue(Dash.HitDrop(px, py))
        }
        IfCondition EqualTo(GaugeEdit.InPanel(px, py), 1) ThenBlock: {
            Dash_State.ptrhit = 0
            ReturnValue(GaugeEdit.Click(px, py))
        }
        pane = Dash.HitPane(px, py)
        IfCondition GreaterEqual(pane, 0) ThenBlock: {
            Dash_State.ptrhit = 0
            GaugeEdit.Select(pane)
            AppDesk.hit_idx = Dash.PWGet(pane, 0)
            IfCondition EqualTo(Dash.PWGet(pane, 1), DashKind.PLOT) ThenBlock: {
                Dash.HitScope(px, py)
            }
            IfCondition EqualTo(Dash.PWGet(pane, 1), DashKind.TABLE) ThenBlock: {
                Dash.HitTable(px, py)
            }
            IfCondition And(NotEqual(Dash.PWGet(pane, 1), DashKind.TABLE), NotEqual(Dash.PWGet(pane, 1), DashKind.PLOT)) ThenBlock: {
                Dash.HitBind()
            }
            ReturnValue(1)
        }
        Dash_State.ptrhit = 0
        ReturnValue(0)
    }
}

Function.GaugeEdit.Row {
    Input: dest: Integer
    Input: row: Integer
    Input: name: Address
    Input: val: Address
    Input: vn: Integer
    Input: on: Integer
    Input: step: Integer
    Output: Integer
    Body: {
        x = GEdit.x
        y = Add(Add(GEdit.y, 28), Multiply(row, 28))
        fg = FB_RGB(180, 190, 210)
        IfCondition EqualTo(on, 1) ThenBlock: { fg = FB_RGB(42, 212, 255) }
        VFont_DrawString(dest, name, Dash.SLen(name), Add(x, 10), Add(y, 6), fg)
        vx = Add(x, 100)
        VFont_DrawString(dest, val, vn, vx, Add(y, 6), fg)
        IfCondition EqualTo(step, 1) ThenBlock: {
            bx = Subtract(Add(x, GEdit.w), 54)
            FB_Rect(bx, Add(y, 4), 22, 20, fg)
            VFont_DrawString(dest, "-", 1, Add(bx, 7), Add(y, 6), fg)
            FB_Rect(Add(bx, 24), Add(y, 4), 22, 20, fg)
            VFont_DrawString(dest, "+", 1, Add(bx, 30), Add(y, 6), fg)
        }
        ReturnValue(0)
    }
}

Function.GaugeEdit.Draw {
    Output: Integer
    Body: {
        IfCondition EqualTo(GEdit.live, 0) ThenBlock: { ReturnValue(0) }
        GaugeEdit.Geom()
        dest = Anim.Dest()
        IfCondition EqualTo(dest, 0) ThenBlock: { ReturnValue(0) }
        x = GEdit.x
        y = GEdit.y
        w = GEdit.w
        h = GEdit.h
        pane = GEdit.pane
        IfCondition GreaterEqual(pane, 0) ThenBlock: {
            pd = Dash.PWGet(pane, 0)
            IfCondition EqualTo(AppDesk.Get(pd, AppDeskWin.LIVE), 1) ThenBlock: {
                AppDesk.Set(pd, AppDeskWin.KIND, 10)
                FB_FillRect(AppDesk.Get(pd, AppDeskWin.X), AppDesk.Get(pd, AppDeskWin.Y), AppDesk.Get(pd, AppDeskWin.W), 3, FB_RGB(42, 212, 255))
            }
        }
        FB_FillRect(x, y, w, h, FB_RGB(14, 23, 48))
        FB_Rect(x, y, w, h, FB_RGB(42, 212, 255))
        FB_FillRect(x, y, w, 24, FB_RGB(0, 160, 220))
        VFont_UseSize(13)
        ttl = "Gauge"
        tn = 5
        IfCondition GreaterEqual(pane, 0) ThenBlock: {
            IfCondition EqualTo(Dash.PWGet(pane, 1), DashKind.PLOT) ThenBlock: {
                ttl = "Plot"
                tn = 4
            }
            IfCondition EqualTo(Dash.PWGet(pane, 1), DashKind.TABLE) ThenBlock: {
                ttl = "Table"
                tn = 5
            }
        }
        VFont_DrawString(dest, ttl, tn, Add(x, 10), Add(y, 5), FB_RGB(0, 0, 0))
        FB_FillRect(Subtract(Add(x, w), 22), Add(y, 4), 16, 16, FB_RGB(255, 255, 255))
        FB_Rect(Subtract(Add(x, w), 22), Add(y, 4), 16, 16, FB_RGB(0, 0, 0))
        VFont_DrawString(dest, "X", 1, Subtract(Add(x, w), 18), Add(y, 6), FB_RGB(0, 0, 0))
        IfCondition LessThan(pane, 0) ThenBlock: {
            VFont_DrawString(dest, "click a window", 14, Add(x, 10), Add(y, 40), FB_RGB(42, 212, 255))
            ReturnValue(0)
        }
        kn = Dash.KindName(Dash.PWGet(pane, 1))
        f = GEdit.field
        o1 = 0
        IfCondition EqualTo(f, 1) ThenBlock: { o1 = 1 }
        GaugeEdit.Row(dest, 0, "Kind", kn, Dash.SLen(kn), o1, 0)
        IfCondition EqualTo(Dash.PWGet(pane, 1), DashKind.TABLE) ThenBlock: {
            slot = Dash_State.pslot
            IfCondition LessThan(slot, 0) ThenBlock: { slot = 0 }
            IfCondition GreaterThan(slot, 31) ThenBlock: { slot = 31 }
            nm = Dash.TblGet(pane, slot)
            IfCondition EqualTo(nm, 0) ThenBlock: { nm = "-" }
            o2 = 0
            o3 = 0
            o4 = 0
            IfCondition EqualTo(f, 2) ThenBlock: { o2 = 1 }
            IfCondition EqualTo(f, 3) ThenBlock: { o3 = 1 }
            IfCondition EqualTo(f, 4) ThenBlock: { o4 = 1 }
            GaugeEdit.Row(dest, 1, "Chan", nm, Dash.SLen(nm), o2, 0)
            GaugeEdit.Row(dest, 2, "Up", "move", 4, o3, 0)
            GaugeEdit.Row(dest, 3, "Down", "move", 4, o4, 0)
            VFont_DrawString(dest, "Chan list · Up/Down reorder", 27, Add(x, 10), Subtract(Add(y, h), 22), FB_RGB(140, 150, 170))
            ReturnValue(1)
        }
        IfCondition EqualTo(Dash.PWGet(pane, 1), DashKind.PLOT) ThenBlock: {
            slot = Dash_State.pslot
            IfCondition LessThan(slot, 0) ThenBlock: { slot = 0 }
            IfCondition GreaterThan(slot, 5) ThenBlock: { slot = 5 }
            lab = "T1"
            IfCondition EqualTo(slot, 1) ThenBlock: { lab = "T2" }
            IfCondition EqualTo(slot, 2) ThenBlock: { lab = "T3" }
            IfCondition EqualTo(slot, 3) ThenBlock: { lab = "T4" }
            IfCondition EqualTo(slot, 4) ThenBlock: { lab = "T5" }
            IfCondition EqualTo(slot, 5) ThenBlock: { lab = "T6" }
            nm = Dash.TraceGet(pane, slot)
            IfCondition EqualTo(nm, 0) ThenBlock: { nm = "-" }
            o2 = 0
            o3 = 0
            o4 = 0
            o5 = 0
            o6 = 0
            IfCondition EqualTo(f, 2) ThenBlock: { o2 = 1 }
            IfCondition EqualTo(f, 3) ThenBlock: { o3 = 1 }
            IfCondition EqualTo(f, 4) ThenBlock: { o4 = 1 }
            IfCondition EqualTo(f, 5) ThenBlock: { o5 = 1 }
            IfCondition EqualTo(f, 6) ThenBlock: { o6 = 1 }
            GaugeEdit.Row(dest, 1, "Slot", lab, 2, o2, 0)
            GaugeEdit.Row(dest, 2, "Chan", nm, Dash.SLen(nm), o3, 0)
            nlo = Gauge.ItoA(Dash.ChanLo(nm))
            IfCondition EqualTo(nm, "-") ThenBlock: { nlo = Gauge.ItoA(0) }
            GaugeEdit.Row(dest, 3, "Lo", Gauge_State.lab, nlo, o4, 1)
            nhi = Gauge.ItoA(Dash.ChanHi(nm))
            IfCondition EqualTo(nm, "-") ThenBlock: { nhi = Gauge.ItoA(0) }
            GaugeEdit.Row(dest, 4, "Hi", Gauge_State.lab, nhi, o5, 1)
            ndc = Gauge.ItoA(Dash.ChanDec(nm))
            IfCondition EqualTo(nm, "-") ThenBlock: { ndc = Gauge.ItoA(0) }
            GaugeEdit.Row(dest, 5, "Dec", Gauge_State.lab, ndc, o6, 1)
            VFont_DrawString(dest, "chip picks a trace, Lo/Hi scale it", 34, Add(x, 10), Subtract(Add(y, h), 22), FB_RGB(140, 150, 170))
            ReturnValue(1)
        }
        chn = Dash.PWGet(pane, 3)
        IfCondition EqualTo(chn, 0) ThenBlock: { chn = "-" }
        o2 = 0
        o3 = 0
        o4 = 0
        o5 = 0
        o6 = 0
        o7 = 0
        o8 = 0
        IfCondition EqualTo(f, 2) ThenBlock: { o2 = 1 }
        IfCondition EqualTo(f, 3) ThenBlock: { o3 = 1 }
        IfCondition EqualTo(f, 4) ThenBlock: { o4 = 1 }
        IfCondition EqualTo(f, 5) ThenBlock: { o5 = 1 }
        IfCondition EqualTo(f, 6) ThenBlock: { o6 = 1 }
        IfCondition EqualTo(f, 7) ThenBlock: { o7 = 1 }
        IfCondition EqualTo(f, 8) ThenBlock: { o8 = 1 }
        GaugeEdit.Row(dest, 1, "Channel", chn, Dash.SLen(chn), o2, 0)
        n3 = Gauge.ItoA(Dash.PWGet(pane, 4))
        GaugeEdit.Row(dest, 2, "Lo", Gauge_State.lab, n3, o3, 1)
        n4 = Gauge.ItoA(Dash.PWGet(pane, 5))
        GaugeEdit.Row(dest, 3, "Hi", Gauge_State.lab, n4, o4, 1)
        IfCondition EqualTo(Dash.PWGet(pane, 1), DashKind.BAR) ThenBlock: {
            n5 = Gauge.ItoA(Dash.ChanCool(chn))
            GaugeEdit.Row(dest, 4, "Cool", Gauge_State.lab, n5, o5, 1)
            n6 = Gauge.ItoA(Dash.ChanWarn(chn))
            GaugeEdit.Row(dest, 5, "Warn", Gauge_State.lab, n6, o6, 1)
            n7 = Gauge.ItoA(Dash.ChanHot(chn))
            GaugeEdit.Row(dest, 6, "Hot", Gauge_State.lab, n7, o7, 1)
            n8 = Gauge.ItoA(Dash.PWGet(pane, 7))
            GaugeEdit.Row(dest, 7, "Dec", Gauge_State.lab, n8, o8, 1)
            VFont_DrawString(dest, "Cool/Warn/Hot set bar colors", 28, Add(x, 10), Subtract(Add(y, h), 22), FB_RGB(140, 150, 170))
            ReturnValue(1)
        }
        IfCondition EqualTo(Dash.PWGet(pane, 1), DashKind.BARH) ThenBlock: {
            n5 = Gauge.ItoA(Dash.ChanCool(chn))
            GaugeEdit.Row(dest, 4, "Cool", Gauge_State.lab, n5, o5, 1)
            n6 = Gauge.ItoA(Dash.ChanWarn(chn))
            GaugeEdit.Row(dest, 5, "Warn", Gauge_State.lab, n6, o6, 1)
            n7 = Gauge.ItoA(Dash.ChanHot(chn))
            GaugeEdit.Row(dest, 6, "Hot", Gauge_State.lab, n7, o7, 1)
            n8 = Gauge.ItoA(Dash.PWGet(pane, 7))
            GaugeEdit.Row(dest, 7, "Dec", Gauge_State.lab, n8, o8, 1)
            VFont_DrawString(dest, "Cool/Warn/Hot set bar colors", 28, Add(x, 10), Subtract(Add(y, h), 22), FB_RGB(140, 150, 170))
            ReturnValue(1)
        }
        n5 = Gauge.ItoA(Dash.PWGet(pane, 6))
        GaugeEdit.Row(dest, 4, "Div", Gauge_State.lab, n5, o5, 1)
        n6 = Gauge.ItoA(Dash.PWGet(pane, 7))
        GaugeEdit.Row(dest, 5, "Dec", Gauge_State.lab, n6, o6, 1)
        VFont_DrawString(dest, "click a window to load it", 25, Add(x, 10), Subtract(Add(y, h), 22), FB_RGB(140, 150, 170))
        ReturnValue(1)
    }
}
