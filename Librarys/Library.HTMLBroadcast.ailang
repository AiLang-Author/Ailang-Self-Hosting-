// Library.HTMLOutput.ailang
// HTML output engine for the DnD game engine.
//
// Replaces Library.TUI for web delivery. The game loop calls
// HTML_RenderFrame() instead of TUI_Refresh(). The HTTP server
// serves the shell page once; subsequent requests return JSON
// game state that the client JS renders into the tile grid.
//
// Architecture:
//   HTML_Init()              — allocate output buffers
//   HTML_RenderFrame()       — build full JSON game state
//   HTML_ServeShell(fd)      — send the static shell HTML once
//   HTML_ServeState(fd)      — send current JSON state
//   HTML_StartServer()       — blocking HTTP accept loop
//
// JSON output uses Library.JSON throughout — no manual byte building.
// The shell page is still string-built (it's static HTML not data).
//
// Copyright © 2026 Sean Collins, 2 Paws Machine and Engineering. SCSL.

LibraryImport.Arena
LibraryImport.JSON
LibraryImport.StringUtils
// HTMLBroadcast renders the DND engine's map/player/monster state —
// needs DND's pools and accessors visible at compile time.
LibraryImport.DND

// =============================================================================
// CONSTANTS
// =============================================================================

// Runtime output buffer state.
FixedPool.HTMLOut {
    "buf":      Initialize=0
    "pos":      Initialize=0
}

// Static configuration (doesn't mutate at runtime). `capacity` lives
// here because callers reference it as HTMLCfg.capacity; moving it
// from HTMLOut to HTMLCfg unblocked HTML_Init and HTML_OutByte which
// expected it in this pool.
FixedPool.HTMLCfg {
    "port":      Initialize=8088
    "view_w":    Initialize=40
    "view_h":    Initialize=20
    "msg_count": Initialize=4
    "poll_ms":   Initialize=150
    "capacity":  Initialize=524288    // 512KB for shell HTML
}

FixedPool.WebSrv {
    "listen_fd": Initialize=-1
    "ready":     Initialize=0
}

// =============================================================================
// INIT
// =============================================================================

Function.HTML_Init {
    Output: Integer
    Body: {
        buf = Allocate(HTMLCfg.capacity)
        IfCondition EqualTo(buf, 0) ThenBlock: {
            PrintMessage("[HTML] buf alloc fail\n")
            ReturnValue(0)
        }
        HTMLOut.buf = buf
        HTMLOut.pos = 0
        PrintMessage("[HTML] init ok\n")
        ReturnValue(1)
    }
}

// =============================================================================
// SHELL OUTPUT BUFFER — for building static HTML only
// =============================================================================

Function.HTML_OutByte {
    Input: b: Integer
    Body: {
        IfCondition GreaterEqual(HTMLOut.pos, HTMLCfg.capacity) ThenBlock: {
            ReturnValue(0)
        }
        SetByte(HTMLOut.buf, HTMLOut.pos, b)
        HTMLOut.pos = Add(HTMLOut.pos, 1)
        ReturnValue(0)
    }
}

Function.HTML_OutStr {
    Input: s: Address
    Body: {
        i = 0
        ch = GetByte(s, i)
        WhileLoop NotEqual(ch, 0) {
            HTML_OutByte(ch)
            i = Add(i, 1)
            ch = GetByte(s, i)
        }
        ReturnValue(0)
    }
}

Function.HTML_OutInt {
    Input: v: Integer
    Body: {
        s = NumberToString(v)
        HTML_OutStr(s)
        ReturnValue(0)
    }
}

Function.HTML_Reset {
    Body: {
        HTMLOut.pos = 0
        ReturnValue(0)
    }
}

// =============================================================================
// MAP RENDERER — builds JSON array of rows using Library.JSON
//
// Each cell: {"t": ASCII, "c": color_index, "s": style_flag}
//   t = tile char code
//   c = foreground color 0-7 (matches TUI palette)
//   s = 0=normal 1=bold 2=dim
// =============================================================================

Function.HTML_BuildMapJSON {
    Output: Address
    Body: {
        // Viewport (mirrors DND_DrawMap)
        view_x = Subtract(DND_Player.x, Divide(HTMLCfg.view_w, 2))
        view_y = Subtract(DND_Player.y, Divide(HTMLCfg.view_h, 2))

        IfCondition LessThan(view_x, 0) ThenBlock: { view_x = 0 }
        IfCondition LessThan(view_y, 0) ThenBlock: { view_y = 0 }

        max_vx = Subtract(DND_Map.width, HTMLCfg.view_w)
        max_vy = Subtract(DND_Map.height, HTMLCfg.view_h)

        IfCondition GreaterThan(view_x, max_vx) ThenBlock: {
            IfCondition GreaterThan(max_vx, 0) ThenBlock: {
                view_x = max_vx
            } ElseBlock: { view_x = 0 }
        }
        IfCondition GreaterThan(view_y, max_vy) ThenBlock: {
            IfCondition GreaterThan(max_vy, 0) ThenBlock: {
                view_y = max_vy
            } ElseBlock: { view_y = 0 }
        }

        map_arr = JSON.NewArray()

        sy = 0
        WhileLoop LessThan(sy, HTMLCfg.view_h) {
            row_arr = JSON.NewArray()

            sx = 0
            WhileLoop LessThan(sx, HTMLCfg.view_w) {
                mx = Add(view_x, sx)
                my = Add(view_y, sy)

                cell = JSON.NewObject()

                is_player = And(EqualTo(mx, DND_Player.x), EqualTo(my, DND_Player.y))
                IfCondition EqualTo(is_player, 1) ThenBlock: {
                    JSON.SetNumber(cell, "t", DND_Tiles.PLAYER)
                    JSON.SetNumber(cell, "c", DND_TileColors.PLAYER_FG)
                    JSON.SetNumber(cell, "s", 1)
                } ElseBlock: {
                    midx = DND_GetMonsterAt(mx, my)
                    IfCondition GreaterEqual(midx, 0) ThenBlock: {
                        JSON.SetNumber(cell, "t", DND_GetMonsterSymbol(midx))
                        JSON.SetNumber(cell, "c", DND_TileColors.MONSTER_FG)
                        JSON.SetNumber(cell, "s", 1)
                    } ElseBlock: {
                        tile  = DND_GetTile(mx, my)
                        color = DND_GetTileColor(tile)
                        style = 0
                        IfCondition EqualTo(tile, DND_Tiles.FLOOR) ThenBlock: {
                            style = 2
                        }
                        JSON.SetNumber(cell, "t", tile)
                        JSON.SetNumber(cell, "c", color)
                        JSON.SetNumber(cell, "s", style)
                    }
                }

                JSON.PushObject(row_arr, cell)
                sx = Add(sx, 1)
            }

            JSON.PushArray(map_arr, row_arr)
            sy = Add(sy, 1)
        }

        ReturnValue(map_arr)
    }
}

// =============================================================================
// STATS RENDERER — builds JSON object using Library.JSON
// =============================================================================

Function.HTML_BuildStatsJSON {
    Output: Address
    Body: {
        char_data = DND_Player.char_data
        stats = JSON.NewObject()

        JSON.SetString(stats, "name",    Char_GetName(char_data))
        JSON.SetString(stats, "class",   Char_GetClassName(Char_GetClass(char_data)))
        JSON.SetNumber(stats, "level",   Char_GetLevel(char_data))
        JSON.SetNumber(stats, "hp",      Char_GetHP(char_data))
        JSON.SetNumber(stats, "max_hp",  Char_GetMaxHP(char_data))
        JSON.SetNumber(stats, "mp",      Char_GetMP(char_data))
        JSON.SetNumber(stats, "max_mp",  Char_GetMaxMP(char_data))
        JSON.SetNumber(stats, "gold",    DND_Player.gold)
        // Char has no Char_GetXP accessor — read TOTAL_XP directly.
        JSON.SetNumber(stats, "xp",      Char_GetStat16(char_data, Char_Offsets.TOTAL_XP))

        ReturnValue(stats)
    }
}

// =============================================================================
// MESSAGE LOG — builds JSON array using Library.JSON
// =============================================================================

Function.HTML_BuildMsgsJSON {
    Output: Address
    Body: {
        msgs = JSON.NewArray()
        count = DND_GetMessageCount()
        start = 0
        IfCondition GreaterThan(count, HTMLCfg.msg_count) ThenBlock: {
            start = Subtract(count, HTMLCfg.msg_count)
        }
        i = start
        WhileLoop LessThan(i, count) {
            msg = DND_GetMessage(i)
            IfCondition NotEqual(msg, 0) ThenBlock: {
                JSON.PushString(msgs, msg)
            }
            i = Add(i, 1)
        }
        ReturnValue(msgs)
    }
}

// =============================================================================
// FULL FRAME — assemble complete game state JSON and serialize
// =============================================================================

Function.HTML_RenderFrame {
    Output: Address
    Body: {
        frame = JSON.NewObject()

        map_arr  = HTML_BuildMapJSON()
        stats    = HTML_BuildStatsJSON()
        msgs     = HTML_BuildMsgsJSON()

        JSON.SetArray(frame,  "map",   map_arr)
        JSON.SetObject(frame, "stats", stats)
        JSON.SetArray(frame,  "msgs",  msgs)

        map_name = Config_GetMapName(Config_State.current_map)
        IfCondition NotEqual(map_name, 0) ThenBlock: {
            JSON.SetString(frame, "map_name", map_name)
        } ElseBlock: {
            JSON.SetString(frame, "map_name", "")
        }

        JSON.SetNumber(frame, "px", DND_Player.x)
        JSON.SetNumber(frame, "py", DND_Player.y)

        ReturnValue(JSON.SerializeObject(frame))
    }
}

// =============================================================================
// ACTION PARSER — extract action string from POST body JSON
// Uses ParseJSON from Library.JSON
// =============================================================================

Function.HTML_ParseAction {
    Input: body: Address
    Output: Address
    Body: {
        tagged = ParseJSON(body)
        IfCondition EqualTo(tagged, 0) ThenBlock: { ReturnValue(0) }
        obj = JSON.AsObject(tagged)
        IfCondition EqualTo(obj, 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(JSON.GetString(obj, "action"))
    }
}

// =============================================================================
// HTTP SEND HELPER
// =============================================================================

Function.HTML_SendHTTP {
    Input: fd:           Integer
    Input: status:       Address
    Input: content_type: Address
    Input: body:         Address
    Input: body_len:     Integer
    Body: {
        SystemCall(1, fd, "HTTP/1.1 ", 9)
        SystemCall(1, fd, status, StringLength(status))
        SystemCall(1, fd, "\r\nContent-Type: ", 16)
        SystemCall(1, fd, content_type, StringLength(content_type))
        SystemCall(1, fd, "\r\nContent-Length: ", 18)

        len_str = NumberToString(body_len)
        SystemCall(1, fd, len_str, StringLength(len_str))
        SystemCall(1, fd, "\r\nAccess-Control-Allow-Origin: *\r\nConnection: close\r\n\r\n", 52)

        IfCondition GreaterThan(body_len, 0) ThenBlock: {
            SystemCall(1, fd, body, body_len)
        }
        ReturnValue(0)
    }
}

// =============================================================================
// SERVE STATE
// =============================================================================

Function.HTML_ServeState {
    Input: fd: Integer
    Body: {
        json_str = HTML_RenderFrame()
        body_len = StringLength(json_str)
        HTML_SendHTTP(fd, "200 OK", "application/json", json_str, body_len)
        ReturnValue(0)
    }
}

// =============================================================================
// ACTION HANDLER
// =============================================================================

Function.HTML_HandleAction {
    Input: fd:       Integer
    Input: body:     Address
    Input: body_len: Integer
    Body: {
        action = HTML_ParseAction(body)

        IfCondition EqualTo(action, 0) ThenBlock: {
            HTML_ServeState(fd)
            ReturnValue(0)
        }

        dx = 0
        dy = 0
        special = 0

        IfCondition EqualTo(StringCompare(action, "up"), 0) ThenBlock: {
            dy = Subtract(0, 1)
        }
        IfCondition EqualTo(StringCompare(action, "down"), 0) ThenBlock: {
            dy = 1
        }
        IfCondition EqualTo(StringCompare(action, "left"), 0) ThenBlock: {
            dx = Subtract(0, 1)
        }
        IfCondition EqualTo(StringCompare(action, "right"), 0) ThenBlock: {
            dx = 1
        }
        IfCondition EqualTo(StringCompare(action, "wait"), 0) ThenBlock: {
            special = 1
        }
        IfCondition EqualTo(StringCompare(action, "stairs_up"), 0) ThenBlock: {
            special = 2
        }
        IfCondition EqualTo(StringCompare(action, "stairs_down"), 0) ThenBlock: {
            special = 3
        }

        IfCondition Or(NotEqual(dx, 0), NotEqual(dy, 0)) ThenBlock: {
            Game_MovePlayer(dx, dy)
        }
        IfCondition EqualTo(special, 1) ThenBlock: {
            Game_CheckEncounter()
        }
        IfCondition EqualTo(special, 2) ThenBlock: {
            HandleMapTransition(DND_Tiles.STAIRS_UP)
        }
        IfCondition EqualTo(special, 3) ThenBlock: {
            HandleMapTransition(DND_Tiles.STAIRS_DOWN)
        }

        HTML_ServeState(fd)
        ReturnValue(0)
    }
}

// =============================================================================
// SHELL PAGE — self-contained HTML app, built once
// =============================================================================

Function.HTML_ServeShell {
    Input: fd: Integer
    Body: {
        HTML_Reset()

        HTML_OutStr("<!DOCTYPE html><html><head><meta charset=\"utf-8\">")
        HTML_OutStr("<title>OlympusRepo DnD</title><style>")
        HTML_OutStr("*{box-sizing:border-box;margin:0;padding:0}")
        HTML_OutStr("body{background:#0a0a0a;color:#ccc;font-family:monospace;display:flex;flex-direction:column;align-items:center;padding:16px}")
        HTML_OutStr("#title{color:#ffd700;font-size:1.4em;margin-bottom:8px;letter-spacing:2px}")
        HTML_OutStr("#map-name{color:#888;font-size:.85em;margin-bottom:8px}")
        HTML_OutStr("#layout{display:flex;gap:16px;align-items:flex-start}")
        HTML_OutStr("#grid{border:1px solid #333;background:#000;padding:4px;line-height:1.2}")
        HTML_OutStr(".row{display:flex}")
        HTML_OutStr(".cell{width:1ch;text-align:center;white-space:pre}")
        HTML_OutStr(".c0{color:#1a1a1a}.c1{color:#cc3333}.c2{color:#33cc33}.c3{color:#cccc33}")
        HTML_OutStr(".c4{color:#3366cc}.c5{color:#cc33cc}.c6{color:#33cccc}.c7{color:#cccccc}")
        HTML_OutStr(".sb{font-weight:bold}.sd{opacity:.45}")
        HTML_OutStr(".t35{color:#555}.t46{color:#222}")
        HTML_OutStr(".t64{color:#ffd700;font-weight:bold}")
        HTML_OutStr(".t77{color:#cc3333;font-weight:bold}")
        HTML_OutStr(".t60,.t62{color:#33cccc}")
        HTML_OutStr(".t43{color:#cc9933}.t42{color:#cccc33}")
        HTML_OutStr(".t126{color:#3366cc}.t73{color:#33cc33}")
        HTML_OutStr(".t87,.t65{color:#cc9933}")
        HTML_OutStr("#stats{min-width:160px;background:#111;border:1px solid #333;padding:10px;font-size:.85em}")
        HTML_OutStr("#stats h3{color:#ffd700;margin-bottom:8px}")
        HTML_OutStr(".sr{display:flex;justify-content:space-between;margin:3px 0;color:#aaa}")
        HTML_OutStr(".sv{color:#fff}.hp-low{color:#cc3333!important}")
        HTML_OutStr(".bar{height:6px;background:#333;border-radius:3px;margin:2px 0 6px}")
        HTML_OutStr(".bar-fill{height:100%;border-radius:3px;transition:width .2s}")
        HTML_OutStr(".bhp{background:#33cc33}.bmp{background:#3366cc}")
        HTML_OutStr("#msgs{width:100%;max-width:700px;margin-top:10px;background:#111;border:1px solid #333;padding:8px;font-size:.8em;min-height:72px}")
        HTML_OutStr(".msg{color:#aaa;padding:1px 0}.msg:last-child{color:#fff}")
        HTML_OutStr("#help{color:#555;font-size:.75em;margin-top:6px}")
        HTML_OutStr("</style></head><body>")
        HTML_OutStr("<div id=\"title\">&#9889; OlympusRepo DnD &#9889;</div>")
        HTML_OutStr("<div id=\"map-name\"></div>")
        HTML_OutStr("<div id=\"layout\">")
        HTML_OutStr("<div id=\"grid\"></div>")
        HTML_OutStr("<div id=\"stats\"><h3>Character</h3><div id=\"sb\"></div></div>")
        HTML_OutStr("</div>")
        HTML_OutStr("<div id=\"msgs\"></div>")
        HTML_OutStr("<div id=\"help\">WASD/Arrows=move &nbsp; Space=wait &nbsp; I=inventory &nbsp; E=equip</div>")
        HTML_OutStr("<script>")
        HTML_OutStr("const T=n=>String.fromCharCode(n);")
        HTML_OutStr("function rMap(rows){let h='';rows.forEach(r=>{h+='<div class=\"row\">';r.forEach(c=>{const sc=c.s===1?'sb':c.s===2?'sd':'';h+=`<span class=\"cell c${c.c} t${c.t} ${sc}\">${T(c.t)}</span>`;});h+='</div>';});document.getElementById('grid').innerHTML=h;}")
        HTML_OutStr("function rStats(s){const hp=Math.round(s.hp/s.max_hp*100);const mp=s.max_mp>0?Math.round(s.mp/s.max_mp*100):0;const hc=s.hp<s.max_hp*.25?' hp-low':'';")
        HTML_OutStr("document.getElementById('sb').innerHTML=`<div class=sr><span>Name</span><span class='sv'>${s.name}</span></div><div class=sr><span>Class</span><span class=sv>${s.class} ${s.level}</span></div><div class=sr><span>HP</span><span class='sv${hc}'>${s.hp}/${s.max_hp}</span></div><div class=bar><div class='bar-fill bhp' style='width:${hp}%'></div></div><div class=sr><span>MP</span><span class=sv>${s.mp}/${s.max_mp}</span></div><div class=bar><div class='bar-fill bmp' style='width:${mp}%'></div></div><div class=sr><span>Gold</span><span class=sv>${s.gold}g</span></div><div class=sr><span>XP</span><span class=sv>${s.xp}</span></div>`;}")
        HTML_OutStr("function rMsgs(m){const el=document.getElementById('msgs');el.innerHTML=m.map(x=>`<div class=msg>${x}</div>`).join('');el.scrollTop=el.scrollHeight;}")
        HTML_OutStr("function apply(d){rMap(d.map);rStats(d.stats);rMsgs(d.msgs);document.getElementById('map-name').textContent=d.map_name||'';}")
        HTML_OutStr("async function poll(){try{const r=await fetch('/state');apply(await r.json());}catch(e){}setTimeout(poll,")
        HTML_OutInt(HTMLCfg.poll_ms)
        HTML_OutStr(");}")
        HTML_OutStr("poll();")
        HTML_OutStr("const KA={'ArrowUp':'up','ArrowDown':'down','ArrowLeft':'left','ArrowRight':'right','w':'up','s':'down','a':'left','d':'right','W':'up','S':'down','A':'left','D':'right',' ':'wait','i':'inventory','I':'inventory','e':'equip','E':'equip','<':'stairs_up','>':'stairs_down'};")
        HTML_OutStr("document.addEventListener('keydown',async e=>{const a=KA[e.key];if(!a)return;e.preventDefault();try{const r=await fetch('/action',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({action:a})});apply(await r.json());}catch(e){}});")
        HTML_OutStr("</script></body></html>")
        HTML_OutByte(0)

        body_len = Subtract(HTMLOut.pos, 1)
        HTML_SendHTTP(fd, "200 OK", "text/html; charset=utf-8", HTMLOut.buf, body_len)
        ReturnValue(0)
    }
}

// =============================================================================
// HTTP SERVER LOOP
// =============================================================================

Function.HTML_StartServer {
    Output: Integer
    Body: {
        fd = SystemCall(41, 2, 1, 0)
        IfCondition LessThan(fd, 0) ThenBlock: {
            PrintMessage("[HTML] socket fail\n")
            ReturnValue(0)
        }

        opt = Allocate(8)
        StoreValue(opt, 1)
        SystemCall(54, fd, 1, 2, opt, 4)
        Deallocate(opt, 8)

        sa = Allocate(16)
        SetByte(sa, 0, 0)
        SetByte(sa, 1, 2)
        port = HTMLCfg.port
        SetByte(sa, 2, Divide(port, 256))
        SetByte(sa, 3, Modulo(port, 256))
        StoreValue(Add(sa, 4), 0)
        i = 8
        WhileLoop LessThan(i, 16) { SetByte(sa, i, 0)  i = Add(i, 1) }
        bind_r = SystemCall(49, fd, sa, 16)
        Deallocate(sa, 16)

        IfCondition LessThan(bind_r, 0) ThenBlock: {
            PrintMessage("[HTML] bind fail on port ")
            PrintNumber(HTMLCfg.port)
            PrintMessage("\n")
            SystemCall(3, fd)
            ReturnValue(0)
        }

        SystemCall(50, fd, 5)
        WebSrv.listen_fd = fd
        WebSrv.ready = 1

        PrintMessage("[HTML] http://localhost:")
        PrintNumber(HTMLCfg.port)
        PrintMessage("/\n")

        req_buf = Allocate(8192)

        WhileLoop EqualTo(WebSrv.ready, 1) {
            cli = SystemCall(43, fd, 0, 0)
            IfCondition LessThan(cli, 0) ThenBlock: { ContinueLoop }

            n = SystemCall(0, cli, req_buf, 8191)
            IfCondition LessEqual(n, 0) ThenBlock: {
                SystemCall(3, cli)
                ContinueLoop
            }
            SetByte(req_buf, n, 0)

            is_root  = StringStartsWith(req_buf, "GET / ")
            is_state = StringStartsWith(req_buf, "GET /state ")
            is_act   = StringStartsWith(req_buf, "POST /action ")

            IfCondition EqualTo(is_root, 1) ThenBlock: {
                HTML_ServeShell(cli)
            }
            IfCondition EqualTo(is_state, 1) ThenBlock: {
                HTML_ServeState(cli)
            }
            IfCondition EqualTo(is_act, 1) ThenBlock: {
                // Find \r\n\r\n body separator
                body_ptr = req_buf
                bi = 0
                WhileLoop LessThan(bi, Subtract(n, 3)) {
                    c0 = GetByte(req_buf, bi)
                    c1 = GetByte(req_buf, Add(bi, 1))
                    c2 = GetByte(req_buf, Add(bi, 2))
                    c3 = GetByte(req_buf, Add(bi, 3))
                    is_sep = And(EqualTo(c0, 13), And(EqualTo(c1, 10), And(EqualTo(c2, 13), EqualTo(c3, 10))))
                    IfCondition EqualTo(is_sep, 1) ThenBlock: {
                        body_ptr = Add(req_buf, Add(bi, 4))
                        bi = n
                    }
                    bi = Add(bi, 1)
                }
                body_len = Subtract(Add(req_buf, n), body_ptr)
                HTML_HandleAction(cli, body_ptr, body_len)
            }
            IfCondition And(EqualTo(is_root, 0), And(EqualTo(is_state, 0), EqualTo(is_act, 0))) ThenBlock: {
                HTML_SendHTTP(cli, "404 Not Found", "text/plain", "not found", 9)
            }

            SystemCall(3, cli)
        }

        Deallocate(req_buf, 8192)
        SystemCall(3, fd)
        ReturnValue(1)
    }
}

// =============================================================================
// SHUTDOWN
// =============================================================================

Function.HTML_Shutdown {
    Body: {
        WebSrv.ready = 0
        IfCondition GreaterEqual(WebSrv.listen_fd, 0) ThenBlock: {
            SystemCall(3, WebSrv.listen_fd)
            WebSrv.listen_fd = Subtract(0, 1)
        }
        PrintMessage("[HTML] shutdown\n")
        ReturnValue(0)
    }
}