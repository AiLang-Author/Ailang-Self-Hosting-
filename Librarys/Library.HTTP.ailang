// Library.HTTP.ailang — generic HTTP/1.1 client (curl-backed).
//
// Companion to Library.HTTPServer.ailang (which keeps server-side code).
// This file owns the *client* side — outbound requests, including streaming
// POST for SSE / chunked responses (used by Claude Code's Anthropic loop,
// any future REST consumer, Olympus push, etc.).
//
// Implementation is a thin wrapper over `curl` invoked via fork+exec with
// stdin/stdout pipes. Curl handles the hard parts (TLS 1.3, IPv6, redirects,
// chunked encoding, keepalive) so we don't have to. A future native TLS
// rewrite is a drop-in replacement; the public API never mentions curl.
//
// Public API:
//   HTTP.Get(url, headers_str)               -> body_str (one-shot)
//   HTTP.Post(url, headers_str, body_str)    -> body_str (one-shot)
//   HTTP.PostStream(url, headers_str, body)  -> stream_handle
//   HTTP.ReadLine(handle, buf, maxlen)       -> line_len (0 = empty line, -1 = EOF)
//   HTTP.CloseStream(handle)
//
// headers_str format: newline-separated header lines, one per line.
//   "Authorization: Bearer sk-...\nContent-Type: application/json"
// Each line is delivered to curl as a `header = "<line>"` directive in a config
// read from an inherited pipe (`-K /dev/fd/3`) -- NEVER as a command-line
// argument, so API keys do not show up in /proc/<pid>/cmdline or `ps`.
// Lines may not contain newlines themselves (CR/LF are dropped). Empty
// headers_str is fine.
//
// Copyright 2026 Sean Collins, 2 Paws Machine and Engineering. SCSL.

LibraryImport.Arena
LibraryImport.StringUtils

// =============================================================================
// SYSCALL CONSTANTS
// =============================================================================
FixedPool.HSys {
    "SYS_READ":      Initialize=0
    "SYS_WRITE":     Initialize=1
    "SYS_OPEN":      Initialize=2
    "SYS_CLOSE":     Initialize=3
    "SYS_POLL":      Initialize=7
    "SYS_PIPE":      Initialize=22
    "SYS_DUP2":      Initialize=33
    "SYS_FORK":      Initialize=57
    "SYS_EXECVE":    Initialize=59
    "SYS_EXIT":      Initialize=60
    "SYS_WAIT4":     Initialize=61
    "SYS_FCNTL":     Initialize=72
}

FixedPool.HFcntl {
    "F_GETFL":       Initialize=3
    "F_SETFL":       Initialize=4
    "O_NONBLOCK":    Initialize=2048
    "F_DUPFD":       Initialize=0
}

FixedPool.HConst {
    "MAX_HEADERS":   Initialize=32
    "READ_BUF_SZ":   Initialize=8192
    "HANDLE_SZ":     Initialize=96
    "STATUS_BUF_SZ": Initialize=1024
    "CURL_PATH":     Initialize=0, CanChange=True
}

// Stream handle layout (96 bytes):
//   [0]   stdin_fd  (dword)
//   [4]   stdout_fd (dword)
//   [8]   pid       (qword)
//   [16]  line_buf  (Address)
//   [24]  buf_pos   (dword) — read cursor in line_buf
//   [28]  buf_end   (dword) — end of valid data in line_buf
//   [32]  eof_flag  (dword) — 1 once read returned 0/err
//   [36]  reserved  (dword)
//   [40]  status_fd (dword) — read end of curl's -w record pipe, -1 once consumed
//   [44]  st_loaded (dword) — 1 once the -w record has been parsed
//   [48]  code      (qword) — HTTP status; -1 unknown, 0 no HTTP response
//   [56]  retry_aft (qword) — Retry-After seconds (0 = none)
//   [64]  req_id    (Address) — into status_buf
//   [72]  errmsg    (Address) — into status_buf
//   [80]  exitcode  (qword) — curl exit code
//   [88]  status_buf (Address) — owned, freed by CloseStream
FixedPool.HHandleOff {
    "STDIN_FD":      Initialize=0
    "STDOUT_FD":     Initialize=4
    "PID":           Initialize=8
    "LINE_BUF":      Initialize=16
    "BUF_POS":       Initialize=24
    "BUF_END":       Initialize=28
    "EOF":           Initialize=32
    "STATUS_FD":     Initialize=40
    "ST_LOADED":     Initialize=44
    "CODE":          Initialize=48
    "RETRY_AFTER":   Initialize=56
    "REQ_ID":        Initialize=64
    "ERRMSG":        Initialize=72
    "EXITCODE":      Initialize=80
    "STATUS_BUF":    Initialize=88
}

// =============================================================================
// HEADER COUNTING / SCANNING
// =============================================================================

// Count non-empty header lines in headers_str. headers_str may be 0/null.
Function.HTTP_CountHeaders {
    Input: hdr: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(hdr, 0) ThenBlock: { ReturnValue(0) }
        n = 0
        i = 0
        line_has_text = 0
        WhileLoop 1 {
            ch = GetByte(hdr, i)
            IfCondition EqualTo(ch, 0) ThenBlock: {
                IfCondition EqualTo(line_has_text, 1) ThenBlock: { n = Add(n, 1) }
                ReturnValue(n)
            }
            IfCondition EqualTo(ch, 10) ThenBlock: {
                IfCondition EqualTo(line_has_text, 1) ThenBlock: { n = Add(n, 1) }
                line_has_text = 0
            } ElseBlock: {
                line_has_text = 1
            }
            i = Add(i, 1)
        }
        ReturnValue(n)
    }
}

// Allocate a fresh null-terminated copy of headers_str[start..end].
Function.HTTP_DupSlice {
    Input: src: Address
    Input: start: Integer
    Input: len: Integer
    Output: Address
    Body: {
        out = Allocate(Add(len, 1))
        i = 0
        WhileLoop LessThan(i, len) {
            SetByte(out, i, GetByte(src, Add(start, i)))
            i = Add(i, 1)
        }
        SetByte(out, len, 0)
        ReturnValue(out)
    }
}

// =============================================================================
// CURL CONFIG BUILDER — headers and URL are delivered to curl through a config
// read from an inherited pipe (`-K /dev/fd/3`), NOT through argv. argv is
// world-readable via /proc/<pid>/cmdline and `ps`; API keys must never be there.
//
// Output format (one directive per line, values double-quoted with \ and "
// escaped, which is curl's config-file syntax):
//   header = "Expect:"                [POST only: suppress 100-continue]
//   header = "<line>"                 [one per non-empty header line]
//   url = "<url>"
// Returns a NUL-terminated heap buffer. Caller Deallocates it with
// HTTP_CfgCap(url, headers_str) bytes.
// =============================================================================

// Upper bound on the config buffer size for these inputs.
Function.HTTP_CfgCap {
    Input: url: Address
    Input: headers_str: Address
    Output: Integer
    Body: {
        hl = 0
        IfCondition NotEqual(headers_str, 0) ThenBlock: { hl = StringLength(headers_str) }
        ul = StringLength(url)
        n_hdr = HTTP_CountHeaders(headers_str)
        // Worst case every byte is escaped (x2); each directive adds <= 16 bytes
        // of framing ("header = \"" + "\"\n"); +64 slack for the NUL and Expect line.
        cap = Add(Multiply(Add(hl, ul), 2), Multiply(Add(n_hdr, 3), 16))
        ReturnValue(Add(cap, 64))
    }
}

// Append NUL-terminated string `s` verbatim at buf[pos]. Returns the new pos.
Function.HTTP_CfgPut {
    Input: buf: Address
    Input: pos: Integer
    Input: s: Address
    Output: Integer
    Body: {
        p = pos
        i = 0
        WhileLoop 1 {
            ch = GetByte(s, i)
            IfCondition EqualTo(ch, 0) ThenBlock: { BreakLoop }
            SetByte(buf, p, ch)
            p = Add(p, 1)
            i = Add(i, 1)
        }
        ReturnValue(p)
    }
}

// Append src[start .. start+len) at buf[pos], escaping \ and " for curl's
// config syntax and dropping CR/LF (a header value cannot contain them, and
// a raw newline would let a value inject extra config directives).
// Returns the new pos.
Function.HTTP_CfgPutEsc {
    Input: buf: Address
    Input: pos: Integer
    Input: src: Address
    Input: start: Integer
    Input: len: Integer
    Output: Integer
    Body: {
        p = pos
        i = 0
        WhileLoop LessThan(i, len) {
            ch = GetByte(src, Add(start, i))
            skip = 0
            IfCondition Or(EqualTo(ch, 13), EqualTo(ch, 10)) ThenBlock: { skip = 1 }
            IfCondition EqualTo(skip, 0) ThenBlock: {
                IfCondition Or(EqualTo(ch, 92), EqualTo(ch, 34)) ThenBlock: {
                    SetByte(buf, p, 92)
                    p = Add(p, 1)
                }
                SetByte(buf, p, ch)
                p = Add(p, 1)
            }
            i = Add(i, 1)
        }
        ReturnValue(p)
    }
}

Function.HTTP_BuildConfig {
    Input: url: Address
    Input: headers_str: Address
    Input: with_post: Integer
    Output: Address
    Body: {
        cap = HTTP_CfgCap(url, headers_str)
        buf = Allocate(cap)
        p = 0

        IfCondition EqualTo(with_post, 1) ThenBlock: {
            p = HTTP_CfgPut(buf, p, "header = \"Expect:\"\n")
        }

        IfCondition NotEqual(headers_str, 0) ThenBlock: {
            i = 0
            line_start = 0
            WhileLoop 1 {
                ch = GetByte(headers_str, i)
                at_end = 0
                IfCondition EqualTo(ch, 0) ThenBlock: { at_end = 1 }
                IfCondition Or(EqualTo(ch, 10), EqualTo(at_end, 1)) ThenBlock: {
                    line_len = Subtract(i, line_start)
                    IfCondition GreaterThan(line_len, 0) ThenBlock: {
                        p = HTTP_CfgPut(buf, p, "header = \"")
                        p = HTTP_CfgPutEsc(buf, p, headers_str, line_start, line_len)
                        p = HTTP_CfgPut(buf, p, "\"\n")
                    }
                    line_start = Add(i, 1)
                }
                IfCondition EqualTo(at_end, 1) ThenBlock: { BreakLoop }
                i = Add(i, 1)
            }
        }

        p = HTTP_CfgPut(buf, p, "url = \"")
        p = HTTP_CfgPutEsc(buf, p, url, 0, StringLength(url))
        p = HTTP_CfgPut(buf, p, "\"\n")
        SetByte(buf, p, 0)
        ReturnValue(buf)
    }
}

// =============================================================================
// ARGV BUILDER — assembles the curl command line.
// Contains NO secrets and NO url: those travel in the config pipe (fd 3).
//
// conn_s / max_s are decimal-second strings for --connect-timeout / -m.
// -w writes a small status record to fd 4 (NOT stdout, so the response stream
// is untouched). Fields, one per line: http_code, retry-after, request-id,
// curl errormsg, curl exitcode. http_code is 000 when no HTTP response arrived.
//
// Layout:
//   ["/usr/bin/curl", "-sS", "-N", "--limit-rate", "1M",
//    "--connect-timeout", conn_s, "-m", max_s,
//    "-w", <status format>,
//    [POST: "-X", "POST", "--data-binary", "@-"],
//    "-K", "/dev/fd/3", NULL]
// =============================================================================
Function.HTTP_BuildArgv {
    Input: with_post: Integer
    Input: conn_s: Address
    Input: max_s: Address
    Output: Address
    Body: {
        // 11 fixed + 4 POST + 2 (-K fd) + 1 NULL = 18 slots max; allocate 20.
        argv = Allocate(160)
        IfCondition EqualTo(HConst.CURL_PATH, 0) ThenBlock: {
            HConst.CURL_PATH = "/usr/bin/curl"
        }
        idx = 0
        StoreValue(Add(argv, Multiply(idx, 8)), HConst.CURL_PATH)
        idx = Add(idx, 1)
        StoreValue(Add(argv, Multiply(idx, 8)), "-sS")
        idx = Add(idx, 1)
        StoreValue(Add(argv, Multiply(idx, 8)), "-N")
        idx = Add(idx, 1)
        StoreValue(Add(argv, Multiply(idx, 8)), "--limit-rate")
        idx = Add(idx, 1)
        StoreValue(Add(argv, Multiply(idx, 8)), "1M")
        idx = Add(idx, 1)
        StoreValue(Add(argv, Multiply(idx, 8)), "--connect-timeout")
        idx = Add(idx, 1)
        StoreValue(Add(argv, Multiply(idx, 8)), conn_s)
        idx = Add(idx, 1)
        StoreValue(Add(argv, Multiply(idx, 8)), "-m")
        idx = Add(idx, 1)
        StoreValue(Add(argv, Multiply(idx, 8)), max_s)
        idx = Add(idx, 1)
        StoreValue(Add(argv, Multiply(idx, 8)), "-w")
        idx = Add(idx, 1)
        StoreValue(Add(argv, Multiply(idx, 8)), "%output{/dev/fd/4}%{http_code}\n%header{retry-after}\n%header{request-id}\n%{errormsg}\n%{exitcode}\n")
        idx = Add(idx, 1)
        IfCondition EqualTo(with_post, 1) ThenBlock: {
            StoreValue(Add(argv, Multiply(idx, 8)), "-X")
            idx = Add(idx, 1)
            StoreValue(Add(argv, Multiply(idx, 8)), "POST")
            idx = Add(idx, 1)
            StoreValue(Add(argv, Multiply(idx, 8)), "--data-binary")
            idx = Add(idx, 1)
            StoreValue(Add(argv, Multiply(idx, 8)), "@-")
            idx = Add(idx, 1)
        }
        StoreValue(Add(argv, Multiply(idx, 8)), "-K")
        idx = Add(idx, 1)
        StoreValue(Add(argv, Multiply(idx, 8)), "/dev/fd/3")
        idx = Add(idx, 1)
        StoreValue(Add(argv, Multiply(idx, 8)), 0)
        ReturnValue(argv)
    }
}

// Milliseconds -> whole seconds as a decimal string, rounded up. A value <= 0
// selects `default_s` (the library's historical defaults: 10s connect, 180s total).
Function.HTTP_MsToSecStr {
    Input: ms: Integer
    Input: default_s: Integer
    Output: Address
    Body: {
        s = default_s
        IfCondition GreaterThan(ms, 0) ThenBlock: {
            s = Divide(Add(ms, 999), 1000)
        }
        IfCondition LessThan(s, 1) ThenBlock: { s = 1 }
        ReturnValue(NumberToString(s))
    }
}

// =============================================================================
// FORK+EXEC CURL — returns stream handle, or 0 on failure.
// If body_str non-zero, body is written to curl's stdin and stdin closed.
//
// fd plumbing for the child:
//   0 = stdin pipe (request body)      1 = stdout pipe (response)
//   2 = /dev/null                      3 = config pipe (headers + url)
//   4 = status pipe (-w record)
// The config is written and its write end closed BEFORE fork, so the child
// holds the only reference and curl sees EOF as soon as it has read it.
// conn_ms / max_ms are the caller's timeouts in milliseconds (<= 0 = default).
// =============================================================================
Function.HTTP_SpawnCurl {
    Input: url: Address
    Input: headers_str: Address
    Input: body_str: Address
    Input: with_post: Integer
    Input: conn_ms: Integer
    Input: max_ms: Integer
    Output: Address
    Body: {
        // Build the config first so oversized input fails before any fd is open.
        // A pipe buffers 64 KiB; the config is written before curl exists, so it
        // must fit or the write would block forever.
        cfg = HTTP_BuildConfig(url, headers_str, with_post)
        cfg_len = StringLength(cfg)
        cfg_cap = HTTP_CfgCap(url, headers_str)
        IfCondition GreaterThan(cfg_len, 60000) ThenBlock: {
            Deallocate(cfg, cfg_cap)
            ReturnValue(0)
        }

        // config pipe (parent writes before fork, child reads as fd 3)
        cfg_pf = Allocate(8)
        cpr = SystemCall(HSys.SYS_PIPE, cfg_pf, 0, 0, 0, 0)
        IfCondition LessThan(cpr, 0) ThenBlock: {
            Deallocate(cfg_pf, 8)
            Deallocate(cfg, cfg_cap)
            ReturnValue(0)
        }
        cfg_read  = Dereference(cfg_pf, "dword")
        cfg_write = Dereference(Add(cfg_pf, 4), "dword")
        Deallocate(cfg_pf, 8)

        cw = 0
        WhileLoop LessThan(cw, cfg_len) {
            w = SystemCall(HSys.SYS_WRITE, cfg_write, Add(cfg, cw), Subtract(cfg_len, cw), 0, 0)
            IfCondition LessEqual(w, 0) ThenBlock: { BreakLoop }
            cw = Add(cw, w)
        }
        SystemCall(HSys.SYS_CLOSE, cfg_write, 0, 0, 0, 0)
        // Scrub the secret-bearing buffer before releasing it.
        MemorySet(cfg, 0, cfg_cap)
        Deallocate(cfg, cfg_cap)
        IfCondition LessThan(cw, cfg_len) ThenBlock: {
            SystemCall(HSys.SYS_CLOSE, cfg_read, 0, 0, 0, 0)
            ReturnValue(0)
        }

        // status pipe (child writes the -w record as fd 4, parent reads)
        st_pf = Allocate(8)
        spr = SystemCall(HSys.SYS_PIPE, st_pf, 0, 0, 0, 0)
        IfCondition LessThan(spr, 0) ThenBlock: {
            Deallocate(st_pf, 8)
            SystemCall(HSys.SYS_CLOSE, cfg_read, 0, 0, 0, 0)
            ReturnValue(0)
        }
        st_read  = Dereference(st_pf, "dword")
        st_write = Dereference(Add(st_pf, 4), "dword")
        Deallocate(st_pf, 8)

        // stdin pipe (parent writes, child reads)
        in_pf = Allocate(8)
        ipr = SystemCall(HSys.SYS_PIPE, in_pf, 0, 0, 0, 0)
        IfCondition LessThan(ipr, 0) ThenBlock: {
            Deallocate(in_pf, 8)
            SystemCall(HSys.SYS_CLOSE, cfg_read, 0, 0, 0, 0)
            SystemCall(HSys.SYS_CLOSE, st_read, 0, 0, 0, 0)
            SystemCall(HSys.SYS_CLOSE, st_write, 0, 0, 0, 0)
            ReturnValue(0)
        }
        in_read  = Dereference(in_pf, "dword")
        in_write = Dereference(Add(in_pf, 4), "dword")
        Deallocate(in_pf, 8)

        // stdout pipe (child writes, parent reads)
        out_pf = Allocate(8)
        opr = SystemCall(HSys.SYS_PIPE, out_pf, 0, 0, 0, 0)
        IfCondition LessThan(opr, 0) ThenBlock: {
            SystemCall(HSys.SYS_CLOSE, in_read, 0, 0, 0, 0)
            SystemCall(HSys.SYS_CLOSE, in_write, 0, 0, 0, 0)
            SystemCall(HSys.SYS_CLOSE, cfg_read, 0, 0, 0, 0)
            SystemCall(HSys.SYS_CLOSE, st_read, 0, 0, 0, 0)
            SystemCall(HSys.SYS_CLOSE, st_write, 0, 0, 0, 0)
            Deallocate(out_pf, 8)
            ReturnValue(0)
        }
        out_read  = Dereference(out_pf, "dword")
        out_write = Dereference(Add(out_pf, 4), "dword")
        Deallocate(out_pf, 8)

        conn_s = HTTP_MsToSecStr(conn_ms, 10)
        max_s  = HTTP_MsToSecStr(max_ms, 180)
        argv = HTTP_BuildArgv(with_post, conn_s, max_s)

        pid = SystemCall(HSys.SYS_FORK, 0, 0, 0, 0, 0)
        IfCondition LessThan(pid, 0) ThenBlock: {
            SystemCall(HSys.SYS_CLOSE, in_read, 0, 0, 0, 0)
            SystemCall(HSys.SYS_CLOSE, in_write, 0, 0, 0, 0)
            SystemCall(HSys.SYS_CLOSE, out_read, 0, 0, 0, 0)
            SystemCall(HSys.SYS_CLOSE, out_write, 0, 0, 0, 0)
            SystemCall(HSys.SYS_CLOSE, cfg_read, 0, 0, 0, 0)
            SystemCall(HSys.SYS_CLOSE, st_read, 0, 0, 0, 0)
            SystemCall(HSys.SYS_CLOSE, st_write, 0, 0, 0, 0)
            Deallocate(argv, 160)
            ReturnValue(0)
        }

        IfCondition EqualTo(pid, 0) ThenBlock: {
            // Child. First move the config and status fds out of the low range
            // (>= 10) so none of the dup2/close calls below can clobber them, no
            // matter which numbers the pipes happened to get.
            cfg_hi = SystemCall(HSys.SYS_FCNTL, cfg_read, HFcntl.F_DUPFD, 10, 0, 0)
            st_hi  = SystemCall(HSys.SYS_FCNTL, st_write, HFcntl.F_DUPFD, 10, 0, 0)
            IfCondition Or(LessThan(cfg_hi, 0), LessThan(st_hi, 0)) ThenBlock: {
                SystemCall(HSys.SYS_EXIT, 1, 0, 0, 0, 0)
            }
            SystemCall(HSys.SYS_CLOSE, cfg_read, 0, 0, 0, 0)
            SystemCall(HSys.SYS_CLOSE, st_write, 0, 0, 0, 0)
            SystemCall(HSys.SYS_CLOSE, st_read, 0, 0, 0, 0)
            SystemCall(HSys.SYS_CLOSE, in_write, 0, 0, 0, 0)
            SystemCall(HSys.SYS_CLOSE, out_read, 0, 0, 0, 0)
            SystemCall(HSys.SYS_DUP2, in_read, 0, 0, 0, 0)
            SystemCall(HSys.SYS_CLOSE, in_read, 0, 0, 0, 0)
            SystemCall(HSys.SYS_DUP2, out_write, 1, 0, 0, 0)
            SystemCall(HSys.SYS_CLOSE, out_write, 0, 0, 0, 0)
            null_fd = SystemCall(HSys.SYS_OPEN, "/dev/null", 1, 0, 0, 0)
            IfCondition GreaterEqual(null_fd, 0) ThenBlock: {
                SystemCall(HSys.SYS_DUP2, null_fd, 2, 0, 0, 0)
                SystemCall(HSys.SYS_CLOSE, null_fd, 0, 0, 0, 0)
            }
            // argv says -K /dev/fd/3 and -w ...%output{/dev/fd/4}. Done last.
            SystemCall(HSys.SYS_DUP2, cfg_hi, 3, 0, 0, 0)
            SystemCall(HSys.SYS_CLOSE, cfg_hi, 0, 0, 0, 0)
            SystemCall(HSys.SYS_DUP2, st_hi, 4, 0, 0, 0)
            SystemCall(HSys.SYS_CLOSE, st_hi, 0, 0, 0, 0)
            SystemCall(HSys.SYS_EXECVE, HConst.CURL_PATH, argv, 0)
            SystemCall(HSys.SYS_EXIT, 1, 0, 0, 0, 0)
        }

        // Parent
        SystemCall(HSys.SYS_CLOSE, in_read, 0, 0, 0, 0)
        SystemCall(HSys.SYS_CLOSE, out_write, 0, 0, 0, 0)
        SystemCall(HSys.SYS_CLOSE, cfg_read, 0, 0, 0, 0)
        SystemCall(HSys.SYS_CLOSE, st_write, 0, 0, 0, 0)
        Deallocate(argv, 160)

        // Write body if any, then close stdin so curl sends and waits for response
        IfCondition NotEqual(body_str, 0) ThenBlock: {
            blen = StringLength(body_str)
            IfCondition GreaterThan(blen, 0) ThenBlock: {
                written = 0
                WhileLoop LessThan(written, blen) {
                    w = SystemCall(HSys.SYS_WRITE, in_write, Add(body_str, written), Subtract(blen, written), 0, 0)
                    IfCondition LessEqual(w, 0) ThenBlock: { BreakLoop }
                    written = Add(written, w)
                }
            }
        }
        SystemCall(HSys.SYS_CLOSE, in_write, 0, 0, 0, 0)

        // Allocate handle
        h = Allocate(HConst.HANDLE_SZ)
        MemorySet(h, 0, HConst.HANDLE_SZ)
        StoreValue(Add(h, HHandleOff.STDIN_FD), -1, "dword")
        StoreValue(Add(h, HHandleOff.STDOUT_FD), out_read, "dword")
        StoreValue(Add(h, HHandleOff.PID), pid)
        line_buf = Allocate(HConst.READ_BUF_SZ)
        StoreValue(Add(h, HHandleOff.LINE_BUF), line_buf)
        StoreValue(Add(h, HHandleOff.BUF_POS), 0, "dword")
        StoreValue(Add(h, HHandleOff.BUF_END), 0, "dword")
        StoreValue(Add(h, HHandleOff.EOF), 0, "dword")
        StoreValue(Add(h, HHandleOff.STATUS_FD), st_read, "dword")
        StoreValue(Add(h, HHandleOff.ST_LOADED), 0, "dword")
        StoreValue(Add(h, HHandleOff.CODE), -1)

        ReturnValue(h)
    }
}

// =============================================================================
// PUBLIC: STREAMING GET
// =============================================================================
Function.HTTP.GetStream {
    Input: url: Address
    Input: headers_str: Address
    Input: conn_to: Integer
    Input: max_to: Integer
    Output: Address
    Body: {
        ReturnValue(HTTP_SpawnCurl(url, headers_str, 0, 0, conn_to, max_to))
    }
}

// =============================================================================
// PUBLIC: STREAMING POST
// =============================================================================
Function.HTTP.PostStream {
    Input: url: Address
    Input: headers_str: Address
    Input: body_str: Address
    Input: conn_to: Integer
    Input: max_to: Integer
    Output: Address
    Body: {
        ReturnValue(HTTP_SpawnCurl(url, headers_str, body_str, 1, conn_to, max_to))
    }
}

// =============================================================================
// PUBLIC: READ ONE LINE FROM STREAM
// Returns:
//    >0 = number of bytes copied into caller's buf (newline stripped)
//     0 = blank line (consumed \n only)
//    -1 = EOF, no more data
//
// CR (\r) is stripped from the end if present (handles \r\n endings).
// Lines longer than maxlen are truncated; the rest of the line is dropped.
// =============================================================================
Function.HTTP.ReadLine {
    Input: handle: Address
    Input: out_buf: Address
    Input: maxlen: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(handle, 0) ThenBlock: { ReturnValue(-1) }
        line_buf = Dereference(Add(handle, HHandleOff.LINE_BUF))
        fd = Dereference(Add(handle, HHandleOff.STDOUT_FD), "dword")

        WhileLoop 1 {
            pos = Dereference(Add(handle, HHandleOff.BUF_POS), "dword")
            end = Dereference(Add(handle, HHandleOff.BUF_END), "dword")

            // Search for newline in [pos, end)
            scan = pos
            found = -1
            WhileLoop LessThan(scan, end) {
                IfCondition EqualTo(GetByte(line_buf, scan), 10) ThenBlock: {
                    found = scan
                    BreakLoop
                }
                scan = Add(scan, 1)
            }

            IfCondition GreaterEqual(found, 0) ThenBlock: {
                line_len = Subtract(found, pos)
                // Strip trailing \r
                IfCondition GreaterThan(line_len, 0) ThenBlock: {
                    last = GetByte(line_buf, Subtract(found, 1))
                    IfCondition EqualTo(last, 13) ThenBlock: {
                        line_len = Subtract(line_len, 1)
                    }
                }
                copy_n = line_len
                IfCondition GreaterThan(copy_n, maxlen) ThenBlock: { copy_n = maxlen }
                j = 0
                WhileLoop LessThan(j, copy_n) {
                    SetByte(out_buf, j, GetByte(line_buf, Add(pos, j)))
                    j = Add(j, 1)
                }
                StoreValue(Add(handle, HHandleOff.BUF_POS), Add(found, 1), "dword")
                ReturnValue(copy_n)
            }

            // No newline yet — refill the buffer
            eof_flag = Dereference(Add(handle, HHandleOff.EOF), "dword")
            IfCondition EqualTo(eof_flag, 1) ThenBlock: {
                // Final partial line if any
                tail_len = Subtract(end, pos)
                IfCondition GreaterThan(tail_len, 0) ThenBlock: {
                    copy_n = tail_len
                    IfCondition GreaterThan(copy_n, maxlen) ThenBlock: { copy_n = maxlen }
                    j = 0
                    WhileLoop LessThan(j, copy_n) {
                        SetByte(out_buf, j, GetByte(line_buf, Add(pos, j)))
                        j = Add(j, 1)
                    }
                    StoreValue(Add(handle, HHandleOff.BUF_POS), end, "dword")
                    ReturnValue(copy_n)
                }
                ReturnValue(-1)
            }

            // Compact buffer: move [pos,end) to [0, end-pos)
            tail_len = Subtract(end, pos)
            IfCondition GreaterThan(tail_len, 0) ThenBlock: {
                k = 0
                WhileLoop LessThan(k, tail_len) {
                    SetByte(line_buf, k, GetByte(line_buf, Add(pos, k)))
                    k = Add(k, 1)
                }
            }
            StoreValue(Add(handle, HHandleOff.BUF_POS), 0, "dword")
            StoreValue(Add(handle, HHandleOff.BUF_END), tail_len, "dword")

            // Read more
            free_space = Subtract(HConst.READ_BUF_SZ, tail_len)
            IfCondition LessEqual(free_space, 0) ThenBlock: {
                // Buffer full and no newline — return what we have, drop the rest
                copy_n = HConst.READ_BUF_SZ
                IfCondition GreaterThan(copy_n, maxlen) ThenBlock: { copy_n = maxlen }
                j = 0
                WhileLoop LessThan(j, copy_n) {
                    SetByte(out_buf, j, GetByte(line_buf, j))
                    j = Add(j, 1)
                }
                StoreValue(Add(handle, HHandleOff.BUF_POS), HConst.READ_BUF_SZ, "dword")
                ReturnValue(copy_n)
            }
            n = SystemCall(HSys.SYS_READ, fd, Add(line_buf, tail_len), free_space, 0, 0)
            IfCondition LessEqual(n, 0) ThenBlock: {
                StoreValue(Add(handle, HHandleOff.EOF), 1, "dword")
                // Loop around — next iteration handles tail or returns -1
            } ElseBlock: {
                StoreValue(Add(handle, HHandleOff.BUF_END), Add(tail_len, n), "dword")
            }
        }
        ReturnValue(-1)
    }
}

// =============================================================================
// PUBLIC: READ LINE WITH TIMEOUT
// Like ReadLine but polls before blocking. Returns -2 when timeout_ms
// elapses with no data available — caller should tick animations and retry.
// Returns -1 on EOF, >= 0 on success (line length).
//
// struct pollfd layout: fd(dword@0) + events(dword@4 = POLLIN|revents=0).
// SYS_POLL(7): poll(pfd, 1, timeout_ms). 0=timeout, >0=ready, <0=error.
// =============================================================================
Function.HTTP.ReadLineTimeout {
    Input: handle: Address
    Input: out_buf: Address
    Input: maxlen: Integer
    Input: timeout_ms: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(handle, 0) ThenBlock: { ReturnValue(-1) }
        line_buf = Dereference(Add(handle, HHandleOff.LINE_BUF))
        fd = Dereference(Add(handle, HHandleOff.STDOUT_FD), "dword")

        WhileLoop 1 {
            pos = Dereference(Add(handle, HHandleOff.BUF_POS), "dword")
            end = Dereference(Add(handle, HHandleOff.BUF_END), "dword")

            scan = pos
            found = -1
            WhileLoop LessThan(scan, end) {
                IfCondition EqualTo(GetByte(line_buf, scan), 10) ThenBlock: {
                    found = scan
                    BreakLoop
                }
                scan = Add(scan, 1)
            }

            IfCondition GreaterEqual(found, 0) ThenBlock: {
                line_len = Subtract(found, pos)
                IfCondition GreaterThan(line_len, 0) ThenBlock: {
                    last = GetByte(line_buf, Subtract(found, 1))
                    IfCondition EqualTo(last, 13) ThenBlock: {
                        line_len = Subtract(line_len, 1)
                    }
                }
                copy_n = line_len
                IfCondition GreaterThan(copy_n, maxlen) ThenBlock: { copy_n = maxlen }
                j = 0
                WhileLoop LessThan(j, copy_n) {
                    SetByte(out_buf, j, GetByte(line_buf, Add(pos, j)))
                    j = Add(j, 1)
                }
                StoreValue(Add(handle, HHandleOff.BUF_POS), Add(found, 1), "dword")
                ReturnValue(copy_n)
            }

            eof_flag = Dereference(Add(handle, HHandleOff.EOF), "dword")
            IfCondition EqualTo(eof_flag, 1) ThenBlock: {
                tail_len = Subtract(end, pos)
                IfCondition GreaterThan(tail_len, 0) ThenBlock: {
                    copy_n = tail_len
                    IfCondition GreaterThan(copy_n, maxlen) ThenBlock: { copy_n = maxlen }
                    j = 0
                    WhileLoop LessThan(j, copy_n) {
                        SetByte(out_buf, j, GetByte(line_buf, Add(pos, j)))
                        j = Add(j, 1)
                    }
                    StoreValue(Add(handle, HHandleOff.BUF_POS), end, "dword")
                    ReturnValue(copy_n)
                }
                ReturnValue(-1)
            }

            // Compact buffer: move [pos,end) to front
            tail_len = Subtract(end, pos)
            IfCondition GreaterThan(tail_len, 0) ThenBlock: {
                k = 0
                WhileLoop LessThan(k, tail_len) {
                    SetByte(line_buf, k, GetByte(line_buf, Add(pos, k)))
                    k = Add(k, 1)
                }
            }
            StoreValue(Add(handle, HHandleOff.BUF_POS), 0, "dword")
            StoreValue(Add(handle, HHandleOff.BUF_END), tail_len, "dword")

            free_space = Subtract(HConst.READ_BUF_SZ, tail_len)
            IfCondition LessEqual(free_space, 0) ThenBlock: {
                copy_n = HConst.READ_BUF_SZ
                IfCondition GreaterThan(copy_n, maxlen) ThenBlock: { copy_n = maxlen }
                j = 0
                WhileLoop LessThan(j, copy_n) {
                    SetByte(out_buf, j, GetByte(line_buf, j))
                    j = Add(j, 1)
                }
                StoreValue(Add(handle, HHandleOff.BUF_POS), HConst.READ_BUF_SZ, "dword")
                ReturnValue(copy_n)
            }

            // poll(fd, POLLIN=1, timeout_ms) — return -2 if no data yet
            pfd = Allocate(8)
            StoreValue(pfd, fd, "dword")
            StoreValue(Add(pfd, 4), 1, "dword")   // events=POLLIN(1), revents=0
            pr = SystemCall(HSys.SYS_POLL, pfd, 1, timeout_ms, 0, 0)
            Deallocate(pfd, 8)
            IfCondition EqualTo(pr, 0) ThenBlock: { ReturnValue(-2) }
            IfCondition LessThan(pr, 0) ThenBlock: {
                StoreValue(Add(handle, HHandleOff.EOF), 1, "dword")
                ReturnValue(-1)
            }

            n = SystemCall(HSys.SYS_READ, fd, Add(line_buf, tail_len), free_space, 0, 0)
            IfCondition LessEqual(n, 0) ThenBlock: {
                StoreValue(Add(handle, HHandleOff.EOF), 1, "dword")
            } ElseBlock: {
                StoreValue(Add(handle, HHandleOff.BUF_END), Add(tail_len, n), "dword")
            }
        }
        ReturnValue(-1)
    }
}

// =============================================================================
// PUBLIC: CLOSE STREAM
// Closes fds, reaps the curl child, frees the handle.
// =============================================================================
Function.HTTP.CloseStream {
    Input: handle: Address
    Body: {
        IfCondition EqualTo(handle, 0) ThenBlock: { ReturnValue(0) }
        fd = Dereference(Add(handle, HHandleOff.STDOUT_FD), "dword")
        IfCondition GreaterEqual(fd, 0) ThenBlock: {
            SystemCall(HSys.SYS_CLOSE, fd, 0, 0, 0, 0)
        }
        line_buf = Dereference(Add(handle, HHandleOff.LINE_BUF))
        IfCondition NotEqual(line_buf, 0) ThenBlock: {
            Deallocate(line_buf, HConst.READ_BUF_SZ)
        }
        sfd = Dereference(Add(handle, HHandleOff.STATUS_FD), "dword")
        IfCondition GreaterEqual(sfd, 0) ThenBlock: {
            SystemCall(HSys.SYS_CLOSE, sfd, 0, 0, 0, 0)
        }
        sbuf = Dereference(Add(handle, HHandleOff.STATUS_BUF))
        IfCondition NotEqual(sbuf, 0) ThenBlock: {
            Deallocate(sbuf, HConst.STATUS_BUF_SZ)
        }
        // Reap child (non-blocking) — best effort
        pid = Dereference(Add(handle, HHandleOff.PID))
        IfCondition GreaterThan(pid, 0) ThenBlock: {
            status = Allocate(8)
            SystemCall(HSys.SYS_WAIT4, pid, status, 0, 0, 0, 0)
            Deallocate(status, 8)
        }
        Deallocate(handle, HConst.HANDLE_SZ)
    }
}

// =============================================================================
// PUBLIC: ONE-SHOT GET — drains the response body into a single string.
// Returns 0 on failure.
// =============================================================================
Function.HTTP.Get {
    Input: url: Address
    Input: headers_str: Address
    Output: Address
    Body: {
        h = HTTP_SpawnCurl(url, headers_str, 0, 0, 0, 0)
        IfCondition EqualTo(h, 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(HTTP_DrainAll(h))
    }
}

// =============================================================================
// PUBLIC: ONE-SHOT POST — drains the response body into a single string.
// =============================================================================
Function.HTTP.Post {
    Input: url: Address
    Input: headers_str: Address
    Input: body_str: Address
    Output: Address
    Body: {
        h = HTTP_SpawnCurl(url, headers_str, body_str, 1, 0, 0)
        IfCondition EqualTo(h, 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(HTTP_DrainAll(h))
    }
}

// =============================================================================
// INTERNAL: drain a stream handle into a single allocated string.
// =============================================================================
Function.HTTP_DrainAll {
    Input: handle: Address
    Output: Address
    Body: {
        cap = 8192
        out = Allocate(cap)
        used = 0
        fd = Dereference(Add(handle, HHandleOff.STDOUT_FD), "dword")
        WhileLoop 1 {
            free_space = Subtract(cap, Add(used, 1))
            IfCondition LessEqual(free_space, 0) ThenBlock: {
                new_cap = Multiply(cap, 2)
                bigger = Allocate(new_cap)
                k = 0
                WhileLoop LessThan(k, used) {
                    SetByte(bigger, k, GetByte(out, k))
                    k = Add(k, 1)
                }
                Deallocate(out, cap)
                out = bigger
                cap = new_cap
                free_space = Subtract(cap, Add(used, 1))
            }
            n = SystemCall(HSys.SYS_READ, fd, Add(out, used), free_space, 0, 0)
            IfCondition LessEqual(n, 0) ThenBlock: { BreakLoop }
            used = Add(used, n)
        }
        SetByte(out, used, 0)
        HTTP.CloseStream(handle)
        ReturnValue(out)
    }
}

// =============================================================================
// PUBLIC: RESPONSE STATUS (read from curl's -w record on fd 4)
//
// Call these AFTER the stream has hit EOF (ReadLine/ReadLineTimeout returned -1)
// and BEFORE HTTP.CloseStream. Strings returned point into the handle and are
// invalid after CloseStream -- copy them if you need to keep them.
//
//   HTTP.GetStatus(h)     -> HTTP status code (200, 429, ...)
//                            0  = no HTTP response (DNS/connect/TLS failure,
//                                 see GetErrorMsg)
//                            -1 = not known (curl still running, or no record)
//   HTTP.GetRetryAfter(h) -> Retry-After in whole seconds, 0 if absent or if
//                            the server sent an HTTP-date instead of seconds
//   HTTP.GetRequestId(h)  -> `request-id` response header, or 0
//   HTTP.GetErrorMsg(h)   -> curl's error message for a failed transfer, or 0
//   HTTP.GetExitCode(h)   -> curl exit code (0 = transfer completed)
// =============================================================================

// Read and parse the status record once. Returns 1 if loaded, 0 if not yet
// available (curl still running). Never blocks while curl is mid-transfer.
Function.HTTP_LoadStatus {
    Input: handle: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(handle, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Dereference(Add(handle, HHandleOff.ST_LOADED), "dword"), 1) ThenBlock: {
            ReturnValue(1)
        }
        sfd = Dereference(Add(handle, HHandleOff.STATUS_FD), "dword")
        IfCondition LessThan(sfd, 0) ThenBlock: { ReturnValue(0) }

        // poll(POLLIN, 0): readable or HUP means curl has written/closed its end.
        pfd = Allocate(8)
        StoreValue(pfd, sfd, "dword")
        StoreValue(Add(pfd, 4), 1, "dword")
        pr = SystemCall(HSys.SYS_POLL, pfd, 1, 0, 0, 0)
        Deallocate(pfd, 8)
        IfCondition LessEqual(pr, 0) ThenBlock: { ReturnValue(0) }

        buf = Allocate(HConst.STATUS_BUF_SZ)
        MemorySet(buf, 0, HConst.STATUS_BUF_SZ)
        cap = Subtract(HConst.STATUS_BUF_SZ, 1)
        used = 0
        WhileLoop LessThan(used, cap) {
            n = SystemCall(HSys.SYS_READ, sfd, Add(buf, used), Subtract(cap, used), 0, 0)
            IfCondition LessEqual(n, 0) ThenBlock: { BreakLoop }
            used = Add(used, n)
        }
        SystemCall(HSys.SYS_CLOSE, sfd, 0, 0, 0, 0)
        StoreValue(Add(handle, HHandleOff.STATUS_FD), -1, "dword")
        StoreValue(Add(handle, HHandleOff.STATUS_BUF), buf)
        StoreValue(Add(handle, HHandleOff.ST_LOADED), 1, "dword")

        // Fields are newline-terminated: code, retry-after, request-id, errormsg, exitcode.
        i = 0
        start = 0
        field = 0
        WhileLoop And(LessThan(i, used), LessThan(field, 5)) {
            IfCondition EqualTo(GetByte(buf, i), 10) ThenBlock: {
                SetByte(buf, i, 0)
                p = Add(buf, start)
                IfCondition EqualTo(field, 0) ThenBlock: { StoreValue(Add(handle, HHandleOff.CODE), StringToInt(p)) }
                IfCondition EqualTo(field, 1) ThenBlock: { StoreValue(Add(handle, HHandleOff.RETRY_AFTER), StringToInt(p)) }
                IfCondition EqualTo(field, 2) ThenBlock: { StoreValue(Add(handle, HHandleOff.REQ_ID), p) }
                IfCondition EqualTo(field, 3) ThenBlock: { StoreValue(Add(handle, HHandleOff.ERRMSG), p) }
                IfCondition EqualTo(field, 4) ThenBlock: { StoreValue(Add(handle, HHandleOff.EXITCODE), StringToInt(p)) }
                field = Add(field, 1)
                start = Add(i, 1)
            }
            i = Add(i, 1)
        }
        ReturnValue(1)
    }
}

Function.HTTP.GetStatus {
    Input: handle: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(HTTP_LoadStatus(handle), 0) ThenBlock: { ReturnValue(-1) }
        ReturnValue(Dereference(Add(handle, HHandleOff.CODE)))
    }
}

Function.HTTP.GetRetryAfter {
    Input: handle: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(HTTP_LoadStatus(handle), 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(Dereference(Add(handle, HHandleOff.RETRY_AFTER)))
    }
}

Function.HTTP.GetExitCode {
    Input: handle: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(HTTP_LoadStatus(handle), 0) ThenBlock: { ReturnValue(-1) }
        ReturnValue(Dereference(Add(handle, HHandleOff.EXITCODE)))
    }
}

Function.HTTP.GetRequestId {
    Input: handle: Address
    Output: Address
    Body: {
        IfCondition EqualTo(HTTP_LoadStatus(handle), 0) ThenBlock: { ReturnValue(0) }
        p = Dereference(Add(handle, HHandleOff.REQ_ID))
        IfCondition EqualTo(p, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(GetByte(p, 0), 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(p)
    }
}

Function.HTTP.GetErrorMsg {
    Input: handle: Address
    Output: Address
    Body: {
        IfCondition EqualTo(HTTP_LoadStatus(handle), 0) ThenBlock: { ReturnValue(0) }
        p = Dereference(Add(handle, HHandleOff.ERRMSG))
        IfCondition EqualTo(p, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(GetByte(p, 0), 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(p)
    }
}
