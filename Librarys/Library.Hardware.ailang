// Library.Hardware.ailang
// Machine identity: CPUID leaves, feature bits, a one-line summary string.
// Runtime library — compiler native-ISA, installer, and a future OS all call it.
// Does not change codegen. Compile-time path selection is a later Cli flag.
//
// Usage:
//   LibraryImport.Hardware
//   Hw.Probe()
//   PrintMessage(Hw.summary)
//
// Copyright (c) 2026 Sean Collins, 2 Paws Machine and Engineering. All rights reserved.

FixedPool.Hw {
    "eax": Initialize=0, CanChange=True
    "ebx": Initialize=0, CanChange=True
    "ecx": Initialize=0, CanChange=True
    "edx": Initialize=0, CanChange=True
    "max_leaf": Initialize=0, CanChange=True
    "vendor": Initialize=0, CanChange=True
    "summary": Initialize=0, CanChange=True
    "sse2": Initialize=0, CanChange=True
    "sse3": Initialize=0, CanChange=True
    "ssse3": Initialize=0, CanChange=True
    "sse4_1": Initialize=0, CanChange=True
    "sse4_2": Initialize=0, CanChange=True
    "avx": Initialize=0, CanChange=True
    "avx2": Initialize=0, CanChange=True
    "fma": Initialize=0, CanChange=True
    "probed": Initialize=0, CanChange=True
    "level": Initialize=0, CanChange=True
}


// leaf in EDI. CPUID via raw hex — Enc key is CPUID_ not CPUID.
Function.Hw.CpuidLeaf {
    Input: leaf: Integer
    Body: {
        InlineAsm["MOV eax, edi"]
        InlineAsm["XOR ecx, ecx"]
        InlineAsm["0f a2"]
        Hw.eax = InlineAsm["MOV eax, eax"]
        Hw.ebx = InlineAsm["MOV eax, ebx"]
        Hw.ecx = InlineAsm["MOV eax, ecx"]
        Hw.edx = InlineAsm["MOV eax, edx"]
    }
}


Function.Hw.Bit {
    Input: word: Integer
    Input: bit: Integer
    Output: Integer
    Body: {
        sh = LeftShift(1, bit)
        masked = BitwiseAnd(word, sh)
        IfCondition EqualTo(masked, 0) ThenBlock: {
            ReturnValue(0)
        }
        ReturnValue(1)
    }
}


Function.Hw.VendorFromRegs {
    Body: {
        // ebx little-endian of first four vendor chars.
        // AuthenticAMD: Auth = 1752462657. GenuineIntel: Genu = 1970169159.
        Hw.vendor = "unknown"
        IfCondition EqualTo(Hw.ebx, 1752462657) ThenBlock: {
            Hw.vendor = "AuthenticAMD"
        }
        IfCondition EqualTo(Hw.ebx, 1970169159) ThenBlock: {
            Hw.vendor = "GenuineIntel"
        }
    }
}


Function.Hw.BuildSummary {
    Body: {
        s = Hw.vendor
        IfCondition EqualTo(Hw.sse2, 1) ThenBlock: {
            s = StringConcat(s, " sse2")
        }
        IfCondition EqualTo(Hw.sse4_1, 1) ThenBlock: {
            s = StringConcat(s, " sse4.1")
        }
        IfCondition EqualTo(Hw.avx, 1) ThenBlock: {
            s = StringConcat(s, " avx")
        }
        IfCondition EqualTo(Hw.fma, 1) ThenBlock: {
            s = StringConcat(s, " fma")
        }
        Hw.summary = s
    }
}


Function.Hw.Probe {
    Body: {
        Hw.CpuidLeaf(0)
        Hw.max_leaf = Hw.eax
        Hw.VendorFromRegs()

        Hw.CpuidLeaf(1)
        ecx1 = Hw.ecx
        edx1 = Hw.edx
        Hw.sse2 = Hw.Bit(edx1, 26)
        Hw.sse3 = Hw.Bit(ecx1, 0)
        Hw.ssse3 = Hw.Bit(ecx1, 9)
        Hw.sse4_1 = Hw.Bit(ecx1, 19)
        Hw.sse4_2 = Hw.Bit(ecx1, 20)
        Hw.avx = Hw.Bit(ecx1, 28)
        Hw.fma = Hw.Bit(ecx1, 12)

        Hw.avx2 = 0
        IfCondition GreaterEqual(Hw.max_leaf, 7) ThenBlock: {
            Hw.CpuidLeaf(7)
            ebx7 = Hw.ebx
            Hw.avx2 = Hw.Bit(ebx7, 5)
        }

        Hw.BuildSummary()
        Hw.level = 0
        IfCondition EqualTo(Hw.sse4_1, 1) ThenBlock: {
            Hw.level = 1
        }
        IfCondition EqualTo(Hw.fma, 1) ThenBlock: {
            Hw.level = 2
        }
        Hw.probed = 1
    }
}
