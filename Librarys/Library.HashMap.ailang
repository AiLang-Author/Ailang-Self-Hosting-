// Library.HashMap.ailang
// Pure library hash table implementation using only compiler primitives
// NO external primitive dependencies - fully self-contained
//
// =============================================================================
// ARCHITECTURE
// =============================================================================
//
// This provides TWO APIs:
//
// 1. CORE API - Simple key->value hash table (2-3 args):
//    map = HashMap.Create(capacity)
//    HashMap.Set(map, key, value)      // key=string, value=integer/address
//    value = HashMap.Get(map, key)
//    HashMap.Delete(map, key)
//    exists = HashMap.Exists(map, key)
//    HashMap.Destroy(map)
//
// 2. NESTED API - Hash of hashes for Redis-style operations (3-4 args):
//    hm = HashMap.CreateNested()
//    HashMap.HSet(hm, key, field, value)
//    value = HashMap.HGet(hm, key, field)
//    HashMap.HDel(hm, key, field)
//    etc.
//
// =============================================================================
// MEMORY LAYOUT
// =============================================================================
//
// HashMap structure: [capacity:8][size:8][buckets_ptr:8] = 24 bytes
// Bucket node:       [hash:8][key_ptr:8][value:8][next:8] = 32 bytes
//
// Uses chained hashing with linked list buckets for collision resolution.
//
// =============================================================================

LibraryImport.XArrays

// =============================================================================
// HASH FUNCTION - DJB2 algorithm
// =============================================================================
Function.HashMap.HashString {
    Input: str: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(str, 0) ThenBlock: {
            ReturnValue(0)
        }
        
        hash = 5381
        i = 0
        len = StringLength(str)
        
        WhileLoop LessThan(i, len) {
            byte = GetByte(str, i)
            // hash = hash * 33 + byte
            hash = Add(Multiply(hash, 33), byte)
            i = Add(i, 1)
        }
        
        // Ensure positive
        IfCondition LessThan(hash, 0) ThenBlock: {
            hash = Multiply(hash, -1)
        }
        
        ReturnValue(hash)
    }
}

// =============================================================================
// CORE API: Simple Hash Table
// =============================================================================

// Create a new hash table with given capacity
// Returns: Address of hash table structure
Function.HashMap.Create {
    Input: capacity: Integer
    Output: Address
    Body: {
        // Minimum capacity of 8
        IfCondition LessThan(capacity, 8) ThenBlock: {
            capacity = 8
        }
        
        // Allocate main structure: [capacity:8][size:8][buckets_ptr:8]
        map = Allocate(24)
        IfCondition EqualTo(map, 0) ThenBlock: {
            ReturnValue(0)
        }
        
        StoreValue(map, capacity)           // offset 0: capacity
        StoreValue(Add(map, 8), 0)          // offset 8: size (0 items)
        
        // Create bucket array using ArrayCreate
        buckets = ArrayCreate(capacity)
        IfCondition EqualTo(buckets, 0) ThenBlock: {
            Deallocate(map, 24)
            ReturnValue(0)
        }
        
        // Initialize all buckets to NULL (0)
        i = 0
        WhileLoop LessThan(i, capacity) {
            ArraySet(buckets, i, 0)
            i = Add(i, 1)
        }
        
        StoreValue(Add(map, 16), buckets)   // offset 16: buckets pointer
        
        ReturnValue(map)
    }
}

// Insert or update a key-value pair
// Returns: 1 if new key inserted, 0 if existing key updated
Function.HashMap.Set {
    Input: map: Address
    Input: key: Address
    Input: value: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(map, 0) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition EqualTo(key, 0) ThenBlock: {
            ReturnValue(0)
        }
        
        capacity = Dereference(map)
        buckets = Dereference(Add(map, 16))
        
        // Calculate bucket index
        hash = HashMap.HashString(key)
        bucket_idx = Modulo(hash, capacity)
        
        // Search for existing key in bucket chain
        node = ArrayGet(buckets, bucket_idx)
        WhileLoop NotEqual(node, 0) {
            node_key = Dereference(Add(node, 8))
            cmp = StringCompare(key, node_key)
            IfCondition EqualTo(cmp, 0) ThenBlock: {
                // Key exists - update value
                StoreValue(Add(node, 16), value)
                ReturnValue(0)  // Updated existing
            }
            node = Dereference(Add(node, 24))
        }
        
        // Key not found - create new node
        // Node structure: [hash:8][key_ptr:8][value:8][next:8] = 32 bytes
        new_node = Allocate(32)
        IfCondition EqualTo(new_node, 0) ThenBlock: {
            ReturnValue(0)
        }
        
        // Copy the key string
        key_copy = StringCopy(key)
        IfCondition EqualTo(key_copy, 0) ThenBlock: {
            Deallocate(new_node, 32)
            ReturnValue(0)
        }
        
        StoreValue(new_node, hash)              // offset 0: hash
        StoreValue(Add(new_node, 8), key_copy)  // offset 8: key pointer
        StoreValue(Add(new_node, 16), value)    // offset 16: value
        
        // Insert at head of bucket chain
        head = ArrayGet(buckets, bucket_idx)
        StoreValue(Add(new_node, 24), head)     // offset 24: next pointer
        ArraySet(buckets, bucket_idx, new_node)
        
        // Increment size
        size = Dereference(Add(map, 8))
        StoreValue(Add(map, 8), Add(size, 1))
        
        ReturnValue(1)  // New key inserted
    }
}

// Get value for a key
// Returns: value if found, 0 if not found
Function.HashMap.Get {
    Input: map: Address
    Input: key: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(map, 0) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition EqualTo(key, 0) ThenBlock: {
            ReturnValue(0)
        }
        
        capacity = Dereference(map)
        buckets = Dereference(Add(map, 16))
        
        // Calculate bucket index
        hash = HashMap.HashString(key)
        bucket_idx = Modulo(hash, capacity)
        
        // Search bucket chain
        node = ArrayGet(buckets, bucket_idx)
        WhileLoop NotEqual(node, 0) {
            node_key = Dereference(Add(node, 8))
            cmp = StringCompare(key, node_key)
            IfCondition EqualTo(cmp, 0) ThenBlock: {
                // Found it
                value = Dereference(Add(node, 16))
                ReturnValue(value)
            }
            node = Dereference(Add(node, 24))
        }
        
        // Not found
        ReturnValue(0)
    }
}

// Check if key exists
// Returns: 1 if exists, 0 if not
Function.HashMap.Exists {
    Input: map: Address
    Input: key: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(map, 0) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition EqualTo(key, 0) ThenBlock: {
            ReturnValue(0)
        }
        
        capacity = Dereference(map)
        buckets = Dereference(Add(map, 16))
        
        hash = HashMap.HashString(key)
        bucket_idx = Modulo(hash, capacity)
        
        node = ArrayGet(buckets, bucket_idx)
        WhileLoop NotEqual(node, 0) {
            node_key = Dereference(Add(node, 8))
            cmp = StringCompare(key, node_key)
            IfCondition EqualTo(cmp, 0) ThenBlock: {
                ReturnValue(1)  // Found
            }
            node = Dereference(Add(node, 24))
        }
        
        ReturnValue(0)  // Not found
    }
}

// Delete a key from the hash table
// Returns: 1 if deleted, 0 if not found
Function.HashMap.Delete {
    Input: map: Address
    Input: key: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(map, 0) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition EqualTo(key, 0) ThenBlock: {
            ReturnValue(0)
        }
        
        capacity = Dereference(map)
        buckets = Dereference(Add(map, 16))
        
        hash = HashMap.HashString(key)
        bucket_idx = Modulo(hash, capacity)
        
        prev = 0
        node = ArrayGet(buckets, bucket_idx)
        
        WhileLoop NotEqual(node, 0) {
            node_key = Dereference(Add(node, 8))
            cmp = StringCompare(key, node_key)
            
            IfCondition EqualTo(cmp, 0) ThenBlock: {
                // Found - unlink from chain
                next = Dereference(Add(node, 24))
                
                IfCondition EqualTo(prev, 0) ThenBlock: {
                    // Was head of chain
                    ArraySet(buckets, bucket_idx, next)
                } ElseBlock: {
                    // Was in middle/end of chain
                    StoreValue(Add(prev, 24), next)
                }
                
                // Free key string
                key_len = StringLength(node_key)
                key_size = Add(key_len, 1)
                Deallocate(node_key, key_size)
                
                // Free node (32 bytes)
                Deallocate(node, 32)
                
                // Decrement size
                size = Dereference(Add(map, 8))
                StoreValue(Add(map, 8), Subtract(size, 1))
                
                ReturnValue(1)  // Deleted
            }
            
            prev = node
            node = Dereference(Add(node, 24))
        }
        
        ReturnValue(0)  // Not found
    }
}

// Get number of entries in hash table
Function.HashMap.Size {
    Input: map: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(map, 0) ThenBlock: {
            ReturnValue(0)
        }
        size = Dereference(Add(map, 8))
        ReturnValue(size)
    }
}

// Get all keys as an XArray
// Caller is responsible for freeing the returned array and key copies
Function.HashMap.Keys {
    Input: map: Address
    Output: Address
    Body: {
        IfCondition EqualTo(map, 0) ThenBlock: {
            result = XArray.XCreate(1)
            ReturnValue(result)
        }
        
        capacity = Dereference(map)
        buckets = Dereference(Add(map, 16))
        
        result = XArray.XCreate(16)
        
        i = 0
        WhileLoop LessThan(i, capacity) {
            node = ArrayGet(buckets, i)
            WhileLoop NotEqual(node, 0) {
                node_key = Dereference(Add(node, 8))
                key_copy = StringCopy(node_key)
                XArray.XPush(result, key_copy)
                node = Dereference(Add(node, 24))
            }
            i = Add(i, 1)
        }
        
        ReturnValue(result)
    }
}

// Destroy hash table and free all memory
Function.HashMap.Destroy {
    Input: map: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(map, 0) ThenBlock: {
            ReturnValue(0)
        }
        
        capacity = Dereference(map)
        buckets = Dereference(Add(map, 16))
        
        // Free all nodes in all buckets
        i = 0
        WhileLoop LessThan(i, capacity) {
            node = ArrayGet(buckets, i)
            WhileLoop NotEqual(node, 0) {
                next = Dereference(Add(node, 24))
                
                // Free key string
                // StringCopy uses Arena allocation - calculate proper size
                node_key = Dereference(Add(node, 8))
                IfCondition NotEqual(node_key, 0) ThenBlock: {
                    key_len = StringLength(node_key)
                    key_size = Add(key_len, 1)  // +1 for null terminator
                    Deallocate(node_key, key_size)
                }
                
                // Free node (32 bytes)
                Deallocate(node, 32)
                
                node = next
            }
            i = Add(i, 1)
        }
        
        // Free bucket array
        ArrayDestroy(buckets)
        
        // Free map structure (24 bytes)
        Deallocate(map, 24)
        
        ReturnValue(1)
    }
}

// =============================================================================
// SIMPLE API ALIASES - For backwards compatibility
// These wrap the core API with the "Simple" naming convention
// =============================================================================

Function.HashMap.CreateSimple {
    Output: Address
    Body: {
        hash_ptr = HashMap.Create(16)
        ReturnValue(hash_ptr)
    }
}

Function.HashMap.HSetSimple {
    Input: hash_ptr: Address
    Input: field: Address
    Input: value: Address
    Output: Integer
    Body: {
        result = HashMap.Set(hash_ptr, field, value)
        ReturnValue(result)
    }
}

Function.HashMap.HGetSimple {
    Input: hash_ptr: Address
    Input: field: Address
    Output: Address
    Body: {
        value = HashMap.Get(hash_ptr, field)
        ReturnValue(value)
    }
}

Function.HashMap.HDelSimple {
    Input: hash_ptr: Address
    Input: field: Address
    Output: Integer
    Body: {
        result = HashMap.Delete(hash_ptr, field)
        ReturnValue(result)
    }
}

Function.HashMap.HExistsSimple {
    Input: hash_ptr: Address
    Input: field: Address
    Output: Integer
    Body: {
        result = HashMap.Exists(hash_ptr, field)
        ReturnValue(result)
    }
}

Function.HashMap.HLenSimple {
    Input: hash_ptr: Address
    Output: Integer
    Body: {
        size = HashMap.Size(hash_ptr)
        ReturnValue(size)
    }
}

Function.HashMap.HKeysSimple {
    Input: hash_ptr: Address
    Output: Address
    Body: {
        keys = HashMap.Keys(hash_ptr)
        ReturnValue(keys)
    }
}

Function.HashMap.DestroySimple {
    Input: hash_ptr: Address
    Output: Integer
    Body: {
        result = HashMap.Destroy(hash_ptr)
        ReturnValue(result)
    }
}

// =============================================================================
// NESTED API: Hash of Hashes (Redis-style)
// Uses XSHash from XArrays library for the outer hash
// =============================================================================

// Create a nested hash map (hash of hashes)
Function.HashMap.CreateNested {
    Output: Address
    Body: {
        // Use XSHash for the outer hash - stores inner hashes as values
        hashmap = XSHash.XCreate(256)
        ReturnValue(hashmap)
    }
}

// Set a field in a nested hash
// Returns: 1 if new field was created, 0 if existing field was updated
Function.HashMap.HSet {
    Input: hashmap: Address
    Input: key: Address
    Input: field: Address
    Input: value: Address
    Output: Integer
    Body: {
        // Get or create the inner hash for this key
        inner_hash = XSHash.XLookup(hashmap, key)
        
        IfCondition EqualTo(inner_hash, XArrays.XNULL) ThenBlock: {
            // Create new inner hash
            inner_hash = XSHash.XCreate(16)
            XSHash.XInsert(hashmap, key, inner_hash)
        }
        
        // Check if field exists - if so, free old value
        existing_value = XSHash.XLookup(inner_hash, field)
        IfCondition NotEqual(existing_value, XArrays.XNULL) ThenBlock: {
            // Deallocate(existing_value, 0)  // DISABLED - use Arena_Reset
        }
        
        // Insert/update field
        is_new_field = XSHash.XInsert(inner_hash, field, value)
        
        ReturnValue(is_new_field)
    }
}

// Get a field from a nested hash
// Returns: Address of value or 0 if not found
Function.HashMap.HGet {
    Input: hashmap: Address
    Input: key: Address
    Input: field: Address
    Output: Address
    Body: {
        inner_hash = XSHash.XLookup(hashmap, key)
        
        IfCondition EqualTo(inner_hash, XArrays.XNULL) ThenBlock: {
            ReturnValue(0)
        }
        
        value = XSHash.XLookup(inner_hash, field)
        
        IfCondition EqualTo(value, XArrays.XNULL) ThenBlock: {
            ReturnValue(0)
        }
        
        ReturnValue(value)
    }
}

// Delete a field from a nested hash
// Returns: 1 if field was deleted, 0 if not found
Function.HashMap.HDel {
    Input: hashmap: Address
    Input: key: Address
    Input: field: Address
    Output: Integer
    Body: {
        inner_hash = XSHash.XLookup(hashmap, key)
        
        IfCondition EqualTo(inner_hash, XArrays.XNULL) ThenBlock: {
            ReturnValue(0)
        }
        
        old_value = XSHash.XDelete(inner_hash, field)
        
        IfCondition EqualTo(old_value, XArrays.XNULL) ThenBlock: {
            ReturnValue(0)
        }
        
        // Free the old value
        // Deallocate(old_value, 0)  // DISABLED - use Arena_Reset
        
        // Check if inner hash is now empty - if so, remove from outer
        keys = XSHash.XKeys(inner_hash)
        num_keys = XArray.XSize(keys)
        
        // Clean up keys array
        i = 0
        WhileLoop LessThan(i, num_keys) {
            key_copy = XArray.XGet(keys, i)
            // Deallocate(key_copy, 0)  // DISABLED - use Arena_Reset
            i = Add(i, 1)
        }
        XArray.XDestroy(keys)
        
        IfCondition EqualTo(num_keys, 0) ThenBlock: {
            XSHash.XDelete(hashmap, key)
            XSHash.XDestroy(inner_hash)
        }
        
        ReturnValue(1)
    }
}

// Check if a field exists in a nested hash
Function.HashMap.HExists {
    Input: hashmap: Address
    Input: key: Address
    Input: field: Address
    Output: Integer
    Body: {
        inner_hash = XSHash.XLookup(hashmap, key)
        
        IfCondition EqualTo(inner_hash, XArrays.XNULL) ThenBlock: {
            ReturnValue(0)
        }
        
        value = XSHash.XLookup(inner_hash, field)
        
        IfCondition EqualTo(value, XArrays.XNULL) ThenBlock: {
            ReturnValue(0)
        }
        
        ReturnValue(1)
    }
}

// Get all field names from a nested hash
Function.HashMap.HKeys {
    Input: hashmap: Address
    Input: key: Address
    Output: Address
    Body: {
        result = XArray.XCreate(16)
        
        inner_hash = XSHash.XLookup(hashmap, key)
        
        IfCondition EqualTo(inner_hash, XArrays.XNULL) ThenBlock: {
            ReturnValue(result)  // Return empty array
        }
        
        fields = XSHash.XKeys(inner_hash)
        ReturnValue(fields)
    }
}

// Get all values from a nested hash
Function.HashMap.HVals {
    Input: hashmap: Address
    Input: key: Address
    Output: Address
    Body: {
        result = XArray.XCreate(16)
        
        inner_hash = XSHash.XLookup(hashmap, key)
        
        IfCondition EqualTo(inner_hash, XArrays.XNULL) ThenBlock: {
            ReturnValue(result)
        }
        
        fields = XSHash.XKeys(inner_hash)
        num_fields = XArray.XSize(fields)
        
        i = 0
        WhileLoop LessThan(i, num_fields) {
            field = XArray.XGet(fields, i)
            value = XSHash.XLookup(inner_hash, field)
            XArray.XPush(result, value)
            // Deallocate(field, 0)  // DISABLED - use Arena_Reset
            i = Add(i, 1)
        }
        
        XArray.XDestroy(fields)
        ReturnValue(result)
    }
}

// Get all field-value pairs from a nested hash
Function.HashMap.HGetAll {
    Input: hashmap: Address
    Input: key: Address
    Output: Address
    Body: {
        result = XArray.XCreate(16)
        
        inner_hash = XSHash.XLookup(hashmap, key)
        
        IfCondition EqualTo(inner_hash, XArrays.XNULL) ThenBlock: {
            ReturnValue(result)
        }
        
        fields = XSHash.XKeys(inner_hash)
        num_fields = XArray.XSize(fields)
        
        i = 0
        WhileLoop LessThan(i, num_fields) {
            field = XArray.XGet(fields, i)
            value = XSHash.XLookup(inner_hash, field)
            
            XArray.XPush(result, field)
            XArray.XPush(result, value)
            
            i = Add(i, 1)
        }
        
        XArray.XDestroy(fields)
        ReturnValue(result)
    }
}

// Get number of fields in a nested hash
Function.HashMap.HLen {
    Input: hashmap: Address
    Input: key: Address
    Output: Integer
    Body: {
        inner_hash = XSHash.XLookup(hashmap, key)
        
        IfCondition EqualTo(inner_hash, XArrays.XNULL) ThenBlock: {
            ReturnValue(0)
        }
        
        fields = XSHash.XKeys(inner_hash)
        num_fields = XArray.XSize(fields)
        
        // Clean up
        i = 0
        WhileLoop LessThan(i, num_fields) {
            field = XArray.XGet(fields, i)
            // Deallocate(field, 0)  // DISABLED - use Arena_Reset
            i = Add(i, 1)
        }
        XArray.XDestroy(fields)
        
        ReturnValue(num_fields)
    }
}

// Destroy a nested hash map completely
Function.HashMap.DestroyNested {
    Input: hashmap: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(hashmap, 0) ThenBlock: {
            ReturnValue(0)
        }
        
        // Get all outer keys
        main_keys = XSHash.XKeys(hashmap)
        num_keys = XArray.XSize(main_keys)
        
        i = 0
        WhileLoop LessThan(i, num_keys) {
            key = XArray.XGet(main_keys, i)
            inner_hash = XSHash.XLookup(hashmap, key)
            
            IfCondition NotEqual(inner_hash, XArrays.XNULL) ThenBlock: {
                // Free all values in inner hash
                fields = XSHash.XKeys(inner_hash)
                num_fields = XArray.XSize(fields)
                
                j = 0
                WhileLoop LessThan(j, num_fields) {
                    field = XArray.XGet(fields, j)
                    value = XSHash.XLookup(inner_hash, field)
                    
                    IfCondition NotEqual(value, XArrays.XNULL) ThenBlock: {
                        // Deallocate(value, 0)  // DISABLED - use Arena_Reset
                    }
                    // Deallocate(field, 0)  // DISABLED - use Arena_Reset
                    
                    j = Add(j, 1)
                }
                
                XArray.XDestroy(fields)
                XSHash.XDestroy(inner_hash)
            }
            
            // Deallocate(key, 0)  // DISABLED - use Arena_Reset
            i = Add(i, 1)
        }
        
        XArray.XDestroy(main_keys)
        XSHash.XDestroy(hashmap)
        
        ReturnValue(1)
    }
}

// =============================================================================
// UTILITY FUNCTIONS
// =============================================================================

// Increment a numeric field by a given amount
Function.HashMap.HIncrBy {
    Input: hashmap: Address
    Input: key: Address
    Input: field: Address
    Input: increment: Integer
    Output: Integer
    Body: {
        current_str = HashMap.HGet(hashmap, key, field)
        current_val = 0
        
        IfCondition NotEqual(current_str, 0) ThenBlock: {
            current_val = StringToNumber(current_str)
        }
        
        new_val = Add(current_val, increment)
        new_str = NumberToString(new_val)
        HashMap.HSet(hashmap, key, field, new_str)
        // Deallocate(new_str, 0)  // DISABLED - use Arena_Reset
        
        ReturnValue(new_val)
    }
}

// Set multiple fields at once
Function.HashMap.HMSet {
    Input: hashmap: Address
    Input: key: Address
    Input: fields_values: Address
    Output: Integer
    Body: {
        new_fields = 0
        array_size = XArray.XSize(fields_values)
        
        i = 0
        WhileLoop LessThan(i, array_size) {
            field = XArray.XGet(fields_values, i)
            value = XArray.XGet(fields_values, Add(i, 1))
            
            is_new = HashMap.HSet(hashmap, key, field, value)
            new_fields = Add(new_fields, is_new)
            
            i = Add(i, 2)
        }
        
        ReturnValue(new_fields)
    }
}

// Get multiple fields at once
Function.HashMap.HMGet {
    Input: hashmap: Address
    Input: key: Address
    Input: fields: Address
    Output: Address
    Body: {
        num_fields = XArray.XSize(fields)
        result = XArray.XCreate(num_fields)
        
        i = 0
        WhileLoop LessThan(i, num_fields) {
            field = XArray.XGet(fields, i)
            value = HashMap.HGet(hashmap, key, field)
            XArray.XPush(result, value)
            i = Add(i, 1)
        }
        
        ReturnValue(result)
    }
}