// Library.IntMath.ailang — integer math helpers
//
// Integer-only math operations that don't belong in the language core
// but are reached for often enough to deserve a named function.
// Additions here compose with the arithmetic intrinsics (Add,
// Multiply, …) — this library never shadows or replaces a primitive.
//
// Copyright (c) 2026 Sean Collins, 2 Paws Machine and Engineering.
// Licensed under the Sean Collins Software License (SCSL).

// Integer power: base^exp. Exponentiation by squaring — O(log exp)
// multiplications. For exp <= 0 returns 1 (the mathematical
// convention: x^0 = 1; negative exp isn't meaningful in integers,
// so we clamp rather than invent a fractional answer).
Function.IntPow {
    Input: base: Integer
    Input: exp: Integer
    Output: Integer
    Body: {
        IfCondition LessEqual(exp, 0) ThenBlock: { ReturnValue(1) }
        result = 1
        b = base
        e = exp
        WhileLoop GreaterThan(e, 0) {
            // If the low bit of e is set, fold b into result.
            IfCondition EqualTo(Modulo(e, 2), 1) ThenBlock: {
                result = Multiply(result, b)
            }
            b = Multiply(b, b)
            e = Divide(e, 2)
        }
        ReturnValue(result)
    }
}

// Integer absolute value.
Function.IntAbs {
    Input: n: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(n, 0) ThenBlock: { ReturnValue(Subtract(0, n)) }
        ReturnValue(n)
    }
}

// Integer max of two values.
Function.IntMax {
    Input: a: Integer
    Input: b: Integer
    Output: Integer
    Body: {
        IfCondition GreaterThan(a, b) ThenBlock: { ReturnValue(a) }
        ReturnValue(b)
    }
}

// Integer min of two values.
Function.IntMin {
    Input: a: Integer
    Input: b: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(a, b) ThenBlock: { ReturnValue(a) }
        ReturnValue(b)
    }
}

// Greatest common divisor via Euclid's algorithm. Handles negative
// inputs by taking absolute values first.
Function.IntGcd {
    Input: a: Integer
    Input: b: Integer
    Output: Integer
    Body: {
        x = IntAbs(a)
        y = IntAbs(b)
        WhileLoop NotEqual(y, 0) {
            t = Modulo(x, y)
            x = y
            y = t
        }
        ReturnValue(x)
    }
}
