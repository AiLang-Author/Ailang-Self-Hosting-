//
// Library.KernelShim.ailang
//
// Mirrors kernel_module/shim/ail_shim.h. Every declaration here is an
// ExternalKernelFunction — the implementation lives in the C shim and
// gets resolved at insmod time via R_X86_64_PLT32 relocations.
//
// USAGE
//   LibraryImport.KernelShim
//
//   Function.ail_main {
//       Output: Integer
//       Body: {
//           ail_printk("module loaded")
//           ReturnValue(0)
//       }
//   }
//
// Compile with:
//   ./ailang.x -kmod my_module.ailang ail_payload.o
//
// Then in kernel_module/shim/:  make → ail_combined.ko → sudo insmod
//
// IMPORTANT — keep this file in sync with shim/ail_shim.h. If the C
// signature changes (param count, return type), update the matching
// declaration here. There is no cross-language type checker; mismatch
// = silent ABI corruption at insmod time.

// =============================================================================
// LOGGING
// =============================================================================

// printk(KERN_INFO "%s", s) wrapper. Returns chars printed.
ExternalKernelFunction.ail_printk {
    Input: s: Address
    Output: Integer
}

// =============================================================================
// MEMORY
// =============================================================================

// kmalloc(size, GFP_KERNEL). Returns pointer or NULL.
ExternalKernelFunction.ail_kmalloc {
    Input: size: Integer
    Output: Address
}

// kfree(obj). Frees pointer returned by ail_kmalloc.
ExternalKernelFunction.ail_kfree {
    Input: obj: Address
}

ExternalKernelFunction.ail_memcpy {
    Input: (dest: Address, src: Address, count: Integer)
    Output: Address
}

ExternalKernelFunction.ail_memset {
    Input: (s: Address, c: Integer, n: Integer)
    Output: Address
}

ExternalKernelFunction.ail_memcmp {
    Input: (cs: Address, ct: Address, count: Integer)
    Output: Integer
}

// =============================================================================
// TIME
// =============================================================================

// ktime_get_ns() — monotonic nanosecond counter.
ExternalKernelFunction.ail_ktime_get_ns {
    Output: Integer
}

ExternalKernelFunction.ail_msleep {
    Input: msecs: Integer
}

ExternalKernelFunction.ail_udelay {
    Input: usecs: Integer
}

// =============================================================================
// PROCESS CONTEXT
// =============================================================================

ExternalKernelFunction.ail_get_current_pid {
    Output: Integer
}

ExternalKernelFunction.ail_get_current_tgid {
    Output: Integer
}

// =============================================================================
// USER-SPACE MEMORY
// =============================================================================

// copy_to_user / copy_from_user — return uncopied byte count (0 on success).
ExternalKernelFunction.ail_copy_to_user {
    Input: (to: Address, from: Address, n: Integer)
    Output: Integer
}

ExternalKernelFunction.ail_copy_from_user {
    Input: (to: Address, from: Address, n: Integer)
    Output: Integer
}

// =============================================================================
// SYNCHRONIZATION — ATOMICS
// =============================================================================

ExternalKernelFunction.ail_atomic_read {
    Input: v: Address
    Output: Integer
}

ExternalKernelFunction.ail_atomic_set {
    Input: (v: Address, i: Integer)
}

ExternalKernelFunction.ail_atomic_add {
    Input: (i: Integer, v: Address)
}

ExternalKernelFunction.ail_atomic_sub {
    Input: (i: Integer, v: Address)
}

ExternalKernelFunction.ail_atomic_inc {
    Input: v: Address
}

ExternalKernelFunction.ail_atomic_dec_and_test {
    Input: v: Address
    Output: Integer
}

// =============================================================================
// SYNCHRONIZATION — MUTEX
// =============================================================================

ExternalKernelFunction.ail_mutex_init {
    Input: lock: Address
}

ExternalKernelFunction.ail_mutex_lock {
    Input: lock: Address
}

ExternalKernelFunction.ail_mutex_unlock {
    Input: lock: Address
}

// =============================================================================
// CHARACTER DEVICES
// =============================================================================

ExternalKernelFunction.ail_alloc_chrdev_region {
    Input: (dev: Address, baseminor: Integer, count: Integer, name: Address)
    Output: Integer
}

ExternalKernelFunction.ail_unregister_chrdev_region {
    Input: (from: Integer, count: Integer)
}

ExternalKernelFunction.ail_cdev_init {
    Input: (cdev: Address, fops: Address)
}

ExternalKernelFunction.ail_cdev_add {
    Input: (p: Address, dev: Integer, count: Integer)
    Output: Integer
}

ExternalKernelFunction.ail_cdev_del {
    Input: p: Address
}

ExternalKernelFunction.ail_MAJOR {
    Input: dev: Integer
    Output: Integer
}

ExternalKernelFunction.ail_MINOR {
    Input: dev: Integer
    Output: Integer
}

ExternalKernelFunction.ail_MKDEV {
    Input: (major: Integer, minor: Integer)
    Output: Integer
}

// =============================================================================
// HARDWARE I/O
// =============================================================================

ExternalKernelFunction.ail_ioremap {
    Input: (offset: Integer, size: Integer)
    Output: Address
}

ExternalKernelFunction.ail_iounmap {
    Input: addr: Address
}

ExternalKernelFunction.ail_readb {
    Input: addr: Address
    Output: Integer
}

ExternalKernelFunction.ail_readw {
    Input: addr: Address
    Output: Integer
}

ExternalKernelFunction.ail_readl {
    Input: addr: Address
    Output: Integer
}

ExternalKernelFunction.ail_writeb {
    Input: (b: Integer, addr: Address)
}

ExternalKernelFunction.ail_writew {
    Input: (b: Integer, addr: Address)
}

ExternalKernelFunction.ail_writel {
    Input: (b: Integer, addr: Address)
}
