//
// Library.KernelShimPCIe.ailang
//
// Mirrors kernel_module/shim/ail_shim_pcie.h. Every declaration here is an
// ExternalKernelFunction — the implementation lives in the C shim and
// gets resolved at insmod time via R_X86_64_PLT32 relocations.
//
// USAGE
//   LibraryImport.KernelShimPCIe
//
// IMPORTANT — keep this file in sync with shim/ail_shim_pcie.h.

// =============================================================================
// PCI DRIVER REGISTRATION
// =============================================================================

// pci_register_driver(&mx3_pci_driver). Zero-arg; driver struct is shim-internal.
ExternalKernelFunction.ail_pci_register_driver {
    Output: Integer
}

ExternalKernelFunction.ail_pci_unregister_driver {
}

// =============================================================================
// PCI DEVICE MANAGEMENT
// =============================================================================

ExternalKernelFunction.ail_pci_enable_device {
    Input: pdev: Address
    Output: Integer
}

ExternalKernelFunction.ail_pci_set_master {
    Input: pdev: Address
}

ExternalKernelFunction.ail_pci_request_regions {
    Input: (pdev: Address, name: Address)
    Output: Integer
}

ExternalKernelFunction.ail_pci_release_regions {
    Input: pdev: Address
}

// pcim_iomap(pdev, bar, maxlen). Returns ioremap'd virtual address.
ExternalKernelFunction.ail_pci_iomap {
    Input: (pdev: Address, bar: Integer, maxlen: Integer)
    Output: Address
}

ExternalKernelFunction.ail_pci_iounmap {
    Input: (pdev: Address, addr: Address)
}

// pci_resource_start(pdev, bar). Returns BAR physical base address.
ExternalKernelFunction.ail_pci_resource_start {
    Input: (pdev: Address, bar: Integer)
    Output: Integer
}

// pci_resource_len(pdev, bar). Returns BAR region size.
ExternalKernelFunction.ail_pci_resource_len {
    Input: (pdev: Address, bar: Integer)
    Output: Integer
}

ExternalKernelFunction.ail_pci_disable_device {
    Input: pdev: Address
}

// Returns &pdev->dev (struct device*) for DMA functions.
ExternalKernelFunction.ail_pci_get_dev {
    Input: pdev: Address
    Output: Address
}

// =============================================================================
// DMA
// =============================================================================

ExternalKernelFunction.ail_dma_set_mask_and_coherent {
    Input: (dev: Address, mask: Integer)
    Output: Integer
}

// Returns vaddr; writes dma_addr_t through dma_handle_out pointer.
ExternalKernelFunction.ail_dma_alloc_coherent {
    Input: (dev: Address, size: Integer, dma_handle_out: Address, gfp: Integer)
    Output: Address
}

ExternalKernelFunction.ail_dma_free_coherent {
    Input: (dev: Address, size: Integer, vaddr: Address, dma_handle: Integer)
}

ExternalKernelFunction.ail_dma_sync_for_cpu {
    Input: (dev: Address, dma_handle: Integer, size: Integer, direction: Integer)
}

ExternalKernelFunction.ail_dma_sync_for_device {
    Input: (dev: Address, dma_handle: Integer, size: Integer, direction: Integer)
}

// =============================================================================
// INTERRUPTS (MSI-X / MSI / Legacy)
// =============================================================================

ExternalKernelFunction.ail_pci_alloc_irq_vectors {
    Input: (pdev: Address, min_vecs: Integer, max_vecs: Integer, flags: Integer)
    Output: Integer
}

ExternalKernelFunction.ail_pci_free_irq_vectors {
    Input: pdev: Address
}

ExternalKernelFunction.ail_pci_irq_vector {
    Input: (pdev: Address, nr: Integer)
    Output: Integer
}

// request_irq with C-side ISR stub. ISR calls complete() on channel.
ExternalKernelFunction.ail_request_irq_stub {
    Input: (irq: Integer, channel_index: Integer, dev_ctx: Address)
    Output: Integer
}

ExternalKernelFunction.ail_free_irq {
    Input: (irq: Integer, dev_ctx: Address)
}

// =============================================================================
// COMPLETIONS
// =============================================================================

// kmalloc + init_completion. Returns opaque completion pointer.
ExternalKernelFunction.ail_completion_alloc {
    Output: Address
}

ExternalKernelFunction.ail_completion_free {
    Input: comp: Address
}

ExternalKernelFunction.ail_completion_reinit {
    Input: comp: Address
}

// Returns remaining jiffies (>0 = signaled), 0 = timeout.
ExternalKernelFunction.ail_wait_for_completion_timeout {
    Input: (comp: Address, timeout_jiffies: Integer)
    Output: Integer
}

ExternalKernelFunction.ail_complete {
    Input: comp: Address
}

// =============================================================================
// SPINLOCKS
// =============================================================================

// kmalloc + spin_lock_init. Returns opaque spinlock pointer.
ExternalKernelFunction.ail_spinlock_alloc {
    Output: Address
}

ExternalKernelFunction.ail_spinlock_free {
    Input: lock: Address
}

// spin_lock_irqsave — returns saved flags as Integer.
ExternalKernelFunction.ail_spin_lock_irqsave {
    Input: lock: Address
    Output: Integer
}

ExternalKernelFunction.ail_spin_unlock_irqrestore {
    Input: (lock: Address, flags: Integer)
}

// =============================================================================
// DEVICE MODEL
// =============================================================================

ExternalKernelFunction.ail_class_create {
    Input: name: Address
    Output: Address
}

ExternalKernelFunction.ail_class_destroy {
    Input: cls: Address
}

// device_create with name_fmt + index (6 args max).
ExternalKernelFunction.ail_device_create_fmt {
    Input: (cls: Address, parent: Address, devt: Integer, drvdata: Address, name_fmt: Address, index: Integer)
    Output: Address
}

ExternalKernelFunction.ail_device_destroy {
    Input: (cls: Address, devt: Integer)
}

// =============================================================================
// FIRMWARE
// =============================================================================

// Returns firmware data pointer; stores size at *size_out.
ExternalKernelFunction.ail_request_firmware_buf {
    Input: (name: Address, dev: Address, size_out: Address)
    Output: Address
}

ExternalKernelFunction.ail_release_firmware_handle {
    Input: fw_handle: Address
}

// =============================================================================
// KFIFO
// =============================================================================

ExternalKernelFunction.ail_kfifo_alloc {
    Input: size: Integer
    Output: Address
}

ExternalKernelFunction.ail_kfifo_free {
    Input: fifo: Address
}

ExternalKernelFunction.ail_kfifo_in {
    Input: (fifo: Address, buf: Address, n: Integer)
    Output: Integer
}

ExternalKernelFunction.ail_kfifo_out {
    Input: (fifo: Address, buf: Address, n: Integer)
    Output: Integer
}

ExternalKernelFunction.ail_kfifo_len {
    Input: fifo: Address
    Output: Integer
}

// =============================================================================
// SEMAPHORE
// =============================================================================

ExternalKernelFunction.ail_sema_alloc {
    Input: val: Integer
    Output: Address
}

ExternalKernelFunction.ail_sema_free {
    Input: sem: Address
}

ExternalKernelFunction.ail_down {
    Input: sem: Address
}

ExternalKernelFunction.ail_up {
    Input: sem: Address
}

// =============================================================================
// CHAR DEVICE FOPS BRIDGE
// =============================================================================

// Creates cdev + class + device nodes. Returns opaque context.
ExternalKernelFunction.ail_chardev_register {
    Input: (name: Address, minor_count: Integer)
    Output: Address
}

ExternalKernelFunction.ail_chardev_unregister {
    Input: ctx: Address
}

ExternalKernelFunction.ail_chardev_set_drvdata {
    Input: (ctx: Address, drvdata: Address)
}

ExternalKernelFunction.ail_chardev_get_drvdata {
    Input: ctx: Address
    Output: Address
}

// =============================================================================
// USERSPACE HELPERS
// =============================================================================

ExternalKernelFunction.ail_put_user_u32 {
    Input: (val: Integer, uaddr: Address)
    Output: Integer
}

ExternalKernelFunction.ail_get_user_u32 {
    Input: (val: Address, uaddr: Address)
    Output: Integer
}
