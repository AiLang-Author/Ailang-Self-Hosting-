// Library.KeyMap.ailang — Scancode-to-ASCII translation via config file
// Loads config/keymap.cfg (key<N>=ascii, key<N>s=ascii shift variant)
// Falls back to empty tables if config missing (no typing without config).
// Copyright (c) 2026 Sean Collins, 2 Paws Machine and Engineering. SCSL.

// =============================================================================
// CONSTANTS
// =============================================================================
FixedPool.KeyMapConst {
    "TABLE_SIZE":   Initialize=128
    "CFG_BUF_SIZE": Initialize=4096
}

FixedPool.KeyMapSys {
    "SYS_OPEN":  Initialize=2
    "SYS_READ":  Initialize=0
    "SYS_CLOSE": Initialize=3
    "O_RDONLY":   Initialize=0
}

// =============================================================================
// STATE
// =============================================================================
FixedPool.KeyMapState {
    "normal_table":  Initialize=0, CanChange=True
    "shift_table":   Initialize=0, CanChange=True
    "caps_on":       Initialize=0, CanChange=True
    "loaded":        Initialize=0, CanChange=True
}

// =============================================================================
// INTERNAL: Parse decimal integer from buffer at offset, return value
// Stops at null, newline, CR, or non-digit
// =============================================================================
Function.KeyMap_ParseNum {
    Input: buf: Address
    Input: pos: Integer
    Output: Integer
    Body: {
        result = 0
        WhileLoop 1 {
            ch = GetByte(buf, pos)
            IfCondition LessThan(ch, 48)  ThenBlock: { ReturnValue(result) }
            IfCondition GreaterThan(ch, 57) ThenBlock: { ReturnValue(result) }
            result = Add(Multiply(result, 10), Subtract(ch, 48))
            pos = Add(pos, 1)
        }
        ReturnValue(result)
    }
}

// =============================================================================
// INTERNAL: Parse one config line
// Format: key<scancode>=<ascii>  or  key<scancode>s=<ascii>
// Lines starting with # are comments. Blank lines skipped.
// =============================================================================
Function.KeyMap_ParseLine {
    Input: buf: Address
    Input: start: Integer
    Input: end: Integer
    Body: {
        // Skip leading whitespace
        pos = start
        WhileLoop And(LessThan(pos, end), EqualTo(GetByte(buf, pos), 32)) {
            pos = Add(pos, 1)
        }
        IfCondition GreaterEqual(pos, end) ThenBlock: { ReturnValue(0) }
        ch = GetByte(buf, pos)
        // Skip comments and blank lines
        IfCondition EqualTo(ch, 35) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(ch, 10) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(ch, 13) ThenBlock: { ReturnValue(0) }

        // Must start with "key" (107, 101, 121)
        IfCondition NotEqual(GetByte(buf, pos), 107)            ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(GetByte(buf, Add(pos, 1)), 101)    ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(GetByte(buf, Add(pos, 2)), 121)    ThenBlock: { ReturnValue(0) }
        pos = Add(pos, 3)

        // Parse scancode number
        scancode = KeyMap_ParseNum(buf, pos)
        // Advance past digits
        WhileLoop And(GreaterEqual(GetByte(buf, pos), 48), LessEqual(GetByte(buf, pos), 57)) {
            pos = Add(pos, 1)
        }

        // Check for 's' suffix (shift variant)
        is_shift = 0
        IfCondition EqualTo(GetByte(buf, pos), 115) ThenBlock: {
            is_shift = 1
            pos = Add(pos, 1)
        }

        // Expect '=' (61)
        IfCondition NotEqual(GetByte(buf, pos), 61) ThenBlock: { ReturnValue(0) }
        pos = Add(pos, 1)

        // Skip whitespace after =
        WhileLoop And(LessThan(pos, end), EqualTo(GetByte(buf, pos), 32)) {
            pos = Add(pos, 1)
        }

        // Parse ASCII value
        ascii_val = KeyMap_ParseNum(buf, pos)

        // Bounds check scancode
        IfCondition LessThan(scancode, 0)   ThenBlock: { ReturnValue(0) }
        IfCondition GreaterEqual(scancode, KeyMapConst.TABLE_SIZE) ThenBlock: { ReturnValue(0) }

        // Store into appropriate table
        IfCondition EqualTo(is_shift, 1) ThenBlock: {
            SetByte(KeyMapState.shift_table, scancode, ascii_val)
        } ElseBlock: {
            SetByte(KeyMapState.normal_table, scancode, ascii_val)
        }
        ReturnValue(1)
    }
}

// =============================================================================
// LOAD CONFIG — open config/keymap.cfg, parse all lines
// =============================================================================
Function.KeyMap_LoadConfig {
    Output: Integer
    Body: {
        fd = SystemCall(KeyMapSys.SYS_OPEN, "config/keymap.cfg", KeyMapSys.O_RDONLY, 0)
        IfCondition LessThan(fd, 0) ThenBlock: {
            PrintMessage("[KeyMap] no config/keymap.cfg, tables empty\n")
            ReturnValue(0)
        }

        buf = Allocate(KeyMapConst.CFG_BUF_SIZE)
        bytes_read = SystemCall(KeyMapSys.SYS_READ, fd, buf, KeyMapConst.CFG_BUF_SIZE)
        SystemCall(KeyMapSys.SYS_CLOSE, fd, 0, 0)

        IfCondition LessEqual(bytes_read, 0) ThenBlock: {
            PrintMessage("[KeyMap] config file empty\n")
            Deallocate(buf, KeyMapConst.CFG_BUF_SIZE)
            ReturnValue(0)
        }

        // Parse line by line
        line_start = 0
        pos = 0
        count = 0
        WhileLoop LessThan(pos, bytes_read) {
            ch = GetByte(buf, pos)
            IfCondition EqualTo(ch, 10) ThenBlock: {
                r = KeyMap_ParseLine(buf, line_start, pos)
                count = Add(count, r)
                line_start = Add(pos, 1)
            }
            pos = Add(pos, 1)
        }
        // Handle last line without trailing newline
        IfCondition LessThan(line_start, bytes_read) ThenBlock: {
            r = KeyMap_ParseLine(buf, line_start, bytes_read)
            count = Add(count, r)
        }

        Deallocate(buf, KeyMapConst.CFG_BUF_SIZE)

        PrintMessage("[KeyMap] loaded ")
        PrintNumber(count)
        PrintMessage(" mappings\n")
        ReturnValue(count)
    }
}

// =============================================================================
// INIT — allocate tables, load config
// =============================================================================
Function.KeyMap_Init {
    Body: {
        DebugLog_Push("km.init", 7)

        // Allocate normal and shift tables (128 bytes each)
        tbl_size = KeyMapConst.TABLE_SIZE
        KeyMapState.normal_table = Allocate(tbl_size)
        KeyMapState.shift_table  = Allocate(tbl_size)

        // Zero both tables
        i = 0
        WhileLoop LessThan(i, tbl_size) {
            SetByte(KeyMapState.normal_table, i, 0)
            SetByte(KeyMapState.shift_table,  i, 0)
            i = Add(i, 1)
        }

        // Load from config file
        KeyMap_LoadConfig()
        KeyMapState.loaded = 1

        PrintMessage("[KeyMap] init complete\n")
    }
}

// =============================================================================
// TRANSLATE — scancode + modifiers → ASCII character
// Returns 0 for non-printable / unmapped keys
// =============================================================================
Function.KeyMap_Translate {
    Input: scancode: Integer
    Input: shift: Integer
    Input: caps: Integer
    Output: Integer
    Body: {
        // Bounds check
        IfCondition LessThan(scancode, 0)   ThenBlock: { ReturnValue(0) }
        IfCondition GreaterEqual(scancode, KeyMapConst.TABLE_SIZE) ThenBlock: { ReturnValue(0) }

        // Pick table based on shift state
        IfCondition EqualTo(shift, 1) ThenBlock: {
            ch = GetByte(KeyMapState.shift_table, scancode)
        } ElseBlock: {
            ch = GetByte(KeyMapState.normal_table, scancode)
        }

        // Caps lock: swap case for letters only
        IfCondition EqualTo(caps, 1) ThenBlock: {
            // Lowercase a-z (97-122) → uppercase
            IfCondition And(GreaterEqual(ch, 97), LessEqual(ch, 122)) ThenBlock: {
                ch = Subtract(ch, 32)
            } ElseBlock: {
                // Uppercase A-Z (65-90) → lowercase
                IfCondition And(GreaterEqual(ch, 65), LessEqual(ch, 90)) ThenBlock: {
                    ch = Add(ch, 32)
                }
            }
        }

        ReturnValue(ch)
    }
}

// =============================================================================
// CAPS LOCK TOGGLE — called from SysDisplay_DrainInput on scancode 58
// =============================================================================
Function.KeyMap_ToggleCaps {
    Body: {
        IfCondition EqualTo(KeyMapState.caps_on, 0) ThenBlock: {
            KeyMapState.caps_on = 1
            KeyMod.caps = 1
        } ElseBlock: {
            KeyMapState.caps_on = 0
            KeyMod.caps = 0
        }
    }
}
