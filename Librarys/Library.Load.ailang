// Library.Load — run another whole AILANG executable.
//
// LibraryImport pastes source at compile time. Load does not.
// Start forks and execs. Swap execs in place. List reads a directory
// of executable names that end in .x. The handshake is argv, a
// shared-memory path passed as an argument, and the exit code.
//
// Copyright (c) 2026 Sean Collins, 2 Paws Machine and Engineering.
// Licensed under the Sean Collins Software License (SCSL v1.0).

LibraryImport.Arena

FixedPool.LoadOnce {
    "up": Initialize=0
}

Function.Load_Boot {
    Body: {
        IfCondition EqualTo(LoadOnce.up, 1) ThenBlock: { ReturnValue(0) }
        Arena_Init()
        LoadOnce.up = 1
        ReturnValue(1)
    }
}

Function.Load_Exec {
    Input: bin: Address
    Input: a1: Address
    Input: a2: Address
    Output: Integer
    Body: {
        argv = 0
        envp = 0
        p = 0
        slot = 0
        IfCondition EqualTo(bin, 0) ThenBlock: { ReturnValue(0) }
        Load_Boot()
        argv = Allocate(32)
        MemorySet(argv, 0, 32)
        StoreValue(argv, bin)
        slot = 8
        IfCondition NotEqual(a1, 0) ThenBlock: {
            p = Add(argv, 8)
            StoreValue(p, a1)
            slot = 16
            IfCondition NotEqual(a2, 0) ThenBlock: {
                p = Add(argv, 16)
                StoreValue(p, a2)
                slot = 24
            }
        }
        p = Add(argv, slot)
        StoreValue(p, 0)
        envp = Allocate(8)
        StoreValue(envp, 0)
        SystemCall(59, bin, argv, envp, 0, 0)
        Deallocate(envp, 8)
        Deallocate(argv, 32)
        ReturnValue(0)
    }
}

Function.Load_Start {
    Input: bin: Address
    Input: a1: Address
    Input: a2: Address
    Output: Integer
    Body: {
        pid = 0
        IfCondition EqualTo(bin, 0) ThenBlock: { ReturnValue(0) }
        pid = SystemCall(57, 0, 0, 0, 0, 0)
        IfCondition LessThan(pid, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(pid, 0) ThenBlock: {
            Load_Exec(bin, a1, a2)
            SystemCall(60, 127, 0, 0, 0, 0)
        }
        ReturnValue(pid)
    }
}

Function.Load_Swap {
    Input: bin: Address
    Input: a1: Address
    Input: a2: Address
    Output: Integer
    Body: {
        hit = 0
        hit = Load_Exec(bin, a1, a2)
        ReturnValue(hit)
    }
}

Function.Load_Wait {
    Input: pid: Integer
    Output: Integer
    Body: {
        buf = 0
        wr = 0
        st = 0
        code = 0
        IfCondition LessEqual(pid, 0) ThenBlock: { ReturnValue(Subtract(0, 1)) }
        Load_Boot()
        buf = Allocate(8)
        MemorySet(buf, 0, 8)
        wr = SystemCall(61, pid, buf, 0, 0)
        st = Dereference(buf)
        Deallocate(buf, 8)
        IfCondition NotEqual(wr, pid) ThenBlock: { ReturnValue(Subtract(0, 1)) }
        code = BitwiseAnd(st, 127)
        IfCondition NotEqual(code, 0) ThenBlock: { ReturnValue(Subtract(0, 1)) }
        code = RightShift(st, 8)
        code = BitwiseAnd(code, 255)
        ReturnValue(code)
    }
}

Function.Load_Arg {
    Input: index: Integer
    Input: dest: Address
    Input: cap: Integer
    Output: Integer
    Body: {
        fd = 0
        n = 0
        i = 0
        seen = 0
        k = 0
        c = 0
        buf = 0
        lim = 0
        IfCondition LessThan(cap, 2) ThenBlock: { ReturnValue(Subtract(0, 1)) }
        IfCondition LessThan(index, 0) ThenBlock: { ReturnValue(Subtract(0, 1)) }
        Load_Boot()
        fd = SystemCall(2, "/proc/self/cmdline", 0, 0)
        IfCondition LessThan(fd, 0) ThenBlock: { ReturnValue(Subtract(0, 1)) }
        buf = Allocate(4096)
        n = SystemCall(0, fd, buf, 4095)
        SystemCall(3, fd, 0, 0)
        IfCondition LessEqual(n, 0) ThenBlock: {
            Deallocate(buf, 4096)
            ReturnValue(Subtract(0, 1))
        }
        SetByte(buf, n, 0)
        i = 0
        seen = 0
        WhileLoop LessThan(i, n) {
            IfCondition EqualTo(seen, index) ThenBlock: { BreakLoop }
            c = GetByte(buf, i)
            IfCondition EqualTo(c, 0) ThenBlock: { seen = Add(seen, 1) }
            i = Add(i, 1)
        }
        IfCondition NotEqual(seen, index) ThenBlock: {
            Deallocate(buf, 4096)
            ReturnValue(Subtract(0, 1))
        }
        lim = Subtract(cap, 1)
        k = 0
        WhileLoop LessThan(k, lim) {
            c = GetByte(buf, i)
            IfCondition EqualTo(c, 0) ThenBlock: { BreakLoop }
            SetByte(dest, k, c)
            k = Add(k, 1)
            i = Add(i, 1)
        }
        SetByte(dest, k, 0)
        Deallocate(buf, 4096)
        IfCondition EqualTo(k, 0) ThenBlock: { ReturnValue(Subtract(0, 1)) }
        ReturnValue(k)
    }
}

Function.Load_EndsX {
    Input: s: Address
    Output: Integer
    Body: {
        n = 0
        i = 0
        c = 0
        n = 0
        WhileLoop LessThan(n, 240) {
            c = GetByte(s, n)
            IfCondition EqualTo(c, 0) ThenBlock: { BreakLoop }
            n = Add(n, 1)
        }
        IfCondition LessThan(n, 3) ThenBlock: { ReturnValue(0) }
        i = Subtract(n, 2)
        c = GetByte(s, i)
        IfCondition NotEqual(c, 46) ThenBlock: { ReturnValue(0) }
        i = Subtract(n, 1)
        c = GetByte(s, i)
        IfCondition NotEqual(c, 120) ThenBlock: { ReturnValue(0) }
        ReturnValue(1)
    }
}

Function.Load_Join {
    Input: dir: Address
    Input: name: Address
    Input: dest: Address
    Input: cap: Integer
    Output: Integer
    Body: {
        i = 0
        c = 0
        m = 0
        lim = 0
        lim = Subtract(cap, 1)
        IfCondition LessThan(lim, 2) ThenBlock: { ReturnValue(0) }
        i = 0
        WhileLoop LessThan(i, lim) {
            c = GetByte(dir, i)
            IfCondition EqualTo(c, 0) ThenBlock: { BreakLoop }
            SetByte(dest, i, c)
            i = Add(i, 1)
        }
        IfCondition EqualTo(i, 0) ThenBlock: { ReturnValue(0) }
        c = GetByte(dest, Subtract(i, 1))
        IfCondition NotEqual(c, 47) ThenBlock: {
            IfCondition GreaterEqual(i, lim) ThenBlock: { ReturnValue(0) }
            SetByte(dest, i, 47)
            i = Add(i, 1)
        }
        m = 0
        WhileLoop LessThan(m, 240) {
            c = GetByte(name, m)
            IfCondition EqualTo(c, 0) ThenBlock: { BreakLoop }
            IfCondition GreaterEqual(i, lim) ThenBlock: { ReturnValue(0) }
            SetByte(dest, i, c)
            i = Add(i, 1)
            m = Add(m, 1)
        }
        SetByte(dest, i, 0)
        ReturnValue(1)
    }
}

Function.Load_IsExe {
    Input: path: Address
    Output: Integer
    Body: {
        buf = 0
        r = 0
        mode = 0
        p = 0
        kind = 0
        ix = 0
        buf = Allocate(144)
        r = SystemCall(4, path, buf)
        IfCondition LessThan(r, 0) ThenBlock: {
            Deallocate(buf, 144)
            ReturnValue(0)
        }
        p = Add(buf, 24)
        mode = Dereference(p)
        Deallocate(buf, 144)
        kind = BitwiseAnd(mode, 61440)
        IfCondition NotEqual(kind, 32768) ThenBlock: { ReturnValue(0) }
        ix = BitwiseAnd(mode, 73)
        IfCondition EqualTo(ix, 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(1)
    }
}

Function.Load_Keep {
    Input: names: Address
    Input: idx: Integer
    Input: stride: Integer
    Input: src: Address
    Body: {
        off = 0
        dest = 0
        i = 0
        c = 0
        lim = 0
        off = Multiply(idx, stride)
        dest = Add(names, off)
        lim = Subtract(stride, 1)
        i = 0
        WhileLoop LessThan(i, lim) {
            c = GetByte(src, i)
            SetByte(dest, i, c)
            IfCondition EqualTo(c, 0) ThenBlock: { ReturnValue(0) }
            i = Add(i, 1)
        }
        SetByte(dest, lim, 0)
        ReturnValue(0)
    }
}

Function.Load_List {
    Input: dir: Address
    Input: names: Address
    Input: cap: Integer
    Input: stride: Integer
    Output: Integer
    Body: {
        fd = 0
        n = 0
        off = 0
        rec = 0
        lo = 0
        hi = 0
        dent = 0
        path = 0
        tmp = 0
        np = 0
        dt = 0
        hit = 0
        kept = 0
        i = 0
        c = 0
        at = 0
        IfCondition EqualTo(dir, 0) ThenBlock: { ReturnValue(Subtract(0, 1)) }
        IfCondition LessThan(cap, 1) ThenBlock: { ReturnValue(Subtract(0, 1)) }
        IfCondition LessThan(stride, 2) ThenBlock: { ReturnValue(Subtract(0, 1)) }
        Load_Boot()
        dent = Allocate(4096)
        path = Allocate(512)
        tmp = Allocate(64)
        fd = SystemCall(2, dir, 65536, 0)
        IfCondition LessThan(fd, 0) ThenBlock: {
            Deallocate(tmp, 64)
            Deallocate(path, 512)
            Deallocate(dent, 4096)
            ReturnValue(Subtract(0, 1))
        }
        kept = 0
        n = SystemCall(217, fd, dent, 4096)
        WhileLoop GreaterThan(n, 0) {
            off = 0
            WhileLoop LessThan(off, n) {
                at = Add(off, 16)
                lo = GetByte(dent, at)
                at = Add(off, 17)
                hi = GetByte(dent, at)
                rec = Multiply(hi, 256)
                rec = Add(lo, rec)
                IfCondition LessThan(rec, 20) ThenBlock: { BreakLoop }
                at = Add(off, 18)
                dt = GetByte(dent, at)
                IfCondition NotEqual(dt, 4) ThenBlock: {
                    np = Add(dent, off)
                    np = Add(np, 19)
                    MemorySet(tmp, 0, 64)
                    i = 0
                    WhileLoop LessThan(i, 63) {
                        c = GetByte(np, i)
                        SetByte(tmp, i, c)
                        IfCondition EqualTo(c, 0) ThenBlock: { BreakLoop }
                        i = Add(i, 1)
                    }
                    SetByte(tmp, 63, 0)
                    hit = Load_EndsX(tmp)
                    IfCondition EqualTo(hit, 1) ThenBlock: {
                        hit = Load_Join(dir, tmp, path, 512)
                        IfCondition EqualTo(hit, 1) ThenBlock: {
                            hit = Load_IsExe(path)
                            IfCondition EqualTo(hit, 1) ThenBlock: {
                                IfCondition LessThan(kept, cap) ThenBlock: {
                                    Load_Keep(names, kept, stride, tmp)
                                    kept = Add(kept, 1)
                                }
                            }
                        }
                    }
                }
                off = Add(off, rec)
            }
            n = SystemCall(217, fd, dent, 4096)
        }
        SystemCall(3, fd, 0, 0)
        Deallocate(tmp, 64)
        Deallocate(path, 512)
        Deallocate(dent, 4096)
        ReturnValue(kept)
    }
}
