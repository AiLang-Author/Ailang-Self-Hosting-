// Library.Math — composed float helpers. Not C math.h.
// Compiler builtins (Float_Sin, Float_Sqrt, …) need no import.
// This file is optional: LibraryImport.Math for Hypot/Atan/Asin/Acos/Log2/Log10/Exp2.

Function.Math.Hypot {
    Input: x: Integer
    Input: y: Integer
    Output: Integer
    Body: {
        x2 = Float_Mul(x, x)
        y2 = Float_Mul(y, y)
        s = Float_Add(x2, y2)
        h = Float_Sqrt(s)
        ReturnValue(h)
    }
}

Function.Math.Atan {
    Input: x: Integer
    Output: Integer
    Body: {
        one = 4607182418800017408
        a = Float_Atan2(x, one)
        ReturnValue(a)
    }
}

Function.Math.Log2 {
    Input: x: Integer
    Output: Integer
    Body: {
        lx = Float_Log(x)
        ln2 = 4604418534313441775
        r = Float_Div(lx, ln2)
        ReturnValue(r)
    }
}

Function.Math.Log10 {
    Input: x: Integer
    Output: Integer
    Body: {
        lx = Float_Log(x)
        ln10 = 4612367379483415830
        r = Float_Div(lx, ln10)
        ReturnValue(r)
    }
}

Function.Math.Exp2 {
    Input: x: Integer
    Output: Integer
    Body: {
        ln2 = 4604418534313441775
        t = Float_Mul(x, ln2)
        e = Float_Exp(t)
        ReturnValue(e)
    }
}

Function.Math.Asin {
    Input: x: Integer
    Output: Integer
    Body: {
        one = 4607182418800017408
        x2 = Float_Mul(x, x)
        d = Float_Sub(one, x2)
        s = Float_Sqrt(d)
        a = Float_Atan2(x, s)
        ReturnValue(a)
    }
}

Function.Math.Acos {
    Input: x: Integer
    Output: Integer
    Body: {
        one = 4607182418800017408
        x2 = Float_Mul(x, x)
        d = Float_Sub(one, x2)
        s = Float_Sqrt(d)
        a = Float_Atan2(s, x)
        ReturnValue(a)
    }
}
