// Library.MediaProbe.ailang
// Container format detection by magic bytes.
//
// Reads the first 16 bytes of a file and returns a container type ID.
// Orthogonal: no dependency on any other media component.
//
// Usage:
//   fmt = MediaProbe_DetectFile("/path/to/file.mp4")
//   // fmt == MPFormat.MP4
//
// Copyright 2026 Sean Collins, 2 Paws Machine and Engineering. SCSL.

LibraryImport.Arena

// =============================================================================
// FORMAT IDS
// =============================================================================
FixedPool.MPFormat {
    "UNKNOWN":  Initialize=0
    "WAV":      Initialize=1
    "MP4":      Initialize=2
    "MKV":      Initialize=3
    "WEBM":     Initialize=3
    "AVI":      Initialize=4
    "FLAC":     Initialize=5
    "OGG":      Initialize=6
    "MP3":      Initialize=7
}

// Syscall constants
FixedPool.MPSys {
    "SYS_OPEN":  Initialize=2
    "SYS_READ":  Initialize=0
    "SYS_CLOSE": Initialize=3
    "O_RDONLY":  Initialize=0
}

// =============================================================================
// DETECT FROM FILE PATH
// Returns MPFormat value
// =============================================================================
Function.MediaProbe_DetectFile {
    Input: path: Address
    Output: Integer
    Body: {
        fd = SystemCall(MPSys.SYS_OPEN, path, MPSys.O_RDONLY, 0)
        IfCondition LessThan(fd, 0) ThenBlock: {
            PrintMessage("[MediaProbe] cannot open: ")
            PrintString(path)
            PrintMessage("\n")
            ReturnValue(MPFormat.UNKNOWN)
        }

        buf = Allocate(16)
        n = SystemCall(MPSys.SYS_READ, fd, buf, 16, 0, 0, 0)
        SystemCall(MPSys.SYS_CLOSE, fd, 0, 0, 0, 0, 0)

        IfCondition LessThan(n, 4) ThenBlock: {
            Deallocate(buf, 16)
            ReturnValue(MPFormat.UNKNOWN)
        }

        result = MediaProbe_DetectBytes(buf, n)
        Deallocate(buf, 16)
        ReturnValue(result)
    }
}

// =============================================================================
// DETECT FROM BUFFER — check magic bytes
// =============================================================================
Function.MediaProbe_DetectBytes {
    Input: buf:  Address
    Input: len:  Integer
    Output: Integer
    Body: {
        b0 = GetByte(buf, 0)
        b1 = GetByte(buf, 1)
        b2 = GetByte(buf, 2)
        b3 = GetByte(buf, 3)

        // RIFF container: WAV or AVI
        // 0x52 0x49 0x46 0x46 = "RIFF"
        IfCondition And(And(EqualTo(b0, 82), EqualTo(b1, 73)), And(EqualTo(b2, 70), EqualTo(b3, 70))) ThenBlock: {
            // Check bytes 8-11 for subtype
            IfCondition GreaterEqual(len, 12) ThenBlock: {
                b8  = GetByte(buf, 8)
                b9  = GetByte(buf, 9)
                b10 = GetByte(buf, 10)
                b11 = GetByte(buf, 11)
                // "WAVE" = 0x57 0x41 0x56 0x45
                IfCondition And(And(EqualTo(b8, 87), EqualTo(b9, 65)), And(EqualTo(b10, 86), EqualTo(b11, 69))) ThenBlock: {
                    ReturnValue(MPFormat.WAV)
                }
                // "AVI " = 0x41 0x56 0x49 0x20
                IfCondition And(And(EqualTo(b8, 65), EqualTo(b9, 86)), And(EqualTo(b10, 73), EqualTo(b11, 32))) ThenBlock: {
                    ReturnValue(MPFormat.AVI)
                }
            }
            ReturnValue(MPFormat.UNKNOWN)
        }

        // MKV/WebM: EBML header 0x1A 0x45 0xDF 0xA3
        IfCondition And(And(EqualTo(b0, 26), EqualTo(b1, 69)), And(EqualTo(b2, 223), EqualTo(b3, 163))) ThenBlock: {
            ReturnValue(MPFormat.MKV)
        }

        // FLAC: "fLaC" = 0x66 0x4C 0x61 0x43
        IfCondition And(And(EqualTo(b0, 102), EqualTo(b1, 76)), And(EqualTo(b2, 97), EqualTo(b3, 67))) ThenBlock: {
            ReturnValue(MPFormat.FLAC)
        }

        // OGG: "OggS" = 0x4F 0x67 0x67 0x53
        IfCondition And(And(EqualTo(b0, 79), EqualTo(b1, 103)), And(EqualTo(b2, 103), EqualTo(b3, 83))) ThenBlock: {
            ReturnValue(MPFormat.OGG)
        }

        // MP3 with ID3 tag: "ID3" = 0x49 0x44 0x33
        IfCondition And(And(EqualTo(b0, 73), EqualTo(b1, 68)), EqualTo(b2, 51)) ThenBlock: {
            ReturnValue(MPFormat.MP3)
        }

        // MP3 frame sync: 0xFF 0xFB or 0xFF 0xF3 or 0xFF 0xF2
        IfCondition EqualTo(b0, 255) ThenBlock: {
            IfCondition Or(Or(EqualTo(b1, 251), EqualTo(b1, 243)), EqualTo(b1, 242)) ThenBlock: {
                ReturnValue(MPFormat.MP3)
            }
        }

        // MP4: check for ftyp box
        // Bytes 4-7 should be "ftyp" = 0x66 0x74 0x79 0x70
        IfCondition GreaterEqual(len, 8) ThenBlock: {
            b4 = GetByte(buf, 4)
            b5 = GetByte(buf, 5)
            b6 = GetByte(buf, 6)
            b7 = GetByte(buf, 7)
            IfCondition And(And(EqualTo(b4, 102), EqualTo(b5, 116)), And(EqualTo(b6, 121), EqualTo(b7, 112))) ThenBlock: {
                ReturnValue(MPFormat.MP4)
            }
        }

        ReturnValue(MPFormat.UNKNOWN)
    }
}

// =============================================================================
// FORMAT NAME — return a string name for a format ID (for debug)
// =============================================================================
Function.MediaProbe_FormatName {
    Input: fmt: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(fmt, MPFormat.WAV)  ThenBlock: { ReturnValue("WAV") }
        IfCondition EqualTo(fmt, MPFormat.MP4)  ThenBlock: { ReturnValue("MP4") }
        IfCondition EqualTo(fmt, MPFormat.MKV)  ThenBlock: { ReturnValue("MKV/WebM") }
        IfCondition EqualTo(fmt, MPFormat.AVI)  ThenBlock: { ReturnValue("AVI") }
        IfCondition EqualTo(fmt, MPFormat.FLAC) ThenBlock: { ReturnValue("FLAC") }
        IfCondition EqualTo(fmt, MPFormat.OGG)  ThenBlock: { ReturnValue("OGG") }
        IfCondition EqualTo(fmt, MPFormat.MP3)  ThenBlock: { ReturnValue("MP3") }
        ReturnValue("UNKNOWN")
    }
}
