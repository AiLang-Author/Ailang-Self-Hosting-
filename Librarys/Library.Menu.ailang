// ─── Library.Menu.ailang ─────────────────────────────────────────────────────
// Dropdown menus for window toolbar. Deskbar-style overlay with own AKCtx.
// One menu open at a time. F/E/V/H buttons fire menu:file etc., routed here.
// Copyright © 2025 Sean Collins, 2 Paws Machine and Engineering. All rights reserved. SCSL.

LibraryImport.DSurfaceTypes
LibraryImport.DSurface
LibraryImport.DDrawPixel
LibraryImport.Auckland
LibraryImport.AucklandEvent
LibraryImport.AKSlot
LibraryImport.WinManager
LibraryImport.Fonts
LibraryImport.TextRegion
LibraryImport.SysDisplay
LibraryImport.EventRouter

// =============================================================================
// STATE
// =============================================================================
FixedPool.MenuState {
    "open":       Initialize=0, CanChange=True
    "menu_id":    Initialize=-1, CanChange=True
    "source_win": Initialize=-1, CanChange=True
    "screen_x":   Initialize=0, CanChange=True
    "screen_y":   Initialize=0, CanChange=True
    "width":      Initialize=160, CanChange=True
    "height":     Initialize=0, CanChange=True
    "surface":    Initialize=0, CanChange=True
    "ak_slot":    Initialize=-1, CanChange=True
}

FixedPool.MenuConst {
    "ITEM_W":  Initialize=160
    "ITEM_H":  Initialize=26
    "PAD":     Initialize=4
    "BG":      Initialize=0xFF32323C
    "FG":      Initialize=0xFFDCDCDC
    "SEP_CLR": Initialize=0xFF505064
}

// =============================================================================
// INIT
// =============================================================================
Function.Menu_Init {
    Output: Integer
    Body: {
        DebugLog_Push("mn.init", 7)
        MenuState.open = 0
        MenuState.ak_slot = -1
        MenuState.surface = 0
        ReturnValue(1)
    }
}

// =============================================================================
// ADD ITEM / SEPARATOR HELPERS
// =============================================================================
Function.Menu_AddItem {
    Input: parent: Integer
    Input: label_ptr: Integer
    Input: label_len: Integer
    Input: action_ptr: Integer
    Input: action_len: Integer
    Input: w: Integer
    Input: h: Integer
    Body: {
        DebugLog_Push("mn.add", 6)
        btn = AK_CreateNode(AKTag.BUTTON)
        AK_Set(btn, AKF.WIDTH, w)
        AK_Set(btn, AKF.HEIGHT, h)
        AK_ExtraSet(btn, AKExtra.STR_PTR, label_ptr)
        AK_ExtraSet(btn, AKExtra.STR_LEN, label_len)
        AK_ExtraSet(btn, AKExtra.ACTION_PTR, action_ptr)
        AK_ExtraSet(btn, AKExtra.ACTION_LEN, action_len)
        AK_ExtraSet(btn, AKExtra.TEXT_ALIGN, TRAlign.LEFT)
        AK_ExtraSet(btn, AKExtra.COLOR_BG, MenuConst.BG)
        AK_ExtraSet(btn, AKExtra.COLOR_FG, MenuConst.FG)
        AK_AddChild(parent, btn)
    }
}

Function.Menu_AddSeparator {
    Input: parent: Integer
    Input: w: Integer
    Body: {
        DebugLog_Push("mn.sep", 6)
        sep = AK_CreateNode(AKTag.SEPARATOR)
        AK_Set(sep, AKF.HEIGHT, 1)
        AK_Set(sep, AKF.WIDTH, w)
        AK_ExtraSet(sep, AKExtra.COLOR_FG, MenuConst.SEP_CLR)
        AK_AddChild(parent, sep)
    }
}

// =============================================================================
// BUILD MENU TREES
// =============================================================================
Function.Menu_BuildFile {
    Input: root: Integer
    Body: {
        DebugLog_Push("mn.bf", 5)
        w = MenuConst.ITEM_W
        h = MenuConst.ITEM_H
        Menu_AddItem(root, "New Window", 10, "win.new", 7, w, h)
        Menu_AddItem(root, "Open File", 9, "app.files", 9, w, h)
        Menu_AddSeparator(root, w)
        Menu_AddItem(root, "Close", 5, "win.close", 9, w, h)
        Menu_AddSeparator(root, w)
        Menu_AddItem(root, "Quit", 4, "app.quit", 8, w, h)
    }
}

Function.Menu_BuildEdit {
    Input: root: Integer
    Body: {
        DebugLog_Push("mn.be", 5)
        w = MenuConst.ITEM_W
        h = MenuConst.ITEM_H
        Menu_AddItem(root, "Add Text", 8, "doc.addtext", 11, w, h)
        Menu_AddItem(root, "Clear", 5, "doc.clear", 9, w, h)
    }
}

Function.Menu_BuildView {
    Input: root: Integer
    Body: {
        DebugLog_Push("mn.bv", 5)
        w = MenuConst.ITEM_W
        h = MenuConst.ITEM_H
        Menu_AddItem(root, "Zoom In", 7, "view.zoomin", 11, w, h)
        Menu_AddItem(root, "Zoom Out", 8, "view.zoomout", 12, w, h)
    }
}

Function.Menu_BuildHelp {
    Input: root: Integer
    Body: {
        DebugLog_Push("mn.bh", 5)
        w = MenuConst.ITEM_W
        h = MenuConst.ITEM_H
        Menu_AddItem(root, "About", 5, "app.about", 9, w, h)
    }
}

// =============================================================================
// COMPUTE HEIGHT — walk children to sum item heights + padding
// Reusable: works on any VBOX root with BUTTON (ITEM_H) and SEPARATOR (1px)
// children. Call while the menu AK slot is swapped in.
// =============================================================================
Function.Menu_ComputeHeight {
    Input: root: Integer
    Output: Integer
    Body: {
        DebugLog_Push("mn.ch", 5)
        h = Multiply(MenuConst.PAD, 2)
        child = AK_Get(root, AKF.FIRST_CHILD)
        guard = 0
        WhileLoop NotEqual(child, -1) {
            guard = Add(guard, 1)
            IfCondition GreaterThan(guard, 64) ThenBlock: {
                PrintMessage("[Menu] LOOP in ComputeHeight child=")
                PrintNumber(child)
                PrintMessage("\n")
                ReturnValue(h)
            }
            tag = AK_Get(child, AKF.TAG)
            IfCondition EqualTo(tag, AKTag.SEPARATOR) ThenBlock: {
                h = Add(h, 1)
            } ElseBlock: {
                h = Add(h, MenuConst.ITEM_H)
            }
            child = AK_Get(child, AKF.NEXT_SIBLING)
        }
        ReturnValue(h)
    }
}

// =============================================================================
// RENDER — solve + draw menu tree into its surface
// Reusable: call after building/modifying items to re-render.
// Expects menu AK slot already swapped in.
// =============================================================================
Function.Menu_Render {
    Input: surf: Integer
    Input: w: Integer
    Input: h: Integer
    Body: {
        DebugLog_Push("mn.ren", 6)
        PrintMessage("[Menu_Render] surf=")
        PrintNumber(surf)
        PrintMessage(" w=")
        PrintNumber(w)
        PrintMessage(" h=")
        PrintNumber(h)
        PrintMessage("\n")

        // Fill background
        DebugLog_Push("mn.ren.1", 8)
        Draw_Pix_FillRect(surf, 0, 0, w, h, MenuConst.BG)

        // Solve and draw the AK tree
        VFont_RasterAll(14)
        DebugLog_Push("mn.ren.2", 8)
        AK_Draw(surf, w, h)
        VFont_RasterAll(18)
    }
}

// =============================================================================
// SHOW — open a dropdown menu anchored to toolbar button
//
// menu_id:    0=File, 1=Edit, 2=View, 3=Help (builder dispatch)
// source_win: window whose toolbar spawned this menu
//
// Creates an AK slot, builds items via the builder, measures the tree,
// creates a surface, renders, and positions below the toolbar button.
// =============================================================================
Function.Menu_Show {
    Input: menu_id: Integer
    Input: source_win: Integer
    Output: Integer
    Body: {
        DebugLog_Push("MN.show", 7)
        PrintMessage("[Menu] Show id=")
        PrintNumber(menu_id)
        PrintMessage(" win=")
        PrintNumber(source_win)
        PrintMessage("\n")

        // Toggle — if same menu already open, close it
        IfCondition EqualTo(MenuState.open, 1) ThenBlock: {
            IfCondition EqualTo(MenuState.menu_id, menu_id) ThenBlock: {
                Menu_Close()
                ReturnValue(0)
            }
            Menu_Close()
        }

        // Free old slot if leftover
        old_slot = MenuState.ak_slot
        IfCondition GreaterEqual(old_slot, 0) ThenBlock: {
            AKSlot_Free(old_slot)
            MenuState.ak_slot = -1
        }

        // Allocate AK slot for menu
        DebugLog_Push("mn.sho.2", 8)
        ak_slot = AKSlot_Alloc()
        IfCondition LessThan(ak_slot, 0) ThenBlock: {
            PrintMessage("[Menu] AKSlot alloc failed\n")
            DebugLog_Push("MN!ak", 5)
            ReturnValue(0)
        }
        MenuState.ak_slot = ak_slot
        DebugLog_Push("MN.ak", 5)

        DebugLog_Push("mn.sho.3", 8)
        AKSlot_SwapIn(ak_slot)

        PrintMessage("[Menu] post-swap data=")
        PrintNumber(AKTree.data)
        PrintMessage(" cnt=")
        PrintNumber(AKTree.count)
        PrintMessage(" root=")
        PrintNumber(AKTree.root)
        PrintMessage("\n")

        // Build menu tree — PANEL root gets extra for bg/border
        PrintMessage("[Menu] creating root node...\n")
        root = AK_CreateNode(AKTag.PANEL)
        PrintMessage("[Menu] root node=")
        PrintNumber(root)
        PrintMessage("\n")
        AK_Set(root, AKF.LAYOUT_MODE, AKLayout.VBOX)
        AK_Set(root, AKF.GAP, 0)
        AK_Set(root, AKF.PAD_T, MenuConst.PAD)
        AK_Set(root, AKF.PAD_R, MenuConst.PAD)
        AK_Set(root, AKF.PAD_B, MenuConst.PAD)
        AK_Set(root, AKF.PAD_L, MenuConst.PAD)
        AK_ExtraSet(root, AKExtra.COLOR_BG, MenuConst.BG)
        AK_ExtraSet(root, AKExtra.BORDER_W, 1)
        AK_ExtraSet(root, AKExtra.BORDER_CLR, 0xFF505064)
        AK_SetRoot(root)
        PrintMessage("[Menu] root set, building items...\n")
        DebugLog_Push("MN.tree", 7)

        // Dispatch to builder — each adds items to root
        IfCondition EqualTo(menu_id, 0) ThenBlock: { Menu_BuildFile(root) }
        IfCondition EqualTo(menu_id, 1) ThenBlock: { Menu_BuildEdit(root) }
        IfCondition EqualTo(menu_id, 2) ThenBlock: { Menu_BuildView(root) }
        IfCondition EqualTo(menu_id, 3) ThenBlock: { Menu_BuildHelp(root) }
        PrintMessage("[Menu] build done, cnt=")
        PrintNumber(AKTree.count)
        PrintMessage("\n")
        DebugLog_Push("MN.build", 8)

        // BISECT: early-return after tree build + swap out, before surface/render
        PrintMessage("[Menu] BISECT: early-return before Surface_Create\n")
        DebugLog_Push("MN.bisct", 8)
        AKSlot_SwapOut()
        AKSlot_Free(ak_slot)
        MenuState.ak_slot = -1
        ReturnValue(0)

        // Compute surface size from tree content
        menu_w = Add(MenuConst.ITEM_W, Multiply(MenuConst.PAD, 2))
        menu_h = Menu_ComputeHeight(root)
        PrintMessage("[Menu] size=")
        PrintNumber(menu_w)
        PrintMessage("x")
        PrintNumber(menu_h)
        PrintMessage("\n")

        // Create surface
        PrintMessage("[Menu] creating surface...\n")
        DebugLog_Push("mn.sho.1", 8)
        surf = Surface_Create(SurfaceFormat.PIXEL_32, menu_w, menu_h)
        IfCondition EqualTo(surf, 0) ThenBlock: {
            PrintMessage("[Menu] surface alloc failed\n")
            DebugLog_Push("MN!surf", 7)
            AKSlot_SwapOut()
            AKSlot_Free(ak_slot)
            MenuState.ak_slot = -1
            ReturnValue(0)
        }
        DebugLog_Push("MN.surf", 7)

        // Set design dimensions to match actual surface — prevents
        // AK_ComputeScale from shrinking everything (default is 320x24).
        AKTree.design_w = menu_w
        AKTree.design_h = menu_h

        // Render tree into surface
        PrintMessage("[Menu] rendering...\n")
        DebugLog_Push("mn.sho.4", 8)
        Menu_Render(surf, menu_w, menu_h)
        DebugLog_Push("mn.sho.5", 8)
        DebugLog_Push("MN.rend", 7)
        PrintMessage("[Menu] render done\n")

        DebugLog_Push("mn.sho.6", 8)
        AKSlot_SwapOut()
        DebugLog_Push("MN.out", 6)

        // Position below toolbar button
        // Toolbar buttons are 48px wide, positioned at win_x offset
        wx = Win_GetX(source_win)
        wy = Win_GetY(source_win)
        btn_x = Multiply(menu_id, 48)
        scr_x = Add(wx, btn_x)
        scr_y = wy

        MenuState.surface    = surf
        MenuState.width      = menu_w
        MenuState.height     = menu_h
        MenuState.screen_x   = scr_x
        MenuState.screen_y   = scr_y
        MenuState.menu_id    = menu_id
        MenuState.source_win = source_win
        MenuState.open       = 1

        SysDisplayState.dirty = 1

        PrintMessage("[Menu] opened id=")
        PrintNumber(menu_id)
        PrintMessage(" size=")
        PrintNumber(menu_w)
        PrintMessage("x")
        PrintNumber(menu_h)
        PrintMessage(" at ")
        PrintNumber(scr_x)
        PrintMessage(",")
        PrintNumber(scr_y)
        PrintMessage("\n")
        ReturnValue(1)
    }
}

// =============================================================================
// CLOSE
// =============================================================================
Function.Menu_Close {
    Body: {
        DebugLog_Push("mn.cls", 6)
        IfCondition EqualTo(MenuState.open, 0) ThenBlock: { ReturnValue(0) }

        surf = MenuState.surface
        IfCondition NotEqual(surf, 0) ThenBlock: {
            DebugLog_Push("mn.cls.1", 8)
            Surface_Destroy(surf)
            MenuState.surface = 0
        }

        ak_slot = MenuState.ak_slot
        IfCondition GreaterEqual(ak_slot, 0) ThenBlock: {
            DebugLog_Push("mn.cls.2", 8)
            AKSlot_Free(ak_slot)
            MenuState.ak_slot = -1
        }

        MenuState.open       = 0
        MenuState.menu_id    = -1
        MenuState.source_win = -1
        SysDisplayState.dirty = 1
    }
}

// =============================================================================
// HIT TEST
// =============================================================================
Function.Menu_HitTest {
    Input: mx: Integer
    Input: my: Integer
    Output: Integer
    Body: {
        DebugLog_Push("mn.ht", 5)
        IfCondition EqualTo(MenuState.open, 0) ThenBlock: { ReturnValue(0) }
        sx = MenuState.screen_x
        sy = MenuState.screen_y
        w  = MenuState.width
        h  = MenuState.height
        IfCondition And(
            And(GreaterEqual(mx, sx), LessThan(mx, Add(sx, w))),
            And(GreaterEqual(my, sy), LessThan(my, Add(sy, h)))
        ) ThenBlock: {
            ReturnValue(1)
        }
        ReturnValue(0)
    }
}

// =============================================================================
// EVENT — dispatch mouse into menu AKCtx
// =============================================================================
Function.Menu_Event {
    Input: screen_x: Integer
    Input: screen_y: Integer
    Input: mouse_ev: Integer
    Output: Integer
    Body: {
        DebugLog_Push("mn.evt", 6)
        IfCondition EqualTo(MenuState.open, 0) ThenBlock: { ReturnValue(0) }
        ak_slot = MenuState.ak_slot
        IfCondition LessThan(ak_slot, 0) ThenBlock: { ReturnValue(0) }
        surf = MenuState.surface
        IfCondition EqualTo(surf, 0) ThenBlock: { ReturnValue(0) }

        local_x = Subtract(screen_x, MenuState.screen_x)
        local_y = Subtract(screen_y, MenuState.screen_y)

        DebugLog_Push("mn.ev.1", 7)
        AKSlot_SwapIn(ak_slot)
        AKEvent.action_callback = AddressOf(EventRouter_NoOpCallback)

        DebugLog_Push("mn.ev.2", 7)
        AK_EventMouse(local_x, local_y, mouse_ev)

        // Redraw on state changes (hover/pressed visual feedback)
        IfCondition GreaterThan(AKEvent.dirty_count, 0) ThenBlock: {
            DebugLog_Push("mn.ev.3", 7)
            Menu_Render(surf, MenuState.width, MenuState.height)
            AKEvent.dirty_count = 0
            SysDisplayState.dirty = 1
        }

        // Capture fired action on UP
        fired_ptr = 0
        fired_len = 0
        IfCondition EqualTo(mouse_ev, AKMouseEv.UP) ThenBlock: {
            fn = AKEvent.focus_node
            IfCondition GreaterEqual(fn, 0) ThenBlock: {
                ap = AK_ExtraGet(fn, AKExtra.ACTION_PTR)
                al = AK_ExtraGet(fn, AKExtra.ACTION_LEN)
                IfCondition And(NotEqual(ap, 0), GreaterThan(al, 0)) ThenBlock: {
                    fired_ptr = ap
                    fired_len = al
                }
            }
        }

        DebugLog_Push("mn.ev.4", 7)
        AKSlot_SwapOut()

        // Push action and close menu
        IfCondition NotEqual(fired_ptr, 0) ThenBlock: {
            DebugLog_Push("mn.ev.5", 7)
            source = MenuState.source_win
            EventRouter_Push(fired_ptr, fired_len, source)
            Menu_Close()
        }

        ReturnValue(0)
    }
}

// =============================================================================
// BLIT — draw menu surface to framebuffer (called from Win_BlitAll)
// =============================================================================
Function.Menu_Blit {
    Body: {
        DebugLog_Push("mn.blt", 6)
        IfCondition EqualTo(MenuState.open, 0) ThenBlock: { ReturnValue(0) }
        surf = MenuState.surface
        IfCondition EqualTo(surf, 0) ThenBlock: { ReturnValue(0) }
        Win_BlitOne(surf, MenuState.screen_x, MenuState.screen_y)
    }
}
