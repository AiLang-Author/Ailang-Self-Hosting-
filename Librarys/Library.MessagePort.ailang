//
// Library.MessagePort.ailang
// Phase 8 — IPC Message System: Port Registry + Send/Receive
//
// TYPE TRACKING RULES (compiler constraint):
//   @ operator only works on variables from AllocateLinkage or PointerTo= field reads.
//   Hash.Get returns untyped integer — use Dereference/StoreValue + MsgPortOfs/
//   MsgEnvOfs/MsgFieldOfs for any access on HashMap-sourced pointers.
//
// KERNEL MODULE SEAM:
//   Port_Send() and Port_Receive() swap when kernel module is ready.

LibraryImport.MessageTypes
LibraryImport.Hash

// =============================================================================
// STATE
// =============================================================================
FixedPool.PortRegistry {
    "by_id":    Initialize=0
    "by_hash":  Initialize=0
    "next_id":  Initialize=1
    "count":    Initialize=0
}

FixedPool.MsgEnv_FreeState {
    "env": Initialize=0
}

FixedPool.MsgPost {
    "param_a": Initialize=0
    "param_b": Initialize=0
}

// =============================================================================
// HELPERS — raw field access on untyped pointers
// =============================================================================

Function.Port_GetCount {
    Input:  port: Integer
    Output: Integer
    Body: {
        ReturnValue(Dereference(Add(port, MsgPortOfs.COUNT)))
    }
}

Function.Port_GetHead {
    Input:  port: Integer
    Output: Integer
    Body: {
        ReturnValue(Dereference(Add(port, MsgPortOfs.HEAD)))
    }
}

Function.Port_GetTail {
    Input:  port: Integer
    Output: Integer
    Body: {
        ReturnValue(Dereference(Add(port, MsgPortOfs.TAIL)))
    }
}

Function.Port_GetCapacity {
    Input:  port: Integer
    Output: Integer
    Body: {
        ReturnValue(Dereference(Add(port, MsgPortOfs.CAPACITY)))
    }
}

Function.Port_GetNameHash {
    Input:  port: Integer
    Output: Integer
    Body: {
        ReturnValue(Dereference(Add(port, MsgPortOfs.NAME_HASH)))
    }
}

Function.Env_GetNext {
    Input:  env: Integer
    Output: Integer
    Body: {
        ReturnValue(Dereference(Add(env, MsgEnvOfs.NEXT)))
    }
}

Function.Env_GetWhat {
    Input:  env: Integer
    Output: Integer
    Body: {
        ReturnValue(Dereference(Add(env, MsgEnvOfs.WHAT)))
    }
}

Function.Env_GetPayload {
    Input:  env: Integer
    Output: Integer
    Body: {
        ReturnValue(Dereference(Add(env, MsgEnvOfs.PAYLOAD)))
    }
}

Function.Env_GetFieldCount {
    Input:  env: Integer
    Output: Integer
    Body: {
        ReturnValue(Dereference(Add(env, MsgEnvOfs.FIELD_COUNT)))
    }
}

Function.Fld_GetNext {
    Input:  fld: Integer
    Output: Integer
    Body: {
        ReturnValue(Dereference(Add(fld, MsgFieldOfs.NEXT)))
    }
}

Function.Fld_GetNameHash {
    Input:  fld: Integer
    Output: Integer
    Body: {
        ReturnValue(Dereference(Add(fld, MsgFieldOfs.NAME_HASH)))
    }
}

Function.Fld_GetValue {
    Input:  fld: Integer
    Output: Integer
    Body: {
        ReturnValue(Dereference(Add(fld, MsgFieldOfs.VALUE)))
    }
}

// =============================================================================
// PORT LIFECYCLE
// =============================================================================

SubRoutine.Port_Init {
    PortRegistry.by_id   = Hash.Create(32)
    PortRegistry.by_hash = Hash.Create(32)
    PortRegistry.next_id = 1
    PortRegistry.count   = 0
    PrintMessage("[MsgPort] initialized\n")
}

Function.Port_Create {
    Input:  name_hash: Integer
    Input:  capacity:  Integer
    Output: Integer
    Body: {
        port = AllocateLinkage(LinkagePool.MsgPort)
        IfCondition EqualTo(port, 0) ThenBlock: {
            PrintMessage("[MsgPort] ERROR: alloc failed\n")
            ReturnValue(0)
        }

        new_id         = PortRegistry.next_id
        port@port_id   = new_id
        port@name_hash = name_hash
        port@capacity  = capacity
        port@count     = 0
        port@head      = 0
        port@tail      = 0

        id_str   = NumberToString(new_id)
        hash_str = NumberToString(name_hash)
        Hash.Set(PortRegistry.by_id,   id_str,   port)
        Hash.Set(PortRegistry.by_hash, hash_str, new_id)

        PortRegistry.next_id = Add(PortRegistry.next_id, 1)
        PortRegistry.count   = Add(PortRegistry.count, 1)

        ReturnValue(new_id)
    }
}

Function.Port_Resolve {
    Input:  name_hash: Integer
    Output: Integer
    Body: {
        hash_str = NumberToString(name_hash)
        pid = Hash.Get(PortRegistry.by_hash, hash_str)
        ReturnValue(pid)
    }
}

Function.Port_Destroy {
    Input:  port_id: Integer
    Output: Integer
    Body: {
        id_str = NumberToString(port_id)
        port   = Hash.Get(PortRegistry.by_id, id_str)
        IfCondition EqualTo(port, 0) ThenBlock: {
            ReturnValue(0)
        }

        // Drain envelopes
        env = Port_GetHead(port)
        WhileLoop NotEqual(env, 0) {
            nxt = Env_GetNext(env)
            MsgEnv_FreeState.env = env
            MsgEnv_Free()
            env = nxt
        }

        name_h     = Port_GetNameHash(port)
        name_h_str = NumberToString(name_h)
        Hash.Delete(PortRegistry.by_id,   id_str)
        Hash.Delete(PortRegistry.by_hash, name_h_str)

        FreeLinkage(port, LinkagePool.MsgPort)
        PortRegistry.count = Subtract(PortRegistry.count, 1)
        ReturnValue(1)
    }
}

// =============================================================================
// ENVELOPE ALLOCATION
// =============================================================================

Function.MsgEnv_Alloc {
    Input:  what:        Integer
    Input:  protocol:    Integer
    Input:  source_port: Integer
    Input:  target_port: Integer
    Output: Integer
    Body: {
        env = AllocateLinkage(LinkagePool.MsgEnvelope)
        IfCondition EqualTo(env, 0) ThenBlock: {
            ReturnValue(0)
        }
        env@what        = what
        env@protocol    = protocol
        env@source_port = source_port
        env@target_port = target_port
        env@seq         = 0
        env@field_count = 0
        env@payload     = 0
        env@next        = 0
        ReturnValue(env)
    }
}

SubRoutine.MsgEnv_Free {
    env = MsgEnv_FreeState.env
    fld = Dereference(Add(env, MsgEnvOfs.PAYLOAD))
    WhileLoop NotEqual(fld, 0) {
        nxt = Fld_GetNext(fld)
        FreeLinkage(fld, LinkagePool.MsgField)
        fld = nxt
    }
    FreeLinkage(env, LinkagePool.MsgEnvelope)
}

// =============================================================================
// FIELD BUILDER
// =============================================================================

Function.MsgField_Append {
    Input:  env:       Integer
    Input:  name_hash: Integer
    Input:  type_code: Integer
    Input:  value:     Integer
    Input:  fsize:     Integer
    Output: Integer
    Body: {
        fld = AllocateLinkage(LinkagePool.MsgField)
        IfCondition EqualTo(fld, 0) ThenBlock: {
            ReturnValue(0)
        }
        fld@name_hash  = name_hash
        fld@type_code  = type_code
        fld@value      = value
        fld@field_size = fsize
        fld@next       = 0

        cur = Dereference(Add(env, MsgEnvOfs.PAYLOAD))
        IfCondition EqualTo(cur, 0) ThenBlock: {
            StoreValue(Add(env, MsgEnvOfs.PAYLOAD), fld)
        } ElseBlock: {
            cur_next = Fld_GetNext(cur)
            WhileLoop NotEqual(cur_next, 0) {
                cur      = cur_next
                cur_next = Fld_GetNext(cur)
            }
            // Inline setter — no SubRoutine pattern
            StoreValue(Add(cur, MsgFieldOfs.NEXT), fld)
        }

        old_count = Dereference(Add(env, MsgEnvOfs.FIELD_COUNT))
        StoreValue(Add(env, MsgEnvOfs.FIELD_COUNT), Add(old_count, 1))
        ReturnValue(1)
    }
}

Function.MsgEnv_AddInt {
    Input:  env:       Integer
    Input:  name_hash: Integer
    Input:  value:     Integer
    Output: Integer
    Body: {
        ReturnValue(MsgField_Append(env, name_hash, MsgFieldType.INT, value, 8))
    }
}

Function.MsgEnv_AddString {
    Input:  env:       Integer
    Input:  name_hash: Integer
    Input:  str_ptr:   Integer
    Output: Integer
    Body: {
        ReturnValue(MsgField_Append(env, name_hash, MsgFieldType.STRING, str_ptr, 0))
    }
}

Function.MsgEnv_AddHandle {
    Input:  env:       Integer
    Input:  name_hash: Integer
    Input:  handle:    Integer
    Output: Integer
    Body: {
        ReturnValue(MsgField_Append(env, name_hash, MsgFieldType.HANDLE, handle, 0))
    }
}

Function.MsgEnv_AddBool {
    Input:  env:       Integer
    Input:  name_hash: Integer
    Input:  value:     Integer
    Output: Integer
    Body: {
        ReturnValue(MsgField_Append(env, name_hash, MsgFieldType.BOOL, value, 0))
    }
}


// =============================================================================
// FIELD LOOKUP
// =============================================================================

Function.MsgField_Find {
    Input:  env:       Integer
    Input:  name_hash: Integer
    Output: Integer
    Body: {
        fld    = Dereference(Add(env, MsgEnvOfs.PAYLOAD))
        result = 0
        WhileLoop NotEqual(fld, 0) {
            fld_hash = Fld_GetNameHash(fld)
            IfCondition EqualTo(fld_hash, name_hash) ThenBlock: {
                result = fld
                fld    = 0
            } ElseBlock: {
                fld = Fld_GetNext(fld)
            }
        }
        ReturnValue(result)
    }
}

Function.MsgEnv_GetInt {
    Input:  env:       Integer
    Input:  name_hash: Integer
    Output: Integer
    Body: {
        fld = MsgField_Find(env, name_hash)
        IfCondition EqualTo(fld, 0) ThenBlock: {
            ReturnValue(0)
        }
        ReturnValue(Fld_GetValue(fld))
    }
}

Function.MsgEnv_GetString {
    Input:  env:       Integer
    Input:  name_hash: Integer
    Output: Integer
    Body: {
        fld = MsgField_Find(env, name_hash)
        IfCondition EqualTo(fld, 0) ThenBlock: {
            ReturnValue(0)
        }
        ReturnValue(Fld_GetValue(fld))
    }
}

Function.MsgEnv_GetHandle {
    Input:  env:       Integer
    Input:  name_hash: Integer
    Output: Integer
    Body: {
        fld = MsgField_Find(env, name_hash)
        IfCondition EqualTo(fld, 0) ThenBlock: {
            ReturnValue(0)
        }
        ReturnValue(Fld_GetValue(fld))
    }
}

// =============================================================================
// SEND / RECEIVE  *** KERNEL MODULE SEAM ***
// =============================================================================

Function.Port_Send {
    Input:  port_id: Integer
    Input:  env:     Integer
    Output: Integer
    Body: {
        id_str = NumberToString(port_id)
        port   = Hash.Get(PortRegistry.by_id, id_str)
        IfCondition EqualTo(port, 0) ThenBlock: {
            PrintMessage("[MsgPort] Send: port not found\n")
            ReturnValue(0)
        }

        // Capacity check — drop oldest if full
        cap       = Port_GetCapacity(port)
        cur_count = Port_GetCount(port)
        IfCondition NotEqual(cap, 0) ThenBlock: {
            IfCondition GreaterThan(cur_count, cap) ThenBlock: {
                old = Port_GetHead(port)
                IfCondition NotEqual(old, 0) ThenBlock: {
                    old_next = Env_GetNext(old)
                    StoreValue(Add(port, MsgPortOfs.HEAD), old_next)
                    IfCondition EqualTo(old_next, 0) ThenBlock: {
                        StoreValue(Add(port, MsgPortOfs.TAIL), 0)
                    }
                    MsgEnv_FreeState.env = old
                    MsgEnv_Free()
                    new_count = Subtract(Port_GetCount(port), 1)
                    StoreValue(Add(port, MsgPortOfs.COUNT), new_count)
                }
            }
        }

        // Enqueue at tail
        StoreValue(Add(env, MsgEnvOfs.NEXT), 0)
        cur_tail = Port_GetTail(port)
        IfCondition EqualTo(cur_tail, 0) ThenBlock: {
            StoreValue(Add(port, MsgPortOfs.HEAD), env)
            StoreValue(Add(port, MsgPortOfs.TAIL), env)
        } ElseBlock: {
            StoreValue(Add(cur_tail, MsgEnvOfs.NEXT), env)
            StoreValue(Add(port, MsgPortOfs.TAIL), env)
        }

        new_count = Add(Port_GetCount(port), 1)
        StoreValue(Add(port, MsgPortOfs.COUNT), new_count)
        ReturnValue(1)
    }
}

Function.Port_Receive {
    Input:  port_id: Integer
    Output: Integer
    Body: {
        id_str   = NumberToString(port_id)
        port     = Hash.Get(PortRegistry.by_id, id_str)
        IfCondition EqualTo(port, 0) ThenBlock: {
            ReturnValue(0)
        }
        cur_head = Port_GetHead(port)
        IfCondition EqualTo(cur_head, 0) ThenBlock: {
            ReturnValue(0)
        }

        env      = cur_head
        env_next = Env_GetNext(env)
        StoreValue(Add(port, MsgPortOfs.HEAD), env_next)
        IfCondition EqualTo(env_next, 0) ThenBlock: {
            StoreValue(Add(port, MsgPortOfs.TAIL), 0)
        }
        new_count = Subtract(Port_GetCount(port), 1)
        StoreValue(Add(port, MsgPortOfs.COUNT), new_count)
        StoreValue(Add(env, MsgEnvOfs.NEXT), 0)
        ReturnValue(env)
    }
}

Function.Port_IsEmpty {
    Input:  port_id: Integer
    Output: Integer
    Body: {
        id_str = NumberToString(port_id)
        port   = Hash.Get(PortRegistry.by_id, id_str)
        IfCondition EqualTo(port, 0) ThenBlock: {
            ReturnValue(1)
        }
        cur_count = Port_GetCount(port)
        IfCondition EqualTo(cur_count, 0) ThenBlock: {
            ReturnValue(1)
        }
        ReturnValue(0)
    }
}

Function.Port_Count {
    Input:  port_id: Integer
    Output: Integer
    Body: {
        id_str = NumberToString(port_id)
        port   = Hash.Get(PortRegistry.by_id, id_str)
        IfCondition EqualTo(port, 0) ThenBlock: {
            ReturnValue(0)
        }
        ReturnValue(Port_GetCount(port))
    }
}

Function.Port_Peek {
    Input:  port_id: Integer
    Output: Integer
    Body: {
        id_str = NumberToString(port_id)
        port   = Hash.Get(PortRegistry.by_id, id_str)
        IfCondition EqualTo(port, 0) ThenBlock: {
            ReturnValue(0)
        }
        ReturnValue(Port_GetHead(port))
    }
}