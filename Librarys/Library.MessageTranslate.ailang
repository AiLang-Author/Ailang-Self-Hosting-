//
// Library.MessageTranslate.ailang
// Phase 8 — IPC Message System: Protocol Dispatch
//
// This is the router. It knows:
//   - Which protocol an envelope came from (env@protocol)
//   - Which handler table to consult for that protocol
//   - How to dispatch to the correct handler by what_code
//   - How to post the result into Ring0
//
// It does NOT know BeAPI. It does NOT know Wayland.
// Those concerns live in Library.MsgBeAPI and Library.MsgWayland.
//
// Adding a new protocol:
//   1. Create Library.MsgXXX.ailang with handler functions
//   2. Call MsgTranslate_RegisterProtocol(MsgProtocol.XXX, handler_addr)
//   3. Done. Nothing else changes.
//
// Handler function signature (all protocols must conform):
//   Function.MyHandler {
//       Input:  env: Integer        (MsgEnvelope pointer)
//       Output: Integer             (1=ok, 0=error, -1=unknown what)
//   }

LibraryImport.MessageTypes
LibraryImport.MessagePort
LibraryImport.HashMap
LibraryImport.Display.Render.DRingTypes
LibraryImport.Display.Render.DRing0

// =============================================================================
// STATE
// One dispatch table per protocol.
// Key: what_code (Integer) → Value: handler function address (Integer)
// =============================================================================
FixedPool.MsgTranslate {
    "ailang_table":   Initialize=0   // HashMap for MsgProtocol.AILANG
    "beapi_table":    Initialize=0   // HashMap for MsgProtocol.BEAPI
    "wayland_table":  Initialize=0   // HashMap for MsgProtocol.WAYLAND
    "xorg_table":     Initialize=0   // HashMap for MsgProtocol.XORG
    "qt_table":       Initialize=0   // HashMap for MsgProtocol.QT
    "internal_table": Initialize=0   // HashMap for MsgProtocol.INTERNAL
    "initialized":    Initialize=0
}

// =============================================================================
// INIT
// =============================================================================
SubRoutine.MsgTranslate_Init {
    MsgTranslate.ailang_table   = HashMap.Create(32)
    MsgTranslate.beapi_table    = HashMap.Create(64)
    MsgTranslate.wayland_table  = HashMap.Create(64)
    MsgTranslate.xorg_table     = HashMap.Create(32)
    MsgTranslate.qt_table       = HashMap.Create(32)
    MsgTranslate.internal_table = HashMap.Create(16)
    MsgTranslate.initialized    = 1
    PrintMessage("[MsgTranslate] initialized\n")
}

// =============================================================================
// REGISTRATION
// Protocol handlers call this at startup to register their what_codes.
// func_addr: address of a Function that takes (env: Integer) → Integer
// =============================================================================
Function.MsgTranslate_Register {
    Input:  protocol:  Integer
    Input:  what_code: Integer
    Input:  func_addr: Address
    Output: Integer
    Body: {
        table = MsgTranslate_GetTable(protocol)
        IfCondition EqualTo(table, 0) ThenBlock: {
            PrintMessage("[MsgTranslate] Register: unknown protocol\n")
            ReturnValue(0)
        }
        HashMap.Set(table, what_code, func_addr)
        ReturnValue(1)
    }
}

// Internal: get the dispatch table for a protocol
Function.MsgTranslate_GetTable {
    Input:  protocol: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(protocol, MsgProtocol.AILANG) ThenBlock: {
            ReturnValue(MsgTranslate.ailang_table)
        }
        IfCondition EqualTo(protocol, MsgProtocol.BEAPI) ThenBlock: {
            ReturnValue(MsgTranslate.beapi_table)
        }
        IfCondition EqualTo(protocol, MsgProtocol.WAYLAND) ThenBlock: {
            ReturnValue(MsgTranslate.wayland_table)
        }
        IfCondition EqualTo(protocol, MsgProtocol.XORG) ThenBlock: {
            ReturnValue(MsgTranslate.xorg_table)
        }
        IfCondition EqualTo(protocol, MsgProtocol.QT) ThenBlock: {
            ReturnValue(MsgTranslate.qt_table)
        }
        IfCondition EqualTo(protocol, MsgProtocol.INTERNAL) ThenBlock: {
            ReturnValue(MsgTranslate.internal_table)
        }
        ReturnValue(0)
    }
}

// =============================================================================
// DISPATCH
// Main entry point. Called by the server tick for every received envelope.
// Looks up protocol → table → what_code → handler → call it.
// Returns handler result, or -1 if no handler registered.
// =============================================================================
Function.MsgTranslate_Dispatch {
    Input:  env: Integer
    Output: Integer
    Body: {
        table = MsgTranslate_GetTable(env@protocol)
        IfCondition EqualTo(table, 0) ThenBlock: {
            PrintMessage("[MsgTranslate] Dispatch: unknown protocol\n")
            ReturnValue(-1)
        }

        what_code = Dereference(Add(env, MsgEnvOfs.WHAT))
        handler = HashMap.Get(table, what_code)
        IfCondition EqualTo(handler, 0) ThenBlock: {
            // No handler registered for this what_code — not an error,
            // just unhandled. Caller decides whether to log or ignore.
            ReturnValue(-1)
        }

        // Call handler indirectly — handler(env)
        result = CallIndirect(handler, env)
        ReturnValue(result)
    }
}

// =============================================================================
// DRAIN HELPER
// Call this in the display server tick to process all pending envelopes
// on a port. Dispatches each, frees each.
// =============================================================================
SubRoutine.MsgTranslate_DrainPort {
    // Caller sets DrainState.port_id before calling
    port_id = DrainState.port_id
    env = Port_Receive(port_id)
    WhileLoop NotEqual(env, 0) {
        MsgTranslate_Dispatch(env)
        MsgEnv_FreeState.env = env
        MsgEnv_Free()
        env = Port_Receive(port_id)
    }
}

FixedPool.DrainState {
    "port_id": Initialize=0
}

// =============================================================================
// RING0 POSTING HELPERS
// Translators call these instead of Ring0_Post directly.
// Keeps Ring0 knowledge out of the protocol-specific files.
// =============================================================================

SubRoutine.MsgPost_WinCreate {
    // Caller sets MsgPost.param_a (width) and MsgPost.param_b (height)
    Ring0_Post(Ring0Cmd.WIN_CREATE, MsgPost.param_a, MsgPost.param_b)
}

SubRoutine.MsgPost_WinDestroy {
    // Caller sets MsgPost.param_a (window handle)
    Ring0_Post(Ring0Cmd.WIN_DESTROY, MsgPost.param_a, 0)
}

SubRoutine.MsgPost_FocusSet {
    // Caller sets MsgPost.param_a (leaf/surface handle)
    Ring0_Post(Ring0Cmd.FOCUS_SET, MsgPost.param_a, 0)
}

SubRoutine.MsgPost_TileSplitH {
    Ring0_Post(Ring0Cmd.TILE_SPLIT_H, MsgPost.param_a, 0)
}

SubRoutine.MsgPost_TileSplitV {
    Ring0_Post(Ring0Cmd.TILE_SPLIT_V, MsgPost.param_a, 0)
}

SubRoutine.MsgPost_TileMerge {
    Ring0_Post(Ring0Cmd.TILE_MERGE, MsgPost.param_a, 0)
}

SubRoutine.MsgPost_TileResize {
    // param_a = leaf, param_b = new split position
    Ring0_Post(Ring0Cmd.TILE_RESIZE, MsgPost.param_a, MsgPost.param_b)
}

SubRoutine.MsgPost_Quit {
    Ring0_Post(Ring0Cmd.QUIT, 0, 0)
}

// Shared parameter carrier for MsgPost_* SubRoutines
FixedPool.MsgPost {
    "param_a": Initialize=0
    "param_b": Initialize=0
}