// Library.MessageTypes.ailang
// Phase 8 — IPC Message System: Type Definitions
//
// Pure structure definitions. Zero logic. Zero dependencies.
// This file is the contract every other layer depends on.
// Wayland, BeAPI, Qt signals — all translate INTO these structures.
//
// Architecture:
//   MsgPort     — named endpoint (the "address")
//   MsgEnvelope — the message wrapper (the "letter")
//   MsgField    — typed named value inside a message (the "contents")
//
// All LinkagePool fields are 8 bytes. Bias rule: values 0-255 stored
// in FixedPools need +65536 bias. LinkagePool fields via @ operator
// do NOT need bias — the compiler handles them correctly.

// =============================================================================
// FIELD TYPE CODES
// Protocol-agnostic. BeAPI, Wayland, Qt all map to these.
// =============================================================================
FixedPool.MsgFieldType {
    "INT":    Initialize=1   // 64-bit integer (covers B_INT32, B_INT64, wl_fixed)
    "STRING": Initialize=2   // pointer to null-terminated string
    "RECT":   Initialize=3   // encoded as 4 packed ints in a heap block: x,y,w,h
    "POINT":  Initialize=4   // encoded as 2 packed ints: x,y
    "HANDLE": Initialize=5   // opaque handle/token (window token, surface id, etc.)
    "BOOL":   Initialize=6   // 0 or 1
    "FLOAT":  Initialize=7   // float bits packed into integer
    "BYTES":  Initialize=8   // raw byte buffer — value = ptr, field_size = byte count
}

// =============================================================================
// PROTOCOL IDENTIFIERS
// Which foreign protocol sourced this message.
// The translator layer uses this to route to the correct handler set.
// =============================================================================
FixedPool.MsgProtocol {
    "AILANG":  Initialize=1   // native — from another AILANG process
    "BEAPI":   Initialize=2   // BeOS/Haiku BMessage
    "WAYLAND": Initialize=3   // Wayland wire protocol
    "XORG":    Initialize=4   // X11 (via XWayland or direct)
    "QT":      Initialize=5   // Qt signal/slot bridge
    "INTERNAL":Initialize=6   // display server internal (Ring0 bypass path)
}

// =============================================================================
// WELL-KNOWN PORT NAMES (hashed)
// Computed: simple sum-of-bytes hash of the name string.
// These are the well-known addresses apps connect to.
// =============================================================================
FixedPool.WellKnownPort {
    "DISPLAY_SERVER": Initialize=0x44535256   // 'DSRV' — main server port
    "INPUT":          Initialize=0x494E5054   // 'INPT' — input event port
    "DESKBAR":        Initialize=0x44534252   // 'DSBR' — deskbar port
}

// =============================================================================
// MANUAL FIELD OFFSETS
// For use when pointer came from Hash.Get (untyped).
// Use Dereference(Add(ptr, offset)) / StoreValue(Add(ptr, offset), val)
// =============================================================================
FixedPool.MsgEnvOfs {
    "WHAT":        Initialize=0
    "PROTOCOL":    Initialize=8
    "SOURCE_PORT": Initialize=16
    "TARGET_PORT": Initialize=24
    "SEQ":         Initialize=32
    "FIELD_COUNT": Initialize=40
    "PAYLOAD":     Initialize=48
    "NEXT":        Initialize=56
}

FixedPool.MsgFieldOfs {
    "NAME_HASH":  Initialize=0
    "TYPE_CODE":  Initialize=8
    "VALUE":      Initialize=16
    "FIELD_SIZE": Initialize=24
    "NEXT":       Initialize=32
}

FixedPool.MsgPortOfs {
    "PORT_ID":   Initialize=0
    "NAME_HASH": Initialize=8
    "CAPACITY":  Initialize=16
    "COUNT":     Initialize=24
    "HEAD":      Initialize=32
    "TAIL":      Initialize=40
}

// =============================================================================
// LINKAGEPOOL: MsgField
// One typed named value inside an envelope.
// Fields form a singly-linked list hanging off MsgEnvelope.payload.
// =============================================================================
LinkagePool.MsgField {
    "name_hash":  Initialize=0              // hash of field name string
    "type_code":  Initialize=0              // MsgFieldType constant
    "value":      Initialize=0              // inline value OR pointer to heap block
    "field_size": Initialize=0              // byte count (for BYTES/STRING/RECT/POINT)
    "next":       Initialize=0, PointerTo=LinkagePool.MsgField
}

// =============================================================================
// LINKAGEPOOL: MsgEnvelope
// The message wrapper. One per queued message.
// Fields form a singly-linked list hanging off MsgPort.head.
// =============================================================================
LinkagePool.MsgEnvelope {
    "what":        Initialize=0              // command/event code (protocol-specific)
    "protocol":    Initialize=0              // MsgProtocol — who sent this
    "source_port": Initialize=0              // sender port_id (for reply routing)
    "target_port": Initialize=0              // destination port_id
    "seq":         Initialize=0              // sequence number (for ordering/ack)
    "field_count": Initialize=0              // number of MsgField entries
    "payload":     Initialize=0, PointerTo=LinkagePool.MsgField
    "next":        Initialize=0, PointerTo=LinkagePool.MsgEnvelope
}

// =============================================================================
// LINKAGEPOOL: MsgPort
// A named message endpoint. The port registry holds a linked list of these.
// Apps find ports by name_hash, then send envelopes into the queue.
// =============================================================================
LinkagePool.MsgPort {
    "port_id":    Initialize=0              // unique numeric ID
    "name_hash":  Initialize=0              // hash of port name
    "capacity":   Initialize=0              // max queued envelopes (0 = unlimited)
    "count":      Initialize=0              // current queued count
    "head":       Initialize=0, PointerTo=LinkagePool.MsgEnvelope
    "tail":       Initialize=0, PointerTo=LinkagePool.MsgEnvelope
    "next":       Initialize=0, PointerTo=LinkagePool.MsgPort
}