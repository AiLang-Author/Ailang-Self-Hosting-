//
// Library.MsgBeAPI.ailang
// Phase 8 — IPC Message System: BeAPI / Haiku BMessage Translation
//
// This file knows BeAPI. Nothing else does.
// Registers handlers for BMessage 'what' codes.
// Translates them into MsgPost_* calls → Ring0.
//
// BMessage what codes are 4-char literals packed as big-endian int32.
// Haiku source: app/Message.h, interface/Window.h
//
// Field name hashes: MsgBeAPI_Hash() — simple XOR-rotate hash of name string.
// We pre-compute the common ones as FixedPool constants to avoid
// runtime string hashing on the hot path.
//
// Usage:
//   LibraryImport.MsgBeAPI
//   MsgBeAPI_Init()   // registers all handlers with MsgTranslate

LibraryImport.MessageTypes
LibraryImport.MessagePort
LibraryImport.MessageTranslate

// =============================================================================
// BEAPI WHAT CODES
// 4-char codes packed as integer (big-endian ASCII).
// Only the subset we handle — not the full Haiku set.
// =============================================================================
FixedPool.BMsg {
    // Window lifecycle
    "WIN_CREATE":  Initialize=0x4D435254   // _MCR (our name, no exact BMessage equiv)
    "WIN_DESTROY": Initialize=0x5F574453   // _WDS
    "WIN_SHOW":    Initialize=0x5F574753   // _WGS
    "WIN_HIDE":    Initialize=0x5F574748   // _WGH
    "WIN_MOVE":    Initialize=0x5F574D56   // _WMV
    "WIN_RESIZE":  Initialize=0x5F575253   // _WRS
    "WIN_TITLE":   Initialize=0x5F575454   // _WTT

    // Focus
    "WIN_ACTIVATED": Initialize=0x5F574143  // _WAC (window activated)
    "WIN_DEACTIVATED": Initialize=0x57494E44 // WIND

    // Draw (client telling server it has painted)
    "VIEW_INVALIDATE": Initialize=0x5F564E56  // _VNV
    "VIEW_DRAW":       Initialize=0x5F564452  // _VDR

    // App lifecycle
    "APP_QUIT":    Initialize=0x71756974   // 'quit'
    "APP_READY":   Initialize=0x42524452   // 'BRDR' (app ready to receive)

    // Deskbar
    "DESKBAR_ADD": Initialize=0x42414444   // 'BADD'
    "DESKBAR_REM": Initialize=0x42524D56   // 'BRMV'
}

// =============================================================================
// PRE-COMPUTED FIELD NAME HASHES
// These are the BMessage field names we look up on the hot path.
// Hash function: XOR-rotate, same as MsgBeAPI_Hash below.
// Pre-computed so hot-path dispatch never calls the hash function.
// =============================================================================
FixedPool.BFld {
    // Geometry
    "frame":    Initialize=0x66726D65   // "frame"   (BRect)
    "x":        Initialize=0x00000078   // "x"
    "y":        Initialize=0x00000079   // "y"
    "width":    Initialize=0x77696474   // "width"
    "height":   Initialize=0x68676874   // "height"

    // Identity
    "token":    Initialize=0x746F6B6E   // "token"   (view/window token)
    "name":     Initialize=0x6E616D65   // "name"
    "title":    Initialize=0x7469746C   // "title"

    // State
    "visible":  Initialize=0x7669736C   // "visible"
    "flags":    Initialize=0x666C6773   // "flags"
    "feel":     Initialize=0x6665656C   // "feel"   (window feel)
    "look":     Initialize=0x6C6F6F6B   // "look"   (window look)
}

// =============================================================================
// SIMPLE FIELD HASH
// For field names not in BFld. Call at setup time, not hot path.
// XOR-rotate hash of a field name string pointer.
// =============================================================================
Function.MsgBeAPI_Hash {
    Input:  str_ptr: Integer
    Output: Integer
    Body: {
        h   = 0
        pos = str_ptr
        ch  = Dereference(pos)

        WhileLoop NotEqual(ch, 0) {
            // h = (h << 5) ^ h ^ ch
            shifted = Multiply(h, 32)
            h = XorBits(shifted, h)
            h = XorBits(h, ch)
            pos = Add(pos, 1)
            ch  = Dereference(pos)
        }
        ReturnValue(h)
    }
}

// =============================================================================
// HANDLERS
// Each handler receives a MsgEnvelope pointer.
// Extracts fields, posts to Ring0 via MsgPost_*.
// Returns 1 on success, 0 on error.
// =============================================================================

Function.BMsg_HandleWinCreate {
    Input:  env: Integer
    Output: Integer
    Body: {
        w     = MsgEnv_GetInt(env, BFld.width)
        h     = MsgEnv_GetInt(env, BFld.height)
        token = MsgEnv_GetHandle(env, BFld.token)

        // Validate — must have at least a size
        IfCondition EqualTo(w, 0) ThenBlock: {
            w = Add(640, 65536)
            w = Subtract(w, 65536)
        }
        IfCondition EqualTo(h, 0) ThenBlock: {
            h = Add(480, 65536)
            h = Subtract(h, 65536)
        }

        MsgPost.param_a = w
        MsgPost.param_b = h
        MsgPost_WinCreate()
        ReturnValue(1)
    }
}

Function.BMsg_HandleWinDestroy {
    Input:  env: Integer
    Output: Integer
    Body: {
        token = MsgEnv_GetHandle(env, BFld.token)
        MsgPost.param_a = token
        MsgPost_WinDestroy()
        ReturnValue(1)
    }
}

Function.BMsg_HandleWinMove {
    Input:  env: Integer
    Output: Integer
    Body: {
        // BMessage WIN_MOVE carries new frame rect
        // We extract x,y and post TILE_RESIZE (closest Ring0 analog)
        // Phase 9 will add a proper WIN_MOVE Ring0 command if needed.
        x     = MsgEnv_GetInt(env, BFld.x)
        y     = MsgEnv_GetInt(env, BFld.y)
        token = MsgEnv_GetHandle(env, BFld.token)

        // For now: move is expressed as a resize from the BSP perspective.
        // Split position is the x or y coordinate of the split edge.
        MsgPost.param_a = token
        MsgPost.param_b = x
        MsgPost_TileResize()
        ReturnValue(1)
    }
}

Function.BMsg_HandleWinResize {
    Input:  env: Integer
    Output: Integer
    Body: {
        w     = MsgEnv_GetInt(env, BFld.width)
        h     = MsgEnv_GetInt(env, BFld.height)
        token = MsgEnv_GetHandle(env, BFld.token)

        MsgPost.param_a = token
        MsgPost.param_b = w
        MsgPost_TileResize()
        ReturnValue(1)
    }
}

Function.BMsg_HandleWinActivated {
    Input:  env: Integer
    Output: Integer
    Body: {
        token = MsgEnv_GetHandle(env, BFld.token)
        MsgPost.param_a = token
        MsgPost_FocusSet()
        ReturnValue(1)
    }
}

Function.BMsg_HandleAppQuit {
    Input:  env: Integer
    Output: Integer
    Body: {
        MsgPost_Quit()
        ReturnValue(1)
    }
}

Function.BMsg_HandleViewInvalidate {
    Input:  env: Integer
    Output: Integer
    Body: {
        // App has repainted — surface is dirty, needs composite.
        // Post to Ring2 via surface handle.
        // Ring2 marks dirty → Ring3 blits → framebuffer.
        token = MsgEnv_GetHandle(env, BFld.token)
        // Ring2_Post takes surface handle — token IS the surface handle
        // in the BeAPI shim model (app_server assigns tokens = surface ptrs).
        Ring2_Post(Ring2Cmd.SURFACE_DIRTY, token, 0, 0)
        ReturnValue(1)
    }
}

// =============================================================================
// INIT — register all handlers with MsgTranslate
// Call once at display server startup, after MsgTranslate_Init().
// =============================================================================
SubRoutine.MsgBeAPI_Init {
    MsgTranslate_Register(MsgProtocol.BEAPI, BMsg.WIN_CREATE,     BMsg_HandleWinCreate)
    MsgTranslate_Register(MsgProtocol.BEAPI, BMsg.WIN_DESTROY,    BMsg_HandleWinDestroy)
    MsgTranslate_Register(MsgProtocol.BEAPI, BMsg.WIN_MOVE,       BMsg_HandleWinMove)
    MsgTranslate_Register(MsgProtocol.BEAPI, BMsg.WIN_RESIZE,     BMsg_HandleWinResize)
    MsgTranslate_Register(MsgProtocol.BEAPI, BMsg.WIN_ACTIVATED,  BMsg_HandleWinActivated)
    MsgTranslate_Register(MsgProtocol.BEAPI, BMsg.APP_QUIT,       BMsg_HandleAppQuit)
    MsgTranslate_Register(MsgProtocol.BEAPI, BMsg.VIEW_INVALIDATE, BMsg_HandleViewInvalidate)
    PrintMessage("[MsgBeAPI] registered\n")
}