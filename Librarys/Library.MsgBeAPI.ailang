// Library.MsgBeAPI.ailang
// Phase 8 — IPC Message System: BeAPI / Haiku BMessage Translation

LibraryImport.MessageTypes
LibraryImport.MessagePort
LibraryImport.MessageTranslate

FixedPool.BMsg {
    "WIN_CREATE":    Initialize=0x4D435254
    "WIN_DESTROY":   Initialize=0x5F574453
    "WIN_SHOW":      Initialize=0x5F574753
    "WIN_HIDE":      Initialize=0x5F574748
    "WIN_MOVE":      Initialize=0x5F574D56
    "WIN_RESIZE":    Initialize=0x5F575253
    "WIN_TITLE":     Initialize=0x5F575454
    "WIN_ACTIVATED":   Initialize=0x5F574143
    "WIN_DEACTIVATED": Initialize=0x57494E44
    "VIEW_INVALIDATE": Initialize=0x5F564E56
    "VIEW_DRAW":       Initialize=0x5F564452
    "APP_QUIT":      Initialize=0x71756974
    "APP_READY":     Initialize=0x42524452
    "DESKBAR_ADD":   Initialize=0x42414444
    "DESKBAR_REM":   Initialize=0x42524D56
}

FixedPool.BFld {
    "frame":   Initialize=0x66726D65
    "x":       Initialize=0x00000078
    "y":       Initialize=0x00000079
    "width":   Initialize=0x77696474
    "height":  Initialize=0x68676874
    "token":   Initialize=0x746F6B6E
    "name":    Initialize=0x6E616D65
    "title":   Initialize=0x7469746C
    "visible": Initialize=0x7669736C
    "flags":   Initialize=0x666C6773
    "feel":    Initialize=0x6665656C
    "look":    Initialize=0x6C6F6F6B
}

Function.MsgBeAPI_Hash {
    Input:  str_ptr: Integer
    Output: Integer
    Body: {
        h   = 0
        pos = str_ptr
        ch  = Dereference(pos)
        WhileLoop NotEqual(ch, 0) {
            shifted = Multiply(h, 32)
            h = XorBits(shifted, h)
            h = XorBits(h, ch)
            pos = Add(pos, 1)
            ch  = Dereference(pos)
        }
        ReturnValue(h)
    }
}

Function.BMsg_HandleWinCreate {
    Input:  env: Integer
    Output: Integer
    Body: {
        w     = MsgEnv_GetInt(env, BFld.width)
        h     = MsgEnv_GetInt(env, BFld.height)
        token = MsgEnv_GetHandle(env, BFld.token)

        IfCondition EqualTo(w, 0) ThenBlock: { w = 640 }
        IfCondition EqualTo(h, 0) ThenBlock: { h = 480 }

        MsgPost.param_a = w
        MsgPost.param_b = h
        MsgPost_WinCreate()
        ReturnValue(1)
    }
}

Function.BMsg_HandleWinDestroy {
    Input:  env: Integer
    Output: Integer
    Body: {
        token = MsgEnv_GetHandle(env, BFld.token)
        MsgPost.param_a = token
        MsgPost_WinDestroy()
        ReturnValue(1)
    }
}

Function.BMsg_HandleWinMove {
    Input:  env: Integer
    Output: Integer
    Body: {
        x     = MsgEnv_GetInt(env, BFld.x)
        y     = MsgEnv_GetInt(env, BFld.y)
        token = MsgEnv_GetHandle(env, BFld.token)
        MsgPost.param_a = token
        MsgPost.param_b = x
        MsgPost_TileResize()
        ReturnValue(1)
    }
}

Function.BMsg_HandleWinResize {
    Input:  env: Integer
    Output: Integer
    Body: {
        w     = MsgEnv_GetInt(env, BFld.width)
        h     = MsgEnv_GetInt(env, BFld.height)
        token = MsgEnv_GetHandle(env, BFld.token)
        MsgPost.param_a = token
        MsgPost.param_b = w
        MsgPost_TileResize()
        ReturnValue(1)
    }
}

Function.BMsg_HandleWinActivated {
    Input:  env: Integer
    Output: Integer
    Body: {
        token = MsgEnv_GetHandle(env, BFld.token)
        MsgPost.param_a = token
        MsgPost_FocusSet()
        ReturnValue(1)
    }
}

Function.BMsg_HandleAppQuit {
    Input:  env: Integer
    Output: Integer
    Body: {
        MsgPost_Quit()
        ReturnValue(1)
    }
}

Function.BMsg_HandleViewInvalidate {
    Input:  env: Integer
    Output: Integer
    Body: {
        token = MsgEnv_GetHandle(env, BFld.token)
        Ring2_Post(Ring2Cmd.SURFACE_DIRTY, token, 0, 0)
        ReturnValue(1)
    }
}

SubRoutine.MsgBeAPI_Init {
    MsgTranslate_Register(MsgProtocol.BEAPI, BMsg.WIN_CREATE,      BMsg_HandleWinCreate)
    MsgTranslate_Register(MsgProtocol.BEAPI, BMsg.WIN_DESTROY,     BMsg_HandleWinDestroy)
    MsgTranslate_Register(MsgProtocol.BEAPI, BMsg.WIN_MOVE,        BMsg_HandleWinMove)
    MsgTranslate_Register(MsgProtocol.BEAPI, BMsg.WIN_RESIZE,      BMsg_HandleWinResize)
    MsgTranslate_Register(MsgProtocol.BEAPI, BMsg.WIN_ACTIVATED,   BMsg_HandleWinActivated)
    MsgTranslate_Register(MsgProtocol.BEAPI, BMsg.APP_QUIT,        BMsg_HandleAppQuit)
    MsgTranslate_Register(MsgProtocol.BEAPI, BMsg.VIEW_INVALIDATE, BMsg_HandleViewInvalidate)
    PrintMessage("[MsgBeAPI] registered\n")
}