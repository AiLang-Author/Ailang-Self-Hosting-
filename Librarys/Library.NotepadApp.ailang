// Library.NotepadApp.ailang
// Notepad app shell — same AppHost design as Calculator.
// HTML layout in config/notepad.html. Content area is a PANEL with
// dynamic LABEL children (one per text line).
//
// ZERO window/context/toolbar/rendering code — that's all AppHost.
//
// Copyright 2026 Sean Collins, 2 Paws Machine and Engineering. SCSL.

LibraryImport.WinManager
LibraryImport.Auckland
LibraryImport.EventRouter
LibraryImport.AppHost
LibraryImport.StringUtils
LibraryImport.UIScale
LibraryImport.Fonts
LibraryImport.TextRegion

// =============================================================================
// APP STATE
// =============================================================================
FixedPool.NotepadState {
    "win_idx":       Initialize=-1, CanChange=True
    "textarea_node": Initialize=-1, CanChange=True
    "line_count":    Initialize=0,  CanChange=True
    "initialized":   Initialize=0,  CanChange=True
}

// =============================================================================
// ACTION CALLBACK — pushes actions to EventRouter for dispatch
// =============================================================================
Function.NotepadApp_ActionCb {
    Input: action_ptr: Address
    Input: action_len: Integer
    Output: Integer
    Body: {
        EventRouter_Push(action_ptr, action_len, 0)
        ReturnValue(1)
    }
}

// =============================================================================
// FIND TEXTAREA NODE — scan tree for first PANEL tag
// =============================================================================
Function.Notepad_FindTextarea {
    Input: ctx: LinkagePool.AKContext
    Output: Integer
    Body: {
        cnt = ctx@tree_count
        i = 0
        WhileLoop LessThan(i, cnt) {
            tag = AK_Get(ctx, i, AKF.TAG)
            IfCondition EqualTo(tag, AKTag.PANEL) ThenBlock: {
                ReturnValue(i)
            }
            i = Add(i, 1)
        }
        ReturnValue(-1)
    }
}

// =============================================================================
// OPEN — launch Notepad window via AppHost
// =============================================================================
Function.NotepadApp_Open {
    Output: Integer
    Body: {
        DebugLog_Push("np.opn", 6)

        // Guard: only one notepad at a time
        IfCondition GreaterEqual(NotepadState.win_idx, 0) ThenBlock: {
            PrintMessage("[Notepad] already open\n")
            ReturnValue(NotepadState.win_idx)
        }

        // Open window from HTML
        win_idx = AppHost_Open("config/notepad.html", AddressOf(NotepadApp_ActionCb))
        IfCondition LessEqual(win_idx, 0) ThenBlock: {
            PrintMessage("[Notepad] AppHost_Open fail\n")
            ReturnValue(-1)
        }
        NotepadState.win_idx = win_idx

        // Find textarea panel by tree scan
        ctx = WinView_GetContentCtx(win_idx)
        NotepadState.textarea_node = Notepad_FindTextarea(ctx)

        // Count initial lines from HTML (the 3 welcome labels)
        NotepadState.line_count = 3
        NotepadState.initialized = 1

        DeskbarState.needs_refresh = 1

        PrintMessage("[Notepad] opened win=")
        PrintNumber(win_idx)
        PrintMessage(" textarea=")
        PrintNumber(NotepadState.textarea_node)
        PrintMessage("\n")
        ReturnValue(win_idx)
    }
}

// =============================================================================
// CLOSE — close via AppHost
// =============================================================================
Function.NotepadApp_Close {
    Body: {
        DebugLog_Push("np.cls", 6)
        IfCondition LessThan(NotepadState.win_idx, 0) ThenBlock: { ReturnValue(0) }

        AppHost_Close(NotepadState.win_idx)
        NotepadState.win_idx = -1
        NotepadState.textarea_node = -1
        NotepadState.line_count = 0
        DeskbarState.needs_refresh = 1
        PrintMessage("[Notepad] closed\n")
    }
}

// =============================================================================
// RENDER — re-render content area
// =============================================================================
Function.Notepad_Render {
    Body: {
        DebugLog_Push("np.ren", 6)
        win_idx = NotepadState.win_idx
        IfCondition LessThan(win_idx, 0) ThenBlock: { ReturnValue(0) }

        ctx = WinView_GetContentCtx(win_idx)
        IfCondition EqualTo(ctx, 0) ThenBlock: { ReturnValue(0) }

        content = WinMgr_GetContent(win_idx)
        cw = Win_GetCanvasW(win_idx)
        ch = Win_GetCanvasH(win_idx)
        AK_SetDesignW(ctx, cw)
        AK_SetDesignH(ctx, ch)
        VFont_UseSize(UIScale.font_body)
        AK_Draw(ctx, content, cw, ch)
        SysDisplayState.dirty = 1
    }
}

// =============================================================================
// ADD LINE — append a text line to the textarea
// =============================================================================
Function.Notepad_AddLine {
    Input: text: Address
    Input: text_len: Integer
    Input: color: Integer
    Output: Integer
    Body: {
        DebugLog_Push("np.add", 6)
        win_idx = NotepadState.win_idx
        IfCondition LessThan(win_idx, 0) ThenBlock: { ReturnValue(0) }

        ta = NotepadState.textarea_node
        IfCondition LessThan(ta, 0) ThenBlock: { ReturnValue(0) }

        ctx = WinView_GetContentCtx(win_idx)

        lbl = AK_CreateNode(ctx, AKTag.LABEL)
        AK_Set(ctx, lbl, AKF.HEIGHT, 18)
        AK_ExtraSet(ctx, lbl, AKExtra.STR_PTR, text)
        AK_ExtraSet(ctx, lbl, AKExtra.STR_LEN, text_len)
        AK_ExtraSet(ctx, lbl, AKExtra.COLOR_FG, color)
        AK_ExtraSet(ctx, lbl, AKExtra.TEXT_ALIGN, TRAlign.LEFT)
        AK_AddChild(ctx, ta, lbl)

        NotepadState.line_count = Add(NotepadState.line_count, 1)

        Notepad_Render()
        ReturnValue(1)
    }
}

// =============================================================================
// CLEAR — remove all lines from textarea
// =============================================================================
Function.Notepad_Clear {
    Body: {
        DebugLog_Push("np.clr", 6)
        win_idx = NotepadState.win_idx
        IfCondition LessThan(win_idx, 0) ThenBlock: { ReturnValue(0) }

        ta = NotepadState.textarea_node
        IfCondition LessThan(ta, 0) ThenBlock: { ReturnValue(0) }

        ctx = WinView_GetContentCtx(win_idx)
        AK_ClearChildren(ctx, ta)
        NotepadState.line_count = 0

        Notepad_Render()
    }
}
