// Library.Option.ailang — tagged optional values
//
// AiLang has no sum types in the grammar, but Option/Maybe is one of
// the most useful library primitives — it lets a function return
// "either a value or nothing" explicitly, instead of overloading 0 or
// -1 or "" as a sentinel. Callers branch on OptIsSome / OptIsNone
// rather than guessing what the sentinel means.
//
// Layout (16 bytes per Option, heap-allocated from the arena):
//   offset 0 : tag   (1 = Some, 0 = None) — one 8-byte word
//   offset 8 : value (the wrapped Integer) — one 8-byte word
//
// Integer-only for now. A polymorphic Option<T> isn't a thing in
// AiLang — functions that need to wrap a different type build their
// own parallel type (OptionAddress, OptionBool). Alternatively, since
// AiLang Integers are 64-bit, Addresses and small blobs already
// round-trip through Option just fine (they fit in one word).
//
// Requires: LibraryImport.Arena (for Allocate).
//
// Copyright (c) 2026 Sean Collins, 2 Paws Machine and Engineering.
// Licensed under the Sean Collins Software License (SCSL).

LibraryImport.Arena

// Construct Some(v). Returns a fresh Option cell.
Function.OptSome {
    Input: v: Integer
    Output: Address
    Body: {
        o = Allocate(16)
        StoreValue(o, 1)
        StoreValue(Add(o, 8), v)
        ReturnValue(o)
    }
}

// Construct None. Returns a fresh Option cell with tag=0.
Function.OptNone {
    Output: Address
    Body: {
        o = Allocate(16)
        StoreValue(o, 0)
        StoreValue(Add(o, 8), 0)
        ReturnValue(o)
    }
}

// 1 if this Option carries a value, 0 otherwise.
Function.OptIsSome {
    Input: o: Address
    Output: Integer
    Body: {
        ReturnValue(Dereference(o))
    }
}

// 1 if this Option is empty, 0 otherwise.
Function.OptIsNone {
    Input: o: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(Dereference(o), 0) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

// Unwrap the value. If called on None, returns 0 — callers that need
// to distinguish None from Some(0) must check OptIsSome first.
Function.OptValue {
    Input: o: Address
    Output: Integer
    Body: {
        ReturnValue(Dereference(Add(o, 8)))
    }
}

// Null-coalescing: return the wrapped value if Some, else fallback.
// The equivalent of `x ?? fallback` in languages that have that syntax.
Function.OptOrDefault {
    Input: o: Address
    Input: fallback: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(Dereference(o), 1) ThenBlock: {
            ReturnValue(Dereference(Add(o, 8)))
        }
        ReturnValue(fallback)
    }
}
