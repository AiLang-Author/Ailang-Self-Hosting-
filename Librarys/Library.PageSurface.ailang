// Library.PageSurface.ailang
// Paper-sized canvases with DPI metadata
// Creates PIXEL_32 surfaces at dimensions computed from paper size + DPI
// Copyright © 2026 Sean Collins, 2 Paws Machine and Engineering. SCSL.

LibraryImport.DSurfaceTypes
LibraryImport.DSurface
LibraryImport.DDrawPixel

// =============================================================================
// PAPER TYPES
// =============================================================================
FixedPool.PaperType {
    "LETTER":   Initialize=1    // 8.5 x 11 inches
    "LEGAL":    Initialize=2    // 8.5 x 14 inches
    "A4":       Initialize=3    // 210 x 297 mm (8.27 x 11.69 inches)
    "A3":       Initialize=4    // 297 x 420 mm (11.69 x 16.54 inches)
    "FREE":     Initialize=5    // arbitrary pixel dimensions
    "CUSTOM":   Initialize=6    // physical dimensions + DPI
}

// =============================================================================
// ORIENTATION
// =============================================================================
FixedPool.PageOrient {
    "PORTRAIT":  Initialize=0
    "LANDSCAPE": Initialize=1
}

// =============================================================================
// PAGE METADATA — 96 bytes per page
// =============================================================================
FixedPool.PageField {
    "SURFACE":     Initialize=0     // PIXEL_32 surface handle
    "PAPER_TYPE":  Initialize=8     // PaperType constant
    "ORIENTATION": Initialize=16    // PageOrient constant
    "DPI":         Initialize=24    // dots per inch
    "MARGIN_T":    Initialize=32    // top margin in pixels
    "MARGIN_R":    Initialize=40    // right margin in pixels
    "MARGIN_B":    Initialize=48    // bottom margin in pixels
    "MARGIN_L":    Initialize=56    // left margin in pixels
    "PHYS_W_MM":   Initialize=64    // physical width in mm (x100 for precision)
    "PHYS_H_MM":   Initialize=72    // physical height in mm (x100 for precision)
    "PIX_W":       Initialize=80    // pixel width of surface
    "PIX_H":       Initialize=88    // pixel height of surface
}

FixedPool.PageConst {
    "META_SIZE":   Initialize=96
    "MAX_PAGES":   Initialize=256
    "DEFAULT_DPI": Initialize=96
}

// =============================================================================
// PAGE TABLE
// =============================================================================
FixedPool.PageTable {
    "data":  Initialize=0, CanChange=True
    "count": Initialize=0, CanChange=True
}

// =============================================================================
// INIT
// =============================================================================
Function.PageSurface_Init {
    Output: Integer
    Body: {
        tsz = Multiply(PageConst.MAX_PAGES, PageConst.META_SIZE)
        tb = Allocate(tsz)
        IfCondition EqualTo(tb, 0) ThenBlock: {
            PrintMessage("[PageSurface] alloc fail\n")
            ReturnValue(0)
        }
        pi = 0
        WhileLoop LessThan(pi, tsz) {
            SetByte(tb, pi, 0)
            pi = Add(pi, 1)
        }
        PageTable.data = tb
        PageTable.count = 0
        PrintMessage("[PageSurface] init ok\n")
        ReturnValue(1)
    }
}

// =============================================================================
// PAGE METADATA HELPERS
// =============================================================================
Function.Page_Ptr {
    Input: idx: Integer
    Output: Address
    Body: {
        off = Multiply(idx, PageConst.META_SIZE)
        ReturnValue(Add(PageTable.data, off))
    }
}

Function.Page_Get {
    Input: idx: Integer
    Input: field: Integer
    Output: Integer
    Body: {
        p = Page_Ptr(idx)
        ReturnValue(Dereference(Add(p, field)))
    }
}

Function.Page_Set {
    Input: idx: Integer
    Input: field: Integer
    Input: val: Integer
    Body: {
        p = Page_Ptr(idx)
        StoreValue(Add(p, field), val)
    }
}

// =============================================================================
// COMPUTE PAPER DIMENSIONS IN PIXELS
// All dimensions stored as integers. Inches x 100 for intermediate precision.
// Formula: pixels = (inches_x100 * dpi) / 100
// =============================================================================
Function.PageSurface_ComputeSize {
    Input: paper_type: Integer
    Input: orientation: Integer
    Input: dpi: Integer
    Input: result_w: Address
    Input: result_h: Address
    Body: {
        // Width and height in inches x 100
        w_i100 = 0
        h_i100 = 0

        // Letter: 8.5 x 11
        IfCondition EqualTo(paper_type, PaperType.LETTER) ThenBlock: {
            w_i100 = 850
            h_i100 = 1100
        }

        // Legal: 8.5 x 14
        IfCondition EqualTo(paper_type, PaperType.LEGAL) ThenBlock: {
            w_i100 = 850
            h_i100 = 1400
        }

        // A4: 8.27 x 11.69
        IfCondition EqualTo(paper_type, PaperType.A4) ThenBlock: {
            w_i100 = 827
            h_i100 = 1169
        }

        // A3: 11.69 x 16.54
        IfCondition EqualTo(paper_type, PaperType.A3) ThenBlock: {
            w_i100 = 1169
            h_i100 = 1654
        }

        // Landscape swaps width and height
        IfCondition EqualTo(orientation, PageOrient.LANDSCAPE) ThenBlock: {
            tmp = w_i100
            w_i100 = h_i100
            h_i100 = tmp
        }

        // Convert to pixels: (inches_x100 * dpi) / 100
        pw = Divide(Multiply(w_i100, dpi), 100)
        ph = Divide(Multiply(h_i100, dpi), 100)

        StoreValue(result_w, pw)
        StoreValue(result_h, ph)
    }
}

// =============================================================================
// CREATE — allocate page with computed dimensions
// Returns page index, or -1 on failure
// =============================================================================
Function.PageSurface_Create {
    Input: paper_type: Integer
    Input: orientation: Integer
    Input: dpi: Integer
    Output: Integer
    Body: {
        idx = PageTable.count
        IfCondition GreaterEqual(idx, PageConst.MAX_PAGES) ThenBlock: {
            PrintMessage("[PageSurface] page table full\n")
            ReturnValue(-1)
        }

        IfCondition EqualTo(dpi, 0) ThenBlock: {
            dpi = PageConst.DEFAULT_DPI
        }

        // Compute pixel dimensions
        pw_store = Allocate(8)
        ph_store = Allocate(8)
        PageSurface_ComputeSize(paper_type, orientation, dpi, pw_store, ph_store)
        pw = Dereference(pw_store)
        ph = Dereference(ph_store)
        Deallocate(pw_store, 8)
        Deallocate(ph_store, 8)

        IfCondition Or(LessEqual(pw, 0), LessEqual(ph, 0)) ThenBlock: {
            PrintMessage("[PageSurface] invalid dimensions\n")
            ReturnValue(-1)
        }

        // Create surface
        surf = Surface_Create(SurfaceFormat.PIXEL_32, pw, ph)
        IfCondition EqualTo(surf, 0) ThenBlock: {
            PrintMessage("[PageSurface] surface alloc fail\n")
            ReturnValue(-1)
        }

        // White background for document pages
        white = TVG_PackColor(255, 255, 255, 255)
        Draw_Pix_FillRect(surf, 0, 0, pw, ph, white)

        // Store metadata
        PageTable.count = Add(idx, 1)
        Page_Set(idx, PageField.SURFACE, surf)
        Page_Set(idx, PageField.PAPER_TYPE, paper_type)
        Page_Set(idx, PageField.ORIENTATION, orientation)
        Page_Set(idx, PageField.DPI, dpi)
        Page_Set(idx, PageField.PIX_W, pw)
        Page_Set(idx, PageField.PIX_H, ph)

        // Default margins: 1 inch converted to pixels
        margin_px = dpi
        Page_Set(idx, PageField.MARGIN_T, margin_px)
        Page_Set(idx, PageField.MARGIN_R, margin_px)
        Page_Set(idx, PageField.MARGIN_B, margin_px)
        Page_Set(idx, PageField.MARGIN_L, margin_px)

        PrintMessage("[PageSurface] created page ")
        PrintNumber(idx)
        PrintMessage(" ")
        PrintNumber(pw)
        PrintMessage("x")
        PrintNumber(ph)
        PrintMessage(" @ ")
        PrintNumber(dpi)
        PrintMessage(" dpi\n")

        ReturnValue(idx)
    }
}

// =============================================================================
// CREATE FREE — arbitrary pixel dimensions, no paper mapping
// =============================================================================
Function.PageSurface_CreateFree {
    Input: width: Integer
    Input: height: Integer
    Input: dpi: Integer
    Output: Integer
    Body: {
        idx = PageTable.count
        IfCondition GreaterEqual(idx, PageConst.MAX_PAGES) ThenBlock: {
            PrintMessage("[PageSurface] page table full\n")
            ReturnValue(-1)
        }

        IfCondition EqualTo(dpi, 0) ThenBlock: {
            dpi = PageConst.DEFAULT_DPI
        }

        surf = Surface_Create(SurfaceFormat.PIXEL_32, width, height)
        IfCondition EqualTo(surf, 0) ThenBlock: {
            PrintMessage("[PageSurface] free surface alloc fail\n")
            ReturnValue(-1)
        }

        white = TVG_PackColor(255, 255, 255, 255)
        Draw_Pix_FillRect(surf, 0, 0, width, height, white)

        PageTable.count = Add(idx, 1)
        Page_Set(idx, PageField.SURFACE, surf)
        Page_Set(idx, PageField.PAPER_TYPE, PaperType.FREE)
        Page_Set(idx, PageField.ORIENTATION, PageOrient.PORTRAIT)
        Page_Set(idx, PageField.DPI, dpi)
        Page_Set(idx, PageField.PIX_W, width)
        Page_Set(idx, PageField.PIX_H, height)
        Page_Set(idx, PageField.MARGIN_T, 0)
        Page_Set(idx, PageField.MARGIN_R, 0)
        Page_Set(idx, PageField.MARGIN_B, 0)
        Page_Set(idx, PageField.MARGIN_L, 0)

        PrintMessage("[PageSurface] created free page ")
        PrintNumber(idx)
        PrintMessage(" ")
        PrintNumber(width)
        PrintMessage("x")
        PrintNumber(height)
        PrintMessage("\n")

        ReturnValue(idx)
    }
}

// =============================================================================
// SET MARGINS — values in points (1/72 inch), converted to pixels
// Formula: pixels = (points * dpi) / 72
// =============================================================================
Function.PageSurface_SetMargins {
    Input: page: Integer
    Input: top_pt: Integer
    Input: right_pt: Integer
    Input: bottom_pt: Integer
    Input: left_pt: Integer
    Body: {
        dpi = Page_Get(page, PageField.DPI)
        mt = Divide(Multiply(top_pt, dpi), 72)
        mr = Divide(Multiply(right_pt, dpi), 72)
        mb = Divide(Multiply(bottom_pt, dpi), 72)
        ml = Divide(Multiply(left_pt, dpi), 72)
        Page_Set(page, PageField.MARGIN_T, mt)
        Page_Set(page, PageField.MARGIN_R, mr)
        Page_Set(page, PageField.MARGIN_B, mb)
        Page_Set(page, PageField.MARGIN_L, ml)
    }
}

// =============================================================================
// SET MARGINS IN PIXELS — direct pixel values
// =============================================================================
Function.PageSurface_SetMarginsPixels {
    Input: page: Integer
    Input: top: Integer
    Input: right_m: Integer
    Input: bottom: Integer
    Input: left: Integer
    Body: {
        Page_Set(page, PageField.MARGIN_T, top)
        Page_Set(page, PageField.MARGIN_R, right_m)
        Page_Set(page, PageField.MARGIN_B, bottom)
        Page_Set(page, PageField.MARGIN_L, left)
    }
}

// =============================================================================
// GET CONTENT RECT — usable area inside margins
// Returns via output params: x, y, w, h
// =============================================================================
Function.PageSurface_GetContentX {
    Input: page: Integer
    Output: Integer
    Body: {
        ReturnValue(Page_Get(page, PageField.MARGIN_L))
    }
}

Function.PageSurface_GetContentY {
    Input: page: Integer
    Output: Integer
    Body: {
        ReturnValue(Page_Get(page, PageField.MARGIN_T))
    }
}

Function.PageSurface_GetContentW {
    Input: page: Integer
    Output: Integer
    Body: {
        pw = Page_Get(page, PageField.PIX_W)
        ml = Page_Get(page, PageField.MARGIN_L)
        mr = Page_Get(page, PageField.MARGIN_R)
        ReturnValue(Subtract(pw, Add(ml, mr)))
    }
}

Function.PageSurface_GetContentH {
    Input: page: Integer
    Output: Integer
    Body: {
        ph = Page_Get(page, PageField.PIX_H)
        mt = Page_Get(page, PageField.MARGIN_T)
        mb = Page_Get(page, PageField.MARGIN_B)
        ReturnValue(Subtract(ph, Add(mt, mb)))
    }
}

// =============================================================================
// ACCESSORS
// =============================================================================
Function.PageSurface_GetSurface {
    Input: page: Integer
    Output: Integer
    Body: {
        ReturnValue(Page_Get(page, PageField.SURFACE))
    }
}

Function.PageSurface_GetDPI {
    Input: page: Integer
    Output: Integer
    Body: {
        ReturnValue(Page_Get(page, PageField.DPI))
    }
}

Function.PageSurface_GetWidth {
    Input: page: Integer
    Output: Integer
    Body: {
        ReturnValue(Page_Get(page, PageField.PIX_W))
    }
}

Function.PageSurface_GetHeight {
    Input: page: Integer
    Output: Integer
    Body: {
        ReturnValue(Page_Get(page, PageField.PIX_H))
    }
}

Function.PageSurface_GetPaperType {
    Input: page: Integer
    Output: Integer
    Body: {
        ReturnValue(Page_Get(page, PageField.PAPER_TYPE))
    }
}

// =============================================================================
// RESIZE — destroy old surface, create new one, update metadata in-place
// Returns 1 on success, 0 on failure
// =============================================================================
Function.PageSurface_Resize {
    Input: page: Integer
    Input: new_w: Integer
    Input: new_h: Integer
    Output: Integer
    Body: {
        old_surf = Page_Get(page, PageField.SURFACE)
        IfCondition NotEqual(old_surf, 0) ThenBlock: {
            Surface_Destroy(old_surf)
        }

        new_surf = Surface_Create(SurfaceFormat.PIXEL_32, new_w, new_h)
        IfCondition EqualTo(new_surf, 0) ThenBlock: { ReturnValue(0) }

        white = TVG_PackColor(255, 255, 255, 255)
        Draw_Pix_FillRect(new_surf, 0, 0, new_w, new_h, white)

        Page_Set(page, PageField.SURFACE, new_surf)
        Page_Set(page, PageField.PIX_W, new_w)
        Page_Set(page, PageField.PIX_H, new_h)
        ReturnValue(1)
    }
}

// =============================================================================
// DESTROY — free surface and clear metadata
// =============================================================================
Function.PageSurface_Destroy {
    Input: page: Integer
    Body: {
        surf = Page_Get(page, PageField.SURFACE)
        IfCondition NotEqual(surf, 0) ThenBlock: {
            Surface_Destroy(surf)
        }
        Page_Set(page, PageField.SURFACE, 0)
    }
}

// =============================================================================
// POINT SIZE TO PIXEL SIZE — for font rendering
// pixels = points * dpi / 72
// =============================================================================
Function.PageSurface_PointsToPixels {
    Input: page: Integer
    Input: points: Integer
    Output: Integer
    Body: {
        dpi = Page_Get(page, PageField.DPI)
        ReturnValue(Divide(Multiply(points, dpi), 72))
    }
}