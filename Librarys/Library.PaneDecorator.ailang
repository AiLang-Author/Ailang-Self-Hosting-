// Library.PaneDecorator.ailang
// Pane visual decoration — color, border, focus highlight.
// Called by SysDisplay after compositor creates surfaces.
// The compositor (DCompose) is colorblind — all aesthetics live here.
//
// This is the "topside" presenter layer. It knows about colors and borders.
// It does NOT know about BSP geometry, focus policy, or ring routing.
//
// Copyright © 2025 Sean Collins, 2 Paws Machine and Engineering. All rights reserved. SCSL.

LibraryImport.DSurfaceTypes
LibraryImport.DSurface
LibraryImport.DDrawPixel
LibraryImport.FontBitmap
LibraryImport.DComposeTypes
LibraryImport.DCompose

// =============================================================================
// DECORATOR CONFIG — set once at init, readable by anyone
// =============================================================================
FixedPool.DecorConfig {
    "border_color_normal":  Initialize=0xFFFFFF   // white border
    "border_color_focused": Initialize=0x00AAFF   // blue highlight when focused
    "border_width":         Initialize=1           // pixels
    "show_size_label":      Initialize=1           // 0=off 1=show WxH
    "font":                 Initialize=0           // font handle (set by SysDisplay)
    "font_ready":           Initialize=0
}

// =============================================================================
// PANE COLOR TABLE — 8 cycling background colors
// Owned here, not in compositor
// =============================================================================
FixedPool.PaneColors {
    "idx": Initialize=0
    "c0":  Initialize=0x1A3A5C
    "c1":  Initialize=0x3A1A1A
    "c2":  Initialize=0x1A3A1A
    "c3":  Initialize=0x3A3A1A
    "c4":  Initialize=0x2A1A3A
    "c5":  Initialize=0x1A3A3A
    "c6":  Initialize=0x3A2A1A
    "c7":  Initialize=0x2A2A2A
}

Function.PaneDecorator_SetFont {
    Input: handle: Integer
    Body: {
        DecorConfig.font       = handle
        DecorConfig.font_ready = 1
        ReturnValue(0)
    }
}

Function.PaneDecorator_NextColor {
    Output: Integer
    Body: {
        idx = PaneColors.idx
        col = PaneColors.c0
        IfCondition EqualTo(idx, 1) ThenBlock: { col = PaneColors.c1 }
        IfCondition EqualTo(idx, 2) ThenBlock: { col = PaneColors.c2 }
        IfCondition EqualTo(idx, 3) ThenBlock: { col = PaneColors.c3 }
        IfCondition EqualTo(idx, 4) ThenBlock: { col = PaneColors.c4 }
        IfCondition EqualTo(idx, 5) ThenBlock: { col = PaneColors.c5 }
        IfCondition EqualTo(idx, 6) ThenBlock: { col = PaneColors.c6 }
        IfCondition EqualTo(idx, 7) ThenBlock: { col = PaneColors.c7 }
        next = Add(idx, 1)
        IfCondition GreaterEqual(next, 8) ThenBlock: { next = 0 }
        PaneColors.idx = next
        ReturnValue(col)
    }
}

// =============================================================================
// DECORATE PANE — fill color + border
// Called after WinCreate_ForLeaf creates a blank surface.
// leaf:       BSP leaf handle (to look up surface)
// color:      background color (pass -1 to auto-assign next color)
// focused:    1 = draw focused border color, 0 = normal
// =============================================================================
Function.PaneDecorator_Decorate {
    Input:  leaf:    Integer
    Input:  color:   Integer
    Input:  focused: Integer
    Output: Integer
    Body: {
        surf = WinTable_GetSurface(leaf)
        IfCondition EqualTo(surf, 0) ThenBlock: { ReturnValue(0) }

        // Resolve color
        bg = color
        IfCondition LessThan(color, 0) ThenBlock: {
            bg = PaneDecorator_NextColor()
        }

        w = Surface_GetWidth(surf)
        h = Surface_GetHeight(surf)

        // Fill background
        Draw_Pix_FillRect(surf, 0, 0, w, h, bg)

        // Border color depends on focus state
        border_col = DecorConfig.border_color_normal
        IfCondition EqualTo(focused, 1) ThenBlock: {
            border_col = DecorConfig.border_color_focused
        }

        // Draw border
        bw = Subtract(w, 1)
        bh = Subtract(h, 1)
        Draw_Pix_HLine(surf, 0, bw, 0,  border_col)
        Draw_Pix_HLine(surf, 0, bw, bh, border_col)
        Draw_Pix_VLine(surf, 0,  0, bh, border_col)
        Draw_Pix_VLine(surf, bw, 0, bh, border_col)

        // Size label (debug aid — toggled by DecorConfig.show_size_label)
        IfCondition EqualTo(DecorConfig.show_size_label, 1) ThenBlock: {
            IfCondition EqualTo(DecorConfig.font_ready, 1) ThenBlock: {
                fh   = DecorConfig.font
                ws   = NumberToString(w)
                hs   = NumberToString(h)
                FontBitmap_DrawString(surf, fh, 4, 4, ws, 0xFFFFFF)
                xpos = Add(4, Multiply(StringLength(ws), 8))
                FontBitmap_DrawChar(surf, fh, xpos, 4, 120, 0xFFFFFF)
                hpos = Add(xpos, 8)
                FontBitmap_DrawString(surf, fh, hpos, 4, hs, 0xFFFFFF)
            }
        }

        // Write color into WinTable so SyncPaneBuffers can read it
        WinTable_SetColor(leaf, bg)

        ReturnValue(bg)
    }
}

// =============================================================================
// UPDATE BORDER ONLY — called on focus change, no refill needed
// Redraws just the border pixels without touching interior content.
// =============================================================================
Function.PaneDecorator_UpdateBorder {
    Input:  leaf:    Integer
    Input:  focused: Integer
    Output: Integer
    Body: {
        surf = WinTable_GetSurface(leaf)
        IfCondition EqualTo(surf, 0) ThenBlock: { ReturnValue(0) }

        w = Surface_GetWidth(surf)
        h = Surface_GetHeight(surf)
        bw = Subtract(w, 1)
        bh = Subtract(h, 1)

        border_col = DecorConfig.border_color_normal
        IfCondition EqualTo(focused, 1) ThenBlock: {
            border_col = DecorConfig.border_color_focused
        }

        Draw_Pix_HLine(surf, 0, bw, 0,  border_col)
        Draw_Pix_HLine(surf, 0, bw, bh, border_col)
        Draw_Pix_VLine(surf, 0,  0, bh, border_col)
        Draw_Pix_VLine(surf, bw, 0, bh, border_col)

        ReturnValue(1)
    }
}