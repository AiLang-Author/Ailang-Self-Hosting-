// Library.PaneDecorator.ailang
// Default colors and border drawing.
// No color cycling. No global state mutation.
// Callers pick a color or use the named defaults.
//
// Copyright © 2025 Sean Collins, 2 Paws Machine and Engineering. All rights reserved. SCSL.

LibraryImport.DSurfaceTypes
LibraryImport.DSurface
LibraryImport.DDrawPixel
LibraryImport.UIScale
LibraryImport.UITheme

// =============================================================================
// DEFAULT COLORS — named constants, never mutated
// Callers reference these directly or pass their own value
// =============================================================================
FixedPool.WinColor {
    "DESKTOP":  Initialize=0xFF1A3A5C, CanChange=True
    "WINDOW":   Initialize=0xFF1A2A1A, CanChange=True
    "DIALOG":   Initialize=0xFF2A1A2A, CanChange=True
    "PANEL":    Initialize=0xFF1A2A2A, CanChange=True
    "TERMINAL": Initialize=0xFF0D1117, CanChange=True
    "BORDER":   Initialize=0xFFFFFFFF, CanChange=True
    "TEXT_FG":   Initialize=0xFFFFFFFF, CanChange=True
    "TEXT_BG":  Initialize=0xFF1A2A1A, CanChange=True
}

// =============================================================================
// DECORATOR CONFIG — font handle, set once at init
// =============================================================================
FixedPool.DecorConfig {
    "font":       Initialize=0
    "font_ready": Initialize=0
    "border_w":   Initialize=4, CanChange=True
    "header_h":   Initialize=24, CanChange=True
}

FixedPool.WinHeaderColor {
    "color": Initialize=0xFFFFFF, CanChange=True
}

Function.PaneDecorator_SetFont {
    Input: handle: Integer
    Body: {
        DecorConfig.font       = handle
        DecorConfig.font_ready = 1
        ReturnValue(0)
    }
}

// =============================================================================
// SCALE INIT — copy scaled values from UIScale into DecorConfig
// Call once after UIScale_Init.
// =============================================================================
Function.PaneDecorator_ScaleInit {
    Body: {
        DecorConfig.border_w = UIScale.border_w
        DecorConfig.header_h = UIScale.header_h
        ReturnValue(0)
    }
}

// =============================================================================
// THEME INIT — copy colors from Theme into WinColor
// Call once after UITheme_Init.
// =============================================================================
Function.PaneDecorator_ThemeInit {
    Body: {
        WinColor.DESKTOP  = Theme.desktop_bg
        WinColor.WINDOW   = Theme.window_bg
        WinColor.DIALOG   = Theme.dialog_bg
        WinColor.PANEL    = Theme.panel_bg
        WinColor.TERMINAL = Theme.terminal_bg
        WinColor.BORDER   = Theme.border
        WinColor.TEXT_FG  = Theme.text_fg
        WinColor.TEXT_BG  = Theme.text_bg
        WinHeaderColor.color = Theme.header_color
        ReturnValue(0)
    }
}

// =============================================================================
// DRAW — fill surface with color and white border
// This is the only drawing entry point. Caller picks the color.
// =============================================================================
Function.PaneDecorator_Draw {
    Input:  surf:  Integer
    Input:  w:     Integer
    Input:  h:     Integer
    Input:  color: Integer
    Output: Integer
    Body: {
        Draw_Pix_FillRect(surf, 0, 0, w, h, color)
        right  = Subtract(w, 1)
        bottom = Subtract(h, 1)
        Draw_Pix_HLine(surf, 0, right,  0,      WinColor.BORDER)
        Draw_Pix_HLine(surf, 0, right,  bottom, WinColor.BORDER)
        Draw_Pix_VLine(surf, 0,  0,     bottom, WinColor.BORDER)
        Draw_Pix_VLine(surf, right, 0,  bottom, WinColor.BORDER)
        ReturnValue(1)
    }
}