LibraryImport.DSurfaceTypes
LibraryImport.DSurface
LibraryImport.DComposeTypes
LibraryImport.DCompose
LibraryImport.Font
LibraryImport.TextBuffer
LibraryImport.Cursor
LibraryImport.Framebuffer
LibraryImport.PaneDecorator

// =============================================================================
// TBMAP STATE
// 16 slots * 8 bytes, flat array. -1 = empty slot.
// =============================================================================
FixedPool.TBMapState {
    "data":        Initialize=0
    "initialized": Initialize=0
}

Function.TBMap_Init {
    Output: Integer
    Body: {
        TBMapState.data = Allocate(128)
        i = 0
        WhileLoop LessThan(i, 16) {
            StoreValue(Add(TBMapState.data, Multiply(i, 8)), -1)
            i = Add(i, 1)
        }
        TBMapState.initialized = 1
        ReturnValue(1)
    }
}

Function.TBMap_Set {
    Input: slot:      Integer
    Input: tb_handle: Integer
    Body: {
        StoreValue(Add(TBMapState.data, Multiply(slot, 8)), tb_handle)
        ReturnValue(0)
    }
}

Function.TBMap_Get {
    Input:  slot: Integer
    Output: Integer
    Body: {
        ReturnValue(Dereference(Add(TBMapState.data, Multiply(slot, 8))))
    }
}

Function.TBMap_FindSlot {
    Input:  leaf: Integer
    Output: Integer
    Body: {
        cnt = WinTable.count
        i   = 0
        WhileLoop LessThan(i, cnt) {
            base       = Add(WinTable.entries, Multiply(i, WinTableConst.ENTRY_SIZE))
            entry_leaf = Dereference(Add(base, WinTableConst.LEAF_OFS))
            IfCondition EqualTo(entry_leaf, leaf) ThenBlock: {
                ReturnValue(i)
            }
            i = Add(i, 1)
        }
        ReturnValue(-1)
    }
}

// Compatibility shim — delegates to Focus_GetTB via Focus library
Function.GetFocusedTB {
    Output: Integer
    Body: {
        leaf = Compositor.focused_leaf
        slot = TBMap_FindSlot(leaf)
        IfCondition LessThan(slot, 0) ThenBlock: { ReturnValue(-1) }
        ReturnValue(TBMap_Get(slot))
    }
}

// =============================================================================
// PANE LIFECYCLE
// =============================================================================
Function.CreatePaneBuffer {
    Input:  leaf: Integer
    Output: Integer
    Body: {
        slot = TBMap_FindSlot(leaf)
        IfCondition LessThan(slot, 0) ThenBlock: {
            PrintMessage("[PM] ERROR: leaf not in WinTable\n")
            ReturnValue(-1)
        }
        surf = WinTable_GetSurface(leaf)
        IfCondition EqualTo(surf, 0) ThenBlock: { ReturnValue(-1) }

        tb = TextBuffer_Create(surf, SysDisplayState.font)
        IfCondition LessThan(tb, 0) ThenBlock: {
            PrintMessage("[PM] ERROR: TextBuffer_Create failed\n")
            ReturnValue(-1)
        }
        pane_color = WinTable_GetColor(leaf)
        TextBuffer_SetColors(tb, 0xFFFFFF, pane_color)
        TBMap_Set(slot, tb)
        PrintMessage("[PM] pane buffer slot=")
        PrintNumber(slot)
        PrintMessage(" tb=")
        PrintNumber(tb)
        PrintMessage("\n")
        ReturnValue(tb)
    }
}

Function.DestroyPaneBuffer {
    Input:  leaf: Integer
    Output: Integer
    Body: {
        slot = TBMap_FindSlot(leaf)
        IfCondition LessThan(slot, 0) ThenBlock: { ReturnValue(0) }
        tb = TBMap_Get(slot)
        IfCondition GreaterEqual(tb, 0) ThenBlock: {
            TextBuffer_Destroy(tb)
        }
        TBMap_Set(slot, -1)
        ReturnValue(1)
    }
}

Function.CopyTBContent {
    Input:  src_tb: Integer
    Input:  dst_tb: Integer
    Output: Integer
    Body: {
        src_buf  = TB_Get(src_tb, TBField.BUF)
        dst_buf  = TB_Get(dst_tb, TBField.BUF)
        src_cols = TB_Get(src_tb, TBField.COLS)
        src_rows = TB_Get(src_tb, TBField.ROWS)
        dst_cols = TB_Get(dst_tb, TBField.COLS)
        dst_rows = TB_Get(dst_tb, TBField.ROWS)
        copy_rows = src_rows
        copy_cols = src_cols
        IfCondition LessThan(dst_rows, copy_rows) ThenBlock: { copy_rows = dst_rows }
        IfCondition LessThan(dst_cols, copy_cols) ThenBlock: { copy_cols = dst_cols }
        row = 0
        WhileLoop LessThan(row, copy_rows) {
            col = 0
            WhileLoop LessThan(col, copy_cols) {
                ch = GetByte(src_buf, Add(Multiply(row, src_cols), col))
                SetByte(dst_buf, Add(Multiply(row, dst_cols), col), ch)
                col = Add(col, 1)
            }
            row = Add(row, 1)
        }
        cur_col = TB_Get(src_tb, TBField.CUR_COL)
        cur_row = TB_Get(src_tb, TBField.CUR_ROW)
        IfCondition GreaterEqual(cur_col, dst_cols) ThenBlock: { cur_col = Subtract(dst_cols, 1) }
        IfCondition GreaterEqual(cur_row, dst_rows) ThenBlock: { cur_row = Subtract(dst_rows, 1) }
        TB_Set(dst_tb, TBField.CUR_COL, cur_col)
        TB_Set(dst_tb, TBField.CUR_ROW, cur_row)
        TB_Set(dst_tb, TBField.DIRTY,   1)
        ReturnValue(1)
    }
}

// =============================================================================
// SYNC — keep TBMap consistent with WinTable after splits/merges
// =============================================================================
Function.SyncPaneBuffers {
    Output: Integer
    Body: {
        cnt = WinTable.count

        // Pass 1: destroy TBs for slots beyond current WinTable count
        i = cnt
        WhileLoop LessThan(i, 16) {
            tb = TBMap_Get(i)
            IfCondition GreaterEqual(tb, 0) ThenBlock: {
                TextBuffer_Destroy(tb)
                TBMap_Set(i, -1)
            }
            i = Add(i, 1)
        }

        // Pass 2: walk every live WinTable slot
        i = 0
        WhileLoop LessThan(i, cnt) {
            base = Add(WinTable.entries, Multiply(i, WinTableConst.ENTRY_SIZE))
            leaf = Dereference(Add(base, WinTableConst.LEAF_OFS))
            surf = Dereference(Add(base, WinTableConst.SURF_OFS))
            tb   = TBMap_Get(i)

            IfCondition GreaterEqual(tb, 0) ThenBlock: {
                // Check ACTIVE — Destroy zeros the record so ACTIVE=0 means dead handle
                // (stale slot from WinTable compaction after a remove)
                active = TB_Get(tb, TBField.ACTIVE)
                IfCondition EqualTo(active, 0) ThenBlock: {
                    TBMap_Set(i, -1)
                    tb = -1
                } ElseBlock: {
                    // Live handle — check surface still matches
                    tb_surf = TB_Get(tb, TBField.SURF)
                    IfCondition NotEqual(tb_surf, surf) ThenBlock: {
                        new_tb = TextBuffer_Create(surf, SysDisplayState.font)
                        IfCondition GreaterEqual(new_tb, 0) ThenBlock: {
                            pane_color = PaneDecorator_Decorate(leaf, WinTable_GetColor(leaf), 0)
                            TextBuffer_SetColors(new_tb, 0xFFFFFF, pane_color)
                            CopyTBContent(tb, new_tb)
                        }
                        TextBuffer_Destroy(tb)
                        TBMap_Set(i, new_tb)
                        tb = new_tb
                        PrintMessage("[PM] rebuilt TB slot=")
                        PrintNumber(i)
                        PrintMessage("\n")
                    }
                }
            }

            // Create TB if slot has no valid TB
            IfCondition LessThan(tb, 0) ThenBlock: {
                new_tb = TextBuffer_Create(surf, SysDisplayState.font)
                IfCondition GreaterEqual(new_tb, 0) ThenBlock: {
                    pane_color = PaneDecorator_Decorate(leaf, -1, 0)
                    TextBuffer_SetColors(new_tb, 0xFFFFFF, pane_color)
                    TBMap_Set(i, new_tb)
                    PrintMessage("[PM] new TB slot=")
                    PrintNumber(i)
                    PrintMessage("\n")
                }
            }

            i = Add(i, 1)
        }
        ReturnValue(1)
    }
}

// =============================================================================
// RENDER
// =============================================================================
Function.RenderDirtyBuffers {
    Output: Integer
    Body: {
        cnt = WinTable.count
        any = 0
        i   = 0
        WhileLoop LessThan(i, cnt) {
            tb = TBMap_Get(i)
            IfCondition GreaterEqual(tb, 0) ThenBlock: {
                IfCondition EqualTo(TextBuffer_IsDirty(tb), 1) ThenBlock: {
                    TextBuffer_Render(tb)
                    any = 1
                }
            }
            i = Add(i, 1)
        }
        ReturnValue(any)
    }
}

Function.BlitOneSurface {
    Input: surf:  Integer
    Input: dst_x: Integer
    Input: dst_y: Integer
    Output: Integer
    Body: {
        sw        = Surface_GetWidth(surf)
        sh        = Surface_GetHeight(surf)
        src_data  = Surface_GetData(surf)
        src_pitch = Surface_GetPitch(surf)
        dst_buf   = FB_GetDrawBuffer()
        dst_pitch = FB.pitch
        row_bytes = Multiply(sw, SurfaceConst.PIXEL_BYTES)
        dst_x_off = Multiply(dst_x, SurfaceConst.PIXEL_BYTES)
        y = 0
        WhileLoop LessThan(y, sh) {
            src_row = Add(src_data, Multiply(y, src_pitch))
            dst_row = Add(Add(dst_buf, Multiply(Add(y, dst_y), dst_pitch)), dst_x_off)
            i = 0
            WhileLoop LessThan(i, row_bytes) {
                SetByte(dst_row, i, GetByte(src_row, i))
                i = Add(i, 1)
            }
            y = Add(y, 1)
        }
        ReturnValue(1)
    }
}

Function.BlitAllSurfaces {
    Output: Integer
    Body: {
        cnt = WinTable.count
        i   = 0
        WhileLoop LessThan(i, cnt) {
            base = Add(WinTable.entries, Multiply(i, WinTableConst.ENTRY_SIZE))
            leaf = Dereference(Add(base, WinTableConst.LEAF_OFS))
            surf = Dereference(Add(base, WinTableConst.SURF_OFS))
            IfCondition NotEqual(surf, 0) ThenBlock: {
                x = BSP_GetRegionX(leaf)
                y = BSP_GetRegionY(leaf)
                BlitOneSurface(surf, x, y)
            }
            i = Add(i, 1)
        }
        Cursor_Draw()
        FB_FlipFast()
        ReturnValue(0)
    }
}