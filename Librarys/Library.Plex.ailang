// Library.Plex.ailang
// Multi-ring plex structure library for AILang.
//
// A plex node lives in multiple circular doubly-linked rings
// simultaneously. Each ring is identified by an integer ring_id
// (0..7). Nodes also carry up to 16 user-defined data slots.
//
// Inspired by Sutherland's Sketchpad ring structures (1963).
// Unlike OOP class dispatch, plex classification is local:
// walk a ring, inspect neighbors, resolve constraints.
//
// Usage:
//   LibraryImport.Plex
//   Plex.Init()
//   n = Plex.Alloc(type_tag)
//   Plex.Set(n, slot, value)
//   Plex.RingLink(a, b, ring_id)
//   ... walk with Plex.RingNext / Plex.RingWalk ...
//   Plex.Free(n)
//
// Node memory layout (34 words):
//   [0]  type tag
//   [1]  flags / user metadata
//   [2..17]  ring slots: 8 rings x 2 words (next, prev)
//       ring R next = word (2 + R*2), prev = word (3 + R*2)
//   [18..33] data slots: 16 user words
//       data slot S = word (18 + S)
//
// Copyright (c) 2025-2026 Sean Collins, 2 Paws Machine and Engineering. All rights reserved.
// Licensed under the Sean Collins Software License (SCSL v1.0).

LibraryImport.Arena

FixedPool.Plex_Const {
    "STRIDE": Initialize=34
    "MAX_RINGS": Initialize=8
    "MAX_DATA": Initialize=16
    "RING_BASE": Initialize=2
    "DATA_BASE": Initialize=18
    "DEFAULT_CAP": Initialize=4096
}

FixedPool.Plex_State {
    "pool": Initialize=0
    "capacity": Initialize=0
    "count": Initialize=0
    "free_head": Initialize=0
    "initialized": Initialize=0
}

// ============================================================================
// INIT / LIFECYCLE
// ============================================================================

Function.Plex.Init {
    Output: Integer
    Body: {
        IfCondition NotEqual(Plex_State.initialized, 0) ThenBlock: { ReturnValue(1) }
        Plex_State.capacity = Plex_Const.DEFAULT_CAP
        Plex_State.pool = Allocate(Multiply(Plex_State.capacity, Plex_Const.STRIDE))
        IfCondition EqualTo(Plex_State.pool, 0) ThenBlock: { ReturnValue(0) }
        Plex_State.count = 0
        Plex_State.free_head = 0
        Plex_State.initialized = 1
        ReturnValue(1)
    }
}

Function.Plex.Alloc {
    Input: type_tag: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(Plex_State.initialized, 0) ThenBlock: {
            IfCondition EqualTo(Plex.Init(), 0) ThenBlock: { ReturnValue(0) }
        }
        idx = 0
        IfCondition NotEqual(Plex_State.free_head, 0) ThenBlock: {
            idx = Plex_State.free_head
            base = Multiply(idx, Plex_Const.STRIDE)
            Plex_State.free_head = ArrayGet(Plex_State.pool, Add(base, 1))
        } ElseBlock: {
            Plex_State.count = Add(Plex_State.count, 1)
            idx = Plex_State.count
            IfCondition GreaterEqual(idx, Plex_State.capacity) ThenBlock: {
                Plex_State.count = Subtract(Plex_State.count, 1)
                ReturnValue(0)
            }
        }
        base = Multiply(idx, Plex_Const.STRIDE)
        ArraySet(Plex_State.pool, base, type_tag)
        i = 1
        WhileLoop LessThan(i, Plex_Const.STRIDE) {
            ArraySet(Plex_State.pool, Add(base, i), 0)
            i = Add(i, 1)
        }
        ReturnValue(idx)
    }
}

Function.Plex.Free {
    Input: node: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(node, 1) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterEqual(node, Plex_State.capacity) ThenBlock: { ReturnValue(0) }
        r = 0
        WhileLoop LessThan(r, Plex_Const.MAX_RINGS) {
            Plex.RingUnlink(node, r)
            r = Add(r, 1)
        }
        base = Multiply(node, Plex_Const.STRIDE)
        ArraySet(Plex_State.pool, base, 0)
        ArraySet(Plex_State.pool, Add(base, 1), Plex_State.free_head)
        Plex_State.free_head = node
        ReturnValue(1)
    }
}

Function.Plex.IsLive {
    Input: node: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(node, 1) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterEqual(node, Plex_State.capacity) ThenBlock: { ReturnValue(0) }
        base = Multiply(node, Plex_Const.STRIDE)
        IfCondition EqualTo(ArrayGet(Plex_State.pool, base), 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(1)
    }
}

// ============================================================================
// TYPE / FLAGS
// ============================================================================

Function.Plex.Type {
    Input: node: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(node, 1) ThenBlock: { ReturnValue(0) }
        base = Multiply(node, Plex_Const.STRIDE)
        ReturnValue(ArrayGet(Plex_State.pool, base))
    }
}

Function.Plex.SetType {
    Input: node: Integer
    Input: type_tag: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(node, 1) ThenBlock: { ReturnValue(0) }
        base = Multiply(node, Plex_Const.STRIDE)
        ArraySet(Plex_State.pool, base, type_tag)
        ReturnValue(1)
    }
}

Function.Plex.Flags {
    Input: node: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(node, 1) ThenBlock: { ReturnValue(0) }
        base = Multiply(node, Plex_Const.STRIDE)
        ReturnValue(ArrayGet(Plex_State.pool, Add(base, 1)))
    }
}

Function.Plex.SetFlags {
    Input: node: Integer
    Input: flags: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(node, 1) ThenBlock: { ReturnValue(0) }
        base = Multiply(node, Plex_Const.STRIDE)
        ArraySet(Plex_State.pool, Add(base, 1), flags)
        ReturnValue(1)
    }
}

// ============================================================================
// DATA SLOTS (0..15)
// ============================================================================

Function.Plex.Get {
    Input: node: Integer
    Input: slot: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(node, 1) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(slot, 0) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterEqual(slot, Plex_Const.MAX_DATA) ThenBlock: { ReturnValue(0) }
        base = Multiply(node, Plex_Const.STRIDE)
        ReturnValue(ArrayGet(Plex_State.pool, Add(base, Add(Plex_Const.DATA_BASE, slot))))
    }
}

Function.Plex.Set {
    Input: node: Integer
    Input: slot: Integer
    Input: value: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(node, 1) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(slot, 0) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterEqual(slot, Plex_Const.MAX_DATA) ThenBlock: { ReturnValue(0) }
        base = Multiply(node, Plex_Const.STRIDE)
        ArraySet(Plex_State.pool, Add(base, Add(Plex_Const.DATA_BASE, slot)), value)
        ReturnValue(1)
    }
}

// ============================================================================
// RING OPERATIONS (0..7)
//
// Each ring is a circular doubly-linked list.
// A singleton node points to itself (next=self, prev=self).
// An empty ring slot has next=0, prev=0 (node not in that ring).
// ============================================================================

Function.Plex.RingNext {
    Input: node: Integer
    Input: ring: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(node, 1) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(ring, 0) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterEqual(ring, Plex_Const.MAX_RINGS) ThenBlock: { ReturnValue(0) }
        base = Multiply(node, Plex_Const.STRIDE)
        ReturnValue(ArrayGet(Plex_State.pool, Add(base, Add(Plex_Const.RING_BASE, Multiply(ring, 2)))))
    }
}

Function.Plex.RingPrev {
    Input: node: Integer
    Input: ring: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(node, 1) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(ring, 0) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterEqual(ring, Plex_Const.MAX_RINGS) ThenBlock: { ReturnValue(0) }
        base = Multiply(node, Plex_Const.STRIDE)
        ReturnValue(ArrayGet(Plex_State.pool, Add(base, Add(Plex_Const.RING_BASE, Add(Multiply(ring, 2), 1)))))
    }
}

// Internal: raw set next/prev for a ring slot
Function.Plex._RingSetNext {
    Input: node: Integer
    Input: ring: Integer
    Input: target: Integer
    Output: Integer
    Body: {
        base = Multiply(node, Plex_Const.STRIDE)
        ArraySet(Plex_State.pool, Add(base, Add(Plex_Const.RING_BASE, Multiply(ring, 2))), target)
        ReturnValue(1)
    }
}

Function.Plex._RingSetPrev {
    Input: node: Integer
    Input: ring: Integer
    Input: target: Integer
    Output: Integer
    Body: {
        base = Multiply(node, Plex_Const.STRIDE)
        ArraySet(Plex_State.pool, Add(base, Add(Plex_Const.RING_BASE, Add(Multiply(ring, 2), 1))), target)
        ReturnValue(1)
    }
}

// Insert node B after node A in ring R.
// If A is not in ring R yet, A becomes a singleton first.
// If B is already in a ring R, it is unlinked first.
Function.Plex.RingInsertAfter {
    Input: a: Integer
    Input: b: Integer
    Input: ring: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(a, 1) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(b, 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(a, b) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(ring, 0) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterEqual(ring, Plex_Const.MAX_RINGS) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(Plex.RingNext(b, ring), 0) ThenBlock: {
            Plex.RingUnlink(b, ring)
        }
        a_next = Plex.RingNext(a, ring)
        IfCondition EqualTo(a_next, 0) ThenBlock: {
            Plex._RingSetNext(a, ring, a)
            Plex._RingSetPrev(a, ring, a)
            a_next = a
        }
        Plex._RingSetNext(b, ring, a_next)
        Plex._RingSetPrev(b, ring, a)
        Plex._RingSetNext(a, ring, b)
        Plex._RingSetPrev(a_next, ring, b)
        ReturnValue(1)
    }
}

// Insert node B before node A in ring R.
Function.Plex.RingInsertBefore {
    Input: a: Integer
    Input: b: Integer
    Input: ring: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(a, 1) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(b, 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(a, b) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(ring, 0) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterEqual(ring, Plex_Const.MAX_RINGS) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(Plex.RingNext(b, ring), 0) ThenBlock: {
            Plex.RingUnlink(b, ring)
        }
        a_prev = Plex.RingPrev(a, ring)
        IfCondition EqualTo(a_prev, 0) ThenBlock: {
            Plex._RingSetNext(a, ring, a)
            Plex._RingSetPrev(a, ring, a)
            a_prev = a
        }
        Plex._RingSetNext(b, ring, a)
        Plex._RingSetPrev(b, ring, a_prev)
        Plex._RingSetPrev(a, ring, b)
        Plex._RingSetNext(a_prev, ring, b)
        ReturnValue(1)
    }
}

// Remove node from ring R. Patches neighbors together.
Function.Plex.RingUnlink {
    Input: node: Integer
    Input: ring: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(node, 1) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(ring, 0) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterEqual(ring, Plex_Const.MAX_RINGS) ThenBlock: { ReturnValue(0) }
        nx = Plex.RingNext(node, ring)
        IfCondition EqualTo(nx, 0) ThenBlock: { ReturnValue(1) }
        pv = Plex.RingPrev(node, ring)
        IfCondition EqualTo(nx, node) ThenBlock: {
            Plex._RingSetNext(node, ring, 0)
            Plex._RingSetPrev(node, ring, 0)
            ReturnValue(1)
        }
        Plex._RingSetNext(pv, ring, nx)
        Plex._RingSetPrev(nx, ring, pv)
        Plex._RingSetNext(node, ring, 0)
        Plex._RingSetPrev(node, ring, 0)
        ReturnValue(1)
    }
}

// Make node a singleton in ring R (points to itself).
Function.Plex.RingSingleton {
    Input: node: Integer
    Input: ring: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(node, 1) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(ring, 0) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterEqual(ring, Plex_Const.MAX_RINGS) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(Plex.RingNext(node, ring), 0) ThenBlock: {
            Plex.RingUnlink(node, ring)
        }
        Plex._RingSetNext(node, ring, node)
        Plex._RingSetPrev(node, ring, node)
        ReturnValue(1)
    }
}

// Is node in ring R? (next != 0)
Function.Plex.RingIn {
    Input: node: Integer
    Input: ring: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(Plex.RingNext(node, ring), 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(1)
    }
}

// Is node alone in ring R? (next == self)
Function.Plex.RingAlone {
    Input: node: Integer
    Input: ring: Integer
    Output: Integer
    Body: {
        nx = Plex.RingNext(node, ring)
        IfCondition EqualTo(nx, 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(nx, node) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

// ============================================================================
// RING TRAVERSAL
// ============================================================================

// Count nodes in ring R starting from start (including start).
Function.Plex.RingCount {
    Input: start: Integer
    Input: ring: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(start, 1) ThenBlock: { ReturnValue(0) }
        nx = Plex.RingNext(start, ring)
        IfCondition EqualTo(nx, 0) ThenBlock: { ReturnValue(0) }
        n = 1
        cur = nx
        WhileLoop NotEqual(cur, start) {
            IfCondition EqualTo(cur, 0) ThenBlock: { ReturnValue(n) }
            IfCondition GreaterThan(n, 4096) ThenBlock: { ReturnValue(n) }
            n = Add(n, 1)
            cur = Plex.RingNext(cur, ring)
        }
        ReturnValue(n)
    }
}

// Collect node IDs from ring R into out_addr array. Returns count.
Function.Plex.RingCollect {
    Input: start: Integer
    Input: ring: Integer
    Input: out_addr: Address
    Input: max_out: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(start, 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(out_addr, 0) ThenBlock: { ReturnValue(0) }
        nx = Plex.RingNext(start, ring)
        IfCondition EqualTo(nx, 0) ThenBlock: { ReturnValue(0) }
        ArraySet(out_addr, 0, start)
        n = 1
        cur = nx
        WhileLoop NotEqual(cur, start) {
            IfCondition EqualTo(cur, 0) ThenBlock: { ReturnValue(n) }
            IfCondition GreaterEqual(n, max_out) ThenBlock: { ReturnValue(n) }
            ArraySet(out_addr, n, cur)
            n = Add(n, 1)
            cur = Plex.RingNext(cur, ring)
        }
        ReturnValue(n)
    }
}

// Find first node in ring R (from start) whose type matches type_tag.
// Returns 0 if not found.
Function.Plex.RingFindType {
    Input: start: Integer
    Input: ring: Integer
    Input: type_tag: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(start, 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Plex.Type(start), type_tag) ThenBlock: { ReturnValue(start) }
        nx = Plex.RingNext(start, ring)
        IfCondition EqualTo(nx, 0) ThenBlock: { ReturnValue(0) }
        cur = nx
        WhileLoop NotEqual(cur, start) {
            IfCondition EqualTo(cur, 0) ThenBlock: { ReturnValue(0) }
            IfCondition EqualTo(Plex.Type(cur), type_tag) ThenBlock: { ReturnValue(cur) }
            cur = Plex.RingNext(cur, ring)
        }
        ReturnValue(0)
    }
}

// Find first node in ring R whose data slot matches value.
Function.Plex.RingFindSlot {
    Input: start: Integer
    Input: ring: Integer
    Input: slot: Integer
    Input: value: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(start, 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Plex.Get(start, slot), value) ThenBlock: { ReturnValue(start) }
        nx = Plex.RingNext(start, ring)
        IfCondition EqualTo(nx, 0) ThenBlock: { ReturnValue(0) }
        cur = nx
        WhileLoop NotEqual(cur, start) {
            IfCondition EqualTo(cur, 0) ThenBlock: { ReturnValue(0) }
            IfCondition EqualTo(Plex.Get(cur, slot), value) ThenBlock: { ReturnValue(cur) }
            cur = Plex.RingNext(cur, ring)
        }
        ReturnValue(0)
    }
}

// Count nodes in ring R matching a type tag.
Function.Plex.RingCountType {
    Input: start: Integer
    Input: ring: Integer
    Input: type_tag: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(start, 1) ThenBlock: { ReturnValue(0) }
        nx = Plex.RingNext(start, ring)
        IfCondition EqualTo(nx, 0) ThenBlock: { ReturnValue(0) }
        n = 0
        IfCondition EqualTo(Plex.Type(start), type_tag) ThenBlock: { n = 1 }
        cur = nx
        WhileLoop NotEqual(cur, start) {
            IfCondition EqualTo(cur, 0) ThenBlock: { ReturnValue(n) }
            IfCondition GreaterThan(n, 4096) ThenBlock: { ReturnValue(n) }
            IfCondition EqualTo(Plex.Type(cur), type_tag) ThenBlock: { n = Add(n, 1) }
            cur = Plex.RingNext(cur, ring)
        }
        ReturnValue(n)
    }
}

// ============================================================================
// RING PREDICATES (classification helpers)
// ============================================================================

// 1 iff every node in ring R has the same type tag.
Function.Plex.RingAllSameType {
    Input: start: Integer
    Input: ring: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(start, 1) ThenBlock: { ReturnValue(0) }
        nx = Plex.RingNext(start, ring)
        IfCondition EqualTo(nx, 0) ThenBlock: { ReturnValue(0) }
        tt = Plex.Type(start)
        cur = nx
        WhileLoop NotEqual(cur, start) {
            IfCondition EqualTo(cur, 0) ThenBlock: { ReturnValue(1) }
            IfCondition NotEqual(Plex.Type(cur), tt) ThenBlock: { ReturnValue(0) }
            cur = Plex.RingNext(cur, ring)
        }
        ReturnValue(1)
    }
}

// 1 iff every node in ring R has data[slot] == value.
Function.Plex.RingAllSlotEqual {
    Input: start: Integer
    Input: ring: Integer
    Input: slot: Integer
    Input: value: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(start, 1) ThenBlock: { ReturnValue(0) }
        nx = Plex.RingNext(start, ring)
        IfCondition EqualTo(nx, 0) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(Plex.Get(start, slot), value) ThenBlock: { ReturnValue(0) }
        cur = nx
        WhileLoop NotEqual(cur, start) {
            IfCondition EqualTo(cur, 0) ThenBlock: { ReturnValue(1) }
            IfCondition NotEqual(Plex.Get(cur, slot), value) ThenBlock: { ReturnValue(0) }
            cur = Plex.RingNext(cur, ring)
        }
        ReturnValue(1)
    }
}

// 1 iff any node in ring R has data[slot] == value.
Function.Plex.RingAnySlotEqual {
    Input: start: Integer
    Input: ring: Integer
    Input: slot: Integer
    Input: value: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(start, 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Plex.Get(start, slot), value) ThenBlock: { ReturnValue(1) }
        nx = Plex.RingNext(start, ring)
        IfCondition EqualTo(nx, 0) ThenBlock: { ReturnValue(0) }
        cur = nx
        WhileLoop NotEqual(cur, start) {
            IfCondition EqualTo(cur, 0) ThenBlock: { ReturnValue(0) }
            IfCondition EqualTo(Plex.Get(cur, slot), value) ThenBlock: { ReturnValue(1) }
            cur = Plex.RingNext(cur, ring)
        }
        ReturnValue(0)
    }
}

// ============================================================================
// CROSS-RING: splice two rings together at a shared node
// ============================================================================

// Move all nodes from ring src_ring into ring dst_ring,
// inserting them after anchor in dst_ring. Clears src_ring membership.
Function.Plex.RingSplice {
    Input: anchor: Integer
    Input: start: Integer
    Input: dst_ring: Integer
    Input: src_ring: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(anchor, 1) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(start, 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Plex.RingNext(start, src_ring), 0) ThenBlock: { ReturnValue(0) }
        buf = Allocate(256)
        IfCondition EqualTo(buf, 0) ThenBlock: { ReturnValue(0) }
        n = Plex.RingCollect(start, src_ring, buf, 256)
        i = 0
        WhileLoop LessThan(i, n) {
            nd = ArrayGet(buf, i)
            Plex.RingUnlink(nd, src_ring)
            Plex.RingInsertAfter(anchor, nd, dst_ring)
            anchor = nd
            i = Add(i, 1)
        }
        ReturnValue(n)
    }
}

// ============================================================================
// DEBUG
// ============================================================================

Function.Plex.DumpNode {
    Input: node: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(node, 1) ThenBlock: { ReturnValue(0) }
        PrintMessage("plex node=")
        PrintNumber(node)
        PrintMessage(" type=")
        PrintNumber(Plex.Type(node))
        PrintMessage(" flags=")
        PrintNumber(Plex.Flags(node))
        r = 0
        WhileLoop LessThan(r, Plex_Const.MAX_RINGS) {
            nx = Plex.RingNext(node, r)
            IfCondition NotEqual(nx, 0) ThenBlock: {
                PrintMessage(" r")
                PrintNumber(r)
                PrintMessage("=[")
                PrintNumber(Plex.RingPrev(node, r))
                PrintMessage("<-")
                PrintNumber(node)
                PrintMessage("->")
                PrintNumber(nx)
                PrintMessage("]")
            }
            r = Add(r, 1)
        }
        PrintMessage("\n")
        ReturnValue(1)
    }
}

Function.Plex.DumpRing {
    Input: start: Integer
    Input: ring: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(start, 1) ThenBlock: { ReturnValue(0) }
        PrintMessage("plex ring ")
        PrintNumber(ring)
        PrintMessage(": ")
        nx = Plex.RingNext(start, ring)
        IfCondition EqualTo(nx, 0) ThenBlock: {
            PrintMessage("(empty)\n")
            ReturnValue(0)
        }
        PrintNumber(start)
        cur = nx
        WhileLoop NotEqual(cur, start) {
            IfCondition EqualTo(cur, 0) ThenBlock: {
                PrintMessage(" -> (broken)\n")
                ReturnValue(0)
            }
            PrintMessage(" -> ")
            PrintNumber(cur)
            cur = Plex.RingNext(cur, ring)
        }
        PrintMessage(" -> (back to ")
        PrintNumber(start)
        PrintMessage(")\n")
        ReturnValue(Plex.RingCount(start, ring))
    }
}

Function.Plex.Stats {
    Output: Integer
    Body: {
        PrintMessage("plex pool: count=")
        PrintNumber(Plex_State.count)
        PrintMessage(" cap=")
        PrintNumber(Plex_State.capacity)
        PrintMessage("\n")
        ReturnValue(Plex_State.count)
    }
}
