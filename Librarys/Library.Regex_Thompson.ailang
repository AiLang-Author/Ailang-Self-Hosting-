// Library.Regex_Thompson_Fixed.ailang
// Thompson NFA Regex Engine - BUG FIX
// Fixed state structure alignment (40 bytes per state, not 24!)
// Fixed list-node OOB write in CreateList (April 2026).

// Self-contained import — compiler dedups, so callers can also import.
LibraryImport.Arena

// ============================================================================
// CONFIGURATION AND CONSTANTS
// ============================================================================

FixedPool.RegexFlags {
    "CASE_INSENSITIVE": Initialize=1
    "MULTILINE": Initialize=2
    "DOTALL": Initialize=4
    "VERBOSE": Initialize=8
    "UNICODE": Initialize=16
}

FixedPool.RegexConstants {
    "MAX_STATES": Initialize=4096
    "MAX_CAPTURES": Initialize=32
    "MAX_THREADS": Initialize=1024
    "CACHE_SIZE": Initialize=256
    "STATE_SIZE": Initialize=40
}

FixedPool.StateType {
    "CHAR": Initialize=0
    "RANGE": Initialize=1
    "DOT": Initialize=2
    "SPLIT": Initialize=3
    "MATCH": Initialize=4
    "SAVE": Initialize=5
    "EMPTY": Initialize=6
    "ASSERT_START": Initialize=7
    "ASSERT_END": Initialize=8
    "WORD_BOUNDARY": Initialize=9
    "NOT_WORD_BOUNDARY": Initialize=10
    "LOOKAHEAD": Initialize=11
    "LOOKBEHIND": Initialize=12
    "BACKREF": Initialize=13
}

// ============================================================================
// CORE DATA STRUCTURES
// ============================================================================

FixedPool.RegexState {
    "states": Initialize=0
    "num_states": Initialize=0
    "start_state": Initialize=0
    "capture_count": Initialize=0
}

FixedPool.CompilerState {
    "pattern": Initialize=0
    "pos": Initialize=0
    "len": Initialize=0
    "group_count": Initialize=0
    "flags": Initialize=0
    "error": Initialize=0
}

FixedPool.MatchState {
    "text": Initialize=0
    "text_len": Initialize=0
    "pos": Initialize=0
    "threads": Initialize=0
    "next_threads": Initialize=0
    "thread_count": Initialize=0
    "next_count": Initialize=0
    "captures": Initialize=0
    "thread_size": Initialize=0
}

// Ring-buffer slot pools for parser AST nodes. Replaces per-node
// Allocate(16|24|32) which — because the Arena rounds every small
// alloc to a 16-byte-aligned 4KB slab — burned ~4KB per fragment
// and pushed RSS past 12GB on real grep workloads. Each pool is a
// single contiguous Allocate, lazily initialized on first compile
// and re-used across compiles by resetting `head` at Regex_Compile
// entry. Single-pool design is single-threaded; per-thread pools
// are a trivial extension (AtomicCompareSwap already exists in the
// Threading v0.1 library) once we go multithreaded.
FixedPool.RegexFragPool {
    "buf":  Initialize=0, CanChange=True
    "head": Initialize=0, CanChange=True
    "cap":  Initialize=65536
}
FixedPool.RegexListPool {
    "buf":  Initialize=0, CanChange=True
    "head": Initialize=0, CanChange=True
    "cap":  Initialize=65536
}
FixedPool.RegexClassPool {
    "buf":  Initialize=0, CanChange=True
    "head": Initialize=0, CanChange=True
    "cap":  Initialize=4096
}

// ============================================================================
// INITIALIZATION (Must be called before using library)
// ============================================================================

SubRoutine.InitializeRegexEngine {
    RegexState.states = 0
    RegexState.num_states = 0
    RegexState.start_state = 0
    RegexState.capture_count = 0
    
    CompilerState.pattern = 0
    CompilerState.pos = 0
    CompilerState.len = 0
    CompilerState.group_count = 0
    CompilerState.flags = 0
    CompilerState.error = 0
    
    MatchState.text = 0
    MatchState.text_len = 0
    MatchState.pos = 0
    MatchState.threads = 0
    MatchState.next_threads = 0
    MatchState.thread_count = 0
    MatchState.next_count = 0
    MatchState.captures = 0
    MatchState.thread_size = 0
}

// ============================================================================
// PARSER NODE POOL ALLOCATORS
// ============================================================================
// Hand out the next free slot from a pre-allocated FixedPool-backed
// slab. Slot storage is reused across compiles — Regex_Compile resets
// `head` to 0 at entry. Returns 0 on overflow so existing null-checks
// at every call site continue to work unchanged.

Function.FragAlloc {
    Output: Address
    Body: {
        IfCondition EqualTo(RegexFragPool.buf, 0) ThenBlock: {
            RegexFragPool.buf = Allocate(Multiply(RegexFragPool.cap, 16))
            IfCondition EqualTo(RegexFragPool.buf, 0) ThenBlock: {
                ReturnValue(0)
            }
        }
        IfCondition GreaterEqual(RegexFragPool.head, RegexFragPool.cap) ThenBlock: {
            ReturnValue(0)
        }
        slot = Add(RegexFragPool.buf, Multiply(RegexFragPool.head, 16))
        RegexFragPool.head = Add(RegexFragPool.head, 1)
        ReturnValue(slot)
    }
}

Function.ListAlloc {
    Output: Address
    Body: {
        IfCondition EqualTo(RegexListPool.buf, 0) ThenBlock: {
            RegexListPool.buf = Allocate(Multiply(RegexListPool.cap, 24))
            IfCondition EqualTo(RegexListPool.buf, 0) ThenBlock: {
                ReturnValue(0)
            }
        }
        IfCondition GreaterEqual(RegexListPool.head, RegexListPool.cap) ThenBlock: {
            ReturnValue(0)
        }
        slot = Add(RegexListPool.buf, Multiply(RegexListPool.head, 24))
        RegexListPool.head = Add(RegexListPool.head, 1)
        ReturnValue(slot)
    }
}

Function.ClassAlloc {
    Output: Address
    Body: {
        IfCondition EqualTo(RegexClassPool.buf, 0) ThenBlock: {
            RegexClassPool.buf = Allocate(Multiply(RegexClassPool.cap, 32))
            IfCondition EqualTo(RegexClassPool.buf, 0) ThenBlock: {
                ReturnValue(0)
            }
        }
        IfCondition GreaterEqual(RegexClassPool.head, RegexClassPool.cap) ThenBlock: {
            ReturnValue(0)
        }
        slot = Add(RegexClassPool.buf, Multiply(RegexClassPool.head, 32))
        RegexClassPool.head = Add(RegexClassPool.head, 1)
        ReturnValue(slot)
    }
}

// ============================================================================
// PUBLIC API
// ============================================================================

Function.Regex_Compile {
    Input: pattern: Address
    Input: flags: Integer
    Output: Address
    Body: {
        IfCondition EqualTo(pattern, 0) ThenBlock: {
            ReturnValue(0)
        }
        
        CompilerState.pattern = pattern
        CompilerState.pos = 0
        CompilerState.len = StringLength(pattern)
        CompilerState.group_count = 0
        CompilerState.flags = flags
        CompilerState.error = 0

        // Pools are process-lifetime bump allocators: each compile appends
        // fresh slots without touching earlier compiles' data. Resetting
        // `head` here would corrupt prior handles — RANGE states hold raw
        // pointers into RegexClassPool, so overwriting those slots breaks
        // any regex compiled before this one.

        total_size = Multiply(RegexConstants.MAX_STATES, RegexConstants.STATE_SIZE)
        
        RegexState.states = Allocate(total_size)
        IfCondition EqualTo(RegexState.states, 0) ThenBlock: {
            ReturnValue(0)
        }
        
        RegexState.num_states = 0
        
        // Initialize memory
        i = 0
        WhileLoop LessThan(i, total_size) {
            SetByte(RegexState.states, i, 0)
            i = Add(i, 1)
        }
        
        start_frag = ParsePattern()
        
        IfCondition EqualTo(start_frag, 0) ThenBlock: {
            Deallocate(RegexState.states, total_size)
            ReturnValue(0)
        }

        IfCondition NotEqual(CompilerState.error, 0) ThenBlock: {
            Deallocate(RegexState.states, total_size)
            ReturnValue(0)
        }

        match_state = AddState(StateType.MATCH, 0, 0)
        frag_out = Dereference(Add(start_frag, 8))
        PatchList(frag_out, match_state)

        handle = Allocate(32)
        IfCondition EqualTo(handle, 0) ThenBlock: {
            Deallocate(RegexState.states, total_size)
            ReturnValue(0)
        }

        StoreValue(handle, RegexState.states)
        StoreValue(Add(handle, 8), RegexState.num_states)
        frag_start = Dereference(start_frag)
        StoreValue(Add(handle, 16), frag_start)
        StoreValue(Add(handle, 24), CompilerState.group_count)

        ReturnValue(handle)
    }
}

Function.Regex_Match {
    Input: regex: Address
    Input: text: Address
    Input: start_pos: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(regex, 0) ThenBlock: {
            ReturnValue(-1)
        }
        
        IfCondition EqualTo(text, 0) ThenBlock: {
            ReturnValue(-1)
        }
        
        states = Dereference(regex)
        num_states = Dereference(Add(regex, 8))
        start_state = Dereference(Add(regex, 16))
        capture_count = Dereference(Add(regex, 24))
        
        MatchState.text = text
        MatchState.text_len = StringLength(text)
        MatchState.pos = start_pos
        
        // Fixed: thread size is 16 bytes (state_id + pos)
        MatchState.thread_size = 16
        
        IfCondition GreaterThan(start_pos, MatchState.text_len) ThenBlock: {
            ReturnValue(-1)
        }
        
        // PERFORMANCE FIX (April 2026): the threads / next_threads buffers
        // are allocated once and reused across calls. The previous code
        // Allocate'd 32 KB per call and Deallocate'd at every return —
        // grep against a 100k-line file did 30M+ Match calls and pushed
        // RSS over 11 GB. MAX_THREADS and thread_size are compile-time
        // constants, so the buffers are the same size every call. Caller
        // can free via Regex_FreeMatchState() when done with all matches.
        threads_size = Multiply(RegexConstants.MAX_THREADS, MatchState.thread_size)

        IfCondition EqualTo(MatchState.threads, 0) ThenBlock: {
            MatchState.threads = Allocate(threads_size)
            IfCondition EqualTo(MatchState.threads, 0) ThenBlock: {
                ReturnValue(-1)
            }
        }
        IfCondition EqualTo(MatchState.next_threads, 0) ThenBlock: {
            MatchState.next_threads = Allocate(threads_size)
            IfCondition EqualTo(MatchState.next_threads, 0) ThenBlock: {
                ReturnValue(-1)
            }
        }

        MatchState.thread_count = 0
        MatchState.next_count = 0

        AddThread(start_state, start_pos, 0)

        WhileLoop LessEqual(MatchState.pos, MatchState.text_len) {
            ch = 0

            IfCondition LessThan(MatchState.pos, MatchState.text_len) ThenBlock: {
                ch = GetByte(text, MatchState.pos)
            }

            MatchState.next_count = 0
            i = 0
            WhileLoop LessThan(i, MatchState.thread_count) {
                thread = GetThread(i)
                state_id = Dereference(thread)

                result = ProcessState(states, state_id, ch, thread)

                IfCondition EqualTo(result, 1) ThenBlock: {
                    match_len = Subtract(MatchState.pos, start_pos)
                    ReturnValue(match_len)
                }

                i = Add(i, 1)
            }

            IfCondition LessThan(MatchState.pos, MatchState.text_len) ThenBlock: {
                temp = MatchState.threads
                MatchState.threads = MatchState.next_threads
                MatchState.next_threads = temp
                MatchState.thread_count = MatchState.next_count

                IfCondition EqualTo(MatchState.thread_count, 0) ThenBlock: {
                    ReturnValue(-1)
                }
            } ElseBlock: {
                BreakLoop
            }

            MatchState.pos = Add(MatchState.pos, 1)
        }

        // Check final states
        i = 0
        WhileLoop LessThan(i, MatchState.thread_count) {
            thread = GetThread(i)
            state_id = Dereference(thread)
            state_type = GetStateType(states, state_id)

            IfCondition EqualTo(state_type, StateType.MATCH) ThenBlock: {
                match_len = Subtract(MatchState.pos, start_pos)
                ReturnValue(match_len)
            }

            i = Add(i, 1)
        }

        ReturnValue(-1)
    }
}

// Unanchored single-pass search: returns 1 if the regex matches
// anywhere in `text`, 0 otherwise. Unlike Regex_Match (which is
// anchored at start_pos and a caller has to loop across positions),
// Regex_Search makes a SINGLE forward pass, keeping the start state
// active at every position so threads that "die" at a bad position
// are transparently re-seeded. This takes the overall cost from
// O(text_len × match_depth) per line down to roughly
// O(text_len × num_active_states) — the textbook Thompson NFA
// unanchored search driver. No algorithmic change to the state
// transitions themselves, only the driver loop.
//
// Caller supplies text_len explicitly so grep can avoid the
// StringLength walk in the hot loop (and we don't need a NUL
// terminator at line_len on the caller's buffer).
Function.Regex_Search {
    Input: regex: Address
    Input: text: Address
    Input: text_len: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(regex, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(text, 0) ThenBlock: { ReturnValue(0) }

        states      = Dereference(regex)
        start_state = Dereference(Add(regex, 16))

        MatchState.text        = text
        MatchState.text_len    = text_len
        MatchState.pos         = 0
        MatchState.thread_size = 16

        threads_size = Multiply(RegexConstants.MAX_THREADS, MatchState.thread_size)
        IfCondition EqualTo(MatchState.threads, 0) ThenBlock: {
            MatchState.threads = Allocate(threads_size)
            IfCondition EqualTo(MatchState.threads, 0) ThenBlock: { ReturnValue(0) }
        }
        IfCondition EqualTo(MatchState.next_threads, 0) ThenBlock: {
            MatchState.next_threads = Allocate(threads_size)
            IfCondition EqualTo(MatchState.next_threads, 0) ThenBlock: { ReturnValue(0) }
        }

        MatchState.thread_count = 0
        MatchState.next_count   = 0

        // Seed thread 0 at position 0. Epsilon-closure of start_state
        // into the thread set happens inline as SPLIT/EMPTY states get
        // processed below.
        AddThread(start_state, 0, 0)

        WhileLoop LessEqual(MatchState.pos, MatchState.text_len) {
            ch = 0
            IfCondition LessThan(MatchState.pos, MatchState.text_len) ThenBlock: {
                ch = GetByte(text, MatchState.pos)
            }

            // Keep start_state alive at this position too so any
            // position can be a fresh match start. AddThread dedups,
            // so this is a no-op if start_state is already active.
            AddThread(start_state, MatchState.pos, 0)

            MatchState.next_count = 0
            i = 0
            WhileLoop LessThan(i, MatchState.thread_count) {
                thread = GetThread(i)
                state_id = Dereference(thread)
                result = ProcessState(states, state_id, ch, thread)
                IfCondition EqualTo(result, 1) ThenBlock: {
                    ReturnValue(1)
                }
                i = Add(i, 1)
            }

            IfCondition LessThan(MatchState.pos, MatchState.text_len) ThenBlock: {
                temp = MatchState.threads
                MatchState.threads = MatchState.next_threads
                MatchState.next_threads = temp
                MatchState.thread_count = MatchState.next_count
            } ElseBlock: {
                BreakLoop
            }

            MatchState.pos = Add(MatchState.pos, 1)
        }

        // Final sweep: any remaining thread sitting on a MATCH state
        // after the end-of-input pass is also a hit.
        i = 0
        WhileLoop LessThan(i, MatchState.thread_count) {
            thread = GetThread(i)
            state_id = Dereference(thread)
            state_type = GetStateType(states, state_id)
            IfCondition EqualTo(state_type, StateType.MATCH) ThenBlock: {
                ReturnValue(1)
            }
            i = Add(i, 1)
        }

        ReturnValue(0)
    }
}

// Free the persistent thread buffers. Optional — not calling it is
// also fine (process exit cleans up). Useful when the caller is
// done matching and wants to reclaim memory.
Function.Regex_FreeMatchState {
    Body: {
        IfCondition NotEqual(MatchState.threads, 0) ThenBlock: {
            threads_size = Multiply(RegexConstants.MAX_THREADS, MatchState.thread_size)
            Deallocate(MatchState.threads, threads_size)
            MatchState.threads = 0
        }
        IfCondition NotEqual(MatchState.next_threads, 0) ThenBlock: {
            threads_size = Multiply(RegexConstants.MAX_THREADS, MatchState.thread_size)
            Deallocate(MatchState.next_threads, threads_size)
            MatchState.next_threads = 0
        }
    }
}

Function.Regex_Free {
    Input: regex: Address
    Body: {
        IfCondition EqualTo(regex, 0) ThenBlock: {
            ReturnValue(0)
        }

        states = Dereference(regex)
        total_size = Multiply(RegexConstants.MAX_STATES, RegexConstants.STATE_SIZE)

        IfCondition NotEqual(states, 0) ThenBlock: {
            Deallocate(states, total_size)
        }

        Deallocate(regex, 32)
        ReturnValue(1)
    }
}

// Extract the longest literal prefix of the compiled regex — a run of
// CHAR states reachable from the start state with no branch (no SPLIT,
// no class, no anchor except a leading ^). Callers use this to pre-
// filter candidate match positions with a fast substring search (e.g.
// Boyer-Moore) and only invoke Regex_Match at hits. For patterns that
// start with SPLIT (alternation, `*`, `?`), returns 0.
//
// `out_buf` receives up to `max_len` prefix bytes. Returns the actual
// number written. A leading ^ anchor is transparently skipped so that
// "^foo.*" returns "foo" (still anchored — caller may ignore the
// anchor for its prefix-search stage since Regex_Match still enforces
// ^ at the candidate position).
Function.Regex_GetPrefix {
    Input: regex: Address
    Input: out_buf: Address
    Input: max_len: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(regex, 0) ThenBlock: { ReturnValue(0) }
        IfCondition LessEqual(max_len, 0) ThenBlock: { ReturnValue(0) }

        states     = Dereference(regex)
        num_states = Dereference(Add(regex, 8))
        state_id   = Dereference(Add(regex, 16))

        // Transparently skip one leading ASSERT_START (^) if present.
        IfCondition And(GreaterEqual(state_id, 0), LessThan(state_id, num_states)) ThenBlock: {
            t0 = GetStateType(states, state_id)
            IfCondition EqualTo(t0, StateType.ASSERT_START) ThenBlock: {
                offset0 = Multiply(state_id, RegexConstants.STATE_SIZE)
                state_id = Dereference(Add(Add(states, offset0), 24))
            }
        }

        written = 0
        WhileLoop 1 {
            IfCondition LessThan(state_id, 0) ThenBlock: { BreakLoop }
            IfCondition GreaterEqual(state_id, num_states) ThenBlock: { BreakLoop }
            IfCondition GreaterEqual(written, max_len) ThenBlock: { BreakLoop }
            t = GetStateType(states, state_id)
            IfCondition NotEqual(t, StateType.CHAR) ThenBlock: { BreakLoop }
            offset = Multiply(state_id, RegexConstants.STATE_SIZE)
            ch = Dereference(Add(Add(states, offset), 8))
            SetByte(out_buf, written, ch)
            written = Add(written, 1)
            state_id = Dereference(Add(Add(states, offset), 24))
        }

        ReturnValue(written)
    }
}

// ============================================================================
// PARSER FUNCTIONS
// ============================================================================

Function.ParsePattern {
    Output: Address
    Body: {
        frag = ParseAlt()
        ReturnValue(frag)
    }
}

Function.ParseAlt {
    Output: Address
    Body: {
        left = ParseSeq()
        
        IfCondition EqualTo(left, 0) ThenBlock: {
            ReturnValue(0)
        }
        
        WhileLoop 1 {
            IfCondition GreaterEqual(CompilerState.pos, CompilerState.len) ThenBlock: {
                BreakLoop
            }
            
            ch = GetByte(CompilerState.pattern, CompilerState.pos)
            IfCondition NotEqual(ch, 124) ThenBlock: {
                BreakLoop
            }
            
            CompilerState.pos = Add(CompilerState.pos, 1)
            right = ParseSeq()

            IfCondition EqualTo(right, 0) ThenBlock: {
                ReturnValue(0)
            }

            split = AddState(StateType.SPLIT, 0, 0)
            left_start = Dereference(left)
            right_start = Dereference(right)
            SetStateOut1(split, left_start)
            SetStateOut2(split, right_start)

            left_out = Dereference(Add(left, 8))
            right_out = Dereference(Add(right, 8))
            new_out = MergeLists(left_out, right_out)

            left = FragAlloc()
            IfCondition EqualTo(left, 0) ThenBlock: {
                ReturnValue(0)
            }
            
            StoreValue(left, split)
            StoreValue(Add(left, 8), new_out)
        }
        
        ReturnValue(left)
    }
}

Function.ParseSeq {
    Output: Address
    Body: {
        result = 0
        
        WhileLoop 1 {
            IfCondition GreaterEqual(CompilerState.pos, CompilerState.len) ThenBlock: {
                BreakLoop
            }
            
            ch = GetByte(CompilerState.pattern, CompilerState.pos)
            
            IfCondition EqualTo(ch, 124) ThenBlock: { BreakLoop }
            IfCondition EqualTo(ch, 41) ThenBlock: { BreakLoop }
            
            atom = ParseAtom()

            IfCondition EqualTo(atom, 0) ThenBlock: {
                ReturnValue(0)
            }

            IfCondition EqualTo(result, 0) ThenBlock: {
                result = atom
            } ElseBlock: {
                result_out = Dereference(Add(result, 8))
                atom_start = Dereference(atom)
                PatchList(result_out, atom_start)

                result_start = Dereference(result)
                atom_out = Dereference(Add(atom, 8))

                result = FragAlloc()
                IfCondition EqualTo(result, 0) ThenBlock: {
                    ReturnValue(0)
                }

                StoreValue(result, result_start)
                StoreValue(Add(result, 8), atom_out)
            }
        }

        IfCondition EqualTo(result, 0) ThenBlock: {
            empty = AddState(StateType.EMPTY, 0, 0)
            result = FragAlloc()
            IfCondition NotEqual(result, 0) ThenBlock: {
                StoreValue(result, empty)
                list = CreateList(empty)
                StoreValue(Add(result, 8), list)
            }
        }
        
        ReturnValue(result)
    }
}

Function.ParseAtom {
    Output: Address
    Body: {
        IfCondition GreaterEqual(CompilerState.pos, CompilerState.len) ThenBlock: {
            ReturnValue(0)
        }
        
        ch = GetByte(CompilerState.pattern, CompilerState.pos)
        
        IfCondition EqualTo(ch, 46) ThenBlock: {
            CompilerState.pos = Add(CompilerState.pos, 1)
            state = AddState(StateType.DOT, 0, 0)
            frag = FragAlloc()
            IfCondition NotEqual(frag, 0) ThenBlock: {
                StoreValue(frag, state)
                list = CreateList(state)
                StoreValue(Add(frag, 8), list)
            }
            ReturnValue(ParsePost(frag))
        }

        IfCondition EqualTo(ch, 94) ThenBlock: {
            CompilerState.pos = Add(CompilerState.pos, 1)
            state = AddState(StateType.ASSERT_START, 0, 0)
            frag = FragAlloc()
            IfCondition NotEqual(frag, 0) ThenBlock: {
                StoreValue(frag, state)
                list = CreateList(state)
                StoreValue(Add(frag, 8), list)
            }
            ReturnValue(frag)
        }

        IfCondition EqualTo(ch, 36) ThenBlock: {
            CompilerState.pos = Add(CompilerState.pos, 1)
            state = AddState(StateType.ASSERT_END, 0, 0)
            frag = FragAlloc()
            IfCondition NotEqual(frag, 0) ThenBlock: {
                StoreValue(frag, state)
                list = CreateList(state)
                StoreValue(Add(frag, 8), list)
            }
            ReturnValue(frag)
        }
        
        IfCondition EqualTo(ch, 40) ThenBlock: {
            CompilerState.pos = Add(CompilerState.pos, 1)
            sub = ParseAlt()
            IfCondition GreaterEqual(CompilerState.pos, CompilerState.len) ThenBlock: {
                CompilerState.error = 1
                ReturnValue(0)
            }
            ch = GetByte(CompilerState.pattern, CompilerState.pos)
            IfCondition NotEqual(ch, 41) ThenBlock: {
                CompilerState.error = 1
                ReturnValue(0)
            }
            CompilerState.pos = Add(CompilerState.pos, 1)
            ReturnValue(ParsePost(sub))
        }
        
        IfCondition EqualTo(ch, 91) ThenBlock: {
            ReturnValue(ParseClass())
        }
        
        IfCondition EqualTo(ch, 92) ThenBlock: {
            CompilerState.pos = Add(CompilerState.pos, 1)
            IfCondition GreaterEqual(CompilerState.pos, CompilerState.len) ThenBlock: {
                CompilerState.error = 1
                ReturnValue(0)
            }
            ch = GetByte(CompilerState.pattern, CompilerState.pos)
            CompilerState.pos = Add(CompilerState.pos, 1)
            
            IfCondition EqualTo(ch, 110) ThenBlock: { ch = 10 }
            IfCondition EqualTo(ch, 114) ThenBlock: { ch = 13 }
            IfCondition EqualTo(ch, 116) ThenBlock: { ch = 9 }
            
            state = AddState(StateType.CHAR, ch, 0)
            frag = FragAlloc()
            IfCondition NotEqual(frag, 0) ThenBlock: {
                StoreValue(frag, state)
                list = CreateList(state)
                StoreValue(Add(frag, 8), list)
            }
            ReturnValue(ParsePost(frag))
        }

        // Literal character
        CompilerState.pos = Add(CompilerState.pos, 1)
        state = AddState(StateType.CHAR, ch, 0)
        frag = FragAlloc()
        IfCondition NotEqual(frag, 0) ThenBlock: {
            StoreValue(frag, state)
            list = CreateList(state)
            StoreValue(Add(frag, 8), list)
        }
        ReturnValue(ParsePost(frag))
    }
}

Function.ParsePost {
    Input: atom: Address
    Output: Address
    Body: {
        IfCondition EqualTo(atom, 0) ThenBlock: {
            ReturnValue(0)
        }
        
        IfCondition GreaterEqual(CompilerState.pos, CompilerState.len) ThenBlock: {
            ReturnValue(atom)
        }
        
        ch = GetByte(CompilerState.pattern, CompilerState.pos)
        
        IfCondition EqualTo(ch, 42) ThenBlock: {
            CompilerState.pos = Add(CompilerState.pos, 1)
            split = AddState(StateType.SPLIT, 0, 0)
            atom_start = Dereference(atom)
            SetStateOut1(split, atom_start)
            atom_out = Dereference(Add(atom, 8))
            PatchList(atom_out, split)

            out = CreateList(split)
            SetListNext(out, 1)

            result = FragAlloc()
            IfCondition NotEqual(result, 0) ThenBlock: {
                StoreValue(result, split)
                StoreValue(Add(result, 8), out)
            }

            ReturnValue(result)
        }

        IfCondition EqualTo(ch, 43) ThenBlock: {
            CompilerState.pos = Add(CompilerState.pos, 1)
            split = AddState(StateType.SPLIT, 0, 0)
            atom_start = Dereference(atom)
            SetStateOut1(split, atom_start)
            atom_out = Dereference(Add(atom, 8))
            PatchList(atom_out, split)

            out = CreateList(split)
            SetListNext(out, 1)

            result = FragAlloc()
            IfCondition NotEqual(result, 0) ThenBlock: {
                StoreValue(result, atom_start)
                StoreValue(Add(result, 8), out)
            }

            ReturnValue(result)
        }

        IfCondition EqualTo(ch, 63) ThenBlock: {
            CompilerState.pos = Add(CompilerState.pos, 1)
            split = AddState(StateType.SPLIT, 0, 0)
            atom_start = Dereference(atom)
            SetStateOut1(split, atom_start)

            atom_out = Dereference(Add(atom, 8))
            split_out = CreateList(split)
            SetListNext(split_out, 1)

            out_list = MergeLists(atom_out, split_out)

            result = FragAlloc()
            IfCondition NotEqual(result, 0) ThenBlock: {
                StoreValue(result, split)
                StoreValue(Add(result, 8), out_list)
            }

            ReturnValue(result)
        }
        
        ReturnValue(atom)
    }
}

Function.ParseClass {
    Output: Address
    Body: {
        CompilerState.pos = Add(CompilerState.pos, 1)
        
        negated = 0
        ch = GetByte(CompilerState.pattern, CompilerState.pos)
        IfCondition EqualTo(ch, 94) ThenBlock: {
            negated = 1
            CompilerState.pos = Add(CompilerState.pos, 1)
        }
        
        bitmap = ClassAlloc()
        IfCondition EqualTo(bitmap, 0) ThenBlock: {
            CompilerState.error = 1
            ReturnValue(0)
        }

        // Initialize bitmap
        i = 0
        WhileLoop LessThan(i, 32) {
            SetByte(bitmap, i, 0)
            i = Add(i, 1)
        }
        
        // Walk class contents. Recognises ranges of the form X-Y where Y
        // is not ']', setting every byte in [X,Y] inclusive. A trailing
        // '-' before ']' is treated as a literal dash (POSIX behaviour).
        WhileLoop 1 {
            IfCondition GreaterEqual(CompilerState.pos, CompilerState.len) ThenBlock: {
                CompilerState.error = 1
                ReturnValue(0)
            }

            ch = GetByte(CompilerState.pattern, CompilerState.pos)

            IfCondition EqualTo(ch, 93) ThenBlock: {
                CompilerState.pos = Add(CompilerState.pos, 1)
                BreakLoop
            }

            CompilerState.pos = Add(CompilerState.pos, 1)

            // Peek: is this the start of a range (X-Y)?
            IfCondition LessThan(CompilerState.pos, CompilerState.len) ThenBlock: {
                peek = GetByte(CompilerState.pattern, CompilerState.pos)
                IfCondition EqualTo(peek, 45) ThenBlock: {
                    IfCondition LessThan(Add(CompilerState.pos, 1), CompilerState.len) ThenBlock: {
                        end_ch = GetByte(CompilerState.pattern, Add(CompilerState.pos, 1))
                        IfCondition NotEqual(end_ch, 93) ThenBlock: {
                            // Consume '-' and end byte, then fill bitmap.
                            CompilerState.pos = Add(CompilerState.pos, 2)
                            IfCondition LessEqual(ch, end_ch) ThenBlock: {
                                j = ch
                                WhileLoop LessEqual(j, end_ch) {
                                    SetBit(bitmap, j)
                                    j = Add(j, 1)
                                }
                            } ElseBlock: {
                                // Descending range: set both endpoints only.
                                SetBit(bitmap, ch)
                                SetBit(bitmap, end_ch)
                            }
                            ContinueLoop
                        }
                    }
                }
            }

            // Not a range — literal byte.
            SetBit(bitmap, ch)
        }
        
        state = AddState(StateType.RANGE, bitmap, negated)
        frag = FragAlloc()
        IfCondition NotEqual(frag, 0) ThenBlock: {
            StoreValue(frag, state)
            list = CreateList(state)
            StoreValue(Add(frag, 8), list)
        }
        ReturnValue(ParsePost(frag))
    }
}

// ============================================================================
// STATE MANAGEMENT - FIXED FOR 40-BYTE ALIGNMENT
// ============================================================================

Function.AddState {
    Input: type: Integer
    Input: data1: Integer
    Input: data2: Integer
    Output: Integer
    Body: {
        state_id = RegexState.num_states
        
        IfCondition GreaterEqual(state_id, RegexConstants.MAX_STATES) ThenBlock: {
            CompilerState.error = 1
            ReturnValue(-1)
        }
        
        IfCondition EqualTo(RegexState.states, 0) ThenBlock: {
            ReturnValue(-1)
        }
        
        offset = Multiply(state_id, RegexConstants.STATE_SIZE)
        base = Add(RegexState.states, offset)
        
        // Proper 8-byte aligned offsets
        StoreValue(base, type)              // offset 0
        StoreValue(Add(base, 8), data1)     // offset 8
        StoreValue(Add(base, 16), data2)    // offset 16
        StoreValue(Add(base, 24), -1)       // offset 24 (out1)
        StoreValue(Add(base, 32), -1)       // offset 32 (out2)
        
        RegexState.num_states = Add(state_id, 1)
        ReturnValue(state_id)
    }
}

Function.GetStateType {
    Input: states: Address
    Input: state_id: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(state_id, 0) ThenBlock: {
            ReturnValue(-1)
        }
        offset = Multiply(state_id, RegexConstants.STATE_SIZE)
        ReturnValue(Dereference(Add(states, offset)))
    }
}

Function.SetStateOut1 {
    Input: state_id: Integer
    Input: target: Integer
    Body: {
        offset = Multiply(state_id, RegexConstants.STATE_SIZE)
        base = Add(RegexState.states, offset)
        StoreValue(Add(base, 24), target)
    }
}

Function.SetStateOut2 {
    Input: state_id: Integer
    Input: target: Integer
    Body: {
        offset = Multiply(state_id, RegexConstants.STATE_SIZE)
        base = Add(RegexState.states, offset)
        StoreValue(Add(base, 32), target)
    }
}

// ============================================================================
// LIST MANAGEMENT
// ============================================================================

// List node layout (24 bytes):
//   offset  0: state_id     (8 bytes)
//   offset  8: next pointer (8 bytes)
//   offset 16: is_out2 flag (8 bytes)
//
// Fix (April 2026): previous layout stored is_out2 at offset 12 with
// StoreValue (which writes 8 bytes), so bytes 12-19 were written into
// a 16-byte allocation — a 4-byte OOB write that also clobbered the
// 'next' pointer's upper half. PatchList then read `is_out2` from
// offset 12 and got junk, corrupting NFA traversal on any post
// operator (* + ?) and segfaulting Regex_Compile on simple patterns
// like "a*".
Function.CreateList {
    Input: state_id: Integer
    Output: Address
    Body: {
        list = ListAlloc()
        IfCondition NotEqual(list, 0) ThenBlock: {
            StoreValue(list, state_id)
            StoreValue(Add(list, 8), 0)
            StoreValue(Add(list, 16), 0)
        }
        ReturnValue(list)
    }
}

Function.SetListNext {
    Input: list: Address
    Input: is_out2: Integer
    Body: {
        IfCondition NotEqual(list, 0) ThenBlock: {
            StoreValue(Add(list, 16), is_out2)
        }
    }
}

Function.MergeLists {
    Input: list1: Address
    Input: list2: Address
    Output: Address
    Body: {
        IfCondition EqualTo(list1, 0) ThenBlock: {
            ReturnValue(list2)
        }
        IfCondition EqualTo(list2, 0) ThenBlock: {
            ReturnValue(list1)
        }
        
        current = list1
        WhileLoop 1 {
            next = Dereference(Add(current, 8))
            IfCondition EqualTo(next, 0) ThenBlock: {
                StoreValue(Add(current, 8), list2)
                BreakLoop
            }
            current = next
        }
        
        ReturnValue(list1)
    }
}

Function.PatchList {
    Input: list: Address
    Input: target: Integer
    Body: {
        WhileLoop NotEqual(list, 0) {
            state_id = Dereference(list)
            is_out2 = Dereference(Add(list, 16))
            
            offset = Multiply(state_id, RegexConstants.STATE_SIZE)
            state = Add(RegexState.states, offset)
            
            IfCondition EqualTo(is_out2, 0) ThenBlock: {
                out1 = Dereference(Add(state, 24))
                IfCondition EqualTo(out1, -1) ThenBlock: {
                    StoreValue(Add(state, 24), target)
                }
            } ElseBlock: {
                out2 = Dereference(Add(state, 32))
                IfCondition EqualTo(out2, -1) ThenBlock: {
                    StoreValue(Add(state, 32), target)
                }
            }
            
            list = Dereference(Add(list, 8))
        }
    }
}

// ============================================================================
// THREAD MANAGEMENT
// ============================================================================

Function.AddThread {
    Input: state_id: Integer
    Input: pos: Integer
    Input: captures: Address
    Body: {
        IfCondition GreaterEqual(MatchState.thread_count, RegexConstants.MAX_THREADS) ThenBlock: {
            ReturnValue(0)
        }
        
        // Check for duplicate threads
        i = 0
        WhileLoop LessThan(i, MatchState.thread_count) {
            thread = GetThread(i)
            IfCondition EqualTo(Dereference(thread), state_id) ThenBlock: {
                ReturnValue(0)
            }
            i = Add(i, 1)
        }
        
        thread = GetThread(MatchState.thread_count)
        StoreValue(thread, state_id)
        StoreValue(Add(thread, 8), pos)
        
        MatchState.thread_count = Add(MatchState.thread_count, 1)
        ReturnValue(1)
    }
}

Function.GetThread {
    Input: index: Integer
    Output: Address
    Body: {
        offset = Multiply(index, MatchState.thread_size)
        ReturnValue(Add(MatchState.threads, offset))
    }
}

Function.ProcessState {
    Input: states: Address
    Input: state_id: Integer
    Input: ch: Integer
    Input: thread: Address
    Output: Integer
    Body: {
        IfCondition LessThan(state_id, 0) ThenBlock: {
            ReturnValue(0)
        }

        offset = Multiply(state_id, RegexConstants.STATE_SIZE)
        state = Add(states, offset)

        type = Dereference(state)
        data1 = Dereference(Add(state, 8))
        data2 = Dereference(Add(state, 16))
        out1 = Dereference(Add(state, 24))
        out2 = Dereference(Add(state, 32))

        IfCondition EqualTo(type, StateType.CHAR) ThenBlock: {
            IfCondition EqualTo(data1, ch) ThenBlock: {
                AddNextThread(out1, Add(MatchState.pos, 1), thread)
            }
            ReturnValue(0)
        }

        IfCondition EqualTo(type, StateType.RANGE) ThenBlock: {
            hit = TestBit(data1, ch)
            IfCondition EqualTo(data2, 1) ThenBlock: {
                hit = Not2(hit)
            }
            IfCondition NotEqual(hit, 0) ThenBlock: {
                AddNextThread(out1, Add(MatchState.pos, 1), thread)
            }
            ReturnValue(0)
        }

        IfCondition EqualTo(type, StateType.DOT) ThenBlock: {
            IfCondition NotEqual(ch, 10) ThenBlock: {
                AddNextThread(out1, Add(MatchState.pos, 1), thread)
            }
            ReturnValue(0)
        }

        IfCondition EqualTo(type, StateType.SPLIT) ThenBlock: {
            AddThread(out1, MatchState.pos, thread)
            IfCondition NotEqual(out2, -1) ThenBlock: {
                AddThread(out2, MatchState.pos, thread)
            }
            ReturnValue(0)
        }

        IfCondition EqualTo(type, StateType.MATCH) ThenBlock: {
            ReturnValue(1)
        }

        IfCondition EqualTo(type, StateType.EMPTY) ThenBlock: {
            AddThread(out1, MatchState.pos, thread)
            ReturnValue(0)
        }

        IfCondition EqualTo(type, StateType.ASSERT_START) ThenBlock: {
            IfCondition EqualTo(MatchState.pos, 0) ThenBlock: {
                AddThread(out1, MatchState.pos, thread)
            }
            ReturnValue(0)
        }

        IfCondition EqualTo(type, StateType.ASSERT_END) ThenBlock: {
            IfCondition EqualTo(MatchState.pos, MatchState.text_len) ThenBlock: {
                AddThread(out1, MatchState.pos, thread)
            }
            ReturnValue(0)
        }

        ReturnValue(0)
    }
}

Function.AddNextThread {
    Input: state_id: Integer
    Input: pos: Integer
    Input: captures: Address
    Body: {
        IfCondition GreaterEqual(MatchState.next_count, RegexConstants.MAX_THREADS) ThenBlock: {
            ReturnValue(0)
        }
        
        // Check for duplicate threads
        i = 0
        WhileLoop LessThan(i, MatchState.next_count) {
            thread = GetNextThread(i)
            IfCondition EqualTo(Dereference(thread), state_id) ThenBlock: {
                ReturnValue(0)
            }
            i = Add(i, 1)
        }
        
        thread = GetNextThread(MatchState.next_count)
        StoreValue(thread, state_id)
        StoreValue(Add(thread, 8), pos)
        
        MatchState.next_count = Add(MatchState.next_count, 1)
        ReturnValue(1)
    }
}

Function.GetNextThread {
    Input: index: Integer
    Output: Address
    Body: {
        offset = Multiply(index, MatchState.thread_size)
        ReturnValue(Add(MatchState.next_threads, offset))
    }
}

// ============================================================================
// BIT OPERATIONS
// ============================================================================

Function.SetBit {
    Input: bitmap: Address
    Input: bit: Integer
    Body: {
        IfCondition GreaterEqual(bit, 256) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition LessThan(bit, 0) ThenBlock: {
            ReturnValue(0)
        }
        
        byte_offset = Divide(bit, 8)
        bit_offset = Modulo(bit, 8)
        byte_val = GetByte(bitmap, byte_offset)
        mask = LeftShift(1, bit_offset)
        SetByte(bitmap, byte_offset, BitwiseOr(byte_val, mask))
        ReturnValue(1)
    }
}

Function.TestBit {
    Input: bitmap: Address
    Input: bit: Integer
    Output: Integer
    Body: {
        IfCondition GreaterEqual(bit, 256) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition LessThan(bit, 0) ThenBlock: {
            ReturnValue(0)
        }
        
        byte_offset = Divide(bit, 8)
        bit_offset = Modulo(bit, 8)
        byte_val = GetByte(bitmap, byte_offset)
        mask = LeftShift(1, bit_offset)
        ReturnValue(BitwiseAnd(byte_val, mask))
    }
}

Function.Not2 {
    Input: val: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(val, 0) ThenBlock: {
            ReturnValue(1)
        }
        ReturnValue(0)
    }
}

// ============================================================================
// LAZY DFA
// ============================================================================
// Converts the Thompson NFA to a lazily-constructed DFA for unanchored
// matching. A "DFA state" is a canonicalized NFA state set (bitset of
// 4096 bits = 512 bytes), interned in `DFA.sets_buf`. For each DFA state
// a 256-entry transition table (`DFA.trans_buf`) caches the resulting
// DFA state ID on input byte b — computed on first encounter, reused
// forever after. An "accept" flag (`DFA.match_buf`) marks DFA states
// whose NFA state set contains StateType.MATCH so the driver can return
// on transition into one.
//
// Unanchored semantics: after moving on byte b we union the start
// state's epsilon-closure into the new set before interning, so any
// text position is a valid match start. We do this by keeping
// `DFA.start_closure` — computed once per DFA_Init — and OR-ing it
// into the scratch bitset on every transition.
//
// Caveats / bailouts:
//   * If the compiled regex contains ASSERT_START or ASSERT_END, we
//     bail — positional semantics can't be DFA'd without specializing
//     by position. Caller falls back to Regex_Search.
//   * If we exceed DFA.cap DFA states during lazy construction
//     (pathological pattern), we set DFA.overflow=1 and bail. Caller
//     falls back to Regex_Search for the current line and all further
//     lines until DFA_Init is called again.

FixedPool.DFA {
    "cap":           Initialize=1024            // max DFA states
    "count":         Initialize=0,   CanChange=True
    "set_size":      Initialize=512             // 4096 bits / 8
    "sets_buf":      Initialize=0,   CanChange=True
    "trans_buf":     Initialize=0,   CanChange=True
    "match_buf":     Initialize=0,   CanChange=True
    "scratch_set":   Initialize=0,   CanChange=True
    "start_closure": Initialize=0,   CanChange=True
    "regex":         Initialize=0,   CanChange=True
    "overflow":      Initialize=0,   CanChange=True
}

// === bitset helpers ===

Function.DFA_GetSet {
    Input: id: Integer
    Output: Address
    Body: {
        ReturnValue(Add(DFA.sets_buf, Multiply(id, DFA.set_size)))
    }
}

Function.DFA_GetTrans {
    Input: id: Integer
    Output: Address
    Body: {
        ReturnValue(Add(DFA.trans_buf, Multiply(id, 2048)))
    }
}

Function.DFA_ClearSet {
    Input: bs: Address
    Body: {
        i = 0
        WhileLoop LessThan(i, DFA.set_size) {
            SetByte(bs, i, 0)
            i = Add(i, 1)
        }
    }
}

Function.DFA_SetBit {
    Input: bs: Address
    Input: state_id: Integer
    Body: {
        byte_off = Divide(state_id, 8)
        bit_off  = Modulo(state_id, 8)
        v = GetByte(bs, byte_off)
        mask = LeftShift(1, bit_off)
        SetByte(bs, byte_off, BitwiseOr(v, mask))
    }
}

Function.DFA_TestBit {
    Input: bs: Address
    Input: state_id: Integer
    Output: Integer
    Body: {
        byte_off = Divide(state_id, 8)
        bit_off  = Modulo(state_id, 8)
        v = GetByte(bs, byte_off)
        mask = LeftShift(1, bit_off)
        ReturnValue(BitwiseAnd(v, mask))
    }
}

Function.DFA_CopySet {
    Input: dst: Address
    Input: src: Address
    Body: {
        i = 0
        WhileLoop LessThan(i, DFA.set_size) {
            SetByte(dst, i, GetByte(src, i))
            i = Add(i, 1)
        }
    }
}

Function.DFA_UnionSet {
    Input: dst: Address
    Input: src: Address
    Body: {
        i = 0
        WhileLoop LessThan(i, DFA.set_size) {
            SetByte(dst, i, BitwiseOr(GetByte(dst, i), GetByte(src, i)))
            i = Add(i, 1)
        }
    }
}

Function.DFA_SetsEqual {
    Input: a: Address
    Input: b: Address
    Output: Integer
    Body: {
        i = 0
        WhileLoop LessThan(i, DFA.set_size) {
            IfCondition NotEqual(GetByte(a, i), GetByte(b, i)) ThenBlock: {
                ReturnValue(0)
            }
            i = Add(i, 1)
        }
        ReturnValue(1)
    }
}

// === epsilon closure over an NFA state set (in-place) ===
// Expands SPLIT/EMPTY states: any bit set that names a SPLIT state
// also sets the bits for out1/out2; any EMPTY sets the bit for out1.
// Keep iterating over all 4096 bits until a full pass adds nothing.
Function.DFA_EpsilonClose {
    Input: bs: Address
    Body: {
        states = RegexState.states
        num_states = RegexState.num_states
        changed = 1
        WhileLoop EqualTo(changed, 1) {
            changed = 0
            sid = 0
            WhileLoop LessThan(sid, num_states) {
                IfCondition NotEqual(DFA_TestBit(bs, sid), 0) ThenBlock: {
                    offset = Multiply(sid, RegexConstants.STATE_SIZE)
                    t = Dereference(Add(states, offset))
                    IfCondition EqualTo(t, StateType.SPLIT) ThenBlock: {
                        o1 = Dereference(Add(Add(states, offset), 24))
                        o2 = Dereference(Add(Add(states, offset), 32))
                        IfCondition GreaterEqual(o1, 0) ThenBlock: {
                            IfCondition EqualTo(DFA_TestBit(bs, o1), 0) ThenBlock: {
                                DFA_SetBit(bs, o1)
                                changed = 1
                            }
                        }
                        IfCondition GreaterEqual(o2, 0) ThenBlock: {
                            IfCondition EqualTo(DFA_TestBit(bs, o2), 0) ThenBlock: {
                                DFA_SetBit(bs, o2)
                                changed = 1
                            }
                        }
                    }
                    IfCondition EqualTo(t, StateType.EMPTY) ThenBlock: {
                        o1 = Dereference(Add(Add(states, offset), 24))
                        IfCondition GreaterEqual(o1, 0) ThenBlock: {
                            IfCondition EqualTo(DFA_TestBit(bs, o1), 0) ThenBlock: {
                                DFA_SetBit(bs, o1)
                                changed = 1
                            }
                        }
                    }
                }
                sid = Add(sid, 1)
            }
        }
    }
}

// Compute `DFA.match_buf[id]` — 1 if the set contains any MATCH state.
Function.DFA_SetHasMatch {
    Input: bs: Address
    Output: Integer
    Body: {
        states = RegexState.states
        num_states = RegexState.num_states
        sid = 0
        WhileLoop LessThan(sid, num_states) {
            IfCondition NotEqual(DFA_TestBit(bs, sid), 0) ThenBlock: {
                offset = Multiply(sid, RegexConstants.STATE_SIZE)
                t = Dereference(Add(states, offset))
                IfCondition EqualTo(t, StateType.MATCH) ThenBlock: {
                    ReturnValue(1)
                }
            }
            sid = Add(sid, 1)
        }
        ReturnValue(0)
    }
}

// Intern a (canonicalized, epsilon-closed) bitset as a DFA state.
// Returns existing DFA state ID if the set already exists; otherwise
// allocates a new one (copies bs into sets_buf, initializes trans row
// to all -1, sets match flag). Returns -1 on cap overflow.
Function.DFA_InternSet {
    Input: bs: Address
    Output: Integer
    Body: {
        // Linear probe for existing state. Cap=1024; in practice the
        // count stays small so this is cheap per-miss and free per-hit
        // after the first occurrence.
        i = 0
        WhileLoop LessThan(i, DFA.count) {
            existing = DFA_GetSet(i)
            IfCondition EqualTo(DFA_SetsEqual(existing, bs), 1) ThenBlock: {
                ReturnValue(i)
            }
            i = Add(i, 1)
        }

        IfCondition GreaterEqual(DFA.count, DFA.cap) ThenBlock: {
            DFA.overflow = 1
            ReturnValue(-1)
        }

        new_id = DFA.count
        DFA_CopySet(DFA_GetSet(new_id), bs)

        // Init transitions row to -1.
        trans = DFA_GetTrans(new_id)
        j = 0
        WhileLoop LessThan(j, 256) {
            StoreValue(Add(trans, Multiply(j, 8)), -1)
            j = Add(j, 1)
        }

        // Has-match flag.
        SetByte(DFA.match_buf, new_id, DFA_SetHasMatch(bs))

        DFA.count = Add(DFA.count, 1)
        ReturnValue(new_id)
    }
}

// Compute transition from DFA state `from_id` on input byte `b`.
// Stores result in transitions table. Returns new DFA state id, or
// -1 on overflow.
Function.DFA_ComputeTransition {
    Input: from_id: Integer
    Input: b: Integer
    Output: Integer
    Body: {
        DFA_ClearSet(DFA.scratch_set)

        // Apply byte-consuming transitions for each NFA state in from.
        from_set = DFA_GetSet(from_id)
        states = RegexState.states
        num_states = RegexState.num_states
        sid = 0
        WhileLoop LessThan(sid, num_states) {
            IfCondition NotEqual(DFA_TestBit(from_set, sid), 0) ThenBlock: {
                offset = Multiply(sid, RegexConstants.STATE_SIZE)
                t     = Dereference(Add(states, offset))
                data1 = Dereference(Add(Add(states, offset), 8))
                data2 = Dereference(Add(Add(states, offset), 16))
                o1    = Dereference(Add(Add(states, offset), 24))

                matched = 0
                IfCondition EqualTo(t, StateType.CHAR) ThenBlock: {
                    IfCondition EqualTo(data1, b) ThenBlock: { matched = 1 }
                }
                IfCondition EqualTo(t, StateType.RANGE) ThenBlock: {
                    hit = TestBit(data1, b)
                    IfCondition EqualTo(data2, 1) ThenBlock: { hit = Not2(hit) }
                    IfCondition NotEqual(hit, 0) ThenBlock: { matched = 1 }
                }
                IfCondition EqualTo(t, StateType.DOT) ThenBlock: {
                    IfCondition NotEqual(b, 10) ThenBlock: { matched = 1 }
                }

                IfCondition And(EqualTo(matched, 1), GreaterEqual(o1, 0)) ThenBlock: {
                    DFA_SetBit(DFA.scratch_set, o1)
                }
            }
            sid = Add(sid, 1)
        }

        // Unanchored semantics: keep start_closure alive at every pos.
        DFA_UnionSet(DFA.scratch_set, DFA.start_closure)

        // Epsilon-close, intern, remember in transitions table.
        DFA_EpsilonClose(DFA.scratch_set)
        new_id = DFA_InternSet(DFA.scratch_set)

        trans = DFA_GetTrans(from_id)
        StoreValue(Add(trans, Multiply(b, 8)), new_id)
        ReturnValue(new_id)
    }
}

// Detect whether the regex contains any ASSERT_START/ASSERT_END
// states — if so, bail out of DFA construction.
Function.DFA_HasAssertions {
    Output: Integer
    Body: {
        states = RegexState.states
        num_states = RegexState.num_states
        sid = 0
        WhileLoop LessThan(sid, num_states) {
            offset = Multiply(sid, RegexConstants.STATE_SIZE)
            t = Dereference(Add(states, offset))
            IfCondition EqualTo(t, StateType.ASSERT_START) ThenBlock: { ReturnValue(1) }
            IfCondition EqualTo(t, StateType.ASSERT_END) ThenBlock: { ReturnValue(1) }
            sid = Add(sid, 1)
        }
        ReturnValue(0)
    }
}

// Initialize DFA for a given compiled regex. Returns 1 on success,
// 0 if the regex has assertions (caller must fall back to Regex_Search).
Function.Regex_DFAInit {
    Input: regex: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(regex, 0) ThenBlock: { ReturnValue(0) }

        // Publish states/num_states into RegexState so the helpers
        // above can walk them without taking handle args.
        RegexState.states     = Dereference(regex)
        RegexState.num_states = Dereference(Add(regex, 8))
        start_state           = Dereference(Add(regex, 16))

        IfCondition EqualTo(DFA_HasAssertions(), 1) ThenBlock: { ReturnValue(0) }

        // Lazy-allocate on first DFA init. Buffers are reused across
        // subsequent Regex_DFAInit calls for different regexes.
        IfCondition EqualTo(DFA.sets_buf, 0) ThenBlock: {
            DFA.sets_buf    = Allocate(Multiply(DFA.cap, DFA.set_size))
            IfCondition EqualTo(DFA.sets_buf, 0) ThenBlock: { ReturnValue(0) }
        }
        IfCondition EqualTo(DFA.trans_buf, 0) ThenBlock: {
            DFA.trans_buf   = Allocate(Multiply(DFA.cap, 2048))
            IfCondition EqualTo(DFA.trans_buf, 0) ThenBlock: { ReturnValue(0) }
        }
        IfCondition EqualTo(DFA.match_buf, 0) ThenBlock: {
            DFA.match_buf   = Allocate(DFA.cap)
            IfCondition EqualTo(DFA.match_buf, 0) ThenBlock: { ReturnValue(0) }
        }
        IfCondition EqualTo(DFA.scratch_set, 0) ThenBlock: {
            DFA.scratch_set = Allocate(DFA.set_size)
            IfCondition EqualTo(DFA.scratch_set, 0) ThenBlock: { ReturnValue(0) }
        }
        IfCondition EqualTo(DFA.start_closure, 0) ThenBlock: {
            DFA.start_closure = Allocate(DFA.set_size)
            IfCondition EqualTo(DFA.start_closure, 0) ThenBlock: { ReturnValue(0) }
        }

        DFA.count    = 0
        DFA.overflow = 0
        DFA.regex    = regex

        // Build start closure: epsilon-closure of {start_state}.
        DFA_ClearSet(DFA.start_closure)
        DFA_SetBit(DFA.start_closure, start_state)
        DFA_EpsilonClose(DFA.start_closure)

        // State 0 = the start closure (unanchored, so start state is
        // already included every byte).
        DFA_CopySet(DFA.scratch_set, DFA.start_closure)
        initial_id = DFA_InternSet(DFA.scratch_set)
        IfCondition LessThan(initial_id, 0) ThenBlock: { ReturnValue(0) }

        ReturnValue(1)
    }
}

// Unanchored single-pass search via lazy DFA. Returns 1 if the regex
// matches anywhere in `text[0..text_len)`, 0 otherwise. Caller must
// have already called Regex_DFAInit on this regex. On DFA overflow
// this function returns -1 — caller should fall back to Regex_Search.
//
// Hot-loop perf: DFA_GetTrans/DFA_GetSet etc. are inlined here
// (trans_base is the raw byte address of the transitions table, and
// `trans_base + (cur * 2048) + (b * 8)` is the transition slot) so
// the per-byte path is one Dereference + one GetByte + a conditional.
// This eliminated ~50ns of AILANG function-call overhead that
// dominated the old per-byte cost on long inputs.
Function.Regex_DFASearch {
    Input: text: Address
    Input: text_len: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(text, 0) ThenBlock: { ReturnValue(0) }

        trans_base = DFA.trans_buf
        match_base = DFA.match_buf

        // State 0 is always the start closure (built in Regex_DFAInit).
        cur = 0
        IfCondition NotEqual(GetByte(match_base, cur), 0) ThenBlock: {
            ReturnValue(1)
        }

        i = 0
        WhileLoop LessThan(i, text_len) {
            b = GetByte(text, i)
            slot = Add(Add(trans_base, Multiply(cur, 2048)), Multiply(b, 8))
            next_id = Dereference(slot)
            IfCondition LessThan(next_id, 0) ThenBlock: {
                next_id = DFA_ComputeTransition(cur, b)
                IfCondition LessThan(next_id, 0) ThenBlock: {
                    ReturnValue(-1)
                }
                // trans_buf may have been reallocated on growth
                // (it isn't today, but keep this defensive reload so
                // the invariant holds if cap ever becomes dynamic).
                trans_base = DFA.trans_buf
                match_base = DFA.match_buf
            }
            cur = next_id
            IfCondition NotEqual(GetByte(match_base, cur), 0) ThenBlock: {
                ReturnValue(1)
            }
            i = Add(i, 1)
        }

        ReturnValue(0)
    }
}