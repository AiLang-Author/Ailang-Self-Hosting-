    "grey":        Initialize=0xFF808080
    "silver":      Initialize=0xFFC0C0C0
    "maroon":      Initialize=0xFF800000
    "navy":        Initialize=0xFF000080
    "teal":        Initialize=0xFF008080
    "olive":       Initialize=0xFF808000
    "lime":        Initialize=0xFF00FF00
    "aqua":        Initialize=0xFF00FFFF
    "fuchsia":     Initialize=0xFFFF00FF
    "brown":       Initialize=0xFFA52A2A
    "gold":        Initialize=0xFFFFD700
    "salmon":      Initialize=0xFFFA8072
    "crimson":     Initialize=0xFFDC143C
    "tomato":      Initialize=0xFFFF6347
    "coral":       Initialize=0xFFFF7F50
    "indianred":   Initialize=0xFFCD5C5C
    "darkred":     Initialize=0xFF8B0000
    "darkblue":    Initialize=0xFF00008B
    "darkgreen":   Initialize=0xFF006400
    "darkgray":    Initialize=0xFFA9A9A9
    "darkgrey":    Initialize=0xFFA9A9A9
    "lightblue":   Initialize=0xFFADD8E6
    "lightcoral":  Initialize=0xFFF08080
    "lightcyan":   Initialize=0xFFE0FFFF
    "lightgray":   Initialize=0xFFD3D3D3
    "lightgrey":   Initialize=0xFFD3D3D3
    "lightgreen":  Initialize=0xFF90EE90
    "lightyellow": Initialize=0xFFFFFFE0
    "lightpink":   Initialize=0xFFFFB6C1
