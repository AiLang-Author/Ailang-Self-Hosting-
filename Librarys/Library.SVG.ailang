    "indigo":         Initialize=0xFF4B0082
    "skyblue":        Initialize=0xFF87CEEB
    "turquoise":      Initialize=0xFF40E0D0
    "pink":           Initialize=0xFFFFC0CB
    "transparent": Initialize=0x00000000
    "none":        Initialize=0x00000000
}

// =============================================================================
// PARSER STATE
// =============================================================================
FixedPool.SVGParse {
    "data":       Initialize=0, CanChange=True    // Source SVG bytes
    "size":       Initialize=0, CanChange=True    // Source length
    "pos":        Initialize=0, CanChange=True    // Current parse position
    "error":      Initialize=0, CanChange=True    // Error flag
}

// Render target state
FixedPool.SVGState {
    "surf":       Initialize=0, CanChange=True    // Target surface address
    "surf_w":     Initialize=0, CanChange=True    // Surface width (pixels)
    "surf_h":     Initialize=0, CanChange=True    // Surface height (pixels)
    "vb_x":       Initialize=0, CanChange=True    // viewBox X (256× fp)
    "vb_y":       Initialize=0, CanChange=True    // viewBox Y (256× fp)
    "vb_w":       Initialize=0, CanChange=True    // viewBox W (256× fp)
    "vb_h":       Initialize=0, CanChange=True    // viewBox H (256× fp)
    "elem_count": Initialize=0, CanChange=True    // Elements processed
}

// Current element scratch
FixedPool.SVGElem {
    "tag":        Initialize=0, CanChange=True    // Tag name string (Address)
    "tag_len":    Initialize=0, CanChange=True    // Tag name length
    "self_close": Initialize=0, CanChange=True    // 1 if self-closing <tag/>
    "is_close":   Initialize=0, CanChange=True    // 1 if closing </tag>
    "attr_count": Initialize=0, CanChange=True    // Number of attributes
    "attr_keys":  Initialize=0, CanChange=True    // Address of keys array
    "attr_vals":  Initialize=0, CanChange=True    // Address of values array
}

// Transform stack
FixedPool.SVGXform {
    "stack":  Initialize=0, CanChange=True    // Address of matrix stack
    "depth":  Initialize=0, CanChange=True    // Current nesting depth
}

// Gradient table
FixedPool.SVGGradTable {
    "data":   Initialize=0, CanChange=True    // Address of gradient entries
    "count":  Initialize=0, CanChange=True    // Number of gradients stored
}

// Gradient entry field offsets (96 bytes per entry)
//   [0]  type: 0=linear, 1=radial
//   [8]  x1 (256× fp)   [16] y1   [24] x2/fx   [32] y2/fy   [40] r (radial only)
//   [48] stop_count
//   [56] color0 (packed ARGB)   [64] color1 (packed ARGB)
//   [72] id_hash
//   [80] units: 0=objectBoundingBox, 1=userSpaceOnUse
//   [88] reserved
FixedPool.SVGGradField {
    "TYPE":       Initialize=0
    "X1":         Initialize=8
    "Y1":         Initialize=16
    "X2":         Initialize=24
    "Y2":         Initialize=32
    "R":          Initialize=40
    "STOP_COUNT": Initialize=48
    "COLOR0":     Initialize=56
    "COLOR1":     Initialize=64
    "ID_HASH":    Initialize=72
    "UNITS":      Initialize=80
}

// Defs parsing state — tracks whether we're inside <defs>
FixedPool.SVGDefsState {
    "inside":       Initialize=0, CanChange=True    // 1 when inside <defs>
    "in_gradient":  Initialize=0, CanChange=True    // 1 when inside <linearGradient>/<radialGradient>
    "cur_grad_idx": Initialize=-1, CanChange=True   // Current gradient index being built
}

// Text rendering state
FixedPool.SVGTextState {
    "font_inst":  Initialize=0, CanChange=True    // Current VIF font instance handle
    "font_face":  Initialize=0, CanChange=True    // Current VIF font face handle
    "font_size":  Initialize=16, CanChange=True   // Current font size in pixels
}

// Path parser state
FixedPool.SVGPath {
    "cmds":     Initialize=0, CanChange=True    // Command buffer (Address)
    "cmd_count":Initialize=0, CanChange=True    // Number of commands
    "cur_x":    Initialize=0, CanChange=True    // Current X (256× fp)
    "cur_y":    Initialize=0, CanChange=True    // Current Y (256× fp)
    "start_x":  Initialize=0, CanChange=True    // Subpath start X
    "start_y":  Initialize=0, CanChange=True    // Subpath start Y
    "last_cpx": Initialize=0, CanChange=True    // Last control point X (for S/T)
    "last_cpy": Initialize=0, CanChange=True    // Last control point Y (for S/T)
    "has_cp":   Initialize=0, CanChange=True    // Has previous control point
    "tmp_y2":   Initialize=0, CanChange=True    // 7th param workaround for PathAddCmd
}

// Path command field offsets (within CMD_ENTRY_SIZE = 64 bytes)
FixedPool.SVGPCmd {
    "TYPE": Initialize=0     // Command type: M L C Q Z
    "X0":   Initialize=8     // Param 0 (or endpoint X for L/M)
    "Y0":   Initialize=16    // Param 1 (or endpoint Y for L/M)
    "X1":   Initialize=24    // Control point 1 X (C/Q)
    "Y1":   Initialize=32    // Control point 1 Y (C/Q)
    "X2":   Initialize=40    // Control point 2 X (C only)
    "Y2":   Initialize=48    // Control point 2 Y (C only)
}

// Command type constants
FixedPool.SVGCmdType {
    "MOVE":    Initialize=77    // 'M'
    "LINE":    Initialize=76    // 'L'
    "CUBIC":   Initialize=67    // 'C'
    "QUAD":    Initialize=81    // 'Q'
    "CLOSE":   Initialize=90    // 'Z'
}

// =============================================================================
// SVG INIT / SHUTDOWN
// =============================================================================
Function.SVG_Init {
    Output: Integer
    Body: {
        // Allocate tag name buffer
        tag_buf = Allocate(256)
        IfCondition EqualTo(tag_buf, 0) ThenBlock: {
            PrintMessage("[SVG] tag alloc fail\n")
            ReturnValue(0)
        }
        SVGElem.tag = tag_buf

        // Allocate attribute key/value arrays
        // 32 keys × 64 bytes each = 2048
        ak = Allocate(2048)
        IfCondition EqualTo(ak, 0) ThenBlock: {
            PrintMessage("[SVG] attr key alloc fail\n")
            ReturnValue(0)
        }
        SVGElem.attr_keys = ak

        // 32 values × 512 bytes each = 16384
        av = Allocate(16384)
        IfCondition EqualTo(av, 0) ThenBlock: {
            PrintMessage("[SVG] attr val alloc fail\n")
            ReturnValue(0)
        }
        SVGElem.attr_vals = av

        // Allocate transform stack: 32 levels × 48 bytes = 1536
        xs = Allocate(1536)
        IfCondition EqualTo(xs, 0) ThenBlock: {
            PrintMessage("[SVG] xform alloc fail\n")
            ReturnValue(0)
        }
        SVGXform.stack = xs
        SVGXform.depth = 0

        // Initialize identity transform at level 0
        // [a=256 b=0 c=0 d=256 e=0 f=0] (256× fp identity)
        StoreValue(Add(xs, 0), 256)
        StoreValue(Add(xs, 8), 0)
        StoreValue(Add(xs, 16), 0)
        StoreValue(Add(xs, 24), 256)
        StoreValue(Add(xs, 32), 0)
        StoreValue(Add(xs, 40), 0)

        // Allocate gradient table: 64 entries × 96 bytes = 6144
        gt = Allocate(6144)
        IfCondition EqualTo(gt, 0) ThenBlock: {
            PrintMessage("[SVG] grad alloc fail\n")
            ReturnValue(0)
        }
        MemorySet(gt, 0, 6144)
        SVGGradTable.data = gt
        SVGGradTable.count = 0

        // Allocate path command buffer: 4096 × 64 bytes = 262144
        pc = Allocate(262144)
        IfCondition EqualTo(pc, 0) ThenBlock: {
            PrintMessage("[SVG] path alloc fail\n")
            ReturnValue(0)
        }
        SVGPath.cmds = pc

        PrintMessage("[SVG] init ok\n")
        ReturnValue(1)
    }
}

Function.SVG_Shutdown {
    Body: {
        IfCondition NotEqual(SVGElem.tag, 0) ThenBlock: {
            Deallocate(SVGElem.tag, 256)
            SVGElem.tag = 0
        }
        IfCondition NotEqual(SVGElem.attr_keys, 0) ThenBlock: {
            Deallocate(SVGElem.attr_keys, 2048)
            SVGElem.attr_keys = 0
        }
        IfCondition NotEqual(SVGElem.attr_vals, 0) ThenBlock: {
            Deallocate(SVGElem.attr_vals, 16384)
            SVGElem.attr_vals = 0
        }
        IfCondition NotEqual(SVGXform.stack, 0) ThenBlock: {
            Deallocate(SVGXform.stack, 1536)
            SVGXform.stack = 0
        }
        IfCondition NotEqual(SVGGradTable.data, 0) ThenBlock: {
            Deallocate(SVGGradTable.data, 6144)
            SVGGradTable.data = 0
        }
        IfCondition NotEqual(SVGPath.cmds, 0) ThenBlock: {
            Deallocate(SVGPath.cmds, 262144)
            SVGPath.cmds = 0
        }
        PrintMessage("[SVG] shutdown ok\n")
        ReturnValue(0)
    }
}

// =============================================================================
// XML TOKENIZER — BYTE-BY-BYTE
// =============================================================================

// SVG_PeekByte: look at current byte without advancing
Function.SVG_PeekByte {
    Output: Integer
    Body: {
        p = SVGParse.pos
        IfCondition GreaterEqual(p, SVGParse.size) ThenBlock: { ReturnValue(-1) }
        ReturnValue(GetByte(SVGParse.data, p))
    }
}

// SVG_ReadByte: read one byte and advance
Function.SVG_ReadByte {
    Output: Integer
    Body: {
        p = SVGParse.pos
        IfCondition GreaterEqual(p, SVGParse.size) ThenBlock: { ReturnValue(-1) }
        v = GetByte(SVGParse.data, p)
        SVGParse.pos = Add(p, 1)
        ReturnValue(v)
    }
}

// SVG_SkipWhitespace: advance past spaces, tabs, newlines, carriage returns
Function.SVG_SkipWhitespace {
    Body: {
        more = 1
        WhileLoop EqualTo(more, 1) {
            c = SVG_PeekByte()
            IfCondition EqualTo(c, -1) ThenBlock: { more = 0 }
            IfCondition EqualTo(more, 1) ThenBlock: {
                is_ws = 0
                IfCondition EqualTo(c, 32) ThenBlock: { is_ws = 1 }
                IfCondition EqualTo(c, 9) ThenBlock: { is_ws = 1 }
                IfCondition EqualTo(c, 10) ThenBlock: { is_ws = 1 }
                IfCondition EqualTo(c, 13) ThenBlock: { is_ws = 1 }
                IfCondition EqualTo(is_ws, 1) ThenBlock: {
                    SVGParse.pos = Add(SVGParse.pos, 1)
                } ElseBlock: {
                    more = 0
                }
            }
        }
        ReturnValue(0)
    }
}

// SVG_SkipUntil: advance until we see a specific byte
Function.SVG_SkipUntil {
    Input: target: Integer
    Body: {
        WhileLoop LessThan(SVGParse.pos, SVGParse.size) {
            c = GetByte(SVGParse.data, SVGParse.pos)
            IfCondition EqualTo(c, target) ThenBlock: {
                ReturnValue(0)
            }
            SVGParse.pos = Add(SVGParse.pos, 1)
        }
        ReturnValue(0)
    }
}

// SVG_SkipComment: skip <!-- ... -->
Function.SVG_SkipComment {
    Body: {
        // Already consumed "<!--", find "-->"
        WhileLoop LessThan(SVGParse.pos, Subtract(SVGParse.size, 2)) {
            c0 = GetByte(SVGParse.data, SVGParse.pos)
            c1 = GetByte(SVGParse.data, Add(SVGParse.pos, 1))
            c2 = GetByte(SVGParse.data, Add(SVGParse.pos, 2))
            IfCondition And(EqualTo(c0, 45), And(EqualTo(c1, 45), EqualTo(c2, 62))) ThenBlock: {
                // Found "-->"
                SVGParse.pos = Add(SVGParse.pos, 3)
                ReturnValue(0)
            }
            SVGParse.pos = Add(SVGParse.pos, 1)
        }
        SVGParse.pos = SVGParse.size
        ReturnValue(0)
    }
}

// SVG_SkipPI: skip <?...?>
Function.SVG_SkipPI {
    Body: {
        WhileLoop LessThan(SVGParse.pos, Subtract(SVGParse.size, 1)) {
            c0 = GetByte(SVGParse.data, SVGParse.pos)
            c1 = GetByte(SVGParse.data, Add(SVGParse.pos, 1))
            IfCondition And(EqualTo(c0, 63), EqualTo(c1, 62)) ThenBlock: {
                // Found "?>"
                SVGParse.pos = Add(SVGParse.pos, 2)
                ReturnValue(0)
            }
            SVGParse.pos = Add(SVGParse.pos, 1)
        }
        SVGParse.pos = SVGParse.size
        ReturnValue(0)
    }
}

// SVG_SkipDoctype: skip <!DOCTYPE ...>
Function.SVG_SkipDoctype {
    Body: {
        depth = 1
        WhileLoop And(LessThan(SVGParse.pos, SVGParse.size), GreaterThan(depth, 0)) {
            c = GetByte(SVGParse.data, SVGParse.pos)
            SVGParse.pos = Add(SVGParse.pos, 1)
            IfCondition EqualTo(c, 60) ThenBlock: { depth = Add(depth, 1) }
            IfCondition EqualTo(c, 62) ThenBlock: { depth = Subtract(depth, 1) }
        }
        ReturnValue(0)
    }
}

// SVG_ReadAttrValue: read attribute value inside quotes.
// Reads from current pos until matching quote, stores into dest buffer.
// Returns length written.
Function.SVG_ReadAttrValue {
    Input: dest: Address
    Input: max_len: Integer
    Input: quote_char: Integer
    Output: Integer
    Body: {
        len = 0
        WhileLoop LessThan(SVGParse.pos, SVGParse.size) {
            c = GetByte(SVGParse.data, SVGParse.pos)
            SVGParse.pos = Add(SVGParse.pos, 1)
            IfCondition EqualTo(c, quote_char) ThenBlock: {
                // End of value
                SetByte(dest, len, 0)
                ReturnValue(len)
            }
            IfCondition LessThan(len, Subtract(max_len, 1)) ThenBlock: {
                SetByte(dest, len, c)
                len = Add(len, 1)
            }
        }
        SetByte(dest, len, 0)
        ReturnValue(len)
    }
}

// SVG_ReadTagName: read tag name into SVGElem.tag buffer.
// Stops at whitespace, '>', '/', or EOF.
Function.SVG_ReadTagName {
    Output: Integer
    Body: {
        dest = SVGElem.tag
        len = 0
        WhileLoop LessThan(SVGParse.pos, SVGParse.size) {
            c = SVG_PeekByte()
            done = 0
            IfCondition EqualTo(c, 32) ThenBlock: { done = 1 }
            IfCondition EqualTo(c, 9) ThenBlock: { done = 1 }
            IfCondition EqualTo(c, 10) ThenBlock: { done = 1 }
            IfCondition EqualTo(c, 13) ThenBlock: { done = 1 }
            IfCondition EqualTo(c, 62) ThenBlock: { done = 1 }
            IfCondition EqualTo(c, 47) ThenBlock: { done = 1 }
            IfCondition EqualTo(done, 1) ThenBlock: {
                SetByte(dest, len, 0)
                SVGElem.tag_len = len
                ReturnValue(len)
            }
            IfCondition LessThan(len, 254) ThenBlock: {
                SetByte(dest, len, c)
                len = Add(len, 1)
            }
            SVGParse.pos = Add(SVGParse.pos, 1)
        }
        SetByte(dest, len, 0)
        SVGElem.tag_len = len
        ReturnValue(len)
    }
}

// SVG_ReadElement: parse one XML element from current position.
// Populates SVGElem (tag, attrs, self_close, is_close).
// Returns 1 if element found, 0 if EOF.
Function.SVG_ReadElement {
    Output: Integer
    Body: {
        // Reset element state
        SVGElem.self_close = 0
        SVGElem.is_close = 0
        SVGElem.attr_count = 0
        SVGElem.tag_len = 0

        // Skip text content until we find '<'
        found = 0
        WhileLoop And(LessThan(SVGParse.pos, SVGParse.size), EqualTo(found, 0)) {
            c = GetByte(SVGParse.data, SVGParse.pos)
            IfCondition EqualTo(c, 60) ThenBlock: {
                found = 1
            } ElseBlock: {
                SVGParse.pos = Add(SVGParse.pos, 1)
            }
        }
        IfCondition EqualTo(found, 0) ThenBlock: { ReturnValue(0) }

        // Consume '<'
        SVGParse.pos = Add(SVGParse.pos, 1)
        IfCondition GreaterEqual(SVGParse.pos, SVGParse.size) ThenBlock: { ReturnValue(0) }

        // Check for special elements
        c = SVG_PeekByte()

        // Processing instruction <?...?>
        IfCondition EqualTo(c, 63) ThenBlock: {
            SVG_SkipPI()
            ReturnValue(SVG_ReadElement())
        }

        // Comment <!-- or DOCTYPE <!
        IfCondition EqualTo(c, 33) ThenBlock: {
            SVGParse.pos = Add(SVGParse.pos, 1)
            c2 = SVG_PeekByte()
            IfCondition EqualTo(c2, 45) ThenBlock: {
                // Likely "<!--"
                SVGParse.pos = Add(SVGParse.pos, 2)
                SVG_SkipComment()
                ReturnValue(SVG_ReadElement())
            }
            // DOCTYPE or CDATA
            SVG_SkipDoctype()
            ReturnValue(SVG_ReadElement())
        }

        // Closing tag </tag>
        IfCondition EqualTo(c, 47) ThenBlock: {
            SVGParse.pos = Add(SVGParse.pos, 1)
            SVGElem.is_close = 1
        }

        // Read tag name
        SVG_ReadTagName()

        // Read attributes until '>' or '/>'
        SVG_SkipWhitespace()
        attr_idx = 0
        done = 0
        WhileLoop And(LessThan(SVGParse.pos, SVGParse.size), EqualTo(done, 0)) {
            c = SVG_PeekByte()

            // End of tag '>'
            IfCondition EqualTo(c, 62) ThenBlock: {
                SVGParse.pos = Add(SVGParse.pos, 1)
                done = 1
            }

            // Self-closing '/>'
            IfCondition And(EqualTo(c, 47), EqualTo(done, 0)) ThenBlock: {
                SVGParse.pos = Add(SVGParse.pos, 1)
                c2 = SVG_PeekByte()
                IfCondition EqualTo(c2, 62) ThenBlock: {
                    SVGParse.pos = Add(SVGParse.pos, 1)
                    SVGElem.self_close = 1
                    done = 1
                }
            }

            // Read attribute key=value
            IfCondition EqualTo(done, 0) ThenBlock: {
                IfCondition LessThan(attr_idx, SVGConst.MAX_ATTRS) ThenBlock: {
                    // Read key
                    key_dest = Add(SVGElem.attr_keys, Multiply(attr_idx, SVGConst.ATTR_KEY_MAX))
                    klen = 0
                    key_done = 0
                    WhileLoop And(LessThan(SVGParse.pos, SVGParse.size), EqualTo(key_done, 0)) {
                        kc = SVG_PeekByte()
                        kstop = 0
                        IfCondition EqualTo(kc, 61) ThenBlock: { kstop = 1 }
                        IfCondition EqualTo(kc, 32) ThenBlock: { kstop = 1 }
                        IfCondition EqualTo(kc, 9) ThenBlock: { kstop = 1 }
                        IfCondition EqualTo(kc, 62) ThenBlock: { kstop = 1 }
                        IfCondition EqualTo(kc, 47) ThenBlock: { kstop = 1 }
                        IfCondition EqualTo(kstop, 1) ThenBlock: {
                            key_done = 1
                        } ElseBlock: {
                            IfCondition LessThan(klen, Subtract(SVGConst.ATTR_KEY_MAX, 1)) ThenBlock: {
                                SetByte(key_dest, klen, kc)
                                klen = Add(klen, 1)
                            }
                            SVGParse.pos = Add(SVGParse.pos, 1)
                        }
                    }
                    SetByte(key_dest, klen, 0)

                    // Skip '='
                    SVG_SkipWhitespace()
                    eq = SVG_PeekByte()
                    IfCondition EqualTo(eq, 61) ThenBlock: {
                        SVGParse.pos = Add(SVGParse.pos, 1)
                        SVG_SkipWhitespace()

                        // Read value (quoted)
                        val_dest = Add(SVGElem.attr_vals, Multiply(attr_idx, SVGConst.ATTR_VAL_MAX))
                        q = SVG_ReadByte()
                        IfCondition Or(EqualTo(q, 34), EqualTo(q, 39)) ThenBlock: {
                            SVG_ReadAttrValue(val_dest, SVGConst.ATTR_VAL_MAX, q)
                        } ElseBlock: {
                            SetByte(val_dest, 0, 0)
                        }
                        attr_idx = Add(attr_idx, 1)
                    } ElseBlock: {
                        // Boolean attribute (no value) — store empty value
                        IfCondition GreaterThan(klen, 0) ThenBlock: {
                            val_dest = Add(SVGElem.attr_vals, Multiply(attr_idx, SVGConst.ATTR_VAL_MAX))
                            SetByte(val_dest, 0, 0)
                            attr_idx = Add(attr_idx, 1)
                        }
                    }
                } ElseBlock: {
                    // Too many attrs — skip to end of tag
                    SVG_SkipUntil(62)
                    SVGParse.pos = Add(SVGParse.pos, 1)
                    done = 1
                }
                SVG_SkipWhitespace()
            }
        }
        SVGElem.attr_count = attr_idx
        ReturnValue(1)
    }
}

// SVG_GetAttr: find attribute value by key name.
// Returns address of value string, or 0 if not found.
Function.SVG_GetAttr {
    Input: key: Address
    Output: Address
    Body: {
        n = SVGElem.attr_count
        i = 0
        WhileLoop LessThan(i, n) {
            k_addr = Add(SVGElem.attr_keys, Multiply(i, SVGConst.ATTR_KEY_MAX))
            cmp = StringCompare(k_addr, key)
            IfCondition EqualTo(cmp, 0) ThenBlock: {
                v_addr = Add(SVGElem.attr_vals, Multiply(i, SVGConst.ATTR_VAL_MAX))
                ReturnValue(v_addr)
            }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

// =============================================================================
// NUMBER PARSER — integer from string (handles negative, decimal truncation)
// =============================================================================
Function.SVG_ParseInt {
    Input: str: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(str, 0) ThenBlock: { ReturnValue(0) }
        p = 0
        neg = 0
        c = GetByte(str, 0)
        IfCondition EqualTo(c, 45) ThenBlock: {
            neg = 1
            p = 1
        }
        IfCondition EqualTo(c, 43) ThenBlock: {
            p = 1
        }
        val = 0
        more = 1
        WhileLoop EqualTo(more, 1) {
            c = GetByte(str, p)
            IfCondition And(GreaterEqual(c, 48), LessEqual(c, 57)) ThenBlock: {
                val = Add(Multiply(val, 10), Subtract(c, 48))
                p = Add(p, 1)
            } ElseBlock: {
                more = 0
            }
        }
        IfCondition EqualTo(neg, 1) ThenBlock: {
            val = Subtract(0, val)
        }
        ReturnValue(val)
    }
}

// SVG_ParseFixed256: parse a decimal number string into 256× fixed-point.
// E.g., "12.5" → 3200, "-3.75" → -960
Function.SVG_ParseFixed256 {
    Input: str: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(str, 0) ThenBlock: { ReturnValue(0) }
        p = 0
        neg = 0
        c = GetByte(str, 0)
        IfCondition EqualTo(c, 45) ThenBlock: {
            neg = 1
            p = 1
        }
        IfCondition EqualTo(c, 43) ThenBlock: {
            p = 1
        }

        // Integer part
        int_part = 0
        more = 1
        WhileLoop EqualTo(more, 1) {
            c = GetByte(str, p)
            IfCondition And(GreaterEqual(c, 48), LessEqual(c, 57)) ThenBlock: {
                int_part = Add(Multiply(int_part, 10), Subtract(c, 48))
                p = Add(p, 1)
            } ElseBlock: {
                more = 0
            }
        }

        // Fractional part
        frac_val = 0
        frac_div = 1
        c = GetByte(str, p)
        IfCondition EqualTo(c, 46) ThenBlock: {
            p = Add(p, 1)
            fmore = 1
            WhileLoop EqualTo(fmore, 1) {
                c = GetByte(str, p)
                IfCondition And(GreaterEqual(c, 48), LessEqual(c, 57)) ThenBlock: {
                    frac_val = Add(Multiply(frac_val, 10), Subtract(c, 48))
                    frac_div = Multiply(frac_div, 10)
                    p = Add(p, 1)
                } ElseBlock: {
                    fmore = 0
                }
            }
        }

        // Combine: result = int_part * 256 + (frac_val * 256) / frac_div
        result = Multiply(int_part, 256)
        IfCondition GreaterThan(frac_div, 1) ThenBlock: {
            frac_fp = Divide(Multiply(frac_val, 256), frac_div)
            result = Add(result, frac_fp)
        }

        IfCondition EqualTo(neg, 1) ThenBlock: {
            result = Subtract(0, result)
        }
        ReturnValue(result)
    }
}

// SVG_SkipNumWhitespace: skip whitespace and commas in a number list string.
// Input: str address, pos (offset). Returns new pos.
Function.SVG_SkipNumSep {
    Input: str: Address
    Input: pos: Integer
    Output: Integer
    Body: {
        more = 1
        WhileLoop EqualTo(more, 1) {
            c = GetByte(str, pos)
            skip = 0
            IfCondition EqualTo(c, 32) ThenBlock: { skip = 1 }
            IfCondition EqualTo(c, 9) ThenBlock: { skip = 1 }
            IfCondition EqualTo(c, 10) ThenBlock: { skip = 1 }
            IfCondition EqualTo(c, 13) ThenBlock: { skip = 1 }
            IfCondition EqualTo(c, 44) ThenBlock: { skip = 1 }
            IfCondition EqualTo(skip, 1) ThenBlock: {
                pos = Add(pos, 1)
            } ElseBlock: {
                more = 0
            }
        }
        ReturnValue(pos)
    }
}

// SVG_ReadNum256: read one number from string at pos, return 256× fp value.
// Updates pos (via SVGPath scratch).
Function.SVG_ReadNum256 {
    Input: str: Address
    Input: pos: Integer
    Output: Integer
    Body: {
        pos = SVG_SkipNumSep(str, pos)
        neg = 0
        c = GetByte(str, pos)
        IfCondition EqualTo(c, 45) ThenBlock: {
            neg = 1
            pos = Add(pos, 1)
        }
        IfCondition EqualTo(c, 43) ThenBlock: {
            pos = Add(pos, 1)
        }

        int_part = 0
        more = 1
        WhileLoop EqualTo(more, 1) {
            c = GetByte(str, pos)
            IfCondition And(GreaterEqual(c, 48), LessEqual(c, 57)) ThenBlock: {
                int_part = Add(Multiply(int_part, 10), Subtract(c, 48))
                pos = Add(pos, 1)
            } ElseBlock: {
                more = 0
            }
        }

        frac_val = 0
        frac_div = 1
        c = GetByte(str, pos)
        IfCondition EqualTo(c, 46) ThenBlock: {
            pos = Add(pos, 1)
            fmore = 1
            WhileLoop EqualTo(fmore, 1) {
                c = GetByte(str, pos)
                IfCondition And(GreaterEqual(c, 48), LessEqual(c, 57)) ThenBlock: {
                    frac_val = Add(Multiply(frac_val, 10), Subtract(c, 48))
                    frac_div = Multiply(frac_div, 10)
                    pos = Add(pos, 1)
                } ElseBlock: {
                    fmore = 0
                }
            }
        }

        result = Multiply(int_part, 256)
        IfCondition GreaterThan(frac_div, 1) ThenBlock: {
            result = Add(result, Divide(Multiply(frac_val, 256), frac_div))
        }
        IfCondition EqualTo(neg, 1) ThenBlock: {
            result = Subtract(0, result)
        }

        // Stash pos for caller to retrieve
        SVGPath.has_cp = pos
        ReturnValue(result)
    }
}

// =============================================================================
// COLOR PARSER
// =============================================================================

// SVG_HexDigit: parse one hex digit character → 0-15 or -1
Function.SVG_HexDigit {
    Input: c: Integer
    Output: Integer
    Body: {
        IfCondition And(GreaterEqual(c, 48), LessEqual(c, 57)) ThenBlock: {
            ReturnValue(Subtract(c, 48))
        }
        IfCondition And(GreaterEqual(c, 65), LessEqual(c, 70)) ThenBlock: {
            ReturnValue(Add(Subtract(c, 65), 10))
        }
        IfCondition And(GreaterEqual(c, 97), LessEqual(c, 102)) ThenBlock: {
            ReturnValue(Add(Subtract(c, 97), 10))
        }
        ReturnValue(-1)
    }
}

// SVG_ParseColor: parse a color string into packed 0xAARRGGBB.
// Handles: #RGB, #RRGGBB, #RRGGBBAA, named colors, rgb(), rgba(), none
// Returns 0 for "none" or unparseable.
Function.SVG_ParseColor {
    Input: str: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(str, 0) ThenBlock: { ReturnValue(0) }
        c0 = GetByte(str, 0)
        IfCondition EqualTo(c0, 0) ThenBlock: { ReturnValue(0) }

        // Hex color: #...
        IfCondition EqualTo(c0, 35) ThenBlock: {
            // Count hex digits
            dcount = 0
            di = 1
            dmore = 1
            WhileLoop EqualTo(dmore, 1) {
                dc = GetByte(str, di)
                hv = SVG_HexDigit(dc)
                IfCondition GreaterEqual(hv, 0) ThenBlock: {
                    dcount = Add(dcount, 1)
                    di = Add(di, 1)
                } ElseBlock: {
                    dmore = 0
                }
            }

            // #RGB → expand to RRGGBB
            IfCondition EqualTo(dcount, 3) ThenBlock: {
                h0 = SVG_HexDigit(GetByte(str, 1))
                h1 = SVG_HexDigit(GetByte(str, 2))
                h2 = SVG_HexDigit(GetByte(str, 3))
                r = Add(Multiply(h0, 16), h0)
                g = Add(Multiply(h1, 16), h1)
                b = Add(Multiply(h2, 16), h2)
                ReturnValue(TVG_PackColor(r, g, b, 255))
            }

            // #RRGGBB
            IfCondition EqualTo(dcount, 6) ThenBlock: {
                r = Add(Multiply(SVG_HexDigit(GetByte(str, 1)), 16), SVG_HexDigit(GetByte(str, 2)))
                g = Add(Multiply(SVG_HexDigit(GetByte(str, 3)), 16), SVG_HexDigit(GetByte(str, 4)))
                b = Add(Multiply(SVG_HexDigit(GetByte(str, 5)), 16), SVG_HexDigit(GetByte(str, 6)))
                ReturnValue(TVG_PackColor(r, g, b, 255))
            }

            // #RRGGBBAA
            IfCondition EqualTo(dcount, 8) ThenBlock: {
                r = Add(Multiply(SVG_HexDigit(GetByte(str, 1)), 16), SVG_HexDigit(GetByte(str, 2)))
                g = Add(Multiply(SVG_HexDigit(GetByte(str, 3)), 16), SVG_HexDigit(GetByte(str, 4)))
                b = Add(Multiply(SVG_HexDigit(GetByte(str, 5)), 16), SVG_HexDigit(GetByte(str, 6)))
                a = Add(Multiply(SVG_HexDigit(GetByte(str, 7)), 16), SVG_HexDigit(GetByte(str, 8)))
                ReturnValue(TVG_PackColor(r, g, b, a))
            }
            ReturnValue(0)
        }

        // Named colors — check common ones
        IfCondition EqualTo(StringCompare(str, "black"), 0) ThenBlock: { ReturnValue(SVGNamedColors.black) }
        IfCondition EqualTo(StringCompare(str, "white"), 0) ThenBlock: { ReturnValue(SVGNamedColors.white) }
        IfCondition EqualTo(StringCompare(str, "red"), 0) ThenBlock: { ReturnValue(SVGNamedColors.red) }
        IfCondition EqualTo(StringCompare(str, "green"), 0) ThenBlock: { ReturnValue(SVGNamedColors.green) }
        IfCondition EqualTo(StringCompare(str, "blue"), 0) ThenBlock: { ReturnValue(SVGNamedColors.blue) }
        IfCondition EqualTo(StringCompare(str, "yellow"), 0) ThenBlock: { ReturnValue(SVGNamedColors.yellow) }
        IfCondition EqualTo(StringCompare(str, "cyan"), 0) ThenBlock: { ReturnValue(SVGNamedColors.cyan) }
        IfCondition EqualTo(StringCompare(str, "magenta"), 0) ThenBlock: { ReturnValue(SVGNamedColors.magenta) }
        IfCondition EqualTo(StringCompare(str, "orange"), 0) ThenBlock: { ReturnValue(SVGNamedColors.orange) }
        IfCondition EqualTo(StringCompare(str, "purple"), 0) ThenBlock: { ReturnValue(SVGNamedColors.purple) }
        IfCondition EqualTo(StringCompare(str, "gray"), 0) ThenBlock: { ReturnValue(SVGNamedColors.gray) }
        IfCondition EqualTo(StringCompare(str, "grey"), 0) ThenBlock: { ReturnValue(SVGNamedColors.grey) }
        IfCondition EqualTo(StringCompare(str, "silver"), 0) ThenBlock: { ReturnValue(SVGNamedColors.silver) }
        IfCondition EqualTo(StringCompare(str, "maroon"), 0) ThenBlock: { ReturnValue(SVGNamedColors.maroon) }
        IfCondition EqualTo(StringCompare(str, "navy"), 0) ThenBlock: { ReturnValue(SVGNamedColors.navy) }
        IfCondition EqualTo(StringCompare(str, "teal"), 0) ThenBlock: { ReturnValue(SVGNamedColors.teal) }
        IfCondition EqualTo(StringCompare(str, "olive"), 0) ThenBlock: { ReturnValue(SVGNamedColors.olive) }
        IfCondition EqualTo(StringCompare(str, "lime"), 0) ThenBlock: { ReturnValue(SVGNamedColors.lime) }
        IfCondition EqualTo(StringCompare(str, "aqua"), 0) ThenBlock: { ReturnValue(SVGNamedColors.aqua) }
        IfCondition EqualTo(StringCompare(str, "fuchsia"), 0) ThenBlock: { ReturnValue(SVGNamedColors.fuchsia) }
        IfCondition EqualTo(StringCompare(str, "brown"), 0) ThenBlock: { ReturnValue(SVGNamedColors.brown) }
        IfCondition EqualTo(StringCompare(str, "gold"), 0) ThenBlock: { ReturnValue(SVGNamedColors.gold) }
        IfCondition EqualTo(StringCompare(str, "salmon"), 0) ThenBlock: { ReturnValue(SVGNamedColors.salmon) }
        IfCondition EqualTo(StringCompare(str, "crimson"), 0) ThenBlock: { ReturnValue(SVGNamedColors.crimson) }
        IfCondition EqualTo(StringCompare(str, "tomato"), 0) ThenBlock: { ReturnValue(SVGNamedColors.tomato) }
        IfCondition EqualTo(StringCompare(str, "coral"), 0) ThenBlock: { ReturnValue(SVGNamedColors.coral) }
        IfCondition EqualTo(StringCompare(str, "indianred"), 0) ThenBlock: { ReturnValue(SVGNamedColors.indianred) }
        IfCondition EqualTo(StringCompare(str, "darkred"), 0) ThenBlock: { ReturnValue(SVGNamedColors.darkred) }
        IfCondition EqualTo(StringCompare(str, "darkblue"), 0) ThenBlock: { ReturnValue(SVGNamedColors.darkblue) }
        IfCondition EqualTo(StringCompare(str, "darkgreen"), 0) ThenBlock: { ReturnValue(SVGNamedColors.darkgreen) }
        IfCondition EqualTo(StringCompare(str, "darkgray"), 0) ThenBlock: { ReturnValue(SVGNamedColors.darkgray) }
        IfCondition EqualTo(StringCompare(str, "darkgrey"), 0) ThenBlock: { ReturnValue(SVGNamedColors.darkgrey) }
        IfCondition EqualTo(StringCompare(str, "lightblue"), 0) ThenBlock: { ReturnValue(SVGNamedColors.lightblue) }
        IfCondition EqualTo(StringCompare(str, "lightcoral"), 0) ThenBlock: { ReturnValue(SVGNamedColors.lightcoral) }
        IfCondition EqualTo(StringCompare(str, "lightcyan"), 0) ThenBlock: { ReturnValue(SVGNamedColors.lightcyan) }
        IfCondition EqualTo(StringCompare(str, "lightgray"), 0) ThenBlock: { ReturnValue(SVGNamedColors.lightgray) }
        IfCondition EqualTo(StringCompare(str, "lightgrey"), 0) ThenBlock: { ReturnValue(SVGNamedColors.lightgrey) }
        IfCondition EqualTo(StringCompare(str, "lightgreen"), 0) ThenBlock: { ReturnValue(SVGNamedColors.lightgreen) }
        IfCondition EqualTo(StringCompare(str, "lightyellow"), 0) ThenBlock: { ReturnValue(SVGNamedColors.lightyellow) }
        IfCondition EqualTo(StringCompare(str, "lightpink"), 0) ThenBlock: { ReturnValue(SVGNamedColors.lightpink) }
        IfCondition EqualTo(StringCompare(str, "lightskyblue"), 0) ThenBlock: { ReturnValue(SVGNamedColors.lightskyblue) }
        IfCondition EqualTo(StringCompare(str, "lavender"), 0) ThenBlock: { ReturnValue(SVGNamedColors.lavender) }
        IfCondition EqualTo(StringCompare(str, "steelblue"), 0) ThenBlock: { ReturnValue(SVGNamedColors.steelblue) }
        IfCondition EqualTo(StringCompare(str, "cornflowerblue"), 0) ThenBlock: { ReturnValue(SVGNamedColors.cornflowerblue) }
        IfCondition EqualTo(StringCompare(str, "saddlebrown"), 0) ThenBlock: { ReturnValue(SVGNamedColors.saddlebrown) }
        IfCondition EqualTo(StringCompare(str, "sandybrown"), 0) ThenBlock: { ReturnValue(SVGNamedColors.sandybrown) }
        IfCondition EqualTo(StringCompare(str, "chocolate"), 0) ThenBlock: { ReturnValue(SVGNamedColors.chocolate) }
        IfCondition EqualTo(StringCompare(str, "sienna"), 0) ThenBlock: { ReturnValue(SVGNamedColors.sienna) }
        IfCondition EqualTo(StringCompare(str, "wheat"), 0) ThenBlock: { ReturnValue(SVGNamedColors.wheat) }
        IfCondition EqualTo(StringCompare(str, "khaki"), 0) ThenBlock: { ReturnValue(SVGNamedColors.khaki) }
        IfCondition EqualTo(StringCompare(str, "plum"), 0) ThenBlock: { ReturnValue(SVGNamedColors.plum) }
        IfCondition EqualTo(StringCompare(str, "violet"), 0) ThenBlock: { ReturnValue(SVGNamedColors.violet) }
        IfCondition EqualTo(StringCompare(str, "indigo"), 0) ThenBlock: { ReturnValue(SVGNamedColors.indigo) }
        IfCondition EqualTo(StringCompare(str, "skyblue"), 0) ThenBlock: { ReturnValue(SVGNamedColors.skyblue) }
        IfCondition EqualTo(StringCompare(str, "turquoise"), 0) ThenBlock: { ReturnValue(SVGNamedColors.turquoise) }
        IfCondition EqualTo(StringCompare(str, "pink"), 0) ThenBlock: { ReturnValue(SVGNamedColors.pink) }
        IfCondition EqualTo(StringCompare(str, "none"), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(StringCompare(str, "transparent"), 0) ThenBlock: { ReturnValue(0) }

        // rgb(r,g,b) notation
        IfCondition EqualTo(c0, 114) ThenBlock: {
            c1 = GetByte(str, 1)
            c2 = GetByte(str, 2)
            c3 = GetByte(str, 3)
            IfCondition And(EqualTo(c1, 103), And(EqualTo(c2, 98), EqualTo(c3, 40))) ThenBlock: {
                // "rgb("
                p = 4
                r = SVG_ReadNum256(str, p)
                r = Divide(r, 256)
                p = SVGPath.has_cp
                g = SVG_ReadNum256(str, p)
                g = Divide(g, 256)
                p = SVGPath.has_cp
                b = SVG_ReadNum256(str, p)
                b = Divide(b, 256)
                IfCondition GreaterThan(r, 255) ThenBlock: { r = 255 }
                IfCondition GreaterThan(g, 255) ThenBlock: { g = 255 }
                IfCondition GreaterThan(b, 255) ThenBlock: { b = 255 }
                ReturnValue(TVG_PackColor(r, g, b, 255))
            }
        }

        ReturnValue(0)
    }
}

// =============================================================================
// COORDINATE MAPPING — viewBox to surface
// =============================================================================

// SVG_MapX: map SVG X coordinate (256× fp) to surface pixel coord (256× fp)
Function.SVG_MapX {
    Input: x: Integer
    Output: Integer
    Body: {
        vw = SVGState.vb_w
        IfCondition EqualTo(vw, 0) ThenBlock: { ReturnValue(x) }
        sw = Multiply(SVGState.surf_w, 256)
        // result = (x - vb_x) * surf_w_fp / vb_w
        rel = Subtract(x, SVGState.vb_x)
        ReturnValue(Divide(Multiply(rel, sw), vw))
    }
}

// SVG_MapY: map SVG Y coordinate (256× fp) to surface pixel coord (256× fp)
Function.SVG_MapY {
    Input: y: Integer
    Output: Integer
    Body: {
        vh = SVGState.vb_h
        IfCondition EqualTo(vh, 0) ThenBlock: { ReturnValue(y) }
        sh = Multiply(SVGState.surf_h, 256)
        rel = Subtract(y, SVGState.vb_y)
        ReturnValue(Divide(Multiply(rel, sh), vh))
    }
}

// =============================================================================
// SVG PATH PARSER
// =============================================================================

// SVG_PathReset: clear path command buffer
Function.SVG_PathReset {
    Body: {
        SVGPath.cmd_count = 0
        SVGPath.cur_x = 0
        SVGPath.cur_y = 0
        SVGPath.start_x = 0
        SVGPath.start_y = 0
        SVGPath.last_cpx = 0
        SVGPath.last_cpy = 0
        SVGPath.has_cp = 0
        ReturnValue(0)
    }
}

// SVG_PathAddCmd: append a command to the path buffer
// Note: y2 is passed via SVGPath.tmp_y2 (Ailang has 6-param limit)
Function.SVG_PathAddCmd {
    Input: ctype: Integer
    Input: x0: Integer
    Input: y0: Integer
    Input: x1: Integer
    Input: y1: Integer
    Input: x2: Integer
    Body: {
        y2 = SVGPath.tmp_y2
        idx = SVGPath.cmd_count
        IfCondition GreaterEqual(idx, SVGConst.PATH_CMD_MAX) ThenBlock: { ReturnValue(0) }
        base = Add(SVGPath.cmds, Multiply(idx, SVGConst.CMD_ENTRY_SIZE))
        StoreValue(Add(base, SVGPCmd.TYPE), ctype)
        StoreValue(Add(base, SVGPCmd.X0), x0)
        StoreValue(Add(base, SVGPCmd.Y0), y0)
        StoreValue(Add(base, SVGPCmd.X1), x1)
        StoreValue(Add(base, SVGPCmd.Y1), y1)
        StoreValue(Add(base, SVGPCmd.X2), x2)
        StoreValue(Add(base, SVGPCmd.Y2), y2)
        SVGPath.cmd_count = Add(idx, 1)
        ReturnValue(0)
    }
}

// SVG_ParsePath: parse SVG path d attribute string into command buffer.
// All coordinates stored as 256× fixed-point, absolute.
Function.SVG_ParsePath {
    Input: d: Address
    Body: {
        SVG_PathReset()
        IfCondition EqualTo(d, 0) ThenBlock: { ReturnValue(0) }

        p = 0
        cur_cmd = 0
        cx = 0
        cy = 0
        sx = 0
        sy = 0
        lcpx = 0
        lcpy = 0
        has_lcp = 0

        parse_more = 1
        WhileLoop EqualTo(parse_more, 1) {
            p = SVG_SkipNumSep(d, p)
            c = GetByte(d, p)
            IfCondition EqualTo(c, 0) ThenBlock: { parse_more = 0 }
            IfCondition EqualTo(parse_more, 1) ThenBlock: {

                // Check if it's a command letter
                is_cmd = 0
                IfCondition EqualTo(c, 77) ThenBlock: { cur_cmd = 77  is_cmd = 1  p = Add(p, 1) }    // M
                IfCondition EqualTo(c, 109) ThenBlock: { cur_cmd = 109  is_cmd = 1  p = Add(p, 1) }   // m
                IfCondition EqualTo(c, 76) ThenBlock: { cur_cmd = 76  is_cmd = 1  p = Add(p, 1) }     // L
                IfCondition EqualTo(c, 108) ThenBlock: { cur_cmd = 108  is_cmd = 1  p = Add(p, 1) }   // l
                IfCondition EqualTo(c, 72) ThenBlock: { cur_cmd = 72  is_cmd = 1  p = Add(p, 1) }     // H
                IfCondition EqualTo(c, 104) ThenBlock: { cur_cmd = 104  is_cmd = 1  p = Add(p, 1) }   // h
                IfCondition EqualTo(c, 86) ThenBlock: { cur_cmd = 86  is_cmd = 1  p = Add(p, 1) }     // V
                IfCondition EqualTo(c, 118) ThenBlock: { cur_cmd = 118  is_cmd = 1  p = Add(p, 1) }   // v
                IfCondition EqualTo(c, 67) ThenBlock: { cur_cmd = 67  is_cmd = 1  p = Add(p, 1) }     // C
                IfCondition EqualTo(c, 99) ThenBlock: { cur_cmd = 99  is_cmd = 1  p = Add(p, 1) }     // c
                IfCondition EqualTo(c, 83) ThenBlock: { cur_cmd = 83  is_cmd = 1  p = Add(p, 1) }     // S
                IfCondition EqualTo(c, 115) ThenBlock: { cur_cmd = 115  is_cmd = 1  p = Add(p, 1) }   // s
                IfCondition EqualTo(c, 81) ThenBlock: { cur_cmd = 81  is_cmd = 1  p = Add(p, 1) }     // Q
                IfCondition EqualTo(c, 113) ThenBlock: { cur_cmd = 113  is_cmd = 1  p = Add(p, 1) }   // q
                IfCondition EqualTo(c, 84) ThenBlock: { cur_cmd = 84  is_cmd = 1  p = Add(p, 1) }     // T
                IfCondition EqualTo(c, 116) ThenBlock: { cur_cmd = 116  is_cmd = 1  p = Add(p, 1) }   // t
                IfCondition EqualTo(c, 65) ThenBlock: { cur_cmd = 65  is_cmd = 1  p = Add(p, 1) }     // A
                IfCondition EqualTo(c, 97) ThenBlock: { cur_cmd = 97  is_cmd = 1  p = Add(p, 1) }     // a
                IfCondition EqualTo(c, 90) ThenBlock: { cur_cmd = 90  is_cmd = 1  p = Add(p, 1) }     // Z
                IfCondition EqualTo(c, 122) ThenBlock: { cur_cmd = 122  is_cmd = 1  p = Add(p, 1) }   // z

                // Handle Z/z immediately
                IfCondition Or(EqualTo(cur_cmd, 90), EqualTo(cur_cmd, 122)) ThenBlock: {
                    IfCondition EqualTo(is_cmd, 1) ThenBlock: {
                        SVG_PathAddCmd(SVGCmdType.CLOSE, 0, 0, 0, 0)
                        cx = sx
                        cy = sy
                        has_lcp = 0
                        cur_cmd = 0
                    }
                }

                // Process commands that consume parameters
                IfCondition And(NotEqual(cur_cmd, 0), NotEqual(cur_cmd, 90)) ThenBlock: {
                    IfCondition NotEqual(cur_cmd, 122) ThenBlock: {
                        p = SVG_SkipNumSep(d, p)
                        cc = GetByte(d, p)
                        // Check if there's a number to read
                        is_num = 0
                        IfCondition And(GreaterEqual(cc, 48), LessEqual(cc, 57)) ThenBlock: { is_num = 1 }
                        IfCondition EqualTo(cc, 45) ThenBlock: { is_num = 1 }
                        IfCondition EqualTo(cc, 43) ThenBlock: { is_num = 1 }
                        IfCondition EqualTo(cc, 46) ThenBlock: { is_num = 1 }

                        IfCondition EqualTo(is_num, 1) ThenBlock: {
                            cmd_handled = 0

                            // === M / m: moveto ===
                            IfCondition Or(EqualTo(cur_cmd, 77), EqualTo(cur_cmd, 109)) ThenBlock: {
                                nx = SVG_ReadNum256(d, p)
                                p = SVGPath.has_cp
                                ny = SVG_ReadNum256(d, p)
                                p = SVGPath.has_cp
                                IfCondition EqualTo(cur_cmd, 109) ThenBlock: {
                                    nx = Add(cx, nx)
                                    ny = Add(cy, ny)
                                }
                                SVG_PathAddCmd(SVGCmdType.MOVE, nx, ny, 0, 0, 0)
                                cx = nx
                                cy = ny
                                sx = nx
                                sy = ny
                                has_lcp = 0
                                cmd_handled = 1
                                // Implicit lineto after M (for subsequent coord pairs)
                                IfCondition EqualTo(cur_cmd, 77) ThenBlock: { cur_cmd = 76 }
                                IfCondition EqualTo(cur_cmd, 109) ThenBlock: { cur_cmd = 108 }
                            }

                            // === L / l: lineto ===
                            IfCondition And(EqualTo(cmd_handled, 0), Or(EqualTo(cur_cmd, 76), EqualTo(cur_cmd, 108))) ThenBlock: {
                                nx = SVG_ReadNum256(d, p)
                                p = SVGPath.has_cp
                                ny = SVG_ReadNum256(d, p)
                                p = SVGPath.has_cp
                                IfCondition EqualTo(cur_cmd, 108) ThenBlock: {
                                    nx = Add(cx, nx)
                                    ny = Add(cy, ny)
                                }
                                SVG_PathAddCmd(SVGCmdType.LINE, nx, ny, 0, 0, 0)
                                cx = nx
                                cy = ny
                                has_lcp = 0
                            }

                            // === H / h: horizontal lineto ===
                            IfCondition Or(EqualTo(cur_cmd, 72), EqualTo(cur_cmd, 104)) ThenBlock: {
                                nx = SVG_ReadNum256(d, p)
                                p = SVGPath.has_cp
                                IfCondition EqualTo(cur_cmd, 104) ThenBlock: {
                                    nx = Add(cx, nx)
                                }
                                SVG_PathAddCmd(SVGCmdType.LINE, nx, cy, 0, 0, 0)
                                cx = nx
                                has_lcp = 0
                            }

                            // === V / v: vertical lineto ===
                            IfCondition Or(EqualTo(cur_cmd, 86), EqualTo(cur_cmd, 118)) ThenBlock: {
                                ny = SVG_ReadNum256(d, p)
                                p = SVGPath.has_cp
                                IfCondition EqualTo(cur_cmd, 118) ThenBlock: {
                                    ny = Add(cy, ny)
                                }
                                SVG_PathAddCmd(SVGCmdType.LINE, cx, ny, 0, 0, 0)
                                cy = ny
                                has_lcp = 0
                            }

                            // === C / c: cubic bezier ===
                            IfCondition Or(EqualTo(cur_cmd, 67), EqualTo(cur_cmd, 99)) ThenBlock: {
                                cp1x = SVG_ReadNum256(d, p)
                                p = SVGPath.has_cp
                                cp1y = SVG_ReadNum256(d, p)
                                p = SVGPath.has_cp
                                cp2x = SVG_ReadNum256(d, p)
                                p = SVGPath.has_cp
                                cp2y = SVG_ReadNum256(d, p)
                                p = SVGPath.has_cp
                                ex = SVG_ReadNum256(d, p)
                                p = SVGPath.has_cp
                                ey = SVG_ReadNum256(d, p)
                                p = SVGPath.has_cp
                                IfCondition EqualTo(cur_cmd, 99) ThenBlock: {
                                    cp1x = Add(cx, cp1x)
                                    cp1y = Add(cy, cp1y)
                                    cp2x = Add(cx, cp2x)
                                    cp2y = Add(cy, cp2y)
                                    ex = Add(cx, ex)
                                    ey = Add(cy, ey)
                                }
                                SVGPath.tmp_y2 = cp2y
                                SVG_PathAddCmd(SVGCmdType.CUBIC, ex, ey, cp1x, cp1y, cp2x)
                                lcpx = cp2x
                                lcpy = cp2y
                                has_lcp = 1
                                cx = ex
                                cy = ey
                            }

                            // === S / s: smooth cubic ===
                            IfCondition Or(EqualTo(cur_cmd, 83), EqualTo(cur_cmd, 115)) ThenBlock: {
                                // Reflect last control point
                                IfCondition EqualTo(has_lcp, 1) ThenBlock: {
                                    rcp1x = Subtract(Multiply(cx, 2), lcpx)
                                    rcp1y = Subtract(Multiply(cy, 2), lcpy)
                                } ElseBlock: {
                                    rcp1x = cx
                                    rcp1y = cy
                                }
                                cp2x = SVG_ReadNum256(d, p)
                                p = SVGPath.has_cp
                                cp2y = SVG_ReadNum256(d, p)
                                p = SVGPath.has_cp
                                ex = SVG_ReadNum256(d, p)
                                p = SVGPath.has_cp
                                ey = SVG_ReadNum256(d, p)
                                p = SVGPath.has_cp
                                IfCondition EqualTo(cur_cmd, 115) ThenBlock: {
                                    cp2x = Add(cx, cp2x)
                                    cp2y = Add(cy, cp2y)
                                    ex = Add(cx, ex)
                                    ey = Add(cy, ey)
                                }
                                SVGPath.tmp_y2 = cp2y
                                SVG_PathAddCmd(SVGCmdType.CUBIC, ex, ey, rcp1x, rcp1y, cp2x)
                                lcpx = cp2x
                                lcpy = cp2y
                                has_lcp = 1
                                cx = ex
                                cy = ey
                            }

                            // === Q / q: quadratic bezier ===
                            IfCondition Or(EqualTo(cur_cmd, 81), EqualTo(cur_cmd, 113)) ThenBlock: {
                                cpx = SVG_ReadNum256(d, p)
                                p = SVGPath.has_cp
                                cpy = SVG_ReadNum256(d, p)
                                p = SVGPath.has_cp
                                ex = SVG_ReadNum256(d, p)
                                p = SVGPath.has_cp
                                ey = SVG_ReadNum256(d, p)
                                p = SVGPath.has_cp
                                IfCondition EqualTo(cur_cmd, 113) ThenBlock: {
                                    cpx = Add(cx, cpx)
                                    cpy = Add(cy, cpy)
                                    ex = Add(cx, ex)
                                    ey = Add(cy, ey)
                                }
                                SVG_PathAddCmd(SVGCmdType.QUAD, ex, ey, cpx, cpy, 0)
                                lcpx = cpx
                                lcpy = cpy
                                has_lcp = 1
                                cx = ex
                                cy = ey
                            }

                            // === T / t: smooth quadratic ===
                            IfCondition Or(EqualTo(cur_cmd, 84), EqualTo(cur_cmd, 116)) ThenBlock: {
                                IfCondition EqualTo(has_lcp, 1) ThenBlock: {
                                    rcpx = Subtract(Multiply(cx, 2), lcpx)
                                    rcpy = Subtract(Multiply(cy, 2), lcpy)
                                } ElseBlock: {
                                    rcpx = cx
                                    rcpy = cy
                                }
                                ex = SVG_ReadNum256(d, p)
                                p = SVGPath.has_cp
                                ey = SVG_ReadNum256(d, p)
                                p = SVGPath.has_cp
                                IfCondition EqualTo(cur_cmd, 116) ThenBlock: {
                                    ex = Add(cx, ex)
                                    ey = Add(cy, ey)
                                }
                                SVG_PathAddCmd(SVGCmdType.QUAD, ex, ey, rcpx, rcpy, 0)
                                lcpx = rcpx
                                lcpy = rcpy
                                has_lcp = 1
                                cx = ex
                                cy = ey
                            }

                            // === A / a: arc (approximate as line for now) ===
                            IfCondition Or(EqualTo(cur_cmd, 65), EqualTo(cur_cmd, 97)) ThenBlock: {
                                // Read 7 params: rx ry xrot largeArc sweep ex ey
                                arx = SVG_ReadNum256(d, p)
                                p = SVGPath.has_cp
                                ary = SVG_ReadNum256(d, p)
                                p = SVGPath.has_cp
                                axrot = SVG_ReadNum256(d, p)
                                p = SVGPath.has_cp
                                alarge = SVG_ReadNum256(d, p)
                                p = SVGPath.has_cp
                                asweep = SVG_ReadNum256(d, p)
                                p = SVGPath.has_cp
                                ex = SVG_ReadNum256(d, p)
                                p = SVGPath.has_cp
                                ey = SVG_ReadNum256(d, p)
                                p = SVGPath.has_cp
                                IfCondition EqualTo(cur_cmd, 97) ThenBlock: {
                                    ex = Add(cx, ex)
                                    ey = Add(cy, ey)
                                }
                                // Arc-to-cubic bezier conversion
                                // large_arc and sweep are flags (0 or 1), stored as 256× fp
                                la_flag = Divide(alarge, 256)
                                sw_flag = Divide(asweep, 256)
                                rot_deg = Divide(axrot, 256)
                                SVG_ArcToCubics(cx, cy, arx, ary, rot_deg, la_flag, sw_flag, ex, ey)
                                cx = ex
                                cy = ey
                                has_lcp = 0
                            }

                        } ElseBlock: {
                            // Not a number and not a command — skip this byte
                            IfCondition EqualTo(is_cmd, 0) ThenBlock: {
                                p = Add(p, 1)
                            }
                        }
                    }
                }

                // If we didn't recognize anything and didn't advance, skip
                IfCondition And(EqualTo(is_cmd, 0), EqualTo(cur_cmd, 0)) ThenBlock: {
                    p = Add(p, 1)
                }
            }
        }

        SVGPath.cur_x = cx
        SVGPath.cur_y = cy
        ReturnValue(0)
    }
}

// =============================================================================
// PATH → EDGE EMISSION — feeds parsed path commands into VIF rasterizer
// =============================================================================

// SVG_EmitPath: convert parsed SVG path commands to VIF edges.
// Coordinates are already 256× fp from parser; map through viewBox.
// Call RastState.edge_count = 0 before this, then TVG_FillWithColor after.
Function.SVG_EmitPath {
    Body: {
        n = SVGPath.cmd_count
        cmds = SVGPath.cmds
        px = 0
        py = 0
        fx = 0
        fy = 0

        i = 0
        WhileLoop LessThan(i, n) {
            base = Add(cmds, Multiply(i, SVGConst.CMD_ENTRY_SIZE))
            ct = Dereference(Add(base, SVGPCmd.TYPE))
            x0 = Dereference(Add(base, SVGPCmd.X0))
            y0 = Dereference(Add(base, SVGPCmd.Y0))
            c1x = Dereference(Add(base, SVGPCmd.X1))
            c1y = Dereference(Add(base, SVGPCmd.Y1))
            c2x = Dereference(Add(base, SVGPCmd.X2))
            c2y = Dereference(Add(base, SVGPCmd.Y2))

            // Apply current transform matrix to all coord pairs
            xbase_e = SVGXform.stack
            IfCondition NotEqual(xbase_e, 0) ThenBlock: {
                // Read matrix at current depth
                off_e = Multiply(SVGXform.depth, 48)
                cur_e = Add(xbase_e, off_e)
                xa = Dereference(cur_e)
                xb = Dereference(Add(cur_e, 8))
                xc = Dereference(Add(cur_e, 16))
                xd = Dereference(Add(cur_e, 24))
                xe = Dereference(Add(cur_e, 32))
                xf_v = Dereference(Add(cur_e, 40))
                // Skip if identity matrix
                is_ident = 1
                IfCondition NotEqual(xa, 256) ThenBlock: { is_ident = 0 }
                IfCondition NotEqual(xb, 0) ThenBlock: { is_ident = 0 }
                IfCondition NotEqual(xc, 0) ThenBlock: { is_ident = 0 }
                IfCondition NotEqual(xd, 256) ThenBlock: { is_ident = 0 }
                IfCondition NotEqual(xe, 0) ThenBlock: { is_ident = 0 }
                IfCondition NotEqual(xf_v, 0) ThenBlock: { is_ident = 0 }
                IfCondition EqualTo(is_ident, 0) ThenBlock: {
                    // result_x = a*x/256 + c*y/256 + e
                    // result_y = b*x/256 + d*y/256 + f
                    // Transform (x0,y0)
                    nx0 = Add(Add(Divide(Multiply(xa, x0), 256), Divide(Multiply(xc, y0), 256)), xe)
                    ny0 = Add(Add(Divide(Multiply(xb, x0), 256), Divide(Multiply(xd, y0), 256)), xf_v)
                    x0 = nx0
                    y0 = ny0
                    // Transform (c1x,c1y)
                    nc1x = Add(Add(Divide(Multiply(xa, c1x), 256), Divide(Multiply(xc, c1y), 256)), xe)
                    nc1y = Add(Add(Divide(Multiply(xb, c1x), 256), Divide(Multiply(xd, c1y), 256)), xf_v)
                    c1x = nc1x
                    c1y = nc1y
                    // Transform (c2x,c2y)
                    nc2x = Add(Add(Divide(Multiply(xa, c2x), 256), Divide(Multiply(xc, c2y), 256)), xe)
                    nc2y = Add(Add(Divide(Multiply(xb, c2x), 256), Divide(Multiply(xd, c2y), 256)), xf_v)
                    c2x = nc2x
                    c2y = nc2y
                }
            }

            // Map all coords through viewBox
            mx0 = SVG_MapX(x0)
            my0 = SVG_MapY(y0)
            mc1x = SVG_MapX(c1x)
            mc1y = SVG_MapY(c1y)
            mc2x = SVG_MapX(c2x)
            mc2y = SVG_MapY(c2y)

            IfCondition EqualTo(ct, SVGCmdType.MOVE) ThenBlock: {
                px = mx0
                py = my0
                fx = mx0
                fy = my0
            }

            IfCondition EqualTo(ct, SVGCmdType.LINE) ThenBlock: {
                TVG_AddEdge(px, py, mx0, my0)
                px = mx0
                py = my0
            }

            IfCondition EqualTo(ct, SVGCmdType.CUBIC) ThenBlock: {
                BezEnd.x1 = mx0
                BezEnd.y1 = my0
                TVG_FlattenCubic(px, py, mc1x, mc1y, mc2x, mc2y)
                px = mx0
                py = my0
            }

            IfCondition EqualTo(ct, SVGCmdType.QUAD) ThenBlock: {
                // Convert quadratic to cubic: cp1 = p0 + 2/3*(cp-p0), cp2 = p1 + 2/3*(cp-p1)
                // In integer: cp1 = p0 + (2*(cp-p0))/3
                qc1x = Add(px, Divide(Multiply(Subtract(mc1x, px), 2), 3))
                qc1y = Add(py, Divide(Multiply(Subtract(mc1y, py), 2), 3))
                qc2x = Add(mx0, Divide(Multiply(Subtract(mc1x, mx0), 2), 3))
                qc2y = Add(my0, Divide(Multiply(Subtract(mc1y, my0), 2), 3))
                BezEnd.x1 = mx0
                BezEnd.y1 = my0
                TVG_FlattenCubic(px, py, qc1x, qc1y, qc2x, qc2y)
                px = mx0
                py = my0
            }

            IfCondition EqualTo(ct, SVGCmdType.CLOSE) ThenBlock: {
                TVG_AddEdge(px, py, fx, fy)
                px = fx
                py = fy
            }

            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

// =============================================================================
// SHAPE RENDERERS — convert SVG shape elements to path commands, then emit
// =============================================================================

// SVG_RenderRect: render a <rect> element
Function.SVG_RenderRect {
    Input: color: Integer
    Body: {
        x_str = SVG_GetAttr("x")
        y_str = SVG_GetAttr("y")
        w_str = SVG_GetAttr("width")
        h_str = SVG_GetAttr("height")
        rx_str = SVG_GetAttr("rx")
        ry_str = SVG_GetAttr("ry")

        x = SVG_ParseFixed256(x_str)
        y = SVG_ParseFixed256(y_str)
        w = SVG_ParseFixed256(w_str)
        h = SVG_ParseFixed256(h_str)
        rx = SVG_ParseFixed256(rx_str)
        ry = SVG_ParseFixed256(ry_str)

        IfCondition EqualTo(ry, 0) ThenBlock: { ry = rx }

        // Clamp rx/ry to half dimensions
        half_w = Divide(w, 2)
        half_h = Divide(h, 2)
        IfCondition GreaterThan(rx, half_w) ThenBlock: { rx = half_w }
        IfCondition GreaterThan(ry, half_h) ThenBlock: { ry = half_h }

        SVG_PathReset()

        IfCondition And(GreaterThan(rx, 0), GreaterThan(ry, 0)) ThenBlock: {
            // Rounded rectangle using cubic bezier corners
            // kappa = 0.5522847 → in 256× fp = 141
            kx = Divide(Multiply(rx, 141), 256)
            ky = Divide(Multiply(ry, 141), 256)

            x_rx = Add(x, rx)
            xw = Add(x, w)
            xw_rx = Subtract(xw, rx)
            yh = Add(y, h)
            y_ry = Add(y, ry)
            yh_ry = Subtract(yh, ry)

            SVG_PathAddCmd(SVGCmdType.MOVE, x_rx, y, 0, 0, 0)
            SVG_PathAddCmd(SVGCmdType.LINE, xw_rx, y, 0, 0, 0)
            // Top-right corner
            SVGPath.tmp_y2 = Subtract(y_ry, ky)
            SVG_PathAddCmd(SVGCmdType.CUBIC, xw, y_ry,
                           Add(xw_rx, kx), y,
                           xw)
            SVG_PathAddCmd(SVGCmdType.LINE, xw, yh_ry, 0, 0, 0)
            // Bottom-right corner
            SVGPath.tmp_y2 = yh
            SVG_PathAddCmd(SVGCmdType.CUBIC, xw_rx, yh,
                           xw, Add(yh_ry, ky),
                           Add(xw_rx, kx))
            SVG_PathAddCmd(SVGCmdType.LINE, x_rx, yh, 0, 0, 0)
            // Bottom-left corner
            SVGPath.tmp_y2 = Add(yh_ry, ky)
            SVG_PathAddCmd(SVGCmdType.CUBIC, x, yh_ry,
                           Subtract(x_rx, kx), yh,
                           x)
            SVG_PathAddCmd(SVGCmdType.LINE, x, y_ry, 0, 0, 0)
            // Top-left corner
            SVGPath.tmp_y2 = y
            SVG_PathAddCmd(SVGCmdType.CUBIC, x_rx, y,
                           x, Subtract(y_ry, ky),
                           Subtract(x_rx, kx))
            SVG_PathAddCmd(SVGCmdType.CLOSE, 0, 0, 0, 0)
        } ElseBlock: {
            // Simple rectangle
            xw = Add(x, w)
            yh = Add(y, h)
            SVG_PathAddCmd(SVGCmdType.MOVE, x, y, 0, 0, 0)
            SVG_PathAddCmd(SVGCmdType.LINE, xw, y, 0, 0, 0)
            SVG_PathAddCmd(SVGCmdType.LINE, xw, yh, 0, 0, 0)
            SVG_PathAddCmd(SVGCmdType.LINE, x, yh, 0, 0, 0)
            SVG_PathAddCmd(SVGCmdType.CLOSE, 0, 0, 0, 0)
        }

        RastState.edge_count = 0
        SVG_EmitPath()
        TVG_FillWithColor(color)
        ReturnValue(0)
    }
}

// SVG_RenderCircle: render a <circle> element
Function.SVG_RenderCircle {
    Input: color: Integer
    Body: {
        cx_str = SVG_GetAttr("cx")
        cy_str = SVG_GetAttr("cy")
        r_str = SVG_GetAttr("r")

        cx = SVG_ParseFixed256(cx_str)
        cy = SVG_ParseFixed256(cy_str)
        r = SVG_ParseFixed256(r_str)
        IfCondition LessEqual(r, 0) ThenBlock: { ReturnValue(0) }

        // 4-arc cubic bezier approximation
        k = Divide(Multiply(r, 141), 256)

        SVG_PathReset()
        SVG_PathAddCmd(SVGCmdType.MOVE, cx, Subtract(cy, r), 0, 0, 0)
        SVGPath.tmp_y2 = Subtract(cy, k)
        SVG_PathAddCmd(SVGCmdType.CUBIC, Add(cx, r), cy,
                       Add(cx, k), Subtract(cy, r),
                       Add(cx, r))
        SVGPath.tmp_y2 = Add(cy, r)
        SVG_PathAddCmd(SVGCmdType.CUBIC, cx, Add(cy, r),
                       Add(cx, r), Add(cy, k),
                       Add(cx, k))
        SVGPath.tmp_y2 = Add(cy, k)
        SVG_PathAddCmd(SVGCmdType.CUBIC, Subtract(cx, r), cy,
                       Subtract(cx, k), Add(cy, r),
                       Subtract(cx, r))
        SVGPath.tmp_y2 = Subtract(cy, r)
        SVG_PathAddCmd(SVGCmdType.CUBIC, cx, Subtract(cy, r),
                       Subtract(cx, r), Subtract(cy, k),
                       Subtract(cx, k))
        SVG_PathAddCmd(SVGCmdType.CLOSE, 0, 0, 0, 0)

        RastState.edge_count = 0
        SVG_EmitPath()
        TVG_FillWithColor(color)
        ReturnValue(0)
    }
}

// SVG_RenderEllipse: render an <ellipse> element
Function.SVG_RenderEllipse {
    Input: color: Integer
    Body: {
        cx_str = SVG_GetAttr("cx")
        cy_str = SVG_GetAttr("cy")
        rx_str = SVG_GetAttr("rx")
        ry_str = SVG_GetAttr("ry")

        cx = SVG_ParseFixed256(cx_str)
        cy = SVG_ParseFixed256(cy_str)
        rx = SVG_ParseFixed256(rx_str)
        ry = SVG_ParseFixed256(ry_str)
        IfCondition Or(LessEqual(rx, 0), LessEqual(ry, 0)) ThenBlock: { ReturnValue(0) }

        kx = Divide(Multiply(rx, 141), 256)
        ky = Divide(Multiply(ry, 141), 256)

        SVG_PathReset()
        SVG_PathAddCmd(SVGCmdType.MOVE, cx, Subtract(cy, ry), 0, 0, 0)
        SVGPath.tmp_y2 = Subtract(cy, ky)
        SVG_PathAddCmd(SVGCmdType.CUBIC, Add(cx, rx), cy,
                       Add(cx, kx), Subtract(cy, ry),
                       Add(cx, rx))
        SVGPath.tmp_y2 = Add(cy, ry)
        SVG_PathAddCmd(SVGCmdType.CUBIC, cx, Add(cy, ry),
                       Add(cx, rx), Add(cy, ky),
                       Add(cx, kx))
        SVGPath.tmp_y2 = Add(cy, ky)
        SVG_PathAddCmd(SVGCmdType.CUBIC, Subtract(cx, rx), cy,
                       Subtract(cx, kx), Add(cy, ry),
                       Subtract(cx, rx))
        SVGPath.tmp_y2 = Subtract(cy, ry)
        SVG_PathAddCmd(SVGCmdType.CUBIC, cx, Subtract(cy, ry),
                       Subtract(cx, rx), Subtract(cy, ky),
                       Subtract(cx, kx))
        SVG_PathAddCmd(SVGCmdType.CLOSE, 0, 0, 0, 0)

        RastState.edge_count = 0
        SVG_EmitPath()
        TVG_FillWithColor(color)
        ReturnValue(0)
    }
}

// SVG_RenderRect_Stroke: stroke the current rect path (path still in buffer from fill pass)
Function.SVG_RenderRect_Stroke {
    Input: color: Integer
    Input: sw: Integer
    Body: {
        RastState.edge_count = 0
        StrokeState.active = 1
        StrokeState.half_width = Divide(sw, 2)
        SVG_EmitPath()
        StrokeState.active = 0
        TVG_FillWithColor(color)
        ReturnValue(0)
    }
}

// SVG_RenderCircle_Stroke: stroke the current circle path
Function.SVG_RenderCircle_Stroke {
    Input: color: Integer
    Input: sw: Integer
    Body: {
        // Circle path is still in buffer from fill pass — re-emit with stroke
        RastState.edge_count = 0
        StrokeState.active = 1
        StrokeState.half_width = Divide(sw, 2)
        SVG_EmitPath()
        StrokeState.active = 0
        TVG_FillWithColor(color)
        ReturnValue(0)
    }
}

// SVG_RenderEllipse_Stroke: stroke the current ellipse path
Function.SVG_RenderEllipse_Stroke {
    Input: color: Integer
    Input: sw: Integer
    Body: {
        // Ellipse path is still in buffer from fill pass — re-emit with stroke
        RastState.edge_count = 0
        StrokeState.active = 1
        StrokeState.half_width = Divide(sw, 2)
        SVG_EmitPath()
        StrokeState.active = 0
        TVG_FillWithColor(color)
        ReturnValue(0)
    }
}

// SVG_RenderLine: render a <line> element as stroked path
Function.SVG_RenderLine {
    Input: color: Integer
    Input: stroke_w: Integer
    Body: {
        x1_str = SVG_GetAttr("x1")
        y1_str = SVG_GetAttr("y1")
        x2_str = SVG_GetAttr("x2")
        y2_str = SVG_GetAttr("y2")

        lx1 = SVG_ParseFixed256(x1_str)
        ly1 = SVG_ParseFixed256(y1_str)
        lx2 = SVG_ParseFixed256(x2_str)
        ly2 = SVG_ParseFixed256(y2_str)

        // Map to surface coordinates
        mx1 = SVG_MapX(lx1)
        my1 = SVG_MapY(ly1)
        mx2 = SVG_MapX(lx2)
        my2 = SVG_MapY(ly2)

        // Use stroke emit for thick line
        hw = Divide(stroke_w, 2)
        IfCondition LessThan(hw, 128) ThenBlock: { hw = 128 }
        RastState.edge_count = 0
        StrokeState.active = 0
        TVG_StrokeEmit(mx1, my1, mx2, my2, hw)
        TVG_FillWithColor(color)
        ReturnValue(0)
    }
}

// SVG_RenderPolygon: render a <polygon> element (filled closed shape)
Function.SVG_RenderPolygon {
    Input: color: Integer
    Body: {
        pts_str = SVG_GetAttr("points")
        IfCondition EqualTo(pts_str, 0) ThenBlock: { ReturnValue(0) }

        SVG_PathReset()
        p = 0
        pt_idx = 0
        first = 1

        pmore = 1
        WhileLoop EqualTo(pmore, 1) {
            p = SVG_SkipNumSep(pts_str, p)
            c = GetByte(pts_str, p)
            IfCondition EqualTo(c, 0) ThenBlock: { pmore = 0 }
            IfCondition EqualTo(pmore, 1) ThenBlock: {
                is_n = 0
                IfCondition And(GreaterEqual(c, 48), LessEqual(c, 57)) ThenBlock: { is_n = 1 }
                IfCondition EqualTo(c, 45) ThenBlock: { is_n = 1 }
                IfCondition EqualTo(c, 43) ThenBlock: { is_n = 1 }
                IfCondition EqualTo(c, 46) ThenBlock: { is_n = 1 }

                IfCondition EqualTo(is_n, 1) ThenBlock: {
                    px = SVG_ReadNum256(pts_str, p)
                    p = SVGPath.has_cp
                    py = SVG_ReadNum256(pts_str, p)
                    p = SVGPath.has_cp
                    IfCondition EqualTo(first, 1) ThenBlock: {
                        SVG_PathAddCmd(SVGCmdType.MOVE, px, py, 0, 0, 0)
                        first = 0
                    } ElseBlock: {
                        SVG_PathAddCmd(SVGCmdType.LINE, px, py, 0, 0, 0)
                    }
                } ElseBlock: {
                    p = Add(p, 1)
                }
            }
        }
        SVG_PathAddCmd(SVGCmdType.CLOSE, 0, 0, 0, 0)

        RastState.edge_count = 0
        SVG_EmitPath()
        TVG_FillWithColor(color)
        ReturnValue(0)
    }
}

// SVG_RenderPolyline: render a <polyline> element (stroked open shape)
Function.SVG_RenderPolyline {
    Input: color: Integer
    Input: stroke_w: Integer
    Body: {
        pts_str = SVG_GetAttr("points")
        IfCondition EqualTo(pts_str, 0) ThenBlock: { ReturnValue(0) }

        hw = Divide(stroke_w, 2)
        IfCondition LessThan(hw, 128) ThenBlock: { hw = 128 }

        p = 0
        prev_x = 0
        prev_y = 0
        first = 1
        RastState.edge_count = 0

        pmore = 1
        WhileLoop EqualTo(pmore, 1) {
            p = SVG_SkipNumSep(pts_str, p)
            c = GetByte(pts_str, p)
            IfCondition EqualTo(c, 0) ThenBlock: { pmore = 0 }
            IfCondition EqualTo(pmore, 1) ThenBlock: {
                is_n = 0
                IfCondition And(GreaterEqual(c, 48), LessEqual(c, 57)) ThenBlock: { is_n = 1 }
                IfCondition EqualTo(c, 45) ThenBlock: { is_n = 1 }
                IfCondition EqualTo(c, 43) ThenBlock: { is_n = 1 }
                IfCondition EqualTo(c, 46) ThenBlock: { is_n = 1 }

                IfCondition EqualTo(is_n, 1) ThenBlock: {
                    px = SVG_ReadNum256(pts_str, p)
                    p = SVGPath.has_cp
                    py = SVG_ReadNum256(pts_str, p)
                    p = SVGPath.has_cp
                    mx = SVG_MapX(px)
                    my = SVG_MapY(py)
                    IfCondition EqualTo(first, 1) ThenBlock: {
                        first = 0
                    } ElseBlock: {
                        TVG_StrokeEmit(prev_x, prev_y, mx, my, hw)
                    }
                    prev_x = mx
                    prev_y = my
                } ElseBlock: {
                    p = Add(p, 1)
                }
            }
        }

        TVG_FillWithColor(color)
        ReturnValue(0)
    }
}

// =============================================================================
// VIEWBOX PARSER
// =============================================================================
Function.SVG_ParseViewBox {
    Input: vb_str: Address
    Body: {
        IfCondition EqualTo(vb_str, 0) ThenBlock: { ReturnValue(0) }
        p = 0
        vx = SVG_ReadNum256(vb_str, p)
        p = SVGPath.has_cp
        vy = SVG_ReadNum256(vb_str, p)
        p = SVGPath.has_cp
        vw = SVG_ReadNum256(vb_str, p)
        p = SVGPath.has_cp
        vh = SVG_ReadNum256(vb_str, p)

        SVGState.vb_x = vx
        SVGState.vb_y = vy
        SVGState.vb_w = vw
        SVGState.vb_h = vh
        ReturnValue(0)
    }
}

// =============================================================================
// TRANSFORM STACK — 3×2 affine matrix [a b c d e f]
// All values in 256× fixed-point (256 = 1.0)
// Transforms applied: result_x = a*x + c*y + e, result_y = b*x + d*y + f
// =============================================================================

// SVG_XformGetCurrent: return address of current transform matrix (6 × 8 bytes)
Function.SVG_XformGetCurrent {
    Output: Address
    Body: {
        d = SVGXform.depth
        off = Multiply(d, SVGConst.XFORM_ENTRY)
        ReturnValue(Add(SVGXform.stack, off))
    }
}

// SVG_XformPush: duplicate current transform onto stack
Function.SVG_XformPush {
    Body: {
        d = SVGXform.depth
        IfCondition GreaterEqual(d, Subtract(SVGConst.MAX_XFORM, 1)) ThenBlock: {
            ReturnValue(0)
        }
        src = Add(SVGXform.stack, Multiply(d, SVGConst.XFORM_ENTRY))
        nd = Add(d, 1)
        dst = Add(SVGXform.stack, Multiply(nd, SVGConst.XFORM_ENTRY))
        // Copy 6 values (48 bytes)
        StoreValue(Add(dst, 0),  Dereference(Add(src, 0)))
        StoreValue(Add(dst, 8),  Dereference(Add(src, 8)))
        StoreValue(Add(dst, 16), Dereference(Add(src, 16)))
        StoreValue(Add(dst, 24), Dereference(Add(src, 24)))
        StoreValue(Add(dst, 32), Dereference(Add(src, 32)))
        StoreValue(Add(dst, 40), Dereference(Add(src, 40)))
        SVGXform.depth = nd
        ReturnValue(0)
    }
}

// SVG_XformPop: restore previous transform
Function.SVG_XformPop {
    Body: {
        d = SVGXform.depth
        IfCondition GreaterThan(d, 0) ThenBlock: {
            SVGXform.depth = Subtract(d, 1)
        }
        ReturnValue(0)
    }
}

// SVG_XformMultiply: multiply current matrix by [a b c d e f] (post-multiply)
// Result = current × new
// [ra rb] = [oa ob] × [na nb]   i.e. ra = oa*na + oc*nb, etc.
// [rc rd]   [oc od]   [nc nd]
// [re rf]   [oe of]   [ne nf]
Function.SVG_XformMultiply {
    Input: na: Integer
    Input: nb: Integer
    Input: nc: Integer
    Input: nd: Integer
    Input: ne: Integer
    Input: nf: Integer
    Body: {
        m = SVG_XformGetCurrent()
        oa = Dereference(Add(m, 0))
        ob = Dereference(Add(m, 8))
        oc = Dereference(Add(m, 16))
        od = Dereference(Add(m, 24))
        oe = Dereference(Add(m, 32))
        of_v = Dereference(Add(m, 40))

        // ra = oa*na/256 + oc*nb/256
        ra = Add(Divide(Multiply(oa, na), 256), Divide(Multiply(oc, nb), 256))
        // rb = ob*na/256 + od*nb/256
        rb = Add(Divide(Multiply(ob, na), 256), Divide(Multiply(od, nb), 256))
        // rc = oa*nc/256 + oc*nd/256
        rc = Add(Divide(Multiply(oa, nc), 256), Divide(Multiply(oc, nd), 256))
        // rd = ob*nc/256 + od*nd/256
        rd = Add(Divide(Multiply(ob, nc), 256), Divide(Multiply(od, nd), 256))
        // re = oa*ne/256 + oc*nf/256 + oe
        re = Add(Add(Divide(Multiply(oa, ne), 256), Divide(Multiply(oc, nf), 256)), oe)
        // rf = ob*ne/256 + od*nf/256 + of
        rf = Add(Add(Divide(Multiply(ob, ne), 256), Divide(Multiply(od, nf), 256)), of_v)

        StoreValue(Add(m, 0), ra)
        StoreValue(Add(m, 8), rb)
        StoreValue(Add(m, 16), rc)
        StoreValue(Add(m, 24), rd)
        StoreValue(Add(m, 32), re)
        StoreValue(Add(m, 40), rf)
        ReturnValue(0)
    }
}

// SVG_XformApply: transform a point (x,y) by current matrix → (out_x, out_y)
// Uses SVGPath scratch (has_cp for out_y, returns out_x)
Function.SVG_XformApply {
    Input: x: Integer
    Input: y: Integer
    Output: Integer
    Body: {
        m = SVG_XformGetCurrent()
        a = Dereference(Add(m, 0))
        b = Dereference(Add(m, 8))
        c = Dereference(Add(m, 16))
        d = Dereference(Add(m, 24))
        e = Dereference(Add(m, 32))
        f = Dereference(Add(m, 40))

        // out_x = a*x/256 + c*y/256 + e
        ox = Add(Add(Divide(Multiply(a, x), 256), Divide(Multiply(c, y), 256)), e)
        // out_y = b*x/256 + d*y/256 + f
        oy = Add(Add(Divide(Multiply(b, x), 256), Divide(Multiply(d, y), 256)), f)

        SVGPath.last_cpx = oy
        ReturnValue(ox)
    }
}

// SVG_ParseTransform: parse transform="..." attribute string and apply
// Handles: translate(x,y), rotate(a), scale(sx,sy), matrix(a,b,c,d,e,f),
//          skewX(a), skewY(a)
Function.SVG_ParseTransform {
    Input: str: Address
    Body: {
        IfCondition EqualTo(str, 0) ThenBlock: { ReturnValue(0) }
        p = 0

        tmore = 1
        WhileLoop EqualTo(tmore, 1) {
            p = SVG_SkipNumSep(str, p)
            c = GetByte(str, p)
            IfCondition EqualTo(c, 0) ThenBlock: { tmore = 0 }
            IfCondition EqualTo(tmore, 1) ThenBlock: {

                // "translate("
                IfCondition EqualTo(c, 116) ThenBlock: {
                    c1 = GetByte(str, Add(p, 1))
                    IfCondition EqualTo(c1, 114) ThenBlock: {
                        // Find '('
                        WhileLoop And(NotEqual(GetByte(str, p), 40), NotEqual(GetByte(str, p), 0)) {
                            p = Add(p, 1)
                        }
                        IfCondition EqualTo(GetByte(str, p), 40) ThenBlock: { p = Add(p, 1) }
                        tx = SVG_ReadNum256(str, p)
                        p = SVGPath.has_cp
                        p = SVG_SkipNumSep(str, p)
                        ty = 0
                        tc = GetByte(str, p)
                        is_n = 0
                        IfCondition And(GreaterEqual(tc, 48), LessEqual(tc, 57)) ThenBlock: { is_n = 1 }
                        IfCondition EqualTo(tc, 45) ThenBlock: { is_n = 1 }
                        IfCondition EqualTo(tc, 46) ThenBlock: { is_n = 1 }
                        IfCondition EqualTo(is_n, 1) ThenBlock: {
                            ty = SVG_ReadNum256(str, p)
                            p = SVGPath.has_cp
                        }
                        // translate = matrix(1,0,0,1,tx,ty)
                        SVG_XformMultiply(256, 0, 0, 256, tx, ty)
                        // Skip ')'
                        WhileLoop And(NotEqual(GetByte(str, p), 41), NotEqual(GetByte(str, p), 0)) {
                            p = Add(p, 1)
                        }
                        IfCondition EqualTo(GetByte(str, p), 41) ThenBlock: { p = Add(p, 1) }
                    } ElseBlock: {
                        p = Add(p, 1)
                    }
                }

                // "scale("
                IfCondition EqualTo(c, 115) ThenBlock: {
                    c1 = GetByte(str, Add(p, 1))
                    IfCondition EqualTo(c1, 99) ThenBlock: {
                        WhileLoop And(NotEqual(GetByte(str, p), 40), NotEqual(GetByte(str, p), 0)) {
                            p = Add(p, 1)
                        }
                        IfCondition EqualTo(GetByte(str, p), 40) ThenBlock: { p = Add(p, 1) }
                        sx = SVG_ReadNum256(str, p)
                        p = SVGPath.has_cp
                        p = SVG_SkipNumSep(str, p)
                        sy = sx
                        sc = GetByte(str, p)
                        is_n = 0
                        IfCondition And(GreaterEqual(sc, 48), LessEqual(sc, 57)) ThenBlock: { is_n = 1 }
                        IfCondition EqualTo(sc, 45) ThenBlock: { is_n = 1 }
                        IfCondition EqualTo(sc, 46) ThenBlock: { is_n = 1 }
                        IfCondition EqualTo(is_n, 1) ThenBlock: {
                            sy = SVG_ReadNum256(str, p)
                            p = SVGPath.has_cp
                        }
                        // scale = matrix(sx,0,0,sy,0,0)
                        SVG_XformMultiply(sx, 0, 0, sy, 0, 0)
                        WhileLoop And(NotEqual(GetByte(str, p), 41), NotEqual(GetByte(str, p), 0)) {
                            p = Add(p, 1)
                        }
                        IfCondition EqualTo(GetByte(str, p), 41) ThenBlock: { p = Add(p, 1) }
                    } ElseBlock: {
                        // Could be "skewX" or "skewY"
                        c2 = GetByte(str, Add(p, 1))
                        IfCondition EqualTo(c2, 107) ThenBlock: {
                            // "skew..."
                            c5 = GetByte(str, Add(p, 4))
                            WhileLoop And(NotEqual(GetByte(str, p), 40), NotEqual(GetByte(str, p), 0)) {
                                p = Add(p, 1)
                            }
                            IfCondition EqualTo(GetByte(str, p), 40) ThenBlock: { p = Add(p, 1) }
                            ang_fp = SVG_ReadNum256(str, p)
                            p = SVGPath.has_cp
                            // Convert angle from 256× fp degrees to integer degrees
                            ang_deg = Divide(ang_fp, 256)
                            // tan(angle) in 10000× scale
                            tan_val = Trig.Tan(ang_deg)
                            // Convert to 256× fp: tan_256 = tan_val * 256 / 10000
                            tan_256 = Divide(Multiply(tan_val, 256), 10000)
                            IfCondition EqualTo(c5, 88) ThenBlock: {
                                // skewX: matrix(1, 0, tan, 1, 0, 0)
                                SVG_XformMultiply(256, 0, tan_256, 256, 0, 0)
                            } ElseBlock: {
                                // skewY: matrix(1, tan, 0, 1, 0, 0)
                                SVG_XformMultiply(256, tan_256, 0, 256, 0, 0)
                            }
                            WhileLoop And(NotEqual(GetByte(str, p), 41), NotEqual(GetByte(str, p), 0)) {
                                p = Add(p, 1)
                            }
                            IfCondition EqualTo(GetByte(str, p), 41) ThenBlock: { p = Add(p, 1) }
                        } ElseBlock: {
                            p = Add(p, 1)
                        }
                    }
                }

                // "rotate("
                IfCondition EqualTo(c, 114) ThenBlock: {
                    c1 = GetByte(str, Add(p, 1))
                    IfCondition EqualTo(c1, 111) ThenBlock: {
                        WhileLoop And(NotEqual(GetByte(str, p), 40), NotEqual(GetByte(str, p), 0)) {
                            p = Add(p, 1)
                        }
                        IfCondition EqualTo(GetByte(str, p), 40) ThenBlock: { p = Add(p, 1) }
                        ang_fp = SVG_ReadNum256(str, p)
                        p = SVGPath.has_cp
                        ang_deg = Divide(ang_fp, 256)
                        // sin/cos from FixedPointTrig (returns 10000× scale)
                        sin_val = Trig.Sin(ang_deg)
                        cos_val = Trig.Cos(ang_deg)
                        // Convert to 256× fp
                        cos_256 = Divide(Multiply(cos_val, 256), 10000)
                        sin_256 = Divide(Multiply(sin_val, 256), 10000)
                        neg_sin = Subtract(0, sin_256)
                        // rotate = matrix(cos, sin, -sin, cos, 0, 0)
                        SVG_XformMultiply(cos_256, sin_256, neg_sin, cos_256, 0, 0)
                        WhileLoop And(NotEqual(GetByte(str, p), 41), NotEqual(GetByte(str, p), 0)) {
                            p = Add(p, 1)
                        }
                        IfCondition EqualTo(GetByte(str, p), 41) ThenBlock: { p = Add(p, 1) }
                    } ElseBlock: {
                        p = Add(p, 1)
                    }
                }

                // "matrix("
                IfCondition EqualTo(c, 109) ThenBlock: {
                    c1 = GetByte(str, Add(p, 1))
                    IfCondition EqualTo(c1, 97) ThenBlock: {
                        WhileLoop And(NotEqual(GetByte(str, p), 40), NotEqual(GetByte(str, p), 0)) {
                            p = Add(p, 1)
                        }
                        IfCondition EqualTo(GetByte(str, p), 40) ThenBlock: { p = Add(p, 1) }
                        ma = SVG_ReadNum256(str, p)
                        p = SVGPath.has_cp
                        mb = SVG_ReadNum256(str, p)
                        p = SVGPath.has_cp
                        mc = SVG_ReadNum256(str, p)
                        p = SVGPath.has_cp
                        md = SVG_ReadNum256(str, p)
                        p = SVGPath.has_cp
                        me = SVG_ReadNum256(str, p)
                        p = SVGPath.has_cp
                        mf = SVG_ReadNum256(str, p)
                        p = SVGPath.has_cp
                        SVG_XformMultiply(ma, mb, mc, md, me, mf)
                        WhileLoop And(NotEqual(GetByte(str, p), 41), NotEqual(GetByte(str, p), 0)) {
                            p = Add(p, 1)
                        }
                        IfCondition EqualTo(GetByte(str, p), 41) ThenBlock: { p = Add(p, 1) }
                    } ElseBlock: {
                        p = Add(p, 1)
                    }
                }

                // Unknown character — skip
                IfCondition And(NotEqual(c, 116), And(NotEqual(c, 115), And(NotEqual(c, 114), NotEqual(c, 109)))) ThenBlock: {
                    p = Add(p, 1)
                }
            }
        }
        ReturnValue(0)
    }
}

// =============================================================================
// ARC TO CUBIC BEZIER CONVERSION
// Endpoint parameterization → center parameterization → cubic bezier segments
// =============================================================================

// SVG_ArcToCubics: convert an SVG arc command to cubic bezier path commands.
// (x1,y1) = start, (x2,y2) = end, rx/ry = radii, x_rot = rotation (degrees),
// large_arc = 0/1, sweep = 0/1. All coords in 256× fp.
// Appends CUBIC commands to the path buffer.
Function.SVG_ArcToCubics {
    Input: x1: Integer
    Input: y1: Integer
    Input: rx_in: Integer
    Input: ry_in: Integer
    Input: x_rot_deg: Integer
    Input: large_arc: Integer
    Input: sweep: Integer
    Input: x2: Integer
    Input: y2: Integer
    Body: {
        // Degenerate: zero radii → line
        IfCondition Or(LessEqual(rx_in, 0), LessEqual(ry_in, 0)) ThenBlock: {
            SVG_PathAddCmd(SVGCmdType.LINE, x2, y2, 0, 0, 0)
            ReturnValue(0)
        }

        // Degenerate: same start/end → nothing
        IfCondition And(EqualTo(x1, x2), EqualTo(y1, y2)) ThenBlock: {
            ReturnValue(0)
        }

        rx = rx_in
        ry = ry_in

        // Compute midpoint
        dx = Divide(Subtract(x1, x2), 2)
        dy = Divide(Subtract(y1, y2), 2)

        // For simplicity with integer math, ignore x-axis rotation for now
        // (rotation is rare in practice and requires sin/cos of arbitrary angle)
        // x1' = cos(rot)*dx + sin(rot)*dy, y1' = -sin(rot)*dx + cos(rot)*dy
        // With rot=0: x1p = dx, y1p = dy
        x1p = dx
        y1p = dy

        // Check if radii are large enough; scale up if not
        // λ = (x1'^2/rx^2) + (y1'^2/ry^2), if λ > 1 → scale radii by sqrt(λ)
        // Using integer math: check x1p²*ry² + y1p²*rx² vs rx²*ry²
        // All in 256× fp so squares are 65536× scale
        x1p_sq = Divide(Multiply(x1p, x1p), 256)
        y1p_sq = Divide(Multiply(y1p, y1p), 256)
        rx_sq = Divide(Multiply(rx, rx), 256)
        ry_sq = Divide(Multiply(ry, ry), 256)

        lam_num = Add(Divide(Multiply(x1p_sq, 256), rx_sq), Divide(Multiply(y1p_sq, 256), ry_sq))
        IfCondition GreaterThan(lam_num, 256) ThenBlock: {
            // Scale radii: approximate sqrt via ISqrt
            // lam_num is in 256× fp, want sqrt → multiply by 256 for ISqrt input
            lam_big = Multiply(lam_num, 256)
            lam_sqrt = ISqrt(lam_big)
            // lam_sqrt is in ~256× scale (sqrt of 65536× = 256×)
            // Scale: rx = rx * lam_sqrt / 256
            rx = Divide(Multiply(rx, lam_sqrt), 256)
            ry = Divide(Multiply(ry, lam_sqrt), 256)
            rx_sq = Divide(Multiply(rx, rx), 256)
            ry_sq = Divide(Multiply(ry, ry), 256)
        }

        // Center parameterization:
        // cxp = ±sqrt((rx²ry² - rx²y1p² - ry²x1p²) / (rx²y1p² + ry²x1p²)) * rx*y1p/ry
        // cyp = ∓... * ry*x1p/rx
        // Sign: + if large_arc ≠ sweep, - otherwise

        sq_num = Subtract(Multiply(rx_sq, ry_sq),
                          Add(Divide(Multiply(rx_sq, y1p_sq), 256),
                              Divide(Multiply(ry_sq, x1p_sq), 256)))
        sq_den = Add(Divide(Multiply(rx_sq, y1p_sq), 256),
                     Divide(Multiply(ry_sq, x1p_sq), 256))

        IfCondition LessThan(sq_num, 0) ThenBlock: { sq_num = 0 }
        IfCondition LessEqual(sq_den, 0) ThenBlock: { sq_den = 1 }

        // sq_factor = sqrt(sq_num / sq_den) in 256× fp
        // = sqrt(sq_num * 256 / sq_den) * 16 (approximate)
        // Use ISqrt: input must be positive integer
        sq_ratio = Divide(Multiply(sq_num, 65536), sq_den)
        IfCondition LessThan(sq_ratio, 0) ThenBlock: { sq_ratio = 0 }
        sq_factor = ISqrt(sq_ratio)

        // Apply sign
        IfCondition EqualTo(large_arc, sweep) ThenBlock: {
            sq_factor = Subtract(0, sq_factor)
        }

        // cxp = sq_factor * rx * y1p / (ry * 256)
        // cyp = -sq_factor * ry * x1p / (rx * 256)
        IfCondition EqualTo(ry, 0) ThenBlock: { ry = 1 }
        IfCondition EqualTo(rx, 0) ThenBlock: { rx = 1 }
        cxp = Divide(Multiply(sq_factor, Divide(Multiply(rx, y1p), ry)), 256)
        cyp = Subtract(0, Divide(Multiply(sq_factor, Divide(Multiply(ry, x1p), rx)), 256))

        // Center in original coords: cx = cxp + (x1+x2)/2, cy = cyp + (y1+y2)/2
        ccx = Add(cxp, Divide(Add(x1, x2), 2))
        ccy = Add(cyp, Divide(Add(y1, y2), 2))

        // Approximate arc with up to 4 cubic bezier segments (90° each)
        // For simplicity, split into 4 quarter arcs max
        // Each 90° arc uses kappa = 0.5522847 (141/256)

        // Vector from center to start: ux = x1-ccx, uy = y1-ccy
        // Vector from center to end: vx = x2-ccx, vy = y2-ccy
        // Approximate: emit a single cubic from start to end using control points
        // offset by kappa * radius perpendicular to the radii

        // Simple approach: for arcs ≤ 90°, one cubic is enough
        // control1 = start + kappa * tangent_at_start
        // control2 = end - kappa * tangent_at_end

        // Tangent at start = perpendicular to (start - center)
        ux = Subtract(x1, ccx)
        uy = Subtract(y1, ccy)
        vx = Subtract(x2, ccx)
        vy = Subtract(y2, ccy)

        // k = 141 (kappa in 256× fp, but we need it as fraction of 256)
        // For sweep=1 (CW): tangent = (-uy, ux), for sweep=0 (CCW): tangent = (uy, -ux)
        IfCondition EqualTo(sweep, 1) ThenBlock: {
            t1x = Subtract(0, uy)
            t1y = ux
            t2x = vy
            t2y = Subtract(0, vx)
        } ElseBlock: {
            t1x = uy
            t1y = Subtract(0, ux)
            t2x = Subtract(0, vy)
            t2y = vx
        }

        // Scale tangents by kappa (141/256)
        cp1x = Add(x1, Divide(Multiply(t1x, 141), 256))
        cp1y = Add(y1, Divide(Multiply(t1y, 141), 256))
        cp2x = Add(x2, Divide(Multiply(t2x, 141), 256))
        cp2y = Add(y2, Divide(Multiply(t2y, 141), 256))

        SVGPath.tmp_y2 = cp2y
        SVG_PathAddCmd(SVGCmdType.CUBIC, x2, y2, cp1x, cp1y, cp2x)
        ReturnValue(0)
    }
}

// =============================================================================
// STRING HASH — simple djb2 hash for gradient id lookup
// =============================================================================
Function.SVG_StringHash {
    Input: str: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(str, 0) ThenBlock: { ReturnValue(0) }
        hash = 5381
        i = 0
        hmore = 1
        WhileLoop EqualTo(hmore, 1) {
            c = GetByte(str, i)
            IfCondition EqualTo(c, 0) ThenBlock: { hmore = 0 }
            IfCondition EqualTo(hmore, 1) ThenBlock: {
                // hash = hash * 33 + c
                hash = Add(Multiply(hash, 33), c)
                i = Add(i, 1)
            }
        }
        // Make positive
        IfCondition LessThan(hash, 0) ThenBlock: {
            hash = Subtract(0, hash)
        }
        ReturnValue(hash)
    }
}

// =============================================================================
// GRADIENT PARSING — parse <linearGradient>, <radialGradient>, <stop>
// =============================================================================

// SVG_GradFindById: find gradient by id hash. Returns entry address or 0.
Function.SVG_GradFindById {
    Input: id_hash: Integer
    Output: Address
    Body: {
        n = SVGGradTable.count
        base = SVGGradTable.data
        i = 0
        WhileLoop LessThan(i, n) {
            ep = Add(base, Multiply(i, SVGConst.GRAD_ENTRY))
            eh = Dereference(Add(ep, SVGGradField.ID_HASH))
            IfCondition EqualTo(eh, id_hash) ThenBlock: {
                ReturnValue(ep)
            }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

// SVG_GradCreate: create a new gradient entry. Returns index or -1.
Function.SVG_GradCreate {
    Input: gtype: Integer
    Input: id_hash: Integer
    Output: Integer
    Body: {
        n = SVGGradTable.count
        IfCondition GreaterEqual(n, SVGConst.MAX_GRADIENTS) ThenBlock: { ReturnValue(-1) }
        ep = Add(SVGGradTable.data, Multiply(n, SVGConst.GRAD_ENTRY))
        MemorySet(ep, 0, SVGConst.GRAD_ENTRY)
        StoreValue(Add(ep, SVGGradField.TYPE), gtype)
        StoreValue(Add(ep, SVGGradField.ID_HASH), id_hash)
        SVGGradTable.count = Add(n, 1)
        ReturnValue(n)
    }
}

// SVG_ParseDefsElement: handle elements inside <defs> block
Function.SVG_ParseDefsElement {
    Body: {
        tag = SVGElem.tag

        // Closing </defs>
        IfCondition EqualTo(SVGElem.is_close, 1) ThenBlock: {
            IfCondition EqualTo(StringCompare(tag, "defs"), 0) ThenBlock: {
                SVGDefsState.inside = 0
                ReturnValue(0)
            }
            // Closing gradient tag
            IfCondition Or(EqualTo(StringCompare(tag, "linearGradient"), 0),
                          EqualTo(StringCompare(tag, "radialGradient"), 0)) ThenBlock: {
                SVGDefsState.in_gradient = 0
                SVGDefsState.cur_grad_idx = -1
                ReturnValue(0)
            }
            ReturnValue(0)
        }

        // <linearGradient id="..." x1="" y1="" x2="" y2="">
        IfCondition EqualTo(StringCompare(tag, "linearGradient"), 0) ThenBlock: {
            id_str = SVG_GetAttr("id")
            id_hash = SVG_StringHash(id_str)
            gidx = SVG_GradCreate(SVGGradType.LINEAR, id_hash)
            IfCondition GreaterEqual(gidx, 0) ThenBlock: {
                ep = Add(SVGGradTable.data, Multiply(gidx, SVGConst.GRAD_ENTRY))
                x1_str = SVG_GetAttr("x1")
                y1_str = SVG_GetAttr("y1")
                x2_str = SVG_GetAttr("x2")
                y2_str = SVG_GetAttr("y2")
                IfCondition NotEqual(x1_str, 0) ThenBlock: {
                    StoreValue(Add(ep, SVGGradField.X1), SVG_ParseFixed256(x1_str))
                }
                IfCondition NotEqual(y1_str, 0) ThenBlock: {
                    StoreValue(Add(ep, SVGGradField.Y1), SVG_ParseFixed256(y1_str))
                }
                IfCondition NotEqual(x2_str, 0) ThenBlock: {
                    StoreValue(Add(ep, SVGGradField.X2), SVG_ParseFixed256(x2_str))
                }
                IfCondition NotEqual(y2_str, 0) ThenBlock: {
                    StoreValue(Add(ep, SVGGradField.Y2), SVG_ParseFixed256(y2_str))
                }
                // Check gradientUnits
                gu_str = SVG_GetAttr("gradientUnits")
                IfCondition NotEqual(gu_str, 0) ThenBlock: {
                    IfCondition EqualTo(StringCompare(gu_str, "userSpaceOnUse"), 0) ThenBlock: {
                        StoreValue(Add(ep, SVGGradField.UNITS), 1)
                    }
                }
                SVGDefsState.in_gradient = 1
                SVGDefsState.cur_grad_idx = gidx
            }
            ReturnValue(0)
        }

        // <radialGradient id="..." cx="" cy="" r="" fx="" fy="">
        IfCondition EqualTo(StringCompare(tag, "radialGradient"), 0) ThenBlock: {
            id_str = SVG_GetAttr("id")
            id_hash = SVG_StringHash(id_str)
            gidx = SVG_GradCreate(SVGGradType.RADIAL, id_hash)
            IfCondition GreaterEqual(gidx, 0) ThenBlock: {
                ep = Add(SVGGradTable.data, Multiply(gidx, SVGConst.GRAD_ENTRY))
                cx_str = SVG_GetAttr("cx")
                cy_str = SVG_GetAttr("cy")
                r_str = SVG_GetAttr("r")
                IfCondition NotEqual(cx_str, 0) ThenBlock: {
                    StoreValue(Add(ep, SVGGradField.X1), SVG_ParseFixed256(cx_str))
                }
                IfCondition NotEqual(cy_str, 0) ThenBlock: {
                    StoreValue(Add(ep, SVGGradField.Y1), SVG_ParseFixed256(cy_str))
                }
                IfCondition NotEqual(r_str, 0) ThenBlock: {
                    StoreValue(Add(ep, SVGGradField.R), SVG_ParseFixed256(r_str))
                }
                fx_str = SVG_GetAttr("fx")
                fy_str = SVG_GetAttr("fy")
                IfCondition NotEqual(fx_str, 0) ThenBlock: {
                    StoreValue(Add(ep, SVGGradField.X2), SVG_ParseFixed256(fx_str))
                } ElseBlock: {
                    // fx defaults to cx
                    IfCondition NotEqual(cx_str, 0) ThenBlock: {
                        StoreValue(Add(ep, SVGGradField.X2), SVG_ParseFixed256(cx_str))
                    }
                }
                IfCondition NotEqual(fy_str, 0) ThenBlock: {
                    StoreValue(Add(ep, SVGGradField.Y2), SVG_ParseFixed256(fy_str))
                } ElseBlock: {
                    IfCondition NotEqual(cy_str, 0) ThenBlock: {
                        StoreValue(Add(ep, SVGGradField.Y2), SVG_ParseFixed256(cy_str))
                    }
                }
                gu_str = SVG_GetAttr("gradientUnits")
                IfCondition NotEqual(gu_str, 0) ThenBlock: {
                    IfCondition EqualTo(StringCompare(gu_str, "userSpaceOnUse"), 0) ThenBlock: {
                        StoreValue(Add(ep, SVGGradField.UNITS), 1)
                    }
                }
                SVGDefsState.in_gradient = 1
                SVGDefsState.cur_grad_idx = gidx
            }
            ReturnValue(0)
        }

        // <stop offset="" stop-color="">
        IfCondition EqualTo(StringCompare(tag, "stop"), 0) ThenBlock: {
            gidx = SVGDefsState.cur_grad_idx
            IfCondition GreaterEqual(gidx, 0) ThenBlock: {
                ep = Add(SVGGradTable.data, Multiply(gidx, SVGConst.GRAD_ENTRY))
                sc = Dereference(Add(ep, SVGGradField.STOP_COUNT))
                color_str = SVG_GetAttr("stop-color")
                stop_color = SVG_ParseColor(color_str)
                IfCondition EqualTo(stop_color, 0) ThenBlock: {
                    stop_color = 0xFF000000
                }
                // Apply stop-opacity
                sop_str = SVG_GetAttr("stop-opacity")
                IfCondition NotEqual(sop_str, 0) ThenBlock: {
                    sop = SVG_ParseFixed256(sop_str)
                    sa = ShiftRight(stop_color, 24)
                    sa = BitwiseAnd(sa, 255)
                    sa = Divide(Multiply(sa, sop), 256)
                    stop_color = BitwiseAnd(stop_color, 0x00FFFFFF)
                    stop_color = BitwiseOr(stop_color, ShiftLeft(sa, 24))
                }
                // Store as color0 (first stop) or color1 (last stop)
                IfCondition EqualTo(sc, 0) ThenBlock: {
                    StoreValue(Add(ep, SVGGradField.COLOR0), stop_color)
                }
                // Always update color1 to be the latest stop
                StoreValue(Add(ep, SVGGradField.COLOR1), stop_color)
                StoreValue(Add(ep, SVGGradField.STOP_COUNT), Add(sc, 1))
            }
            ReturnValue(0)
        }

        ReturnValue(0)
    }
}

// SVG_ResolveGradFill: check if fill="url(#id)" references a gradient.
// If so, set up GradState and return 1. Otherwise return 0.
Function.SVG_ResolveGradFill {
    Input: fill_str: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(fill_str, 0) ThenBlock: { ReturnValue(0) }
        // Check for "url(#"
        c0 = GetByte(fill_str, 0)
        IfCondition NotEqual(c0, 117) ThenBlock: { ReturnValue(0) }  // 'u'
        c1 = GetByte(fill_str, 1)
        IfCondition NotEqual(c1, 114) ThenBlock: { ReturnValue(0) }  // 'r'
        c2 = GetByte(fill_str, 2)
        IfCondition NotEqual(c2, 108) ThenBlock: { ReturnValue(0) }  // 'l'
        c3 = GetByte(fill_str, 3)
        IfCondition NotEqual(c3, 40) ThenBlock: { ReturnValue(0) }   // '('
        c4 = GetByte(fill_str, 4)
        IfCondition NotEqual(c4, 35) ThenBlock: { ReturnValue(0) }   // '#'

        // Extract id: from position 5 until ')'
        id_buf = Allocate(128)
        IfCondition EqualTo(id_buf, 0) ThenBlock: { ReturnValue(0) }
        ip = 5
        il = 0
        imore = 1
        WhileLoop EqualTo(imore, 1) {
            ic = GetByte(fill_str, ip)
            IfCondition Or(EqualTo(ic, 41), EqualTo(ic, 0)) ThenBlock: {
                imore = 0
            } ElseBlock: {
                IfCondition LessThan(il, 126) ThenBlock: {
                    SetByte(id_buf, il, ic)
                    il = Add(il, 1)
                }
                ip = Add(ip, 1)
            }
        }
        SetByte(id_buf, il, 0)

        id_hash = SVG_StringHash(id_buf)
        Deallocate(id_buf, 128)

        gep = SVG_GradFindById(id_hash)
        IfCondition EqualTo(gep, 0) ThenBlock: { ReturnValue(0) }

        // Set up VIF GradState
        gtype = Dereference(Add(gep, SVGGradField.TYPE))
        gx1 = Dereference(Add(gep, SVGGradField.X1))
        gy1 = Dereference(Add(gep, SVGGradField.Y1))
        gx2 = Dereference(Add(gep, SVGGradField.X2))
        gy2 = Dereference(Add(gep, SVGGradField.Y2))
        gc0 = Dereference(Add(gep, SVGGradField.COLOR0))
        gc1 = Dereference(Add(gep, SVGGradField.COLOR1))

        // Map gradient coords through viewBox
        mx1 = SVG_MapX(gx1)
        my1 = SVG_MapY(gy1)
        mx2 = SVG_MapX(gx2)
        my2 = SVG_MapY(gy2)

        // Unpack colors for GradState
        GradState.r0 = BitwiseAnd(ShiftRight(gc0, 16), 255)
        GradState.g0 = BitwiseAnd(ShiftRight(gc0, 8), 255)
        GradState.b0 = BitwiseAnd(gc0, 255)
        GradState.a0 = BitwiseAnd(ShiftRight(gc0, 24), 255)
        GradState.r1 = BitwiseAnd(ShiftRight(gc1, 16), 255)
        GradState.g1 = BitwiseAnd(ShiftRight(gc1, 8), 255)
        GradState.b1 = BitwiseAnd(gc1, 255)
        GradState.a1 = BitwiseAnd(ShiftRight(gc1, 24), 255)

        GradState.x0 = mx1
        GradState.y0 = my1
        GradState.x1 = mx2
        GradState.y1 = my2

        IfCondition EqualTo(gtype, SVGGradType.LINEAR) ThenBlock: {
            GradState.kind = 1
            gdx = Subtract(mx2, mx1)
            gdy = Subtract(my2, my1)
            GradState.dx = gdx
            GradState.dy = gdy
            GradState.len_sq = Add(Multiply(gdx, gdx), Multiply(gdy, gdy))
        } ElseBlock: {
            GradState.kind = 2
            gr = Dereference(Add(gep, SVGGradField.R))
            gr_mapped = SVG_MapX(gr)
            GradState.len_sq = Multiply(gr_mapped, gr_mapped)
        }

        GradState.active = 1
        ReturnValue(1)
    }
}

// =============================================================================
// TEXT RENDERING — render <text> elements via VIF font engine
// =============================================================================

// SVG_ExtractTextContent: extract text content between current element and
// its closing tag. Returns address of text string (caller must deallocate).
// This reads ahead in the SVG source to find text between tags.
Function.SVG_ExtractTextContent {
    Output: Address
    Body: {
        // Text content follows the current '>' up to the next '<'
        buf = Allocate(1024)
        IfCondition EqualTo(buf, 0) ThenBlock: { ReturnValue(0) }
        len = 0
        tmore = 1
        WhileLoop And(EqualTo(tmore, 1), LessThan(SVGParse.pos, SVGParse.size)) {
            c = GetByte(SVGParse.data, SVGParse.pos)
            IfCondition EqualTo(c, 60) ThenBlock: {
                // Hit '<' — stop (don't consume it)
                tmore = 0
            } ElseBlock: {
                IfCondition LessThan(len, 1022) ThenBlock: {
                    SetByte(buf, len, c)
                    len = Add(len, 1)
                }
                SVGParse.pos = Add(SVGParse.pos, 1)
            }
        }
        SetByte(buf, len, 0)
        ReturnValue(buf)
    }
}

// SVG_RenderText: render a <text> element
Function.SVG_RenderText {
    Input: color: Integer
    Body: {
        x_str = SVG_GetAttr("x")
        y_str = SVG_GetAttr("y")
        fs_str = SVG_GetAttr("font-size")

        tx = SVG_ParseFixed256(x_str)
        ty = SVG_ParseFixed256(y_str)

        // Map to surface coords
        px = Divide(SVG_MapX(tx), 256)
        py = Divide(SVG_MapY(ty), 256)

        // Font size
        font_sz = 16
        IfCondition NotEqual(fs_str, 0) ThenBlock: {
            font_sz = SVG_ParseInt(fs_str)
            IfCondition LessEqual(font_sz, 0) ThenBlock: { font_sz = 16 }
        }

        // Extract text content
        text = SVG_ExtractTextContent()
        IfCondition EqualTo(text, 0) ThenBlock: { ReturnValue(0) }

        // Measure text length
        tlen = 0
        tlmore = 1
        WhileLoop EqualTo(tlmore, 1) {
            tc = GetByte(text, tlen)
            IfCondition EqualTo(tc, 0) ThenBlock: { tlmore = 0 }
            IfCondition EqualTo(tlmore, 1) ThenBlock: { tlen = Add(tlen, 1) }
        }

        IfCondition GreaterThan(tlen, 0) ThenBlock: {
            // Try to use VIF font instance
            inst = SVGTextState.font_inst
            IfCondition NotEqual(inst, 0) ThenBlock: {
                // Set draw color — unpack ARGB to set FontState
                fr = BitwiseAnd(ShiftRight(color, 16), 255)
                fg = BitwiseAnd(ShiftRight(color, 8), 255)
                fb = BitwiseAnd(color, 255)
                FontState.draw_color = TVG_PackColor(fr, fg, fb, 255)
                VInst_DrawString(inst, SVGState.surf, text, tlen, px, py)
            } ElseBlock: {
                // No font loaded — fallback: draw rectangles as placeholders
                // Each "character" gets a small filled rect
                // px/py are already in pixel coords; work in 256× fp pixel space
                gi = 0
                gx = px
                gw = Divide(font_sz, 2)
                gh = font_sz
                // Scale glyph size by viewBox ratio
                IfCondition NotEqual(SVGState.vb_w, 0) ThenBlock: {
                    gw = Divide(Multiply(gw, Multiply(SVGState.surf_w, 256)), SVGState.vb_w)
                    gh = Divide(Multiply(gh, Multiply(SVGState.surf_h, 256)), SVGState.vb_h)
                }
                WhileLoop LessThan(gi, tlen) {
                    gc = GetByte(text, gi)
                    IfCondition NotEqual(gc, 32) ThenBlock: {
                        // Coords already in pixel space — use directly as 256× fp
                        rx0 = Multiply(gx, 256)
                        ry0 = Multiply(Subtract(py, Divide(gh, 1)), 256)
                        rx1 = Add(rx0, Multiply(gw, 256))
                        ry1 = Add(ry0, Multiply(gh, 256))
                        RastState.edge_count = 0
                        TVG_AddEdge(rx0, ry0, rx1, ry0)
                        TVG_AddEdge(rx1, ry0, rx1, ry1)
                        TVG_AddEdge(rx1, ry1, rx0, ry1)
                        TVG_AddEdge(rx0, ry1, rx0, ry0)
                        TVG_FillWithColor(color)
                    }
                    gx = Add(gx, gw)
                    gi = Add(gi, 1)
                }
            }
        }

        Deallocate(text, 1024)
        ReturnValue(0)
    }
}

// =============================================================================
// MAIN SVG ELEMENT DISPATCHER
// =============================================================================
Function.SVG_DispatchElement {
    Body: {
        tag = SVGElem.tag

        // Handle close tags: </g> pops transform, </defs> exits defs mode
        IfCondition EqualTo(SVGElem.is_close, 1) ThenBlock: {
            IfCondition EqualTo(StringCompare(tag, "g"), 0) ThenBlock: {
                SVG_XformPop()
            }
            IfCondition EqualTo(StringCompare(tag, "defs"), 0) ThenBlock: {
                SVGDefsState.inside = 0
                SVGDefsState.in_gradient = 0
                SVGDefsState.cur_grad_idx = -1
            }
            ReturnValue(0)
        }

        // If inside <defs>, route to gradient parser instead of rendering
        IfCondition EqualTo(SVGDefsState.inside, 1) ThenBlock: {
            SVG_ParseDefsElement()
            ReturnValue(0)
        }

        // Resolve fill color for this element
        fill_str = SVG_GetAttr("fill")
        fill_color = 0xFF000000
        grad_active = 0
        IfCondition NotEqual(fill_str, 0) ThenBlock: {
            // Check for gradient reference: url(#id)
            fb = GetByte(fill_str, 0)
            IfCondition EqualTo(fb, 117) ThenBlock: {
                // 'u' — might be url(...)
                grad_active = SVG_ResolveGradFill(fill_str)
            } ElseBlock: {
                fill_color = SVG_ParseColor(fill_str)
            }
            // "none" means no fill
            IfCondition EqualTo(StringCompare(fill_str, "none"), 0) ThenBlock: {
                fill_color = 0
            }
        }

        // Resolve stroke
        stroke_str = SVG_GetAttr("stroke")
        stroke_color = 0
        IfCondition NotEqual(stroke_str, 0) ThenBlock: {
            stroke_color = SVG_ParseColor(stroke_str)
        }
        sw_str = SVG_GetAttr("stroke-width")
        stroke_w = 256
        IfCondition NotEqual(sw_str, 0) ThenBlock: {
            stroke_w = SVG_ParseFixed256(sw_str)
        }

        // Resolve opacity
        op_str = SVG_GetAttr("opacity")
        opacity_256 = 256
        IfCondition NotEqual(op_str, 0) ThenBlock: {
            opacity_256 = SVG_ParseFixed256(op_str)
        }

        // Apply opacity to fill color alpha
        IfCondition LessThan(opacity_256, 256) ThenBlock: {
            IfCondition NotEqual(fill_color, 0) ThenBlock: {
                fa = ShiftRight(fill_color, 24)
                fa = BitwiseAnd(fa, 255)
                fa = Divide(Multiply(fa, opacity_256), 256)
                fill_color = BitwiseAnd(fill_color, 0x00FFFFFF)
                fill_color = BitwiseOr(fill_color, ShiftLeft(fa, 24))
            }
        }

        // === <svg> root element ===
        IfCondition EqualTo(StringCompare(tag, "svg"), 0) ThenBlock: {
            vb_str = SVG_GetAttr("viewBox")
            // HTML lowercases attributes, so also try "viewbox"
            IfCondition EqualTo(vb_str, 0) ThenBlock: {
                vb_str = SVG_GetAttr("viewbox")
            }
            IfCondition NotEqual(vb_str, 0) ThenBlock: {
                SVG_ParseViewBox(vb_str)
            } ElseBlock: {
                // Default viewBox from width/height attributes
                w_str = SVG_GetAttr("width")
                h_str = SVG_GetAttr("height")
                IfCondition And(NotEqual(w_str, 0), NotEqual(h_str, 0)) ThenBlock: {
                    SVGState.vb_x = 0
                    SVGState.vb_y = 0
                    SVGState.vb_w = SVG_ParseFixed256(w_str)
                    SVGState.vb_h = SVG_ParseFixed256(h_str)
                }
            }
            ReturnValue(0)
        }

        // === <g> group — push transform stack, apply transform attr ===
        IfCondition EqualTo(StringCompare(tag, "g"), 0) ThenBlock: {
            SVG_XformPush()
            xf_str = SVG_GetAttr("transform")
            IfCondition NotEqual(xf_str, 0) ThenBlock: {
                SVG_ParseTransform(xf_str)
            }
            ReturnValue(0)
        }

        // === <defs> — enter defs mode, gradient/clipPath definitions parsed here ===
        IfCondition EqualTo(StringCompare(tag, "defs"), 0) ThenBlock: {
            SVGDefsState.inside = 1
            SVGDefsState.in_gradient = 0
            SVGDefsState.cur_grad_idx = -1
            ReturnValue(0)
        }

        // Per-element transform: push, apply, then pop after shape rendering
        elem_xf_str = SVG_GetAttr("transform")
        IfCondition NotEqual(elem_xf_str, 0) ThenBlock: {
            SVG_XformPush()
            SVG_ParseTransform(elem_xf_str)
        }

        // For gradient fills, use TVG_FillWithColor which calls TVG_ScanFill
        // TVG_ScanFill checks GradState.active and uses TVG_GradPixel per pixel
        // So gradient fill works automatically when GradState is set up

        // === <rect> ===
        IfCondition EqualTo(StringCompare(tag, "rect"), 0) ThenBlock: {
            has_fill = Or(NotEqual(fill_color, 0), EqualTo(grad_active, 1))
            has_stroke = NotEqual(stroke_color, 0)
            IfCondition Or(has_fill, has_stroke) ThenBlock: {
                SVG_RenderRect(fill_color)
                IfCondition EqualTo(has_fill, 0) ThenBlock: {
                    // Path built but skip fill — just need path for stroke
                }
                IfCondition EqualTo(has_stroke, 1) ThenBlock: {
                    SVG_RenderRect_Stroke(stroke_color, stroke_w)
                }
            }
            SVGState.elem_count = Add(SVGState.elem_count, 1)
        }

        // === <circle> ===
        IfCondition EqualTo(StringCompare(tag, "circle"), 0) ThenBlock: {
            has_fill = Or(NotEqual(fill_color, 0), EqualTo(grad_active, 1))
            has_stroke = NotEqual(stroke_color, 0)
            IfCondition Or(has_fill, has_stroke) ThenBlock: {
                SVG_RenderCircle(fill_color)
                IfCondition EqualTo(has_stroke, 1) ThenBlock: {
                    SVG_RenderCircle_Stroke(stroke_color, stroke_w)
                }
            }
            SVGState.elem_count = Add(SVGState.elem_count, 1)
        }

        // === <ellipse> ===
        IfCondition EqualTo(StringCompare(tag, "ellipse"), 0) ThenBlock: {
            has_fill = Or(NotEqual(fill_color, 0), EqualTo(grad_active, 1))
            has_stroke = NotEqual(stroke_color, 0)
            IfCondition Or(has_fill, has_stroke) ThenBlock: {
                SVG_RenderEllipse(fill_color)
                IfCondition EqualTo(has_stroke, 1) ThenBlock: {
                    SVG_RenderEllipse_Stroke(stroke_color, stroke_w)
                }
            }
            SVGState.elem_count = Add(SVGState.elem_count, 1)
        }

        // === <line> ===
        IfCondition EqualTo(StringCompare(tag, "line"), 0) ThenBlock: {
            line_color = stroke_color
            IfCondition EqualTo(line_color, 0) ThenBlock: {
                line_color = fill_color
            }
            IfCondition NotEqual(line_color, 0) ThenBlock: {
                SVG_RenderLine(line_color, stroke_w)
            }
            SVGState.elem_count = Add(SVGState.elem_count, 1)
        }

        // === <polygon> ===
        IfCondition EqualTo(StringCompare(tag, "polygon"), 0) ThenBlock: {
            IfCondition Or(NotEqual(fill_color, 0), EqualTo(grad_active, 1)) ThenBlock: {
                SVG_RenderPolygon(fill_color)
            }
            SVGState.elem_count = Add(SVGState.elem_count, 1)
        }

        // === <polyline> ===
        IfCondition EqualTo(StringCompare(tag, "polyline"), 0) ThenBlock: {
            line_color = stroke_color
            IfCondition EqualTo(line_color, 0) ThenBlock: {
                line_color = fill_color
            }
            IfCondition NotEqual(line_color, 0) ThenBlock: {
                SVG_RenderPolyline(line_color, stroke_w)
            }
            SVGState.elem_count = Add(SVGState.elem_count, 1)
        }

        // === <path> ===
        IfCondition EqualTo(StringCompare(tag, "path"), 0) ThenBlock: {
            d_str = SVG_GetAttr("d")
            IfCondition NotEqual(d_str, 0) ThenBlock: {
                SVG_ParsePath(d_str)
                // Fill pass
                IfCondition Or(NotEqual(fill_color, 0), EqualTo(grad_active, 1)) ThenBlock: {
                    RastState.edge_count = 0
                    SVG_EmitPath()
                    TVG_FillWithColor(fill_color)
                }
                // Stroke pass — uses StrokeState to expand edges into quads
                IfCondition NotEqual(stroke_color, 0) ThenBlock: {
                    RastState.edge_count = 0
                    StrokeState.active = 1
                    StrokeState.half_width = Divide(stroke_w, 2)
                    SVG_EmitPath()
                    StrokeState.active = 0
                    TVG_FillWithColor(stroke_color)
                }
            }
            SVGState.elem_count = Add(SVGState.elem_count, 1)
        }

        // === <text> — render text content ===
        IfCondition EqualTo(StringCompare(tag, "text"), 0) ThenBlock: {
            // Parse font-size
            fs_str = SVG_GetAttr("font-size")
            IfCondition NotEqual(fs_str, 0) ThenBlock: {
                SVGTextState.font_size = Divide(SVG_ParseFixed256(fs_str), 256)
            }
            SVG_RenderText(fill_color)
            SVGState.elem_count = Add(SVGState.elem_count, 1)
        }

        // === Cleanup: pop per-element transform, reset gradient state ===
        IfCondition NotEqual(elem_xf_str, 0) ThenBlock: {
            SVG_XformPop()
        }
        IfCondition EqualTo(grad_active, 1) ThenBlock: {
            GradState.active = 0
        }

        ReturnValue(0)
    }
}

// =============================================================================
// MAIN ENTRY POINT — SVG_Render
// =============================================================================
Function.SVG_Render {
    Input: svg_data: Address
    Input: svg_len: Integer
    Input: surf: Address
    Input: surf_w: Integer
    Input: surf_h: Integer
    Output: Integer
    Body: {
        IfCondition Or(EqualTo(svg_data, 0), LessEqual(svg_len, 0)) ThenBlock: {
            PrintMessage("[SVG] null input\n")
            ReturnValue(0)
        }
        IfCondition Or(EqualTo(surf, 0), Or(LessEqual(surf_w, 0), LessEqual(surf_h, 0))) ThenBlock: {
            PrintMessage("[SVG] bad surface\n")
            ReturnValue(0)
        }

        // Set parser state
        SVGParse.data = svg_data
        SVGParse.size = svg_len
        SVGParse.pos = 0
        SVGParse.error = 0

        // Set render target
        SVGState.surf = surf
        SVGState.surf_w = surf_w
        SVGState.surf_h = surf_h
        SVGState.elem_count = 0

        // Default viewBox = surface dimensions
        SVGState.vb_x = 0
        SVGState.vb_y = 0
        SVGState.vb_w = Multiply(surf_w, 256)
        SVGState.vb_h = Multiply(surf_h, 256)

        // Reset defs/gradient state
        SVGDefsState.inside = 0
        SVGDefsState.in_gradient = 0
        SVGDefsState.cur_grad_idx = -1
        SVGGradTable.count = 0

        // Reset transform stack to identity at depth 0
        SVGXform.depth = 0
        xbase = SVGXform.stack
        IfCondition NotEqual(xbase, 0) ThenBlock: {
            // Identity matrix: a=256 b=0 c=0 d=256 e=0 f=0
            StoreValue(Add(xbase, 0), 256)
            StoreValue(Add(xbase, 8), 0)
            StoreValue(Add(xbase, 16), 0)
            StoreValue(Add(xbase, 24), 256)
            StoreValue(Add(xbase, 32), 0)
            StoreValue(Add(xbase, 40), 0)
        }

        // Reset gradient active flag in VIF
        GradState.active = 0

        // Point VIF rasterizer at our surface
        RastState.surf = surf
        RastState.surf_w = surf_w
        RastState.surf_h = surf_h

        // Parse and render elements
        more = 1
        WhileLoop EqualTo(more, 1) {
            found = SVG_ReadElement()
            IfCondition EqualTo(found, 0) ThenBlock: {
                more = 0
            } ElseBlock: {
                SVG_DispatchElement()
            }
        }

        ReturnValue(1)
    }
}

// SVG_RenderFile: convenience wrapper — read file and render
Function.SVG_RenderFile {
    Input: path: Address
    Input: surf: Address
    Input: surf_w: Integer
    Input: surf_h: Integer
    Output: Integer
    Body: {
        // Read file into memory
        // open(path, O_RDONLY=0, 0)
        fd = SystemCall(2, path, 0, 0)
        IfCondition LessThan(fd, 0) ThenBlock: {
            PrintMessage("[SVG] can't open file\n")
            ReturnValue(0)
        }
        // lseek(fd, 0, SEEK_END=2) to get size
        fsize = SystemCall(8, fd, 0, 2)
        // lseek(fd, 0, SEEK_SET=0) to rewind
        SystemCall(8, fd, 0, 0)
        IfCondition LessEqual(fsize, 0) ThenBlock: {
            SystemCall(3, fd)
            ReturnValue(0)
        }
        buf = Allocate(fsize)
        IfCondition EqualTo(buf, 0) ThenBlock: {
            SystemCall(3, fd)
            ReturnValue(0)
        }
        // read(fd, buf, fsize)
        SystemCall(0, fd, buf, fsize)
        // close(fd)
        SystemCall(3, fd)

        result = SVG_Render(buf, fsize, surf, surf_w, surf_h)
        Deallocate(buf, fsize)
        ReturnValue(result)
    }
}
