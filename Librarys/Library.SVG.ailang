LibraryImport.Arena
LibraryImport.StringUtils
LibraryImport.Display.Render.DSurfaceTypes
LibraryImport.Display.Render.DSurface
LibraryImport.Display.Render.DDrawPixel
LibraryImport.Display.Render.VIF
LibraryImport.Display.Render.Fonts
LibraryImport.Display.Render.SurfaceBlit
LibraryImport.FixedPointTrig

// =============================================================================
// SVG CONSTANTS
// =============================================================================
FixedPool.SVGConst {
    "MAX_ATTRS":      Initialize=32     // Max attributes per element
    "ATTR_KEY_MAX":   Initialize=64     // Max attribute key length
    "ATTR_VAL_MAX":   Initialize=512    // Max attribute value length
    "MAX_GRADIENTS":  Initialize=64     // Max gradient definitions
    "MAX_STOPS":      Initialize=16     // Max stops per gradient
    "MAX_XFORM":      Initialize=32     // Max transform nesting depth
    "XFORM_ENTRY":    Initialize=48     // 6 ints × 8 bytes per matrix level
    "FP_SCALE":       Initialize=256    // Fixed-point scale (matches VIF)
    "FP_ONE":         Initialize=256    // 1.0 in 256× fp
    "PATH_CMD_MAX":   Initialize=4096   // Max path commands per d attribute
    "CMD_ENTRY_SIZE": Initialize=64     // 8 fields × 8 bytes per command
    "GRAD_ENTRY":     Initialize=96     // Bytes per gradient table entry
    "KAPPA_256":      Initialize=141    // 0.5522847 × 256 = 141 for circle approx
    "PT_BUF_MAX":     Initialize=1024   // Max points for polyline/polygon
}

// Gradient types
FixedPool.SVGGradType {
    "LINEAR": Initialize=0
    "RADIAL": Initialize=1
}

// Named color table — common SVG/CSS colors
// Packed as 0xAARRGGBB
FixedPool.SVGNamedColors {
    "black":       Initialize=0xFF000000
    "white":       Initialize=0xFFFFFFFF
    "red":         Initialize=0xFFFF0000
    "green":       Initialize=0xFF008000
    "blue":        Initialize=0xFF0000FF
    "yellow":      Initialize=0xFFFFFF00
    "cyan":        Initialize=0xFF00FFFF
    "magenta":     Initialize=0xFFFF00FF
