// Library.Screenshot.ailang — Framebuffer screenshot to BMP or PPM file
// Saves the current draw buffer as a 24-bit BMP or PPM (P6) image
//
// Copyright (c) 2026 Sean Collins, 2 Paws Machine and Engineering. SCSL.

LibraryImport.Framebuffer

// =============================================================================
// HELPERS — write little-endian 16/32-bit integers into a byte buffer
// =============================================================================
Function.SS_WriteLE16 {
    Input: buf: Address
    Input: off: Integer
    Input: val: Integer
    Body: {
        SetByte(buf, off, BitwiseAnd(val, 255))
        SetByte(buf, Add(off, 1), BitwiseAnd(ShiftRight(val, 8), 255))
        ReturnValue(0)
    }
}

Function.SS_WriteLE32 {
    Input: buf: Address
    Input: off: Integer
    Input: val: Integer
    Body: {
        SetByte(buf, off, BitwiseAnd(val, 255))
        SetByte(buf, Add(off, 1), BitwiseAnd(ShiftRight(val, 8), 255))
        SetByte(buf, Add(off, 2), BitwiseAnd(ShiftRight(val, 16), 255))
        SetByte(buf, Add(off, 3), BitwiseAnd(ShiftRight(val, 24), 255))
        ReturnValue(0)
    }
}

// =============================================================================
// SAVE — capture current framebuffer to /tmp/screenshot.bmp
// Format: 24-bit BMP (BITMAPINFOHEADER, bottom-up rows, BGR pixels)
// Returns 1 on success, 0 on failure.
// =============================================================================
Function.Screenshot_Save {
    Output: Integer
    Body: {
        w = FB_GetWidth()
        h = FB_GetHeight()
        fb_buf = FB_GetDrawBuffer()
        fb_pitch = FB.pitch

        IfCondition EqualTo(fb_buf, 0) ThenBlock: {
            PrintMessage("[Screenshot] no framebuffer\n")
            ReturnValue(0)
        }

        // BMP row stride: 3 bytes/pixel, padded to 4-byte boundary
        row_bytes = Multiply(w, 3)
        rem = Modulo(row_bytes, 4)
        pad = 0
        IfCondition NotEqual(rem, 0) ThenBlock: {
            pad = Subtract(4, rem)
        }
        bmp_stride = Add(row_bytes, pad)

        // File size = 54-byte header + pixel data
        pix_size = Multiply(bmp_stride, h)
        file_size = Add(54, pix_size)

        // Open output file: O_WRONLY|O_CREAT|O_TRUNC = 577, mode 0644 = 420
        fd = SystemCall(2, "/tmp/screenshot.bmp", 577, 420)
        IfCondition LessThan(fd, 0) ThenBlock: {
            PrintMessage("[Screenshot] open failed\n")
            ReturnValue(0)
        }

        // ----- Write 54-byte BMP header -----
        hdr = Allocate(64)
        IfCondition EqualTo(hdr, 0) ThenBlock: {
            SystemCall(3, fd)
            PrintMessage("[Screenshot] hdr alloc fail\n")
            ReturnValue(0)
        }

        // Zero header
        zi = 0
        WhileLoop LessThan(zi, 54) { SetByte(hdr, zi, 0)  zi = Add(zi, 1) }

        // -- File header (14 bytes) --
        SetByte(hdr, 0, 66)                // 'B'
        SetByte(hdr, 1, 77)                // 'M'
        SS_WriteLE32(hdr, 2, file_size)     // bfSize
        // bytes 6-9 reserved = 0
        SS_WriteLE32(hdr, 10, 54)           // bfOffBits

        // -- DIB header (BITMAPINFOHEADER, 40 bytes) --
        SS_WriteLE32(hdr, 14, 40)           // biSize
        SS_WriteLE32(hdr, 18, w)            // biWidth
        SS_WriteLE32(hdr, 22, h)            // biHeight (positive = bottom-up)
        SS_WriteLE16(hdr, 26, 1)            // biPlanes
        SS_WriteLE16(hdr, 28, 24)           // biBitCount
        // bytes 30-33 biCompression = 0 (BI_RGB)
        SS_WriteLE32(hdr, 34, pix_size)     // biSizeImage
        // bytes 38-53 = 0 (resolution, colors)

        SystemCall(1, fd, hdr, 54)
        Deallocate(hdr, 64)

        // ----- Write pixel data (bottom row first) -----
        row_buf = Allocate(Add(bmp_stride, 8))
        IfCondition EqualTo(row_buf, 0) ThenBlock: {
            SystemCall(3, fd)
            PrintMessage("[Screenshot] row alloc fail\n")
            ReturnValue(0)
        }

        y = Subtract(h, 1)
        WhileLoop GreaterEqual(y, 0) {
            // Source row in framebuffer (BGRA, 4 bytes/pixel)
            src = Add(fb_buf, Multiply(y, fb_pitch))

            // Convert BGRA to BGR
            x = 0
            WhileLoop LessThan(x, w) {
                si = Multiply(x, 4)
                di = Multiply(x, 3)
                SetByte(row_buf, di,          GetByte(src, si))          // B
                SetByte(row_buf, Add(di, 1),  GetByte(src, Add(si, 1))) // G
                SetByte(row_buf, Add(di, 2),  GetByte(src, Add(si, 2))) // R
                x = Add(x, 1)
            }

            // Zero padding bytes
            pi = 0
            WhileLoop LessThan(pi, pad) {
                SetByte(row_buf, Add(row_bytes, pi), 0)
                pi = Add(pi, 1)
            }

            SystemCall(1, fd, row_buf, bmp_stride)
            y = Subtract(y, 1)
        }

        Deallocate(row_buf, Add(bmp_stride, 8))
        SystemCall(3, fd)

        PrintMessage("[Screenshot] saved /tmp/screenshot.bmp ")
        PrintNumber(w)
        PrintMessage("x")
        PrintNumber(h)
        PrintMessage(" (")
        PrintNumber(file_size)
        PrintMessage(" bytes)\n")
        ReturnValue(1)
    }
}

// =============================================================================
// SAVE PPM — capture current framebuffer to /tmp/screenshot.ppm
// Format: PPM P6 binary (RGB top-to-bottom, no padding, no compression)
// Returns 1 on success, 0 on failure.
// =============================================================================
Function.Screenshot_SavePPM {
    Output: Integer
    Body: {
        w = FB_GetWidth()
        h = FB_GetHeight()
        fb_buf = FB_GetDrawBuffer()
        fb_pitch = FB.pitch

        IfCondition EqualTo(fb_buf, 0) ThenBlock: {
            PrintMessage("[Screenshot] no framebuffer\n")
            ReturnValue(0)
        }

        // Open output file: O_WRONLY|O_CREAT|O_TRUNC = 577, mode 0644 = 420
        fd = SystemCall(2, "/tmp/screenshot.ppm", 577, 420)
        IfCondition LessThan(fd, 0) ThenBlock: {
            PrintMessage("[Screenshot] ppm open failed\n")
            ReturnValue(0)
        }

        // ----- Write PPM header -----
        // Format: "P6\n{width} {height}\n255\n"
        // Build header string in a buffer (max ~30 bytes for any resolution)
        hdr = Allocate(64)
        IfCondition EqualTo(hdr, 0) ThenBlock: {
            SystemCall(3, fd)
            PrintMessage("[Screenshot] ppm hdr alloc fail\n")
            ReturnValue(0)
        }

        // "P6\n"
        SetByte(hdr, 0, 80)   // 'P'
        SetByte(hdr, 1, 54)   // '6'
        SetByte(hdr, 2, 10)   // '\n'
        hoff = 3

        // Write width as ASCII digits
        hoff = SS_WriteDecimal(hdr, hoff, w)

        // Space separator
        SetByte(hdr, hoff, 32)  // ' '
        hoff = Add(hoff, 1)

        // Write height as ASCII digits
        hoff = SS_WriteDecimal(hdr, hoff, h)

        // "\n255\n"
        SetByte(hdr, hoff, 10)           // '\n'
        SetByte(hdr, Add(hoff, 1), 50)   // '2'
        SetByte(hdr, Add(hoff, 2), 53)   // '5'
        SetByte(hdr, Add(hoff, 3), 53)   // '5'
        SetByte(hdr, Add(hoff, 4), 10)   // '\n'
        hoff = Add(hoff, 5)

        SystemCall(1, fd, hdr, hoff)
        Deallocate(hdr, 64)

        // ----- Write pixel data (top row first, RGB) -----
        row_bytes = Multiply(w, 3)
        row_buf = Allocate(Add(row_bytes, 8))
        IfCondition EqualTo(row_buf, 0) ThenBlock: {
            SystemCall(3, fd)
            PrintMessage("[Screenshot] ppm row alloc fail\n")
            ReturnValue(0)
        }

        y = 0
        WhileLoop LessThan(y, h) {
            // Source row in framebuffer (BGRA, 4 bytes/pixel)
            src = Add(fb_buf, Multiply(y, fb_pitch))

            // Convert BGRA to RGB (swap B and R, drop A)
            x = 0
            WhileLoop LessThan(x, w) {
                si = Multiply(x, 4)
                di = Multiply(x, 3)
                SetByte(row_buf, di,          GetByte(src, Add(si, 2))) // R
                SetByte(row_buf, Add(di, 1),  GetByte(src, Add(si, 1))) // G
                SetByte(row_buf, Add(di, 2),  GetByte(src, si))          // B
                x = Add(x, 1)
            }

            SystemCall(1, fd, row_buf, row_bytes)
            y = Add(y, 1)
        }

        Deallocate(row_buf, Add(row_bytes, 8))
        SystemCall(3, fd)

        pix_size = Multiply(row_bytes, h)
        PrintMessage("[Screenshot] saved /tmp/screenshot.ppm ")
        PrintNumber(w)
        PrintMessage("x")
        PrintNumber(h)
        PrintMessage(" (")
        PrintNumber(pix_size)
        PrintMessage(" bytes pixel data)\n")
        ReturnValue(1)
    }
}

// =============================================================================
// HELPER — write an integer as ASCII decimal digits into a buffer
// Returns the new offset past the last digit written.
// =============================================================================
Function.SS_WriteDecimal {
    Input: buf: Address
    Input: off: Integer
    Input: val: Integer
    Output: Integer
    Body: {
        // Handle 0 specially
        IfCondition EqualTo(val, 0) ThenBlock: {
            SetByte(buf, off, 48)  // '0'
            ReturnValue(Add(off, 1))
        }

        // Extract digits into temp buffer (max 10 digits for 32-bit int)
        tmp = Allocate(16)
        dcount = 0
        remaining = val
        WhileLoop GreaterThan(remaining, 0) {
            digit = Modulo(remaining, 10)
            SetByte(tmp, dcount, Add(digit, 48))  // digit + '0'
            dcount = Add(dcount, 1)
            remaining = Divide(remaining, 10)
        }

        // Write digits in reverse (most significant first)
        i = Subtract(dcount, 1)
        WhileLoop GreaterEqual(i, 0) {
            SetByte(buf, off, GetByte(tmp, i))
            off = Add(off, 1)
            i = Subtract(i, 1)
        }

        Deallocate(tmp, 16)
        ReturnValue(off)
    }
}
