LibraryImport.Framebuffer
LibraryImport.DRenderFB
LibraryImport.Arena
LibraryImport.DSurfaceTypes
LibraryImport.DSurface
LibraryImport.DDrawPixel
LibraryImport.DRing0
LibraryImport.DComposeTypes
LibraryImport.DComposeBSP
LibraryImport.DComposeStack
LibraryImport.DComposeFloat
LibraryImport.DCompose
LibraryImport.DInputEvdev
LibraryImport.DInputDiscover
LibraryImport.Font
LibraryImport.FontBitmap
LibraryImport.TextBuffer
LibraryImport.Cursor
LibraryImport.CursorBitmap
LibraryImport.Focus
LibraryImport.PaneManager
LibraryImport.InputRouter

// =============================================================================
// SYSDISPLAY STATE
// Shared by PaneManager and InputRouter via SysDisplayState.font etc.
// =============================================================================
FixedPool.SysDisplayState {
    "running":  Initialize=0
    "scr_w":    Initialize=0
    "scr_h":    Initialize=0
    "tty_fd":   Initialize=0
    "font":     Initialize=0
}

// =============================================================================
// INIT
// =============================================================================
Function.SysDisplay_InitFB {
    Output: Integer
    Body: {
        ok = RenderFB_InitDouble()
        IfCondition EqualTo(ok, 0) ThenBlock: {
            PrintMessage("[FAIL] FB\n")
            ReturnValue(0)
        }
        w = FB_GetWidth()
        h = FB_GetHeight()
        SysDisplayState.scr_w = w
        SysDisplayState.scr_h = h
        PrintMessage("[SysDisplay] FB: ")
        PrintNumber(w)
        PrintMessage("x")
        PrintNumber(h)
        PrintMessage("\n")
        ReturnValue(1)
    }
}

Function.SysDisplay_InitTTY {
    Output: Integer
    Body: {
        tty0_fd = SystemCall(2, "/dev/tty0", 2, 0)
        IfCondition LessThan(tty0_fd, 0) ThenBlock: {
            PrintMessage("[TTY] no tty0\n")
            ReturnValue(0)
        }
        vt_buf = Allocate(8)
        SystemCall(16, tty0_fd, 0x5603, vt_buf)
        vt_num = GetByte(vt_buf, 0)
        SystemCall(3, tty0_fd, 0, 0)
        Deallocate(vt_buf, 8)
        tty_path = StringConcat("/dev/tty", NumberToString(vt_num))
        tty_fd   = SystemCall(2, tty_path, 2, 0)
        IfCondition LessThan(tty_fd, 0) ThenBlock: {
            PrintMessage("[TTY] open failed\n")
            ReturnValue(0)
        }
        SystemCall(16, tty_fd, 19258, 1)
        SysDisplayState.tty_fd = tty_fd
        PrintMessage("[TTY] VT=")
        PrintNumber(vt_num)
        PrintMessage("\n")
        ReturnValue(1)
    }
}

Function.SysDisplay_InitCompositor {
    Output: Integer
    Body: {
        ok = Compose_Init(SysDisplayState.scr_w, SysDisplayState.scr_h)
        IfCondition EqualTo(ok, 0) ThenBlock: {
            PrintMessage("[FAIL] Compose\n")
            ReturnValue(0)
        }
        Compose_InitFB(0, 0)
        ReturnValue(1)
    }
}

Function.SysDisplay_InitFont {
    Output: Integer
    Body: {
        Font_Init()
        handle = Font_CreateBuiltin(8)
        IfCondition LessThan(handle, 0) ThenBlock: {
            PrintMessage("[FAIL] Font\n")
            ReturnValue(0)
        }
        SysDisplayState.font = handle
        Compose_SetFont(handle)
        PrintMessage("[Font] 8x8 ready handle=")
        PrintNumber(handle)
        PrintMessage("\n")
        ReturnValue(1)
    }
}

Function.SysDisplay_InitCursor {
    Output: Integer
    Body: {
        CursorConfig.type      = CursorType.BITMAP
        CursorConfig.shape     = CursorShape.ARROW
        CursorConfig.hotspot_x = 0
        CursorConfig.hotspot_y = 0
        ok = Cursor_Init(SysDisplayState.scr_w, SysDisplayState.scr_h)
        IfCondition EqualTo(ok, 0) ThenBlock: {
            PrintMessage("[FAIL] Cursor\n")
            ReturnValue(0)
        }
        ReturnValue(1)
    }
}

Function.SysDisplay_InitInput {
    Output: Integer
    Body: {
        Ring1_Init()
        Evdev_SetMouseBounds(Subtract(SysDisplayState.scr_w, 1), Subtract(SysDisplayState.scr_h, 1))
        opened = Discover_OpenAll()
        IfCondition EqualTo(opened, 0) ThenBlock: {
            PrintMessage("[FAIL] input\n")
            ReturnValue(0)
        }
        ReturnValue(1)
    }
}

Function.SysDisplay_InitRootPane {
    Output: Integer
    Body: {
        root = Compositor.root
        w    = BSP_GetRegionW(root)
        h    = BSP_GetRegionH(root)
        surf = Surface_Create(SurfaceFormat.PIXEL_32, w, h)
        IfCondition EqualTo(surf, 0) ThenBlock: {
            PrintMessage("[Init] ERROR root surface\n")
            ReturnValue(0)
        }
        Draw_Pix_FillRect(surf, 0, 0, w, h, 0x1A3A5C)
        WinTable_Add(root, surf, 0x1A3A5C)

        tb = CreatePaneBuffer(root)
        IfCondition GreaterEqual(tb, 0) ThenBlock: {
            TextBuffer_PutString(tb, "AILANG Display Server")
            TextBuffer_PutChar(tb, 10)
            TextBuffer_PutString(tb, "Alt+V split  Alt+H split  Alt+M merge")
            TextBuffer_PutChar(tb, 10)
            TextBuffer_PutString(tb, "Click pane to focus. Type to edit.")
            TextBuffer_Render(tb)
        }

        PrintMessage("[Init] root ")
        PrintNumber(w)
        PrintMessage("x")
        PrintNumber(h)
        PrintMessage("\n")
        ReturnValue(surf)
    }
}

// =============================================================================
// SHUTDOWN
// =============================================================================
Function.SysDisplay_RestoreTTY {
    Output: Integer
    Body: {
        tty_fd = SysDisplayState.tty_fd
        IfCondition GreaterEqual(tty_fd, 0) ThenBlock: {
            SystemCall(16, tty_fd, 19258, 0)
            SystemCall(3,  tty_fd, 0, 0)
        }
        ReturnValue(1)
    }
}

Function.SysDisplay_Shutdown {
    Output: Integer
    Body: {
        Evdev_CloseAll()
        Cursor_Shutdown()
        Compose_Shutdown()
        RenderFB_Shutdown()
        SysDisplay_RestoreTTY()
        PrintMessage("[SysDisplay] DONE\n")
        ReturnValue(1)
    }
}

// =============================================================================
// MAIN LOOP
// =============================================================================
Function.SysDisplay_Run {
    Output: Integer
    Body: {
        SysDisplayState.running = 1
        WhileLoop EqualTo(SysDisplayState.running, 1) {
            Evdev_Poll()
            quit = InputRouter_Drain()
            IfCondition EqualTo(quit, 1) ThenBlock: {
                SysDisplayState.running = 0
            }

            Compose_TickRing0()
            SyncPaneBuffers()
            Focus_SetLeaf(Compositor.focused_leaf)

            any_dirty = RenderDirtyBuffers()

            IfCondition EqualTo(RouterState.dirty, 1) ThenBlock: {
                BlitAllSurfaces()
                RouterState.dirty = 0
            } ElseBlock: {
                IfCondition EqualTo(any_dirty, 1) ThenBlock: {
                    BlitAllSurfaces()
                }
            }
        }
        ReturnValue(1)
    }
}

// =============================================================================
// START — full init sequence then run
// =============================================================================
Function.SysDisplay_Start {
    Output: Integer
    Body: {
        PrintMessage("[SysDisplay] starting\n")
        SysDisplay_InitFB()
        SysDisplay_InitTTY()
        SysDisplay_InitCompositor()
        SysDisplay_InitFont()
        SysDisplay_InitCursor()
        TBMap_Init()
        InputRouter_Init()
        SysDisplay_InitRootPane()
        Focus_Init(TBMapState.data, WinTable.entries)
        SysDisplay_InitInput()
        BlitAllSurfaces()
        SysDisplay_Run()
        SysDisplay_Shutdown()
        ReturnValue(1)
    }
}