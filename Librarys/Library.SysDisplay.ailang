// ─── Library.SysDisplay.ailang ───────────────────────────────────────────────
// Replaces the entire existing file.
// No BSP splits. No SyncPaneBuffers. No WinTable. No TBMap.
// Windows are floats. Focus follows click. Alt+V makes a new window. ESC exits.
// Copyright © 2025 Sean Collins, 2 Paws Machine and Engineering. All rights reserved. SCSL.

LibraryImport.Framebuffer
LibraryImport.DRenderFB
LibraryImport.Arena
LibraryImport.DSurfaceTypes
LibraryImport.DSurface
LibraryImport.DDrawPixel
LibraryImport.DRingTypes
LibraryImport.DRing1
LibraryImport.DRing0
LibraryImport.DComposeTypes
LibraryImport.DComposeFloat
LibraryImport.DCompose
