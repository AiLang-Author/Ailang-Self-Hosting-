// Library.TDLibClient.ailang — subprocess bridge to Telegram/tdlib_worker
//
// Spawns tdlib_worker and exchanges line-delimited JSON envelopes over pipes.
// All protocol framing uses Library.JSON.
//
// Public API:
//   TDLib_Open()                         -> handle or 0
//   TDLib_Close(handle)
//   TDLib_Init(api_id, api_hash, db_dir) -> 1/0
//   TDLib_SendTd(handle, td_request_obj) -> response line (caller frees)
//   TDLib_Poll(handle)                   -> response line or 0
//   TDLib_NextId()                       -> request id
//   TDLib_NewTd(type_str)                -> TDLib request object
//   TDLib_BuildEnvelope(id, method, body_obj) -> serialized line (caller frees body)
//
// Copyright 2026 Sean Collins, 2 Paws Machine and Engineering. SCSL.

LibraryImport.Arena
LibraryImport.StringUtils
LibraryImport.JSON

FixedPool.TDLibSys {
    "SYS_READ":   Initialize=0
    "SYS_WRITE":  Initialize=1
    "SYS_OPEN":   Initialize=2
    "SYS_CLOSE":  Initialize=3
    "SYS_PIPE":   Initialize=22
    "SYS_DUP2":   Initialize=33
    "SYS_FORK":   Initialize=57
    "SYS_EXECVE": Initialize=59
    "SYS_EXIT":   Initialize=60
    "SYS_WAIT4":  Initialize=61
}

FixedPool.TDLibConst {
    "READ_BUF_SZ": Initialize=65536
    "LINE_BUF_SZ": Initialize=65536
    "REQ_ID":      Initialize=1, CanChange=True
}

FixedPool.TDLibHandleOff {
    "STDIN_FD":   Initialize=0
    "STDOUT_FD":  Initialize=8
    "PID":        Initialize=16
    "LINE_BUF":   Initialize=24
    "BUF_POS":    Initialize=32
    "BUF_END":    Initialize=36
    "EOF":        Initialize=40
}

FixedPool.TDLibState {
    "handle":     Initialize=0, CanChange=True
}

// =============================================================================
// REQUEST ID
// =============================================================================
Function.TDLib_NextId {
    Output: Integer
    Body: {
        rid = TDLibConst.REQ_ID
        TDLibConst.REQ_ID = Add(rid, 1)
        ReturnValue(rid)
    }
}

// =============================================================================
// TDLib REQUEST HELPERS
// =============================================================================
Function.TDLib_NewTd {
    Input: type_str: Address
    Output: Address
    Body: {
        req = JSON.NewObject()
        JSON.SetString(req, "@type", type_str)
        ReturnValue(req)
    }
}

Function.TDLib_BuildEnvelope {
    Input: id: Integer
    Input: method: Address
    Input: body_obj: Address
    Output: Address
    Body: {
        env = JSON.NewObject()
        JSON.SetNumber(env, "id", id)
        JSON.SetString(env, "method", method)
        IfCondition NotEqual(body_obj, 0) ThenBlock: {
            JSON.SetObject(env, "request", body_obj)
            JSON.Free(body_obj)
        }
        line = JSON.SerializeObject(env)
        JSON.Free(env)
        ReturnValue(line)
    }
}

Function.TDLib_BuildSimple {
    Input: id: Integer
    Input: method: Address
    Output: Address
    Body: {
        env = JSON.NewObject()
        JSON.SetNumber(env, "id", id)
        JSON.SetString(env, "method", method)
        line = JSON.SerializeObject(env)
        JSON.Free(env)
        ReturnValue(line)
    }
}

// =============================================================================
// SPAWN / IO (unchanged core)
// =============================================================================
Function.TDLib_Spawn {
    Input: worker_path: Address
    Output: Address
    Body: {
        in_pf = Allocate(8)
        ipr = SystemCall(TDLibSys.SYS_PIPE, in_pf, 0, 0, 0, 0)
        IfCondition LessThan(ipr, 0) ThenBlock: {
            Deallocate(in_pf, 8)
            ReturnValue(0)
        }
        in_read  = Dereference(in_pf, "dword")
        in_write = Dereference(Add(in_pf, 4), "dword")
        Deallocate(in_pf, 8)

        out_pf = Allocate(8)
        opr = SystemCall(TDLibSys.SYS_PIPE, out_pf, 0, 0, 0, 0)
        IfCondition LessThan(opr, 0) ThenBlock: {
            SystemCall(TDLibSys.SYS_CLOSE, in_read, 0, 0, 0, 0)
            SystemCall(TDLibSys.SYS_CLOSE, in_write, 0, 0, 0, 0)
            Deallocate(out_pf, 8)
            ReturnValue(0)
        }
        out_read  = Dereference(out_pf, "dword")
        out_write = Dereference(Add(out_pf, 4), "dword")
        Deallocate(out_pf, 8)

        argv = Allocate(16)
        StoreValue(argv, worker_path)
        StoreValue(Add(argv, 8), 0)

        pid = SystemCall(TDLibSys.SYS_FORK, 0, 0, 0, 0, 0)
        IfCondition LessThan(pid, 0) ThenBlock: {
            SystemCall(TDLibSys.SYS_CLOSE, in_read, 0, 0, 0, 0)
            SystemCall(TDLibSys.SYS_CLOSE, in_write, 0, 0, 0, 0)
            SystemCall(TDLibSys.SYS_CLOSE, out_read, 0, 0, 0, 0)
            SystemCall(TDLibSys.SYS_CLOSE, out_write, 0, 0, 0, 0)
            Deallocate(argv, 16)
            ReturnValue(0)
        }

        IfCondition EqualTo(pid, 0) ThenBlock: {
            SystemCall(TDLibSys.SYS_CLOSE, in_write, 0, 0, 0, 0)
            SystemCall(TDLibSys.SYS_CLOSE, out_read, 0, 0, 0, 0)
            SystemCall(TDLibSys.SYS_DUP2, in_read, 0, 0, 0, 0)
            SystemCall(TDLibSys.SYS_CLOSE, in_read, 0, 0, 0, 0)
            SystemCall(TDLibSys.SYS_DUP2, out_write, 1, 0, 0, 0)
            SystemCall(TDLibSys.SYS_CLOSE, out_write, 0, 0, 0, 0)
            null_fd = SystemCall(TDLibSys.SYS_OPEN, "/dev/null", 1, 0, 0, 0)
            IfCondition GreaterEqual(null_fd, 0) ThenBlock: {
                SystemCall(TDLibSys.SYS_DUP2, null_fd, 2, 0, 0, 0)
                SystemCall(TDLibSys.SYS_CLOSE, null_fd, 0, 0, 0, 0)
            }
            SystemCall(TDLibSys.SYS_EXECVE, worker_path, argv, 0)
            SystemCall(TDLibSys.SYS_EXIT, 1, 0, 0, 0, 0)
        }

        SystemCall(TDLibSys.SYS_CLOSE, in_read, 0, 0, 0, 0)
        SystemCall(TDLibSys.SYS_CLOSE, out_write, 0, 0, 0, 0)
        Deallocate(argv, 16)

        h = Allocate(48)
        MemorySet(h, 0, 48)
        StoreValue(Add(h, TDLibHandleOff.STDIN_FD), in_write, "dword")
        StoreValue(Add(h, TDLibHandleOff.STDOUT_FD), out_read, "dword")
        StoreValue(Add(h, TDLibHandleOff.PID), pid)
        line_buf = Allocate(TDLibConst.LINE_BUF_SZ)
        StoreValue(Add(h, TDLibHandleOff.LINE_BUF), line_buf)
        StoreValue(Add(h, TDLibHandleOff.BUF_POS), 0, "dword")
        StoreValue(Add(h, TDLibHandleOff.BUF_END), 0, "dword")
        StoreValue(Add(h, TDLibHandleOff.EOF), 0, "dword")
        ReturnValue(h)
    }
}

Function.TDLib_ReadLine {
    Input: handle: Address
    Output: Address
    Body: {
        IfCondition EqualTo(handle, 0) ThenBlock: { ReturnValue(0) }

        line_buf = Dereference(Add(handle, TDLibHandleOff.LINE_BUF))
        out = Allocate(TDLibConst.LINE_BUF_SZ)

        WhileLoop 1 {
            pos = Dereference(Add(handle, TDLibHandleOff.BUF_POS), "dword")
            end = Dereference(Add(handle, TDLibHandleOff.BUF_END), "dword")

            scan = pos
            found = -1
            WhileLoop LessThan(scan, end) {
                IfCondition EqualTo(GetByte(line_buf, scan), 10) ThenBlock: {
                    found = scan
                    BreakLoop
                }
                scan = Add(scan, 1)
            }

            IfCondition GreaterEqual(found, 0) ThenBlock: {
                line_len = Subtract(found, pos)
                IfCondition GreaterThan(line_len, 0) ThenBlock: {
                    last = GetByte(line_buf, Subtract(found, 1))
                    IfCondition EqualTo(last, 13) ThenBlock: {
                        line_len = Subtract(line_len, 1)
                    }
                }
                i = 0
                WhileLoop LessThan(i, line_len) {
                    SetByte(out, i, GetByte(line_buf, Add(pos, i)))
                    i = Add(i, 1)
                }
                SetByte(out, line_len, 0)
                StoreValue(Add(handle, TDLibHandleOff.BUF_POS), Add(found, 1), "dword")
                ReturnValue(out)
            }

            eof_flag = Dereference(Add(handle, TDLibHandleOff.EOF), "dword")
            IfCondition EqualTo(eof_flag, 1) ThenBlock: {
                Deallocate(out, TDLibConst.LINE_BUF_SZ)
                ReturnValue(0)
            }

            tail_len = Subtract(end, pos)
            IfCondition GreaterThan(tail_len, 0) ThenBlock: {
                k = 0
                WhileLoop LessThan(k, tail_len) {
                    SetByte(line_buf, k, GetByte(line_buf, Add(pos, k)))
                    k = Add(k, 1)
                }
            }
            StoreValue(Add(handle, TDLibHandleOff.BUF_POS), 0, "dword")
            StoreValue(Add(handle, TDLibHandleOff.BUF_END), tail_len, "dword")

            fd = Dereference(Add(handle, TDLibHandleOff.STDOUT_FD), "dword")
            free_space = Subtract(TDLibConst.READ_BUF_SZ, tail_len)
            IfCondition LessEqual(free_space, 0) ThenBlock: {
                Deallocate(out, TDLibConst.LINE_BUF_SZ)
                ReturnValue(0)
            }
            nread = SystemCall(TDLibSys.SYS_READ, fd, Add(line_buf, tail_len), free_space, 0, 0)
            IfCondition LessEqual(nread, 0) ThenBlock: {
                StoreValue(Add(handle, TDLibHandleOff.EOF), 1, "dword")
            } ElseBlock: {
                StoreValue(Add(handle, TDLibHandleOff.BUF_END), Add(tail_len, nread), "dword")
            }
        }
        ReturnValue(0)
    }
}

Function.TDLib_WriteLine {
    Input: handle: Address
    Input: line: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(handle, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(line, 0) ThenBlock: { ReturnValue(0) }
        fd = Dereference(Add(handle, TDLibHandleOff.STDIN_FD), "dword")
        len = StringLength(line)
        written = 0
        WhileLoop LessThan(written, len) {
            w = SystemCall(TDLibSys.SYS_WRITE, fd, Add(line, written), Subtract(len, written), 0, 0)
            IfCondition LessEqual(w, 0) ThenBlock: { ReturnValue(0) }
            written = Add(written, w)
        }
        nl_buf = Allocate(1)
        SetByte(nl_buf, 0, 10)
        SystemCall(TDLibSys.SYS_WRITE, fd, nl_buf, 1, 0, 0)
        Deallocate(nl_buf, 1)
        ReturnValue(1)
    }
}

// =============================================================================
// PUBLIC API
// =============================================================================
Function.TDLib_Open {
    Output: Address
    Body: {
        IfCondition NotEqual(TDLibState.handle, 0) ThenBlock: {
            ReturnValue(TDLibState.handle)
        }

        path = "./Telegram/tdlib_worker"
        h = TDLib_Spawn(path)
        IfCondition EqualTo(h, 0) ThenBlock: {
            path = "/system/Telegram/tdlib_worker"
            h = TDLib_Spawn(path)
        }
        IfCondition EqualTo(h, 0) ThenBlock: {
            PrintMessage("[TDLib] spawn failed\n")
            ReturnValue(0)
        }

        rid = TDLib_NextId()
        line = TDLib_BuildSimple(rid, "ping")
        TDLib_WriteLine(h, line)
        Deallocate(line, 0)
        resp = TDLib_ReadLine(h)
        IfCondition EqualTo(resp, 0) ThenBlock: {
            TDLib_Close(h)
            ReturnValue(0)
        }
        Deallocate(resp, 0)

        TDLibState.handle = h
        ReturnValue(h)
    }
}

Function.TDLib_Close {
    Input: handle: Address
    Body: {
        IfCondition EqualTo(handle, 0) ThenBlock: { ReturnValue(0) }
        rid = TDLib_NextId()
        line = TDLib_BuildSimple(rid, "shutdown")
        TDLib_WriteLine(handle, line)
        Deallocate(line, 0)
        pid = Dereference(Add(handle, TDLibHandleOff.PID))
        status_buf = Allocate(4)
        SystemCall(TDLibSys.SYS_WAIT4, pid, status_buf, 0, 0, 0)
        Deallocate(status_buf, 4)
        in_fd = Dereference(Add(handle, TDLibHandleOff.STDIN_FD), "dword")
        out_fd = Dereference(Add(handle, TDLibHandleOff.STDOUT_FD), "dword")
        SystemCall(TDLibSys.SYS_CLOSE, in_fd, 0, 0, 0, 0)
        SystemCall(TDLibSys.SYS_CLOSE, out_fd, 0, 0, 0, 0)
        line_buf = Dereference(Add(handle, TDLibHandleOff.LINE_BUF))
        IfCondition NotEqual(line_buf, 0) ThenBlock: {
            Deallocate(line_buf, TDLibConst.LINE_BUF_SZ)
        }
        Deallocate(handle, 48)
        IfCondition EqualTo(TDLibState.handle, handle) ThenBlock: {
            TDLibState.handle = 0
        }
    }
}

Function.TDLib_Call {
    Input: handle: Address
    Input: json_line: Address
    Output: Address
    Body: {
        IfCondition EqualTo(handle, 0) ThenBlock: { ReturnValue(0) }
        ok = TDLib_WriteLine(handle, json_line)
        IfCondition EqualTo(ok, 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(TDLib_ReadLine(handle))
    }
}

Function.TDLib_SendTd {
    Input: handle: Address
    Input: td_request: Address
    Output: Address
    Body: {
        rid = TDLib_NextId()
        line = TDLib_BuildEnvelope(rid, "send", td_request)
        resp = TDLib_Call(handle, line)
        Deallocate(line, 0)
        ReturnValue(resp)
    }
}

Function.TDLib_Poll {
    Input: handle: Address
    Output: Address
    Body: {
        IfCondition EqualTo(handle, 0) ThenBlock: { ReturnValue(0) }
        rid = TDLib_NextId()
        env = JSON.NewObject()
        JSON.SetNumber(env, "id", rid)
        JSON.SetString(env, "method", "receive")
        JSON.SetNumber(env, "timeout", 0)
        line = JSON.SerializeObject(env)
        JSON.Free(env)
        resp = TDLib_Call(handle, line)
        Deallocate(line, 0)
        ReturnValue(resp)
    }
}

Function.TDLib_Init {
    Input: api_id: Integer
    Input: api_hash: Address
    Input: db_dir: Address
    Output: Integer
    Body: {
        h = TDLib_Open()
        IfCondition EqualTo(h, 0) ThenBlock: { ReturnValue(0) }

        rid = TDLib_NextId()
        env = JSON.NewObject()
        JSON.SetNumber(env, "id", rid)
        JSON.SetString(env, "method", "init")
        JSON.SetNumber(env, "api_id", api_id)
        IfCondition NotEqual(api_hash, 0) ThenBlock: {
            JSON.SetString(env, "api_hash", api_hash)
        } ElseBlock: {
            JSON.SetString(env, "api_hash", "")
        }
        IfCondition NotEqual(db_dir, 0) ThenBlock: {
            JSON.SetString(env, "database_directory", db_dir)
        } ElseBlock: {
            JSON.SetString(env, "database_directory", "/tmp/ailang_telegram")
        }
        line = JSON.SerializeObject(env)
        JSON.Free(env)
        resp = TDLib_Call(h, line)
        Deallocate(line, 0)
        IfCondition EqualTo(resp, 0) ThenBlock: { ReturnValue(0) }
        Deallocate(resp, 0)
        ReturnValue(1)
    }
}