// Library.TelegramApp.ailang
// Telegram client — Auckland UI + TDLib worker bridge
//
// Auth flow: phone -> code -> (optional 2FA) -> ready -> chats/messages
// Config: config/telegram.json (api_id, api_hash, database_directory)
//
// Launch: EventRouter action "app.telegram"
//
// Copyright 2026 Sean Collins, 2 Paws Machine and Engineering. SCSL.

LibraryImport.Display.Window.WinManager
LibraryImport.Display.UI.Auckland
LibraryImport.Display.System.EventRouter
LibraryImport.Display.System.SysDisplay
LibraryImport.Display.Menu.Deskbar
LibraryImport.AppHost
LibraryImport.StringUtils
LibraryImport.JSON
LibraryImport.TDLibClient
LibraryImport.Display.Theme.UITheme
LibraryImport.Display.Theme.UIScale
LibraryImport.Display.Render.Fonts
LibraryImport.Display.UI.TextRegion
LibraryImport.TextBuffer

FixedPool.TelegramAuth {
    "NONE":          Initialize=0
    "WAIT_PHONE":    Initialize=1
    "WAIT_CODE":     Initialize=2
    "WAIT_PASSWORD": Initialize=3
    "READY":         Initialize=4
}

FixedPool.TelegramConst {
    "MAX_CHATS":       Initialize=32
    "MAX_MESSAGES":    Initialize=64
    "POLL_BURST":      Initialize=8
    "CONFIG_BUF":      Initialize=4096
    "SYS_OPEN":        Initialize=2
    "SYS_READ":        Initialize=0
    "SYS_CLOSE":       Initialize=3
    "O_RDONLY":        Initialize=0
}

FixedPool.TelegramConfig {
    "api_id":          Initialize=0, CanChange=True
    "api_hash":        Initialize=0, CanChange=True
    "db_dir":          Initialize=0, CanChange=True
}

FixedPool.TelegramState {
    "win_idx":         Initialize=-1, CanChange=True
    "chat_items":      Initialize=-1, CanChange=True
    "message_items":   Initialize=-1, CanChange=True
    "chat_title":      Initialize=-1, CanChange=True
    "compose_tf":      Initialize=-1, CanChange=True
    "selected_chat":   Initialize=0,  CanChange=True
    "chat_count":      Initialize=0,  CanChange=True
    "msg_count":       Initialize=0,  CanChange=True
    "auth_state":      Initialize=0,  CanChange=True
    "backend_ready":   Initialize=0,  CanChange=True
    "initialized":     Initialize=0,  CanChange=True
    "chats_loaded":    Initialize=0,  CanChange=True
}

FixedPool.TelegramChats {
    "ids":    Initialize=0, CanChange=True
    "titles": Initialize=0, CanChange=True
}

FixedPool.TelegramMessages {
    "texts":  Initialize=0, CanChange=True
}

// =============================================================================
// INIT
// =============================================================================
Function.TelegramApp_Init {
    Body: {
        EventRouter_RegisterHandler("app.telegram", AddressOf(TelegramApp_Open))

        chat_sz = Multiply(TelegramConst.MAX_CHATS, 8)
        TelegramChats.ids = Allocate(chat_sz)
        TelegramChats.titles = Allocate(chat_sz)
        MemorySet(TelegramChats.ids, 0, chat_sz)
        MemorySet(TelegramChats.titles, 0, chat_sz)

        msg_sz = Multiply(TelegramConst.MAX_MESSAGES, 8)
        TelegramMessages.texts = Allocate(msg_sz)
        MemorySet(TelegramMessages.texts, 0, msg_sz)

        TelegramConfig.api_hash = Allocate(128)
        SetByte(TelegramConfig.api_hash, 0, 0)
        TelegramConfig.db_dir = Allocate(256)
        MemoryCopy(TelegramConfig.db_dir, "/tmp/ailang_telegram", 20)
        SetByte(TelegramConfig.db_dir, 20, 0)
    }
}

// =============================================================================
// CONFIG — read config/telegram.json
// =============================================================================
Function.TelegramApp_LoadConfig {
    Body: {
        path = "config/telegram.json"
        fd = SystemCall(TelegramConst.SYS_OPEN, path, TelegramConst.O_RDONLY, 0)
        IfCondition LessThan(fd, 0) ThenBlock: {
            path = "/system/config/telegram.json"
            fd = SystemCall(TelegramConst.SYS_OPEN, path, TelegramConst.O_RDONLY, 0)
        }
        IfCondition LessThan(fd, 0) ThenBlock: {
            PrintMessage("[Telegram] no config, using defaults\n")
            ReturnValue(0)
        }

        buf = Allocate(TelegramConst.CONFIG_BUF)
        nread = SystemCall(TelegramConst.SYS_READ, fd, buf, TelegramConst.CONFIG_BUF)
        SystemCall(TelegramConst.SYS_CLOSE, fd, 0, 0)
        IfCondition LessEqual(nread, 0) ThenBlock: {
            Deallocate(buf, TelegramConst.CONFIG_BUF)
            ReturnValue(0)
        }
        SetByte(buf, nread, 0)

        root = ParseJSON(buf)
        Deallocate(buf, TelegramConst.CONFIG_BUF)
        IfCondition EqualTo(root, 0) ThenBlock: { ReturnValue(0) }

        obj = JSON.AsObject(root)
        IfCondition EqualTo(obj, 0) ThenBlock: {
            JSON.Free(root)
            ReturnValue(0)
        }

        aid = JSON.GetNumber(obj, "api_id")
        TelegramConfig.api_id = aid

        ah = JSON.GetString(obj, "api_hash")
        IfCondition NotEqual(ah, 0) ThenBlock: {
            ahlen = StringLength(ah)
            IfCondition GreaterThan(ahlen, 127) ThenBlock: { ahlen = 127 }
            MemoryCopy(TelegramConfig.api_hash, ah, ahlen)
            SetByte(TelegramConfig.api_hash, ahlen, 0)
        }

        dd = JSON.GetString(obj, "database_directory")
        IfCondition NotEqual(dd, 0) ThenBlock: {
            ddlen = StringLength(dd)
            IfCondition GreaterThan(ddlen, 255) ThenBlock: { ddlen = 255 }
            MemoryCopy(TelegramConfig.db_dir, dd, ddlen)
            SetByte(TelegramConfig.db_dir, ddlen, 0)
        }

        JSON.Free(root)
        PrintMessage("[Telegram] config loaded api_id=")
        PrintNumber(TelegramConfig.api_id)
        PrintMessage("\n")
        ReturnValue(1)
    }
}

// =============================================================================
// ACTION CALLBACK
// =============================================================================
Function.TelegramApp_ActionCb {
    Input: action_ptr: Address
    Input: action_len: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(action_len, 7) ThenBlock: {
            IfCondition EqualTo(StringCompare(action_ptr, "tg.send"), 0) ThenBlock: {
                TelegramApp_SubmitCompose()
                ReturnValue(1)
            }
        }

        IfCondition GreaterEqual(action_len, 8) ThenBlock: {
            IfCondition EqualTo(StringStartsWith(action_ptr, "tg.chat."), 1) ThenBlock: {
                TelegramApp_SelectChat(action_ptr, action_len)
                ReturnValue(1)
            }
        }

        ReturnValue(0)
    }
}

// =============================================================================
// OPEN / CLOSE
// =============================================================================
Function.TelegramApp_Open {
    Output: Integer
    Body: {
        IfCondition GreaterEqual(TelegramState.win_idx, 0) ThenBlock: {
            Win_Focus(TelegramState.win_idx)
            ReturnValue(TelegramState.win_idx)
        }

        TelegramApp_LoadConfig()

        ok = TDLib_Init(TelegramConfig.api_id, TelegramConfig.api_hash, TelegramConfig.db_dir)
        IfCondition EqualTo(ok, 0) ThenBlock: {
            PrintMessage("[Telegram] TDLib init failed\n")
            ReturnValue(-1)
        }

        win_idx = AppHost_Open("config/telegram.html", AddressOf(TelegramApp_ActionCb))
        IfCondition LessEqual(win_idx, 0) ThenBlock: {
            PrintMessage("[Telegram] AppHost_Open fail\n")
            ReturnValue(-1)
        }
        TelegramState.win_idx = win_idx

        ctx = WinView_GetContentCtx(win_idx)
        TelegramState.chat_items = AK_FindById(ctx, "chat-items")
        TelegramState.message_items = AK_FindById(ctx, "message-items")
        TelegramState.chat_title = AK_FindById(ctx, "chat-title")
        TelegramState.compose_tf = AK_FindById(ctx, "compose")
        TelegramState.initialized = 1
        TelegramState.backend_ready = 0
        TelegramState.auth_state = TelegramAuth.NONE
        TelegramState.chat_count = 0
        TelegramState.msg_count = 0
        TelegramState.chats_loaded = 0
        TelegramState.selected_chat = 0

        TelegramApp_SetTitle(ctx, "Connecting to Telegram...")
        TelegramApp_ShowSystemMessage(ctx, "Starting TDLib backend...")
        TelegramApp_SetComposeHint(ctx, "Please wait...")

        TelegramApp_StartupBackend()

        DeskbarState.needs_refresh = 1
        SysDisplayState.dirty = 1

        PrintMessage("[Telegram] opened win=")
        PrintNumber(win_idx)
        PrintMessage("\n")
        ReturnValue(win_idx)
    }
}

Function.TelegramApp_Close {
    Body: {
        IfCondition LessThan(TelegramState.win_idx, 0) ThenBlock: { ReturnValue(0) }
        AppHost_Close(TelegramState.win_idx)
        h = TDLibState.handle
        IfCondition NotEqual(h, 0) ThenBlock: { TDLib_Close(h) }
        TelegramState.win_idx = -1
        TelegramState.initialized = 0
        DeskbarState.needs_refresh = 1
    }
}

// =============================================================================
// BACKEND STARTUP
// =============================================================================
Function.TelegramApp_StartupBackend {
    Body: {
        h = TDLibState.handle
        IfCondition EqualTo(h, 0) ThenBlock: { ReturnValue(0) }

        req = TDLib_NewTd("getAuthorizationState")
        resp = TDLib_SendTd(h, req)
        IfCondition NotEqual(resp, 0) ThenBlock: { Deallocate(resp, 0) }

        req2 = TDLib_NewTd("setLogVerbosityLevel")
        JSON.SetNumber(req2, "new_verbosity_level", 0)
        resp2 = TDLib_SendTd(h, req2)
        IfCondition NotEqual(resp2, 0) ThenBlock: { Deallocate(resp2, 0) }
    }
}

// =============================================================================
// POLL — drain worker responses each frame
// =============================================================================
Function.TelegramApp_Poll {
    Body: {
        IfCondition LessThan(TelegramState.win_idx, 0) ThenBlock: { ReturnValue(0) }
        h = TDLibState.handle
        IfCondition EqualTo(h, 0) ThenBlock: { ReturnValue(0) }

        got = 0
        burst = 0
        WhileLoop LessThan(burst, TelegramConst.POLL_BURST) {
            resp = TDLib_Poll(h)
            IfCondition EqualTo(resp, 0) ThenBlock: { BreakLoop }

            IfCondition NotEqual(StringIndexOf(resp, "\"message\":null"), -1) ThenBlock: {
                Deallocate(resp, 0)
                BreakLoop
            }

            handled = TelegramApp_HandleWorkerLine(resp)
            Deallocate(resp, 0)
            IfCondition EqualTo(handled, 1) ThenBlock: { got = 1 }
            burst = Add(burst, 1)
        }
        ReturnValue(got)
    }
}

Function.TelegramApp_HandleWorkerLine {
    Input: line: Address
    Output: Integer
    Body: {
        root = ParseJSON(line)
        IfCondition EqualTo(root, 0) ThenBlock: { ReturnValue(0) }

        obj = JSON.AsObject(root)
        IfCondition EqualTo(obj, 0) ThenBlock: {
            JSON.Free(root)
            ReturnValue(0)
        }

        msg = JSON.GetObject(obj, "message")
        IfCondition EqualTo(msg, 0) ThenBlock: {
            JSON.Free(root)
            ReturnValue(0)
        }

        typ = JSON.GetString(msg, "@type")
        IfCondition EqualTo(typ, 0) ThenBlock: {
            JSON.Free(root)
            ReturnValue(0)
        }

        handled = 0
        IfCondition EqualTo(StringCompare(typ, "updateAuthorizationState"), 0) ThenBlock: {
            TelegramApp_HandleAuthUpdate(msg)
            handled = 1
        }
        IfCondition EqualTo(StringCompare(typ, "updateNewMessage"), 0) ThenBlock: {
            TelegramApp_HandleNewMessage(msg)
            handled = 1
        }
        IfCondition EqualTo(StringCompare(typ, "chats"), 0) ThenBlock: {
            TelegramApp_HandleChats(msg)
            handled = 1
        }
        IfCondition EqualTo(StringCompare(typ, "messages"), 0) ThenBlock: {
            TelegramApp_HandleMessages(msg)
            handled = 1
        }

        JSON.Free(root)
        ReturnValue(handled)
    }
}

// =============================================================================
// AUTH
// =============================================================================
Function.TelegramApp_HandleAuthUpdate {
    Input: update_obj: Address
    Body: {
        state = JSON.GetObject(update_obj, "authorization_state")
        IfCondition EqualTo(state, 0) ThenBlock: { ReturnValue(0) }

        stype = JSON.GetString(state, "@type")
        IfCondition EqualTo(stype, 0) ThenBlock: { ReturnValue(0) }

        ctx = WinView_GetContentCtx(TelegramState.win_idx)

        IfCondition EqualTo(StringCompare(stype, "authorizationStateWaitPhoneNumber"), 0) ThenBlock: {
            TelegramState.auth_state = TelegramAuth.WAIT_PHONE
            TelegramApp_SetTitle(ctx, "Telegram — Sign in")
            TelegramApp_ShowSystemMessage(ctx, "Enter your phone number (international format, e.g. +15551234)")
            TelegramApp_SetComposeHint(ctx, "Phone number...")
        }

        IfCondition EqualTo(StringCompare(stype, "authorizationStateWaitCode"), 0) ThenBlock: {
            TelegramState.auth_state = TelegramAuth.WAIT_CODE
            TelegramApp_SetTitle(ctx, "Telegram — Verify")
            TelegramApp_ShowSystemMessage(ctx, "Enter the login code sent to your Telegram app")
            TelegramApp_SetComposeHint(ctx, "Login code...")
        }

        IfCondition EqualTo(StringCompare(stype, "authorizationStateWaitPassword"), 0) ThenBlock: {
            TelegramState.auth_state = TelegramAuth.WAIT_PASSWORD
            TelegramApp_SetTitle(ctx, "Telegram — 2FA")
            TelegramApp_ShowSystemMessage(ctx, "Enter your two-factor authentication password")
            TelegramApp_SetComposeHint(ctx, "2FA password...")
        }

        IfCondition EqualTo(StringCompare(stype, "authorizationStateReady"), 0) ThenBlock: {
            TelegramState.auth_state = TelegramAuth.READY
            TelegramState.backend_ready = 1
            TelegramApp_SetTitle(ctx, "Telegram")
            TelegramApp_SetComposeHint(ctx, "Message...")
            TelegramApp_RequestChats()
        }

        SysDisplayState.dirty = 1
    }
}

Function.TelegramApp_SubmitCompose {
    Body: {
        ctx = WinView_GetContentCtx(TelegramState.win_idx)
        tf = TelegramState.compose_tf
        IfCondition LessThan(tf, 0) ThenBlock: { ReturnValue(0) }

        tbh = AK_ExtraGet(ctx, tf, AKExtra.TEXTBUF_H)
        IfCondition LessEqual(tbh, 0) ThenBlock: { ReturnValue(0) }

        line = TextBuf_GetLine(tbh, 0)
        IfCondition EqualTo(line, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(StringLength(line), 0) ThenBlock: { ReturnValue(0) }

        h = TDLibState.handle
        IfCondition EqualTo(h, 0) ThenBlock: { ReturnValue(0) }

        auth = TelegramState.auth_state
        IfCondition EqualTo(auth, TelegramAuth.WAIT_PHONE) ThenBlock: {
            req = TDLib_NewTd("setAuthenticationPhoneNumber")
            JSON.SetString(req, "phone_number", line)
            settings = JSON.NewObject()
            JSON.SetObject(req, "settings", settings)
            resp = TDLib_SendTd(h, req)
            IfCondition NotEqual(resp, 0) ThenBlock: { Deallocate(resp, 0) }
            TelegramApp_ShowSystemMessage(ctx, "Code sent — check your Telegram app")
        }

        IfCondition EqualTo(auth, TelegramAuth.WAIT_CODE) ThenBlock: {
            req = TDLib_NewTd("checkAuthenticationCode")
            JSON.SetString(req, "code", line)
            resp = TDLib_SendTd(h, req)
            IfCondition NotEqual(resp, 0) ThenBlock: { Deallocate(resp, 0) }
        }

        IfCondition EqualTo(auth, TelegramAuth.WAIT_PASSWORD) ThenBlock: {
            req = TDLib_NewTd("checkAuthenticationPassword")
            JSON.SetString(req, "password", line)
            resp = TDLib_SendTd(h, req)
            IfCondition NotEqual(resp, 0) ThenBlock: { Deallocate(resp, 0) }
        }

        IfCondition EqualTo(auth, TelegramAuth.READY) ThenBlock: {
            TelegramApp_SendChatMessage(line)
        }

        TextBuf_Clear(tbh)
        AK_Set(ctx, tf, AKF.DIRTY, 1)
        SysDisplayState.dirty = 1
    }
}

// =============================================================================
// CHATS
// =============================================================================
Function.TelegramApp_RequestChats {
    Body: {
        h = TDLibState.handle
        IfCondition EqualTo(h, 0) ThenBlock: { ReturnValue(0) }

        req = TDLib_NewTd("getChats")
        chat_list = JSON.NewObject()
        JSON.SetString(chat_list, "@type", "chatListMain")
        JSON.SetObject(req, "chat_list", chat_list)
        JSON.SetNumber(req, "limit", 50)
        resp = TDLib_SendTd(h, req)
        IfCondition NotEqual(resp, 0) ThenBlock: { Deallocate(resp, 0) }
    }
}

Function.TelegramApp_HandleChats {
    Input: chats_obj: Address
    Body: {
        ids = JSON.GetArray(chats_obj, "chat_ids")
        IfCondition EqualTo(ids, 0) ThenBlock: { ReturnValue(0) }

        TelegramState.chat_count = 0
        cnt = Array.Size(ids)
        i = 0
        WhileLoop LessThan(i, cnt) {
            tagged = Array.Get(ids, i)
            cid = JSON.AsNumber(tagged)
            ctitle = TelegramApp_TitleForChatId(cid)
            TelegramApp_RegisterChat(cid, ctitle)
            i = Add(i, 1)
        }

        IfCondition EqualTo(TelegramState.selected_chat, 0) ThenBlock: {
            IfCondition GreaterThan(TelegramState.chat_count, 0) ThenBlock: {
                TelegramState.selected_chat = Dereference(TelegramChats.ids)
            }
        }

        ctx = WinView_GetContentCtx(TelegramState.win_idx)
        TelegramApp_RebuildChatList(ctx)
        TelegramState.chats_loaded = 1

        IfCondition GreaterThan(TelegramState.selected_chat, 0) ThenBlock: {
            TelegramApp_RequestHistory(TelegramState.selected_chat)
        }

        SysDisplayState.dirty = 1
    }
}

Function.TelegramApp_TitleForChatId {
    Input: chat_id: Integer
    Output: Address
    Body: {
        IfCondition EqualTo(chat_id, 1001) ThenBlock: { ReturnValue("Alice") }
        IfCondition EqualTo(chat_id, 1002) ThenBlock: { ReturnValue("Bob") }
        IfCondition EqualTo(chat_id, 1003) ThenBlock: { ReturnValue("Dev Channel") }
        ReturnValue("Chat")
    }
}

Function.TelegramApp_RegisterChat {
    Input: chat_id: Integer
    Input: title: Address
    Body: {
        idx = TelegramState.chat_count
        IfCondition GreaterEqual(idx, TelegramConst.MAX_CHATS) ThenBlock: { ReturnValue(0) }
        StoreValue(Add(TelegramChats.ids, Multiply(idx, 8)), chat_id)
        tlen = StringLength(title)
        title_copy = Allocate(Add(tlen, 1))
        MemoryCopy(title_copy, title, tlen)
        SetByte(title_copy, tlen, 0)
        StoreValue(Add(TelegramChats.titles, Multiply(idx, 8)), title_copy)
        TelegramState.chat_count = Add(idx, 1)
    }
}

// =============================================================================
// MESSAGES
// =============================================================================
Function.TelegramApp_RequestHistory {
    Input: chat_id: Integer
    Body: {
        h = TDLibState.handle
        IfCondition EqualTo(h, 0) ThenBlock: { ReturnValue(0) }

        req = TDLib_NewTd("getChatHistory")
        JSON.SetNumber(req, "chat_id", chat_id)
        JSON.SetNumber(req, "from_message_id", 0)
        JSON.SetNumber(req, "offset", 0)
        JSON.SetNumber(req, "limit", 50)
        JSON.SetBool(req, "only_local", 0)
        resp = TDLib_SendTd(h, req)
        IfCondition NotEqual(resp, 0) ThenBlock: { Deallocate(resp, 0) }
    }
}

Function.TelegramApp_HandleMessages {
    Input: msgs_obj: Address
    Body: {
        TelegramApp_ClearMessageCache()
        arr = JSON.GetArray(msgs_obj, "messages")
        IfCondition EqualTo(arr, 0) ThenBlock: { ReturnValue(0) }

        cnt = Array.Size(arr)
        i = 0
        WhileLoop LessThan(i, cnt) {
            tagged = Array.Get(arr, i)
            mobj = JSON.AsObject(tagged)
            IfCondition NotEqual(mobj, 0) ThenBlock: {
                txt = TelegramApp_ExtractMessageText(mobj)
                TelegramApp_CacheMessage(txt)
            }
            i = Add(i, 1)
        }

        ctx = WinView_GetContentCtx(TelegramState.win_idx)
        TelegramApp_RenderCachedMessages(ctx)
        SysDisplayState.dirty = 1
    }
}

Function.TelegramApp_HandleNewMessage {
    Input: update_obj: Address
    Body: {
        IfCondition NotEqual(TelegramState.auth_state, TelegramAuth.READY) ThenBlock: {
            ReturnValue(0)
        }
        msg = JSON.GetObject(update_obj, "message")
        IfCondition EqualTo(msg, 0) ThenBlock: { ReturnValue(0) }

        chat_id = JSON.GetNumber(msg, "chat_id")
        IfCondition NotEqual(chat_id, TelegramState.selected_chat) ThenBlock: {
            ReturnValue(0)
        }

        txt = TelegramApp_ExtractMessageText(msg)
        ctx = WinView_GetContentCtx(TelegramState.win_idx)
        TelegramApp_CacheMessage(txt)
        TelegramApp_RenderCachedMessages(ctx)
        SysDisplayState.dirty = 1
    }
}

Function.TelegramApp_ExtractMessageText {
    Input: msg_obj: Address
    Output: Address
    Body: {
        content = JSON.GetObject(msg_obj, "content")
        IfCondition EqualTo(content, 0) ThenBlock: {
            ReturnValue("(unsupported message)")
        }
        ctype = JSON.GetString(content, "@type")
        IfCondition EqualTo(ctype, 0) ThenBlock: {
            ReturnValue("(unsupported message)")
        }
        IfCondition EqualTo(StringCompare(ctype, "messageText"), 0) ThenBlock: {
            ft = JSON.GetObject(content, "text")
            IfCondition NotEqual(ft, 0) ThenBlock: {
                t = JSON.GetString(ft, "text")
                IfCondition NotEqual(t, 0) ThenBlock: { ReturnValue(t) }
            }
        }
        ReturnValue("(media)")
    }
}

Function.TelegramApp_SendChatMessage {
    Input: text: Address
    Body: {
        chat_id = TelegramState.selected_chat
        IfCondition EqualTo(chat_id, 0) ThenBlock: { ReturnValue(0) }

        ctx = WinView_GetContentCtx(TelegramState.win_idx)
        TelegramApp_CacheMessage(text)
        TelegramApp_RenderCachedMessages(ctx)

        h = TDLibState.handle
        IfCondition EqualTo(h, 0) ThenBlock: { ReturnValue(0) }

        req = TDLib_NewTd("sendMessage")
        JSON.SetNumber(req, "chat_id", chat_id)
        input_msg = JSON.NewObject()
        JSON.SetObject(req, "input_message_content", input_msg)
        JSON.SetString(input_msg, "@type", "inputMessageText")
        ft = JSON.NewObject()
        JSON.SetObject(input_msg, "text", ft)
        JSON.SetString(ft, "@type", "formattedText")
        JSON.SetString(ft, "text", text)

        resp = TDLib_SendTd(h, req)
        IfCondition NotEqual(resp, 0) ThenBlock: { Deallocate(resp, 0) }
    }
}

Function.TelegramApp_ClearMessageCache {
    Body: {
        i = 0
        WhileLoop LessThan(i, TelegramState.msg_count) {
            ptr = Dereference(Add(TelegramMessages.texts, Multiply(i, 8)))
            IfCondition NotEqual(ptr, 0) ThenBlock: {
                Deallocate(ptr, 0)
                StoreValue(Add(TelegramMessages.texts, Multiply(i, 8)), 0)
            }
            i = Add(i, 1)
        }
        TelegramState.msg_count = 0
    }
}

Function.TelegramApp_CacheMessage {
    Input: text: Address
    Body: {
        idx = TelegramState.msg_count
        IfCondition GreaterEqual(idx, TelegramConst.MAX_MESSAGES) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(text, 0) ThenBlock: { ReturnValue(0) }
        tlen = StringLength(text)
        copy = Allocate(Add(tlen, 1))
        MemoryCopy(copy, text, tlen)
        SetByte(copy, tlen, 0)
        StoreValue(Add(TelegramMessages.texts, Multiply(idx, 8)), copy)
        TelegramState.msg_count = Add(idx, 1)
    }
}

Function.TelegramApp_RenderCachedMessages {
    Input: ctx: LinkagePool.AKContext
    Body: {
        parent = TelegramState.message_items
        IfCondition LessThan(parent, 0) ThenBlock: { ReturnValue(0) }
        AK_ClearChildren(ctx, parent)

        rh = Add(UIScale.font_body, 4)
        i = 0
        WhileLoop LessThan(i, TelegramState.msg_count) {
            txt = Dereference(Add(TelegramMessages.texts, Multiply(i, 8)))
            IfCondition NotEqual(txt, 0) ThenBlock: {
                TelegramApp_AddMessageRow(ctx, parent, txt, rh)
            }
            i = Add(i, 1)
        }
    }
}

// =============================================================================
// UI HELPERS
// =============================================================================
Function.TelegramApp_SetTitle {
    Input: ctx: LinkagePool.AKContext
    Input: title: Address
    Body: {
        node = TelegramState.chat_title
        IfCondition LessThan(node, 0) ThenBlock: { ReturnValue(0) }
        tlen = StringLength(title)
        AK_ExtraSet(ctx, node, AKExtra.STR_PTR, title)
        AK_ExtraSet(ctx, node, AKExtra.STR_LEN, tlen)
        AK_Set(ctx, node, AKF.DIRTY, 1)
    }
}

Function.TelegramApp_SetComposeHint {
    Input: ctx: LinkagePool.AKContext
    Input: hint: Address
    Body: {
        tf = TelegramState.compose_tf
        IfCondition LessThan(tf, 0) ThenBlock: { ReturnValue(0) }
        hlen = StringLength(hint)
        AK_ExtraSet(ctx, tf, AKExtra.SCROLL_Y, hint)
        AK_ExtraSet(ctx, tf, AKExtra.SYNTAX_MODE, hlen)
    }
}

Function.TelegramApp_ShowSystemMessage {
    Input: ctx: LinkagePool.AKContext
    Input: text: Address
    Body: {
        TelegramApp_ClearMessageCache()
        TelegramApp_CacheMessage(text)
        TelegramApp_RenderCachedMessages(ctx)
    }
}

Function.TelegramApp_RebuildChatList {
    Input: ctx: LinkagePool.AKContext
    Body: {
        parent = TelegramState.chat_items
        IfCondition LessThan(parent, 0) ThenBlock: { ReturnValue(0) }
        AK_ClearChildren(ctx, parent)

        rh = Add(UIScale.font_body, Divide(UIScale.font_body, 3))
        IfCondition LessThan(rh, Add(UIScale.font_body, 2)) ThenBlock: {
            rh = Add(UIScale.font_body, 2)
        }

        ci = 0
        WhileLoop LessThan(ci, TelegramState.chat_count) {
            cid = Dereference(Add(TelegramChats.ids, Multiply(ci, 8)))
            ctitle = Dereference(Add(TelegramChats.titles, Multiply(ci, 8)))
            TelegramApp_DrawChatRow(ctx, parent, cid, ctitle, rh)
            ci = Add(ci, 1)
        }
    }
}

Function.TelegramApp_DrawChatRow {
    Input: ctx: LinkagePool.AKContext
    Input: parent: Integer
    Input: chat_id: Integer
    Input: title: Address
    Input: row_h: Integer
    Body: {
        action = Allocate(32)
        prefix = "tg.chat."
        MemoryCopy(action, prefix, 8)
        id_str = NumberToString(chat_id)
        id_len = StringLength(id_str)
        MemoryCopy(Add(action, 8), id_str, id_len)
        SetByte(action, Add(8, id_len), 0)
        action_len = Add(8, id_len)

        tlen = StringLength(title)
        btn = AK_CreateNode(ctx, AKTag.BUTTON)
        AK_Set(ctx, btn, AKF.HEIGHT, row_h)
        AK_ExtraSet(ctx, btn, AKExtra.STR_PTR, title)
        AK_ExtraSet(ctx, btn, AKExtra.STR_LEN, tlen)
        AK_ExtraSet(ctx, btn, AKExtra.TEXT_ALIGN, TRAlign.LEFT)
        AK_ExtraSet(ctx, btn, AKExtra.ACTION_PTR, action)
        AK_ExtraSet(ctx, btn, AKExtra.ACTION_LEN, action_len)
        AK_ExtraSet(ctx, btn, AKExtra.COLOR_FG, Theme.ak_btn_fg)
        IfCondition EqualTo(chat_id, TelegramState.selected_chat) ThenBlock: {
            AK_ExtraSet(ctx, btn, AKExtra.COLOR_BG, Theme.ak_btn_pressed)
        } ElseBlock: {
            AK_ExtraSet(ctx, btn, AKExtra.COLOR_BG, Theme.ak_btn_bg)
        }
        AK_AddChild(ctx, parent, btn)
    }
}

Function.TelegramApp_SelectChat {
    Input: action_ptr: Address
    Input: action_len: Integer
    Body: {
        chat_id = 0
        i = 8
        WhileLoop LessThan(i, action_len) {
            ch = GetByte(action_ptr, i)
            IfCondition And(GreaterEqual(ch, 48), LessEqual(ch, 57)) ThenBlock: {
                chat_id = Add(Multiply(chat_id, 10), Subtract(ch, 48))
            }
            i = Add(i, 1)
        }
        IfCondition EqualTo(chat_id, 0) ThenBlock: { ReturnValue(0) }

        TelegramState.selected_chat = chat_id
        ctx = WinView_GetContentCtx(TelegramState.win_idx)

        ci = 0
        title = "Chat"
        WhileLoop LessThan(ci, TelegramState.chat_count) {
            cid = Dereference(Add(TelegramChats.ids, Multiply(ci, 8)))
            IfCondition EqualTo(cid, chat_id) ThenBlock: {
                title = Dereference(Add(TelegramChats.titles, Multiply(ci, 8)))
                BreakLoop
            }
            ci = Add(ci, 1)
        }

        TelegramApp_SetTitle(ctx, title)
        TelegramApp_RebuildChatList(ctx)
        TelegramApp_RequestHistory(chat_id)
        SysDisplayState.dirty = 1
    }
}

Function.TelegramApp_AddMessageRow {
    Input: ctx: LinkagePool.AKContext
    Input: parent: Integer
    Input: text: Address
    Input: row_h: Integer
    Body: {
        tlen = StringLength(text)
        lbl = AK_CreateNode(ctx, AKTag.LABEL)
        AK_Set(ctx, lbl, AKF.HEIGHT, row_h)
        AK_ExtraSet(ctx, lbl, AKExtra.STR_PTR, text)
        AK_ExtraSet(ctx, lbl, AKExtra.STR_LEN, tlen)
        AK_ExtraSet(ctx, lbl, AKExtra.COLOR_FG, Theme.ak_btn_fg)
        AK_ExtraSet(ctx, lbl, AKExtra.TEXT_ALIGN, TRAlign.LEFT)
        AK_AddChild(ctx, parent, lbl)
    }
}