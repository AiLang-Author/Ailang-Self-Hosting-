        SetByte(d,12,0x00) SetByte(d,13,0x00) SetByte(d,14,0x00) SetByte(d,15,0x00)
        // idx 1: U+2502 │ (vertical line)
        SetByte(d,16,0x18) SetByte(d,17,0x18) SetByte(d,18,0x18) SetByte(d,19,0x18)
        SetByte(d,20,0x18) SetByte(d,21,0x18) SetByte(d,22,0x18) SetByte(d,23,0x18)
        SetByte(d,24,0x18) SetByte(d,25,0x18) SetByte(d,26,0x18) SetByte(d,27,0x18)
        SetByte(d,28,0x18) SetByte(d,29,0x18) SetByte(d,30,0x18) SetByte(d,31,0x18)
        // idx 2: U+250C ┌ (top-left corner)
