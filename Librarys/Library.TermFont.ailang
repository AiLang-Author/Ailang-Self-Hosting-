// =============================================================================
// INIT — allocate font table and fill all blocks
// =============================================================================
Function.TermFont_Init {
    Body: {
        d = Allocate(1520)
        MemorySet(d, 0, 1520)
        TermFontState.font_data = d

        TermFont_InitBlock0(d)
        TermFont_InitBlock1(d)
        TermFont_InitBlock2(d)
        TermFont_InitBlock3(d)

        // Extended glyphs: box-drawing, blocks, symbols, Claude Code glyphs, fallback
        ext = Allocate(912)
        MemorySet(ext, 0, 912)
        TermFontState.ext_data = ext

        TermFont_InitExt0(ext)
        TermFont_InitExt1(ext)
        TermFont_InitExt2(ext)
        TermFont_InitExt3(ext)
        TermFont_InitExt4(ext)

        TermFontState.loaded = 1
        PrintMessage("[TermFont] Loaded VGA 8x16 bitmap font (95+56 glyphs)\n")
    }
}
