        SetByte(d,72,0x1F) SetByte(d,73,0x00) SetByte(d,74,0x00) SetByte(d,75,0x00)
        SetByte(d,76,0x00) SetByte(d,77,0x00) SetByte(d,78,0x00) SetByte(d,79,0x00)
        // idx 5: U+2518 ┘ (bottom-right corner)
