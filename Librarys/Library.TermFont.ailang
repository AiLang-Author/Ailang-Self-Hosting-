// Library.TermFont.ailang
// Embedded 8x16 monospace bitmap font for terminal/canvas text rendering.
// VGA ROM 8x16 glyphs (public domain) for ASCII 32-126.
// Extended glyphs: box-drawing (U+2500-257F), block elements (U+2580-259F),
// rounded corners (U+256D-2570), symbols (bullets, checks, etc).
// Each glyph: 16 bytes (one byte per row, MSB = leftmost pixel).
//
// API:
//   TermFont_Init()                        — allocate + fill bitmap table
//   TermFont_SetColors(fg, bg)             — set BGRA foreground/background
//   TermFont_DrawCharFgBg(buf, stride, x, y, ch) — render one char to pixel buffer
//
// Copyright 2026 Sean Collins, 2 Paws Machine and Engineering. SCSL.

LibraryImport.Arena

// =============================================================================
// CONSTANTS
// =============================================================================
FixedPool.TermFontConst {
    "CHAR_W":          Initialize=8
    "CHAR_H":          Initialize=16
    "FIRST_CHAR":      Initialize=32
    "LAST_CHAR":       Initialize=126
    "GLYPH_COUNT":     Initialize=95
    "BYTES_PER_GLYPH": Initialize=16
    "TABLE_SIZE":      Initialize=1520
}

// Extended glyph table: 57 glyphs for box-drawing, blocks, symbols, Claude Code TUI + fallback
// Stored as codepoint→index mapping via lookup function
// Index 42 = fallback glyph (dotted rectangle for unknown codepoints)
FixedPool.TermFontExt {
    "EXT_COUNT":     Initialize=57
    "EXT_SIZE":      Initialize=912
    "FALLBACK_IDX":  Initialize=42
}

// =============================================================================
// STATE
// =============================================================================
FixedPool.TermFontState {
    "font_data": Initialize=0
    "ext_data":  Initialize=0
    "fg_color":  Initialize=0xFF00FF00
    "bg_color":  Initialize=0xFF000000
    "loaded":    Initialize=0
}

// =============================================================================
// SET COLORS — set current fg/bg for subsequent draws
// =============================================================================
Function.TermFont_SetColors {
    Input: fg: Integer
    Input: bg: Integer
    Body: {
        TermFontState.fg_color = fg
        TermFontState.bg_color = bg
    }
}

// =============================================================================
// EXTENDED GLYPH LOOKUP — map Unicode codepoint to ext table index
// Returns -1 if not found, else index 0..41
// Layout: 0-10=box single, 11-14=rounded, 15-25=double, 26-33=blocks, 34-41=symbols
// =============================================================================
Function.TermFont_ExtLookup {
    Input: cp: Integer
    Output: Integer
    Body: {
        // Box-drawing single-line: U+2500-253C (sparse)
        IfCondition EqualTo(cp, 0x2500) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(cp, 0x2502) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(cp, 0x250C) ThenBlock: { ReturnValue(2) }
        IfCondition EqualTo(cp, 0x2510) ThenBlock: { ReturnValue(3) }
        IfCondition EqualTo(cp, 0x2514) ThenBlock: { ReturnValue(4) }
        IfCondition EqualTo(cp, 0x2518) ThenBlock: { ReturnValue(5) }
        IfCondition EqualTo(cp, 0x251C) ThenBlock: { ReturnValue(6) }
        IfCondition EqualTo(cp, 0x2524) ThenBlock: { ReturnValue(7) }
        IfCondition EqualTo(cp, 0x252C) ThenBlock: { ReturnValue(8) }
        IfCondition EqualTo(cp, 0x2534) ThenBlock: { ReturnValue(9) }
        IfCondition EqualTo(cp, 0x253C) ThenBlock: { ReturnValue(10) }
        // Rounded corners
        IfCondition EqualTo(cp, 0x256D) ThenBlock: { ReturnValue(11) }
        IfCondition EqualTo(cp, 0x256E) ThenBlock: { ReturnValue(12) }
        IfCondition EqualTo(cp, 0x256F) ThenBlock: { ReturnValue(13) }
        IfCondition EqualTo(cp, 0x2570) ThenBlock: { ReturnValue(14) }
        // Double-line
        IfCondition EqualTo(cp, 0x2550) ThenBlock: { ReturnValue(15) }
        IfCondition EqualTo(cp, 0x2551) ThenBlock: { ReturnValue(16) }
        IfCondition EqualTo(cp, 0x2554) ThenBlock: { ReturnValue(17) }
        IfCondition EqualTo(cp, 0x2557) ThenBlock: { ReturnValue(18) }
        IfCondition EqualTo(cp, 0x255A) ThenBlock: { ReturnValue(19) }
        IfCondition EqualTo(cp, 0x255D) ThenBlock: { ReturnValue(20) }
        IfCondition EqualTo(cp, 0x2560) ThenBlock: { ReturnValue(21) }
        IfCondition EqualTo(cp, 0x2563) ThenBlock: { ReturnValue(22) }
        IfCondition EqualTo(cp, 0x2566) ThenBlock: { ReturnValue(23) }
        IfCondition EqualTo(cp, 0x2569) ThenBlock: { ReturnValue(24) }
        IfCondition EqualTo(cp, 0x256C) ThenBlock: { ReturnValue(25) }
        // Block elements
        IfCondition EqualTo(cp, 0x2580) ThenBlock: { ReturnValue(26) }
        IfCondition EqualTo(cp, 0x2584) ThenBlock: { ReturnValue(27) }
        IfCondition EqualTo(cp, 0x2588) ThenBlock: { ReturnValue(28) }
        IfCondition EqualTo(cp, 0x258C) ThenBlock: { ReturnValue(29) }
        IfCondition EqualTo(cp, 0x2590) ThenBlock: { ReturnValue(30) }
        IfCondition EqualTo(cp, 0x2591) ThenBlock: { ReturnValue(31) }
        IfCondition EqualTo(cp, 0x2592) ThenBlock: { ReturnValue(32) }
        IfCondition EqualTo(cp, 0x2593) ThenBlock: { ReturnValue(33) }
        // Symbols
        IfCondition EqualTo(cp, 0x2022) ThenBlock: { ReturnValue(34) }
        IfCondition EqualTo(cp, 0x25CF) ThenBlock: { ReturnValue(35) }
        IfCondition EqualTo(cp, 0x25CB) ThenBlock: { ReturnValue(36) }
        IfCondition EqualTo(cp, 0x25BA) ThenBlock: { ReturnValue(37) }
        IfCondition EqualTo(cp, 0x2026) ThenBlock: { ReturnValue(38) }
        IfCondition EqualTo(cp, 0x00B7) ThenBlock: { ReturnValue(39) }
        IfCondition EqualTo(cp, 0x2714) ThenBlock: { ReturnValue(40) }
        IfCondition EqualTo(cp, 0x2718) ThenBlock: { ReturnValue(41) }
        // Claude Code / TUI glyphs
        IfCondition EqualTo(cp, 0x276F) ThenBlock: { ReturnValue(43) }
        IfCondition EqualTo(cp, 0x203A) ThenBlock: { ReturnValue(44) }
        IfCondition EqualTo(cp, 0x2192) ThenBlock: { ReturnValue(45) }
        IfCondition EqualTo(cp, 0x2193) ThenBlock: { ReturnValue(46) }
        // Braille spinner frames (Claude Code loading animation)
        IfCondition EqualTo(cp, 0x280B) ThenBlock: { ReturnValue(47) }
        IfCondition EqualTo(cp, 0x2819) ThenBlock: { ReturnValue(48) }
        IfCondition EqualTo(cp, 0x2839) ThenBlock: { ReturnValue(49) }
        IfCondition EqualTo(cp, 0x2838) ThenBlock: { ReturnValue(50) }
        IfCondition EqualTo(cp, 0x283C) ThenBlock: { ReturnValue(51) }
        IfCondition EqualTo(cp, 0x2834) ThenBlock: { ReturnValue(52) }
        IfCondition EqualTo(cp, 0x2826) ThenBlock: { ReturnValue(53) }
        IfCondition EqualTo(cp, 0x2827) ThenBlock: { ReturnValue(54) }
        IfCondition EqualTo(cp, 0x2807) ThenBlock: { ReturnValue(55) }
        IfCondition EqualTo(cp, 0x280F) ThenBlock: { ReturnValue(56) }
        ReturnValue(Subtract(0, 1))
    }
}

// =============================================================================
// DRAW CHAR WITH FG+BG — render one 8x16 glyph into a BGRA pixel buffer
// buf    = pixel buffer base address
// stride = buffer width in pixels (for row offset)
// x, y   = top-left pixel position
// ch     = Unicode codepoint (ASCII 32-126, or extended glyphs)
// =============================================================================
Function.TermFont_DrawCharFgBg {
    Input: buf:    Address
    Input: stride: Integer
    Input: x:      Integer
    Input: y:      Integer
    Input: ch:     Integer
    Body: {
        fd = TermFontState.font_data
        IfCondition EqualTo(fd, 0) ThenBlock: { ReturnValue(0) }

        fg = TermFontState.fg_color
        bg = TermFontState.bg_color

        // Check for extended glyph first
        IfCondition GreaterThan(ch, 126) ThenBlock: {
            ext_idx = TermFont_ExtLookup(ch)
            IfCondition GreaterEqual(ext_idx, 0) ThenBlock: {
                fd = Add(TermFontState.ext_data, Multiply(ext_idx, 16))
                glyph_off = 0
            } ElseBlock: {
                // Unknown glyph — render dotted rectangle placeholder
                fd = Add(TermFontState.ext_data, Multiply(TermFontExt.FALLBACK_IDX, 16))
                glyph_off = 0
            }
        } ElseBlock: {
            // ASCII range
            IfCondition LessThan(ch, 32) ThenBlock: { ch = 32 }
            glyph_off = Multiply(Subtract(ch, 32), 16)
        }

        row = 0
        WhileLoop LessThan(row, 16) {
            byt = GetByte(fd, Add(glyph_off, row))
            py = Add(y, row)
            row_base = Multiply(Multiply(py, stride), 4)

            // Unrolled 8 pixels per row for speed
            // Bit 7 (MSB) = leftmost pixel
            px0 = Multiply(Add(x, 0), 4)
            IfCondition NotEqual(BitwiseAnd(byt, 128), 0) ThenBlock: {
                StoreValue(Add(buf, Add(row_base, px0)), fg, "dword")
            } ElseBlock: {
                StoreValue(Add(buf, Add(row_base, px0)), bg, "dword")
            }

            px1 = Multiply(Add(x, 1), 4)
            IfCondition NotEqual(BitwiseAnd(byt, 64), 0) ThenBlock: {
                StoreValue(Add(buf, Add(row_base, px1)), fg, "dword")
            } ElseBlock: {
                StoreValue(Add(buf, Add(row_base, px1)), bg, "dword")
            }

            px2 = Multiply(Add(x, 2), 4)
            IfCondition NotEqual(BitwiseAnd(byt, 32), 0) ThenBlock: {
                StoreValue(Add(buf, Add(row_base, px2)), fg, "dword")
            } ElseBlock: {
                StoreValue(Add(buf, Add(row_base, px2)), bg, "dword")
            }

            px3 = Multiply(Add(x, 3), 4)
            IfCondition NotEqual(BitwiseAnd(byt, 16), 0) ThenBlock: {
                StoreValue(Add(buf, Add(row_base, px3)), fg, "dword")
            } ElseBlock: {
                StoreValue(Add(buf, Add(row_base, px3)), bg, "dword")
            }

            px4 = Multiply(Add(x, 4), 4)
            IfCondition NotEqual(BitwiseAnd(byt, 8), 0) ThenBlock: {
                StoreValue(Add(buf, Add(row_base, px4)), fg, "dword")
            } ElseBlock: {
                StoreValue(Add(buf, Add(row_base, px4)), bg, "dword")
            }

            px5 = Multiply(Add(x, 5), 4)
            IfCondition NotEqual(BitwiseAnd(byt, 4), 0) ThenBlock: {
                StoreValue(Add(buf, Add(row_base, px5)), fg, "dword")
            } ElseBlock: {
                StoreValue(Add(buf, Add(row_base, px5)), bg, "dword")
            }

            px6 = Multiply(Add(x, 6), 4)
            IfCondition NotEqual(BitwiseAnd(byt, 2), 0) ThenBlock: {
                StoreValue(Add(buf, Add(row_base, px6)), fg, "dword")
            } ElseBlock: {
                StoreValue(Add(buf, Add(row_base, px6)), bg, "dword")
            }

            px7 = Multiply(Add(x, 7), 4)
            IfCondition NotEqual(BitwiseAnd(byt, 1), 0) ThenBlock: {
                StoreValue(Add(buf, Add(row_base, px7)), fg, "dword")
            } ElseBlock: {
                StoreValue(Add(buf, Add(row_base, px7)), bg, "dword")
            }

            row = Add(row, 1)
        }
    }
}

// =============================================================================
// DRAW CHAR FOREGROUND ONLY — transparent background (no bg pixels written)
// =============================================================================
Function.TermFont_DrawCharFgOnly {
    Input: buf:    Address
    Input: stride: Integer
    Input: x:      Integer
    Input: y:      Integer
    Input: ch:     Integer
    Body: {
        fd = TermFontState.font_data
        IfCondition EqualTo(fd, 0) ThenBlock: { ReturnValue(0) }

        fg = TermFontState.fg_color

        // Check for extended glyph first
        IfCondition GreaterThan(ch, 126) ThenBlock: {
            ext_idx = TermFont_ExtLookup(ch)
            IfCondition GreaterEqual(ext_idx, 0) ThenBlock: {
                fd = Add(TermFontState.ext_data, Multiply(ext_idx, 16))
                glyph_off = 0
            } ElseBlock: {
                fd = Add(TermFontState.ext_data, Multiply(TermFontExt.FALLBACK_IDX, 16))
                glyph_off = 0
            }
        } ElseBlock: {
            IfCondition LessThan(ch, 32) ThenBlock: { ch = 32 }
            glyph_off = Multiply(Subtract(ch, 32), 16)
        }

        row = 0
        WhileLoop LessThan(row, 16) {
            byt = GetByte(fd, Add(glyph_off, row))
            py = Add(y, row)
            row_base = Multiply(Multiply(py, stride), 4)

            IfCondition NotEqual(BitwiseAnd(byt, 128), 0) ThenBlock: {
                StoreValue(Add(buf, Add(row_base, Multiply(Add(x, 0), 4))), fg, "dword")
            }
            IfCondition NotEqual(BitwiseAnd(byt, 64), 0) ThenBlock: {
                StoreValue(Add(buf, Add(row_base, Multiply(Add(x, 1), 4))), fg, "dword")
            }
            IfCondition NotEqual(BitwiseAnd(byt, 32), 0) ThenBlock: {
                StoreValue(Add(buf, Add(row_base, Multiply(Add(x, 2), 4))), fg, "dword")
            }
            IfCondition NotEqual(BitwiseAnd(byt, 16), 0) ThenBlock: {
                StoreValue(Add(buf, Add(row_base, Multiply(Add(x, 3), 4))), fg, "dword")
            }
            IfCondition NotEqual(BitwiseAnd(byt, 8), 0) ThenBlock: {
                StoreValue(Add(buf, Add(row_base, Multiply(Add(x, 4), 4))), fg, "dword")
            }
            IfCondition NotEqual(BitwiseAnd(byt, 4), 0) ThenBlock: {
                StoreValue(Add(buf, Add(row_base, Multiply(Add(x, 5), 4))), fg, "dword")
            }
            IfCondition NotEqual(BitwiseAnd(byt, 2), 0) ThenBlock: {
                StoreValue(Add(buf, Add(row_base, Multiply(Add(x, 6), 4))), fg, "dword")
            }
            IfCondition NotEqual(BitwiseAnd(byt, 1), 0) ThenBlock: {
                StoreValue(Add(buf, Add(row_base, Multiply(Add(x, 7), 4))), fg, "dword")
            }

            row = Add(row, 1)
        }
    }
}

// =============================================================================
// FONT DATA INIT — VGA ROM 8x16 bitmap, ASCII 32-126
// Split across blocks to stay under variable limits.
// Each glyph = 16 bytes, offset = (ascii - 32) * 16
// =============================================================================

// Block 0: chars 32-55 (space through 7) — 24 glyphs, 384 bytes
Function.TermFont_InitBlock0 {
    Input: d: Address
    Body: {
        // Char 32 (space)
        SetByte(d,0,0x00) SetByte(d,1,0x00) SetByte(d,2,0x00) SetByte(d,3,0x00)
        SetByte(d,4,0x00) SetByte(d,5,0x00) SetByte(d,6,0x00) SetByte(d,7,0x00)
        SetByte(d,8,0x00) SetByte(d,9,0x00) SetByte(d,10,0x00) SetByte(d,11,0x00)
        SetByte(d,12,0x00) SetByte(d,13,0x00) SetByte(d,14,0x00) SetByte(d,15,0x00)
        // Char 33 (!)
        SetByte(d,16,0x00) SetByte(d,17,0x00) SetByte(d,18,0x18) SetByte(d,19,0x3c)
        SetByte(d,20,0x3c) SetByte(d,21,0x3c) SetByte(d,22,0x18) SetByte(d,23,0x18)
        SetByte(d,24,0x18) SetByte(d,25,0x00) SetByte(d,26,0x18) SetByte(d,27,0x18)
        SetByte(d,28,0x00) SetByte(d,29,0x00) SetByte(d,30,0x00) SetByte(d,31,0x00)
        // Char 34 (")
        SetByte(d,32,0x00) SetByte(d,33,0x66) SetByte(d,34,0x66) SetByte(d,35,0x66)
        SetByte(d,36,0x24) SetByte(d,37,0x00) SetByte(d,38,0x00) SetByte(d,39,0x00)
        SetByte(d,40,0x00) SetByte(d,41,0x00) SetByte(d,42,0x00) SetByte(d,43,0x00)
        SetByte(d,44,0x00) SetByte(d,45,0x00) SetByte(d,46,0x00) SetByte(d,47,0x00)
        // Char 35 (#)
        SetByte(d,48,0x00) SetByte(d,49,0x00) SetByte(d,50,0x00) SetByte(d,51,0x6c)
        SetByte(d,52,0x6c) SetByte(d,53,0xfe) SetByte(d,54,0x6c) SetByte(d,55,0x6c)
        SetByte(d,56,0x6c) SetByte(d,57,0xfe) SetByte(d,58,0x6c) SetByte(d,59,0x6c)
        SetByte(d,60,0x00) SetByte(d,61,0x00) SetByte(d,62,0x00) SetByte(d,63,0x00)
        // Char 36 ($)
        SetByte(d,64,0x18) SetByte(d,65,0x18) SetByte(d,66,0x7c) SetByte(d,67,0xc6)
        SetByte(d,68,0xc2) SetByte(d,69,0xc0) SetByte(d,70,0x7c) SetByte(d,71,0x06)
        SetByte(d,72,0x06) SetByte(d,73,0x86) SetByte(d,74,0xc6) SetByte(d,75,0x7c)
        SetByte(d,76,0x18) SetByte(d,77,0x18) SetByte(d,78,0x00) SetByte(d,79,0x00)
        // Char 37 (%)
        SetByte(d,80,0x00) SetByte(d,81,0x00) SetByte(d,82,0x00) SetByte(d,83,0x00)
        SetByte(d,84,0xc2) SetByte(d,85,0xc6) SetByte(d,86,0x0c) SetByte(d,87,0x18)
        SetByte(d,88,0x30) SetByte(d,89,0x60) SetByte(d,90,0xc6) SetByte(d,91,0x86)
        SetByte(d,92,0x00) SetByte(d,93,0x00) SetByte(d,94,0x00) SetByte(d,95,0x00)
        // Char 38 (&)
        SetByte(d,96,0x00) SetByte(d,97,0x00) SetByte(d,98,0x38) SetByte(d,99,0x6c)
        SetByte(d,100,0x6c) SetByte(d,101,0x38) SetByte(d,102,0x76) SetByte(d,103,0xdc)
        SetByte(d,104,0xcc) SetByte(d,105,0xcc) SetByte(d,106,0xcc) SetByte(d,107,0x76)
        SetByte(d,108,0x00) SetByte(d,109,0x00) SetByte(d,110,0x00) SetByte(d,111,0x00)
        // Char 39 (')
        SetByte(d,112,0x00) SetByte(d,113,0x30) SetByte(d,114,0x30) SetByte(d,115,0x30)
        SetByte(d,116,0x60) SetByte(d,117,0x00) SetByte(d,118,0x00) SetByte(d,119,0x00)
        SetByte(d,120,0x00) SetByte(d,121,0x00) SetByte(d,122,0x00) SetByte(d,123,0x00)
        SetByte(d,124,0x00) SetByte(d,125,0x00) SetByte(d,126,0x00) SetByte(d,127,0x00)
        // Char 40 (()
        SetByte(d,128,0x00) SetByte(d,129,0x00) SetByte(d,130,0x0c) SetByte(d,131,0x18)
        SetByte(d,132,0x30) SetByte(d,133,0x30) SetByte(d,134,0x30) SetByte(d,135,0x30)
        SetByte(d,136,0x30) SetByte(d,137,0x30) SetByte(d,138,0x18) SetByte(d,139,0x0c)
        SetByte(d,140,0x00) SetByte(d,141,0x00) SetByte(d,142,0x00) SetByte(d,143,0x00)
        // Char 41 ())
        SetByte(d,144,0x00) SetByte(d,145,0x00) SetByte(d,146,0x30) SetByte(d,147,0x18)
        SetByte(d,148,0x0c) SetByte(d,149,0x0c) SetByte(d,150,0x0c) SetByte(d,151,0x0c)
        SetByte(d,152,0x0c) SetByte(d,153,0x0c) SetByte(d,154,0x18) SetByte(d,155,0x30)
        SetByte(d,156,0x00) SetByte(d,157,0x00) SetByte(d,158,0x00) SetByte(d,159,0x00)
        // Char 42 (*)
        SetByte(d,160,0x00) SetByte(d,161,0x00) SetByte(d,162,0x00) SetByte(d,163,0x00)
        SetByte(d,164,0x00) SetByte(d,165,0x66) SetByte(d,166,0x3c) SetByte(d,167,0xff)
        SetByte(d,168,0x3c) SetByte(d,169,0x66) SetByte(d,170,0x00) SetByte(d,171,0x00)
        SetByte(d,172,0x00) SetByte(d,173,0x00) SetByte(d,174,0x00) SetByte(d,175,0x00)
        // Char 43 (+)
        SetByte(d,176,0x00) SetByte(d,177,0x00) SetByte(d,178,0x00) SetByte(d,179,0x00)
        SetByte(d,180,0x00) SetByte(d,181,0x18) SetByte(d,182,0x18) SetByte(d,183,0x7e)
        SetByte(d,184,0x18) SetByte(d,185,0x18) SetByte(d,186,0x00) SetByte(d,187,0x00)
        SetByte(d,188,0x00) SetByte(d,189,0x00) SetByte(d,190,0x00) SetByte(d,191,0x00)
        // Char 44 (,)
        SetByte(d,192,0x00) SetByte(d,193,0x00) SetByte(d,194,0x00) SetByte(d,195,0x00)
        SetByte(d,196,0x00) SetByte(d,197,0x00) SetByte(d,198,0x00) SetByte(d,199,0x00)
        SetByte(d,200,0x00) SetByte(d,201,0x18) SetByte(d,202,0x18) SetByte(d,203,0x18)
        SetByte(d,204,0x30) SetByte(d,205,0x00) SetByte(d,206,0x00) SetByte(d,207,0x00)
        // Char 45 (-)
        SetByte(d,208,0x00) SetByte(d,209,0x00) SetByte(d,210,0x00) SetByte(d,211,0x00)
        SetByte(d,212,0x00) SetByte(d,213,0x00) SetByte(d,214,0x00) SetByte(d,215,0xfe)
        SetByte(d,216,0x00) SetByte(d,217,0x00) SetByte(d,218,0x00) SetByte(d,219,0x00)
        SetByte(d,220,0x00) SetByte(d,221,0x00) SetByte(d,222,0x00) SetByte(d,223,0x00)
        // Char 46 (.)
        SetByte(d,224,0x00) SetByte(d,225,0x00) SetByte(d,226,0x00) SetByte(d,227,0x00)
        SetByte(d,228,0x00) SetByte(d,229,0x00) SetByte(d,230,0x00) SetByte(d,231,0x00)
        SetByte(d,232,0x00) SetByte(d,233,0x00) SetByte(d,234,0x18) SetByte(d,235,0x18)
        SetByte(d,236,0x00) SetByte(d,237,0x00) SetByte(d,238,0x00) SetByte(d,239,0x00)
        // Char 47 (/)
        SetByte(d,240,0x00) SetByte(d,241,0x00) SetByte(d,242,0x00) SetByte(d,243,0x00)
        SetByte(d,244,0x02) SetByte(d,245,0x06) SetByte(d,246,0x0c) SetByte(d,247,0x18)
        SetByte(d,248,0x30) SetByte(d,249,0x60) SetByte(d,250,0xc0) SetByte(d,251,0x80)
        SetByte(d,252,0x00) SetByte(d,253,0x00) SetByte(d,254,0x00) SetByte(d,255,0x00)
        // Char 48 (0)
        SetByte(d,256,0x00) SetByte(d,257,0x00) SetByte(d,258,0x3c) SetByte(d,259,0x66)
        SetByte(d,260,0xc3) SetByte(d,261,0xc3) SetByte(d,262,0xdb) SetByte(d,263,0xdb)
        SetByte(d,264,0xc3) SetByte(d,265,0xc3) SetByte(d,266,0x66) SetByte(d,267,0x3c)
        SetByte(d,268,0x00) SetByte(d,269,0x00) SetByte(d,270,0x00) SetByte(d,271,0x00)
        // Char 49 (1)
        SetByte(d,272,0x00) SetByte(d,273,0x00) SetByte(d,274,0x18) SetByte(d,275,0x38)
