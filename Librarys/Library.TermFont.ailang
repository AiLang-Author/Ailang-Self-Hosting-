        SetByte(d,100,0x18) SetByte(d,101,0x18) SetByte(d,102,0x18) SetByte(d,103,0x1F)
        SetByte(d,104,0x1F) SetByte(d,105,0x18) SetByte(d,106,0x18) SetByte(d,107,0x18)
        SetByte(d,108,0x18) SetByte(d,109,0x18) SetByte(d,110,0x18) SetByte(d,111,0x18)
