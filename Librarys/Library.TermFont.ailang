// Index layout: 0-10=single box, 11-14=rounded, 15-25=double, 26-33=blocks, 34-41=symbols
// =============================================================================

// ExtBlock0: indices 0-10 — single-line box drawing (11 glyphs, 176 bytes)
Function.TermFont_InitExt0 {
    Input: d: Address
    Body: {
        // idx 0: U+2500 ─ (horizontal line)
        SetByte(d,0,0x00) SetByte(d,1,0x00) SetByte(d,2,0x00) SetByte(d,3,0x00)
        SetByte(d,4,0x00) SetByte(d,5,0x00) SetByte(d,6,0x00) SetByte(d,7,0xFF)
