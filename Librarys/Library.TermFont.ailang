        SetByte(d,36,0x00) SetByte(d,37,0x00) SetByte(d,38,0x00) SetByte(d,39,0x1F)
        SetByte(d,40,0x1F) SetByte(d,41,0x18) SetByte(d,42,0x18) SetByte(d,43,0x18)
        SetByte(d,44,0x18) SetByte(d,45,0x18) SetByte(d,46,0x18) SetByte(d,47,0x18)
        // idx 3: U+2510 ┐ (top-right corner)
        SetByte(d,48,0x00) SetByte(d,49,0x00) SetByte(d,50,0x00) SetByte(d,51,0x00)
        SetByte(d,52,0x00) SetByte(d,53,0x00) SetByte(d,54,0x00) SetByte(d,55,0xF8)
        SetByte(d,56,0xF8) SetByte(d,57,0x18) SetByte(d,58,0x18) SetByte(d,59,0x18)
