        WRMEM_8(d, 828, 0x0C) WRMEM_8(d, 829, 0x0C) WRMEM_8(d, 830, 0x00) WRMEM_8(d, 831, 0x00)
        // idx 52: U+2834 ⠴ (braille dots 3,5,6)
        WRMEM_8(d, 832, 0x00) WRMEM_8(d, 833, 0x00) WRMEM_8(d, 834, 0x00) WRMEM_8(d, 835, 0x00)
        WRMEM_8(d, 836, 0xC0) WRMEM_8(d, 837, 0x00) WRMEM_8(d, 838, 0x00) WRMEM_8(d, 839, 0x00)
        WRMEM_8(d, 840, 0x00) WRMEM_8(d, 841, 0x00) WRMEM_8(d, 842, 0x00) WRMEM_8(d, 843, 0x00)
        WRMEM_8(d, 844, 0x0C) WRMEM_8(d, 845, 0x0C) WRMEM_8(d, 846, 0x00) WRMEM_8(d, 847, 0x00)
        // idx 53: U+2826 ⠦ (braille dots 2,3,6)
        WRMEM_8(d, 848, 0x00) WRMEM_8(d, 849, 0x00) WRMEM_8(d, 850, 0x00) WRMEM_8(d, 851, 0xC0)
        WRMEM_8(d, 852, 0xC0) WRMEM_8(d, 853, 0x00) WRMEM_8(d, 854, 0x00) WRMEM_8(d, 855, 0x00)
        WRMEM_8(d, 856, 0x00) WRMEM_8(d, 857, 0x00) WRMEM_8(d, 858, 0x00) WRMEM_8(d, 859, 0x00)
        WRMEM_8(d, 860, 0x00) WRMEM_8(d, 861, 0x0C) WRMEM_8(d, 862, 0x00) WRMEM_8(d, 863, 0x00)
        // idx 54: U+2827 ⠧ (braille dots 1,2,3,6)
        WRMEM_8(d, 864, 0x00) WRMEM_8(d, 865, 0xC0) WRMEM_8(d, 866, 0x00) WRMEM_8(d, 867, 0xC0)
        WRMEM_8(d, 868, 0xC0) WRMEM_8(d, 869, 0x00) WRMEM_8(d, 870, 0x00) WRMEM_8(d, 871, 0x00)
        WRMEM_8(d, 872, 0x00) WRMEM_8(d, 873, 0x00) WRMEM_8(d, 874, 0x00) WRMEM_8(d, 875, 0x00)
        WRMEM_8(d, 876, 0x00) WRMEM_8(d, 877, 0x0C) WRMEM_8(d, 878, 0x00) WRMEM_8(d, 879, 0x00)
        // idx 55: U+2807 ⠇ (braille dots 1,2,3)
        WRMEM_8(d, 880, 0x00) WRMEM_8(d, 881, 0xC0) WRMEM_8(d, 882, 0x00) WRMEM_8(d, 883, 0xC0)
        WRMEM_8(d, 884, 0xC0) WRMEM_8(d, 885, 0x00) WRMEM_8(d, 886, 0x00) WRMEM_8(d, 887, 0x00)
        WRMEM_8(d, 888, 0x00) WRMEM_8(d, 889, 0x00) WRMEM_8(d, 890, 0x00) WRMEM_8(d, 891, 0x00)
        WRMEM_8(d, 892, 0x00) WRMEM_8(d, 893, 0x00) WRMEM_8(d, 894, 0x00) WRMEM_8(d, 895, 0x00)
        // idx 56: U+280F ⠏ (braille dots 1,2,3,4)
        WRMEM_8(d, 896, 0x00) WRMEM_8(d, 897, 0xC0) WRMEM_8(d, 898, 0x00) WRMEM_8(d, 899, 0xC0)
        WRMEM_8(d, 900, 0xC0) WRMEM_8(d, 901, 0x00) WRMEM_8(d, 902, 0x00) WRMEM_8(d, 903, 0x00)
        WRMEM_8(d, 904, 0x00) WRMEM_8(d, 905, 0xC0) WRMEM_8(d, 906, 0x00) WRMEM_8(d, 907, 0x00)
        WRMEM_8(d, 908, 0x00) WRMEM_8(d, 909, 0x00) WRMEM_8(d, 910, 0x00) WRMEM_8(d, 911, 0x00)
    }
}

// =============================================================================
// INIT — allocate font table and fill all blocks
// =============================================================================
Function.TermFont_Init {
    Body: {
        d = Allocate(1520)
        MemorySet(d, 0, 1520)
        TermFontState.font_data = d

        TermFont_InitBlock0(d)
        TermFont_InitBlock1(d)
        TermFont_InitBlock2(d)
        TermFont_InitBlock3(d)

        // Extended glyphs: box-drawing, blocks, symbols, Claude Code glyphs, fallback
        ext = Allocate(912)
        MemorySet(ext, 0, 912)
        TermFontState.ext_data = ext

        TermFont_InitExt0(ext)
        TermFont_InitExt1(ext)
        TermFont_InitExt2(ext)
        TermFont_InitExt3(ext)
        TermFont_InitExt4(ext)

        TermFontState.loaded = 1
        PrintMessage("[TermFont] Loaded VGA 8x16 bitmap font (95+56 glyphs)\n")
    }
}
