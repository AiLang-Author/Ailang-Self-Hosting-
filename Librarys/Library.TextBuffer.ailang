//
// Library.TextBuffer.ailang
// Fixed-grid character buffer — data + render engine.
// One instance per text pane. Renders into a PIXEL_32 surface.
//
// Design: orthogonal to layout. This owns the character grid and
// knows how to render it. It does NOT own positioning within a pane —
// that belongs to the Widget layer above.
//
// Grid model:
//   cols = surface_w / char_w
//   rows = surface_h / char_h
//   cell(col, row) = buf[row * cols + col]  — one byte, ASCII
//   attr(col, row) = attr[row * cols + col] — fg/bg packed byte
//
// Cursor is a grid position (cur_col, cur_row).
// Scroll offset is in rows (scroll_row).

LibraryImport.DSurfaceTypes
LibraryImport.DSurface
LibraryImport.DDrawPixel
LibraryImport.Font
LibraryImport.FontBitmap

// =============================================================================
// TEXTBUFFER HANDLE TABLE
// Max 16 buffers — matches WinTable capacity
// =============================================================================
FixedPool.TBConst {
    "MAX":         Initialize=16
    "RECORD_SIZE": Initialize=128   // bytes per handle record
}

FixedPool.TBTable {
    "data":        Initialize=0
    "count":       Initialize=0
    "initialized": Initialize=0
}

// Record field offsets within each 128-byte slot
FixedPool.TBField {
    "SURF":       Initialize=0    // surface handle
    "FONT":       Initialize=8    // font handle
    "BUF":        Initialize=16   // char buffer ptr
    "ATTR":       Initialize=24   // attr buffer ptr
    "COLS":       Initialize=32   // grid width in chars
    "ROWS":       Initialize=40   // grid height in chars
    "CHAR_W":     Initialize=48   // char width in pixels
    "CHAR_H":     Initialize=56   // char height in pixels
    "CUR_COL":    Initialize=64   // cursor column
    "CUR_ROW":    Initialize=72   // cursor row
    "SCROLL_ROW": Initialize=80   // scroll offset in rows
    "DIRTY":      Initialize=88   // 1 = needs render
    "FG":         Initialize=96   // current fg color (32-bit)
    "BG":         Initialize=104  // current bg color (32-bit)
    "ACTIVE":     Initialize=112  // 1 = slot in use
}

// =============================================================================
// INIT TABLE
// =============================================================================
Function.TextBuffer_InitTable {
    Output: Integer
    Body: {
        IfCondition EqualTo(TBTable.initialized, 1) ThenBlock: {
            ReturnValue(1)
        }
        size = Multiply(TBConst.MAX, TBConst.RECORD_SIZE)
        TBTable.data = Allocate(size)
        i = 0
        WhileLoop LessThan(i, size) {
            SetByte(TBTable.data, i, 0)
            i = Add(i, 1)
        }
        TBTable.count       = 0
        TBTable.initialized = 1
        ReturnValue(1)
    }
}

// =============================================================================
// INTERNAL: get record pointer for handle
// =============================================================================
Function.TB_RecordPtr {
    Input:  handle: Integer
    Output: Integer
    Body: {
        ReturnValue(Add(TBTable.data, Multiply(handle, TBConst.RECORD_SIZE)))
    }
}

Function.TB_Get {
    Input:  handle: Integer
    Input:  field:  Integer
    Output: Integer
    Body: {
        rec = TB_RecordPtr(handle)
        ReturnValue(Dereference(Add(rec, field)))
    }
}

Function.TB_Set {
    Input: handle: Integer
    Input: field:  Integer
    Input: val:    Integer
    Body: {
        rec = TB_RecordPtr(handle)
        StoreValue(Add(rec, field), val)
        ReturnValue(0)
    }
}

// =============================================================================
// CREATE
// Allocates a text buffer sized to fill the given surface using the font.
// Returns handle (0..15) or -1 on failure.
// =============================================================================
Function.TextBuffer_Create {
    Input:  surf:   Integer
    Input:  font:   Integer
    Output: Integer
    Body: {
        TextBuffer_InitTable()

        // Find free slot
        handle = -1
        i = 0
        WhileLoop LessThan(i, TBConst.MAX) {
            active = TB_Get(i, TBField.ACTIVE)
            IfCondition EqualTo(active, 0) ThenBlock: {
                handle = i
                i = TBConst.MAX
            } ElseBlock: {
                i = Add(i, 1)
            }
        }
        IfCondition LessThan(handle, 0) ThenBlock: {
            PrintMessage("[TB] ERROR: table full\n")
            ReturnValue(-1)
        }

        // Get surface dimensions
        sw = Surface_GetWidth(surf)
        sh = Surface_GetHeight(surf)

        // Get font dimensions
        char_w = Font_GetWidth(font)
        char_h = Font_GetHeight(font)
        IfCondition EqualTo(char_w, 0) ThenBlock: { char_w = 8  }
        IfCondition EqualTo(char_h, 0) ThenBlock: { char_h = 8  }

        cols = Divide(sw, char_w)
        rows = Divide(sh, char_h)

        IfCondition EqualTo(cols, 0) ThenBlock: {
            PrintMessage("[TB] ERROR: surface too small for font\n")
            ReturnValue(-1)
        }
        IfCondition EqualTo(rows, 0) ThenBlock: {
            PrintMessage("[TB] ERROR: surface too small for font\n")
            ReturnValue(-1)
        }

        // Allocate char and attr buffers
        buf_size = Multiply(cols, rows)
        char_buf = Allocate(buf_size)
        attr_buf = Allocate(buf_size)

        // Fill with spaces / default attr
        j = 0
        WhileLoop LessThan(j, buf_size) {
            SetByte(char_buf, j, 32)   // space
            SetByte(attr_buf, j, 0)
            j = Add(j, 1)
        }

        // Store record
        TB_Set(handle, TBField.SURF,       surf)
        TB_Set(handle, TBField.FONT,       font)
        TB_Set(handle, TBField.BUF,        char_buf)
        TB_Set(handle, TBField.ATTR,       attr_buf)
        TB_Set(handle, TBField.COLS,       cols)
        TB_Set(handle, TBField.ROWS,       rows)
        TB_Set(handle, TBField.CHAR_W,     char_w)
        TB_Set(handle, TBField.CHAR_H,     char_h)
        TB_Set(handle, TBField.CUR_COL,    0)
        TB_Set(handle, TBField.CUR_ROW,    0)
        TB_Set(handle, TBField.SCROLL_ROW, 0)
        TB_Set(handle, TBField.DIRTY,      1)
        TB_Set(handle, TBField.FG,         0xFFFFFF)
        TB_Set(handle, TBField.BG,         0x000000)
        TB_Set(handle, TBField.ACTIVE,     1)

        TBTable.count = Add(TBTable.count, 1)

        PrintMessage("[TB] created handle=")
        PrintNumber(handle)
        PrintMessage(" ")
        PrintNumber(cols)
        PrintMessage("x")
        PrintNumber(rows)
        PrintMessage(" chars\n")

        ReturnValue(handle)
    }
}

// =============================================================================
// DESTROY
// =============================================================================
Function.TextBuffer_Destroy {
    Input:  handle: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(handle, 0) ThenBlock: { ReturnValue(0) }

        char_buf = TB_Get(handle, TBField.BUF)
        attr_buf = TB_Get(handle, TBField.ATTR)
        cols     = TB_Get(handle, TBField.COLS)
        rows     = TB_Get(handle, TBField.ROWS)
        buf_size = Multiply(cols, rows)

        IfCondition NotEqual(char_buf, 0) ThenBlock: { Deallocate(char_buf, buf_size) }
        IfCondition NotEqual(attr_buf, 0) ThenBlock: { Deallocate(attr_buf, buf_size) }

        // Zero the record
        rec = TB_RecordPtr(handle)
        i = 0
        WhileLoop LessThan(i, TBConst.RECORD_SIZE) {
            SetByte(rec, i, 0)
            i = Add(i, 1)
        }

        TBTable.count = Subtract(TBTable.count, 1)
        ReturnValue(1)
    }
}

// =============================================================================
// CLEAR — fill grid with spaces
// =============================================================================
Function.TextBuffer_Clear {
    Input:  handle: Integer
    Output: Integer
    Body: {
        char_buf = TB_Get(handle, TBField.BUF)
        cols     = TB_Get(handle, TBField.COLS)
        rows     = TB_Get(handle, TBField.ROWS)
        size     = Multiply(cols, rows)
        i = 0
        WhileLoop LessThan(i, size) {
            SetByte(char_buf, i, 32)
            i = Add(i, 1)
        }
        TB_Set(handle, TBField.CUR_COL,    0)
        TB_Set(handle, TBField.CUR_ROW,    0)
        TB_Set(handle, TBField.SCROLL_ROW, 0)
        TB_Set(handle, TBField.DIRTY,      1)
        ReturnValue(1)
    }
}

// =============================================================================
// PUT CHAR at cursor position, advance cursor
// Handles newline and wrapping
// =============================================================================
Function.TextBuffer_PutChar {
    Input:  handle: Integer
    Input:  ch:     Integer
    Output: Integer
    Body: {
        cols = TB_Get(handle, TBField.COLS)
        rows = TB_Get(handle, TBField.ROWS)
        col  = TB_Get(handle, TBField.CUR_COL)
        row  = TB_Get(handle, TBField.CUR_ROW)
        buf  = TB_Get(handle, TBField.BUF)

        // Newline
        IfCondition EqualTo(ch, 10) ThenBlock: {
            TB_Set(handle, TBField.CUR_COL, 0)
            row = Add(row, 1)
            IfCondition GreaterEqual(row, rows) ThenBlock: {
                TextBuffer_ScrollUp(handle)
                row = Subtract(rows, 1)
            }
            TB_Set(handle, TBField.CUR_ROW, row)
            TB_Set(handle, TBField.DIRTY,   1)
            ReturnValue(1)
        }

        // Backspace
        IfCondition EqualTo(ch, 8) ThenBlock: {
            IfCondition GreaterThan(col, 0) ThenBlock: {
                col = Subtract(col, 1)
                TB_Set(handle, TBField.CUR_COL, col)
                off = Add(Multiply(row, cols), col)
                SetByte(buf, off, 32)
                TB_Set(handle, TBField.DIRTY, 1)
            }
            ReturnValue(1)
        }

        // Printable char
        IfCondition And(GreaterEqual(ch, 32), LessThan(ch, 127)) ThenBlock: {
            off = Add(Multiply(row, cols), col)
            SetByte(buf, off, ch)
            col = Add(col, 1)
            IfCondition GreaterEqual(col, cols) ThenBlock: {
                col = 0
                row = Add(row, 1)
                IfCondition GreaterEqual(row, rows) ThenBlock: {
                    TextBuffer_ScrollUp(handle)
                    row = Subtract(rows, 1)
                }
                TB_Set(handle, TBField.CUR_ROW, row)
            }
            TB_Set(handle, TBField.CUR_COL, col)
            TB_Set(handle, TBField.DIRTY,   1)
        }

        ReturnValue(1)
    }
}

// =============================================================================
// PUT STRING — convenience wrapper
// =============================================================================
Function.TextBuffer_PutString {
    Input:  handle: Integer
    Input:  str:    Address
    Output: Integer
    Body: {
        i  = 0
        ch = GetByte(str, i)
        WhileLoop NotEqual(ch, 0) {
            TextBuffer_PutChar(handle, ch)
            i  = Add(i, 1)
            ch = GetByte(str, i)
        }
        ReturnValue(1)
    }
}

// =============================================================================
// SCROLL UP — move all rows up by 1, clear bottom row
// =============================================================================
Function.TextBuffer_ScrollUp {
    Input:  handle: Integer
    Output: Integer
    Body: {
        buf  = TB_Get(handle, TBField.BUF)
        cols = TB_Get(handle, TBField.COLS)
        rows = TB_Get(handle, TBField.ROWS)

        // Copy row n+1 to row n
        row = 0
        WhileLoop LessThan(row, Subtract(rows, 1)) {
            src = Add(buf, Multiply(Add(row, 1), cols))
            dst = Add(buf, Multiply(row, cols))
            col = 0
            WhileLoop LessThan(col, cols) {
                SetByte(dst, col, GetByte(src, col))
                col = Add(col, 1)
            }
            row = Add(row, 1)
        }

        // Clear last row
        last = Add(buf, Multiply(Subtract(rows, 1), cols))
        col = 0
        WhileLoop LessThan(col, cols) {
            SetByte(last, col, 32)
            col = Add(col, 1)
        }

        TB_Set(handle, TBField.DIRTY, 1)
        ReturnValue(1)
    }
}

// =============================================================================
// KEY DOWN — translate evdev scancode to char and call PutChar
// Only handles printable ASCII + backspace + enter for now
// =============================================================================
Function.TextBuffer_KeyDown {
    Input:  handle:  Integer
    Input:  keycode: Integer
    Input:  shift:   Integer
    Output: Integer
    Body: {
        ch = TextBuffer_KeyToChar(keycode, shift)
        IfCondition NotEqual(ch, 0) ThenBlock: {
            TextBuffer_PutChar(handle, ch)
            ReturnValue(1)
        }
        ReturnValue(0)
    }
}

// =============================================================================
// SCANCODE TO ASCII
// Evdev keycodes → ASCII. Handles shift for uppercase/symbols.
// =============================================================================
Function.TextBuffer_KeyToChar {
    Input:  keycode: Integer
    Input:  shift:   Integer
    Output: Integer
    Body: {
        // Enter
        IfCondition EqualTo(keycode, 28) ThenBlock: { ReturnValue(10) }
        // Backspace
        IfCondition EqualTo(keycode, 14) ThenBlock: { ReturnValue(8)  }
        // Space
        IfCondition EqualTo(keycode, 57) ThenBlock: { ReturnValue(32) }

        // Numbers row (no shift)
        IfCondition EqualTo(shift, 0) ThenBlock: {
            IfCondition EqualTo(keycode, 2)  ThenBlock: { ReturnValue(49) }  // 1
            IfCondition EqualTo(keycode, 3)  ThenBlock: { ReturnValue(50) }  // 2
            IfCondition EqualTo(keycode, 4)  ThenBlock: { ReturnValue(51) }  // 3
            IfCondition EqualTo(keycode, 5)  ThenBlock: { ReturnValue(52) }  // 4
            IfCondition EqualTo(keycode, 6)  ThenBlock: { ReturnValue(53) }  // 5
            IfCondition EqualTo(keycode, 7)  ThenBlock: { ReturnValue(54) }  // 6
            IfCondition EqualTo(keycode, 8)  ThenBlock: { ReturnValue(55) }  // 7
            IfCondition EqualTo(keycode, 9)  ThenBlock: { ReturnValue(56) }  // 8
            IfCondition EqualTo(keycode, 10) ThenBlock: { ReturnValue(57) }  // 9
            IfCondition EqualTo(keycode, 11) ThenBlock: { ReturnValue(48) }  // 0
            IfCondition EqualTo(keycode, 12) ThenBlock: { ReturnValue(45) }  // -
            IfCondition EqualTo(keycode, 13) ThenBlock: { ReturnValue(61) }  // =
        }

        // Numbers row (shift)
        IfCondition EqualTo(shift, 1) ThenBlock: {
            IfCondition EqualTo(keycode, 2)  ThenBlock: { ReturnValue(33) }  // !
            IfCondition EqualTo(keycode, 3)  ThenBlock: { ReturnValue(64) }  // @
            IfCondition EqualTo(keycode, 4)  ThenBlock: { ReturnValue(35) }  // #
            IfCondition EqualTo(keycode, 5)  ThenBlock: { ReturnValue(36) }  // $
            IfCondition EqualTo(keycode, 6)  ThenBlock: { ReturnValue(37) }  // %
            IfCondition EqualTo(keycode, 7)  ThenBlock: { ReturnValue(94) }  // ^
            IfCondition EqualTo(keycode, 8)  ThenBlock: { ReturnValue(38) }  // &
            IfCondition EqualTo(keycode, 9)  ThenBlock: { ReturnValue(42) }  // *
            IfCondition EqualTo(keycode, 10) ThenBlock: { ReturnValue(40) }  // (
            IfCondition EqualTo(keycode, 11) ThenBlock: { ReturnValue(41) }  // )
            IfCondition EqualTo(keycode, 12) ThenBlock: { ReturnValue(95) }  // _
            IfCondition EqualTo(keycode, 13) ThenBlock: { ReturnValue(43) }  // +
        }

        // Letters — Key.* constants are evdev scancodes
        // Base ASCII: a=97, shift A=65
        base = 0
        IfCondition EqualTo(shift, 0) ThenBlock: { base = 97  }
        IfCondition EqualTo(shift, 1) ThenBlock: { base = 65  }

        IfCondition EqualTo(keycode, Key.Q) ThenBlock: { ReturnValue(Add(base, 16)) }
        IfCondition EqualTo(keycode, Key.W) ThenBlock: { ReturnValue(Add(base, 22)) }
        IfCondition EqualTo(keycode, Key.E) ThenBlock: { ReturnValue(Add(base, 4))  }
        IfCondition EqualTo(keycode, Key.R) ThenBlock: { ReturnValue(Add(base, 17)) }
        IfCondition EqualTo(keycode, Key.T) ThenBlock: { ReturnValue(Add(base, 19)) }
        IfCondition EqualTo(keycode, Key.Y) ThenBlock: { ReturnValue(Add(base, 24)) }
        IfCondition EqualTo(keycode, Key.U) ThenBlock: { ReturnValue(Add(base, 20)) }
        IfCondition EqualTo(keycode, Key.I) ThenBlock: { ReturnValue(Add(base, 8))  }
        IfCondition EqualTo(keycode, Key.O) ThenBlock: { ReturnValue(Add(base, 14)) }
        IfCondition EqualTo(keycode, Key.P) ThenBlock: { ReturnValue(Add(base, 15)) }
        IfCondition EqualTo(keycode, Key.A) ThenBlock: { ReturnValue(Add(base, 0))  }
        IfCondition EqualTo(keycode, Key.S) ThenBlock: { ReturnValue(Add(base, 18)) }
        IfCondition EqualTo(keycode, Key.D) ThenBlock: { ReturnValue(Add(base, 3))  }
        IfCondition EqualTo(keycode, Key.F) ThenBlock: { ReturnValue(Add(base, 5))  }
        IfCondition EqualTo(keycode, Key.G) ThenBlock: { ReturnValue(Add(base, 6))  }
        IfCondition EqualTo(keycode, Key.H) ThenBlock: { ReturnValue(Add(base, 7))  }
        IfCondition EqualTo(keycode, Key.J) ThenBlock: { ReturnValue(Add(base, 9))  }
        IfCondition EqualTo(keycode, Key.K) ThenBlock: { ReturnValue(Add(base, 10)) }
        IfCondition EqualTo(keycode, Key.L) ThenBlock: { ReturnValue(Add(base, 11)) }
        IfCondition EqualTo(keycode, Key.Z) ThenBlock: { ReturnValue(Add(base, 25)) }
        IfCondition EqualTo(keycode, Key.X) ThenBlock: { ReturnValue(Add(base, 23)) }
        IfCondition EqualTo(keycode, Key.C) ThenBlock: { ReturnValue(Add(base, 2))  }
        IfCondition EqualTo(keycode, Key.V) ThenBlock: { ReturnValue(Add(base, 21)) }
        IfCondition EqualTo(keycode, Key.B) ThenBlock: { ReturnValue(Add(base, 1))  }
        IfCondition EqualTo(keycode, Key.N) ThenBlock: { ReturnValue(Add(base, 13)) }
        IfCondition EqualTo(keycode, Key.M) ThenBlock: { ReturnValue(Add(base, 12)) }

        // Punctuation (no shift)
        IfCondition EqualTo(shift, 0) ThenBlock: {
            IfCondition EqualTo(keycode, 26) ThenBlock: { ReturnValue(91)  }  // [
            IfCondition EqualTo(keycode, 27) ThenBlock: { ReturnValue(93)  }  // ]
            IfCondition EqualTo(keycode, 39) ThenBlock: { ReturnValue(59)  }  // ;
            IfCondition EqualTo(keycode, 40) ThenBlock: { ReturnValue(39)  }  // '
            IfCondition EqualTo(keycode, 41) ThenBlock: { ReturnValue(96)  }  // `
            IfCondition EqualTo(keycode, 43) ThenBlock: { ReturnValue(92)  }  // backslash
            IfCondition EqualTo(keycode, 51) ThenBlock: { ReturnValue(44)  }  // ,
            IfCondition EqualTo(keycode, 52) ThenBlock: { ReturnValue(46)  }  // .
            IfCondition EqualTo(keycode, 53) ThenBlock: { ReturnValue(47)  }  // /
        }

        // Punctuation (shift)
        IfCondition EqualTo(shift, 1) ThenBlock: {
            IfCondition EqualTo(keycode, 26) ThenBlock: { ReturnValue(123) }  // {
            IfCondition EqualTo(keycode, 27) ThenBlock: { ReturnValue(125) }  // }
            IfCondition EqualTo(keycode, 39) ThenBlock: { ReturnValue(58)  }  // :
            IfCondition EqualTo(keycode, 40) ThenBlock: { ReturnValue(34)  }  // "
            IfCondition EqualTo(keycode, 41) ThenBlock: { ReturnValue(126) }  // ~
            IfCondition EqualTo(keycode, 43) ThenBlock: { ReturnValue(124) }  // |
            IfCondition EqualTo(keycode, 51) ThenBlock: { ReturnValue(60)  }  // <
            IfCondition EqualTo(keycode, 52) ThenBlock: { ReturnValue(62)  }  // >
            IfCondition EqualTo(keycode, 53) ThenBlock: { ReturnValue(63)  }  // ?
        }

        ReturnValue(0)  // unhandled
    }
}

// =============================================================================
// RENDER — draw entire grid into surface
// Only redraws if dirty flag set
// =============================================================================
Function.TextBuffer_Render {
    Input:  handle: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(TB_Get(handle, TBField.DIRTY), 0) ThenBlock: {
            ReturnValue(0)
        }

        surf    = TB_Get(handle, TBField.SURF)
        font    = TB_Get(handle, TBField.FONT)
        buf     = TB_Get(handle, TBField.BUF)
        cols    = TB_Get(handle, TBField.COLS)
        rows    = TB_Get(handle, TBField.ROWS)
        char_w  = TB_Get(handle, TBField.CHAR_W)
        char_h  = TB_Get(handle, TBField.CHAR_H)
        cur_col = TB_Get(handle, TBField.CUR_COL)
        cur_row = TB_Get(handle, TBField.CUR_ROW)
        fg      = TB_Get(handle, TBField.FG)
        bg      = TB_Get(handle, TBField.BG)
        sw      = Surface_GetWidth(surf)
        sh      = Surface_GetHeight(surf)

        // Clear surface to bg color
        Draw_Pix_FillRect(surf, 0, 0, sw, sh, bg)

        // Draw each cell
        row = 0
        WhileLoop LessThan(row, rows) {
            col = 0
            WhileLoop LessThan(col, cols) {
                off = Add(Multiply(row, cols), col)
                ch  = GetByte(buf, off)
                px  = Multiply(col, char_w)
                py  = Multiply(row, char_h)
                IfCondition NotEqual(ch, 32) ThenBlock: {
                    FontBitmap_DrawChar(surf, font, px, py, ch, fg)
                }
                col = Add(col, 1)
            }
            row = Add(row, 1)
        }

        // Draw cursor block
        cur_px = Multiply(cur_col, char_w)
        cur_py = Multiply(cur_row, char_h)
        Draw_Pix_FillRect(surf, cur_px, cur_py, char_w, char_h, fg)
        // Draw char under cursor in bg color so it's visible
        off = Add(Multiply(cur_row, cols), cur_col)
        ch  = GetByte(buf, off)
        IfCondition NotEqual(ch, 32) ThenBlock: {
            FontBitmap_DrawChar(surf, font, cur_px, cur_py, ch, bg)
        }

        TB_Set(handle, TBField.DIRTY, 0)
        ReturnValue(1)
    }
}

// =============================================================================
// SET COLORS
// =============================================================================
Function.TextBuffer_SetColors {
    Input:  handle: Integer
    Input:  fg:     Integer
    Input:  bg:     Integer
    Output: Integer
    Body: {
        TB_Set(handle, TBField.FG, fg)
        TB_Set(handle, TBField.BG, bg)
        TB_Set(handle, TBField.DIRTY, 1)
        ReturnValue(1)
    }
}

// =============================================================================
// IS DIRTY
// =============================================================================
Function.TextBuffer_IsDirty {
    Input:  handle: Integer
    Output: Integer
    Body: {
        ReturnValue(TB_Get(handle, TBField.DIRTY))
    }
}