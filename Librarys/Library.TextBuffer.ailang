// Library.TextBuffer.ailang — Reusable multi-line text buffer with cursor
// Pool of 16 independent text buffers (one per TEXTFIELD).
// Adapted from Library.Editor patterns, NOT tied to TUI.
// Copyright (c) 2026 Sean Collins, 2 Paws Machine and Engineering. SCSL.

LibraryImport.Arrays
LibraryImport.StringUtils

// =============================================================================
// CONSTANTS
// =============================================================================
FixedPool.TextBufConst {
    "MAX_BUFS":    Initialize=16
    "ENTRY_SIZE":  Initialize=48
    "MAX_LINES":   Initialize=10000
}

// Entry offsets (48 bytes per entry):
//   0: LINES (XArray handle)
//   8: LINE_COUNT
//  16: CURSOR_ROW
//  24: CURSOR_COL
//  32: MODIFIED
//  40: (reserved)
FixedPool.TextBufOff {
    "LINES":      Initialize=0
    "LINE_COUNT": Initialize=8
    "CURSOR_ROW": Initialize=16
    "CURSOR_COL": Initialize=24
    "MODIFIED":   Initialize=32
}

// =============================================================================
// STATE
// =============================================================================
FixedPool.TextBufState {
    "pool":      Initialize=0, CanChange=True
    "pool_used": Initialize=0, CanChange=True
}

// =============================================================================
// GLOBAL CLIPBOARD — single shared buffer for copy/paste
// =============================================================================
FixedPool.Clipboard {
    "ptr": Initialize=0, CanChange=True
    "len": Initialize=0, CanChange=True
}

// =============================================================================
// INIT — allocate pool table
// =============================================================================
Function.TextBuf_Init {
    Body: {
        DebugLog_Push("tb.init", 7)
        tbl_size = Multiply(TextBufConst.MAX_BUFS, TextBufConst.ENTRY_SIZE)
        TextBufState.pool = Allocate(tbl_size)
        // Zero pool
        i = 0
        WhileLoop LessThan(i, tbl_size) {
            SetByte(TextBufState.pool, i, 0)
            i = Add(i, 1)
        }
        TextBufState.pool_used = 0
        PrintMessage("[TextBuf] init, pool=16\n")
    }
}

// =============================================================================
// INTERNAL: get pointer to entry by handle
// =============================================================================
Function.TextBuf_Ptr {
    Input: handle: Integer
    Output: Integer
    Body: {
        ReturnValue(Add(TextBufState.pool, Multiply(handle, TextBufConst.ENTRY_SIZE)))
    }
}

// =============================================================================
// CREATE — allocate a new text buffer, returns handle (0-15), -1 if full
// =============================================================================
Function.TextBuf_Create {
    Output: Integer
    Body: {
        DebugLog_Push("tb.cre", 6)
        IfCondition GreaterEqual(TextBufState.pool_used, TextBufConst.MAX_BUFS) ThenBlock: {
            PrintMessage("[TextBuf] pool full!\n")
            ReturnValue(-1)
        }
        h = TextBufState.pool_used
        TextBufState.pool_used = Add(h, 1)

        base = TextBuf_Ptr(h)
        // Create XArray for lines
        lines = Array.Create(TextBufConst.MAX_LINES)
        StoreValue(Add(base, TextBufOff.LINES), lines)

        // Start with one empty line
        empty = Allocate(1)
        SetByte(empty, 0, 0)
        Array.Push(lines, empty)
        StoreValue(Add(base, TextBufOff.LINE_COUNT), 1)
        StoreValue(Add(base, TextBufOff.CURSOR_ROW), 0)
        StoreValue(Add(base, TextBufOff.CURSOR_COL), 0)
        StoreValue(Add(base, TextBufOff.MODIFIED), 0)

        ReturnValue(h)
    }
}

// =============================================================================
// GETTERS
// =============================================================================
Function.TextBuf_GetLine {
    Input: handle: Integer
    Input: row: Integer
    Output: Integer
    Body: {
        base = TextBuf_Ptr(handle)
        lines = Dereference(Add(base, TextBufOff.LINES))
        ReturnValue(Array.Get(lines, row))
    }
}

Function.TextBuf_GetLineCount {
    Input: handle: Integer
    Output: Integer
    Body: {
        base = TextBuf_Ptr(handle)
        ReturnValue(Dereference(Add(base, TextBufOff.LINE_COUNT)))
    }
}

Function.TextBuf_GetCursorRow {
    Input: handle: Integer
    Output: Integer
    Body: {
        base = TextBuf_Ptr(handle)
        ReturnValue(Dereference(Add(base, TextBufOff.CURSOR_ROW)))
    }
}

Function.TextBuf_GetCursorCol {
    Input: handle: Integer
    Output: Integer
    Body: {
        base = TextBuf_Ptr(handle)
        ReturnValue(Dereference(Add(base, TextBufOff.CURSOR_COL)))
    }
}

Function.TextBuf_GetModified {
    Input: handle: Integer
    Output: Integer
    Body: {
        base = TextBuf_Ptr(handle)
        ReturnValue(Dereference(Add(base, TextBufOff.MODIFIED)))
    }
}

// =============================================================================
// INSERT LINE AT — shift lines down, insert new line at row
// =============================================================================
Function.TextBuf_InsertLineAt {
    Input: handle: Integer
    Input: row: Integer
    Input: line: Address
    Body: {
        base = TextBuf_Ptr(handle)
        lines = Dereference(Add(base, TextBufOff.LINES))
        lc = Dereference(Add(base, TextBufOff.LINE_COUNT))

        Array.Push(lines, 0)
        // Shift down
        i = lc
        WhileLoop GreaterThan(i, row) {
            prev = Array.Get(lines, Subtract(i, 1))
            Array.Set(lines, i, prev)
            i = Subtract(i, 1)
        }
        Array.Set(lines, row, line)
        StoreValue(Add(base, TextBufOff.LINE_COUNT), Add(lc, 1))
    }
}

// =============================================================================
// DELETE LINE AT — shift lines up, remove line at row
// =============================================================================
Function.TextBuf_DeleteLineAt {
    Input: handle: Integer
    Input: row: Integer
    Body: {
        base = TextBuf_Ptr(handle)
        lines = Dereference(Add(base, TextBufOff.LINES))
        lc = Dereference(Add(base, TextBufOff.LINE_COUNT))

        i = row
        WhileLoop LessThan(i, Subtract(lc, 1)) {
            next = Array.Get(lines, Add(i, 1))
            Array.Set(lines, i, next)
            i = Add(i, 1)
        }
        StoreValue(Add(base, TextBufOff.LINE_COUNT), Subtract(lc, 1))
    }
}

// =============================================================================
// INSERT CHAR — insert at cursor, advance col
// =============================================================================
Function.TextBuf_InsertChar {
    Input: handle: Integer
    Input: ch: Integer
    Body: {
        DebugLog_Push("tb.ins", 6)
        base = TextBuf_Ptr(handle)
        lines = Dereference(Add(base, TextBufOff.LINES))
        crow = Dereference(Add(base, TextBufOff.CURSOR_ROW))
        ccol = Dereference(Add(base, TextBufOff.CURSOR_COL))

        line = Array.Get(lines, crow)
        old_len = StringLength(line)
        new_len = Add(old_len, 1)

        new_line = Allocate(Add(new_len, 1))

        // Copy before cursor
        i = 0
        WhileLoop LessThan(i, ccol) {
            SetByte(new_line, i, GetByte(line, i))
            i = Add(i, 1)
        }
        // Insert char
        SetByte(new_line, ccol, ch)
        // Copy after cursor shifted by 1
        i = ccol
        WhileLoop LessThan(i, old_len) {
            SetByte(new_line, Add(i, 1), GetByte(line, i))
            i = Add(i, 1)
        }
        SetByte(new_line, new_len, 0)

        Deallocate(line, Add(old_len, 1))
        Array.Set(lines, crow, new_line)

        StoreValue(Add(base, TextBufOff.CURSOR_COL), Add(ccol, 1))
        StoreValue(Add(base, TextBufOff.MODIFIED), 1)
    }
}

// =============================================================================
// BACKSPACE — delete char before cursor, or join with previous line
// =============================================================================
Function.TextBuf_Backspace {
    Input: handle: Integer
    Body: {
        DebugLog_Push("tb.bks", 6)
        base = TextBuf_Ptr(handle)
        lines = Dereference(Add(base, TextBufOff.LINES))
        crow = Dereference(Add(base, TextBufOff.CURSOR_ROW))
        ccol = Dereference(Add(base, TextBufOff.CURSOR_COL))

        IfCondition GreaterThan(ccol, 0) ThenBlock: {
            line = Array.Get(lines, crow)
            old_len = StringLength(line)
            new_len = Subtract(old_len, 1)

            new_line = Allocate(Add(new_len, 1))
            // Copy before deleted char
            i = 0
            WhileLoop LessThan(i, Subtract(ccol, 1)) {
                SetByte(new_line, i, GetByte(line, i))
                i = Add(i, 1)
            }
            // Copy after deleted char shifted left
            i = ccol
            WhileLoop LessThan(i, old_len) {
                SetByte(new_line, Subtract(i, 1), GetByte(line, i))
                i = Add(i, 1)
            }
            SetByte(new_line, new_len, 0)

            Deallocate(line, Add(old_len, 1))
            Array.Set(lines, crow, new_line)
            StoreValue(Add(base, TextBufOff.CURSOR_COL), Subtract(ccol, 1))
            StoreValue(Add(base, TextBufOff.MODIFIED), 1)
        } ElseBlock: {
            // At col 0 — join with previous line
            IfCondition GreaterThan(crow, 0) ThenBlock: {
                TextBuf_JoinLines(handle, Subtract(crow, 1))
            }
        }
    }
}

// =============================================================================
// DELETE — delete char at cursor, or join with next line
// =============================================================================
Function.TextBuf_Delete {
    Input: handle: Integer
    Body: {
        DebugLog_Push("tb.del", 6)
        base = TextBuf_Ptr(handle)
        lines = Dereference(Add(base, TextBufOff.LINES))
        crow = Dereference(Add(base, TextBufOff.CURSOR_ROW))
        ccol = Dereference(Add(base, TextBufOff.CURSOR_COL))
        lc   = Dereference(Add(base, TextBufOff.LINE_COUNT))

        line = Array.Get(lines, crow)
        old_len = StringLength(line)

        IfCondition LessThan(ccol, old_len) ThenBlock: {
            // Delete char at cursor
            new_len = Subtract(old_len, 1)
            new_line = Allocate(Add(new_len, 1))
            // Copy before cursor
            i = 0
            WhileLoop LessThan(i, ccol) {
                SetByte(new_line, i, GetByte(line, i))
                i = Add(i, 1)
            }
            // Copy after cursor+1 shifted left
            i = Add(ccol, 1)
            WhileLoop LessThan(i, old_len) {
                SetByte(new_line, Subtract(i, 1), GetByte(line, i))
                i = Add(i, 1)
            }
            SetByte(new_line, new_len, 0)

            Deallocate(line, Add(old_len, 1))
            Array.Set(lines, crow, new_line)
            StoreValue(Add(base, TextBufOff.MODIFIED), 1)
        } ElseBlock: {
            // At end of line — join with next line
            IfCondition LessThan(crow, Subtract(lc, 1)) ThenBlock: {
                TextBuf_JoinLines(handle, crow)
            }
        }
    }
}

// =============================================================================
// ENTER — split line at cursor
// =============================================================================
Function.TextBuf_Enter {
    Input: handle: Integer
    Body: {
        DebugLog_Push("tb.ent", 6)
        base = TextBuf_Ptr(handle)
        lines = Dereference(Add(base, TextBufOff.LINES))
        crow = Dereference(Add(base, TextBufOff.CURSOR_ROW))
        ccol = Dereference(Add(base, TextBufOff.CURSOR_COL))

        line = Array.Get(lines, crow)
        old_len = StringLength(line)

        // First part: chars before cursor
        first_len = ccol
        first = Allocate(Add(first_len, 1))
        i = 0
        WhileLoop LessThan(i, first_len) {
            SetByte(first, i, GetByte(line, i))
            i = Add(i, 1)
        }
        SetByte(first, first_len, 0)

        // Second part: chars from cursor onwards
        second_len = Subtract(old_len, ccol)
        second = Allocate(Add(second_len, 1))
        i = 0
        WhileLoop LessThan(i, second_len) {
            SetByte(second, i, GetByte(line, Add(ccol, i)))
            i = Add(i, 1)
        }
        SetByte(second, second_len, 0)

        // Replace current line with first part
        Deallocate(line, Add(old_len, 1))
        Array.Set(lines, crow, first)

        // Insert second part as new line
        TextBuf_InsertLineAt(handle, Add(crow, 1), second)

        StoreValue(Add(base, TextBufOff.CURSOR_ROW), Add(crow, 1))
        StoreValue(Add(base, TextBufOff.CURSOR_COL), 0)
        StoreValue(Add(base, TextBufOff.MODIFIED), 1)
    }
}

// =============================================================================
// JOIN LINES — merge line[row] with line[row+1]
// =============================================================================
Function.TextBuf_JoinLines {
    Input: handle: Integer
    Input: row: Integer
    Body: {
        DebugLog_Push("tb.jl", 5)
        base = TextBuf_Ptr(handle)
        lines = Dereference(Add(base, TextBufOff.LINES))
        lc = Dereference(Add(base, TextBufOff.LINE_COUNT))

        IfCondition GreaterEqual(row, Subtract(lc, 1)) ThenBlock: { ReturnValue(0) }

        line1 = Array.Get(lines, row)
        line2 = Array.Get(lines, Add(row, 1))

        len1 = StringLength(line1)
        len2 = StringLength(line2)
        new_len = Add(len1, len2)

        new_line = Allocate(Add(new_len, 1))
        // Copy first line
        i = 0
        WhileLoop LessThan(i, len1) {
            SetByte(new_line, i, GetByte(line1, i))
            i = Add(i, 1)
        }
        // Append second line
        i = 0
        WhileLoop LessThan(i, len2) {
            SetByte(new_line, Add(len1, i), GetByte(line2, i))
            i = Add(i, 1)
        }
        SetByte(new_line, new_len, 0)

        Deallocate(line1, Add(len1, 1))
        Array.Set(lines, row, new_line)

        Deallocate(line2, Add(len2, 1))
        TextBuf_DeleteLineAt(handle, Add(row, 1))

        StoreValue(Add(base, TextBufOff.CURSOR_ROW), row)
        StoreValue(Add(base, TextBufOff.CURSOR_COL), len1)
        StoreValue(Add(base, TextBufOff.MODIFIED), 1)
    }
}

// =============================================================================
// CURSOR MOVEMENT
// =============================================================================
Function.TextBuf_MoveLeft {
    Input: handle: Integer
    Body: {
        base = TextBuf_Ptr(handle)
        ccol = Dereference(Add(base, TextBufOff.CURSOR_COL))
        crow = Dereference(Add(base, TextBufOff.CURSOR_ROW))
        IfCondition GreaterThan(ccol, 0) ThenBlock: {
            StoreValue(Add(base, TextBufOff.CURSOR_COL), Subtract(ccol, 1))
        } ElseBlock: {
            // Wrap to end of previous line
            IfCondition GreaterThan(crow, 0) ThenBlock: {
                new_row = Subtract(crow, 1)
                lines = Dereference(Add(base, TextBufOff.LINES))
                prev_line = Array.Get(lines, new_row)
                prev_len = StringLength(prev_line)
                StoreValue(Add(base, TextBufOff.CURSOR_ROW), new_row)
                StoreValue(Add(base, TextBufOff.CURSOR_COL), prev_len)
            }
        }
    }
}

Function.TextBuf_MoveRight {
    Input: handle: Integer
    Body: {
        base = TextBuf_Ptr(handle)
        lines = Dereference(Add(base, TextBufOff.LINES))
        ccol = Dereference(Add(base, TextBufOff.CURSOR_COL))
        crow = Dereference(Add(base, TextBufOff.CURSOR_ROW))
        lc   = Dereference(Add(base, TextBufOff.LINE_COUNT))

        line = Array.Get(lines, crow)
        line_len = StringLength(line)
        IfCondition LessThan(ccol, line_len) ThenBlock: {
            StoreValue(Add(base, TextBufOff.CURSOR_COL), Add(ccol, 1))
        } ElseBlock: {
            // Wrap to start of next line
            IfCondition LessThan(crow, Subtract(lc, 1)) ThenBlock: {
                StoreValue(Add(base, TextBufOff.CURSOR_ROW), Add(crow, 1))
                StoreValue(Add(base, TextBufOff.CURSOR_COL), 0)
            }
        }
    }
}

Function.TextBuf_MoveUp {
    Input: handle: Integer
    Body: {
        base = TextBuf_Ptr(handle)
        crow = Dereference(Add(base, TextBufOff.CURSOR_ROW))
        IfCondition GreaterThan(crow, 0) ThenBlock: {
            new_row = Subtract(crow, 1)
            StoreValue(Add(base, TextBufOff.CURSOR_ROW), new_row)
            // Clamp col to new line length
            ccol = Dereference(Add(base, TextBufOff.CURSOR_COL))
            lines = Dereference(Add(base, TextBufOff.LINES))
            line = Array.Get(lines, new_row)
            line_len = StringLength(line)
            IfCondition GreaterThan(ccol, line_len) ThenBlock: {
                StoreValue(Add(base, TextBufOff.CURSOR_COL), line_len)
            }
        }
    }
}

Function.TextBuf_MoveDown {
    Input: handle: Integer
    Body: {
        base = TextBuf_Ptr(handle)
        crow = Dereference(Add(base, TextBufOff.CURSOR_ROW))
        lc   = Dereference(Add(base, TextBufOff.LINE_COUNT))
        IfCondition LessThan(crow, Subtract(lc, 1)) ThenBlock: {
            new_row = Add(crow, 1)
            StoreValue(Add(base, TextBufOff.CURSOR_ROW), new_row)
            // Clamp col to new line length
            ccol = Dereference(Add(base, TextBufOff.CURSOR_COL))
            lines = Dereference(Add(base, TextBufOff.LINES))
            line = Array.Get(lines, new_row)
            line_len = StringLength(line)
            IfCondition GreaterThan(ccol, line_len) ThenBlock: {
                StoreValue(Add(base, TextBufOff.CURSOR_COL), line_len)
            }
        }
    }
}

Function.TextBuf_Home {
    Input: handle: Integer
    Body: {
        base = TextBuf_Ptr(handle)
        StoreValue(Add(base, TextBufOff.CURSOR_COL), 0)
    }
}

Function.TextBuf_End {
    Input: handle: Integer
    Body: {
        base = TextBuf_Ptr(handle)
        lines = Dereference(Add(base, TextBufOff.LINES))
        crow = Dereference(Add(base, TextBufOff.CURSOR_ROW))
        line = Array.Get(lines, crow)
        line_len = StringLength(line)
        StoreValue(Add(base, TextBufOff.CURSOR_COL), line_len)
    }
}

// =============================================================================
// CLEAR — reset buffer to single empty line, cursor to 0,0
// =============================================================================
Function.TextBuf_Clear {
    Input: handle: Integer
    Body: {
        DebugLog_Push("tb.clr", 6)
        base = TextBuf_Ptr(handle)
        lines = Dereference(Add(base, TextBufOff.LINES))
        lc = Dereference(Add(base, TextBufOff.LINE_COUNT))

        // Free all existing lines
        i = 0
        WhileLoop LessThan(i, lc) {
            lptr = Array.Get(lines, i)
            IfCondition NotEqual(lptr, 0) ThenBlock: {
                llen = StringLength(lptr)
                Deallocate(lptr, Add(llen, 1))
            }
            i = Add(i, 1)
        }

        // Reset array count (clear entries)
        Array.Clear(lines)

        // Add one empty line
        empty = Allocate(1)
        SetByte(empty, 0, 0)
        Array.Push(lines, empty)

        StoreValue(Add(base, TextBufOff.LINE_COUNT), 1)
        StoreValue(Add(base, TextBufOff.CURSOR_ROW), 0)
        StoreValue(Add(base, TextBufOff.CURSOR_COL), 0)
        StoreValue(Add(base, TextBufOff.MODIFIED), 0)
    }
}

// =============================================================================
// SET TEXT — clear buffer, split text on \n, populate lines
// =============================================================================
Function.TextBuf_SetText {
    Input: handle: Integer
    Input: text: Address
    Input: len: Integer
    Body: {
        DebugLog_Push("tb.set", 6)
        TextBuf_Clear(handle)

        base = TextBuf_Ptr(handle)
        lines = Dereference(Add(base, TextBufOff.LINES))

        // Remove the empty line from Clear — we'll add real lines
        first = Array.Get(lines, 0)
        IfCondition NotEqual(first, 0) ThenBlock: {
            Deallocate(first, 1)
        }
        Array.Clear(lines)

        // Scan text for newlines, split into lines
        line_start = 0
        line_count = 0
        i = 0
        WhileLoop LessEqual(i, len) {
            // At newline or end of text, emit a line
            at_end = EqualTo(i, len)
            at_nl = 0
            IfCondition LessThan(i, len) ThenBlock: {
                ch = GetByte(text, i)
                IfCondition EqualTo(ch, 10) ThenBlock: { at_nl = 1 }
            }
            IfCondition Or(EqualTo(at_end, 1), EqualTo(at_nl, 1)) ThenBlock: {
                seg_len = Subtract(i, line_start)
                new_line = Allocate(Add(seg_len, 1))
                j = 0
                WhileLoop LessThan(j, seg_len) {
                    SetByte(new_line, j, GetByte(text, Add(line_start, j)))
                    j = Add(j, 1)
                }
                SetByte(new_line, seg_len, 0)
                Array.Push(lines, new_line)
                line_count = Add(line_count, 1)
                line_start = Add(i, 1)
            }
            i = Add(i, 1)
        }

        // If text was empty, ensure at least one empty line
        IfCondition EqualTo(line_count, 0) ThenBlock: {
            empty = Allocate(1)
            SetByte(empty, 0, 0)
            Array.Push(lines, empty)
            line_count = 1
        }

        StoreValue(Add(base, TextBufOff.LINE_COUNT), line_count)
        StoreValue(Add(base, TextBufOff.CURSOR_ROW), 0)
        StoreValue(Add(base, TextBufOff.CURSOR_COL), 0)
        StoreValue(Add(base, TextBufOff.MODIFIED), 0)
    }
}

// =============================================================================
// GET ALL TEXT — join all lines with \n, write to out_buf, return byte count
// =============================================================================
Function.TextBuf_GetAllText {
    Input: handle: Integer
    Input: out_buf: Address
    Input: max_len: Integer
    Output: Integer
    Body: {
        DebugLog_Push("tb.gat", 6)
        base = TextBuf_Ptr(handle)
        lines = Dereference(Add(base, TextBufOff.LINES))
        lc = Dereference(Add(base, TextBufOff.LINE_COUNT))

        pos = 0
        r = 0
        WhileLoop LessThan(r, lc) {
            lptr = Array.Get(lines, r)
            llen = StringLength(lptr)

            // Check space: need llen bytes + 1 for newline (except last line)
            needed = llen
            IfCondition LessThan(r, Subtract(lc, 1)) ThenBlock: {
                needed = Add(needed, 1)
            }
            IfCondition GreaterThan(Add(pos, needed), max_len) ThenBlock: {
                // Truncate — copy what fits
                avail = Subtract(max_len, pos)
                IfCondition GreaterThan(avail, 0) ThenBlock: {
                    MemoryCopy(Add(out_buf, pos), lptr, avail)
                    pos = Add(pos, avail)
                }
                ReturnValue(pos)
            }

            // Copy line
            IfCondition GreaterThan(llen, 0) ThenBlock: {
                MemoryCopy(Add(out_buf, pos), lptr, llen)
                pos = Add(pos, llen)
            }

            // Add newline between lines (not after last)
            IfCondition LessThan(r, Subtract(lc, 1)) ThenBlock: {
                SetByte(out_buf, pos, 10)
                pos = Add(pos, 1)
            }

            r = Add(r, 1)
        }

        ReturnValue(pos)
    }
}

// =============================================================================
// PAGE UP — move cursor up by page_size rows, clamp
// =============================================================================
Function.TextBuf_PageUp {
    Input: handle: Integer
    Input: page_size: Integer
    Body: {
        base = TextBuf_Ptr(handle)
        crow = Dereference(Add(base, TextBufOff.CURSOR_ROW))
        new_row = Subtract(crow, page_size)
        IfCondition LessThan(new_row, 0) ThenBlock: { new_row = 0 }
        StoreValue(Add(base, TextBufOff.CURSOR_ROW), new_row)
        // Clamp col
        ccol = Dereference(Add(base, TextBufOff.CURSOR_COL))
        lines = Dereference(Add(base, TextBufOff.LINES))
        line = Array.Get(lines, new_row)
        line_len = StringLength(line)
        IfCondition GreaterThan(ccol, line_len) ThenBlock: {
            StoreValue(Add(base, TextBufOff.CURSOR_COL), line_len)
        }
    }
}

// =============================================================================
// PAGE DOWN — move cursor down by page_size rows, clamp
// =============================================================================
Function.TextBuf_PageDown {
    Input: handle: Integer
    Input: page_size: Integer
    Body: {
        base = TextBuf_Ptr(handle)
        crow = Dereference(Add(base, TextBufOff.CURSOR_ROW))
        lc = Dereference(Add(base, TextBufOff.LINE_COUNT))
        new_row = Add(crow, page_size)
        max_row = Subtract(lc, 1)
        IfCondition GreaterThan(new_row, max_row) ThenBlock: { new_row = max_row }
        StoreValue(Add(base, TextBufOff.CURSOR_ROW), new_row)
        // Clamp col
        ccol = Dereference(Add(base, TextBufOff.CURSOR_COL))
        lines = Dereference(Add(base, TextBufOff.LINES))
        line = Array.Get(lines, new_row)
        line_len = StringLength(line)
        IfCondition GreaterThan(ccol, line_len) ThenBlock: {
            StoreValue(Add(base, TextBufOff.CURSOR_COL), line_len)
        }
    }
}

// =============================================================================
// SET CURSOR — set cursor position directly (for goto-line)
// =============================================================================
Function.TextBuf_SetCursor {
    Input: handle: Integer
    Input: row: Integer
    Input: col: Integer
    Body: {
        base = TextBuf_Ptr(handle)
        lc = Dereference(Add(base, TextBufOff.LINE_COUNT))
        // Clamp row
        IfCondition LessThan(row, 0) ThenBlock: { row = 0 }
        IfCondition GreaterEqual(row, lc) ThenBlock: { row = Subtract(lc, 1) }
        StoreValue(Add(base, TextBufOff.CURSOR_ROW), row)
        // Clamp col to line length
        lines = Dereference(Add(base, TextBufOff.LINES))
        line = Array.Get(lines, row)
        line_len = StringLength(line)
        IfCondition LessThan(col, 0) ThenBlock: { col = 0 }
        IfCondition GreaterThan(col, line_len) ThenBlock: { col = line_len }
        StoreValue(Add(base, TextBufOff.CURSOR_COL), col)
    }
}

// =============================================================================
// SET MODIFIED — set or clear the modified flag
// =============================================================================
Function.TextBuf_SetModified {
    Input: handle: Integer
    Input: val: Integer
    Body: {
        base = TextBuf_Ptr(handle)
        StoreValue(Add(base, TextBufOff.MODIFIED), val)
    }
}

// =============================================================================
// CLIPBOARD — global copy/paste buffer
// =============================================================================
Function.Clipboard_Set {
    Input: src: Integer
    Input: slen: Integer
    Body: {
        DebugLog_Push("cb.SET", 6)
        // Empty/NULL payload is a no-op — only Clipboard_Clear wipes.
        // Prevents a zero-width copy from destroying prior clipboard content
        // (menu-paste saw cb.G0! after a stray empty set).
        IfCondition Or(EqualTo(src, 0), LessEqual(slen, 0)) ThenBlock: {
            DebugLog_Push("cb.NOP", 6)
            ReturnValue(0)
        }
        // Free old clipboard
        old = Clipboard.ptr
        IfCondition NotEqual(old, 0) ThenBlock: { Deallocate(old, Add(Clipboard.len, 1)) }
        // Allocate + copy new
        buf = Allocate(Add(slen, 1))
        MemoryCopy(buf, src, slen)
        SetByte(buf, slen, 0)
        Clipboard.ptr = buf
        Clipboard.len = slen
        DebugLog_Push("cb.OK", 5)
        // Auto-record in clipboard history
        ClipHistory_Push(ClipType.TEXT, src, slen)
        ReturnValue(0)
    }
}

Function.Clipboard_Get {
    Output: Integer
    Body: {
        IfCondition GreaterThan(Clipboard.len, 0) ThenBlock: {
            DebugLog_Push("cb.GOK", 6)
        } ElseBlock: {
            DebugLog_Push("cb.G0!", 6)
        }
        ReturnValue(Clipboard.ptr)
    }
}

Function.Clipboard_Clear {
    Body: {
        old = Clipboard.ptr
        IfCondition NotEqual(old, 0) ThenBlock: { Deallocate(old, Add(Clipboard.len, 1)) }
        Clipboard.ptr = 0
        Clipboard.len = 0
        ReturnValue(0)
    }
}

// =============================================================================
// RANGE NORMALIZATION — ensure start <= end
// Writes 4 values to out_ptr: [sr, sc, er, ec] normalized
// =============================================================================
Function.TextBuf_NormalizeRange {
    Input: sr: Integer
    Input: sc: Integer
    Input: er: Integer
    Input: ec: Integer
    Input: out: Integer
    Body: {
        // If start is after end, swap
        swap = 0
        IfCondition GreaterThan(sr, er) ThenBlock: { swap = 1 }
        IfCondition And(EqualTo(sr, er), GreaterThan(sc, ec)) ThenBlock: { swap = 1 }
        IfCondition EqualTo(swap, 1) ThenBlock: {
            StoreValue(out, er)
            StoreValue(Add(out, 8), ec)
            StoreValue(Add(out, 16), sr)
            StoreValue(Add(out, 24), sc)
        } ElseBlock: {
            StoreValue(out, sr)
            StoreValue(Add(out, 8), sc)
            StoreValue(Add(out, 16), er)
            StoreValue(Add(out, 24), ec)
        }
        ReturnValue(0)
    }
}

// =============================================================================
// GET RANGE LENGTH — byte length of text in range (for allocation)
// =============================================================================
Function.TextBuf_GetRangeLen {
    Input: handle: Integer
    Input: sr: Integer
    Input: sc: Integer
    Input: er: Integer
    Input: ec: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(sr, er) ThenBlock: {
            // Single line: ec - sc bytes
            IfCondition GreaterThan(ec, sc) ThenBlock: { ReturnValue(Subtract(ec, sc)) }
            ReturnValue(0)
        }
        total = 0
        r = sr
        WhileLoop LessEqual(r, er) {
            lp = TextBuf_GetLine(handle, r)
            ll = StringLength(lp)
            IfCondition EqualTo(r, sr) ThenBlock: {
                // First line: from sc to end
                IfCondition LessThan(sc, ll) ThenBlock: { total = Add(total, Subtract(ll, sc)) }
                total = Add(total, 1)
            } ElseBlock: {
                IfCondition EqualTo(r, er) ThenBlock: {
                    // Last line: from 0 to ec
                    IfCondition LessThan(ec, ll) ThenBlock: { total = Add(total, ec) }
                    IfCondition GreaterEqual(ec, ll) ThenBlock: { total = Add(total, ll) }
                } ElseBlock: {
                    // Middle lines: full line + newline
                    total = Add(total, Add(ll, 1))
                }
            }
            r = Add(r, 1)
        }
        ReturnValue(total)
    }
}

// =============================================================================
// GET RANGE TEXT — extract text from (sr,sc) to (er,ec) into allocated buffer
// Returns pointer to null-terminated string. Caller must Deallocate().
// =============================================================================
Function.TextBuf_GetRangeText {
    Input: handle: Integer
    Input: sr: Integer
    Input: sc: Integer
    Input: er: Integer
    Input: ec: Integer
    Output: Integer
    Body: {
        tlen = TextBuf_GetRangeLen(handle, sr, sc, er, ec)
        IfCondition LessEqual(tlen, 0) ThenBlock: { ReturnValue(0) }
        buf = Allocate(Add(tlen, 1))
        pos = 0
        IfCondition EqualTo(sr, er) ThenBlock: {
            // Single line
            lp = TextBuf_GetLine(handle, sr)
            MemoryCopy(Add(buf, pos), Add(lp, sc), Subtract(ec, sc))
            pos = Add(pos, Subtract(ec, sc))
        } ElseBlock: {
            pos = TextBuf_CopyRange(handle, sr, sc, er, ec, buf)
        }
        SetByte(buf, pos, 0)
        ReturnValue(buf)
    }
}

// Helper for multi-line range copy (~14 locals)
Function.TextBuf_CopyRange {
    Input: handle: Integer
    Input: sr: Integer
    Input: sc: Integer
    Input: er: Integer
    Input: ec: Integer
    Input: buf: Integer
    Output: Integer
    Body: {
        pos = 0
        r = sr
        WhileLoop LessEqual(r, er) {
            lp = TextBuf_GetLine(handle, r)
            ll = StringLength(lp)
            IfCondition EqualTo(r, sr) ThenBlock: {
                chunk = Subtract(ll, sc)
                IfCondition GreaterThan(chunk, 0) ThenBlock: {
                    MemoryCopy(Add(buf, pos), Add(lp, sc), chunk)
                    pos = Add(pos, chunk)
                }
                SetByte(buf, pos, 10)
                pos = Add(pos, 1)
            } ElseBlock: {
                IfCondition EqualTo(r, er) ThenBlock: {
                    chunk2 = ec
                    IfCondition GreaterThan(chunk2, ll) ThenBlock: { chunk2 = ll }
                    IfCondition GreaterThan(chunk2, 0) ThenBlock: {
                        MemoryCopy(Add(buf, pos), lp, chunk2)
                        pos = Add(pos, chunk2)
                    }
                } ElseBlock: {
                    MemoryCopy(Add(buf, pos), lp, ll)
                    pos = Add(pos, ll)
                    SetByte(buf, pos, 10)
                    pos = Add(pos, 1)
                }
            }
            r = Add(r, 1)
        }
        ReturnValue(pos)
    }
}

// =============================================================================
// DELETE RANGE — remove text from (sr,sc) to (er,ec), collapse cursor to start
// =============================================================================
Function.TextBuf_DeleteRange {
    Input: handle: Integer
    Input: sr: Integer
    Input: sc: Integer
    Input: er: Integer
    Input: ec: Integer
    Body: {
        base = TextBuf_Ptr(handle)
        lcount = Dereference(Add(base, TextBufOff.LINE_COUNT))
        IfCondition GreaterEqual(sr, lcount) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterThan(er, Subtract(lcount, 1)) ThenBlock: { er = Subtract(lcount, 1) }

        IfCondition EqualTo(sr, er) ThenBlock: {
            // Single line delete
            TextBuf_DeleteRangeLine(handle, sr, sc, ec)
        } ElseBlock: {
            // Multi-line delete
            TextBuf_DeleteRangeMulti(handle, sr, sc, er, ec)
        }
        // Set cursor to start of deleted range
        TextBuf_SetCursor(handle, sr, sc)
        StoreValue(Add(base, TextBufOff.MODIFIED), 1)
        ReturnValue(0)
    }
}

// Single-line range delete (~10 locals)
Function.TextBuf_DeleteRangeLine {
    Input: handle: Integer
    Input: row: Integer
    Input: sc: Integer
    Input: ec: Integer
    Body: {
        lp = TextBuf_GetLine(handle, row)
        ll = StringLength(lp)
        IfCondition GreaterThan(ec, ll) ThenBlock: { ec = ll }
        IfCondition GreaterEqual(sc, ec) ThenBlock: { ReturnValue(0) }
        del_len = Subtract(ec, sc)
        new_len = Subtract(ll, del_len)
        new_str = Allocate(Add(new_len, 1))
        // Copy prefix
        IfCondition GreaterThan(sc, 0) ThenBlock: { MemoryCopy(new_str, lp, sc) }
        // Copy suffix
        tail = Subtract(ll, ec)
        IfCondition GreaterThan(tail, 0) ThenBlock: {
            MemoryCopy(Add(new_str, sc), Add(lp, ec), tail)
        }
        SetByte(new_str, new_len, 0)
        // Replace line
        base = TextBuf_Ptr(handle)
        lines = Dereference(Add(base, TextBufOff.LINES))
        Array.Set(lines, row, new_str)
        Deallocate(lp, Add(ll, 1))
        ReturnValue(0)
    }
}

// Multi-line range delete (~14 locals)
Function.TextBuf_DeleteRangeMulti {
    Input: handle: Integer
    Input: sr: Integer
    Input: sc: Integer
    Input: er: Integer
    Input: ec: Integer
    Body: {
        base = TextBuf_Ptr(handle)
        lines = Dereference(Add(base, TextBufOff.LINES))
        // Join first line prefix with last line suffix
        lp_first = TextBuf_GetLine(handle, sr)
        lp_last = TextBuf_GetLine(handle, er)
        ll_last = StringLength(lp_last)
        tail_len = Subtract(ll_last, ec)
        IfCondition LessThan(tail_len, 0) ThenBlock: { tail_len = 0 }
        new_len = Add(sc, tail_len)
        new_str = Allocate(Add(new_len, 1))
        IfCondition GreaterThan(sc, 0) ThenBlock: { MemoryCopy(new_str, lp_first, sc) }
        IfCondition GreaterThan(tail_len, 0) ThenBlock: {
            MemoryCopy(Add(new_str, sc), Add(lp_last, ec), tail_len)
        }
        SetByte(new_str, new_len, 0)
        // Free deleted lines (sr+1 through er)
        d = Add(sr, 1)
        WhileLoop LessEqual(d, er) {
            dp = Array.Get(lines, d)
            IfCondition NotEqual(dp, 0) ThenBlock: { Deallocate(dp, Add(StringLength(dp), 1)) }
            d = Add(d, 1)
        }
        // Remove lines sr+1..er from XArray
        remove_count = Subtract(er, sr)
        r2 = 0
        WhileLoop LessThan(r2, remove_count) {
            Array.Delete(lines, Add(sr, 1))
            r2 = Add(r2, 1)
        }
        // Replace first line with joined string
        old_first = Array.Get(lines, sr)
        IfCondition NotEqual(old_first, 0) ThenBlock: { Deallocate(old_first, Add(StringLength(old_first), 1)) }
        Array.Set(lines, sr, new_str)
        // Update line count
        old_count = Dereference(Add(base, TextBufOff.LINE_COUNT))
        StoreValue(Add(base, TextBufOff.LINE_COUNT), Subtract(old_count, remove_count))
        ReturnValue(0)
    }
}

// =============================================================================
// INSERT STRING — insert multi-char/multi-line text at cursor (for paste)
// =============================================================================
Function.TextBuf_InsertString {
    Input: handle: Integer
    Input: str_ptr: Integer
    Input: str_len: Integer
    Body: {
        IfCondition Or(EqualTo(str_ptr, 0), LessEqual(str_len, 0)) ThenBlock: { ReturnValue(0) }
        // Insert character by character — handles newlines via Enter
        i = 0
        WhileLoop LessThan(i, str_len) {
            ch = GetByte(str_ptr, i)
            IfCondition EqualTo(ch, 10) ThenBlock: {
                TextBuf_Enter(handle)
            } ElseBlock: {
                IfCondition NotEqual(ch, 13) ThenBlock: {
                    TextBuf_InsertChar(handle, ch)
                }
            }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

// =============================================================================
// CLIPBOARD HISTORY — ring buffer of past copies (orthogonal type tags)
// =============================================================================

// Type tags — extensible for images, binary blobs, etc.
FixedPool.ClipType {
    "TEXT":   Initialize=1
    "IMAGE":  Initialize=2
    "BINARY": Initialize=3
}

// Byte offsets within a 32-byte history entry
FixedPool.ClipHistOff {
    "TYPE": Initialize=0
    "PTR":  Initialize=8
    "LEN":  Initialize=16
    "SEQ":  Initialize=24
}

FixedPool.ClipHistConst {
    "MAX_ENTRIES": Initialize=100
    "ENTRY_SIZE":  Initialize=32
}

FixedPool.ClipHistState {
    "entries":  Initialize=0, CanChange=True
    "next_seq": Initialize=0, CanChange=True
}

// =============================================================================
// ClipHistory_Init — create the backing array
// =============================================================================
Function.ClipHistory_Init {
    Body: {
        arr = Array.Create(ClipHistConst.MAX_ENTRIES)
        ClipHistState.entries  = arr
        ClipHistState.next_seq = 0
        ReturnValue(0)
    }
}

// =============================================================================
// ClipHistory_Push — record a new clipboard entry (copies the data)
// =============================================================================
Function.ClipHistory_Push {
    Input: clip_type: Integer
    Input: src_ptr: Integer
    Input: src_len: Integer
    Body: {
        arr = ClipHistState.entries
        IfCondition EqualTo(arr, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(src_ptr, 0) ThenBlock: { ReturnValue(0) }
        IfCondition LessEqual(src_len, 0) ThenBlock: { ReturnValue(0) }

        // Evict oldest if at capacity
        count = Array.Size(arr)
        IfCondition GreaterEqual(count, ClipHistConst.MAX_ENTRIES) ThenBlock: {
            ClipHistory_FreeEntry(arr, 0)
            Array.Delete(arr, 0)
        }

        // Allocate 32-byte entry block
        entry = Allocate(ClipHistConst.ENTRY_SIZE)
        StoreValue(Add(entry, ClipHistOff.TYPE), clip_type)
        StoreValue(Add(entry, ClipHistOff.LEN), src_len)
        StoreValue(Add(entry, ClipHistOff.SEQ), ClipHistState.next_seq)
        ClipHistState.next_seq = Add(ClipHistState.next_seq, 1)

        // Copy payload so it survives independently
        buf = Allocate(Add(src_len, 1))
        MemoryCopy(buf, src_ptr, src_len)
        SetByte(buf, src_len, 0)
        StoreValue(Add(entry, ClipHistOff.PTR), buf)

        Array.Push(arr, entry)
        ReturnValue(1)
    }
}

// =============================================================================
// ClipHistory_FreeEntry — deallocate one entry's payload + block
// =============================================================================
Function.ClipHistory_FreeEntry {
    Input: arr: Integer
    Input: idx: Integer
    Body: {
        entry = Array.Get(arr, idx)
        IfCondition EqualTo(entry, 0) ThenBlock: { ReturnValue(0) }
        ptr = Dereference(Add(entry, ClipHistOff.PTR))
        elen = Dereference(Add(entry, ClipHistOff.LEN))
        IfCondition NotEqual(ptr, 0) ThenBlock: {
            Deallocate(ptr, Add(elen, 1))
        }
        Deallocate(entry, ClipHistConst.ENTRY_SIZE)
        ReturnValue(0)
    }
}

// =============================================================================
// ClipHistory_Get — return entry pointer at index (caller reads fields)
// =============================================================================
Function.ClipHistory_Get {
    Input: idx: Integer
    Output: Integer
    Body: {
        arr = ClipHistState.entries
        IfCondition EqualTo(arr, 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(Array.Get(arr, idx))
    }
}

// =============================================================================
// ClipHistory_Count — number of entries currently stored
// =============================================================================
Function.ClipHistory_Count {
    Output: Integer
    Body: {
        arr = ClipHistState.entries
        IfCondition EqualTo(arr, 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(Array.Size(arr))
    }
}

// =============================================================================
// ClipHistory_Clear — free all entries and reset
// =============================================================================
Function.ClipHistory_Clear {
    Body: {
        arr = ClipHistState.entries
        IfCondition EqualTo(arr, 0) ThenBlock: { ReturnValue(0) }
        count = Array.Size(arr)
        i = 0
        WhileLoop LessThan(i, count) {
            ClipHistory_FreeEntry(arr, i)
            i = Add(i, 1)
        }
        Array.Clear(arr)
        ClipHistState.next_seq = 0
        ReturnValue(0)
    }
}
