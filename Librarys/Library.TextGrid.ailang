LibraryImport.Arena
LibraryImport.Anim
LibraryImport.Display.Render.Framebuffer
LibraryImport.Display.Render.Fonts
LibraryImport.Display.Render.VIF

FixedPool.TextGridFlag {
    "INT": Initialize=1
}

FixedPool.TextGrid_State {
    "ok":     Initialize=0, CanChange=True
    "x":      Initialize=0, CanChange=True
    "y":      Initialize=0, CanChange=True
    "w":      Initialize=0, CanChange=True
    "h":      Initialize=0, CanChange=True
    "cols":   Initialize=2, CanChange=True
    "rows":   Initialize=0, CanChange=True
    "capr":   Initialize=32, CanChange=True
    "capc":   Initialize=4, CanChange=True
    "cells":  Initialize=0, CanChange=True
    "nbuf":   Initialize=0, CanChange=True
    "rh":     Initialize=22, CanChange=True
    "fs":     Initialize=14, CanChange=True
    "hdr":    Initialize=1, CanChange=True
    "top":    Initialize=0, CanChange=True
    "vis":    Initialize=8, CanChange=True
    "ntotal": Initialize=0, CanChange=True
    "grab":   Initialize=0, CanChange=True
    "sbw":    Initialize=14, CanChange=True
}

Function.TextGrid.CellAt {
    Input: row: Integer
    Input: col: Integer
    Output: Integer
    Body: {
        ReturnValue(Add(TextGrid_State.cells, Multiply(Add(Multiply(row, TextGrid_State.capc), col), 32)))
    }
}

Function.TextGrid.Init {
    Output: Integer
    Body: {
        IfCondition EqualTo(TextGrid_State.ok, 1) ThenBlock: { ReturnValue(1) }
        TextGrid_State.capr = 32
        TextGrid_State.capc = 4
        TextGrid_State.cells = Allocate(4096)
        TextGrid_State.nbuf = Allocate(1536)
        TextGrid_State.ok = 1
        ReturnValue(1)
    }
}

Function.TextGrid.Place {
    Input: x: Integer
    Input: y: Integer
    Input: w: Integer
    Input: h: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(TextGrid.Init(), 0) ThenBlock: { ReturnValue(-1) }
        TextGrid_State.x = x
        TextGrid_State.y = y
        TextGrid_State.w = w
        TextGrid_State.h = h
        ReturnValue(0)
    }
}

Function.TextGrid.Layout {
    Input: cols: Integer
    Input: rows: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(TextGrid.Init(), 0) ThenBlock: { ReturnValue(-1) }
        IfCondition LessThan(cols, 1) ThenBlock: { cols = 1 }
        IfCondition GreaterThan(cols, TextGrid_State.capc) ThenBlock: { cols = TextGrid_State.capc }
        IfCondition LessThan(rows, 1) ThenBlock: { rows = 1 }
        IfCondition GreaterThan(rows, TextGrid_State.capr) ThenBlock: { rows = TextGrid_State.capr }
        TextGrid_State.cols = cols
        TextGrid_State.rows = rows
        IfCondition GreaterThan(TextGrid_State.h, 8) ThenBlock: {
            TextGrid_State.rh = Divide(TextGrid_State.h, rows)
        }
        IfCondition LessThan(TextGrid_State.rh, 18) ThenBlock: { TextGrid_State.rh = 18 }
        IfCondition GreaterThan(TextGrid_State.rh, 28) ThenBlock: { TextGrid_State.rh = 28 }
        TextGrid_State.fs = Subtract(TextGrid_State.rh, 6)
        IfCondition LessThan(TextGrid_State.fs, 12) ThenBlock: { TextGrid_State.fs = 12 }
        i = 0
        n = Multiply(TextGrid_State.capr, TextGrid_State.capc)
        WhileLoop LessThan(i, n) {
            p = Add(TextGrid_State.cells, Multiply(i, 32))
            StoreValue(p, 0)
            StoreValue(Add(p, 8), FB_RGB(255, 255, 255))
            StoreValue(Add(p, 16), 0)
            StoreValue(Add(p, 24), 0)
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

Function.TextGrid.Set {
    Input: row: Integer
    Input: col: Integer
    Input: s: Address
    Input: color: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(row, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition GreaterEqual(row, TextGrid_State.rows) ThenBlock: { ReturnValue(-1) }
        IfCondition LessThan(col, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition GreaterEqual(col, TextGrid_State.cols) ThenBlock: { ReturnValue(-1) }
        p = TextGrid.CellAt(row, col)
        StoreValue(p, s)
        StoreValue(Add(p, 8), color)
        StoreValue(Add(p, 24), 0)
        ReturnValue(0)
    }
}

Function.TextGrid.SetInt {
    Input: row: Integer
    Input: col: Integer
    Input: v: Integer
    Input: color: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(row, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition GreaterEqual(row, TextGrid_State.rows) ThenBlock: { ReturnValue(-1) }
        IfCondition LessThan(col, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition GreaterEqual(col, TextGrid_State.cols) ThenBlock: { ReturnValue(-1) }
        p = TextGrid.CellAt(row, col)
        StoreValue(Add(p, 8), color)
        StoreValue(Add(p, 16), v)
        StoreValue(Add(p, 24), TextGridFlag.INT)
        idx = Add(Multiply(row, TextGrid_State.capc), col)
        dst = Add(TextGrid_State.nbuf, Multiply(idx, 12))
        n = v
        sign = 0
        IfCondition LessThan(n, 0) ThenBlock: {
            sign = 1
            n = Subtract(0, n)
        }
        IfCondition EqualTo(n, 0) ThenBlock: {
            SetByte(dst, 0, 48)
            SetByte(dst, 1, 0)
            StoreValue(p, dst)
            ReturnValue(0)
        }
        tmp = Add(dst, 6)
        k = 0
        WhileLoop GreaterThan(n, 0) {
            SetByte(tmp, k, Add(48, Modulo(n, 10)))
            n = Divide(n, 10)
            k = Add(k, 1)
            IfCondition GreaterThan(k, 5) ThenBlock: { n = 0 }
        }
        o = 0
        IfCondition EqualTo(sign, 1) ThenBlock: {
            SetByte(dst, 0, 45)
            o = 1
        }
        i = Subtract(k, 1)
        WhileLoop GreaterEqual(i, 0) {
            SetByte(dst, o, GetByte(tmp, i))
            o = Add(o, 1)
            i = Subtract(i, 1)
        }
        SetByte(dst, o, 0)
        StoreValue(p, dst)
        ReturnValue(0)
    }
}

Function.TextGrid.NeedBar {
    Output: Integer
    Body: {
        IfCondition GreaterThan(TextGrid_State.ntotal, TextGrid_State.vis) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

Function.TextGrid.SetScroll {
    Input: top: Integer
    Input: vis: Integer
    Input: ntotal: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(vis, 1) ThenBlock: { vis = 1 }
        IfCondition LessThan(ntotal, 0) ThenBlock: { ntotal = 0 }
        max = Subtract(ntotal, vis)
        IfCondition LessThan(max, 0) ThenBlock: { max = 0 }
        IfCondition LessThan(top, 0) ThenBlock: { top = 0 }
        IfCondition GreaterThan(top, max) ThenBlock: { top = max }
        TextGrid_State.top = top
        TextGrid_State.vis = vis
        TextGrid_State.ntotal = ntotal
        ReturnValue(top)
    }
}

Function.TextGrid.BarX {
    Output: Integer
    Body: {
        ReturnValue(Subtract(Add(TextGrid_State.x, TextGrid_State.w), TextGrid_State.sbw))
    }
}

Function.TextGrid.ThumbH {
    Output: Integer
    Body: {
        h = TextGrid_State.h
        n = TextGrid_State.ntotal
        vis = TextGrid_State.vis
        IfCondition LessThan(n, 1) ThenBlock: { n = 1 }
        th = Divide(Multiply(h, vis), n)
        IfCondition LessThan(th, 20) ThenBlock: { th = 20 }
        IfCondition GreaterThan(th, h) ThenBlock: { th = h }
        ReturnValue(th)
    }
}

Function.TextGrid.ThumbY {
    Output: Integer
    Body: {
        h = TextGrid_State.h
        th = TextGrid.ThumbH()
        tspace = Subtract(h, th)
        IfCondition LessThan(tspace, 1) ThenBlock: { tspace = 1 }
        max = Subtract(TextGrid_State.ntotal, TextGrid_State.vis)
        IfCondition LessThan(max, 1) ThenBlock: { max = 1 }
        off = Divide(Multiply(TextGrid_State.top, tspace), max)
        ReturnValue(Add(TextGrid_State.y, off))
    }
}

Function.TextGrid.HitScroll {
    Input: px: Integer
    Input: py: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(TextGrid.NeedBar(), 0) ThenBlock: { ReturnValue(0) }
        x = TextGrid.BarX()
        y = TextGrid_State.y
        IfCondition LessThan(px, x) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterEqual(px, Add(TextGrid_State.x, TextGrid_State.w)) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(py, y) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterEqual(py, Add(y, TextGrid_State.h)) ThenBlock: { ReturnValue(0) }
        ReturnValue(1)
    }
}

Function.TextGrid.ScrollGrab {
    Input: py: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(TextGrid.NeedBar(), 0) ThenBlock: { ReturnValue(0) }
        y = TextGrid_State.y
        th = TextGrid.ThumbH()
        ty = TextGrid.ThumbY()
        goff = Subtract(py, ty)
        jump = 0
        IfCondition LessThan(goff, 0) ThenBlock: { jump = 1 }
        IfCondition GreaterEqual(goff, th) ThenBlock: { jump = 1 }
        IfCondition EqualTo(jump, 1) ThenBlock: {
            goff = Divide(th, 2)
            TextGrid_State.grab = goff
            TextGrid.ScrollAt(py)
        }
        TextGrid_State.grab = goff
        ReturnValue(1)
    }
}

Function.TextGrid.ScrollAt {
    Input: py: Integer
    Output: Integer
    Body: {
        y = TextGrid_State.y
        th = TextGrid.ThumbH()
        tspace = Subtract(TextGrid_State.h, th)
        IfCondition LessThan(tspace, 1) ThenBlock: { tspace = 1 }
        max = Subtract(TextGrid_State.ntotal, TextGrid_State.vis)
        IfCondition LessThan(max, 0) ThenBlock: { max = 0 }
        jrel = Subtract(Subtract(py, y), TextGrid_State.grab)
        IfCondition LessThan(jrel, 0) ThenBlock: { jrel = 0 }
        IfCondition GreaterThan(jrel, tspace) ThenBlock: { jrel = tspace }
        top = 0
        IfCondition GreaterThan(max, 0) ThenBlock: {
            top = Divide(Multiply(jrel, max), tspace)
        }
        ReturnValue(TextGrid.SetScroll(top, TextGrid_State.vis, TextGrid_State.ntotal))
    }
}

Function.TextGrid.Draw {
    Output: Integer
    Body: {
        IfCondition EqualTo(TextGrid_State.ok, 0) ThenBlock: { ReturnValue(-1) }
        Anim.BindFB()
        dest = Anim.Dest()
        IfCondition EqualTo(dest, 0) ThenBlock: { ReturnValue(-1) }
        x = TextGrid_State.x
        y = TextGrid_State.y
        w = TextGrid_State.w
        h = TextGrid_State.h
        FB_FillRect(x, y, w, h, FB_RGB(10, 16, 32))
        FB_Rect(x, y, w, h, FB_RGB(42, 64, 96))
        gw = w
        IfCondition EqualTo(TextGrid.NeedBar(), 1) ThenBlock: {
            gw = Subtract(w, TextGrid_State.sbw)
        }
        VFont_UseSize(TextGrid_State.fs)
        cols = TextGrid_State.cols
        cw = Divide(gw, cols)
        rh = TextGrid_State.rh
        r = 0
        WhileLoop LessThan(r, TextGrid_State.rows) {
            ry = Add(y, Multiply(r, rh))
            IfCondition LessThan(Add(ry, rh), Add(y, h)) ThenBlock: {
                IfCondition EqualTo(r, 0) ThenBlock: {
                    IfCondition EqualTo(TextGrid_State.hdr, 1) ThenBlock: {
                        FB_FillRect(Add(x, 1), Add(ry, 1), Subtract(gw, 2), Subtract(rh, 1), FB_RGB(22, 34, 56))
                    }
                }
                c = 0
                WhileLoop LessThan(c, cols) {
                    p = TextGrid.CellAt(r, c)
                    s = Dereference(p)
                    col = Dereference(Add(p, 8))
                    cx = Add(Add(x, 8), Multiply(c, cw))
                    cy = Add(ry, 4)
                    IfCondition NotEqual(s, 0) ThenBlock: {
                        ln = 0
                        more = 1
                        WhileLoop EqualTo(more, 1) {
                            IfCondition EqualTo(GetByte(s, ln), 0) ThenBlock: { more = 0 }
                            IfCondition GreaterThan(ln, 40) ThenBlock: { more = 0 }
                            IfCondition EqualTo(more, 1) ThenBlock: { ln = Add(ln, 1) }
                        }
                        VFont_DrawString(dest, s, ln, cx, cy, col)
                    }
                    c = Add(c, 1)
                }
                FB_HLine(Add(x, 1), Subtract(Add(x, gw), 2), Subtract(Add(ry, rh), 1), FB_RGB(32, 48, 72))
            }
            r = Add(r, 1)
        }
        IfCondition EqualTo(TextGrid.NeedBar(), 1) ThenBlock: {
            bx = TextGrid.BarX()
            FB_FillRect(bx, y, TextGrid_State.sbw, h, FB_RGB(26, 42, 64))
            th = TextGrid.ThumbH()
            ty = TextGrid.ThumbY()
            FB_FillRect(Add(bx, 1), ty, Subtract(TextGrid_State.sbw, 2), th, FB_RGB(85, 136, 187))
        }
        ReturnValue(0)
    }
}
