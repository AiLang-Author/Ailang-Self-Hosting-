// Library.Trees.ailang
// Tree data structures with modern AILANG syntax
// AVL, Red-Black, B-Tree implementations

LibraryImport.Arrays

// ============================================================================
// AVL Tree Implementation
// ============================================================================

// Tree node structure: [key, value, left, right, height, parent]
Function.AVL.CreateNode {
    Input: key: Address
    Input: value: Address
    Output: Address
    Body: {
        node = Allocate(48)
        
        key_copy = Helpers.StringCopy(key)
        value_copy = Helpers.StringCopy(value)
        
        WRMEM_64(node, key_copy)
        WRMEM_64(node, 8, value_copy)
        WRMEM_64(node, 16, 0)  // left
        WRMEM_64(node, 24, 0)  // right
        WRMEM_64(node, 32, 1)  // height
        WRMEM_64(node, 40, 0)  // parent
        
        ReturnValue(node)
    }
}

// Create AVL tree: [root, size, compare_fn]
Function.AVL.Create {
    Output: Address
    Body: {
        tree = Allocate(24)
        WRMEM_64(tree, 0)  // root = null
        WRMEM_64(tree, 8, 0)  // size = 0
        WRMEM_64(tree, 16, 0)  // compare_fn = default string compare
        
        ReturnValue(tree)
    }
}

Function.AVL.GetHeight {
    Input: node: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: {
            ReturnValue(0)
        }
        ReturnValue(RDMEM_64(node, 32))
    }
}

Function.AVL.UpdateHeight {
    Input: node: Address
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: {
            ReturnValue()
        }
        
        left = RDMEM_64(node, 16)
        right = RDMEM_64(node, 24)
        
        left_height = AVL.GetHeight(left)
        right_height = AVL.GetHeight(right)
        
        max_height = left_height
        IfCondition GreaterThan(right_height, left_height) ThenBlock: {
            max_height = right_height
        }
        
        WRMEM_64(node, 32, Add(max_height, 1))
    }
}

Function.AVL.GetBalance {
    Input: node: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: {
            ReturnValue(0)
        }
        
        left = RDMEM_64(node, 16)
        right = RDMEM_64(node, 24)
        
        ReturnValue(Subtract(AVL.GetHeight(left), AVL.GetHeight(right)))
    }
}

Function.AVL.RotateRight {
    Input: tree: Address
    Input: y: Address
    Output: Address
    Body: {
        x = RDMEM_64(y, 16)  // y.left
        T2 = RDMEM_64(x, 24)  // x.right
        
        // Perform rotation
        WRMEM_64(x, 24, y)     // x.right = y
        WRMEM_64(y, 16, T2)    // y.left = T2
        
        // Update parents
        parent = RDMEM_64(y, 40)
        WRMEM_64(x, 40, parent)
        WRMEM_64(y, 40, x)
        
        IfCondition NotEqual(T2, 0) ThenBlock: {
            WRMEM_64(T2, 40, y)
        }
        
        // Update parent's child pointer
        IfCondition EqualTo(parent, 0) ThenBlock: {
            WRMEM_64(tree, x)  // x is new root
        } ElseBlock: {
            parent_left = RDMEM_64(parent, 16)
            IfCondition EqualTo(parent_left, y) ThenBlock: {
                WRMEM_64(parent, 16, x)
            } ElseBlock: {
                WRMEM_64(parent, 24, x)
            }
        }
        
        // Update heights
        AVL.UpdateHeight(y)
        AVL.UpdateHeight(x)
        
        ReturnValue(x)
    }
}

Function.AVL.RotateLeft {
    Input: tree: Address
    Input: x: Address
    Output: Address
    Body: {
        y = RDMEM_64(x, 24)   // x.right
        T2 = RDMEM_64(y, 16)  // y.left
        
        // Perform rotation
        WRMEM_64(y, 16, x)     // y.left = x
        WRMEM_64(x, 24, T2)    // x.right = T2
        
        // Update parents
        parent = RDMEM_64(x, 40)
        WRMEM_64(y, 40, parent)
        WRMEM_64(x, 40, y)
        
        IfCondition NotEqual(T2, 0) ThenBlock: {
            WRMEM_64(T2, 40, x)
        }
        
        // Update parent's child pointer
        IfCondition EqualTo(parent, 0) ThenBlock: {
            WRMEM_64(tree, y)  // y is new root
        } ElseBlock: {
            parent_left = RDMEM_64(parent, 16)
            IfCondition EqualTo(parent_left, x) ThenBlock: {
                WRMEM_64(parent, 16, y)
            } ElseBlock: {
                WRMEM_64(parent, 24, y)
            }
        }
        
        // Update heights
        AVL.UpdateHeight(x)
        AVL.UpdateHeight(y)
        
        ReturnValue(y)
    }
}

Function.AVL.Insert {
    Input: tree: Address
    Input: key: Address
    Input: value: Address
    Output: Integer
    Body: {
        root = RDMEM_64(tree)
        
        // Empty tree
        IfCondition EqualTo(root, 0) ThenBlock: {
            new_node = AVL.CreateNode(key, value)
            WRMEM_64(tree, new_node)
            
            size = RDMEM_64(tree, 8)
            WRMEM_64(tree, 8, Add(size, 1))
            
            ReturnValue(1)
        }
        
        // Find insertion point
        current = root
        parent = 0
        path = Array.Create(32)  // Track path for rebalancing
        
        WhileLoop NotEqual(current, 0) {
            Array.Push(path, current)
            parent = current
            
            current_key = RDMEM_64(current)
            cmp = StringCompare(key, current_key)
            
            IfCondition EqualTo(cmp, 0) ThenBlock: {
                // Key exists - update value
                old_value = RDMEM_64(current, 8)
                Deallocate(old_value, 0)
                
                new_value = Helpers.StringCopy(value)
                WRMEM_64(current, 8, new_value)
                
                Array.Destroy(path)
                ReturnValue(0)
            }
            
            IfCondition LessThan(cmp, 0) ThenBlock: {
                current = RDMEM_64(current, 16)
            } ElseBlock: {
                current = RDMEM_64(current, 24)
            }
        }
        
        // Create new node
        new_node = AVL.CreateNode(key, value)
        WRMEM_64(new_node, 40, parent)
        
        // Link to parent
        parent_key = RDMEM_64(parent)
        cmp = StringCompare(key, parent_key)
        
        IfCondition LessThan(cmp, 0) ThenBlock: {
            WRMEM_64(parent, 16, new_node)
        } ElseBlock: {
            WRMEM_64(parent, 24, new_node)
        }
        
        // Update size
        size = RDMEM_64(tree, 8)
        WRMEM_64(tree, 8, Add(size, 1))
        
        // Rebalance tree
        AVL.RebalanceAfterInsert(tree, path)
        
        Array.Destroy(path)
        ReturnValue(1)
    }
}

Function.AVL.RebalanceAfterInsert {
    Input: tree: Address
    Input: path: Address
    Body: {
        path_size = Array.Size(path)
        
        // Work up from insertion point
        i = Subtract(path_size, 1)
        WhileLoop GreaterEqual(i, 0) {
            node = Array.Get(path, i)
            
            AVL.UpdateHeight(node)
            balance = AVL.GetBalance(node)
            
            // Left-Left case
            IfCondition GreaterThan(balance, 1) ThenBlock: {
                left = RDMEM_64(node, 16)
                left_balance = AVL.GetBalance(left)
                
                IfCondition GreaterEqual(left_balance, 0) ThenBlock: {
                    AVL.RotateRight(tree, node)
                } ElseBlock: {
                    // Left-Right case
                    AVL.RotateLeft(tree, left)
                    AVL.RotateRight(tree, node)
                }
                BreakLoop
            }
            
            // Right-Right case
            IfCondition LessThan(balance, -1) ThenBlock: {
                right = RDMEM_64(node, 24)
                right_balance = AVL.GetBalance(right)
                
                IfCondition LessEqual(right_balance, 0) ThenBlock: {
                    AVL.RotateLeft(tree, node)
                } ElseBlock: {
                    // Right-Left case
                    AVL.RotateRight(tree, right)
                    AVL.RotateLeft(tree, node)
                }
                BreakLoop
            }
            
            i = Subtract(i, 1)
        }
    }
}

Function.AVL.Search {
    Input: tree: Address
    Input: key: Address
    Output: Address
    Body: {
        current = RDMEM_64(tree)
        
        WhileLoop NotEqual(current, 0) {
            current_key = RDMEM_64(current)
            cmp = StringCompare(key, current_key)
            
            IfCondition EqualTo(cmp, 0) ThenBlock: {
                ReturnValue(RDMEM_64(current, 8))
            }
            
            IfCondition LessThan(cmp, 0) ThenBlock: {
                current = RDMEM_64(current, 16)
            } ElseBlock: {
                current = RDMEM_64(current, 24)
            }
        }
        
        ReturnValue(0)
    }
}

// ============================================================================
// B-Tree Implementation
// ============================================================================

// B-Tree node: [is_leaf, num_keys, keys_array, values_array, children_array, parent]
Function.BTree.CreateNode {
    Input: order: Integer
    Input: is_leaf: Integer
    Output: Address
    Body: {
        node = Allocate(48)
        
        WRMEM_64(node, is_leaf)
        WRMEM_64(node, 8, 0)  // num_keys
        
        // Max keys = 2*order - 1
        max_keys = Subtract(Multiply(order, 2), 1)
        max_children = Multiply(order, 2)
        
        keys = ArrayCreate(max_keys)
        values = ArrayCreate(max_keys)
        children = ArrayCreate(max_children)
        
        WRMEM_64(node, 16, keys)
        WRMEM_64(node, 24, values)
        WRMEM_64(node, 32, children)
        WRMEM_64(node, 40, 0)  // parent
        
        ReturnValue(node)
    }
}

// B-Tree: [root, order, size]
Function.BTree.Create {
    Input: order: Integer
    Output: Address
    Body: {
        tree = Allocate(24)
        
        root = BTree.CreateNode(order, 1)  // Start with leaf
        
        WRMEM_64(tree, root)
        WRMEM_64(tree, 8, order)
        WRMEM_64(tree, 16, 0)  // size
        
        ReturnValue(tree)
    }
}

Function.BTree.Search {
    Input: node: Address
    Input: key: Address
    Output: Address
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: {
            ReturnValue(0)
        }
        
        num_keys = RDMEM_64(node, 8)
        keys_array = RDMEM_64(node, 16)
        values_array = RDMEM_64(node, 24)
        
        // Find key position
        i = 0
        WhileLoop LessThan(i, num_keys) {
            node_key = ArrayGet(keys_array, i)
            cmp = StringCompare(key, node_key)
            
            IfCondition EqualTo(cmp, 0) ThenBlock: {
                ReturnValue(ArrayGet(values_array, i))
            }
            
            IfCondition LessThan(cmp, 0) ThenBlock: {
                BreakLoop
            }
            
            i = Add(i, 1)
        }
        
        // If leaf, key not found
        is_leaf = RDMEM_64(node)
        IfCondition EqualTo(is_leaf, 1) ThenBlock: {
            ReturnValue(0)
        }
        
        // Search child
        children_array = RDMEM_64(node, 32)
        child = ArrayGet(children_array, i)
        
        ReturnValue(BTree.Search(child, key))
    }
}

Function.BTree.Insert {
    Input: tree: Address
    Input: key: Address
    Input: value: Address
    Output: Integer
    Body: {
        root = RDMEM_64(tree)
        order = RDMEM_64(tree, 8)
        
        // Check if root is full
        num_keys = RDMEM_64(root, 8)
        max_keys = Subtract(Multiply(order, 2), 1)
        
        IfCondition EqualTo(num_keys, max_keys) ThenBlock: {
            // Split root
            new_root = BTree.CreateNode(order, 0)
            WRMEM_64(tree, new_root)
            
            children_array = RDMEM_64(new_root, 32)
            ArraySet(children_array, 0, root)
            WRMEM_64(root, 40, new_root)
            
            BTree.SplitChild(new_root, 0, root, order)
            root = new_root
        }
        
        result = BTree.InsertNonFull(root, key, value, order)
        
        // Update size
        IfCondition EqualTo(result, 1) ThenBlock: {
            size = RDMEM_64(tree, 16)
            WRMEM_64(tree, 16, Add(size, 1))
        }
        
        ReturnValue(result)
    }
}

Function.BTree.InsertNonFull {
    Input: node: Address
    Input: key: Address
    Input: value: Address
    Input: order: Integer
    Output: Integer
    Body: {
        num_keys = RDMEM_64(node, 8)
        keys_array = RDMEM_64(node, 16)
        values_array = RDMEM_64(node, 24)
        
        // Find insertion position
        i = Subtract(num_keys, 1)
        
        is_leaf = RDMEM_64(node)
        IfCondition EqualTo(is_leaf, 1) ThenBlock: {
            // Leaf node - insert here
            WhileLoop GreaterEqual(i, 0) {
                node_key = ArrayGet(keys_array, i)
                cmp = StringCompare(key, node_key)
                
                IfCondition EqualTo(cmp, 0) ThenBlock: {
                    // Key exists - update
                    old_value = ArrayGet(values_array, i)
                    Deallocate(old_value, 0)
                    ArraySet(values_array, i, Helpers.StringCopy(value))
                    ReturnValue(0)
                }
                
                IfCondition GreaterThan(cmp, 0) ThenBlock: {
                    BreakLoop
                }
                
                // Shift right
                ArraySet(keys_array, Add(i, 1), node_key)
                ArraySet(values_array, Add(i, 1), ArrayGet(values_array, i))
                
                i = Subtract(i, 1)
            }
            
            // Insert new key-value
            ArraySet(keys_array, Add(i, 1), Helpers.StringCopy(key))
            ArraySet(values_array, Add(i, 1), Helpers.StringCopy(value))
            
            WRMEM_64(node, 8, Add(num_keys, 1))
            ReturnValue(1)
        }
        
        // Internal node - find child
        WhileLoop GreaterEqual(i, 0) {
            node_key = ArrayGet(keys_array, i)
            cmp = StringCompare(key, node_key)
            
            IfCondition GreaterThan(cmp, 0) ThenBlock: {
                BreakLoop
            }
            
            i = Subtract(i, 1)
        }
        
        i = Add(i, 1)
        children_array = RDMEM_64(node, 32)
        child = ArrayGet(children_array, i)
        
        // Check if child is full
        child_num_keys = RDMEM_64(child, 8)
        max_keys = Subtract(Multiply(order, 2), 1)
        
        IfCondition EqualTo(child_num_keys, max_keys) ThenBlock: {
            BTree.SplitChild(node, i, child, order)
            
            // Recalculate which child to use
            split_key = ArrayGet(keys_array, i)
            cmp = StringCompare(key, split_key)
            
            IfCondition GreaterThan(cmp, 0) ThenBlock: {
                i = Add(i, 1)
                child = ArrayGet(children_array, i)
            }
        }
        
        ReturnValue(BTree.InsertNonFull(child, key, value, order))
    }
}

Function.BTree.SplitChild {
    Input: parent: Address
    Input: index: Integer
    Input: child: Address
    Input: order: Integer
    Body: {
        // Create new node for right half
        new_node = BTree.CreateNode(order, RDMEM_64(child))
        
        // Get arrays
        child_keys = RDMEM_64(child, 16)
        child_values = RDMEM_64(child, 24)
        new_keys = RDMEM_64(new_node, 16)
        new_values = RDMEM_64(new_node, 24)
        
        mid = Subtract(order, 1)
        
        // Copy right half of keys/values to new node
        j = 0
        WhileLoop LessThan(j, Subtract(order, 1)) {
            ArraySet(new_keys, j, ArrayGet(child_keys, Add(j, Add(mid, 1))))
            ArraySet(new_values, j, ArrayGet(child_values, Add(j, Add(mid, 1))))
            j = Add(j, 1)
        }
        
        // If not leaf, copy children
        is_leaf = RDMEM_64(child)
        IfCondition EqualTo(is_leaf, 0) ThenBlock: {
            child_children = RDMEM_64(child, 32)
            new_children = RDMEM_64(new_node, 32)
            
            j = 0
            WhileLoop LessEqual(j, Subtract(order, 1)) {
                moved_child = ArrayGet(child_children, Add(j, Add(mid, 1)))
                ArraySet(new_children, j, moved_child)
                
                // Update parent pointer
                IfCondition NotEqual(moved_child, 0) ThenBlock: {
                    WRMEM_64(moved_child, 40, new_node)
                }
                
                j = Add(j, 1)
            }
        }
        
        // Update counts
        WRMEM_64(child, 8, mid)
        WRMEM_64(new_node, 8, Subtract(order, 1))
        
        // Insert middle key into parent
        parent_keys = RDMEM_64(parent, 16)
        parent_values = RDMEM_64(parent, 24)
        parent_children = RDMEM_64(parent, 32)
        parent_num_keys = RDMEM_64(parent, 8)
        
        // Shift parent's keys/children right
        i = parent_num_keys
        WhileLoop GreaterThan(i, index) {
            ArraySet(parent_keys, i, ArrayGet(parent_keys, Subtract(i, 1)))
            ArraySet(parent_values, i, ArrayGet(parent_values, Subtract(i, 1)))
            ArraySet(parent_children, Add(i, 1), ArrayGet(parent_children, i))
            i = Subtract(i, 1)
        }
        
        // Insert median
        ArraySet(parent_keys, index, ArrayGet(child_keys, mid))
        ArraySet(parent_values, index, ArrayGet(child_values, mid))
        ArraySet(parent_children, Add(index, 1), new_node)
        
        WRMEM_64(parent, 8, Add(parent_num_keys, 1))
        WRMEM_64(new_node, 40, parent)
    }
}