// ============================================
// Library.TuiWidget.ailang
// Panes, drawing, color, and widgets for TUI apps.
// Requires: Library.TUI.ailang
// Import as: LibraryImport.TuiWidget
// ============================================

// ============================================
// LAYOUT — pane management, scroll regions, cursor ops
// ============================================

FixedPool.TUI_Layout_Config {
    "MAX_PANES":  Initialize=8
    "STRIDE":     Initialize=16
    "F_X":        Initialize=0
    "F_Y":        Initialize=2
    "F_W":        Initialize=4
    "F_H":        Initialize=6
    "F_STOP":     Initialize=8
    "F_SBOT":     Initialize=10
    "F_FLAGS":    Initialize=12
    "FL_ACTIVE":  Initialize=1
    "FL_SCROLL":  Initialize=2
    "BUF_SIZE":   Initialize=128
}

FixedPool.TUI_Layout_State {
    "panes":  Initialize=0
    "active": Initialize=-1
}

FixedPool.TUI_Pane {
    "SIDEBAR": Initialize=0
    "CHAT":    Initialize=1
    "DETAIL":  Initialize=2
    "PROMPT":  Initialize=3
}

Function.TUI_Layout_Init {
    Body: {
        TUI_Layout_State.panes = Allocate(TUI_Layout_Config.BUF_SIZE)
        i = 0
        WhileLoop LessThan(i, TUI_Layout_Config.BUF_SIZE) {
            SetByte(TUI_Layout_State.panes, i, 0)
            i = Add(i, 1)
        }
        TUI_Layout_State.active = -1
        ReturnValue(0)
    }
}

Function.TUI_Layout_Shutdown {
    Body: {
        IfCondition NotEqual(TUI_Layout_State.panes, 0) ThenBlock: {
            Deallocate(TUI_Layout_State.panes, TUI_Layout_Config.BUF_SIZE)
            TUI_Layout_State.panes = 0
        }
        ReturnValue(0)
    }
}

Function.TUI_Layout_WF {
    Input: id: Integer
    Input: field: Integer
    Input: val: Integer
    Body: {
        off = Add(Multiply(id, TUI_Layout_Config.STRIDE), field)
        SetByte(TUI_Layout_State.panes, off,           BitwiseAnd(val, 255))
        SetByte(TUI_Layout_State.panes, Add(off, 1),   BitwiseAnd(RightShift(val, 8), 255))
        ReturnValue(0)
    }
}

Function.TUI_Layout_RF {
    Input: id: Integer
    Input: field: Integer
    Output: Integer
    Body: {
        off = Add(Multiply(id, TUI_Layout_Config.STRIDE), field)
        lo  = GetByte(TUI_Layout_State.panes, off)
        hi  = GetByte(TUI_Layout_State.panes, Add(off, 1))
        ReturnValue(Add(lo, Multiply(hi, 256)))
    }
}

Function.TUI_Layout_SetPane {
    Input: id: Integer
    Input: x: Integer
    Input: y: Integer
    Input: w: Integer
    Input: h: Integer
    Body: {
        TUI_Layout_WF(id, TUI_Layout_Config.F_X, x)
        TUI_Layout_WF(id, TUI_Layout_Config.F_Y, y)
        TUI_Layout_WF(id, TUI_Layout_Config.F_W, w)
        TUI_Layout_WF(id, TUI_Layout_Config.F_H, h)
        TUI_Layout_WF(id, TUI_Layout_Config.F_STOP, y)
        TUI_Layout_WF(id, TUI_Layout_Config.F_SBOT, Add(y, Subtract(h, 1)))
        ReturnValue(0)
    }
}

Function.TUI_Layout_SetScroll {
    Input: id: Integer
    Input: stop: Integer
    Input: sbot: Integer
    Body: {
        TUI_Layout_WF(id, TUI_Layout_Config.F_STOP, stop)
        TUI_Layout_WF(id, TUI_Layout_Config.F_SBOT, sbot)
        ReturnValue(0)
    }
}

Function.TUI_Layout_GetX {
    Input: id: Integer
    Output: Integer
    Body: { ReturnValue(TUI_Layout_RF(id, TUI_Layout_Config.F_X)) }
}

Function.TUI_Layout_GetY {
    Input: id: Integer
    Output: Integer
    Body: { ReturnValue(TUI_Layout_RF(id, TUI_Layout_Config.F_Y)) }
}

Function.TUI_Layout_GetW {
    Input: id: Integer
    Output: Integer
    Body: { ReturnValue(TUI_Layout_RF(id, TUI_Layout_Config.F_W)) }
}

Function.TUI_Layout_GetH {
    Input: id: Integer
    Output: Integer
    Body: { ReturnValue(TUI_Layout_RF(id, TUI_Layout_Config.F_H)) }
}

// ESC [ top ; bot r
Function.TUI_SetScrollRegion {
    Input: top: Integer
    Input: bot: Integer
    Body: {
        TUI_BufferChar(27)
        TUI_BufferChar(91)
        TUI_WriteNum(top)
        TUI_BufferChar(59)
        TUI_WriteNum(bot)
        TUI_BufferChar(114)
        ReturnValue(0)
    }
}

// ESC [ r
Function.TUI_ClearScrollRegion {
    Body: {
        TUI_BufferChar(27)
        TUI_BufferWriteStr("[r")
        ReturnValue(0)
    }
}

// ESC 7
Function.TUI_SaveCursor {
    Body: {
        TUI_BufferChar(27)
        TUI_BufferChar(55)
        ReturnValue(0)
    }
}

// ESC 8
Function.TUI_RestoreCursor {
    Body: {
        TUI_BufferChar(27)
        TUI_BufferChar(56)
        ReturnValue(0)
    }
}

// ESC [ K
Function.TUI_EraseToEOL {
    Body: {
        TUI_BufferChar(27)
        TUI_BufferWriteStr("[K")
        ReturnValue(0)
    }
}

// ESC [ J
Function.TUI_EraseDown {
    Body: {
        TUI_BufferChar(27)
        TUI_BufferWriteStr("[J")
        ReturnValue(0)
    }
}

// ESC [ 1 J
Function.TUI_EraseUp {
    Body: {
        TUI_BufferChar(27)
        TUI_BufferWriteStr("[1J")
        ReturnValue(0)
    }
}

Function.TUI_Layout_Activate {
    Input: id: Integer
    Body: {
        stop = TUI_Layout_RF(id, TUI_Layout_Config.F_STOP)
        sbot = TUI_Layout_RF(id, TUI_Layout_Config.F_SBOT)
        TUI_SetScrollRegion(stop, sbot)
        TUI_Layout_State.active = id
        ReturnValue(0)
    }
}

Function.TUI_Layout_Deactivate {
    Body: {
        TUI_ClearScrollRegion()
        TUI_Layout_State.active = -1
        ReturnValue(0)
    }
}

Function.TUI_Layout_MoveTo {
    Input: id: Integer
    Input: row: Integer
    Input: col: Integer
    Body: {
        px = TUI_Layout_RF(id, TUI_Layout_Config.F_X)
        py = TUI_Layout_RF(id, TUI_Layout_Config.F_Y)
        TUI_MoveTo(Add(py, row), Add(px, col))
        ReturnValue(0)
    }
}

Function.TUI_Layout_MoveToBottom {
    Input: id: Integer
    Body: {
        px   = TUI_Layout_RF(id, TUI_Layout_Config.F_X)
        sbot = TUI_Layout_RF(id, TUI_Layout_Config.F_SBOT)
        TUI_MoveTo(sbot, px)
        ReturnValue(0)
    }
}

// ============================================
// DRAW — unicode box chars, line/box primitives, clipped print
// ============================================

FixedPool.TUI_Draw_Style {
    "ASCII":  Initialize=0
    "SINGLE": Initialize=1
    "DOUBLE": Initialize=2
    "ROUND":  Initialize=3
}

FixedPool.TUI_Draw_State {
    "style": Initialize=1
}

Function.TUI_Draw_SetStyle {
    Input: style: Integer
    Body: {
        TUI_Draw_State.style = style
        ReturnValue(0)
    }
}

Function.TUI_Draw_H {
    Body: {
        IfCondition EqualTo(TUI_Draw_State.style, TUI_Draw_Style.ASCII) ThenBlock: {
            TUI_BufferChar(45)
            ReturnValue(0)
        }
        IfCondition EqualTo(TUI_Draw_State.style, TUI_Draw_Style.DOUBLE) ThenBlock: {
            TUI_BufferChar(226) TUI_BufferChar(149) TUI_BufferChar(144)
            ReturnValue(0)
        }
        TUI_BufferChar(226) TUI_BufferChar(148) TUI_BufferChar(128)
        ReturnValue(0)
    }
}

Function.TUI_Draw_V {
    Body: {
        IfCondition EqualTo(TUI_Draw_State.style, TUI_Draw_Style.ASCII) ThenBlock: {
            TUI_BufferChar(124)
            ReturnValue(0)
        }
        IfCondition EqualTo(TUI_Draw_State.style, TUI_Draw_Style.DOUBLE) ThenBlock: {
            TUI_BufferChar(226) TUI_BufferChar(149) TUI_BufferChar(145)
            ReturnValue(0)
        }
        TUI_BufferChar(226) TUI_BufferChar(148) TUI_BufferChar(130)
        ReturnValue(0)
    }
}

Function.TUI_Draw_TL {
    Body: {
        IfCondition EqualTo(TUI_Draw_State.style, TUI_Draw_Style.ASCII)  ThenBlock: { TUI_BufferChar(43) ReturnValue(0) }
        IfCondition EqualTo(TUI_Draw_State.style, TUI_Draw_Style.DOUBLE) ThenBlock: { TUI_BufferChar(226) TUI_BufferChar(149) TUI_BufferChar(148) ReturnValue(0) }
        IfCondition EqualTo(TUI_Draw_State.style, TUI_Draw_Style.ROUND)  ThenBlock: { TUI_BufferChar(226) TUI_BufferChar(149) TUI_BufferChar(173) ReturnValue(0) }
        TUI_BufferChar(226) TUI_BufferChar(148) TUI_BufferChar(140)
        ReturnValue(0)
    }
}

Function.TUI_Draw_TR {
    Body: {
        IfCondition EqualTo(TUI_Draw_State.style, TUI_Draw_Style.ASCII)  ThenBlock: { TUI_BufferChar(43) ReturnValue(0) }
        IfCondition EqualTo(TUI_Draw_State.style, TUI_Draw_Style.DOUBLE) ThenBlock: { TUI_BufferChar(226) TUI_BufferChar(149) TUI_BufferChar(151) ReturnValue(0) }
        IfCondition EqualTo(TUI_Draw_State.style, TUI_Draw_Style.ROUND)  ThenBlock: { TUI_BufferChar(226) TUI_BufferChar(149) TUI_BufferChar(174) ReturnValue(0) }
        TUI_BufferChar(226) TUI_BufferChar(148) TUI_BufferChar(144)
        ReturnValue(0)
    }
}

Function.TUI_Draw_BL {
    Body: {
        IfCondition EqualTo(TUI_Draw_State.style, TUI_Draw_Style.ASCII)  ThenBlock: { TUI_BufferChar(43) ReturnValue(0) }
        IfCondition EqualTo(TUI_Draw_State.style, TUI_Draw_Style.DOUBLE) ThenBlock: { TUI_BufferChar(226) TUI_BufferChar(149) TUI_BufferChar(154) ReturnValue(0) }
        IfCondition EqualTo(TUI_Draw_State.style, TUI_Draw_Style.ROUND)  ThenBlock: { TUI_BufferChar(226) TUI_BufferChar(149) TUI_BufferChar(176) ReturnValue(0) }
        TUI_BufferChar(226) TUI_BufferChar(148) TUI_BufferChar(148)
        ReturnValue(0)
    }
}

Function.TUI_Draw_BR {
    Body: {
        IfCondition EqualTo(TUI_Draw_State.style, TUI_Draw_Style.ASCII)  ThenBlock: { TUI_BufferChar(43) ReturnValue(0) }
        IfCondition EqualTo(TUI_Draw_State.style, TUI_Draw_Style.DOUBLE) ThenBlock: { TUI_BufferChar(226) TUI_BufferChar(149) TUI_BufferChar(157) ReturnValue(0) }
        IfCondition EqualTo(TUI_Draw_State.style, TUI_Draw_Style.ROUND)  ThenBlock: { TUI_BufferChar(226) TUI_BufferChar(149) TUI_BufferChar(175) ReturnValue(0) }
        TUI_BufferChar(226) TUI_BufferChar(148) TUI_BufferChar(152)
        ReturnValue(0)
    }
}

Function.TUI_Draw_LJ {
    Body: {
        IfCondition EqualTo(TUI_Draw_State.style, TUI_Draw_Style.ASCII) ThenBlock: { TUI_BufferChar(43) ReturnValue(0) }
        TUI_BufferChar(226) TUI_BufferChar(148) TUI_BufferChar(156)
        ReturnValue(0)
    }
}

Function.TUI_Draw_RJ {
    Body: {
        IfCondition EqualTo(TUI_Draw_State.style, TUI_Draw_Style.ASCII) ThenBlock: { TUI_BufferChar(43) ReturnValue(0) }
        TUI_BufferChar(226) TUI_BufferChar(148) TUI_BufferChar(164)
        ReturnValue(0)
    }
}

Function.TUI_Draw_TJ {
    Body: {
        IfCondition EqualTo(TUI_Draw_State.style, TUI_Draw_Style.ASCII) ThenBlock: { TUI_BufferChar(43) ReturnValue(0) }
        TUI_BufferChar(226) TUI_BufferChar(148) TUI_BufferChar(172)
        ReturnValue(0)
    }
}

Function.TUI_Draw_BJ {
    Body: {
        IfCondition EqualTo(TUI_Draw_State.style, TUI_Draw_Style.ASCII) ThenBlock: { TUI_BufferChar(43) ReturnValue(0) }
        TUI_BufferChar(226) TUI_BufferChar(148) TUI_BufferChar(180)
        ReturnValue(0)
    }
}

Function.TUI_Draw_Cross {
    Body: {
        IfCondition EqualTo(TUI_Draw_State.style, TUI_Draw_Style.ASCII) ThenBlock: { TUI_BufferChar(43) ReturnValue(0) }
        TUI_BufferChar(226) TUI_BufferChar(148) TUI_BufferChar(188)
        ReturnValue(0)
    }
}

Function.TUI_Draw_HLine {
    Input: row: Integer
    Input: col: Integer
    Input: len: Integer
    Body: {
        TUI_MoveTo(row, col)
        i = 0
        WhileLoop LessThan(i, len) {
            TUI_Draw_H()
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

Function.TUI_Draw_VLine {
    Input: row: Integer
    Input: col: Integer
    Input: len: Integer
    Body: {
        i = 0
        WhileLoop LessThan(i, len) {
            TUI_MoveTo(Add(row, i), col)
            TUI_Draw_V()
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

Function.TUI_Draw_Box {
    Input: row: Integer
    Input: col: Integer
    Input: h: Integer
    Input: w: Integer
    Body: {
        TUI_MoveTo(row, col)
        TUI_Draw_TL()
        i = 0
        WhileLoop LessThan(i, Subtract(w, 2)) { TUI_Draw_H() i = Add(i, 1) }
        TUI_Draw_TR()
        i = 1
        WhileLoop LessThan(i, Subtract(h, 1)) {
            TUI_MoveTo(Add(row, i), col)
            TUI_Draw_V()
            TUI_MoveTo(Add(row, i), Add(col, Subtract(w, 1)))
            TUI_Draw_V()
            i = Add(i, 1)
        }
        TUI_MoveTo(Add(row, Subtract(h, 1)), col)
        TUI_Draw_BL()
        i = 0
        WhileLoop LessThan(i, Subtract(w, 2)) { TUI_Draw_H() i = Add(i, 1) }
        TUI_Draw_BR()
        ReturnValue(0)
    }
}

Function.TUI_Draw_Fill {
    Input: row: Integer
    Input: col: Integer
    Input: h: Integer
    Input: w: Integer
    Input: ch: Integer
    Body: {
        r = 0
        WhileLoop LessThan(r, h) {
            TUI_MoveTo(Add(row, r), col)
            c = 0
            WhileLoop LessThan(c, w) { TUI_BufferChar(ch) c = Add(c, 1) }
            r = Add(r, 1)
        }
        ReturnValue(0)
    }
}

Function.TUI_Draw_PrintClipped {
    Input: row: Integer
    Input: col: Integer
    Input: str: Address
    Input: max_w: Integer
    Body: {
        TUI_MoveTo(row, col)
        i = 0
        written = 0
        WhileLoop 1 {
            ch = GetByte(str, i)
            IfCondition EqualTo(ch, 0) ThenBlock: { BreakLoop }
            IfCondition GreaterEqual(written, max_w) ThenBlock: { BreakLoop }
            TUI_BufferChar(ch)
            i = Add(i, 1)
            written = Add(written, 1)
        }
        WhileLoop LessThan(written, max_w) { TUI_BufferChar(32) written = Add(written, 1) }
        ReturnValue(0)
    }
}

Function.TUI_Draw_Divider {
    Input: row: Integer
    Input: col: Integer
    Input: w: Integer
    Input: label: Address
    Body: {
        TUI_MoveTo(row, col)
        IfCondition EqualTo(label, 0) ThenBlock: {
            i = 0
            WhileLoop LessThan(i, w) { TUI_Draw_H() i = Add(i, 1) }
            ReturnValue(0)
        }
        TUI_Draw_LJ()
        TUI_BufferChar(32)
        used = 2
        i = 0
        WhileLoop 1 {
            ch = GetByte(label, i)
            IfCondition EqualTo(ch, 0) ThenBlock: { BreakLoop }
            IfCondition GreaterEqual(Add(used, 2), w) ThenBlock: { BreakLoop }
            TUI_BufferChar(ch)
            i = Add(i, 1)
            used = Add(used, 1)
        }
        TUI_BufferChar(32)
        used = Add(used, 1)
        WhileLoop LessThan(used, w) { TUI_Draw_H() used = Add(used, 1) }
        ReturnValue(0)
    }
}

// ============================================
// COLOR — 256-color, truecolor, named palette
// ============================================

FixedPool.TUI_Palette {
    "DIFF_ADD":       Initialize=71
    "DIFF_DEL":       Initialize=167
    "DIFF_HUNK":      Initialize=37
    "DIFF_ADD_BG":    Initialize=22
    "DIFF_DEL_BG":    Initialize=52
    "DIFF_LINE_NUM":  Initialize=242

    "SIDEBAR_DIM":    Initialize=240
    "SIDEBAR_ACTIVE": Initialize=255
    "SIDEBAR_DIRTY":  Initialize=214
    "SIDEBAR_DIR":    Initialize=75
    "SIDEBAR_SEL_BG": Initialize=237

    "TOOL_RUNNING":   Initialize=220
    "TOOL_OK":        Initialize=76
    "TOOL_ERR":       Initialize=196
    "TOOL_DIM":       Initialize=238
    "TOOL_HDR_BG":    Initialize=235

    "PROMPT_IDLE":    Initialize=214
    "PROMPT_WAIT":    Initialize=196
    "PROMPT_DONE":    Initialize=76

    "ACCENT":         Initialize=39
    "MUTED":          Initialize=243
    "BORDER":         Initialize=236
}

Function.TUI_Color256_FG {
    Input: n: Integer
    Body: {
        TUI_BufferChar(27)
        TUI_BufferWriteStr("[38;5;")
        TUI_WriteNum(n)
        TUI_BufferChar(109)
        ReturnValue(0)
    }
}

Function.TUI_Color256_BG {
    Input: n: Integer
    Body: {
        TUI_BufferChar(27)
        TUI_BufferWriteStr("[48;5;")
        TUI_WriteNum(n)
        TUI_BufferChar(109)
        ReturnValue(0)
    }
}

Function.TUI_Color256 {
    Input: fg: Integer
    Input: bg: Integer
    Body: {
        TUI_Color256_FG(fg)
        TUI_Color256_BG(bg)
        ReturnValue(0)
    }
}

Function.TUI_ColorRGB_FG {
    Input: r: Integer
    Input: g: Integer
    Input: b: Integer
    Body: {
        TUI_BufferChar(27)
        TUI_BufferWriteStr("[38;2;")
        TUI_WriteNum(r) TUI_BufferChar(59)
        TUI_WriteNum(g) TUI_BufferChar(59)
        TUI_WriteNum(b) TUI_BufferChar(109)
        ReturnValue(0)
    }
}

Function.TUI_ColorRGB_BG {
    Input: r: Integer
    Input: g: Integer
    Input: b: Integer
    Body: {
        TUI_BufferChar(27)
        TUI_BufferWriteStr("[48;2;")
        TUI_WriteNum(r) TUI_BufferChar(59)
        TUI_WriteNum(g) TUI_BufferChar(59)
        TUI_WriteNum(b) TUI_BufferChar(109)
        ReturnValue(0)
    }
}

Function.TUI_Color_DiffAdd      { Body: { TUI_Color256_FG(TUI_Palette.DIFF_ADD)    TUI_Color256_BG(TUI_Palette.DIFF_ADD_BG)  ReturnValue(0) } }
Function.TUI_Color_DiffDel      { Body: { TUI_Color256_FG(TUI_Palette.DIFF_DEL)    TUI_Color256_BG(TUI_Palette.DIFF_DEL_BG)  ReturnValue(0) } }
Function.TUI_Color_DiffHunk     { Body: { TUI_Color256_FG(TUI_Palette.DIFF_HUNK)   ReturnValue(0) } }
Function.TUI_Color_DiffLineNum  { Body: { TUI_Color256_FG(TUI_Palette.DIFF_LINE_NUM) ReturnValue(0) } }
Function.TUI_Color_SidebarDim   { Body: { TUI_Color256_FG(TUI_Palette.SIDEBAR_DIM) ReturnValue(0) } }
Function.TUI_Color_SidebarActive { Body: { TUI_Color256_FG(TUI_Palette.SIDEBAR_ACTIVE) ReturnValue(0) } }
Function.TUI_Color_SidebarDirty { Body: { TUI_Color256_FG(TUI_Palette.SIDEBAR_DIRTY) ReturnValue(0) } }
Function.TUI_Color_SidebarDir   { Body: { TUI_Color256_FG(TUI_Palette.SIDEBAR_DIR) ReturnValue(0) } }
Function.TUI_Color_SidebarSelected { Body: { TUI_Color256_FG(TUI_Palette.SIDEBAR_ACTIVE) TUI_Color256_BG(TUI_Palette.SIDEBAR_SEL_BG) ReturnValue(0) } }
Function.TUI_Color_ToolRunning  { Body: { TUI_Color256_FG(TUI_Palette.TOOL_RUNNING) ReturnValue(0) } }
Function.TUI_Color_ToolOK       { Body: { TUI_Color256_FG(TUI_Palette.TOOL_OK)     ReturnValue(0) } }
Function.TUI_Color_ToolErr      { Body: { TUI_Color256_FG(TUI_Palette.TOOL_ERR)    ReturnValue(0) } }
Function.TUI_Color_ToolDim      { Body: { TUI_Color256_FG(TUI_Palette.TOOL_DIM)    ReturnValue(0) } }
Function.TUI_Color_ToolHeader   { Body: { TUI_Color256_FG(TUI_Palette.MUTED) TUI_Color256_BG(TUI_Palette.TOOL_HDR_BG) ReturnValue(0) } }
Function.TUI_Color_PromptIdle   { Body: { TUI_Color256_FG(TUI_Palette.PROMPT_IDLE) ReturnValue(0) } }
Function.TUI_Color_PromptWait   { Body: { TUI_Color256_FG(TUI_Palette.PROMPT_WAIT) ReturnValue(0) } }
Function.TUI_Color_PromptDone   { Body: { TUI_Color256_FG(TUI_Palette.PROMPT_DONE) ReturnValue(0) } }
Function.TUI_Color_Accent       { Body: { TUI_Color256_FG(TUI_Palette.ACCENT)      ReturnValue(0) } }
Function.TUI_Color_Border       { Body: { TUI_Color256_FG(TUI_Palette.BORDER)      ReturnValue(0) } }
Function.TUI_Color_Muted        { Body: { TUI_Color256_FG(TUI_Palette.MUTED)       ReturnValue(0) } }

// ============================================
// WIDGETS — center text, status bar, progress bar,
//           file tree sidebar, tool block list
// ============================================

Function.TUI_CenterText {
    Input: row: Integer
    Input: text: Address
    Input: width: Integer
    Body: {
        len = 0
        WhileLoop NotEqual(GetByte(text, len), 0) { len = Add(len, 1) }
        col = Divide(Subtract(width, len), 2)
        IfCondition LessThan(col, 1) ThenBlock: { col = 1 }
        TUI_PrintAt(row, col, text)
        ReturnValue(0)
    }
}

Function.TUI_StatusBar {
    Input: text: Address
    Input: row: Integer
    Input: width: Integer
    Body: {
        TUI_MoveTo(row, 1)
        TUI_Reverse()
        TUI_Print(text)
        len = 0
        WhileLoop NotEqual(GetByte(text, len), 0) { len = Add(len, 1) }
        i = len
        WhileLoop LessThan(i, width) { TUI_BufferChar(32) i = Add(i, 1) }
        TUI_ResetColor()
        ReturnValue(0)
    }
}

Function.TUI_ProgressBar {
    Input: row: Integer
    Input: col: Integer
    Input: width: Integer
    Input: percent: Integer
    Body: {
        TUI_MoveTo(row, col)
        TUI_BufferChar(91)
        inner  = Subtract(width, 2)
        filled = Divide(Multiply(inner, percent), 100)
        i = 0
        WhileLoop LessThan(i, inner) {
            IfCondition LessThan(i, filled) ThenBlock: { TUI_BufferChar(35) }
            ElseBlock: { TUI_BufferChar(45) }
            i = Add(i, 1)
        }
        TUI_BufferChar(93)
        ReturnValue(0)
    }
}

// ── File Tree Widget ─────────────────────────────────
//
// Entry layout (68 bytes, 32 entries = 2176 bytes):
//   path[64]  depth(1)  flags(1)  pad[2]
//   FL_DIRTY=1  FL_EXPAND=2  FL_SEL=4  FL_DIR=8

FixedPool.TUI_Tree_Config {
    "MAX":       Initialize=32
    "STRIDE":    Initialize=68
    "F_PATH":    Initialize=0
    "PATH_LEN":  Initialize=64
    "F_DEPTH":   Initialize=64
    "F_FLAGS":   Initialize=65
    "FL_DIRTY":  Initialize=1
    "FL_EXPAND": Initialize=2
    "FL_SEL":    Initialize=4
    "FL_DIR":    Initialize=8
    "BUF_SIZE":  Initialize=2176
}

FixedPool.TUI_Tree_State {
    "entries":  Initialize=0
    "count":    Initialize=0
    "scroll":   Initialize=0
    "selected": Initialize=0
}

Function.TUI_Tree_Init {
    Body: {
        TUI_Tree_State.entries = Allocate(TUI_Tree_Config.BUF_SIZE)
        i = 0
        WhileLoop LessThan(i, TUI_Tree_Config.BUF_SIZE) {
            SetByte(TUI_Tree_State.entries, i, 0)
            i = Add(i, 1)
        }
        TUI_Tree_State.count    = 0
        TUI_Tree_State.scroll   = 0
        TUI_Tree_State.selected = 0
        ReturnValue(0)
    }
}

Function.TUI_Tree_Shutdown {
    Body: {
        IfCondition NotEqual(TUI_Tree_State.entries, 0) ThenBlock: {
            Deallocate(TUI_Tree_State.entries, TUI_Tree_Config.BUF_SIZE)
            TUI_Tree_State.entries = 0
        }
        ReturnValue(0)
    }
}

Function.TUI_Tree_Clear {
    Body: { TUI_Tree_State.count = 0  TUI_Tree_State.scroll = 0  ReturnValue(0) }
}

Function.TUI_Tree_Add {
    Input: path: Address
    Input: depth: Integer
    Input: flags: Integer
    Output: Integer
    Body: {
        idx = TUI_Tree_State.count
        IfCondition GreaterEqual(idx, TUI_Tree_Config.MAX) ThenBlock: { ReturnValue(-1) }
        base = Add(TUI_Tree_State.entries, Multiply(idx, TUI_Tree_Config.STRIDE))
        i = 0
        WhileLoop LessThan(i, Subtract(TUI_Tree_Config.PATH_LEN, 1)) {
            ch = GetByte(path, i)
            SetByte(base, Add(TUI_Tree_Config.F_PATH, i), ch)
            IfCondition EqualTo(ch, 0) ThenBlock: { BreakLoop }
            i = Add(i, 1)
        }
        SetByte(base, Add(TUI_Tree_Config.F_PATH, i), 0)
        SetByte(base, TUI_Tree_Config.F_DEPTH, depth)
        SetByte(base, TUI_Tree_Config.F_FLAGS, flags)
        TUI_Tree_State.count = Add(idx, 1)
        ReturnValue(idx)
    }
}

Function.TUI_Tree_MarkDirty {
    Input: path: Address
    Body: {
        i = 0
        WhileLoop LessThan(i, TUI_Tree_State.count) {
            base       = Add(TUI_Tree_State.entries, Multiply(i, TUI_Tree_Config.STRIDE))
            entry_path = Add(base, TUI_Tree_Config.F_PATH)
            j = 0  match = 1
            WhileLoop 1 {
                ec = GetByte(entry_path, j)
                pc = GetByte(path, j)
                IfCondition NotEqual(ec, pc) ThenBlock: { match = 0  BreakLoop }
                IfCondition EqualTo(ec, 0)   ThenBlock: { BreakLoop }
                j = Add(j, 1)
            }
            IfCondition EqualTo(match, 1) ThenBlock: {
                old = GetByte(base, TUI_Tree_Config.F_FLAGS)
                SetByte(base, TUI_Tree_Config.F_FLAGS, BitwiseOr(old, TUI_Tree_Config.FL_DIRTY))
            }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

Function.TUI_Tree_SetSelected {
    Input: idx: Integer
    Body: { TUI_Tree_State.selected = idx  ReturnValue(0) }
}

Function.TUI_Tree_Scroll {
    Input: delta: Integer
    Body: {
        s = Add(TUI_Tree_State.scroll, delta)
        IfCondition LessThan(s, 0) ThenBlock: { s = 0 }
        max = Subtract(TUI_Tree_State.count, 1)
        IfCondition GreaterThan(s, max) ThenBlock: { s = max }
        TUI_Tree_State.scroll = s
        ReturnValue(0)
    }
}

// Render tree into pane. Wrap with TUI_SaveCursor/TUI_RestoreCursor
// when refreshing the sidebar mid-stream; flush once after restore.
// ▸ collapsed = E2 96 B8   ▾ expanded = E2 96 BE
Function.TUI_Tree_Render {
    Input: pane_id: Integer
    Body: {
        px  = TUI_Layout_GetX(pane_id)
        py  = TUI_Layout_GetY(pane_id)
        pw  = TUI_Layout_GetW(pane_id)
        ph  = TUI_Layout_GetH(pane_id)
        sel = TUI_Tree_State.selected
        row = 0
        idx = TUI_Tree_State.scroll

        WhileLoop And(LessThan(row, ph), LessThan(idx, TUI_Tree_State.count)) {
            base       = Add(TUI_Tree_State.entries, Multiply(idx, TUI_Tree_Config.STRIDE))
            depth      = GetByte(base, TUI_Tree_Config.F_DEPTH)
            flags      = GetByte(base, TUI_Tree_Config.F_FLAGS)
            entry_path = Add(base, TUI_Tree_Config.F_PATH)

            IfCondition EqualTo(idx, sel) ThenBlock: {
                TUI_Color_SidebarSelected()
            } ElseBlock: {
                IfCondition NotEqual(BitwiseAnd(flags, TUI_Tree_Config.FL_DIRTY), 0) ThenBlock: {
                    TUI_Color_SidebarDirty()
                } ElseBlock: {
                    IfCondition NotEqual(BitwiseAnd(flags, TUI_Tree_Config.FL_DIR), 0) ThenBlock: {
                        TUI_Color_SidebarDir()
                    } ElseBlock: {
                        TUI_Color_SidebarDim()
                    }
                }
            }

            TUI_MoveTo(Add(py, row), px)
            indent = Multiply(depth, 2)
            avail  = pw
            i = 0
            WhileLoop And(LessThan(i, indent), GreaterThan(avail, 0)) {
                TUI_BufferChar(32)
                i     = Add(i, 1)
                avail = Subtract(avail, 1)
            }

            IfCondition NotEqual(BitwiseAnd(flags, TUI_Tree_Config.FL_DIR), 0) ThenBlock: {
                IfCondition NotEqual(BitwiseAnd(flags, TUI_Tree_Config.FL_EXPAND), 0) ThenBlock: {
                    TUI_BufferChar(226) TUI_BufferChar(150) TUI_BufferChar(190)  // ▾
                } ElseBlock: {
                    TUI_BufferChar(226) TUI_BufferChar(150) TUI_BufferChar(184)  // ▸
                }
                TUI_BufferChar(32)
                avail = Subtract(avail, 2)
            }

            i = 0
            WhileLoop GreaterThan(avail, 0) {
                ch = GetByte(entry_path, i)
                IfCondition EqualTo(ch, 0) ThenBlock: { BreakLoop }
                TUI_BufferChar(ch)
                i     = Add(i, 1)
                avail = Subtract(avail, 1)
            }
            WhileLoop GreaterThan(avail, 0) { TUI_BufferChar(32) avail = Subtract(avail, 1) }

            TUI_ResetColor()
            row = Add(row, 1)
            idx = Add(idx, 1)
        }

        WhileLoop LessThan(row, ph) {
            TUI_MoveTo(Add(py, row), px)
            i = 0
            WhileLoop LessThan(i, pw) { TUI_BufferChar(32) i = Add(i, 1) }
            row = Add(row, 1)
        }
        ReturnValue(0)
    }
}

// ── Tool Block Widget ────────────────────────────────
//
// Block layout (240 bytes, 16 blocks = 3840 bytes):
//   name[32]  status(1)  expanded(1)  pad[2]  dur_ms[4]
//   output[192] ring buffer  out_pos[2]  out_nl(1)  pad(1)
//   ST_RUN=0  ST_OK=1  ST_ERR=2
// ● running = E2 97 8F   ✓ ok = E2 9C 93   ✗ err = E2 9C 97

FixedPool.TUI_Block_Config {
    "MAX":       Initialize=16
    "STRIDE":    Initialize=240
    "F_NAME":    Initialize=0
    "NAME_LEN":  Initialize=32
    "F_STATUS":  Initialize=32
    "F_EXPAND":  Initialize=33
    "F_DUR":     Initialize=36
    "F_OUTPUT":  Initialize=40
    "OUT_CAP":   Initialize=192
    "F_OUT_POS": Initialize=232
    "F_OUT_NL":  Initialize=234
    "ST_RUN":    Initialize=0
    "ST_OK":     Initialize=1
    "ST_ERR":    Initialize=2
    "BUF_SIZE":  Initialize=3840
}

FixedPool.TUI_Block_State {
    "blocks": Initialize=0
    "count":  Initialize=0
}

Function.TUI_Block_Init {
    Body: {
        TUI_Block_State.blocks = Allocate(TUI_Block_Config.BUF_SIZE)
        i = 0
        WhileLoop LessThan(i, TUI_Block_Config.BUF_SIZE) {
            SetByte(TUI_Block_State.blocks, i, 0)
            i = Add(i, 1)
        }
        TUI_Block_State.count = 0
        ReturnValue(0)
    }
}

Function.TUI_Block_Shutdown {
    Body: {
        IfCondition NotEqual(TUI_Block_State.blocks, 0) ThenBlock: {
            Deallocate(TUI_Block_State.blocks, TUI_Block_Config.BUF_SIZE)
            TUI_Block_State.blocks = 0
        }
        ReturnValue(0)
    }
}

Function.TUI_Block_Clear {
    Body: { TUI_Block_State.count = 0  ReturnValue(0) }
}

Function.TUI_Block_Begin {
    Input: name: Address
    Output: Integer
    Body: {
        idx = TUI_Block_State.count
        IfCondition GreaterEqual(idx, TUI_Block_Config.MAX) ThenBlock: { ReturnValue(-1) }
        base = Add(TUI_Block_State.blocks, Multiply(idx, TUI_Block_Config.STRIDE))
        i = 0
        WhileLoop LessThan(i, Subtract(TUI_Block_Config.NAME_LEN, 1)) {
            ch = GetByte(name, i)
            SetByte(base, Add(TUI_Block_Config.F_NAME, i), ch)
            IfCondition EqualTo(ch, 0) ThenBlock: { BreakLoop }
            i = Add(i, 1)
        }
        SetByte(base, Add(TUI_Block_Config.F_NAME, i), 0)
        SetByte(base, TUI_Block_Config.F_STATUS,  TUI_Block_Config.ST_RUN)
        SetByte(base, TUI_Block_Config.F_EXPAND,  0)
        SetByte(base, TUI_Block_Config.F_DUR,     0)
        SetByte(base, Add(TUI_Block_Config.F_DUR, 1), 0)
        SetByte(base, Add(TUI_Block_Config.F_DUR, 2), 0)
        SetByte(base, Add(TUI_Block_Config.F_DUR, 3), 0)
        SetByte(base, TUI_Block_Config.F_OUT_POS, 0)
        SetByte(base, Add(TUI_Block_Config.F_OUT_POS, 1), 0)
        SetByte(base, TUI_Block_Config.F_OUT_NL,  0)
        TUI_Block_State.count = Add(idx, 1)
        ReturnValue(idx)
    }
}

Function.TUI_Block_End {
    Input: idx: Integer
    Input: ok: Integer
    Input: dur_ms: Integer
    Body: {
        IfCondition Or(LessThan(idx, 0), GreaterEqual(idx, TUI_Block_State.count)) ThenBlock: { ReturnValue(-1) }
        base = Add(TUI_Block_State.blocks, Multiply(idx, TUI_Block_Config.STRIDE))
        IfCondition EqualTo(ok, 1) ThenBlock: {
            SetByte(base, TUI_Block_Config.F_STATUS, TUI_Block_Config.ST_OK)
        } ElseBlock: {
            SetByte(base, TUI_Block_Config.F_STATUS, TUI_Block_Config.ST_ERR)
        }
        SetByte(base, TUI_Block_Config.F_DUR,                     BitwiseAnd(dur_ms, 255))
        SetByte(base, Add(TUI_Block_Config.F_DUR, 1), BitwiseAnd(RightShift(dur_ms, 8),  255))
        SetByte(base, Add(TUI_Block_Config.F_DUR, 2), BitwiseAnd(RightShift(dur_ms, 16), 255))
        SetByte(base, Add(TUI_Block_Config.F_DUR, 3), BitwiseAnd(RightShift(dur_ms, 24), 255))
        ReturnValue(0)
    }
}

// Feed raw tool output bytes into a block's ring buffer.
// Call from IPCDispatch result handler before rendering.
Function.TUI_Block_AppendOutput {
    Input: idx: Integer
    Input: text: Address
    Body: {
        IfCondition Or(LessThan(idx, 0), GreaterEqual(idx, TUI_Block_State.count)) ThenBlock: { ReturnValue(-1) }
        base     = Add(TUI_Block_State.blocks, Multiply(idx, TUI_Block_Config.STRIDE))
        out_base = Add(base, TUI_Block_Config.F_OUTPUT)
        pos_lo   = GetByte(base, TUI_Block_Config.F_OUT_POS)
        pos_hi   = GetByte(base, Add(TUI_Block_Config.F_OUT_POS, 1))
        pos      = Add(pos_lo, Multiply(pos_hi, 256))
        nl       = GetByte(base, TUI_Block_Config.F_OUT_NL)
        i = 0
        WhileLoop 1 {
            ch = GetByte(text, i)
            IfCondition EqualTo(ch, 0) ThenBlock: { BreakLoop }
            SetByte(out_base, Modulo(pos, TUI_Block_Config.OUT_CAP), ch)
            pos = Add(pos, 1)
            IfCondition And(EqualTo(ch, 10), LessThan(nl, 255)) ThenBlock: { nl = Add(nl, 1) }
            i = Add(i, 1)
        }
        SetByte(base, TUI_Block_Config.F_OUT_POS,                BitwiseAnd(pos, 255))
        SetByte(base, Add(TUI_Block_Config.F_OUT_POS, 1), BitwiseAnd(RightShift(pos, 8), 255))
        SetByte(base, TUI_Block_Config.F_OUT_NL, nl)
        ReturnValue(0)
    }
}

Function.TUI_Block_Toggle {
    Input: idx: Integer
    Body: {
        IfCondition Or(LessThan(idx, 0), GreaterEqual(idx, TUI_Block_State.count)) ThenBlock: { ReturnValue(-1) }
        base = Add(TUI_Block_State.blocks, Multiply(idx, TUI_Block_Config.STRIDE))
        cur  = GetByte(base, TUI_Block_Config.F_EXPAND)
        IfCondition EqualTo(cur, 0) ThenBlock: {
            SetByte(base, TUI_Block_Config.F_EXPAND, 1)
        } ElseBlock: {
            SetByte(base, TUI_Block_Config.F_EXPAND, 0)
        }
        ReturnValue(0)
    }
}

Function.TUI_Block_Render {
    Input: start_row: Integer
    Input: pane_w: Integer
    Input: max_rows: Integer
    Output: Integer
    Body: {
        row     = start_row
        end_row = Add(start_row, max_rows)
        count   = TUI_Block_State.count
        i = 0

        WhileLoop And(LessThan(i, count), LessThan(row, end_row)) {
            base   = Add(TUI_Block_State.blocks, Multiply(i, TUI_Block_Config.STRIDE))
            status = GetByte(base, TUI_Block_Config.F_STATUS)
            expand = GetByte(base, TUI_Block_Config.F_EXPAND)
            name   = Add(base, TUI_Block_Config.F_NAME)
            dur_lo = GetByte(base, TUI_Block_Config.F_DUR)
            dur_hi = GetByte(base, Add(TUI_Block_Config.F_DUR, 1))
            dur_ms = Add(dur_lo, Multiply(dur_hi, 256))

            TUI_MoveTo(row, 1)
            TUI_Color_ToolHeader()

            IfCondition EqualTo(status, TUI_Block_Config.ST_RUN) ThenBlock: {
                TUI_Color_ToolRunning()
                TUI_BufferChar(226) TUI_BufferChar(151) TUI_BufferChar(143)  // ●
            }
            IfCondition EqualTo(status, TUI_Block_Config.ST_OK) ThenBlock: {
                TUI_Color_ToolOK()
                TUI_BufferChar(226) TUI_BufferChar(156) TUI_BufferChar(147)  // ✓
            }
            IfCondition EqualTo(status, TUI_Block_Config.ST_ERR) ThenBlock: {
                TUI_Color_ToolErr()
                TUI_BufferChar(226) TUI_BufferChar(156) TUI_BufferChar(151)  // ✗
            }

            TUI_ResetColor()
            TUI_Color_ToolHeader()
            TUI_BufferChar(32)

            j    = 0
            used = 2
            WhileLoop LessThan(used, Subtract(pane_w, 10)) {
                ch = GetByte(name, j)
                IfCondition EqualTo(ch, 0) ThenBlock: { BreakLoop }
                TUI_BufferChar(ch)
                j    = Add(j, 1)
                used = Add(used, 1)
            }

            IfCondition NotEqual(status, TUI_Block_Config.ST_RUN) ThenBlock: {
                TUI_BufferChar(32)
                TUI_Color_Muted()
                TUI_WriteNum(dur_ms)
                TUI_BufferWriteStr("ms")
            }

            TUI_BufferChar(32)
            IfCondition EqualTo(expand, 0) ThenBlock: {
                TUI_BufferWriteStr("[+]")
            } ElseBlock: {
                TUI_BufferWriteStr("[-]")
            }

            TUI_EraseToEOL()
            TUI_ResetColor()
            row = Add(row, 1)

            IfCondition And(EqualTo(expand, 1), LessThan(row, end_row)) ThenBlock: {
                out_base = Add(base, TUI_Block_Config.F_OUTPUT)
                pos_lo   = GetByte(base, TUI_Block_Config.F_OUT_POS)
                pos_hi   = GetByte(base, Add(TUI_Block_Config.F_OUT_POS, 1))
                pos      = Add(pos_lo, Multiply(pos_hi, 256))
                total    = pos
                IfCondition GreaterThan(total, TUI_Block_Config.OUT_CAP) ThenBlock: { total = TUI_Block_Config.OUT_CAP }
                start_pos = 0
                IfCondition GreaterThan(pos, TUI_Block_Config.OUT_CAP) ThenBlock: {
                    start_pos = Modulo(pos, TUI_Block_Config.OUT_CAP)
                }

                TUI_MoveTo(row, 3)
                TUI_Color_ToolDim()
                col_pos = 3
                read    = 0

                WhileLoop And(LessThan(read, total), LessThan(row, end_row)) {
                    ring_pos = Modulo(Add(start_pos, read), TUI_Block_Config.OUT_CAP)
                    ch = GetByte(out_base, ring_pos)
                    IfCondition EqualTo(ch, 10) ThenBlock: {
                        TUI_EraseToEOL()
                        row = Add(row, 1)
                        IfCondition LessThan(row, end_row) ThenBlock: {
                            TUI_MoveTo(row, 3)
                            col_pos = 3
                        }
                    } ElseBlock: {
                        IfCondition LessThan(col_pos, Subtract(pane_w, 1)) ThenBlock: {
                            TUI_BufferChar(ch)
                            col_pos = Add(col_pos, 1)
                        }
                    }
                    read = Add(read, 1)
                }

                IfCondition LessThan(row, end_row) ThenBlock: {
                    TUI_EraseToEOL()
                    row = Add(row, 1)
                }
                TUI_ResetColor()
            }

            i = Add(i, 1)
        }

        ReturnValue(row)
    }
}
