// RASTER STATE
// =============================================================================
FixedPool.RastConst {
    "MAX_EDGES":   Initialize=16384
    "EDGE_SIZE":   Initialize=32
    "EDGE_X0_OFS": Initialize=0
    "EDGE_Y0_OFS": Initialize=8
    "EDGE_X1_OFS": Initialize=16
    "EDGE_Y1_OFS": Initialize=24
}
FixedPool.RastState {
    "edges":      Initialize=0
    "edge_count": Initialize=0
    "surf":       Initialize=0
    "surf_w":     Initialize=0
    "surf_h":     Initialize=0
    "bez_stack":  Initialize=0
}
FixedPool.BezSlot {
    "x0":  Initialize=0
    "y0":  Initialize=8
    "cx1": Initialize=16
    "cy1": Initialize=24
    "cx2": Initialize=32
    "cy2": Initialize=40
    "x1":  Initialize=48
    "y1":  Initialize=56
    "d":   Initialize=64
}

// =============================================================================
// VIF INIT
// =============================================================================
Function.VIF_Init {
    Output: Integer
    Body: {
        csz = Multiply(512, VIFCacheConst.ENTRY_SIZE)
        cb  = Allocate(csz)
        ci  = 0
        WhileLoop LessThan(ci, csz) { SetByte(cb, ci, 0)  ci = Add(ci, 1) }
        VIFCache.data = cb
        VIFCache.count = 0

        fsz = Multiply(32, FontMetaConst.ENTRY_SIZE)
        fb  = Allocate(fsz)
        fi  = 0
        WhileLoop LessThan(fi, fsz) { SetByte(fb, fi, 0)  fi = Add(fi, 1) }
        FontMetaTable.data = fb
        FontMetaTable.count = 0

        ksz = Multiply(KernConst.MAX, KernConst.ENTRY_SIZE)
        kb  = Allocate(ksz)
        ki  = 0
        WhileLoop LessThan(ki, ksz) { SetByte(kb, ki, 0)  ki = Add(ki, 1) }
        KernTable.data = kb
        KernTable.count = 0

        RastState.edges     = Allocate(Multiply(RastConst.MAX_EDGES, RastConst.EDGE_SIZE))
        RastState.bez_stack = Allocate(36864)
        PrintMessage("[VIF] init ok\n")
        ReturnValue(1)
    }
}

// =============================================================================
// BYTE READERS — all flattened
// =============================================================================
Function.TVG_ReadByte {
    Output: Integer
    Body: {
        p = TVGParse.pos
        v = GetByte(TVGParse.data, p)
        TVGParse.pos = Add(p, 1)
        ReturnValue(v)
    }
}

Function.TVG_ReadU16 {
    Output: Integer
    Body: {
        lo = TVG_ReadByte()
        hi = TVG_ReadByte()
        ReturnValue(Add(lo, Multiply(hi, 256)))
    }
}

Function.TVG_ReadI16 {
    Output: Integer
    Body: {
        v = TVG_ReadU16()
        IfCondition GreaterEqual(v, 32768) ThenBlock: { v = Subtract(v, 65536) }
        ReturnValue(v)
    }
}

Function.TVG_ReadU32 {
    Output: Integer
    Body: {
        b0 = TVG_ReadByte()
        b1 = TVG_ReadByte()
        b2 = TVG_ReadByte()
        b3 = TVG_ReadByte()
        val = b0
        val = Add(val, Multiply(b1, 256))
        val = Add(val, Multiply(b2, 65536))
        val = Add(val, Multiply(b3, 16777216))
        ReturnValue(val)
    }
}

Function.TVG_ReadI32 {
    Output: Integer
    Body: {
        v = TVG_ReadU32()
        IfCondition GreaterEqual(v, 2147483648) ThenBlock: { v = Subtract(v, 4294967296) }
        ReturnValue(v)
    }
}

Function.TVG_ReadVarUInt {
    Output: Integer
    Body: {
        b0   = TVG_ReadByte()
        kind = BitwiseAnd(ShiftRight(b0, 6), 3)
        val  = BitwiseAnd(b0, 63)
        IfCondition EqualTo(kind, 1) ThenBlock: {
            b1  = TVG_ReadByte()
            val = Add(val, ShiftLeft(b1, 6))
        }
        IfCondition EqualTo(kind, 2) ThenBlock: {
            b1 = TVG_ReadByte()
            b2 = TVG_ReadByte()
            b3 = TVG_ReadByte()
            val = Add(val, ShiftLeft(b1, 6))
            val = Add(val, ShiftLeft(b2, 14))
            val = Add(val, ShiftLeft(b3, 22))
        }
        ReturnValue(val)
    }
}

Function.TVG_ReadUnit {
    Output: Integer
    Body: {
        cb = TVGParse.coord_bytes
        IfCondition EqualTo(cb, 1) ThenBlock: { ReturnValue(TVG_ReadByte()) }
        IfCondition EqualTo(cb, 4) ThenBlock: { ReturnValue(TVG_ReadI32()) }
        ReturnValue(TVG_ReadI16())
    }
}

// =============================================================================
// COORDINATE SCALING
// =============================================================================
Function.TVG_Scale {
    Input:  coord: Integer
    Output: Integer
    Body: {
        rs = TVGParse.render_size
        w  = TVGParse.width
        sb = TVGParse.scale_bits
        IfCondition EqualTo(w, 0) ThenBlock: { ReturnValue(0) }
        denom = ShiftLeft(w, sb)
        IfCondition EqualTo(denom, 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(Divide(Multiply(coord, rs), denom))
    }
}

// =============================================================================
// COLOR PACKING — flattened
// =============================================================================
Function.TVG_PackColor {
    Input: r: Integer
    Input: g: Integer
    Input: b: Integer
    Input: a: Integer
    Output: Integer
    Body: {
        val = b
        val = Add(val, Multiply(g, 256))
        val = Add(val, Multiply(r, 65536))
        val = Add(val, Multiply(a, 16777216))
        ReturnValue(val)
    }
}

// =============================================================================
// EDGE BUILDER
// =============================================================================
Function.TVG_AddEdge {
    Input: x0: Integer
    Input: y0: Integer
    Input: x1: Integer
    Input: y1: Integer
    Body: {
        ec = RastState.edge_count
        IfCondition GreaterEqual(ec, RastConst.MAX_EDGES) ThenBlock: { ReturnValue(0) }
        ep = Add(RastState.edges, Multiply(ec, RastConst.EDGE_SIZE))
        StoreValue(Add(ep, RastConst.EDGE_X0_OFS), x0)
        StoreValue(Add(ep, RastConst.EDGE_Y0_OFS), y0)
        StoreValue(Add(ep, RastConst.EDGE_X1_OFS), x1)
        StoreValue(Add(ep, RastConst.EDGE_Y1_OFS), y1)
        RastState.edge_count = Add(ec, 1)
        ReturnValue(0)
    }
}

// =============================================================================
// BEZIER HELPERS
// =============================================================================
Function.Bez_WriteSlot {
    Input: idx: Integer
    Input: x0: Integer
    Input: y0: Integer
    Input: cx1: Integer
    Input: cy1: Integer
    Body: {
        base = Multiply(idx, 72)
        s = RastState.bez_stack
        StoreValue(Add(s, Add(base, BezSlot.x0)),  x0)
        StoreValue(Add(s, Add(base, BezSlot.y0)),  y0)
        StoreValue(Add(s, Add(base, BezSlot.cx1)), cx1)
        StoreValue(Add(s, Add(base, BezSlot.cy1)), cy1)
        ReturnValue(0)
    }
}

Function.Bez_WriteSlotB {
    Input: idx: Integer
    Input: cx2: Integer
    Input: cy2: Integer
    Input: x1: Integer
    Input: y1: Integer
    Input: d: Integer
    Body: {
        base = Multiply(idx, 72)
        s = RastState.bez_stack
        StoreValue(Add(s, Add(base, BezSlot.cx2)), cx2)
        StoreValue(Add(s, Add(base, BezSlot.cy2)), cy2)
        StoreValue(Add(s, Add(base, BezSlot.x1)),  x1)
        StoreValue(Add(s, Add(base, BezSlot.y1)),  y1)
        StoreValue(Add(s, Add(base, BezSlot.d)),   d)
        ReturnValue(0)
    }
}

// =============================================================================
// CUBIC BEZIER FLATTENER — 256x precision
// =============================================================================
Function.TVG_FlattenCubic {
    Input: x0: Integer
    Input: y0: Integer
    Input: cx1: Integer
    Input: cy1: Integer
    Input: cx2: Integer
    Input: cy2: Integer
    Body: {
        bs = RastState.bez_stack
        x1 = Dereference(Add(bs, BezSlot.x1))
        y1 = Dereference(Add(bs, BezSlot.y1))
        x0  = Multiply(x0, 256)
        y0  = Multiply(y0, 256)
        cx1 = Multiply(cx1, 256)
        cy1 = Multiply(cy1, 256)
        cx2 = Multiply(cx2, 256)
        cy2 = Multiply(cy2, 256)
        x1  = Multiply(x1, 256)
        y1  = Multiply(y1, 256)

        stack = Allocate(36864)
        stack_top = 0
        IfCondition EqualTo(stack, 0) ThenBlock: {
            TVG_AddEdge(Divide(x0, 256), Divide(y0, 256), Divide(x1, 256), Divide(y1, 256))
            ReturnValue(0)
        }

        StoreValue(Add(stack, 0),  x0)
        StoreValue(Add(stack, 8),  y0)
        StoreValue(Add(stack, 16), cx1)
        StoreValue(Add(stack, 24), cy1)
        StoreValue(Add(stack, 32), cx2)
        StoreValue(Add(stack, 40), cy2)
        StoreValue(Add(stack, 48), x1)
        StoreValue(Add(stack, 56), y1)
        StoreValue(Add(stack, 64), 0)
        stack_top = 1

        WhileLoop GreaterThan(stack_top, 0) {
            stack_top = Subtract(stack_top, 1)
            base = Multiply(stack_top, 72)
            sx0  = Dereference(Add(stack, Add(base, 0)))
            sy0  = Dereference(Add(stack, Add(base, 8)))
            scx1 = Dereference(Add(stack, Add(base, 16)))
            scy1 = Dereference(Add(stack, Add(base, 24)))
            scx2 = Dereference(Add(stack, Add(base, 32)))
            scy2 = Dereference(Add(stack, Add(base, 40)))
            sx1  = Dereference(Add(stack, Add(base, 48)))
            sy1  = Dereference(Add(stack, Add(base, 56)))
            sd   = Dereference(Add(stack, Add(base, 64)))

            ux = Subtract(Multiply(3, scx1), Multiply(2, sx0))
            ux = Subtract(ux, sx1)
            uy = Subtract(Multiply(3, scy1), Multiply(2, sy0))
            uy = Subtract(uy, sy1)
            vx = Subtract(Multiply(3, scx2), sx0)
            vx = Subtract(vx, Multiply(2, sx1))
            vy = Subtract(Multiply(3, scy2), sy0)
            vy = Subtract(vy, Multiply(2, sy1))
            d1 = Add(Multiply(ux, ux), Multiply(uy, uy))
            d2 = Add(Multiply(vx, vx), Multiply(vy, vy))
            md = d1
            IfCondition GreaterThan(d2, md) ThenBlock: { md = d2 }

            IfCondition Or(GreaterEqual(sd, 8), LessThan(md, 16384)) ThenBlock: {
                TVG_AddEdge(Divide(sx0, 256), Divide(sy0, 256), Divide(sx1, 256), Divide(sy1, 256))
            } ElseBlock: {
                mx0  = Divide(Add(sx0, scx1), 2)
                my0  = Divide(Add(sy0, scy1), 2)
                mx1  = Divide(Add(scx1, scx2), 2)
                my1  = Divide(Add(scy1, scy2), 2)
                mx2  = Divide(Add(scx2, sx1), 2)
                my2  = Divide(Add(scy2, sy1), 2)
                lx1  = Divide(Add(mx0, mx1), 2)
                ly1  = Divide(Add(my0, my1), 2)
                rx0  = Divide(Add(mx1, mx2), 2)
                ry0  = Divide(Add(my1, my2), 2)
                midx = Divide(Add(lx1, rx0), 2)
                midy = Divide(Add(ly1, ry0), 2)
                nd   = Add(sd, 1)

                IfCondition LessThan(stack_top, 511) ThenBlock: {
                    rb = Multiply(stack_top, 72)
                    StoreValue(Add(stack, Add(rb, 0)),  midx)
                    StoreValue(Add(stack, Add(rb, 8)),  midy)
                    StoreValue(Add(stack, Add(rb, 16)), rx0)
                    StoreValue(Add(stack, Add(rb, 24)), ry0)
                    StoreValue(Add(stack, Add(rb, 32)), mx2)
                    StoreValue(Add(stack, Add(rb, 40)), my2)
                    StoreValue(Add(stack, Add(rb, 48)), sx1)
                    StoreValue(Add(stack, Add(rb, 56)), sy1)
                    StoreValue(Add(stack, Add(rb, 64)), nd)
                    stack_top = Add(stack_top, 1)
                }
                IfCondition LessThan(stack_top, 511) ThenBlock: {
                    lb = Multiply(stack_top, 72)
                    StoreValue(Add(stack, Add(lb, 0)),  sx0)
                    StoreValue(Add(stack, Add(lb, 8)),  sy0)
                    StoreValue(Add(stack, Add(lb, 16)), mx0)
                    StoreValue(Add(stack, Add(lb, 24)), my0)
                    StoreValue(Add(stack, Add(lb, 32)), lx1)
                    StoreValue(Add(stack, Add(lb, 40)), ly1)
                    StoreValue(Add(stack, Add(lb, 48)), midx)
                    StoreValue(Add(stack, Add(lb, 56)), midy)
                    StoreValue(Add(stack, Add(lb, 64)), nd)
                    stack_top = Add(stack_top, 1)
                }
            }
        }
        Deallocate(stack, 36864)
        ReturnValue(0)
    }
}

// =============================================================================
// SCANLINE FILL — flat color
// =============================================================================
Function.TVG_ScanFill {
    Input: r: Integer
    Input: g: Integer
    Input: b: Integer
    Input: a: Integer
    Body: {
        surf  = RastState.surf
        sw    = RastState.surf_w
        sh    = RastState.surf_h
        ec    = RastState.edge_count
        edges = RastState.edges
        color = TVG_PackColor(r, g, b, a)

        row = 0
        WhileLoop LessThan(row, sh) {
            xs_buf = Allocate(512)
            xs_cnt = 0
            ei = 0
            WhileLoop LessThan(ei, ec) {
                ep  = Add(edges, Multiply(ei, RastConst.EDGE_SIZE))
                ex0 = Dereference(Add(ep, RastConst.EDGE_X0_OFS))
                ey0 = Dereference(Add(ep, RastConst.EDGE_Y0_OFS))
                ex1 = Dereference(Add(ep, RastConst.EDGE_X1_OFS))
                ey1 = Dereference(Add(ep, RastConst.EDGE_Y1_OFS))
                IfCondition GreaterThan(ey0, ey1) ThenBlock: {
                    tmp = ey0  ey0 = ey1  ey1 = tmp
                    tmp = ex0  ex0 = ex1  ex1 = tmp
                }
                IfCondition And(LessEqual(ey0, row), LessThan(row, ey1)) ThenBlock: {
                    dy = Subtract(ey1, ey0)
                    IfCondition NotEqual(dy, 0) ThenBlock: {
                        xi = Add(ex0, Divide(Multiply(Subtract(ex1, ex0), Subtract(row, ey0)), dy))
                        StoreValue(Add(xs_buf, Multiply(xs_cnt, 8)), xi)
                        xs_cnt = Add(xs_cnt, 1)
                    }
                }
                ei = Add(ei, 1)
            }
            si = 0
            WhileLoop LessThan(si, xs_cnt) {
                sj = Add(si, 1)
                WhileLoop LessThan(sj, xs_cnt) {
                    va = Dereference(Add(xs_buf, Multiply(si, 8)))
                    vb = Dereference(Add(xs_buf, Multiply(sj, 8)))
                    IfCondition GreaterThan(va, vb) ThenBlock: {
                        StoreValue(Add(xs_buf, Multiply(si, 8)), vb)
                        StoreValue(Add(xs_buf, Multiply(sj, 8)), va)
                    }
                    sj = Add(sj, 1)
                }
                si = Add(si, 1)
            }
            pi = 0
            WhileLoop LessThan(pi, Subtract(xs_cnt, 1)) {
                xa = Dereference(Add(xs_buf, Multiply(pi, 8)))
                xb = Dereference(Add(xs_buf, Multiply(Add(pi, 1), 8)))
                IfCondition LessThan(xa, 0) ThenBlock: { xa = 0 }
                IfCondition GreaterThan(xb, sw) ThenBlock: { xb = sw }
                px = xa
                WhileLoop LessThan(px, xb) {
                    Draw_Pix_Pixel(surf, px, row, color)
                    px = Add(px, 1)
                }
                pi = Add(pi, 2)
            }
            Deallocate(xs_buf, 512)
            row = Add(row, 1)
        }
        ReturnValue(0)
    }
}

// =============================================================================
// READ STYLE — returns packed BGRA color
// =============================================================================
Function.TVG_ReadStyle {
    Input: style_kind: Integer
    Output: Integer
    Body: {
        ct = TVGParse.color_table
        IfCondition EqualTo(style_kind, TVGStyleKind.FLAT) ThenBlock: {
            idx = TVG_ReadVarUInt()
            PrintMessage("[style] FLAT idx=")
            PrintNumber(idx)
            PrintMessage("\n")
            IfCondition GreaterEqual(idx, TVGParse.color_count) ThenBlock: {
                PrintMessage("[TVG] BAD color idx=")
                PrintNumber(idx)
                PrintMessage("\n")
                ReturnValue(0)
            }
            ofs = Multiply(idx, 4)
            r = GetByte(ct, ofs)
            g = GetByte(ct, Add(ofs, 1))
            b = GetByte(ct, Add(ofs, 2))
            a = GetByte(ct, Add(ofs, 3))
            ReturnValue(TVG_PackColor(r, g, b, a))
        }
        IfCondition EqualTo(style_kind, TVGStyleKind.LINEAR) ThenBlock: {
            TVG_ReadUnit()  TVG_ReadUnit()  TVG_ReadUnit()  TVG_ReadUnit()
            idx0 = TVG_ReadVarUInt()
            TVG_ReadVarUInt()
            ofs = Multiply(idx0, 4)
            r = GetByte(ct, ofs)
            g = GetByte(ct, Add(ofs, 1))
            b = GetByte(ct, Add(ofs, 2))
            a = GetByte(ct, Add(ofs, 3))
            ReturnValue(TVG_PackColor(r, g, b, a))
        }
        IfCondition EqualTo(style_kind, TVGStyleKind.RADIAL) ThenBlock: {
            TVG_ReadUnit()  TVG_ReadUnit()  TVG_ReadUnit()  TVG_ReadUnit()
            idx0 = TVG_ReadVarUInt()
            TVG_ReadVarUInt()
            ofs = Multiply(idx0, 4)
            r = GetByte(ct, ofs)
            g = GetByte(ct, Add(ofs, 1))
            b = GetByte(ct, Add(ofs, 2))
            a = GetByte(ct, Add(ofs, 3))
            ReturnValue(TVG_PackColor(r, g, b, a))
        }
        ReturnValue(0)
    }
}

// =============================================================================
// FILL HELPER — unpack and scanfill
// =============================================================================
Function.TVG_FillWithColor {
    Input: color: Integer
    Body: {
        b = BitwiseAnd(color, 255)
        g = BitwiseAnd(ShiftRight(color, 8), 255)
        r = BitwiseAnd(ShiftRight(color, 16), 255)
        a = BitwiseAnd(ShiftRight(color, 24), 255)
        TVG_ScanFill(r, g, b, a)
        ReturnValue(0)
    }
}

// =============================================================================
// FILL RECTANGLES
// =============================================================================
Function.TVG_CmdFillRects {
    Input: count: Integer
    Input: color: Integer
    Body: {
        i = 0
        WhileLoop LessThan(i, count) {
            rx = TVG_Scale(TVG_ReadUnit())
            ry = TVG_Scale(TVG_ReadUnit())
            rw = TVG_Scale(TVG_ReadUnit())
            rh = TVG_Scale(TVG_ReadUnit())
            x1 = Add(rx, rw)
            y1 = Add(ry, rh)
            RastState.edge_count = 0
            TVG_AddEdge(rx, ry, x1, ry)
            TVG_AddEdge(x1, ry, x1, y1)
            TVG_AddEdge(x1, y1, rx, y1)
            TVG_AddEdge(rx, y1, rx, ry)
            TVG_FillWithColor(color)
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

// =============================================================================
// FILL POLYGON
// =============================================================================
Function.TVG_CmdFillPolygon {
    Input: count: Integer
    Input: color: Integer
    Body: {
        i = 0
        WhileLoop LessThan(i, count) {
            nv = Add(TVG_ReadVarUInt(), 1)
            RastState.edge_count = 0
            first_x = TVG_Scale(TVG_ReadUnit())
            first_y = TVG_Scale(TVG_ReadUnit())
            prev_x = first_x
            prev_y = first_y
            vi = 1
            WhileLoop LessThan(vi, nv) {
                cx = TVG_Scale(TVG_ReadUnit())
                cy = TVG_Scale(TVG_ReadUnit())
                TVG_AddEdge(prev_x, prev_y, cx, cy)
                prev_x = cx
                prev_y = cy
                vi = Add(vi, 1)
            }
            TVG_AddEdge(prev_x, prev_y, first_x, first_y)
            TVG_FillWithColor(color)
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

// =============================================================================
// FILL PATH — all segment types
// =============================================================================
Function.TVG_CmdFillPath {
    Input: count: Integer
    Input: color: Integer
    Body: {
        RastState.edge_count = 0
        i = 0
        WhileLoop LessThan(i, count) {
            nseg = Add(TVG_ReadVarUInt(), 1)
            cur_x = TVG_Scale(TVG_ReadUnit())
            cur_y = TVG_Scale(TVG_ReadUnit())
            first_x = cur_x
            first_y = cur_y

            si = 0
            WhileLoop LessThan(si, nseg) {
                tag   = TVG_ReadByte()
                stype = BitwiseAnd(tag, 7)

                IfCondition EqualTo(stype, TVGSeg.LINE) ThenBlock: {
                    nx = TVG_Scale(TVG_ReadUnit())
                    ny = TVG_Scale(TVG_ReadUnit())
                    TVG_AddEdge(cur_x, cur_y, nx, ny)
                    cur_x = nx
                    cur_y = ny
                }
                IfCondition EqualTo(stype, TVGSeg.HORIZ) ThenBlock: {
                    nx = TVG_Scale(TVG_ReadUnit())
                    TVG_AddEdge(cur_x, cur_y, nx, cur_y)
                    cur_x = nx
                }
                IfCondition EqualTo(stype, TVGSeg.VERT) ThenBlock: {
                    ny = TVG_Scale(TVG_ReadUnit())
                    TVG_AddEdge(cur_x, cur_y, cur_x, ny)
                    cur_y = ny
                }
                IfCondition EqualTo(stype, TVGSeg.CUBIC) ThenBlock: {
                    c1x = TVG_Scale(TVG_ReadUnit())
                    c1y = TVG_Scale(TVG_ReadUnit())
                    c2x = TVG_Scale(TVG_ReadUnit())
                    c2y = TVG_Scale(TVG_ReadUnit())
                    ex  = TVG_Scale(TVG_ReadUnit())
                    ey  = TVG_Scale(TVG_ReadUnit())
                    Bez_WriteSlot(0, cur_x, cur_y, c1x, c1y)
                    Bez_WriteSlotB(0, c2x, c2y, ex, ey, 0)
                    TVG_FlattenCubic(cur_x, cur_y, c1x, c1y, c2x, c2y)
                    cur_x = ex
                    cur_y = ey
                }
                IfCondition EqualTo(stype, TVGSeg.QUAD) ThenBlock: {
                    qcx = TVG_Scale(TVG_ReadUnit())
                    qcy = TVG_Scale(TVG_ReadUnit())
                    ex  = TVG_Scale(TVG_ReadUnit())
                    ey  = TVG_Scale(TVG_ReadUnit())
                    c1x = Divide(Add(cur_x, Multiply(2, qcx)), 3)
                    c1y = Divide(Add(cur_y, Multiply(2, qcy)), 3)
                    c2x = Divide(Add(ex, Multiply(2, qcx)), 3)
                    c2y = Divide(Add(ey, Multiply(2, qcy)), 3)
                    Bez_WriteSlot(0, cur_x, cur_y, c1x, c1y)
                    Bez_WriteSlotB(0, c2x, c2y, ex, ey, 0)
                    TVG_FlattenCubic(cur_x, cur_y, c1x, c1y, c2x, c2y)
                    cur_x = ex
                    cur_y = ey
                }
                IfCondition EqualTo(stype, TVGSeg.ARC_CIRC) ThenBlock: {
                    TVG_ReadUnit()
                    nx = TVG_Scale(TVG_ReadUnit())
                    ny = TVG_Scale(TVG_ReadUnit())
                    TVG_AddEdge(cur_x, cur_y, nx, ny)
                    cur_x = nx
                    cur_y = ny
                }
                IfCondition EqualTo(stype, TVGSeg.ARC_ELLIP) ThenBlock: {
                    TVG_ReadUnit()
                    TVG_ReadUnit()
                    TVG_ReadUnit()
                    nx = TVG_Scale(TVG_ReadUnit())
                    ny = TVG_Scale(TVG_ReadUnit())
                    TVG_AddEdge(cur_x, cur_y, nx, ny)
                    cur_x = nx
                    cur_y = ny
                }
                IfCondition EqualTo(stype, TVGSeg.CLOSE) ThenBlock: {
                    TVG_AddEdge(cur_x, cur_y, first_x, first_y)
                    cur_x = first_x
                    cur_y = first_y
                }
                si = Add(si, 1)
            }
            i = Add(i, 1)
        }
        TVG_FillWithColor(color)
        ReturnValue(0)
    }
}

// =============================================================================
// HEADER + COLOR TABLE PARSER
// =============================================================================
Function.TVG_ParseHeader {
    Output: Integer
    Body: {
        ver = TVG_ReadByte()
        IfCondition NotEqual(ver, 1) ThenBlock: {
            PrintMessage("[TVG] bad version\n")
            ReturnValue(0)
        }
        flags = TVG_ReadByte()
        TVGParse.scale_bits  = BitwiseAnd(flags, 15)
        TVGParse.color_enc   = BitwiseAnd(ShiftRight(flags, 4), 3)
        TVGParse.coord_range = BitwiseAnd(ShiftRight(flags, 6), 3)
        cb = 2
        IfCondition EqualTo(TVGParse.coord_range, TVGCoordRange.I8) ThenBlock: { cb = 1 }
        IfCondition EqualTo(TVGParse.coord_range, TVGCoordRange.I32) ThenBlock: { cb = 4 }
        TVGParse.coord_bytes = cb

        TVGParse.width  = TVG_ReadUnit()
        TVGParse.height = TVG_ReadUnit()

        nc = TVG_ReadVarUInt()
        TVGParse.color_count = nc

        ct = Allocate(Multiply(nc, 4))
        TVGParse.color_table = ct
        ci = 0
        WhileLoop LessThan(ci, nc) {
            ofs = Multiply(ci, 4)
            SetByte(ct, ofs,         TVG_ReadByte())
            SetByte(ct, Add(ofs, 1), TVG_ReadByte())
            SetByte(ct, Add(ofs, 2), TVG_ReadByte())
            SetByte(ct, Add(ofs, 3), TVG_ReadByte())
            ci = Add(ci, 1)
        }

        PrintMessage("[TVG] v1 ")
        PrintNumber(TVGParse.width)
        PrintMessage("x")
        PrintNumber(TVGParse.height)
        PrintMessage(" scale=")
        PrintNumber(TVGParse.scale_bits)
        PrintMessage(" colors=")
        PrintNumber(nc)
        PrintMessage(" pos=")
        PrintNumber(TVGParse.pos)
        PrintMessage("\n")
        ReturnValue(1)
    }
}

// =============================================================================
// COMMAND DISPATCH — main render loop
// =============================================================================
Function.TVG_Render {
    Input: render_size: Integer
    Output: Integer
    Body: {
        surf = Surface_Create(SurfaceFormat.PIXEL_32, render_size, render_size)
        IfCondition EqualTo(surf, 0) ThenBlock: { ReturnValue(0) }
        Draw_Pix_FillRect(surf, 0, 0, render_size, render_size, 0)
        RastState.surf   = surf
        RastState.surf_w = render_size
        RastState.surf_h = render_size
        TVGParse.render_size = render_size

        done = 0
        WhileLoop EqualTo(done, 0) {
            IfCondition GreaterEqual(TVGParse.pos, TVGParse.size) ThenBlock: { done = 1 }
            IfCondition LessThan(TVGParse.pos, TVGParse.size) ThenBlock: {
                cmd_byte = TVG_ReadByte()
                cmd_id   = BitwiseAnd(cmd_byte, 63)

                IfCondition EqualTo(cmd_id, TVGCmd.END) ThenBlock: {
                    done = 1
                }
                IfCondition NotEqual(cmd_id, TVGCmd.END) ThenBlock: {
                    PrintMessage("[TVG] cmd=")
                    PrintNumber(cmd_id)
                    PrintMessage(" pos=")
                    PrintNumber(TVGParse.pos)
                    PrintMessage("\n")

                    // Fill commands: style_kind from cmd_byte, color VarUInt, count VarUInt, geometry
                    IfCondition EqualTo(cmd_id, TVGCmd.FILL_POLY) ThenBlock: {
                        fi = TVG_ReadVarUInt()
                        count = Add(TVG_ReadVarUInt(), 1)
                        ct = TVGParse.color_table
                        ofs = Multiply(fi, 4)
                        fr = GetByte(ct, ofs)
                        fg = GetByte(ct, Add(ofs, 1))
                        fb = GetByte(ct, Add(ofs, 2))
                        fa = GetByte(ct, Add(ofs, 3))
                        color = TVG_PackColor(fr, fg, fb, fa)
                        TVG_CmdFillPolygon(count, color)
                    }
                    IfCondition EqualTo(cmd_id, TVGCmd.FILL_RECT) ThenBlock: {
                        fi = TVG_ReadVarUInt()
                        count = Add(TVG_ReadVarUInt(), 1)
                        ct = TVGParse.color_table
                        ofs = Multiply(fi, 4)
                        fr = GetByte(ct, ofs)
                        fg = GetByte(ct, Add(ofs, 1))
                        fb = GetByte(ct, Add(ofs, 2))
                        fa = GetByte(ct, Add(ofs, 3))
                        color = TVG_PackColor(fr, fg, fb, fa)
                        TVG_CmdFillRects(count, color)
                    }
                    IfCondition EqualTo(cmd_id, TVGCmd.FILL_PATH) ThenBlock: {
                        fi = TVG_ReadVarUInt()
                        count = Add(TVG_ReadVarUInt(), 1)
                        ct = TVGParse.color_table
                        ofs = Multiply(fi, 4)
                        fr = GetByte(ct, ofs)
                        fg = GetByte(ct, Add(ofs, 1))
                        fb = GetByte(ct, Add(ofs, 2))
                        fa = GetByte(ct, Add(ofs, 3))
                        color = TVG_PackColor(fr, fg, fb, fa)
                        TVG_CmdFillPath(count, color)
                    }
                    // Stroke: style + line_width + count + geometry
                    IfCondition EqualTo(cmd_id, TVGCmd.LINE_POLY) ThenBlock: {
                        fi = TVG_ReadVarUInt()
                        lw = TVG_ReadUnit()
                        count = Add(TVG_ReadVarUInt(), 1)
                        ct = TVGParse.color_table
                        ofs = Multiply(fi, 4)
                        fr = GetByte(ct, ofs)
                        fg = GetByte(ct, Add(ofs, 1))
                        fb = GetByte(ct, Add(ofs, 2))
                        fa = GetByte(ct, Add(ofs, 3))
                        color = TVG_PackColor(fr, fg, fb, fa)
                        TVG_CmdFillPolygon(count, color)
                    }
                    IfCondition EqualTo(cmd_id, TVGCmd.LINE_PATH) ThenBlock: {
                        fi = TVG_ReadVarUInt()
                        lw = TVG_ReadUnit()
                        count = Add(TVG_ReadVarUInt(), 1)
                        ct = TVGParse.color_table
                        ofs = Multiply(fi, 4)
                        fr = GetByte(ct, ofs)
                        fg = GetByte(ct, Add(ofs, 1))
                        fb = GetByte(ct, Add(ofs, 2))
                        fa = GetByte(ct, Add(ofs, 3))
                        color = TVG_PackColor(fr, fg, fb, fa)
                        PrintMessage("[TVG] LINE_PATH fi=")
                        PrintNumber(fi)
                        PrintMessage(" lw=")
                        PrintNumber(lw)
                        PrintMessage(" count=")
                        PrintNumber(count)
                        PrintMessage(" pos=")
                        PrintNumber(TVGParse.pos)
                        PrintMessage("\n")
                        TVG_CmdFillPath(count, color)
                    }
                    IfCondition EqualTo(cmd_id, TVGCmd.LINE_RECT) ThenBlock: {
                        fi = TVG_ReadVarUInt()
                        lw = TVG_ReadUnit()
                        count = Add(TVG_ReadVarUInt(), 1)
                        ct = TVGParse.color_table
                        ofs = Multiply(fi, 4)
                        fr = GetByte(ct, ofs)
                        fg = GetByte(ct, Add(ofs, 1))
                        fb = GetByte(ct, Add(ofs, 2))
                        fa = GetByte(ct, Add(ofs, 3))
                        color = TVG_PackColor(fr, fg, fb, fa)
                        TVG_CmdFillRects(count, color)
                    }
                    // Outline-fill (7=poly, 8=rects, 9=path)
                    // fill_style + stroke_style + line_width + count + geometry
                    IfCondition EqualTo(cmd_id, 7) ThenBlock: {
                        PrintMessage("[TVG] entering cmd7\n")
                        // Inline style read — test if function call is the issue
                        sb1 = TVG_ReadByte()
                        PrintMessage("[TVG] sb1=")
                        PrintNumber(sb1)
                        PrintMessage("\n")
                        sk1 = BitwiseAnd(ShiftRight(sb1, 6), 3)
                        cidx1 = TVG_ReadVarUInt()
                        PrintMessage("[TVG] fill kind=")
                        PrintNumber(sk1)
                        PrintMessage(" idx=")
                        PrintNumber(cidx1)
                        PrintMessage("\n")
                        // Second style
                        sb2 = TVG_ReadByte()
                        sk2 = BitwiseAnd(ShiftRight(sb2, 6), 3)
                        cidx2 = TVG_ReadVarUInt()
                        PrintMessage("[TVG] stroke kind=")
                        PrintNumber(sk2)
                        PrintMessage(" idx=")
                        PrintNumber(cidx2)
                        PrintMessage("\n")
                        // Line width
                        lw = TVG_ReadUnit()
                        PrintMessage("[TVG] line_width=")
                        PrintNumber(lw)
                        PrintMessage("\n")
                        // Count
                        count = Add(TVG_ReadVarUInt(), 1)
                        PrintMessage("[TVG] count=")
                        PrintNumber(count)
                        PrintMessage(" pos=")
                        PrintNumber(TVGParse.pos)
                        PrintMessage("\n")
                        // Skip geometry for now — just see if we parsed correctly
                        done = 1
                    }
                    IfCondition EqualTo(cmd_id, 8) ThenBlock: {
                        color = TVG_ReadStyle()
                        color2 = TVG_ReadStyle()
                        TVG_ReadUnit()
                        count = Add(TVG_ReadVarUInt(), 1)
                        TVG_CmdFillRects(count, color)
                    }
                    IfCondition EqualTo(cmd_id, 9) ThenBlock: {
                        color = TVG_ReadStyle()
                        color2 = TVG_ReadStyle()
                        TVG_ReadUnit()
                        count = Add(TVG_ReadVarUInt(), 1)
                        TVG_CmdFillPath(count, color)
                    }
                    // Unknown — stop
                    IfCondition GreaterThan(cmd_id, 9) ThenBlock: {
                        PrintMessage("[TVG] unknown cmd=")
                        PrintNumber(cmd_id)
                        PrintMessage(" — stopping\n")
                        done = 1
                    }
                }
            }
        }
        PrintMessage("[TVG] render complete\n")
        ReturnValue(surf)
    }
}

// =============================================================================
// TOP-LEVEL ENTRY
// =============================================================================
Function.TVG_Parse {
    Input:  data: Integer
    Input:  size: Integer
    Input:  render_size: Integer
    Output: Integer
    Body: {
        TVGParse.data = data
        TVGParse.size = size
        TVGParse.pos  = 0
        m0 = GetByte(data, 0)
        m1 = GetByte(data, 1)
        is_tvg = 0
        IfCondition EqualTo(m0, TVGMagic.M0) ThenBlock: {
            IfCondition EqualTo(m1, TVGMagic.M1) ThenBlock: { is_tvg = 1 }
        }
        IfCondition EqualTo(is_tvg, 0) ThenBlock: {
            PrintMessage("[TVG] bad magic\n")
            ReturnValue(0)
        }
        TVGParse.pos = 2
        ok = TVG_ParseHeader()
        IfCondition EqualTo(ok, 0) ThenBlock: { ReturnValue(0) }
        surf = TVG_Render(render_size)
        ReturnValue(surf)
    }
}

// =============================================================================
// SHUTDOWN
// =============================================================================
Function.VIF_Shutdown {
    Output: Integer
    Body: {
        IfCondition NotEqual(TVGParse.color_table, 0) ThenBlock: {
            Deallocate(TVGParse.color_table, Multiply(TVGParse.color_count, 4))
            TVGParse.color_table = 0
        }
        PrintMessage("[VIF] shutdown\n")
        ReturnValue(1)
    }
}