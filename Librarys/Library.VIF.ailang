    "FAMILY_IDX_OFS": Initialize=0
    "LEFT_CP_OFS":    Initialize=8
    "RIGHT_CP_OFS":   Initialize=16
    "ADJUST_X_OFS":   Initialize=24
    "ENTRY_SIZE":     Initialize=32
