}

// =============================================================================
// PARSER STATE
// =============================================================================
FixedPool.TVGParse {
    "data":        Initialize=0
    "size":        Initialize=0
    "pos":         Initialize=0
    "width":       Initialize=0
    "height":      Initialize=0
    "scale_bits":  Initialize=0
    "color_enc":   Initialize=0
    "coord_range": Initialize=0
    "coord_bytes": Initialize=2
    "color_count": Initialize=0
    "color_table": Initialize=0
    "render_size": Initialize=0
}

// =============================================================================
// RASTER STATE
// =============================================================================
FixedPool.RastConst {
    "MAX_EDGES":   Initialize=16384
    "EDGE_SIZE":   Initialize=32
    "EDGE_X0_OFS": Initialize=0
    "EDGE_Y0_OFS": Initialize=8
    "EDGE_X1_OFS": Initialize=16
    "EDGE_Y1_OFS": Initialize=24
}
FixedPool.RastState {
    "edges":      Initialize=0
    "edge_count": Initialize=0
    "surf":       Initialize=0
    "surf_w":     Initialize=0
    "surf_h":     Initialize=0
}

// Bezier endpoint scratch — avoids >6 register inputs to FlattenCubic
FixedPool.BezEnd {
    "x1": Initialize=0
    "y1": Initialize=0
}

// =============================================================================
// VIF INIT
// =============================================================================
Function.VIF_Init {
    Output: Integer
    Body: {
        csz = Multiply(512, VIFCacheConst.ENTRY_SIZE)
        cb  = Allocate(csz)
        IfCondition EqualTo(cb, 0) ThenBlock: {
            PrintMessage("[VIF] cache alloc fail\n")
            ReturnValue(0)
        }
        ci  = 0
        WhileLoop LessThan(ci, csz) { SetByte(cb, ci, 0)  ci = Add(ci, 1) }
        VIFCache.data = cb
        VIFCache.count = 0

        fsz = Multiply(32, FontMetaConst.ENTRY_SIZE)
        fb  = Allocate(fsz)
        IfCondition EqualTo(fb, 0) ThenBlock: {
            PrintMessage("[VIF] font alloc fail\n")
            ReturnValue(0)
        }
        fi  = 0
        WhileLoop LessThan(fi, fsz) { SetByte(fb, fi, 0)  fi = Add(fi, 1) }
        FontMetaTable.data = fb
        FontMetaTable.count = 0

        ksz = Multiply(KernConst.MAX, KernConst.ENTRY_SIZE)
        kb  = Allocate(ksz)
        IfCondition EqualTo(kb, 0) ThenBlock: {
            PrintMessage("[VIF] kern alloc fail\n")
            ReturnValue(0)
        }
        ki  = 0
        WhileLoop LessThan(ki, ksz) { SetByte(kb, ki, 0)  ki = Add(ki, 1) }
        KernTable.data = kb
        KernTable.count = 0

        esz = Multiply(RastConst.MAX_EDGES, RastConst.EDGE_SIZE)
        RastState.edges = Allocate(esz)
        PrintMessage("[VIF] init ok\n")
        ReturnValue(1)
    }
}

// =============================================================================
// BYTE READERS
// =============================================================================
Function.TVG_ReadByte {
    Output: Integer
    Body: {
        p = TVGParse.pos
        v = GetByte(TVGParse.data, p)
        TVGParse.pos = Add(p, 1)
        ReturnValue(v)
    }
}

Function.TVG_ReadU16 {
    Output: Integer
    Body: {
        lo = TVG_ReadByte()
        hi = TVG_ReadByte()
        val = Multiply(hi, 256)
        val = Add(lo, val)
        ReturnValue(val)
    }
}

Function.TVG_ReadI16 {
    Output: Integer
    Body: {
        v = TVG_ReadU16()
        IfCondition GreaterEqual(v, 32768) ThenBlock: { v = Subtract(v, 65536) }
        ReturnValue(v)
    }
}

Function.TVG_ReadU32 {
    Output: Integer
    Body: {
        b0 = TVG_ReadByte()
        b1 = TVG_ReadByte()
        b2 = TVG_ReadByte()
        b3 = TVG_ReadByte()
        val = b0
        t = Multiply(b1, 256)
        val = Add(val, t)
        t = Multiply(b2, 65536)
        val = Add(val, t)
        t = Multiply(b3, 16777216)
        val = Add(val, t)
        ReturnValue(val)
    }
}

Function.TVG_ReadI32 {
    Output: Integer
    Body: {
        v = TVG_ReadU32()
        IfCondition GreaterEqual(v, 2147483648) ThenBlock: { v = Subtract(v, 4294967296) }
        ReturnValue(v)
    }
}

// VarUInt per TinyVG spec: bit 7 = "more" flag, bits 0-6 = payload
Function.TVG_ReadVarUInt {
    Output: Integer
    Body: {
        result = 0
        shift  = 0
        more   = 1
        WhileLoop EqualTo(more, 1) {
            b = TVG_ReadByte()
            payload = BitwiseAnd(b, 127)
            shifted = ShiftLeft(payload, shift)
            result  = BitwiseOr(result, shifted)
            shift   = Add(shift, 7)
            flag    = BitwiseAnd(b, 128)
            more    = ShiftRight(flag, 7)
        }
        ReturnValue(result)
    }
}

Function.TVG_ReadUnit {
    Output: Integer
    Body: {
        cb = TVGParse.coord_bytes
        IfCondition EqualTo(cb, 1) ThenBlock: { ReturnValue(TVG_ReadByte()) }
        IfCondition EqualTo(cb, 4) ThenBlock: { ReturnValue(TVG_ReadI32()) }
        ReturnValue(TVG_ReadI16())
    }
}

// =============================================================================
// COORDINATE SCALING — separate X and Y for aspect ratio
// =============================================================================
// TVG_ScaleX / TVG_ScaleY return 256× fixed-point pixel coordinates
// so we don't drop the fractional part at scale-down. Downstream code
// (edge list, scanfill) treats all coords as 256× fp; the fraction
// flows through to the coverage-AA calculation where it becomes real
// edge softness. Pre-multiplying the numerator by 256 keeps precision
// without needing Float_Div (integer math handles it).
Function.TVG_ScaleX {
    Input:  coord: Integer
    Output: Integer
    Body: {
        w  = TVGParse.width
        sb = TVGParse.scale_bits
        IfCondition EqualTo(w, 0) ThenBlock: { ReturnValue(0) }
        denom = ShiftLeft(w, sb)
        IfCondition EqualTo(denom, 0) ThenBlock: { ReturnValue(0) }
        num = Multiply(Multiply(coord, RastState.surf_w), 256)
        ReturnValue(Divide(num, denom))
    }
}

Function.TVG_ScaleY {
    Input:  coord: Integer
    Output: Integer
    Body: {
        h  = TVGParse.height
        sb = TVGParse.scale_bits
        IfCondition EqualTo(h, 0) ThenBlock: { ReturnValue(0) }
        denom = ShiftLeft(h, sb)
        IfCondition EqualTo(denom, 0) ThenBlock: { ReturnValue(0) }
        num = Multiply(Multiply(coord, RastState.surf_h), 256)
        ReturnValue(Divide(num, denom))
    }
}

// =============================================================================
// COLOR PACKING
// =============================================================================
Function.TVG_PackColor {
    Input: r: Integer
    Input: g: Integer
    Input: b: Integer
    Input: a: Integer
    Output: Integer
    Body: {
        val = b
        t = Multiply(g, 256)
        val = Add(val, t)
        t = Multiply(r, 65536)
        val = Add(val, t)
        t = Multiply(a, 16777216)
        val = Add(val, t)
        ReturnValue(val)
    }
}

// =============================================================================
// STROKE STATE — toggled on inside OL_* commands so TVG_AddEdge emits
// a thickened quad (four raw edges) instead of a single edge. This
// turns the outline commands into actual strokes rather than treating
// them as degenerate fills.
// =============================================================================
FixedPool.StrokeState {
    "active":     Initialize=0
    "half_width": Initialize=0    // 256× fixed-point, min 128 (0.5px)
}

// =============================================================================
// EDGE BUILDER
// =============================================================================
// TVG_AddEdge_Raw: append a single edge to the list. Never checks
// stroke mode — used by stroke quads + by anywhere that really wants
// one literal edge regardless of StrokeState.
Function.TVG_AddEdge_Raw {
    Input: x0: Integer
    Input: y0: Integer
    Input: x1: Integer
    Input: y1: Integer
    Body: {
        ec = RastState.edge_count
        IfCondition GreaterEqual(ec, RastConst.MAX_EDGES) ThenBlock: { ReturnValue(0) }
        edges = RastState.edges
        off = Multiply(ec, RastConst.EDGE_SIZE)
        ep  = Add(edges, off)
        StoreValue(Add(ep, RastConst.EDGE_X0_OFS), x0)
        StoreValue(Add(ep, RastConst.EDGE_Y0_OFS), y0)
        StoreValue(Add(ep, RastConst.EDGE_X1_OFS), x1)
        StoreValue(Add(ep, RastConst.EDGE_Y1_OFS), y1)
        RastState.edge_count = Add(ec, 1)
        ReturnValue(0)
    }
}

// TVG_StrokeEmit: given a line segment and a half-width, emit four
// edges forming a thin quad centered on the segment.
// Uses ISqrt on the squared length — coords are 256× fp so the input
// to ISqrt is 65536× pixel², and ISqrt returns 256× pixel length.
Function.TVG_StrokeEmit {
    Input: x0: Integer
    Input: y0: Integer
    Input: x1: Integer
    Input: y1: Integer
    Input: hw: Integer   // half-width, 256× fp
    Body: {
        dx = Subtract(x1, x0)
        dy = Subtract(y1, y0)
        len_sq = Add(Multiply(dx, dx), Multiply(dy, dy))
        IfCondition EqualTo(len_sq, 0) ThenBlock: { ReturnValue(0) }

        // length in 256× fp = ISqrt(len_sq).
        len_fp = ISqrt(len_sq)
        IfCondition EqualTo(len_fp, 0) ThenBlock: { ReturnValue(0) }

        // Perpendicular unit × half-width, in 256× fp.
        //   perp_x = -dy * hw / len
        //   perp_y =  dx * hw / len
        // Numerator is (256×)(256×) = 65536× ; divide by 256× len
        // leaves 256× fp. Matches coord units.
        px = Divide(Multiply(Subtract(0, dy), hw), len_fp)
        py = Divide(Multiply(dx, hw), len_fp)

        // Four quad corners.
        ax = Add(x0, px)  ay = Add(y0, py)
        bx = Add(x1, px)  by = Add(y1, py)
        cx = Subtract(x1, px)  cy = Subtract(y1, py)
        dx_c = Subtract(x0, px)  dy_c = Subtract(y0, py)

        // Emit edges clockwise: A→B→C→D→A.
        TVG_AddEdge_Raw(ax, ay, bx, by)
        TVG_AddEdge_Raw(bx, by, cx, cy)
        TVG_AddEdge_Raw(cx, cy, dx_c, dy_c)
        TVG_AddEdge_Raw(dx_c, dy_c, ax, ay)
        ReturnValue(0)
    }
}

// TVG_AddEdge: dispatcher. Most callers just want "append an edge";
// when StrokeState is active, turn each incoming edge into a stroked
// quad instead.
Function.TVG_AddEdge {
    Input: x0: Integer
    Input: y0: Integer
    Input: x1: Integer
    Input: y1: Integer
    Body: {
        IfCondition EqualTo(StrokeState.active, 1) ThenBlock: {
            TVG_StrokeEmit(x0, y0, x1, y1, StrokeState.half_width)
            ReturnValue(0)
        }
        ec = RastState.edge_count
        IfCondition GreaterEqual(ec, RastConst.MAX_EDGES) ThenBlock: { ReturnValue(0) }
        off = Multiply(ec, RastConst.EDGE_SIZE)
        ep = Add(RastState.edges, off)
        t = Add(ep, RastConst.EDGE_X0_OFS)
        StoreValue(t, x0)
        t = Add(ep, RastConst.EDGE_Y0_OFS)
        StoreValue(t, y0)
        t = Add(ep, RastConst.EDGE_X1_OFS)
        StoreValue(t, x1)
        t = Add(ep, RastConst.EDGE_Y1_OFS)
        StoreValue(t, y1)
        RastState.edge_count = Add(ec, 1)
        ReturnValue(0)
    }
}

// =============================================================================
// BEZIER ENDPOINT SETTER — call before TVG_FlattenCubic
// =============================================================================
Function.TVG_BezSetEnd {
    Input: x1: Integer
    Input: y1: Integer
    Body: {
        BezEnd.x1 = x1
        BezEnd.y1 = y1
        ReturnValue(0)
    }
}

// =============================================================================
// CUBIC BEZIER FLATTENER — 256x precision, iterative stack
// Reads endpoint from BezEnd.x1/y1 (set via TVG_BezSetEnd)
// 6 inputs: x0, y0, cx1, cy1, cx2, cy2
// =============================================================================
Function.TVG_FlattenCubic {
    Input: x0: Integer
    Input: y0: Integer
    Input: cx1: Integer
    Input: cy1: Integer
    Input: cx2: Integer
    Input: cy2: Integer
    Body: {
        x1 = BezEnd.x1
        y1 = BezEnd.y1
        x0  = Multiply(x0, 256)
        y0  = Multiply(y0, 256)
        cx1 = Multiply(cx1, 256)
        cy1 = Multiply(cy1, 256)
        cx2 = Multiply(cx2, 256)
        cy2 = Multiply(cy2, 256)
        x1  = Multiply(x1, 256)
        y1  = Multiply(y1, 256)

        stack = Allocate(36864)
        IfCondition EqualTo(stack, 0) ThenBlock: {
            fa0 = Divide(x0, 256)
            fb0 = Divide(y0, 256)
            fa1 = Divide(x1, 256)
            fb1 = Divide(y1, 256)
            TVG_AddEdge(fa0, fb0, fa1, fb1)
            ReturnValue(0)
        }
        stack_top = 0

        StoreValue(Add(stack, 0),  x0)
        StoreValue(Add(stack, 8),  y0)
        StoreValue(Add(stack, 16), cx1)
        StoreValue(Add(stack, 24), cy1)
        StoreValue(Add(stack, 32), cx2)
        StoreValue(Add(stack, 40), cy2)
        StoreValue(Add(stack, 48), x1)
        StoreValue(Add(stack, 56), y1)
        StoreValue(Add(stack, 64), 0)
        stack_top = 1

        WhileLoop GreaterThan(stack_top, 0) {
            stack_top = Subtract(stack_top, 1)
            base = Multiply(stack_top, 72)
            sx0  = Dereference(Add(stack, Add(base, 0)))
            sy0  = Dereference(Add(stack, Add(base, 8)))
            scx1 = Dereference(Add(stack, Add(base, 16)))
            scy1 = Dereference(Add(stack, Add(base, 24)))
            scx2 = Dereference(Add(stack, Add(base, 32)))
            scy2 = Dereference(Add(stack, Add(base, 40)))
            sx1  = Dereference(Add(stack, Add(base, 48)))
            sy1  = Dereference(Add(stack, Add(base, 56)))
            sd   = Dereference(Add(stack, Add(base, 64)))

            t1 = Multiply(3, scx1)
            t2 = Multiply(2, sx0)
            ux = Subtract(t1, t2)
            ux = Subtract(ux, sx1)
            t1 = Multiply(3, scy1)
            t2 = Multiply(2, sy0)
            uy = Subtract(t1, t2)
            uy = Subtract(uy, sy1)
            t1 = Multiply(3, scx2)
            vx = Subtract(t1, sx0)
            t2 = Multiply(2, sx1)
            vx = Subtract(vx, t2)
            t1 = Multiply(3, scy2)
            vy = Subtract(t1, sy0)
            t2 = Multiply(2, sy1)
            vy = Subtract(vy, t2)
            d1 = Multiply(ux, ux)
            t1 = Multiply(uy, uy)
            d1 = Add(d1, t1)
            d2 = Multiply(vx, vx)
            t1 = Multiply(vy, vy)
            d2 = Add(d2, t1)
            md = d1
            IfCondition GreaterThan(d2, md) ThenBlock: { md = d2 }

            // Flatness gate with two tightenings vs. the original:
            //   depth cap 8 → 12  (up to 4096 segments if genuinely
            //     needed — small icons can't afford to hit the cap
            //     and emit a straight line across a gently curving
            //     spline, which was a visible source of faceting)
            //   threshold 16384 → 4096  (tighter by 4× in squared
            //     distance = 2× tighter linear flatness, about
            //     0.125 pixel²). Subdivision is cheap compared to
            //     one sloppy-looking curve on every game icon.
            //
            // md is in 65536× fp units (ScaleX/Y 256× × flatten's
            // internal 256× = 2^16 coord scale, md = diff² = 2^32).
            // Shift right 16 to bring the comparison back to the
            // integer-pixel² domain of the original code.
            md_cmp = ShiftRight(md, 16)
            IfCondition Or(GreaterEqual(sd, 12), LessThan(md_cmp, 4096)) ThenBlock: {
                // Flatten output goes to TVG_AddEdge as 256× fp — one
                // divide by 256 brings the 65536×-internal coords to
                // the 256× fp units that AddEdge + ScanFill expect.
                fa0 = Divide(sx0, 256)
                fb0 = Divide(sy0, 256)
                fa1 = Divide(sx1, 256)
                fb1 = Divide(sy1, 256)
                TVG_AddEdge(fa0, fb0, fa1, fb1)
            } ElseBlock: {
                mx0  = Add(sx0, scx1)
                mx0  = Divide(mx0, 2)
                my0  = Add(sy0, scy1)
                my0  = Divide(my0, 2)
                mx1  = Add(scx1, scx2)
                mx1  = Divide(mx1, 2)
                my1  = Add(scy1, scy2)
                my1  = Divide(my1, 2)
                mx2  = Add(scx2, sx1)
                mx2  = Divide(mx2, 2)
                my2  = Add(scy2, sy1)
                my2  = Divide(my2, 2)
                lx1  = Add(mx0, mx1)
                lx1  = Divide(lx1, 2)
                ly1  = Add(my0, my1)
                ly1  = Divide(ly1, 2)
                rx0  = Add(mx1, mx2)
                rx0  = Divide(rx0, 2)
                ry0  = Add(my1, my2)
                ry0  = Divide(ry0, 2)
                midx = Add(lx1, rx0)
                midx = Divide(midx, 2)
                midy = Add(ly1, ry0)
                midy = Divide(midy, 2)
                nd   = Add(sd, 1)

                // Push right half
                IfCondition LessThan(stack_top, 511) ThenBlock: {
                    rb = Multiply(stack_top, 72)
                    StoreValue(Add(stack, Add(rb, 0)),  midx)
                    StoreValue(Add(stack, Add(rb, 8)),  midy)
                    StoreValue(Add(stack, Add(rb, 16)), rx0)
                    StoreValue(Add(stack, Add(rb, 24)), ry0)
                    StoreValue(Add(stack, Add(rb, 32)), mx2)
                    StoreValue(Add(stack, Add(rb, 40)), my2)
                    StoreValue(Add(stack, Add(rb, 48)), sx1)
                    StoreValue(Add(stack, Add(rb, 56)), sy1)
                    StoreValue(Add(stack, Add(rb, 64)), nd)
                    stack_top = Add(stack_top, 1)
                }
                // Push left half
                IfCondition LessThan(stack_top, 511) ThenBlock: {
                    lb = Multiply(stack_top, 72)
                    StoreValue(Add(stack, Add(lb, 0)),  sx0)
                    StoreValue(Add(stack, Add(lb, 8)),  sy0)
                    StoreValue(Add(stack, Add(lb, 16)), mx0)
                    StoreValue(Add(stack, Add(lb, 24)), my0)
                    StoreValue(Add(stack, Add(lb, 32)), lx1)
                    StoreValue(Add(stack, Add(lb, 40)), ly1)
                    StoreValue(Add(stack, Add(lb, 48)), midx)
                    StoreValue(Add(stack, Add(lb, 56)), midy)
                    StoreValue(Add(stack, Add(lb, 64)), nd)
                    stack_top = Add(stack_top, 1)
                }
            }
        }
        Deallocate(stack, 36864)
        ReturnValue(0)
    }
}

// =============================================================================
// ALPHA BLEND PIXEL — src over dst
// Reads existing pixel, blends, writes back
// =============================================================================
Function.TVG_BlendPixel {
    Input: surf: Integer
    Input: px: Integer
    Input: py: Integer
    Input: color: Integer
    Body: {
        sa = ShiftRight(color, 24)
        sa = BitwiseAnd(sa, 255)

        // Fully opaque — just write
        IfCondition EqualTo(sa, 255) ThenBlock: {
            Draw_Pix_Pixel(surf, px, py, color)
            ReturnValue(0)
        }
        // Fully transparent — skip
        IfCondition EqualTo(sa, 0) ThenBlock: {
            ReturnValue(0)
        }

        // Read existing pixel
        src_data  = Surface_GetData(surf)
        src_pitch = Surface_GetPitch(surf)
        row_ptr = Multiply(py, src_pitch)
        row_ptr = Add(src_data, row_ptr)
        col_off = Multiply(px, 4)
        pix_ptr = Add(row_ptr, col_off)
        db = GetByte(pix_ptr, 0)
        dg = GetByte(pix_ptr, 1)
        dr = GetByte(pix_ptr, 2)
        da = GetByte(pix_ptr, 3)

        // Source channels
        sr = ShiftRight(color, 16)
        sr = BitwiseAnd(sr, 255)
        sg = ShiftRight(color, 8)
        sg = BitwiseAnd(sg, 255)
        sb = BitwiseAnd(color, 255)

        // Gamma-2.0 approximation for blending in linear space.
        // True sRGB's 2.4 exponent would need pow(); gamma-2.0
        // (square/sqrt) captures most of the quality win at zero
        // floating-point cost — edges between saturated colors stop
        // picking up the dark halo that sRGB-space blending produces.
        inv_sa = Subtract(255, sa)

        sr_lin = Divide(Multiply(sr, sr), 255)
        sg_lin = Divide(Multiply(sg, sg), 255)
        sb_lin = Divide(Multiply(sb, sb), 255)
        dr_lin = Divide(Multiply(dr, dr), 255)
        dg_lin = Divide(Multiply(dg, dg), 255)
        db_lin = Divide(Multiply(db, db), 255)

        // src-over in linear space.
        t1 = Multiply(sr_lin, sa)
        t2 = Multiply(dr_lin, inv_sa)
        or_lin = Divide(Add(t1, t2), 255)

        t1 = Multiply(sg_lin, sa)
        t2 = Multiply(dg_lin, inv_sa)
        og_lin = Divide(Add(t1, t2), 255)

        t1 = Multiply(sb_lin, sa)
        t2 = Multiply(db_lin, inv_sa)
        ob_lin = Divide(Add(t1, t2), 255)

        // Alpha stays in sRGB space — it's coverage, not light.
        t1 = Multiply(sa, 255)
        t2 = Multiply(da, inv_sa)
        oa = Divide(Add(t1, t2), 255)

        // Back to sRGB: sqrt(lin * 255).
        or_val = ISqrt(Multiply(or_lin, 255))
        og     = ISqrt(Multiply(og_lin, 255))
        ob     = ISqrt(Multiply(ob_lin, 255))

        // Clamp (ISqrt rounding can hit 256 edge in corner cases).
        IfCondition GreaterThan(or_val, 255) ThenBlock: { or_val = 255 }
        IfCondition GreaterThan(og, 255)     ThenBlock: { og = 255 }
        IfCondition GreaterThan(ob, 255)     ThenBlock: { ob = 255 }

        // Write blended pixel.
        SetByte(pix_ptr, 0, ob)
        SetByte(pix_ptr, 1, og)
        SetByte(pix_ptr, 2, or_val)
        SetByte(pix_ptr, 3, oa)
        ReturnValue(0)
    }
}

// =============================================================================
// SCANLINE FILL — with alpha blending
// =============================================================================
// TVG_ScanFill — coverage-based horizontal anti-aliasing.
//
// Edge intersections are kept as 256× fixed-point so we don't lose
// the fractional part at span boundaries. For each fill span the
// leftmost and rightmost pixels get proportional coverage instead of
// full opacity; interior pixels get full coverage like before.
// Sample at pixel center (y = row + 0.5) so edges land consistently
// relative to the scanline rather than the row's top.
Function.TVG_ScanFill {
    Input: r: Integer
    Input: g: Integer
    Input: b: Integer
    Input: a: Integer
    Body: {
        surf  = RastState.surf
        sw    = RastState.surf_w
        sh    = RastState.surf_h
        ec    = RastState.edge_count
        edges = RastState.edges
        color = TVG_PackColor(r, g, b, a)
        use_grad = GradState.active
        sw_fp = Multiply(sw, 256)

        row = 0
        WhileLoop LessThan(row, sh) {
            xs_buf = Allocate(512)
            xs_cnt = 0
            // Sample at row center (row + 0.5) in 256× fixed-point.
            row_fp = Add(Multiply(row, 256), 128)
            ei = 0
            WhileLoop LessThan(ei, ec) {
                off = Multiply(ei, RastConst.EDGE_SIZE)
                ep  = Add(edges, off)
                ex0 = Dereference(Add(ep, RastConst.EDGE_X0_OFS))
                ey0 = Dereference(Add(ep, RastConst.EDGE_Y0_OFS))
                ex1 = Dereference(Add(ep, RastConst.EDGE_X1_OFS))
                ey1 = Dereference(Add(ep, RastConst.EDGE_Y1_OFS))
                IfCondition GreaterThan(ey0, ey1) ThenBlock: {
                    tmp = ey0  ey0 = ey1  ey1 = tmp
                    tmp = ex0  ex0 = ex1  ex1 = tmp
                }
                // ey0/ey1/ex0/ex1 are all 256× fixed-point (courtesy
                // of TVG_ScaleX/Y); row_fp is also 256×, so comparisons
                // and interpolation stay in fp units throughout.
                IfCondition And(LessEqual(ey0, row_fp), LessThan(row_fp, ey1)) ThenBlock: {
                    dy = Subtract(ey1, ey0)
                    IfCondition NotEqual(dy, 0) ThenBlock: {
                        dx = Subtract(ex1, ex0)
                        dr_fp = Subtract(row_fp, ey0)
                        num = Multiply(dx, dr_fp)
                        // xi_fp = ex0 + (dx * dr_fp) / dy, all 256× fp.
                        xi_fp = Add(ex0, Divide(num, dy))
                        off2 = Multiply(xs_cnt, 8)
                        StoreValue(Add(xs_buf, off2), xi_fp)
                        xs_cnt = Add(xs_cnt, 1)
                    }
                }
                ei = Add(ei, 1)
            }
            // Bubble sort intersections (ascending).
            si = 0
            WhileLoop LessThan(si, xs_cnt) {
                sj = Add(si, 1)
                WhileLoop LessThan(sj, xs_cnt) {
                    oa = Multiply(si, 8)
                    ob = Multiply(sj, 8)
                    va = Dereference(Add(xs_buf, oa))
                    vb = Dereference(Add(xs_buf, ob))
                    IfCondition GreaterThan(va, vb) ThenBlock: {
                        StoreValue(Add(xs_buf, oa), vb)
                        StoreValue(Add(xs_buf, ob), va)
                    }
                    sj = Add(sj, 1)
                }
                si = Add(si, 1)
            }
            // Fill pairs with coverage at the span boundaries.
            lim = Subtract(xs_cnt, 1)
            pi = 0
            WhileLoop LessThan(pi, lim) {
                oa = Multiply(pi, 8)
                pi2 = Add(pi, 1)
                ob = Multiply(pi2, 8)
                xa_fp = Dereference(Add(xs_buf, oa))
                xb_fp = Dereference(Add(xs_buf, ob))
                IfCondition LessThan(xa_fp, 0) ThenBlock: { xa_fp = 0 }
                IfCondition GreaterThan(xb_fp, sw_fp) ThenBlock: { xb_fp = sw_fp }

                xa_int = Divide(xa_fp, 256)
                xa_frac = Subtract(xa_fp, Multiply(xa_int, 256))
                xb_int = Divide(xb_fp, 256)
                xb_frac = Subtract(xb_fp, Multiply(xb_int, 256))

                IfCondition EqualTo(xa_int, xb_int) ThenBlock: {
                    // Sub-pixel span — one pixel, coverage = width in fracs.
                    cov = Subtract(xb_frac, xa_frac)
                    IfCondition GreaterThan(cov, 0) ThenBlock: {
                        pcolor = color
                        IfCondition EqualTo(use_grad, 1) ThenBlock: {
                            pcolor = TVG_GradPixel(xa_int, row)
                        }
                        TVG_ScanFill_EmitPixel(surf, xa_int, row, pcolor, a, cov)
                    }
                } ElseBlock: {
                    // Left boundary pixel: coverage = 256 - xa_frac.
                    left_cov = Subtract(256, xa_frac)
                    IfCondition GreaterThan(left_cov, 0) ThenBlock: {
                        pcolor = color
                        IfCondition EqualTo(use_grad, 1) ThenBlock: {
                            pcolor = TVG_GradPixel(xa_int, row)
                        }
                        TVG_ScanFill_EmitPixel(surf, xa_int, row, pcolor, a, left_cov)
                    }
                    // Interior pixels: full coverage.
                    px = Add(xa_int, 1)
                    WhileLoop LessThan(px, xb_int) {
                        pcolor = color
                        IfCondition EqualTo(use_grad, 1) ThenBlock: {
                            pcolor = TVG_GradPixel(px, row)
                        }
                        TVG_ScanFill_EmitPixel(surf, px, row, pcolor, a, 256)
                        px = Add(px, 1)
                    }
                    // Right boundary pixel: coverage = xb_frac.
                    IfCondition GreaterThan(xb_frac, 0) ThenBlock: {
                        pcolor = color
                        IfCondition EqualTo(use_grad, 1) ThenBlock: {
                            pcolor = TVG_GradPixel(xb_int, row)
                        }
                        TVG_ScanFill_EmitPixel(surf, xb_int, row, pcolor, a, xb_frac)
                    }
                }
                pi = Add(pi, 2)
            }
            Deallocate(xs_buf, 512)
            row = Add(row, 1)
        }
        ReturnValue(0)
    }
}

// Helper: write one pixel with coverage (0..256 where 256 = full).
// Modulates source alpha by coverage, routes through TVG_BlendPixel.
// Opaque + full coverage takes the fast Draw_Pix_Pixel path.
Function.TVG_ScanFill_EmitPixel {
    Input: surf:  Integer
    Input: px:    Integer
    Input: row:   Integer
    Input: color: Integer
    Input: a:     Integer
    Input: cov:   Integer
    Body: {
        IfCondition And(EqualTo(a, 255), EqualTo(cov, 256)) ThenBlock: {
            Draw_Pix_Pixel(surf, px, row, color)
            ReturnValue(0)
        }
        eff_a = Divide(Multiply(a, cov), 256)
        IfCondition GreaterThan(eff_a, 255) ThenBlock: { eff_a = 255 }
        IfCondition LessThan(eff_a, 0) ThenBlock: { eff_a = 0 }
        // Replace the alpha byte of `color` (bits 24..31).
        rgb_mask = 16777215
        color_rgb = BitwiseAnd(color, rgb_mask)
        alpha_shifted = Multiply(eff_a, 16777216)
        new_color = BitwiseOr(color_rgb, alpha_shifted)
        TVG_BlendPixel(surf, px, row, new_color)
        ReturnValue(0)
    }
}

// =============================================================================
// GRADIENT STATE — set by TVG_ReadStyle for LINEAR/RADIAL
// =============================================================================
FixedPool.GradState {
    "active":  Initialize=0
    "kind":    Initialize=0
    "x0":      Initialize=0
    "y0":      Initialize=0
    "x1":      Initialize=0
    "y1":      Initialize=0
    "r0":      Initialize=0
    "g0":      Initialize=0
    "b0":      Initialize=0
    "a0":      Initialize=0
    "r1":      Initialize=0
    "g1":      Initialize=0
    "b1":      Initialize=0
    "a1":      Initialize=0
    "dx":      Initialize=0
    "dy":      Initialize=0
    "len_sq":  Initialize=0
}

// =============================================================================
// READ STYLE — returns packed BGRA color, sets GradState for gradients
// =============================================================================
Function.TVG_ReadStyle {
    Input: style_kind: Integer
    Output: Integer
    Body: {
        ct = TVGParse.color_table
        GradState.active = 0

        IfCondition EqualTo(style_kind, TVGStyleKind.FLAT) ThenBlock: {
            idx = TVG_ReadVarUInt()
            IfCondition GreaterEqual(idx, TVGParse.color_count) ThenBlock: {
                PrintMessage("[TVG] BAD color idx=")
                PrintNumber(idx)
                PrintMessage("\n")
                ReturnValue(0)
            }
            ofs = Multiply(idx, 4)
            r = GetByte(ct, ofs)
            t = Add(ofs, 1)
            g = GetByte(ct, t)
            t = Add(ofs, 2)
            b = GetByte(ct, t)
            t = Add(ofs, 3)
            a = GetByte(ct, t)
            ReturnValue(TVG_PackColor(r, g, b, a))
        }
        IfCondition EqualTo(style_kind, TVGStyleKind.LINEAR) ThenBlock: {
            raw = TVG_ReadUnit()
            gx0 = TVG_ScaleX(raw)
            raw = TVG_ReadUnit()
            gy0 = TVG_ScaleY(raw)
            raw = TVG_ReadUnit()
            gx1 = TVG_ScaleX(raw)
            raw = TVG_ReadUnit()
            gy1 = TVG_ScaleY(raw)
            idx0 = TVG_ReadVarUInt()
            idx1 = TVG_ReadVarUInt()

            GradState.active = 1
            GradState.kind   = 1
            GradState.x0     = gx0
            GradState.y0     = gy0
            GradState.x1     = gx1
            GradState.y1     = gy1

            gdx = Subtract(gx1, gx0)
            gdy = Subtract(gy1, gy0)
            GradState.dx     = gdx
            GradState.dy     = gdy
            t1 = Multiply(gdx, gdx)
            t2 = Multiply(gdy, gdy)
            GradState.len_sq = Add(t1, t2)

            ofs = Multiply(idx0, 4)
            GradState.r0 = GetByte(ct, ofs)
            t = Add(ofs, 1)
            GradState.g0 = GetByte(ct, t)
            t = Add(ofs, 2)
            GradState.b0 = GetByte(ct, t)
            t = Add(ofs, 3)
            GradState.a0 = GetByte(ct, t)

            ofs = Multiply(idx1, 4)
            GradState.r1 = GetByte(ct, ofs)
            t = Add(ofs, 1)
            GradState.g1 = GetByte(ct, t)
            t = Add(ofs, 2)
            GradState.b1 = GetByte(ct, t)
            t = Add(ofs, 3)
            GradState.a1 = GetByte(ct, t)

            // Return first color as fallback
            ReturnValue(TVG_PackColor(GradState.r0, GradState.g0, GradState.b0, GradState.a0))
        }
        IfCondition EqualTo(style_kind, TVGStyleKind.RADIAL) ThenBlock: {
            raw = TVG_ReadUnit()
            gx0 = TVG_ScaleX(raw)
            raw = TVG_ReadUnit()
            gy0 = TVG_ScaleY(raw)
            raw = TVG_ReadUnit()
            gx1 = TVG_ScaleX(raw)
            raw = TVG_ReadUnit()
            gy1 = TVG_ScaleY(raw)
            idx0 = TVG_ReadVarUInt()
            idx1 = TVG_ReadVarUInt()

            GradState.active = 1
            GradState.kind   = 2
            GradState.x0     = gx0
            GradState.y0     = gy0
            GradState.x1     = gx1
            GradState.y1     = gy1

            gdx = Subtract(gx1, gx0)
            gdy = Subtract(gy1, gy0)
            GradState.dx     = gdx
            GradState.dy     = gdy
            t1 = Multiply(gdx, gdx)
            t2 = Multiply(gdy, gdy)
            GradState.len_sq = Add(t1, t2)

            ofs = Multiply(idx0, 4)
            GradState.r0 = GetByte(ct, ofs)
            t = Add(ofs, 1)
            GradState.g0 = GetByte(ct, t)
            t = Add(ofs, 2)
            GradState.b0 = GetByte(ct, t)
            t = Add(ofs, 3)
            GradState.a0 = GetByte(ct, t)

            ofs = Multiply(idx1, 4)
            GradState.r1 = GetByte(ct, ofs)
            t = Add(ofs, 1)
            GradState.g1 = GetByte(ct, t)
            t = Add(ofs, 2)
            GradState.b1 = GetByte(ct, t)
            t = Add(ofs, 3)
            GradState.a1 = GetByte(ct, t)

            ReturnValue(TVG_PackColor(GradState.r0, GradState.g0, GradState.b0, GradState.a0))
        }
        ReturnValue(0)
    }
}

// =============================================================================
// FILL HELPER — unpack packed color and scanfill
// =============================================================================
Function.TVG_FillWithColor {
    Input: color: Integer
    Body: {
        b = BitwiseAnd(color, 255)
        t = ShiftRight(color, 8)
        g = BitwiseAnd(t, 255)
        t = ShiftRight(color, 16)
        r = BitwiseAnd(t, 255)
        t = ShiftRight(color, 24)
        a = BitwiseAnd(t, 255)
        TVG_ScanFill(r, g, b, a)
        ReturnValue(0)
    }
}

// =============================================================================
// FILL RECTANGLES
// =============================================================================
Function.TVG_CmdFillRects {
    Input: count: Integer
    Input: color: Integer
    Body: {
        i = 0
        WhileLoop LessThan(i, count) {
            raw = TVG_ReadUnit()
            rx = TVG_ScaleX(raw)
            raw = TVG_ReadUnit()
            ry = TVG_ScaleY(raw)
            raw = TVG_ReadUnit()
            rw = TVG_ScaleX(raw)
            raw = TVG_ReadUnit()
            rh = TVG_ScaleY(raw)
            x1 = Add(rx, rw)
            y1 = Add(ry, rh)
            RastState.edge_count = 0
            TVG_AddEdge(rx, ry, x1, ry)
            TVG_AddEdge(x1, ry, x1, y1)
            TVG_AddEdge(x1, y1, rx, y1)
            TVG_AddEdge(rx, y1, rx, ry)
            TVG_FillWithColor(color)
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

// =============================================================================
// FILL POLYGON
// =============================================================================
Function.TVG_CmdFillPolygon {
    Input: count: Integer
    Input: color: Integer
    Body: {
        i = 0
        WhileLoop LessThan(i, count) {
            nv_raw = TVG_ReadVarUInt()
            nv = Add(nv_raw, 1)
            RastState.edge_count = 0
            raw = TVG_ReadUnit()
            first_x = TVG_ScaleX(raw)
            raw = TVG_ReadUnit()
            first_y = TVG_ScaleY(raw)
            prev_x = first_x
            prev_y = first_y
            vi = 1
            WhileLoop LessThan(vi, nv) {
                raw = TVG_ReadUnit()
                cx = TVG_ScaleX(raw)
                raw = TVG_ReadUnit()
                cy = TVG_ScaleY(raw)
                TVG_AddEdge(prev_x, prev_y, cx, cy)
                prev_x = cx
                prev_y = cy
                vi = Add(vi, 1)
            }
            TVG_AddEdge(prev_x, prev_y, first_x, first_y)
            TVG_FillWithColor(color)
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

// =============================================================================
// FILL PATH — all segment types
// Spec: all segment lengths first, then all segment data
// =============================================================================
Function.TVG_CmdFillPath {
    Input: count: Integer
    Input: color: Integer
    Body: {
        RastState.edge_count = 0

        // Step 1: Read ALL segment lengths
        sl_sz = Multiply(count, 8)
        seg_lens = Allocate(sl_sz)
        i = 0
        WhileLoop LessThan(i, count) {
            slen_raw = TVG_ReadVarUInt()
            slen = Add(slen_raw, 1)
            off = Multiply(i, 8)
            StoreValue(Add(seg_lens, off), slen)
            i = Add(i, 1)
        }

        // Step 2: Read segment data
        i = 0
        WhileLoop LessThan(i, count) {
            off = Multiply(i, 8)
            nseg = Dereference(Add(seg_lens, off))

            raw = TVG_ReadUnit()
            cur_x = TVG_ScaleX(raw)
            raw2 = TVG_ReadUnit()
            cur_y = TVG_ScaleY(raw2)
            first_x = cur_x
            first_y = cur_y

            PrintMessage("  seg ")
            PrintNumber(i)
            PrintMessage(" start raw=(")
            PrintNumber(raw)
            PrintMessage(",")
            PrintNumber(raw2)
            PrintMessage(") scaled=(")
            PrintNumber(cur_x)
            PrintMessage(",")
            PrintNumber(cur_y)
            PrintMessage(")\n")

            si = 0
            WhileLoop LessThan(si, nseg) {
                // Bounds check
                IfCondition GreaterEqual(TVGParse.pos, TVGParse.size) ThenBlock: {
                    PrintMessage("[path] OVERRUN\n")
                    si = nseg
                    i  = count
                }
                IfCondition LessThan(TVGParse.pos, TVGParse.size) ThenBlock: {
                    tag   = TVG_ReadByte()
                    stype = BitwiseAnd(tag, 7)
                    t     = ShiftRight(tag, 4)
                    has_lw = BitwiseAnd(t, 1)
                    IfCondition EqualTo(has_lw, 1) ThenBlock: {
                        TVG_ReadUnit()
                    }

                    IfCondition EqualTo(stype, TVGSeg.LINE) ThenBlock: {
                        raw = TVG_ReadUnit()
                        nx = TVG_ScaleX(raw)
                        raw2 = TVG_ReadUnit()
                        ny = TVG_ScaleY(raw2)
                        PrintMessage("    LINE raw=(")
                        PrintNumber(raw)
                        PrintMessage(",")
                        PrintNumber(raw2)
                        PrintMessage(") -> (")
                        PrintNumber(nx)
                        PrintMessage(",")
                        PrintNumber(ny)
                        PrintMessage(")\n")
                        TVG_AddEdge(cur_x, cur_y, nx, ny)
                        cur_x = nx
                        cur_y = ny
                    }
                    IfCondition EqualTo(stype, TVGSeg.HORIZ) ThenBlock: {
                        raw = TVG_ReadUnit()
                        nx = TVG_ScaleX(raw)
                        PrintMessage("    HORIZ raw=")
                        PrintNumber(raw)
                        PrintMessage(" -> x=")
                        PrintNumber(nx)
                        PrintMessage("\n")
                        TVG_AddEdge(cur_x, cur_y, nx, cur_y)
                        cur_x = nx
                    }
                    IfCondition EqualTo(stype, TVGSeg.VERT) ThenBlock: {
                        raw = TVG_ReadUnit()
                        ny = TVG_ScaleY(raw)
                        PrintMessage("    VERT raw=")
                        PrintNumber(raw)
                        PrintMessage(" -> y=")
                        PrintNumber(ny)
                        PrintMessage("\n")
                        TVG_AddEdge(cur_x, cur_y, cur_x, ny)
                        cur_y = ny
                    }
                    IfCondition EqualTo(stype, TVGSeg.CUBIC) ThenBlock: {
                        raw = TVG_ReadUnit()
                        c1x = TVG_ScaleX(raw)
                        raw = TVG_ReadUnit()
                        c1y = TVG_ScaleY(raw)
                        raw = TVG_ReadUnit()
                        c2x = TVG_ScaleX(raw)
                        raw = TVG_ReadUnit()
                        c2y = TVG_ScaleY(raw)
                        raw = TVG_ReadUnit()
                        ex  = TVG_ScaleX(raw)
                        raw = TVG_ReadUnit()
                        ey  = TVG_ScaleY(raw)
                        PrintMessage("    CUBIC -> (")
                        PrintNumber(ex)
                        PrintMessage(",")
                        PrintNumber(ey)
                        PrintMessage(")\n")
                        TVG_BezSetEnd(ex, ey)
                        TVG_FlattenCubic(cur_x, cur_y, c1x, c1y, c2x, c2y)
                        cur_x = ex
                        cur_y = ey
                    }
                    IfCondition EqualTo(stype, TVGSeg.ARC_CIRC) ThenBlock: {
                        TVG_ReadByte()
                        TVG_ReadUnit()
                        raw = TVG_ReadUnit()
                        nx = TVG_ScaleX(raw)
                        raw = TVG_ReadUnit()
                        ny = TVG_ScaleY(raw)
                        TVG_AddEdge(cur_x, cur_y, nx, ny)
                        cur_x = nx
                        cur_y = ny
                    }
                    IfCondition EqualTo(stype, TVGSeg.ARC_ELLIP) ThenBlock: {
                        TVG_ReadByte()
                        TVG_ReadUnit()
                        TVG_ReadUnit()
                        TVG_ReadUnit()
                        raw = TVG_ReadUnit()
                        nx = TVG_ScaleX(raw)
                        raw = TVG_ReadUnit()
                        ny = TVG_ScaleY(raw)
                        TVG_AddEdge(cur_x, cur_y, nx, ny)
                        cur_x = nx
                        cur_y = ny
                    }
                    IfCondition EqualTo(stype, TVGSeg.CLOSE) ThenBlock: {
                        TVG_AddEdge(cur_x, cur_y, first_x, first_y)
                        cur_x = first_x
                        cur_y = first_y
                    }
                    IfCondition EqualTo(stype, TVGSeg.QUAD) ThenBlock: {
                        raw = TVG_ReadUnit()
                        qcx = TVG_ScaleX(raw)
                        raw = TVG_ReadUnit()
                        qcy = TVG_ScaleY(raw)
                        raw = TVG_ReadUnit()
                        ex  = TVG_ScaleX(raw)
                        raw = TVG_ReadUnit()
                        ey  = TVG_ScaleY(raw)
                        t1 = Multiply(2, qcx)
                        t2 = Add(cur_x, t1)
                        c1x = Divide(t2, 3)
                        t1 = Multiply(2, qcy)
                        t2 = Add(cur_y, t1)
                        c1y = Divide(t2, 3)
                        t1 = Multiply(2, qcx)
                        t2 = Add(ex, t1)
                        c2x = Divide(t2, 3)
                        t1 = Multiply(2, qcy)
                        t2 = Add(ey, t1)
                        c2y = Divide(t2, 3)
                        TVG_BezSetEnd(ex, ey)
                        TVG_FlattenCubic(cur_x, cur_y, c1x, c1y, c2x, c2y)
                        cur_x = ex
                        cur_y = ey
                    }
                }
                si = Add(si, 1)
            }
            // Auto-close: if cur != first, add closing edge
            need_close = 0
            IfCondition NotEqual(cur_x, first_x) ThenBlock: { need_close = 1 }
            IfCondition NotEqual(cur_y, first_y) ThenBlock: { need_close = 1 }
            IfCondition EqualTo(need_close, 1) ThenBlock: {
                TVG_AddEdge(cur_x, cur_y, first_x, first_y)
            }
            i = Add(i, 1)
        }
        Deallocate(seg_lens, sl_sz)
        TVG_FillWithColor(color)
        ReturnValue(0)
    }
}

// =============================================================================
// HEADER + COLOR TABLE PARSER
// =============================================================================
Function.TVG_ParseHeader {
    Output: Integer
    Body: {
        ver = TVG_ReadByte()
        IfCondition NotEqual(ver, 1) ThenBlock: {
            PrintMessage("[TVG] bad version\n")
            ReturnValue(0)
        }
        flags = TVG_ReadByte()
        TVGParse.scale_bits  = BitwiseAnd(flags, 15)
        t = ShiftRight(flags, 4)
        TVGParse.color_enc   = BitwiseAnd(t, 3)
        t = ShiftRight(flags, 6)
        TVGParse.coord_range = BitwiseAnd(t, 3)
        cb = 2
        IfCondition EqualTo(TVGParse.coord_range, TVGCoordRange.I8) ThenBlock: { cb = 1 }
        IfCondition EqualTo(TVGParse.coord_range, TVGCoordRange.I32) ThenBlock: { cb = 4 }
        TVGParse.coord_bytes = cb

        TVGParse.width  = TVG_ReadUnit()
        TVGParse.height = TVG_ReadUnit()

        nc = TVG_ReadVarUInt()
        TVGParse.color_count = nc

        ct_sz = Multiply(nc, 4)
        ct = Allocate(ct_sz)
        IfCondition EqualTo(ct, 0) ThenBlock: {
            PrintMessage("[TVG] color table alloc fail\n")
            ReturnValue(0)
        }
        TVGParse.color_table = ct
        ci = 0
        WhileLoop LessThan(ci, nc) {
            ofs = Multiply(ci, 4)
            b0 = TVG_ReadByte()
            SetByte(ct, ofs, b0)
            t = Add(ofs, 1)
            b1 = TVG_ReadByte()
            SetByte(ct, t, b1)
            t = Add(ofs, 2)
            b2 = TVG_ReadByte()
            SetByte(ct, t, b2)
            t = Add(ofs, 3)
            b3 = TVG_ReadByte()
            SetByte(ct, t, b3)
            ci = Add(ci, 1)
        }

        PrintMessage("[TVG] v1 ")
        PrintNumber(TVGParse.width)
        PrintMessage("x")
        PrintNumber(TVGParse.height)
        PrintMessage(" scale=")
        PrintNumber(TVGParse.scale_bits)
        PrintMessage(" colors=")
        PrintNumber(nc)
        PrintMessage(" coord_range=")
        PrintNumber(TVGParse.coord_range)
        PrintMessage(" pos=")
        PrintNumber(TVGParse.pos)
        PrintMessage("\n")

        // Dump color table
        di = 0
        WhileLoop LessThan(di, nc) {
            dofs = Multiply(di, 4)
            PrintMessage("[color ")
            PrintNumber(di)
            PrintMessage("] r=")
            PrintNumber(GetByte(ct, dofs))
            t = Add(dofs, 1)
            PrintMessage(" g=")
            PrintNumber(GetByte(ct, t))
            t = Add(dofs, 2)
            PrintMessage(" b=")
            PrintNumber(GetByte(ct, t))
            t = Add(dofs, 3)
            PrintMessage(" a=")
            PrintNumber(GetByte(ct, t))
            PrintMessage("\n")
            di = Add(di, 1)
        }

        ReturnValue(1)
    }
}

Function.TVG_GradPixel {
    Input: px: Integer
    Input: py: Integer
    Output: Integer
    Body: {
        ls = GradState.len_sq
        IfCondition EqualTo(ls, 0) ThenBlock: {
            ReturnValue(TVG_PackColor(GradState.r0, GradState.g0, GradState.b0, GradState.a0))
        }

        frac = 0

        IfCondition EqualTo(GradState.kind, 1) ThenBlock: {
            // px/py are pixel coords; GradState coords are 256x fp
            px_fp = Multiply(px, 256)
            py_fp = Multiply(py, 256)
            apx = Subtract(px_fp, GradState.x0)
            apy = Subtract(py_fp, GradState.y0)
            t1 = Multiply(apx, GradState.dx)
            t2 = Multiply(apy, GradState.dy)
            dot = Add(t1, t2)
            num = Multiply(dot, 255)
            frac = Divide(num, ls)
            IfCondition LessThan(frac, 0) ThenBlock: { frac = 0 }
            IfCondition GreaterThan(frac, 255) ThenBlock: { frac = 255 }
        }
        IfCondition EqualTo(GradState.kind, 2) ThenBlock: {
            px_fp = Multiply(px, 256)
            py_fp = Multiply(py, 256)
            apx = Subtract(px_fp, GradState.x0)
            apy = Subtract(py_fp, GradState.y0)
            t1 = Multiply(apx, apx)
            t2 = Multiply(apy, apy)
            dist_sq = Add(t1, t2)
            num = Multiply(dist_sq, 65025)
            frac_sq = Divide(num, ls)
            frac = 128
            t1 = Divide(frac_sq, frac)
            frac = Add(frac, t1)
            frac = Divide(frac, 2)
            t1 = Divide(frac_sq, frac)
            frac = Add(frac, t1)
            frac = Divide(frac, 2)
            t1 = Divide(frac_sq, frac)
            frac = Add(frac, t1)
            frac = Divide(frac, 2)
            IfCondition LessThan(frac, 0) ThenBlock: { frac = 0 }
            IfCondition GreaterThan(frac, 255) ThenBlock: { frac = 255 }
        }

        inv = Subtract(255, frac)
        t1 = Multiply(GradState.r0, inv)
        t2 = Multiply(GradState.r1, frac)
        or_val = Divide(Add(t1, t2), 255)
        t1 = Multiply(GradState.g0, inv)
        t2 = Multiply(GradState.g1, frac)
        og = Divide(Add(t1, t2), 255)
        t1 = Multiply(GradState.b0, inv)
        t2 = Multiply(GradState.b1, frac)
        ob = Divide(Add(t1, t2), 255)
        t1 = Multiply(GradState.a0, inv)
        t2 = Multiply(GradState.a1, frac)
        oa = Divide(Add(t1, t2), 255)

        ReturnValue(TVG_PackColor(or_val, og, ob, oa))
    }
}

// =============================================================================
// COMMAND DISPATCH
// cmd_byte: bits 0-5 = cmd_id, bits 6-7 = prim_style_kind
// =============================================================================
Function.TVG_Render {
    Input: render_size: Integer
    Output: Integer
    Body: {
        // render_size = desired height in pixels
        // width computed from aspect ratio: render_w = width * render_size / height
        tvg_w = TVGParse.width
        tvg_h = TVGParse.height
        IfCondition EqualTo(tvg_h, 0) ThenBlock: { ReturnValue(0) }

        render_h = render_size
        num = Multiply(tvg_w, render_size)
        render_w = Divide(num, tvg_h)
        IfCondition LessEqual(render_w, 0) ThenBlock: { render_w = 1 }

        surf = Surface_Create(SurfaceFormat.PIXEL_32, render_w, render_h)
        IfCondition EqualTo(surf, 0) ThenBlock: { ReturnValue(0) }
        Draw_Pix_FillRect(surf, 0, 0, render_w, render_h, 0)
        RastState.surf   = surf
        RastState.surf_w = render_w
        RastState.surf_h = render_h
        TVGParse.render_size = render_size

        done = 0
        WhileLoop EqualTo(done, 0) {
            IfCondition GreaterEqual(TVGParse.pos, TVGParse.size) ThenBlock: { done = 1 }
            IfCondition LessThan(TVGParse.pos, TVGParse.size) ThenBlock: {
                cmd_byte   = TVG_ReadByte()
                cmd_id     = BitwiseAnd(cmd_byte, 63)
                t          = ShiftRight(cmd_byte, 6)
                style_kind = BitwiseAnd(t, 3)

                PrintMessage("[TVG] cmd=")
                PrintNumber(cmd_id)
                PrintMessage(" sk=")
                PrintNumber(style_kind)
                PrintMessage(" pos=")
                PrintNumber(TVGParse.pos)
                PrintMessage("\n")

                // cmd 0 = END
                IfCondition EqualTo(cmd_id, TVGCmd.END) ThenBlock: {
                    done = 1
                }

                // cmd 1 = FILL POLYGON
                IfCondition EqualTo(cmd_id, TVGCmd.FILL_POLY) ThenBlock: {
                    cnt_raw = TVG_ReadVarUInt()
                    count = Add(cnt_raw, 1)
                    color = TVG_ReadStyle(style_kind)
                    TVG_CmdFillPolygon(count, color)
                }

                // cmd 2 = FILL RECTANGLES
                IfCondition EqualTo(cmd_id, TVGCmd.FILL_RECT) ThenBlock: {
                    cnt_raw = TVG_ReadVarUInt()
                    count = Add(cnt_raw, 1)
                    color = TVG_ReadStyle(style_kind)
                    TVG_CmdFillRects(count, color)
                }

                // cmd 3 = FILL PATH
                IfCondition EqualTo(cmd_id, TVGCmd.FILL_PATH) ThenBlock: {
                    cnt_raw = TVG_ReadVarUInt()
                    count = Add(cnt_raw, 1)
                    color = TVG_ReadStyle(style_kind)
                    PrintMessage("  fill_path segs=")
                    PrintNumber(count)
                    PrintMessage(" color=")
                    cb0 = ShiftRight(color, 16)
                    cb0 = BitwiseAnd(cb0, 255)
                    PrintNumber(cb0)
                    PrintMessage(",")
                    cb1 = ShiftRight(color, 8)
                    cb1 = BitwiseAnd(cb1, 255)
                    PrintNumber(cb1)
                    PrintMessage(",")
                    cb2 = BitwiseAnd(color, 255)
                    PrintNumber(cb2)
                    PrintMessage(",")
                    cb3 = ShiftRight(color, 24)
                    cb3 = BitwiseAnd(cb3, 255)
                    PrintNumber(cb3)
                    PrintMessage(" edges_before=")
                    PrintNumber(RastState.edge_count)
                    PrintMessage("\n")
                    TVG_CmdFillPath(count, color)
                    PrintMessage("  edges_after=")
                    PrintNumber(RastState.edge_count)
                    PrintMessage("\n")
                }

                // cmd 4 = DRAW LINES
                IfCondition EqualTo(cmd_id, TVGCmd.DRAW_LINES) ThenBlock: {
                    cnt_raw = TVG_ReadVarUInt()
                    count = Add(cnt_raw, 1)
                    color = TVG_ReadStyle(style_kind)
                    TVG_ReadUnit()
                    li = 0
                    WhileLoop LessThan(li, count) {
                        TVG_ReadUnit()
                        TVG_ReadUnit()
                        TVG_ReadUnit()
                        TVG_ReadUnit()
                        li = Add(li, 1)
                    }
                }

                // cmd 5 = DRAW LINE LOOP
                IfCondition EqualTo(cmd_id, TVGCmd.DRAW_LINE_LOOP) ThenBlock: {
                    cnt_raw = TVG_ReadVarUInt()
                    count = Add(cnt_raw, 1)
                    color = TVG_ReadStyle(style_kind)
                    TVG_ReadUnit()
                    TVG_CmdFillPolygon(count, color)
                }

                // cmd 6 = DRAW LINE STRIP
                IfCondition EqualTo(cmd_id, TVGCmd.DRAW_LINE_STRIP) ThenBlock: {
                    cnt_raw = TVG_ReadVarUInt()
                    count = Add(cnt_raw, 1)
                    color = TVG_ReadStyle(style_kind)
                    TVG_ReadUnit()
                    li = 0
                    WhileLoop LessThan(li, count) {
                        TVG_ReadUnit()
                        TVG_ReadUnit()
                        li = Add(li, 1)
                    }
                }

                // cmd 7 = DRAW LINE PATH
                IfCondition EqualTo(cmd_id, TVGCmd.DRAW_LINE_PATH) ThenBlock: {
                    cnt_raw = TVG_ReadVarUInt()
                    count = Add(cnt_raw, 1)
                    color = TVG_ReadStyle(style_kind)
                    TVG_ReadUnit()
                    TVG_CmdFillPath(count, color)
                }

                // OL_* = "fill AND stroke the same path".
                // Strategy: snapshot the TVG read position after
                // consuming the header, parse the path once in fill
                // mode with fill_color, rewind to the snapshot, parse
                // again in stroke mode with line_color. Both passes
                // see identical path data; their edge lists are
                // rasterized in sequence inside the respective
                // TVG_CmdFill* functions.

                IfCondition EqualTo(cmd_id, TVGCmd.OL_POLY) ThenBlock: {
                    ol_byte    = TVG_ReadByte()
                    ol_count   = BitwiseAnd(ol_byte, 63)
                    ol_count   = Add(ol_count, 1)
                    t          = ShiftRight(ol_byte, 6)
                    sec_kind   = BitwiseAnd(t, 3)
                    fill_color = TVG_ReadStyle(style_kind)
                    line_color = TVG_ReadStyle(sec_kind)
                    lw_raw = TVG_ReadUnit()
                    lw_fp = TVG_ScaleX(lw_raw)
                    hw = Divide(lw_fp, 2)
                    IfCondition LessThan(hw, 128) ThenBlock: { hw = 128 }
                    // Snapshot position AFTER header parsing so both
                    // passes read the path body from the same offset.
                    body_pos = TVGParse.pos
                    // Fill pass.
                    TVG_CmdFillPolygon(ol_count, fill_color)
                    // Rewind + stroke pass.
                    TVGParse.pos = body_pos
                    StrokeState.active = 1
                    StrokeState.half_width = hw
                    TVG_CmdFillPolygon(ol_count, line_color)
                    StrokeState.active = 0
                }

                IfCondition EqualTo(cmd_id, TVGCmd.OL_RECT) ThenBlock: {
                    ol_byte    = TVG_ReadByte()
                    ol_count   = BitwiseAnd(ol_byte, 63)
                    ol_count   = Add(ol_count, 1)
                    t          = ShiftRight(ol_byte, 6)
                    sec_kind   = BitwiseAnd(t, 3)
                    fill_color = TVG_ReadStyle(style_kind)
                    line_color = TVG_ReadStyle(sec_kind)
                    lw_raw = TVG_ReadUnit()
                    lw_fp = TVG_ScaleX(lw_raw)
                    hw = Divide(lw_fp, 2)
                    IfCondition LessThan(hw, 128) ThenBlock: { hw = 128 }
                    body_pos = TVGParse.pos
                    TVG_CmdFillRects(ol_count, fill_color)
                    TVGParse.pos = body_pos
                    StrokeState.active = 1
                    StrokeState.half_width = hw
                    TVG_CmdFillRects(ol_count, line_color)
                    StrokeState.active = 0
                }

                IfCondition EqualTo(cmd_id, TVGCmd.OL_PATH) ThenBlock: {
                    ol_byte    = TVG_ReadByte()
                    ol_count   = BitwiseAnd(ol_byte, 63)
                    ol_count   = Add(ol_count, 1)
                    t          = ShiftRight(ol_byte, 6)
                    sec_kind   = BitwiseAnd(t, 3)
                    fill_color = TVG_ReadStyle(style_kind)
                    line_color = TVG_ReadStyle(sec_kind)
                    lw_raw = TVG_ReadUnit()
                    lw_fp = TVG_ScaleX(lw_raw)
                    hw = Divide(lw_fp, 2)
                    IfCondition LessThan(hw, 128) ThenBlock: { hw = 128 }
                    body_pos = TVGParse.pos
                    TVG_CmdFillPath(ol_count, fill_color)
                    TVGParse.pos = body_pos
                    StrokeState.active = 1
                    StrokeState.half_width = hw
                    TVG_CmdFillPath(ol_count, line_color)
                    StrokeState.active = 0
                }

                // Unknown — stop
                IfCondition GreaterThan(cmd_id, 10) ThenBlock: {
                    PrintMessage("[TVG] unknown cmd=")
                    PrintNumber(cmd_id)
                    PrintMessage(" stopping\n")
                    done = 1
                }
            }
        }
        PrintMessage("[TVG] render complete\n")
        ReturnValue(surf)
    }
}

// =============================================================================
// TOP-LEVEL ENTRY
// =============================================================================
Function.TVG_Parse {
    Input:  data: Integer
    Input:  size: Integer
    Input:  render_size: Integer
    Output: Integer
    Body: {
        TVGParse.data = data
        TVGParse.size = size
        TVGParse.pos  = 0
        m0 = GetByte(data, 0)
        m1 = GetByte(data, 1)
        is_tvg = 0
        IfCondition EqualTo(m0, TVGMagic.M0) ThenBlock: {
            IfCondition EqualTo(m1, TVGMagic.M1) ThenBlock: { is_tvg = 1 }
        }
        IfCondition EqualTo(is_tvg, 0) ThenBlock: {
            PrintMessage("[TVG] bad magic\n")
            ReturnValue(0)
        }
        TVGParse.pos = 2
        ok = TVG_ParseHeader()
        IfCondition EqualTo(ok, 0) ThenBlock: { ReturnValue(0) }
        surf = TVG_Render(render_size)
        ReturnValue(surf)
    }
}

// =============================================================================
// SHUTDOWN
// =============================================================================
Function.VIF_Shutdown {
    Output: Integer
    Body: {
        ct = TVGParse.color_table
        IfCondition NotEqual(ct, 0) ThenBlock: {
            ct_sz = Multiply(TVGParse.color_count, 4)
            Deallocate(ct, ct_sz)
            TVGParse.color_table = 0
        }
        PrintMessage("[VIF] shutdown\n")
        ReturnValue(1)
    }
}