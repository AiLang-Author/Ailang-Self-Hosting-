// =============================================================================
// CACHE TABLE — 192 bytes per entry
// =============================================================================
FixedPool.VIFCache {
    "data":  Initialize=0
    "count": Initialize=0
}
FixedPool.VIFCacheConst {
    "TYPE_OFS":        Initialize=0
    "NAME_OFS":        Initialize=8
    "NAME_MAX":        Initialize=64
    "CODEPOINT_OFS":   Initialize=72
    "FAMILY_IDX_OFS":  Initialize=80
    "SURFS_OFS":       Initialize=88
    "FRAMES_PTR_OFS":  Initialize=128
    "FRAME_COUNT_OFS": Initialize=136
    "TICK_RATE_OFS":   Initialize=144
    "LOOP_MODE_OFS":   Initialize=152
    "RAW_PTR_OFS":     Initialize=160
    "RAW_LEN_OFS":     Initialize=168
    "RENDER_SIZE_OFS": Initialize=176
    "ENTRY_SIZE":      Initialize=192
}

