// Library.VulkanClient.ailang — host Vulkan client for any AILang program
//
// Application portal. Not a GPU driver. Not CAD.
//
//   LibraryImport.VulkanClient
//
// Spawns CAD/display3d/vk_worker (links libailang_display3d.so) and talks
// a framed binary protocol. Works on lavapipe tonight and RADV/amdgpu
// when a real ICD is present. Display.Render.Vulkan stays the unused
// driver-folder portal.
//
// SysV: ≤5 Inputs. Handles are Allocate'd headers (Display-style).
// 0 = none / fail. Return 0 = OK on status-returning calls.
//
// Copyright (c) 2025-2026 Sean Collins, 2 Paws Machine and Engineering. All rights reserved.
// Licensed under the Sean Collins Software License (SCSL v1.0).

LibraryImport.Arena

FixedPool.VkCSys {
    "READ":   Initialize=0
    "WRITE":  Initialize=1
    "OPEN":   Initialize=2
    "CLOSE":  Initialize=3
    "PIPE":   Initialize=22
    "DUP2":   Initialize=33
    "FORK":   Initialize=57
    "EXECVE": Initialize=59
    "EXIT":   Initialize=60
}

FixedPool.VkCOp {
    "INIT":     Initialize=1
    "TARGET":   Initialize=2
    "PIPE":     Initialize=3
    "BUF":      Initialize=4
    "UPLOAD":   Initialize=5
    "BEGIN":    Initialize=6
    "BIND":     Initialize=7
    "DRAW":     Initialize=8
    "END":      Initialize=9
    "READBACK": Initialize=10
    "READY":    Initialize=11
    "INFO":     Initialize=12
    "QUIT":     Initialize=13
}

FixedPool.VkCHdr {
    "BYTES":    Initialize=64
    "WFD":      Initialize=0
    "RFD":      Initialize=8
    "PID":      Initialize=16
    "STATUS":   Initialize=24
    "REPLY":    Initialize=32
    "REPLY_N":  Initialize=40
    "MAGIC":    Initialize=48
}

FixedPool.VkClient {
    "MAGIC": Initialize=0x31434B56
}

Function.VulkanClient__Zero {
    Input: addr: Integer
    Input: nbytes: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(addr, 0) ThenBlock: { ReturnValue(-1) }
        i = 0
        WhileLoop LessThan(i, nbytes) {
            SetByte(addr, i, 0)
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

Function.VulkanClient__W32 {
    Input: p: Address
    Input: off: Integer
    Input: val: Integer
    Output: Integer
    Body: {
        SetByte(p, off, BitwiseAnd(val, 255))
        SetByte(p, Add(off, 1), BitwiseAnd(ShiftRight(val, 8), 255))
        SetByte(p, Add(off, 2), BitwiseAnd(ShiftRight(val, 16), 255))
        SetByte(p, Add(off, 3), BitwiseAnd(ShiftRight(val, 24), 255))
        ReturnValue(0)
    }
}

Function.VulkanClient__R32 {
    Input: p: Address
    Input: off: Integer
    Output: Integer
    Body: {
        b0 = GetByte(p, off)
        b1 = GetByte(p, Add(off, 1))
        b2 = GetByte(p, Add(off, 2))
        b3 = GetByte(p, Add(off, 3))
        v = BitwiseOr(b0, ShiftLeft(b1, 8))
        v = BitwiseOr(v, ShiftLeft(b2, 16))
        v = BitwiseOr(v, ShiftLeft(b3, 24))
        ReturnValue(v)
    }
}

Function.VulkanClient__WriteAll {
    Input: fd: Integer
    Input: ptr: Address
    Input: nbytes: Integer
    Output: Integer
    Body: {
        off = 0
        WhileLoop LessThan(off, nbytes) {
            n = SystemCall(VkCSys.WRITE, fd, Add(ptr, off), Subtract(nbytes, off), 0, 0)
            IfCondition LessEqual(n, 0) ThenBlock: { ReturnValue(-1) }
            off = Add(off, n)
        }
        ReturnValue(0)
    }
}

Function.VulkanClient__ReadAll {
    Input: fd: Integer
    Input: ptr: Address
    Input: nbytes: Integer
    Output: Integer
    Body: {
        off = 0
        WhileLoop LessThan(off, nbytes) {
            n = SystemCall(VkCSys.READ, fd, Add(ptr, off), Subtract(nbytes, off), 0, 0)
            IfCondition LessEqual(n, 0) ThenBlock: { ReturnValue(-1) }
            off = Add(off, n)
        }
        ReturnValue(0)
    }
}

// Send op+payload, stash reply payload on the handle (caller does not free).
Function.VulkanClient__Call {
    Input: handle: Integer
    Input: op: Integer
    Input: payload: Address
    Input: nbytes: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(handle, 0) ThenBlock: { ReturnValue(-1) }
        mag = Dereference(Add(handle, VkCHdr.MAGIC))
        IfCondition NotEqual(mag, VkClient.MAGIC) ThenBlock: { ReturnValue(-1) }
        wfd = Dereference(Add(handle, VkCHdr.WFD))
        rfd = Dereference(Add(handle, VkCHdr.RFD))

        hdr = Allocate(12)
        VulkanClient__Zero(hdr, 12)
        VulkanClient__W32(hdr, 0, VkClient.MAGIC)
        VulkanClient__W32(hdr, 4, op)
        VulkanClient__W32(hdr, 8, nbytes)
        wr = VulkanClient__WriteAll(wfd, hdr, 12)
        Deallocate(hdr, 12)
        IfCondition NotEqual(wr, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition GreaterThan(nbytes, 0) ThenBlock: {
            IfCondition EqualTo(payload, 0) ThenBlock: { ReturnValue(-1) }
            IfCondition NotEqual(VulkanClient__WriteAll(wfd, payload, nbytes), 0) ThenBlock: {
                ReturnValue(-1)
            }
        }

        rh = Allocate(12)
        IfCondition NotEqual(VulkanClient__ReadAll(rfd, rh, 12), 0) ThenBlock: {
            Deallocate(rh, 12)
            ReturnValue(-1)
        }
        rm = VulkanClient__R32(rh, 0)
        st = VulkanClient__R32(rh, 4)
        rn = VulkanClient__R32(rh, 8)
        Deallocate(rh, 12)
        IfCondition NotEqual(rm, VkClient.MAGIC) ThenBlock: { ReturnValue(-1) }

        old = Dereference(Add(handle, VkCHdr.REPLY))
        IfCondition NotEqual(old, 0) ThenBlock: {
            oldn = Dereference(Add(handle, VkCHdr.REPLY_N))
            IfCondition GreaterThan(oldn, 0) ThenBlock: {
                Deallocate(old, oldn)
            }
        }
        StoreValue(Add(handle, VkCHdr.REPLY), 0)
        StoreValue(Add(handle, VkCHdr.REPLY_N), 0)
        StoreValue(Add(handle, VkCHdr.STATUS), st)

        IfCondition GreaterThan(rn, 0) ThenBlock: {
            rb = Allocate(rn)
            IfCondition EqualTo(rb, 0) ThenBlock: { ReturnValue(-1) }
            IfCondition NotEqual(VulkanClient__ReadAll(rfd, rb, rn), 0) ThenBlock: {
                Deallocate(rb, rn)
                ReturnValue(-1)
            }
            StoreValue(Add(handle, VkCHdr.REPLY), rb)
            StoreValue(Add(handle, VkCHdr.REPLY_N), rn)
        }
        ReturnValue(st)
    }
}

Function.VulkanClient.Open {
    Input: worker_path: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(worker_path, 0) ThenBlock: { ReturnValue(0) }

        in_pf = Allocate(8)
        VulkanClient__Zero(in_pf, 8)
        ipr = SystemCall(VkCSys.PIPE, in_pf, 0, 0, 0, 0)
        IfCondition LessThan(ipr, 0) ThenBlock: {
            Deallocate(in_pf, 8)
            ReturnValue(0)
        }
        in_read = Dereference(in_pf, "dword")
        in_write = Dereference(Add(in_pf, 4), "dword")
        Deallocate(in_pf, 8)

        out_pf = Allocate(8)
        VulkanClient__Zero(out_pf, 8)
        opr = SystemCall(VkCSys.PIPE, out_pf, 0, 0, 0, 0)
        IfCondition LessThan(opr, 0) ThenBlock: {
            SystemCall(VkCSys.CLOSE, in_read, 0, 0, 0, 0)
            SystemCall(VkCSys.CLOSE, in_write, 0, 0, 0, 0)
            Deallocate(out_pf, 8)
            ReturnValue(0)
        }
        out_read = Dereference(out_pf, "dword")
        out_write = Dereference(Add(out_pf, 4), "dword")
        Deallocate(out_pf, 8)

        argv = Allocate(16)
        StoreValue(argv, worker_path)
        StoreValue(Add(argv, 8), 0)

        pid = SystemCall(VkCSys.FORK, 0, 0, 0, 0, 0)
        IfCondition LessThan(pid, 0) ThenBlock: {
            SystemCall(VkCSys.CLOSE, in_read, 0, 0, 0, 0)
            SystemCall(VkCSys.CLOSE, in_write, 0, 0, 0, 0)
            SystemCall(VkCSys.CLOSE, out_read, 0, 0, 0, 0)
            SystemCall(VkCSys.CLOSE, out_write, 0, 0, 0, 0)
            Deallocate(argv, 16)
            ReturnValue(0)
        }

        IfCondition EqualTo(pid, 0) ThenBlock: {
            SystemCall(VkCSys.CLOSE, in_write, 0, 0, 0, 0)
            SystemCall(VkCSys.CLOSE, out_read, 0, 0, 0, 0)
            SystemCall(VkCSys.DUP2, in_read, 0, 0, 0, 0)
            SystemCall(VkCSys.CLOSE, in_read, 0, 0, 0, 0)
            SystemCall(VkCSys.DUP2, out_write, 1, 0, 0, 0)
            SystemCall(VkCSys.CLOSE, out_write, 0, 0, 0, 0)
            SystemCall(VkCSys.EXECVE, worker_path, argv, 0)
            SystemCall(VkCSys.EXIT, 1, 0, 0, 0, 0)
        }

        SystemCall(VkCSys.CLOSE, in_read, 0, 0, 0, 0)
        SystemCall(VkCSys.CLOSE, out_write, 0, 0, 0, 0)
        Deallocate(argv, 16)

        h = Allocate(VkCHdr.BYTES)
        IfCondition EqualTo(h, 0) ThenBlock: { ReturnValue(0) }
        VulkanClient__Zero(h, VkCHdr.BYTES)
        StoreValue(Add(h, VkCHdr.WFD), in_write)
        StoreValue(Add(h, VkCHdr.RFD), out_read)
        StoreValue(Add(h, VkCHdr.PID), pid)
        StoreValue(Add(h, VkCHdr.MAGIC), VkClient.MAGIC)
        ReturnValue(h)
    }
}

Function.VulkanClient.Init {
    Input: handle: Integer
    Input: app_name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(app_name, 0) ThenBlock: { ReturnValue(-1) }
        n = StringLength(app_name)
        ReturnValue(VulkanClient__Call(handle, VkCOp.INIT, app_name, n))
    }
}

Function.VulkanClient.CreateTarget {
    Input: handle: Integer
    Input: width: Integer
    Input: height: Integer
    Output: Integer
    Body: {
        p = Allocate(8)
        VulkanClient__Zero(p, 8)
        VulkanClient__W32(p, 0, width)
        VulkanClient__W32(p, 4, height)
        st = VulkanClient__Call(handle, VkCOp.TARGET, p, 8)
        Deallocate(p, 8)
        ReturnValue(st)
    }
}

Function.VulkanClient.CreateDefaultPipeline {
    Input: handle: Integer
    Output: Integer
    Body: {
        st = VulkanClient__Call(handle, VkCOp.PIPE, 0, 0)
        IfCondition NotEqual(st, 0) ThenBlock: { ReturnValue(0) }
        rb = Dereference(Add(handle, VkCHdr.REPLY))
        IfCondition EqualTo(rb, 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(VulkanClient__R32(rb, 0))
    }
}

Function.VulkanClient.CreateBuffer {
    Input: handle: Integer
    Input: pack: Address
    Output: Integer
    Body: {
        // pack: [size, usage, hostvis] as three u32 (size truncated to 32)
        IfCondition EqualTo(pack, 0) ThenBlock: { ReturnValue(0) }
        p = Allocate(16)
        VulkanClient__Zero(p, 16)
        sz = Dereference(pack)
        VulkanClient__W32(p, 0, sz)
        VulkanClient__W32(p, 4, 0)
        VulkanClient__W32(p, 8, Dereference(Add(pack, 8)))
        VulkanClient__W32(p, 12, Dereference(Add(pack, 16)))
        st = VulkanClient__Call(handle, VkCOp.BUF, p, 16)
        Deallocate(p, 16)
        IfCondition NotEqual(st, 0) ThenBlock: { ReturnValue(0) }
        rb = Dereference(Add(handle, VkCHdr.REPLY))
        IfCondition EqualTo(rb, 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(VulkanClient__R32(rb, 0))
    }
}

Function.VulkanClient.StageUpload {
    Input: handle: Integer
    Input: buf_id: Integer
    Input: src: Address
    Input: nbytes: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(src, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition LessThan(nbytes, 1) ThenBlock: { ReturnValue(-1) }
        tot = Add(nbytes, 4)
        p = Allocate(tot)
        IfCondition EqualTo(p, 0) ThenBlock: { ReturnValue(-1) }
        VulkanClient__W32(p, 0, buf_id)
        i = 0
        WhileLoop LessThan(i, nbytes) {
            SetByte(p, Add(4, i), GetByte(src, i))
            i = Add(i, 1)
        }
        st = VulkanClient__Call(handle, VkCOp.UPLOAD, p, tot)
        Deallocate(p, tot)
        ReturnValue(st)
    }
}

Function.VulkanClient.BeginFrame {
    Input: handle: Integer
    Input: r: Integer
    Input: g: Integer
    Input: b: Integer
    Output: Integer
    Body: {
        p = Allocate(3)
        SetByte(p, 0, BitwiseAnd(r, 255))
        SetByte(p, 1, BitwiseAnd(g, 255))
        SetByte(p, 2, BitwiseAnd(b, 255))
        st = VulkanClient__Call(handle, VkCOp.BEGIN, p, 3)
        Deallocate(p, 3)
        ReturnValue(st)
    }
}

Function.VulkanClient.BindPipeline {
    Input: handle: Integer
    Input: pipe_id: Integer
    Output: Integer
    Body: {
        p = Allocate(4)
        VulkanClient__Zero(p, 4)
        VulkanClient__W32(p, 0, pipe_id)
        st = VulkanClient__Call(handle, VkCOp.BIND, p, 4)
        Deallocate(p, 4)
        ReturnValue(st)
    }
}

Function.VulkanClient.Draw {
    Input: handle: Integer
    Input: pack: Address
    Output: Integer
    Body: {
        // pack: [vbo, ibo, vcount, icount] four words
        IfCondition EqualTo(pack, 0) ThenBlock: { ReturnValue(-1) }
        p = Allocate(16)
        VulkanClient__Zero(p, 16)
        VulkanClient__W32(p, 0, Dereference(pack))
        VulkanClient__W32(p, 4, Dereference(Add(pack, 8)))
        VulkanClient__W32(p, 8, Dereference(Add(pack, 16)))
        VulkanClient__W32(p, 12, Dereference(Add(pack, 24)))
        st = VulkanClient__Call(handle, VkCOp.DRAW, p, 16)
        Deallocate(p, 16)
        ReturnValue(st)
    }
}

Function.VulkanClient.EndFrame {
    Input: handle: Integer
    Output: Integer
    Body: {
        ReturnValue(VulkanClient__Call(handle, VkCOp.END, 0, 0))
    }
}

Function.VulkanClient.Ready {
    Input: handle: Integer
    Output: Integer
    Body: {
        st = VulkanClient__Call(handle, VkCOp.READY, 0, 0)
        IfCondition NotEqual(st, 0) ThenBlock: { ReturnValue(0) }
        rb = Dereference(Add(handle, VkCHdr.REPLY))
        IfCondition EqualTo(rb, 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(VulkanClient__R32(rb, 0))
    }
}

// Writes BGRA into dst. Returns 0 ok. Header words of last reply: w,h,pitch at [0..8].
Function.VulkanClient.Readback {
    Input: handle: Integer
    Input: dst: Address
    Input: dst_bytes: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(dst, 0) ThenBlock: { ReturnValue(-1) }
        st = VulkanClient__Call(handle, VkCOp.READBACK, 0, 0)
        IfCondition NotEqual(st, 0) ThenBlock: { ReturnValue(-1) }
        rb = Dereference(Add(handle, VkCHdr.REPLY))
        rn = Dereference(Add(handle, VkCHdr.REPLY_N))
        IfCondition EqualTo(rb, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition LessThan(rn, 12) ThenBlock: { ReturnValue(-1) }
        copy_n = Subtract(rn, 12)
        IfCondition GreaterThan(copy_n, dst_bytes) ThenBlock: { copy_n = dst_bytes }
        i = 0
        WhileLoop LessThan(i, copy_n) {
            SetByte(dst, i, GetByte(rb, Add(12, i)))
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

Function.VulkanClient.Close {
    Input: handle: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(handle, 0) ThenBlock: { ReturnValue(0) }
        VulkanClient__Call(handle, VkCOp.QUIT, 0, 0)
        wfd = Dereference(Add(handle, VkCHdr.WFD))
        rfd = Dereference(Add(handle, VkCHdr.RFD))
        IfCondition GreaterThan(wfd, 0) ThenBlock: {
            SystemCall(VkCSys.CLOSE, wfd, 0, 0, 0, 0)
        }
        IfCondition GreaterThan(rfd, 0) ThenBlock: {
            SystemCall(VkCSys.CLOSE, rfd, 0, 0, 0, 0)
        }
        old = Dereference(Add(handle, VkCHdr.REPLY))
        oldn = Dereference(Add(handle, VkCHdr.REPLY_N))
        IfCondition NotEqual(old, 0) ThenBlock: {
            IfCondition GreaterThan(oldn, 0) ThenBlock: {
                Deallocate(old, oldn)
            }
        }
        Deallocate(handle, VkCHdr.BYTES)
        ReturnValue(0)
    }
}
