LibraryImport.DComposeFloat
LibraryImport.WinManager
LibraryImport.WinStack
LibraryImport.Cursor


// =============================================================================
// FIXED POOLS
// =============================================================================

FixedPool.ResizeEdge {
    "LEFT":   Initialize=1
    "RIGHT":  Initialize=2
    "TOP":    Initialize=4
    "BOTTOM": Initialize=8
}

FixedPool.WinMinSize {
    "w": Initialize=200
    "h": Initialize=200
}

FixedPool.WinInputState {
    "drag_idx":        Initialize=-1, CanChange=True
    "drag_offset_x":   Initialize=0, CanChange=True
    "drag_offset_y":   Initialize=0, CanChange=True
    "resize_idx":      Initialize=-1, CanChange=True
    "resize_edge":     Initialize=0, CanChange=True
    "resize_anchor_x": Initialize=0, CanChange=True
    "resize_anchor_y": Initialize=0, CanChange=True
    "resize_orig_fx":  Initialize=0, CanChange=True
    "resize_orig_fy":  Initialize=0, CanChange=True
    "resize_orig_w":   Initialize=0, CanChange=True
    "resize_orig_h":   Initialize=0, CanChange=True
    "resize_new_fx":   Initialize=0, CanChange=True
    "resize_new_fy":   Initialize=0, CanChange=True
    "resize_new_w":    Initialize=0, CanChange=True
    "resize_new_h":    Initialize=0, CanChange=True
    "resize_dirty":    Initialize=0, CanChange=True
}


// =============================================================================
// HIT TESTING
// =============================================================================
Function.Win_HitTest {
    Input:  x: Integer
    Input:  y: Integer
    Output: Integer
    Body: {
        DebugLog_Push("wi.hit", 6)
        ReturnValue(Float_HitTest(x, y))
    }
}

Function.Win_HeaderHitTest {
    Input:  px: Integer
    Input:  py: Integer
    Output: Integer
    Body: {
        DebugLog_Push("win.hdr", 7)
        // Iterate z_order back-to-front (topmost first)
        zi = Subtract(WinMgr.z_count, 1)
        WhileLoop GreaterEqual(zi, 0) {
            i = WinMgr_ZGet(zi)
            IfCondition GreaterEqual(i, 0) ThenBlock: {
                fx        = Win_GetX(i)
                fy        = Win_GetY(i)
                total_w   = Win_GetTotalW(i)
                tbh       = Win_GetTabBarH_FromStack(i)
                toolbar_h = WinMgr_GetToolbarH(i)

                hx0 = fx
                hx1 = Add(fx, total_w)
                hy0 = Subtract(Subtract(fy, tbh), toolbar_h)
                hy1 = Subtract(fy, toolbar_h)

                IfCondition And(
                    And(GreaterEqual(px, hx0), LessThan(px, hx1)),
                    And(GreaterEqual(py, hy0), LessThan(py, hy1))
                ) ThenBlock: {
                    ReturnValue(i)
                }
            }
            zi = Subtract(zi, 1)
        }
        ReturnValue(-1)
    }
}

Function.Win_ToolbarHitTest {
    Input:  px: Integer
    Input:  py: Integer
    Output: Integer
    Body: {
        DebugLog_Push("win.thb", 7)
        // Iterate z_order back-to-front (topmost first)
        zi = Subtract(WinMgr.z_count, 1)
        WhileLoop GreaterEqual(zi, 0) {
            i = WinMgr_ZGet(zi)
            IfCondition GreaterEqual(i, 0) ThenBlock: {
                fx        = Win_GetX(i)
                fy        = Win_GetY(i)
                total_w   = Win_GetTotalW(i)
                toolbar_h = WinMgr_GetToolbarH(i)

                IfCondition GreaterThan(toolbar_h, 0) ThenBlock: {
                    tx0 = fx
                    tx1 = Add(fx, total_w)
                    ty0 = Subtract(fy, toolbar_h)
                    ty1 = fy

                    IfCondition And(
                        And(GreaterEqual(px, tx0), LessThan(px, tx1)),
                        And(GreaterEqual(py, ty0), LessThan(py, ty1))
                    ) ThenBlock: {
                        ReturnValue(i)
                    }
                }
            }
            zi = Subtract(zi, 1)
        }
        ReturnValue(-1)
    }
}

Function.Win_ProbeBorder {
    Input:  idx: Integer
    Input:  px:  Integer
    Input:  py:  Integer
    Output: Integer
    Body: {
        DebugLog_Push("wi.pb", 5)
        bw      = DecorConfig.border_w
        fx      = Win_GetX(idx)
        fy      = Win_GetY(idx)
        total_w = Win_GetTotalW(idx)
        total_h = Win_GetTotalH(idx)
        probe   = bw
        px0 = Subtract(px, probe)
        py0 = Subtract(py, probe)
        px1 = Add(px, probe)
        py1 = Add(py, probe)
        wx0 = fx
        wy0 = fy
        wx1 = Add(fx, total_w)
        wy1 = Add(fy, total_h)
        edge = 0
        IfCondition And(LessThan(px0, Add(wx0, bw)), GreaterThan(px1, wx0)) ThenBlock: {
            IfCondition And(LessThan(py0, wy1), GreaterThan(py1, wy0)) ThenBlock: {
                edge = Add(edge, ResizeEdge.LEFT)
            }
        }
        IfCondition And(LessThan(px0, wx1), GreaterThan(px1, Subtract(wx1, bw))) ThenBlock: {
            IfCondition And(LessThan(py0, wy1), GreaterThan(py1, wy0)) ThenBlock: {
                edge = Add(edge, ResizeEdge.RIGHT)
            }
        }
        IfCondition And(LessThan(py0, Add(wy0, bw)), GreaterThan(py1, wy0)) ThenBlock: {
            IfCondition And(LessThan(px0, wx1), GreaterThan(px1, wx0)) ThenBlock: {
                edge = Add(edge, ResizeEdge.TOP)
            }
        }
        IfCondition And(LessThan(py0, wy1), GreaterThan(py1, Subtract(wy1, bw))) ThenBlock: {
            IfCondition And(LessThan(px0, wx1), GreaterThan(px1, wx0)) ThenBlock: {
                edge = Add(edge, ResizeEdge.BOTTOM)
            }
        }
        ReturnValue(edge)
    }
}

Function.Win_BorderHitTest {
    Input:  px: Integer
    Input:  py: Integer
    Output: Integer
    Body: {
        DebugLog_Push("win.brd", 7)
        // Iterate z_order back-to-front (topmost first)
        zi = Subtract(WinMgr.z_count, 1)
        WhileLoop GreaterEqual(zi, 0) {
            i = WinMgr_ZGet(zi)
            IfCondition GreaterEqual(i, 0) ThenBlock: {
                edge = Win_ProbeBorder(i, px, py)
                IfCondition NotEqual(edge, 0) ThenBlock: {
                    WinInputState.resize_edge = edge
                    ReturnValue(i)
                }
            }
            zi = Subtract(zi, 1)
        }
        WinInputState.resize_edge = 0
        ReturnValue(-1)
    }
}


// =============================================================================
// DRAG STATE MACHINE
// =============================================================================
Function.Win_StartDrag {
    Input:  idx:     Integer
    Input:  mouse_x: Integer
    Input:  mouse_y: Integer
    Output: Integer
    Body: {
        DebugLog_Push("wi.sd", 5)
        IfCondition EqualTo(idx, 0) ThenBlock: { ReturnValue(0) }
        fx = Win_GetX(idx)
        fy = Win_GetY(idx)
        WinInputState.drag_idx      = idx
        WinInputState.drag_offset_x = Subtract(mouse_x, fx)
        WinInputState.drag_offset_y = Subtract(mouse_y, fy)
        ReturnValue(1)
    }
}

Function.Win_UpdateDrag {
    Input:  mouse_x: Integer
    Input:  mouse_y: Integer
    Output: Integer
    Body: {
        DebugLog_Push("wi.ud", 5)
        idx = WinInputState.drag_idx
        IfCondition LessThan(idx, 0) ThenBlock: { ReturnValue(0) }
        new_x   = Subtract(mouse_x, WinInputState.drag_offset_x)
        new_y   = Subtract(mouse_y, WinInputState.drag_offset_y)
        sw      = FB_GetWidth()
        sh      = FB_GetHeight()
        total_w = Win_GetTotalW(idx)
        total_h = Win_GetTotalH(idx)
        IfCondition LessThan(new_x, 0) ThenBlock: { new_x = 0 }
        IfCondition LessThan(new_y, 0) ThenBlock: { new_y = 0 }
        IfCondition GreaterThan(Add(new_x, total_w), sw) ThenBlock: {
            new_x = Subtract(sw, total_w)
        }
        IfCondition GreaterThan(Add(new_y, total_h), sh) ThenBlock: {
            new_y = Subtract(sh, total_h)
        }
        Win_SetGeom(idx, new_x, new_y, total_w, total_h)
        ReturnValue(1)
    }
}

Function.Win_StopDrag {
    Output: Integer
    Body: {
        DebugLog_Push("wi.stop", 7)
        WinInputState.drag_idx = -1
        ReturnValue(1)
    }
}


// =============================================================================
// RESIZE STATE MACHINE
// =============================================================================
Function.Win_StartResize {
    Input:  idx:     Integer
    Input:  mouse_x: Integer
    Input:  mouse_y: Integer
    Output: Integer
    Body: {
        DebugLog_Push("wi.sr", 5)
        IfCondition EqualTo(idx, 0) ThenBlock: { ReturnValue(0) }
        WinInputState.resize_idx      = idx
        WinInputState.resize_anchor_x = mouse_x
        WinInputState.resize_anchor_y = mouse_y

        WinInputState.resize_orig_fx = Win_GetX(idx)
        WinInputState.resize_orig_fy = Win_GetY(idx)
        WinInputState.resize_orig_w  = Win_GetTotalW(idx)
        WinInputState.resize_orig_h  = Win_GetTotalH(idx)
        WinInputState.resize_new_fx  = WinInputState.resize_orig_fx
        WinInputState.resize_new_fy  = WinInputState.resize_orig_fy
        WinInputState.resize_new_w   = WinInputState.resize_orig_w
        WinInputState.resize_new_h   = WinInputState.resize_orig_h

        Win_DebugPrint("RESIZE START")
        Win_DebugNum("idx=",   idx)
        Win_DebugNum("edge=",  WinInputState.resize_edge)
        Win_DebugNum("origW=", WinInputState.resize_orig_w)
        Win_DebugNum("origH=", WinInputState.resize_orig_h)
        ReturnValue(1)
    }
}

Function.Win_UpdateResize {
    Input:  mouse_x: Integer
    Input:  mouse_y: Integer
    Output: Integer
    Body: {
        DebugLog_Push("wi.ur", 5)
        idx = WinInputState.resize_idx
        IfCondition LessThan(idx, 0) ThenBlock: { ReturnValue(0) }

        edge    = WinInputState.resize_edge
        bw      = DecorConfig.border_w
        dx      = Subtract(mouse_x, WinInputState.resize_anchor_x)
        dy      = Subtract(mouse_y, WinInputState.resize_anchor_y)
        orig_fx = WinInputState.resize_orig_fx
        orig_fy = WinInputState.resize_orig_fy
        orig_w  = WinInputState.resize_orig_w
        orig_h  = WinInputState.resize_orig_h

        Win_DebugNum("edge=",   edge)
        Win_DebugNum("dx=",     dx)
        Win_DebugNum("dy=",     dy)
        Win_DebugNum("orig_h=", orig_h)
        Win_DebugNum("orig_w=", orig_w)

        min_w = Add(WinMinSize.w, Multiply(bw, 2))
        min_h = Add(WinMinSize.h, Multiply(bw, 2))

        new_fx = orig_fx
        new_fy = orig_fy
        new_w  = orig_w
        new_h  = orig_h

        IfCondition NotEqual(BitwiseAnd(edge, ResizeEdge.RIGHT), 0) ThenBlock: {
            new_w = Add(orig_w, dx)
            IfCondition LessThan(new_w, min_w) ThenBlock: { new_w = min_w }
        }
        IfCondition NotEqual(BitwiseAnd(edge, ResizeEdge.LEFT), 0) ThenBlock: {
            new_w = Subtract(orig_w, dx)
            IfCondition LessThan(new_w, min_w) ThenBlock: {
                new_w = min_w
                new_fx = Subtract(Add(orig_fx, orig_w), min_w)
            } ElseBlock: {
                new_fx = Add(orig_fx, dx)
            }
        }
        IfCondition NotEqual(BitwiseAnd(edge, ResizeEdge.BOTTOM), 0) ThenBlock: {
            new_h = Add(orig_h, dy)
            IfCondition LessThan(new_h, min_h) ThenBlock: { new_h = min_h }
        }
        IfCondition NotEqual(BitwiseAnd(edge, ResizeEdge.TOP), 0) ThenBlock: {
            new_h = Subtract(orig_h, dy)
            IfCondition LessThan(new_h, min_h) ThenBlock: {
                new_h = min_h
                new_fy = Subtract(Add(orig_fy, orig_h), min_h)
            } ElseBlock: {
                new_fy = Add(orig_fy, dy)
            }
        }

        sw = FB_GetWidth()
        sh = FB_GetHeight()
        IfCondition LessThan(new_fx, 0) ThenBlock: { new_fx = 0 }
        IfCondition LessThan(new_fy, 0) ThenBlock: { new_fy = 0 }

        Win_SetGeom(idx, new_fx, new_fy, new_w, new_h)

        canvas_w = Win_GetCanvasW(idx)
        canvas_h = Win_GetCanvasH(idx)

        old_hdr     = WinMgr_GetHdr(idx)
        old_content = WinMgr_GetContent(idx)

        // Sample background color from old content surface (top-left pixel)
        bg = WinColor.WINDOW
        IfCondition GreaterEqual(old_content, 0) ThenBlock: {
            bg = Dereference(Surface_GetData(old_content))
        }

        tbh = Win_GetTabBarH_FromStack(idx)
        new_tw = Win_GetTotalW(idx)
        DebugLog_Push("wi.ur.sc", 8)
        new_hdr = Surface_Create(SurfaceFormat.PIXEL_32, new_tw, tbh)
        IfCondition EqualTo(new_hdr, 0) ThenBlock: { ReturnValue(0) }
        DebugLog_Push("wi.ur.fr", 8)
        Draw_Pix_FillRect(new_hdr, 0, 0, new_tw, tbh, 0xFF222222)

        DebugLog_Push("wi.ur.s2", 8)
        new_content = Surface_Create(SurfaceFormat.PIXEL_32, canvas_w, canvas_h)
        IfCondition EqualTo(new_content, 0) ThenBlock: {
            DebugLog_Push("wi.ur.sd", 8)
            Surface_Destroy(new_hdr)
            ReturnValue(0)
        }
        DebugLog_Push("wi.ur.f2", 8)
        Draw_Pix_FillRect(new_content, 0, 0, canvas_w, canvas_h, bg)

        // Preserve canvas content from old surface
        IfCondition GreaterEqual(old_content, 0) ThenBlock: {
            Surface_BlitOpaque(new_content, old_content, 0, 0)
        }

        WinMgr_SetHdr(idx, new_hdr)
        WinMgr_SetContent(idx, new_content)

        fptr = Float_EntryPtr(idx)
        StoreValue(Add(fptr, FloatEntryFields.SURFACE), new_content)

        DebugLog_Push("wi.ur.d1", 8)
        IfCondition GreaterEqual(old_hdr, 0)     ThenBlock: { Surface_Destroy(old_hdr) }
        DebugLog_Push("wi.ur.d2", 8)
        IfCondition GreaterEqual(old_content, 0) ThenBlock: { Surface_Destroy(old_content) }

        WinMgr_SetTB(idx, -1)
        Win_DrawTabBar(idx)

        // Recreate toolbar surface if one exists
        old_toolbar = WinMgr_GetToolbar(idx)
        cur_toolbar_h = WinMgr_GetToolbarH(idx)
        IfCondition GreaterThan(cur_toolbar_h, 0) ThenBlock: {
            DebugLog_Push("wi.ur.s3", 8)
            new_toolbar = Surface_Create(SurfaceFormat.PIXEL_32, Win_GetTotalW(idx), cur_toolbar_h)
            IfCondition GreaterThan(new_toolbar, 0) ThenBlock: {
                DebugLog_Push("wi.ur.f3", 8)
                Draw_Pix_FillRect(new_toolbar, 0, 0, Win_GetTotalW(idx), cur_toolbar_h, 0xFF2A2A2A)
                WinMgr_SetToolbar(idx, new_toolbar)
                DebugLog_Push("wi.ur.d3", 8)
                IfCondition GreaterEqual(old_toolbar, 0) ThenBlock: {
                    Surface_Destroy(old_toolbar)
                }
                // Re-render Auckland toolbar tree into new surface
                Win_RedrawToolbar(idx)
            }
        }
        DebugLog_Push("wi.ur.ok", 8)

        WinInputState.resize_anchor_x = mouse_x
        WinInputState.resize_anchor_y = mouse_y
        WinInputState.resize_orig_fx  = Win_GetX(idx)
        WinInputState.resize_orig_fy  = Win_GetY(idx)
        WinInputState.resize_orig_w   = Win_GetTotalW(idx)
        WinInputState.resize_orig_h   = Win_GetTotalH(idx)

        ReturnValue(1)
    }
}

Function.Win_ApplyResize {
    Output: Integer
    Body: {
        DebugLog_Push("wi.ar", 5)
        idx = WinInputState.resize_idx
        IfCondition LessThan(idx, 0) ThenBlock: { ReturnValue(0) }
        WinInputState.resize_idx  = -1
        WinInputState.resize_edge = 0
        ReturnValue(1)
    }
}


// =============================================================================
// KEY ROUTING
// =============================================================================
Function.Win_KeyDown {
    Input:  keycode: Integer
    Input:  shift:   Integer
    Output: Integer
    Body: {
        DebugLog_Push("wi.key", 6)
        // TODO: route through Auckland event system
        ReturnValue(0)
    }
}