// =============================================================================
// WINVIEW
// =============================================================================
Function.WinView_Init {
    Output: Integer
    Body: {
        sz = Multiply(WinViewConst.MAX, WinViewConst.ENTRY_SIZE)
        buf = Allocate(sz)
        IfCondition EqualTo(buf, 0) ThenBlock: {
            PrintMessage("[WinView] alloc fail\n")
            ReturnValue(0)
        }

        i = 0
        WhileLoop LessThan(i, sz) {
            SetByte(buf, i, 0)
            i = Add(i, 1)
        }

        s = 0
        WhileLoop LessThan(s, WinViewConst.MAX) {
            base = Add(buf, Multiply(s, WinViewConst.ENTRY_SIZE))
            StoreValue(Add(base, WinViewFields.JOB_PTR),       0)
            StoreValue(Add(base, WinViewFields.SERVICE_ID),    -1)
            StoreValue(Add(base, WinViewFields.BINDINGS),       0)
            StoreValue(Add(base, WinViewFields.BINDING_COUNT),  0)
            StoreValue(Add(base, WinViewFields.VIEW_TYPE),      0)
            StoreValue(Add(base, WinViewFields.DOC_HANDLE),    -1)
            StoreValue(Add(base, WinViewFields.PAGE_HANDLE),   -1)
            s = Add(s, 1)
        }

        WinViewTable.data = buf
        PrintMessage("[WinView] initialized\n")
        ReturnValue(1)
    }
}

Function.WinView_Ptr {
    Input: idx: Integer
    Output: Integer
    Body: {
        ReturnValue(Add(WinViewTable.data, Multiply(idx, WinViewConst.ENTRY_SIZE)))
    }
}

Function.WinView_GetJobPtr       { Input: idx: Integer Output: Integer Body: { base = WinView_Ptr(idx)  ReturnValue(Dereference(Add(base, WinViewFields.JOB_PTR))) } }
Function.WinView_SetJobPtr       { Input: idx: Integer Input: val: Integer Body: { base = WinView_Ptr(idx)  StoreValue(Add(base, WinViewFields.JOB_PTR), val) } }
Function.WinView_GetServiceId    { Input: idx: Integer Output: Integer Body: { base = WinView_Ptr(idx)  ReturnValue(Dereference(Add(base, WinViewFields.SERVICE_ID))) } }
Function.WinView_SetServiceId    { Input: idx: Integer Input: val: Integer Body: { base = WinView_Ptr(idx)  StoreValue(Add(base, WinViewFields.SERVICE_ID), val) } }
Function.WinView_GetBindings     { Input: idx: Integer Output: Integer Body: { base = WinView_Ptr(idx)  ReturnValue(Dereference(Add(base, WinViewFields.BINDINGS))) } }
Function.WinView_SetBindings     { Input: idx: Integer Input: val: Integer Body: { base = WinView_Ptr(idx)  StoreValue(Add(base, WinViewFields.BINDINGS), val) } }
Function.WinView_GetBindingCount { Input: idx: Integer Output: Integer Body: { base = WinView_Ptr(idx)  ReturnValue(Dereference(Add(base, WinViewFields.BINDING_COUNT))) } }
Function.WinView_SetBindingCount { Input: idx: Integer Input: val: Integer Body: { base = WinView_Ptr(idx)  StoreValue(Add(base, WinViewFields.BINDING_COUNT), val) } }
Function.WinView_GetViewType     { Input: idx: Integer Output: Integer Body: { base = WinView_Ptr(idx)  ReturnValue(Dereference(Add(base, WinViewFields.VIEW_TYPE))) } }
Function.WinView_SetViewType     { Input: idx: Integer Input: val: Integer Body: { base = WinView_Ptr(idx)  StoreValue(Add(base, WinViewFields.VIEW_TYPE), val) } }
Function.WinView_GetDocHandle    { Input: idx: Integer Output: Integer Body: { base = WinView_Ptr(idx)  ReturnValue(Dereference(Add(base, WinViewFields.DOC_HANDLE))) } }
Function.WinView_SetDocHandle    { Input: idx: Integer Input: val: Integer Body: { base = WinView_Ptr(idx)  StoreValue(Add(base, WinViewFields.DOC_HANDLE), val) } }
Function.WinView_GetPageHandle   { Input: idx: Integer Output: Integer Body: { base = WinView_Ptr(idx)  ReturnValue(Dereference(Add(base, WinViewFields.PAGE_HANDLE))) } }
Function.WinView_SetPageHandle   { Input: idx: Integer Input: val: Integer Body: { base = WinView_Ptr(idx)  StoreValue(Add(base, WinViewFields.PAGE_HANDLE), val) } }

Function.WinView_Clear {
    Input: idx: Integer
    Body: {
        bindings = WinView_GetBindings(idx)
        IfCondition NotEqual(bindings, 0) ThenBlock: {
            XArray.XDestroy(bindings)
        }
        base = WinView_Ptr(idx)
        StoreValue(Add(base, WinViewFields.JOB_PTR),       0)
        StoreValue(Add(base, WinViewFields.SERVICE_ID),    -1)
        StoreValue(Add(base, WinViewFields.BINDINGS),       0)
        StoreValue(Add(base, WinViewFields.BINDING_COUNT),  0)
        StoreValue(Add(base, WinViewFields.VIEW_TYPE),      0)
        StoreValue(Add(base, WinViewFields.DOC_HANDLE),    -1)
        StoreValue(Add(base, WinViewFields.PAGE_HANDLE),   -1)
    }
}

Function.WinView_ShiftDown {
    Input: dst_idx: Integer
    Input: src_idx: Integer
    Body: {
        src = WinView_Ptr(src_idx)
        dst = WinView_Ptr(dst_idx)
        j = 0
        WhileLoop LessThan(j, WinViewConst.ENTRY_SIZE) {
            SetByte(dst, j, GetByte(src, j))
            j = Add(j, 1)
        }
    }
}

Function.WinView_Save {
    Input: idx: Integer
    Output: Integer
    Body: {
        buf = Allocate(WinViewConst.ENTRY_SIZE)
        src = WinView_Ptr(idx)
        j = 0
        WhileLoop LessThan(j, WinViewConst.ENTRY_SIZE) {
            SetByte(buf, j, GetByte(src, j))
            j = Add(j, 1)
        }
        ReturnValue(buf)
    }
}

Function.WinView_Restore {
    Input: idx: Integer
    Input: buf: Integer
    Body: {
        dst = WinView_Ptr(idx)
        j = 0
        WhileLoop LessThan(j, WinViewConst.ENTRY_SIZE) {
            SetByte(dst, j, GetByte(buf, j))
            j = Add(j, 1)
        }
        Deallocate(buf, WinViewConst.ENTRY_SIZE)
    }
}


// =============================================================================
// WINDOW LIFECYCLE
// =============================================================================
Function.Win_Create {
    Input:  canvas_w: Integer
    Input:  canvas_h: Integer
    Input:  color:    Integer
    Input:  title:    Integer
    Output: Integer
    Body: {
        cnt = FloatTable.count
        IfCondition GreaterEqual(cnt, FloatEntryConst.MAX_FLOATING) ThenBlock: {
            PrintMessage("[Win] ERROR: max windows\n")
            ReturnValue(-1)
        }

        bw = DecorConfig.border_w
        total_w = Add(canvas_w, Multiply(bw, 2))
        total_h = Add(canvas_h, Multiply(bw, 2))

        sw = Compositor.screen_w
        sh = Compositor.screen_h
        fx = Divide(Subtract(sw, total_w), 2)
        fy = Divide(Subtract(sh, total_h), 2)

        idx = Float_Add(0, fx, fy, total_w, total_h)
        IfCondition LessThan(idx, 0) ThenBlock: {
            PrintMessage("[Win] ERROR: Float_Add\n")
            ReturnValue(-1)
        }

        Win_SetGeom(idx, fx, fy, total_w, total_h)

        cw = Win_GetCanvasW(idx)
        ch = Win_GetCanvasH(idx)

        tbh = DecorConfig.header_h
        hdr_surf = Surface_Create(SurfaceFormat.PIXEL_32, Win_GetTotalW(idx), tbh)
        IfCondition EqualTo(hdr_surf, 0) ThenBlock: {
            Float_Remove(idx)
            PrintMessage("[Win] ERROR: header surface\n")
            ReturnValue(-1)
        }
        Draw_Pix_FillRect(hdr_surf, 0, 0, Win_GetTotalW(idx), tbh, 0xFF222222)

        bg = color
        IfCondition LessThan(color, 0) ThenBlock: { bg = WinColor.WINDOW }
        content_surf = Surface_Create(SurfaceFormat.PIXEL_32, cw, ch)
        IfCondition EqualTo(content_surf, 0) ThenBlock: {
            Float_Remove(idx)
            Surface_Destroy(hdr_surf)
            PrintMessage("[Win] ERROR: content surface\n")
            ReturnValue(-1)
        }
        Draw_Pix_FillRect(content_surf, 0, 0, cw, ch, bg)

        fptr = Float_EntryPtr(idx)
        StoreValue(Add(fptr, FloatEntryFields.SURFACE), content_surf)

        tb = -1
        WinMgr_SetHdr(idx, hdr_surf)
        WinMgr_SetContent(idx, content_surf)
        WinMgr_SetTB(idx, tb)
        WinMgr_SetTitle(idx, title)
        WinMgr_SetToolbar(idx, -1)
        WinMgr_SetToolbarH(idx, 0)
        WinMgr.count = Add(WinMgr.count, 1)

        Win_DrawTabBar(idx)

        PrintMessage("[Win] created idx=")
        PrintNumber(idx)
        PrintMessage(" canvas=")
        PrintNumber(cw)
        PrintMessage("x")
        PrintNumber(ch)
        PrintMessage("\n")

        ReturnValue(idx)
    }
}

Function.Win_Close {
    Input:  idx: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(idx, 0)        ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(idx, 0)       ThenBlock: { ReturnValue(0) }
        cnt = FloatTable.count
        IfCondition GreaterEqual(idx, cnt) ThenBlock: { ReturnValue(0) }

        hdr_surf     = WinMgr_GetHdr(idx)
        content_surf = WinMgr_GetContent(idx)
        toolbar_surf = WinMgr_GetToolbar(idx)
        IfCondition GreaterEqual(hdr_surf, 0)     ThenBlock: { Surface_Destroy(hdr_surf) }
        IfCondition GreaterEqual(content_surf, 0) ThenBlock: { Surface_Destroy(content_surf) }
        IfCondition GreaterEqual(toolbar_surf, 0) ThenBlock: { Surface_Destroy(toolbar_surf) }

        toolbar_slot = WinMgr_GetToolbarSlot(idx)
        IfCondition GreaterThan(toolbar_slot, 0) ThenBlock: { AKSlot_Free(toolbar_slot) }

        WinView_Clear(idx)
        Float_Remove(idx)

        i = idx
        new_cnt = Subtract(cnt, 1)
        WhileLoop LessThan(i, new_cnt) {
            WinMgr_SetHdr(i,        WinMgr_GetHdr(Add(i, 1)))
            WinMgr_SetContent(i,    WinMgr_GetContent(Add(i, 1)))
            WinMgr_SetTB(i,         WinMgr_GetTB(Add(i, 1)))
            WinMgr_SetTitle(i,      WinMgr_GetTitle(Add(i, 1)))
            WinMgr_SetToolbar(i,    WinMgr_GetToolbar(Add(i, 1)))
            WinMgr_SetToolbarH(i,   WinMgr_GetToolbarH(Add(i, 1)))
            WinMgr_SetToolbarCtx(i, WinMgr_GetToolbarCtx(Add(i, 1)))

            src = Win_GeomPtr(Add(i, 1))
            dst = Win_GeomPtr(i)
            j = 0
            WhileLoop LessThan(j, WinGeomConst.ENTRY_SIZE) {
                SetByte(dst, j, GetByte(src, j))
                j = Add(j, 1)
            }

            WinView_ShiftDown(i, Add(i, 1))
            i = Add(i, 1)
        }

        WinMgr_SetHdr(new_cnt,        -1)
        WinMgr_SetContent(new_cnt,    -1)
        WinMgr_SetTB(new_cnt,         -1)
        WinMgr_SetTitle(new_cnt,       0)
        WinMgr_SetToolbar(new_cnt,    -1)
        WinMgr_SetToolbarH(new_cnt,    0)
        WinMgr_SetToolbarCtx(new_cnt,  0)
        last = Win_GeomPtr(new_cnt)
        j = 0
        WhileLoop LessThan(j, WinGeomConst.ENTRY_SIZE) {
            SetByte(last, j, 0)
            j = Add(j, 1)
        }
        WinView_Clear(new_cnt)

        WinMgr.count = Subtract(WinMgr.count, 1)
        new_focus = Subtract(idx, 1)
        IfCondition LessThan(new_focus, 0) ThenBlock: { new_focus = 0 }
        WinMgr.focused = new_focus
        ReturnValue(1)
    }
}

Function.Win_Focus {
    Input:  idx: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(idx, 0) ThenBlock: {
            WinMgr.focused = 0
            ReturnValue(1)
        }
        new_idx = Win_BringToFront(idx)
        IfCondition GreaterEqual(new_idx, 0) ThenBlock: {
            WinMgr.focused = new_idx
        } ElseBlock: {
            WinMgr.focused = idx
        }
        ReturnValue(1)
    }
}

Function.Win_BringToFront {
    Input:  idx: Integer
    Output: Integer
    Body: {
        cnt = FloatTable.count
        last = Subtract(cnt, 1)

        IfCondition EqualTo(idx, 0)    ThenBlock: { ReturnValue(-1) }
        IfCondition EqualTo(idx, last) ThenBlock: { ReturnValue(last) }
        IfCondition LessThan(idx, 0)   ThenBlock: { ReturnValue(-1) }

        save_float = Allocate(FloatEntryConst.SIZE)
        src_fp = Float_EntryPtr(idx)
        sf = 0
        WhileLoop LessThan(sf, FloatEntryConst.SIZE) {
            SetByte(save_float, sf, GetByte(src_fp, sf))
            sf = Add(sf, 1)
        }

        save_geom = Allocate(WinGeomConst.ENTRY_SIZE)
        src_gp = Win_GeomPtr(idx)
        sg = 0
        WhileLoop LessThan(sg, WinGeomConst.ENTRY_SIZE) {
            SetByte(save_geom, sg, GetByte(src_gp, sg))
            sg = Add(sg, 1)
        }

        save_hdr         = WinMgr_GetHdr(idx)
        save_content     = WinMgr_GetContent(idx)
        save_tb          = WinMgr_GetTB(idx)
        save_stack       = WinStack_Get(idx)
        save_title       = WinMgr_GetTitle(idx)
        save_toolbar     = WinMgr_GetToolbar(idx)
        save_toolbar_h   = WinMgr_GetToolbarH(idx)
        save_toolbar_ctx = WinMgr_GetToolbarCtx(idx)
        save_view = WinView_Save(idx)

        i = idx
        WhileLoop LessThan(i, last) {
            next = Add(i, 1)

            dst_f = Float_EntryPtr(i)
            src_f = Float_EntryPtr(next)
            fj = 0
            WhileLoop LessThan(fj, FloatEntryConst.SIZE) {
                SetByte(dst_f, fj, GetByte(src_f, fj))
                fj = Add(fj, 1)
            }

            dst_g = Win_GeomPtr(i)
            src_g = Win_GeomPtr(next)
            gj = 0
            WhileLoop LessThan(gj, WinGeomConst.ENTRY_SIZE) {
                SetByte(dst_g, gj, GetByte(src_g, gj))
                gj = Add(gj, 1)
            }

            WinMgr_SetHdr(i,        WinMgr_GetHdr(next))
            WinMgr_SetContent(i,    WinMgr_GetContent(next))
            WinMgr_SetTB(i,         WinMgr_GetTB(next))
            WinStack_Set(i,         WinStack_Get(next))
            WinMgr_SetTitle(i,      WinMgr_GetTitle(next))
            WinMgr_SetToolbar(i,    WinMgr_GetToolbar(next))
            WinMgr_SetToolbarH(i,   WinMgr_GetToolbarH(next))
            WinMgr_SetToolbarCtx(i, WinMgr_GetToolbarCtx(next))

            WinView_ShiftDown(i, next)
            i = Add(i, 1)
        }

        dst_fp = Float_EntryPtr(last)
        rf = 0
        WhileLoop LessThan(rf, FloatEntryConst.SIZE) {
            SetByte(dst_fp, rf, GetByte(save_float, rf))
            rf = Add(rf, 1)
        }

        dst_gp = Win_GeomPtr(last)
        rg = 0
        WhileLoop LessThan(rg, WinGeomConst.ENTRY_SIZE) {
            SetByte(dst_gp, rg, GetByte(save_geom, rg))
            rg = Add(rg, 1)
        }

        WinMgr_SetHdr(last,        save_hdr)
        WinMgr_SetContent(last,    save_content)
        WinMgr_SetTB(last,         save_tb)
        WinStack_Set(last,         save_stack)
        WinMgr_SetTitle(last,      save_title)
        WinMgr_SetToolbar(last,    save_toolbar)
        WinMgr_SetToolbarH(last,   save_toolbar_h)
        WinMgr_SetToolbarCtx(last, save_toolbar_ctx)

        WinView_Restore(last, save_view)

        Deallocate(save_float, FloatEntryConst.SIZE)
        Deallocate(save_geom,  WinGeomConst.ENTRY_SIZE)

        ReturnValue(last)
    }
}


// =============================================================================
// TOOLBAR CREATION — delegated to Library.WinToolbar.ailang (AKSlot-based)
// Old AKCtx-based Win_CreateToolbar/Win_CreateToolbarDefault/Win_BuildDefaultToolbar
// /Win_RedrawToolbar removed — they stored an AKCtx pointer where the new
// Win_ToolbarEvent expects an AKSlot index, causing a hang on first click.
// =============================================================================


// =============================================================================
// DEBUG HELPERS
// =============================================================================
Function.Win_DebugPrint {
    Input: msg: Integer
    Body: {
        PrintMessage("[W] ")
        PrintMessage(msg)
        PrintMessage("\n")
        ReturnValue(0)
    }
}

Function.Win_DebugNum {
    Input: msg: Integer
    Input: val: Integer
    Body: {
        PrintMessage("[W] ")
        PrintMessage(msg)
        PrintNumber(val)
        PrintMessage("\n")
        ReturnValue(0)
    }
}