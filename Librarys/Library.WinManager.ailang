//
// WINGEOM — per-window authoritative geometry table
// One entry per window slot (max 8). Written ONLY by Win_SetGeom.
// Fields per entry (8 bytes each, 48 bytes per slot):
//   total_w, total_h, canvas_w, canvas_h, x, y
// =============================================================================

LibraryImport.DSurfaceTypes
LibraryImport.DSurface
LibraryImport.DDrawPixel
LibraryImport.DComposeTypes
LibraryImport.DComposeFloat
LibraryImport.Cursor
LibraryImport.WinStack
LibraryImport.WinRender
LibraryImport.WinInput

// =============================================================================
// FIXED POOLS — geometry, defaults, colors, WinView
// =============================================================================

FixedPool.WinGeomFields {
    "TOTAL_W":  Initialize=0
    "TOTAL_H":  Initialize=8
    "CANVAS_W": Initialize=16
    "CANVAS_H": Initialize=24
    "X":        Initialize=32
    "Y":        Initialize=40
}

FixedPool.WinGeomConst {
    "ENTRY_SIZE": Initialize=48
    "MAX":        Initialize=8
}

FixedPool.WinGeomTable {
    "data": Initialize=0
}

FixedPool.WinMgr {
    "focused":          Initialize=0
    "count":            Initialize=0
    "hdr_data":         Initialize=0
    "content_data":     Initialize=0
    "tb_data":          Initialize=0
    "title_data":       Initialize=0
    "tab_inst":         Initialize=-1
    "toolbar_data":     Initialize=0
    "toolbar_h_data":   Initialize=0
    "toolbar_ctx_data": Initialize=0
}

// NOTE: drag_*/resize_* fields removed — now in WinInputState (Library.WinInput.ailang)

FixedPool.WinViewFields {
    "JOB_PTR":       Initialize=0
    "SERVICE_ID":    Initialize=8
    "BINDINGS":      Initialize=16
    "BINDING_COUNT": Initialize=24
    "VIEW_TYPE":     Initialize=32
    "DOC_HANDLE":    Initialize=40
    "PAGE_HANDLE":   Initialize=48
}

FixedPool.WinViewConst {
    "ENTRY_SIZE": Initialize=56
    "MAX":        Initialize=8
}

FixedPool.WinViewTable {
    "data": Initialize=0
}


// =============================================================================
// WINMGR_INIT
// =============================================================================
Function.WinMgr_Init {
    Output: Integer
    Body: {
        WinMgr.focused      = -1
        WinMgr.count        = 0
        WinMgr.hdr_data     = Allocate(64)
        WinMgr.content_data = Allocate(64)
        WinMgr.tb_data      = Allocate(64)
        WinMgr.title_data   = Allocate(64)
        WinMgr.toolbar_data     = Allocate(64)
        WinMgr.toolbar_h_data   = Allocate(64)
        WinMgr.toolbar_ctx_data = Allocate(64)

        i = 0
        WhileLoop LessThan(i, 8) {
            off = Multiply(i, 8)
            StoreValue(Add(WinMgr.hdr_data,         off), -1)
            StoreValue(Add(WinMgr.content_data,     off), -1)
            StoreValue(Add(WinMgr.tb_data,          off), -1)
            StoreValue(Add(WinMgr.title_data,       off), 0)
            StoreValue(Add(WinMgr.toolbar_data,     off), -1)
            StoreValue(Add(WinMgr.toolbar_h_data,   off), 0)
            StoreValue(Add(WinMgr.toolbar_ctx_data, off), 0)
            i = Add(i, 1)
        }

        geom_size = Multiply(WinGeomConst.MAX, WinGeomConst.ENTRY_SIZE)
        geom_buf  = Allocate(geom_size)
        gi = 0
        WhileLoop LessThan(gi, geom_size) {
            SetByte(geom_buf, gi, 0)
            gi = Add(gi, 1)
        }
        WinGeomTable.data = geom_buf

        // Stack init (delegated to WinStack)
        WinStack_Init()

        PrintMessage("[WinMgr] stacks initialized\n")

        WinView_Init()

        ReturnValue(1)
    }
}


// =============================================================================
// GEOMETRY
// =============================================================================
Function.Win_GeomPtr {
    Input:  idx: Integer
    Output: Integer
    Body: {
        ReturnValue(Add(WinGeomTable.data, Multiply(idx, WinGeomConst.ENTRY_SIZE)))
    }
}

Function.Win_SetGeom {
    Input: idx:     Integer
    Input: x:       Integer
    Input: y:       Integer
    Input: total_w: Integer
    Input: total_h: Integer
    Output: Integer
    Body: {
        bw       = DecorConfig.border_w
        canvas_w = Subtract(total_w, Multiply(bw, 2))
        canvas_h = Subtract(total_h, Multiply(bw, 2))
        min_cw   = WinMinSize.w
        min_ch   = WinMinSize.h
        IfCondition LessThan(canvas_w, min_cw) ThenBlock: { canvas_w = min_cw }
        IfCondition LessThan(canvas_h, min_ch) ThenBlock: { canvas_h = min_ch }
        total_w = Add(canvas_w, Multiply(bw, 2))
        total_h = Add(canvas_h, Multiply(bw, 2))

        gptr = Win_GeomPtr(idx)
        StoreValue(Add(gptr, WinGeomFields.TOTAL_W),  total_w)
        StoreValue(Add(gptr, WinGeomFields.TOTAL_H),  total_h)
        StoreValue(Add(gptr, WinGeomFields.CANVAS_W), canvas_w)
        StoreValue(Add(gptr, WinGeomFields.CANVAS_H), canvas_h)
        StoreValue(Add(gptr, WinGeomFields.X),        x)
        StoreValue(Add(gptr, WinGeomFields.Y),        y)

        tbh       = Win_GetTabBarH_FromStack(idx)
        toolbar_h = WinMgr_GetToolbarH(idx)
        fptr = Float_EntryPtr(idx)
        StoreValue(Add(fptr, FloatEntryFields.X), x)
        StoreValue(Add(fptr, FloatEntryFields.Y), Subtract(Subtract(y, tbh), toolbar_h))
        StoreValue(Add(fptr, FloatEntryFields.W), total_w)
        StoreValue(Add(fptr, FloatEntryFields.H), Add(Add(total_h, tbh), toolbar_h))
        ReturnValue(1)
    }
}

Function.Win_GetTotalW  { Input: idx: Integer Output: Integer Body: { ReturnValue(Dereference(Add(Win_GeomPtr(idx), WinGeomFields.TOTAL_W)))  } }
Function.Win_GetTotalH  { Input: idx: Integer Output: Integer Body: { ReturnValue(Dereference(Add(Win_GeomPtr(idx), WinGeomFields.TOTAL_H)))  } }
Function.Win_GetCanvasW { Input: idx: Integer Output: Integer Body: { ReturnValue(Dereference(Add(Win_GeomPtr(idx), WinGeomFields.CANVAS_W))) } }
Function.Win_GetCanvasH { Input: idx: Integer Output: Integer Body: { ReturnValue(Dereference(Add(Win_GeomPtr(idx), WinGeomFields.CANVAS_H))) } }
Function.Win_GetX       { Input: idx: Integer Output: Integer Body: { ReturnValue(Dereference(Add(Win_GeomPtr(idx), WinGeomFields.X)))        } }
Function.Win_GetY       { Input: idx: Integer Output: Integer Body: { ReturnValue(Dereference(Add(Win_GeomPtr(idx), WinGeomFields.Y)))        } }


