// =============================================================================
// WIN_GEOMPTR — pointer to a slot
// =============================================================================
Function.Win_GeomPtr {
    Input:  idx: Integer
    Output: Integer
    Body: {
        ReturnValue(Add(WinGeomTable.data, Multiply(idx, WinGeomConst.ENTRY_SIZE)))
    }
}

// =============================================================================
// WIN_SETGEOM — THE ONLY PLACE that writes window geometry.
//
// Derives canvas_w and canvas_h here. Stores all 6 fields.
// Then syncs FloatEntry so hit-testing and drag see the same values.
//
// Call this on:
//   - Win_Create      (initial size)
//   - Win_UpdateResize (every mouse move during resize)
// Nothing else should compute canvas_w or canvas_h independently.
// =============================================================================


Function.Win_SetGeom {
    Input: idx:     Integer
    Input: x:       Integer
    Input: y:       Integer
    Input: total_w: Integer
    Input: total_h: Integer
    Output: Integer
    Body: {
        bw       = DecorConfig.border_w
        canvas_w = Subtract(total_w, Multiply(bw, 2))
        canvas_h = Subtract(total_h, Multiply(bw, 2))
        min_cw   = WinMinSize.w
        min_ch   = WinMinSize.h
        IfCondition LessThan(canvas_w, min_cw) ThenBlock: { canvas_w = min_cw }
        IfCondition LessThan(canvas_h, min_ch) ThenBlock: { canvas_h = min_ch }
        total_w = Add(canvas_w, Multiply(bw, 2))
        total_h = Add(canvas_h, Multiply(bw, 2))

        // WinGeom stores BOX position and size (unchanged)
        gptr = Win_GeomPtr(idx)
        StoreValue(Add(gptr, WinGeomFields.TOTAL_W),  total_w)
        StoreValue(Add(gptr, WinGeomFields.TOTAL_H),  total_h)
        StoreValue(Add(gptr, WinGeomFields.CANVAS_W), canvas_w)
        StoreValue(Add(gptr, WinGeomFields.CANVAS_H), canvas_h)
        StoreValue(Add(gptr, WinGeomFields.X),        x)
        StoreValue(Add(gptr, WinGeomFields.Y),        y)

        // FloatEntry covers tab bar + toolbar + box for hit testing
        tbh       = Win_GetTabBarH_FromStack(idx)
        toolbar_h = WinMgr_GetToolbarH(idx)
        fptr = Float_EntryPtr(idx)
        StoreValue(Add(fptr, FloatEntryFields.X), x)
        StoreValue(Add(fptr, FloatEntryFields.Y), Subtract(Subtract(y, tbh), toolbar_h))
        StoreValue(Add(fptr, FloatEntryFields.W), total_w)
        StoreValue(Add(fptr, FloatEntryFields.H), Add(Add(total_h, tbh), toolbar_h))
        ReturnValue(1)
    }
}


// =============================================================================
// Win_BuildDefaultToolbar — build AK tree for File|Edit|View|Help toolbar
// Assumes AKTree globals are already swapped to the toolbar context.
// Returns root node index, or -1 on failure.
// =============================================================================
Function.Win_BuildDefaultToolbar {
    Output: Integer
    Body: {
        // Root group — horizontal box
        root = AK_CreateNode(AKTag.GROUP)
        IfCondition LessThan(root, 0) ThenBlock: { ReturnValue(-1) }
        AK_Set(root, AKF.LAYOUT_MODE, AKLayout.HBOX)
        AK_Set(root, AKF.GAP, 0)
        AK_Set(root, AKF.PAD_T, 0)
        AK_Set(root, AKF.PAD_R, 0)
        AK_Set(root, AKF.PAD_B, 0)
        AK_Set(root, AKF.PAD_L, 0)
        AK_ExtraSet(root, AKExtra.COLOR_BG, TVG_PackColor(42, 42, 42, 255))
        AK_SetRoot(root)

        // ─── File button ───
        btn_file = AK_CreateNode(AKTag.BUTTON)
        AK_Set(btn_file, AKF.MIN_W, 48)
        AK_Set(btn_file, AKF.HEIGHT, 24)
        AK_ExtraSet(btn_file, AKExtra.STR_PTR, "File")
        AK_ExtraSet(btn_file, AKExtra.STR_LEN, 4)
        AK_ExtraSet(btn_file, AKExtra.ACTION_PTR, "menu:file")
        AK_ExtraSet(btn_file, AKExtra.ACTION_LEN, 9)
        AK_AddChild(root, btn_file)

        // ─── Edit button ───
        btn_edit = AK_CreateNode(AKTag.BUTTON)
        AK_Set(btn_edit, AKF.MIN_W, 48)
        AK_Set(btn_edit, AKF.HEIGHT, 24)
        AK_ExtraSet(btn_edit, AKExtra.STR_PTR, "Edit")
        AK_ExtraSet(btn_edit, AKExtra.STR_LEN, 4)
        AK_ExtraSet(btn_edit, AKExtra.ACTION_PTR, "menu:edit")
        AK_ExtraSet(btn_edit, AKExtra.ACTION_LEN, 9)
        AK_AddChild(root, btn_edit)

        // ─── View button ───
        btn_view = AK_CreateNode(AKTag.BUTTON)
        AK_Set(btn_view, AKF.MIN_W, 48)
        AK_Set(btn_view, AKF.HEIGHT, 24)
        AK_ExtraSet(btn_view, AKExtra.STR_PTR, "View")
        AK_ExtraSet(btn_view, AKExtra.STR_LEN, 4)
        AK_ExtraSet(btn_view, AKExtra.ACTION_PTR, "menu:view")
        AK_ExtraSet(btn_view, AKExtra.ACTION_LEN, 9)
        AK_AddChild(root, btn_view)

        // ─── Help button ───
        btn_help = AK_CreateNode(AKTag.BUTTON)
        AK_Set(btn_help, AKF.MIN_W, 48)
        AK_Set(btn_help, AKF.HEIGHT, 24)
        AK_ExtraSet(btn_help, AKExtra.STR_PTR, "Help")
        AK_ExtraSet(btn_help, AKExtra.STR_LEN, 4)
        AK_ExtraSet(btn_help, AKExtra.ACTION_PTR, "menu:help")
        AK_ExtraSet(btn_help, AKExtra.ACTION_LEN, 9)
        AK_AddChild(root, btn_help)

        // ─── Spacer — pushes label to right ───
        spc = AK_CreateNode(AKTag.SPACER)
        AK_Set(spc, AKF.GROW, 1)
        AK_AddChild(root, spc)

        // ─── App name label ───
        lbl = AK_CreateNode(AKTag.LABEL)
        AK_Set(lbl, AKF.HEIGHT, 24)
        AK_ExtraSet(lbl, AKExtra.STR_PTR, "Application")
        AK_ExtraSet(lbl, AKExtra.STR_LEN, 11)
        AK_ExtraSet(lbl, AKExtra.TEXT_ALIGN, TRAlign.RIGHT)
        AK_ExtraSet(lbl, AKExtra.COLOR_FG, TVG_PackColor(136, 136, 136, 255))
        AK_ExtraSet(lbl, AKExtra.FONT_SIZE, 12)
        AK_AddChild(root, lbl)

        PrintMessage("[Toolbar] built default tree: 7 nodes\n")
        ReturnValue(root)
    }
}


// =============================================================================
// Win_CreateToolbarDefault — create toolbar with the built-in menu bar
// Wrapper that calls Win_BuildDefaultToolbar instead of parsing markup.
// =============================================================================
Function.Win_CreateToolbarDefault {
    Input: idx: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(idx, 0) ThenBlock: { ReturnValue(0) }

        total_w = Win_GetTotalW(idx)

        // Create Auckland context for this toolbar
        ctx = AKCtx_Create()
        IfCondition EqualTo(ctx, 0) ThenBlock: {
            PrintMessage("[Toolbar] context alloc failed\n")
            ReturnValue(0)
        }

        // Save main context
        save_data       = AKTree.data
        save_count      = AKTree.count
        save_root       = AKTree.root
        save_sn         = AKTree.scale_num
        save_sd         = AKTree.scale_den
        save_dw         = AKTree.design_w
        save_dh         = AKTree.design_h
        save_canvas     = AKTree.canvas
        save_edata      = AKExtraTable.data
        save_ecount     = AKExtraTable.count

        // Swap in toolbar context
        AKCtx_SwapIn(ctx)

        // Build tree programmatically
        ak_root = Win_BuildDefaultToolbar()
        IfCondition LessThan(ak_root, 0) ThenBlock: {
            PrintMessage("[Toolbar] build failed\n")
            AKTree.data       = save_data
            AKTree.count      = save_count
            AKTree.root       = save_root
            AKTree.scale_num  = save_sn
            AKTree.scale_den  = save_sd
            AKTree.design_w   = save_dw
            AKTree.design_h   = save_dh
            AKTree.canvas     = save_canvas
            AKExtraTable.data  = save_edata
            AKExtraTable.count = save_ecount
            AKCtx_Destroy(ctx)
            ReturnValue(0)
        }

        // Measure pass — let Auckland figure out the intrinsic height
        AK_MeasureNode(AKTree.root)
        tb_h = AK_Get(AKTree.root, AKF.SOLVED_H)
        IfCondition LessEqual(tb_h, 0) ThenBlock: { tb_h = 24 }

        PrintMessage("[Toolbar] measured h=")
        PrintNumber(tb_h)
        PrintMessage("\n")

        // Create toolbar surface at measured height
        tb_surf = Surface_Create(SurfaceFormat.PIXEL_32, total_w, tb_h)
        IfCondition EqualTo(tb_surf, 0) ThenBlock: {
            PrintMessage("[Toolbar] surface alloc failed\n")
            AKTree.data       = save_data
            AKTree.count      = save_count
            AKTree.root       = save_root
            AKTree.scale_num  = save_sn
            AKTree.scale_den  = save_sd
            AKTree.design_w   = save_dw
            AKTree.design_h   = save_dh
            AKTree.canvas     = save_canvas
            AKExtraTable.data  = save_edata
            AKExtraTable.count = save_ecount
            AKCtx_Destroy(ctx)
            ReturnValue(0)
        }

        // Fill and render
        Draw_Pix_FillRect(tb_surf, 0, 0, total_w, tb_h, 0xFF2A2A2A)
        AK_Draw(tb_surf, total_w, tb_h)

        // Save context and restore main
        AKCtx_SwapOut(ctx)
        AKTree.data       = save_data
        AKTree.count      = save_count
        AKTree.root       = save_root
        AKTree.scale_num  = save_sn
        AKTree.scale_den  = save_sd
        AKTree.design_w   = save_dw
        AKTree.design_h   = save_dh
        AKTree.canvas     = save_canvas
        AKExtraTable.data  = save_edata
        AKExtraTable.count = save_ecount

        // Store in WinMgr
        WinMgr_SetToolbar(idx, tb_surf)
        WinMgr_SetToolbarH(idx, tb_h)
        WinMgr_SetToolbarCtx(idx, ctx)

        // Update geometry — FloatEntry must cover toolbar
        wx = Win_GetX(idx)
        wy = Win_GetY(idx)
        ww = Win_GetTotalW(idx)
        wh = Win_GetTotalH(idx)
        Win_SetGeom(idx, wx, wy, ww, wh)

        PrintMessage("[Toolbar] created for win ")
        PrintNumber(idx)
        PrintMessage(" w=")
        PrintNumber(total_w)
        PrintMessage(" h=")
        PrintNumber(tb_h)
        PrintMessage("\n")

        ReturnValue(1)
    }
}



// Accessors — read WinGeom, not FloatEntry, not surface header
Function.Win_GetTotalW  { Input: idx: Integer Output: Integer Body: { ReturnValue(Dereference(Add(Win_GeomPtr(idx), WinGeomFields.TOTAL_W)))  } }
Function.Win_GetTotalH  { Input: idx: Integer Output: Integer Body: { ReturnValue(Dereference(Add(Win_GeomPtr(idx), WinGeomFields.TOTAL_H)))  } }
Function.Win_GetCanvasW { Input: idx: Integer Output: Integer Body: { ReturnValue(Dereference(Add(Win_GeomPtr(idx), WinGeomFields.CANVAS_W))) } }
Function.Win_GetCanvasH { Input: idx: Integer Output: Integer Body: { ReturnValue(Dereference(Add(Win_GeomPtr(idx), WinGeomFields.CANVAS_H))) } }
Function.Win_GetX       { Input: idx: Integer Output: Integer Body: { ReturnValue(Dereference(Add(Win_GeomPtr(idx), WinGeomFields.X)))        } }
Function.Win_GetY       { Input: idx: Integer Output: Integer Body: { ReturnValue(Dereference(Add(Win_GeomPtr(idx), WinGeomFields.Y)))        } }

// =============================================================================
// Stack table accessors
// =============================================================================
Function.Stack_Ptr {
    Input:  idx: Integer
    Output: Integer
    Body: { ReturnValue(Add(StackTable.data, Multiply(idx, StackConst.ENTRY_SIZE))) }
}

Function.Stack_Get {
    Input:  idx: Integer
    Input:  field: Integer
    Output: Integer
    Body: {
        sp = Stack_Ptr(idx)
        ReturnValue(Dereference(Add(sp, field)))
    }
}

Function.Stack_Set {
    Input: idx: Integer
    Input: field: Integer
    Input: val: Integer
    Body: {
        sp = Stack_Ptr(idx)
        StoreValue(Add(sp, field), val)
    }
}

Function.WinStack_Get {
    Input:  win_idx: Integer
    Output: Integer
    Body: { ReturnValue(Dereference(Add(WinStackMap.data, Multiply(win_idx, 8)))) }
}

Function.WinStack_Set {
    Input: win_idx: Integer
    Input: stack_idx: Integer
    Body: { StoreValue(Add(WinStackMap.data, Multiply(win_idx, 8)), stack_idx) }
}

Function.Stack_CalcHeight {
    Input:  tab_count: Integer
    Input:  canvas_w:  Integer
    Output: Integer
    Body: {
        tabs_per_row = Divide(canvas_w, TabConst.TAB_MAX_W)
        IfCondition LessThan(tabs_per_row, 1) ThenBlock: { tabs_per_row = 1 }
        row_count = Divide(Add(tab_count, Subtract(tabs_per_row, 1)), tabs_per_row)
        IfCondition LessThan(row_count, 1) ThenBlock: { row_count = 1 }
        tab_bar_h = Multiply(row_count, TabConst.TAB_ROW_H)
        ReturnValue(tab_bar_h)
    }
}

Function.Win_GetTabBarH_FromStack {
    Input:  idx: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(idx, 0) ThenBlock: {
            ReturnValue(0)
        }
        stack_idx = WinStack_Get(idx)
        IfCondition LessThan(stack_idx, 0) ThenBlock: {
            ReturnValue(DecorConfig.header_h)
        }
        tab_count = Stack_Get(stack_idx, StackFields.TAB_COUNT)
        canvas_w  = Win_GetCanvasW(idx)
        tbh = Stack_CalcHeight(tab_count, canvas_w)
        ReturnValue(tbh)
    }
}


Function.WinMgr_GetToolbarCtx {
    Input:  idx: Integer
    Output: Integer
    Body: { ReturnValue(Dereference(Add(WinMgr.toolbar_ctx_data, Multiply(idx, 8)))) }
}
Function.WinMgr_SetToolbarCtx {
    Input: idx: Integer
    Input: val: Integer
    Body: { StoreValue(Add(WinMgr.toolbar_ctx_data, Multiply(idx, 8)), val) }
}


Function.Stack_Create {
    Input:  win_idx: Integer
    Output: Integer
    Body: {
        sidx = -1
        si2 = 0
        WhileLoop LessThan(si2, StackConst.MAX) {
            act = Stack_Get(si2, StackFields.ACTIVE)
            IfCondition EqualTo(act, 0) ThenBlock: {
                sidx = si2
                si2 = StackConst.MAX
            } ElseBlock: {
                si2 = Add(si2, 1)
            }
        }
        IfCondition LessThan(sidx, 0) ThenBlock: {
            PrintMessage("[Stack] ERROR: table full\n")
            ReturnValue(-1)
        }

        wlist = Allocate(64)
        wi = 0
        WhileLoop LessThan(wi, 8) {
            StoreValue(Add(wlist, Multiply(wi, 8)), -1)
            wi = Add(wi, 1)
        }
        StoreValue(wlist, win_idx)

        Stack_Set(sidx, StackFields.TAB_SURF,   -1)
        Stack_Set(sidx, StackFields.TAB_COUNT,   1)
        Stack_Set(sidx, StackFields.TAB_BAR_H,   TabConst.TAB_ROW_H)
        Stack_Set(sidx, StackFields.ACTIVE_WIN,  0)
        Stack_Set(sidx, StackFields.WIN_LIST,    wlist)
        Stack_Set(sidx, StackFields.ACTIVE,      1)
        StackTable.count = Add(StackTable.count, 1)

        WinStack_Set(win_idx, sidx)

        PrintMessage("[Stack] created idx=")
        PrintNumber(sidx)
        PrintMessage(" win=")
        PrintNumber(win_idx)
        PrintMessage("\n")
        ReturnValue(sidx)
    }
}


// =============================================================================
// WIN_BRINGTOFRONT — move window idx to top of z-order (last slot)
//
// Pop from middle, push to tail. Reverse of Win_Close's shift.
// Shifts FloatEntry, WinGeom, hdr, content, tb, stackmap arrays.
// Returns the NEW index (always count-1) or -1 if no move needed.
// =============================================================================

Function.Win_BringToFront {
    Input:  idx: Integer
    Output: Integer
    Body: {
        cnt = FloatTable.count
        last = Subtract(cnt, 1)

        IfCondition EqualTo(idx, 0)    ThenBlock: { ReturnValue(-1) }
        IfCondition EqualTo(idx, last) ThenBlock: { ReturnValue(last) }
        IfCondition LessThan(idx, 0)   ThenBlock: { ReturnValue(-1) }

        // Save the window being moved
        save_float = Allocate(FloatEntryConst.SIZE)
        src_fp = Float_EntryPtr(idx)
        sf = 0
        WhileLoop LessThan(sf, FloatEntryConst.SIZE) {
            SetByte(save_float, sf, GetByte(src_fp, sf))
            sf = Add(sf, 1)
        }

        save_geom = Allocate(WinGeomConst.ENTRY_SIZE)
        src_gp = Win_GeomPtr(idx)
        sg = 0
        WhileLoop LessThan(sg, WinGeomConst.ENTRY_SIZE) {
            SetByte(save_geom, sg, GetByte(src_gp, sg))
            sg = Add(sg, 1)
        }

        save_hdr         = WinMgr_GetHdr(idx)
        save_content     = WinMgr_GetContent(idx)
        save_tb          = WinMgr_GetTB(idx)
        save_stack       = WinStack_Get(idx)
        save_title       = WinMgr_GetTitle(idx)
        save_toolbar     = WinMgr_GetToolbar(idx)
        save_toolbar_h   = WinMgr_GetToolbarH(idx)
        save_toolbar_ctx = WinMgr_GetToolbarCtx(idx)

        // Save WinView for the window being moved
        save_view = WinView_Save(idx)

        // Shift everything down from idx+1..last → idx..last-1
        i = idx
        WhileLoop LessThan(i, last) {
            next = Add(i, 1)

            dst_f = Float_EntryPtr(i)
            src_f = Float_EntryPtr(next)
            fj = 0
            WhileLoop LessThan(fj, FloatEntryConst.SIZE) {
                SetByte(dst_f, fj, GetByte(src_f, fj))
                fj = Add(fj, 1)
            }

            dst_g = Win_GeomPtr(i)
            src_g = Win_GeomPtr(next)
            gj = 0
            WhileLoop LessThan(gj, WinGeomConst.ENTRY_SIZE) {
                SetByte(dst_g, gj, GetByte(src_g, gj))
                gj = Add(gj, 1)
            }

            WinMgr_SetHdr(i,        WinMgr_GetHdr(next))
            WinMgr_SetContent(i,    WinMgr_GetContent(next))
            WinMgr_SetTB(i,         WinMgr_GetTB(next))
            WinStack_Set(i,         WinStack_Get(next))
            WinMgr_SetTitle(i,      WinMgr_GetTitle(next))
            WinMgr_SetToolbar(i,    WinMgr_GetToolbar(next))
            WinMgr_SetToolbarH(i,   WinMgr_GetToolbarH(next))
            WinMgr_SetToolbarCtx(i, WinMgr_GetToolbarCtx(next))

            // Shift WinView slot
            WinView_ShiftDown(i, next)

            i = Add(i, 1)
        }

        // Restore saved window at tail
        dst_fp = Float_EntryPtr(last)
        rf = 0
        WhileLoop LessThan(rf, FloatEntryConst.SIZE) {
            SetByte(dst_fp, rf, GetByte(save_float, rf))
            rf = Add(rf, 1)
        }

        dst_gp = Win_GeomPtr(last)
        rg = 0
        WhileLoop LessThan(rg, WinGeomConst.ENTRY_SIZE) {
            SetByte(dst_gp, rg, GetByte(save_geom, rg))
            rg = Add(rg, 1)
        }

        WinMgr_SetHdr(last,        save_hdr)
        WinMgr_SetContent(last,    save_content)
        WinMgr_SetTB(last,         save_tb)
        WinStack_Set(last,         save_stack)
        WinMgr_SetTitle(last,      save_title)
        WinMgr_SetToolbar(last,    save_toolbar)
        WinMgr_SetToolbarH(last,   save_toolbar_h)
        WinMgr_SetToolbarCtx(last, save_toolbar_ctx)

        // Restore WinView at tail (also frees the save buffer)
        WinView_Restore(last, save_view)

        Deallocate(save_float, FloatEntryConst.SIZE)
        Deallocate(save_geom,  WinGeomConst.ENTRY_SIZE)

        ReturnValue(last)
    }
}


// =============================================================================
// WIN_UPDATERESIZE — mouse move. Calls Win_SetGeom. Recreates surfaces.
// =============================================================================


Function.Win_UpdateResize {
    Input:  mouse_x: Integer
    Input:  mouse_y: Integer
    Output: Integer
    Body: {
        idx = WinMgr.resize_idx
        IfCondition LessThan(idx, 0) ThenBlock: { ReturnValue(0) }

        edge    = WinMgr.resize_edge
        bw      = DecorConfig.border_w
        dx      = Subtract(mouse_x, WinMgr.resize_anchor_x)
        dy      = Subtract(mouse_y, WinMgr.resize_anchor_y)
        orig_fx = WinMgr.resize_orig_fx
        orig_fy = WinMgr.resize_orig_fy
        orig_w  = WinMgr.resize_orig_w
        orig_h  = WinMgr.resize_orig_h

        Win_DebugNum("edge=",   edge)
        Win_DebugNum("dx=",     dx)
        Win_DebugNum("dy=",     dy)
        Win_DebugNum("orig_h=", orig_h)
        Win_DebugNum("orig_w=", orig_w)

        min_w = Add(WinMinSize.w, Multiply(bw, 2))
        min_h = Add(WinMinSize.h, Multiply(bw, 2))

        new_fx = orig_fx
        new_fy = orig_fy
        new_w  = orig_w
        new_h  = orig_h

        IfCondition NotEqual(BitwiseAnd(edge, ResizeEdge.RIGHT), 0) ThenBlock: {
            new_w = Add(orig_w, dx)
            IfCondition LessThan(new_w, min_w) ThenBlock: { new_w = min_w }
        }
        IfCondition NotEqual(BitwiseAnd(edge, ResizeEdge.LEFT), 0) ThenBlock: {
            new_w = Subtract(orig_w, dx)
            IfCondition LessThan(new_w, min_w) ThenBlock: {
                new_w = min_w
                new_fx = Subtract(Add(orig_fx, orig_w), min_w)
            } ElseBlock: {
                new_fx = Add(orig_fx, dx)
            }
        }
        IfCondition NotEqual(BitwiseAnd(edge, ResizeEdge.BOTTOM), 0) ThenBlock: {
            new_h = Add(orig_h, dy)
            IfCondition LessThan(new_h, min_h) ThenBlock: { new_h = min_h }
        }
        IfCondition NotEqual(BitwiseAnd(edge, ResizeEdge.TOP), 0) ThenBlock: {
            new_h = Subtract(orig_h, dy)
            IfCondition LessThan(new_h, min_h) ThenBlock: {
                new_h = min_h
                new_fy = Subtract(Add(orig_fy, orig_h), min_h)
            } ElseBlock: {
                new_fy = Add(orig_fy, dy)
            }
        }

        sw = FB_GetWidth()
        sh = FB_GetHeight()
        IfCondition LessThan(new_fx, 0) ThenBlock: { new_fx = 0 }
        IfCondition LessThan(new_fy, 0) ThenBlock: { new_fy = 0 }

        Win_SetGeom(idx, new_fx, new_fy, new_w, new_h)

        canvas_w = Win_GetCanvasW(idx)
        canvas_h = Win_GetCanvasH(idx)

        old_hdr     = WinMgr_GetHdr(idx)
        old_content = WinMgr_GetContent(idx)

        bg = WinColor.WINDOW

        tbh = Win_GetTabBarH_FromStack(idx)
        new_tw = Win_GetTotalW(idx)
        new_hdr = Surface_Create(SurfaceFormat.PIXEL_32, new_tw, tbh)
        IfCondition EqualTo(new_hdr, 0) ThenBlock: { ReturnValue(0) }
        Draw_Pix_FillRect(new_hdr, 0, 0, new_tw, tbh, 0xFF222222)

        new_content = Surface_Create(SurfaceFormat.PIXEL_32, canvas_w, canvas_h)
        IfCondition EqualTo(new_content, 0) ThenBlock: {
            Surface_Destroy(new_hdr)
            ReturnValue(0)
        }
        Draw_Pix_FillRect(new_content, 0, 0, canvas_w, canvas_h, bg)

        WinMgr_SetHdr(idx, new_hdr)
        WinMgr_SetContent(idx, new_content)

        fptr = Float_EntryPtr(idx)
        StoreValue(Add(fptr, FloatEntryFields.SURFACE), new_content)

        IfCondition GreaterEqual(old_hdr, 0)     ThenBlock: { Surface_Destroy(old_hdr) }
        IfCondition GreaterEqual(old_content, 0) ThenBlock: { Surface_Destroy(old_content) }

        WinMgr_SetTB(idx, -1)
        Win_DrawTabBar(idx)

        // Recreate toolbar surface if one exists
        old_toolbar = WinMgr_GetToolbar(idx)
        cur_toolbar_h = WinMgr_GetToolbarH(idx)
        IfCondition GreaterThan(cur_toolbar_h, 0) ThenBlock: {
            new_toolbar = Surface_Create(SurfaceFormat.PIXEL_32, Win_GetTotalW(idx), cur_toolbar_h)
            IfCondition GreaterThan(new_toolbar, 0) ThenBlock: {
                Draw_Pix_FillRect(new_toolbar, 0, 0, Win_GetTotalW(idx), cur_toolbar_h, 0xFF2A2A2A)
                WinMgr_SetToolbar(idx, new_toolbar)
                IfCondition GreaterEqual(old_toolbar, 0) ThenBlock: {
                    Surface_Destroy(old_toolbar)
                }
                // TODO: Phase C — re-render Auckland toolbar tree into new surface
            }
        }

        WinMgr.resize_anchor_x = mouse_x
        WinMgr.resize_anchor_y = mouse_y
        WinMgr.resize_orig_fx  = Win_GetX(idx)
        WinMgr.resize_orig_fy  = Win_GetY(idx)
        WinMgr.resize_orig_w   = Win_GetTotalW(idx)
        WinMgr.resize_orig_h   = Win_GetTotalH(idx)

        ReturnValue(1)
    }
}


// =============================================================================
// WIN_STARTRESIZE — reads orig geometry from WinGeom, not FloatEntry.
// FloatEntry could be stale; WinGeom is always authoritative.
// =============================================================================
Function.Win_StartResize {
    Input:  idx:     Integer
    Input:  mouse_x: Integer
    Input:  mouse_y: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(idx, 0) ThenBlock: { ReturnValue(0) }
        WinMgr.resize_idx      = idx
        WinMgr.resize_anchor_x = mouse_x
        WinMgr.resize_anchor_y = mouse_y

        

        // Read from WinGeom — this is why WinGeom exists
        WinMgr.resize_orig_fx = Win_GetX(idx)
        WinMgr.resize_orig_fy = Win_GetY(idx)
        WinMgr.resize_orig_w  = Win_GetTotalW(idx)
        WinMgr.resize_orig_h  = Win_GetTotalH(idx)
        WinMgr.resize_new_fx  = WinMgr.resize_orig_fx
        WinMgr.resize_new_fy  = WinMgr.resize_orig_fy
        WinMgr.resize_new_w   = WinMgr.resize_orig_w
        WinMgr.resize_new_h   = WinMgr.resize_orig_h

        Win_DebugPrint("RESIZE START")
        Win_DebugNum("idx=",   idx)
        Win_DebugNum("edge=",  WinMgr.resize_edge)
        Win_DebugNum("origW=", WinMgr.resize_orig_w)
        Win_DebugNum("origH=", WinMgr.resize_orig_h)
        ReturnValue(1)
    }
}

// =============================================================================
// WIN_CLOSE — shift WinGeom entries down alongside the other arrays.
// =============================================================================


Function.Win_Close {
    Input:  idx: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(idx, 0)        ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(idx, 0)       ThenBlock: { ReturnValue(0) }
        cnt = FloatTable.count
        IfCondition GreaterEqual(idx, cnt) ThenBlock: { ReturnValue(0) }

        // Destroy surfaces
        hdr_surf     = WinMgr_GetHdr(idx)
        content_surf = WinMgr_GetContent(idx)
        toolbar_surf = WinMgr_GetToolbar(idx)
        IfCondition GreaterEqual(hdr_surf, 0)     ThenBlock: { Surface_Destroy(hdr_surf) }
        IfCondition GreaterEqual(content_surf, 0) ThenBlock: { Surface_Destroy(content_surf) }
        IfCondition GreaterEqual(toolbar_surf, 0) ThenBlock: { Surface_Destroy(toolbar_surf) }

        // Destroy toolbar Auckland context
        toolbar_ctx = WinMgr_GetToolbarCtx(idx)
        IfCondition NotEqual(toolbar_ctx, 0) ThenBlock: { AKCtx_Destroy(toolbar_ctx) }

        // Destroy WinView bindings for the closing window
        WinView_Clear(idx)

        Float_Remove(idx)

        // Shift all parallel arrays down
        i = idx
        new_cnt = Subtract(cnt, 1)
        WhileLoop LessThan(i, new_cnt) {
            WinMgr_SetHdr(i,        WinMgr_GetHdr(Add(i, 1)))
            WinMgr_SetContent(i,    WinMgr_GetContent(Add(i, 1)))
            WinMgr_SetTB(i,         WinMgr_GetTB(Add(i, 1)))
            WinMgr_SetTitle(i,      WinMgr_GetTitle(Add(i, 1)))
            WinMgr_SetToolbar(i,    WinMgr_GetToolbar(Add(i, 1)))
            WinMgr_SetToolbarH(i,   WinMgr_GetToolbarH(Add(i, 1)))
            WinMgr_SetToolbarCtx(i, WinMgr_GetToolbarCtx(Add(i, 1)))

            // Copy WinGeom slot i+1 → i
            src = Win_GeomPtr(Add(i, 1))
            dst = Win_GeomPtr(i)
            j = 0
            WhileLoop LessThan(j, WinGeomConst.ENTRY_SIZE) {
                SetByte(dst, j, GetByte(src, j))
                j = Add(j, 1)
            }

            // Copy WinView slot i+1 → i
            WinView_ShiftDown(i, Add(i, 1))

            i = Add(i, 1)
        }

        // Zero vacated last slot
        WinMgr_SetHdr(new_cnt,        -1)
        WinMgr_SetContent(new_cnt,    -1)
        WinMgr_SetTB(new_cnt,         -1)
        WinMgr_SetTitle(new_cnt,       0)
        WinMgr_SetToolbar(new_cnt,    -1)
        WinMgr_SetToolbarH(new_cnt,    0)
        WinMgr_SetToolbarCtx(new_cnt,  0)
        last = Win_GeomPtr(new_cnt)
        j = 0
        WhileLoop LessThan(j, WinGeomConst.ENTRY_SIZE) {
            SetByte(last, j, 0)
            j = Add(j, 1)
        }
        WinView_Clear(new_cnt)

        WinMgr.count = Subtract(WinMgr.count, 1)
        new_focus = Subtract(idx, 1)
        IfCondition LessThan(new_focus, 0) ThenBlock: { new_focus = 0 }
        WinMgr.focused = new_focus
        ReturnValue(1)
    }
}




// =============================================================================
// WIN_APPLYRESIZE — mouse up. Clear state only. Surface already correct.
// =============================================================================
Function.Win_ApplyResize {
    Output: Integer
    Body: {
        idx = WinMgr.resize_idx
        IfCondition LessThan(idx, 0) ThenBlock: { ReturnValue(0) }
        WinMgr.resize_idx  = -1
        WinMgr.resize_edge = 0
        ReturnValue(1)
    }
}

// =============================================================================
// WIN_BLITALL — reads geometry from WinGeom, not FloatEntry, not surface header
// =============================================================================


Function.Win_BlitAll {
    Output: Integer
    Body: {
        cnt = FloatTable.count
        bw  = DecorConfig.border_w
        i   = 0
        WhileLoop LessThan(i, cnt) {
            x        = Win_GetX(i)
            y        = Win_GetY(i)
            total_w  = Win_GetTotalW(i)
            total_h  = Win_GetTotalH(i)
            canvas_w = Win_GetCanvasW(i)
            canvas_h = Win_GetCanvasH(i)

            hdr_surf     = WinMgr_GetHdr(i)
            content_surf = WinMgr_GetContent(i)

            // Desktop (i==0): blit content at origin, no header, no border
            IfCondition EqualTo(i, 0) ThenBlock: {
                IfCondition GreaterEqual(content_surf, 0) ThenBlock: {
                    Win_BlitOne(content_surf, x, y)
                }
            } ElseBlock: {
                tbh       = Win_GetTabBarH_FromStack(i)
                toolbar_h = WinMgr_GetToolbarH(i)

                // Tab bar — welded above toolbar + box, full width
                IfCondition GreaterEqual(hdr_surf, 0) ThenBlock: {
                    Win_BlitOne(hdr_surf, x, Subtract(Subtract(y, tbh), toolbar_h))
                }

                // Toolbar — between tab bar and box, full width
                toolbar_surf = WinMgr_GetToolbar(i)
                IfCondition GreaterEqual(toolbar_surf, 0) ThenBlock: {
                    Win_BlitOne(toolbar_surf, x, Subtract(y, toolbar_h))
                }

                // Content — inside box
                IfCondition GreaterEqual(content_surf, 0) ThenBlock: {
                    Win_BlitOne(content_surf, Add(x, bw), Add(y, bw))
                }

                // Border — the box itself
                Win_DrawBorderFB(x, y, total_w, total_h)
            }

            i = Add(i, 1)
        }
        Cursor_Draw()
        FB_FlipFast()
        ReturnValue(0)
    }
}



// =============================================================================
// APPEND THIS ENTIRE BLOCK to the end of Library.WinManager.ailang
// These functions were lost in the rewrite. Do not replace anything —
// just paste this after the last closing brace in the file.
// =============================================================================

FixedPool.ResizeEdge {
    "LEFT":   Initialize=1
    "RIGHT":  Initialize=2
    "TOP":    Initialize=4
    "BOTTOM": Initialize=8
}

FixedPool.WinMinSize {
    "w": Initialize=200
    "h": Initialize=200
}

