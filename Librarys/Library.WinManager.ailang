// =============================================================================
// WINGEOM — per-window authoritative geometry table
//
// One entry per window slot (max 8). Written ONLY by Win_SetGeom.
// Every other function reads from here. No other code computes canvas_w/h.
//
// Fields per entry (8 bytes each, 48 bytes per slot):
//   total_w   — full FB footprint width
//   total_h   — full FB footprint height
//   canvas_w  — total_w - (bw*2)           derived at assignment, stored
//   canvas_h  — total_h - hh - (bw*3)      derived at assignment, stored
//   x         — FB origin x
//   y         — FB origin y
// =============================================================================

// Library.WinManager.ailang
// Copyright © 2025 Sean Collins, 2 Paws Machine and Engineering. All rights reserved. SCSL.

LibraryImport.DSurfaceTypes
LibraryImport.DSurface
LibraryImport.DDrawPixel
LibraryImport.DComposeTypes
LibraryImport.DComposeFloat
LibraryImport.Cursor


// =============================================================================
// WINMGR_INIT — add WinGeom_Init() call
// =============================================================================


Function.WinMgr_Init {
    Output: Integer
    Body: {
        WinMgr.focused      = -1
        WinMgr.count        = 0
        WinMgr.hdr_data     = Allocate(64)
        WinMgr.content_data = Allocate(64)
        WinMgr.tb_data      = Allocate(64)
        WinMgr.title_data   = Allocate(64)
        WinMgr.toolbar_data     = Allocate(64)
        WinMgr.toolbar_h_data   = Allocate(64)
        WinMgr.toolbar_ctx_data = Allocate(64)

        i = 0
        
        WhileLoop LessThan(i, 8) {
            off = Multiply(i, 8)
            StoreValue(Add(WinMgr.hdr_data,         off), -1)
            StoreValue(Add(WinMgr.content_data,     off), -1)
            StoreValue(Add(WinMgr.tb_data,          off), -1)
            StoreValue(Add(WinMgr.title_data,       off), 0)
            StoreValue(Add(WinMgr.toolbar_data,     off), -1)
            StoreValue(Add(WinMgr.toolbar_h_data,   off), 0)
            StoreValue(Add(WinMgr.toolbar_ctx_data, off), 0)
            i = Add(i, 1)
        }

        geom_size = Multiply(WinGeomConst.MAX, WinGeomConst.ENTRY_SIZE)
        geom_buf  = Allocate(geom_size)
        gi = 0
        WhileLoop LessThan(gi, geom_size) {
            SetByte(geom_buf, gi, 0)
            gi = Add(gi, 1)
        }
        WinGeomTable.data = geom_buf

        stack_size = Multiply(StackConst.MAX, StackConst.ENTRY_SIZE)
        stack_buf  = Allocate(stack_size)
        si = 0
        WhileLoop LessThan(si, stack_size) {
            SetByte(stack_buf, si, 0)
            si = Add(si, 1)
        }
        StackTable.data  = stack_buf
        StackTable.count = 0

        map_buf = Allocate(64)
        mi = 0
        WhileLoop LessThan(mi, 8) {
            StoreValue(Add(map_buf, Multiply(mi, 8)), -1)
            mi = Add(mi, 1)
        }
        WinStackMap.data = map_buf

        PrintMessage("[WinMgr] stacks initialized\n")

        WinView_Init()

        ReturnValue(1)
    }
}


Function.Win_CreateToolbar {
    Input: idx: Integer
    Input: markup: Address
    Input: markup_len: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(idx, 0)       ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(markup, 0)    ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(markup_len, 0) ThenBlock: { ReturnValue(0) }

        total_w = Win_GetTotalW(idx)

        // Create Auckland context for this toolbar
        ctx = AKCtx_Create()
        IfCondition EqualTo(ctx, 0) ThenBlock: {
            PrintMessage("[Toolbar] context alloc failed\n")
            ReturnValue(0)
        }

        // Save main context
        save_data       = AKTree.data
        save_count      = AKTree.count
        save_root       = AKTree.root
        save_sn         = AKTree.scale_num
        save_sd         = AKTree.scale_den
        save_dw         = AKTree.design_w
        save_dh         = AKTree.design_h
        save_canvas     = AKTree.canvas
        save_edata      = AKExtraTable.data
        save_ecount     = AKExtraTable.count

        // Swap in toolbar context
        AKCtx_SwapIn(ctx)

        // Parse markup into this context's tree
        ak_root = AKParse_String(markup, markup_len)
        IfCondition LessThan(ak_root, 0) ThenBlock: {
            PrintMessage("[Toolbar] parse failed\n")
            AKTree.data       = save_data
            AKTree.count      = save_count
            AKTree.root       = save_root
            AKTree.scale_num  = save_sn
            AKTree.scale_den  = save_sd
            AKTree.design_w   = save_dw
            AKTree.design_h   = save_dh
            AKTree.canvas     = save_canvas
            AKExtraTable.data  = save_edata
            AKExtraTable.count = save_ecount
            AKCtx_Destroy(ctx)
            ReturnValue(0)
        }

        // Measure pass — let Auckland figure out the intrinsic height
        AK_MeasureNode(AKTree.root)
        tb_h = AK_Get(AKTree.root, AKF.SOLVED_H)

        // Fallback: if measure returned 0 (no explicit heights on children),
        // use a sensible minimum based on font line height
        IfCondition LessEqual(tb_h, 0) ThenBlock: {
            tb_h = 24
        }

        PrintMessage("[Toolbar] measured h=")
        PrintNumber(tb_h)
        PrintMessage("\n")

        // Create toolbar surface at measured height
        tb_surf = Surface_Create(SurfaceFormat.PIXEL_32, total_w, tb_h)
        IfCondition EqualTo(tb_surf, 0) ThenBlock: {
            PrintMessage("[Toolbar] surface alloc failed\n")
            AKTree.data       = save_data
            AKTree.count      = save_count
            AKTree.root       = save_root
            AKTree.scale_num  = save_sn
            AKTree.scale_den  = save_sd
            AKTree.design_w   = save_dw
            AKTree.design_h   = save_dh
            AKTree.canvas     = save_canvas
            AKExtraTable.data  = save_edata
            AKExtraTable.count = save_ecount
            AKCtx_Destroy(ctx)
            ReturnValue(0)
        }

        // Fill toolbar background
        Draw_Pix_FillRect(tb_surf, 0, 0, total_w, tb_h, 0xFF2A2A2A)

        // Full solve + render — now with the real surface dimensions
        AK_Draw(tb_surf, total_w, tb_h)

        // Save context state back
        AKCtx_SwapOut(ctx)

        // Restore main context
        AKTree.data       = save_data
        AKTree.count      = save_count
        AKTree.root       = save_root
        AKTree.scale_num  = save_sn
        AKTree.scale_den  = save_sd
        AKTree.design_w   = save_dw
        AKTree.design_h   = save_dh
        AKTree.canvas     = save_canvas
        AKExtraTable.data  = save_edata
        AKExtraTable.count = save_ecount

        // Store in WinMgr
        WinMgr_SetToolbar(idx, tb_surf)
        WinMgr_SetToolbarH(idx, tb_h)
        WinMgr_SetToolbarCtx(idx, ctx)

        // Geometry needs update — FloatEntry must cover toolbar now
        wx = Win_GetX(idx)
        wy = Win_GetY(idx)
        ww = Win_GetTotalW(idx)
        wh = Win_GetTotalH(idx)
        Win_SetGeom(idx, wx, wy, ww, wh)

        PrintMessage("[Toolbar] created for win ")
        PrintNumber(idx)
        PrintMessage(" w=")
        PrintNumber(total_w)
        PrintMessage(" h=")
        PrintNumber(tb_h)
        PrintMessage("\n")

        ReturnValue(1)
    }
}


// =============================================================================
// Win_RedrawToolbar — re-render toolbar (after resize, theme change, etc.)
// =============================================================================
Function.Win_RedrawToolbar {
    Input: idx: Integer
    Output: Integer
    Body: {
        ctx = WinMgr_GetToolbarCtx(idx)
        IfCondition EqualTo(ctx, 0) ThenBlock: { ReturnValue(0) }

        tb_surf = WinMgr_GetToolbar(idx)
        IfCondition LessThan(tb_surf, 0) ThenBlock: { ReturnValue(0) }

        total_w = Win_GetTotalW(idx)
        tb_h    = WinMgr_GetToolbarH(idx)

        // Save main context
        save_data       = AKTree.data
        save_count      = AKTree.count
        save_root       = AKTree.root
        save_sn         = AKTree.scale_num
        save_sd         = AKTree.scale_den
        save_dw         = AKTree.design_w
        save_dh         = AKTree.design_h
        save_canvas     = AKTree.canvas
        save_edata      = AKExtraTable.data
        save_ecount     = AKExtraTable.count

        // Swap in toolbar context
        AKCtx_SwapIn(ctx)

        // Clear and re-render
        Draw_Pix_FillRect(tb_surf, 0, 0, total_w, tb_h, 0xFF2A2A2A)
        AK_Draw(tb_surf, total_w, tb_h)

        // Save back and restore
        AKCtx_SwapOut(ctx)
        AKTree.data       = save_data
        AKTree.count      = save_count
        AKTree.root       = save_root
        AKTree.scale_num  = save_sn
        AKTree.scale_den  = save_sd
        AKTree.design_w   = save_dw
        AKTree.design_h   = save_dh
        AKTree.canvas     = save_canvas
        AKExtraTable.data  = save_edata
        AKExtraTable.count = save_ecount

        ReturnValue(1)
    }
}


// Win title acessors
Function.WinMgr_GetTitle {
    Input:  idx: Integer
    Output: Integer
    Body: { ReturnValue(Dereference(Add(WinMgr.title_data, Multiply(idx, 8)))) }
}

Function.WinMgr_SetTitle {
    Input: idx: Integer
    Input: val: Integer
    Body: { StoreValue(Add(WinMgr.title_data, Multiply(idx, 8)), val) }
}




Function.Win_DrawTabBar {
    Input: idx: Integer
    Output: Integer
    Body: {
        surf = WinMgr_GetHdr(idx)
        IfCondition LessThan(surf, 0) ThenBlock: { ReturnValue(0) }

        tw  = Win_GetTotalW(idx)
        tbh = Win_GetTabBarH_FromStack(idx)
        inst = WinMgr.tab_inst

        // Fill entire tab bar background (dark)
        Draw_Pix_FillRect(surf, 0, 0, tw, tbh, 0xFF1A1A1A)

        // Draw active tab rect
        tab_x = 0
        tab_w = TabConst.TAB_MAX_W
        tab_h = TabConst.TAB_ROW_H
        pad   = TabConst.TAB_PAD

        // Active tab background (lighter)
        Draw_Pix_FillRect(surf, tab_x, 0, tab_w, tab_h, 0xFF3A3A3A)

        // Icon placeholder — 10x10 colored rect
        icon_x = Add(tab_x, pad)
        icon_y = Divide(Subtract(tab_h, TabConst.TAB_ICON_W), 2)
        Draw_Pix_FillRect(surf, icon_x, icon_y, TabConst.TAB_ICON_W, TabConst.TAB_ICON_W, 0xFF5588CC)

        // Title text — 8 chars max
        title_ptr = WinMgr_GetTitle(idx)
        IfCondition NotEqual(title_ptr, 0) ThenBlock: {
            IfCondition GreaterEqual(inst, 0) ThenBlock: {
                text_x = Add(Add(icon_x, TabConst.TAB_ICON_W), pad)
                text_y = Divide(Subtract(tab_h, 14), 2)
                // Clamp to 8 chars
                title_len = StringLength(title_ptr)
                IfCondition GreaterThan(title_len, 8) ThenBlock: { title_len = 8 }
                text_color = TVG_PackColor(220, 220, 220, 255)
                VInst_DrawString(inst, surf, title_ptr, title_len, text_x, text_y, text_color)
            }
        }

        ReturnValue(1)
    }
}


