// ============================================================================
// WINVIEW — Per-window job linkage and cached bindings
//
// Append this entire block to the end of Library.WinManager.ailang.
// Does NOT replace any existing code. The parallel arrays stay as-is.
//
// WinView adds the fields needed for app launch + action dispatch:
//   - job_ptr:       pointer to JobInstance (0 if internal/no service)
//   - service_id:    links to services table in PostgreSQL
//   - bindings:      XArray of cached {action, msg_method} pairs
//   - binding_count: number of cached bindings
//   - view_type:     string ptr ("notepad", "filebrowser", etc.)
//   - doc_handle:    Document library handle (-1 if none)
//   - page_handle:   current PageSurface handle (-1 if none)
//
// Layout (56 bytes per entry, 8 slots = 448 bytes total):
//   Offset  0: job_ptr        (Address, 0 = no service)
//   Offset  8: service_id     (Integer, -1 = none)
//   Offset 16: bindings       (Address, XArray ptr or 0)
//   Offset 24: binding_count  (Integer)
//   Offset 32: view_type      (Address, string ptr or 0)
//   Offset 40: doc_handle     (Integer, -1 = none)
//   Offset 48: page_handle    (Integer, -1 = none)
// ============================================================================

FixedPool.WinViewFields {
    "JOB_PTR":       Initialize=0
    "SERVICE_ID":    Initialize=8
    "BINDINGS":      Initialize=16
    "BINDING_COUNT": Initialize=24
    "VIEW_TYPE":     Initialize=32
    "DOC_HANDLE":    Initialize=40
    "PAGE_HANDLE":   Initialize=48
}

FixedPool.WinViewConst {
    "ENTRY_SIZE": Initialize=56
    "MAX":        Initialize=8
}

FixedPool.WinViewTable {
    "data": Initialize=0
}

// ============================================================================
// INIT — call from WinMgr_Init (add WinView_Init() call there)
// ============================================================================
Function.WinView_Init {
    Output: Integer
    Body: {
        sz = Multiply(WinViewConst.MAX, WinViewConst.ENTRY_SIZE)
        buf = Allocate(sz)
        IfCondition EqualTo(buf, 0) ThenBlock: {
            PrintMessage("[WinView] alloc fail\n")
            ReturnValue(0)
        }

        // Zero the buffer
        i = 0
        WhileLoop LessThan(i, sz) {
            SetByte(buf, i, 0)
            i = Add(i, 1)
        }

        // Set sentinel values for each slot
        s = 0
        WhileLoop LessThan(s, WinViewConst.MAX) {
            base = Add(buf, Multiply(s, WinViewConst.ENTRY_SIZE))
            StoreValue(Add(base, WinViewFields.JOB_PTR),       0)
            StoreValue(Add(base, WinViewFields.SERVICE_ID),    -1)
            StoreValue(Add(base, WinViewFields.BINDINGS),       0)
            StoreValue(Add(base, WinViewFields.BINDING_COUNT),  0)
            StoreValue(Add(base, WinViewFields.VIEW_TYPE),      0)
            StoreValue(Add(base, WinViewFields.DOC_HANDLE),    -1)
            StoreValue(Add(base, WinViewFields.PAGE_HANDLE),   -1)
            s = Add(s, 1)
        }

        WinViewTable.data = buf
        PrintMessage("[WinView] initialized\n")
        ReturnValue(1)
    }
}

// ============================================================================
// POINTER — get base address for a slot
// ============================================================================
Function.WinView_Ptr {
    Input: idx: Integer
    Output: Integer
    Body: {
        ReturnValue(Add(WinViewTable.data, Multiply(idx, WinViewConst.ENTRY_SIZE)))
    }
}

// ============================================================================
// FIELD ACCESSORS — Get/Set for each field
// ============================================================================
Function.WinView_GetJobPtr {
    Input: idx: Integer
    Output: Integer
    Body: {
        base = WinView_Ptr(idx)
        ReturnValue(Dereference(Add(base, WinViewFields.JOB_PTR)))
    }
}
Function.WinView_SetJobPtr {
    Input: idx: Integer
    Input: val: Integer
    Body: {
        base = WinView_Ptr(idx)
        StoreValue(Add(base, WinViewFields.JOB_PTR), val)
    }
}

