// ============================================================================
// CLEAR — reset a slot to defaults (call from Win_Close)
// ============================================================================
Function.WinView_Clear {
    Input: idx: Integer
    Body: {
        // Destroy bindings XArray if present
        bindings = WinView_GetBindings(idx)
        IfCondition NotEqual(bindings, 0) ThenBlock: {
            XArray.XDestroy(bindings)
        }

        base = WinView_Ptr(idx)
        StoreValue(Add(base, WinViewFields.JOB_PTR),       0)
        StoreValue(Add(base, WinViewFields.SERVICE_ID),    -1)
        StoreValue(Add(base, WinViewFields.BINDINGS),       0)
        StoreValue(Add(base, WinViewFields.BINDING_COUNT),  0)
        StoreValue(Add(base, WinViewFields.VIEW_TYPE),      0)
        StoreValue(Add(base, WinViewFields.DOC_HANDLE),    -1)
        StoreValue(Add(base, WinViewFields.PAGE_HANDLE),   -1)
    }
}

// ============================================================================
// SHIFT DOWN — for Win_Close, shift slot i+1 into slot i (memcpy)
// ============================================================================
Function.WinView_ShiftDown {
    Input: dst_idx: Integer
    Input: src_idx: Integer
    Body: {
        src = WinView_Ptr(src_idx)
        dst = WinView_Ptr(dst_idx)
        j = 0
        WhileLoop LessThan(j, WinViewConst.ENTRY_SIZE) {
            SetByte(dst, j, GetByte(src, j))
            j = Add(j, 1)
        }
    }
}

// ============================================================================
// SAVE / RESTORE — for Win_BringToFront
// ============================================================================
Function.WinView_Save {
    Input: idx: Integer
    Output: Integer
    Body: {
        buf = Allocate(WinViewConst.ENTRY_SIZE)
        src = WinView_Ptr(idx)
        j = 0
        WhileLoop LessThan(j, WinViewConst.ENTRY_SIZE) {
            SetByte(buf, j, GetByte(src, j))
            j = Add(j, 1)
        }
        ReturnValue(buf)
    }
}

Function.WinView_Restore {
    Input: idx: Integer
    Input: buf: Integer
    Body: {
        dst = WinView_Ptr(idx)
        j = 0
        WhileLoop LessThan(j, WinViewConst.ENTRY_SIZE) {
            SetByte(dst, j, GetByte(buf, j))
            j = Add(j, 1)
        }
        Deallocate(buf, WinViewConst.ENTRY_SIZE)
    }
}


