// =============================================================================
// DEBUG HELPERS
// =============================================================================


Function.Win_DebugPrint {
    Input: msg: Integer
    Body: {
        PrintMessage("[W] ")
        PrintMessage(msg)
        PrintMessage("\n")
        ReturnValue(0)
    }
}

Function.Win_DebugNum {
    Input: msg: Integer
    Input: val: Integer
    Body: {
        PrintMessage("[W] ")
        PrintMessage(msg)
        PrintNumber(val)
        PrintMessage("\n")
        ReturnValue(0)
    }
}

// =============================================================================
// WIN_DRAWBORDERFB — draw border rect directly to framebuffer
// =============================================================================
Function.Win_DrawBorderFB {
    Input: x: Integer
    Input: y: Integer
    Input: w: Integer
    Input: h: Integer
    Output: Integer
    Body: {
        bw  = DecorConfig.border_w
        buf = FB_GetDrawBuffer()
        pit = FB.pitch
        pb  = SurfaceConst.PIXEL_BYTES
        col = WinColor.BORDER
        b   = BitwiseAnd(col, 255)
        g   = BitwiseAnd(ShiftRight(col, 8),  255)
        r   = BitwiseAnd(ShiftRight(col, 16), 255)

        // Top rows
        row = 0
        WhileLoop LessThan(row, bw) {
            px = 0
            WhileLoop LessThan(px, w) {
                off = Add(Multiply(Add(y, row), pit), Multiply(Add(x, px), pb))
                SetByte(buf, Add(off, 0), b)
                SetByte(buf, Add(off, 1), g)
                SetByte(buf, Add(off, 2), r)
                SetByte(buf, Add(off, 3), 0)
                px = Add(px, 1)
            }
            row = Add(row, 1)
        }
        // Bottom rows
        row = 0
        WhileLoop LessThan(row, bw) {
            py = Subtract(Add(y, h), Add(row, 1))
            px = 0
            WhileLoop LessThan(px, w) {
                off = Add(Multiply(py, pit), Multiply(Add(x, px), pb))
                SetByte(buf, Add(off, 0), b)
                SetByte(buf, Add(off, 1), g)
                SetByte(buf, Add(off, 2), r)
                SetByte(buf, Add(off, 3), 0)
                px = Add(px, 1)
            }
            row = Add(row, 1)
        }
        // Left cols (middle rows only)
        row = bw
        WhileLoop LessThan(row, Subtract(h, bw)) {
            px = 0
            WhileLoop LessThan(px, bw) {
                off = Add(Multiply(Add(y, row), pit), Multiply(Add(x, px), pb))
                SetByte(buf, Add(off, 0), b)
                SetByte(buf, Add(off, 1), g)
                SetByte(buf, Add(off, 2), r)
                SetByte(buf, Add(off, 3), 0)
                px = Add(px, 1)
            }
            row = Add(row, 1)
        }
        // Right cols
        row = bw
        WhileLoop LessThan(row, Subtract(h, bw)) {
            px = 0
            WhileLoop LessThan(px, bw) {
                rx  = Add(Add(x, w), Subtract(px, bw))
                off = Add(Multiply(Add(y, row), pit), Multiply(rx, pb))
                SetByte(buf, Add(off, 0), b)
                SetByte(buf, Add(off, 1), g)
                SetByte(buf, Add(off, 2), r)
                SetByte(buf, Add(off, 3), 0)
                px = Add(px, 1)
            }
            row = Add(row, 1)
        }
        ReturnValue(0)
    }
}

// =============================================================================
// WIN_DRAWHEADER — fill header surface, draw title text
// =============================================================================


Function.Win_DrawHeader {
    Input: idx:   Integer
    Input: title: Integer
    Output: Integer
    Body: {
        ReturnValue(Win_DrawTabBar(idx))
    }
}

// =============================================================================
// WIN_CREATE — allocate a new window slot, set geometry, create surfaces.
// x, y, canvas_w, canvas_h — caller specifies content area size.
// total_w/h are derived by Win_SetGeom. Surfaces are sized from WinGeom readback.
// Returns the new window index, or -1 on failure.
// =============================================================================


Function.Win_Create {
    Input:  canvas_w: Integer
    Input:  canvas_h: Integer
    Input:  color:    Integer
    Input:  title:    Integer
    Output: Integer
    Body: {
        cnt = FloatTable.count
        IfCondition GreaterEqual(cnt, FloatEntryConst.MAX_FLOATING) ThenBlock: {
            PrintMessage("[Win] ERROR: max windows\n")
            ReturnValue(-1)
        }

        bw = DecorConfig.border_w

        total_w = Add(canvas_w, Multiply(bw, 2))
        total_h = Add(canvas_h, Multiply(bw, 2))

        sw = Compositor.screen_w
        sh = Compositor.screen_h
        fx = Divide(Subtract(sw, total_w), 2)
        fy = Divide(Subtract(sh, total_h), 2)

        idx = Float_Add(0, fx, fy, total_w, total_h)
        IfCondition LessThan(idx, 0) ThenBlock: {
            PrintMessage("[Win] ERROR: Float_Add\n")
            ReturnValue(-1)
        }

        Win_SetGeom(idx, fx, fy, total_w, total_h)

        cw = Win_GetCanvasW(idx)
        ch = Win_GetCanvasH(idx)

        tbh = DecorConfig.header_h
        hdr_surf = Surface_Create(SurfaceFormat.PIXEL_32, Win_GetTotalW(idx), tbh)
        IfCondition EqualTo(hdr_surf, 0) ThenBlock: {
            Float_Remove(idx)
            PrintMessage("[Win] ERROR: header surface\n")
            ReturnValue(-1)
        }
        Draw_Pix_FillRect(hdr_surf, 0, 0, Win_GetTotalW(idx), tbh, 0xFF222222)

        bg = color
        IfCondition LessThan(color, 0) ThenBlock: { bg = WinColor.WINDOW }
        content_surf = Surface_Create(SurfaceFormat.PIXEL_32, cw, ch)
        IfCondition EqualTo(content_surf, 0) ThenBlock: {
            Float_Remove(idx)
            Surface_Destroy(hdr_surf)
            PrintMessage("[Win] ERROR: content surface\n")
            ReturnValue(-1)
        }
        Draw_Pix_FillRect(content_surf, 0, 0, cw, ch, bg)

        fptr = Float_EntryPtr(idx)
        StoreValue(Add(fptr, FloatEntryFields.SURFACE), content_surf)

        tb = -1

        WinMgr_SetHdr(idx, hdr_surf)
        WinMgr_SetContent(idx, content_surf)
        WinMgr_SetTB(idx, tb)
        WinMgr_SetTitle(idx, title)
        WinMgr_SetToolbar(idx, -1)
        WinMgr_SetToolbarH(idx, 0)
        WinMgr.count = Add(WinMgr.count, 1)

        Win_DrawTabBar(idx)

        PrintMessage("[Win] created idx=")
        PrintNumber(idx)
        PrintMessage(" canvas=")
        PrintNumber(cw)
        PrintMessage("x")
        PrintNumber(ch)
        PrintMessage("\n")

        ReturnValue(idx)
    }
}

// =============================================================================
// WIN_BLITONE — blit surface to framebuffer at (dst_x, dst_y)
// =============================================================================
Function.Win_BlitOne {
    Input: surf:  Integer
    Input: dst_x: Integer
    Input: dst_y: Integer
    Output: Integer
    Body: {
        sw        = Surface_GetWidth(surf)
        sh        = Surface_GetHeight(surf)
        src_data  = Surface_GetData(surf)
        src_pitch = Surface_GetPitch(surf)
        dst_buf   = FB_GetDrawBuffer()
        dst_pitch = FB.pitch
        row_bytes = Multiply(sw, SurfaceConst.PIXEL_BYTES)
        dst_x_off = Multiply(dst_x, SurfaceConst.PIXEL_BYTES)
        y = 0
        WhileLoop LessThan(y, sh) {
            src_row = Add(src_data, Multiply(y, src_pitch))
            dst_row = Add(Add(dst_buf, Multiply(Add(y, dst_y), dst_pitch)), dst_x_off)
            i = 0
            WhileLoop LessThan(i, row_bytes) {
                SetByte(dst_row, i, GetByte(src_row, i))
                i = Add(i, 1)
            }
            y = Add(y, 1)
        }
        ReturnValue(1)
    }
}

// =============================================================================
// WIN_BLITCLAMPED — blit surface clipped to clip_w x clip_h
// =============================================================================
Function.Win_BlitClamped {
    Input: surf:   Integer
    Input: dst_x:  Integer
    Input: dst_y:  Integer
    Input: clip_w: Integer
    Input: clip_h: Integer
    Output: Integer
    Body: {
        sw        = Surface_GetWidth(surf)
        sh        = Surface_GetHeight(surf)
        src_data  = Surface_GetData(surf)
        src_pitch = Surface_GetPitch(surf)
        dst_buf   = FB_GetDrawBuffer()
        dst_pitch = FB.pitch
        pb        = SurfaceConst.PIXEL_BYTES
        draw_w = sw
        draw_h = sh
        IfCondition LessThan(clip_w, sw) ThenBlock: { draw_w = clip_w }
        IfCondition LessThan(clip_h, sh) ThenBlock: { draw_h = clip_h }
        row_bytes = Multiply(draw_w, pb)
        dst_x_off = Multiply(dst_x, pb)
        y = 0
        WhileLoop LessThan(y, draw_h) {
            src_row = Add(src_data, Multiply(y, src_pitch))
            dst_row = Add(Add(dst_buf, Multiply(Add(y, dst_y), dst_pitch)), dst_x_off)
            i = 0
            WhileLoop LessThan(i, row_bytes) {
                SetByte(dst_row, i, GetByte(src_row, i))
                i = Add(i, 1)
            }
            y = Add(y, 1)
        }
        ReturnValue(1)
    }
}

// =============================================================================
// WIN_RENDERDIRTY — render any dirty TextBuffers
// =============================================================================

Function.Win_RenderDirty {
    Output: Integer
    Body: {
        ReturnValue(0)
    }
}

// =============================================================================
// WIN_FOCUS  -call Win_BringToFront
// =============================================================================

Function.Win_Focus {
    Input:  idx: Integer
    Output: Integer
    Body: {
        // Skip desktop
        IfCondition EqualTo(idx, 0) ThenBlock: {
            WinMgr.focused = 0
            ReturnValue(1)
        }
        new_idx = Win_BringToFront(idx)
        IfCondition GreaterEqual(new_idx, 0) ThenBlock: {
            WinMgr.focused = new_idx
        } ElseBlock: {
            // Already on top, just set focus
            WinMgr.focused = idx
        }
        ReturnValue(1)
    }
}

// =============================================================================
// WIN_HITTEST
// =============================================================================
Function.Win_HitTest {
    Input:  x: Integer
    Input:  y: Integer
    Output: Integer
    Body: { ReturnValue(Float_HitTest(x, y)) }
}

// =============================================================================
// WIN_HEADERHITTEST
// =============================================================================


Function.Win_HeaderHitTest {
    Input:  px: Integer
    Input:  py: Integer
    Output: Integer
    Body: {
        cnt = FloatTable.count
        i   = Subtract(cnt, 1)
        WhileLoop GreaterEqual(i, 0) {
            fx        = Win_GetX(i)
            fy        = Win_GetY(i)
            total_w   = Win_GetTotalW(i)
            tbh       = Win_GetTabBarH_FromStack(i)
            toolbar_h = WinMgr_GetToolbarH(i)

            // Tab bar zone: full width, above toolbar + box
            hx0 = fx
            hx1 = Add(fx, total_w)
            hy0 = Subtract(Subtract(fy, tbh), toolbar_h)
            hy1 = Subtract(fy, toolbar_h)

            IfCondition And(
                And(GreaterEqual(px, hx0), LessThan(px, hx1)),
                And(GreaterEqual(py, hy0), LessThan(py, hy1))
            ) ThenBlock: {
                ReturnValue(i)
            }
            i = Subtract(i, 1)
        }
        ReturnValue(-1)
    }
}



Function.Win_ToolbarHitTest {
    Input:  px: Integer
    Input:  py: Integer
    Output: Integer
    Body: {
        cnt = FloatTable.count
        i   = Subtract(cnt, 1)
        WhileLoop GreaterEqual(i, 0) {
            fx        = Win_GetX(i)
            fy        = Win_GetY(i)
            total_w   = Win_GetTotalW(i)
            toolbar_h = WinMgr_GetToolbarH(i)

            // Only test windows that have a toolbar
            IfCondition GreaterThan(toolbar_h, 0) ThenBlock: {
                // Toolbar zone: full width, between tab bar and box
                tx0 = fx
                tx1 = Add(fx, total_w)
                ty0 = Subtract(fy, toolbar_h)
                ty1 = fy

                IfCondition And(
                    And(GreaterEqual(px, tx0), LessThan(px, tx1)),
                    And(GreaterEqual(py, ty0), LessThan(py, ty1))
                ) ThenBlock: {
                    ReturnValue(i)
                }
            }
            i = Subtract(i, 1)
        }
        ReturnValue(-1)
    }
}


// =============================================================================
// WIN_STARTDRAG
// =============================================================================
Function.Win_StartDrag {
    Input:  idx:     Integer
    Input:  mouse_x: Integer
    Input:  mouse_y: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(idx, 0) ThenBlock: { ReturnValue(0) }
        fx = Win_GetX(idx)
        fy = Win_GetY(idx)
        WinMgr.drag_idx      = idx
        WinMgr.drag_offset_x = Subtract(mouse_x, fx)
        WinMgr.drag_offset_y = Subtract(mouse_y, fy)
        ReturnValue(1)
    }
}

// =============================================================================
// WIN_UPDATEDRAG
// =============================================================================
Function.Win_UpdateDrag {
    Input:  mouse_x: Integer
    Input:  mouse_y: Integer
    Output: Integer
    Body: {
        idx = WinMgr.drag_idx
        IfCondition LessThan(idx, 0) ThenBlock: { ReturnValue(0) }
        new_x   = Subtract(mouse_x, WinMgr.drag_offset_x)
        new_y   = Subtract(mouse_y, WinMgr.drag_offset_y)
        sw      = FB_GetWidth()
        sh      = FB_GetHeight()
        total_w = Win_GetTotalW(idx)
        total_h = Win_GetTotalH(idx)
        IfCondition LessThan(new_x, 0) ThenBlock: { new_x = 0 }
        IfCondition LessThan(new_y, 0) ThenBlock: { new_y = 0 }
        IfCondition GreaterThan(Add(new_x, total_w), sw) ThenBlock: {
            new_x = Subtract(sw, total_w)
        }
        IfCondition GreaterThan(Add(new_y, total_h), sh) ThenBlock: {
            new_y = Subtract(sh, total_h)
        }
        // Update both WinGeom and FloatEntry via Win_SetGeom
        Win_SetGeom(idx, new_x, new_y, total_w, total_h)
        ReturnValue(1)
    }
}

// =============================================================================
// WIN_STOPDRAG
// =============================================================================
Function.Win_StopDrag {
    Output: Integer
    Body: {
        WinMgr.drag_idx = -1
        ReturnValue(1)
    }
}

// =============================================================================
// WIN_PROBEBORDER — returns edge bitmask if (px,py) is on border of window idx
// =============================================================================
Function.Win_ProbeBorder {
    Input:  idx: Integer
    Input:  px:  Integer
    Input:  py:  Integer
    Output: Integer
    Body: {
        bw      = DecorConfig.border_w
        fx      = Win_GetX(idx)
        fy      = Win_GetY(idx)
        total_w = Win_GetTotalW(idx)
        total_h = Win_GetTotalH(idx)
        probe   = bw
        px0 = Subtract(px, probe)
        py0 = Subtract(py, probe)
        px1 = Add(px, probe)
        py1 = Add(py, probe)
        wx0 = fx
        wy0 = fy
        wx1 = Add(fx, total_w)
        wy1 = Add(fy, total_h)
        edge = 0
        IfCondition And(LessThan(px0, Add(wx0, bw)), GreaterThan(px1, wx0)) ThenBlock: {
            IfCondition And(LessThan(py0, wy1), GreaterThan(py1, wy0)) ThenBlock: {
                edge = Add(edge, ResizeEdge.LEFT)
            }
        }
        IfCondition And(LessThan(px0, wx1), GreaterThan(px1, Subtract(wx1, bw))) ThenBlock: {
            IfCondition And(LessThan(py0, wy1), GreaterThan(py1, wy0)) ThenBlock: {
                edge = Add(edge, ResizeEdge.RIGHT)
            }
        }
        IfCondition And(LessThan(py0, Add(wy0, bw)), GreaterThan(py1, wy0)) ThenBlock: {
            IfCondition And(LessThan(px0, wx1), GreaterThan(px1, wx0)) ThenBlock: {
                edge = Add(edge, ResizeEdge.TOP)
            }
        }
        IfCondition And(LessThan(py0, wy1), GreaterThan(py1, Subtract(wy1, bw))) ThenBlock: {
            IfCondition And(LessThan(px0, wx1), GreaterThan(px1, wx0)) ThenBlock: {
                edge = Add(edge, ResizeEdge.BOTTOM)
            }
        }
        ReturnValue(edge)
    }
}

// =============================================================================
// WIN_BORDERHITTEST — topmost window whose border cursor is over
// =============================================================================
Function.Win_BorderHitTest {
    Input:  px: Integer
    Input:  py: Integer
    Output: Integer
    Body: {
        cnt = FloatTable.count
        i   = Subtract(cnt, 1)
        WhileLoop GreaterEqual(i, 0) {
            edge = Win_ProbeBorder(i, px, py)
            IfCondition NotEqual(edge, 0) ThenBlock: {
                WinMgr.resize_edge = edge
                ReturnValue(i)
            }
            i = Subtract(i, 1)
        }
        WinMgr.resize_edge = 0
        ReturnValue(-1)
    }
}

