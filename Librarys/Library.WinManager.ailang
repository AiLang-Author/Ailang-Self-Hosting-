// Library.WinManager.ailang
// Each window = header surface + content surface.
// Border is drawn to FB around each surface — never on the canvas.
// Canvas is the drawable area. Border is geometry only.
//
// Window FB footprint (vertical):
//   border_w  — top outer border
//   header_h  — header canvas
//   border_w  — border between header and content
//   content_h — content canvas
//   border_w  — bottom outer border
//
// Window FB footprint (horizontal):
//   border_w + canvas_w + border_w
//
// Copyright © 2025 Sean Collins, 2 Paws Machine and Engineering. All rights reserved. SCSL.

LibraryImport.DSurfaceTypes
LibraryImport.DSurface
LibraryImport.DDrawPixel
LibraryImport.DComposeTypes
LibraryImport.DComposeFloat
LibraryImport.TextBuffer
LibraryImport.Framebuffer
LibraryImport.PaneDecorator
LibraryImport.Cursor

// =============================================================================
// WINDOW TABLE — max 8 windows
// Per entry: header_surf, content_surf, tb handle
// Stored as flat arrays indexed by float slot
// =============================================================================
FixedPool.WinMgr {
    "focused":         Initialize=0
    "count":           Initialize=0
    "hdr_data":        Initialize=0
    "content_data":    Initialize=0
    "tb_data":         Initialize=0
    "drag_idx":        Initialize=-1
    "drag_offset_x":   Initialize=0
    "drag_offset_y":   Initialize=0
    "resize_idx":      Initialize=-1
    "resize_edge":     Initialize=0
    "resize_anchor_x": Initialize=0
    "resize_anchor_y": Initialize=0
    "resize_orig_fx":  Initialize=0
    "resize_orig_fy":  Initialize=0
    "resize_orig_w":   Initialize=0
    "resize_orig_h":   Initialize=0
    "resize_new_fx":   Initialize=0
    "resize_new_fy":   Initialize=0
    "resize_new_w":    Initialize=0
    "resize_new_h":    Initialize=0
    "resize_dirty":    Initialize=0
}

FixedPool.ResizeEdge {
    "LEFT":   Initialize=1
    "RIGHT":  Initialize=2
    "TOP":    Initialize=4
    "BOTTOM": Initialize=8
}

FixedPool.WinMinSize {
    "w": Initialize=200
    "h": Initialize=200
}

Function.WinMgr_Init {
    Output: Integer
    Body: {
        WinMgr.focused      = -1
        WinMgr.count        = 0
        WinMgr.hdr_data     = Allocate(64)
        WinMgr.content_data = Allocate(64)
        WinMgr.tb_data      = Allocate(64)
        // Init all slots to -1
        i = 0
        WhileLoop LessThan(i, 8) {
            off = Multiply(i, 8)
            StoreValue(Add(WinMgr.hdr_data,     off), -1)
            StoreValue(Add(WinMgr.content_data, off), -1)
            StoreValue(Add(WinMgr.tb_data,      off), -1)
            i = Add(i, 1)
        }
        ReturnValue(1)
    }
}

Function.WinMgr_GetHdr {
    Input:  idx: Integer
    Output: Integer
    Body: { ReturnValue(Dereference(Add(WinMgr.hdr_data, Multiply(idx, 8)))) }
}
Function.WinMgr_SetHdr {
    Input: idx: Integer
    Input: val: Integer
    Body: { StoreValue(Add(WinMgr.hdr_data, Multiply(idx, 8)), val) ReturnValue(0) }
}
Function.WinMgr_GetContent {
    Input:  idx: Integer
    Output: Integer
    Body: { ReturnValue(Dereference(Add(WinMgr.content_data, Multiply(idx, 8)))) }
}
Function.WinMgr_SetContent {
    Input: idx: Integer
    Input: val: Integer
    Body: { StoreValue(Add(WinMgr.content_data, Multiply(idx, 8)), val) ReturnValue(0) }
}
Function.WinMgr_GetTB {
    Input:  idx: Integer
    Output: Integer
    Body: { ReturnValue(Dereference(Add(WinMgr.tb_data, Multiply(idx, 8)))) }
}
Function.WinMgr_SetTB {
    Input: idx: Integer
    Input: tb:  Integer
    Body: { StoreValue(Add(WinMgr.tb_data, Multiply(idx, 8)), tb) ReturnValue(0) }
}

// =============================================================================
// WIN_DRAWHEADER — fill header surface black, draw title in white
// Reusable: called from Win_Create and Win_SetTitle
// =============================================================================
Function.Win_DrawHeader {
    Input:  idx:   Integer
    Input:  title: Integer   // string pointer
    Output: Integer
    Body: {
        surf = WinMgr_GetHdr(idx)
        IfCondition LessThan(surf, 0) ThenBlock: { ReturnValue(0) }
        w = Surface_GetWidth(surf)
        h = Surface_GetHeight(surf)
        // Black fill
        Draw_Pix_FillRect(surf, 0, 0, w, h, 0x000000)
        // White title text, left aligned with 4px padding
        IfCondition EqualTo(DecorConfig.font_ready, 1) ThenBlock: {
            FontBitmap_DrawString(surf, DecorConfig.font, 4, 4, title, 0xFFFFFF)
        }
        ReturnValue(1)
    }
}
// x, y, w, h = outer rect in FB coordinates
// =============================================================================
Function.Win_DrawBorderFB {
    Input: x: Integer
    Input: y: Integer
    Input: w: Integer
    Input: h: Integer
    Body: {
        bw  = DecorConfig.border_w
        buf = FB_GetDrawBuffer()
        pit = FB.pitch
        pb  = SurfaceConst.PIXEL_BYTES
        col = WinColor.BORDER

        // BGRA little-endian — same as DPix_PutPixel
        b = BitwiseAnd(col, 255)
        g = BitwiseAnd(ShiftRight(col, 8),  255)
        r = BitwiseAnd(ShiftRight(col, 16), 255)

        // Top rows
        row = 0
        WhileLoop LessThan(row, bw) {
            px = 0
            WhileLoop LessThan(px, w) {
                off = Add(Multiply(Add(y, row), pit), Multiply(Add(x, px), pb))
                SetByte(buf, Add(off, 0), b)
                SetByte(buf, Add(off, 1), g)
                SetByte(buf, Add(off, 2), r)
                SetByte(buf, Add(off, 3), 0)
                px = Add(px, 1)
            }
            row = Add(row, 1)
        }

        // Bottom rows
        row = 0
        WhileLoop LessThan(row, bw) {
            py = Subtract(Add(y, h), Add(row, 1))
            px = 0
            WhileLoop LessThan(px, w) {
                off = Add(Multiply(py, pit), Multiply(Add(x, px), pb))
                SetByte(buf, Add(off, 0), b)
                SetByte(buf, Add(off, 1), g)
                SetByte(buf, Add(off, 2), r)
                SetByte(buf, Add(off, 3), 0)
                px = Add(px, 1)
            }
            row = Add(row, 1)
        }

        // Left cols (middle rows only — top/bottom already filled)
        row = bw
        WhileLoop LessThan(row, Subtract(h, bw)) {
            px = 0
            WhileLoop LessThan(px, bw) {
                off = Add(Multiply(Add(y, row), pit), Multiply(Add(x, px), pb))
                SetByte(buf, Add(off, 0), b)
                SetByte(buf, Add(off, 1), g)
                SetByte(buf, Add(off, 2), r)
                SetByte(buf, Add(off, 3), 0)
                px = Add(px, 1)
            }
            row = Add(row, 1)
        }

        // Right cols — starting at x + w - bw
        row = bw
        WhileLoop LessThan(row, Subtract(h, bw)) {
            px = 0
            WhileLoop LessThan(px, bw) {
                rx  = Add(Add(x, w), Subtract(px, bw))
                off = Add(Multiply(Add(y, row), pit), Multiply(rx, pb))
                SetByte(buf, Add(off, 0), b)
                SetByte(buf, Add(off, 1), g)
                SetByte(buf, Add(off, 2), r)
                SetByte(buf, Add(off, 3), 0)
                px = Add(px, 1)
            }
            row = Add(row, 1)
        }
        ReturnValue(0)
    }
}

// =============================================================================
// WIN_CREATE
// canvas_w, canvas_h = content surface dimensions
// color = content bg color, -1 = WinColor.WINDOW
// Returns float idx or -1
// =============================================================================
Function.Win_Create {
    Input:  canvas_w: Integer
    Input:  canvas_h: Integer
    Input:  color:    Integer
    Input:  title:    Integer   // string pointer
    Output: Integer
    Body: {
        cnt = FloatTable.count
        IfCondition GreaterEqual(cnt, FloatEntryConst.MAX_FLOATING) ThenBlock: {
            PrintMessage("[Win] ERROR: max windows\n")
            ReturnValue(-1)
        }

        bw       = DecorConfig.border_w
        hdr_h    = DecorConfig.header_h

        // Total FB footprint
        total_w  = Add(canvas_w, Multiply(bw, 2))
        total_h  = Add(Add(hdr_h, canvas_h), Multiply(bw, 3))

        // Center in screen
        sw = Compositor.screen_w
        sh = Compositor.screen_h
        fx = Divide(Subtract(sw, total_w), 2)
        fy = Divide(Subtract(sh, total_h), 2)

        // Header surface — black fill + white title
        hdr_surf = Surface_Create(SurfaceFormat.PIXEL_32, canvas_w, hdr_h)
        IfCondition EqualTo(hdr_surf, 0) ThenBlock: {
            PrintMessage("[Win] ERROR: header surface\n")
            ReturnValue(-1)
        }
        Draw_Pix_FillRect(hdr_surf, 0, 0, canvas_w, hdr_h, 0x000000)

        // Content surface
        bg = color
        IfCondition LessThan(color, 0) ThenBlock: { bg = WinColor.WINDOW }
        content_surf = Surface_Create(SurfaceFormat.PIXEL_32, canvas_w, canvas_h)
        IfCondition EqualTo(content_surf, 0) ThenBlock: {
            Surface_Destroy(hdr_surf)
            PrintMessage("[Win] ERROR: content surface\n")
            ReturnValue(-1)
        }
        Draw_Pix_FillRect(content_surf, 0, 0, canvas_w, canvas_h, bg)

        // Register float entry using total footprint for hit-test
        idx = Float_Add(content_surf, fx, fy, total_w, total_h)
        IfCondition LessThan(idx, 0) ThenBlock: {
            Surface_Destroy(hdr_surf)
            Surface_Destroy(content_surf)
            ReturnValue(-1)
        }

        // TextBuffer on content surface
        tb = TextBuffer_Create(content_surf, SysDisplayState.font)
        IfCondition LessThan(tb, 0) ThenBlock: {
            Float_Remove(idx)
            Surface_Destroy(hdr_surf)
            Surface_Destroy(content_surf)
            PrintMessage("[Win] ERROR: TB\n")
            ReturnValue(-1)
        }
        TextBuffer_SetColors(tb, WinColor.TEXT_FG, bg)

        WinMgr_SetHdr(idx, hdr_surf)
        WinMgr_SetContent(idx, content_surf)

        // Draw header — black bg, white title text
        Win_DrawHeader(idx, title)
        WinMgr_SetTB(idx, tb)
        WinMgr.count = Add(WinMgr.count, 1)

        PrintMessage("[Win] created idx=")
        PrintNumber(idx)
        PrintMessage(" canvas=")
        PrintNumber(canvas_w)
        PrintMessage("x")
        PrintNumber(canvas_h)
        PrintMessage("\n")

        ReturnValue(idx)
    }
}

// =============================================================================
// WIN_CLOSE
// =============================================================================
Function.Win_Close {
    Input:  idx: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(idx, 0)        ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(idx, 0)       ThenBlock: { ReturnValue(0) }
        cnt = FloatTable.count
        IfCondition GreaterEqual(idx, cnt) ThenBlock: { ReturnValue(0) }

        tb = WinMgr_GetTB(idx)
        IfCondition GreaterEqual(tb, 0) ThenBlock: { TextBuffer_Destroy(tb) }

        hdr_surf     = WinMgr_GetHdr(idx)
        content_surf = WinMgr_GetContent(idx)
        IfCondition GreaterEqual(hdr_surf, 0)     ThenBlock: { Surface_Destroy(hdr_surf) }
        IfCondition GreaterEqual(content_surf, 0) ThenBlock: { Surface_Destroy(content_surf) }

        Float_Remove(idx)

        // Shift arrays down
        i = idx
        new_cnt = Subtract(cnt, 1)
        WhileLoop LessThan(i, new_cnt) {
            WinMgr_SetHdr(i,     WinMgr_GetHdr(Add(i, 1)))
            WinMgr_SetContent(i, WinMgr_GetContent(Add(i, 1)))
            WinMgr_SetTB(i,      WinMgr_GetTB(Add(i, 1)))
            i = Add(i, 1)
        }
        WinMgr_SetHdr(new_cnt,     -1)
        WinMgr_SetContent(new_cnt, -1)
        WinMgr_SetTB(new_cnt,      -1)
        WinMgr.count = Subtract(WinMgr.count, 1)

        new_focus = Subtract(idx, 1)
        IfCondition LessThan(new_focus, 0) ThenBlock: { new_focus = 0 }
        WinMgr.focused = new_focus
        ReturnValue(1)
    }
}

// =============================================================================
// WIN_FOCUS
// =============================================================================
Function.Win_Focus {
    Input:  idx: Integer
    Output: Integer
    Body: { WinMgr.focused = idx ReturnValue(1) }
}

// =============================================================================
// WIN_HEADERHITTEST — is point (px, py) inside the header strip of window idx?
// Header occupies: (fx+bw, fy+bw) to (fx+bw+canvas_w, fy+bw+header_h)
// =============================================================================
Function.Win_HeaderHitTest {
    Input:  px: Integer
    Input:  py: Integer
    Output: Integer   // float idx or -1
    Body: {
        bw  = DecorConfig.border_w
        hh  = DecorConfig.header_h
        cnt = FloatTable.count
        // Scan top to bottom — topmost window wins
        i = Subtract(cnt, 1)
        WhileLoop GreaterEqual(i, 0) {
            ptr     = Float_EntryPtr(i)
            fx      = Dereference(Add(ptr, FloatEntryFields.X))
            fy      = Dereference(Add(ptr, FloatEntryFields.Y))
            total_w = Dereference(Add(ptr, FloatEntryFields.W))
            // Header region: x in [fx+bw .. fx+total_w-bw], y in [fy+bw .. fy+bw+hh]
            hx0 = Add(fx, bw)
            hx1 = Subtract(Add(fx, total_w), bw)
            hy0 = Add(fy, bw)
            hy1 = Add(hy0, hh)
            IfCondition And(
                And(GreaterEqual(px, hx0), LessThan(px, hx1)),
                And(GreaterEqual(py, hy0), LessThan(py, hy1))
            ) ThenBlock: {
                ReturnValue(i)
            }
            i = Subtract(i, 1)
        }
        ReturnValue(-1)
    }
}

// =============================================================================
// WIN_STARTDRAG — called on mouse down in header
// =============================================================================
Function.Win_StartDrag {
    Input:  idx:     Integer
    Input:  mouse_x: Integer
    Input:  mouse_y: Integer
    Output: Integer
    Body: {
        ptr = Float_EntryPtr(idx)
        fx  = Dereference(Add(ptr, FloatEntryFields.X))
        fy  = Dereference(Add(ptr, FloatEntryFields.Y))
        WinMgr.drag_idx      = idx
        WinMgr.drag_offset_x = Subtract(mouse_x, fx)
        WinMgr.drag_offset_y = Subtract(mouse_y, fy)
        ReturnValue(1)
    }
}

// =============================================================================
// WIN_UPDATEDRAG — called on mouse move while dragging
// =============================================================================
Function.Win_UpdateDrag {
    Input:  mouse_x: Integer
    Input:  mouse_y: Integer
    Output: Integer
    Body: {
        idx = WinMgr.drag_idx
        IfCondition LessThan(idx, 0) ThenBlock: { ReturnValue(0) }
        Win_DebugPrint("DRAG UPDATE")
        new_x = Subtract(mouse_x, WinMgr.drag_offset_x)
        new_y = Subtract(mouse_y, WinMgr.drag_offset_y)
        // Clamp to screen — keep window fully on screen
        sw = Compositor.screen_w
        sh = Compositor.screen_h
        ptr     = Float_EntryPtr(idx)
        total_w = Dereference(Add(ptr, FloatEntryFields.W))
        total_h = Dereference(Add(ptr, FloatEntryFields.H))
        IfCondition LessThan(new_x, 0) ThenBlock: { new_x = 0 }
        IfCondition LessThan(new_y, 0) ThenBlock: { new_y = 0 }
        IfCondition GreaterThan(Add(new_x, total_w), sw) ThenBlock: {
            new_x = Subtract(sw, total_w)
        }
        IfCondition GreaterThan(Add(new_y, total_h), sh) ThenBlock: {
            new_y = Subtract(sh, total_h)
        }
        Float_Move(idx, new_x, new_y)
        ReturnValue(1)
    }
}

// =============================================================================
// WIN_STOPDRAG — called on mouse up
// =============================================================================
Function.Win_StopDrag {
    Output: Integer
    Body: {
        WinMgr.drag_idx = -1
        ReturnValue(1)
    }
}

// =============================================================================
// WIN_DEBUGPRINT — write debug string to desktop TB (index 0)
// =============================================================================
Function.Win_DebugPrint {
    Input:  msg: Integer
    Output: Integer
    Body: {
        tb = WinMgr_GetTB(0)
        IfCondition LessThan(tb, 0) ThenBlock: { ReturnValue(0) }
        TextBuffer_PutString(tb, msg)
        TextBuffer_PutChar(tb, 10)
        ReturnValue(1)
    }
}

Function.Win_DebugNum {
    Input:  msg: Integer
    Input:  val: Integer
    Output: Integer
    Body: {
        tb = WinMgr_GetTB(0)
        IfCondition LessThan(tb, 0) ThenBlock: { ReturnValue(0) }
        TextBuffer_PutString(tb, msg)
        TextBuffer_PutString(tb, NumberToString(val))
        TextBuffer_PutChar(tb, 10)
        ReturnValue(1)
    }
}

// =============================================================================
// WIN_PROBEBORDER — test 5x5 probe box at (px,py) against window idx borders
// Returns edge bitmask (ResizeEdge) or 0 if no hit
// =============================================================================
Function.Win_ProbeBorder {
    Input:  idx: Integer
    Input:  px:  Integer
    Input:  py:  Integer
    Output: Integer
    Body: {
        ptr     = Float_EntryPtr(idx)
        fx      = Dereference(Add(ptr, FloatEntryFields.X))
        fy      = Dereference(Add(ptr, FloatEntryFields.Y))
        total_w = Dereference(Add(ptr, FloatEntryFields.W))
        total_h = Dereference(Add(ptr, FloatEntryFields.H))
        bw      = DecorConfig.border_w

        // Probe box: 5x5 centered on cursor
        probe = 2
        px0 = Subtract(px, probe)
        py0 = Subtract(py, probe)
        px1 = Add(px, probe)
        py1 = Add(py, probe)

        // Window outer rect
        wx0 = fx
        wy0 = fy
        wx1 = Add(fx, total_w)
        wy1 = Add(fy, total_h)

        // Border band rects (outer bw pixels on each edge)
        edge = 0

        // Left border: x in [wx0 .. wx0+bw]
        IfCondition And(LessThan(px0, Add(wx0, bw)), GreaterThan(px1, wx0)) ThenBlock: {
            IfCondition And(LessThan(py0, wy1), GreaterThan(py1, wy0)) ThenBlock: {
                edge = Add(edge, ResizeEdge.LEFT)
            }
        }
        // Right border: x in [wx1-bw .. wx1]
        IfCondition And(LessThan(px0, wx1), GreaterThan(px1, Subtract(wx1, bw))) ThenBlock: {
            IfCondition And(LessThan(py0, wy1), GreaterThan(py1, wy0)) ThenBlock: {
                edge = Add(edge, ResizeEdge.RIGHT)
            }
        }
        // Top border: y in [wy0 .. wy0+bw]
        IfCondition And(LessThan(py0, Add(wy0, bw)), GreaterThan(py1, wy0)) ThenBlock: {
            IfCondition And(LessThan(px0, wx1), GreaterThan(px1, wx0)) ThenBlock: {
                edge = Add(edge, ResizeEdge.TOP)
            }
        }
        // Bottom border: y in [wy1-bw .. wy1]
        IfCondition And(LessThan(py0, wy1), GreaterThan(py1, Subtract(wy1, bw))) ThenBlock: {
            IfCondition And(LessThan(px0, wx1), GreaterThan(px1, wx0)) ThenBlock: {
                edge = Add(edge, ResizeEdge.BOTTOM)
            }
        }
        ReturnValue(edge)
    }
}

// =============================================================================
// WIN_BORDERHITTEST — find topmost window whose border the cursor is over
// Returns idx or -1. Sets WinMgr.resize_edge.
// =============================================================================
Function.Win_BorderHitTest {
    Input:  px: Integer
    Input:  py: Integer
    Output: Integer
    Body: {
        cnt = FloatTable.count
        i   = Subtract(cnt, 1)
        WhileLoop GreaterEqual(i, 0) {
            edge = Win_ProbeBorder(i, px, py)
            IfCondition NotEqual(edge, 0) ThenBlock: {
                WinMgr.resize_edge = edge
                ReturnValue(i)
            }
            i = Subtract(i, 1)
        }
        WinMgr.resize_edge = 0
        ReturnValue(-1)
    }
}

// =============================================================================
// WIN_STARTRESIZE
// =============================================================================
Function.Win_StartResize {
    Input:  idx:     Integer
    Input:  mouse_x: Integer
    Input:  mouse_y: Integer
    Output: Integer
    Body: {
        ptr     = Float_EntryPtr(idx)
        WinMgr.resize_idx      = idx
        WinMgr.resize_anchor_x = mouse_x
        WinMgr.resize_anchor_y = mouse_y
        // Re-probe edge at exact click position — dont rely on stale mouse_move value
        probe = Win_ProbeBorder(idx, mouse_x, mouse_y)
        WinMgr.resize_edge = probe
        Win_DebugNum("probe@click=", probe)
        Win_DebugNum("mouse_x=", mouse_x)
        Win_DebugNum("mouse_y=", mouse_y)
        WinMgr.resize_orig_fx  = Dereference(Add(ptr, FloatEntryFields.X))
        WinMgr.resize_orig_fy  = Dereference(Add(ptr, FloatEntryFields.Y))
        WinMgr.resize_orig_w   = Dereference(Add(ptr, FloatEntryFields.W))
        WinMgr.resize_orig_h   = Dereference(Add(ptr, FloatEntryFields.H))
        WinMgr.resize_new_fx   = WinMgr.resize_orig_fx
        WinMgr.resize_new_fy   = WinMgr.resize_orig_fy
        WinMgr.resize_new_w    = WinMgr.resize_orig_w
        WinMgr.resize_new_h    = WinMgr.resize_orig_h
        Win_DebugPrint("RESIZE START")
        Win_DebugNum("idx=", idx)
        Win_DebugNum("edge=", WinMgr.resize_edge)
        Win_DebugNum("origW=", WinMgr.resize_orig_w)
        Win_DebugNum("origH=", WinMgr.resize_orig_h)
        Win_DebugNum("newW=", WinMgr.resize_new_w)
        Win_DebugNum("newH=", WinMgr.resize_new_h)
        ReturnValue(1)
    }
}

// =============================================================================
// WIN_UPDATERESIZE — called on mouse move while resize active
// Computes new geometry, clamps to min size, updates float entry
// Does NOT recreate surfaces — that happens on mouse up
// =============================================================================
Function.Win_UpdateResize {
    Input:  mouse_x: Integer
    Input:  mouse_y: Integer
    Output: Integer
    Body: {
        idx = WinMgr.resize_idx
        IfCondition LessThan(idx, 0) ThenBlock: { ReturnValue(0) }
        Win_DebugPrint("RESIZE UPDATE")

        edge   = WinMgr.resize_edge
        bw     = DecorConfig.border_w
        hh     = DecorConfig.header_h
        dx     = Subtract(mouse_x, WinMgr.resize_anchor_x)
        dy     = Subtract(mouse_y, WinMgr.resize_anchor_y)
        orig_fx = WinMgr.resize_orig_fx
        orig_fy = WinMgr.resize_orig_fy
        orig_w  = WinMgr.resize_orig_w
        orig_h  = WinMgr.resize_orig_h

        // Min total size = min canvas + borders
        min_w = Add(WinMinSize.w, Multiply(bw, 2))
        min_h = Add(Add(WinMinSize.h, hh), Multiply(bw, 3))

        new_fx = orig_fx
        new_fy = orig_fy
        new_w  = orig_w
        new_h  = orig_h

        // Right edge — grow/shrink right side
        IfCondition NotEqual(BitwiseAnd(edge, ResizeEdge.RIGHT), 0) ThenBlock: {
            new_w = Add(orig_w, dx)
            IfCondition LessThan(new_w, min_w) ThenBlock: { new_w = min_w }
        }
        // Left edge — move origin + shrink/grow
        IfCondition NotEqual(BitwiseAnd(edge, ResizeEdge.LEFT), 0) ThenBlock: {
            new_w = Subtract(orig_w, dx)
            IfCondition LessThan(new_w, min_w) ThenBlock: {
                new_w = min_w
                new_fx = Subtract(Add(orig_fx, orig_w), min_w)
            } ElseBlock: {
                new_fx = Add(orig_fx, dx)
            }
        }
        // Bottom edge
        IfCondition NotEqual(BitwiseAnd(edge, ResizeEdge.BOTTOM), 0) ThenBlock: {
            new_h = Add(orig_h, dy)
            IfCondition LessThan(new_h, min_h) ThenBlock: { new_h = min_h }
        }
        // Top edge
        IfCondition NotEqual(BitwiseAnd(edge, ResizeEdge.TOP), 0) ThenBlock: {
            new_h = Subtract(orig_h, dy)
            IfCondition LessThan(new_h, min_h) ThenBlock: {
                new_h = min_h
                new_fy = Subtract(Add(orig_fy, orig_h), min_h)
            } ElseBlock: {
                new_fy = Add(orig_fy, dy)
            }
        }

        // Clamp to screen
        sw = Compositor.screen_w
        sh = Compositor.screen_h
        IfCondition LessThan(new_fx, 0) ThenBlock: { new_fx = 0 }
        IfCondition LessThan(new_fy, 0) ThenBlock: { new_fy = 0 }
        IfCondition GreaterThan(Add(new_fx, new_w), sw) ThenBlock: {
            new_w = Subtract(sw, new_fx)
        }
        IfCondition GreaterThan(Add(new_fy, new_h), sh) ThenBlock: {
            new_h = Subtract(sh, new_fy)
        }

        WinMgr.resize_new_fx = new_fx
        WinMgr.resize_new_fy = new_fy
        WinMgr.resize_new_w  = new_w
        WinMgr.resize_new_h  = new_h
        WinMgr.resize_dirty    = 1
        WinMgr.resize_anchor_x = mouse_x
        WinMgr.resize_anchor_y = mouse_y
        WinMgr.resize_orig_fx  = new_fx
        WinMgr.resize_orig_fy  = new_fy
        WinMgr.resize_orig_w   = new_w
        WinMgr.resize_orig_h   = new_h
        ReturnValue(1)
    }
}

// =============================================================================
// WIN_APPLYRESIZE — called on mouse up, recreates surfaces at new size
// =============================================================================
Function.Win_ApplyResize {
    Output: Integer
    Body: {
        idx = WinMgr.resize_idx
        IfCondition LessThan(idx, 0)   ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(idx, 0)    ThenBlock: { WinMgr.resize_idx = -1 ReturnValue(0) }

        bw  = DecorConfig.border_w
        hh  = DecorConfig.header_h
        ptr    = Float_EntryPtr(idx)
        new_fx = WinMgr.resize_new_fx
        new_fy = WinMgr.resize_new_fy
        new_w  = WinMgr.resize_new_w
        new_h  = WinMgr.resize_new_h
        Win_DebugNum("APPLY new_w=", new_w)
        Win_DebugNum("APPLY new_h=", new_h)
        StoreValue(Add(ptr, FloatEntryFields.X), new_fx)
        StoreValue(Add(ptr, FloatEntryFields.Y), new_fy)
        StoreValue(Add(ptr, FloatEntryFields.W), new_w)
        StoreValue(Add(ptr, FloatEntryFields.H), new_h)
        total_w  = new_w
        total_h  = new_h
        canvas_w = Subtract(total_w, Multiply(bw, 2))
        canvas_h = Subtract(total_h, Add(hh, Multiply(bw, 3)))
        canvas_h = Subtract(total_h, Add(hh, Multiply(bw, 3)))

        // Destroy old surfaces and TB
        old_tb      = WinMgr_GetTB(idx)
        old_hdr     = WinMgr_GetHdr(idx)
        old_content = WinMgr_GetContent(idx)

        // Get old bg color from old TB before destroying
        bg = WinColor.WINDOW
        IfCondition GreaterEqual(old_tb, 0) ThenBlock: {
            bg = TB_Get(old_tb, TBField.BG)
            TextBuffer_Destroy(old_tb)
        }

        // Create new surfaces at new canvas size
        new_hdr = Surface_Create(SurfaceFormat.PIXEL_32, canvas_w, hh)
        IfCondition EqualTo(new_hdr, 0) ThenBlock: {
            PrintMessage("[Win] ERROR: resize hdr\n")
            WinMgr.resize_idx = -1
            ReturnValue(0)
        }

        new_content = Surface_Create(SurfaceFormat.PIXEL_32, canvas_w, canvas_h)
        IfCondition EqualTo(new_content, 0) ThenBlock: {
            Surface_Destroy(new_hdr)
            PrintMessage("[Win] ERROR: resize content\n")
            WinMgr.resize_idx = -1
            ReturnValue(0)
        }
        Draw_Pix_FillRect(new_content, 0, 0, canvas_w, canvas_h, bg)

        // Swap new surfaces in BEFORE destroying old ones
        // so any blit that runs sees valid pointers
        WinMgr_SetHdr(idx, new_hdr)
        WinMgr_SetContent(idx, new_content)
        StoreValue(Add(ptr, FloatEntryFields.SURFACE), new_content)

        // Now safe to destroy old surfaces
        IfCondition GreaterEqual(old_hdr, 0)     ThenBlock: { Surface_Destroy(old_hdr) }
        IfCondition GreaterEqual(old_content, 0) ThenBlock: { Surface_Destroy(old_content) }

        // Redraw header and create new TB
        Win_DrawHeader(idx, "Application")
        new_tb = TextBuffer_Create(new_content, SysDisplayState.font)
        IfCondition GreaterEqual(new_tb, 0) ThenBlock: {
            TextBuffer_SetColors(new_tb, WinColor.TEXT_FG, bg)
        }
        WinMgr_SetTB(idx, new_tb)
        PrintMessage("[Resize] new_tb handle=")
        PrintNumber(new_tb)
        PrintMessage("\n")

        WinMgr.resize_idx = -1
        Win_DebugPrint("APPLY DONE")
        Win_DebugNum("canvasW=", canvas_w)
        Win_DebugNum("canvasH=", canvas_h)
        PrintMessage("[Win] resized idx=")
        PrintNumber(idx)
        PrintMessage(" ")
        PrintNumber(canvas_w)
        PrintMessage("x")
        PrintNumber(canvas_h)
        PrintMessage("\n")
        ReturnValue(1)
    }
}

// =============================================================================
// WIN_KEYDOWN
// =============================================================================
Function.Win_KeyDown {
    Input:  keycode: Integer
    Input:  shift:   Integer
    Output: Integer
    Body: {
        idx = WinMgr.focused
        IfCondition LessThan(idx, 0) ThenBlock: { ReturnValue(0) }
        tb = WinMgr_GetTB(idx)
        IfCondition LessThan(tb, 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(TextBuffer_KeyDown(tb, keycode, shift))
    }
}

// =============================================================================
// WIN_HITTEST
// =============================================================================
Function.Win_HitTest {
    Input:  x: Integer
    Input:  y: Integer
    Output: Integer
    Body: { ReturnValue(Float_HitTest(x, y)) }
}

// =============================================================================
// WIN_RENDERDIRTY — render dirty TBs
// =============================================================================
Function.Win_RenderDirty {
    Output: Integer
    Body: {
        cnt = FloatTable.count
        any = 0
        i   = 0
        WhileLoop LessThan(i, cnt) {
            tb = WinMgr_GetTB(i)
            IfCondition GreaterEqual(tb, 0) ThenBlock: {
                IfCondition EqualTo(TextBuffer_IsDirty(tb), 1) ThenBlock: {
                    TextBuffer_Render(tb)
                    any = 1
                }
            }
            i = Add(i, 1)
        }
        ReturnValue(any)
    }
}

// =============================================================================
// WIN_BLITCLAMPED — blit surface but only draw clip_w x clip_h pixels
// Used during resize to keep canvas inside new border geometry
// =============================================================================
Function.Win_BlitClamped {
    Input: surf:   Integer
    Input: dst_x:  Integer
    Input: dst_y:  Integer
    Input: clip_w: Integer
    Input: clip_h: Integer
    Output: Integer
    Body: {
        sw        = Surface_GetWidth(surf)
        sh        = Surface_GetHeight(surf)
        src_data  = Surface_GetData(surf)
        src_pitch = Surface_GetPitch(surf)
        dst_buf   = FB_GetDrawBuffer()
        dst_pitch = FB.pitch
        pb        = SurfaceConst.PIXEL_BYTES
        // Use smaller of surface size vs clip size
        draw_w = sw
        draw_h = sh
        IfCondition LessThan(clip_w, sw) ThenBlock: { draw_w = clip_w }
        IfCondition LessThan(clip_h, sh) ThenBlock: { draw_h = clip_h }
        row_bytes = Multiply(draw_w, pb)
        dst_x_off = Multiply(dst_x, pb)
        y = 0
        WhileLoop LessThan(y, draw_h) {
            src_row = Add(src_data, Multiply(y, src_pitch))
            dst_row = Add(Add(dst_buf, Multiply(Add(y, dst_y), dst_pitch)), dst_x_off)
            i = 0
            WhileLoop LessThan(i, row_bytes) {
                SetByte(dst_row, i, GetByte(src_row, i))
                i = Add(i, 1)
            }
            y = Add(y, 1)
        }
        ReturnValue(1)
    }
}

// =============================================================================
// WIN_BLITALL — blit header + content for each window, borders to FB
// =============================================================================
Function.Win_BlitAll {
    Output: Integer
    Body: {
        cnt  = FloatTable.count
        bw   = DecorConfig.border_w
        hh   = DecorConfig.header_h
        i    = 0
        WhileLoop LessThan(i, cnt) {
            ptr      = Float_EntryPtr(i)
            total_w  = Dereference(Add(ptr, FloatEntryFields.W))
            total_h  = Dereference(Add(ptr, FloatEntryFields.H))
            fx       = Dereference(Add(ptr, FloatEntryFields.X))
            fy       = Dereference(Add(ptr, FloatEntryFields.Y))
            canvas_w = Subtract(total_w, Multiply(bw, 2))

            hdr_surf     = WinMgr_GetHdr(i)
            content_surf = WinMgr_GetContent(i)

            // Blit header at (fx+bw, fy+bw)
            IfCondition GreaterEqual(hdr_surf, 0) ThenBlock: {
                Win_BlitOne(hdr_surf, Add(fx, bw), Add(fy, bw))
            }

            // Blit content at (fx+bw, fy+bw+hh+bw)
            IfCondition GreaterEqual(content_surf, 0) ThenBlock: {
                content_y = Add(Add(fy, bw), Add(hh, bw))
                Win_BlitOne(content_surf, Add(fx, bw), content_y)
            }

            // Draw outer border around entire window footprint
            Win_DrawBorderFB(fx, fy, total_w, total_h)

            // Draw horizontal separator between header and content
            // Position: fy + bw (top border) + hh (header height)
            sep_y = Add(Add(fy, bw), hh)
            sep_row = 0
            sep_buf = FB_GetDrawBuffer()
            sep_pit = FB.pitch
            sep_pb  = SurfaceConst.PIXEL_BYTES
            sep_col = WinColor.BORDER
            sep_b = BitwiseAnd(sep_col, 255)
            sep_g = BitwiseAnd(ShiftRight(sep_col, 8),  255)
            sep_r = BitwiseAnd(ShiftRight(sep_col, 16), 255)
            WhileLoop LessThan(sep_row, bw) {
                sep_px = 0
                WhileLoop LessThan(sep_px, total_w) {
                    sep_off = Add(Multiply(Add(sep_y, sep_row), sep_pit), Multiply(Add(fx, sep_px), sep_pb))
                    SetByte(sep_buf, Add(sep_off, 0), sep_b)
                    SetByte(sep_buf, Add(sep_off, 1), sep_g)
                    SetByte(sep_buf, Add(sep_off, 2), sep_r)
                    SetByte(sep_buf, Add(sep_off, 3), 0)
                    sep_px = Add(sep_px, 1)
                }
                sep_row = Add(sep_row, 1)
            }

            i = Add(i, 1)
        }
        Cursor_Draw()
        FB_FlipFast()
        ReturnValue(0)
    }
}

Function.Win_BlitOne {
    Input: surf:  Integer
    Input: dst_x: Integer
    Input: dst_y: Integer
    Output: Integer
    Body: {
        sw        = Surface_GetWidth(surf)
        sh        = Surface_GetHeight(surf)
        src_data  = Surface_GetData(surf)
        src_pitch = Surface_GetPitch(surf)
        dst_buf   = FB_GetDrawBuffer()
        dst_pitch = FB.pitch
        row_bytes = Multiply(sw, SurfaceConst.PIXEL_BYTES)
        dst_x_off = Multiply(dst_x, SurfaceConst.PIXEL_BYTES)
        y = 0
        WhileLoop LessThan(y, sh) {
            src_row = Add(src_data, Multiply(y, src_pitch))
            dst_row = Add(Add(dst_buf, Multiply(Add(y, dst_y), dst_pitch)), dst_x_off)
            i = 0
            WhileLoop LessThan(i, row_bytes) {
                SetByte(dst_row, i, GetByte(src_row, i))
                i = Add(i, 1)
            }
            y = Add(y, 1)
        }
        ReturnValue(1)
    }
}