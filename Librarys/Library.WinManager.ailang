// Library.WinManager.ailang
// Floating window management for SysDisplay.
// Windows live in the Float layer. BSP is geometry-only, never split here.
// Each window: surface + TextBuffer + float entry. Focus follows click.
//
// Copyright © 2025 Sean Collins, 2 Paws Machine and Engineering. All rights reserved. SCSL.

LibraryImport.DSurfaceTypes
LibraryImport.DSurface
LibraryImport.DDrawPixel
LibraryImport.DComposeTypes
LibraryImport.DComposeFloat
LibraryImport.FontBitmap
LibraryImport.TextBuffer
LibraryImport.PaneDecorator

// =============================================================================
// WINDOW TABLE — parallel to FloatTable
// Stores TB handle and color per float index
// Max 8 — matches FloatEntryConst.MAX_FLOATING
// =============================================================================
FixedPool.WinMgr {
    "tb0":    Initialize=0
    "tb1":    Initialize=0
    "tb2":    Initialize=0
    "tb3":    Initialize=0
    "tb4":    Initialize=0
    "tb5":    Initialize=0
    "tb6":    Initialize=0
    "tb7":    Initialize=0
    "col0":   Initialize=0
    "col1":   Initialize=0
    "col2":   Initialize=0
    "col3":   Initialize=0
    "col4":   Initialize=0
    "col5":   Initialize=0
    "col6":   Initialize=0
    "col7":   Initialize=0
    "focused": Initialize=0   // index of focused window (-1 = none)
    "count":   Initialize=0
    "tb_data": Initialize=0   // ptr to flat tb array for Focus
}

Function.WinMgr_Init {
    Output: Integer
    Body: {
        WinMgr.focused = -1
        WinMgr.count   = 0
        // Allocate flat TB array for Focus_Init (16 slots * 8 bytes)
        WinMgr.tb_data = Allocate(128)
        i = 0
        WhileLoop LessThan(i, 128) {
            SetByte(WinMgr.tb_data, i, 0)
            i = Add(i, 1)
        }
        ReturnValue(1)
    }
}

// Internal: get/set TB for a float slot
Function.WinMgr_GetTB {
    Input:  idx: Integer
    Output: Integer
    Body: {
        base = Add(WinMgr.tb_data, Multiply(idx, 8))
        ReturnValue(Dereference(base))
    }
}

Function.WinMgr_SetTB {
    Input: idx: Integer
    Input: tb:  Integer
    Body: {
        base = Add(WinMgr.tb_data, Multiply(idx, 8))
        StoreValue(base, tb)
        ReturnValue(0)
    }
}

// =============================================================================
// WIN_CREATE — create a floating window
// Returns float index or -1
// =============================================================================
Function.Win_Create {
    Input:  w:     Integer
    Input:  h:     Integer
    Input:  color: Integer   // -1 = auto
    Output: Integer
    Body: {
        cnt = FloatTable.count
        IfCondition GreaterEqual(cnt, FloatEntryConst.MAX_FLOATING) ThenBlock: {
            PrintMessage("[Win] ERROR: max windows reached\n")
            ReturnValue(-1)
        }

        // Center on screen
        sw = Compositor.screen_w
        sh = Compositor.screen_h
        x  = Divide(Subtract(sw, w), 2)
        y  = Divide(Subtract(sh, h), 2)

        // Create surface
        surf = Surface_Create(SurfaceFormat.PIXEL_32, w, h)
        IfCondition EqualTo(surf, 0) ThenBlock: {
            PrintMessage("[Win] ERROR: surface failed\n")
            ReturnValue(-1)
        }

        // Assign color
        bg = color
        IfCondition LessThan(color, 0) ThenBlock: {
            bg = PaneDecorator_NextColor()
        }

        // Fill + border
        Draw_Pix_FillRect(surf, 0, 0, w, h, bg)
        bw = Subtract(w, 1)
        bh = Subtract(h, 1)
        Draw_Pix_HLine(surf, 0, bw, 0,  DecorConfig.border_color_normal)
        Draw_Pix_HLine(surf, 0, bw, bh, DecorConfig.border_color_normal)
        Draw_Pix_VLine(surf, 0,  0, bh, DecorConfig.border_color_normal)
        Draw_Pix_VLine(surf, bw, 0, bh, DecorConfig.border_color_normal)

        // Register in float layer
        idx = Float_Add(surf, x, y, w, h)
        IfCondition LessThan(idx, 0) ThenBlock: {
            Surface_Destroy(surf)
            ReturnValue(-1)
        }

        // Create TextBuffer
        tb = TextBuffer_Create(surf, SysDisplayState.font)
        IfCondition LessThan(tb, 0) ThenBlock: {
            Float_Remove(idx)
            Surface_Destroy(surf)
            PrintMessage("[Win] ERROR: TB failed\n")
            ReturnValue(-1)
        }
        TextBuffer_SetColors(tb, 0xFFFFFF, bg)

        WinMgr_SetTB(idx, tb)
        WinMgr.count = Add(WinMgr.count, 1)

        PrintMessage("[Win] created idx=")
        PrintNumber(idx)
        PrintMessage(" ")
        PrintNumber(w)
        PrintMessage("x")
        PrintNumber(h)
        PrintMessage("\n")

        ReturnValue(idx)
    }
}

// =============================================================================
// WIN_FOCUS — set focused window, update borders
// =============================================================================
Function.Win_Focus {
    Input:  idx: Integer
    Output: Integer
    Body: {
        WinMgr.focused = idx
        ReturnValue(1)
    }
}

// =============================================================================
// WIN_KEYROUNTE — send keydown to focused window's TB
// =============================================================================
Function.Win_KeyDown {
    Input:  keycode: Integer
    Input:  shift:   Integer
    Output: Integer
    Body: {
        idx = WinMgr.focused
        IfCondition LessThan(idx, 0) ThenBlock: { ReturnValue(0) }
        tb = WinMgr_GetTB(idx)
        IfCondition LessThan(tb, 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(TextBuffer_KeyDown(tb, keycode, shift))
    }
}

// =============================================================================
// WIN_HITTEST — find which window was clicked
// Returns float idx or -1
// =============================================================================
Function.Win_HitTest {
    Input:  x: Integer
    Input:  y: Integer
    Output: Integer
    Body: {
        ReturnValue(Float_HitTest(x, y))
    }
}

// =============================================================================
// WIN_RENDER — render all dirty TBs
// Returns 1 if any were dirty
// =============================================================================
Function.Win_RenderDirty {
    Output: Integer
    Body: {
        cnt = FloatTable.count
        any = 0
        i   = 0
        WhileLoop LessThan(i, cnt) {
            tb = WinMgr_GetTB(i)
            IfCondition GreaterEqual(tb, 0) ThenBlock: {
                IfCondition EqualTo(TextBuffer_IsDirty(tb), 1) ThenBlock: {
                    TextBuffer_Render(tb)
                    any = 1
                }
            }
            i = Add(i, 1)
        }
        ReturnValue(any)
    }
}

// =============================================================================
// WIN_BLIT — blit all float surfaces to framebuffer
// =============================================================================
Function.Win_BlitAll {
    Output: Integer
    Body: {
        cnt = FloatTable.count
        i   = 0
        WhileLoop LessThan(i, cnt) {
            ptr  = Float_EntryPtr(i)
            surf = Dereference(Add(ptr, FloatEntryFields.SURFACE))
            fx   = Dereference(Add(ptr, FloatEntryFields.X))
            fy   = Dereference(Add(ptr, FloatEntryFields.Y))
            IfCondition NotEqual(surf, 0) ThenBlock: {
                Win_BlitOne(surf, fx, fy)
            }
            i = Add(i, 1)
        }
        Cursor_Draw()
        FB_FlipFast()
        ReturnValue(0)
    }
}

Function.Win_BlitOne {
    Input: surf:  Integer
    Input: dst_x: Integer
    Input: dst_y: Integer
    Output: Integer
    Body: {
        sw        = Surface_GetWidth(surf)
        sh        = Surface_GetHeight(surf)
        src_data  = Surface_GetData(surf)
        src_pitch = Surface_GetPitch(surf)
        dst_buf   = FB_GetDrawBuffer()
        dst_pitch = FB.pitch
        row_bytes = Multiply(sw, SurfaceConst.PIXEL_BYTES)
        dst_x_off = Multiply(dst_x, SurfaceConst.PIXEL_BYTES)
        y = 0
        WhileLoop LessThan(y, sh) {
            src_row = Add(src_data, Multiply(y, src_pitch))
            dst_row = Add(Add(dst_buf, Multiply(Add(y, dst_y), dst_pitch)), dst_x_off)
            i = 0
            WhileLoop LessThan(i, row_bytes) {
                SetByte(dst_row, i, GetByte(src_row, i))
                i = Add(i, 1)
            }
            y = Add(y, 1)
        }
        ReturnValue(1)
    }
}