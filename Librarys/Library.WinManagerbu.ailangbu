// =============================================================================
// WINGEOM — per-window authoritative geometry table
//
// One entry per window slot (max 8). Written ONLY by Win_SetGeom.
// Every other function reads from here. No other code computes canvas_w/h.
//
// Fields per entry (8 bytes each, 48 bytes per slot):
//   total_w   — full FB footprint width
//   total_h   — full FB footprint height
//   canvas_w  — total_w - (bw*2)           derived at assignment, stored
//   canvas_h  — total_h - hh - (bw*3)      derived at assignment, stored
//   x         — FB origin x
//   y         — FB origin y
// =============================================================================

// Library.WinManager.ailang
// Copyright © 2025 Sean Collins, 2 Paws Machine and Engineering. All rights reserved. SCSL.

LibraryImport.DSurfaceTypes
LibraryImport.DSurface
LibraryImport.DDrawPixel
LibraryImport.DComposeTypes
LibraryImport.DComposeFloat
LibraryImport.TextBuffer
LibraryImport.Framebuffer
LibraryImport.PaneDecorator
LibraryImport.Cursor


// =============================================================================
// WINMGR_INIT — add WinGeom_Init() call
// =============================================================================
Function.WinMgr_Init {
    Output: Integer
    Body: {
        WinMgr.focused      = -1
        WinMgr.count        = 0
        WinMgr.hdr_data     = Allocate(64)
        WinMgr.content_data = Allocate(64)
        WinMgr.tb_data      = Allocate(64)
        i = 0
        WhileLoop LessThan(i, 8) {
            off = Multiply(i, 8)
            StoreValue(Add(WinMgr.hdr_data,     off), -1)
            StoreValue(Add(WinMgr.content_data, off), -1)
            StoreValue(Add(WinMgr.tb_data,      off), -1)
            i = Add(i, 1)
        }
        // Init WinGeom table inline — SubRoutine call from Function breaks compiler
        geom_size = Multiply(WinGeomConst.MAX, WinGeomConst.ENTRY_SIZE)
        geom_buf  = Allocate(geom_size)
        gi = 0
        WhileLoop LessThan(gi, geom_size) {
            SetByte(geom_buf, gi, 0)
            gi = Add(gi, 1)
        }
        WinGeomTable.data = geom_buf

// Stack table (8 slots × 48 bytes)
        stack_size = Multiply(StackConst.MAX, StackConst.ENTRY_SIZE)
        stack_buf  = Allocate(stack_size)
        si = 0
        WhileLoop LessThan(si, stack_size) {
            SetByte(stack_buf, si, 0)
            si = Add(si, 1)
        }
        StackTable.data  = stack_buf
        StackTable.count = 0

        // Per-window stack mapping (8 slots × 8 bytes, init to -1)
        map_buf = Allocate(64)
        mi = 0
        WhileLoop LessThan(mi, 8) {
            StoreValue(Add(map_buf, Multiply(mi, 8)), -1)
            mi = Add(mi, 1)
        }
        WinStackMap.data = map_buf

        PrintMessage("[WinMgr] stacks initialized\n")


        ReturnValue(1)
    }
}


