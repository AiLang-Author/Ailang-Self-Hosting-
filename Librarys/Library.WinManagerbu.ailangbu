// =============================================================================
// WIN_GEOMPTR — pointer to a slot
// =============================================================================
Function.Win_GeomPtr {
    Input:  idx: Integer
    Output: Integer
    Body: {
        ReturnValue(Add(WinGeomTable.data, Multiply(idx, WinGeomConst.ENTRY_SIZE)))
    }
}

// =============================================================================
// WIN_SETGEOM — THE ONLY PLACE that writes window geometry.
//
// Derives canvas_w and canvas_h here. Stores all 6 fields.
// Then syncs FloatEntry so hit-testing and drag see the same values.
//
// Call this on:
//   - Win_Create      (initial size)
//   - Win_UpdateResize (every mouse move during resize)
// Nothing else should compute canvas_w or canvas_h independently.
// =============================================================================

Function.Win_SetGeom {
    Input: idx:     Integer
    Input: x:       Integer
    Input: y:       Integer
    Input: total_w: Integer
    Input: total_h: Integer
    Output: Integer
    Body: {
        bw       = DecorConfig.border_w
        canvas_w = Subtract(total_w, Multiply(bw, 2))
        canvas_h = Subtract(total_h, Multiply(bw, 2))
        min_cw   = WinMinSize.w
        min_ch   = WinMinSize.h
        IfCondition LessThan(canvas_w, min_cw) ThenBlock: { canvas_w = min_cw }
        IfCondition LessThan(canvas_h, min_ch) ThenBlock: { canvas_h = min_ch }
        total_w = Add(canvas_w, Multiply(bw, 2))
        total_h = Add(canvas_h, Multiply(bw, 2))
        gptr = Win_GeomPtr(idx)
        StoreValue(Add(gptr, WinGeomFields.TOTAL_W),  total_w)
        StoreValue(Add(gptr, WinGeomFields.TOTAL_H),  total_h)
        StoreValue(Add(gptr, WinGeomFields.CANVAS_W), canvas_w)
        StoreValue(Add(gptr, WinGeomFields.CANVAS_H), canvas_h)
        StoreValue(Add(gptr, WinGeomFields.X),        x)
        StoreValue(Add(gptr, WinGeomFields.Y),        y)
        fptr = Float_EntryPtr(idx)
        StoreValue(Add(fptr, FloatEntryFields.X), x)
        StoreValue(Add(fptr, FloatEntryFields.Y), y)
        StoreValue(Add(fptr, FloatEntryFields.W), total_w)
        StoreValue(Add(fptr, FloatEntryFields.H), total_h)
        ReturnValue(1)
    }
}


// Accessors — read WinGeom, not FloatEntry, not surface header
Function.Win_GetTotalW  { Input: idx: Integer Output: Integer Body: { ReturnValue(Dereference(Add(Win_GeomPtr(idx), WinGeomFields.TOTAL_W)))  } }
Function.Win_GetTotalH  { Input: idx: Integer Output: Integer Body: { ReturnValue(Dereference(Add(Win_GeomPtr(idx), WinGeomFields.TOTAL_H)))  } }
Function.Win_GetCanvasW { Input: idx: Integer Output: Integer Body: { ReturnValue(Dereference(Add(Win_GeomPtr(idx), WinGeomFields.CANVAS_W))) } }
Function.Win_GetCanvasH { Input: idx: Integer Output: Integer Body: { ReturnValue(Dereference(Add(Win_GeomPtr(idx), WinGeomFields.CANVAS_H))) } }
Function.Win_GetX       { Input: idx: Integer Output: Integer Body: { ReturnValue(Dereference(Add(Win_GeomPtr(idx), WinGeomFields.X)))        } }
Function.Win_GetY       { Input: idx: Integer Output: Integer Body: { ReturnValue(Dereference(Add(Win_GeomPtr(idx), WinGeomFields.Y)))        } }

// =============================================================================
// Stack table accessors
// =============================================================================
Function.Stack_Ptr {
    Input:  idx: Integer
    Output: Integer
    Body: { ReturnValue(Add(StackTable.data, Multiply(idx, StackConst.ENTRY_SIZE))) }
}

Function.Stack_Get {
    Input:  idx: Integer
    Input:  field: Integer
    Output: Integer
    Body: {
        sp = Stack_Ptr(idx)
        ReturnValue(Dereference(Add(sp, field)))
    }
}

Function.Stack_Set {
    Input: idx: Integer
    Input: field: Integer
    Input: val: Integer
    Body: {
        sp = Stack_Ptr(idx)
        StoreValue(Add(sp, field), val)
    }
}

Function.WinStack_Get {
    Input:  win_idx: Integer
    Output: Integer
    Body: { ReturnValue(Dereference(Add(WinStackMap.data, Multiply(win_idx, 8)))) }
}

Function.WinStack_Set {
    Input: win_idx: Integer
    Input: stack_idx: Integer
    Body: { StoreValue(Add(WinStackMap.data, Multiply(win_idx, 8)), stack_idx) }
}

Function.Stack_CalcHeight {
    Input:  tab_count: Integer
    Input:  canvas_w:  Integer
    Output: Integer
    Body: {
        tabs_per_row = Divide(canvas_w, TabConst.TAB_MAX_W)
        IfCondition LessThan(tabs_per_row, 1) ThenBlock: { tabs_per_row = 1 }
        row_count = Divide(Add(tab_count, Subtract(tabs_per_row, 1)), tabs_per_row)
        IfCondition LessThan(row_count, 1) ThenBlock: { row_count = 1 }
        tab_bar_h = Multiply(row_count, TabConst.TAB_ROW_H)
        ReturnValue(tab_bar_h)
    }
}

Function.Win_GetTabBarH_FromStack {
    Input:  idx: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(idx, 0) ThenBlock: {
            ReturnValue(0)
        }
        stack_idx = WinStack_Get(idx)
        IfCondition LessThan(stack_idx, 0) ThenBlock: {
            ReturnValue(DecorConfig.header_h)
        }
        tab_count = Stack_Get(stack_idx, StackFields.TAB_COUNT)
        canvas_w  = Win_GetCanvasW(idx)
        tbh = Stack_CalcHeight(tab_count, canvas_w)
        ReturnValue(tbh)
    }
}

Function.Stack_Create {
    Input:  win_idx: Integer
    Output: Integer
    Body: {
        sidx = -1
        si2 = 0
        WhileLoop LessThan(si2, StackConst.MAX) {
            act = Stack_Get(si2, StackFields.ACTIVE)
            IfCondition EqualTo(act, 0) ThenBlock: {
                sidx = si2
                si2 = StackConst.MAX
            } ElseBlock: {
                si2 = Add(si2, 1)
            }
        }
        IfCondition LessThan(sidx, 0) ThenBlock: {
            PrintMessage("[Stack] ERROR: table full\n")
            ReturnValue(-1)
        }

        wlist = Allocate(64)
        wi = 0
        WhileLoop LessThan(wi, 8) {
            StoreValue(Add(wlist, Multiply(wi, 8)), -1)
            wi = Add(wi, 1)
        }
        StoreValue(wlist, win_idx)

        Stack_Set(sidx, StackFields.TAB_SURF,   -1)
        Stack_Set(sidx, StackFields.TAB_COUNT,   1)
        Stack_Set(sidx, StackFields.TAB_BAR_H,   TabConst.TAB_ROW_H)
        Stack_Set(sidx, StackFields.ACTIVE_WIN,  0)
        Stack_Set(sidx, StackFields.WIN_LIST,    wlist)
        Stack_Set(sidx, StackFields.ACTIVE,      1)
        StackTable.count = Add(StackTable.count, 1)

        WinStack_Set(win_idx, sidx)

        PrintMessage("[Stack] created idx=")
        PrintNumber(sidx)
        PrintMessage(" win=")
        PrintNumber(win_idx)
        PrintMessage("\n")
        ReturnValue(sidx)
    }
}


// =============================================================================
// WIN_UPDATERESIZE — mouse move. Calls Win_SetGeom. Recreates surfaces.
// =============================================================================


Function.Win_UpdateResize {
    Input:  mouse_x: Integer
    Input:  mouse_y: Integer
    Output: Integer
    Body: {
        idx = WinMgr.resize_idx
        IfCondition LessThan(idx, 0) ThenBlock: { ReturnValue(0) }

        edge    = WinMgr.resize_edge
        bw      = DecorConfig.border_w
        hh      = DecorConfig.header_h
        dx      = Subtract(mouse_x, WinMgr.resize_anchor_x)
        dy      = Subtract(mouse_y, WinMgr.resize_anchor_y)
        orig_fx = WinMgr.resize_orig_fx
        orig_fy = WinMgr.resize_orig_fy
        orig_w  = WinMgr.resize_orig_w
        orig_h  = WinMgr.resize_orig_h

        Win_DebugNum("edge=",   edge)
        Win_DebugNum("dx=",     dx)
        Win_DebugNum("dy=",     dy)
        Win_DebugNum("orig_h=", orig_h)
        Win_DebugNum("orig_w=", orig_w)

        min_w = Add(WinMinSize.w, Multiply(bw, 2))
        min_h = Add(Add(WinMinSize.h, hh), Multiply(bw, 3))

        new_fx = orig_fx
        new_fy = orig_fy
        new_w  = orig_w
        new_h  = orig_h

        IfCondition NotEqual(BitwiseAnd(edge, ResizeEdge.RIGHT), 0) ThenBlock: {
            new_w = Add(orig_w, dx)
            IfCondition LessThan(new_w, min_w) ThenBlock: { new_w = min_w }
        }
        IfCondition NotEqual(BitwiseAnd(edge, ResizeEdge.LEFT), 0) ThenBlock: {
            new_w = Subtract(orig_w, dx)
            IfCondition LessThan(new_w, min_w) ThenBlock: {
                new_w = min_w
                new_fx = Subtract(Add(orig_fx, orig_w), min_w)
            } ElseBlock: {
                new_fx = Add(orig_fx, dx)
            }
        }
        IfCondition NotEqual(BitwiseAnd(edge, ResizeEdge.BOTTOM), 0) ThenBlock: {
            new_h = Add(orig_h, dy)
            IfCondition LessThan(new_h, min_h) ThenBlock: { new_h = min_h }
        }
        IfCondition NotEqual(BitwiseAnd(edge, ResizeEdge.TOP), 0) ThenBlock: {
            new_h = Subtract(orig_h, dy)
            IfCondition LessThan(new_h, min_h) ThenBlock: {
                new_h = min_h
                new_fy = Subtract(Add(orig_fy, orig_h), min_h)
            } ElseBlock: {
                new_fy = Add(orig_fy, dy)
            }
        }

        // Position clamping only - allow size to grow beyond screen during drag
        sw = FB_GetWidth()
        sh = FB_GetHeight()
        IfCondition LessThan(new_fx, 0) ThenBlock: { new_fx = 0 }
        IfCondition LessThan(new_fy, 0) ThenBlock: { new_fy = 0 }

        // One call sets everything
        Win_SetGeom(idx, new_fx, new_fy, new_w, new_h)

        // Read back canvas size from WinGeom
        canvas_w = Win_GetCanvasW(idx)
        canvas_h = Win_GetCanvasH(idx)

        // Recreate surfaces
        old_tb      = WinMgr_GetTB(idx)
        old_hdr     = WinMgr_GetHdr(idx)
        old_content = WinMgr_GetContent(idx)

        bg = WinColor.WINDOW
        IfCondition GreaterEqual(old_tb, 0) ThenBlock: {
            bg = TB_Get(old_tb, TBField.BG)
            TextBuffer_Destroy(old_tb)
        }

        new_hdr = Surface_Create(SurfaceFormat.PIXEL_32, canvas_w, hh)
        IfCondition EqualTo(new_hdr, 0) ThenBlock: { ReturnValue(0) }

        new_content = Surface_Create(SurfaceFormat.PIXEL_32, canvas_w, canvas_h)
        IfCondition EqualTo(new_content, 0) ThenBlock: {
            Surface_Destroy(new_hdr)
            ReturnValue(0)
        }
        Draw_Pix_FillRect(new_content, 0, 0, canvas_w, canvas_h, bg)

        WinMgr_SetHdr(idx, new_hdr)
        WinMgr_SetContent(idx, new_content)

        fptr = Float_EntryPtr(idx)
        StoreValue(Add(fptr, FloatEntryFields.SURFACE), new_content)

        IfCondition GreaterEqual(old_hdr, 0)     ThenBlock: { Surface_Destroy(old_hdr) }
        IfCondition GreaterEqual(old_content, 0) ThenBlock: { Surface_Destroy(old_content) }

     //   Win_DrawHeader(idx, "Application")
       WinMgr_SetTB(idx, -1)
       

        // Update anchor only
        WinMgr.resize_anchor_x = mouse_x
        WinMgr.resize_anchor_y = mouse_y
        WinMgr.resize_orig_fx  = Win_GetX(idx)
        WinMgr.resize_orig_fy  = Win_GetY(idx)
        WinMgr.resize_orig_w = Win_GetTotalW(idx)
        WinMgr.resize_orig_h = Win_GetTotalH(idx)

        ReturnValue(1)
    }
}


// =============================================================================
// WIN_STARTRESIZE — reads orig geometry from WinGeom, not FloatEntry.
// FloatEntry could be stale; WinGeom is always authoritative.
// =============================================================================
Function.Win_StartResize {
    Input:  idx:     Integer
    Input:  mouse_x: Integer
    Input:  mouse_y: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(idx, 0) ThenBlock: { ReturnValue(0) }
        WinMgr.resize_idx      = idx
        WinMgr.resize_anchor_x = mouse_x
        WinMgr.resize_anchor_y = mouse_y

        

        // Read from WinGeom — this is why WinGeom exists
        WinMgr.resize_orig_fx = Win_GetX(idx)
        WinMgr.resize_orig_fy = Win_GetY(idx)
        WinMgr.resize_orig_w  = Win_GetTotalW(idx)
        WinMgr.resize_orig_h  = Win_GetTotalH(idx)
        WinMgr.resize_new_fx  = WinMgr.resize_orig_fx
        WinMgr.resize_new_fy  = WinMgr.resize_orig_fy
        WinMgr.resize_new_w   = WinMgr.resize_orig_w
        WinMgr.resize_new_h   = WinMgr.resize_orig_h

        Win_DebugPrint("RESIZE START")
        Win_DebugNum("idx=",   idx)
        Win_DebugNum("edge=",  WinMgr.resize_edge)
        Win_DebugNum("origW=", WinMgr.resize_orig_w)
        Win_DebugNum("origH=", WinMgr.resize_orig_h)
        ReturnValue(1)
    }
}

// =============================================================================
// WIN_CLOSE — shift WinGeom entries down alongside the other arrays.
// =============================================================================
Function.Win_Close {
    Input:  idx: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(idx, 0)        ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(idx, 0)       ThenBlock: { ReturnValue(0) }
        cnt = FloatTable.count
        IfCondition GreaterEqual(idx, cnt) ThenBlock: { ReturnValue(0) }

        tb           = WinMgr_GetTB(idx)
        hdr_surf     = WinMgr_GetHdr(idx)
        content_surf = WinMgr_GetContent(idx)
        IfCondition GreaterEqual(tb, 0)           ThenBlock: { TextBuffer_Destroy(tb) }
        IfCondition GreaterEqual(hdr_surf, 0)     ThenBlock: { Surface_Destroy(hdr_surf) }
        IfCondition GreaterEqual(content_surf, 0) ThenBlock: { Surface_Destroy(content_surf) }

        Float_Remove(idx)

        // Shift WinMgr arrays and WinGeom down
        i = idx
        new_cnt = Subtract(cnt, 1)
        WhileLoop LessThan(i, new_cnt) {
            WinMgr_SetHdr(i,     WinMgr_GetHdr(Add(i, 1)))
            WinMgr_SetContent(i, WinMgr_GetContent(Add(i, 1)))
            WinMgr_SetTB(i,      WinMgr_GetTB(Add(i, 1)))

            // Copy WinGeom slot i+1 → i
            src = Win_GeomPtr(Add(i, 1))
            dst = Win_GeomPtr(i)
            j = 0
            WhileLoop LessThan(j, WinGeomConst.ENTRY_SIZE) {
                SetByte(dst, j, GetByte(src, j))
                j = Add(j, 1)
            }
            i = Add(i, 1)
        }

        // Zero vacated last slot
        WinMgr_SetHdr(new_cnt,     -1)
        WinMgr_SetContent(new_cnt, -1)
        WinMgr_SetTB(new_cnt,      -1)
        last = Win_GeomPtr(new_cnt)
        j = 0
        WhileLoop LessThan(j, WinGeomConst.ENTRY_SIZE) {
            SetByte(last, j, 0)
            j = Add(j, 1)
        }

        WinMgr.count = Subtract(WinMgr.count, 1)
        new_focus = Subtract(idx, 1)
        IfCondition LessThan(new_focus, 0) ThenBlock: { new_focus = 0 }
        WinMgr.focused = new_focus
        ReturnValue(1)
    }
}


// =============================================================================
// WIN_APPLYRESIZE — mouse up. Clear state only. Surface already correct.
// =============================================================================
Function.Win_ApplyResize {
    Output: Integer
    Body: {
        idx = WinMgr.resize_idx
        IfCondition LessThan(idx, 0) ThenBlock: { ReturnValue(0) }
        WinMgr.resize_idx  = -1
        WinMgr.resize_edge = 0
        ReturnValue(1)
    }
}

// =============================================================================
// WIN_BLITALL — reads geometry from WinGeom, not FloatEntry, not surface header
// =============================================================================
Function.Win_BlitAll {
    Output: Integer
    Body: {
        cnt = FloatTable.count
        bw  = DecorConfig.border_w
        hh  = DecorConfig.header_h
        i   = 0
        WhileLoop LessThan(i, cnt) {
            x        = Win_GetX(i)
            y        = Win_GetY(i)
            total_w  = Win_GetTotalW(i)
            total_h  = Win_GetTotalH(i)
            canvas_w = Win_GetCanvasW(i)
            canvas_h = Win_GetCanvasH(i)

            hdr_surf     = WinMgr_GetHdr(i)
            content_surf = WinMgr_GetContent(i)

            // Desktop (i==0): blit content at origin, no header, no border
            IfCondition EqualTo(i, 0) ThenBlock: {
                IfCondition GreaterEqual(content_surf, 0) ThenBlock: {
                    Win_BlitOne(content_surf, x, y)
                }
            } ElseBlock: {
              
                tbh = Win_GetTabBarH_FromStack(i)

                IfCondition GreaterEqual(hdr_surf, 0) ThenBlock: {
                    Win_BlitOne(hdr_surf, Add(x, bw), Add(y, bw))
                }
                IfCondition GreaterEqual(content_surf, 0) ThenBlock: {
                    body_y = Add(Add(y, bw), tbh)
                    Win_BlitOne(content_surf, Add(x, bw), body_y)
                }

                Win_DrawBorderFB(x, y, total_w, total_h)

                sep_y   = Add(Add(y, bw), tbh)
                sep_row = 0
                sep_buf = FB_GetDrawBuffer()
                sep_pit = FB.pitch
                sep_pb  = SurfaceConst.PIXEL_BYTES
                sep_col = WinColor.BORDER
                sep_b   = BitwiseAnd(sep_col, 255)
                sep_g   = BitwiseAnd(ShiftRight(sep_col, 8),  255)
                sep_r   = BitwiseAnd(ShiftRight(sep_col, 16), 255)
                WhileLoop LessThan(sep_row, bw) {
                    sep_px = 0
                    WhileLoop LessThan(sep_px, total_w) {
                        sep_off = Add(Multiply(Add(sep_y, sep_row), sep_pit), Multiply(Add(x, sep_px), sep_pb))
                        SetByte(sep_buf, Add(sep_off, 0), sep_b)
                        SetByte(sep_buf, Add(sep_off, 1), sep_g)
                        SetByte(sep_buf, Add(sep_off, 2), sep_r)
                        SetByte(sep_buf, Add(sep_off, 3), 0)
                        sep_px = Add(sep_px, 1)
                    }
                    sep_row = Add(sep_row, 1)
                }
            }

            i = Add(i, 1)
        }
        Cursor_Draw()
        FB_FlipFast()
        ReturnValue(0)
    }
}

