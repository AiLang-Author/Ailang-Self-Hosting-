// =============================================================================
// WIN_BLITALL — reads geometry from WinGeom, not FloatEntry, not surface header
// =============================================================================
Function.Win_BlitAll {
    Output: Integer
    Body: {
        DebugLog_Push("win.blt", 7)
        bw  = DecorConfig.border_w
        zi  = 0
        DebugLog_Push("wr.blt.1", 8)
        WhileLoop LessThan(zi, WinMgr.z_count) {
            i = WinMgr_ZGet(zi)
            IfCondition LessThan(i, 0) ThenBlock: {
                zi = Add(zi, 1)
            } ElseBlock: {
            DebugLog_Push("wr.blt.2", 8)

            x        = Win_GetX(i)
            y        = Win_GetY(i)
            total_w  = Win_GetTotalW(i)
            total_h  = Win_GetTotalH(i)
            canvas_w = Win_GetCanvasW(i)
            canvas_h = Win_GetCanvasH(i)

            hdr_surf     = WinMgr_GetHdr(i)
            content_surf = WinMgr_GetContent(i)

            // Desktop (i==0): blit content at origin, no header, no border
            IfCondition EqualTo(i, 0) ThenBlock: {
                IfCondition GreaterEqual(content_surf, 0) ThenBlock: {
                    Win_BlitOne(content_surf, x, y)
                }
            } ElseBlock: {
                tbh       = Win_GetTabBarH_FromStack(i)
                toolbar_h = WinMgr_GetToolbarH(i)

                // Tab bar — welded above toolbar + box, full width
                IfCondition GreaterEqual(hdr_surf, 0) ThenBlock: {
                    Win_BlitOne(hdr_surf, x, Subtract(Subtract(y, tbh), toolbar_h))
                }

                // Toolbar — between tab bar and box, full width
                toolbar_surf = WinMgr_GetToolbar(i)
                IfCondition GreaterEqual(toolbar_surf, 0) ThenBlock: {
                    Win_BlitOne(toolbar_surf, x, Subtract(y, toolbar_h))
                }

                // Content — inside box
                IfCondition GreaterEqual(content_surf, 0) ThenBlock: {
                    Win_BlitOne(content_surf, Add(x, bw), Add(y, bw))
                }

                // Border — the box itself
                Win_DrawBorderFB(x, y, total_w, total_h)
            }

            zi = Add(zi, 1)
            }
        }
// Deskbar — always draw hotzone, draw surface if visible
        DebugLog_Push("wr.blt.3", 8)
        Deskbar_DrawHotzone()
        DebugLog_Push("wr.blt.4", 8)
        Deskbar_Draw()

        // Menu overlay — drawn on top of everything except cursor
        DebugLog_Push("wr.blt.5", 8)
        Menu_Blit()

        // Debug overlay — blit debug surface to framebuffer at (10, 140)
        IfCondition EqualTo(DebugLog.enabled, 1) ThenBlock: {
            dbg_s = SysDisplayState.dbg_surf
            IfCondition NotEqual(dbg_s, 0) ThenBlock: {
                Win_BlitOne(dbg_s, 10, 140)
            }
        }

        DebugLog_Push("wr.blt.6", 8)
        Cursor_Draw()
        DebugLog_Push("wr.blt.7", 8)
        FB_FlipFast()
        ReturnValue(0)
    }
}


// =============================================================================
// WIN_BLITONE — blit surface to framebuffer at (dst_x, dst_y)
// =============================================================================
Function.Win_BlitOne {
    Input: surf:  Integer
    Input: dst_x: Integer
    Input: dst_y: Integer
    Output: Integer
    Body: {
        DebugLog_Push("win.bl1", 7)
        sw        = Surface_GetWidth(surf)
        sh        = Surface_GetHeight(surf)
        src_data  = Surface_GetData(surf)
        src_pitch = Surface_GetPitch(surf)
        dst_buf   = FB_GetDrawBuffer()
        dst_pitch = FB.pitch
        fb_w      = FB_GetWidth()
        fb_h      = FB_GetHeight()
        pb        = SurfaceConst.PIXEL_BYTES

        // Clamp source rect to framebuffer bounds
        src_x0 = 0
        src_y0 = 0
        draw_w = sw
        draw_h = sh

        // Left edge: if dst_x < 0, skip leading source columns
        IfCondition LessThan(dst_x, 0) ThenBlock: {
            src_x0 = Subtract(0, dst_x)
            draw_w = Subtract(sw, src_x0)
            dst_x  = 0
        }
        // Top edge: if dst_y < 0, skip leading source rows
        IfCondition LessThan(dst_y, 0) ThenBlock: {
            src_y0 = Subtract(0, dst_y)
            draw_h = Subtract(sh, src_y0)
            dst_y  = 0
        }
        // Right edge: clamp width to framebuffer
        ovr_x = Subtract(Add(dst_x, draw_w), fb_w)
        IfCondition GreaterThan(ovr_x, 0) ThenBlock: {
            draw_w = Subtract(draw_w, ovr_x)
        }
        // Bottom edge: clamp height to framebuffer
        ovr_y = Subtract(Add(dst_y, draw_h), fb_h)
        IfCondition GreaterThan(ovr_y, 0) ThenBlock: {
            draw_h = Subtract(draw_h, ovr_y)
        }

        // Nothing visible after clamping
        IfCondition LessEqual(draw_w, 0) ThenBlock: { ReturnValue(0) }
        IfCondition LessEqual(draw_h, 0) ThenBlock: { ReturnValue(0) }

        row_bytes = Multiply(draw_w, pb)
        dst_x_off = Multiply(dst_x, pb)
        src_x_off = Multiply(src_x0, pb)
        y = 0
        WhileLoop LessThan(y, draw_h) {
            sry = Add(y, src_y0)
            dry = Add(y, dst_y)
            sr_off = Add(Multiply(sry, src_pitch), src_x_off)
            src_row = Add(src_data, sr_off)
            dr_off = Add(Multiply(dry, dst_pitch), dst_x_off)
            dst_row = Add(dst_buf, dr_off)
            MemoryCopy(dst_row, src_row, row_bytes)
            y = Add(y, 1)
        }
        ReturnValue(1)
    }
}


// =============================================================================
// WIN_BLITCLAMPED — blit surface clipped to clip_w x clip_h
// =============================================================================
Function.Win_BlitClamped {
    Input: surf:   Integer
    Input: dst_x:  Integer
    Input: dst_y:  Integer
    Input: clip_w: Integer
    Input: clip_h: Integer
    Output: Integer
    Body: {
        DebugLog_Push("wr.blc", 6)
        sw        = Surface_GetWidth(surf)
        sh        = Surface_GetHeight(surf)
        src_data  = Surface_GetData(surf)
        src_pitch = Surface_GetPitch(surf)
        dst_buf   = FB_GetDrawBuffer()
        dst_pitch = FB.pitch
        fb_w      = FB_GetWidth()
        fb_h      = FB_GetHeight()
        pb        = SurfaceConst.PIXEL_BYTES

        draw_w = sw
        draw_h = sh
        IfCondition LessThan(clip_w, sw) ThenBlock: { draw_w = clip_w }
        IfCondition LessThan(clip_h, sh) ThenBlock: { draw_h = clip_h }

        // Clamp to framebuffer bounds
        src_x0 = 0
        src_y0 = 0
        IfCondition LessThan(dst_x, 0) ThenBlock: {
            src_x0 = Subtract(0, dst_x)
            draw_w = Subtract(draw_w, src_x0)
            dst_x  = 0
        }
        IfCondition LessThan(dst_y, 0) ThenBlock: {
            src_y0 = Subtract(0, dst_y)
            draw_h = Subtract(draw_h, src_y0)
            dst_y  = 0
        }
        ovr_x = Subtract(Add(dst_x, draw_w), fb_w)
        IfCondition GreaterThan(ovr_x, 0) ThenBlock: {
            draw_w = Subtract(draw_w, ovr_x)
        }
        ovr_y = Subtract(Add(dst_y, draw_h), fb_h)
        IfCondition GreaterThan(ovr_y, 0) ThenBlock: {
            draw_h = Subtract(draw_h, ovr_y)
        }

        IfCondition LessEqual(draw_w, 0) ThenBlock: { ReturnValue(0) }
        IfCondition LessEqual(draw_h, 0) ThenBlock: { ReturnValue(0) }

        row_bytes = Multiply(draw_w, pb)
        dst_x_off = Multiply(dst_x, pb)
        src_x_off = Multiply(src_x0, pb)
        y = 0
        WhileLoop LessThan(y, draw_h) {
            sry = Add(y, src_y0)
            dry = Add(y, dst_y)
            sr_off = Add(Multiply(sry, src_pitch), src_x_off)
            src_row = Add(src_data, sr_off)
            dr_off = Add(Multiply(dry, dst_pitch), dst_x_off)
            dst_row = Add(dst_buf, dr_off)
            MemoryCopy(dst_row, src_row, row_bytes)
            y = Add(y, 1)
        }
        ReturnValue(1)
    }
}


// =============================================================================
// WIN_DRAWBORDERFB — draw border rect directly to framebuffer
// =============================================================================
Function.Win_DrawBorderFB {
    Input: x: Integer
    Input: y: Integer
    Input: w: Integer
    Input: h: Integer
    Output: Integer
    Body: {
        DebugLog_Push("wr.bdr", 6)
        bw  = DecorConfig.border_w
        buf = FB_GetDrawBuffer()
        pit = FB.pitch
        pb  = SurfaceConst.PIXEL_BYTES
        fb_w = FB_GetWidth()
        fb_h = FB_GetHeight()
        col = WinColor.BORDER

        // Clamp draw region to framebuffer
        x0 = x
        y0 = y
        x1 = Add(x, w)
        y1 = Add(y, h)
        IfCondition LessThan(x0, 0)       ThenBlock: { x0 = 0 }
        IfCondition LessThan(y0, 0)       ThenBlock: { y0 = 0 }
        IfCondition GreaterThan(x1, fb_w) ThenBlock: { x1 = fb_w }
        IfCondition GreaterThan(y1, fb_h) ThenBlock: { y1 = fb_h }
        IfCondition GreaterEqual(x0, x1)  ThenBlock: { ReturnValue(0) }
        IfCondition GreaterEqual(y0, y1)  ThenBlock: { ReturnValue(0) }

        row_px = Subtract(x1, x0)
        row_bytes = Multiply(row_px, pb)

        // — Top strip: rows y..y+bw-1, clamped —
        ty0 = y
        ty1 = Add(y, bw)
        IfCondition LessThan(ty0, y0) ThenBlock: { ty0 = y0 }
        IfCondition GreaterThan(ty1, y1) ThenBlock: { ty1 = y1 }
        IfCondition LessThan(ty0, ty1) ThenBlock: {
            // Fill first row with dword StoreValue
            first_addr = Add(buf, Add(Multiply(ty0, pit), Multiply(x0, pb)))
            ci = 0
            WhileLoop LessThan(ci, row_px) {
                StoreValue(Add(first_addr, Multiply(ci, pb)), col, "dword")
                ci = Add(ci, 1)
            }
            // MemoryCopy remaining rows from first row
            tr = Add(ty0, 1)
            WhileLoop LessThan(tr, ty1) {
                dst = Add(buf, Add(Multiply(tr, pit), Multiply(x0, pb)))
                MemoryCopy(dst, first_addr, row_bytes)
                tr = Add(tr, 1)
            }
        }

        // — Bottom strip: rows y+h-bw..y+h-1, clamped —
        by0 = Subtract(Add(y, h), bw)
        by1 = Add(y, h)
        IfCondition LessThan(by0, y0) ThenBlock: { by0 = y0 }
        IfCondition GreaterThan(by1, y1) ThenBlock: { by1 = y1 }
        IfCondition LessThan(by0, by1) ThenBlock: {
            first_addr = Add(buf, Add(Multiply(by0, pit), Multiply(x0, pb)))
            ci = 0
            WhileLoop LessThan(ci, row_px) {
                StoreValue(Add(first_addr, Multiply(ci, pb)), col, "dword")
                ci = Add(ci, 1)
            }
            br = Add(by0, 1)
            WhileLoop LessThan(br, by1) {
                dst = Add(buf, Add(Multiply(br, pit), Multiply(x0, pb)))
                MemoryCopy(dst, first_addr, row_bytes)
                br = Add(br, 1)
            }
        }

        // — Left strip: middle rows, cols x..x+bw-1, clamped —
        my0 = Add(y, bw)
        my1 = Subtract(Add(y, h), bw)
        IfCondition LessThan(my0, y0) ThenBlock: { my0 = y0 }
        IfCondition GreaterThan(my1, y1) ThenBlock: { my1 = y1 }
        lx0 = x
        lx1 = Add(x, bw)
        IfCondition LessThan(lx0, x0) ThenBlock: { lx0 = x0 }
        IfCondition GreaterThan(lx1, x1) ThenBlock: { lx1 = x1 }
        left_px = Subtract(lx1, lx0)
        IfCondition And(GreaterThan(left_px, 0), LessThan(my0, my1)) ThenBlock: {
            first_addr = Add(buf, Add(Multiply(my0, pit), Multiply(lx0, pb)))
            ci = 0
            WhileLoop LessThan(ci, left_px) {
                StoreValue(Add(first_addr, Multiply(ci, pb)), col, "dword")
                ci = Add(ci, 1)
            }
            left_bytes = Multiply(left_px, pb)
            lr = Add(my0, 1)
            WhileLoop LessThan(lr, my1) {
                dst = Add(buf, Add(Multiply(lr, pit), Multiply(lx0, pb)))
                MemoryCopy(dst, first_addr, left_bytes)
                lr = Add(lr, 1)
            }
        }

        // — Right strip: middle rows, cols x+w-bw..x+w-1, clamped —
        rx0 = Subtract(Add(x, w), bw)
        rx1 = Add(x, w)
        IfCondition LessThan(rx0, x0) ThenBlock: { rx0 = x0 }
        IfCondition GreaterThan(rx1, x1) ThenBlock: { rx1 = x1 }
        right_px = Subtract(rx1, rx0)
        IfCondition And(GreaterThan(right_px, 0), LessThan(my0, my1)) ThenBlock: {
            first_addr = Add(buf, Add(Multiply(my0, pit), Multiply(rx0, pb)))
            ci = 0
            WhileLoop LessThan(ci, right_px) {
                StoreValue(Add(first_addr, Multiply(ci, pb)), col, "dword")
                ci = Add(ci, 1)
            }
            right_bytes = Multiply(right_px, pb)
            rr = Add(my0, 1)
            WhileLoop LessThan(rr, my1) {
                dst = Add(buf, Add(Multiply(rr, pit), Multiply(rx0, pb)))
                MemoryCopy(dst, first_addr, right_bytes)
                rr = Add(rr, 1)
            }
        }

        ReturnValue(0)
    }
}


// =============================================================================
// WIN_DRAWHEADER — wrapper for Win_DrawTabBar
// =============================================================================
Function.Win_DrawHeader {
    Input: idx:   Integer
    Input: title: Integer
    Output: Integer
    Body: {
        DebugLog_Push("wr.hdr", 6)
        ReturnValue(Win_DrawTabBar(idx))
    }
}


// =============================================================================
// WIN_DRAWTABBAR — renders tab bar surface with titles
// =============================================================================
Function.Win_DrawTabBar {
    Input: idx: Integer
    Output: Integer
    Body: {
        DebugLog_Push("wr.tab", 6)
        surf = WinMgr_GetHdr(idx)
        IfCondition LessThan(surf, 0) ThenBlock: { ReturnValue(0) }

        tw  = Win_GetTotalW(idx)
        tbh = Win_GetTabBarH_FromStack(idx)
        inst = WinMgr.tab_inst

        // Fill entire tab bar background (dark)
        DebugLog_Push("wr.tab.1", 8)
        Draw_Pix_FillRect(surf, 0, 0, tw, tbh, Theme.tabbar_bg)

        // Draw active tab rect
        tab_x = 0
        tab_w = TabConst.TAB_MAX_W
        tab_h = TabConst.TAB_ROW_H
        pad   = TabConst.TAB_PAD

        // Active tab background (lighter)
        DebugLog_Push("wr.tab.2", 8)
        Draw_Pix_FillRect(surf, tab_x, 0, tab_w, tab_h, Theme.tab_active_bg)

        // Icon placeholder — 10x10 colored rect
        icon_x = Add(tab_x, pad)
        icon_y = Divide(Subtract(tab_h, TabConst.TAB_ICON_W), 2)
        DebugLog_Push("wr.tab.3", 8)
        Draw_Pix_FillRect(surf, icon_x, icon_y, TabConst.TAB_ICON_W, TabConst.TAB_ICON_W, Theme.tab_icon)

        // Title text — 8 chars max
        title_ptr = WinMgr_GetTitle(idx)
        IfCondition NotEqual(title_ptr, 0) ThenBlock: {
            IfCondition GreaterEqual(inst, 0) ThenBlock: {
                text_x = Add(Add(icon_x, TabConst.TAB_ICON_W), pad)
                text_y = Divide(Subtract(tab_h, UIScale.tab_font_h), 2)
                title_len = StringLength(title_ptr)
                IfCondition GreaterThan(title_len, 8) ThenBlock: { title_len = 8 }
                FontState.draw_color = Theme.tab_text
                VInst_DrawString(inst, surf, title_ptr, title_len, text_x, text_y)
            }
        }

        ReturnValue(1)
    }
}


// =============================================================================
// WIN_RENDERDIRTY — stub for dirty buffer rendering
// =============================================================================
Function.Win_RenderDirty {
    Output: Integer
    Body: {
        DebugLog_Push("win.rdr", 7)
        ReturnValue(0)
    }
}