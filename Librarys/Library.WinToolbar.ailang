// =============================================================================

LibraryImport.DSurfaceTypes
LibraryImport.DSurface
LibraryImport.DDrawPixel
LibraryImport.WinManager
LibraryImport.Auckland
LibraryImport.AucklandEvent
LibraryImport.EventRouter
LibraryImport.VIF
LibraryImport.Fonts
LibraryImport.TextRegion
LibraryImport.UIScale
LibraryImport.UITheme


// =============================================================================
// WIN_CREATETOOLBARDEFAULT — create toolbar for a window
// Mirrors Deskbar_Init: create ctx, build, render.
// =============================================================================
Function.Win_CreateToolbarDefault {
    Input: idx: Integer
    Output: Integer
    Body: {
        DebugLog_Push("tb.cr", 5)
        IfCondition EqualTo(idx, 0) ThenBlock: { ReturnValue(0) }

        total_w = Win_GetTotalW(idx)
        tb_h = UIScale.toolbar_h

        // Create toolbar surface
        DebugLog_Push("tb.cr.1", 7)
        tb_surf = Surface_Create(SurfaceFormat.PIXEL_32, total_w, tb_h)
        IfCondition EqualTo(tb_surf, 0) ThenBlock: {
            PrintMessage("[Toolbar] surface alloc failed\n")
            ReturnValue(0)
        }

        // Allocate AK context for toolbar
        DebugLog_Push("tb.cr.2", 7)
        ak_ctx = AK_CreateContext()
        IfCondition EqualTo(ak_ctx, 0) ThenBlock: {
            PrintMessage("[Toolbar] AKContext alloc failed\n")
            ReturnValue(0)
        }

        // Set design dimensions to match actual toolbar surface
        // (prevents AK_ComputeScale from shrinking everything)
        AK_SetDesignW(ak_ctx, total_w)
        AK_SetDesignH(ak_ctx, tb_h)

        // Build tree and render
        DebugLog_Push("tb.cr.3", 7)
        Win_BuildDefaultToolbar(ak_ctx)

        DebugLog_Push("tb.cr.4", 7)
        Draw_Pix_FillRect(tb_surf, 0, 0, total_w, tb_h, Theme.toolbar_bg)
        DebugLog_Push("tb.cr.5", 7)
        AK_Draw(ak_ctx, tb_surf, total_w, tb_h)

        DebugLog_Push("tb.cr.6", 7)

        // Store toolbar references in WinMgr
        WinMgr_SetToolbar(idx, tb_surf)
        WinMgr_SetToolbarH(idx, tb_h)
        WinMgr_SetToolbarCtx(idx, ak_ctx)

        wx = Win_GetX(idx)
        wy = Win_GetY(idx)
        ww = Win_GetTotalW(idx)
        wh = Win_GetTotalH(idx)
        Win_SetGeom(idx, wx, wy, ww, wh)

        PrintMessage("[Toolbar] created for win ")
        PrintNumber(idx)
        PrintMessage(" w=")
        PrintNumber(total_w)
        PrintMessage(" h=")
        PrintNumber(tb_h)
        PrintMessage("\n")

        ReturnValue(1)
    }
}


// =============================================================================
// WIN_TOOLBAREVENT — dispatch mouse event into a window's toolbar
// Mirrors Deskbar_Event exactly: dispatch/redraw/capture/push
// =============================================================================
Function.Win_ToolbarEvent {
    Input: idx: Integer
    Input: screen_x: Integer
    Input: screen_y: Integer
    Input: mouse_ev: Integer
    Output: Integer
    Body: {
        DebugLog_Push("tb.ev", 5)
        ak_ctx = WinMgr_GetToolbarCtx(idx)
        IfCondition EqualTo(ak_ctx, 0) ThenBlock: { ReturnValue(0) }

        tb_surf = WinMgr_GetToolbar(idx)
        IfCondition LessThan(tb_surf, 0) ThenBlock: { ReturnValue(0) }

        tb_h = WinMgr_GetToolbarH(idx)
        IfCondition LessEqual(tb_h, 0) ThenBlock: { ReturnValue(0) }

        total_w = Win_GetTotalW(idx)

        // Convert screen coords to toolbar-local
        wx = Win_GetX(idx)
        wy = Win_GetY(idx)
        local_x = Subtract(screen_x, wx)
        local_y = Subtract(screen_y, Subtract(wy, tb_h))

        // Set action callback on context
        DebugLog_Push("tb.ev.1", 7)
        AK_SetActionCb(ak_ctx, AddressOf(EventRouter_NoOpCallback))
        DebugLog_Push("tb.ev.2", 7)

        // Dispatch
        DebugLog_Push("tb.ev.3", 7)
        AK_EventMouse(ak_ctx, local_x, local_y, mouse_ev)
        DebugLog_Push("tb.ev.4", 7)

        // Redraw if dirty
        drew = 0
        IfCondition GreaterThan(AK_GetDirtyCount(ak_ctx), 0) ThenBlock: {
            VFont_UseSize(UIScale.font_body)
            DebugLog_Push("tb.ev.5", 7)
            Draw_Pix_FillRect(tb_surf, 0, 0, total_w, tb_h, Theme.toolbar_bg)
            DebugLog_Push("tb.ev.6", 7)
            AK_Draw(ak_ctx, tb_surf, total_w, tb_h)
            drew = 1
        }

        // Capture action on UP
        fired_ptr = 0
        fired_len = 0
        IfCondition EqualTo(mouse_ev, AKMouseEv.UP) ThenBlock: {
            fn = AK_GetFocusNode(ak_ctx)
            IfCondition GreaterEqual(fn, 0) ThenBlock: {
                ap = AK_ExtraGet(ak_ctx, fn, AKExtra.ACTION_PTR)
                al = AK_ExtraGet(ak_ctx, fn, AKExtra.ACTION_LEN)
                IfCondition And(NotEqual(ap, 0), GreaterThan(al, 0)) ThenBlock: {
                    fired_ptr = ap
                    fired_len = al
                }
            }
        }

        DebugLog_Push("tb.ev.7", 7)
        DebugLog_Push("tb.ev.8", 7)

        // Push action to EventRouter
        IfCondition NotEqual(fired_ptr, 0) ThenBlock: {
            DebugLog_Push("tb.ev.9", 7)
            EventRouter_Push(fired_ptr, fired_len, idx)
        }

        IfCondition EqualTo(drew, 1) ThenBlock: {
            SysDisplayState.dirty = 1
        }

        ReturnValue(drew)
    }
}


// =============================================================================
// WIN_BUILDDEFAULTTOOLBAR — build AK tree: File | Edit | View | Help | [spacer] | App | X
// Takes AKContext handle; no swapping needed.
// Mirrors Deskbar_BuildTree structure.
// =============================================================================
Function.Win_BuildDefaultToolbar {
    Input: ctx: LinkagePool.AKContext
    Output: Integer
    Body: {
        DebugLog_Push("tb.bld", 6)
        root = AK_CreateNode(ctx, AKTag.GROUP)
        IfCondition LessThan(root, 0) ThenBlock: { ReturnValue(-1) }
        AK_Set(ctx, root, AKF.LAYOUT_MODE, AKLayout.HBOX)
        AK_Set(ctx, root, AKF.GAP, 2)
        AK_Set(ctx, root, AKF.PAD_T, 0)
        AK_Set(ctx, root, AKF.PAD_R, 0)
        AK_Set(ctx, root, AKF.PAD_B, 0)
        AK_Set(ctx, root, AKF.PAD_L, 0)
        AK_ExtraSet(ctx, root, AKExtra.COLOR_BG, Theme.toolbar_bg)
        AK_SetRoot(ctx, root)

        btn_file = AK_CreateNode(ctx, AKTag.BUTTON)
        AK_Set(ctx, btn_file, AKF.MIN_W, UIScale.toolbar_btn_w)
        AK_Set(ctx, btn_file, AKF.HEIGHT, UIScale.toolbar_btn_h)
        AK_ExtraSet(ctx, btn_file, AKExtra.STR_PTR, "File")
        AK_ExtraSet(ctx, btn_file, AKExtra.STR_LEN, 4)
        AK_ExtraSet(ctx, btn_file, AKExtra.ACTION_PTR, "menu:file")
        AK_ExtraSet(ctx, btn_file, AKExtra.ACTION_LEN, 9)
        AK_ExtraSet(ctx, btn_file, AKExtra.TEXT_ALIGN, TRAlign.CENTER)
        AK_AddChild(ctx, root, btn_file)

        btn_edit = AK_CreateNode(ctx, AKTag.BUTTON)
        AK_Set(ctx, btn_edit, AKF.MIN_W, UIScale.toolbar_btn_w)
        AK_Set(ctx, btn_edit, AKF.HEIGHT, UIScale.toolbar_btn_h)
        AK_ExtraSet(ctx, btn_edit, AKExtra.STR_PTR, "Edit")
        AK_ExtraSet(ctx, btn_edit, AKExtra.STR_LEN, 4)
        AK_ExtraSet(ctx, btn_edit, AKExtra.ACTION_PTR, "menu:edit")
        AK_ExtraSet(ctx, btn_edit, AKExtra.ACTION_LEN, 9)
        AK_ExtraSet(ctx, btn_edit, AKExtra.TEXT_ALIGN, TRAlign.CENTER)
        AK_AddChild(ctx, root, btn_edit)

        btn_view = AK_CreateNode(ctx, AKTag.BUTTON)
        AK_Set(ctx, btn_view, AKF.MIN_W, UIScale.toolbar_btn_w)
        AK_Set(ctx, btn_view, AKF.HEIGHT, UIScale.toolbar_btn_h)
        AK_ExtraSet(ctx, btn_view, AKExtra.STR_PTR, "View")
        AK_ExtraSet(ctx, btn_view, AKExtra.STR_LEN, 4)
        AK_ExtraSet(ctx, btn_view, AKExtra.ACTION_PTR, "menu:view")
        AK_ExtraSet(ctx, btn_view, AKExtra.ACTION_LEN, 9)
        AK_ExtraSet(ctx, btn_view, AKExtra.TEXT_ALIGN, TRAlign.CENTER)
        AK_AddChild(ctx, root, btn_view)

        btn_help = AK_CreateNode(ctx, AKTag.BUTTON)
        AK_Set(ctx, btn_help, AKF.MIN_W, UIScale.toolbar_btn_w)
        AK_Set(ctx, btn_help, AKF.HEIGHT, UIScale.toolbar_btn_h)
        AK_ExtraSet(ctx, btn_help, AKExtra.STR_PTR, "Help")
        AK_ExtraSet(ctx, btn_help, AKExtra.STR_LEN, 4)
        AK_ExtraSet(ctx, btn_help, AKExtra.ACTION_PTR, "menu:help")
        AK_ExtraSet(ctx, btn_help, AKExtra.ACTION_LEN, 9)
        AK_ExtraSet(ctx, btn_help, AKExtra.TEXT_ALIGN, TRAlign.CENTER)
        AK_AddChild(ctx, root, btn_help)

        spc = AK_CreateNode(ctx, AKTag.SPACER)
        AK_Set(ctx, spc, AKF.GROW, 1)
        AK_AddChild(ctx, root, spc)

        // Minimize button
        btn_min = AK_CreateNode(ctx, AKTag.BUTTON)
        AK_Set(ctx, btn_min, AKF.MIN_W, UIScale.toolbar_close_w)
        AK_Set(ctx, btn_min, AKF.HEIGHT, UIScale.toolbar_btn_h)
        AK_ExtraSet(ctx, btn_min, AKExtra.STR_PTR, "_")
        AK_ExtraSet(ctx, btn_min, AKExtra.STR_LEN, 1)
        AK_ExtraSet(ctx, btn_min, AKExtra.ACTION_PTR, "win.min")
        AK_ExtraSet(ctx, btn_min, AKExtra.ACTION_LEN, 7)
        AK_ExtraSet(ctx, btn_min, AKExtra.COLOR_BG, Theme.toolbar_min_bg)
        AK_ExtraSet(ctx, btn_min, AKExtra.COLOR_FG, Theme.toolbar_close_fg)
        AK_ExtraSet(ctx, btn_min, AKExtra.TEXT_ALIGN, TRAlign.CENTER)
        AK_AddChild(ctx, root, btn_min)

        // Maximize button
        btn_max = AK_CreateNode(ctx, AKTag.BUTTON)
        AK_Set(ctx, btn_max, AKF.MIN_W, UIScale.toolbar_close_w)
        AK_Set(ctx, btn_max, AKF.HEIGHT, UIScale.toolbar_btn_h)
        AK_ExtraSet(ctx, btn_max, AKExtra.STR_PTR, "O")
        AK_ExtraSet(ctx, btn_max, AKExtra.STR_LEN, 1)
        AK_ExtraSet(ctx, btn_max, AKExtra.ACTION_PTR, "win.max")
        AK_ExtraSet(ctx, btn_max, AKExtra.ACTION_LEN, 7)
        AK_ExtraSet(ctx, btn_max, AKExtra.COLOR_BG, Theme.toolbar_max_bg)
        AK_ExtraSet(ctx, btn_max, AKExtra.COLOR_FG, Theme.toolbar_close_fg)
        AK_ExtraSet(ctx, btn_max, AKExtra.TEXT_ALIGN, TRAlign.CENTER)
        AK_AddChild(ctx, root, btn_max)

        // Close button
        btn_close = AK_CreateNode(ctx, AKTag.BUTTON)
        AK_Set(ctx, btn_close, AKF.MIN_W, UIScale.toolbar_close_w)
        AK_Set(ctx, btn_close, AKF.HEIGHT, UIScale.toolbar_btn_h)
        AK_ExtraSet(ctx, btn_close, AKExtra.STR_PTR, "X")
        AK_ExtraSet(ctx, btn_close, AKExtra.STR_LEN, 1)
        AK_ExtraSet(ctx, btn_close, AKExtra.ACTION_PTR, "win.close")
        AK_ExtraSet(ctx, btn_close, AKExtra.ACTION_LEN, 9)
        AK_ExtraSet(ctx, btn_close, AKExtra.COLOR_BG, Theme.toolbar_close_bg)
        AK_ExtraSet(ctx, btn_close, AKExtra.COLOR_FG, Theme.toolbar_close_fg)
        AK_ExtraSet(ctx, btn_close, AKExtra.TEXT_ALIGN, TRAlign.CENTER)
        AK_AddChild(ctx, root, btn_close)

        PrintMessage("[Toolbar] tree built: ")
        PrintNumber(ctx@tree_count)
        PrintMessage(" nodes\n")
        ReturnValue(root)
    }
}


// =============================================================================
// WIN_BUILDAPPTOOLBAR — build toolbar tree from mode flags
//
// TBMode.NONE  (0) = no toolbar (caller should not call this)
// TBMode.ABOUT (1) = [About] [spacer] [_] [O] [X]
// TBMode.FILE  (2) = [File] [About] [spacer] [_] [O] [X]
// TBMode.FULL  (3) = [File] [Edit] [View] [About] [spacer] [_] [O] [X]
// =============================================================================
Function.Win_BuildAppToolbar {
    Input: ctx: LinkagePool.AKContext
    Input: mode: Integer
    Input: app_title: Address
    Output: Integer
    Body: {
        DebugLog_Push("tb.bap", 6)
        root = AK_CreateNode(ctx, AKTag.GROUP)
        IfCondition LessThan(root, 0) ThenBlock: { ReturnValue(-1) }
        AK_Set(ctx, root, AKF.LAYOUT_MODE, AKLayout.HBOX)
        AK_Set(ctx, root, AKF.GAP, 2)
        AK_Set(ctx, root, AKF.PAD_T, 0)
        AK_Set(ctx, root, AKF.PAD_R, 0)
        AK_Set(ctx, root, AKF.PAD_B, 0)
        AK_Set(ctx, root, AKF.PAD_L, 0)
        AK_ExtraSet(ctx, root, AKExtra.COLOR_BG, Theme.toolbar_bg)
        AK_SetRoot(ctx, root)

        // File button — mode FILE or FULL
        IfCondition GreaterEqual(mode, TBMode.FILE) ThenBlock: {
            btn_file = AK_CreateNode(ctx, AKTag.BUTTON)
            AK_Set(ctx, btn_file, AKF.MIN_W, UIScale.toolbar_btn_w)
            AK_Set(ctx, btn_file, AKF.HEIGHT, UIScale.toolbar_btn_h)
            AK_ExtraSet(ctx, btn_file, AKExtra.STR_PTR, "File")
            AK_ExtraSet(ctx, btn_file, AKExtra.STR_LEN, 4)
            AK_ExtraSet(ctx, btn_file, AKExtra.ACTION_PTR, "menu:file")
            AK_ExtraSet(ctx, btn_file, AKExtra.ACTION_LEN, 9)
            AK_ExtraSet(ctx, btn_file, AKExtra.TEXT_ALIGN, TRAlign.CENTER)
            AK_AddChild(ctx, root, btn_file)
        }

        // Edit button — mode FULL only
        IfCondition GreaterEqual(mode, TBMode.FULL) ThenBlock: {
            btn_edit = AK_CreateNode(ctx, AKTag.BUTTON)
            AK_Set(ctx, btn_edit, AKF.MIN_W, UIScale.toolbar_btn_w)
            AK_Set(ctx, btn_edit, AKF.HEIGHT, UIScale.toolbar_btn_h)
            AK_ExtraSet(ctx, btn_edit, AKExtra.STR_PTR, "Edit")
            AK_ExtraSet(ctx, btn_edit, AKExtra.STR_LEN, 4)
            AK_ExtraSet(ctx, btn_edit, AKExtra.ACTION_PTR, "menu:edit")
            AK_ExtraSet(ctx, btn_edit, AKExtra.ACTION_LEN, 9)
            AK_ExtraSet(ctx, btn_edit, AKExtra.TEXT_ALIGN, TRAlign.CENTER)
            AK_AddChild(ctx, root, btn_edit)

            btn_view = AK_CreateNode(ctx, AKTag.BUTTON)
            AK_Set(ctx, btn_view, AKF.MIN_W, UIScale.toolbar_btn_w)
            AK_Set(ctx, btn_view, AKF.HEIGHT, UIScale.toolbar_btn_h)
            AK_ExtraSet(ctx, btn_view, AKExtra.STR_PTR, "View")
            AK_ExtraSet(ctx, btn_view, AKExtra.STR_LEN, 4)
            AK_ExtraSet(ctx, btn_view, AKExtra.ACTION_PTR, "menu:view")
            AK_ExtraSet(ctx, btn_view, AKExtra.ACTION_LEN, 9)
            AK_ExtraSet(ctx, btn_view, AKExtra.TEXT_ALIGN, TRAlign.CENTER)
            AK_AddChild(ctx, root, btn_view)
        }

        // About button — always present (mandatory minimum)
        btn_about = AK_CreateNode(ctx, AKTag.BUTTON)
        AK_Set(ctx, btn_about, AKF.MIN_W, UIScale.toolbar_btn_w)
        AK_Set(ctx, btn_about, AKF.HEIGHT, UIScale.toolbar_btn_h)
        AK_ExtraSet(ctx, btn_about, AKExtra.STR_PTR, "About")
        AK_ExtraSet(ctx, btn_about, AKExtra.STR_LEN, 5)
        AK_ExtraSet(ctx, btn_about, AKExtra.ACTION_PTR, "app.about")
        AK_ExtraSet(ctx, btn_about, AKExtra.ACTION_LEN, 9)
        AK_ExtraSet(ctx, btn_about, AKExtra.TEXT_ALIGN, TRAlign.CENTER)
        AK_AddChild(ctx, root, btn_about)

        // Spacer
        spc = AK_CreateNode(ctx, AKTag.SPACER)
        AK_Set(ctx, spc, AKF.GROW, 1)
        AK_AddChild(ctx, root, spc)

        // Minimize button
        btn_min = AK_CreateNode(ctx, AKTag.BUTTON)
        AK_Set(ctx, btn_min, AKF.MIN_W, UIScale.toolbar_close_w)
        AK_Set(ctx, btn_min, AKF.HEIGHT, UIScale.toolbar_btn_h)
        AK_ExtraSet(ctx, btn_min, AKExtra.STR_PTR, "_")
        AK_ExtraSet(ctx, btn_min, AKExtra.STR_LEN, 1)
        AK_ExtraSet(ctx, btn_min, AKExtra.ACTION_PTR, "win.min")
        AK_ExtraSet(ctx, btn_min, AKExtra.ACTION_LEN, 7)
        AK_ExtraSet(ctx, btn_min, AKExtra.COLOR_BG, Theme.toolbar_min_bg)
        AK_ExtraSet(ctx, btn_min, AKExtra.COLOR_FG, Theme.toolbar_close_fg)
        AK_ExtraSet(ctx, btn_min, AKExtra.TEXT_ALIGN, TRAlign.CENTER)
        AK_AddChild(ctx, root, btn_min)

        // Maximize button
        btn_max = AK_CreateNode(ctx, AKTag.BUTTON)
        AK_Set(ctx, btn_max, AKF.MIN_W, UIScale.toolbar_close_w)
        AK_Set(ctx, btn_max, AKF.HEIGHT, UIScale.toolbar_btn_h)
        AK_ExtraSet(ctx, btn_max, AKExtra.STR_PTR, "O")
        AK_ExtraSet(ctx, btn_max, AKExtra.STR_LEN, 1)
        AK_ExtraSet(ctx, btn_max, AKExtra.ACTION_PTR, "win.max")
        AK_ExtraSet(ctx, btn_max, AKExtra.ACTION_LEN, 7)
        AK_ExtraSet(ctx, btn_max, AKExtra.COLOR_BG, Theme.toolbar_max_bg)
        AK_ExtraSet(ctx, btn_max, AKExtra.COLOR_FG, Theme.toolbar_close_fg)
        AK_ExtraSet(ctx, btn_max, AKExtra.TEXT_ALIGN, TRAlign.CENTER)
        AK_AddChild(ctx, root, btn_max)

        // Close button
        btn_close = AK_CreateNode(ctx, AKTag.BUTTON)
        AK_Set(ctx, btn_close, AKF.MIN_W, UIScale.toolbar_close_w)
        AK_Set(ctx, btn_close, AKF.HEIGHT, UIScale.toolbar_btn_h)
        AK_ExtraSet(ctx, btn_close, AKExtra.STR_PTR, "X")
        AK_ExtraSet(ctx, btn_close, AKExtra.STR_LEN, 1)
        AK_ExtraSet(ctx, btn_close, AKExtra.ACTION_PTR, "win.close")
        AK_ExtraSet(ctx, btn_close, AKExtra.ACTION_LEN, 9)
        AK_ExtraSet(ctx, btn_close, AKExtra.COLOR_BG, Theme.toolbar_close_bg)
        AK_ExtraSet(ctx, btn_close, AKExtra.COLOR_FG, Theme.toolbar_close_fg)
        AK_ExtraSet(ctx, btn_close, AKExtra.TEXT_ALIGN, TRAlign.CENTER)
        AK_AddChild(ctx, root, btn_close)

        PrintMessage("[Toolbar] app tree built: ")
        PrintNumber(ctx@tree_count)
        PrintMessage(" nodes, mode=")
        PrintNumber(mode)
        PrintMessage("\n")
        ReturnValue(root)
    }
}

// =============================================================================
// WIN_CREATETOOLBARAPP — create toolbar for an app window from mode flags
//
// Like Win_CreateToolbarDefault but uses Win_BuildAppToolbar instead.
// mode = TBMode constant, app_title = display name for right-side label
// =============================================================================
Function.Win_CreateToolbarApp {
    Input: idx: Integer
    Input: mode: Integer
    Input: app_title: Address
    Output: Integer
    Body: {
        DebugLog_Push("tb.cra", 6)
        IfCondition EqualTo(idx, 0) ThenBlock: { ReturnValue(0) }

        // No toolbar requested
        IfCondition EqualTo(mode, TBMode.NONE) ThenBlock: {
            PrintMessage("[Toolbar] mode=none, skipping\n")
            ReturnValue(1)
        }

        total_w = Win_GetTotalW(idx)
        tb_h = UIScale.toolbar_h

        // Create toolbar surface
        tb_surf = Surface_Create(SurfaceFormat.PIXEL_32, total_w, tb_h)
        IfCondition EqualTo(tb_surf, 0) ThenBlock: {
            PrintMessage("[Toolbar] surface alloc failed\n")
            ReturnValue(0)
        }

        // Allocate AK context for toolbar
        ak_ctx = AK_CreateContext()
        IfCondition EqualTo(ak_ctx, 0) ThenBlock: {
            PrintMessage("[Toolbar] AKContext alloc failed\n")
            ReturnValue(0)
        }

        AK_SetDesignW(ak_ctx, total_w)
        AK_SetDesignH(ak_ctx, tb_h)

        // Build tree from mode flags
        Win_BuildAppToolbar(ak_ctx, mode, app_title)

        Draw_Pix_FillRect(tb_surf, 0, 0, total_w, tb_h, Theme.toolbar_bg)
        AK_Draw(ak_ctx, tb_surf, total_w, tb_h)

        // Store toolbar references in WinMgr
        WinMgr_SetToolbar(idx, tb_surf)
        WinMgr_SetToolbarH(idx, tb_h)
        WinMgr_SetToolbarCtx(idx, ak_ctx)

        wx = Win_GetX(idx)
        wy = Win_GetY(idx)
        ww = Win_GetTotalW(idx)
        wh = Win_GetTotalH(idx)
        Win_SetGeom(idx, wx, wy, ww, wh)

        ReturnValue(1)
    }
}

// =============================================================================
// WIN_REDRAWTOOLBAR — re-render toolbar surface from its AK context
// =============================================================================
Function.Win_RedrawToolbar {
    Input: idx: Integer
    Output: Integer
    Body: {
        DebugLog_Push("tb.red", 6)
        ak_ctx = WinMgr_GetToolbarCtx(idx)
        IfCondition EqualTo(ak_ctx, 0) ThenBlock: { ReturnValue(0) }

        tb_surf = WinMgr_GetToolbar(idx)
        IfCondition LessThan(tb_surf, 0) ThenBlock: { ReturnValue(0) }

        total_w = Win_GetTotalW(idx)
        tb_h    = WinMgr_GetToolbarH(idx)

        // Update design dimensions to match new size (prevents scale distortion)
        AK_SetDesignW(ak_ctx, total_w)
        AK_SetDesignH(ak_ctx, tb_h)

        DebugLog_Push("tb.red.1", 8)
        DebugLog_Push("tb.red.2", 8)
        Draw_Pix_FillRect(tb_surf, 0, 0, total_w, tb_h, Theme.toolbar_bg)
        DebugLog_Push("tb.red.3", 8)
        AK_Draw(ak_ctx, tb_surf, total_w, tb_h)
        DebugLog_Push("tb.red.4", 8)

        ReturnValue(1)
    }
}


// =============================================================================
// WIN_CONTENTEVENT — generic content-area event routing
//
// Routes mouse events to a window's content AKContext (if registered).
// The AKContext's action_cb handles app-specific actions internally.
// Returns 1 if content was redrawn, 0 otherwise.
// =============================================================================
Function.Win_ContentEvent {
    Input: idx: Integer
    Input: sx: Integer
    Input: sy: Integer
    Input: ev: Integer
    Output: Integer
    Body: {
        DebugLog_Push("ct.ev", 5)
        content_ctx = WinView_GetContentCtx(idx)
        IfCondition EqualTo(content_ctx, 0) ThenBlock: { ReturnValue(0) }

        // Convert screen coords to content-local
        // Content surface is blitted at (wx + bw, wy + bw)
        wx = Win_GetX(idx)
        wy = Win_GetY(idx)
        bw = DecorConfig.border_w
        local_x = Subtract(sx, Add(wx, bw))
        local_y = Subtract(sy, Add(wy, bw))

        // Dispatch to Auckland (action_cb fires inside on UP)
        AK_EventMouse(content_ctx, local_x, local_y, ev)

        // Redraw if any nodes changed state
        drew = 0
        IfCondition GreaterThan(AK_GetDirtyCount(content_ctx), 0) ThenBlock: {
            content_surf = WinMgr_GetContent(idx)
            cw = Win_GetCanvasW(idx)
            ch = Win_GetCanvasH(idx)
            AK_SetDesignW(content_ctx, cw)
            AK_SetDesignH(content_ctx, ch)
            AK_Draw(content_ctx, content_surf, cw, ch)
            drew = 1
        }

        ReturnValue(drew)
    }
}
