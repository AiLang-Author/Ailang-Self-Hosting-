LibraryImport.DSurfaceTypes
LibraryImport.DSurface
LibraryImport.DDrawPixel
LibraryImport.WinManager
LibraryImport.Auckland
LibraryImport.AucklandEvent
LibraryImport.AKSlot
LibraryImport.EventRouter
LibraryImport.VIF
LibraryImport.Fonts
LibraryImport.TextRegion


// =============================================================================
// WIN_CREATETOOLBARDEFAULT — create toolbar for a window
// Mirrors Deskbar_Init: create ctx, save, swap in, build, render, swap out, restore.
// =============================================================================
Function.Win_CreateToolbarDefault {
    Input: idx: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(idx, 0) ThenBlock: { ReturnValue(0) }

        total_w = Win_GetTotalW(idx)
        tb_h = 24

        // Create toolbar surface
        tb_surf = Surface_Create(SurfaceFormat.PIXEL_32, total_w, tb_h)
        IfCondition EqualTo(tb_surf, 0) ThenBlock: {
            PrintMessage("[Toolbar] surface alloc failed\n")
            ReturnValue(0)
        }

        // Allocate AK slot for toolbar
        ak_slot = AKSlot_Alloc()
        IfCondition LessThan(ak_slot, 0) ThenBlock: {
            PrintMessage("[Toolbar] AKSlot alloc failed\n")
            ReturnValue(0)
        }

        // Swap in, build, render, swap out
        AKSlot_SwapIn(ak_slot)

        Win_BuildDefaultToolbar()

        Draw_Pix_FillRect(tb_surf, 0, 0, total_w, tb_h, 0xFF2A2A2A)
        AK_Draw(tb_surf, total_w, tb_h)

        AKSlot_SwapOut()

        // Store toolbar references in WinMgr
        WinMgr_SetToolbar(idx, tb_surf)
        WinMgr_SetToolbarH(idx, tb_h)
        WinMgr_SetToolbarSlot(idx, ak_slot)

        wx = Win_GetX(idx)
        wy = Win_GetY(idx)
        ww = Win_GetTotalW(idx)
        wh = Win_GetTotalH(idx)
        Win_SetGeom(idx, wx, wy, ww, wh)

        PrintMessage("[Toolbar] created for win ")
        PrintNumber(idx)
        PrintMessage(" w=")
        PrintNumber(total_w)
        PrintMessage(" h=")
        PrintNumber(tb_h)
        PrintMessage("\n")

        ReturnValue(1)
    }
}


// =============================================================================
// WIN_TOOLBAREVENT — dispatch mouse event into a window's toolbar
// Mirrors Deskbar_Event exactly: save/swap/dispatch/redraw/capture/swap/restore/push
// =============================================================================
Function.Win_ToolbarEvent {
    Input: idx: Integer
    Input: screen_x: Integer
    Input: screen_y: Integer
    Input: mouse_ev: Integer
    Output: Integer
    Body: {
        ak_slot = WinMgr_GetToolbarSlot(idx)
        IfCondition LessThan(ak_slot, 0) ThenBlock: { ReturnValue(0) }

        tb_surf = WinMgr_GetToolbar(idx)
        IfCondition LessThan(tb_surf, 0) ThenBlock: { ReturnValue(0) }

        tb_h = WinMgr_GetToolbarH(idx)
        IfCondition LessEqual(tb_h, 0) ThenBlock: { ReturnValue(0) }

        total_w = Win_GetTotalW(idx)

        // Convert screen coords to toolbar-local
        wx = Win_GetX(idx)
        wy = Win_GetY(idx)
        local_x = Subtract(screen_x, wx)
        local_y = Subtract(screen_y, Subtract(wy, tb_h))

        // Swap in toolbar context
        AKSlot_SwapIn(ak_slot)
        AKEvent.action_callback = AddressOf(EventRouter_NoOpCallback)

        // Dispatch
        AK_EventMouse(local_x, local_y, mouse_ev)

        // Redraw if dirty
        drew = 0
        IfCondition GreaterThan(AKEvent.dirty_count, 0) ThenBlock: {
            VFont_RasterAll(18)
            Draw_Pix_FillRect(tb_surf, 0, 0, total_w, tb_h, 0xFF2A2A2A)
            AK_Draw(tb_surf, total_w, tb_h)
            drew = 1
        }

        // Capture action on UP
        fired_ptr = 0
        fired_len = 0
        IfCondition EqualTo(mouse_ev, AKMouseEv.UP) ThenBlock: {
            fn = AKEvent.focus_node
            IfCondition GreaterEqual(fn, 0) ThenBlock: {
                ap = AK_ExtraGet(fn, AKExtra.ACTION_PTR)
                al = AK_ExtraGet(fn, AKExtra.ACTION_LEN)
                IfCondition And(NotEqual(ap, 0), GreaterThan(al, 0)) ThenBlock: {
                    fired_ptr = ap
                    fired_len = al
                }
            }
        }

        // Swap out toolbar context (restores main automatically)
        AKSlot_SwapOut()

        // Push action to EventRouter
        IfCondition NotEqual(fired_ptr, 0) ThenBlock: {
            EventRouter_Push(fired_ptr, fired_len, idx)
        }

        IfCondition EqualTo(drew, 1) ThenBlock: {
            SysDisplayState.dirty = 1
        }

        ReturnValue(drew)
    }
}


// =============================================================================
// WIN_BUILDDEFAULTTOOLBAR — build AK tree: File | Edit | View | Help | [spacer] | App | X
// Called while toolbar AKCtx is swapped in.
// Mirrors Deskbar_BuildTree structure.
// =============================================================================
Function.Win_BuildDefaultToolbar {
    Output: Integer
    Body: {
        root = AK_CreateNode(AKTag.GROUP)
        IfCondition LessThan(root, 0) ThenBlock: { ReturnValue(-1) }
        AK_Set(root, AKF.LAYOUT_MODE, AKLayout.HBOX)
        AK_Set(root, AKF.GAP, 0)
        AK_Set(root, AKF.PAD_T, 0)
        AK_Set(root, AKF.PAD_R, 0)
        AK_Set(root, AKF.PAD_B, 0)
        AK_Set(root, AKF.PAD_L, 0)
        AK_ExtraSet(root, AKExtra.COLOR_BG, TVG_PackColor(42, 42, 42, 255))
        AK_SetRoot(root)

        btn_file = AK_CreateNode(AKTag.BUTTON)
        AK_Set(btn_file, AKF.MIN_W, 48)
        AK_Set(btn_file, AKF.HEIGHT, 24)
        AK_ExtraSet(btn_file, AKExtra.STR_PTR, "File")
        AK_ExtraSet(btn_file, AKExtra.STR_LEN, 4)
        AK_ExtraSet(btn_file, AKExtra.ACTION_PTR, "menu:file")
        AK_ExtraSet(btn_file, AKExtra.ACTION_LEN, 9)
        AK_ExtraSet(btn_file, AKExtra.TEXT_ALIGN, TRAlign.CENTER)
        AK_AddChild(root, btn_file)

        btn_edit = AK_CreateNode(AKTag.BUTTON)
        AK_Set(btn_edit, AKF.MIN_W, 48)
        AK_Set(btn_edit, AKF.HEIGHT, 24)
        AK_ExtraSet(btn_edit, AKExtra.STR_PTR, "Edit")
        AK_ExtraSet(btn_edit, AKExtra.STR_LEN, 4)
        AK_ExtraSet(btn_edit, AKExtra.ACTION_PTR, "menu:edit")
        AK_ExtraSet(btn_edit, AKExtra.ACTION_LEN, 9)
        AK_ExtraSet(btn_edit, AKExtra.TEXT_ALIGN, TRAlign.CENTER)
        AK_AddChild(root, btn_edit)

        btn_view = AK_CreateNode(AKTag.BUTTON)
        AK_Set(btn_view, AKF.MIN_W, 48)
        AK_Set(btn_view, AKF.HEIGHT, 24)
        AK_ExtraSet(btn_view, AKExtra.STR_PTR, "View")
        AK_ExtraSet(btn_view, AKExtra.STR_LEN, 4)
        AK_ExtraSet(btn_view, AKExtra.ACTION_PTR, "menu:view")
        AK_ExtraSet(btn_view, AKExtra.ACTION_LEN, 9)
        AK_ExtraSet(btn_view, AKExtra.TEXT_ALIGN, TRAlign.CENTER)
        AK_AddChild(root, btn_view)

        btn_help = AK_CreateNode(AKTag.BUTTON)
        AK_Set(btn_help, AKF.MIN_W, 48)
        AK_Set(btn_help, AKF.HEIGHT, 24)
        AK_ExtraSet(btn_help, AKExtra.STR_PTR, "Help")
        AK_ExtraSet(btn_help, AKExtra.STR_LEN, 4)
        AK_ExtraSet(btn_help, AKExtra.ACTION_PTR, "menu:help")
        AK_ExtraSet(btn_help, AKExtra.ACTION_LEN, 9)
        AK_ExtraSet(btn_help, AKExtra.TEXT_ALIGN, TRAlign.CENTER)
        AK_AddChild(root, btn_help)

        spc = AK_CreateNode(AKTag.SPACER)
        AK_Set(spc, AKF.GROW, 1)
        AK_AddChild(root, spc)

        lbl = AK_CreateNode(AKTag.LABEL)
        AK_Set(lbl, AKF.HEIGHT, 24)
        AK_ExtraSet(lbl, AKExtra.STR_PTR, "Application")
        AK_ExtraSet(lbl, AKExtra.STR_LEN, 11)
        AK_ExtraSet(lbl, AKExtra.TEXT_ALIGN, TRAlign.RIGHT)
        AK_ExtraSet(lbl, AKExtra.COLOR_FG, TVG_PackColor(136, 136, 136, 255))
        AK_ExtraSet(lbl, AKExtra.FONT_SIZE, 12)
        AK_AddChild(root, lbl)

        btn_close = AK_CreateNode(AKTag.BUTTON)
        AK_Set(btn_close, AKF.MIN_W, 28)
        AK_Set(btn_close, AKF.HEIGHT, 24)
        AK_ExtraSet(btn_close, AKExtra.STR_PTR, "X")
        AK_ExtraSet(btn_close, AKExtra.STR_LEN, 1)
        AK_ExtraSet(btn_close, AKExtra.ACTION_PTR, "win.close")
        AK_ExtraSet(btn_close, AKExtra.ACTION_LEN, 9)
        AK_ExtraSet(btn_close, AKExtra.COLOR_BG, TVG_PackColor(200, 40, 40, 255))
        AK_ExtraSet(btn_close, AKExtra.COLOR_FG, TVG_PackColor(255, 255, 255, 255))
        AK_ExtraSet(btn_close, AKExtra.TEXT_ALIGN, TRAlign.CENTER)
        AK_AddChild(root, btn_close)

        PrintMessage("[Toolbar] tree built: ")
        PrintNumber(AKTree.count)
        PrintMessage(" nodes\n")
        ReturnValue(root)
    }
}


// =============================================================================
// WIN_REDRAWTOOLBAR — re-render toolbar surface from its AK context
// =============================================================================
Function.Win_RedrawToolbar {
    Input: idx: Integer
    Output: Integer
    Body: {
        ak_slot = WinMgr_GetToolbarSlot(idx)
        IfCondition LessThan(ak_slot, 0) ThenBlock: { ReturnValue(0) }

        tb_surf = WinMgr_GetToolbar(idx)
        IfCondition LessThan(tb_surf, 0) ThenBlock: { ReturnValue(0) }

        total_w = Win_GetTotalW(idx)
        tb_h    = WinMgr_GetToolbarH(idx)

        AKSlot_SwapIn(ak_slot)
        Draw_Pix_FillRect(tb_surf, 0, 0, total_w, tb_h, 0xFF2A2A2A)
        AK_Draw(tb_surf, total_w, tb_h)
        AKSlot_SwapOut()

        ReturnValue(1)
    }
}
