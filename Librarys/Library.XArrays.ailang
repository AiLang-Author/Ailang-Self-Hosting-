// Library.XArrays.ailang - Arena-Integrated Version (COMPLETE)
// 
// STRATEGY: Use arena for structs (24, 32, 64 bytes)
// Data storage uses ArrayCreate (proven to work)
//
// CRITICAL: This is the COMPLETE library with ALL functions restored

LibraryImport.Arena

Debug("library.load", level=1) {
    PrintMessage("Loading XArrays Library v2.1 (Arena-Integrated, Complete)\n")
}

// ====================
// Configuration & Constants
// ====================
FixedPool.XArrays {
    "XMAX_ARRAY_SIZE": Initialize=65536
    "XMAX_HASH_BUCKETS": Initialize=127
    "XSTACK_SIZE": Initialize=1024
    "XQUEUE_SIZE": Initialize=1024
    "XNULL": Initialize=-1
    "XERROR": Initialize=-999999
    "arena_initialized": Initialize=0
}

// ====================
// Arena Initialization
// ====================
Function.XArrays_EnsureArena {
    Body: {
        IfCondition EqualTo(XArrays.arena_initialized, 0) ThenBlock: {
            Arena_Init()
            XArrays.arena_initialized = 1
        }
    }
}

// Helper to copy a string
Function.Helpers.StringCopy {
    Input: str: Address
    Output: Address
    Body: {
        IfCondition EqualTo(str, 0) ThenBlock: {
            ReturnValue(0)
        }
        len = StringLength(str)
        new_str = Arena_Alloc(Add(len, 1))
        idx = 0
        WhileLoop LessThan(idx, len) {
            SetByte(new_str, idx, GetByte(str, idx))
            idx = Add(idx, 1)
        }
        SetByte(new_str, len, 0)
        ReturnValue(new_str)
    }
}

// =============================================================================
// DYNAMIC ARRAY OPERATIONS
// =============================================================================

// Create a dynamic array with metadata
// Structure: [capacity:8, size:8, data_ptr:8] = 24 bytes
Function.XArray.XCreate {
    Input: initial_capacity: Integer
    Output: Address
    Body: {
        XArrays_EnsureArena()
        arr_struct = Arena_Alloc24()
        StoreValue(arr_struct, initial_capacity)
        StoreValue(Add(arr_struct, 8), 0)
        data = Arena_ArrayCreate(initial_capacity)
        StoreValue(Add(arr_struct, 16), data)
        ReturnValue(arr_struct)
    }
}

Function.XArray.XSize {
    Input: arr: Address
    Output: Integer
    Body: {
        ReturnValue(Dereference(Add(arr, 8)))
    }
}

Function.XArray.XCapacity {
    Input: arr: Address
    Output: Integer
    Body: {
        ReturnValue(Dereference(arr))
    }
}

Function.XArray.XPush {
    Input: arr: Address
    Input: value: Integer
    Output: Integer
    Body: {
        capacity = Dereference(arr)
        size = Dereference(Add(arr, 8))
        data = Dereference(Add(arr, 16))
        
        IfCondition GreaterEqual(size, capacity) ThenBlock: {
            new_capacity = Multiply(capacity, 2)
            new_data = Arena_ArrayCreate(new_capacity)
            copy_idx = 0
            WhileLoop LessThan(copy_idx, size) {
                old_val = ArrayGet(data, copy_idx)
                ArraySet(new_data, copy_idx, old_val)
                copy_idx = Add(copy_idx, 1)
            }
            Arena_ArrayDestroy(data)
            StoreValue(arr, new_capacity)
            StoreValue(Add(arr, 16), new_data)
            data = new_data
        }
        
        ArraySet(data, size, value)
        StoreValue(Add(arr, 8), Add(size, 1))
        ReturnValue(1)
    }
}

Function.XArray.XPop {
    Input: arr: Address
    Output: Integer
    Body: {
        size = Dereference(Add(arr, 8))
        IfCondition EqualTo(size, 0) ThenBlock: {
            ReturnValue(XArrays.XERROR)
        }
        data = Dereference(Add(arr, 16))
        new_size = Subtract(size, 1)
        value = ArrayGet(data, new_size)
        StoreValue(Add(arr, 8), new_size)
        ReturnValue(value)
    }
}

Function.XArray.XGet {
    Input: arr: Address
    Input: index: Integer
    Output: Integer
    Body: {
        size = Dereference(Add(arr, 8))
        IfCondition Or(LessThan(index, 0), GreaterEqual(index, size)) ThenBlock: {
            ReturnValue(XArrays.XERROR)
        }
        data = Dereference(Add(arr, 16))
        ReturnValue(ArrayGet(data, index))
    }
}

Function.XArray.XSet {
    Input: arr: Address
    Input: index: Integer
    Input: value: Integer
    Output: Integer
    Body: {
        size = Dereference(Add(arr, 8))
        IfCondition Or(LessThan(index, 0), GreaterEqual(index, size)) ThenBlock: {
            ReturnValue(0)
        }
        data = Dereference(Add(arr, 16))
        ArraySet(data, index, value)
        ReturnValue(1)
    }
}

Function.XArray.XClear {
    Input: arr: Address
    Output: Integer
    Body: {
        StoreValue(Add(arr, 8), 0)
        ReturnValue(1)
    }
}

Function.XArray.XDestroy {
    Input: arr: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(arr, 0) ThenBlock: {
            ReturnValue(0)
        }
        data = Dereference(Add(arr, 16))
        Arena_ArrayDestroy(data)
        Arena_Free24(arr)
        ReturnValue(1)
    }
}

// Remove first element and shift all others down (O(n) operation)
Function.XArray.XShift {
    Input: array: Address
    Output: Address
    Body: {
        IfCondition EqualTo(array, 0) ThenBlock: {
            ReturnValue(0)
        }
        size_addr = Add(array, 8)
        size = Dereference(size_addr)
        IfCondition LessEqual(size, 0) ThenBlock: {
            ReturnValue(0)
        }
        first_element = XArray.XGet(array, 0)
        i = 1
        WhileLoop LessThan(i, size) {
            element = XArray.XGet(array, i)
            XArray.XSet(array, Subtract(i, 1), element)
            i = Add(i, 1)
        }
        new_size = Subtract(size, 1)
        StoreValue(size_addr, new_size)
        ReturnValue(first_element)
    }
}

// Find index of first occurrence of value
Function.XArray.XIndexOf {
    Input: arr: Address
    Input: value: Integer
    Output: Integer
    Body: {
        size = Dereference(Add(arr, 8))
        data = Dereference(Add(arr, 16))
        i = 0
        WhileLoop LessThan(i, size) {
            current = ArrayGet(data, i)
            IfCondition EqualTo(current, value) ThenBlock: {
                ReturnValue(i)
            }
            i = Add(i, 1)
        }
        ReturnValue(XArrays.XNULL)
    }
}

// Copy an array
Function.XArray.XCopy {
    Input: arr: Address
    Output: Address
    Body: {
        size = Dereference(Add(arr, 8))
        capacity = Dereference(arr)
        data = Dereference(Add(arr, 16))
        new_arr = XArray.XCreate(capacity)
        new_data = Dereference(Add(new_arr, 16))
        i = 0
        WhileLoop LessThan(i, size) {
            val = ArrayGet(data, i)
            ArraySet(new_data, i, val)
            i = Add(i, 1)
        }
        StoreValue(Add(new_arr, 8), size)
        ReturnValue(new_arr)
    }
}

// Insert element at specific index
Function.XArray.XInsert {
    Input: arr: Address
    Input: index: Integer
    Input: value: Integer
    Output: Integer
    Body: {
        capacity = Dereference(arr)
        size = Dereference(Add(arr, 8))
        data = Dereference(Add(arr, 16))
        
        IfCondition Or(LessThan(index, 0), GreaterThan(index, size)) ThenBlock: {
            ReturnValue(0)
        }
        
        IfCondition GreaterEqual(size, capacity) ThenBlock: {
            new_capacity = Multiply(capacity, 2)
            new_data = Arena_ArrayCreate(new_capacity)
            i = 0
            WhileLoop LessThan(i, size) {
                old_val = ArrayGet(data, i)
                ArraySet(new_data, i, old_val)
                i = Add(i, 1)
            }
            Arena_ArrayDestroy(data)
            StoreValue(arr, new_capacity)
            StoreValue(Add(arr, 16), new_data)
            data = new_data
        }
        
        i = size
        WhileLoop GreaterThan(i, index) {
            prev_val = ArrayGet(data, Subtract(i, 1))
            ArraySet(data, i, prev_val)
            i = Subtract(i, 1)
        }
        ArraySet(data, index, value)
        StoreValue(Add(arr, 8), Add(size, 1))
        ReturnValue(1)
    }
}

// Delete element at specific index
Function.XArray.XDelete {
    Input: arr: Address
    Input: index: Integer
    Output: Integer
    Body: {
        size = Dereference(Add(arr, 8))
        data = Dereference(Add(arr, 16))
        IfCondition Or(LessThan(index, 0), GreaterEqual(index, size)) ThenBlock: {
            ReturnValue(XArrays.XERROR)
        }
        deleted_value = ArrayGet(data, index)
        i = index
        last_idx = Subtract(size, 1)
        WhileLoop LessThan(i, last_idx) {
            next_val = ArrayGet(data, Add(i, 1))
            ArraySet(data, i, next_val)
            i = Add(i, 1)
        }
        StoreValue(Add(arr, 8), Subtract(size, 1))
        ReturnValue(deleted_value)
    }
}

Function.XArray.XContains {
    Input: arr: Address
    Input: value: Integer
    Output: Integer
    Body: {
        idx = XArray.XIndexOf(arr, value)
        IfCondition NotEqual(idx, XArrays.XNULL) ThenBlock: {
            ReturnValue(1)
        }
        ReturnValue(0)
    }
}

Function.XArray.XInsertSorted {
    Input: arr: Address
    Input: value: Integer
    Output: Integer
    Body: {
        size = Dereference(Add(arr, 8))
        data = Dereference(Add(arr, 16))
        insert_idx = size
        i = 0
        found = 0
        WhileLoop And(LessThan(i, size), EqualTo(found, 0)) {
            current = ArrayGet(data, i)
            IfCondition GreaterThan(current, value) ThenBlock: {
                insert_idx = i
                found = 1
            }
            i = Add(i, 1)
        }
        XArray.XInsert(arr, insert_idx, value)
        ReturnValue(insert_idx)
    }
}

Function.XArray.XBinarySearch {
    Input: arr: Address
    Input: value: Integer
    Output: Integer
    Body: {
        size = Dereference(Add(arr, 8))
        data = Dereference(Add(arr, 16))
        left = 0
        right = Subtract(size, 1)
        WhileLoop LessEqual(left, right) {
            mid = Divide(Add(left, right), 2)
            mid_val = ArrayGet(data, mid)
            IfCondition EqualTo(mid_val, value) ThenBlock: {
                ReturnValue(mid)
            }
            IfCondition LessThan(mid_val, value) ThenBlock: {
                left = Add(mid, 1)
            } ElseBlock: {
                right = Subtract(mid, 1)
            }
        }
        ReturnValue(XArrays.XNULL)
    }
}

Function.XArray.XSwap {
    Input: arr: Address
    Input: idx1: Integer
    Input: idx2: Integer
    Output: Integer
    Body: {
        size = Dereference(Add(arr, 8))
        IfCondition Or(LessThan(idx1, 0), GreaterEqual(idx1, size)) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition Or(LessThan(idx2, 0), GreaterEqual(idx2, size)) ThenBlock: {
            ReturnValue(0)
        }
        data = Dereference(Add(arr, 16))
        val1 = ArrayGet(data, idx1)
        val2 = ArrayGet(data, idx2)
        ArraySet(data, idx1, val2)
        ArraySet(data, idx2, val1)
        ReturnValue(1)
    }
}

Function.XArray.XLast {
    Input: arr: Address
    Output: Integer
    Body: {
        size = Dereference(Add(arr, 8))
        IfCondition EqualTo(size, 0) ThenBlock: {
            ReturnValue(XArrays.XERROR)
        }
        data = Dereference(Add(arr, 16))
        ReturnValue(ArrayGet(data, Subtract(size, 1)))
    }
}

Function.XArray.XFirst {
    Input: arr: Address
    Output: Integer
    Body: {
        size = Dereference(Add(arr, 8))
        IfCondition EqualTo(size, 0) ThenBlock: {
            ReturnValue(XArrays.XERROR)
        }
        data = Dereference(Add(arr, 16))
        ReturnValue(ArrayGet(data, 0))
    }
}

Function.XArray.XIsEmpty {
    Input: arr: Address
    Output: Integer
    Body: {
        size = Dereference(Add(arr, 8))
        IfCondition EqualTo(size, 0) ThenBlock: {
            ReturnValue(1)
        }
        ReturnValue(0)
    }
}

Function.XArray.XResize {
    Input: arr: Address
    Input: new_capacity: Integer
    Output: Integer
    Body: {
        old_capacity = Dereference(arr)
        size = Dereference(Add(arr, 8))
        old_data = Dereference(Add(arr, 16))
        IfCondition LessThan(new_capacity, size) ThenBlock: {
            new_capacity = size
        }
        new_data = Arena_ArrayCreate(new_capacity)
        i = 0
        WhileLoop LessThan(i, size) {
            val = ArrayGet(old_data, i)
            ArraySet(new_data, i, val)
            i = Add(i, 1)
        }
        Arena_ArrayDestroy(old_data)
        StoreValue(arr, new_capacity)
        StoreValue(Add(arr, 16), new_data)
        ReturnValue(1)
    }
}

// Address variants for storing pointers
Function.XArray.XInsertAddr {
    Input: arr: Address
    Input: index: Integer
    Input: value: Address
    Output: Integer
    Body: {
        ReturnValue(XArray.XInsert(arr, index, value))
    }
}

Function.XArray.XGetAddr {
    Input: arr: Address
    Input: index: Integer
    Output: Address
    Body: {
        ReturnValue(XArray.XGet(arr, index))
    }
}

Function.XArray.XDeleteAddr {
    Input: arr: Address
    Input: index: Integer
    Output: Address
    Body: {
        ReturnValue(XArray.XDelete(arr, index))
    }
}

// =============================================================================
// STACK OPERATIONS
// =============================================================================

Function.XStack.XCreate {
    Input: capacity: Integer
    Output: Address
    Body: {
        ReturnValue(XArray.XCreate(capacity))
    }
}

Function.XStack.XPush {
    Input: stack: Address
    Input: value: Integer
    Output: Integer
    Body: {
        ReturnValue(XArray.XPush(stack, value))
    }
}

Function.XStack.XPop {
    Input: stack: Address
    Output: Integer
    Body: {
        ReturnValue(XArray.XPop(stack))
    }
}

Function.XStack.XPeek {
    Input: stack: Address
    Output: Integer
    Body: {
        size = XArray.XSize(stack)
        IfCondition EqualTo(size, 0) ThenBlock: {
            ReturnValue(XArrays.XERROR)
        }
        ReturnValue(XArray.XGet(stack, Subtract(size, 1)))
    }
}

Function.XStack.XIsEmpty {
    Input: stack: Address
    Output: Integer
    Body: {
        ReturnValue(EqualTo(XArray.XSize(stack), 0))
    }
}

// =============================================================================
// QUEUE OPERATIONS
// =============================================================================

Function.XQueue.XCreate {
    Input: capacity: Integer
    Output: Address
    Body: {
        XArrays_EnsureArena()
        queue = Arena_Alloc64()
        StoreValue(queue, capacity)
        StoreValue(Add(queue, 8), 0)
        StoreValue(Add(queue, 16), 0)
        StoreValue(Add(queue, 24), 0)
        data = Arena_ArrayCreate(capacity)
        StoreValue(Add(queue, 32), data)
        ReturnValue(queue)
    }
}

Function.XQueue.XEnqueue {
    Input: queue: Address
    Input: value: Integer
    Output: Integer
    Body: {
        capacity = Dereference(queue)
        size = Dereference(Add(queue, 8))
        IfCondition GreaterEqual(size, capacity) ThenBlock: {
            ReturnValue(0)
        }
        tail = Dereference(Add(queue, 24))
        data = Dereference(Add(queue, 32))
        ArraySet(data, tail, value)
        new_tail = Modulo(Add(tail, 1), capacity)
        StoreValue(Add(queue, 24), new_tail)
        StoreValue(Add(queue, 8), Add(size, 1))
        ReturnValue(1)
    }
}

Function.XQueue.XDequeue {
    Input: queue: Address
    Output: Integer
    Body: {
        size = Dereference(Add(queue, 8))
        IfCondition EqualTo(size, 0) ThenBlock: {
            ReturnValue(XArrays.XERROR)
        }
        capacity = Dereference(queue)
        head = Dereference(Add(queue, 16))
        data = Dereference(Add(queue, 32))
        value = ArrayGet(data, head)
        new_head = Modulo(Add(head, 1), capacity)
        StoreValue(Add(queue, 16), new_head)
        StoreValue(Add(queue, 8), Subtract(size, 1))
        ReturnValue(value)
    }
}

Function.XQueue.XDestroy {
    Input: queue: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(queue, 0) ThenBlock: {
            ReturnValue(0)
        }
        data = Dereference(Add(queue, 32))
        Arena_ArrayDestroy(data)
        Arena_Free64(queue)
        ReturnValue(1)
    }
}

// =============================================================================
// HASH TABLE (Integer Keys)
// =============================================================================

Function.XHash.XHashInt {
    Input: key: Integer
    Input: buckets: Integer
    Output: Integer
    Body: {
        abs_key = key
        IfCondition LessThan(key, 0) ThenBlock: {
            abs_key = Subtract(0, key)
        }
        ReturnValue(Modulo(abs_key, buckets))
    }
}

Function.XHash.XCreate {
    Input: bucket_count: Integer
    Output: Address
    Body: {
        XArrays_EnsureArena()
        hash_table = Arena_Alloc24()
        StoreValue(hash_table, bucket_count)
        StoreValue(Add(hash_table, 8), 0)
        buckets = Arena_ArrayCreate(bucket_count)
        idx = 0
        WhileLoop LessThan(idx, bucket_count) {
            ArraySet(buckets, idx, 0)
            idx = Add(idx, 1)
        }
        StoreValue(Add(hash_table, 16), buckets)
        ReturnValue(hash_table)
    }
}

Function.XHash.XInsert {
    Input: hash_table: Address
    Input: key: Integer
    Input: value: Integer
    Output: Integer
    Body: {
        bucket_count = Dereference(hash_table)
        buckets = Dereference(Add(hash_table, 16))
        hash = XHash.XHashInt(key, bucket_count)
        new_node = Arena_Alloc24()
        StoreValue(new_node, key)
        StoreValue(Add(new_node, 8), value)
        head = ArrayGet(buckets, hash)
        StoreValue(Add(new_node, 16), head)
        ArraySet(buckets, hash, new_node)
        item_count = Dereference(Add(hash_table, 8))
        StoreValue(Add(hash_table, 8), Add(item_count, 1))
        ReturnValue(1)
    }
}

Function.XHash.XLookup {
    Input: hash_table: Address
    Input: key: Integer
    Output: Integer
    Body: {
        bucket_count = Dereference(hash_table)
        buckets = Dereference(Add(hash_table, 16))
        hash = XHash.XHashInt(key, bucket_count)
        current = ArrayGet(buckets, hash)
        WhileLoop NotEqual(current, 0) {
            node_key = Dereference(current)
            IfCondition EqualTo(node_key, key) ThenBlock: {
                ReturnValue(Dereference(Add(current, 8)))
            }
            current = Dereference(Add(current, 16))
        }
        ReturnValue(XArrays.XERROR)
    }
}

Function.XHash.XDestroy {
    Input: hash_table: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(hash_table, 0) ThenBlock: {
            ReturnValue(0)
        }
        buckets = Dereference(Add(hash_table, 16))
        bucket_count = Dereference(hash_table)
        idx = 0
        WhileLoop LessThan(idx, bucket_count) {
            current = ArrayGet(buckets, idx)
            WhileLoop NotEqual(current, 0) {
                next = Dereference(Add(current, 16))
                Arena_Free24(current)
                current = next
            }
            idx = Add(idx, 1)
        }
        Arena_ArrayDestroy(buckets)
        Arena_Free24(hash_table)
        ReturnValue(1)
    }
}

// =============================================================================
// STRING HASH TABLE (XSHash)
// =============================================================================

Function.XSHash.XCreate {
    Input: bucket_count: Integer
    Output: Address
    Body: {
        XArrays_EnsureArena()
        hash_table = Arena_Alloc24()
        StoreValue(hash_table, bucket_count)
        StoreValue(Add(hash_table, 8), 0)
        buckets = Arena_ArrayCreate(bucket_count)
        idx = 0
        WhileLoop LessThan(idx, bucket_count) {
            ArraySet(buckets, idx, 0)
            idx = Add(idx, 1)
        }
        StoreValue(Add(hash_table, 16), buckets)
        ReturnValue(hash_table)
    }
}

Function.XSHash.XInsert {
    Input: hash_table: Address
    Input: key: Address
    Input: value: Integer
    Output: Integer
    Body: {
        hash_value = 0
        idx = 0
        key_len = StringLength(key)
        WhileLoop LessThan(idx, key_len) {
            byte = GetByte(key, idx)
            hash_value = Add(Multiply(hash_value, 31), byte)
            idx = Add(idx, 1)
        }
        IfCondition LessThan(hash_value, 0) ThenBlock: {
            hash_value = Multiply(hash_value, -1)
        }
        bucket_count = Dereference(hash_table)
        bucket_idx = Modulo(hash_value, bucket_count)
        buckets = Dereference(Add(hash_table, 16))
        
        current = ArrayGet(buckets, bucket_idx)
        WhileLoop NotEqual(current, 0) {
            stored_key = Dereference(current)
            cmp = StringCompare(stored_key, key)
            IfCondition EqualTo(cmp, 0) ThenBlock: {
                StoreValue(Add(current, 8), value)
                ReturnValue(0)
            }
            current = Dereference(Add(current, 16))
        }
        
        new_node = Arena_Alloc24()
        key_copy = Helpers.StringCopy(key)
        StoreValue(new_node, key_copy)
        StoreValue(Add(new_node, 8), value)
        head = ArrayGet(buckets, bucket_idx)
        StoreValue(Add(new_node, 16), head)
        ArraySet(buckets, bucket_idx, new_node)
        item_count = Dereference(Add(hash_table, 8))
        StoreValue(Add(hash_table, 8), Add(item_count, 1))
        ReturnValue(1)
    }
}

Function.XSHash.XLookup {
    Input: hash_table: Address
    Input: key: Address
    Output: Integer
    Body: {
        hash_value = 0
        idx = 0
        key_len = StringLength(key)
        WhileLoop LessThan(idx, key_len) {
            byte = GetByte(key, idx)
            hash_value = Add(Multiply(hash_value, 31), byte)
            idx = Add(idx, 1)
        }
        IfCondition LessThan(hash_value, 0) ThenBlock: {
            hash_value = Multiply(hash_value, -1)
        }
        bucket_count = Dereference(hash_table)
        bucket_idx = Modulo(hash_value, bucket_count)
        buckets = Dereference(Add(hash_table, 16))
        current = ArrayGet(buckets, bucket_idx)
        WhileLoop NotEqual(current, 0) {
            stored_key = Dereference(current)
            cmp = StringCompare(stored_key, key)
            IfCondition EqualTo(cmp, 0) ThenBlock: {
                ReturnValue(Dereference(Add(current, 8)))
            }
            current = Dereference(Add(current, 16))
        }
        ReturnValue(XArrays.XNULL)
    }
}

Function.XSHash.XExists {
    Input: hash_table: Address
    Input: key: Address
    Output: Integer
    Body: {
        result = XSHash.XLookup(hash_table, key)
        ReturnValue(NotEqual(result, XArrays.XNULL))
    }
}

Function.XSHash.XDelete {
    Input: hash_table: Address
    Input: key: Address
    Output: Integer
    Body: {
        hash_value = 0
        idx = 0
        key_len = StringLength(key)
        WhileLoop LessThan(idx, key_len) {
            byte = GetByte(key, idx)
            hash_value = Add(Multiply(hash_value, 31), byte)
            idx = Add(idx, 1)
        }
        IfCondition LessThan(hash_value, 0) ThenBlock: {
            hash_value = Multiply(hash_value, -1)
        }
        bucket_count = Dereference(hash_table)
        bucket_idx = Modulo(hash_value, bucket_count)
        buckets = Dereference(Add(hash_table, 16))
        current = ArrayGet(buckets, bucket_idx)
        prev = 0
        WhileLoop NotEqual(current, 0) {
            stored_key = Dereference(current)
            cmp = StringCompare(stored_key, key)
            IfCondition EqualTo(cmp, 0) ThenBlock: {
                value = Dereference(Add(current, 8))
                next = Dereference(Add(current, 16))
                IfCondition EqualTo(prev, 0) ThenBlock: {
                    ArraySet(buckets, bucket_idx, next)
                } ElseBlock: {
                    StoreValue(Add(prev, 16), next)
                }
                sk_len = StringLength(stored_key)
                Deallocate(stored_key, Add(sk_len, 1))
                Arena_Free24(current)
                item_count = Dereference(Add(hash_table, 8))
                StoreValue(Add(hash_table, 8), Subtract(item_count, 1))
                ReturnValue(value)
            }
            prev = current
            current = Dereference(Add(current, 16))
        }
        ReturnValue(XArrays.XNULL)
    }
}

Function.XSHash.XKeys {
    Input: hash_table: Address
    Output: Address
    Body: {
        keys = XArray.XCreate(16)
        buckets = Dereference(Add(hash_table, 16))
        bucket_count = Dereference(hash_table)
        i = 0
        WhileLoop LessThan(i, bucket_count) {
            current = ArrayGet(buckets, i)
            WhileLoop NotEqual(current, 0) {
                key = Dereference(current)
                key_copy = Helpers.StringCopy(key)
                XArray.XPush(keys, key_copy)
                current = Dereference(Add(current, 16))
            }
            i = Add(i, 1)
        }
        ReturnValue(keys)
    }
}

Function.XSHash.XDestroy {
    Input: hash_table: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(hash_table, 0) ThenBlock: {
            ReturnValue(0)
        }
        buckets = Dereference(Add(hash_table, 16))
        bucket_count = Dereference(hash_table)
        idx = 0
        WhileLoop LessThan(idx, bucket_count) {
            current = ArrayGet(buckets, idx)
            WhileLoop NotEqual(current, 0) {
                next = Dereference(Add(current, 16))
                key = Dereference(current)
                key_len = StringLength(key)
                Deallocate(key, Add(key_len, 1))
                Arena_Free24(current)
                current = next
            }
            idx = Add(idx, 1)
        }
        Arena_ArrayDestroy(buckets)
        Arena_Free24(hash_table)
        ReturnValue(1)
    }
}

// Address variants for XSHash
Function.XSHash.XInsertAddr {
    Input: hash_table: Address
    Input: key: Address
    Input: value: Address
    Output: Integer
    Body: {
        hash_value = 0
        idx = 0
        key_len = StringLength(key)
        WhileLoop LessThan(idx, key_len) {
            byte = GetByte(key, idx)
            hash_value = Add(Multiply(hash_value, 31), byte)
            idx = Add(idx, 1)
        }
        IfCondition LessThan(hash_value, 0) ThenBlock: {
            hash_value = Multiply(hash_value, -1)
        }
        bucket_count = Dereference(hash_table)
        bucket_idx = Modulo(hash_value, bucket_count)
        buckets = Dereference(Add(hash_table, 16))
        current = ArrayGet(buckets, bucket_idx)
        WhileLoop NotEqual(current, 0) {
            stored_key = Dereference(current)
            cmp = StringCompare(stored_key, key)
            IfCondition EqualTo(cmp, 0) ThenBlock: {
                StoreValue(Add(current, 8), value)
                ReturnValue(0)
            }
            current = Dereference(Add(current, 16))
        }
        new_node = Arena_Alloc24()
        key_copy = Helpers.StringCopy(key)
        StoreValue(new_node, key_copy)
        StoreValue(Add(new_node, 8), value)
        head = ArrayGet(buckets, bucket_idx)
        StoreValue(Add(new_node, 16), head)
        ArraySet(buckets, bucket_idx, new_node)
        item_count = Dereference(Add(hash_table, 8))
        StoreValue(Add(hash_table, 8), Add(item_count, 1))
        ReturnValue(1)
    }
}

Function.XSHash.XLookupAddr {
    Input: hash_table: Address
    Input: key: Address
    Output: Address
    Body: {
        hash_value = 0
        idx = 0
        key_len = StringLength(key)
        WhileLoop LessThan(idx, key_len) {
            byte = GetByte(key, idx)
            hash_value = Add(Multiply(hash_value, 31), byte)
            idx = Add(idx, 1)
        }
        IfCondition LessThan(hash_value, 0) ThenBlock: {
            hash_value = Multiply(hash_value, -1)
        }
        bucket_count = Dereference(hash_table)
        bucket_idx = Modulo(hash_value, bucket_count)
        buckets = Dereference(Add(hash_table, 16))
        current = ArrayGet(buckets, bucket_idx)
        WhileLoop NotEqual(current, 0) {
            stored_key = Dereference(current)
            cmp = StringCompare(stored_key, key)
            IfCondition EqualTo(cmp, 0) ThenBlock: {
                ReturnValue(Dereference(Add(current, 8)))
            }
            current = Dereference(Add(current, 16))
        }
        ReturnValue(XArrays.XNULL)
    }
}

Function.XSHash.XExistsAddr {
    Input: hash_table: Address
    Input: key: Address
    Output: Integer
    Body: {
        result = XSHash.XLookupAddr(hash_table, key)
        ReturnValue(NotEqual(result, XArrays.XNULL))
    }
}

Function.XSHash.XDeleteAddr {
    Input: hash_table: Address
    Input: key: Address
    Output: Address
    Body: {
        hash_value = 0
        idx = 0
        key_len = StringLength(key)
        WhileLoop LessThan(idx, key_len) {
            byte = GetByte(key, idx)
            hash_value = Add(Multiply(hash_value, 31), byte)
            idx = Add(idx, 1)
        }
        IfCondition LessThan(hash_value, 0) ThenBlock: {
            hash_value = Multiply(hash_value, -1)
        }
        bucket_count = Dereference(hash_table)
        bucket_idx = Modulo(hash_value, bucket_count)
        buckets = Dereference(Add(hash_table, 16))
        current = ArrayGet(buckets, bucket_idx)
        prev = 0
        WhileLoop NotEqual(current, 0) {
            stored_key = Dereference(current)
            cmp = StringCompare(stored_key, key)
            IfCondition EqualTo(cmp, 0) ThenBlock: {
                value = Dereference(Add(current, 8))
                next = Dereference(Add(current, 16))
                IfCondition EqualTo(prev, 0) ThenBlock: {
                    ArraySet(buckets, bucket_idx, next)
                } ElseBlock: {
                    StoreValue(Add(prev, 16), next)
                }
                sk_len = StringLength(stored_key)
                Deallocate(stored_key, Add(sk_len, 1))
                Arena_Free24(current)
                item_count = Dereference(Add(hash_table, 8))
                StoreValue(Add(hash_table, 8), Subtract(item_count, 1))
                ReturnValue(value)
            }
            prev = current
            current = Dereference(Add(current, 16))
        }
        ReturnValue(XArrays.XNULL)
    }
}

// =============================================================================
// LINKED LIST
// =============================================================================

Function.XList.XCreate {
    Output: Address
    Body: {
        XArrays_EnsureArena()
        list = Arena_Alloc24()
        StoreValue(list, 0)
        StoreValue(Add(list, 8), 0)
        StoreValue(Add(list, 16), 0)
        ReturnValue(list)
    }
}

Function.XList.XAppend {
    Input: list: Address
    Input: value: Integer
    Output: Integer
    Body: {
        new_node = Arena_Alloc24()
        StoreValue(new_node, value)
        StoreValue(Add(new_node, 8), 0)
        head = Dereference(list)
        tail = Dereference(Add(list, 8))
        IfCondition EqualTo(head, 0) ThenBlock: {
            StoreValue(list, new_node)
            StoreValue(Add(list, 8), new_node)
        } ElseBlock: {
            StoreValue(Add(tail, 8), new_node)
            StoreValue(Add(list, 8), new_node)
        }
        size = Dereference(Add(list, 16))
        StoreValue(Add(list, 16), Add(size, 1))
        ReturnValue(1)
    }
}

Function.XList.XPrepend {
    Input: list: Address
    Input: value: Integer
    Output: Integer
    Body: {
        new_node = Arena_Alloc24()
        StoreValue(new_node, value)
        head = Dereference(list)
        StoreValue(Add(new_node, 8), head)
        StoreValue(list, new_node)
        IfCondition EqualTo(head, 0) ThenBlock: {
            StoreValue(Add(list, 8), new_node)
        }
        size = Dereference(Add(list, 16))
        StoreValue(Add(list, 16), Add(size, 1))
        ReturnValue(1)
    }
}

Function.XList.XPopFront {
    Input: list: Address
    Output: Integer
    Body: {
        head = Dereference(list)
        IfCondition EqualTo(head, 0) ThenBlock: {
            ReturnValue(0)
        }
        value = Dereference(head)
        next_node = Dereference(Add(head, 8))
        StoreValue(list, next_node)
        IfCondition EqualTo(next_node, 0) ThenBlock: {
            StoreValue(Add(list, 8), 0)
        }
        size = Dereference(Add(list, 16))
        StoreValue(Add(list, 16), Subtract(size, 1))
        Arena_Free24(head)
        ReturnValue(value)
    }
}

Function.XList.XPopBack {
    Input: list: Address
    Output: Integer
    Body: {
        tail = Dereference(Add(list, 8))
        IfCondition EqualTo(tail, 0) ThenBlock: {
            ReturnValue(0)
        }
        head = Dereference(list)
        IfCondition EqualTo(head, tail) ThenBlock: {
            value = Dereference(tail)
            Arena_Free24(tail)
            StoreValue(list, 0)
            StoreValue(Add(list, 8), 0)
            StoreValue(Add(list, 16), 0)
            ReturnValue(value)
        }
        current = head
        WhileLoop NotEqual(Dereference(Add(current, 8)), tail) {
            current = Dereference(Add(current, 8))
        }
        value = Dereference(tail)
        Arena_Free24(tail)
        StoreValue(Add(current, 8), 0)
        StoreValue(Add(list, 8), current)
        size = Dereference(Add(list, 16))
        StoreValue(Add(list, 16), Subtract(size, 1))
        ReturnValue(value)
    }
}

Function.XList.XSize {
    Input: list: Address
    Output: Integer
    Body: {
        ReturnValue(Dereference(Add(list, 16)))
    }
}

Function.XList.XDestroy {
    Input: list: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(list, 0) ThenBlock: {
            ReturnValue(0)
        }
        head = Dereference(list)
        WhileLoop NotEqual(head, 0) {
            next = Dereference(Add(head, 8))
            Arena_Free24(head)
            head = next
        }
        Arena_Free24(list)
        ReturnValue(1)
    }
}

Function.XList.XDestroyDeep {
    Input: list: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(list, 0) ThenBlock: {
            ReturnValue(0)
        }
        head = Dereference(list)
        WhileLoop NotEqual(head, 0) {
            next = Dereference(Add(head, 8))
            value = Dereference(head)
            IfCondition NotEqual(value, 0) ThenBlock: {
                value_len = StringLength(value)
                Deallocate(value, Add(value_len, 1))
            }
            Arena_Free24(head)
            head = next
        }
        Arena_Free24(list)
        ReturnValue(1)
    }
}

// =============================================================================
// UTILITY FUNCTIONS
// =============================================================================

Function.XUtil.XBinarySearch {
    Input: arr: Address
    Input: target: Integer
    Output: Integer
    Body: {
        size = XArray.XSize(arr)
        left = 0
        right = Subtract(size, 1)
        WhileLoop LessEqual(left, right) {
            mid = Divide(Add(left, right), 2)
            mid_val = XArray.XGet(arr, mid)
            IfCondition EqualTo(mid_val, target) ThenBlock: {
                ReturnValue(mid)
            }
            IfCondition LessThan(mid_val, target) ThenBlock: {
                left = Add(mid, 1)
            } ElseBlock: {
                right = Subtract(mid, 1)
            }
        }
        ReturnValue(XArrays.XNULL)
    }
}

Function.XUtil.XQuickSort {
    Input: arr: Address
    Input: low: Integer
    Input: high: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(low, high) ThenBlock: {
            pivot_index = XUtil.XPartition(arr, low, high)
            XUtil.XQuickSort(arr, low, Subtract(pivot_index, 1))
            XUtil.XQuickSort(arr, Add(pivot_index, 1), high)
        }
        ReturnValue(1)
    }
}

Function.XUtil.XPartition {
    Input: arr: Address
    Input: low: Integer
    Input: high: Integer
    Output: Integer
    Body: {
        pivot = XArray.XGet(arr, high)
        i = Subtract(low, 1)
        j = low
        WhileLoop LessThan(j, high) {
            current = XArray.XGet(arr, j)
            IfCondition LessEqual(current, pivot) ThenBlock: {
                i = Add(i, 1)
                temp = XArray.XGet(arr, i)
                XArray.XSet(arr, i, current)
                XArray.XSet(arr, j, temp)
            }
            j = Add(j, 1)
        }
        i = Add(i, 1)
        temp = XArray.XGet(arr, i)
        XArray.XSet(arr, i, pivot)
        XArray.XSet(arr, high, temp)
        ReturnValue(i)
    }
}

Function.XUtil.XFindMax {
    Input: arr: Address
    Output: Integer
    Body: {
        size = XArray.XSize(arr)
        IfCondition EqualTo(size, 0) ThenBlock: {
            ReturnValue(XArrays.XERROR)
        }
        max_val = XArray.XGet(arr, 0)
        i = 1
        WhileLoop LessThan(i, size) {
            current = XArray.XGet(arr, i)
            IfCondition GreaterThan(current, max_val) ThenBlock: {
                max_val = current
            }
            i = Add(i, 1)
        }
        ReturnValue(max_val)
    }
}

Function.XUtil.XFindMin {
    Input: arr: Address
    Output: Integer
    Body: {
        size = XArray.XSize(arr)
        IfCondition EqualTo(size, 0) ThenBlock: {
            ReturnValue(XArrays.XERROR)
        }
        min_val = XArray.XGet(arr, 0)
        i = 1
        WhileLoop LessThan(i, size) {
            current = XArray.XGet(arr, i)
            IfCondition LessThan(current, min_val) ThenBlock: {
                min_val = current
            }
            i = Add(i, 1)
        }
        ReturnValue(min_val)
    }
}

Function.XUtil.XReverse {
    Input: arr: Address
    Output: Integer
    Body: {
        size = XArray.XSize(arr)
        left = 0
        right = Subtract(size, 1)
        WhileLoop LessThan(left, right) {
            left_val = XArray.XGet(arr, left)
            right_val = XArray.XGet(arr, right)
            XArray.XSet(arr, left, right_val)
            XArray.XSet(arr, right, left_val)
            left = Add(left, 1)
            right = Subtract(right, 1)
        }
        ReturnValue(1)
    }
}

// =============================================================================
// STREAM OPERATIONS
// =============================================================================

Function.XStream.XDestroy {
    Input: stream: Address
    Output: Integer
    Body: {
        IfCondition NotEqual(stream, 0) ThenBlock: {
            size = XArray.XSize(stream)
            i = 0
            WhileLoop LessThan(i, size) {
                entry = XArray.XGet(stream, i)
                entry_size = XArray.XSize(entry)
                j = 0
                WhileLoop LessThan(j, entry_size) {
                    field_or_value = XArray.XGet(entry, j)
                    fv_len = StringLength(field_or_value)
                    Deallocate(field_or_value, Add(fv_len, 1))
                    j = Add(j, 1)
                }
                XArray.XDestroy(entry)
                i = Add(i, 1)
            }
            XArray.XDestroy(stream)
        }
        ReturnValue(1)
    }
}

Debug("library.load", level=1) {
    PrintMessage("XArrays v2.1 loaded - Complete arena-integrated library\n")
}