// Child used by the Load tests. Exits with the number in argument 1,
// or 42 when that argument is missing.
// Copyright (c) 2026 Sean Collins, 2 Paws Machine and Engineering. SCSL v1.0.

LibraryImport.Load

SubRoutine.Main {
    buf = Allocate(32)
    n = 0
    i = 0
    c = 0
    code = 42
    bad = 0
    MemorySet(buf, 0, 32)
    n = Load_Arg(1, buf, 32)
    IfCondition GreaterThan(n, 0) ThenBlock: {
        code = 0
        i = 0
        bad = 0
        WhileLoop LessThan(i, n) {
            c = GetByte(buf, i)
            IfCondition LessThan(c, 48) ThenBlock: { bad = 1 }
            IfCondition GreaterThan(c, 57) ThenBlock: { bad = 1 }
            IfCondition EqualTo(bad, 0) ThenBlock: {
                code = Multiply(code, 10)
                code = Add(code, Subtract(c, 48))
            }
            i = Add(i, 1)
        }
        IfCondition EqualTo(bad, 1) ThenBlock: { code = 42 }
    }
    Deallocate(buf, 32)
    SystemCall(60, code, 0, 0, 0, 0)
}

RunTask(Main)
