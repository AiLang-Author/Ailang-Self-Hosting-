// Replaces this process with argument 1, passing argument 2 through.
// Copyright (c) 2026 Sean Collins, 2 Paws Machine and Engineering. SCSL v1.0.

LibraryImport.Load

SubRoutine.Main {
    bin = Allocate(256)
    arg = Allocate(32)
    nb = 0
    na = 0
    a2 = 0
    MemorySet(bin, 0, 256)
    MemorySet(arg, 0, 32)
    nb = Load_Arg(1, bin, 256)
    na = Load_Arg(2, arg, 32)
    IfCondition LessThan(nb, 1) ThenBlock: {
        SystemCall(60, 2, 0, 0, 0, 0)
    }
    a2 = 0
    IfCondition GreaterThan(na, 0) ThenBlock: { a2 = arg }
    Load_Swap(bin, a2, 0)
    SystemCall(60, 4, 0, 0, 0, 0)
}

RunTask(Main)
