// Exercises Load_Start, Load_Swap, Load_Wait, Load_Arg, and Load_List.
// Copyright (c) 2026 Sean Collins, 2 Paws Machine and Engineering. SCSL v1.0.

LibraryImport.Load

FixedPool.T {
    "bad": Initialize=0
}

Function.Test_Has {
    Input: names: Address
    Input: n: Integer
    Input: want: Address
    Output: Integer
    Body: {
        i = 0
        p = 0
        hit = 0
        i = 0
        WhileLoop LessThan(i, n) {
            p = Multiply(i, 64)
            p = Add(names, p)
            hit = StringCompare(p, want)
            IfCondition EqualTo(hit, 0) ThenBlock: { ReturnValue(1) }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

SubRoutine.Main {
    got = 0
    pid = 0
    n = 0
    hit = 0
    buf = 0
    names = 0
    got = Load_Swap("/tmp/load-test/missing.x", 0, 0)
    IfCondition NotEqual(got, 0) ThenBlock: {
        PrintMessage("fail swap-miss ")
        PrintNumber(got)
        PrintMessage("\n")
        T.bad = Add(T.bad, 1)
    }
    ElseBlock: { PrintMessage("ok swap-miss\n") }
    got = Load_List("/tmp/load-test/no-such-dir", 0, 1, 64)
    IfCondition NotEqual(got, Subtract(0, 1)) ThenBlock: {
        PrintMessage("fail list-miss ")
        PrintNumber(got)
        PrintMessage("\n")
        T.bad = Add(T.bad, 1)
    }
    ElseBlock: { PrintMessage("ok list-miss\n") }
    buf = Allocate(256)
    n = Load_Arg(0, buf, 256)
    IfCondition LessThan(n, 1) ThenBlock: {
        PrintMessage("fail arg0\n")
        T.bad = Add(T.bad, 1)
    }
    ElseBlock: { PrintMessage("ok arg0\n") }
    Deallocate(buf, 256)
    pid = Load_Start("/tmp/load-test/load_child.x", "42", 0)
    got = Load_Wait(pid)
    IfCondition NotEqual(got, 42) ThenBlock: {
        PrintMessage("fail exit ")
        PrintNumber(got)
        PrintMessage("\n")
        T.bad = Add(T.bad, 1)
    }
    ElseBlock: { PrintMessage("ok exit\n") }
    pid = Load_Start("/tmp/load-test/load_child.x", "7", 0)
    got = Load_Wait(pid)
    IfCondition NotEqual(got, 7) ThenBlock: {
        PrintMessage("fail arg ")
        PrintNumber(got)
        PrintMessage("\n")
        T.bad = Add(T.bad, 1)
    }
    ElseBlock: { PrintMessage("ok arg\n") }
    pid = Load_Start("/tmp/load-test/missing.x", 0, 0)
    got = Load_Wait(pid)
    IfCondition NotEqual(got, 127) ThenBlock: {
        PrintMessage("fail missing ")
        PrintNumber(got)
        PrintMessage("\n")
        T.bad = Add(T.bad, 1)
    }
    ElseBlock: { PrintMessage("ok missing\n") }
    pid = Load_Start("/tmp/load-test/load_swap.x", "/tmp/load-test/load_child.x", "11")
    got = Load_Wait(pid)
    IfCondition NotEqual(got, 11) ThenBlock: {
        PrintMessage("fail swap ")
        PrintNumber(got)
        PrintMessage("\n")
        T.bad = Add(T.bad, 1)
    }
    ElseBlock: { PrintMessage("ok swap\n") }
    names = Allocate(512)
    MemorySet(names, 0, 512)
    n = Load_List("/tmp/load-test/bins", names, 8, 64)
    IfCondition NotEqual(n, 2) ThenBlock: {
        PrintMessage("fail list ")
        PrintNumber(n)
        PrintMessage("\n")
        T.bad = Add(T.bad, 1)
    }
    ElseBlock: { PrintMessage("ok list\n") }
    hit = Test_Has(names, n, "load_child.x")
    IfCondition NotEqual(hit, 1) ThenBlock: {
        PrintMessage("fail list-child\n")
        T.bad = Add(T.bad, 1)
    }
    ElseBlock: { PrintMessage("ok list-child\n") }
    hit = Test_Has(names, n, "load_swap.x")
    IfCondition NotEqual(hit, 1) ThenBlock: {
        PrintMessage("fail list-swap\n")
        T.bad = Add(T.bad, 1)
    }
    ElseBlock: { PrintMessage("ok list-swap\n") }
    hit = Test_Has(names, n, "skip.x")
    IfCondition NotEqual(hit, 0) ThenBlock: {
        PrintMessage("fail list-skip\n")
        T.bad = Add(T.bad, 1)
    }
    ElseBlock: { PrintMessage("ok list-skip\n") }
    hit = Test_Has(names, n, "notes.txt")
    IfCondition NotEqual(hit, 0) ThenBlock: {
        PrintMessage("fail list-notes\n")
        T.bad = Add(T.bad, 1)
    }
    ElseBlock: { PrintMessage("ok list-notes\n") }
    Deallocate(names, 512)
    IfCondition GreaterThan(T.bad, 0) ThenBlock: {
        PrintMessage("load tests failed ")
        PrintNumber(T.bad)
        PrintMessage("\n")
        SystemCall(60, 1, 0, 0, 0, 0)
    }
    PrintMessage("load tests ok\n")
    SystemCall(60, 0, 0, 0, 0, 0)
}

RunTask(Main)
