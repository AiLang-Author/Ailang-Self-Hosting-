LibraryImport.Arrays
LibraryImport.Markdown.MDScan
LibraryImport.Markdown.MDUni
LibraryImport.Markdown.MDBlock
LibraryImport.Markdown.MDHtml
LibraryImport.Markdown.MDRef
LibraryImport.Markdown.MDInline
LibraryImport.Markdown.MDRaw
LibraryImport.Markdown.MDEmit

// Block node, 80 bytes:
//   0 kind   1 doc  2 quote  3 list  4 item  5 code
//            6 html 7 head   8 rule  9 para
//   8 flags  1 if the previous line inside this block was blank
//  16 kids   child array for containers
//  24 text   leaf bytes, null terminated
//  32 tlen
//  40 tcap
//  48 a      item continuation indent, list start, code fence length,
//            html type, heading level
//  56 b      list bullet char, or 0 when the list is ordered
//            fence character, item marker column
//  64 c      list delimiter, fence indent
//  72 d      list tight (1 tight, 0 loose)

FixedPool.MP {
    "buf": Initialize=0, CanChange=True
    "blen": Initialize=0, CanChange=True
    "lines": Initialize=0, CanChange=True
    "nlines": Initialize=0, CanChange=True
    "open": Initialize=0, CanChange=True
    "refs": Initialize=0, CanChange=True
    "doc": Initialize=0, CanChange=True
    "ate": Initialize=0, CanChange=True
    "matched": Initialize=0, CanChange=True
    "make": Initialize=0, CanChange=True
    "interrupt": Initialize=0, CanChange=True
    "lineblank": Initialize=0, CanChange=True
}

FixedPool.MC {
    "li": Initialize=0, CanChange=True
    "off": Initialize=0, CanChange=True
    "col": Initialize=0, CanChange=True
    "pad": Initialize=0, CanChange=True
}

FixedPool.MB {
    "data": Initialize=0, CanChange=True
    "len": Initialize=0, CanChange=True
    "cap": Initialize=0, CanChange=True
    "last": Initialize=0, CanChange=True
}

FixedPool.MI {
    "txt": Initialize=0, CanChange=True
    "tlen": Initialize=0, CanChange=True
    "pos": Initialize=0, CanChange=True
    "head": Initialize=0, CanChange=True
    "tail": Initialize=0, CanChange=True
    "dhead": Initialize=0, CanChange=True
    "dtail": Initialize=0, CanChange=True
    "ctext": Initialize=0, CanChange=True
}

Function.MD.NewBlock {
    Input: kind: Integer
    Output: Address
    Body: {
        n = Allocate(80)
        WRMEM_64(n, kind)
        WRMEM_64(n, 8, 0)
        WRMEM_64(n, 16, 0)
        WRMEM_64(n, 24, 0)
        WRMEM_64(n, 32, 0)
        WRMEM_64(n, 40, 0)
        WRMEM_64(n, 48, 0)
        WRMEM_64(n, 56, 0)
        WRMEM_64(n, 64, 0)
        WRMEM_64(n, 72, 1)
        ReturnValue(n)
    }
}

Function.MD.Kind {
    Input: n: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(n, 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(RDMEM_64(n))
    }
}

Function.MD.EnsureKids {
    Input: n: Address
    Body: {
        k = RDMEM_64(n, 16)
        IfCondition EqualTo(k, 0) ThenBlock: {
            k = Array.Create(4)
            WRMEM_64(n, 16, k)
        }
    }
}

Function.MD.AddKid {
    Input: parent: Address
    Input: child: Address
    Body: {
        MD.EnsureKids(parent)
        kids = RDMEM_64(parent, 16)
        Array.Push(kids, child)
    }
}

Function.MD.PushOpen {
    Input: n: Address
    Body: {
        Array.Push(MP.open, n)
    }
}

Function.MD.Tip {
    Output: Address
    Body: {
        n = Array.Size(MP.open)
        IfCondition LessEqual(n, 0) ThenBlock: { ReturnValue(0) }
        last = Subtract(n, 1)
        ReturnValue(Array.Get(MP.open, last))
    }
}

Function.MD.TipKind {
    Output: Integer
    Body: {
        t = MD.Tip()
        ReturnValue(MD.Kind(t))
    }
}

Function.MD.GrowText {
    Input: n: Address
    Input: extra: Integer
    Body: {
        len = RDMEM_64(n, 32)
        cap = RDMEM_64(n, 40)
        need = Add(len, extra)
        need = Add(need, 1)
        IfCondition GreaterThan(cap, need) ThenBlock: {
            need = need
        } ElseBlock: {
            newcap = 64
            IfCondition GreaterThan(cap, 0) ThenBlock: {
                newcap = Multiply(cap, 2)
            }
            growing = 1
            WhileLoop EqualTo(growing, 1) {
                IfCondition GreaterThan(newcap, need) ThenBlock: {
                    growing = 0
                } ElseBlock: {
                    newcap = Multiply(newcap, 2)
                }
            }
            nb = Allocate(newcap)
            IfCondition GreaterThan(len, 0) ThenBlock: {
                old = RDMEM_64(n, 24)
                MemoryCopy(nb, old, len)
            }
            WRMEM_64(n, 24, nb)
            WRMEM_64(n, 40, newcap)
        }
    }
}

Function.MD.AddByte {
    Input: n: Address
    Input: b: Integer
    Body: {
        MD.GrowText(n, 1)
        data = RDMEM_64(n, 24)
        len = RDMEM_64(n, 32)
        IfCondition EqualTo(b, 0) ThenBlock: {
            MD.GrowText(n, 3)
            data = RDMEM_64(n, 24)
            len = RDMEM_64(n, 32)
            WRMEM_8(data, len, 239)
            WRMEM_8(data, Add(len, 1), 191)
            WRMEM_8(data, Add(len, 2), 189)
            len = Add(len, 3)
        } ElseBlock: {
            WRMEM_8(data, len, b)
            len = Add(len, 1)
        }
        WRMEM_8(data, len, 0)
        WRMEM_64(n, 32, len)
    }
}

Function.MD.AddNl {
    Input: n: Address
    Body: {
        MD.AddByte(n, 10)
    }
}

Function.MB.Need {
    Input: n: Integer
    Body: {
        need = Add(MB.len, n)
        IfCondition GreaterEqual(MB.cap, need) ThenBlock: {
            need = need
        } ElseBlock: {
            newcap = 256
            IfCondition GreaterThan(MB.cap, 0) ThenBlock: {
                newcap = Multiply(MB.cap, 2)
            }
            growing = 1
            WhileLoop EqualTo(growing, 1) {
                IfCondition GreaterThan(newcap, need) ThenBlock: {
                    growing = 0
                } ElseBlock: {
                    newcap = Multiply(newcap, 2)
                }
            }
            nb = Allocate(newcap)
            IfCondition GreaterThan(MB.len, 0) ThenBlock: {
                MemoryCopy(nb, MB.data, MB.len)
            }
            MB.data = nb
            MB.cap = newcap
        }
    }
}

Function.MB.Reset {
    Body: {
        MB.len = 0
    }
}

Function.MB.Byte {
    Input: b: Integer
    Body: {
        MB.Need(2)
        WRMEM_8(MB.data, MB.len, b)
        MB.len = Add(MB.len, 1)
        WRMEM_8(MB.data, MB.len, 0)
    }
}

Function.MB.Take {
    Output: Address
    Body: {
        n = MB.len
        s = Allocate(Add(n, 1))
        IfCondition GreaterThan(n, 0) ThenBlock: {
            MemoryCopy(s, MB.data, n)
        }
        WRMEM_8(s, n, 0)
        MB.last = n
        MB.len = 0
        ReturnValue(s)
    }
}

Function.MB.Str {
    Input: s: Address
    Body: {
        n = StringLength(s)
        i = 0
        WhileLoop LessThan(i, n) {
            b = RDMEM_8(s, i)
            MB.Byte(b)
            i = Add(i, 1)
        }
    }
}

Function.MD.SplitLines {
    Input: buf: Address
    Input: n: Integer
    Body: {
        MP.buf = buf
        MP.blen = n
        MP.lines = Array.Create(8)
        MP.nlines = 0
        i = 0
        start = 0
        WhileLoop LessThan(i, n) {
            b = RDMEM_8(Add(buf, i))
            brk = 0
            IfCondition EqualTo(b, 10) ThenBlock: { brk = 1 }
            IfCondition EqualTo(b, 13) ThenBlock: { brk = 1 }
            IfCondition EqualTo(brk, 1) ThenBlock: {
                rec = Allocate(16)
                WRMEM_64(rec, start)
                ln = Subtract(i, start)
                WRMEM_64(rec, 8, ln)
                Array.Push(MP.lines, rec)
                IfCondition EqualTo(b, 13) ThenBlock: {
                    nxt = Add(i, 1)
                    IfCondition LessThan(nxt, n) ThenBlock: {
                        b2 = RDMEM_8(Add(buf, nxt))
                        IfCondition EqualTo(b2, 10) ThenBlock: {
                            i = nxt
                        }
                    }
                }
                i = Add(i, 1)
                start = i
            } ElseBlock: {
                i = Add(i, 1)
            }
        }
        IfCondition LessThan(start, n) ThenBlock: {
            rec2 = Allocate(16)
            WRMEM_64(rec2, start)
            ln2 = Subtract(n, start)
            WRMEM_64(rec2, 8, ln2)
            Array.Push(MP.lines, rec2)
        }
        MP.nlines = Array.Size(MP.lines)
    }
}

Function.MD.ToHTML {
    Input: buf: Address
    Input: n: Integer
    Output: Address
    Body: {
        MP.buf = buf
        MP.blen = n
        MP.refs = Array.Create(4)
        MP.open = Array.Create(8)
        doc = MD.NewBlock(1)
        MP.doc = doc
        MD.PushOpen(doc)
        MD.SplitLines(buf, n)
        MD.ParseDoc()
        out = MD.Render(doc)
        ReturnValue(out)
    }
}
