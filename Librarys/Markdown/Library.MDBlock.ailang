Function.MD.MatchCont {
    Input: node: Address
    Output: Integer
    Body: {
        k = MD.Kind(node)
        IfCondition EqualTo(k, 3) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(k, 2) ThenBlock: {
            o = MC.off
            c = MC.col
            p = MC.pad
            MD.TakeCols(3)
            b = MD.Peek()
            more = 0
            IfCondition EqualTo(b, 32) ThenBlock: { more = 1 }
            IfCondition EqualTo(b, 9) ThenBlock: { more = 1 }
            IfCondition EqualTo(more, 1) ThenBlock: {
                MC.off = o
                MC.col = c
                MC.pad = p
                ReturnValue(0)
            }
            IfCondition NotEqual(b, 62) ThenBlock: {
                MC.off = o
                MC.col = c
                MC.pad = p
                ReturnValue(0)
            }
            MD.Bump()
            b2 = MD.Peek()
            IfCondition EqualTo(b2, 32) ThenBlock: {
                MD.Bump()
            } ElseBlock: {
                IfCondition EqualTo(b2, 9) ThenBlock: {
                    rem = Modulo(MC.col, 4)
                    adv = Subtract(4, rem)
                    MC.off = Add(MC.off, 1)
                    MC.pad = Subtract(adv, 1)
                    MC.col = Add(MC.col, 1)
                }
            }
            ReturnValue(1)
        }
        IfCondition EqualTo(k, 4) ThenBlock: {
            rb4 = MD.RestBlank()
            IfCondition EqualTo(rb4, 1) ThenBlock: {
                kids4 = RDMEM_64(node, 16)
                has4 = 0
                IfCondition NotEqual(kids4, 0) ThenBlock: {
                    ks4 = Array.Size(kids4)
                    IfCondition GreaterThan(ks4, 0) ThenBlock: { has4 = 1 }
                }
                IfCondition EqualTo(has4, 1) ThenBlock: { ReturnValue(1) }
                ReturnValue(0)
            }
            o4 = MC.off
            c4 = MC.col
            p4 = MC.pad
            want = RDMEM_64(node, 48)
            got = MD.TakeCols(want)
            IfCondition EqualTo(got, want) ThenBlock: { ReturnValue(1) }
            MC.off = o4
            MC.col = c4
            MC.pad = p4
            ReturnValue(0)
        }
        ReturnValue(0)
    }
}

Function.MD.IsRule {
    Output: Integer
    Body: {
        o = MC.off
        c = MC.col
        p = MC.pad
        MD.TakeCols(3)
        b = MD.Peek()
        bad = 0
        IfCondition EqualTo(b, 32) ThenBlock: { bad = 1 }
        IfCondition EqualTo(b, 9) ThenBlock: { bad = 1 }
        mark = 0
        count = 0
        WhileLoop EqualTo(bad, 0) {
            b2 = MD.Peek()
            IfCondition LessThan(b2, 0) ThenBlock: {
                bad = 2
            } ElseBlock: {
                ws = 0
                IfCondition EqualTo(b2, 32) ThenBlock: { ws = 1 }
                IfCondition EqualTo(b2, 9) ThenBlock: { ws = 1 }
                IfCondition EqualTo(ws, 1) ThenBlock: {
                    MD.Bump()
                } ElseBlock: {
                    okm = 0
                    IfCondition EqualTo(b2, 45) ThenBlock: { okm = 1 }
                    IfCondition EqualTo(b2, 42) ThenBlock: { okm = 1 }
                    IfCondition EqualTo(b2, 95) ThenBlock: { okm = 1 }
                    IfCondition EqualTo(okm, 0) ThenBlock: {
                        bad = 1
                    } ElseBlock: {
                        IfCondition EqualTo(mark, 0) ThenBlock: {
                            mark = b2
                        }
                        IfCondition NotEqual(b2, mark) ThenBlock: {
                            bad = 1
                        } ElseBlock: {
                            count = Add(count, 1)
                            MD.Bump()
                        }
                    }
                }
            }
        }
        MC.off = o
        MC.col = c
        MC.pad = p
        IfCondition EqualTo(bad, 1) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(count, 3) ThenBlock: { ReturnValue(0) }
        ReturnValue(1)
    }
}

Function.MD.IsSetext {
    Output: Integer
    Body: {
        o = MC.off
        c = MC.col
        p = MC.pad
        MD.TakeCols(3)
        b = MD.Peek()
        bad = 0
        IfCondition EqualTo(b, 32) ThenBlock: { bad = 1 }
        IfCondition EqualTo(b, 9) ThenBlock: { bad = 1 }
        mark = 0
        IfCondition EqualTo(b, 61) ThenBlock: { mark = 61 }
        IfCondition EqualTo(b, 45) ThenBlock: { mark = 45 }
        IfCondition EqualTo(mark, 0) ThenBlock: { bad = 1 }
        count = 0
        WhileLoop EqualTo(bad, 0) {
            b2 = MD.Peek()
            IfCondition LessThan(b2, 0) ThenBlock: {
                bad = 2
            } ElseBlock: {
                IfCondition EqualTo(b2, mark) ThenBlock: {
                    count = Add(count, 1)
                    MD.Bump()
                } ElseBlock: {
                    ws = 0
                    IfCondition EqualTo(b2, 32) ThenBlock: { ws = 1 }
                    IfCondition EqualTo(b2, 9) ThenBlock: { ws = 1 }
                    IfCondition EqualTo(ws, 1) ThenBlock: {
                        MD.SkipWs()
                        b3 = MD.Peek()
                        IfCondition GreaterEqual(b3, 0) ThenBlock: {
                            bad = 1
                        } ElseBlock: {
                            bad = 2
                        }
                    } ElseBlock: {
                        bad = 1
                    }
                }
            }
        }
        MC.off = o
        MC.col = c
        MC.pad = p
        IfCondition EqualTo(bad, 1) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(count, 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(mark, 61) ThenBlock: { ReturnValue(1) }
        ReturnValue(2)
    }
}

Function.MD.EndsBlank {
    Input: node: Address
    Output: Integer
    Body: {
        k = MD.Kind(node)
        nest = 0
        IfCondition EqualTo(k, 3) ThenBlock: { nest = 1 }
        IfCondition EqualTo(k, 4) ThenBlock: { nest = 1 }
        IfCondition EqualTo(nest, 1) ThenBlock: {
            kids = RDMEM_64(node, 16)
            IfCondition NotEqual(kids, 0) ThenBlock: {
                ks = Array.Size(kids)
                IfCondition GreaterThan(ks, 0) ThenBlock: {
                    last = Array.Get(kids, Subtract(ks, 1))
                    hit = MD.EndsBlank(last)
                    ReturnValue(hit)
                }
            }
        }
        flag = RDMEM_64(node, 8)
        ReturnValue(flag)
    }
}

Function.MD.SealList {
    Input: list: Address
    Body: {
        items = RDMEM_64(list, 16)
        IfCondition EqualTo(items, 0) ThenBlock: { ReturnValue(0) }
        n = Array.Size(items)
        WRMEM_64(list, 72, 1)
        i = 0
        WhileLoop LessThan(i, n) {
            item = Array.Get(items, i)
            last = 0
            nxti = Add(i, 1)
            IfCondition EqualTo(nxti, n) ThenBlock: { last = 1 }
            flag = RDMEM_64(item, 8)
            IfCondition EqualTo(flag, 1) ThenBlock: {
                IfCondition EqualTo(last, 0) ThenBlock: {
                    WRMEM_64(list, 72, 0)
                }
            }
            kids = RDMEM_64(item, 16)
            IfCondition NotEqual(kids, 0) ThenBlock: {
                m = Array.Size(kids)
                j = 0
                WhileLoop LessThan(j, m) {
                    ch = Array.Get(kids, j)
                    chlast = 0
                    nxtj = Add(j, 1)
                    IfCondition EqualTo(nxtj, m) ThenBlock: { chlast = 1 }
                    edge = 0
                    IfCondition EqualTo(last, 0) ThenBlock: { edge = 1 }
                    IfCondition EqualTo(chlast, 0) ThenBlock: { edge = 1 }
                    IfCondition EqualTo(edge, 1) ThenBlock: {
                        eb = MD.EndsBlank(ch)
                        IfCondition EqualTo(eb, 1) ThenBlock: {
                            WRMEM_64(list, 72, 0)
                        }
                    }
                    j = Add(j, 1)
                }
            }
            i = Add(i, 1)
        }
    }
}

Function.MD.CloseAfter {
    Input: idx: Integer
    Body: {
        n = Array.Size(MP.open)
        keep = Add(idx, 1)
        WhileLoop GreaterThan(n, keep) {
            node = Array.Pop(MP.open)
            k = MD.Kind(node)
            IfCondition EqualTo(k, 3) ThenBlock: {
                MD.SealList(node)
            }
            IfCondition EqualTo(k, 5) ThenBlock: {
                fence = RDMEM_64(node, 48)
                IfCondition EqualTo(fence, 0) ThenBlock: {
                    MD.StripCodeEnd(node)
                }
            }
            IfCondition EqualTo(k, 9) ThenBlock: {
                gone = MD.TakeRefs(node)
                IfCondition EqualTo(gone, 1) ThenBlock: {
                    parent = MD.Tip()
                    kids = RDMEM_64(parent, 16)
                    Array.Pop(kids)
                }
            }
            n = Array.Size(MP.open)
        }
    }
}

Function.MD.FinishAll {
    Body: {
        MD.CloseAfter(-1)
    }
}

Function.MD.Lower {
    Input: b: Integer
    Output: Integer
    Body: {
        IfCondition GreaterEqual(b, 65) ThenBlock: {
            IfCondition LessEqual(b, 90) ThenBlock: {
                ReturnValue(Add(b, 32))
            }
        }
        ReturnValue(b)
    }
}

Function.MD.OpenLeaf {
    Input: kind: Integer
    Input: stay: Integer
    Output: Address
    Body: {
        parent = MD.Tip()
        pk = MD.Kind(parent)
        IfCondition EqualTo(pk, 4) ThenBlock: {
            kids = RDMEM_64(parent, 16)
            has = 0
            IfCondition NotEqual(kids, 0) ThenBlock: {
                ks = Array.Size(kids)
                IfCondition GreaterThan(ks, 0) ThenBlock: { has = 1 }
            }
            flag = RDMEM_64(parent, 8)
            IfCondition EqualTo(flag, 1) ThenBlock: {
                IfCondition EqualTo(has, 1) ThenBlock: {
                    list = 0
                    n = Array.Size(MP.open)
                    i = 0
                    WhileLoop LessThan(i, n) {
                        nd = Array.Get(MP.open, i)
                        kk = MD.Kind(nd)
                        IfCondition EqualTo(kk, 3) ThenBlock: { list = nd }
                        i = Add(i, 1)
                    }
                    IfCondition NotEqual(list, 0) ThenBlock: {
                        WRMEM_64(list, 72, 0)
                    }
                }
            }
            WRMEM_64(parent, 8, 0)
        }
        node = MD.NewBlock(kind)
        MD.AddKid(parent, node)
        IfCondition EqualTo(stay, 1) ThenBlock: {
            MD.PushOpen(node)
        }
        ReturnValue(node)
    }
}

Function.MD.TryRule {
    Output: Integer
    Body: {
        ok = MD.IsRule()
        IfCondition EqualTo(ok, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(MP.make, 0) ThenBlock: { ReturnValue(1) }
        MD.OpenLeaf(8, 0)
        MD.SkipWs()
        draining = 1
        WhileLoop EqualTo(draining, 1) {
            bdr = MD.Peek()
            IfCondition LessThan(bdr, 0) ThenBlock: {
                draining = 0
            } ElseBlock: {
                MD.Bump()
            }
        }
        MP.ate = 1
        ReturnValue(1)
    }
}

Function.MD.TrimEnd {
    Input: node: Address
    Body: {
        data = RDMEM_64(node, 24)
        IfCondition EqualTo(data, 0) ThenBlock: { ReturnValue(0) }
        slot = Allocate(8)
        WRMEM_64(slot, 1)
        go = 1
        WhileLoop EqualTo(go, 1) {
            len = RDMEM_64(node, 32)
            IfCondition LessEqual(len, 0) ThenBlock: {
                WRMEM_64(slot, 0)
            } ElseBlock: {
                b = RDMEM_8(data, Subtract(len, 1))
                ws = 0
                IfCondition EqualTo(b, 32) ThenBlock: { ws = 1 }
                IfCondition EqualTo(b, 9) ThenBlock: { ws = 1 }
                IfCondition EqualTo(ws, 1) ThenBlock: {
                    nlen = Subtract(len, 1)
                    WRMEM_64(node, 32, nlen)
                    WRMEM_8(data, nlen, 0)
                } ElseBlock: {
                    WRMEM_64(slot, 0)
                }
            }
            go = RDMEM_64(slot)
        }
    }
}

Function.MD.TryAtx {
    Output: Integer
    Body: {
        o = MC.off
        c = MC.col
        p = MC.pad
        MD.TakeCols(3)
        b = MD.Peek()
        over = 0
        IfCondition EqualTo(b, 32) ThenBlock: { over = 1 }
        IfCondition EqualTo(b, 9) ThenBlock: { over = 1 }
        n = 0
        IfCondition EqualTo(over, 0) ThenBlock: {
            stop = 0
            WhileLoop EqualTo(stop, 0) {
                IfCondition GreaterEqual(n, 7) ThenBlock: {
                    stop = 1
                } ElseBlock: {
                    b2 = MD.Peek()
                    IfCondition EqualTo(b2, 35) ThenBlock: {
                        n = Add(n, 1)
                        MD.Bump()
                    } ElseBlock: {
                        stop = 1
                    }
                }
            }
        }
        level = 0
        IfCondition GreaterThan(n, 0) ThenBlock: {
            IfCondition LessThan(n, 7) ThenBlock: {
                b3 = MD.Peek()
                sp = 0
                IfCondition LessThan(b3, 0) ThenBlock: { sp = 1 }
                IfCondition EqualTo(b3, 32) ThenBlock: { sp = 1 }
                IfCondition EqualTo(b3, 9) ThenBlock: { sp = 1 }
                IfCondition EqualTo(sp, 1) ThenBlock: { level = n }
            }
        }
        IfCondition EqualTo(level, 0) ThenBlock: {
            MC.off = o
            MC.col = c
            MC.pad = p
            ReturnValue(0)
        }
        IfCondition EqualTo(MP.make, 0) ThenBlock: {
            MC.off = o
            MC.col = c
            MC.pad = p
            ReturnValue(1)
        }
        IfCondition GreaterEqual(MD.Peek(), 0) ThenBlock: {
            MD.Bump()
        }
        MD.SkipWs()
        node = MD.OpenLeaf(7, 0)
        WRMEM_64(node, 48, level)
        MD.AppendRest(node, 0)
        MD.TrimAtx(node)
        MP.ate = 1
        ReturnValue(1)
    }
}

Function.MD.TrimAtx {
    Input: node: Address
    Body: {
        data = RDMEM_64(node, 24)
        len = RDMEM_64(node, 32)
        IfCondition EqualTo(data, 0) ThenBlock: { ReturnValue(0) }
        trimming = 1
        WhileLoop EqualTo(trimming, 1) {
            IfCondition LessEqual(len, 0) ThenBlock: {
                trimming = 0
            } ElseBlock: {
                b = RDMEM_8(data, Subtract(len, 1))
                ws = 0
                IfCondition EqualTo(b, 32) ThenBlock: { ws = 1 }
                IfCondition EqualTo(b, 9) ThenBlock: { ws = 1 }
                IfCondition EqualTo(ws, 1) ThenBlock: {
                    len = Subtract(len, 1)
                    WRMEM_64(node, 32, len)
                    WRMEM_8(data, len, 0)
                } ElseBlock: {
                    trimming = 0
                }
            }
        }
        len = RDMEM_64(node, 32)
        hslot = Allocate(8)
        WRMEM_64(hslot, 0)
        i = len
        WhileLoop GreaterThan(i, 0) {
            b2 = RDMEM_8(data, Subtract(i, 1))
            IfCondition EqualTo(b2, 35) ThenBlock: {
                hc = RDMEM_64(hslot)
                hc = Add(hc, 1)
                WRMEM_64(hslot, hc)
                i = Subtract(i, 1)
            } ElseBlock: {
                i = 0
            }
        }
        hashes = RDMEM_64(hslot)
        IfCondition GreaterThan(hashes, 0) ThenBlock: {
            at = Subtract(len, hashes)
            ok = 0
            IfCondition EqualTo(at, 0) ThenBlock: { ok = 1 }
            IfCondition GreaterThan(at, 0) ThenBlock: {
                prev = RDMEM_8(data, Subtract(at, 1))
                IfCondition EqualTo(prev, 32) ThenBlock: { ok = 1 }
                IfCondition EqualTo(prev, 9) ThenBlock: { ok = 1 }
            }
            IfCondition EqualTo(ok, 1) ThenBlock: {
                len = at
                trimming2 = 1
                WhileLoop EqualTo(trimming2, 1) {
                    IfCondition LessEqual(len, 0) ThenBlock: {
                        trimming2 = 0
                    } ElseBlock: {
                        b3 = RDMEM_8(data, Subtract(len, 1))
                        ws2 = 0
                        IfCondition EqualTo(b3, 32) ThenBlock: { ws2 = 1 }
                        IfCondition EqualTo(b3, 9) ThenBlock: { ws2 = 1 }
                        IfCondition EqualTo(ws2, 1) ThenBlock: {
                            len = Subtract(len, 1)
                        } ElseBlock: {
                            trimming2 = 0
                        }
                    }
                }
                WRMEM_64(node, 32, len)
                WRMEM_8(data, len, 0)
            }
        }
    }
}

Function.MD.TryFence {
    Output: Integer
    Body: {
        o = MC.off
        c = MC.col
        p = MC.pad
        ind = MD.TakeCols(3)
        b = MD.Peek()
        over = 0
        IfCondition EqualTo(b, 32) ThenBlock: { over = 1 }
        IfCondition EqualTo(b, 9) ThenBlock: { over = 1 }
        ch = 0
        n = 0
        IfCondition EqualTo(over, 0) ThenBlock: {
            IfCondition EqualTo(b, 96) ThenBlock: { ch = 96 }
            IfCondition EqualTo(b, 126) ThenBlock: { ch = 126 }
            WhileLoop EqualTo(ch, b) {
                n = Add(n, 1)
                MD.Bump()
                b = MD.Peek()
            }
        }
        bad = 0
        IfCondition LessThan(n, 3) ThenBlock: { bad = 1 }
        IfCondition EqualTo(ch, 96) ThenBlock: {
            scanning = 1
            WhileLoop EqualTo(scanning, 1) {
                b2 = MD.Peek()
                IfCondition LessThan(b2, 0) ThenBlock: {
                    scanning = 0
                } ElseBlock: {
                    IfCondition EqualTo(b2, 96) ThenBlock: { bad = 1 }
                    MD.Bump()
                }
            }
        }
        IfCondition EqualTo(bad, 1) ThenBlock: {
            MC.off = o
            MC.col = c
            MC.pad = p
            ReturnValue(0)
        }
        IfCondition EqualTo(MP.make, 0) ThenBlock: {
            MC.off = o
            MC.col = c
            MC.pad = p
            ReturnValue(1)
        }
        node = MD.OpenLeaf(5, 1)
        WRMEM_64(node, 48, n)
        WRMEM_64(node, 56, ch)
        WRMEM_64(node, 64, ind)
        MC.off = o
        MC.col = c
        MC.pad = p
        MD.TakeCols(ind)
        WhileLoop LessThan(n, 1000) {
            MD.Bump()
            n = Add(n, 1)
            b3 = MD.Peek()
            IfCondition NotEqual(b3, ch) ThenBlock: { n = 1000 }
        }
        MD.SkipWs()
        info = MD.NewBlock(9)
        MD.AppendRest(info, 0)
        MD.TrimEnds(info)
        WRMEM_64(node, 24, RDMEM_64(info, 24))
        WRMEM_64(node, 32, RDMEM_64(info, 32))
        WRMEM_64(node, 40, RDMEM_64(info, 40))
        body = MD.NewBlock(9)
        WRMEM_64(node, 16, body)
        MP.ate = 1
        ReturnValue(1)
    }
}

Function.MD.TrimEnds {
    Input: node: Address
    Body: {
        data = RDMEM_64(node, 24)
        len = RDMEM_64(node, 32)
        IfCondition EqualTo(data, 0) ThenBlock: { ReturnValue(0) }
        trimming = 1
        WhileLoop EqualTo(trimming, 1) {
            IfCondition LessEqual(len, 0) ThenBlock: {
                trimming = 0
            } ElseBlock: {
                b = RDMEM_8(data, Subtract(len, 1))
                ws = 0
                IfCondition EqualTo(b, 32) ThenBlock: { ws = 1 }
                IfCondition EqualTo(b, 9) ThenBlock: { ws = 1 }
                IfCondition EqualTo(ws, 1) ThenBlock: {
                    len = Subtract(len, 1)
                    WRMEM_64(node, 32, len)
                    WRMEM_8(data, len, 0)
                } ElseBlock: {
                    trimming = 0
                }
            }
        }
    }
}

Function.MD.IsCloseFence {
    Input: node: Address
    Output: Integer
    Body: {
        o = MC.off
        c = MC.col
        p = MC.pad
        MD.TakeCols(3)
        b = MD.Peek()
        over = 0
        IfCondition EqualTo(b, 32) ThenBlock: { over = 1 }
        IfCondition EqualTo(b, 9) ThenBlock: { over = 1 }
        need = RDMEM_64(node, 48)
        ch = RDMEM_64(node, 56)
        n = 0
        IfCondition EqualTo(over, 0) ThenBlock: {
            counting = 1
            WhileLoop EqualTo(counting, 1) {
                bcl = MD.Peek()
                IfCondition EqualTo(bcl, ch) ThenBlock: {
                    n = Add(n, 1)
                    MD.Bump()
                } ElseBlock: {
                    counting = 0
                }
            }
        }
        MD.SkipWs()
        b2 = MD.Peek()
        MC.off = o
        MC.col = c
        MC.pad = p
        IfCondition LessThan(n, need) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterEqual(b2, 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(1)
    }
}

Function.MD.AppendFence {
    Input: node: Address
    Body: {
        ind = RDMEM_64(node, 64)
        MD.TakeCols(ind)
        body = RDMEM_64(node, 16)
        MD.AppendRest(body, 1)
    }
}

Function.MD.TryQuote {
    Output: Integer
    Body: {
        o = MC.off
        c = MC.col
        p = MC.pad
        MD.TakeCols(3)
        b = MD.Peek()
        over = 0
        IfCondition EqualTo(b, 32) ThenBlock: { over = 1 }
        IfCondition EqualTo(b, 9) ThenBlock: { over = 1 }
        IfCondition EqualTo(over, 1) ThenBlock: {
            MC.off = o
            MC.col = c
            MC.pad = p
            ReturnValue(0)
        }
        IfCondition NotEqual(b, 62) ThenBlock: {
            MC.off = o
            MC.col = c
            MC.pad = p
            ReturnValue(0)
        }
        IfCondition EqualTo(MP.make, 0) ThenBlock: {
            MC.off = o
            MC.col = c
            MC.pad = p
            ReturnValue(1)
        }
        MD.Bump()
        b2 = MD.Peek()
        IfCondition EqualTo(b2, 32) ThenBlock: {
            MD.Bump()
        } ElseBlock: {
            IfCondition EqualTo(b2, 9) ThenBlock: {
                rem = Modulo(MC.col, 4)
                adv = Subtract(4, rem)
                MC.off = Add(MC.off, 1)
                MC.pad = Subtract(adv, 1)
                MC.col = Add(MC.col, 1)
            }
        }
        MD.OpenLeaf(2, 1)
        ReturnValue(1)
    }
}

Function.MD.TryItem {
    Output: Integer
    Body: {
        rule = MD.IsRule()
        IfCondition EqualTo(rule, 1) ThenBlock: { ReturnValue(0) }
        o = MC.off
        c = MC.col
        p = MC.pad
        cslot = Allocate(8)
        WRMEM_64(cslot, c)
        ind = MD.TakeCols(3)
        b = MD.Peek()
        over = 0
        IfCondition EqualTo(b, 32) ThenBlock: { over = 1 }
        IfCondition EqualTo(b, 9) ThenBlock: { over = 1 }
        bullet = 0
        ordered = 0
        startn = 0
        delim = 0
        IfCondition EqualTo(over, 0) ThenBlock: {
            IfCondition EqualTo(b, 45) ThenBlock: { bullet = 45 }
            IfCondition EqualTo(b, 42) ThenBlock: { bullet = 42 }
            IfCondition EqualTo(b, 43) ThenBlock: { bullet = 43 }
            IfCondition GreaterEqual(b, 48) ThenBlock: {
                IfCondition LessEqual(b, 57) ThenBlock: {
                    digits = 0
                    val = 0
                    WhileLoop LessThan(digits, 9) {
                        b2 = MD.Peek()
                        IfCondition GreaterEqual(b2, 48) ThenBlock: {
                            IfCondition LessEqual(b2, 57) ThenBlock: {
                                val = Multiply(val, 10)
                                val = Add(val, Subtract(b2, 48))
                                digits = Add(digits, 1)
                                MD.Bump()
                            } ElseBlock: {
                                digits = 10
                            }
                        } ElseBlock: {
                            digits = 10
                        }
                    }
                    b3 = MD.Peek()
                    IfCondition EqualTo(b3, 46) ThenBlock: {
                        ordered = 1
                        delim = 46
                        startn = val
                        MD.Bump()
                    }
                    IfCondition EqualTo(b3, 41) ThenBlock: {
                        ordered = 1
                        delim = 41
                        startn = val
                        MD.Bump()
                    }
                }
            }
        }
        IfCondition NotEqual(bullet, 0) ThenBlock: { MD.Bump() }
        ok = 0
        IfCondition NotEqual(bullet, 0) ThenBlock: { ok = 1 }
        IfCondition EqualTo(ordered, 1) ThenBlock: { ok = 1 }
        IfCondition EqualTo(ok, 0) ThenBlock: {
            MC.off = o
            MC.col = c
            MC.pad = p
            ReturnValue(0)
        }
        b4 = MD.Peek()
        ws = 0
        IfCondition LessThan(b4, 0) ThenBlock: { ws = 1 }
        IfCondition EqualTo(b4, 32) ThenBlock: { ws = 1 }
        IfCondition EqualTo(b4, 9) ThenBlock: { ws = 1 }
        IfCondition EqualTo(ws, 0) ThenBlock: {
            MC.off = o
            MC.col = c
            MC.pad = p
            ReturnValue(0)
        }
        empty = 0
        IfCondition LessThan(b4, 0) ThenBlock: { empty = 1 }
        IfCondition EqualTo(MP.interrupt, 1) ThenBlock: {
            bad = 0
            IfCondition EqualTo(empty, 1) ThenBlock: { bad = 1 }
            IfCondition EqualTo(ordered, 1) ThenBlock: {
                IfCondition NotEqual(startn, 1) ThenBlock: { bad = 1 }
            }
            IfCondition EqualTo(bad, 1) ThenBlock: {
                MC.off = o
                MC.col = c
                MC.pad = p
                ReturnValue(0)
            }
        }
        tip = MD.Tip()
        tk = MD.Kind(tip)
        IfCondition EqualTo(tk, 3) ThenBlock: {
            lb = RDMEM_64(tip, 56)
            ld = RDMEM_64(tip, 64)
            same = 0
            IfCondition EqualTo(ordered, 1) ThenBlock: {
                IfCondition EqualTo(lb, 0) ThenBlock: {
                    IfCondition EqualTo(ld, delim) ThenBlock: { same = 1 }
                }
            } ElseBlock: {
                IfCondition EqualTo(lb, bullet) ThenBlock: { same = 1 }
            }
            IfCondition EqualTo(same, 0) ThenBlock: {
                MC.off = o
                MC.col = c
                MC.pad = p
                ReturnValue(0)
            }
        }
        IfCondition EqualTo(MP.make, 0) ThenBlock: {
            MC.off = o
            MC.col = c
            MC.pad = p
            ReturnValue(1)
        }
        marker_col = Add(c, ind)
        IfCondition LessThan(b4, 0) ThenBlock: {
            content = Add(MC.col, 1)
        } ElseBlock: {
            MD.TakeCols(1)
            after = MC.col
            o2 = MC.off
            c2 = MC.col
            p2 = MC.pad
            MD.SkipWs()
            b5 = MD.Peek()
            far = MC.col
            IfCondition LessThan(b5, 0) ThenBlock: {
                content = after
                MC.off = o2
                MC.col = c2
                MC.pad = p2
            } ElseBlock: {
                gap = Subtract(far, after)
                IfCondition GreaterEqual(gap, 4) ThenBlock: {
                    content = after
                    MC.off = o2
                    MC.col = c2
                    MC.pad = p2
                } ElseBlock: {
                    content = far
                }
            }
        }
        IfCondition NotEqual(tk, 3) ThenBlock: {
            list = MD.OpenLeaf(3, 1)
            WRMEM_64(list, 48, startn)
            IfCondition EqualTo(ordered, 0) ThenBlock: {
                WRMEM_64(list, 56, bullet)
                WRMEM_64(list, 48, 1)
            }
            WRMEM_64(list, 64, delim)
            WRMEM_64(list, 72, 1)
            WRMEM_64(list, 8, 0)
        } ElseBlock: {
            flag = RDMEM_64(tip, 8)
            IfCondition EqualTo(flag, 1) ThenBlock: {
                WRMEM_64(tip, 72, 0)
            }
            WRMEM_64(tip, 8, 0)
        }
        item = MD.OpenLeaf(4, 1)
        base = RDMEM_64(cslot)
        rel = Subtract(content, base)
        WRMEM_64(item, 48, rel)
        WRMEM_64(item, 56, marker_col)
        WRMEM_64(item, 8, 0)
        ReturnValue(1)
    }
}

Function.MD.TryIndent {
    Output: Integer
    Body: {
        IfCondition EqualTo(MP.interrupt, 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(MP.lineblank, 1) ThenBlock: { ReturnValue(0) }
        o = MC.off
        c = MC.col
        p = MC.pad
        got = MD.TakeCols(4)
        IfCondition LessThan(got, 4) ThenBlock: {
            MC.off = o
            MC.col = c
            MC.pad = p
            ReturnValue(0)
        }
        IfCondition EqualTo(MP.make, 0) ThenBlock: {
            MC.off = o
            MC.col = c
            MC.pad = p
            ReturnValue(1)
        }
        node = MD.OpenLeaf(5, 1)
        WRMEM_64(node, 48, 0)
        MD.AppendRest(node, 1)
        MP.ate = 1
        ReturnValue(1)
    }
}

Function.MD.CanInterrupt {
    Input: strict: Integer
    Output: Integer
    Body: {
        oldm = MP.make
        oldi = MP.interrupt
        MP.make = 0
        MP.interrupt = strict
        hit = 0
        r = MD.TryRule()
        IfCondition EqualTo(r, 1) ThenBlock: { hit = 1 }
        IfCondition EqualTo(hit, 0) ThenBlock: {
            a = MD.TryAtx()
            IfCondition EqualTo(a, 1) ThenBlock: { hit = 1 }
        }
        IfCondition EqualTo(hit, 0) ThenBlock: {
            f = MD.TryFence()
            IfCondition EqualTo(f, 1) ThenBlock: { hit = 1 }
        }
        IfCondition EqualTo(hit, 0) ThenBlock: {
            q = MD.TryQuote()
            IfCondition EqualTo(q, 1) ThenBlock: { hit = 1 }
        }
        IfCondition EqualTo(hit, 0) ThenBlock: {
            it = MD.TryItem()
            IfCondition EqualTo(it, 1) ThenBlock: { hit = 1 }
        }
        IfCondition EqualTo(hit, 0) ThenBlock: {
            MP.interrupt = 1
            h = MD.TryHtml()
            IfCondition EqualTo(h, 1) ThenBlock: { hit = 1 }
        }
        MP.make = oldm
        MP.interrupt = oldi
        ReturnValue(hit)
    }
}

Function.MD.OpenNew {
    Body: {
        guard = 0
        WhileLoop LessThan(guard, 40) {
            guard = Add(guard, 1)
            IfCondition EqualTo(MP.ate, 1) ThenBlock: {
                guard = 40
            } ElseBlock: {
                tip = MD.Tip()
                k = MD.Kind(tip)
                IfCondition EqualTo(k, 3) ThenBlock: {
                    MP.make = 1
                    MP.interrupt = 0
                    got = MD.TryItem()
                    IfCondition EqualTo(got, 0) ThenBlock: {
                        n = Array.Size(MP.open)
                        n = Subtract(n, 1)
                        MD.CloseAfter(Subtract(n, 1))
                    }
                } ElseBlock: {
                    leaf = 0
                    IfCondition EqualTo(k, 5) ThenBlock: { leaf = 1 }
                    IfCondition EqualTo(k, 6) ThenBlock: { leaf = 1 }
                    IfCondition EqualTo(k, 9) ThenBlock: { leaf = 1 }
                    IfCondition EqualTo(k, 7) ThenBlock: { leaf = 1 }
                    IfCondition EqualTo(k, 8) ThenBlock: { leaf = 1 }
                    IfCondition EqualTo(leaf, 1) ThenBlock: {
                        guard = 40
                    } ElseBlock: {
                        b = MD.Peek()
                        IfCondition LessThan(b, 0) ThenBlock: {
                            MP.ate = 1
                            guard = 40
                        } ElseBlock: {
                            MP.make = 1
                            MP.interrupt = 0
                            got2 = MD.TryQuote()
                            IfCondition EqualTo(got2, 0) ThenBlock: { got2 = MD.TryAtx() }
                            IfCondition EqualTo(got2, 0) ThenBlock: { got2 = MD.TryFence() }
                            IfCondition EqualTo(got2, 0) ThenBlock: { got2 = MD.TryRule() }
                            IfCondition EqualTo(got2, 0) ThenBlock: { got2 = MD.TryItem() }
                            IfCondition EqualTo(got2, 0) ThenBlock: { got2 = MD.TryHtml() }
                            IfCondition EqualTo(got2, 0) ThenBlock: { got2 = MD.TryIndent() }
                            IfCondition EqualTo(got2, 0) ThenBlock: {
                                para = MD.OpenLeaf(9, 1)
                                MD.AppendPara(para)
                                MP.ate = 1
                            }
                        }
                    }
                }
            }
        }
    }
}

Function.MD.FeedCode {
    Input: tip: Address
    Output: Integer
    Body: {
        fence = RDMEM_64(tip, 48)
        IfCondition GreaterThan(fence, 0) ThenBlock: {
            cl = MD.IsCloseFence(tip)
            IfCondition EqualTo(cl, 1) ThenBlock: {
                Array.Pop(MP.open)
                MP.ate = 1
                ReturnValue(1)
            }
            MD.AppendFence(tip)
            MP.ate = 1
            ReturnValue(1)
        }
        o = MC.off
        c = MC.col
        p = MC.pad
        got = MD.TakeCols(4)
        IfCondition EqualTo(got, 4) ThenBlock: {
            MD.AppendRest(tip, 1)
            MP.ate = 1
            ReturnValue(1)
        }
        MC.off = o
        MC.col = c
        MC.pad = p
        IfCondition EqualTo(MP.lineblank, 1) ThenBlock: {
            MD.AddNl(tip)
            MP.ate = 1
            ReturnValue(1)
        }
        MD.StripCodeEnd(tip)
        Array.Pop(MP.open)
        ReturnValue(0)
    }
}

Function.MD.FeedLine {
    Input: li: Integer
    Body: {
        MD.Begin(li)
        n = Array.Size(MP.open)
        MP.matched = 0
        i = 1
        walking = 1
        WhileLoop EqualTo(walking, 1) {
            IfCondition GreaterEqual(i, n) ThenBlock: {
                walking = 0
            } ElseBlock: {
                node = Array.Get(MP.open, i)
                k = MD.Kind(node)
                leaf = 0
                IfCondition EqualTo(k, 5) ThenBlock: { leaf = 1 }
                IfCondition EqualTo(k, 6) ThenBlock: { leaf = 1 }
                IfCondition EqualTo(k, 9) ThenBlock: { leaf = 1 }
                IfCondition EqualTo(leaf, 1) ThenBlock: {
                    walking = 0
                } ElseBlock: {
                    ok = MD.MatchCont(node)
                    IfCondition EqualTo(ok, 1) ThenBlock: {
                        MP.matched = i
                        i = Add(i, 1)
                    } ElseBlock: {
                        walking = 0
                    }
                }
            }
        }
        rb = MD.RestBlank()
        IfCondition EqualTo(rb, 1) ThenBlock: {
            MP.lineblank = 1
        }
        tip = MD.Tip()
        tk = MD.Kind(tip)
        ti = Array.Size(MP.open)
        ti = Subtract(ti, 1)
        parent_ok = 0
        need = Add(MP.matched, 1)
        IfCondition EqualTo(ti, need) ThenBlock: { parent_ok = 1 }
        IfCondition EqualTo(tk, 5) ThenBlock: {
            IfCondition EqualTo(parent_ok, 1) ThenBlock: {
                MD.FeedCode(tip)
            }
        }
        IfCondition EqualTo(MP.ate, 1) ThenBlock: { ReturnValue(0) }
        tip = MD.Tip()
        tk = MD.Kind(tip)
        IfCondition EqualTo(tk, 6) ThenBlock: {
            IfCondition EqualTo(parent_ok, 1) ThenBlock: {
                MD.FeedHtml(tip)
            }
        }
        IfCondition EqualTo(MP.ate, 1) ThenBlock: { ReturnValue(0) }
        tip = MD.Tip()
        tk = MD.Kind(tip)
        IfCondition EqualTo(tk, 9) ThenBlock: {
            IfCondition EqualTo(parent_ok, 1) ThenBlock: {
                IfCondition EqualTo(MP.lineblank, 1) ThenBlock: {
                    Array.Pop(MP.open)
                    gone = MD.TakeRefs(tip)
                    IfCondition EqualTo(gone, 1) ThenBlock: {
                        parent = MD.Tip()
                        kids = RDMEM_64(parent, 16)
                        Array.Pop(kids)
                    }
                    MD.NoteBlank()
                    MP.ate = 1
                } ElseBlock: {
                    lv = MD.IsSetext()
                    IfCondition GreaterThan(lv, 0) ThenBlock: {
                        gone3 = MD.TakeRefs(tip)
                        tlen3 = RDMEM_64(tip, 32)
                        IfCondition EqualTo(tlen3, 0) ThenBlock: {
                            Array.Pop(MP.open)
                            parent3 = MD.Tip()
                            kids3 = RDMEM_64(parent3, 16)
                            Array.Pop(kids3)
                        } ElseBlock: {
                            MD.TrimEnd(tip)
                            WRMEM_64(tip, 0, 7)
                            WRMEM_64(tip, 48, lv)
                            Array.Pop(MP.open)
                            MP.ate = 1
                        }
                    } ElseBlock: {
                        hit = MD.CanInterrupt(1)
                        IfCondition EqualTo(hit, 1) ThenBlock: {
                            Array.Pop(MP.open)
                            gone2 = MD.TakeRefs(tip)
                            IfCondition EqualTo(gone2, 1) ThenBlock: {
                                parent2 = MD.Tip()
                                kids2 = RDMEM_64(parent2, 16)
                                Array.Pop(kids2)
                            }
                            MD.OpenNew()
                        } ElseBlock: {
                            MD.AppendPara(tip)
                            MP.ate = 1
                        }
                    }
                }
            } ElseBlock: {
                IfCondition EqualTo(MP.lineblank, 1) ThenBlock: {
                    MD.CloseAfter(MP.matched)
                    MD.NoteBlank()
                    MP.ate = 1
                } ElseBlock: {
                    hit2 = MD.CanInterrupt(0)
                    IfCondition EqualTo(hit2, 1) ThenBlock: {
                        MD.CloseAfter(MP.matched)
                        MD.OpenNew()
                    } ElseBlock: {
                        MD.AppendPara(tip)
                        MP.ate = 1
                    }
                }
            }
        }
        IfCondition EqualTo(MP.ate, 1) ThenBlock: { ReturnValue(0) }
        tip = MD.Tip()
        tk = MD.Kind(tip)
        IfCondition EqualTo(tk, 5) ThenBlock: {
            MD.CloseAfter(MP.matched)
        }
        IfCondition EqualTo(tk, 6) ThenBlock: {
            MD.CloseAfter(MP.matched)
        }
        IfCondition EqualTo(MP.lineblank, 1) ThenBlock: {
            ti2 = Array.Size(MP.open)
            ti2 = Subtract(ti2, 1)
            IfCondition GreaterThan(ti2, MP.matched) ThenBlock: {
                MD.CloseAfter(MP.matched)
            }
            MD.NoteBlank()
            MP.ate = 1
            ReturnValue(0)
        }
        tip = MD.Tip()
        tk = MD.Kind(tip)
        cont = 0
        IfCondition EqualTo(tk, 2) ThenBlock: { cont = 1 }
        IfCondition EqualTo(tk, 4) ThenBlock: { cont = 1 }
        IfCondition EqualTo(cont, 1) ThenBlock: {
            ti3 = Array.Size(MP.open)
            ti3 = Subtract(ti3, 1)
            IfCondition NotEqual(ti3, MP.matched) ThenBlock: {
                o = MC.off
                c = MC.col
                p = MC.pad
                mok = MD.MatchCont(tip)
                IfCondition EqualTo(mok, 0) ThenBlock: {
                    MC.off = o
                    MC.col = c
                    MC.pad = p
                    MD.CloseAfter(MP.matched)
                }
            }
        }
        MD.OpenNew()
    }
}

Function.MD.ParseDoc {
    Body: {
        i = 0
        n = MP.nlines
        WhileLoop LessThan(i, n) {
            MD.FeedLine(i)
            i = Add(i, 1)
        }
        MD.FinishAll()
    }
}

