Function.MD.HrefSafe {
    Input: b: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(b, 33) ThenBlock: { ReturnValue(1) }
        IfCondition GreaterEqual(b, 35) ThenBlock: {
            IfCondition LessEqual(b, 37) ThenBlock: { ReturnValue(1) }
        }
        IfCondition GreaterEqual(b, 40) ThenBlock: {
            IfCondition LessEqual(b, 59) ThenBlock: { ReturnValue(1) }
        }
        IfCondition EqualTo(b, 61) ThenBlock: { ReturnValue(1) }
        IfCondition GreaterEqual(b, 63) ThenBlock: {
            IfCondition LessEqual(b, 90) ThenBlock: { ReturnValue(1) }
        }
        IfCondition EqualTo(b, 95) ThenBlock: { ReturnValue(1) }
        IfCondition GreaterEqual(b, 97) ThenBlock: {
            IfCondition LessEqual(b, 122) ThenBlock: { ReturnValue(1) }
        }
        IfCondition EqualTo(b, 126) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

Function.MD.EmitNum {
    Input: n: Integer
    Body: {
        IfCondition EqualTo(n, 0) ThenBlock: {
            MB.Byte(48)
            ReturnValue(0)
        }
        tmp = Allocate(24)
        i = 0
        v = n
        WhileLoop GreaterThan(v, 0) {
            d = Modulo(v, 10)
            WRMEM_8(tmp, i, Add(48, d))
            i = Add(i, 1)
            v = Divide(v, 10)
        }
        WhileLoop GreaterThan(i, 0) {
            i = Subtract(i, 1)
            MB.Byte(RDMEM_8(tmp, i))
        }
    }
}

Function.MD.EscRun {
    Input: data: Address
    Input: n: Integer
    Body: {
        IfCondition EqualTo(data, 0) ThenBlock: { ReturnValue(0) }
        i = 0
        WhileLoop LessThan(i, n) {
            b = RDMEM_8(data, i)
            IfCondition EqualTo(b, 38) ThenBlock: {
                MB.Str("&amp;")
            } ElseBlock: {
                IfCondition EqualTo(b, 60) ThenBlock: {
                    MB.Str("&lt;")
                } ElseBlock: {
                    IfCondition EqualTo(b, 62) ThenBlock: {
                        MB.Str("&gt;")
                    } ElseBlock: {
                        IfCondition EqualTo(b, 34) ThenBlock: {
                            MB.Str("&quot;")
                        } ElseBlock: {
                            MB.Byte(b)
                        }
                    }
                }
            }
            i = Add(i, 1)
        }
    }
}

Function.MD.EscHref {
    Input: data: Address
    Input: n: Integer
    Body: {
        IfCondition EqualTo(data, 0) ThenBlock: { ReturnValue(0) }
        hex = "0123456789ABCDEF"
        i = 0
        WhileLoop LessThan(i, n) {
            b = RDMEM_8(data, i)
            safe = MD.HrefSafe(b)
            IfCondition EqualTo(safe, 1) ThenBlock: {
                MB.Byte(b)
            } ElseBlock: {
                IfCondition EqualTo(b, 38) ThenBlock: {
                    MB.Str("&amp;")
                } ElseBlock: {
                    IfCondition EqualTo(b, 39) ThenBlock: {
                        MB.Str("&#x27;")
                    } ElseBlock: {
                        hi = Divide(b, 16)
                        lo = Modulo(b, 16)
                        MB.Byte(37)
                        MB.Byte(RDMEM_8(hex, hi))
                        MB.Byte(RDMEM_8(hex, lo))
                    }
                }
            }
            i = Add(i, 1)
        }
    }
}

Function.MD.AltWalk {
    Input: node: Address
    Input: buf: Address
    Input: n: Integer
    Output: Integer
    Body: {
        cur = node
        WhileLoop NotEqual(cur, 0) {
            IfCondition GreaterEqual(n, 4000) ThenBlock: { ReturnValue(n) }
            k = RDMEM_64(cur)
            IfCondition EqualTo(k, 1) ThenBlock: {
                data = RDMEM_64(cur, 16)
                ln = RDMEM_64(cur, 24)
                j = 0
                WhileLoop LessThan(j, ln) {
                    IfCondition LessThan(n, 4000) ThenBlock: {
                        WRMEM_8(buf, n, RDMEM_8(data, j))
                        n = Add(n, 1)
                    }
                    j = Add(j, 1)
                }
            }
            IfCondition EqualTo(k, 2) ThenBlock: {
                data2 = RDMEM_64(cur, 16)
                ln2 = RDMEM_64(cur, 24)
                j2 = 0
                WhileLoop LessThan(j2, ln2) {
                    IfCondition LessThan(n, 4000) ThenBlock: {
                        WRMEM_8(buf, n, RDMEM_8(data2, j2))
                        n = Add(n, 1)
                    }
                    j2 = Add(j2, 1)
                }
            }
            nest = 0
            IfCondition EqualTo(k, 3) ThenBlock: { nest = 1 }
            IfCondition EqualTo(k, 4) ThenBlock: { nest = 1 }
            IfCondition EqualTo(k, 5) ThenBlock: { nest = 1 }
            IfCondition EqualTo(k, 6) ThenBlock: { nest = 1 }
            IfCondition EqualTo(nest, 1) ThenBlock: {
                n = MD.AltWalk(RDMEM_64(cur, 16), buf, n)
            }
            IfCondition EqualTo(k, 8) ThenBlock: {
                WRMEM_8(buf, n, 10)
                n = Add(n, 1)
            }
            IfCondition EqualTo(k, 9) ThenBlock: {
                WRMEM_8(buf, n, 10)
                n = Add(n, 1)
            }
            cur = RDMEM_64(cur, 8)
        }
        ReturnValue(n)
    }
}

Function.MD.WordWalk {
    Input: node: Address
    Input: buf: Address
    Input: n: Integer
    Output: Integer
    Body: {
        IfCondition GreaterEqual(n, 1000000) ThenBlock: { ReturnValue(n) }
        cur = node
        WhileLoop NotEqual(cur, 0) {
            IfCondition GreaterEqual(n, 1000000) ThenBlock: { ReturnValue(n) }
            k = RDMEM_64(cur)
            plain = 0
            IfCondition EqualTo(k, 1) ThenBlock: { plain = 1 }
            IfCondition EqualTo(k, 2) ThenBlock: { plain = 1 }
            IfCondition EqualTo(plain, 1) ThenBlock: {
                data = RDMEM_64(cur, 16)
                ln = RDMEM_64(cur, 24)
                j = 0
                WhileLoop LessThan(j, ln) {
                    b = RDMEM_8(data, j)
                    IfCondition EqualTo(b, 32) ThenBlock: {
                        ReturnValue(Add(n, 1000000))
                    }
                    IfCondition EqualTo(b, 9) ThenBlock: {
                        ReturnValue(Add(n, 1000000))
                    }
                    IfCondition LessThan(n, 200) ThenBlock: {
                        WRMEM_8(buf, n, b)
                        n = Add(n, 1)
                    }
                    j = Add(j, 1)
                }
            } ElseBlock: {
                nest = 0
                IfCondition EqualTo(k, 3) ThenBlock: { nest = 1 }
                IfCondition EqualTo(k, 4) ThenBlock: { nest = 1 }
                IfCondition EqualTo(k, 5) ThenBlock: { nest = 1 }
                IfCondition EqualTo(nest, 1) ThenBlock: {
                    n = MD.WordWalk(RDMEM_64(cur, 16), buf, n)
                }
            }
            cur = RDMEM_64(cur, 8)
        }
        ReturnValue(n)
    }
}

Function.MD.RenderIn {
    Input: node: Address
    Body: {
        cur = node
        WhileLoop NotEqual(cur, 0) {
            k = RDMEM_64(cur)
            IfCondition EqualTo(k, 1) ThenBlock: {
                MD.EscRun(RDMEM_64(cur, 16), RDMEM_64(cur, 24))
            }
            IfCondition EqualTo(k, 2) ThenBlock: {
                MB.Str("<code>")
                MD.EscRun(RDMEM_64(cur, 16), RDMEM_64(cur, 24))
                MB.Str("</code>")
            }
            IfCondition EqualTo(k, 3) ThenBlock: {
                MB.Str("<em>")
                MD.RenderIn(RDMEM_64(cur, 16))
                MB.Str("</em>")
            }
            IfCondition EqualTo(k, 4) ThenBlock: {
                MB.Str("<strong>")
                MD.RenderIn(RDMEM_64(cur, 16))
                MB.Str("</strong>")
            }
            IfCondition EqualTo(k, 5) ThenBlock: {
                MB.Str("<a href=\"")
                MD.EscHref(RDMEM_64(cur, 24), RDMEM_64(cur, 32))
                MB.Byte(34)
                tlen = RDMEM_64(cur, 48)
                IfCondition GreaterThan(tlen, 0) ThenBlock: {
                    MB.Str(" title=\"")
                    MD.EscRun(RDMEM_64(cur, 40), tlen)
                    MB.Byte(34)
                }
                MB.Byte(62)
                MD.RenderIn(RDMEM_64(cur, 16))
                MB.Str("</a>")
            }
            IfCondition EqualTo(k, 6) ThenBlock: {
                MB.Str("<img src=\"")
                MD.EscHref(RDMEM_64(cur, 24), RDMEM_64(cur, 32))
                MB.Str("\" alt=\"")
                abuf = Allocate(4096)
                an = MD.AltWalk(RDMEM_64(cur, 16), abuf, 0)
                MD.EscRun(abuf, an)
                MB.Byte(34)
                tlen2 = RDMEM_64(cur, 48)
                IfCondition GreaterThan(tlen2, 0) ThenBlock: {
                    MB.Str(" title=\"")
                    MD.EscRun(RDMEM_64(cur, 40), tlen2)
                    MB.Byte(34)
                }
                MB.Str(" />")
            }
            IfCondition EqualTo(k, 7) ThenBlock: {
                data7 = RDMEM_64(cur, 16)
                ln7 = RDMEM_64(cur, 24)
                j7 = 0
                WhileLoop LessThan(j7, ln7) {
                    MB.Byte(RDMEM_8(data7, j7))
                    j7 = Add(j7, 1)
                }
            }
            IfCondition EqualTo(k, 8) ThenBlock: {
                MB.Str("<br />\n")
            }
            IfCondition EqualTo(k, 9) ThenBlock: {
                MB.Byte(10)
            }
            cur = RDMEM_64(cur, 8)
        }
    }
}

Function.MD.RenderKids {
    Input: node: Address
    Input: tight: Integer
    Body: {
        kids = RDMEM_64(node, 16)
        IfCondition EqualTo(kids, 0) ThenBlock: { ReturnValue(0) }
        n = Array.Size(kids)
        i = 0
        WhileLoop LessThan(i, n) {
            ch = Array.Get(kids, i)
            MD.RenderBlock(ch, tight)
            i = Add(i, 1)
        }
    }
}

Function.MD.RenderBlock {
    Input: node: Address
    Input: tight: Integer
    Body: {
        k = MD.Kind(node)
        IfCondition EqualTo(k, 1) ThenBlock: {
            MD.RenderKids(node, 0)
            ReturnValue(0)
        }
        IfCondition EqualTo(k, 2) ThenBlock: {
            MB.Str("<blockquote>\n")
            MD.RenderKids(node, 0)
            MB.Str("</blockquote>\n")
            ReturnValue(0)
        }
        IfCondition EqualTo(k, 3) ThenBlock: {
            bullet = RDMEM_64(node, 56)
            IfCondition EqualTo(bullet, 0) ThenBlock: {
                MB.Str("<ol")
                start = RDMEM_64(node, 48)
                IfCondition NotEqual(start, 1) ThenBlock: {
                    MB.Str(" start=\"")
                    MD.EmitNum(start)
                    MB.Byte(34)
                }
                MB.Str(">\n")
                MD.RenderKids(node, RDMEM_64(node, 72))
                MB.Str("</ol>\n")
            } ElseBlock: {
                MB.Str("<ul>\n")
                MD.RenderKids(node, RDMEM_64(node, 72))
                MB.Str("</ul>\n")
            }
            ReturnValue(0)
        }
        IfCondition EqualTo(k, 4) ThenBlock: {
            MB.Str("<li>")
            kids = RDMEM_64(node, 16)
            n = 0
            IfCondition NotEqual(kids, 0) ThenBlock: { n = Array.Size(kids) }
            IfCondition EqualTo(n, 0) ThenBlock: {
                MB.Str("</li>\n")
                ReturnValue(0)
            }
            first = Array.Get(kids, 0)
            fk = MD.Kind(first)
            nl = 1
            IfCondition EqualTo(fk, 9) ThenBlock: {
                IfCondition EqualTo(tight, 1) ThenBlock: { nl = 0 }
            }
            IfCondition EqualTo(nl, 1) ThenBlock: { MB.Byte(10) }
            i = 0
            WhileLoop LessThan(i, n) {
                ch = Array.Get(kids, i)
                ck = MD.Kind(ch)
                IfCondition EqualTo(ck, 9) ThenBlock: {
                    IfCondition EqualTo(tight, 1) ThenBlock: {
                        text = RDMEM_64(ch, 24)
                        tlen = RDMEM_64(ch, 32)
                        ins = MD.ParseInlines(text, tlen)
                        MD.RenderIn(ins)
                        nxt = Add(i, 1)
                        IfCondition LessThan(nxt, n) ThenBlock: { MB.Byte(10) }
                    } ElseBlock: {
                        MD.RenderBlock(ch, 0)
                    }
                } ElseBlock: {
                    MD.RenderBlock(ch, 0)
                }
                i = Add(i, 1)
            }
            MB.Str("</li>\n")
            ReturnValue(0)
        }
        IfCondition EqualTo(k, 5) ThenBlock: {
            MB.Str("<pre><code")
            fence = RDMEM_64(node, 48)
            body = node
            IfCondition GreaterThan(fence, 0) ThenBlock: {
                itxt = RDMEM_64(node, 24)
                ilen = RDMEM_64(node, 32)
                IfCondition GreaterThan(ilen, 0) ThenBlock: {
                    head = MD.ParseInlines(itxt, ilen)
                    wbuf = Allocate(256)
                    wn = MD.WordWalk(head, wbuf, 0)
                    IfCondition GreaterEqual(wn, 1000000) ThenBlock: {
                        wn = Subtract(wn, 1000000)
                    }
                    IfCondition GreaterThan(wn, 0) ThenBlock: {
                        MB.Str(" class=\"language-")
                        MD.EscRun(wbuf, wn)
                        MB.Byte(34)
                    }
                }
                body = RDMEM_64(node, 16)
            }
            MB.Byte(62)
            IfCondition NotEqual(body, 0) ThenBlock: {
                MD.EscRun(RDMEM_64(body, 24), RDMEM_64(body, 32))
            }
            MB.Str("</code></pre>\n")
            ReturnValue(0)
        }
        IfCondition EqualTo(k, 6) ThenBlock: {
            MD.EscRun(RDMEM_64(node, 24), 0)
            data = RDMEM_64(node, 24)
            ln = RDMEM_64(node, 32)
            j = 0
            WhileLoop LessThan(j, ln) {
                MB.Byte(RDMEM_8(data, j))
                j = Add(j, 1)
            }
            ReturnValue(0)
        }
        IfCondition EqualTo(k, 7) ThenBlock: {
            lv = RDMEM_64(node, 48)
            MB.Str("<h")
            MB.Byte(Add(48, lv))
            MB.Byte(62)
            ins = MD.ParseInlines(RDMEM_64(node, 24), RDMEM_64(node, 32))
            MD.RenderIn(ins)
            MB.Str("</h")
            MB.Byte(Add(48, lv))
            MB.Str(">\n")
            ReturnValue(0)
        }
        IfCondition EqualTo(k, 8) ThenBlock: {
            MB.Str("<hr />\n")
            ReturnValue(0)
        }
        IfCondition EqualTo(k, 9) ThenBlock: {
            IfCondition EqualTo(tight, 0) ThenBlock: { MB.Str("<p>") }
            ins2 = MD.ParseInlines(RDMEM_64(node, 24), RDMEM_64(node, 32))
            MD.RenderIn(ins2)
            IfCondition EqualTo(tight, 0) ThenBlock: { MB.Str("</p>\n") }
        }
    }
}

Function.MD.Render {
    Input: doc: Address
    Output: Address
    Body: {
        IfCondition EqualTo(MB.cap, 0) ThenBlock: {
            MB.data = Allocate(256)
            MB.cap = 256
            MB.len = 0
        }
        MB.len = 0
        MD.RenderBlock(doc, 0)
        ReturnValue(MB.Take())
    }
}
