Function.MD.BlockTag {
    Input: s: Address
    Output: Integer
    Body: {
        hit = 0
        c = StringCompare(s, "address")
        IfCondition EqualTo(c, 0) ThenBlock: { hit = 1 }
        c2 = StringCompare(s, "article")
        IfCondition EqualTo(c2, 0) ThenBlock: { hit = 1 }
        c3 = StringCompare(s, "aside")
        IfCondition EqualTo(c3, 0) ThenBlock: { hit = 1 }
        c4 = StringCompare(s, "base")
        IfCondition EqualTo(c4, 0) ThenBlock: { hit = 1 }
        c5 = StringCompare(s, "basefont")
        IfCondition EqualTo(c5, 0) ThenBlock: { hit = 1 }
        c6 = StringCompare(s, "blockquote")
        IfCondition EqualTo(c6, 0) ThenBlock: { hit = 1 }
        c7 = StringCompare(s, "body")
        IfCondition EqualTo(c7, 0) ThenBlock: { hit = 1 }
        c8 = StringCompare(s, "caption")
        IfCondition EqualTo(c8, 0) ThenBlock: { hit = 1 }
        c9 = StringCompare(s, "center")
        IfCondition EqualTo(c9, 0) ThenBlock: { hit = 1 }
        c10 = StringCompare(s, "col")
        IfCondition EqualTo(c10, 0) ThenBlock: { hit = 1 }
        c11 = StringCompare(s, "colgroup")
        IfCondition EqualTo(c11, 0) ThenBlock: { hit = 1 }
        c12 = StringCompare(s, "dd")
        IfCondition EqualTo(c12, 0) ThenBlock: { hit = 1 }
        c13 = StringCompare(s, "details")
        IfCondition EqualTo(c13, 0) ThenBlock: { hit = 1 }
        c14 = StringCompare(s, "dialog")
        IfCondition EqualTo(c14, 0) ThenBlock: { hit = 1 }
        c15 = StringCompare(s, "dir")
        IfCondition EqualTo(c15, 0) ThenBlock: { hit = 1 }
        c16 = StringCompare(s, "div")
        IfCondition EqualTo(c16, 0) ThenBlock: { hit = 1 }
        c17 = StringCompare(s, "dl")
        IfCondition EqualTo(c17, 0) ThenBlock: { hit = 1 }
        c18 = StringCompare(s, "dt")
        IfCondition EqualTo(c18, 0) ThenBlock: { hit = 1 }
        c19 = StringCompare(s, "fieldset")
        IfCondition EqualTo(c19, 0) ThenBlock: { hit = 1 }
        c20 = StringCompare(s, "figcaption")
        IfCondition EqualTo(c20, 0) ThenBlock: { hit = 1 }
        c21 = StringCompare(s, "figure")
        IfCondition EqualTo(c21, 0) ThenBlock: { hit = 1 }
        c22 = StringCompare(s, "footer")
        IfCondition EqualTo(c22, 0) ThenBlock: { hit = 1 }
        c23 = StringCompare(s, "form")
        IfCondition EqualTo(c23, 0) ThenBlock: { hit = 1 }
        c24 = StringCompare(s, "frame")
        IfCondition EqualTo(c24, 0) ThenBlock: { hit = 1 }
        c25 = StringCompare(s, "frameset")
        IfCondition EqualTo(c25, 0) ThenBlock: { hit = 1 }
        c26 = StringCompare(s, "h1")
        IfCondition EqualTo(c26, 0) ThenBlock: { hit = 1 }
        c27 = StringCompare(s, "h2")
        IfCondition EqualTo(c27, 0) ThenBlock: { hit = 1 }
        c28 = StringCompare(s, "h3")
        IfCondition EqualTo(c28, 0) ThenBlock: { hit = 1 }
        c29 = StringCompare(s, "h4")
        IfCondition EqualTo(c29, 0) ThenBlock: { hit = 1 }
        c30 = StringCompare(s, "h5")
        IfCondition EqualTo(c30, 0) ThenBlock: { hit = 1 }
        c31 = StringCompare(s, "h6")
        IfCondition EqualTo(c31, 0) ThenBlock: { hit = 1 }
        c32 = StringCompare(s, "head")
        IfCondition EqualTo(c32, 0) ThenBlock: { hit = 1 }
        c33 = StringCompare(s, "header")
        IfCondition EqualTo(c33, 0) ThenBlock: { hit = 1 }
        c34 = StringCompare(s, "hr")
        IfCondition EqualTo(c34, 0) ThenBlock: { hit = 1 }
        c35 = StringCompare(s, "html")
        IfCondition EqualTo(c35, 0) ThenBlock: { hit = 1 }
        c36 = StringCompare(s, "iframe")
        IfCondition EqualTo(c36, 0) ThenBlock: { hit = 1 }
        c37 = StringCompare(s, "legend")
        IfCondition EqualTo(c37, 0) ThenBlock: { hit = 1 }
        c38 = StringCompare(s, "li")
        IfCondition EqualTo(c38, 0) ThenBlock: { hit = 1 }
        c39 = StringCompare(s, "link")
        IfCondition EqualTo(c39, 0) ThenBlock: { hit = 1 }
        c40 = StringCompare(s, "main")
        IfCondition EqualTo(c40, 0) ThenBlock: { hit = 1 }
        c41 = StringCompare(s, "menu")
        IfCondition EqualTo(c41, 0) ThenBlock: { hit = 1 }
        c42 = StringCompare(s, "menuitem")
        IfCondition EqualTo(c42, 0) ThenBlock: { hit = 1 }
        c43 = StringCompare(s, "nav")
        IfCondition EqualTo(c43, 0) ThenBlock: { hit = 1 }
        c44 = StringCompare(s, "noframes")
        IfCondition EqualTo(c44, 0) ThenBlock: { hit = 1 }
        c45 = StringCompare(s, "ol")
        IfCondition EqualTo(c45, 0) ThenBlock: { hit = 1 }
        c46 = StringCompare(s, "optgroup")
        IfCondition EqualTo(c46, 0) ThenBlock: { hit = 1 }
        c47 = StringCompare(s, "option")
        IfCondition EqualTo(c47, 0) ThenBlock: { hit = 1 }
        c48 = StringCompare(s, "p")
        IfCondition EqualTo(c48, 0) ThenBlock: { hit = 1 }
        c49 = StringCompare(s, "param")
        IfCondition EqualTo(c49, 0) ThenBlock: { hit = 1 }
        c50 = StringCompare(s, "search")
        IfCondition EqualTo(c50, 0) ThenBlock: { hit = 1 }
        c51 = StringCompare(s, "section")
        IfCondition EqualTo(c51, 0) ThenBlock: { hit = 1 }
        c52 = StringCompare(s, "summary")
        IfCondition EqualTo(c52, 0) ThenBlock: { hit = 1 }
        c53 = StringCompare(s, "table")
        IfCondition EqualTo(c53, 0) ThenBlock: { hit = 1 }
        c54 = StringCompare(s, "tbody")
        IfCondition EqualTo(c54, 0) ThenBlock: { hit = 1 }
        c55 = StringCompare(s, "td")
        IfCondition EqualTo(c55, 0) ThenBlock: { hit = 1 }
        c56 = StringCompare(s, "tfoot")
        IfCondition EqualTo(c56, 0) ThenBlock: { hit = 1 }
        c57 = StringCompare(s, "th")
        IfCondition EqualTo(c57, 0) ThenBlock: { hit = 1 }
        c58 = StringCompare(s, "thead")
        IfCondition EqualTo(c58, 0) ThenBlock: { hit = 1 }
        c59 = StringCompare(s, "title")
        IfCondition EqualTo(c59, 0) ThenBlock: { hit = 1 }
        c60 = StringCompare(s, "tr")
        IfCondition EqualTo(c60, 0) ThenBlock: { hit = 1 }
        c61 = StringCompare(s, "track")
        IfCondition EqualTo(c61, 0) ThenBlock: { hit = 1 }
        c62 = StringCompare(s, "ul")
        IfCondition EqualTo(c62, 0) ThenBlock: { hit = 1 }
        ReturnValue(hit)
    }
}

Function.MD.ReadName {
    Output: Address
    Body: {
        buf = Allocate(64)
        n = 0
        b = MD.Peek()
        letter = 0
        low = MD.Lower(b)
        IfCondition GreaterEqual(low, 97) ThenBlock: {
            IfCondition LessEqual(low, 122) ThenBlock: { letter = 1 }
        }
        IfCondition EqualTo(letter, 0) ThenBlock: {
            WRMEM_8(buf, 0, 0)
            ReturnValue(buf)
        }
        WhileLoop LessThan(n, 60) {
            b2 = MD.Peek()
            low2 = MD.Lower(b2)
            ok = 0
            IfCondition GreaterEqual(low2, 97) ThenBlock: {
                IfCondition LessEqual(low2, 122) ThenBlock: { ok = 1 }
            }
            IfCondition GreaterEqual(b2, 48) ThenBlock: {
                IfCondition LessEqual(b2, 57) ThenBlock: { ok = 1 }
            }
            IfCondition EqualTo(b2, 45) ThenBlock: { ok = 1 }
            IfCondition EqualTo(ok, 0) ThenBlock: {
                n = 60
            } ElseBlock: {
                WRMEM_8(buf, n, low2)
                n = Add(n, 1)
                MD.Bump()
            }
        }
        WRMEM_8(buf, n, 0)
        ReturnValue(buf)
    }
}

Function.MD.HtmlType {
    Output: Integer
    Body: {
        o = MC.off
        c = MC.col
        p = MC.pad
        MD.TakeCols(3)
        b = MD.Peek()
        over = 0
        IfCondition EqualTo(b, 32) ThenBlock: { over = 1 }
        IfCondition EqualTo(b, 9) ThenBlock: { over = 1 }
        IfCondition EqualTo(over, 1) ThenBlock: {
            MC.off = o
            MC.col = c
            MC.pad = p
            ReturnValue(0)
        }
        IfCondition NotEqual(b, 60) ThenBlock: {
            MC.off = o
            MC.col = c
            MC.pad = p
            ReturnValue(0)
        }
        MD.Bump()
        b2 = MD.Peek()
        typ = 0
        IfCondition EqualTo(b2, 33) ThenBlock: {
            MD.Bump()
            b3 = MD.Peek()
            IfCondition EqualTo(b3, 45) ThenBlock: {
                MD.Bump()
                b4 = MD.Peek()
                IfCondition EqualTo(b4, 45) ThenBlock: { typ = 2 }
            } ElseBlock: {
                IfCondition EqualTo(b3, 91) ThenBlock: {
                    MD.Bump()
                    cdata = MD.Peek()
                    IfCondition EqualTo(cdata, 67) ThenBlock: { typ = 5 }
                    IfCondition EqualTo(cdata, 99) ThenBlock: { typ = 5 }
                } ElseBlock: {
                    up = 0
                    IfCondition GreaterEqual(b3, 65) ThenBlock: {
                        IfCondition LessEqual(b3, 90) ThenBlock: { up = 1 }
                    }
                    IfCondition EqualTo(up, 1) ThenBlock: { typ = 4 }
                }
            }
        } ElseBlock: {
            IfCondition EqualTo(b2, 63) ThenBlock: {
                typ = 3
            } ElseBlock: {
                close = 0
                IfCondition EqualTo(b2, 47) ThenBlock: {
                    close = 1
                    MD.Bump()
                }
                name = MD.ReadName()
                nlen = StringLength(name)
                IfCondition GreaterThan(nlen, 0) ThenBlock: {
                    t1 = 0
                    s1 = StringCompare(name, "script")
                    IfCondition EqualTo(s1, 0) ThenBlock: { t1 = 1 }
                    s2 = StringCompare(name, "pre")
                    IfCondition EqualTo(s2, 0) ThenBlock: { t1 = 1 }
                    s3 = StringCompare(name, "style")
                    IfCondition EqualTo(s3, 0) ThenBlock: { t1 = 1 }
                    s4 = StringCompare(name, "textarea")
                    IfCondition EqualTo(s4, 0) ThenBlock: { t1 = 1 }
                    IfCondition EqualTo(t1, 1) ThenBlock: {
                        IfCondition EqualTo(close, 0) ThenBlock: {
                            nb = MD.Peek()
                            sep = 0
                            IfCondition LessThan(nb, 0) ThenBlock: { sep = 1 }
                            IfCondition EqualTo(nb, 32) ThenBlock: { sep = 1 }
                            IfCondition EqualTo(nb, 9) ThenBlock: { sep = 1 }
                            IfCondition EqualTo(nb, 62) ThenBlock: { sep = 1 }
                            IfCondition EqualTo(nb, 47) ThenBlock: { sep = 1 }
                            IfCondition EqualTo(sep, 1) ThenBlock: { typ = 1 }
                        }
                    } ElseBlock: {
                        bt = MD.BlockTag(name)
                        IfCondition EqualTo(bt, 1) ThenBlock: {
                            nb2 = MD.Peek()
                            sep2 = 0
                            IfCondition LessThan(nb2, 0) ThenBlock: { sep2 = 1 }
                            IfCondition EqualTo(nb2, 32) ThenBlock: { sep2 = 1 }
                            IfCondition EqualTo(nb2, 9) ThenBlock: { sep2 = 1 }
                            IfCondition EqualTo(nb2, 62) ThenBlock: { sep2 = 1 }
                            IfCondition EqualTo(nb2, 47) ThenBlock: { sep2 = 1 }
                            IfCondition EqualTo(sep2, 1) ThenBlock: { typ = 6 }
                        }
                    }
                }
            }
        }
        MC.off = o
        MC.col = c
        MC.pad = p
        IfCondition NotEqual(typ, 0) ThenBlock: { ReturnValue(typ) }
        t7 = MD.HtmlWhole()
        ReturnValue(t7)
    }
}

Function.MD.HtmlWhole {
    Output: Integer
    Body: {
        o = MC.off
        c = MC.col
        p = MC.pad
        MD.TakeCols(3)
        b = MD.Peek()
        IfCondition NotEqual(b, 60) ThenBlock: {
            MC.off = o
            MC.col = c
            MC.pad = p
            ReturnValue(0)
        }
        MD.Bump()
        close = 0
        b2 = MD.Peek()
        IfCondition EqualTo(b2, 47) ThenBlock: {
            close = 1
            MD.Bump()
        }
        name = MD.ReadName()
        nlen = StringLength(name)
        IfCondition EqualTo(nlen, 0) ThenBlock: {
            MC.off = o
            MC.col = c
            MC.pad = p
            ReturnValue(0)
        }
        ok = 1
        IfCondition EqualTo(close, 1) ThenBlock: {
            MD.SkipWs()
            gt = MD.Peek()
            IfCondition EqualTo(gt, 62) ThenBlock: {
                MD.Bump()
            } ElseBlock: {
                ok = 0
            }
        } ElseBlock: {
            looping = 1
            WhileLoop EqualTo(looping, 1) {
                soff = MC.off
                scol = MC.col
                spad = MC.pad
                MD.SkipWs()
                nx = MD.Peek()
                saw = 0
                IfCondition NotEqual(MC.col, scol) ThenBlock: { saw = 1 }
                IfCondition EqualTo(saw, 0) ThenBlock: {
                    looping = 0
                } ElseBlock: {
                    IfCondition EqualTo(nx, 47) ThenBlock: {
                        MC.off = soff
                        MC.col = scol
                        MC.pad = spad
                        looping = 0
                    } ElseBlock: {
                        IfCondition EqualTo(nx, 62) ThenBlock: {
                            MC.off = soff
                            MC.col = scol
                            MC.pad = spad
                            looping = 0
                        } ElseBlock: {
                            an = MD.Peek()
                            aok = 0
                            IfCondition GreaterEqual(an, 65) ThenBlock: {
                                IfCondition LessEqual(an, 90) ThenBlock: { aok = 1 }
                            }
                            IfCondition GreaterEqual(an, 97) ThenBlock: {
                                IfCondition LessEqual(an, 122) ThenBlock: { aok = 1 }
                            }
                            IfCondition EqualTo(an, 95) ThenBlock: { aok = 1 }
                            IfCondition EqualTo(an, 58) ThenBlock: { aok = 1 }
                            IfCondition EqualTo(aok, 0) ThenBlock: {
                                ok = 0
                                looping = 0
                            } ElseBlock: {
                                MD.Bump()
                                more = 1
                                WhileLoop EqualTo(more, 1) {
                                    an2 = MD.Peek()
                                    aok2 = 0
                                    IfCondition GreaterEqual(an2, 65) ThenBlock: {
                                        IfCondition LessEqual(an2, 90) ThenBlock: { aok2 = 1 }
                                    }
                                    IfCondition GreaterEqual(an2, 97) ThenBlock: {
                                        IfCondition LessEqual(an2, 122) ThenBlock: { aok2 = 1 }
                                    }
                                    IfCondition GreaterEqual(an2, 48) ThenBlock: {
                                        IfCondition LessEqual(an2, 57) ThenBlock: { aok2 = 1 }
                                    }
                                    IfCondition EqualTo(an2, 95) ThenBlock: { aok2 = 1 }
                                    IfCondition EqualTo(an2, 58) ThenBlock: { aok2 = 1 }
                                    IfCondition EqualTo(an2, 46) ThenBlock: { aok2 = 1 }
                                    IfCondition EqualTo(an2, 45) ThenBlock: { aok2 = 1 }
                                    IfCondition EqualTo(aok2, 1) ThenBlock: {
                                        MD.Bump()
                                    } ElseBlock: {
                                        more = 0
                                    }
                                }
                                eq = MD.Peek()
                                IfCondition EqualTo(eq, 61) ThenBlock: {
                                    MD.Bump()
                                    qv = MD.Peek()
                                    IfCondition EqualTo(qv, 34) ThenBlock: {
                                        MD.Bump()
                                        qloop = 1
                                        WhileLoop EqualTo(qloop, 1) {
                                            qc = MD.Peek()
                                            IfCondition LessThan(qc, 0) ThenBlock: {
                                                ok = 0
                                                qloop = 0
                                                looping = 0
                                            } ElseBlock: {
                                                IfCondition EqualTo(qc, 34) ThenBlock: {
                                                    MD.Bump()
                                                    qloop = 0
                                                } ElseBlock: {
                                                    MD.Bump()
                                                }
                                            }
                                        }
                                    } ElseBlock: {
                                        IfCondition EqualTo(qv, 39) ThenBlock: {
                                            MD.Bump()
                                            qloop2 = 1
                                            WhileLoop EqualTo(qloop2, 1) {
                                                qc2 = MD.Peek()
                                                IfCondition LessThan(qc2, 0) ThenBlock: {
                                                    ok = 0
                                                    qloop2 = 0
                                                    looping = 0
                                                } ElseBlock: {
                                                    IfCondition EqualTo(qc2, 39) ThenBlock: {
                                                        MD.Bump()
                                                        qloop2 = 0
                                                    } ElseBlock: {
                                                        MD.Bump()
                                                    }
                                                }
                                            }
                                        } ElseBlock: {
                                            u0 = MD.Peek()
                                            ubad = 0
                                            IfCondition LessThan(u0, 0) ThenBlock: { ubad = 1 }
                                            IfCondition EqualTo(u0, 32) ThenBlock: { ubad = 1 }
                                            IfCondition EqualTo(u0, 9) ThenBlock: { ubad = 1 }
                                            IfCondition EqualTo(u0, 34) ThenBlock: { ubad = 1 }
                                            IfCondition EqualTo(u0, 39) ThenBlock: { ubad = 1 }
                                            IfCondition EqualTo(u0, 61) ThenBlock: { ubad = 1 }
                                            IfCondition EqualTo(u0, 60) ThenBlock: { ubad = 1 }
                                            IfCondition EqualTo(u0, 62) ThenBlock: { ubad = 1 }
                                            IfCondition EqualTo(u0, 96) ThenBlock: { ubad = 1 }
                                            IfCondition EqualTo(ubad, 1) ThenBlock: {
                                                ok = 0
                                                looping = 0
                                            } ElseBlock: {
                                                MD.Bump()
                                                uloop = 1
                                                WhileLoop EqualTo(uloop, 1) {
                                                    uc = MD.Peek()
                                                    ustop = 0
                                                    IfCondition LessThan(uc, 0) ThenBlock: { ustop = 1 }
                                                    IfCondition EqualTo(uc, 32) ThenBlock: { ustop = 1 }
                                                    IfCondition EqualTo(uc, 9) ThenBlock: { ustop = 1 }
                                                    IfCondition EqualTo(uc, 34) ThenBlock: { ustop = 1 }
                                                    IfCondition EqualTo(uc, 39) ThenBlock: { ustop = 1 }
                                                    IfCondition EqualTo(uc, 61) ThenBlock: { ustop = 1 }
                                                    IfCondition EqualTo(uc, 60) ThenBlock: { ustop = 1 }
                                                    IfCondition EqualTo(uc, 62) ThenBlock: { ustop = 1 }
                                                    IfCondition EqualTo(uc, 96) ThenBlock: { ustop = 1 }
                                                    IfCondition EqualTo(ustop, 1) ThenBlock: {
                                                        uloop = 0
                                                    } ElseBlock: {
                                                        MD.Bump()
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
            IfCondition EqualTo(ok, 1) ThenBlock: {
                MD.SkipWs()
                sl = MD.Peek()
                IfCondition EqualTo(sl, 47) ThenBlock: { MD.Bump() }
                gt2 = MD.Peek()
                IfCondition EqualTo(gt2, 62) ThenBlock: {
                    MD.Bump()
                } ElseBlock: {
                    ok = 0
                }
            }
        }
        IfCondition EqualTo(ok, 1) ThenBlock: {
            MD.SkipWs()
            endb = MD.Peek()
            IfCondition GreaterEqual(endb, 0) ThenBlock: { ok = 0 }
        }
        MC.off = o
        MC.col = c
        MC.pad = p
        IfCondition EqualTo(ok, 1) ThenBlock: { ReturnValue(7) }
        ReturnValue(0)
    }
}

Function.MD.LineHas {
    Input: a: Integer
    Input: b: Integer
    Input: c: Integer
    Output: Integer
    Body: {
        line = Array.Get(MP.lines, MC.li)
        start = RDMEM_64(line)
        len = RDMEM_64(line, 8)
        i = 0
        found = 0
        WhileLoop LessThan(i, len) {
            x = RDMEM_8(MP.buf, Add(start, i))
            xl = MD.Lower(x)
            IfCondition EqualTo(xl, a) ThenBlock: {
                j = Add(i, 1)
                y = -1
                IfCondition LessThan(j, len) ThenBlock: {
                    y = MD.Lower(RDMEM_8(MP.buf, Add(start, j)))
                }
                IfCondition EqualTo(y, b) ThenBlock: {
                    IfCondition EqualTo(c, 0) ThenBlock: {
                        found = 1
                        i = len
                    } ElseBlock: {
                        k = Add(j, 1)
                        z = -1
                        IfCondition LessThan(k, len) ThenBlock: {
                            z = MD.Lower(RDMEM_8(MP.buf, Add(start, k)))
                        }
                        IfCondition EqualTo(z, c) ThenBlock: {
                            found = 1
                            i = len
                        }
                    }
                }
            }
            i = Add(i, 1)
        }
        ReturnValue(found)
    }
}

Function.MD.HtmlEnds {
    Input: node: Address
    Output: Integer
    Body: {
        typ = RDMEM_64(node, 48)
        IfCondition EqualTo(typ, 1) ThenBlock: {
            hit = MD.HasClose1()
            ReturnValue(hit)
        }
        IfCondition EqualTo(typ, 2) ThenBlock: {
            hit2 = MD.LineHas(45, 45, 62)
            ReturnValue(hit2)
        }
        IfCondition EqualTo(typ, 3) ThenBlock: {
            hit3 = MD.LineHas(63, 62, 0)
            ReturnValue(hit3)
        }
        IfCondition EqualTo(typ, 4) ThenBlock: {
            hit4 = MD.LineHas(62, 0, 0)
            ReturnValue(hit4)
        }
        IfCondition EqualTo(typ, 5) ThenBlock: {
            hit5 = MD.LineHas(93, 93, 62)
            ReturnValue(hit5)
        }
        IfCondition GreaterEqual(typ, 6) ThenBlock: {
            ReturnValue(MP.lineblank)
        }
        ReturnValue(0)
    }
}

Function.MD.TryHtml {
    Output: Integer
    Body: {
        o = MC.off
        c = MC.col
        p = MC.pad
        typ = MD.HtmlType()
        IfCondition EqualTo(typ, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(typ, 7) ThenBlock: {
            IfCondition EqualTo(MP.interrupt, 1) ThenBlock: {
                ReturnValue(0)
            }
        }
        IfCondition EqualTo(MP.make, 0) ThenBlock: { ReturnValue(1) }
        MC.off = o
        MC.col = c
        MC.pad = p
        node = MD.OpenLeaf(6, 1)
        WRMEM_64(node, 48, typ)
        MD.AppendRest(node, 1)
        end = MD.HtmlEnds(node)
        IfCondition EqualTo(end, 1) ThenBlock: {
            IfCondition LessThan(typ, 6) ThenBlock: {
                Array.Pop(MP.open)
            } ElseBlock: {
                IfCondition EqualTo(MP.lineblank, 1) ThenBlock: {
                    data = RDMEM_64(node, 24)
                    len = RDMEM_64(node, 32)
                    IfCondition GreaterThan(len, 0) ThenBlock: {
                        len = Subtract(len, 1)
                        WRMEM_64(node, 32, len)
                        WRMEM_8(data, len, 0)
                    }
                    Array.Pop(MP.open)
                    MD.NoteBlank()
                }
            }
        }
        MP.ate = 1
        ReturnValue(1)
    }
}

Function.MD.FeedHtml {
    Input: tip: Address
    Body: {
        typ = RDMEM_64(tip, 48)
        IfCondition GreaterEqual(typ, 6) ThenBlock: {
            IfCondition EqualTo(MP.lineblank, 1) ThenBlock: {
                Array.Pop(MP.open)
                MD.NoteBlank()
                MP.ate = 1
                ReturnValue(0)
            }
        }
        MD.AppendRest(tip, 1)
        end = MD.HtmlEnds(tip)
        IfCondition EqualTo(end, 1) ThenBlock: {
            IfCondition LessThan(typ, 6) ThenBlock: {
                Array.Pop(MP.open)
            }
        }
        MP.ate = 1
    }
}

Function.MD.FindClose {
    Input: name: Address
    Output: Integer
    Body: {
        nlen = StringLength(name)
        line = Array.Get(MP.lines, MC.li)
        start = RDMEM_64(line)
        len = RDMEM_64(line, 8)
        i = 0
        found = 0
        WhileLoop LessThan(i, len) {
            b = RDMEM_8(MP.buf, Add(start, i))
            IfCondition EqualTo(b, 60) ThenBlock: {
                j = Add(i, 1)
                sl = 0
                IfCondition LessThan(j, len) ThenBlock: {
                    slb = RDMEM_8(MP.buf, Add(start, j))
                    IfCondition EqualTo(slb, 47) ThenBlock: { sl = 1 }
                }
                IfCondition EqualTo(sl, 1) ThenBlock: {
                    k = 0
                    ok = 1
                    WhileLoop LessThan(k, nlen) {
                        p = Add(j, Add(k, 1))
                        IfCondition GreaterEqual(p, len) ThenBlock: {
                            ok = 0
                            k = nlen
                        } ElseBlock: {
                            got = MD.Lower(RDMEM_8(MP.buf, Add(start, p)))
                            want = MD.Lower(RDMEM_8(name, k))
                            IfCondition NotEqual(got, want) ThenBlock: {
                                ok = 0
                                k = nlen
                            } ElseBlock: {
                                k = Add(k, 1)
                            }
                        }
                    }
                    IfCondition EqualTo(ok, 1) ThenBlock: {
                        gt = Add(j, Add(nlen, 1))
                        IfCondition LessThan(gt, len) ThenBlock: {
                            gtb = RDMEM_8(MP.buf, Add(start, gt))
                            IfCondition EqualTo(gtb, 62) ThenBlock: {
                                found = 1
                                i = len
                            }
                        }
                    }
                }
            }
            i = Add(i, 1)
        }
        ReturnValue(found)
    }
}

Function.MD.HasClose1 {
    Output: Integer
    Body: {
        a = MD.FindClose("script")
        IfCondition EqualTo(a, 1) ThenBlock: { ReturnValue(1) }
        b = MD.FindClose("pre")
        IfCondition EqualTo(b, 1) ThenBlock: { ReturnValue(1) }
        c = MD.FindClose("style")
        IfCondition EqualTo(c, 1) ThenBlock: { ReturnValue(1) }
        d = MD.FindClose("textarea")
        IfCondition EqualTo(d, 1) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

