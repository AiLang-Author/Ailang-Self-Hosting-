Function.MD.InNew {
    Input: kind: Integer
    Output: Address
    Body: {
        n = Allocate(64)
        WRMEM_64(n, kind)
        WRMEM_64(n, 8, 0)
        WRMEM_64(n, 16, 0)
        WRMEM_64(n, 24, 0)
        WRMEM_64(n, 32, 0)
        WRMEM_64(n, 40, 0)
        WRMEM_64(n, 48, 0)
        WRMEM_64(n, 56, 0)
        ReturnValue(n)
    }
}

Function.MD.InLink {
    Input: n: Address
    Body: {
        IfCondition EqualTo(MI.head, 0) ThenBlock: {
            MI.head = n
            MI.tail = n
        } ElseBlock: {
            WRMEM_64(MI.tail, 8, n)
            MI.tail = n
        }
    }
}

Function.MD.TextOpen {
    Output: Address
    Body: {
        t = MI.ctext
        IfCondition NotEqual(t, 0) ThenBlock: {
            k = RDMEM_64(t)
            IfCondition EqualTo(k, 1) ThenBlock: { ReturnValue(t) }
        }
        t2 = MD.InNew(1)
        buf = Allocate(32)
        WRMEM_8(buf, 0, 0)
        WRMEM_64(t2, 16, buf)
        WRMEM_64(t2, 24, 0)
        WRMEM_64(t2, 32, 32)
        MD.InLink(t2)
        MI.ctext = t2
        ReturnValue(t2)
    }
}

Function.MD.TextByte {
    Input: b: Integer
    Body: {
        t = MD.TextOpen()
        data = RDMEM_64(t, 16)
        len = RDMEM_64(t, 24)
        cap = RDMEM_64(t, 32)
        need = Add(len, 2)
        IfCondition GreaterEqual(need, cap) ThenBlock: {
            ncap = Multiply(cap, 2)
            nb = Allocate(ncap)
            IfCondition GreaterThan(len, 0) ThenBlock: {
                MemoryCopy(nb, data, len)
            }
            data = nb
            cap = ncap
            WRMEM_64(t, 16, data)
            WRMEM_64(t, 32, cap)
        }
        WRMEM_8(data, len, b)
        len = Add(len, 1)
        WRMEM_8(data, len, 0)
        WRMEM_64(t, 24, len)
    }
}

Function.MD.TextUtf8 {
    Input: cp: Integer
    Body: {
        IfCondition LessEqual(cp, 0) ThenBlock: { cp = 65533 }
        IfCondition GreaterThan(cp, 1114111) ThenBlock: { cp = 65533 }
        IfCondition GreaterEqual(cp, 55296) ThenBlock: {
            IfCondition LessEqual(cp, 57343) ThenBlock: { cp = 65533 }
        }
        IfCondition LessThan(cp, 128) ThenBlock: {
            MD.TextByte(cp)
        } ElseBlock: {
            IfCondition LessThan(cp, 2048) ThenBlock: {
                b0 = Divide(cp, 64)
                b0 = Add(b0, 192)
                b1 = Modulo(cp, 64)
                b1 = Add(b1, 128)
                MD.TextByte(b0)
                MD.TextByte(b1)
            } ElseBlock: {
                IfCondition LessThan(cp, 65536) ThenBlock: {
                    b0 = Divide(cp, 4096)
                    b0 = Add(b0, 224)
                    rem = Modulo(cp, 4096)
                    b1 = Divide(rem, 64)
                    b1 = Add(b1, 128)
                    b2 = Modulo(cp, 64)
                    b2 = Add(b2, 128)
                    MD.TextByte(b0)
                    MD.TextByte(b1)
                    MD.TextByte(b2)
                } ElseBlock: {
                    b0 = Divide(cp, 262144)
                    b0 = Add(b0, 240)
                    r1 = Modulo(cp, 262144)
                    b1 = Divide(r1, 4096)
                    b1 = Add(b1, 128)
                    r2 = Modulo(cp, 4096)
                    b2 = Divide(r2, 64)
                    b2 = Add(b2, 128)
                    b3 = Modulo(cp, 64)
                    b3 = Add(b3, 128)
                    MD.TextByte(b0)
                    MD.TextByte(b1)
                    MD.TextByte(b2)
                    MD.TextByte(b3)
                }
            }
        }
    }
}

Function.MD.At {
    Output: Integer
    Body: {
        IfCondition GreaterEqual(MI.pos, MI.tlen) ThenBlock: { ReturnValue(-1) }
        ReturnValue(RDMEM_8(MI.txt, MI.pos))
    }
}

Function.MD.AtN {
    Input: n: Integer
    Output: Integer
    Body: {
        p = Add(MI.pos, n)
        IfCondition GreaterEqual(p, MI.tlen) ThenBlock: { ReturnValue(-1) }
        ReturnValue(RDMEM_8(MI.txt, p))
    }
}

Function.MD.NamedEnt {
    Input: s: Address
    Output: Integer
    Body: {
        c = StringCompare(s, "amp")
        IfCondition EqualTo(c, 0) ThenBlock: { ReturnValue(38) }
        c = StringCompare(s, "lt")
        IfCondition EqualTo(c, 0) ThenBlock: { ReturnValue(60) }
        c = StringCompare(s, "gt")
        IfCondition EqualTo(c, 0) ThenBlock: { ReturnValue(62) }
        c = StringCompare(s, "quot")
        IfCondition EqualTo(c, 0) ThenBlock: { ReturnValue(34) }
        c = StringCompare(s, "nbsp")
        IfCondition EqualTo(c, 0) ThenBlock: { ReturnValue(160) }
        c = StringCompare(s, "copy")
        IfCondition EqualTo(c, 0) ThenBlock: { ReturnValue(169) }
        c = StringCompare(s, "AElig")
        IfCondition EqualTo(c, 0) ThenBlock: { ReturnValue(198) }
        c = StringCompare(s, "frac34")
        IfCondition EqualTo(c, 0) ThenBlock: { ReturnValue(190) }
        c = StringCompare(s, "auml")
        IfCondition EqualTo(c, 0) ThenBlock: { ReturnValue(228) }
        c = StringCompare(s, "ouml")
        IfCondition EqualTo(c, 0) ThenBlock: { ReturnValue(246) }
        c = StringCompare(s, "Dcaron")
        IfCondition EqualTo(c, 0) ThenBlock: { ReturnValue(270) }
        c = StringCompare(s, "HilbertSpace")
        IfCondition EqualTo(c, 0) ThenBlock: { ReturnValue(8459) }
        c = StringCompare(s, "DifferentialD")
        IfCondition EqualTo(c, 0) ThenBlock: { ReturnValue(8518) }
        c = StringCompare(s, "ClockwiseContourIntegral")
        IfCondition EqualTo(c, 0) ThenBlock: { ReturnValue(8754) }
        ReturnValue(-1)
    }
}

Function.MD.EntNgE {
    Input: s: Address
    Output: Integer
    Body: {
        c = StringCompare(s, "ngE")
        IfCondition EqualTo(c, 0) ThenBlock: {
            MD.TextUtf8(8807)
            MD.TextUtf8(824)
            ReturnValue(1)
        }
        ReturnValue(0)
    }
}

Function.MD.ParseEnt {
    Output: Integer
    Body: {
        start = MI.pos
        b = MD.At()
        IfCondition NotEqual(b, 38) ThenBlock: { ReturnValue(0) }
        MI.pos = Add(MI.pos, 1)
        b2 = MD.At()
        IfCondition EqualTo(b2, 35) ThenBlock: {
            MI.pos = Add(MI.pos, 1)
            hex = 0
            h = MD.At()
            IfCondition EqualTo(h, 120) ThenBlock: { hex = 1 }
            IfCondition EqualTo(h, 88) ThenBlock: { hex = 1 }
            IfCondition EqualTo(hex, 1) ThenBlock: { MI.pos = Add(MI.pos, 1) }
            val = 0
            digits = 0
            looping = 1
            WhileLoop EqualTo(looping, 1) {
                d = MD.At()
                dig = -1
                IfCondition GreaterEqual(d, 48) ThenBlock: {
                    IfCondition LessEqual(d, 57) ThenBlock: { dig = Subtract(d, 48) }
                }
                IfCondition EqualTo(hex, 1) ThenBlock: {
                    IfCondition GreaterEqual(d, 97) ThenBlock: {
                        IfCondition LessEqual(d, 102) ThenBlock: { dig = Subtract(d, 87) }
                    }
                    IfCondition GreaterEqual(d, 65) ThenBlock: {
                        IfCondition LessEqual(d, 70) ThenBlock: { dig = Subtract(d, 55) }
                    }
                }
                IfCondition LessThan(dig, 0) ThenBlock: {
                    looping = 0
                } ElseBlock: {
                    maxd = 7
                    IfCondition EqualTo(hex, 1) ThenBlock: { maxd = 6 }
                    IfCondition GreaterEqual(digits, maxd) ThenBlock: {
                        looping = 0
                        digits = 0
                    } ElseBlock: {
                        base = 10
                        IfCondition EqualTo(hex, 1) ThenBlock: { base = 16 }
                        val = Multiply(val, base)
                        val = Add(val, dig)
                        digits = Add(digits, 1)
                        MI.pos = Add(MI.pos, 1)
                    }
                }
            }
            endc = MD.At()
            IfCondition EqualTo(endc, 59) ThenBlock: {
                IfCondition GreaterThan(digits, 0) ThenBlock: {
                    MI.pos = Add(MI.pos, 1)
                    MD.TextUtf8(val)
                    ReturnValue(1)
                }
            }
            MI.pos = start
            ReturnValue(0)
        }
        name = Allocate(64)
        n = 0
        looping2 = 1
        WhileLoop EqualTo(looping2, 1) {
            d2 = MD.At()
            ok = 0
            IfCondition GreaterEqual(d2, 65) ThenBlock: {
                IfCondition LessEqual(d2, 90) ThenBlock: { ok = 1 }
            }
            IfCondition GreaterEqual(d2, 97) ThenBlock: {
                IfCondition LessEqual(d2, 122) ThenBlock: { ok = 1 }
            }
            IfCondition GreaterEqual(d2, 48) ThenBlock: {
                IfCondition LessEqual(d2, 57) ThenBlock: { ok = 1 }
            }
            IfCondition EqualTo(ok, 1) ThenBlock: {
                IfCondition LessThan(n, 60) ThenBlock: {
                    WRMEM_8(name, n, d2)
                    n = Add(n, 1)
                    MI.pos = Add(MI.pos, 1)
                } ElseBlock: {
                    looping2 = 0
                }
            } ElseBlock: {
                looping2 = 0
            }
        }
        WRMEM_8(name, n, 0)
        end2 = MD.At()
        IfCondition EqualTo(end2, 59) ThenBlock: {
            IfCondition GreaterThan(n, 0) ThenBlock: {
                ng = MD.EntNgE(name)
                IfCondition EqualTo(ng, 1) ThenBlock: {
                    MI.pos = Add(MI.pos, 1)
                    ReturnValue(1)
                }
                cp = MD.NamedEnt(name)
                IfCondition GreaterEqual(cp, 0) ThenBlock: {
                    MI.pos = Add(MI.pos, 1)
                    MD.TextUtf8(cp)
                    ReturnValue(1)
                }
            }
        }
        MI.pos = start
        ReturnValue(0)
    }
}

Function.MD.Punct {
    Input: b: Integer
    Output: Integer
    Body: {
        IfCondition GreaterEqual(b, 33) ThenBlock: {
            IfCondition LessEqual(b, 47) ThenBlock: { ReturnValue(1) }
        }
        IfCondition GreaterEqual(b, 58) ThenBlock: {
            IfCondition LessEqual(b, 64) ThenBlock: { ReturnValue(1) }
        }
        IfCondition GreaterEqual(b, 91) ThenBlock: {
            IfCondition LessEqual(b, 96) ThenBlock: { ReturnValue(1) }
        }
        IfCondition GreaterEqual(b, 123) ThenBlock: {
            IfCondition LessEqual(b, 126) ThenBlock: { ReturnValue(1) }
        }
        ReturnValue(0)
    }
}

Function.MD.WsByte {
    Input: b: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(b, 32) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(b, 9) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(b, 10) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(b, 13) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(b, 12) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

Function.MD.Alnum {
    Input: b: Integer
    Output: Integer
    Body: {
        IfCondition GreaterEqual(b, 48) ThenBlock: {
            IfCondition LessEqual(b, 57) ThenBlock: { ReturnValue(1) }
        }
        IfCondition GreaterEqual(b, 65) ThenBlock: {
            IfCondition LessEqual(b, 90) ThenBlock: { ReturnValue(1) }
        }
        IfCondition GreaterEqual(b, 97) ThenBlock: {
            IfCondition LessEqual(b, 122) ThenBlock: { ReturnValue(1) }
        }
        ReturnValue(0)
    }
}

Function.MD.PushDelim {
    Input: typ: Integer
    Input: n: Integer
    Input: op: Integer
    Input: cl: Integer
    Input: node: Address
    Body: {
        d = Allocate(64)
        WRMEM_64(d, typ)
        WRMEM_64(d, 8, n)
        WRMEM_64(d, 16, 1)
        WRMEM_64(d, 24, op)
        WRMEM_64(d, 32, cl)
        WRMEM_64(d, 40, node)
        WRMEM_64(d, 48, MI.dtail)
        WRMEM_64(d, 56, 0)
        IfCondition EqualTo(MI.dhead, 0) ThenBlock: {
            MI.dhead = d
        } ElseBlock: {
            WRMEM_64(MI.dtail, 56, d)
        }
        MI.dtail = d
    }
}

Function.MD.CodeSpan {
    Output: Integer
    Body: {
        n = 0
        p = MI.pos
        b = MD.At()
        WhileLoop EqualTo(b, 96) {
            n = Add(n, 1)
            MI.pos = Add(MI.pos, 1)
            b = MD.At()
        }
        IfCondition EqualTo(n, 0) ThenBlock: { ReturnValue(0) }
        start = MI.pos
        found = -1
        endpos = MI.pos
        searching = 1
        WhileLoop EqualTo(searching, 1) {
            IfCondition GreaterEqual(MI.pos, MI.tlen) ThenBlock: {
                searching = 0
            } ElseBlock: {
                b2 = MD.At()
                IfCondition EqualTo(b2, 96) ThenBlock: {
                    m = 0
                    q = MI.pos
                    WhileLoop EqualTo(b2, 96) {
                        m = Add(m, 1)
                        MI.pos = Add(MI.pos, 1)
                        b2 = MD.At()
                    }
                    IfCondition EqualTo(m, n) ThenBlock: {
                        found = q
                        endpos = MI.pos
                        searching = 0
                    }
                } ElseBlock: {
                    MI.pos = Add(MI.pos, 1)
                }
            }
        }
        MI.pos = endpos
        IfCondition LessThan(found, 0) ThenBlock: {
            MI.pos = p
            i = 0
            WhileLoop LessThan(i, n) {
                MD.TextByte(96)
                i = Add(i, 1)
                MI.pos = Add(MI.pos, 1)
            }
            ReturnValue(1)
        }
        node = MD.InNew(2)
        buf = Allocate(Add(Subtract(found, start), 1))
        ln = 0
        i2 = start
        WhileLoop LessThan(i2, found) {
            ch = RDMEM_8(MI.txt, i2)
            IfCondition EqualTo(ch, 10) ThenBlock: { ch = 32 }
            WRMEM_8(buf, ln, ch)
            ln = Add(ln, 1)
            i2 = Add(i2, 1)
        }
        WRMEM_8(buf, ln, 0)
        IfCondition GreaterThan(ln, 1) ThenBlock: {
            a = RDMEM_8(buf, 0)
            z = RDMEM_8(buf, Subtract(ln, 1))
            IfCondition EqualTo(a, 32) ThenBlock: {
                IfCondition EqualTo(z, 32) ThenBlock: {
                    all = 1
                    k = 0
                    WhileLoop LessThan(k, ln) {
                        ck = RDMEM_8(buf, k)
                        IfCondition NotEqual(ck, 32) ThenBlock: {
                            all = 0
                            k = ln
                        }
                        k = Add(k, 1)
                    }
                    IfCondition EqualTo(all, 0) ThenBlock: {
                        ln = Subtract(ln, 2)
                        MemoryCopy(buf, Add(buf, 1), ln)
                        WRMEM_8(buf, ln, 0)
                    }
                }
            }
        }
        WRMEM_64(node, 16, buf)
        WRMEM_64(node, 24, ln)
        MD.InLink(node)
        MI.ctext = 0
        ReturnValue(1)
    }
}

Function.MD.HardSoft {
    Body: {
        t = MI.ctext
        spaces = 0
        slash = 0
        IfCondition NotEqual(t, 0) ThenBlock: {
            k = RDMEM_64(t)
            IfCondition EqualTo(k, 1) ThenBlock: {
                data = RDMEM_64(t, 16)
                len = RDMEM_64(t, 24)
                WhileLoop GreaterThan(len, 0) {
                    b = RDMEM_8(data, Subtract(len, 1))
                    IfCondition EqualTo(b, 32) ThenBlock: {
                        spaces = Add(spaces, 1)
                        len = Subtract(len, 1)
                    } ElseBlock: {
                        IfCondition EqualTo(b, 92) ThenBlock: {
                            IfCondition EqualTo(spaces, 0) ThenBlock: { slash = 1 }
                        }
                        len = 0
                    }
                }
                len2 = RDMEM_64(t, 24)
                cut = spaces
                IfCondition EqualTo(slash, 1) ThenBlock: { cut = 1 }
                IfCondition GreaterThan(cut, 0) ThenBlock: {
                    len2 = Subtract(len2, cut)
                    WRMEM_64(t, 24, len2)
                    WRMEM_8(data, len2, 0)
                }
            }
        }
        br = MD.InNew(9)
        hard = 0
        IfCondition GreaterEqual(spaces, 2) ThenBlock: { hard = 1 }
        IfCondition EqualTo(slash, 1) ThenBlock: { hard = 1 }
        IfCondition EqualTo(hard, 1) ThenBlock: {
            WRMEM_64(br, 0, 8)
        }
        MD.InLink(br)
        MI.ctext = 0
        MI.pos = Add(MI.pos, 1)
    }
}

Function.MD.RefFind {
    Input: label: Address
    Output: Address
    Body: {
        i = 0
        n = Array.Size(MP.refs)
        WhileLoop LessThan(i, n) {
            rec = Array.Get(MP.refs, i)
            old = RDMEM_64(rec)
            cmp = StringCompare(old, label)
            IfCondition EqualTo(cmp, 0) ThenBlock: { ReturnValue(rec) }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

Function.MD.NormLabel {
    Input: node: Address
    Output: Address
    Body: {
        buf = Allocate(1024)
        n = 0
        sp = 0
        cur = node
        WhileLoop NotEqual(cur, 0) {
            k = RDMEM_64(cur)
            IfCondition EqualTo(k, 1) ThenBlock: {
                data = RDMEM_64(cur, 16)
                len = RDMEM_64(cur, 24)
                j = 0
                WhileLoop LessThan(j, len) {
                    b = RDMEM_8(data, j)
                    ws = MD.WsByte(b)
                    IfCondition EqualTo(ws, 1) ThenBlock: {
                        sp = 1
                    } ElseBlock: {
                        IfCondition EqualTo(sp, 1) ThenBlock: {
                            IfCondition GreaterThan(n, 0) ThenBlock: {
                                WRMEM_8(buf, n, 32)
                                n = Add(n, 1)
                            }
                        }
                        sp = 0
                        low = MD.Lower(b)
                        WRMEM_8(buf, n, low)
                        n = Add(n, 1)
                    }
                    j = Add(j, 1)
                }
            } ElseBlock: {
                IfCondition EqualTo(k, 2) ThenBlock: {
                    data2 = RDMEM_64(cur, 16)
                    len2 = RDMEM_64(cur, 24)
                    j2 = 0
                    WhileLoop LessThan(j2, len2) {
                        b2 = RDMEM_8(data2, j2)
                        WRMEM_8(buf, n, b2)
                        n = Add(n, 1)
                        j2 = Add(j2, 1)
                    }
                }
            }
            cur = RDMEM_64(cur, 8)
        }
        WRMEM_8(buf, n, 0)
        ReturnValue(buf)
    }
}

Function.MD.ReadDest {
    Output: Address
    Body: {
        b = MD.At()
        buf = Allocate(4096)
        n = 0
        IfCondition EqualTo(b, 60) ThenBlock: {
            MI.pos = Add(MI.pos, 1)
            bad = 0
            WhileLoop EqualTo(bad, 0) {
                c = MD.At()
                IfCondition LessThan(c, 0) ThenBlock: {
                    bad = 1
                } ElseBlock: {
                    IfCondition EqualTo(c, 62) ThenBlock: {
                        bad = 2
                    } ElseBlock: {
                        IfCondition EqualTo(c, 10) ThenBlock: {
                            bad = 1
                        } ElseBlock: {
                            IfCondition EqualTo(c, 92) ThenBlock: {
                                MI.pos = Add(MI.pos, 1)
                                c2 = MD.At()
                                pun = MD.Punct(c2)
                                IfCondition EqualTo(pun, 1) ThenBlock: {
                                    WRMEM_8(buf, n, c2)
                                    n = Add(n, 1)
                                    MI.pos = Add(MI.pos, 1)
                                } ElseBlock: {
                                    WRMEM_8(buf, n, 92)
                                    n = Add(n, 1)
                                }
                            } ElseBlock: {
                                IfCondition EqualTo(c, 38) ThenBlock: {
                                    ep = MD.BufEnt(MI.txt, MI.tlen, MI.pos, buf, n)
                                    IfCondition GreaterEqual(ep, 0) ThenBlock: {
                                        n = RDMEM_64(buf, 4088)
                                        MI.pos = ep
                                    } ElseBlock: {
                                        WRMEM_8(buf, n, c)
                                        n = Add(n, 1)
                                        MI.pos = Add(MI.pos, 1)
                                    }
                                } ElseBlock: {
                                    WRMEM_8(buf, n, c)
                                    n = Add(n, 1)
                                    MI.pos = Add(MI.pos, 1)
                                }
                            }
                        }
                    }
                }
            }
            IfCondition NotEqual(bad, 2) ThenBlock: {
                WRMEM_8(buf, 0, 0)
                ReturnValue(0)
            }
            MI.pos = Add(MI.pos, 1)
            WRMEM_8(buf, n, 0)
            WRMEM_64(buf, 4088, n)
            ReturnValue(buf)
        }
        depth = 0
        bad2 = 0
        WhileLoop EqualTo(bad2, 0) {
            c3 = MD.At()
            IfCondition LessThan(c3, 0) ThenBlock: {
                bad2 = 1
            } ElseBlock: {
                ws = MD.WsByte(c3)
                IfCondition EqualTo(ws, 1) ThenBlock: {
                    bad2 = 2
                } ElseBlock: {
                    IfCondition EqualTo(c3, 40) ThenBlock: {
                        depth = Add(depth, 1)
                        WRMEM_8(buf, n, c3)
                        n = Add(n, 1)
                        MI.pos = Add(MI.pos, 1)
                    } ElseBlock: {
                        IfCondition EqualTo(c3, 41) ThenBlock: {
                            IfCondition LessEqual(depth, 0) ThenBlock: {
                                bad2 = 2
                            } ElseBlock: {
                                depth = Subtract(depth, 1)
                                WRMEM_8(buf, n, c3)
                                n = Add(n, 1)
                                MI.pos = Add(MI.pos, 1)
                            }
                        } ElseBlock: {
                            IfCondition EqualTo(c3, 92) ThenBlock: {
                                MI.pos = Add(MI.pos, 1)
                                c4 = MD.At()
                                pun2 = MD.Punct(c4)
                                IfCondition EqualTo(pun2, 1) ThenBlock: {
                                    WRMEM_8(buf, n, c4)
                                    n = Add(n, 1)
                                    MI.pos = Add(MI.pos, 1)
                                } ElseBlock: {
                                    WRMEM_8(buf, n, 92)
                                    n = Add(n, 1)
                                }
                            } ElseBlock: {
                                IfCondition EqualTo(c3, 38) ThenBlock: {
                                    ep2 = MD.BufEnt(MI.txt, MI.tlen, MI.pos, buf, n)
                                    IfCondition GreaterEqual(ep2, 0) ThenBlock: {
                                        n = RDMEM_64(buf, 4088)
                                        MI.pos = ep2
                                    } ElseBlock: {
                                        WRMEM_8(buf, n, c3)
                                        n = Add(n, 1)
                                        MI.pos = Add(MI.pos, 1)
                                    }
                                } ElseBlock: {
                                    WRMEM_8(buf, n, c3)
                                    n = Add(n, 1)
                                    MI.pos = Add(MI.pos, 1)
                                }
                            }
                        }
                    }
                }
            }
        }
        IfCondition GreaterThan(depth, 0) ThenBlock: {
            ReturnValue(0)
        }
        WRMEM_8(buf, n, 0)
        WRMEM_64(buf, 4088, n)
        ReturnValue(buf)
    }
}

Function.MD.ReadTitle {
    Output: Address
    Body: {
        b = MD.At()
        q = 0
        IfCondition EqualTo(b, 34) ThenBlock: { q = 34 }
        IfCondition EqualTo(b, 39) ThenBlock: { q = 39 }
        IfCondition EqualTo(b, 40) ThenBlock: { q = 41 }
        IfCondition EqualTo(q, 0) ThenBlock: { ReturnValue(0) }
        MI.pos = Add(MI.pos, 1)
        buf = Allocate(4096)
        n = 0
        bad = 0
        WhileLoop EqualTo(bad, 0) {
            c = MD.At()
            IfCondition LessThan(c, 0) ThenBlock: {
                bad = 1
            } ElseBlock: {
                IfCondition EqualTo(c, q) ThenBlock: {
                    bad = 2
                } ElseBlock: {
                    IfCondition EqualTo(c, 92) ThenBlock: {
                        MI.pos = Add(MI.pos, 1)
                        c2 = MD.At()
                        pun = MD.Punct(c2)
                        IfCondition EqualTo(pun, 1) ThenBlock: {
                            WRMEM_8(buf, n, c2)
                            n = Add(n, 1)
                            MI.pos = Add(MI.pos, 1)
                        } ElseBlock: {
                            IfCondition EqualTo(c2, 10) ThenBlock: {
                                WRMEM_8(buf, n, 10)
                                n = Add(n, 1)
                                MI.pos = Add(MI.pos, 1)
                            } ElseBlock: {
                                WRMEM_8(buf, n, 92)
                                n = Add(n, 1)
                            }
                        }
                    } ElseBlock: {
                        IfCondition EqualTo(c, 38) ThenBlock: {
                            ep3 = MD.BufEnt(MI.txt, MI.tlen, MI.pos, buf, n)
                            IfCondition GreaterEqual(ep3, 0) ThenBlock: {
                                n = RDMEM_64(buf, 4088)
                                MI.pos = ep3
                            } ElseBlock: {
                                WRMEM_8(buf, n, c)
                                n = Add(n, 1)
                                MI.pos = Add(MI.pos, 1)
                            }
                        } ElseBlock: {
                            WRMEM_8(buf, n, c)
                            n = Add(n, 1)
                            MI.pos = Add(MI.pos, 1)
                        }
                    }
                }
            }
        }
        IfCondition NotEqual(bad, 2) ThenBlock: { ReturnValue(0) }
        MI.pos = Add(MI.pos, 1)
        WRMEM_8(buf, n, 0)
        WRMEM_64(buf, 4088, n)
        ReturnValue(buf)
    }
}

Function.MD.SkipInWs {
    Body: {
        looping = 1
        WhileLoop EqualTo(looping, 1) {
            b = MD.At()
            ws = MD.WsByte(b)
            IfCondition EqualTo(ws, 1) ThenBlock: {
                MI.pos = Add(MI.pos, 1)
            } ElseBlock: {
                looping = 0
            }
        }
    }
}

Function.MD.DropDelim {
    Input: d: Address
    Body: {
        prev = RDMEM_64(d, 48)
        nxt = RDMEM_64(d, 56)
        IfCondition EqualTo(prev, 0) ThenBlock: {
            MI.dhead = nxt
        } ElseBlock: {
            WRMEM_64(prev, 56, nxt)
        }
        IfCondition EqualTo(nxt, 0) ThenBlock: {
            MI.dtail = prev
        } ElseBlock: {
            WRMEM_64(nxt, 48, prev)
        }
    }
}

Function.MD.LookLink {
    Input: closer_pos: Integer
    Body: {
        d = MI.dtail
        found = 0
        WhileLoop NotEqual(d, 0) {
            typ = RDMEM_64(d)
            IfCondition EqualTo(typ, 91) ThenBlock: {
                found = d
                d = 0
            } ElseBlock: {
                IfCondition EqualTo(typ, 33) ThenBlock: {
                    found = d
                    d = 0
                } ElseBlock: {
                    d = RDMEM_64(d, 48)
                }
            }
        }
        IfCondition EqualTo(found, 0) ThenBlock: {
            MD.TextByte(93)
            ReturnValue(0)
        }
        active = RDMEM_64(found, 16)
        IfCondition EqualTo(active, 0) ThenBlock: {
            MD.DropDelim(found)
            MD.TextByte(93)
            ReturnValue(0)
        }
        save = MI.pos
        ok = 0
        url = 0
        title = 0
        ulen = 0
        tlen = 0
        b = MD.At()
        IfCondition EqualTo(b, 40) ThenBlock: {
            MI.pos = Add(MI.pos, 1)
            MD.SkipInWs()
            url = MD.ReadDest()
            IfCondition NotEqual(url, 0) ThenBlock: {
                ulen = RDMEM_64(url, 4088)
                MD.SkipInWs()
                b2 = MD.At()
                IfCondition NotEqual(b2, 41) ThenBlock: {
                    title = MD.ReadTitle()
                    IfCondition NotEqual(title, 0) ThenBlock: {
                        tlen = RDMEM_64(title, 4088)
                        MD.SkipInWs()
                    }
                }
                b3 = MD.At()
                IfCondition EqualTo(b3, 41) ThenBlock: {
                    MI.pos = Add(MI.pos, 1)
                    ok = 1
                }
            }
        }
        IfCondition EqualTo(ok, 0) ThenBlock: {
            MI.pos = save
            lab = 0
            b4 = MD.At()
            IfCondition EqualTo(b4, 91) ThenBlock: {
                MI.pos = Add(MI.pos, 1)
                b5 = MD.At()
                IfCondition EqualTo(b5, 93) ThenBlock: {
                    openn = RDMEM_64(found, 40)
                    br = RDMEM_64(openn, 56)
                    lab = MD.NormSlice(MI.txt, Add(br, 1), Subtract(closer_pos, 1))
                    MI.pos = Add(MI.pos, 1)
                } ElseBlock: {
                    raws = MI.pos
                    scanning = 1
                    WhileLoop EqualTo(scanning, 1) {
                        c6 = MD.At()
                        IfCondition LessThan(c6, 0) ThenBlock: {
                            scanning = 0
                            raws = -1
                        } ElseBlock: {
                            IfCondition EqualTo(c6, 93) ThenBlock: {
                                scanning = 0
                            } ElseBlock: {
                                IfCondition EqualTo(c6, 92) ThenBlock: {
                                    MI.pos = Add(MI.pos, 1)
                                }
                                MI.pos = Add(MI.pos, 1)
                            }
                        }
                    }
                    IfCondition GreaterEqual(raws, 0) ThenBlock: {
                        lab = MD.NormSlice(MI.txt, raws, MI.pos)
                        MI.pos = Add(MI.pos, 1)
                    }
                }
            } ElseBlock: {
                openn2 = RDMEM_64(found, 40)
                br2 = RDMEM_64(openn2, 56)
                lab = MD.NormSlice(MI.txt, Add(br2, 1), Subtract(closer_pos, 1))
            }
            IfCondition NotEqual(lab, 0) ThenBlock: {
                rec = MD.RefFind(lab)
                IfCondition NotEqual(rec, 0) ThenBlock: {
                    url = RDMEM_64(rec, 16)
                    ulen = RDMEM_64(rec, 24)
                    title = RDMEM_64(rec, 32)
                    tlen = RDMEM_64(rec, 40)
                    ok = 1
                }
            }
        }
        IfCondition EqualTo(ok, 0) ThenBlock: {
            MI.pos = save
            MD.DropDelim(found)
            MD.TextByte(93)
            ReturnValue(0)
        }
        typ2 = RDMEM_64(found)
        kind = 5
        IfCondition EqualTo(typ2, 33) ThenBlock: { kind = 6 }
        link = MD.InNew(kind)
        opent = RDMEM_64(found, 40)
        kids = RDMEM_64(opent, 8)
        WRMEM_64(link, 16, kids)
        WRMEM_64(link, 24, url)
        WRMEM_64(link, 32, ulen)
        WRMEM_64(link, 40, title)
        WRMEM_64(link, 48, tlen)
        WRMEM_64(link, 8, 0)
        prevn = 0
        walk = MI.head
        splicing = 1
        WhileLoop EqualTo(splicing, 1) {
            IfCondition EqualTo(walk, 0) ThenBlock: {
                splicing = 0
            } ElseBlock: {
                IfCondition EqualTo(walk, opent) ThenBlock: {
                    splicing = 0
                } ElseBlock: {
                    prevn = walk
                    walk = RDMEM_64(walk, 8)
                }
            }
        }
        IfCondition EqualTo(prevn, 0) ThenBlock: {
            MI.head = link
        } ElseBlock: {
            WRMEM_64(prevn, 8, link)
        }
        MI.tail = link
        MI.ctext = 0
        IfCondition EqualTo(kind, 5) ThenBlock: {
            d2 = MI.dhead
            WhileLoop NotEqual(d2, 0) {
                t3 = RDMEM_64(d2)
                IfCondition EqualTo(t3, 91) ThenBlock: {
                    WRMEM_64(d2, 16, 0)
                }
                d2 = RDMEM_64(d2, 56)
            }
        }
        nxem = RDMEM_64(found, 56)
        IfCondition NotEqual(nxem, 0) ThenBlock: {
            WRMEM_64(nxem, 48, 0)
            WRMEM_64(found, 56, 0)
            saveh = MI.dhead
            savet = MI.dtail
            MI.dhead = nxem
            MI.dtail = savet
            MD.MatchEm()
            MI.dhead = saveh
            MI.dtail = found
        }
        prev = RDMEM_64(found, 48)
        nxt = RDMEM_64(found, 56)
        IfCondition EqualTo(prev, 0) ThenBlock: {
            MI.dhead = nxt
        } ElseBlock: {
            WRMEM_64(prev, 56, nxt)
        }
        IfCondition EqualTo(nxt, 0) ThenBlock: {
            MI.dtail = prev
        } ElseBlock: {
            WRMEM_64(nxt, 48, prev)
        }
    }
}

Function.MD.MatchEm {
    Body: {
        guard = 0
        WhileLoop LessThan(guard, 200) {
            guard = Add(guard, 1)
            d = MI.dhead
            closer = 0
            WhileLoop NotEqual(d, 0) {
                cl = RDMEM_64(d, 32)
                typ = RDMEM_64(d)
                star = 0
                IfCondition EqualTo(typ, 42) ThenBlock: { star = 1 }
                IfCondition EqualTo(typ, 95) ThenBlock: { star = 1 }
                IfCondition EqualTo(star, 1) ThenBlock: {
                    IfCondition EqualTo(cl, 1) ThenBlock: {
                        nleft = RDMEM_64(d, 8)
                        IfCondition GreaterThan(nleft, 0) ThenBlock: {
                            closer = d
                            d = 0
                        }
                    }
                }
                IfCondition NotEqual(d, 0) ThenBlock: {
                    d = RDMEM_64(d, 56)
                }
            }
            IfCondition EqualTo(closer, 0) ThenBlock: {
                guard = 200
            } ElseBlock: {
                opener = 0
                p = RDMEM_64(closer, 48)
                ct = RDMEM_64(closer)
                cn = RDMEM_64(closer, 8)
                WhileLoop NotEqual(p, 0) {
                    pt = RDMEM_64(p)
                    po = RDMEM_64(p, 24)
                    pn = RDMEM_64(p, 8)
                    IfCondition EqualTo(pt, ct) ThenBlock: {
                        IfCondition EqualTo(po, 1) ThenBlock: {
                            IfCondition GreaterThan(pn, 0) ThenBlock: {
                                use = 1
                                cop = RDMEM_64(closer, 24)
                                pop = RDMEM_64(p, 32)
                                both = 0
                                IfCondition EqualTo(cop, 1) ThenBlock: {
                                    IfCondition EqualTo(RDMEM_64(closer, 32), 1) ThenBlock: { both = 1 }
                                }
                                IfCondition EqualTo(po, 1) ThenBlock: {
                                    IfCondition NotEqual(pop, 0) ThenBlock: { both = 1 }
                                }
                                IfCondition EqualTo(both, 1) ThenBlock: {
                                    sum = Add(cn, pn)
                                    m3 = Modulo(sum, 3)
                                    IfCondition EqualTo(m3, 0) ThenBlock: {
                                        a = Modulo(cn, 3)
                                        b = Modulo(pn, 3)
                                        IfCondition NotEqual(a, 0) ThenBlock: {
                                            IfCondition NotEqual(b, 0) ThenBlock: { use = 0 }
                                        }
                                    }
                                }
                                IfCondition EqualTo(use, 1) ThenBlock: {
                                    opener = p
                                    p = 0
                                }
                            }
                        }
                    }
                    IfCondition NotEqual(p, 0) ThenBlock: {
                        p = RDMEM_64(p, 48)
                    }
                }
                IfCondition EqualTo(opener, 0) ThenBlock: {
                    keepc = RDMEM_64(closer, 24)
                    IfCondition EqualTo(keepc, 0) ThenBlock: {
                        WRMEM_64(closer, 32, 0)
                    } ElseBlock: {
                        WRMEM_64(closer, 32, 2)
                    }
                } ElseBlock: {
                    take = 1
                    on = RDMEM_64(opener, 8)
                    cn2 = RDMEM_64(closer, 8)
                    IfCondition GreaterEqual(on, 2) ThenBlock: {
                        IfCondition GreaterEqual(cn2, 2) ThenBlock: { take = 2 }
                    }
                    on2 = RDMEM_64(opener, 40)
                    cn3 = RDMEM_64(closer, 40)
                    od = RDMEM_64(on2, 16)
                    olen = RDMEM_64(on2, 24)
                    olen = Subtract(olen, take)
                    WRMEM_64(on2, 24, olen)
                    WRMEM_8(od, olen, 0)
                    cd = RDMEM_64(cn3, 16)
                    clen = RDMEM_64(cn3, 24)
                    IfCondition GreaterThan(clen, take) ThenBlock: {
                        rest = Subtract(clen, take)
                        MemoryCopy(cd, Add(cd, take), rest)
                        WRMEM_8(cd, rest, 0)
                        WRMEM_64(cn3, 24, rest)
                    } ElseBlock: {
                        WRMEM_64(cn3, 24, 0)
                        WRMEM_8(cd, 0, 0)
                    }
                    WRMEM_64(opener, 8, Subtract(on, take))
                    WRMEM_64(closer, 8, Subtract(cn2, take))
                    em = MD.InNew(3)
                    IfCondition EqualTo(take, 2) ThenBlock: { WRMEM_64(em, 0, 4) }
                    child = RDMEM_64(on2, 8)
                    WRMEM_64(em, 16, child)
                    walk = child
                    prev = 0
                    WhileLoop NotEqual(walk, cn3) {
                        prev = walk
                        walk = RDMEM_64(walk, 8)
                    }
                    IfCondition NotEqual(prev, 0) ThenBlock: {
                        WRMEM_64(prev, 8, 0)
                    } ElseBlock: {
                        WRMEM_64(em, 16, 0)
                    }
                    WRMEM_64(on2, 8, em)
                    WRMEM_64(em, 8, cn3)
                    inner = RDMEM_64(opener, 56)
                    WhileLoop NotEqual(inner, closer) {
                        nxt = RDMEM_64(inner, 56)
                        prv = RDMEM_64(inner, 48)
                        nx2 = RDMEM_64(inner, 56)
                        IfCondition NotEqual(prv, 0) ThenBlock: {
                            WRMEM_64(prv, 56, nx2)
                        }
                        IfCondition NotEqual(nx2, 0) ThenBlock: {
                            WRMEM_64(nx2, 48, prv)
                        }
                        inner = nxt
                    }
                }
            }
        }
    }
}

Function.MD.TrimTail {
    Body: {
        t = MI.tail
        IfCondition EqualTo(t, 0) ThenBlock: { ReturnValue(0) }
        k = RDMEM_64(t)
        IfCondition NotEqual(k, 1) ThenBlock: { ReturnValue(0) }
        data = RDMEM_64(t, 16)
        len = RDMEM_64(t, 24)
        trimming = 1
        WhileLoop EqualTo(trimming, 1) {
            IfCondition LessEqual(len, 0) ThenBlock: {
                trimming = 0
            } ElseBlock: {
                b = RDMEM_8(data, Subtract(len, 1))
                IfCondition EqualTo(b, 32) ThenBlock: {
                    len = Subtract(len, 1)
                    WRMEM_64(t, 24, len)
                    WRMEM_8(data, len, 0)
                } ElseBlock: {
                    trimming = 0
                }
            }
        }
    }
}

Function.MD.ParseInlines {
    Input: text: Address
    Input: n: Integer
    Output: Address
    Body: {
        MI.txt = text
        MI.tlen = n
        MI.pos = 0
        MI.head = 0
        MI.tail = 0
        MI.dhead = 0
        MI.dtail = 0
        MI.ctext = 0
        IfCondition EqualTo(text, 0) ThenBlock: { ReturnValue(0) }
        WhileLoop LessThan(MI.pos, MI.tlen) {
            b = MD.At()
            IfCondition EqualTo(b, 96) ThenBlock: {
                MI.ctext = 0
                MD.CodeSpan()
            } ElseBlock: {
                IfCondition EqualTo(b, 92) ThenBlock: {
                    n1 = MD.AtN(1)
                    IfCondition EqualTo(n1, 10) ThenBlock: {
                        MD.TextByte(92)
                        MI.pos = Add(MI.pos, 1)
                        MD.HardSoft()
                    } ElseBlock: {
                        pun = MD.Punct(n1)
                        IfCondition EqualTo(pun, 1) ThenBlock: {
                            MD.TextByte(n1)
                            MI.pos = Add(MI.pos, 2)
                        } ElseBlock: {
                            MD.TextByte(92)
                            MI.pos = Add(MI.pos, 1)
                        }
                    }
                } ElseBlock: {
                    IfCondition EqualTo(b, 10) ThenBlock: {
                        MD.HardSoft()
                    } ElseBlock: {
                        IfCondition EqualTo(b, 38) ThenBlock: {
                            hit = MD.ParseEnt()
                            IfCondition EqualTo(hit, 0) ThenBlock: {
                                MD.TextByte(38)
                                MI.pos = Add(MI.pos, 1)
                            }
                        } ElseBlock: {
                            IfCondition EqualTo(b, 42) ThenBlock: {
                                MD.DelimRun(42)
                            } ElseBlock: {
                                IfCondition EqualTo(b, 95) ThenBlock: {
                                    MD.DelimRun(95)
                                } ElseBlock: {
                                    IfCondition EqualTo(b, 91) ThenBlock: {
                                        node = MD.InNew(1)
                                        buf = Allocate(2)
                                        WRMEM_8(buf, 0, 91)
                                        WRMEM_8(buf, 1, 0)
                                        WRMEM_64(node, 16, buf)
                                        WRMEM_64(node, 24, 1)
                                        WRMEM_64(node, 32, 2)
                                        WRMEM_64(node, 56, MI.pos)
                                        MD.InLink(node)
                                        MI.ctext = 0
                                        MD.PushDelim(91, 1, 1, 0, node)
                                        MI.pos = Add(MI.pos, 1)
                                    } ElseBlock: {
                                        IfCondition EqualTo(b, 33) ThenBlock: {
                                            n2 = MD.AtN(1)
                                            IfCondition EqualTo(n2, 91) ThenBlock: {
                                                node2 = MD.InNew(1)
                                                buf2 = Allocate(3)
                                                WRMEM_8(buf2, 0, 33)
                                                WRMEM_8(buf2, 1, 91)
                                                WRMEM_8(buf2, 2, 0)
                                                WRMEM_64(node2, 16, buf2)
                                                WRMEM_64(node2, 24, 2)
                                                WRMEM_64(node2, 32, 4)
                                                WRMEM_64(node2, 56, Add(MI.pos, 1))
                                                MD.InLink(node2)
                                                MI.ctext = 0
                                                MD.PushDelim(33, 1, 1, 0, node2)
                                                MI.pos = Add(MI.pos, 2)
                                            } ElseBlock: {
                                                MD.TextByte(33)
                                                MI.pos = Add(MI.pos, 1)
                                            }
                                        } ElseBlock: {
                                            IfCondition EqualTo(b, 93) ThenBlock: {
                                                MI.pos = Add(MI.pos, 1)
                                                MI.ctext = 0
                                                MD.LookLink(MI.pos)
                                            } ElseBlock: {
                                                IfCondition EqualTo(b, 60) ThenBlock: {
                                                    hit2 = MD.TryAuto()
                                                    IfCondition EqualTo(hit2, 0) ThenBlock: {
                                                        hit3 = MD.TryRaw()
                                                        IfCondition EqualTo(hit3, 0) ThenBlock: {
                                                            MD.TextByte(60)
                                                            MI.pos = Add(MI.pos, 1)
                                                        }
                                                    }
                                                } ElseBlock: {
                                                    MD.TextByte(b)
                                                    MI.pos = Add(MI.pos, 1)
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        MD.TrimTail()
        MD.MatchEm()
        ReturnValue(MI.head)
    }
}

Function.MD.DelimRun {
    Input: ch: Integer
    Body: {
        prev = MD.PrevCp()
        n = 0
        counting = 1
        WhileLoop EqualTo(counting, 1) {
            bch = MD.At()
            IfCondition EqualTo(bch, ch) ThenBlock: {
                n = Add(n, 1)
                MI.pos = Add(MI.pos, 1)
            } ElseBlock: {
                counting = 0
            }
        }
        next = MD.NextCp()
        pw = MD.CpWs(prev)
        nw = MD.CpWs(next)
        pp = MD.CpPunct(prev)
        np = MD.CpPunct(next)
        left = 0
        IfCondition EqualTo(nw, 0) ThenBlock: {
            IfCondition EqualTo(np, 0) ThenBlock: {
                left = 1
            } ElseBlock: {
                IfCondition EqualTo(pw, 1) ThenBlock: { left = 1 }
                IfCondition EqualTo(pp, 1) ThenBlock: { left = 1 }
                IfCondition LessThan(prev, 0) ThenBlock: { left = 1 }
            }
        }
        right = 0
        IfCondition EqualTo(pw, 0) ThenBlock: {
            IfCondition EqualTo(pp, 0) ThenBlock: {
                IfCondition GreaterEqual(prev, 0) ThenBlock: { right = 1 }
            } ElseBlock: {
                IfCondition EqualTo(nw, 1) ThenBlock: { right = 1 }
                IfCondition EqualTo(np, 1) ThenBlock: { right = 1 }
                IfCondition LessThan(next, 0) ThenBlock: { right = 1 }
            }
        }
        IfCondition EqualTo(ch, 95) ThenBlock: {
            pa = MD.Alnum(prev)
            na = MD.Alnum(next)
            wasl = left
            wasr = right
            IfCondition EqualTo(wasl, 1) ThenBlock: {
                IfCondition EqualTo(wasr, 1) ThenBlock: {
                    IfCondition EqualTo(pp, 0) ThenBlock: { left = 0 }
                    IfCondition EqualTo(np, 0) ThenBlock: { right = 0 }
                }
            }
            IfCondition EqualTo(pa, 1) ThenBlock: {
                IfCondition EqualTo(pp, 0) ThenBlock: { left = 0 }
            }
            IfCondition EqualTo(na, 1) ThenBlock: {
                IfCondition EqualTo(np, 0) ThenBlock: { right = 0 }
            }
        }
        node = MD.InNew(1)
        buf = Allocate(Add(n, 1))
        i = 0
        WhileLoop LessThan(i, n) {
            WRMEM_8(buf, i, ch)
            i = Add(i, 1)
        }
        WRMEM_8(buf, n, 0)
        WRMEM_64(node, 16, buf)
        WRMEM_64(node, 24, n)
        WRMEM_64(node, 32, Add(n, 1))
        MD.InLink(node)
        MI.ctext = 0
        MD.PushDelim(ch, n, left, right, node)
    }
}

Function.MD.TryAuto {
    Output: Integer
    Body: {
        save = MI.pos
        MI.pos = Add(MI.pos, 1)
        b = MD.At()
        letters = 0
        reading = 1
        WhileLoop EqualTo(reading, 1) {
            IfCondition GreaterEqual(letters, 32) ThenBlock: {
                reading = 0
            } ElseBlock: {
                c = MD.AtN(letters)
                up = 0
                IfCondition GreaterEqual(c, 65) ThenBlock: {
                    IfCondition LessEqual(c, 90) ThenBlock: { up = 1 }
                }
                IfCondition GreaterEqual(c, 97) ThenBlock: {
                    IfCondition LessEqual(c, 122) ThenBlock: { up = 1 }
                }
                IfCondition GreaterEqual(c, 48) ThenBlock: {
                    IfCondition LessEqual(c, 57) ThenBlock: { up = 1 }
                }
                IfCondition EqualTo(c, 43) ThenBlock: { up = 1 }
                IfCondition EqualTo(c, 45) ThenBlock: { up = 1 }
                IfCondition EqualTo(c, 46) ThenBlock: { up = 1 }
                IfCondition EqualTo(up, 1) ThenBlock: {
                    IfCondition EqualTo(letters, 0) ThenBlock: {
                        alpha = 0
                        IfCondition GreaterEqual(c, 65) ThenBlock: {
                            IfCondition LessEqual(c, 90) ThenBlock: { alpha = 1 }
                        }
                        IfCondition GreaterEqual(c, 97) ThenBlock: {
                            IfCondition LessEqual(c, 122) ThenBlock: { alpha = 1 }
                        }
                        IfCondition EqualTo(alpha, 0) ThenBlock: {
                            reading = 0
                        } ElseBlock: {
                            letters = Add(letters, 1)
                        }
                    } ElseBlock: {
                        letters = Add(letters, 1)
                    }
                } ElseBlock: {
                    reading = 0
                }
            }
        }
        scheme = 0
        IfCondition GreaterEqual(letters, 2) ThenBlock: {
            IfCondition LessEqual(letters, 32) ThenBlock: {
                colon = MD.AtN(letters)
                IfCondition EqualTo(colon, 58) ThenBlock: { scheme = 1 }
            }
        }
        IfCondition EqualTo(scheme, 1) ThenBlock: {
            p = Add(MI.pos, Add(letters, 1))
            end = -1
            WhileLoop LessThan(p, MI.tlen) {
                c2 = RDMEM_8(MI.txt, p)
                IfCondition EqualTo(c2, 62) ThenBlock: {
                    end = p
                    p = MI.tlen
                } ElseBlock: {
                    bad = MD.WsByte(c2)
                    IfCondition EqualTo(c2, 60) ThenBlock: { bad = 1 }
                    IfCondition LessThan(c2, 32) ThenBlock: { bad = 1 }
                    IfCondition EqualTo(c2, 127) ThenBlock: { bad = 1 }
                    IfCondition EqualTo(bad, 1) ThenBlock: {
                        p = MI.tlen
                    } ElseBlock: {
                        p = Add(p, 1)
                    }
                }
            }
            IfCondition GreaterEqual(end, 0) ThenBlock: {
                ln = Subtract(end, MI.pos)
                buf = Allocate(Add(ln, 1))
                MemoryCopy(buf, Add(MI.txt, MI.pos), ln)
                WRMEM_8(buf, ln, 0)
                node = MD.InNew(5)
                text = MD.InNew(1)
                WRMEM_64(text, 16, buf)
                WRMEM_64(text, 24, ln)
                WRMEM_64(node, 16, text)
                WRMEM_64(node, 24, buf)
                WRMEM_64(node, 32, ln)
                MD.InLink(node)
                MI.ctext = 0
                MI.pos = Add(end, 1)
                ReturnValue(1)
            }
        }
        em = MD.TryEmail()
        IfCondition EqualTo(em, 1) ThenBlock: {
            ReturnValue(1)
        }
        MI.pos = save
        ReturnValue(0)
    }
}
