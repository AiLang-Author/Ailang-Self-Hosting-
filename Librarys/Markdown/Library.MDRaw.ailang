Function.MD.TagChar {
    Input: b: Integer
    Input: first: Integer
    Output: Integer
    Body: {
        IfCondition GreaterEqual(b, 65) ThenBlock: {
            IfCondition LessEqual(b, 90) ThenBlock: { ReturnValue(1) }
        }
        IfCondition GreaterEqual(b, 97) ThenBlock: {
            IfCondition LessEqual(b, 122) ThenBlock: { ReturnValue(1) }
        }
        IfCondition EqualTo(first, 1) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterEqual(b, 48) ThenBlock: {
            IfCondition LessEqual(b, 57) ThenBlock: { ReturnValue(1) }
        }
        IfCondition EqualTo(b, 45) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

Function.MD.AttrChar {
    Input: b: Integer
    Input: first: Integer
    Output: Integer
    Body: {
        IfCondition GreaterEqual(b, 65) ThenBlock: {
            IfCondition LessEqual(b, 90) ThenBlock: { ReturnValue(1) }
        }
        IfCondition GreaterEqual(b, 97) ThenBlock: {
            IfCondition LessEqual(b, 122) ThenBlock: { ReturnValue(1) }
        }
        IfCondition EqualTo(b, 95) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(b, 58) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(first, 1) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterEqual(b, 48) ThenBlock: {
            IfCondition LessEqual(b, 57) ThenBlock: { ReturnValue(1) }
        }
        IfCondition EqualTo(b, 45) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(b, 46) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

Function.MD.OneWs {
    Output: Integer
    Body: {
        saw = 0
        nl = 0
        looping = 1
        WhileLoop EqualTo(looping, 1) {
            b = MD.At()
            IfCondition EqualTo(b, 32) ThenBlock: {
                saw = 1
                MI.pos = Add(MI.pos, 1)
            } ElseBlock: {
                IfCondition EqualTo(b, 9) ThenBlock: {
                    saw = 1
                    MI.pos = Add(MI.pos, 1)
                } ElseBlock: {
                    IfCondition EqualTo(b, 10) ThenBlock: {
                        IfCondition EqualTo(nl, 0) ThenBlock: {
                            saw = 1
                            nl = 1
                            MI.pos = Add(MI.pos, 1)
                        } ElseBlock: {
                            looping = 0
                        }
                    } ElseBlock: {
                        looping = 0
                    }
                }
            }
        }
        ReturnValue(saw)
    }
}

Function.MD.ReadTag {
    Output: Integer
    Body: {
        b = MD.At()
        ok = MD.TagChar(b, 1)
        IfCondition EqualTo(ok, 0) ThenBlock: { ReturnValue(0) }
        n = 0
        looping = 1
        WhileLoop EqualTo(looping, 1) {
            c = MD.At()
            good = MD.TagChar(c, 0)
            IfCondition EqualTo(n, 0) ThenBlock: { good = MD.TagChar(c, 1) }
            IfCondition EqualTo(good, 1) ThenBlock: {
                n = Add(n, 1)
                MI.pos = Add(MI.pos, 1)
            } ElseBlock: {
                looping = 0
            }
        }
        ReturnValue(n)
    }
}

Function.MD.ReadAttr {
    Output: Integer
    Body: {
        b = MD.At()
        ok = MD.AttrChar(b, 1)
        IfCondition EqualTo(ok, 0) ThenBlock: { ReturnValue(0) }
        MI.pos = Add(MI.pos, 1)
        looping = 1
        WhileLoop EqualTo(looping, 1) {
            c = MD.At()
            good = MD.AttrChar(c, 0)
            IfCondition EqualTo(good, 1) ThenBlock: {
                MI.pos = Add(MI.pos, 1)
            } ElseBlock: {
                looping = 0
            }
        }
        save = MI.pos
        MD.OneWs()
        eq = MD.At()
        IfCondition NotEqual(eq, 61) ThenBlock: {
            MI.pos = save
            ReturnValue(1)
        }
        MI.pos = Add(MI.pos, 1)
        MD.OneWs()
        v = MD.At()
        IfCondition EqualTo(v, 34) ThenBlock: {
            MI.pos = Add(MI.pos, 1)
            looping2 = 1
            WhileLoop EqualTo(looping2, 1) {
                c2 = MD.At()
                IfCondition LessThan(c2, 0) ThenBlock: { ReturnValue(-1) }
                IfCondition EqualTo(c2, 34) ThenBlock: {
                    MI.pos = Add(MI.pos, 1)
                    looping2 = 0
                } ElseBlock: {
                    MI.pos = Add(MI.pos, 1)
                }
            }
            ReturnValue(1)
        }
        IfCondition EqualTo(v, 39) ThenBlock: {
            MI.pos = Add(MI.pos, 1)
            looping3 = 1
            WhileLoop EqualTo(looping3, 1) {
                c3 = MD.At()
                IfCondition LessThan(c3, 0) ThenBlock: { ReturnValue(-1) }
                IfCondition EqualTo(c3, 39) ThenBlock: {
                    MI.pos = Add(MI.pos, 1)
                    looping3 = 0
                } ElseBlock: {
                    MI.pos = Add(MI.pos, 1)
                }
            }
            ReturnValue(1)
        }
        unq = 0
        looping4 = 1
        WhileLoop EqualTo(looping4, 1) {
            c4 = MD.At()
            bad = 0
            IfCondition LessThan(c4, 0) ThenBlock: { bad = 1 }
            IfCondition EqualTo(c4, 32) ThenBlock: { bad = 1 }
            IfCondition EqualTo(c4, 9) ThenBlock: { bad = 1 }
            IfCondition EqualTo(c4, 10) ThenBlock: { bad = 1 }
            IfCondition EqualTo(c4, 34) ThenBlock: { bad = 1 }
            IfCondition EqualTo(c4, 39) ThenBlock: { bad = 1 }
            IfCondition EqualTo(c4, 61) ThenBlock: { bad = 1 }
            IfCondition EqualTo(c4, 60) ThenBlock: { bad = 1 }
            IfCondition EqualTo(c4, 62) ThenBlock: { bad = 1 }
            IfCondition EqualTo(c4, 96) ThenBlock: { bad = 1 }
            IfCondition EqualTo(bad, 1) ThenBlock: {
                looping4 = 0
            } ElseBlock: {
                unq = Add(unq, 1)
                MI.pos = Add(MI.pos, 1)
            }
        }
        IfCondition EqualTo(unq, 0) ThenBlock: { ReturnValue(-1) }
        ReturnValue(1)
    }
}

Function.MD.EmitRaw {
    Input: start: Integer
    Input: endp: Integer
    Body: {
        ln = Subtract(endp, start)
        buf = Allocate(Add(ln, 1))
        MemoryCopy(buf, Add(MI.txt, start), ln)
        WRMEM_8(buf, ln, 0)
        node = MD.InNew(7)
        WRMEM_64(node, 16, buf)
        WRMEM_64(node, 24, ln)
        MD.InLink(node)
        MI.ctext = 0
        MI.pos = endp
    }
}

Function.MD.TryRaw {
    Output: Integer
    Body: {
        b = MD.At()
        IfCondition NotEqual(b, 60) ThenBlock: { ReturnValue(0) }
        save = MI.pos
        MI.pos = Add(MI.pos, 1)
        n1 = MD.At()
        ok = 0
        IfCondition EqualTo(n1, 47) ThenBlock: {
            MI.pos = Add(MI.pos, 1)
            tn = MD.ReadTag()
            IfCondition GreaterThan(tn, 0) ThenBlock: {
                MD.OneWs()
                cl = MD.At()
                IfCondition EqualTo(cl, 62) ThenBlock: {
                    MI.pos = Add(MI.pos, 1)
                    ok = 1
                }
            }
        } ElseBlock: {
            IfCondition EqualTo(n1, 63) ThenBlock: {
                MI.pos = Add(MI.pos, 1)
                looping = 1
                WhileLoop EqualTo(looping, 1) {
                    c = MD.At()
                    IfCondition LessThan(c, 0) ThenBlock: {
                        looping = 0
                    } ElseBlock: {
                        IfCondition EqualTo(c, 63) ThenBlock: {
                            n2 = MD.AtN(1)
                            IfCondition EqualTo(n2, 62) ThenBlock: {
                                MI.pos = Add(MI.pos, 2)
                                ok = 1
                                looping = 0
                            } ElseBlock: {
                                MI.pos = Add(MI.pos, 1)
                            }
                        } ElseBlock: {
                            MI.pos = Add(MI.pos, 1)
                        }
                    }
                }
            } ElseBlock: {
                IfCondition EqualTo(n1, 33) ThenBlock: {
                    MI.pos = Add(MI.pos, 1)
                    a = MD.At()
                    d = MD.AtN(1)
                    IfCondition EqualTo(a, 45) ThenBlock: {
                        IfCondition EqualTo(d, 45) ThenBlock: {
                            e = MD.AtN(2)
                            f = MD.AtN(3)
                            IfCondition EqualTo(e, 62) ThenBlock: {
                                MI.pos = Add(MI.pos, 3)
                                ok = 1
                            } ElseBlock: {
                                IfCondition EqualTo(e, 45) ThenBlock: {
                                    IfCondition EqualTo(f, 62) ThenBlock: {
                                        MI.pos = Add(MI.pos, 4)
                                        ok = 1
                                    }
                                }
                            }
                            IfCondition EqualTo(ok, 0) ThenBlock: {
                                MI.pos = Add(MI.pos, 2)
                                looping2 = 1
                                WhileLoop EqualTo(looping2, 1) {
                                    c2 = MD.At()
                                    IfCondition LessThan(c2, 0) ThenBlock: {
                                        looping2 = 0
                                    } ElseBlock: {
                                        IfCondition EqualTo(c2, 45) ThenBlock: {
                                            p = MD.AtN(1)
                                            q = MD.AtN(2)
                                            IfCondition EqualTo(p, 45) ThenBlock: {
                                                IfCondition EqualTo(q, 62) ThenBlock: {
                                                    MI.pos = Add(MI.pos, 3)
                                                    ok = 1
                                                    looping2 = 0
                                                } ElseBlock: {
                                                    MI.pos = Add(MI.pos, 1)
                                                }
                                            } ElseBlock: {
                                                MI.pos = Add(MI.pos, 1)
                                            }
                                        } ElseBlock: {
                                            MI.pos = Add(MI.pos, 1)
                                        }
                                    }
                                }
                            }
                        }
                    } ElseBlock: {
                        IfCondition EqualTo(a, 91) ThenBlock: {
                            s1 = MD.AtN(1)
                            s2 = MD.AtN(2)
                            s3 = MD.AtN(3)
                            s4 = MD.AtN(4)
                            s5 = MD.AtN(5)
                            s6 = MD.AtN(6)
                            cdata = 0
                            IfCondition EqualTo(s1, 67) ThenBlock: { cdata = 1 }
                            IfCondition NotEqual(s2, 68) ThenBlock: { cdata = 0 }
                            IfCondition NotEqual(s3, 65) ThenBlock: { cdata = 0 }
                            IfCondition NotEqual(s4, 84) ThenBlock: { cdata = 0 }
                            IfCondition NotEqual(s5, 65) ThenBlock: { cdata = 0 }
                            IfCondition NotEqual(s6, 91) ThenBlock: { cdata = 0 }
                            IfCondition EqualTo(cdata, 1) ThenBlock: {
                                MI.pos = Add(MI.pos, 7)
                                looping3 = 1
                                WhileLoop EqualTo(looping3, 1) {
                                    c3 = MD.At()
                                    IfCondition LessThan(c3, 0) ThenBlock: {
                                        looping3 = 0
                                    } ElseBlock: {
                                        IfCondition EqualTo(c3, 93) ThenBlock: {
                                            r = MD.AtN(1)
                                            t = MD.AtN(2)
                                            IfCondition EqualTo(r, 93) ThenBlock: {
                                                IfCondition EqualTo(t, 62) ThenBlock: {
                                                    MI.pos = Add(MI.pos, 3)
                                                    ok = 1
                                                    looping3 = 0
                                                } ElseBlock: {
                                                    MI.pos = Add(MI.pos, 1)
                                                }
                                            } ElseBlock: {
                                                MI.pos = Add(MI.pos, 1)
                                            }
                                        } ElseBlock: {
                                            MI.pos = Add(MI.pos, 1)
                                        }
                                    }
                                }
                            }
                        } ElseBlock: {
                            up = 0
                            IfCondition GreaterEqual(a, 65) ThenBlock: {
                                IfCondition LessEqual(a, 90) ThenBlock: { up = 1 }
                            }
                            IfCondition EqualTo(up, 1) ThenBlock: {
                                looping4 = 1
                                WhileLoop EqualTo(looping4, 1) {
                                    c4 = MD.At()
                                    IfCondition LessThan(c4, 0) ThenBlock: {
                                        looping4 = 0
                                    } ElseBlock: {
                                        IfCondition EqualTo(c4, 62) ThenBlock: {
                                            MI.pos = Add(MI.pos, 1)
                                            ok = 1
                                            looping4 = 0
                                        } ElseBlock: {
                                            MI.pos = Add(MI.pos, 1)
                                        }
                                    }
                                }
                            }
                        }
                    }
                } ElseBlock: {
                    tn2 = MD.ReadTag()
                    IfCondition GreaterThan(tn2, 0) ThenBlock: {
                        bad = 0
                        looping5 = 1
                        WhileLoop EqualTo(looping5, 1) {
                            wsave = MI.pos
                            saw = MD.OneWs()
                            nx = MD.At()
                            IfCondition EqualTo(saw, 0) ThenBlock: {
                                looping5 = 0
                            } ElseBlock: {
                                IfCondition EqualTo(nx, 47) ThenBlock: {
                                    MI.pos = wsave
                                    looping5 = 0
                                } ElseBlock: {
                                    IfCondition EqualTo(nx, 62) ThenBlock: {
                                        MI.pos = wsave
                                        looping5 = 0
                                    } ElseBlock: {
                                        ar = MD.ReadAttr()
                                        IfCondition LessThan(ar, 0) ThenBlock: {
                                            bad = 1
                                            looping5 = 0
                                        }
                                        IfCondition EqualTo(ar, 0) ThenBlock: {
                                            bad = 1
                                            looping5 = 0
                                        }
                                    }
                                }
                            }
                        }
                        IfCondition EqualTo(bad, 0) ThenBlock: {
                            MD.OneWs()
                            sl = MD.At()
                            IfCondition EqualTo(sl, 47) ThenBlock: { MI.pos = Add(MI.pos, 1) }
                            gt = MD.At()
                            IfCondition EqualTo(gt, 62) ThenBlock: {
                                MI.pos = Add(MI.pos, 1)
                                ok = 1
                            }
                        }
                    }
                }
            }
        }
        IfCondition EqualTo(ok, 1) ThenBlock: {
            MD.EmitRaw(save, MI.pos)
            ReturnValue(1)
        }
        MI.pos = save
        ReturnValue(0)
    }
}

Function.MD.MailOk {
    Input: b: Integer
    Output: Integer
    Body: {
        IfCondition GreaterEqual(b, 48) ThenBlock: {
            IfCondition LessEqual(b, 57) ThenBlock: { ReturnValue(1) }
        }
        IfCondition GreaterEqual(b, 65) ThenBlock: {
            IfCondition LessEqual(b, 90) ThenBlock: { ReturnValue(1) }
        }
        IfCondition GreaterEqual(b, 97) ThenBlock: {
            IfCondition LessEqual(b, 122) ThenBlock: { ReturnValue(1) }
        }
        IfCondition EqualTo(b, 46) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(b, 33) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(b, 35) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(b, 36) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(b, 37) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(b, 38) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(b, 39) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(b, 42) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(b, 43) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(b, 47) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(b, 61) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(b, 63) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(b, 94) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(b, 95) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(b, 96) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(b, 123) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(b, 124) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(b, 125) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(b, 126) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(b, 45) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

Function.MD.TryEmail {
    Output: Integer
    Body: {
        start = MI.pos
        i = start
        at = -1
        local = 0
        bad = 0
        looping = 1
        WhileLoop EqualTo(looping, 1) {
            IfCondition GreaterEqual(i, MI.tlen) ThenBlock: {
                bad = 1
                looping = 0
            } ElseBlock: {
                c = RDMEM_8(MI.txt, i)
                IfCondition EqualTo(c, 62) ThenBlock: {
                    looping = 0
                } ElseBlock: {
                    IfCondition EqualTo(c, 64) ThenBlock: {
                        IfCondition GreaterEqual(at, 0) ThenBlock: { bad = 1 }
                        at = i
                        i = Add(i, 1)
                    } ElseBlock: {
                        IfCondition LessThan(at, 0) ThenBlock: {
                            mk = MD.MailOk(c)
                            IfCondition EqualTo(mk, 0) ThenBlock: { bad = 1 }
                            local = Add(local, 1)
                        }
                        i = Add(i, 1)
                    }
                }
            }
        }
        IfCondition EqualTo(bad, 1) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(at, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(local, 0) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterEqual(i, MI.tlen) ThenBlock: { ReturnValue(0) }
        endc = RDMEM_8(MI.txt, i)
        IfCondition NotEqual(endc, 62) ThenBlock: { ReturnValue(0) }
        dom = Add(at, 1)
        IfCondition GreaterEqual(dom, i) ThenBlock: { ReturnValue(0) }
        p = dom
        label = 0
        hy = 0
        WhileLoop LessThan(p, i) {
            c2 = RDMEM_8(MI.txt, p)
            IfCondition EqualTo(c2, 46) ThenBlock: {
                IfCondition EqualTo(label, 0) ThenBlock: { ReturnValue(0) }
                IfCondition EqualTo(hy, 1) ThenBlock: { ReturnValue(0) }
                label = 0
                hy = 0
            } ElseBlock: {
                al = 0
                IfCondition GreaterEqual(c2, 48) ThenBlock: {
                    IfCondition LessEqual(c2, 57) ThenBlock: { al = 1 }
                }
                IfCondition GreaterEqual(c2, 65) ThenBlock: {
                    IfCondition LessEqual(c2, 90) ThenBlock: { al = 1 }
                }
                IfCondition GreaterEqual(c2, 97) ThenBlock: {
                    IfCondition LessEqual(c2, 122) ThenBlock: { al = 1 }
                }
                IfCondition EqualTo(c2, 45) ThenBlock: {
                    IfCondition EqualTo(label, 0) ThenBlock: { ReturnValue(0) }
                    hy = 1
                    al = 1
                }
                IfCondition EqualTo(al, 0) ThenBlock: { ReturnValue(0) }
                IfCondition NotEqual(c2, 45) ThenBlock: { hy = 0 }
                label = Add(label, 1)
                IfCondition GreaterThan(label, 63) ThenBlock: { ReturnValue(0) }
            }
            p = Add(p, 1)
        }
        IfCondition EqualTo(label, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(hy, 1) ThenBlock: { ReturnValue(0) }
        ln = Subtract(i, start)
        addr = Allocate(Add(ln, 1))
        MemoryCopy(addr, Add(MI.txt, start), ln)
        WRMEM_8(addr, ln, 0)
        url = Allocate(Add(ln, 8))
        WRMEM_8(url, 0, 109)
        WRMEM_8(url, 1, 97)
        WRMEM_8(url, 2, 105)
        WRMEM_8(url, 3, 108)
        WRMEM_8(url, 4, 116)
        WRMEM_8(url, 5, 111)
        WRMEM_8(url, 6, 58)
        MemoryCopy(Add(url, 7), addr, ln)
        ulen = Add(ln, 7)
        WRMEM_8(url, ulen, 0)
        node = MD.InNew(5)
        text = MD.InNew(1)
        WRMEM_64(text, 16, addr)
        WRMEM_64(text, 24, ln)
        WRMEM_64(node, 16, text)
        WRMEM_64(node, 24, url)
        WRMEM_64(node, 32, ulen)
        MD.InLink(node)
        MI.ctext = 0
        MI.pos = Add(i, 1)
        ReturnValue(1)
    }
}
