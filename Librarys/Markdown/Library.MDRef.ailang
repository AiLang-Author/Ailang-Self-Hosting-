Function.MD.NormSlice {
    Input: data: Address
    Input: start: Integer
    Input: end: Integer
    Output: Address
    Body: {
        buf = Allocate(1024)
        n = 0
        sp = 0
        i = start
        WhileLoop LessThan(i, end) {
            b = RDMEM_8(data, i)
            ws = 0
            IfCondition EqualTo(b, 32) ThenBlock: { ws = 1 }
            IfCondition EqualTo(b, 9) ThenBlock: { ws = 1 }
            IfCondition EqualTo(b, 10) ThenBlock: { ws = 1 }
            IfCondition EqualTo(b, 13) ThenBlock: { ws = 1 }
            IfCondition EqualTo(ws, 1) ThenBlock: {
                sp = 1
                i = Add(i, 1)
            } ElseBlock: {
                IfCondition EqualTo(sp, 1) ThenBlock: {
                    IfCondition GreaterThan(n, 0) ThenBlock: {
                        IfCondition LessThan(n, 1000) ThenBlock: {
                            WRMEM_8(buf, n, 32)
                            n = Add(n, 1)
                        }
                    }
                }
                sp = 0
                IfCondition EqualTo(b, 206) ThenBlock: {
                    nxt = Add(i, 1)
                    IfCondition LessThan(nxt, end) ThenBlock: {
                        b2 = RDMEM_8(data, nxt)
                        greek = 0
                        IfCondition GreaterEqual(b2, 145) ThenBlock: {
                            IfCondition LessEqual(b2, 169) ThenBlock: { greek = 1 }
                        }
                        IfCondition EqualTo(greek, 1) ThenBlock: {
                            IfCondition LessThan(n, 998) ThenBlock: {
                                nb = Add(n, 1)
                                hi = 206
                                sec = Add(b2, 32)
                                IfCondition GreaterEqual(b2, 160) ThenBlock: {
                                    hi = 207
                                    sec = Subtract(b2, 32)
                                }
                                IfCondition EqualTo(b2, 162) ThenBlock: {
                                    hi = 206
                                    sec = b2
                                }
                                WRMEM_8(buf, n, hi)
                                WRMEM_8(buf, nb, sec)
                                n = Add(n, 2)
                            }
                            i = Add(i, 2)
                        } ElseBlock: {
                            IfCondition LessThan(n, 999) ThenBlock: {
                                WRMEM_8(buf, n, b)
                                n = Add(n, 1)
                            }
                            i = Add(i, 1)
                        }
                    } ElseBlock: {
                        IfCondition LessThan(n, 999) ThenBlock: {
                            WRMEM_8(buf, n, b)
                            n = Add(n, 1)
                        }
                        i = Add(i, 1)
                    }
                } ElseBlock: {
                    sharp = 0
                    IfCondition EqualTo(b, 225) ThenBlock: {
                        n1s = Add(i, 1)
                        n2s = Add(i, 2)
                        IfCondition LessThan(n2s, end) ThenBlock: {
                            c1s = RDMEM_8(data, n1s)
                            c2s = RDMEM_8(data, n2s)
                            IfCondition EqualTo(c1s, 186) ThenBlock: {
                                IfCondition EqualTo(c2s, 158) ThenBlock: { sharp = 1 }
                            }
                        }
                    }
                    IfCondition EqualTo(sharp, 1) ThenBlock: {
                        IfCondition LessThan(n, 998) ThenBlock: {
                            WRMEM_8(buf, n, 115)
                            WRMEM_8(buf, Add(n, 1), 115)
                            n = Add(n, 2)
                        }
                        i = Add(i, 3)
                    } ElseBlock: {
                        low = MD.Lower(b)
                        IfCondition LessThan(n, 999) ThenBlock: {
                            WRMEM_8(buf, n, low)
                            n = Add(n, 1)
                        }
                        i = Add(i, 1)
                    }
                }
            }
        }
        IfCondition EqualTo(n, 0) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterThan(n, 999) ThenBlock: { ReturnValue(0) }
        WRMEM_8(buf, n, 0)
        ReturnValue(buf)
    }
}

Function.MD.Utf8Put {
    Input: buf: Address
    Input: n: Integer
    Input: cp: Integer
    Output: Integer
    Body: {
        IfCondition LessEqual(cp, 0) ThenBlock: { cp = 65533 }
        IfCondition GreaterThan(cp, 1114111) ThenBlock: { cp = 65533 }
        IfCondition GreaterEqual(cp, 55296) ThenBlock: {
            IfCondition LessEqual(cp, 57343) ThenBlock: { cp = 65533 }
        }
        IfCondition LessThan(cp, 128) ThenBlock: {
            WRMEM_8(buf, n, cp)
            ReturnValue(Add(n, 1))
        }
        IfCondition LessThan(cp, 2048) ThenBlock: {
            b0 = Divide(cp, 64)
            b0 = Add(b0, 192)
            b1 = Modulo(cp, 64)
            b1 = Add(b1, 128)
            WRMEM_8(buf, n, b0)
            WRMEM_8(buf, Add(n, 1), b1)
            ReturnValue(Add(n, 2))
        }
        IfCondition LessThan(cp, 65536) ThenBlock: {
            b0 = Divide(cp, 4096)
            b0 = Add(b0, 224)
            rem = Modulo(cp, 4096)
            b1 = Divide(rem, 64)
            b1 = Add(b1, 128)
            b2 = Modulo(cp, 64)
            b2 = Add(b2, 128)
            WRMEM_8(buf, n, b0)
            WRMEM_8(buf, Add(n, 1), b1)
            WRMEM_8(buf, Add(n, 2), b2)
            ReturnValue(Add(n, 3))
        }
        b0 = Divide(cp, 262144)
        b0 = Add(b0, 240)
        r1 = Modulo(cp, 262144)
        b1 = Divide(r1, 4096)
        b1 = Add(b1, 128)
        r2 = Modulo(cp, 4096)
        b2 = Divide(r2, 64)
        b2 = Add(b2, 128)
        b3 = Modulo(cp, 64)
        b3 = Add(b3, 128)
        WRMEM_8(buf, n, b0)
        WRMEM_8(buf, Add(n, 1), b1)
        WRMEM_8(buf, Add(n, 2), b2)
        WRMEM_8(buf, Add(n, 3), b3)
        ReturnValue(Add(n, 4))
    }
}

Function.MD.BufEnt {
    Input: data: Address
    Input: len: Integer
    Input: pos: Integer
    Input: buf: Address
    Input: n: Integer
    Output: Integer
    Body: {
        IfCondition GreaterEqual(pos, len) ThenBlock: { ReturnValue(-1) }
        b = RDMEM_8(data, pos)
        IfCondition NotEqual(b, 38) ThenBlock: { ReturnValue(-1) }
        i = Add(pos, 1)
        slot = Allocate(8)
        WRMEM_64(slot, i)
        IfCondition GreaterEqual(i, len) ThenBlock: { ReturnValue(-1) }
        b2 = RDMEM_8(data, i)
        IfCondition EqualTo(b2, 35) ThenBlock: {
            i = Add(i, 1)
            hex = 0
            IfCondition LessThan(i, len) ThenBlock: {
                h = RDMEM_8(data, i)
                IfCondition EqualTo(h, 120) ThenBlock: { hex = 1 }
                IfCondition EqualTo(h, 88) ThenBlock: { hex = 1 }
            }
            IfCondition EqualTo(hex, 1) ThenBlock: { i = Add(i, 1) }
            val = 0
            digits = 0
            looping = 1
            WRMEM_64(slot, i)
            WhileLoop EqualTo(looping, 1) {
                i = RDMEM_64(slot)
                IfCondition GreaterEqual(i, len) ThenBlock: {
                    looping = 0
                } ElseBlock: {
                    d = RDMEM_8(data, i)
                    dig = -1
                    IfCondition GreaterEqual(d, 48) ThenBlock: {
                        IfCondition LessEqual(d, 57) ThenBlock: { dig = Subtract(d, 48) }
                    }
                    IfCondition EqualTo(hex, 1) ThenBlock: {
                        IfCondition GreaterEqual(d, 97) ThenBlock: {
                            IfCondition LessEqual(d, 102) ThenBlock: { dig = Subtract(d, 87) }
                        }
                        IfCondition GreaterEqual(d, 65) ThenBlock: {
                            IfCondition LessEqual(d, 70) ThenBlock: { dig = Subtract(d, 55) }
                        }
                    }
                    IfCondition LessThan(dig, 0) ThenBlock: {
                        looping = 0
                    } ElseBlock: {
                        maxd = 7
                        IfCondition EqualTo(hex, 1) ThenBlock: { maxd = 6 }
                        IfCondition GreaterEqual(digits, maxd) ThenBlock: {
                            ReturnValue(-1)
                        }
                        base = 10
                        IfCondition EqualTo(hex, 1) ThenBlock: { base = 16 }
                        val = Multiply(val, base)
                        val = Add(val, dig)
                        digits = Add(digits, 1)
                        ni = Add(i, 1)
                        WRMEM_64(slot, ni)
                    }
                }
            }
            i = RDMEM_64(slot)
            IfCondition GreaterEqual(i, len) ThenBlock: { ReturnValue(-1) }
            endc = RDMEM_8(data, i)
            IfCondition NotEqual(endc, 59) ThenBlock: { ReturnValue(-1) }
            IfCondition EqualTo(digits, 0) ThenBlock: { ReturnValue(-1) }
            nn = MD.Utf8Put(buf, n, val)
            WRMEM_64(buf, 4088, nn)
            ReturnValue(Add(i, 1))
        }
        name = Allocate(64)
        nnm = 0
        looping2 = 1
        WRMEM_64(slot, i)
        WhileLoop EqualTo(looping2, 1) {
            i = RDMEM_64(slot)
            IfCondition GreaterEqual(i, len) ThenBlock: {
                looping2 = 0
            } ElseBlock: {
                d2 = RDMEM_8(data, i)
                ok = 0
                IfCondition GreaterEqual(d2, 65) ThenBlock: {
                    IfCondition LessEqual(d2, 90) ThenBlock: { ok = 1 }
                }
                IfCondition GreaterEqual(d2, 97) ThenBlock: {
                    IfCondition LessEqual(d2, 122) ThenBlock: { ok = 1 }
                }
                IfCondition GreaterEqual(d2, 48) ThenBlock: {
                    IfCondition LessEqual(d2, 57) ThenBlock: { ok = 1 }
                }
                take = 0
                IfCondition EqualTo(ok, 1) ThenBlock: {
                    IfCondition LessThan(nnm, 40) ThenBlock: {
                        WRMEM_8(name, nnm, d2)
                        nnm = Add(nnm, 1)
                        take = 1
                    }
                }
                IfCondition EqualTo(take, 1) ThenBlock: {
                    ni2 = Add(i, 1)
                    WRMEM_64(slot, ni2)
                } ElseBlock: {
                    looping2 = 0
                }
            }
        }
        i = RDMEM_64(slot)
        WRMEM_8(name, nnm, 0)
        IfCondition GreaterEqual(i, len) ThenBlock: { ReturnValue(-1) }
        end2 = RDMEM_8(data, i)
        IfCondition NotEqual(end2, 59) ThenBlock: { ReturnValue(-1) }
        IfCondition EqualTo(nnm, 0) ThenBlock: { ReturnValue(-1) }
        ngc = StringCompare(name, "ngE")
        IfCondition EqualTo(ngc, 0) ThenBlock: {
            n2 = MD.Utf8Put(buf, n, 8807)
            n2 = MD.Utf8Put(buf, n2, 824)
            WRMEM_64(buf, 4088, n2)
            ReturnValue(Add(i, 1))
        }
        cp = MD.NamedEnt(name)
        IfCondition LessThan(cp, 0) ThenBlock: { ReturnValue(-1) }
        n3 = MD.Utf8Put(buf, n, cp)
        WRMEM_64(buf, 4088, n3)
        ReturnValue(Add(i, 1))
    }
}

Function.MD.LabelEnd {
    Input: data: Address
    Input: len: Integer
    Input: pos: Integer
    Output: Integer
    Body: {
        i = Add(pos, 1)
        WhileLoop LessThan(i, len) {
            b = RDMEM_8(data, i)
            IfCondition EqualTo(b, 92) ThenBlock: {
                i = Add(i, 1)
                IfCondition LessThan(i, len) ThenBlock: { i = Add(i, 1) }
            } ElseBlock: {
                IfCondition EqualTo(b, 93) ThenBlock: { ReturnValue(i) }
                IfCondition EqualTo(b, 91) ThenBlock: { ReturnValue(-1) }
                i = Add(i, 1)
            }
        }
        ReturnValue(-1)
    }
}

Function.MD.RefAdd {
    Input: label: Address
    Input: llen: Integer
    Input: url: Address
    Input: ulen: Integer
    Input: title: Address
    Input: tlen: Integer
    Body: {
        i = 0
        n = Array.Size(MP.refs)
        found = 0
        WhileLoop LessThan(i, n) {
            rec = Array.Get(MP.refs, i)
            old = RDMEM_64(rec)
            cmp = StringCompare(old, label)
            IfCondition EqualTo(cmp, 0) ThenBlock: {
                found = 1
                i = n
            }
            i = Add(i, 1)
        }
        IfCondition EqualTo(found, 1) ThenBlock: { ReturnValue(0) }
        rec2 = Allocate(48)
        WRMEM_64(rec2, label)
        WRMEM_64(rec2, 8, llen)
        WRMEM_64(rec2, 16, url)
        WRMEM_64(rec2, 24, ulen)
        WRMEM_64(rec2, 32, title)
        WRMEM_64(rec2, 40, tlen)
        Array.Push(MP.refs, rec2)
    }
}

Function.MD.TakeRefs {
    Input: node: Address
    Output: Integer
    Body: {
        data = RDMEM_64(node, 24)
        len = RDMEM_64(node, 32)
        IfCondition EqualTo(data, 0) ThenBlock: { ReturnValue(0) }
        pos = 0
        moved = 0
        looping = 1
        WhileLoop EqualTo(looping, 1) {
            adv = MD.ParseRef(data, len, pos)
            IfCondition GreaterThan(adv, pos) ThenBlock: {
                moved = adv
                pos = adv
            } ElseBlock: {
                looping = 0
            }
        }
        IfCondition EqualTo(moved, 0) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterEqual(pos, len) ThenBlock: {
            WRMEM_64(node, 32, 0)
            WRMEM_8(data, 0, 0)
            ReturnValue(1)
        }
        rest = Subtract(len, pos)
        MemoryCopy(data, Add(data, pos), rest)
        WRMEM_8(data, rest, 0)
        WRMEM_64(node, 32, rest)
        ReturnValue(0)
    }
}

Function.MD.SkipH {
    Input: data: Address
    Input: len: Integer
    Input: pos: Integer
    Output: Integer
    Body: {
        i = pos
        looping = 1
        WhileLoop EqualTo(looping, 1) {
            IfCondition GreaterEqual(i, len) ThenBlock: {
                looping = 0
            } ElseBlock: {
                b = RDMEM_8(data, i)
                ws = 0
                IfCondition EqualTo(b, 32) ThenBlock: { ws = 1 }
                IfCondition EqualTo(b, 9) ThenBlock: { ws = 1 }
                IfCondition EqualTo(ws, 1) ThenBlock: {
                    i = Add(i, 1)
                } ElseBlock: {
                    looping = 0
                }
            }
        }
        ReturnValue(i)
    }
}

Function.MD.ReadRefDest {
    Input: data: Address
    Input: len: Integer
    Input: pos: Integer
    Output: Address
    Body: {
        IfCondition GreaterEqual(pos, len) ThenBlock: { ReturnValue(0) }
        url = Allocate(4096)
        un = 0
        i = pos
        b = RDMEM_8(data, i)
        IfCondition EqualTo(b, 60) ThenBlock: {
            i = Add(i, 1)
            bad = 0
            WhileLoop EqualTo(bad, 0) {
                IfCondition GreaterEqual(i, len) ThenBlock: {
                    bad = 1
                } ElseBlock: {
                    c = RDMEM_8(data, i)
                    IfCondition EqualTo(c, 62) ThenBlock: {
                        bad = 2
                    } ElseBlock: {
                        IfCondition EqualTo(c, 10) ThenBlock: {
                            bad = 1
                        } ElseBlock: {
                            IfCondition EqualTo(c, 38) ThenBlock: {
                                ep = MD.BufEnt(data, len, i, url, un)
                                IfCondition GreaterEqual(ep, 0) ThenBlock: {
                                    un = RDMEM_64(url, 4088)
                                    i = ep
                                } ElseBlock: {
                                    WRMEM_8(url, un, c)
                                    un = Add(un, 1)
                                    i = Add(i, 1)
                                }
                            } ElseBlock: {
                                IfCondition EqualTo(c, 92) ThenBlock: {
                                    i = Add(i, 1)
                                    IfCondition LessThan(i, len) ThenBlock: {
                                        c2 = RDMEM_8(data, i)
                                        pun = MD.Punct(c2)
                                        IfCondition EqualTo(pun, 1) ThenBlock: {
                                            WRMEM_8(url, un, c2)
                                            un = Add(un, 1)
                                            i = Add(i, 1)
                                        } ElseBlock: {
                                            WRMEM_8(url, un, 92)
                                            un = Add(un, 1)
                                        }
                                    } ElseBlock: {
                                        WRMEM_8(url, un, 92)
                                        un = Add(un, 1)
                                    }
                                } ElseBlock: {
                                    WRMEM_8(url, un, c)
                                    un = Add(un, 1)
                                    i = Add(i, 1)
                                }
                            }
                        }
                    }
                }
            }
            IfCondition NotEqual(bad, 2) ThenBlock: { ReturnValue(0) }
            i = Add(i, 1)
            WRMEM_8(url, un, 0)
            WRMEM_64(url, 4080, i)
            WRMEM_64(url, 4088, un)
            ReturnValue(url)
        }
        depth = 0
        bad2 = 0
        WhileLoop EqualTo(bad2, 0) {
            IfCondition GreaterEqual(i, len) ThenBlock: {
                bad2 = 2
            } ElseBlock: {
                c3 = RDMEM_8(data, i)
                stop = 0
                IfCondition EqualTo(c3, 32) ThenBlock: { stop = 1 }
                IfCondition EqualTo(c3, 9) ThenBlock: { stop = 1 }
                IfCondition EqualTo(c3, 10) ThenBlock: { stop = 1 }
                IfCondition LessThan(c3, 32) ThenBlock: { stop = 1 }
                IfCondition EqualTo(stop, 1) ThenBlock: {
                    bad2 = 2
                } ElseBlock: {
                    IfCondition EqualTo(c3, 40) ThenBlock: {
                        depth = Add(depth, 1)
                        WRMEM_8(url, un, c3)
                        un = Add(un, 1)
                        i = Add(i, 1)
                    } ElseBlock: {
                        IfCondition EqualTo(c3, 41) ThenBlock: {
                            IfCondition LessEqual(depth, 0) ThenBlock: {
                                bad2 = 2
                            } ElseBlock: {
                                depth = Subtract(depth, 1)
                                WRMEM_8(url, un, c3)
                                un = Add(un, 1)
                                i = Add(i, 1)
                            }
                        } ElseBlock: {
                            IfCondition EqualTo(c3, 92) ThenBlock: {
                                i = Add(i, 1)
                                IfCondition LessThan(i, len) ThenBlock: {
                                    c4 = RDMEM_8(data, i)
                                    pun2 = MD.Punct(c4)
                                    IfCondition EqualTo(pun2, 1) ThenBlock: {
                                        WRMEM_8(url, un, c4)
                                        un = Add(un, 1)
                                        i = Add(i, 1)
                                    } ElseBlock: {
                                        WRMEM_8(url, un, 92)
                                        un = Add(un, 1)
                                    }
                                } ElseBlock: {
                                    WRMEM_8(url, un, 92)
                                    un = Add(un, 1)
                                }
                            } ElseBlock: {
                                IfCondition EqualTo(c3, 38) ThenBlock: {
                                    ep2 = MD.BufEnt(data, len, i, url, un)
                                    IfCondition GreaterEqual(ep2, 0) ThenBlock: {
                                        un = RDMEM_64(url, 4088)
                                        i = ep2
                                    } ElseBlock: {
                                        WRMEM_8(url, un, c3)
                                        un = Add(un, 1)
                                        i = Add(i, 1)
                                    }
                                } ElseBlock: {
                                    WRMEM_8(url, un, c3)
                                    un = Add(un, 1)
                                    i = Add(i, 1)
                                }
                            }
                        }
                    }
                }
            }
        }
        IfCondition GreaterThan(depth, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(un, 0) ThenBlock: { ReturnValue(0) }
        WRMEM_8(url, un, 0)
        WRMEM_64(url, 4080, i)
        WRMEM_64(url, 4088, un)
        ReturnValue(url)
    }
}

Function.MD.ReadRefTitle {
    Input: data: Address
    Input: len: Integer
    Input: pos: Integer
    Output: Address
    Body: {
        IfCondition GreaterEqual(pos, len) ThenBlock: { ReturnValue(0) }
        b = RDMEM_8(data, pos)
        q = 0
        IfCondition EqualTo(b, 34) ThenBlock: { q = 34 }
        IfCondition EqualTo(b, 39) ThenBlock: { q = 39 }
        IfCondition EqualTo(b, 40) ThenBlock: { q = 41 }
        IfCondition EqualTo(q, 0) ThenBlock: { ReturnValue(0) }
        title = Allocate(4096)
        tn = 0
        i = Add(pos, 1)
        bad = 0
        WhileLoop EqualTo(bad, 0) {
            IfCondition GreaterEqual(i, len) ThenBlock: {
                bad = 1
            } ElseBlock: {
                c = RDMEM_8(data, i)
                IfCondition EqualTo(c, q) ThenBlock: {
                    bad = 2
                } ElseBlock: {
                    IfCondition EqualTo(c, 92) ThenBlock: {
                        i = Add(i, 1)
                        IfCondition LessThan(i, len) ThenBlock: {
                            c2 = RDMEM_8(data, i)
                            pun = MD.Punct(c2)
                            IfCondition EqualTo(pun, 1) ThenBlock: {
                                WRMEM_8(title, tn, c2)
                                tn = Add(tn, 1)
                                i = Add(i, 1)
                            } ElseBlock: {
                                WRMEM_8(title, tn, 92)
                                tn = Add(tn, 1)
                            }
                        } ElseBlock: {
                            bad = 1
                        }
                    } ElseBlock: {
                        IfCondition EqualTo(c, 38) ThenBlock: {
                            ep = MD.BufEnt(data, len, i, title, tn)
                            IfCondition GreaterEqual(ep, 0) ThenBlock: {
                                tn = RDMEM_64(title, 4088)
                                i = ep
                            } ElseBlock: {
                                WRMEM_8(title, tn, c)
                                tn = Add(tn, 1)
                                i = Add(i, 1)
                            }
                        } ElseBlock: {
                            WRMEM_8(title, tn, c)
                            tn = Add(tn, 1)
                            i = Add(i, 1)
                        }
                    }
                }
            }
        }
        IfCondition NotEqual(bad, 2) ThenBlock: { ReturnValue(0) }
        i = Add(i, 1)
        WRMEM_8(title, tn, 0)
        WRMEM_64(title, 4080, i)
        WRMEM_64(title, 4088, tn)
        ReturnValue(title)
    }
}

Function.MD.ParseRef {
    Input: data: Address
    Input: len: Integer
    Input: pos: Integer
    Output: Integer
    Body: {
        i = MD.SkipH(data, len, pos)
        IfCondition GreaterEqual(i, len) ThenBlock: { ReturnValue(pos) }
        b0 = RDMEM_8(data, i)
        IfCondition NotEqual(b0, 91) ThenBlock: { ReturnValue(pos) }
        end = MD.LabelEnd(data, len, i)
        IfCondition LessThan(end, 0) ThenBlock: { ReturnValue(pos) }
        lab = MD.NormSlice(data, Add(i, 1), end)
        IfCondition EqualTo(lab, 0) ThenBlock: { ReturnValue(pos) }
        llen = StringLength(lab)
        i = Add(end, 1)
        IfCondition GreaterEqual(i, len) ThenBlock: { ReturnValue(pos) }
        b2 = RDMEM_8(data, i)
        IfCondition NotEqual(b2, 58) ThenBlock: { ReturnValue(pos) }
        i = Add(i, 1)
        looping = 1
        WhileLoop EqualTo(looping, 1) {
            IfCondition GreaterEqual(i, len) ThenBlock: {
                looping = 0
            } ElseBlock: {
                b3 = RDMEM_8(data, i)
                ws = 0
                IfCondition EqualTo(b3, 32) ThenBlock: { ws = 1 }
                IfCondition EqualTo(b3, 9) ThenBlock: { ws = 1 }
                IfCondition EqualTo(b3, 10) ThenBlock: { ws = 1 }
                IfCondition EqualTo(ws, 1) ThenBlock: {
                    i = Add(i, 1)
                } ElseBlock: {
                    looping = 0
                }
            }
        }
        url = MD.ReadRefDest(data, len, i)
        IfCondition EqualTo(url, 0) ThenBlock: { ReturnValue(pos) }
        ulen = RDMEM_64(url, 4088)
        i = RDMEM_64(url, 4080)
        after = i
        i = MD.SkipH(data, len, i)
        title = Allocate(1)
        WRMEM_8(title, 0, 0)
        tn = 0
        took = 0
        IfCondition LessThan(i, len) ThenBlock: {
            b4 = RDMEM_8(data, i)
            mark = 0
            IfCondition EqualTo(b4, 34) ThenBlock: { mark = 1 }
            IfCondition EqualTo(b4, 39) ThenBlock: { mark = 1 }
            IfCondition EqualTo(b4, 40) ThenBlock: { mark = 1 }
            IfCondition EqualTo(b4, 10) ThenBlock: { mark = 2 }
            IfCondition EqualTo(mark, 2) ThenBlock: {
                j = MD.SkipH(data, len, Add(i, 1))
                IfCondition LessThan(j, len) ThenBlock: {
                    b5 = RDMEM_8(data, j)
                    IfCondition EqualTo(b5, 34) ThenBlock: { mark = 3 }
                    IfCondition EqualTo(b5, 39) ThenBlock: { mark = 3 }
                    IfCondition EqualTo(b5, 40) ThenBlock: { mark = 3 }
                    IfCondition EqualTo(mark, 3) ThenBlock: { i = j }
                }
            }
            IfCondition EqualTo(mark, 1) ThenBlock: {
                IfCondition GreaterThan(i, after) ThenBlock: { took = 1 }
            }
            IfCondition EqualTo(mark, 3) ThenBlock: { took = 1 }
        }
        ok = 0
        IfCondition EqualTo(took, 1) ThenBlock: {
            tbuf = MD.ReadRefTitle(data, len, i)
            IfCondition NotEqual(tbuf, 0) ThenBlock: {
                k = RDMEM_64(tbuf, 4080)
                k = MD.SkipH(data, len, k)
                fine = 0
                IfCondition GreaterEqual(k, len) ThenBlock: { fine = 1 }
                IfCondition LessThan(k, len) ThenBlock: {
                    bk = RDMEM_8(data, k)
                    IfCondition EqualTo(bk, 10) ThenBlock: { fine = 1 }
                }
                IfCondition EqualTo(fine, 1) ThenBlock: {
                    title = tbuf
                    tn = RDMEM_64(tbuf, 4088)
                    IfCondition LessThan(k, len) ThenBlock: { k = Add(k, 1) }
                    i = k
                    ok = 1
                }
            }
        }
        IfCondition EqualTo(ok, 0) ThenBlock: {
            i = MD.SkipH(data, len, after)
            fine2 = 0
            IfCondition GreaterEqual(i, len) ThenBlock: { fine2 = 1 }
            IfCondition LessThan(i, len) ThenBlock: {
                bz = RDMEM_8(data, i)
                IfCondition EqualTo(bz, 10) ThenBlock: { fine2 = 1 }
            }
            IfCondition EqualTo(fine2, 0) ThenBlock: { ReturnValue(pos) }
            IfCondition LessThan(i, len) ThenBlock: { i = Add(i, 1) }
            title = Allocate(1)
            WRMEM_8(title, 0, 0)
            tn = 0
        }
        MD.RefAdd(lab, llen, url, ulen, title, tn)
        ReturnValue(i)
    }
}
