// Line cursor for CommonMark block structure.
// Copyright (c) 2026 Sean Collins, 2 Paws Machine and Engineering. SCSL.

Function.MD.Peek {
    Output: Integer
    Body: {
        IfCondition GreaterThan(MC.pad, 0) ThenBlock: { ReturnValue(32) }
        line = Array.Get(MP.lines, MC.li)
        start = RDMEM_64(line)
        len = RDMEM_64(line, 8)
        IfCondition GreaterEqual(MC.off, len) ThenBlock: { ReturnValue(-1) }
        at = Add(start, MC.off)
        ReturnValue(RDMEM_8(MP.buf, at))
    }
}

Function.MD.Bump {
    Body: {
        IfCondition GreaterThan(MC.pad, 0) ThenBlock: {
            MC.pad = Subtract(MC.pad, 1)
            MC.col = Add(MC.col, 1)
            ReturnValue(0)
        }
        b = MD.Peek()
        IfCondition LessThan(b, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(b, 9) ThenBlock: {
            rem = Modulo(MC.col, 4)
            adv = Subtract(4, rem)
            MC.col = Add(MC.col, adv)
        } ElseBlock: {
            MC.col = Add(MC.col, 1)
        }
        MC.off = Add(MC.off, 1)
    }
}

Function.MD.Begin {
    Input: li: Integer
    Body: {
        MC.li = li
        MC.off = 0
        MC.col = 0
        MC.pad = 0
        MP.ate = 0
        blank = 1
        line = Array.Get(MP.lines, li)
        start = RDMEM_64(line)
        len = RDMEM_64(line, 8)
        i = 0
        WhileLoop LessThan(i, len) {
            b = RDMEM_8(MP.buf, Add(start, i))
            ws = 0
            IfCondition EqualTo(b, 32) ThenBlock: { ws = 1 }
            IfCondition EqualTo(b, 9) ThenBlock: { ws = 1 }
            IfCondition EqualTo(ws, 0) ThenBlock: {
                blank = 0
                i = len
            }
            i = Add(i, 1)
        }
        MP.lineblank = blank
    }
}

Function.MD.TakeCols {
    Input: want: Integer
    Output: Integer
    Body: {
        got = 0
        looping = 1
        WhileLoop EqualTo(looping, 1) {
            IfCondition GreaterEqual(got, want) ThenBlock: {
                looping = 0
            } ElseBlock: {
                b = MD.Peek()
                ws = 0
                IfCondition EqualTo(b, 32) ThenBlock: { ws = 1 }
                IfCondition EqualTo(b, 9) ThenBlock: { ws = 1 }
                IfCondition EqualTo(ws, 0) ThenBlock: {
                    looping = 0
                } ElseBlock: {
                    IfCondition EqualTo(b, 32) ThenBlock: {
                        MD.Bump()
                        got = Add(got, 1)
                    } ElseBlock: {
                        rem = Modulo(MC.col, 4)
                        adv = Subtract(4, rem)
                        need = Subtract(want, got)
                        IfCondition LessEqual(adv, need) ThenBlock: {
                            MD.Bump()
                            got = Add(got, adv)
                        } ElseBlock: {
                            MC.off = Add(MC.off, 1)
                            MC.pad = Subtract(adv, need)
                            MC.col = Add(MC.col, need)
                            got = want
                        }
                    }
                }
            }
        }
        ReturnValue(got)
    }
}

Function.MD.SkipWs {
    Body: {
        looping = 1
        WhileLoop EqualTo(looping, 1) {
            b = MD.Peek()
            ws = 0
            IfCondition EqualTo(b, 32) ThenBlock: { ws = 1 }
            IfCondition EqualTo(b, 9) ThenBlock: { ws = 1 }
            IfCondition EqualTo(ws, 1) ThenBlock: {
                MD.Bump()
            } ElseBlock: {
                looping = 0
            }
        }
    }
}

Function.MD.RestBlank {
    Output: Integer
    Body: {
        o = MC.off
        c = MC.col
        p = MC.pad
        MD.SkipWs()
        b = MD.Peek()
        MC.off = o
        MC.col = c
        MC.pad = p
        IfCondition LessThan(b, 0) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

Function.MD.AppendRest {
    Input: node: Address
    Input: nl: Integer
    Body: {
        WhileLoop GreaterThan(MC.pad, 0) {
            MD.AddByte(node, 32)
            MC.pad = Subtract(MC.pad, 1)
            MC.col = Add(MC.col, 1)
        }
        line = Array.Get(MP.lines, MC.li)
        start = RDMEM_64(line)
        len = RDMEM_64(line, 8)
        WhileLoop LessThan(MC.off, len) {
            b = RDMEM_8(MP.buf, Add(start, MC.off))
            MD.AddByte(node, b)
            MC.off = Add(MC.off, 1)
            MC.col = Add(MC.col, 1)
        }
        IfCondition EqualTo(nl, 1) ThenBlock: {
            MD.AddNl(node)
        }
    }
}

Function.MD.AppendPara {
    Input: node: Address
    Body: {
        MD.SkipWs()
        len = RDMEM_64(node, 32)
        IfCondition GreaterThan(len, 0) ThenBlock: {
            MD.AddNl(node)
        }
        MD.AppendRest(node, 0)
    }
}

Function.MD.NoteBlank {
    Body: {
        tip = MD.Tip()
        kids = RDMEM_64(tip, 16)
        IfCondition NotEqual(kids, 0) ThenBlock: {
            ks = Array.Size(kids)
            IfCondition GreaterThan(ks, 0) ThenBlock: {
                last = Array.Get(kids, Subtract(ks, 1))
                WRMEM_64(last, 8, 1)
            }
        }
        k = MD.Kind(tip)
        IfCondition NotEqual(k, 2) ThenBlock: {
            WRMEM_64(tip, 8, 1)
        }
        n = Array.Size(MP.open)
        i = 0
        lasti = Subtract(n, 1)
        WhileLoop LessThan(i, lasti) {
            node = Array.Get(MP.open, i)
            WRMEM_64(node, 8, 0)
            i = Add(i, 1)
        }
    }
}

Function.MD.StripCodeEnd {
    Input: node: Address
    Body: {
        data = RDMEM_64(node, 24)
        len = RDMEM_64(node, 32)
        looping = 1
        WhileLoop EqualTo(looping, 1) {
            IfCondition LessThan(len, 2) ThenBlock: {
                looping = 0
            } ElseBlock: {
                b1 = RDMEM_8(data, Subtract(len, 1))
                b2 = RDMEM_8(data, Subtract(len, 2))
                IfCondition EqualTo(b1, 10) ThenBlock: {
                    IfCondition EqualTo(b2, 10) ThenBlock: {
                        len = Subtract(len, 1)
                        WRMEM_8(data, len, 0)
                        WRMEM_64(node, 32, len)
                    } ElseBlock: {
                        looping = 0
                    }
                } ElseBlock: {
                    looping = 0
                }
            }
        }
    }
}
