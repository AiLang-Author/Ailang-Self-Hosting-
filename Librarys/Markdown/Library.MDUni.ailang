Function.MD.HexAt {
    Input: s: Address
    Input: off: Integer
    Output: Integer
    Body: {
        c = RDMEM_8(s, off)
        IfCondition GreaterEqual(c, 48) ThenBlock: {
            IfCondition LessEqual(c, 57) ThenBlock: {
                ReturnValue(Subtract(c, 48))
            }
        }
        ReturnValue(Subtract(c, 87))
    }
}

Function.MD.Hex6 {
    Input: s: Address
    Input: off: Integer
    Output: Integer
    Body: {
        v = 0
        k = 0
        WhileLoop LessThan(k, 6) {
            d = MD.HexAt(s, Add(off, k))
            v = Multiply(v, 16)
            v = Add(v, d)
            k = Add(k, 1)
        }
        ReturnValue(v)
    }
}

Function.MD.DecodeCp {
    Input: at: Integer
    Output: Integer
    Body: {
        IfCondition GreaterEqual(at, MI.tlen) ThenBlock: { ReturnValue(-1) }
        b0 = RDMEM_8(MI.txt, at)
        IfCondition LessThan(b0, 128) ThenBlock: { ReturnValue(b0) }
        n1 = Add(at, 1)
        IfCondition GreaterEqual(n1, MI.tlen) ThenBlock: { ReturnValue(b0) }
        b1 = RDMEM_8(MI.txt, n1)
        IfCondition LessThan(b0, 224) ThenBlock: {
            cp = Subtract(b0, 192)
            cp = Multiply(cp, 64)
            cp = Add(cp, Subtract(b1, 128))
            ReturnValue(cp)
        }
        n2 = Add(at, 2)
        IfCondition GreaterEqual(n2, MI.tlen) ThenBlock: { ReturnValue(b0) }
        b2 = RDMEM_8(MI.txt, n2)
        IfCondition LessThan(b0, 240) ThenBlock: {
            cp = Subtract(b0, 224)
            cp = Multiply(cp, 4096)
            t = Subtract(b1, 128)
            t = Multiply(t, 64)
            cp = Add(cp, t)
            cp = Add(cp, Subtract(b2, 128))
            ReturnValue(cp)
        }
        n3 = Add(at, 3)
        IfCondition GreaterEqual(n3, MI.tlen) ThenBlock: { ReturnValue(b0) }
        b3 = RDMEM_8(MI.txt, n3)
        cp = Subtract(b0, 240)
        cp = Multiply(cp, 262144)
        t = Subtract(b1, 128)
        t = Multiply(t, 4096)
        cp = Add(cp, t)
        t = Subtract(b2, 128)
        t = Multiply(t, 64)
        cp = Add(cp, t)
        cp = Add(cp, Subtract(b3, 128))
        ReturnValue(cp)
    }
}

Function.MD.PrevCp {
    Output: Integer
    Body: {
        IfCondition EqualTo(MI.pos, 0) ThenBlock: { ReturnValue(-1) }
        js = Allocate(8)
        WRMEM_64(js, Subtract(MI.pos, 1))
        step = 0
        WhileLoop LessThan(step, 3) {
            j = RDMEM_64(js)
            b = RDMEM_8(MI.txt, j)
            cont = 0
            IfCondition GreaterEqual(b, 128) ThenBlock: {
                IfCondition LessThan(b, 192) ThenBlock: { cont = 1 }
            }
            IfCondition EqualTo(cont, 1) ThenBlock: {
                IfCondition GreaterThan(j, 0) ThenBlock: {
                    WRMEM_64(js, Subtract(j, 1))
                }
            }
            step = Add(step, 1)
        }
        ReturnValue(MD.DecodeCp(RDMEM_64(js)))
    }
}

Function.MD.NextCp {
    Output: Integer
    Body: {
        IfCondition GreaterEqual(MI.pos, MI.tlen) ThenBlock: { ReturnValue(-1) }
        ReturnValue(MD.DecodeCp(MI.pos))
    }
}

Function.MD.CpWs {
    Input: cp: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(cp, 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(cp, 9) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(cp, 10) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(cp, 12) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(cp, 13) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(cp, 32) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(cp, 160) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(cp, 5760) ThenBlock: { ReturnValue(1) }
        IfCondition GreaterEqual(cp, 8192) ThenBlock: {
            IfCondition LessEqual(cp, 8202) ThenBlock: { ReturnValue(1) }
        }
        IfCondition EqualTo(cp, 8232) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(cp, 8233) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(cp, 8239) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(cp, 8287) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(cp, 12288) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

Function.MD.CpPunct {
    Input: cp: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(cp, 0) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(cp, 128) ThenBlock: { ReturnValue(MD.Punct(cp)) }
        tab = ""
        slot = Allocate(16)
        WRMEM_64(slot, 0)
        WRMEM_64(slot, 8, 334)
        lo = RDMEM_64(slot)
        hi = RDMEM_64(slot, 8)
        WhileLoop LessThan(lo, hi) {
            mid = Divide(Add(lo, hi), 2)
            off = Multiply(mid, 12)
            a = MD.Hex6(tab, off)
            bend = MD.Hex6(tab, Add(off, 6))
            IfCondition LessThan(cp, a) ThenBlock: {
                WRMEM_64(slot, 8, mid)
            } ElseBlock: {
                IfCondition GreaterThan(cp, bend) ThenBlock: {
                    WRMEM_64(slot, Add(mid, 1))
                } ElseBlock: {
                    ReturnValue(1)
                }
            }
            lo = RDMEM_64(slot)
            hi = RDMEM_64(slot, 8)
        }
        ReturnValue(0)
    }
}
