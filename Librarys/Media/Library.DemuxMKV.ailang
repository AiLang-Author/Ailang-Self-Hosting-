// Library.DemuxMKV.ailang
// Standalone MKV/WebM demuxer process (EBML/Matroska container).
//
// Reads an MKV or WebM file, parses the EBML header and Matroska elements,
// extracts video and audio tracks, and writes compressed packets to
// separate PacketRings.
//
// Supports: VP8, VP9, AV1, H.264, H.265 video; Opus, Vorbis, AAC, MP3 audio.
//
// EBML format:
//   Variable-length element IDs (1-4 bytes, leading-zero count → width)
//   Variable-length sizes (1-8 bytes, VINT)
//   Matroska element hierarchy:
//     EBML Header → Segment → Info, Tracks, Clusters
//     Cluster → Timecode + SimpleBlock/BlockGroup
//
// Usage:
//   ./demux_mkv.x --file video.mkv --vring vid_ring --aring aud_ring --clock clk0
//
// Build: ./ailang.x Librarys/Media/Library.DemuxMKV.ailang demux_mkv.x
//
// Orthogonal: speaks only PacketRing + PlaybackClock.
//
// Copyright 2026 Sean Collins, 2 Paws Machine and Engineering. SCSL.

LibraryImport.Arena
LibraryImport.PacketRing
LibraryImport.PlaybackClock
LibraryImport.UtilArgs

// =============================================================================
// SYSCALL CONSTANTS
// =============================================================================
FixedPool.MKSys {
    "SYS_READ":      Initialize=0
    "SYS_WRITE":     Initialize=1
    "SYS_OPEN":      Initialize=2
    "SYS_CLOSE":     Initialize=3
    "SYS_LSEEK":     Initialize=8
    "SYS_EXIT":      Initialize=60
    "SYS_NANOSLEEP": Initialize=35
    "SYS_OPENAT":    Initialize=257
    "O_RDONLY":      Initialize=0
    "AT_FDCWD":      Initialize=-100
    "SEEK_SET":      Initialize=0
    "SEEK_CUR":      Initialize=1
    "SEEK_END":      Initialize=2
    "STDOUT":        Initialize=1
    "STDERR":        Initialize=2
}

// =============================================================================
// EBML/MATROSKA ELEMENT IDs
// =============================================================================
FixedPool.EBML {
    // EBML Header
    "EBML_HEADER":          Initialize=0x1A45DFA3
    "EBML_VERSION":         Initialize=0x4286
    "EBML_READ_VERSION":    Initialize=0x42F7
    "EBML_MAX_ID_LEN":      Initialize=0x42F2
    "EBML_MAX_SIZE_LEN":    Initialize=0x42F3
    "EBML_DOCTYPE":         Initialize=0x4282
    "EBML_DOCTYPE_VER":     Initialize=0x4287
    "EBML_DOCTYPE_READ_VER": Initialize=0x4285

    // Segment
    "SEGMENT":              Initialize=0x18538067

    // Segment Info
    "INFO":                 Initialize=0x1549A966
    "TIMECODE_SCALE":       Initialize=0x2AD7B1
    "DURATION":             Initialize=0x4489
    "MUXING_APP":           Initialize=0x4D80
    "WRITING_APP":          Initialize=0x5741

    // Tracks
    "TRACKS":               Initialize=0x1654AE6B
    "TRACK_ENTRY":          Initialize=0xAE
    "TRACK_NUMBER":         Initialize=0xD7
    "TRACK_UID":            Initialize=0x73C5
    "TRACK_TYPE":           Initialize=0x83
    "CODEC_ID":             Initialize=0x86
    "CODEC_PRIVATE":        Initialize=0x63A2
    "DEFAULT_DURATION":     Initialize=0x23E383

    // Video
    "VIDEO":                Initialize=0xE0
    "PIXEL_WIDTH":          Initialize=0xB0
    "PIXEL_HEIGHT":         Initialize=0xBA

    // Audio
    "AUDIO":                Initialize=0xE1
    "SAMPLING_FREQ":        Initialize=0xB5
    "CHANNELS":             Initialize=0x9F
    "BIT_DEPTH":            Initialize=0x6264

    // Cluster
    "CLUSTER":              Initialize=0x1F43B675
    "CLUSTER_TIMECODE":     Initialize=0xE7
    "SIMPLE_BLOCK":         Initialize=0xA3
    "BLOCK_GROUP":          Initialize=0xA0
    "BLOCK":                Initialize=0xA1
    "BLOCK_DURATION":       Initialize=0x9B
    "REFERENCE_BLOCK":      Initialize=0xFB

    // Seek / Cues (for seeking)
    "SEEK_HEAD":            Initialize=0x114D9B74
    "CUES":                 Initialize=0x1C53BB6B
    "CUE_POINT":            Initialize=0xBB
    "CUE_TIME":             Initialize=0xB3
    "CUE_TRACK_POS":        Initialize=0xB7
    "CUE_TRACK":            Initialize=0xF7
    "CUE_CLUSTER_POS":      Initialize=0xF1
}

// Track types
FixedPool.MKTrackType {
    "VIDEO":  Initialize=1
    "AUDIO":  Initialize=2
}

// =============================================================================
// CONSTANTS
// =============================================================================
FixedPool.MKConst {
    "READ_BUF_SIZE":    Initialize=65536
    "MAX_CODEC_PRIV":   Initialize=65536
    "MAX_FRAME_SIZE":   Initialize=4194304
    "RING_CAPACITY":    Initialize=4194304
    "MAX_TRACKS":       Initialize=8
    "MAX_CUES":         Initialize=4096

    // Track struct layout (per track, 128 bytes)
    "TRK_NUMBER":       Initialize=0
    "TRK_TYPE":         Initialize=8
    "TRK_CODEC_ID_PTR": Initialize=16
    "TRK_CODEC_ID_LEN": Initialize=24
    "TRK_CODEC_PRIV_PTR": Initialize=32
    "TRK_CODEC_PRIV_LEN": Initialize=40
    "TRK_DEF_DURATION": Initialize=48
    "TRK_WIDTH":        Initialize=56
    "TRK_HEIGHT":       Initialize=64
    "TRK_SAMPLE_RATE":  Initialize=72
