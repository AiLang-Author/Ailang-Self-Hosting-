// Library.DemuxMP3.ailang
// Standalone MP3 frame demuxer process.
//
// Reads an MP3 file, skips ID3 tags, extracts MPEG audio frames, and
// writes them to an audio PacketRing. No video output.
//
// MP3 is a raw frame stream with no proper container — each frame has
// a 4-byte sync header (0xFFE0 mask) that encodes bitrate, sample rate,
// channel mode, padding. Frames are simply concatenated.
//
// Usage:
//   ./demux_mp3.x --file song.mp3 --ring audio_ring --clock clk0
//
// Build: ./ailang.x Librarys/Media/Library.DemuxMP3.ailang demux_mp3.x
//
// Orthogonal: speaks only PacketRing + PlaybackClock.
//
// Copyright 2026 Sean Collins, 2 Paws Machine and Engineering. SCSL.

LibraryImport.Arena
LibraryImport.PacketRing
LibraryImport.PlaybackClock
LibraryImport.UtilArgs

// =============================================================================
// SYSCALL CONSTANTS
// =============================================================================
FixedPool.M3Sys {
    "SYS_READ":      Initialize=0
    "SYS_OPEN":      Initialize=2
    "SYS_CLOSE":     Initialize=3
    "SYS_LSEEK":     Initialize=8
    "SYS_EXIT":      Initialize=60
    "SYS_NANOSLEEP": Initialize=35
    "SYS_OPENAT":    Initialize=257
    "O_RDONLY":      Initialize=0
    "AT_FDCWD":      Initialize=-100
    "SEEK_SET":      Initialize=0
    "SEEK_CUR":      Initialize=1
}

FixedPool.M3Const {
    "READ_BUF_SIZE":   Initialize=65536
    "RING_CAPACITY":   Initialize=4194304
    "MAX_FRAME_SIZE":  Initialize=4608
}

// =============================================================================
// MP3 FRAME HEADER TABLES
// =============================================================================
// MPEG1 Layer3 bitrate table (index 0-14, kbps * 1000)
// Index 0 = free, 15 = bad
// Bitrates: 0, 32, 40, 48, 56, 64, 80, 96, 112, 128, 160, 192, 224, 256, 320
FixedPool.M3Bitrate {
    "B0":  Initialize=0
    "B1":  Initialize=32000
    "B2":  Initialize=40000
    "B3":  Initialize=48000
    "B4":  Initialize=56000
    "B5":  Initialize=64000
    "B6":  Initialize=80000
    "B7":  Initialize=96000
    "B8":  Initialize=112000
    "B9":  Initialize=128000
    "B10": Initialize=160000
    "B11": Initialize=192000
    "B12": Initialize=224000
    "B13": Initialize=256000
    "B14": Initialize=320000
}

// Sample rate table for MPEG1
// Index 0=44100, 1=48000, 2=32000, 3=reserved
FixedPool.M3SRate {
    "S0": Initialize=44100
    "S1": Initialize=48000
    "S2": Initialize=32000
    "S3": Initialize=0
}

// =============================================================================
// ARGUMENT SCHEMA
// =============================================================================
Function.M3_BuildSchema {
    Output: Address
    Body: {
        s = UtilArgs_NewSchema("demux_mp3", "MP3 frame demuxer — extract MPEG frames to PacketRing")
        UtilArgs_AddField(s, "file",  "path",   1, "MP3 file path",        "file")
        UtilArgs_AddField(s, "ring",  "string", 1, "Audio PacketRing name","ring")
        UtilArgs_AddField(s, "clock", "string", 1, "PlaybackClock name",   "clock")
        UtilArgs_SetShort(s, "file",  "f")
        UtilArgs_SetShort(s, "ring",  "r")
        UtilArgs_SetShort(s, "clock", "c")
        ReturnValue(s)
    }
}

// =============================================================================
// BITRATE LOOKUP
// =============================================================================
Function.M3_GetBitrate {
    Input: idx: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(idx, 0)  ThenBlock: { ReturnValue(M3Bitrate.B0) }
        IfCondition EqualTo(idx, 1)  ThenBlock: { ReturnValue(M3Bitrate.B1) }
        IfCondition EqualTo(idx, 2)  ThenBlock: { ReturnValue(M3Bitrate.B2) }
        IfCondition EqualTo(idx, 3)  ThenBlock: { ReturnValue(M3Bitrate.B3) }
        IfCondition EqualTo(idx, 4)  ThenBlock: { ReturnValue(M3Bitrate.B4) }
        IfCondition EqualTo(idx, 5)  ThenBlock: { ReturnValue(M3Bitrate.B5) }
        IfCondition EqualTo(idx, 6)  ThenBlock: { ReturnValue(M3Bitrate.B6) }
        IfCondition EqualTo(idx, 7)  ThenBlock: { ReturnValue(M3Bitrate.B7) }
        IfCondition EqualTo(idx, 8)  ThenBlock: { ReturnValue(M3Bitrate.B8) }
        IfCondition EqualTo(idx, 9)  ThenBlock: { ReturnValue(M3Bitrate.B9) }
        IfCondition EqualTo(idx, 10) ThenBlock: { ReturnValue(M3Bitrate.B10) }
        IfCondition EqualTo(idx, 11) ThenBlock: { ReturnValue(M3Bitrate.B11) }
        IfCondition EqualTo(idx, 12) ThenBlock: { ReturnValue(M3Bitrate.B12) }
        IfCondition EqualTo(idx, 13) ThenBlock: { ReturnValue(M3Bitrate.B13) }
        IfCondition EqualTo(idx, 14) ThenBlock: { ReturnValue(M3Bitrate.B14) }
        ReturnValue(0)
    }
}

Function.M3_GetSampleRate {
    Input: idx: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(idx, 0) ThenBlock: { ReturnValue(M3SRate.S0) }
        IfCondition EqualTo(idx, 1) ThenBlock: { ReturnValue(M3SRate.S1) }
        IfCondition EqualTo(idx, 2) ThenBlock: { ReturnValue(M3SRate.S2) }
        ReturnValue(0)
    }
}

// =============================================================================
// MAIN
// =============================================================================
SubRoutine.Main {
    PrintMessage("[DemuxMP3] starting\n")

    // Parse args via UtilArgs schema
    schema = M3_BuildSchema()
    args = UtilArgs_ParseCLI(schema)
    IfCondition EqualTo(args, 0) ThenBlock: {
        PrintMessage("[DemuxMP3] argument error\n")
        SystemCall(M3Sys.SYS_EXIT, 1)
    }

    filepath   = UtilArgs_GetString(args, "file")
    ring_name  = UtilArgs_GetString(args, "ring")
    clock_name = UtilArgs_GetString(args, "clock")

    PrintMessage("[DemuxMP3] file: ")
    PrintString(filepath)
    PrintMessage("\n[DemuxMP3] ring: ")
    PrintString(ring_name)
    PrintMessage("\n[DemuxMP3] clock: ")
    PrintString(clock_name)
    PrintMessage("\n")

    // Open file
    mp3_fd = SystemCall(M3Sys.SYS_OPEN, filepath, M3Sys.O_RDONLY, 0)
    IfCondition LessThan(mp3_fd, 0) ThenBlock: {
        PrintMessage("[DemuxMP3] cannot open file\n")
        SystemCall(M3Sys.SYS_EXIT, 1)
    }

    // Check for ID3v2 tag and skip it
    hdr = Allocate(10)
    SystemCall(M3Sys.SYS_READ, mp3_fd, hdr, 10, 0, 0, 0)
    id3_skip = 0

    // ID3v2 header: "ID3" + 2 version bytes + 1 flags + 4 syncsafe size bytes
    IfCondition And(And(EqualTo(GetByte(hdr, 0), 73), EqualTo(GetByte(hdr, 1), 68)), EqualTo(GetByte(hdr, 2), 51)) ThenBlock: {
        // Syncsafe integer: 4 bytes, 7 bits each
        sz3 = GetByte(hdr, 6)
        sz2 = GetByte(hdr, 7)
        sz1 = GetByte(hdr, 8)
        sz0 = GetByte(hdr, 9)
        id3_size = BitwiseOr(BitwiseOr(ShiftLeft(sz3, 21), ShiftLeft(sz2, 14)), BitwiseOr(ShiftLeft(sz1, 7), sz0))
        id3_skip = Add(10, id3_size)
        PrintMessage("[DemuxMP3] ID3v2 tag: ")
        PrintNumber(id3_size)
        PrintMessage(" bytes, skipping\n")
        SystemCall(M3Sys.SYS_LSEEK, mp3_fd, id3_skip, M3Sys.SEEK_SET, 0, 0, 0)
    }
    IfCondition Not(And(And(EqualTo(GetByte(hdr, 0), 73), EqualTo(GetByte(hdr, 1), 68)), EqualTo(GetByte(hdr, 2), 51))) ThenBlock: {
        // No ID3 tag, seek back to start
        SystemCall(M3Sys.SYS_LSEEK, mp3_fd, 0, M3Sys.SEEK_SET, 0, 0, 0)
    }
    Deallocate(hdr, 10)

    // Create PacketRing
    ring = PacketRing_Create(ring_name, M3Const.RING_CAPACITY)
    IfCondition EqualTo(ring, 0) ThenBlock: {
        PrintMessage("[DemuxMP3] failed to create ring\n")
        SystemCall(M3Sys.SYS_EXIT, 1)
    }

    // Open clock
    clock = PlaybackClock_Open(clock_name)
    IfCondition EqualTo(clock, 0) ThenBlock: {
        PrintMessage("[DemuxMP3] failed to open clock\n")
        SystemCall(M3Sys.SYS_EXIT, 1)
    }

    // Read buffer
    read_buf = Allocate(M3Const.READ_BUF_SIZE)
    frame_buf = Allocate(M3Const.MAX_FRAME_SIZE)
    ts_wait = Allocate(16)
    StoreValue(ts_wait, 0)
    StoreValue(Add(ts_wait, 8), 1000000)

    // State
    total_frames = 0
    total_samples = 0
    sample_rate = 44100
    file_offset = id3_skip

    // Main loop: read buffer, find sync words, extract frames
    running = 1
    buf_pos = 0
    buf_len = 0

    WhileLoop EqualTo(running, 1) {
        // Check clock
        state = PlaybackClock_GetState(clock)
        IfCondition EqualTo(state, PCState.STOPPED) ThenBlock: {
            running = 0
        }
        IfCondition EqualTo(state, PCState.PAUSED) ThenBlock: {
            SystemCall(M3Sys.SYS_NANOSLEEP, ts_wait, 0)
        }
        IfCondition EqualTo(state, PCState.SEEKING) ThenBlock: {
            // MP3 seeking is imprecise — estimate byte offset
            target_usec = PlaybackClock_GetSeekTarget(clock)
            // Approximate: target_bytes ≈ (target_usec / 1000000) * avg_bitrate / 8
            // For simplicity, estimate from current file position and frame count
            // This is rough but serviceable without a seek table
            IfCondition GreaterThan(total_frames, 0) ThenBlock: {
                avg_bytes_per_frame = Divide(Subtract(file_offset, id3_skip), total_frames)
                target_frame = Divide(Multiply(target_usec, sample_rate), Multiply(1152, 1000000))
                target_offset = Add(id3_skip, Multiply(target_frame, avg_bytes_per_frame))
                SystemCall(M3Sys.SYS_LSEEK, mp3_fd, target_offset, M3Sys.SEEK_SET, 0, 0, 0)
                file_offset = target_offset
                total_samples = Multiply(target_frame, 1152)
                buf_pos = 0
                buf_len = 0
                PacketRing_Reset(ring)
            }
            PlaybackClock_SeekDone(clock)
        }

        IfCondition EqualTo(running, 1) ThenBlock: {
            // Refill buffer if needed
            IfCondition EqualTo(buf_pos, buf_len) ThenBlock: {
                n = SystemCall(M3Sys.SYS_READ, mp3_fd, read_buf, M3Const.READ_BUF_SIZE, 0, 0, 0)
                IfCondition LessEqual(n, 0) ThenBlock: {
                    running = 0
                }
                IfCondition GreaterThan(n, 0) ThenBlock: {
                    buf_pos = 0
                    buf_len = n
                }
            }

            // Find frame sync: 0xFF followed by 0xE0 mask
            IfCondition EqualTo(running, 1) ThenBlock: {
                found_sync = 0
                WhileLoop And(LessThan(buf_pos, Subtract(buf_len, 4)), EqualTo(found_sync, 0)) {
                    b0 = GetByte(read_buf, buf_pos)
                    b1 = GetByte(read_buf, Add(buf_pos, 1))
                    IfCondition And(EqualTo(b0, 255), EqualTo(BitwiseAnd(b1, 224), 224)) ThenBlock: {
                        found_sync = 1
                    }
                    IfCondition EqualTo(found_sync, 0) ThenBlock: {
                        buf_pos = Add(buf_pos, 1)
                        file_offset = Add(file_offset, 1)
                    }
                }

                IfCondition EqualTo(found_sync, 1) ThenBlock: {
                    // Parse frame header (4 bytes)
                    h0 = GetByte(read_buf, buf_pos)
                    h1 = GetByte(read_buf, Add(buf_pos, 1))
                    h2 = GetByte(read_buf, Add(buf_pos, 2))
                    h3 = GetByte(read_buf, Add(buf_pos, 3))

                    // Bitrate index: bits 15-12 of header (h2 bits 7-4)
                    br_idx = ShiftRight(BitwiseAnd(h2, 240), 4)
                    // Sample rate index: bits 11-10 (h2 bits 3-2)
                    sr_idx = ShiftRight(BitwiseAnd(h2, 12), 2)
                    // Padding: bit 9 (h2 bit 1)
                    padding = ShiftRight(BitwiseAnd(h2, 2), 1)

                    bitrate = M3_GetBitrate(br_idx)
                    srate = M3_GetSampleRate(sr_idx)

                    IfCondition Or(EqualTo(bitrate, 0), EqualTo(srate, 0)) ThenBlock: {
                        // Invalid frame, skip byte
                        buf_pos = Add(buf_pos, 1)
                        file_offset = Add(file_offset, 1)
                    }
                    IfCondition And(NotEqual(bitrate, 0), NotEqual(srate, 0)) ThenBlock: {
                        sample_rate = srate

                        // Frame size = 144 * bitrate / sample_rate + padding
                        frame_size = Add(Divide(Multiply(144, bitrate), srate), padding)

                        // Check if full frame is in buffer
                        remaining = Subtract(buf_len, buf_pos)
                        IfCondition GreaterThan(frame_size, remaining) ThenBlock: {
                            // Move remaining to front of buffer, refill
                            IfCondition GreaterThan(remaining, 0) ThenBlock: {
                                MemoryCopy(frame_buf, Add(read_buf, buf_pos), remaining)
                                // Read more
                                n = SystemCall(M3Sys.SYS_READ, mp3_fd, Add(frame_buf, remaining), Subtract(frame_size, remaining), 0, 0, 0)
                                IfCondition LessThan(n, Subtract(frame_size, remaining)) ThenBlock: {
                                    running = 0
                                }
                            }
                            buf_pos = buf_len
                            file_offset = Add(file_offset, frame_size)
                        }
                        IfCondition LessEqual(frame_size, remaining) ThenBlock: {
                            MemoryCopy(frame_buf, Add(read_buf, buf_pos), frame_size)
                            buf_pos = Add(buf_pos, frame_size)
                            file_offset = Add(file_offset, frame_size)
                        }

                        IfCondition EqualTo(running, 1) ThenBlock: {
                            // Compute PTS: (total_samples / sample_rate) * 1000000 usec
                            pts_usec = Divide(Multiply(total_samples, 1000000), srate)

                            // Write frame to ring
                            wrote = PacketRing_Write(ring, frame_buf, frame_size, pts_usec, PRPktFlag.NONE)
                            WhileLoop EqualTo(wrote, 0) {
                                s = PlaybackClock_GetState(clock)
                                IfCondition EqualTo(s, PCState.STOPPED) ThenBlock: {
                                    running = 0
                                    wrote = 1
                                }
                                IfCondition EqualTo(wrote, 0) ThenBlock: {
                                    SystemCall(M3Sys.SYS_NANOSLEEP, ts_wait, 0)
                                    wrote = PacketRing_Write(ring, frame_buf, frame_size, pts_usec, PRPktFlag.NONE)
                                }
                            }

                            // MPEG1 Layer3: 1152 samples per frame
                            total_samples = Add(total_samples, 1152)
                            total_frames = Add(total_frames, 1)

                            IfCondition EqualTo(Modulo(total_frames, 1000), 0) ThenBlock: {
                                PrintMessage("[DemuxMP3] ")
                                PrintNumber(total_frames)
                                PrintMessage(" frames, ")
                                PrintNumber(Divide(pts_usec, 1000000))
                                PrintMessage("s\n")
                            }
                        }
                    }
                }
                IfCondition EqualTo(found_sync, 0) ThenBlock: {
                    // No sync found in remaining buffer, refill
                    buf_pos = buf_len
                }
            }
        }
    }

    // Signal EOF
    PacketRing_SignalEOF(ring)
    PrintMessage("[DemuxMP3] finished, ")
    PrintNumber(total_frames)
    PrintMessage(" frames\n")

    // Cleanup
    Deallocate(read_buf, M3Const.READ_BUF_SIZE)
    Deallocate(frame_buf, M3Const.MAX_FRAME_SIZE)
    Deallocate(ts_wait, 16)
    SystemCall(M3Sys.SYS_CLOSE, mp3_fd, 0, 0, 0, 0, 0)
    PlaybackClock_Close(clock)

    SystemCall(M3Sys.SYS_EXIT, 0)
}

RunTask(Main)
