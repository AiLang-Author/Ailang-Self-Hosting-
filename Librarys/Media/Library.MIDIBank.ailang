Function.MIDI_Bank_Init {
    Body: {
        IfCondition EqualTo(BankState.ok, 1) ThenBlock: { ReturnValue(0) }
        BankState.keys = 0
        BankState.names = 0
        BankState.maps = 0
        BankState.n = 0
        BankState.cap = 0
        BankState.scratch = Allocate(64)
        MemorySet(BankState.scratch, 0, 64)
        MIDI_Bank_LoadGS0()
        MIDI_Bank_LoadGS1()
        MIDI_Bank_LoadGS2()
        MIDI_Bank_LoadGS3()
        MIDI_Bank_LoadGS4()
        MIDI_Bank_LoadXG0()
        MIDI_Bank_LoadXG1()
        MIDI_Bank_LoadXG2()
        MIDI_Bank_LoadXG3()
        BankState.ok = 1
        MIDI_GM_Init()
    }
}

Function.MIDI_Bank_GSName {
    Input: cc00: Integer
    Input: program: Integer
    Output: Address
    Body: {
        IfCondition EqualTo(cc00, 0) ThenBlock: {
            p = MIDI_GM_ProgramName(program)
            ReturnValue(p)
        }
        p = MIDI_Bank_Find(0, cc00, program, 1)
        IfCondition NotEqual(p, 0) ThenBlock: { ReturnValue(p) }
        p = MIDI_GM_ProgramName(program)
        ReturnValue(p)
    }
}

Function.MIDI_Bank_XGName {
    Input: msb: Integer
    Input: lsb: Integer
    Input: program: Integer
    Output: Address
    Body: {
        eq0 = EqualTo(msb, 0)
        eq1 = EqualTo(lsb, 0)
        IfCondition And(eq0, eq1) ThenBlock: {
            p = MIDI_GM_ProgramName(program)
            ReturnValue(p)
        }
        p = MIDI_Bank_Find(msb, lsb, program, 2)
        IfCondition NotEqual(p, 0) ThenBlock: { ReturnValue(p) }
        p = MIDI_GM_ProgramName(program)
        ReturnValue(p)
    }
}

Function.MIDI_Bank_GSKitName {
    Input: program: Integer
    Output: Address
    Body: {
        IfCondition EqualTo(program, 0) ThenBlock: { ReturnValue("STANDARD") }
        IfCondition EqualTo(program, 8) ThenBlock: { ReturnValue("ROOM") }
        IfCondition EqualTo(program, 16) ThenBlock: { ReturnValue("POWER") }
        IfCondition EqualTo(program, 24) ThenBlock: { ReturnValue("ELECTRONIC") }
        IfCondition EqualTo(program, 25) ThenBlock: { ReturnValue("TR-808") }
        IfCondition EqualTo(program, 26) ThenBlock: { ReturnValue("DANCE") }
        IfCondition EqualTo(program, 32) ThenBlock: { ReturnValue("JAZZ") }
        IfCondition EqualTo(program, 40) ThenBlock: { ReturnValue("BRUSH") }
        IfCondition EqualTo(program, 48) ThenBlock: { ReturnValue("ORCHESTRA") }
        IfCondition EqualTo(program, 49) ThenBlock: { ReturnValue("ETHNIC") }
        IfCondition EqualTo(program, 50) ThenBlock: { ReturnValue("KICK & SNARE") }
        IfCondition EqualTo(program, 56) ThenBlock: { ReturnValue("SFX") }
        IfCondition EqualTo(program, 57) ThenBlock: { ReturnValue("RHYTHM FX") }
        IfCondition EqualTo(program, 127) ThenBlock: { ReturnValue("CM-64/32L") }
        ReturnValue("STANDARD")
    }
}

Function.MIDI_Bank_XGKitName {
    Input: msb: Integer
    Input: program: Integer
    Output: Address
    Body: {
        IfCondition EqualTo(msb, 127) ThenBlock: {
            IfCondition EqualTo(program, 0) ThenBlock: { ReturnValue("Standard Kit") }
        }
        IfCondition EqualTo(msb, 127) ThenBlock: {
            IfCondition EqualTo(program, 1) ThenBlock: { ReturnValue("Standard Kit 2") }
        }
        IfCondition EqualTo(msb, 127) ThenBlock: {
            IfCondition EqualTo(program, 8) ThenBlock: { ReturnValue("Room Kit") }
        }
        IfCondition EqualTo(msb, 127) ThenBlock: {
            IfCondition EqualTo(program, 16) ThenBlock: { ReturnValue("Rock Kit") }
        }
        IfCondition EqualTo(msb, 127) ThenBlock: {
            IfCondition EqualTo(program, 24) ThenBlock: { ReturnValue("Electro Kit") }
        }
        IfCondition EqualTo(msb, 127) ThenBlock: {
            IfCondition EqualTo(program, 25) ThenBlock: { ReturnValue("Analog Kit") }
        }
        IfCondition EqualTo(msb, 127) ThenBlock: {
            IfCondition EqualTo(program, 27) ThenBlock: { ReturnValue("Dance Kit") }
        }
        IfCondition EqualTo(msb, 127) ThenBlock: {
            IfCondition EqualTo(program, 32) ThenBlock: { ReturnValue("Jazz Kit") }
        }
        IfCondition EqualTo(msb, 127) ThenBlock: {
            IfCondition EqualTo(program, 40) ThenBlock: { ReturnValue("Brush Kit") }
        }
        IfCondition EqualTo(msb, 127) ThenBlock: {
            IfCondition EqualTo(program, 48) ThenBlock: { ReturnValue("Symphony Kit") }
        }
        IfCondition EqualTo(msb, 126) ThenBlock: {
            IfCondition EqualTo(program, 0) ThenBlock: { ReturnValue("SFX Kit 1") }
        }
        IfCondition EqualTo(msb, 126) ThenBlock: {
            IfCondition EqualTo(program, 1) ThenBlock: { ReturnValue("SFX Kit 2") }
        }
        ReturnValue("Standard Kit")
    }
}

Function.MIDI_Bank_PatchName {
    Input: msb: Integer
    Input: lsb: Integer
    Input: program: Integer
    Output: Address
    Body: {
        IfCondition EqualTo(BankState.ok, 0) ThenBlock: { MIDI_Bank_Init() }
        IfCondition EqualTo(msb, 64) ThenBlock: {
            p = MIDI_Bank_Find(64, lsb, program, 2)
            IfCondition NotEqual(p, 0) ThenBlock: { ReturnValue(p) }
        }
        IfCondition EqualTo(msb, 126) ThenBlock: {
            p = MIDI_Bank_XGKitName(msb, program)
            ReturnValue(p)
        }
        IfCondition EqualTo(msb, 127) ThenBlock: {
            p = MIDI_Bank_XGKitName(msb, program)
            ReturnValue(p)
        }
        IfCondition EqualTo(msb, 0) ThenBlock: {
            IfCondition NotEqual(lsb, 0) ThenBlock: {
                p = MIDI_Bank_XGName(0, lsb, program)
                ReturnValue(p)
            }
            p = MIDI_GM_ProgramName(program)
            ReturnValue(p)
        }
        p = MIDI_Bank_GSName(msb, program)
        ReturnValue(p)
    }
}

