// Library.MIDIBank.ailang
// Roland GS (SC-88 Pro native) and Yamaha XG bank name tables.
// Lookup is (msb, lsb, program) → name. GM capitals live in Library.MIDIGM.
//
// GS: CC0 = variation, CC32 = 0, program = capital.
// XG: CC0 = 0 melody / 64 SFX / 126 SFX kit / 127 rhythm; CC32 = variation.
//
// Copyright 2026 Sean Collins, 2 Paws Machine and Engineering. SCSL.

LibraryImport.Media.MIDIGM

FixedPool.BankMap {
    "GM": Initialize=0
    "GS": Initialize=1
    "XG": Initialize=2
}

FixedPool.BankState {
    "keys": Initialize=0, CanChange=True
    "names": Initialize=0, CanChange=True
    "maps": Initialize=0, CanChange=True
    "n": Initialize=0, CanChange=True
    "cap": Initialize=0, CanChange=True
    "ok": Initialize=0, CanChange=True
    "scratch": Initialize=0, CanChange=True
}

Function.MIDI_Bank_Grow {
    Body: {
        IfCondition LessThan(BankState.n, BankState.cap) ThenBlock: { ReturnValue(1) }
        ncap = BankState.cap
        IfCondition LessThan(ncap, 64) ThenBlock: { ncap = 64 }
        ncap = Multiply(ncap, 2)
        nk = Allocate(Multiply(ncap, 8))
        nn = Allocate(Multiply(ncap, 8))
        nm = Allocate(ncap)
        MemorySet(nk, 0, Multiply(ncap, 8))
        MemorySet(nn, 0, Multiply(ncap, 8))
        MemorySet(nm, 0, ncap)
        IfCondition GreaterThan(BankState.n, 0) ThenBlock: {
            MemoryCopy(nk, BankState.keys, Multiply(BankState.n, 8))
            MemoryCopy(nn, BankState.names, Multiply(BankState.n, 8))
            MemoryCopy(nm, BankState.maps, BankState.n)
        }
        IfCondition NotEqual(BankState.keys, 0) ThenBlock: {
            Deallocate(BankState.keys, Multiply(BankState.cap, 8))
            Deallocate(BankState.names, Multiply(BankState.cap, 8))
            Deallocate(BankState.maps, BankState.cap)
        }
        BankState.keys = nk
        BankState.names = nn
        BankState.maps = nm
        BankState.cap = ncap
        ReturnValue(1)
    }
}

Function.MIDI_Bank_Put {
    Input: msb: Integer
    Input: lsb: Integer
    Input: pc: Integer
    Input: name: Address
    Input: mp: Integer
    Body: {
        MIDI_Bank_Grow()
        i = BankState.n
        key = Add(ShiftLeft(msb, 16), Add(ShiftLeft(lsb, 8), pc))
        StoreValue(Add(BankState.keys, Multiply(i, 8)), key)
        StoreValue(Add(BankState.names, Multiply(i, 8)), name)
        SetByte(BankState.maps, i, mp)
        BankState.n = Add(i, 1)
    }
}

Function.MIDI_Bank_Find {
    Input: msb: Integer
    Input: lsb: Integer
    Input: pc: Integer
    Input: mp: Integer
    Output: Address
    Body: {
        IfCondition EqualTo(BankState.ok, 0) ThenBlock: { MIDI_Bank_Init() }
        want = Add(ShiftLeft(msb, 16), Add(ShiftLeft(lsb, 8), pc))
        i = 0
        n = BankState.n
        WhileLoop LessThan(i, n) {
            k = Dereference(Add(BankState.keys, Multiply(i, 8)))
            m = GetByte(BankState.maps, i)
            IfCondition EqualTo(k, want) ThenBlock: {
                IfCondition EqualTo(m, mp) ThenBlock: {
                    ReturnValue(Dereference(Add(BankState.names, Multiply(i, 8))))
                }
            }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

