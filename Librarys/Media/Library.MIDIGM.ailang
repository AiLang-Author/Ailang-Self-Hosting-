// Library.MIDIGM.ailang
// General MIDI Level 1 program names, percussion, CC, families.
// Bank Select (CC0/CC32) + program → MIDI_GM_PatchName.
// Name tables: 128 GM programs, 128 CCs, GM percussion, 16 families.
//
// Copyright 2026 Sean Collins, 2 Paws Machine and Engineering. SCSL.

FixedPool.GMState {
    "prog_table": Initialize=0, CanChange=True
    "cc_table":   Initialize=0, CanChange=True
    "drum_table": Initialize=0, CanChange=True
    "fam_table":  Initialize=0, CanChange=True
    "kit_table":  Initialize=0, CanChange=True
    "prog_blob":  Initialize=0, CanChange=True
    "cc_blob":    Initialize=0, CanChange=True
    "drum_blob":  Initialize=0, CanChange=True
    "ok":         Initialize=0, CanChange=True
}

FixedPool.GMProgBlob {
    "g0": Initialize="Acoustic Grand Piano|Bright Acoustic Piano|Electric Grand Piano|Honky-tonk Piano|Electric Piano 1|Electric Piano 2|Harpsichord|Clavi|Celesta|Glockenspiel|Music Box|Vibraphone|Marimba|Xylophone|Tubular Bells|Dulcimer"
    "g1": Initialize="Drawbar Organ|Percussive Organ|Rock Organ|Church Organ|Reed Organ|Accordion|Harmonica|Tango Accordion|Acoustic Guitar (nylon)|Acoustic Guitar (steel)|Electric Guitar (jazz)|Electric Guitar (clean)|Electric Guitar (muted)|Overdriven Guitar|Distortion Guitar|Guitar harmonics"
    "g2": Initialize="Acoustic Bass|Electric Bass (finger)|Electric Bass (pick)|Fretless Bass|Slap Bass 1|Slap Bass 2|Synth Bass 1|Synth Bass 2|Violin|Viola|Cello|Contrabass|Tremolo Strings|Pizzicato Strings|Orchestral Harp|Timpani"
    "g3": Initialize="String Ensemble 1|String Ensemble 2|SynthStrings 1|SynthStrings 2|Choir Aahs|Voice Oohs|Synth Voice|Orchestra Hit|Trumpet|Trombone|Tuba|Muted Trumpet|French Horn|Brass Section|SynthBrass 1|SynthBrass 2"
    "g4": Initialize="Soprano Sax|Alto Sax|Tenor Sax|Baritone Sax|Oboe|English Horn|Bassoon|Clarinet|Piccolo|Flute|Recorder|Pan Flute|Blown Bottle|Shakuhachi|Whistle|Ocarina"
    "g5": Initialize="Lead 1 (square)|Lead 2 (sawtooth)|Lead 3 (calliope)|Lead 4 (chiff)|Lead 5 (charang)|Lead 6 (voice)|Lead 7 (fifths)|Lead 8 (bass + lead)|Pad 1 (new age)|Pad 2 (warm)|Pad 3 (polysynth)|Pad 4 (choir)|Pad 5 (bowed)|Pad 6 (metallic)|Pad 7 (halo)|Pad 8 (sweep)"
    "g6": Initialize="FX 1 (rain)|FX 2 (soundtrack)|FX 3 (crystal)|FX 4 (atmosphere)|FX 5 (brightness)|FX 6 (goblins)|FX 7 (echoes)|FX 8 (sci-fi)|Sitar|Banjo|Shamisen|Koto|Kalimba|Bag pipe|Fiddle|Shanai"
    "g7": Initialize="Tinkle Bell|Agogo|Steel Drums|Woodblock|Taiko Drum|Melodic Tom|Synth Drum|Reverse Cymbal|Guitar Fret Noise|Breath Noise|Seashore|Bird Tweet|Telephone Ring|Helicopter|Applause|Gunshot"
}

FixedPool.GMCCBlob {
    "c0": Initialize="Bank Select MSB|Modulation|Breath Controller|Undefined|Foot Controller|Portamento Time|Data Entry MSB|Channel Volume|Balance|Undefined|Pan|Expression|Effect Control 1|Effect Control 2|Undefined|Undefined"
    "c1": Initialize="General Purpose 1|General Purpose 2|General Purpose 3|General Purpose 4|Undefined|Undefined|Undefined|Undefined|Undefined|Undefined|Undefined|Undefined|Undefined|Undefined|Undefined|Undefined"
    "c2": Initialize="Bank Select LSB|Modulation LSB|Breath LSB|Undefined LSB|Foot LSB|Portamento Time LSB|Data Entry LSB|Channel Volume LSB|Balance LSB|Undefined LSB|Pan LSB|Expression LSB|Effect Control 1 LSB|Effect Control 2 LSB|Undefined LSB|Undefined LSB"
    "c3": Initialize="General Purpose 1 LSB|General Purpose 2 LSB|General Purpose 3 LSB|General Purpose 4 LSB|Undefined LSB|Undefined LSB|Undefined LSB|Undefined LSB|Undefined LSB|Undefined LSB|Undefined LSB|Undefined LSB|Undefined LSB|Undefined LSB|Undefined LSB|Undefined LSB"
    "c4": Initialize="Damper Pedal (Sustain)|Portamento On/Off|Sostenuto|Soft Pedal|Legato Footswitch|Hold 2|Sound Variation|Timbre/Harmonic Intensity|Release Time|Attack Time|Brightness|Decay Time|Vibrato Rate|Vibrato Depth|Vibrato Delay|Sound Controller 10"
    "c5": Initialize="General Purpose 5|General Purpose 6|General Purpose 7|General Purpose 8|Portamento Control|Undefined|Undefined|Undefined|Undefined|Undefined|Undefined|Effects 1 Depth (Reverb)|Effects 2 Depth (Tremolo)|Effects 3 Depth (Chorus)|Effects 4 Depth (Detune)|Effects 5 Depth (Phaser)"
    "c6": Initialize="Data Increment|Data Decrement|NRPN LSB|NRPN MSB|RPN LSB|RPN MSB|Undefined|Undefined|Undefined|Undefined|Undefined|Undefined|Undefined|Undefined|Undefined|Undefined"
    "c7": Initialize="Undefined|Undefined|Undefined|Undefined|Undefined|Undefined|Undefined|Undefined|All Sound Off|Reset All Controllers|Local Control|All Notes Off|Omni Off|Omni On|Mono On|Poly On"
}

FixedPool.GMDrumBlob {
    "d0": Initialize="|||||||||||||||"
    "d1": Initialize="|||||||||||High Q|Slap|Scratch Push|Scratch Pull|Sticks"
    "d2": Initialize="Square Click|Metronome Click|Metronome Bell|Acoustic Bass Drum|Bass Drum 1|Side Stick|Acoustic Snare|Hand Clap|Electric Snare|Low Floor Tom|Closed Hi-Hat|High Floor Tom|Pedal Hi-Hat|Low Tom|Open Hi-Hat|Low-Mid Tom"
    "d3": Initialize="Hi-Mid Tom|Crash Cymbal 1|High Tom|Ride Cymbal 1|Chinese Cymbal|Ride Bell|Tambourine|Splash Cymbal|Cowbell|Crash Cymbal 2|Vibraslap|Ride Cymbal 2|Hi Bongo|Low Bongo|Mute Hi Conga|Open Hi Conga"
    "d4": Initialize="Low Conga|High Timbale|Low Timbale|High Agogo|Low Agogo|Cabasa|Maracas|Short Whistle|Long Whistle|Short Guiro|Long Guiro|Claves|Hi Wood Block|Low Wood Block|Mute Cuica|Open Cuica"
    "d5": Initialize="Mute Triangle|Open Triangle|Shaker|Jingle Bell|Belltree|Castanets|Mute Surdo|Open Surdo||||||||"
    "d6": Initialize="|||||||||||||||"
    "d7": Initialize="|||||||||||||||"
}

FixedPool.GMFamBlob {
    "f0": Initialize="Piano|Chromatic Percussion|Organ|Guitar|Bass|Strings|Ensemble|Brass|Reed|Pipe|Synth Lead|Synth Pad|Synth Effects|Ethnic|Percussive|Sound Effects"
}

FixedPool.GMKitBlob {
    "k0": Initialize="Standard Kit|Room Kit|Power Kit|Electronic Kit|Analog Kit|Jazz Kit|Brush Kit|Orchestra Kit|SFX Kit|Standard Kit 2|Room Kit 2|Power Kit 2|Electronic Kit 2|Analog Kit 2|Jazz Kit 2|Brush Kit 2"
}

Function.MIDI_GM_SplitChunk {
    Input: src: Address
    Input: table: Address
    Input: start: Integer
    Input: maxn: Integer
    Output: Integer
    Body: {
        n = StringLength(src)
        copy = Allocate(Add(n, 1))
        MemoryCopy(copy, src, n)
        SetByte(copy, n, 0)
        count = start
        field = copy
        i = 0
        WhileLoop LessThan(i, n) {
            ch = GetByte(copy, i)
            IfCondition EqualTo(ch, 124) ThenBlock: {
                SetByte(copy, i, 0)
                IfCondition LessThan(count, maxn) ThenBlock: {
                    StoreValue(Add(table, Multiply(count, 8)), field)
                    count = Add(count, 1)
                }
                field = Add(copy, Add(i, 1))
            }
            i = Add(i, 1)
        }
        IfCondition LessThan(count, maxn) ThenBlock: {
            StoreValue(Add(table, Multiply(count, 8)), field)
            count = Add(count, 1)
        }
        ReturnValue(count)
    }
}

Function.MIDI_GM_Init {
    Body: {
        IfCondition EqualTo(GMState.ok, 1) ThenBlock: { ReturnValue(0) }
        GMState.prog_table = Allocate(1024)
        GMState.cc_table   = Allocate(1024)
        GMState.drum_table = Allocate(1024)
        GMState.fam_table  = Allocate(128)
        GMState.kit_table  = Allocate(128)
        MemorySet(GMState.prog_table, 0, 1024)
        MemorySet(GMState.cc_table, 0, 1024)
        MemorySet(GMState.drum_table, 0, 1024)
        MemorySet(GMState.fam_table, 0, 128)
        MemorySet(GMState.kit_table, 0, 128)
        MIDI_GM_SplitChunk(GMProgBlob.g0, GMState.prog_table, 0, 128)
        MIDI_GM_SplitChunk(GMProgBlob.g1, GMState.prog_table, 16, 128)
        MIDI_GM_SplitChunk(GMProgBlob.g2, GMState.prog_table, 32, 128)
        MIDI_GM_SplitChunk(GMProgBlob.g3, GMState.prog_table, 48, 128)
        MIDI_GM_SplitChunk(GMProgBlob.g4, GMState.prog_table, 64, 128)
        MIDI_GM_SplitChunk(GMProgBlob.g5, GMState.prog_table, 80, 128)
        MIDI_GM_SplitChunk(GMProgBlob.g6, GMState.prog_table, 96, 128)
        MIDI_GM_SplitChunk(GMProgBlob.g7, GMState.prog_table, 112, 128)
        MIDI_GM_SplitChunk(GMCCBlob.c0, GMState.cc_table, 0, 128)
        MIDI_GM_SplitChunk(GMCCBlob.c1, GMState.cc_table, 16, 128)
        MIDI_GM_SplitChunk(GMCCBlob.c2, GMState.cc_table, 32, 128)
        MIDI_GM_SplitChunk(GMCCBlob.c3, GMState.cc_table, 48, 128)
        MIDI_GM_SplitChunk(GMCCBlob.c4, GMState.cc_table, 64, 128)
        MIDI_GM_SplitChunk(GMCCBlob.c5, GMState.cc_table, 80, 128)
        MIDI_GM_SplitChunk(GMCCBlob.c6, GMState.cc_table, 96, 128)
        MIDI_GM_SplitChunk(GMCCBlob.c7, GMState.cc_table, 112, 128)
        MIDI_GM_SplitChunk(GMDrumBlob.d0, GMState.drum_table, 0, 128)
        MIDI_GM_SplitChunk(GMDrumBlob.d1, GMState.drum_table, 16, 128)
        MIDI_GM_SplitChunk(GMDrumBlob.d2, GMState.drum_table, 32, 128)
        MIDI_GM_SplitChunk(GMDrumBlob.d3, GMState.drum_table, 48, 128)
        MIDI_GM_SplitChunk(GMDrumBlob.d4, GMState.drum_table, 64, 128)
        MIDI_GM_SplitChunk(GMDrumBlob.d5, GMState.drum_table, 80, 128)
        MIDI_GM_SplitChunk(GMDrumBlob.d6, GMState.drum_table, 96, 128)
        MIDI_GM_SplitChunk(GMDrumBlob.d7, GMState.drum_table, 112, 128)
        MIDI_GM_SplitChunk(GMFamBlob.f0, GMState.fam_table, 0, 16)
        MIDI_GM_SplitChunk(GMKitBlob.k0, GMState.kit_table, 0, 16)
        GMState.ok = 1
    }
}

Function.MIDI_GM_Lookup {
    Input: table: Address
    Input: index: Integer
    Input: maxn: Integer
    Output: Address
    Body: {
        IfCondition EqualTo(GMState.ok, 0) ThenBlock: { MIDI_GM_Init() }
        IfCondition EqualTo(table, 0) ThenBlock: { ReturnValue("") }
        IfCondition LessThan(index, 0) ThenBlock: { ReturnValue("") }
        IfCondition GreaterEqual(index, maxn) ThenBlock: { ReturnValue("") }
        p = Dereference(Add(table, Multiply(index, 8)))
        IfCondition EqualTo(p, 0) ThenBlock: { ReturnValue("") }
        ReturnValue(p)
    }
}

Function.MIDI_GM_ProgramName {
    Input: program: Integer
    Output: Address
    Body: {
        p = MIDI_GM_Lookup(GMState.prog_table, program, 128)
        ReturnValue(p)
    }
}

Function.MIDI_GM_FamilyName {
    Input: program: Integer
    Output: Address
    Body: {
        IfCondition LessThan(program, 0) ThenBlock: { ReturnValue("") }
        fam = Divide(program, 8)
        p = MIDI_GM_Lookup(GMState.fam_table, fam, 16)
        ReturnValue(p)
    }
}

Function.MIDI_GM_CCName {
    Input: cc: Integer
    Output: Address
    Body: {
        p = MIDI_GM_Lookup(GMState.cc_table, cc, 128)
        ReturnValue(p)
    }
}

Function.MIDI_GM_DrumName {
    Input: note: Integer
    Output: Address
    Body: {
        p = MIDI_GM_Lookup(GMState.drum_table, note, 128)
        IfCondition EqualTo(p, 0) ThenBlock: { ReturnValue("") }
        IfCondition EqualTo(GetByte(p, 0), 0) ThenBlock: { ReturnValue("") }
        ReturnValue(p)
    }
}

Function.MIDI_GM_KitName {
    Input: program: Integer
    Output: Address
    Body: {
        p = MIDI_GM_Lookup(GMState.kit_table, program, 16)
        ReturnValue(p)
    }
}

Function.MIDI_GM_IsDrumChannel {
    Input: ch: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(ch, 9) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

Function.MIDI_GM_RPNName {
    Input: msb: Integer
    Input: lsb: Integer
    Output: Address
    Body: {
        IfCondition EqualTo(msb, 0) ThenBlock: {
            IfCondition EqualTo(lsb, 0) ThenBlock: { ReturnValue("Pitch Bend Sensitivity") }
            IfCondition EqualTo(lsb, 1) ThenBlock: { ReturnValue("Fine Tuning") }
            IfCondition EqualTo(lsb, 2) ThenBlock: { ReturnValue("Coarse Tuning") }
            IfCondition EqualTo(lsb, 3) ThenBlock: { ReturnValue("Tuning Program Select") }
            IfCondition EqualTo(lsb, 4) ThenBlock: { ReturnValue("Tuning Bank Select") }
            IfCondition EqualTo(lsb, 5) ThenBlock: { ReturnValue("Modulation Depth Range") }
            IfCondition EqualTo(lsb, 6) ThenBlock: { ReturnValue("MPE Configuration") }
        }
        eqm = EqualTo(msb, 127)
        eql = EqualTo(lsb, 127)
        IfCondition And(eqm, eql) ThenBlock: { ReturnValue("RPN Null") }
        ReturnValue("RPN")
    }
}

Function.MIDI_GM_PatchName {
    Input: bank_msb: Integer
    Input: bank_lsb: Integer
    Input: program: Integer
    Output: Address
    Body: {
        gm = MIDI_GM_ProgramName(program)
        IfCondition EqualTo(bank_msb, 0) ThenBlock: {
            IfCondition EqualTo(bank_lsb, 0) ThenBlock: { ReturnValue(gm) }
        }
        ReturnValue(gm)
    }
}

