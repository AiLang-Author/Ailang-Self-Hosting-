// Library.MIDIPatch.ailang
// MIDI patch bay: virtual ports, cables, per-channel GM state, note tracking.
//
// A cable is src_port/src_ch → dst_port/dst_ch.
//   src_ch  = 16 means all channels
//   dst_ch  = 16 means keep source channel
// Transpose is stored as signed + 128 (128 = 0).
// Velocity scale: 256 = 1.0.
//
// Channel state (32 bytes) per port×channel:
//   0 bank_msb  1 bank_lsb  2 program  3 volume
//   4 expression 5 pan  6 sustain  7 mod
//   8-9 pitch_bend (u16 LE, 8192 centre)
//   10 rpn_msb 11 rpn_lsb 12 nrpn_msb 13 nrpn_lsb
//   14 data_msb 15 flags (bit0 mute)
//
// Copyright 2026 Sean Collins, 2 Paws Machine and Engineering. SCSL.

LibraryImport.Media.MIDI
LibraryImport.Media.MIDIGM
LibraryImport.Media.MIDIBank

FixedPool.BayConst {
    "MAX_PORTS":   Initialize=16
    "MAX_CABLES":  Initialize=64
    "CH_PER":      Initialize=16
    "PORT_HDR":    Initialize=32
    "CH_SIZE":     Initialize=32
    "PORT_SIZE":   Initialize=544
    "CABLE_SIZE":  Initialize=32
    "NOTES_CH":    Initialize=16
    "ALL_CH":      Initialize=16
    "PB_CENTER":   Initialize=8192
}

FixedPool.BayCh {
    "BANK_MSB":  Initialize=0
    "BANK_LSB":  Initialize=1
    "PROGRAM":   Initialize=2
    "VOLUME":    Initialize=3
    "EXPR":      Initialize=4
    "PAN":       Initialize=5
    "SUSTAIN":   Initialize=6
    "MOD":       Initialize=7
    "BEND_LO":   Initialize=8
    "BEND_HI":   Initialize=9
    "RPN_MSB":   Initialize=10
    "RPN_LSB":   Initialize=11
    "NRPN_MSB":  Initialize=12
    "NRPN_LSB":  Initialize=13
    "DATA_MSB":  Initialize=14
    "FLAGS":     Initialize=15
}

FixedPool.BayCab {
    "SRC_PORT":  Initialize=0
    "SRC_CH":    Initialize=1
    "DST_PORT":  Initialize=2
    "DST_CH":    Initialize=3
    "ENABLED":   Initialize=4
    "TRANSPOSE": Initialize=5
    "VEL_NUM":   Initialize=6
    "MUTE":      Initialize=7
}

FixedPool.BayPort {
    "USED":    Initialize=0
    "TYPE":    Initialize=1
    "ENABLED": Initialize=2
    "NAME":    Initialize=8
}

FixedPool.BayType {
    "SOURCE": Initialize=1
    "DEST":   Initialize=2
    "BOTH":   Initialize=3
}

FixedPool.BayState {
    "ports":     Initialize=0, CanChange=True
    "cables":    Initialize=0, CanChange=True
    "notes":     Initialize=0, CanChange=True
    "port_n":    Initialize=0, CanChange=True
    "cable_n":   Initialize=0, CanChange=True
    "ok":        Initialize=0, CanChange=True
    "routed":    Initialize=0, CanChange=True
    "routed_n":  Initialize=0, CanChange=True
    "routed_cap": Initialize=0, CanChange=True
}

Function.MIDI_Bay_Init {
    Body: {
        IfCondition EqualTo(BayState.ok, 1) ThenBlock: { ReturnValue(0) }
        psz = Multiply(BayConst.MAX_PORTS, BayConst.PORT_SIZE)
        BayState.ports = Allocate(psz)
        MemorySet(BayState.ports, 0, psz)
        csz = Multiply(BayConst.MAX_CABLES, BayConst.CABLE_SIZE)
        BayState.cables = Allocate(csz)
        MemorySet(BayState.cables, 0, csz)
        nsz = Multiply(Multiply(BayConst.MAX_PORTS, BayConst.CH_PER), BayConst.NOTES_CH)
        BayState.notes = Allocate(nsz)
        MemorySet(BayState.notes, 0, nsz)
        BayState.routed_cap = 32
        BayState.routed = Allocate(Multiply(32, MIDIEv.SIZE))
        MemorySet(BayState.routed, 0, Multiply(32, MIDIEv.SIZE))
        BayState.port_n = 0
        BayState.cable_n = 0
        BayState.routed_n = 0
        BayState.ok = 1
        MIDI_GM_Init()
        MIDI_Bank_Init()
    }
}

Function.MIDI_Bay_PortPtr {
    Input: port: Integer
    Output: Address
    Body: {
        IfCondition EqualTo(BayState.ok, 0) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(port, 0) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterEqual(port, BayConst.MAX_PORTS) ThenBlock: { ReturnValue(0) }
        ReturnValue(Add(BayState.ports, Multiply(port, BayConst.PORT_SIZE)))
    }
}

Function.MIDI_Bay_ChanPtr {
    Input: port: Integer
    Input: ch: Integer
    Output: Address
    Body: {
        p = MIDI_Bay_PortPtr(port)
        IfCondition EqualTo(p, 0) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(ch, 0) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterEqual(ch, 16) ThenBlock: { ReturnValue(0) }
        ReturnValue(Add(Add(p, BayConst.PORT_HDR), Multiply(ch, BayConst.CH_SIZE)))
    }
}

Function.MIDI_Bay_ResetChan {
    Input: cp: Address
    Body: {
        MemorySet(cp, 0, BayConst.CH_SIZE)
        SetByte(cp, BayCh.VOLUME, 100)
        SetByte(cp, BayCh.EXPR, 127)
        SetByte(cp, BayCh.PAN, 64)
        SetByte(cp, BayCh.RPN_MSB, 127)
        SetByte(cp, BayCh.RPN_LSB, 127)
        SetByte(cp, BayCh.NRPN_MSB, 127)
        SetByte(cp, BayCh.NRPN_LSB, 127)
        SetByte(cp, BayCh.BEND_LO, 0)
        SetByte(cp, BayCh.BEND_HI, 32)
    }
}

Function.MIDI_Bay_AddPort {
    Input: name: Address
    Input: typ: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(BayState.ok, 0) ThenBlock: { MIDI_Bay_Init() }
        n = BayState.port_n
        IfCondition GreaterEqual(n, BayConst.MAX_PORTS) ThenBlock: { ReturnValue(-1) }
        p = MIDI_Bay_PortPtr(n)
        MemorySet(p, 0, BayConst.PORT_SIZE)
        SetByte(p, BayPort.USED, 1)
        SetByte(p, BayPort.TYPE, typ)
        SetByte(p, BayPort.ENABLED, 1)
        StoreValue(Add(p, BayPort.NAME), name)
        ch = 0
        WhileLoop LessThan(ch, 16) {
            cp = Add(Add(p, BayConst.PORT_HDR), Multiply(ch, BayConst.CH_SIZE))
            MIDI_Bay_ResetChan(cp)
            ch = Add(ch, 1)
        }
        BayState.port_n = Add(n, 1)
        ReturnValue(n)
    }
}

Function.MIDI_Bay_PortCount {
    Output: Integer
    Body: { ReturnValue(BayState.port_n) }
}

Function.MIDI_Bay_PortName {
    Input: port: Integer
    Output: Address
    Body: {
        p = MIDI_Bay_PortPtr(port)
        IfCondition EqualTo(p, 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(Dereference(Add(p, BayPort.NAME)))
    }
}

Function.MIDI_Bay_Connect {
    Input: src_port: Integer
    Input: src_ch: Integer
    Input: dst_port: Integer
    Input: dst_ch: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(BayState.ok, 0) ThenBlock: { MIDI_Bay_Init() }
        n = BayState.cable_n
        IfCondition GreaterEqual(n, BayConst.MAX_CABLES) ThenBlock: { ReturnValue(-1) }
        c = Add(BayState.cables, Multiply(n, BayConst.CABLE_SIZE))
        MemorySet(c, 0, BayConst.CABLE_SIZE)
        SetByte(c, BayCab.SRC_PORT, src_port)
        SetByte(c, BayCab.SRC_CH, src_ch)
        SetByte(c, BayCab.DST_PORT, dst_port)
        SetByte(c, BayCab.DST_CH, dst_ch)
        SetByte(c, BayCab.ENABLED, 1)
        SetByte(c, BayCab.TRANSPOSE, 128)
        SetByte(c, BayCab.VEL_NUM, 0)
        SetByte(c, BayCab.MUTE, 0)
        BayState.cable_n = Add(n, 1)
        ReturnValue(n)
    }
}

Function.MIDI_Bay_SetCable {
    Input: cable: Integer
    Input: enabled: Integer
    Input: transpose: Integer
    Input: mute: Integer
    Body: {
        IfCondition LessThan(cable, 0) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterEqual(cable, BayState.cable_n) ThenBlock: { ReturnValue(0) }
        c = Add(BayState.cables, Multiply(cable, BayConst.CABLE_SIZE))
        SetByte(c, BayCab.ENABLED, enabled)
        SetByte(c, BayCab.MUTE, mute)
        t = Add(transpose, 128)
        IfCondition LessThan(t, 0) ThenBlock: { t = 0 }
        IfCondition GreaterThan(t, 255) ThenBlock: { t = 255 }
        SetByte(c, BayCab.TRANSPOSE, t)
    }
}

Function.MIDI_Bay_CableCount {
    Output: Integer
    Body: { ReturnValue(BayState.cable_n) }
}

Function.MIDI_Bay_NotesPtr {
    Input: port: Integer
    Input: ch: Integer
    Output: Address
    Body: {
        IfCondition EqualTo(BayState.notes, 0) ThenBlock: { ReturnValue(0) }
        off = Multiply(Add(Multiply(port, 16), ch), BayConst.NOTES_CH)
        ReturnValue(Add(BayState.notes, off))
    }
}

Function.MIDI_Bay_NoteSet {
    Input: port: Integer
    Input: ch: Integer
    Input: note: Integer
    Input: on: Integer
    Body: {
        np = MIDI_Bay_NotesPtr(port, ch)
        IfCondition EqualTo(np, 0) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(note, 0) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterThan(note, 127) ThenBlock: { ReturnValue(0) }
        bi = Divide(note, 8)
        bit = Modulo(note, 8)
        cur = GetByte(np, bi)
        mask = ShiftLeft(1, bit)
        IfCondition NotEqual(on, 0) ThenBlock: {
            SetByte(np, bi, BitwiseOr(cur, mask))
        } ElseBlock: {
            nmask = Subtract(255, mask)
            SetByte(np, bi, BitwiseAnd(cur, nmask))
        }
    }
}

Function.MIDI_Bay_NotesOff {
    Input: port: Integer
    Input: ch: Integer
    Body: {
        np = MIDI_Bay_NotesPtr(port, ch)
        IfCondition EqualTo(np, 0) ThenBlock: { ReturnValue(0) }
        MemorySet(np, 0, BayConst.NOTES_CH)
    }
}

Function.MIDI_Bay_ApplyCC {
    Input: cp: Address
    Input: cc: Integer
    Input: val: Integer
    Body: {
        v = val
        IfCondition LessThan(v, 0) ThenBlock: { v = 0 }
        IfCondition GreaterThan(v, 127) ThenBlock: { v = 127 }
        IfCondition EqualTo(cc, 0) ThenBlock: { SetByte(cp, BayCh.BANK_MSB, v) }
        IfCondition EqualTo(cc, 32) ThenBlock: { SetByte(cp, BayCh.BANK_LSB, v) }
        IfCondition EqualTo(cc, 1) ThenBlock: { SetByte(cp, BayCh.MOD, v) }
        IfCondition EqualTo(cc, 7) ThenBlock: { SetByte(cp, BayCh.VOLUME, v) }
        IfCondition EqualTo(cc, 11) ThenBlock: { SetByte(cp, BayCh.EXPR, v) }
        IfCondition EqualTo(cc, 10) ThenBlock: { SetByte(cp, BayCh.PAN, v) }
        IfCondition EqualTo(cc, 64) ThenBlock: { SetByte(cp, BayCh.SUSTAIN, v) }
        IfCondition EqualTo(cc, 6) ThenBlock: { SetByte(cp, BayCh.DATA_MSB, v) }
        IfCondition EqualTo(cc, 98) ThenBlock: { SetByte(cp, BayCh.NRPN_LSB, v) }
        IfCondition EqualTo(cc, 99) ThenBlock: { SetByte(cp, BayCh.NRPN_MSB, v) }
        IfCondition EqualTo(cc, 100) ThenBlock: { SetByte(cp, BayCh.RPN_LSB, v) }
        IfCondition EqualTo(cc, 101) ThenBlock: { SetByte(cp, BayCh.RPN_MSB, v) }
        IfCondition EqualTo(cc, 121) ThenBlock: {
            SetByte(cp, BayCh.MOD, 0)
            SetByte(cp, BayCh.EXPR, 127)
            SetByte(cp, BayCh.SUSTAIN, 0)
            SetByte(cp, BayCh.BEND_LO, 0)
            SetByte(cp, BayCh.BEND_HI, 32)
            SetByte(cp, BayCh.RPN_MSB, 127)
            SetByte(cp, BayCh.RPN_LSB, 127)
        }
    }
}

Function.MIDI_Bay_Consume {
    Input: port: Integer
    Input: ev: Address
    Body: {
        IfCondition EqualTo(ev, 0) ThenBlock: { ReturnValue(0) }
        kind = MIDI_EvKind(ev)
        IfCondition NotEqual(kind, MIDIKind.CHANNEL) ThenBlock: { ReturnValue(0) }
        ch = MIDI_EvCh(ev)
        cp = MIDI_Bay_ChanPtr(port, ch)
        IfCondition EqualTo(cp, 0) ThenBlock: { ReturnValue(0) }
        st = MIDI_EvStatus(ev)
        hi = BitwiseAnd(st, 240)
        d1 = MIDI_EvD1(ev)
        d2 = MIDI_EvD2(ev)
        IfCondition EqualTo(hi, 144) ThenBlock: {
            IfCondition GreaterThan(d2, 0) ThenBlock: {
                MIDI_Bay_NoteSet(port, ch, d1, 1)
            } ElseBlock: {
                MIDI_Bay_NoteSet(port, ch, d1, 0)
            }
        }
        IfCondition EqualTo(hi, 128) ThenBlock: {
            MIDI_Bay_NoteSet(port, ch, d1, 0)
        }
        IfCondition EqualTo(hi, 176) ThenBlock: {
            MIDI_Bay_ApplyCC(cp, d1, d2)
            IfCondition EqualTo(d1, 120) ThenBlock: { MIDI_Bay_NotesOff(port, ch) }
            IfCondition EqualTo(d1, 123) ThenBlock: { MIDI_Bay_NotesOff(port, ch) }
        }
        IfCondition EqualTo(hi, 192) ThenBlock: {
            SetByte(cp, BayCh.PROGRAM, d1)
        }
        IfCondition EqualTo(hi, 224) ThenBlock: {
            SetByte(cp, BayCh.BEND_LO, d1)
            SetByte(cp, BayCh.BEND_HI, d2)
        }
    }
}

Function.MIDI_Bay_Program {
    Input: port: Integer
    Input: ch: Integer
    Output: Integer
    Body: {
        cp = MIDI_Bay_ChanPtr(port, ch)
        IfCondition EqualTo(cp, 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(GetByte(cp, BayCh.PROGRAM))
    }
}

Function.MIDI_Bay_BankMSB {
    Input: port: Integer
    Input: ch: Integer
    Output: Integer
    Body: {
        cp = MIDI_Bay_ChanPtr(port, ch)
        IfCondition EqualTo(cp, 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(GetByte(cp, BayCh.BANK_MSB))
    }
}

Function.MIDI_Bay_BankLSB {
    Input: port: Integer
    Input: ch: Integer
    Output: Integer
    Body: {
        cp = MIDI_Bay_ChanPtr(port, ch)
        IfCondition EqualTo(cp, 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(GetByte(cp, BayCh.BANK_LSB))
    }
}

Function.MIDI_Bay_PatchName {
    Input: port: Integer
    Input: ch: Integer
    Output: Address
    Body: {
        drum = MIDI_GM_IsDrumChannel(ch)
        IfCondition EqualTo(drum, 1) ThenBlock: {
            prog = MIDI_Bay_Program(port, ch)
            kn = MIDI_GM_KitName(prog)
            IfCondition EqualTo(GetByte(kn, 0), 0) ThenBlock: {
                ReturnValue("Standard Kit")
            }
            ReturnValue(kn)
        }
        msb = MIDI_Bay_BankMSB(port, ch)
        lsb = MIDI_Bay_BankLSB(port, ch)
        prog = MIDI_Bay_Program(port, ch)
        p = MIDI_Bank_PatchName(msb, lsb, prog)
        ReturnValue(p)
    }
}

Function.MIDI_Bay_PushRouted {
    Input: ev: Address
    Input: dst_ch: Integer
    Input: note: Integer
    Input: vel: Integer
    Output: Address
    Body: {
        IfCondition GreaterEqual(BayState.routed_n, BayState.routed_cap) ThenBlock: { ReturnValue(0) }
        dst = Add(BayState.routed, Multiply(BayState.routed_n, MIDIEv.SIZE))
        MemoryCopy(dst, ev, MIDIEv.SIZE)
        st = GetByte(dst, MIDIEv.STATUS)
        hi = BitwiseAnd(st, 240)
        SetByte(dst, MIDIEv.STATUS, Add(hi, dst_ch))
        SetByte(dst, MIDIEv.CH, dst_ch)
        SetByte(dst, MIDIEv.D1, note)
        SetByte(dst, MIDIEv.D2, vel)
        BayState.routed_n = Add(BayState.routed_n, 1)
        ReturnValue(dst)
    }
}

Function.MIDI_Bay_RoutedCount {
    Output: Integer
    Body: { ReturnValue(BayState.routed_n) }
}

Function.MIDI_Bay_RoutedEvent {
    Input: index: Integer
    Output: Address
    Body: {
        IfCondition LessThan(index, 0) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterEqual(index, BayState.routed_n) ThenBlock: { ReturnValue(0) }
        ReturnValue(Add(BayState.routed, Multiply(index, MIDIEv.SIZE)))
    }
}

Function.MIDI_Bay_Route {
    Input: src_port: Integer
    Input: ev: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(BayState.ok, 0) ThenBlock: { MIDI_Bay_Init() }
        BayState.routed_n = 0
        IfCondition EqualTo(ev, 0) ThenBlock: { ReturnValue(0) }
        MIDI_Bay_Consume(src_port, ev)
        kind = MIDI_EvKind(ev)
        IfCondition NotEqual(kind, MIDIKind.CHANNEL) ThenBlock: { ReturnValue(0) }
        src_ch = MIDI_EvCh(ev)
        st = MIDI_EvStatus(ev)
        hi = BitwiseAnd(st, 240)
        d1 = MIDI_EvD1(ev)
        d2 = MIDI_EvD2(ev)
        i = 0
        WhileLoop LessThan(i, BayState.cable_n) {
            c = Add(BayState.cables, Multiply(i, BayConst.CABLE_SIZE))
            en = GetByte(c, BayCab.ENABLED)
            mu = GetByte(c, BayCab.MUTE)
            sp = GetByte(c, BayCab.SRC_PORT)
            sc = GetByte(c, BayCab.SRC_CH)
            match = 0
            IfCondition EqualTo(sp, src_port) ThenBlock: {
                IfCondition EqualTo(en, 1) ThenBlock: {
                    IfCondition EqualTo(mu, 0) ThenBlock: {
                        IfCondition EqualTo(sc, 16) ThenBlock: { match = 1 }
                        IfCondition EqualTo(sc, src_ch) ThenBlock: { match = 1 }
                    }
                }
            }
            IfCondition EqualTo(match, 1) ThenBlock: {
                dp = GetByte(c, BayCab.DST_PORT)
                dc = GetByte(c, BayCab.DST_CH)
                IfCondition EqualTo(dc, 16) ThenBlock: { dc = src_ch }
                note = d1
                vel = d2
                is_note = 0
                IfCondition EqualTo(hi, 144) ThenBlock: { is_note = 1 }
                IfCondition EqualTo(hi, 128) ThenBlock: { is_note = 1 }
                IfCondition EqualTo(is_note, 1) ThenBlock: {
                    tr = Subtract(GetByte(c, BayCab.TRANSPOSE), 128)
                    note = Add(d1, tr)
                    IfCondition LessThan(note, 0) ThenBlock: { note = 0 }
                    IfCondition GreaterThan(note, 127) ThenBlock: { note = 127 }
                }
                out = MIDI_Bay_PushRouted(ev, dc, note, vel)
                IfCondition NotEqual(out, 0) ThenBlock: {
                    MIDI_Bay_Consume(dp, out)
                }
            }
            i = Add(i, 1)
        }
        ReturnValue(BayState.routed_n)
    }
}
