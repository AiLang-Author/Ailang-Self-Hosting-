// Library.MIDIUMP.ailang
// MIDI 2.0 Universal MIDI Packet (UMP) pack / unpack / stream.
// Words are native 32-bit (little-endian on x86). Wire order is MSB first
// inside each word: MT | Group | ...
//
// Message type → word count:
//   0x0 Utility, 0x1 System, 0x2 MIDI 1.0 CV          → 1 word
//   0x3 Data 64 (SysEx7), 0x4 MIDI 2.0 CV             → 2 words
//   0x5 Data 128 (SysEx8 / MDS), 0xD Flex, 0xF Stream → 4 words
//
// Copyright 2026 Sean Collins, 2 Paws Machine and Engineering. SCSL.

LibraryImport.Media.MIDI

FixedPool.UMPMT {
    "UTILITY":  Initialize=0
    "SYSTEM":   Initialize=1
    "MIDI1":    Initialize=2
    "DATA64":   Initialize=3
    "MIDI2":    Initialize=4
    "DATA128":  Initialize=5
    "FLEX":     Initialize=13
    "STREAM":   Initialize=15
}

FixedPool.UMPUtil {
    "NOOP":     Initialize=0
    "JR_CLOCK": Initialize=1
    "JR_TS":    Initialize=2
    "DCTPQ":    Initialize=3
    "DC":       Initialize=4
}

FixedPool.UMPSyx {
    "COMPLETE": Initialize=0
    "START":    Initialize=1
    "CONT":     Initialize=2
    "END":      Initialize=3
}

FixedPool.UMPPkt {
    "w0":     Initialize=0, CanChange=True
    "w1":     Initialize=0, CanChange=True
    "w2":     Initialize=0, CanChange=True
    "w3":     Initialize=0, CanChange=True
    "nwords": Initialize=0, CanChange=True
    "mt":     Initialize=0, CanChange=True
    "group":  Initialize=0, CanChange=True
    "status": Initialize=0, CanChange=True
    "ch":     Initialize=0, CanChange=True
    "d1":     Initialize=0, CanChange=True
    "d2":     Initialize=0, CanChange=True
    "note":   Initialize=0, CanChange=True
    "vel16":  Initialize=0, CanChange=True
    "cc32":   Initialize=0, CanChange=True
    "attr_t": Initialize=0, CanChange=True
    "attr":   Initialize=0, CanChange=True
    "ok":     Initialize=0, CanChange=True
}

FixedPool.UMPStream {
    "need":  Initialize=0, CanChange=True
    "have":  Initialize=0, CanChange=True
    "w0":    Initialize=0, CanChange=True
    "w1":    Initialize=0, CanChange=True
    "w2":    Initialize=0, CanChange=True
    "w3":    Initialize=0, CanChange=True
}

Function.MIDI_UMP_WordCount {
    Input: mt: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(mt, 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(mt, 1) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(mt, 2) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(mt, 3) ThenBlock: { ReturnValue(2) }
        IfCondition EqualTo(mt, 4) ThenBlock: { ReturnValue(2) }
        IfCondition EqualTo(mt, 5) ThenBlock: { ReturnValue(4) }
        IfCondition EqualTo(mt, 13) ThenBlock: { ReturnValue(4) }
        IfCondition EqualTo(mt, 15) ThenBlock: { ReturnValue(4) }
        ReturnValue(1)
    }
}

Function.MIDI_UMP_Scale7to16 {
    Input: v: Integer
    Output: Integer
    Body: {
        IfCondition LessEqual(v, 0) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterEqual(v, 127) ThenBlock: { ReturnValue(65535) }
        a = ShiftLeft(v, 9)
        b = ShiftLeft(v, 2)
        c = Divide(v, 32)
        ReturnValue(BitwiseOr(BitwiseOr(a, b), c))
    }
}

Function.MIDI_UMP_Scale16to7 {
    Input: v: Integer
    Output: Integer
    Body: {
        IfCondition LessEqual(v, 0) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterEqual(v, 65535) ThenBlock: { ReturnValue(127) }
        ReturnValue(Divide(v, 512))
    }
}

Function.MIDI_UMP_Scale7to32 {
    Input: v: Integer
    Output: Integer
    Body: {
        IfCondition LessEqual(v, 0) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterEqual(v, 127) ThenBlock: { ReturnValue(4294967295) }
        a = ShiftLeft(v, 25)
        b = ShiftLeft(v, 18)
        c = ShiftLeft(v, 11)
        d = ShiftLeft(v, 4)
        e = Divide(v, 8)
        ab = BitwiseOr(a, b)
        cd = BitwiseOr(c, d)
        abcd = BitwiseOr(ab, cd)
        ReturnValue(BitwiseOr(abcd, e))
    }
}

Function.MIDI_UMP_PackMIDI1 {
    Input: group: Integer
    Input: status: Integer
    Input: d1: Integer
    Input: d2: Integer
    Output: Integer
    Body: {
        g = BitwiseAnd(group, 15)
        w = ShiftLeft(2, 28)
        w = Add(w, ShiftLeft(g, 24))
        w = Add(w, ShiftLeft(BitwiseAnd(status, 255), 16))
        w = Add(w, ShiftLeft(BitwiseAnd(d1, 255), 8))
        w = Add(w, BitwiseAnd(d2, 255))
        ReturnValue(w)
    }
}

Function.MIDI_UMP_PackSystem {
    Input: group: Integer
    Input: status: Integer
    Input: d1: Integer
    Input: d2: Integer
    Output: Integer
    Body: {
        g = BitwiseAnd(group, 15)
        w = ShiftLeft(1, 28)
        w = Add(w, ShiftLeft(g, 24))
        w = Add(w, ShiftLeft(BitwiseAnd(status, 255), 16))
        w = Add(w, ShiftLeft(BitwiseAnd(d1, 255), 8))
        w = Add(w, BitwiseAnd(d2, 255))
        ReturnValue(w)
    }
}

Function.MIDI_UMP_PackUtility {
    Input: status: Integer
    Input: data16: Integer
    Output: Integer
    Body: {
        w = ShiftLeft(BitwiseAnd(status, 15), 20)
        w = Add(w, BitwiseAnd(data16, 65535))
        ReturnValue(w)
    }
}

Function.MIDI_UMP_PackMIDI2Note {
    Input: group: Integer
    Input: on: Integer
    Input: ch: Integer
    Input: note: Integer
    Input: vel7: Integer
    Output: Integer
    Body: {
        g = BitwiseAnd(group, 15)
        op = 128
        IfCondition NotEqual(on, 0) ThenBlock: { op = 144 }
        st = Add(op, BitwiseAnd(ch, 15))
        w0 = ShiftLeft(4, 28)
        w0 = Add(w0, ShiftLeft(g, 24))
        w0 = Add(w0, ShiftLeft(st, 16))
        w0 = Add(w0, ShiftLeft(BitwiseAnd(note, 127), 8))
        vel16 = MIDI_UMP_Scale7to16(vel7)
        w1 = ShiftLeft(vel16, 16)
        UMPPkt.w0 = w0
        UMPPkt.w1 = w1
        UMPPkt.w2 = 0
        UMPPkt.w3 = 0
        UMPPkt.nwords = 2
        UMPPkt.mt = 4
        UMPPkt.group = g
        UMPPkt.status = st
        UMPPkt.ch = BitwiseAnd(ch, 15)
        UMPPkt.note = BitwiseAnd(note, 127)
        UMPPkt.vel16 = vel16
        ReturnValue(w0)
    }
}

Function.MIDI_UMP_PackMIDI2CC {
    Input: group: Integer
    Input: ch: Integer
    Input: cc: Integer
    Input: val7: Integer
    Output: Integer
    Body: {
        g = BitwiseAnd(group, 15)
        st = Add(176, BitwiseAnd(ch, 15))
        w0 = ShiftLeft(4, 28)
        w0 = Add(w0, ShiftLeft(g, 24))
        w0 = Add(w0, ShiftLeft(st, 16))
        w0 = Add(w0, ShiftLeft(BitwiseAnd(cc, 127), 8))
        v32 = MIDI_UMP_Scale7to32(val7)
        UMPPkt.w0 = w0
        UMPPkt.w1 = v32
        UMPPkt.nwords = 2
        UMPPkt.mt = 4
        UMPPkt.cc32 = v32
        ReturnValue(w0)
    }
}

Function.MIDI_UMP_PackMIDI2PC {
    Input: group: Integer
    Input: ch: Integer
    Input: program: Integer
    Input: bank_msb: Integer
    Input: bank_lsb: Integer
    Output: Integer
    Body: {
        g = BitwiseAnd(group, 15)
        st = Add(192, BitwiseAnd(ch, 15))
        flags = 1
        w0 = ShiftLeft(4, 28)
        w0 = Add(w0, ShiftLeft(g, 24))
        w0 = Add(w0, ShiftLeft(st, 16))
        w0 = Add(w0, flags)
        w1 = ShiftLeft(BitwiseAnd(program, 127), 24)
        w1 = Add(w1, ShiftLeft(BitwiseAnd(bank_msb, 127), 8))
        w1 = Add(w1, BitwiseAnd(bank_lsb, 127))
        UMPPkt.w0 = w0
        UMPPkt.w1 = w1
        UMPPkt.nwords = 2
        UMPPkt.mt = 4
        ReturnValue(w0)
    }
}

Function.MIDI_UMP_DecodeWord0 {
    Input: w0: Integer
    Body: {
        mt = BitwiseAnd(Divide(w0, 268435456), 15)
        UMPPkt.mt = mt
        UMPPkt.group = BitwiseAnd(Divide(w0, 16777216), 15)
        UMPPkt.status = BitwiseAnd(Divide(w0, 65536), 255)
        UMPPkt.ch = BitwiseAnd(UMPPkt.status, 15)
        UMPPkt.d1 = BitwiseAnd(Divide(w0, 256), 255)
        UMPPkt.d2 = BitwiseAnd(w0, 255)
        UMPPkt.w0 = w0
        n = MIDI_UMP_WordCount(mt)
        UMPPkt.nwords = n
        UMPPkt.ok = 1
    }
}

Function.MIDI_UMP_Decode {
    Input: w0: Integer
    Input: w1: Integer
    Input: w2: Integer
    Input: w3: Integer
    Body: {
        MIDI_UMP_DecodeWord0(w0)
        UMPPkt.w1 = w1
        UMPPkt.w2 = w2
        UMPPkt.w3 = w3
        IfCondition EqualTo(UMPPkt.mt, 4) ThenBlock: {
            UMPPkt.note = UMPPkt.d1
            UMPPkt.attr_t = UMPPkt.d2
            UMPPkt.vel16 = BitwiseAnd(Divide(w1, 65536), 65535)
            UMPPkt.attr = BitwiseAnd(w1, 65535)
            UMPPkt.cc32 = w1
        }
    }
}

Function.MIDI_UMP_FromMIDI1 {
    Input: group: Integer
    Input: status: Integer
    Input: d1: Integer
    Input: d2: Integer
    Output: Integer
    Body: {
        rt = MIDI_IsRealtime(status)
        IfCondition EqualTo(rt, 1) ThenBlock: {
            w = MIDI_UMP_PackSystem(group, status, 0, 0)
            UMPPkt.w0 = w
            UMPPkt.nwords = 1
            UMPPkt.mt = 1
            ReturnValue(w)
        }
        IfCondition GreaterEqual(status, 240) ThenBlock: {
            w = MIDI_UMP_PackSystem(group, status, d1, d2)
            UMPPkt.w0 = w
            UMPPkt.nwords = 1
            UMPPkt.mt = 1
            ReturnValue(w)
        }
        w = MIDI_UMP_PackMIDI1(group, status, d1, d2)
        UMPPkt.w0 = w
        UMPPkt.w1 = 0
        UMPPkt.nwords = 1
        UMPPkt.mt = 2
        UMPPkt.status = status
        UMPPkt.d1 = d1
        UMPPkt.d2 = d2
        ReturnValue(w)
    }
}

Function.MIDI_UMP_ToMIDI1 {
    Output: Integer
    Body: {
        IfCondition EqualTo(UMPPkt.mt, 2) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(UMPPkt.mt, 1) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(UMPPkt.mt, 4) ThenBlock: {
            hi = BitwiseAnd(UMPPkt.status, 240)
            IfCondition EqualTo(hi, 144) ThenBlock: {
                UMPPkt.d1 = UMPPkt.note
                UMPPkt.d2 = MIDI_UMP_Scale16to7(UMPPkt.vel16)
                ReturnValue(1)
            }
            IfCondition EqualTo(hi, 128) ThenBlock: {
                UMPPkt.d1 = UMPPkt.note
                UMPPkt.d2 = MIDI_UMP_Scale16to7(UMPPkt.vel16)
                ReturnValue(1)
            }
            IfCondition EqualTo(hi, 176) ThenBlock: {
                UMPPkt.d2 = Divide(UMPPkt.cc32, 33554432)
                ReturnValue(1)
            }
            IfCondition EqualTo(hi, 192) ThenBlock: {
                UMPPkt.d1 = BitwiseAnd(Divide(UMPPkt.w1, 16777216), 127)
                UMPPkt.d2 = 0
                ReturnValue(1)
            }
            ReturnValue(1)
        }
        ReturnValue(0)
    }
}

Function.MIDI_UMP_FromEvent {
    Input: ev: Address
    Input: group: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(ev, 0) ThenBlock: { ReturnValue(0) }
        kind = MIDI_EvKind(ev)
        st = MIDI_EvStatus(ev)
        d1 = MIDI_EvD1(ev)
        d2 = MIDI_EvD2(ev)
        IfCondition EqualTo(kind, MIDIKind.CHANNEL) ThenBlock: {
            w = MIDI_UMP_FromMIDI1(group, st, d1, d2)
            ReturnValue(w)
        }
        IfCondition EqualTo(kind, MIDIKind.REALTIME) ThenBlock: {
            w = MIDI_UMP_PackSystem(group, st, 0, 0)
            UMPPkt.w0 = w
            UMPPkt.nwords = 1
            ReturnValue(w)
        }
        ReturnValue(0)
    }
}

Function.MIDI_UMP_PackSysex7 {
    Input: group: Integer
    Input: status: Integer
    Input: data: Address
    Input: n: Integer
    Output: Integer
    Body: {
        g = BitwiseAnd(group, 15)
        cnt = n
        IfCondition GreaterThan(cnt, 6) ThenBlock: { cnt = 6 }
        w0 = ShiftLeft(3, 28)
        w0 = Add(w0, ShiftLeft(g, 24))
        w0 = Add(w0, ShiftLeft(BitwiseAnd(status, 15), 20))
        w0 = Add(w0, ShiftLeft(cnt, 16))
        b0 = 0
        b1 = 0
        IfCondition GreaterThan(n, 0) ThenBlock: { b0 = GetByte(data, 0) }
        IfCondition GreaterThan(n, 1) ThenBlock: { b1 = GetByte(data, 1) }
        w0 = Add(w0, ShiftLeft(b0, 8))
        w0 = Add(w0, b1)
        w1 = 0
        IfCondition GreaterThan(n, 2) ThenBlock: { w1 = Add(w1, ShiftLeft(GetByte(data, 2), 24)) }
        IfCondition GreaterThan(n, 3) ThenBlock: { w1 = Add(w1, ShiftLeft(GetByte(data, 3), 16)) }
        IfCondition GreaterThan(n, 4) ThenBlock: { w1 = Add(w1, ShiftLeft(GetByte(data, 4), 8)) }
        IfCondition GreaterThan(n, 5) ThenBlock: { w1 = Add(w1, GetByte(data, 5)) }
        UMPPkt.w0 = w0
        UMPPkt.w1 = w1
        UMPPkt.nwords = 2
        UMPPkt.mt = 3
        ReturnValue(w0)
    }
}

Function.MIDI_UMP_StreamInit {
    Body: {
        UMPStream.need = 0
        UMPStream.have = 0
        UMPStream.w0 = 0
        UMPStream.w1 = 0
        UMPStream.w2 = 0
        UMPStream.w3 = 0
    }
}

Function.MIDI_UMP_StreamFeed {
    Input: word: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(UMPStream.need, 0) ThenBlock: {
            mt = BitwiseAnd(Divide(word, 268435456), 15)
            UMPStream.need = MIDI_UMP_WordCount(mt)
            UMPStream.have = 0
        }
        IfCondition EqualTo(UMPStream.have, 0) ThenBlock: { UMPStream.w0 = word }
        IfCondition EqualTo(UMPStream.have, 1) ThenBlock: { UMPStream.w1 = word }
        IfCondition EqualTo(UMPStream.have, 2) ThenBlock: { UMPStream.w2 = word }
        IfCondition EqualTo(UMPStream.have, 3) ThenBlock: { UMPStream.w3 = word }
        UMPStream.have = Add(UMPStream.have, 1)
        IfCondition GreaterEqual(UMPStream.have, UMPStream.need) ThenBlock: {
            MIDI_UMP_Decode(UMPStream.w0, UMPStream.w1, UMPStream.w2, UMPStream.w3)
            UMPStream.need = 0
            UMPStream.have = 0
            ReturnValue(1)
        }
        ReturnValue(0)
    }
}

Function.MIDI_UMP_MT {
    Output: Integer
    Body: { ReturnValue(UMPPkt.mt) }
}

Function.MIDI_UMP_Group {
    Output: Integer
    Body: { ReturnValue(UMPPkt.group) }
}

Function.MIDI_UMP_Status {
    Output: Integer
    Body: { ReturnValue(UMPPkt.status) }
}

Function.MIDI_UMP_D1 {
    Output: Integer
    Body: { ReturnValue(UMPPkt.d1) }
}

Function.MIDI_UMP_D2 {
    Output: Integer
    Body: { ReturnValue(UMPPkt.d2) }
}

Function.MIDI_UMP_W0 {
    Output: Integer
    Body: { ReturnValue(UMPPkt.w0) }
}

Function.MIDI_UMP_W1 {
    Output: Integer
    Body: { ReturnValue(UMPPkt.w1) }
}

Function.MIDI_UMP_NWords {
    Output: Integer
    Body: { ReturnValue(UMPPkt.nwords) }
}

Function.MIDI_UMP_Vel16 {
    Output: Integer
    Body: { ReturnValue(UMPPkt.vel16) }
}
