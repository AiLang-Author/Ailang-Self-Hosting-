// Library.MediaClock.ailang
// Single authoritative clock for the entire media stack.
//
// Two clock sources:
//   MediaClock_HWTimeNS() — AUTHORITATIVE. Derived from ALSA samples_out.
//     The audio hardware crystal oscillator drives this. Every time ALSA's
//     WRITEI_FRAMES ioctl returns, the hardware DMA has consumed exactly
//     period_size samples. hw_time = samples_out * 1e9 / 48000. Rock solid.
//     All frame presentation and A/V sync decisions use this clock.
//
//   MediaClock_NowNS() — REFERENCE ONLY. CLOCK_MONOTONIC_RAW (raw TSC).
//     Used solely for drift detection: HWTimeNS vs NowNS shows crystal-vs-TSC
//     divergence. Never used for scheduling.
//
// Copyright 2026 Sean Collins, 2 Paws Machine and Engineering. SCSL.

// =============================================================================
// SYSCALL CONSTANTS
// =============================================================================
FixedPool.ClockSys {
    "SYS_CLOCK_GETTIME": Initialize=228
    "CLOCK_MONOTONIC_RAW": Initialize=4
}

// =============================================================================
// STATE
// =============================================================================
FixedPool.MediaClockState {
    "origin_ns":      Initialize=0
    "sample_rate":    Initialize=48000
    "samples_out":    Initialize=0
    "initialized":    Initialize=0
    "ts_buf":         Initialize=0
}

// =============================================================================
// INIT — record origin, allocate reusable timespec buffer
// =============================================================================
Function.MediaClock_Init {
    Body: {
        ts = Allocate(16)
        MediaClockState.ts_buf = ts
        SystemCall(ClockSys.SYS_CLOCK_GETTIME, ClockSys.CLOCK_MONOTONIC_RAW, ts)
        sec = Dereference(ts)
        ns  = Dereference(Add(ts, 8))
        MediaClockState.origin_ns   = Add(Multiply(sec, 1000000000), ns)
        MediaClockState.samples_out = 0
        MediaClockState.initialized = 1
        PrintMessage("[MediaClock] Init: origin_ns=")
        PrintNumber(MediaClockState.origin_ns)
        PrintMessage("\n")
    }
}

// =============================================================================
// NOW — nanoseconds elapsed since MediaClock_Init
// Hot path: called every tick. Reuses pre-allocated ts_buf.
// =============================================================================
Function.MediaClock_NowNS {
    Output: Integer
    Body: {
        ts = MediaClockState.ts_buf
        SystemCall(ClockSys.SYS_CLOCK_GETTIME, ClockSys.CLOCK_MONOTONIC_RAW, ts)
        sec = Dereference(ts)
        ns  = Dereference(Add(ts, 8))
        raw = Add(Multiply(sec, 1000000000), ns)
        ReturnValue(Subtract(raw, MediaClockState.origin_ns))
    }
}

// =============================================================================
// AUDIO POSITION — where the audio hardware is in nanoseconds
// Called by the audio engine after each period write.
// =============================================================================
Function.MediaClock_SetSamplesOut {
    Input: samples: Integer
    Body: {
        MediaClockState.samples_out = samples
    }
}

Function.MediaClock_AudioNS {
    Output: Integer
    Body: {
        // samples_out * 1_000_000_000 / sample_rate
        // Multiply first to preserve precision, sample_rate=48000
        ReturnValue(Divide(Multiply(MediaClockState.samples_out, 1000000000), MediaClockState.sample_rate))
    }
}

// =============================================================================
// HW TIME — THE AUTHORITATIVE CLOCK
// Derived from audio hardware crystal via samples_out count.
// Every ALSA period completion (IRQ-driven) advances samples_out by period_size.
// This is the only clock used for frame scheduling and A/V sync.
// Identical calculation to AudioNS but named for clarity of intent.
// =============================================================================
Function.MediaClock_HWTimeNS {
    Output: Integer
    Body: {
        ReturnValue(Divide(Multiply(MediaClockState.samples_out, 1000000000), MediaClockState.sample_rate))
    }
}

// =============================================================================
// DRIFT CHECK — difference between hardware clock and wall clock.
// Monitors audio crystal vs CPU TSC divergence.
// Positive = HW ahead of wall. Negative = HW behind wall.
// Used for diagnostics only — never for scheduling.
// =============================================================================
Function.MediaClock_DriftNS {
    Output: Integer
    Body: {
        wall = MediaClock_NowNS()
        hw   = MediaClock_HWTimeNS()
        ReturnValue(Subtract(hw, wall))
    }
}

// =============================================================================
// PTS CONVERT — container PTS to absolute nanoseconds
// pts:       presentation timestamp in container timebase units
// timebase:  denominator (e.g. 90000 for MPEG, 48000 for audio)
// session_start_ns: value of MediaClock_NowNS() at session start
// =============================================================================
Function.MediaClock_PTStoNS {
    Input: session_start_ns: Integer
    Input: pts:              Integer
    Input: timebase:         Integer
    Output: Integer
    Body: {
        // pts_ns = (pts * 1_000_000_000) / timebase
        pts_ns = Divide(Multiply(pts, 1000000000), timebase)
        ReturnValue(Add(session_start_ns, pts_ns))
    }
}

// =============================================================================
// SHUTDOWN — free timespec buffer
// =============================================================================
Function.MediaClock_Shutdown {
    Body: {
        ts = MediaClockState.ts_buf
        IfCondition NotEqual(ts, 0) ThenBlock: {
            Deallocate(ts, 16)
            MediaClockState.ts_buf = 0
        }
        MediaClockState.initialized = 0
    }
}
