// Library.Opcode.ailang
// Opcode16: InstID = (family<<8)|member. Names come from loadable JSON
// (opcode16.json) plus interned bank/MIDI strings. No hardcoded kind names.
//
// Copyright 2026 Sean Collins, 2 Paws Machine and Engineering. SCSL.

LibraryImport.JSON

FixedPool.OpSys {
    "SYS_READ":  Initialize=0
    "SYS_OPEN":  Initialize=2
    "SYS_CLOSE": Initialize=3
    "O_RDONLY":  Initialize=0
}

FixedPool.OpFam {
    "KIT": Initialize=33
}

FixedPool.OpOff {
    "ID":   Initialize=0
    "NAME": Initialize=8
    "SIZE": Initialize=16
}

FixedPool.OpG {
    "ok":    Initialize=0, CanChange=True
    "tab":   Initialize=0, CanChange=True
    "n":     Initialize=0, CanChange=True
    "cap":   Initialize=0, CanChange=True
    "gm":    Initialize=0, CanChange=True
    "kit":   Initialize=0, CanChange=True
}

Function.Opcode_Pack {
    Input: family: Integer
    Input: member: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(family, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(member, 0) ThenBlock: { ReturnValue(0) }
        hi = BitwiseAnd(family, 255)
        lo = BitwiseAnd(member, 255)
        ReturnValue(Add(Multiply(hi, 256), lo))
    }
}

Function.Opcode_Family {
    Input: id: Integer
    Output: Integer
    Body: {
        ReturnValue(BitwiseAnd(Divide(id, 256), 255))
    }
}

Function.Opcode_Member {
    Input: id: Integer
    Output: Integer
    Body: {
        ReturnValue(BitwiseAnd(id, 255))
    }
}

Function.Opcode_Add {
    Input: id: Integer
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(id, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(OpG.tab, 0) ThenBlock: {
            OpG.cap = 256
            OpG.tab = Allocate(Multiply(256, OpOff.SIZE))
            MemorySet(OpG.tab, 0, Multiply(256, OpOff.SIZE))
            OpG.n = 0
        }
        IfCondition GreaterEqual(OpG.n, OpG.cap) ThenBlock: { ReturnValue(0) }
        r = Add(OpG.tab, Multiply(OpG.n, OpOff.SIZE))
        StoreValue(r, id)
        StoreValue(Add(r, OpOff.NAME), name)
        OpG.n = Add(OpG.n, 1)
        ReturnValue(id)
    }
}

Function.Opcode_NameEq {
    Input: a: Address
    Input: b: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(a, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(b, 0) ThenBlock: { ReturnValue(0) }
        i = 0
        WhileLoop LessThan(i, 64) {
            ca = GetByte(a, i)
            cb = GetByte(b, i)
            IfCondition NotEqual(ca, cb) ThenBlock: { ReturnValue(0) }
            IfCondition EqualTo(ca, 0) ThenBlock: { ReturnValue(1) }
            i = Add(i, 1)
        }
        ReturnValue(1)
    }
}

Function.Opcode_Find {
    Input: name: Address
    Output: Integer
    Body: {
        Opcode_Init()
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }
        i = 0
        WhileLoop LessThan(i, OpG.n) {
            r = Add(OpG.tab, Multiply(i, OpOff.SIZE))
            nm = Dereference(Add(r, OpOff.NAME))
            eq = Opcode_NameEq(nm, name)
            IfCondition EqualTo(eq, 1) ThenBlock: {
                ReturnValue(Dereference(r))
            }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

Function.Opcode_NameOf {
    Input: id: Integer
    Output: Address
    Body: {
        Opcode_Init()
        i = 0
        WhileLoop LessThan(i, OpG.n) {
            r = Add(OpG.tab, Multiply(i, OpOff.SIZE))
            IfCondition EqualTo(Dereference(r), id) ThenBlock: {
                ReturnValue(Dereference(Add(r, OpOff.NAME)))
            }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

Function.Opcode_CopyName {
    Input: src: Address
    Output: Address
    Body: {
        IfCondition EqualTo(src, 0) ThenBlock: { ReturnValue(0) }
        n = StringLength(src)
        IfCondition LessThan(n, 1) ThenBlock: { ReturnValue(0) }
        dst = Allocate(Add(n, 1))
        MemoryCopy(dst, src, n)
        SetByte(dst, n, 0)
        ReturnValue(dst)
    }
}

Function.Opcode_SlotGet {
    Input: tab: Address
    Input: prog: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(tab, 0) ThenBlock: { ReturnValue(0) }
        p = BitwiseAnd(prog, 127)
        ReturnValue(Dereference(Add(tab, Multiply(p, 8))))
    }
}

Function.Opcode_SlotSet {
    Input: tab: Address
    Input: prog: Integer
    Input: id: Integer
    Body: {
        IfCondition EqualTo(tab, 0) ThenBlock: { ReturnValue(0) }
        p = BitwiseAnd(prog, 127)
        StoreValue(Add(tab, Multiply(p, 8)), id)
    }
}

Function.Opcode_FromGM {
    Input: prog: Integer
    Output: Integer
    Body: {
        Opcode_Init()
        id = Opcode_SlotGet(OpG.gm, prog)
        ReturnValue(id)
    }
}

Function.Opcode_FromKit {
    Input: prog: Integer
    Output: Integer
    Body: {
        Opcode_Init()
        id = Opcode_SlotGet(OpG.kit, prog)
        ReturnValue(id)
    }
}

Function.Opcode_FromSF2 {
    Input: sfbank: Integer
    Input: prog: Integer
    Output: Integer
    Body: {
        id = 0
        IfCondition EqualTo(sfbank, 128) ThenBlock: {
            id = Opcode_FromKit(prog)
            ReturnValue(id)
        }
        id = Opcode_FromGM(prog)
        ReturnValue(id)
    }
}

Function.Opcode_LoadObj {
    Input: obj: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(obj, 0) ThenBlock: { ReturnValue(0) }
        fam = JSON.GetNumber(obj, "family")
        mem = JSON.GetNumber(obj, "member")
        nm = JSON.GetString(obj, "name")
        id = 0
        IfCondition And(NotEqual(fam, 0), NotEqual(mem, 0)) ThenBlock: {
            id = Opcode_Pack(fam, mem)
        }
        IfCondition EqualTo(id, 0) ThenBlock: {
            IfCondition NotEqual(nm, 0) ThenBlock: {
                id = Opcode_Find(nm)
            }
        }
        IfCondition And(NotEqual(id, 0), NotEqual(nm, 0)) ThenBlock: {
            own = Opcode_CopyName(nm)
            Opcode_Add(id, own)
        }
        ReturnValue(id)
    }
}

Function.Opcode_LoadArr {
    Input: root: Address
    Input: key: Address
    Input: slot: Address
    Output: Integer
    Body: {
        arr = JSON.GetArray(root, key)
        IfCondition EqualTo(arr, 0) ThenBlock: { ReturnValue(0) }
        n = JSON.ArrayLength(arr)
        i = 0
        c = 0
        WhileLoop LessThan(i, n) {
            tagged = JSON.ArrayGet(arr, i)
            obj = JSON.AsObject(tagged)
            id = Opcode_LoadObj(obj)
            IfCondition NotEqual(id, 0) ThenBlock: {
                IfCondition NotEqual(slot, 0) ThenBlock: {
                    prog = JSON.GetNumber(obj, "prog")
                    Opcode_SlotSet(slot, prog, id)
                }
                c = Add(c, 1)
            }
            i = Add(i, 1)
        }
        ReturnValue(c)
    }
}

Function.Opcode_LoadJson {
    Input: path: Address
    Output: Integer
    Body: {
        Opcode_Init()
        IfCondition GreaterThan(OpG.n, 0) ThenBlock: { ReturnValue(OpG.n) }
        IfCondition EqualTo(path, 0) ThenBlock: { ReturnValue(0) }
        fd = SystemCall(OpSys.SYS_OPEN, path, OpSys.O_RDONLY, 0)
        IfCondition LessThan(fd, 0) ThenBlock: { ReturnValue(0) }
        cap = 65536
        buf = Allocate(cap)
        MemorySet(buf, 0, cap)
        n = SystemCall(OpSys.SYS_READ, fd, buf, Subtract(cap, 1))
        SystemCall(OpSys.SYS_CLOSE, fd)
        IfCondition LessThan(n, 8) ThenBlock: {
            Deallocate(buf, cap)
            ReturnValue(0)
        }
        SetByte(buf, n, 0)
        root_t = ParseJSON(buf)
        root = JSON.AsObject(root_t)
        nr = Opcode_LoadArr(root, "registry", 0)
        ng = Opcode_LoadArr(root, "gm", OpG.gm)
        nk = Opcode_LoadArr(root, "kit", OpG.kit)
        PrintMessage("opcode16 json registry=")
        PrintNumber(nr)
        PrintMessage(" gm=")
        PrintNumber(ng)
        PrintMessage(" kit=")
        PrintNumber(nk)
        PrintMessage("\n")
        Deallocate(buf, cap)
        ReturnValue(Add(nr, ng))
    }
}

Function.Opcode_Init {
    Body: {
        IfCondition EqualTo(OpG.ok, 1) ThenBlock: { ReturnValue(0) }
        OpG.ok = 1
        OpG.gm = Allocate(1024)
        MemorySet(OpG.gm, 0, 1024)
        OpG.kit = Allocate(1024)
        MemorySet(OpG.kit, 0, 1024)
    }
}
