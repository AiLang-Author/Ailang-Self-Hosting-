// Library.SF2.ailang
// SoundFont 2: mmap/read RIFF, build sample handles + key/vel regions.
//
// Bank handle (96 bytes):
//   0  magic
//   8  file buf (owned)
//   16 buflen
//   24 samples ptr
//   32 nsamp
//   40 regions ptr  (64 bytes each)
//   48 nreg
//   56 presets ptr  (32 bytes each: bank, prog, lo, n)
//   64 npreset
//
// Region (64 bytes): sample, key/vel, root, mode, sf2 bank, program
//
// Copyright 2026 Sean Collins, 2 Paws Machine and Engineering. SCSL.

LibraryImport.Media.Sample
LibraryImport.Media.Opcode

FixedPool.SF2Off {
    "MAGIC": Initialize=0
    "BUF":   Initialize=8
    "LEN":   Initialize=16
    "SMPS":  Initialize=24
    "NS":    Initialize=32
    "REGS":  Initialize=40
    "NR":    Initialize=48
    "PRES":  Initialize=56
    "NP":    Initialize=64
    "SIZE":  Initialize=96
}

FixedPool.SF2Reg {
    "SMP":   Initialize=0
    "LOKEY": Initialize=8
    "HIKEY": Initialize=9
    "LOVEL": Initialize=10
    "HIVEL": Initialize=11
    "ROOT":  Initialize=16
    "MODE":  Initialize=24
    "BANK":  Initialize=32
    "PROG":  Initialize=40
    "COARSE": Initialize=48
    "FINE":  Initialize=56
    "ATTEN": Initialize=64
    "SCALE": Initialize=72
    "FC":    Initialize=80
    "Q":     Initialize=88
    "E2F":   Initialize=96
    "SIZE":  Initialize=104
}

FixedPool.SF2P {
    "BANK": Initialize=0
    "PROG": Initialize=8
    "LO":   Initialize=16
    "N":    Initialize=24
    "INST": Initialize=32
    "SIZE": Initialize=40
}

FixedPool.SF2B {
    "buf":      Initialize=0, CanChange=True
    "smps":     Initialize=0, CanChange=True
    "nsh":      Initialize=0, CanChange=True
    "regs":     Initialize=0, CanChange=True
    "nreg":     Initialize=0, CanChange=True
    "rcap":     Initialize=0, CanChange=True
    "pres":     Initialize=0, CanChange=True
    "np":       Initialize=0, CanChange=True
    "pcap":     Initialize=0, CanChange=True
    "cur_bank": Initialize=0, CanChange=True
    "cur_prog": Initialize=0, CanChange=True
    "cur_klo":  Initialize=0, CanChange=True
    "cur_khi":  Initialize=127, CanChange=True
    "cur_vlo":  Initialize=0, CanChange=True
    "cur_vhi":  Initialize=127, CanChange=True
    "cur_smp":    Initialize=0, CanChange=True
    "cur_root":   Initialize=60, CanChange=True
    "cur_coarse": Initialize=0, CanChange=True
    "cur_fine":   Initialize=0, CanChange=True
    "last_root":  Initialize=60, CanChange=True
    "last_coarse": Initialize=0, CanChange=True
    "last_fine":  Initialize=0, CanChange=True
    "last_atten": Initialize=0, CanChange=True
    "last_scale": Initialize=100, CanChange=True
    "cur_atten":  Initialize=0, CanChange=True
    "cur_scale":  Initialize=100, CanChange=True
    "cur_fc":     Initialize=13500, CanChange=True
    "cur_q":      Initialize=0, CanChange=True
    "last_fc":    Initialize=13500, CanChange=True
    "last_q":     Initialize=0, CanChange=True
    "cur_e2f":    Initialize=0, CanChange=True
    "last_e2f":   Initialize=0, CanChange=True
    "cur_mode":   Initialize=0, CanChange=True
    "last_mode":  Initialize=0, CanChange=True
    "nth":        Initialize=0, CanChange=True
}

FixedPool.SF2Sys {
    "SYS_READ":  Initialize=0
    "SYS_OPEN":  Initialize=2
    "SYS_CLOSE": Initialize=3
    "SYS_LSEEK": Initialize=8
}

FixedPool.SF2Const {
    "MAGIC": Initialize=1397112370
}

Function.SF2_U16 {
    Input: buf: Address
    Input: off: Integer
    Output: Integer
    Body: {
        lo = GetByte(buf, off)
        hi = GetByte(buf, Add(off, 1))
        ReturnValue(Add(lo, Multiply(hi, 256)))
    }
}

Function.SF2_U32 {
    Input: buf: Address
    Input: off: Integer
    Output: Integer
    Body: {
        a = SF2_U16(buf, off)
        b = SF2_U16(buf, Add(off, 2))
        ReturnValue(Add(a, Multiply(b, 65536)))
    }
}

Function.SF2_Match4 {
    Input: buf: Address
    Input: pos: Integer
    Input: a: Integer
    Input: b: Integer
    Input: c: Integer
    Input: d: Integer
    Output: Integer
    Body: {
        IfCondition NotEqual(GetByte(buf, pos), a) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(GetByte(buf, Add(pos, 1)), b) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(GetByte(buf, Add(pos, 2)), c) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(GetByte(buf, Add(pos, 3)), d) ThenBlock: { ReturnValue(0) }
        ReturnValue(1)
    }
}

Function.SF2_FindChunk {
    Input: buf: Address
    Input: len: Integer
    Input: a: Integer
    Input: b: Integer
    Input: c: Integer
    Input: d: Integer
    Output: Integer
    Body: {
        pos = 12
        WhileLoop LessThan(pos, Subtract(len, 8)) {
            hit = SF2_Match4(buf, pos, a, b, c, d)
            IfCondition EqualTo(hit, 1) ThenBlock: { ReturnValue(pos) }
            islist = SF2_Match4(buf, pos, 76, 73, 83, 84)
            clen = SF2_U32(buf, Add(pos, 4))
            IfCondition EqualTo(islist, 1) ThenBlock: {
                sub = Add(pos, 12)
                endp = Add(Add(pos, 8), clen)
                WhileLoop LessThan(sub, Subtract(endp, 8)) {
                    hit2 = SF2_Match4(buf, sub, a, b, c, d)
                    IfCondition EqualTo(hit2, 1) ThenBlock: { ReturnValue(sub) }
                    slen = SF2_U32(buf, Add(sub, 4))
                    sub = Add(Add(sub, 8), slen)
                    IfCondition EqualTo(Modulo(slen, 2), 1) ThenBlock: { sub = Add(sub, 1) }
                }
            }
            pos = Add(Add(pos, 8), clen)
            IfCondition EqualTo(Modulo(clen, 2), 1) ThenBlock: { pos = Add(pos, 1) }
        }
        ReturnValue(-1)
    }
}

Function.SF2_RegGrow {
    Output: Integer
    Body: {
        IfCondition LessThan(SF2B.nreg, SF2B.rcap) ThenBlock: { ReturnValue(1) }
        ncap = Multiply(SF2B.rcap, 2)
        IfCondition LessThan(ncap, 256) ThenBlock: { ncap = 256 }
        nsz = Multiply(ncap, SF2Reg.SIZE)
        nr = Allocate(nsz)
        IfCondition EqualTo(nr, 0) ThenBlock: { ReturnValue(0) }
        MemorySet(nr, 0, nsz)
        IfCondition And(NotEqual(SF2B.regs, 0), GreaterThan(SF2B.nreg, 0)) ThenBlock: {
            osz = Multiply(SF2B.nreg, SF2Reg.SIZE)
            MemoryCopy(nr, SF2B.regs, osz)
            Deallocate(SF2B.regs, Multiply(SF2B.rcap, SF2Reg.SIZE))
        }
        SF2B.regs = nr
        SF2B.rcap = ncap
        ReturnValue(1)
    }
}

Function.SF2_PresGrow {
    Output: Integer
    Body: {
        IfCondition LessThan(SF2B.np, SF2B.pcap) ThenBlock: { ReturnValue(1) }
        ncap = Multiply(SF2B.pcap, 2)
        IfCondition LessThan(ncap, 64) ThenBlock: { ncap = 64 }
        nsz = Multiply(ncap, SF2P.SIZE)
        np = Allocate(nsz)
        IfCondition EqualTo(np, 0) ThenBlock: { ReturnValue(0) }
        MemorySet(np, 0, nsz)
        IfCondition And(NotEqual(SF2B.pres, 0), GreaterThan(SF2B.np, 0)) ThenBlock: {
            osz = Multiply(SF2B.np, SF2P.SIZE)
            MemoryCopy(np, SF2B.pres, osz)
            Deallocate(SF2B.pres, Multiply(SF2B.pcap, SF2P.SIZE))
        }
        SF2B.pres = np
        SF2B.pcap = ncap
        ReturnValue(1)
    }
}

Function.SF2_EmitRegion {
    Output: Integer
    Body: {
        IfCondition EqualTo(SF2B.cur_smp, 0) ThenBlock: { ReturnValue(0) }
        ok = SF2_RegGrow()
        IfCondition EqualTo(ok, 0) ThenBlock: { ReturnValue(0) }
        r = Add(SF2B.regs, Multiply(SF2B.nreg, SF2Reg.SIZE))
        StoreValue(r, SF2B.cur_smp)
        SetByte(r, SF2Reg.LOKEY, SF2B.cur_klo)
        SetByte(r, SF2Reg.HIKEY, SF2B.cur_khi)
        SetByte(r, SF2Reg.LOVEL, SF2B.cur_vlo)
        SetByte(r, SF2Reg.HIVEL, SF2B.cur_vhi)
        root = 60
        IfCondition NotEqual(SF2B.cur_smp, 0) ThenBlock: {
            root = Dereference(Add(SF2B.cur_smp, 32))
        }
        StoreValue(Add(r, SF2Reg.ROOT), SF2B.cur_root)
        StoreValue(Add(r, SF2Reg.BANK), SF2B.cur_bank)
        StoreValue(Add(r, SF2Reg.PROG), SF2B.cur_prog)
        StoreValue(Add(r, SF2Reg.COARSE), SF2B.cur_coarse)
        StoreValue(Add(r, SF2Reg.FINE), SF2B.cur_fine)
        StoreValue(Add(r, SF2Reg.ATTEN), SF2B.cur_atten)
        StoreValue(Add(r, SF2Reg.SCALE), SF2B.cur_scale)
        StoreValue(Add(r, SF2Reg.FC), SF2B.cur_fc)
        StoreValue(Add(r, SF2Reg.Q), SF2B.cur_q)
        StoreValue(Add(r, SF2Reg.E2F), SF2B.cur_e2f)
        StoreValue(Add(r, SF2Reg.MODE), SF2B.cur_mode)
        SF2B.nreg = Add(SF2B.nreg, 1)
        ReturnValue(1)
    }
}

Function.SF2_FallbackRegs {
    Body: {
        nsh = SF2B.nsh
        smps = SF2B.smps
        ri = 0
        WhileLoop LessThan(ri, nsh) {
            SF2B.cur_smp = Dereference(Add(smps, Multiply(ri, 8)))
            SF2B.cur_klo = 0
            SF2B.cur_khi = 127
            SF2B.cur_vlo = 0
            SF2B.cur_vhi = 127
            SF2B.cur_bank = 0
            SF2B.cur_prog = 0
            SF2B.cur_coarse = 0
            SF2B.cur_fine = 0
            SF2B.cur_atten = 0
            SF2B.cur_scale = 100
            SF2B.cur_fc = 13500
            SF2B.cur_q = 0
            SF2B.cur_e2f = 0
            SF2B.cur_root = 60
            IfCondition NotEqual(SF2B.cur_smp, 0) ThenBlock: {
                SF2B.cur_root = Dereference(Add(SF2B.cur_smp, 32))
                SF2B.cur_fine = Dereference(Add(SF2B.cur_smp, 80))
            }
            SF2_EmitRegion()
            ri = Add(ri, 1)
        }
    }
}

Function.SF2_S16 {
    Input: am: Integer
    Output: Integer
    Body: {
        IfCondition GreaterEqual(am, 32768) ThenBlock: {
            ReturnValue(Subtract(am, 65536))
        }
        ReturnValue(am)
    }
}

Function.SF2_S32 {
    Input: am: Integer
    Output: Integer
    Body: {
        IfCondition GreaterEqual(am, 2147483648) ThenBlock: {
            ReturnValue(Subtract(am, 4294967296))
        }
        ReturnValue(am)
    }
}

Function.SF2_Max {
    Input: a: Integer
    Input: b: Integer
    Output: Integer
    Body: {
        IfCondition GreaterThan(a, b) ThenBlock: { ReturnValue(a) }
        ReturnValue(b)
    }
}

Function.SF2_Min {
    Input: a: Integer
    Input: b: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(a, b) ThenBlock: { ReturnValue(a) }
        ReturnValue(b)
    }
}

Function.SF2_BuildPdta {
    Input: buf: Address
    Input: sz: Integer
    Body: {
        phdr_at = SF2_FindChunk(buf, sz, 112, 104, 100, 114)
        pbag_at = SF2_FindChunk(buf, sz, 112, 98, 97, 103)
        pgen_at = SF2_FindChunk(buf, sz, 112, 103, 101, 110)
        inst_at = SF2_FindChunk(buf, sz, 105, 110, 115, 116)
        ibag_at = SF2_FindChunk(buf, sz, 105, 98, 97, 103)
        igen_at = SF2_FindChunk(buf, sz, 105, 103, 101, 110)
        IfCondition LessThan(phdr_at, 0) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(pbag_at, 0) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(pgen_at, 0) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(inst_at, 0) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(ibag_at, 0) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(igen_at, 0) ThenBlock: { ReturnValue(0) }
        phdr_len = SF2_U32(buf, Add(phdr_at, 4))
        pbag_len = SF2_U32(buf, Add(pbag_at, 4))
        pgen_len = SF2_U32(buf, Add(pgen_at, 4))
        inst_len = SF2_U32(buf, Add(inst_at, 4))
        ibag_len = SF2_U32(buf, Add(ibag_at, 4))
        igen_len = SF2_U32(buf, Add(igen_at, 4))
        nphdr = Subtract(Divide(phdr_len, 38), 1)
        ninst = Subtract(Divide(inst_len, 22), 1)
        npbag = Divide(pbag_len, 4)
        nibag = Divide(ibag_len, 4)
        npgen = Divide(pgen_len, 4)
        nigen = Divide(igen_len, 4)
        IfCondition LessThan(nphdr, 1) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(ninst, 1) ThenBlock: { ReturnValue(0) }
        phdr = Add(buf, Add(phdr_at, 8))
        pbag = Add(buf, Add(pbag_at, 8))
        pgen = Add(buf, Add(pgen_at, 8))
        inst = Add(buf, Add(inst_at, 8))
        ibag = Add(buf, Add(ibag_at, 8))
        igen = Add(buf, Add(igen_at, 8))
        pi = 0
        WhileLoop LessThan(pi, nphdr) {
            rec = Add(phdr, Multiply(pi, 38))
            nxt = Add(rec, 38)
            prog = SF2_U16(rec, 20)
            bankv = SF2_U16(rec, 22)
            bag0 = SF2_U16(rec, 24)
            bag1 = SF2_U16(nxt, 24)
            IfCondition GreaterThan(bag1, npbag) ThenBlock: { bag1 = npbag }
            okp = SF2_PresGrow()
            IfCondition EqualTo(okp, 0) ThenBlock: { ReturnValue(0) }
            pr = Add(SF2B.pres, Multiply(SF2B.np, SF2P.SIZE))
            StoreValue(pr, bankv)
            StoreValue(Add(pr, SF2P.PROG), prog)
            StoreValue(Add(pr, SF2P.LO), SF2B.nreg)
            iid = Opcode_FromSF2(bankv, prog)
            StoreValue(Add(pr, SF2P.INST), iid)
            start_reg = SF2B.nreg
            gklo = 0
            gkhi = 127
            gvlo = 0
            gvhi = 127
            g_coarse = 32767
            g_fine = 32767
            g_atten = 32767
            g_scale = 32767
            g_fc = 32767
            g_q = 32767
            g_e2f = 32767
            g_has_kr = 0
            g_has_vr = 0
            seen_i = 0
            b = bag0
            WhileLoop LessThan(b, bag1) {
                g0 = SF2_U16(pbag, Multiply(b, 4))
                nb = Add(b, 1)
                g1 = npgen
                IfCondition LessThan(nb, npbag) ThenBlock: {
                    g1 = SF2_U16(pbag, Multiply(nb, 4))
                }
                inst_idx = -1
                plo = 0
                phi = 127
                pvlo = 0
                pvhi = 127
                p_coarse = 32767
                p_fine = 32767
                p_atten = 32767
                p_scale = 32767
                p_fc = 32767
                p_q = 32767
                p_e2f = 32767
                p_has_kr = 0
                p_has_vr = 0
                g = g0
                WhileLoop LessThan(g, g1) {
                    goff = Multiply(g, 4)
                    op = SF2_U16(pgen, goff)
                    am = SF2_U16(pgen, Add(goff, 2))
                    IfCondition EqualTo(op, 41) ThenBlock: { inst_idx = am }
                    IfCondition EqualTo(op, 43) ThenBlock: {
                        plo = BitwiseAnd(am, 255)
                        phi = Divide(am, 256)
                        p_has_kr = 1
                    }
                    IfCondition EqualTo(op, 44) ThenBlock: {
                        pvlo = BitwiseAnd(am, 255)
                        pvhi = Divide(am, 256)
                        p_has_vr = 1
                    }
                    IfCondition EqualTo(op, 8) ThenBlock: { p_fc = SF2_S16(am) }
                    IfCondition EqualTo(op, 9) ThenBlock: { p_q = SF2_S16(am) }
                    IfCondition EqualTo(op, 11) ThenBlock: { p_e2f = SF2_S16(am) }
                    IfCondition EqualTo(op, 48) ThenBlock: { p_atten = SF2_S16(am) }
                    IfCondition EqualTo(op, 51) ThenBlock: { p_fine = SF2_S16(am) }
                    IfCondition EqualTo(op, 52) ThenBlock: { p_coarse = SF2_S16(am) }
                    IfCondition EqualTo(op, 56) ThenBlock: { p_scale = am }
                    g = Add(g, 1)
                }
                IfCondition EqualTo(p_has_kr, 0) ThenBlock: {
                    plo = gklo
                    phi = gkhi
                }
                IfCondition EqualTo(p_has_vr, 0) ThenBlock: {
                    pvlo = gvlo
                    pvhi = gvhi
                }
                IfCondition LessThan(inst_idx, 0) ThenBlock: {
                    IfCondition EqualTo(seen_i, 0) ThenBlock: {
                        gklo = plo
                        gkhi = phi
                        gvlo = pvlo
                        gvhi = pvhi
                        g_coarse = p_coarse
                        g_fine = p_fine
                        g_atten = p_atten
                        g_scale = p_scale
                        g_fc = p_fc
                        g_q = p_q
                        g_e2f = p_e2f
                        g_has_kr = p_has_kr
                        g_has_vr = p_has_vr
                    }
                } ElseBlock: {
                    seen_i = 1
                    IfCondition LessThan(inst_idx, ninst) ThenBlock: {
                        irec = Add(inst, Multiply(inst_idx, 22))
                        ib0 = SF2_U16(irec, 20)
                        inxt = Add(irec, 22)
                        ib1 = SF2_U16(inxt, 20)
                        IfCondition GreaterThan(ib1, nibag) ThenBlock: { ib1 = nibag }
                        iklo = 0
                        ikhi = 127
                        ivlo = 0
                        ivhi = 127
                        i_coarse = 32767
                        i_fine = 32767
                        i_atten = 32767
                        i_scale = 32767
                        i_fc = 32767
                        i_q = 32767
                        i_e2f = 32767
                        i_mode = 32767
                        i_oroot = 255
                        i_has_kr = 0
                        i_has_vr = 0
                        seen_s = 0
                        ib = ib0
                        WhileLoop LessThan(ib, ib1) {
                            ig0 = SF2_U16(ibag, Multiply(ib, 4))
                            nib = Add(ib, 1)
                            ig1 = nigen
                            IfCondition LessThan(nib, nibag) ThenBlock: {
                                ig1 = SF2_U16(ibag, Multiply(nib, 4))
                            }
                            sid = -1
                            zlo = 0
                            zhi = 127
                            zvlo = 0
                            zvhi = 127
                            z_coarse = 32767
                            z_fine = 32767
                            z_atten = 32767
                            z_scale = 32767
                            z_fc = 32767
                            z_q = 32767
                            z_e2f = 32767
                            z_mode = 32767
                            z_oroot = 255
                            z_has_kr = 0
                            z_has_vr = 0
                            ig = ig0
                            WhileLoop LessThan(ig, ig1) {
                                ioff = Multiply(ig, 4)
                                op2 = SF2_U16(igen, ioff)
                                am2 = SF2_U16(igen, Add(ioff, 2))
                                IfCondition EqualTo(op2, 53) ThenBlock: { sid = am2 }
                                IfCondition EqualTo(op2, 54) ThenBlock: { z_mode = am2 }
                                IfCondition EqualTo(op2, 43) ThenBlock: {
                                    zlo = BitwiseAnd(am2, 255)
                                    zhi = Divide(am2, 256)
                                    z_has_kr = 1
                                }
                                IfCondition EqualTo(op2, 44) ThenBlock: {
                                    zvlo = BitwiseAnd(am2, 255)
                                    zvhi = Divide(am2, 256)
                                    z_has_vr = 1
                                }
                                IfCondition EqualTo(op2, 8) ThenBlock: { z_fc = SF2_S16(am2) }
                                IfCondition EqualTo(op2, 9) ThenBlock: { z_q = SF2_S16(am2) }
                                IfCondition EqualTo(op2, 11) ThenBlock: { z_e2f = SF2_S16(am2) }
                                IfCondition EqualTo(op2, 48) ThenBlock: { z_atten = SF2_S16(am2) }
                                IfCondition EqualTo(op2, 51) ThenBlock: { z_fine = SF2_S16(am2) }
                                IfCondition EqualTo(op2, 52) ThenBlock: { z_coarse = SF2_S16(am2) }
                                IfCondition EqualTo(op2, 56) ThenBlock: { z_scale = am2 }
                                IfCondition EqualTo(op2, 58) ThenBlock: { z_oroot = am2 }
                                ig = Add(ig, 1)
                            }
                            IfCondition EqualTo(z_has_kr, 0) ThenBlock: {
                                zlo = iklo
                                zhi = ikhi
                            }
                            IfCondition EqualTo(z_has_vr, 0) ThenBlock: {
                                zvlo = ivlo
                                zvhi = ivhi
                            }
                            IfCondition LessThan(sid, 0) ThenBlock: {
                                IfCondition EqualTo(seen_s, 0) ThenBlock: {
                                    iklo = zlo
                                    ikhi = zhi
                                    ivlo = zvlo
                                    ivhi = zvhi
                                    i_coarse = z_coarse
                                    i_fine = z_fine
                                    i_atten = z_atten
                                    i_scale = z_scale
                                    i_fc = z_fc
                                    i_q = z_q
                                    i_e2f = z_e2f
                                    i_mode = z_mode
                                    i_oroot = z_oroot
                                    i_has_kr = z_has_kr
                                    i_has_vr = z_has_vr
                                }
                            } ElseBlock: {
                                seen_s = 1
                                IfCondition LessThan(sid, SF2B.nsh) ThenBlock: {
                                    klo = SF2_Max(zlo, plo)
                                    khi = SF2_Min(zhi, phi)
                                    vlo = SF2_Max(zvlo, pvlo)
                                    vhi = SF2_Min(zvhi, pvhi)
                                    IfCondition LessEqual(klo, khi) ThenBlock: {
                                        IfCondition LessEqual(vlo, vhi) ThenBlock: {
                                            smp = Dereference(Add(SF2B.smps, Multiply(sid, 8)))
                                            SF2B.cur_smp = smp
                                            SF2B.cur_klo = klo
                                            SF2B.cur_khi = khi
                                            SF2B.cur_vlo = vlo
                                            SF2B.cur_vhi = vhi
                                            SF2B.cur_bank = bankv
                                            SF2B.cur_prog = prog
                                            rt = 60
                                            IfCondition NotEqual(smp, 0) ThenBlock: {
                                                rt = Dereference(Add(smp, 32))
                                            }
                                            IfCondition NotEqual(i_oroot, 255) ThenBlock: { rt = i_oroot }
                                            IfCondition NotEqual(z_oroot, 255) ThenBlock: { rt = z_oroot }
                                            SF2B.cur_root = rt
                                            pc = 0
                                            IfCondition NotEqual(g_coarse, 32767) ThenBlock: { pc = g_coarse }
                                            IfCondition NotEqual(p_coarse, 32767) ThenBlock: { pc = Add(pc, p_coarse) }
                                            ic = 0
                                            IfCondition NotEqual(i_coarse, 32767) ThenBlock: { ic = i_coarse }
                                            IfCondition NotEqual(z_coarse, 32767) ThenBlock: { ic = z_coarse }
                                            SF2B.cur_coarse = Add(pc, ic)
                                            pf = 0
                                            IfCondition NotEqual(g_fine, 32767) ThenBlock: { pf = g_fine }
                                            IfCondition NotEqual(p_fine, 32767) ThenBlock: { pf = Add(pf, p_fine) }
                                            zf = 0
                                            IfCondition NotEqual(i_fine, 32767) ThenBlock: { zf = i_fine }
                                            IfCondition NotEqual(z_fine, 32767) ThenBlock: { zf = z_fine }
                                            fn = Add(pf, zf)
                                            IfCondition NotEqual(smp, 0) ThenBlock: {
                                                pcents = Dereference(Add(smp, 80), "dword")
                                                pcents = SF2_S32(pcents)
                                                fn = Add(fn, pcents)
                                            }
                                            SF2B.cur_fine = fn
                                            pa = p_atten
                                            IfCondition EqualTo(pa, 32767) ThenBlock: { pa = g_atten }
                                            IfCondition EqualTo(pa, 32767) ThenBlock: { pa = 0 }
                                            ia = z_atten
                                            IfCondition EqualTo(ia, 32767) ThenBlock: { ia = i_atten }
                                            IfCondition EqualTo(ia, 32767) ThenBlock: { ia = 0 }
                                            atn = Add(pa, ia)
                                            IfCondition LessThan(atn, 0) ThenBlock: { atn = 0 }
                                            SF2B.cur_atten = atn
                                            zs = 100
                                            IfCondition NotEqual(i_scale, 32767) ThenBlock: { zs = i_scale }
                                            IfCondition NotEqual(z_scale, 32767) ThenBlock: { zs = z_scale }
                                            ps = 0
                                            IfCondition NotEqual(g_scale, 32767) ThenBlock: { ps = g_scale }
                                            IfCondition NotEqual(p_scale, 32767) ThenBlock: { ps = p_scale }
                                            SF2B.cur_scale = Add(zs, ps)
                                            zfc = 13500
                                            IfCondition NotEqual(i_fc, 32767) ThenBlock: { zfc = i_fc }
                                            IfCondition NotEqual(z_fc, 32767) ThenBlock: { zfc = z_fc }
                                            pfc = 0
                                            IfCondition NotEqual(g_fc, 32767) ThenBlock: { pfc = g_fc }
                                            IfCondition NotEqual(p_fc, 32767) ThenBlock: { pfc = p_fc }
                                            SF2B.cur_fc = Add(zfc, pfc)
                                            zq = 0
                                            IfCondition NotEqual(i_q, 32767) ThenBlock: { zq = i_q }
                                            IfCondition NotEqual(z_q, 32767) ThenBlock: { zq = z_q }
                                            pq = 0
                                            IfCondition NotEqual(g_q, 32767) ThenBlock: { pq = g_q }
                                            IfCondition NotEqual(p_q, 32767) ThenBlock: { pq = p_q }
                                            SF2B.cur_q = Add(zq, pq)
                                            ze = 0
                                            IfCondition NotEqual(i_e2f, 32767) ThenBlock: { ze = i_e2f }
                                            IfCondition NotEqual(z_e2f, 32767) ThenBlock: { ze = z_e2f }
                                            pe = 0
                                            IfCondition NotEqual(g_e2f, 32767) ThenBlock: { pe = g_e2f }
                                            IfCondition NotEqual(p_e2f, 32767) ThenBlock: { pe = p_e2f }
                                            SF2B.cur_e2f = Add(ze, pe)
                                            md = 0
                                            IfCondition NotEqual(i_mode, 32767) ThenBlock: { md = i_mode }
                                            IfCondition NotEqual(z_mode, 32767) ThenBlock: { md = z_mode }
                                            IfCondition EqualTo(md, 3) ThenBlock: { md = 1 }
                                            SF2B.cur_mode = md
                                            IfCondition EqualTo(md, 1) ThenBlock: {
                                                IfCondition NotEqual(smp, 0) ThenBlock: {
                                                    l0 = Dereference(Add(smp, 40))
                                                    l1 = Dereference(Add(smp, 48))
                                                    Smp_SetLoop(smp, l0, l1, 1)
                                                }
                                            }
                                            SF2_EmitRegion()
                                        }
                                    }
                                }
                            }
                            ib = Add(ib, 1)
                        }
                    }
                }
                b = Add(b, 1)
            }
            StoreValue(Add(pr, SF2P.N), Subtract(SF2B.nreg, start_reg))
            SF2B.np = Add(SF2B.np, 1)
            pi = Add(pi, 1)
        }
    }
}

Function.SF2_Load {
    Input: path: Address
    Output: Address
    Body: {
        fd = SystemCall(SF2Sys.SYS_OPEN, path, 0, 0)
        IfCondition LessThan(fd, 0) ThenBlock: { ReturnValue(0) }
        sz = SystemCall(SF2Sys.SYS_LSEEK, fd, 0, 2)
        SystemCall(SF2Sys.SYS_LSEEK, fd, 0, 0)
        IfCondition LessThan(sz, 64) ThenBlock: {
            SystemCall(SF2Sys.SYS_CLOSE, fd)
            ReturnValue(0)
        }
        buf = Allocate(sz)
        IfCondition EqualTo(buf, 0) ThenBlock: {
            SystemCall(SF2Sys.SYS_CLOSE, fd)
            ReturnValue(0)
        }
        SystemCall(SF2Sys.SYS_READ, fd, buf, sz)
        SystemCall(SF2Sys.SYS_CLOSE, fd)
        IfCondition NotEqual(GetByte(buf, 0), 82) ThenBlock: {
            Deallocate(buf, sz)
            ReturnValue(0)
        }
        smpl_at = SF2_FindChunk(buf, sz, 115, 109, 112, 108)
        shdr_at = SF2_FindChunk(buf, sz, 115, 104, 100, 114)
        IfCondition LessThan(shdr_at, 0) ThenBlock: {
            Deallocate(buf, sz)
            ReturnValue(0)
        }
        IfCondition LessThan(smpl_at, 0) ThenBlock: {
            Deallocate(buf, sz)
            ReturnValue(0)
        }
        smpl = Add(buf, Add(smpl_at, 8))
        shdr_len = SF2_U32(buf, Add(shdr_at, 4))
        nsh = Divide(shdr_len, 46)
        IfCondition GreaterThan(nsh, 0) ThenBlock: { nsh = Subtract(nsh, 1) }
        IfCondition LessThan(nsh, 1) ThenBlock: {
            Deallocate(buf, sz)
            ReturnValue(0)
        }
        smps = Allocate(Multiply(nsh, 8))
        MemorySet(smps, 0, Multiply(nsh, 8))
        si = 0
        WhileLoop LessThan(si, nsh) {
            rec = Add(Add(buf, Add(shdr_at, 8)), Multiply(si, 46))
            st = SF2_U32(rec, 20)
            en = SF2_U32(rec, 24)
            ls = SF2_U32(rec, 28)
            le = SF2_U32(rec, 32)
            rate = SF2_U32(rec, 36)
            root = GetByte(rec, 40)
            pc = GetByte(rec, 41)
            IfCondition GreaterThan(pc, 127) ThenBlock: { pc = Subtract(pc, 256) }
            typ = SF2_U16(rec, 44)
            nfr = Subtract(en, st)
            IfCondition LessThan(nfr, 1) ThenBlock: { nfr = 1 }
            pcm = Add(smpl, Multiply(st, 2))
            h = Smp_New(pcm, nfr, rate, root, 0)
            StoreValue(Add(h, 80), pc, "dword")
            Smp_SetLoop(h, Subtract(ls, st), Subtract(le, st), 0)
            StoreValue(Add(smps, Multiply(si, 8)), h)
            si = Add(si, 1)
        }
        si = 0
        WhileLoop LessThan(si, nsh) {
            rec = Add(Add(buf, Add(shdr_at, 8)), Multiply(si, 46))
            link = SF2_U16(rec, 42)
            IfCondition And(NotEqual(link, 0), LessThan(link, nsh)) ThenBlock: {
                IfCondition NotEqual(link, si) ThenBlock: {
                    lo = si
                    hi = link
                    IfCondition GreaterThan(si, link) ThenBlock: {
                        lo = link
                        hi = si
                    }
                    hl = Dereference(Add(smps, Multiply(lo, 8)))
                    hr = Dereference(Add(smps, Multiply(hi, 8)))
                    IfCondition And(NotEqual(hl, 0), NotEqual(hr, 0)) ThenBlock: {
                        rpcm = Dereference(Add(hr, 8))
                        Smp_SetRight(hl, rpcm)
                        SetByte(hr, 86, 1)
                    }
                }
            }
            si = Add(si, 1)
        }
        SF2B.buf = buf
        SF2B.smps = smps
        SF2B.nsh = nsh
        SF2B.regs = 0
        SF2B.nreg = 0
        SF2B.rcap = 0
        SF2B.pres = 0
        SF2B.np = 0
        SF2B.pcap = 0
        SF2_BuildPdta(buf, sz)
        IfCondition EqualTo(SF2B.nreg, 0) ThenBlock: {
            SF2_FallbackRegs()
        }
        bank = Allocate(SF2Off.SIZE)
        MemorySet(bank, 0, SF2Off.SIZE)
        StoreValue(bank, SF2Const.MAGIC)
        StoreValue(Add(bank, SF2Off.BUF), buf)
        StoreValue(Add(bank, SF2Off.LEN), sz)
        StoreValue(Add(bank, SF2Off.SMPS), smps)
        StoreValue(Add(bank, SF2Off.NS), nsh)
        StoreValue(Add(bank, SF2Off.REGS), SF2B.regs)
        StoreValue(Add(bank, SF2Off.NR), SF2B.nreg)
        StoreValue(Add(bank, SF2Off.PRES), SF2B.pres)
        StoreValue(Add(bank, SF2Off.NP), SF2B.np)
        ReturnValue(bank)
    }
}

Function.SF2_MatchZone {
    Input: r: Address
    Input: note: Integer
    Input: vel: Integer
    Output: Address
    Body: {
        IfCondition EqualTo(r, 0) ThenBlock: { ReturnValue(0) }
        smp0 = Dereference(r)
        IfCondition NotEqual(smp0, 0) ThenBlock: {
            IfCondition EqualTo(GetByte(smp0, 86), 1) ThenBlock: { ReturnValue(0) }
        }
        lo = GetByte(r, SF2Reg.LOKEY)
        hi = GetByte(r, SF2Reg.HIKEY)
        lv = GetByte(r, SF2Reg.LOVEL)
        hv = GetByte(r, SF2Reg.HIVEL)
        IfCondition EqualTo(hv, 0) ThenBlock: { hv = 127 }
        IfCondition GreaterThan(lv, hv) ThenBlock: {
            lv = 0
            hv = 127
        }
        IfCondition LessThan(note, lo) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterThan(note, hi) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(vel, lv) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterThan(vel, hv) ThenBlock: { ReturnValue(0) }
        ReturnValue(Dereference(r))
    }
}

Function.SF2_Abs {
    Input: x: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(x, 0) ThenBlock: { ReturnValue(Subtract(0, x)) }
        ReturnValue(x)
    }
}

Function.SF2_LastRoot {
    Output: Integer
    Body: { ReturnValue(SF2B.last_root) }
}

Function.SF2_LastCoarse {
    Output: Integer
    Body: { ReturnValue(SF2B.last_coarse) }
}

Function.SF2_LastFine {
    Output: Integer
    Body: { ReturnValue(SF2B.last_fine) }
}

Function.SF2_LastAtten {
    Output: Integer
    Body: { ReturnValue(SF2B.last_atten) }
}

