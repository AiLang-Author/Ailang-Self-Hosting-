Function.SF2_SetNth {
    Input: n: Integer
    Body: { SF2B.nth = n }
}

Function.SF2_LookupI {
    Input: bank: Address
    Input: note: Integer
    Input: vel: Integer
    Input: instid: Integer
    Output: Address
    Body: {
        IfCondition EqualTo(bank, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(instid, 0) ThenBlock: { ReturnValue(0) }
        nr = Dereference(Add(bank, SF2Off.NR))
        regs = Dereference(Add(bank, SF2Off.REGS))
        IfCondition EqualTo(regs, 0) ThenBlock: { ReturnValue(0) }
        np = Dereference(Add(bank, SF2Off.NP))
        pres = Dereference(Add(bank, SF2Off.PRES))
        nth = SF2B.nth
        lo = 0
        n = 0
        pi = 0
        WhileLoop LessThan(pi, np) {
            pr = Add(pres, Multiply(pi, SF2P.SIZE))
            iid = Dereference(Add(pr, SF2P.INST))
            IfCondition EqualTo(iid, instid) ThenBlock: {
                lo = Dereference(Add(pr, SF2P.LO))
                n = Dereference(Add(pr, SF2P.N))
                pi = np
            }
            pi = Add(pi, 1)
        }
        seen = 0
        i = 0
        WhileLoop LessThan(i, n) {
            ri = Add(lo, i)
            IfCondition LessThan(ri, nr) ThenBlock: {
                r = Add(regs, Multiply(ri, SF2Reg.SIZE))
                hit = SF2_MatchZone(r, note, vel)
                IfCondition NotEqual(hit, 0) ThenBlock: {
                    IfCondition EqualTo(seen, nth) ThenBlock: {
                        SF2B.last_root = Dereference(Add(r, SF2Reg.ROOT))
                        SF2B.last_coarse = Dereference(Add(r, SF2Reg.COARSE))
                        SF2B.last_fine = Dereference(Add(r, SF2Reg.FINE))
                        SF2B.last_atten = Dereference(Add(r, SF2Reg.ATTEN))
                        SF2B.last_scale = Dereference(Add(r, SF2Reg.SCALE))
                        SF2B.last_fc = Dereference(Add(r, SF2Reg.FC))
                        SF2B.last_q = Dereference(Add(r, SF2Reg.Q))
                        SF2B.last_e2f = Dereference(Add(r, SF2Reg.E2F))
                        SF2B.last_mode = Dereference(Add(r, SF2Reg.MODE))
                        ReturnValue(hit)
                    }
                    seen = Add(seen, 1)
                }
            }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

Function.SF2_LookupP {
    Input: bank: Address
    Input: note: Integer
    Input: vel: Integer
    Input: prog: Integer
    Input: sfbank: Integer
    Output: Address
    Body: {
        iid = Opcode_FromSF2(sfbank, prog)
        IfCondition NotEqual(iid, 0) ThenBlock: {
            hit = SF2_LookupI(bank, note, vel, iid)
            IfCondition NotEqual(hit, 0) ThenBlock: { ReturnValue(hit) }
        }
        IfCondition EqualTo(bank, 0) ThenBlock: { ReturnValue(0) }
        nr = Dereference(Add(bank, SF2Off.NR))
        regs = Dereference(Add(bank, SF2Off.REGS))
        IfCondition EqualTo(regs, 0) ThenBlock: { ReturnValue(0) }
        np = Dereference(Add(bank, SF2Off.NP))
        pres = Dereference(Add(bank, SF2Off.PRES))
        want_p = BitwiseAnd(prog, 127)
        want_b = sfbank
        nth = SF2B.nth
        lo = 0
        n = nr
        IfCondition GreaterThan(np, 0) ThenBlock: {
            n = 0
            pi = 0
            WhileLoop LessThan(pi, np) {
                pr = Add(pres, Multiply(pi, SF2P.SIZE))
                pb = Dereference(pr)
                pp = Dereference(Add(pr, SF2P.PROG))
                IfCondition EqualTo(pb, want_b) ThenBlock: {
                    IfCondition EqualTo(pp, want_p) ThenBlock: {
                        lo = Dereference(Add(pr, SF2P.LO))
                        n = Dereference(Add(pr, SF2P.N))
                        pi = np
                    }
                }
                pi = Add(pi, 1)
            }
        }
        seen = 0
        i = 0
        WhileLoop LessThan(i, n) {
            ri = Add(lo, i)
            IfCondition LessThan(ri, nr) ThenBlock: {
                r = Add(regs, Multiply(ri, SF2Reg.SIZE))
                hit = SF2_MatchZone(r, note, vel)
                IfCondition NotEqual(hit, 0) ThenBlock: {
                    IfCondition EqualTo(seen, nth) ThenBlock: {
                        SF2B.last_root = Dereference(Add(r, SF2Reg.ROOT))
                        SF2B.last_coarse = Dereference(Add(r, SF2Reg.COARSE))
                        SF2B.last_fine = Dereference(Add(r, SF2Reg.FINE))
                        SF2B.last_atten = Dereference(Add(r, SF2Reg.ATTEN))
                        SF2B.last_scale = Dereference(Add(r, SF2Reg.SCALE))
                        SF2B.last_fc = Dereference(Add(r, SF2Reg.FC))
                        SF2B.last_q = Dereference(Add(r, SF2Reg.Q))
                        SF2B.last_e2f = Dereference(Add(r, SF2Reg.E2F))
                        SF2B.last_mode = Dereference(Add(r, SF2Reg.MODE))
                        ReturnValue(hit)
                    }
                    seen = Add(seen, 1)
                }
            }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

Function.SF2_Lookup {
    Input: bank: Address
    Input: note: Integer
    Input: vel: Integer
    Output: Address
    Body: {
        s = SF2_LookupP(bank, note, vel, 0, 0)
        IfCondition NotEqual(s, 0) ThenBlock: { ReturnValue(s) }
        IfCondition EqualTo(bank, 0) ThenBlock: { ReturnValue(0) }
        nr = Dereference(Add(bank, SF2Off.NR))
        regs = Dereference(Add(bank, SF2Off.REGS))
        IfCondition And(GreaterThan(nr, 0), NotEqual(regs, 0)) ThenBlock: {
            ReturnValue(Dereference(regs))
        }
        ReturnValue(0)
    }
}

Function.SF2_PresetCount {
    Input: bank: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(bank, 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(Dereference(Add(bank, SF2Off.NP)))
    }
}

Function.SF2_Count {
    Input: bank: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(bank, 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(Dereference(Add(bank, SF2Off.NS)))
    }
}

Function.SF2_RegionCount {
    Input: bank: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(bank, 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(Dereference(Add(bank, SF2Off.NR)))
    }
}
