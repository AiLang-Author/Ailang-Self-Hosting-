// Library.Sample.ailang
// Sample buffer + pitched playback. WAV load for S0; SF2 slices reuse the same handle.
//
// Handle (80 bytes):
//   0  magic
//   8  pcm ptr (s16 mono)
//   16 nframes
//   24 rate
//   32 root key
//   40 loopstart
//   48 loopend
//   56 mode  0=one-shot  1=loop
//   64 own   1=free pcm on Sample_Free
//   72 name
//
// Copyright 2026 Sean Collins, 2 Paws Machine and Engineering. SCSL.

FixedPool.SmpOff {
    "MAGIC":  Initialize=0
    "PCM":    Initialize=8
    "N":      Initialize=16
    "RATE":   Initialize=24
    "ROOT":   Initialize=32
    "LS":     Initialize=40
    "LE":     Initialize=48
    "MODE":   Initialize=56
    "OWN":    Initialize=64
    "PCMR":   Initialize=72
    "CENTS":  Initialize=80
    "SKIP":   Initialize=86
    "SIZE":   Initialize=88
}

FixedPool.SmpSys {
    "SYS_READ":  Initialize=0
    "SYS_OPEN":  Initialize=2
    "SYS_CLOSE": Initialize=3
    "SYS_LSEEK": Initialize=8
    "O_RDONLY":  Initialize=0
    "SEEK_END":  Initialize=2
    "SEEK_SET":  Initialize=0
}

FixedPool.SmpConst {
    "MAGIC": Initialize=1397572944
}

Function.Smp_U16 {
    Input: buf: Address
    Input: off: Integer
    Output: Integer
    Body: {
        lo = GetByte(buf, off)
        hi = GetByte(buf, Add(off, 1))
        ReturnValue(Add(lo, Multiply(hi, 256)))
    }
}

Function.Smp_U32 {
    Input: buf: Address
    Input: off: Integer
    Output: Integer
    Body: {
        a = Smp_U16(buf, off)
        b = Smp_U16(buf, Add(off, 2))
        ReturnValue(Add(a, Multiply(b, 65536)))
    }
}

Function.Smp_S16 {
    Input: pcm: Address
    Input: frame: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(frame, 0) ThenBlock: { ReturnValue(0) }
        off = Multiply(frame, 2)
        lo = GetByte(pcm, off)
        hi = GetByte(pcm, Add(off, 1))
        u = Add(lo, Multiply(hi, 256))
        IfCondition GreaterThan(u, 32767) ThenBlock: { u = Subtract(u, 65536) }
        ReturnValue(u)
    }
}

Function.Smp_New {
    Input: pcm: Address
    Input: n: Integer
    Input: rate: Integer
    Input: root: Integer
    Input: own: Integer
    Output: Address
    Body: {
        h = Allocate(SmpOff.SIZE)
        IfCondition EqualTo(h, 0) ThenBlock: { ReturnValue(0) }
        MemorySet(h, 0, SmpOff.SIZE)
        StoreValue(h, SmpConst.MAGIC)
        StoreValue(Add(h, SmpOff.PCM), pcm)
        StoreValue(Add(h, SmpOff.N), n)
        StoreValue(Add(h, SmpOff.RATE), rate)
        StoreValue(Add(h, SmpOff.ROOT), root)
        StoreValue(Add(h, SmpOff.LS), 0)
        StoreValue(Add(h, SmpOff.LE), n)
        StoreValue(Add(h, SmpOff.MODE), 0)
        StoreValue(Add(h, SmpOff.OWN), own)
        StoreValue(Add(h, SmpOff.PCMR), 0)
        StoreValue(Add(h, SmpOff.CENTS), 0)
        SetByte(h, SmpOff.SKIP, 0)
        ReturnValue(h)
    }
}

Function.Smp_SetRight {
    Input: h: Address
    Input: pcmr: Address
    Body: {
        IfCondition EqualTo(h, 0) ThenBlock: { ReturnValue(0) }
        StoreValue(Add(h, SmpOff.PCMR), pcmr)
    }
}

Function.Smp_JoinHeld {
    Input: atk: Address
    Input: held: Address
    Output: Address
    Body: {
        IfCondition EqualTo(atk, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(held, 0) ThenBlock: { ReturnValue(atk) }
        n0 = Dereference(Add(atk, SmpOff.N))
        n1 = Dereference(Add(held, SmpOff.N))
        n = Add(n0, n1)
        IfCondition LessThan(n, 2) ThenBlock: { ReturnValue(atk) }
        nbytes = Multiply(n, 2)
        pcm = Allocate(nbytes)
        MemorySet(pcm, 0, nbytes)
        p0 = Dereference(Add(atk, SmpOff.PCM))
        p1 = Dereference(Add(held, SmpOff.PCM))
        IfCondition NotEqual(p0, 0) ThenBlock: {
            MemoryCopy(pcm, p0, Multiply(n0, 2))
        }
        IfCondition NotEqual(p1, 0) ThenBlock: {
            MemoryCopy(Add(pcm, Multiply(n0, 2)), p1, Multiply(n1, 2))
        }
        rt = 60
        h = Smp_New(pcm, n, 48000, rt, 1)
        IfCondition EqualTo(h, 0) ThenBlock: { ReturnValue(atk) }
        Smp_SetLoop(h, n0, n, 1)
        ReturnValue(h)
    }
}

Function.Smp_HasRight {
    Input: h: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(h, 0) ThenBlock: { ReturnValue(0) }
        r = Dereference(Add(h, SmpOff.PCMR))
        IfCondition EqualTo(r, 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(1)
    }
}

Function.Smp_SetLoop {
    Input: h: Address
    Input: ls: Integer
    Input: le: Integer
    Input: mode: Integer
    Body: {
        IfCondition EqualTo(h, 0) ThenBlock: { ReturnValue(0) }
        n = Dereference(Add(h, SmpOff.N))
        IfCondition LessThan(ls, 0) ThenBlock: { ls = 0 }
        IfCondition GreaterThan(le, n) ThenBlock: { le = n }
        IfCondition LessEqual(le, ls) ThenBlock: { le = n }
        StoreValue(Add(h, SmpOff.LS), ls)
        StoreValue(Add(h, SmpOff.LE), le)
        StoreValue(Add(h, SmpOff.MODE), mode)
    }
}

Function.Smp_Free {
    Input: h: Address
    Body: {
        IfCondition EqualTo(h, 0) ThenBlock: { ReturnValue(0) }
        mag = Dereference(h)
        IfCondition NotEqual(mag, SmpConst.MAGIC) ThenBlock: { ReturnValue(0) }
        own = Dereference(Add(h, SmpOff.OWN))
        pcm = Dereference(Add(h, SmpOff.PCM))
        n = Dereference(Add(h, SmpOff.N))
        IfCondition And(EqualTo(own, 1), NotEqual(pcm, 0)) ThenBlock: {
            Deallocate(pcm, Multiply(n, 2))
        }
        StoreValue(h, 0)
        Deallocate(h, SmpOff.SIZE)
    }
}

Function.Smp_LoadWav {
    Input: path: Address
    Output: Address
    Body: {
        fd = SystemCall(SmpSys.SYS_OPEN, path, SmpSys.O_RDONLY, 0)
        IfCondition LessThan(fd, 0) ThenBlock: { ReturnValue(0) }
        sz = SystemCall(SmpSys.SYS_LSEEK, fd, 0, SmpSys.SEEK_END)
        SystemCall(SmpSys.SYS_LSEEK, fd, 0, SmpSys.SEEK_SET)
        IfCondition LessThan(sz, 44) ThenBlock: {
            SystemCall(SmpSys.SYS_CLOSE, fd)
            ReturnValue(0)
        }
        buf = Allocate(sz)
        IfCondition EqualTo(buf, 0) ThenBlock: {
            SystemCall(SmpSys.SYS_CLOSE, fd)
            ReturnValue(0)
        }
        SystemCall(SmpSys.SYS_READ, fd, buf, sz)
        SystemCall(SmpSys.SYS_CLOSE, fd)
        IfCondition NotEqual(GetByte(buf, 0), 82) ThenBlock: {
            Deallocate(buf, sz)
            ReturnValue(0)
        }
        ch = 0
        rate = 0
        bits = 0
        data_off = 0
        data_n = 0
        pos = 12
        WhileLoop LessThan(pos, Subtract(sz, 8)) {
            id0 = GetByte(buf, pos)
            id1 = GetByte(buf, Add(pos, 1))
            id2 = GetByte(buf, Add(pos, 2))
            id3 = GetByte(buf, Add(pos, 3))
            clen = Smp_U32(buf, Add(pos, 4))
            IfCondition EqualTo(id0, 102) ThenBlock: {
                IfCondition EqualTo(id2, 116) ThenBlock: {
                    ch = Smp_U16(buf, Add(pos, 10))
                    rate = Smp_U32(buf, Add(pos, 12))
                    bits = Smp_U16(buf, Add(pos, 22))
                }
            }
            IfCondition EqualTo(id0, 100) ThenBlock: {
                IfCondition EqualTo(id1, 97) ThenBlock: {
                    data_off = Add(pos, 8)
                    data_n = clen
                }
            }
            pos = Add(Add(pos, 8), clen)
            IfCondition EqualTo(Modulo(clen, 2), 1) ThenBlock: { pos = Add(pos, 1) }
        }
        IfCondition EqualTo(data_n, 0) ThenBlock: {
            Deallocate(buf, sz)
            ReturnValue(0)
        }
        IfCondition EqualTo(bits, 0) ThenBlock: { bits = 16 }
        IfCondition EqualTo(rate, 0) ThenBlock: { rate = 48000 }
        IfCondition EqualTo(ch, 0) ThenBlock: { ch = 1 }
        bpf = Divide(bits, 8)
        bpf = Multiply(bpf, ch)
        IfCondition LessThan(bpf, 1) ThenBlock: { bpf = 2 }
        nframes = Divide(data_n, bpf)
        pcm = Allocate(Multiply(nframes, 2))
        MemorySet(pcm, 0, Multiply(nframes, 2))
        i = 0
        WhileLoop LessThan(i, nframes) {
            src = Add(data_off, Multiply(i, bpf))
            IfCondition EqualTo(bits, 8) ThenBlock: {
                b = GetByte(buf, src)
                s = Multiply(Subtract(b, 128), 256)
                SetByte(pcm, Multiply(i, 2), Modulo(Add(s, 65536), 256))
                SetByte(pcm, Add(Multiply(i, 2), 1), Divide(Add(s, 65536), 256))
            } ElseBlock: {
                SetByte(pcm, Multiply(i, 2), GetByte(buf, src))
                SetByte(pcm, Add(Multiply(i, 2), 1), GetByte(buf, Add(src, 1)))
            }
            i = Add(i, 1)
        }
        Deallocate(buf, sz)
        h = Smp_New(pcm, nframes, rate, 60, 1)
        ReturnValue(h)
    }
}

Function.Smp_Semi {
    Input: d: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(d, 0) ThenBlock: { ReturnValue(65536) }
        IfCondition EqualTo(d, 1) ThenBlock: { ReturnValue(69433) }
        IfCondition EqualTo(d, 2) ThenBlock: { ReturnValue(73562) }
        IfCondition EqualTo(d, 3) ThenBlock: { ReturnValue(77936) }
        IfCondition EqualTo(d, 4) ThenBlock: { ReturnValue(82570) }
        IfCondition EqualTo(d, 5) ThenBlock: { ReturnValue(87480) }
        IfCondition EqualTo(d, 6) ThenBlock: { ReturnValue(92682) }
        IfCondition EqualTo(d, 7) ThenBlock: { ReturnValue(98193) }
        IfCondition EqualTo(d, 8) ThenBlock: { ReturnValue(104032) }
        IfCondition EqualTo(d, 9) ThenBlock: { ReturnValue(110218) }
        IfCondition EqualTo(d, 10) ThenBlock: { ReturnValue(116772) }
        IfCondition EqualTo(d, 11) ThenBlock: { ReturnValue(123715) }
        ReturnValue(65536)
    }
}

Function.Smp_StepD {
    Input: h: Address
    Input: dsemi: Integer
    Input: outrate: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(h, 0) ThenBlock: { ReturnValue(0) }
        d = dsemi
        octs = 0
        WhileLoop GreaterEqual(d, 12) {
            octs = Add(octs, 1)
            d = Subtract(d, 12)
        }
        WhileLoop LessThan(d, 0) {
            octs = Subtract(octs, 1)
            d = Add(d, 12)
        }
        r16 = Smp_Semi(d)
        fsemi = Float_FromInt(r16)
        fden = Float_FromInt(65536)
        fr = Float_Div(fsemi, fden)
        two = Float_FromInt(2)
        oi = octs
        WhileLoop GreaterThan(oi, 0) {
            fr = Float_Mul(fr, two)
            oi = Subtract(oi, 1)
        }
        WhileLoop LessThan(oi, 0) {
            fr = Float_Div(fr, two)
            oi = Add(oi, 1)
        }
        stepf = Float_Mul(fr, fden)
        step = Float_ToInt(stepf)
        IfCondition LessThan(step, 1) ThenBlock: { step = 1 }
        ReturnValue(step)
    }
}

Function.Smp_Step {
    Input: h: Address
    Input: note: Integer
    Input: outrate: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(h, 0) ThenBlock: { ReturnValue(0) }
        root = Dereference(Add(h, SmpOff.ROOT))
        d = Subtract(note, root)
        st = Smp_StepD(h, d, outrate)
        ReturnValue(st)
    }
}

Function.Smp_Tick {
    Input: h: Address
    Input: ph: Integer
    Output: Integer
    Body: {
        s = Smp_TickCh(h, ph, 0)
        ReturnValue(s)
    }
}

Function.Smp_WrapIdx {
    Input: idx: Integer
    Input: ls: Integer
    Input: le: Integer
    Input: n: Integer
    Input: looping: Integer
    Output: Integer
    Body: {
        i = idx
        IfCondition EqualTo(looping, 1) ThenBlock: {
            ln = Subtract(le, ls)
            IfCondition LessThan(ln, 1) ThenBlock: { ReturnValue(ls) }
            IfCondition LessThan(i, ls) ThenBlock: { i = Add(i, ln) }
            IfCondition LessThan(i, ls) ThenBlock: { i = ls }
            IfCondition GreaterEqual(i, le) ThenBlock: {
                i = Add(ls, Modulo(Subtract(i, ls), ln))
            }
        } ElseBlock: {
            IfCondition LessThan(i, 0) ThenBlock: { i = 0 }
            IfCondition GreaterEqual(i, n) ThenBlock: { i = Subtract(n, 1) }
            IfCondition LessThan(i, 0) ThenBlock: { i = 0 }
        }
        ReturnValue(i)
    }
}

Function.Smp_TickCh {
    Input: h: Address
    Input: ph: Integer
    Input: ch: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(h, 0) ThenBlock: { ReturnValue(0) }
        pcm = Dereference(Add(h, SmpOff.PCM))
        IfCondition NotEqual(ch, 0) ThenBlock: {
            r = Dereference(Add(h, SmpOff.PCMR))
            IfCondition NotEqual(r, 0) ThenBlock: { pcm = r }
        }
        n = Dereference(Add(h, SmpOff.N))
        IfCondition EqualTo(pcm, 0) ThenBlock: { ReturnValue(0) }
        IfCondition LessEqual(n, 1) ThenBlock: { ReturnValue(0) }
        idx = Divide(ph, 65536)
        frac = Modulo(ph, 65536)
        mode = Dereference(Add(h, SmpOff.MODE))
        ls = Dereference(Add(h, SmpOff.LS))
        le = Dereference(Add(h, SmpOff.LE))
        looping = 0
        IfCondition EqualTo(mode, 1) ThenBlock: {
            IfCondition GreaterThan(le, Add(ls, 1)) ThenBlock: { looping = 1 }
        }
        lim = n
        IfCondition EqualTo(looping, 1) ThenBlock: { lim = le }
        IfCondition GreaterEqual(idx, lim) ThenBlock: {
            IfCondition EqualTo(looping, 1) ThenBlock: {
                ln = Subtract(le, ls)
                IfCondition LessThan(ln, 1) ThenBlock: { ReturnValue(0) }
                idx = Add(ls, Modulo(Subtract(idx, ls), ln))
            } ElseBlock: {
                IfCondition GreaterEqual(idx, n) ThenBlock: { ReturnValue(0) }
            }
        }
        in_loop = 0
        IfCondition EqualTo(looping, 1) ThenBlock: {
            IfCondition GreaterEqual(idx, ls) ThenBlock: { in_loop = 1 }
        }
        im = Subtract(idx, 1)
        i0 = Smp_WrapIdx(im, ls, le, n, in_loop)
        i1 = Smp_WrapIdx(idx, ls, le, n, in_loop)
        ip = Add(idx, 1)
        i2 = Smp_WrapIdx(ip, ls, le, n, in_loop)
        ip2 = Add(idx, 2)
        i3 = Smp_WrapIdx(ip2, ls, le, n, in_loop)
        s_m1 = Smp_S16(pcm, i0)
        s_0 = Smp_S16(pcm, i1)
        s_1 = Smp_S16(pcm, i2)
        s_2 = Smp_S16(pcm, i3)
        ym1 = Float_FromInt(s_m1)
        y0 = Float_FromInt(s_0)
        y1 = Float_FromInt(s_1)
        y2 = Float_FromInt(s_2)
        one = Float_FromInt(1)
        two = Float_FromInt(2)
        three = Float_FromInt(3)
        half = Float_Div(one, two)
        c = Float_Sub(y1, ym1)
        c = Float_Mul(half, c)
        t0 = Float_Mul(three, y0)
        t1 = Float_Mul(three, y1)
        a = Float_Sub(t0, ym1)
        a = Float_Sub(a, t1)
        a = Float_Add(a, y2)
        a = Float_Mul(a, half)
        five = Float_FromInt(5)
        two5 = Float_Div(five, two)
        b = Float_Mul(two5, y0)
        b = Float_Sub(ym1, b)
        ty1 = Float_Mul(two, y1)
        b = Float_Add(b, ty1)
        hy2 = Float_Mul(half, y2)
        b = Float_Sub(b, hy2)
        x = Float_FromInt(frac)
        fsc = Float_FromInt(65536)
        x = Float_Div(x, fsc)
        s = Float_Mul(a, x)
        s = Float_Add(s, b)
        s = Float_Mul(s, x)
        s = Float_Add(s, c)
        s = Float_Mul(s, x)
        s = Float_Add(s, y0)
        si = Float_ToInt(s)
        IfCondition GreaterThan(si, 32767) ThenBlock: { si = 32767 }
        IfCondition LessThan(si, -32767) ThenBlock: { si = -32767 }
        ReturnValue(si)
    }
}

Function.Smp_WrapPhase {
    Input: h: Address
    Input: ph: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(h, 0) ThenBlock: { ReturnValue(ph) }
        n = Dereference(Add(h, SmpOff.N))
        mode = Dereference(Add(h, SmpOff.MODE))
        ls = Dereference(Add(h, SmpOff.LS))
        le = Dereference(Add(h, SmpOff.LE))
        IfCondition EqualTo(mode, 1) ThenBlock: {
            IfCondition GreaterThan(le, Add(ls, 1)) ThenBlock: {
                lep = Multiply(le, 65536)
                IfCondition GreaterEqual(ph, lep) ThenBlock: {
                    ln = Subtract(le, ls)
                    span = Multiply(ln, 65536)
                    IfCondition LessThan(span, 1) ThenBlock: { ReturnValue(lep) }
                    lsp = Multiply(ls, 65536)
                    over = Subtract(ph, lep)
                    ReturnValue(Add(lsp, Modulo(over, span)))
                }
                ReturnValue(ph)
            }
        }
        maxp = Multiply(n, 65536)
        IfCondition GreaterEqual(ph, maxp) ThenBlock: { ReturnValue(maxp) }
        ReturnValue(ph)
    }
}
