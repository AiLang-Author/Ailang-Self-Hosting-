// Library.SurgePatch.ailang
// Read a Surge XT .fxp into integer patch fields and modulation routes.
// Floats in the file are converted here. The synth engine stays integer.
// The window only supplies the file path.
//
// Scene A only. Cutoff depth 65536 spans the -60..70 semitone range.
// Pitch depth is cents. Resonance depth uses the 0..240 knob.
//
// Copyright 2026 Sean Collins, 2 Paws Machine and Engineering. SCSL v1.0.

LibraryImport.Arena
LibraryImport.Media.Synth

FixedPool.SurgeG {
    "buf":     Initialize=0, CanChange=True
    "n":       Initialize=0, CanChange=True
    "num":     Initialize=0, CanChange=True
    "wave":    Initialize=0, CanChange=True
    "wave2":   Initialize=0, CanChange=True
    "oscmix":  Initialize=0, CanChange=True
    "cutoff":  Initialize=256, CanChange=True
    "res":     Initialize=0, CanChange=True
    "fenv":    Initialize=0, CanChange=True
    "atk":     Initialize=4, CanChange=True
    "dec":     Initialize=200, CanChange=True
    "sus":     Initialize=256, CanChange=True
    "rel":     Initialize=200, CanChange=True
    "typ1":    Initialize=0, CanChange=True
    "shp1":    Initialize=0, CanChange=True
    "typ2":    Initialize=0, CanChange=True
    "shp2":    Initialize=0, CanChange=True
    "cutmilli": Initialize=0, CanChange=True
    "envmod":  Initialize=0, CanChange=True
    "fatk":    Initialize=4, CanChange=True
    "fdec":    Initialize=48, CanChange=True
    "fsus":    Initialize=0, CanChange=True
    "frel":    Initialize=200, CanChange=True
    "vol":     Initialize=80, CanChange=True
    "nroute":  Initialize=0, CanChange=True
    "nskip":   Initialize=0, CanChange=True
    "ok":      Initialize=0, CanChange=True
    "r0src":   Initialize=0, CanChange=True
    "r0dst":   Initialize=0, CanChange=True
    "r0dep":   Initialize=0, CanChange=True
    "r1src":   Initialize=0, CanChange=True
    "r1dst":   Initialize=0, CanChange=True
    "r1dep":   Initialize=0, CanChange=True
}

Function.Surge_Eq {
    Input: at: Integer
    Input: lit: Address
    Output: Integer
    Body: {
        j = 0
        stop = 0
        ok = 1
        WhileLoop EqualTo(stop, 0) {
            cb = GetByte(lit, j)
            bb = GetByte(SurgeG.buf, Add(at, j))
            IfCondition EqualTo(cb, 0) ThenBlock: {
                IfCondition EqualTo(bb, 32) ThenBlock: { ReturnValue(1) }
                IfCondition EqualTo(bb, 62) ThenBlock: { ReturnValue(1) }
                ReturnValue(0)
            }
            IfCondition NotEqual(bb, cb) ThenBlock: {
                ok = 0
                stop = 1
            }
            IfCondition EqualTo(stop, 0) ThenBlock: { j = Add(j, 1) }
        }
        ReturnValue(ok)
    }
}

Function.Surge_Find {
    Input: from: Integer
    Input: lit: Address
    Output: Integer
    Body: {
        litlen = 0
        stop = 0
        WhileLoop EqualTo(stop, 0) {
            IfCondition EqualTo(GetByte(lit, litlen), 0) ThenBlock: { stop = 1 }
            IfCondition EqualTo(stop, 0) ThenBlock: { litlen = Add(litlen, 1) }
        }
        i = from
        last = Subtract(SurgeG.n, litlen)
        WhileLoop LessEqual(i, last) {
            j = 0
            ok = 1
            WhileLoop LessThan(j, litlen) {
                bb = GetByte(SurgeG.buf, Add(i, j))
                cb = GetByte(lit, j)
                IfCondition NotEqual(bb, cb) ThenBlock: { ok = 0 }
                j = Add(j, 1)
            }
            IfCondition EqualTo(ok, 1) ThenBlock: { ReturnValue(i) }
            i = Add(i, 1)
        }
        ReturnValue(-1)
    }
}

Function.Surge_ParseMilli {
    Input: at: Integer
    Output: Integer
    Body: {
        i = at
        sign = 1
        IfCondition EqualTo(GetByte(SurgeG.buf, i), 45) ThenBlock: {
            sign = -1
            i = Add(i, 1)
        }
        ip = 0
        stop = 0
        WhileLoop EqualTo(stop, 0) {
            c = GetByte(SurgeG.buf, i)
            IfCondition And(GreaterEqual(c, 48), LessEqual(c, 57)) ThenBlock: {
                ip = Add(Multiply(ip, 10), Subtract(c, 48))
                i = Add(i, 1)
            } ElseBlock: {
                stop = 1
            }
        }
        frac = 0
        places = 0
        IfCondition EqualTo(GetByte(SurgeG.buf, i), 46) ThenBlock: {
            i = Add(i, 1)
            stop = 0
            WhileLoop EqualTo(stop, 0) {
                c = GetByte(SurgeG.buf, i)
                IfCondition And(GreaterEqual(c, 48), LessEqual(c, 57)) ThenBlock: {
                    IfCondition LessThan(places, 3) ThenBlock: {
                        frac = Add(Multiply(frac, 10), Subtract(c, 48))
                        places = Add(places, 1)
                    }
                    i = Add(i, 1)
                } ElseBlock: {
                    stop = 1
                }
            }
        }
        WhileLoop LessThan(places, 3) {
            frac = Multiply(frac, 10)
            places = Add(places, 1)
        }
        milli = Add(Multiply(ip, 1000), frac)
        IfCondition LessThan(sign, 0) ThenBlock: { milli = Subtract(0, milli) }
        SurgeG.num = milli
        ReturnValue(i)
    }
}

Function.Surge_TagMilli {
    Input: tag: Address
    Output: Integer
    Body: {
        at = Surge_Find(0, tag)
        IfCondition LessThan(at, 0) ThenBlock: {
            SurgeG.num = 0
            ReturnValue(0)
        }
        v = Surge_Find(at, "value=\"")
        IfCondition LessThan(v, 0) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterThan(Subtract(v, at), 80) ThenBlock: { ReturnValue(0) }
        Surge_ParseMilli(Add(v, 7))
        ReturnValue(1)
    }
}

Function.Surge_Exp2Ms {
    Input: milli: Integer
    Output: Integer
    Body: {
        whole = Divide(milli, 1000)
        frac = Subtract(milli, Multiply(whole, 1000))
        IfCondition LessThan(whole, -16) ThenBlock: { whole = -16 }
        IfCondition GreaterThan(whole, 8) ThenBlock: { whole = 8 }
        base = 1000
        IfCondition GreaterEqual(whole, 0) ThenBlock: {
            k = 0
            WhileLoop LessThan(k, whole) {
                base = Multiply(base, 2)
                k = Add(k, 1)
            }
        } ElseBlock: {
            sh = Subtract(0, whole)
            base = Divide(1000, ShiftLeft(1, sh))
            IfCondition LessThan(base, 1) ThenBlock: { base = 1 }
        }
        scale = Add(1000000, Multiply(frac, 693))
        ms = Divide(Multiply(base, scale), 1000000)
        IfCondition LessThan(ms, 1) ThenBlock: { ms = 1 }
        IfCondition GreaterThan(ms, 8000) ThenBlock: { ms = 8000 }
        ReturnValue(ms)
    }
}

Function.Surge_WaveOf {
    Input: typ: Integer
    Input: shape: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(typ, 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(typ, 5) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(typ, 6) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(typ, 7) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(typ, 3) ThenBlock: { ReturnValue(5) }
        IfCondition EqualTo(typ, 0) ThenBlock: {
            IfCondition LessEqual(shape, -650) ThenBlock: { ReturnValue(1) }
            IfCondition LessEqual(shape, -350) ThenBlock: { ReturnValue(2) }
            ReturnValue(3)
        }
        ReturnValue(3)
    }
}

Function.Surge_Read {
    Input: path: Address
    Output: Integer
    Body: {
        fd = SystemCall(2, path, 0, 0)
        IfCondition LessThan(fd, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(SurgeG.buf, 0) ThenBlock: {
            SurgeG.buf = Allocate(400000)
        }
        IfCondition EqualTo(SurgeG.buf, 0) ThenBlock: {
            SystemCall(3, fd)
            ReturnValue(0)
        }
        MemorySet(SurgeG.buf, 0, 400000)
        n = SystemCall(0, fd, SurgeG.buf, 399000)
        SystemCall(3, fd)
        IfCondition LessThan(n, 64) ThenBlock: { ReturnValue(0) }
        SurgeG.n = n
        ReturnValue(n)
    }
}

Function.Surge_AddRoute {
    Input: src: Integer
    Input: dst: Integer
    Input: dep: Integer
    Body: {
        IfCondition LessEqual(src, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(dep, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(SurgeG.nroute, 0) ThenBlock: {
            SurgeG.r0src = src
            SurgeG.r0dst = dst
            SurgeG.r0dep = dep
        }
        IfCondition EqualTo(SurgeG.nroute, 1) ThenBlock: {
            SurgeG.r1src = src
            SurgeG.r1dst = dst
            SurgeG.r1dep = dep
        }
        Synth_RouteAdd(src, dst, dep)
        SurgeG.nroute = Add(SurgeG.nroute, 1)
    }
}

Function.Surge_OneRoute {
    Input: at: Integer
    Body: {
        p = at
        stop = 0
        WhileLoop EqualTo(stop, 0) {
            IfCondition LessEqual(p, 0) ThenBlock: { stop = 1 }
            IfCondition EqualTo(stop, 0) ThenBlock: {
                prev = Subtract(p, 1)
                IfCondition EqualTo(GetByte(SurgeG.buf, prev), 60) ThenBlock: { stop = 1 }
                IfCondition EqualTo(stop, 0) ThenBlock: { p = Subtract(p, 1) }
            }
        }
        nameAt = p
        muted = Surge_Find(at, "muted=\"1\"")
        ism = 0
        IfCondition GreaterEqual(muted, 0) ThenBlock: {
            IfCondition LessThan(Subtract(muted, at), 120) ThenBlock: { ism = 1 }
        }
        IfCondition EqualTo(ism, 1) ThenBlock: { ReturnValue(0) }
        sp = Surge_Find(at, "source=\"")
        dp = Surge_Find(at, "depth=\"")
        IfCondition LessThan(sp, 0) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterThan(Subtract(sp, at), 80) ThenBlock: { ReturnValue(0) }
        Surge_ParseMilli(Add(sp, 8))
        src = Divide(SurgeG.num, 1000)
        IfCondition LessThan(dp, 0) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterThan(Subtract(dp, at), 120) ThenBlock: { ReturnValue(0) }
        Surge_ParseMilli(Add(dp, 7))
        milli = SurgeG.num
        got = 0
        dst = 0
        dep = 0
        IfCondition EqualTo(Surge_Eq(nameAt, "a_filter1_cutoff"), 1) ThenBlock: {
            dst = 1
            dep = Divide(Multiply(milli, 65536), 130000)
            got = 1
        }
        IfCondition EqualTo(got, 0) ThenBlock: {
            IfCondition EqualTo(Surge_Eq(nameAt, "a_pitch"), 1) ThenBlock: {
                dst = 3
                dep = Divide(milli, 10)
                got = 1
            }
        }
        IfCondition EqualTo(got, 0) ThenBlock: {
            IfCondition EqualTo(Surge_Eq(nameAt, "a_filter1_resonance"), 1) ThenBlock: {
                dst = 2
                dep = Divide(Multiply(milli, 240), 1000)
                got = 1
            }
        }
        IfCondition EqualTo(got, 1) ThenBlock: {
            Surge_AddRoute(src, dst, dep)
        } ElseBlock: {
            IfCondition GreaterThan(src, 0) ThenBlock: {
                SurgeG.nskip = Add(SurgeG.nskip, 1)
            }
        }
    }
}

Function.Surge_Load {
    Input: path: Address
    Output: Integer
    Body: {
        n = Surge_Read(path)
        IfCondition LessThan(n, 64) ThenBlock: {
            PrintMessage("surge read failed\n")
            ReturnValue(0)
        }
        pat = Surge_Find(0, "<patch")
        IfCondition LessThan(pat, 0) ThenBlock: {
            PrintMessage("surge no patch\n")
            ReturnValue(0)
        }
        Surge_TagMilli("a_osc1_type")
        t1 = Divide(SurgeG.num, 1000)
        Surge_TagMilli("a_osc1_param0")
        s1 = SurgeG.num
        Surge_TagMilli("a_osc2_type")
        t2 = Divide(SurgeG.num, 1000)
        Surge_TagMilli("a_osc2_param0")
        s2 = SurgeG.num
        SurgeG.typ1 = t1
        SurgeG.shp1 = s1
        SurgeG.typ2 = t2
        SurgeG.shp2 = s2
        SurgeG.wave = Surge_WaveOf(t1, s1)
        SurgeG.wave2 = Surge_WaveOf(t2, s2)
        Surge_TagMilli("a_level_o1")
        l1 = SurgeG.num
        Surge_TagMilli("a_level_o2")
        l2 = SurgeG.num
        sm = Add(l1, l2)
        IfCondition LessThan(sm, 1) ThenBlock: { sm = 1 }
        SurgeG.oscmix = Divide(Multiply(l2, 256), sm)
        Surge_TagMilli("a_filter1_cutoff")
        SurgeG.cutmilli = SurgeG.num
        cm = Add(SurgeG.num, 60000)
        SurgeG.cutoff = Divide(Multiply(cm, 256), 130000)
        IfCondition LessThan(SurgeG.cutoff, 0) ThenBlock: { SurgeG.cutoff = 0 }
        IfCondition GreaterThan(SurgeG.cutoff, 256) ThenBlock: { SurgeG.cutoff = 256 }
        Surge_TagMilli("a_filter1_resonance")
        SurgeG.res = Divide(Multiply(SurgeG.num, 88), 1000)
        IfCondition LessThan(SurgeG.res, 0) ThenBlock: { SurgeG.res = 0 }
        IfCondition GreaterThan(SurgeG.res, 88) ThenBlock: { SurgeG.res = 88 }
        Surge_TagMilli("a_filter1_envmod")
        SurgeG.envmod = SurgeG.num
        SurgeG.fenv = 0
        Surge_TagMilli("a_env1_attack")
        SurgeG.atk = Surge_Exp2Ms(SurgeG.num)
        Surge_TagMilli("a_env1_decay")
        SurgeG.dec = Surge_Exp2Ms(SurgeG.num)
        Surge_TagMilli("a_env1_sustain")
        SurgeG.sus = Divide(Multiply(SurgeG.num, 256), 1000)
        IfCondition GreaterThan(SurgeG.sus, 256) ThenBlock: { SurgeG.sus = 256 }
        IfCondition LessThan(SurgeG.sus, 0) ThenBlock: { SurgeG.sus = 0 }
        Surge_TagMilli("a_env1_release")
        SurgeG.rel = Surge_Exp2Ms(SurgeG.num)
        Surge_TagMilli("a_env2_attack")
        SurgeG.fatk = Surge_Exp2Ms(SurgeG.num)
        Surge_TagMilli("a_env2_decay")
        SurgeG.fdec = Surge_Exp2Ms(SurgeG.num)
        Surge_TagMilli("a_env2_sustain")
        SurgeG.fsus = Divide(Multiply(SurgeG.num, 256), 1000)
        IfCondition GreaterThan(SurgeG.fsus, 256) ThenBlock: { SurgeG.fsus = 256 }
        IfCondition LessThan(SurgeG.fsus, 0) ThenBlock: { SurgeG.fsus = 0 }
        Surge_TagMilli("a_env2_release")
        SurgeG.frel = Surge_Exp2Ms(SurgeG.num)
        Surge_TagMilli("volume")
        db = SurgeG.num
        gain = 256
        IfCondition LessThan(db, 0) ThenBlock: {
            db = Subtract(0, db)
            stop = 0
            WhileLoop EqualTo(stop, 0) {
                IfCondition LessThan(db, 6020) ThenBlock: { stop = 1 }
                IfCondition LessEqual(gain, 1) ThenBlock: { stop = 1 }
                IfCondition EqualTo(stop, 0) ThenBlock: {
                    gain = Divide(gain, 2)
                    db = Subtract(db, 6020)
                }
            }
            drop = Divide(Multiply(gain, db), 6020)
            gain = Subtract(gain, drop)
        }
        IfCondition LessThan(gain, 8) ThenBlock: { gain = 8 }
        IfCondition GreaterThan(gain, 512) ThenBlock: { gain = 512 }
        SurgeG.vol = gain
        Synth_RouteClear()
        SurgeG.nroute = 0
        SurgeG.nskip = 0
        pos = pat
        stop = 0
        WhileLoop EqualTo(stop, 0) {
            f = Surge_Find(pos, "<modrouting ")
            IfCondition LessThan(f, 0) ThenBlock: { stop = 1 }
            IfCondition EqualTo(stop, 0) ThenBlock: {
                Surge_OneRoute(f)
                pos = Add(f, 12)
            }
        }
        SurgeG.ok = 1
        PrintMessage("surge ailang type=")
        PrintNumber(SurgeG.typ1)
        PrintMessage(" shape=")
        PrintNumber(SurgeG.shp1)
        PrintMessage(" wave=")
        PrintNumber(SurgeG.wave)
        PrintMessage(" type2=")
        PrintNumber(SurgeG.typ2)
        PrintMessage(" shape2=")
        PrintNumber(SurgeG.shp2)
        PrintMessage(" wave2=")
        PrintNumber(SurgeG.wave2)
        PrintMessage(" cutmilli=")
        PrintNumber(SurgeG.cutmilli)
        PrintMessage(" envmod=")
        PrintNumber(SurgeG.envmod)
        PrintMessage(" sus=")
        PrintNumber(SurgeG.sus)
        PrintMessage(" dec=")
        PrintNumber(SurgeG.dec)
        PrintMessage(" rel=")
        PrintNumber(SurgeG.rel)
        PrintMessage(" feg=")
        PrintNumber(SurgeG.fatk)
        PrintMessage(",")
        PrintNumber(SurgeG.fdec)
        PrintMessage(",")
        PrintNumber(SurgeG.fsus)
        PrintMessage(",")
        PrintNumber(SurgeG.frel)
        PrintMessage(" atk=")
        PrintNumber(SurgeG.atk)
        PrintMessage(" routes=")
        PrintNumber(SurgeG.nroute)
        PrintMessage(" skip=")
        PrintNumber(SurgeG.nskip)
        PrintMessage(" r0=")
        PrintNumber(SurgeG.r0src)
        PrintMessage(",")
        PrintNumber(SurgeG.r0dst)
        PrintMessage(",")
        PrintNumber(SurgeG.r0dep)
        PrintMessage("\n")
        ReturnValue(1)
    }
}
