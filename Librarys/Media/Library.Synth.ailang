    "SYS_OPEN":  Initialize=2
    "SYS_WRITE": Initialize=1
    "SYS_CLOSE": Initialize=3
}

FixedPool.SynthG {
    "tab":      Initialize=0, CanChange=True
    "notehz":   Initialize=0, CanChange=True
    "userwave": Initialize=0, CanChange=True
    "ok":       Initialize=0, CanChange=True
}

// =============================================================================
// TABLES
// =============================================================================
Function.Synth_TabInit {
    Body: {
        IfCondition EqualTo(SynthG.ok, 1) ThenBlock: { ReturnValue(0) }
        SynthG.tab = Allocate(520)
        MemorySet(SynthG.tab, 0, 520)
        t = SynthG.tab
        StoreValue(Add(t, 0), 0)
        StoreValue(Add(t, 8), 804)
        StoreValue(Add(t, 16), 1608)
        StoreValue(Add(t, 24), 2410)
        StoreValue(Add(t, 32), 3212)
        StoreValue(Add(t, 40), 4011)
        StoreValue(Add(t, 48), 4808)
        StoreValue(Add(t, 56), 5602)
        StoreValue(Add(t, 64), 6393)
        StoreValue(Add(t, 72), 7179)
        StoreValue(Add(t, 80), 7962)
        StoreValue(Add(t, 88), 8739)
        StoreValue(Add(t, 96), 9512)
        StoreValue(Add(t, 104), 10278)
        StoreValue(Add(t, 112), 11039)
        StoreValue(Add(t, 120), 11793)
        StoreValue(Add(t, 128), 12539)
        StoreValue(Add(t, 136), 13279)
        StoreValue(Add(t, 144), 14010)
        StoreValue(Add(t, 152), 14732)
        StoreValue(Add(t, 160), 15446)
        StoreValue(Add(t, 168), 16151)
        StoreValue(Add(t, 176), 16846)
        StoreValue(Add(t, 184), 17530)
        StoreValue(Add(t, 192), 18204)
        StoreValue(Add(t, 200), 18868)
        StoreValue(Add(t, 208), 19519)
        StoreValue(Add(t, 216), 20159)
        StoreValue(Add(t, 224), 20787)
        StoreValue(Add(t, 232), 21403)
        StoreValue(Add(t, 240), 22005)
        StoreValue(Add(t, 248), 22594)
        StoreValue(Add(t, 256), 23170)
        StoreValue(Add(t, 264), 23731)
        StoreValue(Add(t, 272), 24279)
        StoreValue(Add(t, 280), 24811)
        StoreValue(Add(t, 288), 25329)
        StoreValue(Add(t, 296), 25832)
        StoreValue(Add(t, 304), 26319)
        StoreValue(Add(t, 312), 26790)
        StoreValue(Add(t, 320), 27245)
        StoreValue(Add(t, 328), 27683)
        StoreValue(Add(t, 336), 28105)
        StoreValue(Add(t, 344), 28510)
        StoreValue(Add(t, 352), 28898)
        StoreValue(Add(t, 360), 29268)
        StoreValue(Add(t, 368), 29621)
        StoreValue(Add(t, 376), 29956)
        StoreValue(Add(t, 384), 30273)
        StoreValue(Add(t, 392), 30571)
        StoreValue(Add(t, 400), 30852)
        StoreValue(Add(t, 408), 31113)
        StoreValue(Add(t, 416), 31356)
        StoreValue(Add(t, 424), 31580)
        StoreValue(Add(t, 432), 31785)
        StoreValue(Add(t, 440), 31971)
        StoreValue(Add(t, 448), 32137)
        StoreValue(Add(t, 456), 32285)
        StoreValue(Add(t, 464), 32412)
        StoreValue(Add(t, 472), 32521)
        StoreValue(Add(t, 480), 32609)
        StoreValue(Add(t, 488), 32678)
        StoreValue(Add(t, 496), 32728)
        StoreValue(Add(t, 504), 32757)
        StoreValue(Add(t, 512), 32767)
        SynthG.notehz = Allocate(96)
        nh = SynthG.notehz
        StoreValue(Add(nh, 0), 261626)
        StoreValue(Add(nh, 8), 277183)
        StoreValue(Add(nh, 16), 293665)
        StoreValue(Add(nh, 24), 311127)
        StoreValue(Add(nh, 32), 329628)
        StoreValue(Add(nh, 40), 349228)
        StoreValue(Add(nh, 48), 369994)
        StoreValue(Add(nh, 56), 391995)
        StoreValue(Add(nh, 64), 415305)
        StoreValue(Add(nh, 72), 440000)
        StoreValue(Add(nh, 80), 466164)
        StoreValue(Add(nh, 88), 493883)
        SynthG.userwave = Allocate(256)
        MemorySet(SynthG.userwave, 0, 256)
        ui = 0
        WhileLoop LessThan(ui, 32) {
            StoreValue(Add(SynthG.userwave, Multiply(ui, 8)), Subtract(Multiply(ui, 2048), 32767))
            ui = Add(ui, 1)
        }
        SynthG.ok = 1
    }
}

Function.Synth_SineQ {
    Input: i: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(SynthG.ok, 0) ThenBlock: { Synth_TabInit() }
        IfCondition LessThan(i, 0) ThenBlock: { i = 0 }
        IfCondition GreaterThan(i, 64) ThenBlock: { i = 64 }
        ReturnValue(Dereference(Add(SynthG.tab, Multiply(i, 8))))
    }
}

Function.Synth_Sine8 {
    Input: idx: Integer
    Output: Integer
    Body: {
        x = BitwiseAnd(idx, 255)
        q = Divide(x, 64)
        i = Modulo(x, 64)
        IfCondition EqualTo(q, 0) ThenBlock: {
            v = Synth_SineQ(i)
            ReturnValue(v)
        }
        IfCondition EqualTo(q, 1) ThenBlock: {
            v = Synth_SineQ(Subtract(64, i))
            ReturnValue(v)
        }
        IfCondition EqualTo(q, 2) ThenBlock: {
            v = Synth_SineQ(i)
            ReturnValue(Subtract(0, v))
        }
        v = Synth_SineQ(Subtract(64, i))
        ReturnValue(Subtract(0, v))
    }
}

Function.Synth_SineLerp {
    Input: phase: Integer
    Output: Integer
    Body: {
        idx = BitwiseAnd(Divide(phase, 16777216), 255)
        frac = BitwiseAnd(Divide(phase, 65536), 255)
        s0 = Synth_Sine8(idx)
        s1 = Synth_Sine8(Add(idx, 1))
        d = Subtract(s1, s0)
        ReturnValue(Add(s0, Divide(Multiply(d, frac), 256)))
    }
}

Function.Synth_Quantize {
    Input: s: Integer
    Input: bits: Integer
    Output: Integer
    Body: {
        IfCondition GreaterEqual(bits, 16) ThenBlock: { ReturnValue(s) }
        IfCondition LessThan(bits, 1) ThenBlock: { ReturnValue(0) }
        sh = Subtract(16, bits)
        den = ShiftLeft(1, sh)
        q = Divide(s, den)
        ReturnValue(Multiply(q, den))
    }
}

Function.Synth_Clamp16 {
    Input: s: Integer
    Output: Integer
    Body: {
        IfCondition GreaterThan(s, 32767) ThenBlock: { ReturnValue(32767) }
        IfCondition LessThan(s, -32768) ThenBlock: { ReturnValue(-32768) }
        ReturnValue(s)
    }
}

Function.Synth_HzToStep {
    Input: hz: Integer
    Input: rate: Integer
    Output: Integer
    Body: {
        IfCondition LessEqual(rate, 0) ThenBlock: { ReturnValue(0) }
        IfCondition LessEqual(hz, 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(Divide(Multiply(hz, 4294967296), rate))
    }
}

Function.Synth_VoiceClear {
    Input: v: Address
    Body: {
        MemorySet(v, 0, SOsc.SIZE)
        SetByte(v, SOsc.WAVE, 0)
        SetByte(v, SOsc.WAVE2, 0)
        SetByte(v, SOsc.PW, 128)
        SetByte(v, SOsc.BITS, 16)
        SetByte(v, SOsc.GATE, 0)
        StoreValue(Add(v, SOsc.GAIN), SConst.UNITY, "dword")
        StoreValue(Add(v, SOsc.LFSR), SConst.LFSR_SEED)
        SetByte(v, SOsc.NOTE, 255)
        SetByte(v, SOsc.CH, 0)
        SetByte(v, SOsc.ENV_ST, SEnv.IDLE)
        StoreValue(Add(v, SOsc.ENV_LVL), 0, "dword")
        StoreValue(Add(v, SOsc.ATK), 0, "dword")
        StoreValue(Add(v, SOsc.DEC), 0, "dword")
        StoreValue(Add(v, SOsc.SUS), 65536, "dword")
        StoreValue(Add(v, SOsc.REL), 0, "dword")
        StoreValue(Add(v, SOsc.CUTOFF), 65536, "dword")
        StoreValue(Add(v, SOsc.RES), 0, "dword")
        StoreValue(Add(v, SOsc.STEP2), 0)
        StoreValue(Add(v, SOsc.DETUNE), 0, "dword")
        StoreValue(Add(v, SOsc.FENV), 0, "dword")
        StoreValue(Add(v, SOsc.LFO_SP), 0)
        StoreValue(Add(v, SOsc.LFO_PWM), 0, "dword")
        StoreValue(Add(v, SOsc.SUBMIX), 0, "dword")
        StoreValue(Add(v, SOsc.DRIVE), 0, "dword")
        StoreValue(Add(v, SOsc.OSC_MIX), 0, "dword")
        StoreValue(Add(v, SOsc.OSC2OCT), 2)
        StoreValue(Add(v, SOsc.LFO_FILT), 0, "dword")
        StoreValue(Add(v, SOsc.LFO_AMP), 0, "dword")
        StoreValue(Add(v, SOsc.PMOD), 0)
        StoreValue(Add(v, SOsc.SMP), 0)
        SetByte(v, SOsc.PWBASE, 128)
    }
}

Function.Synth_New {
    Input: nvoices: Integer
    Input: rate: Integer
    Output: Address
    Body: {
        Synth_TabInit()
        IfCondition LessThan(nvoices, 1) ThenBlock: { nvoices = 1 }
        IfCondition GreaterThan(nvoices, SConst.MAXVOICE) ThenBlock: { nvoices = SConst.MAXVOICE }
        IfCondition LessThan(rate, 1) ThenBlock: { rate = 48000 }
        syn = Allocate(SOff.SIZE)
        IfCondition EqualTo(syn, 0) ThenBlock: { ReturnValue(0) }
        MemorySet(syn, 0, SOff.SIZE)
        StoreValue(Add(syn, SOff.MAGIC), SConst.MAGIC)
        StoreValue(Add(syn, SOff.RATE), rate)
        StoreValue(Add(syn, SOff.NVOICE), nvoices)
        StoreValue(Add(syn, SOff.BITS), 16)
        StoreValue(Add(syn, SOff.QUAL), 1)
        StoreValue(Add(syn, SOff.MIXGAIN), 192)
        StoreValue(Add(syn, SOff.DELAYCAP), 96000)
        dcap = 96000
        dbuf = Allocate(Multiply(dcap, 2))
        MemorySet(dbuf, 0, Multiply(dcap, 2))
        StoreValue(Add(syn, SOff.DELAYBUF), dbuf)
        dbufr = Allocate(Multiply(dcap, 2))
        MemorySet(dbufr, 0, Multiply(dcap, 2))
        StoreValue(Add(syn, SOff.DELAYBUFR), dbufr)
        StoreValue(Add(syn, SOff.DELAYPOS), 0)
        StoreValue(Add(syn, SOff.DELAYPOSR), 0)
        StoreValue(Add(syn, SOff.DELAYLEN), 0)
        StoreValue(Add(syn, SOff.DELAYFB), 0)
        StoreValue(Add(syn, SOff.DELAYWET), 0)
        StoreValue(Add(syn, SOff.NCH), 2)
        vs = Allocate(Multiply(nvoices, SOsc.SIZE))
        IfCondition EqualTo(vs, 0) ThenBlock: {
            Deallocate(syn, SOff.SIZE)
            ReturnValue(0)
        }
        MemorySet(vs, 0, Multiply(nvoices, SOsc.SIZE))
        StoreValue(Add(syn, SOff.VOICES), vs)
        i = 0
        WhileLoop LessThan(i, nvoices) {
            Synth_VoiceClear(Add(vs, Multiply(i, SOsc.SIZE)))
            i = Add(i, 1)
        }
        ReturnValue(syn)
    }
}

Function.Synth_Free {
    Input: syn: Address
    Body: {
        IfCondition EqualTo(syn, 0) ThenBlock: { ReturnValue(0) }
        mag = Dereference(Add(syn, SOff.MAGIC))
        IfCondition NotEqual(mag, SConst.MAGIC) ThenBlock: { ReturnValue(0) }
        vs = Dereference(Add(syn, SOff.VOICES))
        n = Dereference(Add(syn, SOff.NVOICE))
        IfCondition NotEqual(vs, 0) ThenBlock: {
            Deallocate(vs, Multiply(n, SOsc.SIZE))
        }
        dbuf = Dereference(Add(syn, SOff.DELAYBUF))
        dcap = Dereference(Add(syn, SOff.DELAYCAP))
        IfCondition NotEqual(dbuf, 0) ThenBlock: {
            Deallocate(dbuf, Multiply(dcap, 2))
        }
        dbufr = Dereference(Add(syn, SOff.DELAYBUFR))
        IfCondition NotEqual(dbufr, 0) ThenBlock: {
            Deallocate(dbufr, Multiply(dcap, 2))
        }
        StoreValue(Add(syn, SOff.MAGIC), 0)
        Deallocate(syn, SOff.SIZE)
    }
}

Function.Synth_Voice {
    Input: syn: Address
    Input: index: Integer
    Output: Address
    Body: {
        IfCondition EqualTo(syn, 0) ThenBlock: { ReturnValue(0) }
        n = Dereference(Add(syn, SOff.NVOICE))
        IfCondition LessThan(index, 0) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterEqual(index, n) ThenBlock: { ReturnValue(0) }
        vs = Dereference(Add(syn, SOff.VOICES))
        ReturnValue(Add(vs, Multiply(index, SOsc.SIZE)))
    }
}

Function.Synth_VoiceCount {
    Input: syn: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(syn, 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(Dereference(Add(syn, SOff.NVOICE)))
    }
}

Function.Synth_VoiceCh {
    Input: syn: Address
    Input: index: Integer
    Output: Integer
    Body: {
        v = Synth_Voice(syn, index)
        IfCondition EqualTo(v, 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(GetByte(v, SOsc.CH))
    }
}

Function.Synth_SetBits {
    Input: syn: Address
    Input: bits: Integer
    Body: {
        IfCondition EqualTo(syn, 0) ThenBlock: { ReturnValue(0) }
        StoreValue(Add(syn, SOff.BITS), bits)
    }
}

Function.Synth_SetQuality {
    Input: syn: Address
    Input: qual: Integer
    Body: {
        IfCondition EqualTo(syn, 0) ThenBlock: { ReturnValue(0) }
        StoreValue(Add(syn, SOff.QUAL), qual)
    }
}

Function.Synth_VoiceOn {
    Input: syn: Address
    Input: index: Integer
    Input: wave: Integer
    Input: hz: Integer
    Input: vel: Integer
    Body: {
        v = Synth_Voice(syn, index)
        IfCondition EqualTo(v, 0) ThenBlock: { ReturnValue(0) }
        rate = Dereference(Add(syn, SOff.RATE))
        step = Synth_HzToStep(hz, rate)
        StoreValue(v, 0)
        StoreValue(Add(v, SOsc.STEP), step)
        StoreValue(Add(v, SOsc.BASE), step)
        SetByte(v, SOsc.WAVE, wave)
        SetByte(v, SOsc.GATE, 1)
        g = vel
        IfCondition LessThan(g, 0) ThenBlock: { g = 0 }
        IfCondition GreaterThan(g, 127) ThenBlock: { g = 127 }
        StoreValue(Add(v, SOsc.GAIN), Add(1, Multiply(g, 2)), "dword")
        StoreValue(Add(v, SOsc.LFSR), SConst.LFSR_SEED)
        bits = Dereference(Add(syn, SOff.BITS))
        SetByte(v, SOsc.BITS, bits)
        SetByte(v, SOsc.NOTE, 255)
        Synth_ApplyDetune(v)
        StoreValue(Add(v, SOsc.PHASE2), 1073741824)
        Synth_VoiceStartEnv(v)
    }
}

Function.Synth_NoteMilliHz {
    Input: note: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(SynthG.ok, 0) ThenBlock: { Synth_TabInit() }
        n = note
        IfCondition LessThan(n, 0) ThenBlock: { n = 0 }
        IfCondition GreaterThan(n, 127) ThenBlock: { n = 127 }
        pc = Modulo(n, 12)
        oct = Divide(n, 12)
        mhz = Dereference(Add(SynthG.notehz, Multiply(pc, 8)))
        IfCondition GreaterThan(oct, 5) ThenBlock: {
            s = Subtract(oct, 5)
            WhileLoop GreaterThan(s, 0) {
                mhz = Multiply(mhz, 2)
                s = Subtract(s, 1)
            }
        }
        IfCondition LessThan(oct, 5) ThenBlock: {
            s = Subtract(5, oct)
            WhileLoop GreaterThan(s, 0) {
                mhz = Divide(mhz, 2)
                s = Subtract(s, 1)
            }
        }
        ReturnValue(mhz)
    }
}

Function.Synth_VoiceOnNote {
    Input: syn: Address
    Input: index: Integer
    Input: wave: Integer
    Input: note: Integer
    Input: vel: Integer
    Body: {
        v = Synth_Voice(syn, index)
        IfCondition EqualTo(v, 0) ThenBlock: { ReturnValue(0) }
        rate = Dereference(Add(syn, SOff.RATE))
        mhz = Synth_NoteMilliHz(note)
        step = Divide(Multiply(mhz, 4294967296), Multiply(rate, 1000))
        StoreValue(v, 0)
        StoreValue(Add(v, SOsc.STEP), step)
        StoreValue(Add(v, SOsc.BASE), step)
        SetByte(v, SOsc.WAVE, wave)
        SetByte(v, SOsc.GATE, 1)
        g = vel
        IfCondition LessThan(g, 0) ThenBlock: { g = 0 }
        IfCondition GreaterThan(g, 127) ThenBlock: { g = 127 }
        StoreValue(Add(v, SOsc.GAIN), Add(1, Multiply(g, 2)), "dword")
        StoreValue(Add(v, SOsc.LFSR), SConst.LFSR_SEED)
        bits = Dereference(Add(syn, SOff.BITS))
        SetByte(v, SOsc.BITS, bits)
        SetByte(v, SOsc.NOTE, BitwiseAnd(note, 127))
        IfCondition EqualTo(wave, 8) ThenBlock: {
            smp = Dereference(Add(syn, SOff.SAMPLE))
            StoreValue(Add(v, SOsc.SMP), smp)
            st = Smp_Step(smp, note, rate)
            StoreValue(Add(v, SOsc.STEP), st)
            StoreValue(Add(v, SOsc.BASE), st)
        }
        Synth_ApplyDetune(v)
        StoreValue(Add(v, SOsc.PHASE2), 1073741824)
        Synth_VoiceStartEnv(v)
    }
}

Function.Synth_SetBankSample {
    Input: syn: Address
    Input: smp: Address
    Body: {
        IfCondition EqualTo(syn, 0) ThenBlock: { ReturnValue(0) }
        StoreValue(Add(syn, SOff.SAMPLE), smp)
    }
}

Function.Synth_RetuneSample {
    Input: syn: Address
    Input: index: Integer
    Input: note: Integer
    Body: {
        v = Synth_Voice(syn, index)
        IfCondition EqualTo(v, 0) ThenBlock: { ReturnValue(0) }
        smp = Dereference(Add(v, SOsc.SMP))
        IfCondition EqualTo(smp, 0) ThenBlock: { ReturnValue(0) }
        rate = Dereference(Add(syn, SOff.RATE))
        root = SF2_LastRoot()
        coarse = SF2_LastCoarse()
        fine = SF2_LastFine()
        scale = SF2_LastScale()
        d = coarse
        IfCondition GreaterThan(scale, 0) ThenBlock: {
            dk = Subtract(note, root)
            dk = Divide(Multiply(dk, scale), 100)
            d = Add(dk, coarse)
        }
        st = Smp_StepD(smp, d, rate)
        fine = SF2_S32(fine)
        IfCondition GreaterThan(fine, 1200) ThenBlock: { fine = 1200 }
        IfCondition LessThan(fine, -1200) ThenBlock: { fine = -1200 }
        IfCondition NotEqual(fine, 0) ThenBlock: {
            add = Divide(Multiply(st, fine), 1731)
            st = Add(st, add)
            IfCondition LessThan(st, 1) ThenBlock: { st = 1 }
        }
        StoreValue(Add(v, SOsc.STEP), st)
        StoreValue(Add(v, SOsc.BASE), st)
        StoreValue(Add(v, SOsc.STEP2), 0)
    }
}

Function.Synth_VoiceOnSample {
    Input: syn: Address
    Input: index: Integer
    Input: smp: Address
    Input: note: Integer
    Input: vel: Integer
    Body: {
        IfCondition NotEqual(smp, 0) ThenBlock: {
            Synth_SetBankSample(syn, smp)
        }
        Synth_VoiceOnNote(syn, index, 8, note, vel)
        Synth_RetuneSample(syn, index, note)
        Synth_SetADSR(syn, index, 2, 0, 256, 450)
        md = SF2_LastMode()
        IfCondition EqualTo(md, 3) ThenBlock: { md = 1 }
        IfCondition NotEqual(smp, 0) ThenBlock: {
            already = Dereference(Add(smp, 56))
            IfCondition NotEqual(already, 1) ThenBlock: {
                l0 = Dereference(Add(smp, 40))
                l1 = Dereference(Add(smp, 48))
                Smp_SetLoop(smp, l0, l1, md)
            }
        }
        v = Synth_Voice(syn, index)
        IfCondition NotEqual(v, 0) ThenBlock: {
            StoreValue(Add(v, SOsc.DRIVE), 0, "dword")
            StoreValue(Add(v, SOsc.FENV), 0, "dword")
            StoreValue(Add(v, SOsc.SUBMIX), 0, "dword")
            StoreValue(Add(v, SOsc.LFO_FILT), 0, "dword")
            StoreValue(Add(v, SOsc.LFO_AMP), 0, "dword")
            StoreValue(Add(v, SOsc.LFO_PWM), 0, "dword")
            StoreValue(Add(v, SOsc.LFO_SP), 0)
        }
    }
}

Function.Synth_ApplyDetune {
    Input: v: Address
    Body: {
        base = Dereference(Add(v, SOsc.BASE))
        IfCondition EqualTo(base, 0) ThenBlock: {
            base = Dereference(Add(v, SOsc.STEP))
        }
        pmod = Dereference(Add(v, SOsc.PMOD))
        IfCondition NotEqual(pmod, 0) ThenBlock: {
            bend = Divide(Multiply(base, pmod), 1732)
            base = Add(base, bend)
        }
        det = Dereference(Add(v, SOsc.DETUNE), "dword")
        extra = 0
        IfCondition GreaterThan(det, 0) ThenBlock: {
            extra = Divide(Multiply(base, det), 1732)
        }
        half = Divide(extra, 2)
        IfCondition GreaterThan(det, 0) ThenBlock: {
            IfCondition LessThan(half, 1) ThenBlock: { half = 1 }
            StoreValue(Add(v, SOsc.STEP), Subtract(base, half))
        } ElseBlock: {
            StoreValue(Add(v, SOsc.STEP), base)
        }
        st2 = Add(base, half)
        o2 = Dereference(Add(v, SOsc.OSC2OCT))
        IfCondition GreaterThan(o2, 2) ThenBlock: {
            sh = Subtract(o2, 2)
            st2 = Multiply(st2, ShiftLeft(1, sh))
        }
        IfCondition LessThan(o2, 2) ThenBlock: {
            sh = Subtract(2, o2)
            st2 = Divide(st2, ShiftLeft(1, sh))
        }
        IfCondition EqualTo(det, 0) ThenBlock: {
            IfCondition EqualTo(o2, 2) ThenBlock: {
                StoreValue(Add(v, SOsc.STEP2), 0)
                ReturnValue(0)
            }
        }
        StoreValue(Add(v, SOsc.STEP2), st2)
    }
}

Function.Synth_AllocVoice {
    Input: syn: Address
    Input: note: Integer
    Input: ch: Integer
    Output: Integer
    Body: {
        n = Dereference(Add(syn, SOff.NVOICE))
        chn = ch
        IfCondition LessThan(chn, 0) ThenBlock: { chn = 0 }
        i = 0
        WhileLoop LessThan(i, n) {
            v = Synth_Voice(syn, i)
            IfCondition EqualTo(GetByte(v, SOsc.ENV_ST), SEnv.IDLE) ThenBlock: {
                SetByte(v, SOsc.CH, BitwiseAnd(chn, 255))
                StoreValue(Add(v, SOsc.TRACK), chn)
                ReturnValue(i)
            }
            i = Add(i, 1)
        }
        best = 0
        best_lvl = 0
        best_rank = -1
        i = 0
        WhileLoop LessThan(i, n) {
            v = Synth_Voice(syn, i)
            lvl = Dereference(Add(v, SOsc.ENV_LVL), "dword")
            st = GetByte(v, SOsc.ENV_ST)
            gate = GetByte(v, SOsc.GATE)
            rank = 0
            IfCondition EqualTo(gate, 0) ThenBlock: { rank = 1 }
            IfCondition EqualTo(st, SEnv.RELEASE) ThenBlock: { rank = 2 }
            take = 0
            IfCondition GreaterThan(rank, best_rank) ThenBlock: { take = 1 }
            IfCondition EqualTo(rank, best_rank) ThenBlock: {
                IfCondition LessEqual(lvl, best_lvl) ThenBlock: { take = 1 }
            }
            IfCondition EqualTo(take, 1) ThenBlock: {
                best = i
                best_lvl = lvl
                best_rank = rank
            }
            i = Add(i, 1)
        }
        v = Synth_Voice(syn, best)
        IfCondition NotEqual(v, 0) ThenBlock: {
            SetByte(v, SOsc.CH, BitwiseAnd(chn, 255))
            StoreValue(Add(v, SOsc.TRACK), chn)
        }
        ReturnValue(best)
    }
}

Function.Synth_NoteOff {
    Input: syn: Address
    Input: note: Integer
    Input: ch: Integer
    Body: {
        n = Dereference(Add(syn, SOff.NVOICE))
        want = BitwiseAnd(note, 127)
        chn = ch
        i = 0
        WhileLoop LessThan(i, n) {
            v = Synth_Voice(syn, i)
            tr = Dereference(Add(v, SOsc.TRACK))
            IfCondition EqualTo(GetByte(v, SOsc.NOTE), want) ThenBlock: {
                IfCondition EqualTo(tr, chn) ThenBlock: {
                    SetByte(v, SOsc.GATE, 0)
                    rel = Dereference(Add(v, SOsc.REL), "dword")
                    IfCondition EqualTo(rel, 0) ThenBlock: {
                        SetByte(v, SOsc.ENV_ST, SEnv.IDLE)
                        StoreValue(Add(v, SOsc.ENV_LVL), 0, "dword")
                        SetByte(v, SOsc.NOTE, 255)
                    } ElseBlock: {
                        SetByte(v, SOsc.ENV_ST, SEnv.RELEASE)
                    }
                }
            }
            i = Add(i, 1)
        }
    }
}

Function.Synth_VoiceOff {
    Input: syn: Address
    Input: index: Integer
    Body: {
        v = Synth_Voice(syn, index)
        IfCondition EqualTo(v, 0) ThenBlock: { ReturnValue(0) }
        SetByte(v, SOsc.GATE, 0)
        rel = Dereference(Add(v, SOsc.REL), "dword")
        IfCondition EqualTo(rel, 0) ThenBlock: {
            SetByte(v, SOsc.ENV_ST, SEnv.IDLE)
            StoreValue(Add(v, SOsc.ENV_LVL), 0, "dword")
            SetByte(v, SOsc.NOTE, 255)
        } ElseBlock: {
            SetByte(v, SOsc.ENV_ST, SEnv.RELEASE)
        }
    }
}

Function.Synth_SetPulse {
    Input: syn: Address
    Input: index: Integer
    Input: pw: Integer
    Body: {
        v = Synth_Voice(syn, index)
        IfCondition EqualTo(v, 0) ThenBlock: { ReturnValue(0) }
        p = pw
        IfCondition LessThan(p, 1) ThenBlock: { p = 1 }
        IfCondition GreaterThan(p, 255) ThenBlock: { p = 255 }
        SetByte(v, SOsc.PW, p)
        SetByte(v, SOsc.PWBASE, p)
    }
}

Function.Synth_SetWave {
    Input: syn: Address
    Input: index: Integer
    Input: wave: Integer
    Body: {
        v = Synth_Voice(syn, index)
        IfCondition EqualTo(v, 0) ThenBlock: { ReturnValue(0) }
        w = wave
        IfCondition LessThan(w, 0) ThenBlock: { w = 0 }
        IfCondition GreaterThan(w, 8) ThenBlock: { w = 8 }
        SetByte(v, SOsc.WAVE, w)
    }
}

Function.Synth_NoiseTick {
    Input: v: Address
    Output: Integer
    Body: {
        r = Dereference(Add(v, SOsc.LFSR))
        IfCondition EqualTo(r, 0) ThenBlock: { r = 1 }
        b0 = BitwiseAnd(r, 1)
        b1 = BitwiseAnd(Divide(r, 2), 1)
        xor = BitwiseAnd(Add(b0, b1), 1)
        r = Add(Divide(r, 2), ShiftLeft(xor, 14))
        StoreValue(Add(v, SOsc.LFSR), r)
        IfCondition EqualTo(b0, 1) ThenBlock: { ReturnValue(32767) }
        ReturnValue(-32767)
    }
}

Function.Synth_PolyBLEP {
    Input: ph: Integer
    Input: dt: Integer
    Output: Integer
    Body: {
        IfCondition LessEqual(dt, 0) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(ph, dt) ThenBlock: {
            x = Divide(Multiply(ph, 32768), dt)
            xx = Divide(Multiply(x, x), 32768)
            y = Subtract(Subtract(Multiply(x, 2), xx), 32768)
            ReturnValue(Divide(Multiply(y, 32767), 32768))
        }
        wrap = Add(ph, dt)
        IfCondition GreaterEqual(wrap, 4294967296) ThenBlock: {
            u = Subtract(4294967296, ph)
            x = Divide(Multiply(u, 32768), dt)
            xx = Divide(Multiply(x, x), 32768)
            y = Add(Subtract(32768, Multiply(x, 2)), xx)
            ReturnValue(Divide(Multiply(y, 32767), 32768))
        }
        ReturnValue(0)
    }
}

Function.Synth_WaveAt {
    Input: v: Address
    Input: ph: Integer
    Input: dt: Integer
    Input: qual: Integer
    Output: Integer
    Body: {
        wv = GetByte(v, SOsc.WAVE)
        IfCondition EqualTo(wv, 0) ThenBlock: {
            p32 = BitwiseAnd(ph, 4294967295)
            fp = Float_FromInt(p32)
            den = Float_FromInt(4294967296)
            ang = Float_Div(fp, den)
            pi = 0x400921FB54442D18
            two = Float_FromInt(2)
            twopi = Float_Mul(two, pi)
            ang = Float_Mul(ang, twopi)
            s = Float_Sin(ang)
            amp = Float_FromInt(32767)
            s = Float_Mul(s, amp)
            ReturnValue(Float_ToInt(s))
        }
        IfCondition EqualTo(wv, 1) ThenBlock: {
            idx = BitwiseAnd(Divide(ph, 16777216), 255)
            s = -32767
            IfCondition LessThan(idx, 128) ThenBlock: { s = 32767 }
            b0 = Synth_PolyBLEP(ph, dt)
            ph2 = ph
            IfCondition LessThan(ph2, 2147483648) ThenBlock: {
                ph2 = Add(ph2, 2147483648)
            } ElseBlock: {
                ph2 = Subtract(ph2, 2147483648)
            }
            b1 = Synth_PolyBLEP(ph2, dt)
            ReturnValue(Subtract(Add(s, b1), b0))
        }
        IfCondition EqualTo(wv, 2) ThenBlock: {
            pw = GetByte(v, SOsc.PW)
            IfCondition LessThan(pw, 2) ThenBlock: { pw = 2 }
            IfCondition GreaterThan(pw, 254) ThenBlock: { pw = 254 }
            idx = BitwiseAnd(Divide(ph, 16777216), 255)
            s = -32767
            IfCondition LessThan(idx, pw) ThenBlock: { s = 32767 }
            edge = Multiply(pw, 16777216)
            b0 = Synth_PolyBLEP(ph, dt)
            ph2 = Subtract(ph, edge)
            IfCondition LessThan(ph2, 0) ThenBlock: { ph2 = Add(ph2, 4294967296) }
            b1 = Synth_PolyBLEP(ph2, dt)
            ReturnValue(Subtract(Add(s, b1), b0))
        }
        IfCondition EqualTo(wv, 3) ThenBlock: {
            naive = Subtract(Divide(ph, 65536), 32768)
            b = Synth_PolyBLEP(ph, dt)
            ReturnValue(Subtract(naive, b))
        }
        IfCondition EqualTo(wv, 4) ThenBlock: {
            p = Divide(ph, 65536)
            IfCondition GreaterEqual(p, 32768) ThenBlock: {
                p = Subtract(65535, p)
            }
            ReturnValue(Subtract(Multiply(p, 2), 32767))
        }
        IfCondition EqualTo(wv, 5) ThenBlock: {
            n = Synth_NoiseTick(v)
            ReturnValue(n)
        }
        IfCondition EqualTo(wv, 6) ThenBlock: {
            step = BitwiseAnd(Divide(ph, 134217728), 31)
            IfCondition LessThan(step, 16) ThenBlock: {
                ReturnValue(Multiply(Subtract(step, 8), 4096))
            }
            ReturnValue(Multiply(Subtract(23, step), 4096))
        }
        IfCondition EqualTo(wv, 7) ThenBlock: {
            idx = BitwiseAnd(Divide(ph, 134217728), 31)
            frac = BitwiseAnd(Divide(ph, 524288), 255)
            s0 = Dereference(Add(SynthG.userwave, Multiply(idx, 8)))
            nidx = BitwiseAnd(Add(idx, 1), 31)
            s1 = Dereference(Add(SynthG.userwave, Multiply(nidx, 8)))
            d = Subtract(s1, s0)
            ReturnValue(Add(s0, Divide(Multiply(d, frac), 256)))
        }
        IfCondition EqualTo(wv, 8) ThenBlock: {
            smp = Dereference(Add(v, SOsc.SMP))
            s = Smp_Tick(smp, ph)
            ReturnValue(s)
        }
        ReturnValue(0)
    }
}

Function.Synth_OscRaw {
    Input: v: Address
    Input: qual: Integer
    Output: Integer
    Body: {
        ph = Dereference(v)
        dt = Dereference(Add(v, SOsc.STEP))
        s = Synth_WaveAt(v, ph, dt, qual)
        ReturnValue(s)
    }
}

Function.Synth_VoiceStartEnv {
    Input: v: Address
    Body: {
        atk = Dereference(Add(v, SOsc.ATK), "dword")
        IfCondition EqualTo(atk, 0) ThenBlock: {
            StoreValue(Add(v, SOsc.ENV_LVL), 65536, "dword")
            dec = Dereference(Add(v, SOsc.DEC), "dword")
            IfCondition EqualTo(dec, 0) ThenBlock: {
                sus = Dereference(Add(v, SOsc.SUS), "dword")
                StoreValue(Add(v, SOsc.ENV_LVL), sus, "dword")
                SetByte(v, SOsc.ENV_ST, SEnv.SUSTAIN)
            } ElseBlock: {
                SetByte(v, SOsc.ENV_ST, SEnv.DECAY)
            }
        } ElseBlock: {
            StoreValue(Add(v, SOsc.ENV_LVL), 0, "dword")
            SetByte(v, SOsc.ENV_ST, SEnv.ATTACK)
        }
        StoreValue(Add(v, SOsc.FILT_LP), 0)
        StoreValue(Add(v, SOsc.FILT_BP), 0)
        StoreValue(Add(v, SOsc.FILT_LPR), 0)
        StoreValue(Add(v, SOsc.FILT_BPR), 0)
        StoreValue(Add(v, SOsc.LASTR), 0)
        StoreValue(Add(v, SOsc.LFO_PH), 0)
    }
}

Function.Synth_EnvTick {
    Input: v: Address
    Output: Integer
    Body: {
        st = GetByte(v, SOsc.ENV_ST)
        IfCondition EqualTo(st, SEnv.IDLE) ThenBlock: { ReturnValue(0) }
        lvl = Dereference(Add(v, SOsc.ENV_LVL), "dword")
        IfCondition EqualTo(st, SEnv.ATTACK) ThenBlock: {
            inc = Dereference(Add(v, SOsc.ATK), "dword")
            lvl = Add(lvl, inc)
            IfCondition GreaterEqual(lvl, 65536) ThenBlock: {
                lvl = 65536
                SetByte(v, SOsc.ENV_ST, SEnv.DECAY)
            }
        }
        IfCondition EqualTo(GetByte(v, SOsc.ENV_ST), SEnv.DECAY) ThenBlock: {
            sus = Dereference(Add(v, SOsc.SUS), "dword")
            inc = Dereference(Add(v, SOsc.DEC), "dword")
            IfCondition EqualTo(inc, 0) ThenBlock: {
                lvl = sus
                SetByte(v, SOsc.ENV_ST, SEnv.SUSTAIN)
            } ElseBlock: {
                IfCondition GreaterThan(lvl, sus) ThenBlock: {
                    lvl = Subtract(lvl, inc)
                    IfCondition LessThan(lvl, sus) ThenBlock: { lvl = sus }
                }
                IfCondition LessEqual(lvl, sus) ThenBlock: {
                    lvl = sus
                    SetByte(v, SOsc.ENV_ST, SEnv.SUSTAIN)
                }
            }
        }
        IfCondition EqualTo(GetByte(v, SOsc.ENV_ST), SEnv.RELEASE) ThenBlock: {
            inc = Dereference(Add(v, SOsc.REL), "dword")
            IfCondition EqualTo(inc, 0) ThenBlock: {
                lvl = 0
                SetByte(v, SOsc.ENV_ST, SEnv.IDLE)
                SetByte(v, SOsc.NOTE, 255)
            } ElseBlock: {
                IfCondition GreaterThan(lvl, inc) ThenBlock: {
                    lvl = Subtract(lvl, inc)
                } ElseBlock: {
                    lvl = 0
                    SetByte(v, SOsc.ENV_ST, SEnv.IDLE)
                    SetByte(v, SOsc.NOTE, 255)
                }
            }
        }
        StoreValue(Add(v, SOsc.ENV_LVL), lvl, "dword")
        ReturnValue(lvl)
    }
}

Function.Synth_FiltTick {
    Input: v: Address
    Input: x: Integer
    Input: ch: Integer
    Output: Integer
    Body: {
        cut = Dereference(Add(v, SOsc.CUTOFF), "dword")
        fenv = Dereference(Add(v, SOsc.FENV), "dword")
        IfCondition GreaterThan(fenv, 0) ThenBlock: {
            env = Dereference(Add(v, SOsc.ENV_LVL), "dword")
            add = Divide(Multiply(fenv, env), 128)
            cut = Add(cut, add)
        }
        lf = Dereference(Add(v, SOsc.LFO_FILT), "dword")
        IfCondition GreaterThan(lf, 0) ThenBlock: {
            lpph = Dereference(Add(v, SOsc.LFO_PH))
            lidx = BitwiseAnd(Divide(lpph, 16777216), 255)
            ltri = lidx
            IfCondition GreaterEqual(lidx, 128) ThenBlock: { ltri = Subtract(255, lidx) }
            ltri = Subtract(Multiply(ltri, 512), 32767)
            cut = Add(cut, Divide(Multiply(ltri, lf), 384))
        }
        IfCondition GreaterThan(cut, 65536) ThenBlock: { cut = 65536 }
        IfCondition LessThan(cut, 16) ThenBlock: { cut = 16 }
        IfCondition GreaterEqual(cut, 65280) ThenBlock: { ReturnValue(x) }
        lp_off = SOsc.FILT_LP
        bp_off = SOsc.FILT_BP
        IfCondition EqualTo(ch, 1) ThenBlock: {
            lp_off = SOsc.FILT_LPR
            bp_off = SOsc.FILT_BPR
        }
        lp = Dereference(Add(v, lp_off))
        IfCondition EqualTo(GetByte(v, SOsc.WAVE), 8) ThenBlock: {
            d = Subtract(x, lp)
            lp = Add(lp, Divide(Multiply(cut, d), 65536))
            IfCondition GreaterThan(lp, 32767) ThenBlock: { lp = 32767 }
            IfCondition LessThan(lp, -32767) ThenBlock: { lp = -32767 }
            StoreValue(Add(v, lp_off), lp)
            StoreValue(Add(v, bp_off), 0)
            ReturnValue(lp)
        }
        bp = Dereference(Add(v, bp_off))
        q = Dereference(Add(v, SOsc.RES), "dword")
        qbp = Divide(Multiply(q, bp), 96)
        hp = Subtract(Subtract(x, lp), qbp)
        bp = Add(bp, Divide(Multiply(cut, hp), 65536))
        lp = Add(lp, Divide(Multiply(cut, bp), 65536))
        IfCondition GreaterThan(lp, 262144) ThenBlock: { lp = 262144 }
        IfCondition LessThan(lp, -262144) ThenBlock: { lp = -262144 }
        IfCondition GreaterThan(bp, 262144) ThenBlock: { bp = 262144 }
        IfCondition LessThan(bp, -262144) ThenBlock: { bp = -262144 }
        StoreValue(Add(v, lp_off), lp)
        StoreValue(Add(v, bp_off), bp)
        ReturnValue(lp)
    }
}

Function.Synth_VoiceTick {
    Input: v: Address
    Input: qual: Integer
    Output: Integer
    Body: {
        st = GetByte(v, SOsc.ENV_ST)
        IfCondition EqualTo(st, SEnv.IDLE) ThenBlock: {
            StoreValue(Add(v, SOsc.LASTR), 0)
            ReturnValue(0)
        }
        env = Synth_EnvTick(v)
        IfCondition EqualTo(env, 0) ThenBlock: {
            IfCondition EqualTo(GetByte(v, SOsc.ENV_ST), SEnv.IDLE) ThenBlock: {
                StoreValue(Add(v, SOsc.LASTR), 0)
                ReturnValue(0)
            }
        }
        ltri = 0
        lsp = Dereference(Add(v, SOsc.LFO_SP))
        IfCondition GreaterThan(lsp, 0) ThenBlock: {
            lp = Dereference(Add(v, SOsc.LFO_PH))
            lp = BitwiseAnd(Add(lp, lsp), 4294967295)
            StoreValue(Add(v, SOsc.LFO_PH), lp)
            lidx = BitwiseAnd(Divide(lp, 16777216), 255)
            ltri = lidx
            IfCondition GreaterEqual(lidx, 128) ThenBlock: { ltri = Subtract(255, lidx) }
            ltri = Subtract(Multiply(ltri, 512), 32767)
            pwm = Dereference(Add(v, SOsc.LFO_PWM), "dword")
            IfCondition GreaterThan(pwm, 0) ThenBlock: {
                base = GetByte(v, SOsc.PWBASE)
                delta = Divide(Multiply(ltri, pwm), 24576)
                npw = Add(base, delta)
                IfCondition LessThan(npw, 8) ThenBlock: { npw = 8 }
                IfCondition GreaterThan(npw, 248) ThenBlock: { npw = 248 }
                SetByte(v, SOsc.PW, npw)
            }
        }
        ph1 = Dereference(v)
        st1 = Dereference(Add(v, SOsc.STEP))
        raw = Synth_WaveAt(v, ph1, st1, qual)
        mix = Dereference(Add(v, SOsc.OSC_MIX), "dword")
        step2 = Dereference(Add(v, SOsc.STEP2))
        w2 = GetByte(v, SOsc.WAVE2)
        need2 = mix
        IfCondition GreaterThan(step2, 0) ThenBlock: { need2 = 1 }
        IfCondition NotEqual(w2, GetByte(v, SOsc.WAVE)) ThenBlock: {
            IfCondition GreaterThan(mix, 0) ThenBlock: { need2 = 1 }
        }
        IfCondition EqualTo(GetByte(v, SOsc.WAVE), 8) ThenBlock: { need2 = 0 }
        IfCondition GreaterThan(need2, 0) ThenBlock: {
            IfCondition EqualTo(step2, 0) ThenBlock: { step2 = st1 }
            ph2 = Dereference(Add(v, SOsc.PHASE2))
            w1 = GetByte(v, SOsc.WAVE)
            SetByte(v, SOsc.WAVE, w2)
            raw2 = Synth_WaveAt(v, ph2, step2, qual)
            SetByte(v, SOsc.WAVE, w1)
            mv = mix
            IfCondition EqualTo(mv, 0) ThenBlock: { mv = 128 }
            raw = Divide(Add(Multiply(raw, Subtract(256, mv)), Multiply(raw2, mv)), 256)
            StoreValue(Add(v, SOsc.PHASE2), BitwiseAnd(Add(ph2, step2), 4294967295))
        }
        subm = Dereference(Add(v, SOsc.SUBMIX), "dword")
        IfCondition GreaterThan(subm, 0) ThenBlock: {
            IfCondition NotEqual(GetByte(v, SOsc.WAVE), 8) ThenBlock: {
                ph = Dereference(v)
                sidx = BitwiseAnd(Divide(ph, 33554432), 255)
                sub = -32767
                IfCondition LessThan(sidx, 128) ThenBlock: { sub = 32767 }
                raw = Add(raw, Divide(Multiply(sub, subm), 128))
            }
        }
        rawR = raw
        IfCondition EqualTo(GetByte(v, SOsc.WAVE), 8) ThenBlock: {
            smp = Dereference(Add(v, SOsc.SMP))
            IfCondition NotEqual(smp, 0) ThenBlock: {
                pr = Dereference(Add(smp, 72))
                IfCondition NotEqual(pr, 0) ThenBlock: {
                    rawR = Smp_TickCh(smp, ph1, 1)
                }
            }
        }
        bits = GetByte(v, SOsc.BITS)
        q = Synth_Quantize(raw, bits)
        qR = Synth_Quantize(rawR, bits)
        s = Divide(Multiply(q, env), 65536)
        sR = Divide(Multiply(qR, env), 65536)
        s = Synth_FiltTick(v, s, 0)
        sR = Synth_FiltTick(v, sR, 1)
        drv = Dereference(Add(v, SOsc.DRIVE), "dword")
        IfCondition GreaterThan(drv, 0) ThenBlock: {
            s = Divide(Multiply(s, Add(256, Multiply(drv, 3))), 256)
            sR = Divide(Multiply(sR, Add(256, Multiply(drv, 3))), 256)
            s = Synth_SoftClip(s)
            sR = Synth_SoftClip(sR)
        }
        gain = Dereference(Add(v, SOsc.GAIN), "dword")
        s = Divide(Multiply(s, gain), SConst.UNITY)
        sR = Divide(Multiply(sR, gain), SConst.UNITY)
        la = Dereference(Add(v, SOsc.LFO_AMP), "dword")
        IfCondition GreaterThan(la, 0) ThenBlock: {
            am = Add(256, Divide(Multiply(ltri, la), 32768))
            s = Divide(Multiply(s, am), 256)
            sR = Divide(Multiply(sR, am), 256)
        }
        StoreValue(Add(v, SOsc.LASTR), sR)
        step = Dereference(Add(v, SOsc.STEP))
        ph = Dereference(v)
        np = Add(ph, step)
        IfCondition EqualTo(GetByte(v, SOsc.WAVE), 8) ThenBlock: {
            smp = Dereference(Add(v, SOsc.SMP))
            np = Smp_WrapPhase(smp, np)
        } ElseBlock: {
            np = BitwiseAnd(np, 4294967295)
        }
        StoreValue(v, np)
        ReturnValue(s)
    }
}

Function.Synth_SoftClip {
    Input: x: Integer
    Output: Integer
    Body: {
        a = x
        IfCondition LessThan(a, 0) ThenBlock: { a = Subtract(0, a) }
        den = Add(32767, Divide(a, 2))
        y = Divide(Multiply(x, 32767), den)
        ReturnValue(Synth_Clamp16(y))
    }
}

Function.Synth_DelayTick {
    Input: syn: Address
    Input: x: Integer
    Input: ch: Integer
    Output: Integer
    Body: {
        wet = Dereference(Add(syn, SOff.DELAYWET))
        IfCondition EqualTo(wet, 0) ThenBlock: { ReturnValue(x) }
        buf = Dereference(Add(syn, SOff.DELAYBUF))
        poff = SOff.DELAYPOS
        IfCondition EqualTo(ch, 1) ThenBlock: {
            buf = Dereference(Add(syn, SOff.DELAYBUFR))
            poff = SOff.DELAYPOSR
        }
        IfCondition EqualTo(buf, 0) ThenBlock: { ReturnValue(x) }
        cap = Dereference(Add(syn, SOff.DELAYCAP))
        len = Dereference(Add(syn, SOff.DELAYLEN))
        IfCondition LessEqual(len, 1) ThenBlock: { ReturnValue(x) }
        pos = Dereference(Add(syn, poff))
        rp = Subtract(pos, len)
        IfCondition LessThan(rp, 0) ThenBlock: { rp = Add(rp, cap) }
        lo = GetByte(buf, Multiply(rp, 2))
        hi = GetByte(buf, Add(Multiply(rp, 2), 1))
        d = Add(lo, Multiply(hi, 256))
        IfCondition GreaterThan(d, 32767) ThenBlock: { d = Subtract(d, 65536) }
        fb = Dereference(Add(syn, SOff.DELAYFB))
        wr = Add(x, Divide(Multiply(d, fb), 256))
        wr = Synth_Clamp16(wr)
        off = Multiply(pos, 2)
        Synth_PackS16(buf, off, wr)
        np = Add(pos, 1)
        IfCondition GreaterEqual(np, cap) ThenBlock: { np = 0 }
        StoreValue(Add(syn, poff), np)
        y = Add(x, Divide(Multiply(d, wet), 256))
        ReturnValue(y)
    }
}

Function.Synth_MixSample {
    Input: syn: Address
    Output: Integer
    Body: {
        n = Dereference(Add(syn, SOff.NVOICE))
        vs = Dereference(Add(syn, SOff.VOICES))
        qual = Dereference(Add(syn, SOff.QUAL))
        accL = 0
        accR = 0
        nact = 0
        i = 0
        WhileLoop LessThan(i, n) {
            v = Add(vs, Multiply(i, SOsc.SIZE))
            st = GetByte(v, SOsc.ENV_ST)
            IfCondition NotEqual(st, SEnv.IDLE) ThenBlock: {
                sm = Synth_VoiceTick(v, qual)
                accL = Add(accL, sm)
                accR = Add(accR, Dereference(Add(v, SOsc.LASTR)))
                nact = Add(nact, 1)
            }
            i = Add(i, 1)
        }
        mg = Dereference(Add(syn, SOff.MIXGAIN))
        accL = Divide(Multiply(accL, mg), 256)
        accR = Divide(Multiply(accR, mg), 256)
        pad = Add(3, Divide(nact, 8))
        IfCondition LessThan(pad, 3) ThenBlock: { pad = 3 }
        accL = Divide(accL, pad)
        accR = Divide(accR, pad)
        accL = Synth_DelayTick(syn, accL, 0)
        accR = Synth_DelayTick(syn, accR, 1)
        accL = Synth_SoftClip(accL)
        accR = Synth_SoftClip(accR)
        StoreValue(Add(syn, SOff.MIXR), accR)
        ReturnValue(accL)
    }
}

Function.Synth_MsToInc {
    Input: syn: Address
    Input: ms: Integer
    Output: Integer
    Body: {
        IfCondition LessEqual(ms, 0) ThenBlock: { ReturnValue(0) }
        rate = Dereference(Add(syn, SOff.RATE))
        samp = Divide(Multiply(rate, ms), 1000)
        IfCondition LessThan(samp, 1) ThenBlock: { ReturnValue(0) }
        ReturnValue(Divide(65536, samp))
    }
}

Function.Synth_SetADSR {
    Input: syn: Address
    Input: index: Integer
    Input: a_ms: Integer
    Input: d_ms: Integer
    Input: s256: Integer
    Input: r_ms: Integer
    Body: {
        v = Synth_Voice(syn, index)
        IfCondition EqualTo(v, 0) ThenBlock: { ReturnValue(0) }
        ai = Synth_MsToInc(syn, a_ms)
        di = Synth_MsToInc(syn, d_ms)
        ri = Synth_MsToInc(syn, r_ms)
        StoreValue(Add(v, SOsc.ATK), ai, "dword")
        StoreValue(Add(v, SOsc.DEC), di, "dword")
        sus = Multiply(s256, 256)
        IfCondition GreaterThan(sus, 65536) ThenBlock: { sus = 65536 }
        StoreValue(Add(v, SOsc.SUS), sus, "dword")
        StoreValue(Add(v, SOsc.REL), ri, "dword")
    }
}

Function.Synth_SetFilter {
    Input: syn: Address
    Input: index: Integer
    Input: cutoff: Integer
    Input: res: Integer
    Body: {
        v = Synth_Voice(syn, index)
        IfCondition EqualTo(v, 0) ThenBlock: { ReturnValue(0) }
        c = cutoff
        IfCondition LessThan(c, 0) ThenBlock: { c = 0 }
        IfCondition GreaterThan(c, 256) ThenBlock: { c = 256 }
        mapped = 65536
        IfCondition LessThan(c, 256) ThenBlock: {
            cc = Multiply(c, c)
            mapped = Add(32, Add(cc, Divide(Multiply(cc, c), 192)))
            IfCondition GreaterThan(mapped, 65000) ThenBlock: { mapped = 65000 }
        }
        StoreValue(Add(v, SOsc.CUTOFF), mapped, "dword")
        r = res
        IfCondition LessThan(r, 0) ThenBlock: { r = 0 }
        IfCondition GreaterThan(r, 240) ThenBlock: { r = 240 }
        StoreValue(Add(v, SOsc.RES), r, "dword")
    }
}

Function.Synth_SetFilterCents {
    Input: syn: Address
    Input: index: Integer
    Input: cents: Integer
    Input: res: Integer
    Body: {
        v = Synth_Voice(syn, index)
        IfCondition EqualTo(v, 0) ThenBlock: { ReturnValue(0) }
        mapped = 65536
        IfCondition LessThan(cents, 13500) ThenBlock: {
            nn = Divide(cents, 100)
            IfCondition LessThan(nn, 0) ThenBlock: { nn = 0 }
            IfCondition GreaterThan(nn, 127) ThenBlock: { nn = 127 }
            mhz = Synth_NoteMilliHz(nn)
            hz = Divide(mhz, 1000)
            mapped = Divide(Multiply(hz, 8577), 1000)
            IfCondition LessThan(mapped, 32) ThenBlock: { mapped = 32 }
            IfCondition GreaterThan(mapped, 65000) ThenBlock: { mapped = 65000 }
        }
        StoreValue(Add(v, SOsc.CUTOFF), mapped, "dword")
        IfCondition LessThan(res, 0) ThenBlock: { res = 0 }
        r = Subtract(96, res)
        IfCondition LessThan(r, 16) ThenBlock: { r = 16 }
        IfCondition GreaterThan(r, 240) ThenBlock: { r = 240 }
        StoreValue(Add(v, SOsc.RES), r, "dword")
    }
}

Function.Synth_SetPitchMod {
    Input: syn: Address
    Input: index: Integer
    Input: cents: Integer
    Body: {
        v = Synth_Voice(syn, index)
        IfCondition EqualTo(v, 0) ThenBlock: { ReturnValue(0) }
        c = cents
        IfCondition LessThan(c, -120) ThenBlock: { c = -120 }
        IfCondition GreaterThan(c, 120) ThenBlock: { c = 120 }
        StoreValue(Add(v, SOsc.PMOD), c)
        Synth_ApplyDetune(v)
    }
}

Function.Synth_SetDetune {
    Input: syn: Address
    Input: index: Integer
    Input: cents: Integer
    Body: {
        v = Synth_Voice(syn, index)
        IfCondition EqualTo(v, 0) ThenBlock: { ReturnValue(0) }
        d = cents
        IfCondition LessThan(d, 0) ThenBlock: { d = 0 }
        IfCondition GreaterThan(d, 80) ThenBlock: { d = 80 }
        StoreValue(Add(v, SOsc.DETUNE), d, "dword")
        Synth_ApplyDetune(v)
    }
}

Function.Synth_SetFenv {
    Input: syn: Address
    Input: index: Integer
    Input: amt: Integer
    Body: {
        v = Synth_Voice(syn, index)
        IfCondition EqualTo(v, 0) ThenBlock: { ReturnValue(0) }
        a = amt
        IfCondition LessThan(a, 0) ThenBlock: { a = 0 }
        IfCondition GreaterThan(a, 256) ThenBlock: { a = 256 }
        StoreValue(Add(v, SOsc.FENV), a, "dword")
    }
}

Function.Synth_SetLFO {
    Input: syn: Address
    Input: index: Integer
    Input: rate: Integer
    Input: pwm: Integer
    Body: {
        v = Synth_Voice(syn, index)
        IfCondition EqualTo(v, 0) ThenBlock: { ReturnValue(0) }
        r = rate
        IfCondition LessThan(r, 0) ThenBlock: { r = 0 }
        IfCondition GreaterThan(r, 256) ThenBlock: { r = 256 }
        p = pwm
        IfCondition LessThan(p, 0) ThenBlock: { p = 0 }
        IfCondition GreaterThan(p, 256) ThenBlock: { p = 256 }
        StoreValue(Add(v, SOsc.LFO_SP), Multiply(r, 11000))
        StoreValue(Add(v, SOsc.LFO_PWM), p, "dword")
    }
}

Function.Synth_SetOsc2 {
    Input: syn: Address
    Input: index: Integer
    Input: wave2: Integer
    Input: mix: Integer
    Input: oct: Integer
    Body: {
        v = Synth_Voice(syn, index)
        IfCondition EqualTo(v, 0) ThenBlock: { ReturnValue(0) }
        w = wave2
        IfCondition LessThan(w, 0) ThenBlock: { w = 0 }
        IfCondition GreaterThan(w, 8) ThenBlock: { w = 8 }
        SetByte(v, SOsc.WAVE2, w)
        m = mix
        IfCondition LessThan(m, 0) ThenBlock: { m = 0 }
        IfCondition GreaterThan(m, 256) ThenBlock: { m = 256 }
        StoreValue(Add(v, SOsc.OSC_MIX), m, "dword")
        o = oct
        IfCondition LessThan(o, 0) ThenBlock: { o = 0 }
        IfCondition GreaterThan(o, 4) ThenBlock: { o = 4 }
        StoreValue(Add(v, SOsc.OSC2OCT), o)
        Synth_ApplyDetune(v)
    }
}

Function.Synth_SetLFOTaps {
    Input: syn: Address
    Input: index: Integer
    Input: to_filt: Integer
    Input: to_amp: Integer
    Body: {
        v = Synth_Voice(syn, index)
        IfCondition EqualTo(v, 0) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(to_filt, 0) ThenBlock: { to_filt = 0 }
        IfCondition GreaterThan(to_filt, 256) ThenBlock: { to_filt = 256 }
        IfCondition LessThan(to_amp, 0) ThenBlock: { to_amp = 0 }
        IfCondition GreaterThan(to_amp, 256) ThenBlock: { to_amp = 256 }
        StoreValue(Add(v, SOsc.LFO_FILT), to_filt, "dword")
        StoreValue(Add(v, SOsc.LFO_AMP), to_amp, "dword")
    }
}

Function.Synth_SetSub {
    Input: syn: Address
    Input: index: Integer
    Input: mix: Integer
    Body: {
        v = Synth_Voice(syn, index)
        IfCondition EqualTo(v, 0) ThenBlock: { ReturnValue(0) }
        m = mix
        IfCondition LessThan(m, 0) ThenBlock: { m = 0 }
        IfCondition GreaterThan(m, 256) ThenBlock: { m = 256 }
        StoreValue(Add(v, SOsc.SUBMIX), m, "dword")
    }
}

Function.Synth_SetDrive {
    Input: syn: Address
    Input: index: Integer
    Input: d: Integer
    Body: {
        v = Synth_Voice(syn, index)
        IfCondition EqualTo(v, 0) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(d, 0) ThenBlock: { d = 0 }
        IfCondition GreaterThan(d, 256) ThenBlock: { d = 256 }
        StoreValue(Add(v, SOsc.DRIVE), d, "dword")
    }
}

Function.Synth_SetDelay {
    Input: syn: Address
    Input: ms: Integer
    Input: fb: Integer
    Input: wet: Integer
    Body: {
        IfCondition EqualTo(syn, 0) ThenBlock: { ReturnValue(0) }
        rate = Dereference(Add(syn, SOff.RATE))
        cap = Dereference(Add(syn, SOff.DELAYCAP))
        len = Divide(Multiply(rate, ms), 1000)
        IfCondition LessThan(len, 0) ThenBlock: { len = 0 }
        IfCondition GreaterEqual(len, cap) ThenBlock: { len = Subtract(cap, 1) }
        StoreValue(Add(syn, SOff.DELAYLEN), len)
        IfCondition LessThan(fb, 0) ThenBlock: { fb = 0 }
        IfCondition GreaterThan(fb, 250) ThenBlock: { fb = 250 }
        IfCondition LessThan(wet, 0) ThenBlock: { wet = 0 }
        IfCondition GreaterThan(wet, 256) ThenBlock: { wet = 256 }
        StoreValue(Add(syn, SOff.DELAYFB), fb)
        StoreValue(Add(syn, SOff.DELAYWET), wet)
    }
}

Function.Synth_SetMixGain {
    Input: syn: Address
    Input: g: Integer
    Body: {
        IfCondition EqualTo(syn, 0) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(g, 0) ThenBlock: { g = 0 }
        IfCondition GreaterThan(g, 512) ThenBlock: { g = 512 }
        StoreValue(Add(syn, SOff.MIXGAIN), g)
    }
}

Function.Synth_WaveSet {
    Input: i: Integer
    Input: val: Integer
    Body: {
        IfCondition EqualTo(SynthG.ok, 0) ThenBlock: { Synth_TabInit() }
        IfCondition LessThan(i, 0) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterThan(i, 31) ThenBlock: { ReturnValue(0) }
        StoreValue(Add(SynthG.userwave, Multiply(i, 8)), val)
    }
}

Function.Synth_WaveGet {
    Input: i: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(SynthG.ok, 0) ThenBlock: { Synth_TabInit() }
        IfCondition LessThan(i, 0) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterThan(i, 31) ThenBlock: { ReturnValue(0) }
        ReturnValue(Dereference(Add(SynthG.userwave, Multiply(i, 8))))
    }
}

Function.Synth_RenderS16 {
    Input: syn: Address
    Input: dst: Address
    Input: frames: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(syn, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(dst, 0) ThenBlock: { ReturnValue(0) }
        f = 0
        WhileLoop LessThan(f, frames) {
            accL = Synth_MixSample(syn)
            accR = Dereference(Add(syn, SOff.MIXR))
            acc = Divide(Add(accL, accR), 2)
            Synth_PackS16(dst, Multiply(f, 2), acc)
            f = Add(f, 1)
        }
        ReturnValue(frames)
    }
}

Function.Synth_PackS16 {
    Input: dst: Address
    Input: off: Integer
    Input: acc: Integer
    Body: {
        IfCondition LessThan(acc, 0) ThenBlock: {
            u = Add(acc, 65536)
            SetByte(dst, off, Modulo(u, 256))
            SetByte(dst, Add(off, 1), Divide(u, 256))
        } ElseBlock: {
            SetByte(dst, off, Modulo(acc, 256))
            SetByte(dst, Add(off, 1), Divide(acc, 256))
        }
    }
}

Function.Synth_RenderS16Stereo {
    Input: syn: Address
    Input: dst: Address
    Input: frames: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(syn, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(dst, 0) ThenBlock: { ReturnValue(0) }
        f = 0
        WhileLoop LessThan(f, frames) {
            accL = Synth_MixSample(syn)
            accR = Dereference(Add(syn, SOff.MIXR))
            off = Multiply(f, 4)
            Synth_PackS16(dst, off, accL)
            Synth_PackS16(dst, Add(off, 2), accR)
            f = Add(f, 1)
        }
        ReturnValue(frames)
    }
}

Function.Synth_UniqueLevels {
    Input: buf: Address
    Input: frames: Integer
    Output: Integer
    Body: {
        seen = Allocate(65536)
        MemorySet(seen, 0, 65536)
        n = 0
        i = 0
        WhileLoop LessThan(i, frames) {
            lo = GetByte(buf, Multiply(i, 2))
            hi = GetByte(buf, Add(Multiply(i, 2), 1))
            u = Add(lo, Multiply(hi, 256))
            IfCondition EqualTo(GetByte(seen, u), 0) ThenBlock: {
                SetByte(seen, u, 1)
                n = Add(n, 1)
            }
            i = Add(i, 1)
        }
        Deallocate(seen, 65536)
        ReturnValue(n)
    }
}

Function.Synth_ZeroCross {
    Input: buf: Address
    Input: frames: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(frames, 2) ThenBlock: { ReturnValue(0) }
        z = 0
        i = 1
        WhileLoop LessThan(i, frames) {
            po = Multiply(Subtract(i, 1), 2)
            co = Multiply(i, 2)
            plo = GetByte(buf, po)
            phi = GetByte(buf, Add(po, 1))
            clo = GetByte(buf, co)
            chi = GetByte(buf, Add(co, 1))
            p = Add(plo, Multiply(phi, 256))
            c = Add(clo, Multiply(chi, 256))
            IfCondition GreaterThan(p, 32767) ThenBlock: { p = Subtract(p, 65536) }
            IfCondition GreaterThan(c, 32767) ThenBlock: { c = Subtract(c, 65536) }
            IfCondition And(LessThan(p, 0), GreaterEqual(c, 0)) ThenBlock: {
                z = Add(z, 1)
            }
            IfCondition And(GreaterEqual(p, 0), LessThan(c, 0)) ThenBlock: {
                z = Add(z, 1)
            }
            i = Add(i, 1)
        }
        ReturnValue(z)
    }
}

Function.Synth_WriteWav16 {
    Input: path: Address
    Input: buf: Address
    Input: frames: Integer
    Input: rate: Integer
    Output: Integer
    Body: {
        data_bytes = Multiply(frames, 2)
        hdr = Allocate(44)
        MemorySet(hdr, 0, 44)
        SetByte(hdr, 0, 82)
        SetByte(hdr, 1, 73)
        SetByte(hdr, 2, 70)
        SetByte(hdr, 3, 70)
        riff = Add(36, data_bytes)
        SetByte(hdr, 4, Modulo(riff, 256))
        SetByte(hdr, 5, Modulo(Divide(riff, 256), 256))
        SetByte(hdr, 6, Modulo(Divide(riff, 65536), 256))
        SetByte(hdr, 7, Modulo(Divide(riff, 16777216), 256))
        SetByte(hdr, 8, 87)
        SetByte(hdr, 9, 65)
        SetByte(hdr, 10, 86)
        SetByte(hdr, 11, 69)
        SetByte(hdr, 12, 102)
        SetByte(hdr, 13, 109)
        SetByte(hdr, 14, 116)
        SetByte(hdr, 15, 32)
        SetByte(hdr, 16, 16)
        SetByte(hdr, 20, 1)
        SetByte(hdr, 22, 1)
        SetByte(hdr, 24, Modulo(rate, 256))
        SetByte(hdr, 25, Modulo(Divide(rate, 256), 256))
        SetByte(hdr, 26, Modulo(Divide(rate, 65536), 256))
        br = Multiply(rate, 2)
        SetByte(hdr, 28, Modulo(br, 256))
        SetByte(hdr, 29, Modulo(Divide(br, 256), 256))
        SetByte(hdr, 30, Modulo(Divide(br, 65536), 256))
        SetByte(hdr, 32, 2)
        SetByte(hdr, 34, 16)
        SetByte(hdr, 36, 100)
        SetByte(hdr, 37, 97)
        SetByte(hdr, 38, 116)
        SetByte(hdr, 39, 97)
        SetByte(hdr, 40, Modulo(data_bytes, 256))
        SetByte(hdr, 41, Modulo(Divide(data_bytes, 256), 256))
        SetByte(hdr, 42, Modulo(Divide(data_bytes, 65536), 256))
        SetByte(hdr, 43, Modulo(Divide(data_bytes, 16777216), 256))
        fd = SystemCall(SSys.SYS_OPEN, path, 577, 420)
        IfCondition LessThan(fd, 0) ThenBlock: {
            Deallocate(hdr, 44)
            ReturnValue(0)
        }
        SystemCall(SSys.SYS_WRITE, fd, hdr, 44)
        SystemCall(SSys.SYS_WRITE, fd, buf, data_bytes)
        SystemCall(SSys.SYS_CLOSE, fd)
        Deallocate(hdr, 44)
        ReturnValue(Add(44, data_bytes))
    }
}
