// =============================================================================
// TABLES
// =============================================================================
Function.Synth_TabInit {
    Body: {
        IfCondition EqualTo(SynthG.ok, 1) ThenBlock: { ReturnValue(0) }
        SynthG.tab = Allocate(520)
        MemorySet(SynthG.tab, 0, 520)
        t = SynthG.tab
        StoreValue(Add(t, 0), 0)
        StoreValue(Add(t, 8), 804)
        StoreValue(Add(t, 16), 1608)
        StoreValue(Add(t, 24), 2410)
        StoreValue(Add(t, 32), 3212)
        StoreValue(Add(t, 40), 4011)
        StoreValue(Add(t, 48), 4808)
        StoreValue(Add(t, 56), 5602)
        StoreValue(Add(t, 64), 6393)
        StoreValue(Add(t, 72), 7179)
        StoreValue(Add(t, 80), 7962)
        StoreValue(Add(t, 88), 8739)
        StoreValue(Add(t, 96), 9512)
        StoreValue(Add(t, 104), 10278)
        StoreValue(Add(t, 112), 11039)
        StoreValue(Add(t, 120), 11793)
        StoreValue(Add(t, 128), 12539)
        StoreValue(Add(t, 136), 13279)
        StoreValue(Add(t, 144), 14010)
        StoreValue(Add(t, 152), 14732)
        StoreValue(Add(t, 160), 15446)
        StoreValue(Add(t, 168), 16151)
        StoreValue(Add(t, 176), 16846)
        StoreValue(Add(t, 184), 17530)
        StoreValue(Add(t, 192), 18204)
        StoreValue(Add(t, 200), 18868)
        StoreValue(Add(t, 208), 19519)
        StoreValue(Add(t, 216), 20159)
        StoreValue(Add(t, 224), 20787)
        StoreValue(Add(t, 232), 21403)
        StoreValue(Add(t, 240), 22005)
        StoreValue(Add(t, 248), 22594)
        StoreValue(Add(t, 256), 23170)
        StoreValue(Add(t, 264), 23731)
        StoreValue(Add(t, 272), 24279)
        StoreValue(Add(t, 280), 24811)
        StoreValue(Add(t, 288), 25329)
        StoreValue(Add(t, 296), 25832)
        StoreValue(Add(t, 304), 26319)
        StoreValue(Add(t, 312), 26790)
        StoreValue(Add(t, 320), 27245)
        StoreValue(Add(t, 328), 27683)
        StoreValue(Add(t, 336), 28105)
        StoreValue(Add(t, 344), 28510)
        StoreValue(Add(t, 352), 28898)
        StoreValue(Add(t, 360), 29268)
        StoreValue(Add(t, 368), 29621)
        StoreValue(Add(t, 376), 29956)
        StoreValue(Add(t, 384), 30273)
        StoreValue(Add(t, 392), 30571)
        StoreValue(Add(t, 400), 30852)
        StoreValue(Add(t, 408), 31113)
        StoreValue(Add(t, 416), 31356)
        StoreValue(Add(t, 424), 31580)
        StoreValue(Add(t, 432), 31785)
        StoreValue(Add(t, 440), 31971)
        StoreValue(Add(t, 448), 32137)
        StoreValue(Add(t, 456), 32285)
        StoreValue(Add(t, 464), 32412)
        StoreValue(Add(t, 472), 32521)
        StoreValue(Add(t, 480), 32609)
        StoreValue(Add(t, 488), 32678)
        StoreValue(Add(t, 496), 32728)
        StoreValue(Add(t, 504), 32757)
        StoreValue(Add(t, 512), 32767)
        SynthG.notehz = Allocate(96)
        nh = SynthG.notehz
        StoreValue(Add(nh, 0), 261626)
        StoreValue(Add(nh, 8), 277183)
        StoreValue(Add(nh, 16), 293665)
        StoreValue(Add(nh, 24), 311127)
        StoreValue(Add(nh, 32), 329628)
        StoreValue(Add(nh, 40), 349228)
        StoreValue(Add(nh, 48), 369994)
        StoreValue(Add(nh, 56), 391995)
        StoreValue(Add(nh, 64), 415305)
        StoreValue(Add(nh, 72), 440000)
        StoreValue(Add(nh, 80), 466164)
        StoreValue(Add(nh, 88), 493883)
        SynthG.userwave = Allocate(256)
        MemorySet(SynthG.userwave, 0, 256)
        ui = 0
        WhileLoop LessThan(ui, 32) {
            StoreValue(Add(SynthG.userwave, Multiply(ui, 8)), Subtract(Multiply(ui, 2048), 32767))
            ui = Add(ui, 1)
        }
        SynthG.ok = 1
    }
}

Function.Synth_SineQ {
    Input: i: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(SynthG.ok, 0) ThenBlock: { Synth_TabInit() }
        IfCondition LessThan(i, 0) ThenBlock: { i = 0 }
        IfCondition GreaterThan(i, 64) ThenBlock: { i = 64 }
        ReturnValue(Dereference(Add(SynthG.tab, Multiply(i, 8))))
    }
}

Function.Synth_Sine8 {
    Input: idx: Integer
    Output: Integer
    Body: {
        x = BitwiseAnd(idx, 255)
        q = Divide(x, 64)
        i = Modulo(x, 64)
        IfCondition EqualTo(q, 0) ThenBlock: {
            v = Synth_SineQ(i)
            ReturnValue(v)
        }
        IfCondition EqualTo(q, 1) ThenBlock: {
            v = Synth_SineQ(Subtract(64, i))
            ReturnValue(v)
        }
        IfCondition EqualTo(q, 2) ThenBlock: {
            v = Synth_SineQ(i)
            ReturnValue(Subtract(0, v))
        }
        v = Synth_SineQ(Subtract(64, i))
        ReturnValue(Subtract(0, v))
    }
}

Function.Synth_SineLerp {
    Input: phase: Integer
    Output: Integer
    Body: {
        idx = BitwiseAnd(Divide(phase, 16777216), 255)
        frac = BitwiseAnd(Divide(phase, 65536), 255)
        s0 = Synth_Sine8(idx)
        s1 = Synth_Sine8(Add(idx, 1))
        d = Subtract(s1, s0)
        ReturnValue(Add(s0, Divide(Multiply(d, frac), 256)))
    }
}

Function.Synth_Quantize {
    Input: s: Integer
    Input: bits: Integer
    Output: Integer
    Body: {
        IfCondition GreaterEqual(bits, 16) ThenBlock: { ReturnValue(s) }
        IfCondition LessThan(bits, 1) ThenBlock: { ReturnValue(0) }
        sh = Subtract(16, bits)
        den = ShiftLeft(1, sh)
        q = Divide(s, den)
        ReturnValue(Multiply(q, den))
    }
}

Function.Synth_Clamp16 {
    Input: s: Integer
    Output: Integer
    Body: {
        IfCondition GreaterThan(s, 32767) ThenBlock: { ReturnValue(32767) }
        IfCondition LessThan(s, -32768) ThenBlock: { ReturnValue(-32768) }
        ReturnValue(s)
    }
}

Function.Synth_HzToStep {
    Input: hz: Integer
    Input: rate: Integer
    Output: Integer
    Body: {
        IfCondition LessEqual(rate, 0) ThenBlock: { ReturnValue(0) }
        IfCondition LessEqual(hz, 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(Divide(Multiply(hz, 4294967296), rate))
    }
}

Function.Synth_HzCoeff {
    Input: hz: Integer
    Input: rate: Integer
    Output: Integer
    Body: {
        rt = rate
        IfCondition LessThan(rt, 8000) ThenBlock: { rt = 48000 }
        IfCondition LessThan(hz, 1) ThenBlock: { hz = 1 }
        c = Divide(Multiply(hz, 411775), rt)
        IfCondition LessThan(c, 32) ThenBlock: { c = 32 }
        IfCondition GreaterThan(c, 65000) ThenBlock: { c = 65000 }
        ReturnValue(c)
    }
}

Function.Synth_SemiCoeff {
    Input: semi_milli: Integer
    Input: rate: Integer
    Output: Integer
    Body: {
        q = semi_milli
        IfCondition LessThan(q, 0) ThenBlock: { q = Subtract(q, 999) }
        note = Add(69, Divide(q, 1000))
        IfCondition LessThan(note, 0) ThenBlock: { note = 0 }
        IfCondition GreaterThan(note, 127) ThenBlock: { note = 127 }
        mhz = Synth_NoteMilliHz(note)
        hz = Divide(mhz, 1000)
        IfCondition LessThan(hz, 1) ThenBlock: { hz = 1 }
        ReturnValue(Synth_HzCoeff(hz, rate))
    }
}

Function.Synth_VoiceClear {
    Input: v: Address
    Body: {
        MemorySet(v, 0, SOsc.SIZE)
        SetByte(v, SOsc.WAVE, 0)
        SetByte(v, SOsc.WAVE2, 0)
        SetByte(v, SOsc.PW, 128)
        StoreValue(Add(v, SOsc.PWPHASE), 2147483648)
        SetByte(v, SOsc.BITS, 16)
        SetByte(v, SOsc.GATE, 0)
        StoreValue(Add(v, SOsc.GAIN), SConst.UNITY, "dword")
        StoreValue(Add(v, SOsc.LFSR), SConst.LFSR_SEED)
        SetByte(v, SOsc.NOTE, 255)
        SetByte(v, SOsc.CH, 0)
        SetByte(v, SOsc.ENV_ST, SEnv.IDLE)
        StoreValue(Add(v, SOsc.ENV_LVL), 0, "dword")
        StoreValue(Add(v, SOsc.ATK), 0, "dword")
        StoreValue(Add(v, SOsc.DEC), 0, "dword")
        StoreValue(Add(v, SOsc.SUS), 65536, "dword")
        StoreValue(Add(v, SOsc.REL), 0, "dword")
        StoreValue(Add(v, SOsc.CUTOFF), 65536, "dword")
        StoreValue(Add(v, SOsc.RES), 0, "dword")
        StoreValue(Add(v, SOsc.STEP2), 0)
        StoreValue(Add(v, SOsc.DETUNE), 0, "dword")
        StoreValue(Add(v, SOsc.FENV), 0, "dword")
        StoreValue(Add(v, SOsc.LFO_SP), 0)
        StoreValue(Add(v, SOsc.LFO_PWM), 0, "dword")
        StoreValue(Add(v, SOsc.SUBMIX), 0, "dword")
        StoreValue(Add(v, SOsc.DRIVE), 0, "dword")
        StoreValue(Add(v, SOsc.OSC_MIX), 0, "dword")
        StoreValue(Add(v, SOsc.OSC2OCT), 2)
        StoreValue(Add(v, SOsc.LFO_FILT), 0, "dword")
        StoreValue(Add(v, SOsc.LFO_AMP), 0, "dword")
        StoreValue(Add(v, SOsc.PMOD), 0)
        StoreValue(Add(v, SOsc.SMP), 0)
        SetByte(v, SOsc.PWBASE, 128)
    }
}

Function.Synth_New {
    Input: nvoices: Integer
    Input: rate: Integer
    Output: Address
    Body: {
        Synth_TabInit()
        IfCondition LessThan(rate, 1) ThenBlock: { rate = 48000 }
        syn = Allocate(SOff.SIZE)
        IfCondition EqualTo(syn, 0) ThenBlock: { ReturnValue(0) }
        MemorySet(syn, 0, SOff.SIZE)
        StoreValue(Add(syn, SOff.MAGIC), SConst.MAGIC)
        StoreValue(Add(syn, SOff.RATE), rate)
        StoreValue(Add(syn, SOff.NVOICE), 0)
        StoreValue(Add(syn, SOff.BITS), 16)
        StoreValue(Add(syn, SOff.QUAL), 1)
        StoreValue(Add(syn, SOff.MIXGAIN), 80)
        StoreValue(Add(syn, SOff.DELAYCAP), 96000)
        dcap = 96000
        dbuf = Allocate(Multiply(dcap, 2))
        MemorySet(dbuf, 0, Multiply(dcap, 2))
        StoreValue(Add(syn, SOff.DELAYBUF), dbuf)
        dbufr = Allocate(Multiply(dcap, 2))
        MemorySet(dbufr, 0, Multiply(dcap, 2))
        StoreValue(Add(syn, SOff.DELAYBUFR), dbufr)
        StoreValue(Add(syn, SOff.DELAYPOS), 0)
        StoreValue(Add(syn, SOff.DELAYPOSR), 0)
        StoreValue(Add(syn, SOff.DELAYLEN), 0)
        StoreValue(Add(syn, SOff.DELAYFB), 0)
        StoreValue(Add(syn, SOff.DELAYWET), 0)
        StoreValue(Add(syn, SOff.NCH), 2)
        lists = AllocateLinkage(LinkagePool.VLists)
        SynthG.lists = lists
        mlists = AllocateLinkage(LinkagePool.MLists)
        SynthG.mlists = mlists
        SynthG.modv = Allocate(256)
        MemorySet(SynthG.modv, 0, 256)
        SynthG.nalloc = 0
        SynthG.allhead = 0
        SynthG.alltail = 0
        slots = Multiply(16, 128)
        cmap_n = Multiply(slots, 8)
        cmap = Allocate(cmap_n)
        MemorySet(cmap, 255, cmap_n)
        SynthG.cmap = cmap
        ReturnValue(syn)
    }
}

Function.Synth_Free {
    Input: syn: Address
    Body: {
        IfCondition EqualTo(syn, 0) ThenBlock: { ReturnValue(0) }
        mag = Dereference(Add(syn, SOff.MAGIC))
        IfCondition NotEqual(mag, SConst.MAGIC) ThenBlock: { ReturnValue(0) }
        vs = Dereference(Add(syn, SOff.VOICES))
        n = Dereference(Add(syn, SOff.NVOICE))
        IfCondition NotEqual(vs, 0) ThenBlock: {
            Deallocate(vs, Multiply(n, SOsc.SIZE))
        }
        act = Dereference(Add(syn, SOff.ACTIVE))
        IfCondition NotEqual(act, 0) ThenBlock: {
            Deallocate(act, Multiply(n, 8))
        }
        dbuf = Dereference(Add(syn, SOff.DELAYBUF))
        dcap = Dereference(Add(syn, SOff.DELAYCAP))
        IfCondition NotEqual(dbuf, 0) ThenBlock: {
            Deallocate(dbuf, Multiply(dcap, 2))
        }
        dbufr = Dereference(Add(syn, SOff.DELAYBUFR))
        IfCondition NotEqual(dbufr, 0) ThenBlock: {
            Deallocate(dbufr, Multiply(dcap, 2))
        }
        StoreValue(Add(syn, SOff.MAGIC), 0)
        Deallocate(syn, SOff.SIZE)
    }
}

Function.Synth_Voice {
    Input: syn: Address
    Input: index: Integer
    Output: Address
    Body: {
        IfCondition EqualTo(syn, 0) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(index, 0) ThenBlock: { ReturnValue(0) }
        node = SynthG.allhead
        i = 0
        voff = PoolFieldOffset(LinkagePool.VNode, "voice")
        aoff = PoolFieldOffset(LinkagePool.VNode, "all")
        WhileLoop NotEqual(node, 0) {
            IfCondition EqualTo(i, index) ThenBlock: {
                ReturnValue(Dereference(Add(node, voff)))
            }
            i = Add(i, 1)
            node = Dereference(Add(node, aoff))
        }
        ReturnValue(0)
    }
}

Function.Synth_Spawn {
    Input: syn: Address
    Output: Address
    Body: {
        lists = SynthG.lists
        IfCondition EqualTo(lists, 0) ThenBlock: { ReturnValue(0) }
        v = Allocate(SOsc.SIZE)
        IfCondition EqualTo(v, 0) ThenBlock: { ReturnValue(0) }
        MemorySet(v, 0, SOsc.SIZE)
        Synth_VoiceClear(v)
        node = AllocateLinkage(LinkagePool.VNode)
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        node@vi = SynthG.nalloc
        node@voice = v
        node@ch = 0
        node@note = 0
        node@all = 0
        aoff = PoolFieldOffset(LinkagePool.VNode, "all")
        IfCondition EqualTo(SynthG.alltail, 0) ThenBlock: {
            SynthG.allhead = node
        } ElseBlock: {
            tail = SynthG.alltail
            StoreValue(Add(tail, aoff), node)
        }
        SynthG.alltail = node
        SynthG.nalloc = Add(SynthG.nalloc, 1)
        StoreValue(Add(syn, SOff.NVOICE), SynthG.nalloc)
        node@next = lists@free
        lists@free = node
        lists@nfree = Add(lists@nfree, 1)
        ReturnValue(node)
    }
}

Function.Synth_LiveCount {
    Output: Integer
    Body: {
        lists = SynthG.lists
        IfCondition EqualTo(lists, 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(lists@nlive)
    }
}

Function.Synth_AllocCount {
    Output: Integer
    Body: {
        ReturnValue(SynthG.nalloc)
    }
}

Function.Synth_TakeClips {
    Output: Integer
    Body: {
        c = SynthG.clips
        SynthG.clips = 0
        ReturnValue(c)
    }
}

Function.Synth_TakePeak {
    Output: Integer
    Body: {
        p = SynthG.peak
        SynthG.peak = 0
        ReturnValue(p)
    }
}

Function.Synth_MapSet {
    Input: ch: Integer
    Input: note: Integer
    Input: vi: Integer
    Body: {
        cmap = SynthG.cmap
        IfCondition EqualTo(cmap, 0) ThenBlock: { ReturnValue(0) }
        chn = BitwiseAnd(ch, 15)
        nt = BitwiseAnd(note, 127)
        off = Multiply(chn, 128)
        off = Add(off, nt)
        off = Multiply(off, 8)
        slot = Add(cmap, off)
        StoreValue(slot, vi)
    }
}

Function.Synth_MapGet {
    Input: ch: Integer
    Input: note: Integer
    Output: Integer
    Body: {
        cmap = SynthG.cmap
        IfCondition EqualTo(cmap, 0) ThenBlock: { ReturnValue(-1) }
        chn = BitwiseAnd(ch, 15)
        nt = BitwiseAnd(note, 127)
        off = Multiply(chn, 128)
        off = Add(off, nt)
        off = Multiply(off, 8)
        slot = Add(cmap, off)
        ReturnValue(Dereference(slot))
    }
}

Function.Synth_VoiceCount {
    Input: syn: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(syn, 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(Dereference(Add(syn, SOff.NVOICE)))
    }
}

Function.Synth_VoiceCh {
    Input: syn: Address
    Input: index: Integer
    Output: Integer
    Body: {
        v = Synth_Voice(syn, index)
        IfCondition EqualTo(v, 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(GetByte(v, SOsc.CH))
    }
}

Function.Synth_SetBits {
    Input: syn: Address
    Input: bits: Integer
    Body: {
        IfCondition EqualTo(syn, 0) ThenBlock: { ReturnValue(0) }
        StoreValue(Add(syn, SOff.BITS), bits)
    }
}

Function.Synth_SetQuality {
    Input: syn: Address
    Input: qual: Integer
    Body: {
        IfCondition EqualTo(syn, 0) ThenBlock: { ReturnValue(0) }
        StoreValue(Add(syn, SOff.QUAL), qual)
    }
}

Function.Synth_VoiceOn {
    Input: syn: Address
    Input: index: Integer
    Input: wave: Integer
    Input: hz: Integer
    Input: vel: Integer
    Body: {
        v = Synth_Voice(syn, index)
        IfCondition EqualTo(v, 0) ThenBlock: { ReturnValue(0) }
        rate = Dereference(Add(syn, SOff.RATE))
        step = Synth_HzToStep(hz, rate)
        StoreValue(v, 0)
        StoreValue(Add(v, SOsc.STEP), step)
        StoreValue(Add(v, SOsc.BASE), step)
        SetByte(v, SOsc.WAVE, wave)
        SetByte(v, SOsc.GATE, 1)
        g = vel
        IfCondition LessThan(g, 0) ThenBlock: { g = 0 }
        IfCondition GreaterThan(g, 127) ThenBlock: { g = 127 }
        StoreValue(Add(v, SOsc.GAIN), Add(1, Multiply(g, 2)), "dword")
        StoreValue(Add(v, SOsc.LFSR), SConst.LFSR_SEED)
        bits = Dereference(Add(syn, SOff.BITS))
        SetByte(v, SOsc.BITS, bits)
        SetByte(v, SOsc.NOTE, 255)
        Synth_ApplyDetune(v)
        StoreValue(Add(v, SOsc.PHASE2), 1073741824)
        Synth_VoiceStartEnv(v)
    }
}

Function.Synth_NoteMilliHz {
    Input: note: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(SynthG.ok, 0) ThenBlock: { Synth_TabInit() }
        n = note
        IfCondition LessThan(n, 0) ThenBlock: { n = 0 }
        IfCondition GreaterThan(n, 127) ThenBlock: { n = 127 }
        pc = Modulo(n, 12)
        oct = Divide(n, 12)
        mhz = Dereference(Add(SynthG.notehz, Multiply(pc, 8)))
        IfCondition GreaterThan(oct, 5) ThenBlock: {
            s = Subtract(oct, 5)
            WhileLoop GreaterThan(s, 0) {
                mhz = Multiply(mhz, 2)
                s = Subtract(s, 1)
            }
        }
        IfCondition LessThan(oct, 5) ThenBlock: {
            s = Subtract(5, oct)
            WhileLoop GreaterThan(s, 0) {
                mhz = Divide(mhz, 2)
                s = Subtract(s, 1)
            }
        }
        ReturnValue(mhz)
    }
}

Function.Synth_VoiceOnNote {
    Input: syn: Address
    Input: index: Integer
    Input: wave: Integer
    Input: note: Integer
    Input: vel: Integer
    Body: {
        v = Synth_Voice(syn, index)
        IfCondition EqualTo(v, 0) ThenBlock: { ReturnValue(0) }
        rate = Dereference(Add(syn, SOff.RATE))
        mhz = Synth_NoteMilliHz(note)
        step = Divide(Multiply(mhz, 4294967296), Multiply(rate, 1000))
        StoreValue(v, 0)
        StoreValue(Add(v, SOsc.STEP), step)
        StoreValue(Add(v, SOsc.BASE), step)
        SetByte(v, SOsc.WAVE, wave)
        SetByte(v, SOsc.GATE, 1)
        g = vel
        IfCondition LessThan(g, 0) ThenBlock: { g = 0 }
        IfCondition GreaterThan(g, 127) ThenBlock: { g = 127 }
        StoreValue(Add(v, SOsc.GAIN), Add(1, Multiply(g, 2)), "dword")
        StoreValue(Add(v, SOsc.LFSR), SConst.LFSR_SEED)
        bits = Dereference(Add(syn, SOff.BITS))
        SetByte(v, SOsc.BITS, bits)
        SetByte(v, SOsc.NOTE, BitwiseAnd(note, 127))
        StoreValue(Add(v, SOsc.VEL), g)
        IfCondition EqualTo(wave, 8) ThenBlock: {
            smp = Dereference(Add(syn, SOff.SAMPLE))
            StoreValue(Add(v, SOsc.SMP), smp)
            st = Smp_Step(smp, note, rate)
            StoreValue(Add(v, SOsc.STEP), st)
            StoreValue(Add(v, SOsc.BASE), st)
        }
        Synth_ApplyDetune(v)
        StoreValue(Add(v, SOsc.PHASE2), 1073741824)
        Synth_VoiceStartEnv(v)
    }
}

Function.Synth_SetBankSample {
    Input: syn: Address
    Input: smp: Address
    Body: {
        IfCondition EqualTo(syn, 0) ThenBlock: { ReturnValue(0) }
        StoreValue(Add(syn, SOff.SAMPLE), smp)
    }
}

Function.Synth_RetuneSample {
    Input: syn: Address
    Input: index: Integer
    Input: note: Integer
    Body: {
        v = Synth_Voice(syn, index)
        IfCondition EqualTo(v, 0) ThenBlock: { ReturnValue(0) }
        smp = Dereference(Add(v, SOsc.SMP))
        IfCondition EqualTo(smp, 0) ThenBlock: { ReturnValue(0) }
        rate = Dereference(Add(syn, SOff.RATE))
        root = SF2_LastRoot()
        coarse = SF2_LastCoarse()
        fine = SF2_LastFine()
        scale = SF2_LastScale()
        d = coarse
        IfCondition GreaterThan(scale, 0) ThenBlock: {
            dk = Subtract(note, root)
            dk = Divide(Multiply(dk, scale), 100)
            d = Add(dk, coarse)
        }
        st = Smp_StepD(smp, d, rate)
        fine = SF2_S32(fine)
        IfCondition GreaterThan(fine, 1200) ThenBlock: { fine = 1200 }
        IfCondition LessThan(fine, -1200) ThenBlock: { fine = -1200 }
        IfCondition NotEqual(fine, 0) ThenBlock: {
            add = Divide(Multiply(st, fine), 1731)
            st = Add(st, add)
            IfCondition LessThan(st, 1) ThenBlock: { st = 1 }
        }
        StoreValue(Add(v, SOsc.STEP), st)
        StoreValue(Add(v, SOsc.BASE), st)
        StoreValue(Add(v, SOsc.STEP2), 0)
    }
}

Function.Synth_VoiceOnPack {
    Input: syn: Address
    Input: index: Integer
    Input: smp: Address
    Input: note: Integer
    Input: vel: Integer
    Body: {
        IfCondition NotEqual(smp, 0) ThenBlock: {
            Synth_SetBankSample(syn, smp)
            StoreValue(Add(smp, 32), note)
        }
        Synth_VoiceOnNote(syn, index, 8, note, vel)
        dms = SynthG.pack_dec
        rms = SynthG.pack_rel
        IfCondition LessThan(dms, 0) ThenBlock: { dms = 0 }
        IfCondition LessThan(rms, 1) ThenBlock: { rms = 5 }
        rate = Dereference(Add(syn, SOff.RATE))
        IfCondition LessThan(rate, 8000) ThenBlock: { rate = 48000 }
        den = Multiply(dms, rate)
        rlen = Divide(Multiply(rate, rms), 1000)
        IfCondition LessThan(rlen, 1) ThenBlock: { rlen = 1 }
        Synth_SetFilter(syn, index, 256, 0)
        v = Synth_Voice(syn, index)
        IfCondition NotEqual(v, 0) ThenBlock: {
            StoreValue(Add(v, SOsc.STEP), 65536)
            StoreValue(Add(v, SOsc.BASE), 65536)
            StoreValue(Add(v, SOsc.DRIVE), 0, "dword")
            StoreValue(Add(v, SOsc.FENV), 0, "dword")
            StoreValue(Add(v, SOsc.SUBMIX), 0, "dword")
            StoreValue(Add(v, SOsc.DEC), den)
            StoreValue(Add(v, SOsc.REL), rlen)
            StoreValue(Add(v, SOsc.ENV_LVL), 65536, "dword")
            SetByte(v, SOsc.ENV_ST, SEnv.DECAY)
            StoreValue(Add(v, SOsc.PENV), 1)
            StoreValue(Add(v, SOsc.DREM), 0)
            StoreValue(Add(v, SOsc.RFROM), 0)
            StoreValue(Add(v, SOsc.RPOS), 0)
        }
    }
}

Function.Synth_VoiceOnSample {
    Input: syn: Address
    Input: index: Integer
    Input: smp: Address
    Input: note: Integer
    Input: vel: Integer
    Body: {
        IfCondition NotEqual(smp, 0) ThenBlock: {
            Synth_SetBankSample(syn, smp)
        }
        Synth_VoiceOnNote(syn, index, 8, note, vel)
        Synth_RetuneSample(syn, index, note)
        Synth_SetADSR(syn, index, 2, 0, 256, 450)
        md = SF2_LastMode()
        IfCondition EqualTo(md, 3) ThenBlock: { md = 1 }
        IfCondition NotEqual(smp, 0) ThenBlock: {
            already = Dereference(Add(smp, 56))
            IfCondition NotEqual(already, 1) ThenBlock: {
                l0 = Dereference(Add(smp, 40))
                l1 = Dereference(Add(smp, 48))
                Smp_SetLoop(smp, l0, l1, md)
            }
        }
        v = Synth_Voice(syn, index)
        IfCondition NotEqual(v, 0) ThenBlock: {
            StoreValue(Add(v, SOsc.DRIVE), 0, "dword")
            StoreValue(Add(v, SOsc.FENV), 0, "dword")
            StoreValue(Add(v, SOsc.SUBMIX), 0, "dword")
            StoreValue(Add(v, SOsc.LFO_FILT), 0, "dword")
            StoreValue(Add(v, SOsc.LFO_AMP), 0, "dword")
            StoreValue(Add(v, SOsc.LFO_PWM), 0, "dword")
            StoreValue(Add(v, SOsc.LFO_SP), 0)
        }
    }
}

Function.Synth_ApplyDetune {
    Input: v: Address
    Body: {
        base = Dereference(Add(v, SOsc.BASE))
        IfCondition EqualTo(base, 0) ThenBlock: {
            base = Dereference(Add(v, SOsc.STEP))
        }
        pmod = Dereference(Add(v, SOsc.PMOD))
        IfCondition NotEqual(pmod, 0) ThenBlock: {
            bend = Divide(Multiply(base, pmod), 1732)
            base = Add(base, bend)
        }
        det = Dereference(Add(v, SOsc.DETUNE), "dword")
        extra = 0
        IfCondition GreaterThan(det, 0) ThenBlock: {
            extra = Divide(Multiply(base, det), 1732)
        }
        half = Divide(extra, 2)
        IfCondition GreaterThan(det, 0) ThenBlock: {
            IfCondition LessThan(half, 1) ThenBlock: { half = 1 }
            StoreValue(Add(v, SOsc.STEP), Subtract(base, half))
        } ElseBlock: {
            StoreValue(Add(v, SOsc.STEP), base)
        }
        st2 = Add(base, half)
        o2 = Dereference(Add(v, SOsc.OSC2OCT))
        IfCondition GreaterThan(o2, 2) ThenBlock: {
            sh = Subtract(o2, 2)
            st2 = Multiply(st2, ShiftLeft(1, sh))
        }
        IfCondition LessThan(o2, 2) ThenBlock: {
            sh = Subtract(2, o2)
            st2 = Divide(st2, ShiftLeft(1, sh))
        }
        IfCondition EqualTo(det, 0) ThenBlock: {
            IfCondition EqualTo(o2, 2) ThenBlock: {
                StoreValue(Add(v, SOsc.STEP2), 0)
                ReturnValue(0)
            }
        }
        StoreValue(Add(v, SOsc.STEP2), st2)
    }
}

Function.Synth_ActiveClear {
    Input: syn: Address
    Body: {
        lists = SynthG.lists
        IfCondition EqualTo(lists, 0) ThenBlock: { ReturnValue(0) }
        node = lists@live
        WhileLoop NotEqual(node, 0) {
            nxt = node@next
            vi = node@vi
            Synth_VoiceOff(syn, vi)
            node@next = lists@free
            lists@free = node
            lists@nfree = Add(lists@nfree, 1)
            node = nxt
        }
        lists@live = 0
        lists@nlive = 0
        cmap = SynthG.cmap
        IfCondition NotEqual(cmap, 0) ThenBlock: {
            slots = Multiply(16, 128)
            cmap_n = Multiply(slots, 8)
            MemorySet(cmap, 255, cmap_n)
        }
    }
}

Function.Synth_AllocVoice {
    Input: syn: Address
    Input: note: Integer
    Input: ch: Integer
    Output: Integer
    Body: {
        lists = SynthG.lists
        IfCondition EqualTo(lists, 0) ThenBlock: { ReturnValue(0) }
        chn = ch
        IfCondition LessThan(chn, 0) ThenBlock: { chn = 0 }
        want = BitwiseAnd(note, 127)
        vi = Synth_MapGet(chn, want)
        IfCondition GreaterEqual(vi, 0) ThenBlock: {
            v = Synth_Voice(syn, vi)
            hit = 0
            IfCondition NotEqual(v, 0) ThenBlock: {
                est = GetByte(v, SOsc.ENV_ST)
                IfCondition NotEqual(est, SEnv.IDLE) ThenBlock: { hit = 1 }
            }
            IfCondition EqualTo(hit, 1) ThenBlock: {
                SetByte(v, SOsc.GATE, 0)
                SetByte(v, SOsc.ENV_ST, SEnv.RELEASE)
                Synth_FegRelease(v)
            }
        }
        IfCondition LessThan(lists@nfree, 1) ThenBlock: {
            spawned = Synth_Spawn(syn)
            IfCondition EqualTo(spawned, 0) ThenBlock: {
            best = 0
            best_lvl = 0
            best_rank = -1
            node = lists@live
            WhileLoop NotEqual(node, 0) {
                vi = node@vi
                v = Synth_Voice(syn, vi)
                lvl = 0
                st = 0
                gate = 0
                IfCondition NotEqual(v, 0) ThenBlock: {
                    lvl = Dereference(Add(v, SOsc.ENV_LVL), "dword")
                    st = GetByte(v, SOsc.ENV_ST)
                    gate = GetByte(v, SOsc.GATE)
                }
                rank = 0
                IfCondition EqualTo(gate, 0) ThenBlock: { rank = 1 }
                IfCondition EqualTo(st, SEnv.RELEASE) ThenBlock: { rank = 2 }
                take = 0
                IfCondition GreaterThan(rank, best_rank) ThenBlock: { take = 1 }
                IfCondition EqualTo(rank, best_rank) ThenBlock: {
                    IfCondition LessEqual(lvl, best_lvl) ThenBlock: { take = 1 }
                }
                IfCondition EqualTo(take, 1) ThenBlock: {
                    best = vi
                    best_lvl = lvl
                    best_rank = rank
                }
                node = node@next
            }
            own = lists@live
            WhileLoop NotEqual(own, 0) {
                ovi = own@vi
                IfCondition EqualTo(ovi, best) ThenBlock: {
                    Synth_MapSet(own@ch, own@note, -1)
                    own@ch = chn
                    own@note = want
                    own = 0
                }
                IfCondition NotEqual(own, 0) ThenBlock: {
                    own = own@next
                }
            }
            v = Synth_Voice(syn, best)
            IfCondition NotEqual(v, 0) ThenBlock: {
                SetByte(v, SOsc.CH, BitwiseAnd(chn, 255))
                StoreValue(Add(v, SOsc.TRACK), chn)
            }
            Synth_MapSet(chn, want, best)
            ReturnValue(best)
            }
        }
        node = lists@free
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        lists@free = node@next
        lists@nfree = Subtract(lists@nfree, 1)
        vi = node@vi
        v = Synth_Voice(syn, vi)
        IfCondition NotEqual(v, 0) ThenBlock: {
            Synth_VoiceClear(v)
            SetByte(v, SOsc.CH, BitwiseAnd(chn, 255))
            StoreValue(Add(v, SOsc.TRACK), chn)
        }
        node@ch = chn
        node@note = want
        node@next = lists@live
        lists@live = node
        lists@nlive = Add(lists@nlive, 1)
        Synth_MapSet(chn, want, vi)
        ReturnValue(vi)
    }
}

Function.Synth_NoteOff {
    Input: syn: Address
    Input: note: Integer
    Input: ch: Integer
    Body: {
        chn = ch
        IfCondition LessThan(chn, 0) ThenBlock: { chn = 0 }
        want = BitwiseAnd(note, 127)
        vi = Synth_MapGet(chn, want)
        IfCondition LessThan(vi, 0) ThenBlock: {
            lists = SynthG.lists
            IfCondition EqualTo(lists, 0) ThenBlock: { ReturnValue(0) }
            node = lists@live
            WhileLoop NotEqual(node, 0) {
                IfCondition EqualTo(node@ch, chn) ThenBlock: {
                    IfCondition EqualTo(node@note, want) ThenBlock: {
                        vi = node@vi
                        node = 0
                    }
                }
                IfCondition NotEqual(node, 0) ThenBlock: { node = node@next }
            }
            IfCondition LessThan(vi, 0) ThenBlock: { ReturnValue(0) }
        }
        v = Synth_Voice(syn, vi)
        IfCondition EqualTo(v, 0) ThenBlock: { ReturnValue(0) }
        SetByte(v, SOsc.GATE, 0)
        Synth_FegRelease(v)
        rel = Dereference(Add(v, SOsc.REL), "dword")
        IfCondition EqualTo(rel, 0) ThenBlock: {
            SetByte(v, SOsc.ENV_ST, SEnv.IDLE)
            StoreValue(Add(v, SOsc.ENV_LVL), 0, "dword")
            SetByte(v, SOsc.NOTE, 255)
            Synth_MapSet(chn, want, -1)
        } ElseBlock: {
            SetByte(v, SOsc.ENV_ST, SEnv.RELEASE)
        }
    }
}

Function.Synth_VoiceOff {
    Input: syn: Address
    Input: index: Integer
    Body: {
        v = Synth_Voice(syn, index)
        IfCondition EqualTo(v, 0) ThenBlock: { ReturnValue(0) }
        SetByte(v, SOsc.GATE, 0)
        Synth_FegRelease(v)
        rel = Dereference(Add(v, SOsc.REL), "dword")
        IfCondition EqualTo(rel, 0) ThenBlock: {
            SetByte(v, SOsc.ENV_ST, SEnv.IDLE)
            StoreValue(Add(v, SOsc.ENV_LVL), 0, "dword")
            SetByte(v, SOsc.NOTE, 255)
        } ElseBlock: {
            SetByte(v, SOsc.ENV_ST, SEnv.RELEASE)
        }
    }
}

Function.Synth_ReleaseAll {
    Input: syn: Address
    Body: {
        lists = SynthG.lists
        IfCondition EqualTo(lists, 0) ThenBlock: { ReturnValue(0) }
        node = lists@live
        WhileLoop NotEqual(node, 0) {
            nxt = node@next
            vi = node@vi
            v = Synth_Voice(syn, vi)
            IfCondition NotEqual(v, 0) ThenBlock: {
                st = GetByte(v, SOsc.ENV_ST)
                IfCondition NotEqual(st, SEnv.IDLE) ThenBlock: {
                    Synth_VoiceOff(syn, vi)
                }
            }
            node = nxt
        }
    }
}

Function.Synth_SetPulse {
    Input: syn: Address
    Input: index: Integer
    Input: pw: Integer
    Body: {
        v = Synth_Voice(syn, index)
        IfCondition EqualTo(v, 0) ThenBlock: { ReturnValue(0) }
        p = pw
        IfCondition LessThan(p, 1) ThenBlock: { p = 1 }
        IfCondition GreaterThan(p, 65535) ThenBlock: { p = 65535 }
        phase = Multiply(p, 16777216)
        IfCondition GreaterThan(p, 256) ThenBlock: {
            phase = Multiply(p, 65536)
        }
        IfCondition LessThan(phase, 16777216) ThenBlock: { phase = 16777216 }
        IfCondition GreaterThan(phase, 4278190080) ThenBlock: { phase = 4278190080 }
        pb = Divide(phase, 16777216)
        IfCondition GreaterThan(pb, 255) ThenBlock: { pb = 255 }
        SetByte(v, SOsc.PW, pb)
        SetByte(v, SOsc.PWBASE, pb)
        StoreValue(Add(v, SOsc.PWPHASE), phase)
    }
}

Function.Synth_SetWave {
    Input: syn: Address
    Input: index: Integer
    Input: wave: Integer
    Body: {
        v = Synth_Voice(syn, index)
        IfCondition EqualTo(v, 0) ThenBlock: { ReturnValue(0) }
        w = wave
        IfCondition LessThan(w, 0) ThenBlock: { w = 0 }
        IfCondition GreaterThan(w, 8) ThenBlock: { w = 8 }
        SetByte(v, SOsc.WAVE, w)
    }
}

Function.Synth_NoiseTick {
    Input: v: Address
    Output: Integer
    Body: {
        r = Dereference(Add(v, SOsc.LFSR))
        IfCondition EqualTo(r, 0) ThenBlock: { r = 1 }
        b0 = BitwiseAnd(r, 1)
        b1 = BitwiseAnd(Divide(r, 2), 1)
        xor = BitwiseAnd(Add(b0, b1), 1)
        r = Add(Divide(r, 2), ShiftLeft(xor, 14))
        StoreValue(Add(v, SOsc.LFSR), r)
        IfCondition EqualTo(b0, 1) ThenBlock: { ReturnValue(32767) }
        ReturnValue(-32767)
    }
}

Function.Synth_PolyBLEP {
    Input: ph: Integer
    Input: dt: Integer
    Output: Integer
    Body: {
        IfCondition LessEqual(dt, 0) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(ph, dt) ThenBlock: {
            x = Divide(Multiply(ph, 32768), dt)
            xx = Divide(Multiply(x, x), 32768)
            y = Subtract(Subtract(Multiply(x, 2), xx), 32768)
            ReturnValue(Divide(Multiply(y, 32767), 32768))
        }
        wrap = Add(ph, dt)
        IfCondition GreaterEqual(wrap, 4294967296) ThenBlock: {
            u = Subtract(4294967296, ph)
            x = Divide(Multiply(u, 32768), dt)
            xx = Divide(Multiply(x, x), 32768)
            y = Add(Subtract(32768, Multiply(x, 2)), xx)
            ReturnValue(Divide(Multiply(y, 32767), 32768))
        }
        ReturnValue(0)
    }
}

Function.Synth_WaveAt {
    Input: v: Address
    Input: ph: Integer
    Input: dt: Integer
    Input: qual: Integer
    Output: Integer
    Body: {
        wv = GetByte(v, SOsc.WAVE)
        IfCondition EqualTo(wv, 0) ThenBlock: {
            p32 = BitwiseAnd(ph, 4294967295)
            fp = Float_FromInt(p32)
            den = Float_FromInt(4294967296)
            ang = Float_Div(fp, den)
            pi = 0x400921FB54442D18
            two = Float_FromInt(2)
            twopi = Float_Mul(two, pi)
            ang = Float_Mul(ang, twopi)
            s = Float_Sin(ang)
            amp = Float_FromInt(32767)
            s = Float_Mul(s, amp)
            ReturnValue(Float_ToInt(s))
        }
        IfCondition EqualTo(wv, 1) ThenBlock: {
            s = -32767
            IfCondition LessThan(ph, 2147483648) ThenBlock: { s = 32767 }
            b0 = Synth_PolyBLEP(ph, dt)
            ph2 = ph
            IfCondition LessThan(ph2, 2147483648) ThenBlock: {
                ph2 = Add(ph2, 2147483648)
            } ElseBlock: {
                ph2 = Subtract(ph2, 2147483648)
            }
            b1 = Synth_PolyBLEP(ph2, dt)
            ReturnValue(Subtract(Add(s, b0), b1))
        }
        IfCondition EqualTo(wv, 2) ThenBlock: {
            edge = Dereference(Add(v, SOsc.PWPHASE))
            IfCondition LessThan(edge, 16777216) ThenBlock: { edge = 16777216 }
            IfCondition GreaterThan(edge, 4278190080) ThenBlock: { edge = 4278190080 }
            s = -32767
            IfCondition LessThan(ph, edge) ThenBlock: { s = 32767 }
            b0 = Synth_PolyBLEP(ph, dt)
            ph2 = Subtract(ph, edge)
            IfCondition LessThan(ph2, 0) ThenBlock: { ph2 = Add(ph2, 4294967296) }
            b1 = Synth_PolyBLEP(ph2, dt)
            ReturnValue(Subtract(Add(s, b0), b1))
        }
        IfCondition EqualTo(wv, 3) ThenBlock: {
            naive = Subtract(Divide(ph, 65536), 32768)
            b = Synth_PolyBLEP(ph, dt)
            ReturnValue(Subtract(naive, b))
        }
        IfCondition EqualTo(wv, 4) ThenBlock: {
            p = Divide(ph, 65536)
            IfCondition GreaterEqual(p, 32768) ThenBlock: {
                p = Subtract(65535, p)
            }
            ReturnValue(Subtract(Multiply(p, 2), 32767))
        }
        IfCondition EqualTo(wv, 5) ThenBlock: {
            n = Synth_NoiseTick(v)
            ReturnValue(n)
        }
        IfCondition EqualTo(wv, 6) ThenBlock: {
            step = BitwiseAnd(Divide(ph, 134217728), 31)
            IfCondition LessThan(step, 16) ThenBlock: {
                ReturnValue(Multiply(Subtract(step, 8), 4096))
            }
            ReturnValue(Multiply(Subtract(23, step), 4096))
        }
        IfCondition EqualTo(wv, 7) ThenBlock: {
            idx = BitwiseAnd(Divide(ph, 134217728), 31)
            frac = BitwiseAnd(Divide(ph, 524288), 255)
            s0 = Dereference(Add(SynthG.userwave, Multiply(idx, 8)))
            nidx = BitwiseAnd(Add(idx, 1), 31)
            s1 = Dereference(Add(SynthG.userwave, Multiply(nidx, 8)))
            d = Subtract(s1, s0)
            ReturnValue(Add(s0, Divide(Multiply(d, frac), 256)))
        }
        IfCondition EqualTo(wv, 8) ThenBlock: {
            smp = Dereference(Add(v, SOsc.SMP))
            s = Smp_TickCh(smp, ph, 0, qual)
            ReturnValue(s)
        }
        ReturnValue(0)
    }
}

Function.Synth_OscRaw {
    Input: v: Address
    Input: qual: Integer
    Output: Integer
    Body: {
        ph = Dereference(v)
        dt = Dereference(Add(v, SOsc.STEP))
        s = Synth_WaveAt(v, ph, dt, qual)
        ReturnValue(s)
    }
}

Function.Synth_VoiceStartEnv {
    Input: v: Address
    Body: {
        atk = Dereference(Add(v, SOsc.ATK), "dword")
        IfCondition EqualTo(atk, 0) ThenBlock: {
            StoreValue(Add(v, SOsc.ENV_LVL), 65536, "dword")
            dec = Dereference(Add(v, SOsc.DEC), "dword")
            IfCondition EqualTo(dec, 0) ThenBlock: {
                sus = Dereference(Add(v, SOsc.SUS), "dword")
                StoreValue(Add(v, SOsc.ENV_LVL), sus, "dword")
                SetByte(v, SOsc.ENV_ST, SEnv.SUSTAIN)
            } ElseBlock: {
                SetByte(v, SOsc.ENV_ST, SEnv.DECAY)
            }
        } ElseBlock: {
            StoreValue(Add(v, SOsc.ENV_LVL), 0, "dword")
            SetByte(v, SOsc.ENV_ST, SEnv.ATTACK)
        }
        StoreValue(Add(v, SOsc.FILT_LP), 0)
        StoreValue(Add(v, SOsc.FILT_BP), 0)
        StoreValue(Add(v, SOsc.FILT_LPR), 0)
        StoreValue(Add(v, SOsc.FILT_BPR), 0)
        StoreValue(Add(v, SOsc.LASTR), 0)
        StoreValue(Add(v, SOsc.LFO_PH), 0)
        StoreValue(Add(v, SOsc.ENVREM), 0)
    }
}

Function.Synth_EnvTick {
    Input: v: Address
    Output: Integer
    Body: {
        st = GetByte(v, SOsc.ENV_ST)
        IfCondition EqualTo(st, SEnv.IDLE) ThenBlock: { ReturnValue(0) }
        lvl = Dereference(Add(v, SOsc.ENV_LVL), "dword")
        IfCondition EqualTo(st, SEnv.ATTACK) ThenBlock: {
            samp = Dereference(Add(v, SOsc.ATK), "dword")
            IfCondition LessThan(samp, 1) ThenBlock: {
                lvl = 65536
                SetByte(v, SOsc.ENV_ST, SEnv.DECAY)
                StoreValue(Add(v, SOsc.ENVREM), 0)
            } ElseBlock: {
                rem = Dereference(Add(v, SOsc.ENVREM))
                rem = Add(rem, 65536)
                step = Divide(rem, samp)
                rem = Modulo(rem, samp)
                StoreValue(Add(v, SOsc.ENVREM), rem)
                lvl = Add(lvl, step)
                IfCondition GreaterEqual(lvl, 65536) ThenBlock: {
                    lvl = 65536
                    SetByte(v, SOsc.ENV_ST, SEnv.DECAY)
                    StoreValue(Add(v, SOsc.ENVREM), 0)
                }
            }
        }
        IfCondition EqualTo(GetByte(v, SOsc.ENV_ST), SEnv.DECAY) ThenBlock: {
            sus = Dereference(Add(v, SOsc.SUS), "dword")
            samp = Dereference(Add(v, SOsc.DEC), "dword")
            IfCondition LessThan(samp, 1) ThenBlock: {
                lvl = sus
                SetByte(v, SOsc.ENV_ST, SEnv.SUSTAIN)
                StoreValue(Add(v, SOsc.ENVREM), 0)
            } ElseBlock: {
                rem = Dereference(Add(v, SOsc.ENVREM))
                rem = Add(rem, 65536)
                step = Divide(rem, samp)
                rem = Modulo(rem, samp)
                StoreValue(Add(v, SOsc.ENVREM), rem)
                IfCondition GreaterThan(lvl, sus) ThenBlock: {
                    lvl = Subtract(lvl, step)
                    IfCondition LessThan(lvl, sus) ThenBlock: { lvl = sus }
                }
                IfCondition LessEqual(lvl, sus) ThenBlock: {
                    lvl = sus
                    StoreValue(Add(v, SOsc.ENVREM), 0)
                    IfCondition EqualTo(sus, 0) ThenBlock: {
                        SetByte(v, SOsc.ENV_ST, SEnv.IDLE)
                        SetByte(v, SOsc.NOTE, 255)
                        SetByte(v, SOsc.GATE, 0)
                    } ElseBlock: {
                        SetByte(v, SOsc.ENV_ST, SEnv.SUSTAIN)
                    }
                }
            }
        }
        IfCondition EqualTo(GetByte(v, SOsc.ENV_ST), SEnv.RELEASE) ThenBlock: {
            samp = Dereference(Add(v, SOsc.REL), "dword")
            IfCondition LessThan(samp, 1) ThenBlock: {
                lvl = 0
                SetByte(v, SOsc.ENV_ST, SEnv.IDLE)
                SetByte(v, SOsc.NOTE, 255)
                StoreValue(Add(v, SOsc.ENVREM), 0)
            } ElseBlock: {
                rem = Dereference(Add(v, SOsc.ENVREM))
                rem = Add(rem, 65536)
                step = Divide(rem, samp)
                rem = Modulo(rem, samp)
                StoreValue(Add(v, SOsc.ENVREM), rem)
                IfCondition GreaterThan(lvl, step) ThenBlock: {
                    lvl = Subtract(lvl, step)
                } ElseBlock: {
                    lvl = 0
                    SetByte(v, SOsc.ENV_ST, SEnv.IDLE)
                    SetByte(v, SOsc.NOTE, 255)
                    StoreValue(Add(v, SOsc.ENVREM), 0)
                }
            }
        }
        StoreValue(Add(v, SOsc.ENV_LVL), lvl, "dword")
        ReturnValue(lvl)
    }
}

Function.Synth_FegTick {
    Input: v: Address
    Body: {
        st = GetByte(v, SOsc.FEG_ST)
        IfCondition EqualTo(st, SEnv.IDLE) ThenBlock: { ReturnValue(0) }
        lvl = Dereference(Add(v, SOsc.FEG_LVL))
        IfCondition EqualTo(st, SEnv.ATTACK) ThenBlock: {
            samp = Dereference(Add(v, SOsc.FEG_ATK))
            IfCondition LessThan(samp, 1) ThenBlock: {
                lvl = 65536
                SetByte(v, SOsc.FEG_ST, SEnv.DECAY)
                StoreValue(Add(v, SOsc.FEG_REM), 0)
            } ElseBlock: {
                rem = Dereference(Add(v, SOsc.FEG_REM))
                rem = Add(rem, 65536)
                step = Divide(rem, samp)
                rem = Modulo(rem, samp)
                StoreValue(Add(v, SOsc.FEG_REM), rem)
                lvl = Add(lvl, step)
                IfCondition GreaterEqual(lvl, 65536) ThenBlock: {
                    lvl = 65536
                    SetByte(v, SOsc.FEG_ST, SEnv.DECAY)
                    StoreValue(Add(v, SOsc.FEG_REM), 0)
                }
            }
        }
        IfCondition EqualTo(GetByte(v, SOsc.FEG_ST), SEnv.DECAY) ThenBlock: {
            sus = Dereference(Add(v, SOsc.FEG_SUS))
            samp = Dereference(Add(v, SOsc.FEG_DEC))
            IfCondition LessThan(samp, 1) ThenBlock: {
                lvl = sus
                StoreValue(Add(v, SOsc.FEG_REM), 0)
                IfCondition EqualTo(sus, 0) ThenBlock: {
                    SetByte(v, SOsc.FEG_ST, SEnv.IDLE)
                } ElseBlock: {
                    SetByte(v, SOsc.FEG_ST, SEnv.SUSTAIN)
                }
            } ElseBlock: {
                rem = Dereference(Add(v, SOsc.FEG_REM))
                rem = Add(rem, 65536)
                step = Divide(rem, samp)
                rem = Modulo(rem, samp)
                StoreValue(Add(v, SOsc.FEG_REM), rem)
                IfCondition GreaterThan(lvl, sus) ThenBlock: {
                    lvl = Subtract(lvl, step)
                    IfCondition LessThan(lvl, sus) ThenBlock: { lvl = sus }
                }
                IfCondition LessEqual(lvl, sus) ThenBlock: {
                    lvl = sus
                    StoreValue(Add(v, SOsc.FEG_REM), 0)
                    IfCondition EqualTo(sus, 0) ThenBlock: {
                        SetByte(v, SOsc.FEG_ST, SEnv.IDLE)
                    } ElseBlock: {
                        SetByte(v, SOsc.FEG_ST, SEnv.SUSTAIN)
                    }
                }
            }
        }
        IfCondition EqualTo(GetByte(v, SOsc.FEG_ST), SEnv.RELEASE) ThenBlock: {
            samp = Dereference(Add(v, SOsc.FEG_REL))
            IfCondition LessThan(samp, 1) ThenBlock: {
                lvl = 0
                SetByte(v, SOsc.FEG_ST, SEnv.IDLE)
                StoreValue(Add(v, SOsc.FEG_REM), 0)
            } ElseBlock: {
                rem = Dereference(Add(v, SOsc.FEG_REM))
                rem = Add(rem, 65536)
                step = Divide(rem, samp)
                rem = Modulo(rem, samp)
                StoreValue(Add(v, SOsc.FEG_REM), rem)
                IfCondition GreaterThan(lvl, step) ThenBlock: {
                    lvl = Subtract(lvl, step)
                } ElseBlock: {
                    lvl = 0
                    SetByte(v, SOsc.FEG_ST, SEnv.IDLE)
                    StoreValue(Add(v, SOsc.FEG_REM), 0)
                }
            }
        }
        StoreValue(Add(v, SOsc.FEG_LVL), lvl)
        ReturnValue(lvl)
    }
}

Function.Synth_FegRelease {
    Input: v: Address
    Body: {
        IfCondition EqualTo(v, 0) ThenBlock: { ReturnValue(0) }
        amt = Dereference(Add(v, SOsc.FEG_AMT))
        IfCondition EqualTo(amt, 0) ThenBlock: { ReturnValue(0) }
        st = GetByte(v, SOsc.FEG_ST)
        IfCondition EqualTo(st, SEnv.IDLE) ThenBlock: { ReturnValue(0) }
        rel = Dereference(Add(v, SOsc.FEG_REL))
        IfCondition LessThan(rel, 1) ThenBlock: {
            StoreValue(Add(v, SOsc.FEG_LVL), 0)
            StoreValue(Add(v, SOsc.FEG_REM), 0)
            SetByte(v, SOsc.FEG_ST, SEnv.IDLE)
        } ElseBlock: {
            StoreValue(Add(v, SOsc.FEG_REM), 0)
            SetByte(v, SOsc.FEG_ST, SEnv.RELEASE)
        }
    }
}

Function.Synth_FiltTick {
    Input: v: Address
    Input: x: Integer
    Input: ch: Integer
    Output: Integer
    Body: {
        cut = Dereference(Add(v, SOsc.CUTOFF), "dword")
        cut = Add(cut, Dereference(Add(v, SOsc.ROUTE_CUT)))
        famt = Dereference(Add(v, SOsc.FEG_AMT))
        IfCondition NotEqual(famt, 0) ThenBlock: {
            fl = Dereference(Add(v, SOsc.FEG_LVL))
            cut = Add(cut, Divide(Multiply(famt, fl), 65536))
        } ElseBlock: {
            fenv = Dereference(Add(v, SOsc.FENV), "dword")
            IfCondition GreaterThan(fenv, 0) ThenBlock: {
                env = Dereference(Add(v, SOsc.ENV_LVL), "dword")
                add = Divide(Multiply(fenv, env), 128)
                cut = Add(cut, add)
            }
        }
        lf = Dereference(Add(v, SOsc.LFO_FILT), "dword")
        lspf = Dereference(Add(v, SOsc.LFO_SP))
        IfCondition GreaterThan(lf, 0) ThenBlock: {
            IfCondition GreaterThan(lspf, 0) ThenBlock: {
                lpph = Dereference(Add(v, SOsc.LFO_PH))
                l16 = Divide(lpph, 65536)
                IfCondition GreaterEqual(l16, 32768) ThenBlock: { l16 = Subtract(65535, l16) }
                ltri = Subtract(Multiply(l16, 2), 32767)
                cut = Add(cut, Divide(Multiply(ltri, lf), 384))
            }
        }
        IfCondition GreaterThan(cut, 65536) ThenBlock: { cut = 65536 }
        IfCondition LessThan(cut, 16) ThenBlock: { cut = 16 }
        IfCondition GreaterEqual(cut, 65280) ThenBlock: { ReturnValue(x) }
        lp_off = SOsc.FILT_LP
        bp_off = SOsc.FILT_BP
        IfCondition EqualTo(ch, 1) ThenBlock: {
            lp_off = SOsc.FILT_LPR
            bp_off = SOsc.FILT_BPR
        }
        lp = Dereference(Add(v, lp_off))
        IfCondition EqualTo(GetByte(v, SOsc.WAVE), 8) ThenBlock: {
            d = Subtract(x, lp)
            lp = Add(lp, Divide(Multiply(cut, d), 65536))
            IfCondition GreaterThan(lp, 32767) ThenBlock: { lp = 32767 }
            IfCondition LessThan(lp, -32767) ThenBlock: { lp = -32767 }
            StoreValue(Add(v, lp_off), lp)
            StoreValue(Add(v, bp_off), 0)
            ReturnValue(lp)
        }
        bp = Dereference(Add(v, bp_off))
        q = Dereference(Add(v, SOsc.RES), "dword")
        qbp = Divide(Multiply(q, bp), 96)
        hp = Subtract(Subtract(x, lp), qbp)
        bp = Add(bp, Divide(Multiply(cut, hp), 65536))
        lp = Add(lp, Divide(Multiply(cut, bp), 65536))
        IfCondition GreaterThan(lp, 262144) ThenBlock: { lp = 262144 }
        IfCondition LessThan(lp, -262144) ThenBlock: { lp = -262144 }
        IfCondition GreaterThan(bp, 262144) ThenBlock: { bp = 262144 }
        IfCondition LessThan(bp, -262144) ThenBlock: { bp = -262144 }
        StoreValue(Add(v, lp_off), lp)
        StoreValue(Add(v, bp_off), bp)
        ReturnValue(lp)
    }
}

Function.Synth_PackStep {
    Input: v: Address
    Input: idx: Integer
    Input: looping: Integer
    Input: ls: Integer
    Output: Integer
    Body: {
        st = GetByte(v, SOsc.ENV_ST)
        IfCondition EqualTo(st, SEnv.IDLE) ThenBlock: { ReturnValue(0) }
        lvl = Dereference(Add(v, SOsc.ENV_LVL), "dword")
        penv = Dereference(Add(v, SOsc.PENV))
        IfCondition EqualTo(st, SEnv.RELEASE) ThenBlock: {
            rfrom = Dereference(Add(v, SOsc.RFROM))
            rpos = Dereference(Add(v, SOsc.RPOS))
            IfCondition EqualTo(penv, 1) ThenBlock: {
                rfrom = lvl
                rpos = 0
                StoreValue(Add(v, SOsc.PENV), 2)
                IfCondition LessThan(rfrom, 1) ThenBlock: {
                    SetByte(v, SOsc.ENV_ST, SEnv.IDLE)
                    StoreValue(Add(v, SOsc.ENV_LVL), 0, "dword")
                    SetByte(v, SOsc.NOTE, 255)
                    SetByte(v, SOsc.GATE, 0)
                    ReturnValue(0)
                }
                StoreValue(Add(v, SOsc.RFROM), rfrom)
            }
            rlen = Dereference(Add(v, SOsc.REL))
            IfCondition LessThan(rlen, 1) ThenBlock: { rlen = 1 }
            left = Subtract(rlen, rpos)
            IfCondition LessThan(left, 1) ThenBlock: {
                SetByte(v, SOsc.ENV_ST, SEnv.IDLE)
                StoreValue(Add(v, SOsc.ENV_LVL), 0, "dword")
                SetByte(v, SOsc.NOTE, 255)
                SetByte(v, SOsc.GATE, 0)
                ReturnValue(0)
            }
            out = Divide(Multiply(rfrom, left), rlen)
            StoreValue(Add(v, SOsc.RPOS), Add(rpos, 1))
            StoreValue(Add(v, SOsc.ENV_LVL), out, "dword")
            ReturnValue(out)
        }
        den = Dereference(Add(v, SOsc.DEC))
        IfCondition EqualTo(looping, 1) ThenBlock: {
            IfCondition GreaterEqual(idx, ls) ThenBlock: {
                IfCondition GreaterThan(den, 0) ThenBlock: {
                    rem = Dereference(Add(v, SOsc.DREM))
                    bump = Multiply(lvl, 6908)
                    rem = Add(rem, bump)
                    IfCondition GreaterEqual(rem, den) ThenBlock: {
                        drop = Divide(rem, den)
                        IfCondition GreaterThan(drop, lvl) ThenBlock: { drop = lvl }
                        lvl = Subtract(lvl, drop)
                        rem = Modulo(rem, den)
                    }
                    StoreValue(Add(v, SOsc.DREM), rem)
                    StoreValue(Add(v, SOsc.ENV_LVL), lvl, "dword")
                    IfCondition LessThan(lvl, 2) ThenBlock: {
                        SetByte(v, SOsc.ENV_ST, SEnv.IDLE)
                        StoreValue(Add(v, SOsc.ENV_LVL), 0, "dword")
                        SetByte(v, SOsc.NOTE, 255)
                        SetByte(v, SOsc.GATE, 0)
                        ReturnValue(0)
                    }
                }
            }
        }
        ReturnValue(lvl)
    }
}

Function.Synth_VoiceTick {
    Input: v: Address
    Input: qual: Integer
    Output: Integer
    Body: {
        st = GetByte(v, SOsc.ENV_ST)
        IfCondition EqualTo(st, SEnv.IDLE) ThenBlock: {
            StoreValue(Add(v, SOsc.LASTR), 0)
            ReturnValue(0)
        }
        IfCondition EqualTo(GetByte(v, SOsc.WAVE), 8) ThenBlock: {
            smp0 = Dereference(Add(v, SOsc.SMP))
            ph0 = Dereference(v)
            done = Smp_Finished(smp0, ph0)
            IfCondition EqualTo(done, 1) ThenBlock: {
                SetByte(v, SOsc.ENV_ST, SEnv.IDLE)
                SetByte(v, SOsc.GATE, 0)
                SetByte(v, SOsc.NOTE, 255)
                StoreValue(Add(v, SOsc.ENV_LVL), 0, "dword")
                StoreValue(Add(v, SOsc.LASTR), 0)
                StoreValue(Add(v, SOsc.SMP), 0)
                ReturnValue(0)
            }
            env8 = 0
            IfCondition NotEqual(Dereference(Add(v, SOsc.PENV)), 0) ThenBlock: {
                mode8 = Dereference(Add(smp0, SmpOff.MODE))
                ls8 = Dereference(Add(smp0, SmpOff.LS))
                le8 = Dereference(Add(smp0, SmpOff.LE))
                looping8 = 0
                IfCondition EqualTo(mode8, 1) ThenBlock: {
                    IfCondition GreaterThan(le8, Add(ls8, 1)) ThenBlock: { looping8 = 1 }
                }
                idx8 = Divide(ph0, 65536)
                env8 = Synth_PackStep(v, idx8, looping8, ls8)
            } ElseBlock: {
                env8 = Synth_EnvTick(v)
            }
            IfCondition EqualTo(env8, 0) ThenBlock: {
                IfCondition EqualTo(GetByte(v, SOsc.ENV_ST), SEnv.IDLE) ThenBlock: {
                    StoreValue(Add(v, SOsc.LASTR), 0)
                    ReturnValue(0)
                }
            }
            raw8 = Smp_TickCh(smp0, ph0, 0, 0)
            raw8R = raw8
            IfCondition NotEqual(smp0, 0) ThenBlock: {
                pr8 = Dereference(Add(smp0, 72))
                IfCondition NotEqual(pr8, 0) ThenBlock: {
                    raw8R = Smp_TickCh(smp0, ph0, 1, 0)
                }
            }
            s8 = Divide(Multiply(raw8, env8), 65536)
            s8R = Divide(Multiply(raw8R, env8), 65536)
            g8 = Dereference(Add(v, SOsc.GAIN), "dword")
            s8 = Divide(Multiply(s8, g8), 256)
            s8R = Divide(Multiply(s8R, g8), 256)
            StoreValue(Add(v, SOsc.LASTR), s8R)
            st8 = Dereference(Add(v, SOsc.STEP))
            np8 = Add(ph0, st8)
            np8 = Smp_WrapPhase(smp0, np8)
            StoreValue(v, np8)
            ReturnValue(s8)
        }
        env = Synth_EnvTick(v)
        Synth_FegTick(v)
        IfCondition EqualTo(env, 0) ThenBlock: {
            IfCondition EqualTo(GetByte(v, SOsc.ENV_ST), SEnv.IDLE) ThenBlock: {
                StoreValue(Add(v, SOsc.LASTR), 0)
                ReturnValue(0)
            }
        }
        ltri = 0
        lsp = Dereference(Add(v, SOsc.LFO_SP))
        IfCondition GreaterThan(lsp, 0) ThenBlock: {
            lp = Dereference(Add(v, SOsc.LFO_PH))
            lp = BitwiseAnd(Add(lp, lsp), 4294967295)
            StoreValue(Add(v, SOsc.LFO_PH), lp)
            l16 = Divide(lp, 65536)
            IfCondition GreaterEqual(l16, 32768) ThenBlock: { l16 = Subtract(65535, l16) }
            ltri = Subtract(Multiply(l16, 2), 32767)
            pwm = Dereference(Add(v, SOsc.LFO_PWM), "dword")
            IfCondition GreaterThan(pwm, 0) ThenBlock: {
                base = GetByte(v, SOsc.PWBASE)
                delta = Divide(Multiply(ltri, pwm), 24576)
                npw = Add(base, delta)
                IfCondition LessThan(npw, 8) ThenBlock: { npw = 8 }
                IfCondition GreaterThan(npw, 248) ThenBlock: { npw = 248 }
                SetByte(v, SOsc.PW, npw)
                StoreValue(Add(v, SOsc.PWPHASE), Multiply(npw, 16777216))
            }
        }
        ph1 = Dereference(v)
        st1 = Dereference(Add(v, SOsc.STEP))
        raw = Synth_WaveAt(v, ph1, st1, qual)
        mix = Dereference(Add(v, SOsc.OSC_MIX), "dword")
        step2 = Dereference(Add(v, SOsc.STEP2))
        w2 = GetByte(v, SOsc.WAVE2)
        need2 = 0
        IfCondition GreaterThan(mix, 0) ThenBlock: { need2 = 1 }
        IfCondition EqualTo(GetByte(v, SOsc.WAVE), 8) ThenBlock: { need2 = 0 }
        IfCondition GreaterThan(need2, 0) ThenBlock: {
            IfCondition EqualTo(step2, 0) ThenBlock: { step2 = st1 }
            ph2 = Dereference(Add(v, SOsc.PHASE2))
            w1 = GetByte(v, SOsc.WAVE)
            SetByte(v, SOsc.WAVE, w2)
            raw2 = Synth_WaveAt(v, ph2, step2, qual)
            SetByte(v, SOsc.WAVE, w1)
            mv = mix
            raw = Divide(Add(Multiply(raw, Subtract(256, mv)), Multiply(raw2, mv)), 256)
            StoreValue(Add(v, SOsc.PHASE2), BitwiseAnd(Add(ph2, step2), 4294967295))
        }
        subm = Dereference(Add(v, SOsc.SUBMIX), "dword")
        IfCondition GreaterThan(subm, 0) ThenBlock: {
            IfCondition NotEqual(GetByte(v, SOsc.WAVE), 8) ThenBlock: {
                sph = Dereference(Add(v, SOsc.SUBPH))
                half = Divide(st1, 2)
                sph = BitwiseAnd(Add(sph, half), 4294967295)
                StoreValue(Add(v, SOsc.SUBPH), sph)
                sub = -32767
                IfCondition LessThan(sph, 2147483648) ThenBlock: { sub = 32767 }
                raw = Add(raw, Divide(Multiply(sub, subm), 128))
            }
        }
        rawR = raw
        IfCondition EqualTo(GetByte(v, SOsc.WAVE), 8) ThenBlock: {
            smp = Dereference(Add(v, SOsc.SMP))
            IfCondition NotEqual(smp, 0) ThenBlock: {
                pr = Dereference(Add(smp, 72))
                IfCondition NotEqual(pr, 0) ThenBlock: {
                    rawR = Smp_TickCh(smp, ph1, 1, qual)
                }
            }
        }
        bits = GetByte(v, SOsc.BITS)
        q = Synth_Quantize(raw, bits)
        qR = Synth_Quantize(rawR, bits)
        qh = Divide(q, 2)
        qhR = Divide(qR, 2)
        s = Divide(Multiply(qh, env), 32768)
        sR = Divide(Multiply(qhR, env), 32768)
        s = Synth_FiltTick(v, s, 0)
        sR = Synth_FiltTick(v, sR, 1)
        drv = Dereference(Add(v, SOsc.DRIVE), "dword")
        IfCondition GreaterThan(drv, 0) ThenBlock: {
            s = Divide(Multiply(s, Add(256, Multiply(drv, 3))), 256)
            sR = Divide(Multiply(sR, Add(256, Multiply(drv, 3))), 256)
            s = Synth_SoftClip(s)
            sR = Synth_SoftClip(sR)
        }
        gain = Dereference(Add(v, SOsc.GAIN), "dword")
        s = Divide(Multiply(s, gain), SConst.UNITY)
        sR = Divide(Multiply(sR, gain), SConst.UNITY)
        la = Dereference(Add(v, SOsc.LFO_AMP), "dword")
        IfCondition GreaterThan(la, 0) ThenBlock: {
            am = Add(256, Divide(Multiply(ltri, la), 32768))
            s = Divide(Multiply(s, am), 256)
            sR = Divide(Multiply(sR, am), 256)
        }
        StoreValue(Add(v, SOsc.LASTR), sR)
        step = Dereference(Add(v, SOsc.STEP))
        ph = Dereference(v)
        np = Add(ph, step)
        IfCondition EqualTo(GetByte(v, SOsc.WAVE), 8) ThenBlock: {
            smp = Dereference(Add(v, SOsc.SMP))
            np = Smp_WrapPhase(smp, np)
        } ElseBlock: {
            np = BitwiseAnd(np, 4294967295)
        }
        StoreValue(v, np)
        ReturnValue(s)
    }
}

Function.Synth_SoftClip {
    Input: x: Integer
    Output: Integer
    Body: {
        a = x
        IfCondition LessThan(a, 0) ThenBlock: { a = Subtract(0, a) }
        IfCondition GreaterThan(a, 65535) ThenBlock: {
            IfCondition LessThan(x, 0) ThenBlock: { ReturnValue(-32767) }
            ReturnValue(32767)
        }
        den = Add(32767, Divide(a, 2))
        y = Divide(Multiply(x, 32767), den)
        ReturnValue(Synth_Clamp16(y))
    }
}

Function.Synth_DelayTick {
    Input: syn: Address
    Input: x: Integer
    Input: ch: Integer
    Output: Integer
    Body: {
        wet = Dereference(Add(syn, SOff.DELAYWET))
        IfCondition EqualTo(wet, 0) ThenBlock: { ReturnValue(x) }
        buf = Dereference(Add(syn, SOff.DELAYBUF))
        poff = SOff.DELAYPOS
        IfCondition EqualTo(ch, 1) ThenBlock: {
            buf = Dereference(Add(syn, SOff.DELAYBUFR))
            poff = SOff.DELAYPOSR
        }
        IfCondition EqualTo(buf, 0) ThenBlock: { ReturnValue(x) }
        cap = Dereference(Add(syn, SOff.DELAYCAP))
        len = Dereference(Add(syn, SOff.DELAYLEN))
        IfCondition LessEqual(len, 1) ThenBlock: { ReturnValue(x) }
        pos = Dereference(Add(syn, poff))
        rp = Subtract(pos, len)
        IfCondition LessThan(rp, 0) ThenBlock: { rp = Add(rp, cap) }
        roff = Multiply(rp, 2)
        rw = Dereference(Add(buf, roff))
        d = BitwiseAnd(rw, 65535)
        IfCondition GreaterThan(d, 32767) ThenBlock: { d = Subtract(d, 65536) }
        fb = Dereference(Add(syn, SOff.DELAYFB))
        wr = Add(x, Divide(Multiply(d, fb), 256))
        wr = Synth_Clamp16(wr)
        off = Multiply(pos, 2)
        Synth_PackS16(buf, off, wr)
        np = Add(pos, 1)
        IfCondition GreaterEqual(np, cap) ThenBlock: { np = 0 }
        StoreValue(Add(syn, poff), np)
        y = Add(x, Divide(Multiply(d, wet), 256))
        ReturnValue(y)
    }
}

Function.Synth_MixSample {
    Input: syn: Address
    Output: Integer
    Body: {
        vs = Dereference(Add(syn, SOff.VOICES))
        qual = Dereference(Add(syn, SOff.QUAL))
        lists = SynthG.lists
        accL = 0
        accR = 0
        IfCondition NotEqual(lists, 0) ThenBlock: {
            node = lists@live
            lists@live = 0
            lists@nlive = 0
            WhileLoop NotEqual(node, 0) {
                nxt = node@next
                v = node@voice
                st = GetByte(v, SOsc.ENV_ST)
                keep = 0
                IfCondition NotEqual(st, SEnv.IDLE) ThenBlock: {
                    sm = Synth_VoiceTick(v, qual)
                    accL = Add(accL, sm)
                    lr = Dereference(Add(v, SOsc.LASTR))
                    accR = Add(accR, lr)
                    st = GetByte(v, SOsc.ENV_ST)
                    IfCondition NotEqual(st, SEnv.IDLE) ThenBlock: { keep = 1 }
                }
                IfCondition EqualTo(keep, 1) ThenBlock: {
                    node@next = lists@live
                    lists@live = node
                    lists@nlive = Add(lists@nlive, 1)
                } ElseBlock: {
                    Synth_MapSet(node@ch, node@note, -1)
                    node@next = lists@free
                    lists@free = node
                    lists@nfree = Add(lists@nfree, 1)
                }
                node = nxt
            }
        }
        mg = Dereference(Add(syn, SOff.MIXGAIN))
        accL = Divide(Multiply(accL, mg), 256)
        accR = Divide(Multiply(accR, mg), 256)
        accL = Synth_DelayTick(syn, accL, 0)
        accR = Synth_DelayTick(syn, accR, 1)
        aL = accL
        IfCondition LessThan(aL, 0) ThenBlock: { aL = Subtract(0, aL) }
        aR = accR
        IfCondition LessThan(aR, 0) ThenBlock: { aR = Subtract(0, aR) }
        IfCondition GreaterThan(aL, SynthG.peak) ThenBlock: { SynthG.peak = aL }
        IfCondition GreaterThan(aR, SynthG.peak) ThenBlock: { SynthG.peak = aR }
        IfCondition GreaterThan(aL, 32767) ThenBlock: { SynthG.clips = Add(SynthG.clips, 1) }
        IfCondition GreaterThan(aR, 32767) ThenBlock: { SynthG.clips = Add(SynthG.clips, 1) }
        accL = Synth_Clamp16(accL)
        accR = Synth_Clamp16(accR)
        StoreValue(Add(syn, SOff.MIXR), accR)
        ReturnValue(accL)
    }
}

Function.Synth_MsSamples {
    Input: syn: Address
    Input: ms: Integer
    Output: Integer
    Body: {
        IfCondition LessEqual(ms, 0) ThenBlock: { ReturnValue(0) }
        rate = Dereference(Add(syn, SOff.RATE))
        samp = Divide(Multiply(rate, ms), 1000)
        IfCondition LessThan(samp, 1) ThenBlock: { samp = 1 }
        ReturnValue(samp)
    }
}

Function.Synth_MsToInc {
    Input: syn: Address
    Input: ms: Integer
    Output: Integer
    Body: {
        IfCondition LessEqual(ms, 0) ThenBlock: { ReturnValue(0) }
        rate = Dereference(Add(syn, SOff.RATE))
        samp = Divide(Multiply(rate, ms), 1000)
        IfCondition LessThan(samp, 1) ThenBlock: { samp = 1 }
        half = Divide(samp, 2)
        inc = Divide(Add(65536, half), samp)
        IfCondition LessThan(inc, 1) ThenBlock: { inc = 1 }
        ReturnValue(inc)
    }
}

Function.Synth_SetADSR {
    Input: syn: Address
    Input: index: Integer
    Input: a_ms: Integer
    Input: d_ms: Integer
    Input: s256: Integer
    Input: r_ms: Integer
    Body: {
        v = Synth_Voice(syn, index)
        IfCondition EqualTo(v, 0) ThenBlock: { ReturnValue(0) }
        ai = Synth_MsSamples(syn, a_ms)
        di = Synth_MsSamples(syn, d_ms)
        ri = Synth_MsSamples(syn, r_ms)
        StoreValue(Add(v, SOsc.ATK), ai, "dword")
        StoreValue(Add(v, SOsc.DEC), di, "dword")
        StoreValue(Add(v, SOsc.ENVREM), 0)
        sus = Multiply(s256, 256)
        IfCondition GreaterThan(sus, 65536) ThenBlock: { sus = 65536 }
        StoreValue(Add(v, SOsc.SUS), sus, "dword")
        StoreValue(Add(v, SOsc.REL), ri, "dword")
    }
}

Function.Synth_SetFilter {
    Input: syn: Address
    Input: index: Integer
    Input: cutoff: Integer
    Input: res: Integer
    Body: {
        v = Synth_Voice(syn, index)
        IfCondition EqualTo(v, 0) ThenBlock: { ReturnValue(0) }
        c = cutoff
        IfCondition LessThan(c, 0) ThenBlock: { c = 0 }
        IfCondition GreaterThan(c, 256) ThenBlock: { c = 256 }
        mapped = 65536
        IfCondition LessThan(c, 256) ThenBlock: {
            cc = Multiply(c, c)
            mapped = Add(32, Add(cc, Divide(Multiply(cc, c), 192)))
            IfCondition GreaterThan(mapped, 65000) ThenBlock: { mapped = 65000 }
        }
        StoreValue(Add(v, SOsc.CUTOFF), mapped, "dword")
        r = res
        IfCondition LessThan(r, 0) ThenBlock: { r = 0 }
        IfCondition GreaterThan(r, 240) ThenBlock: { r = 240 }
        StoreValue(Add(v, SOsc.RES), r, "dword")
    }
}

Function.Synth_SetCutoffCoeff {
    Input: syn: Address
    Input: index: Integer
    Input: coeff: Integer
    Input: res: Integer
    Body: {
        v = Synth_Voice(syn, index)
        IfCondition EqualTo(v, 0) ThenBlock: { ReturnValue(0) }
        c = coeff
        IfCondition LessThan(c, 32) ThenBlock: { c = 32 }
        IfCondition GreaterThan(c, 65536) ThenBlock: { c = 65536 }
        StoreValue(Add(v, SOsc.CUTOFF), c, "dword")
        r = res
        IfCondition LessThan(r, 0) ThenBlock: { r = 0 }
        IfCondition GreaterThan(r, 240) ThenBlock: { r = 240 }
        StoreValue(Add(v, SOsc.RES), r, "dword")
    }
}

Function.Synth_SetFilterCents {
    Input: syn: Address
    Input: index: Integer
    Input: cents: Integer
    Input: res: Integer
    Body: {
        v = Synth_Voice(syn, index)
        IfCondition EqualTo(v, 0) ThenBlock: { ReturnValue(0) }
        mapped = 65536
        IfCondition LessThan(cents, 13500) ThenBlock: {
            nn = Divide(cents, 100)
            IfCondition LessThan(nn, 0) ThenBlock: { nn = 0 }
            IfCondition GreaterThan(nn, 127) ThenBlock: { nn = 127 }
            mhz = Synth_NoteMilliHz(nn)
            hz = Divide(mhz, 1000)
            mapped = Divide(Multiply(hz, 8577), 1000)
            IfCondition LessThan(mapped, 32) ThenBlock: { mapped = 32 }
            IfCondition GreaterThan(mapped, 65000) ThenBlock: { mapped = 65000 }
        }
        StoreValue(Add(v, SOsc.CUTOFF), mapped, "dword")
        IfCondition LessThan(res, 0) ThenBlock: { res = 0 }
        r = Subtract(96, res)
        IfCondition LessThan(r, 16) ThenBlock: { r = 16 }
        IfCondition GreaterThan(r, 240) ThenBlock: { r = 240 }
        StoreValue(Add(v, SOsc.RES), r, "dword")
    }
}

Function.Synth_SetPitchMod {
    Input: syn: Address
    Input: index: Integer
    Input: cents: Integer
    Body: {
        v = Synth_Voice(syn, index)
        IfCondition EqualTo(v, 0) ThenBlock: { ReturnValue(0) }
        c = cents
        IfCondition LessThan(c, -120) ThenBlock: { c = -120 }
        IfCondition GreaterThan(c, 120) ThenBlock: { c = 120 }
        StoreValue(Add(v, SOsc.PMOD), c)
        Synth_ApplyDetune(v)
    }
}

Function.Synth_SetDetune {
    Input: syn: Address
    Input: index: Integer
    Input: cents: Integer
    Body: {
        v = Synth_Voice(syn, index)
        IfCondition EqualTo(v, 0) ThenBlock: { ReturnValue(0) }
        d = cents
        IfCondition LessThan(d, 0) ThenBlock: { d = 0 }
        IfCondition GreaterThan(d, 80) ThenBlock: { d = 80 }
        StoreValue(Add(v, SOsc.DETUNE), d, "dword")
        Synth_ApplyDetune(v)
    }
}

Function.Synth_SetFenv {
    Input: syn: Address
    Input: index: Integer
    Input: amt: Integer
    Body: {
        v = Synth_Voice(syn, index)
        IfCondition EqualTo(v, 0) ThenBlock: { ReturnValue(0) }
        a = amt
        IfCondition LessThan(a, 0) ThenBlock: { a = 0 }
        IfCondition GreaterThan(a, 256) ThenBlock: { a = 256 }
        StoreValue(Add(v, SOsc.FENV), a, "dword")
    }
}

Function.Synth_SetFegAmt {
    Input: syn: Address
    Input: index: Integer
    Input: amt: Integer
    Body: {
        v = Synth_Voice(syn, index)
        IfCondition EqualTo(v, 0) ThenBlock: { ReturnValue(0) }
        StoreValue(Add(v, SOsc.FEG_AMT), amt)
    }
}

Function.Synth_SetFEG {
    Input: syn: Address
    Input: index: Integer
    Input: a_ms: Integer
    Input: d_ms: Integer
    Input: s256: Integer
    Input: r_ms: Integer
    Body: {
        v = Synth_Voice(syn, index)
        IfCondition EqualTo(v, 0) ThenBlock: { ReturnValue(0) }
        ai = Synth_MsSamples(syn, a_ms)
        di = Synth_MsSamples(syn, d_ms)
        ri = Synth_MsSamples(syn, r_ms)
        StoreValue(Add(v, SOsc.FEG_ATK), ai)
        StoreValue(Add(v, SOsc.FEG_DEC), di)
        sus = Multiply(s256, 256)
        IfCondition GreaterThan(sus, 65536) ThenBlock: { sus = 65536 }
        IfCondition LessThan(sus, 0) ThenBlock: { sus = 0 }
        StoreValue(Add(v, SOsc.FEG_SUS), sus)
        StoreValue(Add(v, SOsc.FEG_REL), ri)
    }
}

Function.Synth_FegArm {
    Input: syn: Address
    Input: index: Integer
    Body: {
        v = Synth_Voice(syn, index)
        IfCondition EqualTo(v, 0) ThenBlock: { ReturnValue(0) }
        amt = Dereference(Add(v, SOsc.FEG_AMT))
        IfCondition EqualTo(amt, 0) ThenBlock: {
            SetByte(v, SOsc.FEG_ST, SEnv.IDLE)
            StoreValue(Add(v, SOsc.FEG_LVL), 0)
            StoreValue(Add(v, SOsc.FEG_REM), 0)
            ReturnValue(0)
        }
        atk = Dereference(Add(v, SOsc.FEG_ATK))
        IfCondition EqualTo(atk, 0) ThenBlock: {
            StoreValue(Add(v, SOsc.FEG_LVL), 65536)
            dec = Dereference(Add(v, SOsc.FEG_DEC))
            IfCondition EqualTo(dec, 0) ThenBlock: {
                sus = Dereference(Add(v, SOsc.FEG_SUS))
                StoreValue(Add(v, SOsc.FEG_LVL), sus)
                IfCondition EqualTo(sus, 0) ThenBlock: {
                    SetByte(v, SOsc.FEG_ST, SEnv.IDLE)
                } ElseBlock: {
                    SetByte(v, SOsc.FEG_ST, SEnv.SUSTAIN)
                }
            } ElseBlock: {
                SetByte(v, SOsc.FEG_ST, SEnv.DECAY)
            }
        } ElseBlock: {
            StoreValue(Add(v, SOsc.FEG_LVL), 0)
            SetByte(v, SOsc.FEG_ST, SEnv.ATTACK)
        }
        StoreValue(Add(v, SOsc.FEG_REM), 0)
    }
}

Function.Synth_SetLFO {
    Input: syn: Address
    Input: index: Integer
    Input: rate: Integer
    Input: pwm: Integer
    Body: {
        v = Synth_Voice(syn, index)
        IfCondition EqualTo(v, 0) ThenBlock: { ReturnValue(0) }
        r = rate
        IfCondition LessThan(r, 0) ThenBlock: { r = 0 }
        IfCondition GreaterThan(r, 256) ThenBlock: { r = 256 }
        p = pwm
        IfCondition LessThan(p, 0) ThenBlock: { p = 0 }
        IfCondition GreaterThan(p, 256) ThenBlock: { p = 256 }
        StoreValue(Add(v, SOsc.LFO_SP), Multiply(r, 11000))
        StoreValue(Add(v, SOsc.LFO_PWM), p, "dword")
    }
}

Function.Synth_SetOsc2 {
    Input: syn: Address
    Input: index: Integer
    Input: wave2: Integer
    Input: mix: Integer
    Input: oct: Integer
    Body: {
        v = Synth_Voice(syn, index)
        IfCondition EqualTo(v, 0) ThenBlock: { ReturnValue(0) }
        w = wave2
        IfCondition LessThan(w, 0) ThenBlock: { w = 0 }
        IfCondition GreaterThan(w, 8) ThenBlock: { w = 8 }
        SetByte(v, SOsc.WAVE2, w)
        m = mix
        IfCondition LessThan(m, 0) ThenBlock: { m = 0 }
        IfCondition GreaterThan(m, 256) ThenBlock: { m = 256 }
        StoreValue(Add(v, SOsc.OSC_MIX), m, "dword")
        o = oct
        IfCondition LessThan(o, 0) ThenBlock: { o = 0 }
        IfCondition GreaterThan(o, 4) ThenBlock: { o = 4 }
        StoreValue(Add(v, SOsc.OSC2OCT), o)
        Synth_ApplyDetune(v)
    }
}

Function.Synth_SetLFOTaps {
    Input: syn: Address
    Input: index: Integer
    Input: to_filt: Integer
    Input: to_amp: Integer
    Body: {
        v = Synth_Voice(syn, index)
        IfCondition EqualTo(v, 0) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(to_filt, 0) ThenBlock: { to_filt = 0 }
        IfCondition GreaterThan(to_filt, 256) ThenBlock: { to_filt = 256 }
        IfCondition LessThan(to_amp, 0) ThenBlock: { to_amp = 0 }
        IfCondition GreaterThan(to_amp, 256) ThenBlock: { to_amp = 256 }
        StoreValue(Add(v, SOsc.LFO_FILT), to_filt, "dword")
        StoreValue(Add(v, SOsc.LFO_AMP), to_amp, "dword")
    }
}

Function.Synth_SetSub {
    Input: syn: Address
    Input: index: Integer
    Input: mix: Integer
    Body: {
        v = Synth_Voice(syn, index)
        IfCondition EqualTo(v, 0) ThenBlock: { ReturnValue(0) }
        m = mix
        IfCondition LessThan(m, 0) ThenBlock: { m = 0 }
        IfCondition GreaterThan(m, 256) ThenBlock: { m = 256 }
        StoreValue(Add(v, SOsc.SUBMIX), m, "dword")
    }
}

Function.Synth_SetDrive {
    Input: syn: Address
    Input: index: Integer
    Input: d: Integer
    Body: {
        v = Synth_Voice(syn, index)
        IfCondition EqualTo(v, 0) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(d, 0) ThenBlock: { d = 0 }
        IfCondition GreaterThan(d, 256) ThenBlock: { d = 256 }
        StoreValue(Add(v, SOsc.DRIVE), d, "dword")
    }
}

Function.Synth_SetDelay {
    Input: syn: Address
    Input: ms: Integer
    Input: fb: Integer
    Input: wet: Integer
    Body: {
        IfCondition EqualTo(syn, 0) ThenBlock: { ReturnValue(0) }
        rate = Dereference(Add(syn, SOff.RATE))
        cap = Dereference(Add(syn, SOff.DELAYCAP))
        len = Divide(Multiply(rate, ms), 1000)
        IfCondition LessThan(len, 0) ThenBlock: { len = 0 }
        IfCondition GreaterEqual(len, cap) ThenBlock: { len = Subtract(cap, 1) }
        StoreValue(Add(syn, SOff.DELAYLEN), len)
        IfCondition LessThan(fb, 0) ThenBlock: { fb = 0 }
        IfCondition GreaterThan(fb, 250) ThenBlock: { fb = 250 }
        IfCondition LessThan(wet, 0) ThenBlock: { wet = 0 }
        IfCondition GreaterThan(wet, 256) ThenBlock: { wet = 256 }
        StoreValue(Add(syn, SOff.DELAYFB), fb)
        StoreValue(Add(syn, SOff.DELAYWET), wet)
    }
}

Function.Synth_SetMixGain {
    Input: syn: Address
    Input: g: Integer
    Body: {
        IfCondition EqualTo(syn, 0) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(g, 0) ThenBlock: { g = 0 }
        IfCondition GreaterThan(g, 2048) ThenBlock: { g = 2048 }
        StoreValue(Add(syn, SOff.MIXGAIN), g)
    }
}

Function.Synth_WaveSet {
    Input: i: Integer
    Input: val: Integer
    Body: {
        IfCondition EqualTo(SynthG.ok, 0) ThenBlock: { Synth_TabInit() }
        IfCondition LessThan(i, 0) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterThan(i, 31) ThenBlock: { ReturnValue(0) }
        StoreValue(Add(SynthG.userwave, Multiply(i, 8)), val)
    }
}

Function.Synth_WaveGet {
    Input: i: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(SynthG.ok, 0) ThenBlock: { Synth_TabInit() }
        IfCondition LessThan(i, 0) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterThan(i, 31) ThenBlock: { ReturnValue(0) }
        ReturnValue(Dereference(Add(SynthG.userwave, Multiply(i, 8))))
    }
}

Function.Synth_RenderS16 {
    Input: syn: Address
    Input: dst: Address
    Input: frames: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(syn, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(dst, 0) ThenBlock: { ReturnValue(0) }
        f = 0
        WhileLoop LessThan(f, frames) {
            accL = Synth_MixSample(syn)
            accR = Dereference(Add(syn, SOff.MIXR))
            acc = Divide(Add(accL, accR), 2)
            Synth_PackS16(dst, Multiply(f, 2), acc)
            f = Add(f, 1)
        }
        ReturnValue(frames)
    }
}

Function.Synth_U16 {
    Input: acc: Integer
    Output: Integer
    Body: {
        s = Synth_Clamp16(acc)
        IfCondition LessThan(s, 0) ThenBlock: { s = Add(s, 65536) }
        ReturnValue(s)
    }
}

Function.Synth_PackS16 {
    Input: dst: Address
    Input: off: Integer
    Input: acc: Integer
    Body: {
        u = Synth_U16(acc)
        aligned = Subtract(off, Modulo(off, 8))
        shb = Modulo(off, 8)
        sh = Multiply(shb, 8)
        old = Dereference(Add(dst, aligned))
        mask = ShiftLeft(65535, sh)
        kept = BitwiseAnd(old, mask)
        cleared = Subtract(old, kept)
        ins = ShiftLeft(u, sh)
        StoreValue(Add(dst, aligned), Add(cleared, ins))
    }
}

Function.Synth_SampleBlock {
    Input: v: Address
    Input: acc: Address
    Input: frames: Integer
    Output: Integer
    Body: {
        st = GetByte(v, SOsc.ENV_ST)
        IfCondition EqualTo(st, SEnv.IDLE) ThenBlock: { ReturnValue(0) }
        smp = Dereference(Add(v, SOsc.SMP))
        IfCondition EqualTo(smp, 0) ThenBlock: { ReturnValue(0) }
        pcm = Dereference(Add(smp, SmpOff.PCM))
        pcmr = Dereference(Add(smp, SmpOff.PCMR))
        n = Dereference(Add(smp, SmpOff.N))
        mode = Dereference(Add(smp, SmpOff.MODE))
        ls = Dereference(Add(smp, SmpOff.LS))
        le = Dereference(Add(smp, SmpOff.LE))
        looping = 0
        IfCondition EqualTo(mode, 1) ThenBlock: {
            IfCondition GreaterThan(le, Add(ls, 1)) ThenBlock: { looping = 1 }
        }
        ln = 1
        IfCondition EqualTo(looping, 1) ThenBlock: { ln = Subtract(le, ls) }
        IfCondition LessThan(ln, 1) ThenBlock: { ln = 1 }
        ph = Dereference(v)
        step = Dereference(Add(v, SOsc.STEP))
        lvl = Dereference(Add(v, SOsc.ENV_LVL), "dword")
        atk = Dereference(Add(v, SOsc.ATK), "dword")
        dec = Dereference(Add(v, SOsc.DEC), "dword")
        sus = Dereference(Add(v, SOsc.SUS), "dword")
        rel = Dereference(Add(v, SOsc.REL), "dword")
        gain = Dereference(Add(v, SOsc.GAIN), "dword")
        penv = Dereference(Add(v, SOsc.PENV))
        // A pack one-shot is already at the note's pitch. Anything but
        // ratio 1.0 crawls through a full-scale hit and never reaches the end.
        IfCondition NotEqual(penv, 0) ThenBlock: {
            IfCondition EqualTo(looping, 0) ThenBlock: {
                step = 65536
            }
        }
        den = Dereference(Add(v, SOsc.DEC))
        drem = Dereference(Add(v, SOsc.DREM))
        rfrom = Dereference(Add(v, SOsc.RFROM))
        rpos = Dereference(Add(v, SOsc.RPOS))
        i = 0
        WhileLoop LessThan(i, frames) {
            pidx = Divide(ph, 65536)
            IfCondition EqualTo(penv, 0) ThenBlock: {
                IfCondition EqualTo(st, SEnv.ATTACK) ThenBlock: {
                    lvl = Add(lvl, atk)
                    IfCondition GreaterEqual(lvl, 65536) ThenBlock: {
                        lvl = 65536
                        st = SEnv.DECAY
                    }
                }
                IfCondition EqualTo(st, SEnv.DECAY) ThenBlock: {
                    IfCondition EqualTo(dec, 0) ThenBlock: {
                        lvl = sus
                        st = SEnv.SUSTAIN
                        IfCondition EqualTo(sus, 0) ThenBlock: { st = SEnv.IDLE }
                    } ElseBlock: {
                        IfCondition GreaterThan(lvl, sus) ThenBlock: {
                            lvl = Subtract(lvl, dec)
                            IfCondition LessThan(lvl, sus) ThenBlock: { lvl = sus }
                        }
                        IfCondition LessEqual(lvl, sus) ThenBlock: {
                            lvl = sus
                            st = SEnv.SUSTAIN
                            IfCondition EqualTo(sus, 0) ThenBlock: { st = SEnv.IDLE }
                        }
                    }
                }
                IfCondition EqualTo(st, SEnv.RELEASE) ThenBlock: {
                    IfCondition GreaterThan(lvl, rel) ThenBlock: {
                        lvl = Subtract(lvl, rel)
                    } ElseBlock: {
                        lvl = 0
                        st = SEnv.IDLE
                    }
                }
            }
            IfCondition NotEqual(penv, 0) ThenBlock: {
                IfCondition EqualTo(looping, 0) ThenBlock: {
                    IfCondition GreaterEqual(pidx, n) ThenBlock: {
                        st = SEnv.IDLE
                        lvl = 0
                    }
                }
                IfCondition EqualTo(st, SEnv.RELEASE) ThenBlock: {
                    IfCondition EqualTo(penv, 1) ThenBlock: {
                        rfrom = lvl
                        rpos = 0
                        penv = 2
                        IfCondition LessThan(rfrom, 1) ThenBlock: {
                            st = SEnv.IDLE
                            lvl = 0
                        }
                    }
                    IfCondition EqualTo(st, SEnv.RELEASE) ThenBlock: {
                        rlen = rel
                        IfCondition LessThan(rlen, 1) ThenBlock: { rlen = 1 }
                        left = Subtract(rlen, rpos)
                        IfCondition LessThan(left, 1) ThenBlock: {
                            st = SEnv.IDLE
                            lvl = 0
                        } ElseBlock: {
                            lvl = Divide(Multiply(rfrom, left), rlen)
                            rpos = Add(rpos, 1)
                        }
                    }
                }
                IfCondition NotEqual(st, SEnv.RELEASE) ThenBlock: {
                    IfCondition NotEqual(st, SEnv.IDLE) ThenBlock: {
                        IfCondition EqualTo(looping, 1) ThenBlock: {
                            IfCondition GreaterEqual(pidx, ls) ThenBlock: {
                                IfCondition GreaterThan(den, 0) ThenBlock: {
                                    bump = Multiply(lvl, 6908)
                                    drem = Add(drem, bump)
                                    IfCondition GreaterEqual(drem, den) ThenBlock: {
                                        drop = Divide(drem, den)
                                        IfCondition GreaterThan(drop, lvl) ThenBlock: { drop = lvl }
                                        lvl = Subtract(lvl, drop)
                                        drem = Modulo(drem, den)
                                    }
                                    IfCondition LessThan(lvl, 2) ThenBlock: {
                                        st = SEnv.IDLE
                                        lvl = 0
                                    }
                                }
                            }
                        }
                    }
                }
            }
            IfCondition EqualTo(st, SEnv.IDLE) ThenBlock: {
                i = frames
            } ElseBlock: {
                idx = Divide(ph, 65536)
                IfCondition EqualTo(looping, 1) ThenBlock: {
                    IfCondition GreaterEqual(idx, le) ThenBlock: {
                        over = Subtract(idx, ls)
                        idx = Add(ls, Modulo(over, ln))
                    }
                }
                IfCondition LessThan(idx, 0) ThenBlock: { idx = 0 }
                IfCondition GreaterEqual(idx, n) ThenBlock: { idx = Subtract(n, 1) }
                off = Multiply(idx, 2)
                w = Dereference(Add(pcm, off))
                s = BitwiseAnd(w, 65535)
                IfCondition GreaterThan(s, 32767) ThenBlock: { s = Subtract(s, 65536) }
                sR = s
                IfCondition NotEqual(pcmr, 0) ThenBlock: {
                    wR = Dereference(Add(pcmr, off))
                    sR = BitwiseAnd(wR, 65535)
                    IfCondition GreaterThan(sR, 32767) ThenBlock: { sR = Subtract(sR, 65536) }
                }
                s = Divide(Multiply(s, lvl), 65536)
                sR = Divide(Multiply(sR, lvl), 65536)
                s = Divide(Multiply(s, gain), 256)
                sR = Divide(Multiply(sR, gain), 256)
                boff = Multiply(i, 16)
                cur = Dereference(Add(acc, boff))
                StoreValue(Add(acc, boff), Add(cur, s))
                boffR = Add(boff, 8)
                curR = Dereference(Add(acc, boffR))
                StoreValue(Add(acc, boffR), Add(curR, sR))
                ph = Add(ph, step)
                IfCondition EqualTo(looping, 0) ThenBlock: {
                    idx2 = Divide(ph, 65536)
                    IfCondition LessThan(idx2, pidx) ThenBlock: {
                        st = SEnv.IDLE
                        lvl = 0
                    }
                    IfCondition GreaterEqual(idx2, n) ThenBlock: {
                        st = SEnv.IDLE
                        lvl = 0
                    }
                }
                IfCondition EqualTo(looping, 1) ThenBlock: {
                    idx2 = Divide(ph, 65536)
                    IfCondition GreaterEqual(idx2, le) ThenBlock: {
                        frac = Modulo(ph, 65536)
                        over2 = Subtract(idx2, ls)
                        idx2 = Add(ls, Modulo(over2, ln))
                        ph = Multiply(idx2, 65536)
                        ph = Add(ph, frac)
                    }
                }
                i = Add(i, 1)
            }
        }
        StoreValue(v, ph)
        StoreValue(Add(v, SOsc.ENV_LVL), lvl, "dword")
        SetByte(v, SOsc.ENV_ST, st)
        StoreValue(Add(v, SOsc.PENV), penv)
        StoreValue(Add(v, SOsc.DREM), drem)
        StoreValue(Add(v, SOsc.RFROM), rfrom)
        StoreValue(Add(v, SOsc.RPOS), rpos)
        IfCondition EqualTo(st, SEnv.IDLE) ThenBlock: {
            SetByte(v, SOsc.NOTE, 255)
            SetByte(v, SOsc.GATE, 0)
            ReturnValue(0)
        }
        ReturnValue(1)
    }
}

Function.Synth_ModSet {
    Input: src: Integer
    Input: value: Integer
    Body: {
        IfCondition EqualTo(SynthG.modv, 0) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(src, 0) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterThan(src, 31) ThenBlock: { ReturnValue(0) }
        StoreValue(Add(SynthG.modv, Multiply(src, 8)), value)
    }
}

Function.Synth_RouteClear {
    Body: {
        mlist = SynthG.mlists
        IfCondition EqualTo(mlist, 0) ThenBlock: { ReturnValue(0) }
        live_at = PoolFieldOffset(LinkagePool.MLists, "live")
        free_at = PoolFieldOffset(LinkagePool.MLists, "free")
        nfree_at = PoolFieldOffset(LinkagePool.MLists, "nfree")
        nlive_at = PoolFieldOffset(LinkagePool.MLists, "nlive")
        next_at = PoolFieldOffset(LinkagePool.MRoute, "next")
        rt = Dereference(Add(mlist, live_at))
        WhileLoop NotEqual(rt, 0) {
            rnxt = Dereference(Add(rt, next_at))
            oldfree = Dereference(Add(mlist, free_at))
            StoreValue(Add(rt, next_at), oldfree)
            StoreValue(Add(mlist, free_at), rt)
            nfree = Dereference(Add(mlist, nfree_at))
            StoreValue(Add(mlist, nfree_at), Add(nfree, 1))
            rt = rnxt
        }
        StoreValue(Add(mlist, live_at), 0)
        StoreValue(Add(mlist, nlive_at), 0)
    }
}

Function.Synth_RouteAdd {
    Input: src: Integer
    Input: dst: Integer
    Input: depth: Integer
    Body: {
        mlist = SynthG.mlists
        IfCondition EqualTo(mlist, 0) ThenBlock: { ReturnValue(0) }
        rt = AllocateLinkage(LinkagePool.MRoute)
        IfCondition EqualTo(rt, 0) ThenBlock: { ReturnValue(0) }
        rt@src = src
        rt@dst = dst
        rt@depth = depth
        live_at = PoolFieldOffset(LinkagePool.MLists, "live")
        nlive_at = PoolFieldOffset(LinkagePool.MLists, "nlive")
        next_at = PoolFieldOffset(LinkagePool.MRoute, "next")
        head = Dereference(Add(mlist, live_at))
        StoreValue(Add(rt, next_at), head)
        StoreValue(Add(mlist, live_at), rt)
        nlive = Dereference(Add(mlist, nlive_at))
        StoreValue(Add(mlist, nlive_at), Add(nlive, 1))
    }
}

Function.Synth_RouteSrc {
    Input: v: Address
    Input: src: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(src, SMod.VELOCITY) ThenBlock: {
            vel = Dereference(Add(v, SOsc.VEL))
            ReturnValue(Multiply(vel, 2))
        }
        IfCondition EqualTo(src, SMod.KEYTRACK) ThenBlock: {
            note = GetByte(v, SOsc.NOTE)
            ReturnValue(Subtract(note, 60))
        }
        IfCondition EqualTo(src, SMod.AMP_EG) ThenBlock: {
            lvl = Dereference(Add(v, SOsc.ENV_LVL), "dword")
            ReturnValue(Divide(lvl, 256))
        }
        IfCondition EqualTo(SynthG.modv, 0) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(src, 0) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterThan(src, 31) ThenBlock: { ReturnValue(0) }
        ReturnValue(Dereference(Add(SynthG.modv, Multiply(src, 8))))
    }
}

Function.Synth_RouteSum {
    Input: v: Address
    Input: dst: Integer
    Output: Integer
    Body: {
        mlist = SynthG.mlists
        IfCondition EqualTo(mlist, 0) ThenBlock: { ReturnValue(0) }
        acc = 0
        live_at = PoolFieldOffset(LinkagePool.MLists, "live")
        next_at = PoolFieldOffset(LinkagePool.MRoute, "next")
        src_at = PoolFieldOffset(LinkagePool.MRoute, "src")
        dst_at = PoolFieldOffset(LinkagePool.MRoute, "dst")
        dep_at = PoolFieldOffset(LinkagePool.MRoute, "depth")
        rt = Dereference(Add(mlist, live_at))
        WhileLoop NotEqual(rt, 0) {
            IfCondition EqualTo(Dereference(Add(rt, dst_at)), dst) ThenBlock: {
                srcid = Dereference(Add(rt, src_at))
                srcv = Synth_RouteSrc(v, srcid)
                dep = Dereference(Add(rt, dep_at))
                acc = Add(acc, Divide(Multiply(srcv, dep), 256))
            }
            rt = Dereference(Add(rt, next_at))
        }
        ReturnValue(acc)
    }
}

Function.Synth_ApplyRoutes {
    Input: v: Address
    Body: {
        IfCondition EqualTo(v, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(GetByte(v, SOsc.WAVE), 8) ThenBlock: {
            StoreValue(Add(v, SOsc.ROUTE_CUT), 0)
            ReturnValue(0)
        }
        cut = Synth_RouteSum(v, SDst.CUTOFF)
        StoreValue(Add(v, SOsc.ROUTE_CUT), cut)
    }
}

Function.Synth_RenderS16Stereo {
    Input: syn: Address
    Input: dst: Address
    Input: frames: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(syn, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(dst, 0) ThenBlock: { ReturnValue(0) }
        nbytes = Multiply(frames, 16)
        IfCondition EqualTo(SynthG.pcmbuf, 0) ThenBlock: {
            SynthG.pcmbuf = Allocate(nbytes)
        }
        acc = SynthG.pcmbuf
        IfCondition EqualTo(acc, 0) ThenBlock: { ReturnValue(0) }
        MemorySet(acc, 0, nbytes)
        lists = SynthG.lists
        IfCondition NotEqual(lists, 0) ThenBlock: {
            node = lists@live
            lists@live = 0
            lists@nlive = 0
            WhileLoop NotEqual(node, 0) {
                nxt = node@next
                v = node@voice
                keep = 0
                wv = 0
                IfCondition NotEqual(v, 0) ThenBlock: {
                    wv = GetByte(v, SOsc.WAVE)
                }
                IfCondition EqualTo(wv, 8) ThenBlock: {
                    keep = Synth_SampleBlock(v, acc, frames)
                } ElseBlock: {
                    Synth_ApplyRoutes(v)
                    fi = 0
                    WhileLoop LessThan(fi, frames) {
                        sv = Synth_VoiceTick(v, 1)
                        svR = Dereference(Add(v, SOsc.LASTR))
                        bfi = Multiply(fi, 16)
                        cL = Dereference(Add(acc, bfi))
                        StoreValue(Add(acc, bfi), Add(cL, sv))
                        bfiR = Add(bfi, 8)
                        cR = Dereference(Add(acc, bfiR))
                        StoreValue(Add(acc, bfiR), Add(cR, svR))
                        fi = Add(fi, 1)
                    }
                    stv = GetByte(v, SOsc.ENV_ST)
                    IfCondition NotEqual(stv, SEnv.IDLE) ThenBlock: { keep = 1 }
                }
                IfCondition EqualTo(keep, 1) ThenBlock: {
                    node@next = lists@live
                    lists@live = node
                    lists@nlive = Add(lists@nlive, 1)
                } ElseBlock: {
                    Synth_MapSet(node@ch, node@note, -1)
                    node@next = lists@free
                    lists@free = node
                    lists@nfree = Add(lists@nfree, 1)
                }
                node = nxt
            }
        }
        mg = Dereference(Add(syn, SOff.MIXGAIN))
        f = 0
        WhileLoop LessThan(f, frames) {
            b0 = Multiply(f, 16)
            l0 = Dereference(Add(acc, b0))
            r0 = Dereference(Add(acc, Add(b0, 8)))
            f2 = Add(f, 1)
            b1 = Multiply(f2, 16)
            l1 = Dereference(Add(acc, b1))
            r1 = Dereference(Add(acc, Add(b1, 8)))
            l0 = Divide(Multiply(l0, mg), 256)
            r0 = Divide(Multiply(r0, mg), 256)
            l1 = Divide(Multiply(l1, mg), 256)
            r1 = Divide(Multiply(r1, mg), 256)
            l0 = Synth_DelayTick(syn, l0, 0)
            r0 = Synth_DelayTick(syn, r0, 1)
            l1 = Synth_DelayTick(syn, l1, 0)
            r1 = Synth_DelayTick(syn, r1, 1)
            aL = l0
            IfCondition LessThan(aL, 0) ThenBlock: { aL = Subtract(0, aL) }
            IfCondition GreaterThan(aL, SynthG.peak) ThenBlock: { SynthG.peak = aL }
            IfCondition GreaterThan(aL, 32767) ThenBlock: { SynthG.clips = Add(SynthG.clips, 1) }
            u0 = Synth_U16(l0)
            v0 = Synth_U16(r0)
            u1 = Synth_U16(l1)
            v1 = Synth_U16(r1)
            q = u0
            t = ShiftLeft(v0, 16)
            q = Add(q, t)
            t = ShiftLeft(u1, 32)
            q = Add(q, t)
            t = ShiftLeft(v1, 48)
            q = Add(q, t)
            off = Multiply(f, 4)
            StoreValue(Add(dst, off), q)
            f = Add(f, 2)
        }
        ReturnValue(frames)
    }
}

Function.Synth_UniqueLevels {
    Input: buf: Address
    Input: frames: Integer
    Output: Integer
    Body: {
        seen = Allocate(65536)
        MemorySet(seen, 0, 65536)
        n = 0
        i = 0
        WhileLoop LessThan(i, frames) {
            lo = GetByte(buf, Multiply(i, 2))
            hi = GetByte(buf, Add(Multiply(i, 2), 1))
            u = Add(lo, Multiply(hi, 256))
            IfCondition EqualTo(GetByte(seen, u), 0) ThenBlock: {
                SetByte(seen, u, 1)
                n = Add(n, 1)
            }
            i = Add(i, 1)
        }
        Deallocate(seen, 65536)
        ReturnValue(n)
    }
}

Function.Synth_ZeroCross {
    Input: buf: Address
    Input: frames: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(frames, 2) ThenBlock: { ReturnValue(0) }
        z = 0
        i = 1
        WhileLoop LessThan(i, frames) {
            po = Multiply(Subtract(i, 1), 2)
            co = Multiply(i, 2)
            plo = GetByte(buf, po)
            phi = GetByte(buf, Add(po, 1))
            clo = GetByte(buf, co)
            chi = GetByte(buf, Add(co, 1))
            p = Add(plo, Multiply(phi, 256))
            c = Add(clo, Multiply(chi, 256))
            IfCondition GreaterThan(p, 32767) ThenBlock: { p = Subtract(p, 65536) }
            IfCondition GreaterThan(c, 32767) ThenBlock: { c = Subtract(c, 65536) }
            IfCondition And(LessThan(p, 0), GreaterEqual(c, 0)) ThenBlock: {
                z = Add(z, 1)
            }
            IfCondition And(GreaterEqual(p, 0), LessThan(c, 0)) ThenBlock: {
                z = Add(z, 1)
            }
            i = Add(i, 1)
        }
        ReturnValue(z)
    }
}

Function.Synth_WriteWav16 {
    Input: path: Address
    Input: buf: Address
    Input: frames: Integer
    Input: rate: Integer
    Output: Integer
    Body: {
        data_bytes = Multiply(frames, 2)
        hdr = Allocate(44)
        MemorySet(hdr, 0, 44)
        SetByte(hdr, 0, 82)
        SetByte(hdr, 1, 73)
        SetByte(hdr, 2, 70)
        SetByte(hdr, 3, 70)
        riff = Add(36, data_bytes)
        SetByte(hdr, 4, Modulo(riff, 256))
        SetByte(hdr, 5, Modulo(Divide(riff, 256), 256))
        SetByte(hdr, 6, Modulo(Divide(riff, 65536), 256))
        SetByte(hdr, 7, Modulo(Divide(riff, 16777216), 256))
        SetByte(hdr, 8, 87)
        SetByte(hdr, 9, 65)
        SetByte(hdr, 10, 86)
        SetByte(hdr, 11, 69)
        SetByte(hdr, 12, 102)
        SetByte(hdr, 13, 109)
        SetByte(hdr, 14, 116)
        SetByte(hdr, 15, 32)
        SetByte(hdr, 16, 16)
        SetByte(hdr, 20, 1)
        SetByte(hdr, 22, 1)
        SetByte(hdr, 24, Modulo(rate, 256))
        SetByte(hdr, 25, Modulo(Divide(rate, 256), 256))
        SetByte(hdr, 26, Modulo(Divide(rate, 65536), 256))
        br = Multiply(rate, 2)
        SetByte(hdr, 28, Modulo(br, 256))
        SetByte(hdr, 29, Modulo(Divide(br, 256), 256))
        SetByte(hdr, 30, Modulo(Divide(br, 65536), 256))
        SetByte(hdr, 32, 2)
        SetByte(hdr, 34, 16)
        SetByte(hdr, 36, 100)
        SetByte(hdr, 37, 97)
        SetByte(hdr, 38, 116)
        SetByte(hdr, 39, 97)
        SetByte(hdr, 40, Modulo(data_bytes, 256))
        SetByte(hdr, 41, Modulo(Divide(data_bytes, 256), 256))
        SetByte(hdr, 42, Modulo(Divide(data_bytes, 65536), 256))
        SetByte(hdr, 43, Modulo(Divide(data_bytes, 16777216), 256))
        fd = SystemCall(SSys.SYS_OPEN, path, 577, 420)
        IfCondition LessThan(fd, 0) ThenBlock: {
            Deallocate(hdr, 44)
            ReturnValue(0)
        }
        SystemCall(SSys.SYS_WRITE, fd, hdr, 44)
        SystemCall(SSys.SYS_WRITE, fd, buf, data_bytes)
        SystemCall(SSys.SYS_CLOSE, fd)
        Deallocate(hdr, 44)
        ReturnValue(Add(44, data_bytes))
    }
}
