    "NVOICE":    Initialize=16
    "VOICES":    Initialize=24
    "BITS":      Initialize=32
    "QUAL":      Initialize=40
    "TAB":       Initialize=48
    "NOTEHZ":    Initialize=56
    "DELAYBUF":  Initialize=64
    "DELAYCAP":  Initialize=72
    "DELAYPOS":  Initialize=80
    "DELAYLEN":  Initialize=88
    "DELAYFB":   Initialize=96
    "DELAYWET":  Initialize=104
    "MIXGAIN":   Initialize=112
    "SAMPLE":    Initialize=120
    "DELAYBUFR": Initialize=128
    "DELAYPOSR": Initialize=136
    "MIXR":      Initialize=144
