    "STEP2":   Initialize=120
    "DETUNE":  Initialize=128
    "FENV":    Initialize=136
    "LFO_PH":  Initialize=144
    "LFO_SP":  Initialize=152
    "LFO_PWM": Initialize=160
    "SUBMIX":  Initialize=168
    "DRIVE":   Initialize=176
    "BASE":    Initialize=184
    "PMOD":    Initialize=192
