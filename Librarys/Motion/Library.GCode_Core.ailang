// ============================================================================
// MODAL STATE - The "Memory" of the G-Code Interpreter
// ============================================================================

FixedPool.ModalState {
   
    "motion_mode": Initialize=0        
    
    
    "plane": Initialize=17              
    
   
    "distance_mode": Initialize=90      
    
   
    "feed_mode": Initialize=94         
    
   
    "units": Initialize=21            
    
   
    "cutter_comp": Initialize=40      
    
    
    "tool_offset": Initialize=49       
    
   
    "coord_system": Initialize=54      
    
  
    "current_x": Initialize=0
    "current_y": Initialize=0
    "current_z": Initialize=0
    "current_a": Initialize=0
    "current_b": Initialize=0
    "current_c": Initialize=0
    
   
    "feed_rate": Initialize=0         
    "spindle_speed": Initialize=0      
    
  
    "tool_number": Initialize=0       
    
  
    "coolant": Initialize=0           
}

// ============================================================================
// PARSER RESULT - Shared State for Parse Functions
// ============================================================================

FixedPool.ParserResult {
    "last_float_value": Initialize=0    
    "last_int_value": Initialize=0     
    "parse_index": Initialize=0        
    "parse_error": Initialize=0         
}

// ============================================================================
// PARSER UTILITIES - Number Conversion with Bounds Checking
// ============================================================================

Function.Parser.ParseFloat {
    Input: str: Address
    Input: start_index: Integer
    Output: Integer
    Body: {
        i = start_index
        val = 0
        sign = 1
        divisor = 1
        decimal_seen = 0
        str_len = StringLength(str)
        
        // Bounds check
        Fork GreaterEqual(i, str_len) TrueBlock: {
            ParserResult.last_float_value = 0
            ReturnValue(i)
        } FalseBlock: {
        }
        
        // Check for negative sign
        ch = GetByte(str, i)
        Fork EqualTo(ch, 45) TrueBlock: {
            sign = -1
            i = Add(i, 1)
        } FalseBlock: {
        }
        
        // Parse digits and decimal
        WhileLoop LessThan(i, str_len) {
            ch = GetByte(str, i)
            
            // Null terminator
            Fork EqualTo(ch, 0) TrueBlock: {
                BreakLoop
            } FalseBlock: {
            }
            
            // Digit (0-9)
            Fork And(GreaterEqual(ch, 48), LessEqual(ch, 57)) TrueBlock: {
                digit = Subtract(ch, 48)
                val = Add(Multiply(val, 10), digit)
                
                Fork EqualTo(decimal_seen, 1) TrueBlock: {
                    divisor = Multiply(divisor, 10)
                } FalseBlock: {
                }
            } FalseBlock: {
                // Decimal point
                Fork EqualTo(ch, 46) TrueBlock: {
                    Fork EqualTo(decimal_seen, 1) TrueBlock: {
                        BreakLoop
                    } FalseBlock: {
                    }
                    decimal_seen = 1
                } FalseBlock: {
                    BreakLoop
                }
            }
            i = Add(i, 1)
        }
        
        // Scale to fixed-point (4 decimal places)
        scaled = Divide(Multiply(val, 10000), divisor)
        
        Fork EqualTo(sign, -1) TrueBlock: {
            scaled = Subtract(0, scaled)
        } FalseBlock: {
        }
        
        ParserResult.last_float_value = scaled
        ReturnValue(i)
    }
}

Function.Parser.ParseInteger {
    Input: str: Address
    Input: start_index: Integer
    Output: Integer
    Body: {
        i = start_index
        val = 0
        str_len = StringLength(str)
        
        // Bounds check
        Fork GreaterEqual(i, str_len) TrueBlock: {
            ParserResult.last_int_value = 0
            ReturnValue(i)
        } FalseBlock: {
        }
        
        WhileLoop LessThan(i, str_len) {
            ch = GetByte(str, i)
            
            // Null check
            Fork EqualTo(ch, 0) TrueBlock: {
                BreakLoop
            } FalseBlock: {
            }
            
            // Digit (0-9)
            Fork And(GreaterEqual(ch, 48), LessEqual(ch, 57)) TrueBlock: {
                digit = Subtract(ch, 48)
                val = Add(Multiply(val, 10), digit)
                i = Add(i, 1)
            } FalseBlock: {
                BreakLoop
            }
        }
        
        ParserResult.last_int_value = val
        ReturnValue(i)
    }
}

// ============================================================================
// UTILITY FUNCTIONS
// ============================================================================

Function.Core.ResetModalState {
    Output: Integer
    Body: {
        ModalState.motion_mode = 0
        ModalState.plane = 17
        ModalState.distance_mode = 90
        ModalState.feed_mode = 94
        ModalState.units = 21
        ModalState.cutter_comp = 40
        ModalState.tool_offset = 49
        ModalState.coord_system = 54
        
        ModalState.current_x = 0
        ModalState.current_y = 0
        ModalState.current_z = 0
        ModalState.current_a = 0
        ModalState.current_b = 0
        ModalState.current_c = 0
        
        ModalState.feed_rate = 0
        ModalState.spindle_speed = 0
        ModalState.tool_number = 0
        ModalState.coolant = 0
        
        PrintMessage("[CORE] Modal state reset to defaults\n")
        ReturnValue(1)
    }
}

PrintMessage("[CORE] Library loaded - Modal State & Parser Utilities ready\n")