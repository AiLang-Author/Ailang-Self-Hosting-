// Library.GCode_Interpreter.ailang
// Main Interpreter: Line Parser, Command Dispatcher, File I/O

LibraryImport.Arena

PrintMessage("GCode Interpreter v2.0 - Modular Architecture\n")

LibraryImport.Motion.GCode_Core
LibraryImport.Motion.GCode_Queue
LibraryImport.Motion.GCode_Motion
LibraryImport.Motion.GCode_Machine
LibraryImport.Motion.GCode_Statements

// ============================================================================
// LINE PROCESSOR - Dispatches to appropriate library functions
// ============================================================================

Function.Interpreter.ProcessLine {
    Input: line: Address
    Output: Integer
    Body: {
        new_x = ModalState.current_x
        new_y = ModalState.current_y
        new_z = ModalState.current_z
        has_move = 0
        
        len = StringLength(line)
        i = 0
        
        WhileLoop LessThan(i, len) {
            ch = GetByte(line, i)
            
            // Null terminator check
            Fork EqualTo(ch, 0) TrueBlock: {
                BreakLoop
            } FalseBlock: {
            }
            
            // ===== G-CODES =====
            Fork EqualTo(ch, 71) TrueBlock: {
                i = Add(i, 1)
                i = Parser.ParseInteger(line, i)
                code = ParserResult.last_int_value
                
                // Motion modes
                Fork EqualTo(code, 0) TrueBlock: { ModalState.motion_mode = 0 } FalseBlock: { }
                Fork EqualTo(code, 1) TrueBlock: { ModalState.motion_mode = 1 } FalseBlock: { }
                Fork EqualTo(code, 2) TrueBlock: { ModalState.motion_mode = 2 } FalseBlock: { }
                Fork EqualTo(code, 3) TrueBlock: { ModalState.motion_mode = 3 } FalseBlock: { }
                
                // Plane selection
                Fork EqualTo(code, 17) TrueBlock: { result = Motion.G17_PlaneXY() } FalseBlock: { }
                Fork EqualTo(code, 18) TrueBlock: { result = Motion.G18_PlaneXZ() } FalseBlock: { }
                Fork EqualTo(code, 19) TrueBlock: { result = Motion.G19_PlaneYZ() } FalseBlock: { }
                
                // Units
                Fork EqualTo(code, 20) TrueBlock: { result = Motion.G20_Inches() } FalseBlock: { }
                Fork EqualTo(code, 21) TrueBlock: { result = Motion.G21_Millimeters() } FalseBlock: { }
                
                // Distance mode
                Fork EqualTo(code, 90) TrueBlock: { result = Motion.G90_Absolute() } FalseBlock: { }
                Fork EqualTo(code, 91) TrueBlock: { result = Motion.G91_Incremental() } FalseBlock: { }
            } FalseBlock: {
            }
            
            // ===== COORDINATES =====
            Fork EqualTo(ch, 88) TrueBlock: {
                i = Parser.ParseFloat(line, Add(i, 1))
                new_x = ParserResult.last_float_value
                has_move = 1
                i = Subtract(i, 1)
            } FalseBlock: {
            }
            
            Fork EqualTo(ch, 89) TrueBlock: {
                i = Parser.ParseFloat(line, Add(i, 1))
                new_y = ParserResult.last_float_value
                has_move = 1
                i = Subtract(i, 1)
            } FalseBlock: {
            }
            
            Fork EqualTo(ch, 90) TrueBlock: {
                i = Parser.ParseFloat(line, Add(i, 1))
                new_z = ParserResult.last_float_value
                has_move = 1
                i = Subtract(i, 1)
            } FalseBlock: {
            }
            
            // ===== FEED RATE =====
            Fork EqualTo(ch, 70) TrueBlock: {
                i = Parser.ParseFloat(line, Add(i, 1))
                ModalState.feed_rate = ParserResult.last_float_value
                i = Subtract(i, 1)
            } FalseBlock: {
            }
            
            // ===== SPINDLE SPEED =====
            Fork EqualTo(ch, 83) TrueBlock: {
                i = Parser.ParseInteger(line, Add(i, 1))
                ModalState.spindle_speed = ParserResult.last_int_value
                i = Subtract(i, 1)
            } FalseBlock: {
            }
            
            // ===== M-CODES =====
            Fork EqualTo(ch, 77) TrueBlock: {
                i = Add(i, 1)
                i = Parser.ParseInteger(line, i)
                mcode = ParserResult.last_int_value
                
                // Spindle
                Fork EqualTo(mcode, 3) TrueBlock: { result = Machine.M03_SpindleCW(ModalState.spindle_speed) } FalseBlock: { }
                Fork EqualTo(mcode, 4) TrueBlock: { result = Machine.M04_SpindleCCW(ModalState.spindle_speed) } FalseBlock: { }
                Fork EqualTo(mcode, 5) TrueBlock: { result = Machine.M05_SpindleOff() } FalseBlock: { }
                
                // Tool change
                Fork EqualTo(mcode, 6) TrueBlock: { result = Machine.M06_ToolChange(ModalState.tool_number) } FalseBlock: { }
                
                // Coolant
                Fork EqualTo(mcode, 7) TrueBlock: { result = Machine.M07_CoolantMist() } FalseBlock: { }
                Fork EqualTo(mcode, 8) TrueBlock: { result = Machine.M08_CoolantFlood() } FalseBlock: { }
                Fork EqualTo(mcode, 9) TrueBlock: { result = Machine.M09_CoolantOff() } FalseBlock: { }
                
                // Program control
                Fork EqualTo(mcode, 0) TrueBlock: { result = Machine.M00_ProgramStop() } FalseBlock: { }
                Fork EqualTo(mcode, 2) TrueBlock: { result = Machine.M02_ProgramEnd() } FalseBlock: { }
                Fork EqualTo(mcode, 30) TrueBlock: { result = Machine.M30_ProgramEndRewind() } FalseBlock: { }
                
                i = Subtract(i, 1)
            } FalseBlock: {
            }
            
            i = Add(i, 1)
        }
        
        // ===== EXECUTE MOTION =====
        Fork EqualTo(has_move, 1) TrueBlock: {
            // Dispatch based on modal motion mode
            Fork EqualTo(ModalState.motion_mode, 0) TrueBlock: {
                result = Motion.G00_RapidTraverse(new_x, new_y, new_z)
            } FalseBlock: {
            }
            
            Fork EqualTo(ModalState.motion_mode, 1) TrueBlock: {
                result = Motion.G01_LinearFeed(new_x, new_y, new_z)
            } FalseBlock: {
            }
        } FalseBlock: {
        }
        
        ReturnValue(1)
    }
}

// ============================================================================
// FILE PROCESSOR
// ============================================================================

Function.Interpreter.ProcessFile {
    Input: filename: Address
    Output: Integer
    Body: {
        PrintMessage("[INTERP] Opening G-code file: ")
        PrintMessage(filename)
        PrintMessage("\n")
        
        fd = SystemCall(2, filename, 0, 0)
        Fork LessThan(fd, 0) TrueBlock: {
            PrintMessage("[INTERP] ERROR: Cannot open file\n")
            ReturnValue(0)
        } FalseBlock: {
        }
        
        // Initialize systems
        result = Core.ResetModalState()
        result = MotionQueue.Initialize()
        
        // Line buffer
        line_buf = Allocate(256)
        buf_ptr = 0
        
        reading = 1
        lines_processed = 0
        char_buf = Allocate(1)
        
        WhileLoop EqualTo(reading, 1) {
            bytes = SystemCall(0, fd, char_buf, 1)
            
            Fork LessEqual(bytes, 0) TrueBlock: {
                reading = 0
            } FalseBlock: {
                ch = GetByte(char_buf, 0)
                
                Fork EqualTo(ch, 10) TrueBlock: {
                    SetByte(line_buf, buf_ptr, 0)
                    
                    result = Interpreter.ProcessLine(line_buf)
                    lines_processed = Add(lines_processed, 1)
                    
                    // Drain queue if getting full
                    Fork GreaterThan(MotionQueue.count, 800) TrueBlock: {
                        MotionQueue.count = 0
                        MotionQueue.head = MotionQueue.tail
                    } FalseBlock: {
                    }
                    
                    buf_ptr = 0
                } FalseBlock: {
                    SetByte(line_buf, buf_ptr, ch)
                    buf_ptr = Add(buf_ptr, 1)
                }
            }
        }
        
        SystemCall(3, fd)
        Deallocate(char_buf, 1)
        Deallocate(line_buf, 256)
        
        PrintMessage("[INTERP] Processing complete\n")
        PrintMessage("[INTERP] Lines processed: ")
        PrintNumber(lines_processed)
        PrintMessage("\n")
        
        ReturnValue(1)
    }
}

PrintMessage("[INTERP] Main interpreter loaded - Ready to process G-code\n")