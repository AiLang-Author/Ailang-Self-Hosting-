PrintMessage("GCode Motion Library v1.0 - Motion Commands\n")

LibraryImport.Motion.GCode_Core
LibraryImport.Motion.GCode_Queue

// ============================================================================
// MOTION COMMAND HANDLERS
// ============================================================================

Function.Motion.G00_RapidTraverse {
    Input: x: Integer
    Input: y: Integer
    Input: z: Integer
    Output: Integer
    Body: {
        ModalState.motion_mode = 0
        result = MotionQueue.PushCommand(CommandTypes.CMD_STRAIGHT_TRAVERSE, x, y, z)
        ModalState.current_x = x
        ModalState.current_y = y
        ModalState.current_z = z
        ReturnValue(result)
    }
}

Function.Motion.G01_LinearFeed {
    Input: x: Integer
    Input: y: Integer
    Input: z: Integer
    Output: Integer
    Body: {
        ModalState.motion_mode = 1
        result = MotionQueue.PushCommand(CommandTypes.CMD_STRAIGHT_FEED, x, y, z)
        ModalState.current_x = x
        ModalState.current_y = y
        ModalState.current_z = z
        ReturnValue(result)
    }
}

