// ============================================================================
// PLANE SELECTION (G17-G19)
// ============================================================================

Function.Motion.G17_PlaneXY {
    Output: Integer
    Body: {
        ModalState.plane = 17
        PrintMessage("[MOTION] Plane set to XY\n")
        ReturnValue(1)
    }
}

