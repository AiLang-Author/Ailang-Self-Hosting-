// Library.GCode_PathBridge.ailang
// Integration Bridge: GCode Interpreter → PathLookahead → MotionPlanner
// Converts GCode commands into optimized motion segments
//
// Copyright (c) 2025 Sean Collins, 2 Paws Machine and Engineering

LibraryImport.Arena
LibraryImport.Motion.GCode_Core
LibraryImport.Motion.MotionPlanner
LibraryImport.Motion.PathLookahead

PrintMessage("GCode Path Bridge v1.0 - Interpreter Integration Layer\n")

// ============================================================================
// BRIDGE CONFIGURATION
// ============================================================================

FixedPool.BridgeConfig {
    "num_axes": Initialize=3
    "scale_factor": Initialize=10000
    "default_rapid_vel": Initialize=2000000
    "min_feed_rate": Initialize=10000
    "max_feed_rate": Initialize=1200000
    "initialized": Initialize=0
}

FixedPool.BridgeState {
    "planning_enabled": Initialize=1
    "executing": Initialize=0
    "lines_queued": Initialize=0
    "lines_executed": Initialize=0
}

// ============================================================================
// INITIALIZATION
// ============================================================================

Function.PathBridge.Init {
    Input: num_axes: Integer
    Input: max_jerk: Integer
    Input: max_accel: Integer
    Input: max_velocity: Integer
    Output: Integer
    Body: {
        PrintMessage("[BRIDGE] Initializing GCode → Motion integration...\n")
        
        // Validate axes
        Fork LessThan(num_axes, 3) TrueBlock: {
            PrintMessage("[BRIDGE] ERROR: Minimum 3 axes required (XYZ)\n")
            ReturnValue(0)
        } FalseBlock: {
        }
        
        Fork GreaterThan(num_axes, 9) TrueBlock: {
            PrintMessage("[BRIDGE] ERROR: Maximum 9 axes supported\n")
            ReturnValue(0)
        } FalseBlock: {
        }
        
        BridgeConfig.num_axes = num_axes
        
        // Initialize motion systems (cycle_time=100us for RT loop)
        result = MotionPlanner.Init(num_axes, max_jerk, max_accel, max_velocity, 100)
        
        Fork EqualTo(result, -1) TrueBlock: {
            PrintMessage("[BRIDGE] ERROR: MotionPlanner init failed\n")
            ReturnValue(0)
        } FalseBlock: {
        }
        
        result = PathLookahead.Init(num_axes)
        
        Fork EqualTo(result, 0) TrueBlock: {
            PrintMessage("[BRIDGE] ERROR: PathLookahead init failed\n")
            ReturnValue(0)
        } FalseBlock: {
        }
        
        // Initialize GCode modal state
        result = Core.ResetModalState()
        
        BridgeConfig.initialized = 1
        BridgeState.lines_queued = 0
        BridgeState.lines_executed = 0
        
        PrintMessage("[BRIDGE] Initialized: ")
        PrintNumber(num_axes)
        PrintMessage(" axes\n")
        PrintMessage("[BRIDGE]   MaxVel=")
        PrintNumber(Divide(max_velocity, 10000))
        PrintMessage(" MaxAccel=")
        PrintNumber(Divide(max_accel, 10000))
        PrintMessage(" MaxJerk=")
        PrintNumber(Divide(max_jerk, 10000))
        PrintMessage("\n")
        
        ReturnValue(1)
    }
}

// ============================================================================
// GCODE COMMAND → LOOKAHEAD SEGMENT
// ============================================================================

Function.PathBridge.QueueMove {
    Input: x: Integer
    Input: y: Integer
    Input: z: Integer
    Input: is_rapid: Integer
    Output: Integer
    Body: {
        Fork EqualTo(BridgeConfig.initialized, 0) TrueBlock: {
            PrintMessage("[BRIDGE] ERROR: Not initialized\n")
            ReturnValue(0)
        } FalseBlock: {
        }
        
        num_axes = BridgeConfig.num_axes
        
        // Build target position array
        target = Allocate(Multiply(num_axes, 8))
        
        // XYZ (axes 0-2)
        StoreValue(Add(target, 0), x)
        StoreValue(Add(target, 8), y)
        StoreValue(Add(target, 16), z)
        
        // Additional axes default to current position
        Fork GreaterThan(num_axes, 3) TrueBlock: {
            i = 3
            WhileLoop LessThan(i, num_axes) {
                offset = Multiply(i, 8)
                cur_pos = MotionPlanner.GetPosition(i)
                StoreValue(Add(target, offset), cur_pos)
                i = Add(i, 1)
            }
        } FalseBlock: {
        }
        
        // Determine feed rate
        Fork EqualTo(is_rapid, 1) TrueBlock: {
            feed_rate = BridgeConfig.default_rapid_vel
        } FalseBlock: {
            feed_rate = ModalState.feed_rate
            
            // Clamp to limits
            Fork LessThan(feed_rate, BridgeConfig.min_feed_rate) TrueBlock: {
                feed_rate = BridgeConfig.min_feed_rate
            } FalseBlock: {
            }
            
            Fork GreaterThan(feed_rate, BridgeConfig.max_feed_rate) TrueBlock: {
                feed_rate = BridgeConfig.max_feed_rate
            } FalseBlock: {
            }
        }
        
        // Push to lookahead buffer
        result = PathLookahead.PushSegment(target, feed_rate)
        
        Fork EqualTo(result, 0) TrueBlock: {
            PrintMessage("[BRIDGE] ERROR: Failed to queue segment (buffer full?)\n")
            Deallocate(target, Multiply(num_axes, 8))
            ReturnValue(0)
        } FalseBlock: {
        }
        
        BridgeState.lines_queued = Add(BridgeState.lines_queued, 1)
        
        Deallocate(target, Multiply(num_axes, 8))
        ReturnValue(1)
    }
}

// ============================================================================
// PLAN & EXECUTE QUEUED MOVES
// ============================================================================

Function.PathBridge.PlanPath {
    Output: Integer
    Body: {
        count = PathLookahead.GetCount()
        
        Fork EqualTo(count, 0) TrueBlock: {
            PrintMessage("[BRIDGE] No segments to plan\n")
            ReturnValue(0)
        } FalseBlock: {
        }
        
        PrintMessage("[BRIDGE] Planning ")
        PrintNumber(count)
        PrintMessage(" segments...\n")
        
        result = PathLookahead.Plan()
        
        Fork EqualTo(result, 0) TrueBlock: {
            PrintMessage("[BRIDGE] ERROR: Planning failed\n")
            ReturnValue(0)
        } FalseBlock: {
        }
        
        PrintMessage("[BRIDGE] Path planned successfully\n")
        
        ReturnValue(1)
    }
}

Function.PathBridge.ExecuteNextSegment {
    Output: Integer
    Body: {
        // Check if motion planner is idle
        phase = MotionPlanner.GetPhase()
        Fork NotEqual(phase, MotionPhases.IDLE) TrueBlock: {
            // Still executing previous segment
            ReturnValue(0)
        } FalseBlock: {
        }
        
        // Pop next segment from lookahead
        segment = PathLookahead.PopSegment()
        
        Fork EqualTo(segment, 0) TrueBlock: {
            // No more segments
            ReturnValue(-1)
        } FalseBlock: {
        }
        
        // Extract segment data
        targets = PathLookahead.GetSegmentTargets(segment)
        entry_vel = PathLookahead.GetSegmentEntryVel(segment)
        cruise_vel = PathLookahead.GetSegmentCruiseVel(segment)
        exit_vel = PathLookahead.GetSegmentExitVel(segment)
        
        // Load into motion planner
        result = MotionPlanner.SetTarget(targets, exit_vel, cruise_vel)
        
        Fork EqualTo(result, MotionReturnCodes.ERROR) TrueBlock: {
            PrintMessage("[BRIDGE] ERROR: Failed to load segment\n")
            ReturnValue(0)
        } FalseBlock: {
        }
        
        BridgeState.lines_executed = Add(BridgeState.lines_executed, 1)
        
        ReturnValue(1)
    }
}

// ============================================================================
// OVERRIDE G00/G01 HANDLERS
// ============================================================================

Function.PathBridge.G00_RapidTraverse {
    Input: x: Integer
    Input: y: Integer
    Input: z: Integer
    Output: Integer
    Body: {
        result = PathBridge.QueueMove(x, y, z, 1)
        
        // Update modal state
        ModalState.current_x = x
        ModalState.current_y = y
        ModalState.current_z = z
        ModalState.motion_mode = 0
        
        ReturnValue(result)
    }
}

Function.PathBridge.G01_LinearFeed {
    Input: x: Integer
    Input: y: Integer
    Input: z: Integer
    Output: Integer
    Body: {
        result = PathBridge.QueueMove(x, y, z, 0)
        
        // Update modal state
        ModalState.current_x = x
        ModalState.current_y = y
        ModalState.current_z = z
        ModalState.motion_mode = 1
        
        ReturnValue(result)
    }
}

// ============================================================================
// STATUS & STATISTICS
// ============================================================================

Function.PathBridge.GetStatus {
    Body: {
        PrintMessage("[BRIDGE] Status:\n")
        PrintMessage("  Lines queued: ")
        PrintNumber(BridgeState.lines_queued)
        PrintMessage("\n  Lines executed: ")
        PrintNumber(BridgeState.lines_executed)
        PrintMessage("\n  Lookahead buffer: ")
        PrintNumber(PathLookahead.GetCount())
        PrintMessage(" segments\n")
        PrintMessage("  Current phase: ")
        PrintNumber(MotionPlanner.GetPhase())
        PrintMessage("\n")
    }
}

PrintMessage("[BRIDGE] Library loaded - Ready to integrate GCode with motion\n")