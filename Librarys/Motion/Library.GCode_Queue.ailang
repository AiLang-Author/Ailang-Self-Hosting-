LibraryImport.Arena

PrintMessage("GCode Queue Library v1.0 - Ring Buffer & IPC\n")

// ============================================================================
// CONFIGURATION
// ============================================================================

FixedPool.QueueConfig {
    "BUFFER_SIZE": Initialize=1024
    "COMMAND_SIZE": Initialize=64
    "LOOKAHEAD": Initialize=50
}

// ============================================================================
// RING BUFFER STATE
// ============================================================================

FixedPool.MotionQueue {
    "buffer": Initialize=0
    "head": Initialize=0
    "tail": Initialize=0
    "count": Initialize=0
}

// ============================================================================
// COMMAND TYPES
// ============================================================================

FixedPool.CommandTypes {
    "CMD_STRAIGHT_TRAVERSE": Initialize=1  
    "CMD_STRAIGHT_FEED": Initialize=2      
    "CMD_ARC_CW": Initialize=3             
    "CMD_ARC_CCW": Initialize=4           
    "CMD_DWELL": Initialize=5               
    "CMD_SPINDLE_CW": Initialize=10        
    "CMD_SPINDLE_CCW": Initialize=11        
    "CMD_SPINDLE_OFF": Initialize=12       
    "CMD_TOOL_CHANGE": Initialize=13        
    "CMD_COOLANT_MIST": Initialize=14      
    "CMD_COOLANT_FLOOD": Initialize=15     
    "CMD_COOLANT_OFF": Initialize=16       
    "CMD_PROGRAM_STOP": Initialize=17       
    "CMD_PROGRAM_END": Initialize=18      
}

// ============================================================================
// RING BUFFER OPERATIONS
// ============================================================================

Function.MotionQueue.Initialize {
    Output: Integer
    Body: {
        size = Multiply(QueueConfig.BUFFER_SIZE, QueueConfig.COMMAND_SIZE)
        MotionQueue.buffer = Allocate(size)
        MotionQueue.head = 0
        MotionQueue.tail = 0
        MotionQueue.count = 0
        
        PrintMessage("[QUEUE] Motion queue initialized: ")
        PrintNumber(QueueConfig.BUFFER_SIZE)
        PrintMessage(" command slots\n")
        
        ReturnValue(1)
    }
}

Function.MotionQueue.PushCommand {
    Input: type: Integer
    Input: x: Integer
    Input: y: Integer
    Input: z: Integer
    Output: Integer
    Body: {
        // Block if full (cooperative yield)
        WhileLoop GreaterEqual(MotionQueue.count, QueueConfig.BUFFER_SIZE) {
            BreakLoop
        }
        
        tail = MotionQueue.tail
        offset = Multiply(tail, QueueConfig.COMMAND_SIZE)
        addr = Add(MotionQueue.buffer, offset)
        
        // Serialize command (64-byte structure)
        // [0]  Type
        // [8]  X coordinate
        // [16] Y coordinate  
        // [24] Z coordinate
        // [32] Feed rate
        // [40] Spindle speed
        // [48] Reserved
        // [56] Reserved
        
        StoreValue(addr, type)
        StoreValue(Add(addr, 8), x)
        StoreValue(Add(addr, 16), y)
        StoreValue(Add(addr, 24), z)
        StoreValue(Add(addr, 32), ModalState.feed_rate)
        StoreValue(Add(addr, 40), ModalState.spindle_speed)
        
        // Advance tail (circular)
        MotionQueue.tail = Modulo(Add(tail, 1), QueueConfig.BUFFER_SIZE)
        MotionQueue.count = Add(MotionQueue.count, 1)
        
        ReturnValue(1)
    }
}

Function.MotionQueue.PopCommand {
    Output: Address
    Body: {
        // Check if empty
        Fork EqualTo(MotionQueue.count, 0) TrueBlock: {
            ReturnValue(0)
        } FalseBlock: {
        }
        
        head = MotionQueue.head
        offset = Multiply(head, QueueConfig.COMMAND_SIZE)
        addr = Add(MotionQueue.buffer, offset)
        
        // Advance head (circular)
        MotionQueue.head = Modulo(Add(head, 1), QueueConfig.BUFFER_SIZE)
        MotionQueue.count = Subtract(MotionQueue.count, 1)
        
        ReturnValue(addr)
    }
}

Function.MotionQueue.Clear {
    Output: Integer
    Body: {
        MotionQueue.head = 0
        MotionQueue.tail = 0
        MotionQueue.count = 0
        
        PrintMessage("[QUEUE] Motion queue cleared\n")
        ReturnValue(1)
    }
}

Function.MotionQueue.GetCount {
    Output: Integer
    Body: {
        ReturnValue(MotionQueue.count)
    }
}

Function.MotionQueue.IsFull {
    Output: Integer
    Body: {
        Fork GreaterEqual(MotionQueue.count, QueueConfig.BUFFER_SIZE) TrueBlock: {
            ReturnValue(1)
        } FalseBlock: {
            ReturnValue(0)
        }
    }
}

Function.MotionQueue.IsEmpty {
    Output: Integer
    Body: {
        Fork EqualTo(MotionQueue.count, 0) TrueBlock: {
            ReturnValue(1)
        } FalseBlock: {
            ReturnValue(0)
        }
    }
}

PrintMessage("[QUEUE] Library loaded - Ring buffer operations ready\n")