// Library.MotionPlanner.ailang
// N-Axis Trajectory Generator with Jerk-Limited S-Curve Profiles
// 
// Supports 1 to 12 axes with coordinated motion
// Based on research by Grotius (Michel Wijnja)
// Performance Target: Sub-microsecond per cycle
//
// Copyright (c) 2025 Sean Collins, 2 Paws Machine and Engineering

LibraryImport.Arena

PrintMessage("Motion Planner Library v1.0 - N-Axis Jerk Limited Trajectories\n")

// ============================================================================
// CONFIGURATION
// ============================================================================

FixedPool.MotionConfig {
    "FIXED_POINT_SCALE": Initialize=10000
    "MAX_AXES": Initialize=12
    "ACTIVE_AXES": Initialize=3
    "CYCLE_TIME_US": Initialize=1000
}

FixedPool.MotionReturnCodes {
    "BUSY": Initialize=0
    "FINISHED": Initialize=1
    "ERROR": Initialize=-1
}

FixedPool.MotionPhases {
    "CONCAVE_ACCEL": Initialize=0
    "LINEAR_ACCEL": Initialize=1
    "CONVEX_ACCEL": Initialize=2
    "CRUISE": Initialize=3
    "CONCAVE_DECEL": Initialize=4
    "LINEAR_DECEL": Initialize=5
    "CONVEX_DECEL": Initialize=6
    "IDLE": Initialize=7
}

// ============================================================================
// STATE DATA
// ============================================================================

FixedPool.MotionState {
    "current_pos": Initialize=0
    "target_pos": Initialize=0
    "direction_vector": Initialize=0
    "current_velocity": Initialize=0
    "current_accel": Initialize=0
    "current_jerk": Initialize=0
    "target_velocity": Initialize=0
    "cruise_velocity": Initialize=0
    "total_distance": Initialize=0
    "max_jerk": Initialize=1000000
    "max_accel": Initialize=200000
    "max_velocity": Initialize=1200000
    "cycle_time": Initialize=10
    "current_phase": Initialize=7
    "phase_time": Initialize=0
    "t_concave_accel": Initialize=0
    "t_linear_accel": Initialize=0
    "t_convex_accel": Initialize=0
    "t_cruise": Initialize=0
    "t_concave_decel": Initialize=0
    "t_linear_decel": Initialize=0
    "t_convex_decel": Initialize=0
    "profile_computed": Initialize=0
    "pausing": Initialize=0
    "initialized": Initialize=0
}

// ============================================================================
// UTILITY: INTEGER SQUARE ROOT
// ============================================================================

Function.MotionPlanner.ISqrt {
    Input: n: Integer
    Output: Integer
    Body: {
        Fork LessEqual(n, 0) TrueBlock: {
            ReturnValue(0)
        } FalseBlock: {
        }
        
        Fork EqualTo(n, 1) TrueBlock: {
            ReturnValue(1)
        } FalseBlock: {
        }
        
        // Binary search for integer square root
        low = 0
        high = n
        result = 0
        
        // Limit high to avoid overflow
        Fork GreaterThan(high, 1000000000) TrueBlock: {
            high = 1000000000
        } FalseBlock: {
        }
        
        WhileLoop LessEqual(low, high) {
            mid = Divide(Add(low, high), 2)
            
            Fork GreaterThan(mid, 0) TrueBlock: {
                Fork LessEqual(mid, Divide(n, mid)) TrueBlock: {
                    result = mid
                    low = Add(mid, 1)
                } FalseBlock: {
                    high = Subtract(mid, 1)
                }
            } FalseBlock: {
                low = Add(mid, 1)
            }
        }
        
        ReturnValue(result)
    }
}

// ============================================================================
// INITIALIZATION
// ============================================================================

Function.MotionPlanner.Init {
    Input: num_axes: Integer
    Input: max_jerk: Integer
    Input: max_accel: Integer
    Input: max_velocity: Integer
    Input: cycle_time: Integer
    Output: Integer
    Body: {
        PrintMessage("[MOTION] Init called with ")
        PrintNumber(num_axes)
        PrintMessage(" axes\n")
        
        // Validate axis count
        Fork LessThan(num_axes, 1) TrueBlock: {
            PrintMessage("[MOTION] ERROR: num_axes < 1\n")
            ReturnValue(-1)
        } FalseBlock: {
        }
        
        Fork GreaterThan(num_axes, 12) TrueBlock: {
            PrintMessage("[MOTION] ERROR: num_axes > 12\n")
            ReturnValue(-1)
        } FalseBlock: {
        }
        
        // Store axis count
        MotionConfig.ACTIVE_AXES = num_axes
        
        PrintMessage("[MOTION] Allocating arrays...\n")
        
        // Calculate bytes needed
        axis_bytes = Multiply(num_axes, 8)
        
        PrintMessage("[MOTION] Need ")
        PrintNumber(axis_bytes)
        PrintMessage(" bytes per array\n")
        
        // Allocate arrays
        MotionState.current_pos = Allocate(axis_bytes)
        MotionState.target_pos = Allocate(axis_bytes)
        MotionState.direction_vector = Allocate(axis_bytes)
        
        PrintMessage("[MOTION] Arrays allocated\n")
        PrintMessage("[MOTION] current_pos = ")
        PrintNumber(MotionState.current_pos)
        PrintMessage("\n")
        PrintMessage("[MOTION] target_pos = ")
        PrintNumber(MotionState.target_pos)
        PrintMessage("\n")
        PrintMessage("[MOTION] direction_vector = ")
        PrintNumber(MotionState.direction_vector)
        PrintMessage("\n")
        
        // Check allocations
        Fork EqualTo(MotionState.current_pos, 0) TrueBlock: {
            PrintMessage("[MOTION] ERROR: Failed to allocate current_pos\n")
            ReturnValue(-1)
        } FalseBlock: {
        }
        
        Fork EqualTo(MotionState.target_pos, 0) TrueBlock: {
            PrintMessage("[MOTION] ERROR: Failed to allocate target_pos\n")
            ReturnValue(-1)
        } FalseBlock: {
        }
        
        Fork EqualTo(MotionState.direction_vector, 0) TrueBlock: {
            PrintMessage("[MOTION] ERROR: Failed to allocate direction_vector\n")
            ReturnValue(-1)
        } FalseBlock: {
        }
        
        PrintMessage("[MOTION] Initializing arrays...\n")
        
        // Initialize all to zero
        i = 0
        WhileLoop LessThan(i, num_axes) {
            offset = Multiply(i, 8)
            StoreValue(Add(MotionState.current_pos, offset), 0)
            StoreValue(Add(MotionState.target_pos, offset), 0)
            StoreValue(Add(MotionState.direction_vector, offset), 0)
            i = Add(i, 1)
        }
        
        PrintMessage("[MOTION] Arrays initialized\n")
        
        // Set motion parameters
        MotionState.max_jerk = max_jerk
        MotionState.max_accel = max_accel
        MotionState.max_velocity = max_velocity
        MotionState.cycle_time = cycle_time
        
        // Initialize state
        MotionState.current_velocity = 0
        MotionState.current_accel = 0
        MotionState.current_jerk = 0
        MotionState.current_phase = MotionPhases.IDLE
        MotionState.profile_computed = 0
        MotionState.initialized = 1
        
        PrintMessage("[MOTION] Initialized: ")
        PrintNumber(num_axes)
        PrintMessage(" axes, MaxJerk=")
        PrintNumber(Divide(max_jerk, MotionConfig.FIXED_POINT_SCALE))
        PrintMessage(" MaxAccel=")
        PrintNumber(Divide(max_accel, MotionConfig.FIXED_POINT_SCALE))
        PrintMessage(" MaxVel=")
        PrintNumber(Divide(max_velocity, MotionConfig.FIXED_POINT_SCALE))
        PrintMessage("\n")
        
        ReturnValue(1)
    }
}

// ============================================================================
// SET TARGET STATE
// ============================================================================

Function.MotionPlanner.SetTarget {
    Input: target_array: Address
    Input: target_velocity: Integer
    Input: cruise_velocity: Integer
    Output: Integer
    Body: {
        // Check initialization
        Fork EqualTo(MotionState.initialized, 0) TrueBlock: {
            PrintMessage("[MOTION] ERROR: Not initialized, call Init first\n")
            ReturnValue(MotionReturnCodes.ERROR)
        } FalseBlock: {
        }
        
        num_axes = MotionConfig.ACTIVE_AXES
        
        // Copy target positions
        i = 0
        WhileLoop LessThan(i, num_axes) {
            offset = Multiply(i, 8)
            src_addr = Add(target_array, offset)
            dst_addr = Add(MotionState.target_pos, offset)
            value = Dereference(src_addr)
            StoreValue(dst_addr, value)
            i = Add(i, 1)
        }
        
        MotionState.target_velocity = target_velocity
        MotionState.cruise_velocity = cruise_velocity
        MotionState.profile_computed = 0
        
        ReturnValue(1)
    }
}

// ============================================================================
// COMPUTE N-DIMENSIONAL DISTANCE
// ============================================================================

Function.MotionPlanner.ComputeDistance {
    Output: Integer
    Body: {
        num_axes = MotionConfig.ACTIVE_AXES
        
        // Validate pointers
        Fork EqualTo(MotionState.current_pos, 0) TrueBlock: {
            PrintMessage("[MOTION] ERROR: current_pos is NULL\n")
            ReturnValue(0)
        } FalseBlock: {
        }
        
        Fork EqualTo(MotionState.target_pos, 0) TrueBlock: {
            PrintMessage("[MOTION] ERROR: target_pos is NULL\n")
            ReturnValue(0)
        } FalseBlock: {
        }
        
        sum_sq = 0
        
        i = 0
        WhileLoop LessThan(i, num_axes) {
            offset = Multiply(i, 8)
            
            cur_addr = Add(MotionState.current_pos, offset)
            tgt_addr = Add(MotionState.target_pos, offset)
            
            cur = Dereference(cur_addr)
            tgt = Dereference(tgt_addr)
            
            delta = Subtract(tgt, cur)
            delta_sq = Multiply(delta, delta)
            sum_sq = Add(sum_sq, delta_sq)
            
            i = Add(i, 1)
        }
        
        distance = MotionPlanner.ISqrt(sum_sq)
        ReturnValue(distance)
    }
}

// ============================================================================
// COMPUTE DIRECTION VECTORS
// ============================================================================

Function.MotionPlanner.ComputeDirections {
    Input: total_distance: Integer
    Body: {
        num_axes = MotionConfig.ACTIVE_AXES
        
        Fork LessEqual(total_distance, 100) TrueBlock: {
            // Too close, just point at target (unit vector on first axis)
            i = 0
            WhileLoop LessThan(i, num_axes) {
                offset = Multiply(i, 8)
                Fork EqualTo(i, 0) TrueBlock: {
                    StoreValue(Add(MotionState.direction_vector, offset), 
                              MotionConfig.FIXED_POINT_SCALE)
                } FalseBlock: {
                    StoreValue(Add(MotionState.direction_vector, offset), 0)
                }
                i = Add(i, 1)
            }
            ReturnValue(0)
        } FalseBlock: {
        }
        
        i = 0
        WhileLoop LessThan(i, num_axes) {
            offset = Multiply(i, 8)
            
            cur = Dereference(Add(MotionState.current_pos, offset))
            tgt = Dereference(Add(MotionState.target_pos, offset))
            
            delta = Subtract(tgt, cur)
            
            // Normalized direction: (delta / distance) * SCALE
            direction = Divide(
                Multiply(delta, MotionConfig.FIXED_POINT_SCALE),
                total_distance)
            
            StoreValue(Add(MotionState.direction_vector, offset), direction)
            
            i = Add(i, 1)
        }
        
        ReturnValue(1)
    }
}

// ============================================================================
// COMPUTE MOTION PROFILE
// ============================================================================

Function.MotionPlanner.ComputeProfile {
    Output: Integer
    Body: {
        // Calculate N-dimensional distance
        delta_pos = MotionPlanner.ComputeDistance()
        MotionState.total_distance = delta_pos
        
        // Compute normalized direction vectors
        result = MotionPlanner.ComputeDirections(delta_pos)
        
        delta_vel = Subtract(MotionState.target_velocity, MotionState.current_velocity)
        
        PrintMessage("[MOTION] Profile: dist=")
        PrintNumber(Divide(delta_pos, 10000))
        PrintMessage(".")
        PrintNumber(Modulo(Divide(delta_pos, 100), 100))
        PrintMessage(" delta_vel=")
        PrintNumber(Divide(delta_vel, 10000))
        PrintMessage("\n")
        
        // Validation
        Fork EqualTo(MotionState.max_jerk, 0) TrueBlock: {
            PrintMessage("[MOTION] ERROR: max_jerk is zero\n")
            ReturnValue(MotionReturnCodes.ERROR)
        } FalseBlock: {
        }
        
        Fork EqualTo(MotionState.max_accel, 0) TrueBlock: {
            PrintMessage("[MOTION] ERROR: max_accel is zero\n")
            ReturnValue(MotionReturnCodes.ERROR)
        } FalseBlock: {
        }
        
        Fork EqualTo(delta_pos, 0) TrueBlock: {
            PrintMessage("[MOTION] Already at target\n")
            MotionState.profile_computed = 1
            MotionState.current_phase = MotionPhases.IDLE
            ReturnValue(1)
        } FalseBlock: {
        }
        
        Fork LessThan(Abs(delta_pos), 1000) TrueBlock: {
            Fork LessThan(Abs(delta_vel), 1000) TrueBlock: {
                PrintMessage("[MOTION] Within tolerance, snapping to target\n")
                
                num_axes = MotionConfig.ACTIVE_AXES
                i = 0
                WhileLoop LessThan(i, num_axes) {
                    offset = Multiply(i, 8)
                    tgt = Dereference(Add(MotionState.target_pos, offset))
                    StoreValue(Add(MotionState.current_pos, offset), tgt)
                    i = Add(i, 1)
                }
                
                MotionState.current_velocity = MotionState.target_velocity
                MotionState.current_phase = MotionPhases.IDLE
                ReturnValue(1)
            } FalseBlock: {
            }
        } FalseBlock: {
        }
        
        // Determine cruise velocity if not specified
        Fork EqualTo(MotionState.cruise_velocity, 0) TrueBlock: {
            Fork And(EqualTo(MotionState.current_velocity, 0), 
                     EqualTo(MotionState.target_velocity, 0)) TrueBlock: {
                // Compute optimal velocity for distance
                optimal_vel = Min(MotionState.max_velocity,
                    MotionPlanner.ISqrt(Multiply(Abs(delta_pos), MotionState.max_accel)))
                
                MotionState.cruise_velocity = optimal_vel
                delta_vel = optimal_vel
                
                PrintMessage("[MOTION] Optimal cruise velocity: ")
                PrintNumber(Divide(optimal_vel, 10000))
                PrintMessage("\n")
            } FalseBlock: {
                MotionState.cruise_velocity = MotionState.target_velocity
            }
        } FalseBlock: {
        }
        
        // Calculate acceleration phase timing
        t_jerk_to_max_accel = Divide(
            Multiply(MotionState.max_accel, MotionConfig.FIXED_POINT_SCALE),
            MotionState.max_jerk)
        
        vel_gain_concave = Divide(
            Multiply(MotionState.max_accel, MotionState.max_accel),
            Multiply(2, MotionState.max_jerk))
        
        Fork GreaterThan(Multiply(vel_gain_concave, 2), Abs(delta_vel)) TrueBlock: {
            // Pure S-curve (no linear acceleration phase)
            MotionState.t_linear_accel = 0
            
            temp_val = Divide(
                Multiply(Abs(delta_vel), MotionConfig.FIXED_POINT_SCALE),
                MotionState.max_jerk)
            
            Fork GreaterThan(temp_val, 0) TrueBlock: {
                MotionState.t_concave_accel = MotionPlanner.ISqrt(temp_val)
            } FalseBlock: {
                MotionState.t_concave_accel = 0
            }
            
            MotionState.t_convex_accel = MotionState.t_concave_accel
            
        } FalseBlock: {
            // Full S-curve with linear phase
            MotionState.t_concave_accel = t_jerk_to_max_accel
            MotionState.t_convex_accel = t_jerk_to_max_accel
            
            vel_remaining = Subtract(Abs(delta_vel), Multiply(vel_gain_concave, 2))
            
            MotionState.t_linear_accel = Divide(
                Multiply(vel_remaining, MotionConfig.FIXED_POINT_SCALE),
                MotionState.max_accel)
        }
        
        total_accel_time = Add(Add(MotionState.t_concave_accel,
                                   MotionState.t_linear_accel),
                               MotionState.t_convex_accel)
        
        dist_during_vel_change = Divide(
            Multiply(Abs(delta_vel), total_accel_time),
            Multiply(2, MotionConfig.FIXED_POINT_SCALE))
        
        dist_remaining = Subtract(Abs(delta_pos), Multiply(dist_during_vel_change, 2))
        
        Fork LessThan(delta_vel, 0) TrueBlock: {
            Fork LessThan(dist_remaining, 0) TrueBlock: {
                PrintMessage("[MOTION] WARNING: Cannot decelerate in distance\n")
                dist_remaining = 0
            } FalseBlock: {
            }
        } FalseBlock: {
        }
        
        avg_cruise_vel = Divide(Add(MotionState.current_velocity, MotionState.target_velocity), 2)
        
        Fork GreaterThan(Abs(avg_cruise_vel), 0) TrueBlock: {
            MotionState.t_cruise = Divide(
                Multiply(dist_remaining, MotionConfig.FIXED_POINT_SCALE),
                Abs(avg_cruise_vel))
            
            Fork LessThan(MotionState.t_cruise, 0) TrueBlock: {
                MotionState.t_cruise = 0
            } FalseBlock: {
            }
        } FalseBlock: {
            MotionState.t_cruise = 0
        }
        
        // Deceleration mirrors acceleration
        MotionState.t_concave_decel = MotionState.t_convex_accel
        MotionState.t_linear_decel = MotionState.t_linear_accel
        MotionState.t_convex_decel = MotionState.t_concave_accel
        
        MotionState.profile_computed = 1
        MotionState.phase_time = 0
        
        // Determine starting phase
        Fork GreaterThan(delta_vel, 0) TrueBlock: {
            MotionState.current_phase = MotionPhases.CONCAVE_ACCEL
            PrintMessage("[MOTION] Starting ACCELERATION\n")
        } FalseBlock: {
            Fork LessThan(delta_vel, 0) TrueBlock: {
                MotionState.current_phase = MotionPhases.CONCAVE_DECEL
                PrintMessage("[MOTION] Starting DECELERATION\n")
            } FalseBlock: {
                MotionState.current_phase = MotionPhases.CRUISE
                PrintMessage("[MOTION] Starting CRUISE\n")
            }
        }
        
        ReturnValue(1)
    }
}

// ============================================================================
// UPDATE POSITIONS (N-AXIS)
// ============================================================================

Function.MotionPlanner.UpdatePositions {
    Input: position_delta: Integer
    Body: {
        num_axes = MotionConfig.ACTIVE_AXES
        
        i = 0
        WhileLoop LessThan(i, num_axes) {
            offset = Multiply(i, 8)
            
            pos_addr = Add(MotionState.current_pos, offset)
            cur_pos = Dereference(pos_addr)
            direction = Dereference(Add(MotionState.direction_vector, offset))
            target = Dereference(Add(MotionState.target_pos, offset))
            
            // Calculate movement along this axis
            delta_axis = Divide(
                Multiply(position_delta, direction),
                MotionConfig.FIXED_POINT_SCALE)
            
            new_pos = Add(cur_pos, delta_axis)
            
            // Clamp to target (prevent overshoot)
            Fork GreaterThan(direction, 0) TrueBlock: {
                Fork GreaterThan(new_pos, target) TrueBlock: {
                    new_pos = target
                } FalseBlock: {
                }
            } FalseBlock: {
                Fork LessThan(direction, 0) TrueBlock: {
                    Fork LessThan(new_pos, target) TrueBlock: {
                        new_pos = target
                    } FalseBlock: {
                    }
                } FalseBlock: {
                }
            }
            
            StoreValue(pos_addr, new_pos)
            
            i = Add(i, 1)
        }
        
        ReturnValue(1)
    }
}

// ============================================================================
// UPDATE KINEMATICS
// ============================================================================

Function.MotionPlanner.UpdateKinematics {
    Body: {
        dt = MotionState.cycle_time
        t = MotionState.phase_time
        
        // Calculate scalar velocity changes based on current phase
        Fork EqualTo(MotionState.current_phase, MotionPhases.CONCAVE_ACCEL) TrueBlock: {
            MotionState.current_jerk = MotionState.max_jerk
            
            MotionState.current_accel = Divide(
                Multiply(MotionState.max_jerk, t),
                MotionConfig.FIXED_POINT_SCALE)
            
            vel_change = Divide(
                Multiply(MotionState.current_accel, dt),
                MotionConfig.FIXED_POINT_SCALE)
            
            MotionState.current_velocity = Add(MotionState.current_velocity, vel_change)
        } FalseBlock: {
        }
        
        Fork EqualTo(MotionState.current_phase, MotionPhases.LINEAR_ACCEL) TrueBlock: {
            MotionState.current_jerk = 0
            MotionState.current_accel = MotionState.max_accel
            
            vel_change = Divide(
                Multiply(MotionState.max_accel, dt),
                MotionConfig.FIXED_POINT_SCALE)
            
            MotionState.current_velocity = Add(MotionState.current_velocity, vel_change)
        } FalseBlock: {
        }
        
        Fork EqualTo(MotionState.current_phase, MotionPhases.CONVEX_ACCEL) TrueBlock: {
            MotionState.current_jerk = Subtract(0, MotionState.max_jerk)
            
            MotionState.current_accel = Subtract(MotionState.max_accel,
                Divide(
                    Multiply(MotionState.max_jerk, t),
                    MotionConfig.FIXED_POINT_SCALE))
            
            Fork GreaterThan(MotionState.current_accel, 0) TrueBlock: {
                vel_change = Divide(
                    Multiply(MotionState.current_accel, dt),
                    MotionConfig.FIXED_POINT_SCALE)
                MotionState.current_velocity = Add(MotionState.current_velocity, vel_change)
            } FalseBlock: {
            }
        } FalseBlock: {
        }
        
        Fork EqualTo(MotionState.current_phase, MotionPhases.CRUISE) TrueBlock: {
            MotionState.current_jerk = 0
            MotionState.current_accel = 0
        } FalseBlock: {
        }
        
        Fork EqualTo(MotionState.current_phase, MotionPhases.CONCAVE_DECEL) TrueBlock: {
            MotionState.current_jerk = Subtract(0, MotionState.max_jerk)
            
            MotionState.current_accel = Subtract(0, Divide(
                Multiply(MotionState.max_jerk, t),
                MotionConfig.FIXED_POINT_SCALE))
            
            vel_change = Divide(
                Multiply(MotionState.current_accel, dt),
                MotionConfig.FIXED_POINT_SCALE)
            
            MotionState.current_velocity = Add(MotionState.current_velocity, vel_change)
        } FalseBlock: {
        }
        
        Fork EqualTo(MotionState.current_phase, MotionPhases.LINEAR_DECEL) TrueBlock: {
            MotionState.current_jerk = 0
            MotionState.current_accel = Subtract(0, MotionState.max_accel)
            
            vel_change = Divide(
                Multiply(MotionState.current_accel, dt),
                MotionConfig.FIXED_POINT_SCALE)
            
            MotionState.current_velocity = Add(MotionState.current_velocity, vel_change)
            
            Fork LessThan(MotionState.current_velocity, 0) TrueBlock: {
                MotionState.current_velocity = 0
            } FalseBlock: {
            }
        } FalseBlock: {
        }
        
        Fork EqualTo(MotionState.current_phase, MotionPhases.CONVEX_DECEL) TrueBlock: {
            MotionState.current_jerk = MotionState.max_jerk
            
            decel_remaining = Subtract(MotionState.max_accel,
                Divide(
                    Multiply(MotionState.max_jerk, t),
                    MotionConfig.FIXED_POINT_SCALE))
            
            MotionState.current_accel = Subtract(0, decel_remaining)
            
            Fork GreaterThan(Abs(MotionState.current_accel), 100) TrueBlock: {
                vel_change = Divide(
                    Multiply(MotionState.current_accel, dt),
                    MotionConfig.FIXED_POINT_SCALE)
                MotionState.current_velocity = Add(MotionState.current_velocity, vel_change)
            } FalseBlock: {
            }
            
            Fork LessThan(MotionState.current_velocity, 0) TrueBlock: {
                MotionState.current_velocity = 0
            } FalseBlock: {
            }
        } FalseBlock: {
        }
        
        // Apply motion to all axes
        Fork GreaterThan(MotionState.current_velocity, 0) TrueBlock: {
            pos_change = Divide(
                Multiply(MotionState.current_velocity, dt),
                MotionConfig.FIXED_POINT_SCALE)
            
            result = MotionPlanner.UpdatePositions(pos_change)
        } FalseBlock: {
        }
        
        ReturnValue(1)
    }
}

// ============================================================================
// MAIN UPDATE FUNCTION
// ============================================================================

Function.MotionPlanner.Update {
    Output: Integer
    Body: {
        // Check initialization
        Fork EqualTo(MotionState.initialized, 0) TrueBlock: {
            PrintMessage("[MOTION] ERROR: Not initialized, call Init first\n")
            ReturnValue(MotionReturnCodes.ERROR)
        } FalseBlock: {
        }
        
        // Compute profile if needed
        Fork EqualTo(MotionState.profile_computed, 0) TrueBlock: {
            result = MotionPlanner.ComputeProfile()
        } FalseBlock: {
        }
        
        // Check if at target
        distance_remaining = MotionPlanner.ComputeDistance()
        
        Fork LessThan(distance_remaining, 100) TrueBlock: {
            num_axes = MotionConfig.ACTIVE_AXES
            i = 0
            WhileLoop LessThan(i, num_axes) {
                offset = Multiply(i, 8)
                tgt = Dereference(Add(MotionState.target_pos, offset))
                StoreValue(Add(MotionState.current_pos, offset), tgt)
                i = Add(i, 1)
            }
            
            MotionState.current_velocity = MotionState.target_velocity
            MotionState.current_accel = 0
            MotionState.current_jerk = 0
            MotionState.current_phase = MotionPhases.IDLE
            ReturnValue(MotionReturnCodes.FINISHED)
        } FalseBlock: {
        }
        
        // Advance phase time
        MotionState.phase_time = Add(MotionState.phase_time, MotionState.cycle_time)
        
        // Phase transitions
        Fork EqualTo(MotionState.current_phase, MotionPhases.CONCAVE_ACCEL) TrueBlock: {
            Fork GreaterEqual(MotionState.phase_time, MotionState.t_concave_accel) TrueBlock: {
                MotionState.current_phase = MotionPhases.LINEAR_ACCEL
                MotionState.phase_time = 0
            } FalseBlock: {
            }
        } FalseBlock: {
        }
        
        Fork EqualTo(MotionState.current_phase, MotionPhases.LINEAR_ACCEL) TrueBlock: {
            Fork GreaterEqual(MotionState.phase_time, MotionState.t_linear_accel) TrueBlock: {
                MotionState.current_phase = MotionPhases.CONVEX_ACCEL
                MotionState.phase_time = 0
            } FalseBlock: {
            }
        } FalseBlock: {
        }
        
        Fork EqualTo(MotionState.current_phase, MotionPhases.CONVEX_ACCEL) TrueBlock: {
            Fork GreaterEqual(MotionState.phase_time, MotionState.t_convex_accel) TrueBlock: {
                MotionState.current_phase = MotionPhases.CRUISE
                MotionState.phase_time = 0
            } FalseBlock: {
            }
        } FalseBlock: {
        }
        
        Fork EqualTo(MotionState.current_phase, MotionPhases.CRUISE) TrueBlock: {
            Fork GreaterEqual(MotionState.phase_time, MotionState.t_cruise) TrueBlock: {
                Fork GreaterThan(MotionState.current_velocity, MotionState.target_velocity) TrueBlock: {
                    MotionState.current_phase = MotionPhases.CONCAVE_DECEL
                } FalseBlock: {
                    MotionState.current_phase = MotionPhases.IDLE
                }
                MotionState.phase_time = 0
            } FalseBlock: {
            }
        } FalseBlock: {
        }
        
        Fork EqualTo(MotionState.current_phase, MotionPhases.CONCAVE_DECEL) TrueBlock: {
            Fork GreaterEqual(MotionState.phase_time, MotionState.t_concave_decel) TrueBlock: {
                MotionState.current_phase = MotionPhases.LINEAR_DECEL
                MotionState.phase_time = 0
            } FalseBlock: {
            }
        } FalseBlock: {
        }
        
        Fork EqualTo(MotionState.current_phase, MotionPhases.LINEAR_DECEL) TrueBlock: {
            Fork GreaterEqual(MotionState.phase_time, MotionState.t_linear_decel) TrueBlock: {
                MotionState.current_phase = MotionPhases.CONVEX_DECEL
                MotionState.phase_time = 0
            } FalseBlock: {
            }
        } FalseBlock: {
        }
        
        Fork EqualTo(MotionState.current_phase, MotionPhases.CONVEX_DECEL) TrueBlock: {
            Fork GreaterEqual(MotionState.phase_time, MotionState.t_convex_decel) TrueBlock: {
                MotionState.current_phase = MotionPhases.IDLE
                MotionState.phase_time = 0
            } FalseBlock: {
            }
        } FalseBlock: {
        }
        
        // Update kinematics
        result = MotionPlanner.UpdateKinematics()
        
        ReturnValue(MotionReturnCodes.BUSY)
    }
}

// ============================================================================
// GETTERS
// ============================================================================

Function.MotionPlanner.GetPosition {
    Input: axis_index: Integer
    Output: Integer
    Body: {
        Fork GreaterEqual(axis_index, MotionConfig.ACTIVE_AXES) TrueBlock: {
            ReturnValue(0)
        } FalseBlock: {
        }
        
        offset = Multiply(axis_index, 8)
        pos = Dereference(Add(MotionState.current_pos, offset))
        ReturnValue(pos)
    }
}

Function.MotionPlanner.GetAllPositions {
    Output: Address
    Body: {
        ReturnValue(MotionState.current_pos)
    }
}

Function.MotionPlanner.GetVelocity {
    Output: Integer
    Body: {
        ReturnValue(MotionState.current_velocity)
    }
}

Function.MotionPlanner.GetAcceleration {
    Output: Integer
    Body: {
        ReturnValue(MotionState.current_accel)
    }
}

Function.MotionPlanner.GetPhase {
    Output: Integer
    Body: {
        ReturnValue(MotionState.current_phase)
    }
}

Function.MotionPlanner.GetDistance {
    Output: Integer
    Body: {
        ReturnValue(MotionState.total_distance)
    }
}

// ============================================================================
// RESET
// ============================================================================

Function.MotionPlanner.Reset {
    Body: {
        PrintMessage("[MOTION] Reset called\n")
        
        // Check if initialized
        Fork EqualTo(MotionState.initialized, 0) TrueBlock: {
            PrintMessage("[MOTION] Not initialized yet, skipping reset\n")
            ReturnValue(1)
        } FalseBlock: {
        }
        
        PrintMessage("[MOTION] Resetting state\n")
        
        num_axes = MotionConfig.ACTIVE_AXES
        
        i = 0
        WhileLoop LessThan(i, num_axes) {
            offset = Multiply(i, 8)
            StoreValue(Add(MotionState.current_pos, offset), 0)
            StoreValue(Add(MotionState.target_pos, offset), 0)
            StoreValue(Add(MotionState.direction_vector, offset), 0)
            i = Add(i, 1)
        }
        
        MotionState.current_velocity = 0
        MotionState.current_accel = 0
        MotionState.current_jerk = 0
        MotionState.cruise_velocity = 0
        MotionState.current_phase = MotionPhases.IDLE
        MotionState.profile_computed = 0
        MotionState.phase_time = 0
        MotionState.total_distance = 0
        
        PrintMessage("[MOTION] State reset\n")
        ReturnValue(1)
    }
}

PrintMessage("[MOTION] Library loaded - N-axis coordinated motion ready\n")