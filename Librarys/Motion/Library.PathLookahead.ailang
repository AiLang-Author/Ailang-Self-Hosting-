// Library.PathLookahead.ailang
// N-Axis Multi-Segment Lookahead and Velocity Optimization
// Analyzes upcoming segments to compute safe junction velocities
//
// Copyright (c) 2025 Sean Collins, 2 Paws Machine and Engineering

LibraryImport.Motion.MotionPlanner

LibraryImport.Arena

PrintMessage("Path Lookahead Library v1.0 - N-Axis Multi-Segment Optimization\n")

// ============================================================================
// CONFIGURATION
// ============================================================================

FixedPool.LookaheadConfig {
    "MAX_SEGMENTS": Initialize=50
    "MIN_JUNCTION_VEL": Initialize=10000
    "MAX_JUNCTION_VEL": Initialize=1200000
}

// ============================================================================
// SEGMENT BUFFER STATE
// ============================================================================

FixedPool.LookaheadState {
    "segment_buffer": Initialize=0
    "num_axes": Initialize=0
    "segment_size": Initialize=0
    "head": Initialize=0
    "tail": Initialize=0
    "count": Initialize=0
    "initialized": Initialize=0
}

// Segment structure (dynamic size based on num_axes):
// [feed_rate: 8]
// [distance: 8]
// [entry_vel: 8]
// [cruise_vel: 8]
// [exit_vel: 8]
// [target_pos_0: 8]
// [target_pos_1: 8]
// ...
// [target_pos_N-1: 8]

// ============================================================================
// INITIALIZATION
// ============================================================================

Function.PathLookahead.Init {
    Input: num_axes: Integer
    Output: Integer
    Body: {
        Fork LessThan(num_axes, 1) TrueBlock: {
            PrintMessage("[LOOKAHEAD] ERROR: Invalid num_axes\n")
            ReturnValue(0)
        } FalseBlock: {
        }
        
        LookaheadState.num_axes = num_axes
        
        // Calculate segment size: 5 scalars + N positions
        fields_per_segment = Add(5, num_axes)
        LookaheadState.segment_size = Multiply(fields_per_segment, 8)
        
        // Allocate buffer
        total_size = Multiply(LookaheadState.segment_size, LookaheadConfig.MAX_SEGMENTS)
        LookaheadState.segment_buffer = Allocate(total_size)
        
        Fork EqualTo(LookaheadState.segment_buffer, 0) TrueBlock: {
            PrintMessage("[LOOKAHEAD] ERROR: Failed to allocate buffer\n")
            ReturnValue(0)
        } FalseBlock: {
        }
        
        LookaheadState.head = 0
        LookaheadState.tail = 0
        LookaheadState.count = 0
        LookaheadState.initialized = 1
        
        PrintMessage("[LOOKAHEAD] Initialized: ")
        PrintNumber(num_axes)
        PrintMessage(" axes, ")
        PrintNumber(LookaheadConfig.MAX_SEGMENTS)
        PrintMessage(" segment buffer, ")
        PrintNumber(LookaheadState.segment_size)
        PrintMessage(" bytes per segment\n")
        
        ReturnValue(1)
    }
}

// ============================================================================
// PUSH SEGMENT
// ============================================================================

Function.PathLookahead.PushSegment {
    Input: target_positions: Address
    Input: feed_rate: Integer
    Output: Integer
    Body: {
        Fork EqualTo(LookaheadState.initialized, 0) TrueBlock: {
            PrintMessage("[LOOKAHEAD] ERROR: Not initialized\n")
            ReturnValue(0)
        } FalseBlock: {
        }
        
        Fork GreaterEqual(LookaheadState.count, LookaheadConfig.MAX_SEGMENTS) TrueBlock: {
            PrintMessage("[LOOKAHEAD] ERROR: Buffer full\n")
            ReturnValue(0)
        } FalseBlock: {
        }
        
        // Calculate segment address
        tail = LookaheadState.tail
        offset = Multiply(tail, LookaheadState.segment_size)
        seg_addr = Add(LookaheadState.segment_buffer, offset)
        
        // Store scalar fields
        StoreValue(seg_addr, feed_rate)
        StoreValue(Add(seg_addr, 8), 0)
        StoreValue(Add(seg_addr, 16), 0)
        StoreValue(Add(seg_addr, 24), 0)
        StoreValue(Add(seg_addr, 32), 0)
        
        // Store target positions
        num_axes = LookaheadState.num_axes
        i = 0
        WhileLoop LessThan(i, num_axes) {
            src_offset = Multiply(i, 8)
            dst_offset = Add(40, src_offset)
            
            pos = Dereference(Add(target_positions, src_offset))
            StoreValue(Add(seg_addr, dst_offset), pos)
            
            i = Add(i, 1)
        }
        
        // Update tail
        LookaheadState.tail = Modulo(Add(tail, 1), LookaheadConfig.MAX_SEGMENTS)
        LookaheadState.count = Add(LookaheadState.count, 1)
        
        ReturnValue(1)
    }
}

// ============================================================================
// GET SEGMENT
// ============================================================================

Function.PathLookahead.GetSegment {
    Input: index: Integer
    Output: Address
    Body: {
        Fork GreaterEqual(index, LookaheadState.count) TrueBlock: {
            ReturnValue(0)
        } FalseBlock: {
        }
        
        actual_index = Modulo(Add(LookaheadState.head, index), LookaheadConfig.MAX_SEGMENTS)
        offset = Multiply(actual_index, LookaheadState.segment_size)
        seg_addr = Add(LookaheadState.segment_buffer, offset)
        
        ReturnValue(seg_addr)
    }
}

// ============================================================================
// COMPUTE SEGMENT DISTANCE
// ============================================================================

Function.PathLookahead.ComputeDistance {
    Input: seg_addr: Address
    Input: prev_positions: Address
    Output: Integer
    Body: {
        num_axes = LookaheadState.num_axes
        sum_sq = 0
        
        i = 0
        WhileLoop LessThan(i, num_axes) {
            offset = Multiply(i, 8)
            
            // Get current and previous position
            cur_pos = Dereference(Add(seg_addr, Add(40, offset)))
            prev_pos = Dereference(Add(prev_positions, offset))
            
            // Calculate delta
            delta = Subtract(cur_pos, prev_pos)
            delta_sq = Multiply(delta, delta)
            sum_sq = Add(sum_sq, delta_sq)
            
            i = Add(i, 1)
        }
        
        distance = MotionPlanner.ISqrt(sum_sq)
        
        // Store distance in segment
        StoreValue(Add(seg_addr, 8), distance)
        
        ReturnValue(distance)
    }
}

// ============================================================================
// COMPUTE JUNCTION VELOCITY
// ============================================================================

Function.PathLookahead.ComputeJunctionVelocity {
    Input: seg1_addr: Address
    Input: seg2_addr: Address
    Input: prev_positions: Address
    Output: Integer
    Body: {
        Fork EqualTo(seg2_addr, 0) TrueBlock: {
            ReturnValue(0)
        } FalseBlock: {
        }
        
        num_axes = LookaheadState.num_axes
        
        // Calculate direction vectors for both segments
        v1_mag_sq = 0
        v2_mag_sq = 0
        dot_product = 0
        
        i = 0
        WhileLoop LessThan(i, num_axes) {
            offset = Multiply(i, 8)
            
            prev = Dereference(Add(prev_positions, offset))
            seg1_pos = Dereference(Add(seg1_addr, Add(40, offset)))
            seg2_pos = Dereference(Add(seg2_addr, Add(40, offset)))
            
            // Vector 1: prev -> seg1
            v1 = Subtract(seg1_pos, prev)
            v1_sq = Divide(Multiply(v1, v1), MotionConfig.FIXED_POINT_SCALE)
            v1_mag_sq = Add(v1_mag_sq, v1_sq)
            
            // Vector 2: seg1 -> seg2
            v2 = Subtract(seg2_pos, seg1_pos)
            v2_sq = Divide(Multiply(v2, v2), MotionConfig.FIXED_POINT_SCALE)
            v2_mag_sq = Add(v2_mag_sq, v2_sq)
            
            // Dot product
            dot = Divide(Multiply(v1, v2), MotionConfig.FIXED_POINT_SCALE)
            dot_product = Add(dot_product, dot)
            
            i = Add(i, 1)
        }
        
        // Check for zero magnitude
        Fork EqualTo(v1_mag_sq, 0) TrueBlock: {
            ReturnValue(LookaheadConfig.MIN_JUNCTION_VEL)
        } FalseBlock: {
        }
        
        Fork EqualTo(v2_mag_sq, 0) TrueBlock: {
            ReturnValue(LookaheadConfig.MIN_JUNCTION_VEL)
        } FalseBlock: {
        }
        
        // Calculate magnitudes
        v1_mag = MotionPlanner.ISqrt(v1_mag_sq)
        v2_mag = MotionPlanner.ISqrt(v2_mag_sq)
        
        // Calculate cosine of angle
        cos_angle = Divide(
            Multiply(dot_product, MotionConfig.FIXED_POINT_SCALE),
            Multiply(v1_mag, v2_mag))
        
        // Clamp to [-1, 1]
        Fork LessThan(cos_angle, 0) TrueBlock: {
            cos_angle = 0
        } FalseBlock: {
        }
        
        Fork GreaterThan(cos_angle, MotionConfig.FIXED_POINT_SCALE) TrueBlock: {
            cos_angle = MotionConfig.FIXED_POINT_SCALE
        } FalseBlock: {
        }
        
        // Angle factor: (cos + 1) / 2
        angle_factor = Divide(
            Add(cos_angle, MotionConfig.FIXED_POINT_SCALE),
            2)
        
        // Get feed rates
        feed1 = Dereference(seg1_addr)
        feed2 = Dereference(seg2_addr)
        min_feed = Min(feed1, feed2)
        
        // Calculate junction velocity
        junction_vel = Divide(
            Multiply(min_feed, angle_factor),
            MotionConfig.FIXED_POINT_SCALE)
        
        // Clamp to limits
        junction_vel = Max(junction_vel, LookaheadConfig.MIN_JUNCTION_VEL)
        junction_vel = Min(junction_vel, LookaheadConfig.MAX_JUNCTION_VEL)
        
        ReturnValue(junction_vel)
    }
}

// ============================================================================
// FORWARD PASS
// ============================================================================

Function.PathLookahead.ForwardPass {
    Body: {
        Fork EqualTo(LookaheadState.count, 0) TrueBlock: {
            ReturnValue(0)
        } FalseBlock: {
        }
        
        num_axes = LookaheadState.num_axes
        
        // Allocate temp buffer for previous positions
        prev_positions = Allocate(Multiply(num_axes, 8))
        
        // Initialize with current motion planner positions
        i = 0
        WhileLoop LessThan(i, num_axes) {
            offset = Multiply(i, 8)
            pos = MotionPlanner.GetPosition(i)
            StoreValue(Add(prev_positions, offset), pos)
            i = Add(i, 1)
        }
        
        // Process all segments
        seg_idx = 0
        WhileLoop LessThan(seg_idx, LookaheadState.count) {
            seg_addr = PathLookahead.GetSegment(seg_idx)
            
            Fork EqualTo(seg_addr, 0) TrueBlock: {
                BreakLoop
            } FalseBlock: {
            }
            
            // Compute distance
            distance = PathLookahead.ComputeDistance(seg_addr, prev_positions)
            
            // Compute max cruise velocity
            feed_rate = Dereference(seg_addr)
            max_vel_for_dist = MotionPlanner.ISqrt(Multiply(distance, MotionState.max_accel))
            cruise_vel = Min(feed_rate, max_vel_for_dist)
            cruise_vel = Min(cruise_vel, MotionState.max_velocity)
            
            StoreValue(Add(seg_addr, 24), cruise_vel)
            
            // Compute junction velocity
            next_seg = PathLookahead.GetSegment(Add(seg_idx, 1))
            
            Fork EqualTo(next_seg, 0) TrueBlock: {
                exit_vel = 0
            } FalseBlock: {
                exit_vel = PathLookahead.ComputeJunctionVelocity(seg_addr, next_seg, prev_positions)
            }
            
            StoreValue(Add(seg_addr, 32), exit_vel)
            
            // Update previous positions
            j = 0
            WhileLoop LessThan(j, num_axes) {
                offset = Multiply(j, 8)
                pos = Dereference(Add(seg_addr, Add(40, offset)))
                StoreValue(Add(prev_positions, offset), pos)
                j = Add(j, 1)
            }
            
            seg_idx = Add(seg_idx, 1)
        }
        
        Deallocate(prev_positions, Multiply(num_axes, 8))
        
        PrintMessage("[LOOKAHEAD] Forward pass: ")
        PrintNumber(seg_idx)
        PrintMessage(" segments\n")
        
        ReturnValue(1)
    }
}

// ============================================================================
// BACKWARD PASS
// ============================================================================

Function.PathLookahead.BackwardPass {
    Body: {
        Fork EqualTo(LookaheadState.count, 0) TrueBlock: {
            ReturnValue(0)
        } FalseBlock: {
        }
        
        seg_idx = Subtract(LookaheadState.count, 1)
        
        WhileLoop GreaterEqual(seg_idx, 0) {
            seg_addr = PathLookahead.GetSegment(seg_idx)
            
            Fork EqualTo(seg_addr, 0) TrueBlock: {
                BreakLoop
            } FalseBlock: {
            }
            
            cruise_vel = Dereference(Add(seg_addr, 24))
            exit_vel = Dereference(Add(seg_addr, 32))
            distance = Dereference(Add(seg_addr, 8))
            
            Fork GreaterThan(distance, 0) TrueBlock: {
                // Calculate max entry velocity
                exit_sq = Multiply(exit_vel, exit_vel)
                accel_term = Multiply(Multiply(2, MotionState.max_accel), distance)
                max_entry_sq = Add(exit_sq, accel_term)
                max_entry_vel = MotionPlanner.ISqrt(max_entry_sq)
                
                entry_vel = Min(cruise_vel, max_entry_vel)
                StoreValue(Add(seg_addr, 16), entry_vel)
                
                // Propagate constraint backward
                Fork GreaterThan(seg_idx, 0) TrueBlock: {
                    prev_seg = PathLookahead.GetSegment(Subtract(seg_idx, 1))
                    Fork NotEqual(prev_seg, 0) TrueBlock: {
                        prev_exit = Dereference(Add(prev_seg, 32))
                        new_exit = Min(prev_exit, entry_vel)
                        StoreValue(Add(prev_seg, 32), new_exit)
                    } FalseBlock: {
                    }
                } FalseBlock: {
                }
            } FalseBlock: {
                StoreValue(Add(seg_addr, 16), exit_vel)
            }
            
            Fork EqualTo(seg_idx, 0) TrueBlock: {
                BreakLoop
            } FalseBlock: {
            }
            
            seg_idx = Subtract(seg_idx, 1)
        }
        
        PrintMessage("[LOOKAHEAD] Backward pass complete\n")
        
        ReturnValue(1)
    }
}

// ============================================================================
// PLAN
// ============================================================================

Function.PathLookahead.Plan {
    Output: Integer
    Body: {
        Fork LessThan(LookaheadState.count, 1) TrueBlock: {
            ReturnValue(0)
        } FalseBlock: {
        }
        
        result = PathLookahead.ForwardPass()
        result = PathLookahead.BackwardPass()
        
        PrintMessage("[LOOKAHEAD] Planning complete for ")
        PrintNumber(LookaheadState.count)
        PrintMessage(" segments\n")
        
        ReturnValue(1)
    }
}

// ============================================================================
// POP SEGMENT
// ============================================================================

Function.PathLookahead.PopSegment {
    Output: Address
    Body: {
        Fork EqualTo(LookaheadState.count, 0) TrueBlock: {
            ReturnValue(0)
        } FalseBlock: {
        }
        
        head = LookaheadState.head
        offset = Multiply(head, LookaheadState.segment_size)
        seg_addr = Add(LookaheadState.segment_buffer, offset)
        
        LookaheadState.head = Modulo(Add(head, 1), LookaheadConfig.MAX_SEGMENTS)
        LookaheadState.count = Subtract(LookaheadState.count, 1)
        
        ReturnValue(seg_addr)
    }
}

// ============================================================================
// UTILITY FUNCTIONS
// ============================================================================

Function.PathLookahead.GetCount {
    Output: Integer
    Body: {
        ReturnValue(LookaheadState.count)
    }
}

Function.PathLookahead.Clear {
    Body: {
        LookaheadState.head = 0
        LookaheadState.tail = 0
        LookaheadState.count = 0
        
        PrintMessage("[LOOKAHEAD] Buffer cleared\n")
        ReturnValue(1)
    }
}

// ============================================================================
// EXTRACT SEGMENT DATA
// ============================================================================

Function.PathLookahead.GetSegmentTargets {
    Input: seg_addr: Address
    Output: Address
    Body: {
        // Returns address of target positions array (starts at offset 40)
        ReturnValue(Add(seg_addr, 40))
    }
}

Function.PathLookahead.GetSegmentEntryVel {
    Input: seg_addr: Address
    Output: Integer
    Body: {
        ReturnValue(Dereference(Add(seg_addr, 16)))
    }
}

Function.PathLookahead.GetSegmentCruiseVel {
    Input: seg_addr: Address
    Output: Integer
    Body: {
        ReturnValue(Dereference(Add(seg_addr, 24)))
    }
}

Function.PathLookahead.GetSegmentExitVel {
    Input: seg_addr: Address
    Output: Integer
    Body: {
        ReturnValue(Dereference(Add(seg_addr, 32)))
    }
}

PrintMessage("[LOOKAHEAD] Library loaded - N-axis path optimization ready\n")