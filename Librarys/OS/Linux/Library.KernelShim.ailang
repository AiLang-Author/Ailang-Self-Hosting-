//
// Library.KernelShim.ailang
// AiLang-side declarations for the C kernel shim ABI.
// Location: Librarys/OS/Linux/Library.KernelShim.ailang
// Import:   LibraryImport.OS.Linux.KernelShim
//
// PURPOSE:
//   Mirrors kernel_module/shim/ail_shim.h so AiLang kernel payloads can
//   reference shim functions by name. Each declaration becomes an
//   UND GLOBAL FUNC entry in the payload object's symtab, resolved at
//   insmod time against ail_shim.o.
//
// DEPENDS ON:
//   ExternalKernelFunction parser/lexer support (PLAN.md Step 3). Until
//   that lands, this file is documentation only. The forms below use the
//   intended final syntax so it becomes parseable the moment Step 3 is done.
//
// SHIM ABI (kept in sync with kernel_module/shim/ail_shim.h):
//
//   // Core logging and memory
//   ExternalKernelFunction.ail_printk     { Input: s: Address;            Output: Integer }
//   ExternalKernelFunction.ail_kmalloc    { Input: size: Integer;         Output: Address }
//   ExternalKernelFunction.ail_kfree      { Input: obj: Address;          Output: Void    }
//   ExternalKernelFunction.ail_memcpy     { Input: dest: Address, src: Address, n: Integer; Output: Address }
//   ExternalKernelFunction.ail_memset     { Input: s: Address, c: Integer, n: Integer;      Output: Address }
//   ExternalKernelFunction.ail_memcmp     { Input: a: Address, b: Address, n: Integer;      Output: Integer }
//   ExternalKernelFunction.ail_ktime_get_ns { Output: Integer }
//
//   // User/kernel boundary
//   ExternalKernelFunction.ail_copy_to_user   { Input: to: Address, from: Address, n: Integer; Output: Integer }
//   ExternalKernelFunction.ail_copy_from_user { Input: to: Address, from: Address, n: Integer; Output: Integer }
//
//   // Process context
//   ExternalKernelFunction.ail_get_current_pid  { Output: Integer }
//   ExternalKernelFunction.ail_get_current_tgid { Output: Integer }
//
//   // Delays
//   ExternalKernelFunction.ail_msleep { Input: msecs: Integer;   Output: Void }
//   ExternalKernelFunction.ail_udelay { Input: usecs: Integer;   Output: Void }
//
//   // Synchronization (mutex handle passed by Address)
//   ExternalKernelFunction.ail_mutex_init   { Input: lock: Address; Output: Void }
//   ExternalKernelFunction.ail_mutex_lock   { Input: lock: Address; Output: Void }
//   ExternalKernelFunction.ail_mutex_unlock { Input: lock: Address; Output: Void }
//
//   // Atomics
//   ExternalKernelFunction.ail_atomic_read        { Input: v: Address;               Output: Integer }
//   ExternalKernelFunction.ail_atomic_set         { Input: v: Address, i: Integer;   Output: Void    }
//   ExternalKernelFunction.ail_atomic_add         { Input: i: Integer, v: Address;   Output: Void    }
//   ExternalKernelFunction.ail_atomic_sub         { Input: i: Integer, v: Address;   Output: Void    }
//   ExternalKernelFunction.ail_atomic_inc         { Input: v: Address;               Output: Void    }
//   ExternalKernelFunction.ail_atomic_dec_and_test{ Input: v: Address;               Output: Integer }
//
//   // Character devices
//   ExternalKernelFunction.ail_alloc_chrdev_region     { Input: dev: Address, baseminor: Integer, count: Integer, name: Address; Output: Integer }
//   ExternalKernelFunction.ail_unregister_chrdev_region{ Input: from: Integer, count: Integer; Output: Void }
//   ExternalKernelFunction.ail_cdev_init               { Input: cdev: Address, fops: Address; Output: Void }
//   ExternalKernelFunction.ail_cdev_add                { Input: p: Address, dev: Integer, count: Integer; Output: Integer }
//   ExternalKernelFunction.ail_cdev_del                { Input: p: Address; Output: Void }
//
//   // dev_t macros
//   ExternalKernelFunction.ail_MAJOR { Input: dev: Integer; Output: Integer }
//   ExternalKernelFunction.ail_MINOR { Input: dev: Integer; Output: Integer }
//   ExternalKernelFunction.ail_MKDEV { Input: major: Integer, minor: Integer; Output: Integer }
//
//   // Hardware I/O
//   ExternalKernelFunction.ail_ioremap { Input: offset: Integer, size: Integer; Output: Address }
//   ExternalKernelFunction.ail_iounmap { Input: addr: Address;                  Output: Void    }
//   ExternalKernelFunction.ail_readb   { Input: addr: Address; Output: Integer }
//   ExternalKernelFunction.ail_readw   { Input: addr: Address; Output: Integer }
//   ExternalKernelFunction.ail_readl   { Input: addr: Address; Output: Integer }
//   ExternalKernelFunction.ail_writeb  { Input: b: Integer, addr: Address; Output: Void }
//   ExternalKernelFunction.ail_writew  { Input: b: Integer, addr: Address; Output: Void }
//   ExternalKernelFunction.ail_writel  { Input: b: Integer, addr: Address; Output: Void }
//
// STATUS: Documentation-only until PLAN.md Step 3 lands.
