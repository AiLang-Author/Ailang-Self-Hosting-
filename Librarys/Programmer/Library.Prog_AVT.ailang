// Programmer.AVT — AVT 852 (USB FTDI) transport.
// Packet: high nibble type, low nibble length. Type 9 = init/version.
// Reset F1 A5 → 91 27 (852) / 91 12 (842). Firmware 92 04 <n>.
// VPW E1 33 → 91 07. Port and bus come from Prog_Comm, not hardcoded GM.
//
// Copyright (c) 2026 Sean Collins, 2 Paws Machine and Engineering. All rights reserved.
// Licensed under the Sean Collins Software License (SCSL v1.0).

LibraryImport.Arena
LibraryImport.Ecu.ECU_Sys
LibraryImport.Ecu.ECU_Err
LibraryImport.Programmer.Prog_Tty
LibraryImport.Programmer.Prog_Comm

FixedPool.Prog_AVT_State {
    "model":    Initialize=0, CanChange=True
    "fw":       Initialize=0, CanChange=True
    "ok":       Initialize=0, CanChange=True
    "hdr":      Initialize=0, CanChange=True
    "plen":     Initialize=0, CanChange=True
    "pay":      Initialize=0, CanChange=True
    "cmd":      Initialize=0, CanChange=True
    "vpw":      Initialize=0, CanChange=True
    "wait":     Initialize=5, CanChange=True
    "osid":     Initialize=0, CanChange=True
    "hw":       Initialize=0, CanChange=True
    "cal":      Initialize=0, CanChange=True
    "pcm":      Initialize=0, CanChange=True
    "proto":    Initialize=0, CanChange=True
}

Function.Prog_AVT.Init {
    Output: Integer
    Body: {
        IfCondition EqualTo(Prog_AVT_State.pay, 0) ThenBlock: {
            Prog_AVT_State.pay = Allocate(256)
            Prog_AVT_State.cmd = Allocate(32)
            Prog_AVT_State.vpw = Allocate(16)
        }
        Prog_AVT_State.model = 0
        Prog_AVT_State.fw = 0
        Prog_AVT_State.ok = 0
        Prog_AVT_State.hdr = 0
        Prog_AVT_State.plen = 0
        Prog_AVT_State.wait = 5
        Prog_AVT_State.osid = 0
        Prog_AVT_State.hw = 0
        Prog_AVT_State.cal = 0
        Prog_AVT_State.pcm = 0
        Prog_AVT_State.proto = 0
        ReturnValue(0)
    }
}

Function.Prog_AVT.WaitByte {
    Output: Integer
    Body: {
        k = 0
        lim = Prog_AVT_State.wait
        IfCondition LessThan(lim, 1) ThenBlock: { lim = 5 }
        WhileLoop LessThan(k, lim) {
            b = Prog_Tty.ReadByte()
            IfCondition GreaterEqual(b, 0) ThenBlock: { ReturnValue(b) }
            k = Add(k, 1)
        }
        ReturnValue(-1)
    }
}

Function.Prog_AVT.Recv {
    Output: Integer
    Body: {
        h = Prog_AVT.WaitByte()
        IfCondition LessThan(h, 0) ThenBlock: { ReturnValue(-1) }
        Prog_AVT_State.hdr = h
        status = 1
        length = 0
        IfCondition EqualTo(h, 17) ThenBlock: {
            length = Prog_AVT.WaitByte()
            IfCondition LessThan(length, 0) ThenBlock: { ReturnValue(-1) }
        }
        IfCondition EqualTo(h, 18) ThenBlock: {
            hi = Prog_AVT.WaitByte()
            lo = Prog_AVT.WaitByte()
            IfCondition LessThan(hi, 0) ThenBlock: { ReturnValue(-1) }
            IfCondition LessThan(lo, 0) ThenBlock: { ReturnValue(-1) }
            length = Add(Multiply(hi, 256), lo)
        }
        IfCondition NotEqual(h, 17) ThenBlock: {
            IfCondition NotEqual(h, 18) ThenBlock: {
                typ = Divide(h, 16)
                length = Modulo(h, 16)
                IfCondition EqualTo(typ, 0) ThenBlock: { status = 1 }
                IfCondition EqualTo(typ, 15) ThenBlock: { status = 1 }
                IfCondition EqualTo(typ, 2) ThenBlock: { status = 0 }
                IfCondition EqualTo(typ, 6) ThenBlock: { status = 0 }
                IfCondition EqualTo(typ, 8) ThenBlock: {
                    status = 0
                    IfCondition GreaterThan(length, 0) ThenBlock: { length = Subtract(length, 1) }
                }
                IfCondition EqualTo(typ, 9) ThenBlock: { status = 0 }
                IfCondition EqualTo(typ, 12) ThenBlock: { status = 0 }
            }
        }
        IfCondition NotEqual(Prog_AVT_State.proto, 0) ThenBlock: { status = 0 }
        IfCondition EqualTo(status, 1) ThenBlock: {
            IfCondition GreaterThan(length, 0) ThenBlock: { length = Subtract(length, 1) }
            st = Prog_AVT.WaitByte()
            IfCondition LessThan(st, 0) ThenBlock: { ReturnValue(-1) }
        }
        IfCondition GreaterThan(length, 255) ThenBlock: { ReturnValue(-2) }
        i = 0
        WhileLoop LessThan(i, length) {
            b = Prog_AVT.WaitByte()
            IfCondition LessThan(b, 0) ThenBlock: { ReturnValue(-1) }
            SetByte(Prog_AVT_State.pay, i, b)
            i = Add(i, 1)
        }
        Prog_AVT_State.plen = length
        ReturnValue(0)
    }
}

Function.Prog_AVT.SendRaw {
    Input: n: Integer
    Output: Integer
    Body: {
        ReturnValue(Prog_Tty.Write(Prog_AVT_State.cmd, n))
    }
}

Function.Prog_AVT.OpenPath {
    Input: path: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(path, 0) ThenBlock: { ReturnValue(-1) }
        fd = Prog_Tty.Open(path)
        IfCondition LessThan(fd, 0) ThenBlock: { ReturnValue(-1) }
        Prog_Tty.Drain()
        IfCondition NotEqual(Prog_AVT.Reset(), 0) ThenBlock: {
            Prog_Tty.Close()
            ReturnValue(-1)
        }
        ReturnValue(0)
    }
}

Function.Prog_AVT.Open {
    Output: Integer
    Body: {
        Prog_AVT.Init()
        IfCondition EqualTo(Prog_Comm.IsAvt(), 0) ThenBlock: {
            ReturnValue(ECU_Err.Raise(-10, "avt: transport not avt852"))
        }
        p = Prog_Comm.Port()
        IfCondition NotEqual(p, 0) ThenBlock: {
            IfCondition EqualTo(Prog_AVT.OpenPath(p), 0) ThenBlock: { ReturnValue(0) }
        }
        IfCondition EqualTo(Prog_AVT.OpenPath("/dev/ttyUSB3"), 0) ThenBlock: {
            Prog_Comm.SetPort("/dev/ttyUSB3")
            ReturnValue(0)
        }
        IfCondition EqualTo(Prog_AVT.OpenPath("/dev/ttyUSB0"), 0) ThenBlock: {
            Prog_Comm.SetPort("/dev/ttyUSB0")
            ReturnValue(0)
        }
        IfCondition EqualTo(Prog_AVT.OpenPath("/dev/ttyUSB1"), 0) ThenBlock: {
            Prog_Comm.SetPort("/dev/ttyUSB1")
            ReturnValue(0)
        }
        IfCondition EqualTo(Prog_AVT.OpenPath("/dev/ttyUSB2"), 0) ThenBlock: {
            Prog_Comm.SetPort("/dev/ttyUSB2")
            ReturnValue(0)
        }
        ReturnValue(ECU_Err.Raise(-12, "avt: open tty"))
    }
}

Function.Prog_AVT.Reset {
    Output: Integer
    Body: {
        SetByte(Prog_AVT_State.cmd, 0, 241)
        SetByte(Prog_AVT_State.cmd, 1, 165)
        Prog_AVT.SendRaw(2)
        Prog_Tty.SleepMs(50)
        saw = 0
        k = 0
        WhileLoop LessThan(k, 6) {
            IfCondition NotEqual(Prog_AVT.Recv(), 0) ThenBlock: { k = 6 }
            IfCondition EqualTo(k, 6) ThenBlock: { k = 6 }
            IfCondition LessThan(k, 6) ThenBlock: {
                IfCondition EqualTo(Divide(Prog_AVT_State.hdr, 16), 9) ThenBlock: {
                    IfCondition GreaterEqual(Prog_AVT_State.plen, 1) ThenBlock: {
                        b0 = GetByte(Prog_AVT_State.pay, 0)
                        IfCondition EqualTo(b0, 39) ThenBlock: {
                            Prog_AVT_State.model = 852
                            saw = 1
                        }
                        IfCondition EqualTo(b0, 18) ThenBlock: {
                            Prog_AVT_State.model = 842
                            saw = 1
                        }
                        IfCondition EqualTo(b0, 8) ThenBlock: {
                            Prog_AVT_State.model = 838
                            saw = 1
                        }
                        IfCondition EqualTo(b0, 4) ThenBlock: {
                            IfCondition GreaterEqual(Prog_AVT_State.plen, 2) ThenBlock: {
                                Prog_AVT_State.fw = GetByte(Prog_AVT_State.pay, 1)
                            }
                        }
                    }
                }
                IfCondition EqualTo(saw, 1) ThenBlock: {
                    IfCondition NotEqual(Prog_AVT_State.fw, 0) ThenBlock: { k = 5 }
                }
                k = Add(k, 1)
            }
        }
        IfCondition EqualTo(saw, 0) ThenBlock: {
            ReturnValue(ECU_Err.Raise(-13, "avt: no reset"))
        }
        Prog_AVT_State.ok = 1
        ReturnValue(0)
    }
}

Function.Prog_AVT.AskFw {
    Output: Integer
    Body: {
        SetByte(Prog_AVT_State.cmd, 0, 176)
        Prog_AVT.SendRaw(1)
        IfCondition NotEqual(Prog_AVT.Recv(), 0) ThenBlock: { ReturnValue(-1) }
        IfCondition EqualTo(GetByte(Prog_AVT_State.pay, 0), 4) ThenBlock: {
            IfCondition GreaterEqual(Prog_AVT_State.plen, 2) ThenBlock: {
                Prog_AVT_State.fw = GetByte(Prog_AVT_State.pay, 1)
            }
        }
        ReturnValue(0)
    }
}

Function.Prog_AVT.SetVpw {
    Output: Integer
    Body: {
        SetByte(Prog_AVT_State.cmd, 0, 225)
        SetByte(Prog_AVT_State.cmd, 1, 51)
        Prog_AVT.SendRaw(2)
        IfCondition NotEqual(Prog_AVT.Recv(), 0) ThenBlock: {
            ReturnValue(ECU_Err.Raise(-14, "avt: vpw"))
        }
        IfCondition NotEqual(GetByte(Prog_AVT_State.pay, 0), 7) ThenBlock: {
            ReturnValue(ECU_Err.Raise(-14, "avt: vpw"))
        }
        ReturnValue(0)
    }
}

Function.Prog_AVT.Model {
    Output: Integer
    Body: {
        ReturnValue(Prog_AVT_State.model)
    }
}

Function.Prog_AVT.Firmware {
    Output: Integer
    Body: {
        ReturnValue(Prog_AVT_State.fw)
    }
}

Function.Prog_AVT.Ok {
    Output: Integer
    Body: {
        ReturnValue(Prog_AVT_State.ok)
    }
}

Function.Prog_AVT.SendVpw {
    Input: buf: Address
    Input: n: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(n, 1) ThenBlock: { ReturnValue(-1) }
        IfCondition LessEqual(n, 15) ThenBlock: {
            Prog_Tty.WriteByte(n)
            ReturnValue(Prog_Tty.Write(buf, n))
        }
        IfCondition LessEqual(n, 255) ThenBlock: {
            Prog_Tty.WriteByte(17)
            Prog_Tty.WriteByte(n)
            ReturnValue(Prog_Tty.Write(buf, n))
        }
        ReturnValue(-1)
    }
}

Function.Prog_AVT.ExpectPay {
    Input: a: Integer
    Input: b: Integer
    Output: Integer
    Body: {
        IfCondition NotEqual(Prog_AVT.Recv(), 0) ThenBlock: { ReturnValue(-1) }
        IfCondition LessThan(Prog_AVT_State.plen, 2) ThenBlock: { ReturnValue(-1) }
        IfCondition NotEqual(GetByte(Prog_AVT_State.pay, 0), a) ThenBlock: { ReturnValue(-1) }
        IfCondition NotEqual(GetByte(Prog_AVT_State.pay, 1), b) ThenBlock: { ReturnValue(-1) }
        ReturnValue(0)
    }
}

Function.Prog_AVT.Setup {
    Output: Integer
    Body: {
        SetByte(Prog_AVT_State.cmd, 0, 82)
        SetByte(Prog_AVT_State.cmd, 1, 64)
        SetByte(Prog_AVT_State.cmd, 2, 0)
        Prog_AVT.SendRaw(3)
        IfCondition NotEqual(Prog_AVT.ExpectPay(64, 0), 0) ThenBlock: {
            ReturnValue(ECU_Err.Raise(-15, "avt: acks"))
        }
        tid = Prog_Comm.ToolId()
        SetByte(Prog_AVT_State.cmd, 0, 82)
        SetByte(Prog_AVT_State.cmd, 1, 91)
        SetByte(Prog_AVT_State.cmd, 2, BitwiseAnd(tid, 255))
        Prog_AVT.SendRaw(3)
        IfCondition NotEqual(Prog_AVT.ExpectPay(91, tid), 0) ThenBlock: {
            ReturnValue(ECU_Err.Raise(-16, "avt: filter"))
        }
        ReturnValue(0)
    }
}

Function.Prog_AVT.ParseU32 {
    Output: Integer
    Body: {
        n = Prog_AVT_State.plen
        IfCondition LessThan(n, 8) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(GetByte(Prog_AVT_State.pay, 3), 124) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(n, 8) ThenBlock: {
            o = GetByte(Prog_AVT_State.pay, 5)
            o = Add(Multiply(o, 256), GetByte(Prog_AVT_State.pay, 6))
            o = Add(Multiply(o, 256), GetByte(Prog_AVT_State.pay, 7))
            ReturnValue(o)
        }
        o = GetByte(Prog_AVT_State.pay, 5)
        o = Add(Multiply(o, 256), GetByte(Prog_AVT_State.pay, 6))
        o = Add(Multiply(o, 256), GetByte(Prog_AVT_State.pay, 7))
        o = Add(Multiply(o, 256), GetByte(Prog_AVT_State.pay, 8))
        ReturnValue(o)
    }
}

Function.Prog_AVT.QueryBlock {
    Input: block: Integer
    Output: Integer
    Body: {
        v = Prog_AVT_State.vpw
        SetByte(v, 0, 108)
        SetByte(v, 1, BitwiseAnd(Prog_Comm.PcmId(), 255))
        SetByte(v, 2, BitwiseAnd(Prog_Comm.ToolId(), 255))
        SetByte(v, 3, 60)
        SetByte(v, 4, BitwiseAnd(block, 255))
        Prog_AVT_State.wait = 8
        Prog_AVT.SendVpw(v, 5)
        r = Prog_AVT.Recv()
        Prog_AVT_State.wait = 5
        IfCondition NotEqual(r, 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(Prog_AVT.ParseU32())
    }
}

Function.Prog_AVT.QueryOsid {
    Output: Integer
    Body: {
        Prog_AVT_State.pcm = 0
        Prog_AVT_State.osid = 0
        Prog_AVT_State.hw = 0
        Prog_AVT_State.cal = 0
        o = Prog_AVT.QueryBlock(10)
        IfCondition EqualTo(o, 0) ThenBlock: { ReturnValue(0) }
        Prog_AVT_State.osid = o
        Prog_AVT_State.pcm = 1
        Prog_AVT_State.hw = Prog_AVT.QueryBlock(4)
        Prog_AVT_State.cal = Prog_AVT.QueryBlock(8)
        ReturnValue(1)
    }
}

Function.Prog_AVT.SetCan {
    Output: Integer
    Body: {
        SetByte(Prog_AVT_State.cmd, 0, 225)
        SetByte(Prog_AVT_State.cmd, 1, 153)
        Prog_AVT.SendRaw(2)
        IfCondition NotEqual(Prog_AVT.Recv(), 0) ThenBlock: {
            ReturnValue(ECU_Err.Raise(-17, "avt: can"))
        }
        IfCondition NotEqual(GetByte(Prog_AVT_State.pay, 0), 16) ThenBlock: {
            ReturnValue(ECU_Err.Raise(-17, "avt: can"))
        }
        Prog_Tty.Drain()
        Prog_AVT_State.proto = 1
        ReturnValue(0)
    }
}

Function.Prog_AVT.CanEnable {
    Output: Integer
    Body: {
        SetByte(Prog_AVT_State.cmd, 0, 115)
        SetByte(Prog_AVT_State.cmd, 1, 10)
        SetByte(Prog_AVT_State.cmd, 2, 0)
        SetByte(Prog_AVT_State.cmd, 3, 2)
        Prog_AVT.SendRaw(4)
        Prog_Tty.SleepMs(50)
        Prog_Tty.Drain()
        SetByte(Prog_AVT_State.cmd, 0, 115)
        SetByte(Prog_AVT_State.cmd, 1, 17)
        SetByte(Prog_AVT_State.cmd, 2, 0)
        SetByte(Prog_AVT_State.cmd, 3, 1)
        Prog_AVT.SendRaw(4)
        Prog_Tty.SleepMs(50)
        Prog_Tty.Drain()
        ReturnValue(0)
    }
}

Function.Prog_AVT.SetKwp {
    Output: Integer
    Body: {
        SetByte(Prog_AVT_State.cmd, 0, 82)
        SetByte(Prog_AVT_State.cmd, 1, 105)
        SetByte(Prog_AVT_State.cmd, 2, 2)
        Prog_AVT.SendRaw(3)
        saw = 0
        k = 0
        WhileLoop LessThan(k, 4) {
            IfCondition NotEqual(Prog_AVT.Recv(), 0) ThenBlock: { k = 4 }
            IfCondition LessThan(k, 4) ThenBlock: {
                IfCondition EqualTo(GetByte(Prog_AVT_State.pay, 0), 105) ThenBlock: { saw = 1 }
                IfCondition EqualTo(GetByte(Prog_AVT_State.pay, 0), 15) ThenBlock: { saw = 1 }
                k = Add(k, 1)
            }
        }
        IfCondition EqualTo(saw, 0) ThenBlock: {
            ReturnValue(ECU_Err.Raise(-18, "avt: kwp"))
        }
        Prog_AVT_State.proto = 2
        ReturnValue(0)
    }
}

Function.Prog_AVT.SetBaud4800 {
    Output: Integer
    Body: {
        SetByte(Prog_AVT_State.cmd, 0, 83)
        SetByte(Prog_AVT_State.cmd, 1, 3)
        SetByte(Prog_AVT_State.cmd, 2, 1)
        SetByte(Prog_AVT_State.cmd, 3, 70)
        Prog_AVT.SendRaw(4)
        Prog_Tty.SleepMs(40)
        Prog_Tty.Drain()
        ReturnValue(0)
    }
}

Function.Prog_AVT.SendKwp {
    Input: buf: Address
    Input: n: Integer
    Output: Integer
    Body: {
        tot = Add(n, 1)
        IfCondition GreaterThan(tot, 15) ThenBlock: { ReturnValue(-1) }
        Prog_Tty.WriteByte(tot)
        Prog_Tty.WriteByte(6)
        ReturnValue(Prog_Tty.Write(buf, n))
    }
}

Function.Prog_AVT.SsmSum {
    Input: buf: Address
    Input: n: Integer
    Output: Integer
    Body: {
        s = 0
        i = 0
        WhileLoop LessThan(i, n) {
            s = Add(s, GetByte(buf, i))
            i = Add(i, 1)
        }
        ReturnValue(Modulo(s, 256))
    }
}

Function.Prog_AVT.QuerySsm {
    Output: Integer
    Body: {
        Prog_AVT_State.pcm = 0
        Prog_AVT_State.osid = 0
        v = Prog_AVT_State.vpw
        SetByte(v, 0, 128)
        SetByte(v, 1, 16)
        SetByte(v, 2, 240)
        SetByte(v, 3, 1)
        SetByte(v, 4, 191)
        cs = Prog_AVT.SsmSum(v, 5)
        SetByte(v, 5, cs)
        Prog_AVT_State.wait = 10
        Prog_AVT.SendKwp(v, 6)
        r = Prog_AVT.Recv()
        Prog_AVT_State.wait = 5
        IfCondition NotEqual(r, 0) ThenBlock: { ReturnValue(0) }
        n = Prog_AVT_State.plen
        IfCondition LessThan(n, 4) ThenBlock: { ReturnValue(0) }
        i = 0
        hit = 0
        WhileLoop LessThan(i, n) {
            IfCondition EqualTo(GetByte(Prog_AVT_State.pay, i), 128) ThenBlock: { hit = 1 }
            i = Add(i, 1)
        }
        IfCondition EqualTo(hit, 1) ThenBlock: {
            Prog_AVT_State.pcm = 1
            ReturnValue(1)
        }
        ReturnValue(0)
    }
}

Function.Prog_AVT.BringUp {
    Output: Integer
    Body: {
        IfCondition NotEqual(Prog_AVT.Open(), 0) ThenBlock: { ReturnValue(-1) }
        IfCondition EqualTo(Prog_AVT.Firmware(), 0) ThenBlock: { Prog_AVT.AskFw() }
        IfCondition EqualTo(Prog_Comm.IsVpw(), 1) ThenBlock: {
            IfCondition NotEqual(Prog_AVT.SetVpw(), 0) ThenBlock: { ReturnValue(-1) }
            Prog_Tty.Drain()
            IfCondition NotEqual(Prog_AVT.Setup(), 0) ThenBlock: { ReturnValue(-1) }
        }
        IfCondition EqualTo(Prog_Comm.IsCan(), 1) ThenBlock: {
            IfCondition NotEqual(Prog_AVT.SetCan(), 0) ThenBlock: { ReturnValue(-1) }
            Prog_AVT.CanEnable()
        }
        IfCondition EqualTo(Prog_Comm.IsKline(), 1) ThenBlock: {
            IfCondition NotEqual(Prog_AVT.SetCan(), 0) ThenBlock: { ReturnValue(-1) }
            IfCondition NotEqual(Prog_AVT.SetKwp(), 0) ThenBlock: { ReturnValue(-1) }
            Prog_AVT.SetBaud4800()
        }
        ReturnValue(0)
    }
}

Function.Prog_AVT.SendCan {
    Input: id: Integer
    Input: buf: Address
    Input: n: Integer
    Output: Integer
    Body: {
        tot = Add(n, 3)
        IfCondition GreaterThan(tot, 15) ThenBlock: { ReturnValue(-1) }
        Prog_Tty.WriteByte(tot)
        Prog_Tty.WriteByte(0)
        Prog_Tty.WriteByte(BitwiseAnd(Divide(id, 256), 255))
        Prog_Tty.WriteByte(BitwiseAnd(id, 255))
        ReturnValue(Prog_Tty.Write(buf, n))
    }
}

Function.Prog_AVT.QueryCanObd {
    Output: Integer
    Body: {
        Prog_AVT_State.pcm = 0
        Prog_AVT_State.osid = 0
        v = Prog_AVT_State.vpw
        i = 0
        WhileLoop LessThan(i, 8) {
            SetByte(v, i, 0)
            i = Add(i, 1)
        }
        SetByte(v, 0, 2)
        SetByte(v, 1, 1)
        SetByte(v, 2, 0)
        Prog_AVT_State.wait = 10
        id = Prog_Comm.CanTx()
        Prog_AVT.SendCan(id, v, 8)
        r = Prog_AVT.Recv()
        Prog_AVT_State.wait = 5
        IfCondition NotEqual(r, 0) ThenBlock: { ReturnValue(0) }
        n = Prog_AVT_State.plen
        IfCondition LessThan(n, 5) ThenBlock: { ReturnValue(0) }
        Prog_AVT_State.pcm = 1
        ReturnValue(1)
    }
}

Function.Prog_AVT.Probe {
    Output: Integer
    Body: {
        IfCondition EqualTo(Prog_Comm.IsVpw(), 1) ThenBlock: {
            ReturnValue(Prog_AVT.QueryOsid())
        }
        IfCondition EqualTo(Prog_Comm.IsKline(), 1) ThenBlock: {
            ReturnValue(Prog_AVT.QuerySsm())
        }
        IfCondition EqualTo(Prog_Comm.IsCan(), 1) ThenBlock: {
            ReturnValue(Prog_AVT.QueryCanObd())
        }
        Prog_AVT_State.pcm = 0
        ReturnValue(0)
    }
}

Function.Prog_AVT.PutInt {
    Input: fd: Integer
    Input: n: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(n, 0) ThenBlock: {
            ECU_Sys.Write(fd, "-", 1)
            n = Subtract(0, n)
        }
        buf = Allocate(16)
        IfCondition EqualTo(n, 0) ThenBlock: {
            SetByte(buf, 0, 48)
            ECU_Sys.Write(fd, buf, 1)
            Deallocate(buf, 16)
            ReturnValue(0)
        }
        k = 0
        tmp = Add(buf, 8)
        WhileLoop GreaterThan(n, 0) {
            SetByte(tmp, k, Add(48, Modulo(n, 10)))
            n = Divide(n, 10)
            k = Add(k, 1)
        }
        i = 0
        WhileLoop LessThan(i, k) {
            SetByte(buf, i, GetByte(tmp, Subtract(Subtract(k, 1), i)))
            i = Add(i, 1)
        }
        ECU_Sys.Write(fd, buf, k)
        Deallocate(buf, 16)
        ReturnValue(0)
    }
}

Function.Prog_AVT.WriteIdent {
    Input: path: Address
    Output: Integer
    Body: {
        fd = ECU_Sys.Open(path, 577, 420)
        IfCondition LessThan(fd, 0) ThenBlock: { ReturnValue(-1) }
        ECU_Sys.Write(fd, "device=AVT", 10)
        Prog_AVT.PutInt(fd, Prog_AVT_State.model)
        ECU_Sys.Write(fd, "\n", 1)
        ECU_Sys.Write(fd, "firmware=", 9)
        fw = Prog_AVT_State.fw
        Prog_AVT.PutInt(fd, Divide(fw, 16))
        ECU_Sys.Write(fd, ".", 1)
        Prog_AVT.PutInt(fd, Modulo(fw, 16))
        ECU_Sys.Write(fd, "\n", 1)
        ECU_Sys.Write(fd, "profile=", 8)
        id = Prog_Comm.Id()
        IfCondition NotEqual(id, 0) ThenBlock: {
            ECU_Sys.Write(fd, id, ECU_Sys.Len(id))
        }
        ECU_Sys.Write(fd, "\n", 1)
        ECU_Sys.Write(fd, "transport=", 10)
        t = Prog_Comm.Transport()
        IfCondition NotEqual(t, 0) ThenBlock: {
            ECU_Sys.Write(fd, t, ECU_Sys.Len(t))
        }
        ECU_Sys.Write(fd, "\n", 1)
        ECU_Sys.Write(fd, "bus=", 4)
        b = Prog_Comm.Bus()
        IfCondition NotEqual(b, 0) ThenBlock: {
            ECU_Sys.Write(fd, b, ECU_Sys.Len(b))
        }
        ECU_Sys.Write(fd, "\n", 1)
        ECU_Sys.Write(fd, "port=", 5)
        p = Prog_Comm.Port()
        IfCondition NotEqual(p, 0) ThenBlock: {
            ECU_Sys.Write(fd, p, ECU_Sys.Len(p))
        }
        ECU_Sys.Write(fd, "\n", 1)
        IfCondition EqualTo(Prog_AVT_State.pcm, 1) ThenBlock: {
            ECU_Sys.Write(fd, "pcm=ok\n", 7)
            ECU_Sys.Write(fd, "osid=", 5)
            Prog_AVT.PutInt(fd, Prog_AVT_State.osid)
            ECU_Sys.Write(fd, "\n", 1)
            ECU_Sys.Write(fd, "hw=", 3)
            Prog_AVT.PutInt(fd, Prog_AVT_State.hw)
            ECU_Sys.Write(fd, "\n", 1)
            ECU_Sys.Write(fd, "cal=", 4)
            Prog_AVT.PutInt(fd, Prog_AVT_State.cal)
            ECU_Sys.Write(fd, "\n", 1)
        }
        IfCondition EqualTo(Prog_AVT_State.pcm, 0) ThenBlock: {
            ECU_Sys.Write(fd, "pcm=none\n", 9)
            ECU_Sys.Write(fd, "osid=none\n", 10)
        }
        ECU_Sys.Close(fd)
        ReturnValue(0)
    }
}

Function.Prog_AVT.Osid {
    Output: Integer
    Body: {
        ReturnValue(Prog_AVT_State.osid)
    }
}

Function.Prog_AVT.Pcm {
    Output: Integer
    Body: {
        ReturnValue(Prog_AVT_State.pcm)
    }
}

Function.Prog_AVT.Close {
    Output: Integer
    Body: {
        Prog_Tty.Close()
        Prog_AVT_State.ok = 0
        ReturnValue(0)
    }
}
