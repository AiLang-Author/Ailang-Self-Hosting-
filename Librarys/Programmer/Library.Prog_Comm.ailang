// Programmer.Comm — loadable communication profiles (XML).
// XDF may name one: <AILANGCOMM profile="gm.p59.vpw"/>.
// Else index.xml maps make/family/binsize/osid → profile id.
// JSON later; same IR (id, make, family, bus, transport, port, vpw ids).
//
// Copyright (c) 2026 Sean Collins, 2 Paws Machine and Engineering. All rights reserved.
// Licensed under the Sean Collins Software License (SCSL v1.0).

LibraryImport.Arena
LibraryImport.Ecu.ECU_Sys
LibraryImport.Ecu.ECU_Err
LibraryImport.Xml.XML

FixedPool.Prog_Comm_State {
    "id":         Initialize=0, CanChange=True
    "make":       Initialize=0, CanChange=True
    "family":     Initialize=0, CanChange=True
    "bus":        Initialize=0, CanChange=True
    "transport":  Initialize=0, CanChange=True
    "port":       Initialize=0, CanChange=True
    "binsize":    Initialize=0, CanChange=True
    "toolid":     Initialize=240, CanChange=True
    "pcmid":      Initialize=16, CanChange=True
    "fourx":      Initialize=1, CanChange=True
    "cantx":      Initialize=2016, CanChange=True
    "canrx":      Initialize=2024, CanChange=True
    "str":        Initialize=0, CanChange=True
    "str_n":      Initialize=0, CanChange=True
    "filebuf":    Initialize=0, CanChange=True
    "ok":         Initialize=0, CanChange=True
}

Function.Prog_Comm.Init {
    Output: Integer
    Body: {
        IfCondition EqualTo(Prog_Comm_State.str, 0) ThenBlock: {
            Prog_Comm_State.str = Allocate(4096)
            Prog_Comm_State.filebuf = Allocate(8192)
        }
        Prog_Comm_State.str_n = 0
        Prog_Comm_State.id = 0
        Prog_Comm_State.make = 0
        Prog_Comm_State.family = 0
        Prog_Comm_State.bus = 0
        Prog_Comm_State.transport = 0
        Prog_Comm_State.port = 0
        Prog_Comm_State.binsize = 0
        Prog_Comm_State.toolid = 240
        Prog_Comm_State.pcmid = 16
        Prog_Comm_State.fourx = 1
        Prog_Comm_State.cantx = 2016
        Prog_Comm_State.canrx = 2024
        Prog_Comm_State.ok = 0
        ReturnValue(0)
    }
}

Function.Prog_Comm.Intern {
    Input: src: Address
    Output: Address
    Body: {
        IfCondition EqualTo(src, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Prog_Comm_State.str, 0) ThenBlock: { ReturnValue(0) }
        n = 0
        WhileLoop NotEqual(GetByte(src, n), 0) {
            n = Add(n, 1)
            IfCondition GreaterThan(n, 200) ThenBlock: { ReturnValue(0) }
        }
        dst = Add(Prog_Comm_State.str, Prog_Comm_State.str_n)
        i = 0
        WhileLoop LessThan(i, n) {
            SetByte(dst, i, GetByte(src, i))
            i = Add(i, 1)
        }
        SetByte(dst, n, 0)
        Prog_Comm_State.str_n = Add(Prog_Comm_State.str_n, Add(n, 1))
        ReturnValue(dst)
    }
}

Function.Prog_Comm.Eq {
    Input: a: Address
    Input: b: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(a, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(b, 0) ThenBlock: { ReturnValue(0) }
        i = 0
        WhileLoop LessThan(i, 80) {
            ca = GetByte(a, i)
            cb = GetByte(b, i)
            IfCondition GreaterEqual(ca, 65) ThenBlock: {
                IfCondition LessEqual(ca, 90) ThenBlock: { ca = Add(ca, 32) }
            }
            IfCondition GreaterEqual(cb, 65) ThenBlock: {
                IfCondition LessEqual(cb, 90) ThenBlock: { cb = Add(cb, 32) }
            }
            IfCondition NotEqual(ca, cb) ThenBlock: { ReturnValue(0) }
            IfCondition EqualTo(ca, 0) ThenBlock: { ReturnValue(1) }
            i = Add(i, 1)
        }
        ReturnValue(1)
    }
}

Function.Prog_Comm.ParseInt {
    Input: s: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(s, 0) ThenBlock: { ReturnValue(0) }
        i = 0
        WhileLoop EqualTo(GetByte(s, i), 32) {
            i = Add(i, 1)
        }
        hex = 0
        IfCondition EqualTo(GetByte(s, i), 48) ThenBlock: {
            n1 = GetByte(s, Add(i, 1))
            IfCondition EqualTo(n1, 120) ThenBlock: { hex = 1 }
            IfCondition EqualTo(n1, 88) ThenBlock: { hex = 1 }
        }
        IfCondition EqualTo(hex, 1) ThenBlock: {
            i = Add(i, 2)
            v = 0
            WhileLoop LessThan(i, 16) {
                ch = GetByte(s, i)
                IfCondition EqualTo(ch, 0) ThenBlock: { ReturnValue(v) }
                d = -1
                IfCondition GreaterEqual(ch, 48) ThenBlock: {
                    IfCondition LessEqual(ch, 57) ThenBlock: { d = Subtract(ch, 48) }
                }
                IfCondition GreaterEqual(ch, 97) ThenBlock: {
                    IfCondition LessEqual(ch, 102) ThenBlock: { d = Add(Subtract(ch, 97), 10) }
                }
                IfCondition GreaterEqual(ch, 65) ThenBlock: {
                    IfCondition LessEqual(ch, 70) ThenBlock: { d = Add(Subtract(ch, 65), 10) }
                }
                IfCondition LessThan(d, 0) ThenBlock: { ReturnValue(v) }
                v = Add(Multiply(v, 16), d)
                i = Add(i, 1)
            }
            ReturnValue(v)
        }
        v = 0
        WhileLoop LessThan(i, 16) {
            ch = GetByte(s, i)
            IfCondition LessThan(ch, 48) ThenBlock: { ReturnValue(v) }
            IfCondition GreaterThan(ch, 57) ThenBlock: { ReturnValue(v) }
            v = Add(Multiply(v, 10), Subtract(ch, 48))
            i = Add(i, 1)
        }
        ReturnValue(v)
    }
}

Function.Prog_Comm.TakeText {
    Input: parent: Integer
    Input: tag: Address
    Output: Address
    Body: {
        n = XML.Child(parent, tag)
        IfCondition EqualTo(n, 0) ThenBlock: { ReturnValue(0) }
        t = XML.Text(n)
        ReturnValue(Prog_Comm.Intern(t))
    }
}

Function.Prog_Comm.Fill {
    Input: root: Integer
    Output: Integer
    Body: {
        id = XML.Attr(root, "id")
        Prog_Comm_State.id = Prog_Comm.Intern(id)
        Prog_Comm_State.make = Prog_Comm.TakeText(root, "make")
        Prog_Comm_State.family = Prog_Comm.TakeText(root, "family")
        Prog_Comm_State.bus = Prog_Comm.TakeText(root, "bus")
        Prog_Comm_State.transport = Prog_Comm.TakeText(root, "transport")
        sz = Prog_Comm.TakeText(root, "binsize")
        Prog_Comm_State.binsize = Prog_Comm.ParseInt(sz)
        vpw = XML.Child(root, "vpw")
        IfCondition NotEqual(vpw, 0) ThenBlock: {
            a = XML.Attr(vpw, "toolid")
            IfCondition NotEqual(a, 0) ThenBlock: { Prog_Comm_State.toolid = Prog_Comm.ParseInt(a) }
            a = XML.Attr(vpw, "pcmid")
            IfCondition NotEqual(a, 0) ThenBlock: { Prog_Comm_State.pcmid = Prog_Comm.ParseInt(a) }
            a = XML.Attr(vpw, "fourx")
            IfCondition NotEqual(a, 0) ThenBlock: { Prog_Comm_State.fourx = Prog_Comm.ParseInt(a) }
        }
        can = XML.Child(root, "can")
        IfCondition NotEqual(can, 0) ThenBlock: {
            a = XML.Attr(can, "tx")
            IfCondition NotEqual(a, 0) ThenBlock: { Prog_Comm_State.cantx = Prog_Comm.ParseInt(a) }
            a = XML.Attr(can, "rx")
            IfCondition NotEqual(a, 0) ThenBlock: { Prog_Comm_State.canrx = Prog_Comm.ParseInt(a) }
        }
        avt = XML.Child(root, "avt")
        IfCondition NotEqual(avt, 0) ThenBlock: {
            a = XML.Attr(avt, "port")
            IfCondition NotEqual(a, 0) ThenBlock: { Prog_Comm_State.port = Prog_Comm.Intern(a) }
            pn = XML.Child(avt, "port")
            IfCondition NotEqual(pn, 0) ThenBlock: {
                t = XML.Text(pn)
                IfCondition NotEqual(t, 0) ThenBlock: { Prog_Comm_State.port = Prog_Comm.Intern(t) }
            }
        }
        IfCondition EqualTo(Prog_Comm_State.transport, 0) ThenBlock: {
            ReturnValue(ECU_Err.Raise(-1, "comm: no transport"))
        }
        Prog_Comm_State.ok = 1
        ReturnValue(0)
    }
}

Function.Prog_Comm.ReadAll {
    Input: path: Address
    Output: Integer
    Body: {
        fd = ECU_Sys.Open(path, 0, 0)
        IfCondition LessThan(fd, 0) ThenBlock: { ReturnValue(-1) }
        n = ECU_Sys.Read(fd, Prog_Comm_State.filebuf, 8000)
        ECU_Sys.Close(fd)
        IfCondition LessThan(n, 8) ThenBlock: { ReturnValue(-1) }
        SetByte(Prog_Comm_State.filebuf, n, 0)
        ReturnValue(n)
    }
}

Function.Prog_Comm.LoadFile {
    Input: path: Address
    Output: Integer
    Body: {
        Prog_Comm.Init()
        n = Prog_Comm.ReadAll(path)
        IfCondition LessThan(n, 0) ThenBlock: {
            ReturnValue(ECU_Err.Raise(-2, "comm: open fail"))
        }
        root = XML.Parse(Prog_Comm_State.filebuf, n)
        IfCondition EqualTo(root, 0) ThenBlock: {
            ReturnValue(ECU_Err.Raise(-3, "comm: xml fail"))
        }
        IfCondition EqualTo(XML.NameIs(root, "comm"), 0) ThenBlock: {
            ReturnValue(ECU_Err.Raise(-4, "comm: root"))
        }
        ReturnValue(Prog_Comm.Fill(root))
    }
}

Function.Prog_Comm.DirCat {
    Input: dir: Address
    Input: id: Address
    Input: dst: Address
    Output: Integer
    Body: {
        i = 0
        WhileLoop NotEqual(GetByte(dir, i), 0) {
            SetByte(dst, i, GetByte(dir, i))
            i = Add(i, 1)
            IfCondition GreaterThan(i, 200) ThenBlock: { ReturnValue(-1) }
        }
        IfCondition NotEqual(GetByte(dst, Subtract(i, 1)), 47) ThenBlock: {
            SetByte(dst, i, 47)
            i = Add(i, 1)
        }
        j = 0
        WhileLoop NotEqual(GetByte(id, j), 0) {
            SetByte(dst, i, GetByte(id, j))
            i = Add(i, 1)
            j = Add(j, 1)
            IfCondition GreaterThan(i, 240) ThenBlock: { ReturnValue(-1) }
        }
        SetByte(dst, i, 46)
        i = Add(i, 1)
        SetByte(dst, i, 120)
        i = Add(i, 1)
        SetByte(dst, i, 109)
        i = Add(i, 1)
        SetByte(dst, i, 108)
        i = Add(i, 1)
        SetByte(dst, i, 0)
        ReturnValue(0)
    }
}

Function.Prog_Comm.LoadId {
    Input: dir: Address
    Input: id: Address
    Output: Integer
    Body: {
        p = Allocate(256)
        Prog_Comm.DirCat(dir, id, p)
        r = Prog_Comm.LoadFile(p)
        Deallocate(p, 256)
        ReturnValue(r)
    }
}

Function.Prog_Comm.ApplyPortFile {
    Output: Integer
    Body: {
        fd = ECU_Sys.Open("/tmp/ecu_flash/port.txt", 0, 0)
        IfCondition LessThan(fd, 0) ThenBlock: { ReturnValue(0) }
        buf = Allocate(128)
        n = ECU_Sys.Read(fd, buf, 120)
        ECU_Sys.Close(fd)
        IfCondition LessThan(n, 1) ThenBlock: {
            Deallocate(buf, 128)
            ReturnValue(0)
        }
        SetByte(buf, n, 0)
        i = 0
        WhileLoop LessThan(i, n) {
            ch = GetByte(buf, i)
            IfCondition EqualTo(ch, 10) ThenBlock: { SetByte(buf, i, 0) }
            IfCondition EqualTo(ch, 13) ThenBlock: { SetByte(buf, i, 0) }
            i = Add(i, 1)
        }
        Prog_Comm_State.port = Prog_Comm.Intern(buf)
        Deallocate(buf, 128)
        ReturnValue(1)
    }
}

Function.Prog_Comm.Ok {
    Output: Integer
    Body: {
        ReturnValue(Prog_Comm_State.ok)
    }
}

Function.Prog_Comm.Id {
    Output: Address
    Body: {
        ReturnValue(Prog_Comm_State.id)
    }
}

Function.Prog_Comm.Transport {
    Output: Address
    Body: {
        ReturnValue(Prog_Comm_State.transport)
    }
}

Function.Prog_Comm.Port {
    Output: Address
    Body: {
        ReturnValue(Prog_Comm_State.port)
    }
}

Function.Prog_Comm.SetPort {
    Input: p: Address
    Output: Integer
    Body: {
        Prog_Comm_State.port = Prog_Comm.Intern(p)
        ReturnValue(0)
    }
}

Function.Prog_Comm.ToolId {
    Output: Integer
    Body: {
        ReturnValue(Prog_Comm_State.toolid)
    }
}

Function.Prog_Comm.PcmId {
    Output: Integer
    Body: {
        ReturnValue(Prog_Comm_State.pcmid)
    }
}

Function.Prog_Comm.CanTx {
    Output: Integer
    Body: {
        ReturnValue(Prog_Comm_State.cantx)
    }
}

Function.Prog_Comm.CanRx {
    Output: Integer
    Body: {
        ReturnValue(Prog_Comm_State.canrx)
    }
}

Function.Prog_Comm.Bus {
    Output: Address
    Body: {
        ReturnValue(Prog_Comm_State.bus)
    }
}

Function.Prog_Comm.IsAvt {
    Output: Integer
    Body: {
        ReturnValue(Prog_Comm.Eq(Prog_Comm_State.transport, "avt852"))
    }
}

Function.Prog_Comm.IsVpw {
    Output: Integer
    Body: {
        ReturnValue(Prog_Comm.Eq(Prog_Comm_State.bus, "vpw"))
    }
}

Function.Prog_Comm.IsCan {
    Output: Integer
    Body: {
        ReturnValue(Prog_Comm.Eq(Prog_Comm_State.bus, "can"))
    }
}

Function.Prog_Comm.IsKline {
    Output: Integer
    Body: {
        ReturnValue(Prog_Comm.Eq(Prog_Comm_State.bus, "kline"))
    }
}

Function.Prog_Comm.LoadActive {
    Output: Integer
    Body: {
        fd = ECU_Sys.Open("/tmp/ecu_flash/profile.txt", 0, 0)
        IfCondition LessThan(fd, 0) ThenBlock: {
            ReturnValue(Prog_Comm.LoadFile("ECU/comm/gm.p59.vpw.xml"))
        }
        buf = Allocate(256)
        n = ECU_Sys.Read(fd, buf, 240)
        ECU_Sys.Close(fd)
        IfCondition LessThan(n, 1) ThenBlock: {
            Deallocate(buf, 256)
            ReturnValue(Prog_Comm.LoadFile("ECU/comm/gm.p59.vpw.xml"))
        }
        SetByte(buf, n, 0)
        i = 0
        WhileLoop LessThan(i, n) {
            ch = GetByte(buf, i)
            IfCondition EqualTo(ch, 10) ThenBlock: { SetByte(buf, i, 0) }
            IfCondition EqualTo(ch, 13) ThenBlock: { SetByte(buf, i, 0) }
            i = Add(i, 1)
        }
        slash = 0
        i = 0
        WhileLoop NotEqual(GetByte(buf, i), 0) {
            IfCondition EqualTo(GetByte(buf, i), 47) ThenBlock: { slash = 1 }
            i = Add(i, 1)
        }
        IfCondition EqualTo(slash, 1) ThenBlock: {
            r = Prog_Comm.LoadFile(buf)
            Deallocate(buf, 256)
            ReturnValue(r)
        }
        r = Prog_Comm.LoadId("ECU/comm", buf)
        Deallocate(buf, 256)
        ReturnValue(r)
    }
}
