// Programmer.Moates — Ostrich / BURN1/2 / Roadrunner / APU1 / QuarterHorse.
// Vendor protocol v19: 8N1, CS = 8-bit sum no carry, VV ident, 'O' ok.
// Default 921600. 32 KiB images sit at 8000-FFFF in 64 KiB space.
// SST27SF512 chip cmd '5'. Do not erase unless asked.
// Roadrunner W/R encryption is still vendor-side — ident only for RR.
//
// Copyright (c) 2026 Sean Collins, 2 Paws Machine and Engineering. All rights reserved.
// Licensed under the Sean Collins Software License (SCSL v1.0).

LibraryImport.Arena
LibraryImport.Ecu.ECU_Sys
LibraryImport.Ecu.ECU_Err
LibraryImport.Programmer.Prog_Tty
LibraryImport.Programmer.Prog_Comm

FixedPool.Prog_Moates_State {
    "ok":     Initialize=0, CanChange=True
    "fam":    Initialize=0, CanChange=True
    "rev":    Initialize=0, CanChange=True
    "letter": Initialize=0, CanChange=True
    "chip":   Initialize=53, CanChange=True
    "cmd":    Initialize=0, CanChange=True
    "page":   Initialize=0, CanChange=True
    "wbuf":   Initialize=0, CanChange=True
    "wait":   Initialize=40, CanChange=True
    "v_bad":  Initialize=-1, CanChange=True
    "v_got":  Initialize=0, CanChange=True
    "v_want": Initialize=0, CanChange=True
    "v_ff":   Initialize=0, CanChange=True
    "v_pages": Initialize=0, CanChange=True
    "p_lo":   Initialize=0, CanChange=True
    "p_hi":   Initialize=100, CanChange=True
}

Function.Prog_Moates.Init {
    Output: Integer
    Body: {
        IfCondition EqualTo(Prog_Moates_State.cmd, 0) ThenBlock: {
            Prog_Moates_State.cmd = Allocate(32)
            Prog_Moates_State.page = Allocate(260)
            Prog_Moates_State.wbuf = Allocate(270)
        }
        Prog_Moates_State.ok = 0
        Prog_Moates_State.fam = 0
        Prog_Moates_State.rev = 0
        Prog_Moates_State.letter = 0
        Prog_Moates_State.chip = 53
        Prog_Moates_State.p_lo = 0
        Prog_Moates_State.p_hi = 100
        ReturnValue(0)
    }
}

Function.Prog_Moates.Cs {
    Input: buf: Address
    Input: n: Integer
    Output: Integer
    Body: {
        s = 0
        i = 0
        WhileLoop LessThan(i, n) {
            s = Add(s, GetByte(buf, i))
            i = Add(i, 1)
        }
        ReturnValue(BitwiseAnd(s, 255))
    }
}

Function.Prog_Moates.WaitByte {
    Output: Integer
    Body: {
        k = 0
        lim = Prog_Moates_State.wait
        WhileLoop LessThan(k, lim) {
            b = Prog_Tty.ReadByte()
            IfCondition GreaterEqual(b, 0) ThenBlock: { ReturnValue(b) }
            Prog_Tty.SleepMs(2)
            k = Add(k, 1)
        }
        ReturnValue(-1)
    }
}

Function.Prog_Moates.ReadN {
    Input: buf: Address
    Input: n: Integer
    Output: Integer
    Body: {
        i = 0
        WhileLoop LessThan(i, n) {
            b = Prog_Moates.WaitByte()
            IfCondition LessThan(b, 0) ThenBlock: { ReturnValue(i) }
            SetByte(buf, i, b)
            i = Add(i, 1)
        }
        ReturnValue(i)
    }
}

Function.Prog_Moates.Send {
    Input: n: Integer
    Output: Integer
    Body: {
        SetByte(Prog_Moates_State.cmd, n, Prog_Moates.Cs(Prog_Moates_State.cmd, n))
        Prog_Tty.Drain()
        ReturnValue(Prog_Tty.Write(Prog_Moates_State.cmd, Add(n, 1)))
    }
}

Function.Prog_Moates.VV {
    Output: Integer
    Body: {
        Prog_Tty.Drain()
        Prog_Tty.WriteByte(86)
        Prog_Tty.WriteByte(86)
        a = Prog_Moates.WaitByte()
        b = Prog_Moates.WaitByte()
        c = Prog_Moates.WaitByte()
        IfCondition LessThan(a, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition LessThan(b, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition LessThan(c, 0) ThenBlock: { ReturnValue(-1) }
        Prog_Moates_State.fam = a
        Prog_Moates_State.rev = b
        Prog_Moates_State.letter = c
        Prog_Moates_State.ok = 1
        ReturnValue(0)
    }
}

Function.Prog_Moates.SavePort {
    Output: Integer
    Body: {
        p = Prog_Comm_State.port
        IfCondition EqualTo(p, 0) ThenBlock: { ReturnValue(-1) }
        fd = ECU_Sys.Open("/tmp/ecu_flash/port.txt", 577, 420)
        IfCondition LessThan(fd, 0) ThenBlock: { ReturnValue(-1) }
        ECU_Sys.Write(fd, p, ECU_Sys.Len(p))
        ECU_Sys.Write(fd, "\n", 1)
        ECU_Sys.Close(fd)
        ReturnValue(0)
    }
}

Function.Prog_Moates.TryPort {
    Input: path: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(path, 0) ThenBlock: { ReturnValue(-1) }
        ECU_Sys.Log("moates: try ")
        ECU_Sys.Log(path)
        ECU_Sys.Log("\n")
        IfCondition LessThan(Prog_Tty.Open(path), 0) ThenBlock: {
            ECU_Sys.Log("moates: open fail\n")
            ReturnValue(-1)
        }
        Prog_Tty.SetSpeed(921600)
        Prog_Tty.SleepMs(40)
        IfCondition EqualTo(Prog_Moates.VV(), 0) ThenBlock: {
            IfCondition EqualTo(Prog_Moates_State.fam, 5) ThenBlock: {
                Prog_Comm.SetPort(path)
                ECU_Sys.Log("moates: BURN VV ok\n")
                ReturnValue(0)
            }
            ECU_Sys.Log("moates: VV not BURN, skip\n")
        }
        Prog_Tty.SetSpeed(115200)
        Prog_Tty.SleepMs(40)
        IfCondition EqualTo(Prog_Moates.VV(), 0) ThenBlock: {
            IfCondition EqualTo(Prog_Moates_State.fam, 5) ThenBlock: {
                Prog_Comm.SetPort(path)
                ECU_Sys.Log("moates: BURN VV ok 115200\n")
                ReturnValue(0)
            }
            ECU_Sys.Log("moates: VV not BURN, skip\n")
        }
        Prog_Tty.Close()
        ReturnValue(-2)
    }
}

Function.Prog_Moates.TrySave {
    Input: path: Address
    Output: Integer
    Body: {
        IfCondition NotEqual(Prog_Moates.TryPort(path), 0) ThenBlock: { ReturnValue(-1) }
        Prog_Moates.SavePort()
        ReturnValue(0)
    }
}

Function.Prog_Moates.BringUp {
    Output: Integer
    Body: {
        Prog_Moates.Init()
        port = Prog_Comm_State.port
        IfCondition NotEqual(port, 0) ThenBlock: {
            IfCondition EqualTo(Prog_Moates.TrySave(port), 0) ThenBlock: { ReturnValue(0) }
        }
        IfCondition EqualTo(Prog_Moates.TrySave("/dev/ttyUSB2"), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Prog_Moates.TrySave("/dev/ttyUSB4"), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Prog_Moates.TrySave("/dev/ttyUSB5"), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Prog_Moates.TrySave("/dev/ttyUSB6"), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Prog_Moates.TrySave("/dev/ttyUSB7"), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Prog_Moates.TrySave("/dev/ttyUSB3"), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Prog_Moates.TrySave("/dev/ttyUSB1"), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Prog_Moates.TrySave("/dev/ttyUSB0"), 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(ECU_Err.Raise(-2, "moates: no BURN VV"))
    }
}

Function.Prog_Moates.Close {
    Output: Integer
    Body: {
        Prog_Tty.Close()
        Prog_Moates_State.ok = 0
        ReturnValue(0)
    }
}

Function.Prog_Moates.Kind {
    Output: Address
    Body: {
        f = Prog_Moates_State.fam
        IfCondition EqualTo(f, 5) ThenBlock: { ReturnValue("BURN") }
        IfCondition EqualTo(f, 16) ThenBlock: { ReturnValue("Ostrich") }
        IfCondition EqualTo(f, 18) ThenBlock: { ReturnValue("Roadrunner") }
        IfCondition EqualTo(f, 2) ThenBlock: { ReturnValue("APU1") }
        ReturnValue("Moates")
    }
}

Function.Prog_Moates.Chip512 {
    Output: Integer
    Body: {
        Prog_Moates_State.chip = 53
        ReturnValue(0)
    }
}

Function.Prog_Moates.Chip256 {
    Output: Integer
    Body: {
        Prog_Moates_State.chip = 50
        ReturnValue(0)
    }
}

Function.Prog_Moates.SetChip {
    Input: c: Integer
    Output: Integer
    Body: {
        Prog_Moates_State.chip = c
        ReturnValue(0)
    }
}

Function.Prog_Moates.SetSpan {
    Input: lo: Integer
    Input: hi: Integer
    Output: Integer
    Body: {
        Prog_Moates_State.p_lo = lo
        Prog_Moates_State.p_hi = hi
        ReturnValue(0)
    }
}

Function.Prog_Moates.Report {
    Input: phase: Address
    Input: done: Integer
    Input: total: Integer
    Output: Integer
    Body: {
        fd = ECU_Sys.Open("/tmp/ecu_flash/progress.txt", 577, 420)
        IfCondition LessThan(fd, 0) ThenBlock: { ReturnValue(-1) }
        ECU_Sys.Write(fd, "phase=", 6)
        IfCondition NotEqual(phase, 0) ThenBlock: {
            ECU_Sys.Write(fd, phase, ECU_Sys.Len(phase))
        }
        ECU_Sys.Write(fd, "\ndone=", 6)
        buf = Allocate(16)
        n = done
        IfCondition LessThan(n, 0) ThenBlock: { n = 0 }
        i = 0
        IfCondition EqualTo(n, 0) ThenBlock: {
            SetByte(buf, 0, 48)
            i = 1
        }
        WhileLoop GreaterThan(n, 0) {
            SetByte(buf, i, Add(48, Modulo(n, 10)))
            n = Divide(n, 10)
            i = Add(i, 1)
        }
        j = Subtract(i, 1)
        k = 0
        WhileLoop LessThan(k, j) {
            a = GetByte(buf, k)
            SetByte(buf, k, GetByte(buf, j))
            SetByte(buf, j, a)
            k = Add(k, 1)
            j = Subtract(j, 1)
        }
        ECU_Sys.Write(fd, buf, i)
        ECU_Sys.Write(fd, "\ntotal=", 7)
        n = total
        IfCondition LessThan(n, 1) ThenBlock: { n = 1 }
        i = 0
        IfCondition EqualTo(n, 0) ThenBlock: {
            SetByte(buf, 0, 48)
            i = 1
        }
        WhileLoop GreaterThan(n, 0) {
            SetByte(buf, i, Add(48, Modulo(n, 10)))
            n = Divide(n, 10)
            i = Add(i, 1)
        }
        j = Subtract(i, 1)
        k = 0
        WhileLoop LessThan(k, j) {
            a = GetByte(buf, k)
            SetByte(buf, k, GetByte(buf, j))
            SetByte(buf, j, a)
            k = Add(k, 1)
            j = Subtract(j, 1)
        }
        ECU_Sys.Write(fd, buf, i)
        span = Subtract(Prog_Moates_State.p_hi, Prog_Moates_State.p_lo)
        IfCondition LessThan(span, 1) ThenBlock: { span = 100 }
        tot = total
        IfCondition LessThan(tot, 1) ThenBlock: { tot = 1 }
        pct = Add(Prog_Moates_State.p_lo, Divide(Multiply(done, span), tot))
        IfCondition GreaterThan(pct, 100) ThenBlock: { pct = 100 }
        ECU_Sys.Write(fd, "\npct=", 5)
        n = pct
        i = 0
        IfCondition EqualTo(n, 0) ThenBlock: {
            SetByte(buf, 0, 48)
            i = 1
        }
        WhileLoop GreaterThan(n, 0) {
            SetByte(buf, i, Add(48, Modulo(n, 10)))
            n = Divide(n, 10)
            i = Add(i, 1)
        }
        j = Subtract(i, 1)
        k = 0
        WhileLoop LessThan(k, j) {
            a = GetByte(buf, k)
            SetByte(buf, k, GetByte(buf, j))
            SetByte(buf, j, a)
            k = Add(k, 1)
            j = Subtract(j, 1)
        }
        ECU_Sys.Write(fd, buf, i)
        ECU_Sys.Write(fd, "\n", 1)
        Deallocate(buf, 16)
        ECU_Sys.Close(fd)
        ReturnValue(0)
    }
}

Function.Prog_Moates.ReadPage {
    Input: msb: Integer
    Output: Integer
    Body: {
        cmd = Prog_Moates_State.cmd
        SetByte(cmd, 0, Prog_Moates_State.chip)
        SetByte(cmd, 1, 82)
        SetByte(cmd, 2, 0)
        SetByte(cmd, 3, BitwiseAnd(msb, 255))
        SetByte(cmd, 4, 0)
        Prog_Moates.Send(5)
        n = Prog_Moates.ReadN(Prog_Moates_State.page, 257)
        IfCondition LessThan(n, 257) ThenBlock: { ReturnValue(-1) }
        got = Prog_Moates.Cs(Prog_Moates_State.page, 256)
        IfCondition NotEqual(got, GetByte(Prog_Moates_State.page, 256)) ThenBlock: {
            ReturnValue(-2)
        }
        ReturnValue(256)
    }
}

Function.Prog_Moates.Verify {
    Input: path: Address
    Input: base: Integer
    Input: nbytes: Integer
    Output: Integer
    Body: {
        Prog_Moates_State.v_bad = -1
        Prog_Moates_State.v_got = 0
        Prog_Moates_State.v_want = 0
        Prog_Moates_State.v_ff = 1
        Prog_Moates_State.v_pages = 0
        IfCondition EqualTo(path, 0) ThenBlock: { ReturnValue(-4) }
        IfCondition LessEqual(nbytes, 0) ThenBlock: { ReturnValue(-4) }
        IfCondition GreaterThan(nbytes, 65536) ThenBlock: { ReturnValue(-4) }
        IfCondition NotEqual(Modulo(nbytes, 256), 0) ThenBlock: { ReturnValue(-4) }
        IfCondition LessThan(base, 0) ThenBlock: { ReturnValue(-4) }
        fd = ECU_Sys.Open(path, 0, 0)
        IfCondition LessThan(fd, 0) ThenBlock: { ReturnValue(-1) }
        job = Allocate(nbytes)
        IfCondition EqualTo(job, 0) ThenBlock: {
            ECU_Sys.Close(fd)
            ReturnValue(-1)
        }
        n = ECU_Sys.Read(fd, job, nbytes)
        ECU_Sys.Close(fd)
        IfCondition NotEqual(n, nbytes) ThenBlock: {
            Deallocate(job, nbytes)
            ReturnValue(-1)
        }
        pages = Divide(nbytes, 256)
        Prog_Moates.Report("verify", 0, pages)
        off = 0
        bad = 0
        WhileLoop LessThan(off, nbytes) {
            msb = BitwiseAnd(Divide(Add(base, off), 256), 255)
            r = Prog_Moates.ReadPage(msb)
            IfCondition LessThan(r, 256) ThenBlock: {
                r = Prog_Moates.ReadPage(msb)
            }
            IfCondition LessThan(r, 256) ThenBlock: {
                Deallocate(job, nbytes)
                ReturnValue(-2)
            }
            Prog_Moates_State.v_pages = Add(Prog_Moates_State.v_pages, 1)
            Prog_Moates.Report("verify", Prog_Moates_State.v_pages, pages)
            i = 0
            WhileLoop LessThan(i, 256) {
                gb = GetByte(Prog_Moates_State.page, i)
                wb = GetByte(job, Add(off, i))
                IfCondition NotEqual(gb, 255) ThenBlock: { Prog_Moates_State.v_ff = 0 }
                IfCondition EqualTo(bad, 0) ThenBlock: {
                    IfCondition NotEqual(gb, wb) ThenBlock: {
                        bad = 1
                        Prog_Moates_State.v_bad = Add(off, i)
                        Prog_Moates_State.v_got = gb
                        Prog_Moates_State.v_want = wb
                    }
                }
                i = Add(i, 1)
            }
            off = Add(off, 256)
        }
        Deallocate(job, nbytes)
        ReturnValue(bad)
    }
}

Function.Prog_Moates.BlankCheck {
    Input: base: Integer
    Input: nbytes: Integer
    Output: Integer
    Body: {
        Prog_Moates_State.v_ff = 1
        Prog_Moates_State.v_pages = 0
        Prog_Moates_State.v_bad = -1
        IfCondition LessEqual(nbytes, 0) ThenBlock: { ReturnValue(-4) }
        IfCondition GreaterThan(nbytes, 65536) ThenBlock: { ReturnValue(-4) }
        IfCondition NotEqual(Modulo(nbytes, 256), 0) ThenBlock: { ReturnValue(-4) }
        pages = Divide(nbytes, 256)
        Prog_Moates.Report("blank", 0, pages)
        off = 0
        dirty = 0
        WhileLoop LessThan(off, nbytes) {
            msb = BitwiseAnd(Divide(Add(base, off), 256), 255)
            r = Prog_Moates.ReadPage(msb)
            IfCondition LessThan(r, 256) ThenBlock: {
                r = Prog_Moates.ReadPage(msb)
            }
            IfCondition LessThan(r, 256) ThenBlock: { ReturnValue(-2) }
            Prog_Moates_State.v_pages = Add(Prog_Moates_State.v_pages, 1)
            i = 0
            WhileLoop LessThan(i, 256) {
                gb = GetByte(Prog_Moates_State.page, i)
                IfCondition NotEqual(gb, 255) ThenBlock: {
                    Prog_Moates_State.v_ff = 0
                    IfCondition EqualTo(dirty, 0) ThenBlock: {
                        dirty = 1
                        Prog_Moates_State.v_bad = Add(off, i)
                        Prog_Moates_State.v_got = gb
                    }
                }
                i = Add(i, 1)
            }
            Prog_Moates.Report("blank", Prog_Moates_State.v_pages, pages)
            off = Add(off, 256)
        }
        ReturnValue(dirty)
    }
}

Function.Prog_Moates.WriteChunk {
    Input: addr: Integer
    Input: n: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(n, 1) ThenBlock: { ReturnValue(-4) }
        IfCondition GreaterThan(n, 256) ThenBlock: { ReturnValue(-4) }
        w = Prog_Moates_State.wbuf
        IfCondition EqualTo(w, 0) ThenBlock: { ReturnValue(-1) }
        sn = n
        IfCondition EqualTo(n, 256) ThenBlock: { sn = 0 }
        SetByte(w, 0, Prog_Moates_State.chip)
        SetByte(w, 1, 87)
        SetByte(w, 2, sn)
        SetByte(w, 3, BitwiseAnd(Divide(addr, 256), 255))
        SetByte(w, 4, BitwiseAnd(addr, 255))
        i = 0
        WhileLoop LessThan(i, n) {
            SetByte(w, Add(5, i), GetByte(Prog_Moates_State.page, i))
            i = Add(i, 1)
        }
        tot = Add(5, n)
        SetByte(w, tot, Prog_Moates.Cs(w, tot))
        Prog_Tty.Drain()
        Prog_Tty.Write(w, Add(tot, 1))
        old = Prog_Moates_State.wait
        Prog_Moates_State.wait = 200
        b = Prog_Moates.WaitByte()
        Prog_Moates_State.wait = old
        IfCondition EqualTo(b, 79) ThenBlock: {
            Prog_Tty.SleepMs(8)
            ReturnValue(0)
        }
        Prog_Moates_State.v_got = b
        IfCondition EqualTo(b, 63) ThenBlock: {
            ECU_Sys.Log("moates: write '?' (checksum/cmd)\n")
        }
        ReturnValue(-1)
    }
}

Function.Prog_Moates.Program {
    Input: path: Address
    Input: base: Integer
    Input: nbytes: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(path, 0) ThenBlock: { ReturnValue(-4) }
        IfCondition LessEqual(nbytes, 0) ThenBlock: { ReturnValue(-4) }
        IfCondition GreaterThan(nbytes, 65536) ThenBlock: { ReturnValue(-4) }
        IfCondition NotEqual(Modulo(nbytes, 256), 0) ThenBlock: { ReturnValue(-4) }
        fd = ECU_Sys.Open(path, 0, 0)
        IfCondition LessThan(fd, 0) ThenBlock: { ReturnValue(-1) }
        job = Allocate(nbytes)
        IfCondition EqualTo(job, 0) ThenBlock: {
            ECU_Sys.Close(fd)
            ReturnValue(-1)
        }
        n = ECU_Sys.Read(fd, job, nbytes)
        ECU_Sys.Close(fd)
        IfCondition NotEqual(n, nbytes) ThenBlock: {
            Deallocate(job, nbytes)
            ReturnValue(-1)
        }
        pages = Divide(nbytes, 256)
        Prog_Moates.SetSpan(0, 20)
        ECU_Sys.Log("moates: blank check\n")
        bl = Prog_Moates.BlankCheck(base, nbytes)
        IfCondition LessThan(bl, 0) ThenBlock: {
            Deallocate(job, nbytes)
            ReturnValue(-2)
        }
        IfCondition EqualTo(bl, 1) ThenBlock: {
            IfCondition NotEqual(Prog_Moates_State.chip, 53) ThenBlock: {
                ECU_Sys.Log("moates: not blank, no erase for this chip\n")
            }
            IfCondition EqualTo(Prog_Moates_State.chip, 53) ThenBlock: {
                ECU_Sys.Log("moates: not blank, erase\n")
                er = Prog_Moates.BlankChip(base, nbytes)
                IfCondition NotEqual(er, 0) ThenBlock: {
                    Deallocate(job, nbytes)
                    ReturnValue(er)
                }
                bl = 0
            }
        }
        IfCondition EqualTo(bl, 0) ThenBlock: {
            ECU_Sys.Log("moates: blank OK\n")
        }
        Prog_Moates.SetSpan(40, 80)
        chunk = 256
        off = 0
        WhileLoop LessThan(off, nbytes) {
            i = 0
            WhileLoop LessThan(i, chunk) {
                SetByte(Prog_Moates_State.page, i, GetByte(job, Add(off, i)))
                i = Add(i, 1)
            }
            r = Prog_Moates.WriteChunk(Add(base, off), chunk)
            IfCondition NotEqual(r, 0) ThenBlock: {
                r = Prog_Moates.WriteChunk(Add(base, off), chunk)
            }
            IfCondition NotEqual(r, 0) ThenBlock: {
                ECU_Sys.Log("moates: write chunk FAIL\n")
                Deallocate(job, nbytes)
                ReturnValue(-6)
            }
            r = Prog_Moates.WriteChunk(Add(base, off), chunk)
            off = Add(off, chunk)
            Prog_Moates.Report("program", Divide(off, 256), pages)
        }
        Deallocate(job, nbytes)
        ECU_Sys.Log("moates: program pages OK\n")
        Prog_Moates.SetSpan(80, 100)
        r = Prog_Moates.Verify(path, base, nbytes)
        Prog_Moates.SetSpan(0, 100)
        ReturnValue(r)
    }
}

Function.Prog_Moates.Erase512 {
    Output: Integer
    Body: {
        cmd = Prog_Moates_State.cmd
        SetByte(cmd, 0, 53)
        SetByte(cmd, 1, 69)
        Prog_Moates.Send(2)
        Prog_Tty.SleepMs(200)
        old = Prog_Moates_State.wait
        Prog_Moates_State.wait = 1500
        b = Prog_Moates.WaitByte()
        IfCondition EqualTo(b, 79) ThenBlock: {
            Prog_Moates_State.wait = old
            Prog_Tty.SleepMs(100)
            ReturnValue(0)
        }
        Prog_Tty.Drain()
        SetByte(cmd, 0, 53)
        SetByte(cmd, 1, 69)
        Prog_Moates.Send(2)
        Prog_Tty.SleepMs(200)
        b = Prog_Moates.WaitByte()
        Prog_Moates_State.wait = old
        IfCondition EqualTo(b, 79) ThenBlock: {
            Prog_Tty.SleepMs(100)
            ReturnValue(0)
        }
        Prog_Moates_State.v_got = b
        ReturnValue(-1)
    }
}

Function.Prog_Moates.BlankChip {
    Input: base: Integer
    Input: nbytes: Integer
    Output: Integer
    Body: {
        IfCondition NotEqual(Prog_Moates_State.chip, 53) ThenBlock: { ReturnValue(-8) }
        IfCondition LessEqual(nbytes, 0) ThenBlock: { nbytes = 65536 }
        IfCondition EqualTo(base, 0) ThenBlock: {
            IfCondition EqualTo(nbytes, 0) ThenBlock: { nbytes = 65536 }
        }
        Prog_Moates.SetSpan(0, 40)
        Prog_Moates.Report("erase", 0, 1)
        ECU_Sys.Log("moates: blank chip erase\n")
        IfCondition NotEqual(Prog_Moates.Erase512(), 0) ThenBlock: {
            ECU_Sys.Log("moates: erase FAIL\n")
            ReturnValue(-5)
        }
        Prog_Moates.Report("erase", 1, 1)
        Prog_Moates.SetSpan(40, 100)
        bl = Prog_Moates.BlankCheck(base, nbytes)
        IfCondition NotEqual(bl, 0) ThenBlock: {
            Prog_Moates.SetSpan(0, 40)
            Prog_Moates.Report("erase", 0, 1)
            ECU_Sys.Log("moates: still dirty, erase again\n")
            IfCondition NotEqual(Prog_Moates.Erase512(), 0) ThenBlock: { ReturnValue(-5) }
            Prog_Moates.SetSpan(40, 100)
            bl = Prog_Moates.BlankCheck(base, nbytes)
        }
        IfCondition NotEqual(bl, 0) ThenBlock: {
            ECU_Sys.Log("moates: still not blank\n")
            ReturnValue(-7)
        }
        ECU_Sys.Log("moates: chip blank\n")
        Prog_Moates.SetSpan(0, 100)
        ReturnValue(0)
    }
}

Function.Prog_Moates.WriteIdent {
    Input: path: Address
    Output: Integer
    Body: {
        fd = ECU_Sys.Open(path, 577, 420)
        IfCondition LessThan(fd, 0) ThenBlock: { ReturnValue(-1) }
        ECU_Sys.Write(fd, "device=", 7)
        k = Prog_Moates.Kind()
        ECU_Sys.Write(fd, k, ECU_Sys.Len(k))
        ECU_Sys.Write(fd, "\nletter=", 8)
        SetByte(Prog_Moates_State.cmd, 0, Prog_Moates_State.letter)
        SetByte(Prog_Moates_State.cmd, 1, 0)
        ECU_Sys.Write(fd, Prog_Moates_State.cmd, 1)
        ECU_Sys.Write(fd, "\nchip=SST27SF512\n", 17)
        ECU_Sys.Write(fd, "port=", 5)
        p = Prog_Comm_State.port
        IfCondition NotEqual(p, 0) ThenBlock: {
            ECU_Sys.Write(fd, p, ECU_Sys.Len(p))
        }
        ECU_Sys.Write(fd, "\n", 1)
        ECU_Sys.Close(fd)
        ReturnValue(0)
    }
}
