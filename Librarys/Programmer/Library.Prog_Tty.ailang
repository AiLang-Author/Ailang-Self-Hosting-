// Programmer.Tty — raw 8N1 serial. USB AVT 852 ignores baud; we still
// put the FTDI in raw mode. ioctl TCGETS/TCSETS like OS/Login.
//
// Copyright (c) 2026 Sean Collins, 2 Paws Machine and Engineering. All rights reserved.
// Licensed under the Sean Collins Software License (SCSL v1.0).

LibraryImport.Arena
LibraryImport.Ecu.ECU_Sys

FixedPool.Prog_Tty_State {
    "fd":   Initialize=-1, CanChange=True
    "tio":  Initialize=0, CanChange=True
    "ts":   Initialize=0, CanChange=True
    "one":  Initialize=0, CanChange=True
}

Function.Prog_Tty.Init {
    Output: Integer
    Body: {
        IfCondition EqualTo(Prog_Tty_State.tio, 0) ThenBlock: {
            Prog_Tty_State.tio = Allocate(64)
            Prog_Tty_State.ts = Allocate(16)
            Prog_Tty_State.one = Allocate(8)
        }
        ReturnValue(0)
    }
}

Function.Prog_Tty.PutU32 {
    Input: p: Address
    Input: off: Integer
    Input: v: Integer
    Output: Integer
    Body: {
        SetByte(p, off, BitwiseAnd(v, 255))
        SetByte(p, Add(off, 1), BitwiseAnd(Divide(v, 256), 255))
        SetByte(p, Add(off, 2), BitwiseAnd(Divide(v, 65536), 255))
        SetByte(p, Add(off, 3), BitwiseAnd(Divide(v, 16777216), 255))
        ReturnValue(0)
    }
}

Function.Prog_Tty.Raw {
    Input: fd: Integer
    Output: Integer
    Body: {
        tio = Prog_Tty_State.tio
        IfCondition EqualTo(tio, 0) ThenBlock: { ReturnValue(-1) }
        r = SystemCall(16, fd, 21505, tio)
        IfCondition LessThan(r, 0) ThenBlock: { ReturnValue(-1) }
        Prog_Tty.PutU32(tio, 0, 0)
        Prog_Tty.PutU32(tio, 4, 0)
        Prog_Tty.PutU32(tio, 12, 0)
        cflag = 7345
        Prog_Tty.PutU32(tio, 8, cflag)
        SetByte(tio, 22, 0)
        SetByte(tio, 23, 0)
        r = SystemCall(16, fd, 21506, tio)
        ReturnValue(r)
    }
}

Function.Prog_Tty.GetU32 {
    Input: p: Address
    Input: off: Integer
    Output: Integer
    Body: {
        b0 = GetByte(p, off)
        b1 = GetByte(p, Add(off, 1))
        b2 = GetByte(p, Add(off, 2))
        b3 = GetByte(p, Add(off, 3))
        ReturnValue(Add(b0, Add(Multiply(b1, 256), Add(Multiply(b2, 65536), Multiply(b3, 16777216)))))
    }
}

// 921600 = B921600 in c_cflag (Moates). 8192 uses BOTHER via TCSETS2.
Function.Prog_Tty.SetSpeed {
    Input: baud: Integer
    Output: Integer
    Body: {
        fd = Prog_Tty_State.fd
        IfCondition LessThan(fd, 0) ThenBlock: { ReturnValue(-1) }
        tio = Prog_Tty_State.tio
        r = SystemCall(16, fd, 21505, tio)
        IfCondition LessThan(r, 0) ThenBlock: { ReturnValue(-1) }
        Prog_Tty.PutU32(tio, 0, 0)
        Prog_Tty.PutU32(tio, 4, 0)
        Prog_Tty.PutU32(tio, 12, 0)
        cflag = 7345
        IfCondition EqualTo(baud, 921600) ThenBlock: { cflag = 6327 }
        IfCondition EqualTo(baud, 115200) ThenBlock: { cflag = 7345 }
        IfCondition EqualTo(baud, 8192) ThenBlock: { cflag = 6320 }
        Prog_Tty.PutU32(tio, 8, cflag)
        SetByte(tio, 22, 0)
        SetByte(tio, 23, 0)
        r = SystemCall(16, fd, 21506, tio)
        IfCondition EqualTo(baud, 8192) ThenBlock: {
            r = SystemCall(16, fd, 2150143018, tio)
            Prog_Tty.PutU32(tio, 8, 6320)
            Prog_Tty.PutU32(tio, 36, baud)
            Prog_Tty.PutU32(tio, 40, baud)
            r = SystemCall(16, fd, 1076655147, tio)
        }
        ReturnValue(r)
    }
}

Function.Prog_Tty.Open {
    Input: path: Address
    Output: Integer
    Body: {
        Prog_Tty.Init()
        IfCondition GreaterEqual(Prog_Tty_State.fd, 0) ThenBlock: {
            Prog_Tty.Close()
        }
        fd = ECU_Sys.Open(path, 258, 0)
        IfCondition LessThan(fd, 0) ThenBlock: { ReturnValue(-1) }
        Prog_Tty.Raw(fd)
        Prog_Tty_State.fd = fd
        ReturnValue(fd)
    }
}

Function.Prog_Tty.Fd {
    Output: Integer
    Body: {
        ReturnValue(Prog_Tty_State.fd)
    }
}

Function.Prog_Tty.Write {
    Input: buf: Address
    Input: n: Integer
    Output: Integer
    Body: {
        fd = Prog_Tty_State.fd
        IfCondition LessThan(fd, 0) ThenBlock: { ReturnValue(-1) }
        ReturnValue(ECU_Sys.Write(fd, buf, n))
    }
}

Function.Prog_Tty.Read {
    Input: buf: Address
    Input: n: Integer
    Output: Integer
    Body: {
        fd = Prog_Tty_State.fd
        IfCondition LessThan(fd, 0) ThenBlock: { ReturnValue(-1) }
        ReturnValue(ECU_Sys.Read(fd, buf, n))
    }
}

Function.Prog_Tty.WriteByte {
    Input: b: Integer
    Output: Integer
    Body: {
        SetByte(Prog_Tty_State.one, 0, BitwiseAnd(b, 255))
        ReturnValue(Prog_Tty.Write(Prog_Tty_State.one, 1))
    }
}

Function.Prog_Tty.ReadByte {
    Output: Integer
    Body: {
        n = Prog_Tty.Read(Prog_Tty_State.one, 1)
        IfCondition LessThan(n, 1) ThenBlock: { ReturnValue(-1) }
        ReturnValue(GetByte(Prog_Tty_State.one, 0))
    }
}

Function.Prog_Tty.Drain {
    Output: Integer
    Body: {
        buf = Allocate(64)
        k = 0
        WhileLoop LessThan(k, 32) {
            n = Prog_Tty.Read(buf, 64)
            IfCondition LessThan(n, 1) ThenBlock: { k = 32 }
            IfCondition GreaterEqual(n, 1) ThenBlock: { k = Add(k, 1) }
        }
        Deallocate(buf, 64)
        ReturnValue(0)
    }
}

Function.Prog_Tty.SleepMs {
    Input: ms: Integer
    Output: Integer
    Body: {
        ts = Prog_Tty_State.ts
        IfCondition EqualTo(ts, 0) ThenBlock: { ReturnValue(-1) }
        StoreValue(ts, 0)
        StoreValue(Add(ts, 8), Multiply(ms, 1000000))
        SystemCall(35, ts, 0)
        ReturnValue(0)
    }
}

Function.Prog_Tty.Close {
    Output: Integer
    Body: {
        fd = Prog_Tty_State.fd
        IfCondition GreaterEqual(fd, 0) ThenBlock: {
            ECU_Sys.Close(fd)
        }
        Prog_Tty_State.fd = -1
        ReturnValue(0)
    }
}
