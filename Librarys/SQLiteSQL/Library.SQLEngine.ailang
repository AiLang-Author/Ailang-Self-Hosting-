// Library.SQLEngine.ailang — statement dispatch.
// SubRoutine.SQL.Dispatch is the orchestrator. SQL.Exec and SQL.Query are the public entry points.
// Copyright (c) 2026 Sean Collins, 2 Paws Machine and Engineering. SCSL.

LibraryImport.SQLiteSQL.SQLSelect

Function.SQL.Blank {
    Input: tbl: Address
    Output: Address
    Body: {
        a = Array.Create(SQL.ColCount(tbl))
        i = 0
        WhileLoop LessThan(i, SQL.ColCount(tbl)) {
            Array.Push(a, SQL.Persist(SQL.Null()))
            i = Add(i, 1)
        }
        ReturnValue(a)
    }
}

Function.SQL.StoreAt {
    Input: tbl: Address
    Input: vals: Address
    Input: ix: Integer
    Input: v: Address
    Body: {
        got = SQL.Persist(SQL.ApplyAff(v, SQL.ColAff(SQL.ColAt(tbl, ix))))
        Array.Set(vals, ix, got)
    }
}

Function.SQL.FromExprs {
    Input: tbl: Address
    Input: cols: Address
    Input: exprs: Address
    Output: Address
    Body: {
        vals = SQL.Blank(tbl)
        IfCondition EqualTo(cols, 0) ThenBlock: {
            i = 0
            p = exprs
            WhileLoop NotEqual(p, 0) {
                IfCondition GreaterEqual(i, SQL.ColCount(tbl)) ThenBlock: {
                    SQL.Fail("values")
                    ReturnValue(vals)
                }
                SQL.StoreAt(tbl, vals, i, SQL.Eval(SQL.A(p)))
                i = Add(i, 1)
                p = SQL.B(p)
            }
            IfCondition NotEqual(i, SQL.ColCount(tbl)) ThenBlock: { SQL.Fail("values") }
            ReturnValue(vals)
        }
        c = cols
        p2 = exprs
        WhileLoop NotEqual(c, 0) {
            IfCondition EqualTo(p2, 0) ThenBlock: {
                SQL.Fail("values")
                ReturnValue(vals)
            }
            ix = SQL.ColIndex(tbl, SQL.A(SQL.A(c)))
            IfCondition LessThan(ix, 0) ThenBlock: {
                SQL.Fail("no such column")
                ReturnValue(vals)
            }
            SQL.StoreAt(tbl, vals, ix, SQL.Eval(SQL.A(p2)))
            c = SQL.B(c)
            p2 = SQL.B(p2)
        }
        IfCondition NotEqual(p2, 0) ThenBlock: { SQL.Fail("values") }
        ReturnValue(vals)
    }
}

Function.SQL.FromRow {
    Input: tbl: Address
    Input: cols: Address
    Input: src: Address
    Output: Address
    Body: {
        vals = SQL.Blank(tbl)
        IfCondition EqualTo(cols, 0) ThenBlock: {
            IfCondition NotEqual(Array.Size(src), SQL.ColCount(tbl)) ThenBlock: {
                SQL.Fail("values")
                ReturnValue(vals)
            }
            i = 0
            WhileLoop LessThan(i, SQL.ColCount(tbl)) {
                SQL.StoreAt(tbl, vals, i, Array.Get(src, i))
                i = Add(i, 1)
            }
            ReturnValue(vals)
        }
        c = cols
        i2 = 0
        WhileLoop NotEqual(c, 0) {
            IfCondition GreaterEqual(i2, Array.Size(src)) ThenBlock: {
                SQL.Fail("values")
                ReturnValue(vals)
            }
            ix = SQL.ColIndex(tbl, SQL.A(SQL.A(c)))
            IfCondition LessThan(ix, 0) ThenBlock: {
                SQL.Fail("no such column")
                ReturnValue(vals)
            }
            SQL.StoreAt(tbl, vals, ix, Array.Get(src, i2))
            c = SQL.B(c)
            i2 = Add(i2, 1)
        }
        ReturnValue(vals)
    }
}

Function.SQL.ListHas {
    Input: list: Address
    Input: nm: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(list, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(nm, 0) ThenBlock: { ReturnValue(0) }
        n = StringLength(list)
        want = StringLength(nm)
        i = 0
        start = 0
        WhileLoop LessEqual(i, n) {
            c = 0
            IfCondition LessThan(i, n) ThenBlock: { c = RDMEM_8(list, i) }
            IfCondition Or(EqualTo(i, n), EqualTo(c, 44)) ThenBlock: {
                ln = Subtract(i, start)
                IfCondition EqualTo(ln, want) ThenBlock: {
                    k = 0
                    same = 1
                    WhileLoop LessThan(k, ln) {
                        IfCondition NotEqual(RDMEM_8(list, Add(start, k)), RDMEM_8(nm, k)) ThenBlock: { same = 0 }
                        k = Add(k, 1)
                    }
                    IfCondition EqualTo(same, 1) ThenBlock: { ReturnValue(1) }
                }
                start = Add(i, 1)
            }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

Function.SQL.OfHit {
    Input: ofc: Address
    Input: sets: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(ofc, 0) ThenBlock: { ReturnValue(1) }
        p = sets
        WhileLoop NotEqual(p, 0) {
            IfCondition EqualTo(SQL.ListHas(ofc, SQL.A(p)), 1) ThenBlock: { ReturnValue(1) }
            p = SQL.C(p)
        }
        ReturnValue(0)
    }
}

Function.SQL.TrigOn {
    Input: tname: Address
    Input: event: Integer
    Input: timing: Integer
    Output: Integer
    Body: {
        old = SQLS.idxlist
        i = 0
        n = Array.Size(old)
        WhileLoop LessThan(i, n) {
            rec = Array.Get(old, i)
            nm = RDMEM_64(rec)
            IfCondition NotEqual(SQL.FindTrig(nm), 0) ThenBlock: {
                tb = RDMEM_64(rec, 8)
                IfCondition And(EqualTo(SQL.EqStr(tb, tname), 1), And(EqualTo(RDMEM_64(rec, 16), event), EqualTo(RDMEM_64(rec, 24), timing))) ThenBlock: {
                    ReturnValue(1)
                }
            }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

Function.SQL.EvalText {
    Input: sql: Address
    Output: Address
    Body: {
        s1 = SQLS.src
        n1 = SQLS.slen
        p1 = SQLS.pos
        k1 = SQLS.tok
        x1 = SQLS.ttext
        a1 = SQLS.tnum
        b1 = SQLS.treal
        c1 = SQLS.tfloat
        d1 = SQLS.tlen
        cu = SQLS.cur
        SQL.LexStart(sql, StringLength(sql))
        e = SQL.ParseExpr()
        v = SQL.Null()
        IfCondition EqualTo(SQLS.err, 0) ThenBlock: { v = SQL.Eval(e) }
        SQLS.src = s1
        SQLS.slen = n1
        SQLS.pos = p1
        SQLS.tok = k1
        SQLS.ttext = x1
        SQLS.tnum = a1
        SQLS.treal = b1
        SQLS.tfloat = c1
        SQLS.tlen = d1
        SQLS.cur = cu
        ReturnValue(v)
    }
}

Function.SQL.ExecText {
    Input: body: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(body, 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringLength(body), 0) ThenBlock: { ReturnValue(1) }
        s1 = SQLS.src
        n1 = SQLS.slen
        p1 = SQLS.pos
        k1 = SQLS.tok
        x1 = SQLS.ttext
        a1 = SQLS.tnum
        b1 = SQLS.treal
        c1 = SQLS.tfloat
        d1 = SQLS.tlen
        sc = SQLS.scope
        rw = SQLS.rows
        on = SQLS.onames
        dp = SQLS.depth
        ou = SQLS.outer
        gr = SQLS.group
        cu = SQLS.cur
        SQL.LexStart(body, StringLength(body))
        WhileLoop EqualTo(SQLS.err, 0) {
            IfCondition EqualTo(SQLS.tok, SQLT.EOF) ThenBlock: { BreakLoop }
            IfCondition EqualTo(SQLS.tok, SQLT.SEMI) ThenBlock: {
                SQL.LexNext()
            } ElseBlock: {
                st = SQL.ParseStmt()
                IfCondition EqualTo(SQLS.err, 0) ThenBlock: {
                    SQLS.cur = st
                    SQL.Dispatch()
                    IfCondition EqualTo(SQLS.err, 0) ThenBlock: { SQL.Accept(SQLT.SEMI) }
                }
            }
        }
        bad = SQLS.err
        SQLS.src = s1
        SQLS.slen = n1
        SQLS.pos = p1
        SQLS.tok = k1
        SQLS.ttext = x1
        SQLS.tnum = a1
        SQLS.treal = b1
        SQLS.tfloat = c1
        SQLS.tlen = d1
        SQLS.scope = sc
        SQLS.rows = rw
        SQLS.onames = on
        SQLS.depth = dp
        SQLS.outer = ou
        SQLS.group = gr
        SQLS.cur = cu
        IfCondition NotEqual(bad, 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(1)
    }
}

// event: 1 insert, 2 update, 3 delete. timing: 0 before, 1 after, 2 instead.
Function.SQL.Fire {
    Input: tname: Address
    Input: event: Integer
    Input: timing: Integer
    Input: oldv: Address
    Input: newv: Address
    Input: sets: Address
    Output: Integer
    Body: {
        IfCondition NotEqual(SQLS.infire, 0) ThenBlock: { ReturnValue(1) }
        SQLS.infire = 1
        saved = SQLS.scope
        list = SQLS.idxlist
        i = 0
        n = Array.Size(list)
        WhileLoop And(LessThan(i, n), EqualTo(SQLS.err, 0)) {
            rec = Array.Get(list, i)
            nm = RDMEM_64(rec)
            IfCondition NotEqual(SQL.FindTrig(nm), 0) ThenBlock: {
                tb = RDMEM_64(rec, 8)
                IfCondition And(EqualTo(SQL.EqStr(tb, tname), 1), And(EqualTo(RDMEM_64(rec, 16), event), EqualTo(RDMEM_64(rec, 24), timing))) ThenBlock: {
                    run = 1
                    ofc = RDMEM_64(rec, 48)
                    IfCondition NotEqual(ofc, 0) ThenBlock: {
                        IfCondition EqualTo(SQL.OfHit(ofc, sets), 0) ThenBlock: { run = 0 }
                    }
                    IfCondition EqualTo(run, 1) ThenBlock: {
                        b = SQL.BindEmpty()
                        tbl = SQL.FindTab(tname)
                        IfCondition NotEqual(tbl, 0) ThenBlock: {
                            names = SQL.TabNames(tbl)
                            IfCondition NotEqual(oldv, 0) ThenBlock: {
                                fr = SQL.Frame(names, oldv, "old", "old", tbl, 0)
                                WRMEM_64(fr, 48, 1)
                                b = SQL.BindAdd(b, fr)
                            }
                            IfCondition NotEqual(newv, 0) ThenBlock: {
                                fr2 = SQL.Frame(names, newv, "new", "new", tbl, 0)
                                WRMEM_64(fr2, 48, 1)
                                b = SQL.BindAdd(b, fr2)
                            }
                        }
                        SQLS.scope = b
                        go = 1
                        wh = RDMEM_64(rec, 40)
                        IfCondition NotEqual(wh, 0) ThenBlock: {
                            IfCondition GreaterThan(StringLength(wh), 0) ThenBlock: {
                                tv = SQL.EvalText(wh)
                                IfCondition EqualTo(SQLS.err, 0) ThenBlock: {
                                    IfCondition EqualTo(SQL.Truth(tv), 0) ThenBlock: { go = 0 }
                                }
                            }
                        }
                        IfCondition And(EqualTo(go, 1), EqualTo(SQLS.err, 0)) ThenBlock: {
                            SQL.ExecText(RDMEM_64(rec, 32))
                        }
                    }
                }
            }
            i = Add(i, 1)
        }
        SQLS.scope = saved
        SQLS.infire = 0
        IfCondition NotEqual(SQLS.err, 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(1)
    }
}

Function.SQL.DoInsert {
    Input: n: Address
    Output: Integer
    Body: {
        nm = SQL.A(n)
        IfCondition NotEqual(SQL.FindView(nm), 0) ThenBlock: {
            IfCondition EqualTo(SQL.TrigOn(nm, 1, 2), 0) ThenBlock: {
                SQL.Fail("view")
                ReturnValue(0)
            }
            ReturnValue(SQL.Fire(nm, 1, 2, 0, 0, 0))
        }
        tbl = SQL.FindTab(nm)
        IfCondition EqualTo(tbl, 0) ThenBlock: {
            SQL.Fail("no such table")
            ReturnValue(0)
        }
        mode = SQL.Flags(n)
        IfCondition EqualTo(SQL.D(n), 1) ThenBlock: {
            rs = SQL.RunSelect(SQL.C(n))
            i = 0
            WhileLoop LessThan(i, Array.Size(rs)) {
                vals = SQL.FromRow(tbl, SQL.B(n), Array.Get(rs, i))
                IfCondition NotEqual(SQLS.err, 0) ThenBlock: { ReturnValue(0) }
                IfCondition EqualTo(SQL.Fire(nm, 1, 0, 0, vals, 0), 0) ThenBlock: { ReturnValue(0) }
                IfCondition EqualTo(SQL.PutRow(tbl, vals, mode), 0) ThenBlock: { ReturnValue(0) }
                IfCondition EqualTo(SQL.Fire(nm, 1, 1, 0, vals, 0), 0) ThenBlock: { ReturnValue(0) }
                i = Add(i, 1)
            }
            ReturnValue(1)
        }
        p = SQL.C(n)
        WhileLoop NotEqual(p, 0) {
            vals2 = SQL.FromExprs(tbl, SQL.B(n), SQL.A(p))
            IfCondition NotEqual(SQLS.err, 0) ThenBlock: { ReturnValue(0) }
            IfCondition EqualTo(SQL.Fire(nm, 1, 0, 0, vals2, 0), 0) ThenBlock: { ReturnValue(0) }
            IfCondition EqualTo(SQL.PutRow(tbl, vals2, mode), 0) ThenBlock: { ReturnValue(0) }
            IfCondition EqualTo(SQL.Fire(nm, 1, 1, 0, vals2, 0), 0) ThenBlock: { ReturnValue(0) }
            p = SQL.B(p)
        }
        ReturnValue(1)
    }
}

Function.SQL.CopyVals {
    Input: row: Address
    Output: Address
    Body: {
        a = Array.Create(Array.Size(row))
        i = 0
        WhileLoop LessThan(i, Array.Size(row)) {
            Array.Push(a, Array.Get(row, i))
            i = Add(i, 1)
        }
        ReturnValue(a)
    }
}

Function.SQL.DoUpdate {
    Input: n: Address
    Output: Integer
    Body: {
        nm = SQL.A(n)
        IfCondition NotEqual(SQL.FindView(nm), 0) ThenBlock: {
            IfCondition EqualTo(SQL.TrigOn(nm, 2, 2), 0) ThenBlock: {
                SQL.Fail("view")
                ReturnValue(0)
            }
            ReturnValue(SQL.Fire(nm, 2, 2, 0, 0, SQL.B(n)))
        }
        tbl = SQL.FindTab(nm)
        IfCondition EqualTo(tbl, 0) ThenBlock: {
            SQL.Fail("no such table")
            ReturnValue(0)
        }
        nr = SQL.NRows(tbl)
        cell = SQL.Bump(24)
        IfCondition EqualTo(cell, 0) ThenBlock: { ReturnValue(0) }
        prevO = SQLS.outer
        prevS = SQLS.scope
        WRMEM_64(cell, prevS)
        WRMEM_64(cell, 8, prevO)
        WRMEM_64(cell, 16, SQLS.depth)
        SQLS.outer = cell
        ok = 1
        i = 0
        WhileLoop And(LessThan(i, nr), EqualTo(ok, 1)) {
            fr = SQL.Frame(SQL.TabNames(tbl), SQL.RowAt(tbl, i), nm, nm, tbl, SQL.RowidAt(tbl, i))
            SQLS.scope = SQL.BindAdd(SQL.BindEmpty(), fr)
            hit = 1
            IfCondition NotEqual(SQL.C(n), 0) ThenBlock: { hit = SQL.Truth(SQL.Eval(SQL.C(n))) }
            IfCondition NotEqual(SQLS.err, 0) ThenBlock: { ok = 0 }
            IfCondition And(EqualTo(hit, 1), EqualTo(ok, 1)) ThenBlock: {
                vals = SQL.CopyVals(SQL.RowAt(tbl, i))
                asg = SQL.B(n)
                WhileLoop And(NotEqual(asg, 0), EqualTo(ok, 1)) {
                    ix = SQL.ColIndex(tbl, SQL.A(asg))
                    IfCondition LessThan(ix, 0) ThenBlock: {
                        SQL.Fail("no such column")
                        ok = 0
                    }
                    IfCondition EqualTo(ok, 1) ThenBlock: {
                        SQL.StoreAt(tbl, vals, ix, SQL.Eval(SQL.B(asg)))
                        IfCondition NotEqual(SQLS.err, 0) ThenBlock: { ok = 0 }
                        asg = SQL.C(asg)
                    }
                }
                IfCondition EqualTo(ok, 1) ThenBlock: {
                    ipk = SQL.TabIpk(tbl)
                    IfCondition And(GreaterEqual(ipk, 0), EqualTo(SQL.IsNull(Array.Get(vals, ipk)), 1)) ThenBlock: {
                        SQL.Fail("not null")
                        ok = 0
                    }
                    IfCondition EqualTo(ok, 1) ThenBlock: {
                        conf = SQL.Conflicts(tbl, vals, i)
                        IfCondition GreaterThan(Array.Size(conf), 0) ThenBlock: {
                            SQL.Fail("constraint")
                            ok = 0
                        }
                    }
                    IfCondition EqualTo(ok, 1) ThenBlock: {
                        old = SQL.RowAt(tbl, i)
                        IfCondition EqualTo(SQL.Fire(nm, 2, 0, old, vals, SQL.B(n)), 0) ThenBlock: { ok = 0 }
                        IfCondition EqualTo(ok, 1) ThenBlock: {
                            Array.Set(SQL.TabRows(tbl), i, vals)
                            rid = SQL.RowidAt(tbl, i)
                            IfCondition GreaterEqual(ipk, 0) ThenBlock: { rid = SQL.VBits(Array.Get(vals, ipk)) }
                            Array.Set(SQL.TabRowids(tbl), i, rid)
                            IfCondition EqualTo(SQL.Fire(nm, 2, 1, old, vals, SQL.B(n)), 0) ThenBlock: { ok = 0 }
                        }
                    }
                }
            }
            IfCondition EqualTo(ok, 1) ThenBlock: { i = Add(i, 1) }
        }
        SQLS.outer = prevO
        SQLS.scope = prevS
        IfCondition EqualTo(ok, 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(1)
    }
}

Function.SQL.DoDelete {
    Input: n: Address
    Output: Integer
    Body: {
        nm = SQL.A(n)
        IfCondition NotEqual(SQL.FindView(nm), 0) ThenBlock: {
            IfCondition EqualTo(SQL.TrigOn(nm, 3, 2), 0) ThenBlock: {
                SQL.Fail("view")
                ReturnValue(0)
            }
            ReturnValue(SQL.Fire(nm, 3, 2, 0, 0, 0))
        }
        tbl = SQL.FindTab(nm)
        IfCondition EqualTo(tbl, 0) ThenBlock: {
            SQL.Fail("no such table")
            ReturnValue(0)
        }
        keepR = Array.Create(8)
        keepI = Array.Create(8)
        dropR = Array.Create(8)
        cell = SQL.Bump(24)
        IfCondition EqualTo(cell, 0) ThenBlock: { ReturnValue(0) }
        prevO = SQLS.outer
        prevS = SQLS.scope
        WRMEM_64(cell, prevS)
        WRMEM_64(cell, 8, prevO)
        WRMEM_64(cell, 16, SQLS.depth)
        SQLS.outer = cell
        ok = 1
        i = 0
        nr = SQL.NRows(tbl)
        WhileLoop And(LessThan(i, nr), EqualTo(ok, 1)) {
            row = SQL.RowAt(tbl, i)
            fr = SQL.Frame(SQL.TabNames(tbl), row, nm, nm, tbl, SQL.RowidAt(tbl, i))
            SQLS.scope = SQL.BindAdd(SQL.BindEmpty(), fr)
            drop = 1
            IfCondition NotEqual(SQL.B(n), 0) ThenBlock: { drop = SQL.Truth(SQL.Eval(SQL.B(n))) }
            IfCondition NotEqual(SQLS.err, 0) ThenBlock: { ok = 0 }
            IfCondition EqualTo(ok, 1) ThenBlock: {
                IfCondition EqualTo(drop, 0) ThenBlock: {
                    Array.Push(keepR, row)
                    Array.Push(keepI, SQL.RowidAt(tbl, i))
                } ElseBlock: {
                    IfCondition EqualTo(SQL.Fire(nm, 3, 0, row, 0, 0), 0) ThenBlock: { ok = 0 }
                    IfCondition EqualTo(ok, 1) ThenBlock: { Array.Push(dropR, row) }
                }
            }
            IfCondition EqualTo(ok, 1) ThenBlock: { i = Add(i, 1) }
        }
        IfCondition EqualTo(ok, 1) ThenBlock: {
            WRMEM_64(tbl, 24, keepR)
            WRMEM_64(tbl, 32, keepI)
            j = 0
            WhileLoop And(LessThan(j, Array.Size(dropR)), EqualTo(ok, 1)) {
                IfCondition EqualTo(SQL.Fire(nm, 3, 1, Array.Get(dropR, j), 0, 0), 0) ThenBlock: { ok = 0 }
                IfCondition EqualTo(ok, 1) ThenBlock: { j = Add(j, 1) }
            }
        }
        SQLS.outer = prevO
        SQLS.scope = prevS
        IfCondition EqualTo(ok, 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(1)
    }
}

SubRoutine.SQL.Dispatch {
    k = SQL.Kind(SQLS.cur)
    IfCondition EqualTo(k, SQLK.SELECT) ThenBlock: { SQL.RunSelect(SQLS.cur) }
    IfCondition EqualTo(k, SQLK.LIM) ThenBlock: { SQL.RunSelect(SQLS.cur) }
    IfCondition EqualTo(k, SQLK.CTAB) ThenBlock: { SQL.DoCreateTable(SQLS.cur) }
    IfCondition EqualTo(k, SQLK.CIDX) ThenBlock: { SQL.DoCreateIndex(SQLS.cur) }
    IfCondition EqualTo(k, SQLK.CVIEW) ThenBlock: { SQL.DoCreateView(SQLS.cur) }
    IfCondition EqualTo(k, SQLK.CTRIG) ThenBlock: { SQL.DoCreateTrig(SQLS.cur) }
    IfCondition EqualTo(k, SQLK.DROP) ThenBlock: { SQL.DoDrop(SQLS.cur) }
    IfCondition EqualTo(k, SQLK.INSERT) ThenBlock: { SQL.DoInsert(SQLS.cur) }
    IfCondition EqualTo(k, SQLK.UPDATE) ThenBlock: { SQL.DoUpdate(SQLS.cur) }
    IfCondition EqualTo(k, SQLK.DELETE) ThenBlock: { SQL.DoDelete(SQLS.cur) }
    IfCondition EqualTo(k, SQLK.REIDX) ThenBlock: { SQL.DoReindex(SQLS.cur) }
    IfCondition EqualTo(SQL.Kind(SQLS.cur), 0) ThenBlock: { SQL.Fail("statement") }
}

Function.SQL.DoReindex {
    Input: n: Address
    Output: Integer
    Body: {
        nm = SQL.HName(SQL.A(n))
        IfCondition NotEqual(SQL.FindIdx(nm), 0) ThenBlock: { ReturnValue(1) }
        IfCondition NotEqual(SQL.FindTab(nm), 0) ThenBlock: { ReturnValue(1) }
        SQL.Fail("no such index")
        ReturnValue(0)
    }
}

Function.SQL.Exec {
    Input: s: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(SQLS.ready, 0) ThenBlock: { SQL.Boot() }
        SQL.Reset()
        SQLS.rows = Array.Create(4)
        // A query's column count is this statement's output names.
        // Clear the previous statement so a non-select cannot reuse them.
        SQLS.onames = 0
        SQL.LexStart(s, StringLength(s))
        WhileLoop EqualTo(SQLS.err, 0) {
            IfCondition EqualTo(SQLS.tok, SQLT.EOF) ThenBlock: { BreakLoop }
            IfCondition EqualTo(SQLS.tok, SQLT.SEMI) ThenBlock: {
                SQL.LexNext()
            } ElseBlock: {
                n = SQL.ParseStmt()
                IfCondition NotEqual(SQLS.err, 0) ThenBlock: { ReturnValue(0) }
                SQLS.cur = n
                SQL.Dispatch()
                IfCondition NotEqual(SQLS.err, 0) ThenBlock: { ReturnValue(0) }
                SQL.Accept(SQLT.SEMI)
            }
        }
        IfCondition NotEqual(SQLS.err, 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(1)
    }
}

Function.SQL.Query {
    Input: s: Address
    Output: Address
    Body: {
        IfCondition EqualTo(SQL.Exec(s), 0) ThenBlock: { ReturnValue(Array.Create(1)) }
        ReturnValue(SQLS.rows)
    }
}
