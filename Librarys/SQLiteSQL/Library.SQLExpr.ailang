// Library.SQLExpr.ailang — one function per expression operation.
// SQL.Eval is the expression orchestrator. Statement dispatch lives in SQLEngine.
// Copyright (c) 2026 Sean Collins, 2 Paws Machine and Engineering. SCSL.

LibraryImport.SQLiteSQL.SQLStore
LibraryImport.SQLiteSQL.SQLSelect

Function.SQL.Frame {
    Input: names: Address
    Input: vals: Address
    Input: alias: Address
    Input: tname: Address
    Input: tbl: Address
    Input: rowid: Integer
    Output: Address
    Body: {
        p = SQL.Bump(56)
        IfCondition EqualTo(p, 0) ThenBlock: { ReturnValue(0) }
        WRMEM_64(p, names)
        WRMEM_64(p, 8, vals)
        WRMEM_64(p, 16, alias)
        WRMEM_64(p, 24, tname)
        WRMEM_64(p, 32, tbl)
        WRMEM_64(p, 40, rowid)
        ReturnValue(p)
    }
}

Function.SQL.BindEmpty {
    Output: Address
    Body: { ReturnValue(Array.Create(4)) }
}

Function.SQL.BindAdd {
    Input: b: Address
    Input: fr: Address
    Output: Address
    Body: {
        n = Array.Create(Add(Array.Size(b), 1))
        i = 0
        WhileLoop LessThan(i, Array.Size(b)) {
            Array.Push(n, Array.Get(b, i))
            i = Add(i, 1)
        }
        Array.Push(n, fr)
        ReturnValue(n)
    }
}

Function.SQL.IsRowidName {
    Input: s: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(SQL.EqStr(s, "rowid"), 1) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(SQL.EqStr(s, "oid"), 1) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(SQL.EqStr(s, "_rowid_"), 1) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

// Slot +48 is 1 for NEW/OLD frames. Those match only a qualified name.
Function.SQL.BareSkip {
    Input: fr: Address
    Input: qual: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(RDMEM_64(fr, 48), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(qual, 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringLength(qual), 0) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

Function.SQL.QualOk {
    Input: fr: Address
    Input: qual: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(qual, 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(StringLength(qual), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(SQL.EqStr(qual, RDMEM_64(fr, 16)), 1) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(SQL.EqStr(qual, RDMEM_64(fr, 24)), 1) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

Function.SQL.ScanInto {
    Input: bind: Address
    Body: {
        st = 0
        val = 0
        IfCondition EqualTo(bind, 0) ThenBlock: {
            WRMEM_64(SQLS.scratch, 0)
            WRMEM_64(SQLS.scratch, 8, 0)
            ReturnValue(0)
        }
        nm = RDMEM_64(SQLS.scratch, 8)
        qual = RDMEM_64(SQLS.scratch)
        i = 0
        n = Array.Size(bind)
        WhileLoop LessThan(i, n) {
            fr = Array.Get(bind, i)
            IfCondition And(EqualTo(SQL.BareSkip(fr, qual), 0), EqualTo(SQL.QualOk(fr, qual), 1)) ThenBlock: {
                names = RDMEM_64(fr)
                c = 0
                cn = Array.Size(names)
                WhileLoop LessThan(c, cn) {
                    IfCondition EqualTo(SQL.EqStr(Array.Get(names, c), nm), 1) ThenBlock: {
                        IfCondition EqualTo(st, 0) ThenBlock: {
                            st = 1
                            val = Array.Get(RDMEM_64(fr, 8), c)
                        } ElseBlock: {
                            st = 2
                        }
                    }
                    c = Add(c, 1)
                }
            }
            i = Add(i, 1)
        }
        IfCondition EqualTo(st, 0) ThenBlock: {
            IfCondition EqualTo(SQL.IsRowidName(nm), 1) ThenBlock: {
                j = 0
                WhileLoop LessThan(j, n) {
                    fr2 = Array.Get(bind, j)
                    IfCondition And(EqualTo(SQL.BareSkip(fr2, qual), 0), And(EqualTo(SQL.QualOk(fr2, qual), 1), NotEqual(RDMEM_64(fr2, 32), 0))) ThenBlock: {
                        IfCondition EqualTo(st, 0) ThenBlock: {
                            st = 1
                            val = SQL.Int(RDMEM_64(fr2, 40))
                        } ElseBlock: {
                            st = 2
                        }
                    }
                    j = Add(j, 1)
                }
            }
        }
        WRMEM_64(SQLS.scratch, st)
        WRMEM_64(SQLS.scratch, 8, val)
    }
}

Function.SQL.Lookup {
    Input: name: Address
    Input: qual: Address
    Output: Address
    Body: {
        WRMEM_64(SQLS.scratch, qual)
        WRMEM_64(SQLS.scratch, 8, name)
        SQL.ScanInto(SQLS.scope)
        st = RDMEM_64(SQLS.scratch)
        val = RDMEM_64(SQLS.scratch, 8)
        IfCondition EqualTo(st, 2) ThenBlock: {
            SQL.Fail("ambiguous column")
            ReturnValue(0)
        }
        IfCondition EqualTo(st, 1) ThenBlock: { ReturnValue(val) }
        cell = SQLS.outer
        WhileLoop NotEqual(cell, 0) {
            WRMEM_64(SQLS.scratch, qual)
            WRMEM_64(SQLS.scratch, 8, name)
            SQL.ScanInto(RDMEM_64(cell))
            st = RDMEM_64(SQLS.scratch)
            val = RDMEM_64(SQLS.scratch, 8)
            IfCondition EqualTo(st, 2) ThenBlock: {
                SQL.Fail("ambiguous column")
                ReturnValue(0)
            }
            IfCondition EqualTo(st, 1) ThenBlock: {
                lv = RDMEM_64(cell, 16)
                IfCondition LessThan(lv, SQLS.minouter) ThenBlock: { SQLS.minouter = lv }
                ReturnValue(val)
            }
            cell = RDMEM_64(cell, 8)
        }
        ReturnValue(0)
    }
}

Function.SQL.CanSee {
    Input: name: Address
    Input: qual: Address
    Output: Integer
    Body: {
        v = SQL.Lookup(name, qual)
        IfCondition NotEqual(SQLS.err, 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(v, 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(1)
    }
}

Function.SQL.Ready {
    Input: n: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(n, 0) ThenBlock: { ReturnValue(1) }
        k = SQL.Kind(n)
        IfCondition EqualTo(k, SQLK.COL) ThenBlock: { ReturnValue(SQL.CanSee(SQL.B(n), SQL.A(n))) }
        IfCondition Or(EqualTo(k, SQLK.SELECT), EqualTo(k, SQLK.EXISTS)) ThenBlock: { ReturnValue(1) }
        IfCondition Or(EqualTo(k, SQLK.INT), Or(EqualTo(k, SQLK.REAL), Or(EqualTo(k, SQLK.TEXT), Or(EqualTo(k, SQLK.BLOB), EqualTo(k, SQLK.NULL))))) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(k, SQLK.BIN) ThenBlock: {
            IfCondition EqualTo(SQL.Ready(SQL.A(n)), 0) ThenBlock: { ReturnValue(0) }
            IfCondition EqualTo(SQL.Ready(SQL.B(n)), 0) ThenBlock: { ReturnValue(0) }
            ReturnValue(SQL.Ready(SQL.C(n)))
        }
        IfCondition Or(EqualTo(k, SQLK.UN), EqualTo(k, SQLK.CAST)) ThenBlock: { ReturnValue(SQL.Ready(SQL.A(n))) }
        IfCondition Or(EqualTo(k, SQLK.IS), EqualTo(k, SQLK.IN)) ThenBlock: {
            IfCondition EqualTo(SQL.Ready(SQL.A(n)), 0) ThenBlock: { ReturnValue(0) }
            IfCondition EqualTo(SQL.C(n), 1) ThenBlock: { ReturnValue(1) }
            ReturnValue(SQL.Ready(SQL.B(n)))
        }
        IfCondition EqualTo(k, SQLK.BETWEEN) ThenBlock: {
            IfCondition EqualTo(SQL.Ready(SQL.A(n)), 0) ThenBlock: { ReturnValue(0) }
            IfCondition EqualTo(SQL.Ready(SQL.B(n)), 0) ThenBlock: { ReturnValue(0) }
            ReturnValue(SQL.Ready(SQL.C(n)))
        }
        IfCondition EqualTo(k, SQLK.LIST) ThenBlock: {
            IfCondition EqualTo(SQL.Ready(SQL.A(n)), 0) ThenBlock: { ReturnValue(0) }
            ReturnValue(SQL.Ready(SQL.B(n)))
        }
        IfCondition EqualTo(k, SQLK.CALL) ThenBlock: { ReturnValue(SQL.Ready(SQL.B(n))) }
        IfCondition EqualTo(k, SQLK.CASE) ThenBlock: {
            IfCondition EqualTo(SQL.Ready(SQL.A(n)), 0) ThenBlock: { ReturnValue(0) }
            IfCondition EqualTo(SQL.Ready(SQL.B(n)), 0) ThenBlock: { ReturnValue(0) }
            ReturnValue(SQL.Ready(SQL.C(n)))
        }
        IfCondition EqualTo(k, SQLK.WHEN) ThenBlock: {
            IfCondition EqualTo(SQL.Ready(SQL.A(n)), 0) ThenBlock: { ReturnValue(0) }
            IfCondition EqualTo(SQL.Ready(SQL.B(n)), 0) ThenBlock: { ReturnValue(0) }
            ReturnValue(SQL.Ready(SQL.C(n)))
        }
        ReturnValue(1)
    }
}

Function.SQL.SplitAnd {
    Input: n: Address
    Input: arr: Address
    Body: {
        IfCondition EqualTo(n, 0) ThenBlock: { ReturnValue(0) }
        IfCondition And(EqualTo(SQL.Kind(n), SQLK.BIN), EqualTo(SQL.Flags(n), SQLB.AND)) ThenBlock: {
            SQL.SplitAnd(SQL.A(n), arr)
            SQL.SplitAnd(SQL.B(n), arr)
            ReturnValue(0)
        }
        Array.Push(arr, n)
    }
}

Function.SQL.NumAff {
    Input: a: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(a, SQLA.INT) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(a, SQLA.REAL) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(a, SQLA.NUM) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

Function.SQL.LookupAff {
    Input: name: Address
    Input: qual: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(SQLS.scope, 0) ThenBlock: { ReturnValue(SQLA.NONE) }
        i = 0
        n = Array.Size(SQLS.scope)
        hit = 0
        aff = SQLA.NONE
        WhileLoop LessThan(i, n) {
            fr = Array.Get(SQLS.scope, i)
            IfCondition And(EqualTo(SQL.BareSkip(fr, qual), 0), EqualTo(SQL.QualOk(fr, qual), 1)) ThenBlock: {
                names = RDMEM_64(fr)
                c = 0
                WhileLoop LessThan(c, Array.Size(names)) {
                    IfCondition EqualTo(SQL.EqStr(Array.Get(names, c), name), 1) ThenBlock: {
                        tbl = RDMEM_64(fr, 32)
                        IfCondition NotEqual(tbl, 0) ThenBlock: { aff = SQL.ColAff(SQL.ColAt(tbl, c)) }
                        hit = 1
                    }
                    c = Add(c, 1)
                }
            }
            i = Add(i, 1)
        }
        IfCondition EqualTo(hit, 1) ThenBlock: { ReturnValue(aff) }
        ReturnValue(SQLA.NONE)
    }
}

Function.SQL.AffOf {
    Input: n: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(n, 0) ThenBlock: { ReturnValue(SQLA.NONE) }
        k = SQL.Kind(n)
        IfCondition EqualTo(k, SQLK.COL) ThenBlock: { ReturnValue(SQL.LookupAff(SQL.B(n), SQL.A(n))) }
        IfCondition EqualTo(k, SQLK.CAST) ThenBlock: { ReturnValue(SQL.Flags(n)) }
        ReturnValue(SQLA.NONE)
    }
}

Function.SQL.CmpAff {
    Input: x: Address
    Input: ax: Integer
    Input: y: Address
    Input: ay: Integer
    Output: Integer
    Body: {
        IfCondition Or(EqualTo(SQL.IsNull(x), 1), EqualTo(SQL.IsNull(y), 1)) ThenBlock: { ReturnValue(-2) }
        xx = x
        yy = y
        IfCondition And(EqualTo(SQL.NumAff(ax), 1), Or(EqualTo(ay, SQLA.TEXT), EqualTo(ay, SQLA.NONE))) ThenBlock: {
            yy = SQL.ApplyAff(y, SQLA.NUM)
        }
        IfCondition And(EqualTo(SQL.NumAff(ay), 1), Or(EqualTo(ax, SQLA.TEXT), EqualTo(ax, SQLA.NONE))) ThenBlock: {
            xx = SQL.ApplyAff(x, SQLA.NUM)
        }
        IfCondition And(EqualTo(ax, SQLA.TEXT), EqualTo(ay, SQLA.NONE)) ThenBlock: {
            yy = SQL.ApplyAff(y, SQLA.TEXT)
        }
        IfCondition And(EqualTo(ay, SQLA.TEXT), EqualTo(ax, SQLA.NONE)) ThenBlock: {
            xx = SQL.ApplyAff(x, SQLA.TEXT)
        }
        ReturnValue(SQL.Cmp3(xx, yy))
    }
}

Function.SQL.AsText {
    Input: v: Address
    Output: Address
    Body: {
        IfCondition EqualTo(SQL.IsNull(v), 1) ThenBlock: { ReturnValue(0) }
        t = SQL.VTag(v)
        IfCondition Or(EqualTo(t, SQLV.TEXT), EqualTo(t, SQLV.BLOB)) ThenBlock: { ReturnValue(SQL.VTxt(v)) }
        IfCondition EqualTo(t, SQLV.INT) ThenBlock: { ReturnValue(SQL.IntText(SQL.VBits(v))) }
        ReturnValue(SQL.FormatR(SQL.Real(SQL.VBits(v))))
    }
}

Function.SQL.Concat {
    Input: x: Address
    Input: y: Address
    Output: Address
    Body: {
        IfCondition Or(EqualTo(SQL.IsNull(x), 1), EqualTo(SQL.IsNull(y), 1)) ThenBlock: { ReturnValue(SQL.Null()) }
        ReturnValue(SQL.Text(StringConcat(SQL.AsText(x), SQL.AsText(y))))
    }
}

Function.SQL.LowByte {
    Input: c: Integer
    Output: Integer
    Body: {
        IfCondition And(GreaterEqual(c, 65), LessEqual(c, 90)) ThenBlock: { ReturnValue(Add(c, 32)) }
        ReturnValue(c)
    }
}

Function.SQL.LikeAt {
    Input: s: Address
    Input: si: Integer
    Input: p: Address
    Input: pi: Integer
    Input: esc: Integer
    Output: Integer
    Body: {
        sl = StringLength(s)
        pl = StringLength(p)
        WhileLoop LessThan(pi, pl) {
            raw = RDMEM_8(p, pi)
            IfCondition And(NotEqual(esc, 0), EqualTo(raw, esc)) ThenBlock: {
                pi = Add(pi, 1)
                IfCondition GreaterEqual(pi, pl) ThenBlock: {
                    IfCondition EqualTo(si, sl) ThenBlock: { ReturnValue(1) }
                    ReturnValue(0)
                }
                IfCondition GreaterEqual(si, sl) ThenBlock: { ReturnValue(0) }
                lit = SQL.LowByte(RDMEM_8(p, pi))
                IfCondition NotEqual(SQL.LowByte(RDMEM_8(s, si)), lit) ThenBlock: { ReturnValue(0) }
                si = Add(si, 1)
                pi = Add(pi, 1)
            } ElseBlock: {
                pc = SQL.LowByte(raw)
                IfCondition EqualTo(pc, 37) ThenBlock: {
                    IfCondition EqualTo(Add(pi, 1), pl) ThenBlock: { ReturnValue(1) }
                    k = si
                    WhileLoop LessEqual(k, sl) {
                        IfCondition EqualTo(SQL.LikeAt(s, k, p, Add(pi, 1), esc), 1) ThenBlock: { ReturnValue(1) }
                        k = Add(k, 1)
                    }
                    ReturnValue(0)
                }
                IfCondition GreaterEqual(si, sl) ThenBlock: { ReturnValue(0) }
                IfCondition NotEqual(pc, 95) ThenBlock: {
                    IfCondition NotEqual(SQL.LowByte(RDMEM_8(s, si)), pc) ThenBlock: { ReturnValue(0) }
                }
                si = Add(si, 1)
                pi = Add(pi, 1)
            }
        }
        IfCondition EqualTo(si, sl) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

Function.SQL.Like {
    Input: s: Address
    Input: p: Address
    Input: esc: Integer
    Output: Address
    Body: {
        IfCondition Or(EqualTo(SQL.IsNull(s), 1), EqualTo(SQL.IsNull(p), 1)) ThenBlock: { ReturnValue(SQL.Null()) }
        IfCondition Or(EqualTo(SQL.VTag(s), SQLV.BLOB), EqualTo(SQL.VTag(p), SQLV.BLOB)) ThenBlock: { ReturnValue(SQL.Int(0)) }
        st = SQL.AsText(s)
        pt = SQL.AsText(p)
        IfCondition Or(EqualTo(st, 0), EqualTo(pt, 0)) ThenBlock: { ReturnValue(SQL.Null()) }
        IfCondition GreaterThan(StringLength(pt), 50000) ThenBlock: {
            SQL.Fail("LIKE or GLOB pattern too complex")
            ReturnValue(SQL.Null())
        }
        IfCondition EqualTo(SQL.LikeAt(st, 0, pt, 0, esc), 1) ThenBlock: { ReturnValue(SQL.Int(1)) }
        ReturnValue(SQL.Int(0))
    }
}

// Match one character against a GLOB class starting at pi (on '[').
// Returns the pattern index after ']', or -1 when the character does not match.
Function.SQL.GlobClass {
    Input: s: Address
    Input: si: Integer
    Input: p: Address
    Input: pi: Integer
    Output: Integer
    Body: {
        sl = StringLength(s)
        pl = StringLength(p)
        IfCondition GreaterEqual(si, sl) ThenBlock: { ReturnValue(-1) }
        ch = BitwiseAnd(RDMEM_8(s, si), 255)
        pi = Add(pi, 1)
        IfCondition GreaterEqual(pi, pl) ThenBlock: { ReturnValue(-1) }
        c2 = BitwiseAnd(RDMEM_8(p, pi), 255)
        pi = Add(pi, 1)
        inv = 0
        IfCondition EqualTo(c2, 94) ThenBlock: {
            inv = 1
            IfCondition GreaterEqual(pi, pl) ThenBlock: { ReturnValue(-1) }
            c2 = BitwiseAnd(RDMEM_8(p, pi), 255)
            pi = Add(pi, 1)
        }
        seen = 0
        IfCondition EqualTo(c2, 93) ThenBlock: {
            IfCondition EqualTo(ch, 93) ThenBlock: { seen = 1 }
            IfCondition GreaterEqual(pi, pl) ThenBlock: { ReturnValue(-1) }
            c2 = BitwiseAnd(RDMEM_8(p, pi), 255)
            pi = Add(pi, 1)
        }
        prior = 0
        stop = 0
        WhileLoop EqualTo(stop, 0) {
            IfCondition Or(EqualTo(c2, 0), EqualTo(c2, 93)) ThenBlock: {
                stop = 1
            } ElseBlock: {
                IfCondition And(EqualTo(c2, 45), And(LessThan(pi, pl), And(NotEqual(RDMEM_8(p, pi), 93), GreaterThan(prior, 0)))) ThenBlock: {
                    c2 = BitwiseAnd(RDMEM_8(p, pi), 255)
                    pi = Add(pi, 1)
                    IfCondition And(GreaterEqual(ch, prior), LessEqual(ch, c2)) ThenBlock: { seen = 1 }
                    prior = 0
                } ElseBlock: {
                    IfCondition EqualTo(ch, c2) ThenBlock: { seen = 1 }
                    prior = c2
                }
                IfCondition GreaterEqual(pi, pl) ThenBlock: {
                    c2 = 0
                } ElseBlock: {
                    c2 = BitwiseAnd(RDMEM_8(p, pi), 255)
                    pi = Add(pi, 1)
                }
            }
        }
        IfCondition NotEqual(c2, 93) ThenBlock: { ReturnValue(-1) }
        IfCondition EqualTo(inv, 1) ThenBlock: {
            IfCondition EqualTo(seen, 1) ThenBlock: { ReturnValue(-1) }
            ReturnValue(pi)
        }
        IfCondition EqualTo(seen, 0) ThenBlock: { ReturnValue(-1) }
        ReturnValue(pi)
    }
}

Function.SQL.GlobAt {
    Input: s: Address
    Input: si: Integer
    Input: p: Address
    Input: pi: Integer
    Input: esc: Integer
    Output: Integer
    Body: {
        sl = StringLength(s)
        pl = StringLength(p)
        WhileLoop LessThan(pi, pl) {
            raw = BitwiseAnd(RDMEM_8(p, pi), 255)
            IfCondition And(NotEqual(esc, 0), EqualTo(raw, esc)) ThenBlock: {
                pi = Add(pi, 1)
                IfCondition GreaterEqual(pi, pl) ThenBlock: {
                    IfCondition EqualTo(si, sl) ThenBlock: { ReturnValue(1) }
                    ReturnValue(0)
                }
                IfCondition GreaterEqual(si, sl) ThenBlock: { ReturnValue(0) }
                IfCondition NotEqual(BitwiseAnd(RDMEM_8(s, si), 255), BitwiseAnd(RDMEM_8(p, pi), 255)) ThenBlock: { ReturnValue(0) }
                si = Add(si, 1)
                pi = Add(pi, 1)
            } ElseBlock: {
                IfCondition EqualTo(raw, 42) ThenBlock: {
                    pi = Add(pi, 1)
                    WhileLoop And(LessThan(pi, pl), Or(EqualTo(RDMEM_8(p, pi), 42), EqualTo(RDMEM_8(p, pi), 63))) {
                        IfCondition EqualTo(RDMEM_8(p, pi), 63) ThenBlock: {
                            IfCondition GreaterEqual(si, sl) ThenBlock: { ReturnValue(0) }
                            si = Add(si, 1)
                        }
                        pi = Add(pi, 1)
                    }
                    IfCondition GreaterEqual(pi, pl) ThenBlock: { ReturnValue(1) }
                    k = si
                    WhileLoop LessEqual(k, sl) {
                        IfCondition EqualTo(SQL.GlobAt(s, k, p, pi, esc), 1) ThenBlock: { ReturnValue(1) }
                        k = Add(k, 1)
                    }
                    ReturnValue(0)
                }
                IfCondition EqualTo(raw, 91) ThenBlock: {
                    np = SQL.GlobClass(s, si, p, pi)
                    IfCondition LessThan(np, 0) ThenBlock: { ReturnValue(0) }
                    si = Add(si, 1)
                    pi = np
                } ElseBlock: {
                    IfCondition GreaterEqual(si, sl) ThenBlock: { ReturnValue(0) }
                    IfCondition NotEqual(raw, 63) ThenBlock: {
                        IfCondition NotEqual(BitwiseAnd(RDMEM_8(s, si), 255), raw) ThenBlock: { ReturnValue(0) }
                    }
                    si = Add(si, 1)
                    pi = Add(pi, 1)
                }
            }
        }
        IfCondition EqualTo(si, sl) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

Function.SQL.Glob {
    Input: s: Address
    Input: p: Address
    Input: esc: Integer
    Output: Address
    Body: {
        IfCondition Or(EqualTo(SQL.IsNull(s), 1), EqualTo(SQL.IsNull(p), 1)) ThenBlock: { ReturnValue(SQL.Null()) }
        IfCondition Or(EqualTo(SQL.VTag(s), SQLV.BLOB), EqualTo(SQL.VTag(p), SQLV.BLOB)) ThenBlock: { ReturnValue(SQL.Int(0)) }
        st = SQL.AsText(s)
        pt = SQL.AsText(p)
        IfCondition Or(EqualTo(st, 0), EqualTo(pt, 0)) ThenBlock: { ReturnValue(SQL.Null()) }
        IfCondition GreaterThan(StringLength(pt), 50000) ThenBlock: {
            SQL.Fail("LIKE or GLOB pattern too complex")
            ReturnValue(SQL.Null())
        }
        IfCondition EqualTo(SQL.GlobAt(st, 0, pt, 0, esc), 1) ThenBlock: { ReturnValue(SQL.Int(1)) }
        ReturnValue(SQL.Int(0))
    }
}

Function.SQL.IsAgg {
    Input: nm: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(SQL.EqStr(nm, "count"), 1) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(SQL.EqStr(nm, "sum"), 1) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(SQL.EqStr(nm, "avg"), 1) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(SQL.EqStr(nm, "min"), 1) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(SQL.EqStr(nm, "max"), 1) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(SQL.EqStr(nm, "total"), 1) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(SQL.EqStr(nm, "group_concat"), 1) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

Function.SQL.TreeAgg {
    Input: n: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(n, 0) ThenBlock: { ReturnValue(0) }
        k = SQL.Kind(n)
        IfCondition Or(EqualTo(k, SQLK.SELECT), EqualTo(k, SQLK.EXISTS)) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(k, SQLK.CALL) ThenBlock: {
            IfCondition EqualTo(SQL.IsAgg(SQL.A(n)), 1) ThenBlock: { ReturnValue(1) }
            ReturnValue(SQL.TreeAgg(SQL.B(n)))
        }
        IfCondition EqualTo(k, SQLK.BIN) ThenBlock: {
            IfCondition EqualTo(SQL.TreeAgg(SQL.A(n)), 1) ThenBlock: { ReturnValue(1) }
            IfCondition EqualTo(SQL.TreeAgg(SQL.B(n)), 1) ThenBlock: { ReturnValue(1) }
            ReturnValue(SQL.TreeAgg(SQL.C(n)))
        }
        IfCondition Or(EqualTo(k, SQLK.UN), EqualTo(k, SQLK.CAST)) ThenBlock: { ReturnValue(SQL.TreeAgg(SQL.A(n))) }
        IfCondition Or(EqualTo(k, SQLK.IS), EqualTo(k, SQLK.IN)) ThenBlock: {
            IfCondition EqualTo(SQL.TreeAgg(SQL.A(n)), 1) ThenBlock: { ReturnValue(1) }
            IfCondition EqualTo(SQL.C(n), 1) ThenBlock: { ReturnValue(0) }
            ReturnValue(SQL.TreeAgg(SQL.B(n)))
        }
        IfCondition EqualTo(k, SQLK.BETWEEN) ThenBlock: {
            IfCondition EqualTo(SQL.TreeAgg(SQL.A(n)), 1) ThenBlock: { ReturnValue(1) }
            IfCondition EqualTo(SQL.TreeAgg(SQL.B(n)), 1) ThenBlock: { ReturnValue(1) }
            ReturnValue(SQL.TreeAgg(SQL.C(n)))
        }
        IfCondition Or(EqualTo(k, SQLK.LIST), EqualTo(k, SQLK.WHEN)) ThenBlock: {
            IfCondition EqualTo(SQL.TreeAgg(SQL.A(n)), 1) ThenBlock: { ReturnValue(1) }
            IfCondition EqualTo(SQL.TreeAgg(SQL.B(n)), 1) ThenBlock: { ReturnValue(1) }
            ReturnValue(SQL.TreeAgg(SQL.C(n)))
        }
        IfCondition EqualTo(k, SQLK.CASE) ThenBlock: {
            IfCondition EqualTo(SQL.TreeAgg(SQL.A(n)), 1) ThenBlock: { ReturnValue(1) }
            IfCondition EqualTo(SQL.TreeAgg(SQL.B(n)), 1) ThenBlock: { ReturnValue(1) }
            ReturnValue(SQL.TreeAgg(SQL.C(n)))
        }
        ReturnValue(0)
    }
}

Function.SQL.Arg0 {
    Input: args: Address
    Output: Address
    Body: {
        IfCondition EqualTo(args, 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(SQL.A(args))
    }
}

Function.SQL.AggEval {
    Input: nm: Address
    Input: flags: Integer
    Input: args: Address
    Output: Address
    Body: {
        rows = SQLS.group
        IfCondition EqualTo(rows, 0) ThenBlock: {
            SQL.Fail("aggregate")
            ReturnValue(SQL.Null())
        }
        nr = Array.Size(rows)
        IfCondition And(EqualTo(SQL.EqStr(nm, "count"), 1), NotEqual(BitwiseAnd(flags, 2), 0)) ThenBlock: {
            IfCondition NotEqual(BitwiseAnd(flags, 1), 0) ThenBlock: {
                SQL.Fail("count distinct star")
                ReturnValue(SQL.Null())
            }
            ReturnValue(SQL.Int(nr))
        }
        IfCondition And(EqualTo(SQL.EqStr(nm, "group_concat"), 1), And(NotEqual(BitwiseAnd(flags, 1), 0), NotEqual(SQL.B(args), 0))) ThenBlock: {
            SQL.Fail("group_concat")
            ReturnValue(SQL.Null())
        }
        arg = SQL.Arg0(args)
        seen = 0
        allint = 1
        ov = 0
        useR = 0
        acc = 0
        accf = Float_FromInt(0)
        best = 0
        cnt = 0
        parts = Array.Create(4)
        seenH = 0
        IfCondition NotEqual(BitwiseAnd(flags, 1), 0) ThenBlock: { seenH = Hash.New() }
        isMin = SQL.EqStr(nm, "min")
        isMax = SQL.EqStr(nm, "max")
        isCnt = SQL.EqStr(nm, "count")
        isSum = SQL.EqStr(nm, "sum")
        isTot = SQL.EqStr(nm, "total")
        isAvg = SQL.EqStr(nm, "avg")
        isGc = SQL.EqStr(nm, "group_concat")
        sep = ","
        IfCondition And(EqualTo(isGc, 1), NotEqual(SQL.B(args), 0)) ThenBlock: {
            saved = SQLS.group
            SQLS.group = 0
            sv = SQL.Eval(SQL.A(SQL.B(args)))
            SQLS.group = saved
            sep = SQL.AsText(sv)
            IfCondition EqualTo(sep, 0) ThenBlock: { sep = "" }
        }
        i = 0
        WhileLoop LessThan(i, nr) {
            SQLS.scope = Array.Get(rows, i)
            savedg = SQLS.group
            SQLS.group = 0
            v = SQL.Eval(arg)
            SQLS.group = savedg
            IfCondition EqualTo(SQLS.err, 0) ThenBlock: {
                IfCondition EqualTo(SQL.IsNull(v), 0) ThenBlock: {
                    take = 1
                    IfCondition NotEqual(seenH, 0) ThenBlock: {
                        ck = SQL.Canon(v)
                        IfCondition NotEqual(Hash.Get(seenH, ck), 0) ThenBlock: { take = 0 }
                        IfCondition EqualTo(take, 1) ThenBlock: { Hash.Set(seenH, ck, 1) }
                    }
                    IfCondition EqualTo(take, 1) ThenBlock: {
                        seen = 1
                        cnt = Add(cnt, 1)
                        IfCondition EqualTo(isCnt, 1) ThenBlock: { v = v }
                        IfCondition Or(EqualTo(isMin, 1), EqualTo(isMax, 1)) ThenBlock: {
                            IfCondition EqualTo(best, 0) ThenBlock: { best = v }
                            IfCondition EqualTo(isMin, 1) ThenBlock: {
                                IfCondition LessThan(SQL.Cmp3(v, best), 0) ThenBlock: { best = v }
                            }
                            IfCondition EqualTo(isMax, 1) ThenBlock: {
                                IfCondition GreaterThan(SQL.Cmp3(v, best), 0) ThenBlock: { best = v }
                            }
                        }
                        IfCondition Or(EqualTo(isSum, 1), Or(EqualTo(isTot, 1), EqualTo(isAvg, 1))) ThenBlock: {
                            IfCondition And(EqualTo(allint, 1), EqualTo(SQL.VTag(v), SQLV.INT)) ThenBlock: {
                                s = Add(acc, SQL.VBits(v))
                                IfCondition EqualTo(SQL.AddOverflow(acc, SQL.VBits(v), s), 1) ThenBlock: {
                                    accf = Float_Add(Float_FromInt(acc), Float_FromInt(SQL.VBits(v)))
                                    useR = 1
                                    IfCondition EqualTo(isSum, 1) ThenBlock: { ov = 1 }
                                    allint = 0
                                } ElseBlock: {
                                    acc = s
                                }
                            } ElseBlock: {
                                IfCondition NotEqual(SQL.VTag(v), SQLV.INT) ThenBlock: { ov = 0 }
                                IfCondition EqualTo(useR, 0) ThenBlock: {
                                    accf = Float_FromInt(acc)
                                    useR = 1
                                }
                                accf = Float_Add(accf, SQL.AsReal(v))
                                allint = 0
                            }
                        }
                        IfCondition EqualTo(isGc, 1) ThenBlock: { Array.Push(parts, SQL.AsText(v)) }
                    }
                }
            }
            i = Add(i, 1)
        }
        IfCondition NotEqual(SQLS.err, 0) ThenBlock: { ReturnValue(SQL.Null()) }
        IfCondition EqualTo(isCnt, 1) ThenBlock: { ReturnValue(SQL.Int(cnt)) }
        IfCondition Or(EqualTo(isMin, 1), EqualTo(isMax, 1)) ThenBlock: {
            IfCondition EqualTo(best, 0) ThenBlock: { ReturnValue(SQL.Null()) }
            ReturnValue(best)
        }
        IfCondition EqualTo(isGc, 1) ThenBlock: {
            IfCondition EqualTo(seen, 0) ThenBlock: { ReturnValue(SQL.Null()) }
            out = ""
            j = 0
            pn = Array.Size(parts)
            WhileLoop LessThan(j, pn) {
                IfCondition GreaterThan(j, 0) ThenBlock: { out = StringConcat(out, sep) }
                out = StringConcat(out, Array.Get(parts, j))
                j = Add(j, 1)
            }
            ReturnValue(SQL.Text(out))
        }
        IfCondition EqualTo(isTot, 1) ThenBlock: {
            IfCondition EqualTo(useR, 0) ThenBlock: { ReturnValue(SQL.Real(Float_FromInt(acc))) }
            ReturnValue(SQL.Real(accf))
        }
        IfCondition EqualTo(seen, 0) ThenBlock: { ReturnValue(SQL.Null()) }
        IfCondition EqualTo(isAvg, 1) ThenBlock: {
            IfCondition EqualTo(useR, 0) ThenBlock: { accf = Float_FromInt(acc) }
            ReturnValue(SQL.Real(Float_Div(accf, Float_FromInt(cnt))))
        }
        IfCondition EqualTo(ov, 1) ThenBlock: {
            SQL.Fail("integer overflow")
            ReturnValue(SQL.Null())
        }
        IfCondition EqualTo(useR, 0) ThenBlock: { ReturnValue(SQL.Int(acc)) }
        ReturnValue(SQL.Real(accf))
    }
}

Function.SQL.EvalCall {
    Input: n: Address
    Output: Address
    Body: {
        nm = SQL.A(n)
        IfCondition EqualTo(SQL.IsAgg(nm), 1) ThenBlock: { ReturnValue(SQL.AggEval(nm, SQL.Flags(n), SQL.B(n))) }
        IfCondition EqualTo(SQL.EqStr(nm, "abs"), 1) ThenBlock: { ReturnValue(SQL.Abs(SQL.Eval(SQL.Arg0(SQL.B(n))))) }
        IfCondition EqualTo(SQL.EqStr(nm, "coalesce"), 1) ThenBlock: {
            p = SQL.B(n)
            WhileLoop NotEqual(p, 0) {
                v = SQL.Eval(SQL.A(p))
                IfCondition EqualTo(SQL.IsNull(v), 0) ThenBlock: { ReturnValue(v) }
                p = SQL.B(p)
            }
            ReturnValue(SQL.Null())
        }
        IfCondition EqualTo(SQL.EqStr(nm, "nullif"), 1) ThenBlock: {
            a = SQL.Eval(SQL.Arg0(SQL.B(n)))
            b = SQL.Eval(SQL.A(SQL.B(SQL.B(n))))
            IfCondition EqualTo(SQL.CmpAff(a, SQLA.NONE, b, SQLA.NONE), 0) ThenBlock: { ReturnValue(SQL.Null()) }
            ReturnValue(a)
        }
        SQL.Fail("no such function")
        ReturnValue(SQL.Null())
    }
}

Function.SQL.EvalBin {
    Input: n: Address
    Output: Address
    Body: {
        op = SQL.Flags(n)
        // TRUE OR x is true, and FALSE AND x is false, without evaluating x.
        IfCondition EqualTo(op, SQLB.AND) ThenBlock: {
            x = SQL.Eval(SQL.A(n))
            IfCondition EqualTo(SQL.Class(x), 0) ThenBlock: { ReturnValue(SQL.Int(0)) }
            y = SQL.Eval(SQL.B(n))
            ReturnValue(SQL.And(x, y))
        }
        IfCondition EqualTo(op, SQLB.OR) ThenBlock: {
            x = SQL.Eval(SQL.A(n))
            IfCondition EqualTo(SQL.Class(x), 1) ThenBlock: { ReturnValue(SQL.Int(1)) }
            y = SQL.Eval(SQL.B(n))
            ReturnValue(SQL.Or(x, y))
        }
        x = SQL.Eval(SQL.A(n))
        y = SQL.Eval(SQL.B(n))
        ax = SQL.AffOf(SQL.A(n))
        ay = SQL.AffOf(SQL.B(n))
        IfCondition EqualTo(op, SQLB.ADD) ThenBlock: { ReturnValue(SQL.Add(x, y)) }
        IfCondition EqualTo(op, SQLB.SUB) ThenBlock: { ReturnValue(SQL.Sub(x, y)) }
        IfCondition EqualTo(op, SQLB.MUL) ThenBlock: { ReturnValue(SQL.Mul(x, y)) }
        IfCondition EqualTo(op, SQLB.DIV) ThenBlock: { ReturnValue(SQL.Div(x, y)) }
        IfCondition EqualTo(op, SQLB.MOD) ThenBlock: { ReturnValue(SQL.Mod(x, y)) }
        IfCondition EqualTo(op, SQLB.CONCAT) ThenBlock: { ReturnValue(SQL.Concat(x, y)) }
        IfCondition EqualTo(op, SQLB.SHL) ThenBlock: { ReturnValue(SQL.Shl(x, y)) }
        IfCondition EqualTo(op, SQLB.SHR) ThenBlock: { ReturnValue(SQL.Shr(x, y)) }
        IfCondition EqualTo(op, SQLB.BAND) ThenBlock: { ReturnValue(SQL.Band(x, y)) }
        IfCondition EqualTo(op, SQLB.BOR) ThenBlock: { ReturnValue(SQL.Bor(x, y)) }
        IfCondition EqualTo(op, SQLB.AND) ThenBlock: { ReturnValue(SQL.And(x, y)) }
        IfCondition EqualTo(op, SQLB.OR) ThenBlock: { ReturnValue(SQL.Or(x, y)) }
        IfCondition Or(EqualTo(op, SQLB.LIKE), EqualTo(op, SQLB.GLOB)) ThenBlock: {
            esc = 0
            IfCondition NotEqual(SQL.C(n), 0) ThenBlock: {
                ev = SQL.Eval(SQL.C(n))
                IfCondition EqualTo(SQL.IsNull(ev), 1) ThenBlock: { ReturnValue(SQL.Null()) }
                et = SQL.AsText(ev)
                en = StringLength(et)
                IfCondition GreaterThan(en, 1) ThenBlock: {
                    SQL.Fail("ESCAPE expression must be a single character")
                    ReturnValue(SQL.Null())
                }
                IfCondition EqualTo(en, 1) ThenBlock: { esc = RDMEM_8(et, 0) }
            }
            hit = SQL.Like(x, y, esc)
            IfCondition EqualTo(op, SQLB.GLOB) ThenBlock: { hit = SQL.Glob(x, y, esc) }
            IfCondition NotEqual(SQL.D(n), 0) ThenBlock: { ReturnValue(SQL.Not(hit)) }
            ReturnValue(hit)
        }
        c = SQL.CmpAff(x, ax, y, ay)
        IfCondition EqualTo(op, SQLB.EQ) ThenBlock: { ReturnValue(SQL.CmpVal(c)) }
        IfCondition EqualTo(op, SQLB.NE) ThenBlock: {
            IfCondition EqualTo(c, -2) ThenBlock: { ReturnValue(SQL.Null()) }
            IfCondition EqualTo(c, 0) ThenBlock: { ReturnValue(SQL.Int(0)) }
            ReturnValue(SQL.Int(1))
        }
        IfCondition EqualTo(op, SQLB.LT) ThenBlock: {
            IfCondition EqualTo(c, -2) ThenBlock: { ReturnValue(SQL.Null()) }
            IfCondition LessThan(c, 0) ThenBlock: { ReturnValue(SQL.Int(1)) }
            ReturnValue(SQL.Int(0))
        }
        IfCondition EqualTo(op, SQLB.GT) ThenBlock: {
            IfCondition EqualTo(c, -2) ThenBlock: { ReturnValue(SQL.Null()) }
            IfCondition GreaterThan(c, 0) ThenBlock: { ReturnValue(SQL.Int(1)) }
            ReturnValue(SQL.Int(0))
        }
        IfCondition EqualTo(op, SQLB.LE) ThenBlock: {
            IfCondition EqualTo(c, -2) ThenBlock: { ReturnValue(SQL.Null()) }
            IfCondition LessEqual(c, 0) ThenBlock: { ReturnValue(SQL.Int(1)) }
            ReturnValue(SQL.Int(0))
        }
        IfCondition EqualTo(c, -2) ThenBlock: { ReturnValue(SQL.Null()) }
        IfCondition GreaterEqual(c, 0) ThenBlock: { ReturnValue(SQL.Int(1)) }
        ReturnValue(SQL.Int(0))
    }
}

Function.SQL.EvalUn {
    Input: n: Address
    Output: Address
    Body: {
        v = SQL.Eval(SQL.A(n))
        op = SQL.Flags(n)
        IfCondition EqualTo(op, SQLU.NEG) ThenBlock: { ReturnValue(SQL.Neg(v)) }
        IfCondition EqualTo(op, SQLU.PLUS) ThenBlock: { ReturnValue(SQL.Plus(v)) }
        IfCondition EqualTo(op, SQLU.NOT) ThenBlock: { ReturnValue(SQL.Not(v)) }
        ReturnValue(SQL.BNot(v))
    }
}

Function.SQL.EvalIs {
    Input: n: Address
    Output: Address
    Body: {
        x = SQL.Eval(SQL.A(n))
        y = SQL.Eval(SQL.B(n))
        r = SQL.Int(0)
        IfCondition And(EqualTo(SQL.IsNull(x), 1), EqualTo(SQL.IsNull(y), 1)) ThenBlock: {
            r = SQL.Int(1)
        } ElseBlock: {
            IfCondition Or(EqualTo(SQL.IsNull(x), 1), EqualTo(SQL.IsNull(y), 1)) ThenBlock: {
                r = SQL.Int(0)
            } ElseBlock: {
                IfCondition EqualTo(SQL.CmpAff(x, SQL.AffOf(SQL.A(n)), y, SQL.AffOf(SQL.B(n))), 0) ThenBlock: {
                    r = SQL.Int(1)
                }
            }
        }
        IfCondition NotEqual(SQL.Flags(n), 0) ThenBlock: { ReturnValue(SQL.Not(r)) }
        ReturnValue(r)
    }
}

Function.SQL.InHit {
    Input: left: Address
    Input: ax: Integer
    Input: v: Address
    Input: ay: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(SQL.IsNull(v), 1) ThenBlock: { ReturnValue(2) }
        IfCondition EqualTo(SQL.CmpAff(left, ax, v, ay), 0) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

// Copy a subquery result onto the heap. EvalTruth rewinds the bump
// after the predicate, so a cached IN list cannot point at bump values.
Function.SQL.KeepIn {
    Input: rs: Address
    Output: Address
    Body: {
        out = Array.Create(8)
        IfCondition EqualTo(rs, 0) ThenBlock: {
            back = Add(out, 0)
            ReturnValue(back)
        }
        i = 0
        WhileLoop LessThan(i, Array.Size(rs)) {
            row = Array.Get(rs, i)
            nrow = Array.Create(2)
            IfCondition NotEqual(row, 0) ThenBlock: {
                c = 0
                WhileLoop LessThan(c, Array.Size(row)) {
                    Array.Push(nrow, SQL.Persist(Array.Get(row, c)))
                    c = Add(c, 1)
                }
            }
            Array.Push(out, nrow)
            i = Add(i, 1)
        }
        back = Add(out, 0)
        ReturnValue(back)
    }
}

Function.SQL.EvalIn {
    Input: n: Address
    Output: Address
    Body: {
        left = SQL.Eval(SQL.A(n))
        ax = SQL.AffOf(SQL.A(n))
        any = 0
        eq = 0
        empty = 1
        IfCondition NotEqual(SQL.D(n), 0) ThenBlock: {
            tbl = SQL.FindTab(SQL.D(n))
            IfCondition EqualTo(tbl, 0) ThenBlock: {
                SQL.Fail("no such table")
                ReturnValue(SQL.Null())
            }
            IfCondition NotEqual(SQL.ColCount(tbl), 1) ThenBlock: {
                SQL.Fail("in")
                ReturnValue(SQL.Null())
            }
            i = 0
            nr = SQL.NRows(tbl)
            aff = SQL.ColAff(SQL.ColAt(tbl, 0))
            WhileLoop LessThan(i, nr) {
                empty = 0
                h = SQL.InHit(left, ax, Array.Get(SQL.RowAt(tbl, i), 0), aff)
                IfCondition EqualTo(h, 1) ThenBlock: { eq = 1 }
                IfCondition EqualTo(h, 2) ThenBlock: { any = 1 }
                i = Add(i, 1)
            }
        } ElseBlock: {
            IfCondition EqualTo(SQL.C(n), 1) ThenBlock: {
                rs = 0
                IfCondition EqualTo(SQL.E(n), 1) ThenBlock: {
                    rs = SQL.F(n)
                } ElseBlock: {
                    // minouter records the outermost scope a column lookup
                    // touched. A subquery that stays inside its own FROM can
                    // be reused for every outer row.
                    savedM = SQLS.minouter
                    SQLS.minouter = 999
                    rs = SQL.RunSelect(SQL.B(n))
                    touched = SQLS.minouter
                    IfCondition LessThan(touched, savedM) ThenBlock: {
                        SQLS.minouter = touched
                    } ElseBlock: {
                        SQLS.minouter = savedM
                    }
                    IfCondition NotEqual(SQLS.err, 0) ThenBlock: { ReturnValue(SQL.Null()) }
                    cc = 0
                    IfCondition NotEqual(SQLS.onames, 0) ThenBlock: { cc = Array.Size(SQLS.onames) }
                    IfCondition NotEqual(cc, 1) ThenBlock: {
                        SQL.Fail("subquery")
                        ReturnValue(SQL.Null())
                    }
                    IfCondition GreaterEqual(touched, SQLS.depth) ThenBlock: {
                        rs = SQL.KeepIn(rs)
                        SQL.SetE(n, 1)
                        SQL.SetF(n, rs)
                    }
                }
                i2 = 0
                n2 = Array.Size(rs)
                WhileLoop LessThan(i2, n2) {
                    empty = 0
                    row = Array.Get(rs, i2)
                    h2 = SQL.InHit(left, ax, Array.Get(row, 0), SQLA.NONE)
                    IfCondition EqualTo(h2, 1) ThenBlock: { eq = 1 }
                    IfCondition EqualTo(h2, 2) ThenBlock: { any = 1 }
                    i2 = Add(i2, 1)
                }
            } ElseBlock: {
                p = SQL.B(n)
                WhileLoop NotEqual(p, 0) {
                    empty = 0
                    v = SQL.Eval(SQL.A(p))
                    h3 = SQL.InHit(left, ax, v, SQL.AffOf(SQL.A(p)))
                    IfCondition EqualTo(h3, 1) ThenBlock: { eq = 1 }
                    IfCondition EqualTo(h3, 2) ThenBlock: { any = 1 }
                    p = SQL.B(p)
                }
            }
        }
        r = SQL.Int(0)
        IfCondition EqualTo(empty, 1) ThenBlock: {
            r = SQL.Int(0)
        } ElseBlock: {
            IfCondition EqualTo(eq, 1) ThenBlock: {
                r = SQL.Int(1)
            } ElseBlock: {
                IfCondition Or(EqualTo(any, 1), EqualTo(SQL.IsNull(left), 1)) ThenBlock: {
                    r = SQL.Null()
                }
            }
        }
        IfCondition NotEqual(SQL.Flags(n), 0) ThenBlock: { ReturnValue(SQL.Not(r)) }
        ReturnValue(r)
    }
}

Function.SQL.EvalBetween {
    Input: n: Address
    Output: Address
    Body: {
        x = SQL.Eval(SQL.A(n))
        lo = SQL.Eval(SQL.B(n))
        hi = SQL.Eval(SQL.C(n))
        ax = SQL.AffOf(SQL.A(n))
        c1 = SQL.CmpAff(x, ax, lo, SQL.AffOf(SQL.B(n)))
        c2 = SQL.CmpAff(x, ax, hi, SQL.AffOf(SQL.C(n)))
        r = SQL.Null()
        IfCondition And(NotEqual(c1, -2), NotEqual(c2, -2)) ThenBlock: {
            IfCondition And(GreaterEqual(c1, 0), LessEqual(c2, 0)) ThenBlock: {
                r = SQL.Int(1)
            } ElseBlock: {
                r = SQL.Int(0)
            }
        } ElseBlock: {
            IfCondition And(NotEqual(c1, -2), LessThan(c1, 0)) ThenBlock: { r = SQL.Int(0) }
            IfCondition And(NotEqual(c2, -2), GreaterThan(c2, 0)) ThenBlock: { r = SQL.Int(0) }
        }
        IfCondition NotEqual(SQL.Flags(n), 0) ThenBlock: { ReturnValue(SQL.Not(r)) }
        ReturnValue(r)
    }
}

Function.SQL.EvalCase {
    Input: n: Address
    Output: Address
    Body: {
        base = 0
        IfCondition NotEqual(SQL.Flags(n), 0) ThenBlock: { base = SQL.Eval(SQL.A(n)) }
        w = SQL.B(n)
        WhileLoop NotEqual(w, 0) {
            IfCondition NotEqual(SQL.Flags(n), 0) ThenBlock: {
                cv = SQL.Eval(SQL.A(w))
                IfCondition EqualTo(SQL.CmpAff(base, SQL.AffOf(SQL.A(n)), cv, SQL.AffOf(SQL.A(w))), 0) ThenBlock: {
                    ReturnValue(SQL.Eval(SQL.B(w)))
                }
            } ElseBlock: {
                IfCondition EqualTo(SQL.Truth(SQL.Eval(SQL.A(w))), 1) ThenBlock: {
                    ReturnValue(SQL.Eval(SQL.B(w)))
                }
            }
            w = SQL.C(w)
        }
        IfCondition NotEqual(SQL.C(n), 0) ThenBlock: { ReturnValue(SQL.Eval(SQL.C(n))) }
        ReturnValue(SQL.Null())
    }
}

Function.SQL.EvalCast {
    Input: n: Address
    Output: Address
    Body: {
        v = SQL.Eval(SQL.A(n))
        IfCondition EqualTo(SQL.IsNull(v), 1) ThenBlock: { ReturnValue(v) }
        a = SQL.Flags(n)
        IfCondition EqualTo(a, SQLA.TEXT) ThenBlock: { ReturnValue(SQL.Text(SQL.AsText(v))) }
        IfCondition EqualTo(a, SQLA.REAL) ThenBlock: { ReturnValue(SQL.Real(SQL.AsReal(v))) }
        IfCondition EqualTo(a, SQLA.INT) ThenBlock: { ReturnValue(SQL.Int(SQL.AsInt(v))) }
        IfCondition EqualTo(a, SQLA.NUM) ThenBlock: { ReturnValue(SQL.ApplyAff(v, SQLA.NUM)) }
        IfCondition EqualTo(a, SQLA.BLOB) ThenBlock: {
            IfCondition EqualTo(SQL.VTag(v), SQLV.BLOB) ThenBlock: { ReturnValue(v) }
            tx = SQL.AsText(v)
            ReturnValue(SQL.Blob(tx, StringLength(tx)))
        }
        ReturnValue(v)
    }
}

Function.SQL.EvalCol {
    Input: n: Address
    Output: Address
    Body: {
        v = SQL.Lookup(SQL.B(n), SQL.A(n))
        IfCondition And(EqualTo(v, 0), EqualTo(SQLS.err, 0)) ThenBlock: {
            SQL.Fail("no such column")
            ReturnValue(SQL.Null())
        }
        ReturnValue(v)
    }
}

Function.SQL.EvalSub {
    Input: n: Address
    Output: Address
    Body: {
        rs = SQL.RunSelect(SQL.A(n))
        IfCondition NotEqual(SQLS.err, 0) ThenBlock: { ReturnValue(SQL.Null()) }
        IfCondition EqualTo(SQL.Flags(n), 0) ThenBlock: {
            IfCondition GreaterThan(Array.Size(rs), 0) ThenBlock: { ReturnValue(SQL.Int(1)) }
            ReturnValue(SQL.Int(0))
        }
        IfCondition EqualTo(Array.Size(rs), 0) ThenBlock: { ReturnValue(SQL.Null()) }
        row = Array.Get(rs, 0)
        IfCondition GreaterThan(Array.Size(row), 1) ThenBlock: {
            SQL.Fail("subquery")
            ReturnValue(SQL.Null())
        }
        ReturnValue(Array.Get(row, 0))
    }
}

Function.SQL.Eval {
    Input: n: Address
    Output: Address
    Body: {
        IfCondition EqualTo(n, 0) ThenBlock: { ReturnValue(SQL.Null()) }
        IfCondition NotEqual(SQLS.err, 0) ThenBlock: { ReturnValue(SQL.Null()) }
        k = SQL.Kind(n)
        IfCondition EqualTo(k, SQLK.NULL) ThenBlock: { ReturnValue(SQL.Null()) }
        IfCondition EqualTo(k, SQLK.INT) ThenBlock: { ReturnValue(SQL.Int(SQL.A(n))) }
        IfCondition EqualTo(k, SQLK.REAL) ThenBlock: { ReturnValue(SQL.Real(SQL.A(n))) }
        IfCondition EqualTo(k, SQLK.TEXT) ThenBlock: { ReturnValue(SQL.Text(SQL.A(n))) }
        IfCondition EqualTo(k, SQLK.BLOB) ThenBlock: { ReturnValue(SQL.Blob(SQL.A(n), SQL.B(n))) }
        IfCondition EqualTo(k, SQLK.COL) ThenBlock: { ReturnValue(SQL.EvalCol(n)) }
        IfCondition EqualTo(k, SQLK.BIN) ThenBlock: { ReturnValue(SQL.EvalBin(n)) }
        IfCondition EqualTo(k, SQLK.UN) ThenBlock: { ReturnValue(SQL.EvalUn(n)) }
        IfCondition EqualTo(k, SQLK.IS) ThenBlock: { ReturnValue(SQL.EvalIs(n)) }
        IfCondition EqualTo(k, SQLK.IN) ThenBlock: { ReturnValue(SQL.EvalIn(n)) }
        IfCondition EqualTo(k, SQLK.BETWEEN) ThenBlock: { ReturnValue(SQL.EvalBetween(n)) }
        IfCondition EqualTo(k, SQLK.CASE) ThenBlock: { ReturnValue(SQL.EvalCase(n)) }
        IfCondition EqualTo(k, SQLK.CAST) ThenBlock: { ReturnValue(SQL.EvalCast(n)) }
        IfCondition EqualTo(k, SQLK.CALL) ThenBlock: { ReturnValue(SQL.EvalCall(n)) }
        IfCondition EqualTo(k, SQLK.EXISTS) ThenBlock: { ReturnValue(SQL.EvalSub(n)) }
        SQL.Fail("expr")
        ReturnValue(SQL.Null())
    }
}
