Function.SQL.Kw {
    Input: s: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(SQL.EqStr(s, "select"), 1) ThenBlock: { ReturnValue(SQLT.SELECT) }
        IfCondition EqualTo(SQL.EqStr(s, "from"), 1) ThenBlock: { ReturnValue(SQLT.FROM) }
        IfCondition EqualTo(SQL.EqStr(s, "where"), 1) ThenBlock: { ReturnValue(SQLT.WHERE) }
        IfCondition EqualTo(SQL.EqStr(s, "group"), 1) ThenBlock: { ReturnValue(SQLT.GROUP) }
        IfCondition EqualTo(SQL.EqStr(s, "by"), 1) ThenBlock: { ReturnValue(SQLT.BY) }
        IfCondition EqualTo(SQL.EqStr(s, "having"), 1) ThenBlock: { ReturnValue(SQLT.HAVING) }
        IfCondition EqualTo(SQL.EqStr(s, "order"), 1) ThenBlock: { ReturnValue(SQLT.ORDER) }
        IfCondition EqualTo(SQL.EqStr(s, "asc"), 1) ThenBlock: { ReturnValue(SQLT.ASC) }
        IfCondition EqualTo(SQL.EqStr(s, "desc"), 1) ThenBlock: { ReturnValue(SQLT.DESC) }
        IfCondition EqualTo(SQL.EqStr(s, "limit"), 1) ThenBlock: { ReturnValue(SQLT.LIMIT) }
        IfCondition EqualTo(SQL.EqStr(s, "offset"), 1) ThenBlock: { ReturnValue(SQLT.OFFSET) }
        IfCondition EqualTo(SQL.EqStr(s, "union"), 1) ThenBlock: { ReturnValue(SQLT.UNION) }
        IfCondition EqualTo(SQL.EqStr(s, "all"), 1) ThenBlock: { ReturnValue(SQLT.ALL) }
        IfCondition EqualTo(SQL.EqStr(s, "except"), 1) ThenBlock: { ReturnValue(SQLT.EXCEPT) }
        IfCondition EqualTo(SQL.EqStr(s, "intersect"), 1) ThenBlock: { ReturnValue(SQLT.INTERSECT) }
        IfCondition EqualTo(SQL.EqStr(s, "insert"), 1) ThenBlock: { ReturnValue(SQLT.INSERT) }
        IfCondition EqualTo(SQL.EqStr(s, "into"), 1) ThenBlock: { ReturnValue(SQLT.INTO) }
        IfCondition EqualTo(SQL.EqStr(s, "values"), 1) ThenBlock: { ReturnValue(SQLT.VALUES) }
        IfCondition EqualTo(SQL.EqStr(s, "update"), 1) ThenBlock: { ReturnValue(SQLT.UPDATE) }
        IfCondition EqualTo(SQL.EqStr(s, "set"), 1) ThenBlock: { ReturnValue(SQLT.SET) }
        IfCondition EqualTo(SQL.EqStr(s, "delete"), 1) ThenBlock: { ReturnValue(SQLT.DELETE) }
        IfCondition EqualTo(SQL.EqStr(s, "replace"), 1) ThenBlock: { ReturnValue(SQLT.REPLACE) }
        IfCondition EqualTo(SQL.EqStr(s, "create"), 1) ThenBlock: { ReturnValue(SQLT.CREATE) }
        IfCondition EqualTo(SQL.EqStr(s, "table"), 1) ThenBlock: { ReturnValue(SQLT.TABLE) }
        IfCondition EqualTo(SQL.EqStr(s, "index"), 1) ThenBlock: { ReturnValue(SQLT.INDEX) }
        IfCondition EqualTo(SQL.EqStr(s, "view"), 1) ThenBlock: { ReturnValue(SQLT.VIEW) }
        IfCondition EqualTo(SQL.EqStr(s, "trigger"), 1) ThenBlock: { ReturnValue(SQLT.TRIGGER) }
        IfCondition EqualTo(SQL.EqStr(s, "drop"), 1) ThenBlock: { ReturnValue(SQLT.DROP) }
        IfCondition EqualTo(SQL.EqStr(s, "unique"), 1) ThenBlock: { ReturnValue(SQLT.UNIQUE) }
        IfCondition EqualTo(SQL.EqStr(s, "primary"), 1) ThenBlock: { ReturnValue(SQLT.PRIMARY) }
        IfCondition EqualTo(SQL.EqStr(s, "key"), 1) ThenBlock: { ReturnValue(SQLT.KEY) }
        IfCondition EqualTo(SQL.EqStr(s, "on"), 1) ThenBlock: { ReturnValue(SQLT.ON) }
        IfCondition EqualTo(SQL.EqStr(s, "cross"), 1) ThenBlock: { ReturnValue(SQLT.CROSS) }
        IfCondition EqualTo(SQL.EqStr(s, "join"), 1) ThenBlock: { ReturnValue(SQLT.JOIN) }
        IfCondition EqualTo(SQL.EqStr(s, "left"), 1) ThenBlock: { ReturnValue(SQLT.LEFT) }
        IfCondition EqualTo(SQL.EqStr(s, "right"), 1) ThenBlock: { ReturnValue(SQLT.RIGHT) }
        IfCondition EqualTo(SQL.EqStr(s, "inner"), 1) ThenBlock: { ReturnValue(SQLT.INNER) }
        IfCondition EqualTo(SQL.EqStr(s, "outer"), 1) ThenBlock: { ReturnValue(SQLT.OUTER) }
        IfCondition EqualTo(SQL.EqStr(s, "as"), 1) ThenBlock: { ReturnValue(SQLT.AS) }
        IfCondition EqualTo(SQL.EqStr(s, "cast"), 1) ThenBlock: { ReturnValue(SQLT.CAST) }
        IfCondition EqualTo(SQL.EqStr(s, "case"), 1) ThenBlock: { ReturnValue(SQLT.CASE) }
        IfCondition EqualTo(SQL.EqStr(s, "when"), 1) ThenBlock: { ReturnValue(SQLT.WHEN) }
        IfCondition EqualTo(SQL.EqStr(s, "then"), 1) ThenBlock: { ReturnValue(SQLT.THEN) }
        IfCondition EqualTo(SQL.EqStr(s, "else"), 1) ThenBlock: { ReturnValue(SQLT.ELSE) }
        IfCondition EqualTo(SQL.EqStr(s, "end"), 1) ThenBlock: { ReturnValue(SQLT.END) }
        IfCondition EqualTo(SQL.EqStr(s, "and"), 1) ThenBlock: { ReturnValue(SQLT.AND) }
        IfCondition EqualTo(SQL.EqStr(s, "or"), 1) ThenBlock: { ReturnValue(SQLT.OR) }
        IfCondition EqualTo(SQL.EqStr(s, "not"), 1) ThenBlock: { ReturnValue(SQLT.NOT) }
        IfCondition EqualTo(SQL.EqStr(s, "null"), 1) ThenBlock: { ReturnValue(SQLT.NULL) }
        IfCondition EqualTo(SQL.EqStr(s, "is"), 1) ThenBlock: { ReturnValue(SQLT.IS) }
        IfCondition EqualTo(SQL.EqStr(s, "in"), 1) ThenBlock: { ReturnValue(SQLT.IN) }
        IfCondition EqualTo(SQL.EqStr(s, "between"), 1) ThenBlock: { ReturnValue(SQLT.BETWEEN) }
        IfCondition EqualTo(SQL.EqStr(s, "like"), 1) ThenBlock: { ReturnValue(SQLT.LIKE) }
        IfCondition EqualTo(SQL.EqStr(s, "glob"), 1) ThenBlock: { ReturnValue(SQLT.GLOB) }
        IfCondition EqualTo(SQL.EqStr(s, "escape"), 1) ThenBlock: { ReturnValue(SQLT.ESCAPE) }
        IfCondition EqualTo(SQL.EqStr(s, "distinct"), 1) ThenBlock: { ReturnValue(SQLT.DISTINCT) }
        IfCondition EqualTo(SQL.EqStr(s, "exists"), 1) ThenBlock: { ReturnValue(SQLT.EXISTS) }
        IfCondition EqualTo(SQL.EqStr(s, "integer"), 1) ThenBlock: { ReturnValue(SQLT.INTEGER) }
        IfCondition EqualTo(SQL.EqStr(s, "int"), 1) ThenBlock: { ReturnValue(SQLT.INT) }
        IfCondition EqualTo(SQL.EqStr(s, "real"), 1) ThenBlock: { ReturnValue(SQLT.REAL) }
        IfCondition EqualTo(SQL.EqStr(s, "float"), 1) ThenBlock: { ReturnValue(SQLT.FLOAT) }
        IfCondition EqualTo(SQL.EqStr(s, "double"), 1) ThenBlock: { ReturnValue(SQLT.DOUBLE) }
        IfCondition EqualTo(SQL.EqStr(s, "text"), 1) ThenBlock: { ReturnValue(SQLT.TEXT) }
        IfCondition EqualTo(SQL.EqStr(s, "varchar"), 1) ThenBlock: { ReturnValue(SQLT.VARCHAR) }
        IfCondition EqualTo(SQL.EqStr(s, "char"), 1) ThenBlock: { ReturnValue(SQLT.CHAR) }
        IfCondition EqualTo(SQL.EqStr(s, "numeric"), 1) ThenBlock: { ReturnValue(SQLT.NUMERIC) }
        IfCondition EqualTo(SQL.EqStr(s, "decimal"), 1) ThenBlock: { ReturnValue(SQLT.DECIMAL) }
        IfCondition EqualTo(SQL.EqStr(s, "blob"), 1) ThenBlock: { ReturnValue(SQLT.BLOB) }
        IfCondition EqualTo(SQL.EqStr(s, "signed"), 1) ThenBlock: { ReturnValue(SQLT.SIGNED) }
        IfCondition EqualTo(SQL.EqStr(s, "temp"), 1) ThenBlock: { ReturnValue(SQLT.TEMP) }
        IfCondition EqualTo(SQL.EqStr(s, "temporary"), 1) ThenBlock: { ReturnValue(SQLT.TEMPORARY) }
        IfCondition EqualTo(SQL.EqStr(s, "if"), 1) ThenBlock: { ReturnValue(SQLT.IF) }
        IfCondition EqualTo(SQL.EqStr(s, "before"), 1) ThenBlock: { ReturnValue(SQLT.BEFORE) }
        IfCondition EqualTo(SQL.EqStr(s, "after"), 1) ThenBlock: { ReturnValue(SQLT.AFTER) }
        IfCondition EqualTo(SQL.EqStr(s, "begin"), 1) ThenBlock: { ReturnValue(SQLT.BEGIN) }
        IfCondition EqualTo(SQL.EqStr(s, "indexed"), 1) ThenBlock: { ReturnValue(SQLT.INDEXED) }
        IfCondition EqualTo(SQL.EqStr(s, "abort"), 1) ThenBlock: { ReturnValue(SQLT.ABORT) }
        IfCondition EqualTo(SQL.EqStr(s, "fail"), 1) ThenBlock: { ReturnValue(SQLT.FAIL) }
        IfCondition EqualTo(SQL.EqStr(s, "ignore"), 1) ThenBlock: { ReturnValue(SQLT.IGNORE) }
        IfCondition EqualTo(SQL.EqStr(s, "rollback"), 1) ThenBlock: { ReturnValue(SQLT.ROLLBACK) }
        IfCondition EqualTo(SQL.EqStr(s, "isnull"), 1) ThenBlock: { ReturnValue(SQLT.ISNULL) }
        IfCondition EqualTo(SQL.EqStr(s, "notnull"), 1) ThenBlock: { ReturnValue(SQLT.NOTNULL) }
        IfCondition EqualTo(SQL.EqStr(s, "reindex"), 1) ThenBlock: { ReturnValue(SQLT.REINDEX) }
        ReturnValue(0)
    }
}

Function.SQL.IsIdent {
    Input: c: Integer
    Output: Integer
    Body: {
        IfCondition And(GreaterEqual(c, 65), LessEqual(c, 90)) ThenBlock: { ReturnValue(1) }
        IfCondition And(GreaterEqual(c, 97), LessEqual(c, 122)) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(c, 95) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

Function.SQL.IsId2 {
    Input: c: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(SQL.IsIdent(c), 1) ThenBlock: { ReturnValue(1) }
        IfCondition And(GreaterEqual(c, 48), LessEqual(c, 57)) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

// One numeric token: digits, 0x hex, a leading dot, or an exponent.
// A trailing identifier character is a bad token, matching SQLite.
Function.SQL.LexNum {
    Input: s: Address
    Input: i: Integer
    Output: Integer
    Body: {
        n = SQLS.slen
        c0 = RDMEM_8(s, i)
        IfCondition EqualTo(c0, 46) ThenBlock: {
            IfCondition Or(GreaterEqual(Add(i, 1), n), Or(LessThan(RDMEM_8(s, Add(i, 1)), 48), GreaterThan(RDMEM_8(s, Add(i, 1)), 57))) ThenBlock: {
                ReturnValue(0)
            }
        }
        j = i
        hex = 0
        IfCondition And(EqualTo(c0, 48), And(LessThan(Add(i, 2), n), Or(EqualTo(RDMEM_8(s, Add(i, 1)), 120), EqualTo(RDMEM_8(s, Add(i, 1)), 88)))) ThenBlock: {
            IfCondition GreaterEqual(SQL.HexNib(RDMEM_8(s, Add(i, 2))), 0) ThenBlock: {
                hex = 1
                j = Add(i, 2)
            }
        }
        isr = 0
        whole = 0
        ov = 0
        cap = 922337203685477580
        rf = Float_FromInt(0)
        sig = 0
        IfCondition EqualTo(hex, 1) ThenBlock: {
            stop = 0
            WhileLoop EqualTo(stop, 0) {
                IfCondition GreaterEqual(j, n) ThenBlock: {
                    stop = 1
                } ElseBlock: {
                    ch = RDMEM_8(s, j)
                    IfCondition EqualTo(ch, 95) ThenBlock: {
                        j = Add(j, 1)
                    } ElseBlock: {
                        nib = SQL.HexNib(ch)
                        IfCondition GreaterEqual(nib, 0) ThenBlock: {
                            rf = Float_Add(Float_Mul(rf, Float_FromInt(16)), Float_FromInt(nib))
                            IfCondition Or(GreaterThan(sig, 0), GreaterThan(nib, 0)) ThenBlock: { sig = Add(sig, 1) }
                            IfCondition GreaterThan(sig, 16) ThenBlock: {
                                ov = 1
                            } ElseBlock: {
                                whole = Add(LeftShift(whole, 4), nib)
                            }
                            j = Add(j, 1)
                        } ElseBlock: {
                            stop = 1
                        }
                    }
                }
            }
            IfCondition EqualTo(ov, 1) ThenBlock: { isr = 1 }
        } ElseBlock: {
            stop2 = 0
            sawdot = 0
            IfCondition EqualTo(c0, 46) ThenBlock: {
                sawdot = 1
                isr = 1
                j = Add(i, 1)
            }
            WhileLoop EqualTo(stop2, 0) {
                IfCondition GreaterEqual(j, n) ThenBlock: {
                    stop2 = 1
                } ElseBlock: {
                    ch2 = RDMEM_8(s, j)
                    IfCondition EqualTo(ch2, 95) ThenBlock: {
                        j = Add(j, 1)
                    } ElseBlock: {
                        IfCondition And(GreaterEqual(ch2, 48), LessEqual(ch2, 57)) ThenBlock: {
                            d = Subtract(ch2, 48)
                            IfCondition Or(GreaterThan(whole, cap), And(EqualTo(whole, cap), GreaterThan(d, 7))) ThenBlock: { ov = 1 }
                            IfCondition EqualTo(ov, 0) ThenBlock: { whole = Add(Multiply(whole, 10), d) }
                            j = Add(j, 1)
                        } ElseBlock: {
                            IfCondition And(EqualTo(ch2, 46), EqualTo(sawdot, 0)) ThenBlock: {
                                sawdot = 1
                                isr = 1
                                j = Add(j, 1)
                            } ElseBlock: {
                                stop2 = 1
                            }
                        }
                    }
                }
            }
            IfCondition And(LessThan(j, n), Or(EqualTo(RDMEM_8(s, j), 101), EqualTo(RDMEM_8(s, j), 69))) ThenBlock: {
                k = Add(j, 1)
                IfCondition And(LessThan(k, n), Or(EqualTo(RDMEM_8(s, k), 43), EqualTo(RDMEM_8(s, k), 45))) ThenBlock: {
                    k = Add(k, 1)
                }
                IfCondition And(LessThan(k, n), And(GreaterEqual(RDMEM_8(s, k), 48), LessEqual(RDMEM_8(s, k), 57))) ThenBlock: {
                    isr = 1
                    j = Add(j, 1)
                    IfCondition Or(EqualTo(RDMEM_8(s, j), 43), EqualTo(RDMEM_8(s, j), 45)) ThenBlock: { j = Add(j, 1) }
                    WhileLoop And(LessThan(j, n), Or(EqualTo(RDMEM_8(s, j), 95), And(GreaterEqual(RDMEM_8(s, j), 48), LessEqual(RDMEM_8(s, j), 57)))) {
                        j = Add(j, 1)
                    }
                }
            }
            IfCondition EqualTo(ov, 1) ThenBlock: { isr = 1 }
        }
        IfCondition And(LessThan(j, n), EqualTo(SQL.IsId2(RDMEM_8(s, j)), 1)) ThenBlock: {
            SQL.Fail("bad token")
            SQLS.tok = SQLT.EOF
            SQLS.pos = j
            ReturnValue(1)
        }
        txt = SQL.Str(Add(s, i), Subtract(j, i))
        SQLS.pos = j
        SQLS.tok = SQLT.NUMBER
        SQLS.ttext = txt
        SQLS.tfloat = isr
        IfCondition EqualTo(isr, 0) ThenBlock: {
            SQLS.tnum = whole
        } ElseBlock: {
            IfCondition EqualTo(hex, 1) ThenBlock: {
                SQLS.treal = rf
            } ElseBlock: {
                SQLS.treal = SQL.ParseReal(txt)
            }
        }
        ReturnValue(1)
    }
}

Function.SQL.LexStart {
    Input: s: Address
    Input: n: Integer
    Body: {
        SQLS.src = s
        SQLS.slen = n
        SQLS.pos = 0
        SQL.LexNext()
    }
}

Function.SQL.LexNext {
    Body: {
        s = SQLS.src
        n = SQLS.slen
        i = SQLS.pos
        WhileLoop LessThan(i, n) {
            c = RDMEM_8(s, i)
            IfCondition Or(EqualTo(c, 32), Or(EqualTo(c, 9), Or(EqualTo(c, 10), EqualTo(c, 13)))) ThenBlock: {
                i = Add(i, 1)
            } ElseBlock: {
                IfCondition And(EqualTo(c, 45), And(LessThan(Add(i, 1), n), EqualTo(RDMEM_8(s, Add(i, 1)), 45))) ThenBlock: {
                    i = Add(i, 2)
                    WhileLoop And(LessThan(i, n), NotEqual(RDMEM_8(s, i), 10)) {
                        i = Add(i, 1)
                    }
                } ElseBlock: {
                    i = i
                    // stop skip
                    n = i
                }
            }
            IfCondition EqualTo(i, n) ThenBlock: {
                // keep
                i = i
            }
        }
        // The loop above is wrong when we want to stop. Re-scan simply.
        i = SQLS.pos
        stop = 0
        WhileLoop And(LessThan(i, SQLS.slen), EqualTo(stop, 0)) {
            c = RDMEM_8(s, i)
            IfCondition Or(EqualTo(c, 32), Or(EqualTo(c, 9), Or(EqualTo(c, 10), EqualTo(c, 13)))) ThenBlock: {
                i = Add(i, 1)
            } ElseBlock: {
                IfCondition And(EqualTo(c, 45), And(LessThan(Add(i, 1), SQLS.slen), EqualTo(RDMEM_8(s, Add(i, 1)), 45))) ThenBlock: {
                    i = Add(i, 2)
                    WhileLoop And(LessThan(i, SQLS.slen), NotEqual(RDMEM_8(s, i), 10)) {
                        i = Add(i, 1)
                    }
                } ElseBlock: {
                    stop = 1
                }
            }
        }
        IfCondition GreaterEqual(i, SQLS.slen) ThenBlock: {
            SQLS.pos = i
            SQLS.tok = SQLT.EOF
            SQLS.ttext = ""
            ReturnValue(0)
        }
        c = RDMEM_8(s, i)
        IfCondition EqualTo(SQL.IsIdent(c), 1) ThenBlock: {
            j = Add(i, 1)
            WhileLoop And(LessThan(j, SQLS.slen), EqualTo(SQL.IsId2(RDMEM_8(s, j)), 1)) {
                j = Add(j, 1)
            }
            IfCondition EqualTo(Subtract(j, i), 1) ThenBlock: {
                c0 = RDMEM_8(s, i)
                IfCondition Or(EqualTo(c0, 120), EqualTo(c0, 88)) ThenBlock: {
                    IfCondition And(LessThan(j, SQLS.slen), EqualTo(RDMEM_8(s, j), 39)) ThenBlock: {
                        SQL.LexBlob(s, j)
                        ReturnValue(0)
                    }
                }
            }
            raw = SQL.Str(Add(s, i), Subtract(j, i))
            low = SQL.Lower(raw)
            kw = SQL.Kw(low)
            SQLS.pos = j
            SQLS.ttext = low
            IfCondition NotEqual(kw, 0) ThenBlock: {
                SQLS.tok = kw
            } ElseBlock: {
                SQLS.tok = SQLT.IDENT
            }
            ReturnValue(0)
        }
        IfCondition And(GreaterEqual(c, 48), LessEqual(c, 57)) ThenBlock: {
            SQL.LexNum(s, i)
            ReturnValue(0)
        }
        IfCondition EqualTo(c, 39) ThenBlock: {
            j = Add(i, 1)
            buf = SQL.Bump(Add(SQLS.slen, 1))
            k = 0
            done = 0
            WhileLoop And(LessThan(j, SQLS.slen), EqualTo(done, 0)) {
                ch = RDMEM_8(s, j)
                IfCondition EqualTo(ch, 39) ThenBlock: {
                    IfCondition And(LessThan(Add(j, 1), SQLS.slen), EqualTo(RDMEM_8(s, Add(j, 1)), 39)) ThenBlock: {
                        WRMEM_8(buf, k, 39)
                        k = Add(k, 1)
                        j = Add(j, 2)
                    } ElseBlock: {
                        done = 1
                        j = Add(j, 1)
                    }
                } ElseBlock: {
                    WRMEM_8(buf, k, ch)
                    k = Add(k, 1)
                    j = Add(j, 1)
                }
            }
            WRMEM_8(buf, k, 0)
            SQLS.pos = j
            SQLS.tok = SQLT.STRING
            SQLS.ttext = buf
            ReturnValue(0)
        }
        IfCondition EqualTo(c, 34) ThenBlock: {
            j = Add(i, 1)
            WhileLoop And(LessThan(j, SQLS.slen), NotEqual(RDMEM_8(s, j), 34)) {
                j = Add(j, 1)
            }
            raw2 = SQL.Str(Add(s, Add(i, 1)), Subtract(j, Add(i, 1)))
            SQLS.pos = Add(j, 1)
            SQLS.tok = SQLT.IDENT
            SQLS.ttext = SQL.Lower(raw2)
            ReturnValue(0)
        }
        nxt = 0
        IfCondition LessThan(Add(i, 1), SQLS.slen) ThenBlock: { nxt = RDMEM_8(s, Add(i, 1)) }
        IfCondition And(EqualTo(c, 60), EqualTo(nxt, 62)) ThenBlock: {
            SQLS.pos = Add(i, 2)
            SQLS.tok = SQLT.NE
            ReturnValue(0)
        }
        IfCondition And(EqualTo(c, 60), EqualTo(nxt, 61)) ThenBlock: {
            SQLS.pos = Add(i, 2)
            SQLS.tok = SQLT.LE
            ReturnValue(0)
        }
        IfCondition And(EqualTo(c, 62), EqualTo(nxt, 61)) ThenBlock: {
            SQLS.pos = Add(i, 2)
            SQLS.tok = SQLT.GE
            ReturnValue(0)
        }
        IfCondition And(EqualTo(c, 60), EqualTo(nxt, 60)) ThenBlock: {
            SQLS.pos = Add(i, 2)
            SQLS.tok = SQLT.LSH
            ReturnValue(0)
        }
        IfCondition And(EqualTo(c, 62), EqualTo(nxt, 62)) ThenBlock: {
            SQLS.pos = Add(i, 2)
            SQLS.tok = SQLT.RSH
            ReturnValue(0)
        }
        IfCondition And(EqualTo(c, 124), EqualTo(nxt, 124)) ThenBlock: {
            SQLS.pos = Add(i, 2)
            SQLS.tok = SQLT.CONCAT
            ReturnValue(0)
        }
        IfCondition And(EqualTo(c, 33), EqualTo(nxt, 61)) ThenBlock: {
            SQLS.pos = Add(i, 2)
            SQLS.tok = SQLT.NE
            ReturnValue(0)
        }
        IfCondition And(EqualTo(c, 61), EqualTo(nxt, 61)) ThenBlock: {
            SQLS.pos = Add(i, 2)
            SQLS.tok = SQLT.EQ
            ReturnValue(0)
        }
        SQLS.pos = Add(i, 1)
        IfCondition EqualTo(c, 40) ThenBlock: { SQLS.tok = SQLT.LP ReturnValue(0) }
        IfCondition EqualTo(c, 41) ThenBlock: { SQLS.tok = SQLT.RP ReturnValue(0) }
        IfCondition EqualTo(c, 44) ThenBlock: { SQLS.tok = SQLT.COMMA ReturnValue(0) }
        IfCondition EqualTo(c, 46) ThenBlock: {
            IfCondition EqualTo(SQL.LexNum(s, i), 1) ThenBlock: { ReturnValue(0) }
            SQLS.tok = SQLT.DOT
            ReturnValue(0)
        }
        IfCondition EqualTo(c, 42) ThenBlock: { SQLS.tok = SQLT.STAR ReturnValue(0) }
        IfCondition EqualTo(c, 59) ThenBlock: { SQLS.tok = SQLT.SEMI ReturnValue(0) }
        IfCondition EqualTo(c, 43) ThenBlock: { SQLS.tok = SQLT.PLUS ReturnValue(0) }
        IfCondition EqualTo(c, 45) ThenBlock: { SQLS.tok = SQLT.MINUS ReturnValue(0) }
        IfCondition EqualTo(c, 47) ThenBlock: { SQLS.tok = SQLT.SLASH ReturnValue(0) }
        IfCondition EqualTo(c, 37) ThenBlock: { SQLS.tok = SQLT.PERCENT ReturnValue(0) }
        IfCondition EqualTo(c, 61) ThenBlock: { SQLS.tok = SQLT.EQ ReturnValue(0) }
        IfCondition EqualTo(c, 60) ThenBlock: { SQLS.tok = SQLT.LT ReturnValue(0) }
        IfCondition EqualTo(c, 62) ThenBlock: { SQLS.tok = SQLT.GT ReturnValue(0) }
        IfCondition EqualTo(c, 38) ThenBlock: { SQLS.tok = SQLT.AMP ReturnValue(0) }
        IfCondition EqualTo(c, 124) ThenBlock: { SQLS.tok = SQLT.PIPE ReturnValue(0) }
        IfCondition EqualTo(c, 126) ThenBlock: { SQLS.tok = SQLT.TILDE ReturnValue(0) }
        SQL.Fail("bad token")
        SQLS.tok = SQLT.EOF
        ReturnValue(0)
    }
}

Function.SQL.HexNib {
    Input: c: Integer
    Output: Integer
    Body: {
        IfCondition And(GreaterEqual(c, 48), LessEqual(c, 57)) ThenBlock: { ReturnValue(Subtract(c, 48)) }
        IfCondition And(GreaterEqual(c, 97), LessEqual(c, 102)) ThenBlock: { ReturnValue(Subtract(c, 87)) }
        IfCondition And(GreaterEqual(c, 65), LessEqual(c, 70)) ThenBlock: { ReturnValue(Subtract(c, 55)) }
        ReturnValue(-1)
    }
}

Function.SQL.LexBlob {
    Input: s: Address
    Input: j: Integer
    Output: Integer
    Body: {
        p = Add(j, 1)
        nhex = 0
        WhileLoop And(LessThan(p, SQLS.slen), NotEqual(RDMEM_8(s, p), 39)) {
            nhex = Add(nhex, 1)
            p = Add(p, 1)
        }
        IfCondition Or(GreaterEqual(p, SQLS.slen), NotEqual(Modulo(nhex, 2), 0)) ThenBlock: {
            SQL.Fail("bad token")
            SQLS.tok = SQLT.EOF
            ReturnValue(0)
        }
        nbytes = Divide(nhex, 2)
        buf = SQL.Bump(Add(nbytes, 1))
        i = 0
        q = Add(j, 1)
        WhileLoop LessThan(i, nbytes) {
            hi = SQL.HexNib(RDMEM_8(s, q))
            lo = SQL.HexNib(RDMEM_8(s, Add(q, 1)))
            IfCondition Or(LessThan(hi, 0), LessThan(lo, 0)) ThenBlock: {
                SQL.Fail("bad token")
                SQLS.tok = SQLT.EOF
                ReturnValue(0)
            }
            WRMEM_8(buf, i, Add(LeftShift(hi, 4), lo))
            q = Add(q, 2)
            i = Add(i, 1)
        }
        WRMEM_8(buf, nbytes, 0)
        SQLS.pos = Add(p, 1)
        SQLS.tok = SQLT.BLIT
        SQLS.ttext = buf
        SQLS.tlen = nbytes
        ReturnValue(1)
    }
}

Function.SQL.Accept {
    Input: k: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(SQLS.tok, k) ThenBlock: {
            SQL.LexNext()
            ReturnValue(1)
        }
        ReturnValue(0)
    }
}

Function.SQL.Expect {
    Input: k: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(SQL.Accept(k), 1) ThenBlock: { ReturnValue(1) }
        SQL.Fail("syntax")
        ReturnValue(0)
    }
}
