// Library.SQLMD5.ailang — Colin Plumb MD5, the sqllogictest digest.
// 32-bit wraps are masked. The hex digest is lowercase, little-endian.
// Copyright (c) 2026 Sean Collins, 2 Paws Machine and Engineering. SCSL.

LibraryImport.Arena

FixedPool.MD5S {
    "blk": Initialize=0, CanChange=True
    "out": Initialize=0, CanChange=True
    "init": Initialize=0, CanChange=True
    "a": Initialize=0, CanChange=True
    "b": Initialize=0, CanChange=True
    "c": Initialize=0, CanChange=True
    "d": Initialize=0, CanChange=True
    "bits0": Initialize=0, CanChange=True
    "bits1": Initialize=0, CanChange=True
}

Function.MD5.Mask {
    Input: x: Integer
    Output: Integer
    Body: {
        ReturnValue(BitwiseAnd(x, 4294967295))
    }
}

Function.MD5.Add {
    Input: a: Integer
    Input: b: Integer
    Output: Integer
    Body: {
        ReturnValue(MD5.Mask(Add(a, b)))
    }
}

Function.MD5.Rot {
    Input: w: Integer
    Input: s: Integer
    Output: Integer
    Body: {
        w = MD5.Mask(w)
        left = LeftShift(w, s)
        right = RightShift(w, Subtract(32, s))
        ReturnValue(MD5.Mask(BitwiseOr(left, right)))
    }
}

Function.MD5.F1 {
    Input: x: Integer
    Input: y: Integer
    Input: z: Integer
    Output: Integer
    Body: {
        ReturnValue(MD5.Mask(BitwiseXor(z, BitwiseAnd(x, BitwiseXor(y, z)))))
    }
}

Function.MD5.F2 {
    Input: x: Integer
    Input: y: Integer
    Input: z: Integer
    Output: Integer
    Body: {
        ReturnValue(MD5.F1(z, x, y))
    }
}

Function.MD5.F3 {
    Input: x: Integer
    Input: y: Integer
    Input: z: Integer
    Output: Integer
    Body: {
        ReturnValue(MD5.Mask(BitwiseXor(x, BitwiseXor(y, z))))
    }
}

Function.MD5.F4 {
    Input: x: Integer
    Input: y: Integer
    Input: z: Integer
    Output: Integer
    Body: {
        nz = MD5.Mask(BitwiseNot(z))
        ReturnValue(MD5.Mask(BitwiseXor(y, BitwiseOr(x, nz))))
    }
}

Function.MD5.Step {
    Input: w: Integer
    Input: x: Integer
    Input: f: Integer
    Input: word: Integer
    Input: k: Integer
    Input: s: Integer
    Output: Integer
    Body: {
        w = MD5.Add(w, MD5.Add(f, MD5.Add(word, k)))
        w = MD5.Rot(w, s)
        w = MD5.Add(w, x)
        ReturnValue(w)
    }
}

Function.MD5.Word {
    Input: blk: Address
    Input: i: Integer
    Output: Integer
    Body: {
        ReturnValue(MD5.Mask(RDMEM_32(blk, Multiply(i, 4))))
    }
}

Function.MD5.Transform {
    Input: blk: Address
    Body: {
        a = MD5S.a
        b = MD5S.b
        c = MD5S.c
        d = MD5S.d

        a = MD5.Step(a, b, MD5.F1(b, c, d), MD5.Word(blk, 0), 3614090360, 7)
        d = MD5.Step(d, a, MD5.F1(a, b, c), MD5.Word(blk, 1), 3905402710, 12)
        c = MD5.Step(c, d, MD5.F1(d, a, b), MD5.Word(blk, 2), 606105819, 17)
        b = MD5.Step(b, c, MD5.F1(c, d, a), MD5.Word(blk, 3), 3250441966, 22)
        a = MD5.Step(a, b, MD5.F1(b, c, d), MD5.Word(blk, 4), 4118548399, 7)
        d = MD5.Step(d, a, MD5.F1(a, b, c), MD5.Word(blk, 5), 1200080426, 12)
        c = MD5.Step(c, d, MD5.F1(d, a, b), MD5.Word(blk, 6), 2821735955, 17)
        b = MD5.Step(b, c, MD5.F1(c, d, a), MD5.Word(blk, 7), 4249261313, 22)
        a = MD5.Step(a, b, MD5.F1(b, c, d), MD5.Word(blk, 8), 1770035416, 7)
        d = MD5.Step(d, a, MD5.F1(a, b, c), MD5.Word(blk, 9), 2336552879, 12)
        c = MD5.Step(c, d, MD5.F1(d, a, b), MD5.Word(blk, 10), 4294925233, 17)
        b = MD5.Step(b, c, MD5.F1(c, d, a), MD5.Word(blk, 11), 2304563134, 22)
        a = MD5.Step(a, b, MD5.F1(b, c, d), MD5.Word(blk, 12), 1804603682, 7)
        d = MD5.Step(d, a, MD5.F1(a, b, c), MD5.Word(blk, 13), 4254626195, 12)
        c = MD5.Step(c, d, MD5.F1(d, a, b), MD5.Word(blk, 14), 2792965006, 17)
        b = MD5.Step(b, c, MD5.F1(c, d, a), MD5.Word(blk, 15), 1236535329, 22)
        a = MD5.Step(a, b, MD5.F2(b, c, d), MD5.Word(blk, 1), 4129170786, 5)
        d = MD5.Step(d, a, MD5.F2(a, b, c), MD5.Word(blk, 6), 3225465664, 9)
        c = MD5.Step(c, d, MD5.F2(d, a, b), MD5.Word(blk, 11), 643717713, 14)
        b = MD5.Step(b, c, MD5.F2(c, d, a), MD5.Word(blk, 0), 3921069994, 20)
        a = MD5.Step(a, b, MD5.F2(b, c, d), MD5.Word(blk, 5), 3593408605, 5)
        d = MD5.Step(d, a, MD5.F2(a, b, c), MD5.Word(blk, 10), 38016083, 9)
        c = MD5.Step(c, d, MD5.F2(d, a, b), MD5.Word(blk, 15), 3634488961, 14)
        b = MD5.Step(b, c, MD5.F2(c, d, a), MD5.Word(blk, 4), 3889429448, 20)
        a = MD5.Step(a, b, MD5.F2(b, c, d), MD5.Word(blk, 9), 568446438, 5)
        d = MD5.Step(d, a, MD5.F2(a, b, c), MD5.Word(blk, 14), 3275163606, 9)
        c = MD5.Step(c, d, MD5.F2(d, a, b), MD5.Word(blk, 3), 4107603335, 14)
        b = MD5.Step(b, c, MD5.F2(c, d, a), MD5.Word(blk, 8), 1163531501, 20)
        a = MD5.Step(a, b, MD5.F2(b, c, d), MD5.Word(blk, 13), 2850285829, 5)
        d = MD5.Step(d, a, MD5.F2(a, b, c), MD5.Word(blk, 2), 4243563512, 9)
        c = MD5.Step(c, d, MD5.F2(d, a, b), MD5.Word(blk, 7), 1735328473, 14)
        b = MD5.Step(b, c, MD5.F2(c, d, a), MD5.Word(blk, 12), 2368359562, 20)
        a = MD5.Step(a, b, MD5.F3(b, c, d), MD5.Word(blk, 5), 4294588738, 4)
        d = MD5.Step(d, a, MD5.F3(a, b, c), MD5.Word(blk, 8), 2272392833, 11)
        c = MD5.Step(c, d, MD5.F3(d, a, b), MD5.Word(blk, 11), 1839030562, 16)
        b = MD5.Step(b, c, MD5.F3(c, d, a), MD5.Word(blk, 14), 4259657740, 23)
        a = MD5.Step(a, b, MD5.F3(b, c, d), MD5.Word(blk, 1), 2763975236, 4)
        d = MD5.Step(d, a, MD5.F3(a, b, c), MD5.Word(blk, 4), 1272893353, 11)
        c = MD5.Step(c, d, MD5.F3(d, a, b), MD5.Word(blk, 7), 4139469664, 16)
        b = MD5.Step(b, c, MD5.F3(c, d, a), MD5.Word(blk, 10), 3200236656, 23)
        a = MD5.Step(a, b, MD5.F3(b, c, d), MD5.Word(blk, 13), 681279174, 4)
        d = MD5.Step(d, a, MD5.F3(a, b, c), MD5.Word(blk, 0), 3936430074, 11)
        c = MD5.Step(c, d, MD5.F3(d, a, b), MD5.Word(blk, 3), 3572445317, 16)
        b = MD5.Step(b, c, MD5.F3(c, d, a), MD5.Word(blk, 6), 76029189, 23)
        a = MD5.Step(a, b, MD5.F3(b, c, d), MD5.Word(blk, 9), 3654602809, 4)
        d = MD5.Step(d, a, MD5.F3(a, b, c), MD5.Word(blk, 12), 3873151461, 11)
        c = MD5.Step(c, d, MD5.F3(d, a, b), MD5.Word(blk, 15), 530742520, 16)
        b = MD5.Step(b, c, MD5.F3(c, d, a), MD5.Word(blk, 2), 3299628645, 23)
        a = MD5.Step(a, b, MD5.F4(b, c, d), MD5.Word(blk, 0), 4096336452, 6)
        d = MD5.Step(d, a, MD5.F4(a, b, c), MD5.Word(blk, 7), 1126891415, 10)
        c = MD5.Step(c, d, MD5.F4(d, a, b), MD5.Word(blk, 14), 2878612391, 15)
        b = MD5.Step(b, c, MD5.F4(c, d, a), MD5.Word(blk, 5), 4237533241, 21)
        a = MD5.Step(a, b, MD5.F4(b, c, d), MD5.Word(blk, 12), 1700485571, 6)
        d = MD5.Step(d, a, MD5.F4(a, b, c), MD5.Word(blk, 3), 2399980690, 10)
        c = MD5.Step(c, d, MD5.F4(d, a, b), MD5.Word(blk, 10), 4293915773, 15)
        b = MD5.Step(b, c, MD5.F4(c, d, a), MD5.Word(blk, 1), 2240044497, 21)
        a = MD5.Step(a, b, MD5.F4(b, c, d), MD5.Word(blk, 8), 1873313359, 6)
        d = MD5.Step(d, a, MD5.F4(a, b, c), MD5.Word(blk, 15), 4264355552, 10)
        c = MD5.Step(c, d, MD5.F4(d, a, b), MD5.Word(blk, 6), 2734768916, 15)
        b = MD5.Step(b, c, MD5.F4(c, d, a), MD5.Word(blk, 13), 1309151649, 21)
        a = MD5.Step(a, b, MD5.F4(b, c, d), MD5.Word(blk, 4), 4149444226, 6)
        d = MD5.Step(d, a, MD5.F4(a, b, c), MD5.Word(blk, 11), 3174756917, 10)
        c = MD5.Step(c, d, MD5.F4(d, a, b), MD5.Word(blk, 2), 718787259, 15)
        b = MD5.Step(b, c, MD5.F4(c, d, a), MD5.Word(blk, 9), 3951481745, 21)
        MD5S.a = MD5.Add(MD5S.a, a)
        MD5S.b = MD5.Add(MD5S.b, b)
        MD5S.c = MD5.Add(MD5S.c, c)
        MD5S.d = MD5.Add(MD5S.d, d)
    }
}

Function.MD5.Copy {
    Input: dst: Address
    Input: doff: Integer
    Input: src: Address
    Input: n: Integer
    Body: {
        i = 0
        WhileLoop LessThan(i, n) {
            WRMEM_8(dst, Add(doff, i), RDMEM_8(src, i))
            i = Add(i, 1)
        }
    }
}

Function.MD5.Zero {
    Input: p: Address
    Input: off: Integer
    Input: n: Integer
    Body: {
        i = 0
        WhileLoop LessThan(i, n) {
            WRMEM_8(p, Add(off, i), 0)
            i = Add(i, 1)
        }
    }
}

Function.MD5.Reverse {
    Input: blk: Address
    Input: nwords: Integer
    Body: {
        i = 0
        WhileLoop LessThan(i, nwords) {
            o = Multiply(i, 4)
            b0 = RDMEM_8(blk, o)
            b1 = RDMEM_8(blk, Add(o, 1))
            b2 = RDMEM_8(blk, Add(o, 2))
            b3 = RDMEM_8(blk, Add(o, 3))
            t = Add(b0, LeftShift(b1, 8))
            t = Add(t, LeftShift(b2, 16))
            t = Add(t, LeftShift(b3, 24))
            WRMEM_32(blk, o, MD5.Mask(t))
            i = Add(i, 1)
        }
    }
}

Function.MD5.Boot {
    Output: Integer
    Body: {
        IfCondition NotEqual(MD5S.blk, 0) ThenBlock: {
            ReturnValue(0)
        }
        MD5S.blk = Allocate(64)
        MemorySet(MD5S.blk, 0, 64)
        MD5S.out = Allocate(33)
        MemorySet(MD5S.out, 0, 33)
        MD5S.init = 0
        ReturnValue(1)
    }
}

Function.MD5.ResetState {
    Body: {
        MD5S.a = 1732584193
        MD5S.b = 4023233417
        MD5S.c = 2562383102
        MD5S.d = 271733878
        MD5S.bits0 = 0
        MD5S.bits1 = 0
        MD5S.init = 1
    }
}

Function.MD5.Start {
    Body: {
        MD5.Boot()
        MD5.ResetState()
    }
}

Function.MD5.Update {
    Input: src: Address
    Input: len: Integer
    Body: {
        t = MD5S.bits0
        low = MD5.Mask(LeftShift(MD5.Mask(len), 3))
        MD5S.bits0 = MD5.Add(t, low)
        IfCondition LessThan(MD5S.bits0, t) ThenBlock: {
            MD5S.bits1 = MD5.Add(MD5S.bits1, 1)
        }
        MD5S.bits1 = MD5.Add(MD5S.bits1, RightShift(len, 29))
        have = BitwiseAnd(RightShift(t, 3), 63)
        off = 0
        done = 0
        IfCondition GreaterThan(have, 0) ThenBlock: {
            need = Subtract(64, have)
            IfCondition LessThan(len, need) ThenBlock: {
                MD5.Copy(MD5S.blk, have, src, len)
                done = 1
            } ElseBlock: {
                MD5.Copy(MD5S.blk, have, src, need)
                MD5.Reverse(MD5S.blk, 16)
                MD5.Transform(MD5S.blk)
                off = need
                len = Subtract(len, need)
            }
        }
        IfCondition EqualTo(done, 0) ThenBlock: {
            WhileLoop GreaterEqual(len, 64) {
                MD5.Copy(MD5S.blk, 0, Add(src, off), 64)
                MD5.Reverse(MD5S.blk, 16)
                MD5.Transform(MD5S.blk)
                off = Add(off, 64)
                len = Subtract(len, 64)
            }
            IfCondition GreaterThan(len, 0) ThenBlock: {
                MD5.Copy(MD5S.blk, 0, Add(src, off), len)
            }
        }
    }
}

Function.MD5.PutWord {
    Input: p: Address
    Input: off: Integer
    Input: w: Integer
    Body: {
        w = MD5.Mask(w)
        WRMEM_8(p, off, BitwiseAnd(w, 255))
        WRMEM_8(p, Add(off, 1), BitwiseAnd(RightShift(w, 8), 255))
        WRMEM_8(p, Add(off, 2), BitwiseAnd(RightShift(w, 16), 255))
        WRMEM_8(p, Add(off, 3), BitwiseAnd(RightShift(w, 24), 255))
    }
}

Function.MD5.HexDig {
    Input: n: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(n, 10) ThenBlock: { ReturnValue(Add(48, n)) }
        ReturnValue(Add(87, n))
    }
}

Function.MD5.HexState {
    Body: {
        dig = Allocate(16)
        MD5.PutWord(dig, 0, MD5S.a)
        MD5.PutWord(dig, 4, MD5S.b)
        MD5.PutWord(dig, 8, MD5S.c)
        MD5.PutWord(dig, 12, MD5S.d)
        i = 0
        WhileLoop LessThan(i, 16) {
            v = RDMEM_8(dig, i)
            hi = MD5.HexDig(RightShift(v, 4))
            lo = MD5.HexDig(BitwiseAnd(v, 15))
            WRMEM_8(MD5S.out, Multiply(i, 2), hi)
            WRMEM_8(MD5S.out, Add(Multiply(i, 2), 1), lo)
            i = Add(i, 1)
        }
        WRMEM_8(MD5S.out, 32, 0)
        Deallocate(dig, 16)
    }
}

Function.MD5.Final {
    Body: {
        count = BitwiseAnd(RightShift(MD5S.bits0, 3), 63)
        WRMEM_8(MD5S.blk, count, 128)
        pad = Subtract(63, count)
        start = Add(count, 1)
        IfCondition LessThan(pad, 8) ThenBlock: {
            MD5.Zero(MD5S.blk, start, pad)
            MD5.Reverse(MD5S.blk, 16)
            MD5.Transform(MD5S.blk)
            MD5.Zero(MD5S.blk, 0, 56)
        } ElseBlock: {
            MD5.Zero(MD5S.blk, start, Subtract(pad, 8))
        }
        MD5.Reverse(MD5S.blk, 14)
        WRMEM_32(MD5S.blk, 56, MD5.Mask(MD5S.bits0))
        WRMEM_32(MD5S.blk, 60, MD5.Mask(MD5S.bits1))
        MD5.Transform(MD5S.blk)
        MD5.HexState()
    }
}

Function.MD5.Absorb {
    Input: s: Address
    Body: {
        MD5.Boot()
        IfCondition EqualTo(MD5S.init, 0) ThenBlock: { MD5.ResetState() }
        MD5.Update(s, StringLength(s))
    }
}

Function.MD5.Finish {
    Output: Address
    Body: {
        MD5.Boot()
        IfCondition EqualTo(MD5S.init, 0) ThenBlock: {
            back = Add(MD5S.out, 0)
            ReturnValue(back)
        }
        MD5.Final()
        MD5S.init = 0
        back2 = Add(MD5S.out, 0)
        ReturnValue(back2)
    }
}
