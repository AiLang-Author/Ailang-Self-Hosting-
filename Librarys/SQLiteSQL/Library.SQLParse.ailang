// Library.SQLParse.ailang — recursive-descent SQL parser.
// Each grammar layer is its own function. SQL.ParseStmt is the entry.
// Copyright (c) 2026 Sean Collins, 2 Paws Machine and Engineering. SCSL.

LibraryImport.SQLiteSQL.SQLLex
LibraryImport.SQLiteSQL.SQLVal

Function.SQL.Bin {
    Input: op: Integer
    Input: x: Address
    Input: y: Address
    Output: Address
    Body: {
        n = SQL.Node(SQLK.BIN)
        SQL.SetFlags(n, op)
        SQL.SetA(n, x)
        SQL.SetB(n, y)
        ReturnValue(n)
    }
}

Function.SQL.Un {
    Input: op: Integer
    Input: x: Address
    Output: Address
    Body: {
        n = SQL.Node(SQLK.UN)
        SQL.SetFlags(n, op)
        SQL.SetA(n, x)
        ReturnValue(n)
    }
}

Function.SQL.Cons {
    Input: item: Address
    Input: nxt: Address
    Output: Address
    Body: {
        n = SQL.Node(SQLK.LIST)
        SQL.SetA(n, item)
        SQL.SetB(n, nxt)
        ReturnValue(n)
    }
}

Function.SQL.PPrimary {
    Output: Address
    Body: {
        IfCondition NotEqual(SQLS.err, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(SQLS.tok, SQLT.NULL) ThenBlock: {
            SQL.LexNext()
            ReturnValue(SQL.Node(SQLK.NULL))
        }
        IfCondition EqualTo(SQLS.tok, SQLT.NUMBER) ThenBlock: {
            isr = SQLS.tfloat
            iv = SQLS.tnum
            rv = SQLS.treal
            SQL.LexNext()
            IfCondition EqualTo(isr, 1) ThenBlock: {
                n = SQL.Node(SQLK.REAL)
                SQL.SetA(n, rv)
                ReturnValue(n)
            }
            n2 = SQL.Node(SQLK.INT)
            SQL.SetA(n2, iv)
            ReturnValue(n2)
        }
        IfCondition EqualTo(SQLS.tok, SQLT.STRING) ThenBlock: {
            tx = SQLS.ttext
            SQL.LexNext()
            n3 = SQL.Node(SQLK.TEXT)
            SQL.SetA(n3, tx)
            ReturnValue(n3)
        }
        IfCondition EqualTo(SQLS.tok, SQLT.BLIT) ThenBlock: {
            bx = SQLS.ttext
            bl = SQLS.tlen
            SQL.LexNext()
            nb = SQL.Node(SQLK.BLOB)
            SQL.SetA(nb, bx)
            SQL.SetB(nb, bl)
            ReturnValue(nb)
        }
        IfCondition EqualTo(SQLS.tok, SQLT.STAR) ThenBlock: {
            SQL.LexNext()
            ReturnValue(SQL.Node(SQLK.STAR))
        }
        IfCondition EqualTo(SQLS.tok, SQLT.EXISTS) ThenBlock: {
            SQL.LexNext()
            SQL.Expect(SQLT.LP)
            q = SQL.ParseSelect()
            SQL.Expect(SQLT.RP)
            n4 = SQL.Node(SQLK.EXISTS)
            SQL.SetA(n4, q)
            ReturnValue(n4)
        }
        IfCondition EqualTo(SQLS.tok, SQLT.CAST) ThenBlock: {
            SQL.LexNext()
            SQL.Expect(SQLT.LP)
            inner = SQL.ParseExpr()
            SQL.Expect(SQLT.AS)
            aff = SQL.ParseAff()
            SQL.Expect(SQLT.RP)
            n5 = SQL.Node(SQLK.CAST)
            SQL.SetFlags(n5, aff)
            SQL.SetA(n5, inner)
            ReturnValue(n5)
        }
        IfCondition EqualTo(SQLS.tok, SQLT.CASE) ThenBlock: {
            ReturnValue(SQL.ParseCase())
        }
        IfCondition EqualTo(SQLS.tok, SQLT.LP) ThenBlock: {
            SQL.LexNext()
            IfCondition EqualTo(SQLS.tok, SQLT.SELECT) ThenBlock: {
                q2 = SQL.ParseSelect()
                SQL.Expect(SQLT.RP)
                n6 = SQL.Node(SQLK.EXISTS)
                SQL.SetFlags(n6, 1)
                SQL.SetA(n6, q2)
                ReturnValue(n6)
            }
            e = SQL.ParseExpr()
            SQL.Expect(SQLT.RP)
            ReturnValue(e)
        }
        IfCondition EqualTo(SQLS.tok, SQLT.IDENT) ThenBlock: {
            name = SQLS.ttext
            SQL.LexNext()
            IfCondition EqualTo(SQLS.tok, SQLT.DOT) ThenBlock: {
                SQL.LexNext()
                IfCondition EqualTo(SQLS.tok, SQLT.STAR) ThenBlock: {
                    SQL.LexNext()
                    st = SQL.Node(SQLK.STAR)
                    SQL.SetA(st, name)
                    ReturnValue(st)
                }
                col = SQLS.ttext
                SQL.LexNext()
                cn = SQL.Node(SQLK.COL)
                SQL.SetA(cn, name)
                SQL.SetB(cn, col)
                ReturnValue(cn)
            }
            IfCondition EqualTo(SQLS.tok, SQLT.LP) ThenBlock: {
                ReturnValue(SQL.ParseCall(name))
            }
            cn2 = SQL.Node(SQLK.COL)
            SQL.SetB(cn2, name)
            ReturnValue(cn2)
        }
        SQL.Fail("expr")
        ReturnValue(0)
    }
}

Function.SQL.ParseAff {
    Output: Integer
    Body: {
        t = SQLS.tok
        aff = SQLA.NONE
        IfCondition Or(EqualTo(t, SQLT.INTEGER), Or(EqualTo(t, SQLT.INT), EqualTo(t, SQLT.SIGNED))) ThenBlock: { aff = SQLA.INT }
        IfCondition Or(EqualTo(t, SQLT.REAL), Or(EqualTo(t, SQLT.FLOAT), EqualTo(t, SQLT.DOUBLE))) ThenBlock: { aff = SQLA.REAL }
        IfCondition Or(EqualTo(t, SQLT.TEXT), Or(EqualTo(t, SQLT.VARCHAR), EqualTo(t, SQLT.CHAR))) ThenBlock: { aff = SQLA.TEXT }
        IfCondition Or(EqualTo(t, SQLT.NUMERIC), EqualTo(t, SQLT.DECIMAL)) ThenBlock: { aff = SQLA.NUM }
        IfCondition EqualTo(t, SQLT.BLOB) ThenBlock: { aff = SQLA.BLOB }
        SQL.LexNext()
        IfCondition EqualTo(SQLS.tok, SQLT.LP) ThenBlock: {
            SQL.LexNext()
            IfCondition EqualTo(SQLS.tok, SQLT.NUMBER) ThenBlock: { SQL.LexNext() }
            IfCondition EqualTo(SQLS.tok, SQLT.COMMA) ThenBlock: {
                SQL.LexNext()
                IfCondition EqualTo(SQLS.tok, SQLT.NUMBER) ThenBlock: { SQL.LexNext() }
            }
            SQL.Expect(SQLT.RP)
        }
        ReturnValue(aff)
    }
}

Function.SQL.ParseCall {
    Input: name: Address
    Output: Address
    Body: {
        SQL.Expect(SQLT.LP)
        n = SQL.Node(SQLK.CALL)
        SQL.SetA(n, name)
        dist = 0
        IfCondition EqualTo(SQLS.tok, SQLT.DISTINCT) ThenBlock: {
            dist = 1
            SQL.LexNext()
        }
        // count(ALL x) is the same call as count(x).
        IfCondition EqualTo(SQLS.tok, SQLT.ALL) ThenBlock: {
            SQL.LexNext()
        }
        IfCondition EqualTo(SQLS.tok, SQLT.STAR) ThenBlock: {
            SQL.LexNext()
            SQL.SetFlags(n, Add(dist, 2))
            SQL.Expect(SQLT.RP)
            ReturnValue(n)
        }
        IfCondition EqualTo(SQLS.tok, SQLT.RP) ThenBlock: {
            SQL.LexNext()
            SQL.SetFlags(n, dist)
            ReturnValue(n)
        }
        head = 0
        tail = 0
        WhileLoop EqualTo(SQLS.err, 0) {
            a = SQL.ParseExpr()
            cell = SQL.Cons(a, 0)
            IfCondition EqualTo(head, 0) ThenBlock: { head = cell } ElseBlock: { SQL.SetB(tail, cell) }
            tail = cell
            IfCondition EqualTo(SQL.Accept(SQLT.COMMA), 0) ThenBlock: {
                SQL.SetB(n, head)
                SQL.SetFlags(n, dist)
                SQL.Expect(SQLT.RP)
                ReturnValue(n)
            }
        }
        ReturnValue(0)
    }
}

Function.SQL.ParseCase {
    Output: Address
    Body: {
        SQL.LexNext()
        base = 0
        simple = 0
        IfCondition NotEqual(SQLS.tok, SQLT.WHEN) ThenBlock: {
            simple = 1
            base = SQL.ParseExpr()
        }
        head = 0
        tail = 0
        WhileLoop EqualTo(SQLS.tok, SQLT.WHEN) {
            SQL.LexNext()
            w = SQL.ParseExpr()
            SQL.Expect(SQLT.THEN)
            t = SQL.ParseExpr()
            wn = SQL.Node(SQLK.WHEN)
            SQL.SetA(wn, w)
            SQL.SetB(wn, t)
            IfCondition EqualTo(head, 0) ThenBlock: { head = wn } ElseBlock: { SQL.SetC(tail, wn) }
            tail = wn
        }
        els = 0
        IfCondition EqualTo(SQLS.tok, SQLT.ELSE) ThenBlock: {
            SQL.LexNext()
            els = SQL.ParseExpr()
        }
        SQL.Expect(SQLT.END)
        n = SQL.Node(SQLK.CASE)
        SQL.SetFlags(n, simple)
        SQL.SetA(n, base)
        SQL.SetB(n, head)
        SQL.SetC(n, els)
        ReturnValue(n)
    }
}

Function.SQL.PUnary {
    Output: Address
    Body: {
        IfCondition EqualTo(SQLS.tok, SQLT.PLUS) ThenBlock: {
            SQL.LexNext()
            ReturnValue(SQL.Un(SQLU.PLUS, SQL.PUnary()))
        }
        IfCondition EqualTo(SQLS.tok, SQLT.MINUS) ThenBlock: {
            SQL.LexNext()
            ReturnValue(SQL.Un(SQLU.NEG, SQL.PUnary()))
        }
        IfCondition EqualTo(SQLS.tok, SQLT.TILDE) ThenBlock: {
            SQL.LexNext()
            ReturnValue(SQL.Un(SQLU.BNOT, SQL.PUnary()))
        }
        ReturnValue(SQL.PPrimary())
    }
}

Function.SQL.PConcat {
    Output: Address
    Body: {
        left = SQL.PUnary()
        WhileLoop EqualTo(SQLS.err, 0) {
            IfCondition NotEqual(SQLS.tok, SQLT.CONCAT) ThenBlock: { ReturnValue(left) }
            SQL.LexNext()
            right = SQL.PUnary()
            left = SQL.Bin(SQLB.CONCAT, left, right)
        }
        ReturnValue(left)
    }
}

Function.SQL.PMul {
    Output: Address
    Body: {
        left = SQL.PConcat()
        WhileLoop EqualTo(SQLS.err, 0) {
            op = 0
            IfCondition EqualTo(SQLS.tok, SQLT.STAR) ThenBlock: { op = SQLB.MUL }
            IfCondition EqualTo(SQLS.tok, SQLT.SLASH) ThenBlock: { op = SQLB.DIV }
            IfCondition EqualTo(SQLS.tok, SQLT.PERCENT) ThenBlock: { op = SQLB.MOD }
            IfCondition EqualTo(op, 0) ThenBlock: { ReturnValue(left) }
            SQL.LexNext()
            right = SQL.PConcat()
            left = SQL.Bin(op, left, right)
        }
        ReturnValue(left)
    }
}

Function.SQL.PAdd {
    Output: Address
    Body: {
        left = SQL.PMul()
        WhileLoop EqualTo(SQLS.err, 0) {
            op = 0
            IfCondition EqualTo(SQLS.tok, SQLT.PLUS) ThenBlock: { op = SQLB.ADD }
            IfCondition EqualTo(SQLS.tok, SQLT.MINUS) ThenBlock: { op = SQLB.SUB }
            IfCondition EqualTo(op, 0) ThenBlock: { ReturnValue(left) }
            SQL.LexNext()
            right = SQL.PMul()
            left = SQL.Bin(op, left, right)
        }
        ReturnValue(left)
    }
}

Function.SQL.PShift {
    Output: Address
    Body: {
        left = SQL.PAdd()
        WhileLoop EqualTo(SQLS.err, 0) {
            op = 0
            IfCondition EqualTo(SQLS.tok, SQLT.LSH) ThenBlock: { op = SQLB.SHL }
            IfCondition EqualTo(SQLS.tok, SQLT.RSH) ThenBlock: { op = SQLB.SHR }
            IfCondition EqualTo(SQLS.tok, SQLT.AMP) ThenBlock: { op = SQLB.BAND }
            IfCondition EqualTo(SQLS.tok, SQLT.PIPE) ThenBlock: { op = SQLB.BOR }
            IfCondition EqualTo(op, 0) ThenBlock: { ReturnValue(left) }
            SQL.LexNext()
            right = SQL.PAdd()
            left = SQL.Bin(op, left, right)
        }
        ReturnValue(left)
    }
}

Function.SQL.PCmp {
    Output: Address
    Body: {
        left = SQL.PShift()
        WhileLoop EqualTo(SQLS.err, 0) {
            IfCondition EqualTo(SQLS.tok, SQLT.ISNULL) ThenBlock: {
                SQL.LexNext()
                n = SQL.Node(SQLK.IS)
                SQL.SetA(n, left)
                SQL.SetB(n, SQL.Node(SQLK.NULL))
                left = n
            } ElseBlock: {
                IfCondition EqualTo(SQLS.tok, SQLT.NOTNULL) ThenBlock: {
                    SQL.LexNext()
                    n2 = SQL.Node(SQLK.IS)
                    SQL.SetFlags(n2, 1)
                    SQL.SetA(n2, left)
                    SQL.SetB(n2, SQL.Node(SQLK.NULL))
                    left = n2
                } ElseBlock: {
                    nt = 0
                    IfCondition EqualTo(SQLS.tok, SQLT.NOT) ThenBlock: {
                        // peek: NOT BETWEEN / NOT IN / NOT LIKE
                        // We already consumed nothing. Look ahead by accepting only if followed.
                        nt = 1
                    }
                    IfCondition EqualTo(SQLS.tok, SQLT.IS) ThenBlock: {
                        SQL.LexNext()
                        neg = 0
                        IfCondition EqualTo(SQL.Accept(SQLT.NOT), 1) ThenBlock: { neg = 1 }
                        right = SQL.PShift()
                        n3 = SQL.Node(SQLK.IS)
                        SQL.SetFlags(n3, neg)
                        SQL.SetA(n3, left)
                        SQL.SetB(n3, right)
                        left = n3
                    } ElseBlock: {
                        IfCondition Or(EqualTo(SQLS.tok, SQLT.NOT), Or(EqualTo(SQLS.tok, SQLT.IN), Or(EqualTo(SQLS.tok, SQLT.BETWEEN), Or(EqualTo(SQLS.tok, SQLT.LIKE), EqualTo(SQLS.tok, SQLT.GLOB))))) ThenBlock: {
                            left = SQL.PCmpTail(left)
                        } ElseBlock: {
                            op = 0
                            IfCondition EqualTo(SQLS.tok, SQLT.EQ) ThenBlock: { op = SQLB.EQ }
                            IfCondition EqualTo(SQLS.tok, SQLT.NE) ThenBlock: { op = SQLB.NE }
                            IfCondition EqualTo(SQLS.tok, SQLT.LT) ThenBlock: { op = SQLB.LT }
                            IfCondition EqualTo(SQLS.tok, SQLT.GT) ThenBlock: { op = SQLB.GT }
                            IfCondition EqualTo(SQLS.tok, SQLT.LE) ThenBlock: { op = SQLB.LE }
                            IfCondition EqualTo(SQLS.tok, SQLT.GE) ThenBlock: { op = SQLB.GE }
                            IfCondition EqualTo(op, 0) ThenBlock: { ReturnValue(left) }
                            SQL.LexNext()
                            right2 = SQL.PShift()
                            left = SQL.Bin(op, left, right2)
                        }
                    }
                }
            }
        }
        ReturnValue(left)
    }
}

Function.SQL.PCmpTail {
    Input: left: Address
    Output: Address
    Body: {
        neg = 0
        IfCondition EqualTo(SQLS.tok, SQLT.NOT) ThenBlock: {
            SQL.LexNext()
            IfCondition EqualTo(SQLS.tok, SQLT.NULL) ThenBlock: {
                SQL.LexNext()
                isn = SQL.Node(SQLK.IS)
                SQL.SetFlags(isn, 1)
                SQL.SetA(isn, left)
                SQL.SetB(isn, SQL.Node(SQLK.NULL))
                ReturnValue(isn)
            }
            neg = 1
        }
        IfCondition EqualTo(SQLS.tok, SQLT.BETWEEN) ThenBlock: {
            SQL.LexNext()
            lo = SQL.PShift()
            SQL.Expect(SQLT.AND)
            hi = SQL.PShift()
            n = SQL.Node(SQLK.BETWEEN)
            SQL.SetFlags(n, neg)
            SQL.SetA(n, left)
            SQL.SetB(n, lo)
            SQL.SetC(n, hi)
            ReturnValue(n)
        }
        IfCondition EqualTo(SQLS.tok, SQLT.IN) ThenBlock: {
            SQL.LexNext()
            n2 = SQL.Node(SQLK.IN)
            SQL.SetFlags(n2, neg)
            SQL.SetA(n2, left)
            IfCondition EqualTo(SQLS.tok, SQLT.LP) ThenBlock: {
                SQL.LexNext()
                IfCondition EqualTo(SQLS.tok, SQLT.SELECT) ThenBlock: {
                    q = SQL.ParseSelect()
                    SQL.Expect(SQLT.RP)
                    SQL.SetB(n2, q)
                    SQL.SetC(n2, 1)
                    ReturnValue(n2)
                }
                IfCondition EqualTo(SQLS.tok, SQLT.RP) ThenBlock: {
                    SQL.LexNext()
                    ReturnValue(n2)
                }
                head = 0
                tail = 0
                WhileLoop EqualTo(SQLS.err, 0) {
                    a = SQL.ParseExpr()
                    cell = SQL.Cons(a, 0)
                    IfCondition EqualTo(head, 0) ThenBlock: { head = cell } ElseBlock: { SQL.SetB(tail, cell) }
                    tail = cell
                    IfCondition EqualTo(SQL.Accept(SQLT.COMMA), 0) ThenBlock: {
                        SQL.Expect(SQLT.RP)
                        SQL.SetB(n2, head)
                        ReturnValue(n2)
                    }
                }
                ReturnValue(n2)
            }
            IfCondition EqualTo(SQLS.tok, SQLT.IDENT) ThenBlock: {
                nm = SQLS.ttext
                SQL.LexNext()
                SQL.SetD(n2, nm)
                ReturnValue(n2)
            }
            SQL.Fail("in")
            ReturnValue(0)
        }
        IfCondition EqualTo(SQLS.tok, SQLT.LIKE) ThenBlock: {
            SQL.LexNext()
            right = SQL.PShift()
            esc = 0
            IfCondition EqualTo(SQLS.tok, SQLT.ESCAPE) ThenBlock: {
                SQL.LexNext()
                esc = SQL.PShift()
            }
            ln = SQL.Bin(SQLB.LIKE, left, right)
            SQL.SetC(ln, esc)
            SQL.SetD(ln, neg)
            ReturnValue(ln)
        }
        IfCondition EqualTo(SQLS.tok, SQLT.GLOB) ThenBlock: {
            SQL.LexNext()
            rightg = SQL.PShift()
            escg = 0
            IfCondition EqualTo(SQLS.tok, SQLT.ESCAPE) ThenBlock: {
                SQL.LexNext()
                escg = SQL.PShift()
            }
            gn = SQL.Bin(SQLB.GLOB, left, rightg)
            SQL.SetC(gn, escg)
            SQL.SetD(gn, neg)
            ReturnValue(gn)
        }
        SQL.Fail("cmp")
        ReturnValue(left)
    }
}

Function.SQL.PNot {
    Output: Address
    Body: {
        IfCondition EqualTo(SQLS.tok, SQLT.NOT) ThenBlock: {
            SQL.LexNext()
            ReturnValue(SQL.Un(SQLU.NOT, SQL.PNot()))
        }
        ReturnValue(SQL.PCmp())
    }
}

Function.SQL.PAnd {
    Output: Address
    Body: {
        left = SQL.PNot()
        WhileLoop EqualTo(SQLS.tok, SQLT.AND) {
            SQL.LexNext()
            right = SQL.PNot()
            left = SQL.Bin(SQLB.AND, left, right)
        }
        ReturnValue(left)
    }
}

Function.SQL.POr {
    Output: Address
    Body: {
        left = SQL.PAnd()
        WhileLoop EqualTo(SQLS.tok, SQLT.OR) {
            SQL.LexNext()
            right = SQL.PAnd()
            left = SQL.Bin(SQLB.OR, left, right)
        }
        ReturnValue(left)
    }
}

Function.SQL.ParseExpr {
    Output: Address
    Body: { ReturnValue(SQL.POr()) }
}

Function.SQL.TakeAlias {
    Input: e: Address
    Output: Address
    Body: {
        IfCondition EqualTo(SQL.Accept(SQLT.AS), 1) ThenBlock: {
            nm = SQLS.ttext
            SQL.Expect(SQLT.IDENT)
            SQL.SetH(e, nm)
            ReturnValue(e)
        }
        IfCondition EqualTo(SQLS.tok, SQLT.IDENT) ThenBlock: {
            SQL.SetH(e, SQLS.ttext)
            SQL.LexNext()
        }
        ReturnValue(e)
    }
}

Function.SQL.ParseSelList {
    Output: Address
    Body: {
        head = 0
        tail = 0
        WhileLoop EqualTo(SQLS.err, 0) {
            e = SQL.ParseExpr()
            e = SQL.TakeAlias(e)
            cell = SQL.Cons(e, 0)
            IfCondition EqualTo(head, 0) ThenBlock: { head = cell } ElseBlock: { SQL.SetB(tail, cell) }
            tail = cell
            IfCondition EqualTo(SQL.Accept(SQLT.COMMA), 0) ThenBlock: { ReturnValue(head) }
        }
        ReturnValue(head)
    }
}

Function.SQL.ParseOrder {
    Output: Address
    Body: {
        head = 0
        tail = 0
        WhileLoop EqualTo(SQLS.err, 0) {
            e = SQL.ParseExpr()
            desc = 0
            IfCondition EqualTo(SQL.Accept(SQLT.DESC), 1) ThenBlock: { desc = 1 }
            IfCondition EqualTo(SQL.Accept(SQLT.ASC), 1) ThenBlock: { desc = 0 }
            n = SQL.Node(SQLK.ORDER)
            SQL.SetA(n, e)
            SQL.SetFlags(n, desc)
            IfCondition EqualTo(head, 0) ThenBlock: { head = n } ElseBlock: { SQL.SetB(tail, n) }
            tail = n
            IfCondition EqualTo(SQL.Accept(SQLT.COMMA), 0) ThenBlock: { ReturnValue(head) }
        }
        ReturnValue(head)
    }
}

Function.SQL.ParseTablePrim {
    Output: Address
    Body: {
        IfCondition EqualTo(SQLS.tok, SQLT.LP) ThenBlock: {
            SQL.LexNext()
            // (t1 AS a CROSS JOIN t2) is a join, not a subquery.
            IfCondition NotEqual(SQLS.tok, SQLT.SELECT) ThenBlock: {
                inner = SQL.ParseFrom()
                SQL.Expect(SQLT.RP)
                ReturnValue(inner)
            }
            q = SQL.ParseSelect()
            SQL.Expect(SQLT.RP)
            n = SQL.Node(SQLK.TABLE)
            SQL.SetFlags(n, 2)
            SQL.SetA(n, q)
            IfCondition EqualTo(SQL.Accept(SQLT.AS), 1) ThenBlock: {
                SQL.SetB(n, SQLS.ttext)
                SQL.Expect(SQLT.IDENT)
            } ElseBlock: {
                IfCondition EqualTo(SQLS.tok, SQLT.IDENT) ThenBlock: {
                    SQL.SetB(n, SQLS.ttext)
                    SQL.LexNext()
                }
            }
            ReturnValue(n)
        }
        nm = SQLS.ttext
        SQL.Expect(SQLT.IDENT)
        n2 = SQL.Node(SQLK.TABLE)
        SQL.SetA(n2, nm)
        IfCondition And(EqualTo(SQLS.tok, SQLT.NOT), EqualTo(1, 1)) ThenBlock: {
            // NOT INDEXED
            IfCondition EqualTo(SQLS.tok, SQLT.NOT) ThenBlock: {
                SQL.LexNext()
                SQL.Expect(SQLT.INDEXED)
            }
        }
        IfCondition EqualTo(SQLS.tok, SQLT.INDEXED) ThenBlock: {
            SQL.LexNext()
            SQL.Expect(SQLT.BY)
            SQL.Expect(SQLT.IDENT)
        }
        IfCondition EqualTo(SQL.Accept(SQLT.AS), 1) ThenBlock: {
            SQL.SetB(n2, SQLS.ttext)
            SQL.Expect(SQLT.IDENT)
        } ElseBlock: {
            IfCondition EqualTo(SQLS.tok, SQLT.IDENT) ThenBlock: {
                SQL.SetB(n2, SQLS.ttext)
                SQL.LexNext()
            }
        }
        ReturnValue(n2)
    }
}

Function.SQL.ParseJoin {
    Output: Address
    Body: {
        left = SQL.ParseTablePrim()
        WhileLoop EqualTo(SQLS.err, 0) {
            jt = -1
            IfCondition EqualTo(SQLS.tok, SQLT.CROSS) ThenBlock: {
                SQL.LexNext()
                SQL.Expect(SQLT.JOIN)
                jt = SQLJ.CROSS
            }
            IfCondition EqualTo(jt, -1) ThenBlock: {
                IfCondition EqualTo(SQLS.tok, SQLT.INNER) ThenBlock: { SQL.LexNext() }
                IfCondition EqualTo(SQLS.tok, SQLT.JOIN) ThenBlock: {
                    SQL.LexNext()
                    jt = SQLJ.INNER
                }
            }
            IfCondition EqualTo(jt, -1) ThenBlock: {
                IfCondition EqualTo(SQLS.tok, SQLT.LEFT) ThenBlock: {
                    SQL.LexNext()
                    IfCondition EqualTo(SQLS.tok, SQLT.OUTER) ThenBlock: { SQL.LexNext() }
                    SQL.Expect(SQLT.JOIN)
                    jt = SQLJ.LEFT
                }
            }
            IfCondition EqualTo(jt, -1) ThenBlock: { ReturnValue(left) }
            right = SQL.ParseTablePrim()
            on = 0
            IfCondition NotEqual(jt, SQLJ.CROSS) ThenBlock: {
                IfCondition EqualTo(SQLS.tok, SQLT.ON) ThenBlock: {
                    SQL.LexNext()
                    on = SQL.ParseExpr()
                }
            }
            j = SQL.Node(SQLK.JOIN)
            SQL.SetFlags(j, jt)
            SQL.SetA(j, left)
            SQL.SetB(j, right)
            SQL.SetC(j, on)
            left = j
        }
        ReturnValue(left)
    }
}

Function.SQL.ParseFrom {
    Output: Address
    Body: {
        left = SQL.ParseJoin()
        WhileLoop EqualTo(SQL.Accept(SQLT.COMMA), 1) {
            right = SQL.ParseJoin()
            j = SQL.Node(SQLK.JOIN)
            SQL.SetFlags(j, SQLJ.CROSS)
            SQL.SetA(j, left)
            SQL.SetB(j, right)
            left = j
        }
        // The loop test leaves 0 in rax, and a ReturnValue of left right
        // after this WhileLoop is emitted as a bare jump. Adding zero
        // reloads left from its register before the return.
        back = Add(left, 0)
        ReturnValue(back)
    }
}

Function.SQL.ParseSelectCore {
    Output: Address
    Body: {
        SQL.Expect(SQLT.SELECT)
        dist = 0
        IfCondition EqualTo(SQL.Accept(SQLT.DISTINCT), 1) ThenBlock: { dist = 1 }
        IfCondition EqualTo(SQL.Accept(SQLT.ALL), 1) ThenBlock: { dist = 0 }
        cols = SQL.ParseSelList()
        frm = 0
        IfCondition EqualTo(SQLS.tok, SQLT.FROM) ThenBlock: {
            SQL.LexNext()
            frm = SQL.ParseFrom()
        }
        wh = 0
        IfCondition EqualTo(SQLS.tok, SQLT.WHERE) ThenBlock: {
            SQL.LexNext()
            wh = SQL.ParseExpr()
        }
        grp = 0
        IfCondition EqualTo(SQLS.tok, SQLT.GROUP) ThenBlock: {
            SQL.LexNext()
            SQL.Expect(SQLT.BY)
            grp = SQL.ParseSelList()
        }
        hav = 0
        IfCondition EqualTo(SQLS.tok, SQLT.HAVING) ThenBlock: {
            SQL.LexNext()
            hav = SQL.ParseExpr()
        }
        n = SQL.Node(SQLK.SELECT)
        SQL.SetFlags(n, dist)
        SQL.SetA(n, cols)
        SQL.SetB(n, frm)
        SQL.SetC(n, wh)
        SQL.SetD(n, grp)
        SQL.SetE(n, hav)
        ReturnValue(n)
    }
}

Function.SQL.WrapCompound {
    Input: left: Address
    Input: op: Integer
    Input: right: Address
    Output: Address
    Body: {
        w = SQL.Node(SQLK.SELECT)
        SQL.SetFlags(w, 2)
        SQL.SetA(w, left)
        SQL.SetG(w, op)
        SQL.SetH(w, right)
        ReturnValue(w)
    }
}

Function.SQL.ParseIntersect {
    Output: Address
    Body: {
        left = SQL.ParseSelectCore()
        WhileLoop EqualTo(SQLS.err, 0) {
            IfCondition NotEqual(SQLS.tok, SQLT.INTERSECT) ThenBlock: { ReturnValue(left) }
            SQL.LexNext()
            right = SQL.ParseSelectCore()
            left = SQL.WrapCompound(left, 4, right)
        }
        ReturnValue(left)
    }
}

Function.SQL.ParseSelect {
    Output: Address
    Body: {
        left = SQL.ParseIntersect()
        WhileLoop EqualTo(SQLS.err, 0) {
            op = 0
            IfCondition EqualTo(SQLS.tok, SQLT.UNION) ThenBlock: {
                SQL.LexNext()
                op = 1
                IfCondition EqualTo(SQL.Accept(SQLT.ALL), 1) ThenBlock: { op = 2 }
            }
            IfCondition EqualTo(SQLS.tok, SQLT.EXCEPT) ThenBlock: {
                SQL.LexNext()
                op = 3
            }
            IfCondition EqualTo(op, 0) ThenBlock: { ReturnValue(SQL.FinishSelect(left)) }
            right = SQL.ParseIntersect()
            left = SQL.WrapCompound(left, op, right)
        }
        ReturnValue(SQL.FinishSelect(left))
    }
}

Function.SQL.FinishSelect {
    Input: left: Address
    Output: Address
    Body: {
        left = SQL.ParseSelectTail(left)
        IfCondition NotEqual(SQLS.err, 0) ThenBlock: { ReturnValue(left) }
        t = SQLS.tok
        IfCondition Or(EqualTo(t, SQLT.UNION), Or(EqualTo(t, SQLT.EXCEPT), EqualTo(t, SQLT.INTERSECT))) ThenBlock: {
            opname = "UNION"
            IfCondition EqualTo(t, SQLT.UNION) ThenBlock: {
                SQL.LexNext()
                IfCondition EqualTo(SQL.Accept(SQLT.ALL), 1) ThenBlock: { opname = "UNION ALL" }
            }
            IfCondition EqualTo(t, SQLT.EXCEPT) ThenBlock: { opname = "EXCEPT" }
            IfCondition EqualTo(t, SQLT.INTERSECT) ThenBlock: { opname = "INTERSECT" }
            which = "LIMIT"
            node = left
            IfCondition EqualTo(SQL.Kind(left), SQLK.LIM) ThenBlock: { node = SQL.A(left) }
            IfCondition NotEqual(SQL.F(node), 0) ThenBlock: { which = "ORDER BY" }
            SQL.Fail(StringConcat(which, StringConcat(" clause should come after ", StringConcat(opname, " not before"))))
        }
        IfCondition EqualTo(t, SQLT.OFFSET) ThenBlock: { SQL.Fail("syntax") }
        ReturnValue(left)
    }
}

Function.SQL.ParseSelectTail {
    Input: left: Address
    Output: Address
    Body: {
        IfCondition EqualTo(SQLS.tok, SQLT.ORDER) ThenBlock: {
            SQL.LexNext()
            SQL.Expect(SQLT.BY)
            SQL.SetF(left, SQL.ParseOrder())
        }
        IfCondition EqualTo(SQLS.tok, SQLT.LIMIT) ThenBlock: {
            SQL.LexNext()
            e1 = SQL.ParseExpr()
            lim = e1
            off = 0
            IfCondition EqualTo(SQLS.tok, SQLT.OFFSET) ThenBlock: {
                SQL.LexNext()
                off = SQL.ParseExpr()
                IfCondition EqualTo(SQLS.tok, SQLT.COMMA) ThenBlock: { SQL.Fail("syntax") }
            } ElseBlock: {
                IfCondition EqualTo(SQLS.tok, SQLT.COMMA) ThenBlock: {
                    SQL.LexNext()
                    off = e1
                    lim = SQL.ParseExpr()
                }
            }
            w = SQL.Node(SQLK.LIM)
            SQL.SetA(w, left)
            SQL.SetB(w, lim)
            SQL.SetC(w, off)
            ReturnValue(w)
        }
        ReturnValue(left)
    }
}

Function.SQL.ParseColDef {
    Output: Address
    Body: {
        nm = SQLS.ttext
        SQL.Expect(SQLT.IDENT)
        n = SQL.Node(SQLK.CDEF)
        SQL.SetA(n, nm)
        aff = SQLA.NONE
        bits = 0
        ipk = 0
        WhileLoop EqualTo(SQLS.err, 0) {
            t = SQLS.tok
            IfCondition Or(EqualTo(t, SQLT.INTEGER), Or(EqualTo(t, SQLT.INT), Or(EqualTo(t, SQLT.REAL), Or(EqualTo(t, SQLT.FLOAT), Or(EqualTo(t, SQLT.DOUBLE), Or(EqualTo(t, SQLT.TEXT), Or(EqualTo(t, SQLT.VARCHAR), Or(EqualTo(t, SQLT.CHAR), Or(EqualTo(t, SQLT.NUMERIC), Or(EqualTo(t, SQLT.DECIMAL), Or(EqualTo(t, SQLT.BLOB), EqualTo(t, SQLT.SIGNED)))))))))))) ThenBlock: {
                IfCondition EqualTo(t, SQLT.INTEGER) ThenBlock: { ipk = 1 }
                aff = SQL.ParseAff()
            } ElseBlock: {
                IfCondition EqualTo(t, SQLT.PRIMARY) ThenBlock: {
                    SQL.LexNext()
                    SQL.Expect(SQLT.KEY)
                    bits = BitwiseOr(bits, 1)
                    IfCondition EqualTo(SQLS.tok, SQLT.ASC) ThenBlock: { SQL.LexNext() }
                    IfCondition EqualTo(SQLS.tok, SQLT.DESC) ThenBlock: { SQL.LexNext() }
                } ElseBlock: {
                    IfCondition EqualTo(t, SQLT.NOT) ThenBlock: {
                        SQL.LexNext()
                        SQL.Expect(SQLT.NULL)
                        bits = BitwiseOr(bits, 4)
                    } ElseBlock: {
                        IfCondition EqualTo(t, SQLT.UNIQUE) ThenBlock: {
                            SQL.LexNext()
                            bits = BitwiseOr(bits, 2)
                        } ElseBlock: {
                            SQL.SetFlags(n, aff)
                            SQL.SetB(n, bits)
                            SQL.SetC(n, ipk)
                            ReturnValue(n)
                        }
                    }
                }
            }
            SQL.SetFlags(n, aff)
            SQL.SetB(n, bits)
            SQL.SetC(n, ipk)
        }
        SQL.SetFlags(n, aff)
        SQL.SetB(n, bits)
        SQL.SetC(n, ipk)
        ReturnValue(n)
    }
}

Function.SQL.ParseCreateTable {
    Output: Address
    Body: {
        nm = SQLS.ttext
        SQL.Expect(SQLT.IDENT)
        SQL.Expect(SQLT.LP)
        head = 0
        tail = 0
        WhileLoop And(NotEqual(SQLS.tok, SQLT.RP), EqualTo(SQLS.err, 0)) {
            IfCondition EqualTo(SQLS.tok, SQLT.PRIMARY) ThenBlock: {
                SQL.LexNext()
                SQL.Expect(SQLT.KEY)
                SQL.Expect(SQLT.LP)
                WhileLoop And(NotEqual(SQLS.tok, SQLT.RP), EqualTo(SQLS.err, 0)) {
                    cn = SQLS.ttext
                    SQL.Expect(SQLT.IDENT)
                    d = SQL.Node(SQLK.CDEF)
                    SQL.SetA(d, cn)
                    SQL.SetB(d, 8)
                    cell = SQL.Cons(d, 0)
                    IfCondition EqualTo(head, 0) ThenBlock: { head = cell } ElseBlock: { SQL.SetB(tail, cell) }
                    tail = cell
                    IfCondition EqualTo(SQL.Accept(SQLT.COMMA), 0) ThenBlock: { BreakLoop }
                }
                SQL.Expect(SQLT.RP)
            } ElseBlock: {
                d2 = SQL.ParseColDef()
                cell2 = SQL.Cons(d2, 0)
                IfCondition EqualTo(head, 0) ThenBlock: { head = cell2 } ElseBlock: { SQL.SetB(tail, cell2) }
                tail = cell2
            }
            IfCondition EqualTo(SQL.Accept(SQLT.COMMA), 0) ThenBlock: { BreakLoop }
        }
        SQL.Expect(SQLT.RP)
        n2 = SQL.Node(SQLK.CTAB)
        SQL.SetA(n2, nm)
        SQL.SetB(n2, head)
        ReturnValue(n2)
    }
}

Function.SQL.ParseCreate {
    Output: Address
    Body: {
        uniq = 0
        temp = 0
        IfCondition Or(EqualTo(SQLS.tok, SQLT.TEMP), EqualTo(SQLS.tok, SQLT.TEMPORARY)) ThenBlock: {
            temp = 1
            SQL.LexNext()
        }
        IfCondition EqualTo(SQLS.tok, SQLT.UNIQUE) ThenBlock: {
            uniq = 1
            SQL.LexNext()
        }
        IfCondition EqualTo(SQLS.tok, SQLT.TABLE) ThenBlock: {
            SQL.LexNext()
            ine = 0
            IfCondition EqualTo(SQLS.tok, SQLT.IF) ThenBlock: {
                SQL.LexNext()
                SQL.Expect(SQLT.NOT)
                SQL.Expect(SQLT.EXISTS)
                ine = 1
            }
            tab = SQL.ParseCreateTable()
            SQL.SetD(tab, ine)
            ReturnValue(tab)
        }
        IfCondition EqualTo(SQLS.tok, SQLT.INDEX) ThenBlock: {
            SQL.LexNext()
            ine2 = 0
            IfCondition EqualTo(SQLS.tok, SQLT.IF) ThenBlock: {
                SQL.LexNext()
                SQL.Expect(SQLT.NOT)
                SQL.Expect(SQLT.EXISTS)
                ine2 = 1
            }
            nm = SQLS.ttext
            SQL.Expect(SQLT.IDENT)
            SQL.Expect(SQLT.ON)
            tb = SQLS.ttext
            SQL.Expect(SQLT.IDENT)
            SQL.Expect(SQLT.LP)
            head = 0
            tail = 0
            WhileLoop EqualTo(SQLS.err, 0) {
                cn = SQLS.ttext
                SQL.Expect(SQLT.IDENT)
                desc = 0
                IfCondition EqualTo(SQL.Accept(SQLT.DESC), 1) ThenBlock: { desc = 1 }
                IfCondition EqualTo(SQL.Accept(SQLT.ASC), 1) ThenBlock: { desc = 0 }
                d = SQL.Node(SQLK.CDEF)
                SQL.SetA(d, cn)
                SQL.SetFlags(d, desc)
                cell = SQL.Cons(d, 0)
                IfCondition EqualTo(head, 0) ThenBlock: { head = cell } ElseBlock: { SQL.SetB(tail, cell) }
                tail = cell
                IfCondition EqualTo(SQL.Accept(SQLT.COMMA), 0) ThenBlock: {
                    SQL.Expect(SQLT.RP)
                    n = SQL.Node(SQLK.CIDX)
                    SQL.SetFlags(n, uniq)
                    SQL.SetA(n, nm)
                    SQL.SetB(n, tb)
                    SQL.SetC(n, head)
                    SQL.SetD(n, ine2)
                    ReturnValue(n)
                }
            }
            ReturnValue(0)
        }
        IfCondition EqualTo(SQLS.tok, SQLT.VIEW) ThenBlock: {
            SQL.LexNext()
            ine3 = 0
            IfCondition EqualTo(SQLS.tok, SQLT.IF) ThenBlock: {
                SQL.LexNext()
                SQL.Expect(SQLT.NOT)
                SQL.Expect(SQLT.EXISTS)
                ine3 = 1
            }
            nm2 = SQLS.ttext
            SQL.Expect(SQLT.IDENT)
            SQL.Expect(SQLT.AS)
            // LexNext leaves pos just past the current token. Slice only the
            // select that ParseSelect consumes, not the rest of the buffer.
            at = Subtract(SQLS.pos, StringLength(SQLS.ttext))
            q = SQL.ParseSelect()
            rest = SQL.Str(Add(SQLS.src, at), Subtract(SQLS.pos, at))
            n2 = SQL.Node(SQLK.CVIEW)
            SQL.SetFlags(n2, temp)
            SQL.SetA(n2, nm2)
            SQL.SetB(n2, rest)
            SQL.SetC(n2, q)
            SQL.SetD(n2, ine3)
            ReturnValue(n2)
        }
        IfCondition EqualTo(SQLS.tok, SQLT.TRIGGER) ThenBlock: {
            SQL.LexNext()
            nm3 = SQLS.ttext
            SQL.Expect(SQLT.IDENT)
            timing = 0
            IfCondition EqualTo(SQLS.tok, SQLT.BEFORE) ThenBlock: { SQL.LexNext() }
            IfCondition EqualTo(SQLS.tok, SQLT.AFTER) ThenBlock: {
                timing = 1
                SQL.LexNext()
            }
            IfCondition And(EqualTo(SQLS.tok, SQLT.IDENT), EqualTo(SQL.EqStr(SQLS.ttext, "instead"), 1)) ThenBlock: {
                SQL.LexNext()
                IfCondition And(EqualTo(SQLS.tok, SQLT.IDENT), EqualTo(SQL.EqStr(SQLS.ttext, "of"), 1)) ThenBlock: {
                    timing = 2
                    SQL.LexNext()
                }
            }
            ev = 0
            IfCondition EqualTo(SQLS.tok, SQLT.INSERT) ThenBlock: { ev = 1 }
            IfCondition EqualTo(SQLS.tok, SQLT.UPDATE) ThenBlock: { ev = 2 }
            IfCondition EqualTo(SQLS.tok, SQLT.DELETE) ThenBlock: { ev = 3 }
            IfCondition EqualTo(ev, 0) ThenBlock: {
                SQL.Fail("syntax")
                ReturnValue(0)
            }
            SQL.LexNext()
            ofc = 0
            IfCondition And(EqualTo(ev, 2), And(EqualTo(SQLS.tok, SQLT.IDENT), EqualTo(SQL.EqStr(SQLS.ttext, "of"), 1))) ThenBlock: {
                SQL.LexNext()
                acc = ""
                WhileLoop EqualTo(SQLS.err, 0) {
                    piece = SQLS.ttext
                    SQL.Expect(SQLT.IDENT)
                    IfCondition EqualTo(StringLength(acc), 0) ThenBlock: {
                        acc = piece
                    } ElseBlock: {
                        acc = StringConcat(StringConcat(acc, ","), piece)
                    }
                    IfCondition EqualTo(SQLS.tok, SQLT.COMMA) ThenBlock: {
                        SQL.LexNext()
                    } ElseBlock: {
                        ofc = acc
                    }
                    IfCondition NotEqual(ofc, 0) ThenBlock: { ofc = ofc }
                    IfCondition NotEqual(ofc, 0) ThenBlock: { BreakLoop }
                }
            }
            SQL.Expect(SQLT.ON)
            tbn = SQLS.ttext
            SQL.Expect(SQLT.IDENT)
            IfCondition And(EqualTo(SQLS.tok, SQLT.IDENT), EqualTo(SQL.EqStr(SQLS.ttext, "for"), 1)) ThenBlock: {
                SQL.LexNext()
                IfCondition And(EqualTo(SQLS.tok, SQLT.IDENT), EqualTo(SQL.EqStr(SQLS.ttext, "each"), 1)) ThenBlock: { SQL.LexNext() }
                IfCondition And(EqualTo(SQLS.tok, SQLT.IDENT), EqualTo(SQL.EqStr(SQLS.ttext, "row"), 1)) ThenBlock: {
                    SQL.LexNext()
                } ElseBlock: {
                    SQL.Fail("syntax")
                }
            }
            wh = 0
            IfCondition EqualTo(SQLS.tok, SQLT.WHEN) ThenBlock: {
                SQL.LexNext()
                wat = Subtract(SQLS.pos, StringLength(SQLS.ttext))
                SQL.ParseExpr()
                wh = SQL.Str(Add(SQLS.src, wat), Subtract(SQLS.pos, wat))
            }
            SQL.Expect(SQLT.BEGIN)
            atbody = Subtract(SQLS.pos, StringLength(SQLS.ttext))
            depth = 1
            WhileLoop And(GreaterThan(depth, 0), NotEqual(SQLS.tok, SQLT.EOF)) {
                IfCondition EqualTo(SQLS.tok, SQLT.BEGIN) ThenBlock: { depth = Add(depth, 1) }
                IfCondition EqualTo(SQLS.tok, SQLT.END) ThenBlock: { depth = Subtract(depth, 1) }
                IfCondition GreaterThan(depth, 0) ThenBlock: { SQL.LexNext() }
            }
            endat = Subtract(SQLS.pos, StringLength(SQLS.ttext))
            body = ""
            IfCondition GreaterThan(endat, atbody) ThenBlock: {
                body = SQL.Str(Add(SQLS.src, atbody), Subtract(endat, atbody))
            }
            SQL.Expect(SQLT.END)
            n3 = SQL.Node(SQLK.CTRIG)
            SQL.SetA(n3, nm3)
            SQL.SetB(n3, tbn)
            SQL.SetC(n3, ev)
            SQL.SetD(n3, timing)
            SQL.SetE(n3, body)
            SQL.SetF(n3, wh)
            SQL.SetG(n3, ofc)
            ReturnValue(n3)
        }
        SQL.Fail("create")
        ReturnValue(0)
    }
}

Function.SQL.ParseInsert {
    Input: repl: Integer
    Output: Address
    Body: {
        SQL.Expect(SQLT.INTO)
        tb = SQLS.ttext
        SQL.Expect(SQLT.IDENT)
        cols = 0
        IfCondition EqualTo(SQLS.tok, SQLT.LP) ThenBlock: {
            SQL.LexNext()
            head = 0
            tail = 0
            WhileLoop EqualTo(SQLS.err, 0) {
                nm = SQLS.ttext
                SQL.Expect(SQLT.IDENT)
                d = SQL.Node(SQLK.CDEF)
                SQL.SetA(d, nm)
                cell = SQL.Cons(d, 0)
                IfCondition EqualTo(head, 0) ThenBlock: { head = cell } ElseBlock: { SQL.SetB(tail, cell) }
                tail = cell
                IfCondition EqualTo(SQL.Accept(SQLT.COMMA), 0) ThenBlock: {
                    SQL.Expect(SQLT.RP)
                    cols = head
                    head = 0
                }
                IfCondition NotEqual(cols, 0) ThenBlock: { cols = cols }
                IfCondition NotEqual(cols, 0) ThenBlock: { ReturnValue(SQL.ParseInsertRest(repl, tb, cols)) }
            }
        }
        ReturnValue(SQL.ParseInsertRest(repl, tb, cols))
    }
}

Function.SQL.ParseInsertRest {
    Input: repl: Integer
    Input: tb: Address
    Input: cols: Address
    Output: Address
    Body: {
        n = SQL.Node(SQLK.INSERT)
        SQL.SetFlags(n, repl)
        SQL.SetA(n, tb)
        SQL.SetB(n, cols)
        IfCondition EqualTo(SQLS.tok, SQLT.SELECT) ThenBlock: {
            SQL.SetC(n, SQL.ParseSelect())
            SQL.SetD(n, 1)
            ReturnValue(n)
        }
        SQL.Expect(SQLT.VALUES)
        head = 0
        tail = 0
        WhileLoop EqualTo(SQLS.err, 0) {
            SQL.Expect(SQLT.LP)
            rh = 0
            rt = 0
            WhileLoop EqualTo(SQLS.err, 0) {
                e = SQL.ParseExpr()
                IfCondition NotEqual(SQLS.err, 0) ThenBlock: { BreakLoop }
                cell = SQL.Cons(e, 0)
                IfCondition EqualTo(rh, 0) ThenBlock: { rh = cell } ElseBlock: { SQL.SetB(rt, cell) }
                rt = cell
                IfCondition EqualTo(SQL.Accept(SQLT.COMMA), 0) ThenBlock: { BreakLoop }
            }
            IfCondition NotEqual(SQLS.err, 0) ThenBlock: { BreakLoop }
            SQL.Expect(SQLT.RP)
            row = SQL.Cons(rh, 0)
            IfCondition EqualTo(head, 0) ThenBlock: { head = row } ElseBlock: { SQL.SetB(tail, row) }
            tail = row
            IfCondition EqualTo(SQL.Accept(SQLT.COMMA), 0) ThenBlock: {
                SQL.SetC(n, head)
                ReturnValue(n)
            }
        }
        SQL.SetC(n, head)
        ReturnValue(n)
    }
}

Function.SQL.ParseStmt {
    Output: Address
    Body: {
        IfCondition EqualTo(SQLS.tok, SQLT.SELECT) ThenBlock: { ReturnValue(SQL.ParseSelect()) }
        IfCondition EqualTo(SQLS.tok, SQLT.CREATE) ThenBlock: {
            SQL.LexNext()
            ReturnValue(SQL.ParseCreate())
        }
        IfCondition EqualTo(SQLS.tok, SQLT.DROP) ThenBlock: {
            SQL.LexNext()
            kind = 1
            IfCondition EqualTo(SQLS.tok, SQLT.TABLE) ThenBlock: { kind = 1 }
            IfCondition EqualTo(SQLS.tok, SQLT.INDEX) ThenBlock: { kind = 2 }
            IfCondition EqualTo(SQLS.tok, SQLT.VIEW) ThenBlock: { kind = 3 }
            IfCondition EqualTo(SQLS.tok, SQLT.TRIGGER) ThenBlock: { kind = 4 }
            SQL.LexNext()
            iex = 0
            IfCondition EqualTo(SQLS.tok, SQLT.IF) ThenBlock: {
                SQL.LexNext()
                SQL.Expect(SQLT.EXISTS)
                iex = 1
            }
            nm = SQLS.ttext
            SQL.Expect(SQLT.IDENT)
            n = SQL.Node(SQLK.DROP)
            SQL.SetFlags(n, kind)
            SQL.SetA(n, nm)
            SQL.SetB(n, iex)
            ReturnValue(n)
        }
        IfCondition EqualTo(SQLS.tok, SQLT.INSERT) ThenBlock: {
            SQL.LexNext()
            repl = 0
            IfCondition EqualTo(SQLS.tok, SQLT.OR) ThenBlock: {
                SQL.LexNext()
                IfCondition EqualTo(SQLS.tok, SQLT.REPLACE) ThenBlock: { repl = 1 }
                IfCondition EqualTo(SQLS.tok, SQLT.IGNORE) ThenBlock: { repl = 2 }
                IfCondition Or(EqualTo(SQLS.tok, SQLT.ABORT), Or(EqualTo(SQLS.tok, SQLT.FAIL), EqualTo(SQLS.tok, SQLT.ROLLBACK))) ThenBlock: { repl = 0 }
                SQL.LexNext()
            }
            ReturnValue(SQL.ParseInsert(repl))
        }
        IfCondition EqualTo(SQLS.tok, SQLT.REPLACE) ThenBlock: {
            SQL.LexNext()
            ReturnValue(SQL.ParseInsert(1))
        }
        IfCondition EqualTo(SQLS.tok, SQLT.UPDATE) ThenBlock: {
            SQL.LexNext()
            tb = SQLS.ttext
            SQL.Expect(SQLT.IDENT)
            SQL.Expect(SQLT.SET)
            head = 0
            tail = 0
            WhileLoop EqualTo(SQLS.err, 0) {
                cn = SQLS.ttext
                SQL.Expect(SQLT.IDENT)
                SQL.Expect(SQLT.EQ)
                e = SQL.ParseExpr()
                a = SQL.Node(SQLK.SET)
                SQL.SetA(a, cn)
                SQL.SetB(a, e)
                IfCondition EqualTo(head, 0) ThenBlock: { head = a } ElseBlock: { SQL.SetC(tail, a) }
                tail = a
                IfCondition EqualTo(SQL.Accept(SQLT.COMMA), 0) ThenBlock: {
                    wh = 0
                    IfCondition EqualTo(SQLS.tok, SQLT.WHERE) ThenBlock: {
                        SQL.LexNext()
                        wh = SQL.ParseExpr()
                    }
                    n = SQL.Node(SQLK.UPDATE)
                    SQL.SetA(n, tb)
                    SQL.SetB(n, head)
                    SQL.SetC(n, wh)
                    ReturnValue(n)
                }
            }
            ReturnValue(0)
        }
        IfCondition EqualTo(SQLS.tok, SQLT.REINDEX) ThenBlock: {
            SQL.LexNext()
            rnm = SQLS.ttext
            SQL.Expect(SQLT.IDENT)
            rn = SQL.Node(SQLK.REIDX)
            SQL.SetA(rn, rnm)
            ReturnValue(rn)
        }
        IfCondition EqualTo(SQLS.tok, SQLT.DELETE) ThenBlock: {
            SQL.LexNext()
            SQL.Expect(SQLT.FROM)
            tb2 = SQLS.ttext
            SQL.Expect(SQLT.IDENT)
            wh2 = 0
            IfCondition EqualTo(SQLS.tok, SQLT.WHERE) ThenBlock: {
                SQL.LexNext()
                wh2 = SQL.ParseExpr()
            }
            n2 = SQL.Node(SQLK.DELETE)
            SQL.SetA(n2, tb2)
            SQL.SetB(n2, wh2)
            ReturnValue(n2)
        }
        SQL.Fail("statement")
        ReturnValue(0)
    }
}

Function.SQL.Parse {
    Input: s: Address
    Output: Address
    Body: {
        SQL.LexStart(s, StringLength(s))
        n = SQL.ParseStmt()
        IfCondition EqualTo(SQL.Accept(SQLT.SEMI), 1) ThenBlock: { n = n }
        ReturnValue(n)
    }
}
