// Library.SQLSelect.ailang — FROM, join, group, compound, and projection.
// Equality filters run as soon as both sides are bound so deep joins stay small.
// Copyright (c) 2026 Sean Collins, 2 Paws Machine and Engineering. SCSL.

LibraryImport.SQLiteSQL.SQLExpr

Function.SQL.Item {
    Input: kind: Integer
    Input: node: Address
    Input: on: Address
    Output: Address
    Body: {
        p = SQL.Bump(32)
        IfCondition EqualTo(p, 0) ThenBlock: { ReturnValue(0) }
        WRMEM_64(p, kind)
        WRMEM_64(p, 8, node)
        WRMEM_64(p, 16, on)
        WRMEM_64(p, 24, -1)
        ReturnValue(p)
    }
}

Function.SQL.Collect {
    Input: node: Address
    Input: items: Address
    Input: preds: Address
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(SQL.Kind(node), SQLK.JOIN) ThenBlock: {
            IfCondition EqualTo(SQL.Flags(node), SQLJ.LEFT) ThenBlock: {
                SQL.Collect(SQL.A(node), items, preds)
                it = SQL.Item(1, SQL.B(node), SQL.C(node))
                WRMEM_64(it, 24, Array.Size(items))
                Array.Push(items, it)
                ReturnValue(0)
            }
            SQL.Collect(SQL.A(node), items, preds)
            SQL.Collect(SQL.B(node), items, preds)
            IfCondition NotEqual(SQL.C(node), 0) ThenBlock: { SQL.SplitAnd(SQL.C(node), preds) }
            ReturnValue(0)
        }
        it2 = SQL.Item(0, node, 0)
        WRMEM_64(it2, 24, Array.Size(items))
        Array.Push(items, it2)
    }
}

// Join order is not FROM order. SELECT * emits columns in the written order.
Function.SQL.AlignBind {
    Input: items: Address
    Input: bind: Address
    Output: Address
    Body: {
        n = Array.Size(items)
        out = Array.Create(n)
        i = 0
        WhileLoop LessThan(i, n) {
            Array.Push(out, 0)
            i = Add(i, 1)
        }
        i = 0
        WhileLoop LessThan(i, n) {
            ord = RDMEM_64(Array.Get(items, i), 24)
            IfCondition And(GreaterEqual(ord, 0), LessThan(ord, n)) ThenBlock: {
                Array.Set(out, ord, Array.Get(bind, i))
            }
            i = Add(i, 1)
        }
        back = Add(out, 0)
        ReturnValue(back)
    }
}

Function.SQL.Visible {
    Input: node: Address
    Output: Address
    Body: {
        al = SQL.B(node)
        IfCondition NotEqual(al, 0) ThenBlock: { ReturnValue(al) }
        ReturnValue(SQL.A(node))
    }
}

Function.SQL.NullVals {
    Input: n: Integer
    Output: Address
    Body: {
        a = Array.Create(n)
        i = 0
        WhileLoop LessThan(i, n) {
            Array.Push(a, SQL.Null())
            i = Add(i, 1)
        }
        ReturnValue(a)
    }
}

Function.SQL.NamesOf {
    Input: sel: Address
    Input: bind: Address
    Output: Address
    Body: {
        arr = Array.Create(4)
        p = SQL.A(sel)
        WhileLoop NotEqual(p, 0) {
            it = SQL.A(p)
            IfCondition EqualTo(SQL.Kind(it), SQLK.STAR) ThenBlock: {
                q = SQL.A(it)
                i = 0
                WhileLoop LessThan(i, Array.Size(bind)) {
                    fr = Array.Get(bind, i)
                    IfCondition EqualTo(SQL.QualOk(fr, q), 1) ThenBlock: {
                        names = RDMEM_64(fr)
                        c = 0
                        WhileLoop LessThan(c, Array.Size(names)) {
                            Array.Push(arr, Array.Get(names, c))
                            c = Add(c, 1)
                        }
                    }
                    i = Add(i, 1)
                }
            } ElseBlock: {
                IfCondition NotEqual(SQL.H(it), 0) ThenBlock: {
                    Array.Push(arr, SQL.H(it))
                } ElseBlock: {
                    IfCondition EqualTo(SQL.Kind(it), SQLK.COL) ThenBlock: {
                        Array.Push(arr, SQL.B(it))
                    } ElseBlock: {
                        Array.Push(arr, "")
                    }
                }
            }
            p = SQL.B(p)
        }
        ReturnValue(arr)
    }
}

Function.SQL.NullBind {
    Input: frm: Address
    Output: Address
    Body: {
        items = Array.Create(4)
        preds = Array.Create(1)
        SQL.Collect(frm, items, preds)
        b = SQL.BindEmpty()
        i = 0
        WhileLoop LessThan(i, Array.Size(items)) {
            it = Array.Get(items, i)
            fr = SQL.Proto(RDMEM_64(it, 8))
            IfCondition NotEqual(fr, 0) ThenBlock: { b = SQL.BindAdd(b, fr) }
            i = Add(i, 1)
        }
        ReturnValue(b)
    }
}

Function.SQL.SelectCore {
    Input: n: Address
    Output: Address
    Body: {
        IfCondition EqualTo(n, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(SQL.Kind(n), SQLK.LIM) ThenBlock: { ReturnValue(SQL.A(n)) }
        ReturnValue(n)
    }
}

Function.SQL.Proto {
    Input: node: Address
    Output: Address
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(SQL.Flags(node), 2) ThenBlock: {
            core = SQL.SelectCore(SQL.A(node))
            nb = SQL.NullBind(SQL.B(core))
            names = SQL.NamesOf(core, nb)
            al = SQL.B(node)
            IfCondition EqualTo(al, 0) ThenBlock: { al = "" }
            ReturnValue(SQL.Frame(names, SQL.NullVals(Array.Size(names)), al, al, 0, -1))
        }
        nm = SQL.A(node)
        vw = SQL.FindView(nm)
        IfCondition NotEqual(vw, 0) ThenBlock: {
            q = SQL.SelectCore(SQL.Parse(RDMEM_64(vw, 8)))
            IfCondition NotEqual(SQLS.err, 0) ThenBlock: { ReturnValue(0) }
            nb = SQL.NullBind(SQL.B(q))
            names = SQL.NamesOf(q, nb)
            al = SQL.Visible(node)
            ReturnValue(SQL.Frame(names, SQL.NullVals(Array.Size(names)), al, al, 0, -1))
        }
        tbl = SQL.FindTab(nm)
        IfCondition EqualTo(tbl, 0) ThenBlock: {
            SQL.Fail("no such table")
            ReturnValue(0)
        }
        al2 = SQL.Visible(node)
        ReturnValue(SQL.Frame(SQL.TabNames(tbl), SQL.NullVals(SQL.ColCount(tbl)), al2, al2, tbl, -1))
    }
}

Function.SQL.Open {
    Input: node: Address
    Output: Address
    Body: {
        frames = Array.Create(8)
        IfCondition EqualTo(SQL.Flags(node), 2) ThenBlock: {
            rs = SQL.RunSelect(SQL.A(node))
            names = SQLS.onames
            al = SQL.B(node)
            IfCondition EqualTo(al, 0) ThenBlock: { al = "" }
            i = 0
            WhileLoop LessThan(i, Array.Size(rs)) {
                Array.Push(frames, SQL.Frame(names, Array.Get(rs, i), al, al, 0, -1))
                i = Add(i, 1)
            }
            ReturnValue(frames)
        }
        nm = SQL.A(node)
        vw = SQL.FindView(nm)
        IfCondition NotEqual(vw, 0) ThenBlock: {
            q = SQL.Parse(RDMEM_64(vw, 8))
            IfCondition NotEqual(SQLS.err, 0) ThenBlock: { ReturnValue(frames) }
            rs2 = SQL.RunSelect(q)
            names2 = SQLS.onames
            al = SQL.Visible(node)
            i2 = 0
            WhileLoop LessThan(i2, Array.Size(rs2)) {
                Array.Push(frames, SQL.Frame(names2, Array.Get(rs2, i2), al, al, 0, -1))
                i2 = Add(i2, 1)
            }
            ReturnValue(frames)
        }
        tbl = SQL.FindTab(nm)
        IfCondition EqualTo(tbl, 0) ThenBlock: {
            SQL.Fail("no such table")
            ReturnValue(frames)
        }
        al2 = SQL.Visible(node)
        names3 = SQL.TabNames(tbl)
        i3 = 0
        nr = SQL.NRows(tbl)
        WhileLoop LessThan(i3, nr) {
            Array.Push(frames, SQL.Frame(names3, SQL.RowAt(tbl, i3), al2, al2, tbl, SQL.RowidAt(tbl, i3)))
            i3 = Add(i3, 1)
        }
        ReturnValue(frames)
    }
}

Function.SQL.BindCopy {
    Input: b: Address
    Output: Address
    Body: {
        n = Array.Create(Array.Size(b))
        i = 0
        WhileLoop LessThan(i, Array.Size(b)) {
            Array.Push(n, Array.Get(b, i))
            i = Add(i, 1)
        }
        back = Add(n, 0)
        ReturnValue(back)
    }
}

Function.SQL.BaseTable {
    Input: node: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(SQL.Flags(node), 2) ThenBlock: { ReturnValue(0) }
        IfCondition NotEqual(SQL.FindView(SQL.A(node)), 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(1)
    }
}

Function.SQL.TakeLocal {
    Input: node: Address
    Input: preds: Address
    Input: taken: Address
    Output: Address
    Body: {
        out = Array.Create(2)
        IfCondition EqualTo(SQL.BaseTable(node), 0) ThenBlock: { ReturnValue(out) }
        fr = SQL.Proto(node)
        IfCondition EqualTo(fr, 0) ThenBlock: { ReturnValue(out) }
        base = SQL.BindEmpty()
        ext = SQL.BindAdd(base, fr)
        i = 0
        n = Array.Size(preds)
        WhileLoop LessThan(i, n) {
            IfCondition EqualTo(Array.Get(taken, i), 0) ThenBlock: {
                pr = Array.Get(preds, i)
                b0 = SQL.WithReady(pr, base)
                b1 = SQL.WithReady(pr, ext)
                IfCondition And(EqualTo(b1, 1), EqualTo(b0, 0)) ThenBlock: {
                    Array.Push(out, pr)
                    Array.Set(taken, i, 1)
                }
            }
            i = Add(i, 1)
        }
        back = Add(out, 0)
        ReturnValue(back)
    }
}

Function.SQL.FilterFrames {
    Input: frs: Address
    Input: locals: Address
    Output: Address
    Body: {
        IfCondition EqualTo(locals, 0) ThenBlock: { ReturnValue(frs) }
        IfCondition EqualTo(Array.Size(locals), 0) ThenBlock: { ReturnValue(frs) }
        saved = SQLS.scope
        kept = Array.Create(8)
        path = SQL.BindEmpty()
        i = 0
        n = Array.Size(frs)
        WhileLoop LessThan(i, n) {
            fr = Array.Get(frs, i)
            Array.Push(path, fr)
            SQLS.scope = path
            IfCondition EqualTo(SQL.EarlyOk(locals), 1) ThenBlock: {
                Array.Push(kept, fr)
            }
            Array.Pop(path)
            IfCondition NotEqual(SQLS.err, 0) ThenBlock: {
                SQLS.scope = saved
                Array.Destroy(path)
                ReturnValue(kept)
            }
            i = Add(i, 1)
        }
        Array.Destroy(path)
        SQLS.scope = saved
        back = Add(kept, 0)
        ReturnValue(back)
    }
}

// Integer and whole-number reals share a Canon key. Text and other reals do
// not: affinity can make those equal a number, so those columns stay a scan.
Function.SQL.KeyOk {
    Input: v: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(SQL.IsNull(v), 1) ThenBlock: { ReturnValue(0) }
        t = SQL.VTag(v)
        IfCondition EqualTo(t, SQLV.INT) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(t, SQLV.REAL) ThenBlock: {
            r = SQL.VBits(v)
            IfCondition EqualTo(Float_Eq(r, Float_FromInt(Float_ToInt(r))), 1) ThenBlock: { ReturnValue(1) }
        }
        ReturnValue(0)
    }
}

Function.SQL.OwnCol {
    Input: col: Address
    Input: fr: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(col, 0) ThenBlock: { ReturnValue(-1) }
        IfCondition NotEqual(SQL.Kind(col), SQLK.COL) ThenBlock: { ReturnValue(-1) }
        IfCondition EqualTo(SQL.QualOk(fr, SQL.A(col)), 0) ThenBlock: { ReturnValue(-1) }
        names = RDMEM_64(fr)
        nm = SQL.B(col)
        c = 0
        n = Array.Size(names)
        WhileLoop LessThan(c, n) {
            IfCondition EqualTo(SQL.EqStr(Array.Get(names, c), nm), 1) ThenBlock: {
                ReturnValue(c)
            }
            c = Add(c, 1)
        }
        ReturnValue(-1)
    }
}

Function.SQL.IndexFrames {
    Input: frs: Address
    Output: Address
    Body: {
        IfCondition EqualTo(frs, 0) ThenBlock: { ReturnValue(0) }
        nfr = Array.Size(frs)
        IfCondition EqualTo(nfr, 0) ThenBlock: { ReturnValue(0) }
        fr0 = Array.Get(frs, 0)
        nc = Array.Size(RDMEM_64(fr0))
        hashes = Array.Create(nc)
        c = 0
        WhileLoop LessThan(c, nc) {
            Array.Push(hashes, Hash.New())
            c = Add(c, 1)
        }
        i = 0
        WhileLoop LessThan(i, nfr) {
            fr = Array.Get(frs, i)
            vals = RDMEM_64(fr, 8)
            c2 = 0
            WhileLoop LessThan(c2, nc) {
                v = Array.Get(vals, c2)
                IfCondition EqualTo(SQL.KeyOk(v), 1) ThenBlock: {
                    h = Array.Get(hashes, c2)
                    IfCondition NotEqual(h, 0) ThenBlock: {
                        key = SQL.Canon(v)
                        list = Hash.Get(h, key)
                        IfCondition EqualTo(list, 0) ThenBlock: {
                            list = Array.Create(2)
                            Hash.Set(h, key, list)
                        }
                        Array.Push(list, fr)
                    }
                } ElseBlock: {
                    IfCondition EqualTo(SQL.IsNull(v), 0) ThenBlock: {
                        Array.Set(hashes, c2, 0)
                    }
                }
                c2 = Add(c2, 1)
            }
            i = Add(i, 1)
        }
        back = Add(hashes, 0)
        ReturnValue(back)
    }
}

Function.SQL.FramesFor {
    Input: hashes: Address
    Input: col: Integer
    Input: v: Address
    Input: empty: Address
    Output: Address
    Body: {
        IfCondition EqualTo(SQL.IsNull(v), 1) ThenBlock: { ReturnValue(empty) }
        IfCondition EqualTo(SQL.KeyOk(v), 0) ThenBlock: { ReturnValue(0) }
        h = Array.Get(hashes, col)
        IfCondition EqualTo(h, 0) ThenBlock: { ReturnValue(0) }
        list = Hash.Get(h, SQL.Canon(v))
        IfCondition EqualTo(list, 0) ThenBlock: { ReturnValue(empty) }
        ReturnValue(list)
    }
}

// 0 means no usable equality, so the caller scans every cached frame.
// Matching frames stay in scan order, which keeps nosort results stable.
Function.SQL.ProbeList {
    Input: frs: Address
    Input: hashes: Address
    Input: preds: Address
    Input: empty: Address
    Output: Address
    Body: {
        IfCondition EqualTo(hashes, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(frs, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(Array.Size(frs), 0) ThenBlock: { ReturnValue(0) }
        fr = Array.Get(frs, 0)
        i = 0
        n = Array.Size(preds)
        WhileLoop LessThan(i, n) {
            pr = Array.Get(preds, i)
            IfCondition And(EqualTo(SQL.Kind(pr), SQLK.BIN), EqualTo(SQL.Flags(pr), SQLB.EQ)) ThenBlock: {
                ia = SQL.OwnCol(SQL.A(pr), fr)
                ib = SQL.OwnCol(SQL.B(pr), fr)
                IfCondition And(GreaterEqual(ia, 0), LessThan(ib, 0)) ThenBlock: {
                    IfCondition EqualTo(SQL.Ready(SQL.B(pr)), 1) ThenBlock: {
                        vb = SQL.Eval(SQL.B(pr))
                        IfCondition NotEqual(SQLS.err, 0) ThenBlock: { ReturnValue(0) }
                        hit = SQL.FramesFor(hashes, ia, vb, empty)
                        IfCondition NotEqual(hit, 0) ThenBlock: { ReturnValue(hit) }
                    }
                }
                IfCondition And(GreaterEqual(ib, 0), LessThan(ia, 0)) ThenBlock: {
                    IfCondition EqualTo(SQL.Ready(SQL.A(pr)), 1) ThenBlock: {
                        va = SQL.Eval(SQL.A(pr))
                        IfCondition NotEqual(SQLS.err, 0) ThenBlock: { ReturnValue(0) }
                        hit2 = SQL.FramesFor(hashes, ib, va, empty)
                        IfCondition NotEqual(hit2, 0) ThenBlock: { ReturnValue(hit2) }
                    }
                }
            }
            IfCondition NotEqual(SQLS.err, 0) ThenBlock: { ReturnValue(0) }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

Function.SQL.CachedRows {
    Input: node: Address
    Input: pack: Address
    Input: s: Integer
    Output: Address
    Body: {
        slots = RDMEM_64(pack)
        filled = RDMEM_64(pack, 8)
        IfCondition And(EqualTo(SQL.BaseTable(node), 1), EqualTo(Array.Get(filled, s), 1)) ThenBlock: {
            ReturnValue(Array.Get(slots, s))
        }
        frs = SQL.Open(node)
        IfCondition NotEqual(SQLS.err, 0) ThenBlock: { ReturnValue(frs) }
        IfCondition EqualTo(SQL.BaseTable(node), 1) ThenBlock: {
            locals = RDMEM_64(pack, 16)
            loc = 0
            IfCondition NotEqual(locals, 0) ThenBlock: { loc = Array.Get(locals, s) }
            frs = SQL.FilterFrames(frs, loc)
            IfCondition NotEqual(SQLS.err, 0) ThenBlock: { ReturnValue(frs) }
            Array.Set(slots, s, frs)
            Array.Set(filled, s, 1)
            ix = RDMEM_64(pack, 24)
            IfCondition NotEqual(ix, 0) ThenBlock: {
                Array.Set(ix, s, SQL.IndexFrames(frs))
            }
        }
        back = Add(frs, 0)
        ReturnValue(back)
    }
}

// Filter temps die with the predicate. Row values live on the heap or
// were bumped before this mark, so reclaiming the watermark is safe.
Function.SQL.EvalTruth {
    Input: n: Address
    Output: Integer
    Body: {
        mark = SQLS.used
        v = SQL.Eval(n)
        t = SQL.Truth(v)
        SQLS.used = mark
        IfCondition NotEqual(SQLS.err, 0) ThenBlock: { ReturnValue(0) }
        back = Add(t, 0)
        ReturnValue(back)
    }
}

Function.SQL.EarlyOk {
    Input: preds: Address
    Output: Integer
    Body: {
        i = 0
        WhileLoop LessThan(i, Array.Size(preds)) {
            pr = Array.Get(preds, i)
            IfCondition EqualTo(SQL.Ready(pr), 1) ThenBlock: {
                IfCondition EqualTo(SQL.EvalTruth(pr), 0) ThenBlock: { ReturnValue(0) }
            }
            IfCondition NotEqual(SQLS.err, 0) ThenBlock: { ReturnValue(0) }
            i = Add(i, 1)
        }
        ReturnValue(1)
    }
}

// One path array, pushed and popped. Base-table scans are cached so a
// 10-way join does not bump a fresh frame for every partial row.
Function.SQL.JoinWalk {
    Input: items: Address
    Input: preds: Address
    Input: pack: Address
    Input: s: Integer
    Input: bind: Address
    Input: out: Address
    Body: {
        IfCondition NotEqual(SQLS.err, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(s, Array.Size(items)) ThenBlock: {
            SQLS.scope = bind
            IfCondition EqualTo(SQL.EarlyOk(preds), 1) ThenBlock: {
                Array.Push(out, SQL.BindCopy(bind))
            }
            ReturnValue(0)
        }
        it = Array.Get(items, s)
        kind = RDMEM_64(it)
        node = RDMEM_64(it, 8)
        on = RDMEM_64(it, 16)
        frs = SQL.CachedRows(node, pack, s)
        IfCondition NotEqual(SQLS.err, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(kind, 1) ThenBlock: {
            matched = 0
            f = 0
            nf = Array.Size(frs)
            WhileLoop LessThan(f, nf) {
                Array.Push(bind, Array.Get(frs, f))
                SQLS.scope = bind
                ok = 1
                IfCondition NotEqual(on, 0) ThenBlock: { ok = SQL.EvalTruth(on) }
                IfCondition EqualTo(ok, 1) ThenBlock: {
                    matched = 1
                    SQL.JoinWalk(items, preds, pack, Add(s, 1), bind, out)
                }
                Array.Pop(bind)
                IfCondition NotEqual(SQLS.err, 0) ThenBlock: { ReturnValue(0) }
                f = Add(f, 1)
            }
            IfCondition EqualTo(matched, 0) ThenBlock: {
                pad = SQL.Proto(node)
                IfCondition NotEqual(pad, 0) ThenBlock: {
                    Array.Push(bind, pad)
                    SQL.JoinWalk(items, preds, pack, Add(s, 1), bind, out)
                    Array.Pop(bind)
                }
            }
            ReturnValue(0)
        }
        list = frs
        ix2 = RDMEM_64(pack, 24)
        hashes = 0
        IfCondition NotEqual(ix2, 0) ThenBlock: { hashes = Array.Get(ix2, s) }
        hit = SQL.ProbeList(frs, hashes, preds, RDMEM_64(pack, 32))
        IfCondition NotEqual(hit, 0) ThenBlock: { list = hit }
        IfCondition NotEqual(SQLS.err, 0) ThenBlock: { ReturnValue(0) }
        f2 = 0
        nf2 = Array.Size(list)
        WhileLoop LessThan(f2, nf2) {
            Array.Push(bind, Array.Get(list, f2))
            SQLS.scope = bind
            IfCondition EqualTo(SQL.EarlyOk(preds), 1) ThenBlock: {
                SQL.JoinWalk(items, preds, pack, Add(s, 1), bind, out)
            }
            Array.Pop(bind)
            IfCondition NotEqual(SQLS.err, 0) ThenBlock: { ReturnValue(0) }
            f2 = Add(f2, 1)
        }
        ReturnValue(0)
    }
}

Function.SQL.LitKind {
    Input: k: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(k, SQLK.INT) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(k, SQLK.REAL) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(k, SQLK.TEXT) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(k, SQLK.NULL) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

Function.SQL.ConstEq {
    Input: n: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(n, 0) ThenBlock: { ReturnValue(0) }
        k = SQL.Kind(n)
        IfCondition And(EqualTo(k, SQLK.BIN), EqualTo(SQL.Flags(n), SQLB.EQ)) ThenBlock: {
            IfCondition Or(EqualTo(SQL.LitKind(SQL.Kind(SQL.A(n))), 1), EqualTo(SQL.LitKind(SQL.Kind(SQL.B(n))), 1)) ThenBlock: {
                ReturnValue(1)
            }
        }
        IfCondition EqualTo(k, SQLK.IS) ThenBlock: {
            IfCondition Or(EqualTo(SQL.LitKind(SQL.Kind(SQL.A(n))), 1), EqualTo(SQL.LitKind(SQL.Kind(SQL.B(n))), 1)) ThenBlock: {
                ReturnValue(1)
            }
        }
        ReturnValue(0)
    }
}

Function.SQL.WithReady {
    Input: n: Address
    Input: scope: Address
    Output: Integer
    Body: {
        savedS = SQLS.scope
        savedE = SQLS.err
        savedM = SQLS.errmsg
        SQLS.scope = scope
        r = SQL.Ready(n)
        SQLS.scope = savedS
        SQLS.err = savedE
        SQLS.errmsg = savedM
        back = Add(r, 0)
        ReturnValue(back)
    }
}

Function.SQL.ScopeGain {
    Input: preds: Address
    Input: base: Address
    Input: ext: Address
    Output: Integer
    Body: {
        g = 0
        i = 0
        n = Array.Size(preds)
        WhileLoop LessThan(i, n) {
            pr = Array.Get(preds, i)
            b0 = SQL.WithReady(pr, base)
            b1 = SQL.WithReady(pr, ext)
            IfCondition And(EqualTo(b1, 1), EqualTo(b0, 0)) ThenBlock: {
                g = Add(g, 10)
                IfCondition EqualTo(SQL.ConstEq(pr), 1) ThenBlock: { g = Add(g, 100) }
            }
            i = Add(i, 1)
        }
        back = Add(g, 0)
        ReturnValue(back)
    }
}

Function.SQL.OrderRun {
    Input: items: Address
    Input: preds: Address
    Input: out: Address
    Input: bound: Address
    Input: lo: Integer
    Input: hi: Integer
    Output: Address
    Body: {
        nrun = Subtract(hi, lo)
        used = Array.Create(nrun)
        u = 0
        WhileLoop LessThan(u, nrun) {
            Array.Push(used, 0)
            u = Add(u, 1)
        }
        picked = 0
        bestExt = bound
        WhileLoop LessThan(picked, nrun) {
            best = -1
            bestG = -1
            k = lo
            WhileLoop LessThan(k, hi) {
                rel = Subtract(k, lo)
                IfCondition EqualTo(Array.Get(used, rel), 0) ThenBlock: {
                    it = Array.Get(items, k)
                    node = RDMEM_64(it, 8)
                    fr = SQL.Proto(node)
                    ext = bound
                    IfCondition NotEqual(fr, 0) ThenBlock: { ext = SQL.BindAdd(bound, fr) }
                    g = SQL.ScopeGain(preds, bound, ext)
                    take = 0
                    IfCondition EqualTo(best, -1) ThenBlock: { take = 1 }
                    IfCondition GreaterThan(g, bestG) ThenBlock: { take = 1 }
                    IfCondition EqualTo(take, 1) ThenBlock: {
                        best = k
                        bestG = g
                        bestExt = ext
                    }
                }
                k = Add(k, 1)
            }
            Array.Set(used, Subtract(best, lo), 1)
            Array.Push(out, Array.Get(items, best))
            bound = bestExt
            picked = Add(picked, 1)
        }
        Array.Destroy(used)
        back = Add(bound, 0)
        ReturnValue(back)
    }
}

Function.SQL.OrderFrom {
    Input: items: Address
    Input: preds: Address
    Output: Address
    Body: {
        n = Array.Size(items)
        out = Array.Create(n)
        bound = SQL.BindEmpty()
        i = 0
        WhileLoop LessThan(i, n) {
            it = Array.Get(items, i)
            IfCondition EqualTo(RDMEM_64(it), 1) ThenBlock: {
                Array.Push(out, it)
                fr = SQL.Proto(RDMEM_64(it, 8))
                IfCondition NotEqual(fr, 0) ThenBlock: { bound = SQL.BindAdd(bound, fr) }
                i = Add(i, 1)
            } ElseBlock: {
                j = i
                WhileLoop LessThan(j, n) {
                    IfCondition NotEqual(RDMEM_64(Array.Get(items, j)), 0) ThenBlock: { BreakLoop }
                    j = Add(j, 1)
                }
                bound = SQL.OrderRun(items, preds, out, bound, i, j)
                i = j
            }
        }
        back = Add(out, 0)
        ReturnValue(back)
    }
}

Function.SQL.JoinAll {
    Input: frm: Address
    Input: where: Address
    Output: Address
    Body: {
        items = Array.Create(4)
        preds = Array.Create(4)
        SQL.Collect(frm, items, preds)
        IfCondition NotEqual(where, 0) ThenBlock: { SQL.SplitAnd(where, preds) }
        items = SQL.OrderFrom(items, preds)
        IfCondition NotEqual(SQLS.err, 0) ThenBlock: { ReturnValue(Array.Create(1)) }
        n = Array.Size(items)
        np = Array.Size(preds)
        taken = Array.Create(np)
        t = 0
        WhileLoop LessThan(t, np) {
            Array.Push(taken, 0)
            t = Add(t, 1)
        }
        locals = Array.Create(n)
        slots = Array.Create(n)
        filled = Array.Create(n)
        indexes = Array.Create(n)
        i = 0
        WhileLoop LessThan(i, n) {
            it = Array.Get(items, i)
            Array.Push(locals, SQL.TakeLocal(RDMEM_64(it, 8), preds, taken))
            Array.Push(slots, 0)
            Array.Push(filled, 0)
            Array.Push(indexes, 0)
            i = Add(i, 1)
        }
        rest = Array.Create(np)
        r = 0
        WhileLoop LessThan(r, np) {
            IfCondition EqualTo(Array.Get(taken, r), 0) ThenBlock: {
                Array.Push(rest, Array.Get(preds, r))
            }
            r = Add(r, 1)
        }
        out = Array.Create(8)
        path = SQL.BindEmpty()
        pack = SQL.Bump(40)
        IfCondition EqualTo(pack, 0) ThenBlock: { ReturnValue(Array.Create(1)) }
        WRMEM_64(pack, slots)
        WRMEM_64(pack, 8, filled)
        WRMEM_64(pack, 16, locals)
        WRMEM_64(pack, 24, indexes)
        WRMEM_64(pack, 32, Array.Create(0))
        SQL.JoinWalk(items, rest, pack, 0, path, out)
        Array.Destroy(path)
        IfCondition NotEqual(SQLS.err, 0) ThenBlock: { ReturnValue(Array.Create(1)) }
        aligned = Array.Create(Array.Size(out))
        ai = 0
        WhileLoop LessThan(ai, Array.Size(out)) {
            Array.Push(aligned, SQL.AlignBind(items, Array.Get(out, ai)))
            ai = Add(ai, 1)
        }
        back = Add(aligned, 0)
        ReturnValue(back)
    }
}

Function.SQL.Project {
    Input: sel: Address
    Input: bind: Address
    Output: Address
    Body: {
        SQLS.scope = bind
        vals = Array.Create(4)
        p = SQL.A(sel)
        WhileLoop NotEqual(p, 0) {
            it = SQL.A(p)
            IfCondition EqualTo(SQL.Kind(it), SQLK.STAR) ThenBlock: {
                q = SQL.A(it)
                i = 0
                WhileLoop LessThan(i, Array.Size(bind)) {
                    fr = Array.Get(bind, i)
                    IfCondition EqualTo(SQL.QualOk(fr, q), 1) ThenBlock: {
                        vs = RDMEM_64(fr, 8)
                        c = 0
                        WhileLoop LessThan(c, Array.Size(vs)) {
                            Array.Push(vals, Array.Get(vs, c))
                            c = Add(c, 1)
                        }
                    }
                    i = Add(i, 1)
                }
            } ElseBlock: {
                Array.Push(vals, SQL.Eval(it))
            }
            p = SQL.B(p)
        }
        ReturnValue(vals)
    }
}

Function.SQL.RowKey {
    Input: row: Address
    Output: Address
    Body: {
        key = ""
        i = 0
        n = Array.Size(row)
        WhileLoop LessThan(i, n) {
            c = SQL.Canon(Array.Get(row, i))
            key = StringConcat(key, StringConcat(SQL.IntText(StringLength(c)), StringConcat(":", StringConcat(c, ";"))))
            i = Add(i, 1)
        }
        ReturnValue(key)
    }
}

Function.SQL.Distinct {
    Input: rows: Address
    Input: srcs: Address
    Output: Address
    Body: {
        h = Hash.New()
        nr = Array.Create(8)
        ns = Array.Create(8)
        i = 0
        WhileLoop LessThan(i, Array.Size(rows)) {
            k = SQL.RowKey(Array.Get(rows, i))
            IfCondition EqualTo(Hash.Get(h, k), 0) ThenBlock: {
                Hash.Set(h, k, 1)
                Array.Push(nr, Array.Get(rows, i))
                Array.Push(ns, Array.Get(srcs, i))
            }
            i = Add(i, 1)
        }
        WRMEM_64(SQLS.scratch, nr)
        WRMEM_64(SQLS.scratch, 8, ns)
        ReturnValue(nr)
    }
}

Function.SQL.CmpKV {
    Input: x: Address
    Input: y: Address
    Input: desc: Integer
    Output: Integer
    Body: {
        c = 0
        IfCondition And(EqualTo(SQL.IsNull(x), 1), EqualTo(SQL.IsNull(y), 1)) ThenBlock: {
            c = 0
        } ElseBlock: {
            IfCondition EqualTo(SQL.IsNull(x), 1) ThenBlock: { c = -1 }
            IfCondition EqualTo(SQL.IsNull(y), 1) ThenBlock: { c = 1 }
            IfCondition And(EqualTo(SQL.IsNull(x), 0), EqualTo(SQL.IsNull(y), 0)) ThenBlock: { c = SQL.Cmp3(x, y) }
        }
        IfCondition NotEqual(desc, 0) ThenBlock: { ReturnValue(Negate(c)) }
        ReturnValue(c)
    }
}

Function.SQL.OrderCmp {
    Input: rows: Address
    Input: srcs: Address
    Input: names: Address
    Input: order: Address
    Input: ia: Integer
    Input: ib: Integer
    Output: Integer
    Body: {
        o = order
        WhileLoop NotEqual(o, 0) {
            ex = SQL.A(o)
            desc = SQL.Flags(o)
            va = 0
            vb = 0
            used = 0
            IfCondition EqualTo(SQL.Kind(ex), SQLK.INT) ThenBlock: {
                num = SQL.A(ex)
                IfCondition And(GreaterEqual(num, 1), LessEqual(num, Array.Size(names))) ThenBlock: {
                    va = Array.Get(Array.Get(rows, ia), Subtract(num, 1))
                    vb = Array.Get(Array.Get(rows, ib), Subtract(num, 1))
                    used = 1
                }
            }
            IfCondition And(EqualTo(used, 0), EqualTo(SQL.Kind(ex), SQLK.COL)) ThenBlock: {
                IfCondition EqualTo(SQL.A(ex), 0) ThenBlock: {
                    k = 0
                    WhileLoop LessThan(k, Array.Size(names)) {
                        IfCondition EqualTo(SQL.EqStr(Array.Get(names, k), SQL.B(ex)), 1) ThenBlock: {
                            va = Array.Get(Array.Get(rows, ia), k)
                            vb = Array.Get(Array.Get(rows, ib), k)
                            used = 1
                        }
                        k = Add(k, 1)
                    }
                }
            }
            IfCondition EqualTo(used, 0) ThenBlock: {
                SQLS.scope = Array.Get(srcs, ia)
                va = SQL.Eval(ex)
                SQLS.scope = Array.Get(srcs, ib)
                vb = SQL.Eval(ex)
            }
            c = SQL.CmpKV(va, vb, desc)
            IfCondition NotEqual(c, 0) ThenBlock: { ReturnValue(c) }
            o = SQL.B(o)
        }
        IfCondition LessThan(ia, ib) ThenBlock: { ReturnValue(-1) }
        IfCondition GreaterThan(ia, ib) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

Function.SQL.SortRows {
    Input: rows: Address
    Input: srcs: Address
    Input: names: Address
    Input: order: Address
    Output: Address
    Body: {
        IfCondition EqualTo(order, 0) ThenBlock: { ReturnValue(rows) }
        n = Array.Size(rows)
        idx = Array.Create(n)
        i = 0
        WhileLoop LessThan(i, n) {
            Array.Push(idx, i)
            i = Add(i, 1)
        }
        i = 1
        WhileLoop LessThan(i, n) {
            j = i
            WhileLoop GreaterThan(j, 0) {
                a = Array.Get(idx, j)
                b = Array.Get(idx, Subtract(j, 1))
                IfCondition LessThan(SQL.OrderCmp(rows, srcs, names, order, a, b), 0) ThenBlock: {
                    Array.Set(idx, j, b)
                    Array.Set(idx, Subtract(j, 1), a)
                    j = Subtract(j, 1)
                } ElseBlock: {
                    j = 0
                }
            }
            i = Add(i, 1)
        }
        out = Array.Create(n)
        ns = Array.Create(n)
        i = 0
        WhileLoop LessThan(i, n) {
            at = Array.Get(idx, i)
            Array.Push(out, Array.Get(rows, at))
            Array.Push(ns, Array.Get(srcs, at))
            i = Add(i, 1)
        }
        WRMEM_64(SQLS.scratch, out)
        WRMEM_64(SQLS.scratch, 8, ns)
        ReturnValue(out)
    }
}

Function.SQL.GroupKey {
    Input: grp: Address
    Output: Address
    Body: {
        IfCondition EqualTo(grp, 0) ThenBlock: { ReturnValue("*") }
        key = ""
        p = grp
        WhileLoop NotEqual(p, 0) {
            c = SQL.Canon(SQL.Eval(SQL.A(p)))
            key = StringConcat(key, StringConcat(SQL.IntText(StringLength(c)), StringConcat(":", StringConcat(c, ";"))))
            p = SQL.B(p)
        }
        ReturnValue(key)
    }
}

Function.SQL.WantsAgg {
    Input: sel: Address
    Output: Integer
    Body: {
        IfCondition NotEqual(SQL.D(sel), 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(SQL.TreeAgg(SQL.A(sel)), 1) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(SQL.TreeAgg(SQL.E(sel)), 1) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(SQL.TreeAgg(SQL.F(sel)), 1) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

Function.SQL.ExecCore {
    Input: sel: Address
    Output: Address
    Body: {
        binds = SQL.JoinAll(SQL.B(sel), SQL.C(sel))
        IfCondition NotEqual(SQLS.err, 0) ThenBlock: { ReturnValue(Array.Create(1)) }
        nb = SQL.NullBind(SQL.B(sel))
        names = SQL.NamesOf(sel, nb)
        IfCondition GreaterThan(Array.Size(binds), 0) ThenBlock: { names = SQL.NamesOf(sel, Array.Get(binds, 0)) }
        SQLS.onames = names
        rows = Array.Create(8)
        srcs = Array.Create(8)
        IfCondition EqualTo(SQL.WantsAgg(sel), 0) ThenBlock: {
            i = 0
            WhileLoop And(LessThan(i, Array.Size(binds)), EqualTo(SQLS.err, 0)) {
                b = Array.Get(binds, i)
                proj = SQL.Project(sel, b)
                IfCondition EqualTo(SQLS.err, 0) ThenBlock: {
                    Array.Push(rows, proj)
                    Array.Push(srcs, b)
                }
                i = Add(i, 1)
            }
        } ElseBlock: {
            buckets = Array.Create(4)
            h = Hash.New()
            IfCondition And(EqualTo(Array.Size(binds), 0), EqualTo(SQL.D(sel), 0)) ThenBlock: {
                Array.Push(buckets, Array.Create(1))
            } ElseBlock: {
                i2 = 0
                WhileLoop LessThan(i2, Array.Size(binds)) {
                    b2 = Array.Get(binds, i2)
                    SQLS.scope = b2
                    k = SQL.GroupKey(SQL.D(sel))
                    slot = Hash.Get(h, k)
                    IfCondition EqualTo(slot, 0) ThenBlock: {
                        slot = Array.Create(4)
                        Hash.Set(h, k, slot)
                        Array.Push(buckets, slot)
                    }
                    Array.Push(slot, b2)
                    i2 = Add(i2, 1)
                }
            }
            g = 0
            WhileLoop And(LessThan(g, Array.Size(buckets)), EqualTo(SQLS.err, 0)) {
                bucket = Array.Get(buckets, g)
                sc = nb
                IfCondition GreaterThan(Array.Size(bucket), 0) ThenBlock: { sc = Array.Get(bucket, 0) }
                SQLS.scope = sc
                SQLS.group = bucket
                keep = 1
                IfCondition NotEqual(SQL.E(sel), 0) ThenBlock: { keep = SQL.Truth(SQL.Eval(SQL.E(sel))) }
                IfCondition And(EqualTo(keep, 1), EqualTo(SQLS.err, 0)) ThenBlock: {
                    proj = SQL.Project(sel, sc)
                    IfCondition EqualTo(SQLS.err, 0) ThenBlock: {
                        Array.Push(rows, proj)
                        Array.Push(srcs, sc)
                    }
                }
                SQLS.group = 0
                g = Add(g, 1)
            }
        }
        IfCondition NotEqual(BitwiseAnd(SQL.Flags(sel), 1), 0) ThenBlock: {
            rows = SQL.Distinct(rows, srcs)
            srcs = RDMEM_64(SQLS.scratch, 8)
        }
        IfCondition NotEqual(SQL.F(sel), 0) ThenBlock: {
            rows = SQL.SortRows(rows, srcs, names, SQL.F(sel))
        }
        SQLS.onames = names
        ReturnValue(rows)
    }
}

Function.SQL.Compound {
    Input: n: Address
    Output: Address
    Body: {
        left = SQL.RunSelect(SQL.A(n))
        lnames = SQLS.onames
        right = SQL.RunSelect(SQL.H(n))
        op = SQL.G(n)
        IfCondition EqualTo(op, 2) ThenBlock: {
            i = 0
            WhileLoop LessThan(i, Array.Size(right)) {
                Array.Push(left, Array.Get(right, i))
                i = Add(i, 1)
            }
            SQLS.onames = lnames
            ReturnValue(left)
        }
        rh = Hash.New()
        j = 0
        WhileLoop LessThan(j, Array.Size(right)) {
            Hash.Set(rh, SQL.RowKey(Array.Get(right, j)), 1)
            j = Add(j, 1)
        }
        out = Array.Create(8)
        seen = Hash.New()
        i2 = 0
        WhileLoop LessThan(i2, Array.Size(left)) {
            row = Array.Get(left, i2)
            k = SQL.RowKey(row)
            IfCondition EqualTo(Hash.Get(seen, k), 0) ThenBlock: {
                Hash.Set(seen, k, 1)
                take = 0
                inn = Hash.Get(rh, k)
                IfCondition EqualTo(op, 1) ThenBlock: { take = 1 }
                IfCondition EqualTo(op, 3) ThenBlock: {
                    IfCondition EqualTo(inn, 0) ThenBlock: { take = 1 }
                }
                IfCondition EqualTo(op, 4) ThenBlock: {
                    IfCondition NotEqual(inn, 0) ThenBlock: { take = 1 }
                }
                IfCondition EqualTo(take, 1) ThenBlock: { Array.Push(out, row) }
            }
            i2 = Add(i2, 1)
        }
        IfCondition EqualTo(op, 1) ThenBlock: {
            j2 = 0
            WhileLoop LessThan(j2, Array.Size(right)) {
                row2 = Array.Get(right, j2)
                k2 = SQL.RowKey(row2)
                IfCondition EqualTo(Hash.Get(seen, k2), 0) ThenBlock: {
                    Hash.Set(seen, k2, 1)
                    Array.Push(out, row2)
                }
                j2 = Add(j2, 1)
            }
        }
        SQLS.onames = lnames
        ReturnValue(out)
    }
}

Function.SQL.LimitCount {
    Input: ex: Address
    Output: Integer
    Body: {
        IfCondition NotEqual(SQLS.err, 0) ThenBlock: { ReturnValue(0) }
        v = SQL.Eval(ex)
        IfCondition NotEqual(SQLS.err, 0) ThenBlock: { ReturnValue(0) }
        k = SQL.MustInt(v)
        IfCondition NotEqual(SQLS.err, 0) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(k, 0) ThenBlock: { ReturnValue(-1) }
        ReturnValue(k)
    }
}

Function.SQL.LimitOff {
    Input: ex: Address
    Output: Integer
    Body: {
        IfCondition NotEqual(SQLS.err, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(ex, 0) ThenBlock: { ReturnValue(0) }
        v = SQL.Eval(ex)
        IfCondition NotEqual(SQLS.err, 0) ThenBlock: { ReturnValue(0) }
        k = SQL.MustInt(v)
        IfCondition NotEqual(SQLS.err, 0) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(k, 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(k)
    }
}

Function.SQL.LimitRows {
    Input: rows: Address
    Input: lim: Integer
    Input: off: Integer
    Output: Address
    Body: {
        IfCondition And(EqualTo(off, 0), LessThan(lim, 0)) ThenBlock: { ReturnValue(rows) }
        out = Array.Create(8)
        n = Array.Size(rows)
        i = off
        got = 0
        WhileLoop LessThan(i, n) {
            IfCondition And(GreaterEqual(lim, 0), GreaterEqual(got, lim)) ThenBlock: {
                early = Add(out, 0)
                ReturnValue(early)
            }
            Array.Push(out, Array.Get(rows, i))
            i = Add(i, 1)
            got = Add(got, 1)
        }
        back = Add(out, 0)
        ReturnValue(back)
    }
}

Function.SQL.LimitKeep {
    Input: p: Address
    Output: Address
    Body: {
        back = Add(p, 0)
        ReturnValue(back)
    }
}

Function.SQL.Limited {
    Input: n: Address
    Output: Address
    Body: {
        cnt = SQL.LimitCount(SQL.B(n))
        off = SQL.LimitOff(SQL.C(n))
        IfCondition NotEqual(SQLS.err, 0) ThenBlock: { ReturnValue(Array.Create(1)) }
        rs = SQL.RunSelect(SQL.A(n))
        IfCondition NotEqual(SQLS.err, 0) ThenBlock: { ReturnValue(SQL.LimitKeep(rs)) }
        out = SQL.LimitRows(rs, cnt, off)
        IfCondition EqualTo(SQLS.depth, 0) ThenBlock: { SQLS.rows = out }
        ReturnValue(SQL.LimitKeep(out))
    }
}

Function.SQL.RunSelect {
    Input: n: Address
    Output: Address
    Body: {
        IfCondition EqualTo(SQL.Kind(n), SQLK.LIM) ThenBlock: { ReturnValue(SQL.Limited(n)) }
        d = SQLS.depth
        IfCondition GreaterThan(d, 80) ThenBlock: {
            SQL.Fail("too deep")
            ReturnValue(Array.Create(1))
        }
        savedS = SQLS.scope
        savedO = SQLS.outer
        savedG = SQLS.group
        savedR = SQLS.rows
        savedN = SQLS.onames
        cell = SQL.Bump(24)
        IfCondition EqualTo(cell, 0) ThenBlock: { ReturnValue(Array.Create(1)) }
        WRMEM_64(cell, savedS)
        WRMEM_64(cell, 8, savedO)
        WRMEM_64(cell, 16, d)
        SQLS.outer = cell
        SQLS.depth = Add(d, 1)
        SQLS.group = 0
        rs = 0
        IfCondition NotEqual(BitwiseAnd(SQL.Flags(n), 2), 0) ThenBlock: {
            rs = SQL.Compound(n)
            IfCondition NotEqual(SQL.F(n), 0) ThenBlock: {
                srcs = Array.Create(Array.Size(rs))
                i = 0
                WhileLoop LessThan(i, Array.Size(rs)) {
                    Array.Push(srcs, SQL.BindEmpty())
                    i = Add(i, 1)
                }
                rs = SQL.SortRows(rs, srcs, SQLS.onames, SQL.F(n))
            }
        } ElseBlock: {
            rs = SQL.ExecCore(n)
        }
        names = SQLS.onames
        SQLS.scope = savedS
        SQLS.outer = savedO
        SQLS.group = savedG
        SQLS.rows = savedR
        SQLS.onames = savedN
        SQLS.depth = d
        SQLS.onames = names
        IfCondition EqualTo(d, 0) ThenBlock: { SQLS.rows = rs }
        ReturnValue(rs)
    }
}
