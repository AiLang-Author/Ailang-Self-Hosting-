Function.SQL.G { Input: n: Address Output: Integer Body: { ReturnValue(SQL.Get(n, 8)) } }
Function.SQL.H { Input: n: Address Output: Integer Body: { ReturnValue(SQL.Get(n, 9)) } }

Function.SQL.SetA { Input: n: Address Input: v: Integer Body: { SQL.Set(n, 2, v) } }
Function.SQL.SetB { Input: n: Address Input: v: Integer Body: { SQL.Set(n, 3, v) } }
Function.SQL.SetC { Input: n: Address Input: v: Integer Body: { SQL.Set(n, 4, v) } }
Function.SQL.SetD { Input: n: Address Input: v: Integer Body: { SQL.Set(n, 5, v) } }
Function.SQL.SetE { Input: n: Address Input: v: Integer Body: { SQL.Set(n, 6, v) } }
Function.SQL.SetF { Input: n: Address Input: v: Integer Body: { SQL.Set(n, 7, v) } }
Function.SQL.SetG { Input: n: Address Input: v: Integer Body: { SQL.Set(n, 8, v) } }
Function.SQL.SetH { Input: n: Address Input: v: Integer Body: { SQL.Set(n, 9, v) } }

Function.SQL.Str {
    Input: s: Address
    Input: n: Integer
    Output: Address
    Body: {
        p = SQL.Bump(Add(n, 1))
        IfCondition EqualTo(p, 0) ThenBlock: { ReturnValue(0) }
        i = 0
        WhileLoop LessThan(i, n) {
            WRMEM_8(p, i, RDMEM_8(s, i))
            i = Add(i, 1)
        }
        WRMEM_8(p, n, 0)
        ReturnValue(p)
    }
}

Function.SQL.StrZ {
    Input: s: Address
    Output: Address
    Body: {
        ReturnValue(SQL.Str(s, StringLength(s)))
    }
}

Function.SQL.HeapStr {
    Input: s: Address
    Output: Address
    Body: {
        n = StringLength(s)
        p = Allocate(Add(n, 1))
        i = 0
        WhileLoop LessEqual(i, n) {
            WRMEM_8(p, i, RDMEM_8(s, i))
            i = Add(i, 1)
        }
        ReturnValue(p)
    }
}

Function.SQL.Lower {
    Input: s: Address
    Output: Address
    Body: {
        n = StringLength(s)
        p = SQL.Bump(Add(n, 1))
        i = 0
        WhileLoop LessThan(i, n) {
            c = RDMEM_8(s, i)
            IfCondition And(GreaterEqual(c, 65), LessEqual(c, 90)) ThenBlock: {
                c = Add(c, 32)
            }
            WRMEM_8(p, i, c)
            i = Add(i, 1)
        }
        WRMEM_8(p, n, 0)
        ReturnValue(p)
    }
}

Function.SQL.EqStr {
    Input: a: Address
    Input: b: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(a, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(b, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(StringCompare(a, b), 0) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}
