FixedPool.SQLS {
    "ready": Initialize=0, CanChange=True
    "mem": Initialize=0, CanChange=True
    "used": Initialize=0, CanChange=True
    "cap": Initialize=0, CanChange=True
    "err": Initialize=0, CanChange=True
    "errmsg": Initialize=0, CanChange=True
    "tabs": Initialize=0, CanChange=True
    "idxs": Initialize=0, CanChange=True
    "views": Initialize=0, CanChange=True
    "trigs": Initialize=0, CanChange=True
    "idxlist": Initialize=0, CanChange=True
    "src": Initialize=0, CanChange=True
    "slen": Initialize=0, CanChange=True
    "pos": Initialize=0, CanChange=True
    "tok": Initialize=0, CanChange=True
    "ttext": Initialize=0, CanChange=True
    "tnum": Initialize=0, CanChange=True
    "treal": Initialize=0, CanChange=True
    "tfloat": Initialize=0, CanChange=True
    "tlen": Initialize=0, CanChange=True
    "infire": Initialize=0, CanChange=True
    "scope": Initialize=0, CanChange=True
    "depth": Initialize=0, CanChange=True
    "nagg": Initialize=0, CanChange=True
    "group": Initialize=0, CanChange=True
    "final": Initialize=0, CanChange=True
    "nrows": Initialize=0, CanChange=True
    "cur": Initialize=0, CanChange=True
    "rows": Initialize=0, CanChange=True
    "outer": Initialize=0, CanChange=True
    "minouter": Initialize=999, CanChange=True
    "scratch": Initialize=0, CanChange=True
    "onames": Initialize=0, CanChange=True
}

Function.SQL.Boot {
    Output: Integer
    Body: {
        IfCondition NotEqual(SQLS.ready, 0) ThenBlock: {
            ReturnValue(1)
        }
        SQLS.cap = 33554432
        SQLS.mem = Allocate(SQLS.cap)
        IfCondition EqualTo(SQLS.mem, 0) ThenBlock: {
            ReturnValue(0)
        }
        SQLS.used = 0
        SQLS.tabs = Hash.New()
        SQLS.idxs = Hash.New()
        SQLS.views = Hash.New()
        SQLS.trigs = Hash.New()
        SQLS.idxlist = Array.Create(8)
        SQLS.scratch = Allocate(16)
        SQLS.errmsg = "sql error"
        SQLS.err = 0
        SQLS.ready = 1
        ReturnValue(1)
    }
}

Function.SQL.Reset {
    Body: {
        SQLS.used = 0
        SQLS.err = 0
        SQLS.errmsg = "sql error"
        SQLS.nagg = 0
        SQLS.group = 0
        SQLS.final = 0
        SQLS.depth = 0
        SQLS.scope = SQLS.depth
        SQLS.outer = SQLS.depth
        SQLS.infire = 0
    }
}

Function.SQL.Fail {
    Input: msg: Address
    Output: Integer
    Body: {
        SQLS.err = 1
        SQLS.errmsg = msg
        ReturnValue(0)
    }
}

Function.SQL.Bump {
    Input: n: Integer
    Output: Address
    Body: {
        align = BitwiseAnd(Add(SQLS.used, 7), BitwiseNot(7))
        nxt = Add(align, n)
        IfCondition GreaterThan(nxt, SQLS.cap) ThenBlock: {
            SQL.Fail("out of memory")
            ReturnValue(0)
        }
        p = Add(SQLS.mem, align)
        MemorySet(p, 0, n)
        SQLS.used = nxt
        ReturnValue(p)
    }
}

Function.SQL.Node {
    Input: kind: Integer
    Output: Address
    Body: {
        p = SQL.Bump(80)
        IfCondition EqualTo(p, 0) ThenBlock: {
            ReturnValue(0)
        }
        WRMEM_64(p, kind)
        ReturnValue(p)
    }
}

Function.SQL.Kind {
    Input: n: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(n, 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(RDMEM_64(n))
    }
}

Function.SQL.Get {
    Input: n: Address
    Input: slot: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(n, 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(RDMEM_64(n, Multiply(slot, 8)))
    }
}

Function.SQL.Set {
    Input: n: Address
    Input: slot: Integer
    Input: value: Integer
    Body: {
        IfCondition EqualTo(n, 0) ThenBlock: { ReturnValue(0) }
        WRMEM_64(n, Multiply(slot, 8), value)
    }
}

Function.SQL.Flags {
    Input: n: Address
    Output: Integer
    Body: {
        ReturnValue(SQL.Get(n, 1))
    }
}

Function.SQL.SetFlags {
    Input: n: Address
    Input: f: Integer
    Body: {
        SQL.Set(n, 1, f)
    }
}

Function.SQL.A { Input: n: Address Output: Integer Body: { ReturnValue(SQL.Get(n, 2)) } }
