// Library.SQLStore.ailang — catalog, rows, and unique/primary-key checks.
// Rows live on the system heap so they survive the per-statement arena reset.
// Copyright (c) 2026 Sean Collins, 2 Paws Machine and Engineering. SCSL.

LibraryImport.SQLiteSQL.SQLParse

Function.SQL.HName {
    Input: s: Address
    Output: Address
    Body: {
        IfCondition EqualTo(s, 0) ThenBlock: { ReturnValue(SQL.HeapStr("")) }
        ReturnValue(SQL.HeapStr(s))
    }
}

Function.SQL.Persist {
    Input: v: Address
    Output: Address
    Body: {
        IfCondition EqualTo(SQL.IsNull(v), 1) ThenBlock: { ReturnValue(SQL.VHeap(SQLV.NULL)) }
        t = SQL.VTag(v)
        IfCondition EqualTo(t, SQLV.INT) ThenBlock: { ReturnValue(SQL.IntH(SQL.VBits(v))) }
        IfCondition EqualTo(t, SQLV.REAL) ThenBlock: { ReturnValue(SQL.RealH(SQL.VBits(v))) }
        IfCondition EqualTo(t, SQLV.TEXT) ThenBlock: { ReturnValue(SQL.TextH(SQL.VTxt(v))) }
        IfCondition EqualTo(t, SQLV.BLOB) ThenBlock: { ReturnValue(SQL.BlobH(SQL.VTxt(v), SQL.VBits(v))) }
        ReturnValue(SQL.VHeap(SQLV.NULL))
    }
}

Function.SQL.FindTab {
    Input: name: Address
    Output: Address
    Body: {
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(Hash.Get(SQLS.tabs, name))
    }
}

Function.SQL.FindView {
    Input: name: Address
    Output: Address
    Body: {
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(Hash.Get(SQLS.views, name))
    }
}

Function.SQL.FindIdx {
    Input: name: Address
    Output: Address
    Body: {
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(Hash.Get(SQLS.idxs, name))
    }
}

Function.SQL.FindTrig {
    Input: name: Address
    Output: Address
    Body: {
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(Hash.Get(SQLS.trigs, name))
    }
}

Function.SQL.ColCount {
    Input: tbl: Address
    Output: Integer
    Body: { ReturnValue(RDMEM_64(tbl, 8)) }
}

Function.SQL.ColAt {
    Input: tbl: Address
    Input: i: Integer
    Output: Address
    Body: { ReturnValue(Array.Get(RDMEM_64(tbl, 16), i)) }
}

Function.SQL.ColName {
    Input: col: Address
    Output: Address
    Body: { ReturnValue(RDMEM_64(col)) }
}

Function.SQL.ColAff {
    Input: col: Address
    Output: Integer
    Body: { ReturnValue(RDMEM_64(col, 8)) }
}

Function.SQL.ColBits {
    Input: col: Address
    Output: Integer
    Body: { ReturnValue(RDMEM_64(col, 16)) }
}

Function.SQL.TabRows {
    Input: tbl: Address
    Output: Address
    Body: { ReturnValue(RDMEM_64(tbl, 24)) }
}

Function.SQL.TabRowids {
    Input: tbl: Address
    Output: Address
    Body: { ReturnValue(RDMEM_64(tbl, 32)) }
}

Function.SQL.TabIpk {
    Input: tbl: Address
    Output: Integer
    Body: { ReturnValue(RDMEM_64(tbl, 48)) }
}

Function.SQL.TabKeys {
    Input: tbl: Address
    Output: Address
    Body: { ReturnValue(RDMEM_64(tbl, 56)) }
}

Function.SQL.TabNames {
    Input: tbl: Address
    Output: Address
    Body: { ReturnValue(RDMEM_64(tbl, 64)) }
}

Function.SQL.NRows {
    Input: tbl: Address
    Output: Integer
    Body: { ReturnValue(Array.Size(SQL.TabRows(tbl))) }
}

Function.SQL.RowAt {
    Input: tbl: Address
    Input: i: Integer
    Output: Address
    Body: { ReturnValue(Array.Get(SQL.TabRows(tbl), i)) }
}

Function.SQL.RowidAt {
    Input: tbl: Address
    Input: i: Integer
    Output: Integer
    Body: { ReturnValue(Array.Get(SQL.TabRowids(tbl), i)) }
}

Function.SQL.MaxRowid {
    Input: tbl: Address
    Output: Integer
    Body: {
        n = SQL.NRows(tbl)
        m = 0
        i = 0
        WhileLoop LessThan(i, n) {
            r = SQL.RowidAt(tbl, i)
            IfCondition GreaterThan(r, m) ThenBlock: { m = r }
            i = Add(i, 1)
        }
        ReturnValue(m)
    }
}

Function.SQL.AddKey {
    Input: tbl: Address
    Input: cols: Address
    Body: {
        Array.Push(SQL.TabKeys(tbl), cols)
    }
}

Function.SQL.MarkPks {
    Input: tbl: Address
    Input: head: Address
    Body: {
        p = head
        WhileLoop NotEqual(p, 0) {
            d = SQL.A(p)
            IfCondition EqualTo(SQL.B(d), 8) ThenBlock: {
                nm = SQL.A(d)
                i = 0
                nc = SQL.ColCount(tbl)
                WhileLoop LessThan(i, nc) {
                    c = SQL.ColAt(tbl, i)
                    IfCondition EqualTo(SQL.EqStr(SQL.ColName(c), nm), 1) ThenBlock: {
                        WRMEM_64(c, 16, BitwiseOr(SQL.ColBits(c), 1))
                    }
                    i = Add(i, 1)
                }
            }
            p = SQL.B(p)
        }
    }
}

Function.SQL.BuildKeys {
    Input: tbl: Address
    Body: {
        nc = SQL.ColCount(tbl)
        pk = Array.Create(4)
        npk = 0
        ipk = -1
        i = 0
        WhileLoop LessThan(i, nc) {
            c = SQL.ColAt(tbl, i)
            bits = SQL.ColBits(c)
            IfCondition NotEqual(BitwiseAnd(bits, 1), 0) ThenBlock: {
                Array.Push(pk, i)
                npk = Add(npk, 1)
                IfCondition And(EqualTo(RDMEM_64(c, 24), 1), EqualTo(SQL.ColAff(c), SQLA.INT)) ThenBlock: {
                    ipk = i
                }
            }
            IfCondition NotEqual(BitwiseAnd(bits, 2), 0) ThenBlock: {
                u = Array.Create(1)
                Array.Push(u, i)
                SQL.AddKey(tbl, u)
            }
            i = Add(i, 1)
        }
        IfCondition GreaterThan(npk, 1) ThenBlock: { ipk = -1 }
        IfCondition And(EqualTo(npk, 1), NotEqual(ipk, -1)) ThenBlock: {
            one = Array.Create(1)
            Array.Push(one, ipk)
            SQL.AddKey(tbl, one)
        }
        IfCondition And(GreaterThan(npk, 0), EqualTo(ipk, -1)) ThenBlock: {
            SQL.AddKey(tbl, pk)
        }
        WRMEM_64(tbl, 48, ipk)
    }
}

Function.SQL.DoCreateTable {
    Input: n: Address
    Output: Integer
    Body: {
        nm = SQL.HName(SQL.A(n))
        old = SQL.FindTab(nm)
        IfCondition NotEqual(old, 0) ThenBlock: {
            IfCondition EqualTo(SQL.D(n), 1) ThenBlock: { ReturnValue(1) }
            SQL.Fail("table exists")
            ReturnValue(0)
        }
        IfCondition NotEqual(SQL.FindView(nm), 0) ThenBlock: {
            SQL.Fail("table exists")
            ReturnValue(0)
        }
        tbl = Allocate(80)
        MemorySet(tbl, 0, 80)
        WRMEM_64(tbl, nm)
        cols = Array.Create(4)
        names = Array.Create(4)
        p = SQL.B(n)
        WhileLoop NotEqual(p, 0) {
            d = SQL.A(p)
            IfCondition NotEqual(SQL.B(d), 8) ThenBlock: {
                c = Allocate(32)
                MemorySet(c, 0, 32)
                WRMEM_64(c, SQL.HName(SQL.A(d)))
                WRMEM_64(c, 8, SQL.Flags(d))
                WRMEM_64(c, 16, SQL.B(d))
                WRMEM_64(c, 24, SQL.C(d))
                Array.Push(cols, c)
                Array.Push(names, RDMEM_64(c))
            }
            p = SQL.B(p)
        }
        WRMEM_64(tbl, 8, Array.Size(cols))
        WRMEM_64(tbl, 16, cols)
        WRMEM_64(tbl, 24, Array.Create(8))
        WRMEM_64(tbl, 32, Array.Create(8))
        WRMEM_64(tbl, 48, -1)
        WRMEM_64(tbl, 56, Array.Create(2))
        WRMEM_64(tbl, 64, names)
        SQL.MarkPks(tbl, SQL.B(n))
        SQL.BuildKeys(tbl)
        Hash.Set(SQLS.tabs, nm, tbl)
        ReturnValue(1)
    }
}

Function.SQL.ColIndex {
    Input: tbl: Address
    Input: name: Address
    Output: Integer
    Body: {
        i = 0
        n = SQL.ColCount(tbl)
        WhileLoop LessThan(i, n) {
            IfCondition EqualTo(SQL.EqStr(SQL.ColName(SQL.ColAt(tbl, i)), name), 1) ThenBlock: { ReturnValue(i) }
            i = Add(i, 1)
        }
        ReturnValue(-1)
    }
}

Function.SQL.DoCreateIndex {
    Input: n: Address
    Output: Integer
    Body: {
        nm = SQL.HName(SQL.A(n))
        IfCondition NotEqual(SQL.FindIdx(nm), 0) ThenBlock: {
            IfCondition EqualTo(SQL.D(n), 1) ThenBlock: { ReturnValue(1) }
            SQL.Fail("index exists")
            ReturnValue(0)
        }
        tb = SQL.HName(SQL.B(n))
        tbl = SQL.FindTab(tb)
        IfCondition EqualTo(tbl, 0) ThenBlock: {
            SQL.Fail("no such table")
            ReturnValue(0)
        }
        cn = Array.Create(2)
        p = SQL.C(n)
        WhileLoop NotEqual(p, 0) {
            d = SQL.A(p)
            ix = SQL.ColIndex(tbl, SQL.A(d))
            IfCondition LessThan(ix, 0) ThenBlock: {
                SQL.Fail("no such column")
                ReturnValue(0)
            }
            Array.Push(cn, ix)
            p = SQL.B(p)
        }
        idx = Allocate(32)
        MemorySet(idx, 0, 32)
        WRMEM_64(idx, nm)
        WRMEM_64(idx, 8, tb)
        WRMEM_64(idx, 16, SQL.Flags(n))
        WRMEM_64(idx, 24, cn)
        IfCondition NotEqual(SQL.Flags(n), 0) ThenBlock: {
            IfCondition EqualTo(SQL.DupKey(tbl, cn), 1) ThenBlock: {
                SQL.Fail("constraint")
                ReturnValue(0)
            }
            SQL.AddKey(tbl, cn)
        }
        Hash.Set(SQLS.idxs, nm, idx)
        Array.Push(SQLS.idxlist, idx)
        ReturnValue(1)
    }
}

Function.SQL.DupKey {
    Input: tbl: Address
    Input: key: Address
    Output: Integer
    Body: {
        n = SQL.NRows(tbl)
        i = 0
        WhileLoop LessThan(i, n) {
            j = Add(i, 1)
            WhileLoop LessThan(j, n) {
                IfCondition EqualTo(SQL.SameKey(SQL.RowAt(tbl, i), SQL.RowAt(tbl, j), key), 1) ThenBlock: { ReturnValue(1) }
                j = Add(j, 1)
            }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

Function.SQL.Unkey {
    Input: tbl: Address
    Input: key: Address
    Body: {
        old = SQL.TabKeys(tbl)
        nxt = Array.Create(2)
        i = 0
        WhileLoop LessThan(i, Array.Size(old)) {
            k = Array.Get(old, i)
            IfCondition NotEqual(k, key) ThenBlock: { Array.Push(nxt, k) }
            i = Add(i, 1)
        }
        WRMEM_64(tbl, 56, nxt)
    }
}

Function.SQL.DoCreateView {
    Input: n: Address
    Output: Integer
    Body: {
        nm = SQL.HName(SQL.A(n))
        IfCondition Or(NotEqual(SQL.FindView(nm), 0), NotEqual(SQL.FindTab(nm), 0)) ThenBlock: {
            IfCondition EqualTo(SQL.D(n), 1) ThenBlock: { ReturnValue(1) }
            SQL.Fail("view exists")
            ReturnValue(0)
        }
        v = Allocate(16)
        WRMEM_64(v, nm)
        WRMEM_64(v, 8, SQL.HName(SQL.B(n)))
        Hash.Set(SQLS.views, nm, v)
        ReturnValue(1)
    }
}

Function.SQL.DoCreateTrig {
    Input: n: Address
    Output: Integer
    Body: {
        nm = SQL.HName(SQL.A(n))
        IfCondition NotEqual(SQL.FindTrig(nm), 0) ThenBlock: {
            SQL.Fail("trigger exists")
            ReturnValue(0)
        }
        t = Allocate(56)
        WRMEM_64(t, nm)
        WRMEM_64(t, 8, SQL.HName(SQL.B(n)))
        WRMEM_64(t, 16, SQL.C(n))
        WRMEM_64(t, 24, SQL.D(n))
        WRMEM_64(t, 32, SQL.HName(SQL.E(n)))
        whs = 0
        IfCondition NotEqual(SQL.F(n), 0) ThenBlock: { whs = SQL.HName(SQL.F(n)) }
        ofs = 0
        IfCondition NotEqual(SQL.G(n), 0) ThenBlock: { ofs = SQL.HName(SQL.G(n)) }
        WRMEM_64(t, 40, whs)
        WRMEM_64(t, 48, ofs)
        Hash.Set(SQLS.trigs, nm, t)
        Array.Push(SQLS.idxlist, t)
        ReturnValue(1)
    }
}

Function.SQL.DropIdxOn {
    Input: tname: Address
    Body: {
        old = SQLS.idxlist
        nxt = Array.Create(4)
        i = 0
        n = Array.Size(old)
        WhileLoop LessThan(i, n) {
            idx = Array.Get(old, i)
            nm = RDMEM_64(idx)
            tb = RDMEM_64(idx, 8)
            IfCondition EqualTo(SQL.EqStr(tb, tname), 1) ThenBlock: {
                IfCondition NotEqual(SQL.FindIdx(nm), 0) ThenBlock: { Hash.Delete(SQLS.idxs, nm) }
                IfCondition NotEqual(SQL.FindTrig(nm), 0) ThenBlock: { Hash.Delete(SQLS.trigs, nm) }
            } ElseBlock: {
                Array.Push(nxt, idx)
            }
            i = Add(i, 1)
        }
        SQLS.idxlist = nxt
    }
}

Function.SQL.DoDrop {
    Input: n: Address
    Output: Integer
    Body: {
        kind = SQL.Flags(n)
        nm = SQL.HName(SQL.A(n))
        iex = SQL.B(n)
        IfCondition EqualTo(kind, 1) ThenBlock: {
            tbl = SQL.FindTab(nm)
            IfCondition EqualTo(tbl, 0) ThenBlock: {
                IfCondition EqualTo(iex, 1) ThenBlock: { ReturnValue(1) }
                SQL.Fail("no such table")
                ReturnValue(0)
            }
            SQL.DropIdxOn(nm)
            Hash.Delete(SQLS.tabs, nm)
            ReturnValue(1)
        }
        IfCondition EqualTo(kind, 2) ThenBlock: {
            idx = SQL.FindIdx(nm)
            IfCondition EqualTo(idx, 0) ThenBlock: {
                IfCondition EqualTo(iex, 1) ThenBlock: { ReturnValue(1) }
                SQL.Fail("no such index")
                ReturnValue(0)
            }
            SQL.Unkey(SQL.FindTab(RDMEM_64(idx, 8)), RDMEM_64(idx, 24))
            Hash.Delete(SQLS.idxs, nm)
            old = SQLS.idxlist
            nxt = Array.Create(4)
            i = 0
            WhileLoop LessThan(i, Array.Size(old)) {
                it = Array.Get(old, i)
                IfCondition NotEqual(it, idx) ThenBlock: { Array.Push(nxt, it) }
                i = Add(i, 1)
            }
            SQLS.idxlist = nxt
            ReturnValue(1)
        }
        IfCondition EqualTo(kind, 3) ThenBlock: {
            IfCondition EqualTo(SQL.FindView(nm), 0) ThenBlock: {
                IfCondition EqualTo(iex, 1) ThenBlock: { ReturnValue(1) }
                SQL.Fail("no such view")
                ReturnValue(0)
            }
            Hash.Delete(SQLS.views, nm)
            ReturnValue(1)
        }
        IfCondition EqualTo(SQL.FindTrig(nm), 0) ThenBlock: {
            IfCondition EqualTo(iex, 1) ThenBlock: { ReturnValue(1) }
            SQL.Fail("no such trigger")
            ReturnValue(0)
        }
        Hash.Delete(SQLS.trigs, nm)
        ReturnValue(1)
    }
}

Function.SQL.SameKey {
    Input: row: Address
    Input: vals: Address
    Input: key: Address
    Output: Integer
    Body: {
        i = 0
        n = Array.Size(key)
        IfCondition EqualTo(n, 0) ThenBlock: { ReturnValue(0) }
        WhileLoop LessThan(i, n) {
            c = Array.Get(key, i)
            a = Array.Get(row, c)
            b = Array.Get(vals, c)
            IfCondition Or(EqualTo(SQL.IsNull(a), 1), EqualTo(SQL.IsNull(b), 1)) ThenBlock: { ReturnValue(0) }
            IfCondition NotEqual(SQL.Cmp3(a, b), 0) ThenBlock: { ReturnValue(0) }
            i = Add(i, 1)
        }
        ReturnValue(1)
    }
}

Function.SQL.Conflicts {
    Input: tbl: Address
    Input: vals: Address
    Input: skip: Integer
    Output: Address
    Body: {
        hit = Array.Create(2)
        nr = SQL.NRows(tbl)
        keys = SQL.TabKeys(tbl)
        nk = Array.Size(keys)
        r = 0
        WhileLoop LessThan(r, nr) {
            IfCondition NotEqual(r, skip) ThenBlock: {
                row = SQL.RowAt(tbl, r)
                k = 0
                bad = 0
                WhileLoop LessThan(k, nk) {
                    IfCondition EqualTo(SQL.SameKey(row, vals, Array.Get(keys, k)), 1) ThenBlock: { bad = 1 }
                    k = Add(k, 1)
                }
                IfCondition EqualTo(bad, 1) ThenBlock: { Array.Push(hit, r) }
            }
            r = Add(r, 1)
        }
        ReturnValue(hit)
    }
}

Function.SQL.DelAt {
    Input: tbl: Address
    Input: index: Integer
    Body: {
        rows = SQL.TabRows(tbl)
        ids = SQL.TabRowids(tbl)
        nr = Array.Create(8)
        ni = Array.Create(8)
        i = 0
        n = Array.Size(rows)
        WhileLoop LessThan(i, n) {
            IfCondition NotEqual(i, index) ThenBlock: {
                Array.Push(nr, Array.Get(rows, i))
                Array.Push(ni, Array.Get(ids, i))
            }
            i = Add(i, 1)
        }
        WRMEM_64(tbl, 24, nr)
        WRMEM_64(tbl, 32, ni)
    }
}

Function.SQL.PutRow {
    Input: tbl: Address
    Input: vals: Address
    Input: mode: Integer
    Output: Integer
    Body: {
        ipk = SQL.TabIpk(tbl)
        IfCondition GreaterEqual(ipk, 0) ThenBlock: {
            cur = Array.Get(vals, ipk)
            IfCondition EqualTo(SQL.IsNull(cur), 1) ThenBlock: {
                nid = Add(SQL.MaxRowid(tbl), 1)
                Array.Set(vals, ipk, SQL.IntH(nid))
            }
        }
        ci = 0
        WhileLoop LessThan(ci, SQL.ColCount(tbl)) {
            bits = SQL.ColBits(SQL.ColAt(tbl, ci))
            IfCondition And(NotEqual(BitwiseAnd(bits, 4), 0), EqualTo(SQL.IsNull(Array.Get(vals, ci)), 1)) ThenBlock: {
                SQL.Fail("not null")
                ReturnValue(0)
            }
            ci = Add(ci, 1)
        }
        hit = SQL.Conflicts(tbl, vals, -1)
        nh = Array.Size(hit)
        IfCondition GreaterThan(nh, 0) ThenBlock: {
            IfCondition EqualTo(mode, 2) ThenBlock: { ReturnValue(1) }
            IfCondition EqualTo(mode, 0) ThenBlock: {
                SQL.Fail("constraint")
                ReturnValue(0)
            }
            i = Subtract(nh, 1)
            WhileLoop GreaterEqual(i, 0) {
                SQL.DelAt(tbl, Array.Get(hit, i))
                i = Subtract(i, 1)
            }
        }
        rid = Add(SQL.MaxRowid(tbl), 1)
        IfCondition GreaterEqual(ipk, 0) ThenBlock: { rid = SQL.VBits(Array.Get(vals, ipk)) }
        Array.Push(SQL.TabRows(tbl), vals)
        Array.Push(SQL.TabRowids(tbl), rid)
        ReturnValue(1)
    }
}
