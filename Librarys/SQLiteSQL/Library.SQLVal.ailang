// Library.SQLVal.ailang — one function per value operation.
// Tags: 1 null, 2 int, 3 real, 4 text, 5 blob. Real bits sit in the same word as an int.
// A blob stores its byte length at +8 and the bytes at +16. The length is authoritative.
// Copyright (c) 2026 Sean Collins, 2 Paws Machine and Engineering. SCSL.

LibraryImport.SQLiteSQL.SQLState

FixedPool.SQLV {
    "NULL": Initialize=1
    "INT": Initialize=2
    "REAL": Initialize=3
    "TEXT": Initialize=4
    "BLOB": Initialize=5
}

Function.SQL.VNew {
    Input: tag: Integer
    Output: Address
    Body: {
        p = SQL.Bump(24)
        IfCondition EqualTo(p, 0) ThenBlock: { ReturnValue(0) }
        WRMEM_64(p, tag)
        ReturnValue(p)
    }
}

Function.SQL.VHeap {
    Input: tag: Integer
    Output: Address
    Body: {
        p = Allocate(24)
        MemorySet(p, 0, 24)
        WRMEM_64(p, tag)
        ReturnValue(p)
    }
}

Function.SQL.VTag { Input: v: Address Output: Integer Body: { IfCondition EqualTo(v, 0) ThenBlock: { ReturnValue(1) } ReturnValue(RDMEM_64(v)) } }
Function.SQL.VBits { Input: v: Address Output: Integer Body: { ReturnValue(RDMEM_64(v, 8)) } }
Function.SQL.VTxt { Input: v: Address Output: Address Body: { ReturnValue(RDMEM_64(v, 16)) } }

Function.SQL.Null {
    Output: Address
    Body: { ReturnValue(SQL.VNew(SQLV.NULL)) }
}

Function.SQL.Int {
    Input: i: Integer
    Output: Address
    Body: {
        p = SQL.VNew(SQLV.INT)
        IfCondition EqualTo(p, 0) ThenBlock: { ReturnValue(0) }
        WRMEM_64(p, 8, i)
        ReturnValue(p)
    }
}

Function.SQL.Real {
    Input: r: Integer
    Output: Address
    Body: {
        p = SQL.VNew(SQLV.REAL)
        IfCondition EqualTo(p, 0) ThenBlock: { ReturnValue(0) }
        WRMEM_64(p, 8, r)
        ReturnValue(p)
    }
}

Function.SQL.Text {
    Input: s: Address
    Output: Address
    Body: {
        p = SQL.VNew(SQLV.TEXT)
        IfCondition EqualTo(p, 0) ThenBlock: { ReturnValue(0) }
        WRMEM_64(p, 16, s)
        WRMEM_64(p, 8, StringLength(s))
        ReturnValue(p)
    }
}

Function.SQL.IntH {
    Input: i: Integer
    Output: Address
    Body: {
        p = SQL.VHeap(SQLV.INT)
        WRMEM_64(p, 8, i)
        ReturnValue(p)
    }
}

Function.SQL.RealH {
    Input: r: Integer
    Output: Address
    Body: {
        p = SQL.VHeap(SQLV.REAL)
        WRMEM_64(p, 8, r)
        ReturnValue(p)
    }
}

Function.SQL.TextH {
    Input: s: Address
    Output: Address
    Body: {
        p = SQL.VHeap(SQLV.TEXT)
        h = SQL.HeapStr(s)
        WRMEM_64(p, 16, h)
        WRMEM_64(p, 8, StringLength(h))
        ReturnValue(p)
    }
}

Function.SQL.Blob {
    Input: s: Address
    Input: n: Integer
    Output: Address
    Body: {
        p = SQL.VNew(SQLV.BLOB)
        IfCondition EqualTo(p, 0) ThenBlock: { ReturnValue(0) }
        WRMEM_64(p, 8, n)
        WRMEM_64(p, 16, s)
        ReturnValue(p)
    }
}

Function.SQL.BlobH {
    Input: s: Address
    Input: n: Integer
    Output: Address
    Body: {
        p = SQL.VHeap(SQLV.BLOB)
        h = Allocate(Add(n, 1))
        MemorySet(h, 0, Add(n, 1))
        i = 0
        WhileLoop LessThan(i, n) {
            WRMEM_8(h, i, RDMEM_8(s, i))
            i = Add(i, 1)
        }
        WRMEM_64(p, 8, n)
        WRMEM_64(p, 16, h)
        ReturnValue(p)
    }
}

Function.SQL.IsNull {
    Input: v: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(v, 0) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(SQL.VTag(v), SQLV.NULL) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

Function.SQL.FromInt {
    Input: i: Integer
    Output: Integer
    Body: { ReturnValue(Float_FromInt(i)) }
}

Function.SQL.TextToInt {
    Input: s: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(s, 0) ThenBlock: { ReturnValue(0) }
        i = 0
        sign = 1
        c = RDMEM_8(s, 0)
        IfCondition EqualTo(c, 45) ThenBlock: {
            sign = -1
            i = 1
        } ElseBlock: {
            IfCondition EqualTo(c, 43) ThenBlock: { i = 1 }
        }
        n = 0
        any = 0
        WhileLoop 1 {
            c = RDMEM_8(s, i)
            IfCondition Or(LessThan(c, 48), GreaterThan(c, 57)) ThenBlock: {
                IfCondition EqualTo(any, 0) ThenBlock: { ReturnValue(0) }
                ReturnValue(Multiply(sign, n))
            }
            any = 1
            n = Add(Multiply(n, 10), Subtract(c, 48))
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

Function.SQL.TextToReal {
    Input: s: Address
    Output: Integer
    Body: {
        ReturnValue(SQL.ParseReal(s))
    }
}

Function.SQL.Pow10 {
    Input: e: Integer
    Output: Integer
    Body: {
        n = e
        IfCondition LessThan(n, 0) ThenBlock: { n = Negate(n) }
        IfCondition GreaterThan(n, 350) ThenBlock: { n = 350 }
        r = Float_FromInt(1)
        i = 0
        WhileLoop LessThan(i, n) {
            r = Float_Mul(r, Float_FromInt(10))
            i = Add(i, 1)
        }
        back = Add(r, 0)
        ReturnValue(back)
    }
}

// Decimal spellings, including a leading dot and an e/E exponent.
// Underscores are digit separators. The result is an f64 bit pattern.
Function.SQL.ParseReal {
    Input: s: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(s, 0) ThenBlock: { ReturnValue(Float_FromInt(0)) }
        i = 0
        sign = 1
        c = RDMEM_8(s, i)
        IfCondition EqualTo(c, 45) ThenBlock: {
            sign = -1
            i = 1
        } ElseBlock: {
            IfCondition EqualTo(c, 43) ThenBlock: { i = 1 }
        }
        acc = Float_FromInt(0)
        frac = 0
        any = 0
        sawdot = 0
        stop = 0
        WhileLoop EqualTo(stop, 0) {
            c = RDMEM_8(s, i)
            IfCondition EqualTo(c, 95) ThenBlock: {
                i = Add(i, 1)
            } ElseBlock: {
                IfCondition And(GreaterEqual(c, 48), LessEqual(c, 57)) ThenBlock: {
                    any = 1
                    d = Subtract(c, 48)
                    acc = Float_Add(Float_Mul(acc, Float_FromInt(10)), Float_FromInt(d))
                    IfCondition EqualTo(sawdot, 1) ThenBlock: { frac = Add(frac, 1) }
                    i = Add(i, 1)
                } ElseBlock: {
                    IfCondition And(EqualTo(c, 46), EqualTo(sawdot, 0)) ThenBlock: {
                        sawdot = 1
                        i = Add(i, 1)
                    } ElseBlock: {
                        stop = 1
                    }
                }
            }
        }
        IfCondition EqualTo(any, 0) ThenBlock: { ReturnValue(Float_FromInt(0)) }
        IfCondition GreaterThan(frac, 0) ThenBlock: {
            acc = Float_Div(acc, SQL.Pow10(frac))
        }
        c = RDMEM_8(s, i)
        IfCondition Or(EqualTo(c, 101), EqualTo(c, 69)) ThenBlock: {
            j = Add(i, 1)
            esign = 1
            c2 = RDMEM_8(s, j)
            IfCondition EqualTo(c2, 45) ThenBlock: {
                esign = -1
                j = Add(j, 1)
            } ElseBlock: {
                IfCondition EqualTo(c2, 43) ThenBlock: { j = Add(j, 1) }
            }
            exp = 0
            eany = 0
            estop = 0
            WhileLoop EqualTo(estop, 0) {
                c3 = RDMEM_8(s, j)
                IfCondition EqualTo(c3, 95) ThenBlock: {
                    j = Add(j, 1)
                } ElseBlock: {
                    IfCondition And(GreaterEqual(c3, 48), LessEqual(c3, 57)) ThenBlock: {
                        eany = 1
                        exp = Add(Multiply(exp, 10), Subtract(c3, 48))
                        IfCondition GreaterThan(exp, 400) ThenBlock: { exp = 400 }
                        j = Add(j, 1)
                    } ElseBlock: {
                        estop = 1
                    }
                }
            }
            IfCondition EqualTo(eany, 1) ThenBlock: {
                p10 = SQL.Pow10(exp)
                IfCondition EqualTo(esign, 1) ThenBlock: {
                    acc = Float_Mul(acc, p10)
                } ElseBlock: {
                    acc = Float_Div(acc, p10)
                }
            }
        }
        IfCondition EqualTo(sign, -1) ThenBlock: { acc = Float_Neg(acc) }
        back = Add(acc, 0)
        ReturnValue(back)
    }
}

Function.SQL.AsInt {
    Input: v: Address
    Output: Integer
    Body: {
        t = SQL.VTag(v)
        IfCondition EqualTo(t, SQLV.INT) ThenBlock: { ReturnValue(SQL.VBits(v)) }
        IfCondition EqualTo(t, SQLV.REAL) ThenBlock: { ReturnValue(Float_ToInt(SQL.VBits(v))) }
        IfCondition EqualTo(t, SQLV.TEXT) ThenBlock: { ReturnValue(SQL.TextToInt(SQL.VTxt(v))) }
        ReturnValue(0)
    }
}

Function.SQL.AsReal {
    Input: v: Address
    Output: Integer
    Body: {
        t = SQL.VTag(v)
        IfCondition EqualTo(t, SQLV.REAL) ThenBlock: { ReturnValue(SQL.VBits(v)) }
        IfCondition EqualTo(t, SQLV.INT) ThenBlock: { ReturnValue(Float_FromInt(SQL.VBits(v))) }
        IfCondition EqualTo(t, SQLV.TEXT) ThenBlock: { ReturnValue(SQL.ParseReal(SQL.VTxt(v))) }
        ReturnValue(Float_FromInt(0))
    }
}

Function.SQL.IsZero {
    Input: v: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(SQL.IsNull(v), 1) ThenBlock: { ReturnValue(1) }
        t = SQL.VTag(v)
        IfCondition EqualTo(t, SQLV.INT) ThenBlock: {
            IfCondition EqualTo(SQL.VBits(v), 0) ThenBlock: { ReturnValue(1) }
            ReturnValue(0)
        }
        IfCondition EqualTo(t, SQLV.REAL) ThenBlock: {
            IfCondition EqualTo(Float_Eq(SQL.VBits(v), Float_FromInt(0)), 1) ThenBlock: { ReturnValue(1) }
            ReturnValue(0)
        }
        IfCondition EqualTo(SQL.TextToInt(SQL.VTxt(v)), 0) ThenBlock: {
            IfCondition EqualTo(Float_Eq(SQL.ParseReal(SQL.VTxt(v)), Float_FromInt(0)), 1) ThenBlock: { ReturnValue(1) }
        }
        ReturnValue(0)
    }
}

Function.SQL.Truth {
    Input: v: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(SQL.IsNull(v), 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(SQL.IsZero(v), 1) ThenBlock: { ReturnValue(0) }
        ReturnValue(1)
    }
}

Function.SQL.Class {
    Input: v: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(SQL.IsNull(v), 1) ThenBlock: { ReturnValue(2) }
        IfCondition EqualTo(SQL.Truth(v), 1) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

Function.SQL.Not {
    Input: v: Address
    Output: Address
    Body: {
        c = SQL.Class(v)
        IfCondition EqualTo(c, 2) ThenBlock: { ReturnValue(SQL.Null()) }
        IfCondition EqualTo(c, 1) ThenBlock: { ReturnValue(SQL.Int(0)) }
        ReturnValue(SQL.Int(1))
    }
}

Function.SQL.And {
    Input: x: Address
    Input: y: Address
    Output: Address
    Body: {
        cx = SQL.Class(x)
        cy = SQL.Class(y)
        IfCondition EqualTo(cx, 0) ThenBlock: { ReturnValue(SQL.Int(0)) }
        IfCondition EqualTo(cy, 0) ThenBlock: { ReturnValue(SQL.Int(0)) }
        IfCondition Or(EqualTo(cx, 2), EqualTo(cy, 2)) ThenBlock: { ReturnValue(SQL.Null()) }
        ReturnValue(SQL.Int(1))
    }
}

Function.SQL.Or {
    Input: x: Address
    Input: y: Address
    Output: Address
    Body: {
        cx = SQL.Class(x)
        cy = SQL.Class(y)
        IfCondition EqualTo(cx, 1) ThenBlock: { ReturnValue(SQL.Int(1)) }
        IfCondition EqualTo(cy, 1) ThenBlock: { ReturnValue(SQL.Int(1)) }
        IfCondition Or(EqualTo(cx, 2), EqualTo(cy, 2)) ThenBlock: { ReturnValue(SQL.Null()) }
        ReturnValue(SQL.Int(0))
    }
}

Function.SQL.Neg {
    Input: v: Address
    Output: Address
    Body: {
        IfCondition EqualTo(SQL.IsNull(v), 1) ThenBlock: { ReturnValue(SQL.Null()) }
        t = SQL.VTag(v)
        IfCondition EqualTo(t, SQLV.REAL) ThenBlock: { ReturnValue(SQL.Real(Float_Neg(SQL.VBits(v)))) }
        IfCondition EqualTo(t, SQLV.BLOB) ThenBlock: { ReturnValue(SQL.Int(0)) }
        IfCondition EqualTo(t, SQLV.TEXT) ThenBlock: {
            IfCondition EqualTo(SQL.LooksReal(SQL.VTxt(v)), 1) ThenBlock: {
                ReturnValue(SQL.Real(Float_Neg(SQL.ParseReal(SQL.VTxt(v)))))
            }
            ReturnValue(SQL.Int(Negate(SQL.TextToInt(SQL.VTxt(v)))))
        }
        ReturnValue(SQL.Int(Negate(SQL.VBits(v))))
    }
}

Function.SQL.Plus {
    Input: v: Address
    Output: Address
    Body: {
        IfCondition EqualTo(SQL.IsNull(v), 1) ThenBlock: { ReturnValue(SQL.Null()) }
        t = SQL.VTag(v)
        IfCondition EqualTo(t, SQLV.BLOB) ThenBlock: { ReturnValue(SQL.Int(0)) }
        IfCondition EqualTo(t, SQLV.TEXT) ThenBlock: {
            IfCondition EqualTo(SQL.LooksReal(SQL.VTxt(v)), 1) ThenBlock: {
                ReturnValue(SQL.Real(SQL.ParseReal(SQL.VTxt(v))))
            }
            ReturnValue(SQL.Int(SQL.TextToInt(SQL.VTxt(v))))
        }
        ReturnValue(v)
    }
}

Function.SQL.LooksReal {
    Input: s: Address
    Output: Integer
    Body: {
        n = StringLength(s)
        i = 0
        dot = 0
        exp = 0
        WhileLoop LessThan(i, n) {
            c = RDMEM_8(s, i)
            IfCondition EqualTo(c, 46) ThenBlock: { dot = 1 }
            IfCondition Or(EqualTo(c, 101), EqualTo(c, 69)) ThenBlock: { exp = 1 }
            i = Add(i, 1)
        }
        IfCondition Or(EqualTo(dot, 1), EqualTo(exp, 1)) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

Function.SQL.AddOverflow {
    Input: a: Integer
    Input: b: Integer
    Input: s: Integer
    Output: Integer
    Body: {
        sa = 0
        sb = 0
        ss = 0
        IfCondition GreaterEqual(a, 0) ThenBlock: { sa = 1 }
        IfCondition GreaterEqual(b, 0) ThenBlock: { sb = 1 }
        IfCondition GreaterEqual(s, 0) ThenBlock: { ss = 1 }
        IfCondition And(EqualTo(sa, sb), NotEqual(sa, ss)) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

Function.SQL.Add {
    Input: x: Address
    Input: y: Address
    Output: Address
    Body: {
        IfCondition Or(EqualTo(SQL.IsNull(x), 1), EqualTo(SQL.IsNull(y), 1)) ThenBlock: { ReturnValue(SQL.Null()) }
        tx = SQL.VTag(x)
        ty = SQL.VTag(y)
        IfCondition Or(EqualTo(tx, SQLV.REAL), EqualTo(ty, SQLV.REAL)) ThenBlock: {
            ReturnValue(SQL.Real(Float_Add(SQL.AsReal(x), SQL.AsReal(y))))
        }
        IfCondition Or(EqualTo(tx, SQLV.TEXT), EqualTo(ty, SQLV.TEXT)) ThenBlock: {
            IfCondition Or(EqualTo(SQL.LooksReal(SQL.VTxt(x)), 1), EqualTo(SQL.LooksReal(SQL.VTxt(y)), 1)) ThenBlock: {
                ReturnValue(SQL.Real(Float_Add(SQL.AsReal(x), SQL.AsReal(y))))
            }
        }
        a = SQL.AsInt(x)
        b = SQL.AsInt(y)
        s = Add(a, b)
        IfCondition EqualTo(SQL.AddOverflow(a, b, s), 1) ThenBlock: {
            ReturnValue(SQL.Real(Float_Add(Float_FromInt(a), Float_FromInt(b))))
        }
        ReturnValue(SQL.Int(s))
    }
}

Function.SQL.Sub {
    Input: x: Address
    Input: y: Address
    Output: Address
    Body: {
        ReturnValue(SQL.Add(x, SQL.Neg(y)))
    }
}

Function.SQL.Mul {
    Input: x: Address
    Input: y: Address
    Output: Address
    Body: {
        IfCondition Or(EqualTo(SQL.IsNull(x), 1), EqualTo(SQL.IsNull(y), 1)) ThenBlock: { ReturnValue(SQL.Null()) }
        tx = SQL.VTag(x)
        ty = SQL.VTag(y)
        IfCondition Or(EqualTo(tx, SQLV.REAL), EqualTo(ty, SQLV.REAL)) ThenBlock: {
            ReturnValue(SQL.Real(Float_Mul(SQL.AsReal(x), SQL.AsReal(y))))
        }
        a = SQL.AsInt(x)
        b = SQL.AsInt(y)
        IfCondition EqualTo(a, 0) ThenBlock: { ReturnValue(SQL.Int(0)) }
        IfCondition EqualTo(b, 0) ThenBlock: { ReturnValue(SQL.Int(0)) }
        p = Multiply(a, b)
        q = Divide(p, b)
        IfCondition NotEqual(q, a) ThenBlock: {
            ReturnValue(SQL.Real(Float_Mul(Float_FromInt(a), Float_FromInt(b))))
        }
        ReturnValue(SQL.Int(p))
    }
}

Function.SQL.Div {
    Input: x: Address
    Input: y: Address
    Output: Address
    Body: {
        IfCondition Or(EqualTo(SQL.IsNull(x), 1), EqualTo(SQL.IsNull(y), 1)) ThenBlock: { ReturnValue(SQL.Null()) }
        IfCondition EqualTo(SQL.IsZero(y), 1) ThenBlock: { ReturnValue(SQL.Null()) }
        tx = SQL.VTag(x)
        ty = SQL.VTag(y)
        IfCondition And(NotEqual(tx, SQLV.REAL), NotEqual(ty, SQLV.REAL)) ThenBlock: {
            IfCondition And(NotEqual(tx, SQLV.TEXT), NotEqual(ty, SQLV.TEXT)) ThenBlock: {
                ReturnValue(SQL.Int(Divide(SQL.AsInt(x), SQL.AsInt(y))))
            }
            IfCondition And(EqualTo(SQL.LooksReal(SQL.VTxt(x)), 0), EqualTo(SQL.LooksReal(SQL.VTxt(y)), 0)) ThenBlock: {
                ReturnValue(SQL.Int(Divide(SQL.AsInt(x), SQL.AsInt(y))))
            }
        }
        ReturnValue(SQL.Real(Float_Div(SQL.AsReal(x), SQL.AsReal(y))))
    }
}

Function.SQL.Mod {
    Input: x: Address
    Input: y: Address
    Output: Address
    Body: {
        IfCondition Or(EqualTo(SQL.IsNull(x), 1), EqualTo(SQL.IsNull(y), 1)) ThenBlock: { ReturnValue(SQL.Null()) }
        IfCondition EqualTo(SQL.IsZero(y), 1) ThenBlock: { ReturnValue(SQL.Null()) }
        ReturnValue(SQL.Int(Modulo(SQL.AsInt(x), SQL.AsInt(y))))
    }
}

Function.SQL.Shl {
    Input: x: Address
    Input: y: Address
    Output: Address
    Body: {
        IfCondition Or(EqualTo(SQL.IsNull(x), 1), EqualTo(SQL.IsNull(y), 1)) ThenBlock: { ReturnValue(SQL.Null()) }
        a = SQL.AsInt(x)
        b = SQL.AsInt(y)
        IfCondition EqualTo(b, 0) ThenBlock: { ReturnValue(SQL.Int(a)) }
        IfCondition LessThan(b, 0) ThenBlock: { ReturnValue(SQL.Shr(x, SQL.Int(Negate(b)))) }
        IfCondition GreaterEqual(b, 64) ThenBlock: { ReturnValue(SQL.Int(0)) }
        ReturnValue(SQL.Int(LeftShift(a, b)))
    }
}

Function.SQL.Shr {
    Input: x: Address
    Input: y: Address
    Output: Address
    Body: {
        IfCondition Or(EqualTo(SQL.IsNull(x), 1), EqualTo(SQL.IsNull(y), 1)) ThenBlock: { ReturnValue(SQL.Null()) }
        a = SQL.AsInt(x)
        b = SQL.AsInt(y)
        IfCondition EqualTo(b, 0) ThenBlock: { ReturnValue(SQL.Int(a)) }
        IfCondition LessThan(b, 0) ThenBlock: { ReturnValue(SQL.Shl(x, SQL.Int(Negate(b)))) }
        IfCondition GreaterEqual(b, 64) ThenBlock: {
            IfCondition LessThan(a, 0) ThenBlock: { ReturnValue(SQL.Int(-1)) }
            ReturnValue(SQL.Int(0))
        }
        u = a
        IfCondition LessThan(a, 0) ThenBlock: {
            u = BitwiseOr(RightShift(BitwiseAnd(a, 9223372036854775807), b), LeftShift(1, Subtract(63, b)))
            ReturnValue(SQL.Int(u))
        }
        ReturnValue(SQL.Int(RightShift(a, b)))
    }
}

Function.SQL.Band {
    Input: x: Address
    Input: y: Address
    Output: Address
    Body: {
        IfCondition Or(EqualTo(SQL.IsNull(x), 1), EqualTo(SQL.IsNull(y), 1)) ThenBlock: { ReturnValue(SQL.Null()) }
        ReturnValue(SQL.Int(BitwiseAnd(SQL.AsInt(x), SQL.AsInt(y))))
    }
}

Function.SQL.Bor {
    Input: x: Address
    Input: y: Address
    Output: Address
    Body: {
        IfCondition Or(EqualTo(SQL.IsNull(x), 1), EqualTo(SQL.IsNull(y), 1)) ThenBlock: { ReturnValue(SQL.Null()) }
        ReturnValue(SQL.Int(BitwiseOr(SQL.AsInt(x), SQL.AsInt(y))))
    }
}

Function.SQL.BNot {
    Input: v: Address
    Output: Address
    Body: {
        IfCondition EqualTo(SQL.IsNull(v), 1) ThenBlock: { ReturnValue(SQL.Null()) }
        ReturnValue(SQL.Int(BitwiseNot(SQL.AsInt(v))))
    }
}

Function.SQL.NumCmp {
    Input: x: Address
    Input: y: Address
    Output: Integer
    Body: {
        rx = SQL.AsReal(x)
        ry = SQL.AsReal(y)
        IfCondition EqualTo(Float_Lt(rx, ry), 1) ThenBlock: { ReturnValue(-1) }
        IfCondition EqualTo(Float_Gt(rx, ry), 1) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

Function.SQL.BothNum {
    Input: v: Address
    Output: Integer
    Body: {
        t = SQL.VTag(v)
        IfCondition Or(EqualTo(t, SQLV.INT), EqualTo(t, SQLV.REAL)) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

Function.SQL.MemCmp {
    Input: a: Address
    Input: na: Integer
    Input: b: Address
    Input: nb: Integer
    Output: Integer
    Body: {
        n = na
        IfCondition LessThan(nb, n) ThenBlock: { n = nb }
        i = 0
        WhileLoop LessThan(i, n) {
            ca = BitwiseAnd(RDMEM_8(a, i), 255)
            cb = BitwiseAnd(RDMEM_8(b, i), 255)
            IfCondition LessThan(ca, cb) ThenBlock: { ReturnValue(-1) }
            IfCondition GreaterThan(ca, cb) ThenBlock: { ReturnValue(1) }
            i = Add(i, 1)
        }
        IfCondition LessThan(na, nb) ThenBlock: { ReturnValue(-1) }
        IfCondition GreaterThan(na, nb) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

// NULL < number < text < blob. A blob equals only the same bytes.
Function.SQL.Cmp3 {
    Input: x: Address
    Input: y: Address
    Output: Integer
    Body: {
        IfCondition Or(EqualTo(SQL.IsNull(x), 1), EqualTo(SQL.IsNull(y), 1)) ThenBlock: { ReturnValue(-2) }
        tx = SQL.VTag(x)
        ty = SQL.VTag(y)
        IfCondition And(EqualTo(SQL.BothNum(x), 1), EqualTo(SQL.BothNum(y), 1)) ThenBlock: {
            ReturnValue(SQL.NumCmp(x, y))
        }
        IfCondition And(EqualTo(tx, SQLV.TEXT), EqualTo(ty, SQLV.TEXT)) ThenBlock: {
            c = StringCompare(SQL.VTxt(x), SQL.VTxt(y))
            IfCondition LessThan(c, 0) ThenBlock: { ReturnValue(-1) }
            IfCondition GreaterThan(c, 0) ThenBlock: { ReturnValue(1) }
            ReturnValue(0)
        }
        IfCondition And(EqualTo(tx, SQLV.BLOB), EqualTo(ty, SQLV.BLOB)) ThenBlock: {
            ReturnValue(SQL.MemCmp(SQL.VTxt(x), SQL.VBits(x), SQL.VTxt(y), SQL.VBits(y)))
        }
        IfCondition EqualTo(SQL.BothNum(x), 1) ThenBlock: { ReturnValue(-1) }
        IfCondition EqualTo(SQL.BothNum(y), 1) ThenBlock: { ReturnValue(1) }
        IfCondition And(EqualTo(tx, SQLV.TEXT), EqualTo(ty, SQLV.BLOB)) ThenBlock: { ReturnValue(-1) }
        IfCondition And(EqualTo(tx, SQLV.BLOB), EqualTo(ty, SQLV.TEXT)) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

Function.SQL.CmpVal {
    Input: c: Integer
    Output: Address
    Body: {
        IfCondition EqualTo(c, -2) ThenBlock: { ReturnValue(SQL.Null()) }
        IfCondition EqualTo(c, 0) ThenBlock: { ReturnValue(SQL.Int(1)) }
        ReturnValue(SQL.Int(0))
    }
}

Function.SQL.Eq { Input: x: Address Input: y: Address Output: Address Body: { ReturnValue(SQL.CmpVal(SQL.Cmp3(x, y))) } }

Function.SQL.Ne {
    Input: x: Address
    Input: y: Address
    Output: Address
    Body: {
        c = SQL.Cmp3(x, y)
        IfCondition EqualTo(c, -2) ThenBlock: { ReturnValue(SQL.Null()) }
        IfCondition EqualTo(c, 0) ThenBlock: { ReturnValue(SQL.Int(0)) }
        ReturnValue(SQL.Int(1))
    }
}

Function.SQL.Lt {
    Input: x: Address
    Input: y: Address
    Output: Address
    Body: {
        c = SQL.Cmp3(x, y)
        IfCondition EqualTo(c, -2) ThenBlock: { ReturnValue(SQL.Null()) }
        IfCondition LessThan(c, 0) ThenBlock: { ReturnValue(SQL.Int(1)) }
        ReturnValue(SQL.Int(0))
    }
}

Function.SQL.Gt {
    Input: x: Address
    Input: y: Address
    Output: Address
    Body: {
        c = SQL.Cmp3(x, y)
        IfCondition EqualTo(c, -2) ThenBlock: { ReturnValue(SQL.Null()) }
        IfCondition GreaterThan(c, 0) ThenBlock: { ReturnValue(SQL.Int(1)) }
        ReturnValue(SQL.Int(0))
    }
}

Function.SQL.Le {
    Input: x: Address
    Input: y: Address
    Output: Address
    Body: {
        c = SQL.Cmp3(x, y)
        IfCondition EqualTo(c, -2) ThenBlock: { ReturnValue(SQL.Null()) }
        IfCondition LessEqual(c, 0) ThenBlock: { ReturnValue(SQL.Int(1)) }
        ReturnValue(SQL.Int(0))
    }
}

Function.SQL.Ge {
    Input: x: Address
    Input: y: Address
    Output: Address
    Body: {
        c = SQL.Cmp3(x, y)
        IfCondition EqualTo(c, -2) ThenBlock: { ReturnValue(SQL.Null()) }
        IfCondition GreaterEqual(c, 0) ThenBlock: { ReturnValue(SQL.Int(1)) }
        ReturnValue(SQL.Int(0))
    }
}

Function.SQL.Is {
    Input: x: Address
    Input: y: Address
    Output: Address
    Body: {
        IfCondition And(EqualTo(SQL.IsNull(x), 1), EqualTo(SQL.IsNull(y), 1)) ThenBlock: { ReturnValue(SQL.Int(1)) }
        IfCondition Or(EqualTo(SQL.IsNull(x), 1), EqualTo(SQL.IsNull(y), 1)) ThenBlock: { ReturnValue(SQL.Int(0)) }
        c = SQL.Cmp3(x, y)
        IfCondition EqualTo(c, 0) ThenBlock: { ReturnValue(SQL.Int(1)) }
        ReturnValue(SQL.Int(0))
    }
}

Function.SQL.Abs {
    Input: v: Address
    Output: Address
    Body: {
        IfCondition EqualTo(SQL.IsNull(v), 1) ThenBlock: { ReturnValue(SQL.Null()) }
        t = SQL.VTag(v)
        IfCondition EqualTo(t, SQLV.REAL) ThenBlock: { ReturnValue(SQL.Real(Float_Abs(SQL.VBits(v)))) }
        i = SQL.AsInt(v)
        IfCondition LessThan(i, 0) ThenBlock: { ReturnValue(SQL.Int(Negate(i))) }
        ReturnValue(SQL.Int(i))
    }
}

Function.SQL.IntText {
    Input: i: Integer
    Output: Address
    Body: {
        IfCondition EqualTo(i, 0) ThenBlock: { ReturnValue(SQL.StrZ("0")) }
        neg = 0
        n = i
        IfCondition LessThan(n, 0) ThenBlock: {
            neg = 1
            n = Negate(n)
        }
        buf = SQL.Bump(32)
        k = 31
        WRMEM_8(buf, 31, 0)
        WhileLoop GreaterThan(n, 0) {
            k = Subtract(k, 1)
            d = Modulo(n, 10)
            WRMEM_8(buf, k, Add(48, d))
            n = Divide(n, 10)
        }
        IfCondition EqualTo(neg, 1) ThenBlock: {
            k = Subtract(k, 1)
            WRMEM_8(buf, k, 45)
        }
        ReturnValue(Add(buf, k))
    }
}

Function.SQL.FormatI {
    Input: v: Address
    Output: Address
    Body: {
        IfCondition EqualTo(SQL.IsNull(v), 1) ThenBlock: { ReturnValue(SQL.StrZ("NULL")) }
        i = SQL.AsInt(v)
        lo = BitwiseAnd(i, 4294967295)
        IfCondition GreaterEqual(lo, 2147483648) ThenBlock: {
            lo = Subtract(lo, 4294967296)
        }
        ReturnValue(SQL.IntText(lo))
    }
}

Function.SQL.FormatT {
    Input: v: Address
    Output: Address
    Body: {
        IfCondition EqualTo(SQL.IsNull(v), 1) ThenBlock: { ReturnValue(SQL.StrZ("NULL")) }
        t = SQL.VTag(v)
        IfCondition Or(EqualTo(t, SQLV.TEXT), EqualTo(t, SQLV.BLOB)) ThenBlock: {
            s = SQL.VTxt(v)
            IfCondition EqualTo(StringLength(s), 0) ThenBlock: { ReturnValue(SQL.StrZ("(empty)")) }
            n = StringLength(s)
            p = SQL.Str(s, n)
            i = 0
            WhileLoop LessThan(i, n) {
                c = RDMEM_8(p, i)
                IfCondition Or(LessThan(c, 32), GreaterThan(c, 126)) ThenBlock: {
                    WRMEM_8(p, i, 64)
                }
                i = Add(i, 1)
            }
            ReturnValue(p)
        }
        IfCondition EqualTo(t, SQLV.INT) ThenBlock: { ReturnValue(SQL.IntText(SQL.VBits(v))) }
        ReturnValue(SQL.FormatR(v))
    }
}

Function.SQL.U32Text {
    Input: n: Integer
    Input: width: Integer
    Output: Address
    Body: {
        buf = SQL.Bump(Add(width, 1))
        i = Subtract(width, 1)
        x = n
        WhileLoop GreaterEqual(i, 0) {
            WRMEM_8(buf, i, Add(48, Modulo(x, 10)))
            x = Divide(x, 10)
            i = Subtract(i, 1)
        }
        WRMEM_8(buf, width, 0)
        ReturnValue(buf)
    }
}

Function.SQL.FormatR {
    Input: v: Address
    Output: Address
    Body: {
        IfCondition EqualTo(SQL.IsNull(v), 1) ThenBlock: { ReturnValue(SQL.StrZ("NULL")) }
        r = SQL.AsReal(v)
        neg = 0
        IfCondition EqualTo(Float_Lt(r, Float_FromInt(0)), 1) ThenBlock: {
            neg = 1
            r = Float_Neg(r)
        }
        big = Float_FromInt(1000000000000000)
        IfCondition EqualTo(Float_Ge(r, big), 1) ThenBlock: {
            exp = 0
            lim = Float_FromInt(10000000000000000)
            WhileLoop EqualTo(Float_Ge(r, lim), 1) {
                r = Float_Div(r, Float_FromInt(10))
                exp = Add(exp, 1)
            }
            n = Float_ToInt(Float_Add(r, Float_FromInt(0)))
            // half-up if the fractional part is present: add 0.5 before trunc
            n = Float_ToInt(Float_Add(Float_Add(r, Float_FromInt(0)), Float_Div(Float_FromInt(1), Float_FromInt(2))))
            digs = SQL.IntText(n)
            out = digs
            k = 0
            WhileLoop LessThan(k, exp) {
                out = StringConcat(out, "0")
                k = Add(k, 1)
            }
            out = StringConcat(out, ".000")
            IfCondition EqualTo(neg, 1) ThenBlock: { out = StringConcat("-", out) }
            ReturnValue(out)
        }
        scaled = Float_Add(Float_Mul(r, Float_FromInt(1000)), Float_Div(Float_FromInt(1), Float_FromInt(2)))
        ip = Float_ToInt(scaled)
        whole = Divide(ip, 1000)
        frac = Modulo(ip, 1000)
        ws = SQL.IntText(whole)
        fs = SQL.U32Text(frac, 3)
        out = StringConcat(StringConcat(ws, "."), fs)
        IfCondition EqualTo(neg, 1) ThenBlock: { out = StringConcat("-", out) }
        ReturnValue(out)
    }
}

Function.SQL.FormatAs {
    Input: v: Address
    Input: tc: Integer
    Output: Address
    Body: {
        IfCondition EqualTo(SQL.IsNull(v), 1) ThenBlock: { ReturnValue(SQL.StrZ("NULL")) }
        IfCondition EqualTo(tc, 73) ThenBlock: { ReturnValue(SQL.FormatI(v)) }
        IfCondition EqualTo(tc, 82) ThenBlock: { ReturnValue(SQL.FormatR(v)) }
        ReturnValue(SQL.FormatT(v))
    }
}

Function.SQL.Canon {
    Input: v: Address
    Output: Address
    Body: {
        IfCondition EqualTo(SQL.IsNull(v), 1) ThenBlock: { ReturnValue(SQL.StrZ("N")) }
        t = SQL.VTag(v)
        IfCondition EqualTo(t, SQLV.TEXT) ThenBlock: {
            ReturnValue(StringConcat("T", SQL.VTxt(v)))
        }
        IfCondition EqualTo(t, SQLV.BLOB) ThenBlock: { ReturnValue(SQL.BlobKey(v)) }
        r = SQL.AsReal(v)
        iv = Float_ToInt(r)
        IfCondition EqualTo(Float_Eq(r, Float_FromInt(iv)), 1) ThenBlock: {
            ReturnValue(StringConcat("I", SQL.IntText(iv)))
        }
        ReturnValue(StringConcat("R", SQL.FormatR(v)))
    }
}

Function.SQL.ApplyAff {
    Input: v: Address
    Input: aff: Integer
    Output: Address
    Body: {
        IfCondition EqualTo(SQL.IsNull(v), 1) ThenBlock: { ReturnValue(v) }
        IfCondition EqualTo(SQL.VTag(v), SQLV.BLOB) ThenBlock: { ReturnValue(v) }
        IfCondition EqualTo(aff, SQLA.NONE) ThenBlock: { ReturnValue(v) }
        IfCondition EqualTo(aff, SQLA.TEXT) ThenBlock: {
            IfCondition EqualTo(SQL.VTag(v), SQLV.TEXT) ThenBlock: { ReturnValue(v) }
            IfCondition EqualTo(SQL.VTag(v), SQLV.INT) ThenBlock: { ReturnValue(SQL.Text(SQL.IntText(SQL.VBits(v)))) }
            ReturnValue(SQL.Text(SQL.FormatR(v)))
        }
        IfCondition EqualTo(aff, SQLA.REAL) ThenBlock: {
            ReturnValue(SQL.Real(SQL.AsReal(v)))
        }
        // INTEGER and NUMERIC: lossless int stays int, otherwise real if numeric
        t = SQL.VTag(v)
        IfCondition EqualTo(t, SQLV.INT) ThenBlock: { ReturnValue(v) }
        IfCondition EqualTo(t, SQLV.REAL) ThenBlock: {
            r = SQL.VBits(v)
            iv = Float_ToInt(r)
            IfCondition EqualTo(Float_Eq(r, Float_FromInt(iv)), 1) ThenBlock: { ReturnValue(SQL.Int(iv)) }
            ReturnValue(v)
        }
        s = SQL.VTxt(v)
        IfCondition EqualTo(SQL.LooksReal(s), 1) ThenBlock: {
            r2 = SQL.ParseReal(s)
            iv2 = Float_ToInt(r2)
            IfCondition EqualTo(Float_Eq(r2, Float_FromInt(iv2)), 1) ThenBlock: { ReturnValue(SQL.Int(iv2)) }
            ReturnValue(SQL.Real(r2))
        }
        IfCondition GreaterThan(StringLength(s), 0) ThenBlock: {
            c0 = RDMEM_8(s, 0)
            IfCondition Or(And(GreaterEqual(c0, 48), LessEqual(c0, 57)), Or(EqualTo(c0, 45), EqualTo(c0, 43))) ThenBlock: {
                ReturnValue(SQL.Int(SQL.TextToInt(s)))
            }
        }
        ReturnValue(v)
    }
}

// Canon key for a blob. Hex keeps an embedded 0 from truncating a hash key.
Function.SQL.BlobKey {
    Input: v: Address
    Output: Address
    Body: {
        s = SQL.VTxt(v)
        n = SQL.VBits(v)
        buf = SQL.Bump(Add(Multiply(n, 2), 2))
        IfCondition EqualTo(buf, 0) ThenBlock: { ReturnValue(SQL.StrZ("B")) }
        WRMEM_8(buf, 0, 66)
        i = 0
        WhileLoop LessThan(i, n) {
            b = BitwiseAnd(RDMEM_8(s, i), 255)
            hi = RightShift(b, 4)
            lo = BitwiseAnd(b, 15)
            hc = Add(hi, 48)
            IfCondition GreaterThan(hi, 9) ThenBlock: { hc = Add(hi, 87) }
            lc = Add(lo, 48)
            IfCondition GreaterThan(lo, 9) ThenBlock: { lc = Add(lo, 87) }
            WRMEM_8(buf, Add(Multiply(i, 2), 1), hc)
            WRMEM_8(buf, Add(Multiply(i, 2), 2), lc)
            i = Add(i, 1)
        }
        WRMEM_8(buf, Add(Multiply(n, 2), 1), 0)
        ReturnValue(buf)
    }
}

Function.SQL.IsSpace {
    Input: c: Integer
    Output: Integer
    Body: {
        IfCondition Or(EqualTo(c, 32), Or(EqualTo(c, 9), Or(EqualTo(c, 10), Or(EqualTo(c, 13), Or(EqualTo(c, 11), EqualTo(c, 12)))))) ThenBlock: {
            ReturnValue(1)
        }
        ReturnValue(0)
    }
}

// MustBeInt after numeric affinity. NULL, a non-integral real, and junk text
// are datatype mismatch. Integral reals inside the exact float range pass.
Function.SQL.RealLim {
    Input: r: Integer
    Output: Integer
    Body: {
        iv = Float_ToInt(r)
        edge = LeftShift(1, 63)
        IfCondition Or(EqualTo(iv, edge), EqualTo(iv, BitwiseNot(edge))) ThenBlock: {
            SQL.Fail("datatype mismatch")
            ReturnValue(0)
        }
        IfCondition EqualTo(Float_Eq(r, Float_FromInt(iv)), 1) ThenBlock: { ReturnValue(iv) }
        SQL.Fail("datatype mismatch")
        ReturnValue(0)
    }
}

Function.SQL.TextLim {
    Input: s: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(s, 0) ThenBlock: {
            SQL.Fail("datatype mismatch")
            ReturnValue(0)
        }
        nlen = StringLength(s)
        i = 0
        WhileLoop LessThan(i, nlen) {
            c = RDMEM_8(s, i)
            IfCondition EqualTo(SQL.IsSpace(c), 0) ThenBlock: { BreakLoop }
            i = Add(i, 1)
        }
        IfCondition GreaterEqual(i, nlen) ThenBlock: {
            SQL.Fail("datatype mismatch")
            ReturnValue(0)
        }
        sign = 1
        c0 = RDMEM_8(s, i)
        IfCondition EqualTo(c0, 45) ThenBlock: {
            sign = -1
            i = Add(i, 1)
        } ElseBlock: {
            IfCondition EqualTo(c0, 43) ThenBlock: { i = Add(i, 1) }
        }
        IfCondition GreaterEqual(i, nlen) ThenBlock: {
            SQL.Fail("datatype mismatch")
            ReturnValue(0)
        }
        whole = 0
        nz = 0
        dot = 0
        any = 0
        bad = 0
        cap = 922337203685477580
        limn = LeftShift(1, 63)
        WhileLoop LessThan(i, nlen) {
            c1 = RDMEM_8(s, i)
            IfCondition And(GreaterEqual(c1, 48), LessEqual(c1, 57)) ThenBlock: {
                d = Subtract(c1, 48)
                any = 1
                IfCondition EqualTo(dot, 0) ThenBlock: {
                    IfCondition EqualTo(whole, limn) ThenBlock: { bad = 1 }
                    IfCondition GreaterThan(whole, cap) ThenBlock: { bad = 1 }
                    IfCondition And(EqualTo(whole, cap), GreaterThan(d, 7)) ThenBlock: {
                        IfCondition And(EqualTo(sign, -1), EqualTo(d, 8)) ThenBlock: {
                            whole = limn
                        } ElseBlock: {
                            bad = 1
                        }
                    }
                    IfCondition EqualTo(bad, 0) ThenBlock: {
                        IfCondition NotEqual(whole, limn) ThenBlock: {
                            whole = Add(Multiply(whole, 10), d)
                        }
                    }
                } ElseBlock: {
                    IfCondition NotEqual(d, 0) ThenBlock: { nz = 1 }
                }
                i = Add(i, 1)
            } ElseBlock: {
                IfCondition And(EqualTo(c1, 46), EqualTo(dot, 0)) ThenBlock: {
                    dot = 1
                    i = Add(i, 1)
                } ElseBlock: {
                    BreakLoop
                }
            }
        }
        WhileLoop LessThan(i, nlen) {
            c2 = RDMEM_8(s, i)
            IfCondition EqualTo(SQL.IsSpace(c2), 0) ThenBlock: { bad = 1 }
            i = Add(i, 1)
        }
        IfCondition Or(EqualTo(any, 0), EqualTo(bad, 1)) ThenBlock: {
            SQL.Fail("datatype mismatch")
            ReturnValue(0)
        }
        IfCondition EqualTo(dot, 1) ThenBlock: {
            huge = LeftShift(1, 53)
            IfCondition Or(EqualTo(nz, 1), Or(EqualTo(whole, limn), GreaterThan(whole, huge))) ThenBlock: {
                SQL.Fail("datatype mismatch")
                ReturnValue(0)
            }
        }
        IfCondition EqualTo(whole, limn) ThenBlock: { ReturnValue(whole) }
        IfCondition EqualTo(sign, -1) ThenBlock: {
            neg = Negate(whole)
            ReturnValue(neg)
        }
        back = Add(whole, 0)
        ReturnValue(back)
    }
}

Function.SQL.MustInt {
    Input: v: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(SQL.IsNull(v), 1) ThenBlock: {
            SQL.Fail("datatype mismatch")
            ReturnValue(0)
        }
        t = SQL.VTag(v)
        IfCondition EqualTo(t, SQLV.INT) ThenBlock: { ReturnValue(SQL.VBits(v)) }
        IfCondition EqualTo(t, SQLV.REAL) ThenBlock: { ReturnValue(SQL.RealLim(SQL.VBits(v))) }
        IfCondition EqualTo(t, SQLV.TEXT) ThenBlock: { ReturnValue(SQL.TextLim(SQL.VTxt(v))) }
        SQL.Fail("datatype mismatch")
        ReturnValue(0)
    }
}
