LibraryImport.Arena
LibraryImport.Ecu.ECU_Sys
LibraryImport.Xml.XML
LibraryImport.Scan.Scan_IR

Function.Scan_Adx.ParseHex {
    Input: s: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(s, 0) ThenBlock: { ReturnValue(0) }
        i = 0
        IfCondition EqualTo(GetByte(s, 0), 48) ThenBlock: {
            IfCondition EqualTo(GetByte(s, 1), 120) ThenBlock: { i = 2 }
            IfCondition EqualTo(GetByte(s, 1), 88) ThenBlock: { i = 2 }
        }
        v = 0
        more = 1
        WhileLoop EqualTo(more, 1) {
            c = GetByte(s, i)
            d = -1
            IfCondition GreaterEqual(c, 48) ThenBlock: {
                IfCondition LessEqual(c, 57) ThenBlock: { d = Subtract(c, 48) }
            }
            IfCondition GreaterEqual(c, 65) ThenBlock: {
                IfCondition LessEqual(c, 70) ThenBlock: { d = Subtract(c, 55) }
            }
            IfCondition GreaterEqual(c, 97) ThenBlock: {
                IfCondition LessEqual(c, 102) ThenBlock: { d = Subtract(c, 87) }
            }
            IfCondition LessThan(d, 0) ThenBlock: { more = 0 }
            IfCondition GreaterEqual(d, 0) ThenBlock: {
                v = Add(Multiply(v, 16), d)
                i = Add(i, 1)
            }
        }
        ReturnValue(v)
    }
}

Function.Scan_Adx.ParseDec {
    Input: s: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(s, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(GetByte(s, 0), 48) ThenBlock: {
            IfCondition EqualTo(GetByte(s, 1), 120) ThenBlock: { ReturnValue(Scan_Adx.ParseHex(s)) }
            IfCondition EqualTo(GetByte(s, 1), 88) ThenBlock: { ReturnValue(Scan_Adx.ParseHex(s)) }
        }
        v = 0
        i = 0
        more = 1
        WhileLoop EqualTo(more, 1) {
            c = GetByte(s, i)
            IfCondition LessThan(c, 48) ThenBlock: { more = 0 }
            IfCondition GreaterThan(c, 57) ThenBlock: { more = 0 }
            IfCondition EqualTo(more, 1) ThenBlock: {
                v = Add(Multiply(v, 10), Subtract(c, 48))
                i = Add(i, 1)
            }
        }
        ReturnValue(v)
    }
}

Function.Scan_Adx.ParseFloat {
    Input: s: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(s, 0) ThenBlock: { ReturnValue(0) }
        i = 0
        sign = 1
        IfCondition EqualTo(GetByte(s, 0), 45) ThenBlock: {
            sign = 0
            i = 1
        }
        ipart = 0
        more = 1
        WhileLoop EqualTo(more, 1) {
            c = GetByte(s, i)
            dig = 0
            IfCondition GreaterEqual(c, 48) ThenBlock: {
                IfCondition LessEqual(c, 57) ThenBlock: { dig = 1 }
            }
            IfCondition EqualTo(dig, 1) ThenBlock: {
                ipart = Add(Multiply(ipart, 10), Subtract(c, 48))
                i = Add(i, 1)
            }
            IfCondition EqualTo(dig, 0) ThenBlock: { more = 0 }
        }
        fpart = 0
        fdiv = 1
        IfCondition EqualTo(GetByte(s, i), 46) ThenBlock: {
            i = Add(i, 1)
            more = 1
            WhileLoop EqualTo(more, 1) {
                c = GetByte(s, i)
                IfCondition LessThan(c, 48) ThenBlock: { more = 0 }
                IfCondition GreaterThan(c, 57) ThenBlock: { more = 0 }
                IfCondition EqualTo(more, 1) ThenBlock: {
                    fpart = Add(Multiply(fpart, 10), Subtract(c, 48))
                    fdiv = Multiply(fdiv, 10)
                    i = Add(i, 1)
                }
            }
        }
        r = Float_FromInt(ipart)
        IfCondition GreaterThan(fdiv, 1) ThenBlock: {
            r = Float_Add(r, Float_Div(Float_FromInt(fpart), Float_FromInt(fdiv)))
        }
        IfCondition EqualTo(sign, 0) ThenBlock: { r = Float_Sub(0, r) }
        ReturnValue(r)
    }
}

Function.Scan_Adx.SkipEq {
    Input: s: Address
    Input: i: Integer
    Output: Integer
    Body: {
        more = 1
        WhileLoop EqualTo(more, 1) {
            c = GetByte(s, i)
            IfCondition EqualTo(c, 32) ThenBlock: { i = Add(i, 1) }
            IfCondition NotEqual(c, 32) ThenBlock: { more = 0 }
        }
        ReturnValue(i)
    }
}

Function.Scan_Adx.TakeEq {
    Input: idx: Integer
    Input: eq: Address
    Output: Integer
    Body: {
        one = 0x3FF0000000000000
        Scan_IR.WStore(idx, 4, one)
        Scan_IR.WStore(idx, 5, 0)
        Scan_IR.WStore(idx, 6, 0)
        IfCondition EqualTo(eq, 0) ThenBlock: { ReturnValue(0) }
        i = Scan_Adx.SkipEq(eq, 0)
        c = GetByte(eq, i)
        IfCondition EqualTo(c, 88) ThenBlock: { i = Add(i, 1) }
        IfCondition EqualTo(c, 120) ThenBlock: { i = Add(i, 1) }
        i = Scan_Adx.SkipEq(eq, i)
        IfCondition EqualTo(GetByte(eq, i), 42) ThenBlock: {
            i = Add(i, 1)
            i = Scan_Adx.SkipEq(eq, i)
            a = Scan_Adx.ParseFloat(Add(eq, i))
            Scan_IR.WStore(idx, 4, a)
            Scan_IR.WStore(idx, 6, 1)
            more = 1
            WhileLoop EqualTo(more, 1) {
                ch = GetByte(eq, i)
                IfCondition EqualTo(ch, 0) ThenBlock: { more = 0 }
                IfCondition EqualTo(ch, 43) ThenBlock: { more = 0 }
                IfCondition EqualTo(ch, 45) ThenBlock: { more = 0 }
                IfCondition EqualTo(more, 1) ThenBlock: { i = Add(i, 1) }
            }
            i = Scan_Adx.SkipEq(eq, i)
            IfCondition EqualTo(GetByte(eq, i), 43) ThenBlock: {
                i = Add(i, 1)
                i = Scan_Adx.SkipEq(eq, i)
                Scan_IR.WStore(idx, 5, Scan_Adx.ParseFloat(Add(eq, i)))
            }
            IfCondition EqualTo(GetByte(eq, i), 45) ThenBlock: {
                Scan_IR.WStore(idx, 5, Scan_Adx.ParseFloat(Add(eq, i)))
            }
            ReturnValue(1)
        }
        ReturnValue(0)
    }
}

Function.Scan_Adx.TakeValue {
    Input: node: Integer
    Output: Integer
    Body: {
        idx = Scan_IR.Alloc()
        IfCondition LessThan(idx, 0) ThenBlock: { ReturnValue(-1) }
        t = XML.Attr(node, "title")
        IfCondition EqualTo(t, 0) ThenBlock: { t = XML.Text(XML.Child(node, "title")) }
        IfCondition NotEqual(t, 0) ThenBlock: {
            Scan_IR.WStore(idx, 0, Scan_IR.Intern(t, 0))
        }
        u = XML.Text(XML.Child(node, "units"))
        IfCondition NotEqual(u, 0) ThenBlock: {
            Scan_IR.WStore(idx, 1, Scan_IR.Intern(u, 0))
        }
        o = XML.Text(XML.Child(node, "packetoffset"))
        IfCondition NotEqual(o, 0) ThenBlock: {
            Scan_IR.WStore(idx, 2, Scan_Adx.ParseDec(o))
        }
        math = XML.Child(node, "MATH")
        eq = XML.Attr(math, "equation")
        Scan_Adx.TakeEq(idx, eq)
        ReturnValue(idx)
    }
}

Function.Scan_Adx.Walk {
    Input: node: Integer
    Output: Integer
    Body: {
        n = node
        WhileLoop NotEqual(n, 0) {
            IfCondition EqualTo(XML.Type(n), 1) ThenBlock: {
                IfCondition EqualTo(XML.NameIs(n, "ADXHEADER"), 1) ThenBlock: {
                    b = XML.Text(XML.Child(n, "baud"))
                    IfCondition NotEqual(b, 0) ThenBlock: { Scan_IR_State.baud = Scan_Adx.ParseDec(b) }
                    d = XML.Text(XML.Child(n, "desc"))
                    IfCondition NotEqual(d, 0) ThenBlock: { Scan_IR_State.title = Scan_IR.Intern(d, 0) }
                }
                IfCondition EqualTo(XML.NameIs(n, "ADXVALUE"), 1) ThenBlock: {
                    Scan_Adx.TakeValue(n)
                }
                IfCondition EqualTo(XML.NameIs(n, "ADXCLISTENPACKET"), 1) ThenBlock: {
                    s = XML.Text(XML.Child(n, "packetsize"))
                    IfCondition NotEqual(s, 0) ThenBlock: {
                        sz = Scan_Adx.ParseDec(s)
                        IfCondition GreaterThan(sz, Scan_IR_State.pkt_size) ThenBlock: {
                            Scan_IR_State.pkt_size = sz
                        }
                    }
                    o = XML.Text(XML.Child(n, "packetoffsetinbody"))
                    IfCondition NotEqual(o, 0) ThenBlock: {
                        IfCondition EqualTo(Scan_IR_State.pkt_off, 0) ThenBlock: {
                            Scan_IR_State.pkt_off = Scan_Adx.ParseDec(o)
                        }
                    }
                }
                Scan_Adx.Walk(XML.FirstChild(n))
            }
            n = XML.Next(n)
        }
        ReturnValue(Scan_IR_State.n)
    }
}

Function.Scan_Adx.LoadFile {
    Input: path: Address
    Output: Integer
    Body: {
        Scan_IR.Init()
        fd = ECU_Sys.Open(path, 0, 0)
        IfCondition LessThan(fd, 0) ThenBlock: { ReturnValue(-1) }
        cap = 1048576
        raw = Allocate(cap)
        IfCondition EqualTo(raw, 0) ThenBlock: {
            ECU_Sys.Close(fd)
            ReturnValue(-1)
        }
        total = 0
        done = 0
        lim = Subtract(cap, 16)
        WhileLoop EqualTo(done, 0) {
            IfCondition GreaterEqual(total, lim) ThenBlock: { done = 1 }
            IfCondition EqualTo(done, 0) ThenBlock: {
                n = ECU_Sys.Read(fd, Add(raw, total), Subtract(lim, total))
                IfCondition LessEqual(n, 0) ThenBlock: { done = 1 }
                IfCondition GreaterThan(n, 0) ThenBlock: { total = Add(total, n) }
            }
        }
        ECU_Sys.Close(fd)
        wrap = Allocate(Add(total, 16))
        IfCondition EqualTo(wrap, 0) ThenBlock: { ReturnValue(-1) }
        SetByte(wrap, 0, 60)
        SetByte(wrap, 1, 97)
        SetByte(wrap, 2, 100)
        SetByte(wrap, 3, 120)
        SetByte(wrap, 4, 62)
        i = 0
        WhileLoop LessThan(i, total) {
            SetByte(wrap, Add(5, i), GetByte(raw, i))
            i = Add(i, 1)
        }
        p = Add(5, total)
        SetByte(wrap, p, 60)
        SetByte(wrap, Add(p, 1), 47)
        SetByte(wrap, Add(p, 2), 97)
        SetByte(wrap, Add(p, 3), 100)
        SetByte(wrap, Add(p, 4), 120)
        SetByte(wrap, Add(p, 5), 62)
        SetByte(wrap, Add(p, 6), 0)
        wlen = Add(p, 6)
        root = XML.Parse(wrap, wlen)
        IfCondition EqualTo(root, 0) ThenBlock: { ReturnValue(-1) }
        Scan_Adx.Walk(root)
        ReturnValue(Scan_IR_State.n)
    }
}
