LibraryImport.Arena
LibraryImport.Ecu.ECU_Sys

FixedPool.Scan_Client_State {
    "buf": Initialize=0, CanChange=True
    "rpm": Initialize=0, CanChange=True
    "map": Initialize=0, CanChange=True
    "ok":  Initialize=0, CanChange=True
}

Function.Scan_Client.MatchKey {
    Input: line: Address
    Input: key: Address
    Output: Integer
    Body: {
        i = 0
        WhileLoop NotEqual(GetByte(key, i), 0) {
            IfCondition NotEqual(GetByte(line, i), GetByte(key, i)) ThenBlock: { ReturnValue(-1) }
            i = Add(i, 1)
            IfCondition GreaterThan(i, 40) ThenBlock: { ReturnValue(-1) }
        }
        IfCondition NotEqual(GetByte(line, i), 61) ThenBlock: { ReturnValue(-1) }
        i = Add(i, 1)
        sign = 1
        IfCondition EqualTo(GetByte(line, i), 45) ThenBlock: {
            sign = 0
            i = Add(i, 1)
        }
        v = 0
        more = 1
        WhileLoop EqualTo(more, 1) {
            c = GetByte(line, i)
            dig = 0
            IfCondition GreaterEqual(c, 48) ThenBlock: {
                IfCondition LessEqual(c, 57) ThenBlock: { dig = 1 }
            }
            IfCondition EqualTo(dig, 1) ThenBlock: {
                v = Add(Multiply(v, 10), Subtract(c, 48))
                i = Add(i, 1)
            }
            IfCondition EqualTo(dig, 0) ThenBlock: { more = 0 }
        }
        IfCondition EqualTo(sign, 0) ThenBlock: { v = Subtract(0, v) }
        ReturnValue(v)
    }
}

Function.Scan_Client.Pull {
    Output: Integer
    Body: {
        IfCondition EqualTo(Scan_Client_State.buf, 0) ThenBlock: {
            Scan_Client_State.buf = Allocate(8192)
        }
        Scan_Client_State.ok = 0
        fd = SystemCall(2, "/tmp/ecu_scan/live.txt", 0, 0)
        IfCondition LessThan(fd, 0) ThenBlock: { ReturnValue(-1) }
        n = SystemCall(0, fd, Scan_Client_State.buf, 8190)
        SystemCall(3, fd, 0, 0)
        IfCondition LessEqual(n, 0) ThenBlock: { ReturnValue(-1) }
        SetByte(Scan_Client_State.buf, n, 0)
        i = 0
        WhileLoop LessThan(i, n) {
            Scan_Client.TakeLine(Add(Scan_Client_State.buf, i))
            more = 1
            WhileLoop EqualTo(more, 1) {
                IfCondition GreaterEqual(i, n) ThenBlock: { more = 0 }
                IfCondition EqualTo(GetByte(Scan_Client_State.buf, i), 10) ThenBlock: {
                    i = Add(i, 1)
                    more = 0
                }
                IfCondition EqualTo(more, 1) ThenBlock: { i = Add(i, 1) }
            }
        }
        Scan_Client_State.ok = 1
        ReturnValue(0)
    }
}

Function.Scan_Client.TakeLine {
    Input: line: Address
    Output: Integer
    Body: {
        v = Scan_Client.MatchKey(line, "Engine Speed")
        IfCondition GreaterEqual(v, 0) ThenBlock: { Scan_Client_State.rpm = v }
        v = Scan_Client.MatchKey(line, "MAP")
        IfCondition GreaterEqual(v, 0) ThenBlock: { Scan_Client_State.map = v }
        ReturnValue(0)
    }
}

Function.Scan_Client.RpmTenths {
    Output: Integer
    Body: { ReturnValue(Scan_Client_State.rpm) }
}

Function.Scan_Client.MapTenths {
    Output: Integer
    Body: { ReturnValue(Scan_Client_State.map) }
}
