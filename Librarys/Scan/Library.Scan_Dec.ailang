LibraryImport.Arena
LibraryImport.Scan.Scan_IR
LibraryImport.Cad.CAD_Num

Function.Scan_Dec.Raw {
    Input: pkt: Address
    Input: plen: Integer
    Input: off: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(pkt, 0) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(off, 0) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterEqual(off, plen) ThenBlock: { ReturnValue(0) }
        ReturnValue(GetByte(pkt, off))
    }
}

Function.Scan_Dec.ToDisp {
    Input: idx: Integer
    Input: pkt: Address
    Input: plen: Integer
    Output: Integer
    Body: {
        raw = Scan_Dec.Raw(pkt, plen, Scan_IR.Off(idx))
        xr = Float_FromInt(raw)
        k = Scan_IR.WLoad(idx, 6)
        a = Scan_IR.WLoad(idx, 4)
        b = Scan_IR.WLoad(idx, 5)
        IfCondition EqualTo(k, 1) ThenBlock: {
            ReturnValue(Float_Add(Float_Mul(a, xr), b))
        }
        ReturnValue(xr)
    }
}

Function.Scan_Dec.Tenths {
    Input: v: Integer
    Output: Integer
    Body: {
        t = Float_Mul(v, 0x4024000000000000)
        IfCondition EqualTo(CAD_Num.IsNeg(t), 0) ThenBlock: {
            t = Float_Add(t, 0x3FE0000000000000)
        }
        ReturnValue(Float_ToInt(t))
    }
}

Function.Scan_Dec.FillDemo8D {
    Input: pkt: Address
    Output: Integer
    Body: {
        i = 0
        WhileLoop LessThan(i, 63) {
            SetByte(pkt, i, 0)
            i = Add(i, 1)
        }
        SetByte(pkt, 10, 32)
        SetByte(pkt, 25, 80)
        ReturnValue(63)
    }
}
