// Scan.IR — ADX datastream channels. Not XDF. Not TunerPro XDL.
// Record 8 words: 0 title 1 units 2 off 3 bits 4 eq_a 5 eq_b 6 eq_kind 7 flags
// eq_kind 0 = X, 1 = a*X+b
//
// Copyright (c) 2026 Sean Collins, 2 Paws Machine and Engineering. All rights reserved.
// Licensed under the Sean Collins Software License (SCSL v1.0).

LibraryImport.Arena
LibraryImport.Ecu.ECU_Sys

FixedPool.Scan_IR_State {
    "ch":       Initialize=0, CanChange=True
    "n":        Initialize=0, CanChange=True
    "cap":      Initialize=0, CanChange=True
    "str":      Initialize=0, CanChange=True
    "str_n":    Initialize=0, CanChange=True
    "str_cap":  Initialize=0, CanChange=True
    "baud":     Initialize=8192, CanChange=True
    "pkt_size": Initialize=0, CanChange=True
    "pkt_off":  Initialize=0, CanChange=True
    "title":    Initialize=0, CanChange=True
    "send":     Initialize=0, CanChange=True
    "send_n":   Initialize=0, CanChange=True
}

Function.Scan_IR.Init {
    Output: Integer
    Body: {
        IfCondition EqualTo(Scan_IR_State.ch, 0) ThenBlock: {
            Scan_IR_State.cap = 256
            Scan_IR_State.ch = Allocate(16384)
            Scan_IR_State.str_cap = 65536
            Scan_IR_State.str = Allocate(65536)
            Scan_IR_State.send = Allocate(64)
        }
        IfCondition EqualTo(Scan_IR_State.ch, 0) ThenBlock: { ReturnValue(-1) }
        Scan_IR_State.n = 0
        Scan_IR_State.str_n = 1
        SetByte(Scan_IR_State.str, 0, 0)
        Scan_IR_State.baud = 8192
        Scan_IR_State.pkt_size = 0
        Scan_IR_State.pkt_off = 0
        Scan_IR_State.send_n = 0
        Scan_IR_State.title = 0
        ReturnValue(0)
    }
}

Function.Scan_IR.Intern {
    Input: src: Address
    Input: n: Integer
    Output: Address
    Body: {
        IfCondition EqualTo(src, 0) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(n, 1) ThenBlock: {
            n = 0
            WhileLoop NotEqual(GetByte(src, n), 0) {
                n = Add(n, 1)
                IfCondition GreaterThan(n, 120) ThenBlock: { ReturnValue(0) }
            }
        }
        need = Add(Scan_IR_State.str_n, Add(n, 1))
        IfCondition GreaterEqual(need, Scan_IR_State.str_cap) ThenBlock: { ReturnValue(0) }
        off = Scan_IR_State.str_n
        dst = Add(Scan_IR_State.str, off)
        i = 0
        WhileLoop LessThan(i, n) {
            SetByte(dst, i, GetByte(src, i))
            i = Add(i, 1)
        }
        SetByte(dst, n, 0)
        Scan_IR_State.str_n = Add(off, Add(n, 1))
        ReturnValue(dst)
    }
}

Function.Scan_IR.WStore {
    Input: idx: Integer
    Input: f: Integer
    Input: v: Integer
    Output: Integer
    Body: {
        StoreValue(Add(Scan_IR_State.ch, Add(Multiply(idx, 64), Multiply(f, 8))), v)
        ReturnValue(0)
    }
}

Function.Scan_IR.WLoad {
    Input: idx: Integer
    Input: f: Integer
    Output: Integer
    Body: {
        ReturnValue(Dereference(Add(Scan_IR_State.ch, Add(Multiply(idx, 64), Multiply(f, 8)))))
    }
}

Function.Scan_IR.Alloc {
    Output: Integer
    Body: {
        i = Scan_IR_State.n
        IfCondition GreaterEqual(i, Scan_IR_State.cap) ThenBlock: { ReturnValue(-1) }
        Scan_IR_State.n = Add(i, 1)
        Scan_IR.WStore(i, 0, 0)
        Scan_IR.WStore(i, 1, 0)
        Scan_IR.WStore(i, 2, 0)
        Scan_IR.WStore(i, 3, 8)
        Scan_IR.WStore(i, 4, 0x3FF0000000000000)
        Scan_IR.WStore(i, 5, 0)
        Scan_IR.WStore(i, 6, 0)
        Scan_IR.WStore(i, 7, 0)
        ReturnValue(i)
    }
}

Function.Scan_IR.Count {
    Output: Integer
    Body: { ReturnValue(Scan_IR_State.n) }
}

Function.Scan_IR.Title {
    Input: idx: Integer
    Output: Address
    Body: { ReturnValue(Scan_IR.WLoad(idx, 0)) }
}

Function.Scan_IR.Units {
    Input: idx: Integer
    Output: Address
    Body: { ReturnValue(Scan_IR.WLoad(idx, 1)) }
}

Function.Scan_IR.Off {
    Input: idx: Integer
    Output: Integer
    Body: { ReturnValue(Scan_IR.WLoad(idx, 2)) }
}

Function.Scan_IR.FindTitle {
    Input: name: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(name, 0) ThenBlock: { ReturnValue(-1) }
        i = 0
        WhileLoop LessThan(i, Scan_IR_State.n) {
            t = Scan_IR.WLoad(i, 0)
            IfCondition NotEqual(t, 0) ThenBlock: {
                ok = 1
                k = 0
                WhileLoop LessThan(k, 40) {
                    a = GetByte(name, k)
                    b = GetByte(t, k)
                    IfCondition NotEqual(a, b) ThenBlock: { ok = 0 }
                    IfCondition EqualTo(a, 0) ThenBlock: { k = 40 }
                    IfCondition LessThan(k, 40) ThenBlock: { k = Add(k, 1) }
                }
                IfCondition EqualTo(ok, 1) ThenBlock: { ReturnValue(i) }
            }
            i = Add(i, 1)
        }
        ReturnValue(-1)
    }
}
