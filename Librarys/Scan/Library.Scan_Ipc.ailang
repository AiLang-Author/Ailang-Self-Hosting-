// Scan.Ipc — file IPC at /tmp/ecu_scan/ (flashd twin).
// Tuner never opens /dev/ttyUSB*. scand owns the cable.
//
//   cmd.txt     load | demo | get | codes | log | quit
//   status.txt  idle | busy | fail | stop
//   live.txt    title=tenths per channel (latest sample)
//   codes.txt   DTC lines
//   adx.path    definition to load
//   heartbeat   ok
//
// Copyright (c) 2026 Sean Collins, 2 Paws Machine and Engineering. All rights reserved.
// Licensed under the Sean Collins Software License (SCSL v1.0).

LibraryImport.Arena
LibraryImport.Ecu.ECU_Sys
LibraryImport.Scan.Scan_IR
LibraryImport.Scan.Scan_Dec

FixedPool.Scan_Ipc_State {
    "dir_ok": Initialize=0, CanChange=True
}

Function.Scan_Ipc.EnsureDir {
    Output: Integer
    Body: {
        IfCondition EqualTo(Scan_Ipc_State.dir_ok, 0) ThenBlock: {
            SystemCall(83, "/tmp/ecu_scan", 493)
            Scan_Ipc_State.dir_ok = 1
        }
        ReturnValue(0)
    }
}

Function.Scan_Ipc.PutInt {
    Input: fd: Integer
    Input: n: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(n, 0) ThenBlock: {
            ECU_Sys.Write(fd, "-", 1)
            n = Subtract(0, n)
        }
        buf = Allocate(16)
        i = 0
        IfCondition EqualTo(n, 0) ThenBlock: {
            SetByte(buf, 0, 48)
            i = 1
        }
        WhileLoop GreaterThan(n, 0) {
            SetByte(buf, i, Add(48, Modulo(n, 10)))
            n = Divide(n, 10)
            i = Add(i, 1)
        }
        j = Subtract(i, 1)
        k = 0
        WhileLoop LessThan(k, j) {
            a = GetByte(buf, k)
            SetByte(buf, k, GetByte(buf, j))
            SetByte(buf, j, a)
            k = Add(k, 1)
            j = Subtract(j, 1)
        }
        ECU_Sys.Write(fd, buf, i)
        Deallocate(buf, 16)
        ReturnValue(0)
    }
}

Function.Scan_Ipc.Status {
    Input: s: Address
    Output: Integer
    Body: {
        Scan_Ipc.EnsureDir()
        fd = ECU_Sys.Open("/tmp/ecu_scan/status.txt", 577, 420)
        IfCondition LessThan(fd, 0) ThenBlock: { ReturnValue(-1) }
        ECU_Sys.Write(fd, s, ECU_Sys.Len(s))
        ECU_Sys.Write(fd, "\n", 1)
        ECU_Sys.Close(fd)
        ReturnValue(0)
    }
}

Function.Scan_Ipc.Beat {
    Output: Integer
    Body: {
        Scan_Ipc.EnsureDir()
        fd = ECU_Sys.Open("/tmp/ecu_scan/heartbeat", 577, 420)
        IfCondition LessThan(fd, 0) ThenBlock: { ReturnValue(-1) }
        ECU_Sys.Write(fd, "ok\n", 3)
        ECU_Sys.Close(fd)
        ReturnValue(0)
    }
}

Function.Scan_Ipc.ClearCmd {
    Output: Integer
    Body: {
        Scan_Ipc.EnsureDir()
        fd = ECU_Sys.Open("/tmp/ecu_scan/cmd.txt", 577, 420)
        IfCondition GreaterEqual(fd, 0) ThenBlock: { ECU_Sys.Close(fd) }
        ReturnValue(0)
    }
}

Function.Scan_Ipc.WriteLive {
    Input: pkt: Address
    Input: plen: Integer
    Output: Integer
    Body: {
        Scan_Ipc.EnsureDir()
        fd = ECU_Sys.Open("/tmp/ecu_scan/live.txt", 577, 420)
        IfCondition LessThan(fd, 0) ThenBlock: { ReturnValue(-1) }
        i = 0
        n = Scan_IR.Count()
        WhileLoop LessThan(i, n) {
            t = Scan_IR.Title(i)
            IfCondition NotEqual(t, 0) ThenBlock: {
                ECU_Sys.Write(fd, t, ECU_Sys.Len(t))
                ECU_Sys.Write(fd, "=", 1)
                Scan_Ipc.PutInt(fd, Scan_Dec.Tenths(Scan_Dec.ToDisp(i, pkt, plen)))
                ECU_Sys.Write(fd, "\n", 1)
            }
            i = Add(i, 1)
        }
        ECU_Sys.Close(fd)
        ReturnValue(0)
    }
}

Function.Scan_Ipc.ReadPath {
    Input: dest: Address
    Input: maxn: Integer
    Output: Integer
    Body: {
        fd = SystemCall(2, "/tmp/ecu_scan/adx.path", 0, 0)
        IfCondition LessThan(fd, 0) ThenBlock: { ReturnValue(0) }
        n = SystemCall(0, fd, dest, Subtract(maxn, 1))
        SystemCall(3, fd, 0, 0)
        IfCondition LessEqual(n, 0) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterThan(n, 0) ThenBlock: {
            IfCondition EqualTo(GetByte(dest, Subtract(n, 1)), 10) ThenBlock: {
                n = Subtract(n, 1)
            }
        }
        SetByte(dest, n, 0)
        ReturnValue(n)
    }
}

Function.Scan_Ipc.AppendLog {
    Input: pkt: Address
    Input: plen: Integer
    Output: Integer
    Body: {
        Scan_Ipc.EnsureDir()
        fd = ECU_Sys.Open("/tmp/ecu_scan/log.jsonl", 1089, 420)
        IfCondition LessThan(fd, 0) ThenBlock: { ReturnValue(-1) }
        ECU_Sys.Write(fd, "{", 1)
        i = 0
        n = Scan_IR.Count()
        first = 1
        WhileLoop LessThan(i, n) {
            t = Scan_IR.Title(i)
            IfCondition NotEqual(t, 0) ThenBlock: {
                IfCondition EqualTo(first, 0) ThenBlock: { ECU_Sys.Write(fd, ",", 1) }
                first = 0
                ECU_Sys.Write(fd, "\"", 1)
                ECU_Sys.Write(fd, t, ECU_Sys.Len(t))
                ECU_Sys.Write(fd, "\":", 2)
                Scan_Ipc.PutInt(fd, Scan_Dec.Tenths(Scan_Dec.ToDisp(i, pkt, plen)))
            }
            i = Add(i, 1)
        }
        ECU_Sys.Write(fd, "}\n", 2)
        ECU_Sys.Close(fd)
        ReturnValue(0)
    }
}
