// =============================================================================
// LOG TABLE
// 257 entries. LOGTBL[i] = -ln(i/256) * 4096  (Q12 fixed point)
// Index 0 is clamped (ln(0) = -inf, use large sentinel value).
// Used for cross-entropy loss reporting every N steps.
// Matches ATTN/11 LOGTBL exactly.
// =============================================================================
FixedPool.TFLogTbl {
    "l000": Initialize=32767 // clamped sentinel for p=0
    "l001": Initialize=22347 "l002": Initialize=19755 "l003": Initialize=18109
    "l004": Initialize=16931 "l005": Initialize=16025 "l006": Initialize=15290
