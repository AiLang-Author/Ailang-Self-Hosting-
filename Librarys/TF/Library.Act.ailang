// Library.TF.Act.ailang
// Activation functions for the transformer stack.
// Softmax via exp lookup table (256 entries, matches ATTN/11 EXPTBL)
// Cross-entropy loss via log lookup table (257 entries, matches ATTN/11 LOGTBL)
// No floating point. No transcendental functions at runtime.
// Copyright © 2025 Sean Collins, 2 Paws Machine and Engineering. All rights reserved. SCSL.

LibraryImport.TF.Math
LibraryImport.TF.Vec

// =============================================================================
// EXP TABLE
// 256 entries. EXPTBL[i] = exp(-i/32) * 256  (Q8 fixed point)
// Index i covers roughly 8 units of input before reaching zero.
// Generated offline: for i in range(256): int(exp(-i/32.0) * 256)
// Matches ATTN/11 EXPTBL exactly.
// =============================================================================
FixedPool.TFExpTbl {
    "e000": Initialize=256  "e001": Initialize=248  "e002": Initialize=240  "e003": Initialize=233
    "e004": Initialize=226  "e005": Initialize=219  "e006": Initialize=212  "e007": Initialize=205
