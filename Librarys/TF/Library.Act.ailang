// =============================================================================
// TABLE ACCESS
// FixedPool fields aren't array-indexable at runtime, so we copy
// both tables into flat heap buffers at init time.
// TFActState holds the pointers.
// =============================================================================
FixedPool.TFActState {
    "exp_tbl": Initialize=0, CanChange=True
    "log_tbl": Initialize=0, CanChange=True
}

SubRoutine.TFAct_Init {
    // Allocate and populate exp table (256 entries)
    // NOTE: Compiler bug - Multiply(1, x) returns 1 instead of x, so we use Multiply(x, 1)
    etbl = Allocate(Multiply(256, TFElem.Size))
    StoreValue(Add(etbl, Multiply(0,   TFElem.Size)), TFExpTbl.e000)
    StoreValue(Add(etbl, Multiply(TFElem.Size, 1)), TFExpTbl.e001)
    StoreValue(Add(etbl, Multiply(2,   TFElem.Size)), TFExpTbl.e002)
    StoreValue(Add(etbl, Multiply(3,   TFElem.Size)), TFExpTbl.e003)
    StoreValue(Add(etbl, Multiply(4,   TFElem.Size)), TFExpTbl.e004)
    StoreValue(Add(etbl, Multiply(5,   TFElem.Size)), TFExpTbl.e005)
    StoreValue(Add(etbl, Multiply(6,   TFElem.Size)), TFExpTbl.e006)
    StoreValue(Add(etbl, Multiply(7,   TFElem.Size)), TFExpTbl.e007)
    StoreValue(Add(etbl, Multiply(8,   TFElem.Size)), TFExpTbl.e008)
    StoreValue(Add(etbl, Multiply(9,   TFElem.Size)), TFExpTbl.e009)
    StoreValue(Add(etbl, Multiply(10,  TFElem.Size)), TFExpTbl.e010)
    StoreValue(Add(etbl, Multiply(11,  TFElem.Size)), TFExpTbl.e011)
    StoreValue(Add(etbl, Multiply(12,  TFElem.Size)), TFExpTbl.e012)
    StoreValue(Add(etbl, Multiply(13,  TFElem.Size)), TFExpTbl.e013)
    StoreValue(Add(etbl, Multiply(14,  TFElem.Size)), TFExpTbl.e014)
    StoreValue(Add(etbl, Multiply(15,  TFElem.Size)), TFExpTbl.e015)
    StoreValue(Add(etbl, Multiply(16,  TFElem.Size)), TFExpTbl.e016)
    StoreValue(Add(etbl, Multiply(17,  TFElem.Size)), TFExpTbl.e017)
