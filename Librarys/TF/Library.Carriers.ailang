// TFProjCarrier — extra args for TFLayer_ProjQKV
FixedPool.TFProjCarrier {
    "Wk":    Initialize=0
    "Wv":    Initialize=0
    "seqln": Initialize=0
    "dmod":  Initialize=0
}

// TFOutProjCarrier — extra args for TFLayer_OutputProj
FixedPool.TFOutProjCarrier {
    "seqln": Initialize=0
    "dmod":  Initialize=0
    "vocab": Initialize=0
}

// TFBackOut — extra args for TFTrain_BackOutProj
FixedPool.TFBackOut {
    "Wout":    Initialize=0
    "targets": Initialize=0
    "seqln":   Initialize=0
    "dmod":    Initialize=0
    "vocab":   Initialize=0
}

// TFBackCtx — extra args for TFTrain_BackAttnCtx
FixedPool.TFBackCtx {
    "attn":  Initialize=0
    "vvec":  Initialize=0
    "seqln": Initialize=0
    "dmod":  Initialize=0
    "scale": Initialize=0
}

// TFBackQK — extra args for TFTrain_BackQK
FixedPool.TFBackQK {
    "seqln": Initialize=0
    "dmod":  Initialize=0
}

// TFBackWA — extra args for TFTrain_BackWeightsA
FixedPool.TFBackWA {
    "Wq":    Initialize=0
    "Wk":    Initialize=0
    "Wv":    Initialize=0
    "emb":   Initialize=0
    "seqln": Initialize=0
    "dmod":  Initialize=0
    "dK":    Initialize=0
    "dV":    Initialize=0
}

// TFBackWB — extra args for TFTrain_BackWeightsB
FixedPool.TFBackWB {
    "tokens": Initialize=0
    "seqln":  Initialize=0
    "dmod":   Initialize=0
}