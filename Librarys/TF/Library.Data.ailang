// Library.TF.Data.ailang
// Training data generation for the sequence reversal task.
// Generates random digit sequences and their reversals.
// Copyright © 2025 Sean Collins, 2 Paws Machine and Engineering. All rights reserved. SCSL.

LibraryImport.TF.Math
LibraryImport.TF.Vec

// =============================================================================
// GENERATE ONE TRAINING EXAMPLE
// Fills tokens[0..SeqLen-1] with random digits 0-9
// Fills targets[0..SeqLen-1] with the reversal
// e.g. tokens = [4,7,4,9,6,3,6,5] → targets = [5,6,3,6,9,4,7,4]
// =============================================================================
Function.TFData_GenSample {
    Output: Integer
    Body: {
    // Caller reads from TFTrain.tokens and TFTrain.targets after this
    tokens  = TFState.tokens
    targets = TFState.targets
    seqln   = TFConfig.SeqLen
    vocab   = TFConfig.VocabSize

    // Fill tokens with random digits
    pos = 0
    WhileLoop LessThan(pos, seqln) {
        tok = TF_RandMod(vocab)
        TF_VecSet(tokens, pos, tok)
        pos = Add(pos, 1)
    }

    // Targets = reversal: targets[i] = tokens[seqln - 1 - i]
    pos = 0
    WhileLoop LessThan(pos, seqln) {
        src_pos = Subtract(Subtract(seqln, 1), pos)
        TF_VecSet(targets, pos, TF_VecGet(tokens, src_pos))
        pos = Add(pos, 1)
    }
    ReturnValue(1)
}
}


// =============================================================================
// PRINT ONE SEQUENCE — for inference display
// =============================================================================
SubRoutine.TFData_PrintSeq {
    // Caller sets TFDataPrint.vec and TFDataPrint.len
    vec = TFDataPrint.vec
    len = TFDataPrint.len
    i   = 0
    WhileLoop LessThan(i, len) {
        PrintNumber(TF_VecGet(vec, i))
        PrintMessage(" ")
        i = Add(i, 1)
    }
}

FixedPool.TFDataPrint {
    "vec": Initialize=0
    "len": Initialize=0
}