// Library.Float.ailang
// Q20 integer SGD and gradient operations (replaces SSE2 float math).
// Copyright © 2025 Sean Collins, 2 Paws Machine and Engineering. All rights reserved. SCSL.

LibraryImport.TF.Math
LibraryImport.TF.Vec
LibraryImport.TF.Mat

// =============================================================================
// Q20 INTEGER SGD
// w_q20 -= (grad * lr_num * FSCALE) / lr_den
// Weight matrix (isgd_mat) stores Q20 fixed-point integers (master weights).
// Gradient matrix (isgd_grad) stores raw integers (backward pass output).
// Updates accumulate in Q20 — sub-integer precision preserved without floats.
// =============================================================================
Function.TF_ISGD {
    Input:  isgd_mat:    Integer
    Input:  isgd_grad:   Integer
    Input:  isgd_rows:   Integer
    Input:  isgd_cols:   Integer
    Input:  isgd_lr_num: Integer
    Input:  isgd_lr_den: Integer
    Output: Integer
    Body: {
        isgd_n = Multiply(isgd_rows, isgd_cols)

        // Thread pool dispatch: split elements across workers
        IfCondition EqualTo(ThrPool.initialized, 1) ThenBlock: {
            IfCondition GreaterEqual(isgd_n, ThrPoolCfg.min_parallel) ThenBlock: {
                ThrPool.op   = 4
                ThrPool.dst  = isgd_mat
                ThrPool.mat  = isgd_grad
                ThrPool.vec  = isgd_lr_num
                ThrPool.vec2 = isgd_lr_den
                ThrPool.rows = isgd_rows
                ThrPool.cols = isgd_cols
                ThrPool.total_items = isgd_n
                tp_discard = ThrPool_Dispatch()
                ReturnValue(1)
            }
        }

        // Serial fallback
        isgd_off = 0
        WhileLoop LessThan(isgd_off, Multiply(isgd_n, 8)) {
            isgd_g   = Dereference(Add(isgd_grad, isgd_off))
            isgd_w   = Dereference(Add(isgd_mat,  isgd_off))
            isgd_upd = Divide(Multiply(Multiply(isgd_g, isgd_lr_num), TFScale.FSCALE), isgd_lr_den)
            StoreValue(Add(isgd_mat, isgd_off), Subtract(isgd_w, isgd_upd))
            isgd_off = Add(isgd_off, 8)
        }
        ReturnValue(1)
    }
}
