// Library.TF.Layer.ailang
// Pure functions only. No SubRoutines. No FixedPool state.
// Max 6 inputs per function. Extra args via TFProjCarrier / TFOutProjCarrier.
// Copyright © 2025 Sean Collins, 2 Paws Machine and Engineering. All rights reserved. SCSL.

LibraryImport.TF.Math
LibraryImport.TF.Vec
LibraryImport.TF.Mat
LibraryImport.TF.Act
LibraryImport.TF.Carriers

// =============================================================================
// WEIGHT INIT - SubRoutine version for use from SubRoutines
// =============================================================================
FixedPool.TFAllocCarrier {
    "rows":   Initialize=0
    "cols":   Initialize=0
    "range":  Initialize=0
    "result": Initialize=0
}

SubRoutine.TFLayer_AllocMatSub {
    am_rows  = TFAllocCarrier.rows
    am_cols  = TFAllocCarrier.cols
    am_range = TFAllocCarrier.range

    am_rc    = Multiply(am_rows, am_cols)
    am_total = Multiply(am_rc, 8)
    am_mat   = Allocate(am_total)

    // Zero fill
    am_i = 0
    WhileLoop LessThan(am_i, am_total) {
        SetByte(am_mat, am_i, 0)
        am_i = Add(am_i, 1)
    }

    // Rand init using direct FixedPool syntax
    am_drange = Multiply(am_range, 2)

    am_i = 0
    WhileLoop LessThan(am_i, am_rc) {
        am_s = TFRand.seed
        am_s = Add(Multiply(am_s, 1664525), 1013904223)
        am_s = BitwiseAnd(am_s, 2147483647)
        TFRand.seed = am_s

        am_shifted = Divide(am_s, 65536)
        am_rmod = Modulo(am_shifted, am_drange)
        am_rval = Subtract(am_rmod, am_range)
        am_off  = Multiply(8, am_i)
        am_adr  = Add(am_mat, am_off)
        StoreValue(am_adr, am_rval)
        am_i = Add(am_i, 1)
    }

    TFAllocCarrier.result = am_mat
}

Function.TFLayer_AllocMat {
    Input:  rows:  Integer
    Input:  cols:  Integer
    Input:  range: Integer
    Output: Integer
    Body: {
        mat = TF_MatAlloc(rows, cols)
        DebugAssert(NotEqual(mat, 0), "TFLayer_AllocMat: alloc failed")
        TF_MatRandInit(mat, rows, cols, range)
        ReturnValue(mat)
    }
}

// =============================================================================
// EMBEDDING LOOKUP
// emb[pos] = Embed[token] + PosEmb[pos]
// =============================================================================
Function.TFLayer_Embed {
    Input:  emb:    Integer
    Input:  tokens: Integer
    Input:  Embed:  Integer
    Input:  PosEmb: Integer
    Input:  seqln:  Integer
    Input:  dmod:   Integer
    Output: Integer
    Body: {
        pos = 0
        WhileLoop LessThan(pos, seqln) {
            tok_off = Multiply(TFElem.Size, pos)
            tok_adr = Add(tokens, tok_off)
            tok     = Dereference(tok_adr)
            col = 0
            WhileLoop LessThan(col, dmod) {
                tv  = TF_MatGet(Embed,  tok, col, dmod)
                pv  = TF_MatGet(PosEmb, pos, col, dmod)
                res = Add(tv, pv)
                TF_MatSet(emb, pos, col, dmod, res)
                col = Add(col, 1)
            }
            pos = Add(pos, 1)
        }
        ReturnValue(1)
    }
}

// =============================================================================
// FEED-FORWARD NETWORK (FFN)
// mlp_out = ReLU(x * W1) * W2
// Reads TFProjCarrier: .seqln .dmod .dff
// =============================================================================
Function.TFLayer_MLP {
    Input:  mlp_out: Integer
    Input:  hidden:  Integer
    Input:  x:       Integer
    Input:  W1:      Integer
    Input:  W2:      Integer
    Output: Integer
    Body: {
        seqln = TFProjCarrier.seqln
        dmod  = TFProjCarrier.dmod
        dff   = TFProjCarrier.dff
        tmp_x = TF_VecAlloc(dmod)
        tmp_h = TF_VecAlloc(dff)
        tmp_o = TF_VecAlloc(dmod)
        pos = 0
        WhileLoop LessThan(pos, seqln) {
            // Extract row
            col = 0
            WhileLoop LessThan(col, dmod) {
                TF_VecSet(tmp_x, col, TF_MatGet(x, pos, col, dmod))
                col = Add(col, 1)
            }
            // hidden = x · W1 (using transposed multiply since W1 is [dmod x dff])
            TF_MatTVecMul(tmp_h, W1, tmp_x, dmod, dff)
            // ReLU in-place, save to hidden cache for backward
            col = 0
            WhileLoop LessThan(col, dff) {
                v = TF_VecGet(tmp_h, col)
                IfCondition LessThan(v, 0) ThenBlock: { v = 0 }
                TF_VecSet(tmp_h, col, v)
                TF_MatSet(hidden, pos, col, dff, v)
                col = Add(col, 1)
            }
            // out = hidden · W2 (using transposed multiply since W2 is [dff x dmod])
            TF_MatTVecMul(tmp_o, W2, tmp_h, dff, dmod)
            col = 0
            WhileLoop LessThan(col, dmod) {
                TF_MatSet(mlp_out, pos, col, dmod, TF_VecGet(tmp_o, col))
                col = Add(col, 1)
            }
            pos = Add(pos, 1)
        }
        TF_VecFree(tmp_x, dmod)
        TF_VecFree(tmp_h, dff)
        TF_VecFree(tmp_o, dmod)
        ReturnValue(1)
    }
}

// =============================================================================
// QKV PROJECTION
// Reads TFProjCarrier: .Wk .Wv .seqln .dmod
// =============================================================================
Function.TFLayer_ProjQKV {
    Input:  qvec: Integer
    Input:  kvec: Integer
    Input:  vvec: Integer
    Input:  emb:  Integer
    Input:  Wq:   Integer
    Output: Integer
    Body: {
        Wk    = TFProjCarrier.Wk
        Wv    = TFProjCarrier.Wv
        seqln = TFProjCarrier.seqln
        dmod  = TFProjCarrier.dmod

        tmp_emb = TF_VecAlloc(dmod)
        qrow    = TF_VecAlloc(dmod)
        krow    = TF_VecAlloc(dmod)
        vrow    = TF_VecAlloc(dmod)

        DebugAssert(NotEqual(tmp_emb, 0), "TFLayer_ProjQKV: alloc failed")

        pos = 0
        WhileLoop LessThan(pos, seqln) {
            col = 0
            WhileLoop LessThan(col, dmod) {
                val = TF_MatGet(emb, pos, col, dmod)
                TF_VecSet(tmp_emb, col, val)
                col = Add(col, 1)
            }
            TF_MatVecMul(qrow, Wq, tmp_emb, dmod, dmod)
            TF_MatVecMul(krow, Wk, tmp_emb, dmod, dmod)
            TF_MatVecMul(vrow, Wv, tmp_emb, dmod, dmod)
            col = 0
            WhileLoop LessThan(col, dmod) {
                TF_MatSet(qvec, pos, col, dmod, TF_VecGet(qrow, col))
                TF_MatSet(kvec, pos, col, dmod, TF_VecGet(krow, col))
                TF_MatSet(vvec, pos, col, dmod, TF_VecGet(vrow, col))
                col = Add(col, 1)
            }
            pos = Add(pos, 1)
        }

        TF_VecFree(tmp_emb, dmod)
        TF_VecFree(qrow,    dmod)
        TF_VecFree(krow,    dmod)
        TF_VecFree(vrow,    dmod)
        ReturnValue(1)
    }
}

// =============================================================================
// ATTENTION SCORES
// scores[i][j] = dot(q[i], k[j]) / scale
// =============================================================================
Function.TFLayer_AttnScores {
    Input:  scores: Integer
    Input:  qvec:   Integer
    Input:  kvec:   Integer
    Input:  seqln:  Integer
    Input:  dmod:   Integer
    Input:  numheads: Integer
    Output: Integer
    Body: {
        qrow = TF_VecAlloc(dmod)
        krow = TF_VecAlloc(dmod)
        headdim = Divide(dmod, numheads)
        scale = TF_ISqrt(headdim)
        DebugAssert(NotEqual(qrow, 0), "TFLayer_AttnScores: alloc failed")

        h = 0
        WhileLoop LessThan(h, numheads) {
            offset = Multiply(h, headdim)
            row = 0
            WhileLoop LessThan(row, seqln) {
                col = 0
                WhileLoop LessThan(col, dmod) {
                    TF_VecSet(qrow, col, TF_MatGet(qvec, row, col, dmod))
                    col = Add(col, 1)
                }
                s_row = Add(Multiply(h, seqln), row)
                col = 0
                WhileLoop LessThan(col, seqln) {
                    ki = 0
                    WhileLoop LessThan(ki, dmod) {
                        TF_VecSet(krow, ki, TF_MatGet(kvec, col, ki, dmod))
                        ki = Add(ki, 1)
                    }
                    raw = TF_VecDotOffset(qrow, krow, offset, headdim)
                    sc = Divide(raw, scale)
                    TF_MatSet(scores, s_row, col, seqln, sc)
                    col = Add(col, 1)
                }
                row = Add(row, 1)
            }
            h = Add(h, 1)
        }

        TF_VecFree(qrow, dmod)
        TF_VecFree(krow, dmod)
        ReturnValue(1)
    }
}

// =============================================================================
// ATTENTION SOFTMAX
// attn[row] = softmax(scores[row])
// =============================================================================
Function.TFLayer_AttnSoftmax {
    Input:  attn:   Integer
    Input:  scores: Integer
    Input:  seqln:  Integer
    Input:  numheads: Integer
    Output: Integer
    Body: {
        score_row = TF_VecAlloc(seqln)
        attn_row  = TF_VecAlloc(seqln)
        hsl = Multiply(numheads, seqln)
        DebugAssert(NotEqual(score_row, 0), "TFLayer_AttnSoftmax: alloc failed")

        row = 0
        WhileLoop LessThan(row, hsl) {
            col = 0
            WhileLoop LessThan(col, seqln) {
                val = TF_MatGet(scores, row, col, seqln)
                TF_VecSet(score_row, col, val)
                col = Add(col, 1)
            }
            TFAct_Softmax(attn_row, score_row, seqln)
            col = 0
            WhileLoop LessThan(col, seqln) {
                TF_MatSet(attn, row, col, seqln, TF_VecGet(attn_row, col))
                col = Add(col, 1)
            }
            row = Add(row, 1)
        }

        TF_VecFree(score_row, seqln)
        TF_VecFree(attn_row,  seqln)
        ReturnValue(1)
    }
}

// =============================================================================
// CONTEXT VECTORS
// ctx[i] = sum_j(attn[i][j] * v[j])
// =============================================================================
Function.TFLayer_Context {
    Input:  ctx:   Integer
    Input:  attn:  Integer
    Input:  vvec:  Integer
    Input:  seqln: Integer
    Input:  dmod:  Integer
    Input:  numheads: Integer
    Output: Integer
    Body: {
        ctx_row = TF_VecAlloc(dmod)
        headdim = Divide(dmod, numheads)
        DebugAssert(NotEqual(ctx_row, 0), "TFLayer_Context: alloc failed")

        row = 0
        WhileLoop LessThan(row, seqln) {
            TF_VecZero(ctx_row, dmod)
            h = 0
            WhileLoop LessThan(h, numheads) {
                offset = Multiply(h, headdim)
                s_row = Add(Multiply(h, seqln), row)
                col = 0
                WhileLoop LessThan(col, seqln) {
                    aw = TF_MatGet(attn, s_row, col, seqln)
                    di = 0
                    WhileLoop LessThan(di, headdim) {
                        didx   = Add(offset, di)
                        vval   = TF_MatGet(vvec, col, didx, dmod)
                        old    = TF_VecGet(ctx_row, didx)
                        prod   = Multiply(aw, vval)
                        scaled = Divide(prod, 256)
                        nuw    = Add(old, scaled)
                        TF_VecSet(ctx_row, didx, nuw)
                        di = Add(di, 1)
                    }
                    col = Add(col, 1)
                }
                h = Add(h, 1)
            }
            di = 0
            WhileLoop LessThan(di, dmod) {
                TF_MatSet(ctx, row, di, dmod, TF_VecGet(ctx_row, di))
                di = Add(di, 1)
            }
            row = Add(row, 1)
        }

        TF_VecFree(ctx_row, dmod)
        ReturnValue(1)
    }
}

// =============================================================================
// RESIDUAL
// resid[t] = ctx[t] + emb[t]
// =============================================================================
Function.TFLayer_Residual {
    Input:  resid: Integer
    Input:  ctx:   Integer
    Input:  emb:   Integer
    Input:  seqln: Integer
    Input:  dmod:  Integer
    Output: Integer
    Body: {
        pos = 0
        WhileLoop LessThan(pos, seqln) {
            col = 0
            WhileLoop LessThan(col, dmod) {
                cv  = TF_MatGet(ctx, pos, col, dmod)
                ev  = TF_MatGet(emb, pos, col, dmod)
                res = Add(cv, ev)
                TF_MatSet(resid, pos, col, dmod, res)
                col = Add(col, 1)
            }
            pos = Add(pos, 1)
        }
        ReturnValue(1)
    }
}

// =============================================================================
// OUTPUT PROJECTION + SOFTMAX
// Reads TFOutProjCarrier: .seqln .dmod .vocab
// =============================================================================
Function.TFLayer_OutputProj {
    Input:  logits: Integer
    Input:  probs:  Integer
    Input:  resid:  Integer
    Input:  Wout:   Integer
    Output: Integer
    Body: {
        seqln = TFOutProjCarrier.seqln
        dmod  = TFOutProjCarrier.dmod
        vocab = TFOutProjCarrier.vocab

        tmp_row   = TF_VecAlloc(dmod)
        logit_row = TF_VecAlloc(vocab)
        prob_row  = TF_VecAlloc(vocab)
        DebugAssert(NotEqual(tmp_row, 0), "TFLayer_OutputProj: alloc failed")

        pos = 0
        WhileLoop LessThan(pos, seqln) {
            col = 0
            WhileLoop LessThan(col, dmod) {
                val = TF_MatGet(resid, pos, col, dmod)
                TF_VecSet(tmp_row, col, val)
                col = Add(col, 1)
            }
            TF_MatVecMul(logit_row, Wout, tmp_row, vocab, dmod)
            col = 0
            WhileLoop LessThan(col, vocab) {
                val = TF_VecGet(logit_row, col)
                TF_MatSet(logits, pos, col, vocab, val)
                col = Add(col, 1)
            }
            TFAct_Softmax(prob_row, logit_row, vocab)
            col = 0
            WhileLoop LessThan(col, vocab) {
                val = TF_VecGet(prob_row, col)
                TF_MatSet(probs, pos, col, vocab, val)
                col = Add(col, 1)
            }
            pos = Add(pos, 1)
        }

        TF_VecFree(tmp_row,   dmod)
        TF_VecFree(logit_row, vocab)
        TF_VecFree(prob_row,  vocab)
        ReturnValue(1)
    }
}