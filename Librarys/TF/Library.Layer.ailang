// Library.TF.Layer.ailang
// Pure functions only. No SubRoutines. No FixedPool state.
// Max 6 inputs per function. Extra args via TFProjCarrier / TFOutProjCarrier.
// Copyright © 2025 Sean Collins, 2 Paws Machine and Engineering. All rights reserved. SCSL.

LibraryImport.TF.Math
LibraryImport.TF.Vec
LibraryImport.TF.Mat
LibraryImport.TF.Act
LibraryImport.TF.Carriers

// =============================================================================
// WEIGHT INIT - SubRoutine version for use from SubRoutines
// =============================================================================
FixedPool.TFAllocCarrier {
    "rows":   Initialize=0
    "cols":   Initialize=0
    "range":  Initialize=0
    "result": Initialize=0
}

SubRoutine.TFLayer_AllocMatSub {
    am_rows  = TFAllocCarrier.rows
    am_cols  = TFAllocCarrier.cols
    am_range = TFAllocCarrier.range

    am_rc    = Multiply(am_rows, am_cols)
    am_total = Multiply(am_rc, 8)
    am_mat   = Allocate(am_total)

    // Zero fill
    MemorySet(am_mat, 0, am_total)

    // Rand init using direct FixedPool syntax
    am_drange = Multiply(am_range, 2)

    am_i = 0
    WhileLoop LessThan(am_i, am_rc) {
        am_s = TFRand.seed
        am_s = Add(Multiply(am_s, 1664525), 1013904223)
        am_s = BitwiseAnd(am_s, 2147483647)
        TFRand.seed = am_s

        am_shifted = Divide(am_s, 65536)
        am_rmod = Modulo(am_shifted, am_drange)
        am_rval = Subtract(am_rmod, am_range)
        am_off  = Multiply(8, am_i)
        am_adr  = Add(am_mat, am_off)
        StoreValue(am_adr, am_rval)
        am_i = Add(am_i, 1)
    }

    TFAllocCarrier.result = am_mat
}

Function.TFLayer_AllocMat {
    Input:  rows:  Integer
    Input:  cols:  Integer
    Input:  range: Integer
    Output: Integer
    Body: {
        mat = TF_MatAlloc(rows, cols)
        DebugAssert(NotEqual(mat, 0), "TFLayer_AllocMat: alloc failed")
        TF_MatRandInit(mat, rows, cols, range)
        ReturnValue(mat)
    }
}

// =============================================================================
// EMBEDDING LOOKUP
// emb[pos] = Embed[token] + PosEmb[pos]
// =============================================================================
Function.TFLayer_Embed {
    Input:  emb:    Integer
    Input:  tokens: Integer
    Input:  Embed:  Integer
    Input:  PosEmb: Integer
    Input:  seqln:  Integer
    Input:  dmod:   Integer
    Output: Integer
    Body: {
        dmod_bytes = Multiply(dmod, 8)
        pos = 0
        WhileLoop LessThan(pos, seqln) {
            tok     = Dereference(Add(tokens, Multiply(8, pos)))
            emb_row = Add(emb,    Multiply(pos, dmod_bytes))
            tok_row = Add(Embed,  Multiply(tok, dmod_bytes))
            pos_row = Add(PosEmb, Multiply(pos, dmod_bytes))
            off = 0
            WhileLoop LessThan(off, dmod_bytes) {
                StoreValue(Add(emb_row, off), Add(Dereference(Add(tok_row, off)), Dereference(Add(pos_row, off))))
                off = Add(off, 8)
            }
            pos = Add(pos, 1)
        }
        ReturnValue(1)
    }
}

// =============================================================================
// FEED-FORWARD NETWORK (FFN)
// mlp_out = ReLU(x * W1) * W2
// Reads TFProjCarrier: .seqln .dmod .dff
// =============================================================================
Function.TFLayer_MLP {
    Input:  mlp_out: Integer
    Input:  hidden:  Integer
    Input:  x:       Integer
    Input:  W1:      Integer
    Input:  W2:      Integer
    Output: Integer
    Body: {
        seqln = TFProjCarrier.seqln
        dmod  = TFProjCarrier.dmod
        dff   = TFProjCarrier.dff
        tmp_x = TF_VecAlloc(dmod)
        tmp_h = TF_VecAlloc(dff)
        tmp_o = TF_VecAlloc(dmod)
        dmod_bytes = Multiply(dmod, 8)
        dff_bytes  = Multiply(dff, 8)
        pos = 0
        WhileLoop LessThan(pos, seqln) {
            // Extract row
            MemoryCopy(tmp_x, Add(x, Multiply(pos, dmod_bytes)), dmod_bytes)
            // hidden = x · W1 (using transposed multiply since W1 is [dmod x dff])
            TF_MatTVecMul(tmp_h, W1, tmp_x, dmod, dff)
            // ReLU in-place, save to hidden cache for backward
            hid_row = Add(hidden, Multiply(pos, dff_bytes))
            off = 0
            WhileLoop LessThan(off, dff_bytes) {
                v = Dereference(Add(tmp_h, off))
                IfCondition LessThan(v, 0) ThenBlock: { v = 0 }
                StoreValue(Add(tmp_h, off), v)
                StoreValue(Add(hid_row, off), v)
                off = Add(off, 8)
            }
            // out = hidden · W2 (using transposed multiply since W2 is [dff x dmod])
            TF_MatTVecMul(tmp_o, W2, tmp_h, dff, dmod)
            MemoryCopy(Add(mlp_out, Multiply(pos, dmod_bytes)), tmp_o, dmod_bytes)
            pos = Add(pos, 1)
        }
        TF_VecFree(tmp_x, dmod)
        TF_VecFree(tmp_h, dff)
        TF_VecFree(tmp_o, dmod)
        ReturnValue(1)
    }
}

// =============================================================================
// QKV PROJECTION
// Reads TFProjCarrier: .Wk .Wv .seqln .dmod
// =============================================================================
Function.TFLayer_ProjQKV {
    Input:  qvec: Integer
    Input:  kvec: Integer
    Input:  vvec: Integer
    Input:  emb:  Integer
    Input:  Wq:   Integer
    Output: Integer
    Body: {
        Wk    = TFProjCarrier.Wk
        Wv    = TFProjCarrier.Wv
        seqln = TFProjCarrier.seqln
        dmod  = TFProjCarrier.dmod

        tmp_emb = TF_VecAlloc(dmod)
        qrow    = TF_VecAlloc(dmod)
        krow    = TF_VecAlloc(dmod)
        vrow    = TF_VecAlloc(dmod)

        DebugAssert(NotEqual(tmp_emb, 0), "TFLayer_ProjQKV: alloc failed")

        row_bytes = Multiply(dmod, 8)
        pos = 0
        WhileLoop LessThan(pos, seqln) {
            row_off = Multiply(pos, row_bytes)
            MemoryCopy(tmp_emb, Add(emb, row_off), row_bytes)
            TF_MatVecMul(qrow, Wq, tmp_emb, dmod, dmod)
            TF_MatVecMul(krow, Wk, tmp_emb, dmod, dmod)
            TF_MatVecMul(vrow, Wv, tmp_emb, dmod, dmod)
            MemoryCopy(Add(qvec, row_off), qrow, row_bytes)
            MemoryCopy(Add(kvec, row_off), krow, row_bytes)
            MemoryCopy(Add(vvec, row_off), vrow, row_bytes)
            pos = Add(pos, 1)
        }

        TF_VecFree(tmp_emb, dmod)
        TF_VecFree(qrow,    dmod)
        TF_VecFree(krow,    dmod)
        TF_VecFree(vrow,    dmod)
        ReturnValue(1)
    }
}

// =============================================================================
// ATTENTION SCORES
// scores[i][j] = dot(q[i], k[j]) / scale
// =============================================================================
Function.TFLayer_AttnScores {
    Input:  scores: Integer
    Input:  qvec:   Integer
    Input:  kvec:   Integer
    Input:  seqln:  Integer
    Input:  dmod:   Integer
    Input:  numheads: Integer
    Output: Integer
    Body: {
        headdim = Divide(dmod, numheads)
        scale = TF_ISqrt(headdim)
        dmod_bytes = Multiply(dmod, 8)
        seqln_bytes = Multiply(seqln, 8)

        // Prefix-LM mask: positions inside the encoder zone [0, prefix_len)
        // attend bidirectionally to all encoder-zone positions. Decoder-zone
        // positions [prefix_len, seqln) attend causally — to encoder zone +
        // earlier decoder positions. PrefixLen=0 reduces to standard causal.
        prefix_len = TFAttnCarrier.prefix_len

        h = 0
        WhileLoop LessThan(h, numheads) {
            offset = Multiply(h, headdim)
            row = 0
            WhileLoop LessThan(row, seqln) {
                q_ptr = Add(qvec, Multiply(row, dmod_bytes))
                s_row = Add(Multiply(h, seqln), row)
                scores_base = Add(scores, Multiply(Multiply(s_row, seqln), 8))
                col = 0
                WhileLoop LessThan(col, seqln) {
                    masked = 0
                    IfCondition GreaterThan(col, row) ThenBlock: {
                        IfCondition GreaterEqual(col, prefix_len) ThenBlock: {
                            masked = 1
                        }
                    }
                    IfCondition EqualTo(masked, 1) ThenBlock: {
                        StoreValue(Add(scores_base, Multiply(col, 8)), -1000000)
                    } ElseBlock: {
                        k_ptr = Add(kvec, Multiply(col, dmod_bytes))
                        raw = TF_VecDotOffset(q_ptr, k_ptr, offset, headdim)
                        sc = Divide(raw, scale)
                        StoreValue(Add(scores_base, Multiply(col, 8)), sc)
                    }
                    col = Add(col, 1)
                }
                row = Add(row, 1)
            }
            h = Add(h, 1)
        }
        ReturnValue(1)
    }
}

// =============================================================================
// ATTENTION SOFTMAX
// attn[row] = softmax(scores[row])
// =============================================================================
Function.TFLayer_AttnSoftmax {
    Input:  attn:   Integer
    Input:  scores: Integer
    Input:  seqln:  Integer
    Input:  numheads: Integer
    Output: Integer
    Body: {
        attn_row  = TF_VecAlloc(seqln)
        hsl = Multiply(numheads, seqln)
        seqln_bytes = Multiply(seqln, 8)
        DebugAssert(NotEqual(attn_row, 0), "TFLayer_AttnSoftmax: alloc failed")

        row = 0
        WhileLoop LessThan(row, hsl) {
            score_ptr = Add(scores, Multiply(row, seqln_bytes))
            TFAct_Softmax(attn_row, score_ptr, seqln)
            MemoryCopy(Add(attn, Multiply(row, seqln_bytes)), attn_row, seqln_bytes)
            row = Add(row, 1)
        }

        TF_VecFree(attn_row, seqln)
        ReturnValue(1)
    }
}

// =============================================================================
// CONTEXT VECTORS
// ctx[i] = sum_j(attn[i][j] * v[j])
// =============================================================================
Function.TFLayer_Context {
    Input:  ctx:   Integer
    Input:  attn:  Integer
    Input:  vvec:  Integer
    Input:  seqln: Integer
    Input:  dmod:  Integer
    Input:  numheads: Integer
    Output: Integer
    Body: {
        ctx_row = TF_VecAlloc(dmod)
        headdim = Divide(dmod, numheads)
        dmod_bytes = Multiply(dmod, 8)
        headdim_bytes = Multiply(headdim, 8)
        DebugAssert(NotEqual(ctx_row, 0), "TFLayer_Context: alloc failed")

        row = 0
        WhileLoop LessThan(row, seqln) {
            TF_VecZero(ctx_row, dmod)
            h = 0
            WhileLoop LessThan(h, numheads) {
                head_off_bytes = Multiply(Multiply(h, headdim), 8)
                s_row = Add(Multiply(h, seqln), row)
                attn_row_base = Add(attn, Multiply(Multiply(s_row, seqln), 8))
                col = 0
                WhileLoop LessThan(col, seqln) {
                    aw = Dereference(Add(attn_row_base, Multiply(col, 8)))
                    v_base = Add(Add(vvec, Multiply(col, dmod_bytes)), head_off_bytes)
                    c_base = Add(ctx_row, head_off_bytes)
                    di_off = 0
                    WhileLoop LessThan(di_off, headdim_bytes) {
                        ca = Add(c_base, di_off)
                        StoreValue(ca, Add(Dereference(ca), Divide(Multiply(aw, Dereference(Add(v_base, di_off))), 256)))
                        di_off = Add(di_off, 8)
                    }
                    col = Add(col, 1)
                }
                h = Add(h, 1)
            }
            MemoryCopy(Add(ctx, Multiply(row, dmod_bytes)), ctx_row, dmod_bytes)
            row = Add(row, 1)
        }

        TF_VecFree(ctx_row, dmod)
        ReturnValue(1)
    }
}

// =============================================================================
// RESIDUAL
// resid[t] = ctx[t] + emb[t]
// =============================================================================
Function.TFLayer_Residual {
    Input:  resid: Integer
    Input:  ctx:   Integer
    Input:  emb:   Integer
    Input:  seqln: Integer
    Input:  dmod:  Integer
    Output: Integer
    Body: {
        total_bytes = Multiply(Multiply(seqln, dmod), 8)
        off = 0
        WhileLoop LessThan(off, total_bytes) {
            StoreValue(Add(resid, off), Add(Dereference(Add(ctx, off)), Dereference(Add(emb, off))))
            off = Add(off, 8)
        }
        ReturnValue(1)
    }
}

// =============================================================================
// OUTPUT PROJECTION + SOFTMAX
// Reads TFOutProjCarrier: .seqln .dmod .vocab
// =============================================================================
Function.TFLayer_OutputProj {
    Input:  logits: Integer
    Input:  probs:  Integer
    Input:  resid:  Integer
    Input:  Wout:   Integer
    Output: Integer
    Body: {
        seqln = TFOutProjCarrier.seqln
        dmod  = TFOutProjCarrier.dmod
        vocab = TFOutProjCarrier.vocab

        tmp_row   = TF_VecAlloc(dmod)
        logit_row = TF_VecAlloc(vocab)
        prob_row  = TF_VecAlloc(vocab)
        DebugAssert(NotEqual(tmp_row, 0), "TFLayer_OutputProj: alloc failed")

        dmod_bytes = Multiply(dmod, 8)
        vocab_bytes = Multiply(vocab, 8)
        logit_scale = Divide(dmod, 4)
        IfCondition LessThan(logit_scale, 1) ThenBlock: { logit_scale = 1 }

        pos = 0
        WhileLoop LessThan(pos, seqln) {
            MemoryCopy(tmp_row, Add(resid, Multiply(pos, dmod_bytes)), dmod_bytes)
            TF_MatVecMul(logit_row, Wout, tmp_row, vocab, dmod)

            // Scale logits by dmod/4
            off = 0
            WhileLoop LessThan(off, vocab_bytes) {
                la = Add(logit_row, off)
                StoreValue(la, Divide(Dereference(la), logit_scale))
                off = Add(off, 8)
            }

            logit_dst = Add(logits, Multiply(pos, vocab_bytes))
            MemoryCopy(logit_dst, logit_row, vocab_bytes)
            TFAct_Softmax(prob_row, logit_row, vocab)
            MemoryCopy(Add(probs, Multiply(pos, vocab_bytes)), prob_row, vocab_bytes)
            pos = Add(pos, 1)
        }

        TF_VecFree(tmp_row,   dmod)
        TF_VecFree(logit_row, vocab)
        TF_VecFree(prob_row,  vocab)
        ReturnValue(1)
    }
}