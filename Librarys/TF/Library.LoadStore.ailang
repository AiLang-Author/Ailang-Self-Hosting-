// Library.LoadStore.ailang
// Save/Load trained model weights for inference
// Raw binary format: header + flat weight buffers
// No dependencies beyond syscalls and TF.Math
// Copyright © 2025 Sean Collins, 2 Paws Machine and Engineering. All rights reserved. SCSL.

LibraryImport.TF.Math

// =============================================================================
// FILE HEADER — 64 bytes
// Verifies model config matches before loading weights
// =============================================================================
// Offset  Field        Size
// 0       Magic        8 bytes  (0x4E4E31314D444C00 = "NN11MDL\0")
// 8       DModel       8 bytes
// 16      SeqLen       8 bytes
// 24      VocabSize    8 bytes
// 32      NumHeads     8 bytes
// 40      DFF          8 bytes
// 48      ParamCount   8 bytes
// 56      Reserved     8 bytes
// =============================================================================

FixedPool.TFModelFile {
    "header":   Initialize=0, CanChange=True
    "fd":       Initialize=0, CanChange=True
    "status":   Initialize=0, CanChange=True
}

FixedPool.TFModelMagic {
    "value": Initialize=5640708251965505536
}

// =============================================================================
// WRITE HEADER
// =============================================================================
Function.TF_WriteHeader {
    Input: fd: Integer
    Output: Integer
    Body: {
        hdr = Allocate(64)
        // Magic
        StoreValue(hdr, TFModelMagic.value)
        // Config
        StoreValue(Add(hdr, 8),  TFConfig.DModel)
        StoreValue(Add(hdr, 16), TFConfig.SeqLen)
        StoreValue(Add(hdr, 24), TFConfig.VocabSize)
        StoreValue(Add(hdr, 32), TFConfig.NumHeads)
        StoreValue(Add(hdr, 40), TFConfig.DFF)
        // Param count
        vd  = Multiply(TFConfig.VocabSize, TFConfig.DModel)
        sd  = Multiply(TFConfig.SeqLen, TFConfig.DModel)
        dd  = Multiply(TFConfig.DModel, TFConfig.DModel)
        ffn = Multiply(TFConfig.DModel, TFConfig.DFF)
        tot = Add(Add(Add(Multiply(vd, 2), sd), Multiply(dd, 3)), Multiply(ffn, 2))
        StoreValue(Add(hdr, 48), tot)
        StoreValue(Add(hdr, 56), 0)
        // Write
        written = SystemCall(1, fd, hdr, 64)
        Deallocate(hdr, 64)
        ReturnValue(written)
    }
}

// =============================================================================
// READ + VERIFY HEADER
// Returns 1 on success, 0 on mismatch
// =============================================================================
Function.TF_ReadHeader {
    Input: fd: Integer
    Output: Integer
    Body: {
        hdr = Allocate(64)
        red = SystemCall(0, fd, hdr, 64)
        IfCondition NotEqual(red, 64) ThenBlock: {
            PrintMessage("[LOAD] Header read failed\n")
            Deallocate(hdr, 64)
            ReturnValue(0)
        }
        // Check magic
        magic = Dereference(hdr)
        IfCondition NotEqual(magic, TFModelMagic.value) ThenBlock: {
            PrintMessage("[LOAD] Bad magic number\n")
            Deallocate(hdr, 64)
            ReturnValue(0)
        }
        // Check config match
        ok = 1
        IfCondition NotEqual(Dereference(Add(hdr, 8)), TFConfig.DModel) ThenBlock: {
            PrintMessage("[LOAD] DModel mismatch\n")
            ok = 0
        }
        IfCondition NotEqual(Dereference(Add(hdr, 16)), TFConfig.SeqLen) ThenBlock: {
            PrintMessage("[LOAD] SeqLen mismatch\n")
            ok = 0
        }
        IfCondition NotEqual(Dereference(Add(hdr, 24)), TFConfig.VocabSize) ThenBlock: {
            PrintMessage("[LOAD] VocabSize mismatch\n")
            ok = 0
        }
        IfCondition NotEqual(Dereference(Add(hdr, 32)), TFConfig.NumHeads) ThenBlock: {
            PrintMessage("[LOAD] NumHeads mismatch\n")
            ok = 0
        }
        IfCondition NotEqual(Dereference(Add(hdr, 40)), TFConfig.DFF) ThenBlock: {
            PrintMessage("[LOAD] DFF mismatch\n")
            ok = 0
        }
        Deallocate(hdr, 64)
        ReturnValue(ok)
    }
}

// =============================================================================
// WRITE BUFFER — write raw bytes from a matrix/vector to fd
// =============================================================================
Function.TF_WriteBuffer {
    Input: fd: Integer
    Input: buf: Integer
    Input: elements: Integer
    Output: Integer
    Body: {
        size = Multiply(elements, TFElem.Size)
        written = SystemCall(1, fd, buf, size)
        ReturnValue(written)
    }
}

// =============================================================================
// READ BUFFER — read raw bytes into a matrix/vector from fd
// =============================================================================
Function.TF_ReadBuffer {
    Input: fd: Integer
    Input: buf: Integer
    Input: elements: Integer
    Output: Integer
    Body: {
        size = Multiply(elements, TFElem.Size)
        red = SystemCall(0, fd, buf, size)
        ReturnValue(red)
    }
}

// =============================================================================
// SAVE MODEL — write all float master weights to file
// Caller passes fd from open() syscall
// Order: Embed, PosEmb, Wq, Wk, Wv, Wout, W1, W2
// =============================================================================
Function.TF_SaveModel {
    Input: fd: Integer
    Input: fEmbed: Integer
    Input: fPosEmb: Integer
    Input: fWq: Integer
    Input: fWk: Integer
    Input: fWv: Integer
    Input: fWout: Integer
    Output: Integer
    Body: {
        TF_WriteHeader(fd)
        vd = Multiply(TFConfig.VocabSize, TFConfig.DModel)
        sd = Multiply(TFConfig.SeqLen, TFConfig.DModel)
        dd = Multiply(TFConfig.DModel, TFConfig.DModel)
        TF_WriteBuffer(fd, fEmbed,  vd)
        TF_WriteBuffer(fd, fPosEmb, sd)
        TF_WriteBuffer(fd, fWq,     dd)
        TF_WriteBuffer(fd, fWk,     dd)
        TF_WriteBuffer(fd, fWv,     dd)
        TF_WriteBuffer(fd, fWout,   vd)
        ReturnValue(1)
    }
}

// =============================================================================
// SKILL FILE METADATA
// =============================================================================
FixedPool.SkillInfo {
    "DModel":    Initialize=0
    "SeqLen":    Initialize=0
    "VocabSize": Initialize=0
    "NumHeads":  Initialize=0
    "DFF":       Initialize=0
    "Params":    Initialize=0
    "HasRC":     Initialize=0
}

// =============================================================================
// SKILL FILE: Write self-describing skill header
// =============================================================================
Function.TF_WriteSkillHeader {
    Input: fd: Integer
    Input: signature: Integer   // pointer to signature vector [32]
    Input: has_rule_cache: Integer
    Output: Integer
    Body: {
        hdr = Allocate(320)
        // Magic: "SKILL001"
        StoreValue(hdr, 6004626762498105427)
        // Config
        StoreValue(Add(hdr, 8),  TFConfig.DModel)
        StoreValue(Add(hdr, 16), TFConfig.SeqLen)
        StoreValue(Add(hdr, 24), TFConfig.VocabSize)
        StoreValue(Add(hdr, 32), TFConfig.NumHeads)
        StoreValue(Add(hdr, 40), TFConfig.DFF)
        // Param count
        vd  = Multiply(TFConfig.VocabSize, TFConfig.DModel)
        sd  = Multiply(TFConfig.SeqLen, TFConfig.DModel)
        dd  = Multiply(TFConfig.DModel, TFConfig.DModel)
        ffn = Multiply(TFConfig.DModel, TFConfig.DFF)
        tot = Add(Add(Add(Multiply(vd, 2), sd), Multiply(dd, 3)), Multiply(ffn, 2))
        IfCondition EqualTo(has_rule_cache, 1) ThenBlock: {
            tot = Add(tot, dd)
        }
        StoreValue(Add(hdr, 48), tot)
        StoreValue(Add(hdr, 56), has_rule_cache)
        // Signature: copy 32 values
        sig_i = 0
        WhileLoop LessThan(sig_i, 32) {
            sig_off = Add(64, Multiply(sig_i, 8))
            sig_val = TF_VecGet(signature, sig_i)
            StoreValue(Add(hdr, sig_off), sig_val)
            sig_i = Add(sig_i, 1)
        }
        // Write
        written = SystemCall(1, fd, hdr, 320)
        Deallocate(hdr, 320)
        ReturnValue(written)
    }
}

// =============================================================================
// SKILL FILE: Read skill header (returns 1 on valid magic, 0 otherwise)
// Populates a FixedPool with the config for inspection
// =============================================================================
Function.TF_ReadSkillHeader {
    Input: fd: Integer
    Input: signature_out: Integer   // pointer to write signature into [32]
    Output: Integer
    Body: {
        hdr = Allocate(320)
        red = SystemCall(0, fd, hdr, 320)
        IfCondition NotEqual(red, 320) ThenBlock: {
            Deallocate(hdr, 320)
            ReturnValue(0)
        }
        // Check magic
        magic = Dereference(hdr)
        IfCondition NotEqual(magic, 6004626762498105427) ThenBlock: {
            Deallocate(hdr, 320)
            ReturnValue(0)
        }
        // Read config into SkillInfo
        SkillInfo.DModel    = Dereference(Add(hdr, 8))
        SkillInfo.SeqLen    = Dereference(Add(hdr, 16))
        SkillInfo.VocabSize = Dereference(Add(hdr, 24))
        SkillInfo.NumHeads  = Dereference(Add(hdr, 32))
        SkillInfo.DFF       = Dereference(Add(hdr, 40))
        SkillInfo.Params    = Dereference(Add(hdr, 48))
        SkillInfo.HasRC     = Dereference(Add(hdr, 56))
        // Read signature
        sig_i = 0
        WhileLoop LessThan(sig_i, 32) {
            sig_off = Add(64, Multiply(sig_i, 8))
            TF_VecSet(signature_out, sig_i, Dereference(Add(hdr, sig_off)))
            sig_i = Add(sig_i, 1)
        }
        Deallocate(hdr, 320)
        ReturnValue(1)
    }
}

// =============================================================================
// SAVE MLP WEIGHTS — separate call since >6 args limit
// Call after TF_SaveModel
// =============================================================================
Function.TF_SaveMLP {
    Input: fd: Integer
    Input: fW1: Integer
    Input: fW2: Integer
    Output: Integer
    Body: {
        df = Multiply(TFConfig.DModel, TFConfig.DFF)
        fd2 = Multiply(TFConfig.DFF, TFConfig.DModel)
        TF_WriteBuffer(fd, fW1, df)
        TF_WriteBuffer(fd, fW2, fd2)
        ReturnValue(1)
    }
}

// =============================================================================
// LOAD MODEL — read all float master weights from file
// Returns 1 on success, 0 on failure
// =============================================================================
Function.TF_LoadModel {
    Input: fd: Integer
    Input: fEmbed: Integer
    Input: fPosEmb: Integer
    Input: fWq: Integer
    Input: fWk: Integer
    Input: fWv: Integer
    Input: fWout: Integer
    Output: Integer
    Body: {
        ok = TF_ReadHeader(fd)
        IfCondition EqualTo(ok, 0) ThenBlock: {
            ReturnValue(0)
        }
        vd = Multiply(TFConfig.VocabSize, TFConfig.DModel)
        sd = Multiply(TFConfig.SeqLen, TFConfig.DModel)
        dd = Multiply(TFConfig.DModel, TFConfig.DModel)
        TF_ReadBuffer(fd, fEmbed,  vd)
        TF_ReadBuffer(fd, fPosEmb, sd)
        TF_ReadBuffer(fd, fWq,     dd)
        TF_ReadBuffer(fd, fWk,     dd)
        TF_ReadBuffer(fd, fWv,     dd)
        TF_ReadBuffer(fd, fWout,   vd)
        ReturnValue(1)
    }
}

// =============================================================================
// LOAD MLP WEIGHTS — separate call since >6 args limit
// Call after TF_LoadModel
// =============================================================================
Function.TF_LoadMLP {
    Input: fd: Integer
    Input: fW1: Integer
    Input: fW2: Integer
    Output: Integer
    Body: {
        df = Multiply(TFConfig.DModel, TFConfig.DFF)
        fd2 = Multiply(TFConfig.DFF, TFConfig.DModel)
        TF_ReadBuffer(fd, fW1, df)
        TF_ReadBuffer(fd, fW2, fd2)
        ReturnValue(1)
    }
}