// Library.TF.Mat.ailang
// Matrix operations for the transformer stack.
// Mirrors NN11/MATOP — mat-vec multiply, transpose, init.
// Row-major layout, 8 bytes per element.
// Copyright © 2025 Sean Collins, 2 Paws Machine and Engineering. All rights reserved. SCSL.

LibraryImport.TF.Math
LibraryImport.TF.Vec
LibraryImport.Accel.HAL

// =============================================================================
// MATRIX-VECTOR MULTIPLY
// dst = mat * vec
// mat is [rows x cols], vec is [cols], dst is [rows]
// =============================================================================
Function.TF_MatVecMul {
    Input: dst:  Integer
    Input: mat:  Integer
    Input: vec:  Integer
    Input: rows: Integer
    Input: cols: Integer
    Body: {
        // HAL accelerator dispatch (hardware backends only, CPU skips this)
        IfCondition EqualTo(HALCfg.initialized, 1) ThenBlock: {
            IfCondition NotEqual(HALCfg.backend, 0) ThenBlock: {
                IfCondition GreaterEqual(rows, HALCfg.min_accel) ThenBlock: {
                    HALOp.op   = 1
                    HALOp.dst  = dst
                    HALOp.mat  = mat
                    HALOp.vec  = vec
                    HALOp.rows = rows
                    HALOp.cols = cols
                    hal_rc = HAL_Submit()
                    IfCondition EqualTo(hal_rc, 0) ThenBlock: {
                        ReturnValue(0)
                    }
                    // Fall through to CPU on error
                }
            }
        }

        // Thread pool dispatch: split rows across workers
        IfCondition EqualTo(ThrPool.initialized, 1) ThenBlock: {
            IfCondition GreaterEqual(rows, ThrPoolCfg.min_parallel) ThenBlock: {
                ThrPool.op   = 1
                ThrPool.dst  = dst
                ThrPool.mat  = mat
                ThrPool.vec  = vec
                ThrPool.rows = rows
                ThrPool.cols = cols
                ThrPool.total_items = rows
                tp_discard = ThrPool_Dispatch()
                ReturnValue(0)
            }
        }
        // Serial fallback
        row = 0
        WhileLoop LessThan(row, rows) {
            sum = 0
            col = 0
            WhileLoop LessThan(col, cols) {
                mv   = TF_MatGet(mat, row, col, cols)
                vv   = TF_VecGet(vec, col)
                prod = Multiply(mv, vv)
                sum  = Add(sum, prod)
                col  = Add(col, 1)
            }
            TF_VecSet(dst, row, sum)
            row = Add(row, 1)
        }
        ReturnValue(0)
    }
}

// =============================================================================
// TRANSPOSED MATRIX-VECTOR MULTIPLY
// dst = mat^T * vec
// mat is [rows x cols], vec is [rows], dst is [cols]
// =============================================================================
Function.TF_MatTVecMul {
    Input: dst:  Integer
    Input: mat:  Integer
    Input: vec:  Integer
    Input: rows: Integer
    Input: cols: Integer
    Body: {
        // HAL accelerator dispatch (hardware backends only, CPU skips this)
        IfCondition EqualTo(HALCfg.initialized, 1) ThenBlock: {
            IfCondition NotEqual(HALCfg.backend, 0) ThenBlock: {
                IfCondition GreaterEqual(cols, HALCfg.min_accel) ThenBlock: {
                    HALOp.op   = 2
                    HALOp.dst  = dst
                    HALOp.mat  = mat
                    HALOp.vec  = vec
                    HALOp.rows = rows
                    HALOp.cols = cols
                    hal_rc = HAL_Submit()
                    IfCondition EqualTo(hal_rc, 0) ThenBlock: {
                        ReturnValue(0)
                    }
                }
            }
        }

        // Thread pool dispatch: split output cols across workers
        IfCondition EqualTo(ThrPool.initialized, 1) ThenBlock: {
            IfCondition GreaterEqual(cols, ThrPoolCfg.min_parallel) ThenBlock: {
                ThrPool.op   = 2
                ThrPool.dst  = dst
                ThrPool.mat  = mat
                ThrPool.vec  = vec
                ThrPool.rows = rows
                ThrPool.cols = cols
                ThrPool.total_items = cols
                tp_discard = ThrPool_Dispatch()
                ReturnValue(0)
            }
        }
        // Serial fallback
        col = 0
        WhileLoop LessThan(col, cols) {
            sum = 0
            row = 0
            WhileLoop LessThan(row, rows) {
                mv   = TF_MatGet(mat, row, col, cols)
                vv   = TF_VecGet(vec, row)
                prod = Multiply(mv, vv)
                sum  = Add(sum, prod)
                row  = Add(row, 1)
            }
            TF_VecSet(dst, col, sum)
            col = Add(col, 1)
        }
        ReturnValue(0)
    }
}

// =============================================================================
// OUTER PRODUCT ACCUMULATE
// grad[row][col] += a[row] * b[col]
// =============================================================================
Function.TF_OuterAccum {
    Input: grad: Integer
    Input: avec: Integer
    Input: bvec: Integer
    Input: rows: Integer
    Input: cols: Integer
    Body: {
        // HAL accelerator dispatch (hardware backends only, CPU skips this)
        IfCondition EqualTo(HALCfg.initialized, 1) ThenBlock: {
            IfCondition NotEqual(HALCfg.backend, 0) ThenBlock: {
                IfCondition GreaterEqual(rows, HALCfg.min_accel) ThenBlock: {
                    HALOp.op   = 3
                    HALOp.dst  = grad
                    HALOp.mat  = grad
                    HALOp.vec  = avec
                    HALOp.vec2 = bvec
                    HALOp.rows = rows
                    HALOp.cols = cols
                    hal_rc = HAL_Submit()
                    IfCondition EqualTo(hal_rc, 0) ThenBlock: {
                        ReturnValue(0)
                    }
                }
            }
        }

        // Thread pool dispatch: split rows across workers
        IfCondition EqualTo(ThrPool.initialized, 1) ThenBlock: {
            IfCondition GreaterEqual(rows, ThrPoolCfg.min_parallel) ThenBlock: {
                ThrPool.op   = 3
                ThrPool.dst  = grad
                ThrPool.mat  = grad
                ThrPool.vec  = avec
                ThrPool.vec2 = bvec
                ThrPool.rows = rows
                ThrPool.cols = cols
                ThrPool.total_items = rows
                tp_discard = ThrPool_Dispatch()
                ReturnValue(0)
            }
        }
        // Serial fallback
        row = 0
        WhileLoop LessThan(row, rows) {
            av  = TF_VecGet(avec, row)
            col = 0
            WhileLoop LessThan(col, cols) {
                bv   = TF_VecGet(bvec, col)
                old  = TF_MatGet(grad, row, col, cols)
                prod = Multiply(av, bv)
                nuw  = Add(old, prod)
                TF_MatSet(grad, row, col, cols, nuw)
                col  = Add(col, 1)
            }
            row = Add(row, 1)
        }
        ReturnValue(0)
    }
}

// =============================================================================
// MATRIX ZERO
// =============================================================================
Function.TF_MatZero {
    Input: mat:  Integer
    Input: rows: Integer
    Input: cols: Integer
    Body: {
        total = Multiply(Multiply(rows, cols), TFElem.Size)
        MemorySet(mat, 0, total)
        ReturnValue(0)
    }
}

// =============================================================================
// MATRIX RAND INIT
// =============================================================================
Function.TF_MatRandInit {
    Input: mat:   Integer
    Input: rows:  Integer
    Input: cols:  Integer
    Input: range: Integer
    Body: {
        ri_total  = Multiply(rows, cols)
        ri_drange = Multiply(range, 2)

        ri_i = 0
        WhileLoop LessThan(ri_i, ri_total) {
            // Inline RNG
            ri_s = TFRand.seed
            ri_s = Add(Multiply(ri_s, 1664525), 1013904223)
            ri_s = BitwiseAnd(ri_s, 2147483647)
            TFRand.seed = ri_s

            ri_shifted = Divide(ri_s, 65536)
            ri_rmod = Modulo(ri_shifted, ri_drange)
            ri_rval = Subtract(ri_rmod, range)
            ri_off  = Multiply(TFElem.Size, ri_i)
            ri_adr  = Add(mat, ri_off)
            StoreValue(ri_adr, ri_rval)
            ri_i = Add(ri_i, 1)
        }
        ReturnValue(0)
    }
}

// =============================================================================
// MATRIX COPY
// =============================================================================
Function.TF_MatCopy {
    Input: dst:  Integer
    Input: src:  Integer
    Input: rows: Integer
    Input: cols: Integer
    Body: {
        rc    = Multiply(rows, cols)
        total = Multiply(rc, TFElem.Size)
        i = 0
        WhileLoop LessThan(i, total) {
            byt = GetByte(src, i)
            SetByte(dst, i, byt)
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

// =============================================================================
// SGD UPDATE
// w[i][j] -= lr_num * grad[i][j] / lr_den
// =============================================================================
Function.TF_MatSGD {
    Input: weights: Integer
    Input: grads:   Integer
    Input: rows:    Integer
    Input: cols:    Integer
    Input: lr_num:  Integer
    Input: lr_den:  Integer
    Body: {
        total = Multiply(rows, cols)
        i     = 0
        WhileLoop LessThan(i, total) {
            off   = Multiply(TFElem.Size, i)
            wptr  = Add(weights, off)
            gptr  = Add(grads,   off)
            w     = Dereference(wptr)
            g     = Dereference(gptr)
            num   = Multiply(g, lr_num)
            delta = Divide(num, lr_den)
            nuw   = Subtract(w, delta)
            StoreValue(wptr, nuw)
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

// =============================================================================
// WEIGHT DECAY
// grad[i] += weight[i] * scale
// Adds a fraction of the Q8 integer weight to the gradient accumulator.
// =============================================================================
Function.TF_MatAddDecay {
    Input: grad:   Integer
    Input: weight: Integer
    Input: len:    Integer
    Input: scale:  Integer
    Body: {
        i = 0
        WhileLoop LessThan(i, len) {
            off = Multiply(TFElem.Size, i)
            g_adr = Add(grad, off)
            w_adr = Add(weight, off)
            g_val = Dereference(g_adr)
            w_val = Dereference(w_adr)
            decay = Multiply(w_val, scale)
            StoreValue(g_adr, Add(g_val, decay))
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}