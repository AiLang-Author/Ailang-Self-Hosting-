// Library.TF.Math.ailang
// Scalar math primitives for the transformer stack.
// No dependencies. No imports. Pure arithmetic.
// Mirrors NN11/FXMATH — the bottom of the stack.
// Copyright © 2025 Sean Collins, 2 Paws Machine and Engineering. All rights reserved. SCSL.

// =============================================================================
// HYPERPARAMETERS
// Match ATTN/11: D=16 SEQ=8 V=10
// Change these to generalize.
// =============================================================================
FixedPool.TFConfig {
    "DModel":   Initialize=32
    "SeqLen":   Initialize=32
    "VocabSize":Initialize=10
    "NumHeads": Initialize=4
    "LR_Attn":  Initialize=1
    "LR_Embed": Initialize=1
    "LR_Out":   Initialize=1
  "LR_Scale": Initialize=300000
"MaxSteps": Initialize=3000
    "LogEvery": Initialize=100
}

// =============================================================================
// MATRIX LAYOUT HELPERS
// All matrices are flat row-major buffers, 8 bytes per element.
// Element [row][col] in a matrix of width W:
//   addr = base + (row * W + col) * 8
// =============================================================================
FixedPool.TFElem {
    "Size": Initialize=8    // bytes per element
}

// Compute byte offset for element [row][col] in matrix of width W
Function.TF_Offset {
    Input:  row: Integer
    Input:  col: Integer
    Input:  width: Integer
    Output: Integer
    Body: {
        idx = Add(Multiply(row, width), col)
        ReturnValue(Multiply(TFElem.Size, idx))
    }
}

// Allocate a zero-filled matrix of rows x cols
Function.TF_MatAlloc {
    Input:  rows: Integer
    Input:  cols: Integer
    Output: Integer
    Body: {
        rc    = Multiply(rows, cols)
        total = Multiply(rc, TFElem.Size)
        buf   = Allocate(total)
        DebugAssert(NotEqual(buf, 0), "TF_MatAlloc: Allocate returned null")
        i = 0
        WhileLoop LessThan(i, total) {
            SetByte(buf, i, 0)
            i = Add(i, 1)
        }
        ReturnValue(buf)
    }
}

// Free a matrix
Function.TF_MatFree {
    Input: buf:  Integer
    Input: rows: Integer
    Input: cols: Integer
    Body: {
        rc    = Multiply(rows, cols)
        total = Multiply(rc, TFElem.Size)
        Deallocate(buf, total)
        ReturnValue(0)
    }
}

// Get element [row][col] from matrix of width W
Function.TF_MatGet {
    Input:  mat:   Integer
    Input:  row:   Integer
    Input:  col:   Integer
    Input:  width: Integer
    Output: Integer
    Body: {
        off = TF_Offset(row, col, width)
        ReturnValue(Dereference(Add(mat, off)))
    }
}

// Set element [row][col] in matrix of width W
Function.TF_MatSet {
    Input: mat:   Integer
    Input: row:   Integer
    Input: col:   Integer
    Input: width: Integer
    Input: val:   Integer
    Body: {
        off = TF_Offset(row, col, width)
        StoreValue(Add(mat, off), val)
        ReturnValue(0)
    }
}

// =============================================================================
// SCALAR HELPERS
// =============================================================================

// Clamp val to [lo, hi]
Function.TF_Clamp {
    Input:  val: Integer
    Input:  lo:  Integer
    Input:  hi:  Integer
    Output: Integer
    Body: {
        result = val
        IfCondition LessThan(val, lo) ThenBlock: { result = lo }
        IfCondition GreaterThan(val, hi) ThenBlock: { result = hi }
        ReturnValue(result)
    }
}

// Absolute value
Function.TF_Abs {
    Input:  val: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(val, 0) ThenBlock: {
            ReturnValue(Subtract(0, val))
        }
        ReturnValue(val)
    }
}

// Integer square root (Newton's method) — used for attention scaling
Function.TF_ISqrt {
    Input:  n: Integer
    Output: Integer
    Body: {
        IfCondition LessEqual(n, 0) ThenBlock: { ReturnValue(0) }
        x = n
        y = Add(Divide(n, 2), 1)
        WhileLoop LessThan(y, x) {
            x = y
            y = Divide(Add(Divide(n, y), y), 2)
        }
        ReturnValue(x)
    }
}

// Simple LCG random for data generation
// Uses FixedPool. prefix for writes to work in Functions
FixedPool.TFRand {
    "seed": Initialize=12345, CanChange=True
}

Function.TF_RandNext {
    Output: Integer
    Body: {
        current_state = TFRand.seed
        multiplied = Multiply(current_state, 1664525)
        added = Add(multiplied, 1013904223)
        masked = BitwiseAnd(added, 2147483647)
        TFRand.seed = masked
        ReturnValue(masked)
    }
}

// =============================================================================
// Q16 FLOAT MASTER ↔ Q8 INTEGER CONVERSION
// =============================================================================

// Copy integer buffer to float buffer (for init: int weights → float masters)
Function.TF_IntToFloat {
    Input: dst: Integer
    Input: src: Integer
    Input: count: Integer
    Body: {
        i = 0
        WhileLoop LessThan(i, count) {
            off = Multiply(TFElem.Size, i)
            ival = Dereference(Add(src, off))
            fval = Float_FromInt(ival)
            StoreValue(Add(dst, off), fval)
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

// Convert float master buffer to integer Q8 working copy (for forward pass)
Function.TF_FloatToQ8 {
    Input: dst: Integer
    Input: src: Integer
    Input: count: Integer
    Body: {
        i = 0
        WhileLoop LessThan(i, count) {
            off = Multiply(TFElem.Size, i)
            fval = Dereference(Add(src, off))
            ival = Float_Round(fval)
            StoreValue(Add(dst, off), ival)
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

// Random integer in [0, n) - uses high bits for better distribution
Function.TF_RandMod {
    Input:  n: Integer
    Output: Integer
    Body: {
        raw = TF_RandNext()
        shifted = Divide(raw, 65536)
        ReturnValue(Modulo(shifted, n))
    }
}