// Library.TF.Vec.ailang
// Vector operations for the transformer stack.
// Mirrors NN11/VECOP — dot product, scale, add, copy.
// All vectors are flat buffers, 8 bytes per element.
// Copyright © 2025 Sean Collins, 2 Paws Machine and Engineering. All rights reserved. SCSL.

LibraryImport.TF.Math

// =============================================================================
// VECTOR ALLOCATION
// =============================================================================

Function.TF_VecAlloc {
    Input:  len: Integer
    Output: Integer
    Body: {
        ReturnValue(TF_MatAlloc(1, len))
    }
}

Function.TF_VecFree {
    Input: buf: Integer
    Input: len: Integer
    Body: {
        TF_MatFree(buf, 1, len)
        ReturnValue(0)
    }
}

Function.TF_VecGet {
    Input:  vec: Integer
    Input:  idx: Integer
    Output: Integer
    Body: {
        off = Multiply(TFElem.Size, idx)
        adr = Add(vec, off)
        ReturnValue(Dereference(adr))
    }
}

Function.TF_VecSet {
    Input: vec: Integer
    Input: idx: Integer
    Input: val: Integer
    Body: {
        off = Multiply(TFElem.Size, idx)
        adr = Add(vec, off)
        StoreValue(adr, val)
        ReturnValue(0)
    }
}

// =============================================================================
// CORE VECTOR OPS
// =============================================================================

// Dot product: sum(a[i] * b[i]) for i in [0, len)
Function.TF_VecDot {
    Input:  avec: Integer
    Input:  bvec: Integer
    Input:  len:  Integer
    Output: Integer
    Body: {
        sum = 0
        end = Multiply(len, 8)
        off = 0
        WhileLoop LessThan(off, end) {
            sum = Add(sum, Multiply(Dereference(Add(avec, off)), Dereference(Add(bvec, off))))
            off = Add(off, 8)
        }
        ReturnValue(sum)
    }
}

// =============================================================================
// MULTI-HEAD ATTENTION HELPERS
// =============================================================================

// Dot product with offset: sum(a[i+off] * b[i+off]) for i in [0, len)
// Allows computing attention scores for a specific head slice.
Function.TF_VecDotOffset {
    Input:  avec:   Integer
    Input:  bvec:   Integer
    Input:  offset: Integer
    Input:  len:    Integer
    Output: Integer
    Body: {
        sum = 0
        base = Multiply(offset, 8)
        end  = Add(base, Multiply(len, 8))
        off  = base
        WhileLoop LessThan(off, end) {
            sum = Add(sum, Multiply(Dereference(Add(avec, off)), Dereference(Add(bvec, off))))
            off = Add(off, 8)
        }
        ReturnValue(sum)
    }
}

// Element-wise add: dst[i] = a[i] + b[i]
Function.TF_VecAdd {
    Input: dst: Integer
    Input: av:  Integer
    Input: bv:  Integer
    Input: len: Integer
    Body: {
        end = Multiply(len, 8)
        off = 0
        WhileLoop LessThan(off, end) {
            StoreValue(Add(dst, off), Add(Dereference(Add(av, off)), Dereference(Add(bv, off))))
            off = Add(off, 8)
        }
        ReturnValue(0)
    }
}

// Element-wise subtract: dst[i] = a[i] - b[i]
Function.TF_VecSub {
    Input: dst: Integer
    Input: av:  Integer
    Input: bv:  Integer
    Input: len: Integer
    Body: {
        end = Multiply(len, 8)
        off = 0
        WhileLoop LessThan(off, end) {
            StoreValue(Add(dst, off), Subtract(Dereference(Add(av, off)), Dereference(Add(bv, off))))
            off = Add(off, 8)
        }
        ReturnValue(0)
    }
}

// Scale: dst[i] = vec[i] * scalar / divisor
Function.TF_VecScale {
    Input: dst:     Integer
    Input: vec:     Integer
    Input: scalar:  Integer
    Input: divisor: Integer
    Input: len:     Integer
    Body: {
        end = Multiply(len, 8)
        off = 0
        WhileLoop LessThan(off, end) {
            StoreValue(Add(dst, off), Divide(Multiply(Dereference(Add(vec, off)), scalar), divisor))
            off = Add(off, 8)
        }
        ReturnValue(0)
    }
}

// Copy: dst[i] = src[i]
Function.TF_VecCopy {
    Input: dst: Integer
    Input: src: Integer
    Input: len: Integer
    Body: {
        MemoryCopy(dst, src, Multiply(len, 8))
        ReturnValue(0)
    }
}

// Zero: dst[i] = 0
Function.TF_VecZero {
    Input: vec: Integer
    Input: len: Integer
    Body: {
        MemorySet(vec, 0, Multiply(len, 8))
        ReturnValue(0)
    }
}

// Accumulate: dst[i] += src[i]
Function.TF_VecAccum {
    Input: dst: Integer
    Input: src: Integer
    Input: len: Integer
    Body: {
        end = Multiply(len, 8)
        off = 0
        WhileLoop LessThan(off, end) {
            da = Add(dst, off)
            StoreValue(da, Add(Dereference(da), Dereference(Add(src, off))))
            off = Add(off, 8)
        }
        ReturnValue(0)
    }
}

// ArgMax: return index of largest element
Function.TF_VecArgMax {
    Input:  vec: Integer
    Input:  len: Integer
    Output: Integer
    Body: {
        best_idx = 0
        best_val = Dereference(vec)
        off = 8
        idx = 1
        WhileLoop LessThan(idx, len) {
            v = Dereference(Add(vec, off))
            IfCondition GreaterThan(v, best_val) ThenBlock: {
                best_val = v
                best_idx = idx
            }
            off = Add(off, 8)
            idx = Add(idx, 1)
        }
        ReturnValue(best_idx)
    }
}

// Sum of all elements
Function.TF_VecSum {
    Input:  vec: Integer
    Input:  len: Integer
    Output: Integer
    Body: {
        sum = 0
        end = Multiply(len, 8)
        off = 0
        WhileLoop LessThan(off, end) {
            sum = Add(sum, Dereference(Add(vec, off)))
            off = Add(off, 8)
        }
        ReturnValue(sum)
    }
}

// Max of all elements
Function.TF_VecMax {
    Input:  vec: Integer
    Input:  len: Integer
    Output: Integer
    Body: {
        best = Dereference(vec)
        end  = Multiply(len, 8)
        off  = 8
        WhileLoop LessThan(off, end) {
            v = Dereference(Add(vec, off))
            IfCondition GreaterThan(v, best) ThenBlock: {
                best = v
            }
            off = Add(off, 8)
        }
        ReturnValue(best)
    }
}