// Library.TF.Vec.ailang
// Vector operations for the transformer stack.
// Mirrors NN11/VECOP — dot product, scale, add, copy.
// All vectors are flat buffers, 8 bytes per element.
// Copyright © 2025 Sean Collins, 2 Paws Machine and Engineering. All rights reserved. SCSL.

LibraryImport.TF.Math

// =============================================================================
// VECTOR ALLOCATION
// =============================================================================

Function.TF_VecAlloc {
    Input:  len: Integer
    Output: Integer
    Body: {
        ReturnValue(TF_MatAlloc(1, len))
    }
}

Function.TF_VecFree {
    Input: buf: Integer
    Input: len: Integer
    Body: {
        TF_MatFree(buf, 1, len)
        ReturnValue(0)
    }
}

Function.TF_VecGet {
    Input:  vec: Integer
    Input:  idx: Integer
    Output: Integer
    Body: {
        off = Multiply(TFElem.Size, idx)
        adr = Add(vec, off)
        ReturnValue(Dereference(adr))
    }
}

Function.TF_VecSet {
    Input: vec: Integer
    Input: idx: Integer
    Input: val: Integer
    Body: {
        off = Multiply(TFElem.Size, idx)
        adr = Add(vec, off)
        StoreValue(adr, val)
        ReturnValue(0)
    }
}

// =============================================================================
// CORE VECTOR OPS
// =============================================================================

// Dot product: sum(a[i] * b[i]) for i in [0, len)
Function.TF_VecDot {
    Input:  avec: Integer
    Input:  bvec: Integer
    Input:  len:  Integer
    Output: Integer
    Body: {
        sum = 0
        i   = 0
        WhileLoop LessThan(i, len) {
            av  = TF_VecGet(avec, i)
            bv  = TF_VecGet(bvec, i)
            prod = Multiply(av, bv)
            sum = Add(sum, prod)
            i   = Add(i, 1)
        }
        ReturnValue(sum)
    }
}

// =============================================================================
// MULTI-HEAD ATTENTION HELPERS
// =============================================================================

// Dot product with offset: sum(a[i+off] * b[i+off]) for i in [0, len)
// Allows computing attention scores for a specific head slice.
Function.TF_VecDotOffset {
    Input:  avec:   Integer
    Input:  bvec:   Integer
    Input:  offset: Integer
    Input:  len:    Integer
    Output: Integer
    Body: {
        sum = 0
        i = 0
        WhileLoop LessThan(i, len) {
            idx = Add(i, offset)
            av = TF_VecGet(avec, idx)
            bv = TF_VecGet(bvec, idx)
            sum = Add(sum, Multiply(av, bv))
            i = Add(i, 1)
        }
        ReturnValue(sum)
    }
}

// Element-wise add: dst[i] = a[i] + b[i]
Function.TF_VecAdd {
    Input: dst: Integer
    Input: av:  Integer
    Input: bv:  Integer
    Input: len: Integer
    Body: {
        i = 0
        WhileLoop LessThan(i, len) {
            va  = TF_VecGet(av, i)
            vb  = TF_VecGet(bv, i)
            res = Add(va, vb)
            TF_VecSet(dst, i, res)
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

// Element-wise subtract: dst[i] = a[i] - b[i]
Function.TF_VecSub {
    Input: dst: Integer
    Input: av:  Integer
    Input: bv:  Integer
    Input: len: Integer
    Body: {
        i = 0
        WhileLoop LessThan(i, len) {
            va  = TF_VecGet(av, i)
            vb  = TF_VecGet(bv, i)
            res = Subtract(va, vb)
            TF_VecSet(dst, i, res)
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

// Scale: dst[i] = vec[i] * scalar / divisor
Function.TF_VecScale {
    Input: dst:     Integer
    Input: vec:     Integer
    Input: scalar:  Integer
    Input: divisor: Integer
    Input: len:     Integer
    Body: {
        i = 0
        WhileLoop LessThan(i, len) {
            v   = TF_VecGet(vec, i)
            num = Multiply(v, scalar)
            res = Divide(num, divisor)
            TF_VecSet(dst, i, res)
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

// Copy: dst[i] = src[i]
Function.TF_VecCopy {
    Input: dst: Integer
    Input: src: Integer
    Input: len: Integer
    Body: {
        i = 0
        WhileLoop LessThan(i, len) {
            val = TF_VecGet(src, i)
            TF_VecSet(dst, i, val)
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

// Zero: dst[i] = 0
Function.TF_VecZero {
    Input: vec: Integer
    Input: len: Integer
    Body: {
        i = 0
        WhileLoop LessThan(i, len) {
            TF_VecSet(vec, i, 0)
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

// Accumulate: dst[i] += src[i]
Function.TF_VecAccum {
    Input: dst: Integer
    Input: src: Integer
    Input: len: Integer
    Body: {
        i = 0
        WhileLoop LessThan(i, len) {
            old = TF_VecGet(dst, i)
            nuw = TF_VecGet(src, i)
            res = Add(old, nuw)
            TF_VecSet(dst, i, res)
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

// ArgMax: return index of largest element
Function.TF_VecArgMax {
    Input:  vec: Integer
    Input:  len: Integer
    Output: Integer
    Body: {
        best_idx = 0
        best_val = TF_VecGet(vec, 0)
        i = 1
        WhileLoop LessThan(i, len) {
            v = TF_VecGet(vec, i)
            IfCondition GreaterThan(v, best_val) ThenBlock: {
                best_val = v
                best_idx = i
            }
            i = Add(i, 1)
        }
        ReturnValue(best_idx)
    }
}

// Sum of all elements
Function.TF_VecSum {
    Input:  vec: Integer
    Input:  len: Integer
    Output: Integer
    Body: {
        sum = 0
        i   = 0
        WhileLoop LessThan(i, len) {
            val = TF_VecGet(vec, i)
            sum = Add(sum, val)
            i   = Add(i, 1)
        }
        ReturnValue(sum)
    }
}

// Max of all elements
Function.TF_VecMax {
    Input:  vec: Integer
    Input:  len: Integer
    Output: Integer
    Body: {
        best = TF_VecGet(vec, 0)
        i    = 1
        WhileLoop LessThan(i, len) {
            v = TF_VecGet(vec, i)
            IfCondition GreaterThan(v, best) ThenBlock: {
                best = v
            }
            i = Add(i, 1)
        }
        ReturnValue(best)
    }
}