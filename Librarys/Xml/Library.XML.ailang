// XML v1 — well-formed subset for Ailang.
// Elements, attributes, text, comments, PI, empty tags. No namespaces/DTD/CDATA.
//
// Node index 0 = none. Root is 1+.
//   XML.Parse(buf, len) → root
//   XML.Child(node, "title") / XML.Attr(node, "uniqueid") / XML.Text(node)
//
// Copyright (c) 2025-2026 Sean Collins, 2 Paws Machine and Engineering. All rights reserved.
// Licensed under the Sean Collins Software License (SCSL v1.0).

LibraryImport.Arena

FixedPool.XML_State {
    "data":     Initialize=0, CanChange=True
    "size":     Initialize=0, CanChange=True
    "pos":      Initialize=0, CanChange=True
    "nodes":    Initialize=0, CanChange=True
    "n_nodes":  Initialize=0, CanChange=True
    "node_cap": Initialize=0, CanChange=True
    "attrs":    Initialize=0, CanChange=True
    "n_attrs":  Initialize=0, CanChange=True
    "attr_cap": Initialize=0, CanChange=True
    "str":      Initialize=0, CanChange=True
    "str_n":    Initialize=0, CanChange=True
    "str_cap":  Initialize=0, CanChange=True
    "stack":    Initialize=0, CanChange=True
    "sp":       Initialize=0, CanChange=True
    "root":     Initialize=0, CanChange=True
    "err":      Initialize=0, CanChange=True
}

// node words (8): type, name_off, name_len, first_attr, first_child, next_sib, parent, last_child
// attr words (5): name_off, name_len, val_off, val_len, next_attr
// type: 1=elem 2=text

FixedPool.XML_Tmp {
    "ch":       Initialize=0, CanChange=True
    "n":        Initialize=0, CanChange=True
    "i":        Initialize=0, CanChange=True
    "off":      Initialize=0, CanChange=True
    "len":      Initialize=0, CanChange=True
    "q":        Initialize=0, CanChange=True
    "node":     Initialize=0, CanChange=True
    "parent":   Initialize=0, CanChange=True
    "selfc":    Initialize=0, CanChange=True
    "close":    Initialize=0, CanChange=True
    "anoff":    Initialize=0, CanChange=True
    "anlen":    Initialize=0, CanChange=True
    "avoff":    Initialize=0, CanChange=True
    "avlen":    Initialize=0, CanChange=True
    "attr":     Initialize=0, CanChange=True
    "prev":     Initialize=0, CanChange=True
}

Function.XML.NWLoad {
    Input: idx: Integer
    Input: field: Integer
    Output: Integer
    Body: {
        addr = Add(XML_State.nodes, Add(Multiply(idx, 64), Multiply(field, 8)))
        ReturnValue(Dereference(addr))
    }
}

Function.XML.NWStore {
    Input: idx: Integer
    Input: field: Integer
    Input: val: Integer
    Output: Integer
    Body: {
        addr = Add(XML_State.nodes, Add(Multiply(idx, 64), Multiply(field, 8)))
        StoreValue(addr, val)
        ReturnValue(0)
    }
}

Function.XML.AWLoad {
    Input: idx: Integer
    Input: field: Integer
    Output: Integer
    Body: {
        addr = Add(XML_State.attrs, Add(Multiply(idx, 40), Multiply(field, 8)))
        ReturnValue(Dereference(addr))
    }
}

Function.XML.AWStore {
    Input: idx: Integer
    Input: field: Integer
    Input: val: Integer
    Output: Integer
    Body: {
        addr = Add(XML_State.attrs, Add(Multiply(idx, 40), Multiply(field, 8)))
        StoreValue(addr, val)
        ReturnValue(0)
    }
}

Function.XML.Init {
    Output: Integer
    Body: {
        IfCondition EqualTo(XML_State.nodes, 0) ThenBlock: {
            XML_State.node_cap = 2048
            XML_State.nodes = Allocate(131072)
            XML_State.attr_cap = 4096
            XML_State.attrs = Allocate(163840)
            XML_State.str_cap = 131072
            XML_State.str = Allocate(131072)
            XML_State.stack = Allocate(256)
        }
        IfCondition EqualTo(XML_State.nodes, 0) ThenBlock: { ReturnValue(-1) }
        XML_State.n_nodes = 0
        XML_State.n_attrs = 0
        XML_State.str_n = 1
        SetByte(XML_State.str, 0, 0)
        XML_State.sp = 0
        XML_State.root = 0
        XML_State.err = 0
        XML_State.pos = 0
        ReturnValue(0)
    }
}

Function.XML.Intern {
    Input: src: Address
    Input: len: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(len, 0) ThenBlock: { ReturnValue(0) }
        need = Add(XML_State.str_n, Add(len, 1))
        IfCondition GreaterEqual(need, XML_State.str_cap) ThenBlock: { ReturnValue(0) }
        off = XML_State.str_n
        dst = Add(XML_State.str, off)
        i = 0
        WhileLoop LessThan(i, len) {
            SetByte(dst, i, GetByte(src, i))
            i = Add(i, 1)
        }
        SetByte(dst, len, 0)
        XML_State.str_n = Add(off, Add(len, 1))
        ReturnValue(off)
    }
}

Function.XML.StrPtr {
    Input: off: Integer
    Output: Address
    Body: {
        ReturnValue(Add(XML_State.str, off))
    }
}

Function.XML.Peek {
    Output: Integer
    Body: {
        IfCondition GreaterEqual(XML_State.pos, XML_State.size) ThenBlock: { ReturnValue(-1) }
        ReturnValue(GetByte(XML_State.data, XML_State.pos))
    }
}

Function.XML.Get {
    Output: Integer
    Body: {
        IfCondition GreaterEqual(XML_State.pos, XML_State.size) ThenBlock: { ReturnValue(-1) }
        c = GetByte(XML_State.data, XML_State.pos)
        XML_State.pos = Add(XML_State.pos, 1)
        ReturnValue(c)
    }
}

Function.XML.IsWS {
    Input: c: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(c, 32) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(c, 9) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(c, 10) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(c, 13) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

Function.XML.SkipWS {
    Output: Integer
    Body: {
        more = 1
        WhileLoop EqualTo(more, 1) {
            c = XML.Peek()
            IfCondition EqualTo(c, -1) ThenBlock: { more = 0 }
            IfCondition EqualTo(more, 1) ThenBlock: {
                IfCondition EqualTo(XML.IsWS(c), 1) ThenBlock: {
                    XML_State.pos = Add(XML_State.pos, 1)
                }
                IfCondition EqualTo(XML.IsWS(c), 0) ThenBlock: { more = 0 }
            }
        }
        ReturnValue(0)
    }
}

Function.XML.SkipUntil {
    Input: a: Integer
    Input: b: Integer
    Output: Integer
    Body: {
        WhileLoop LessThan(XML_State.pos, XML_State.size) {
            c0 = GetByte(XML_State.data, XML_State.pos)
            IfCondition EqualTo(c0, a) ThenBlock: {
                IfCondition EqualTo(b, 0) ThenBlock: {
                    XML_State.pos = Add(XML_State.pos, 1)
                    ReturnValue(0)
                }
                IfCondition LessThan(Add(XML_State.pos, 1), XML_State.size) ThenBlock: {
                    c1 = GetByte(XML_State.data, Add(XML_State.pos, 1))
                    IfCondition EqualTo(c1, b) ThenBlock: {
                        XML_State.pos = Add(XML_State.pos, 2)
                        ReturnValue(0)
                    }
                }
            }
            XML_State.pos = Add(XML_State.pos, 1)
        }
        ReturnValue(-1)
    }
}

Function.XML.NewNode {
    Input: typ: Integer
    Output: Integer
    Body: {
        idx = Add(XML_State.n_nodes, 1)
        IfCondition GreaterEqual(idx, XML_State.node_cap) ThenBlock: {
            XML_State.err = 1
            ReturnValue(0)
        }
        XML_State.n_nodes = idx
        XML.NWStore(idx, 0, typ)
        XML.NWStore(idx, 1, 0)
        XML.NWStore(idx, 2, 0)
        XML.NWStore(idx, 3, 0)
        XML.NWStore(idx, 4, 0)
        XML.NWStore(idx, 5, 0)
        XML.NWStore(idx, 6, 0)
        XML.NWStore(idx, 7, 0)
        ReturnValue(idx)
    }
}

Function.XML.AppendChild {
    Input: parent: Integer
    Input: child: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(parent, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(child, 0) ThenBlock: { ReturnValue(0) }
        XML.NWStore(child, 6, parent)
        last = XML.NWLoad(parent, 7)
        IfCondition EqualTo(last, 0) ThenBlock: {
            XML.NWStore(parent, 4, child)
            XML.NWStore(parent, 7, child)
            ReturnValue(0)
        }
        XML.NWStore(last, 5, child)
        XML.NWStore(parent, 7, child)
        ReturnValue(0)
    }
}

Function.XML.ReadName {
    Output: Integer
    Body: {
        start = XML_State.pos
        more = 1
        WhileLoop EqualTo(more, 1) {
            c = XML.Peek()
            IfCondition EqualTo(c, -1) ThenBlock: { more = 0 }
            IfCondition EqualTo(more, 1) ThenBlock: {
                stop = 0
                IfCondition EqualTo(XML.IsWS(c), 1) ThenBlock: { stop = 1 }
                IfCondition EqualTo(c, 62) ThenBlock: { stop = 1 }
                IfCondition EqualTo(c, 47) ThenBlock: { stop = 1 }
                IfCondition EqualTo(c, 61) ThenBlock: { stop = 1 }
                IfCondition EqualTo(stop, 1) ThenBlock: { more = 0 }
                IfCondition EqualTo(stop, 0) ThenBlock: {
                    XML_State.pos = Add(XML_State.pos, 1)
                }
            }
        }
        XML_Tmp.len = Subtract(XML_State.pos, start)
        XML_Tmp.off = XML.Intern(Add(XML_State.data, start), XML_Tmp.len)
        ReturnValue(XML_Tmp.off)
    }
}

Function.XML.ReadQuoted {
    Output: Integer
    Body: {
        q = XML.Get()
        start = XML_State.pos
        more = 1
        WhileLoop EqualTo(more, 1) {
            c = XML.Peek()
            IfCondition EqualTo(c, -1) ThenBlock: { more = 0 }
            IfCondition EqualTo(c, q) ThenBlock: { more = 0 }
            IfCondition EqualTo(more, 1) ThenBlock: {
                XML_State.pos = Add(XML_State.pos, 1)
            }
        }
        XML_Tmp.avlen = Subtract(XML_State.pos, start)
        XML_Tmp.avoff = XML.Intern(Add(XML_State.data, start), XML_Tmp.avlen)
        IfCondition EqualTo(XML.Peek(), q) ThenBlock: {
            XML_State.pos = Add(XML_State.pos, 1)
        }
        ReturnValue(XML_Tmp.avoff)
    }
}

Function.XML.ParseAttrs {
    Input: node: Integer
    Output: Integer
    Body: {
        last = 0
        more = 1
        WhileLoop EqualTo(more, 1) {
            XML.SkipWS()
            c = XML.Peek()
            IfCondition EqualTo(c, -1) ThenBlock: { more = 0 }
            IfCondition EqualTo(c, 62) ThenBlock: { more = 0 }
            IfCondition EqualTo(c, 47) ThenBlock: { more = 0 }
            IfCondition EqualTo(more, 1) ThenBlock: {
                XML.ReadName()
                XML_Tmp.anoff = XML_Tmp.off
                XML_Tmp.anlen = XML_Tmp.len
                XML_Tmp.avoff = 0
                XML_Tmp.avlen = 0
                XML.SkipWS()
                IfCondition EqualTo(XML.Peek(), 61) ThenBlock: {
                    XML.Get()
                    XML.SkipWS()
                    XML.ReadQuoted()
                }
                aidx = Add(XML_State.n_attrs, 1)
                IfCondition LessThan(aidx, XML_State.attr_cap) ThenBlock: {
                    XML_State.n_attrs = aidx
                    XML.AWStore(aidx, 0, XML_Tmp.anoff)
                    XML.AWStore(aidx, 1, XML_Tmp.anlen)
                    XML.AWStore(aidx, 2, XML_Tmp.avoff)
                    XML.AWStore(aidx, 3, XML_Tmp.avlen)
                    XML.AWStore(aidx, 4, 0)
                    IfCondition EqualTo(last, 0) ThenBlock: {
                        XML.NWStore(node, 3, aidx)
                    }
                    IfCondition NotEqual(last, 0) ThenBlock: {
                        XML.AWStore(last, 4, aidx)
                    }
                    last = aidx
                }
            }
        }
        ReturnValue(0)
    }
}

Function.XML.ParseOpen {
    Output: Integer
    Body: {
        XML.ReadName()
        node = XML.NewNode(1)
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        XML.NWStore(node, 1, XML_Tmp.off)
        XML.NWStore(node, 2, XML_Tmp.len)
        XML.ParseAttrs(node)
        XML_Tmp.selfc = 0
        XML.SkipWS()
        IfCondition EqualTo(XML.Peek(), 47) ThenBlock: {
            XML.Get()
            XML_Tmp.selfc = 1
        }
        IfCondition EqualTo(XML.Peek(), 62) ThenBlock: { XML.Get() }
        IfCondition EqualTo(XML_State.sp, 0) ThenBlock: {
            IfCondition EqualTo(XML_State.root, 0) ThenBlock: {
                XML_State.root = node
            }
        }
        IfCondition GreaterThan(XML_State.sp, 0) ThenBlock: {
            parent = Dereference(Add(XML_State.stack, Multiply(Subtract(XML_State.sp, 1), 8)))
            XML.AppendChild(parent, node)
        }
        IfCondition EqualTo(XML_Tmp.selfc, 0) ThenBlock: {
            IfCondition LessThan(XML_State.sp, 31) ThenBlock: {
                StoreValue(Add(XML_State.stack, Multiply(XML_State.sp, 8)), node)
                XML_State.sp = Add(XML_State.sp, 1)
            }
        }
        ReturnValue(node)
    }
}

Function.XML.ParseClose {
    Output: Integer
    Body: {
        XML.ReadName()
        XML.SkipWS()
        IfCondition EqualTo(XML.Peek(), 62) ThenBlock: { XML.Get() }
        IfCondition GreaterThan(XML_State.sp, 0) ThenBlock: {
            XML_State.sp = Subtract(XML_State.sp, 1)
        }
        ReturnValue(0)
    }
}

Function.XML.ParseText {
    Output: Integer
    Body: {
        start = XML_State.pos
        more = 1
        WhileLoop EqualTo(more, 1) {
            c = XML.Peek()
            IfCondition EqualTo(c, -1) ThenBlock: { more = 0 }
            IfCondition EqualTo(c, 60) ThenBlock: { more = 0 }
            IfCondition EqualTo(more, 1) ThenBlock: {
                XML_State.pos = Add(XML_State.pos, 1)
            }
        }
        n = Subtract(XML_State.pos, start)
        IfCondition LessEqual(n, 0) ThenBlock: { ReturnValue(0) }
        // skip whitespace-only
        only = 1
        i = 0
        WhileLoop LessThan(i, n) {
            c = GetByte(XML_State.data, Add(start, i))
            IfCondition EqualTo(XML.IsWS(c), 0) ThenBlock: { only = 0 }
            i = Add(i, 1)
        }
        IfCondition EqualTo(only, 1) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(XML_State.sp, 0) ThenBlock: { ReturnValue(0) }
        node = XML.NewNode(2)
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        off = XML.Intern(Add(XML_State.data, start), n)
        XML.NWStore(node, 1, off)
        XML.NWStore(node, 2, n)
        parent = Dereference(Add(XML_State.stack, Multiply(Subtract(XML_State.sp, 1), 8)))
        XML.AppendChild(parent, node)
        ReturnValue(node)
    }
}

Function.XML.Parse {
    Input: buf: Address
    Input: len: Integer
    Output: Integer
    Body: {
        IfCondition NotEqual(XML.Init(), 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(buf, 0) ThenBlock: { ReturnValue(0) }
        XML_State.data = buf
        XML_State.size = len
        XML_State.pos = 0
        more = 1
        WhileLoop EqualTo(more, 1) {
            IfCondition GreaterEqual(XML_State.pos, XML_State.size) ThenBlock: { more = 0 }
            IfCondition EqualTo(more, 1) ThenBlock: {
                c = XML.Peek()
                IfCondition EqualTo(c, 60) ThenBlock: {
                    XML.Get()
                    c2 = XML.Peek()
                    IfCondition EqualTo(c2, 47) ThenBlock: {
                        XML.Get()
                        XML.ParseClose()
                    }
                    IfCondition EqualTo(c2, 33) ThenBlock: {
                        XML.Get()
                        // <!-- or <!DOCTYPE
                        XML.SkipUntil(62, 0)
                    }
                    IfCondition EqualTo(c2, 63) ThenBlock: {
                        XML.Get()
                        XML.SkipUntil(63, 62)
                    }
                    did = 0
                    IfCondition EqualTo(c2, 47) ThenBlock: { did = 1 }
                    IfCondition EqualTo(c2, 33) ThenBlock: { did = 1 }
                    IfCondition EqualTo(c2, 63) ThenBlock: { did = 1 }
                    IfCondition EqualTo(did, 0) ThenBlock: {
                        XML.ParseOpen()
                    }
                }
                IfCondition NotEqual(c, 60) ThenBlock: {
                    XML.ParseText()
                }
            }
        }
        ReturnValue(XML_State.root)
    }
}

Function.XML.NodeCount {
    Output: Integer
    Body: {
        ReturnValue(XML_State.n_nodes)
    }
}

Function.XML.AttrCount {
    Output: Integer
    Body: {
        ReturnValue(XML_State.n_attrs)
    }
}

Function.XML.Type {
    Input: node: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(XML.NWLoad(node, 0))
    }
}

Function.XML.Name {
    Input: node: Integer
    Output: Address
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(XML.StrPtr(XML.NWLoad(node, 1)))
    }
}

Function.XML.NameLen {
    Input: node: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(XML.NWLoad(node, 2))
    }
}

Function.XML.NameIs {
    Input: node: Integer
    Input: lit: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(lit, 0) ThenBlock: { ReturnValue(0) }
        nlen = XML.NWLoad(node, 2)
        sl = 0
        WhileLoop NotEqual(GetByte(lit, sl), 0) {
            sl = Add(sl, 1)
            IfCondition GreaterThan(sl, 255) ThenBlock: { ReturnValue(0) }
        }
        IfCondition NotEqual(sl, nlen) ThenBlock: { ReturnValue(0) }
        p = XML.StrPtr(XML.NWLoad(node, 1))
        i = 0
        WhileLoop LessThan(i, nlen) {
            IfCondition NotEqual(GetByte(p, i), GetByte(lit, i)) ThenBlock: { ReturnValue(0) }
            i = Add(i, 1)
        }
        ReturnValue(1)
    }
}

Function.XML.Child {
    Input: node: Integer
    Input: lit: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        c = XML.NWLoad(node, 4)
        WhileLoop NotEqual(c, 0) {
            IfCondition EqualTo(XML.NWLoad(c, 0), 1) ThenBlock: {
                IfCondition EqualTo(XML.NameIs(c, lit), 1) ThenBlock: { ReturnValue(c) }
            }
            c = XML.NWLoad(c, 5)
        }
        ReturnValue(0)
    }
}

Function.XML.FirstChild {
    Input: node: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(XML.NWLoad(node, 4))
    }
}

Function.XML.Next {
    Input: node: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(XML.NWLoad(node, 5))
    }
}

Function.XML.Text {
    Input: node: Integer
    Output: Address
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(XML.NWLoad(node, 0), 2) ThenBlock: {
            ReturnValue(XML.StrPtr(XML.NWLoad(node, 1)))
        }
        c = XML.NWLoad(node, 4)
        WhileLoop NotEqual(c, 0) {
            IfCondition EqualTo(XML.NWLoad(c, 0), 2) ThenBlock: {
                ReturnValue(XML.StrPtr(XML.NWLoad(c, 1)))
            }
            c = XML.NWLoad(c, 5)
        }
        ReturnValue(0)
    }
}

Function.XML.Attr {
    Input: node: Integer
    Input: lit: Address
    Output: Address
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(lit, 0) ThenBlock: { ReturnValue(0) }
        sl = 0
        WhileLoop NotEqual(GetByte(lit, sl), 0) {
            sl = Add(sl, 1)
            IfCondition GreaterThan(sl, 255) ThenBlock: { ReturnValue(0) }
        }
        a = XML.NWLoad(node, 3)
        WhileLoop NotEqual(a, 0) {
            nlen = XML.AWLoad(a, 1)
            IfCondition EqualTo(nlen, sl) ThenBlock: {
                p = XML.StrPtr(XML.AWLoad(a, 0))
                ok = 1
                i = 0
                WhileLoop LessThan(i, nlen) {
                    IfCondition NotEqual(GetByte(p, i), GetByte(lit, i)) ThenBlock: { ok = 0 }
                    i = Add(i, 1)
                }
                IfCondition EqualTo(ok, 1) ThenBlock: {
                    ReturnValue(XML.StrPtr(XML.AWLoad(a, 2)))
                }
            }
            a = XML.AWLoad(a, 4)
        }
        ReturnValue(0)
    }
}
