LibraryImport.Arrays
LibraryImport.Yaml.YAMLScan
LibraryImport.Yaml.YAMLScalar
LibraryImport.Yaml.YAMLFlow
LibraryImport.Yaml.YAMLBlock
LibraryImport.Yaml.YAMLParse
LibraryImport.Yaml.YAMLEmit

// Node is 80 bytes:
//   0 kind   1 scalar, 2 seq, 3 map, 4 alias
//   8 style  scalar: 0 plain 1 double 2 single 3 literal 4 folded
//            collection: 0 block, 8 flow
//  16 anchor string or 0
//  24 tag    text inside <> or 0 when the tag is implicit
//  32 p0     scalar bytes, seq array, map key array, alias name
//  40 p1     map value array, or alias target node
//  48 slen   scalar byte length
//  56 resolved  0 string 1 null 2 bool 3 int 4 float
//  64 ival
//  72 mark   cycle guard while emitting JSON

FixedPool.YP {
    "buf": Initialize=0, CanChange=True
    "blen": Initialize=0, CanChange=True
    "lines": Initialize=0, CanChange=True
    "idx": Initialize=0, CanChange=True
    "off": Initialize=0, CanChange=True
    "eol": Initialize=0, CanChange=True
    "ind": Initialize=0, CanChange=True
    "col": Initialize=0, CanChange=True
    "err": Initialize=0, CanChange=True
    "errmsg": Initialize=0, CanChange=True
    "anchors": Initialize=0, CanChange=True
    "docs": Initialize=0, CanChange=True
    "tags": Initialize=0, CanChange=True
    "depth": Initialize=0, CanChange=True
    "ready": Initialize=0, CanChange=True
    "tabind": Initialize=0, CanChange=True
    "lstart": Initialize=0, CanChange=True
    "fmin": Initialize=-2, CanChange=True
}

FixedPool.SB {
    "data": Initialize=0, CanChange=True
    "len": Initialize=0, CanChange=True
    "cap": Initialize=0, CanChange=True
    "last": Initialize=0, CanChange=True
}

FixedPool.YB {
    "data": Initialize=0, CanChange=True
    "len": Initialize=0, CanChange=True
    "cap": Initialize=0, CanChange=True
}

Function.YAML.Fail {
    Input: msg: Address
    Body: {
        IfCondition EqualTo(YP.err, 0) ThenBlock: {
            YP.err = 1
            YP.errmsg = msg
        }
    }
}

Function.YAML.NewNode {
    Input: kind: Integer
    Output: Address
    Body: {
        n = Allocate(80)
        WRMEM_64(n, kind)
        WRMEM_64(n, 8, 0)
        WRMEM_64(n, 16, 0)
        WRMEM_64(n, 24, 0)
        WRMEM_64(n, 32, 0)
        WRMEM_64(n, 40, 0)
        WRMEM_64(n, 48, 0)
        WRMEM_64(n, 56, 0)
        WRMEM_64(n, 64, 0)
        WRMEM_64(n, 72, 0)
        ReturnValue(n)
    }
}

Function.YAML.EmptyScalar {
    Output: Address
    Body: {
        n = YAML.NewNode(1)
        s = Allocate(1)
        WRMEM_8(s, 0, 0)
        WRMEM_64(n, 32, s)
        WRMEM_64(n, 48, 0)
        WRMEM_64(n, 56, 1)
        ReturnValue(n)
    }
}

Function.YAML.AnchorAdd {
    Input: name: Address
    Input: node: Address
    Body: {
        rec = Allocate(24)
        WRMEM_64(rec, name)
        WRMEM_64(rec, 8, node)
        WRMEM_64(rec, 16, YP.anchors)
        YP.anchors = rec
    }
}

Function.YAML.AnchorGet {
    Input: name: Address
    Output: Address
    Body: {
        rec = YP.anchors
        found = 0
        looping = 1
        WhileLoop EqualTo(looping, 1) {
            IfCondition EqualTo(rec, 0) ThenBlock: {
                looping = 0
            } ElseBlock: {
                nm = RDMEM_64(rec)
                cmp = StringCompare(nm, name)
                IfCondition EqualTo(cmp, 0) ThenBlock: {
                    found = RDMEM_64(rec, 8)
                    looping = 0
                } ElseBlock: {
                    rec = RDMEM_64(rec, 16)
                }
            }
        }
        ReturnValue(found)
    }
}

Function.YAML.ApplyProps {
    Input: node: Address
    Input: anchor: Address
    Input: tag: Address
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: {
            YAML.Fail("missing node")
        } ElseBlock: {
            kind = RDMEM_64(node)
            alias_prop = 0
            IfCondition EqualTo(kind, 4) ThenBlock: {
                IfCondition NotEqual(anchor, 0) ThenBlock: { alias_prop = 1 }
                IfCondition NotEqual(tag, 0) ThenBlock: { alias_prop = 1 }
            }
            IfCondition EqualTo(alias_prop, 1) ThenBlock: {
                YAML.Fail("anchor on alias")
            } ElseBlock: {
                IfCondition NotEqual(anchor, 0) ThenBlock: {
                    WRMEM_64(node, 16, anchor)
                    YAML.AnchorAdd(anchor, node)
                }
                IfCondition NotEqual(tag, 0) ThenBlock: {
                    WRMEM_64(node, 24, tag)
                    YAML.ResolveTagged(node)
                }
            }
        }
    }
}

Function.YAML.Failed {
    Output: Integer
    Body: {
        ReturnValue(YP.err)
    }
}

Function.YAML.ErrorMsg {
    Output: Address
    Body: {
        IfCondition EqualTo(YP.errmsg, 0) ThenBlock: {
            ReturnValue("yaml error")
        }
        ReturnValue(YP.errmsg)
    }
}

Function.YAML.Load {
    Input: buf: Address
    Input: n: Integer
    Output: Address
    Body: {
        YAML.Reset()
        YAML.Split(buf, n)
        YAML.ParseStream()
        IfCondition EqualTo(YP.err, 1) ThenBlock: {
            ReturnValue(0)
        }
        ReturnValue(YP.docs)
    }
}

Function.YAML.Events {
    Input: buf: Address
    Input: n: Integer
    Output: Address
    Body: {
        docs = YAML.Load(buf, n)
        IfCondition EqualTo(docs, 0) ThenBlock: {
            ReturnValue(0)
        }
        ReturnValue(YAML.EmitEvents())
    }
}

Function.YAML.ToJSON {
    Input: buf: Address
    Input: n: Integer
    Output: Address
    Body: {
        docs = YAML.Load(buf, n)
        IfCondition EqualTo(docs, 0) ThenBlock: {
            ReturnValue(0)
        }
        ReturnValue(YAML.EmitJSON())
    }
}

Function.YAML.DocCount {
    Output: Integer
    Body: {
        IfCondition EqualTo(YP.docs, 0) ThenBlock: {
            ReturnValue(0)
        }
        ReturnValue(Array.Size(YP.docs))
    }
}

Function.YAML.DocNode {
    Input: i: Integer
    Output: Address
    Body: {
        rec = Array.Get(YP.docs, i)
        IfCondition EqualTo(rec, 0) ThenBlock: {
            ReturnValue(0)
        }
        ReturnValue(RDMEM_64(rec))
    }
}

Function.YAML.Kind {
    Input: node: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: {
            ReturnValue(0)
        }
        ReturnValue(RDMEM_64(node))
    }
}

Function.YAML.Scalar {
    Input: node: Address
    Output: Address
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: {
            ReturnValue(0)
        }
        ReturnValue(RDMEM_64(node, 32))
    }
}

Function.YAML.ScalarLen {
    Input: node: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: {
            ReturnValue(0)
        }
        ReturnValue(RDMEM_64(node, 48))
    }
}

Function.YAML.Resolved {
    Input: node: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: {
            ReturnValue(0)
        }
        ReturnValue(RDMEM_64(node, 56))
    }
}

Function.YAML.Int {
    Input: node: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: {
            ReturnValue(0)
        }
        ReturnValue(RDMEM_64(node, 64))
    }
}

Function.YAML.SeqLen {
    Input: node: Address
    Output: Integer
    Body: {
        arr = RDMEM_64(node, 32)
        IfCondition EqualTo(arr, 0) ThenBlock: {
            ReturnValue(0)
        }
        ReturnValue(Array.Size(arr))
    }
}

Function.YAML.SeqAt {
    Input: node: Address
    Input: i: Integer
    Output: Address
    Body: {
        arr = RDMEM_64(node, 32)
        ReturnValue(Array.Get(arr, i))
    }
}

Function.YAML.MapLen {
    Input: node: Address
    Output: Integer
    Body: {
        arr = RDMEM_64(node, 32)
        IfCondition EqualTo(arr, 0) ThenBlock: {
            ReturnValue(0)
        }
        ReturnValue(Array.Size(arr))
    }
}

Function.YAML.MapKey {
    Input: node: Address
    Input: i: Integer
    Output: Address
    Body: {
        arr = RDMEM_64(node, 32)
        ReturnValue(Array.Get(arr, i))
    }
}

Function.YAML.MapVal {
    Input: node: Address
    Input: i: Integer
    Output: Address
    Body: {
        arr = RDMEM_64(node, 40)
        ReturnValue(Array.Get(arr, i))
    }
}
