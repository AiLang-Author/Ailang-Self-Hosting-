Function.YAML.SavePos {
    Output: Address
    Body: {
        rec = Allocate(64)
        WRMEM_64(rec, YP.idx)
        WRMEM_64(rec, 8, YP.off)
        WRMEM_64(rec, 16, YP.eol)
        WRMEM_64(rec, 24, YP.ind)
        WRMEM_64(rec, 32, YP.col)
        WRMEM_64(rec, 40, YP.ready)
        WRMEM_64(rec, 48, YP.lstart)
        WRMEM_64(rec, 56, YP.tabind)
        ReturnValue(rec)
    }
}

Function.YAML.RestorePos {
    Input: rec: Address
    Body: {
        YP.idx = RDMEM_64(rec)
        YP.off = RDMEM_64(rec, 8)
        YP.eol = RDMEM_64(rec, 16)
        YP.ind = RDMEM_64(rec, 24)
        YP.col = RDMEM_64(rec, 32)
        YP.ready = RDMEM_64(rec, 40)
        YP.lstart = RDMEM_64(rec, 48)
        YP.tabind = RDMEM_64(rec, 56)
    }
}

Function.YAML.LineByte {
    Input: p: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(p, 0) ThenBlock: {
            ReturnValue(-1)
        }
        IfCondition GreaterEqual(p, YP.eol) ThenBlock: {
            ReturnValue(-1)
        }
        ReturnValue(RDMEM_8(Add(YP.buf, p)))
    }
}

Function.YAML.AtKeyColon {
    Output: Integer
    Body: {
        c = YAML.Peek()
        IfCondition NotEqual(c, 58) ThenBlock: {
            ReturnValue(0)
        }
        n1 = YAML.AtRel(1)
        IfCondition EqualTo(n1, -1) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(n1, 32) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(n1, 9) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

Function.YAML.StartsSeq {
    Output: Integer
    Body: {
        c = YAML.Peek()
        IfCondition NotEqual(c, 45) ThenBlock: {
            ReturnValue(0)
        }
        n1 = YAML.AtRel(1)
        IfCondition EqualTo(n1, -1) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(n1, 32) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(n1, 9) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

Function.YAML.StartsExplicit {
    Output: Integer
    Body: {
        c = YAML.Peek()
        IfCondition NotEqual(c, 63) ThenBlock: {
            ReturnValue(0)
        }
        n1 = YAML.AtRel(1)
        IfCondition EqualTo(n1, -1) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(n1, 32) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(n1, 9) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

Function.YAML.ColonAt {
    Input: i: Integer
    Output: Integer
    Body: {
        end = YP.eol
        IfCondition GreaterEqual(i, end) ThenBlock: {
            ReturnValue(0)
        }
        d = YAML.LineByte(i)
        IfCondition NotEqual(d, 58) ThenBlock: {
            ReturnValue(0)
        }
        j = Add(i, 1)
        IfCondition GreaterEqual(j, end) ThenBlock: {
            ReturnValue(1)
        }
        n = YAML.LineByte(j)
        IfCondition EqualTo(n, 32) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(n, 9) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

Function.YAML.SkipQuoteAt {
    Input: i: Integer
    Input: q: Integer
    Output: Integer
    Body: {
        end = YP.eol
        i2 = Add(i, 1)
        looping = 1
        WhileLoop EqualTo(looping, 1) {
            IfCondition GreaterEqual(i2, end) ThenBlock: {
                looping = 0
            } ElseBlock: {
                d = YAML.LineByte(i2)
                IfCondition EqualTo(d, q) ThenBlock: {
                    IfCondition EqualTo(q, 39) ThenBlock: {
                        j = Add(i2, 1)
                        twin = 0
                        IfCondition LessThan(j, end) ThenBlock: {
                            d2 = YAML.LineByte(j)
                            IfCondition EqualTo(d2, 39) ThenBlock: {
                                twin = 1
                            }
                        }
                        IfCondition EqualTo(twin, 1) ThenBlock: {
                            i2 = Add(i2, 2)
                        } ElseBlock: {
                            i2 = Add(i2, 1)
                            looping = 0
                        }
                    } ElseBlock: {
                        i2 = Add(i2, 1)
                        looping = 0
                    }
                } ElseBlock: {
                    IfCondition EqualTo(d, 92) ThenBlock: {
                        IfCondition EqualTo(q, 34) ThenBlock: {
                            i2 = Add(i2, 2)
                        } ElseBlock: {
                            i2 = Add(i2, 1)
                        }
                    } ElseBlock: {
                        i2 = Add(i2, 1)
                    }
                }
            }
        }
        ReturnValue(i2)
    }
}

Function.YAML.SkipSpacesAt {
    Input: i: Integer
    Output: Integer
    Body: {
        end = YP.eol
        i2 = i
        looping = 1
        WhileLoop EqualTo(looping, 1) {
            IfCondition GreaterEqual(i2, end) ThenBlock: {
                looping = 0
            } ElseBlock: {
                d = YAML.LineByte(i2)
                IfCondition EqualTo(d, 32) ThenBlock: {
                    i2 = Add(i2, 1)
                } ElseBlock: {
                    IfCondition EqualTo(d, 9) ThenBlock: {
                        i2 = Add(i2, 1)
                    } ElseBlock: {
                        looping = 0
                    }
                }
            }
        }
        ReturnValue(i2)
    }
}

Function.YAML.HasImplicitKey {
    Output: Integer
    Body: {
        i = YP.off
        end = YP.eol
        skipping = 1
        WhileLoop EqualTo(skipping, 1) {
            IfCondition GreaterEqual(i, end) ThenBlock: {
                ReturnValue(0)
            }
            c = YAML.LineByte(i)
            IfCondition EqualTo(c, 32) ThenBlock: {
                i = Add(i, 1)
            } ElseBlock: {
                IfCondition EqualTo(c, 9) ThenBlock: {
                    i = Add(i, 1)
                } ElseBlock: {
                    IfCondition EqualTo(c, 33) ThenBlock: {
                        i = Add(i, 1)
                        moving = 1
                        WhileLoop EqualTo(moving, 1) {
                            IfCondition GreaterEqual(i, end) ThenBlock: {
                                moving = 0
                            } ElseBlock: {
                                d = YAML.LineByte(i)
                                stop = 0
                                IfCondition EqualTo(d, 32) ThenBlock: { stop = 1 }
                                IfCondition EqualTo(d, 9) ThenBlock: { stop = 1 }
                                IfCondition EqualTo(d, 44) ThenBlock: { stop = 1 }
                                IfCondition EqualTo(d, 91) ThenBlock: { stop = 1 }
                                IfCondition EqualTo(d, 93) ThenBlock: { stop = 1 }
                                IfCondition EqualTo(d, 123) ThenBlock: { stop = 1 }
                                IfCondition EqualTo(d, 125) ThenBlock: { stop = 1 }
                                IfCondition EqualTo(stop, 1) ThenBlock: {
                                    moving = 0
                                } ElseBlock: {
                                    i = Add(i, 1)
                                }
                            }
                        }
                    } ElseBlock: {
                        IfCondition EqualTo(c, 38) ThenBlock: {
                            i = Add(i, 1)
                            moving = 1
                            WhileLoop EqualTo(moving, 1) {
                                IfCondition GreaterEqual(i, end) ThenBlock: {
                                    moving = 0
                                } ElseBlock: {
                                    d = YAML.LineByte(i)
                                    stop = 0
                                    IfCondition EqualTo(d, 32) ThenBlock: { stop = 1 }
                                    IfCondition EqualTo(d, 9) ThenBlock: { stop = 1 }
                                    IfCondition EqualTo(stop, 1) ThenBlock: {
                                        moving = 0
                                    } ElseBlock: {
                                        i = Add(i, 1)
                                    }
                                }
                            }
                        } ElseBlock: {
                            skipping = 0
                        }
                    }
                }
            }
        }
        IfCondition GreaterEqual(i, end) ThenBlock: {
            ReturnValue(0)
        }
        c = YAML.LineByte(i)
        IfCondition EqualTo(c, 34) ThenBlock: {
            i = YAML.SkipQuoteAt(i, 34)
            i = YAML.SkipSpacesAt(i)
            ReturnValue(YAML.ColonAt(i))
        }
        IfCondition EqualTo(c, 39) ThenBlock: {
            i = YAML.SkipQuoteAt(i, 39)
            i = YAML.SkipSpacesAt(i)
            ReturnValue(YAML.ColonAt(i))
        }
        IfCondition EqualTo(c, 42) ThenBlock: {
            i = Add(i, 1)
            moving = 1
            WhileLoop EqualTo(moving, 1) {
                IfCondition GreaterEqual(i, end) ThenBlock: {
                    moving = 0
                } ElseBlock: {
                    d = YAML.LineByte(i)
                    IfCondition EqualTo(d, 32) ThenBlock: {
                        moving = 0
                    } ElseBlock: {
                        IfCondition EqualTo(d, 9) ThenBlock: {
                            moving = 0
                        } ElseBlock: {
                            i = Add(i, 1)
                        }
                    }
                }
            }
            i = YAML.SkipSpacesAt(i)
            ReturnValue(YAML.ColonAt(i))
        }
        IfCondition EqualTo(c, 91) ThenBlock: {
            depth = 1
            i = Add(i, 1)
            moving = 1
            WhileLoop EqualTo(moving, 1) {
                IfCondition GreaterEqual(i, end) ThenBlock: {
                    moving = 0
                } ElseBlock: {
                    IfCondition EqualTo(depth, 0) ThenBlock: {
                        moving = 0
                    } ElseBlock: {
                        d = YAML.LineByte(i)
                        IfCondition EqualTo(d, 34) ThenBlock: {
                            i = YAML.SkipQuoteAt(i, 34)
                        } ElseBlock: {
                            IfCondition EqualTo(d, 39) ThenBlock: {
                                i = YAML.SkipQuoteAt(i, 39)
                            } ElseBlock: {
                                IfCondition EqualTo(d, 91) ThenBlock: {
                                    depth = Add(depth, 1)
                                    i = Add(i, 1)
                                } ElseBlock: {
                                    IfCondition EqualTo(d, 123) ThenBlock: {
                                        depth = Add(depth, 1)
                                        i = Add(i, 1)
                                    } ElseBlock: {
                                        IfCondition EqualTo(d, 93) ThenBlock: {
                                            depth = Subtract(depth, 1)
                                            i = Add(i, 1)
                                        } ElseBlock: {
                                            IfCondition EqualTo(d, 125) ThenBlock: {
                                                depth = Subtract(depth, 1)
                                                i = Add(i, 1)
                                            } ElseBlock: {
                                                i = Add(i, 1)
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
            i = YAML.SkipSpacesAt(i)
            ReturnValue(YAML.ColonAt(i))
        }
        IfCondition EqualTo(c, 123) ThenBlock: {
            depth = 1
            i = Add(i, 1)
            moving = 1
            WhileLoop EqualTo(moving, 1) {
                IfCondition GreaterEqual(i, end) ThenBlock: {
                    moving = 0
                } ElseBlock: {
                    IfCondition EqualTo(depth, 0) ThenBlock: {
                        moving = 0
                    } ElseBlock: {
                        d = YAML.LineByte(i)
                        IfCondition EqualTo(d, 34) ThenBlock: {
                            i = YAML.SkipQuoteAt(i, 34)
                        } ElseBlock: {
                            IfCondition EqualTo(d, 39) ThenBlock: {
                                i = YAML.SkipQuoteAt(i, 39)
                            } ElseBlock: {
                                IfCondition EqualTo(d, 91) ThenBlock: {
                                    depth = Add(depth, 1)
                                    i = Add(i, 1)
                                } ElseBlock: {
                                    IfCondition EqualTo(d, 123) ThenBlock: {
                                        depth = Add(depth, 1)
                                        i = Add(i, 1)
                                    } ElseBlock: {
                                        IfCondition EqualTo(d, 93) ThenBlock: {
                                            depth = Subtract(depth, 1)
                                            i = Add(i, 1)
                                        } ElseBlock: {
                                            IfCondition EqualTo(d, 125) ThenBlock: {
                                                depth = Subtract(depth, 1)
                                                i = Add(i, 1)
                                            } ElseBlock: {
                                                i = Add(i, 1)
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
            i = YAML.SkipSpacesAt(i)
            ReturnValue(YAML.ColonAt(i))
        }
        moving = 1
        WhileLoop EqualTo(moving, 1) {
            IfCondition GreaterEqual(i, end) ThenBlock: {
                ReturnValue(0)
            }
            hit = YAML.ColonAt(i)
            IfCondition EqualTo(hit, 1) ThenBlock: {
                ReturnValue(1)
            }
            d = YAML.LineByte(i)
            IfCondition EqualTo(d, 35) ThenBlock: {
                prevs = 0
                IfCondition EqualTo(i, YP.off) ThenBlock: { prevs = 1 }
                IfCondition GreaterThan(i, 0) ThenBlock: {
                    pb = YAML.LineByte(Subtract(i, 1))
                    IfCondition EqualTo(pb, 32) ThenBlock: { prevs = 1 }
                    IfCondition EqualTo(pb, 9) ThenBlock: { prevs = 1 }
                }
                IfCondition EqualTo(prevs, 1) ThenBlock: {
                    ReturnValue(0)
                }
            }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

Function.YAML.SkipBlockSep {
    Body: {
        saw_tab = 0
        looping = 1
        WhileLoop EqualTo(looping, 1) {
            c = YAML.Peek()
            IfCondition EqualTo(c, 32) ThenBlock: {
                YAML.Bump()
            } ElseBlock: {
                IfCondition EqualTo(c, 9) ThenBlock: {
                    saw_tab = 1
                    YAML.Bump()
                } ElseBlock: {
                    looping = 0
                }
            }
        }
        IfCondition EqualTo(saw_tab, 1) ThenBlock: {
            bad = 0
            s1 = YAML.StartsSeq()
            IfCondition EqualTo(s1, 1) ThenBlock: { bad = 1 }
            s2 = YAML.StartsExplicit()
            IfCondition EqualTo(s2, 1) ThenBlock: { bad = 1 }
            s3 = YAML.AtKeyColon()
            IfCondition EqualTo(s3, 1) ThenBlock: { bad = 1 }
            s4 = YAML.HasImplicitKey()
            IfCondition EqualTo(s4, 1) ThenBlock: { bad = 1 }
            IfCondition EqualTo(bad, 1) ThenBlock: {
                YAML.Fail("tab indentation")
            }
        }
    }
}

Function.YAML.FinishRest {
    Body: {
        IfCondition EqualTo(YP.err, 1) ThenBlock: {
            ReturnValue(0)
        }
        ok = YAML.Ensure()
        IfCondition EqualTo(ok, 0) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition EqualTo(YP.col, YP.ind) ThenBlock: {
            ReturnValue(0)
        }
        YAML.SkipHSpace()
        eol = YAML.AtEol()
        IfCondition EqualTo(eol, 1) ThenBlock: {
            YAML.FinishLine()
        } ElseBlock: {
            YAML.Fail("trailing content")
        }
        ReturnValue(0)
    }
}

Function.YAML.ReadToken {
    Input: mode: Integer
    Output: Address
    Body: {
        SB.Reset()
        looping = 1
        WhileLoop EqualTo(looping, 1) {
            c = YAML.Peek()
            stop = 0
            IfCondition EqualTo(c, -1) ThenBlock: { stop = 1 }
            IfCondition EqualTo(c, 32) ThenBlock: { stop = 1 }
            IfCondition EqualTo(c, 9) ThenBlock: { stop = 1 }
            IfCondition GreaterEqual(mode, 1) ThenBlock: {
                IfCondition EqualTo(c, 44) ThenBlock: { stop = 1 }
                IfCondition EqualTo(c, 91) ThenBlock: { stop = 1 }
                IfCondition EqualTo(c, 93) ThenBlock: { stop = 1 }
                IfCondition EqualTo(c, 123) ThenBlock: { stop = 1 }
                IfCondition EqualTo(c, 125) ThenBlock: { stop = 1 }
            }
            IfCondition EqualTo(stop, 1) ThenBlock: {
                looping = 0
            } ElseBlock: {
                ac = 0
                IfCondition EqualTo(c, 35) ThenBlock: {
                    ac = YAML.AtComment()
                }
                IfCondition EqualTo(ac, 1) ThenBlock: {
                    looping = 0
                } ElseBlock: {
                    SB.Byte(c)
                    YAML.Bump()
                }
            }
        }
        text = SB.Take()
        ReturnValue(text)
    }
}

Function.YAML.FindByte {
    Input: s: Address
    Input: b: Integer
    Output: Integer
    Body: {
        n = StringLength(s)
        i = 0
        found = -1
        looping = 1
        WhileLoop EqualTo(looping, 1) {
            IfCondition GreaterEqual(i, n) ThenBlock: {
                looping = 0
            } ElseBlock: {
                d = RDMEM_8(Add(s, i))
                IfCondition EqualTo(d, b) ThenBlock: {
                    found = i
                    looping = 0
                } ElseBlock: {
                    i = Add(i, 1)
                }
            }
        }
        ReturnValue(found)
    }
}

Function.YAML.SliceFrom {
    Input: s: Address
    Input: from: Integer
    Output: Address
    Body: {
        n = StringLength(s)
        SB.Reset()
        i = from
        WhileLoop LessThan(i, n) {
            d = RDMEM_8(Add(s, i))
            SB.Byte(d)
            i = Add(i, 1)
        }
        text = SB.Take()
        ReturnValue(text)
    }
}

Function.YAML.Join2 {
    Input: a: Address
    Input: b: Address
    Output: Address
    Body: {
        YB.Reset()
        YB.Str(a)
        YB.Str(b)
        text = YB.Take()
        ReturnValue(text)
    }
}

Function.YAML.UriDecode {
    Input: s: Address
    Output: Address
    Body: {
        n = StringLength(s)
        SB.Reset()
        i = 0
        WhileLoop LessThan(i, n) {
            b = RDMEM_8(Add(s, i))
            IfCondition EqualTo(b, 37) ThenBlock: {
                j = Add(i, 2)
                IfCondition LessThan(j, n) ThenBlock: {
                    h1 = YAML.HexVal(RDMEM_8(Add(s, Add(i, 1))))
                    h2 = YAML.HexVal(RDMEM_8(Add(s, j)))
                    IfCondition LessThan(h1, 0) ThenBlock: {
                        SB.Byte(b)
                        i = Add(i, 1)
                    } ElseBlock: {
                        IfCondition LessThan(h2, 0) ThenBlock: {
                            SB.Byte(b)
                            i = Add(i, 1)
                        } ElseBlock: {
                            v = Multiply(h1, 16)
                            v = Add(v, h2)
                            SB.Byte(v)
                            i = Add(i, 3)
                        }
                    }
                } ElseBlock: {
                    SB.Byte(b)
                    i = Add(i, 1)
                }
            } ElseBlock: {
                SB.Byte(b)
                i = Add(i, 1)
            }
        }
        text = SB.Take()
        ReturnValue(text)
    }
}

Function.YAML.HandleOf {
    Input: raw: Address
    Input: bang: Integer
    Output: Address
    Body: {
        YB.Reset()
        YB.Byte(33)
        i = 0
        last = Add(bang, 1)
        WhileLoop LessThan(i, last) {
            d = RDMEM_8(Add(raw, i))
            YB.Byte(d)
            i = Add(i, 1)
        }
        text = YB.Take()
        ReturnValue(text)
    }
}

Function.YAML.TagAdd {
    Input: handle: Address
    Input: prefix: Address
    Body: {
        rec = Allocate(24)
        WRMEM_64(rec, handle)
        WRMEM_64(rec, 8, prefix)
        WRMEM_64(rec, 16, YP.tags)
        YP.tags = rec
    }
}

Function.YAML.TagFind {
    Input: handle: Address
    Output: Address
    Body: {
        rec = YP.tags
        found = 0
        looping = 1
        WhileLoop EqualTo(looping, 1) {
            IfCondition EqualTo(rec, 0) ThenBlock: {
                looping = 0
            } ElseBlock: {
                nm = RDMEM_64(rec)
                cmp = StringCompare(nm, handle)
                IfCondition EqualTo(cmp, 0) ThenBlock: {
                    found = RDMEM_64(rec, 8)
                    looping = 0
                } ElseBlock: {
                    rec = RDMEM_64(rec, 16)
                }
            }
        }
        ReturnValue(found)
    }
}

Function.YAML.ReadTag {
    Output: Address
    Body: {
        YAML.Bump()
        c = YAML.Peek()
        IfCondition EqualTo(c, 60) ThenBlock: {
            YAML.Bump()
            SB.Reset()
            looping = 1
            WhileLoop EqualTo(looping, 1) {
                d = YAML.Peek()
                IfCondition EqualTo(d, -1) ThenBlock: {
                    YAML.Fail("unterminated tag")
                    looping = 0
                } ElseBlock: {
                    IfCondition EqualTo(d, 62) ThenBlock: {
                        YAML.Bump()
                        looping = 0
                    } ElseBlock: {
                        SB.Byte(d)
                        YAML.Bump()
                    }
                }
            }
            text = SB.Take()
            ReturnValue(text)
        }
        IfCondition EqualTo(c, 33) ThenBlock: {
            YAML.Bump()
            raw = YAML.ReadToken(1)
            dec = YAML.UriDecode(raw)
            prefix = YAML.TagFind("!!")
            IfCondition EqualTo(prefix, 0) ThenBlock: {
                text = YAML.Join2("tag:yaml.org,2002:", dec)
                ReturnValue(text)
            }
            text = YAML.Join2(prefix, dec)
            ReturnValue(text)
        }
        raw = YAML.ReadToken(1)
        sl = StringLength(raw)
        IfCondition EqualTo(sl, 0) ThenBlock: {
            ReturnValue("!")
        }
        bang = YAML.FindByte(raw, 33)
        IfCondition GreaterEqual(bang, 0) ThenBlock: {
            handle = YAML.HandleOf(raw, bang)
            rest = YAML.SliceFrom(raw, Add(bang, 1))
            prefix = YAML.TagFind(handle)
            IfCondition EqualTo(prefix, 0) ThenBlock: {
                YAML.Fail("unknown tag handle")
                ReturnValue("!")
            }
            dec = YAML.UriDecode(rest)
            text = YAML.Join2(prefix, dec)
            ReturnValue(text)
        }
        dec = YAML.UriDecode(raw)
        prefix = YAML.TagFind("!")
        IfCondition EqualTo(prefix, 0) ThenBlock: {
            text = YAML.Join2("!", dec)
            ReturnValue(text)
        }
        text = YAML.Join2(prefix, dec)
        ReturnValue(text)
    }
}

Function.YAML.ReadAnchor {
    Output: Address
    Body: {
        YAML.Bump()
        text = YAML.ReadToken(1)
        sl = StringLength(text)
        IfCondition EqualTo(sl, 0) ThenBlock: {
            YAML.Fail("empty anchor")
        }
        ReturnValue(text)
    }
}

Function.YAML.ReadProps {
    Output: Address
    Body: {
        anchor = 0
        tag = 0
        looping = 1
        WhileLoop EqualTo(looping, 1) {
            IfCondition EqualTo(YP.err, 1) ThenBlock: {
                looping = 0
            } ElseBlock: {
                YAML.SkipHSpace()
                c = YAML.Peek()
                IfCondition EqualTo(c, 38) ThenBlock: {
                    IfCondition NotEqual(anchor, 0) ThenBlock: {
                        YAML.Fail("two anchors")
                        looping = 0
                    } ElseBlock: {
                        anchor = YAML.ReadAnchor()
                    }
                } ElseBlock: {
                    IfCondition EqualTo(c, 33) ThenBlock: {
                        IfCondition NotEqual(tag, 0) ThenBlock: {
                            YAML.Fail("two tags")
                            looping = 0
                        } ElseBlock: {
                            tag = YAML.ReadTag()
                        }
                    } ElseBlock: {
                        looping = 0
                    }
                }
            }
        }
        rec = Allocate(16)
        WRMEM_64(rec, anchor)
        WRMEM_64(rec, 8, tag)
        ReturnValue(rec)
    }
}

Function.YAML.ParseAlias {
    Output: Address
    Body: {
        YAML.Bump()
        name = YAML.ReadToken(1)
        sl = StringLength(name)
        IfCondition EqualTo(sl, 0) ThenBlock: {
            YAML.Fail("empty alias")
        }
        node = YAML.NewNode(4)
        WRMEM_64(node, 32, name)
        tgt = YAML.AnchorGet(name)
        WRMEM_64(node, 40, tgt)
        ReturnValue(node)
    }
}

Function.YAML.ApplyLoose {
    Input: node: Address
    Input: anchor: Address
    Input: tag: Address
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: {
            ReturnValue(0)
        }
        kind = RDMEM_64(node)
        IfCondition EqualTo(kind, 4) ThenBlock: {
            badp = 0
            IfCondition NotEqual(anchor, 0) ThenBlock: { badp = 1 }
            IfCondition NotEqual(tag, 0) ThenBlock: { badp = 1 }
            IfCondition EqualTo(badp, 1) ThenBlock: {
                YAML.Fail("anchor on alias")
                ReturnValue(0)
            }
        }
        IfCondition NotEqual(anchor, 0) ThenBlock: {
            cur = RDMEM_64(node, 16)
            IfCondition EqualTo(cur, 0) ThenBlock: {
                WRMEM_64(node, 16, anchor)
                YAML.AnchorAdd(anchor, node)
            } ElseBlock: {
                YAML.Fail("two anchors")
            }
        }
        IfCondition NotEqual(tag, 0) ThenBlock: {
            cur = RDMEM_64(node, 24)
            IfCondition EqualTo(cur, 0) ThenBlock: {
                WRMEM_64(node, 24, tag)
                YAML.ResolveTagged(node)
            }
        }
        ReturnValue(0)
    }
}

Function.YAML.TrimSB {
    Body: {
        looping = 1
        WhileLoop EqualTo(looping, 1) {
            IfCondition EqualTo(SB.len, 0) ThenBlock: {
                looping = 0
            } ElseBlock: {
                prevp = Subtract(SB.len, 1)
                b = RDMEM_8(Add(SB.data, prevp))
                IfCondition EqualTo(b, 32) ThenBlock: {
                    SB.len = prevp
                } ElseBlock: {
                    IfCondition EqualTo(b, 9) ThenBlock: {
                        SB.len = prevp
                    } ElseBlock: {
                        looping = 0
                    }
                }
            }
        }
    }
}

Function.YAML.ReadPlainKey {
    Output: Address
    Body: {
        SB.Reset()
        looping = 1
        WhileLoop EqualTo(looping, 1) {
            eol = YAML.AtEol()
            IfCondition EqualTo(eol, 1) ThenBlock: {
                looping = 0
            } ElseBlock: {
                hit = YAML.AtKeyColon()
                IfCondition EqualTo(hit, 1) ThenBlock: {
                    looping = 0
                } ElseBlock: {
                    c = YAML.Peek()
                    SB.Byte(c)
                    YAML.Bump()
                }
            }
        }
        YAML.TrimSB()
        text = SB.Take()
        sl = SB.last
        node = YAML.NewNode(1)
        WRMEM_64(node, 32, text)
        WRMEM_64(node, 48, sl)
        YAML.ResolveTagged(node)
        ReturnValue(node)
    }
}

Function.YAML.PlainBreak {
    Input: from: Integer
    Input: to: Integer
    Output: Integer
    Body: {
        p = from
        found = 0
        WhileLoop EqualTo(found, 0) {
            IfCondition GreaterEqual(p, to) ThenBlock: {
                found = 2
            } ElseBlock: {
                b = RDMEM_8(Add(YP.buf, p))
                IfCondition EqualTo(b, 58) ThenBlock: {
                    n = Add(p, 1)
                    IfCondition LessThan(n, to) ThenBlock: {
                        nb = RDMEM_8(Add(YP.buf, n))
                        IfCondition EqualTo(nb, 32) ThenBlock: { found = 1 }
                        IfCondition EqualTo(nb, 9) ThenBlock: { found = 1 }
                    }
                }
                p = Add(p, 1)
            }
        }
        IfCondition EqualTo(found, 1) ThenBlock: {
            ReturnValue(1)
        }
        ReturnValue(0)
    }
}

Function.YAML.AppendPlain {
    Input: from: Integer
    Input: to: Integer
    Output: Integer
    Body: {
        mark = SB.len
        p = from
        stop = 0
        commented = 0
        WhileLoop EqualTo(stop, 0) {
            IfCondition GreaterEqual(p, to) ThenBlock: {
                stop = 1
            } ElseBlock: {
                b = RDMEM_8(Add(YP.buf, p))
                cut = 0
                IfCondition EqualTo(b, 35) ThenBlock: {
                    IfCondition EqualTo(p, from) ThenBlock: { cut = 1 }
                    IfCondition GreaterThan(p, 0) ThenBlock: {
                        pb = RDMEM_8(Add(YP.buf, Subtract(p, 1)))
                        IfCondition EqualTo(pb, 32) ThenBlock: { cut = 1 }
                        IfCondition EqualTo(pb, 9) ThenBlock: { cut = 1 }
                    }
                }
                IfCondition EqualTo(cut, 1) ThenBlock: {
                    stop = 1
                    commented = 1
                } ElseBlock: {
                    SB.Byte(b)
                    p = Add(p, 1)
                }
            }
        }
        looping = 1
        WhileLoop EqualTo(looping, 1) {
            IfCondition LessEqual(SB.len, mark) ThenBlock: {
                looping = 0
            } ElseBlock: {
                prevp = Subtract(SB.len, 1)
                b = RDMEM_8(Add(SB.data, prevp))
                IfCondition EqualTo(b, 32) ThenBlock: {
                    SB.len = prevp
                } ElseBlock: {
                    IfCondition EqualTo(b, 9) ThenBlock: {
                        SB.len = prevp
                    } ElseBlock: {
                        looping = 0
                    }
                }
            }
        }
        ReturnValue(commented)
    }
}

Function.YAML.RecMarker {
    Input: rec: Address
    Output: Integer
    Body: {
        ind = RDMEM_64(rec, 16)
        IfCondition NotEqual(ind, 0) ThenBlock: {
            ReturnValue(0)
        }
        st = RDMEM_64(rec)
        ln = RDMEM_64(rec, 8)
        IfCondition LessThan(ln, 3) ThenBlock: {
            ReturnValue(0)
        }
        a = RDMEM_8(Add(YP.buf, st))
        b = RDMEM_8(Add(YP.buf, Add(st, 1)))
        c = RDMEM_8(Add(YP.buf, Add(st, 2)))
        kind = 0
        IfCondition EqualTo(a, 45) ThenBlock: {
            IfCondition EqualTo(b, 45) ThenBlock: {
                IfCondition EqualTo(c, 45) ThenBlock: { kind = 1 }
            }
        }
        IfCondition EqualTo(a, 46) ThenBlock: {
            IfCondition EqualTo(b, 46) ThenBlock: {
                IfCondition EqualTo(c, 46) ThenBlock: { kind = 2 }
            }
        }
        IfCondition EqualTo(kind, 0) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition EqualTo(ln, 3) ThenBlock: {
            ReturnValue(kind)
        }
        d = RDMEM_8(Add(YP.buf, Add(st, 3)))
        IfCondition EqualTo(d, 32) ThenBlock: { ReturnValue(kind) }
        IfCondition EqualTo(d, 9) ThenBlock: { ReturnValue(kind) }
        IfCondition EqualTo(d, 35) ThenBlock: { ReturnValue(kind) }
        ReturnValue(0)
    }
}

Function.YAML.LineClass {
    Input: rec: Address
    Output: Integer
    Body: {
        st = RDMEM_64(rec)
        ln = RDMEM_64(rec, 8)
        ind = RDMEM_64(rec, 16)
        clen = Subtract(ln, ind)
        IfCondition LessEqual(clen, 0) ThenBlock: {
            ReturnValue(0)
        }
        base = Add(st, ind)
        p = 0
        kind = 0
        looping = 1
        WhileLoop EqualTo(looping, 1) {
            IfCondition GreaterEqual(p, clen) ThenBlock: {
                kind = 0
                looping = 0
            } ElseBlock: {
                b = RDMEM_8(Add(YP.buf, Add(base, p)))
                IfCondition EqualTo(b, 32) ThenBlock: {
                    p = Add(p, 1)
                } ElseBlock: {
                    IfCondition EqualTo(b, 9) ThenBlock: {
                        p = Add(p, 1)
                    } ElseBlock: {
                        IfCondition EqualTo(b, 35) ThenBlock: {
                            kind = 1
                        } ElseBlock: {
                            kind = 2
                        }
                        looping = 0
                    }
                }
            }
        }
        ReturnValue(kind)
    }
}

Function.YAML.ContentFrom {
    Input: rec: Address
    Output: Integer
    Body: {
        st = RDMEM_64(rec)
        ln = RDMEM_64(rec, 8)
        ind = RDMEM_64(rec, 16)
        base = Add(st, ind)
        clen = Subtract(ln, ind)
        p = 0
        looping = 1
        WhileLoop EqualTo(looping, 1) {
            IfCondition GreaterEqual(p, clen) ThenBlock: {
                looping = 0
            } ElseBlock: {
                b = RDMEM_8(Add(YP.buf, Add(base, p)))
                IfCondition EqualTo(b, 32) ThenBlock: {
                    p = Add(p, 1)
                } ElseBlock: {
                    IfCondition EqualTo(b, 9) ThenBlock: {
                        p = Add(p, 1)
                    } ElseBlock: {
                        looping = 0
                    }
                }
            }
        }
        ReturnValue(Add(base, p))
    }
}
