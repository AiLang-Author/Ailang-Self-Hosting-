// Event text for the YAML test suite, and JSON under the Core schema.
// Copyright (c) 2026 Sean Collins, 2 Paws Machine and Engineering. SCSL.

Function.YAML.EmitProps {
    Input: node: Address
    Body: {
        anc = RDMEM_64(node, 16)
        tag = RDMEM_64(node, 24)
        IfCondition NotEqual(anc, 0) ThenBlock: {
            YB.Str(" &")
            YB.Str(anc)
        }
        IfCondition NotEqual(tag, 0) ThenBlock: {
            YB.Str(" <")
            YB.Str(tag)
            YB.Byte(62)
        }
    }
}

Function.YAML.EmitEscaped {
    Input: text: Address
    Input: n: Integer
    Body: {
        i = 0
        WhileLoop LessThan(i, n) {
            b = RDMEM_8(Add(text, i))
            IfCondition EqualTo(b, 92) ThenBlock: {
                YB.Byte(92)
                YB.Byte(92)
            } ElseBlock: {
                IfCondition EqualTo(b, 10) ThenBlock: {
                    YB.Byte(92)
                    YB.Byte(110)
                } ElseBlock: {
                    IfCondition EqualTo(b, 9) ThenBlock: {
                        YB.Byte(92)
                        YB.Byte(116)
                    } ElseBlock: {
                        IfCondition EqualTo(b, 13) ThenBlock: {
                            YB.Byte(92)
                            YB.Byte(114)
                        } ElseBlock: {
                            IfCondition EqualTo(b, 8) ThenBlock: {
                                YB.Byte(92)
                                YB.Byte(98)
                            } ElseBlock: {
                                YB.Byte(b)
                            }
                        }
                    }
                }
            }
            i = Add(i, 1)
        }
    }
}

Function.YAML.EmitEventNode {
    Input: node: Address
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: {
            ReturnValue(0)
        }
        kind = RDMEM_64(node)
        IfCondition EqualTo(kind, 4) ThenBlock: {
            YB.Str("=ALI *")
            name = RDMEM_64(node, 32)
            YB.Str(name)
            YB.Byte(10)
            ReturnValue(0)
        }
        IfCondition EqualTo(kind, 2) ThenBlock: {
            YB.Str("+SEQ")
            style = RDMEM_64(node, 8)
            IfCondition EqualTo(style, 8) ThenBlock: {
                YB.Str(" []")
            }
            YAML.EmitProps(node)
            YB.Byte(10)
            arr = RDMEM_64(node, 32)
            IfCondition NotEqual(arr, 0) ThenBlock: {
                n = Array.Size(arr)
                i = 0
                WhileLoop LessThan(i, n) {
                    it = Array.Get(arr, i)
                    YAML.EmitEventNode(it)
                    i = Add(i, 1)
                }
            }
            YB.Str("-SEQ")
            YB.Byte(10)
            ReturnValue(0)
        }
        IfCondition EqualTo(kind, 3) ThenBlock: {
            YB.Str("+MAP")
            style = RDMEM_64(node, 8)
            IfCondition EqualTo(style, 8) ThenBlock: {
                YB.Str(" {}")
            }
            YAML.EmitProps(node)
            YB.Byte(10)
            ka = RDMEM_64(node, 32)
            va = RDMEM_64(node, 40)
            IfCondition NotEqual(ka, 0) ThenBlock: {
                n = Array.Size(ka)
                i = 0
                WhileLoop LessThan(i, n) {
                    k = Array.Get(ka, i)
                    v = Array.Get(va, i)
                    YAML.EmitEventNode(k)
                    YAML.EmitEventNode(v)
                    i = Add(i, 1)
                }
            }
            YB.Str("-MAP")
            YB.Byte(10)
            ReturnValue(0)
        }
        YB.Str("=VAL")
        YAML.EmitProps(node)
        YB.Byte(32)
        style = RDMEM_64(node, 8)
        ch = 58
        IfCondition EqualTo(style, 1) ThenBlock: { ch = 34 }
        IfCondition EqualTo(style, 2) ThenBlock: { ch = 39 }
        IfCondition EqualTo(style, 3) ThenBlock: { ch = 124 }
        IfCondition EqualTo(style, 4) ThenBlock: { ch = 62 }
        YB.Byte(ch)
        text = RDMEM_64(node, 32)
        sl = RDMEM_64(node, 48)
        IfCondition NotEqual(text, 0) ThenBlock: {
            YAML.EmitEscaped(text, sl)
        }
        YB.Byte(10)
        ReturnValue(0)
    }
}

Function.YAML.EmitEvents {
    Output: Address
    Body: {
        YB.Reset()
        YB.Str("+STR")
        YB.Byte(10)
        IfCondition NotEqual(YP.docs, 0) ThenBlock: {
            n = Array.Size(YP.docs)
            i = 0
            WhileLoop LessThan(i, n) {
                rec = Array.Get(YP.docs, i)
                node = RDMEM_64(rec)
                explicit = RDMEM_64(rec, 8)
                footer = RDMEM_64(rec, 16)
                IfCondition EqualTo(explicit, 1) ThenBlock: {
                    YB.Str("+DOC ---")
                } ElseBlock: {
                    YB.Str("+DOC")
                }
                YB.Byte(10)
                YAML.EmitEventNode(node)
                IfCondition EqualTo(footer, 1) ThenBlock: {
                    YB.Str("-DOC ...")
                } ElseBlock: {
                    YB.Str("-DOC")
                }
                YB.Byte(10)
                i = Add(i, 1)
            }
        }
        YB.Str("-STR")
        YB.Byte(10)
        text = YB.Take()
        ReturnValue(text)
    }
}

Function.YAML.JsonHex2 {
    Input: v: Integer
    Body: {
        hi = Divide(v, 16)
        lo = Subtract(v, Multiply(hi, 16))
        IfCondition LessThan(hi, 10) ThenBlock: {
            YB.Byte(Add(48, hi))
        } ElseBlock: {
            YB.Byte(Add(87, hi))
        }
        IfCondition LessThan(lo, 10) ThenBlock: {
            YB.Byte(Add(48, lo))
        } ElseBlock: {
            YB.Byte(Add(87, lo))
        }
    }
}

Function.YAML.JsonString {
    Input: text: Address
    Input: n: Integer
    Body: {
        YB.Byte(34)
        i = 0
        WhileLoop LessThan(i, n) {
            b = RDMEM_8(Add(text, i))
            IfCondition EqualTo(b, 34) ThenBlock: {
                YB.Byte(92)
                YB.Byte(34)
            } ElseBlock: {
                IfCondition EqualTo(b, 92) ThenBlock: {
                    YB.Byte(92)
                    YB.Byte(92)
                } ElseBlock: {
                    IfCondition EqualTo(b, 10) ThenBlock: {
                        YB.Byte(92)
                        YB.Byte(110)
                    } ElseBlock: {
                        IfCondition EqualTo(b, 13) ThenBlock: {
                            YB.Byte(92)
                            YB.Byte(114)
                        } ElseBlock: {
                            IfCondition EqualTo(b, 9) ThenBlock: {
                                YB.Byte(92)
                                YB.Byte(116)
                            } ElseBlock: {
                                IfCondition EqualTo(b, 8) ThenBlock: {
                                    YB.Byte(92)
                                    YB.Byte(98)
                                } ElseBlock: {
                                    IfCondition EqualTo(b, 12) ThenBlock: {
                                        YB.Byte(92)
                                        YB.Byte(102)
                                    } ElseBlock: {
                                        IfCondition LessThan(b, 32) ThenBlock: {
                                            YB.Byte(92)
                                            YB.Byte(117)
                                            YB.Byte(48)
                                            YB.Byte(48)
                                            YAML.JsonHex2(b)
                                        } ElseBlock: {
                                            YB.Byte(b)
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
            i = Add(i, 1)
        }
        YB.Byte(34)
    }
}

Function.YAML.EmitInt {
    Input: v: Integer
    Body: {
        neg = 0
        n = v
        IfCondition LessThan(n, 0) ThenBlock: {
            neg = 1
            n = Subtract(0, n)
        }
        IfCondition EqualTo(neg, 1) ThenBlock: {
            YB.Byte(45)
        }
        IfCondition EqualTo(n, 0) ThenBlock: {
            YB.Byte(48)
        } ElseBlock: {
            buf = Allocate(24)
            i = 0
            WhileLoop GreaterThan(n, 0) {
                q = Divide(n, 10)
                d = Subtract(n, Multiply(q, 10))
                WRMEM_8(buf, i, Add(48, d))
                i = Add(i, 1)
                n = q
            }
            WhileLoop GreaterThan(i, 0) {
                i = Subtract(i, 1)
                b = RDMEM_8(Add(buf, i))
                YB.Byte(b)
            }
        }
    }
}

Function.YAML.EmitJsonNode {
    Input: node: Address
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: {
            YB.Str("null")
            ReturnValue(0)
        }
        mark = RDMEM_64(node, 72)
        IfCondition EqualTo(mark, 1) ThenBlock: {
            YB.Str("null")
            ReturnValue(0)
        }
        kind = RDMEM_64(node)
        IfCondition EqualTo(kind, 4) ThenBlock: {
            tgt = RDMEM_64(node, 40)
            IfCondition EqualTo(tgt, 0) ThenBlock: {
                YB.Str("null")
            } ElseBlock: {
                YAML.EmitJsonNode(tgt)
            }
            ReturnValue(0)
        }
        WRMEM_64(node, 72, 1)
        IfCondition EqualTo(kind, 2) ThenBlock: {
            YB.Byte(91)
            arr = RDMEM_64(node, 32)
            IfCondition NotEqual(arr, 0) ThenBlock: {
                n = Array.Size(arr)
                i = 0
                WhileLoop LessThan(i, n) {
                    IfCondition GreaterThan(i, 0) ThenBlock: {
                        YB.Byte(44)
                    }
                    it = Array.Get(arr, i)
                    YAML.EmitJsonNode(it)
                    i = Add(i, 1)
                }
            }
            YB.Byte(93)
        } ElseBlock: {
            IfCondition EqualTo(kind, 3) ThenBlock: {
                YB.Byte(123)
                ka = RDMEM_64(node, 32)
                va = RDMEM_64(node, 40)
                IfCondition NotEqual(ka, 0) ThenBlock: {
                    n = Array.Size(ka)
                    i = 0
                    WhileLoop LessThan(i, n) {
                        IfCondition GreaterThan(i, 0) ThenBlock: {
                            YB.Byte(44)
                        }
                        k = Array.Get(ka, i)
                        v = Array.Get(va, i)
                        YAML.EmitJsonKey(k)
                        YB.Byte(58)
                        YAML.EmitJsonNode(v)
                        i = Add(i, 1)
                    }
                }
                YB.Byte(125)
            } ElseBlock: {
                YAML.EmitJsonScalar(node)
            }
        }
        WRMEM_64(node, 72, 0)
        ReturnValue(0)
    }
}

Function.YAML.EmitJsonKey {
    Input: node: Address
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: {
            YB.Str("null")
            ReturnValue(0)
        }
        kind = RDMEM_64(node)
        IfCondition EqualTo(kind, 4) ThenBlock: {
            tgt = RDMEM_64(node, 40)
            YAML.EmitJsonKey(tgt)
            ReturnValue(0)
        }
        IfCondition EqualTo(kind, 1) ThenBlock: {
            res = RDMEM_64(node, 56)
            IfCondition EqualTo(res, 0) ThenBlock: {
                text = RDMEM_64(node, 32)
                sl = RDMEM_64(node, 48)
                YAML.JsonString(text, sl)
            } ElseBlock: {
                YAML.EmitJsonScalar(node)
            }
            ReturnValue(0)
        }
        YAML.EmitJsonNode(node)
        ReturnValue(0)
    }
}

Function.YAML.EmitJsonScalar {
    Input: node: Address
    Body: {
        res = RDMEM_64(node, 56)
        text = RDMEM_64(node, 32)
        sl = RDMEM_64(node, 48)
        IfCondition EqualTo(res, 1) ThenBlock: {
            YB.Str("null")
        } ElseBlock: {
            IfCondition EqualTo(res, 2) ThenBlock: {
                bit = RDMEM_64(node, 64)
                IfCondition EqualTo(bit, 1) ThenBlock: {
                    YB.Str("true")
                } ElseBlock: {
                    YB.Str("false")
                }
            } ElseBlock: {
                IfCondition EqualTo(res, 3) ThenBlock: {
                    v = RDMEM_64(node, 64)
                    YAML.EmitInt(v)
                } ElseBlock: {
                    IfCondition EqualTo(res, 4) ThenBlock: {
                        IfCondition EqualTo(text, 0) ThenBlock: {
                            YB.Str("0")
                        } ElseBlock: {
                            YAML.EmitEscaped(text, sl)
                        }
                    } ElseBlock: {
                        IfCondition EqualTo(text, 0) ThenBlock: {
                            YB.Str("\"\"")
                        } ElseBlock: {
                            YAML.JsonString(text, sl)
                        }
                    }
                }
            }
        }
    }
}

Function.YAML.EmitJSON {
    Output: Address
    Body: {
        YB.Reset()
        IfCondition NotEqual(YP.docs, 0) ThenBlock: {
            n = Array.Size(YP.docs)
            i = 0
            WhileLoop LessThan(i, n) {
                rec = Array.Get(YP.docs, i)
                node = RDMEM_64(rec)
                YAML.EmitJsonNode(node)
                YB.Byte(10)
                i = Add(i, 1)
            }
        }
        text = YB.Take()
        ReturnValue(text)
    }
}
