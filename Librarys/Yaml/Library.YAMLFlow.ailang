Function.YAML.FlowBreak {
    Input: c: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(c, -1) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(c, 44) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(c, 91) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(c, 93) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(c, 123) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(c, 125) ThenBlock: { ReturnValue(1) }
        IfCondition EqualTo(c, 35) ThenBlock: { ReturnValue(1) }
        ReturnValue(0)
    }
}

Function.YAML.FlowLineBad {
    Body: {
        IfCondition LessEqual(YP.fmin, -2) ThenBlock: {
            ReturnValue(0)
        }
        rel = 0
        found = 0
        walking = 1
        WhileLoop EqualTo(walking, 1) {
            b = YAML.AtRel(rel)
            IfCondition EqualTo(b, -1) ThenBlock: {
                walking = 0
            } ElseBlock: {
                ws = 0
                IfCondition EqualTo(b, 32) ThenBlock: { ws = 1 }
                IfCondition EqualTo(b, 9) ThenBlock: { ws = 1 }
                IfCondition EqualTo(ws, 1) ThenBlock: {
                    rel = Add(rel, 1)
                } ElseBlock: {
                    IfCondition EqualTo(b, 35) ThenBlock: {
                        walking = 0
                    } ElseBlock: {
                        closerb = 0
                        IfCondition EqualTo(b, 93) ThenBlock: { closerb = 1 }
                        IfCondition EqualTo(b, 125) ThenBlock: { closerb = 1 }
                        IfCondition EqualTo(closerb, 1) ThenBlock: {
                            walking = 0
                        } ElseBlock: {
                            found = 1
                            walking = 0
                        }
                    }
                }
            }
        }
        IfCondition EqualTo(found, 1) ThenBlock: {
            tab0 = 0
            IfCondition EqualTo(YP.tabind, 1) ThenBlock: {
                IfCondition EqualTo(YP.ind, 0) ThenBlock: {
                    IfCondition EqualTo(YP.col, 0) ThenBlock: {
                        tab0 = 1
                    }
                }
            }
            IfCondition EqualTo(tab0, 1) ThenBlock: {
                YAML.Fail("tab in flow")
            } ElseBlock: {
                IfCondition LessEqual(YP.ind, YP.fmin) ThenBlock: {
                    YAML.Fail("bad flow indent")
                }
            }
        }
        ReturnValue(0)
    }
}

Function.YAML.SkipFlowSpace {
    Output: Integer
    Body: {
        looping = 1
        WhileLoop EqualTo(looping, 1) {
            IfCondition EqualTo(YP.err, 1) ThenBlock: {
                looping = 0
            } ElseBlock: {
                c = YAML.Peek()
                IfCondition EqualTo(c, -1) ThenBlock: {
                    ok = YAML.Ensure()
                    IfCondition EqualTo(YP.ready, 0) ThenBlock: {
                        ok = 0
                    }
                    IfCondition EqualTo(ok, 0) ThenBlock: {
                        nleft = Array.Size(YP.lines)
                        IfCondition GreaterEqual(YP.idx, nleft) ThenBlock: {
                            looping = 0
                        } ElseBlock: {
                            YAML.FinishLine()
                            more = YAML.Ensure()
                            IfCondition EqualTo(more, 0) ThenBlock: {
                                looping = 0
                            } ElseBlock: {
                                YAML.FlowLineBad()
                            }
                        }
                    } ElseBlock: {
                        YAML.FinishLine()
                        more = YAML.Ensure()
                        IfCondition EqualTo(more, 0) ThenBlock: {
                            looping = 0
                        } ElseBlock: {
                            YAML.FlowLineBad()
                        }
                    }
                } ElseBlock: {
                    IfCondition EqualTo(c, 32) ThenBlock: {
                        YAML.Bump()
                    } ElseBlock: {
                        IfCondition EqualTo(c, 9) ThenBlock: {
                            YAML.Bump()
                        } ElseBlock: {
                            ac = YAML.AtComment()
                            IfCondition EqualTo(ac, 1) ThenBlock: {
                                YAML.FinishLine()
                                more = YAML.Ensure()
                                IfCondition EqualTo(more, 0) ThenBlock: {
                                    looping = 0
                                } ElseBlock: {
                                    YAML.FlowLineBad()
                                }
                            } ElseBlock: {
                                looping = 0
                            }
                        }
                    }
                }
            }
        }
        IfCondition EqualTo(YP.err, 1) ThenBlock: {
            ReturnValue(0)
        }
        ReturnValue(1)
    }
}

Function.YAML.ParseFlowPlain {
    Input: stop_colon: Integer
    Output: Address
    Body: {
        SB.Reset()
        c0 = YAML.Peek()
        IfCondition EqualTo(c0, 45) ThenBlock: {
            n1 = YAML.AtRel(1)
            dashbad = 0
            IfCondition EqualTo(n1, -1) ThenBlock: { dashbad = 1 }
            IfCondition EqualTo(n1, 32) ThenBlock: { dashbad = 1 }
            IfCondition EqualTo(n1, 9) ThenBlock: { dashbad = 1 }
            dbr = YAML.FlowBreak(n1)
            IfCondition EqualTo(dbr, 1) ThenBlock: { dashbad = 1 }
            IfCondition EqualTo(dashbad, 1) ThenBlock: {
                YAML.Fail("dash in flow")
            }
        }
        looping = 1
        WhileLoop EqualTo(looping, 1) {
            c = YAML.Peek()
            IfCondition EqualTo(c, -1) ThenBlock: {
                spot = YAML.SavePos()
                YAML.FinishLine()
                more = YAML.Ensure()
                IfCondition EqualTo(more, 0) ThenBlock: {
                    looping = 0
                } ElseBlock: {
                    mkp = YAML.MarkerKind()
                    IfCondition NotEqual(mkp, 0) ThenBlock: {
                        YAML.Fail("marker in flow")
                    }
                    YAML.FlowLineBad()
                    IfCondition EqualTo(YP.err, 1) ThenBlock: {
                        YAML.RestorePos(spot)
                        looping = 0
                    } ElseBlock: {
                    empties = 0
                    scanning = 1
                    c2 = -1
                    WhileLoop EqualTo(scanning, 1) {
                        YAML.SkipHSpace()
                        c2 = YAML.Peek()
                        IfCondition EqualTo(c2, -1) ThenBlock: {
                            empties = Add(empties, 1)
                            YAML.FinishLine()
                            more2 = YAML.Ensure()
                            IfCondition EqualTo(more2, 0) ThenBlock: {
                                YAML.RestorePos(spot)
                                looping = 0
                                scanning = 0
                            }
                        } ElseBlock: {
                            mk2 = YAML.MarkerKind()
                            IfCondition NotEqual(mk2, 0) ThenBlock: {
                                YAML.Fail("marker in flow")
                            }
                            YAML.FlowLineBad()
                            IfCondition EqualTo(YP.err, 1) ThenBlock: {
                                YAML.RestorePos(spot)
                                looping = 0
                            }
                            scanning = 0
                        }
                    }
                    IfCondition EqualTo(looping, 1) ThenBlock: {
                        stop2 = YAML.FlowBreak(c2)
                        IfCondition EqualTo(c2, 58) ThenBlock: {
                            IfCondition EqualTo(stop_colon, 1) ThenBlock: {
                                n1 = YAML.AtRel(1)
                                sep = 0
                                IfCondition EqualTo(n1, -1) ThenBlock: { sep = 1 }
                                IfCondition EqualTo(n1, 32) ThenBlock: { sep = 1 }
                                IfCondition EqualTo(n1, 9) ThenBlock: { sep = 1 }
                                IfCondition EqualTo(n1, 44) ThenBlock: { sep = 1 }
                                IfCondition EqualTo(n1, 93) ThenBlock: { sep = 1 }
                                IfCondition EqualTo(n1, 125) ThenBlock: { sep = 1 }
                                IfCondition EqualTo(n1, 35) ThenBlock: { sep = 1 }
                                IfCondition EqualTo(sep, 1) ThenBlock: {
                                    stop2 = 1
                                }
                            }
                        }
                        IfCondition EqualTo(stop2, 1) ThenBlock: {
                            YAML.RestorePos(spot)
                            looping = 0
                        } ElseBlock: {
                            IfCondition GreaterThan(empties, 0) ThenBlock: {
                                t = 0
                                WhileLoop LessThan(t, empties) {
                                    SB.Byte(10)
                                    t = Add(t, 1)
                                }
                            } ElseBlock: {
                                IfCondition GreaterThan(SB.len, 0) ThenBlock: {
                                    SB.Byte(32)
                                }
                            }
                        }
                    }
                    }
                }
            } ElseBlock: {
                br = YAML.FlowBreak(c)
                IfCondition EqualTo(br, 1) ThenBlock: {
                    ac = 0
                    IfCondition EqualTo(c, 35) ThenBlock: {
                        ac = YAML.AtComment()
                    }
                    IfCondition EqualTo(c, 35) ThenBlock: {
                        IfCondition EqualTo(ac, 1) ThenBlock: {
                            looping = 0
                        } ElseBlock: {
                            SB.Byte(c)
                            YAML.Bump()
                        }
                    } ElseBlock: {
                        looping = 0
                    }
                } ElseBlock: {
                    IfCondition EqualTo(c, 58) ThenBlock: {
                        n1 = YAML.AtRel(1)
                        sep = 0
                        IfCondition EqualTo(n1, -1) ThenBlock: { sep = 1 }
                        IfCondition EqualTo(n1, 32) ThenBlock: { sep = 1 }
                        IfCondition EqualTo(n1, 9) ThenBlock: { sep = 1 }
                        IfCondition EqualTo(n1, 44) ThenBlock: { sep = 1 }
                        IfCondition EqualTo(n1, 93) ThenBlock: { sep = 1 }
                        IfCondition EqualTo(n1, 125) ThenBlock: { sep = 1 }
                        IfCondition EqualTo(n1, 35) ThenBlock: { sep = 1 }
                        IfCondition EqualTo(sep, 1) ThenBlock: {
                            looping = 0
                        } ElseBlock: {
                            SB.Byte(c)
                            YAML.Bump()
                        }
                    } ElseBlock: {
                        SB.Byte(c)
                        YAML.Bump()
                    }
                }
            }
        }
        YAML.TrimSB()
        text = SB.Take()
        sl = SB.last
        node = YAML.NewNode(1)
        WRMEM_64(node, 32, text)
        WRMEM_64(node, 48, sl)
        YAML.ResolveTagged(node)
        ReturnValue(node)
    }
}

Function.YAML.ParseFlowNode {
    Input: stop_colon: Integer
    Output: Address
    Body: {
        YAML.SkipFlowSpace()
        IfCondition EqualTo(YP.err, 1) ThenBlock: {
            ReturnValue(0)
        }
        fmk = YAML.MarkerKind()
        IfCondition NotEqual(fmk, 0) ThenBlock: {
            YAML.Fail("marker in flow")
            ReturnValue(0)
        }
        props_anchor = 0
        props_tag = 0
        got = YAML.ReadProps()
        props_anchor = RDMEM_64(got)
        props_tag = RDMEM_64(got, 8)
        YAML.SkipFlowSpace()
        c = YAML.Peek()
        node = 0
        flowed = 0
        explicit_key = 0
        IfCondition EqualTo(stop_colon, 1) ThenBlock: {
            IfCondition EqualTo(c, 63) ThenBlock: {
                n1 = YAML.AtRel(1)
                indc = 0
                IfCondition LessEqual(n1, 32) ThenBlock: { indc = 1 }
                IfCondition EqualTo(n1, 44) ThenBlock: { indc = 1 }
                IfCondition EqualTo(n1, 58) ThenBlock: { indc = 1 }
                IfCondition EqualTo(n1, 93) ThenBlock: { indc = 1 }
                IfCondition EqualTo(n1, 125) ThenBlock: { indc = 1 }
                IfCondition EqualTo(n1, 35) ThenBlock: { indc = 1 }
                IfCondition EqualTo(indc, 1) ThenBlock: {
                    explicit_key = 1
                    YAML.Bump()
                    YAML.SkipFlowSpace()
                    c2 = YAML.Peek()
                    emptyk = 0
                    IfCondition EqualTo(c2, 58) ThenBlock: { emptyk = 1 }
                    IfCondition EqualTo(c2, 44) ThenBlock: { emptyk = 1 }
                    IfCondition EqualTo(c2, 93) ThenBlock: { emptyk = 1 }
                    IfCondition EqualTo(c2, 125) ThenBlock: { emptyk = 1 }
                    IfCondition EqualTo(c2, -1) ThenBlock: { emptyk = 1 }
                    IfCondition EqualTo(emptyk, 1) ThenBlock: {
                        node = YAML.EmptyScalar()
                    } ElseBlock: {
                        node = YAML.ParseFlowNode(1)
                    }
                }
            }
        }
        IfCondition EqualTo(explicit_key, 0) ThenBlock: {
        IfCondition EqualTo(c, 42) ThenBlock: {
            node = YAML.ParseAlias()
        } ElseBlock: {
            IfCondition EqualTo(c, 34) ThenBlock: {
                node = YAML.ParseQuoted(34, YP.fmin)
            } ElseBlock: {
                IfCondition EqualTo(c, 39) ThenBlock: {
                    node = YAML.ParseQuoted(39, YP.fmin)
                } ElseBlock: {
                    IfCondition EqualTo(c, 91) ThenBlock: {
                        node = YAML.ParseFlow(93, props_anchor, props_tag, YP.fmin)
                        flowed = 1
                    } ElseBlock: {
                        IfCondition EqualTo(c, 123) ThenBlock: {
                            node = YAML.ParseFlow(125, props_anchor, props_tag, YP.fmin)
                            flowed = 1
                        } ElseBlock: {
                            IfCondition EqualTo(c, -1) ThenBlock: {
                                node = YAML.EmptyScalar()
                            } ElseBlock: {
                                br = YAML.FlowBreak(c)
                                IfCondition EqualTo(br, 1) ThenBlock: {
                                    IfCondition EqualTo(c, 35) ThenBlock: {
                                        YAML.Fail("bad flow node")
                                        node = 0
                                    } ElseBlock: {
                                        node = YAML.EmptyScalar()
                                    }
                                } ElseBlock: {
                                    node = YAML.ParseFlowPlain(stop_colon)
                                }
                            }
                        }
                    }
                }
            }
        }
        }
        IfCondition EqualTo(flowed, 0) ThenBlock: {
            YAML.ApplyProps(node, props_anchor, props_tag)
        }
        ReturnValue(node)
    }
}

Function.YAML.ParseFlow {
    Input: closer: Integer
    Input: anchor: Address
    Input: tag: Address
    Input: parent: Integer
    Output: Address
    Body: {
        saved_min = YP.fmin
        IfCondition EqualTo(YP.fmin, -2) ThenBlock: {
            YP.fmin = parent
        }
        open = YAML.Peek()
        YAML.Bump()
        node = 0
        is_map = 0
        IfCondition EqualTo(closer, 125) ThenBlock: {
            is_map = 1
            node = YAML.NewNode(3)
            ka = Array.Create(4)
            va = Array.Create(4)
            WRMEM_64(node, 32, ka)
            WRMEM_64(node, 40, va)
        } ElseBlock: {
            node = YAML.NewNode(2)
            sa = Array.Create(4)
            WRMEM_64(node, 32, sa)
        }
        WRMEM_64(node, 8, 8)
        YAML.ApplyProps(node, anchor, tag)
        looping = 1
        WhileLoop EqualTo(looping, 1) {
            IfCondition EqualTo(YP.err, 1) ThenBlock: {
                looping = 0
            } ElseBlock: {
                YAML.SkipFlowSpace()
                c = YAML.Peek()
                IfCondition EqualTo(c, closer) ThenBlock: {
                    YAML.Bump()
                    looping = 0
                } ElseBlock: {
                    IfCondition EqualTo(c, -1) ThenBlock: {
                        YAML.Fail("unclosed flow")
                        looping = 0
                    } ElseBlock: {
                        IfCondition EqualTo(is_map, 1) ThenBlock: {
                            IfCondition EqualTo(c, 44) ThenBlock: {
                                YAML.Fail("bad flow comma")
                                looping = 0
                            } ElseBlock: {
                                IfCondition EqualTo(c, 58) ThenBlock: {
                                    key = YAML.EmptyScalar()
                                    YAML.Bump()
                                    YAML.SkipFlowSpace()
                                    c2 = YAML.Peek()
                                    val = 0
                                    IfCondition EqualTo(c2, 44) ThenBlock: {
                                        val = YAML.EmptyScalar()
                                    } ElseBlock: {
                                        IfCondition EqualTo(c2, closer) ThenBlock: {
                                            val = YAML.EmptyScalar()
                                        } ElseBlock: {
                                            val = YAML.ParseFlowNode(0)
                                        }
                                    }
                                    Array.Push(RDMEM_64(node, 32), key)
                                    Array.Push(RDMEM_64(node, 40), val)
                                } ElseBlock: {
                                    key = YAML.ParseFlowNode(1)
                                    YAML.SkipFlowSpace()
                                    c2 = YAML.Peek()
                                    val = 0
                                    IfCondition EqualTo(c2, 58) ThenBlock: {
                                        YAML.Bump()
                                        YAML.SkipFlowSpace()
                                        c3 = YAML.Peek()
                                        IfCondition EqualTo(c3, 44) ThenBlock: {
                                            val = YAML.EmptyScalar()
                                        } ElseBlock: {
                                            IfCondition EqualTo(c3, closer) ThenBlock: {
                                                val = YAML.EmptyScalar()
                                            } ElseBlock: {
                                                IfCondition EqualTo(c3, -1) ThenBlock: {
                                                    val = YAML.EmptyScalar()
                                                } ElseBlock: {
                                                    val = YAML.ParseFlowNode(0)
                                                }
                                            }
                                        }
                                    } ElseBlock: {
                                        val = YAML.EmptyScalar()
                                    }
                                    Array.Push(RDMEM_64(node, 32), key)
                                    Array.Push(RDMEM_64(node, 40), val)
                                }
                                YAML.SkipFlowSpace()
                                c4 = YAML.Peek()
                                IfCondition EqualTo(c4, 44) ThenBlock: {
                                    YAML.Bump()
                                } ElseBlock: {
                                    IfCondition NotEqual(c4, closer) ThenBlock: {
                                        IfCondition NotEqual(c4, -1) ThenBlock: {
                                            YAML.Fail("missing flow comma")
                                            looping = 0
                                        }
                                    }
                                }
                            }
                        } ElseBlock: {
                            IfCondition EqualTo(c, 44) ThenBlock: {
                                YAML.Fail("bad flow comma")
                                looping = 0
                            } ElseBlock: {
                                item = YAML.ParseFlowNode(1)
                                IfCondition EqualTo(YP.err, 1) ThenBlock: {
                                    looping = 0
                                } ElseBlock: {
                                    key_line = YP.idx
                                    YAML.SkipFlowSpace()
                                    c4 = YAML.Peek()
                                    IfCondition EqualTo(c4, 58) ThenBlock: {
                                        IfCondition NotEqual(YP.idx, key_line) ThenBlock: {
                                            YAML.Fail("flow key line")
                                        }
                                        YAML.Bump()
                                        YAML.SkipFlowSpace()
                                        c3 = YAML.Peek()
                                        emptyv = 0
                                        IfCondition EqualTo(c3, 44) ThenBlock: { emptyv = 1 }
                                        IfCondition EqualTo(c3, closer) ThenBlock: { emptyv = 1 }
                                        IfCondition EqualTo(c3, -1) ThenBlock: { emptyv = 1 }
                                        val = 0
                                        IfCondition EqualTo(emptyv, 1) ThenBlock: {
                                            val = YAML.EmptyScalar()
                                        } ElseBlock: {
                                            val = YAML.ParseFlowNode(0)
                                        }
                                        mapn = YAML.NewNode(3)
                                        WRMEM_64(mapn, 8, 8)
                                        ka = Array.Create(2)
                                        va = Array.Create(2)
                                        WRMEM_64(mapn, 32, ka)
                                        WRMEM_64(mapn, 40, va)
                                        Array.Push(ka, item)
                                        Array.Push(va, val)
                                        item = mapn
                                        YAML.SkipFlowSpace()
                                        c4 = YAML.Peek()
                                    }
                                    IfCondition EqualTo(YP.err, 1) ThenBlock: {
                                        looping = 0
                                    } ElseBlock: {
                                        Array.Push(RDMEM_64(node, 32), item)
                                        IfCondition EqualTo(c4, 44) ThenBlock: {
                                            YAML.Bump()
                                        } ElseBlock: {
                                            IfCondition NotEqual(c4, closer) ThenBlock: {
                                                IfCondition NotEqual(c4, -1) ThenBlock: {
                                                    YAML.Fail("missing flow comma")
                                                    looping = 0
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        YP.fmin = saved_min
        ReturnValue(node)
    }
}
