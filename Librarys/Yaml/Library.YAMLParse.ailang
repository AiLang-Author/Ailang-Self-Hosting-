// Block node parser and document stream.
// Copyright (c) 2026 Sean Collins, 2 Paws Machine and Engineering. SCSL.
//
// A plain scalar folds a single break to a space. Each empty line between
// the pieces becomes a newline. Lines at or above the parent indent stop it.
// A document marker stops it. A '%' line is content once the plain has started.
// A comment ends the scalar, so later lines are not folded in.

Function.YAML.ParseBlockPlain {
    Input: parent: Integer
    Output: Address
    Body: {
        from = YP.off
        to = YP.eol
        SB.Reset()
        cut0 = YAML.AppendPlain(from, to)
        broke = YAML.PlainBreak(from, to)
        IfCondition EqualTo(broke, 1) ThenBlock: {
            YAML.Fail("invalid mapping in plain")
        }
        YAML.FinishLine()
        nlines = Array.Size(YP.lines)
        looping = 1
        IfCondition EqualTo(cut0, 1) ThenBlock: {
            looping = 0
        }
        WhileLoop EqualTo(looping, 1) {
            IfCondition GreaterEqual(YP.idx, nlines) ThenBlock: {
                looping = 0
            } ElseBlock: {
                rec = Array.Get(YP.lines, YP.idx)
                mk = YAML.RecMarker(rec)
                ind = RDMEM_64(rec, 16)
                st = RDMEM_64(rec)
                cls = YAML.LineClass(rec)
                halt = 0
                IfCondition NotEqual(mk, 0) ThenBlock: { halt = 1 }
                IfCondition EqualTo(cls, 2) ThenBlock: {
                    IfCondition GreaterEqual(parent, 0) ThenBlock: {
                        IfCondition LessEqual(ind, parent) ThenBlock: { halt = 1 }
                    }
                }
                IfCondition EqualTo(halt, 1) ThenBlock: {
                    looping = 0
                } ElseBlock: {
                    IfCondition EqualTo(cls, 1) ThenBlock: {
                        YP.idx = Add(YP.idx, 1)
                        looping = 0
                    } ElseBlock: {
                        IfCondition EqualTo(cls, 0) ThenBlock: {
                            blanks = 0
                            counting = 1
                            WhileLoop EqualTo(counting, 1) {
                                IfCondition GreaterEqual(YP.idx, nlines) ThenBlock: {
                                    counting = 0
                                } ElseBlock: {
                                    recb = Array.Get(YP.lines, YP.idx)
                                    mkb = YAML.RecMarker(recb)
                                    clsb = YAML.LineClass(recb)
                                    IfCondition NotEqual(mkb, 0) ThenBlock: {
                                        counting = 0
                                    } ElseBlock: {
                                        IfCondition EqualTo(clsb, 0) ThenBlock: {
                                            blanks = Add(blanks, 1)
                                            YP.idx = Add(YP.idx, 1)
                                        } ElseBlock: {
                                            counting = 0
                                        }
                                    }
                                }
                            }
                            follow = 0
                            IfCondition LessThan(YP.idx, nlines) ThenBlock: {
                                rec2 = Array.Get(YP.lines, YP.idx)
                                mk2 = YAML.RecMarker(rec2)
                                cls2 = YAML.LineClass(rec2)
                                ind2 = RDMEM_64(rec2, 16)
                                IfCondition EqualTo(mk2, 0) ThenBlock: {
                                    IfCondition EqualTo(cls2, 2) ThenBlock: {
                                        keep = 1
                                        IfCondition GreaterEqual(parent, 0) ThenBlock: {
                                            IfCondition LessEqual(ind2, parent) ThenBlock: {
                                                keep = 0
                                            }
                                        }
                                        follow = keep
                                    }
                                }
                            }
                            IfCondition EqualTo(follow, 1) ThenBlock: {
                                k = 0
                                WhileLoop LessThan(k, blanks) {
                                    SB.Byte(10)
                                    k = Add(k, 1)
                                }
                            } ElseBlock: {
                                looping = 0
                            }
                        } ElseBlock: {
                            IfCondition GreaterThan(SB.len, 0) ThenBlock: {
                                lastp = Subtract(SB.len, 1)
                                lastb = RDMEM_8(Add(SB.data, lastp))
                                IfCondition NotEqual(lastb, 10) ThenBlock: {
                                    SB.Byte(32)
                                }
                            }
                            rec3 = Array.Get(YP.lines, YP.idx)
                            cfrom = YAML.ContentFrom(rec3)
                            cln = RDMEM_64(rec3, 8)
                            cst = RDMEM_64(rec3)
                            cto = Add(cst, cln)
                            cut3 = YAML.AppendPlain(cfrom, cto)
                            broke3 = YAML.PlainBreak(cfrom, cto)
                            IfCondition EqualTo(broke3, 1) ThenBlock: {
                                YAML.Fail("invalid mapping in plain")
                                looping = 0
                            }
                            YP.idx = Add(YP.idx, 1)
                            IfCondition EqualTo(cut3, 1) ThenBlock: {
                                looping = 0
                            }
                        }
                    }
                }
            }
        }
        YP.ready = 0
        text = SB.Take()
        sl = SB.last
        node = YAML.NewNode(1)
        WRMEM_64(node, 32, text)
        WRMEM_64(node, 48, sl)
        YAML.ResolveTagged(node)
        ReturnValue(node)
    }
}

Function.YAML.ParseBareSeq {
    Output: Address
    Body: {
        seq_col = YP.col
        node = YAML.NewNode(2)
        sa = Array.Create(4)
        WRMEM_64(node, 32, sa)
        YAML.FillBlockSeq(node, seq_col)
        ReturnValue(node)
    }
}

Function.YAML.ParseBrokenValue {
    Input: map_col: Integer
    Output: Address
    Body: {
        spot = YAML.SavePos()
        ok = YAML.SkipToContent()
        IfCondition EqualTo(ok, 0) ThenBlock: {
            ReturnValue(YAML.EmptyScalar())
        }
        mk = YAML.MarkerKind()
        IfCondition NotEqual(mk, 0) ThenBlock: {
            YAML.RestorePos(spot)
            ReturnValue(YAML.EmptyScalar())
        }
        IfCondition GreaterThan(YP.ind, map_col) ThenBlock: {
            node = YAML.ParseNode(map_col, 0)
            IfCondition EqualTo(node, 0) ThenBlock: {
                ReturnValue(YAML.EmptyScalar())
            }
            ReturnValue(node)
        }
        seq = 0
        IfCondition EqualTo(YP.ind, map_col) ThenBlock: {
            seq = YAML.StartsSeq()
        }
        IfCondition EqualTo(seq, 1) ThenBlock: {
            ReturnValue(YAML.ParseBareSeq())
        }
        c = YAML.Peek()
        special = 0
        keyed = YAML.HasImplicitKey()
        IfCondition EqualTo(keyed, 0) ThenBlock: {
            IfCondition EqualTo(YP.ind, map_col) ThenBlock: {
                IfCondition EqualTo(c, 124) ThenBlock: { special = 1 }
                IfCondition EqualTo(c, 62) ThenBlock: { special = 1 }
                IfCondition EqualTo(c, 91) ThenBlock: { special = 1 }
                IfCondition EqualTo(c, 123) ThenBlock: { special = 1 }
                IfCondition EqualTo(c, 34) ThenBlock: { special = 1 }
                IfCondition EqualTo(c, 39) ThenBlock: { special = 1 }
            }
        }
        IfCondition EqualTo(special, 1) ThenBlock: {
            node = YAML.ParseNodeHere(map_col)
            ReturnValue(node)
        }
        YAML.RestorePos(spot)
        ReturnValue(YAML.EmptyScalar())
    }
}

Function.YAML.ParseColonValue {
    Input: map_col: Integer
    Input: compact: Integer
    Output: Address
    Body: {
        YAML.Bump()
        YAML.SkipBlockSep()
        eol = YAML.AtEol()
        IfCondition EqualTo(eol, 0) ThenBlock: {
            spot = YAML.SavePos()
            got = YAML.ReadProps()
            anchor = RDMEM_64(got)
            tag = RDMEM_64(got, 8)
            YAML.SkipHSpace()
            held = 0
            IfCondition NotEqual(anchor, 0) ThenBlock: { held = 1 }
            IfCondition NotEqual(tag, 0) ThenBlock: { held = 1 }
            eol2 = YAML.AtEol()
            use_broken = 0
            IfCondition EqualTo(held, 1) ThenBlock: {
                IfCondition EqualTo(eol2, 1) ThenBlock: {
                    use_broken = 1
                }
            }
            IfCondition EqualTo(use_broken, 1) ThenBlock: {
                YAML.FinishLine()
                child = YAML.ParseBrokenValue(map_col)
                YAML.ApplyLoose(child, anchor, tag)
                ReturnValue(child)
            }
            YAML.RestorePos(spot)
            IfCondition EqualTo(compact, 0) ThenBlock: {
                nested = YAML.HasImplicitKey()
                IfCondition EqualTo(nested, 1) ThenBlock: {
                    YAML.Fail("invalid nested mapping")
                }
                seqv = YAML.StartsSeq()
                IfCondition EqualTo(seqv, 1) ThenBlock: {
                    YAML.Fail("compact sequence")
                }
            }
            node = YAML.ParseNode(map_col, 1)
            IfCondition EqualTo(node, 0) ThenBlock: {
                ReturnValue(YAML.EmptyScalar())
            }
            ReturnValue(node)
        }
        YAML.FinishLine()
        ReturnValue(YAML.ParseBrokenValue(map_col))
    }
}

Function.YAML.ParseBrokenKey {
    Input: map_col: Integer
    Output: Address
    Body: {
        spot = YAML.SavePos()
        ok = YAML.SkipToContent()
        IfCondition EqualTo(ok, 0) ThenBlock: {
            ReturnValue(YAML.EmptyScalar())
        }
        mk = YAML.MarkerKind()
        IfCondition NotEqual(mk, 0) ThenBlock: {
            YAML.RestorePos(spot)
            ReturnValue(YAML.EmptyScalar())
        }
        IfCondition GreaterThan(YP.ind, map_col) ThenBlock: {
            node = YAML.ParseNode(map_col, 0)
            IfCondition EqualTo(node, 0) ThenBlock: {
                ReturnValue(YAML.EmptyScalar())
            }
            ReturnValue(node)
        }
        seq = 0
        IfCondition EqualTo(YP.ind, map_col) ThenBlock: {
            seq = YAML.StartsSeq()
        }
        IfCondition EqualTo(seq, 1) ThenBlock: {
            ReturnValue(YAML.ParseBareSeq())
        }
        c = YAML.Peek()
        special = 0
        IfCondition EqualTo(YP.ind, map_col) ThenBlock: {
            IfCondition EqualTo(c, 124) ThenBlock: { special = 1 }
            IfCondition EqualTo(c, 62) ThenBlock: { special = 1 }
            IfCondition EqualTo(c, 91) ThenBlock: { special = 1 }
            IfCondition EqualTo(c, 123) ThenBlock: { special = 1 }
            IfCondition EqualTo(c, 34) ThenBlock: { special = 1 }
            IfCondition EqualTo(c, 39) ThenBlock: { special = 1 }
            IfCondition EqualTo(c, 42) ThenBlock: { special = 1 }
            IfCondition EqualTo(c, 33) ThenBlock: { special = 1 }
            IfCondition EqualTo(c, 38) ThenBlock: { special = 1 }
        }
        IfCondition EqualTo(special, 1) ThenBlock: {
            ReturnValue(YAML.ParseNodeHere(map_col))
        }
        YAML.RestorePos(spot)
        ReturnValue(YAML.EmptyScalar())
    }
}

Function.YAML.ParseExplicitKey {
    Input: map_col: Integer
    Output: Address
    Body: {
        YAML.Bump()
        YAML.SkipBlockSep()
        eol = YAML.AtEol()
        IfCondition EqualTo(eol, 1) ThenBlock: {
            YAML.FinishLine()
            ReturnValue(YAML.ParseBrokenKey(map_col))
        }
        c = YAML.Peek()
        seq = YAML.StartsSeq()
        IfCondition EqualTo(seq, 1) ThenBlock: {
            ReturnValue(YAML.ParseNode(map_col, 1))
        }
        special = 0
        IfCondition EqualTo(c, 124) ThenBlock: { special = 1 }
        IfCondition EqualTo(c, 62) ThenBlock: { special = 1 }
        IfCondition EqualTo(c, 91) ThenBlock: { special = 1 }
        IfCondition EqualTo(c, 123) ThenBlock: { special = 1 }
        IfCondition EqualTo(c, 34) ThenBlock: { special = 1 }
        IfCondition EqualTo(c, 39) ThenBlock: { special = 1 }
        IfCondition EqualTo(c, 42) ThenBlock: { special = 1 }
        IfCondition EqualTo(c, 33) ThenBlock: { special = 1 }
        IfCondition EqualTo(c, 38) ThenBlock: { special = 1 }
        linekey = YAML.HasImplicitKey()
        IfCondition EqualTo(linekey, 1) ThenBlock: {
            ReturnValue(YAML.ParseNode(map_col, 1))
        }
        IfCondition EqualTo(special, 1) ThenBlock: {
            ReturnValue(YAML.ParseNode(map_col, 1))
        }
        ReturnValue(YAML.ParseBlockPlain(map_col))
    }
}

Function.YAML.BindExplicitValue {
    Input: map_col: Integer
    Output: Address
    Body: {
        ok = YAML.Ensure()
        IfCondition EqualTo(ok, 0) ThenBlock: {
            ReturnValue(YAML.EmptyScalar())
        }
        YAML.SkipHSpace()
        hit = YAML.AtKeyColon()
        IfCondition EqualTo(hit, 1) ThenBlock: {
            ReturnValue(YAML.ParseColonValue(map_col, 1))
        }
        IfCondition EqualTo(YP.col, YP.ind) ThenBlock: {
            ReturnValue(YAML.EmptyScalar())
        }
        eol = YAML.AtEol()
        IfCondition EqualTo(eol, 1) ThenBlock: {
            YAML.FinishLine()
            spot = YAML.SavePos()
            ok2 = YAML.SkipToContent()
            IfCondition EqualTo(ok2, 1) ThenBlock: {
                IfCondition EqualTo(YP.ind, map_col) ThenBlock: {
                    hit2 = YAML.AtKeyColon()
                    IfCondition EqualTo(hit2, 1) ThenBlock: {
                        ReturnValue(YAML.ParseColonValue(map_col, 1))
                    }
                }
            }
            YAML.RestorePos(spot)
        }
        ReturnValue(YAML.EmptyScalar())
    }
}

Function.YAML.ParseImplicitKey {
    Output: Address
    Body: {
        got = YAML.ReadProps()
        anchor = RDMEM_64(got)
        tag = RDMEM_64(got, 8)
        YAML.SkipHSpace()
        c = YAML.Peek()
        hit = YAML.AtKeyColon()
        eol = YAML.AtEol()
        node = 0
        IfCondition EqualTo(hit, 1) ThenBlock: {
            node = YAML.EmptyScalar()
        } ElseBlock: {
            IfCondition EqualTo(eol, 1) ThenBlock: {
                node = YAML.EmptyScalar()
            } ElseBlock: {
                IfCondition EqualTo(c, 34) ThenBlock: {
                    node = YAML.ParseQuoted(34, YP.ind)
                } ElseBlock: {
                    IfCondition EqualTo(c, 39) ThenBlock: {
                        node = YAML.ParseQuoted(39, YP.ind)
                    } ElseBlock: {
                        IfCondition EqualTo(c, 42) ThenBlock: {
                            node = YAML.ParseAlias()
                        } ElseBlock: {
                            IfCondition EqualTo(c, 91) ThenBlock: {
                                node = YAML.ParseFlow(93, 0, 0, YP.ind)
                            } ElseBlock: {
                                IfCondition EqualTo(c, 123) ThenBlock: {
                                    node = YAML.ParseFlow(125, 0, 0, YP.ind)
                                } ElseBlock: {
                                    IfCondition EqualTo(c, 124) ThenBlock: {
                                        node = YAML.ParseBlockScalar(124, YP.ind)
                                    } ElseBlock: {
                                        IfCondition EqualTo(c, 62) ThenBlock: {
                                            node = YAML.ParseBlockScalar(62, YP.ind)
                                        } ElseBlock: {
                                            node = YAML.ReadPlainKey()
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        YAML.ApplyLoose(node, anchor, tag)
        YAML.SkipHSpace()
        ReturnValue(node)
    }
}

Function.YAML.PushMap {
    Input: mapn: Address
    Input: key: Address
    Input: val: Address
    Body: {
        k = key
        v = val
        IfCondition EqualTo(k, 0) ThenBlock: {
            k = YAML.EmptyScalar()
        }
        IfCondition EqualTo(v, 0) ThenBlock: {
            v = YAML.EmptyScalar()
        }
        ka = RDMEM_64(mapn, 32)
        va = RDMEM_64(mapn, 40)
        Array.Push(ka, k)
        Array.Push(va, v)
    }
}

Function.YAML.FillBlockSeq {
    Input: node: Address
    Input: seq_col: Integer
    Body: {
        looping = 1
        WhileLoop EqualTo(looping, 1) {
            IfCondition EqualTo(YP.err, 1) ThenBlock: {
                looping = 0
            } ElseBlock: {
                ok = YAML.SkipToContent()
                IfCondition EqualTo(ok, 0) ThenBlock: {
                    looping = 0
                } ElseBlock: {
                    at = 0
                    IfCondition EqualTo(YP.col, seq_col) ThenBlock: { at = 1 }
                    IfCondition EqualTo(at, 0) ThenBlock: {
                        looping = 0
                    } ElseBlock: {
                        dash = YAML.StartsSeq()
                        IfCondition EqualTo(dash, 0) ThenBlock: {
                            looping = 0
                        } ElseBlock: {
                            YAML.Bump()
                            YAML.SkipBlockSep()
                            eol = YAML.AtEol()
                            item = 0
                            IfCondition EqualTo(eol, 1) ThenBlock: {
                                YAML.FinishLine()
                                item = YAML.ParseNode(seq_col, 0)
                            } ElseBlock: {
                                item = YAML.ParseNode(seq_col, 1)
                            }
                            IfCondition EqualTo(YP.err, 1) ThenBlock: {
                                looping = 0
                            } ElseBlock: {
                                IfCondition EqualTo(item, 0) ThenBlock: {
                                    item = YAML.EmptyScalar()
                                }
                                arr = RDMEM_64(node, 32)
                                Array.Push(arr, item)
                            }
                        }
                    }
                }
            }
        }
    }
}

Function.YAML.FillBlockMap {
    Input: node: Address
    Input: map_col: Integer
    Input: lead: Integer
    Body: {
        first = lead
        looping = 1
        WhileLoop EqualTo(looping, 1) {
            IfCondition EqualTo(YP.err, 1) ThenBlock: {
                looping = 0
            } ElseBlock: {
                ok = YAML.SkipToContent()
                IfCondition EqualTo(ok, 0) ThenBlock: {
                    looping = 0
                } ElseBlock: {
                    stop = 0
                    IfCondition EqualTo(first, 0) ThenBlock: {
                        IfCondition NotEqual(YP.ind, map_col) ThenBlock: { stop = 1 }
                        mk = YAML.MarkerKind()
                        IfCondition NotEqual(mk, 0) ThenBlock: { stop = 1 }
                        entry = 0
                        ex = YAML.StartsExplicit()
                        IfCondition EqualTo(ex, 1) ThenBlock: { entry = 1 }
                        hk = YAML.HasImplicitKey()
                        IfCondition EqualTo(hk, 1) ThenBlock: { entry = 1 }
                        ck = YAML.AtKeyColon()
                        IfCondition EqualTo(ck, 1) ThenBlock: { entry = 1 }
                        IfCondition EqualTo(entry, 0) ThenBlock: { stop = 1 }
                    }
                    IfCondition EqualTo(stop, 1) ThenBlock: {
                        looping = 0
                    } ElseBlock: {
                        IfCondition EqualTo(YP.tabind, 1) ThenBlock: {
                            YAML.Fail("tab indentation")
                        }
                        first = 0
                        ex = YAML.StartsExplicit()
                        key = 0
                        val = 0
                        IfCondition EqualTo(ex, 1) ThenBlock: {
                            key = YAML.ParseExplicitKey(map_col)
                            val = YAML.BindExplicitValue(map_col)
                        } ElseBlock: {
                            key = YAML.ParseImplicitKey()
                            val = YAML.ParseColonValue(map_col, 0)
                        }
                        IfCondition EqualTo(YP.err, 1) ThenBlock: {
                            looping = 0
                        } ElseBlock: {
                            YAML.PushMap(node, key, val)
                        }
                    }
                }
            }
        }
    }
}

Function.YAML.ParseFollowing {
    Input: min_indent: Integer
    Output: Address
    Body: {
        spot = YAML.SavePos()
        ok = YAML.SkipToContent()
        IfCondition EqualTo(ok, 0) ThenBlock: {
            ReturnValue(0)
        }
        mk = YAML.MarkerKind()
        IfCondition NotEqual(mk, 0) ThenBlock: {
            YAML.RestorePos(spot)
            ReturnValue(0)
        }
        reject = 0
        IfCondition GreaterEqual(min_indent, 0) ThenBlock: {
            IfCondition LessEqual(YP.ind, min_indent) ThenBlock: {
                reject = 1
            }
        }
        IfCondition EqualTo(reject, 1) ThenBlock: {
            YAML.RestorePos(spot)
            ReturnValue(0)
        }
        node = YAML.ParseNode(min_indent, 0)
        ReturnValue(node)
    }
}

Function.YAML.ParseNodeHere {
    Input: min_indent: Integer
    Output: Address
    Body: {
        start_col = YP.col
        got = YAML.ReadProps()
        anchor = RDMEM_64(got)
        tag = RDMEM_64(got, 8)
        YAML.SkipHSpace()
        had = 0
        IfCondition NotEqual(anchor, 0) ThenBlock: { had = 1 }
        IfCondition NotEqual(tag, 0) ThenBlock: { had = 1 }
        eol = YAML.AtEol()
        cpeek = YAML.Peek()
        IfCondition EqualTo(cpeek, 44) ThenBlock: {
            YAML.Fail("comma in block")
            ReturnValue(0)
        }
        IfCondition EqualTo(had, 1) ThenBlock: {
            IfCondition EqualTo(eol, 0) ThenBlock: {
                seqbad = YAML.StartsSeq()
                IfCondition EqualTo(seqbad, 1) ThenBlock: {
                    YAML.Fail("anchor before sequence")
                    ReturnValue(0)
                }
            }
        }
        IfCondition EqualTo(had, 1) ThenBlock: {
            IfCondition EqualTo(eol, 1) ThenBlock: {
                prop_ind = YP.ind
                YAML.FinishLine()
                child = YAML.ParseFollowing(min_indent)
                IfCondition EqualTo(child, 0) ThenBlock: {
                    deeper = 0
                    IfCondition GreaterEqual(min_indent, 0) ThenBlock: {
                        IfCondition GreaterThan(prop_ind, min_indent) ThenBlock: {
                            deeper = 1
                        }
                    }
                    IfCondition EqualTo(deeper, 1) ThenBlock: {
                        spot = YAML.SavePos()
                        ok2 = YAML.SkipToContent()
                        took = 0
                        IfCondition EqualTo(ok2, 1) ThenBlock: {
                            IfCondition EqualTo(YP.ind, min_indent) ThenBlock: {
                                mk2 = YAML.MarkerKind()
                                IfCondition EqualTo(mk2, 0) ThenBlock: {
                                    seq2 = YAML.StartsSeq()
                                    IfCondition EqualTo(seq2, 1) ThenBlock: {
                                        child = YAML.ParseBareSeq()
                                        took = 1
                                    } ElseBlock: {
                                        c2 = YAML.Peek()
                                        spec = 0
                                        IfCondition EqualTo(c2, 124) ThenBlock: { spec = 1 }
                                        IfCondition EqualTo(c2, 62) ThenBlock: { spec = 1 }
                                        IfCondition EqualTo(c2, 91) ThenBlock: { spec = 1 }
                                        IfCondition EqualTo(c2, 123) ThenBlock: { spec = 1 }
                                        IfCondition EqualTo(c2, 34) ThenBlock: { spec = 1 }
                                        IfCondition EqualTo(c2, 39) ThenBlock: { spec = 1 }
                                        IfCondition EqualTo(c2, 63) ThenBlock: { spec = 1 }
                                        IfCondition EqualTo(c2, 33) ThenBlock: { spec = 1 }
                                        IfCondition EqualTo(c2, 38) ThenBlock: { spec = 1 }
                                        IfCondition EqualTo(spec, 1) ThenBlock: {
                                            child = YAML.ParseNodeHere(min_indent)
                                            took = 1
                                        }
                                    }
                                }
                            }
                        }
                        IfCondition EqualTo(took, 0) ThenBlock: {
                            YAML.RestorePos(spot)
                            child = YAML.EmptyScalar()
                        }
                    } ElseBlock: {
                        child = YAML.EmptyScalar()
                    }
                }
                YAML.ApplyLoose(child, anchor, tag)
                ReturnValue(child)
            }
        }
        seq = YAML.StartsSeq()
        IfCondition EqualTo(seq, 1) ThenBlock: {
            seq_col = YP.col
            node = YAML.NewNode(2)
            sa = Array.Create(4)
            WRMEM_64(node, 32, sa)
            YAML.ApplyProps(node, anchor, tag)
            YAML.FillBlockSeq(node, seq_col)
            YAML.FinishRest()
            ReturnValue(node)
        }
        ex = YAML.StartsExplicit()
        hk = YAML.HasImplicitKey()
        ck = YAML.AtKeyColon()
        is_map = 0
        IfCondition EqualTo(ex, 1) ThenBlock: { is_map = 1 }
        IfCondition EqualTo(hk, 1) ThenBlock: { is_map = 1 }
        IfCondition EqualTo(ck, 1) ThenBlock: { is_map = 1 }
        IfCondition EqualTo(is_map, 1) ThenBlock: {
            map_col = start_col
            node = YAML.NewNode(3)
            ka = Array.Create(4)
            va = Array.Create(4)
            WRMEM_64(node, 32, ka)
            WRMEM_64(node, 40, va)
            owned = 0
            IfCondition EqualTo(had, 1) ThenBlock: {
                IfCondition EqualTo(eol, 0) ThenBlock: {
                    owned = 1
                }
            }
            IfCondition EqualTo(owned, 1) ThenBlock: {
                key = 0
                IfCondition EqualTo(ex, 1) ThenBlock: {
                    key = YAML.ParseExplicitKey(map_col)
                } ElseBlock: {
                    key = YAML.ParseImplicitKey()
                }
                YAML.ApplyLoose(key, anchor, tag)
                val = 0
                IfCondition EqualTo(ex, 1) ThenBlock: {
                    val = YAML.BindExplicitValue(map_col)
                } ElseBlock: {
                    val = YAML.ParseColonValue(map_col, 0)
                }
                YAML.PushMap(node, key, val)
                YAML.FillBlockMap(node, map_col, 0)
            } ElseBlock: {
                YAML.ApplyProps(node, anchor, tag)
                YAML.FillBlockMap(node, map_col, 1)
            }
            YAML.FinishRest()
            ReturnValue(node)
        }
        c = YAML.Peek()
        IfCondition EqualTo(c, 42) ThenBlock: {
            node = YAML.ParseAlias()
            YAML.ApplyProps(node, anchor, tag)
            YAML.FinishRest()
            ReturnValue(node)
        }
        IfCondition EqualTo(c, 34) ThenBlock: {
            node = YAML.ParseQuoted(34, min_indent)
            YAML.ApplyProps(node, anchor, tag)
            YAML.FinishRest()
            ReturnValue(node)
        }
        IfCondition EqualTo(c, 39) ThenBlock: {
            node = YAML.ParseQuoted(39, min_indent)
            YAML.ApplyProps(node, anchor, tag)
            YAML.FinishRest()
            ReturnValue(node)
        }
        IfCondition EqualTo(c, 124) ThenBlock: {
            node = YAML.ParseBlockScalar(124, min_indent)
            YAML.ApplyProps(node, anchor, tag)
            YAML.FinishRest()
            ReturnValue(node)
        }
        IfCondition EqualTo(c, 62) ThenBlock: {
            node = YAML.ParseBlockScalar(62, min_indent)
            YAML.ApplyProps(node, anchor, tag)
            YAML.FinishRest()
            ReturnValue(node)
        }
        IfCondition EqualTo(c, 91) ThenBlock: {
            node = YAML.ParseFlow(93, anchor, tag, min_indent)
            YAML.FinishRest()
            ReturnValue(node)
        }
        IfCondition EqualTo(c, 123) ThenBlock: {
            node = YAML.ParseFlow(125, anchor, tag, min_indent)
            YAML.FinishRest()
            ReturnValue(node)
        }
        IfCondition EqualTo(c, -1) ThenBlock: {
            node = YAML.EmptyScalar()
            YAML.ApplyProps(node, anchor, tag)
            ReturnValue(node)
        }
        node = YAML.ParseBlockPlain(min_indent)
        YAML.ApplyProps(node, anchor, tag)
        YAML.FinishRest()
        ReturnValue(node)
    }
}

Function.YAML.ParseNode {
    Input: min_indent: Integer
    Input: inline: Integer
    Output: Address
    Body: {
        IfCondition GreaterEqual(YP.depth, 64) ThenBlock: {
            YAML.Fail("nesting too deep")
            ReturnValue(0)
        }
        YP.depth = Add(YP.depth, 1)
        result = 0
        IfCondition EqualTo(YP.err, 1) ThenBlock: {
            result = 0
        } ElseBlock: {
            IfCondition EqualTo(inline, 1) ThenBlock: {
                result = YAML.ParseNodeHere(min_indent)
            } ElseBlock: {
                ok = YAML.SkipToContent()
                IfCondition EqualTo(ok, 0) ThenBlock: {
                    result = 0
                } ElseBlock: {
                    mk = YAML.MarkerKind()
                    blocked = 0
                    IfCondition NotEqual(mk, 0) ThenBlock: { blocked = 1 }
                    IfCondition EqualTo(YP.ind, 0) ThenBlock: {
                        IfCondition EqualTo(YP.col, 0) ThenBlock: {
                            pc = YAML.Peek()
                            IfCondition EqualTo(pc, 37) ThenBlock: { blocked = 1 }
                        }
                    }
                    IfCondition GreaterEqual(min_indent, 0) ThenBlock: {
                        IfCondition LessEqual(YP.ind, min_indent) ThenBlock: {
                            blocked = 1
                        }
                    }
                    IfCondition EqualTo(blocked, 1) ThenBlock: {
                        result = 0
                    } ElseBlock: {
                        tabbad = 0
                        IfCondition EqualTo(YP.tabind, 1) ThenBlock: {
                            t1 = YAML.HasImplicitKey()
                            IfCondition EqualTo(t1, 1) ThenBlock: { tabbad = 1 }
                            t2 = YAML.StartsSeq()
                            IfCondition EqualTo(t2, 1) ThenBlock: { tabbad = 1 }
                            t3 = YAML.StartsExplicit()
                            IfCondition EqualTo(t3, 1) ThenBlock: { tabbad = 1 }
                            t4 = YAML.AtKeyColon()
                            IfCondition EqualTo(t4, 1) ThenBlock: { tabbad = 1 }
                        }
                        IfCondition EqualTo(tabbad, 1) ThenBlock: {
                            YAML.Fail("tab indentation")
                            result = 0
                        } ElseBlock: {
                            result = YAML.ParseNodeHere(min_indent)
                        }
                    }
                }
            }
        }
        YP.depth = Subtract(YP.depth, 1)
        ReturnValue(result)
    }
}

Function.YAML.ResolveNode {
    Input: node: Address
    Body: {
        IfCondition EqualTo(node, 0) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition EqualTo(YP.err, 1) ThenBlock: {
            ReturnValue(0)
        }
        kind = RDMEM_64(node)
        IfCondition EqualTo(kind, 4) ThenBlock: {
            tgt = RDMEM_64(node, 40)
            IfCondition EqualTo(tgt, 0) ThenBlock: {
                name = RDMEM_64(node, 32)
                tgt = YAML.AnchorGet(name)
                WRMEM_64(node, 40, tgt)
            }
            IfCondition EqualTo(tgt, 0) ThenBlock: {
                YAML.Fail("unknown alias")
            }
            ReturnValue(0)
        }
        IfCondition EqualTo(kind, 2) ThenBlock: {
            arr = RDMEM_64(node, 32)
            IfCondition NotEqual(arr, 0) ThenBlock: {
                n = Array.Size(arr)
                i = 0
                WhileLoop LessThan(i, n) {
                    it = Array.Get(arr, i)
                    YAML.ResolveNode(it)
                    i = Add(i, 1)
                }
            }
            ReturnValue(0)
        }
        IfCondition EqualTo(kind, 3) ThenBlock: {
            ka = RDMEM_64(node, 32)
            va = RDMEM_64(node, 40)
            IfCondition NotEqual(ka, 0) ThenBlock: {
                n = Array.Size(ka)
                i = 0
                WhileLoop LessThan(i, n) {
                    k = Array.Get(ka, i)
                    v = Array.Get(va, i)
                    YAML.ResolveNode(k)
                    YAML.ResolveNode(v)
                    i = Add(i, 1)
                }
            }
        }
        ReturnValue(0)
    }
}

Function.YAML.AddDoc {
    Input: node: Address
    Input: explicit: Integer
    Input: footer: Integer
    Body: {
        rec = Allocate(24)
        WRMEM_64(rec, node)
        WRMEM_64(rec, 8, explicit)
        WRMEM_64(rec, 16, footer)
        Array.Push(YP.docs, rec)
    }
}

Function.YAML.ClearMeta {
    Body: {
        YP.anchors = 0
        YP.tags = 0
    }
}

Function.YAML.Bump3 {
    Body: {
        YAML.Bump()
        YAML.Bump()
        YAML.Bump()
    }
}

Function.YAML.YamlVersion {
    Input: s: Address
    Output: Integer
    Body: {
        n = StringLength(s)
        i = 0
        major = 0
        saw = 0
        reading = 1
        WhileLoop EqualTo(reading, 1) {
            IfCondition GreaterEqual(i, n) ThenBlock: {
                reading = 0
            } ElseBlock: {
                c = RDMEM_8(Add(s, i))
                dig = YAML.IsDigit(c)
                IfCondition EqualTo(dig, 0) ThenBlock: {
                    reading = 0
                } ElseBlock: {
                    major = Multiply(major, 10)
                    major = Add(major, Subtract(c, 48))
                    saw = 1
                    i = Add(i, 1)
                }
            }
        }
        IfCondition EqualTo(saw, 0) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition GreaterEqual(i, n) ThenBlock: {
            ReturnValue(0)
        }
        dot = RDMEM_8(Add(s, i))
        IfCondition NotEqual(dot, 46) ThenBlock: {
            ReturnValue(0)
        }
        i = Add(i, 1)
        saw2 = 0
        reading = 1
        WhileLoop EqualTo(reading, 1) {
            IfCondition GreaterEqual(i, n) ThenBlock: {
                reading = 0
            } ElseBlock: {
                c2 = RDMEM_8(Add(s, i))
                dig2 = YAML.IsDigit(c2)
                IfCondition EqualTo(dig2, 0) ThenBlock: {
                    reading = 0
                } ElseBlock: {
                    saw2 = 1
                    i = Add(i, 1)
                }
            }
        }
        IfCondition EqualTo(saw2, 0) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition LessThan(i, n) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition GreaterEqual(major, 2) ThenBlock: {
            ReturnValue(2)
        }
        ReturnValue(1)
    }
}

Function.YAML.ParseDirective {
    Input: yaml_seen: Integer
    Output: Integer
    Body: {
        YAML.Bump()
        name = YAML.ReadToken(0)
        YAML.SkipHSpace()
        is_yaml = YAML.EqLit(name, "YAML")
        is_tag = YAML.EqLit(name, "TAG")
        saw_yaml = 0
        IfCondition EqualTo(is_yaml, 1) ThenBlock: {
            saw_yaml = 1
            IfCondition EqualTo(yaml_seen, 1) ThenBlock: {
                YAML.Fail("duplicate YAML directive")
            }
            ver = YAML.ReadToken(0)
            code = YAML.YamlVersion(ver)
            IfCondition EqualTo(code, 0) ThenBlock: {
                YAML.Fail("bad YAML version")
            }
            IfCondition EqualTo(code, 2) ThenBlock: {
                YAML.Fail("unsupported YAML version")
            }
            YAML.SkipHSpace()
            eol = YAML.AtEol()
            IfCondition EqualTo(eol, 0) ThenBlock: {
                YAML.Fail("trailing directive")
            }
        }
        IfCondition EqualTo(is_tag, 1) ThenBlock: {
            handle = YAML.ReadToken(0)
            YAML.SkipHSpace()
            prefix = YAML.ReadToken(0)
            dec = YAML.UriDecode(prefix)
            YAML.TagAdd(handle, dec)
        }
        YAML.FinishLine()
        ReturnValue(saw_yaml)
    }
}

Function.YAML.TakeFooter {
    Output: Integer
    Body: {
        ok = YAML.SkipToContent()
        IfCondition EqualTo(ok, 0) ThenBlock: {
            ReturnValue(0)
        }
        mk = YAML.MarkerKind()
        IfCondition EqualTo(mk, 2) ThenBlock: {
            YAML.Bump3()
            YAML.SkipHSpace()
            eol = YAML.AtEol()
            IfCondition EqualTo(eol, 0) ThenBlock: {
                YAML.Fail("trailing content")
            }
            YAML.FinishLine()
            ReturnValue(1)
        }
        ReturnValue(0)
    }
}

Function.YAML.ParseStream {
    Body: {
        prev_footer = 1
        header = 0
        yaml_seen = 0
        looping = 1
        WhileLoop EqualTo(looping, 1) {
            IfCondition EqualTo(YP.err, 1) ThenBlock: {
                looping = 0
            } ElseBlock: {
                ok = YAML.SkipToContent()
                IfCondition EqualTo(ok, 0) ThenBlock: {
                    looping = 0
                } ElseBlock: {
                    c = YAML.Peek()
                    dir = 0
                    IfCondition EqualTo(c, 37) ThenBlock: {
                        IfCondition EqualTo(YP.ind, 0) ThenBlock: {
                            IfCondition EqualTo(YP.col, 0) ThenBlock: {
                                dir = 1
                            }
                        }
                    }
                    IfCondition EqualTo(dir, 1) ThenBlock: {
                        IfCondition EqualTo(prev_footer, 0) ThenBlock: {
                            YAML.Fail("directive needs a document end")
                            looping = 0
                        } ElseBlock: {
                            IfCondition EqualTo(header, 0) ThenBlock: {
                                YAML.ClearMeta()
                                header = 1
                            }
                            saw = YAML.ParseDirective(yaml_seen)
                            IfCondition EqualTo(saw, 1) ThenBlock: {
                                yaml_seen = 1
                            }
                        }
                    } ElseBlock: {
                        yaml_seen = 0
                        IfCondition EqualTo(header, 0) ThenBlock: {
                            IfCondition GreaterThan(Array.Size(YP.docs), 0) ThenBlock: {
                                IfCondition EqualTo(prev_footer, 0) ThenBlock: {
                                    mk0 = YAML.MarkerKind()
                                    IfCondition EqualTo(mk0, 0) ThenBlock: {
                                        YAML.Fail("missing document start")
                                        looping = 0
                                    }
                                }
                            }
                            YAML.ClearMeta()
                        }
                        had_dir = header
                        header = 0
                        explicit = 0
                        node = 0
                        mk = YAML.MarkerKind()
                        IfCondition EqualTo(mk, 2) ThenBlock: {
                            IfCondition EqualTo(had_dir, 1) ThenBlock: {
                                YAML.Fail("directive without document")
                            }
                            YAML.Bump3()
                            YAML.FinishLine()
                        } ElseBlock: {
                            IfCondition EqualTo(mk, 1) ThenBlock: {
                                explicit = 1
                                YAML.Bump3()
                                YAML.SkipHSpace()
                                eol = YAML.AtEol()
                                IfCondition EqualTo(eol, 1) ThenBlock: {
                                    YAML.FinishLine()
                                    node = YAML.ParseNode(-1, 0)
                                } ElseBlock: {
                                    badmap = YAML.HasImplicitKey()
                                    IfCondition EqualTo(badmap, 1) ThenBlock: {
                                        YAML.Fail("mapping on document mark")
                                        node = 0
                                    } ElseBlock: {
                                        node = YAML.ParseNode(-1, 1)
                                    }
                                }
                            } ElseBlock: {
                                node = YAML.ParseNode(-1, 0)
                            }
                            IfCondition EqualTo(YP.err, 0) ThenBlock: {
                                IfCondition EqualTo(node, 0) ThenBlock: {
                                    node = YAML.EmptyScalar()
                                }
                                footer = YAML.TakeFooter()
                                YAML.ResolveNode(node)
                                IfCondition EqualTo(YP.err, 0) ThenBlock: {
                                    YAML.AddDoc(node, explicit, footer)
                                    prev_footer = footer
                                }
                            }
                        }
                    }
                }
            }
        }
        IfCondition EqualTo(header, 1) ThenBlock: {
            IfCondition EqualTo(YP.err, 0) ThenBlock: {
                YAML.Fail("directive without document")
            }
        }
    }
}
