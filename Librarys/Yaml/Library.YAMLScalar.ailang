Function.YAML.IsDigit {
    Input: c: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(c, 48) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterThan(c, 57) ThenBlock: { ReturnValue(0) }
        ReturnValue(1)
    }
}

Function.YAML.HexVal {
    Input: c: Integer
    Output: Integer
    Body: {
        IfCondition GreaterEqual(c, 48) ThenBlock: {
            IfCondition LessEqual(c, 57) ThenBlock: {
                ReturnValue(Subtract(c, 48))
            }
        }
        IfCondition GreaterEqual(c, 65) ThenBlock: {
            IfCondition LessEqual(c, 70) ThenBlock: {
                ReturnValue(Subtract(c, 55))
            }
        }
        IfCondition GreaterEqual(c, 97) ThenBlock: {
            IfCondition LessEqual(c, 102) ThenBlock: {
                ReturnValue(Subtract(c, 87))
            }
        }
        ReturnValue(-1)
    }
}

Function.YAML.Utf8 {
    Input: cp: Integer
    Body: {
        IfCondition LessThan(cp, 128) ThenBlock: {
            SB.Byte(cp)
        } ElseBlock: {
            IfCondition LessThan(cp, 2048) ThenBlock: {
                hi = Divide(cp, 64)
                b0 = BitwiseOr(192, hi)
                lo = BitwiseAnd(cp, 63)
                b1 = BitwiseOr(128, lo)
                SB.Byte(b0)
                SB.Byte(b1)
            } ElseBlock: {
                IfCondition LessThan(cp, 65536) ThenBlock: {
                    b0 = BitwiseOr(224, Divide(cp, 4096))
                    mid = BitwiseAnd(Divide(cp, 64), 63)
                    b1 = BitwiseOr(128, mid)
                    b2 = BitwiseOr(128, BitwiseAnd(cp, 63))
                    SB.Byte(b0)
                    SB.Byte(b1)
                    SB.Byte(b2)
                } ElseBlock: {
                    b0 = BitwiseOr(240, Divide(cp, 262144))
                    b1 = BitwiseOr(128, BitwiseAnd(Divide(cp, 4096), 63))
                    b2 = BitwiseOr(128, BitwiseAnd(Divide(cp, 64), 63))
                    b3 = BitwiseOr(128, BitwiseAnd(cp, 63))
                    SB.Byte(b0)
                    SB.Byte(b1)
                    SB.Byte(b2)
                    SB.Byte(b3)
                }
            }
        }
    }
}

Function.YAML.ReadHex {
    Input: n: Integer
    Output: Integer
    Body: {
        v = 0
        i = 0
        bad = 0
        WhileLoop LessThan(i, n) {
            c = YAML.Peek()
            h = YAML.HexVal(c)
            IfCondition LessThan(h, 0) ThenBlock: {
                bad = 1
                i = n
            } ElseBlock: {
                v = Multiply(v, 16)
                v = Add(v, h)
                YAML.Bump()
                i = Add(i, 1)
            }
        }
        IfCondition EqualTo(bad, 1) ThenBlock: {
            ReturnValue(-1)
        }
        ReturnValue(v)
    }
}

Function.YAML.NextLineFold {
    Input: keep_break: Integer
    Output: Integer
    Body: {
        YAML.FinishLine()
        ok = YAML.Ensure()
        IfCondition EqualTo(ok, 0) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition EqualTo(keep_break, 0) ThenBlock: {
            YAML.SkipHSpace()
        }
        ReturnValue(1)
    }
}

Function.YAML.ParseQuoted {
    Input: q: Integer
    Input: qparent: Integer
    Output: Address
    Body: {
        YAML.Bump()
        SB.Reset()
        esc_join = 0
        qkeep = 0
        style = 1
        IfCondition EqualTo(q, 39) ThenBlock: {
            style = 2
        }
        looping = 1
        WhileLoop EqualTo(looping, 1) {
            IfCondition EqualTo(YP.err, 1) ThenBlock: {
                looping = 0
            } ElseBlock: {
                c = YAML.Peek()
                IfCondition EqualTo(c, -1) ThenBlock: {
                    esc = esc_join
                    esc_join = 0
                    IfCondition EqualTo(esc, 0) ThenBlock: {
                        YAML.TrimFloor(qkeep)
                    }
                    YAML.FinishLine()
                    more = YAML.Ensure()
                    IfCondition EqualTo(more, 0) ThenBlock: {
                        YAML.Fail("unterminated quote")
                        looping = 0
                    } ElseBlock: {
                        empties = 0
                        scanning = 1
                        WhileLoop EqualTo(scanning, 1) {
                            qmk = YAML.MarkerKind()
                            IfCondition NotEqual(qmk, 0) ThenBlock: {
                                YAML.Fail("document marker in quote")
                                scanning = 0
                                looping = 0
                            } ElseBlock: {
                                qind = YP.ind
                                YAML.SkipHSpace()
                                eolq = YAML.Peek()
                                IfCondition EqualTo(eolq, -1) ThenBlock: {
                                    empties = Add(empties, 1)
                                    YAML.FinishLine()
                                    more2 = YAML.Ensure()
                                    IfCondition EqualTo(more2, 0) ThenBlock: {
                                        YAML.Fail("unterminated quote")
                                        scanning = 0
                                        looping = 0
                                    }
                                } ElseBlock: {
                                    IfCondition LessEqual(qind, qparent) ThenBlock: {
                                        YAML.Fail("bad quote indent")
                                        scanning = 0
                                        looping = 0
                                    } ElseBlock: {
                                        scanning = 0
                                    }
                                }
                            }
                        }
                        IfCondition EqualTo(looping, 1) ThenBlock: {
                            IfCondition EqualTo(esc, 1) ThenBlock: {
                                tq = 0
                                WhileLoop LessThan(tq, empties) {
                                    SB.Byte(10)
                                    tq = Add(tq, 1)
                                }
                            } ElseBlock: {
                                IfCondition GreaterThan(empties, 0) ThenBlock: {
                                    tq = 0
                                    WhileLoop LessThan(tq, empties) {
                                        SB.Byte(10)
                                        tq = Add(tq, 1)
                                    }
                                } ElseBlock: {
                                    SB.Byte(32)
                                }
                            }
                            qkeep = SB.len
                        }
                    }
                } ElseBlock: {
                    IfCondition EqualTo(c, q) ThenBlock: {
                        IfCondition EqualTo(q, 39) ThenBlock: {
                            n1 = YAML.AtRel(1)
                            IfCondition EqualTo(n1, 39) ThenBlock: {
                                SB.Byte(39)
                                qkeep = SB.len
                                YAML.Bump()
                                YAML.Bump()
                            } ElseBlock: {
                                YAML.Bump()
                                looping = 0
                            }
                        } ElseBlock: {
                            YAML.Bump()
                            looping = 0
                        }
                    } ElseBlock: {
                        IfCondition EqualTo(q, 34) ThenBlock: {
                            IfCondition EqualTo(c, 92) ThenBlock: {
                                YAML.Bump()
                                e = YAML.Peek()
                                IfCondition EqualTo(e, -1) ThenBlock: {
                                    esc_join = 1
                                } ElseBlock: {
                                    YAML.Bump()
                                    IfCondition EqualTo(e, 110) ThenBlock: { SB.Byte(10) }
                                    IfCondition EqualTo(e, 114) ThenBlock: { SB.Byte(13) }
                                    IfCondition EqualTo(e, 116) ThenBlock: { SB.Byte(9) }
                                    IfCondition EqualTo(e, 98) ThenBlock: { SB.Byte(8) }
                                    IfCondition EqualTo(e, 97) ThenBlock: { SB.Byte(7) }
                                    IfCondition EqualTo(e, 118) ThenBlock: { SB.Byte(11) }
                                    IfCondition EqualTo(e, 102) ThenBlock: { SB.Byte(12) }
                                    IfCondition EqualTo(e, 101) ThenBlock: { SB.Byte(27) }
                                    IfCondition EqualTo(e, 48) ThenBlock: { SB.Byte(0) }
                                    IfCondition EqualTo(e, 32) ThenBlock: { SB.Byte(32) }
                                    IfCondition EqualTo(e, 9) ThenBlock: { SB.Byte(9) }
                                    IfCondition EqualTo(e, 34) ThenBlock: { SB.Byte(34) }
                                    IfCondition EqualTo(e, 47) ThenBlock: { SB.Byte(47) }
                                    IfCondition EqualTo(e, 92) ThenBlock: { SB.Byte(92) }
                                    IfCondition EqualTo(e, 78) ThenBlock: { YAML.Utf8(133) }
                                    IfCondition EqualTo(e, 95) ThenBlock: { YAML.Utf8(160) }
                                    IfCondition EqualTo(e, 76) ThenBlock: { YAML.Utf8(8232) }
                                    IfCondition EqualTo(e, 80) ThenBlock: { YAML.Utf8(8233) }
                                    IfCondition EqualTo(e, 120) ThenBlock: {
                                        hv = YAML.ReadHex(2)
                                        IfCondition LessThan(hv, 0) ThenBlock: {
                                            YAML.Fail("bad hex escape")
                                        } ElseBlock: {
                                            YAML.Utf8(hv)
                                        }
                                    }
                                    IfCondition EqualTo(e, 117) ThenBlock: {
                                        hv = YAML.ReadHex(4)
                                        IfCondition LessThan(hv, 0) ThenBlock: {
                                            YAML.Fail("bad unicode escape")
                                        } ElseBlock: {
                                            YAML.Utf8(hv)
                                        }
                                    }
                                    IfCondition EqualTo(e, 85) ThenBlock: {
                                        hv = YAML.ReadHex(8)
                                        IfCondition LessThan(hv, 0) ThenBlock: {
                                            YAML.Fail("bad unicode escape")
                                        } ElseBlock: {
                                            YAML.Utf8(hv)
                                        }
                                    }
                                    known = 0
                                    IfCondition EqualTo(e, 110) ThenBlock: { known = 1 }
                                    IfCondition EqualTo(e, 114) ThenBlock: { known = 1 }
                                    IfCondition EqualTo(e, 116) ThenBlock: { known = 1 }
                                    IfCondition EqualTo(e, 98) ThenBlock: { known = 1 }
                                    IfCondition EqualTo(e, 97) ThenBlock: { known = 1 }
                                    IfCondition EqualTo(e, 118) ThenBlock: { known = 1 }
                                    IfCondition EqualTo(e, 102) ThenBlock: { known = 1 }
                                    IfCondition EqualTo(e, 101) ThenBlock: { known = 1 }
                                    IfCondition EqualTo(e, 48) ThenBlock: { known = 1 }
                                    IfCondition EqualTo(e, 32) ThenBlock: { known = 1 }
                                    IfCondition EqualTo(e, 9) ThenBlock: { known = 1 }
                                    IfCondition EqualTo(e, 34) ThenBlock: { known = 1 }
                                    IfCondition EqualTo(e, 47) ThenBlock: { known = 1 }
                                    IfCondition EqualTo(e, 92) ThenBlock: { known = 1 }
                                    IfCondition EqualTo(e, 78) ThenBlock: { known = 1 }
                                    IfCondition EqualTo(e, 95) ThenBlock: { known = 1 }
                                    IfCondition EqualTo(e, 76) ThenBlock: { known = 1 }
                                    IfCondition EqualTo(e, 80) ThenBlock: { known = 1 }
                                    IfCondition EqualTo(e, 120) ThenBlock: { known = 1 }
                                    IfCondition EqualTo(e, 117) ThenBlock: { known = 1 }
                                    IfCondition EqualTo(e, 85) ThenBlock: { known = 1 }
                                    IfCondition EqualTo(known, 0) ThenBlock: {
                                        YAML.Fail("bad escape")
                                    }
                                    qkeep = SB.len
                                }
                            } ElseBlock: {
                                SB.Byte(c)
                                YAML.Bump()
                                plain_ws = 0
                                IfCondition EqualTo(c, 32) ThenBlock: { plain_ws = 1 }
                                IfCondition EqualTo(c, 9) ThenBlock: { plain_ws = 1 }
                                IfCondition EqualTo(plain_ws, 0) ThenBlock: {
                                    qkeep = SB.len
                                }
                            }
                        } ElseBlock: {
                            SB.Byte(c)
                            YAML.Bump()
                            plain_ws = 0
                            IfCondition EqualTo(c, 32) ThenBlock: { plain_ws = 1 }
                            IfCondition EqualTo(c, 9) ThenBlock: { plain_ws = 1 }
                            IfCondition EqualTo(plain_ws, 0) ThenBlock: {
                                qkeep = SB.len
                            }
                        }
                    }
                }
            }
        }
        text = SB.Take()
        sl = SB.last
        node = YAML.NewNode(1)
        WRMEM_64(node, 8, style)
        WRMEM_64(node, 32, text)
        WRMEM_64(node, 48, sl)
        WRMEM_64(node, 56, 0)
        ReturnValue(node)
    }
}

Function.YAML.TrimFloor {
    Input: floor: Integer
    Body: {
        looping = 1
        WhileLoop EqualTo(looping, 1) {
            IfCondition LessEqual(SB.len, floor) ThenBlock: {
                looping = 0
            } ElseBlock: {
                prevp = Subtract(SB.len, 1)
                b = RDMEM_8(Add(SB.data, prevp))
                IfCondition EqualTo(b, 32) ThenBlock: {
                    SB.len = prevp
                } ElseBlock: {
                    IfCondition EqualTo(b, 9) ThenBlock: {
                        SB.len = prevp
                    } ElseBlock: {
                        looping = 0
                    }
                }
            }
        }
    }
}

Function.YAML.ChompText {
    Input: chomp: Integer
    Body: {
        IfCondition EqualTo(chomp, 1) ThenBlock: {
            chomp = chomp
        } ElseBlock: {
            n = SB.len
            WhileLoop GreaterThan(n, 0) {
                prevp = Subtract(n, 1)
                b = RDMEM_8(Add(SB.data, prevp))
                IfCondition EqualTo(b, 10) ThenBlock: {
                    n = prevp
                } ElseBlock: {
                    n = 0
                    prevp = SB.len
                }
            }
            endn = SB.len
            i = SB.len
            WhileLoop GreaterThan(i, 0) {
                prevp = Subtract(i, 1)
                b = RDMEM_8(Add(SB.data, prevp))
                IfCondition EqualTo(b, 10) ThenBlock: {
                    i = prevp
                } ElseBlock: {
                    endn = i
                    i = 0
                }
            }
            IfCondition EqualTo(chomp, -1) ThenBlock: {
                SB.len = endn
            } ElseBlock: {
                IfCondition LessThan(endn, SB.len) ThenBlock: {
                    SB.len = Add(endn, 1)
                }
            }
        }
    }
}

Function.YAML.FoldBuffer {
    Body: {
        n = SB.len
        src = Allocate(Add(n, 1))
        IfCondition GreaterThan(n, 0) ThenBlock: {
            MemoryCopy(src, SB.data, n)
        }
        SB.Reset()
        i = 0
        WhileLoop LessThan(i, n) {
            b = RDMEM_8(Add(src, i))
            IfCondition NotEqual(b, 10) ThenBlock: {
                SB.Byte(b)
                i = Add(i, 1)
            } ElseBlock: {
                j = i
                WhileLoop LessThan(j, n) {
                    bj = RDMEM_8(Add(src, j))
                    IfCondition EqualTo(bj, 10) ThenBlock: {
                        j = Add(j, 1)
                    } ElseBlock: {
                        j = n
                    }
                }
                count = 0
                j = i
                counting = 1
                WhileLoop EqualTo(counting, 1) {
                    IfCondition GreaterEqual(j, n) ThenBlock: {
                        counting = 0
                    } ElseBlock: {
                        bj = RDMEM_8(Add(src, j))
                        IfCondition EqualTo(bj, 10) ThenBlock: {
                            count = Add(count, 1)
                            j = Add(j, 1)
                        } ElseBlock: {
                            counting = 0
                        }
                    }
                }
                prev_more = 0
                next_more = 0
                next_exists = 0
                IfCondition LessThan(j, n) ThenBlock: {
                    next_exists = 1
                    nb = RDMEM_8(Add(src, j))
                    IfCondition EqualTo(nb, 32) ThenBlock: {
                        next_more = 1
                    }
                    IfCondition EqualTo(nb, 9) ThenBlock: {
                        next_more = 1
                    }
                }
                IfCondition GreaterThan(i, 0) ThenBlock: {
                    k = Subtract(i, 1)
                    walking = 1
                    WhileLoop EqualTo(walking, 1) {
                        IfCondition EqualTo(k, 0) ThenBlock: {
                            walking = 0
                        } ElseBlock: {
                            kp = Subtract(k, 1)
                            kb = RDMEM_8(Add(src, kp))
                            IfCondition EqualTo(kb, 10) ThenBlock: {
                                walking = 0
                            } ElseBlock: {
                                k = kp
                            }
                        }
                    }
                    kb0 = RDMEM_8(Add(src, k))
                    IfCondition EqualTo(kb0, 32) ThenBlock: {
                        prev_more = 1
                    }
                    IfCondition EqualTo(kb0, 9) ThenBlock: {
                        prev_more = 1
                    }
                }
                folded = 0
                IfCondition GreaterThan(i, 0) ThenBlock: {
                    IfCondition EqualTo(count, 1) ThenBlock: {
                        IfCondition EqualTo(next_exists, 1) ThenBlock: {
                            IfCondition EqualTo(prev_more, 0) ThenBlock: {
                                IfCondition EqualTo(next_more, 0) ThenBlock: {
                                    SB.Byte(32)
                                    folded = 1
                                }
                            }
                        }
                    }
                    IfCondition GreaterEqual(count, 2) ThenBlock: {
                        IfCondition EqualTo(next_exists, 1) ThenBlock: {
                            IfCondition EqualTo(prev_more, 0) ThenBlock: {
                                IfCondition EqualTo(next_more, 0) ThenBlock: {
                                    keep = Subtract(count, 1)
                                    t = 0
                                    WhileLoop LessThan(t, keep) {
                                        SB.Byte(10)
                                        t = Add(t, 1)
                                    }
                                    folded = 1
                                }
                            }
                        }
                    }
                }
                IfCondition EqualTo(folded, 0) ThenBlock: {
                    t = 0
                    WhileLoop LessThan(t, count) {
                        SB.Byte(10)
                        t = Add(t, 1)
                    }
                }
                i = j
            }
        }
    }
}

Function.YAML.ParseBlockScalar {
    Input: head: Integer
    Input: ctx: Integer
    Output: Address
    Body: {
        YAML.Bump()
        chomp = 0
        ind_add = -1
        looping = 1
        WhileLoop EqualTo(looping, 1) {
            c = YAML.Peek()
            IfCondition EqualTo(c, 43) ThenBlock: {
                chomp = 1
                YAML.Bump()
            } ElseBlock: {
                IfCondition EqualTo(c, 45) ThenBlock: {
                    chomp = -1
                    YAML.Bump()
                } ElseBlock: {
                    dig = YAML.IsDigit(c)
                    IfCondition EqualTo(dig, 1) ThenBlock: {
                        ind_add = 0
                        dcount = 0
                        WhileLoop EqualTo(dig, 1) {
                            ind_add = Multiply(ind_add, 10)
                            ind_add = Add(ind_add, Subtract(c, 48))
                            dcount = Add(dcount, 1)
                            YAML.Bump()
                            c = YAML.Peek()
                            dig = YAML.IsDigit(c)
                        }
                        IfCondition GreaterThan(dcount, 1) ThenBlock: {
                            YAML.Fail("bad block indent")
                        }
                        IfCondition EqualTo(ind_add, 0) ThenBlock: {
                            YAML.Fail("bad block indent")
                        }
                    } ElseBlock: {
                        looping = 0
                    }
                }
            }
        }
        YAML.SkipHSpace()
        heol = YAML.AtEol()
        IfCondition EqualTo(heol, 0) ThenBlock: {
            YAML.Fail("bad block header")
        }
        parent = ctx
        YAML.FinishLine()
        content_ind = -1
        IfCondition GreaterEqual(ind_add, 0) ThenBlock: {
            content_ind = Add(parent, ind_add)
        }
        start_idx = YP.idx
        IfCondition LessThan(content_ind, 0) ThenBlock: {
            look = start_idx
            nlines = Array.Size(YP.lines)
            found = 0
            lead_max = -1
            WhileLoop EqualTo(found, 0) {
                IfCondition GreaterEqual(look, nlines) ThenBlock: {
                    found = 1
                } ElseBlock: {
                    rec = Array.Get(YP.lines, look)
                    st = RDMEM_64(rec)
                    ln = RDMEM_64(rec, 8)
                    ind = RDMEM_64(rec, 16)
                    flag = RDMEM_64(rec, 24)
                    clen = Subtract(ln, ind)
                    IfCondition GreaterThan(clen, 0) ThenBlock: {
                        bad_lead = 0
                        IfCondition GreaterThan(lead_max, ind) ThenBlock: {
                            bad_lead = 1
                        }
                        IfCondition EqualTo(flag, 1) ThenBlock: {
                            IfCondition LessEqual(ind, parent) ThenBlock: {
                                bad_lead = 1
                            }
                        }
                        IfCondition EqualTo(bad_lead, 1) ThenBlock: {
                            YAML.Fail("bad block indent")
                        }
                        IfCondition GreaterThan(ind, parent) ThenBlock: {
                            content_ind = ind
                        }
                        found = 1
                    } ElseBlock: {
                        IfCondition GreaterThan(ind, lead_max) ThenBlock: {
                            lead_max = ind
                        }
                        look = Add(look, 1)
                    }
                }
            }
        }
        SB.Reset()
        IfCondition GreaterEqual(content_ind, 0) ThenBlock: {
            nlines = Array.Size(YP.lines)
            looping2 = 1
            WhileLoop EqualTo(looping2, 1) {
                IfCondition GreaterEqual(YP.idx, nlines) ThenBlock: {
                    looping2 = 0
                } ElseBlock: {
                    rec = Array.Get(YP.lines, YP.idx)
                    st = RDMEM_64(rec)
                    ln = RDMEM_64(rec, 8)
                    ind = RDMEM_64(rec, 16)
                    clen = Subtract(ln, ind)
                    flag = RDMEM_64(rec, 24)
                    stop = 0
                    mk = YAML.RecMarker(rec)
                    IfCondition NotEqual(mk, 0) ThenBlock: { stop = 1 }
                    IfCondition LessThan(ind, content_ind) ThenBlock: {
                        IfCondition GreaterThan(clen, 0) ThenBlock: {
                            IfCondition EqualTo(flag, 1) ThenBlock: {
                                YAML.Fail("bad block indent")
                            }
                            stop = 1
                        }
                    }
                    IfCondition EqualTo(stop, 1) ThenBlock: {
                        looping2 = 0
                    } ElseBlock: {
                        IfCondition LessThan(ind, content_ind) ThenBlock: {
                            SB.Byte(10)
                        } ElseBlock: {
                            extra = Subtract(ind, content_ind)
                            e = 0
                            WhileLoop LessThan(e, extra) {
                                SB.Byte(32)
                                e = Add(e, 1)
                            }
                            p = 0
                            WhileLoop LessThan(p, clen) {
                                bp = Add(st, Add(ind, p))
                                bb = RDMEM_8(Add(YP.buf, bp))
                                SB.Byte(bb)
                                p = Add(p, 1)
                            }
                            SB.Byte(10)
                        }
                        YP.idx = Add(YP.idx, 1)
                    }
                }
            }
        } ElseBlock: {
            nlines = Array.Size(YP.lines)
            looping2 = 1
            WhileLoop EqualTo(looping2, 1) {
                IfCondition GreaterEqual(YP.idx, nlines) ThenBlock: {
                    looping2 = 0
                } ElseBlock: {
                    rec = Array.Get(YP.lines, YP.idx)
                    ln = RDMEM_64(rec, 8)
                    ind = RDMEM_64(rec, 16)
                    clen = Subtract(ln, ind)
                    mk = YAML.RecMarker(rec)
                    empty_line = 0
                    IfCondition EqualTo(clen, 0) ThenBlock: {
                        IfCondition EqualTo(mk, 0) ThenBlock: {
                            empty_line = 1
                        }
                    }
                    IfCondition EqualTo(empty_line, 1) ThenBlock: {
                        SB.Byte(10)
                        YP.idx = Add(YP.idx, 1)
                    } ElseBlock: {
                        looping2 = 0
                    }
                }
            }
            IfCondition NotEqual(chomp, 1) ThenBlock: {
                SB.Reset()
            }
        }
        YP.ready = 0
        IfCondition EqualTo(head, 62) ThenBlock: {
            YAML.FoldBuffer()
        }
        YAML.ChompText(chomp)
        text = SB.Take()
        sl = SB.last
        node = YAML.NewNode(1)
        stl = 3
        IfCondition EqualTo(head, 62) ThenBlock: {
            stl = 4
        }
        WRMEM_64(node, 8, stl)
        WRMEM_64(node, 32, text)
        WRMEM_64(node, 48, sl)
        WRMEM_64(node, 56, 0)
        ReturnValue(node)
    }
}

Function.YAML.EqLit {
    Input: s: Address
    Input: lit: Address
    Output: Integer
    Body: {
        c = StringCompare(s, lit)
        IfCondition EqualTo(c, 0) ThenBlock: {
            ReturnValue(1)
        }
        ReturnValue(0)
    }
}

Function.YAML.ParsePlainNumber {
    Input: node: Address
    Body: {
        text = RDMEM_64(node, 32)
        sl = RDMEM_64(node, 48)
        IfCondition EqualTo(sl, 0) ThenBlock: {
            WRMEM_64(node, 56, 1)
        } ElseBlock: {
            is_null = 0
            is_bool = 0
            bval = 0
            en = YAML.EqLit(text, "null")
            IfCondition EqualTo(en, 1) ThenBlock: { is_null = 1 }
            en = YAML.EqLit(text, "Null")
            IfCondition EqualTo(en, 1) ThenBlock: { is_null = 1 }
            en = YAML.EqLit(text, "NULL")
            IfCondition EqualTo(en, 1) ThenBlock: { is_null = 1 }
            en = YAML.EqLit(text, "~")
            IfCondition EqualTo(en, 1) ThenBlock: { is_null = 1 }
            en = YAML.EqLit(text, "true")
            IfCondition EqualTo(en, 1) ThenBlock: {
                is_bool = 1
                bval = 1
            }
            en = YAML.EqLit(text, "True")
            IfCondition EqualTo(en, 1) ThenBlock: {
                is_bool = 1
                bval = 1
            }
            en = YAML.EqLit(text, "TRUE")
            IfCondition EqualTo(en, 1) ThenBlock: {
                is_bool = 1
                bval = 1
            }
            en = YAML.EqLit(text, "false")
            IfCondition EqualTo(en, 1) ThenBlock: {
                is_bool = 1
                bval = 0
            }
            en = YAML.EqLit(text, "False")
            IfCondition EqualTo(en, 1) ThenBlock: {
                is_bool = 1
                bval = 0
            }
            en = YAML.EqLit(text, "FALSE")
            IfCondition EqualTo(en, 1) ThenBlock: {
                is_bool = 1
                bval = 0
            }
            IfCondition EqualTo(is_null, 1) ThenBlock: {
                WRMEM_64(node, 56, 1)
            } ElseBlock: {
                IfCondition EqualTo(is_bool, 1) ThenBlock: {
                    WRMEM_64(node, 56, 2)
                    WRMEM_64(node, 64, bval)
                } ElseBlock: {
                    YAML.ParseNumText(node)
                }
            }
        }
    }
}

Function.YAML.ParseNumText {
    Input: node: Address
    Body: {
        text = RDMEM_64(node, 32)
        sl = RDMEM_64(node, 48)
        i = 0
        sign = 1
        b0 = RDMEM_8(text)
        IfCondition EqualTo(b0, 45) ThenBlock: {
            sign = -1
            i = 1
        }
        IfCondition EqualTo(b0, 43) ThenBlock: {
            i = 1
        }
        IfCondition GreaterEqual(i, sl) ThenBlock: {
            i = i
        } ElseBlock: {
            c0 = RDMEM_8(Add(text, i))
            c1 = -1
            IfCondition LessThan(Add(i, 1), sl) ThenBlock: {
                c1 = RDMEM_8(Add(text, Add(i, 1)))
            }
            base = 0
            IfCondition EqualTo(c0, 48) ThenBlock: {
                IfCondition EqualTo(c1, 120) ThenBlock: { base = 16 }
                IfCondition EqualTo(c1, 88) ThenBlock: { base = 16 }
                IfCondition EqualTo(c1, 111) ThenBlock: { base = 8 }
                IfCondition EqualTo(c1, 79) ThenBlock: { base = 8 }
            }
            IfCondition GreaterThan(base, 0) ThenBlock: {
                hk = Add(i, 2)
                hv = 0
                hdigits = 0
                hgood = 1
                WhileLoop LessThan(hk, sl) {
                    hck = RDMEM_8(Add(text, hk))
                    IfCondition EqualTo(base, 16) ThenBlock: {
                        hxv = YAML.HexVal(hck)
                        IfCondition LessThan(hxv, 0) ThenBlock: {
                            hgood = 0
                        } ElseBlock: {
                            hv = Multiply(hv, 16)
                            hv = Add(hv, hxv)
                            hdigits = Add(hdigits, 1)
                        }
                    } ElseBlock: {
                        od = 0
                        IfCondition GreaterEqual(hck, 48) ThenBlock: {
                            IfCondition LessEqual(hck, 55) ThenBlock: {
                                od = 1
                            }
                        }
                        IfCondition EqualTo(od, 0) ThenBlock: {
                            hgood = 0
                        } ElseBlock: {
                            hv = Multiply(hv, 8)
                            hv = Add(hv, Subtract(hck, 48))
                            hdigits = Add(hdigits, 1)
                        }
                    }
                    hk = Add(hk, 1)
                }
                IfCondition EqualTo(hgood, 1) ThenBlock: {
                    IfCondition GreaterThan(hdigits, 0) ThenBlock: {
                        IfCondition EqualTo(sign, -1) ThenBlock: {
                            hv = Subtract(0, hv)
                        }
                        WRMEM_64(node, 56, 3)
                        WRMEM_64(node, 64, hv)
                    }
                }
            }
            is_float = 0
            IfCondition EqualTo(c0, 46) ThenBlock: {
                is_float = 1
            }
            k = i
            saw_dot = 0
            saw_exp = 0
            oknum = 1
            digits = 0
            WhileLoop LessThan(k, sl) {
                ck = RDMEM_8(Add(text, k))
                dig = YAML.IsDigit(ck)
                IfCondition EqualTo(dig, 1) ThenBlock: {
                    digits = Add(digits, 1)
                } ElseBlock: {
                    IfCondition EqualTo(ck, 46) ThenBlock: {
                        saw_dot = 1
                        is_float = 1
                    } ElseBlock: {
                        IfCondition EqualTo(ck, 101) ThenBlock: {
                            saw_exp = 1
                            is_float = 1
                        } ElseBlock: {
                            IfCondition EqualTo(ck, 69) ThenBlock: {
                                saw_exp = 1
                                is_float = 1
                            } ElseBlock: {
                                oknum = 0
                            }
                        }
                    }
                }
                k = Add(k, 1)
            }
            IfCondition EqualTo(oknum, 1) ThenBlock: {
                IfCondition GreaterThan(digits, 0) ThenBlock: {
                    IfCondition EqualTo(is_float, 1) ThenBlock: {
                        WRMEM_64(node, 56, 4)
                    } ElseBlock: {
                        v = 0
                        k = i
                        IfCondition EqualTo(c0, 48) ThenBlock: {
                            IfCondition EqualTo(c1, 120) ThenBlock: {
                                k = Add(i, 2)
                                WhileLoop LessThan(k, sl) {
                                    ck = RDMEM_8(Add(text, k))
                                    hv = YAML.HexVal(ck)
                                    v = Multiply(v, 16)
                                    v = Add(v, hv)
                                    k = Add(k, 1)
                                }
                            } ElseBlock: {
                                IfCondition EqualTo(c1, 111) ThenBlock: {
                                    k = Add(i, 2)
                                    WhileLoop LessThan(k, sl) {
                                        ck = RDMEM_8(Add(text, k))
                                        v = Multiply(v, 8)
                                        v = Add(v, Subtract(ck, 48))
                                        k = Add(k, 1)
                                    }
                                } ElseBlock: {
                                    WhileLoop LessThan(k, sl) {
                                        ck = RDMEM_8(Add(text, k))
                                        v = Multiply(v, 10)
                                        v = Add(v, Subtract(ck, 48))
                                        k = Add(k, 1)
                                    }
                                }
                            }
                        } ElseBlock: {
                            WhileLoop LessThan(k, sl) {
                                ck = RDMEM_8(Add(text, k))
                                v = Multiply(v, 10)
                                v = Add(v, Subtract(ck, 48))
                                k = Add(k, 1)
                            }
                        }
                        IfCondition EqualTo(sign, -1) ThenBlock: {
                            v = Subtract(0, v)
                        }
                        WRMEM_64(node, 56, 3)
                        WRMEM_64(node, 64, v)
                    }
                }
            }
        }
    }
}

Function.YAML.ResolveTagged {
    Input: node: Address
    Body: {
        kind = RDMEM_64(node)
        IfCondition NotEqual(kind, 1) ThenBlock: {
            kind = kind
        } ElseBlock: {
            tag = RDMEM_64(node, 24)
            IfCondition NotEqual(tag, 0) ThenBlock: {
                non = YAML.EqLit(tag, "!")
                IfCondition EqualTo(non, 1) ThenBlock: {
                    WRMEM_64(node, 56, 0)
                }
            }
            IfCondition EqualTo(tag, 0) ThenBlock: {
                style = RDMEM_64(node, 8)
                IfCondition EqualTo(style, 0) ThenBlock: {
                    YAML.ParsePlainNumber(node)
                }
            } ElseBlock: {
                is_str = YAML.EqLit(tag, "tag:yaml.org,2002:str")
                is_int = YAML.EqLit(tag, "tag:yaml.org,2002:int")
                is_null = YAML.EqLit(tag, "tag:yaml.org,2002:null")
                is_bool = YAML.EqLit(tag, "tag:yaml.org,2002:bool")
                is_float = YAML.EqLit(tag, "tag:yaml.org,2002:float")
                IfCondition EqualTo(is_str, 1) ThenBlock: {
                    WRMEM_64(node, 56, 0)
                }
                IfCondition EqualTo(is_null, 1) ThenBlock: {
                    WRMEM_64(node, 56, 1)
                }
                IfCondition EqualTo(is_bool, 1) ThenBlock: {
                    YAML.ParsePlainNumber(node)
                    WRMEM_64(node, 56, 2)
                }
                IfCondition EqualTo(is_int, 1) ThenBlock: {
                    YAML.ParsePlainNumber(node)
                    WRMEM_64(node, 56, 3)
                }
                IfCondition EqualTo(is_float, 1) ThenBlock: {
                    WRMEM_64(node, 56, 4)
                }
            }
        }
    }
}
