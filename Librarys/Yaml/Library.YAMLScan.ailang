Function.YAML.Reset {
    Body: {
        YP.buf = 0
        YP.blen = 0
        YP.lines = 0
        YP.idx = 0
        YP.off = 0
        YP.eol = 0
        YP.ind = 0
        YP.col = 0
        YP.err = 0
        YP.errmsg = 0
        YP.anchors = 0
        YP.docs = 0
        YP.tags = 0
        YP.depth = 0
        YP.ready = 0
        YP.tabind = 0
        YP.lstart = 0
        YP.fmin = -2
        SB.data = 0
        SB.len = 0
        SB.cap = 0
        SB.last = 0
        YB.data = 0
        YB.len = 0
        YB.cap = 0
    }
}

Function.YAML.PushLine {
    Input: start: Integer
    Input: ln: Integer
    Body: {
        indent = 0
        flag = 0
        j = 0
        stopped = 0
        WhileLoop EqualTo(stopped, 0) {
            IfCondition GreaterEqual(j, ln) ThenBlock: {
                stopped = 1
            } ElseBlock: {
                pos = Add(start, j)
                b = RDMEM_8(Add(YP.buf, pos))
                IfCondition EqualTo(b, 32) ThenBlock: {
                    indent = Add(indent, 1)
                    j = Add(j, 1)
                } ElseBlock: {
                    IfCondition EqualTo(b, 9) ThenBlock: {
                        flag = 1
                    }
                    stopped = 1
                }
            }
        }
        rec = Allocate(32)
        WRMEM_64(rec, start)
        WRMEM_64(rec, 8, ln)
        WRMEM_64(rec, 16, indent)
        WRMEM_64(rec, 24, flag)
        Array.Push(YP.lines, rec)
    }
}

Function.YAML.Split {
    Input: buf: Address
    Input: n: Integer
    Body: {
        YP.buf = buf
        YP.blen = n
        YP.lines = Array.Create(32)
        YP.idx = 0
        YP.ready = 0
        YP.anchors = 0
        YP.docs = Array.Create(4)
        YP.tags = 0
        YP.err = 0
        i = 0
        IfCondition GreaterEqual(n, 3) ThenBlock: {
            b0 = RDMEM_8(buf)
            b1 = RDMEM_8(Add(buf, 1))
            b2 = RDMEM_8(Add(buf, 2))
            IfCondition EqualTo(b0, 239) ThenBlock: {
                IfCondition EqualTo(b1, 187) ThenBlock: {
                    IfCondition EqualTo(b2, 191) ThenBlock: {
                        i = 3
                    }
                }
            }
        }
        start = i
        WhileLoop LessThan(i, n) {
            b = RDMEM_8(Add(buf, i))
            IfCondition EqualTo(b, 10) ThenBlock: {
                ln = Subtract(i, start)
                IfCondition GreaterThan(ln, 0) ThenBlock: {
                    prevp = Subtract(i, 1)
                    prev = RDMEM_8(Add(buf, prevp))
                    IfCondition EqualTo(prev, 13) ThenBlock: {
                        ln = Subtract(ln, 1)
                    }
                }
                YAML.PushLine(start, ln)
                start = Add(i, 1)
            }
            i = Add(i, 1)
        }
        IfCondition LessThan(start, n) ThenBlock: {
            ln2 = Subtract(n, start)
            IfCondition GreaterThan(ln2, 0) ThenBlock: {
                prevp2 = Subtract(n, 1)
                prev2 = RDMEM_8(Add(buf, prevp2))
                IfCondition EqualTo(prev2, 13) ThenBlock: {
                    ln2 = Subtract(ln2, 1)
                }
            }
            IfCondition GreaterThan(ln2, 0) ThenBlock: {
                YAML.PushLine(start, ln2)
            }
        }
    }
}

Function.YAML.Ensure {
    Output: Integer
    Body: {
        IfCondition EqualTo(YP.err, 1) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition EqualTo(YP.ready, 1) ThenBlock: {
            ReturnValue(1)
        }
        n = Array.Size(YP.lines)
        IfCondition GreaterEqual(YP.idx, n) ThenBlock: {
            ReturnValue(0)
        }
        rec = Array.Get(YP.lines, YP.idx)
        st = RDMEM_64(rec)
        ln = RDMEM_64(rec, 8)
        ind = RDMEM_64(rec, 16)
        flag = RDMEM_64(rec, 24)
        YP.lstart = st
        YP.ind = ind
        YP.off = Add(st, ind)
        YP.eol = Add(st, ln)
        YP.col = ind
        YP.tabind = flag
        YP.ready = 1
        ReturnValue(1)
    }
}

Function.YAML.FinishLine {
    Body: {
        YP.idx = Add(YP.idx, 1)
        YP.ready = 0
    }
}

Function.YAML.Peek {
    Output: Integer
    Body: {
        IfCondition GreaterEqual(YP.off, YP.eol) ThenBlock: {
            ReturnValue(-1)
        }
        ReturnValue(RDMEM_8(Add(YP.buf, YP.off)))
    }
}

Function.YAML.AtRel {
    Input: rel: Integer
    Output: Integer
    Body: {
        p = Add(YP.off, rel)
        IfCondition GreaterEqual(p, YP.eol) ThenBlock: {
            ReturnValue(-1)
        }
        IfCondition LessThan(p, 0) ThenBlock: {
            ReturnValue(-1)
        }
        ReturnValue(RDMEM_8(Add(YP.buf, p)))
    }
}

Function.YAML.Bump {
    Body: {
        IfCondition LessThan(YP.off, YP.eol) ThenBlock: {
            YP.off = Add(YP.off, 1)
            YP.col = Add(YP.col, 1)
        }
    }
}

Function.YAML.SkipHSpace {
    Body: {
        looping = 1
        WhileLoop EqualTo(looping, 1) {
            c = YAML.Peek()
            IfCondition EqualTo(c, 32) ThenBlock: {
                YAML.Bump()
            } ElseBlock: {
                IfCondition EqualTo(c, 9) ThenBlock: {
                    YAML.Bump()
                } ElseBlock: {
                    looping = 0
                }
            }
        }
    }
}

Function.YAML.AtComment {
    Output: Integer
    Body: {
        c = YAML.Peek()
        IfCondition NotEqual(c, 35) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition EqualTo(YP.off, Add(YP.lstart, YP.ind)) ThenBlock: {
            ReturnValue(1)
        }
        IfCondition GreaterThan(YP.off, YP.lstart) ThenBlock: {
            prevp = Subtract(YP.off, 1)
            prev = RDMEM_8(Add(YP.buf, prevp))
            IfCondition EqualTo(prev, 32) ThenBlock: {
                ReturnValue(1)
            }
            IfCondition EqualTo(prev, 9) ThenBlock: {
                ReturnValue(1)
            }
        }
        ReturnValue(0)
    }
}

Function.YAML.AtEol {
    Output: Integer
    Body: {
        c = YAML.Peek()
        IfCondition EqualTo(c, -1) ThenBlock: {
            ReturnValue(1)
        }
        ac = YAML.AtComment()
        IfCondition EqualTo(ac, 1) ThenBlock: {
            ReturnValue(1)
        }
        ReturnValue(0)
    }
}

Function.YAML.LineBlank {
    Output: Integer
    Body: {
        saved_off = YP.off
        saved_col = YP.col
        YAML.SkipHSpace()
        blank = YAML.AtEol()
        YP.off = saved_off
        YP.col = saved_col
        ReturnValue(blank)
    }
}

Function.YAML.SkipToContent {
    Output: Integer
    Body: {
        found = 0
        looping = 1
        WhileLoop EqualTo(looping, 1) {
            ok = YAML.Ensure()
            IfCondition EqualTo(ok, 0) ThenBlock: {
                looping = 0
            } ElseBlock: {
                at_start = 0
                IfCondition EqualTo(YP.col, YP.ind) ThenBlock: {
                    at_start = 1
                }
                blank = 0
                IfCondition EqualTo(at_start, 1) ThenBlock: {
                    blank = YAML.LineBlank()
                }
                IfCondition EqualTo(blank, 1) ThenBlock: {
                    YAML.FinishLine()
                } ElseBlock: {
                    found = 1
                    looping = 0
                }
            }
        }
        ReturnValue(found)
    }
}

Function.YAML.MarkerKind {
    Output: Integer
    Body: {
        IfCondition NotEqual(YP.ind, 0) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition NotEqual(YP.col, 0) ThenBlock: {
            ReturnValue(0)
        }
        a = YAML.AtRel(0)
        b = YAML.AtRel(1)
        c = YAML.AtRel(2)
        d = YAML.AtRel(3)
        kind = 0
        IfCondition EqualTo(a, 45) ThenBlock: {
            IfCondition EqualTo(b, 45) ThenBlock: {
                IfCondition EqualTo(c, 45) ThenBlock: {
                    kind = 1
                }
            }
        }
        IfCondition EqualTo(a, 46) ThenBlock: {
            IfCondition EqualTo(b, 46) ThenBlock: {
                IfCondition EqualTo(c, 46) ThenBlock: {
                    kind = 2
                }
            }
        }
        IfCondition EqualTo(kind, 0) ThenBlock: {
            ReturnValue(0)
        }
        okd = 0
        IfCondition EqualTo(d, -1) ThenBlock: { okd = 1 }
        IfCondition EqualTo(d, 32) ThenBlock: { okd = 1 }
        IfCondition EqualTo(d, 9) ThenBlock: { okd = 1 }
        IfCondition EqualTo(d, 35) ThenBlock: { okd = 1 }
        IfCondition EqualTo(okd, 0) ThenBlock: {
            ReturnValue(0)
        }
        ReturnValue(kind)
    }
}

Function.YAML.CopySpan {
    Input: start: Integer
    Input: n: Integer
    Output: Address
    Body: {
        s = Allocate(Add(n, 1))
        IfCondition GreaterThan(n, 0) ThenBlock: {
            src = Add(YP.buf, start)
            MemoryCopy(s, src, n)
        }
        WRMEM_8(s, n, 0)
        ReturnValue(s)
    }
}

Function.SB.Need {
    Input: n: Integer
    Body: {
        need = Add(SB.len, n)
        IfCondition GreaterEqual(SB.cap, need) ThenBlock: {
            need = need
        } ElseBlock: {
            newcap = 256
            IfCondition GreaterThan(SB.cap, 0) ThenBlock: {
                newcap = Multiply(SB.cap, 2)
            }
            growing = 1
            WhileLoop EqualTo(growing, 1) {
                IfCondition GreaterThan(newcap, need) ThenBlock: {
                    growing = 0
                } ElseBlock: {
                    newcap = Multiply(newcap, 2)
                }
            }
            nb = Allocate(newcap)
            IfCondition GreaterThan(SB.len, 0) ThenBlock: {
                MemoryCopy(nb, SB.data, SB.len)
            }
            SB.data = nb
            SB.cap = newcap
        }
    }
}

Function.SB.Reset {
    Body: {
        SB.len = 0
    }
}

Function.SB.Byte {
    Input: b: Integer
    Body: {
        SB.Need(1)
        WRMEM_8(SB.data, SB.len, b)
        SB.len = Add(SB.len, 1)
    }
}

Function.SB.Take {
    Output: Address
    Body: {
        n = SB.len
        s = Allocate(Add(n, 1))
        IfCondition GreaterThan(n, 0) ThenBlock: {
            MemoryCopy(s, SB.data, n)
        }
        WRMEM_8(s, n, 0)
        SB.last = n
        SB.len = 0
        ReturnValue(s)
    }
}

Function.YB.Need {
    Input: n: Integer
    Body: {
        need = Add(YB.len, n)
        IfCondition GreaterEqual(YB.cap, need) ThenBlock: {
            need = need
        } ElseBlock: {
            newcap = 256
            IfCondition GreaterThan(YB.cap, 0) ThenBlock: {
                newcap = Multiply(YB.cap, 2)
            }
            growing = 1
            WhileLoop EqualTo(growing, 1) {
                IfCondition GreaterThan(newcap, need) ThenBlock: {
                    growing = 0
                } ElseBlock: {
                    newcap = Multiply(newcap, 2)
                }
            }
            nb = Allocate(newcap)
            IfCondition GreaterThan(YB.len, 0) ThenBlock: {
                MemoryCopy(nb, YB.data, YB.len)
            }
            YB.data = nb
            YB.cap = newcap
        }
    }
}

Function.YB.Reset {
    Body: {
        YB.len = 0
    }
}

Function.YB.Byte {
    Input: b: Integer
    Body: {
        YB.Need(1)
        WRMEM_8(YB.data, YB.len, b)
        YB.len = Add(YB.len, 1)
    }
}

Function.YB.Str {
    Input: s: Address
    Body: {
        IfCondition EqualTo(s, 0) ThenBlock: {
            s = s
        } ElseBlock: {
            n = StringLength(s)
            i = 0
            WhileLoop LessThan(i, n) {
                b = RDMEM_8(Add(s, i))
                YB.Byte(b)
                i = Add(i, 1)
            }
        }
    }
}

Function.YB.Take {
    Output: Address
    Body: {
        n = YB.len
        s = Allocate(Add(n, 1))
        IfCondition GreaterThan(n, 0) ThenBlock: {
            MemoryCopy(s, YB.data, n)
        }
        WRMEM_8(s, n, 0)
        YB.len = 0
        ReturnValue(s)
    }
}
