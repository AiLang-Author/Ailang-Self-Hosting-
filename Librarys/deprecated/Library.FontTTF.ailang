// =============================================================================
// SET POINT SIZE
// =============================================================================

Function.FontTTF_SetSize {
    Input: handle: Integer
    Input: point_size: Integer
    Body: {
        font_data = Font_GetRegistryInt(FontRegistry.data_ptrs, handle)
        IfCondition EqualTo(font_data, 0) ThenBlock: {
            ReturnValue(0)
        }
        
        TTF_StoreInt(font_data, TTFOffsets.POINT_SIZE, point_size)
        
        // Recalculate pixel height
        units_per_em = TTF_LoadInt(font_data, TTFOffsets.UNITS_PER_EM)
        ascender = TTF_LoadInt(font_data, TTFOffsets.ASCENDER)
        descender = TTF_LoadInt(font_data, TTFOffsets.DESCENDER)
        
        // pixels = (ascender - descender) * point_size / units_per_em
        // Assuming 96 DPI: point_size * 96/72 = point_size * 1.33
        pixel_height = Divide(Multiply(Subtract(ascender, descender), point_size), units_per_em)
        
        Font_SetRegistryInt(FontRegistry.heights, handle, pixel_height)
        Font_SetRegistryInt(FontRegistry.baselines, handle, Divide(Multiply(ascender, point_size), units_per_em))
        
        // Invalidate glyph cache
        // TODO: Clear cache when size changes
        
        ReturnValue(1)
    }
}