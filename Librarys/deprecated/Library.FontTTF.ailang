Function.FontTTF_GetCharWidth {
    Input: handle: Integer
    Input: ch: Integer
    Output: Integer
    Body: {
        // TODO: Look up glyph ID from cmap, then get advance width from hmtx
        
        // Placeholder: assume average width is ~60% of height
        height = Font_GetHeight(handle)
        ReturnValue(Divide(Multiply(height, 6), 10))
    }
}

Function.FontTTF_DrawChar {
    Input: handle: Integer
    Input: x: Integer
    Input: y: Integer
    Input: ch: Integer
    Input: color: Integer
    Output: Integer
    Body: {
        // TODO: Full implementation requires:
        // 1. Map character to glyph ID (cmap table)
        // 2. Load glyph outline (loca + glyf tables)
        // 3. Scale outline to pixel size
        // 4. Rasterize outline (scan conversion)
        // 5. Draw rasterized bitmap
        
        // Placeholder: Draw a simple rectangle
        height = Font_GetHeight(handle)
        width = FontTTF_GetCharWidth(handle, ch)
        
        // Draw outline rectangle as placeholder
        FB_Rect(x, y, width, height, color)
        
        // Draw character code in center (for debugging)
        cx = Add(x, Divide(width, 2))
        cy = Add(y, Divide(height, 2))
        FB_SetPixel(cx, cy, color)
        
        ReturnValue(width)
    }
}

// =============================================================================
// TTF TABLE PARSING HELPERS
// =============================================================================

// Find table by tag, return offset (0 if not found)
Function.TTF_FindTable {
    Input: file_data: Address
    Input: num_tables: Integer
    Input: tag: Integer
    Output: Integer
    Body: {
        // Table directory starts at offset 12
        // Each entry is 16 bytes: tag(4), checksum(4), offset(4), length(4)
        
        i = 0
        WhileLoop LessThan(i, num_tables) {
            entry_offset = Add(12, Multiply(i, 16))
            table_tag = TTF_ReadU32(file_data, entry_offset)
            
            IfCondition EqualTo(table_tag, tag) ThenBlock: {
                table_offset = TTF_ReadU32(file_data, Add(entry_offset, 8))
                ReturnValue(table_offset)
            }
            
            i = Add(i, 1)
        }
        
        ReturnValue(0)
    }
}

// =============================================================================
// TTF BYTE ORDER HELPERS (Big-endian)
// =============================================================================

Function.TTF_ReadU16 {
    Input: data: Address
    Input: offset: Integer
    Output: Integer
    Body: {
        b0 = GetByte(data, offset)
        b1 = GetByte(data, Add(offset, 1))
        ReturnValue(BitwiseOr(ShiftLeft(b0, 8), b1))
    }
}

Function.TTF_ReadS16 {
    Input: data: Address
    Input: offset: Integer
    Output: Integer
    Body: {
        val = TTF_ReadU16(data, offset)
        // Sign extend
        IfCondition NotEqual(BitwiseAnd(val, 0x8000), 0) ThenBlock: {
            val = Subtract(val, 65536)
        }
        ReturnValue(val)
    }
}

Function.TTF_ReadU32 {
    Input: data: Address
    Input: offset: Integer
    Output: Integer
    Body: {
        b0 = GetByte(data, offset)
        b1 = GetByte(data, Add(offset, 1))
        b2 = GetByte(data, Add(offset, 2))
        b3 = GetByte(data, Add(offset, 3))
        ReturnValue(BitwiseOr(ShiftLeft(b0, 24), BitwiseOr(ShiftLeft(b1, 16), BitwiseOr(ShiftLeft(b2, 8), b3))))
    }
}

Function.TTF_StoreInt {
    Input: ptr: Address
    Input: offset: Integer
    Input: value: Integer
    Body: {
        // Store as little-endian (internal format)
        SetByte(ptr, offset, BitwiseAnd(value, 0xFF))
        SetByte(ptr, Add(offset, 1), BitwiseAnd(ShiftRight(value, 8), 0xFF))
        SetByte(ptr, Add(offset, 2), BitwiseAnd(ShiftRight(value, 16), 0xFF))
        SetByte(ptr, Add(offset, 3), BitwiseAnd(ShiftRight(value, 24), 0xFF))
    }
}

Function.TTF_LoadInt {
    Input: ptr: Address
    Input: offset: Integer
    Output: Integer
    Body: {
        b0 = GetByte(ptr, offset)
        b1 = GetByte(ptr, Add(offset, 1))
        b2 = GetByte(ptr, Add(offset, 2))
        b3 = GetByte(ptr, Add(offset, 3))
        ReturnValue(BitwiseOr(b0, BitwiseOr(ShiftLeft(b1, 8), BitwiseOr(ShiftLeft(b2, 16), ShiftLeft(b3, 24)))))
    }
}

// =============================================================================
// TTF GLYPH LOADING - STUB
// =============================================================================

// TODO: Implement these for full TTF support

// Get glyph ID from character code via cmap
Function.TTF_GetGlyphID {
    Input: font_data: Address
    Input: char_code: Integer
    Output: Integer
    Body: {
        // TODO: Parse cmap table, find appropriate subtable
        // Common formats: 0 (byte), 4 (segment), 12 (32-bit)
        
        // Placeholder: assume 1:1 mapping for ASCII
        IfCondition And(GreaterEqual(char_code, 32), LessThan(char_code, 128)) ThenBlock: {
            ReturnValue(char_code)
        }
        ReturnValue(0)  // .notdef
    }
}

// Get glyph outline data offset
Function.TTF_GetGlyphOffset {
    Input: font_data: Address
    Input: glyph_id: Integer
    Output: Integer
    Body: {
        file_data = TTF_LoadInt(font_data, TTFOffsets.FILE_DATA)
        loca_offset = TTF_LoadInt(font_data, TTFOffsets.LOCA_OFFSET)
        glyf_offset = TTF_LoadInt(font_data, TTFOffsets.GLYF_OFFSET)
        loca_format = TTF_LoadInt(font_data, TTFOffsets.LOCA_FORMAT)
        
        // Read offset from loca table
        glyph_offset = 0
        IfCondition EqualTo(loca_format, 0) ThenBlock: {
            // Short format: offsets are 16-bit, multiplied by 2
            offset_in_loca = Add(loca_offset, Multiply(glyph_id, 2))
            glyph_offset = Multiply(TTF_ReadU16(file_data, offset_in_loca), 2)
        } ElseBlock: {
            // Long format: offsets are 32-bit
            offset_in_loca = Add(loca_offset, Multiply(glyph_id, 4))
            glyph_offset = TTF_ReadU32(file_data, offset_in_loca)
        }
        
        ReturnValue(Add(glyf_offset, glyph_offset))
    }
}

