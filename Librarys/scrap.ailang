FixedPool.S {
    "r": Initialize=0
}

SubRoutine.Loop {
    cnt = 0
    WhileLoop EqualTo(Subtract(S.r, 65536), 1) {
        cnt = Add(cnt, 1)
        PrintMessage("tick ")
        PrintNumber(cnt)
        PrintMessage("\n")
        IfCondition GreaterThan(cnt, 3) ThenBlock: {
            S.r = Add(0, 65536)
        }
    }
}

SubRoutine.Main {
    S.r = Add(1, 65536)
    RunTask(Loop)
    PrintMessage("done\n")
    Exit(0)
}

RunTask(Main)