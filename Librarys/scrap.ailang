SubRoutine.Main {
    w = 1280
    h = 1024
    PrintMessage("w=")
    PrintNumber(w)
    PrintMessage("\n")
    hw = Divide(w, 2)
    PrintMessage("w/2=")
    PrintNumber(hw)
    PrintMessage("\n")
    hh = Divide(h, 2)
    PrintMessage("h/2=")
    PrintNumber(hh)
    PrintMessage("\n")
    cx = Subtract(hw, 100)
    cy = Subtract(hh, 100)
    PrintMessage("cx=")
    PrintNumber(cx)
    PrintMessage(" cy=")
    PrintNumber(cy)
    PrintMessage("\n")
    Exit(0)
}
RunTask(Main)