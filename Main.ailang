// =============================================================================
// APP STATE
// =============================================================================
FixedPool.AppState {
    "doc":         Initialize=-1, CanChange=True
    "line_count":  Initialize=0, CanChange=True
    "win_idx":     Initialize=-1, CanChange=True
    "fb_win_idx":  Initialize=-1, CanChange=True
    "fb_doc":      Initialize=-1, CanChange=True
}

// =============================================================================
// CREATE DOCUMENT AND RENDER INTO WINDOW
// =============================================================================


Function.App_CreateDocWindow {
    Output: Integer
    Body: {
        // Create a window
        win_w = 620
        win_h = 500
        win_idx = Win_Create(win_w, win_h, WinColor.WINDOW, "Notepad")
        IfCondition LessThan(win_idx, 0) ThenBlock: {
            PrintMessage("[App] Win_Create failed\n")
            ReturnValue(-1)
        }
        AppState.win_idx = win_idx
        
        Win_CreateToolbarDefault(win_idx)
        
        WinMgr_SetTB(win_idx, -1)
        // Get the content surface
        content = WinMgr_GetContent(win_idx)
        IfCondition LessEqual(content, 0) ThenBlock: {
            PrintMessage("[App] no content surface\n")
            ReturnValue(-1)
        }

        // Create document — use LETTER as base (we replace the page anyway)
        doc = Doc_Create(PaperType.LETTER, PageOrient.PORTRAIT, 96)
        IfCondition LessThan(doc, 0) ThenBlock: {
            PrintMessage("[App] Doc_Create failed\n")
            ReturnValue(-1)
        }
        AppState.doc = doc

        // Destroy the auto-created page, make one that fits the window
        page0_auto = Doc_GetPage(doc, 0)
        IfCondition GreaterEqual(page0_auto, 0) ThenBlock: {
            PageSurface_Destroy(page0_auto)
        }

        // Create a free page sized to the window content area
        cw = Win_GetCanvasW(win_idx)
        ch = Win_GetCanvasH(win_idx)
        page = PageSurface_CreateFree(cw, ch, 96)
        IfCondition LessThan(page, 0) ThenBlock: {
            PrintMessage("[App] page create failed\n")
            ReturnValue(-1)
        }

        // Set margins for document area (16px padding)
        PageSurface_SetMarginsPixels(page, 16, 16, 16, 16)

        // Swap in our page (overwrite index 0 in page list)
        pages = Doc_Get(doc, DocField.PAGE_LIST)
        XArray.XSet(pages, 0, page)

        // Write content
        App_WriteContent(doc)

        // Blit page surface onto window content surface
        App_BlitPageToWindow(page, content, cw, ch)

        SysDisplayState.dirty = 1
        PrintMessage("[App] document window created\n")
        ReturnValue(win_idx)
    }
}



// =============================================================================
// RENDER DIRECTORY LISTING INTO A DOCUMENT WINDOW
// Queries files table for children of parent_id, renders as indented text
// =============================================================================

// Render one level of the tree into the document
// depth controls indentation (0 = root level)
Function.FileBrowser_RenderLevel {
    Input: doc: Integer
    Input: parent_id: Integer
    Input: depth: Integer
    Body: {
        conn = SysDisplay_GetDBConn()
        IfCondition EqualTo(conn, 0) ThenBlock: { ReturnValue(0) }

        // Build query — SELECT children of this parent
        // For root (parent_id = 0 means NULL parent), use special query
        r = 0
        IfCondition EqualTo(parent_id, 0) ThenBlock: {
            r = PG_Query(conn, "SELECT id, name, type, size FROM files WHERE parent_id IS NULL ORDER BY type DESC, name")
        } ElseBlock: {
            // Build "WHERE parent_id = N"
            q1 = "SELECT id, name, type, size FROM files WHERE parent_id = "
            id_str = NumberToString(parent_id)
            q2 = StringConcat(q1, id_str)
            q3 = StringConcat(q2, " ORDER BY type DESC, name")
            r = PG_Query(conn, q3)
            // Free built strings
            Deallocate(q2, 0)
            Deallocate(q3, 0)
        }

        IfCondition EqualTo(r, 0) ThenBlock: { ReturnValue(0) }

        rc = XArray.XSize(r)

        dir_clr = TVG_PackColor(60, 140, 220, 255)
        file_clr = TVG_PackColor(200, 200, 200, 255)
        size_clr = TVG_PackColor(120, 120, 120, 255)

        ri = 0
        WhileLoop LessThan(ri, rc) {
            row = XArray.XGet(r, ri)

            // Get fields
            v_id = HashMap.HGetSimple(row, "id")
            v_name = HashMap.HGetSimple(row, "name")
            v_type = HashMap.HGetSimple(row, "type")
            v_size = HashMap.HGetSimple(row, "size")

            // Build indentation string
            indent = ""
            di = 0
            WhileLoop LessThan(di, depth) {
                indent = StringConcat(indent, "  ")
                di = Add(di, 1)
            }

            // Build display line based on type
            is_dir = 0
            IfCondition NotEqual(v_type, 0) ThenBlock: {
                cmp = StringCompare(v_type, "dir")
                IfCondition EqualTo(cmp, 0) ThenBlock: {
                    is_dir = 1
                }
            }

            line = ""
            line_clr = file_clr

            IfCondition EqualTo(is_dir, 1) ThenBlock: {
                // Directory: "  > dirname/"
                p1 = StringConcat(indent, "> ")
                p2 = StringConcat(p1, v_name)
                line = StringConcat(p2, "/")
                Deallocate(p1, 0)
                Deallocate(p2, 0)
                line_clr = dir_clr
            } ElseBlock: {
                // File: "  filename  (size)"
                p1 = StringConcat(indent, "  ")
                line = StringConcat(p1, v_name)
                Deallocate(p1, 0)

                // Append size if available
                IfCondition NotEqual(v_size, 0) ThenBlock: {
                    p3 = StringConcat(line, "  (")
                    p4 = StringConcat(p3, v_size)
                    p5 = StringConcat(p4, " bytes)")
                    Deallocate(line, 0)
                    Deallocate(p3, 0)
                    Deallocate(p4, 0)
                    line = p5
                    line_clr = size_clr
                }
            }

            // Render the line
            line_len = StringLength(line)
            Doc_WriteText(doc, line, line_len, line_clr)

            // If directory and depth < 3, recurse into children
            IfCondition EqualTo(is_dir, 1) ThenBlock: {
                IfCondition LessThan(depth, 3) ThenBlock: {
                    IfCondition NotEqual(v_id, 0) ThenBlock: {
                        // Parse the id string to integer
                        child_id = StringToNumber(v_id)
                        next_depth = Add(depth, 1)
                        FileBrowser_RenderLevel(doc, child_id, next_depth)
                    }
                }
            }

            // Cleanup built strings
            IfCondition NotEqual(indent, 0) ThenBlock: {
                il = StringLength(indent)
                IfCondition GreaterThan(il, 0) ThenBlock: {
                    Deallocate(indent, 0)
                }
            }
            Deallocate(line, 0)

            ri = Add(ri, 1)
        }

        PG_DestroyResult(r)
    }
}

// =============================================================================
// CREATE FILE BROWSER WINDOW
// =============================================================================
Function.App_CreateFileBrowser {
    Output: Integer
    Body: {
        conn = SysDisplay_GetDBConn()
        IfCondition EqualTo(conn, 0) ThenBlock: {
            PrintMessage("[FileBrowser] No database connection\n")
            ReturnValue(-1)
        }

        // Create window
        win_w = 500
        win_h = 450
        win_idx = Win_Create(win_w, win_h, WinColor.WINDOW, "Files")
        IfCondition LessThan(win_idx, 0) ThenBlock: {
            PrintMessage("[FileBrowser] Win_Create failed\n")
            ReturnValue(-1)
        }

        Win_CreateToolbarDefault(win_idx)
        WinMgr_SetTB(win_idx, -1)

        content = WinMgr_GetContent(win_idx)
        IfCondition LessEqual(content, 0) ThenBlock: {
            PrintMessage("[FileBrowser] no content surface\n")
            ReturnValue(-1)
        }

        // Create document
        doc = Doc_Create(PaperType.LETTER, PageOrient.PORTRAIT, 96)
        IfCondition LessThan(doc, 0) ThenBlock: {
            PrintMessage("[FileBrowser] Doc_Create failed\n")
            ReturnValue(-1)
        }

        // Replace auto page with window-sized page
        page0 = Doc_GetPage(doc, 0)
        IfCondition GreaterEqual(page0, 0) ThenBlock: {
            PageSurface_Destroy(page0)
        }

        cw = Win_GetCanvasW(win_idx)
        ch = Win_GetCanvasH(win_idx)
        page = PageSurface_CreateFree(cw, ch, 96)
        IfCondition LessThan(page, 0) ThenBlock: {
            PrintMessage("[FileBrowser] page create failed\n")
            ReturnValue(-1)
        }

        PageSurface_SetMarginsPixels(page, 12, 12, 12, 12)

        pages = Doc_Get(doc, DocField.PAGE_LIST)
        XArray.XSet(pages, 0, page)

        // Render title
        title_clr = TVG_PackColor(255, 255, 255, 255)
        hdr_clr = TVG_PackColor(0, 160, 220, 255)

        VFont_FlushCache()
        VFont_RasterAll(16)

        Doc_WriteText(doc, "File System Browser", 19, hdr_clr)
        Doc_WriteText(doc, "", 0, title_clr)

        // Render tree from root (parent_id NULL = 0)
        FileBrowser_RenderLevel(doc, 0, 0)

        // Separator + stats
        Doc_WriteText(doc, "", 0, title_clr)
        stat_clr = TVG_PackColor(100, 100, 100, 255)

        // Count total files
        r = PG_Query(conn, "SELECT COUNT(*) AS cnt FROM files")
        IfCondition NotEqual(r, 0) ThenBlock: {
            srow = XArray.XGet(r, 0)
            sv = HashMap.HGetSimple(srow, "cnt")
            IfCondition NotEqual(sv, 0) ThenBlock: {
                s1 = StringConcat("Total entries: ", sv)
                s1_len = StringLength(s1)
                Doc_WriteText(doc, s1, s1_len, stat_clr)
                Deallocate(s1, 0)
            }
            PG_DestroyResult(r)
        }

        // Source label
        Doc_WriteText(doc, "Source: PostgreSQL ailang_system", 31, stat_clr)

        VFont_FlushCache()
        VFont_RasterAll(18)

        // Blit to window
        App_BlitPageToWindow(page, content, cw, ch)

        SysDisplayState.dirty = 1
        PrintMessage("[FileBrowser] window created\n")
        ReturnValue(win_idx)
    }
}


// =============================================================================
// WRITE DOCUMENT CONTENT
// =============================================================================
Function.App_WriteContent {
    Input: doc: Integer
    Body: {
        title_clr = TVG_PackColor(0, 80, 180, 255)
        body_clr = TVG_PackColor(30, 30, 30, 255)
        bullet_clr = TVG_PackColor(80, 80, 80, 255)
        accent_clr = TVG_PackColor(0, 100, 60, 255)

        VFont_FlushCache()
        VFont_RasterAll(16)

        Doc_WriteText(doc, "AILANG Document System", 22, title_clr)
        Doc_WriteText(doc, "", 0, body_clr)
        Doc_WriteText(doc, "This is a live document rendered inside a", 41, body_clr)
        Doc_WriteText(doc, "window on the AILANG display server.", 35, body_clr)
        Doc_WriteText(doc, "", 0, body_clr)
        Doc_WriteText(doc, "  - HTML markup parsed to AST", 29, bullet_clr)
        Doc_WriteText(doc, "  - Auckland binds AST to layout tree", 37, bullet_clr)
        Doc_WriteText(doc, "  - PageSurface creates the canvas", 34, bullet_clr)
        Doc_WriteText(doc, "  - Document manages pages and cursor", 37, bullet_clr)
        Doc_WriteText(doc, "  - TextRegion renders vector text", 34, bullet_clr)
        Doc_WriteText(doc, "", 0, body_clr)
        Doc_WriteText(doc, "All vectors. All scalable.", 26, accent_clr)

        AppState.line_count = 11

        VFont_FlushCache()
        VFont_RasterAll(18)
    }
}

// =============================================================================
// BLIT PAGE SURFACE INTO WINDOW CONTENT
// =============================================================================
Function.App_BlitPageToWindow {
    Input: page: Integer
    Input: dst_surf: Integer
    Input: dst_w: Integer
    Input: dst_h: Integer
    Body: {
        src_surf = PageSurface_GetSurface(page)
        IfCondition EqualTo(src_surf, 0) ThenBlock: { ReturnValue(0) }

        src_w = PageSurface_GetWidth(page)
        src_h = PageSurface_GetHeight(page)

        blit_w = src_w
        IfCondition GreaterThan(blit_w, dst_w) ThenBlock: { blit_w = dst_w }
        blit_h = src_h
        IfCondition GreaterThan(blit_h, dst_h) ThenBlock: { blit_h = dst_h }

        src_data = Surface_GetData(src_surf)
        src_pitch = Surface_GetPitch(src_surf)
        dst_data = Surface_GetData(dst_surf)
        dst_pitch = Surface_GetPitch(dst_surf)
        row_bytes = Multiply(blit_w, 4)

        by = 0
        WhileLoop LessThan(by, blit_h) {
            src_row = Add(src_data, Multiply(by, src_pitch))
            dst_row = Add(dst_data, Multiply(by, dst_pitch))
            bx = 0
            WhileLoop LessThan(bx, row_bytes) {
                SetByte(dst_row, bx, GetByte(src_row, bx))
                bx = Add(bx, 1)
            }
            by = Add(by, 1)
        }
    }
}

// =============================================================================
// ADD LINE — called by "Add Text" button
// =============================================================================
Function.App_AddLine {
    Output: Integer
    Body: {
        IfCondition LessThan(AppState.doc, 0) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(AppState.win_idx, 0) ThenBlock: { ReturnValue(0) }

        AppState.line_count = Add(AppState.line_count, 1)
        lnum = AppState.line_count

        prefix = "Line "
        num_str = NumberToString(lnum)
        suffix = ": Added live!"
        part1 = StringConcat(prefix, num_str)
        full_line = StringConcat(part1, suffix)
        full_len = StringLength(full_line)

        green = TVG_PackColor(0, 120, 40, 255)
        VFont_FlushCache()
        VFont_RasterAll(16)
        Doc_WriteText(AppState.doc, full_line, full_len, green)
        VFont_FlushCache()
        VFont_RasterAll(18)

        // Re-blit page to window
        page = Doc_GetPage(AppState.doc, 0)
        content = WinMgr_GetContent(AppState.win_idx)
        cw = Win_GetCanvasW(AppState.win_idx)
        ch = Win_GetCanvasH(AppState.win_idx)
        App_BlitPageToWindow(page, content, cw, ch)

        SysDisplayState.dirty = 1
        PrintMessage("[App] added line ")
        PrintNumber(lnum)
        PrintMessage("\n")
        ReturnValue(1)
    }
}


// =============================================================================
// MAIN
// =============================================================================
SubRoutine.Main {
    Arena_Init()
    SysDisplay_Init()

    PrintMessage("[ENTRY] Building Auckland taskbar from markup\n")

    AK_Init()
    AKEvent_Init()
    AKSlot_Init()
    EventRouter_Init()
    Dialog_Init()
    Menu_Init()
    Deskbar_Init(SysDisplayState.scr_w, SysDisplayState.scr_h)
    HTML_Init()
    PageSurface_Init()
    Doc_Init()
    VFont_RasterAll(18)

    fb_w = SysDisplayState.scr_w
    fb_h = SysDisplayState.scr_h
    d_surf = SysDisplayState.desktop_surf

    AKTree.design_w = fb_w
    AKTree.design_h = fb_h
    AKTree.canvas = d_surf

    // Register action callback
     AKEvent.action_callback = AddressOf(EventRouter_ActionCallback)
    
    // Create initial document window
    VFont_FlushCache()
    VFont_RasterAll(16)
    App_CreateDocWindow()

// App_CreateFileBrowser()



    VFont_FlushCache()
    VFont_RasterAll(18)
    Win_BlitAll()

    // Enter main loop
     SysDisplay_Run()
    SysDisplay_Shutdown()
}

RunTask(Main)