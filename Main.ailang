// =============================================================================
// MAIN
// =============================================================================
SubRoutine.Main {
    Arena_Init()
    SysDisplay_Init()

    PrintMessage("[ENTRY] Initializing display server\n")

    KeyMap_Init()
    TextBuf_Init()
    ClipHistory_Init()
    SynColor_Init()
    SynColor_ThemeInit()
    EventRouter_Init()
    Dialog_Init()
    Menu_Init()
    Deskbar_Init(SysDisplayState.scr_w, SysDisplayState.scr_h)
    IPCBroker_Init()
    StartMenu_Init()
    CascadeMenu_Init()
    ContextMenu_Init()
    TelegramApp_Init()
    HTML_Init()
    PageSurface_Init()
    Doc_Init()
    VFont_UseSize(UIScale.font_body)

    Win_BlitAll()

    // Enter main loop — apps launched from deskbar / start menu
    SysDisplay_Run()
    SysDisplay_Shutdown()
}

RunTask(Main)
