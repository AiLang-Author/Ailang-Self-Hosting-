// MediaCenter.ailang
// System media service — hardware-authoritative clock + node graph engine.
// Owns ALSA, owns the master clock, owns the node graph, owns all pipelines.
//
// Clock architecture:
//   The ALSA period completion is the master tick. Audio_WriteFrames() blocks
//   until the hardware DMA completes a period. When it returns, we know
//   exactly how many samples the hardware has consumed. This IRQ-driven event
//   is the only clock source for scheduling. No nanosleep, no guessing.
//
// IPC socket: /tmp/ailang_media.sock
// Protocol: 4-byte BE length prefix + JSON (same as display server)
//
// Simple mode (video player, browser):
//   media.open      { file, canvas_tag, mixer_bus } → { pipeline_id }
//   media.play      { pipeline_id }
//   media.pause     { pipeline_id }
//   media.stop      { pipeline_id }
//
// Advanced mode (DAW, NLE):
//   media.node.create   { type, codec_id }          → { node_id }
//   media.node.connect  { src, src_port, dst, dst_port } → { edge_id }
//   media.node.start    { node_id, worker, session_id }
//   media.node.stop     { node_id }
//
// Shared:
//   media.create    { codec, stream, canvas_tag, mixer_bus } → { session_id }
//   media.pause     { session_id }
//   media.resume    { session_id }
//   media.stop      { session_id }
//   media.vol       { bus, vol }          (0=app 1=sys 2=master, 0-1024)
//   media.mixer.vol { slot, vol }         (per-input slot volume)
//   media.clock     {}                    → { hw_ns, wall_ns, drift_ns }
//
// Copyright 2026 Sean Collins, 2 Paws Machine and Engineering. SCSL.

LibraryImport.Arena
LibraryImport.Socket
LibraryImport.JSON
LibraryImport.StringUtils
LibraryImport.Media.MediaClock
LibraryImport.Media.MediaSession
LibraryImport.Media.NodeGraph
LibraryImport.Media.MixerNode
LibraryImport.Display.Render.AudioEngine

// =============================================================================
// STATE
// =============================================================================
FixedPool.MCState {
    "running":        Initialize=1
    "sock":           Initialize=-1
    "samples_out":    Initialize=0
    "audio_active":   Initialize=0
}

// =============================================================================
// SEND RESPONSE
// =============================================================================
Function.MC_SendOK {
    Input: client_fd: Integer
    Input: session_id: Integer
    Body: {
        IfCondition GreaterEqual(session_id, 0) ThenBlock: {
            // Build { "ok": 1, "session_id": N }
            obj = JSON.NewObject()
            JSON.SetNumber(obj, "ok", 1)
            JSON.SetNumber(obj, "session_id", session_id)
            msg = JSON.SerializeObject(obj)
            Socket.SendMsg(client_fd, msg)
            JSON.Free(obj)
        } ElseBlock: {
            Socket.SendMsg(client_fd, "{\"ok\":1}")
        }
    }
}

Function.MC_SendErr {
    Input: client_fd: Integer
    Input: reason: Address
    Body: {
        obj = JSON.NewObject()
        JSON.SetNumber(obj, "ok", 0)
        JSON.SetString(obj, "error", reason)
        msg = JSON.SerializeObject(obj)
        Socket.SendMsg(client_fd, msg)
        JSON.Free(obj)
    }
}

// =============================================================================
// DISPATCH IPC MESSAGE
// =============================================================================
Function.MC_Dispatch {
    Input: client_fd: Integer
    Input: msg: Address
    Body: {
        parsed = ParseJSON(msg)
        IfCondition EqualTo(parsed, 0) ThenBlock: {
            MC_SendErr(client_fd, "bad json")
            ReturnValue(0)
        }

        obj    = JSON.AsObject(parsed)
        method = JSON.GetString(obj, "method")
        IfCondition EqualTo(method, 0) ThenBlock: {
            JSON.Free(parsed)
            MC_SendErr(client_fd, "no method")
            ReturnValue(0)
        }

        // media.create
        cmp = StringCompare(method, "media.create")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            codec      = JSON.GetNumber(obj, "codec")
            stream     = JSON.GetNumber(obj, "stream")
            bus        = JSON.GetNumber(obj, "mixer_bus")
            canvas_tag = JSON.GetString(obj, "canvas_tag")
            sid = MediaSession_Create(codec, stream, canvas_tag, bus)
            MC_SendOK(client_fd, sid)
            JSON.Free(parsed)
            ReturnValue(1)
        }

        // media.pause
        cmp = StringCompare(method, "media.pause")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            sid = JSON.GetNumber(obj, "session_id")
            MediaSession_Pause(sid)
            MC_SendOK(client_fd, -1)
            JSON.Free(parsed)
            ReturnValue(1)
        }

        // media.resume
        cmp = StringCompare(method, "media.resume")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            sid = JSON.GetNumber(obj, "session_id")
            MediaSession_Resume(sid)
            MC_SendOK(client_fd, -1)
            JSON.Free(parsed)
            ReturnValue(1)
        }

        // media.stop
        cmp = StringCompare(method, "media.stop")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            sid = JSON.GetNumber(obj, "session_id")
            MediaSession_Stop(sid)
            MC_SendOK(client_fd, -1)
            JSON.Free(parsed)
            ReturnValue(1)
        }

        // media.vol
        cmp = StringCompare(method, "media.vol")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            bus = JSON.GetNumber(obj, "bus")
            vol = JSON.GetNumber(obj, "vol")
            IfCondition EqualTo(bus, 0) ThenBlock: { Mixer_SetAppVol(vol) }
            IfCondition EqualTo(bus, 1) ThenBlock: { Mixer_SysWrite(vol, 0) }
            IfCondition EqualTo(bus, 2) ThenBlock: { Mixer_SetMasterVol(vol) }
            MC_SendOK(client_fd, -1)
            JSON.Free(parsed)
            ReturnValue(1)
        }

        // media.clock — return clock state (hardware-authoritative)
        cmp = StringCompare(method, "media.clock")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            hw_ns    = MediaClock_HWTimeNS()
            wall_ns  = MediaClock_NowNS()
            drift_ns = MediaClock_DriftNS()
            resp = JSON.NewObject()
            JSON.SetNumber(resp, "hw_ns",    hw_ns)
            JSON.SetNumber(resp, "wall_ns",  wall_ns)
            JSON.SetNumber(resp, "drift_ns", drift_ns)
            JSON.SetNumber(resp, "samples_out", MCState.samples_out)
            rmsg = JSON.SerializeObject(resp)
            Socket.SendMsg(client_fd, rmsg)
            JSON.Free(resp)
            JSON.Free(parsed)
            ReturnValue(1)
        }

        // media.mixer.vol — per-input slot volume on the N-input mixer
        cmp = StringCompare(method, "media.mixer.vol")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            slot = JSON.GetNumber(obj, "slot")
            vol  = JSON.GetNumber(obj, "vol")
            MixerNode_SetInputVol(slot, vol)
            MC_SendOK(client_fd, -1)
            JSON.Free(parsed)
            ReturnValue(1)
        }

        // media.node.create — create a node in the graph
        cmp = StringCompare(method, "media.node.create")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            ntype = JSON.GetNumber(obj, "type")
            nid   = NodeGraph_CreateNode(ntype)
            resp  = JSON.NewObject()
            JSON.SetNumber(resp, "ok", 1)
            JSON.SetNumber(resp, "node_id", nid)
            rmsg = JSON.SerializeObject(resp)
            Socket.SendMsg(client_fd, rmsg)
            JSON.Free(resp)
            JSON.Free(parsed)
            ReturnValue(1)
        }

        // media.node.connect — wire two nodes
        cmp = StringCompare(method, "media.node.connect")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            src      = JSON.GetNumber(obj, "src")
            src_port = JSON.GetNumber(obj, "src_port")
            dst      = JSON.GetNumber(obj, "dst")
            dst_port = JSON.GetNumber(obj, "dst_port")
            ring     = JSON.GetNumber(obj, "ring_ptr")
            eid = NodeGraph_Connect(src, src_port, dst, dst_port, ring)
            resp = JSON.NewObject()
            JSON.SetNumber(resp, "ok", 1)
            JSON.SetNumber(resp, "edge_id", eid)
            rmsg = JSON.SerializeObject(resp)
            Socket.SendMsg(client_fd, rmsg)
            JSON.Free(resp)
            JSON.Free(parsed)
            ReturnValue(1)
        }

        // media.node.start — start a node's worker process
        cmp = StringCompare(method, "media.node.start")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            nid    = JSON.GetNumber(obj, "node_id")
            worker = JSON.GetString(obj, "worker")
            sid    = JSON.GetNumber(obj, "session_id")
            extra  = JSON.GetString(obj, "extra_arg")
            NodeGraph_StartNode(nid, worker, sid, extra)
            MC_SendOK(client_fd, -1)
            JSON.Free(parsed)
            ReturnValue(1)
        }

        // media.node.stop — stop a node
        cmp = StringCompare(method, "media.node.stop")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            nid = JSON.GetNumber(obj, "node_id")
            NodeGraph_StopNode(nid)
            MC_SendOK(client_fd, -1)
            JSON.Free(parsed)
            ReturnValue(1)
        }

        // media.pipe.stop — stop an entire pipeline
        cmp = StringCompare(method, "media.pipe.stop")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            pid = JSON.GetNumber(obj, "pipeline_id")
            NodeGraph_StopPipeline(pid)
            MC_SendOK(client_fd, -1)
            JSON.Free(parsed)
            ReturnValue(1)
        }

        // media.pipe.pause
        cmp = StringCompare(method, "media.pipe.pause")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            pid = JSON.GetNumber(obj, "pipeline_id")
            NodeGraph_PausePipeline(pid)
            MC_SendOK(client_fd, -1)
            JSON.Free(parsed)
            ReturnValue(1)
        }

        // media.pipe.resume
        cmp = StringCompare(method, "media.pipe.resume")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            pid = JSON.GetNumber(obj, "pipeline_id")
            NodeGraph_ResumePipeline(pid)
            MC_SendOK(client_fd, -1)
            JSON.Free(parsed)
            ReturnValue(1)
        }

        // media.pipe.destroy
        cmp = StringCompare(method, "media.pipe.destroy")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            pid = JSON.GetNumber(obj, "pipeline_id")
            NodeGraph_DestroyPipeline(pid)
            MC_SendOK(client_fd, -1)
            JSON.Free(parsed)
            ReturnValue(1)
        }

        // media.quit
        cmp = StringCompare(method, "media.quit")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            MC_SendOK(client_fd, -1)
            MCState.running = 0
            JSON.Free(parsed)
            ReturnValue(1)
        }

        JSON.Free(parsed)
        MC_SendErr(client_fd, "unknown method")
        ReturnValue(0)
    }
}

// =============================================================================
// CLIENT POLL — non-blocking accept + recv on all connected clients
// =============================================================================
Function.MC_PollClients {
    Input: sock:       Integer
    Input: clients:    Address
    Input: client_cnt: Address
    Body: {
        cnt = Dereference(client_cnt)

        // Accept new connections (non-blocking)
        IfCondition LessThan(cnt, 8) ThenBlock: {
            new_fd = Socket.Accept(sock)
            IfCondition GreaterEqual(new_fd, 0) ThenBlock: {
                Socket.SetNonBlock(new_fd)
                StoreValue(Add(clients, Multiply(cnt, 8)), new_fd)
                StoreValue(client_cnt, Add(cnt, 1))
                PrintMessage("[MC] Client connected fd=")
                PrintNumber(new_fd)
                PrintMessage("\n")
            }
        }

        // Poll all connected clients for messages
        cnt = Dereference(client_cnt)
        i = 0
        WhileLoop LessThan(i, cnt) {
            fd = Dereference(Add(clients, Multiply(i, 8)))
            IfCondition GreaterEqual(fd, 0) ThenBlock: {
                msg = Socket.RecvMsg(fd)
                IfCondition NotEqual(msg, 0) ThenBlock: {
                    MC_Dispatch(fd, msg)
                }
            }
            i = Add(i, 1)
        }
    }
}

// =============================================================================
// MAIN
// =============================================================================
SubRoutine.Main {
    Arena_Init()

    PrintMessage("============================================\n")
    PrintMessage("  MediaCenter — HW Clock + Node Graph Engine\n")
    PrintMessage("============================================\n\n")

    // Master clock — first thing, everything derives from this
    MediaClock_Init()

    // Session table (legacy — kept for backward compat)
    MediaSession_Init()

    // Node graph — the new pipeline architecture
    NodeGraph_Init()

    // Audio engine — MediaCenter owns ALSA
    ar = Audio_Init()
    IfCondition LessThan(ar, 0) ThenBlock: {
        PrintMessage("[MC] Audio init failed — continuing without audio\n")
        MCState.audio_active = 0
    } ElseBlock: {
        MCState.audio_active = 1
        PrintMessage("[MC] Audio engine ready\n")
    }

    // N-input mixer node — replaces flat 3-bus mixer for graph pipelines
    IfCondition EqualTo(MCState.audio_active, 1) ThenBlock: {
        MixerNode_Init()
        PrintMessage("[MC] MixerNode ready\n")
    }

    // IPC socket
    sock_path = "/tmp/ailang_media.sock"
    sock = Socket.Create(1, 1)
    IfCondition LessThan(sock, 0) ThenBlock: {
        PrintMessage("[MC] Socket create failed\n")
        HaltProgram
    }

    br = Socket.BindUnix(sock, sock_path)
    IfCondition LessThan(br, 0) ThenBlock: {
        PrintMessage("[MC] Bind failed — is MediaCenter already running?\n")
        Socket.Close(sock)
        HaltProgram
    }

    Socket.Listen(sock, 8)
    Socket.SetNonBlock(sock)
    MCState.sock = sock

    PrintMessage("[MC] Listening on /tmp/ailang_media.sock\n")

    // Client table — up to 8 connected clients
    clients    = Allocate(64)
    client_cnt = Allocate(8)
    StoreValue(client_cnt, 0)
    MemorySet(clients, 0, 64)

    // Silence buffer — fed to ALSA when no audio is being mixed
    period = AudioState.period_size
    silence_sz = Multiply(Multiply(period, AudioState.channels), 2)
    silence = Allocate(silence_sz)
    MemorySet(silence, 0, silence_sz)

    MCState.samples_out = 0

    // =========================================================================
    // MAIN LOOP — HARDWARE-AUTHORITATIVE TICK
    //
    // The ALSA period write is the tick. Audio_WriteFrames() blocks until the
    // hardware DMA completes the previous period. When the ioctl returns, the
    // hardware has consumed exactly period_size samples — this is an IRQ-driven
    // event, not a poll. The audio crystal oscillator drives the entire system.
    //
    // Flow per tick:
    //   1. MixerNode_Tick() reads decoded frames from all input rings, mixes
    //      them, and calls Audio_WriteFrames() which BLOCKS on hardware.
    //      If no audio data available, write silence to keep the clock ticking.
    //   2. When Audio_WriteFrames returns: samples_out += period_size
    //   3. Update MediaClock: hw_ns = samples_out * 1e9 / 48000
    //   4. Tick node graph: drain presenters whose frames are due
    //   5. Tick legacy sessions (backward compat)
    //   6. Poll IPC clients (non-blocking)
    // =========================================================================
    PrintMessage("[MC] Entering main loop (ALSA-blocked tick, period=")
    PrintNumber(period)
    PrintMessage(" frames)\n\n")

    WhileLoop EqualTo(MCState.running, 1) {

        // ===== 1. MIX + WRITE TO ALSA (this blocks — the hardware tick) =====
        IfCondition EqualTo(MCState.audio_active, 1) ThenBlock: {
            wrote = MixerNode_Tick(MediaClock_HWTimeNS())
            IfCondition LessEqual(wrote, 0) ThenBlock: {
                // No audio data — write silence to keep clock ticking
                wrote = Audio_WriteFrames(silence, period)
            }

            // ===== 2. ADVANCE HARDWARE CLOCK =====
            IfCondition GreaterThan(wrote, 0) ThenBlock: {
                MCState.samples_out = Add(MCState.samples_out, wrote)
                MediaClock_SetSamplesOut(MCState.samples_out)
            }
        }

        // ===== 3. GET AUTHORITATIVE TIME =====
        hw_ns = MediaClock_HWTimeNS()

        // ===== 4. TICK NODE GRAPH =====
        NodeGraph_Tick(hw_ns)

        // ===== 5. LEGACY SESSION TICK (backward compat) =====
        // Also sync old mixer's samples_written to clock
        MediaClock_SetSamplesOut(MCState.samples_out)
        i = 0
        WhileLoop LessThan(i, MSConst.MAX_SESSIONS) {
            entry = MediaSession_EntryPtr(i)
            state = Dereference(Add(entry, MSOff.STATE))
            IfCondition EqualTo(state, MSConst.STATE_ACTIVE) ThenBlock: {
                MediaSession_Tick(i, hw_ns)
            }
            i = Add(i, 1)
        }

        // ===== 6. POLL IPC (non-blocking) =====
        MC_PollClients(sock, clients, client_cnt)
    }

    PrintMessage("[MC] Shutting down\n")
    NodeGraph_Shutdown()
    MixerNode_Shutdown()
    MediaSession_Shutdown()
    Audio_Shutdown()
    MediaClock_Shutdown()
    Socket.Close(sock)
    Deallocate(silence, silence_sz)
    Deallocate(clients, 64)
    Deallocate(client_cnt, 8)

    PrintMessage("[MC] Done\n")
}

RunTask(Main)
