// MediaCenter.ailang
// System media service — the wall clock and sync generator.
// Owns ALSA, owns the master clock, owns all codec sessions.
//
// IPC socket: /tmp/ailang_media.sock
// Protocol: 4-byte BE length prefix + JSON (same as display server)
//
// Methods (client → MediaCenter):
//   media.create    { codec, stream, canvas_tag, mixer_bus }
//                   → { session_id }
//   media.packet    { session_id, pts, dts, flags, data_b64 }
//                   → { ok }
//   media.pause     { session_id }
//   media.resume    { session_id }
//   media.stop      { session_id }
//   media.vol       { bus, vol }          (0=app 1=sys 2=master, 0-1024)
//   media.clock     {}                    → { now_ns, audio_ns, drift_ns }
//
// Copyright 2026 Sean Collins, 2 Paws Machine and Engineering. SCSL.

LibraryImport.Arena
LibraryImport.Socket
LibraryImport.JSON
LibraryImport.StringUtils
LibraryImport.Media.MediaClock
LibraryImport.Media.MediaSession
LibraryImport.Display.Render.AudioEngine

// =============================================================================
// STATE
// =============================================================================
FixedPool.MCState {
    "running":      Initialize=1
    "sock":         Initialize=-1
    "tick_ns":      Initialize=2000000
}

FixedPool.MCSys {
    "SYS_NANOSLEEP": Initialize=35
}

// =============================================================================
// SEND RESPONSE
// =============================================================================
Function.MC_SendOK {
    Input: client_fd: Integer
    Input: session_id: Integer
    Body: {
        IfCondition GreaterEqual(session_id, 0) ThenBlock: {
            // Build { "ok": 1, "session_id": N }
            obj = JSON.NewObject()
            JSON.SetNumber(obj, "ok", 1)
            JSON.SetNumber(obj, "session_id", session_id)
            msg = JSON.SerializeObject(obj)
            Socket.SendMsg(client_fd, msg)
            JSON.Free(obj)
        } ElseBlock: {
            Socket.SendMsg(client_fd, "{\"ok\":1}")
        }
    }
}

Function.MC_SendErr {
    Input: client_fd: Integer
    Input: reason: Address
    Body: {
        obj = JSON.NewObject()
        JSON.SetNumber(obj, "ok", 0)
        JSON.SetString(obj, "error", reason)
        msg = JSON.SerializeObject(obj)
        Socket.SendMsg(client_fd, msg)
        JSON.Free(obj)
    }
}

// =============================================================================
// DISPATCH IPC MESSAGE
// =============================================================================
Function.MC_Dispatch {
    Input: client_fd: Integer
    Input: msg: Address
    Body: {
        parsed = ParseJSON(msg)
        IfCondition EqualTo(parsed, 0) ThenBlock: {
            MC_SendErr(client_fd, "bad json")
            ReturnValue(0)
        }

        obj    = JSON.AsObject(parsed)
        method = JSON.GetString(obj, "method")
        IfCondition EqualTo(method, 0) ThenBlock: {
            JSON.Free(parsed)
            MC_SendErr(client_fd, "no method")
            ReturnValue(0)
        }

        // media.create
        cmp = StringCompare(method, "media.create")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            codec      = JSON.GetNumber(obj, "codec")
            stream     = JSON.GetNumber(obj, "stream")
            bus        = JSON.GetNumber(obj, "mixer_bus")
            canvas_tag = JSON.GetString(obj, "canvas_tag")
            sid = MediaSession_Create(codec, stream, canvas_tag, bus)
            MC_SendOK(client_fd, sid)
            JSON.Free(parsed)
            ReturnValue(1)
        }

        // media.pause
        cmp = StringCompare(method, "media.pause")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            sid = JSON.GetNumber(obj, "session_id")
            MediaSession_Pause(sid)
            MC_SendOK(client_fd, -1)
            JSON.Free(parsed)
            ReturnValue(1)
        }

        // media.resume
        cmp = StringCompare(method, "media.resume")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            sid = JSON.GetNumber(obj, "session_id")
            MediaSession_Resume(sid)
            MC_SendOK(client_fd, -1)
            JSON.Free(parsed)
            ReturnValue(1)
        }

        // media.stop
        cmp = StringCompare(method, "media.stop")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            sid = JSON.GetNumber(obj, "session_id")
            MediaSession_Stop(sid)
            MC_SendOK(client_fd, -1)
            JSON.Free(parsed)
            ReturnValue(1)
        }

        // media.vol
        cmp = StringCompare(method, "media.vol")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            bus = JSON.GetNumber(obj, "bus")
            vol = JSON.GetNumber(obj, "vol")
            IfCondition EqualTo(bus, 0) ThenBlock: { Mixer_SetAppVol(vol) }
            IfCondition EqualTo(bus, 1) ThenBlock: { Mixer_SysWrite(vol, 0) }
            IfCondition EqualTo(bus, 2) ThenBlock: { Mixer_SetMasterVol(vol) }
            MC_SendOK(client_fd, -1)
            JSON.Free(parsed)
            ReturnValue(1)
        }

        // media.clock — return clock state for diagnostics
        cmp = StringCompare(method, "media.clock")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            now_ns   = MediaClock_NowNS()
            audio_ns = MediaClock_AudioNS()
            drift_ns = MediaClock_DriftNS()
            resp = JSON.NewObject()
            JSON.SetNumber(resp, "now_ns",   now_ns)
            JSON.SetNumber(resp, "audio_ns", audio_ns)
            JSON.SetNumber(resp, "drift_ns", drift_ns)
            rmsg = JSON.SerializeObject(resp)
            Socket.SendMsg(client_fd, rmsg)
            JSON.Free(resp)
            JSON.Free(parsed)
            ReturnValue(1)
        }

        // media.quit
        cmp = StringCompare(method, "media.quit")
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            MC_SendOK(client_fd, -1)
            MCState.running = 0
            JSON.Free(parsed)
            ReturnValue(1)
        }

        JSON.Free(parsed)
        MC_SendErr(client_fd, "unknown method")
        ReturnValue(0)
    }
}

// =============================================================================
// MAIN
// =============================================================================
SubRoutine.Main {
    Arena_Init()

    PrintMessage("============================================\n")
    PrintMessage("  MediaCenter — Wall Clock + Sync Generator\n")
    PrintMessage("============================================\n\n")

    // Master clock — first thing, everything derives from this
    MediaClock_Init()

    // Session table
    MediaSession_Init()

    // Audio engine — MediaCenter owns ALSA
    ar = Audio_Init()
    IfCondition LessThan(ar, 0) ThenBlock: {
        PrintMessage("[MC] Audio init failed — continuing without audio\n")
    } ElseBlock: {
        PrintMessage("[MC] Audio engine ready\n")
    }

    // IPC socket
    sock_path = "/tmp/ailang_media.sock"
    sock = Socket.Create(1, 1)
    IfCondition LessThan(sock, 0) ThenBlock: {
        PrintMessage("[MC] Socket create failed\n")
        HaltProgram
    }

    br = Socket.BindUnix(sock, sock_path)
    IfCondition LessThan(br, 0) ThenBlock: {
        PrintMessage("[MC] Bind failed — is MediaCenter already running?\n")
        Socket.Close(sock)
        HaltProgram
    }

    Socket.Listen(sock, 8)
    Socket.SetNonBlock(sock)
    MCState.sock = sock

    PrintMessage("[MC] Listening on /tmp/ailang_media.sock\n")
    PrintMessage("[MC] Entering main loop (2ms tick)\n\n")

    // Timespec for 2ms tick
    ts = Allocate(16)
    StoreValue(ts, 0)
    StoreValue(Add(ts, 8), MCState.tick_ns)

    // Simple client table — up to 8 connected clients
    clients     = Allocate(64)
    client_cnt  = 0
    MemorySet(clients, 0, 64)

    WhileLoop EqualTo(MCState.running, 1) {

        // ===== ACCEPT new connections =====
        IfCondition LessThan(client_cnt, 8) ThenBlock: {
            new_fd = Socket.Accept(sock)
            IfCondition GreaterEqual(new_fd, 0) ThenBlock: {
                Socket.SetNonBlock(new_fd)
                StoreValue(Add(clients, Multiply(client_cnt, 8)), new_fd)
                client_cnt = Add(client_cnt, 1)
                PrintMessage("[MC] Client connected fd=")
                PrintNumber(new_fd)
                PrintMessage("\n")
            }
        }

        // ===== POLL clients for messages =====
        i = 0
        WhileLoop LessThan(i, client_cnt) {
            fd = Dereference(Add(clients, Multiply(i, 8)))
            IfCondition GreaterEqual(fd, 0) ThenBlock: {
                msg = Socket.RecvMsg(fd)
                IfCondition NotEqual(msg, 0) ThenBlock: {
                    MC_Dispatch(fd, msg)
                }
            }
            i = Add(i, 1)
        }

        // ===== CLOCK TICK =====
        now_ns = MediaClock_NowNS()

        // Sync ALSA samples_out → clock
        MediaClock_SetSamplesOut(MixerState.samples_written)

        // Drain mixer → ALSA
        Mixer_DrainTick()

        // Tick all active sessions — drain ready frames
        i = 0
        WhileLoop LessThan(i, MSConst.MAX_SESSIONS) {
            entry = MediaSession_EntryPtr(i)
            state = Dereference(Add(entry, MSOff.STATE))
            IfCondition EqualTo(state, MSConst.STATE_ACTIVE) ThenBlock: {
                MediaSession_Tick(i, now_ns)
            }
            i = Add(i, 1)
        }

        SystemCall(MCSys.SYS_NANOSLEEP, ts, 0)
    }

    PrintMessage("[MC] Shutting down\n")
    MediaSession_Shutdown()
    Audio_Shutdown()
    MediaClock_Shutdown()
    Socket.Close(sock)
    Deallocate(ts, 16)
    Deallocate(clients, 64)

    PrintMessage("[MC] Done\n")
}

RunTask(Main)
