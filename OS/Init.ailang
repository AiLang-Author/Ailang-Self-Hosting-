// Init.ailang
// AILang OS PID 1 — the first process started by the Linux kernel.
// Responsibilities:
//   1. Mount essential filesystems (proc, sys, dev, tmp, dev/shm)
//   2. Create /data/blobs directory for UUID file store
//   3. Run login screen (framebuffer, blocks until authenticated)
//   4. Start PostgreSQL (fork/exec as postgres user)
//   5. Wait for PG to accept connections (poll TCP 5432)
//   6. Connect to PG and bootstrap schema
//   7. Start service daemon (fork/exec)
//   8. Watchdog loop — reap children, restart PG/svc daemon if they die
//
// Build: ./ailang.x OS/Init.ailang -o ailang_init.x
// Install: cp ailang_init.x /sbin/ailang_init
// Kernel cmdline: init=/sbin/ailang_init
//
// Copyright © 2025 Sean Collins, 2 Paws Machine and Engineering. All rights reserved. SCSL.

LibraryImport.Arena
LibraryImport.StringUtils
LibraryImport.Socket
LibraryImport.Hash
LibraryImport.Arrays
LibraryImport.PostgreSQL_Complete
LibraryImport.Display.Render.Framebuffer
LibraryImport.TermFont

Import.OS.Schema

// =============================================================================
// STUB: DebugLog_Push (needed by Framebuffer library, no-op here)
// =============================================================================
Function.DebugLog_Push {
    Input: tag: Address
    Input: len: Integer
    Body: {
        ReturnValue(0)
    }
}

// =============================================================================
// SYSCALL CONSTANTS
// =============================================================================
FixedPool.InitSys {
    "SYS_READ":      Initialize=0
    "SYS_WRITE":     Initialize=1
    "SYS_OPEN":      Initialize=2
    "SYS_CLOSE":     Initialize=3
    "SYS_NANOSLEEP": Initialize=35
    "SYS_SOCKET":    Initialize=41
    "SYS_CONNECT":   Initialize=42
    "SYS_FORK":      Initialize=57
    "SYS_EXECVE":    Initialize=59
    "SYS_EXIT":      Initialize=60
    "SYS_WAIT4":     Initialize=61
    "SYS_MKDIR":     Initialize=83
    "SYS_SETUID":    Initialize=105
    "SYS_SETGID":    Initialize=106
    "SYS_SETSID":    Initialize=112
    "SYS_MOUNT":     Initialize=165
    "SYS_SETHOSTNAME": Initialize=170
}

FixedPool.InitConst {
    "WNOHANG":       Initialize=1
    "AF_INET":       Initialize=2
    "SOCK_STREAM":   Initialize=1
    "DIR_MODE":      Initialize=493
    "PG_PORT":       Initialize=5432
    "PG_UID":        Initialize=121
    "PG_GID":        Initialize=124
    "MAX_PG_WAIT":   Initialize=60
}

// =============================================================================
// INIT STATE — tracks child PIDs
// =============================================================================
FixedPool.InitState {
    "pg_pid":      Initialize=0, CanChange=True
    "svc_pid":     Initialize=0, CanChange=True
    "sshd_pid":    Initialize=0, CanChange=True
    "pg_ready":    Initialize=0, CanChange=True
    "running":     Initialize=1, CanChange=True
}

// =============================================================================
// CONFIGURABLE PATHS — override for different environments
// =============================================================================
FixedPool.InitPaths {
    "pg_bin":      Initialize=0, CanChange=True
    "pg_data":     Initialize=0, CanChange=True
    "svc_bin":     Initialize=0, CanChange=True
    "blob_dir":    Initialize=0, CanChange=True
    "pg_host":     Initialize=0, CanChange=True
    "pg_dbname":   Initialize=0, CanChange=True
    "pg_user":     Initialize=0, CanChange=True
}

// =============================================================================
// BOOT CONFIG — parsed from /etc/ailang_boot.conf at boot
// Values are pointers to arena-allocated null-terminated strings
// =============================================================================
FixedPool.BootConfig {
    "hostname":     Initialize=0, CanChange=True
    "modules":      Initialize=0, CanChange=True
    "network":      Initialize=0, CanChange=True
    "network_ip":   Initialize=0, CanChange=True
    "network_mask": Initialize=0, CanChange=True
    "wifi_auto":    Initialize=0, CanChange=True
    "login":        Initialize=0, CanChange=True
    "loaded":       Initialize=0, CanChange=True
}

// Boot config constants
FixedPool.BootConst {
    "MAX_ENTRIES":    Initialize=16
    "KEY_LEN":        Initialize=32
    "VAL_LEN":        Initialize=128
    "ENTRY_SIZE":     Initialize=160
    "BUFFER_SIZE":    Initialize=2048
    "CONFIG_PATH":    Initialize=0, CanChange=True
}

// =============================================================================
// INIT PATHS — set defaults
// =============================================================================
Function.Init_SetDefaults {
    Body: {
        InitPaths.pg_bin   = "/usr/bin/postgres"
        InitPaths.pg_data  = "/var/lib/postgresql/data"
        InitPaths.svc_bin  = "/system/bin/svc_daemon.x"
        InitPaths.blob_dir = "/data/blobs"
        InitPaths.pg_host  = "127.0.0.1"
        InitPaths.pg_dbname = "ailang_system"
        InitPaths.pg_user  = "bob"

        // Boot config defaults (used if /etc/ailang_boot.conf missing)
        BootConfig.hostname   = "ailang-os"
        BootConfig.modules    = "auto"
        BootConfig.network    = "dhcp"
        BootConfig.network_ip = "10.0.0.2"
        BootConfig.network_mask = "255.255.255.0"
        BootConfig.wifi_auto  = "yes"
        BootConfig.login      = "yes"
        BootConfig.loaded     = 0
    }
}

// =============================================================================
// BOOT CONFIG PARSER — read /etc/ailang_boot.conf, key=value format
// Stores string values (not integers) into BootConfig fields
// =============================================================================
Function.Init_LoadBootConfig {
    Output: Integer
    Body: {
        conf_fd = SystemCall(InitSys.SYS_OPEN, "/etc/ailang_boot.conf", 0, 0, 0, 0)
        IfCondition LessThan(conf_fd, 0) ThenBlock: {
            PrintMessage("[INIT] No /etc/ailang_boot.conf — using defaults\n")
            ReturnValue(0)
        }

        buf = Allocate(BootConst.BUFFER_SIZE)
        bytes_read = SystemCall(InitSys.SYS_READ, conf_fd, buf, Subtract(BootConst.BUFFER_SIZE, 1), 0, 0)
        SystemCall(InitSys.SYS_CLOSE, conf_fd, 0, 0, 0, 0)

        IfCondition LessEqual(bytes_read, 0) ThenBlock: {
            PrintMessage("[INIT] Empty boot config\n")
            Deallocate(buf, BootConst.BUFFER_SIZE)
            ReturnValue(0)
        }
        SetByte(buf, bytes_read, 0)

        // Parse line by line
        key_buf = Allocate(BootConst.KEY_LEN)
        val_buf = Allocate(BootConst.VAL_LEN)
        line_start = 0
        pos = 0
        entries_parsed = 0

        WhileLoop LessEqual(pos, bytes_read) {
            ch = GetByte(buf, pos)
            IfCondition Or(EqualTo(ch, 10), EqualTo(ch, 0)) ThenBlock: {
                // Process line from line_start to pos
                lp = line_start
                // Skip leading whitespace
                WhileLoop And(LessThan(lp, pos), EqualTo(GetByte(buf, lp), 32)) { lp = Add(lp, 1) }
                // Skip comment and empty lines
                skip_line = 0
                IfCondition GreaterEqual(lp, pos) ThenBlock: { skip_line = 1 }
                IfCondition EqualTo(skip_line, 0) ThenBlock: {
                    IfCondition EqualTo(GetByte(buf, lp), 35) ThenBlock: { skip_line = 1 }
                }
                IfCondition EqualTo(skip_line, 0) ThenBlock: {
                    // Find '=' separator (ASCII 61)
                    eq_pos = lp
                    WhileLoop And(LessThan(eq_pos, pos), NotEqual(GetByte(buf, eq_pos), 61)) {
                        eq_pos = Add(eq_pos, 1)
                    }
                    IfCondition LessThan(eq_pos, pos) ThenBlock: {
                        // Extract key
                        ki = 0
                        kp = lp
                        WhileLoop And(LessThan(kp, eq_pos), LessThan(ki, Subtract(BootConst.KEY_LEN, 1))) {
                            SetByte(key_buf, ki, GetByte(buf, kp))
                            ki = Add(ki, 1)
                            kp = Add(kp, 1)
                        }
                        // Trim trailing whitespace from key
                        WhileLoop And(GreaterThan(ki, 0), EqualTo(GetByte(key_buf, Subtract(ki, 1)), 32)) {
                            ki = Subtract(ki, 1)
                        }
                        SetByte(key_buf, ki, 0)

                        // Extract value (after '=')
                        vp = Add(eq_pos, 1)
                        // Skip leading whitespace
                        WhileLoop And(LessThan(vp, pos), EqualTo(GetByte(buf, vp), 32)) { vp = Add(vp, 1) }
                        vi = 0
                        WhileLoop And(LessThan(vp, pos), LessThan(vi, Subtract(BootConst.VAL_LEN, 1))) {
                            vc = GetByte(buf, vp)
                            IfCondition Or(EqualTo(vc, 10), EqualTo(vc, 13)) ThenBlock: { BreakLoop }
                            SetByte(val_buf, vi, vc)
                            vi = Add(vi, 1)
                            vp = Add(vp, 1)
                        }
                        // Trim trailing whitespace from value
                        WhileLoop And(GreaterThan(vi, 0), EqualTo(GetByte(val_buf, Subtract(vi, 1)), 32)) {
                            vi = Subtract(vi, 1)
                        }
                        SetByte(val_buf, vi, 0)

                        // Allocate persistent copy of value string
                        val_copy = Allocate(Add(vi, 1))
                        ci = 0
                        WhileLoop LessEqual(ci, vi) {
                            SetByte(val_copy, ci, GetByte(val_buf, ci))
                            ci = Add(ci, 1)
                        }

                        // Match key and store into BootConfig
                        Init_BootConfigSet(key_buf, val_copy)
                        entries_parsed = Add(entries_parsed, 1)
                    }
                }
                line_start = Add(pos, 1)
            }
            pos = Add(pos, 1)
        }

        Deallocate(key_buf, BootConst.KEY_LEN)
        Deallocate(val_buf, BootConst.VAL_LEN)
        Deallocate(buf, BootConst.BUFFER_SIZE)

        BootConfig.loaded = 1
        PrintMessage("[INIT] Boot config loaded: ")
        PrintNumber(entries_parsed)
        PrintMessage(" entries\n")
        ReturnValue(entries_parsed)
    }
}

// =============================================================================
// BOOT CONFIG SET — match key string to BootConfig field
// =============================================================================
Function.Init_BootConfigSet {
    Input: key: Address
    Input: val: Address
    Body: {
        // Compare key byte-by-byte against known keys
        // "hostname" = 104,111,115,116,110,97,109,101
        IfCondition And(EqualTo(GetByte(key, 0), 104), EqualTo(GetByte(key, 4), 110)) ThenBlock: {
            IfCondition EqualTo(GetByte(key, 8), 0) ThenBlock: {
                BootConfig.hostname = val
                ReturnValue(0)
            }
        }
        // "modules" = 109,111,100,117,108,101,115
        IfCondition And(EqualTo(GetByte(key, 0), 109), EqualTo(GetByte(key, 1), 111)) ThenBlock: {
            IfCondition EqualTo(GetByte(key, 7), 0) ThenBlock: {
                BootConfig.modules = val
                ReturnValue(0)
            }
        }
        // "network" = 110,101,116,119,111,114,107
        IfCondition And(EqualTo(GetByte(key, 0), 110), EqualTo(GetByte(key, 3), 119)) ThenBlock: {
            // "network_ip" vs "network_mask" vs "network"
            IfCondition EqualTo(GetByte(key, 7), 0) ThenBlock: {
                BootConfig.network = val
                ReturnValue(0)
            }
            // "network_ip" = ..._ip (byte 8 = 95 '_', byte 9 = 105 'i')
            IfCondition And(EqualTo(GetByte(key, 8), 105), EqualTo(GetByte(key, 10), 0)) ThenBlock: {
                BootConfig.network_ip = val
                ReturnValue(0)
            }
            // "network_mask" = ..._mask (byte 8 = 109 'm')
            IfCondition EqualTo(GetByte(key, 8), 109) ThenBlock: {
                BootConfig.network_mask = val
                ReturnValue(0)
            }
        }
        // "wifi_auto" = 119,105,102,105,95,97,117,116,111
        IfCondition And(EqualTo(GetByte(key, 0), 119), EqualTo(GetByte(key, 4), 95)) ThenBlock: {
            BootConfig.wifi_auto = val
            ReturnValue(0)
        }
        // "login" = 108,111,103,105,110
        IfCondition And(EqualTo(GetByte(key, 0), 108), EqualTo(GetByte(key, 4), 110)) ThenBlock: {
            BootConfig.login = val
            ReturnValue(0)
        }
    }
}

// =============================================================================
// BOOT CONFIG HELPERS — check string values
// =============================================================================
Function.Init_BootConfigIsYes {
    Input: val: Address
    Output: Integer
    Body: {
        // "yes" = 121,101,115
        IfCondition EqualTo(val, 0) ThenBlock: { ReturnValue(0) }
        IfCondition And(EqualTo(GetByte(val, 0), 121), EqualTo(GetByte(val, 1), 101)) ThenBlock: {
            IfCondition EqualTo(GetByte(val, 2), 115) ThenBlock: { ReturnValue(1) }
        }
        ReturnValue(0)
    }
}

Function.Init_BootConfigIsAuto {
    Input: val: Address
    Output: Integer
    Body: {
        // "auto" = 97,117,116,111
        IfCondition EqualTo(val, 0) ThenBlock: { ReturnValue(0) }
        IfCondition And(EqualTo(GetByte(val, 0), 97), EqualTo(GetByte(val, 3), 111)) ThenBlock: {
            IfCondition EqualTo(GetByte(val, 4), 0) ThenBlock: { ReturnValue(1) }
        }
        ReturnValue(0)
    }
}

// =============================================================================
// SET HOSTNAME — from boot config
// =============================================================================
Function.Init_SetHostname {
    Body: {
        hname = BootConfig.hostname
        IfCondition EqualTo(hname, 0) ThenBlock: { ReturnValue(0) }
        hlen = StringLength(hname)
        IfCondition EqualTo(hlen, 0) ThenBlock: { ReturnValue(0) }

        // Syscall 170: sethostname(name, len)
        hn_ret = SystemCall(InitSys.SYS_SETHOSTNAME, hname, hlen, 0, 0, 0)
        IfCondition LessThan(hn_ret, 0) ThenBlock: {
            PrintMessage("[INIT] sethostname failed: ")
            PrintNumber(hn_ret)
            PrintMessage("\n")
        }

        // Write /etc/hostname
        hn_fd = SystemCall(InitSys.SYS_OPEN, "/etc/hostname", 577, 420, 0, 0)
        IfCondition GreaterEqual(hn_fd, 0) ThenBlock: {
            SystemCall(InitSys.SYS_WRITE, hn_fd, hname, hlen, 0, 0)
            SystemCall(InitSys.SYS_WRITE, hn_fd, "\n", 1, 0, 0)
            SystemCall(InitSys.SYS_CLOSE, hn_fd, 0, 0, 0, 0)
        }

        PrintMessage("[INIT] Hostname: ")
        PrintMessage(hname)
        PrintMessage("\n")
    }
}

// =============================================================================
// LOAD MODULES — auto-detect via PCI modalias or load explicit list
// =============================================================================
Function.Init_LoadModules {
    Body: {
        mod_cfg = BootConfig.modules
        IfCondition EqualTo(mod_cfg, 0) ThenBlock: { ReturnValue(0) }

        // "none" = skip module loading entirely
        IfCondition And(EqualTo(GetByte(mod_cfg, 0), 110), EqualTo(GetByte(mod_cfg, 3), 101)) ThenBlock: {
            PrintMessage("[INIT] Module loading: disabled (modules=none)\n")
            ReturnValue(0)
        }

        // "auto" = scan PCI devices and modprobe each modalias
        is_auto = Init_BootConfigIsAuto(mod_cfg)
        IfCondition EqualTo(is_auto, 1) ThenBlock: {
            PrintMessage("[INIT] Module loading: auto-detect PCI devices\n")
            Init_LoadModulesAuto()
            ReturnValue(0)
        }

        // Explicit comma-separated list: "mt7921e,iwlmvm,snd_hda_intel"
        PrintMessage("[INIT] Module loading: explicit list\n")
        mod_name = Allocate(128)
        mi = 0
        si = 0
        WhileLoop 1 {
            ch = GetByte(mod_cfg, si)
            IfCondition Or(EqualTo(ch, 44), EqualTo(ch, 0)) ThenBlock: {
                // End of module name (comma or null terminator)
                IfCondition GreaterThan(mi, 0) ThenBlock: {
                    SetByte(mod_name, mi, 0)
                    PrintMessage("  modprobe ")
                    PrintMessage(mod_name)
                    PrintMessage("\n")
                    argv_m = Allocate(24)
                    StoreValue(Add(argv_m, 0), "/sbin/modprobe")
                    StoreValue(Add(argv_m, 8), mod_name)
                    StoreValue(Add(argv_m, 16), 0)
                    Init_RunCommand("/sbin/modprobe", argv_m)
                    Deallocate(argv_m, 24)
                    mi = 0
                }
                IfCondition EqualTo(ch, 0) ThenBlock: { BreakLoop }
            } ElseBlock: {
                IfCondition LessThan(mi, 126) ThenBlock: {
                    SetByte(mod_name, mi, ch)
                    mi = Add(mi, 1)
                }
            }
            si = Add(si, 1)
        }
        Deallocate(mod_name, 128)
    }
}

// =============================================================================
// AUTO-DETECT MODULES — scan /sys/bus/pci/devices/*/modalias, modprobe each
// =============================================================================
Function.Init_LoadModulesAuto {
    Body: {
        // SYS_GETDENTS64 = 217
        pci_dir = "/sys/bus/pci/devices"
        dir_fd = SystemCall(InitSys.SYS_OPEN, pci_dir, 0x10000, 0, 0, 0) // O_RDONLY|O_DIRECTORY
        IfCondition LessThan(dir_fd, 0) ThenBlock: {
            PrintMessage("[INIT] Cannot open /sys/bus/pci/devices\n")
            ReturnValue(0)
        }

        dents = Allocate(4096)
        modalias_path = Allocate(256)
        modalias_val = Allocate(512)
        mod_count = 0

        nread = SystemCall(217, dir_fd, dents, 4096, 0, 0)
        WhileLoop GreaterThan(nread, 0) {
            dpos = 0
            WhileLoop LessThan(dpos, nread) {
                // d_reclen at offset 16 (2 bytes)
                reclen = Add(GetByte(dents, Add(dpos, 16)), Multiply(GetByte(dents, Add(dpos, 17)), 256))
                // d_name at offset 19
                name_off = Add(dpos, 19)
                first_byte = GetByte(dents, name_off)

                // Skip . and .. (starts with '.' = 46)
                IfCondition NotEqual(first_byte, 46) ThenBlock: {
                    // Build path: /sys/bus/pci/devices/<name>/modalias
                    pi = 0
                    // Copy prefix
                    prefix = "/sys/bus/pci/devices/"
                    WhileLoop NotEqual(GetByte(prefix, pi), 0) {
                        SetByte(modalias_path, pi, GetByte(prefix, pi))
                        pi = Add(pi, 1)
                    }
                    // Copy device name
                    ni = 0
                    WhileLoop And(LessThan(ni, 32), NotEqual(GetByte(dents, Add(name_off, ni)), 0)) {
                        SetByte(modalias_path, Add(pi, ni), GetByte(dents, Add(name_off, ni)))
                        ni = Add(ni, 1)
                    }
                    // Append /modalias
                    suffix = "/modalias"
                    si2 = 0
                    WhileLoop NotEqual(GetByte(suffix, si2), 0) {
                        SetByte(modalias_path, Add(pi, Add(ni, si2)), GetByte(suffix, si2))
                        si2 = Add(si2, 1)
                    }
                    SetByte(modalias_path, Add(pi, Add(ni, si2)), 0)

                    // Read modalias value
                    ma_fd = SystemCall(InitSys.SYS_OPEN, modalias_path, 0, 0, 0, 0)
                    IfCondition GreaterEqual(ma_fd, 0) ThenBlock: {
                        ma_len = SystemCall(InitSys.SYS_READ, ma_fd, modalias_val, 511, 0, 0)
                        SystemCall(InitSys.SYS_CLOSE, ma_fd, 0, 0, 0, 0)
                        IfCondition GreaterThan(ma_len, 0) ThenBlock: {
                            // Strip trailing newline
                            IfCondition EqualTo(GetByte(modalias_val, Subtract(ma_len, 1)), 10) ThenBlock: {
                                ma_len = Subtract(ma_len, 1)
                            }
                            SetByte(modalias_val, ma_len, 0)

                            // modprobe <modalias>
                            argv_ma = Allocate(24)
                            StoreValue(Add(argv_ma, 0), "/sbin/modprobe")
                            StoreValue(Add(argv_ma, 8), modalias_val)
                            StoreValue(Add(argv_ma, 16), 0)
                            Init_RunCommand("/sbin/modprobe", argv_ma)
                            Deallocate(argv_ma, 24)
                            mod_count = Add(mod_count, 1)
                        }
                    }
                }

                dpos = Add(dpos, reclen)
            }
            nread = SystemCall(217, dir_fd, dents, 4096, 0, 0)
        }

        SystemCall(InitSys.SYS_CLOSE, dir_fd, 0, 0, 0, 0)
        Deallocate(dents, 4096)
        Deallocate(modalias_path, 256)
        Deallocate(modalias_val, 512)

        PrintMessage("[INIT] Auto-loaded modules for ")
        PrintNumber(mod_count)
        PrintMessage(" PCI devices\n")
    }
}

// =============================================================================
// WIFI AUTO-CONNECT — if config says yes and credentials exist
// =============================================================================
Function.Init_WiFiAutoConnect {
    Body: {
        wac = BootConfig.wifi_auto
        is_yes = Init_BootConfigIsYes(wac)
        IfCondition EqualTo(is_yes, 0) ThenBlock: {
            PrintMessage("[INIT] WiFi auto-connect: disabled\n")
            ReturnValue(0)
        }

        // Check if /etc/wpa_supplicant.conf exists
        wpa_fd = SystemCall(InitSys.SYS_OPEN, "/etc/wpa_supplicant.conf", 0, 0, 0, 0)
        IfCondition LessThan(wpa_fd, 0) ThenBlock: {
            PrintMessage("[INIT] WiFi auto-connect: no saved credentials\n")
            ReturnValue(0)
        }
        SystemCall(InitSys.SYS_CLOSE, wpa_fd, 0, 0, 0, 0)

        // Check if any wlan interface exists
        wlan_fd = SystemCall(InitSys.SYS_OPEN, "/sys/class/net/wlan0", 0, 0, 0, 0)
        IfCondition LessThan(wlan_fd, 0) ThenBlock: {
            PrintMessage("[INIT] WiFi auto-connect: no wlan0 interface\n")
            ReturnValue(0)
        }
        SystemCall(InitSys.SYS_CLOSE, wlan_fd, 0, 0, 0, 0)

        PrintMessage("[INIT] WiFi auto-connect: connecting...\n")
        Init_TryWiFiFallback()
    }
}

// =============================================================================
// VERIFY BOOT CONFIG — signature verification stub
// Returns 1 if config is trusted, 0 if tampered.
// Currently always returns 1. Will use ed25519 when crypto layer is ready.
// =============================================================================
Function.Init_VerifyBootConfig {
    Output: Integer
    Body: {
        // TODO: Read /etc/ailang_boot.conf.sig
        // TODO: Verify ed25519 signature against known public key
        // TODO: If verification fails, print warning and use defaults only
        ReturnValue(1)
    }
}

// =============================================================================
// MOUNT FILESYSTEM — wrapper around syscall 165
// mount(source, target, fstype, flags, data)
// =============================================================================
Function.Init_Mount {
    Input: source: Integer
    Input: target: Integer
    Input: fstype: Integer
    Input: flags:  Integer
    Body: {
        rc = SystemCall(InitSys.SYS_MOUNT, source, target, fstype, flags, 0)
        IfCondition LessThan(rc, 0) ThenBlock: {
            PrintMessage("[INIT] WARNING: mount failed for ")
            PrintString(target)
            PrintMessage("\n")
        } ElseBlock: {
            PrintMessage("[INIT] Mounted ")
            PrintString(target)
            PrintMessage("\n")
        }
    }
}

// =============================================================================
// MOUNT ESSENTIAL FILESYSTEMS
// =============================================================================
Function.Init_MountAll {
    Body: {
        PrintMessage("[INIT] Mounting essential filesystems...\n")

        // Create mount points (may already exist)
        SystemCall(InitSys.SYS_MKDIR, "/proc",    InitConst.DIR_MODE, 0, 0, 0)
        SystemCall(InitSys.SYS_MKDIR, "/sys",     InitConst.DIR_MODE, 0, 0, 0)
        SystemCall(InitSys.SYS_MKDIR, "/dev",     InitConst.DIR_MODE, 0, 0, 0)
        SystemCall(InitSys.SYS_MKDIR, "/tmp",     InitConst.DIR_MODE, 0, 0, 0)
        SystemCall(InitSys.SYS_MKDIR, "/dev/shm", InitConst.DIR_MODE, 0, 0, 0)
        SystemCall(InitSys.SYS_MKDIR, "/dev/pts", InitConst.DIR_MODE, 0, 0, 0)
        SystemCall(InitSys.SYS_MKDIR, "/run",     InitConst.DIR_MODE, 0, 0, 0)

        // Mount proc, sysfs, devtmpfs, tmpfs
        Init_Mount("proc",     "/proc",    "proc",     0)
        Init_Mount("sysfs",    "/sys",     "sysfs",    0)
        Init_Mount("devtmpfs", "/dev",     "devtmpfs", 0)
        Init_Mount("tmpfs",    "/tmp",     "tmpfs",    0)
        Init_Mount("tmpfs",    "/dev/shm", "tmpfs",    0)
        Init_Mount("devpts",   "/dev/pts", "devpts",   0)
        Init_Mount("tmpfs",    "/run",     "tmpfs",    0)

        // Create /dev/input for evdev device nodes (devtmpfs may not auto-create)
        SystemCall(InitSys.SYS_MKDIR, "/dev/input",         InitConst.DIR_MODE, 0, 0, 0)

        // Create data directories for UUID file store
        SystemCall(InitSys.SYS_MKDIR, "/data",              InitConst.DIR_MODE, 0, 0, 0)
        SystemCall(InitSys.SYS_MKDIR, InitPaths.blob_dir,   InitConst.DIR_MODE, 0, 0, 0)
        PrintMessage("[INIT] Created blob store: ")
        PrintString(InitPaths.blob_dir)
        PrintMessage("\n")

        // Create /run/postgresql for PG socket
        SystemCall(InitSys.SYS_MKDIR, "/run/postgresql",    InitConst.DIR_MODE, 0, 0, 0)
        // chown to postgres user — syscall 92 = chown(path, uid, gid)
        SystemCall(92, "/run/postgresql", InitConst.PG_UID, InitConst.PG_GID, 0, 0)
    }
}

// =============================================================================
// START POSTGRESQL — fork/exec as postgres user
// Returns child PID, or 0 on failure.
// =============================================================================
// =============================================================================
// INIT POSTGRESQL DATA DIRECTORY — run initdb if PG_VERSION doesn't exist
// =============================================================================
Function.Init_InitPGData {
    Body: {
        // Check if PG_VERSION exists in data dir
        pg_version_path = StringConcat(InitPaths.pg_data, "/PG_VERSION")
        fd = SystemCall(InitSys.SYS_OPEN, pg_version_path, 0, 0, 0, 0)
        Deallocate(pg_version_path, 0)

        IfCondition GreaterEqual(fd, 0) ThenBlock: {
            // PG_VERSION exists — already initialized (pre-built data dir)
            SystemCall(InitSys.SYS_CLOSE, fd, 0, 0, 0, 0)
            // Ensure ownership is correct (data dir may have been built on host as different user)
            SystemCall(92, "/var/lib/postgresql", InitConst.PG_UID, InitConst.PG_GID, 0, 0)
            SystemCall(92, InitPaths.pg_data, InitConst.PG_UID, InitConst.PG_GID, 0, 0)
            // Recursively chown: fork/exec chown -R 121:124 /var/lib/postgresql/data
            chown_argv = Allocate(40)
            StoreValue(Add(chown_argv, 0), "/bin/chown")
            StoreValue(Add(chown_argv, 8), "-R")
            StoreValue(Add(chown_argv, 16), "121:124")
            StoreValue(Add(chown_argv, 24), InitPaths.pg_data)
            StoreValue(Add(chown_argv, 32), 0)
            chown_pid = SystemCall(InitSys.SYS_FORK, 0, 0, 0, 0, 0)
            IfCondition EqualTo(chown_pid, 0) ThenBlock: {
                chown_envp = Allocate(8)
                StoreValue(Add(chown_envp, 0), 0)
                SystemCall(InitSys.SYS_EXECVE, "/bin/chown", chown_argv, chown_envp, 0, 0)
                SystemCall(InitSys.SYS_EXIT, 127, 0, 0, 0, 0)
            }
            IfCondition GreaterThan(chown_pid, 0) ThenBlock: {
                chown_ws = Allocate(4)
                SystemCall(InitSys.SYS_WAIT4, chown_pid, chown_ws, 0, 0, 0)
                Deallocate(chown_ws, 4)
            }
            PrintMessage("[INIT] PostgreSQL data directory ready (pre-built)\n")
            ReturnValue(0)
        }

        PrintMessage("[INIT] Initializing PostgreSQL data directory...\n")

        // Ensure data directory exists and is owned by postgres
        SystemCall(InitSys.SYS_MKDIR, "/var",                       InitConst.DIR_MODE, 0, 0, 0)
        SystemCall(InitSys.SYS_MKDIR, "/var/lib",                   InitConst.DIR_MODE, 0, 0, 0)
        SystemCall(InitSys.SYS_MKDIR, "/var/lib/postgresql",        InitConst.DIR_MODE, 0, 0, 0)
        SystemCall(InitSys.SYS_MKDIR, InitPaths.pg_data,            InitConst.DIR_MODE, 0, 0, 0)
        // chown to postgres
        SystemCall(92, InitPaths.pg_data, InitConst.PG_UID, InitConst.PG_GID, 0, 0)
        SystemCall(92, "/var/lib/postgresql", InitConst.PG_UID, InitConst.PG_GID, 0, 0)

        // Run initdb as postgres user
        // argv: ["initdb", "-D", data_dir, NULL]
        argv = Allocate(32)
        StoreValue(Add(argv, 0),  "/usr/bin/initdb")
        StoreValue(Add(argv, 8),  "-D")
        StoreValue(Add(argv, 16), InitPaths.pg_data)
        StoreValue(Add(argv, 24), 0)

        envp = Allocate(24)
        StoreValue(Add(envp, 0), "HOME=/var/lib/postgresql")
        StoreValue(Add(envp, 8), "PATH=/usr/local/bin:/usr/bin:/bin")
        StoreValue(Add(envp, 16), 0)

        pid = SystemCall(InitSys.SYS_FORK, 0, 0, 0, 0, 0)
        IfCondition EqualTo(pid, 0) ThenBlock: {
            // CHILD — switch to postgres user
            SystemCall(InitSys.SYS_SETGID, InitConst.PG_GID, 0, 0, 0, 0)
            SystemCall(InitSys.SYS_SETUID, InitConst.PG_UID, 0, 0, 0, 0)
            SystemCall(InitSys.SYS_EXECVE, "/usr/bin/initdb", argv, envp, 0, 0)
            PrintMessage("[INIT] ERROR: initdb execve failed\n")
            SystemCall(InitSys.SYS_EXIT, 127, 0, 0, 0, 0)
        }

        // Wait for initdb to complete
        status_buf = Allocate(8)
        StoreValue(status_buf, 0)
        SystemCall(InitSys.SYS_WAIT4, pid, status_buf, 0, 0, 0)
        wstatus = Dereference(status_buf)
        exit_code = BitwiseAnd(Divide(wstatus, 256), 255)
        Deallocate(status_buf, 8)
        Deallocate(argv, 32)
        Deallocate(envp, 24)

        IfCondition EqualTo(exit_code, 0) ThenBlock: {
            PrintMessage("[INIT] initdb completed successfully\n")

            // Configure pg_hba.conf for trust authentication
            hba_path = StringConcat(InitPaths.pg_data, "/pg_hba.conf")
            hba_fd = SystemCall(InitSys.SYS_OPEN, hba_path, 577, 420, 0, 0)  // O_WRONLY|O_CREAT|O_TRUNC=577, 0644=420
            IfCondition GreaterEqual(hba_fd, 0) ThenBlock: {
                hba_content = "local all postgres trust\nlocal all bob trust\nhost all all 127.0.0.1/32 trust\nhost all all ::1/128 trust\nhost all all 10.0.2.0/24 trust\n"
                hba_len = StringLength(hba_content)
                SystemCall(InitSys.SYS_WRITE, hba_fd, hba_content, hba_len, 0, 0)
                SystemCall(InitSys.SYS_CLOSE, hba_fd, 0, 0, 0, 0)
                PrintMessage("[INIT] pg_hba.conf configured (trust auth)\n")
            }
            Deallocate(hba_path, 0)

            // Configure postgresql.conf to listen on all interfaces
            // We append to the file
            conf_path = StringConcat(InitPaths.pg_data, "/postgresql.conf")
            conf_fd = SystemCall(InitSys.SYS_OPEN, conf_path, 1089, 420, 0, 0)  // O_WRONLY|O_APPEND|O_CREAT=1089
            IfCondition GreaterEqual(conf_fd, 0) ThenBlock: {
                conf_append = "\nlisten_addresses = '0.0.0.0'\n"
                conf_len = StringLength(conf_append)
                SystemCall(InitSys.SYS_WRITE, conf_fd, conf_append, conf_len, 0, 0)
                SystemCall(InitSys.SYS_CLOSE, conf_fd, 0, 0, 0, 0)
                PrintMessage("[INIT] postgresql.conf: listen on all interfaces\n")
            }
            Deallocate(conf_path, 0)
        } ElseBlock: {
            PrintMessage("[INIT] ERROR: initdb failed with exit code ")
            PrintNumber(exit_code)
            PrintMessage("\n")
        }
    }
}

Function.Init_StartPostgres {
    Output: Integer
    Body: {
        PrintMessage("[INIT] Starting PostgreSQL...\n")

        // Build argv: ["postgres", "-D", data_dir, NULL]
        argv = Allocate(32)
        StoreValue(Add(argv, 0),  InitPaths.pg_bin)
        StoreValue(Add(argv, 8),  "-D")
        StoreValue(Add(argv, 16), InitPaths.pg_data)
        StoreValue(Add(argv, 24), 0)

        // Build envp
        envp = Allocate(24)
        StoreValue(Add(envp, 0), "HOME=/var/lib/postgresql")
        StoreValue(Add(envp, 8), "PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin")
        StoreValue(Add(envp, 16), 0)

        pid = SystemCall(InitSys.SYS_FORK, 0, 0, 0, 0, 0)

        IfCondition EqualTo(pid, 0) ThenBlock: {
            // CHILD PROCESS
            // Create new session
            SystemCall(InitSys.SYS_SETSID, 0, 0, 0, 0, 0)

            // Switch to postgres user
            SystemCall(InitSys.SYS_SETGID, InitConst.PG_GID, 0, 0, 0, 0)
            SystemCall(InitSys.SYS_SETUID, InitConst.PG_UID, 0, 0, 0, 0)

            // Exec postgres
            SystemCall(InitSys.SYS_EXECVE, InitPaths.pg_bin, argv, envp, 0, 0)

            // If we get here, exec failed
            PrintMessage("[INIT] ERROR: postgres execve failed\n")
            SystemCall(InitSys.SYS_EXIT, 127, 0, 0, 0, 0)
        }

        Deallocate(argv, 32)
        Deallocate(envp, 24)

        IfCondition LessThan(pid, 0) ThenBlock: {
            PrintMessage("[INIT] ERROR: fork failed for PostgreSQL\n")
            ReturnValue(0)
        }

        PrintMessage("[INIT] PostgreSQL PID=")
        PrintNumber(pid)
        PrintMessage("\n")
        ReturnValue(pid)
    }
}

// =============================================================================
// CHECK IF PG IS READY — try TCP connect to 127.0.0.1:5432
// Returns 1 if ready, 0 if not.
// =============================================================================
Function.Init_CheckPGReady {
    Output: Integer
    Body: {
        // Create TCP socket
        sock = SystemCall(InitSys.SYS_SOCKET, InitConst.AF_INET, InitConst.SOCK_STREAM, 0, 0, 0)
        IfCondition LessThan(sock, 0) ThenBlock: {
            ReturnValue(0)
        }

        // Build sockaddr_in for 127.0.0.1:5432
        addr = Allocate(16)
        MemorySet(addr, 0, 16)
        SetByte(addr, 0, 2)     // AF_INET
        SetByte(addr, 1, 0)
        // Port 5432 in big-endian: 5432 = 0x1538 → high=0x15=21, low=0x38=56
        SetByte(addr, 2, 21)    // port high byte
        SetByte(addr, 3, 56)    // port low byte
        // 127.0.0.1
        SetByte(addr, 4, 127)
        SetByte(addr, 5, 0)
        SetByte(addr, 6, 0)
        SetByte(addr, 7, 1)

        rc = SystemCall(InitSys.SYS_CONNECT, sock, addr, 16, 0, 0)
        Deallocate(addr, 16)
        SystemCall(InitSys.SYS_CLOSE, sock, 0, 0, 0, 0)

        IfCondition LessThan(rc, 0) ThenBlock: {
            ReturnValue(0)
        }
        ReturnValue(1)
    }
}

// =============================================================================
// WAIT FOR PG READY — poll TCP 5432 until PG accepts connections
// Retries up to MAX_PG_WAIT seconds.
// =============================================================================
Function.Init_WaitForPG {
    Output: Integer
    Body: {
        PrintMessage("[INIT] Waiting for PostgreSQL to accept connections...")

        // Allocate timespec for 1 second sleep
        ts = Allocate(16)
        StoreValue(ts, 1)              // 1 second
        StoreValue(Add(ts, 8), 0)      // 0 nanoseconds

        attempts = 0
        WhileLoop LessThan(attempts, InitConst.MAX_PG_WAIT) {
            ready = Init_CheckPGReady()
            IfCondition EqualTo(ready, 1) ThenBlock: {
                PrintMessage(" ready!\n")
                Deallocate(ts, 16)
                ReturnValue(1)
            }
            PrintMessage(".")
            SystemCall(InitSys.SYS_NANOSLEEP, ts, 0, 0, 0, 0)
            attempts = Add(attempts, 1)
        }

        Deallocate(ts, 16)
        PrintMessage(" TIMEOUT!\n")
        PrintMessage("[INIT] ERROR: PostgreSQL did not become ready after ")
        PrintNumber(InitConst.MAX_PG_WAIT)
        PrintMessage(" seconds\n")
        ReturnValue(0)
    }
}

// =============================================================================
// BOOTSTRAP SCHEMA — connect to PG and run Schema_Bootstrap
// =============================================================================
Function.Init_BootstrapSchema {
    Output: Integer
    Body: {
        PrintMessage("[INIT] Bootstrapping schema...\n")
        conn = PG_Connect(InitPaths.pg_host, InitConst.PG_PORT, InitPaths.pg_dbname, InitPaths.pg_user, "")
        IfCondition EqualTo(conn, 0) ThenBlock: {
            PrintMessage("[INIT] ERROR: Cannot connect to PostgreSQL for schema bootstrap\n")
            ReturnValue(0)
        }

        Schema_Bootstrap(conn)
        PG_Disconnect(conn)
        PrintMessage("[INIT] Schema bootstrap complete\n")
        ReturnValue(1)
    }
}

// =============================================================================
// START SERVICE DAEMON — fork/exec
// Returns child PID, or 0 on failure.
// =============================================================================
Function.Init_StartServiceDaemon {
    Output: Integer
    Body: {
        PrintMessage("[INIT] Starting service daemon...\n")

        // Build argv: [svc_bin, NULL]
        argv = Allocate(16)
        StoreValue(Add(argv, 0), InitPaths.svc_bin)
        StoreValue(Add(argv, 8), 0)

        // Build envp
        envp = Allocate(24)
        StoreValue(Add(envp, 0), "HOME=/root")
        StoreValue(Add(envp, 8), "PATH=/system/bin:/usr/local/bin:/usr/bin:/bin")
        StoreValue(Add(envp, 16), 0)

        pid = SystemCall(InitSys.SYS_FORK, 0, 0, 0, 0, 0)

        IfCondition EqualTo(pid, 0) ThenBlock: {
            // CHILD PROCESS
            SystemCall(InitSys.SYS_SETSID, 0, 0, 0, 0, 0)
            SystemCall(InitSys.SYS_EXECVE, InitPaths.svc_bin, argv, envp, 0, 0)
            PrintMessage("[INIT] ERROR: svc_daemon execve failed\n")
            SystemCall(InitSys.SYS_EXIT, 127, 0, 0, 0, 0)
        }

        Deallocate(argv, 16)
        Deallocate(envp, 24)

        IfCondition LessThan(pid, 0) ThenBlock: {
            PrintMessage("[INIT] ERROR: fork failed for service daemon\n")
            ReturnValue(0)
        }

        PrintMessage("[INIT] Service daemon PID=")
        PrintNumber(pid)
        PrintMessage("\n")
        ReturnValue(pid)
    }
}

// =============================================================================
// FORK/EXEC HELPER — run a command and wait for it to complete
// Returns exit code, or -1 on failure.
// =============================================================================
Function.Init_RunCommand {
    Input: cmd_path: Integer
    Input: argv: Integer
    Output: Integer
    Body: {
        pid = SystemCall(InitSys.SYS_FORK, 0, 0, 0, 0, 0)

        IfCondition EqualTo(pid, 0) ThenBlock: {
            // CHILD
            envp = Allocate(16)
            StoreValue(Add(envp, 0), "PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin")
            StoreValue(Add(envp, 8), 0)
            SystemCall(InitSys.SYS_EXECVE, cmd_path, argv, envp, 0, 0)
            SystemCall(InitSys.SYS_EXIT, 127, 0, 0, 0, 0)
        }

        IfCondition LessThan(pid, 0) ThenBlock: {
            ReturnValue(-1)
        }

        // Wait for child
        status_buf = Allocate(8)
        StoreValue(status_buf, 0)
        SystemCall(InitSys.SYS_WAIT4, pid, status_buf, 0, 0, 0)
        wstatus = Dereference(status_buf)
        exit_code = BitwiseAnd(Divide(wstatus, 256), 255)
        Deallocate(status_buf, 8)
        ReturnValue(exit_code)
    }
}

// =============================================================================
// SETUP NETWORK — bring up lo, discover Ethernet interface, DHCP or static
// =============================================================================
Function.Init_SetupNetwork {
    Body: {
        PrintMessage("[INIT] Setting up network...\n")

        // ifconfig lo 127.0.0.1 up
        argv_lo = Allocate(40)
        StoreValue(Add(argv_lo, 0), "/sbin/ifconfig")
        StoreValue(Add(argv_lo, 8), "lo")
        StoreValue(Add(argv_lo, 16), "127.0.0.1")
        StoreValue(Add(argv_lo, 24), "up")
        StoreValue(Add(argv_lo, 32), 0)
        rc = Init_RunCommand("/sbin/ifconfig", argv_lo)
        Deallocate(argv_lo, 40)
        IfCondition EqualTo(rc, 0) ThenBlock: {
            PrintMessage("[INIT] lo interface up\n")
        } ElseBlock: {
            PrintMessage("[INIT] WARNING: lo setup failed\n")
        }

        // Discover Ethernet interface by scanning /sys/class/net/
        // Retry a few times — NIC driver may still be initializing
        eth_name = 0
        eth_try = 0
        WhileLoop LessThan(eth_try, 3) {
            eth_name = Init_FindEthInterface()
            IfCondition NotEqual(eth_name, 0) ThenBlock: { eth_try = 99 }
            IfCondition And(EqualTo(eth_name, 0), LessThan(eth_try, 2)) ThenBlock: {
                PrintMessage("[INIT] No eth interface yet, retrying...\n")
                Init_Sleep(1)
            }
            eth_try = Add(eth_try, 1)
        }
        IfCondition EqualTo(eth_name, 0) ThenBlock: {
            PrintMessage("[INIT] WARNING: no Ethernet interface found\n")
            Init_TryWiFiFallback()
            ReturnValue(0)
        }

        PrintMessage("[INIT] Found Ethernet: ")
        PrintString(eth_name)
        PrintMessage("\n")

        // Bring interface up
        argv_eth = Allocate(32)
        StoreValue(Add(argv_eth, 0), "/sbin/ifconfig")
        StoreValue(Add(argv_eth, 8), eth_name)
        StoreValue(Add(argv_eth, 16), "up")
        StoreValue(Add(argv_eth, 24), 0)
        rc2 = Init_RunCommand("/sbin/ifconfig", argv_eth)
        Deallocate(argv_eth, 32)
        IfCondition EqualTo(rc2, 0) ThenBlock: {
            PrintMessage("[INIT] ")
            PrintString(eth_name)
            PrintMessage(" interface up\n")
        } ElseBlock: {
            PrintMessage("[INIT] WARNING: ")
            PrintString(eth_name)
            PrintMessage(" setup failed\n")
        }

        // Try DHCP first — short timeout for direct-cable scenarios
        argv_dhcp = Allocate(80)
        StoreValue(Add(argv_dhcp, 0),  "/sbin/udhcpc")
        StoreValue(Add(argv_dhcp, 8),  "-i")
        StoreValue(Add(argv_dhcp, 16), eth_name)
        StoreValue(Add(argv_dhcp, 24), "-n")
        StoreValue(Add(argv_dhcp, 32), "-q")
        StoreValue(Add(argv_dhcp, 40), "-T")
        StoreValue(Add(argv_dhcp, 48), "2")
        StoreValue(Add(argv_dhcp, 56), "-t")
        StoreValue(Add(argv_dhcp, 64), "2")
        StoreValue(Add(argv_dhcp, 72), 0)
        rc3 = Init_RunCommand("/sbin/udhcpc", argv_dhcp)
        Deallocate(argv_dhcp, 80)
        IfCondition EqualTo(rc3, 0) ThenBlock: {
            PrintMessage("[INIT] DHCP lease acquired on ")
            PrintString(eth_name)
            PrintMessage("\n")
        } ElseBlock: {
            PrintMessage("[INIT] DHCP failed — assigning static 10.0.0.2 on ")
            PrintString(eth_name)
            PrintMessage("\n")
            // Static fallback: ifconfig <iface> 10.0.0.2 netmask 255.255.255.0
            argv_static = Allocate(48)
            StoreValue(Add(argv_static, 0),  "/sbin/ifconfig")
            StoreValue(Add(argv_static, 8),  eth_name)
            StoreValue(Add(argv_static, 16), "10.0.0.2")
            StoreValue(Add(argv_static, 24), "netmask")
            StoreValue(Add(argv_static, 32), "255.255.255.0")
            StoreValue(Add(argv_static, 40), 0)
            Init_RunCommand("/sbin/ifconfig", argv_static)
            Deallocate(argv_static, 48)
            PrintMessage("[INIT] Static IP 10.0.0.2/24 assigned\n")
            Init_TryWiFiFallback()
        }
    }
}

// =============================================================================
// FIND ETHERNET INTERFACE — scan /sys/class/net/, return first non-lo/wlan name
// Returns pointer to name string, or 0 if none found.
// =============================================================================
Function.Init_FindEthInterface {
    Output: Address
    Body: {
        dents = Allocate(4096)
        // SYS_GETDENTS64 = 217 on x86-64
        dir_fd = SystemCall(InitSys.SYS_OPEN, "/sys/class/net", 0, 0, 0, 0)
        IfCondition LessThan(dir_fd, 0) ThenBlock: {
            Deallocate(dents, 4096)
            ReturnValue(0)
        }

        found = 0
        name_buf = Allocate(32)

        nbytes = SystemCall(217, dir_fd, dents, 4096, 0, 0)
        IfCondition GreaterThan(nbytes, 0) ThenBlock: {
            pos = 0
            WhileLoop LessThan(pos, nbytes) {
                reclen_lo = GetByte(dents, Add(pos, 16))
                reclen_hi = GetByte(dents, Add(pos, 17))
                reclen = Add(reclen_lo, Multiply(reclen_hi, 256))
                IfCondition EqualTo(reclen, 0) ThenBlock: { pos = nbytes }

                // d_name starts at offset 19 for getdents64 (d_ino=8, d_off=8, d_reclen=2, d_type=1)
                name_off = Add(pos, 19)

                // Get name length
                nlen = 0
                WhileLoop And(LessThan(nlen, 30), NotEqual(GetByte(dents, Add(name_off, nlen)), 0)) {
                    nlen = Add(nlen, 1)
                }

                // Skip ".", "..", "lo"
                skip = 0
                IfCondition EqualTo(nlen, 1) ThenBlock: {
                    IfCondition EqualTo(GetByte(dents, name_off), 46) ThenBlock: { skip = 1 }
                }
                IfCondition EqualTo(nlen, 2) ThenBlock: {
                    IfCondition And(EqualTo(GetByte(dents, name_off), 46), EqualTo(GetByte(dents, Add(name_off, 1)), 46)) ThenBlock: { skip = 1 }
                    IfCondition And(EqualTo(GetByte(dents, name_off), 108), EqualTo(GetByte(dents, Add(name_off, 1)), 111)) ThenBlock: { skip = 1 }
                }
                // Skip wlan* interfaces (starts with 'w' = 119)
                IfCondition EqualTo(GetByte(dents, name_off), 119) ThenBlock: { skip = 1 }
                // Skip sit0 tunnel interfaces (starts with 's' = 115)
                IfCondition EqualTo(GetByte(dents, name_off), 115) ThenBlock: { skip = 1 }
                // Skip dummy* interfaces (starts with 'd' = 100)
                IfCondition EqualTo(GetByte(dents, name_off), 100) ThenBlock: { skip = 1 }

                // Take first non-skipped interface (prefer eth/enp)
                IfCondition And(EqualTo(skip, 0), EqualTo(found, 0)) ThenBlock: {
                    ci = 0
                    WhileLoop LessThan(ci, nlen) {
                        SetByte(name_buf, ci, GetByte(dents, Add(name_off, ci)))
                        ci = Add(ci, 1)
                    }
                    SetByte(name_buf, nlen, 0)
                    found = 1
                    PrintMessage("[INIT] Discovered interface: ")
                    PrintString(name_buf)
                    PrintMessage("\n")
                }

                pos = Add(pos, reclen)
            }
        }

        SystemCall(InitSys.SYS_CLOSE, dir_fd, 0, 0, 0, 0)
        Deallocate(dents, 4096)

        IfCondition EqualTo(found, 1) ThenBlock: {
            ReturnValue(name_buf)
        }
        Deallocate(name_buf, 32)
        ReturnValue(0)
    }
}

// =============================================================================
// WIFI FALLBACK — detect wlan interface, try wpa_supplicant + DHCP
// =============================================================================
Function.Init_TryWiFiFallback {
    Output: Integer
    Body: {
        // Probe /sys/class/net/wlan0 through wlan3
        wlan_iface = ""
        fd0 = SystemCall(InitSys.SYS_OPEN, "/sys/class/net/wlan0", 0, 0, 0, 0)
        IfCondition GreaterEqual(fd0, 0) ThenBlock: {
            SystemCall(InitSys.SYS_CLOSE, fd0, 0, 0, 0, 0)
            wlan_iface = "wlan0"
        }
        IfCondition EqualTo(StringLength(wlan_iface), 0) ThenBlock: {
            fd1 = SystemCall(InitSys.SYS_OPEN, "/sys/class/net/wlan1", 0, 0, 0, 0)
            IfCondition GreaterEqual(fd1, 0) ThenBlock: {
                SystemCall(InitSys.SYS_CLOSE, fd1, 0, 0, 0, 0)
                wlan_iface = "wlan1"
            }
        }
        IfCondition EqualTo(StringLength(wlan_iface), 0) ThenBlock: {
            fd2 = SystemCall(InitSys.SYS_OPEN, "/sys/class/net/wlan2", 0, 0, 0, 0)
            IfCondition GreaterEqual(fd2, 0) ThenBlock: {
                SystemCall(InitSys.SYS_CLOSE, fd2, 0, 0, 0, 0)
                wlan_iface = "wlan2"
            }
        }
        IfCondition EqualTo(StringLength(wlan_iface), 0) ThenBlock: {
            fd3 = SystemCall(InitSys.SYS_OPEN, "/sys/class/net/wlan3", 0, 0, 0, 0)
            IfCondition GreaterEqual(fd3, 0) ThenBlock: {
                SystemCall(InitSys.SYS_CLOSE, fd3, 0, 0, 0, 0)
                wlan_iface = "wlan3"
            }
        }

        IfCondition EqualTo(StringLength(wlan_iface), 0) ThenBlock: {
            PrintMessage("[INIT] No WiFi interface detected\n")
            ReturnValue(0)
        }

        PrintMessage("[INIT] Found WiFi interface: ")
        PrintMessage(wlan_iface)
        PrintMessage("\n")

        // Bring WiFi interface up
        argv_wup = Allocate(32)
        StoreValue(Add(argv_wup, 0), "/sbin/ifconfig")
        StoreValue(Add(argv_wup, 8), wlan_iface)
        StoreValue(Add(argv_wup, 16), "up")
        StoreValue(Add(argv_wup, 24), 0)
        rc_wup = Init_RunCommand("/sbin/ifconfig", argv_wup)
        Deallocate(argv_wup, 32)
        IfCondition NotEqual(rc_wup, 0) ThenBlock: {
            PrintMessage("[INIT] WARNING: WiFi interface up failed\n")
            ReturnValue(0)
        }

        // Check if /etc/wpa_supplicant.conf exists
        wpa_fd = SystemCall(InitSys.SYS_OPEN, "/etc/wpa_supplicant.conf", 0, 0, 0, 0)
        IfCondition LessThan(wpa_fd, 0) ThenBlock: {
            PrintMessage("[INIT] No /etc/wpa_supplicant.conf — WiFi not configured\n")
            PrintMessage("[INIT] Use WiFi Config app to set up a connection\n")
            ReturnValue(0)
        }
        SystemCall(InitSys.SYS_CLOSE, wpa_fd, 0, 0, 0, 0)

        PrintMessage("[INIT] Starting wpa_supplicant on ")
        PrintMessage(wlan_iface)
        PrintMessage("...\n")

        // Start wpa_supplicant as a background daemon
        // wpa_supplicant -B -D nl80211,wext -i <iface> -c /etc/wpa_supplicant.conf
        argv_wpa = Allocate(80)
        StoreValue(Add(argv_wpa, 0),  "/usr/sbin/wpa_supplicant")
        StoreValue(Add(argv_wpa, 8),  "-B")
        StoreValue(Add(argv_wpa, 16), "-D")
        StoreValue(Add(argv_wpa, 24), "nl80211,wext")
        StoreValue(Add(argv_wpa, 32), "-i")
        StoreValue(Add(argv_wpa, 40), wlan_iface)
        StoreValue(Add(argv_wpa, 48), "-c")
        StoreValue(Add(argv_wpa, 56), "/etc/wpa_supplicant.conf")
        StoreValue(Add(argv_wpa, 64), 0)
        rc_wpa = Init_RunCommand("/usr/sbin/wpa_supplicant", argv_wpa)
        Deallocate(argv_wpa, 80)
        IfCondition NotEqual(rc_wpa, 0) ThenBlock: {
            PrintMessage("[INIT] WARNING: wpa_supplicant failed to start\n")
            ReturnValue(0)
        }
        PrintMessage("[INIT] wpa_supplicant started\n")

        // Give wpa_supplicant a moment to associate (sleep 2)
        // Use nanosleep: struct timespec { tv_sec, tv_nsec }
        ts_buf = Allocate(16)
        StoreValue(Add(ts_buf, 0), 3)
        StoreValue(Add(ts_buf, 8), 0)
        SystemCall(InitSys.SYS_NANOSLEEP, ts_buf, 0, 0, 0, 0)
        Deallocate(ts_buf, 16)

        // Run DHCP on WiFi interface
        PrintMessage("[INIT] Running DHCP on ")
        PrintMessage(wlan_iface)
        PrintMessage("...\n")
        argv_wdhcp = Allocate(48)
        StoreValue(Add(argv_wdhcp, 0),  "/sbin/udhcpc")
        StoreValue(Add(argv_wdhcp, 8),  "-i")
        StoreValue(Add(argv_wdhcp, 16), wlan_iface)
        StoreValue(Add(argv_wdhcp, 24), "-n")
        StoreValue(Add(argv_wdhcp, 32), "-q")
        StoreValue(Add(argv_wdhcp, 40), 0)
        rc_wdhcp = Init_RunCommand("/sbin/udhcpc", argv_wdhcp)
        Deallocate(argv_wdhcp, 48)
        IfCondition EqualTo(rc_wdhcp, 0) ThenBlock: {
            PrintMessage("[INIT] WiFi DHCP lease acquired\n")
        } ElseBlock: {
            PrintMessage("[INIT] WARNING: WiFi DHCP failed\n")
        }
    }
}

// =============================================================================
// START SSHD — fork/exec openssh daemon for remote access
// Returns child PID, or 0 on failure.
// =============================================================================
Function.Init_StartSSHD {
    Output: Integer
    Body: {
        PrintMessage("[INIT] Starting sshd...\n")

        // Ensure required directories exist
        SystemCall(InitSys.SYS_MKDIR, "/var",          InitConst.DIR_MODE, 0, 0, 0)
        SystemCall(InitSys.SYS_MKDIR, "/var/run",      InitConst.DIR_MODE, 0, 0, 0)
        SystemCall(InitSys.SYS_MKDIR, "/var/empty",    InitConst.DIR_MODE, 0, 0, 0)

        // Build argv: ["/usr/sbin/sshd", "-D", NULL]
        // -D = don't detach (stay in foreground, we manage it)
        argv = Allocate(24)
        StoreValue(Add(argv, 0), "/usr/sbin/sshd")
        StoreValue(Add(argv, 8), "-D")
        StoreValue(Add(argv, 16), 0)

        // Build envp
        envp = Allocate(24)
        StoreValue(Add(envp, 0), "HOME=/root")
        StoreValue(Add(envp, 8), "PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin")
        StoreValue(Add(envp, 16), 0)

        pid = SystemCall(InitSys.SYS_FORK, 0, 0, 0, 0, 0)

        IfCondition EqualTo(pid, 0) ThenBlock: {
            // CHILD PROCESS
            SystemCall(InitSys.SYS_SETSID, 0, 0, 0, 0, 0)
            SystemCall(InitSys.SYS_EXECVE, "/usr/sbin/sshd", argv, envp, 0, 0)
            PrintMessage("[INIT] ERROR: sshd execve failed\n")
            SystemCall(InitSys.SYS_EXIT, 127, 0, 0, 0, 0)
        }

        Deallocate(argv, 24)
        Deallocate(envp, 24)

        IfCondition LessThan(pid, 0) ThenBlock: {
            PrintMessage("[INIT] ERROR: fork failed for sshd\n")
            ReturnValue(0)
        }

        PrintMessage("[INIT] sshd PID=")
        PrintNumber(pid)
        PrintMessage("\n")
        ReturnValue(pid)
    }
}

// =============================================================================
// SLEEP HELPER — sleep N seconds
// =============================================================================
Function.Init_Sleep {
    Input: seconds: Integer
    Body: {
        ts = Allocate(16)
        StoreValue(ts, seconds)
        StoreValue(Add(ts, 8), 0)
        SystemCall(InitSys.SYS_NANOSLEEP, ts, 0, 0, 0, 0)
        Deallocate(ts, 16)
    }
}

Function.Init_Sleep_MS {
    Input: ms: Integer
    Body: {
        ts = Allocate(16)
        StoreValue(ts, 0)
        StoreValue(Add(ts, 8), Multiply(ms, 1000000))
        SystemCall(InitSys.SYS_NANOSLEEP, ts, 0, 0, 0, 0)
        Deallocate(ts, 16)
    }
}

// =============================================================================
// WATCHDOG LOOP — PID 1 must never exit.
// Reaps children, restarts PostgreSQL and service daemon if they die.
// =============================================================================
Function.Init_Watchdog {
    Body: {
        PrintMessage("[INIT] Entering watchdog loop — PID 1 active\n")

        // Allocate status buffer for waitpid
        status_buf = Allocate(8)

        // Sleep interval: 1 second
        ts = Allocate(16)
        StoreValue(ts, 1)
        StoreValue(Add(ts, 8), 0)

        WhileLoop EqualTo(InitState.running, 1) {
            // Non-blocking wait for any child
            StoreValue(status_buf, 0)
            died_pid = SystemCall(InitSys.SYS_WAIT4, -1, status_buf, InitConst.WNOHANG, 0, 0)

            IfCondition GreaterThan(died_pid, 0) ThenBlock: {
                // Extract exit code
                wstatus = Dereference(status_buf)
                exit_code = BitwiseAnd(Divide(wstatus, 256), 255)

                PrintMessage("[INIT] Child died: PID=")
                PrintNumber(died_pid)
                PrintMessage(" exit=")
                PrintNumber(exit_code)
                PrintMessage("\n")

                // Check if PostgreSQL died
                IfCondition EqualTo(died_pid, InitState.pg_pid) ThenBlock: {
                    PrintMessage("[INIT] PostgreSQL died! Restarting...\n")
                    Init_Sleep(2)
                    InitState.pg_pid = Init_StartPostgres()
                    IfCondition GreaterThan(InitState.pg_pid, 0) ThenBlock: {
                        pg_ok = Init_WaitForPG()
                        IfCondition EqualTo(pg_ok, 0) ThenBlock: {
                            PrintMessage("[INIT] ERROR: PostgreSQL failed to restart\n")
                        }
                    }
                }

                // Check if service daemon died
                IfCondition EqualTo(died_pid, InitState.svc_pid) ThenBlock: {
                    PrintMessage("[INIT] Service daemon died! Restarting...\n")
                    Init_Sleep(2)
                    InitState.svc_pid = Init_StartServiceDaemon()
                }

                // Check if sshd died
                IfCondition EqualTo(died_pid, InitState.sshd_pid) ThenBlock: {
                    PrintMessage("[INIT] sshd died! Restarting...\n")
                    Init_Sleep(1)
                    InitState.sshd_pid = Init_StartSSHD()
                }
            }

            // Sleep 1 second between checks
            SystemCall(InitSys.SYS_NANOSLEEP, ts, 0, 0, 0, 0)
        }

        Deallocate(status_buf, 8)
        Deallocate(ts, 16)
    }
}

// =============================================================================
// MAIN ENTRY POINT — the boot sequence
// =============================================================================
SubRoutine.Main {
    Arena_Init()

    PrintMessage("========================================\n")
    PrintMessage("  AILang OS Init — PID 1\n")
    PrintMessage("========================================\n\n")

    // Set default paths
    Init_SetDefaults()

    // Step 1: Mount essential filesystems
    Init_MountAll()

    // Step 1a: Load boot configuration
    PrintMessage("\n[INIT] Step 1a: Loading boot config\n")
    Init_LoadBootConfig()
    config_trusted = Init_VerifyBootConfig()
    IfCondition EqualTo(config_trusted, 0) ThenBlock: {
        PrintMessage("[INIT] WARNING: Boot config signature invalid — using defaults\n")
    }

    // Step 1b: Set hostname (from config)
    PrintMessage("\n[INIT] Step 1b: Hostname\n")
    Init_SetHostname()

    // Step 1c: Load kernel modules (auto-detect or explicit list from config)
    PrintMessage("\n[INIT] Step 1c: Loading modules\n")
    Init_LoadModules()

    // Brief pause for NIC drivers to create /sys/class/net/ entries
    // Without this, Init_FindEthInterface runs before the kernel
    // has finished creating the interface and only finds "lo".
    PrintMessage("[INIT] Waiting for NIC enumeration...\n")
    Init_Sleep(2)

    // Step 1d: Setup network (mode from config: dhcp/static/none)
    PrintMessage("\n[INIT] Step 1d: Network setup\n")
    Init_SetupNetwork()

    // Enable ICMP echo replies
    icmp_fd = SystemCall(InitSys.SYS_OPEN, "/proc/sys/net/ipv4/icmp_echo_ignore_all", 577, 420, 0, 0)
    IfCondition GreaterEqual(icmp_fd, 0) ThenBlock: {
        SystemCall(InitSys.SYS_WRITE, icmp_fd, "0", 1, 0, 0)
        SystemCall(InitSys.SYS_CLOSE, icmp_fd, 0, 0, 0, 0)
    }

    // Step 1e: WiFi auto-connect (from config)
    PrintMessage("\n[INIT] Step 1e: WiFi\n")
    Init_WiFiAutoConnect()

    // Step 1f: Start sshd for remote access
    PrintMessage("\n[INIT] Step 1f: Start sshd\n")
    InitState.sshd_pid = Init_StartSSHD()

    // Step 2: (reserved — Login runs after PG is ready, see Step 5b)
    PrintMessage("\n[INIT] Step 2: (Login deferred until PG ready)\n")

    // Step 3: Initialize PG data directory if needed, then start PostgreSQL
    PrintMessage("[INIT] Step 3: Start PostgreSQL\n")
    Init_InitPGData()
    InitState.pg_pid = Init_StartPostgres()
    pg_ok = 1
    IfCondition EqualTo(InitState.pg_pid, 0) ThenBlock: {
        PrintMessage("[INIT] WARNING: Cannot start PostgreSQL — continuing without DB\n")
        pg_ok = 0
    }

    // Step 4: Wait for PG to accept connections
    IfCondition EqualTo(pg_ok, 1) ThenBlock: {
    PrintMessage("\n[INIT] Step 4: Wait for PostgreSQL\n")
    pg_ready = Init_WaitForPG()
    IfCondition EqualTo(pg_ready, 0) ThenBlock: {
        PrintMessage("[INIT] WARNING: PostgreSQL not responding — continuing without DB\n")
        pg_ok = 0
    }
    }

    // Step 4b: Create ailang_system database and bob user if needed
    IfCondition EqualTo(pg_ok, 1) ThenBlock: {
    PrintMessage("\n[INIT] Step 4b: Create database and user\n")
    // createdb ailang_system (run as postgres)
    argv_cdb = Allocate(24)
    StoreValue(Add(argv_cdb, 0), "/usr/bin/createdb")
    StoreValue(Add(argv_cdb, 8), "ailang_system")
    StoreValue(Add(argv_cdb, 16), 0)
    cdb_pid = SystemCall(InitSys.SYS_FORK, 0, 0, 0, 0, 0)
    IfCondition EqualTo(cdb_pid, 0) ThenBlock: {
        SystemCall(InitSys.SYS_SETGID, InitConst.PG_GID, 0, 0, 0, 0)
        SystemCall(InitSys.SYS_SETUID, InitConst.PG_UID, 0, 0, 0, 0)
        envp_pg = Allocate(16)
        StoreValue(Add(envp_pg, 0), "HOME=/var/lib/postgresql")
        StoreValue(Add(envp_pg, 8), 0)
        SystemCall(InitSys.SYS_EXECVE, "/usr/bin/createdb", argv_cdb, envp_pg, 0, 0)
        SystemCall(InitSys.SYS_EXIT, 127, 0, 0, 0, 0)
    }
    cdb_status = Allocate(8)
    SystemCall(InitSys.SYS_WAIT4, cdb_pid, cdb_status, 0, 0, 0)
    cdb_exit = BitwiseAnd(Divide(Dereference(cdb_status), 256), 255)
    Deallocate(cdb_status, 8)
    Deallocate(argv_cdb, 24)
    IfCondition EqualTo(cdb_exit, 0) ThenBlock: {
        PrintMessage("[INIT] Created ailang_system database\n")
    } ElseBlock: {
        PrintMessage("[INIT] ailang_system database already exists (or createdb failed)\n")
    }

    // createuser -s bob (run as postgres)
    argv_cu = Allocate(32)
    StoreValue(Add(argv_cu, 0), "/usr/bin/createuser")
    StoreValue(Add(argv_cu, 8), "-s")
    StoreValue(Add(argv_cu, 16), "bob")
    StoreValue(Add(argv_cu, 24), 0)
    cu_pid = SystemCall(InitSys.SYS_FORK, 0, 0, 0, 0, 0)
    IfCondition EqualTo(cu_pid, 0) ThenBlock: {
        SystemCall(InitSys.SYS_SETGID, InitConst.PG_GID, 0, 0, 0, 0)
        SystemCall(InitSys.SYS_SETUID, InitConst.PG_UID, 0, 0, 0, 0)
        envp_pg2 = Allocate(16)
        StoreValue(Add(envp_pg2, 0), "HOME=/var/lib/postgresql")
        StoreValue(Add(envp_pg2, 8), 0)
        SystemCall(InitSys.SYS_EXECVE, "/usr/bin/createuser", argv_cu, envp_pg2, 0, 0)
        SystemCall(InitSys.SYS_EXIT, 127, 0, 0, 0, 0)
    }
    cu_status = Allocate(8)
    SystemCall(InitSys.SYS_WAIT4, cu_pid, cu_status, 0, 0, 0)
    cu_exit = BitwiseAnd(Divide(Dereference(cu_status), 256), 255)
    Deallocate(cu_status, 8)
    Deallocate(argv_cu, 32)
    IfCondition EqualTo(cu_exit, 0) ThenBlock: {
        PrintMessage("[INIT] Created superuser bob\n")
    } ElseBlock: {
        PrintMessage("[INIT] bob user already exists (or createuser failed)\n")
    }

    // Step 5: Schema bootstrap handled by display.x after PG unlock
    PrintMessage("\n[INIT] Step 5: Schema managed by display server\n")

    } ElseBlock: {
        PrintMessage("[INIT] Skipping DB setup — PostgreSQL not available\n")
    }

    // Step 5b: Login — fork/exec login.x (validates credentials against PG bcrypt)
    // login.x exits 0 on success, 1 on failure/cancel
    PrintMessage("\n[INIT] Step 5b: Login\n")
    IfCondition EqualTo(pg_ok, 1) ThenBlock: {
        login_argv = Allocate(16)
        StoreValue(Add(login_argv, 0), "/system/bin/login.x")
        StoreValue(Add(login_argv, 8), 0)

        login_pid = SystemCall(InitSys.SYS_FORK, 0, 0, 0, 0, 0)
        IfCondition EqualTo(login_pid, 0) ThenBlock: {
            // CHILD — exec login.x
            login_envp = Allocate(16)
            StoreValue(Add(login_envp, 0), "HOME=/")
            StoreValue(Add(login_envp, 8), 0)
            SystemCall(InitSys.SYS_EXECVE, "/system/bin/login.x", login_argv, login_envp, 0, 0)
            PrintMessage("[INIT] ERROR: login.x execve failed\n")
            SystemCall(InitSys.SYS_EXIT, 127, 0, 0, 0, 0)
        }

        // PARENT — wait for login.x to exit
        IfCondition GreaterThan(login_pid, 0) ThenBlock: {
            PrintMessage("[INIT] login.x started (pid=")
            PrintNumber(login_pid)
            PrintMessage(")\n")
            login_ws = Allocate(8)
            StoreValue(login_ws, 0)
            SystemCall(InitSys.SYS_WAIT4, login_pid, login_ws, 0, 0, 0)
            login_wstatus = Dereference(login_ws)
            login_exit = BitwiseAnd(Divide(login_wstatus, 256), 255)
            Deallocate(login_ws, 8)

            PrintMessage("[INIT] login.x exited with code ")
            PrintNumber(login_exit)
            PrintMessage("\n")

            IfCondition NotEqual(login_exit, 0) ThenBlock: {
                PrintMessage("[INIT] FATAL: Login failed — halting\n")
                WhileLoop EqualTo(1, 1) {
                    Init_Sleep(3600)
                }
            }
            PrintMessage("[INIT] Login successful — continuing boot\n")
        } ElseBlock: {
            PrintMessage("[INIT] ERROR: fork failed for login.x\n")
        }
        Deallocate(login_argv, 16)
    } ElseBlock: {
        PrintMessage("[INIT] WARNING: PG not available, skipping login\n")
    }

    // ── Redirect fd 0/1/2 to /dev/null ──────────────────────────────
    // All boot messages are done. From here on, nothing PID 1 or its
    // children print should touch the framebuffer via /dev/console.
    // The display server owns /dev/fb0 exclusively.
    // SYS_OPEN=2, O_RDWR=2, SYS_DUP2=33, SYS_CLOSE=3
    devnull = SystemCall(InitSys.SYS_OPEN, "/dev/null", 2, 0, 0, 0)
    IfCondition GreaterEqual(devnull, 0) ThenBlock: {
        SystemCall(33, devnull, 0, 0, 0, 0)
        SystemCall(33, devnull, 1, 0, 0, 0)
        SystemCall(33, devnull, 2, 0, 0, 0)
        IfCondition GreaterThan(devnull, 2) ThenBlock: {
            SystemCall(InitSys.SYS_CLOSE, devnull, 0, 0, 0, 0)
        }
    }

    // Step 5c: Wait for input devices (USB HID enumeration takes time)
    PrintMessage("\n[INIT] Step 5c: Waiting for input devices...\n")
    input_wait = 0
    input_found = 0
    WhileLoop LessThan(input_wait, 50) {
        probe_fd = SystemCall(InitSys.SYS_OPEN, "/dev/input/event0", 0, 0, 0, 0)
        IfCondition GreaterEqual(probe_fd, 0) ThenBlock: {
            SystemCall(InitSys.SYS_CLOSE, probe_fd, 0, 0, 0, 0)
            input_found = 1
            input_wait = 50
        }
        IfCondition EqualTo(input_found, 0) ThenBlock: {
            Init_Sleep_MS(100)
            input_wait = Add(input_wait, 1)
        }
    }
    IfCondition EqualTo(input_found, 1) ThenBlock: {
        PrintMessage("[INIT] Input device found\n")
    }
    IfCondition EqualTo(input_found, 0) ThenBlock: {
        PrintMessage("[INIT] WARNING: No input devices found after 5s\n")
    }

    // Step 6: Start service daemon
    PrintMessage("\n[INIT] Step 6: Start service daemon\n")
    InitState.svc_pid = Init_StartServiceDaemon()
    IfCondition EqualTo(InitState.svc_pid, 0) ThenBlock: {
        PrintMessage("[INIT] WARNING: Service daemon failed to start\n")
    }

    // Step 7: Watchdog loop — PID 1 never exits
    PrintMessage("\n[INIT] Step 7: Entering watchdog\n")
    PrintMessage("========================================\n")
    PrintMessage("  AILang OS is running\n")
    PrintMessage("========================================\n\n")
    Init_Watchdog()

    // Should never reach here — PID 1 must not exit
    PrintMessage("[INIT] FATAL: Watchdog exited! PID 1 must not die.\n")
    WhileLoop EqualTo(1, 1) {
        Init_Sleep(3600)
    }
}

RunTask(Main)
