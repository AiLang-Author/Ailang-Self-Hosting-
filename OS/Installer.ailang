// Installer.ailang
// First-boot setup wizard for AILang OS.
// Framebuffer-based UI (fork of Login.ailang).
// Connects to PostgreSQL, bootstraps full schema, seeds all services,
// creates user account with chosen username and password.
// Copyright © 2025 Sean Collins, 2 Paws Machine and Engineering. All rights reserved. SCSL.

LibraryImport.Arena
LibraryImport.StringUtils
LibraryImport.Display.Render.Framebuffer
LibraryImport.TermFont
LibraryImport.Socket
LibraryImport.Hash
LibraryImport.Arrays
LibraryImport.PostgreSQL_Complete
LibraryImport.OS.Schema

// =============================================================================
// STUB: DebugLog_Push (needed by Framebuffer library, no-op here)
// =============================================================================
Function.DebugLog_Push {
    Input: tag: Address
    Input: len: Integer
    Body: {
        ReturnValue(0)
    }
}

// =============================================================================
// SYSCALL CONSTANTS
// =============================================================================
FixedPool.InstSys {
    "SYS_READ":      Initialize=0
    "SYS_WRITE":     Initialize=1
    "SYS_OPEN":      Initialize=2
    "SYS_CLOSE":     Initialize=3
    "SYS_IOCTL":     Initialize=16
    "SYS_NANOSLEEP": Initialize=35
}

FixedPool.InstConst {
    "MAX_USER":     Initialize=32
    "MAX_PASS":     Initialize=64
    "FIELD_USER":   Initialize=0
    "FIELD_PASS":   Initialize=1
    "FIELD_CONFIRM": Initialize=2
    "BULLET":       Initialize=42
    "EV_KEY":       Initialize=1
    "KEY_PRESS":    Initialize=1
    "KEY_ENTER":    Initialize=28
    "KEY_BACKSPACE": Initialize=14
    "KEY_TAB":      Initialize=15
    "KEY_LSHIFT":   Initialize=42
    "KEY_RSHIFT":   Initialize=54
    "KEY_CAPSLOCK": Initialize=58
    "NUM_FIELDS":   Initialize=3
}

// =============================================================================
// INSTALLER STATE
// =============================================================================
FixedPool.InstState {
    "user_buf":      Initialize=0, CanChange=True
    "pass_buf":      Initialize=0, CanChange=True
    "confirm_buf":   Initialize=0, CanChange=True
    "user_len":      Initialize=0, CanChange=True
    "pass_len":      Initialize=0, CanChange=True
    "confirm_len":   Initialize=0, CanChange=True
    "active_field":  Initialize=0, CanChange=True
    "status_msg":    Initialize=0, CanChange=True
    "error_msg":     Initialize=0, CanChange=True
    "headless":      Initialize=0, CanChange=True
    "kbd_fd":        Initialize=-1, CanChange=True
    "shift":         Initialize=0, CanChange=True
    "caps":          Initialize=0, CanChange=True
    "done":          Initialize=0, CanChange=True
    "phase":         Initialize=0, CanChange=True
    "success":       Initialize=0, CanChange=True
}

// phase: 0 = input, 1 = installing, 2 = done

// =============================================================================
// COLORS
// =============================================================================
FixedPool.InstColors {
    "bg":            Initialize=0, CanChange=True
    "box_bg":        Initialize=0, CanChange=True
    "box_border":    Initialize=0, CanChange=True
    "input_bg":      Initialize=0, CanChange=True
    "input_border":  Initialize=0, CanChange=True
    "text":          Initialize=0, CanChange=True
    "title":         Initialize=0, CanChange=True
    "error":         Initialize=0, CanChange=True
    "cursor":        Initialize=0, CanChange=True
    "active_border": Initialize=0, CanChange=True
    "success":       Initialize=0, CanChange=True
    "progress":      Initialize=0, CanChange=True
}

// =============================================================================
// KEYMAP (hardcoded, same as Login.ailang)
// =============================================================================
FixedPool.InstKeyMap {
    "table":  Initialize=0, CanChange=True
    "stable": Initialize=0, CanChange=True
}

Function.Inst_InitKeyMap {
    Body: {
        t = Allocate(128)
        MemorySet(t, 0, 128)
        s = Allocate(128)
        MemorySet(s, 0, 128)

        // Numbers (scancodes 2-11)
        SetByte(t, 2, 49)
        SetByte(t, 3, 50)
        SetByte(t, 4, 51)
        SetByte(t, 5, 52)
        SetByte(t, 6, 53)
        SetByte(t, 7, 54)
        SetByte(t, 8, 55)
        SetByte(t, 9, 56)
        SetByte(t, 10, 57)
        SetByte(t, 11, 48)

        // Shift+numbers
        SetByte(s, 2, 33)
        SetByte(s, 3, 64)
        SetByte(s, 4, 35)
        SetByte(s, 5, 36)
        SetByte(s, 6, 37)
        SetByte(s, 7, 94)
        SetByte(s, 8, 38)
        SetByte(s, 9, 42)
        SetByte(s, 10, 40)
        SetByte(s, 11, 41)

        // Minus, equals
        SetByte(t, 12, 45)
        SetByte(s, 12, 95)
        SetByte(t, 13, 61)
        SetByte(s, 13, 43)

        // QWERTY row (16-27)
        SetByte(t, 16, 113)
        SetByte(t, 17, 119)
        SetByte(t, 18, 101)
        SetByte(t, 19, 114)
        SetByte(t, 20, 116)
        SetByte(t, 21, 121)
        SetByte(t, 22, 117)
        SetByte(t, 23, 105)
        SetByte(t, 24, 111)
        SetByte(t, 25, 112)
        SetByte(t, 26, 91)
        SetByte(s, 26, 123)
        SetByte(t, 27, 93)
        SetByte(s, 27, 125)

        SetByte(s, 16, 81)
        SetByte(s, 17, 87)
        SetByte(s, 18, 69)
        SetByte(s, 19, 82)
        SetByte(s, 20, 84)
        SetByte(s, 21, 89)
        SetByte(s, 22, 85)
        SetByte(s, 23, 73)
        SetByte(s, 24, 79)
        SetByte(s, 25, 80)

        // ASDF row (30-41)
        SetByte(t, 30, 97)
        SetByte(t, 31, 115)
        SetByte(t, 32, 100)
        SetByte(t, 33, 102)
        SetByte(t, 34, 103)
        SetByte(t, 35, 104)
        SetByte(t, 36, 106)
        SetByte(t, 37, 107)
        SetByte(t, 38, 108)
        SetByte(t, 39, 59)
        SetByte(s, 39, 58)
        SetByte(t, 40, 39)
        SetByte(s, 40, 34)
        SetByte(t, 41, 96)
        SetByte(s, 41, 126)

        SetByte(s, 30, 65)
        SetByte(s, 31, 83)
        SetByte(s, 32, 68)
        SetByte(s, 33, 70)
        SetByte(s, 34, 71)
        SetByte(s, 35, 72)
        SetByte(s, 36, 74)
        SetByte(s, 37, 75)
        SetByte(s, 38, 76)

        // ZXCV row (43-54)
        SetByte(t, 43, 92)
        SetByte(s, 43, 124)
        SetByte(t, 44, 122)
        SetByte(t, 45, 120)
        SetByte(t, 46, 99)
        SetByte(t, 47, 118)
        SetByte(t, 48, 98)
        SetByte(t, 49, 110)
        SetByte(t, 50, 109)
        SetByte(t, 51, 44)
        SetByte(s, 51, 60)
        SetByte(t, 52, 46)
        SetByte(s, 52, 62)
        SetByte(t, 53, 47)
        SetByte(s, 53, 63)

        SetByte(s, 44, 90)
        SetByte(s, 45, 88)
        SetByte(s, 46, 67)
        SetByte(s, 47, 86)
        SetByte(s, 48, 66)
        SetByte(s, 49, 78)
        SetByte(s, 50, 77)

        // Space
        SetByte(t, 57, 32)
        SetByte(s, 57, 32)

        InstKeyMap.table  = t
        InstKeyMap.stable = s
    }
}

Function.Inst_TranslateKey {
    Input: scancode: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(scancode, 0) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterEqual(scancode, 128) ThenBlock: { ReturnValue(0) }

        use_shift = InstState.shift
        IfCondition EqualTo(InstState.caps, 1) ThenBlock: {
            ch_normal = GetByte(InstKeyMap.table, scancode)
            IfCondition And(GreaterEqual(ch_normal, 97), LessEqual(ch_normal, 122)) ThenBlock: {
                use_shift = Subtract(1, use_shift)
            }
        }

        IfCondition EqualTo(use_shift, 1) ThenBlock: {
            ReturnValue(GetByte(InstKeyMap.stable, scancode))
        }
        ReturnValue(GetByte(InstKeyMap.table, scancode))
    }
}

// =============================================================================
// INIT COLORS
// =============================================================================
Function.Inst_InitColors {
    Body: {
        InstColors.bg            = FB_RGB(20, 30, 50)
        InstColors.box_bg        = FB_RGB(35, 45, 70)
        InstColors.box_border    = FB_RGB(80, 120, 180)
        InstColors.input_bg      = FB_RGB(15, 15, 30)
        InstColors.input_border  = FB_RGB(70, 70, 120)
        InstColors.text          = FB_RGB(200, 200, 220)
        InstColors.title         = FB_RGB(255, 255, 255)
        InstColors.error         = FB_RGB(255, 80, 80)
        InstColors.cursor        = FB_RGB(180, 180, 255)
        InstColors.active_border = FB_RGB(100, 160, 255)
        InstColors.success       = FB_RGB(80, 220, 120)
        InstColors.progress      = FB_RGB(60, 140, 220)
    }
}

// =============================================================================
// DRAW STRING HELPER
// =============================================================================
Function.Inst_DrawStr {
    Input: buf:    Integer
    Input: stride: Integer
    Input: x:      Integer
    Input: y:      Integer
    Input: str:    Integer
    Body: {
        slen = StringLength(str)
        cx = x
        i = 0
        WhileLoop LessThan(i, slen) {
            ch = GetByte(str, i)
            TermFont_DrawCharFgBg(buf, stride, cx, y, ch)
            cx = Add(cx, 8)
            i = Add(i, 1)
        }
    }
}

// =============================================================================
// DRAW THE INSTALLER SCREEN
// =============================================================================
Function.Inst_Draw {
    Body: {
        fw = FB.width
        fh = FB.height

        FB_Clear(InstColors.bg)

        // Box: centered, 520x400
        box_w = 520
        box_h = 400
        box_x = Divide(Subtract(fw, box_w), 2)
        box_y = Divide(Subtract(fh, box_h), 2)

        FB_FillRect(box_x, box_y, box_w, box_h, InstColors.box_bg)
        FB_Rect(box_x, box_y, box_w, box_h, InstColors.box_border)

        dbuf = FB_GetDrawBuffer()
        stride = FB.width

        // Title
        title = "AILang OS Setup"
        tlen = StringLength(title)
        tx = Add(box_x, Divide(Subtract(box_w, Multiply(tlen, 8)), 2))
        ty = Add(box_y, 20)
        TermFont_SetColors(InstColors.title, InstColors.box_bg)
        Inst_DrawStr(dbuf, stride, tx, ty, title)

        // Phase 0: Input fields
        IfCondition EqualTo(InstState.phase, 0) ThenBlock: {
            // Subtitle
            subtitle = "Create your user account"
            slen = StringLength(subtitle)
            sx = Add(box_x, Divide(Subtract(box_w, Multiply(slen, 8)), 2))
            TermFont_SetColors(InstColors.text, InstColors.box_bg)
            Inst_DrawStr(dbuf, stride, sx, Add(ty, 24), subtitle)

            // Username label + input
            TermFont_SetColors(InstColors.text, InstColors.box_bg)
            Inst_DrawStr(dbuf, stride, Add(box_x, 40), Add(box_y, 80), "Username:")

            inp_x = Add(box_x, 40)
            inp_y = Add(box_y, 100)
            inp_w = Subtract(box_w, 80)
            inp_h = 24
            FB_FillRect(inp_x, inp_y, inp_w, inp_h, InstColors.input_bg)
            IfCondition EqualTo(InstState.active_field, InstConst.FIELD_USER) ThenBlock: {
                FB_Rect(inp_x, inp_y, inp_w, inp_h, InstColors.active_border)
            } ElseBlock: {
                FB_Rect(inp_x, inp_y, inp_w, inp_h, InstColors.input_border)
            }

            TermFont_SetColors(InstColors.text, InstColors.input_bg)
            ui = 0
            WhileLoop LessThan(ui, InstState.user_len) {
                ch = GetByte(InstState.user_buf, ui)
                TermFont_DrawCharFgBg(dbuf, stride, Add(Add(inp_x, 4), Multiply(ui, 8)), Add(inp_y, 4), ch)
                ui = Add(ui, 1)
            }
            IfCondition EqualTo(InstState.active_field, InstConst.FIELD_USER) ThenBlock: {
                cursor_x = Add(Add(inp_x, 4), Multiply(InstState.user_len, 8))
                FB_FillRect(cursor_x, Add(inp_y, 4), 2, 16, InstColors.cursor)
            }

            // Password label + input
            TermFont_SetColors(InstColors.text, InstColors.box_bg)
            Inst_DrawStr(dbuf, stride, Add(box_x, 40), Add(box_y, 145), "Password:")

            inp2_y = Add(box_y, 165)
            FB_FillRect(inp_x, inp2_y, inp_w, inp_h, InstColors.input_bg)
            IfCondition EqualTo(InstState.active_field, InstConst.FIELD_PASS) ThenBlock: {
                FB_Rect(inp_x, inp2_y, inp_w, inp_h, InstColors.active_border)
            } ElseBlock: {
                FB_Rect(inp_x, inp2_y, inp_w, inp_h, InstColors.input_border)
            }

            TermFont_SetColors(InstColors.text, InstColors.input_bg)
            pi = 0
            WhileLoop LessThan(pi, InstState.pass_len) {
                TermFont_DrawCharFgBg(dbuf, stride, Add(Add(inp_x, 4), Multiply(pi, 8)), Add(inp2_y, 4), InstConst.BULLET)
                pi = Add(pi, 1)
            }
            IfCondition EqualTo(InstState.active_field, InstConst.FIELD_PASS) ThenBlock: {
                cursor_x = Add(Add(inp_x, 4), Multiply(InstState.pass_len, 8))
                FB_FillRect(cursor_x, Add(inp2_y, 4), 2, 16, InstColors.cursor)
            }

            // Confirm password label + input
            TermFont_SetColors(InstColors.text, InstColors.box_bg)
            Inst_DrawStr(dbuf, stride, Add(box_x, 40), Add(box_y, 210), "Confirm Password:")

            inp3_y = Add(box_y, 230)
            FB_FillRect(inp_x, inp3_y, inp_w, inp_h, InstColors.input_bg)
            IfCondition EqualTo(InstState.active_field, InstConst.FIELD_CONFIRM) ThenBlock: {
                FB_Rect(inp_x, inp3_y, inp_w, inp_h, InstColors.active_border)
            } ElseBlock: {
                FB_Rect(inp_x, inp3_y, inp_w, inp_h, InstColors.input_border)
            }

            TermFont_SetColors(InstColors.text, InstColors.input_bg)
            ci = 0
            WhileLoop LessThan(ci, InstState.confirm_len) {
                TermFont_DrawCharFgBg(dbuf, stride, Add(Add(inp_x, 4), Multiply(ci, 8)), Add(inp3_y, 4), InstConst.BULLET)
                ci = Add(ci, 1)
            }
            IfCondition EqualTo(InstState.active_field, InstConst.FIELD_CONFIRM) ThenBlock: {
                cursor_x = Add(Add(inp_x, 4), Multiply(InstState.confirm_len, 8))
                FB_FillRect(cursor_x, Add(inp3_y, 4), 2, 16, InstColors.cursor)
            }

            // Hint
            TermFont_SetColors(InstColors.text, InstColors.box_bg)
            Inst_DrawStr(dbuf, stride, Add(box_x, 40), Add(box_y, 280), "[Tab] Next field   [Enter] Install")
        }

        // Phase 1: Installing
        IfCondition EqualTo(InstState.phase, 1) ThenBlock: {
            TermFont_SetColors(InstColors.progress, InstColors.box_bg)
            Inst_DrawStr(dbuf, stride, Add(box_x, 40), Add(box_y, 80), "Installing...")

            IfCondition NotEqual(InstState.status_msg, 0) ThenBlock: {
                TermFont_SetColors(InstColors.text, InstColors.box_bg)
                Inst_DrawStr(dbuf, stride, Add(box_x, 40), Add(box_y, 120), InstState.status_msg)
            }
        }

        // Phase 2: Done
        IfCondition EqualTo(InstState.phase, 2) ThenBlock: {
            IfCondition EqualTo(InstState.success, 1) ThenBlock: {
                TermFont_SetColors(InstColors.success, InstColors.box_bg)
                Inst_DrawStr(dbuf, stride, Add(box_x, 40), Add(box_y, 80), "Setup Complete!")

                TermFont_SetColors(InstColors.text, InstColors.box_bg)
                Inst_DrawStr(dbuf, stride, Add(box_x, 40), Add(box_y, 120), "Database configured, services registered,")
                Inst_DrawStr(dbuf, stride, Add(box_x, 40), Add(box_y, 140), "and user account created.")
                Inst_DrawStr(dbuf, stride, Add(box_x, 40), Add(box_y, 180), "The system will continue booting.")
                Inst_DrawStr(dbuf, stride, Add(box_x, 40), Add(box_y, 220), "[Enter] Continue")
            } ElseBlock: {
                TermFont_SetColors(InstColors.error, InstColors.box_bg)
                Inst_DrawStr(dbuf, stride, Add(box_x, 40), Add(box_y, 80), "Setup Failed")

                IfCondition NotEqual(InstState.error_msg, 0) ThenBlock: {
                    TermFont_SetColors(InstColors.text, InstColors.box_bg)
                    Inst_DrawStr(dbuf, stride, Add(box_x, 40), Add(box_y, 120), InstState.error_msg)
                }
                Inst_DrawStr(dbuf, stride, Add(box_x, 40), Add(box_y, 180), "[Enter] Continue (manual setup needed)")
            }
        }

        // Error message (phase 0 only)
        IfCondition EqualTo(InstState.phase, 0) ThenBlock: {
            IfCondition NotEqual(InstState.error_msg, 0) ThenBlock: {
                TermFont_SetColors(InstColors.error, InstColors.box_bg)
                emsg = InstState.error_msg
                elen = StringLength(emsg)
                ex = Add(box_x, Divide(Subtract(box_w, Multiply(elen, 8)), 2))
                Inst_DrawStr(dbuf, stride, ex, Add(box_y, 330), emsg)
            }
        }

        FB_FlipFast()
    }
}

// =============================================================================
// SEED ALL SERVICES — full list with /system/bin/ paths
// =============================================================================
Function.Inst_SeedAllServices {
    Input: conn: Integer
    Output: Integer
    Body: {
        PrintMessage("[INSTALLER] Seeding all services...\n")

        // Boot service: display_server (autostart)
        r = PG_Query(conn, "INSERT INTO services (name, display_name, binary_path, autostart, restart_policy, priority, service_type) VALUES ('display_server', 'Display Server', '/system/bin/display.x', true, 'always', 10, 'daemon') ON CONFLICT (name) DO UPDATE SET binary_path='/system/bin/display.x', autostart=true, restart_policy='always', priority=10")
        IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }

        // User apps
        r = PG_Query(conn, "INSERT INTO services (name, display_name, binary_path, enabled, priority) VALUES ('notepad', 'Notepad', '/system/bin/notepad.x', true, 10) ON CONFLICT (name) DO UPDATE SET binary_path='/system/bin/notepad.x', display_name='Notepad', priority=10")
        IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }

        r = PG_Query(conn, "INSERT INTO services (name, display_name, binary_path, enabled, priority) VALUES ('calculator', 'Calculator', '/system/bin/calc.x', true, 15) ON CONFLICT (name) DO UPDATE SET binary_path='/system/bin/calc.x', display_name='Calculator', priority=15")
        IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }

        r = PG_Query(conn, "INSERT INTO services (name, display_name, binary_path, enabled, priority) VALUES ('files', 'Files', 'internal:app.files', true, 20) ON CONFLICT (name) DO UPDATE SET display_name='Files', priority=20")
        IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }

        r = PG_Query(conn, "INSERT INTO services (name, display_name, binary_path, enabled, priority) VALUES ('canvas_demo', 'Canvas', '/system/bin/canvas_demo.x', true, 30) ON CONFLICT (name) DO UPDATE SET binary_path='/system/bin/canvas_demo.x', display_name='Canvas', priority=30")
        IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }

        r = PG_Query(conn, "INSERT INTO services (name, display_name, binary_path, enabled, priority) VALUES ('videoplayer', 'Video', '/system/bin/videoplayer.x', true, 35) ON CONFLICT (name) DO UPDATE SET binary_path='/system/bin/videoplayer.x', display_name='Video', priority=35")
        IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }

        r = PG_Query(conn, "INSERT INTO services (name, display_name, binary_path, enabled, priority) VALUES ('terminal', 'Terminal', '/system/bin/terminal.x', true, 40) ON CONFLICT (name) DO UPDATE SET binary_path='/system/bin/terminal.x', display_name='Terminal', priority=40")
        IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }

        r = PG_Query(conn, "INSERT INTO services (name, display_name, binary_path, enabled, priority) VALUES ('chrome', 'Chrome', '/system/bin/chrome.x', true, 40) ON CONFLICT (name) DO UPDATE SET binary_path='/system/bin/chrome.x', display_name='Chrome', priority=40")
        IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }

        r = PG_Query(conn, "INSERT INTO services (name, display_name, binary_path, enabled, priority) VALUES ('ladybird', 'Ladybird', '/system/bin/ladybird.x', true, 45) ON CONFLICT (name) DO UPDATE SET binary_path='/system/bin/ladybird.x', display_name='Ladybird', priority=45")
        IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }

        r = PG_Query(conn, "INSERT INTO services (name, display_name, binary_path, enabled, priority) VALUES ('browser', 'Browser', '/system/bin/browser.x', true, 50) ON CONFLICT (name) DO UPDATE SET binary_path='/system/bin/browser.x', display_name='Browser', priority=50")
        IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }

        r = PG_Query(conn, "INSERT INTO services (name, display_name, binary_path, enabled, priority) VALUES ('claude', 'Claude Code', '/system/bin/claude.x', true, 50) ON CONFLICT (name) DO UPDATE SET binary_path='/system/bin/claude.x', display_name='Claude Code', priority=50")
        IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }

        r = PG_Query(conn, "INSERT INTO services (name, display_name, binary_path, enabled, priority) VALUES ('grep', 'Grep Search', '/system/bin/grep.x', true, 50) ON CONFLICT (name) DO UPDATE SET binary_path='/system/bin/grep.x', display_name='Grep Search', priority=50")
        IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }

        r = PG_Query(conn, "INSERT INTO services (name, display_name, binary_path, enabled, priority) VALUES ('vscode', 'VS Code', '/system/bin/vscode.x', true, 50) ON CONFLICT (name) DO UPDATE SET binary_path='/system/bin/vscode.x', display_name='VS Code', priority=50")
        IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }

        r = PG_Query(conn, "INSERT INTO services (name, display_name, binary_path, enabled, priority) VALUES ('installer', 'Installer', '/system/bin/installer_ipc.x', true, 5) ON CONFLICT (name) DO UPDATE SET binary_path='/system/bin/installer_ipc.x', display_name='Installer', priority=5")
        IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }

        r = PG_Query(conn, "INSERT INTO services (name, display_name, binary_path, enabled, priority) VALUES ('wifi', 'WiFi Config', '/system/bin/wifi_ipc.x', true, 10) ON CONFLICT (name) DO UPDATE SET binary_path='/system/bin/wifi_ipc.x', display_name='WiFi Config', priority=10")
        IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }

        PrintMessage("[INSTALLER] All 15 services seeded\n")
        ReturnValue(1)
    }
}

// =============================================================================
// SEED PACKAGES — populate packages table for package manager
// =============================================================================
Function.Inst_SeedPackages {
    Input: conn: Integer
    Body: {
        PrintMessage("[INSTALLER] Seeding packages table...\n")

        r = PG_Query(conn, "INSERT INTO packages (name, display_name, category, binary_name, binary_path, html_config, priority, depends_on) VALUES ('display_server', 'Display Server', 'system', 'display.x', '/system/bin/display.x', NULL, 10, '') ON CONFLICT (name) DO UPDATE SET display_name='Display Server', category='system', priority=10")
        IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }

        r = PG_Query(conn, "INSERT INTO packages (name, display_name, category, binary_name, binary_path, html_config, priority, depends_on) VALUES ('installer', 'Installer', 'system', 'installer_ipc.x', '/system/bin/installer_ipc.x', 'installer.html', 5, 'display_server') ON CONFLICT (name) DO UPDATE SET display_name='Installer', category='system', priority=5")
        IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }

        r = PG_Query(conn, "INSERT INTO packages (name, display_name, category, binary_name, binary_path, html_config, priority, depends_on) VALUES ('notepad', 'Notepad', 'app', 'notepad.x', '/system/bin/notepad.x', 'notepad.html', 10, 'display_server') ON CONFLICT (name) DO UPDATE SET display_name='Notepad', priority=10")
        IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }

        r = PG_Query(conn, "INSERT INTO packages (name, display_name, category, binary_name, binary_path, html_config, priority, depends_on) VALUES ('calculator', 'Calculator', 'app', 'calc.x', '/system/bin/calc.x', 'calculator.html', 15, 'display_server') ON CONFLICT (name) DO UPDATE SET display_name='Calculator', priority=15")
        IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }

        r = PG_Query(conn, "INSERT INTO packages (name, display_name, category, binary_name, binary_path, html_config, priority, depends_on) VALUES ('files', 'Files', 'app', NULL, 'internal:app.files', 'filedialog.html', 20, 'display_server') ON CONFLICT (name) DO UPDATE SET display_name='Files', priority=20")
        IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }

        r = PG_Query(conn, "INSERT INTO packages (name, display_name, category, binary_name, binary_path, html_config, priority, depends_on) VALUES ('canvas_demo', 'Canvas', 'app', 'canvas_demo.x', '/system/bin/canvas_demo.x', 'canvas_demo.html', 30, 'display_server') ON CONFLICT (name) DO UPDATE SET display_name='Canvas', priority=30")
        IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }

        r = PG_Query(conn, "INSERT INTO packages (name, display_name, category, binary_name, binary_path, html_config, priority, depends_on) VALUES ('videoplayer', 'Video', 'app', 'videoplayer.x', '/system/bin/videoplayer.x', 'videoplayer.html', 35, 'display_server') ON CONFLICT (name) DO UPDATE SET display_name='Video', priority=35")
        IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }

        r = PG_Query(conn, "INSERT INTO packages (name, display_name, category, binary_name, binary_path, html_config, priority, depends_on) VALUES ('terminal', 'Terminal', 'app', 'terminal.x', '/system/bin/terminal.x', 'terminal.html', 40, 'display_server') ON CONFLICT (name) DO UPDATE SET display_name='Terminal', priority=40")
        IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }

        r = PG_Query(conn, "INSERT INTO packages (name, display_name, category, binary_name, binary_path, html_config, priority, depends_on) VALUES ('chrome', 'Chrome', 'app', 'chrome.x', '/system/bin/chrome.x', 'chrome.html', 40, 'display_server') ON CONFLICT (name) DO UPDATE SET display_name='Chrome', priority=40")
        IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }

        r = PG_Query(conn, "INSERT INTO packages (name, display_name, category, binary_name, binary_path, html_config, priority, depends_on) VALUES ('ladybird', 'Ladybird', 'app', 'ladybird.x', '/system/bin/ladybird.x', 'ladybird.html', 45, 'display_server') ON CONFLICT (name) DO UPDATE SET display_name='Ladybird', priority=45")
        IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }

        r = PG_Query(conn, "INSERT INTO packages (name, display_name, category, binary_name, binary_path, html_config, priority, depends_on) VALUES ('browser', 'Browser', 'app', 'browser.x', '/system/bin/browser.x', 'browser.html', 50, 'display_server') ON CONFLICT (name) DO UPDATE SET display_name='Browser', priority=50")
        IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }

        r = PG_Query(conn, "INSERT INTO packages (name, display_name, category, binary_name, binary_path, html_config, priority, depends_on) VALUES ('claude', 'Claude Code', 'app', 'claude.x', '/system/bin/claude.x', 'claude.html', 50, 'display_server') ON CONFLICT (name) DO UPDATE SET display_name='Claude Code', priority=50")
        IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }

        r = PG_Query(conn, "INSERT INTO packages (name, display_name, category, binary_name, binary_path, html_config, priority, depends_on) VALUES ('grep', 'Grep Search', 'app', 'grep.x', '/system/bin/grep.x', 'grep.html', 50, 'display_server') ON CONFLICT (name) DO UPDATE SET display_name='Grep Search', priority=50")
        IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }

        r = PG_Query(conn, "INSERT INTO packages (name, display_name, category, binary_name, binary_path, html_config, priority, depends_on) VALUES ('vscode', 'VS Code', 'app', 'vscode.x', '/system/bin/vscode.x', 'vscode.html', 50, 'display_server') ON CONFLICT (name) DO UPDATE SET display_name='VS Code', priority=50")
        IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }

        r = PG_Query(conn, "INSERT INTO packages (name, display_name, category, binary_name, binary_path, html_config, priority, depends_on) VALUES ('wifi', 'WiFi Config', 'app', 'wifi_ipc.x', '/system/bin/wifi_ipc.x', 'wifi.html', 10, 'display_server') ON CONFLICT (name) DO UPDATE SET display_name='WiFi Config', priority=10")
        IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }

        PrintMessage("[INSTALLER] 15 packages seeded\n")
    }
}

// =============================================================================
// CREATE USER — insert into users table with password
// =============================================================================
Function.Inst_CreateUser {
    Input: conn: Integer
    Output: Integer
    Body: {
        // Build SQL: INSERT INTO users (username, password_hash, display_name, is_admin)
        //            VALUES ('<user>', '<pass>', '<user>', true)
        //            ON CONFLICT (username) DO UPDATE SET password_hash='<pass>', is_admin=true

        // Null-terminate the buffers
        SetByte(InstState.user_buf, InstState.user_len, 0)
        SetByte(InstState.pass_buf, InstState.pass_len, 0)

        // Build query string piece by piece
        sql = Allocate(512)
        MemorySet(sql, 0, 512)

        prefix = "INSERT INTO users (username, password_hash, display_name, is_admin) VALUES ('"
        plen = StringLength(prefix)
        MemoryCopy(sql, prefix, plen)
        pos = plen

        // Username
        i = 0
        WhileLoop LessThan(i, InstState.user_len) {
            SetByte(sql, pos, GetByte(InstState.user_buf, i))
            pos = Add(pos, 1)
            i = Add(i, 1)
        }

        // Middle: ', '
        mid1 = "', '"
        m1len = StringLength(mid1)
        MemoryCopy(Add(sql, pos), mid1, m1len)
        pos = Add(pos, m1len)

        // Password (stored as plaintext for now — Schema uses password_hash column)
        i = 0
        WhileLoop LessThan(i, InstState.pass_len) {
            SetByte(sql, pos, GetByte(InstState.pass_buf, i))
            pos = Add(pos, 1)
            i = Add(i, 1)
        }

        // Middle: ', '
        mid2 = "', '"
        m2len = StringLength(mid2)
        MemoryCopy(Add(sql, pos), mid2, m2len)
        pos = Add(pos, m2len)

        // Display name (same as username)
        i = 0
        WhileLoop LessThan(i, InstState.user_len) {
            SetByte(sql, pos, GetByte(InstState.user_buf, i))
            pos = Add(pos, 1)
            i = Add(i, 1)
        }

        // Suffix
        suffix = "', true) ON CONFLICT (username) DO UPDATE SET password_hash='"
        slen = StringLength(suffix)
        MemoryCopy(Add(sql, pos), suffix, slen)
        pos = Add(pos, slen)

        // Password again for update
        i = 0
        WhileLoop LessThan(i, InstState.pass_len) {
            SetByte(sql, pos, GetByte(InstState.pass_buf, i))
            pos = Add(pos, 1)
            i = Add(i, 1)
        }

        // Final
        tail = "', is_admin=true"
        tlen = StringLength(tail)
        MemoryCopy(Add(sql, pos), tail, tlen)
        pos = Add(pos, tlen)
        SetByte(sql, pos, 0)

        PrintMessage("[INSTALLER] Creating user account\n")
        r = PG_Query(conn, sql)
        IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }

        Deallocate(sql, 512)

        // Also create home directory in files table
        homesql = Allocate(256)
        MemorySet(homesql, 0, 256)

        hp = "INSERT INTO files (parent_id, name, type, owner) SELECT f.id, '"
        hlen = StringLength(hp)
        MemoryCopy(homesql, hp, hlen)
        hpos = hlen

        // Username for home dir
        i = 0
        WhileLoop LessThan(i, InstState.user_len) {
            SetByte(homesql, hpos, GetByte(InstState.user_buf, i))
            hpos = Add(hpos, 1)
            i = Add(i, 1)
        }

        ht = "', 'dir', '"
        htlen = StringLength(ht)
        MemoryCopy(Add(homesql, hpos), ht, htlen)
        hpos = Add(hpos, htlen)

        // Owner = username
        i = 0
        WhileLoop LessThan(i, InstState.user_len) {
            SetByte(homesql, hpos, GetByte(InstState.user_buf, i))
            hpos = Add(hpos, 1)
            i = Add(i, 1)
        }

        hend = "' FROM files f WHERE f.name='home' AND f.parent_id=1 AND NOT EXISTS (SELECT 1 FROM files WHERE parent_id=f.id AND name='"
        helen = StringLength(hend)
        MemoryCopy(Add(homesql, hpos), hend, helen)
        hpos = Add(hpos, helen)

        // Username again for NOT EXISTS check
        i = 0
        WhileLoop LessThan(i, InstState.user_len) {
            SetByte(homesql, hpos, GetByte(InstState.user_buf, i))
            hpos = Add(hpos, 1)
            i = Add(i, 1)
        }

        hfinal = "')"
        hflen = StringLength(hfinal)
        MemoryCopy(Add(homesql, hpos), hfinal, hflen)
        hpos = Add(hpos, hflen)
        SetByte(homesql, hpos, 0)

        r = PG_Query(conn, homesql)
        IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }
        Deallocate(homesql, 256)

        PrintMessage("[INSTALLER] User account created\n")
        ReturnValue(1)
    }
}

// =============================================================================
// RUN INSTALLATION — connect to PG, bootstrap, seed, create user
// =============================================================================
Function.Inst_DoInstall {
    Output: Integer
    Body: {
        InstState.phase = 1
        InstState.status_msg = "Connecting to PostgreSQL..."
        Inst_Draw()

        conn = PG_Connect("127.0.0.1", 5432, "ailang_system", "bob", "")
        IfCondition EqualTo(conn, 0) ThenBlock: {
            PrintMessage("[INSTALLER] ERROR: Cannot connect to PostgreSQL\n")
            InstState.error_msg = "Cannot connect to PostgreSQL"
            ReturnValue(0)
        }

        // Bootstrap schema (tables + basic seed)
        InstState.status_msg = "Creating database tables..."
        Inst_Draw()
        Schema_Bootstrap(conn)

        // Seed all 14 services with correct paths
        InstState.status_msg = "Registering services..."
        Inst_Draw()
        Inst_SeedAllServices(conn)

        // Seed packages table for package manager
        InstState.status_msg = "Seeding package registry..."
        Inst_Draw()
        Inst_SeedPackages(conn)

        // Create user account
        InstState.status_msg = "Creating user account..."
        Inst_Draw()
        Inst_CreateUser(conn)

        // Seed default settings
        InstState.status_msg = "Writing system settings..."
        Inst_Draw()

        r = PG_Query(conn, "INSERT INTO settings VALUES ('system', 'hostname', 'ailang-os') ON CONFLICT (app_id, key) DO NOTHING")
        IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }
        r = PG_Query(conn, "INSERT INTO settings VALUES ('system', 'theme', 'dark') ON CONFLICT (app_id, key) DO NOTHING")
        IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }
        r = PG_Query(conn, "INSERT INTO settings VALUES ('display', 'font_size', '16') ON CONFLICT (app_id, key) DO NOTHING")
        IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }
        r = PG_Query(conn, "INSERT INTO settings VALUES ('display', 'font_name', 'DejaVuSans') ON CONFLICT (app_id, key) DO NOTHING")
        IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }

        PG_Disconnect(conn)

        PrintMessage("[INSTALLER] Installation complete\n")
        ReturnValue(1)
    }
}

// =============================================================================
// VALIDATE INPUT — check fields before install
// =============================================================================
Function.Inst_ValidateInput {
    Output: Integer
    Body: {
        // Username must be at least 1 char
        IfCondition LessThan(InstState.user_len, 1) ThenBlock: {
            InstState.error_msg = "Username cannot be empty"
            ReturnValue(0)
        }

        // Password must be at least 1 char
        IfCondition LessThan(InstState.pass_len, 1) ThenBlock: {
            InstState.error_msg = "Password cannot be empty"
            ReturnValue(0)
        }

        // Passwords must match
        IfCondition NotEqual(InstState.pass_len, InstState.confirm_len) ThenBlock: {
            InstState.error_msg = "Passwords do not match"
            ReturnValue(0)
        }

        i = 0
        WhileLoop LessThan(i, InstState.pass_len) {
            IfCondition NotEqual(GetByte(InstState.pass_buf, i), GetByte(InstState.confirm_buf, i)) ThenBlock: {
                InstState.error_msg = "Passwords do not match"
                ReturnValue(0)
            }
            i = Add(i, 1)
        }

        ReturnValue(1)
    }
}

// =============================================================================
// HANDLE KEY — process evdev scancode
// =============================================================================
Function.Inst_HandleKey {
    Input: scancode: Integer
    Input: value:    Integer
    Body: {
        // Key release
        IfCondition EqualTo(value, 0) ThenBlock: {
            IfCondition EqualTo(scancode, InstConst.KEY_LSHIFT) ThenBlock: { InstState.shift = 0 }
            IfCondition EqualTo(scancode, InstConst.KEY_RSHIFT) ThenBlock: { InstState.shift = 0 }
            ReturnValue(0)
        }

        // Modifiers
        IfCondition EqualTo(scancode, InstConst.KEY_LSHIFT) ThenBlock: {
            InstState.shift = 1
            ReturnValue(0)
        }
        IfCondition EqualTo(scancode, InstConst.KEY_RSHIFT) ThenBlock: {
            InstState.shift = 1
            ReturnValue(0)
        }
        IfCondition EqualTo(scancode, InstConst.KEY_CAPSLOCK) ThenBlock: {
            IfCondition EqualTo(value, InstConst.KEY_PRESS) ThenBlock: {
                InstState.caps = Subtract(1, InstState.caps)
            }
            ReturnValue(0)
        }

        // Phase 2 (done): Enter to continue
        IfCondition EqualTo(InstState.phase, 2) ThenBlock: {
            IfCondition EqualTo(scancode, InstConst.KEY_ENTER) ThenBlock: {
                InstState.done = 1
            }
            ReturnValue(0)
        }

        // Phase 1 (installing): ignore input
        IfCondition EqualTo(InstState.phase, 1) ThenBlock: {
            ReturnValue(0)
        }

        // Phase 0 (input):

        // Tab — cycle fields
        IfCondition EqualTo(scancode, InstConst.KEY_TAB) ThenBlock: {
            af = InstState.active_field
            af = Add(af, 1)
            IfCondition GreaterEqual(af, InstConst.NUM_FIELDS) ThenBlock: {
                af = 0
            }
            InstState.active_field = af
            ReturnValue(0)
        }

        // Enter — validate and install
        IfCondition EqualTo(scancode, InstConst.KEY_ENTER) ThenBlock: {
            valid = Inst_ValidateInput()
            IfCondition EqualTo(valid, 1) ThenBlock: {
                result = Inst_DoInstall()
                InstState.phase = 2
                InstState.success = result
            }
            ReturnValue(0)
        }

        // Backspace
        IfCondition EqualTo(scancode, InstConst.KEY_BACKSPACE) ThenBlock: {
            IfCondition EqualTo(InstState.active_field, InstConst.FIELD_USER) ThenBlock: {
                IfCondition GreaterThan(InstState.user_len, 0) ThenBlock: {
                    InstState.user_len = Subtract(InstState.user_len, 1)
                    SetByte(InstState.user_buf, InstState.user_len, 0)
                }
            }
            IfCondition EqualTo(InstState.active_field, InstConst.FIELD_PASS) ThenBlock: {
                IfCondition GreaterThan(InstState.pass_len, 0) ThenBlock: {
                    InstState.pass_len = Subtract(InstState.pass_len, 1)
                    SetByte(InstState.pass_buf, InstState.pass_len, 0)
                }
            }
            IfCondition EqualTo(InstState.active_field, InstConst.FIELD_CONFIRM) ThenBlock: {
                IfCondition GreaterThan(InstState.confirm_len, 0) ThenBlock: {
                    InstState.confirm_len = Subtract(InstState.confirm_len, 1)
                    SetByte(InstState.confirm_buf, InstState.confirm_len, 0)
                }
            }
            InstState.error_msg = 0
            ReturnValue(0)
        }

        // Printable character
        ch = Inst_TranslateKey(scancode)
        IfCondition GreaterThan(ch, 0) ThenBlock: {
            IfCondition EqualTo(InstState.active_field, InstConst.FIELD_USER) ThenBlock: {
                IfCondition LessThan(InstState.user_len, InstConst.MAX_USER) ThenBlock: {
                    SetByte(InstState.user_buf, InstState.user_len, ch)
                    InstState.user_len = Add(InstState.user_len, 1)
                }
            }
            IfCondition EqualTo(InstState.active_field, InstConst.FIELD_PASS) ThenBlock: {
                IfCondition LessThan(InstState.pass_len, InstConst.MAX_PASS) ThenBlock: {
                    SetByte(InstState.pass_buf, InstState.pass_len, ch)
                    InstState.pass_len = Add(InstState.pass_len, 1)
                }
            }
            IfCondition EqualTo(InstState.active_field, InstConst.FIELD_CONFIRM) ThenBlock: {
                IfCondition LessThan(InstState.confirm_len, InstConst.MAX_PASS) ThenBlock: {
                    SetByte(InstState.confirm_buf, InstState.confirm_len, ch)
                    InstState.confirm_len = Add(InstState.confirm_len, 1)
                }
            }
            InstState.error_msg = 0
        }
    }
}

// =============================================================================
// OPEN KEYBOARD — try /dev/input/event0..7, find real keyboard
// =============================================================================
Function.Inst_OpenKeyboard {
    Output: Integer
    Body: {
        path_buf = Allocate(32)
        keybits = Allocate(96)

        dev = 0
        WhileLoop LessThan(dev, 8) {
            prefix = "/dev/input/event"
            plen = StringLength(prefix)
            i = 0
            WhileLoop LessThan(i, plen) {
                SetByte(path_buf, i, GetByte(prefix, i))
                i = Add(i, 1)
            }
            SetByte(path_buf, plen, Add(48, dev))
            SetByte(path_buf, Add(plen, 1), 0)

            // O_RDONLY | O_NONBLOCK = 2048
            fd = SystemCall(InstSys.SYS_OPEN, path_buf, 2048, 0, 0, 0)
            IfCondition GreaterEqual(fd, 0) ThenBlock: {
                MemorySet(keybits, 0, 96)
                irc = SystemCall(InstSys.SYS_IOCTL, fd, 2153792801, keybits, 0, 0)

                // Check KEY_A (30): byte 3, bit 6 = mask 64
                has_key_a = BitwiseAnd(GetByte(keybits, 3), 64)
                IfCondition GreaterThan(has_key_a, 0) ThenBlock: {
                    PrintMessage("[INSTALLER] Opened keyboard: ")
                    PrintString(path_buf)
                    PrintMessage("\n")
                    Deallocate(keybits, 96)
                    Deallocate(path_buf, 32)
                    ReturnValue(fd)
                }

                SystemCall(InstSys.SYS_CLOSE, fd, 0, 0, 0, 0)
            }
            dev = Add(dev, 1)
        }

        Deallocate(keybits, 96)
        Deallocate(path_buf, 32)
        PrintMessage("[INSTALLER] WARNING: No keyboard found\n")
        ReturnValue(-1)
    }
}

// =============================================================================
// POLL KEYBOARD
// =============================================================================
Function.Inst_PollKeyboard {
    Output: Integer
    Body: {
        fd = InstState.kbd_fd
        IfCondition LessThan(fd, 0) ThenBlock: { ReturnValue(0) }

        evbuf = Allocate(24)
        count = 0

        WhileLoop 1 {
            n = SystemCall(InstSys.SYS_READ, fd, evbuf, 24, 0, 0)
            IfCondition NotEqual(n, 24) ThenBlock: { BreakLoop }

            ev_type = Add(GetByte(evbuf, 16), Multiply(GetByte(evbuf, 17), 256))
            ev_code = Add(GetByte(evbuf, 18), Multiply(GetByte(evbuf, 19), 256))
            ev_val  = Add(GetByte(evbuf, 20), Add(Multiply(GetByte(evbuf, 21), 256), Add(Multiply(GetByte(evbuf, 22), 65536), Multiply(GetByte(evbuf, 23), 16777216))))

            IfCondition EqualTo(ev_type, InstConst.EV_KEY) ThenBlock: {
                Inst_HandleKey(ev_code, ev_val)
                count = Add(count, 1)
            }
        }

        Deallocate(evbuf, 24)
        ReturnValue(count)
    }
}

// =============================================================================
// POLL STDIN — headless/serial mode
// =============================================================================
Function.Inst_PollStdin {
    Output: Integer
    Body: {
        rbuf = Allocate(1)
        n = SystemCall(InstSys.SYS_READ, 0, rbuf, 1, 0, 0)
        IfCondition LessEqual(n, 0) ThenBlock: {
            Deallocate(rbuf, 1)
            ReturnValue(0)
        }

        ch = GetByte(rbuf, 0)
        Deallocate(rbuf, 1)

        // Enter
        IfCondition EqualTo(ch, 10) ThenBlock: {
            Inst_HandleKey(InstConst.KEY_ENTER, 1)
            ReturnValue(1)
        }
        IfCondition EqualTo(ch, 13) ThenBlock: {
            Inst_HandleKey(InstConst.KEY_ENTER, 1)
            ReturnValue(1)
        }

        // Backspace
        IfCondition EqualTo(ch, 127) ThenBlock: {
            Inst_HandleKey(InstConst.KEY_BACKSPACE, 1)
            ReturnValue(1)
        }
        IfCondition EqualTo(ch, 8) ThenBlock: {
            Inst_HandleKey(InstConst.KEY_BACKSPACE, 1)
            ReturnValue(1)
        }

        // Tab
        IfCondition EqualTo(ch, 9) ThenBlock: {
            Inst_HandleKey(InstConst.KEY_TAB, 1)
            ReturnValue(1)
        }

        // Escape
        IfCondition EqualTo(ch, 27) ThenBlock: {
            InstState.done = 1
            ReturnValue(1)
        }

        // Printable char
        IfCondition And(GreaterEqual(ch, 32), LessEqual(ch, 126)) ThenBlock: {
            IfCondition EqualTo(InstState.active_field, InstConst.FIELD_USER) ThenBlock: {
                IfCondition LessThan(InstState.user_len, InstConst.MAX_USER) ThenBlock: {
                    SetByte(InstState.user_buf, InstState.user_len, ch)
                    InstState.user_len = Add(InstState.user_len, 1)
                }
            }
            IfCondition EqualTo(InstState.active_field, InstConst.FIELD_PASS) ThenBlock: {
                IfCondition LessThan(InstState.pass_len, InstConst.MAX_PASS) ThenBlock: {
                    SetByte(InstState.pass_buf, InstState.pass_len, ch)
                    InstState.pass_len = Add(InstState.pass_len, 1)
                }
            }
            IfCondition EqualTo(InstState.active_field, InstConst.FIELD_CONFIRM) ThenBlock: {
                IfCondition LessThan(InstState.confirm_len, InstConst.MAX_PASS) ThenBlock: {
                    SetByte(InstState.confirm_buf, InstState.confirm_len, ch)
                    InstState.confirm_len = Add(InstState.confirm_len, 1)
                }
            }
            InstState.error_msg = 0
        }

        ReturnValue(1)
    }
}

// =============================================================================
// INSTALLER RUN — main entry point
// Returns 1 on successful install, 0 on failure/cancel.
// =============================================================================
Function.Installer_Run {
    Output: Integer
    Body: {
        PrintMessage("[INSTALLER] Starting AILang OS Setup\n")

        // Allocate buffers
        InstState.user_buf    = Allocate(InstConst.MAX_USER)
        InstState.pass_buf    = Allocate(InstConst.MAX_PASS)
        InstState.confirm_buf = Allocate(InstConst.MAX_PASS)
        MemorySet(InstState.user_buf, 0, InstConst.MAX_USER)
        MemorySet(InstState.pass_buf, 0, InstConst.MAX_PASS)
        MemorySet(InstState.confirm_buf, 0, InstConst.MAX_PASS)
        InstState.user_len    = 0
        InstState.pass_len    = 0
        InstState.confirm_len = 0
        InstState.active_field = InstConst.FIELD_USER
        InstState.status_msg  = 0
        InstState.error_msg   = 0
        InstState.done        = 0
        InstState.phase       = 0
        InstState.success     = 0
        InstState.shift       = 0
        InstState.caps        = 0

        // Init subsystems
        Inst_InitColors()
        Inst_InitKeyMap()
        TermFont_Init()

        // Init framebuffer
        IfCondition EqualTo(InstState.headless, 1) ThenBlock: {
            FB_InitHeadless(1920, 1080)
        }
        rc = FB_InitDouble()
        IfCondition EqualTo(rc, 0) ThenBlock: {
            PrintMessage("[INSTALLER] ERROR: framebuffer init failed\n")
            ReturnValue(0)
        }

        // Open keyboard
        IfCondition EqualTo(InstState.headless, 0) ThenBlock: {
            InstState.kbd_fd = Inst_OpenKeyboard()
        }

        // 50ms sleep timespec
        ts = Allocate(16)
        StoreValue(ts, 0)
        StoreValue(Add(ts, 8), 50000000)

        // Main loop
        WhileLoop EqualTo(InstState.done, 0) {
            Inst_Draw()

            IfCondition EqualTo(InstState.headless, 1) ThenBlock: {
                Inst_PollStdin()
            } ElseBlock: {
                Inst_PollKeyboard()
            }

            SystemCall(InstSys.SYS_NANOSLEEP, ts, 0, 0, 0, 0)
        }

        Deallocate(ts, 16)

        // Cleanup
        IfCondition GreaterEqual(InstState.kbd_fd, 0) ThenBlock: {
            SystemCall(InstSys.SYS_CLOSE, InstState.kbd_fd, 0, 0, 0, 0)
        }
        FB_Close()
        Deallocate(InstKeyMap.table, 128)
        Deallocate(InstKeyMap.stable, 128)

        result = InstState.success

        // Secure: zero buffers
        MemorySet(InstState.pass_buf, 0, InstConst.MAX_PASS)
        MemorySet(InstState.confirm_buf, 0, InstConst.MAX_PASS)
        Deallocate(InstState.user_buf, InstConst.MAX_USER)
        Deallocate(InstState.pass_buf, InstConst.MAX_PASS)
        Deallocate(InstState.confirm_buf, InstConst.MAX_PASS)

        IfCondition EqualTo(result, 1) ThenBlock: {
            PrintMessage("[INSTALLER] Setup completed successfully\n")
        } ElseBlock: {
            PrintMessage("[INSTALLER] Setup cancelled or failed\n")
        }

        ReturnValue(result)
    }
}

// =============================================================================
// MAIN — standalone entry point
// =============================================================================
SubRoutine.Main {
    Arena_Init()
    result = Installer_Run()
    SystemCall(60, result, 0, 0, 0, 0)
}

RunTask(Main)
