// Login.ailang
// Framebuffer login screen for AILang OS.
// Draws username + password fields, reads keyboard, validates credentials.
// Validates against PG users table using pgcrypto bcrypt.
// Copyright © 2025 Sean Collins, 2 Paws Machine and Engineering. All rights reserved. SCSL.

LibraryImport.Arena
LibraryImport.StringUtils
LibraryImport.Socket
LibraryImport.Hash
LibraryImport.Arrays
LibraryImport.PostgreSQL_Complete
LibraryImport.Display.Render.Framebuffer
LibraryImport.TermFont

// =============================================================================
// STUB: DebugLog_Push (needed by Framebuffer library, no-op here)
// =============================================================================
Function.DebugLog_Push {
    Input: tag: Address
    Input: len: Integer
    Body: {
        ReturnValue(0)
    }
}

// =============================================================================
// SYSCALL CONSTANTS
// =============================================================================
FixedPool.LoginSys {
    "SYS_READ":      Initialize=0
    "SYS_WRITE":     Initialize=1
    "SYS_OPEN":      Initialize=2
    "SYS_CLOSE":     Initialize=3
    "SYS_IOCTL":     Initialize=16
    "SYS_NANOSLEEP": Initialize=35
}

FixedPool.LoginConst {
    "MAX_USER":     Initialize=32
    "MAX_PASS":     Initialize=64
    "FIELD_USER":   Initialize=0
    "FIELD_PASS":   Initialize=1
    "BULLET":       Initialize=42
    "EVDEV_SIZE":   Initialize=24
    "EV_KEY":       Initialize=1
    "KEY_PRESS":    Initialize=1
    "KEY_ENTER":    Initialize=28
    "KEY_BACKSPACE": Initialize=14
    "KEY_TAB":      Initialize=15
    "KEY_ESC":      Initialize=1
    "KEY_LSHIFT":   Initialize=42
    "KEY_RSHIFT":   Initialize=54
    "KEY_CAPSLOCK": Initialize=58
}

// =============================================================================
// LOGIN STATE
// =============================================================================
FixedPool.LoginState {
    "user_buf":     Initialize=0, CanChange=True
    "pass_buf":     Initialize=0, CanChange=True
    "user_len":     Initialize=0, CanChange=True
    "pass_len":     Initialize=0, CanChange=True
    "active_field": Initialize=0, CanChange=True
    "error_msg":    Initialize=0, CanChange=True
    "headless":     Initialize=0, CanChange=True
    "kbd_fd":       Initialize=-1, CanChange=True
    "shift":        Initialize=0, CanChange=True
    "caps":         Initialize=0, CanChange=True
    "done":         Initialize=0, CanChange=True
    "authenticated": Initialize=0, CanChange=True
    "use_stdin":    Initialize=0, CanChange=True
    "old_termios":  Initialize=0, CanChange=True
    "tty_fd":       Initialize=-1, CanChange=True
}

// =============================================================================
// COLORS
// =============================================================================
FixedPool.LoginColors {
    "bg":           Initialize=0, CanChange=True
    "box_bg":       Initialize=0, CanChange=True
    "box_border":   Initialize=0, CanChange=True
    "input_bg":     Initialize=0, CanChange=True
    "input_border": Initialize=0, CanChange=True
    "text":         Initialize=0, CanChange=True
    "title":        Initialize=0, CanChange=True
    "error":        Initialize=0, CanChange=True
    "cursor":       Initialize=0, CanChange=True
    "active_border": Initialize=0, CanChange=True
}

// =============================================================================
// SIMPLE SCANCODE → ASCII TABLE (hardcoded fallback, no config file needed)
// Covers keys needed for password entry: a-z, 0-9, common symbols
// =============================================================================
FixedPool.LoginKeyMap {
    "table":  Initialize=0, CanChange=True
    "stable": Initialize=0, CanChange=True
}

Function.Login_InitKeyMap {
    Body: {
        // Allocate normal + shift tables (128 entries each)
        t = Allocate(128)
        MemorySet(t, 0, 128)
        s = Allocate(128)
        MemorySet(s, 0, 128)

        // Row 1: numbers (scancodes 2-11 → '1'-'9','0')
        SetByte(t, 2, 49)    // 1
        SetByte(t, 3, 50)    // 2
        SetByte(t, 4, 51)    // 3
        SetByte(t, 5, 52)    // 4
        SetByte(t, 6, 53)    // 5
        SetByte(t, 7, 54)    // 6
        SetByte(t, 8, 55)    // 7
        SetByte(t, 9, 56)    // 8
        SetByte(t, 10, 57)   // 9
        SetByte(t, 11, 48)   // 0

        // Shift+numbers → symbols
        SetByte(s, 2, 33)    // !
        SetByte(s, 3, 64)    // @
        SetByte(s, 4, 35)    // #
        SetByte(s, 5, 36)    // $
        SetByte(s, 6, 37)    // %
        SetByte(s, 7, 94)    // ^
        SetByte(s, 8, 38)    // &
        SetByte(s, 9, 42)    // *
        SetByte(s, 10, 40)   // (
        SetByte(s, 11, 41)   // )

        // Row 1 extras: minus, equals
        SetByte(t, 12, 45)   // -
        SetByte(s, 12, 95)   // _
        SetByte(t, 13, 61)   // =
        SetByte(s, 13, 43)   // +

        // QWERTY row (scancodes 16-27)
        SetByte(t, 16, 113)  // q
        SetByte(t, 17, 119)  // w
        SetByte(t, 18, 101)  // e
        SetByte(t, 19, 114)  // r
        SetByte(t, 20, 116)  // t
        SetByte(t, 21, 121)  // y
        SetByte(t, 22, 117)  // u
        SetByte(t, 23, 105)  // i
        SetByte(t, 24, 111)  // o
        SetByte(t, 25, 112)  // p
        SetByte(t, 26, 91)   // [
        SetByte(s, 26, 123)  // {
        SetByte(t, 27, 93)   // ]
        SetByte(s, 27, 125)  // }

        // Shift QWERTY
        SetByte(s, 16, 81)   // Q
        SetByte(s, 17, 87)   // W
        SetByte(s, 18, 69)   // E
        SetByte(s, 19, 82)   // R
        SetByte(s, 20, 84)   // T
        SetByte(s, 21, 89)   // Y
        SetByte(s, 22, 85)   // U
        SetByte(s, 23, 73)   // I
        SetByte(s, 24, 79)   // O
        SetByte(s, 25, 80)   // P

        // ASDF row (scancodes 30-41)
        SetByte(t, 30, 97)   // a
        SetByte(t, 31, 115)  // s
        SetByte(t, 32, 100)  // d
        SetByte(t, 33, 102)  // f
        SetByte(t, 34, 103)  // g
        SetByte(t, 35, 104)  // h
        SetByte(t, 36, 106)  // j
        SetByte(t, 37, 107)  // k
        SetByte(t, 38, 108)  // l
        SetByte(t, 39, 59)   // ;
        SetByte(s, 39, 58)   // :
        SetByte(t, 40, 39)   // '
        SetByte(s, 40, 34)   // "
        SetByte(t, 41, 96)   // `
        SetByte(s, 41, 126)  // ~

        // Shift ASDF
        SetByte(s, 30, 65)   // A
        SetByte(s, 31, 83)   // S
        SetByte(s, 32, 68)   // D
        SetByte(s, 33, 70)   // F
        SetByte(s, 34, 71)   // G
        SetByte(s, 35, 72)   // H
        SetByte(s, 36, 74)   // J
        SetByte(s, 37, 75)   // K
        SetByte(s, 38, 76)   // L

        // ZXCV row (scancodes 43-54)
        SetByte(t, 43, 92)   // backslash
        SetByte(s, 43, 124)  // |
        SetByte(t, 44, 122)  // z
        SetByte(t, 45, 120)  // x
        SetByte(t, 46, 99)   // c
        SetByte(t, 47, 118)  // v
        SetByte(t, 48, 98)   // b
        SetByte(t, 49, 110)  // n
        SetByte(t, 50, 109)  // m
        SetByte(t, 51, 44)   // ,
        SetByte(s, 51, 60)   // <
        SetByte(t, 52, 46)   // .
        SetByte(s, 52, 62)   // >
        SetByte(t, 53, 47)   // /
        SetByte(s, 53, 63)   // ?

        // Shift ZXCV
        SetByte(s, 44, 90)   // Z
        SetByte(s, 45, 88)   // X
        SetByte(s, 46, 67)   // C
        SetByte(s, 47, 86)   // V
        SetByte(s, 48, 66)   // B
        SetByte(s, 49, 78)   // N
        SetByte(s, 50, 77)   // M

        // Space
        SetByte(t, 57, 32)   // space
        SetByte(s, 57, 32)   // space

        LoginKeyMap.table  = t
        LoginKeyMap.stable = s
    }
}

// Translate scancode to ASCII
Function.Login_TranslateKey {
    Input: scancode: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(scancode, 0) ThenBlock: { ReturnValue(0) }
        IfCondition GreaterEqual(scancode, 128) ThenBlock: { ReturnValue(0) }

        use_shift = LoginState.shift
        // Caps lock toggles case for letters
        IfCondition EqualTo(LoginState.caps, 1) ThenBlock: {
            ch_normal = GetByte(LoginKeyMap.table, scancode)
            IfCondition And(GreaterEqual(ch_normal, 97), LessEqual(ch_normal, 122)) ThenBlock: {
                use_shift = Subtract(1, use_shift)
            }
        }

        IfCondition EqualTo(use_shift, 1) ThenBlock: {
            ReturnValue(GetByte(LoginKeyMap.stable, scancode))
        }
        ReturnValue(GetByte(LoginKeyMap.table, scancode))
    }
}

// =============================================================================
// INIT COLORS
// =============================================================================
Function.Login_InitColors {
    Body: {
        LoginColors.bg           = FB_RGB(30, 40, 80)
        LoginColors.box_bg       = FB_RGB(50, 60, 100)
        LoginColors.box_border   = FB_RGB(150, 150, 200)
        LoginColors.input_bg     = FB_RGB(20, 25, 50)
        LoginColors.input_border = FB_RGB(100, 100, 160)
        LoginColors.text         = FB_RGB(220, 220, 240)
        LoginColors.title        = FB_RGB(255, 255, 255)
        LoginColors.error        = FB_RGB(255, 80, 80)
        LoginColors.cursor       = FB_RGB(200, 200, 255)
        LoginColors.active_border = FB_RGB(180, 180, 240)
    }
}

// =============================================================================
// DRAW STRING HELPER — render a null-terminated string at (x, y)
// =============================================================================
Function.Login_DrawStr {
    Input: buf:    Integer
    Input: stride: Integer
    Input: x:      Integer
    Input: y:      Integer
    Input: str:    Integer
    Body: {
        slen = StringLength(str)
        cx = x
        i = 0
        WhileLoop LessThan(i, slen) {
            ch = GetByte(str, i)
            TermFont_DrawCharFgBg(buf, stride, cx, y, ch)
            cx = Add(cx, 8)
            i = Add(i, 1)
        }
    }
}

// =============================================================================
// DRAW THE LOGIN SCREEN
// =============================================================================
Function.Login_Draw {
    Body: {
        fw = FB.width
        fh = FB.height

        // Clear background
        FB_Clear(LoginColors.bg)

        // Login box: centered, 480x300
        box_w = 480
        box_h = 300
        box_x = Divide(Subtract(fw, box_w), 2)
        box_y = Divide(Subtract(fh, box_h), 2)

        // Box background + border
        FB_FillRect(box_x, box_y, box_w, box_h, LoginColors.box_bg)
        FB_Rect(box_x, box_y, box_w, box_h, LoginColors.box_border)

        // Get draw buffer for text rendering
        dbuf = FB_GetDrawBuffer()
        stride = Divide(FB.pitch, 4)

        // Title: "AILang OS" centered at top of box
        title = "AILang OS"
        tlen = StringLength(title)
        tx = Add(box_x, Divide(Subtract(box_w, Multiply(tlen, 8)), 2))
        ty = Add(box_y, 20)
        TermFont_SetColors(LoginColors.title, LoginColors.box_bg)
        Login_DrawStr(dbuf, stride, tx, ty, title)

        // Subtitle
        subtitle = "Enter credentials to continue"
        slen = StringLength(subtitle)
        sx = Add(box_x, Divide(Subtract(box_w, Multiply(slen, 8)), 2))
        TermFont_SetColors(LoginColors.text, LoginColors.box_bg)
        Login_DrawStr(dbuf, stride, sx, Add(ty, 24), subtitle)

        // Username label
        TermFont_SetColors(LoginColors.text, LoginColors.box_bg)
        Login_DrawStr(dbuf, stride, Add(box_x, 40), Add(box_y, 80), "Username:")

        // Username input box
        inp_x = Add(box_x, 40)
        inp_y = Add(box_y, 100)
        inp_w = Subtract(box_w, 80)
        inp_h = 24
        FB_FillRect(inp_x, inp_y, inp_w, inp_h, LoginColors.input_bg)
        IfCondition EqualTo(LoginState.active_field, LoginConst.FIELD_USER) ThenBlock: {
            FB_Rect(inp_x, inp_y, inp_w, inp_h, LoginColors.active_border)
        } ElseBlock: {
            FB_Rect(inp_x, inp_y, inp_w, inp_h, LoginColors.input_border)
        }

        // Draw username text
        TermFont_SetColors(LoginColors.text, LoginColors.input_bg)
        ulen = LoginState.user_len
        ui = 0
        WhileLoop LessThan(ui, ulen) {
            ch = GetByte(LoginState.user_buf, ui)
            TermFont_DrawCharFgBg(dbuf, stride, Add(Add(inp_x, 4), Multiply(ui, 8)), Add(inp_y, 4), ch)
            ui = Add(ui, 1)
        }
        // Cursor
        IfCondition EqualTo(LoginState.active_field, LoginConst.FIELD_USER) ThenBlock: {
            cursor_x = Add(Add(inp_x, 4), Multiply(ulen, 8))
            FB_FillRect(cursor_x, Add(inp_y, 4), 2, 16, LoginColors.cursor)
        }

        // Password label
        TermFont_SetColors(LoginColors.text, LoginColors.box_bg)
        Login_DrawStr(dbuf, stride, Add(box_x, 40), Add(box_y, 140), "Password:")

        // Password input box
        inp2_y = Add(box_y, 160)
        FB_FillRect(inp_x, inp2_y, inp_w, inp_h, LoginColors.input_bg)
        IfCondition EqualTo(LoginState.active_field, LoginConst.FIELD_PASS) ThenBlock: {
            FB_Rect(inp_x, inp2_y, inp_w, inp_h, LoginColors.active_border)
        } ElseBlock: {
            FB_Rect(inp_x, inp2_y, inp_w, inp_h, LoginColors.input_border)
        }

        // Draw password bullets
        TermFont_SetColors(LoginColors.text, LoginColors.input_bg)
        plen = LoginState.pass_len
        pi = 0
        WhileLoop LessThan(pi, plen) {
            TermFont_DrawCharFgBg(dbuf, stride, Add(Add(inp_x, 4), Multiply(pi, 8)), Add(inp2_y, 4), LoginConst.BULLET)
            pi = Add(pi, 1)
        }
        // Cursor
        IfCondition EqualTo(LoginState.active_field, LoginConst.FIELD_PASS) ThenBlock: {
            cursor_x = Add(Add(inp_x, 4), Multiply(plen, 8))
            FB_FillRect(cursor_x, Add(inp2_y, 4), 2, 16, LoginColors.cursor)
        }

        // Hint: [Tab] to switch fields, [Enter] to login
        TermFont_SetColors(LoginColors.text, LoginColors.box_bg)
        Login_DrawStr(dbuf, stride, Add(box_x, 40), Add(box_y, 210), "[Tab] Switch field   [Enter] Login")

        // Error message (if any)
        IfCondition NotEqual(LoginState.error_msg, 0) ThenBlock: {
            TermFont_SetColors(LoginColors.error, LoginColors.box_bg)
            emsg = LoginState.error_msg
            elen = StringLength(emsg)
            ex = Add(box_x, Divide(Subtract(box_w, Multiply(elen, 8)), 2))
            Login_DrawStr(dbuf, stride, ex, Add(box_y, 250), emsg)
        }

        // Flip to screen
        FB_FlipFast()
    }
}

// =============================================================================
// SQL ESCAPE HELPER — copy buffer contents into SQL query, doubling single quotes
// Appends escaped content from src (length srclen) into dest at offset.
// Returns new offset.
// =============================================================================
Function.Login_SqlEscape {
    Input: dest: Address
    Input: off: Integer
    Input: src: Address
    Input: srclen: Integer
    Output: Integer
    Body: {
        i = 0
        pos = off
        WhileLoop LessThan(i, srclen) {
            ch = GetByte(src, i)
            IfCondition EqualTo(ch, 39) ThenBlock: {
                // Single quote (39) → two single quotes
                SetByte(dest, pos, 39)
                pos = Add(pos, 1)
                SetByte(dest, pos, 39)
                pos = Add(pos, 1)
            } ElseBlock: {
                SetByte(dest, pos, ch)
                pos = Add(pos, 1)
            }
            i = Add(i, 1)
        }
        ReturnValue(pos)
    }
}

// =============================================================================
// VALIDATE CREDENTIALS — PostgreSQL bcrypt validation via pgcrypto
// Connects to PG as bob (superuser, trust auth), queries:
//   SELECT id FROM users WHERE username = '<user>'
//     AND password_hash = crypt('<pass>', password_hash)
// Returns 1 if valid, 0 if not.
// =============================================================================
Function.Login_Validate {
    Output: Integer
    Body: {
        user = LoginState.user_buf
        pass = LoginState.pass_buf
        ulen = LoginState.user_len
        plen = LoginState.pass_len

        // Basic sanity — empty fields fail immediately
        IfCondition EqualTo(ulen, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(plen, 0) ThenBlock: { ReturnValue(0) }

        // Connect to PostgreSQL (localhost, trust auth as bob superuser)
        conn = PG_Connect("127.0.0.1", 5432, "ailang_system", "bob", "")
        IfCondition EqualTo(conn, 0) ThenBlock: {
            PrintMessage("[LOGIN] ERROR: Cannot connect to PostgreSQL\n")
            ReturnValue(0)
        }

        // Build query: SELECT id FROM users WHERE username = '...' AND password_hash = crypt('...', password_hash)
        // Max query size: ~256 bytes base + escaped user (64) + escaped pass (128) = 512 is safe
        qbuf = Allocate(512)
        pos = 0

        // "SELECT id FROM users WHERE username = '"
        prefix = "SELECT id FROM users WHERE username = '"
        pxlen = StringLength(prefix)
        i = 0
        WhileLoop LessThan(i, pxlen) {
            SetByte(qbuf, pos, GetByte(prefix, i))
            pos = Add(pos, 1)
            i = Add(i, 1)
        }

        // Escaped username
        pos = Login_SqlEscape(qbuf, pos, user, ulen)

        // "' AND password_hash = crypt('"
        mid = "' AND password_hash = crypt('"
        mlen = StringLength(mid)
        i = 0
        WhileLoop LessThan(i, mlen) {
            SetByte(qbuf, pos, GetByte(mid, i))
            pos = Add(pos, 1)
            i = Add(i, 1)
        }

        // Escaped password
        pos = Login_SqlEscape(qbuf, pos, pass, plen)

        // "', password_hash)"
        suffix = "', password_hash)"
        slen = StringLength(suffix)
        i = 0
        WhileLoop LessThan(i, slen) {
            SetByte(qbuf, pos, GetByte(suffix, i))
            pos = Add(pos, 1)
            i = Add(i, 1)
        }

        // Null-terminate
        SetByte(qbuf, pos, 0)

        // Execute query
        result = PG_Query(conn, qbuf)
        Deallocate(qbuf, 512)

        // Check result: if we got at least 1 row, credentials are valid
        valid = 0
        IfCondition NotEqual(result, 0) ThenBlock: {
            row_count = Array.Size(result)
            IfCondition GreaterThan(row_count, 0) ThenBlock: {
                valid = 1
            }
            PG_DestroyResult(result)
        }

        // Disconnect
        PG_Disconnect(conn)

        IfCondition EqualTo(valid, 1) ThenBlock: {
            PrintMessage("[LOGIN] PG auth: credentials valid\n")
        } ElseBlock: {
            PrintMessage("[LOGIN] PG auth: credentials invalid\n")
        }

        ReturnValue(valid)
    }
}

// =============================================================================
// HANDLE A KEY EVENT — process evdev scancode
// =============================================================================
Function.Login_HandleKey {
    Input: scancode: Integer
    Input: value:    Integer
    Body: {
        // Key release
        IfCondition EqualTo(value, 0) ThenBlock: {
            IfCondition EqualTo(scancode, LoginConst.KEY_LSHIFT) ThenBlock: { LoginState.shift = 0 }
            IfCondition EqualTo(scancode, LoginConst.KEY_RSHIFT) ThenBlock: { LoginState.shift = 0 }
            ReturnValue(0)
        }

        // Key press or repeat
        // Modifier keys
        IfCondition EqualTo(scancode, LoginConst.KEY_LSHIFT) ThenBlock: {
            LoginState.shift = 1
            ReturnValue(0)
        }
        IfCondition EqualTo(scancode, LoginConst.KEY_RSHIFT) ThenBlock: {
            LoginState.shift = 1
            ReturnValue(0)
        }
        IfCondition EqualTo(scancode, LoginConst.KEY_CAPSLOCK) ThenBlock: {
            IfCondition EqualTo(value, LoginConst.KEY_PRESS) ThenBlock: {
                LoginState.caps = Subtract(1, LoginState.caps)
            }
            ReturnValue(0)
        }

        // Tab — switch fields
        IfCondition EqualTo(scancode, LoginConst.KEY_TAB) ThenBlock: {
            IfCondition EqualTo(LoginState.active_field, LoginConst.FIELD_USER) ThenBlock: {
                LoginState.active_field = LoginConst.FIELD_PASS
            } ElseBlock: {
                LoginState.active_field = LoginConst.FIELD_USER
            }
            ReturnValue(0)
        }

        // Enter — attempt login
        IfCondition EqualTo(scancode, LoginConst.KEY_ENTER) ThenBlock: {
            valid = Login_Validate()
            IfCondition EqualTo(valid, 1) ThenBlock: {
                LoginState.authenticated = 1
                LoginState.done = 1
            } ElseBlock: {
                LoginState.error_msg = "Invalid username or password"
                // Clear password on failed attempt
                MemorySet(LoginState.pass_buf, 0, LoginConst.MAX_PASS)
                LoginState.pass_len = 0
            }
            ReturnValue(0)
        }

        // Backspace
        IfCondition EqualTo(scancode, LoginConst.KEY_BACKSPACE) ThenBlock: {
            IfCondition EqualTo(LoginState.active_field, LoginConst.FIELD_USER) ThenBlock: {
                IfCondition GreaterThan(LoginState.user_len, 0) ThenBlock: {
                    LoginState.user_len = Subtract(LoginState.user_len, 1)
                    SetByte(LoginState.user_buf, LoginState.user_len, 0)
                }
            } ElseBlock: {
                IfCondition GreaterThan(LoginState.pass_len, 0) ThenBlock: {
                    LoginState.pass_len = Subtract(LoginState.pass_len, 1)
                    SetByte(LoginState.pass_buf, LoginState.pass_len, 0)
                }
            }
            LoginState.error_msg = 0
            ReturnValue(0)
        }

        // Printable character — translate and append
        ch = Login_TranslateKey(scancode)
        IfCondition GreaterThan(ch, 0) ThenBlock: {
            IfCondition EqualTo(LoginState.active_field, LoginConst.FIELD_USER) ThenBlock: {
                IfCondition LessThan(LoginState.user_len, LoginConst.MAX_USER) ThenBlock: {
                    SetByte(LoginState.user_buf, LoginState.user_len, ch)
                    LoginState.user_len = Add(LoginState.user_len, 1)
                }
            } ElseBlock: {
                IfCondition LessThan(LoginState.pass_len, LoginConst.MAX_PASS) ThenBlock: {
                    SetByte(LoginState.pass_buf, LoginState.pass_len, ch)
                    LoginState.pass_len = Add(LoginState.pass_len, 1)
                }
            }
            LoginState.error_msg = 0
        }
    }
}

// =============================================================================
// TERMIOS RAW MODE — for stdin/console keyboard input
// Mirrors TUI library approach: disable ICANON+ECHO, set VMIN=0 VTIME=0
// for non-blocking character-at-a-time reads from fd 0.
// termios struct: 60 bytes on x86-64 Linux
//   c_iflag: offset 0  (4 bytes)
//   c_oflag: offset 4  (4 bytes)
//   c_cflag: offset 8  (4 bytes)
//   c_lflag: offset 12 (4 bytes)
//   c_line:  offset 16 (1 byte)
//   c_cc:    offset 17 (19 bytes)
// TCGETS=21505, TCSETS=21506
// =============================================================================
Function.Login_EnableRawMode {
    Body: {
        // Open /dev/tty0 explicitly — /dev/console (fd 0) may not support reads
        // O_RDWR = 2
        tfd = SystemCall(LoginSys.SYS_OPEN, "/dev/tty0", 2, 0, 0, 0)
        IfCondition LessThan(tfd, 0) ThenBlock: {
            // Try /dev/tty1 as fallback
            tfd = SystemCall(LoginSys.SYS_OPEN, "/dev/tty1", 2, 0, 0, 0)
        }
        IfCondition LessThan(tfd, 0) ThenBlock: {
            // Last resort: try /dev/console
            tfd = SystemCall(LoginSys.SYS_OPEN, "/dev/console", 2, 0, 0, 0)
        }
        IfCondition LessThan(tfd, 0) ThenBlock: {
            PrintMessage("[LOGIN] ERROR: Cannot open any tty device\n")
            ReturnValue(0)
        }
        LoginState.tty_fd = tfd
        PrintMessage("[LOGIN] Opened tty fd=")
        PrintNumber(tfd)
        PrintMessage("\n")

        // Save old termios from the tty
        old_t = Allocate(60)
        LoginState.old_termios = old_t
        result = SystemCall(LoginSys.SYS_IOCTL, tfd, 21505, old_t, 0, 0)
        IfCondition LessThan(result, 0) ThenBlock: {
            PrintMessage("[LOGIN] WARNING: TCGETS failed on tty\n")
            ReturnValue(0)
        }

        // Copy to new termios
        new_t = Allocate(60)
        i = 0
        WhileLoop LessThan(i, 60) {
            SetByte(new_t, i, GetByte(old_t, i))
            i = Add(i, 1)
        }

        // Read c_lflag (4 bytes at offset 12)
        lflag_b0 = GetByte(new_t, 12)
        lflag_b1 = GetByte(new_t, 13)
        lflag_b2 = GetByte(new_t, 14)
        lflag_b3 = GetByte(new_t, 15)
        lflag = Add(lflag_b0, Add(Multiply(lflag_b1, 256), Add(Multiply(lflag_b2, 65536), Multiply(lflag_b3, 16777216))))

        // Clear ICANON (2) + ECHO (8) + ISIG (1) = 11
        lflag = BitwiseAnd(lflag, BitwiseNot(11))

        // Write back c_lflag
        SetByte(new_t, 12, BitwiseAnd(lflag, 255))
        SetByte(new_t, 13, BitwiseAnd(Divide(lflag, 256), 255))
        SetByte(new_t, 14, BitwiseAnd(Divide(lflag, 65536), 255))
        SetByte(new_t, 15, BitwiseAnd(Divide(lflag, 16777216), 255))

        // Set VMIN=0 VTIME=0 for non-blocking reads (c_cc starts at offset 17)
        // VMIN = c_cc[6] = offset 23, VTIME = c_cc[5] = offset 22
        SetByte(new_t, 23, 0)   // VMIN = 0 (don't block)
        SetByte(new_t, 22, 0)   // VTIME = 0 (no timeout)

        // Apply raw mode to the tty
        SystemCall(LoginSys.SYS_IOCTL, tfd, 21506, new_t, 0, 0)
        Deallocate(new_t, 60)

        // NOTE: We do NOT set KD_GRAPHICS here because it prevents the kernel
        // from delivering keyboard input to the tty. With ECHO+ICANON disabled,
        // the VT won't echo typed characters back to the framebuffer anyway.

        PrintMessage("[LOGIN] Raw mode enabled on tty fd=")
        PrintNumber(tfd)
        PrintMessage("\n")
        ReturnValue(1)
    }
}

Function.Login_DisableRawMode {
    Body: {
        tfd = LoginState.tty_fd
        IfCondition GreaterEqual(tfd, 0) ThenBlock: {
            // Restore original termios
            IfCondition NotEqual(LoginState.old_termios, 0) ThenBlock: {
                SystemCall(LoginSys.SYS_IOCTL, tfd, 21506, LoginState.old_termios, 0, 0)
                Deallocate(LoginState.old_termios, 60)
                LoginState.old_termios = 0
            }

            // Close the tty fd
            SystemCall(LoginSys.SYS_CLOSE, tfd, 0, 0, 0, 0)
            LoginState.tty_fd = -1
        }
        ReturnValue(0)
    }
}

// =============================================================================
// OPEN KEYBOARD — try evdev first, fall back to stdin/console
// =============================================================================
Function.Login_OpenKeyboard {
    Output: Integer
    Body: {
        // Try event0 through event19, find the REAL keyboard
        path_buf = Allocate(32)
        keybits = Allocate(96)

        dev = 0
        WhileLoop LessThan(dev, 20) {
            // Build "/dev/input/event0" .. "/dev/input/event19"
            prefix = "/dev/input/event"
            plen = 16
            i = 0
            WhileLoop LessThan(i, plen) {
                SetByte(path_buf, i, GetByte(prefix, i))
                i = Add(i, 1)
            }
            IfCondition LessThan(dev, 10) ThenBlock: {
                SetByte(path_buf, plen, Add(48, dev))
                SetByte(path_buf, Add(plen, 1), 0)
            }
            IfCondition GreaterEqual(dev, 10) ThenBlock: {
                tens = Divide(dev, 10)
                ones = Subtract(dev, Multiply(tens, 10))
                SetByte(path_buf, plen, Add(48, tens))
                SetByte(path_buf, Add(plen, 1), Add(48, ones))
                SetByte(path_buf, Add(plen, 2), 0)
            }

            // Open non-blocking: O_RDONLY | O_NONBLOCK = 0 | 2048 = 2048
            fd = SystemCall(LoginSys.SYS_OPEN, path_buf, 2048, 0, 0, 0)
            IfCondition GreaterEqual(fd, 0) ThenBlock: {
                // Probe: EVIOCGBIT(EV_KEY, 96) = 0x80604521 = 2153792801
                MemorySet(keybits, 0, 96)
                irc = SystemCall(LoginSys.SYS_IOCTL, fd, 2153792801, keybits, 0, 0)

                // Check KEY_A (30): byte 3, bit 6 → mask 64
                has_key_a = BitwiseAnd(GetByte(keybits, 3), 64)
                IfCondition GreaterThan(has_key_a, 0) ThenBlock: {
                    PrintMessage("[LOGIN] Opened evdev keyboard: ")
                    PrintString(path_buf)
                    PrintMessage("\n")
                    Deallocate(keybits, 96)
                    Deallocate(path_buf, 32)
                    LoginState.use_stdin = 0
                    ReturnValue(fd)
                }

                SystemCall(LoginSys.SYS_CLOSE, fd, 0, 0, 0, 0)
            }
            dev = Add(dev, 1)
        }

        Deallocate(keybits, 96)
        Deallocate(path_buf, 32)
        PrintMessage("[LOGIN] No evdev keyboard found — using console/stdin\n")

        // Fall back to stdin (fd 0) — raw mode already enabled by caller
        LoginState.use_stdin = 1
        ReturnValue(-1)
    }
}

// =============================================================================
// POLL KEYBOARD — read evdev events, dispatch to Login_HandleKey
// Returns number of events processed.
// =============================================================================
Function.Login_PollKeyboard {
    Output: Integer
    Body: {
        fd = LoginState.kbd_fd
        IfCondition LessThan(fd, 0) ThenBlock: {
            // No keyboard — try to find one (hot-plug recovery)
            LoginState.kbd_fd = Login_OpenKeyboard()
            ReturnValue(0)
        }

        evbuf = Allocate(24)
        count = 0
        bad_fd = 0

        // Read events in a loop (non-blocking)
        WhileLoop 1 {
            n = SystemCall(LoginSys.SYS_READ, fd, evbuf, 24, 0, 0)
            IfCondition NotEqual(n, 24) ThenBlock: {
                // n = -11 (EAGAIN) is normal for non-blocking, just no data
                // n = -19 (ENODEV) or other negative = device gone
                IfCondition LessThan(n, -1) ThenBlock: {
                    IfCondition NotEqual(n, -11) ThenBlock: {
                        bad_fd = 1
                    }
                }
                BreakLoop
            }

            // Parse event
            ev_type = Add(GetByte(evbuf, 16), Multiply(GetByte(evbuf, 17), 256))
            ev_code = Add(GetByte(evbuf, 18), Multiply(GetByte(evbuf, 19), 256))
            ev_val  = Add(GetByte(evbuf, 20), Add(Multiply(GetByte(evbuf, 21), 256), Add(Multiply(GetByte(evbuf, 22), 65536), Multiply(GetByte(evbuf, 23), 16777216))))

            // Only handle EV_KEY events
            IfCondition EqualTo(ev_type, LoginConst.EV_KEY) ThenBlock: {
                Login_HandleKey(ev_code, ev_val)
                count = Add(count, 1)
            }
        }

        Deallocate(evbuf, 24)

        // If device disappeared (USB replug), close and re-scan next frame
        IfCondition EqualTo(bad_fd, 1) ThenBlock: {
            PrintMessage("[LOGIN] Keyboard device lost — will re-scan\n")
            SystemCall(LoginSys.SYS_CLOSE, fd, 0, 0, 0, 0)
            LoginState.kbd_fd = -1
        }

        ReturnValue(count)
    }
}

// =============================================================================
// STDIN INPUT — raw mode, non-blocking (VMIN=0, VTIME=0)
// Used both as headless fallback and as primary console input.
// read() returns 0 when no data available (non-blocking via VMIN=0).
// =============================================================================
Function.Login_PollStdin {
    Output: Integer
    Body: {
        rbuf = Allocate(1)
        count = 0
        rfd = LoginState.tty_fd
        IfCondition LessThan(rfd, 0) ThenBlock: {
            rfd = 0
        }

        // Read chars in a loop (non-blocking: VMIN=0 returns 0 when empty)
        WhileLoop 1 {
            n = SystemCall(LoginSys.SYS_READ, rfd, rbuf, 1, 0, 0)
            IfCondition LessEqual(n, 0) ThenBlock: {
                BreakLoop
            }

            ch = GetByte(rbuf, 0)
            count = Add(count, 1)

            // Enter (10 = newline, 13 = CR)
            IfCondition EqualTo(ch, 10) ThenBlock: {
                Login_HandleKey(LoginConst.KEY_ENTER, 1)
            }
            IfCondition EqualTo(ch, 13) ThenBlock: {
                Login_HandleKey(LoginConst.KEY_ENTER, 1)
            }

            // Backspace (127 or 8)
            IfCondition EqualTo(ch, 127) ThenBlock: {
                Login_HandleKey(LoginConst.KEY_BACKSPACE, 1)
            }
            IfCondition EqualTo(ch, 8) ThenBlock: {
                Login_HandleKey(LoginConst.KEY_BACKSPACE, 1)
            }

            // Tab
            IfCondition EqualTo(ch, 9) ThenBlock: {
                Login_HandleKey(LoginConst.KEY_TAB, 1)
            }

            // Printable char — directly append (stdin gives us ASCII already)
            IfCondition And(GreaterEqual(ch, 32), LessEqual(ch, 126)) ThenBlock: {
                IfCondition EqualTo(LoginState.active_field, LoginConst.FIELD_USER) ThenBlock: {
                    IfCondition LessThan(LoginState.user_len, LoginConst.MAX_USER) ThenBlock: {
                        SetByte(LoginState.user_buf, LoginState.user_len, ch)
                        LoginState.user_len = Add(LoginState.user_len, 1)
                    }
                } ElseBlock: {
                    IfCondition LessThan(LoginState.pass_len, LoginConst.MAX_PASS) ThenBlock: {
                        SetByte(LoginState.pass_buf, LoginState.pass_len, ch)
                        LoginState.pass_len = Add(LoginState.pass_len, 1)
                    }
                }
                LoginState.error_msg = 0
            }
        }

        Deallocate(rbuf, 1)
        ReturnValue(count)
    }
}

// =============================================================================
// LOGIN RUN — main entry point
// Opens framebuffer, draws login screen, processes input, validates.
// Returns 1 on successful login, 0 on failure/escape.
// =============================================================================
Function.Login_Run {
    Output: Integer
    Body: {
        PrintMessage("[LOGIN] Starting login screen\n")

        // Allocate input buffers
        LoginState.user_buf = Allocate(LoginConst.MAX_USER)
        LoginState.pass_buf = Allocate(LoginConst.MAX_PASS)
        MemorySet(LoginState.user_buf, 0, LoginConst.MAX_USER)
        MemorySet(LoginState.pass_buf, 0, LoginConst.MAX_PASS)
        LoginState.user_len = 0
        LoginState.pass_len = 0
        LoginState.active_field = LoginConst.FIELD_USER
        LoginState.error_msg = 0
        LoginState.done = 0
        LoginState.authenticated = 0
        LoginState.shift = 0
        LoginState.caps = 0

        // Init colors, keymap, font
        Login_InitColors()
        Login_InitKeyMap()
        TermFont_Init()

        // Init framebuffer
        IfCondition EqualTo(LoginState.headless, 1) ThenBlock: {
            FB_InitHeadless(1920, 1080)
        }
        rc = FB_InitDouble()
        IfCondition EqualTo(rc, 0) ThenBlock: {
            PrintMessage("[LOGIN] ERROR: framebuffer init failed\n")
            ReturnValue(0)
        }

        // Enable raw mode on /dev/tty0 — disables ECHO+ICANON so the VT
        // doesn't render typed characters over our framebuffer, and gives us
        // non-blocking character-at-a-time reads.
        Login_EnableRawMode()

        // Use tty input (stdin path reads from tty_fd)
        // Evdev is unreliable at early boot before USB enumeration completes.
        LoginState.use_stdin = 1

        // Allocate timespec for 50ms sleep
        ts = Allocate(16)
        StoreValue(ts, 0)
        StoreValue(Add(ts, 8), 50000000)

        // Main loop
        WhileLoop EqualTo(LoginState.done, 0) {
            // Draw
            Login_Draw()

            // Poll input — evdev or stdin depending on what was found
            IfCondition EqualTo(LoginState.use_stdin, 1) ThenBlock: {
                Login_PollStdin()
            } ElseBlock: {
                Login_PollKeyboard()
            }

            // Sleep 50ms to avoid busy-waiting
            SystemCall(LoginSys.SYS_NANOSLEEP, ts, 0, 0, 0, 0)
        }

        Deallocate(ts, 16)

        // Cleanup
        IfCondition GreaterEqual(LoginState.kbd_fd, 0) ThenBlock: {
            SystemCall(LoginSys.SYS_CLOSE, LoginState.kbd_fd, 0, 0, 0, 0)
        }
        // Restore terminal if we used raw mode
        Login_DisableRawMode()
        FB_Close()
        Deallocate(LoginKeyMap.table, 128)
        Deallocate(LoginKeyMap.stable, 128)

        result = LoginState.authenticated

        // Secure: zero out password buffer before freeing
        MemorySet(LoginState.pass_buf, 0, LoginConst.MAX_PASS)
        Deallocate(LoginState.user_buf, LoginConst.MAX_USER)
        Deallocate(LoginState.pass_buf, LoginConst.MAX_PASS)

        IfCondition EqualTo(result, 1) ThenBlock: {
            PrintMessage("[LOGIN] Authentication successful\n")
        } ElseBlock: {
            PrintMessage("[LOGIN] Login cancelled\n")
        }

        ReturnValue(result)
    }
}

// =============================================================================
// MAIN — standalone entry point
// Exit code 0 = authenticated, 1 = failed/cancelled
// =============================================================================
SubRoutine.Main {
    Arena_Init()
    result = Login_Run()
    IfCondition EqualTo(result, 1) ThenBlock: {
        SystemCall(60, 0, 0, 0, 0, 0)
    }
    SystemCall(60, 1, 0, 0, 0, 0)
}

RunTask(Main)
