        ReturnValue(0)
    }
}

// =============================================================================
// SEED: Light theme — proof-of-concept light color scheme
// =============================================================================
Function.Schema_SeedThemeLight {
    Input: conn: Address
    Body: {
        // Desktop / window backgrounds
        r = PG_Query(conn, "INSERT INTO theme_values VALUES ('light','desktop_bg','0xFFD8DDE8') ON CONFLICT (theme_name,key) DO NOTHING")
        IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }
        r = PG_Query(conn, "INSERT INTO theme_values VALUES ('light','window_bg','0xFFEEF0F4') ON CONFLICT (theme_name,key) DO NOTHING")
