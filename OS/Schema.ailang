// Schema.ailang
// Single source of truth for all AILang OS database schema.
// All DDL is idempotent (IF NOT EXISTS / ADD COLUMN IF NOT EXISTS).
// All seed data uses ON CONFLICT to be re-runnable.
// Copyright © 2025 Sean Collins, 2 Paws Machine and Engineering. All rights reserved. SCSL.

LibraryImport.Arena
LibraryImport.Socket
LibraryImport.Hash
LibraryImport.Arrays
LibraryImport.StringUtils
LibraryImport.PostgreSQL_Complete

// =============================================================================
// SCHEMA BOOTSTRAP — called by Init after PG is ready
// Creates all tables, adds columns, seeds default data.
// =============================================================================
Function.Schema_Bootstrap {
    Input: conn: Integer
    Output: Integer
    Body: {
        PrintMessage("[SCHEMA] Bootstrapping database schema...\n")

        // =====================================================================
        // TABLE: services — what to launch and how
        // =====================================================================
        r = PG_Query(conn, "CREATE TABLE IF NOT EXISTS services (id SERIAL PRIMARY KEY, name TEXT NOT NULL UNIQUE)")
        IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }

        r = PG_Query(conn, "ALTER TABLE services ADD COLUMN IF NOT EXISTS display_name TEXT")
        IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }
        r = PG_Query(conn, "ALTER TABLE services ADD COLUMN IF NOT EXISTS binary_path TEXT")
        IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }
        r = PG_Query(conn, "ALTER TABLE services ADD COLUMN IF NOT EXISTS args TEXT DEFAULT ''")
        IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }
        r = PG_Query(conn, "ALTER TABLE services ADD COLUMN IF NOT EXISTS autostart BOOLEAN DEFAULT false")
        IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }
        r = PG_Query(conn, "ALTER TABLE services ADD COLUMN IF NOT EXISTS restart_policy TEXT DEFAULT 'never'")
        IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }
        r = PG_Query(conn, "ALTER TABLE services ADD COLUMN IF NOT EXISTS depends_on TEXT DEFAULT ''")
        IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }
        r = PG_Query(conn, "ALTER TABLE services ADD COLUMN IF NOT EXISTS run_as TEXT DEFAULT 'root'")
        IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }
        r = PG_Query(conn, "ALTER TABLE services ADD COLUMN IF NOT EXISTS priority INTEGER DEFAULT 50")
        IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }
        r = PG_Query(conn, "ALTER TABLE services ADD COLUMN IF NOT EXISTS enabled BOOLEAN DEFAULT true")
        IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }
        r = PG_Query(conn, "ALTER TABLE services ADD COLUMN IF NOT EXISTS service_type TEXT DEFAULT 'daemon'")
        IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }
        r = PG_Query(conn, "ALTER TABLE services ADD COLUMN IF NOT EXISTS env_vars TEXT DEFAULT ''")
        IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }
        r = PG_Query(conn, "ALTER TABLE services ADD COLUMN IF NOT EXISTS icon_name TEXT DEFAULT ''")
        IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }

        PrintMessage("[SCHEMA]   services table OK\n")

        // =====================================================================
        // TABLE: files — virtual filesystem tree (PG is the directory index)
        // =====================================================================
        r = PG_Query(conn, "CREATE TABLE IF NOT EXISTS files (id BIGSERIAL PRIMARY KEY, parent_id BIGINT, name TEXT NOT NULL)")
        IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }

        r = PG_Query(conn, "ALTER TABLE files ADD COLUMN IF NOT EXISTS type TEXT DEFAULT 'file'")
        IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }
        r = PG_Query(conn, "ALTER TABLE files ADD COLUMN IF NOT EXISTS blob_uuid TEXT")
        IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }
        r = PG_Query(conn, "ALTER TABLE files ADD COLUMN IF NOT EXISTS blob_size BIGINT DEFAULT 0")
        IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }
        r = PG_Query(conn, "ALTER TABLE files ADD COLUMN IF NOT EXISTS permissions INTEGER DEFAULT 420")
        IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }
        r = PG_Query(conn, "ALTER TABLE files ADD COLUMN IF NOT EXISTS owner TEXT DEFAULT 'root'")
        IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }
        r = PG_Query(conn, "ALTER TABLE files ADD COLUMN IF NOT EXISTS grp TEXT DEFAULT 'root'")
        IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }
        r = PG_Query(conn, "ALTER TABLE files ADD COLUMN IF NOT EXISTS created_at BIGINT DEFAULT 0")
        IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }
        r = PG_Query(conn, "ALTER TABLE files ADD COLUMN IF NOT EXISTS modified_at BIGINT DEFAULT 0")
        IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }
        r = PG_Query(conn, "ALTER TABLE files ADD COLUMN IF NOT EXISTS link_target TEXT")
        IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }
        r = PG_Query(conn, "ALTER TABLE files ADD COLUMN IF NOT EXISTS metadata TEXT")
        IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }

        r = PG_Query(conn, "CREATE INDEX IF NOT EXISTS idx_files_parent ON files(parent_id)")
        IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }
        r = PG_Query(conn, "CREATE INDEX IF NOT EXISTS idx_files_blob ON files(blob_uuid)")
        IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }

        PrintMessage("[SCHEMA]   files table OK\n")

        // =====================================================================
        // TABLE: users — authentication and privileges
        // =====================================================================
        r = PG_Query(conn, "CREATE TABLE IF NOT EXISTS users (id SERIAL PRIMARY KEY, username TEXT NOT NULL UNIQUE)")
        IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }

        r = PG_Query(conn, "ALTER TABLE users ADD COLUMN IF NOT EXISTS password_hash TEXT")
        IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }
        r = PG_Query(conn, "ALTER TABLE users ADD COLUMN IF NOT EXISTS display_name TEXT")
        IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }
        r = PG_Query(conn, "ALTER TABLE users ADD COLUMN IF NOT EXISTS home_dir_id BIGINT")
        IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }
        r = PG_Query(conn, "ALTER TABLE users ADD COLUMN IF NOT EXISTS shell TEXT DEFAULT '/system/bin/terminal.x'")
        IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }
        r = PG_Query(conn, "ALTER TABLE users ADD COLUMN IF NOT EXISTS is_admin BOOLEAN DEFAULT false")
        IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }
        r = PG_Query(conn, "ALTER TABLE users ADD COLUMN IF NOT EXISTS created_at BIGINT DEFAULT 0")
        IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }
        r = PG_Query(conn, "ALTER TABLE users ADD COLUMN IF NOT EXISTS last_login BIGINT DEFAULT 0")
        IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }

        PrintMessage("[SCHEMA]   users table OK\n")

        // =====================================================================
        // TABLE: sessions — active login tracking
        // =====================================================================
        r = PG_Query(conn, "CREATE TABLE IF NOT EXISTS sessions (id SERIAL PRIMARY KEY, user_id INTEGER)")
        IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }

        r = PG_Query(conn, "ALTER TABLE sessions ADD COLUMN IF NOT EXISTS started_at BIGINT DEFAULT 0")
        IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }
        r = PG_Query(conn, "ALTER TABLE sessions ADD COLUMN IF NOT EXISTS last_active BIGINT DEFAULT 0")
        IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }
        r = PG_Query(conn, "ALTER TABLE sessions ADD COLUMN IF NOT EXISTS tty TEXT")
        IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }
        r = PG_Query(conn, "ALTER TABLE sessions ADD COLUMN IF NOT EXISTS active BOOLEAN DEFAULT true")
        IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }

        PrintMessage("[SCHEMA]   sessions table OK\n")

        // =====================================================================
        // TABLE: settings — system and app configuration (key-value)
        // =====================================================================
        r = PG_Query(conn, "CREATE TABLE IF NOT EXISTS settings (app_id TEXT, key TEXT, value TEXT, PRIMARY KEY (app_id, key))")
        IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }

        PrintMessage("[SCHEMA]   settings table OK\n")

        // =====================================================================
        // TABLE: service_status — runtime state (PIDs, health)
        // =====================================================================
        r = PG_Query(conn, "CREATE TABLE IF NOT EXISTS service_status (service_name TEXT PRIMARY KEY)")
        IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }

        r = PG_Query(conn, "ALTER TABLE service_status ADD COLUMN IF NOT EXISTS pid INTEGER DEFAULT 0")
        IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }
        r = PG_Query(conn, "ALTER TABLE service_status ADD COLUMN IF NOT EXISTS state TEXT DEFAULT 'stopped'")
        IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }
        r = PG_Query(conn, "ALTER TABLE service_status ADD COLUMN IF NOT EXISTS started_at BIGINT DEFAULT 0")
        IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }
        r = PG_Query(conn, "ALTER TABLE service_status ADD COLUMN IF NOT EXISTS exit_code INTEGER DEFAULT 0")
        IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }
        r = PG_Query(conn, "ALTER TABLE service_status ADD COLUMN IF NOT EXISTS restart_count INTEGER DEFAULT 0")
        IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }

        PrintMessage("[SCHEMA]   service_status table OK\n")

        // =====================================================================
        // TABLE: packages — package manager registry
        // =====================================================================
        r = PG_Query(conn, "CREATE TABLE IF NOT EXISTS packages (name TEXT PRIMARY KEY)")
        IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }

        r = PG_Query(conn, "ALTER TABLE packages ADD COLUMN IF NOT EXISTS display_name TEXT")
        IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }
        r = PG_Query(conn, "ALTER TABLE packages ADD COLUMN IF NOT EXISTS version TEXT DEFAULT '1.0'")
        IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }
        r = PG_Query(conn, "ALTER TABLE packages ADD COLUMN IF NOT EXISTS category TEXT DEFAULT 'app'")
        IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }
        r = PG_Query(conn, "ALTER TABLE packages ADD COLUMN IF NOT EXISTS binary_name TEXT")
        IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }
        r = PG_Query(conn, "ALTER TABLE packages ADD COLUMN IF NOT EXISTS binary_path TEXT")
        IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }
        r = PG_Query(conn, "ALTER TABLE packages ADD COLUMN IF NOT EXISTS html_config TEXT")
        IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }
        r = PG_Query(conn, "ALTER TABLE packages ADD COLUMN IF NOT EXISTS has_binary BOOLEAN DEFAULT false")
        IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }
        r = PG_Query(conn, "ALTER TABLE packages ADD COLUMN IF NOT EXISTS has_config BOOLEAN DEFAULT false")
        IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }
        r = PG_Query(conn, "ALTER TABLE packages ADD COLUMN IF NOT EXISTS has_service BOOLEAN DEFAULT false")
        IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }
        r = PG_Query(conn, "ALTER TABLE packages ADD COLUMN IF NOT EXISTS installed BOOLEAN DEFAULT false")
        IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }
        r = PG_Query(conn, "ALTER TABLE packages ADD COLUMN IF NOT EXISTS depends_on TEXT DEFAULT ''")
        IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }
        r = PG_Query(conn, "ALTER TABLE packages ADD COLUMN IF NOT EXISTS priority INTEGER DEFAULT 50")
        IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }
        r = PG_Query(conn, "ALTER TABLE packages ADD COLUMN IF NOT EXISTS enabled BOOLEAN DEFAULT true")
        IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }

        PrintMessage("[SCHEMA]   packages table OK\n")

        // =====================================================================
        // TABLE: themes — theme package registry
        // =====================================================================
        r = PG_Query(conn, "CREATE TABLE IF NOT EXISTS themes (name TEXT PRIMARY KEY, display_name TEXT, description TEXT DEFAULT '')")
        IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }

        PrintMessage("[SCHEMA]   themes table OK\n")

        // =====================================================================
        // TABLE: theme_values — key/value pairs per theme
        // =====================================================================
        r = PG_Query(conn, "CREATE TABLE IF NOT EXISTS theme_values (theme_name TEXT NOT NULL, key TEXT NOT NULL, value TEXT NOT NULL, PRIMARY KEY (theme_name, key))")
        IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }

        PrintMessage("[SCHEMA]   theme_values table OK\n")

        // =====================================================================
        // SEED DATA
        // =====================================================================
        Schema_SeedData(conn)

        PrintMessage("[SCHEMA] Bootstrap complete.\n")
        ReturnValue(1)
    }
}

// =============================================================================
// SEED DATA — filesystem root, admin user, settings, themes
// Services are registered by the Installer — NOT seeded here.
// =============================================================================
Function.Schema_SeedData {
    Input: conn: Integer
    Body: {
        PrintMessage("[SCHEMA] Seeding default data...\n")

        // --- Root filesystem hierarchy ---
        r = PG_Query(conn, "INSERT INTO files (id, parent_id, name, type) VALUES (1, NULL, '/', 'dir') ON CONFLICT (id) DO NOTHING")
        IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }

        r = PG_Query(conn, "INSERT INTO files (parent_id, name, type) SELECT 1, 'home', 'dir' WHERE NOT EXISTS (SELECT 1 FROM files WHERE parent_id=1 AND name='home')")
        IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }
        r = PG_Query(conn, "INSERT INTO files (parent_id, name, type) SELECT 1, 'system', 'dir' WHERE NOT EXISTS (SELECT 1 FROM files WHERE parent_id=1 AND name='system')")
        IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }
        r = PG_Query(conn, "INSERT INTO files (parent_id, name, type) SELECT 1, 'data', 'dir' WHERE NOT EXISTS (SELECT 1 FROM files WHERE parent_id=1 AND name='data')")
        IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }
        r = PG_Query(conn, "INSERT INTO files (parent_id, name, type) SELECT 1, 'tmp', 'dir' WHERE NOT EXISTS (SELECT 1 FROM files WHERE parent_id=1 AND name='tmp')")
        IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }

        // /home/bob
        r = PG_Query(conn, "INSERT INTO files (parent_id, name, type) SELECT f.id, 'bob', 'dir' FROM files f WHERE f.name='home' AND f.parent_id=1 AND NOT EXISTS (SELECT 1 FROM files WHERE parent_id=f.id AND name='bob')")
        IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }

        // /system/bin
        r = PG_Query(conn, "INSERT INTO files (parent_id, name, type) SELECT f.id, 'bin', 'dir' FROM files f WHERE f.name='system' AND f.parent_id=1 AND NOT EXISTS (SELECT 1 FROM files WHERE parent_id=f.id AND name='bin')")
        IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }

        PrintMessage("[SCHEMA]   filesystem seeded\n")

        // --- Admin user ---
        r = PG_Query(conn, "INSERT INTO users (username, display_name, is_admin) VALUES ('bob', 'Bob', true) ON CONFLICT (username) DO UPDATE SET is_admin=true")
        IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }

        PrintMessage("[SCHEMA]   admin user seeded\n")

        // --- Default settings ---
        r = PG_Query(conn, "INSERT INTO settings VALUES ('system', 'hostname', 'ailang-os') ON CONFLICT (app_id, key) DO NOTHING")
        IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }
        r = PG_Query(conn, "INSERT INTO settings VALUES ('system', 'theme', 'dark') ON CONFLICT (app_id, key) DO NOTHING")
        IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }
        r = PG_Query(conn, "INSERT INTO settings VALUES ('display', 'font_size', '16') ON CONFLICT (app_id, key) DO NOTHING")
        IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }
        r = PG_Query(conn, "INSERT INTO settings VALUES ('display', 'font_name', 'DejaVuSans') ON CONFLICT (app_id, key) DO NOTHING")
        IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }
        r = PG_Query(conn, "INSERT INTO settings VALUES ('display', 'wallpaper_path', '/system/media/wallpapers/workbench-grid.png') ON CONFLICT (app_id, key) DO NOTHING")
        IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }
        r = PG_Query(conn, "INSERT INTO settings VALUES ('display', 'wallpaper_mode', 'tile') ON CONFLICT (app_id, key) DO NOTHING")
        IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }

        PrintMessage("[SCHEMA]   settings seeded\n")

        // --- Default themes ---
        r = PG_Query(conn, "INSERT INTO themes VALUES ('dark', 'Workbench Reborn', 'Default dark theme') ON CONFLICT (name) DO NOTHING")
        IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }
        r = PG_Query(conn, "INSERT INTO themes VALUES ('light', 'Daylight', 'Light theme') ON CONFLICT (name) DO NOTHING")
        IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }

        // Seed dark theme values (all current defaults)
        Schema_SeedThemeDark(conn)

        // Seed light theme values
        Schema_SeedThemeLight(conn)

        PrintMessage("[SCHEMA]   themes seeded\n")
    }
}

// =============================================================================
// SEED: Dark theme — all current default values
// =============================================================================
Function.Schema_SeedThemeDark {
    Input: conn: Address
    Body: {
        // Desktop / window backgrounds
        r = PG_Query(conn, "INSERT INTO theme_values VALUES ('dark','desktop_bg','0xFF0A1020') ON CONFLICT (theme_name,key) DO NOTHING")
        IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }
        r = PG_Query(conn, "INSERT INTO theme_values VALUES ('dark','window_bg','0xFF0E1730') ON CONFLICT (theme_name,key) DO NOTHING")
        IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }
        r = PG_Query(conn, "INSERT INTO theme_values VALUES ('dark','dialog_bg','0xFF16223F') ON CONFLICT (theme_name,key) DO NOTHING")
        IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }
        r = PG_Query(conn, "INSERT INTO theme_values VALUES ('dark','panel_bg','0xFF0E1730') ON CONFLICT (theme_name,key) DO NOTHING")
        IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }
        r = PG_Query(conn, "INSERT INTO theme_values VALUES ('dark','terminal_bg','0xFF060912') ON CONFLICT (theme_name,key) DO NOTHING")
        IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }

        // Borders
        r = PG_Query(conn, "INSERT INTO theme_values VALUES ('dark','border','0xFF2A4068') ON CONFLICT (theme_name,key) DO NOTHING")
        IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }

        // Text
        r = PG_Query(conn, "INSERT INTO theme_values VALUES ('dark','text_fg','0xFFE8EEF8') ON CONFLICT (theme_name,key) DO NOTHING")
        IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }
        r = PG_Query(conn, "INSERT INTO theme_values VALUES ('dark','text_bg','0xFF0E1730') ON CONFLICT (theme_name,key) DO NOTHING")
        IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }
        r = PG_Query(conn, "INSERT INTO theme_values VALUES ('dark','text_secondary','0xFF7A8AAA') ON CONFLICT (theme_name,key) DO NOTHING")
        IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }
        r = PG_Query(conn, "INSERT INTO theme_values VALUES ('dark','text_disabled','0xFF4A5A72') ON CONFLICT (theme_name,key) DO NOTHING")
        IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }
        r = PG_Query(conn, "INSERT INTO theme_values VALUES ('dark','text_light','0xFFE8EEF8') ON CONFLICT (theme_name,key) DO NOTHING")
        IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }

        // Toolbar
        r = PG_Query(conn, "INSERT INTO theme_values VALUES ('dark','toolbar_bg','0xFF0E1730') ON CONFLICT (theme_name,key) DO NOTHING")
        IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }
        r = PG_Query(conn, "INSERT INTO theme_values VALUES ('dark','toolbar_close_bg','0xFFCC3355') ON CONFLICT (theme_name,key) DO NOTHING")
        IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }
        r = PG_Query(conn, "INSERT INTO theme_values VALUES ('dark','toolbar_close_fg','0xFFE8EEF8') ON CONFLICT (theme_name,key) DO NOTHING")
        IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }
        r = PG_Query(conn, "INSERT INTO theme_values VALUES ('dark','toolbar_min_bg','0xFF16223F') ON CONFLICT (theme_name,key) DO NOTHING")
        IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }
        r = PG_Query(conn, "INSERT INTO theme_values VALUES ('dark','toolbar_max_bg','0xFF16223F') ON CONFLICT (theme_name,key) DO NOTHING")
        IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }

        // Deskbar
        r = PG_Query(conn, "INSERT INTO theme_values VALUES ('dark','deskbar_bg','0xFF0E1730') ON CONFLICT (theme_name,key) DO NOTHING")
        IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }
        r = PG_Query(conn, "INSERT INTO theme_values VALUES ('dark','deskbar_btn_bg','0xFF4A8CFF') ON CONFLICT (theme_name,key) DO NOTHING")
        IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }
        r = PG_Query(conn, "INSERT INTO theme_values VALUES ('dark','deskbar_btn_fg','0xFFE8EEF8') ON CONFLICT (theme_name,key) DO NOTHING")
        IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }
        r = PG_Query(conn, "INSERT INTO theme_values VALUES ('dark','deskbar_btn2_bg','0xFF16223F') ON CONFLICT (theme_name,key) DO NOTHING")
        IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }
        r = PG_Query(conn, "INSERT INTO theme_values VALUES ('dark','deskbar_btn2_fg','0xFF7A8AAA') ON CONFLICT (theme_name,key) DO NOTHING")
        IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }
        r = PG_Query(conn, "INSERT INTO theme_values VALUES ('dark','deskbar_hot_fg','0xFF2AD4FF') ON CONFLICT (theme_name,key) DO NOTHING")
        IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }
        r = PG_Query(conn, "INSERT INTO theme_values VALUES ('dark','deskbar_hot_bg','0xFF0A1020') ON CONFLICT (theme_name,key) DO NOTHING")
        IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }
        r = PG_Query(conn, "INSERT INTO theme_values VALUES ('dark','deskbar_win_bg','0xFF16223F') ON CONFLICT (theme_name,key) DO NOTHING")
        IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }
        r = PG_Query(conn, "INSERT INTO theme_values VALUES ('dark','deskbar_win_fg','0xFFE8EEF8') ON CONFLICT (theme_name,key) DO NOTHING")
        IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }
        r = PG_Query(conn, "INSERT INTO theme_values VALUES ('dark','deskbar_win_act_bg','0xFF2A4068') ON CONFLICT (theme_name,key) DO NOTHING")
        IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }
        r = PG_Query(conn, "INSERT INTO theme_values VALUES ('dark','deskbar_sep','0xFF2A4068') ON CONFLICT (theme_name,key) DO NOTHING")
        IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }

        // Tab bar
        r = PG_Query(conn, "INSERT INTO theme_values VALUES ('dark','tabbar_bg','0xFF0A1020') ON CONFLICT (theme_name,key) DO NOTHING")
        IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }
        r = PG_Query(conn, "INSERT INTO theme_values VALUES ('dark','tab_active_bg','0xFF16223F') ON CONFLICT (theme_name,key) DO NOTHING")
        IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }
        r = PG_Query(conn, "INSERT INTO theme_values VALUES ('dark','tab_icon','0xFF4A8CFF') ON CONFLICT (theme_name,key) DO NOTHING")
        IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }
        r = PG_Query(conn, "INSERT INTO theme_values VALUES ('dark','tab_text','0xFFE8EEF8') ON CONFLICT (theme_name,key) DO NOTHING")
        IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }

        // Menu
        r = PG_Query(conn, "INSERT INTO theme_values VALUES ('dark','menu_bg','0xFF0E1730') ON CONFLICT (theme_name,key) DO NOTHING")
        IfCondition NotEqual(r, 0) ThenBlock: { PG_DestroyResult(r) }
