// TestFileTree.ailang
// Test: resolve paths, create dirs, create files, read back, move, delete.
// Build: ./ailang.x OS/TestFileTree.ailang -o test_ft.x
// Run:   ./test_ft.x

LibraryImport.Arena
LibraryImport.Socket
LibraryImport.Hash
LibraryImport.Arrays
LibraryImport.StringUtils
LibraryImport.PostgreSQL_Complete

Import.OS.UUIDStore
Import.OS.Schema
Import.OS.FileTree

SubRoutine.Main {
    Arena_Init()
    PrintMessage("=== FileTree Test ===\n")

    // Override blob store to /tmp for local testing
    UUIDStore.base_path = "/tmp/blobs/"
    UUID_Init()

    // Connect to PG
    conn = PG_Connect("127.0.0.1", 5432, "ailang_system", "bob", "")
    IfCondition EqualTo(conn, 0) ThenBlock: {
        PrintMessage("[FAIL] Cannot connect to PostgreSQL\n")
        HaltProgram
    }
    PrintMessage("[PASS] Connected to PostgreSQL\n")

    // Bootstrap schema (idempotent)
    Schema_Bootstrap(conn)

    // ─── TEST 1: Resolve root ───────────────────────────────────────
    PrintMessage("\n[TEST 1] Resolve /\n")
    root_id = FileTree_Resolve(conn, "/")
    IfCondition GreaterThan(root_id, 0) ThenBlock: {
        PrintMessage("[PASS] Root ID = ")
        PrintNumber(root_id)
        PrintMessage("\n")
    } ElseBlock: {
        PrintMessage("[FAIL] Cannot resolve root\n")
        HaltProgram
    }

    // ─── TEST 2: Resolve /home ──────────────────────────────────────
    PrintMessage("\n[TEST 2] Resolve /home\n")
    home_id = FileTree_Resolve(conn, "/home")
    IfCondition GreaterThan(home_id, 0) ThenBlock: {
        PrintMessage("[PASS] /home ID = ")
        PrintNumber(home_id)
        PrintMessage("\n")
    } ElseBlock: {
        PrintMessage("[FAIL] Cannot resolve /home\n")
    }

    // ─── TEST 3: Resolve /home/bob ──────────────────────────────────
    PrintMessage("\n[TEST 3] Resolve /home/bob\n")
    bob_id = FileTree_Resolve(conn, "/home/bob")
    IfCondition GreaterThan(bob_id, 0) ThenBlock: {
        PrintMessage("[PASS] /home/bob ID = ")
        PrintNumber(bob_id)
        PrintMessage("\n")
    } ElseBlock: {
        PrintMessage("[FAIL] Cannot resolve /home/bob\n")
    }

    // ─── TEST 4: Resolve non-existent path ──────────────────────────
    PrintMessage("\n[TEST 4] Resolve /nonexistent\n")
    bad_id = FileTree_Resolve(conn, "/nonexistent")
    IfCondition EqualTo(bad_id, 0) ThenBlock: {
        PrintMessage("[PASS] Non-existent path returns 0\n")
    } ElseBlock: {
        PrintMessage("[FAIL] Non-existent path returned ")
        PrintNumber(bad_id)
        PrintMessage("\n")
    }

    // ─── TEST 5: Create a directory ─────────────────────────────────
    PrintMessage("\n[TEST 5] Create /home/bob/documents\n")
    docs_id = FileTree_CreateDir(conn, bob_id, "documents")
    IfCondition GreaterThan(docs_id, 0) ThenBlock: {
        PrintMessage("[PASS] Created dir ID = ")
        PrintNumber(docs_id)
        PrintMessage("\n")
    } ElseBlock: {
        PrintMessage("[FAIL] CreateDir returned 0\n")
    }

    // ─── TEST 6: Resolve the new directory ──────────────────────────
    PrintMessage("\n[TEST 6] Resolve /home/bob/documents\n")
    docs_id2 = FileTree_Resolve(conn, "/home/bob/documents")
    IfCondition EqualTo(docs_id2, docs_id) ThenBlock: {
        PrintMessage("[PASS] Resolved to same ID = ")
        PrintNumber(docs_id2)
        PrintMessage("\n")
    } ElseBlock: {
        PrintMessage("[FAIL] Resolved to ")
        PrintNumber(docs_id2)
        PrintMessage(" (expected ")
        PrintNumber(docs_id)
        PrintMessage(")\n")
    }

    // ─── TEST 7: Create a file ──────────────────────────────────────
    PrintMessage("\n[TEST 7] Create /home/bob/documents/hello.txt\n")
    file_content = "Hello from AILang OS filesystem!"
    file_len = StringLength(file_content)
    file_id = FileTree_CreateFile(conn, docs_id, "hello.txt", file_content, file_len)
    IfCondition GreaterThan(file_id, 0) ThenBlock: {
        PrintMessage("[PASS] Created file ID = ")
        PrintNumber(file_id)
        PrintMessage("\n")
    } ElseBlock: {
        PrintMessage("[FAIL] CreateFile returned 0\n")
    }

    // ─── TEST 8: Resolve the file path ──────────────────────────────
    PrintMessage("\n[TEST 8] Resolve /home/bob/documents/hello.txt\n")
    file_id2 = FileTree_Resolve(conn, "/home/bob/documents/hello.txt")
    IfCondition EqualTo(file_id2, file_id) ThenBlock: {
        PrintMessage("[PASS] Resolved file ID = ")
        PrintNumber(file_id2)
        PrintMessage("\n")
    } ElseBlock: {
        PrintMessage("[FAIL] Resolved to ")
        PrintNumber(file_id2)
        PrintMessage("\n")
    }

    // ─── TEST 9: Read file content back ─────────────────────────────
    PrintMessage("\n[TEST 9] Read file content\n")
    rbuf = Allocate(256)
    MemorySet(rbuf, 0, 256)
    bytes_read = FileTree_ReadFile(conn, file_id, rbuf, 256)
    IfCondition EqualTo(bytes_read, file_len) ThenBlock: {
        PrintMessage("[PASS] Read ")
        PrintNumber(bytes_read)
        PrintMessage(" bytes\n")
        PrintMessage("[INFO] Content: ")
        PrintString(rbuf)
        PrintMessage("\n")
    } ElseBlock: {
        PrintMessage("[FAIL] Read ")
        PrintNumber(bytes_read)
        PrintMessage(" bytes (expected ")
        PrintNumber(file_len)
        PrintMessage(")\n")
    }

    // Verify content byte-by-byte
    match = 1
    ci = 0
    WhileLoop LessThan(ci, file_len) {
        IfCondition NotEqual(GetByte(file_content, ci), GetByte(rbuf, ci)) ThenBlock: {
            match = 0
            BreakLoop
        }
        ci = Add(ci, 1)
    }
    IfCondition EqualTo(match, 1) ThenBlock: {
        PrintMessage("[PASS] Content verified byte-for-byte\n")
    } ElseBlock: {
        PrintMessage("[FAIL] Content mismatch at byte ")
        PrintNumber(ci)
        PrintMessage("\n")
    }
    Deallocate(rbuf, 256)

    // ─── TEST 10: List directory ────────────────────────────────────
    PrintMessage("\n[TEST 10] List /home/bob/documents\n")
    listing = FileTree_ListDir(conn, docs_id)
    IfCondition NotEqual(listing, 0) ThenBlock: {
        lcount = Array.Size(listing)
        PrintMessage("[PASS] Directory has ")
        PrintNumber(lcount)
        PrintMessage(" entries\n")

        li = 0
        WhileLoop LessThan(li, lcount) {
            lrow = Array.Get(listing, li)
            lname = Hash.Get(lrow, "name")
            ltype = Hash.Get(lrow, "type")
            PrintMessage("  ")
            PrintString(lname)
            PrintMessage("  (")
            PrintString(ltype)
            PrintMessage(")\n")
            li = Add(li, 1)
        }
        PG_DestroyResult(listing)
    } ElseBlock: {
        PrintMessage("[FAIL] ListDir returned 0\n")
    }

    // ─── TEST 11: Update file content ───────────────────────────────
    PrintMessage("\n[TEST 11] Update file content\n")
    new_content = "Updated content from FileTree_UpdateFile!"
    new_len = StringLength(new_content)
    urc = FileTree_UpdateFile(conn, file_id, new_content, new_len)
    IfCondition EqualTo(urc, 0) ThenBlock: {
        PrintMessage("[PASS] File updated\n")

        // Read back
        rbuf2 = Allocate(256)
        MemorySet(rbuf2, 0, 256)
        br2 = FileTree_ReadFile(conn, file_id, rbuf2, 256)
        IfCondition EqualTo(br2, new_len) ThenBlock: {
            PrintMessage("[PASS] Updated content: ")
            PrintString(rbuf2)
            PrintMessage("\n")
        } ElseBlock: {
            PrintMessage("[FAIL] Read back ")
            PrintNumber(br2)
            PrintMessage(" bytes\n")
        }
        Deallocate(rbuf2, 256)
    } ElseBlock: {
        PrintMessage("[FAIL] UpdateFile returned ")
        PrintNumber(urc)
        PrintMessage("\n")
    }

    // ─── TEST 12: Move / Rename ─────────────────────────────────────
    PrintMessage("\n[TEST 12] Rename hello.txt -> readme.txt\n")
    FileTree_Move(conn, file_id, docs_id, "readme.txt")

    // Verify old path is gone
    old_id = FileTree_Resolve(conn, "/home/bob/documents/hello.txt")
    IfCondition EqualTo(old_id, 0) ThenBlock: {
        PrintMessage("[PASS] Old path /home/bob/documents/hello.txt no longer resolves\n")
    } ElseBlock: {
        PrintMessage("[FAIL] Old path still resolves to ")
        PrintNumber(old_id)
        PrintMessage("\n")
    }

    // Verify new path works
    new_id = FileTree_Resolve(conn, "/home/bob/documents/readme.txt")
    IfCondition EqualTo(new_id, file_id) ThenBlock: {
        PrintMessage("[PASS] New path /home/bob/documents/readme.txt resolves to ID ")
        PrintNumber(new_id)
        PrintMessage("\n")
    } ElseBlock: {
        PrintMessage("[FAIL] New path resolves to ")
        PrintNumber(new_id)
        PrintMessage("\n")
    }

    // Verify content survived the rename
    rbuf3 = Allocate(256)
    MemorySet(rbuf3, 0, 256)
    br3 = FileTree_ReadFile(conn, file_id, rbuf3, 256)
    IfCondition EqualTo(br3, new_len) ThenBlock: {
        PrintMessage("[PASS] Content survived rename: ")
        PrintString(rbuf3)
        PrintMessage("\n")
    } ElseBlock: {
        PrintMessage("[FAIL] Post-rename read got ")
        PrintNumber(br3)
        PrintMessage(" bytes\n")
    }
    Deallocate(rbuf3, 256)

    // ─── TEST 13: Delete file ───────────────────────────────────────
    PrintMessage("\n[TEST 13] Delete readme.txt\n")
    drc = FileTree_Delete(conn, file_id)
    IfCondition EqualTo(drc, 0) ThenBlock: {
        PrintMessage("[PASS] File deleted\n")
    } ElseBlock: {
        PrintMessage("[FAIL] Delete returned ")
        PrintNumber(drc)
        PrintMessage("\n")
    }

    // Verify it's gone from PG
    gone_id = FileTree_Resolve(conn, "/home/bob/documents/readme.txt")
    IfCondition EqualTo(gone_id, 0) ThenBlock: {
        PrintMessage("[PASS] File no longer in PG\n")
    } ElseBlock: {
        PrintMessage("[FAIL] File still resolves to ")
        PrintNumber(gone_id)
        PrintMessage("\n")
    }

    // ─── TEST 14: Delete empty directory ────────────────────────────
    PrintMessage("\n[TEST 14] Delete /home/bob/documents (empty dir)\n")
    drc2 = FileTree_Delete(conn, docs_id)
    IfCondition EqualTo(drc2, 0) ThenBlock: {
        PrintMessage("[PASS] Directory deleted\n")
    } ElseBlock: {
        PrintMessage("[FAIL] Directory delete returned ")
        PrintNumber(drc2)
        PrintMessage("\n")
    }

    // Verify gone
    gone_dir = FileTree_Resolve(conn, "/home/bob/documents")
    IfCondition EqualTo(gone_dir, 0) ThenBlock: {
        PrintMessage("[PASS] Directory no longer in PG\n")
    } ElseBlock: {
        PrintMessage("[FAIL] Directory still resolves\n")
    }

    // ─── TEST 15: mkdir -p style (ResolveMkdir) ─────────────────────
    PrintMessage("\n[TEST 15] ResolveMkdir /home/bob/projects/ailang/src\n")
    deep_id = FileTree_ResolveMkdir(conn, "/home/bob/projects/ailang/src")
    IfCondition GreaterThan(deep_id, 0) ThenBlock: {
        PrintMessage("[PASS] Deep path created, leaf ID = ")
        PrintNumber(deep_id)
        PrintMessage("\n")

        // Verify each component resolves
        p1 = FileTree_Resolve(conn, "/home/bob/projects")
        p2 = FileTree_Resolve(conn, "/home/bob/projects/ailang")
        p3 = FileTree_Resolve(conn, "/home/bob/projects/ailang/src")

        IfCondition GreaterThan(p1, 0) ThenBlock: {
            PrintMessage("[PASS] /home/bob/projects = ")
            PrintNumber(p1)
            PrintMessage("\n")
        }
        IfCondition GreaterThan(p2, 0) ThenBlock: {
            PrintMessage("[PASS] /home/bob/projects/ailang = ")
            PrintNumber(p2)
            PrintMessage("\n")
        }
        IfCondition EqualTo(p3, deep_id) ThenBlock: {
            PrintMessage("[PASS] /home/bob/projects/ailang/src = ")
            PrintNumber(p3)
            PrintMessage("\n")
        }
    } ElseBlock: {
        PrintMessage("[FAIL] ResolveMkdir returned 0\n")
    }

    // Clean up: delete the deep path (bottom-up)
    d3 = FileTree_Resolve(conn, "/home/bob/projects/ailang/src")
    IfCondition GreaterThan(d3, 0) ThenBlock: { FileTree_Delete(conn, d3) }
    d2 = FileTree_Resolve(conn, "/home/bob/projects/ailang")
    IfCondition GreaterThan(d2, 0) ThenBlock: { FileTree_Delete(conn, d2) }
    d1 = FileTree_Resolve(conn, "/home/bob/projects")
    IfCondition GreaterThan(d1, 0) ThenBlock: { FileTree_Delete(conn, d1) }
    PrintMessage("[INFO] Deep path cleaned up\n")

    PG_Disconnect(conn)
    PrintMessage("\n=== FileTree Test Complete ===\n")
}

RunTask(Main)
