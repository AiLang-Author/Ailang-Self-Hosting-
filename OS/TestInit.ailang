// TestInit.ailang
// Test Init.ailang components without being PID 1.
// Tests: mount skip, PG readiness check, schema bootstrap, fork/exec.
// Build: ./ailang.x OS/TestInit.ailang -o test_init.x
// Run:   ./test_init.x
// Requires: PostgreSQL running locally on port 5432

LibraryImport.Arena
LibraryImport.StringUtils
LibraryImport.Socket
LibraryImport.Hash
LibraryImport.Arrays
LibraryImport.PostgreSQL_Complete
LibraryImport.Display.Render.Framebuffer
LibraryImport.TermFont

Import.OS.Login
Import.OS.Schema
Import.OS.Init

// Override RenderFB_InitDouble for headless testing
Function.RenderFB_InitDouble {
    Output: Integer
    Body: {
        FB_InitHeadless(1920, 1080)
        ReturnValue(1)
    }
}

SubRoutine.Main {
    Arena_Init()
    PrintMessage("=== Init Component Test ===\n\n")

    // Use local paths for testing
    Init_SetDefaults()

    // ─── TEST 1: PG Readiness Check ───────────────────────────────────
    PrintMessage("[TEST 1] PG readiness check (local PG should be running)\n")
    ready = Init_CheckPGReady()
    IfCondition EqualTo(ready, 1) ThenBlock: {
        PrintMessage("[PASS] PostgreSQL is accepting connections on port 5432\n")
    } ElseBlock: {
        PrintMessage("[FAIL] PostgreSQL not responding on port 5432\n")
        PrintMessage("[INFO] Make sure PostgreSQL is running locally\n")
        HaltProgram
    }

    // ─── TEST 2: Schema Bootstrap ─────────────────────────────────────
    PrintMessage("\n[TEST 2] Schema bootstrap via Init_BootstrapSchema()\n")
    schema_ok = Init_BootstrapSchema()
    IfCondition EqualTo(schema_ok, 1) ThenBlock: {
        PrintMessage("[PASS] Schema bootstrap successful\n")
    } ElseBlock: {
        PrintMessage("[FAIL] Schema bootstrap failed\n")
    }

    // ─── TEST 3: Verify schema via direct PG query ────────────────────
    PrintMessage("\n[TEST 3] Verify tables exist\n")
    conn = PG_Connect("127.0.0.1", 5432, "ailang_system", "bob", "")
    IfCondition EqualTo(conn, 0) ThenBlock: {
        PrintMessage("[FAIL] Cannot connect to PG for verification\n")
        HaltProgram
    }

    // Check services table
    r1 = PG_Query(conn, "SELECT COUNT(*) AS cnt FROM services")
    IfCondition NotEqual(r1, 0) ThenBlock: {
        n1 = Array.Size(r1)
        IfCondition GreaterThan(n1, 0) ThenBlock: {
            row1 = Array.Get(r1, 0)
            cnt1 = Hash.Get(row1, "cnt")
            PrintMessage("[PASS] services table: ")
            PrintString(cnt1)
            PrintMessage(" rows\n")
        }
        PG_DestroyResult(r1)
    } ElseBlock: {
        PrintMessage("[FAIL] services table query failed\n")
    }

    // Check files table
    r2 = PG_Query(conn, "SELECT COUNT(*) AS cnt FROM files")
    IfCondition NotEqual(r2, 0) ThenBlock: {
        n2 = Array.Size(r2)
        IfCondition GreaterThan(n2, 0) ThenBlock: {
            row2 = Array.Get(r2, 0)
            cnt2 = Hash.Get(row2, "cnt")
            PrintMessage("[PASS] files table: ")
            PrintString(cnt2)
            PrintMessage(" rows\n")
        }
        PG_DestroyResult(r2)
    } ElseBlock: {
        PrintMessage("[FAIL] files table query failed\n")
    }

    // Check users table
    r3 = PG_Query(conn, "SELECT username FROM users LIMIT 1")
    IfCondition NotEqual(r3, 0) ThenBlock: {
        n3 = Array.Size(r3)
        IfCondition GreaterThan(n3, 0) ThenBlock: {
            row3 = Array.Get(r3, 0)
            uname = Hash.Get(row3, "username")
            PrintMessage("[PASS] users table has user: ")
            PrintString(uname)
            PrintMessage("\n")
        }
        PG_DestroyResult(r3)
    } ElseBlock: {
        PrintMessage("[FAIL] users table query failed\n")
    }

    PG_Disconnect(conn)

    // ─── TEST 4: Fork/exec a simple child process ─────────────────────
    PrintMessage("\n[TEST 4] Fork/exec test (echo command)\n")

    // We'll fork and exec /bin/echo with a test message
    echo_argv = Allocate(24)
    StoreValue(Add(echo_argv, 0), "/bin/echo")
    StoreValue(Add(echo_argv, 8), "[CHILD] Hello from forked process")
    StoreValue(Add(echo_argv, 16), 0)

    echo_envp = Allocate(8)
    StoreValue(echo_envp, 0)

    child_pid = SystemCall(57, 0, 0, 0, 0, 0)

    IfCondition EqualTo(child_pid, 0) ThenBlock: {
        // Child
        SystemCall(59, "/bin/echo", echo_argv, echo_envp, 0, 0)
        SystemCall(60, 127, 0, 0, 0, 0)
    }

    Deallocate(echo_argv, 24)
    Deallocate(echo_envp, 8)

    IfCondition GreaterThan(child_pid, 0) ThenBlock: {
        PrintMessage("[INFO] Forked child PID=")
        PrintNumber(child_pid)
        PrintMessage("\n")

        // Wait for child
        wstatus = Allocate(8)
        SystemCall(61, child_pid, wstatus, 0, 0, 0)
        exit_raw = Dereference(wstatus)
        exit_code = BitwiseAnd(Divide(exit_raw, 256), 255)
        Deallocate(wstatus, 8)

        IfCondition EqualTo(exit_code, 0) ThenBlock: {
            PrintMessage("[PASS] Child exited with code 0\n")
        } ElseBlock: {
            PrintMessage("[FAIL] Child exit code: ")
            PrintNumber(exit_code)
            PrintMessage("\n")
        }
    } ElseBlock: {
        PrintMessage("[FAIL] Fork failed\n")
    }

    // ─── TEST 5: Login (headless, piped stdin) ────────────────────────
    PrintMessage("\n[TEST 5] Login (headless mode)\n")
    PrintMessage("[INFO] Skipping interactive login in automated test\n")
    PrintMessage("[INFO] Login was tested separately via TestLogin.ailang\n")

    PrintMessage("\n=== Init Component Test Complete ===\n")
    PrintMessage("[INFO] All Init components verified. Ready for VM deployment.\n")
}

RunTask(Main)
