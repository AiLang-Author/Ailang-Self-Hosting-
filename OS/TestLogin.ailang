// TestLogin.ailang
// Test login screen in headless mode (no /dev/fb0 needed).
// Reads input from stdin, renders to headless framebuffer.
// Build: ./ailang.x OS/TestLogin.ailang -o test_login.x
// Run:   ./test_login.x
// Login: username=bob, password=ailang

LibraryImport.Arena
LibraryImport.StringUtils
LibraryImport.Display.Render.Framebuffer
LibraryImport.TermFont

Import.OS.Login

// Override RenderFB_InitDouble to call headless init
Function.RenderFB_InitDouble {
    Output: Integer
    Body: {
        FB_InitHeadless(1920, 1080)
        ReturnValue(1)
    }
}

// =============================================================================
// TERMINAL RAW MODE — disable echo and line buffering for stdin
// =============================================================================
FixedPool.RawMode {
    "old_termios": Initialize=0, CanChange=True
    "enabled":     Initialize=0, CanChange=True
}

Function.TermRaw_Enable {
    Body: {
        // Save old termios settings
        old = Allocate(60)
        // ioctl(0, TCGETS=0x5401, old_termios)
        SystemCall(16, 0, 21505, old, 0, 0)
        RawMode.old_termios = old

        // Create new termios = copy of old
        new = Allocate(60)
        i = 0
        WhileLoop LessThan(i, 60) {
            SetByte(new, i, GetByte(old, i))
            i = Add(i, 1)
        }

        // c_lflag is at offset 12 (4 bytes)
        // Clear ICANON (0x02) and ECHO (0x08) bits
        lflag = Add(GetByte(new, 12), Add(Multiply(GetByte(new, 13), 256), Add(Multiply(GetByte(new, 14), 65536), Multiply(GetByte(new, 15), 16777216))))
        // Clear bits: ICANON=2, ECHO=8 → mask = ~(2|8) = ~10
        lflag = BitwiseAnd(lflag, Subtract(0, 11))

        SetByte(new, 12, BitwiseAnd(lflag, 255))
        SetByte(new, 13, BitwiseAnd(Divide(lflag, 256), 255))
        SetByte(new, 14, BitwiseAnd(Divide(lflag, 65536), 255))
        SetByte(new, 15, BitwiseAnd(Divide(lflag, 16777216), 255))

        // Set VMIN=1 (c_cc[6]) and VTIME=0 (c_cc[5])
        // c_cc starts at offset 17
        SetByte(new, 23, 1)   // VMIN  = c_cc[6]
        SetByte(new, 22, 0)   // VTIME = c_cc[5]

        // ioctl(0, TCSETS=0x5402, new_termios)
        SystemCall(16, 0, 21506, new, 0, 0)
        Deallocate(new, 60)
        RawMode.enabled = 1
    }
}

Function.TermRaw_Disable {
    Body: {
        IfCondition EqualTo(RawMode.enabled, 1) ThenBlock: {
            // Restore old termios
            SystemCall(16, 0, 21506, RawMode.old_termios, 0, 0)
            Deallocate(RawMode.old_termios, 60)
            RawMode.enabled = 0
        }
    }
}

SubRoutine.Main {
    Arena_Init()
    PrintMessage("=== Login Screen Test (Headless) ===\n")
    PrintMessage("Username: bob\n")
    PrintMessage("Password: ailang\n")
    PrintMessage("[Tab] to switch fields, [Enter] to login, [Esc] to quit\n")
    PrintMessage("Entering raw mode...\n\n")

    // Set headless mode
    LoginState.headless = 1

    // Enable raw terminal mode for stdin input
    TermRaw_Enable()

    // Run login
    result = Login_Run()

    // Restore terminal
    TermRaw_Disable()

    PrintMessage("\n[TEST] Login result: ")
    PrintNumber(result)
    PrintMessage("\n")

    IfCondition EqualTo(result, 1) ThenBlock: {
        PrintMessage("[PASS] Login successful!\n")
    } ElseBlock: {
        PrintMessage("[INFO] Login cancelled or failed\n")
    }

    PrintMessage("=== Login Test Complete ===\n")
}

RunTask(Main)
