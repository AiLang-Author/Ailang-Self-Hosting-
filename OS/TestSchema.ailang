// TestSchema.ailang
// Quick test: connect to PG, bootstrap schema, verify tables exist.
// Build: ./ailang.x OS/TestSchema.ailang -o test_schema.x
// Run:   ./test_schema.x

LibraryImport.Arena
LibraryImport.Socket
LibraryImport.Hash
LibraryImport.Arrays
LibraryImport.StringUtils
LibraryImport.PostgreSQL_Complete

Import.OS.Schema

SubRoutine.Main {
    Arena_Init()
    PrintMessage("=== Schema Bootstrap Test ===\n")

    conn = PG_Connect("127.0.0.1", 5432, "ailang_system", "bob", "")
    IfCondition EqualTo(conn, 0) ThenBlock: {
        PrintMessage("[FAIL] Cannot connect to PostgreSQL\n")
        HaltProgram
    }
    PrintMessage("[PASS] Connected to PostgreSQL\n")

    rc = Schema_Bootstrap(conn)
    PrintMessage("[INFO] Schema_Bootstrap returned: ")
    PrintNumber(rc)
    PrintMessage("\n")

    // Verify: query services
    result = PG_Query(conn, "SELECT name, autostart, priority FROM services WHERE autostart = true ORDER BY priority")
    IfCondition EqualTo(result, 0) ThenBlock: {
        PrintMessage("[FAIL] services query failed\n")
        PG_Disconnect(conn)
        HaltProgram
    }

    cnt = Array.Size(result)
    PrintMessage("[INFO] Autostart services: ")
    PrintNumber(cnt)
    PrintMessage("\n")

    i = 0
    WhileLoop LessThan(i, cnt) {
        row = Array.Get(result, i)
        sn = Hash.Get(row, "name")
        PrintMessage("  - ")
        PrintString(sn)
        PrintMessage("\n")
        i = Add(i, 1)
    }
    PG_DestroyResult(result)

    // Verify: query files
    result = PG_Query(conn, "SELECT name, type FROM files WHERE parent_id IS NULL OR parent_id = 1 ORDER BY name")
    IfCondition EqualTo(result, 0) ThenBlock: {
        PrintMessage("[FAIL] files query failed\n")
        PG_Disconnect(conn)
        HaltProgram
    }

    cnt = Array.Size(result)
    PrintMessage("[INFO] Root filesystem entries: ")
    PrintNumber(cnt)
    PrintMessage("\n")

    i = 0
    WhileLoop LessThan(i, cnt) {
        row = Array.Get(result, i)
        fn = Hash.Get(row, "name")
        ft = Hash.Get(row, "type")
        PrintMessage("  /")
        PrintString(fn)
        PrintMessage("  (")
        PrintString(ft)
        PrintMessage(")\n")
        i = Add(i, 1)
    }
    PG_DestroyResult(result)

    // Verify: query users
    result = PG_Query(conn, "SELECT username, is_admin FROM users")
    IfCondition EqualTo(result, 0) ThenBlock: {
        PrintMessage("[FAIL] users query failed\n")
        PG_Disconnect(conn)
        HaltProgram
    }

    cnt = Array.Size(result)
    PrintMessage("[INFO] Users: ")
    PrintNumber(cnt)
    PrintMessage("\n")

    i = 0
    WhileLoop LessThan(i, cnt) {
        row = Array.Get(result, i)
        un = Hash.Get(row, "username")
        PrintMessage("  - ")
        PrintString(un)
        PrintMessage("\n")
        i = Add(i, 1)
    }
    PG_DestroyResult(result)

    PG_Disconnect(conn)
    PrintMessage("=== Schema Test Complete ===\n")
}

RunTask(Main)
