// TestUUIDStore.ailang
// Test: generate UUID, create blob, read it back, verify, check size, delete, verify gone.
// Build: ./ailang.x OS/TestUUIDStore.ailang -o test_uuid.x
// Run:   ./test_uuid.x

LibraryImport.Arena
LibraryImport.StringUtils

Import.OS.UUIDStore

SubRoutine.Main {
    Arena_Init()
    PrintMessage("=== UUID Store Test ===\n")

    // Override base_path for local testing (no /data on dev machine)
    UUIDStore.base_path = "/tmp/blobs/"

    // Init store (mkdir -p /tmp/blobs)
    UUID_Init()

    // Generate a UUID
    PrintMessage("\n[TEST 1] UUID_Generate\n")
    uuid = UUID_Generate()
    IfCondition EqualTo(uuid, 0) ThenBlock: {
        PrintMessage("[FAIL] UUID_Generate returned null\n")
        HaltProgram
    }
    PrintMessage("[PASS] Generated UUID: ")
    PrintString(uuid)
    PrintMessage("\n")

    // Verify UUID length = 36
    ulen = StringLength(uuid)
    IfCondition EqualTo(ulen, 36) ThenBlock: {
        PrintMessage("[PASS] UUID length = 36\n")
    } ElseBlock: {
        PrintMessage("[FAIL] UUID length = ")
        PrintNumber(ulen)
        PrintMessage(" (expected 36)\n")
    }

    // Verify dashes at positions 8, 13, 18, 23
    d1 = GetByte(uuid, 8)
    d2 = GetByte(uuid, 13)
    d3 = GetByte(uuid, 18)
    d4 = GetByte(uuid, 23)
    IfCondition EqualTo(d1, 45) ThenBlock: {
        IfCondition EqualTo(d2, 45) ThenBlock: {
            IfCondition EqualTo(d3, 45) ThenBlock: {
                IfCondition EqualTo(d4, 45) ThenBlock: {
                    PrintMessage("[PASS] Dashes at correct positions\n")
                }
            }
        }
    }

    // Verify version 4 nibble: char at position 14 should be '4'
    v4 = GetByte(uuid, 14)
    IfCondition EqualTo(v4, 52) ThenBlock: {
        PrintMessage("[PASS] Version 4 marker present\n")
    } ElseBlock: {
        PrintMessage("[FAIL] Version nibble = ")
        PrintNumber(v4)
        PrintMessage(" (expected 52 = '4')\n")
    }

    // Build store path and print it
    PrintMessage("\n[TEST 2] UUID_StorePath\n")
    path = UUID_StorePath(uuid)
    PrintMessage("[INFO] Blob path: ")
    PrintString(path)
    PrintMessage("\n")
    Deallocate(path, 128)

    // Create a blob with known content
    PrintMessage("\n[TEST 3] UUID_Create\n")
    test_data = "Hello from AILang OS! This is a test blob stored by UUID."
    test_len = StringLength(test_data)
    rc = UUID_Create(uuid, test_data, test_len)
    IfCondition EqualTo(rc, 0) ThenBlock: {
        PrintMessage("[PASS] Blob created successfully\n")
    } ElseBlock: {
        PrintMessage("[FAIL] UUID_Create returned ")
        PrintNumber(rc)
        PrintMessage("\n")
        HaltProgram
    }

    // Check it exists
    PrintMessage("\n[TEST 4] UUID_Exists\n")
    exists = UUID_Exists(uuid)
    IfCondition EqualTo(exists, 1) ThenBlock: {
        PrintMessage("[PASS] Blob exists on disk\n")
    } ElseBlock: {
        PrintMessage("[FAIL] Blob not found on disk\n")
    }

    // Check file size
    PrintMessage("\n[TEST 5] UUID_FileSize\n")
    fsize = UUID_FileSize(uuid)
    IfCondition EqualTo(fsize, test_len) ThenBlock: {
        PrintMessage("[PASS] File size = ")
        PrintNumber(fsize)
        PrintMessage(" bytes (matches)\n")
    } ElseBlock: {
        PrintMessage("[FAIL] File size = ")
        PrintNumber(fsize)
        PrintMessage(" (expected ")
        PrintNumber(test_len)
        PrintMessage(")\n")
    }

    // Read it back
    PrintMessage("\n[TEST 6] UUID_Read\n")
    read_buf = Allocate(256)
    MemorySet(read_buf, 0, 256)
    bytes_read = UUID_Read(uuid, read_buf, 256)
    IfCondition EqualTo(bytes_read, test_len) ThenBlock: {
        PrintMessage("[PASS] Read ")
        PrintNumber(bytes_read)
        PrintMessage(" bytes\n")
    } ElseBlock: {
        PrintMessage("[FAIL] Read ")
        PrintNumber(bytes_read)
        PrintMessage(" bytes (expected ")
        PrintNumber(test_len)
        PrintMessage(")\n")
    }

    // Verify content matches byte-by-byte
    PrintMessage("\n[TEST 7] Content verification\n")
    match = 1
    ci = 0
    WhileLoop LessThan(ci, test_len) {
        orig = GetByte(test_data, ci)
        back = GetByte(read_buf, ci)
        IfCondition NotEqual(orig, back) ThenBlock: {
            PrintMessage("[FAIL] Mismatch at byte ")
            PrintNumber(ci)
            PrintMessage(": expected ")
            PrintNumber(orig)
            PrintMessage(" got ")
            PrintNumber(back)
            PrintMessage("\n")
            match = 0
            BreakLoop
        }
        ci = Add(ci, 1)
    }
    IfCondition EqualTo(match, 1) ThenBlock: {
        PrintMessage("[PASS] Content matches byte-for-byte\n")
        PrintMessage("[INFO] Content: ")
        PrintString(read_buf)
        PrintMessage("\n")
    }
    Deallocate(read_buf, 256)

    // Overwrite with different content
    PrintMessage("\n[TEST 8] UUID_Overwrite\n")
    new_data = "Overwritten blob content."
    new_len = StringLength(new_data)
    rc = UUID_Overwrite(uuid, new_data, new_len)
    IfCondition EqualTo(rc, 0) ThenBlock: {
        PrintMessage("[PASS] Blob overwritten\n")
    } ElseBlock: {
        PrintMessage("[FAIL] UUID_Overwrite returned ")
        PrintNumber(rc)
        PrintMessage("\n")
    }

    // Read back overwritten content
    read_buf2 = Allocate(256)
    MemorySet(read_buf2, 0, 256)
    bytes_read2 = UUID_Read(uuid, read_buf2, 256)
    IfCondition EqualTo(bytes_read2, new_len) ThenBlock: {
        PrintMessage("[PASS] Overwritten read: ")
        PrintString(read_buf2)
        PrintMessage("\n")
    } ElseBlock: {
        PrintMessage("[FAIL] Overwritten read got ")
        PrintNumber(bytes_read2)
        PrintMessage(" bytes\n")
    }
    Deallocate(read_buf2, 256)

    // Delete the blob
    PrintMessage("\n[TEST 9] UUID_Delete\n")
    rc = UUID_Delete(uuid)
    IfCondition EqualTo(rc, 0) ThenBlock: {
        PrintMessage("[PASS] Blob deleted\n")
    } ElseBlock: {
        PrintMessage("[FAIL] UUID_Delete returned ")
        PrintNumber(rc)
        PrintMessage("\n")
    }

    // Verify it's gone
    PrintMessage("\n[TEST 10] Verify deleted\n")
    exists2 = UUID_Exists(uuid)
    IfCondition EqualTo(exists2, 0) ThenBlock: {
        PrintMessage("[PASS] Blob no longer exists on disk\n")
    } ElseBlock: {
        PrintMessage("[FAIL] Blob still exists after delete\n")
    }

    // Generate a second UUID to prove uniqueness
    PrintMessage("\n[TEST 11] UUID uniqueness\n")
    uuid2 = UUID_Generate()
    IfCondition EqualTo(uuid2, 0) ThenBlock: {
        PrintMessage("[FAIL] Second UUID_Generate returned null\n")
    } ElseBlock: {
        PrintMessage("[PASS] Second UUID: ")
        PrintString(uuid2)
        PrintMessage("\n")

        // Compare — they should differ
        same = 1
        ci = 0
        WhileLoop LessThan(ci, 36) {
            IfCondition NotEqual(GetByte(uuid, ci), GetByte(uuid2, ci)) ThenBlock: {
                same = 0
                BreakLoop
            }
            ci = Add(ci, 1)
        }
        IfCondition EqualTo(same, 0) ThenBlock: {
            PrintMessage("[PASS] UUIDs are unique\n")
        } ElseBlock: {
            PrintMessage("[FAIL] UUIDs are identical (entropy problem)\n")
        }
    }

    PrintMessage("\n=== UUID Store Test Complete ===\n")
}

RunTask(Main)
