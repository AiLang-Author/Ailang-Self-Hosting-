// UUIDStore.ailang
// Flat file storage layer for AILang OS.
// Files are stored as /data/blobs/{uuid}.blob on ext4.
// No directories, no hierarchy — PostgreSQL owns the tree.
// Copyright © 2025 Sean Collins, 2 Paws Machine and Engineering. All rights reserved. SCSL.

LibraryImport.Arena
LibraryImport.StringUtils

// =============================================================================
// SYSCALL CONSTANTS
// =============================================================================
FixedPool.UUIDSys {
    "SYS_READ":   Initialize=0
    "SYS_WRITE":  Initialize=1
    "SYS_OPEN":   Initialize=2
    "SYS_CLOSE":  Initialize=3
    "SYS_STAT":   Initialize=4
    "SYS_LSEEK":  Initialize=8
    "SYS_MKDIR":  Initialize=83
    "SYS_UNLINK": Initialize=87
}

FixedPool.UUIDFlags {
    "O_RDONLY":  Initialize=0
    "O_WRONLY":  Initialize=1
    "O_RDWR":    Initialize=2
    "O_CREAT":   Initialize=64
    "O_TRUNC":   Initialize=512
    "SEEK_END":  Initialize=2
    "FMODE":     Initialize=384
    "DIRMODE":   Initialize=493
}

// O_WRONLY | O_CREAT | O_TRUNC = 1 + 64 + 512 = 577
FixedPool.UUIDCombined {
    "WRITE_CREATE_TRUNC": Initialize=577
}

// =============================================================================
// BLOB STORE PATH PREFIX
// =============================================================================
FixedPool.UUIDStore {
    "base_path": Initialize="/data/blobs/", CanChange=True
    "suffix":    Initialize=".blob"
    "initialized": Initialize=0, CanChange=True
    "path_len":  Initialize=12, CanChange=True
}

// Hex lookup table for UUID formatting
FixedPool.HexChars {
    "table": Initialize="0123456789abcdef"
}

// =============================================================================
// UUID STORE INIT — ensure /data and /data/blobs directories exist
// =============================================================================
Function.UUID_Init {
    Body: {
        // Ensure base_path directory exists (and its parent)
        // Build parent by stripping trailing component
        bp = UUIDStore.base_path
        bplen = StringLength(bp)
        UUIDStore.path_len = bplen

        // Find second-to-last slash to get parent dir
        parent = Allocate(Add(bplen, 1))
        i = 0
        WhileLoop LessThan(i, bplen) {
            SetByte(parent, i, GetByte(bp, i))
            i = Add(i, 1)
        }
        SetByte(parent, bplen, 0)

        // Strip trailing slash for mkdir
        plen = bplen
        IfCondition GreaterThan(plen, 1) ThenBlock: {
            IfCondition EqualTo(GetByte(parent, Subtract(plen, 1)), 47) ThenBlock: {
                plen = Subtract(plen, 1)
                SetByte(parent, plen, 0)
            }
        }

        // Find last slash in trimmed path to get parent dir
        last_slash = 0
        i = 0
        WhileLoop LessThan(i, plen) {
            IfCondition EqualTo(GetByte(parent, i), 47) ThenBlock: {
                last_slash = i
            }
            i = Add(i, 1)
        }

        // mkdir parent (e.g. /data from /data/blobs)
        IfCondition GreaterThan(last_slash, 0) ThenBlock: {
            parent_dir = Allocate(Add(last_slash, 1))
            i = 0
            WhileLoop LessThan(i, last_slash) {
                SetByte(parent_dir, i, GetByte(parent, i))
                i = Add(i, 1)
            }
            SetByte(parent_dir, last_slash, 0)
            SystemCall(UUIDSys.SYS_MKDIR, parent_dir, UUIDFlags.DIRMODE, 0, 0, 0)
            Deallocate(parent_dir, Add(last_slash, 1))
        }

        // mkdir the blobs dir itself
        SystemCall(UUIDSys.SYS_MKDIR, parent, UUIDFlags.DIRMODE, 0, 0, 0)
        Deallocate(parent, Add(bplen, 1))

        UUIDStore.initialized = 1
        PrintMessage("[UUID] Store initialized: ")
        PrintString(bp)
        PrintMessage("\n")
    }
}

// =============================================================================
// UUID GENERATE — read 16 bytes from /dev/urandom, format as hex string
// Returns pointer to 36-char UUID string: xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
// =============================================================================
Function.UUID_Generate {
    Output: Integer
    Body: {
        // Read 16 random bytes
        raw = Allocate(16)
        fd = SystemCall(UUIDSys.SYS_OPEN, "/dev/urandom", UUIDFlags.O_RDONLY, 0, 0, 0)
        IfCondition LessThan(fd, 0) ThenBlock: {
            PrintMessage("[UUID] ERROR: cannot open /dev/urandom\n")
            Deallocate(raw, 16)
            ReturnValue(0)
        }

        total = 0
        WhileLoop LessThan(total, 16) {
            r = SystemCall(UUIDSys.SYS_READ, fd, Add(raw, total), Subtract(16, total), 0, 0)
            IfCondition LessEqual(r, 0) ThenBlock: { BreakLoop }
            total = Add(total, r)
        }
        SystemCall(UUIDSys.SYS_CLOSE, fd, 0, 0, 0, 0)

        IfCondition LessThan(total, 16) ThenBlock: {
            PrintMessage("[UUID] ERROR: short read from /dev/urandom\n")
            Deallocate(raw, 16)
            ReturnValue(0)
        }

        // Set version 4 bits: byte 6 = (byte6 & 0x0F) | 0x40
        b6 = GetByte(raw, 6)
        b6 = BitwiseOr(BitwiseAnd(b6, 15), 64)
        SetByte(raw, 6, b6)

        // Set variant bits: byte 8 = (byte8 & 0x3F) | 0x80
        b8 = GetByte(raw, 8)
        b8 = BitwiseOr(BitwiseAnd(b8, 63), 128)
        SetByte(raw, 8, b8)

        // Format as UUID string: 8-4-4-4-12 = 36 chars + null
        uuid = Allocate(37)
        upos = 0

        // Byte-to-hex conversion for all 16 bytes
        // Positions of dashes: after bytes 4, 6, 8, 10
        bi = 0
        WhileLoop LessThan(bi, 16) {
            bval = GetByte(raw, bi)
            hi = Divide(bval, 16)
            lo = Modulo(bval, 16)
            SetByte(uuid, upos, GetByte(HexChars.table, hi))
            upos = Add(upos, 1)
            SetByte(uuid, upos, GetByte(HexChars.table, lo))
            upos = Add(upos, 1)

            // Insert dashes after bytes 4, 6, 8, 10
            IfCondition EqualTo(bi, 3) ThenBlock: {
                SetByte(uuid, upos, 45)
                upos = Add(upos, 1)
            }
            IfCondition EqualTo(bi, 5) ThenBlock: {
                SetByte(uuid, upos, 45)
                upos = Add(upos, 1)
            }
            IfCondition EqualTo(bi, 7) ThenBlock: {
                SetByte(uuid, upos, 45)
                upos = Add(upos, 1)
            }
            IfCondition EqualTo(bi, 9) ThenBlock: {
                SetByte(uuid, upos, 45)
                upos = Add(upos, 1)
            }

            bi = Add(bi, 1)
        }
        SetByte(uuid, 36, 0)

        Deallocate(raw, 16)
        ReturnValue(uuid)
    }
}

// =============================================================================
// UUID STORE PATH — build "/data/blobs/{uuid}.blob"
// Returns pointer to path string. Caller must Deallocate when done.
// =============================================================================
Function.UUID_StorePath {
    Input: uuid: Integer
    Output: Integer
    Body: {
        // Fixed 128-byte buffer for path (max ~80 chars needed)
        // base_path (variable) + uuid (36) + ".blob" (5) + null (1)
        bp = UUIDStore.base_path
        bplen = StringLength(bp)
        ulen = StringLength(uuid)
        sflen = 5

        path = Allocate(128)
        poff = 0

        // Copy base path
        i = 0
        WhileLoop LessThan(i, bplen) {
            SetByte(path, poff, GetByte(bp, i))
            poff = Add(poff, 1)
            i = Add(i, 1)
        }

        // Copy UUID
        i = 0
        WhileLoop LessThan(i, ulen) {
            SetByte(path, poff, GetByte(uuid, i))
            poff = Add(poff, 1)
            i = Add(i, 1)
        }

        // Copy suffix ".blob"
        sf = UUIDStore.suffix
        i = 0
        WhileLoop LessThan(i, sflen) {
            SetByte(path, poff, GetByte(sf, i))
            poff = Add(poff, 1)
            i = Add(i, 1)
        }

        SetByte(path, poff, 0)
        ReturnValue(path)
    }
}

// =============================================================================
// UUID CREATE — write data to a new blob file
// Returns 0 on success, -1 on error.
// =============================================================================
Function.UUID_Create {
    Input: uuid: Integer
    Input: data: Integer
    Input: size: Integer
    Output: Integer
    Body: {
        path = UUID_StorePath(uuid)

        fd = SystemCall(UUIDSys.SYS_OPEN, path, UUIDCombined.WRITE_CREATE_TRUNC, UUIDFlags.FMODE, 0, 0)
        IfCondition LessThan(fd, 0) ThenBlock: {
            PrintMessage("[UUID] ERROR: cannot create blob ")
            PrintString(path)
            PrintMessage("\n")
            Deallocate(path, 128)
            ReturnValue(-1)
        }

        // Write data in a loop (may need multiple writes for large files)
        written = 0
        WhileLoop LessThan(written, size) {
            w = SystemCall(UUIDSys.SYS_WRITE, fd, Add(data, written), Subtract(size, written), 0, 0)
            IfCondition LessEqual(w, 0) ThenBlock: {
                PrintMessage("[UUID] ERROR: write failed for ")
                PrintString(path)
                PrintMessage("\n")
                SystemCall(UUIDSys.SYS_CLOSE, fd, 0, 0, 0, 0)
                Deallocate(path, 128)
                ReturnValue(-1)
            }
            written = Add(written, w)
        }

        SystemCall(UUIDSys.SYS_CLOSE, fd, 0, 0, 0, 0)
        Deallocate(path, 128)
        ReturnValue(0)
    }
}

// =============================================================================
// UUID READ — read blob contents into buffer
// Returns bytes read (>= 0) or -1 on error.
// =============================================================================
Function.UUID_Read {
    Input: uuid: Integer
    Input: buf:  Integer
    Input: max:  Integer
    Output: Integer
    Body: {
        path = UUID_StorePath(uuid)

        fd = SystemCall(UUIDSys.SYS_OPEN, path, UUIDFlags.O_RDONLY, 0, 0, 0)
        IfCondition LessThan(fd, 0) ThenBlock: {
            Deallocate(path, 128)
            ReturnValue(-1)
        }

        total = 0
        WhileLoop LessThan(total, max) {
            r = SystemCall(UUIDSys.SYS_READ, fd, Add(buf, total), Subtract(max, total), 0, 0)
            IfCondition LessEqual(r, 0) ThenBlock: { BreakLoop }
            total = Add(total, r)
        }

        SystemCall(UUIDSys.SYS_CLOSE, fd, 0, 0, 0, 0)
        Deallocate(path, 128)
        ReturnValue(total)
    }
}

// =============================================================================
// UUID DELETE — unlink a blob file
// Returns 0 on success, -1 on error.
// =============================================================================
Function.UUID_Delete {
    Input: uuid: Integer
    Output: Integer
    Body: {
        path = UUID_StorePath(uuid)
        rc = SystemCall(UUIDSys.SYS_UNLINK, path, 0, 0, 0, 0)
        Deallocate(path, 128)

        IfCondition LessThan(rc, 0) ThenBlock: {
            ReturnValue(-1)
        }
        ReturnValue(0)
    }
}

// =============================================================================
// UUID EXISTS — check if blob file exists on disk
// Returns 1 if exists, 0 if not.
// =============================================================================
Function.UUID_Exists {
    Input: uuid: Integer
    Output: Integer
    Body: {
        path = UUID_StorePath(uuid)

        // stat() the file — if rc >= 0, it exists
        statbuf = Allocate(144)
        rc = SystemCall(UUIDSys.SYS_STAT, path, statbuf, 0, 0, 0)
        Deallocate(statbuf, 144)
        Deallocate(path, 128)

        IfCondition GreaterEqual(rc, 0) ThenBlock: {
            ReturnValue(1)
        }
        ReturnValue(0)
    }
}

// =============================================================================
// UUID FILE SIZE — get size of blob on disk
// Returns file size in bytes, or -1 on error.
// =============================================================================
Function.UUID_FileSize {
    Input: uuid: Integer
    Output: Integer
    Body: {
        path = UUID_StorePath(uuid)

        fd = SystemCall(UUIDSys.SYS_OPEN, path, UUIDFlags.O_RDONLY, 0, 0, 0)
        IfCondition LessThan(fd, 0) ThenBlock: {
            Deallocate(path, 128)
            ReturnValue(-1)
        }

        // lseek to end to get size
        size = SystemCall(UUIDSys.SYS_LSEEK, fd, 0, UUIDFlags.SEEK_END, 0, 0)
        SystemCall(UUIDSys.SYS_CLOSE, fd, 0, 0, 0, 0)
        Deallocate(path, 128)
        ReturnValue(size)
    }
}

// =============================================================================
// UUID OVERWRITE — replace blob contents (same UUID, new data)
// Returns 0 on success, -1 on error.
// =============================================================================
Function.UUID_Overwrite {
    Input: uuid: Integer
    Input: data: Integer
    Input: size: Integer
    Output: Integer
    Body: {
        // Same as create — O_TRUNC wipes old content
        rc = UUID_Create(uuid, data, size)
        ReturnValue(rc)
    }
}
