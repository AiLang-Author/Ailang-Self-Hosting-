// Packager.ailang — AILang Packager entry point
// Scan, build, and package AILang projects.
// CLI and TUI modes in a single binary.
//
// Build:
//   cd /home/bob/Ailang-Self-Hosting-
//   ./ailang.x Packager/Packager.ailang /home/bob/Packager/packager.x
//
// Usage:
//   ./packager.x --cmd scan --dir /path/to/project
//   ./packager.x --cmd graph --dir /path/to/project
//   ./packager.x --cmd init --dir /path/to/project
//   ./packager.x --cmd build --dir /path/to/project
//   ./packager.x --cmd pack --dir /path --output output.tar.gz
//   ./packager.x --tui --dir /path/to/project
//   ./packager.x --cmd info --dir /path/to/project

LibraryImport.Arena
LibraryImport.JSON
LibraryImport.StringUtils
LibraryImport.Hash
LibraryImport.Array
LibraryImport.UtilArgs
LibraryImport.TUI
LibraryImport.TuiWidget
LibraryImport.ANSI

Import.Packager.Packager.IO
Import.Packager.Packager.Scan
Import.Packager.Packager.Parse
Import.Packager.Packager.Graph
Import.Packager.Packager.Manifest
Import.Packager.Packager.Install
Import.Packager.Packager.Build
Import.Packager.Packager.Pack
Import.Packager.Packager.CLI
Import.Packager.Packager.TUI
Import.Packager.Packager.TUI_Render

// Compatibility pool required by Library.TuiWidget and Library.ChatLog
// These fields are referenced by widget draw functions we import transitively.
FixedPool.UILayout {
    "chat_x":      Initialize=1, CanChange=True
    "chat_w":      Initialize=80, CanChange=True
    "chat_top":    Initialize=1, CanChange=True
    "chat_bot":    Initialize=20, CanChange=True
    "chat_cursor": Initialize=1, CanChange=True
    "chat_col":    Initialize=1, CanChange=True
    "rows":        Initialize=24, CanChange=True
    "cols":        Initialize=80, CanChange=True
    "prompt_h":    Initialize=4, CanChange=True
    "initialized": Initialize=0, CanChange=True
}

FixedPool.PkgState {
    "mode":            Initialize=0, CanChange=True
    "project_dir":     Initialize=0, CanChange=True
    "verbose":         Initialize=0, CanChange=True
}

FixedPool.PkgVersion {
    "MAJOR":   Initialize=0
    "MINOR":   Initialize=1
    "PATCH":   Initialize=0
}

SubRoutine.Main {
    // Build CLI schema and parse args
    schema = CLI_BuildSchema()
    args = UtilArgs_ParseCLI(schema)

    IfCondition EqualTo(args, 0) ThenBlock: {
        PrintMessage("AILang Packager v0.1.0")
        PrintMessage("Usage: packager.x --cmd <command> --dir <path>")
        PrintMessage("Commands: scan, graph, build, pack, init, info")
        PrintMessage("Flags: --tui (interactive mode), --verbose")
        SystemCall(PkgSys.SYS_EXIT, 1, 0, 0, 0, 0)
    }

    // Store project directory
    dir = UtilArgs_GetString(args, "dir")
    PkgState.project_dir = dir

    // Verbose flag
    verbose = UtilArgs_GetBool(args, "verbose")
    PkgState.verbose = verbose

    // Check TUI mode
    is_tui = UtilArgs_GetBool(args, "tui")
    IfCondition EqualTo(is_tui, 1) ThenBlock: {
        PkgState.mode = 1
        PkgTUI_Run()
        SystemCall(PkgSys.SYS_EXIT, 0, 0, 0, 0, 0)
    }

    // CLI mode: dispatch on command
    cmd = UtilArgs_GetString(args, "cmd")
    IfCondition EqualTo(cmd, 0) ThenBlock: {
        cmd = "info"
    }
    IfCondition EqualTo(StringLength(cmd), 0) ThenBlock: {
        cmd = "info"
    }

    CLI_Dispatch(cmd, args)
    SystemCall(PkgSys.SYS_EXIT, 0, 0, 0, 0, 0)
}

RunTask(Main)
