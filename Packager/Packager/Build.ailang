// Build.ailang — Build executor using fork+execve+wait4
// Part of AILang Packager
// Provides: Build_Run

FixedPool.BuildState {
    "success_count":  Initialize=0, CanChange=True
    "fail_count":     Initialize=0, CanChange=True
    "total_targets":  Initialize=0, CanChange=True
}

// Run the build for all entry-point .ailang files in the project.
// Uses fork+execve+wait4 to run ailang.x for each target.
Function.Build_Run {
    Input: dir: Address
    Body: {
        BuildState.success_count = 0
        BuildState.fail_count = 0
        BuildState.total_targets = 0

        // Find ailang.x compiler
        compiler = Build_FindCompiler()
        IfCondition EqualTo(compiler, 0) ThenBlock: {
            Pkg_Println("ERROR: Cannot find ailang.x compiler")
            ReturnValue(0)
        }

        // Build each entry point
        count = Scan_GetCount()
        i = 0
        WhileLoop LessThan(i, count) {
            entry = Scan_GetEntry(i)
            ftype = Hash.Get(entry, "type")
            is_entry = Hash.Get(entry, "is_entry")

            IfCondition EqualTo(ftype, FileType.SOURCE) ThenBlock: {
                IfCondition EqualTo(is_entry, 1) ThenBlock: {
                    BuildState.total_targets = Add(BuildState.total_targets, 1)
                    path = Hash.Get(entry, "path")
                    name = Hash.Get(entry, "name")

                    // Derive output name: replace .ailang with .x
                    out_name = Build_DeriveOutputName(name)
                    out_path = Pkg_PathJoin(dir, out_name)

                    Pkg_WriteStr("  Building ")
                    Pkg_WriteStr(name)
                    Pkg_WriteStr(" -> ")
                    Pkg_WriteStr(out_name)
                    Pkg_WriteStr(" ... ")

                    rc = Build_Compile(compiler, path, out_path)
                    IfCondition EqualTo(rc, 0) ThenBlock: {
                        Pkg_Println("[ok]")
                        BuildState.success_count = Add(BuildState.success_count, 1)
                    } ElseBlock: {
                        Pkg_Println("[FAIL]")
                        BuildState.fail_count = Add(BuildState.fail_count, 1)
                    }

                    Deallocate(out_name, 0)
                    Deallocate(out_path, 0)
                }
            }
            i = Add(i, 1)
        }

        // Summary
        Pkg_Println("")
        Pkg_WriteStr("Build complete: ")
        PrintNumber(BuildState.success_count)
        Pkg_WriteStr(" ok, ")
        PrintNumber(BuildState.fail_count)
        Pkg_WriteStr(" failed, ")
        PrintNumber(BuildState.total_targets)
        Pkg_WriteStr(" total")
        Pkg_Println("")
    }
}

// Compile a single source file using fork+execve+wait4.
// Returns 0 on success, non-zero on failure.
Function.Build_Compile {
    Input: compiler: Address
    Input: source: Address
    Input: output: Address
    Output: Integer
    Body: {
        pid = SystemCall(PkgSys.SYS_FORK, 0, 0, 0, 0, 0)
        IfCondition LessThan(pid, 0) ThenBlock: {
            ReturnValue(-1)
        }

        IfCondition EqualTo(pid, 0) ThenBlock: {
            // Child process
            argv = Allocate(32)
            StoreValue(Add(argv, 0), compiler)
            StoreValue(Add(argv, 8), source)
            StoreValue(Add(argv, 16), output)
            StoreValue(Add(argv, 24), 0)

            envp = Allocate(16)
            StoreValue(Add(envp, 0), "PATH=/usr/local/bin:/usr/bin:/bin")
            StoreValue(Add(envp, 8), 0)

            SystemCall(PkgSys.SYS_EXECVE, compiler, argv, envp)
            // If we get here, execve failed
            SystemCall(PkgSys.SYS_EXIT, 127, 0, 0, 0, 0)
        }

        // Parent: wait for child
        status_buf = Allocate(8)
        StoreValue(status_buf, 0)
        SystemCall(PkgSys.SYS_WAIT4, pid, status_buf, 0, 0, 0, 0)
        status = Dereference(status_buf, "dword")
        Deallocate(status_buf, 8)

        // Extract exit code: (status >> 8) & 0xFF
        exit_code = BitwiseAnd(RightShift(status, 8), 255)
        ReturnValue(exit_code)
    }
}

// Find the ailang.x compiler. Checks common locations.
Function.Build_FindCompiler {
    Output: Address
    Body: {
        // Check if ailang.x is in the compiler tree
        path1 = "/home/bob/Ailang-Self-Hosting-/ailang.x"
        fd = SystemCall(PkgSys.SYS_OPEN, path1, PkgSys.O_RDONLY, 0)
        IfCondition GreaterEqual(fd, 0) ThenBlock: {
            SystemCall(PkgSys.SYS_CLOSE, fd, 0, 0, 0, 0)
            ReturnValue(path1)
        }

        // Check PATH via which-like approach
        // For now, just try common paths
        path2 = "/usr/local/bin/ailang.x"
        fd = SystemCall(PkgSys.SYS_OPEN, path2, PkgSys.O_RDONLY, 0)
        IfCondition GreaterEqual(fd, 0) ThenBlock: {
            SystemCall(PkgSys.SYS_CLOSE, fd, 0, 0, 0, 0)
            ReturnValue(path2)
        }

        ReturnValue(0)
    }
}

// Derive output binary name from source name.
// "foo.ailang" -> "foo.x"
Function.Build_DeriveOutputName {
    Input: name: Address
    Output: Address
    Body: {
        len = StringLength(name)
        ext = ".ailang"
        ext_len = 7

        IfCondition EqualTo(Pkg_EndsWith(name, ext), 1) ThenBlock: {
            base_len = Subtract(len, ext_len)
            base = Allocate(Add(base_len, 1))
            MemoryCopy(base, name, base_len)
            SetByte(base, base_len, 0)
            result = StringConcat(base, ".x")
            Deallocate(base, 0)
            ReturnValue(result)
        }

        // Fallback: just append .x
        result = StringConcat(name, ".x")
        ReturnValue(result)
    }
}
