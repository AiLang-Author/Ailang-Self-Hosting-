// CLI.ailang — Command-line interface dispatch
// Part of AILang Packager
// Provides: CLI_BuildSchema, CLI_Dispatch

LibraryImport.UtilArgs

// Build the CLI argument schema for the packager.
Function.CLI_BuildSchema {
    Output: Address
    Body: {
        s = UtilArgs_NewSchema("packager", "AILang Packager - scan, build, and package AILang projects")

        UtilArgs_AddField(s, "cmd", "string", 0, "Command: scan|graph|build|pack|init|info", "cmd")
        UtilArgs_SetShort(s, "cmd", "c")
        UtilArgs_SetDefault(s, "cmd", "info")

        UtilArgs_AddField(s, "dir", "path", 0, "Project directory to scan", "dir")
        UtilArgs_SetShort(s, "dir", "d")
        UtilArgs_SetDefault(s, "dir", ".")

        UtilArgs_AddField(s, "output", "path", 0, "Output path for archive", "output")
        UtilArgs_SetShort(s, "output", "o")

        UtilArgs_AddField(s, "tui", "bool", 0, "Launch interactive TUI mode", "tui")
        UtilArgs_SetShort(s, "tui", "t")

        UtilArgs_AddField(s, "verbose", "bool", 0, "Verbose output", "verbose")
        UtilArgs_SetShort(s, "verbose", "v")

        ReturnValue(s)
    }
}

// Dispatch a CLI command.
Function.CLI_Dispatch {
    Input: cmd: Address
    Input: args: Address
    Body: {
        dir = UtilArgs_GetString(args, "dir")

        // scan command
        IfCondition EqualTo(StringCompare(cmd, "scan"), 0) ThenBlock: {
            CLI_CmdScan(dir)
            ReturnValue(0)
        }

        // graph command
        IfCondition EqualTo(StringCompare(cmd, "graph"), 0) ThenBlock: {
            CLI_CmdGraph(dir)
            ReturnValue(0)
        }

        // init command
        IfCondition EqualTo(StringCompare(cmd, "init"), 0) ThenBlock: {
            CLI_CmdInit(dir)
            ReturnValue(0)
        }

        // info command (default)
        IfCondition EqualTo(StringCompare(cmd, "info"), 0) ThenBlock: {
            CLI_CmdInfo(dir)
            ReturnValue(0)
        }

        // build command
        IfCondition EqualTo(StringCompare(cmd, "build"), 0) ThenBlock: {
            CLI_CmdBuild(dir)
            ReturnValue(0)
        }

        // pack command
        IfCondition EqualTo(StringCompare(cmd, "pack"), 0) ThenBlock: {
            output = UtilArgs_GetString(args, "output")
            CLI_CmdPack(dir, output)
            ReturnValue(0)
        }

        // Unknown command
        Pkg_WriteStr("Unknown command: ")
        Pkg_Println(cmd)
        Pkg_Println("Available: scan, graph, build, pack, init, info")
    }
}

// CLI: scan command
Function.CLI_CmdScan {
    Input: dir: Address
    Body: {
        Pkg_WriteStr("Scanning ")
        Pkg_WriteStr(dir)
        Pkg_Println("...")
        Pkg_Println("")

        Scan_Init()
        ScanState.base_dir = dir
        Scan_Directory(dir, 0)
        Scan_PrintSummary()
    }
}

// CLI: graph command
Function.CLI_CmdGraph {
    Input: dir: Address
    Body: {
        Pkg_WriteStr("Building dependency graph for ")
        Pkg_WriteStr(dir)
        Pkg_Println("...")
        Pkg_Println("")

        Scan_Init()
        ScanState.base_dir = dir
        Scan_Directory(dir, 0)

        Parse_AllFiles()
        Graph_Build()

        has_cycle = Graph_DetectCycles()
        IfCondition EqualTo(has_cycle, 1) ThenBlock: {
            Pkg_Println("WARNING: Dependency cycle detected!")
            Pkg_WriteStr("  Cycle: ")
            Pkg_Println(GraphState.cycle_path)
            Pkg_Println("")
        }

        Graph_TopoSort()
        Graph_PrintAll()
    }
}

// CLI: init command
Function.CLI_CmdInit {
    Input: dir: Address
    Body: {
        Pkg_WriteStr("Initializing package in ")
        Pkg_WriteStr(dir)
        Pkg_Println("...")
        Pkg_Println("")

        Scan_Init()
        ScanState.base_dir = dir
        Scan_Directory(dir, 0)

        Manifest_Create(dir)
        Manifest_Save(dir)
        Pkg_Println("Created package.json")

        Install_Generate()
        Install_Write(dir)
        Pkg_Println("Created install.sh")
    }
}

// CLI: info command
Function.CLI_CmdInfo {
    Input: dir: Address
    Body: {
        Pkg_WriteStr("Project info for ")
        Pkg_WriteStr(dir)
        Pkg_Println("...")
        Pkg_Println("")

        // Try to load manifest
        manifest_ok = Manifest_Load(dir)
        IfCondition EqualTo(manifest_ok, 1) ThenBlock: {
            Manifest_Print()
            Pkg_Println("")
        } ElseBlock: {
            Pkg_Println("No package.json found. Run --cmd init to create one.")
            Pkg_Println("")
        }

        // Scan for summary
        Scan_Init()
        ScanState.base_dir = dir
        Scan_Directory(dir, 0)
        Scan_PrintSummary()
    }
}

// CLI: build command
Function.CLI_CmdBuild {
    Input: dir: Address
    Body: {
        Pkg_WriteStr("Building project in ")
        Pkg_WriteStr(dir)
        Pkg_Println("...")
        Pkg_Println("")

        Scan_Init()
        ScanState.base_dir = dir
        Scan_Directory(dir, 0)
        Parse_AllFiles()
        Graph_Build()
        Graph_TopoSort()
        Build_Run(dir)
    }
}

// CLI: pack command
Function.CLI_CmdPack {
    Input: dir: Address
    Input: output: Address
    Body: {
        Pkg_WriteStr("Packing project in ")
        Pkg_WriteStr(dir)
        Pkg_Println("...")

        Scan_Init()
        ScanState.base_dir = dir
        Scan_Directory(dir, 0)

        manifest_ok = Manifest_Load(dir)
        IfCondition EqualTo(manifest_ok, 0) ThenBlock: {
            Pkg_Println("No package.json found. Run --cmd init first.")
            ReturnValue(0)
        }

        Pack_Create(dir, output)
    }
}
