// Graph.ailang — Dependency graph with cycle detection and topological sort
// Part of AILang Packager
// Provides: Graph_Build, Graph_DetectCycles, Graph_TopoSort, Graph_PrintAll

LibraryImport.Hash
LibraryImport.Array

FixedPool.GraphState {
    "adj":          Initialize=0, CanChange=True
    "reverse_adj":  Initialize=0, CanChange=True
    "all_nodes":    Initialize=0, CanChange=True
    "node_count":   Initialize=0, CanChange=True
    "topo_order":   Initialize=0, CanChange=True
    "topo_count":   Initialize=0, CanChange=True
    "has_cycle":    Initialize=0, CanChange=True
    "cycle_path":   Initialize=0, CanChange=True
}

FixedPool.DFSColor {
    "WHITE":  Initialize=0
    "GRAY":   Initialize=1
    "BLACK":  Initialize=2
}

// Build the dependency graph from scanned and parsed files.
Function.Graph_Build {
    Body: {
        GraphState.adj = Hash.Create(256)
        GraphState.reverse_adj = Hash.Create(256)
        GraphState.all_nodes = Array.Create(128)
        GraphState.node_count = 0
        GraphState.has_cycle = 0
        GraphState.cycle_path = 0

        count = Scan_GetCount()
        i = 0
        WhileLoop LessThan(i, count) {
            entry = Scan_GetEntry(i)
            ftype = Hash.Get(entry, "type")

            IfCondition EqualTo(ftype, FileType.SOURCE) ThenBlock: {
                path = Hash.Get(entry, "path")
                imports = Hash.Get(entry, "imports")

                // Register this node
                Hash.Set(GraphState.adj, path, imports)
                Array.Push(GraphState.all_nodes, path)
                GraphState.node_count = Add(GraphState.node_count, 1)

                // Build reverse edges
                IfCondition NotEqual(imports, 0) ThenBlock: {
                    imp_count = Array.Size(imports)
                    j = 0
                    WhileLoop LessThan(j, imp_count) {
                        dep = Array.Get(imports, j)
                        existing = Hash.Get(GraphState.reverse_adj, dep)
                        IfCondition EqualTo(existing, 0) ThenBlock: {
                            existing = Array.Create(8)
                            Hash.Set(GraphState.reverse_adj, dep, existing)
                        }
                        Array.Push(existing, path)
                        j = Add(j, 1)
                    }
                }
            }
            i = Add(i, 1)
        }
    }
}

// DFS visit for cycle detection. Returns 1 if cycle found.
Function.Graph_DFSVisit {
    Input: node: Address
    Input: color: Address
    Output: Integer
    Body: {
        Hash.Set(color, node, DFSColor.GRAY)

        deps = Hash.Get(GraphState.adj, node)
        IfCondition NotEqual(deps, 0) ThenBlock: {
            dep_count = Array.Size(deps)
            i = 0
            WhileLoop LessThan(i, dep_count) {
                dep = Array.Get(deps, i)
                dep_color = Hash.Get(color, dep)

                IfCondition EqualTo(dep_color, DFSColor.GRAY) ThenBlock: {
                    // Back edge = cycle
                    tmp = StringConcat(node, " -> ")
                    GraphState.cycle_path = StringConcat(tmp, dep)
                    Deallocate(tmp, 0)
                    ReturnValue(1)
                }

                IfCondition EqualTo(dep_color, DFSColor.WHITE) ThenBlock: {
                    result = Graph_DFSVisit(dep, color)
                    IfCondition EqualTo(result, 1) ThenBlock: {
                        ReturnValue(1)
                    }
                }

                i = Add(i, 1)
            }
        }

        Hash.Set(color, node, DFSColor.BLACK)
        ReturnValue(0)
    }
}

// Detect cycles in the dependency graph using DFS 3-coloring.
// Returns 1 if cycle found, 0 otherwise.
Function.Graph_DetectCycles {
    Output: Integer
    Body: {
        color = Hash.Create(256)

        // Initialize all nodes to WHITE
        i = 0
        WhileLoop LessThan(i, GraphState.node_count) {
            node = Array.Get(GraphState.all_nodes, i)
            Hash.Set(color, node, DFSColor.WHITE)
            i = Add(i, 1)
        }

        // Run DFS from each unvisited node
        i = 0
        WhileLoop LessThan(i, GraphState.node_count) {
            node = Array.Get(GraphState.all_nodes, i)
            c = Hash.Get(color, node)
            IfCondition EqualTo(c, DFSColor.WHITE) ThenBlock: {
                found = Graph_DFSVisit(node, color)
                IfCondition EqualTo(found, 1) ThenBlock: {
                    GraphState.has_cycle = 1
                    Hash.Destroy(color)
                    ReturnValue(1)
                }
            }
            i = Add(i, 1)
        }

        Hash.Destroy(color)
        ReturnValue(0)
    }
}

// Topological sort using Kahn's algorithm.
// Stores result in GraphState.topo_order.
Function.Graph_TopoSort {
    Body: {
        in_degree = Hash.Create(256)

        // Initialize all in-degrees to 0
        i = 0
        WhileLoop LessThan(i, GraphState.node_count) {
            node = Array.Get(GraphState.all_nodes, i)
            Hash.Set(in_degree, node, 0)
            i = Add(i, 1)
        }

        // Count incoming edges
        i = 0
        WhileLoop LessThan(i, GraphState.node_count) {
            node = Array.Get(GraphState.all_nodes, i)
            deps = Hash.Get(GraphState.adj, node)
            IfCondition NotEqual(deps, 0) ThenBlock: {
                dep_count = Array.Size(deps)
                j = 0
                WhileLoop LessThan(j, dep_count) {
                    dep = Array.Get(deps, j)
                    cur = Hash.Get(in_degree, dep)
                    // Only count if the dep is a known node
                    IfCondition NotEqual(cur, 0) ThenBlock: {
                        Hash.Set(in_degree, dep, Add(cur, 1))
                    } ElseBlock: {
                        // External dep (library) - check if it has an entry
                        has = Hash.Contains(in_degree, dep)
                        IfCondition EqualTo(has, 1) ThenBlock: {
                            Hash.Set(in_degree, dep, 1)
                        }
                    }
                    j = Add(j, 1)
                }
            }
            i = Add(i, 1)
        }

        // Queue: nodes with in_degree 0
        queue = Array.Create(128)
        i = 0
        WhileLoop LessThan(i, GraphState.node_count) {
            node = Array.Get(GraphState.all_nodes, i)
            deg = Hash.Get(in_degree, node)
            IfCondition EqualTo(deg, 0) ThenBlock: {
                Array.Push(queue, node)
            }
            i = Add(i, 1)
        }

        // BFS
        result = Array.Create(128)
        qi = 0
        WhileLoop LessThan(qi, Array.Size(queue)) {
            node = Array.Get(queue, qi)
            qi = Add(qi, 1)
            Array.Push(result, node)

            // For each node that depends on this one (reverse edges)
            dependents = Hash.Get(GraphState.reverse_adj, node)
            IfCondition NotEqual(dependents, 0) ThenBlock: {
                dep_count = Array.Size(dependents)
                j = 0
                WhileLoop LessThan(j, dep_count) {
                    dep = Array.Get(dependents, j)
                    cur = Hash.Get(in_degree, dep)
                    new_deg = Subtract(cur, 1)
                    Hash.Set(in_degree, dep, new_deg)
                    IfCondition EqualTo(new_deg, 0) ThenBlock: {
                        Array.Push(queue, dep)
                    }
                    j = Add(j, 1)
                }
            }
        }

        GraphState.topo_order = result
        GraphState.topo_count = Array.Size(result)
        Hash.Destroy(in_degree)
        Array.Destroy(queue)
    }
}

// Print the dependency graph and topological order.
Function.Graph_PrintAll {
    Body: {
        Pkg_Println("Dependency Graph:")
        Pkg_Println("")

        i = 0
        WhileLoop LessThan(i, GraphState.node_count) {
            node = Array.Get(GraphState.all_nodes, i)
            Pkg_WriteStr("  ")
            Pkg_Println(node)

            deps = Hash.Get(GraphState.adj, node)
            IfCondition NotEqual(deps, 0) ThenBlock: {
                dep_count = Array.Size(deps)
                j = 0
                WhileLoop LessThan(j, dep_count) {
                    dep = Array.Get(deps, j)
                    Pkg_WriteStr("    -> ")
                    Pkg_Println(dep)
                    j = Add(j, 1)
                }
            }
            Pkg_Println("")
            i = Add(i, 1)
        }

        // Print topological order
        IfCondition GreaterThan(GraphState.topo_count, 0) ThenBlock: {
            Pkg_Println("Topological order (build sequence):")
            i = 0
            WhileLoop LessThan(i, GraphState.topo_count) {
                node = Array.Get(GraphState.topo_order, i)
                Pkg_WriteStr("  ")
                PrintNumber(Add(i, 1))
                Pkg_WriteStr(". ")
                Pkg_Println(node)
                i = Add(i, 1)
            }
            Pkg_Println("")
        }

        // Cycle status
        IfCondition EqualTo(GraphState.has_cycle, 1) ThenBlock: {
            Pkg_Println("Cycles: YES (see warning above)")
        } ElseBlock: {
            Pkg_Println("Cycles: none")
        }
    }
}
