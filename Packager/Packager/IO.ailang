// IO.ailang — Syscall wrappers for file I/O
// Part of AILang Packager
// Provides: Pkg_Open, Pkg_Close, Pkg_Read, Pkg_Write, Pkg_ReadFile,
//           Pkg_WriteFile, Pkg_WriteStr, Pkg_FileSize, Pkg_Println, Pkg_PrintNum

FixedPool.PkgSys {
    "SYS_READ":       Initialize=0
    "SYS_WRITE":      Initialize=1
    "SYS_OPEN":       Initialize=2
    "SYS_CLOSE":      Initialize=3
    "SYS_STAT":       Initialize=4
    "SYS_LSEEK":      Initialize=8
    "SYS_FORK":       Initialize=57
    "SYS_EXECVE":     Initialize=59
    "SYS_EXIT":       Initialize=60
    "SYS_WAIT4":      Initialize=61
    "SYS_KILL":       Initialize=62
    "SYS_MKDIR":      Initialize=83
    "SYS_CHMOD":      Initialize=90
    "SYS_GETDENTS64": Initialize=217
    "O_RDONLY":       Initialize=0
    "O_WRONLY":       Initialize=1
    "O_RDWR":         Initialize=2
    "O_CREAT":        Initialize=64
    "O_TRUNC":        Initialize=512
    "O_APPEND":       Initialize=1024
    "O_DIRECTORY":    Initialize=65536
    "FMODE":          Initialize=420
}

// Open a file. Returns fd or negative on error.
Function.Pkg_Open {
    Input: path: Address
    Input: flags: Integer
    Output: Integer
    Body: {
        fd = SystemCall(PkgSys.SYS_OPEN, path, flags, PkgSys.FMODE)
        ReturnValue(fd)
    }
}

// Close a file descriptor.
Function.Pkg_Close {
    Input: fd: Integer
    Body: {
        SystemCall(PkgSys.SYS_CLOSE, fd, 0, 0, 0, 0)
    }
}

// Read bytes from fd into buf. Returns bytes read.
Function.Pkg_Read {
    Input: fd: Integer
    Input: buf: Address
    Input: count: Integer
    Output: Integer
    Body: {
        n = SystemCall(PkgSys.SYS_READ, fd, buf, count, 0, 0)
        ReturnValue(n)
    }
}

// Write bytes from buf to fd. Returns bytes written.
Function.Pkg_Write {
    Input: fd: Integer
    Input: buf: Address
    Input: count: Integer
    Output: Integer
    Body: {
        n = SystemCall(PkgSys.SYS_WRITE, fd, buf, count, 0, 0)
        ReturnValue(n)
    }
}

// Get file size via lseek to end and back.
Function.Pkg_FileSize {
    Input: path: Address
    Output: Integer
    Body: {
        fd = Pkg_Open(path, PkgSys.O_RDONLY)
        IfCondition LessThan(fd, 0) ThenBlock: {
            ReturnValue(-1)
        }
        // lseek(fd, 0, SEEK_END=2)
        size = SystemCall(PkgSys.SYS_LSEEK, fd, 0, 2, 0, 0)
        Pkg_Close(fd)
        ReturnValue(size)
    }
}

// Read entire file into a newly allocated null-terminated buffer.
// Returns Address to content (caller must Deallocate).
// Returns 0 on failure.
Function.Pkg_ReadFile {
    Input: path: Address
    Output: Address
    Body: {
        fd = Pkg_Open(path, PkgSys.O_RDONLY)
        IfCondition LessThan(fd, 0) ThenBlock: {
            ReturnValue(0)
        }

        // Get file size via lseek
        size = SystemCall(PkgSys.SYS_LSEEK, fd, 0, 2, 0, 0)
        IfCondition LessEqual(size, 0) ThenBlock: {
            Pkg_Close(fd)
            ReturnValue(0)
        }

        // Seek back to start
        SystemCall(PkgSys.SYS_LSEEK, fd, 0, 0, 0, 0)

        // Allocate buffer with space for null terminator
        buf = Allocate(Add(size, 1))
        total = 0

        WhileLoop LessThan(total, size) {
            remain = Subtract(size, total)
            chunk = 65536
            IfCondition LessThan(remain, chunk) ThenBlock: {
                chunk = remain
            }
            n = SystemCall(PkgSys.SYS_READ, fd, Add(buf, total), chunk, 0, 0)
            IfCondition LessEqual(n, 0) ThenBlock: {
                BreakLoop
            }
            total = Add(total, n)
        }

        // Null-terminate
        SetByte(buf, total, 0)
        Pkg_Close(fd)
        ReturnValue(buf)
    }
}

// Write string content to a file (creates/truncates).
Function.Pkg_WriteFile {
    Input: path: Address
    Input: content: Address
    Output: Integer
    Body: {
        flags = Add(PkgSys.O_WRONLY, Add(PkgSys.O_CREAT, PkgSys.O_TRUNC))
        fd = SystemCall(PkgSys.SYS_OPEN, path, flags, PkgSys.FMODE)
        IfCondition LessThan(fd, 0) ThenBlock: {
            ReturnValue(-1)
        }
        len = StringLength(content)
        IfCondition GreaterThan(len, 0) ThenBlock: {
            SystemCall(PkgSys.SYS_WRITE, fd, content, len, 0, 0)
        }
        Pkg_Close(fd)
        ReturnValue(0)
    }
}

// Write a string to stdout.
Function.Pkg_WriteStr {
    Input: s: Address
    Body: {
        len = StringLength(s)
        IfCondition GreaterThan(len, 0) ThenBlock: {
            SystemCall(PkgSys.SYS_WRITE, 1, s, len, 0, 0)
        }
    }
}

// Write a string to stdout followed by a newline.
Function.Pkg_Println {
    Input: s: Address
    Body: {
        Pkg_WriteStr(s)
        nl = Allocate(2)
        SetByte(nl, 0, 10)
        SetByte(nl, 1, 0)
        Pkg_WriteStr(nl)
        Deallocate(nl, 2)
    }
}

// Write an integer to stdout.
Function.Pkg_PrintNum {
    Input: n: Integer
    Body: {
        PrintNumber(n)
    }
}

// Create a directory. Returns 0 on success or if exists, negative on error.
Function.Pkg_Mkdir {
    Input: path: Address
    Output: Integer
    Body: {
        result = SystemCall(PkgSys.SYS_MKDIR, path, PkgSys.FMODE, 0, 0, 0)
        // -17 = EEXIST, which is fine
        IfCondition EqualTo(result, -17) ThenBlock: {
            ReturnValue(0)
        }
        ReturnValue(result)
    }
}

// Concatenate two path segments with a '/' separator.
// Returns new allocated string.
Function.Pkg_PathJoin {
    Input: dir: Address
    Input: name: Address
    Output: Address
    Body: {
        sep = Allocate(2)
        SetByte(sep, 0, 47)
        SetByte(sep, 1, 0)
        tmp = StringConcat(dir, sep)
        result = StringConcat(tmp, name)
        Deallocate(sep, 2)
        Deallocate(tmp, 0)
        ReturnValue(result)
    }
}

// Copy a null-terminated string from src to a new allocation.
Function.Pkg_StrDup {
    Input: src: Address
    Output: Address
    Body: {
        len = StringLength(src)
        dst = Allocate(Add(len, 1))
        MemoryCopy(dst, src, Add(len, 1))
        ReturnValue(dst)
    }
}

// Check if a string ends with a given suffix.
// Returns 1 if yes, 0 if no.
Function.Pkg_EndsWith {
    Input: str: Address
    Input: suffix: Address
    Output: Integer
    Body: {
        slen = StringLength(str)
        xlen = StringLength(suffix)
        IfCondition LessThan(slen, xlen) ThenBlock: {
            ReturnValue(0)
        }
        offset = Subtract(slen, xlen)
        i = 0
        WhileLoop LessThan(i, xlen) {
            a = GetByte(str, Add(offset, i))
            b = GetByte(suffix, i)
            IfCondition NotEqual(a, b) ThenBlock: {
                ReturnValue(0)
            }
            i = Add(i, 1)
        }
        ReturnValue(1)
    }
}
