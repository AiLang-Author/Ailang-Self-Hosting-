// Install.ailang — Install script generator
// Part of AILang Packager
// Provides: Install_Generate, Install_Write

FixedPool.InstallState {
    "content":  Initialize=0, CanChange=True
}

// Generate install.sh content from the loaded manifest.
// Stores result in InstallState.content.
Function.Install_Generate {
    Body: {
        IfCondition EqualTo(ManifestState.loaded, 0) ThenBlock: {
            ReturnValue(0)
        }

        obj = ManifestState.json
        name = JSON.GetString(obj, "name")
        ver = JSON.GetString(obj, "version")

        install_obj = JSON.GetObject(obj, "install")
        install_dir = "/usr/local/lib/package"
        bin_dir = "/usr/local/bin"
        do_symlink = "false"
        entry_str = JSON.GetString(obj, "entry")
        post_install = ""

        IfCondition NotEqual(install_obj, 0) ThenBlock: {
            tmp = JSON.GetString(install_obj, "dir")
            IfCondition NotEqual(tmp, 0) ThenBlock: { install_dir = tmp }
            tmp = JSON.GetString(install_obj, "bin_dir")
            IfCondition NotEqual(tmp, 0) ThenBlock: { bin_dir = tmp }
            tmp = JSON.GetString(install_obj, "symlink")
            IfCondition NotEqual(tmp, 0) ThenBlock: { do_symlink = tmp }
            tmp = JSON.GetString(install_obj, "post_install")
            IfCondition NotEqual(tmp, 0) ThenBlock: { post_install = tmp }
        }

        // Build script via StringConcat chain
        // Each line ends with byte 10 (newline)
        nl = Allocate(2)
        SetByte(nl, 0, 10)
        SetByte(nl, 1, 0)

        s = Pkg_StrDup("#!/usr/bin/env bash")
        s = Install_Append(s, nl)
        s = Install_Append(s, "# install.sh -- generated by AILang Packager")
        s = Install_Append(s, nl)

        t1 = StringConcat("# Package: ", name)
        t2 = StringConcat(t1, " v")
        Deallocate(t1, 0)
        t1 = StringConcat(t2, ver)
        Deallocate(t2, 0)
        s = Install_Append(s, t1)
        Deallocate(t1, 0)
        s = Install_Append(s, nl)

        s = Install_Append(s, "set -euo pipefail")
        s = Install_Append(s, nl)
        s = Install_Append(s, nl)

        // INSTALL_DIR variable
        t1 = StringConcat("INSTALL_DIR=\"", install_dir)
        t2 = StringConcat(t1, "\"")
        Deallocate(t1, 0)
        s = Install_Append(s, t2)
        Deallocate(t2, 0)
        s = Install_Append(s, nl)

        // BIN_DIR variable
        t1 = StringConcat("BIN_DIR=\"", bin_dir)
        t2 = StringConcat(t1, "\"")
        Deallocate(t1, 0)
        s = Install_Append(s, t2)
        Deallocate(t2, 0)
        s = Install_Append(s, nl)
        s = Install_Append(s, nl)

        // Echo
        t1 = StringConcat("echo \"Installing ", name)
        t2 = StringConcat(t1, " v")
        Deallocate(t1, 0)
        t1 = StringConcat(t2, ver)
        Deallocate(t2, 0)
        t2 = StringConcat(t1, "...\"")
        Deallocate(t1, 0)
        s = Install_Append(s, t2)
        Deallocate(t2, 0)
        s = Install_Append(s, nl)
        s = Install_Append(s, nl)

        // Create directories
        s = Install_Append(s, "# Create directories")
        s = Install_Append(s, nl)
        s = Install_Append(s, "mkdir -p \"$INSTALL_DIR\" \"$BIN_DIR\"")
        s = Install_Append(s, nl)
        s = Install_Append(s, nl)

        // Copy files
        s = Install_Append(s, "# Copy files")
        s = Install_Append(s, nl)
        s = Install_Append(s, "cp -r ./*.x \"$INSTALL_DIR/\" 2>/dev/null || true")
        s = Install_Append(s, nl)
        s = Install_Append(s, "cp -r ./*.ailang \"$INSTALL_DIR/\" 2>/dev/null || true")
        s = Install_Append(s, nl)
        s = Install_Append(s, "cp -r ./*.json \"$INSTALL_DIR/\" 2>/dev/null || true")
        s = Install_Append(s, nl)
        s = Install_Append(s, "cp -r ./*.md \"$INSTALL_DIR/\" 2>/dev/null || true")
        s = Install_Append(s, nl)
        s = Install_Append(s, nl)

        // Permissions
        s = Install_Append(s, "# Set permissions")
        s = Install_Append(s, nl)
        s = Install_Append(s, "chmod +x \"$INSTALL_DIR\"/*.x 2>/dev/null || true")
        s = Install_Append(s, nl)
        s = Install_Append(s, nl)

        // Symlink
        IfCondition EqualTo(StringCompare(do_symlink, "true"), 0) ThenBlock: {
            IfCondition NotEqual(entry_str, 0) ThenBlock: {
                IfCondition GreaterThan(StringLength(entry_str), 0) ThenBlock: {
                    // Derive binary name: replace .ailang with .x
                    entry_len = StringLength(entry_str)
                    bin_name = Allocate(Add(entry_len, 1))
                    MemoryCopy(bin_name, entry_str, entry_len)
                    SetByte(bin_name, entry_len, 0)
                    // Check if ends in .ailang (7 chars) and replace with .x
                    IfCondition GreaterThan(entry_len, 7) ThenBlock: {
                        suffix_pos = Subtract(entry_len, 7)
                        SetByte(bin_name, suffix_pos, 46)
                        SetByte(bin_name, Add(suffix_pos, 1), 120)
                        SetByte(bin_name, Add(suffix_pos, 2), 0)
                    }
                    s = Install_Append(s, "# Symlink entry point")
                    s = Install_Append(s, nl)
                    t1 = StringConcat("ln -sf \"$INSTALL_DIR/", bin_name)
                    t2 = StringConcat(t1, "\" \"$BIN_DIR/")
                    Deallocate(t1, 0)
                    t1 = StringConcat(t2, name)
                    Deallocate(t2, 0)
                    t2 = StringConcat(t1, "\"")
                    Deallocate(t1, 0)
                    s = Install_Append(s, t2)
                    Deallocate(t2, 0)
                    s = Install_Append(s, nl)
                    s = Install_Append(s, nl)
                    Deallocate(bin_name, 0)
                }
            }
        }

        // Post-install hook
        IfCondition GreaterThan(StringLength(post_install), 0) ThenBlock: {
            s = Install_Append(s, "# Post-install hook")
            s = Install_Append(s, nl)
            t1 = StringConcat("\"$INSTALL_DIR/", post_install)
            t2 = StringConcat(t1, "\"")
            Deallocate(t1, 0)
            s = Install_Append(s, t2)
            Deallocate(t2, 0)
            s = Install_Append(s, nl)
            s = Install_Append(s, nl)
        }

        // Done message
        t1 = StringConcat("echo \"Installed ", name)
        t2 = StringConcat(t1, " v")
        Deallocate(t1, 0)
        t1 = StringConcat(t2, ver)
        Deallocate(t2, 0)
        t2 = StringConcat(t1, " to $INSTALL_DIR\"")
        Deallocate(t1, 0)
        s = Install_Append(s, t2)
        Deallocate(t2, 0)
        s = Install_Append(s, nl)

        Deallocate(nl, 2)
        InstallState.content = s
    }
}

// Helper: append a string to the accumulator, freeing the old one.
Function.Install_Append {
    Input: acc: Address
    Input: addition: Address
    Output: Address
    Body: {
        result = StringConcat(acc, addition)
        Deallocate(acc, 0)
        ReturnValue(result)
    }
}

// Write install.sh to the given directory.
Function.Install_Write {
    Input: dir: Address
    Body: {
        IfCondition EqualTo(InstallState.content, 0) ThenBlock: {
            ReturnValue(0)
        }
        path = Pkg_PathJoin(dir, "install.sh")
        Pkg_WriteFile(path, InstallState.content)

        // Make executable: chmod 0755 (= 493)
        SystemCall(PkgSys.SYS_CHMOD, path, 493, 0, 0, 0)
        Deallocate(path, 0)
    }
}
