// Manifest.ailang — Package manifest (package.json) read/write
// Part of AILang Packager
// Provides: Manifest_Load, Manifest_Create, Manifest_Save, Manifest_Print,
//           Manifest_GetName, Manifest_GetVersion

LibraryImport.JSON

FixedPool.ManifestState {
    "json":    Initialize=0, CanChange=True
    "path":    Initialize=0, CanChange=True
    "dirty":   Initialize=0, CanChange=True
    "loaded":  Initialize=0, CanChange=True
}

// Load package.json from a directory. Returns 1 on success, 0 on failure.
Function.Manifest_Load {
    Input: dir: Address
    Output: Integer
    Body: {
        mpath = Pkg_PathJoin(dir, "package.json")
        content = Pkg_ReadFile(mpath)
        IfCondition EqualTo(content, 0) ThenBlock: {
            Deallocate(mpath, 0)
            ReturnValue(0)
        }

        parsed = ParseJSON(content)
        Deallocate(content, 0)
        IfCondition EqualTo(parsed, 0) ThenBlock: {
            Deallocate(mpath, 0)
            ReturnValue(0)
        }

        ManifestState.json = parsed
        ManifestState.path = mpath
        ManifestState.dirty = 0
        ManifestState.loaded = 1
        ReturnValue(1)
    }
}

// Create a new manifest from scan results.
Function.Manifest_Create {
    Input: dir: Address
    Body: {
        obj = JSON.NewObject()

        // Extract directory basename for package name
        dir_len = StringLength(dir)
        last_slash = 0
        i = 0
        WhileLoop LessThan(i, dir_len) {
            IfCondition EqualTo(GetByte(dir, i), 47) ThenBlock: {
                last_slash = Add(i, 1)
            }
            i = Add(i, 1)
        }
        basename_len = Subtract(dir_len, last_slash)
        basename = Allocate(Add(basename_len, 1))
        MemoryCopy(basename, Add(dir, last_slash), basename_len)
        SetByte(basename, basename_len, 0)

        JSON.SetString(obj, "name", basename)
        JSON.SetString(obj, "version", "1.0.0")
        JSON.SetString(obj, "description", "An AILang project")
        JSON.SetString(obj, "author", "")
        JSON.SetString(obj, "license", "SCSL")
        JSON.SetString(obj, "entry", "")

        // Find entry point from scan results.
        // Prefer the file matching <project_name>.ailang, else first entry.
        expected_entry = StringConcat(basename, ".ailang")
        count = Scan_GetCount()
        first_entry = 0
        i = 0
        WhileLoop LessThan(i, count) {
            entry = Scan_GetEntry(i)
            is_entry = Hash.Get(entry, "is_entry")
            IfCondition EqualTo(is_entry, 1) ThenBlock: {
                name = Hash.Get(entry, "name")
                IfCondition EqualTo(StringCompare(name, expected_entry), 0) ThenBlock: {
                    JSON.SetString(obj, "entry", name)
                    first_entry = 0
                    BreakLoop
                }
                IfCondition EqualTo(first_entry, 0) ThenBlock: {
                    first_entry = name
                }
            }
            i = Add(i, 1)
        }
        // Fallback: use first entry point found
        IfCondition NotEqual(first_entry, 0) ThenBlock: {
            JSON.SetString(obj, "entry", first_entry)
        }
        Deallocate(expected_entry, 0)

        // Build section
        build = JSON.NewObject()
        JSON.SetString(build, "compiler", "ailang.x")
        JSON.SetString(build, "script", "")
        JSON.SetObject(obj, "build", build)

        // Files section
        files = JSON.NewObject()
        inc = JSON.NewArray()
        JSON.PushString(inc, "*.x")
        JSON.PushString(inc, "*.ailang")
        JSON.PushString(inc, "*.json")
        JSON.PushString(inc, "*.md")
        JSON.SetArray(files, "include", inc)

        exc = JSON.NewArray()
        JSON.PushString(exc, ".git")
        JSON.PushString(exc, "*.log")
        JSON.PushString(exc, "*.bak")
        JSON.PushString(exc, "nohup.out")
        JSON.SetArray(files, "exclude", exc)
        JSON.SetObject(obj, "files", files)

        // Install section
        install = JSON.NewObject()
        tmp1 = StringConcat("/usr/local/lib/", basename)
        JSON.SetString(install, "dir", tmp1)
        // tmp1 now owned by JSON object — do not deallocate
        JSON.SetString(install, "bin_dir", "/usr/local/bin")
        JSON.SetString(install, "symlink", "true")
        JSON.SetString(install, "post_install", "")
        JSON.SetObject(obj, "install", install)

        // basename now owned by JSON object (via SetString) — do not deallocate

        ManifestState.json = obj
        ManifestState.dirty = 1
        ManifestState.loaded = 1
    }
}

// Save manifest to package.json in the given directory.
Function.Manifest_Save {
    Input: dir: Address
    Body: {
        IfCondition EqualTo(ManifestState.loaded, 0) ThenBlock: {
            ReturnValue(0)
        }
        mpath = Pkg_PathJoin(dir, "package.json")
        content = JSON.SerializeObject(ManifestState.json)
        Pkg_WriteFile(mpath, content)
        Deallocate(mpath, 0)
        ManifestState.dirty = 0
    }
}

// Print manifest summary to stdout.
Function.Manifest_Print {
    Body: {
        IfCondition EqualTo(ManifestState.loaded, 0) ThenBlock: {
            Pkg_Println("No manifest loaded.")
            ReturnValue(0)
        }

        obj = ManifestState.json

        name = JSON.GetString(obj, "name")
        ver = JSON.GetString(obj, "version")
        desc = JSON.GetString(obj, "description")
        author = JSON.GetString(obj, "author")
        lic = JSON.GetString(obj, "license")
        entry_str = JSON.GetString(obj, "entry")

        Pkg_WriteStr("Package: ")
        IfCondition NotEqual(name, 0) ThenBlock: { Pkg_WriteStr(name) }
        Pkg_WriteStr(" v")
        IfCondition NotEqual(ver, 0) ThenBlock: { Pkg_WriteStr(ver) }
        Pkg_Println("")

        IfCondition NotEqual(desc, 0) ThenBlock: {
            Pkg_WriteStr("  Description: ")
            Pkg_Println(desc)
        }
        IfCondition NotEqual(author, 0) ThenBlock: {
            IfCondition GreaterThan(StringLength(author), 0) ThenBlock: {
                Pkg_WriteStr("  Author: ")
                Pkg_Println(author)
            }
        }
        IfCondition NotEqual(lic, 0) ThenBlock: {
            Pkg_WriteStr("  License: ")
            Pkg_Println(lic)
        }
        IfCondition NotEqual(entry_str, 0) ThenBlock: {
            Pkg_WriteStr("  Entry: ")
            Pkg_Println(entry_str)
        }
    }
}

// Get package name. Returns string or 0.
Function.Manifest_GetName {
    Output: Address
    Body: {
        IfCondition EqualTo(ManifestState.loaded, 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(JSON.GetString(ManifestState.json, "name"))
    }
}

// Get package version. Returns string or 0.
Function.Manifest_GetVersion {
    Output: Address
    Body: {
        IfCondition EqualTo(ManifestState.loaded, 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(JSON.GetString(ManifestState.json, "version"))
    }
}
