// Pack.ailang — Archive creator using system tar
// Part of AILang Packager
// Provides: Pack_Create

// Create a tar.gz archive of the project using system tar.
// Delegates to fork+exec of tar command.
Function.Pack_Create {
    Input: dir: Address
    Input: output: Address
    Body: {
        IfCondition EqualTo(output, 0) ThenBlock: {
            Pkg_Println("ERROR: No output path specified. Use --output <path>")
            ReturnValue(0)
        }
        IfCondition EqualTo(StringLength(output), 0) ThenBlock: {
            Pkg_Println("ERROR: No output path specified. Use --output <path>")
            ReturnValue(0)
        }

        Pkg_WriteStr("Packing to ")
        Pkg_Println(output)

        // Generate install.sh if not already done
        IfCondition EqualTo(InstallState.content, 0) ThenBlock: {
            Install_Generate()
            Install_Write(dir)
        }

        // Use tar to create the archive
        // tar czf <output> -C <dir> .
        pid = SystemCall(PkgSys.SYS_FORK, 0, 0, 0, 0, 0)
        IfCondition LessThan(pid, 0) ThenBlock: {
            Pkg_Println("ERROR: fork failed")
            ReturnValue(0)
        }

        IfCondition EqualTo(pid, 0) ThenBlock: {
            // Child: exec tar
            tar_path = "/usr/bin/tar"

            argv = Allocate(56)
            StoreValue(Add(argv, 0), tar_path)
            StoreValue(Add(argv, 8), "czf")
            StoreValue(Add(argv, 16), output)
            StoreValue(Add(argv, 24), "-C")
            StoreValue(Add(argv, 32), dir)
            StoreValue(Add(argv, 40), ".")
            StoreValue(Add(argv, 48), 0)

            envp = Allocate(16)
            StoreValue(Add(envp, 0), "PATH=/usr/local/bin:/usr/bin:/bin")
            StoreValue(Add(envp, 8), 0)

            SystemCall(PkgSys.SYS_EXECVE, tar_path, argv, envp)
            // execve failed
            SystemCall(PkgSys.SYS_EXIT, 127, 0, 0, 0, 0)
        }

        // Parent: wait
        status_buf = Allocate(8)
        StoreValue(status_buf, 0)
        SystemCall(PkgSys.SYS_WAIT4, pid, status_buf, 0, 0, 0, 0)
        status = Dereference(status_buf, "dword")
        Deallocate(status_buf, 8)

        exit_code = BitwiseAnd(RightShift(status, 8), 255)
        IfCondition EqualTo(exit_code, 0) ThenBlock: {
            Pkg_Println("Archive created successfully.")
        } ElseBlock: {
            Pkg_WriteStr("ERROR: tar exited with code ")
            PrintNumber(exit_code)
            Pkg_Println("")
        }
    }
}
