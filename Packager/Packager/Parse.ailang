// Parse.ailang — Import statement parser for .ailang files
// Part of AILang Packager
// Provides: Parse_Imports, Parse_AllFiles, Parse_ResolveLibImport, Parse_ResolveImport

FixedPool.ParseConst {
    "LIB_PREFIX_LEN":  Initialize=14
    "IMP_PREFIX_LEN":  Initialize=7
}

// Parse all import statements from a single .ailang file.
// Returns an Array of resolved path strings.
Function.Parse_Imports {
    Input: file_path: Address
    Output: Address
    Body: {
        content = Pkg_ReadFile(file_path)
        IfCondition EqualTo(content, 0) ThenBlock: {
            imports = Array.Create(4)
            ReturnValue(imports)
        }

        imports = Array.Create(32)
        content_len = StringLength(content)
        pos = 0

        WhileLoop LessThan(pos, content_len) {
            // Find start of line
            line_start = pos

            // Find end of line
            WhileLoop LessThan(pos, content_len) {
                ch = GetByte(content, pos)
                IfCondition EqualTo(ch, 10) ThenBlock: {
                    BreakLoop
                }
                pos = Add(pos, 1)
            }
            line_end = pos
            // Skip the newline
            IfCondition LessThan(pos, content_len) ThenBlock: {
                pos = Add(pos, 1)
            }

            line_len = Subtract(line_end, line_start)

            // Skip empty lines and comments
            IfCondition LessEqual(line_len, 0) ThenBlock: {
                ContinueLoop
            }
            first_ch = GetByte(content, line_start)
            // Skip comment lines starting with //
            IfCondition EqualTo(first_ch, 47) ThenBlock: {
                IfCondition GreaterThan(line_len, 1) ThenBlock: {
                    second_ch = GetByte(content, Add(line_start, 1))
                    IfCondition EqualTo(second_ch, 47) ThenBlock: {
                        ContinueLoop
                    }
                }
            }
            // Skip blank/whitespace only lines
            IfCondition EqualTo(first_ch, 32) ThenBlock: { ContinueLoop }
            IfCondition EqualTo(first_ch, 9) ThenBlock: { ContinueLoop }
            IfCondition EqualTo(first_ch, 13) ThenBlock: { ContinueLoop }

            // Check for "LibraryImport." (14 chars)
            found_lib = 0
            IfCondition GreaterEqual(line_len, 15) ThenBlock: {
                found_lib = Parse_CheckPrefix(content, line_start, "LibraryImport.", 14)
            }
            IfCondition EqualTo(found_lib, 1) ThenBlock: {
                // Extract import name after "LibraryImport."
                name_start = Add(line_start, 14)
                imp_name = Parse_ExtractName(content, name_start, line_end)
                resolved = Parse_ResolveLibImport(imp_name)
                Array.Push(imports, resolved)
                ContinueLoop
            }

            // Check for "Import." (7 chars)
            found_imp = 0
            IfCondition GreaterEqual(line_len, 8) ThenBlock: {
                found_imp = Parse_CheckPrefix(content, line_start, "Import.", 7)
            }
            IfCondition EqualTo(found_imp, 1) ThenBlock: {
                name_start = Add(line_start, 7)
                imp_name = Parse_ExtractName(content, name_start, line_end)
                resolved = Parse_ResolveImport(imp_name)
                Array.Push(imports, resolved)
                ContinueLoop
            }

            // If line starts with something other than an import/comment/blank,
            // we've passed the import section. Stop scanning.
            // But allow FixedPool, Function, SubRoutine declarations to not break
            // on files that have pools before imports (rare but possible)
            IfCondition EqualTo(first_ch, 70) ThenBlock: { ContinueLoop }
            // 'S' for SubRoutine
            IfCondition EqualTo(first_ch, 83) ThenBlock: { ContinueLoop }
            // 'R' for RunTask
            IfCondition EqualTo(first_ch, 82) ThenBlock: { ContinueLoop }
        }

        Deallocate(content, 0)
        ReturnValue(imports)
    }
}

// Check if content at offset matches a given prefix string.
// Returns 1 if match, 0 otherwise.
Function.Parse_CheckPrefix {
    Input: content: Address
    Input: offset: Integer
    Input: prefix: Address
    Input: plen: Integer
    Output: Integer
    Body: {
        i = 0
        WhileLoop LessThan(i, plen) {
            a = GetByte(content, Add(offset, i))
            b = GetByte(prefix, i)
            IfCondition NotEqual(a, b) ThenBlock: {
                ReturnValue(0)
            }
            i = Add(i, 1)
        }
        ReturnValue(1)
    }
}

// Extract a name from content between start and end positions.
// Returns a new null-terminated string. Trims trailing whitespace/CR.
Function.Parse_ExtractName {
    Input: content: Address
    Input: start: Integer
    Input: end: Integer
    Output: Address
    Body: {
        // Trim trailing whitespace and CR
        actual_end = end
        WhileLoop GreaterThan(actual_end, start) {
            ch = GetByte(content, Subtract(actual_end, 1))
            IfCondition EqualTo(ch, 32) ThenBlock: {
                actual_end = Subtract(actual_end, 1)
                ContinueLoop
            }
            IfCondition EqualTo(ch, 13) ThenBlock: {
                actual_end = Subtract(actual_end, 1)
                ContinueLoop
            }
            IfCondition EqualTo(ch, 9) ThenBlock: {
                actual_end = Subtract(actual_end, 1)
                ContinueLoop
            }
            BreakLoop
        }

        len = Subtract(actual_end, start)
        IfCondition LessEqual(len, 0) ThenBlock: {
            empty = Allocate(1)
            SetByte(empty, 0, 0)
            ReturnValue(empty)
        }

        buf = Allocate(Add(len, 1))
        MemoryCopy(buf, Add(content, start), len)
        SetByte(buf, len, 0)
        ReturnValue(buf)
    }
}

// Resolve a LibraryImport name to a file path.
// "X" -> "Librarys/Library.X.ailang"
// "A.B.C" -> "Librarys/A/B/Library.C.ailang"
Function.Parse_ResolveLibImport {
    Input: name: Address
    Output: Address
    Body: {
        // Count dots to determine nesting
        len = StringLength(name)
        dot_count = 0
        i = 0
        WhileLoop LessThan(i, len) {
            IfCondition EqualTo(GetByte(name, i), 46) ThenBlock: {
                dot_count = Add(dot_count, 1)
            }
            i = Add(i, 1)
        }

        IfCondition EqualTo(dot_count, 0) ThenBlock: {
            // Simple: "Librarys/Library.X.ailang"
            tmp1 = StringConcat("Librarys/Library.", name)
            result = StringConcat(tmp1, ".ailang")
            Deallocate(tmp1, 0)
            ReturnValue(result)
        }

        // Nested: replace dots with / except last segment gets Library. prefix
        // "A.B.C" -> "Librarys/A/B/Library.C.ailang"
        result = Pkg_StrDup("Librarys")
        i = 0
        seg_start = 0
        seg_idx = 0

        WhileLoop LessEqual(i, len) {
            is_dot = 0
            is_end = 0
            IfCondition LessThan(i, len) ThenBlock: {
                IfCondition EqualTo(GetByte(name, i), 46) ThenBlock: {
                    is_dot = 1
                }
            }
            IfCondition EqualTo(i, len) ThenBlock: {
                is_end = 1
            }

            IfCondition Or(EqualTo(is_dot, 1), EqualTo(is_end, 1)) ThenBlock: {
                seg_len = Subtract(i, seg_start)
                seg = Allocate(Add(seg_len, 1))
                MemoryCopy(seg, Add(name, seg_start), seg_len)
                SetByte(seg, seg_len, 0)

                IfCondition EqualTo(seg_idx, dot_count) ThenBlock: {
                    // Last segment: add "/Library.seg.ailang"
                    tmp1 = StringConcat(result, "/Library.")
                    Deallocate(result, 0)
                    tmp2 = StringConcat(tmp1, seg)
                    Deallocate(tmp1, 0)
                    result = StringConcat(tmp2, ".ailang")
                    Deallocate(tmp2, 0)
                } ElseBlock: {
                    // Intermediate: add "/seg"
                    tmp1 = StringConcat(result, "/")
                    Deallocate(result, 0)
                    tmp2 = StringConcat(tmp1, seg)
                    Deallocate(tmp1, 0)
                    result = tmp2
                }

                Deallocate(seg, 0)
                seg_start = Add(i, 1)
                seg_idx = Add(seg_idx, 1)
            }
            i = Add(i, 1)
        }

        ReturnValue(result)
    }
}

// Resolve an Import name to a file path.
// "A.B.C" -> "A/B/C.ailang"
Function.Parse_ResolveImport {
    Input: name: Address
    Output: Address
    Body: {
        len = StringLength(name)

        // Replace dots with slashes, append .ailang
        buf = Allocate(Add(len, 8))
        j = 0
        i = 0
        WhileLoop LessThan(i, len) {
            ch = GetByte(name, i)
            IfCondition EqualTo(ch, 46) ThenBlock: {
                SetByte(buf, j, 47)
            } ElseBlock: {
                SetByte(buf, j, ch)
            }
            j = Add(j, 1)
            i = Add(i, 1)
        }
        SetByte(buf, j, 0)

        result = StringConcat(buf, ".ailang")
        Deallocate(buf, 0)
        ReturnValue(result)
    }
}

// Parse imports for all SOURCE files in the scan results.
// Stores import arrays in each file entry's Hash under "imports" key.
Function.Parse_AllFiles {
    Body: {
        count = Scan_GetCount()
        i = 0
        WhileLoop LessThan(i, count) {
            entry = Scan_GetEntry(i)
            ftype = Hash.Get(entry, "type")
            IfCondition EqualTo(ftype, FileType.SOURCE) ThenBlock: {
                path = Hash.Get(entry, "path")
                imports = Parse_Imports(path)
                Hash.Set(entry, "imports", imports)
            }
            i = Add(i, 1)
        }
    }
}
