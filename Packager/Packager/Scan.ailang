// Scan.ailang — Recursive directory scanner with file classification
// Part of AILang Packager
// Provides: Scan_Init, Scan_Directory, Scan_PrintSummary, Scan_GetCount,
//           Scan_GetEntry, Scan_Cleanup

FixedPool.FileType {
    "UNKNOWN":   Initialize=0
    "SOURCE":    Initialize=1
    "BINARY":    Initialize=2
    "SCRIPT":    Initialize=3
    "CONFIG":    Initialize=4
    "DOCS":      Initialize=5
    "DIRECTORY": Initialize=6
}

FixedPool.ScanConst {
    "MAX_DEPTH":     Initialize=10
    "DENTS_BUF_SZ":  Initialize=8192
    "DT_DIR":        Initialize=4
    "DT_REG":        Initialize=8
}

FixedPool.ScanState {
    "files":         Initialize=0, CanChange=True
    "file_count":    Initialize=0, CanChange=True
    "src_count":     Initialize=0, CanChange=True
    "bin_count":     Initialize=0, CanChange=True
    "script_count":  Initialize=0, CanChange=True
    "config_count":  Initialize=0, CanChange=True
    "docs_count":    Initialize=0, CanChange=True
    "dir_count":     Initialize=0, CanChange=True
    "entry_count":   Initialize=0, CanChange=True
    "total_size":    Initialize=0, CanChange=True
    "base_dir":      Initialize=0, CanChange=True
}

// Initialize the scanner. Call before Scan_Directory.
Function.Scan_Init {
    Body: {
        ScanState.files = Array.Create(256)
        ScanState.file_count = 0
        ScanState.src_count = 0
        ScanState.bin_count = 0
        ScanState.script_count = 0
        ScanState.config_count = 0
        ScanState.docs_count = 0
        ScanState.dir_count = 0
        ScanState.entry_count = 0
        ScanState.total_size = 0
    }
}

// Classify a file by extension. Returns a FileType constant.
Function.Scan_ClassifyByExt {
    Input: name: Address
    Output: Integer
    Body: {
        ext_ailang = ".ailang"
        ext_x = ".x"
        ext_sh = ".sh"
        ext_json = ".json"
        ext_md = ".md"

        IfCondition EqualTo(Pkg_EndsWith(name, ext_ailang), 1) ThenBlock: {
            ReturnValue(FileType.SOURCE)
        }
        IfCondition EqualTo(Pkg_EndsWith(name, ext_x), 1) ThenBlock: {
            ReturnValue(FileType.BINARY)
        }
        IfCondition EqualTo(Pkg_EndsWith(name, ext_sh), 1) ThenBlock: {
            ReturnValue(FileType.SCRIPT)
        }
        IfCondition EqualTo(Pkg_EndsWith(name, ext_json), 1) ThenBlock: {
            ReturnValue(FileType.CONFIG)
        }
        IfCondition EqualTo(Pkg_EndsWith(name, ext_md), 1) ThenBlock: {
            ReturnValue(FileType.DOCS)
        }
        ReturnValue(FileType.UNKNOWN)
    }
}

// Check if an .ailang file contains SubRoutine.Main (making it an entry point).
// Returns 1 if found, 0 otherwise.
Function.Scan_IsEntryPoint {
    Input: path: Address
    Output: Integer
    Body: {
        content = Pkg_ReadFile(path)
        IfCondition EqualTo(content, 0) ThenBlock: {
            ReturnValue(0)
        }
        marker = "SubRoutine.Main"
        idx = StringIndexOf(content, marker)
        Deallocate(content, 0)
        IfCondition GreaterEqual(idx, 0) ThenBlock: {
            ReturnValue(1)
        }
        ReturnValue(0)
    }
}

// Check if a directory name should be skipped.
// Returns 1 to skip, 0 to process.
Function.Scan_SkipDir {
    Input: name: Address
    Output: Integer
    Body: {
        // Skip .git
        IfCondition EqualTo(StringCompare(name, ".git"), 0) ThenBlock: {
            ReturnValue(1)
        }
        // Skip __pycache__
        IfCondition EqualTo(StringCompare(name, "__pycache__"), 0) ThenBlock: {
            ReturnValue(1)
        }
        // Skip node_modules
        IfCondition EqualTo(StringCompare(name, "node_modules"), 0) ThenBlock: {
            ReturnValue(1)
        }
        ReturnValue(0)
    }
}

// Add a file entry to the scan results.
// Each entry is a Hash: path, name, type, size, is_entry
Function.Scan_AddEntry {
    Input: full_path: Address
    Input: name: Address
    Input: ftype: Integer
    Input: is_entry: Integer
    Body: {
        entry = Hash.New()
        Hash.Set(entry, "path", full_path)
        Hash.Set(entry, "name", name)
        Hash.Set(entry, "type", ftype)
        Hash.Set(entry, "is_entry", is_entry)

        // Get file size
        fsize = Pkg_FileSize(full_path)
        IfCondition LessThan(fsize, 0) ThenBlock: {
            fsize = 0
        }
        Hash.Set(entry, "size", fsize)
        ScanState.total_size = Add(ScanState.total_size, fsize)

        Array.Push(ScanState.files, entry)
        ScanState.file_count = Add(ScanState.file_count, 1)

        // Update type counters
        IfCondition EqualTo(ftype, FileType.SOURCE) ThenBlock: {
            ScanState.src_count = Add(ScanState.src_count, 1)
        }
        IfCondition EqualTo(ftype, FileType.BINARY) ThenBlock: {
            ScanState.bin_count = Add(ScanState.bin_count, 1)
        }
        IfCondition EqualTo(ftype, FileType.SCRIPT) ThenBlock: {
            ScanState.script_count = Add(ScanState.script_count, 1)
        }
        IfCondition EqualTo(ftype, FileType.CONFIG) ThenBlock: {
            ScanState.config_count = Add(ScanState.config_count, 1)
        }
        IfCondition EqualTo(ftype, FileType.DOCS) ThenBlock: {
            ScanState.docs_count = Add(ScanState.docs_count, 1)
        }
        IfCondition EqualTo(is_entry, 1) ThenBlock: {
            ScanState.entry_count = Add(ScanState.entry_count, 1)
        }
    }
}

// Recursively scan a directory for files.
Function.Scan_Directory {
    Input: dir_path: Address
    Input: depth: Integer
    Body: {
        IfCondition GreaterThan(depth, ScanConst.MAX_DEPTH) ThenBlock: {
            ReturnValue(0)
        }

        // Open directory with O_RDONLY | O_DIRECTORY
        flags = Add(PkgSys.O_RDONLY, PkgSys.O_DIRECTORY)
        fd = SystemCall(PkgSys.SYS_OPEN, dir_path, flags, 0)
        IfCondition LessThan(fd, 0) ThenBlock: {
            ReturnValue(0)
        }

        buf = Allocate(ScanConst.DENTS_BUF_SZ)

        WhileLoop 1 {
            nread = SystemCall(PkgSys.SYS_GETDENTS64, fd, buf, ScanConst.DENTS_BUF_SZ)
            IfCondition LessEqual(nread, 0) ThenBlock: {
                BreakLoop
            }

            offset = 0
            WhileLoop LessThan(offset, nread) {
                entry = Add(buf, offset)

                // Read d_reclen (2 bytes at offset 16, little-endian)
                reclen_lo = GetByte(entry, 16)
                reclen_hi = GetByte(entry, 17)
                reclen = Add(reclen_lo, Multiply(reclen_hi, 256))

                // Read d_type at offset 18
                d_type = GetByte(entry, 18)

                // d_name starts at offset 19
                d_name = Add(entry, 19)

                // Skip "." and ".."
                skip = 0
                first = GetByte(d_name, 0)
                IfCondition EqualTo(first, 46) ThenBlock: {
                    second = GetByte(d_name, 1)
                    IfCondition EqualTo(second, 0) ThenBlock: {
                        skip = 1
                    }
                    IfCondition EqualTo(second, 46) ThenBlock: {
                        third = GetByte(d_name, 2)
                        IfCondition EqualTo(third, 0) ThenBlock: {
                            skip = 1
                        }
                    }
                }

                IfCondition EqualTo(skip, 0) ThenBlock: {
                    // Copy d_name into a stable string
                    name_copy = Pkg_StrDup(d_name)
                    full_path = Pkg_PathJoin(dir_path, name_copy)

                    IfCondition EqualTo(d_type, ScanConst.DT_DIR) ThenBlock: {
                        // Directory entry
                        should_skip = Scan_SkipDir(name_copy)
                        IfCondition EqualTo(should_skip, 0) ThenBlock: {
                            ScanState.dir_count = Add(ScanState.dir_count, 1)
                            Scan_Directory(full_path, Add(depth, 1))
                        }
                    }

                    IfCondition EqualTo(d_type, ScanConst.DT_REG) ThenBlock: {
                        // Regular file
                        ftype = Scan_ClassifyByExt(name_copy)
                        is_entry = 0
                        IfCondition EqualTo(ftype, FileType.SOURCE) ThenBlock: {
                            is_entry = Scan_IsEntryPoint(full_path)
                        }
                        Scan_AddEntry(full_path, name_copy, ftype, is_entry)
                    }
                }

                offset = Add(offset, reclen)
            }
        }

        Deallocate(buf, ScanConst.DENTS_BUF_SZ)
        SystemCall(PkgSys.SYS_CLOSE, fd, 0, 0, 0, 0)
    }
}

// Get the file count.
Function.Scan_GetCount {
    Output: Integer
    Body: {
        ReturnValue(ScanState.file_count)
    }
}

// Get a file entry by index. Returns Hash address.
Function.Scan_GetEntry {
    Input: index: Integer
    Output: Address
    Body: {
        ReturnValue(Array.Get(ScanState.files, index))
    }
}

// Get a human-readable label for a file type.
Function.Scan_TypeLabel {
    Input: ftype: Integer
    Output: Address
    Body: {
        IfCondition EqualTo(ftype, FileType.SOURCE) ThenBlock: { ReturnValue("SOURCE") }
        IfCondition EqualTo(ftype, FileType.BINARY) ThenBlock: { ReturnValue("BINARY") }
        IfCondition EqualTo(ftype, FileType.SCRIPT) ThenBlock: { ReturnValue("SCRIPT") }
        IfCondition EqualTo(ftype, FileType.CONFIG) ThenBlock: { ReturnValue("CONFIG") }
        IfCondition EqualTo(ftype, FileType.DOCS) ThenBlock: { ReturnValue("DOCS  ") }
        ReturnValue("OTHER ")
    }
}

// Print scan summary to stdout.
Function.Scan_PrintSummary {
    Body: {
        Pkg_WriteStr("Scan Results:")
        Pkg_Println("")

        // Print each file
        i = 0
        WhileLoop LessThan(i, ScanState.file_count) {
            entry = Array.Get(ScanState.files, i)
            ftype = Hash.Get(entry, "type")
            label = Scan_TypeLabel(ftype)
            Pkg_WriteStr("  ")
            Pkg_WriteStr(label)
            Pkg_WriteStr("  ")

            name = Hash.Get(entry, "name")
            Pkg_WriteStr(name)

            // Show entry point marker
            is_entry = Hash.Get(entry, "is_entry")
            IfCondition EqualTo(is_entry, 1) ThenBlock: {
                Pkg_WriteStr(" [entry]")
            }

            // Show file size
            fsize = Hash.Get(entry, "size")
            Pkg_WriteStr(" (")
            PrintNumber(fsize)
            Pkg_WriteStr(" bytes)")

            Pkg_Println("")
            i = Add(i, 1)
        }

        // Summary line
        Pkg_Println("")
        Pkg_WriteStr("Found: ")
        PrintNumber(ScanState.file_count)
        Pkg_WriteStr(" files (")
        PrintNumber(ScanState.src_count)
        Pkg_WriteStr(" .ailang, ")
        PrintNumber(ScanState.bin_count)
        Pkg_WriteStr(" .x, ")
        PrintNumber(ScanState.script_count)
        Pkg_WriteStr(" .sh, ")
        PrintNumber(ScanState.config_count)
        Pkg_WriteStr(" .json, ")
        PrintNumber(ScanState.docs_count)
        Pkg_WriteStr(" .md)")
        Pkg_Println("")

        PrintNumber(ScanState.entry_count)
        Pkg_WriteStr(" entry points, ")
        PrintNumber(ScanState.dir_count)
        Pkg_WriteStr(" directories scanned")
        Pkg_Println("")

        Pkg_WriteStr("Total size: ")
        PrintNumber(ScanState.total_size)
        Pkg_WriteStr(" bytes")
        Pkg_Println("")
    }
}
