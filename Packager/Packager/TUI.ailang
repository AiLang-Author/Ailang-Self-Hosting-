// TUI.ailang — Interactive TUI application for the packager
// Part of AILang Packager
// Provides: PkgTUI_Run

LibraryImport.TUI
LibraryImport.TuiWidget
LibraryImport.ANSI

FixedPool.PkgTUI {
    "running":        Initialize=1, CanChange=True
    "rows":           Initialize=24, CanChange=True
    "cols":           Initialize=80, CanChange=True
    "active_pane":    Initialize=0, CanChange=True
    "sidebar_w":      Initialize=30, CanChange=True
    "sidebar_scroll": Initialize=0, CanChange=True
    "sidebar_cursor": Initialize=0, CanChange=True
    "main_view":      Initialize=0, CanChange=True
    "detail_msg":     Initialize=0, CanChange=True
    "cmd_buf":        Initialize=0, CanChange=True
    "cmd_len":        Initialize=0, CanChange=True
    "cmd_mode":       Initialize=0, CanChange=True
    "selected_file":  Initialize=0, CanChange=True
    "include_flags":  Initialize=0, CanChange=True
    "scanned":        Initialize=0, CanChange=True
    "graph_built":    Initialize=0, CanChange=True
    "initialized":    Initialize=0, CanChange=True
}

FixedPool.Pane {
    "SIDEBAR":  Initialize=0
    "MAIN":     Initialize=1
    "DETAIL":   Initialize=2
    "CMDBAR":   Initialize=3
}

FixedPool.MainView {
    "GRAPH":     Initialize=0
    "MANIFEST":  Initialize=1
    "BUILD":     Initialize=2
    "INSTALL":   Initialize=3
    "HELP":      Initialize=4
}

// Main TUI entry point.
Function.PkgTUI_Run {
    Body: {
        TUI_Init()

        // Exit alt screen to preserve scrollback (HalCode9000 pattern)
        TUI_BufferChar(27)
        TUI_BufferWriteStr("[?1049l")
        TUI_BufferChar(27)
        TUI_BufferWriteStr("[r")

        ANSI.SetTitle("AILang Packager", 15)
        ANSI.SetCursorShape(ANSICursor.STEADY_BEAM)

        PkgTUI.cmd_buf = Allocate(1024)
        PkgTUI.cmd_len = 0

        PkgTUI_SetupPanes()

        // Auto-scan the project directory
        dir = PkgState.project_dir
        IfCondition NotEqual(dir, 0) ThenBlock: {
            Scan_Init()
            ScanState.base_dir = dir
            Scan_Directory(dir, 0)
            PkgTUI.scanned = 1

            // Initialize include flags (all included by default)
            count = Scan_GetCount()
            IfCondition GreaterThan(count, 0) ThenBlock: {
                PkgTUI.include_flags = Array.Create(count)
                i = 0
                WhileLoop LessThan(i, count) {
                    Array.Push(PkgTUI.include_flags, 1)
                    i = Add(i, 1)
                }
            }

            // Try loading manifest
            Manifest_Load(dir)

            // Parse and build graph
            Parse_AllFiles()
            Graph_Build()
            Graph_DetectCycles()
            Graph_TopoSort()
            PkgTUI.graph_built = 1
        }

        PkgTUI.initialized = 1

        // Clear and draw initial screen
        TUI_BufferChar(27)
        TUI_BufferWriteStr("[2J")
        TUI_BufferChar(27)
        TUI_BufferWriteStr("[H")
        PkgTUI_DrawAll()
        TUI_Flush()

        // Main event loop
        WhileLoop EqualTo(PkgTUI.running, 1) {
            key = TUI_GetKey()

            IfCondition EqualTo(PkgTUI.cmd_mode, 1) ThenBlock: {
                PkgTUI_HandleCmdInput(key)
            } ElseBlock: {
                PkgTUI_HandleNormalKey(key)
            }

            PkgTUI_DrawAll()
            TUI_Flush()
        }

        // Cleanup
        ANSI.SetCursorShape(ANSICursor.DEFAULT)
        TUI_Shutdown()
    }
}

// Set up the 4-pane layout.
Function.PkgTUI_SetupPanes {
    Body: {
        TUI_Layout_Init()
        TUI_GetScreenSize()
        PkgTUI.rows = TUI_State.screen_height
        PkgTUI.cols = TUI_State.screen_width

        sw = PkgTUI.sidebar_w
        mw = Subtract(PkgTUI.cols, Add(sw, 1))
        bh = Subtract(PkgTUI.rows, 2)

        TUI_Layout_SetPane(Pane.SIDEBAR, 1, 1, sw, bh)
        TUI_Layout_SetPane(Pane.MAIN, Add(sw, 2), 1, mw, bh)
        TUI_Layout_SetPane(Pane.DETAIL, 1, Subtract(PkgTUI.rows, 1), PkgTUI.cols, 1)
        TUI_Layout_SetPane(Pane.CMDBAR, 1, PkgTUI.rows, PkgTUI.cols, 1)
    }
}

// Handle a keypress in normal mode.
Function.PkgTUI_HandleNormalKey {
    Input: key: Integer
    Body: {
        // q/Q = quit
        IfCondition EqualTo(key, 113) ThenBlock: { PkgTUI.running = 0 }
        IfCondition EqualTo(key, 81) ThenBlock: { PkgTUI.running = 0 }

        // s = scan
        IfCondition EqualTo(key, 115) ThenBlock: {
            PkgTUI_DoScan()
        }

        // g = graph view
        IfCondition EqualTo(key, 103) ThenBlock: {
            PkgTUI.main_view = MainView.GRAPH
        }

        // m = manifest view
        IfCondition EqualTo(key, 109) ThenBlock: {
            PkgTUI.main_view = MainView.MANIFEST
        }

        // b = build
        IfCondition EqualTo(key, 98) ThenBlock: {
            PkgTUI.main_view = MainView.BUILD
            PkgTUI_DoBuild()
        }

        // i = install script
        IfCondition EqualTo(key, 105) ThenBlock: {
            PkgTUI.main_view = MainView.INSTALL
            PkgTUI_DoInstall()
        }

        // p = pack
        IfCondition EqualTo(key, 112) ThenBlock: {
            PkgTUI_DoPack()
        }

        // ? = help
        IfCondition EqualTo(key, 63) ThenBlock: {
            PkgTUI.main_view = MainView.HELP
        }

        // Tab = cycle pane
        IfCondition EqualTo(key, 9) ThenBlock: {
            IfCondition EqualTo(PkgTUI.active_pane, Pane.SIDEBAR) ThenBlock: {
                PkgTUI.active_pane = Pane.MAIN
            } ElseBlock: {
                PkgTUI.active_pane = Pane.SIDEBAR
            }
        }

        // Arrow keys (sidebar navigation)
        IfCondition EqualTo(PkgTUI.active_pane, Pane.SIDEBAR) ThenBlock: {
            // Up
            IfCondition EqualTo(key, TUI_Keys.KEY_UP) ThenBlock: {
                IfCondition GreaterThan(PkgTUI.sidebar_cursor, 0) ThenBlock: {
                    PkgTUI.sidebar_cursor = Subtract(PkgTUI.sidebar_cursor, 1)
                }
            }
            // Down
            IfCondition EqualTo(key, TUI_Keys.KEY_DOWN) ThenBlock: {
                max_idx = Subtract(Scan_GetCount(), 1)
                IfCondition LessThan(PkgTUI.sidebar_cursor, max_idx) ThenBlock: {
                    PkgTUI.sidebar_cursor = Add(PkgTUI.sidebar_cursor, 1)
                }
            }
            // Space = toggle include
            IfCondition EqualTo(key, 32) ThenBlock: {
                IfCondition NotEqual(PkgTUI.include_flags, 0) ThenBlock: {
                    idx = PkgTUI.sidebar_cursor
                    cur = Array.Get(PkgTUI.include_flags, idx)
                    IfCondition EqualTo(cur, 1) ThenBlock: {
                        Array.Set(PkgTUI.include_flags, idx, 0)
                    } ElseBlock: {
                        Array.Set(PkgTUI.include_flags, idx, 1)
                    }
                }
            }
            // Enter = select file for details
            IfCondition EqualTo(key, TUI_Keys.KEY_ENTER) ThenBlock: {
                PkgTUI.selected_file = PkgTUI.sidebar_cursor
                PkgTUI.main_view = MainView.GRAPH
            }
        }

        // / = enter command mode
        IfCondition EqualTo(key, 47) ThenBlock: {
            PkgTUI.cmd_mode = 1
            PkgTUI.cmd_len = 0
        }
    }
}

// Handle keypress in command input mode.
Function.PkgTUI_HandleCmdInput {
    Input: key: Integer
    Body: {
        // Escape = exit command mode
        IfCondition EqualTo(key, TUI_Keys.KEY_ESC) ThenBlock: {
            PkgTUI.cmd_mode = 0
            PkgTUI.cmd_len = 0
            ReturnValue(0)
        }

        // Enter = execute command
        IfCondition EqualTo(key, TUI_Keys.KEY_ENTER) ThenBlock: {
            SetByte(PkgTUI.cmd_buf, PkgTUI.cmd_len, 0)
            PkgTUI_ExecCommand(PkgTUI.cmd_buf)
            PkgTUI.cmd_mode = 0
            PkgTUI.cmd_len = 0
            ReturnValue(0)
        }

        // Backspace
        IfCondition EqualTo(key, TUI_Keys.KEY_BACKSPACE) ThenBlock: {
            IfCondition GreaterThan(PkgTUI.cmd_len, 0) ThenBlock: {
                PkgTUI.cmd_len = Subtract(PkgTUI.cmd_len, 1)
            }
            ReturnValue(0)
        }

        // Regular character
        IfCondition GreaterEqual(key, 32) ThenBlock: {
            IfCondition LessThan(key, 127) ThenBlock: {
                IfCondition LessThan(PkgTUI.cmd_len, 1020) ThenBlock: {
                    SetByte(PkgTUI.cmd_buf, PkgTUI.cmd_len, key)
                    PkgTUI.cmd_len = Add(PkgTUI.cmd_len, 1)
                }
            }
        }
    }
}

// Execute a typed command.
Function.PkgTUI_ExecCommand {
    Input: cmd: Address
    Body: {
        IfCondition EqualTo(StringCompare(cmd, "quit"), 0) ThenBlock: {
            PkgTUI.running = 0
        }
        IfCondition EqualTo(StringCompare(cmd, "scan"), 0) ThenBlock: {
            PkgTUI_DoScan()
        }
        IfCondition EqualTo(StringCompare(cmd, "build"), 0) ThenBlock: {
            PkgTUI.main_view = MainView.BUILD
            PkgTUI_DoBuild()
        }
        IfCondition EqualTo(StringCompare(cmd, "init"), 0) ThenBlock: {
            dir = PkgState.project_dir
            Manifest_Create(dir)
            Manifest_Save(dir)
            PkgTUI.main_view = MainView.MANIFEST
        }
    }
}

// Perform a scan operation.
Function.PkgTUI_DoScan {
    Body: {
        dir = PkgState.project_dir
        IfCondition EqualTo(dir, 0) ThenBlock: { ReturnValue(0) }

        Scan_Init()
        ScanState.base_dir = dir
        Scan_Directory(dir, 0)
        PkgTUI.scanned = 1
        PkgTUI.sidebar_cursor = 0
        PkgTUI.sidebar_scroll = 0

        // Re-init include flags
        count = Scan_GetCount()
        IfCondition GreaterThan(count, 0) ThenBlock: {
            PkgTUI.include_flags = Array.Create(count)
            i = 0
            WhileLoop LessThan(i, count) {
                Array.Push(PkgTUI.include_flags, 1)
                i = Add(i, 1)
            }
        }

        Parse_AllFiles()
        Graph_Build()
        Graph_DetectCycles()
        Graph_TopoSort()
        PkgTUI.graph_built = 1
    }
}

// Perform a build operation.
Function.PkgTUI_DoBuild {
    Body: {
        dir = PkgState.project_dir
        IfCondition EqualTo(dir, 0) ThenBlock: { ReturnValue(0) }
        IfCondition EqualTo(PkgTUI.scanned, 0) ThenBlock: {
            PkgTUI_DoScan()
        }
        Build_Run(dir)
    }
}

// Generate install script.
Function.PkgTUI_DoInstall {
    Body: {
        dir = PkgState.project_dir
        IfCondition EqualTo(ManifestState.loaded, 0) ThenBlock: {
            Manifest_Create(dir)
        }
        Install_Generate()
        Install_Write(dir)
    }
}

// Pack the project.
Function.PkgTUI_DoPack {
    Body: {
        dir = PkgState.project_dir
        IfCondition EqualTo(dir, 0) ThenBlock: { ReturnValue(0) }

        // Generate default output name
        name = Manifest_GetName()
        ver = Manifest_GetVersion()
        IfCondition EqualTo(name, 0) ThenBlock: { name = "package" }
        IfCondition EqualTo(ver, 0) ThenBlock: { ver = "1.0.0" }

        t1 = StringConcat(name, "-")
        t2 = StringConcat(t1, ver)
        Deallocate(t1, 0)
        output = StringConcat(t2, ".tar.gz")
        Deallocate(t2, 0)

        out_path = Pkg_PathJoin(dir, output)
        Pack_Create(dir, out_path)
        Deallocate(output, 0)
        Deallocate(out_path, 0)
    }
}
