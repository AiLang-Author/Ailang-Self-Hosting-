// TUI_Render.ailang — TUI rendering: sidebar, main pane, status bar, command bar
// Part of AILang Packager
// Provides: PkgTUI_DrawAll

// Draw all panes.
Function.PkgTUI_DrawAll {
    Body: {
        IfCondition EqualTo(PkgTUI.initialized, 0) ThenBlock: { ReturnValue(0) }

        TUI_HideCursor()
        PkgTUI_DrawSidebar()
        PkgTUI_DrawMain()
        PkgTUI_DrawDetail()
        PkgTUI_DrawCmdBar()

        // Position cursor in command bar if in command mode
        IfCondition EqualTo(PkgTUI.cmd_mode, 1) ThenBlock: {
            TUI_ShowCursor()
            TUI_MoveTo(PkgTUI.rows, Add(3, PkgTUI.cmd_len))
        }
    }
}

// Draw the sidebar file tree.
Function.PkgTUI_DrawSidebar {
    Body: {
        sw = PkgTUI.sidebar_w
        bh = Subtract(PkgTUI.rows, 2)

        // Draw box
        TUI_Draw_Box(1, 1, bh, sw)

        // Title
        TUI_MoveTo(1, 3)
        TUI_SetFG(TUI_Colors.CYAN)
        TUI_BufferWriteStr(" Files ")
        TUI_ResetColor()

        IfCondition EqualTo(PkgTUI.scanned, 0) ThenBlock: {
            TUI_MoveTo(3, 3)
            TUI_SetFG(TUI_Colors.YELLOW)
            TUI_BufferWriteStr("Press 's' to scan")
            TUI_ResetColor()
            ReturnValue(0)
        }

        count = Scan_GetCount()
        visible_h = Subtract(bh, 2)
        scroll = PkgTUI.sidebar_scroll

        // Adjust scroll to keep cursor visible
        cursor = PkgTUI.sidebar_cursor
        IfCondition LessThan(cursor, scroll) ThenBlock: {
            PkgTUI.sidebar_scroll = cursor
            scroll = cursor
        }
        IfCondition GreaterEqual(cursor, Add(scroll, visible_h)) ThenBlock: {
            PkgTUI.sidebar_scroll = Subtract(Add(cursor, 1), visible_h)
            scroll = PkgTUI.sidebar_scroll
        }

        row = 2
        i = scroll
        WhileLoop LessThan(i, count) {
            IfCondition GreaterThan(row, Subtract(bh, 1)) ThenBlock: {
                BreakLoop
            }

            entry = Scan_GetEntry(i)
            name = Hash.Get(entry, "name")
            ftype = Hash.Get(entry, "type")
            is_entry = Hash.Get(entry, "is_entry")

            TUI_MoveTo(row, 2)

            // Highlight cursor row
            IfCondition EqualTo(i, cursor) ThenBlock: {
                IfCondition EqualTo(PkgTUI.active_pane, Pane.SIDEBAR) ThenBlock: {
                    TUI_SetBG(TUI_Colors.BLUE)
                    TUI_SetFG(TUI_Colors.WHITE)
                } ElseBlock: {
                    TUI_SetFG(TUI_Colors.CYAN)
                }
            }

            // Include checkbox
            inc = 1
            IfCondition NotEqual(PkgTUI.include_flags, 0) ThenBlock: {
                inc = Array.Get(PkgTUI.include_flags, i)
            }
            IfCondition EqualTo(inc, 1) ThenBlock: {
                TUI_BufferWriteStr("[x] ")
            } ElseBlock: {
                TUI_BufferWriteStr("[ ] ")
            }

            // Type indicator color
            IfCondition EqualTo(ftype, FileType.SOURCE) ThenBlock: {
                IfCondition NotEqual(i, cursor) ThenBlock: { TUI_SetFG(TUI_Colors.GREEN) }
            }
            IfCondition EqualTo(ftype, FileType.BINARY) ThenBlock: {
                IfCondition NotEqual(i, cursor) ThenBlock: { TUI_SetFG(TUI_Colors.YELLOW) }
            }
            IfCondition EqualTo(ftype, FileType.SCRIPT) ThenBlock: {
                IfCondition NotEqual(i, cursor) ThenBlock: { TUI_SetFG(TUI_Colors.MAGENTA) }
            }

            // Truncate name to fit sidebar
            max_name = Subtract(sw, 7)
            name_len = StringLength(name)
            IfCondition LessThan(name_len, max_name) ThenBlock: {
                TUI_BufferWriteStr(name)
            } ElseBlock: {
                // Truncate with ...
                j = 0
                WhileLoop LessThan(j, Subtract(max_name, 3)) {
                    TUI_BufferChar(GetByte(name, j))
                    j = Add(j, 1)
                }
                TUI_BufferWriteStr("...")
            }

            // Entry point marker
            IfCondition EqualTo(is_entry, 1) ThenBlock: {
                TUI_BufferWriteStr(" *")
            }

            TUI_ResetColor()

            // Clear rest of line within sidebar
            cur_col = Add(6, name_len)
            IfCondition EqualTo(is_entry, 1) ThenBlock: {
                cur_col = Add(cur_col, 2)
            }
            WhileLoop LessThan(cur_col, Subtract(sw, 1)) {
                TUI_BufferChar(32)
                cur_col = Add(cur_col, 1)
            }

            row = Add(row, 1)
            i = Add(i, 1)
        }

        // Clear remaining rows
        WhileLoop LessEqual(row, Subtract(bh, 1)) {
            TUI_MoveTo(row, 2)
            j = 2
            WhileLoop LessThan(j, Subtract(sw, 1)) {
                TUI_BufferChar(32)
                j = Add(j, 1)
            }
            row = Add(row, 1)
        }
    }
}

// Draw the main content pane.
Function.PkgTUI_DrawMain {
    Body: {
        sw = PkgTUI.sidebar_w
        mw = Subtract(PkgTUI.cols, Add(sw, 1))
        bh = Subtract(PkgTUI.rows, 2)
        left = Add(sw, 1)

        // Draw box
        TUI_Draw_Box(1, left, bh, mw)

        // Title based on current view
        TUI_MoveTo(1, Add(left, 2))
        TUI_SetFG(TUI_Colors.CYAN)
        IfCondition EqualTo(PkgTUI.main_view, MainView.GRAPH) ThenBlock: {
            TUI_BufferWriteStr(" Dependency Graph ")
        }
        IfCondition EqualTo(PkgTUI.main_view, MainView.MANIFEST) ThenBlock: {
            TUI_BufferWriteStr(" Manifest ")
        }
        IfCondition EqualTo(PkgTUI.main_view, MainView.BUILD) ThenBlock: {
            TUI_BufferWriteStr(" Build Output ")
        }
        IfCondition EqualTo(PkgTUI.main_view, MainView.INSTALL) ThenBlock: {
            TUI_BufferWriteStr(" Install Script ")
        }
        IfCondition EqualTo(PkgTUI.main_view, MainView.HELP) ThenBlock: {
            TUI_BufferWriteStr(" Help ")
        }
        TUI_ResetColor()

        // Content area starts at row 2, col left+1
        content_left = Add(left, 1)
        content_w = Subtract(mw, 2)
        row = 2

        IfCondition EqualTo(PkgTUI.main_view, MainView.GRAPH) ThenBlock: {
            PkgTUI_DrawGraphView(row, content_left, content_w, bh)
        }
        IfCondition EqualTo(PkgTUI.main_view, MainView.MANIFEST) ThenBlock: {
            PkgTUI_DrawManifestView(row, content_left, content_w, bh)
        }
        IfCondition EqualTo(PkgTUI.main_view, MainView.HELP) ThenBlock: {
            PkgTUI_DrawHelpView(row, content_left, content_w, bh)
        }
    }
}

// Draw graph view for the selected file.
Function.PkgTUI_DrawGraphView {
    Input: start_row: Integer
    Input: left: Integer
    Input: width: Integer
    Input: max_h: Integer
    Body: {
        IfCondition EqualTo(PkgTUI.graph_built, 0) ThenBlock: {
            TUI_MoveTo(start_row, left)
            TUI_SetFG(TUI_Colors.YELLOW)
            TUI_BufferWriteStr("No graph built. Press 's' to scan first.")
            TUI_ResetColor()
            ReturnValue(0)
        }

        row = start_row
        // Show selected file's dependencies
        idx = PkgTUI.sidebar_cursor
        count = Scan_GetCount()
        IfCondition GreaterEqual(idx, count) ThenBlock: { ReturnValue(0) }

        entry = Scan_GetEntry(idx)
        ftype = Hash.Get(entry, "type")
        path = Hash.Get(entry, "path")
        name = Hash.Get(entry, "name")

        TUI_MoveTo(row, left)
        TUI_SetFG(TUI_Colors.GREEN)
        TUI_BufferWriteStr(name)
        TUI_ResetColor()
        row = Add(row, 1)

        // Show imports if it's a source file
        IfCondition EqualTo(ftype, FileType.SOURCE) ThenBlock: {
            imports = Hash.Get(entry, "imports")
            IfCondition NotEqual(imports, 0) ThenBlock: {
                imp_count = Array.Size(imports)
                IfCondition EqualTo(imp_count, 0) ThenBlock: {
                    TUI_MoveTo(row, left)
                    TUI_SetFG(TUI_Colors.YELLOW)
                    TUI_BufferWriteStr("  (no imports)")
                    TUI_ResetColor()
                    row = Add(row, 1)
                }
                i = 0
                WhileLoop LessThan(i, imp_count) {
                    IfCondition GreaterEqual(row, Subtract(max_h, 1)) ThenBlock: { BreakLoop }
                    dep = Array.Get(imports, i)
                    TUI_MoveTo(row, left)
                    TUI_SetFG(TUI_Colors.WHITE)
                    TUI_BufferWriteStr("  -> ")
                    TUI_ResetColor()
                    TUI_BufferWriteStr(dep)
                    row = Add(row, 1)
                    i = Add(i, 1)
                }
            }
        } ElseBlock: {
            TUI_MoveTo(row, left)
            TUI_BufferWriteStr("  (not a source file)")
            row = Add(row, 1)
        }

        // Topo order section
        row = Add(row, 1)
        IfCondition LessThan(row, Subtract(max_h, 3)) ThenBlock: {
            TUI_MoveTo(row, left)
            TUI_SetFG(TUI_Colors.CYAN)
            TUI_BufferWriteStr("Build order:")
            TUI_ResetColor()
            row = Add(row, 1)

            IfCondition GreaterThan(GraphState.topo_count, 0) ThenBlock: {
                i = 0
                WhileLoop LessThan(i, GraphState.topo_count) {
                    IfCondition GreaterEqual(row, Subtract(max_h, 1)) ThenBlock: { BreakLoop }
                    node = Array.Get(GraphState.topo_order, i)
                    TUI_MoveTo(row, left)
                    TUI_BufferWriteStr("  ")
                    ns = NumberToString(Add(i, 1))
                    TUI_BufferWriteStr(ns)
                    Deallocate(ns, 0)
                    TUI_BufferWriteStr(". ")
                    TUI_BufferWriteStr(node)
                    row = Add(row, 1)
                    i = Add(i, 1)
                }
            }
        }
    }
}

// Draw manifest view.
Function.PkgTUI_DrawManifestView {
    Input: start_row: Integer
    Input: left: Integer
    Input: width: Integer
    Input: max_h: Integer
    Body: {
        row = start_row

        IfCondition EqualTo(ManifestState.loaded, 0) ThenBlock: {
            TUI_MoveTo(row, left)
            TUI_SetFG(TUI_Colors.YELLOW)
            TUI_BufferWriteStr("No manifest loaded. Type /init to create one.")
            TUI_ResetColor()
            ReturnValue(0)
        }

        obj = ManifestState.json

        // Name
        TUI_MoveTo(row, left)
        TUI_SetFG(TUI_Colors.CYAN)
        TUI_BufferWriteStr("Name:    ")
        TUI_ResetColor()
        name = JSON.GetString(obj, "name")
        IfCondition NotEqual(name, 0) ThenBlock: { TUI_BufferWriteStr(name) }
        row = Add(row, 1)

        // Version
        TUI_MoveTo(row, left)
        TUI_SetFG(TUI_Colors.CYAN)
        TUI_BufferWriteStr("Version: ")
        TUI_ResetColor()
        ver = JSON.GetString(obj, "version")
        IfCondition NotEqual(ver, 0) ThenBlock: { TUI_BufferWriteStr(ver) }
        row = Add(row, 1)

        // Description
        TUI_MoveTo(row, left)
        TUI_SetFG(TUI_Colors.CYAN)
        TUI_BufferWriteStr("Desc:    ")
        TUI_ResetColor()
        desc = JSON.GetString(obj, "description")
        IfCondition NotEqual(desc, 0) ThenBlock: { TUI_BufferWriteStr(desc) }
        row = Add(row, 1)

        // Author
        TUI_MoveTo(row, left)
        TUI_SetFG(TUI_Colors.CYAN)
        TUI_BufferWriteStr("Author:  ")
        TUI_ResetColor()
        author = JSON.GetString(obj, "author")
        IfCondition NotEqual(author, 0) ThenBlock: { TUI_BufferWriteStr(author) }
        row = Add(row, 1)

        // License
        TUI_MoveTo(row, left)
        TUI_SetFG(TUI_Colors.CYAN)
        TUI_BufferWriteStr("License: ")
        TUI_ResetColor()
        lic = JSON.GetString(obj, "license")
        IfCondition NotEqual(lic, 0) ThenBlock: { TUI_BufferWriteStr(lic) }
        row = Add(row, 1)

        // Entry
        TUI_MoveTo(row, left)
        TUI_SetFG(TUI_Colors.CYAN)
        TUI_BufferWriteStr("Entry:   ")
        TUI_ResetColor()
        entry_str = JSON.GetString(obj, "entry")
        IfCondition NotEqual(entry_str, 0) ThenBlock: { TUI_BufferWriteStr(entry_str) }
        row = Add(row, 1)
    }
}

// Draw help view.
Function.PkgTUI_DrawHelpView {
    Input: start_row: Integer
    Input: left: Integer
    Input: width: Integer
    Input: max_h: Integer
    Body: {
        row = start_row

        TUI_MoveTo(row, left)
        TUI_SetFG(TUI_Colors.GREEN)
        TUI_BufferWriteStr("AILang Packager - Keyboard Shortcuts")
        TUI_ResetColor()
        row = Add(row, 2)

        TUI_MoveTo(row, left)
        TUI_BufferWriteStr("  s       Scan project directory")
        row = Add(row, 1)
        TUI_MoveTo(row, left)
        TUI_BufferWriteStr("  g       Show dependency graph")
        row = Add(row, 1)
        TUI_MoveTo(row, left)
        TUI_BufferWriteStr("  m       Show manifest editor")
        row = Add(row, 1)
        TUI_MoveTo(row, left)
        TUI_BufferWriteStr("  b       Run build")
        row = Add(row, 1)
        TUI_MoveTo(row, left)
        TUI_BufferWriteStr("  i       Generate install script")
        row = Add(row, 1)
        TUI_MoveTo(row, left)
        TUI_BufferWriteStr("  p       Pack archive")
        row = Add(row, 1)
        TUI_MoveTo(row, left)
        TUI_BufferWriteStr("  Tab     Switch pane")
        row = Add(row, 1)
        TUI_MoveTo(row, left)
        TUI_BufferWriteStr("  Up/Dn   Navigate file list")
        row = Add(row, 1)
        TUI_MoveTo(row, left)
        TUI_BufferWriteStr("  Space   Toggle include/exclude")
        row = Add(row, 1)
        TUI_MoveTo(row, left)
        TUI_BufferWriteStr("  Enter   Select file")
        row = Add(row, 1)
        TUI_MoveTo(row, left)
        TUI_BufferWriteStr("  /       Command mode")
        row = Add(row, 1)
        TUI_MoveTo(row, left)
        TUI_BufferWriteStr("  ?       This help")
        row = Add(row, 1)
        TUI_MoveTo(row, left)
        TUI_BufferWriteStr("  q       Quit")
        row = Add(row, 1)

        row = Add(row, 1)
        TUI_MoveTo(row, left)
        TUI_SetFG(TUI_Colors.CYAN)
        TUI_BufferWriteStr("Commands: /scan /build /init /quit")
        TUI_ResetColor()
    }
}

// Draw the detail/status bar.
Function.PkgTUI_DrawDetail {
    Body: {
        row = Subtract(PkgTUI.rows, 1)
        TUI_MoveTo(row, 1)

        // Reverse video for status bar
        TUI_BufferChar(27)
        TUI_BufferWriteStr("[7m")

        // Package info
        name = Manifest_GetName()
        ver = Manifest_GetVersion()
        IfCondition NotEqual(name, 0) ThenBlock: {
            TUI_BufferWriteStr(" ")
            TUI_BufferWriteStr(name)
            IfCondition NotEqual(ver, 0) ThenBlock: {
                TUI_BufferWriteStr(" v")
                TUI_BufferWriteStr(ver)
            }
            TUI_BufferWriteStr(" | ")
        } ElseBlock: {
            TUI_BufferWriteStr(" AILang Packager | ")
        }

        // File counts
        ns1 = NumberToString(ScanState.file_count)
        TUI_BufferWriteStr(ns1)
        Deallocate(ns1, 0)
        TUI_BufferWriteStr(" files | ")
        ns2 = NumberToString(ScanState.src_count)
        TUI_BufferWriteStr(ns2)
        Deallocate(ns2, 0)
        TUI_BufferWriteStr(" src | ")

        // Total size
        ns3 = NumberToString(ScanState.total_size)
        TUI_BufferWriteStr(ns3)
        Deallocate(ns3, 0)
        TUI_BufferWriteStr(" bytes | ")

        // Cycle status
        IfCondition EqualTo(GraphState.has_cycle, 1) ThenBlock: {
            TUI_BufferWriteStr("CYCLES!")
        } ElseBlock: {
            TUI_BufferWriteStr("No cycles")
        }

        // Pad to end of line
        // (simplified: just write spaces)
        TUI_BufferWriteStr("  ")

        // Reset
        TUI_BufferChar(27)
        TUI_BufferWriteStr("[0m")
    }
}

// Draw the command bar at the bottom.
Function.PkgTUI_DrawCmdBar {
    Body: {
        row = PkgTUI.rows
        TUI_MoveTo(row, 1)

        IfCondition EqualTo(PkgTUI.cmd_mode, 1) ThenBlock: {
            // Command input mode
            TUI_SetFG(TUI_Colors.CYAN)
            TUI_BufferWriteStr("> ")
            TUI_ResetColor()

            // Print what's typed so far
            i = 0
            WhileLoop LessThan(i, PkgTUI.cmd_len) {
                TUI_BufferChar(GetByte(PkgTUI.cmd_buf, i))
                i = Add(i, 1)
            }

            // Clear rest of line
            filled = Add(2, PkgTUI.cmd_len)
            WhileLoop LessThan(filled, PkgTUI.cols) {
                TUI_BufferChar(32)
                filled = Add(filled, 1)
            }
        } ElseBlock: {
            // Hint bar
            TUI_SetFG(TUI_Colors.CYAN)
            TUI_BufferWriteStr(" [S]")
            TUI_ResetColor()
            TUI_BufferWriteStr("can ")
            TUI_SetFG(TUI_Colors.CYAN)
            TUI_BufferWriteStr("[G]")
            TUI_ResetColor()
            TUI_BufferWriteStr("raph ")
            TUI_SetFG(TUI_Colors.CYAN)
            TUI_BufferWriteStr("[B]")
            TUI_ResetColor()
            TUI_BufferWriteStr("uild ")
            TUI_SetFG(TUI_Colors.CYAN)
            TUI_BufferWriteStr("[P]")
            TUI_ResetColor()
            TUI_BufferWriteStr("ack ")
            TUI_SetFG(TUI_Colors.CYAN)
            TUI_BufferWriteStr("[M]")
            TUI_ResetColor()
            TUI_BufferWriteStr("anifest ")
            TUI_SetFG(TUI_Colors.CYAN)
            TUI_BufferWriteStr("[I]")
            TUI_ResetColor()
            TUI_BufferWriteStr("nstall ")
            TUI_SetFG(TUI_Colors.CYAN)
            TUI_BufferWriteStr("[Q]")
            TUI_ResetColor()
            TUI_BufferWriteStr("uit ")
            TUI_SetFG(TUI_Colors.CYAN)
            TUI_BufferWriteStr("[?]")
            TUI_ResetColor()
            TUI_BufferWriteStr("Help")
        }
    }
}
