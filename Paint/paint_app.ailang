// Paint/paint_app.ailang — ImageEdit kernel host (CAD/dash IPC contract).
//
//   Host (Gtk C++)   Paint/host/paint_shell_gtk — blit + File/tool chrome
//   Kernel (this)    ImageEdit + headless FB → /tmp/paint_app/{meta,frame,gen}
//
// Kernel never links Gtk. Host never stamps pixels.
// Build: ./ailang.x Paint/paint_app.ailang -o paint_app.x
// Run:   ./Paint/scripts/run_paint_app.sh
//
// Copyright © 2026 Sean Collins, 2 Paws Machine and Engineering. SCSL.

LibraryImport.Arena
LibraryImport.Display.Render.DSurfaceTypes
LibraryImport.Display.Render.DSurface
LibraryImport.Display.Render.DDrawPixel
LibraryImport.Display.Render.Framebuffer
LibraryImport.ImageEdit.ImgCanvas

Function.DebugLog_Push {
    Input: tag: Address
    Input: n: Integer
    Output: Integer
    Body: { ReturnValue(0) }
}

FixedPool.PaintApp {
    "run":    Initialize=1, CanChange=True
    "dirty":  Initialize=1, CanChange=True
    "cnv":    Initialize=-1, CanChange=True
    "surf":   Initialize=0, CanChange=True
    "tool":   Initialize=0, CanChange=True
    "color":  Initialize=0xFF000000, CanChange=True
    "size":   Initialize=8, CanChange=True
    "down":   Initialize=0, CanChange=True
    "mx":     Initialize=0, CanChange=True
    "my":     Initialize=0, CanChange=True
    "cmd":    Initialize=0, CanChange=True
    "ptr":    Initialize=0, CanChange=True
    "path":   Initialize=0, CanChange=True
    "hdr":    Initialize=0, CanChange=True
    "genb":   Initialize=0, CanChange=True
    "gen":    Initialize=0, CanChange=True
    "n":      Initialize=0, CanChange=True
    "i":      Initialize=0, CanChange=True
    "x":      Initialize=0, CanChange=True
    "y":      Initialize=0, CanChange=True
    "w":      Initialize=0, CanChange=True
    "h":      Initialize=0, CanChange=True
    "fd":     Initialize=0, CanChange=True
    "src":    Initialize=0, CanChange=True
    "dst":    Initialize=0, CanChange=True
    "sp":     Initialize=0, CanChange=True
    "dp":     Initialize=0, CanChange=True
    "ts":     Initialize=0, CanChange=True
    "h2":     Initialize=0, CanChange=True
    "c":      Initialize=0, CanChange=True
    "ax":     Initialize=0, CanChange=True
    "ay":     Initialize=0, CanChange=True
    "grab":   Initialize=-1, CanChange=True
    "p0x":    Initialize=0, CanChange=True
    "p0y":    Initialize=0, CanChange=True
    "p1x":    Initialize=0, CanChange=True
    "p1y":    Initialize=0, CanChange=True
    "p2x":    Initialize=0, CanChange=True
    "p2y":    Initialize=0, CanChange=True
    "prevx":  Initialize=0, CanChange=True
    "prevy":  Initialize=0, CanChange=True
    "k":      Initialize=0, CanChange=True
    "d":      Initialize=0, CanChange=True
    "cx":     Initialize=0, CanChange=True
    "cy":     Initialize=0, CanChange=True
    "idx":    Initialize=0, CanChange=True
    "pn":     Initialize=0, CanChange=True
    "shape":  Initialize=0, CanChange=True
    "nv":     Initialize=0, CanChange=True
    "rx":     Initialize=0, CanChange=True
    "ry":     Initialize=0, CanChange=True
    "ux":     Initialize=0, CanChange=True
    "uy":     Initialize=0, CanChange=True
}

FixedPool.PaintTool {
    "PENCIL":   Initialize=0
    "ERASER":   Initialize=1
    "AIRBRUSH": Initialize=2
    "LINE":     Initialize=3
    "ARC":      Initialize=4
    "CURVE":    Initialize=5
    "SPLINE":   Initialize=6
    "POLY":     Initialize=7
}

FixedPool.PaintShape {
    "TRI":     Initialize=0
    "SQUARE":  Initialize=1
    "RECT":    Initialize=2
    "DIAMOND": Initialize=3
    "PENT":    Initialize=4
    "HEX":     Initialize=5
    "STAR":    Initialize=6
    "OVAL":    Initialize=7
}

Function.Paint_LE32 {
    Input: buf: Address
    Input: off: Integer
    Input: val: Integer
    Body: {
        SetByte(buf, off, BitwiseAnd(val, 255))
        SetByte(buf, Add(off, 1), BitwiseAnd(ShiftRight(val, 8), 255))
        SetByte(buf, Add(off, 2), BitwiseAnd(ShiftRight(val, 16), 255))
        SetByte(buf, Add(off, 3), BitwiseAnd(ShiftRight(val, 24), 255))
    }
}

Function.Paint_Atoi {
    Input: s: Address
    Output: Integer
    Body: {
        PaintApp.x = 0
        PaintApp.w = 0
        WhileLoop LessThan(PaintApp.x, 80) {
            PaintApp.c = GetByte(s, PaintApp.x)
            IfCondition EqualTo(PaintApp.c, 0) ThenBlock: {
                ReturnValue(PaintApp.w)
            }
            IfCondition And(GreaterEqual(PaintApp.c, 48), LessEqual(PaintApp.c, 57)) ThenBlock: {
                PaintApp.w = Add(Multiply(PaintApp.w, 10), Subtract(PaintApp.c, 48))
            }
            IfCondition EqualTo(PaintApp.c, 32) ThenBlock: {
                IfCondition GreaterThan(PaintApp.w, 0) ThenBlock: {
                    ReturnValue(PaintApp.w)
                }
            }
            PaintApp.x = Add(PaintApp.x, 1)
        }
        ReturnValue(PaintApp.w)
    }
}

Function.Paint_ParseXY {
    Output: Integer
    Body: {
        PaintApp.mx = 0
        PaintApp.my = 0
        PaintApp.i = 1
        PaintApp.n = 0
        WhileLoop LessThan(PaintApp.i, 80) {
            PaintApp.c = GetByte(PaintApp.ptr, PaintApp.i)
            IfCondition EqualTo(PaintApp.c, 0) ThenBlock: {
                ReturnValue(0)
            }
            IfCondition EqualTo(PaintApp.c, 32) ThenBlock: {
                IfCondition EqualTo(PaintApp.n, 0) ThenBlock: {
                    PaintApp.mx = Paint_Atoi(Add(PaintApp.ptr, Add(PaintApp.i, 1)))
                    PaintApp.n = 1
                }
                ElseBlock: {
                    PaintApp.my = Paint_Atoi(Add(PaintApp.ptr, Add(PaintApp.i, 1)))
                    ReturnValue(1)
                }
            }
            PaintApp.i = Add(PaintApp.i, 1)
        }
        ReturnValue(0)
    }
}

Function.Paint_EnsureIpc {
    Output: Integer
    Body: {
        SystemCall(83, "/tmp/paint_app", 493)
        PaintApp.fd = SystemCall(2, "/tmp/paint_app/cmd.txt", 577, 420)
        IfCondition GreaterEqual(PaintApp.fd, 0) ThenBlock: {
            SystemCall(3, PaintApp.fd)
        }
        PaintApp.fd = SystemCall(2, "/tmp/paint_app/ptr.txt", 577, 420)
        IfCondition GreaterEqual(PaintApp.fd, 0) ThenBlock: {
            SystemCall(3, PaintApp.fd)
        }
        ReturnValue(1)
    }
}

Function.Paint_Sleep {
    Input: ms: Integer
    Body: {
        IfCondition EqualTo(PaintApp.ts, 0) ThenBlock: {
            PaintApp.ts = Allocate(16)
        }
        IfCondition LessThan(ms, 1) ThenBlock: {
            ms = 1
        }
        StoreValue(PaintApp.ts, Divide(ms, 1000))
        StoreValue(Add(PaintApp.ts, 8), Multiply(Modulo(ms, 1000), 1000000))
        SystemCall(35, PaintApp.ts, 0)
    }
}

Function.Paint_Present {
    Output: Integer
    Body: {
        PaintApp.w = FB.width
        PaintApp.h = FB.height
        PaintApp.dp = FB.pitch
        PaintApp.dst = FB_GetDrawBuffer()
        IfCondition EqualTo(PaintApp.dst, 0) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition EqualTo(PaintApp.hdr, 0) ThenBlock: {
            PaintApp.hdr = Allocate(16)
        }
        Paint_LE32(PaintApp.hdr, 0, PaintApp.w)
        Paint_LE32(PaintApp.hdr, 4, PaintApp.h)
        Paint_LE32(PaintApp.hdr, 8, PaintApp.dp)
        PaintApp.fd = SystemCall(2, "/tmp/paint_app/meta.bin", 577, 420)
        IfCondition LessThan(PaintApp.fd, 0) ThenBlock: {
            ReturnValue(0)
        }
        SystemCall(1, PaintApp.fd, PaintApp.hdr, 12)
        SystemCall(3, PaintApp.fd)
        PaintApp.fd = SystemCall(2, "/tmp/paint_app/frame.tmp", 577, 420)
        IfCondition LessThan(PaintApp.fd, 0) ThenBlock: {
            ReturnValue(0)
        }
        SystemCall(1, PaintApp.fd, PaintApp.dst, Multiply(PaintApp.dp, PaintApp.h))
        SystemCall(3, PaintApp.fd)
        SystemCall(82, "/tmp/paint_app/frame.tmp", "/tmp/paint_app/frame.raw")
        PaintApp.gen = Add(PaintApp.gen, 1)
        IfCondition EqualTo(PaintApp.genb, 0) ThenBlock: {
            PaintApp.genb = Allocate(32)
        }
        PaintApp.n = 0
        PaintApp.i = PaintApp.gen
        IfCondition LessThan(PaintApp.i, 1) ThenBlock: {
            PaintApp.i = 1
        }
        WhileLoop GreaterThan(PaintApp.i, 0) {
            SetByte(Add(PaintApp.genb, 16), PaintApp.n, Add(48, Modulo(PaintApp.i, 10)))
            PaintApp.n = Add(PaintApp.n, 1)
            PaintApp.i = Divide(PaintApp.i, 10)
        }
        PaintApp.x = 0
        WhileLoop LessThan(PaintApp.x, PaintApp.n) {
            SetByte(PaintApp.genb, PaintApp.x, GetByte(Add(PaintApp.genb, 16), Subtract(Subtract(PaintApp.n, 1), PaintApp.x)))
            PaintApp.x = Add(PaintApp.x, 1)
        }
        SetByte(PaintApp.genb, PaintApp.n, 10)
        PaintApp.fd = SystemCall(2, "/tmp/paint_app/gen.tmp", 577, 420)
        IfCondition LessThan(PaintApp.fd, 0) ThenBlock: {
            ReturnValue(0)
        }
        SystemCall(1, PaintApp.fd, PaintApp.genb, Add(PaintApp.n, 1))
        SystemCall(3, PaintApp.fd)
        SystemCall(82, "/tmp/paint_app/gen.tmp", "/tmp/paint_app/gen.txt")
        ReturnValue(1)
    }
}

Function.Paint_Blit {
    Body: {
        PaintApp.surf = ImgCanvas_ActiveSurf(PaintApp.cnv)
        IfCondition EqualTo(PaintApp.surf, 0) ThenBlock: {
            ReturnValue(0)
        }
        PaintApp.src = Surface_GetData(PaintApp.surf)
        PaintApp.sp = Surface_GetPitch(PaintApp.surf)
        PaintApp.w = Surface_GetWidth(PaintApp.surf)
        PaintApp.h = Surface_GetHeight(PaintApp.surf)
        PaintApp.dst = FB_GetDrawBuffer()
        PaintApp.dp = FB.pitch
        IfCondition Or(EqualTo(PaintApp.src, 0), EqualTo(PaintApp.dst, 0)) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition GreaterThan(PaintApp.w, FB.width) ThenBlock: {
            PaintApp.w = FB.width
        }
        IfCondition GreaterThan(PaintApp.h, FB.height) ThenBlock: {
            PaintApp.h = FB.height
        }
        PaintApp.y = 0
        WhileLoop LessThan(PaintApp.y, PaintApp.h) {
            MemoryCopy(Add(PaintApp.dst, Multiply(PaintApp.y, PaintApp.dp)), Add(PaintApp.src, Multiply(PaintApp.y, PaintApp.sp)), Multiply(PaintApp.w, 4))
            PaintApp.y = Add(PaintApp.y, 1)
        }
        IfCondition And(EqualTo(PaintApp.tool, PaintTool.LINE), EqualTo(PaintApp.down, 1)) ThenBlock: {
            FB_Line(PaintApp.ax, PaintApp.ay, PaintApp.mx, PaintApp.my, PaintApp.color)
        }
        IfCondition And(EqualTo(PaintApp.tool, PaintTool.POLY), EqualTo(PaintApp.down, 1)) ThenBlock: {
            Paint_ShapePreview()
        }
        IfCondition GreaterThan(ImgSketch_NPts(), 0) ThenBlock: {
            Paint_PreviewPts()
        }
        IfCondition And(Or(EqualTo(PaintApp.tool, PaintTool.LINE), EqualTo(PaintApp.tool, PaintTool.POLY)), EqualTo(PaintApp.down, 1)) ThenBlock: {
            PaintApp.dirty = 1
        }
        ElseBlock: {
            IfCondition GreaterThan(ImgSketch_NPts(), 0) ThenBlock: {
                PaintApp.dirty = 1
            }
            ElseBlock: {
                PaintApp.dirty = 0
            }
        }
        Paint_Present()
    }
}

Function.Paint_IsClick {
    Output: Integer
    Body: {
        IfCondition And(GreaterEqual(PaintApp.tool, PaintTool.ARC), LessThan(PaintApp.tool, PaintTool.POLY)) ThenBlock: {
            ReturnValue(1)
        }
        ReturnValue(0)
    }
}

Function.Paint_ShapeNv {
    Body: {
        PaintApp.nv = 4
        IfCondition EqualTo(PaintApp.shape, PaintShape.TRI) ThenBlock: { PaintApp.nv = 3 }
        IfCondition EqualTo(PaintApp.shape, PaintShape.PENT) ThenBlock: { PaintApp.nv = 5 }
        IfCondition EqualTo(PaintApp.shape, PaintShape.HEX) ThenBlock: { PaintApp.nv = 6 }
        IfCondition EqualTo(PaintApp.shape, PaintShape.STAR) ThenBlock: { PaintApp.nv = 10 }
        IfCondition EqualTo(PaintApp.shape, PaintShape.OVAL) ThenBlock: { PaintApp.nv = 12 }
    }
}

Function.Paint_UnitTri {
    Body: {
        IfCondition EqualTo(PaintApp.idx, 0) ThenBlock: { PaintApp.ux = 0 PaintApp.uy = Subtract(0, 256) }
        IfCondition EqualTo(PaintApp.idx, 1) ThenBlock: { PaintApp.ux = 256 PaintApp.uy = 256 }
        IfCondition EqualTo(PaintApp.idx, 2) ThenBlock: { PaintApp.ux = Subtract(0, 256) PaintApp.uy = 256 }
    }
}

Function.Paint_UnitBox {
    Body: {
        IfCondition EqualTo(PaintApp.idx, 0) ThenBlock: { PaintApp.ux = Subtract(0, 256) PaintApp.uy = Subtract(0, 256) }
        IfCondition EqualTo(PaintApp.idx, 1) ThenBlock: { PaintApp.ux = 256 PaintApp.uy = Subtract(0, 256) }
        IfCondition EqualTo(PaintApp.idx, 2) ThenBlock: { PaintApp.ux = 256 PaintApp.uy = 256 }
        IfCondition EqualTo(PaintApp.idx, 3) ThenBlock: { PaintApp.ux = Subtract(0, 256) PaintApp.uy = 256 }
    }
}

Function.Paint_UnitDiam {
    Body: {
        IfCondition EqualTo(PaintApp.idx, 0) ThenBlock: { PaintApp.ux = 0 PaintApp.uy = Subtract(0, 256) }
        IfCondition EqualTo(PaintApp.idx, 1) ThenBlock: { PaintApp.ux = 256 PaintApp.uy = 0 }
        IfCondition EqualTo(PaintApp.idx, 2) ThenBlock: { PaintApp.ux = 0 PaintApp.uy = 256 }
        IfCondition EqualTo(PaintApp.idx, 3) ThenBlock: { PaintApp.ux = Subtract(0, 256) PaintApp.uy = 0 }
    }
}

Function.Paint_UnitPent {
    Body: {
        IfCondition EqualTo(PaintApp.idx, 0) ThenBlock: { PaintApp.ux = 0 PaintApp.uy = Subtract(0, 256) }
        IfCondition EqualTo(PaintApp.idx, 1) ThenBlock: { PaintApp.ux = 243 PaintApp.uy = Subtract(0, 79) }
        IfCondition EqualTo(PaintApp.idx, 2) ThenBlock: { PaintApp.ux = 150 PaintApp.uy = 207 }
        IfCondition EqualTo(PaintApp.idx, 3) ThenBlock: { PaintApp.ux = Subtract(0, 150) PaintApp.uy = 207 }
        IfCondition EqualTo(PaintApp.idx, 4) ThenBlock: { PaintApp.ux = Subtract(0, 243) PaintApp.uy = Subtract(0, 79) }
    }
}

Function.Paint_UnitHex {
    Body: {
        IfCondition EqualTo(PaintApp.idx, 0) ThenBlock: { PaintApp.ux = 0 PaintApp.uy = Subtract(0, 256) }
        IfCondition EqualTo(PaintApp.idx, 1) ThenBlock: { PaintApp.ux = 221 PaintApp.uy = Subtract(0, 128) }
        IfCondition EqualTo(PaintApp.idx, 2) ThenBlock: { PaintApp.ux = 221 PaintApp.uy = 128 }
        IfCondition EqualTo(PaintApp.idx, 3) ThenBlock: { PaintApp.ux = 0 PaintApp.uy = 256 }
        IfCondition EqualTo(PaintApp.idx, 4) ThenBlock: { PaintApp.ux = Subtract(0, 221) PaintApp.uy = 128 }
        IfCondition EqualTo(PaintApp.idx, 5) ThenBlock: { PaintApp.ux = Subtract(0, 221) PaintApp.uy = Subtract(0, 128) }
    }
}

Function.Paint_UnitStar {
    Body: {
        IfCondition EqualTo(PaintApp.idx, 0) ThenBlock: { PaintApp.ux = 0 PaintApp.uy = Subtract(0, 256) }
        IfCondition EqualTo(PaintApp.idx, 1) ThenBlock: { PaintApp.ux = 58 PaintApp.uy = Subtract(0, 79) }
        IfCondition EqualTo(PaintApp.idx, 2) ThenBlock: { PaintApp.ux = 243 PaintApp.uy = Subtract(0, 79) }
        IfCondition EqualTo(PaintApp.idx, 3) ThenBlock: { PaintApp.ux = 93 PaintApp.uy = 30 }
        IfCondition EqualTo(PaintApp.idx, 4) ThenBlock: { PaintApp.ux = 150 PaintApp.uy = 207 }
        IfCondition EqualTo(PaintApp.idx, 5) ThenBlock: { PaintApp.ux = 0 PaintApp.uy = 98 }
        IfCondition EqualTo(PaintApp.idx, 6) ThenBlock: { PaintApp.ux = Subtract(0, 150) PaintApp.uy = 207 }
        IfCondition EqualTo(PaintApp.idx, 7) ThenBlock: { PaintApp.ux = Subtract(0, 93) PaintApp.uy = 30 }
        IfCondition EqualTo(PaintApp.idx, 8) ThenBlock: { PaintApp.ux = Subtract(0, 243) PaintApp.uy = Subtract(0, 79) }
        IfCondition EqualTo(PaintApp.idx, 9) ThenBlock: { PaintApp.ux = Subtract(0, 58) PaintApp.uy = Subtract(0, 79) }
    }
}

Function.Paint_UnitOval {
    Body: {
        IfCondition EqualTo(PaintApp.idx, 0) ThenBlock: { PaintApp.ux = 0 PaintApp.uy = Subtract(0, 256) }
        IfCondition EqualTo(PaintApp.idx, 1) ThenBlock: { PaintApp.ux = 128 PaintApp.uy = Subtract(0, 221) }
        IfCondition EqualTo(PaintApp.idx, 2) ThenBlock: { PaintApp.ux = 221 PaintApp.uy = Subtract(0, 128) }
        IfCondition EqualTo(PaintApp.idx, 3) ThenBlock: { PaintApp.ux = 256 PaintApp.uy = 0 }
        IfCondition EqualTo(PaintApp.idx, 4) ThenBlock: { PaintApp.ux = 221 PaintApp.uy = 128 }
        IfCondition EqualTo(PaintApp.idx, 5) ThenBlock: { PaintApp.ux = 128 PaintApp.uy = 221 }
        IfCondition EqualTo(PaintApp.idx, 6) ThenBlock: { PaintApp.ux = 0 PaintApp.uy = 256 }
        IfCondition EqualTo(PaintApp.idx, 7) ThenBlock: { PaintApp.ux = Subtract(0, 128) PaintApp.uy = 221 }
        IfCondition EqualTo(PaintApp.idx, 8) ThenBlock: { PaintApp.ux = Subtract(0, 221) PaintApp.uy = 128 }
        IfCondition EqualTo(PaintApp.idx, 9) ThenBlock: { PaintApp.ux = Subtract(0, 256) PaintApp.uy = 0 }
        IfCondition EqualTo(PaintApp.idx, 10) ThenBlock: { PaintApp.ux = Subtract(0, 221) PaintApp.uy = Subtract(0, 128) }
        IfCondition EqualTo(PaintApp.idx, 11) ThenBlock: { PaintApp.ux = Subtract(0, 128) PaintApp.uy = Subtract(0, 221) }
    }
}

Function.Paint_ShapeUnit {
    Input: i: Integer
    Body: {
        PaintApp.idx = i
        PaintApp.ux = 0
        PaintApp.uy = 0
        IfCondition EqualTo(PaintApp.shape, PaintShape.TRI) ThenBlock: { Paint_UnitTri() }
        IfCondition Or(EqualTo(PaintApp.shape, PaintShape.SQUARE), EqualTo(PaintApp.shape, PaintShape.RECT)) ThenBlock: { Paint_UnitBox() }
        IfCondition EqualTo(PaintApp.shape, PaintShape.DIAMOND) ThenBlock: { Paint_UnitDiam() }
        IfCondition EqualTo(PaintApp.shape, PaintShape.PENT) ThenBlock: { Paint_UnitPent() }
        IfCondition EqualTo(PaintApp.shape, PaintShape.HEX) ThenBlock: { Paint_UnitHex() }
        IfCondition EqualTo(PaintApp.shape, PaintShape.STAR) ThenBlock: { Paint_UnitStar() }
        IfCondition EqualTo(PaintApp.shape, PaintShape.OVAL) ThenBlock: { Paint_UnitOval() }
    }
}

Function.Paint_BoxFromDrag {
    Body: {
        PaintApp.p0x = PaintApp.ax
        PaintApp.p0y = PaintApp.ay
        PaintApp.p1x = PaintApp.mx
        PaintApp.p1y = PaintApp.my
        IfCondition EqualTo(PaintApp.shape, PaintShape.SQUARE) ThenBlock: {
            PaintApp.x = Subtract(PaintApp.p1x, PaintApp.p0x)
            PaintApp.y = Subtract(PaintApp.p1y, PaintApp.p0y)
            PaintApp.d = PaintApp.x
            IfCondition LessThan(PaintApp.d, 0) ThenBlock: { PaintApp.d = Subtract(0, PaintApp.d) }
            PaintApp.n = PaintApp.y
            IfCondition LessThan(PaintApp.n, 0) ThenBlock: { PaintApp.n = Subtract(0, PaintApp.n) }
            PaintApp.ts = PaintApp.d
            IfCondition GreaterThan(PaintApp.n, PaintApp.ts) ThenBlock: { PaintApp.ts = PaintApp.n }
            IfCondition LessThan(PaintApp.ts, 2) ThenBlock: { PaintApp.ts = 2 }
            IfCondition LessThan(PaintApp.x, 0) ThenBlock: {
                PaintApp.p1x = Subtract(PaintApp.p0x, PaintApp.ts)
            }
            ElseBlock: {
                PaintApp.p1x = Add(PaintApp.p0x, PaintApp.ts)
            }
            IfCondition LessThan(PaintApp.y, 0) ThenBlock: {
                PaintApp.p1y = Subtract(PaintApp.p0y, PaintApp.ts)
            }
            ElseBlock: {
                PaintApp.p1y = Add(PaintApp.p0y, PaintApp.ts)
            }
        }
        IfCondition GreaterThan(PaintApp.p0x, PaintApp.p1x) ThenBlock: {
            PaintApp.ux = PaintApp.p0x
            PaintApp.p0x = PaintApp.p1x
            PaintApp.p1x = PaintApp.ux
        }
        IfCondition GreaterThan(PaintApp.p0y, PaintApp.p1y) ThenBlock: {
            PaintApp.uy = PaintApp.p0y
            PaintApp.p0y = PaintApp.p1y
            PaintApp.p1y = PaintApp.uy
        }
        PaintApp.rx = Divide(Subtract(PaintApp.p1x, PaintApp.p0x), 2)
        PaintApp.ry = Divide(Subtract(PaintApp.p1y, PaintApp.p0y), 2)
        IfCondition LessThan(PaintApp.rx, 1) ThenBlock: { PaintApp.rx = 1 }
        IfCondition LessThan(PaintApp.ry, 1) ThenBlock: { PaintApp.ry = 1 }
        PaintApp.cx = Add(PaintApp.p0x, PaintApp.rx)
        PaintApp.cy = Add(PaintApp.p0y, PaintApp.ry)
    }
}

Function.Paint_ShapeBuild {
    Body: {
        ImgSketch_ClearPts()
        Paint_BoxFromDrag()
        Paint_ShapeNv()
        PaintApp.i = 0
        WhileLoop LessThan(PaintApp.i, PaintApp.nv) {
            Paint_ShapeUnit(PaintApp.i)
            PaintApp.x = Subtract(Add(PaintApp.cx, Divide(Multiply(PaintApp.rx, Add(PaintApp.ux, 256)), 256)), PaintApp.rx)
            PaintApp.y = Subtract(Add(PaintApp.cy, Divide(Multiply(PaintApp.ry, Add(PaintApp.uy, 256)), 256)), PaintApp.ry)
            ImgSketch_AddPt(PaintApp.x, PaintApp.y)
            PaintApp.i = Add(PaintApp.i, 1)
        }
        IfCondition GreaterThan(ImgSketch.npts, 0) ThenBlock: {
            ImgSketch_LoadPt(0)
            PaintApp.x = ImgSketch.x0
            PaintApp.y = ImgSketch.y0
            ImgSketch_AddPt(PaintApp.x, PaintApp.y)
        }
    }
}

Function.Paint_ShapeOutline {
    Body: {
        PaintApp.pn = ImgSketch_NPts()
        IfCondition LessThan(PaintApp.pn, 2) ThenBlock: {
            ReturnValue(0)
        }
        ImgSketch_LoadPt(0)
        PaintApp.ax = ImgSketch.x0
        PaintApp.ay = ImgSketch.y0
        PaintApp.i = 1
        WhileLoop LessThan(PaintApp.i, PaintApp.pn) {
            ImgSketch_LoadPt(PaintApp.i)
            PaintApp.p1x = ImgSketch.x0
            PaintApp.p1y = ImgSketch.y0
            FB_Line(PaintApp.ax, PaintApp.ay, PaintApp.p1x, PaintApp.p1y, 0xFF00E8C0)
            PaintApp.ax = PaintApp.p1x
            PaintApp.ay = PaintApp.p1y
            PaintApp.i = Add(PaintApp.i, 1)
        }
    }
}

Function.Paint_ShapePreview {
    Body: {
        PaintApp.prevx = PaintApp.ax
        PaintApp.prevy = PaintApp.ay
        Paint_ShapeBuild()
        Paint_ShapeOutline()
        ImgSketch_ClearPts()
        PaintApp.ax = PaintApp.prevx
        PaintApp.ay = PaintApp.prevy
    }
}

Function.Paint_ShapeCommit {
    Body: {
        PaintApp.x = Subtract(PaintApp.mx, PaintApp.ax)
        PaintApp.y = Subtract(PaintApp.my, PaintApp.ay)
        IfCondition LessThan(PaintApp.x, 0) ThenBlock: { PaintApp.x = Subtract(0, PaintApp.x) }
        IfCondition LessThan(PaintApp.y, 0) ThenBlock: { PaintApp.y = Subtract(0, PaintApp.y) }
        IfCondition LessThan(Add(PaintApp.x, PaintApp.y), 4) ThenBlock: {
            ReturnValue(0)
        }
        PaintApp.surf = ImgCanvas_ActiveSurf(PaintApp.cnv)
        IfCondition EqualTo(PaintApp.surf, 0) ThenBlock: {
            ReturnValue(0)
        }
        Paint_ShapeBuild()
        ImgWalk.thick = PaintApp.size
        ImgWalk.color = PaintApp.color
        ImgSketch_RasterPoly(PaintApp.surf)
        ImgSketch_ClearPts()
        PaintApp.dirty = 1
    }
}

Function.Paint_HitHandle {
    Output: Integer
    Body: {
        PaintApp.i = 0
        WhileLoop LessThan(PaintApp.i, ImgSketch_NPts()) {
            ImgSketch_LoadPt(PaintApp.i)
            PaintApp.x = Subtract(PaintApp.mx, ImgSketch.x0)
            PaintApp.y = Subtract(PaintApp.my, ImgSketch.y0)
            PaintApp.n = Add(Multiply(PaintApp.x, PaintApp.x), Multiply(PaintApp.y, PaintApp.y))
            IfCondition LessThan(PaintApp.n, 100) ThenBlock: {
                ReturnValue(PaintApp.i)
            }
            PaintApp.i = Add(PaintApp.i, 1)
        }
        ReturnValue(-1)
    }
}

Function.Paint_DrawHandle {
    Input: x: Integer
    Input: y: Integer
    Input: col: Integer
    Body: {
        PaintApp.x = x
        PaintApp.y = y
        PaintApp.c = col
        FB_FillRect(Subtract(PaintApp.x, 4), Subtract(PaintApp.y, 4), 9, 9, PaintApp.c)
        FB_FillRect(Subtract(PaintApp.x, 2), Subtract(PaintApp.y, 2), 5, 5, 0xFF202020)
    }
}

Function.Paint_LiveXY {
    Input: i: Integer
    Body: {
        PaintApp.idx = i
        IfCondition LessThan(PaintApp.idx, ImgSketch.npts) ThenBlock: {
            ImgSketch_LoadPt(PaintApp.idx)
            PaintApp.w = ImgSketch.x0
            PaintApp.h = ImgSketch.y0
        }
        ElseBlock: {
            PaintApp.w = PaintApp.mx
            PaintApp.h = PaintApp.my
        }
    }
}

Function.Paint_FBQuad {
    Body: {
        PaintApp.cx = Divide(Subtract(Subtract(Multiply(PaintApp.p1x, 4), PaintApp.p0x), PaintApp.p2x), 2)
        PaintApp.cy = Divide(Subtract(Subtract(Multiply(PaintApp.p1y, 4), PaintApp.p0y), PaintApp.p2y), 2)
        PaintApp.prevx = PaintApp.p0x
        PaintApp.prevy = PaintApp.p0y
        PaintApp.k = 1
        WhileLoop LessEqual(PaintApp.k, 16) {
            PaintApp.d = Subtract(16, PaintApp.k)
            PaintApp.x = Multiply(Multiply(PaintApp.d, PaintApp.d), PaintApp.p0x)
            PaintApp.y = Multiply(Multiply(Multiply(2, PaintApp.d), PaintApp.k), PaintApp.cx)
            PaintApp.ts = Multiply(Multiply(PaintApp.k, PaintApp.k), PaintApp.p2x)
            PaintApp.x = Divide(Add(Add(PaintApp.x, PaintApp.y), PaintApp.ts), 256)
            PaintApp.y = Multiply(Multiply(PaintApp.d, PaintApp.d), PaintApp.p0y)
            PaintApp.ts = Multiply(Multiply(Multiply(2, PaintApp.d), PaintApp.k), PaintApp.cy)
            PaintApp.c = Multiply(Multiply(PaintApp.k, PaintApp.k), PaintApp.p2y)
            PaintApp.y = Divide(Add(Add(PaintApp.y, PaintApp.ts), PaintApp.c), 256)
            FB_Line(PaintApp.prevx, PaintApp.prevy, PaintApp.x, PaintApp.y, 0xFF00E8C0)
            FB_Line(Add(PaintApp.prevx, 1), PaintApp.prevy, Add(PaintApp.x, 1), PaintApp.y, 0xFF00E8C0)
            PaintApp.prevx = PaintApp.x
            PaintApp.prevy = PaintApp.y
            PaintApp.k = Add(PaintApp.k, 1)
        }
    }
}

Function.Paint_PreviewPts {
    Body: {
        PaintApp.pn = ImgSketch_NPts()
        IfCondition And(LessThan(PaintApp.grab, 0), Or(LessThan(PaintApp.pn, 3), And(NotEqual(PaintApp.tool, PaintTool.ARC), NotEqual(PaintApp.tool, PaintTool.CURVE)))) ThenBlock: {
            PaintApp.pn = Add(PaintApp.pn, 1)
        }
        IfCondition And(Or(EqualTo(PaintApp.tool, PaintTool.ARC), EqualTo(PaintApp.tool, PaintTool.CURVE)), GreaterEqual(PaintApp.pn, 3)) ThenBlock: {
            Paint_LiveXY(0)
            PaintApp.p0x = PaintApp.w
            PaintApp.p0y = PaintApp.h
            Paint_LiveXY(1)
            PaintApp.p1x = PaintApp.w
            PaintApp.p1y = PaintApp.h
            Paint_LiveXY(2)
            PaintApp.p2x = PaintApp.w
            PaintApp.p2y = PaintApp.h
            Paint_FBQuad()
        }
        IfCondition EqualTo(PaintApp.tool, PaintTool.SPLINE) ThenBlock: {
            IfCondition GreaterEqual(PaintApp.pn, 3) ThenBlock: {
                PaintApp.i = 0
                WhileLoop LessThan(PaintApp.i, Subtract(PaintApp.pn, 2)) {
                    Paint_LiveXY(PaintApp.i)
                    PaintApp.p0x = PaintApp.w
                    PaintApp.p0y = PaintApp.h
                    Paint_LiveXY(Add(PaintApp.i, 1))
                    PaintApp.p1x = PaintApp.w
                    PaintApp.p1y = PaintApp.h
                    Paint_LiveXY(Add(PaintApp.i, 2))
                    PaintApp.p2x = PaintApp.w
                    PaintApp.p2y = PaintApp.h
                    Paint_FBQuad()
                    PaintApp.i = Add(PaintApp.i, 1)
                }
            }
            ElseBlock: {
                IfCondition GreaterEqual(PaintApp.pn, 2) ThenBlock: {
                    Paint_LiveXY(0)
                    PaintApp.ax = PaintApp.w
                    PaintApp.ay = PaintApp.h
                    Paint_LiveXY(1)
                    FB_Line(PaintApp.ax, PaintApp.ay, PaintApp.w, PaintApp.h, 0xFF00E8C0)
                }
            }
        }
        IfCondition EqualTo(PaintApp.tool, PaintTool.POLY) ThenBlock: {
            IfCondition GreaterEqual(PaintApp.pn, 2) ThenBlock: {
                Paint_LiveXY(0)
                PaintApp.ax = PaintApp.w
                PaintApp.ay = PaintApp.h
                PaintApp.i = 1
                WhileLoop LessThan(PaintApp.i, PaintApp.pn) {
                    Paint_LiveXY(PaintApp.i)
                    FB_Line(PaintApp.ax, PaintApp.ay, PaintApp.w, PaintApp.h, 0xFF00E8C0)
                    FB_Line(Add(PaintApp.ax, 1), PaintApp.ay, Add(PaintApp.w, 1), PaintApp.h, 0xFF00E8C0)
                    PaintApp.ax = PaintApp.w
                    PaintApp.ay = PaintApp.h
                    PaintApp.i = Add(PaintApp.i, 1)
                }
            }
        }
        PaintApp.i = 0
        WhileLoop LessThan(PaintApp.i, ImgSketch_NPts()) {
            ImgSketch_LoadPt(PaintApp.i)
            PaintApp.c = 0xFFFFCC33
            IfCondition And(Or(EqualTo(PaintApp.tool, PaintTool.ARC), EqualTo(PaintApp.tool, PaintTool.CURVE)), EqualTo(PaintApp.i, 1)) ThenBlock: {
                PaintApp.c = 0xFFFF6622
            }
            PaintApp.ax = ImgSketch.x0
            PaintApp.ay = ImgSketch.y0
            Paint_DrawHandle(PaintApp.ax, PaintApp.ay, PaintApp.c)
            PaintApp.i = Add(PaintApp.i, 1)
        }
    }
}

Function.Paint_Apply {
    Body: {
        PaintApp.surf = ImgCanvas_ActiveSurf(PaintApp.cnv)
        IfCondition EqualTo(PaintApp.surf, 0) ThenBlock: {
            ReturnValue(0)
        }
        ImgWalk.thick = PaintApp.size
        ImgWalk.color = PaintApp.color
        IfCondition EqualTo(PaintApp.tool, PaintTool.POLY) ThenBlock: {
            ImgSketch_RasterPoly(PaintApp.surf)
        }
        IfCondition EqualTo(PaintApp.tool, PaintTool.SPLINE) ThenBlock: {
            ImgSketch_RasterSpline(PaintApp.surf)
        }
        IfCondition Or(EqualTo(PaintApp.tool, PaintTool.ARC), EqualTo(PaintApp.tool, PaintTool.CURVE)) ThenBlock: {
            IfCondition GreaterEqual(ImgSketch_NPts(), 3) ThenBlock: {
                ImgSketch_LoadPt(0)
                PaintApp.ax = ImgSketch.x0
                PaintApp.ay = ImgSketch.y0
                ImgSketch_LoadPt(1)
                PaintApp.x = ImgSketch.x0
                PaintApp.y = ImgSketch.y0
                ImgSketch_LoadPt(2)
                ImgSketch.x1 = ImgSketch.x0
                ImgSketch.y1 = ImgSketch.y0
                ImgSketch.px = PaintApp.x
                ImgSketch.qy = PaintApp.y
                ImgSketch.x0 = PaintApp.ax
                ImgSketch.y0 = PaintApp.ay
                IfCondition EqualTo(PaintApp.tool, PaintTool.ARC) ThenBlock: {
                    ImgSketch_RasterArc3(PaintApp.surf)
                }
                ElseBlock: {
                    ImgSketch_RasterQuad(PaintApp.surf)
                }
            }
        }
        ImgSketch_ClearPts()
        PaintApp.dirty = 1
    }
}

Function.Paint_NewCanvas {
    Output: Integer
    Body: {
        IfCondition GreaterThan(PaintApp.cnv, 0) ThenBlock: {
            ImgCanvas_Destroy(PaintApp.cnv)
        }
        PaintApp.cnv = ImgCanvas_CreateFree(800, 600, 96)
        IfCondition LessThan(PaintApp.cnv, 0) ThenBlock: {
            PrintMessage("[paint] CreateFree fail\n")
            ReturnValue(0)
        }
        ImgSketch_Clear()
        PaintApp.dirty = 1
        ReturnValue(1)
    }
}

Function.Paint_Stroke {
    Body: {
        PaintApp.surf = ImgCanvas_ActiveSurf(PaintApp.cnv)
        IfCondition EqualTo(PaintApp.surf, 0) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition Or(EqualTo(PaintApp.tool, PaintTool.LINE), GreaterEqual(PaintApp.tool, PaintTool.ARC)) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition EqualTo(PaintApp.tool, PaintTool.AIRBRUSH) ThenBlock: {
            ImgBrush_Set(PaintApp.size, 40, 0, PaintApp.color)
            ImgBrush.spacing = 20
            ImgBrush_StrokePoint(PaintApp.surf, PaintApp.mx, PaintApp.my)
            PaintApp.dirty = 1
            ReturnValue(0)
        }
        PaintApp.c = PaintApp.color
        IfCondition EqualTo(PaintApp.tool, PaintTool.ERASER) ThenBlock: {
            PaintApp.c = 0xFFFFFFFF
        }
        ImgBrush_Set(PaintApp.size, 255, 255, PaintApp.c)
        ImgBrush.spacing = 20
        ImgBrush_StrokePoint(PaintApp.surf, PaintApp.mx, PaintApp.my)
        PaintApp.dirty = 1
    }
}

Function.Paint_LineCommit {
    Body: {
        PaintApp.surf = ImgCanvas_ActiveSurf(PaintApp.cnv)
        IfCondition EqualTo(PaintApp.surf, 0) ThenBlock: {
            ReturnValue(0)
        }
        ImgSketch_AddLine(PaintApp.ax, PaintApp.ay, PaintApp.mx, PaintApp.my)
        ImgWalk.thick = PaintApp.size
        ImgWalk.color = PaintApp.color
        ImgPixels_ThickLine(PaintApp.surf, PaintApp.ax, PaintApp.ay, PaintApp.mx, PaintApp.my)
        PaintApp.dirty = 1
    }
}

Function.Paint_ReadPath {
    Output: Integer
    Body: {
        IfCondition EqualTo(PaintApp.path, 0) ThenBlock: {
            PaintApp.path = Allocate(512)
        }
        PaintApp.fd = SystemCall(2, "/tmp/paint_app/path.txt", 0, 0)
        IfCondition LessThan(PaintApp.fd, 0) ThenBlock: {
            ReturnValue(0)
        }
        PaintApp.n = SystemCall(0, PaintApp.fd, PaintApp.path, 511)
        SystemCall(3, PaintApp.fd)
        IfCondition LessEqual(PaintApp.n, 0) ThenBlock: {
            ReturnValue(0)
        }
        SetByte(PaintApp.path, PaintApp.n, 0)
        PaintApp.i = Subtract(PaintApp.n, 1)
        WhileLoop GreaterEqual(PaintApp.i, 0) {
            PaintApp.c = GetByte(PaintApp.path, PaintApp.i)
            IfCondition Or(EqualTo(PaintApp.c, 10), EqualTo(PaintApp.c, 13)) ThenBlock: {
                SetByte(PaintApp.path, PaintApp.i, 0)
                PaintApp.i = Subtract(PaintApp.i, 1)
            }
            ElseBlock: {
                PaintApp.i = -1
            }
        }
        ReturnValue(1)
    }
}

Function.Paint_DoOpen {
    Body: {
        IfCondition EqualTo(Paint_ReadPath(), 0) ThenBlock: {
            ReturnValue(0)
        }
        PaintApp.h2 = ImgIO_LoadBMP(PaintApp.path)
        IfCondition LessThan(PaintApp.h2, 0) ThenBlock: {
            PrintMessage("[paint] open fail\n")
            ReturnValue(0)
        }
        IfCondition GreaterThan(PaintApp.cnv, 0) ThenBlock: {
            ImgCanvas_Destroy(PaintApp.cnv)
        }
        PaintApp.cnv = PaintApp.h2
        PaintApp.dirty = 1
        PrintMessage("[paint] opened\n")
    }
}

Function.Paint_DoSave {
    Input: named: Integer
    Body: {
        IfCondition EqualTo(named, 1) ThenBlock: {
            IfCondition EqualTo(Paint_ReadPath(), 0) ThenBlock: {
                ReturnValue(0)
            }
            PaintApp.n = ImgIO_SaveBMP(PaintApp.cnv, PaintApp.path)
        }
        ElseBlock: {
            PaintApp.n = ImgIO_SaveBMP(PaintApp.cnv, "/tmp/untitled.bmp")
        }
        IfCondition EqualTo(PaintApp.n, 1) ThenBlock: {
            PrintMessage("[paint] saved\n")
        }
        ElseBlock: {
            PrintMessage("[paint] save fail\n")
        }
    }
}

Function.Paint_PollPtr {
    Output: Integer
    Body: {
        IfCondition EqualTo(PaintApp.ptr, 0) ThenBlock: {
            PaintApp.ptr = Allocate(64)
        }
        PaintApp.fd = SystemCall(2, "/tmp/paint_app/ptr.txt", 0, 0)
        IfCondition LessThan(PaintApp.fd, 0) ThenBlock: {
            ReturnValue(0)
        }
        PaintApp.n = SystemCall(0, PaintApp.fd, PaintApp.ptr, 63)
        SystemCall(3, PaintApp.fd)
        IfCondition LessEqual(PaintApp.n, 0) ThenBlock: {
            ReturnValue(0)
        }
        SetByte(PaintApp.ptr, PaintApp.n, 0)
        PaintApp.fd = SystemCall(2, "/tmp/paint_app/ptr.txt", 577, 420)
        IfCondition GreaterEqual(PaintApp.fd, 0) ThenBlock: {
            SystemCall(3, PaintApp.fd)
        }
        PaintApp.h2 = GetByte(PaintApp.ptr, 0)
        IfCondition EqualTo(Paint_ParseXY(), 0) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition EqualTo(PaintApp.h2, 100) ThenBlock: {
            PaintApp.down = 1
            IfCondition EqualTo(Paint_IsClick(), 1) ThenBlock: {
                PaintApp.grab = Paint_HitHandle()
                IfCondition LessThan(PaintApp.grab, 0) ThenBlock: {
                    IfCondition And(Or(EqualTo(PaintApp.tool, PaintTool.ARC), EqualTo(PaintApp.tool, PaintTool.CURVE)), GreaterEqual(ImgSketch.npts, 3)) ThenBlock: {
                        PaintApp.grab = -1
                    }
                    ElseBlock: {
                        ImgSketch_AddPt(PaintApp.mx, PaintApp.my)
                        IfCondition And(Or(EqualTo(PaintApp.tool, PaintTool.ARC), EqualTo(PaintApp.tool, PaintTool.CURVE)), GreaterEqual(ImgSketch.npts, 3)) ThenBlock: {
                            Paint_Apply()
                        }
                    }
                }
                PaintApp.dirty = 1
            }
            ElseBlock: {
                IfCondition Or(EqualTo(PaintApp.tool, PaintTool.LINE), EqualTo(PaintApp.tool, PaintTool.POLY)) ThenBlock: {
                    PaintApp.ax = PaintApp.mx
                    PaintApp.ay = PaintApp.my
                    PaintApp.dirty = 1
                }
                ElseBlock: {
                    ImgBrush_Begin()
                    Paint_Stroke()
                }
            }
            ReturnValue(1)
        }
        IfCondition EqualTo(PaintApp.h2, 109) ThenBlock: {
            IfCondition EqualTo(Paint_IsClick(), 1) ThenBlock: {
                IfCondition GreaterEqual(PaintApp.grab, 0) ThenBlock: {
                    ImgSketch_SetPt(PaintApp.grab, PaintApp.mx, PaintApp.my)
                }
                PaintApp.dirty = 1
            }
            ElseBlock: {
                IfCondition EqualTo(PaintApp.down, 1) ThenBlock: {
                    IfCondition Or(EqualTo(PaintApp.tool, PaintTool.LINE), EqualTo(PaintApp.tool, PaintTool.POLY)) ThenBlock: {
                        PaintApp.dirty = 1
                    }
                    ElseBlock: {
                        Paint_Stroke()
                    }
                }
            }
            ReturnValue(1)
        }
        IfCondition EqualTo(PaintApp.h2, 117) ThenBlock: {
            IfCondition And(EqualTo(PaintApp.tool, PaintTool.LINE), EqualTo(PaintApp.down, 1)) ThenBlock: {
                Paint_LineCommit()
            }
            IfCondition And(EqualTo(PaintApp.tool, PaintTool.POLY), EqualTo(PaintApp.down, 1)) ThenBlock: {
                Paint_ShapeCommit()
            }
            PaintApp.grab = -1
            PaintApp.down = 0
            PaintApp.dirty = 1
            ReturnValue(1)
        }
        ReturnValue(0)
    }
}

Function.Paint_PollCmd {
    Output: Integer
    Body: {
        IfCondition EqualTo(PaintApp.cmd, 0) ThenBlock: {
            PaintApp.cmd = Allocate(80)
        }
        PaintApp.fd = SystemCall(2, "/tmp/paint_app/cmd.txt", 0, 0)
        IfCondition LessThan(PaintApp.fd, 0) ThenBlock: {
            ReturnValue(0)
        }
        PaintApp.n = SystemCall(0, PaintApp.fd, PaintApp.cmd, 79)
        SystemCall(3, PaintApp.fd)
        IfCondition LessEqual(PaintApp.n, 0) ThenBlock: {
            ReturnValue(0)
        }
        SetByte(PaintApp.cmd, PaintApp.n, 0)
        PaintApp.fd = SystemCall(2, "/tmp/paint_app/cmd.txt", 577, 420)
        IfCondition GreaterEqual(PaintApp.fd, 0) ThenBlock: {
            SystemCall(3, PaintApp.fd)
        }
        PaintApp.c = GetByte(PaintApp.cmd, 0)
        IfCondition EqualTo(PaintApp.c, 0) ThenBlock: {
            ReturnValue(0)
        }
        IfCondition EqualTo(PaintApp.c, 113) ThenBlock: {
            ReturnValue(1)
        }
        IfCondition EqualTo(PaintApp.c, 110) ThenBlock: {
            Paint_NewCanvas()
            ReturnValue(2)
        }
        IfCondition EqualTo(PaintApp.c, 111) ThenBlock: {
            Paint_DoOpen()
            ReturnValue(2)
        }
        IfCondition And(EqualTo(PaintApp.c, 115), EqualTo(GetByte(PaintApp.cmd, 4), 97)) ThenBlock: {
            Paint_DoSave(1)
            ReturnValue(2)
        }
        IfCondition And(EqualTo(PaintApp.c, 115), EqualTo(GetByte(PaintApp.cmd, 1), 105)) ThenBlock: {
            PaintApp.size = Paint_Atoi(Add(PaintApp.cmd, 5))
            IfCondition LessThan(PaintApp.size, 1) ThenBlock: {
                PaintApp.size = 1
            }
            IfCondition GreaterThan(PaintApp.size, 64) ThenBlock: {
                PaintApp.size = 64
            }
            ReturnValue(2)
        }
        IfCondition And(EqualTo(PaintApp.c, 115), EqualTo(GetByte(PaintApp.cmd, 1), 104)) ThenBlock: {
            PaintApp.shape = Paint_Atoi(Add(PaintApp.cmd, 6))
            IfCondition LessThan(PaintApp.shape, 0) ThenBlock: {
                PaintApp.shape = 0
            }
            IfCondition GreaterThan(PaintApp.shape, 7) ThenBlock: {
                PaintApp.shape = 7
            }
            PaintApp.tool = PaintTool.POLY
            ImgSketch_ClearPts()
            ReturnValue(2)
        }
        IfCondition And(EqualTo(PaintApp.c, 115), EqualTo(GetByte(PaintApp.cmd, 1), 112)) ThenBlock: {
            PaintApp.tool = PaintTool.SPLINE
            ImgSketch_ClearPts()
            ReturnValue(2)
        }
        IfCondition EqualTo(PaintApp.c, 115) ThenBlock: {
            Paint_DoSave(0)
            ReturnValue(2)
        }
        IfCondition And(EqualTo(PaintApp.c, 112), EqualTo(GetByte(PaintApp.cmd, 1), 111)) ThenBlock: {
            PaintApp.tool = PaintTool.POLY
            ImgSketch_ClearPts()
            ReturnValue(2)
        }
        IfCondition EqualTo(PaintApp.c, 112) ThenBlock: {
            PaintApp.tool = PaintTool.PENCIL
            ImgSketch_ClearPts()
            ReturnValue(2)
        }
        IfCondition EqualTo(PaintApp.c, 101) ThenBlock: {
            PaintApp.tool = PaintTool.ERASER
            ImgSketch_ClearPts()
            ReturnValue(2)
        }
        IfCondition And(EqualTo(PaintApp.c, 97), EqualTo(GetByte(PaintApp.cmd, 1), 112)) ThenBlock: {
            Paint_Apply()
            ReturnValue(2)
        }
        IfCondition And(EqualTo(PaintApp.c, 97), EqualTo(GetByte(PaintApp.cmd, 1), 114)) ThenBlock: {
            PaintApp.tool = PaintTool.ARC
            ImgSketch_ClearPts()
            ReturnValue(2)
        }
        IfCondition EqualTo(PaintApp.c, 97) ThenBlock: {
            PaintApp.tool = PaintTool.AIRBRUSH
            ImgSketch_ClearPts()
            ReturnValue(2)
        }
        IfCondition EqualTo(PaintApp.c, 108) ThenBlock: {
            PaintApp.tool = PaintTool.LINE
            ImgSketch_ClearPts()
            ReturnValue(2)
        }
        IfCondition And(EqualTo(PaintApp.c, 99), EqualTo(GetByte(PaintApp.cmd, 1), 97)) ThenBlock: {
            ImgSketch_ClearPts()
            PaintApp.dirty = 1
            ReturnValue(2)
        }
        IfCondition EqualTo(PaintApp.c, 99) ThenBlock: {
            PaintApp.tool = PaintTool.CURVE
            ImgSketch_ClearPts()
            ReturnValue(2)
        }
        IfCondition EqualTo(PaintApp.c, 98) ThenBlock: {
            IfCondition EqualTo(GetByte(PaintApp.cmd, 2), 117) ThenBlock: {
                PaintApp.color = 0xFF0000FF
            }
            ElseBlock: {
                PaintApp.color = 0xFF000000
            }
            ReturnValue(2)
        }
        IfCondition EqualTo(PaintApp.c, 114) ThenBlock: {
            PaintApp.color = 0xFF0000FF
            IfCondition EqualTo(GetByte(PaintApp.cmd, 1), 101) ThenBlock: {
                PaintApp.color = 0xFFFF0000
            }
            ReturnValue(2)
        }
        IfCondition EqualTo(PaintApp.c, 119) ThenBlock: {
            PaintApp.color = 0xFFFFFFFF
            ReturnValue(2)
        }
        ReturnValue(0)
    }
}

SubRoutine.Main {
    PrintMessage("[paint] ImageEdit kernel /tmp/paint_app\n")
    Arena_Init()
    IfCondition EqualTo(ImgCanvas_Init(), 0) ThenBlock: {
        PrintMessage("[paint] ImgCanvas_Init fail\n")
        SystemCall(60, 1)
    }
    IfCondition EqualTo(FB_InitHeadless(800, 600), 0) ThenBlock: {
        PrintMessage("[paint] FB_InitHeadless fail\n")
        SystemCall(60, 1)
    }
    Paint_EnsureIpc()
    IfCondition EqualTo(Paint_NewCanvas(), 0) ThenBlock: {
        SystemCall(60, 1)
    }
    PaintApp.run = 1
    WhileLoop EqualTo(PaintApp.run, 1) {
        PaintApp.n = Paint_PollCmd()
        IfCondition EqualTo(PaintApp.n, 1) ThenBlock: {
            PaintApp.run = 0
        }
        IfCondition EqualTo(PaintApp.run, 1) ThenBlock: {
            PaintApp.h2 = Paint_PollPtr()
            IfCondition And(And(EqualTo(PaintApp.down, 1), EqualTo(PaintApp.tool, PaintTool.AIRBRUSH)), EqualTo(PaintApp.h2, 0)) ThenBlock: {
                PaintApp.surf = ImgCanvas_ActiveSurf(PaintApp.cnv)
                ImgBrush_Set(PaintApp.size, 28, 0, PaintApp.color)
                ImgBrush_Stamp(PaintApp.surf, PaintApp.mx, PaintApp.my)
                PaintApp.dirty = 1
            }
            IfCondition EqualTo(PaintApp.dirty, 1) ThenBlock: {
                Paint_Blit()
            }
            Paint_Sleep(16)
        }
    }
    PrintMessage("[paint] quit\n")
    SystemCall(60, 0)
}

RunTask(Main)
