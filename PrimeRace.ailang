// =============================================================================
// Prime Sieve - Debug version with verification
// =============================================================================

FixedPool.Config {
    "MAX_NUMBER": Initialize=1000000
    "RUN_SECONDS": Initialize=5
    "CLOCK_MONOTONIC": Initialize=1
    "NANOSEC_PER_SEC": Initialize=1000000000
    "BUF_SIZE": Initialize=500000
}

// Small primes up to sqrt(1000000) = 1000
// Primes from 3 to 997 (we handle 2 separately)
FixedPool.Primes {
    "count": Initialize=167
}

