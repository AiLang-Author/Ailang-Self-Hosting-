// Zero out the buffer using SetByte
Function.ClearBuffer {
    Input: buffer: Address
    Input: size: Integer
    Body: {
        i = 0
        WhileLoop LessThan(i, size) {
            SetByte(buffer, i, 0)
            i = Add(i, 1)
        }
    }
}

// Run sieve using SetByte/GetByte (guaranteed to work)
Function.RunSieve {
    Input: buffer: Address
    Input: buf_size: Integer
    Input: primes: Address
    Output: Integer
    Body: {
        // Clear buffer - all 0 = potentially prime
        i = 0
        WhileLoop LessThan(i, buf_size) {
            SetByte(buffer, i, 0)
            i = Add(i, 1)
        }
        
        // Mark 0 and 1 as not prime (index 0 = number 1)
        SetByte(buffer, 0, 1)
        
        // Sieve using small primes
        // Buffer index n represents odd number (2n+1)
        // So index 1 = 3, index 2 = 5, etc.
        p_idx = 0
        WhileLoop LessThan(p_idx, 167) {
            prime = ArrayGet(primes, p_idx)
            
            // Start at prime^2, convert to index: (p^2 - 1) / 2
            // But we work with half-indices, so start_idx = (p*p) / 2
            start_idx = Divide(Multiply(prime, prime), 2)
            
            // Mark all multiples of prime
            n_idx = start_idx
            WhileLoop LessThan(n_idx, buf_size) {
                SetByte(buffer, n_idx, 1)
                n_idx = Add(n_idx, prime)
            }
            
            p_idx = Add(p_idx, 1)
        }
        
        ReturnValue(1)
    }
}

// Count primes in sieve
Function.CountPrimes {
    Input: buffer: Address
    Input: buf_size: Integer
    Output: Integer
    Body: {
        // Start with 1 for prime 2
        count = 1
        
        i = 1
        WhileLoop LessThan(i, buf_size) {
            val = GetByte(buffer, i)
            IfCondition EqualTo(val, 0) ThenBlock: {
                count = Add(count, 1)
            }
            i = Add(i, 1)
        }
        
        ReturnValue(count)
    }
}

// Get current seconds from clock
Function.GetTimeSec {
    Input: ts_buf: Address
    Output: Integer
    Body: {
        dummy = SystemCall(228, Config.CLOCK_MONOTONIC, ts_buf)
        sec = Dereference(ts_buf)
        ReturnValue(sec)
    }
}

SubRoutine.Main {
    PrintMessage("=== Prime Sieve Benchmark ===\n")
    
    // Allocate timespec buffer
    ts_buffer = Allocate(16)
    
    // Buffer size for sieve (each byte = one odd number)
    buf_size = Config.BUF_SIZE
    
    PrintMessage("Buffer size: ")
    PrintNumber(buf_size)
    PrintMessage(" bytes\n")
    
    // Create and init small primes array
    primes = ArrayCreate(168)
    InitPrimes(primes)
    
    PrintMessage("Primes array initialized\n")
    
    // Allocate sieve buffer
    buffer = Allocate(buf_size)
    
    PrintMessage("Buffer allocated at: ")
    PrintNumber(buffer)
    PrintMessage("\n")
    
    // === VALIDATION RUN ===
    PrintMessage("\n--- Validation Run ---\n")
    
    dummy = RunSieve(buffer, buf_size, primes)
    
    // Debug: check some sieve values
    PrintMessage("Sieve[0] (1): ")
    val = GetByte(buffer, 0)
    PrintNumber(val)
    PrintMessage(" (expect 1 = not prime)\n")
    
    PrintMessage("Sieve[1] (3): ")
    val = GetByte(buffer, 1)
    PrintNumber(val)
    PrintMessage(" (expect 0 = prime)\n")
    
    PrintMessage("Sieve[2] (5): ")
    val = GetByte(buffer, 2)
    PrintNumber(val)
    PrintMessage(" (expect 0 = prime)\n")
    
    PrintMessage("Sieve[3] (7): ")
    val = GetByte(buffer, 3)
    PrintNumber(val)
    PrintMessage(" (expect 0 = prime)\n")
    
    PrintMessage("Sieve[4] (9): ")
    val = GetByte(buffer, 4)
    PrintNumber(val)
    PrintMessage(" (expect 1 = not prime, 9=3*3)\n")
    
    prime_count = CountPrimes(buffer, buf_size)
    
    PrintMessage("\nPrime count: ")
    PrintNumber(prime_count)
    PrintMessage(" (expect 78498 for primes up to 1000000)\n")
    
    IfCondition NotEqual(prime_count, 78498) ThenBlock: {
        PrintMessage("VALIDATION FAILED!\n")
        Deallocate(buffer, buf_size)
        ArrayDestroy(primes)
        Deallocate(ts_buffer, 16)
        ReturnValue(0)
    }
    
    PrintMessage("Validation PASSED!\n")
    
    // === TIMED RUN ===
    PrintMessage("\n--- Timed Run (5 seconds) ---\n")
    
    start_sec = GetTimeSec(ts_buffer)
    
    PrintMessage("Start time (sec): ")
    PrintNumber(start_sec)
    PrintMessage("\n")
    
    // Calculate end time
    end_time_sec = Add(start_sec, Config.RUN_SECONDS)
    
    PrintMessage("Target end (sec): ")
    PrintNumber(end_time_sec)
    PrintMessage("\n")
    
    passes = 0
    
    PrintMessage("Initial passes: ")
    PrintNumber(passes)
    PrintMessage("\n")
    
    // Run exactly 10 passes first to verify loop works
    PrintMessage("Running 10 test passes...\n")
    test_i = 0
    WhileLoop LessThan(test_i, 10) {
        dummy = RunSieve(buffer, buf_size, primes)
        test_i = Add(test_i, 1)
        PrintMessage("  Test pass ")
        PrintNumber(test_i)
        PrintMessage(" complete\n")
    }
    PrintMessage("Test passes done.\n")
    
    // Now do timed run
    PrintMessage("Starting timed run...\n")
    
    start_sec = GetTimeSec(ts_buffer)
    end_time_sec = Add(start_sec, Config.RUN_SECONDS)
    passes = 0
    
    PrintMessage("Loop start, passes=")
    PrintNumber(passes)
    PrintMessage(" start=")
    PrintNumber(start_sec)
    PrintMessage(" end=")
    PrintNumber(end_time_sec)
    PrintMessage("\n")
    
    keepgoing = 1
    WhileLoop EqualTo(keepgoing, 1) {
        dummy = RunSieve(buffer, buf_size, primes)
        passes = Add(passes, 1)
        
        now = GetTimeSec(ts_buffer)
        
        IfCondition GreaterEqual(now, end_time_sec) ThenBlock: {
            keepgoing = 0
        }
    }
    
    final_sec = GetTimeSec(ts_buffer)
    
    PrintMessage("Loop done. passes=")
    PrintNumber(passes)
    PrintMessage(" final=")
    PrintNumber(final_sec)
    PrintMessage("\n")
    
    elapsed_sec = Subtract(final_sec, start_sec)
    
    PrintMessage("\n--- Results ---\n")
    PrintMessage("Passes: ")
    PrintNumber(passes)
    PrintMessage("\n")
    
    PrintMessage("Elapsed (sec): ")
    PrintNumber(elapsed_sec)
    PrintMessage("\n")
    
    // Primes drag race format
    PrintMessage("\n--- Drag Race Format ---\n")
    PrintMessage("ailang;")
    PrintNumber(passes)
    PrintMessage(";")
    PrintNumber(elapsed_sec)
    PrintMessage(";1;algorithm=base,faithful=no,bits=8\n")
    
    // Cleanup
    Deallocate(buffer, buf_size)
    ArrayDestroy(primes)
    Deallocate(ts_buffer, 16)
    
    PrintMessage("\nDone.\n")
}

RunTask(Main)