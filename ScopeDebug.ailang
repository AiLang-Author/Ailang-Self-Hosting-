// ScopeDebug.ailang
// Minimal test case to isolate variable scoping bug
// Compile with both Python and self-hosted compilers, compare output

// Simple FixedPool for testing
FixedPool.TestPool {
    "marker_value": Initialize=99999
    "second_value": Initialize=88888
}

Function.TestLocals {
    Output: Integer
    Body: {
        // Create several locals - if bug exists, these will alias pool vars
        local_a = 111
        local_b = 222
        local_c = 333
        
        // Print addresses/values for debugging
        PrintMessage("=== Local Variable Test ===\n")
        
        PrintMessage("local_a (expect 111): ")
        PrintNumber(local_a)
        PrintMessage("\n")
        
        PrintMessage("local_b (expect 222): ")
        PrintNumber(local_b)
        PrintMessage("\n")
        
        PrintMessage("local_c (expect 333): ")
        PrintNumber(local_c)
        PrintMessage("\n")
        
        // Now modify and re-read
        local_a = 444
        PrintMessage("local_a after modify (expect 444): ")
        PrintNumber(local_a)
        PrintMessage("\n")
        
        // Test increment
        i = 0
        WhileLoop LessThan(i, 5) {
            PrintMessage("Loop iteration i = ")
            PrintNumber(i)
            PrintMessage("\n")
            i = Add(i, 1)
        }
        
        PrintMessage("=== Pool Variable Test ===\n")
        PrintMessage("TestPool.marker_value (expect 99999): ")
        PrintNumber(TestPool.marker_value)
        PrintMessage("\n")
        
        PrintMessage("TestPool.second_value (expect 88888): ")
        PrintNumber(TestPool.second_value)
        PrintMessage("\n")
        
        ReturnValue(local_a)
    }
}

// Entry point - with debugging around call/return
PrintMessage("\n=== About to call TestLocals ===\n")
result = TestLocals()
PrintMessage("\n=== Returned from TestLocals ===\n")
PrintMessage("result (expect 444): ")
PrintNumber(result)
PrintMessage("\n")
PrintMessage("=== About to exit ===\n")