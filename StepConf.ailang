// =============================================================================
// SCREEN 4: EXPORT (INI fragment)
// =============================================================================

Function.Draw_Export {
    Body: {
        TUI_Clear()
        UI_TitleBar("INI EXPORT — copy to your linuxcnc .ini")

        // Common stepgen block
        TUI_MoveTo(3, 2)
        TUI_SetFG(6)
        TUI_Print("# --- per-axis values, paste under your [JOINT_n]/[AXIS_x] sections ---")
        TUI_ResetColor()

        row = 5
        i   = 0
        WhileLoop LessThan(i, SCConfig.NUM_AXES) {
            TUI_MoveTo(row, 2)
            TUI_SetFG(3)
            TUI_Bold()
            TUI_Print("[AXIS_")
            TUI_Print(UI_AxisName(i))
            TUI_Print("]")
            TUI_ResetColor()
            row = Add(row, 1)

            TUI_MoveTo(row, 2)
            TUI_Print("TYPE              = ")
            IfCondition EqualTo(Axis_Get(i, AxisField.DRIVE_TYPE), DriveType.ROTARY) ThenBlock: {
                TUI_Print("ANGULAR")
            } ElseBlock: {
                TUI_Print("LINEAR")
            }
            row = Add(row, 1)

            TUI_MoveTo(row, 2)
            TUI_Print("MAX_VELOCITY      = ")
            UI_PrintFixed(row, 22, Calc_MaxVel_x1000(i), "")
            row = Add(row, 1)

            TUI_MoveTo(row, 2)
            TUI_Print("MAX_ACCELERATION  = ")
            UI_PrintFixed(row, 22, Calc_MaxAccel_x1000(i), "")
            row = Add(row, 1)

            TUI_MoveTo(row, 2)
            TUI_Print("STEPGEN_MAXACCEL  = ")
            UI_PrintFixed(row, 22, Calc_StepgenMaxAccel_x1000(i), "")
            row = Add(row, 1)

            TUI_MoveTo(row, 2)
            TUI_Print("SCALE             = ")
            scale = Calc_Scale_x1000(i)
            IfCondition EqualTo(Axis_Get(i, AxisField.REVERSED), 1) ThenBlock: {
                TUI_Print("-")
            }
            UI_PrintFixed(row, 22, scale, "")
            row = Add(row, 1)

            TUI_MoveTo(row, 2)
            TUI_Print("STEPLEN           = ")
            TUI_WriteNum(Axis_Get(i, AxisField.STEPLEN_NS))
            TUI_Print("    STEPSPACE = ")
            TUI_WriteNum(Axis_Get(i, AxisField.STEPSPACE_NS))
            TUI_Print("    DIRSETUP = ")
            TUI_WriteNum(Axis_Get(i, AxisField.DIRSETUP_NS))
            TUI_Print("    DIRHOLD = ")
            TUI_WriteNum(Axis_Get(i, AxisField.DIRHOLD_NS))
            row = Add(row, 1)

            row = Add(row, 1)
            i   = Add(i, 1)
        }

        UI_NavBar("[Esc/M] back to list  [Q]uit")
        ReturnValue(0)
    }
}

// =============================================================================
// SCREEN 5: HELP
// =============================================================================

Function.Draw_Help {
    Body: {
        TUI_Clear()
        UI_TitleBar("HELP")

        TUI_MoveTo(3, 2)
        TUI_Bold()
        TUI_SetFG(6)
        TUI_Print("LinuxCNC Stepper Configuration Calculator")
        TUI_ResetColor()
        TUI_HLine(4, 1, 78)

        TUI_MoveTo(5, 2)
        TUI_Bold()
        TUI_Print("WHAT IT COMPUTES")
        TUI_ResetColor()
        TUI_MoveTo(6, 2)
        TUI_Print("  SCALE             = (full * micro * driven_T) / (motor_T * pitch)")
        TUI_MoveTo(7, 2)
        TUI_Print("  MAX_VELOCITY      = lesser of motor RPM limit and driver step rate")
        TUI_MoveTo(8, 2)
        TUI_Print("  MAX_ACCELERATION  = MAX_VELOCITY / accel_ramp_time")
        TUI_MoveTo(9, 2)
        TUI_Print("  STEPGEN_MAXACCEL  = 1.25 * MAX_ACCELERATION")

        TUI_MoveTo(11, 2)
        TUI_Bold()
        TUI_Print("FIELDS")
        TUI_ResetColor()
        TUI_MoveTo(12, 2)
        TUI_Print("  Motor full steps  -- 200 (1.8°/step), 400 (0.9°/step)")
        TUI_MoveTo(13, 2)
        TUI_Print("  Microsteps        -- driver setting (16, 32, ...)")
        TUI_MoveTo(14, 2)
        TUI_Print("  Motor / Driven T  -- pulley/gear teeth (0 = direct drive 1:1)")
        TUI_MoveTo(15, 2)
        TUI_Print("  Pitch / output rev -- mm per leadscrew rev, OR mm per output rev for")
        TUI_MoveTo(16, 2)
        TUI_Print("                       belt drive (= belt pitch * pulley teeth), OR")
        TUI_MoveTo(17, 2)
        TUI_Print("                       360 for a rotary axis")

        TUI_MoveTo(19, 2)
        TUI_Bold()
        TUI_Print("KEYS")
        TUI_ResetColor()
        TUI_MoveTo(20, 2)
        TUI_Print("  [E]dit selected axis  [T]iming  [G]eneral calc  [X] export INI")
        TUI_MoveTo(21, 2)
        TUI_Print("  [Q]uit  [?] this help")

        UI_NavBar("[Any key] back")
        ReturnValue(0)
    }
}

// =============================================================================
// EDIT KEY HANDLERS
// =============================================================================

// Commit the current InputState into the active edit field.
Function.Commit_EditField {
    Body: {
        idx = App.selected
        f   = App.edit_field
        IfCondition EqualTo(f, 1) ThenBlock: {
            v = Input_ParseInt()
            IfCondition GreaterThan(v, 0) ThenBlock: { Axis_Set(idx, AxisField.MOTOR_FULL_STEPS, v) }
        }
        IfCondition EqualTo(f, 2) ThenBlock: {
            v = Input_ParseInt()
            IfCondition GreaterThan(v, 0) ThenBlock: { Axis_Set(idx, AxisField.MICROSTEPS, v) }
        }
        IfCondition EqualTo(f, 3) ThenBlock: {
            v = Input_ParseInt()
            Axis_Set(idx, AxisField.MOTOR_PULLEY, v)
        }
        IfCondition EqualTo(f, 4) ThenBlock: {
            v = Input_ParseInt()
            Axis_Set(idx, AxisField.DRIVEN_PULLEY, v)
        }
        IfCondition EqualTo(f, 5) ThenBlock: {
            v = Input_ParseFixed()
            IfCondition GreaterThan(v, 0) ThenBlock: { Axis_Set(idx, AxisField.PITCH_x1000, v) }
        }
        IfCondition EqualTo(f, 6) ThenBlock: {
            v = Input_ParseInt()
            IfCondition GreaterThan(v, 0) ThenBlock: { Axis_Set(idx, AxisField.MOTOR_MAX_RPM, v) }
        }
        IfCondition EqualTo(f, 7) ThenBlock: {
            v = Input_ParseInt()
            IfCondition GreaterThan(v, 0) ThenBlock: { Axis_Set(idx, AxisField.MAX_STEP_RATE, v) }
        }
        IfCondition EqualTo(f, 8) ThenBlock: {
            v = Input_ParseInt()
            IfCondition GreaterThan(v, 0) ThenBlock: { Axis_Set(idx, AxisField.ACCEL_TIME_MS, v) }
        }
        Input_Clear()
        ReturnValue(0)
    }
}

Function.Handle_EditKey {
    Input: key: Integer
    Body: {
        // Tab / Down: commit and advance to next field
        IfCondition Or(EqualTo(key, 9), EqualTo(key, TUI_Keys.KEY_DOWN)) ThenBlock: {
            Commit_EditField()
            App.edit_field = Modulo(Add(App.edit_field, 1), 10)
            ReturnValue(0)
        }
        // Up: commit and step back to previous field
        IfCondition EqualTo(key, TUI_Keys.KEY_UP) ThenBlock: {
            Commit_EditField()
            App.edit_field = Modulo(Add(App.edit_field, 9), 10)
            ReturnValue(0)
        }

        // Enter accepts current field
        IfCondition EqualTo(key, 13) ThenBlock: {
            Commit_EditField()
            ReturnValue(0)
        }

        // Esc back to list
        IfCondition EqualTo(key, TUI_Keys.KEY_ESC) ThenBlock: {
            Input_Clear()
            App.screen = 0
            ReturnValue(0)
        }

        // Field 0 (drive type) — Left/Right toggles
        IfCondition EqualTo(App.edit_field, 0) ThenBlock: {
            IfCondition Or(EqualTo(key, TUI_Keys.KEY_LEFT), EqualTo(key, TUI_Keys.KEY_RIGHT)) ThenBlock: {
                cur = Axis_Get(App.selected, AxisField.DRIVE_TYPE)
                IfCondition EqualTo(cur, DriveType.LINEAR) ThenBlock: {
                    Axis_Set(App.selected, AxisField.DRIVE_TYPE, DriveType.ROTARY)
                    Axis_Set(App.selected, AxisField.PITCH_x1000, 360000)
                } ElseBlock: {
                    Axis_Set(App.selected, AxisField.DRIVE_TYPE, DriveType.LINEAR)
                    Axis_Set(App.selected, AxisField.PITCH_x1000, 5000)
                }
            }
            ReturnValue(0)
        }

        // Field 9 (reversed) — Left/Right toggles
        IfCondition EqualTo(App.edit_field, 9) ThenBlock: {
            IfCondition Or(EqualTo(key, TUI_Keys.KEY_LEFT), EqualTo(key, TUI_Keys.KEY_RIGHT)) ThenBlock: {
                cur = Axis_Get(App.selected, AxisField.REVERSED)
                IfCondition EqualTo(cur, 0) ThenBlock: { Axis_Set(App.selected, AxisField.REVERSED, 1) }
                                            ElseBlock: { Axis_Set(App.selected, AxisField.REVERSED, 0) }
            }
            ReturnValue(0)
        }

        // Numeric input (with optional decimal point for field 5)
        IfCondition And(GreaterEqual(key, 48), LessEqual(key, 57)) ThenBlock: { Input_AddChar(key) ReturnValue(0) }
        IfCondition And(EqualTo(key, 46), EqualTo(App.edit_field, 5)) ThenBlock: { Input_AddChar(key) ReturnValue(0) }
        IfCondition EqualTo(key, TUI_Keys.KEY_BACKSPACE) ThenBlock: { Input_Backspace() ReturnValue(0) }

        ReturnValue(0)
    }
}

// =============================================================================
// TIMING KEY HANDLERS
// =============================================================================

Function.Apply_Preset {
    Input: which: Integer
    Body: {
        idx = App.selected
        IfCondition EqualTo(which, 1) ThenBlock: {
            Axis_Set(idx, AxisField.STEPLEN_NS,   5000)
            Axis_Set(idx, AxisField.STEPSPACE_NS, 5000)
            Axis_Set(idx, AxisField.DIRSETUP_NS,  20000)
            Axis_Set(idx, AxisField.DIRHOLD_NS,   20000)
        }
        IfCondition EqualTo(which, 2) ThenBlock: {
            Axis_Set(idx, AxisField.STEPLEN_NS,   5000)
            Axis_Set(idx, AxisField.STEPSPACE_NS, 5000)
            Axis_Set(idx, AxisField.DIRSETUP_NS,  70000)
            Axis_Set(idx, AxisField.DIRHOLD_NS,   70000)
        }
        IfCondition EqualTo(which, 3) ThenBlock: {
            Axis_Set(idx, AxisField.STEPLEN_NS,   2500)
            Axis_Set(idx, AxisField.STEPSPACE_NS, 2500)
            Axis_Set(idx, AxisField.DIRSETUP_NS,  5000)
            Axis_Set(idx, AxisField.DIRHOLD_NS,   5000)
        }
        IfCondition EqualTo(which, 4) ThenBlock: {
            Axis_Set(idx, AxisField.STEPLEN_NS,   2500)
            Axis_Set(idx, AxisField.STEPSPACE_NS, 2500)
            Axis_Set(idx, AxisField.DIRSETUP_NS,  5000)
            Axis_Set(idx, AxisField.DIRHOLD_NS,   5000)
        }
        IfCondition EqualTo(which, 5) ThenBlock: {
            Axis_Set(idx, AxisField.STEPLEN_NS,   1900)
            Axis_Set(idx, AxisField.STEPSPACE_NS, 1900)
            Axis_Set(idx, AxisField.DIRSETUP_NS,  650)
            Axis_Set(idx, AxisField.DIRHOLD_NS,   650)
        }
        IfCondition EqualTo(which, 6) ThenBlock: {
            Axis_Set(idx, AxisField.STEPLEN_NS,   1000)
            Axis_Set(idx, AxisField.STEPSPACE_NS, 1000)
            Axis_Set(idx, AxisField.DIRSETUP_NS,  200)
            Axis_Set(idx, AxisField.DIRHOLD_NS,   200)
        }
        IfCondition EqualTo(which, 7) ThenBlock: {
            Axis_Set(idx, AxisField.STEPLEN_NS,   1000)
            Axis_Set(idx, AxisField.STEPSPACE_NS, 1000)
            Axis_Set(idx, AxisField.DIRSETUP_NS,  1000)
            Axis_Set(idx, AxisField.DIRHOLD_NS,   1000)
        }
        ReturnValue(0)
    }
}

FixedPool.TimingMode {
    "preset_armed": Initialize=0
}

Function.Commit_TimingField {
    Body: {
        idx = App.selected
        f   = App.timing_field
        v   = Input_ParseInt()
        IfCondition GreaterThan(v, 0) ThenBlock: {
            IfCondition EqualTo(f, 0) ThenBlock: { Axis_Set(idx, AxisField.STEPLEN_NS,   v) }
            IfCondition EqualTo(f, 1) ThenBlock: { Axis_Set(idx, AxisField.STEPSPACE_NS, v) }
            IfCondition EqualTo(f, 2) ThenBlock: { Axis_Set(idx, AxisField.DIRSETUP_NS,  v) }
            IfCondition EqualTo(f, 3) ThenBlock: { Axis_Set(idx, AxisField.DIRHOLD_NS,   v) }
        }
        Input_Clear()
        ReturnValue(0)
    }
}

Function.Handle_TimingKey {
    Input: key: Integer
    Body: {
        // Preset arming: P then digit 1-7 (consumes the digit)
        IfCondition EqualTo(TimingMode.preset_armed, 1) ThenBlock: {
            IfCondition And(GreaterEqual(key, 49), LessEqual(key, 55)) ThenBlock: {
                Apply_Preset(Subtract(key, 48))
            }
            TimingMode.preset_armed = 0
            ReturnValue(0)
        }
        IfCondition Or(EqualTo(key, 112), EqualTo(key, 80)) ThenBlock: {
            TimingMode.preset_armed = 1
            ReturnValue(0)
        }

        // Tab / Down: commit, advance
        IfCondition Or(EqualTo(key, 9), EqualTo(key, TUI_Keys.KEY_DOWN)) ThenBlock: {
            Commit_TimingField()
            App.timing_field = Modulo(Add(App.timing_field, 1), 4)
            ReturnValue(0)
        }
        // Up: commit, step back
        IfCondition EqualTo(key, TUI_Keys.KEY_UP) ThenBlock: {
            Commit_TimingField()
            App.timing_field = Modulo(Add(App.timing_field, 3), 4)
            ReturnValue(0)
        }
        IfCondition EqualTo(key, 13) ThenBlock: {
            Commit_TimingField()
            ReturnValue(0)
        }
        IfCondition EqualTo(key, TUI_Keys.KEY_ESC) ThenBlock: {
            Input_Clear()
            App.screen = 0
            ReturnValue(0)
        }
        IfCondition And(GreaterEqual(key, 48), LessEqual(key, 57)) ThenBlock: { Input_AddChar(key) ReturnValue(0) }
        IfCondition EqualTo(key, TUI_Keys.KEY_BACKSPACE) ThenBlock: { Input_Backspace() ReturnValue(0) }
        ReturnValue(0)
    }
}

// =============================================================================
// GENERAL CALC KEY HANDLER
// =============================================================================

Function.Commit_GeneralField {
    Body: {
        f = App.general_field
        IfCondition EqualTo(f, 0) ThenBlock: { v = Input_ParseInt() IfCondition GreaterThan(v, 0) ThenBlock: { GenCalc.motor_full = v } }
        IfCondition EqualTo(f, 1) ThenBlock: { v = Input_ParseInt() IfCondition GreaterThan(v, 0) ThenBlock: { GenCalc.microsteps = v } }
        IfCondition EqualTo(f, 2) ThenBlock: { GenCalc.motor_pulley  = Input_ParseInt() }
        IfCondition EqualTo(f, 3) ThenBlock: { GenCalc.driven_pulley = Input_ParseInt() }
        IfCondition EqualTo(f, 4) ThenBlock: { v = Input_ParseFixed() IfCondition GreaterThan(v, 0) ThenBlock: { GenCalc.pitch_x1000 = v } }
        Input_Clear()
        ReturnValue(0)
    }
}

Function.Handle_GeneralKey {
    Input: key: Integer
    Body: {
        // Tab / Down: commit, advance
        IfCondition Or(EqualTo(key, 9), EqualTo(key, TUI_Keys.KEY_DOWN)) ThenBlock: {
            Commit_GeneralField()
            App.general_field = Modulo(Add(App.general_field, 1), 6)
            ReturnValue(0)
        }
        // Up: commit, step back
        IfCondition EqualTo(key, TUI_Keys.KEY_UP) ThenBlock: {
            Commit_GeneralField()
            App.general_field = Modulo(Add(App.general_field, 5), 6)
            ReturnValue(0)
        }
        IfCondition EqualTo(key, 13) ThenBlock: {
            Commit_GeneralField()
            ReturnValue(0)
        }
        IfCondition EqualTo(key, TUI_Keys.KEY_ESC) ThenBlock: {
            Input_Clear()
            App.screen = 0
            ReturnValue(0)
        }

        // Field 5 (rotary toggle) Left/Right
        IfCondition EqualTo(App.general_field, 5) ThenBlock: {
            IfCondition Or(EqualTo(key, TUI_Keys.KEY_LEFT), EqualTo(key, TUI_Keys.KEY_RIGHT)) ThenBlock: {
                IfCondition EqualTo(GenCalc.is_rotary, 0) ThenBlock: {
                    GenCalc.is_rotary    = 1
                    GenCalc.pitch_x1000  = 360000
                } ElseBlock: {
                    GenCalc.is_rotary    = 0
                    GenCalc.pitch_x1000  = 5000
                }
                ReturnValue(0)
            }
        }

        IfCondition And(GreaterEqual(key, 48), LessEqual(key, 57)) ThenBlock: { Input_AddChar(key) ReturnValue(0) }
        IfCondition And(EqualTo(key, 46), EqualTo(App.general_field, 4)) ThenBlock: { Input_AddChar(key) ReturnValue(0) }
        IfCondition EqualTo(key, TUI_Keys.KEY_BACKSPACE) ThenBlock: { Input_Backspace() ReturnValue(0) }

        ReturnValue(0)
    }
}

// =============================================================================
// GLOBAL KEY HANDLER (axis list / export / help)
// =============================================================================

Function.Handle_GlobalKey {
    Input: key: Integer
    Body: {
        IfCondition Or(EqualTo(key, 113), EqualTo(key, 81)) ThenBlock: { App.running = 0 ReturnValue(0) }

        IfCondition Or(EqualTo(key, 101), EqualTo(key, 69)) ThenBlock: {
            App.edit_field = 0
            Input_Clear()
            App.screen = 1
            ReturnValue(0)
        }
        IfCondition Or(EqualTo(key, 116), EqualTo(key, 84)) ThenBlock: {
            App.timing_field         = 0
            TimingMode.preset_armed  = 0
            Input_Clear()
            App.screen = 2
            ReturnValue(0)
        }
        IfCondition Or(EqualTo(key, 103), EqualTo(key, 71)) ThenBlock: {
            App.general_field = 0
            Input_Clear()
            App.screen = 3
            ReturnValue(0)
        }
        IfCondition Or(EqualTo(key, 120), EqualTo(key, 88)) ThenBlock: {
            App.screen = 4
            ReturnValue(0)
        }
        IfCondition Or(EqualTo(key, 109), EqualTo(key, 77)) ThenBlock: {
            App.screen = 0
            ReturnValue(0)
        }
        IfCondition EqualTo(key, 63) ThenBlock: {
            App.screen = 5
            ReturnValue(0)
        }

        IfCondition EqualTo(App.screen, 0) ThenBlock: {
            IfCondition EqualTo(key, TUI_Keys.KEY_UP)   ThenBlock: { App.selected = Modulo(Add(App.selected, 3), 4) }
            IfCondition EqualTo(key, TUI_Keys.KEY_DOWN) ThenBlock: { App.selected = Modulo(Add(App.selected, 1), 4) }
            IfCondition EqualTo(key, TUI_Keys.KEY_ESC)  ThenBlock: { App.running = 0 }
        }
        IfCondition EqualTo(App.screen, 4) ThenBlock: {
            IfCondition EqualTo(key, TUI_Keys.KEY_ESC) ThenBlock: { App.screen = 0 }
        }

        ReturnValue(0)
    }
}

// =============================================================================
// ENTRY POINT
// =============================================================================

SubRoutine.App_Run {
    TUI_Init()
    App_Init()

    WhileLoop EqualTo(App.running, 1) {
        IfCondition EqualTo(App.screen, 0) ThenBlock: { Draw_Main() }
        IfCondition EqualTo(App.screen, 1) ThenBlock: { Draw_Edit() }
        IfCondition EqualTo(App.screen, 2) ThenBlock: { Draw_Timing() }
        IfCondition EqualTo(App.screen, 3) ThenBlock: { Draw_General() }
        IfCondition EqualTo(App.screen, 4) ThenBlock: { Draw_Export() }
        IfCondition EqualTo(App.screen, 5) ThenBlock: { Draw_Help() }

        TUI_Refresh()
        key = TUI_GetKey()

        IfCondition EqualTo(App.screen, 1) ThenBlock: {
            Handle_EditKey(key)
        } ElseBlock: {
            IfCondition EqualTo(App.screen, 2) ThenBlock: {
                Handle_TimingKey(key)
            } ElseBlock: {
                IfCondition EqualTo(App.screen, 3) ThenBlock: {
                    Handle_GeneralKey(key)
                } ElseBlock: {
                    IfCondition EqualTo(App.screen, 5) ThenBlock: {
                        App.screen = 0
                    } ElseBlock: {
                        Handle_GlobalKey(key)
                    }
                }
            }
        }
    }

    TUI_Shutdown()
}

RunTask(App_Run)
