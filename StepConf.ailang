// StepConf.ailang
// LinuxCNC Stepper Configuration Calculator (TUI)
//
// Replaces the trial-and-error stepconf wizard with a transparent calculator.
// You enter the physical chain (motor steps, microsteps, gear ratio, screw
// pitch / pulley size, motor RPM limit, driver step-rate limit) and it shows
// every derived number step-by-step:
//
//   SCALE             = (full * micro * driven) / (motor_pulley * pitch)
//   MAX_VELOCITY      = min(motor RPM limit, driver step-rate limit)
//   MAX_ACCELERATION  = MAX_VELOCITY / accel_time
//   STEPGEN_MAXACCEL  = 1.25 * MAX_ACCELERATION
//
// Plus a "general" screen for plugging arbitrary numbers into the formula
// without committing to a specific axis.
//
// Fixed-point ×1000 throughout. No floats — language has none.

LibraryImport.TUI
LibraryImport.FixedPointTrig
LibraryImport.Arena

// =============================================================================
// CONSTANTS
// =============================================================================

FixedPool.SCConfig {
    "NUM_AXES":         Initialize=4
    "SCALE":            Initialize=1000
    "PI_x1000":         Initialize=3142
    "DEFAULT_STEP_HZ":  Initialize=40000
    "DEFAULT_RPM":      Initialize=1500
    "DEFAULT_RAMP_MS":  Initialize=100
}

// Drive types (how motor revs map to axis units)
FixedPool.DriveType {
    "LINEAR": Initialize=0      // mm or inch per output rev
    "ROTARY": Initialize=1      // degrees per output rev (default 360)
}

// Per-axis record fields (byte offsets within record)
FixedPool.AxisField {
    "DRIVE_TYPE":       Initialize=0
    "MOTOR_FULL_STEPS": Initialize=8
    "MICROSTEPS":       Initialize=16
    "MOTOR_PULLEY":     Initialize=24    // teeth on motor shaft
    "DRIVEN_PULLEY":    Initialize=32    // teeth on screw / output shaft
    "PITCH_x1000":      Initialize=40    // mm/rev × 1000 (LINEAR), deg/rev × 1000 (ROTARY)
    "MOTOR_MAX_RPM":    Initialize=48
    "MAX_STEP_RATE":    Initialize=56    // Hz, driver limit
    "ACCEL_TIME_MS":    Initialize=64    // time to reach MAX_VEL from 0
    "REVERSED":         Initialize=72    // 0 / 1
    "USE_INCHES":       Initialize=80    // 0 = mm, 1 = inches (LINEAR only)
    "STEPLEN_NS":       Initialize=88
    "STEPSPACE_NS":     Initialize=96
    "DIRSETUP_NS":      Initialize=104
    "DIRHOLD_NS":       Initialize=112
    "SIZE":             Initialize=128
}

// =============================================================================
// APPLICATION STATE
// =============================================================================

FixedPool.App {
    "running":       Initialize=1
    "screen":        Initialize=0   // 0=list 1=edit 2=timing 3=general 4=export 5=help
    "selected":      Initialize=0   // axis index 0..3
    "store_ptr":     Initialize=0
    "edit_field":    Initialize=0
    "timing_field":  Initialize=0
    "general_field": Initialize=0
}

// General-input mode — same formula, no axis context
FixedPool.GenCalc {
    "motor_full":         Initialize=200
    "microsteps":         Initialize=16
    "motor_pulley":       Initialize=20    // 0 treated as direct drive (1)
    "driven_pulley":      Initialize=20
    "pitch_x1000":        Initialize=5000  // 5.000 mm
    "is_rotary":          Initialize=0
}

// Input buffer
FixedPool.InputState {
    "buf":   Initialize=0
    "len":   Initialize=0
    "value": Initialize=0
}

// =============================================================================
// INIT
// =============================================================================

Function.Axis_GetPtr {
    Input: idx: Integer
    Output: Address
    Body: {
        ReturnValue(Add(App.store_ptr, Multiply(idx, AxisField.SIZE)))
    }
}

Function.Axis_Get {
    Input: idx:   Integer
    Input: field: Integer
    Output: Integer
    Body: {
        ReturnValue(Dereference(Add(Axis_GetPtr(idx), field)))
    }
}

Function.Axis_Set {
    Input: idx:   Integer
    Input: field: Integer
    Input: value: Integer
    Body: {
        StoreValue(Add(Axis_GetPtr(idx), field), value)
        ReturnValue(0)
    }
}

Function.Axis_LoadDefaults {
    Input: idx: Integer
    Body: {
        Axis_Set(idx, AxisField.DRIVE_TYPE,       DriveType.LINEAR)
        Axis_Set(idx, AxisField.MOTOR_FULL_STEPS, 200)
        Axis_Set(idx, AxisField.MICROSTEPS,       16)
        Axis_Set(idx, AxisField.MOTOR_PULLEY,     20)
        Axis_Set(idx, AxisField.DRIVEN_PULLEY,    20)
        Axis_Set(idx, AxisField.PITCH_x1000,      5000)
        Axis_Set(idx, AxisField.MOTOR_MAX_RPM,    SCConfig.DEFAULT_RPM)
        Axis_Set(idx, AxisField.MAX_STEP_RATE,    SCConfig.DEFAULT_STEP_HZ)
        Axis_Set(idx, AxisField.ACCEL_TIME_MS,    SCConfig.DEFAULT_RAMP_MS)
        Axis_Set(idx, AxisField.REVERSED,         0)
        Axis_Set(idx, AxisField.USE_INCHES,       0)
        Axis_Set(idx, AxisField.STEPLEN_NS,       5000)
        Axis_Set(idx, AxisField.STEPSPACE_NS,     5000)
        Axis_Set(idx, AxisField.DIRSETUP_NS,      20000)
        Axis_Set(idx, AxisField.DIRHOLD_NS,       20000)
        ReturnValue(0)
    }
}

Function.App_Init {
    Body: {
        Arena_Init()
        App.store_ptr  = Allocate(Multiply(SCConfig.NUM_AXES, AxisField.SIZE))
        InputState.buf = Allocate(32)
        InputState.len = 0

        i = 0
        WhileLoop LessThan(i, SCConfig.NUM_AXES) {
            Axis_LoadDefaults(i)
            i = Add(i, 1)
        }

        // A axis defaults to ROTARY 360 deg/rev
        Axis_Set(3, AxisField.DRIVE_TYPE,  DriveType.ROTARY)
        Axis_Set(3, AxisField.PITCH_x1000, 360000)

        ReturnValue(0)
    }
}

// =============================================================================
// CORE CALCULATIONS
//
// Every formula derives from one identity:
//
//     output_movement_per_motor_rev = pitch * (motor_pulley / driven_pulley)
//
// Then:
//
//     SCALE_steps_per_unit = (full_steps * microsteps) / output_movement_per_motor_rev
//
// Velocity is min(motor RPM limit, driver step-rate limit) translated to units.
// =============================================================================

// Resolve gear teeth: 0 means direct drive (treat as 1).
Function.Calc_GearNum {
    Input: idx: Integer
    Output: Integer
    Body: {
        v = Axis_Get(idx, AxisField.DRIVEN_PULLEY)
        IfCondition LessEqual(v, 0) ThenBlock: { ReturnValue(1) }
        ReturnValue(v)
    }
}

Function.Calc_GearDen {
    Input: idx: Integer
    Output: Integer
    Body: {
        v = Axis_Get(idx, AxisField.MOTOR_PULLEY)
        IfCondition LessEqual(v, 0) ThenBlock: { ReturnValue(1) }
        ReturnValue(v)
    }
}

// Steps the driver must emit for one full motor revolution.
Function.Calc_StepsPerMotorRev {
    Input: idx: Integer
    Output: Integer
    Body: {
        full  = Axis_Get(idx, AxisField.MOTOR_FULL_STEPS)
        micro = Axis_Get(idx, AxisField.MICROSTEPS)
        ReturnValue(Multiply(full, micro))
    }
}

// Reduction ratio motor:output as ×1000 (e.g. 3000 = 3.000:1).
Function.Calc_GearRatio_x1000 {
    Input: idx: Integer
    Output: Integer
    Body: {
        n = Calc_GearNum(idx)
        d = Calc_GearDen(idx)
        ReturnValue(Divide(Multiply(n, 1000), d))
    }
}

// Output movement per motor revolution (mm or deg, ×1000).
//   linear_per_motor_rev = pitch * (motor_pulley / driven_pulley)
Function.Calc_OutputPerMotorRev_x1000 {
    Input: idx: Integer
    Output: Integer
    Body: {
        pitch = Axis_Get(idx, AxisField.PITCH_x1000)
        n     = Calc_GearNum(idx)
        d     = Calc_GearDen(idx)
        ReturnValue(Divide(Multiply(pitch, d), n))
    }
}

// LinuxCNC SCALE: steps per unit (mm, inch, or deg). Returned ×1000.
//   SCALE = (full * micro) / output_per_motor_rev
//         = (full * micro * driven * 1000 * 1000) / (motor_pulley * pitch_x1000)
Function.Calc_Scale_x1000 {
    Input: idx: Integer
    Output: Integer
    Body: {
        full  = Axis_Get(idx, AxisField.MOTOR_FULL_STEPS)
        micro = Axis_Get(idx, AxisField.MICROSTEPS)
        pitch = Axis_Get(idx, AxisField.PITCH_x1000)
        n     = Calc_GearNum(idx)
        d     = Calc_GearDen(idx)
        denom = Multiply(d, pitch)
        IfCondition LessEqual(denom, 0) ThenBlock: { ReturnValue(0) }
        numer = Multiply(Multiply(Multiply(full, micro), n), 1000000)
        ReturnValue(Divide(numer, denom))
    }
}

// Motor-limited velocity in unit/sec, ×1000.
Function.Calc_VelMotor_x1000 {
    Input: idx: Integer
    Output: Integer
    Body: {
        rpm    = Axis_Get(idx, AxisField.MOTOR_MAX_RPM)
        out_pr = Calc_OutputPerMotorRev_x1000(idx)
        ReturnValue(Divide(Multiply(rpm, out_pr), 60))
    }
}

// Driver-limited velocity in unit/sec, ×1000.
//   v_driver = max_step_rate / SCALE
Function.Calc_VelDriver_x1000 {
    Input: idx: Integer
    Output: Integer
    Body: {
        rate  = Axis_Get(idx, AxisField.MAX_STEP_RATE)
        scale = Calc_Scale_x1000(idx)
        IfCondition LessEqual(scale, 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(Divide(Multiply(rate, 1000000), scale))
    }
}

// MAX_VELOCITY = lesser of motor and driver limits.
Function.Calc_MaxVel_x1000 {
    Input: idx: Integer
    Output: Integer
    Body: {
        vm = Calc_VelMotor_x1000(idx)
        vd = Calc_VelDriver_x1000(idx)
        IfCondition LessThan(vm, vd) ThenBlock: { ReturnValue(vm) }
        ReturnValue(vd)
    }
}

// MAX_ACCELERATION from MAX_VEL and ramp time.
//   accel = vel / time_seconds = (vel * 1000) / time_ms
Function.Calc_MaxAccel_x1000 {
    Input: idx: Integer
    Output: Integer
    Body: {
        v  = Calc_MaxVel_x1000(idx)
        ms = Axis_Get(idx, AxisField.ACCEL_TIME_MS)
        IfCondition LessEqual(ms, 0) ThenBlock: { ReturnValue(0) }
        ReturnValue(Divide(Multiply(v, 1000), ms))
    }
}

// LinuxCNC convention: STEPGEN_MAXACCEL ~= 1.25 * MAX_ACCELERATION
Function.Calc_StepgenMaxAccel_x1000 {
    Input: idx: Integer
    Output: Integer
    Body: {
        a = Calc_MaxAccel_x1000(idx)
        ReturnValue(Divide(Multiply(a, 1250), 1000))
    }
}

// Step rate (Hz) at MAX_VEL — for warning if it exceeds driver limit.
Function.Calc_StepRateAtMaxVel {
    Input: idx: Integer
    Output: Integer
    Body: {
        v     = Calc_MaxVel_x1000(idx)
        scale = Calc_Scale_x1000(idx)
        ReturnValue(Divide(Multiply(v, scale), 1000000000))
    }
}

// Same identities for the General screen (uses GenCalc state, no per-axis lookup).
Function.GenCalc_GearNum {
    Output: Integer
    Body: {
        IfCondition LessEqual(GenCalc.driven_pulley, 0) ThenBlock: { ReturnValue(1) }
        ReturnValue(GenCalc.driven_pulley)
    }
}

Function.GenCalc_GearDen {
    Output: Integer
    Body: {
        IfCondition LessEqual(GenCalc.motor_pulley, 0) ThenBlock: { ReturnValue(1) }
        ReturnValue(GenCalc.motor_pulley)
    }
}

Function.GenCalc_Scale_x1000 {
    Output: Integer
    Body: {
        n     = GenCalc_GearNum()
        d     = GenCalc_GearDen()
        denom = Multiply(d, GenCalc.pitch_x1000)
        IfCondition LessEqual(denom, 0) ThenBlock: { ReturnValue(0) }
        numer = Multiply(Multiply(Multiply(GenCalc.motor_full, GenCalc.microsteps), n), 1000000)
        ReturnValue(Divide(numer, denom))
    }
}

Function.GenCalc_OutputPerRev_x1000 {
    Output: Integer
    Body: {
        n = GenCalc_GearNum()
        d = GenCalc_GearDen()
        ReturnValue(Divide(Multiply(GenCalc.pitch_x1000, d), n))
    }
}

// =============================================================================
// INPUT HELPERS
// =============================================================================

Function.Input_Clear {
    Body: {
        InputState.len = 0
        SetByte(InputState.buf, 0, 0)
        InputState.value = 0
        ReturnValue(0)
    }
}

Function.Input_AddChar {
    Input: ch: Integer
    Body: {
        IfCondition LessThan(InputState.len, 15) ThenBlock: {
            SetByte(InputState.buf, InputState.len, ch)
            InputState.len = Add(InputState.len, 1)
            SetByte(InputState.buf, InputState.len, 0)
        }
        ReturnValue(0)
    }
}

Function.Input_Backspace {
    Body: {
        IfCondition GreaterThan(InputState.len, 0) ThenBlock: {
            InputState.len = Subtract(InputState.len, 1)
            SetByte(InputState.buf, InputState.len, 0)
        }
        ReturnValue(0)
    }
}

Function.Input_ParseInt {
    Output: Integer
    Body: {
        result = 0
        i      = 0
        WhileLoop LessThan(i, InputState.len) {
            ch = GetByte(InputState.buf, i)
            IfCondition And(GreaterEqual(ch, 48), LessEqual(ch, 57)) ThenBlock: {
                result = Add(Multiply(result, 10), Subtract(ch, 48))
            }
            i = Add(i, 1)
        }
        InputState.value = result
        ReturnValue(result)
    }
}

// Parse decimal "5", "5.0", "5.25", "12.732" → value × 1000.
Function.Input_ParseFixed {
    Output: Integer
    Body: {
        result = 0
        i      = 0
        WhileLoop And(LessThan(i, InputState.len), NotEqual(GetByte(InputState.buf, i), 46)) {
            ch = GetByte(InputState.buf, i)
            IfCondition And(GreaterEqual(ch, 48), LessEqual(ch, 57)) ThenBlock: {
                result = Add(Multiply(result, 10), Subtract(ch, 48))
            }
            i = Add(i, 1)
        }
        result = Multiply(result, 1000)
        IfCondition And(LessThan(i, InputState.len), EqualTo(GetByte(InputState.buf, i), 46)) ThenBlock: {
            i    = Add(i, 1)
            mult = 100
            WhileLoop And(LessThan(i, InputState.len), GreaterThan(mult, 0)) {
                ch = GetByte(InputState.buf, i)
                IfCondition And(GreaterEqual(ch, 48), LessEqual(ch, 57)) ThenBlock: {
                    result = Add(result, Multiply(Subtract(ch, 48), mult))
                }
                mult = Divide(mult, 10)
                i    = Add(i, 1)
            }
        }
        InputState.value = result
        ReturnValue(result)
    }
}

// =============================================================================
// DISPLAY HELPERS
// =============================================================================

Function.UI_TitleBar {
    Input: subtitle: Address
    Body: {
        TUI_SetColor(0, 6)
        TUI_MoveTo(1, 1)
        TUI_Print("  LinuxCNC StepConf v1.0  ")
        TUI_ResetColor()
        TUI_SetColor(0, 4)
        TUI_MoveTo(1, 29)
        TUI_Print(" ")
        TUI_Print(subtitle)
        TUI_Print(" ")
        TUI_ResetColor()
        ReturnValue(0)
    }
}

Function.UI_NavBar {
    Input: keys: Address
    Body: {
        TUI_SetColor(0, 7)
        TUI_MoveTo(TUI_State.screen_height, 1)
        TUI_Print(keys)
        i = 0
        WhileLoop LessThan(i, 30) {
            TUI_BufferChar(32)
            i = Add(i, 1)
        }
        TUI_ResetColor()
        ReturnValue(0)
    }
}

// Print a value × 1000 as "whole.fff" with 3 decimals.
Function.UI_PrintFixed {
    Input: row:  Integer
    Input: col:  Integer
    Input: val:  Integer
    Input: unit: Address
    Body: {
        whole = Divide(val, 1000)
        frac  = Modulo(val, 1000)
        IfCondition LessThan(val, 0) ThenBlock: {
            whole = Subtract(0, Divide(Subtract(0, val), 1000))
            frac  = Modulo(Subtract(0, val), 1000)
        }
        TUI_MoveTo(row, col)
        TUI_WriteNum(whole)
        TUI_BufferChar(46)
        IfCondition LessThan(frac, 100) ThenBlock: { TUI_BufferChar(48) }
        IfCondition LessThan(frac, 10)  ThenBlock: { TUI_BufferChar(48) }
        TUI_WriteNum(frac)
        TUI_Print(unit)
        ReturnValue(0)
    }
}

Function.UI_AxisName {
    Input: idx: Integer
    Output: Address
    Body: {
        IfCondition EqualTo(idx, 0) ThenBlock: { ReturnValue("X") }
        IfCondition EqualTo(idx, 1) ThenBlock: { ReturnValue("Y") }
        IfCondition EqualTo(idx, 2) ThenBlock: { ReturnValue("Z") }
        IfCondition EqualTo(idx, 3) ThenBlock: { ReturnValue("A") }
        ReturnValue("?")
    }
}

Function.UI_DriveTypeName {
    Input: dt: Integer
    Output: Address
    Body: {
        IfCondition EqualTo(dt, DriveType.LINEAR) ThenBlock: { ReturnValue("Linear") }
        ReturnValue("Rotary")
    }
}

Function.UI_UnitName {
    Input: idx: Integer
    Output: Address
    Body: {
        dt = Axis_Get(idx, AxisField.DRIVE_TYPE)
        IfCondition EqualTo(dt, DriveType.ROTARY) ThenBlock: { ReturnValue("deg") }
        IfCondition EqualTo(Axis_Get(idx, AxisField.USE_INCHES), 1) ThenBlock: { ReturnValue("in") }
        ReturnValue("mm")
    }
}

Function.UI_YesNo {
    Input: v: Integer
    Output: Address
    Body: {
        IfCondition EqualTo(v, 1) ThenBlock: { ReturnValue("Yes") }
        ReturnValue("No")
    }
}

// =============================================================================
// SCREEN 0: AXIS LIST
// =============================================================================

Function.Draw_Main {
    Body: {
        TUI_Clear()
        UI_TitleBar("AXIS LIST")

        TUI_MoveTo(3, 2)
        TUI_Bold()
        TUI_SetFG(3)
        TUI_Print("AXIS  TYPE     STEPS/REV  GEAR   PITCH      SCALE      MAX_VEL    MAX_ACC")
        TUI_ResetColor()
        TUI_HLine(4, 1, 78)

        i = 0
        WhileLoop LessThan(i, SCConfig.NUM_AXES) {
            row = Add(5, Multiply(i, 2))
            IfCondition EqualTo(i, App.selected) ThenBlock: {
                TUI_SetFG(0)
                TUI_SetBG(3)
            } ElseBlock: {
                TUI_SetFG(7)
            }

            TUI_MoveTo(row, 2)
            TUI_Print(" ")
            TUI_Print(UI_AxisName(i))
            TUI_Print("    ")
            TUI_Print(UI_DriveTypeName(Axis_Get(i, AxisField.DRIVE_TYPE)))
            TUI_Print("   ")

            steps = Calc_StepsPerMotorRev(i)
            TUI_MoveTo(row, 17)
            TUI_WriteNum(steps)

            TUI_MoveTo(row, 28)
            TUI_WriteNum(Calc_GearNum(i))
            TUI_Print(":")
            TUI_WriteNum(Calc_GearDen(i))

            TUI_MoveTo(row, 36)
            UI_PrintFixed(row, 36, Axis_Get(i, AxisField.PITCH_x1000), "")

            TUI_MoveTo(row, 47)
            UI_PrintFixed(row, 47, Calc_Scale_x1000(i), "")

            TUI_MoveTo(row, 58)
            UI_PrintFixed(row, 58, Calc_MaxVel_x1000(i), "")

            TUI_MoveTo(row, 69)
            UI_PrintFixed(row, 69, Calc_MaxAccel_x1000(i), "")

            TUI_ResetColor()
            i = Add(i, 1)
        }

        TUI_HLine(14, 1, 78)
        TUI_MoveTo(15, 2)
        TUI_SetFG(6)
        TUI_Print("Selected: ")
        TUI_Print(UI_AxisName(App.selected))
        TUI_Print("  unit: ")
        TUI_Print(UI_UnitName(App.selected))
        TUI_Print("   reversed: ")
        TUI_Print(UI_YesNo(Axis_Get(App.selected, AxisField.REVERSED)))
        TUI_ResetColor()

        // Step-rate sanity warning for selected axis
        rate_now = Calc_StepRateAtMaxVel(App.selected)
        rate_lim = Axis_Get(App.selected, AxisField.MAX_STEP_RATE)
        TUI_MoveTo(16, 2)
        IfCondition GreaterThan(rate_now, rate_lim) ThenBlock: {
            TUI_SetFG(1)
            TUI_Bold()
            TUI_Print("WARN: at MAX_VEL the step rate ")
            TUI_WriteNum(rate_now)
            TUI_Print(" Hz exceeds driver limit ")
            TUI_WriteNum(rate_lim)
            TUI_Print(" Hz.")
            TUI_ResetColor()
        } ElseBlock: {
            TUI_SetFG(2)
            TUI_Print("OK: step rate at MAX_VEL = ")
            TUI_WriteNum(rate_now)
            TUI_Print(" Hz (limit ")
            TUI_WriteNum(rate_lim)
            TUI_Print(" Hz).")
            TUI_ResetColor()
        }

        UI_NavBar("[Up/Dn] axis  [E]dit  [T]iming  [G]eneral  [X]port  [?] help  [Q]uit")
        ReturnValue(0)
    }
}

// =============================================================================
// SCREEN 1: EDIT AXIS
// =============================================================================

Function.Draw_Edit {
    Body: {
        idx = App.selected
        TUI_Clear()
        UI_TitleBar("EDIT AXIS")

        TUI_MoveTo(3, 2)
        TUI_SetFG(6)
        TUI_Bold()
        TUI_Print("Axis: ")
        TUI_Print(UI_AxisName(idx))
        TUI_Print("    Drive: ")
        TUI_Print(UI_DriveTypeName(Axis_Get(idx, AxisField.DRIVE_TYPE)))
        TUI_Print("    Unit: ")
        TUI_Print(UI_UnitName(idx))
        TUI_ResetColor()
        TUI_HLine(4, 1, 78)

        // Field rows. Highlight the active field.
        Draw_EditField(6,  0, "[1] Drive type        : ")
        TUI_Print(UI_DriveTypeName(Axis_Get(idx, AxisField.DRIVE_TYPE)))
        TUI_Print("       (Left/Right toggles)")
        TUI_ResetColor()

        Draw_EditField(7,  1, "[2] Motor full steps  : ")
        Draw_EditNumOrInput(1, Axis_Get(idx, AxisField.MOTOR_FULL_STEPS))
        TUI_Print("            (1.8°=200, 0.9°=400)")
        TUI_ResetColor()

        Draw_EditField(8,  2, "[3] Microsteps        : ")
        Draw_EditNumOrInput(2, Axis_Get(idx, AxisField.MICROSTEPS))
        TUI_Print("            (1, 2, 4, 8, 16, 32, 64, ...)")
        TUI_ResetColor()

        Draw_EditField(9,  3, "[4] Motor pulley T    : ")
        Draw_EditNumOrInput(3, Axis_Get(idx, AxisField.MOTOR_PULLEY))
        TUI_Print("            (drive teeth, 0=direct)")
        TUI_ResetColor()

        Draw_EditField(10, 4, "[5] Driven pulley T   : ")
        Draw_EditNumOrInput(4, Axis_Get(idx, AxisField.DRIVEN_PULLEY))
        TUI_Print("            (driven teeth, 0=direct)")
        TUI_ResetColor()

        Draw_EditField(11, 5, "[6] Pitch / output rev: ")
        Draw_EditFixedOrInput(5, Axis_Get(idx, AxisField.PITCH_x1000))
        TUI_Print(" ")
        TUI_Print(UI_UnitName(idx))
        TUI_Print(" /rev")
        TUI_ResetColor()

        Draw_EditField(12, 6, "[7] Motor max RPM     : ")
        Draw_EditNumOrInput(6, Axis_Get(idx, AxisField.MOTOR_MAX_RPM))
        TUI_ResetColor()

        Draw_EditField(13, 7, "[8] Driver max Hz     : ")
        Draw_EditNumOrInput(7, Axis_Get(idx, AxisField.MAX_STEP_RATE))
        TUI_Print("        (datasheet step rate)")
        TUI_ResetColor()

        Draw_EditField(14, 8, "[9] Accel ramp ms     : ")
        Draw_EditNumOrInput(8, Axis_Get(idx, AxisField.ACCEL_TIME_MS))
        TUI_Print("            (time to reach MAX_VEL)")
        TUI_ResetColor()

        Draw_EditField(15, 9, "[0] Reversed?         : ")
        TUI_Print(UI_YesNo(Axis_Get(idx, AxisField.REVERSED)))
        TUI_Print("              (Left/Right toggles)")
        TUI_ResetColor()

        TUI_HLine(17, 1, 78)

        // DERIVED block
        TUI_MoveTo(18, 2)
        TUI_Bold()
        TUI_SetFG(3)
        TUI_Print("DERIVED")
        TUI_ResetColor()

        TUI_MoveTo(19, 4)
        TUI_Print("Steps / motor rev    : ")
        TUI_WriteNum(Calc_StepsPerMotorRev(idx))

        TUI_MoveTo(19, 44)
        TUI_Print("Gear ratio (m:s)     : ")
        TUI_WriteNum(Calc_GearNum(idx))
        TUI_Print(":")
        TUI_WriteNum(Calc_GearDen(idx))
        TUI_Print(" = ")
        UI_PrintFixed(19, 78, Calc_GearRatio_x1000(idx), "")

        TUI_MoveTo(20, 4)
        TUI_Print(UI_UnitName(idx))
        TUI_Print(" / motor rev        : ")
        UI_PrintFixed(20, 28, Calc_OutputPerMotorRev_x1000(idx), "")

        TUI_MoveTo(20, 44)
        TUI_Print("SCALE (steps/")
        TUI_Print(UI_UnitName(idx))
        TUI_Print(")    : ")
        UI_PrintFixed(20, 68, Calc_Scale_x1000(idx), "")

        TUI_MoveTo(21, 4)
        TUI_Print("MAX_VELOCITY         : ")
        UI_PrintFixed(21, 28, Calc_MaxVel_x1000(idx), " ")
        TUI_Print(UI_UnitName(idx))
        TUI_Print("/s")

        TUI_MoveTo(21, 44)
        TUI_Print("MAX_ACCELERATION     : ")
        UI_PrintFixed(21, 68, Calc_MaxAccel_x1000(idx), "")

        TUI_MoveTo(22, 4)
        TUI_Print("STEPGEN_MAXACCEL     : ")
        UI_PrintFixed(22, 28, Calc_StepgenMaxAccel_x1000(idx), "")

        rate_now = Calc_StepRateAtMaxVel(idx)
        rate_lim = Axis_Get(idx, AxisField.MAX_STEP_RATE)
        TUI_MoveTo(22, 44)
        TUI_Print("Step rate @ MAX_VEL  : ")
        IfCondition GreaterThan(rate_now, rate_lim) ThenBlock: { TUI_SetFG(1) } ElseBlock: { TUI_SetFG(2) }
        TUI_WriteNum(rate_now)
        TUI_Print(" Hz")
        TUI_ResetColor()

        UI_NavBar("[Tab/Up/Dn]=field  digits=type value  [Enter]=accept  [Esc]=back")
        ReturnValue(0)
    }
}

// Helper: prefix the field row, color highlight if active.
Function.Draw_EditField {
    Input: row:    Integer
    Input: field:  Integer
    Input: label:  Address
    Body: {
        TUI_MoveTo(row, 2)
        IfCondition EqualTo(App.edit_field, field) ThenBlock: {
            TUI_SetFG(3)
            TUI_Bold()
        } ElseBlock: {
            TUI_SetFG(7)
        }
        TUI_Print(label)
        ReturnValue(0)
    }
}

// Helper: print an integer field, or the live input buffer if it's the active one.
Function.Draw_EditNumOrInput {
    Input: field: Integer
    Input: value: Integer
    Body: {
        IfCondition EqualTo(App.edit_field, field) ThenBlock: {
            TUI_Print(InputState.buf)
            TUI_BufferChar(95)
        } ElseBlock: {
            TUI_WriteNum(value)
        }
        ReturnValue(0)
    }
}

Function.Draw_EditFixedOrInput {
    Input: field: Integer
    Input: value: Integer
    Body: {
        IfCondition EqualTo(App.edit_field, field) ThenBlock: {
            TUI_Print(InputState.buf)
            TUI_BufferChar(95)
        } ElseBlock: {
            whole = Divide(value, 1000)
            frac  = Modulo(value, 1000)
            TUI_WriteNum(whole)
            TUI_BufferChar(46)
            IfCondition LessThan(frac, 100) ThenBlock: { TUI_BufferChar(48) }
            IfCondition LessThan(frac, 10)  ThenBlock: { TUI_BufferChar(48) }
            TUI_WriteNum(frac)
        }
        ReturnValue(0)
    }
}

// =============================================================================
// SCREEN 2: DRIVER TIMING
// =============================================================================

Function.Draw_Timing {
    Body: {
        idx = App.selected
        TUI_Clear()
        UI_TitleBar("DRIVER TIMING")

        TUI_MoveTo(3, 2)
        TUI_SetFG(8)
        TUI_Print("Times in nanoseconds. Get these from your driver's datasheet.")
        TUI_MoveTo(4, 2)
        TUI_Print("Presets are conservative starting points; trim to spec if needed.")
        TUI_ResetColor()

        TUI_HLine(5, 1, 78)

        TUI_MoveTo(6, 2)
        TUI_Bold()
        TUI_SetFG(3)
        TUI_Print("PRESETS  (press P then 1-7 to apply)")
        TUI_ResetColor()
        TUI_MoveTo(7,  4)
        TUI_Print("1) Generic safe       STEPLEN=5000  SPACE=5000  DSETUP=20000  DHOLD=20000")
        TUI_MoveTo(8,  4)
        TUI_Print("2) Gecko 201/203/540  STEPLEN=5000  SPACE=5000  DSETUP=70000  DHOLD=70000")
        TUI_MoveTo(9,  4)
        TUI_Print("3) Leadshine DM542    STEPLEN=2500  SPACE=2500  DSETUP=5000   DHOLD=5000")
        TUI_MoveTo(10, 4)
        TUI_Print("4) TB6600             STEPLEN=2500  SPACE=2500  DSETUP=5000   DHOLD=5000")
        TUI_MoveTo(11, 4)
        TUI_Print("5) DRV8825            STEPLEN=1900  SPACE=1900  DSETUP=650    DHOLD=650")
        TUI_MoveTo(12, 4)
        TUI_Print("6) A4988              STEPLEN=1000  SPACE=1000  DSETUP=200    DHOLD=200")
        TUI_MoveTo(13, 4)
        TUI_Print("7) Mesa stepgen       STEPLEN=1000  SPACE=1000  DSETUP=1000   DHOLD=1000")

        TUI_HLine(14, 1, 78)

        TUI_MoveTo(15, 2)
        TUI_Bold()
        TUI_SetFG(3)
        TUI_Print("AXIS ")
        TUI_Print(UI_AxisName(idx))
        TUI_Print(" CURRENT VALUES (Tab/1-4 to edit)")
        TUI_ResetColor()

        Draw_TimingField(16, 0, "[1] STEPLEN   (ns)    : ", Axis_Get(idx, AxisField.STEPLEN_NS))
        Draw_TimingField(17, 1, "[2] STEPSPACE (ns)    : ", Axis_Get(idx, AxisField.STEPSPACE_NS))
        Draw_TimingField(18, 2, "[3] DIRSETUP  (ns)    : ", Axis_Get(idx, AxisField.DIRSETUP_NS))
        Draw_TimingField(19, 3, "[4] DIRHOLD   (ns)    : ", Axis_Get(idx, AxisField.DIRHOLD_NS))

        // Implied driver max Hz: 1 / (STEPLEN + STEPSPACE) ns
        steplen   = Axis_Get(idx, AxisField.STEPLEN_NS)
        stepspace = Axis_Get(idx, AxisField.STEPSPACE_NS)
        period    = Add(steplen, stepspace)
        implied   = 0
        IfCondition GreaterThan(period, 0) ThenBlock: {
            implied = Divide(1000000000, period)
        }

        TUI_HLine(21, 1, 78)
        TUI_MoveTo(22, 2)
        TUI_SetFG(6)
        TUI_Print("Implied driver max step rate: ")
        TUI_WriteNum(implied)
        TUI_Print(" Hz   (1 / (STEPLEN + STEPSPACE))")
        TUI_ResetColor()

        UI_NavBar("[Tab/Up/Dn]=field  digits=type value  [Enter]=accept  [P+1-7]=preset  [Esc]=back")
        ReturnValue(0)
    }
}

Function.Draw_TimingField {
    Input: row:   Integer
    Input: field: Integer
    Input: label: Address
    Input: value: Integer
    Body: {
        TUI_MoveTo(row, 2)
        IfCondition EqualTo(App.timing_field, field) ThenBlock: {
            TUI_SetFG(3)
            TUI_Bold()
        } ElseBlock: {
            TUI_SetFG(7)
        }
        TUI_Print(label)
        IfCondition EqualTo(App.timing_field, field) ThenBlock: {
            TUI_Print(InputState.buf)
            TUI_BufferChar(95)
        } ElseBlock: {
            TUI_WriteNum(value)
        }
        TUI_ResetColor()
        ReturnValue(0)
    }
}

// =============================================================================
// SCREEN 3: GENERAL CALCULATOR
// =============================================================================

Function.Draw_General {
    Body: {
        TUI_Clear()
        UI_TitleBar("GENERAL STEPS/UNIT CALCULATOR")

        TUI_MoveTo(3, 2)
        TUI_SetFG(8)
        TUI_Print("Plug numbers in. Formula:")
        TUI_MoveTo(4, 4)
        TUI_SetFG(6)
        TUI_Print("SCALE = (full * micro * driven) / (motor * pitch)")
        TUI_ResetColor()
        TUI_HLine(5, 1, 78)

        Draw_GenField(7,  0, "[1] Motor full steps/rev : ", GenCalc.motor_full)
        Draw_GenField(8,  1, "[2] Microstep multiplier : ", GenCalc.microsteps)
        Draw_GenField(9,  2, "[3] Motor pulley teeth   : ", GenCalc.motor_pulley)
        Draw_GenField(10, 3, "[4] Driven pulley teeth  : ", GenCalc.driven_pulley)
        Draw_GenFixedField(11, 4, "[5] Output movement/rev  : ", GenCalc.pitch_x1000)

        TUI_MoveTo(12, 2)
        IfCondition EqualTo(App.general_field, 5) ThenBlock: {
            TUI_SetFG(3)
            TUI_Bold()
        } ElseBlock: {
            TUI_SetFG(7)
        }
        TUI_Print("[6] Rotary?              : ")
        TUI_Print(UI_YesNo(GenCalc.is_rotary))
        TUI_Print("    (Left/Right toggles)")
        TUI_ResetColor()

        TUI_HLine(14, 1, 78)

        // Show the working
        TUI_MoveTo(15, 2)
        TUI_SetFG(3)
        TUI_Bold()
        TUI_Print("WORKING")
        TUI_ResetColor()

        steps_per_motor_rev = Multiply(GenCalc.motor_full, GenCalc.microsteps)
        out_per_rev         = GenCalc_OutputPerRev_x1000()
        scale               = GenCalc_Scale_x1000()

        TUI_MoveTo(16, 4)
        TUI_Print("Steps / motor rev        = ")
        TUI_WriteNum(GenCalc.motor_full)
        TUI_Print(" * ")
        TUI_WriteNum(GenCalc.microsteps)
        TUI_Print(" = ")
        TUI_WriteNum(steps_per_motor_rev)

        TUI_MoveTo(17, 4)
        TUI_Print("Gear reduction (motor:out) = ")
        TUI_WriteNum(GenCalc_GearNum())
        TUI_Print(":")
        TUI_WriteNum(GenCalc_GearDen())

        TUI_MoveTo(18, 4)
        TUI_Print("Movement / motor rev      = ")
        UI_PrintFixed(18, 32, out_per_rev, "")
        IfCondition EqualTo(GenCalc.is_rotary, 1) ThenBlock: { TUI_Print(" deg") } ElseBlock: { TUI_Print(" units") }

        TUI_MoveTo(20, 4)
        TUI_Bold()
        TUI_SetFG(2)
        TUI_Print("SCALE (steps / unit)      = ")
        UI_PrintFixed(20, 32, scale, "")
        TUI_ResetColor()

        UI_NavBar("[Tab/Up/Dn]=field  digits=type value  [Enter]=accept  [Esc]=back")
        ReturnValue(0)
    }
}

