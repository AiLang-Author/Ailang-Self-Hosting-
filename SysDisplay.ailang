LibraryImport.PaneDecorator
LibraryImport.DCompose
LibraryImport.XArrays
LibraryImport.PageSurface
LibraryImport.Document
LibraryImport.SysDisplay

// =============================================================================
// APP STATE
// =============================================================================
FixedPool.AppState {
    "doc":         Initialize=-1, CanChange=True
    "line_count":  Initialize=0, CanChange=True
    "win_idx":     Initialize=-1, CanChange=True
}

// =============================================================================
// CREATE DOCUMENT AND RENDER INTO WINDOW
// =============================================================================
Function.App_CreateDocWindow {
    Output: Integer
    Body: {
        // Create a window
        win_w = 620
        win_h = 500
        win_idx = Win_Create(win_w, win_h, WinColor.WINDOW, "Notepad")
        IfCondition LessThan(win_idx, 0) ThenBlock: {
            PrintMessage("[App] Win_Create failed\n")
            ReturnValue(-1)
        }
        AppState.win_idx = win_idx

        // Kill the TextBuffer — it overwrites our content surface every frame
        old_tb = WinMgr_GetTB(win_idx)
        IfCondition GreaterEqual(old_tb, 0) ThenBlock: {
            TextBuffer_Destroy(old_tb)
        }
        WinMgr_SetTB(win_idx, -1)

        // Get the content surface
        content = WinMgr_GetContent(win_idx)
        IfCondition LessEqual(content, 0) ThenBlock: {
            PrintMessage("[App] no content surface\n")
            ReturnValue(-1)
        }

        // Create document — use LETTER as base (we replace the page anyway)
        doc = Doc_Create(PaperType.LETTER, PageOrient.PORTRAIT, 96)
        IfCondition LessThan(doc, 0) ThenBlock: {
            PrintMessage("[App] Doc_Create failed\n")
            ReturnValue(-1)
        }
        AppState.doc = doc

        // Destroy the auto-created page, make one that fits the window
        page0_auto = Doc_GetPage(doc, 0)
        IfCondition GreaterEqual(page0_auto, 0) ThenBlock: {
            PageSurface_Destroy(page0_auto)
        }

        // Create a free page sized to the window content area
        cw = Win_GetCanvasW(win_idx)
        ch = Win_GetCanvasH(win_idx)
        page = PageSurface_CreateFree(cw, ch, 96)
        IfCondition LessThan(page, 0) ThenBlock: {
            PrintMessage("[App] page create failed\n")
            ReturnValue(-1)
        }

        // Set margins for document area (16px padding)
        PageSurface_SetMarginsPixels(page, 16, 16, 16, 16)

        // Swap in our page (overwrite index 0 in page list)
        pages = Doc_Get(doc, DocField.PAGE_LIST)
        XArray.XSet(pages, 0, page)

        // Write content
        App_WriteContent(doc)

        // Blit page surface onto window content surface
        App_BlitPageToWindow(page, content, cw, ch)

        SysDisplayState.dirty = 1
        PrintMessage("[App] document window created\n")
        ReturnValue(win_idx)
    }
}

// =============================================================================
// WRITE DOCUMENT CONTENT
// =============================================================================
Function.App_WriteContent {
    Input: doc: Integer
    Body: {
        title_clr = TVG_PackColor(0, 80, 180, 255)
        body_clr = TVG_PackColor(30, 30, 30, 255)
        bullet_clr = TVG_PackColor(80, 80, 80, 255)
        accent_clr = TVG_PackColor(0, 100, 60, 255)

        VFont_FlushCache()
        VFont_RasterAll(16)

        Doc_WriteText(doc, "AILANG Document System", 22, title_clr)
        Doc_WriteText(doc, "", 0, body_clr)
        Doc_WriteText(doc, "This is a live document rendered inside a", 41, body_clr)
        Doc_WriteText(doc, "window on the AILANG display server.", 35, body_clr)
        Doc_WriteText(doc, "", 0, body_clr)
        Doc_WriteText(doc, "  - HTML markup parsed to AST", 29, bullet_clr)
        Doc_WriteText(doc, "  - Auckland binds AST to layout tree", 37, bullet_clr)
        Doc_WriteText(doc, "  - PageSurface creates the canvas", 34, bullet_clr)
        Doc_WriteText(doc, "  - Document manages pages and cursor", 37, bullet_clr)
        Doc_WriteText(doc, "  - TextRegion renders vector text", 34, bullet_clr)
        Doc_WriteText(doc, "", 0, body_clr)
        Doc_WriteText(doc, "All vectors. All scalable.", 26, accent_clr)

        AppState.line_count = 11

        VFont_FlushCache()
        VFont_RasterAll(18)
    }
}

// =============================================================================
// BLIT PAGE SURFACE INTO WINDOW CONTENT
// =============================================================================
Function.App_BlitPageToWindow {
    Input: page: Integer
    Input: dst_surf: Integer
    Input: dst_w: Integer
    Input: dst_h: Integer
    Body: {
        src_surf = PageSurface_GetSurface(page)
        IfCondition EqualTo(src_surf, 0) ThenBlock: { ReturnValue(0) }

        src_w = PageSurface_GetWidth(page)
        src_h = PageSurface_GetHeight(page)

        blit_w = src_w
        IfCondition GreaterThan(blit_w, dst_w) ThenBlock: { blit_w = dst_w }
        blit_h = src_h
        IfCondition GreaterThan(blit_h, dst_h) ThenBlock: { blit_h = dst_h }

        src_data = Surface_GetData(src_surf)
        src_pitch = Surface_GetPitch(src_surf)
        dst_data = Surface_GetData(dst_surf)
        dst_pitch = Surface_GetPitch(dst_surf)
        row_bytes = Multiply(blit_w, 4)

        by = 0
        WhileLoop LessThan(by, blit_h) {
            src_row = Add(src_data, Multiply(by, src_pitch))
            dst_row = Add(dst_data, Multiply(by, dst_pitch))
            bx = 0
            WhileLoop LessThan(bx, row_bytes) {
                SetByte(dst_row, bx, GetByte(src_row, bx))
                bx = Add(bx, 1)
            }
            by = Add(by, 1)
        }
    }
}

// =============================================================================
// ADD LINE — called by "Add Text" button
// =============================================================================
Function.App_AddLine {
    Output: Integer
    Body: {
        IfCondition LessThan(AppState.doc, 0) ThenBlock: { ReturnValue(0) }
        IfCondition LessThan(AppState.win_idx, 0) ThenBlock: { ReturnValue(0) }

        AppState.line_count = Add(AppState.line_count, 1)
        lnum = AppState.line_count

        prefix = "Line "
        num_str = NumberToString(lnum)
        suffix = ": Added live!"
        part1 = StringConcat(prefix, num_str)
        full_line = StringConcat(part1, suffix)
        full_len = StringLength(full_line)

        green = TVG_PackColor(0, 120, 40, 255)
        VFont_FlushCache()
        VFont_RasterAll(16)
        Doc_WriteText(AppState.doc, full_line, full_len, green)
        VFont_FlushCache()
        VFont_RasterAll(18)

        // Re-blit page to window
        page = Doc_GetPage(AppState.doc, 0)
        content = WinMgr_GetContent(AppState.win_idx)
        cw = Win_GetCanvasW(AppState.win_idx)
        ch = Win_GetCanvasH(AppState.win_idx)
        App_BlitPageToWindow(page, content, cw, ch)

        SysDisplayState.dirty = 1
        PrintMessage("[App] added line ")
        PrintNumber(lnum)
        PrintMessage("\n")
        ReturnValue(1)
    }
}

// =============================================================================
// ACTION DISPATCH
// =============================================================================
Function.SysAction_Dispatch {
    Input: action_ptr: Address
    Input: action_len: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(action_ptr, 0) ThenBlock: { ReturnValue(0) }

        // win.new — create document window
        cmp_new = StringCompare(action_ptr, "win.new")
        IfCondition EqualTo(cmp_new, 0) ThenBlock: {
            PrintMessage("[ACTION] win.new\n")
            App_CreateDocWindow()
            ReturnValue(1)
        }

        // win.close — close focused window
        cmp_close = StringCompare(action_ptr, "win.close")
        IfCondition EqualTo(cmp_close, 0) ThenBlock: {
            PrintMessage("[ACTION] win.close\n")
            focused = WinMgr.focused
            IfCondition GreaterThan(focused, 0) ThenBlock: {
                closed = Win_Close(focused)
                IfCondition EqualTo(closed, 1) ThenBlock: {
                    SysDisplayState.dirty = 1
                }
            }
            ReturnValue(1)
        }

        // doc.addtext — add a line to the document
        cmp_add = StringCompare(action_ptr, "doc.addtext")
        IfCondition EqualTo(cmp_add, 0) ThenBlock: {
            PrintMessage("[ACTION] doc.addtext\n")
            App_AddLine()
            ReturnValue(1)
        }

        // doc.newpage — placeholder
        cmp_np = StringCompare(action_ptr, "doc.newpage")
        IfCondition EqualTo(cmp_np, 0) ThenBlock: {
            PrintMessage("[ACTION] doc.newpage — not yet\n")
            ReturnValue(1)
        }

        // doc.clear — placeholder
        cmp_clr = StringCompare(action_ptr, "doc.clear")
        IfCondition EqualTo(cmp_clr, 0) ThenBlock: {
            PrintMessage("[ACTION] doc.clear — not yet\n")
            ReturnValue(1)
        }

        // app.about — placeholder
        cmp_about = StringCompare(action_ptr, "app.about")
        IfCondition EqualTo(cmp_about, 0) ThenBlock: {
            PrintMessage("[ACTION] app.about\n")
            ReturnValue(1)
        }

        PrintMessage("[ACTION] unknown: ")
        PrintMessage(action_ptr)
        PrintMessage("\n")
        ReturnValue(0)
    }
}

// =============================================================================
// MAIN
// =============================================================================
SubRoutine.Main {
    Arena_Init()
    SysDisplay_Init()

    PrintMessage("[ENTRY] Building Auckland taskbar from markup\n")

    AK_Init()
    AKEvent_Init()
    HTML_Init()
    PageSurface_Init()
    Doc_Init()
    VFont_RasterAll(18)

    fb_w = SysDisplayState.scr_w
    fb_h = SysDisplayState.scr_h
    d_surf = SysDisplayState.desktop_surf

    AKTree.design_w = fb_w
    AKTree.design_h = fb_h
    AKTree.canvas = d_surf

    // Register action callback
    AKEvent.action_callback = AddressOf(SysAction_Dispatch)

    // Parse taskbar markup
    ak_root = AKParse_File("markup/taskbar.html")
    IfCondition LessThan(ak_root, 0) ThenBlock: {
        PrintMessage("[ENTRY] FATAL: taskbar parse failed\n")
        SysDisplay_Shutdown()
        ReturnValue(0)
    }

    // Render taskbar
    AK_Draw(d_surf, fb_w, fb_h)
    SysDisplayState.dirty = 1
    Win_BlitAll()
    PrintMessage("[Auckland] taskbar rendered\n")

    // Create initial document window
    VFont_FlushCache()
    VFont_RasterAll(16)
    App_CreateDocWindow()
    VFont_FlushCache()
    VFont_RasterAll(18)
    Win_BlitAll()

    // Enter main loop
     SysDisplay_Run()
    SysDisplay_Shutdown()
}

RunTask(Main)