// SysDisplay.ailang
// Entry point — display server with Auckland UI taskbar
//
// Copyright © 2026 Sean Collins, 2 Paws Machine and Engineering. All rights reserved. SCSL.

LibraryImport.Arena
LibraryImport.DSurfaceTypes
LibraryImport.DSurface
LibraryImport.DDrawPixel
LibraryImport.Framebuffer
LibraryImport.VIF
LibraryImport.SurfaceBlit
LibraryImport.Fonts
LibraryImport.TextRegion
LibraryImport.Auckland
LibraryImport.AucklandEvent
LibraryImport.SysDisplay

SubRoutine.Main {
    Arena_Init()
    SysDisplay_Init()

    PrintMessage("[ENTRY] Init returned, building Auckland tree\n")
    // === Auckland taskbar on desktop surface ===
    AK_Init()
    AKEvent_Init()
    VFont_RasterAll(18)

    fb_w = SysDisplayState.scr_w
    fb_h = SysDisplayState.scr_h
    d_surf = SysDisplayState.desktop_surf

    AKTree.design_w = fb_w
    AKTree.design_h = fb_h
    AKTree.canvas = d_surf

    // Root — full screen, vbox, pad top=120 to clear title text
    ak_win = AK_CreateNode(AKTag.WINDOW)
    AK_Set(ak_win, AKF.LAYOUT_MODE, AKLayout.VBOX)
    AK_Set(ak_win, AKF.PAD_T, 120)
    AK_Set(ak_win, AKF.PAD_R, 20)
    AK_Set(ak_win, AKF.PAD_B, 20)
    AK_Set(ak_win, AKF.PAD_L, 20)
    AK_Set(ak_win, AKF.GAP, 12)
    AK_SetRoot(ak_win)

    // Spacer pushes everything to bottom
    ak_space = AK_CreateNode(AKTag.SPACER)
    AK_Set(ak_space, AKF.GROW, 1)
    AK_AddChild(ak_win, ak_space)

    // Status label
    ak_lbl = AK_CreateNode(AKTag.LABEL)
    AK_Set(ak_lbl, AKF.HEIGHT, 24)
    AK_ExtraSet(ak_lbl, AKExtra.STR_PTR, "Auckland Event Routing — Live")
    AK_ExtraSet(ak_lbl, AKExtra.STR_LEN, 29)
    AK_ExtraSet(ak_lbl, AKExtra.COLOR_FG, TVG_PackColor(120, 200, 255, 255))
    AK_ExtraSet(ak_lbl, AKExtra.TEXT_ALIGN, TRAlign.LEFT)
    AK_AddChild(ak_win, ak_lbl)

    // Button panel — hbox at bottom
    ak_panel = AK_CreateNode(AKTag.PANEL)
    AK_Set(ak_panel, AKF.LAYOUT_MODE, AKLayout.HBOX)
    AK_Set(ak_panel, AKF.HEIGHT, 50)
    AK_Set(ak_panel, AKF.GAP, 12)
    AK_Set(ak_panel, AKF.PAD_T, 5)
    AK_Set(ak_panel, AKF.PAD_R, 12)
    AK_Set(ak_panel, AKF.PAD_B, 5)
    AK_Set(ak_panel, AKF.PAD_L, 12)
    AK_ExtraSet(ak_panel, AKExtra.COLOR_BG, TVG_PackColor(30, 30, 50, 255))
    AK_ExtraSet(ak_panel, AKExtra.BORDER_W, 1)
    AK_ExtraSet(ak_panel, AKExtra.BORDER_CLR, TVG_PackColor(60, 60, 90, 255))
    AK_AddChild(ak_win, ak_panel)

    // New Window button
    ak_btn1 = AK_CreateNode(AKTag.BUTTON)
    AK_Set(ak_btn1, AKF.GROW, 1)
    AK_Set(ak_btn1, AKF.HEIGHT, 40)
    AK_ExtraSet(ak_btn1, AKExtra.STR_PTR, "New Window")
    AK_ExtraSet(ak_btn1, AKExtra.STR_LEN, 10)
    AK_ExtraSet(ak_btn1, AKExtra.COLOR_FG, TVG_PackColor(255, 255, 255, 255))
    AK_ExtraSet(ak_btn1, AKExtra.COLOR_BG, TVG_PackColor(0, 100, 200, 255))
    AK_ExtraSet(ak_btn1, AKExtra.ACTION_PTR, "win.new")
    AK_ExtraSet(ak_btn1, AKExtra.ACTION_LEN, 7)
    AK_AddChild(ak_panel, ak_btn1)

    // Close Focused button
    ak_btn2 = AK_CreateNode(AKTag.BUTTON)
    AK_Set(ak_btn2, AKF.GROW, 1)
    AK_Set(ak_btn2, AKF.HEIGHT, 40)
    AK_ExtraSet(ak_btn2, AKExtra.STR_PTR, "Close Focused")
    AK_ExtraSet(ak_btn2, AKExtra.STR_LEN, 13)
    AK_ExtraSet(ak_btn2, AKExtra.COLOR_FG, TVG_PackColor(255, 255, 255, 255))
    AK_ExtraSet(ak_btn2, AKExtra.COLOR_BG, TVG_PackColor(180, 40, 40, 255))
    AK_ExtraSet(ak_btn2, AKExtra.ACTION_PTR, "win.close")
    AK_ExtraSet(ak_btn2, AKExtra.ACTION_LEN, 9)
    AK_AddChild(ak_panel, ak_btn2)

    // About button
    ak_btn3 = AK_CreateNode(AKTag.BUTTON)
    AK_Set(ak_btn3, AKF.GROW, 1)
    AK_Set(ak_btn3, AKF.HEIGHT, 40)
    AK_ExtraSet(ak_btn3, AKExtra.STR_PTR, "About")
    AK_ExtraSet(ak_btn3, AKExtra.STR_LEN, 5)
    AK_ExtraSet(ak_btn3, AKExtra.COLOR_FG, TVG_PackColor(255, 255, 255, 255))
    AK_ExtraSet(ak_btn3, AKExtra.COLOR_BG, TVG_PackColor(60, 60, 80, 255))
    AK_ExtraSet(ak_btn3, AKExtra.ACTION_PTR, "app.about")
    AK_ExtraSet(ak_btn3, AKExtra.ACTION_LEN, 9)
    AK_AddChild(ak_panel, ak_btn3)

    // Solve layout and render initial frame
    AK_Draw(d_surf, fb_w, fb_h)
    SysDisplayState.dirty = 1
    Win_BlitAll()
    PrintMessage("[Auckland] taskbar rendered on desktop\n")

    // Enter main loop — this blocks until ESC
    SysDisplay_Run()
    SysDisplay_Shutdown()
}

RunTask(Main)