LibraryImport.DSurfaceTypes
LibraryImport.DSurface
LibraryImport.DDrawPixel
LibraryImport.Arena
LibraryImport.VIF
LibraryImport.SurfaceBlit
LibraryImport.Fonts
LibraryImport.TextRegion
LibraryImport.Auckland

Function.Test_DumpSurface {
    Input:  surf:     Integer
    Input:  w:        Integer
    Input:  h:        Integer
    Input:  filename: Integer
    Output: Integer
    Body: {
        fd = SystemCall(2, filename, 577, 420)
        IfCondition LessThan(fd, 0) ThenBlock: {
            PrintMessage("[dump] cannot create file\n")
            ReturnValue(0)
        }
        src_data  = Surface_GetData(surf)
        src_pitch = Surface_GetPitch(surf)
        row_bytes = Multiply(w, 4)
        row_buf   = Allocate(row_bytes)
        row = 0
        WhileLoop LessThan(row, h) {
            src_row = Multiply(row, src_pitch)
            src_row = Add(src_data, src_row)
            col = 0
            WhileLoop LessThan(col, w) {
                src_off = Multiply(col, 4)
                dst_off = Multiply(col, 4)
                b = GetByte(src_row, src_off)
                t = Add(src_off, 1)
                g = GetByte(src_row, t)
                t = Add(src_off, 2)
                r = GetByte(src_row, t)
                t = Add(src_off, 3)
                a = GetByte(src_row, t)
                SetByte(row_buf, dst_off, r)
                t = Add(dst_off, 1)
                SetByte(row_buf, t, g)
                t = Add(dst_off, 2)
                SetByte(row_buf, t, b)
                t = Add(dst_off, 3)
                SetByte(row_buf, t, a)
                col = Add(col, 1)
            }
            SystemCall(1, fd, row_buf, row_bytes)
            row = Add(row, 1)
        }
        Deallocate(row_buf, row_bytes)
        SystemCall(3, fd, 0, 0)
        PrintMessage("[dump] wrote ")
        PrintMessage(filename)
        PrintMessage("\n")
        ReturnValue(1)
    }
}

Function.Test_PrintRect {
    Input: name: Integer
    Input: node: Integer
    Body: {
        PrintMessage("  ")
        PrintMessage(name)
        PrintMessage(": x=")
        PrintNumber(AK_Get(node, AKF.SOLVED_X))
        PrintMessage(" y=")
        PrintNumber(AK_Get(node, AKF.SOLVED_Y))
        PrintMessage(" w=")
        PrintNumber(AK_Get(node, AKF.SOLVED_W))
        PrintMessage(" h=")
        PrintNumber(AK_Get(node, AKF.SOLVED_H))
        PrintMessage("\n")
        ReturnValue(0)
    }
}

SubRoutine.Main {
    PrintMessage("=== Auckland Layout Test ===\n")

    Arena_Init()
    VIF_Init()
    VFont_Init()
    TextRegion_Init()
    AK_Init()

    ok = VFont_LoadVIF("fonts/DejaVuSans.vif")
    IfCondition EqualTo(ok, 0) ThenBlock: {
        PrintMessage("[FAIL] cannot load font\n")
    }
    IfCondition EqualTo(ok, 1) ThenBlock: {
        VFont_RasterAll(18)

        canvas_w = 640
        canvas_h = 480
        canvas = Surface_Create(SurfaceFormat.PIXEL_32, canvas_w, canvas_h)
        bg = TVG_PackColor(26, 26, 46, 255)
        Draw_Pix_FillRect(canvas, 0, 0, canvas_w, canvas_h, bg)

        // =========================================================
        // Build a layout tree:
        //
        // window (vbox, padding=16, gap=12)
        //   panel (bg, border, padding=12)
        //     label "Auckland Layout Engine"
        //   group (hbox, gap=8)
        //     button "One"
        //     button "Two"
        //     button "Three"
        //   separator
        //   group (grid, cols=3, gap=8)
        //     button "A"
        //     button "B"
        //     button "C"
        //     button "D"
        //     button "E"
        //     button "F"
        //   spacer (grow=1)
        //   group (hbox, gap=8, justify=end)
        //     label "Status: Ready"
        //     spacer (grow=1)
        //     button "OK"
        //     button "Cancel"
        // =========================================================

        AKTree.design_w = 640
        AKTree.design_h = 480

        // Window root
        win = AK_CreateNode(AKTag.WINDOW)
        AK_Set(win, AKF.LAYOUT_MODE, AKLayout.VBOX)
        AK_Set(win, AKF.PAD_T, 16)
        AK_Set(win, AKF.PAD_R, 16)
        AK_Set(win, AKF.PAD_B, 16)
        AK_Set(win, AKF.PAD_L, 16)
        AK_Set(win, AKF.GAP, 12)
        AK_SetRoot(win)

        // Header panel
        panel = AK_CreateNode(AKTag.PANEL)
        AK_Set(panel, AKF.LAYOUT_MODE, AKLayout.VBOX)
        AK_Set(panel, AKF.PAD_T, 12)
        AK_Set(panel, AKF.PAD_R, 12)
        AK_Set(panel, AKF.PAD_B, 12)
        AK_Set(panel, AKF.PAD_L, 12)
        AK_ExtraSet(panel, AKExtra.COLOR_BG, TVG_PackColor(37, 37, 64, 255))
        AK_ExtraSet(panel, AKExtra.BORDER_W, 1)
        AK_ExtraSet(panel, AKExtra.BORDER_CLR, TVG_PackColor(80, 80, 120, 255))
        AK_AddChild(win, panel)

        // Title label
        title = AK_CreateNode(AKTag.LABEL)
        AK_ExtraSet(title, AKExtra.STR_PTR, "Auckland Layout Engine")
        AK_ExtraSet(title, AKExtra.STR_LEN, 22)
        AK_ExtraSet(title, AKExtra.COLOR_FG, TVG_PackColor(255, 255, 255, 255))
        AK_ExtraSet(title, AKExtra.TEXT_ALIGN, TRAlign.CENTER)
        AK_AddChild(panel, title)

        // HBox row of buttons
        hbox1 = AK_CreateNode(AKTag.GROUP)
        AK_Set(hbox1, AKF.LAYOUT_MODE, AKLayout.HBOX)
        AK_Set(hbox1, AKF.GAP, 8)
        AK_Set(hbox1, AKF.HEIGHT, 40)
        AK_AddChild(win, hbox1)

        btn1 = AK_CreateNode(AKTag.BUTTON)
        AK_Set(btn1, AKF.GROW, 1)
        AK_ExtraSet(btn1, AKExtra.STR_PTR, "One")
        AK_ExtraSet(btn1, AKExtra.STR_LEN, 3)
        AK_AddChild(hbox1, btn1)

        btn2 = AK_CreateNode(AKTag.BUTTON)
        AK_Set(btn2, AKF.GROW, 1)
        AK_ExtraSet(btn2, AKExtra.STR_PTR, "Two")
        AK_ExtraSet(btn2, AKExtra.STR_LEN, 3)
        AK_AddChild(hbox1, btn2)

        btn3 = AK_CreateNode(AKTag.BUTTON)
        AK_Set(btn3, AKF.GROW, 1)
        AK_ExtraSet(btn3, AKExtra.STR_PTR, "Three")
        AK_ExtraSet(btn3, AKExtra.STR_LEN, 5)
        AK_AddChild(hbox1, btn3)

        // Separator
        sep = AK_CreateNode(AKTag.SEPARATOR)
        AK_Set(sep, AKF.HEIGHT, 1)
        AK_ExtraSet(sep, AKExtra.COLOR_FG, TVG_PackColor(80, 80, 120, 255))
        AK_AddChild(win, sep)

        // Grid 3x2
        grid = AK_CreateNode(AKTag.GROUP)
        AK_Set(grid, AKF.LAYOUT_MODE, AKLayout.GRID)
        AK_Set(grid, AKF.COLS, 3)
        AK_Set(grid, AKF.GAP, 8)
        AK_Set(grid, AKF.HEIGHT, 100)
        AK_AddChild(win, grid)

        ga = AK_CreateNode(AKTag.BUTTON)
        AK_ExtraSet(ga, AKExtra.STR_PTR, "A")
        AK_ExtraSet(ga, AKExtra.STR_LEN, 1)
        AK_AddChild(grid, ga)

        gb = AK_CreateNode(AKTag.BUTTON)
        AK_ExtraSet(gb, AKExtra.STR_PTR, "B")
        AK_ExtraSet(gb, AKExtra.STR_LEN, 1)
        AK_AddChild(grid, gb)

        gc = AK_CreateNode(AKTag.BUTTON)
        AK_ExtraSet(gc, AKExtra.STR_PTR, "C")
        AK_ExtraSet(gc, AKExtra.STR_LEN, 1)
        AK_AddChild(grid, gc)

        gd = AK_CreateNode(AKTag.BUTTON)
        AK_ExtraSet(gd, AKExtra.STR_PTR, "D")
        AK_ExtraSet(gd, AKExtra.STR_LEN, 1)
        AK_AddChild(grid, gd)

        ge = AK_CreateNode(AKTag.BUTTON)
        AK_ExtraSet(ge, AKExtra.STR_PTR, "E")
        AK_ExtraSet(ge, AKExtra.STR_LEN, 1)
        AK_AddChild(grid, ge)

        gf = AK_CreateNode(AKTag.BUTTON)
        AK_ExtraSet(gf, AKExtra.STR_PTR, "F")
        AK_ExtraSet(gf, AKExtra.STR_LEN, 1)
        AK_AddChild(grid, gf)

        // Spacer
        spacer = AK_CreateNode(AKTag.SPACER)
        AK_Set(spacer, AKF.GROW, 1)
        AK_AddChild(win, spacer)

        // Bottom bar (hbox)
        hbox2 = AK_CreateNode(AKTag.GROUP)
        AK_Set(hbox2, AKF.LAYOUT_MODE, AKLayout.HBOX)
        AK_Set(hbox2, AKF.GAP, 8)
        AK_Set(hbox2, AKF.HEIGHT, 36)
        AK_AddChild(win, hbox2)

        status = AK_CreateNode(AKTag.LABEL)
        AK_ExtraSet(status, AKExtra.STR_PTR, "Status: Ready")
        AK_ExtraSet(status, AKExtra.STR_LEN, 13)
        AK_ExtraSet(status, AKExtra.COLOR_FG, TVG_PackColor(150, 150, 170, 255))
        AK_ExtraSet(status, AKExtra.TEXT_ALIGN, TRAlign.LEFT)
        AK_AddChild(hbox2, status)

        spacer2 = AK_CreateNode(AKTag.SPACER)
        AK_Set(spacer2, AKF.GROW, 1)
        AK_AddChild(hbox2, spacer2)

        btn_ok = AK_CreateNode(AKTag.BUTTON)
        AK_Set(btn_ok, AKF.WIDTH, 80)
        AK_ExtraSet(btn_ok, AKExtra.STR_PTR, "OK")
        AK_ExtraSet(btn_ok, AKExtra.STR_LEN, 2)
        AK_ExtraSet(btn_ok, AKExtra.COLOR_BG, TVG_PackColor(76, 175, 80, 255))
        AK_AddChild(hbox2, btn_ok)

        btn_cancel = AK_CreateNode(AKTag.BUTTON)
        AK_Set(btn_cancel, AKF.WIDTH, 80)
        AK_ExtraSet(btn_cancel, AKExtra.STR_PTR, "Cancel")
        AK_ExtraSet(btn_cancel, AKExtra.STR_LEN, 6)
        AK_AddChild(hbox2, btn_cancel)

        // Solve and draw
        PrintMessage("\n[Test] Solving layout...\n")
        AK_Draw(canvas, canvas_w, canvas_h)

        // Print solved rects
        PrintMessage("\n[Solved Rectangles]\n")
        Test_PrintRect("window", win)
        Test_PrintRect("panel", panel)
        Test_PrintRect("title", title)
        Test_PrintRect("hbox1", hbox1)
        Test_PrintRect("btn One", btn1)
        Test_PrintRect("btn Two", btn2)
        Test_PrintRect("btn Three", btn3)
        Test_PrintRect("separator", sep)
        Test_PrintRect("grid", grid)
        Test_PrintRect("grid A", ga)
        Test_PrintRect("grid B", gb)
        Test_PrintRect("grid C", gc)
        Test_PrintRect("grid D", gd)
        Test_PrintRect("grid E", ge)
        Test_PrintRect("grid F", gf)
        Test_PrintRect("spacer", spacer)
        Test_PrintRect("hbox2", hbox2)
        Test_PrintRect("status", status)
        Test_PrintRect("btn OK", btn_ok)
        Test_PrintRect("btn Cancel", btn_cancel)

        // Dump
        Test_DumpSurface(canvas, canvas_w, canvas_h, "out_auckland.rgba")
        PrintMessage("\nConvert with:\n")
        PrintMessage("ffmpeg -vcodec rawvideo -f rawvideo -pix_fmt rgba -s 640x480 -i out_auckland.rgba -update 1 -y out_auckland.png\n")
    }

    AK_Shutdown()
    TextRegion_Shutdown()
    VFont_Shutdown()
    VIF_Shutdown()
    PrintMessage("=== done ===\n")
}

RunTask(Main)