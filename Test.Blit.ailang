// Test.Blit.ailang
// Test surface blit — render glyphs, blit tinted onto white canvas.
// Copyright © 2026 Sean Collins, 2 Paws Machine and Engineering. SCSL.

LibraryImport.DSurfaceTypes
LibraryImport.DSurface
LibraryImport.DDrawPixel
LibraryImport.Arena
LibraryImport.VIF
LibraryImport.SurfaceBlit

Function.Test_DumpSurface {
    Input:  surf:     Integer
    Input:  w:        Integer
    Input:  h:        Integer
    Input:  filename: Integer
    Output: Integer
    Body: {
        fd = SystemCall(2, filename, 577, 420)
        IfCondition LessThan(fd, 0) ThenBlock: {
            PrintMessage("[dump] cannot create file\n")
            ReturnValue(0)
        }
        src_data  = Surface_GetData(surf)
        src_pitch = Surface_GetPitch(surf)
        row_bytes = Multiply(w, 4)
        row_buf   = Allocate(row_bytes)
        row = 0
        WhileLoop LessThan(row, h) {
            src_row = Multiply(row, src_pitch)
            src_row = Add(src_data, src_row)
            col = 0
            WhileLoop LessThan(col, w) {
                src_off = Multiply(col, 4)
                dst_off = Multiply(col, 4)
                b = GetByte(src_row, src_off)
                t = Add(src_off, 1)
                g = GetByte(src_row, t)
                t = Add(src_off, 2)
                r = GetByte(src_row, t)
                t = Add(src_off, 3)
                a = GetByte(src_row, t)
                SetByte(row_buf, dst_off, r)
                t = Add(dst_off, 1)
                SetByte(row_buf, t, g)
                t = Add(dst_off, 2)
                SetByte(row_buf, t, b)
                t = Add(dst_off, 3)
                SetByte(row_buf, t, a)
                col = Add(col, 1)
            }
            SystemCall(1, fd, row_buf, row_bytes)
            row = Add(row, 1)
        }
        Deallocate(row_buf, row_bytes)
        SystemCall(3, fd, 0, 0)
        PrintMessage("[dump] wrote ")
        PrintMessage(filename)
        PrintMessage("\n")
        ReturnValue(1)
    }
}

// Load a TVG file from disk, returns (data_ptr, size) via FixedPool
FixedPool.FileLoad {
    "data": Initialize=0
    "size": Initialize=0
}

Function.Test_LoadFile {
    Input: path: Integer
    Output: Integer
    Body: {
        fd = SystemCall(2, path, 0, 0)
        IfCondition LessThan(fd, 0) ThenBlock: {
            PrintMessage("[load] cannot open ")
            PrintMessage(path)
            PrintMessage("\n")
            ReturnValue(0)
        }
        sz = SystemCall(8, fd, 0, 2)
        SystemCall(8, fd, 0, 0)
        buf = Allocate(sz)
        SystemCall(0, fd, buf, sz)
        SystemCall(3, fd, 0, 0)
        FileLoad.data = buf
        FileLoad.size = sz
        ReturnValue(1)
    }
}

SubRoutine.Main {
    PrintMessage("=== Blit Test ===\n")

    VIF_Init()

    // Create white canvas 1024x512
    canvas_w = 1024
    canvas_h = 512
    canvas = Surface_Create(SurfaceFormat.PIXEL_32, canvas_w, canvas_h)
    // Fill white (BGRA = 0xFFFFFFFF)
    Draw_Pix_FillRect(canvas, 0, 0, canvas_w, canvas_h, 4294967295)
    PrintMessage("[test] white canvas created\n")

    // Load letter A
    ok = Test_LoadFile("fonts/dejavu-sans/tvg/0041_A.tvg")
    IfCondition EqualTo(ok, 1) ThenBlock: {
        glyph_a = TVG_Parse(FileLoad.data, FileLoad.size, 256)
        PrintMessage("[test] A rasterized, surf=")
        PrintNumber(glyph_a)
        PrintMessage("\n")

        IfCondition GreaterThan(glyph_a, 0) ThenBlock: {
            // Blit black (original) at position (10, 10)
            Surface_BlitAlpha(canvas, glyph_a, 10, 10)
            PrintMessage("[test] A blitted (black) at 10,10\n")

            // Blit tinted red at (80, 10) — red = 0xFF0000FF in BGRA = 0xFF0000FF
            // Pack as BGRA: B=0, G=0, R=255, A=255
            red = Add(Multiply(255, 65536), Multiply(255, 16777216))
            Surface_BlitTinted(canvas, glyph_a, 80, 10, red)
            PrintMessage("[test] A blitted (red) at 80,10\n")

            // Blit tinted blue at (150, 10)
            // BGRA: B=255, G=0, R=0, A=255
            blue = Add(255, Multiply(255, 16777216))
            Surface_BlitTinted(canvas, glyph_a, 150, 10, blue)
            PrintMessage("[test] A blitted (blue) at 150,10\n")

            // Blit tinted green at (220, 10)
            // BGRA: B=0, G=255, R=0, A=255
            green = Add(Multiply(255, 256), Multiply(255, 16777216))
            Surface_BlitTinted(canvas, glyph_a, 220, 10, green)
            PrintMessage("[test] A blitted (green) at 220,10\n")
        }
        Deallocate(FileLoad.data, FileLoad.size)
    }

    // Load letter H
    ok = Test_LoadFile("fonts/dejavu-sans/tvg/0048_H.tvg")
    IfCondition EqualTo(ok, 1) ThenBlock: {
        glyph_h = TVG_Parse(FileLoad.data, FileLoad.size, 256)
        IfCondition GreaterThan(glyph_h, 0) ThenBlock: {
            // Dark purple tint
            purple = Add(155, Add(Multiply(57, 256), Add(Multiply(93, 65536), Multiply(255, 16777216))))
            Surface_BlitTinted(canvas, glyph_h, 290, 10, purple)
            PrintMessage("[test] H blitted (purple) at 290,10\n")
        }
        Deallocate(FileLoad.data, FileLoad.size)
    }

    // Load letter i
    ok = Test_LoadFile("fonts/dejavu-sans/tvg/0069_i.tvg")
    IfCondition EqualTo(ok, 1) ThenBlock: {
        glyph_i = TVG_Parse(FileLoad.data, FileLoad.size, 256)
        IfCondition GreaterThan(glyph_i, 0) ThenBlock: {
            purple = Add(155, Add(Multiply(57, 256), Add(Multiply(93, 65536), Multiply(255, 16777216))))
            Surface_BlitTinted(canvas, glyph_i, 360, 10, purple)
            PrintMessage("[test] i blitted (purple) at 360,10\n")
        }
        Deallocate(FileLoad.data, FileLoad.size)
    }

    // Dump result
    Test_DumpSurface(canvas, canvas_w, canvas_h, "out_blit.rgba")
    PrintMessage("ffmpeg -vcodec rawvideo -f rawvideo -pix_fmt rgba -s 1024x512 -i out_blit.rgba -update 1 -y out_blit.png\n")

    VIF_Shutdown()
    PrintMessage("=== done ===\n")
}

RunTask(Main)