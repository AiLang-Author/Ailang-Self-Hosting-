// Test.Text.ailang
// Test text rendering — load VIF font, render strings on white canvas.
// Copyright © 2026 Sean Collins, 2 Paws Machine and Engineering. SCSL.

LibraryImport.DSurfaceTypes
LibraryImport.DSurface
LibraryImport.DDrawPixel
LibraryImport.Arena
LibraryImport.VIF
LibraryImport.SurfaceBlit
LibraryImport.Fonts

Function.Test_DumpSurface {
    Input:  surf:     Integer
    Input:  w:        Integer
    Input:  h:        Integer
    Input:  filename: Integer
    Output: Integer
    Body: {
        fd = SystemCall(2, filename, 577, 420)
        IfCondition LessThan(fd, 0) ThenBlock: {
            PrintMessage("[dump] cannot create file\n")
            ReturnValue(0)
        }
        src_data  = Surface_GetData(surf)
        src_pitch = Surface_GetPitch(surf)
        row_bytes = Multiply(w, 4)
        row_buf   = Allocate(row_bytes)
        row = 0
        WhileLoop LessThan(row, h) {
            src_row = Multiply(row, src_pitch)
            src_row = Add(src_data, src_row)
            col = 0
            WhileLoop LessThan(col, w) {
                src_off = Multiply(col, 4)
                dst_off = Multiply(col, 4)
                b = GetByte(src_row, src_off)
                t = Add(src_off, 1)
                g = GetByte(src_row, t)
                t = Add(src_off, 2)
                r = GetByte(src_row, t)
                t = Add(src_off, 3)
                a = GetByte(src_row, t)
                SetByte(row_buf, dst_off, r)
                t = Add(dst_off, 1)
                SetByte(row_buf, t, g)
                t = Add(dst_off, 2)
                SetByte(row_buf, t, b)
                t = Add(dst_off, 3)
                SetByte(row_buf, t, a)
                col = Add(col, 1)
            }
            SystemCall(1, fd, row_buf, row_bytes)
            row = Add(row, 1)
        }
        Deallocate(row_buf, row_bytes)
        SystemCall(3, fd, 0, 0)
        PrintMessage("[dump] wrote ")
        PrintMessage(filename)
        PrintMessage("\n")
        ReturnValue(1)
    }
}

SubRoutine.Main {
    PrintMessage("=== Text Rendering Test ===\n")

    VIF_Init()
    VFont_Init()

    // Load font
    ok = VFont_LoadVIF("fonts/DejaVuSans.vif")
    IfCondition EqualTo(ok, 0) ThenBlock: {
        PrintMessage("[FAIL] cannot load font\n")
    }
    IfCondition EqualTo(ok, 1) ThenBlock: {
        // Create white canvas
        canvas_w = 800
        canvas_h = 400
        canvas = Surface_Create(SurfaceFormat.PIXEL_32, canvas_w, canvas_h)
        Draw_Pix_FillRect(canvas, 0, 0, canvas_w, canvas_h, 4294967295)

        // Render at 48px
        VFont_RasterAll(48)

        // Black text
        black = Multiply(255, 16777216)
        VFont_DrawString(canvas, "Hello World!", 12, 20, 10, black)

        // Red text
        red = Add(Multiply(255, 65536), Multiply(255, 16777216))
        VFont_DrawString(canvas, "AILang Vector Fonts", 19, 20, 80, red)

        // Blue text
        blue = Add(255, Multiply(255, 16777216))
        VFont_DrawString(canvas, "The quick brown fox", 19, 20, 150, blue)

        // Dark purple
        purple = Add(155, Add(Multiply(57, 256), Add(Multiply(93, 65536), Multiply(255, 16777216))))
        VFont_DrawString(canvas, "jumps over the lazy dog", 23, 20, 220, purple)

        // Small size — flush and re-render at 24px
        VFont_FlushCache()
        VFont_RasterAll(24)

        green = Add(Multiply(255, 256), Multiply(255, 16777216))
        VFont_DrawString(canvas, "Small text at 24px -- ABCDEFGHIJKLMNOPQRSTUVWXYZ", 48, 20, 300, green)

        // Dump
        Test_DumpSurface(canvas, canvas_w, canvas_h, "out_text.rgba")
        PrintMessage("ffmpeg -vcodec rawvideo -f rawvideo -pix_fmt rgba -s 800x400 -i out_text.rgba -update 1 -y out_text.png\n")
    }

    VFont_Shutdown()
    VIF_Shutdown()
    PrintMessage("=== done ===\n")
}

RunTask(Main)