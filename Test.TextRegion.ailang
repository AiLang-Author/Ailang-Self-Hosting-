// Test.TextRegion.ailang
// Test TextRegion — word wrap, alignment, multi-line, backgrounds.
// Renders to RGBA file for visual inspection.
// Copyright © 2026 Sean Collins, 2 Paws Machine and Engineering. SCSL.

LibraryImport.DSurfaceTypes
LibraryImport.DSurface
LibraryImport.DDrawPixel
LibraryImport.Arena
LibraryImport.VIF
LibraryImport.SurfaceBlit
LibraryImport.Fonts
LibraryImport.TextRegion

Function.Test_DumpSurface {
    Input:  surf:     Integer
    Input:  w:        Integer
    Input:  h:        Integer
    Input:  filename: Integer
    Output: Integer
    Body: {
        fd = SystemCall(2, filename, 577, 420)
        IfCondition LessThan(fd, 0) ThenBlock: {
            PrintMessage("[dump] cannot create file\n")
            ReturnValue(0)
        }
        src_data  = Surface_GetData(surf)
        src_pitch = Surface_GetPitch(surf)
        row_bytes = Multiply(w, 4)
        row_buf   = Allocate(row_bytes)
        row = 0
        WhileLoop LessThan(row, h) {
            src_row = Multiply(row, src_pitch)
            src_row = Add(src_data, src_row)
            col = 0
            WhileLoop LessThan(col, w) {
                src_off = Multiply(col, 4)
                dst_off = Multiply(col, 4)
                b = GetByte(src_row, src_off)
                t = Add(src_off, 1)
                g = GetByte(src_row, t)
                t = Add(src_off, 2)
                r = GetByte(src_row, t)
                t = Add(src_off, 3)
                a = GetByte(src_row, t)
                SetByte(row_buf, dst_off, r)
                t = Add(dst_off, 1)
                SetByte(row_buf, t, g)
                t = Add(dst_off, 2)
                SetByte(row_buf, t, b)
                t = Add(dst_off, 3)
                SetByte(row_buf, t, a)
                col = Add(col, 1)
            }
            SystemCall(1, fd, row_buf, row_bytes)
            row = Add(row, 1)
        }
        Deallocate(row_buf, row_bytes)
        SystemCall(3, fd, 0, 0)
        PrintMessage("[dump] wrote ")
        PrintMessage(filename)
        PrintMessage("\n")
        ReturnValue(1)
    }
}

SubRoutine.Main {
    PrintMessage("=== TextRegion Test ===\n")

    Arena_Init()
    VIF_Init()
    VFont_Init()
    TextRegion_Init()

    // Load font
    ok = VFont_LoadVIF("fonts/DejaVuSans.vif")
    IfCondition EqualTo(ok, 0) ThenBlock: {
        PrintMessage("[FAIL] cannot load font\n")
    }
    IfCondition EqualTo(ok, 1) ThenBlock: {
        VFont_RasterAll(24)

        // Create canvas — dark blue background
        canvas_w = 800
        canvas_h = 600
        canvas = Surface_Create(SurfaceFormat.PIXEL_32, canvas_w, canvas_h)
        bg = TVG_PackColor(26, 58, 92, 255)
        Draw_Pix_FillRect(canvas, 0, 0, canvas_w, canvas_h, bg)

        // =========================================================
        // TEST 1: Simple left-aligned text, no wrap
        // =========================================================
        PrintMessage("[Test 1] Left-aligned, no wrap\n")
        r1 = TextRegion_Create(canvas, 20, 20, 760, 40)
        TextRegion_SetColor(r1, TVG_PackColor(255, 255, 255, 255))
        TextRegion_SetWrap(r1, 0)
        TextRegion_SetAlign(r1, TRAlign.LEFT)
        TextRegion_Render(r1, "Test 1: Left-aligned, no wrap", 29)

        // =========================================================
        // TEST 2: Center-aligned text
        // =========================================================
        PrintMessage("[Test 2] Center-aligned\n")
        r2 = TextRegion_Create(canvas, 20, 70, 760, 40)
        TextRegion_SetColor(r2, TVG_PackColor(255, 200, 100, 255))
        TextRegion_SetWrap(r2, 0)
        TextRegion_SetAlign(r2, TRAlign.CENTER)
        TextRegion_Render(r2, "Test 2: Center-aligned text", 27)

        // =========================================================
        // TEST 3: Right-aligned text
        // =========================================================
        PrintMessage("[Test 3] Right-aligned\n")
        r3 = TextRegion_Create(canvas, 20, 120, 760, 40)
        TextRegion_SetColor(r3, TVG_PackColor(100, 200, 255, 255))
        TextRegion_SetWrap(r3, 0)
        TextRegion_SetAlign(r3, TRAlign.RIGHT)
        TextRegion_Render(r3, "Test 3: Right-aligned text", 26)

        // =========================================================
        // TEST 4: Word wrap in a narrow box
        // =========================================================
        PrintMessage("[Test 4] Word wrap, narrow box\n")
        // Draw box outline so we can see the bounds
        Draw_Pix_FillRect(canvas, 19, 179, 362, 142, TVG_PackColor(80, 80, 80, 255))
        Draw_Pix_FillRect(canvas, 20, 180, 360, 140, TVG_PackColor(40, 40, 60, 255))

        r4 = TextRegion_Create(canvas, 20, 180, 360, 140)
        TextRegion_SetColor(r4, TVG_PackColor(200, 255, 200, 255))
        TextRegion_SetWrap(r4, 1)
        TextRegion_SetAlign(r4, TRAlign.LEFT)
        TextRegion_Render(r4, "Test 4: This text should word wrap because the region is only 360 pixels wide. Let us see if it wraps at word boundaries correctly.", 126)

        // =========================================================
        // TEST 5: Word wrap, center-aligned
        // =========================================================
        PrintMessage("[Test 5] Word wrap, center-aligned\n")
        Draw_Pix_FillRect(canvas, 419, 179, 362, 142, TVG_PackColor(80, 80, 80, 255))
        Draw_Pix_FillRect(canvas, 420, 180, 360, 140, TVG_PackColor(40, 40, 60, 255))

        r5 = TextRegion_Create(canvas, 420, 180, 360, 140)
        TextRegion_SetColor(r5, TVG_PackColor(255, 200, 255, 255))
        TextRegion_SetWrap(r5, 1)
        TextRegion_SetAlign(r5, TRAlign.CENTER)
        TextRegion_Render(r5, "Test 5: Centered word wrap in a constrained box. Each line should be centered within the region.", 95)

        // =========================================================
        // TEST 6: Multi-line with newlines
        // =========================================================
        PrintMessage("[Test 6] Explicit newlines\n")
        r6 = TextRegion_Create(canvas, 20, 340, 360, 120)
        TextRegion_SetColor(r6, TVG_PackColor(255, 150, 150, 255))
        TextRegion_SetWrap(r6, 0)
        TextRegion_SetAlign(r6, TRAlign.LEFT)
        // Build string with newlines (char 10)
        nl_buf = Allocate(64)
        // "Line one\nLine two\nLine three"
        SetByte(nl_buf, 0, 76)   // L
        SetByte(nl_buf, 1, 105)  // i
        SetByte(nl_buf, 2, 110)  // n
        SetByte(nl_buf, 3, 101)  // e
        SetByte(nl_buf, 4, 32)   // space
        SetByte(nl_buf, 5, 111)  // o
        SetByte(nl_buf, 6, 110)  // n
        SetByte(nl_buf, 7, 101)  // e
        SetByte(nl_buf, 8, 10)   // \n
        SetByte(nl_buf, 9, 76)   // L
        SetByte(nl_buf, 10, 105) // i
        SetByte(nl_buf, 11, 110) // n
        SetByte(nl_buf, 12, 101) // e
        SetByte(nl_buf, 13, 32)  // space
        SetByte(nl_buf, 14, 116) // t
        SetByte(nl_buf, 15, 119) // w
        SetByte(nl_buf, 16, 111) // o
        SetByte(nl_buf, 17, 10)  // \n
        SetByte(nl_buf, 18, 76)  // L
        SetByte(nl_buf, 19, 105) // i
        SetByte(nl_buf, 20, 110) // n
        SetByte(nl_buf, 21, 101) // e
        SetByte(nl_buf, 22, 32)  // space
        SetByte(nl_buf, 23, 116) // t
        SetByte(nl_buf, 24, 104) // h
        SetByte(nl_buf, 25, 114) // r
        SetByte(nl_buf, 26, 101) // e
        SetByte(nl_buf, 27, 101) // e
        TextRegion_Render(r6, nl_buf, 28)
        Deallocate(nl_buf, 64)

        // =========================================================
        // TEST 7: Background fill with text
        // =========================================================
        PrintMessage("[Test 7] Background fill\n")
        r7 = TextRegion_Create(canvas, 420, 340, 360, 60)
        TextRegion_SetColor(r7, TVG_PackColor(0, 0, 0, 255))
        TextRegion_SetBackground(r7, TVG_PackColor(255, 220, 100, 255))
        TextRegion_SetWrap(r7, 0)
        TextRegion_SetAlign(r7, TRAlign.CENTER)
        TextRegion_Render(r7, "Black on yellow background", 26)

        // =========================================================
        // TEST 8: MeasureWidth / MeasureHeight
        // =========================================================
        PrintMessage("[Test 8] Measure functions\n")
        mw = TextRegion_MeasureWidth("Hello World!", 12)
        PrintMessage("  MeasureWidth('Hello World!') = ")
        PrintNumber(mw)
        PrintMessage("px\n")

        // MeasureHeight needs a region for wrap width
        r8 = TextRegion_Create(canvas, 0, 0, 200, 999)
        TextRegion_SetWrap(r8, 1)
        mh = TextRegion_MeasureHeight(r8, "This is a long string that should wrap in a 200px wide region and produce multiple lines of text.", 96)
        PrintMessage("  MeasureHeight(200px wide) = ")
        PrintNumber(mh)
        PrintMessage("px\n")

        // =========================================================
        // TEST 9: Line spacing 150%
        // =========================================================
        PrintMessage("[Test 9] Line spacing 150%%\n")
        Draw_Pix_FillRect(canvas, 419, 419, 362, 162, TVG_PackColor(80, 80, 80, 255))
        Draw_Pix_FillRect(canvas, 420, 420, 360, 160, TVG_PackColor(40, 40, 60, 255))

        r9 = TextRegion_Create(canvas, 420, 420, 360, 160)
        TextRegion_SetColor(r9, TVG_PackColor(180, 220, 255, 255))
        TextRegion_SetWrap(r9, 1)
        TextRegion_SetLineSpacing(r9, 150)
        TextRegion_SetAlign(r9, TRAlign.LEFT)
        TextRegion_Render(r9, "Test 9: 150%% line spacing. This text should have extra space between lines when it wraps.", 89)

        // =========================================================
        // TEST 10: Overflow clipping — text exceeds region height
        // =========================================================
        PrintMessage("[Test 10] Overflow clip\n")
        Draw_Pix_FillRect(canvas, 19, 459, 362, 82, TVG_PackColor(80, 80, 80, 255))
        Draw_Pix_FillRect(canvas, 20, 460, 360, 80, TVG_PackColor(60, 30, 30, 255))

        r10 = TextRegion_Create(canvas, 20, 460, 360, 80)
        TextRegion_SetColor(r10, TVG_PackColor(255, 255, 200, 255))
        TextRegion_SetWrap(r10, 1)
        TextRegion_SetAlign(r10, TRAlign.LEFT)
        TextRegion_Render(r10, "Test 10: This region is only 80px tall. Text should clip when it exceeds the bottom boundary. This line should be cut off if the text is long enough.", 149)

        // Dump result
        Test_DumpSurface(canvas, canvas_w, canvas_h, "out_textregion.rgba")
        PrintMessage("\nConvert with:\n")
        PrintMessage("ffmpeg -vcodec rawvideo -f rawvideo -pix_fmt rgba -s 800x600 -i out_textregion.rgba -update 1 -y out_textregion.png\n")
    }

    TextRegion_Shutdown()
    VFont_Shutdown()
    VIF_Shutdown()
    PrintMessage("=== done ===\n")
}

RunTask(Main)