// Test.VIFParse.ailang
// Standalone test — parse a .tvg file, rasterize, dump raw RGBA.
// Copyright © 2026 Sean Collins, 2 Paws Machine and Engineering. SCSL.

LibraryImport.DSurfaceTypes
LibraryImport.DSurface
LibraryImport.DDrawPixel
LibraryImport.Arena
LibraryImport.VIF

Function.Test_DumpSurface {
    Input:  surf:     Integer
    Input:  size:     Integer
    Input:  filename: Integer
    Output: Integer
    Body: {
        fd = SystemCall(2, filename, 577, 420)
        IfCondition LessThan(fd, 0) ThenBlock: {
            PrintMessage("[dump] cannot create file\n")
            ReturnValue(0)
        }
        src_data  = Surface_GetData(surf)
        src_pitch = Surface_GetPitch(surf)
        row_buf   = Allocate(Multiply(size, 4))
        row = 0
        WhileLoop LessThan(row, size) {
            src_row = Add(src_data, Multiply(row, src_pitch))
            col = 0
            WhileLoop LessThan(col, size) {
                src_off = Multiply(col, 4)
                dst_off = Multiply(col, 4)
                b = GetByte(src_row, Add(src_off, 0))
                g = GetByte(src_row, Add(src_off, 1))
                r = GetByte(src_row, Add(src_off, 2))
                a = GetByte(src_row, Add(src_off, 3))
                SetByte(row_buf, Add(dst_off, 0), r)
                SetByte(row_buf, Add(dst_off, 1), g)
                SetByte(row_buf, Add(dst_off, 2), b)
                SetByte(row_buf, Add(dst_off, 3), a)
                col = Add(col, 1)
            }
            SystemCall(1, fd, row_buf, Multiply(size, 4))
            row = Add(row, 1)
        }
        Deallocate(row_buf, Multiply(size, 4))
        SystemCall(3, fd, 0, 0)
        PrintMessage("[dump] wrote ")
        PrintMessage(filename)
        PrintMessage("\n")
        ReturnValue(1)
    }
}

SubRoutine.Main {
    PrintMessage("=== TinyVG Parser Test ===\n")

    VIF_Init()

    fd = SystemCall(2, "test.tvg", 0, 0)
    IfCondition LessThan(fd, 0) ThenBlock: {
        PrintMessage("[FAIL] cannot open test.tvg\n")
    }
    IfCondition GreaterEqual(fd, 0) ThenBlock: {
        PrintMessage("[file] opened\n")

        size = SystemCall(8, fd, 0, 2)
        SystemCall(8, fd, 0, 0)
        PrintMessage("[file] size=")
        PrintNumber(size)
        PrintMessage("\n")

        data = Allocate(size)
        SystemCall(0, fd, data, size)
        SystemCall(3, fd, 0, 0)

        PrintMessage("[hex] ")
        bi = 0
        WhileLoop LessThan(bi, 60) {
            PrintNumber(GetByte(data, bi))
            PrintMessage(" ")
            bi = Add(bi, 1)
        }
        PrintMessage("\n")

        surf128 = TVG_Parse(data, size, 128)
        PrintMessage("[rast] 128px surf=")
        PrintNumber(surf128)
        PrintMessage("\n")

        IfCondition GreaterThan(surf128, 0) ThenBlock: {
            Test_DumpSurface(surf128, 128, "out_128.rgba")
            PrintMessage("ffmpeg -vcodec rawvideo -f rawvideo -pix_fmt rgba -s 128x128 -i out_128.rgba -update 1 out_128.png\n")
        }

        // Re-parse at other sizes
        surf64 = TVG_Parse(data, size, 64)
        IfCondition GreaterThan(surf64, 0) ThenBlock: {
            Test_DumpSurface(surf64, 64, "out_64.rgba")
            PrintMessage("ffmpeg -vcodec rawvideo -f rawvideo -pix_fmt rgba -s 64x64 -i out_64.rgba -update 1 out_64.png\n")
        }

        surf32 = TVG_Parse(data, size, 32)
        IfCondition GreaterThan(surf32, 0) ThenBlock: {
            Test_DumpSurface(surf32, 32, "out_32.rgba")
            PrintMessage("ffmpeg -vcodec rawvideo -f rawvideo -pix_fmt rgba -s 32x32 -i out_32.rgba -update 1 out_32.png\n")
        }

        Deallocate(data, size)
        VIF_Shutdown()
    }

    PrintMessage("=== done ===\n")
}

RunTask(Main)