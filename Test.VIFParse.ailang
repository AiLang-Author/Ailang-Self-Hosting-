// Test.VIFParse.ailang
// Standalone test — parse a .tvg file, rasterize, dump raw RGBA.
// Copyright © 2026 Sean Collins, 2 Paws Machine and Engineering. SCSL.

LibraryImport.DSurfaceTypes
LibraryImport.DSurface
LibraryImport.DDrawPixel
LibraryImport.Arena
LibraryImport.VIF

Function.Test_DumpSurface {
    Input:  surf:     Integer
    Input:  w:        Integer
    Input:  h:        Integer
    Input:  filename: Integer
    Output: Integer
    Body: {
        fd = SystemCall(2, filename, 577, 420)
        IfCondition LessThan(fd, 0) ThenBlock: {
            PrintMessage("[dump] cannot create file\n")
            ReturnValue(0)
        }
        src_data  = Surface_GetData(surf)
        src_pitch = Surface_GetPitch(surf)
        row_bytes = Multiply(w, 4)
        row_buf   = Allocate(row_bytes)
        row = 0
        WhileLoop LessThan(row, h) {
            src_row = Multiply(row, src_pitch)
            src_row = Add(src_data, src_row)
            col = 0
            WhileLoop LessThan(col, w) {
                src_off = Multiply(col, 4)
                dst_off = Multiply(col, 4)
                b = GetByte(src_row, src_off)
                t = Add(src_off, 1)
                g = GetByte(src_row, t)
                t = Add(src_off, 2)
                r = GetByte(src_row, t)
                t = Add(src_off, 3)
                a = GetByte(src_row, t)
                SetByte(row_buf, dst_off, r)
                t = Add(dst_off, 1)
                SetByte(row_buf, t, g)
                t = Add(dst_off, 2)
                SetByte(row_buf, t, b)
                t = Add(dst_off, 3)
                SetByte(row_buf, t, a)
                col = Add(col, 1)
            }
            SystemCall(1, fd, row_buf, row_bytes)
            row = Add(row, 1)
        }
        Deallocate(row_buf, row_bytes)
        SystemCall(3, fd, 0, 0)
        PrintMessage("[dump] wrote ")
        PrintMessage(filename)
        PrintMessage("\n")
        ReturnValue(1)
    }
}

SubRoutine.Main {
    PrintMessage("=== TinyVG Parser Test ===\n")

    VIF_Init()

    fd = SystemCall(2, "test.tvg", 0, 0)
    IfCondition LessThan(fd, 0) ThenBlock: {
        PrintMessage("[FAIL] cannot open test.tvg\n")
    }
    IfCondition GreaterEqual(fd, 0) ThenBlock: {
        PrintMessage("[file] opened\n")

        size = SystemCall(8, fd, 0, 2)
        SystemCall(8, fd, 0, 0)
        PrintMessage("[file] size=")
        PrintNumber(size)
        PrintMessage("\n")

        data = Allocate(size)
        SystemCall(0, fd, data, size)
        SystemCall(3, fd, 0, 0)

        // Render at 512px
        surf512 = TVG_Parse(data, size, 512)
        PrintMessage("[rast] 512px surf=")
        PrintNumber(surf512)
        PrintMessage("\n")
        IfCondition GreaterThan(surf512, 0) ThenBlock: {
            Test_DumpSurface(surf512, 512, 512, "out_512.rgba")
            PrintMessage("ffmpeg -vcodec rawvideo -f rawvideo -pix_fmt rgba -s 512x512 -i out_512.rgba -update 1 out_512.png\n")
        }

        // Render at 256px
        surf256 = TVG_Parse(data, size, 256)
        IfCondition GreaterThan(surf256, 0) ThenBlock: {
            Test_DumpSurface(surf256, 256, 256, "out_256.rgba")
            PrintMessage("ffmpeg -vcodec rawvideo -f rawvideo -pix_fmt rgba -s 256x256 -i out_256.rgba -update 1 out_256.png\n")
        }

        // Render at 128px
        surf128 = TVG_Parse(data, size, 128)
        IfCondition GreaterThan(surf128, 0) ThenBlock: {
            Test_DumpSurface(surf128, 128, 128, "out_128.rgba")
            PrintMessage("ffmpeg -vcodec rawvideo -f rawvideo -pix_fmt rgba -s 128x128 -i out_128.rgba -update 1 out_128.png\n")
        }

        Deallocate(data, size)
        VIF_Shutdown()
    }

    PrintMessage("=== done ===\n")
}

RunTask(Main)