// Test262Harness.ailang — A test harness for the Ailang JS Engine.
//
// This program reads a Test262 JavaScript test file, parses its
// "frontmatter" (the YAML metadata block), and prepares it for execution.
//
// Copyright (c) 2026 Sean Collins, 2 Paws Machine and Engineering. SCSL.

LibraryImport.Arena
LibraryImport.StringUtils

FixedPool.HarnessSys {
    "SYS_READ":      Initialize=0
    "SYS_WRITE":     Initialize=1
    "SYS_OPEN":      Initialize=2
    "SYS_CLOSE":     Initialize=3
}

FixedPool.TestInfo {
    "includes":     Initialize=0, CanChange=True // For now, a single string pointer
    "is_negative":  Initialize=0, CanChange=True
    "neg_phase":    Initialize=0, CanChange=True
    "neg_type":     Initialize=0, CanChange=True
    "is_async":     Initialize=0, CanChange=True
    "test_code":    Initialize=0, CanChange=True // Pointer to the JS code part of the file
}

// Read a whole file into a freshly allocated buffer. Returns ptr or 0,
// writes byte length into *out_len_ptr.
Function.Harness_ReadAll {
    Input: path: Address
    Input: out_len_ptr: Address
    Output: Address
    Body: {
        save_path = path
        save_out_len_ptr = out_len_ptr

        StoreValue(save_out_len_ptr, 0)
        fd = SystemCall(HarnessSys.SYS_OPEN, save_path, 0, 0, 0, 0)
        IfCondition LessThan(fd, 0) ThenBlock: {
            PrintMessage("Error: Could not open file: ")
            PrintMessage(save_path)
            PrintMessage("\n")
            ReturnValue(0)
        }
        // Allocate a reasonably large buffer for test files
        cap = 65536
        buf = Allocate(Add(cap, 1))
        used = 0
        WhileLoop LessThan(used, cap) {
            n = SystemCall(HarnessSys.SYS_READ, fd, Add(buf, used), Subtract(cap, used), 0, 0)
            IfCondition LessEqual(n, 0) ThenBlock: { BreakLoop }
            used = Add(used, n)
        }
        SystemCall(HarnessSys.SYS_CLOSE, fd, 0, 0, 0, 0)
        SetByte(buf, used, 0) // Null-terminate for safe string operations
        StoreValue(save_out_len_ptr, used)
        ReturnValue(buf)
    }
}

// Extracts the YAML frontmatter block from a Test262 file.
// Returns a new, null-terminated string with the frontmatter content.
Function.Harness_ExtractFrontmatter {
    Input: content: Address
    Input: content_len: Integer
    Output: Address
    Body: {
        save_content = content
        save_content_len = content_len

        start_delim = "/*---"
        end_delim = "---*/"

        // Find the start of the frontmatter
        start_offset = StringIndexOf(save_content, start_delim, 0)
        IfCondition LessThan(start_offset, 0) ThenBlock: {
            ReturnValue(0) // No frontmatter found
        }

        // Find the end of the frontmatter, starting the search after the start delimiter
        search_from = Add(start_offset, 5) // 5 is length of "/*---"
        end_offset = StringIndexOf(save_content, end_delim, search_from)
        IfCondition LessThan(end_offset, 0) ThenBlock: {
            ReturnValue(0) // Malformed, no end delimiter
        }

        // Store a pointer to the start of the actual test code
        TestInfo.test_code = Add(save_content, Add(end_offset, 5))

        // Calculate the length of the frontmatter content
        fm_start = Add(save_content, search_from)
        fm_len = Subtract(end_offset, search_from)

        IfCondition LessEqual(fm_len, 0) ThenBlock: {
            ReturnValue(0) // Empty frontmatter
        }

        // Allocate a new buffer and copy the frontmatter into it
        fm_buf = Allocate(Add(fm_len, 1))
        MemoryCopy(fm_buf, fm_start, fm_len)
        SetByte(fm_buf, fm_len, 0) // Null-terminate

        ReturnValue(fm_buf)
    }
}

// A simple parser for the Test262 YAML frontmatter. It populates the
// TestInfo pool with the findings. This is not a general YAML parser.
Function.Harness_ParseYAML {
    Input: fm_str: Address
    Body: {
        save_fm = fm_str

        // --- Find 'includes' ---
        // includes: [assert.js, sta.js]
        key_offset = StringIndexOf(save_fm, "includes:", 0)
        IfCondition GreaterEqual(key_offset, 0) ThenBlock: {
            start_bracket = StringIndexOf(save_fm, "[", key_offset)
            IfCondition GreaterEqual(start_bracket, 0) ThenBlock: {
                end_bracket = StringIndexOf(save_fm, "]", start_bracket)
                IfCondition GreaterEqual(end_bracket, 0) ThenBlock: {
                    start_bracket = Add(start_bracket, 1) // Move past '['
                    val_len = Subtract(end_bracket, start_bracket)
                    IfCondition GreaterThan(val_len, 0) ThenBlock: {
                        // For now, just grab the first file. A full parser would split on ','.
                        comma = StringIndexOf(save_fm, ",", start_bracket)
                        IfCondition And(GreaterEqual(comma, 0), LessThan(comma, end_bracket)) ThenBlock: {
                            val_len = Subtract(comma, start_bracket)
                        }
                        val_ptr = Add(save_fm, start_bracket)
                        // Trim whitespace (simple version)
                        WhileLoop And(GreaterThan(val_len, 0), EqualTo(GetByte(val_ptr, 0), 32)) {
                            val_ptr = Add(val_ptr, 1)
                            val_len = Subtract(val_len, 1)
                        }
                        // Trim trailing space and \r
                        WhileLoop GreaterThan(val_len, 0) {
                            last_char = GetByte(val_ptr, Subtract(val_len, 1))
                            IfCondition Or(EqualTo(last_char, 32), EqualTo(last_char, 13)) ThenBlock: {
                                val_len = Subtract(val_len, 1)
                            } ElseBlock: { BreakLoop }
                        }
                        IfCondition GreaterThan(val_len, 0) ThenBlock: {
                            TestInfo.includes = Allocate(Add(val_len, 1))
                            MemoryCopy(TestInfo.includes, val_ptr, val_len)
                            SetByte(TestInfo.includes, val_len, 0)
                        }
                    }
                }
            }
        }

        // --- Find 'negative' block ---
        key_offset = StringIndexOf(save_fm, "negative:", 0)
        IfCondition GreaterEqual(key_offset, 0) ThenBlock: {
            TestInfo.is_negative = 1
            // Find 'phase'
            phase_offset = StringIndexOf(save_fm, "phase:", key_offset)
            IfCondition GreaterEqual(phase_offset, 0) ThenBlock: {
                eol = StringIndexOf(save_fm, "\n", phase_offset)
                IfCondition LessThan(eol, 0) ThenBlock: { eol = StringLength(save_fm) }
                val_start = Add(phase_offset, 6) // Move past "phase:"
                val_len = Subtract(eol, val_start)
                IfCondition GreaterThan(val_len, 0) ThenBlock: {
                    // Trim leading space
                    WhileLoop And(GreaterThan(val_len, 0), EqualTo(GetByte(val_start, 0), 32)) {
                        val_start = Add(val_start, 1)
                        val_len = Subtract(val_len, 1)
                    }
                    // Trim trailing space and \r
                    WhileLoop GreaterThan(val_len, 0) {
                        last_char = GetByte(val_start, Subtract(val_len, 1))
                        IfCondition Or(EqualTo(last_char, 32), EqualTo(last_char, 13)) ThenBlock: {
                            val_len = Subtract(val_len, 1)
                        } ElseBlock: { BreakLoop }
                    }
                    IfCondition GreaterThan(val_len, 0) ThenBlock: {
                        TestInfo.neg_phase = Allocate(Add(val_len, 1))
                        MemoryCopy(TestInfo.neg_phase, val_start, val_len)
                        SetByte(TestInfo.neg_phase, val_len, 0)
                    }
                }
            }
            // Find 'type'
            type_offset = StringIndexOf(save_fm, "type:", key_offset)
            IfCondition GreaterEqual(type_offset, 0) ThenBlock: {
                eol = StringIndexOf(save_fm, "\n", type_offset)
                IfCondition LessThan(eol, 0) ThenBlock: { eol = StringLength(save_fm) }
                val_start = Add(type_offset, 5) // Move past "type:"
                val_len = Subtract(eol, val_start)
                IfCondition GreaterThan(val_len, 0) ThenBlock: {
                    // Trim leading space
                    WhileLoop And(GreaterThan(val_len, 0), EqualTo(GetByte(val_start, 0), 32)) {
                        val_start = Add(val_start, 1)
                        val_len = Subtract(val_len, 1)
                    }
                    // Trim trailing space and \r
                    WhileLoop GreaterThan(val_len, 0) {
                        last_char = GetByte(val_start, Subtract(val_len, 1))
                        IfCondition Or(EqualTo(last_char, 32), EqualTo(last_char, 13)) ThenBlock: {
                            val_len = Subtract(val_len, 1)
                        } ElseBlock: { BreakLoop }
                    }
                    IfCondition GreaterThan(val_len, 0) ThenBlock: {
                        TestInfo.neg_type = Allocate(Add(val_len, 1))
                        MemoryCopy(TestInfo.neg_type, val_start, val_len)
                        SetByte(TestInfo.neg_type, val_len, 0)
                    }
                }
            }
        }

        // --- Find 'flags' for async ---
        key_offset = StringIndexOf(save_fm, "flags:", 0)
        IfCondition GreaterEqual(key_offset, 0) ThenBlock: {
            async_offset = StringIndexOf(save_fm, "async", key_offset)
            IfCondition GreaterEqual(async_offset, 0) ThenBlock: {
                TestInfo.is_async = 1
            }
        }
    }
}

// Prepend required harness files (like assert.js) to the test code.
Function.Harness_PrepareCode {
    Output: Address
    Body: {
        harness_dir = "/mnt/c/Users/Sean/Documents/test262/harness/"
        final_code = Allocate(1)
        SetByte(final_code, 0, 0)
        
        IfCondition NotEqual(TestInfo.includes, 0) ThenBlock: {
            inc_path = StringConcat(harness_dir, TestInfo.includes)
            len_holder = Allocate(8)
            inc_content = Harness_ReadAll(inc_path, len_holder)
            IfCondition NotEqual(inc_content, 0) ThenBlock: {
                tmp = StringConcat(final_code, inc_content)
                Deallocate(final_code, Add(StringLength(final_code), 1))
                final_code = StringConcat(tmp, "\n")
                Deallocate(tmp, Add(StringLength(tmp), 1))
                Deallocate(inc_content, 65536)
            } ElseBlock: {
                PrintMessage("Warning: Could not load include: ")
                PrintMessage(inc_path)
                PrintMessage("\n")
            }
            Deallocate(inc_path, Add(StringLength(inc_path), 1))
            Deallocate(len_holder, 8)
        }

        IfCondition NotEqual(TestInfo.test_code, 0) ThenBlock: {
            tmp = StringConcat(final_code, TestInfo.test_code)
            Deallocate(final_code, Add(StringLength(final_code), 1))
            final_code = tmp
        }
        
        ReturnValue(final_code)
    }
}

