}

// Parses /proc/self/cmdline to safely extract argv[1]
Function.Harness_GetArg1 {
    Output: Address
    Body: {
        fd = SystemCall(HarnessSys.SYS_OPEN, "/proc/self/cmdline", 0, 0, 0, 0)
        IfCondition LessThan(fd, 0) ThenBlock: { ReturnValue(0) }
        buf = Allocate(4096)
        n = SystemCall(HarnessSys.SYS_READ, fd, buf, 4096, 0, 0)
        SystemCall(HarnessSys.SYS_CLOSE, fd, 0, 0, 0, 0)
        IfCondition LessEqual(n, 0) ThenBlock: {
            Deallocate(buf, 4096)
            ReturnValue(0)
        }
        
        // Skip argv[0] (the program name)
        i = 0
        WhileLoop LessThan(i, n) {
            IfCondition EqualTo(GetByte(buf, i), 0) ThenBlock: { BreakLoop }
            i = Add(i, 1)
        }
        i = Add(i, 1) // Move past \0
        
        IfCondition GreaterEqual(i, n) ThenBlock: {
            Deallocate(buf, 4096)
            ReturnValue(0) // No argv[1] found
        }
        
        arg_start = Add(buf, i)
        arg_len = 0
        WhileLoop LessThan(Add(i, arg_len), n) {
            IfCondition EqualTo(GetByte(buf, Add(i, arg_len)), 0) ThenBlock: { BreakLoop }
            arg_len = Add(arg_len, 1)
        }
        IfCondition EqualTo(arg_len, 0) ThenBlock: {
            Deallocate(buf, 4096)
            ReturnValue(0)
        }
        
        out = Allocate(Add(arg_len, 1))
        MemoryCopy(out, arg_start, arg_len)
        SetByte(out, arg_len, 0)
        Deallocate(buf, 4096)
        ReturnValue(out)
    }
}

SubRoutine.Main { 
        test_path = Harness_GetArg1()
        IfCondition EqualTo(test_path, 0) ThenBlock: {
            PrintMessage("Usage: ./Test262.x <path_to_test_file.js>\n")
            ReturnValue(1)
        }

        PrintMessage("Running Test262 Harness on: ")
        PrintMessage(test_path)
        PrintMessage("\n")

        len_holder = Allocate(8)
        file_content = Harness_ReadAll(test_path, len_holder)
        IfCondition EqualTo(file_content, 0) ThenBlock: { ReturnValue(1) }
        file_len = Dereference(len_holder)

        frontmatter = Harness_ExtractFrontmatter(file_content, file_len)
        IfCondition NotEqual(frontmatter, 0) ThenBlock: {
            Harness_ParseYAML(frontmatter)

            PrintMessage("\n--- Parsed Test Info ---\n")
            PrintMessage("Includes: ")
            IfCondition NotEqual(TestInfo.includes, 0) ThenBlock: { PrintMessage(TestInfo.includes) } ElseBlock: { PrintMessage("None") }
            PrintMessage("\n")
            
            PrintMessage("Is Negative: ") PrintNumber(TestInfo.is_negative) PrintMessage("\n")
            
            PrintMessage("  Phase: ")
            IfCondition NotEqual(TestInfo.neg_phase, 0) ThenBlock: { PrintMessage(TestInfo.neg_phase) } ElseBlock: { PrintMessage("None") }
            PrintMessage("\n")
            
            PrintMessage("  Type: ")
            IfCondition NotEqual(TestInfo.neg_type, 0) ThenBlock: { PrintMessage(TestInfo.neg_type) } ElseBlock: { PrintMessage("None") }
            PrintMessage("\n")
            
            PrintMessage("Is Async: ") PrintNumber(TestInfo.is_async) PrintMessage("\n")
            PrintMessage("------------------------\n")

            Deallocate(frontmatter, Add(StringLength(frontmatter), 1))
            
            prepared_code = Harness_PrepareCode()
            PrintMessage("\n--- Prepared JS Code Length ---\n")
            PrintNumber(StringLength(prepared_code))
            PrintMessage(" bytes ready for VM execution\n")
            PrintMessage("-------------------------------\n")
            
            // Hand the payload over to the VM!
            Harness_ExecuteTest(prepared_code)
            
            Deallocate(prepared_code, Add(StringLength(prepared_code), 1))
        } ElseBlock: {
            PrintMessage("No frontmatter found.\n")
        }

        Deallocate(len_holder, 8)
        Deallocate(file_content, 65536)
        Deallocate(test_path, Add(StringLength(test_path), 1))
    }



RunTask(Main)
