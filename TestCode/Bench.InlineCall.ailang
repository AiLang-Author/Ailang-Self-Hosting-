// Bench.InlineCall.ailang
// Benchmark: regular Function call overhead — compare with Bench.InlineInline.ailang
// Run: time ./Bench.InlineCall.x vs time ./Bench.InlineInline.x

Function.Add2 {
    Input: a: Integer
    Input: b: Integer
    Output: Integer
    Body: {
        ReturnValue(Add(a, b))
    }
}

SubRoutine.Main {
    rounds = 2000000
    acc = 0
    i = 0
    WhileLoop LessThan(i, rounds) {
        acc = Add2(acc, i)
        i = Add(i, 1)
    }
    PrintMessage("call checksum=")
    PrintNumber(acc)
    PrintMessage("\n")
}

RunTask(Main)
