// Bench.Hash.ailang
// Benchmark: THash (DJB2, Modulo, 24-byte slots)
// Run with: time ./Bench.Hash.x
// Compare against: time ./Bench.PERF_Hash.x

LibraryImport.Arena
LibraryImport.Hash

SubRoutine.Main {
    Arena_Init()

    ROUNDS = 10000
    t = Hash.Create(32)

    // --- SET phase ---
    i = 0
    WhileLoop LessThan(i, ROUNDS) {
        Hash.Set(t, "alpha",                       1)
        Hash.Set(t, "beta",                        2)
        Hash.Set(t, "gamma",                       3)
        Hash.Set(t, "delta",                       4)
        Hash.Set(t, "epsilon",                     5)
        Hash.Set(t, "zeta",                        6)
        Hash.Set(t, "eta",                         7)
        Hash.Set(t, "theta",                       8)
        Hash.Set(t, "the_quick_brown_fox",         9)
        Hash.Set(t, "jumps_over_the_lazy_dog",    10)
        i = Add(i, 1)
    }

    // --- GET phase ---
    i = 0
    sum = 0
    WhileLoop LessThan(i, ROUNDS) {
        sum = Add(sum, Hash.Get(t, "alpha"))
        sum = Add(sum, Hash.Get(t, "beta"))
        sum = Add(sum, Hash.Get(t, "gamma"))
        sum = Add(sum, Hash.Get(t, "delta"))
        sum = Add(sum, Hash.Get(t, "epsilon"))
        sum = Add(sum, Hash.Get(t, "zeta"))
        sum = Add(sum, Hash.Get(t, "eta"))
        sum = Add(sum, Hash.Get(t, "theta"))
        sum = Add(sum, Hash.Get(t, "the_quick_brown_fox"))
        sum = Add(sum, Hash.Get(t, "jumps_over_the_lazy_dog"))
        i = Add(i, 1)
    }

    Hash.Destroy(t)

    // Checksum so the optimizer can't eliminate the work
    PrintMessage("THash checksum=")
    PrintNumber(sum)
    PrintMessage("\n")
}

RunTask(Main)
