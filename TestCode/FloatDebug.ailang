// FloatDebug.ailang
// Isolate the loop accumulation issue

LibraryImport.Arena

SubRoutine.Main {
    PrintMessage("Float Loop Debug\n\n")

    // Test A: Simple reassignment (no loop)
    PrintMessage("=== A: Reassignment without loop ===\n")
    sum = Float_FromInt(0)
    increment = Float_Div(Float_FromInt(1), Float_FromInt(10))
    sum = Float_Add(sum, increment)
    sum = Float_Add(sum, increment)
    sum = Float_Add(sum, increment)
    result = Float_ToInt(sum)
    PrintMessage("0 + 0.1 + 0.1 + 0.1 = ")
    PrintNumber(result)
    PrintMessage("  (should be 0, truncated from 0.3)\n")

    // Test B: Check increment value
    PrintMessage("\n=== B: Check increment ===\n")
    inc = Float_Div(Float_FromInt(1), Float_FromInt(10))
    inc_big = Float_Mul(inc, Float_FromInt(1000))
    PrintMessage("0.1 * 1000 = ")
    PrintNumber(Float_ToInt(inc_big))
    PrintMessage("  (should be 100)\n")

    // Test C: Manual unrolled loop
    PrintMessage("\n=== C: Manual unroll x10 ===\n")
    s = Float_FromInt(0)
    inc2 = Float_Div(Float_FromInt(1), Float_FromInt(10))
    s = Float_Add(s, inc2)
    s = Float_Add(s, inc2)
    s = Float_Add(s, inc2)
    s = Float_Add(s, inc2)
    s = Float_Add(s, inc2)
    s = Float_Add(s, inc2)
    s = Float_Add(s, inc2)
    s = Float_Add(s, inc2)
    s = Float_Add(s, inc2)
    s = Float_Add(s, inc2)
    PrintMessage("0.1 x 10 (unrolled) = ")
    PrintNumber(Float_ToInt(s))
    PrintMessage("  (should be 1)\n")

    // Test D: Loop with integer (sanity check)
    PrintMessage("\n=== D: Integer loop ===\n")
    isum = 0
    j = 0
    WhileLoop LessThan(j, 10) {
        isum = Add(isum, 5)
        j = Add(j, 1)
    }
    PrintMessage("5 x 10 (loop) = ")
    PrintNumber(isum)
    PrintMessage("  (should be 50)\n")

    // Test E: Float loop - print each iteration
    PrintMessage("\n=== E: Float loop with debug ===\n")
    fsum = Float_FromInt(0)
    finc = Float_Div(Float_FromInt(1), Float_FromInt(10))
    k = 0
    WhileLoop LessThan(k, 5) {
        PrintMessage("  iter ")
        PrintNumber(k)
        PrintMessage(": before=")
        PrintNumber(Float_ToInt(Float_Mul(fsum, Float_FromInt(1000))))
        fsum = Float_Add(fsum, finc)
        PrintMessage(" after=")
        PrintNumber(Float_ToInt(Float_Mul(fsum, Float_FromInt(1000))))
        PrintMessage("\n")
        k = Add(k, 1)
    }
    PrintMessage("Final: ")
    PrintNumber(Float_ToInt(fsum))
    PrintMessage("  (should be 0, truncated from 0.5)\n")

    // Test F: Use different variable for result
    PrintMessage("\n=== F: Loop with temp var ===\n")
    acc = Float_FromInt(0)
    step = Float_Div(Float_FromInt(1), Float_FromInt(10))
    m = 0
    WhileLoop LessThan(m, 10) {
        temp = Float_Add(acc, step)
        acc = temp
        m = Add(m, 1)
    }
    PrintMessage("Using temp var = ")
    PrintNumber(Float_ToInt(acc))
    PrintMessage("  (should be 1)\n")

    PrintMessage("\nDone.\n")
}

RunTask(Main)
