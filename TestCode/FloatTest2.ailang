// FloatTest2.ailang
// Test floating point with correct nested pattern

LibraryImport.Arena

SubRoutine.Main {
    PrintMessage("AILang Float Precision Test v2\n\n")

    // Test 1: Direct division with integers (works in showcase)
    PrintMessage("=== Test 1: Direct Float ops ===\n")
    div_result = Float_Div(100, 3)
    back_to_int = Float_ToInt(div_result)
    PrintMessage("Float_Div(100, 3) as int = ")
    PrintNumber(back_to_int)
    PrintMessage("  (should be 33)\n")

    // Test 2: Nested expression - (1/3) * 3
    PrintMessage("\n=== Test 2: Nested (1/3)*3 ===\n")
    result = Float_Mul(Float_Div(1, 3), 3)
    result_int = Float_ToInt(result)
    PrintMessage("Float_Mul(Float_Div(1, 3), 3) = ")
    PrintNumber(result_int)
    PrintMessage("  (should be ~1)\n")

    // Test 3: Chained operations - (6 * 2) / 100 * 1000
    PrintMessage("\n=== Test 3: Chained gradient ops ===\n")
    grad_result = Float_Mul(Float_Div(Float_Mul(6, 2), 100), 1000)
    grad_int = Float_ToInt(grad_result)
    PrintMessage("((6 * 2) / 100) * 1000 = ")
    PrintNumber(grad_int)
    PrintMessage("  (should be 120)\n")

    // Test 4: Pythagorean theorem (from showcase)
    PrintMessage("\n=== Test 4: Pythagorean ===\n")
    hyp = Float_Sqrt(Float_Add(Float_Mul(3, 3), Float_Mul(4, 4)))
    hyp_int = Float_ToInt(hyp)
    PrintMessage("sqrt(3^2 + 4^2) = ")
    PrintNumber(hyp_int)
    PrintMessage("  (should be 5)\n")

    // Test 5: SGD-like update - w = w - lr * g
    // w=5, lr=0.1 (= 1/10), g=10
    // result should be 5 - (1/10)*10 = 5 - 1 = 4
    PrintMessage("\n=== Test 5: SGD update ===\n")
    w_new = Float_Sub(5, Float_Mul(Float_Div(1, 10), 10))
    w_int = Float_ToInt(w_new)
    PrintMessage("5 - (1/10) * 10 = ")
    PrintNumber(w_int)
    PrintMessage("  (should be 4)\n")

    // Test 6: Can we accumulate in a loop with proper pattern?
    PrintMessage("\n=== Test 6: Loop accumulation test ===\n")
    // Sum 1+2+3+4+5 = 15
    sum = Float_FromInt(0)
    // But we need to add integers, not chain floats...
    // Let's try: accumulate (i/10) for i=1..10, should be 5.5
    // Actually simpler: just sum integers via float
    total = Float_Add(Float_Add(Float_Add(Float_Add(1, 2), 3), 4), 5)
    total_int = Float_ToInt(total)
    PrintMessage("1+2+3+4+5 = ")
    PrintNumber(total_int)
    PrintMessage("  (should be 15)\n")

    // Test 7: Division precision
    PrintMessage("\n=== Test 7: Division precision ===\n")
    // 7/2 = 3.5, truncates to 3
    half = Float_Div(7, 2)
    half_int = Float_ToInt(half)
    PrintMessage("7/2 truncated = ")
    PrintNumber(half_int)
    PrintMessage("  (should be 3)\n")

    // Test 8: Can we store intermediate results?
    PrintMessage("\n=== Test 8: Intermediate storage ===\n")
    // a_sq = 3*3 = 9.0 stored
    a_sq = Float_Mul(3, 3)
    // b_sq = 4*4 = 16.0 stored
    b_sq = Float_Mul(4, 4)
    // Now use them - this is the critical test
    // Does Float_Add correctly handle float results as inputs?
    sum_sq = Float_Add(a_sq, b_sq)
    sum_sq_int = Float_ToInt(sum_sq)
    PrintMessage("3^2 + 4^2 (stored intermediates) = ")
    PrintNumber(sum_sq_int)
    PrintMessage("  (should be 25)\n")

    PrintMessage("\nDone.\n")
}

RunTask(Main)
