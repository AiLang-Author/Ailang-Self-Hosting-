// FloatTest4.ailang
// Test new float convention: Float_FromInt -> Float ops -> Float_ToInt

LibraryImport.Arena

SubRoutine.Main {
    PrintMessage("Float Convention Test (Float_FromInt required)\n\n")

    // Test 1: Basic division with proper conversions
    PrintMessage("=== Test 1: 100/3 ===\n")
    a = Float_FromInt(100)
    b = Float_FromInt(3)
    c = Float_Div(a, b)
    result = Float_ToInt(c)
    PrintMessage("100 / 3 = ")
    PrintNumber(result)
    PrintMessage("  (should be 33)\n")

    // Test 2: Chain operations - (1/3) * 3
    PrintMessage("\n=== Test 2: (1/3) * 3 ===\n")
    one = Float_FromInt(1)
    three = Float_FromInt(3)
    third = Float_Div(one, three)
    back = Float_Mul(third, three)
    result2 = Float_ToInt(back)
    PrintMessage("(1/3) * 3 = ")
    PrintNumber(result2)
    PrintMessage("  (should be ~1)\n")

    // Test 3: Gradient calculation - ((6 * 2) / 100) * 1000
    PrintMessage("\n=== Test 3: ((6*2)/100)*1000 ===\n")
    six = Float_FromInt(6)
    two = Float_FromInt(2)
    hundred = Float_FromInt(100)
    thousand = Float_FromInt(1000)
    prod = Float_Mul(six, two)
    ratio = Float_Div(prod, hundred)
    scaled = Float_Mul(ratio, thousand)
    result3 = Float_ToInt(scaled)
    PrintMessage("((6*2)/100)*1000 = ")
    PrintNumber(result3)
    PrintMessage("  (should be 120)\n")

    // Test 4: SGD update - 5 - (0.1 * 10) = 4
    PrintMessage("\n=== Test 4: SGD update ===\n")
    w = Float_FromInt(5)
    lr = Float_Div(Float_FromInt(1), Float_FromInt(10))  // 0.1
    g = Float_FromInt(10)
    delta = Float_Mul(lr, g)
    w_new = Float_Sub(w, delta)
    result4 = Float_ToInt(w_new)
    PrintMessage("5 - (0.1 * 10) = ")
    PrintNumber(result4)
    PrintMessage("  (should be 4)\n")

    // Test 5: Pythagorean - sqrt(3^2 + 4^2) = 5
    PrintMessage("\n=== Test 5: Pythagorean ===\n")
    fa = Float_FromInt(3)
    fb = Float_FromInt(4)
    a_sq = Float_Mul(fa, fa)
    b_sq = Float_Mul(fb, fb)
    sum_sq = Float_Add(a_sq, b_sq)
    hyp = Float_Sqrt(sum_sq)
    result5 = Float_ToInt(hyp)
    PrintMessage("sqrt(3^2 + 4^2) = ")
    PrintNumber(result5)
    PrintMessage("  (should be 5)\n")

    // Test 6: Accumulation - sum 0.1 ten times = 1.0
    PrintMessage("\n=== Test 6: Accumulate 0.1 x 10 ===\n")
    sum = Float_FromInt(0)
    increment = Float_Div(Float_FromInt(1), Float_FromInt(10))
    i = 0
    WhileLoop LessThan(i, 10) {
        sum = Float_Add(sum, increment)
        i = Add(i, 1)
    }
    result6 = Float_ToInt(sum)
    PrintMessage("0.1 * 10 accumulated = ")
    PrintNumber(result6)
    PrintMessage("  (should be 1)\n")

    // Test 7: Float comparison
    PrintMessage("\n=== Test 7: Float comparison ===\n")
    big = Float_FromInt(100)
    small = Float_FromInt(50)
    is_gt = Float_Gt(big, small)
    PrintMessage("100 > 50 = ")
    PrintNumber(is_gt)
    PrintMessage("  (should be 1)\n")

    PrintMessage("\nDone.\n")
}

RunTask(Main)
