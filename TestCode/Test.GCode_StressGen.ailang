// Test.GCode_StressGen.ailang
// Procedural Generation of Stress Test Data for G-Code Parser

LibraryImport.Arena

PrintMessage("==============================================\n")
PrintMessage("G-CODE STRESS DATA GENERATOR\n")
PrintMessage("==============================================\n\n")

FixedPool.GenConfig {
    "LINE_COUNT": Initialize=10000
    "FILENAME": Initialize=0
}

Function.File.WriteString {
    Input: fd: Integer
    Input: str: Address
    Body: {
        len = StringLength(str)
        SystemCall(1, fd, str, len)
    }
}

// Write integer as ASCII digits directly to file descriptor
Function.File.WriteInt {
    Input: fd: Integer
    Input: val: Integer
    Output: Integer
    Body: {
        buf = Allocate(24)
        end = 22
        pos = 22
        Fork EqualTo(val, 0) TrueBlock: {
            SetByte(buf, 22, 48)
            pos = 22
        } FalseBlock: {
            neg = 0
            Fork LessThan(val, 0) TrueBlock: {
                neg = 1
                val = Subtract(0, val)
            } FalseBlock: { }
            WhileLoop GreaterThan(val, 0) {
                digit = Modulo(val, 10)
                SetByte(buf, pos, Add(digit, 48))
                pos = Subtract(pos, 1)
                val = Divide(val, 10)
            }
            pos = Add(pos, 1)
            Fork EqualTo(neg, 1) TrueBlock: {
                pos = Subtract(pos, 1)
                SetByte(buf, pos, 45)
            } FalseBlock: { }
        }
        len = Add(Subtract(end, pos), 1)
        write_addr = Add(buf, pos)
        SystemCall(1, fd, write_addr, len)
        Deallocate(buf, 24)
        ReturnValue(1)
    }
}

Function.Generate.Run {
    Output: Integer
    Body: {
        filename = "/tmp/stress_test.ngc"

        PrintMessage("Generating ")
        PrintNumber(GenConfig.LINE_COUNT)
        PrintMessage(" lines to ")
        PrintMessage(filename)
        PrintMessage("...\n")

        fd = SystemCall(2, filename, 577, 420)

        Fork LessThan(fd, 0) TrueBlock: {
            PrintMessage("ERROR: Cannot create file.\n")
            ReturnValue(0)
        } FalseBlock: { }

        File.WriteString(fd, "%\n")
        File.WriteString(fd, "G21 G90 (Metric, Absolute)\n")
        File.WriteString(fd, "G64 P0.01 (Blending)\n")
        File.WriteString(fd, "F500 (Feedrate)\n")
        File.WriteString(fd, "S1000 M3 (Spindle CW)\n")

        x = 0
        y = 0
        z = 10
        step = 1
        limit = 100
        dir = 0
        run_length = 1
        segment_count = 0
        lines_written = 0

        File.WriteString(fd, "G0 Z10\n")
        File.WriteString(fd, "G0 X0 Y0\n")
        File.WriteString(fd, "G1 Z0\n")

        WhileLoop LessThan(lines_written, GenConfig.LINE_COUNT) {

            i = 0
            WhileLoop LessThan(i, 2) {
                j = 0
                WhileLoop LessThan(j, run_length) {

                    Fork EqualTo(dir, 0) TrueBlock: {
                        x = Add(x, step)
                    } FalseBlock: { }
                    Fork EqualTo(dir, 1) TrueBlock: {
                        y = Add(y, step)
                    } FalseBlock: { }
                    Fork EqualTo(dir, 2) TrueBlock: {
                        x = Subtract(x, step)
                    } FalseBlock: { }
                    Fork EqualTo(dir, 3) TrueBlock: {
                        y = Subtract(y, step)
                    } FalseBlock: { }

                    File.WriteString(fd, "G1 X")
                    File.WriteInt(fd, x)
                    File.WriteString(fd, " Y")
                    File.WriteInt(fd, y)
                    File.WriteString(fd, "\n")

                    lines_written = Add(lines_written, 1)

                    Fork GreaterEqual(lines_written, GenConfig.LINE_COUNT) TrueBlock: {
                        j = run_length
                        i = 2
                    } FalseBlock: { }

                    j = Add(j, 1)
                }

                dir = Modulo(Add(dir, 1), 4)
                i = Add(i, 1)
            }

            run_length = Add(run_length, 1)
        }

        File.WriteString(fd, "G0 Z10\n")
        File.WriteString(fd, "M5\n")
        File.WriteString(fd, "M2\n")
        File.WriteString(fd, "%\n")

        SystemCall(3, fd)

        PrintMessage("Generation Complete.\n")
        ReturnValue(1)
    }
}

Generate.Run()
