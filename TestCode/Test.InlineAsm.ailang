// Test.InlineAsm.ailang
// Smoke test for InlineAsm["hex bytes"] support.
//
// Each test sets up a known value in RAX via normal AILang,
// then runs an InlineAsm sequence that transforms it, then reads
// the result back and checks it matches expectation.
//
// x86-64 calling convention: AILang keeps the working value in RAX.
// We exploit that by putting a value in a variable (loads to RAX),
// running the asm, then storing RAX back to a variable.
//
// Encoding reference used:
//   90              NOP
//   48 ff c0        INC RAX
//   48 ff c8        DEC RAX
//   48 01 c0        ADD RAX, RAX   (double it)
//   48 c1 e0 03     SHL RAX, 3     (multiply by 8)
//   48 69 c0 21 00 00 00   IMUL RAX, RAX, 33  (djb2 multiply)

LibraryImport.Arena

// =============================================================================
// HELPERS
// =============================================================================

Function.Test_Pass {
    Input: name: Address
    Body: {
        PrintMessage("  [PASS] ")
        PrintMessage(name)
        PrintMessage("\n")
    }
}

Function.Test_Fail {
    Input: name: Address
    Input: got: Integer
    Input: expected: Integer
    Body: {
        PrintMessage("  [FAIL] ")
        PrintMessage(name)
        PrintMessage("  got=")
        PrintNumber(got)
        PrintMessage("  expected=")
        PrintNumber(expected)
        PrintMessage("\n")
    }
}

Function.Check {
    Input: name: Address
    Input: got: Integer
    Input: expected: Integer
    Body: {
        IfCondition EqualTo(got, expected) ThenBlock: {
            Test_Pass(name)
        } ElseBlock: {
            Test_Fail(name, got, expected)
        }
    }
}

// =============================================================================
// TEST CASES
// =============================================================================

// --- Test 1: NOP leaves value unchanged ---
// RAX = 42, NOP, expect 42
Function.Test_NOP {
    Output: Integer
    Body: {
        x = 42
        InlineAsm["90"]
        ReturnValue(x)
    }
}

// --- Test 2: INC RAX ---
// load 99 into RAX via asm mov, INC RAX -> expect 100
Function.Test_INC {
    Output: Integer
    Body: {
        // MOV RAX, 99 then INC RAX
        result = InlineAsm["48 c7 c0 63 00 00 00  48 ff c0"]
        ReturnValue(result)
    }
}

// --- Test 3: DEC RAX ---
// MOV RAX, 50 then DEC RAX -> expect 49
Function.Test_DEC {
    Output: Integer
    Body: {
        result = InlineAsm["48 c7 c0 32 00 00 00  48 ff c8"]
        ReturnValue(result)
    }
}

// --- Test 4: ADD RAX, RAX (double) ---
// MOV RAX, 7 then ADD RAX, RAX -> expect 14
Function.Test_DOUBLE {
    Output: Integer
    Body: {
        result = InlineAsm["48 c7 c0 07 00 00 00  48 01 c0"]
        ReturnValue(result)
    }
}

// --- Test 5: SHL RAX, 3 (multiply by 8) ---
// MOV RAX, 5 then SHL RAX, 3 -> expect 40
Function.Test_SHL3 {
    Output: Integer
    Body: {
        result = InlineAsm["48 c7 c0 05 00 00 00  48 c1 e0 03"]
        ReturnValue(result)
    }
}

// --- Test 6: IMUL RAX, RAX, 33 (djb2 hash multiplier) ---
// MOV RAX, 10 then IMUL RAX, RAX, 33 -> expect 330
Function.Test_IMUL33 {
    Output: Integer
    Body: {
        result = InlineAsm["48 c7 c0 0a 00 00 00  48 69 c0 21 00 00 00"]
        ReturnValue(result)
    }
}

// --- Test 7: chained NOPs (multi-byte sequence) ---
// 3x NOP, value unchanged
Function.Test_MultiNOP {
    Output: Integer
    Body: {
        x = 1234
        InlineAsm["90 90 90"]
        ReturnValue(x)
    }
}

// =============================================================================
// MAIN
// =============================================================================

SubRoutine.Main {
    Arena_Init()

    PrintMessage("=== InlineAsm smoke tests ===\n")

    Check("NOP no-op",          Test_NOP(),      42)
    Check("INC RAX",            Test_INC(),      100)
    Check("DEC RAX",            Test_DEC(),      49)
    Check("ADD RAX,RAX double", Test_DOUBLE(),   14)
    Check("SHL RAX,3 x8",       Test_SHL3(),     40)
    Check("IMUL RAX,RAX,33",    Test_IMUL33(),   330)
    Check("3x NOP no-op",       Test_MultiNOP(), 1234)

    PrintMessage("=== done ===\n")
}

RunTask(Main)