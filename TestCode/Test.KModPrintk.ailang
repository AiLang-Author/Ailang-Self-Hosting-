// Test.KModPrintk.ailang
// End-to-end test for kernel_module/PLAN.md Steps 3 + 4:
// declare an external kernel function and call it from ail_main.
//
// Build:
//   ./ailang_kmod2.x -kmod TestCode/Test.KModPrintk.ailang ail_payload_printk.o
//
// Verify:
//   readelf -h ail_payload_printk.o   →  Type: REL
//   readelf -s ail_payload_printk.o   →  ail_main GLOBAL FUNC (.text),
//                                        ail_printk GLOBAL FUNC UND
//   readelf -r ail_payload_printk.o   →  R_X86_64_PLT32 against ail_printk
//   objdump -d ail_payload_printk.o   →  call <ail_printk> reloc-annotated
//
//   echo 'int ail_printk(const char *s){(void)s;return 0;}' > /tmp/stub.c
//   gcc -c /tmp/stub.c -o /tmp/stub.o
//   ld -shared /tmp/stub.o ail_payload_printk.o -o /tmp/combined.so
//   objdump -d /tmp/combined.so | grep -A3 '<ail_main>:'
//                                       →  call <ail_printk@plt>

ExternalKernelFunction.ail_printk {
    Input: s: Address
    Output: Integer
}

Function.ail_main {
    Output: Integer
    Body: {
        ail_printk("hello from ailang kernel payload")
        ReturnValue(0)
    }
}

Function.ail_exit {
    Body: {
        ail_printk("goodbye from ailang")
    }
}
