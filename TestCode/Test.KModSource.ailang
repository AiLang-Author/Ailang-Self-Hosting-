// Test.KModSource.ailang
// Minimal -kmod source for end-to-end CLI verification.
//
// Build:
//   ./ailang_kmod.x -kmod TestCode/Test.KModSource.ailang ail_payload.o
//
// Verify:
//   readelf -h ail_payload.o   →  Type: REL,  Machine: X86-64
//   readelf -s ail_payload.o   →  ail_main GLOBAL FUNC (.text), ail_exit GLOBAL FUNC (.text)
//   objdump -d ail_payload.o   →  ail_main contains a `mov $42, %eax` (or similar) + ret
//
// Steps 3 + 4 of kernel_module/PLAN.md are not yet wired, so this source
// can NOT call any ail_printk-style extern. ail_main is restricted to
// pure computation; the return value reaches the kernel via the C shim.

Function.ail_main {
    Output: Integer
    Body: {
        // Returns 42 (well-known marker); ail_shim_init forwards this to
        // insmod so a non-zero would surface in dmesg as load failure.
        // Since we want the module to "load", return 0 in real use — 42
        // is just a distinctive value to spot in the disassembly.
        ReturnValue(42)
    }
}

Function.ail_exit {
    Body: {
        // No-op; shim's module_exit calls this then prints its own line.
    }
}
