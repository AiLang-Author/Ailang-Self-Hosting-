// Test.KernelModule.ailang
// Phase-2 verification of Library.CELFKernelModule (kernel_module/PLAN.md Step 2).
//
// Hand-crafts a payload object that exercises every new code path:
//   - GLOBAL DEFINED FUNC export (ail_main at .text+0)
//   - GLOBAL UND FUNC extern (ail_printk)
//   - One R_X86_64_PLT32 reloc against ail_printk
//
// .text bytes (8):
//   00: E8 00 00 00 00     call rel32 → ail_printk (placeholder; reloc patches the rel32)
//   05: 31 C0              xor eax, eax
//   07: C3                 ret
//
// Reloc record:
//   r_offset = 1                          (start of the rel32 displacement)
//   sym = ail_printk                      (extern_idx 0)
//   type = R_X86_64_PLT32 = 4
//   r_addend = -4                         (rel32 is measured from end of operand)
//
// VERIFICATION (run after this test produces ail_payload.o):
//   readelf -h ail_payload.o   →  Type: REL, Machine: Advanced Micro Devices X86-64
//   readelf -s ail_payload.o   →  ail_main GLOBAL FUNC (.text), ail_printk GLOBAL UND
//   readelf -r ail_payload.o   →  one R_X86_64_PLT32 at .text+1 → ail_printk - 4
//   objdump -d ail_payload.o   →  call instruction with reloc annotation
//
//   echo 'int ail_printk(const char *s){(void)s;return 0;}' > /tmp/stub.c
//   gcc -c /tmp/stub.c -o /tmp/stub.o
//   ld -r /tmp/stub.o ail_payload.o -o /tmp/combined.o
//   readelf -r /tmp/combined.o   →  no remaining unresolved relocs

LibraryImport.Compiler.Output.CELFTypes
LibraryImport.Compiler.Output.CELFBuilder
LibraryImport.Compiler.Output.CELFKernelModule
LibraryImport.Compiler.Output.COutput

FixedPool.TestKMod {
    "passes": Initialize=0, CanChange=True
    "fails":  Initialize=0, CanChange=True
}

Function.Expect {
    Input: cond: Integer
    Input: label: Address
    Body: {
        IfCondition NotEqual(cond, 0) ThenBlock: {
            TestKMod.passes = Add(TestKMod.passes, 1)
            PrintMessage("  [PASS] ")
            PrintMessage(label)
            PrintMessage("\n")
        } ElseBlock: {
            TestKMod.fails = Add(TestKMod.fails, 1)
            PrintMessage("  [FAIL] ")
            PrintMessage(label)
            PrintMessage("\n")
        }
    }
}

Function.DoTest {
    Output: Integer
    Body: {
        PrintMessage("==============================================\n")
        PrintMessage("  KERNEL MODULE EMITTER — Phase 2 verification\n")
        PrintMessage("==============================================\n")

        ELF_Init()
        KMod_Init()

        // ---- staged inputs ---------------------------------------------------
        xidx_printk = KMod_StageExtern("ail_printk")
        eidx_main   = KMod_StageExport("ail_main", 0)

        Expect(EqualTo(xidx_printk, 0), "extern ail_printk staged at idx 0")
        Expect(EqualTo(eidx_main,   0), "export ail_main staged at idx 0")
        Expect(EqualTo(KMod.in_extern_count, 1), "in_extern_count == 1")
        Expect(EqualTo(KMod.in_export_count, 1), "in_export_count == 1")

        // ---- hand-crafted .text ---------------------------------------------
        code_size = 8
        code = Allocate(code_size)
        SetByte(code, 0, 232)   // E8 — call rel32
        SetByte(code, 1, 0)
        SetByte(code, 2, 0)
        SetByte(code, 3, 0)
        SetByte(code, 4, 0)
        SetByte(code, 5, 49)    // 31 C0 — xor eax, eax
        SetByte(code, 6, 192)
        SetByte(code, 7, 195)   // C3 — ret

        // Reloc patches the rel32 starting at .text+1
        KMod_StageReloc(1, xidx_printk, RelocType.R_X86_64_PLT32, -4)
        Expect(EqualTo(KMod.in_reloc_count, 1), "one reloc staged")

        // ---- emit -----------------------------------------------------------
        result = ELF_BuildKernelModule(code, code_size, 0, 0)
        Expect(EqualTo(result, 1), "ELF_BuildKernelModule returned 1")

        // ---- post-emit symtab invariants ------------------------------------
        // Locals: [0] null + [1] .text section symbol  →  first_global must be 2.
        Expect(EqualTo(KMod.first_global, 2), "first_global == 2 (locals before globals)")

        // sym_count = 2 locals + 1 export + 1 extern = 4
        Expect(EqualTo(KMod.sym_count, 4), "sym_count == 4")

        // rela_count == staged reloc count
        Expect(EqualTo(KMod.rela_count, 1), "rela_count == 1")

        // ---- write file ------------------------------------------------------
        buf  = ELF_GetBuffer()
        size = ELF_GetSize()

        fd = FileOpen("ail_payload.o", FileFlags.WRITE_NEW, FileMode.RW)
        IfCondition LessThan(fd, 0) ThenBlock: {
            PrintMessage("  [FAIL] FileOpen ail_payload.o\n")
            TestKMod.fails = Add(TestKMod.fails, 1)
        } ElseBlock: {
            written = FileWrite(fd, buf, size)
            FileClose(fd)
            PrintMessage("  [INFO] wrote ail_payload.o (")
            PrintNumber(written)
            PrintMessage(" bytes)\n")
            Expect(EqualTo(written, size), "FileWrite wrote full buffer")
        }

        Deallocate(code, code_size)
        KMod_Free()
        ELF_Free()

        PrintMessage("\n----------------------------------------------\n")
        PrintMessage("  passes: ")
        PrintNumber(TestKMod.passes)
        PrintMessage("   fails: ")
        PrintNumber(TestKMod.fails)
        PrintMessage("\n----------------------------------------------\n")

        PrintMessage("\nNext: run\n")
        PrintMessage("  readelf -h ail_payload.o\n")
        PrintMessage("  readelf -s ail_payload.o\n")
        PrintMessage("  readelf -r ail_payload.o\n")
        PrintMessage("  objdump -d ail_payload.o\n")

        ReturnValue(TestKMod.fails)
    }
}

SubRoutine.Main {
    DoTest()
}

RunTask(Main)
