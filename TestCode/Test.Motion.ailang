// Test.Motion.ailang
// Test suite for the Motion library stack (GCode_Core, Queue, Motion, Interpreter)

LibraryImport.Motion.GCode_Interpreter

// Shared test state in a FixedPool so SubRoutine and Function can both access it
FixedPool.TestState {
    "total":   Initialize=0
    "passed":  Initialize=0
    "failed":  Initialize=0
    "name":    Initialize=0
    "expected": Initialize=0
    "actual":  Initialize=0
}

SubRoutine.TestResult {
    TestState.total = Add(TestState.total, 1)
    PrintMessage("TEST: ")
    PrintMessage(TestState.name)
    PrintMessage(" | E: ")
    PrintNumber(TestState.expected)
    PrintMessage(" | G: ")
    PrintNumber(TestState.actual)
    Fork EqualTo(TestState.expected, TestState.actual) TrueBlock: {
        PrintMessage(" | PASS\n")
        TestState.passed = Add(TestState.passed, 1)
    } FalseBlock: {
        PrintMessage(" | FAIL\n")
        TestState.failed = Add(TestState.failed, 1)
    }
}

Function.Test.RunAll {
    Body: {

        PrintMessage("==============================================\n")
        PrintMessage("MOTION LIBRARY TEST SUITE\n")
        PrintMessage("==============================================\n")

        // ==============================================
        // SECTION 1: MODAL STATE RESET
        // ==============================================
        PrintMessage("\n--- SECTION 1: Modal State Reset ---\n")

        result = Core.ResetModalState()

        TestState.name = "ResetModalState returns 1"
        TestState.expected = 1
        TestState.actual = result
        RunTask(TestResult)

        TestState.name = "motion_mode defaults to 0"
        TestState.expected = 0
        TestState.actual = ModalState.motion_mode
        RunTask(TestResult)

        TestState.name = "units defaults to 21 (mm)"
        TestState.expected = 21
        TestState.actual = ModalState.units
        RunTask(TestResult)

        TestState.name = "distance_mode defaults to 90"
        TestState.expected = 90
        TestState.actual = ModalState.distance_mode
        RunTask(TestResult)

        TestState.name = "plane defaults to 17 (XY)"
        TestState.expected = 17
        TestState.actual = ModalState.plane
        RunTask(TestResult)

        TestState.name = "current_x defaults to 0"
        TestState.expected = 0
        TestState.actual = ModalState.current_x
        RunTask(TestResult)

        TestState.name = "current_y defaults to 0"
        TestState.expected = 0
        TestState.actual = ModalState.current_y
        RunTask(TestResult)

        TestState.name = "current_z defaults to 0"
        TestState.expected = 0
        TestState.actual = ModalState.current_z
        RunTask(TestResult)

        // ==============================================
        // SECTION 2: ParseInteger
        // ==============================================
        PrintMessage("\n--- SECTION 2: ParseInteger ---\n")

        str_42 = "42"
        end_idx = Parser.ParseInteger(str_42, 0)

        TestState.name = "ParseInteger '42' gives 42"
        TestState.expected = 42
        TestState.actual = ParserResult.last_int_value
        RunTask(TestResult)

        TestState.name = "ParseInteger '42' returns end index 2"
        TestState.expected = 2
        TestState.actual = end_idx
        RunTask(TestResult)

        str_0 = "0"
        end_idx = Parser.ParseInteger(str_0, 0)
        TestState.name = "ParseInteger '0' gives 0"
        TestState.expected = 0
        TestState.actual = ParserResult.last_int_value
        RunTask(TestResult)

        str_100 = "100"
        end_idx = Parser.ParseInteger(str_100, 0)
        TestState.name = "ParseInteger '100' gives 100"
        TestState.expected = 100
        TestState.actual = ParserResult.last_int_value
        RunTask(TestResult)

        TestState.name = "ParseInteger '100' returns end index 3"
        TestState.expected = 3
        TestState.actual = end_idx
        RunTask(TestResult)

        str_g21 = "G21"
        end_idx = Parser.ParseInteger(str_g21, 1)
        TestState.name = "ParseInteger 'G21' idx 1 gives 21"
        TestState.expected = 21
        TestState.actual = ParserResult.last_int_value
        RunTask(TestResult)

        // ==============================================
        // SECTION 3: ParseFloat (fixed-point x10000)
        // ==============================================
        PrintMessage("\n--- SECTION 3: ParseFloat (scale=10000) ---\n")

        str_1p0 = "1.0"
        end_idx = Parser.ParseFloat(str_1p0, 0)
        TestState.name = "ParseFloat '1.0' gives 10000"
        TestState.expected = 10000
        TestState.actual = ParserResult.last_float_value
        RunTask(TestResult)

        str_2p5 = "2.5"
        end_idx = Parser.ParseFloat(str_2p5, 0)
        TestState.name = "ParseFloat '2.5' gives 25000"
        TestState.expected = 25000
        TestState.actual = ParserResult.last_float_value
        RunTask(TestResult)

        str_10p0 = "10.0"
        end_idx = Parser.ParseFloat(str_10p0, 0)
        TestState.name = "ParseFloat '10.0' gives 100000"
        TestState.expected = 100000
        TestState.actual = ParserResult.last_float_value
        RunTask(TestResult)

        str_neg = "-1.5"
        end_idx = Parser.ParseFloat(str_neg, 0)
        TestState.name = "ParseFloat '-1.5' gives -15000"
        TestState.expected = -15000
        TestState.actual = ParserResult.last_float_value
        RunTask(TestResult)

        str_0p0 = "0.0"
        end_idx = Parser.ParseFloat(str_0p0, 0)
        TestState.name = "ParseFloat '0.0' gives 0"
        TestState.expected = 0
        TestState.actual = ParserResult.last_float_value
        RunTask(TestResult)

        str_qtr = "0.25"
        end_idx = Parser.ParseFloat(str_qtr, 0)
        TestState.name = "ParseFloat '0.25' gives 2500"
        TestState.expected = 2500
        TestState.actual = ParserResult.last_float_value
        RunTask(TestResult)

        // ==============================================
        // SECTION 4: Motion Queue
        // ==============================================
        PrintMessage("\n--- SECTION 4: Motion Queue ---\n")

        result = MotionQueue.Initialize()
        TestState.name = "Queue Initialize returns 1"
        TestState.expected = 1
        TestState.actual = result
        RunTask(TestResult)

        TestState.name = "Queue count=0 after init"
        TestState.expected = 0
        TestState.actual = MotionQueue.count
        RunTask(TestResult)

        TestState.name = "Queue IsEmpty after init"
        TestState.expected = 1
        TestState.actual = MotionQueue.IsEmpty()
        RunTask(TestResult)

        TestState.name = "Queue IsFull after init = 0"
        TestState.expected = 0
        TestState.actual = MotionQueue.IsFull()
        RunTask(TestResult)

        result = MotionQueue.PushCommand(CommandTypes.CMD_STRAIGHT_TRAVERSE, 10000, 20000, 30000)
        TestState.name = "PushCommand returns 1"
        TestState.expected = 1
        TestState.actual = result
        RunTask(TestResult)

        TestState.name = "Queue count=1 after 1 push"
        TestState.expected = 1
        TestState.actual = MotionQueue.GetCount()
        RunTask(TestResult)

        TestState.name = "Queue not empty after push"
        TestState.expected = 0
        TestState.actual = MotionQueue.IsEmpty()
        RunTask(TestResult)

        result = MotionQueue.PushCommand(CommandTypes.CMD_STRAIGHT_FEED, 50000, 50000, 0)
        result = MotionQueue.PushCommand(CommandTypes.CMD_SPINDLE_CW, 0, 0, 0)
        TestState.name = "Queue count=3 after 3 pushes"
        TestState.expected = 3
        TestState.actual = MotionQueue.GetCount()
        RunTask(TestResult)

        cmd_addr = MotionQueue.PopCommand()
        TestState.name = "PopCommand returns non-zero addr"
        TestState.expected = 1
        Fork GreaterThan(cmd_addr, 0) TrueBlock: {
            TestState.actual = 1
        } FalseBlock: {
            TestState.actual = 0
        }
        RunTask(TestResult)

        TestState.name = "Queue count=2 after pop"
        TestState.expected = 2
        TestState.actual = MotionQueue.GetCount()
        RunTask(TestResult)

        result = MotionQueue.Clear()
        TestState.name = "Queue count=0 after clear"
        TestState.expected = 0
        TestState.actual = MotionQueue.count
        RunTask(TestResult)

        TestState.name = "Queue IsEmpty after clear"
        TestState.expected = 1
        TestState.actual = MotionQueue.IsEmpty()
        RunTask(TestResult)

        empty_pop = MotionQueue.PopCommand()
        TestState.name = "PopCommand on empty returns 0"
        TestState.expected = 0
        TestState.actual = empty_pop
        RunTask(TestResult)

        // ==============================================
        // SECTION 5: Motion G-Codes
        // ==============================================
        PrintMessage("\n--- SECTION 5: Motion G-Code Handlers ---\n")

        result = Core.ResetModalState()
        result = MotionQueue.Initialize()

        result = Motion.G17_PlaneXY()
        TestState.name = "G17 sets plane=17"
        TestState.expected = 17
        TestState.actual = ModalState.plane
        RunTask(TestResult)

        result = Motion.G18_PlaneXZ()
        TestState.name = "G18 sets plane=18"
        TestState.expected = 18
        TestState.actual = ModalState.plane
        RunTask(TestResult)

        result = Motion.G19_PlaneYZ()
        TestState.name = "G19 sets plane=19"
        TestState.expected = 19
        TestState.actual = ModalState.plane
        RunTask(TestResult)

        result = Motion.G20_Inches()
        TestState.name = "G20 sets units=20"
        TestState.expected = 20
        TestState.actual = ModalState.units
        RunTask(TestResult)

        result = Motion.G21_Millimeters()
        TestState.name = "G21 sets units=21"
        TestState.expected = 21
        TestState.actual = ModalState.units
        RunTask(TestResult)

        result = Motion.G90_Absolute()
        TestState.name = "G90 sets distance_mode=90"
        TestState.expected = 90
        TestState.actual = ModalState.distance_mode
        RunTask(TestResult)

        result = Motion.G91_Incremental()
        TestState.name = "G91 sets distance_mode=91"
        TestState.expected = 91
        TestState.actual = ModalState.distance_mode
        RunTask(TestResult)

        // G00 — coords in fixed-point (x10000)
        result = Core.ResetModalState()
        result = MotionQueue.Initialize()

        result = Motion.G00_RapidTraverse(10000, 20000, 30000)
        TestState.name = "G00 returns 1"
        TestState.expected = 1
        TestState.actual = result
        RunTask(TestResult)

        TestState.name = "G00 sets motion_mode=0"
        TestState.expected = 0
        TestState.actual = ModalState.motion_mode
        RunTask(TestResult)

        TestState.name = "G00 current_x=10000"
        TestState.expected = 10000
        TestState.actual = ModalState.current_x
        RunTask(TestResult)

        TestState.name = "G00 current_y=20000"
        TestState.expected = 20000
        TestState.actual = ModalState.current_y
        RunTask(TestResult)

        TestState.name = "G00 current_z=30000"
        TestState.expected = 30000
        TestState.actual = ModalState.current_z
        RunTask(TestResult)

        TestState.name = "G00 queued 1 command"
        TestState.expected = 1
        TestState.actual = MotionQueue.GetCount()
        RunTask(TestResult)

        result = Motion.G01_LinearFeed(50000, 60000, 10000)
        TestState.name = "G01 returns 1"
        TestState.expected = 1
        TestState.actual = result
        RunTask(TestResult)

        TestState.name = "G01 sets motion_mode=1"
        TestState.expected = 1
        TestState.actual = ModalState.motion_mode
        RunTask(TestResult)

        TestState.name = "G01 current_x=50000"
        TestState.expected = 50000
        TestState.actual = ModalState.current_x
        RunTask(TestResult)

        TestState.name = "G01 current_y=60000"
        TestState.expected = 60000
        TestState.actual = ModalState.current_y
        RunTask(TestResult)

        TestState.name = "G01 queue count=2"
        TestState.expected = 2
        TestState.actual = MotionQueue.GetCount()
        RunTask(TestResult)

        // ==============================================
        // SECTION 6: Interpreter ProcessLine
        // ==============================================
        PrintMessage("\n--- SECTION 6: Interpreter ProcessLine ---\n")

        result = Core.ResetModalState()
        result = MotionQueue.Initialize()

        line_g21 = "G21"
        result = Interpreter.ProcessLine(line_g21)
        TestState.name = "ProcessLine 'G21' returns 1"
        TestState.expected = 1
        TestState.actual = result
        RunTask(TestResult)

        TestState.name = "ProcessLine 'G21' sets units=21"
        TestState.expected = 21
        TestState.actual = ModalState.units
        RunTask(TestResult)

        line_g90 = "G90"
        result = Interpreter.ProcessLine(line_g90)
        TestState.name = "ProcessLine 'G90' sets distance_mode=90"
        TestState.expected = 90
        TestState.actual = ModalState.distance_mode
        RunTask(TestResult)

        line_g17 = "G17"
        result = Interpreter.ProcessLine(line_g17)
        TestState.name = "ProcessLine 'G17' sets plane=17"
        TestState.expected = 17
        TestState.actual = ModalState.plane
        RunTask(TestResult)

        line_g1 = "G1"
        result = Interpreter.ProcessLine(line_g1)
        TestState.name = "ProcessLine 'G1' sets motion_mode=1"
        TestState.expected = 1
        TestState.actual = ModalState.motion_mode
        RunTask(TestResult)

        TestState.name = "ProcessLine 'G1' alone queues nothing"
        TestState.expected = 0
        TestState.actual = MotionQueue.GetCount()
        RunTask(TestResult)

        // X1.0→10000, Y2.0→20000, Z3.0→30000 in fixed-point
        line_rapid = "G0 X1.0 Y2.0 Z3.0"
        result = Interpreter.ProcessLine(line_rapid)
        TestState.name = "ProcessLine 'G0 X1.0 Y2.0 Z3.0' returns 1"
        TestState.expected = 1
        TestState.actual = result
        RunTask(TestResult)

        TestState.name = "ProcessLine G0 sets motion_mode=0"
        TestState.expected = 0
        TestState.actual = ModalState.motion_mode
        RunTask(TestResult)

        TestState.name = "ProcessLine G0 X1.0: current_x=10000"
        TestState.expected = 10000
        TestState.actual = ModalState.current_x
        RunTask(TestResult)

        TestState.name = "ProcessLine G0 Y2.0: current_y=20000"
        TestState.expected = 20000
        TestState.actual = ModalState.current_y
        RunTask(TestResult)

        TestState.name = "ProcessLine G0 Z3.0: current_z=30000"
        TestState.expected = 30000
        TestState.actual = ModalState.current_z
        RunTask(TestResult)

        TestState.name = "ProcessLine G0 queued 1 command"
        TestState.expected = 1
        TestState.actual = MotionQueue.GetCount()
        RunTask(TestResult)

        line_feed = "G1 X5.0 Y5.0 Z-1.0"
        result = Interpreter.ProcessLine(line_feed)
        TestState.name = "ProcessLine 'G1 X5.0 Y5.0 Z-1.0' returns 1"
        TestState.expected = 1
        TestState.actual = result
        RunTask(TestResult)

        TestState.name = "ProcessLine G1 sets motion_mode=1"
        TestState.expected = 1
        TestState.actual = ModalState.motion_mode
        RunTask(TestResult)

        TestState.name = "ProcessLine G1 X5.0: current_x=50000"
        TestState.expected = 50000
        TestState.actual = ModalState.current_x
        RunTask(TestResult)

        TestState.name = "ProcessLine G1 Y5.0: current_y=50000"
        TestState.expected = 50000
        TestState.actual = ModalState.current_y
        RunTask(TestResult)

        TestState.name = "ProcessLine G1 queue count=2"
        TestState.expected = 2
        TestState.actual = MotionQueue.GetCount()
        RunTask(TestResult)

        // ==============================================
        // RESULTS
        // ==============================================
        PrintMessage("\n==============================================\n")
        PrintMessage("RESULTS: ")
        PrintNumber(TestState.passed)
        PrintMessage(" passed, ")
        PrintNumber(TestState.failed)
        PrintMessage(" failed out of ")
        PrintNumber(TestState.total)
        PrintMessage(" total\n")
        PrintMessage("==============================================\n")
    }
}

Test.RunAll()
