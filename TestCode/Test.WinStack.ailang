LibraryImport.Arena
LibraryImport.Display.Render.DSurfaceTypes
LibraryImport.Display.Render.DSurface
LibraryImport.Display.Render.DDrawPixel
LibraryImport.Display.Render.DRingTypes
LibraryImport.Display.Render.DRing1
LibraryImport.Display.Render.DRing0
LibraryImport.Display.Render.DComposeTypes
LibraryImport.Display.Render.DComposeFloat
LibraryImport.Display.Render.DCompose
LibraryImport.Display.Input.DInputTypes
LibraryImport.Display.Input.DInputEvdev
LibraryImport.Display.Input.DInputDiscover
LibraryImport.Display.Render.Framebuffer
LibraryImport.Display.Render.DRenderFB
LibraryImport.Font
LibraryImport.FontBitmap
LibraryImport.Display.UI.TextRegion
LibraryImport.TextBuffer
LibraryImport.Display.UI.PaneDecorator
LibraryImport.Display.Input.Cursor
LibraryImport.Display.Input.CursorBitmap
LibraryImport.Display.Window.WinManager

SubRoutine.Main {
    Arena_Init()
    WinMgr_Init()

    PrintMessage("[Test] Real geometry test — 1280x1024 screen, 620x500 window\n")

    bw = DecorConfig.border_w
    hh = DecorConfig.header_h
    screen_w = 1280
    screen_h = 1024
    canvas_w = 620
    canvas_h = 500

    PrintMessage("[Test] bw=")
    PrintNumber(bw)
    PrintMessage(" hh=")
    PrintNumber(hh)
    PrintMessage("\n")

    // OLD total_h formula (what Win_Create currently does)
    old_total_w = Add(canvas_w, Multiply(bw, 2))
    old_total_h = Add(Add(hh, canvas_h), Multiply(bw, 3))
    PrintMessage("[OLD] total=")
    PrintNumber(old_total_w)
    PrintMessage("x")
    PrintNumber(old_total_h)
    PrintMessage("\n")

    // OLD: what Win_SetGeom derives
    old_geom_cw = Subtract(old_total_w, Multiply(bw, 2))
    old_geom_ch = Subtract(old_total_h, Multiply(bw, 2))
    PrintMessage("[OLD] geom canvas=")
    PrintNumber(old_geom_cw)
    PrintMessage("x")
    PrintNumber(old_geom_ch)
    PrintMessage("\n")

    // OLD centering
    old_fx = Divide(Subtract(screen_w, old_total_w), 2)
    old_fy = Divide(Subtract(screen_h, old_total_h), 2)
    PrintMessage("[OLD] centered fx=")
    PrintNumber(old_fx)
    PrintMessage(" fy=")
    PrintNumber(old_fy)
    PrintMessage("\n")

    // OLD blit: content at y+bw, surface is old_geom_ch tall
    old_content_top = Add(old_fy, bw)
    old_content_bot = Add(old_content_top, old_geom_ch)
    PrintMessage("[OLD] content top=")
    PrintNumber(old_content_top)
    PrintMessage(" bot=")
    PrintNumber(old_content_bot)
    PrintMessage("\n")

    // CURRENT MISMATCH: content at y+bw+tbh, surface is still old_geom_ch tall
    stack_idx = Stack_Create(1)
    tbh = Win_GetTabBarH_FromStack(1)
    PrintMessage("[Test] tbh=")
    PrintNumber(tbh)
    PrintMessage("\n")

    mis_content_top = Add(Add(old_fy, bw), tbh)
    mis_content_bot = Add(mis_content_top, old_geom_ch)
    mis_window_bot = Add(old_fy, old_total_h)
    PrintMessage("[MISMATCH] content top=")
    PrintNumber(mis_content_top)
    PrintMessage(" bot=")
    PrintNumber(mis_content_bot)
    PrintMessage("\n")
    PrintMessage("[MISMATCH] window bottom edge=")
    PrintNumber(mis_window_bot)
    PrintMessage("\n")
    PrintMessage("[MISMATCH] content bleeds past window by=")
    PrintNumber(Subtract(mis_content_bot, mis_window_bot))
    PrintMessage("\n")

    // NEW formula: total_h = tbh + canvas_h + bw*2
    new_total_h = Add(Add(tbh, canvas_h), Multiply(bw, 2))
    new_total_w = Add(canvas_w, Multiply(bw, 2))
    PrintMessage("[NEW] total=")
    PrintNumber(new_total_w)
    PrintMessage("x")
    PrintNumber(new_total_h)
    PrintMessage("\n")

    new_fx = Divide(Subtract(screen_w, new_total_w), 2)
    new_fy = Divide(Subtract(screen_h, new_total_h), 2)
    PrintMessage("[NEW] centered fx=")
    PrintNumber(new_fx)
    PrintMessage(" fy=")
    PrintNumber(new_fy)
    PrintMessage("\n")

    // NEW: geom derives canvas_h = new_total_h - bw*2 = tbh + canvas_h
    new_geom_ch = Subtract(new_total_h, Multiply(bw, 2))
    PrintMessage("[NEW] geom_canvas_h=")
    PrintNumber(new_geom_ch)
    PrintMessage("\n")

    // NEW: body_h = geom_canvas_h - tbh = canvas_h (what caller passed)
    new_body_h = Subtract(new_geom_ch, tbh)
    PrintMessage("[NEW] body_h=")
    PrintNumber(new_body_h)
    PrintMessage(" (should equal canvas_h=")
    PrintNumber(canvas_h)
    PrintMessage(")\n")

    // NEW blit positions
    new_hdr_top = Add(new_fy, bw)
    new_hdr_bot = Add(new_hdr_top, tbh)
    new_content_top = Add(new_hdr_top, tbh)
    new_content_bot = Add(new_content_top, new_body_h)
    new_window_bot = Add(new_fy, new_total_h)
    PrintMessage("[NEW] hdr top=")
    PrintNumber(new_hdr_top)
    PrintMessage(" bot=")
    PrintNumber(new_hdr_bot)
    PrintMessage("\n")
    PrintMessage("[NEW] content top=")
    PrintNumber(new_content_top)
    PrintMessage(" bot=")
    PrintNumber(new_content_bot)
    PrintMessage("\n")
    PrintMessage("[NEW] window bot=")
    PrintNumber(new_window_bot)
    PrintMessage("\n")
    PrintMessage("[NEW] content fits exactly=")
    PrintNumber(Subtract(new_window_bot, new_content_bot))
    PrintMessage(" (should be bw=")
    PrintNumber(bw)
    PrintMessage(")\n")

    PrintMessage("[Test] DONE\n")
}

RunTask(Main)