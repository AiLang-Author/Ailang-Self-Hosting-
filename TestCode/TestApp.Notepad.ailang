// TestApp.Notepad.ailang
// First real application — document viewer with text rendering
// Tests the full pipeline: HTML parse → Auckland layout → PageSurface → Document → TextRegion
//
// This runs standalone (not inside SysDisplay). It creates its own window,
// draws a document page with text, and has toolbar buttons.
//
// Copyright © 2026 Sean Collins, 2 Paws Machine and Engineering. SCSL.

LibraryImport.Arena
LibraryImport.Display.Render.DSurfaceTypes
LibraryImport.Display.Render.DSurface
LibraryImport.Display.Render.DDrawPixel
LibraryImport.Display.Render.VIF
LibraryImport.Display.Render.SurfaceBlit
LibraryImport.Display.Render.Fonts
LibraryImport.Display.UI.TextRegion
LibraryImport.Arrays
LibraryImport.Display.Content.PageSurface
LibraryImport.Display.Content.Document

// =============================================================================
// APP STATE
// =============================================================================
FixedPool.NoteApp {
    "doc":          Initialize=-1, CanChange=True
    "canvas_surf":  Initialize=0, CanChange=True
    "canvas_w":     Initialize=600, CanChange=True
    "canvas_h":     Initialize=500, CanChange=True
    "line_count":   Initialize=0, CanChange=True
    "initialized":  Initialize=0, CanChange=True
}

// =============================================================================
// INIT — set up font pipeline, page surface, document
// =============================================================================
Function.NoteApp_Init {
    Output: Integer
    Body: {
        Arena_Init()
        VIF_Init()
        VFont_Init()
        TextRegion_Init()
        PageSurface_Init()
        Doc_Init()

        ok = VFont_LoadVIF("fonts/DejaVuSans.vif")
        IfCondition EqualTo(ok, 0) ThenBlock: {
            PrintMessage("[NoteApp] FATAL: cannot load font\n")
            ReturnValue(0)
        }
        VFont_RasterAll(16)

        NoteApp.initialized = 1
        PrintMessage("[NoteApp] init ok\n")
        ReturnValue(1)
    }
}

// =============================================================================
// CREATE DOCUMENT — Letter page, draw initial content
// =============================================================================
Function.NoteApp_CreateDoc {
    Output: Integer
    Body: {
        // Create a document with Letter pages at 96 DPI
        doc = Doc_Create(PaperType.LETTER, PageOrient.PORTRAIT, 96)
        IfCondition LessThan(doc, 0) ThenBlock: {
            PrintMessage("[NoteApp] doc create failed\n")
            ReturnValue(0)
        }
        NoteApp.doc = doc

        // Set half-inch margins (36 points)
        page0 = Doc_GetPage(doc, 0)
        PageSurface_SetMargins(page0, 36, 36, 36, 36)

        // Write some initial content
        black = TVG_PackColor(0, 0, 0, 255)
        dark_blue = TVG_PackColor(0, 0, 128, 255)
        gray = TVG_PackColor(80, 80, 80, 255)

        Doc_WriteText(doc, "AILANG Document System", 22, dark_blue)
        Doc_WriteText(doc, "", 0, black)
        Doc_WriteText(doc, "This is the first document rendered by the AILANG", 50, black)
        Doc_WriteText(doc, "display stack. It uses the full pipeline:", 41, black)
        Doc_WriteText(doc, "", 0, black)
        Doc_WriteText(doc, "  - HTML Parser lexes and parses markup", 39, gray)
        Doc_WriteText(doc, "  - Auckland Binder builds the AK node tree", 44, gray)
        Doc_WriteText(doc, "  - Auckland Solver computes layout rectangles", 46, gray)
        Doc_WriteText(doc, "  - PageSurface creates paper-sized canvases", 44, gray)
        Doc_WriteText(doc, "  - Document manages multi-page collections", 43, gray)
        Doc_WriteText(doc, "  - TextRegion renders vector text into regions", 48, gray)
        Doc_WriteText(doc, "  - VIF rasterizer converts TinyVG font glyphs", 47, gray)
        Doc_WriteText(doc, "  - SurfaceBlit composites onto the canvas", 42, gray)
        Doc_WriteText(doc, "", 0, black)
        Doc_WriteText(doc, "All vectors. All scalable. Print-ready from day one.", 52, dark_blue)

        NoteApp.line_count = 14

        PrintMessage("[NoteApp] document created with initial text\n")
        ReturnValue(1)
    }
}

// =============================================================================
// RENDER — blit document page onto a target surface
// Scales/clips the page to fit the target area
// =============================================================================
Function.NoteApp_RenderToSurface {
    Input: dst_surf: Integer
    Input: dst_w: Integer
    Input: dst_h: Integer
    Output: Integer
    Body: {
        IfCondition LessThan(NoteApp.doc, 0) ThenBlock: { ReturnValue(0) }

        page = Doc_GetPage(NoteApp.doc, 0)
        IfCondition LessThan(page, 0) ThenBlock: { ReturnValue(0) }

        src_surf = PageSurface_GetSurface(page)
        IfCondition EqualTo(src_surf, 0) ThenBlock: { ReturnValue(0) }

        src_w = PageSurface_GetWidth(page)
        src_h = PageSurface_GetHeight(page)

        // For now, blit top-left corner of the page into the destination
        // Clip to whichever is smaller
        blit_w = src_w
        IfCondition GreaterThan(blit_w, dst_w) ThenBlock: { blit_w = dst_w }
        blit_h = src_h
        IfCondition GreaterThan(blit_h, dst_h) ThenBlock: { blit_h = dst_h }

        // Row-by-row blit
        src_data = Surface_GetData(src_surf)
        src_pitch = Surface_GetPitch(src_surf)
        dst_data = Surface_GetData(dst_surf)
        dst_pitch = Surface_GetPitch(dst_surf)
        row_bytes = Multiply(blit_w, 4)

        by = 0
        WhileLoop LessThan(by, blit_h) {
            src_row = Add(src_data, Multiply(by, src_pitch))
            dst_row = Add(dst_data, Multiply(by, dst_pitch))
            bx = 0
            WhileLoop LessThan(bx, row_bytes) {
                SetByte(dst_row, bx, GetByte(src_row, bx))
                bx = Add(bx, 1)
            }
            by = Add(by, 1)
        }

        PrintMessage("[NoteApp] rendered page to surface ")
        PrintNumber(blit_w)
        PrintMessage("x")
        PrintNumber(blit_h)
        PrintMessage("\n")

        ReturnValue(1)
    }
}

// =============================================================================
// ADD LINE — append another line of text
// =============================================================================
Function.NoteApp_AddLine {
    Output: Integer
    Body: {
        IfCondition LessThan(NoteApp.doc, 0) ThenBlock: { ReturnValue(0) }

        NoteApp.line_count = Add(NoteApp.line_count, 1)
        line_num = NoteApp.line_count

        // Build a line like "Line 15: Added by button click"
        prefix = "Line "
        suffix = ": Added by button click"
        num_str = NumberToString(line_num)
        part1 = StringConcat(prefix, num_str)
        full_line = StringConcat(part1, suffix)
        full_len = StringLength(full_line)

        color = TVG_PackColor(0, 80, 0, 255)
        Doc_WriteText(NoteApp.doc, full_line, full_len, color)

        PrintMessage("[NoteApp] added line ")
        PrintNumber(line_num)
        PrintMessage("\n")

        ReturnValue(1)
    }
}

// =============================================================================
// STANDALONE TEST — no display server, just create doc and dump to file
// =============================================================================
Function.NoteApp_DumpPage {
    Input: filename: Address
    Output: Integer
    Body: {
        IfCondition LessThan(NoteApp.doc, 0) ThenBlock: { ReturnValue(0) }

        page = Doc_GetPage(NoteApp.doc, 0)
        IfCondition LessThan(page, 0) ThenBlock: { ReturnValue(0) }

        surf = PageSurface_GetSurface(page)
        pw = PageSurface_GetWidth(page)
        ph = PageSurface_GetHeight(page)

        // Write raw RGBA to file
        fd = SystemCall(2, filename, 577, 420)
        IfCondition LessThan(fd, 0) ThenBlock: {
            PrintMessage("[NoteApp] cannot open output file\n")
            ReturnValue(0)
        }

        data = Surface_GetData(surf)
        pitch = Surface_GetPitch(surf)

        row = 0
        WhileLoop LessThan(row, ph) {
            row_ptr = Add(data, Multiply(row, pitch))
            row_bytes = Multiply(pw, 4)
            SystemCall(1, fd, row_ptr, row_bytes)
            row = Add(row, 1)
        }

        SystemCall(3, fd)
        PrintMessage("[NoteApp] dumped page to ")
        PrintMessage(filename)
        PrintMessage(" (")
        PrintNumber(pw)
        PrintMessage("x")
        PrintNumber(ph)
        PrintMessage(")\n")

        PrintMessage("\nConvert with:\n")
        PrintMessage("ffmpeg -vcodec rawvideo -f rawvideo -pix_fmt bgra -s ")
        PrintNumber(pw)
        PrintMessage("x")
        PrintNumber(ph)
        PrintMessage(" -i ")
        PrintMessage(filename)
        PrintMessage(" -update 1 -y notepad_output.png\n")

        ReturnValue(1)
    }
}

// =============================================================================
// MAIN — run standalone test
// =============================================================================
SubRoutine.Main {
    PrintMessage("========================================\n")
    PrintMessage("  AILANG Notepad - Standalone Test\n")
    PrintMessage("========================================\n")

    init_ok = NoteApp_Init()
    IfCondition EqualTo(init_ok, 0) ThenBlock: {
        PrintMessage("Init failed!\n")
        ReturnValue(0)
    }

    NoteApp_CreateDoc()

    // Add a few more lines to test cursor advancement
    NoteApp_AddLine()
    NoteApp_AddLine()
    NoteApp_AddLine()

    // Dump the page to a file for visual verification
    NoteApp_DumpPage("/tmp/notepad.rgba")

    PrintMessage("\n========================================\n")
    PrintMessage("  Done! Check notepad_output.png\n")
    PrintMessage("========================================\n")
}

RunTask(Main)