// TestSmallNumbers.ailang
// Tests whether FixedPool Initialize= values 0-255 are stored raw or with bias.
// Also tests local variable and StoreValue behavior for small values.


LibraryImport.Arena

FixedPool.SmallConst {
    "ZERO":  Initialize=0
    "ONE":   Initialize=1
    "FOUR":  Initialize=4
    "EIGHT": Initialize=8
    "FF":    Initialize=255
}

FixedPool.SmallState {
    "a": Initialize=0
    "b": Initialize=0
    "c": Initialize=0
}

FixedPool.TestCount {
    "total":  Initialize=0
    "passed": Initialize=0
}

Function.Check {
    Input: expected: Integer
    Input: actual:   Integer
    Input: label:    Address
    Output: Integer
    Body: {
        TestCount.total = Add(TestCount.total, 1)
        IfCondition EqualTo(expected, actual) ThenBlock: {
            PrintMessage("PASS ")
            PrintMessage(label)
            PrintMessage("\n")
            TestCount.passed = Add(TestCount.passed, 1)
            ReturnValue(1)
        } ElseBlock: {
            PrintMessage("FAIL ")
            PrintMessage(label)
            PrintMessage(" expected=")
            PrintNumber(expected)
            PrintMessage(" actual=")
            PrintNumber(actual)
            PrintMessage("\n")
            ReturnValue(0)
        }
    }
}

Function.TestLocals {
    Output: Integer
    Body: {
        a = 0
        b = 1
        c = 4
        d = 8
        e = 255
        Check(0,   a, "local 0")
        Check(1,   b, "local 1")
        Check(4,   c, "local 4")
        Check(8,   d, "local 8")
        Check(255, e, "local 255")
        ReturnValue(1)
    }
}

Function.TestArith {
    Output: Integer
    Body: {
        pb         = SmallConst.FOUR
        pitch_640  = Multiply(640,  pb)
        pitch_1280 = Multiply(1280, pb)
        pitch_320  = Multiply(320,  pb)
        Check(2560, pitch_640,  "640*4=2560")
        Check(5120, pitch_1280, "1280*4=5120")
        Check(1280, pitch_320,  "320*4=1280")
        row_1   = Multiply(1,   pitch_1280)
        row_100 = Multiply(100, pitch_1280)
        Check(5120,   row_1,   "row1 offset")
        Check(512000, row_100, "row100 offset")
        ReturnValue(1)
    }
}

Function.TestStoreRaw {
    Output: Integer
    Body: {
        buf = Allocate(16)
        StoreValue(buf, 4)
        raw_read = Dereference(buf)
        StoreValue(Add(buf, 8), Add(4, 65536))
        biased_read = Subtract(Dereference(Add(buf, 8)), 65536)
        PrintMessage("StoreValue(4) raw=")
        PrintNumber(raw_read)
        PrintMessage(" biased-65536=")
        PrintNumber(biased_read)
        PrintMessage("\n")
        Check(4, raw_read,    "raw StoreValue(4)==4")
        Check(4, biased_read, "biased StoreValue(4+65536)-65536==4")
        Deallocate(buf, 16)
        ReturnValue(1)
    }
}

SubRoutine.Main {
    PrintMessage("--- FixedPool Initialize= reads ---\n")
    Check(0,   SmallConst.ZERO,  "ZERO=0")
    Check(1,   SmallConst.ONE,   "ONE=1")
    Check(4,   SmallConst.FOUR,  "FOUR=4")
    Check(8,   SmallConst.EIGHT, "EIGHT=8")
    Check(255, SmallConst.FF,    "FF=255")

    PrintMessage("--- FixedPool write/read small values ---\n")
    SmallState.a = 0
    SmallState.b = 4
    SmallState.c = 255
    Check(0,   SmallState.a, "store 0")
    Check(4,   SmallState.b, "store 4")
    Check(255, SmallState.c, "store 255")

    PrintMessage("--- Local variable small values ---\n")
    TestLocals()

    PrintMessage("--- Arithmetic with small FixedPool values ---\n")
    TestArith()

    PrintMessage("--- StoreValue raw vs biased ---\n")
    TestStoreRaw()

    PrintMessage("---\n")
    PrintMessage("Passed: ")
    PrintNumber(TestCount.passed)
    PrintMessage(" / ")
    PrintNumber(TestCount.total)
    PrintMessage("\n")
    IfCondition EqualTo(TestCount.passed, TestCount.total) ThenBlock: {
        PrintMessage("ALL PASS\n")
    } ElseBlock: {
        PrintMessage("FAILURES - bias workaround confirmed necessary\n")
    }
}

RunTask(Main)