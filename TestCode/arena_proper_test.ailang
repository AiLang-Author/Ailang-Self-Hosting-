// xarray_proper_test.ailang
// Properly structured XArray test suite
// - All state in FixedPools
// - All code in SubRoutines
// - Flow controlled execution

LibraryImport.Arrays
LibraryImport.Arena

FixedPool.T {
    "pass": Initialize=0
    "fail": Initialize=0
    "total": Initialize=0
    "arr": Initialize=0
    "val": Initialize=0
    "sz": Initialize=0
    "idx": Initialize=0
    "tmp": Initialize=0
    "tmp2": Initialize=0
    "copy": Initialize=0
    "stk": Initialize=0
    "queue": Initialize=0
    "hash": Initialize=0
    "shash": Initialize=0
    "list": Initialize=0
}

// =============================================================================
// TEST HELPERS
// =============================================================================
SubRoutine.Check_Equal {
    T.total = Add(T.total, 1)
    IfCondition EqualTo(T.val, T.tmp) ThenBlock: {
        T.pass = Add(T.pass, 1)
        PrintMessage("  [PASS]\n")
    } ElseBlock: {
        T.fail = Add(T.fail, 1)
        PrintMessage("  [FAIL] expected ")
        PrintNumber(T.tmp)
        PrintMessage(" got ")
        PrintNumber(T.val)
        PrintMessage("\n")
    }
}

SubRoutine.Check_NotZero {
    T.total = Add(T.total, 1)
    IfCondition NotEqual(T.val, 0) ThenBlock: {
        T.pass = Add(T.pass, 1)
        PrintMessage("  [PASS]\n")
    } ElseBlock: {
        T.fail = Add(T.fail, 1)
        PrintMessage("  [FAIL] got 0\n")
    }
}

// =============================================================================
// TEST 1: XArray Core
// =============================================================================
SubRoutine.Test1_Core {
    PrintMessage("\n=== TEST 1: XArray Core ===\n")
    
    // Create
    PrintMessage("XCreate(16) returns non-null")
    T.arr = Array.Create(16)
    T.val = T.arr
    RunTask(Check_NotZero)
    
    // Initial size
    PrintMessage("Initial size is 0")
    T.val = Array.Size(T.arr)
    T.tmp = 0
    RunTask(Check_Equal)
    
    // Capacity
    PrintMessage("Capacity is 16")
    T.val = Array.Capacity(T.arr)
    T.tmp = 16
    RunTask(Check_Equal)
    
    // Push 5 elements
    Array.Push(T.arr, 10)
    Array.Push(T.arr, 20)
    Array.Push(T.arr, 30)
    Array.Push(T.arr, 40)
    Array.Push(T.arr, 50)
    
    PrintMessage("After 5 pushes, size is 5")
    T.val = Array.Size(T.arr)
    T.tmp = 5
    RunTask(Check_Equal)
    
    // Get
    PrintMessage("XGet(0) returns 10")
    T.val = Array.Get(T.arr, 0)
    T.tmp = 10
    RunTask(Check_Equal)
    
    PrintMessage("XGet(2) returns 30")
    T.val = Array.Get(T.arr, 2)
    T.tmp = 30
    RunTask(Check_Equal)
    
    PrintMessage("XGet(4) returns 50")
    T.val = Array.Get(T.arr, 4)
    T.tmp = 50
    RunTask(Check_Equal)
    
    // Set
    Array.Set(T.arr, 2, 999)
    PrintMessage("After XSet(2, 999), XGet(2) is 999")
    T.val = Array.Get(T.arr, 2)
    T.tmp = 999
    RunTask(Check_Equal)
    
    // Pop
    PrintMessage("XPop returns 50")
    T.val = Array.Pop(T.arr)
    T.tmp = 50
    RunTask(Check_Equal)
    
    PrintMessage("Size is now 4")
    T.val = Array.Size(T.arr)
    T.tmp = 4
    RunTask(Check_Equal)
    
    // Clear
    Array.Clear(T.arr)
    PrintMessage("After XClear, size is 0")
    T.val = Array.Size(T.arr)
    T.tmp = 0
    RunTask(Check_Equal)
    
    // Bounds check
    PrintMessage("XGet(-1) returns XERROR")
    T.val = Array.Get(T.arr, -1)
    T.tmp = -999999
    RunTask(Check_Equal)
    
    Array.Destroy(T.arr)
    PrintMessage("  TEST 1 COMPLETE\n")
}

// =============================================================================
// TEST 2: XArray Extended
// =============================================================================
SubRoutine.Test2_Extended {
    PrintMessage("\n=== TEST 2: XArray Extended ===\n")
    
    T.arr = Array.Create(16)
    
    PrintMessage("New array IsEmpty returns 1")
    T.val = Array.IsEmpty(T.arr)
    T.tmp = 1
    RunTask(Check_Equal)
    
    Array.Push(T.arr, 100)
    Array.Push(T.arr, 200)
    Array.Push(T.arr, 300)
    Array.Push(T.arr, 400)
    Array.Push(T.arr, 500)
    
    PrintMessage("After pushes, IsEmpty returns 0")
    T.val = Array.IsEmpty(T.arr)
    T.tmp = 0
    RunTask(Check_Equal)
    
    PrintMessage("XFirst returns 100")
    T.val = Array.First(T.arr)
    T.tmp = 100
    RunTask(Check_Equal)
    
    PrintMessage("XLast returns 500")
    T.val = Array.Last(T.arr)
    T.tmp = 500
    RunTask(Check_Equal)
    
    PrintMessage("XIndexOf(300) returns 2")
    T.val = Array.IndexOf(T.arr, 300)
    T.tmp = 2
    RunTask(Check_Equal)
    
    PrintMessage("XIndexOf(999) returns XNULL (-1)")
    T.val = Array.IndexOf(T.arr, 999)
    T.tmp = -1
    RunTask(Check_Equal)
    
    PrintMessage("XContains(300) returns 1")
    T.val = Array.Contains(T.arr, 300)
    T.tmp = 1
    RunTask(Check_Equal)
    
    PrintMessage("XContains(999) returns 0")
    T.val = Array.Contains(T.arr, 999)
    T.tmp = 0
    RunTask(Check_Equal)
    
    Array.Destroy(T.arr)
    PrintMessage("  TEST 2 COMPLETE\n")
}

// =============================================================================
// TEST 3: XArray Insert/Delete/Shift
// =============================================================================
SubRoutine.Test3_InsertDelete {
    PrintMessage("\n=== TEST 3: XArray Insert/Delete/Shift ===\n")
    
    T.arr = Array.Create(16)
    Array.Push(T.arr, 10)
    Array.Push(T.arr, 20)
    Array.Push(T.arr, 30)
    Array.Push(T.arr, 40)
    // arr = [10, 20, 30, 40]
    
    // Insert at middle
    Array.Insert(T.arr, 2, 25)
    // arr = [10, 20, 25, 30, 40]
    
    PrintMessage("After XInsert(2, 25), size is 5")
    T.val = Array.Size(T.arr)
    T.tmp = 5
    RunTask(Check_Equal)
    
    PrintMessage("Element at index 2 is 25")
    T.val = Array.Get(T.arr, 2)
    T.tmp = 25
    RunTask(Check_Equal)
    
    PrintMessage("Element at index 3 is 30 (shifted)")
    T.val = Array.Get(T.arr, 3)
    T.tmp = 30
    RunTask(Check_Equal)
    
    // Insert at beginning
    Array.Insert(T.arr, 0, 5)
    // arr = [5, 10, 20, 25, 30, 40]
    
    PrintMessage("After XInsert(0, 5), first element is 5")
    T.val = Array.Get(T.arr, 0)
    T.tmp = 5
    RunTask(Check_Equal)
    
    // Delete from middle
    T.val = Array.Delete(T.arr, 2)
    // arr = [5, 10, 25, 30, 40]
    
    PrintMessage("XDelete(2) returns 20")
    T.tmp = 20
    RunTask(Check_Equal)
    
    PrintMessage("Size is now 5")
    T.val = Array.Size(T.arr)
    T.tmp = 5
    RunTask(Check_Equal)
    
    // Shift
    T.val = Array.Shift(T.arr)
    // arr = [10, 25, 30, 40]
    
    PrintMessage("XShift returns 5")
    T.tmp = 5
    RunTask(Check_Equal)
    
    PrintMessage("Size is now 4")
    T.val = Array.Size(T.arr)
    T.tmp = 4
    RunTask(Check_Equal)
    
    PrintMessage("New first element is 10")
    T.val = Array.Get(T.arr, 0)
    T.tmp = 10
    RunTask(Check_Equal)
    
    Array.Destroy(T.arr)
    PrintMessage("  TEST 3 COMPLETE\n")
}

// =============================================================================
// TEST 4: XArray Swap/Copy/Resize
// =============================================================================
SubRoutine.Test4_SwapCopyResize {
    PrintMessage("\n=== TEST 4: XArray Swap/Copy/Resize ===\n")
    
    T.arr = Array.Create(8)
    Array.Push(T.arr, 100)
    Array.Push(T.arr, 200)
    Array.Push(T.arr, 300)
    Array.Push(T.arr, 400)
    
    // Swap
    Array.Swap(T.arr, 0, 3)
    
    PrintMessage("After XSwap(0,3), element 0 is 400")
    T.val = Array.Get(T.arr, 0)
    T.tmp = 400
    RunTask(Check_Equal)
    
    PrintMessage("Element 3 is 100")
    T.val = Array.Get(T.arr, 3)
    T.tmp = 100
    RunTask(Check_Equal)
    
    // Copy
    T.copy = Array.Copy(T.arr)
    
    PrintMessage("XCopy returns non-null")
    T.val = T.copy
    RunTask(Check_NotZero)
    
    PrintMessage("Copy has size 4")
    T.val = Array.Size(T.copy)
    T.tmp = 4
    RunTask(Check_Equal)
    
    // Modify original
    Array.Set(T.arr, 0, 999)
    
    PrintMessage("Copy is independent")
    T.val = Array.Get(T.copy, 0)
    T.tmp = 400
    RunTask(Check_Equal)
    
    Array.Destroy(T.copy)
    
    // Resize
    Array.Resize(T.arr, 32)
    
    PrintMessage("After XResize(32), capacity is 32")
    T.val = Array.Capacity(T.arr)
    T.tmp = 32
    RunTask(Check_Equal)
    
    PrintMessage("Size preserved after resize")
    T.val = Array.Size(T.arr)
    T.tmp = 4
    RunTask(Check_Equal)
    
    Array.Destroy(T.arr)
    PrintMessage("  TEST 4 COMPLETE\n")
}

// =============================================================================
// TEST 5: XArray Auto-Resize
// =============================================================================
SubRoutine.Test5_AutoResize {
    PrintMessage("\n=== TEST 5: XArray Auto-Resize ===\n")
    
    T.arr = Array.Create(4)
    
    PrintMessage("Initial capacity is 4")
    T.val = Array.Capacity(T.arr)
    T.tmp = 4
    RunTask(Check_Equal)
    
    // Push 4 elements
    Array.Push(T.arr, 1)
    Array.Push(T.arr, 2)
    Array.Push(T.arr, 3)
    Array.Push(T.arr, 4)
    
    // Push 5th - triggers resize
    Array.Push(T.arr, 5)
    
    PrintMessage("After 5th push, size is 5")
    T.val = Array.Size(T.arr)
    T.tmp = 5
    RunTask(Check_Equal)
    
    PrintMessage("Capacity doubled to 8")
    T.val = Array.Capacity(T.arr)
    T.tmp = 8
    RunTask(Check_Equal)
    
    PrintMessage("Element 0 preserved")
    T.val = Array.Get(T.arr, 0)
    T.tmp = 1
    RunTask(Check_Equal)
    
    PrintMessage("Element 4 accessible")
    T.val = Array.Get(T.arr, 4)
    T.tmp = 5
    RunTask(Check_Equal)
    
    // Push more to trigger more resizes
    T.idx = 6
    WhileLoop LessEqual(T.idx, 20) {
        Array.Push(T.arr, T.idx)
        T.idx = Add(T.idx, 1)
    }
    
    PrintMessage("After pushing 1-20, size is 20")
    T.val = Array.Size(T.arr)
    T.tmp = 20
    RunTask(Check_Equal)
    
    PrintMessage("Element 19 is 20")
    T.val = Array.Get(T.arr, 19)
    T.tmp = 20
    RunTask(Check_Equal)
    
    Array.Destroy(T.arr)
    PrintMessage("  TEST 5 COMPLETE\n")
}

// =============================================================================
// TEST 6: XStack
// =============================================================================
SubRoutine.Test6_Stack {
    PrintMessage("\n=== TEST 6: XStack ===\n")
    
    T.stk = Stack.Create(16)
    
    PrintMessage("New stack is empty")
    T.val = Stack.IsEmpty(T.stk)
    T.tmp = 1
    RunTask(Check_Equal)
    
    Stack.Push(T.stk, 10)
    Stack.Push(T.stk, 20)
    Stack.Push(T.stk, 30)
    
    PrintMessage("XPeek returns 30")
    T.val = Stack.Peek(T.stk)
    T.tmp = 30
    RunTask(Check_Equal)
    
    PrintMessage("XPop returns 30")
    T.val = Stack.Pop(T.stk)
    T.tmp = 30
    RunTask(Check_Equal)
    
    PrintMessage("XPop returns 20")
    T.val = Stack.Pop(T.stk)
    T.tmp = 20
    RunTask(Check_Equal)
    
    PrintMessage("XPop returns 10")
    T.val = Stack.Pop(T.stk)
    T.tmp = 10
    RunTask(Check_Equal)
    
    PrintMessage("Stack now empty")
    T.val = Stack.IsEmpty(T.stk)
    T.tmp = 1
    RunTask(Check_Equal)
    
    Array.Destroy(T.stk)
    PrintMessage("  TEST 6 COMPLETE\n")
}

// =============================================================================
// TEST 7: XQueue
// =============================================================================
SubRoutine.Test7_Queue {
    PrintMessage("\n=== TEST 7: XQueue ===\n")
    
    T.queue = Queue.Create(8)
    
    Queue.Enqueue(T.queue, 100)
    Queue.Enqueue(T.queue, 200)
    Queue.Enqueue(T.queue, 300)
    
    PrintMessage("Dequeue returns 100 (FIFO)")
    T.val = Queue.Dequeue(T.queue)
    T.tmp = 100
    RunTask(Check_Equal)
    
    PrintMessage("Dequeue returns 200")
    T.val = Queue.Dequeue(T.queue)
    T.tmp = 200
    RunTask(Check_Equal)
    
    // Enqueue more (circular buffer test)
    Queue.Enqueue(T.queue, 400)
    Queue.Enqueue(T.queue, 500)
    
    PrintMessage("Dequeue returns 300")
    T.val = Queue.Dequeue(T.queue)
    T.tmp = 300
    RunTask(Check_Equal)
    
    PrintMessage("Dequeue returns 400")
    T.val = Queue.Dequeue(T.queue)
    T.tmp = 400
    RunTask(Check_Equal)
    
    Queue.Destroy(T.queue)
    PrintMessage("  TEST 7 COMPLETE\n")
}

// =============================================================================
// TEST 8: XHash (Integer Keys)
// =============================================================================
SubRoutine.Test8_Hash {
    PrintMessage("\n=== TEST 8: XHash ===\n")
    
    T.hash = IHash.Create(17)
    
    IHash.Insert(T.hash, 100, 1000)
    IHash.Insert(T.hash, 200, 2000)
    IHash.Insert(T.hash, 17, 170)
    IHash.Insert(T.hash, 34, 340)
    
    PrintMessage("XLookup(100) returns 1000")
    T.val = IHash.Lookup(T.hash, 100)
    T.tmp = 1000
    RunTask(Check_Equal)
    
    PrintMessage("XLookup(17) returns 170")
    T.val = IHash.Lookup(T.hash, 17)
    T.tmp = 170
    RunTask(Check_Equal)
    
    PrintMessage("XLookup(34) returns 340")
    T.val = IHash.Lookup(T.hash, 34)
    T.tmp = 340
    RunTask(Check_Equal)
    
    PrintMessage("XLookup(999) returns XERROR")
    T.val = IHash.Lookup(T.hash, 999)
    T.tmp = -999999
    RunTask(Check_Equal)
    
    IHash.Destroy(T.hash)
    PrintMessage("  TEST 8 COMPLETE\n")
}

// =============================================================================
// TEST 9: XSHash (String Keys)
// =============================================================================
SubRoutine.Test9_SHash {
    PrintMessage("\n=== TEST 9: XSHash ===\n")
    
    T.shash = SHash.Create(31)
    
    SHash.Insert(T.shash, "alpha", 1)
    SHash.Insert(T.shash, "beta", 2)
    SHash.Insert(T.shash, "gamma", 3)
    
    PrintMessage("XLookup('alpha') returns 1")
    T.val = SHash.Lookup(T.shash, "alpha")
    T.tmp = 1
    RunTask(Check_Equal)
    
    PrintMessage("XLookup('gamma') returns 3")
    T.val = SHash.Lookup(T.shash, "gamma")
    T.tmp = 3
    RunTask(Check_Equal)
    
    PrintMessage("XExists('beta') returns 1")
    T.val = SHash.Exists(T.shash, "beta")
    T.tmp = 1
    RunTask(Check_Equal)
    
    PrintMessage("XExists('omega') returns 0")
    T.val = SHash.Exists(T.shash, "omega")
    T.tmp = 0
    RunTask(Check_Equal)
    
    // Delete
    T.val = SHash.Delete(T.shash, "gamma")
    PrintMessage("XDelete('gamma') returns 3")
    T.tmp = 3
    RunTask(Check_Equal)
    
    PrintMessage("After delete, XExists('gamma') returns 0")
    T.val = SHash.Exists(T.shash, "gamma")
    T.tmp = 0
    RunTask(Check_Equal)
    
    SHash.Destroy(T.shash)
    PrintMessage("  TEST 9 COMPLETE\n")
}

// =============================================================================
// TEST 10: XList
// =============================================================================
SubRoutine.Test10_List {
    PrintMessage("\n=== TEST 10: XList ===\n")
    
    T.list = List.Create()
    
    PrintMessage("New list size is 0")
    T.val = List.Size(T.list)
    T.tmp = 0
    RunTask(Check_Equal)
    
    List.Append(T.list, 10)
    List.Append(T.list, 20)
    List.Append(T.list, 30)
    
    PrintMessage("After 3 appends, size is 3")
    T.val = List.Size(T.list)
    T.tmp = 3
    RunTask(Check_Equal)
    
    List.Prepend(T.list, 5)
    
    PrintMessage("After prepend, size is 4")
    T.val = List.Size(T.list)
    T.tmp = 4
    RunTask(Check_Equal)
    
    T.val = List.PopFront(T.list)
    PrintMessage("XPopFront returns 5")
    T.tmp = 5
    RunTask(Check_Equal)
    
    T.val = List.PopBack(T.list)
    PrintMessage("XPopBack returns 30")
    T.tmp = 30
    RunTask(Check_Equal)
    
    PrintMessage("Size is now 2")
    T.val = List.Size(T.list)
    T.tmp = 2
    RunTask(Check_Equal)
    
    List.Destroy(T.list)
    PrintMessage("  TEST 10 COMPLETE\n")
}

// =============================================================================
// TEST 11: XUtil
// =============================================================================
SubRoutine.Test11_Util {
    PrintMessage("\n=== TEST 11: XUtil ===\n")
    
    T.arr = Array.Create(16)
    Array.Push(T.arr, 50)
    Array.Push(T.arr, 20)
    Array.Push(T.arr, 80)
    Array.Push(T.arr, 10)
    Array.Push(T.arr, 60)
    
    PrintMessage("XFindMax returns 80")
    T.val = Util.FindMax(T.arr)
    T.tmp = 80
    RunTask(Check_Equal)
    
    PrintMessage("XFindMin returns 10")
    T.val = Util.FindMin(T.arr)
    T.tmp = 10
    RunTask(Check_Equal)
    
    // Sort
    T.sz = Array.Size(T.arr)
    Util.QuickSort(T.arr, 0, Subtract(T.sz, 1))
    
    PrintMessage("After sort, first is 10")
    T.val = Array.Get(T.arr, 0)
    T.tmp = 10
    RunTask(Check_Equal)
    
    PrintMessage("After sort, last is 80")
    T.val = Array.Get(T.arr, 4)
    T.tmp = 80
    RunTask(Check_Equal)
    
    // Reverse
    Util.Reverse(T.arr)
    
    PrintMessage("After reverse, first is 80")
    T.val = Array.Get(T.arr, 0)
    T.tmp = 80
    RunTask(Check_Equal)
    
    Array.Destroy(T.arr)
    PrintMessage("  TEST 11 COMPLETE\n")
}

// =============================================================================
// TEST 12: Stress Test
// =============================================================================
SubRoutine.Test12_Stress {
    PrintMessage("\n=== TEST 12: Stress Test ===\n")
    PrintMessage("  Creating/destroying 500 arrays...\n")
    
    T.tmp2 = 0
    T.idx = 0
    WhileLoop LessThan(T.idx, 500) {
        T.arr = Array.Create(8)
        Array.Push(T.arr, T.idx)
        Array.Push(T.arr, Multiply(T.idx, 2))
        T.val = Array.Get(T.arr, 0)
        IfCondition NotEqual(T.val, T.idx) ThenBlock: {
            T.tmp2 = Add(T.tmp2, 1)
        }
        Array.Destroy(T.arr)
        T.idx = Add(T.idx, 1)
    }
    
    PrintMessage("500 cycles with 0 errors")
    T.val = T.tmp2
    T.tmp = 0
    RunTask(Check_Equal)
    
    PrintMessage("  TEST 12 COMPLETE\n")
}

// =============================================================================
// MAIN
// =============================================================================
SubRoutine.Main {
    PrintMessage("╔════════════════════════════════════════════════════════════════╗\n")
    PrintMessage("║   XARRAY PROPER TEST SUITE - Arena Integration                 ║\n")
    PrintMessage("╚════════════════════════════════════════════════════════════════╝\n")
    
    Arena_Init()
    
    RunTask(Test1_Core)
    RunTask(Test2_Extended)
    RunTask(Test3_InsertDelete)
    RunTask(Test4_SwapCopyResize)
    RunTask(Test5_AutoResize)
    RunTask(Test6_Stack)
    RunTask(Test7_Queue)
    RunTask(Test8_Hash)
    RunTask(Test9_SHash)
    RunTask(Test10_List)
    RunTask(Test11_Util)
    RunTask(Test12_Stress)
    
    PrintMessage("\n╔════════════════════════════════════════════════════════════════╗\n")
    PrintMessage("║                      FINAL RESULTS                             ║\n")
    PrintMessage("╚════════════════════════════════════════════════════════════════╝\n")
    PrintMessage("Passed: ")
    PrintNumber(T.pass)
    PrintMessage("\nFailed: ")
    PrintNumber(T.fail)
    PrintMessage("\nTotal:  ")
    PrintNumber(T.total)
    PrintMessage("\n")
    
    IfCondition EqualTo(T.fail, 0) ThenBlock: {
        PrintMessage("\n✓ ALL TESTS PASSED\n")
    } ElseBlock: {
        PrintMessage("\n✗ SOME TESTS FAILED\n")
    }
    
    PrintMessage("\n")
    Arena_Report()
}

RunTask(Main)