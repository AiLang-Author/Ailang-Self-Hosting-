// bench_js.ailang — JavaScript engine micro-benchmarks
// Compares Ailang JS engine performance with wall-clock timing.
// Each benchmark is a single JSEngine_Run call timed with CLOCK_MONOTONIC.
//
// Usage:
//   ./ailang.x TestCode/bench_js.ailang bench_js.x && ./bench_js.x
//
// Copyright (c) 2026 Sean Collins, 2 Paws Machine and Engineering. SCSL.

LibraryImport.Arena
LibraryImport.StringUtils
LibraryImport.Browser.HTMLTokenizer
LibraryImport.Browser.HTMLDom
LibraryImport.Browser.JSLexer
LibraryImport.Browser.JSParser
LibraryImport.Browser.JSCompiler
LibraryImport.Browser.JSRuntime
LibraryImport.Browser.JSVM
LibraryImport.Browser.JSBridge
LibraryImport.Browser.JSEngine

FixedPool.BenchSys {
    "SYS_CLOCK_GETTIME": Initialize=228
    "CLOCK_MONOTONIC":  Initialize=1
}

FixedPool.BenchState {
    "ts_buf":   Initialize=0
    "start_s":  Initialize=0
    "start_ns": Initialize=0
    "end_s":    Initialize=0
    "end_ns":   Initialize=0
    "delta_us": Initialize=0
    "total_us": Initialize=0
    "count":    Initialize=0
}

// =============================================================================
// CLOCK — get monotonic microseconds
// =============================================================================
Function.Bench_MonoUsec {
    Output: Integer
    Body: {
        ts = Allocate(16)
        SystemCall(BenchSys.SYS_CLOCK_GETTIME, BenchSys.CLOCK_MONOTONIC, ts, 0, 0, 0, 0)
        sec  = Dereference(ts)
        nsec = Dereference(Add(ts, 8))
        Deallocate(ts, 16)
        ReturnValue(Add(Multiply(sec, 1000000), Divide(nsec, 1000)))
    }
}

// =============================================================================
// TIMING HELPERS
// =============================================================================
Function.Bench_Start {
    Output: Integer
    Body: {
        BenchState.start_s = Bench_MonoUsec()
        ReturnValue(0)
    }
}

Function.Bench_End {
    Input: label: Address
    Output: Integer
    Body: {
        save_label = label
        BenchState.end_s = Bench_MonoUsec()
        BenchState.delta_us = Subtract(BenchState.end_s, BenchState.start_s)
        BenchState.total_us = Add(BenchState.total_us, BenchState.delta_us)
        BenchState.count = Add(BenchState.count, 1)

        PrintMessage("  ")
        PrintMessage(save_label)
        PrintMessage(": ")
        // Print milliseconds
        ms = Divide(BenchState.delta_us, 1000)
        us_rem = Subtract(BenchState.delta_us, Multiply(ms, 1000))
        PrintNumber(ms)
        PrintMessage(".")
        // Zero-pad the microsecond remainder to 3 digits
        IfCondition LessThan(us_rem, 100) ThenBlock: {
            PrintMessage("0")
        }
        IfCondition LessThan(us_rem, 10) ThenBlock: {
            PrintMessage("0")
        }
        PrintNumber(us_rem)
        PrintMessage(" ms\n")

        ReturnValue(BenchState.delta_us)
    }
}

// =============================================================================
// BENCHMARK 1: Loop counter — while (i < 100000) { i = i + 1; }
// Tests: dispatch loop overhead, comparison, variable read/write
// =============================================================================
Function.Bench_LoopCounter {
    Output: Integer
    Body: {
        JSVM_SetMaxSteps(50000000)
        Bench_Start()
        JSEngine_EvalString("var i = 0; while (i < 100000) { i = i + 1; }", 45)
        Bench_End("loop 100k iterations")
        err = JSEngine_GetError()
        IfCondition EqualTo(err, 1) ThenBlock: {
            PrintMessage("    [ERROR] loop benchmark failed\n")
        }
        ReturnValue(0)
    }
}

// =============================================================================
// BENCHMARK 2: Fibonacci recursive — fib(20)
// Tests: function call/return, stack frames, recursion depth
// =============================================================================
Function.Bench_Fibonacci {
    Output: Integer
    Body: {
        JSVM_SetMaxSteps(50000000)
        Bench_Start()
        JSEngine_EvalString("function fib(n) { if (n < 2) { return n; } return fib(n - 1) + fib(n - 2); } fib(20);", 85)
        Bench_End("fib(20) recursive")
        err = JSEngine_GetError()
        IfCondition EqualTo(err, 1) ThenBlock: {
            PrintMessage("    [ERROR] fib benchmark failed\n")
        }
        ReturnValue(0)
    }
}

// =============================================================================
// BENCHMARK 3: Arithmetic churn — 50k iterations of add/sub/mul
// Tests: raw arithmetic dispatch, constant folding (none — we don't optimize)
// =============================================================================
Function.Bench_Arithmetic {
    Output: Integer
    Body: {
        JSVM_SetMaxSteps(50000000)
        Bench_Start()
        JSEngine_EvalString("var a = 0; var b = 1; var i = 0; while (i < 50000) { a = a + b * 3 - 1; b = b + a - 2; i = i + 1; }", 96)
        Bench_End("arith 50k iterations")
        err = JSEngine_GetError()
        IfCondition EqualTo(err, 1) ThenBlock: {
            PrintMessage("    [ERROR] arith benchmark failed\n")
        }
        ReturnValue(0)
    }
}

// =============================================================================
// BENCHMARK 4: Object property access — create + read/write in loop
// Tests: XSHash insert/lookup through JSRT_ObjSet/ObjGet
// =============================================================================
Function.Bench_ObjectProps {
    Output: Integer
    Body: {
        JSVM_SetMaxSteps(50000000)
        Bench_Start()
        JSEngine_EvalString("var obj = {x: 0, y: 0, z: 0}; var i = 0; while (i < 10000) { obj.x = obj.x + 1; obj.y = obj.y + obj.x; obj.z = obj.z + obj.y; i = i + 1; }", 157)
        Bench_End("obj props 10k iters")
        err = JSEngine_GetError()
        IfCondition EqualTo(err, 1) ThenBlock: {
            PrintMessage("    [ERROR] obj benchmark failed\n")
        }
        ReturnValue(0)
    }
}

// =============================================================================
// BENCHMARK 5: String operations — concat in a loop
// Tests: string creation, JSRT_Add string concat path
// =============================================================================
Function.Bench_StringConcat {
    Output: Integer
    Body: {
        JSVM_SetMaxSteps(50000000)
        Bench_Start()
        JSEngine_EvalString("var s = \"\"; var i = 0; while (i < 1000) { s = s + \"a\"; i = i + 1; }", 67)
        Bench_End("string concat 1k")
        err = JSEngine_GetError()
        IfCondition EqualTo(err, 1) ThenBlock: {
            PrintMessage("    [ERROR] string benchmark failed\n")
        }
        ReturnValue(0)
    }
}

// =============================================================================
// BENCHMARK 6: Nested function calls — call chain 3 deep, 10k iterations
// Tests: call frame push/pop overhead
// =============================================================================
Function.Bench_NestedCalls {
    Output: Integer
    Body: {
        JSVM_SetMaxSteps(50000000)
        Bench_Start()
        JSEngine_EvalString("function c(x){return x+1;} function b(x){return c(x)+1;} function a(x){return b(x)+1;} var i=0; var r=0; while(i<10000){r=a(i);i=i+1;}", 148)
        Bench_End("nested calls 10k")
        err = JSEngine_GetError()
        IfCondition EqualTo(err, 1) ThenBlock: {
            PrintMessage("    [ERROR] nested calls benchmark failed\n")
        }
        ReturnValue(0)
    }
}

// =============================================================================
// BENCHMARK 7: Array push + read — 5k pushes then sum
// Tests: XArray operations through JSRT_ArrPush/ArrGet
// =============================================================================
Function.Bench_ArrayOps {
    Output: Integer
    Body: {
        JSVM_SetMaxSteps(50000000)
        Bench_Start()
        JSEngine_EvalString("var arr = []; var i = 0; while (i < 5000) { arr.push(i); i = i + 1; } var sum = 0; i = 0; while (i < 5000) { sum = sum + arr[i]; i = i + 1; }", 155)
        Bench_End("array 5k push+sum")
        err = JSEngine_GetError()
        IfCondition EqualTo(err, 1) ThenBlock: {
            PrintMessage("    [ERROR] array benchmark failed\n")
        }
        ReturnValue(0)
    }
}

// =============================================================================
// MAIN
// =============================================================================
SubRoutine.Main {
    Arena_Init()

    PrintMessage("========================================\n")
    PrintMessage("  Ailang JS Engine — Micro-Benchmarks\n")
    PrintMessage("========================================\n\n")

    // Initialize the JS engine once
    JSEngine_Init()

    PrintMessage("Benchmarks (wall-clock, CLOCK_MONOTONIC):\n\n")

    Bench_LoopCounter()
    Bench_Fibonacci()
    Bench_Arithmetic()
    Bench_ObjectProps()
    Bench_StringConcat()
    Bench_NestedCalls()
    Bench_ArrayOps()

    PrintMessage("\n========================================\n")
    PrintMessage("Total: ")
    total_ms = Divide(BenchState.total_us, 1000)
    total_rem = Subtract(BenchState.total_us, Multiply(total_ms, 1000))
    PrintNumber(total_ms)
    PrintMessage(".")
    IfCondition LessThan(total_rem, 100) ThenBlock: {
        PrintMessage("0")
    }
    IfCondition LessThan(total_rem, 10) ThenBlock: {
        PrintMessage("0")
    }
    PrintNumber(total_rem)
    PrintMessage(" ms across ")
    PrintNumber(BenchState.count)
    PrintMessage(" benchmarks\n")
    PrintMessage("========================================\n")

    JSEngine_Shutdown()
}

RunTask(Main)
