// browser_main.ailang — Headless browser rendering test harness
// Runs the FULL browser rendering pipeline without a display server:
//   HTML file -> Tokenize -> DOM -> CSS -> Layout -> Render -> PPM dump
//
// Usage:
//   ./ailang.x TestCode/browser_main.ailang browser_main.x
//   echo "/tmp/render_test.html" | ./browser_main.x          # reads HTML path from stdin
//   ./browser_main.x                                          # reads /tmp/render_test.html default
//
// Output: /tmp/render_out.ppm (P6 format, 1024x700)
//         Exit code 0 on success, 1 on failure
//
// The binary can be driven by render_test_runner.py or the new wpt_render_runner.py
//
// Copyright (c) 2026 Sean Collins, 2 Paws Machine and Engineering. SCSL.

// ─── Imports ─────────────────────────────────────────────────────────────────
LibraryImport.Arena
LibraryImport.StringUtils
LibraryImport.Display.Render.Framebuffer
LibraryImport.Display.Render.DSurfaceTypes
LibraryImport.Display.Render.DSurface
LibraryImport.Display.Render.DDrawPixel
LibraryImport.Display.Render.Fonts
LibraryImport.Display.Render.VIF
LibraryImport.Display.Render.SurfaceBlit
LibraryImport.Display.System.Screenshot
LibraryImport.TermFont
LibraryImport.ShmCanvas
LibraryImport.Browser.URL
LibraryImport.Browser.HTMLTokenizer
LibraryImport.Browser.HTMLDom
LibraryImport.Browser.CSSParse
LibraryImport.Browser.HTMLLayout
LibraryImport.Browser.HTMLRender

// ─── Constants ───────────────────────────────────────────────────────────────
FixedPool.BrTest {
    "CANVAS_W":     Initialize=1024
    "CANVAS_H":     Initialize=700
    "MAX_HTML":     Initialize=2097152
    "SYS_READ":     Initialize=0
    "SYS_WRITE":    Initialize=1
    "SYS_OPEN":     Initialize=2
    "SYS_CLOSE":    Initialize=3
    "SYS_EXIT":     Initialize=60
    "html_buf":     Initialize=0
    "html_len":     Initialize=0
    "canvas_pix":   Initialize=0
    "canvas_sz":    Initialize=0
    "dom_root":     Initialize=0
    "cmd_count":    Initialize=0
    "out_path":     Initialize=0
    "in_path":      Initialize=0
}

// ─── Override: headless framebuffer ──────────────────────────────────────────
Function.RenderFB_InitDouble {
    Output: Integer
    Body: {
        FB_InitHeadless(BrTest.CANVAS_W, BrTest.CANVAS_H)
        ReturnValue(1)
    }
}

// ─── Stubs for display server functions we don't use ─────────────────────────
Function.Evdev_Poll {
    Body: { ReturnValue(0) }
}
Function.SysDisplay_InitTTY {
    Body: { ReturnValue(0) }
}
Function.SysDisplay_InitInput {
    Body: { ReturnValue(0) }
}
Function.DebugLog_Push {
    Input: msg: Address
    Input: len: Integer
    Body: { ReturnValue(0) }
}

// ─── Read an entire file into a buffer ───────────────────────────────────────
// Returns bytes read, or 0 on failure. Writes into BrTest.html_buf
Function.BrTest_ReadFile {
    Input: path: Address
    Output: Integer
    Body: {
        // O_RDONLY = 0
        fd = SystemCall(BrTest.SYS_OPEN, path, 0, 0)
        IfCondition LessThan(fd, 0) ThenBlock: {
            PrintMessage("[BrTest] cannot open: ")
            PrintMessage(path)
            PrintMessage("\n")
            ReturnValue(0)
        }

        total = 0
        reading = 1
        WhileLoop EqualTo(reading, 1) {
            remain = Subtract(BrTest.MAX_HTML, total)
            IfCondition LessEqual(remain, 0) ThenBlock: {
                reading = 0
            }
            IfCondition EqualTo(reading, 1) ThenBlock: {
                n = SystemCall(BrTest.SYS_READ, fd, Add(BrTest.html_buf, total), remain)
                IfCondition LessEqual(n, 0) ThenBlock: {
                    reading = 0
                }
                IfCondition GreaterThan(n, 0) ThenBlock: {
                    total = Add(total, n)
                }
            }
        }

        SystemCall(BrTest.SYS_CLOSE, fd)

        // Null-terminate
        SetByte(BrTest.html_buf, total, 0)
        BrTest.html_len = total
        ReturnValue(total)
    }
}

// ─── Read a line from stdin (for path input) ─────────────────────────────────
Function.BrTest_ReadStdinLine {
    Input: buf: Address
    Input: max_len: Integer
    Output: Integer
    Body: {
        pos = 0
        reading = 1
        WhileLoop EqualTo(reading, 1) {
            IfCondition GreaterEqual(pos, Subtract(max_len, 1)) ThenBlock: {
                reading = 0
            }
            IfCondition EqualTo(reading, 1) ThenBlock: {
                one = Allocate(1)
                n = SystemCall(BrTest.SYS_READ, 0, one, 1)
                IfCondition LessEqual(n, 0) ThenBlock: {
                    Deallocate(one, 1)
                    reading = 0
                }
                IfCondition GreaterThan(n, 0) ThenBlock: {
                    ch = GetByte(one, 0)
                    Deallocate(one, 1)
                    IfCondition EqualTo(ch, 10) ThenBlock: {
                        reading = 0
                    }
                    IfCondition EqualTo(ch, 13) ThenBlock: {
                        reading = 0
                    }
                    is_newline = 0
                    IfCondition EqualTo(ch, 10) ThenBlock: { is_newline = 1 }
                    IfCondition EqualTo(ch, 13) ThenBlock: { is_newline = 1 }
                    IfCondition EqualTo(is_newline, 0) ThenBlock: {
                        SetByte(buf, pos, ch)
                        pos = Add(pos, 1)
                    }
                }
            }
        }
        SetByte(buf, pos, 0)
        ReturnValue(pos)
    }
}

// ─── Write PPM to a custom path (based on Screenshot_SavePPM) ───────────────
// Takes a pixel buffer (BGRA), width, height, and output path
Function.BrTest_WritePPM {
    Input: pixels: Address
    Input: w: Integer
    Input: h: Integer
    Input: path: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(pixels, 0) ThenBlock: {
            PrintMessage("[BrTest] WritePPM: null pixels\n")
            ReturnValue(0)
        }

        // Open output file: O_WRONLY|O_CREAT|O_TRUNC = 577, mode 0644 = 420
        fd = SystemCall(BrTest.SYS_OPEN, path, 577, 420)
        IfCondition LessThan(fd, 0) ThenBlock: {
            PrintMessage("[BrTest] WritePPM: open failed: ")
            PrintMessage(path)
            PrintMessage("\n")
            ReturnValue(0)
        }

        // Build PPM header: "P6\n{w} {h}\n255\n"
        hdr = Allocate(64)
        SetByte(hdr, 0, 80)   // 'P'
        SetByte(hdr, 1, 54)   // '6'
        SetByte(hdr, 2, 10)   // '\n'
        hoff = 3
        hoff = SS_WriteDecimal(hdr, hoff, w)
        SetByte(hdr, hoff, 32)  // ' '
        hoff = Add(hoff, 1)
        hoff = SS_WriteDecimal(hdr, hoff, h)
        SetByte(hdr, hoff, 10)           // '\n'
        SetByte(hdr, Add(hoff, 1), 50)   // '2'
        SetByte(hdr, Add(hoff, 2), 53)   // '5'
        SetByte(hdr, Add(hoff, 3), 53)   // '5'
        SetByte(hdr, Add(hoff, 4), 10)   // '\n'
        hoff = Add(hoff, 5)
        SystemCall(BrTest.SYS_WRITE, fd, hdr, hoff)
        Deallocate(hdr, 64)

        // Write pixel data (BGRA -> RGB, top to bottom)
        row_bytes = Multiply(w, 3)
        row_buf = Allocate(Add(row_bytes, 8))
        pitch = Multiply(w, 4)

        y = 0
        WhileLoop LessThan(y, h) {
            src = Add(pixels, Multiply(y, pitch))
            x = 0
            WhileLoop LessThan(x, w) {
                si = Multiply(x, 4)
                di = Multiply(x, 3)
                SetByte(row_buf, di,          GetByte(src, Add(si, 2))) // R (from BGRA offset 2)
                SetByte(row_buf, Add(di, 1),  GetByte(src, Add(si, 1))) // G (from BGRA offset 1)
                SetByte(row_buf, Add(di, 2),  GetByte(src, si))          // B (from BGRA offset 0)
                x = Add(x, 1)
            }
            SystemCall(BrTest.SYS_WRITE, fd, row_buf, row_bytes)
            y = Add(y, 1)
        }

        Deallocate(row_buf, Add(row_bytes, 8))
        SystemCall(BrTest.SYS_CLOSE, fd)
        ReturnValue(1)
    }
}

// ─── MAIN ────────────────────────────────────────────────────────────────────
SubRoutine.Main {
    Arena_Init()

    // Determine input HTML path
    // Default: /tmp/render_test.html
    // Can be overridden via stdin (pipe a path to the binary)
    path_buf = Allocate(1024)
    MemorySet(path_buf, 0, 1024)

    // Try to read path from stdin (non-blocking check via small read)
    // If stdin has data, read it as the HTML path; otherwise use default
    BrTest.in_path = "/tmp/render_test.html"
    BrTest.out_path = "/tmp/render_out.ppm"

    // Check if stdin is a pipe (not a terminal) by attempting read
    // For now, always use default paths — the Python runner copies HTML to /tmp/render_test.html
    Deallocate(path_buf, 1024)

    PrintMessage("[BrTest] Input:  ")
    PrintMessage(BrTest.in_path)
    PrintMessage("\n")
    PrintMessage("[BrTest] Output: ")
    PrintMessage(BrTest.out_path)
    PrintMessage("\n")

    // ── Step 1: Allocate HTML buffer and read file ───────────────────────
    BrTest.html_buf = Allocate(BrTest.MAX_HTML)
    IfCondition EqualTo(BrTest.html_buf, 0) ThenBlock: {
        PrintMessage("[BrTest] FAIL — cannot allocate HTML buffer\n")
        SystemCall(BrTest.SYS_EXIT, 1, 0, 0, 0, 0)
    }

    bytes = BrTest_ReadFile(BrTest.in_path)
    IfCondition EqualTo(bytes, 0) ThenBlock: {
        PrintMessage("[BrTest] FAIL — no HTML data (check ")
        PrintMessage(BrTest.in_path)
        PrintMessage(")\n")
        SystemCall(BrTest.SYS_EXIT, 1, 0, 0, 0, 0)
    }
    PrintMessage("[BrTest] Read ")
    PrintNumber(bytes)
    PrintMessage(" bytes of HTML\n")

    // ── Step 2: Init browser libraries ───────────────────────────────────
    URL_Init()
    HTK_Init()
    DOM_Init()
    CSS_Init()

    // ── Step 3: Tokenize HTML ────────────────────────────────────────────
    PrintMessage("[BrTest] Tokenizing...\n")
    tok_count = HTK_Tokenize(BrTest.html_buf, BrTest.html_len)
    PrintMessage("[BrTest] Tokens: ")
    PrintNumber(tok_count)
    PrintMessage("\n")

    IfCondition EqualTo(tok_count, 0) ThenBlock: {
        PrintMessage("[BrTest] FAIL — zero tokens\n")
        SystemCall(BrTest.SYS_EXIT, 1, 0, 0, 0, 0)
    }

    // ── Step 4: Build DOM tree ───────────────────────────────────────────
    PrintMessage("[BrTest] Building DOM...\n")
    BrTest.dom_root = DOM_ParseString(BrTest.html_buf, BrTest.html_len)
    IfCondition LessThan(BrTest.dom_root, 0) ThenBlock: {
        PrintMessage("[BrTest] FAIL — DOM parse returned ")
        PrintNumber(BrTest.dom_root)
        PrintMessage("\n")
        SystemCall(BrTest.SYS_EXIT, 1, 0, 0, 0, 0)
    }
    PrintMessage("[BrTest] DOM nodes: ")
    PrintNumber(DOM_NodeCount())
    PrintMessage("\n")

    // ── Step 5: Parse CSS from <style> blocks ────────────────────────────
    PrintMessage("[BrTest] Parsing CSS...\n")
    css_total = 0
    style_buf = Allocate(256)
    style_ct = DOM_GetElementsByTagName(BrTest.dom_root, "style", style_buf, 32)
    PrintMessage("[BrTest] <style> tags: ")
    PrintNumber(style_ct)
    PrintMessage("\n")
    ssi = 0
    WhileLoop LessThan(ssi, style_ct) {
        s_node = Dereference(Add(style_buf, Multiply(ssi, 8)))
        // Get text from first child (TEXT node of <style>)
        s_child = DOM_GetFirstChild(s_node)
        IfCondition GreaterEqual(s_child, 0) ThenBlock: {
            s_text = DOM_GetText(s_child)
            IfCondition NotEqual(s_text, 0) ThenBlock: {
                s_len = StringLength(s_text)
                IfCondition GreaterThan(s_len, 0) ThenBlock: {
                    s_rules = CSS_ParseSheet(s_text, s_len)
                    css_total = Add(css_total, s_rules)
                }
            }
        }
        ssi = Add(ssi, 1)
    }
    Deallocate(style_buf, 256)
    PrintMessage("[BrTest] CSS rules: ")
    PrintNumber(css_total)
    PrintMessage("\n")

    // ── Step 6: Layout ───────────────────────────────────────────────────
    PrintMessage("[BrTest] Running layout...\n")
    Layout_Init()
    Layout_SetViewport(BrTest.CANVAS_W, BrTest.CANVAS_H)
    BrTest.cmd_count = Layout_Run(BrTest.dom_root)
    PrintMessage("[BrTest] Render commands: ")
    PrintNumber(BrTest.cmd_count)
    PrintMessage("\n")
    PrintMessage("[BrTest] Content height: ")
    PrintNumber(Layout_ContentHeight())
    PrintMessage("\n")

    // ── Step 7: Allocate canvas and render ───────────────────────────────
    BrTest.canvas_sz = Multiply(Multiply(BrTest.CANVAS_W, BrTest.CANVAS_H), 4)
    BrTest.canvas_pix = Allocate(BrTest.canvas_sz)
    IfCondition EqualTo(BrTest.canvas_pix, 0) ThenBlock: {
        PrintMessage("[BrTest] FAIL — canvas allocation\n")
        SystemCall(BrTest.SYS_EXIT, 1, 0, 0, 0, 0)
    }

    // Clear canvas to white (0xFFFFFFFF in BGRA)
    MemorySet(BrTest.canvas_pix, 255, BrTest.canvas_sz)

    PrintMessage("[BrTest] Rendering...\n")
    Render_Init()
    Render_SetTarget(BrTest.canvas_pix, BrTest.CANVAS_W, BrTest.CANVAS_H)
    Render_Clear(0xFFFFFFFF)
    Render_Exec()
    PrintMessage("[BrTest] Render complete\n")

    // ── Step 8: Write PPM output ─────────────────────────────────────────
    PrintMessage("[BrTest] Writing PPM...\n")
    ppm_ok = BrTest_WritePPM(BrTest.canvas_pix, BrTest.CANVAS_W, BrTest.CANVAS_H, BrTest.out_path)
    IfCondition EqualTo(ppm_ok, 1) ThenBlock: {
        PrintMessage("[BrTest] PASS — PPM written to ")
        PrintMessage(BrTest.out_path)
        PrintMessage("\n")
    } ElseBlock: {
        PrintMessage("[BrTest] FAIL — PPM write failed\n")
        SystemCall(BrTest.SYS_EXIT, 1, 0, 0, 0, 0)
    }

    // ── Step 9: Summary ──────────────────────────────────────────────────
    PrintMessage("[BrTest] === DONE ===\n")
    PrintMessage("[BrTest] Tokens:    ")
    PrintNumber(tok_count)
    PrintMessage("\n")
    PrintMessage("[BrTest] DOM nodes: ")
    PrintNumber(DOM_NodeCount())
    PrintMessage("\n")
    PrintMessage("[BrTest] CSS rules: ")
    PrintNumber(css_total)
    PrintMessage("\n")
    PrintMessage("[BrTest] Commands:  ")
    PrintNumber(BrTest.cmd_count)
    PrintMessage("\n")
    PrintMessage("[BrTest] Canvas:    ")
    PrintNumber(BrTest.CANVAS_W)
    PrintMessage("x")
    PrintNumber(BrTest.CANVAS_H)
    PrintMessage("\n")

    // Clean up
    Deallocate(BrTest.canvas_pix, BrTest.canvas_sz)
    Deallocate(BrTest.html_buf, BrTest.MAX_HTML)
}

RunTask(Main)
