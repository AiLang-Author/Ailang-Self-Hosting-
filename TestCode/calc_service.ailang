// calc_service.ailang
// Calculator service — connects to broker, handles JSON calc requests
//
// Receives calculator JSON requests via the message broker,
// dispatches to Calc_JsonHandle, sends JSON responses back.
// This is the calculator running as a standalone service process.
//
// Build: ./ailang.x Testcode/calc_service.ailang calc_service.x
// Run:   ./calc_service.x  (after msg_broker.x is running)

LibraryImport.Arena
LibraryImport.Socket
LibraryImport.StringUtils
LibraryImport.JSON
LibraryImport.XArrays
LibraryImport.HashMap
LibraryImport.Calculator

FixedPool.CalcService {
    "running":     Initialize=1
    "msg_handled": Initialize=0
}

SubRoutine.Main {
    Arena_Init()

    PrintMessage("============================================\n")
    PrintMessage("  Calculator Service — JSON State Machine\n")
    PrintMessage("============================================\n\n")

    sock_path = "/tmp/ailang_broker.sock"

    // Connect to broker
    sock = Socket.Create(1, 1)
    IfCondition LessThan(sock, 0) ThenBlock: {
        PrintMessage("[CalcSvc] Socket create failed\n")
        HaltProgram
    }

    cres = Socket.ConnectUnix(sock, sock_path)
    IfCondition LessThan(cres, 0) ThenBlock: {
        PrintMessage("[CalcSvc] Connect failed — is broker running?\n")
        Socket.Close(sock)
        HaltProgram
    }
    PrintMessage("[CalcSvc] Connected to broker\n")
    PrintMessage("[CalcSvc] Waiting for requests...\n\n")

    // Service loop — receive JSON, dispatch to Calc_JsonHandle, send reply
    WhileLoop EqualTo(CalcService.running, 1) {
        msg = Socket.RecvMsg(sock)
        IfCondition EqualTo(msg, 0) ThenBlock: {
            PrintMessage("[CalcSvc] Connection closed\n")
            CalcService.running = 0
        } ElseBlock: {
            CalcService.msg_handled = Add(CalcService.msg_handled, 1)

            // Check for shutdown
            parsed = ParseJSON(msg)
            IfCondition NotEqual(parsed, 0) ThenBlock: {
                pobj = JSON.AsObject(parsed)
                mstr = JSON.GetString(pobj, "method")
                IfCondition NotEqual(mstr, 0) ThenBlock: {
                    cmp_shut = StringCompare(mstr, "shutdown")
                    IfCondition EqualTo(cmp_shut, 0) ThenBlock: {
                        PrintMessage("[CalcSvc] Shutdown received\n")
                        CalcService.running = 0
                    }
                }
                JSON.Free(parsed)
            }

            // If not shutdown, dispatch to calculator
            IfCondition EqualTo(CalcService.running, 1) ThenBlock: {
                msg_len = StringLength(msg)
                resp = Calc_JsonHandle(msg, msg_len)
                IfCondition NotEqual(resp, 0) ThenBlock: {
                    Socket.SendMsg(sock, resp)
                } ElseBlock: {
                    // Send error response
                    Socket.SendMsg(sock, "{\"error\":\"calc failed\"}")
                }
            }
        }
    }

    Socket.Close(sock)

    PrintMessage("\n============================================\n")
    PrintMessage("  Calculator Service handled ")
    PrintNumber(CalcService.msg_handled)
    PrintMessage(" messages\n")
    PrintMessage("============================================\n")
}

RunTask(Main)
