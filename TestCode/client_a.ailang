// client_a.ailang
// Client A — the "display server" side
// Sends requests, receives responses from Client B via broker.
//
// Build: ./build.sh TestCode/client_a.ailang
// Run:   ./client_a.x  (after msg_broker.x is running)

LibraryImport.Arena
LibraryImport.Socket
LibraryImport.StringUtils
LibraryImport.JSON
LibraryImport.Arrays
LibraryImport.Hash

SubRoutine.Main {
    Arena_Init()

    PrintMessage("============================================\n")
    PrintMessage("  Client A — Requester\n")
    PrintMessage("============================================\n\n")

    sock_path = "/tmp/ailang_broker.sock"
    pass_count = 0
    fail_count = 0

    // Connect to broker
    sock = Socket.Create(1, 1)
    IfCondition LessThan(sock, 0) ThenBlock: {
        PrintMessage("[A] Socket create failed\n")
        HaltProgram
    }

    cres = Socket.ConnectUnix(sock, sock_path)
    IfCondition LessThan(cres, 0) ThenBlock: {
        PrintMessage("[A] Connect failed — is broker running?\n")
        Socket.Close(sock)
        HaltProgram
    }
    PrintMessage("[A] Connected to broker\n\n")

    // =========================================================================
    // TEST 1: PING
    // =========================================================================
    PrintMessage("[A] TEST 1: Sending PING...\n")
    obj1 = JSON.NewObject()
    JSON.SetString(obj1, "method", "ping")
    JSON.SetString(obj1, "from", "client_a")
    JSON.SetNumber(obj1, "seq", 1)
    json1 = JSON.SerializeObject(obj1)
    PrintMessage("[A] Send: ")
    PrintMessage(json1)
    PrintMessage("\n")
    Socket.SendMsg(sock, json1)

    // Wait for reply
    reply1 = Socket.RecvMsg(sock)
    IfCondition NotEqual(reply1, 0) ThenBlock: {
        PrintMessage("[A] Recv: ")
        PrintMessage(reply1)
        PrintMessage("\n")
        r1 = ParseJSON(reply1)
        r1obj = JSON.AsObject(r1)
        r1method = JSON.GetString(r1obj, "method")
        cmp1 = StringCompare(r1method, "pong")
        IfCondition EqualTo(cmp1, 0) ThenBlock: {
            PrintMessage("[A] PASS — got pong\n\n")
            pass_count = Add(pass_count, 1)
        } ElseBlock: {
            PrintMessage("[A] FAIL — expected pong\n\n")
            fail_count = Add(fail_count, 1)
        }
    } ElseBlock: {
        PrintMessage("[A] FAIL — no reply\n\n")
        fail_count = Add(fail_count, 1)
    }

    // =========================================================================
    // TEST 2: CALCULATE
    // =========================================================================
    PrintMessage("[A] TEST 2: Sending CALCULATE 25 + 17...\n")
    obj2 = JSON.NewObject()
    JSON.SetString(obj2, "method", "calculate")
    JSON.SetString(obj2, "from", "client_a")
    JSON.SetString(obj2, "op", "add")
    JSON.SetNumber(obj2, "a", 25)
    JSON.SetNumber(obj2, "b", 17)
    json2 = JSON.SerializeObject(obj2)
    PrintMessage("[A] Send: ")
    PrintMessage(json2)
    PrintMessage("\n")
    Socket.SendMsg(sock, json2)

    reply2 = Socket.RecvMsg(sock)
    IfCondition NotEqual(reply2, 0) ThenBlock: {
        PrintMessage("[A] Recv: ")
        PrintMessage(reply2)
        PrintMessage("\n")
        r2 = ParseJSON(reply2)
        r2obj = JSON.AsObject(r2)
        r2val = JSON.GetNumber(r2obj, "result")
        IfCondition EqualTo(r2val, 42) ThenBlock: {
            PrintMessage("[A] PASS — result is 42\n\n")
            pass_count = Add(pass_count, 1)
        } ElseBlock: {
            PrintMessage("[A] FAIL — expected 42 got ")
            PrintNumber(r2val)
            PrintMessage("\n\n")
            fail_count = Add(fail_count, 1)
        }
    } ElseBlock: {
        PrintMessage("[A] FAIL — no reply\n\n")
        fail_count = Add(fail_count, 1)
    }

    // =========================================================================
    // TEST 3: FILE LIST
    // =========================================================================
    PrintMessage("[A] TEST 3: Requesting file list...\n")
    obj3 = JSON.NewObject()
    JSON.SetString(obj3, "method", "file.list")
    JSON.SetString(obj3, "from", "client_a")
    JSON.SetNumber(obj3, "parent_id", 1)
    json3 = JSON.SerializeObject(obj3)
    PrintMessage("[A] Send: ")
    PrintMessage(json3)
    PrintMessage("\n")
    Socket.SendMsg(sock, json3)

    reply3 = Socket.RecvMsg(sock)
    IfCondition NotEqual(reply3, 0) ThenBlock: {
        PrintMessage("[A] Recv: ")
        PrintMessage(reply3)
        PrintMessage("\n")
        r3 = ParseJSON(reply3)
        r3obj = JSON.AsObject(r3)
        r3files = JSON.GetArray(r3obj, "files")
        IfCondition NotEqual(r3files, 0) ThenBlock: {
            fcount = Array.Size(r3files)
            PrintMessage("[A] Got ")
            PrintNumber(fcount)
            PrintMessage(" files\n")
            IfCondition EqualTo(fcount, 3) ThenBlock: {
                PrintMessage("[A] PASS — 3 files returned\n\n")
                pass_count = Add(pass_count, 1)
            } ElseBlock: {
                PrintMessage("[A] FAIL — expected 3 files\n\n")
                fail_count = Add(fail_count, 1)
            }
        } ElseBlock: {
            PrintMessage("[A] FAIL — no files array\n\n")
            fail_count = Add(fail_count, 1)
        }
    } ElseBlock: {
        PrintMessage("[A] FAIL — no reply\n\n")
        fail_count = Add(fail_count, 1)
    }

    // =========================================================================
    // TEST 4: ECHO (roundtrip integrity)
    // =========================================================================
    PrintMessage("[A] TEST 4: Echo with nested data...\n")
    obj4 = JSON.NewObject()
    JSON.SetString(obj4, "method", "echo")
    JSON.SetString(obj4, "from", "client_a")
    inner4 = JSON.NewObject()
    JSON.SetString(inner4, "compiler", "ailang")
    JSON.SetNumber(inner4, "year", 2026)
    JSON.SetObject(obj4, "payload", inner4)
    json4 = JSON.SerializeObject(obj4)
    PrintMessage("[A] Send: ")
    PrintMessage(json4)
    PrintMessage("\n")
    Socket.SendMsg(sock, json4)

    reply4 = Socket.RecvMsg(sock)
    IfCondition NotEqual(reply4, 0) ThenBlock: {
        PrintMessage("[A] Recv: ")
        PrintMessage(reply4)
        PrintMessage("\n")
        r4 = ParseJSON(reply4)
        r4obj = JSON.AsObject(r4)
        r4pay = JSON.GetObject(r4obj, "payload")
        IfCondition NotEqual(r4pay, 0) ThenBlock: {
            r4comp = JSON.GetString(r4pay, "compiler")
            cmp4 = StringCompare(r4comp, "ailang")
            r4year = JSON.GetNumber(r4pay, "year")
            IfCondition And(EqualTo(cmp4, 0), EqualTo(r4year, 2026)) ThenBlock: {
                PrintMessage("[A] PASS — nested data intact\n\n")
                pass_count = Add(pass_count, 1)
            } ElseBlock: {
                PrintMessage("[A] FAIL — data mismatch\n\n")
                fail_count = Add(fail_count, 1)
            }
        } ElseBlock: {
            PrintMessage("[A] FAIL — no payload\n\n")
            fail_count = Add(fail_count, 1)
        }
    }

    // =========================================================================
    // SHUTDOWN
    // =========================================================================
    PrintMessage("[A] Sending shutdown...\n")
    obj_shut = JSON.NewObject()
    JSON.SetString(obj_shut, "method", "shutdown")
    JSON.SetString(obj_shut, "from", "client_a")
    json_shut = JSON.SerializeObject(obj_shut)
    Socket.SendMsg(sock, json_shut)

    Socket.Close(sock)

    PrintMessage("\n============================================\n")
    PrintMessage("  Client A Results: ")
    PrintNumber(pass_count)
    PrintMessage(" passed, ")
    PrintNumber(fail_count)
    PrintMessage(" failed\n")
    PrintMessage("============================================\n")
}

RunTask(Main)