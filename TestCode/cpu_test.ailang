// cpu_test.ailang
// Test program for 6502 CPU and C64 Memory libraries
// Can run in WSL console - no framebuffer needed

LibraryImport.Arena
LibraryImport.C64Memory
LibraryImport.CPU6502

SubRoutine.Main {
    PrintMessage("=== 6502 CPU / C64 Memory Test ===\n\n")
    
    // Initialize memory
    PrintMessage("Initializing C64 memory...\n")
    result = C64Mem_Init()
    IfCondition EqualTo(result, 0) ThenBlock: {
        PrintMessage("Memory init failed!\n")
        HaltProgram
    }
    
    // Initialize CPU
    PrintMessage("Initializing 6502 CPU...\n")
    CPU_Init()
    
    // === TEST 1: Basic memory read/write ===
    PrintMessage("\n--- Test 1: Memory Read/Write ---\n")
    
    C64Mem_Write(0x0400, 0x41)  // Write 'A' to screen memory
    C64Mem_Write(0x0401, 0x42)  // Write 'B'
    C64Mem_Write(0x0402, 0x43)  // Write 'C'
    
    val = C64Mem_Read(0x0400)
    PrintMessage("Read $0400: $")
    PrintHex(val)
    PrintMessage(" (expected $41)\n")
    
    val = C64Mem_Read(0x0401)
    PrintMessage("Read $0401: $")
    PrintHex(val)
    PrintMessage(" (expected $42)\n")
    
    // === TEST 2: Zero page ===
    PrintMessage("\n--- Test 2: Zero Page ---\n")
    
    C64Mem_Write(0x00FB, 0xAA)
    C64Mem_Write(0x00FC, 0x55)
    
    val = C64Mem_Read(0x00FB)
    PrintMessage("ZP $FB: $")
    PrintHex(val)
    PrintMessage(" (expected $AA)\n")
    
    // === TEST 3: Hand-assemble a small program ===
    PrintMessage("\n--- Test 3: Execute Simple Program ---\n")
    PrintMessage("Program: LDA #$42, STA $0400, INX, INX, BRK\n\n")
    
    // Load program at $C000
    C64Mem_Write(0xC000, 0xA9)  // LDA #$42
    C64Mem_Write(0xC001, 0x42)
    C64Mem_Write(0xC002, 0x8D)  // STA $0400
    C64Mem_Write(0xC003, 0x00)
    C64Mem_Write(0xC004, 0x04)
    C64Mem_Write(0xC005, 0xE8)  // INX
    C64Mem_Write(0xC006, 0xE8)  // INX
    C64Mem_Write(0xC007, 0x00)  // BRK
    
    // Set BRK vector to halt location
    C64Mem_Write(0xFFFE, 0x00)
    C64Mem_Write(0xFFFF, 0x00)
    
    // Set PC and run
    CPU_SetPC(0xC000)
    
    PrintMessage("Initial state:\n")
    CPU_DumpState()
    
    // Execute with trace
    PrintMessage("\nExecuting with trace:\n")
    CPU_StepTrace()  // LDA #$42
    CPU_StepTrace()  // STA $0400
    CPU_StepTrace()  // INX
    CPU_StepTrace()  // INX
    
    // Check result
    val = C64Mem_Read(0x0400)
    PrintMessage("\nMemory $0400 after STA: $")
    PrintHex(val)
    PrintMessage(" (expected $42)\n")
    
    PrintMessage("X register: $")
    PrintHex(CPU.X)
    PrintMessage(" (expected $02)\n")
    
    // === TEST 4: Loop test ===
    PrintMessage("\n--- Test 4: Loop Test ---\n")
    PrintMessage("Program: Count from 0 to 5 in X\n\n")
    
    // LDX #$00
    // loop: INX
    //       CPX #$05
    //       BNE loop
    //       NOP (stop here - we'll just run enough cycles)
    
    C64Mem_Write(0xC000, 0xA2)  // LDX #$00
    C64Mem_Write(0xC001, 0x00)
    C64Mem_Write(0xC002, 0xE8)  // INX (loop)
    C64Mem_Write(0xC003, 0xE0)  // CPX #$05
    C64Mem_Write(0xC004, 0x05)
    C64Mem_Write(0xC005, 0xD0)  // BNE -5 (back to INX)
    C64Mem_Write(0xC006, 0xFB)  // -5 in two's complement
    C64Mem_Write(0xC007, 0xEA)  // NOP - stop point
    C64Mem_Write(0xC008, 0xEA)  // NOP
    C64Mem_Write(0xC009, 0xEA)  // NOP
    
    CPU_Init()
    CPU_SetPC(0xC000)
    
    // Run until halted (BRK will set halted via unknown vector)
    cycles = CPU_Run(1000)
    
    PrintMessage("After loop - X: $")
    PrintHex(CPU.X)
    PrintMessage(" (expected $05)\n")
    PrintMessage("Cycles used: ")
    PrintNumber(cycles)
    PrintMessage("\n")
    
    // === TEST 5: I/O area detection ===
    PrintMessage("\n--- Test 5: I/O Area ---\n")
    
    // Write to VIC-II border color register
    C64Mem_Write(0xD020, 0x06)  // Set border to blue
    PrintMessage("Wrote $06 to $D020 (VIC border color)\n")
    
    // Write to SID register
    C64Mem_Write(0xD400, 0x00)  // SID voice 1 freq lo
    PrintMessage("Wrote $00 to $D400 (SID freq lo)\n")
    
    // Color RAM
    C64Mem_Write(0xD800, 0x01)  // White
    val = C64Mem_Read(0xD800)
    PrintMessage("Color RAM $D800: $")
    PrintHex(val)
    PrintMessage(" (upper nybble is open bus)\n")
    
    // === TEST 6: Stack operations ===
    PrintMessage("\n--- Test 6: Stack Operations ---\n")
    
    C64Mem_Write(0xC000, 0xA9)  // LDA #$AA
    C64Mem_Write(0xC001, 0xAA)
    C64Mem_Write(0xC002, 0x48)  // PHA
    C64Mem_Write(0xC003, 0xA9)  // LDA #$55
    C64Mem_Write(0xC004, 0x55)
    C64Mem_Write(0xC005, 0x48)  // PHA
    C64Mem_Write(0xC006, 0x68)  // PLA (should get $55)
    C64Mem_Write(0xC007, 0x68)  // PLA (should get $AA)
    C64Mem_Write(0xC008, 0x00)  // BRK
    
    CPU_Init()
    CPU_SetPC(0xC000)
    CPU_Run(100)
    
    PrintMessage("A after two PLAs: $")
    PrintHex(CPU.A)
    PrintMessage(" (expected $AA)\n")
    PrintMessage("SP: $")
    PrintHex(CPU.SP)
    PrintMessage(" (expected $FF)\n")
    
    // === TEST 7: ADC/SBC ===
    PrintMessage("\n--- Test 7: ADC/SBC ---\n")
    
    // CLC, LDA #$50, ADC #$25 = $75
    C64Mem_Write(0xC000, 0x18)  // CLC
    C64Mem_Write(0xC001, 0xA9)  // LDA #$50
    C64Mem_Write(0xC002, 0x50)
    C64Mem_Write(0xC003, 0x69)  // ADC #$25
    C64Mem_Write(0xC004, 0x25)
    C64Mem_Write(0xC005, 0xEA)  // NOP
    
    CPU_Init()
    CPU_SetPC(0xC000)
    CPU_Run(50)
    
    PrintMessage("$50 + $25 = $")
    PrintHex(CPU.A)
    PrintMessage(" (expected $75)\n")
    
    // SEC, LDA #$50, SBC #$25 = $2B (because $50=80, $25=37, 80-37=43=$2B)
    C64Mem_Write(0xC000, 0x38)  // SEC
    C64Mem_Write(0xC001, 0xA9)  // LDA #$50
    C64Mem_Write(0xC002, 0x50)
    C64Mem_Write(0xC003, 0xE9)  // SBC #$25
    C64Mem_Write(0xC004, 0x25)
    C64Mem_Write(0xC005, 0xEA)  // NOP
    
    CPU_Init()
    CPU_SetPC(0xC000)
    CPU_Run(50)
    
    PrintMessage("$50 - $25 = $")
    PrintHex(CPU.A)
    PrintMessage(" (expected $2B, since $50=80, $25=37, 80-37=43=$2B)\n")
    
    // === CLEANUP ===
    PrintMessage("\n=== All Tests Complete ===\n")
    
    C64Mem_Shutdown()
}

RunTask(Main)