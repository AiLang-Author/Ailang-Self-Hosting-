LibraryImport.DiagnosticStore
LibraryImport.JSON
LibraryImport.Arrays
LibraryImport.StringUtils

// =============================================================================
// TEST STATE
// =============================================================================
FixedPool.T {
    "pass": Initialize=0, CanChange=True
    "fail": Initialize=0, CanChange=True
    "total": Initialize=0, CanChange=True
    "sec_pass": Initialize=0, CanChange=True
    "sec_total": Initialize=0, CanChange=True
    "name": Initialize=0, CanChange=True
    "exp_num": Initialize=0, CanChange=True
    "act_num": Initialize=0, CanChange=True
    "exp_str": Initialize=0, CanChange=True
    "act_str": Initialize=0, CanChange=True
    "sec_name": Initialize=0, CanChange=True
    "tagged": Initialize=0, CanChange=True
    "obj": Initialize=0, CanChange=True
    "str": Initialize=0, CanChange=True
    "tmp": Initialize=0, CanChange=True
    "tmp2": Initialize=0, CanChange=True
    "arr": Initialize=0, CanChange=True
    "child": Initialize=0, CanChange=True
}

// =============================================================================
// TEST HELPERS (same pattern as JSON test harness)
// =============================================================================
SubRoutine.CheckNum {
    T.total = Add(T.total, 1)
    T.sec_total = Add(T.sec_total, 1)
    PrintMessage("  TEST: ")
    PrintMessage(T.name)
    PrintMessage("\n    Expected: ")
    PrintNumber(T.exp_num)
    PrintMessage("  Actual: ")
    PrintNumber(T.act_num)
    IfCondition EqualTo(T.exp_num, T.act_num) ThenBlock: {
        PrintMessage("  [PASS]\n")
        T.pass = Add(T.pass, 1)
        T.sec_pass = Add(T.sec_pass, 1)
    } ElseBlock: {
        PrintMessage("  [FAIL]\n")
        T.fail = Add(T.fail, 1)
    }
}

SubRoutine.CheckStr {
    T.total = Add(T.total, 1)
    T.sec_total = Add(T.sec_total, 1)
    PrintMessage("  TEST: ")
    PrintMessage(T.name)
    PrintMessage("\n    Expected: '")
    PrintMessage(T.exp_str)
    PrintMessage("'\n    Actual:   '")
    PrintMessage(T.act_str)
    PrintMessage("'")
    cmp = StringCompare(T.exp_str, T.act_str)
    IfCondition EqualTo(cmp, 0) ThenBlock: {
        PrintMessage("  [PASS]\n")
        T.pass = Add(T.pass, 1)
        T.sec_pass = Add(T.sec_pass, 1)
    } ElseBlock: {
        PrintMessage("  [FAIL]\n")
        T.fail = Add(T.fail, 1)
    }
}

SubRoutine.Section {
    PrintMessage("--- Section ")
    PrintMessage(T.sec_name)
    PrintMessage(": ")
    PrintNumber(T.sec_pass)
    PrintMessage("/")
    PrintNumber(T.sec_total)
    PrintMessage(" passed ---\n\n")
    T.sec_pass = 0
    T.sec_total = 0
}

// =============================================================================
PrintMessage("========================================================\n")
PrintMessage("    DiagnosticStore - Test Suite\n")
PrintMessage("========================================================\n\n")

// =============================================================================
// SECTION 1: INIT & EMPTY STATE
// =============================================================================
PrintMessage("SECTION 1: Init & Empty State\n")
PrintMessage("========================================================\n")

SubRoutine.Test1_Init {
    DiagStore.Init()

    T.name = "Count after Init is 0"
    T.exp_num = 0
    T.act_num = DiagStore.Count()
    RunTask(CheckNum)

    T.name = "Get(0) on empty returns 0"
    T.exp_num = 0
    T.act_num = DiagStore.Get(0)
    RunTask(CheckNum)

    T.name = "Get(-1) returns 0"
    T.exp_num = 0
    T.act_num = DiagStore.Get(-1)
    RunTask(CheckNum)

    // ToJSON on empty
    T.str = DiagStore.ToJSON()
    T.name = "ToJSON empty returns []"
    T.exp_str = "[]"
    T.act_str = T.str
    RunTask(CheckStr)

    DiagStore.Cleanup()
}
RunTask(Test1_Init)
T.sec_name = "1 (Init)"
RunTask(Section)

// =============================================================================
// SECTION 2: ADD & READ BACK
// =============================================================================
PrintMessage("SECTION 2: Add & Read Back\n")
PrintMessage("========================================================\n")

SubRoutine.Test2_AddRead {
    DiagStore.Init()
    DiagStore.SetFile("main.ailang")

    DiagStore.Add(42, 8, DiagSeverity.WARNING, "unused-var", "Variable 'temp' assigned but never used")

    T.name = "Count after 1 Add"
    T.exp_num = 1
    T.act_num = DiagStore.Count()
    RunTask(CheckNum)

    // Read back the diagnostic
    T.tagged = DiagStore.Get(0)

    T.name = "Get(0) is not null"
    T.exp_num = 1
    IfCondition NotEqual(T.tagged, 0) ThenBlock: {
        T.act_num = 1
    } ElseBlock: {
        T.act_num = 0
    }
    RunTask(CheckNum)

    T.obj = JSON.AsObject(T.tagged)

    T.name = "file is 'main.ailang'"
    T.exp_str = "main.ailang"
    T.act_str = JSON.GetString(T.obj, "file")
    RunTask(CheckStr)

    T.name = "line is 42"
    T.exp_num = 42
    T.act_num = JSON.GetNumber(T.obj, "line")
    RunTask(CheckNum)

    T.name = "col is 8"
    T.exp_num = 8
    T.act_num = JSON.GetNumber(T.obj, "col")
    RunTask(CheckNum)

    T.name = "severity is WARNING (2)"
    T.exp_num = 2
    T.act_num = JSON.GetNumber(T.obj, "severity")
    RunTask(CheckNum)

    T.name = "code is 'unused-var'"
    T.exp_str = "unused-var"
    T.act_str = JSON.GetString(T.obj, "code")
    RunTask(CheckStr)

    T.name = "message is correct"
    T.exp_str = "Variable 'temp' assigned but never used"
    T.act_str = JSON.GetString(T.obj, "message")
    RunTask(CheckStr)

    DiagStore.Cleanup()
}
RunTask(Test2_AddRead)
T.sec_name = "2 (Add/Read)"
RunTask(Section)

// =============================================================================
// SECTION 3: ALL SEVERITY LEVELS
// =============================================================================
PrintMessage("SECTION 3: All Severity Levels\n")
PrintMessage("========================================================\n")

SubRoutine.Test3_Severities {
    DiagStore.Init()
    DiagStore.SetFile("test.ailang")

    DiagStore.Add(1, 0, DiagSeverity.ERROR, "syntax", "Unexpected token")
    DiagStore.Add(2, 0, DiagSeverity.WARNING, "unused", "Unused variable")
    DiagStore.Add(3, 0, DiagSeverity.INFO, "perf", "Consider inlining")
    DiagStore.Add(4, 0, DiagSeverity.HINT, "style", "Prefer explicit types")

    T.name = "Count is 4"
    T.exp_num = 4
    T.act_num = DiagStore.Count()
    RunTask(CheckNum)

    // Check each severity
    T.tagged = DiagStore.Get(0)
    T.obj = JSON.AsObject(T.tagged)
    T.name = "Diag 0 severity is ERROR (1)"
    T.exp_num = 1
    T.act_num = JSON.GetNumber(T.obj, "severity")
    RunTask(CheckNum)

    T.tagged = DiagStore.Get(1)
    T.obj = JSON.AsObject(T.tagged)
    T.name = "Diag 1 severity is WARNING (2)"
    T.exp_num = 2
    T.act_num = JSON.GetNumber(T.obj, "severity")
    RunTask(CheckNum)

    T.tagged = DiagStore.Get(2)
    T.obj = JSON.AsObject(T.tagged)
    T.name = "Diag 2 severity is INFO (3)"
    T.exp_num = 3
    T.act_num = JSON.GetNumber(T.obj, "severity")
    RunTask(CheckNum)

    T.tagged = DiagStore.Get(3)
    T.obj = JSON.AsObject(T.tagged)
    T.name = "Diag 3 severity is HINT (4)"
    T.exp_num = 4
    T.act_num = JSON.GetNumber(T.obj, "severity")
    RunTask(CheckNum)

    // Verify SeverityName helper
    T.name = "SeverityName(1) is 'error'"
    T.exp_str = "error"
    T.act_str = DiagStore.SeverityName(DiagSeverity.ERROR)
    RunTask(CheckStr)

    T.name = "SeverityName(2) is 'warning'"
    T.exp_str = "warning"
    T.act_str = DiagStore.SeverityName(DiagSeverity.WARNING)
    RunTask(CheckStr)

    T.name = "SeverityName(3) is 'info'"
    T.exp_str = "info"
    T.act_str = DiagStore.SeverityName(DiagSeverity.INFO)
    RunTask(CheckStr)

    T.name = "SeverityName(4) is 'hint'"
    T.exp_str = "hint"
    T.act_str = DiagStore.SeverityName(DiagSeverity.HINT)
    RunTask(CheckStr)

    DiagStore.Cleanup()
}
RunTask(Test3_Severities)
T.sec_name = "3 (Severities)"
RunTask(Section)

// =============================================================================
// SECTION 4: MULTIPLE FILES
// =============================================================================
PrintMessage("SECTION 4: Multiple Files\n")
PrintMessage("========================================================\n")

SubRoutine.Test4_MultiFile {
    DiagStore.Init()

    DiagStore.SetFile("lexer.ailang")
    DiagStore.Add(10, 1, DiagSeverity.ERROR, "lex-err", "Invalid character")

    DiagStore.SetFile("parser.ailang")
    DiagStore.Add(20, 5, DiagSeverity.WARNING, "parse-warn", "Ambiguous grammar")

    DiagStore.SetFile("codegen.ailang")
    DiagStore.Add(30, 0, DiagSeverity.INFO, "cg-info", "Emitting fallback path")

    T.name = "Count is 3"
    T.exp_num = 3
    T.act_num = DiagStore.Count()
    RunTask(CheckNum)

    // Verify each has correct file
    T.tagged = DiagStore.Get(0)
    T.obj = JSON.AsObject(T.tagged)
    T.name = "Diag 0 file is 'lexer.ailang'"
    T.exp_str = "lexer.ailang"
    T.act_str = JSON.GetString(T.obj, "file")
    RunTask(CheckStr)

    T.tagged = DiagStore.Get(1)
    T.obj = JSON.AsObject(T.tagged)
    T.name = "Diag 1 file is 'parser.ailang'"
    T.exp_str = "parser.ailang"
    T.act_str = JSON.GetString(T.obj, "file")
    RunTask(CheckStr)

    T.tagged = DiagStore.Get(2)
    T.obj = JSON.AsObject(T.tagged)
    T.name = "Diag 2 file is 'codegen.ailang'"
    T.exp_str = "codegen.ailang"
    T.act_str = JSON.GetString(T.obj, "file")
    RunTask(CheckStr)

    T.tagged = DiagStore.Get(1)
    T.obj = JSON.AsObject(T.tagged)
    T.name = "Diag 1 line is 20"
    T.exp_num = 20
    T.act_num = JSON.GetNumber(T.obj, "line")
    RunTask(CheckNum)

    DiagStore.Cleanup()
}
RunTask(Test4_MultiFile)
T.sec_name = "4 (MultiFile)"
RunTask(Section)

// =============================================================================
// SECTION 5: CLEAR & RE-ADD
// =============================================================================
PrintMessage("SECTION 5: Clear & Re-Add\n")
PrintMessage("========================================================\n")

SubRoutine.Test5_Clear {
    DiagStore.Init()
    DiagStore.SetFile("first.ailang")

    DiagStore.Add(1, 0, DiagSeverity.ERROR, "e1", "Error one")
    DiagStore.Add(2, 0, DiagSeverity.ERROR, "e2", "Error two")

    T.name = "Count before Clear is 2"
    T.exp_num = 2
    T.act_num = DiagStore.Count()
    RunTask(CheckNum)

    DiagStore.Clear()

    T.name = "Count after Clear is 0"
    T.exp_num = 0
    T.act_num = DiagStore.Count()
    RunTask(CheckNum)

    T.name = "Get(0) after Clear returns 0"
    T.exp_num = 0
    T.act_num = DiagStore.Get(0)
    RunTask(CheckNum)

    // Re-add after clear
    DiagStore.SetFile("second.ailang")
    DiagStore.Add(99, 1, DiagSeverity.WARNING, "w1", "Warning after clear")

    T.name = "Count after re-add is 1"
    T.exp_num = 1
    T.act_num = DiagStore.Count()
    RunTask(CheckNum)

    T.tagged = DiagStore.Get(0)
    T.obj = JSON.AsObject(T.tagged)
    T.name = "Re-added diag file is 'second.ailang'"
    T.exp_str = "second.ailang"
    T.act_str = JSON.GetString(T.obj, "file")
    RunTask(CheckStr)

    T.name = "Re-added diag line is 99"
    T.exp_num = 99
    T.act_num = JSON.GetNumber(T.obj, "line")
    RunTask(CheckNum)

    DiagStore.Cleanup()
}
RunTask(Test5_Clear)
T.sec_name = "5 (Clear)"
RunTask(Section)

// =============================================================================
// SECTION 6: ToJSON SERIALIZATION
// =============================================================================
PrintMessage("SECTION 6: ToJSON Serialization\n")
PrintMessage("========================================================\n")

SubRoutine.Test6_ToJSON {
    DiagStore.Init()
    DiagStore.SetFile("test.ailang")

    DiagStore.Add(10, 2, DiagSeverity.ERROR, "err1", "First error")
    DiagStore.Add(20, 4, DiagSeverity.WARNING, "warn1", "First warning")

    T.str = DiagStore.ToJSON()
    PrintMessage("  ToJSON output: ")
    PrintMessage(T.str)
    PrintMessage("\n")

    // Should be non-empty and start with [
    slen = StringLength(T.str)
    T.name = "ToJSON length > 2"
    T.exp_num = 1
    IfCondition GreaterThan(slen, 2) ThenBlock: {
        T.act_num = 1
    } ElseBlock: {
        T.act_num = 0
    }
    RunTask(CheckNum)

    // Parse it back
    T.tagged = ParseJSON(T.str)
    T.arr = JSON.AsArray(T.tagged)

    T.name = "Parsed array size is 2"
    T.exp_num = 2
    T.act_num = Array.Size(T.arr)
    RunTask(CheckNum)

    // Verify first diagnostic from parsed JSON
    T.tmp = Array.Get(T.arr, 0)
    T.obj = JSON.AsObject(T.tmp)

    T.name = "Parsed diag[0] line is 10"
    T.exp_num = 10
    T.act_num = JSON.GetNumber(T.obj, "line")
    RunTask(CheckNum)

    T.name = "Parsed diag[0] code is 'err1'"
    T.exp_str = "err1"
    T.act_str = JSON.GetString(T.obj, "code")
    RunTask(CheckStr)

    T.name = "Parsed diag[0] severity is 1"
    T.exp_num = 1
    T.act_num = JSON.GetNumber(T.obj, "severity")
    RunTask(CheckNum)

    // Verify second diagnostic
    T.tmp = Array.Get(T.arr, 1)
    T.obj = JSON.AsObject(T.tmp)

    T.name = "Parsed diag[1] line is 20"
    T.exp_num = 20
    T.act_num = JSON.GetNumber(T.obj, "line")
    RunTask(CheckNum)

    T.name = "Parsed diag[1] message is 'First warning'"
    T.exp_str = "First warning"
    T.act_str = JSON.GetString(T.obj, "message")
    RunTask(CheckStr)

    DiagStore.Cleanup()
}
RunTask(Test6_ToJSON)
T.sec_name = "6 (ToJSON)"
RunTask(Section)

// =============================================================================
// SECTION 7: ROUNDTRIP (Add -> ToJSON -> ParseJSON -> Read)
// =============================================================================
PrintMessage("SECTION 7: Roundtrip\n")
PrintMessage("========================================================\n")

SubRoutine.Test7_Roundtrip {
    DiagStore.Init()
    DiagStore.SetFile("roundtrip.ailang")

    DiagStore.Add(100, 15, DiagSeverity.ERROR, "memory-leak", "Allocate without matching Deallocate")
    DiagStore.Add(200, 0, DiagSeverity.WARNING, "dead-code", "Unreachable block after ReturnValue")
    DiagStore.Add(300, 3, DiagSeverity.HINT, "naming", "Consider descriptive variable name")

    T.str = DiagStore.ToJSON()
    PrintMessage("  Roundtrip JSON: ")
    PrintMessage(T.str)
    PrintMessage("\n")

    // Parse back
    T.tagged = ParseJSON(T.str)
    T.arr = JSON.AsArray(T.tagged)

    T.name = "Roundtrip array size is 3"
    T.exp_num = 3
    T.act_num = Array.Size(T.arr)
    RunTask(CheckNum)

    // Check diagnostic 0
    T.tmp = Array.Get(T.arr, 0)
    T.obj = JSON.AsObject(T.tmp)
    T.name = "RT diag[0] file"
    T.exp_str = "roundtrip.ailang"
    T.act_str = JSON.GetString(T.obj, "file")
    RunTask(CheckStr)

    T.name = "RT diag[0] line"
    T.exp_num = 100
    T.act_num = JSON.GetNumber(T.obj, "line")
    RunTask(CheckNum)

    T.name = "RT diag[0] col"
    T.exp_num = 15
    T.act_num = JSON.GetNumber(T.obj, "col")
    RunTask(CheckNum)

    T.name = "RT diag[0] code"
    T.exp_str = "memory-leak"
    T.act_str = JSON.GetString(T.obj, "code")
    RunTask(CheckStr)

    // Check diagnostic 2
    T.tmp = Array.Get(T.arr, 2)
    T.obj = JSON.AsObject(T.tmp)
    T.name = "RT diag[2] severity is HINT (4)"
    T.exp_num = 4
    T.act_num = JSON.GetNumber(T.obj, "severity")
    RunTask(CheckNum)

    T.name = "RT diag[2] message"
    T.exp_str = "Consider descriptive variable name"
    T.act_str = JSON.GetString(T.obj, "message")
    RunTask(CheckStr)

    DiagStore.Cleanup()
}
RunTask(Test7_Roundtrip)
T.sec_name = "7 (Roundtrip)"
RunTask(Section)

// =============================================================================
// SECTION 8: CONSOLE OUTPUT (visual check, no assertions)
// =============================================================================
PrintMessage("SECTION 8: Console Output (visual)\n")
PrintMessage("========================================================\n")

SubRoutine.Test8_Console {
    DiagStore.Init()
    DiagStore.SetFile("demo.ailang")

    DiagStore.Add(5, 1, DiagSeverity.ERROR, "syntax", "Unexpected '}'")
    DiagStore.Add(12, 0, DiagSeverity.WARNING, "unused-var", "Variable 'x' never read")
    DiagStore.Add(30, 10, DiagSeverity.INFO, "perf", "Loop could be unrolled")
    DiagStore.Add(45, 0, DiagSeverity.HINT, "style", "Trailing whitespace")

    PrintMessage("  --- Console output below ---\n")
    DiagStore.PrintConsole()
    PrintMessage("  --- End console output ---\n")

    // Just verify count as sanity check
    T.name = "Console test count is 4"
    T.exp_num = 4
    T.act_num = DiagStore.Count()
    RunTask(CheckNum)

    DiagStore.Cleanup()
}
RunTask(Test8_Console)
T.sec_name = "8 (Console)"
RunTask(Section)

// =============================================================================
// SECTION 9: NO FILE SET (default "unknown")
// =============================================================================
PrintMessage("SECTION 9: No File Set\n")
PrintMessage("========================================================\n")

SubRoutine.Test9_NoFile {
    DiagStore.Init()
    // Intentionally do NOT call SetFile

    DiagStore.Add(1, 0, DiagSeverity.ERROR, "test", "No file set")

    T.tagged = DiagStore.Get(0)
    T.obj = JSON.AsObject(T.tagged)
    T.name = "File defaults to 'unknown'"
    T.exp_str = "unknown"
    T.act_str = JSON.GetString(T.obj, "file")
    RunTask(CheckStr)

    DiagStore.Cleanup()
}
RunTask(Test9_NoFile)
T.sec_name = "9 (NoFile)"
RunTask(Section)

// =============================================================================
// SECTION 10: CLEANUP (no crash)
// =============================================================================
PrintMessage("SECTION 10: Cleanup\n")
PrintMessage("========================================================\n")

SubRoutine.Test10_Cleanup {
    DiagStore.Init()
    DiagStore.SetFile("cleanup.ailang")
    DiagStore.Add(1, 0, DiagSeverity.ERROR, "e", "test")
    DiagStore.Add(2, 0, DiagSeverity.WARNING, "w", "test")
    DiagStore.Add(3, 0, DiagSeverity.INFO, "i", "test")
    DiagStore.Cleanup()

    // Double cleanup should not crash
    DiagStore.Cleanup()

    T.name = "Double Cleanup no crash"
    T.exp_num = 1
    T.act_num = 1
    RunTask(CheckNum)

    // Re-init after cleanup should work
    DiagStore.Init()
    DiagStore.Add(1, 0, DiagSeverity.HINT, "h", "after cleanup")
    T.name = "Re-Init after Cleanup, count is 1"
    T.exp_num = 1
    T.act_num = DiagStore.Count()
    RunTask(CheckNum)

    DiagStore.Cleanup()
}
RunTask(Test10_Cleanup)
T.sec_name = "10 (Cleanup)"
RunTask(Section)

// =============================================================================
// FINAL SUMMARY
// =============================================================================
PrintMessage("========================================================\n")
PrintMessage("    FINAL RESULTS\n")
PrintMessage("========================================================\n")
PrintMessage("  Total:  ")
PrintNumber(T.total)
PrintMessage("\n  Passed: ")
PrintNumber(T.pass)
PrintMessage("\n  Failed: ")
PrintNumber(T.fail)
PrintMessage("\n")

IfCondition EqualTo(T.fail, 0) ThenBlock: {
    PrintMessage("\n  ALL TESTS PASSED\n")
} ElseBlock: {
    PrintMessage("\n  FAILURES DETECTED - Review above\n")
}
PrintMessage("========================================================\n")