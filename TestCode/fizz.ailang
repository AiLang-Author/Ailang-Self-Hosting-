LibraryImport.AIMacro.AIMacro
LibraryImport.AIMacro.AIMacroString
LibraryImport.TArrays
LibraryImport.AIMacro.AIMacroTypes
LibraryImport.Hash
LibraryImport.AIMacro.AIMacroDict
LibraryImport.OOP
LibraryImport.HashMap


Function.fizzbuzz {
    Input: p_n: Integer
    Body: {
        i = 1
        WhileLoop LessEqual(i, p_n) {
            IfCondition EqualTo(Modulo(i, 15), 0) ThenBlock: {
                PrintMessage("FizzBuzz")
                PrintMessage("\n")
            } ElseBlock: {
                IfCondition EqualTo(Modulo(i, 3), 0) ThenBlock: {
                    PrintMessage("Fizz")
                    PrintMessage("\n")
                } ElseBlock: {
                    IfCondition EqualTo(Modulo(i, 5), 0) ThenBlock: {
                        PrintMessage("Buzz")
                        PrintMessage("\n")
                    } ElseBlock: {
                        AIMacro.SmartPrint(i)
                        PrintMessage("\n")
                    }
                }
            }
            i = Add(i, 1)
        }
    }
}

SubRoutine.Main {
        fizzbuzz(30)
                ProcessExit(0)
}


RunTask(Main)
