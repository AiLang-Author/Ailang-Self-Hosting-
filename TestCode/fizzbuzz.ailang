LibraryImport.OOP
LibraryImport.Hash


Function.fizzbuzz {
    Input: p_n: Integer
    Body: {
        i = 
        WhileLoop LessEqual(i, p_n) {
            IfCondition EqualTo(Modulo(i, ), ) ThenBlock: {
                PrintMessage("FizzBuzz")
                PrintMessage("\n")
            } ElseBlock: {
                IfCondition EqualTo(Modulo(i, ), ) ThenBlock: {
                    PrintMessage("Fizz")
                    PrintMessage("\n")
                } ElseBlock: {
                    IfCondition EqualTo(Modulo(i, ), ) ThenBlock: {
                        PrintMessage("Buzz")
                        PrintMessage("\n")
                    } ElseBlock: {
                        AIMacro.SmartPrint(i)
                        PrintMessage("\n")
                    }
                }
            }
            i = Add(i, )
        }
    }
}

SubRoutine.Main {
        fizzbuzz()
                ProcessExit(0)
}


RunTask(Main)
