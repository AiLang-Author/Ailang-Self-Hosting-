// html5lib_harness.ailang — Tokenizer harness for html5lib-tests conformance
// Reads /tmp/html5lib_current.html, tokenizes via HTMLTokenizer, prints tokens.
//
// Build: ./ailang.x TestCode/html5lib_harness.ailang html5lib_harness.x
// Run:   (called by tools/html5lib_runner.py)
//
// Copyright (c) 2026 Sean Collins, 2 Paws Machine and Engineering. SCSL.

LibraryImport.Arena
LibraryImport.StringUtils
LibraryImport.Browser.HTMLTokenizer

FixedPool.H5Sys {
    "SYS_EXIT":  Initialize=60
}

// Clobber-safe storage for the print loop
FixedPool.H5Tmp {
    "ttype": Initialize=0
    "ptr":   Initialize=0
    "idx":   Initialize=0
    "count": Initialize=0
    "matched": Initialize=0
}

Function.H5_PrintToken {
    Output: Integer
    Body: {
        H5Tmp.matched = 0

        IfCondition EqualTo(H5Tmp.ttype, HTKType.TAG_OPEN) ThenBlock: {
            PrintMessage("1|")
            IfCondition NotEqual(H5Tmp.ptr, 0) ThenBlock: { PrintMessage(H5Tmp.ptr) }
            PrintMessage("\n")
            H5Tmp.matched = 1
        }
        IfCondition And(EqualTo(H5Tmp.ttype, HTKType.TAG_CLOSE), EqualTo(H5Tmp.matched, 0)) ThenBlock: {
            PrintMessage("2|")
            IfCondition NotEqual(H5Tmp.ptr, 0) ThenBlock: { PrintMessage(H5Tmp.ptr) }
            PrintMessage("\n")
            H5Tmp.matched = 1
        }
        IfCondition And(EqualTo(H5Tmp.ttype, HTKType.TAG_SELF_CLOSE), EqualTo(H5Tmp.matched, 0)) ThenBlock: {
            PrintMessage("3|\n")
            H5Tmp.matched = 1
        }
        IfCondition And(EqualTo(H5Tmp.ttype, HTKType.TAG_END), EqualTo(H5Tmp.matched, 0)) ThenBlock: {
            PrintMessage("4|\n")
            H5Tmp.matched = 1
        }
        IfCondition And(EqualTo(H5Tmp.ttype, HTKType.ATTR_NAME), EqualTo(H5Tmp.matched, 0)) ThenBlock: {
            PrintMessage("5|")
            IfCondition NotEqual(H5Tmp.ptr, 0) ThenBlock: { PrintMessage(H5Tmp.ptr) }
            PrintMessage("\n")
            H5Tmp.matched = 1
        }
        IfCondition And(EqualTo(H5Tmp.ttype, HTKType.ATTR_VALUE), EqualTo(H5Tmp.matched, 0)) ThenBlock: {
            PrintMessage("6|")
            IfCondition NotEqual(H5Tmp.ptr, 0) ThenBlock: { PrintMessage(H5Tmp.ptr) }
            PrintMessage("\n")
            H5Tmp.matched = 1
        }
        IfCondition And(EqualTo(H5Tmp.ttype, HTKType.ATTR_BARE), EqualTo(H5Tmp.matched, 0)) ThenBlock: {
            PrintMessage("7|")
            IfCondition NotEqual(H5Tmp.ptr, 0) ThenBlock: { PrintMessage(H5Tmp.ptr) }
            PrintMessage("\n")
            H5Tmp.matched = 1
        }
        IfCondition And(EqualTo(H5Tmp.ttype, HTKType.TEXT), EqualTo(H5Tmp.matched, 0)) ThenBlock: {
            PrintMessage("8|")
            IfCondition NotEqual(H5Tmp.ptr, 0) ThenBlock: { PrintMessage(H5Tmp.ptr) }
            PrintMessage("\n")
            H5Tmp.matched = 1
        }
        IfCondition And(EqualTo(H5Tmp.ttype, HTKType.COMMENT), EqualTo(H5Tmp.matched, 0)) ThenBlock: {
            PrintMessage("9|")
            IfCondition NotEqual(H5Tmp.ptr, 0) ThenBlock: { PrintMessage(H5Tmp.ptr) }
            PrintMessage("\n")
            H5Tmp.matched = 1
        }
        IfCondition And(EqualTo(H5Tmp.ttype, HTKType.DOCTYPE), EqualTo(H5Tmp.matched, 0)) ThenBlock: {
            PrintMessage("10|")
            IfCondition NotEqual(H5Tmp.ptr, 0) ThenBlock: { PrintMessage(H5Tmp.ptr) }
            PrintMessage("\n")
            H5Tmp.matched = 1
        }
        IfCondition And(EqualTo(H5Tmp.ttype, HTKType.EOF), EqualTo(H5Tmp.matched, 0)) ThenBlock: {
            PrintMessage("11|\n")
        }
        ReturnValue(0)
    }
}

SubRoutine.Main {
    Arena_Init()
    HTK_Init()

    content = ReadTextFile("/tmp/html5lib_current.html")
    IfCondition EqualTo(content, 0) ThenBlock: {
        SystemCall(H5Sys.SYS_EXIT, 2, 0, 0, 0, 0)
    }

    len = StringLength(content)
    HTK_Reset()
    result = HTK_Tokenize(content, len)

    IfCondition EqualTo(result, 0) ThenBlock: {
        PrintMessage("ERROR\n")
        SystemCall(H5Sys.SYS_EXIT, 1, 0, 0, 0, 0)
    }

    H5Tmp.count = HTK_Count()
    H5Tmp.idx = 0

    WhileLoop LessThan(H5Tmp.idx, H5Tmp.count) {
        H5Tmp.ttype = HTK_GetType(H5Tmp.idx)
        H5Tmp.ptr = HTK_GetPtr(H5Tmp.idx)
        H5_PrintToken()
        H5Tmp.idx = Add(H5Tmp.idx, 1)
    }

    SystemCall(H5Sys.SYS_EXIT, 0, 0, 0, 0, 0)
}

RunTask(Main)
