// json_ipc_test.ailang
// Two clients exchanging JSON messages over MessagePort
// Simulates the app launch IPC pattern:
//   Client A = display server (sends commands)
//   Client B = app service (receives, processes, replies)
//
// Build & Run:
//   ./build.sh TestCode/json_ipc_test.ailang && ./json_ipc_test.x

LibraryImport.Arena
LibraryImport.HashMap
LibraryImport.XArrays
LibraryImport.StringUtils
LibraryImport.JSON
LibraryImport.MessageTypes
LibraryImport.MessagePort

// =============================================================================
// PROTOCOL CONSTANTS
// =============================================================================
FixedPool.IPCCmd {
    "PING":       Initialize=1
    "CALCULATE":  Initialize=2
    "FILE_LIST":  Initialize=3
    "REPLY":      Initialize=100
    "ERROR":      Initialize=999
}

// Port name hashes (arbitrary unique values)
FixedPool.PortNames {
    "SERVER":  Initialize=1001
    "APP":     Initialize=1002
}

// =============================================================================
// TEST STATE
// =============================================================================
FixedPool.IPC {
    "server_port": Initialize=0
    "app_port":    Initialize=0
    "pass":        Initialize=0
    "fail":        Initialize=0
    "total":       Initialize=0
}

// =============================================================================
// HELPERS
// =============================================================================

// Build a JSON string and attach it as the envelope payload
Function.IPC_SendJSON {
    Input: target_port: Integer
    Input: source_port: Integer
    Input: what: Integer
    Input: json_str: Address
    Output: Integer
    Body: {
        env = AllocateLinkage(LinkagePool.MsgEnvelope)
        IfCondition EqualTo(env, 0) ThenBlock: {
            PrintMessage("[IPC] envelope alloc failed\n")
            ReturnValue(0)
        }

        env@what = what
        env@protocol = 0
        env@source_port = source_port
        env@target_port = target_port
        env@seq = 0
        env@field_count = 0
        env@payload = json_str
        env@next = 0

        ok = Port_Send(target_port, env)
        ReturnValue(ok)
    }
}

// Receive an envelope, extract and parse the JSON payload
Function.IPC_RecvJSON {
    Input: port_id: Integer
    Output: Address
    Body: {
        env = Port_Receive(port_id)
        IfCondition EqualTo(env, 0) ThenBlock: {
            ReturnValue(0)
        }

        json_str = Env_GetPayload(env)
        what = Env_GetWhat(env)
        source = Dereference(Add(env, MsgEnvOfs.SOURCE_PORT))

        // Parse the JSON
        parsed = 0
        IfCondition NotEqual(json_str, 0) ThenBlock: {
            parsed = ParseJSON(json_str)
        }

        // Build a result object with metadata + parsed data
        result = JSON.NewObject()
        JSON.SetNumber(result, "what", what)
        JSON.SetNumber(result, "source", source)

        IfCondition NotEqual(parsed, 0) ThenBlock: {
            ptype = JSON.TagType(parsed)
            IfCondition EqualTo(ptype, JType.OBJECT) ThenBlock: {
                JSON.SetObject(result, "data", JSON.AsObject(parsed))
            }
        }

        ReturnValue(result)
    }
}

// =============================================================================
// CHECK HELPER
// =============================================================================
Function.IPC_Check {
    Input: name: Address
    Input: expected: Integer
    Input: actual: Integer
    Body: {
        IPC.total = Add(IPC.total, 1)
        PrintMessage("  TEST: ")
        PrintMessage(name)
        PrintMessage(" — expected=")
        PrintNumber(expected)
        PrintMessage(" actual=")
        PrintNumber(actual)
        IfCondition EqualTo(expected, actual) ThenBlock: {
            PrintMessage(" [PASS]\n")
            IPC.pass = Add(IPC.pass, 1)
        } ElseBlock: {
            PrintMessage(" [FAIL]\n")
            IPC.fail = Add(IPC.fail, 1)
        }
    }
}

Function.IPC_CheckStr {
    Input: name: Address
    Input: expected: Address
    Input: actual: Address
    Body: {
        IPC.total = Add(IPC.total, 1)
        PrintMessage("  TEST: ")
        PrintMessage(name)
        PrintMessage(" — expected='")
        PrintMessage(expected)
        PrintMessage("' actual='")
        IfCondition NotEqual(actual, 0) ThenBlock: {
            PrintMessage(actual)
        } ElseBlock: {
            PrintMessage("(null)")
        }
        PrintMessage("'")
        cmp = StringCompare(expected, actual)
        IfCondition EqualTo(cmp, 0) ThenBlock: {
            PrintMessage(" [PASS]\n")
            IPC.pass = Add(IPC.pass, 1)
        } ElseBlock: {
            PrintMessage(" [FAIL]\n")
            IPC.fail = Add(IPC.fail, 1)
        }
    }
}

// =============================================================================
// MAIN TEST
// =============================================================================
SubRoutine.Main {
    Arena_Init()

    PrintMessage("============================================\n")
    PrintMessage("  JSON over MessagePort — IPC Test\n")
    PrintMessage("============================================\n\n")

    // --- Init message system ---
    RunTask(Port_Init)

    // --- Create two ports ---
    IPC.server_port = Port_Create(PortNames.SERVER, 16)
    IPC.app_port = Port_Create(PortNames.APP, 16)

    PrintMessage("[SETUP] server port=")
    PrintNumber(IPC.server_port)
    PrintMessage(" app port=")
    PrintNumber(IPC.app_port)
    PrintMessage("\n\n")

    // =========================================================================
    // TEST 1: Simple PING — server sends, app receives
    // =========================================================================
    PrintMessage("[TEST 1] PING: server → app\n")

    // Server builds JSON command
    ping_obj = JSON.NewObject()
    JSON.SetString(ping_obj, "method", "ping")
    JSON.SetNumber(ping_obj, "seq", 1)
    ping_json = JSON.SerializeObject(ping_obj)

    PrintMessage("  Sending: ")
    PrintMessage(ping_json)
    PrintMessage("\n")

    IPC_SendJSON(IPC.app_port, IPC.server_port, IPCCmd.PING, ping_json)

    // App receives and parses
    msg = IPC_RecvJSON(IPC.app_port)
    IfCondition NotEqual(msg, 0) ThenBlock: {
        IPC_Check("what is PING", IPCCmd.PING, JSON.GetNumber(msg, "what"))
        IPC_Check("source is server", IPC.server_port, JSON.GetNumber(msg, "source"))

        data = JSON.GetObject(msg, "data")
        IfCondition NotEqual(data, 0) ThenBlock: {
            IPC_CheckStr("method is ping", "ping", JSON.GetString(data, "method"))
            IPC_Check("seq is 1", 1, JSON.GetNumber(data, "seq"))
        }
    } ElseBlock: {
        PrintMessage("  [FAIL] no message received\n")
        IPC.fail = Add(IPC.fail, 1)
    }

    // =========================================================================
    // TEST 2: CALCULATE — server sends, app replies
    // =========================================================================
    PrintMessage("\n[TEST 2] CALCULATE: server → app → server\n")

    // Server sends calculate request
    calc_obj = JSON.NewObject()
    JSON.SetString(calc_obj, "method", "calculate")
    JSON.SetNumber(calc_obj, "a", 25)
    JSON.SetNumber(calc_obj, "b", 17)
    JSON.SetString(calc_obj, "op", "add")
    calc_json = JSON.SerializeObject(calc_obj)

    PrintMessage("  Request: ")
    PrintMessage(calc_json)
    PrintMessage("\n")

    IPC_SendJSON(IPC.app_port, IPC.server_port, IPCCmd.CALCULATE, calc_json)

    // App receives
    req = IPC_RecvJSON(IPC.app_port)
    IfCondition NotEqual(req, 0) ThenBlock: {
        req_data = JSON.GetObject(req, "data")
        a = JSON.GetNumber(req_data, "a")
        b = JSON.GetNumber(req_data, "b")
        result = Add(a, b)

        PrintMessage("  App computed: ")
        PrintNumber(a)
        PrintMessage(" + ")
        PrintNumber(b)
        PrintMessage(" = ")
        PrintNumber(result)
        PrintMessage("\n")

        // App sends reply back to server
        reply_obj = JSON.NewObject()
        JSON.SetString(reply_obj, "method", "result")
        JSON.SetNumber(reply_obj, "value", result)
        JSON.SetNumber(reply_obj, "seq", 1)
        reply_json = JSON.SerializeObject(reply_obj)

        PrintMessage("  Reply: ")
        PrintMessage(reply_json)
        PrintMessage("\n")

        src = JSON.GetNumber(req, "source")
        IPC_SendJSON(src, IPC.app_port, IPCCmd.REPLY, reply_json)
    }

    // Server receives reply
    reply = IPC_RecvJSON(IPC.server_port)
    IfCondition NotEqual(reply, 0) ThenBlock: {
        IPC_Check("reply what is REPLY", IPCCmd.REPLY, JSON.GetNumber(reply, "what"))
        IPC_Check("reply source is app", IPC.app_port, JSON.GetNumber(reply, "source"))

        rdata = JSON.GetObject(reply, "data")
        IfCondition NotEqual(rdata, 0) ThenBlock: {
            IPC_Check("result is 42", 42, JSON.GetNumber(rdata, "value"))
            IPC_CheckStr("method is result", "result", JSON.GetString(rdata, "method"))
        }
    } ElseBlock: {
        PrintMessage("  [FAIL] no reply received\n")
        IPC.fail = Add(IPC.fail, 1)
    }

    // =========================================================================
    // TEST 3: FILE_LIST — structured data roundtrip
    // =========================================================================
    PrintMessage("\n[TEST 3] FILE_LIST: structured response\n")

    // Server requests file listing
    flist_obj = JSON.NewObject()
    JSON.SetString(flist_obj, "method", "file.list")
    JSON.SetNumber(flist_obj, "parent_id", 1)
    flist_json = JSON.SerializeObject(flist_obj)

    IPC_SendJSON(IPC.app_port, IPC.server_port, IPCCmd.FILE_LIST, flist_json)

    // App receives, builds response with array of files
    freq = IPC_RecvJSON(IPC.app_port)
    IfCondition NotEqual(freq, 0) ThenBlock: {
        // Build file list response
        files_arr = JSON.NewArray()

        f1 = JSON.NewObject()
        JSON.SetString(f1, "name", "home")
        JSON.SetString(f1, "type", "dir")
        JSON.PushObject(files_arr, f1)

        f2 = JSON.NewObject()
        JSON.SetString(f2, "name", "etc")
        JSON.SetString(f2, "type", "dir")
        JSON.PushObject(files_arr, f2)

        f3 = JSON.NewObject()
        JSON.SetString(f3, "name", "readme.txt")
        JSON.SetString(f3, "type", "file")
        JSON.SetNumber(f3, "size", 1024)
        JSON.PushObject(files_arr, f3)

        fresp = JSON.NewObject()
        JSON.SetString(fresp, "method", "file.list.result")
        JSON.SetNumber(fresp, "parent_id", 1)
        JSON.SetArray(fresp, "files", files_arr)
        fresp_json = JSON.SerializeObject(fresp)

        PrintMessage("  Response: ")
        PrintMessage(fresp_json)
        PrintMessage("\n")

        fsrc = JSON.GetNumber(freq, "source")
        IPC_SendJSON(fsrc, IPC.app_port, IPCCmd.REPLY, fresp_json)
    }

    // Server receives file listing
    freply = IPC_RecvJSON(IPC.server_port)
    IfCondition NotEqual(freply, 0) ThenBlock: {
        frdata = JSON.GetObject(freply, "data")
        IfCondition NotEqual(frdata, 0) ThenBlock: {
            IPC_CheckStr("method", "file.list.result", JSON.GetString(frdata, "method"))
            IPC_Check("parent_id", 1, JSON.GetNumber(frdata, "parent_id"))

            farr = JSON.GetArray(frdata, "files")
            IfCondition NotEqual(farr, 0) ThenBlock: {
                IPC_Check("file count", 3, XArray.XSize(farr))

                // Check first file
                fentry = XArray.XGet(farr, 0)
                fe_obj = JSON.AsObject(fentry)
                IPC_CheckStr("files[0].name", "home", JSON.GetString(fe_obj, "name"))
                IPC_CheckStr("files[0].type", "dir", JSON.GetString(fe_obj, "type"))

                // Check third file (has size)
                fentry3 = XArray.XGet(farr, 2)
                fe3_obj = JSON.AsObject(fentry3)
                IPC_CheckStr("files[2].name", "readme.txt", JSON.GetString(fe3_obj, "name"))
                IPC_Check("files[2].size", 1024, JSON.GetNumber(fe3_obj, "size"))
            }
        }
    } ElseBlock: {
        PrintMessage("  [FAIL] no file list reply\n")
        IPC.fail = Add(IPC.fail, 1)
    }

    // =========================================================================
    // TEST 4: Multiple messages queued, drained in order
    // =========================================================================
    PrintMessage("\n[TEST 4] Queue: 5 messages, FIFO drain\n")

    qi = 0
    WhileLoop LessThan(qi, 5) {
        q_obj = JSON.NewObject()
        JSON.SetString(q_obj, "method", "tick")
        JSON.SetNumber(q_obj, "seq", qi)
        q_json = JSON.SerializeObject(q_obj)
        IPC_SendJSON(IPC.app_port, IPC.server_port, IPCCmd.PING, q_json)
        qi = Add(qi, 1)
    }

    IPC_Check("queue count", 5, Port_Count(IPC.app_port))

    // Drain and verify order
    di = 0
    WhileLoop LessThan(di, 5) {
        dmsg = IPC_RecvJSON(IPC.app_port)
        IfCondition NotEqual(dmsg, 0) ThenBlock: {
            ddata = JSON.GetObject(dmsg, "data")
            dseq = JSON.GetNumber(ddata, "seq")
            IPC_Check("FIFO order", di, dseq)
        }
        di = Add(di, 1)
    }

    IPC_Check("queue empty after drain", 1, Port_IsEmpty(IPC.app_port))

    // =========================================================================
    // TEST 5: Port resolution by name hash
    // =========================================================================
    PrintMessage("\n[TEST 5] Port resolution\n")

    resolved = Port_Resolve(PortNames.APP)
    IPC_Check("resolve APP hash", IPC.app_port, resolved)

    resolved2 = Port_Resolve(PortNames.SERVER)
    IPC_Check("resolve SERVER hash", IPC.server_port, resolved2)

    // =========================================================================
    // CLEANUP + SUMMARY
    // =========================================================================
    PrintMessage("\n--- Cleanup ---\n")
    Port_Destroy(IPC.app_port)
    Port_Destroy(IPC.server_port)
    PrintMessage("[OK] Ports destroyed\n\n")

    PrintMessage("============================================\n")
    PrintMessage("  RESULTS: ")
    PrintNumber(IPC.pass)
    PrintMessage(" passed, ")
    PrintNumber(IPC.fail)
    PrintMessage(" failed (")
    PrintNumber(IPC.total)
    PrintMessage(" total)\n")
    PrintMessage("============================================\n")
}

RunTask(Main)