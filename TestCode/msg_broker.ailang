// msg_broker.ailang
// Message broker — accepts 2 clients on a unix socket,
// routes JSON messages between them using poll().
//
// Protocol: 4-byte BE length + JSON payload
// Broker polls both clients, forwards messages to the other.
//
// Build: ./build.sh TestCode/msg_broker.ailang
// Run:   ./msg_broker.x
//        (then start client_b.x, then client_a.x)

LibraryImport.Arena
LibraryImport.Socket
LibraryImport.StringUtils
LibraryImport.JSON
LibraryImport.Arrays
LibraryImport.Hash

FixedPool.Broker {
    "server_fd":   Initialize=0
    "client_a_fd": Initialize=0
    "client_b_fd": Initialize=0
    "running":     Initialize=1
    "msg_count":   Initialize=0
}

SubRoutine.Main {
    Arena_Init()

    PrintMessage("============================================\n")
    PrintMessage("  Message Broker — Unix Domain Socket\n")
    PrintMessage("============================================\n\n")

    sock_path = "/tmp/ailang_broker.sock"

    // Create unix domain socket
    server_fd = Socket.Create(1, 1)
    IfCondition LessThan(server_fd, 0) ThenBlock: {
        PrintMessage("[BROKER] Socket create failed\n")
        HaltProgram
    }
    Broker.server_fd = server_fd

    // Bind to path
    bres = Socket.BindUnix(server_fd, sock_path)
    IfCondition LessThan(bres, 0) ThenBlock: {
        PrintMessage("[BROKER] Bind failed\n")
        Socket.Close(server_fd)
        HaltProgram
    }

    // Listen
    lres = Socket.Listen(server_fd, 2)
    IfCondition LessThan(lres, 0) ThenBlock: {
        PrintMessage("[BROKER] Listen failed\n")
        Socket.Close(server_fd)
        HaltProgram
    }

    PrintMessage("[BROKER] Listening on ")
    PrintMessage(sock_path)
    PrintMessage("\n")

    // Accept client 1
    PrintMessage("[BROKER] Waiting for Client 1...\n")
    client_a = Socket.Accept(server_fd)
    IfCondition LessThan(client_a, 0) ThenBlock: {
        PrintMessage("[BROKER] Accept 1 failed\n")
        Socket.Close(server_fd)
        HaltProgram
    }
    Broker.client_a_fd = client_a
    PrintMessage("[BROKER] Client 1 connected (fd=")
    PrintNumber(client_a)
    PrintMessage(")\n")

    // Accept client 2
    PrintMessage("[BROKER] Waiting for Client 2...\n")
    client_b = Socket.Accept(server_fd)
    IfCondition LessThan(client_b, 0) ThenBlock: {
        PrintMessage("[BROKER] Accept 2 failed\n")
        Socket.Close(client_a)
        Socket.Close(server_fd)
        HaltProgram
    }
    Broker.client_b_fd = client_b
    PrintMessage("[BROKER] Client 2 connected (fd=")
    PrintNumber(client_b)
    PrintMessage(")\n")

    PrintMessage("[BROKER] Both clients connected. Routing.\n\n")

    // Allocate pollfd array: 2 entries × 8 bytes each
    // struct pollfd { int fd(4); short events(2); short revents(2); } = 8 bytes
    pollfds = Allocate(16)

    // Temporary pointers for pollfd field access
    pfd0_events = 0
    pfd0_revents = 0
    pfd1_base = 0
    pfd1_events = 0
    pfd1_revents = 0

    WhileLoop EqualTo(Broker.running, 1) {
        // Zero the whole pollfds struct
        pzi = 0
        WhileLoop LessThan(pzi, 16) {
            SetByte(pollfds, pzi, 0)
            pzi = Add(pzi, 1)
        }

        // pollfd[0].fd = client_a (4 bytes LE)
        SetByte(pollfds, 0, BitwiseAnd(client_a, 255))
        SetByte(pollfds, 1, BitwiseAnd(RightShift(client_a, 8), 255))
        SetByte(pollfds, 2, BitwiseAnd(RightShift(client_a, 16), 255))
        SetByte(pollfds, 3, BitwiseAnd(RightShift(client_a, 24), 255))
        // pollfd[0].events = POLLIN (1)
        SetByte(pollfds, 4, 1)
        SetByte(pollfds, 5, 0)

        // pollfd[1].fd = client_b (offset 8)
        SetByte(pollfds, 8, BitwiseAnd(client_b, 255))
        SetByte(pollfds, 9, BitwiseAnd(RightShift(client_b, 8), 255))
        SetByte(pollfds, 10, BitwiseAnd(RightShift(client_b, 16), 255))
        SetByte(pollfds, 11, BitwiseAnd(RightShift(client_b, 24), 255))
        // pollfd[1].events = POLLIN (1)
        SetByte(pollfds, 12, 1)
        SetByte(pollfds, 13, 0)

        // poll(pollfds, 2, 5000) — 5 second timeout
        pr = SystemCall(7, pollfds, 2, 5000)

        IfCondition LessThan(pr, 0) ThenBlock: {
            PrintMessage("[BROKER] poll error\n")
            Broker.running = 0
        }

        // Timeout — just loop again
        IfCondition EqualTo(pr, 0) ThenBlock: {
            // No data, keep polling
        }

        // Check client_a revents (offset 6)
        IfCondition GreaterThan(pr, 0) ThenBlock: {
            rev_a = GetByte(pollfds, 6)

            IfCondition NotEqual(BitwiseAnd(rev_a, 1), 0) ThenBlock: {
                // Data ready on client_a → read and forward to client_b
                msg = Socket.RecvMsg(client_a)
                IfCondition EqualTo(msg, 0) ThenBlock: {
                    PrintMessage("[BROKER] Client 1 disconnected\n")
                    Broker.running = 0
                } ElseBlock: {
                    Broker.msg_count = Add(Broker.msg_count, 1)
                    PrintMessage("[BROKER] 1→2 #")
                    PrintNumber(Broker.msg_count)
                    PrintMessage(": ")
                    PrintMessage(msg)
                    PrintMessage("\n")

                    // Check for shutdown
                    parsed = ParseJSON(msg)
                    IfCondition NotEqual(parsed, 0) ThenBlock: {
                        pobj = JSON.AsObject(parsed)
                        IfCondition NotEqual(pobj, 0) ThenBlock: {
                            mstr = JSON.GetString(pobj, "method")
                            IfCondition NotEqual(mstr, 0) ThenBlock: {
                                cmp = StringCompare(mstr, "shutdown")
                                IfCondition EqualTo(cmp, 0) ThenBlock: {
                                    PrintMessage("[BROKER] Shutdown\n")
                                    Broker.running = 0
                                }
                            }
                        }
                    }

                    Socket.SendMsg(client_b, msg)
                }
            }

            // Check for error/hangup on client_a (POLLHUP = 16)
            IfCondition NotEqual(BitwiseAnd(rev_a, 16), 0) ThenBlock: {
                PrintMessage("[BROKER] Client 1 hung up\n")
                Broker.running = 0
            }

            // Check client_b revents (offset 14)
            rev_b = GetByte(pollfds, 14)

            IfCondition NotEqual(BitwiseAnd(rev_b, 1), 0) ThenBlock: {
                // Data ready on client_b → read and forward to client_a
                msg2 = Socket.RecvMsg(client_b)
                IfCondition EqualTo(msg2, 0) ThenBlock: {
                    PrintMessage("[BROKER] Client 2 disconnected\n")
                    Broker.running = 0
                } ElseBlock: {
                    Broker.msg_count = Add(Broker.msg_count, 1)
                    PrintMessage("[BROKER] 2→1 #")
                    PrintNumber(Broker.msg_count)
                    PrintMessage(": ")
                    PrintMessage(msg2)
                    PrintMessage("\n")

                    Socket.SendMsg(client_a, msg2)
                }
            }

            // Check for error/hangup on client_b
            IfCondition NotEqual(BitwiseAnd(rev_b, 16), 0) ThenBlock: {
                PrintMessage("[BROKER] Client 2 hung up\n")
                Broker.running = 0
            }
        }
    }

    // Cleanup
    Deallocate(pollfds, 16)
    PrintMessage("\n[BROKER] Shutting down...\n")
    Socket.Close(client_a)
    Socket.Close(client_b)
    Socket.Close(server_fd)
    SystemCall(87, sock_path, 0, 0)

    PrintMessage("[BROKER] Routed ")
    PrintNumber(Broker.msg_count)
    PrintMessage(" messages total\n")
    PrintMessage("[BROKER] Done\n")
}

RunTask(Main)