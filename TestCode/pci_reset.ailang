// pci_reset.ailang — PCIe secondary bus reset via bridge config space
// Build: ./ailang.x TestCode/pci_reset.ailang pci_reset.x
// Run:   sg video -c "./pci_reset.x"
//
// Toggles Secondary Bus Reset (SBR) bit in the PCIe bridge's
// Bridge Control register to force a full hardware reset of the GPU.

LibraryImport.Arena

SubRoutine.Main {
    PrintMessage("=== PCIe Secondary Bus Reset ===\n\n")

    // Open the bridge config space (00:02.0 is the bridge for bus 01)
    // O_RDWR = 2
    bridge_path = "/sys/bus/pci/devices/0000:00:02.0/config"
    fd = SystemCall(2, bridge_path, 2, 0)
    IfCondition LessThan(fd, 0) ThenBlock: {
        PrintMessage("Cannot open bridge config space (need root?): ")
        PrintNumber(fd)
        PrintMessage("\n")
        SystemCall(60, 1, 0, 0, 0, 0)
    }
    PrintMessage("Opened bridge config at 00:02.0\n")

    // Read Bridge Control register at offset 0x3E (2 bytes)
    // lseek(fd, 0x3E, SEEK_SET)
    SystemCall(8, fd, 62, 0)

    // Read 2 bytes
    buf = Allocate(16)
    MemorySet(buf, 0, 16)
    rd = SystemCall(0, fd, buf, 2)
    b0 = GetByte(buf, 0)
    b1 = GetByte(buf, 1)
    bridge_ctl = BitwiseOr(b0, LeftShift(b1, 8))
    PrintMessage("Current BRIDGE_CONTROL: 0x")
    PrintHex(bridge_ctl)
    PrintMessage("\n")

    // Set SBR bit (bit 6 = 0x40)
    new_ctl = BitwiseOr(bridge_ctl, 64)
    PrintMessage("Setting SBR bit: 0x")
    PrintHex(new_ctl)
    PrintMessage("\n")

    // Write back with SBR set
    SetByte(buf, 0, BitwiseAnd(new_ctl, 255))
    SetByte(buf, 1, BitwiseAnd(RightShift(new_ctl, 8), 255))
    SystemCall(8, fd, 62, 0)
    wr = SystemCall(1, fd, buf, 2)
    IfCondition LessThan(wr, 0) ThenBlock: {
        PrintMessage("Write failed: ")
        PrintNumber(wr)
        PrintMessage("\n")
        SystemCall(3, fd)
        Deallocate(buf, 16)
        SystemCall(60, 1, 0, 0, 0, 0)
    }
    PrintMessage("SBR asserted\n")

    // Wait ~200ms via nanosleep
    ts = Allocate(16)
    StoreValue(ts, 0)
    StoreValue(Add(ts, 8), 200000000)
    SystemCall(35, ts, 0, 0, 0, 0, 0)
    Deallocate(ts, 16)

    // Clear SBR bit
    old_ctl = bridge_ctl
    SetByte(buf, 0, BitwiseAnd(old_ctl, 255))
    SetByte(buf, 1, BitwiseAnd(RightShift(old_ctl, 8), 255))
    SystemCall(8, fd, 62, 0)
    wr2 = SystemCall(1, fd, buf, 2)
    PrintMessage("SBR deasserted\n")

    // Wait for link training
    StoreValue(ts, 0)
    ts2 = Allocate(16)
    StoreValue(ts2, 0)
    StoreValue(Add(ts2, 8), 500000000)
    SystemCall(35, ts2, 0, 0, 0, 0, 0)
    Deallocate(ts2, 16)

    // Verify by reading back
    SystemCall(8, fd, 62, 0)
    rd2 = SystemCall(0, fd, buf, 2)
    v0 = GetByte(buf, 0)
    v1 = GetByte(buf, 1)
    verify = BitwiseOr(v0, LeftShift(v1, 8))
    PrintMessage("Verify BRIDGE_CONTROL: 0x")
    PrintHex(verify)
    PrintMessage("\n")

    SystemCall(3, fd)
    Deallocate(buf, 16)

    // Re-enable the GPU's PCI command register (bus master + memory space)
    // After SBR the device may be disabled
    PrintMessage("\nRe-enabling GPU PCI command register...\n")
    gpu_path = "/sys/bus/pci/devices/0000:01:00.0/config"
    gfd = SystemCall(2, gpu_path, 2, 0)
    IfCondition LessThan(gfd, 0) ThenBlock: {
        PrintMessage("Cannot open GPU config: ")
        PrintNumber(gfd)
        PrintMessage("\n")
        SystemCall(60, 1, 0, 0, 0, 0)
    }

    // PCI Command register at offset 0x04
    gbuf = Allocate(16)
    MemorySet(gbuf, 0, 16)
    SystemCall(8, gfd, 4, 0)
    SystemCall(0, gfd, gbuf, 2)
    gc0 = GetByte(gbuf, 0)
    gc1 = GetByte(gbuf, 1)
    gcmd = BitwiseOr(gc0, LeftShift(gc1, 8))
    PrintMessage("GPU COMMAND before: 0x")
    PrintHex(gcmd)
    PrintMessage("\n")

    // Set bits: IO_SPACE(0) + MEM_SPACE(1) + BUS_MASTER(2) = 0x07
    new_cmd = BitwiseOr(gcmd, 7)
    SetByte(gbuf, 0, BitwiseAnd(new_cmd, 255))
    SetByte(gbuf, 1, BitwiseAnd(RightShift(new_cmd, 8), 255))
    SystemCall(8, gfd, 4, 0)
    SystemCall(1, gfd, gbuf, 2)
    PrintMessage("GPU COMMAND set to: 0x")
    PrintHex(new_cmd)
    PrintMessage("\n")

    SystemCall(3, gfd)
    Deallocate(gbuf, 16)

    PrintMessage("\n=== PCIe Reset Complete ===\n")
    SystemCall(60, 0, 0, 0, 0, 0)
}

RunTask(Main)
