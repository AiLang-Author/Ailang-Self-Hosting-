LibraryImport.Arena
LibraryImport.Socket
LibraryImport.Hash
LibraryImport.Arrays
LibraryImport.StringUtils
LibraryImport.PostgreSQL_Complete

SubRoutine.Main {
    Arena_Init()
    PrintMessage("=== Simple SELECT Test ===\n")

    conn = PG_Connect("127.0.0.1", 5432, "ailang_system", "sean", "")
    IfCondition EqualTo(conn, 0) ThenBlock: {
        PrintMessage("[FAIL] connect\n")
        HaltProgram
    }
    PrintMessage("[PASS] connected\n")

    PrintMessage("[TEST] SELECT 1 AS a, 2 AS b, 3 AS c\n")
    result = PG_Query(conn, "SELECT 1 AS a, 2 AS b, 3 AS c")
    IfCondition EqualTo(result, 0) ThenBlock: {
        PrintMessage("[FAIL] query\n")
        PG_Disconnect(conn)
        HaltProgram
    }

    rc = Array.Size(result)
    PrintMessage("[INFO] rows=")
    PrintNumber(rc)
    PrintMessage("\n")

    PG_Disconnect(conn)
    PrintMessage("=== Done ===\n")
}

RunTask(Main)
