LibraryImport.Arena
LibraryImport.Socket
LibraryImport.Hash
LibraryImport.Arrays
LibraryImport.StringUtils
LibraryImport.PostgreSQL_Complete

SubRoutine.Main {
    Arena_Init()
    PrintMessage("=== INSERT + SELECT Test ===\n")

    conn = PG_Connect("127.0.0.1", 5432, "ailang_system", "sean", "")
    IfCondition EqualTo(conn, 0) ThenBlock: {
        PrintMessage("[FAIL] connect\n")
        HaltProgram
    }
    PrintMessage("[PASS] connected\n")

    PrintMessage("[TEST] DROP TABLE IF EXISTS\n")
    r1 = PG_Query(conn, "DROP TABLE IF EXISTS pg_test2")
    PrintMessage("[INFO] drop result=")
    PrintNumber(r1)
    PrintMessage("\n")

    PrintMessage("[TEST] CREATE TABLE\n")
    r2 = PG_Query(conn, "CREATE TABLE pg_test2 (id SERIAL, name TEXT)")
    PrintMessage("[INFO] create result=")
    PrintNumber(r2)
    PrintMessage("\n")

    PrintMessage("[TEST] INSERT\n")
    r3 = PG_Query(conn, "INSERT INTO pg_test2 (name) VALUES ('hello')")
    PrintMessage("[INFO] insert result=")
    PrintNumber(r3)
    PrintMessage("\n")

    PrintMessage("[TEST] SELECT\n")
    r4 = PG_Query(conn, "SELECT id, name FROM pg_test2")
    IfCondition EqualTo(r4, 0) ThenBlock: {
        PrintMessage("[FAIL] select\n")
        PG_Disconnect(conn)
        HaltProgram
    }
    rc = Array.Size(r4)
    PrintMessage("[INFO] rows=")
    PrintNumber(rc)
    PrintMessage("\n")

    PG_Disconnect(conn)
    PrintMessage("=== Done ===\n")
}

RunTask(Main)