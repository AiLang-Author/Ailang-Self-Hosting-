// =============================================================================
// Prime Sieve - Direct Memory Access (no SetByte/GetByte)
// =============================================================================

SubRoutine.Main {
    PrintMessage("Prime Sieve - Direct Memory\n\n")
    
    buf_size = 500000
    max_num = 1000000
    run_seconds = 5
    
    ts_buffer = Allocate(16)
    buffer = Allocate(buf_size)
    
    sqrt_limit = ISqrt(max_num)
    
    PrintMessage("Sqrt limit: ")
    PrintNumber(sqrt_limit)
    PrintMessage("\n")
    
    // === VALIDATION ===
    MemorySet(buffer, 0, buf_size)
    StoreValue(buffer, 1, "byte")
    
    p = 3
    WhileLoop LessEqual(p, sqrt_limit) {
        p_idx = Divide(Subtract(p, 1), 2)
        is_prime = Dereference(Add(buffer, p_idx), "byte")
        IfCondition EqualTo(is_prime, 0) ThenBlock: {
            start_idx = Divide(Subtract(Multiply(p, p), 1), 2)
            n_idx = start_idx
            WhileLoop LessThan(n_idx, buf_size) {
                StoreValue(Add(buffer, n_idx), 1, "byte")
                n_idx = Add(n_idx, p)
            }
        }
        p = Add(p, 2)
    }
    
    count = 1
    i = 1
    WhileLoop LessThan(i, buf_size) {
        val = Dereference(Add(buffer, i), "byte")
        IfCondition EqualTo(val, 0) ThenBlock: {
            count = Add(count, 1)
        }
        i = Add(i, 1)
    }
    
    PrintMessage("Validation: ")
    PrintNumber(count)
    IfCondition EqualTo(count, 78498) ThenBlock: {
        PrintMessage(" ✓\n")
    } ElseBlock: {
        PrintMessage(" FAIL\n")
        Exit(1)
    }
    
    // === TIMED RUN ===
    PrintMessage("\nTimed run (5 sec)...\n")
    
    dummy = SystemCall(228, 1, ts_buffer)
    start_sec = Dereference(ts_buffer)
    end_time = Add(start_sec, run_seconds)
    
    passes = 0
    keepgoing = 1
    
    WhileLoop EqualTo(keepgoing, 1) {
        MemorySet(buffer, 0, buf_size)
        StoreValue(buffer, 1, "byte")
        
        p = 3
        WhileLoop LessEqual(p, sqrt_limit) {
            p_idx = Divide(Subtract(p, 1), 2)
            is_prime = Dereference(Add(buffer, p_idx), "byte")
            IfCondition EqualTo(is_prime, 0) ThenBlock: {
                start_idx = Divide(Subtract(Multiply(p, p), 1), 2)
                n_idx = start_idx
                WhileLoop LessThan(n_idx, buf_size) {
                    StoreValue(Add(buffer, n_idx), 1, "byte")
                    n_idx = Add(n_idx, p)
                }
            }
            p = Add(p, 2)
        }
        
        passes = Add(passes, 1)
        
        dummy = SystemCall(228, 1, ts_buffer)
        now = Dereference(ts_buffer)
        IfCondition GreaterEqual(now, end_time) ThenBlock: {
            keepgoing = 0
        }
    }
    
    dummy = SystemCall(228, 1, ts_buffer)
    final_sec = Dereference(ts_buffer)
    elapsed = Subtract(final_sec, start_sec)
    
    PrintMessage("\nPasses: ")
    PrintNumber(passes)
    PrintMessage("\nElapsed: ")
    PrintNumber(elapsed)
    PrintMessage(" sec\n")
    PrintMessage("Passes/sec: ")
    PrintNumber(Divide(passes, elapsed))
    PrintMessage("\n\nailang_direct;")
    PrintNumber(passes)
    PrintMessage(";")
    PrintNumber(elapsed)
    PrintMessage(";1;algorithm=base,faithful=yes,bits=8\n")
    
    Deallocate(buffer, buf_size)
    Deallocate(ts_buffer, 16)
}

RunTask(Main)