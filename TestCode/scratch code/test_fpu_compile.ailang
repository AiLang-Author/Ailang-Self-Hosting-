// test_fpu_compile.ailang
// Test the FPU compile layer - generates code using Float_* and Memory* ops
// Location: Tests/FPU/test_fpu_compile.ailang
//
// This tests that the compiler can parse and compile FPU operations.
// The generated executable will perform float math and memory ops.

// =============================================================================
// TEST 1: Float arithmetic (integer simulation for now)
// Until we have proper float literals, we test int->float->int roundtrip
// =============================================================================

SubRoutine.TestFloatArithmetic {
    PrintMessage("=== Float Arithmetic Tests ===\n")
    
    // Float_Add: 10 + 32 = 42
    PrintMessage("Float_Add(10, 32) = ")
    result = Float_Add(10, 32)
    PrintNumber(result)
    IfCondition EqualTo(result, 42) ThenBlock: {
        PrintMessage(" [OK]\n")
    } ElseBlock: {
        PrintMessage(" [FAIL] expected 42\n")
    }
    
    // Float_Sub: 50 - 8 = 42
    PrintMessage("Float_Sub(50, 8) = ")
    result = Float_Sub(50, 8)
    PrintNumber(result)
    IfCondition EqualTo(result, 42) ThenBlock: {
        PrintMessage(" [OK]\n")
    } ElseBlock: {
        PrintMessage(" [FAIL] expected 42\n")
    }
    
    // Float_Mul: 6 * 7 = 42
    PrintMessage("Float_Mul(6, 7) = ")
    result = Float_Mul(6, 7)
    PrintNumber(result)
    IfCondition EqualTo(result, 42) ThenBlock: {
        PrintMessage(" [OK]\n")
    } ElseBlock: {
        PrintMessage(" [FAIL] expected 42\n")
    }
    
    // Float_Div: 126 / 3 = 42
    PrintMessage("Float_Div(126, 3) = ")
    result = Float_Div(126, 3)
    PrintNumber(result)
    IfCondition EqualTo(result, 42) ThenBlock: {
        PrintMessage(" [OK]\n")
    } ElseBlock: {
        PrintMessage(" [FAIL] expected 42\n")
    }
    
    // Float_Sqrt: sqrt(49) = 7
    PrintMessage("Float_Sqrt(49) = ")
    result = Float_Sqrt(49)
    PrintNumber(result)
    IfCondition EqualTo(result, 7) ThenBlock: {
        PrintMessage(" [OK]\n")
    } ElseBlock: {
        PrintMessage(" [FAIL] expected 7\n")
    }
    
    // Float_Min: min(100, 42) = 42
    PrintMessage("Float_Min(100, 42) = ")
    result = Float_Min(100, 42)
    PrintNumber(result)
    IfCondition EqualTo(result, 42) ThenBlock: {
        PrintMessage(" [OK]\n")
    } ElseBlock: {
        PrintMessage(" [FAIL] expected 42\n")
    }
    
    // Float_Max: max(10, 42) = 42
    PrintMessage("Float_Max(10, 42) = ")
    result = Float_Max(10, 42)
    PrintNumber(result)
    IfCondition EqualTo(result, 42) ThenBlock: {
        PrintMessage(" [OK]\n")
    } ElseBlock: {
        PrintMessage(" [FAIL] expected 42\n")
    }
}

// =============================================================================
// TEST 1b: Math primitives (SSE2 versions)
// =============================================================================

SubRoutine.TestMathPrimitives {
    PrintMessage("\n=== Math Primitive Tests (SSE2) ===\n")
    
    // ISqrt - integer square root
    PrintMessage("ISqrt(49) = ")
    result = ISqrt(49)
    PrintNumber(result)
    IfCondition EqualTo(result, 7) ThenBlock: {
        PrintMessage(" [OK]\n")
    } ElseBlock: {
        PrintMessage(" [FAIL] expected 7\n")
    }
    
    PrintMessage("ISqrt(100) = ")
    result = ISqrt(100)
    PrintNumber(result)
    IfCondition EqualTo(result, 10) ThenBlock: {
        PrintMessage(" [OK]\n")
    } ElseBlock: {
        PrintMessage(" [FAIL] expected 10\n")
    }
    
    PrintMessage("ISqrt(2) = ")
    result = ISqrt(2)
    PrintNumber(result)
    IfCondition EqualTo(result, 1) ThenBlock: {
        PrintMessage(" [OK] (floor)\n")
    } ElseBlock: {
        PrintMessage(" [FAIL] expected 1\n")
    }
    
    // Abs - absolute value
    PrintMessage("Abs(42) = ")
    result = Abs(42)
    PrintNumber(result)
    IfCondition EqualTo(result, 42) ThenBlock: {
        PrintMessage(" [OK]\n")
    } ElseBlock: {
        PrintMessage(" [FAIL] expected 42\n")
    }
    
    PrintMessage("Abs(-42) = ")
    result = Abs(-42)
    PrintNumber(result)
    IfCondition EqualTo(result, 42) ThenBlock: {
        PrintMessage(" [OK]\n")
    } ElseBlock: {
        PrintMessage(" [FAIL] expected 42\n")
    }
    
    PrintMessage("Abs(0) = ")
    result = Abs(0)
    PrintNumber(result)
    IfCondition EqualTo(result, 0) ThenBlock: {
        PrintMessage(" [OK]\n")
    } ElseBlock: {
        PrintMessage(" [FAIL] expected 0\n")
    }
    
    // Min
    PrintMessage("Min(100, 42) = ")
    result = Min(100, 42)
    PrintNumber(result)
    IfCondition EqualTo(result, 42) ThenBlock: {
        PrintMessage(" [OK]\n")
    } ElseBlock: {
        PrintMessage(" [FAIL] expected 42\n")
    }
    
    PrintMessage("Min(10, 42) = ")
    result = Min(10, 42)
    PrintNumber(result)
    IfCondition EqualTo(result, 10) ThenBlock: {
        PrintMessage(" [OK]\n")
    } ElseBlock: {
        PrintMessage(" [FAIL] expected 10\n")
    }
    
    // Max
    PrintMessage("Max(10, 42) = ")
    result = Max(10, 42)
    PrintNumber(result)
    IfCondition EqualTo(result, 42) ThenBlock: {
        PrintMessage(" [OK]\n")
    } ElseBlock: {
        PrintMessage(" [FAIL] expected 42\n")
    }
    
    PrintMessage("Max(100, 42) = ")
    result = Max(100, 42)
    PrintNumber(result)
    IfCondition EqualTo(result, 100) ThenBlock: {
        PrintMessage(" [OK]\n")
    } ElseBlock: {
        PrintMessage(" [FAIL] expected 100\n")
    }
}

// =============================================================================
// TEST 2: Float comparisons
// =============================================================================

SubRoutine.TestFloatComparisons {
    PrintMessage("\n=== Float Comparison Tests ===\n")
    
    // Float_Eq
    PrintMessage("Float_Eq(42, 42) = ")
    result = Float_Eq(42, 42)
    PrintNumber(result)
    IfCondition EqualTo(result, 1) ThenBlock: {
        PrintMessage(" [OK]\n")
    } ElseBlock: {
        PrintMessage(" [FAIL] expected 1\n")
    }
    
    PrintMessage("Float_Eq(42, 10) = ")
    result = Float_Eq(42, 10)
    PrintNumber(result)
    IfCondition EqualTo(result, 0) ThenBlock: {
        PrintMessage(" [OK]\n")
    } ElseBlock: {
        PrintMessage(" [FAIL] expected 0\n")
    }
    
    // Float_Lt
    PrintMessage("Float_Lt(10, 42) = ")
    result = Float_Lt(10, 42)
    PrintNumber(result)
    IfCondition EqualTo(result, 1) ThenBlock: {
        PrintMessage(" [OK]\n")
    } ElseBlock: {
        PrintMessage(" [FAIL] expected 1\n")
    }
    
    // Float_Gt
    PrintMessage("Float_Gt(42, 10) = ")
    result = Float_Gt(42, 10)
    PrintNumber(result)
    IfCondition EqualTo(result, 1) ThenBlock: {
        PrintMessage(" [OK]\n")
    } ElseBlock: {
        PrintMessage(" [FAIL] expected 1\n")
    }
}

// =============================================================================
// TEST 3: Memory operations with SSE2
// =============================================================================

SubRoutine.TestMemoryOps {
    PrintMessage("\n=== Memory Operation Tests ===\n")
    
    // Allocate test buffer
    buffer = Allocate(256)
    
    // MemorySet: fill with 0x42
    PrintMessage("MemorySet(buffer, 66, 100)...\n")
    MemorySet(buffer, 66, 100)  // Fill 100 bytes with 'B' (66)
    
    // Verify first few bytes
    b0 = Dereference(buffer, "byte")
    b1 = Dereference(Add(buffer, 1), "byte")
    b50 = Dereference(Add(buffer, 50), "byte")
    b99 = Dereference(Add(buffer, 99), "byte")
    
    PrintMessage("  buffer[0] = ")
    PrintNumber(b0)
    IfCondition EqualTo(b0, 66) ThenBlock: {
        PrintMessage(" [OK]\n")
    } ElseBlock: {
        PrintMessage(" [FAIL]\n")
    }
    
    PrintMessage("  buffer[50] = ")
    PrintNumber(b50)
    IfCondition EqualTo(b50, 66) ThenBlock: {
        PrintMessage(" [OK]\n")
    } ElseBlock: {
        PrintMessage(" [FAIL]\n")
    }
    
    PrintMessage("  buffer[99] = ")
    PrintNumber(b99)
    IfCondition EqualTo(b99, 66) ThenBlock: {
        PrintMessage(" [OK]\n")
    } ElseBlock: {
        PrintMessage(" [FAIL]\n")
    }
    
    // MemoryCopy test
    buffer2 = Allocate(256)
    MemorySet(buffer2, 0, 100)  // Clear destination
    
    PrintMessage("MemoryCopy(buffer2, buffer, 100)...\n")
    MemoryCopy(buffer2, buffer, 100)
    
    // Verify copy
    c0 = Dereference(buffer2, "byte")
    c50 = Dereference(Add(buffer2, 50), "byte")
    
    PrintMessage("  buffer2[0] = ")
    PrintNumber(c0)
    IfCondition EqualTo(c0, 66) ThenBlock: {
        PrintMessage(" [OK]\n")
    } ElseBlock: {
        PrintMessage(" [FAIL]\n")
    }
    
    PrintMessage("  buffer2[50] = ")
    PrintNumber(c50)
    IfCondition EqualTo(c50, 66) ThenBlock: {
        PrintMessage(" [OK]\n")
    } ElseBlock: {
        PrintMessage(" [FAIL]\n")
    }
    
    // MemCompare test
    PrintMessage("MemCompare(buffer, buffer2, 100) = ")
    cmp_result = MemCompare(buffer, buffer2, 100)
    PrintNumber(cmp_result)
    IfCondition EqualTo(cmp_result, 0) ThenBlock: {
        PrintMessage(" [OK] (equal)\n")
    } ElseBlock: {
        PrintMessage(" [FAIL] expected 0 (equal)\n")
    }
    
    // Modify one byte and compare again
    StoreValue(Add(buffer2, 25), 99)  // Change byte 25
    PrintMessage("After modifying buffer2[25]:\n")
    PrintMessage("MemCompare(buffer, buffer2, 100) = ")
    cmp_result = MemCompare(buffer, buffer2, 100)
    PrintNumber(cmp_result)
    IfCondition EqualTo(cmp_result, 1) ThenBlock: {
        PrintMessage(" [OK] (different)\n")
    } ElseBlock: {
        PrintMessage(" [FAIL] expected 1 (different)\n")
    }
    
    // MemChr test
    MemorySet(buffer, 0, 100)  // Clear
    StoreValue(Add(buffer, 42), 255)  // Put marker at position 42
    
    PrintMessage("MemChr(buffer, 255, 100) = ")
    pos = MemChr(buffer, 255, 100)
    PrintNumber(pos)
    IfCondition EqualTo(pos, 42) ThenBlock: {
        PrintMessage(" [OK]\n")
    } ElseBlock: {
        PrintMessage(" [FAIL] expected 42\n")
    }
    
    PrintMessage("MemChr(buffer, 123, 100) = ")
    pos = MemChr(buffer, 123, 100)  // Not found
    PrintNumber(pos)
    IfCondition EqualTo(pos, -1) ThenBlock: {
        PrintMessage(" [OK] (not found)\n")
    } ElseBlock: {
        PrintMessage(" [FAIL] expected -1\n")
    }
    
    // Cleanup
    Deallocate(buffer, 256)
    Deallocate(buffer2, 256)
}

// =============================================================================
// MAIN
// =============================================================================

SubRoutine.Main {
    PrintMessage("==============================================\n")
    PrintMessage("FPU Compile Layer Test\n")
    PrintMessage("==============================================\n\n")
    
    TestFloatArithmetic()
    TestMathPrimitives()
    TestFloatComparisons()
    TestMemoryOps()
    
    PrintMessage("\n==============================================\n")
    PrintMessage("FPU Compile Test Complete!\n")
    PrintMessage("==============================================\n")
}

RunTask(Main)