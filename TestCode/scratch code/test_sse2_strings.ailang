// test_sse2_strings.ailang
// Test SSE2 string operations

SubRoutine.Main {
    PrintMessage("=== SSE2 String Tests ===\n")
    
    // Test 1: StringLength
    s1 = "Hello, World!"
    len = StringLength(s1)
    PrintMessage("Length of 'Hello, World!': ")
    PrintNumber(len)
    PrintMessage(" (expect 13)\n")
    
    // Test 2: Longer string (tests SSE loop)
    s2 = "This string is longer than sixteen bytes for SSE2 testing"
    len2 = StringLength(s2)
    PrintMessage("Long string length: ")
    PrintNumber(len2)
    PrintMessage(" (expect 57)\n")
    
    // Test 3: StringCompare - equal
    cmp1 = StringCompare("test", "test")
    PrintMessage("Compare 'test' vs 'test': ")
    PrintNumber(cmp1)
    PrintMessage(" (expect 0)\n")
    
    // Test 4: StringCompare - different
    cmp2 = StringCompare("abc", "abd")
    PrintMessage("Compare 'abc' vs 'abd': ")
    PrintNumber(cmp2)
    PrintMessage(" (expect -1)\n")
    
    // Test 5: StringEquals
    eq1 = StringEquals("hello", "hello")
    PrintMessage("Equals 'hello' vs 'hello': ")
    PrintNumber(eq1)
    PrintMessage(" (expect 1)\n")
    
    eq2 = StringEquals("hello", "world")
    PrintMessage("Equals 'hello' vs 'world': ")
    PrintNumber(eq2)
    PrintMessage(" (expect 0)\n")
    
    // Test 6: StringIndexOf
    idx = StringIndexOf("Hello World", 87)  // 87 = 'W'
    PrintMessage("IndexOf 'W' in 'Hello World': ")
    PrintNumber(idx)
    PrintMessage(" (expect 6)\n")
    
    // Test 7: StringIndexOf - not found
    idx2 = StringIndexOf("Hello World", 90)  // 90 = 'Z'
    PrintMessage("IndexOf 'Z' in 'Hello World': ")
    PrintNumber(idx2)
    PrintMessage(" (expect -1)\n")
    
    // Test 8: StringContains
    has = StringContains("Hello World", 111)  // 111 = 'o'
    PrintMessage("Contains 'o' in 'Hello World': ")
    PrintNumber(has)
    PrintMessage(" (expect 1)\n")
    
    // Test 9: StringCopy
    buf = "                    "  // 20 spaces as buffer
    StringCopy(buf, "Copied!")
    PrintMessage("StringCopy result: ")
    PrintMessage(buf)
    PrintMessage(" (expect 'Copied!')\n")
    
    PrintMessage("=== Done ===\n")
}

RunTask(Main)