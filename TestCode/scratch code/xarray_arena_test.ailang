// xarray_arena_test.ailang
// Comprehensive test for Arena-integrated XArrays library
// Tests all XArray operations to ensure arena backing works correctly
//
// Run: python3 main.py xarray_arena_test.ailang
//      ./xarray_arena_test_exec

LibraryImport.XArrays
LibraryImport.Arena

// =============================================================================
// TEST FRAMEWORK
// =============================================================================
FixedPool.Test {
    "passed": Initialize=0
    "failed": Initialize=0
    "total": Initialize=0
    "name": Initialize=0
    "actual": Initialize=0
    "expected": Initialize=0
}

SubRoutine.Pass {
    Test.passed = Add(Test.passed, 1)
    Test.total = Add(Test.total, 1)
    PrintMessage("  [PASS] ")
    PrintMessage(Test.name)
    PrintMessage("\n")
}

SubRoutine.Fail {
    Test.failed = Add(Test.failed, 1)
    Test.total = Add(Test.total, 1)
    PrintMessage("  [FAIL] ")
    PrintMessage(Test.name)
    PrintMessage(" - expected ")
    PrintNumber(Test.expected)
    PrintMessage(" got ")
    PrintNumber(Test.actual)
    PrintMessage("\n")
}

SubRoutine.Check {
    IfCondition EqualTo(Test.actual, Test.expected) ThenBlock: {
        RunTask(Pass)
    } ElseBlock: {
        RunTask(Fail)
    }
}

SubRoutine.CheckNotZero {
    IfCondition NotEqual(Test.actual, 0) ThenBlock: {
        RunTask(Pass)
    } ElseBlock: {
        Test.expected = 1
        Test.actual = 0
        RunTask(Fail)
    }
}

// =============================================================================
// TEST 1: Basic Create/Destroy
// =============================================================================
SubRoutine.Test_CreateDestroy {
    PrintMessage("\n=== TEST 1: Basic Create/Destroy ===\n")
    
    // Create with various capacities
    Test.name = "XCreate(8) returns non-null"
    arr = XArray.XCreate(8)
    Test.actual = arr
    RunTask(CheckNotZero)
    
    Test.name = "Initial size is 0"
    Test.actual = XArray.XSize(arr)
    Test.expected = 0
    RunTask(Check)
    
    Test.name = "Capacity is 8"
    Test.actual = XArray.XCapacity(arr)
    Test.expected = 8
    RunTask(Check)
    
    XArray.XDestroy(arr)
    
    // Test small capacity (arena slab)
    Test.name = "XCreate(4) returns non-null"
    arr2 = XArray.XCreate(4)
    Test.actual = arr2
    RunTask(CheckNotZero)
    XArray.XDestroy(arr2)
    
    // Test medium capacity (still arena)
    Test.name = "XCreate(64) returns non-null"
    arr3 = XArray.XCreate(64)
    Test.actual = arr3
    RunTask(CheckNotZero)
    XArray.XDestroy(arr3)
    
    // Test large capacity (should use mmap)
    Test.name = "XCreate(256) returns non-null"
    arr4 = XArray.XCreate(256)
    Test.actual = arr4
    RunTask(CheckNotZero)
    XArray.XDestroy(arr4)
}

// =============================================================================
// TEST 2: Push and Size
// =============================================================================
SubRoutine.Test_PushSize {
    PrintMessage("\n=== TEST 2: Push and Size ===\n")
    
    arr = XArray.XCreate(8)
    
    // Push single element
    XArray.XPush(arr, 42)
    Test.name = "After 1 push, size is 1"
    Test.actual = XArray.XSize(arr)
    Test.expected = 1
    RunTask(Check)
    
    // Push more elements
    XArray.XPush(arr, 100)
    XArray.XPush(arr, 200)
    XArray.XPush(arr, 300)
    
    Test.name = "After 4 pushes, size is 4"
    Test.actual = XArray.XSize(arr)
    Test.expected = 4
    RunTask(Check)
    
    // Fill to capacity
    XArray.XPush(arr, 400)
    XArray.XPush(arr, 500)
    XArray.XPush(arr, 600)
    XArray.XPush(arr, 700)
    
    Test.name = "After 8 pushes, size is 8"
    Test.actual = XArray.XSize(arr)
    Test.expected = 8
    RunTask(Check)
    
    Test.name = "Capacity still 8 (no resize yet)"
    Test.actual = XArray.XCapacity(arr)
    Test.expected = 8
    RunTask(Check)
    
    XArray.XDestroy(arr)
}

// =============================================================================
// TEST 3: Get and Set
// =============================================================================
SubRoutine.Test_GetSet {
    PrintMessage("\n=== TEST 3: Get and Set ===\n")
    
    arr = XArray.XCreate(16)
    
    // Push some values
    XArray.XPush(arr, 10)
    XArray.XPush(arr, 20)
    XArray.XPush(arr, 30)
    XArray.XPush(arr, 40)
    XArray.XPush(arr, 50)
    
    // Test Get
    Test.name = "XGet(0) returns 10"
    Test.actual = XArray.XGet(arr, 0)
    Test.expected = 10
    RunTask(Check)
    
    Test.name = "XGet(2) returns 30"
    Test.actual = XArray.XGet(arr, 2)
    Test.expected = 30
    RunTask(Check)
    
    Test.name = "XGet(4) returns 50"
    Test.actual = XArray.XGet(arr, 4)
    Test.expected = 50
    RunTask(Check)
    
    // Test Set
    XArray.XSet(arr, 2, 999)
    Test.name = "After XSet(2, 999), XGet(2) returns 999"
    Test.actual = XArray.XGet(arr, 2)
    Test.expected = 999
    RunTask(Check)
    
    // Verify other elements unchanged
    Test.name = "XGet(1) still returns 20"
    Test.actual = XArray.XGet(arr, 1)
    Test.expected = 20
    RunTask(Check)
    
    Test.name = "XGet(3) still returns 40"
    Test.actual = XArray.XGet(arr, 3)
    Test.expected = 40
    RunTask(Check)
    
    // Test out of bounds (should return XERROR = -999999)
    Test.name = "XGet(-1) returns XERROR"
    Test.actual = XArray.XGet(arr, -1)
    Test.expected = -999999
    RunTask(Check)
    
    Test.name = "XGet(100) returns XERROR"
    Test.actual = XArray.XGet(arr, 100)
    Test.expected = -999999
    RunTask(Check)
    
    XArray.XDestroy(arr)
}

// =============================================================================
// TEST 4: Pop
// =============================================================================
SubRoutine.Test_Pop {
    PrintMessage("\n=== TEST 4: Pop ===\n")
    
    arr = XArray.XCreate(8)
    XArray.XPush(arr, 100)
    XArray.XPush(arr, 200)
    XArray.XPush(arr, 300)
    
    Test.name = "First pop returns 300 (LIFO)"
    Test.actual = XArray.XPop(arr)
    Test.expected = 300
    RunTask(Check)
    
    Test.name = "Size is now 2"
    Test.actual = XArray.XSize(arr)
    Test.expected = 2
    RunTask(Check)
    
    Test.name = "Second pop returns 200"
    Test.actual = XArray.XPop(arr)
    Test.expected = 200
    RunTask(Check)
    
    Test.name = "Third pop returns 100"
    Test.actual = XArray.XPop(arr)
    Test.expected = 100
    RunTask(Check)
    
    Test.name = "Size is now 0"
    Test.actual = XArray.XSize(arr)
    Test.expected = 0
    RunTask(Check)
    
    Test.name = "Pop from empty returns XERROR"
    Test.actual = XArray.XPop(arr)
    Test.expected = -999999
    RunTask(Check)
    
    XArray.XDestroy(arr)
}

// =============================================================================
// TEST 5: Auto-Resize (Critical for arena integration)
// =============================================================================
SubRoutine.Test_Resize {
    PrintMessage("\n=== TEST 5: Auto-Resize ===\n")
    
    // Start with small capacity
    arr = XArray.XCreate(4)
    
    Test.name = "Initial capacity is 4"
    Test.actual = XArray.XCapacity(arr)
    Test.expected = 4
    RunTask(Check)
    
    // Push 4 elements (fill capacity)
    XArray.XPush(arr, 1)
    XArray.XPush(arr, 2)
    XArray.XPush(arr, 3)
    XArray.XPush(arr, 4)
    
    Test.name = "After 4 pushes, size is 4"
    Test.actual = XArray.XSize(arr)
    Test.expected = 4
    RunTask(Check)
    
    // Push 5th element - triggers resize
    XArray.XPush(arr, 5)
    
    Test.name = "After 5th push, size is 5"
    Test.actual = XArray.XSize(arr)
    Test.expected = 5
    RunTask(Check)
    
    Test.name = "Capacity doubled to 8"
    Test.actual = XArray.XCapacity(arr)
    Test.expected = 8
    RunTask(Check)
    
    // Verify data integrity after resize
    Test.name = "Element 0 preserved after resize"
    Test.actual = XArray.XGet(arr, 0)
    Test.expected = 1
    RunTask(Check)
    
    Test.name = "Element 3 preserved after resize"
    Test.actual = XArray.XGet(arr, 3)
    Test.expected = 4
    RunTask(Check)
    
    Test.name = "New element 4 accessible"
    Test.actual = XArray.XGet(arr, 4)
    Test.expected = 5
    RunTask(Check)
    
    // Continue pushing to trigger more resizes
    push_val = 6
    WhileLoop LessEqual(push_val, 20) {
        XArray.XPush(arr, push_val)
        push_val = Add(push_val, 1)
    }
    
    Test.name = "After pushing 1-20, size is 20"
    Test.actual = XArray.XSize(arr)
    Test.expected = 20
    RunTask(Check)
    
    Test.name = "Element 19 is 20"
    Test.actual = XArray.XGet(arr, 19)
    Test.expected = 20
    RunTask(Check)
    
    XArray.XDestroy(arr)
}

// =============================================================================
// TEST 6: Clear
// =============================================================================
SubRoutine.Test_Clear {
    PrintMessage("\n=== TEST 6: Clear ===\n")
    
    arr = XArray.XCreate(16)
    XArray.XPush(arr, 1)
    XArray.XPush(arr, 2)
    XArray.XPush(arr, 3)
    XArray.XPush(arr, 4)
    XArray.XPush(arr, 5)
    
    Test.name = "Before clear, size is 5"
    Test.actual = XArray.XSize(arr)
    Test.expected = 5
    RunTask(Check)
    
    XArray.XClear(arr)
    
    Test.name = "After clear, size is 0"
    Test.actual = XArray.XSize(arr)
    Test.expected = 0
    RunTask(Check)
    
    Test.name = "Capacity unchanged after clear"
    Test.actual = XArray.XCapacity(arr)
    Test.expected = 16
    RunTask(Check)
    
    // Can push again after clear
    XArray.XPush(arr, 999)
    Test.name = "Can push after clear"
    Test.actual = XArray.XGet(arr, 0)
    Test.expected = 999
    RunTask(Check)
    
    XArray.XDestroy(arr)
}

// =============================================================================
// TEST 7: Stack Operations
// =============================================================================
SubRoutine.Test_Stack {
    PrintMessage("\n=== TEST 7: Stack Operations ===\n")
    
    stack = XStack.XCreate(16)
    
    Test.name = "New stack is empty"
    Test.actual = XStack.XIsEmpty(stack)
    Test.expected = 1
    RunTask(Check)
    
    XStack.XPush(stack, 10)
    XStack.XPush(stack, 20)
    XStack.XPush(stack, 30)
    
    Test.name = "After 3 pushes, not empty"
    Test.actual = XStack.XIsEmpty(stack)
    Test.expected = 0
    RunTask(Check)
    
    Test.name = "Peek returns 30 (top)"
    Test.actual = XStack.XPeek(stack)
    Test.expected = 30
    RunTask(Check)
    
    Test.name = "Size still 3 after peek"
    Test.actual = XArray.XSize(stack)
    Test.expected = 3
    RunTask(Check)
    
    Test.name = "Pop returns 30"
    Test.actual = XStack.XPop(stack)
    Test.expected = 30
    RunTask(Check)
    
    Test.name = "Pop returns 20"
    Test.actual = XStack.XPop(stack)
    Test.expected = 20
    RunTask(Check)
    
    Test.name = "Pop returns 10"
    Test.actual = XStack.XPop(stack)
    Test.expected = 10
    RunTask(Check)
    
    Test.name = "Stack now empty"
    Test.actual = XStack.XIsEmpty(stack)
    Test.expected = 1
    RunTask(Check)
    
    XArray.XDestroy(stack)
}

// =============================================================================
// TEST 8: Queue Operations
// =============================================================================
SubRoutine.Test_Queue {
    PrintMessage("\n=== TEST 8: Queue Operations ===\n")
    
    queue = XQueue.XCreate(8)
    
    XQueue.XEnqueue(queue, 100)
    XQueue.XEnqueue(queue, 200)
    XQueue.XEnqueue(queue, 300)
    
    Test.name = "Dequeue returns 100 (FIFO)"
    Test.actual = XQueue.XDequeue(queue)
    Test.expected = 100
    RunTask(Check)
    
    Test.name = "Dequeue returns 200"
    Test.actual = XQueue.XDequeue(queue)
    Test.expected = 200
    RunTask(Check)
    
    // Enqueue more
    XQueue.XEnqueue(queue, 400)
    XQueue.XEnqueue(queue, 500)
    
    Test.name = "Dequeue returns 300"
    Test.actual = XQueue.XDequeue(queue)
    Test.expected = 300
    RunTask(Check)
    
    Test.name = "Dequeue returns 400"
    Test.actual = XQueue.XDequeue(queue)
    Test.expected = 400
    RunTask(Check)
    
    Test.name = "Dequeue returns 500"
    Test.actual = XQueue.XDequeue(queue)
    Test.expected = 500
    RunTask(Check)
    
    // Should be empty now, free manually (queue struct is 64 bytes)
    Arena_Free64(queue)
}

// =============================================================================
// TEST 9: Large Array (mmap path)
// =============================================================================
SubRoutine.Test_LargeArray {
    PrintMessage("\n=== TEST 9: Large Array (mmap path) ===\n")
    
    // Create array large enough to use mmap (>128 elements)
    arr = XArray.XCreate(256)
    
    Test.name = "Large array created"
    Test.actual = arr
    RunTask(CheckNotZero)
    
    // Fill with pattern
    fill_idx = 0
    WhileLoop LessThan(fill_idx, 256) {
        XArray.XPush(arr, Multiply(fill_idx, 3))
        fill_idx = Add(fill_idx, 1)
    }
    
    Test.name = "Size is 256"
    Test.actual = XArray.XSize(arr)
    Test.expected = 256
    RunTask(Check)
    
    Test.name = "Element 0 is 0"
    Test.actual = XArray.XGet(arr, 0)
    Test.expected = 0
    RunTask(Check)
    
    Test.name = "Element 100 is 300"
    Test.actual = XArray.XGet(arr, 100)
    Test.expected = 300
    RunTask(Check)
    
    Test.name = "Element 255 is 765"
    Test.actual = XArray.XGet(arr, 255)
    Test.expected = 765
    RunTask(Check)
    
    XArray.XDestroy(arr)
}

// =============================================================================
// TEST 10: Stress Test - Many Create/Destroy Cycles
// =============================================================================
SubRoutine.Test_Stress {
    PrintMessage("\n=== TEST 10: Stress Test ===\n")
    PrintMessage("  Creating/destroying 1000 arrays...\n")
    
    stress_idx = 0
    errors = 0
    WhileLoop LessThan(stress_idx, 1000) {
        arr = XArray.XCreate(16)
        
        // Push some data
        XArray.XPush(arr, stress_idx)
        XArray.XPush(arr, Multiply(stress_idx, 2))
        XArray.XPush(arr, Multiply(stress_idx, 3))
        
        // Verify
        val = XArray.XGet(arr, 0)
        IfCondition NotEqual(val, stress_idx) ThenBlock: {
            errors = Add(errors, 1)
        }
        
        XArray.XDestroy(arr)
        stress_idx = Add(stress_idx, 1)
    }
    
    Test.name = "1000 create/destroy cycles with 0 errors"
    Test.actual = errors
    Test.expected = 0
    RunTask(Check)
}

// =============================================================================
// TEST 11: Data Integrity Under Resize
// =============================================================================
SubRoutine.Test_ResizeIntegrity {
    PrintMessage("\n=== TEST 11: Data Integrity Under Multiple Resizes ===\n")
    
    arr = XArray.XCreate(2)  // Tiny - will resize many times
    
    // Push 100 values, triggering multiple resizes
    push_idx = 0
    WhileLoop LessThan(push_idx, 100) {
        XArray.XPush(arr, Add(1000, push_idx))
        push_idx = Add(push_idx, 1)
    }
    
    Test.name = "Size is 100"
    Test.actual = XArray.XSize(arr)
    Test.expected = 100
    RunTask(Check)
    
    // Verify all values
    errors = 0
    verify_idx = 0
    WhileLoop LessThan(verify_idx, 100) {
        val = XArray.XGet(arr, verify_idx)
        expected = Add(1000, verify_idx)
        IfCondition NotEqual(val, expected) ThenBlock: {
            errors = Add(errors, 1)
            PrintMessage("  ERROR at index ")
            PrintNumber(verify_idx)
            PrintMessage(": expected ")
            PrintNumber(expected)
            PrintMessage(" got ")
            PrintNumber(val)
            PrintMessage("\n")
        }
        verify_idx = Add(verify_idx, 1)
    }
    
    Test.name = "All 100 values correct after resizes"
    Test.actual = errors
    Test.expected = 0
    RunTask(Check)
    
    XArray.XDestroy(arr)
}

// =============================================================================
// TEST 12: Interleaved Operations
// =============================================================================
SubRoutine.Test_Interleaved {
    PrintMessage("\n=== TEST 12: Interleaved Operations ===\n")
    
    arr = XArray.XCreate(8)
    
    // Push, set, push, get, pop pattern
    XArray.XPush(arr, 10)
    XArray.XPush(arr, 20)
    XArray.XSet(arr, 0, 15)
    XArray.XPush(arr, 30)
    
    Test.name = "After push/set/push, element 0 is 15"
    Test.actual = XArray.XGet(arr, 0)
    Test.expected = 15
    RunTask(Check)
    
    Test.name = "Element 2 is 30"
    Test.actual = XArray.XGet(arr, 2)
    Test.expected = 30
    RunTask(Check)
    
    popped = XArray.XPop(arr)
    Test.name = "Pop returns 30"
    Test.actual = popped
    Test.expected = 30
    RunTask(Check)
    
    XArray.XPush(arr, 40)
    XArray.XPush(arr, 50)
    
    Test.name = "Size is 4"
    Test.actual = XArray.XSize(arr)
    Test.expected = 4
    RunTask(Check)
    
    // Clear and refill
    XArray.XClear(arr)
    XArray.XPush(arr, 999)
    
    Test.name = "After clear and push, element 0 is 999"
    Test.actual = XArray.XGet(arr, 0)
    Test.expected = 999
    RunTask(Check)
    
    XArray.XDestroy(arr)
}

// =============================================================================
// MAIN
// =============================================================================

PrintMessage("╔═══════════════════════════════════════════════════╗\n")
PrintMessage("║   XARRAY ARENA INTEGRATION TEST SUITE             ║\n")
PrintMessage("╚═══════════════════════════════════════════════════╝\n")

// Initialize arena
PrintMessage("\nInitializing Arena allocator...\n")
Arena_Init()
PrintMessage("Arena ready.\n")

// Run all tests
RunTask(Test_CreateDestroy)
RunTask(Test_PushSize)
RunTask(Test_GetSet)
RunTask(Test_Pop)
RunTask(Test_Resize)
RunTask(Test_Clear)
RunTask(Test_Stack)
RunTask(Test_Queue)
RunTask(Test_LargeArray)
RunTask(Test_Stress)
RunTask(Test_ResizeIntegrity)
RunTask(Test_Interleaved)

// Results
PrintMessage("\n╔═══════════════════════════════════════════════════╗\n")
PrintMessage("║               TEST RESULTS                        ║\n")
PrintMessage("╚═══════════════════════════════════════════════════╝\n")
PrintMessage("Passed: ")
PrintNumber(Test.passed)
PrintMessage("\nFailed: ")
PrintNumber(Test.failed)
PrintMessage("\nTotal:  ")
PrintNumber(Test.total)
PrintMessage("\n")

IfCondition EqualTo(Test.failed, 0) ThenBlock: {
    PrintMessage("\n✓ ALL TESTS PASSED\n")
} ElseBlock: {
    PrintMessage("\n✗ SOME TESTS FAILED\n")
}

// Memory report
PrintMessage("\n")
Arena_Report()