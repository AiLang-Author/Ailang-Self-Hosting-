// xarray_full_test.ailang
// COMPREHENSIVE test suite for Arena-integrated XArrays library
// Tests ALL functions to ensure compiler compatibility
//
// Run: python3 main.py xarray_full_test.ailang
//      ./xarray_full_test.x

LibraryImport.Arrays
LibraryImport.Arena

// =============================================================================
// TEST FRAMEWORK
// =============================================================================
FixedPool.Test {
    "passed": Initialize=0
    "failed": Initialize=0
    "total": Initialize=0
    "name": Initialize=0
    "actual": Initialize=0
    "expected": Initialize=0
    "section": Initialize=0
}

SubRoutine.Pass {
    Test.passed = Add(Test.passed, 1)
    Test.total = Add(Test.total, 1)
    PrintMessage("  [PASS] ")
    PrintMessage(Test.name)
    PrintMessage("\n")
}

SubRoutine.Fail {
    Test.failed = Add(Test.failed, 1)
    Test.total = Add(Test.total, 1)
    PrintMessage("  [FAIL] ")
    PrintMessage(Test.name)
    PrintMessage(" - expected ")
    PrintNumber(Test.expected)
    PrintMessage(" got ")
    PrintNumber(Test.actual)
    PrintMessage("\n")
}

SubRoutine.Check {
    IfCondition EqualTo(Test.actual, Test.expected) ThenBlock: {
        RunTask(Pass)
    } ElseBlock: {
        RunTask(Fail)
    }
}

SubRoutine.CheckNotZero {
    IfCondition NotEqual(Test.actual, 0) ThenBlock: {
        RunTask(Pass)
    } ElseBlock: {
        Test.expected = 1
        Test.actual = 0
        RunTask(Fail)
    }
}

SubRoutine.CheckNotNull {
    IfCondition NotEqual(Test.actual, -1) ThenBlock: {
        RunTask(Pass)
    } ElseBlock: {
        Test.expected = 0
        Test.actual = -1
        RunTask(Fail)
    }
}

SubRoutine.SectionHeader {
    PrintMessage("\n")
    PrintMessage("═══════════════════════════════════════════════════════════════\n")
    PrintMessage("  ")
    PrintMessage(Test.section)
    PrintMessage("\n")
    PrintMessage("═══════════════════════════════════════════════════════════════\n")
}

// =============================================================================
// TEST 1: XArray Core (Create, Size, Capacity, Push, Pop, Get, Set, Clear, Destroy)
// =============================================================================
SubRoutine.Test_XArray_Core {
    Test.section = "TEST 1: XArray Core Operations"
    RunTask(SectionHeader)
    
    // Create
    Test.name = "XCreate(16) returns non-null"
    arr = Array.Create(16)
    Test.actual = arr
    RunTask(CheckNotZero)
    
    Test.name = "Initial size is 0"
    Test.actual = Array.Size(arr)
    Test.expected = 0
    RunTask(Check)
    
    Test.name = "Initial capacity is 16"
    Test.actual = Array.Capacity(arr)
    Test.expected = 16
    RunTask(Check)
    
    // Push
    Array.Push(arr, 10)
    Array.Push(arr, 20)
    Array.Push(arr, 30)
    Array.Push(arr, 40)
    Array.Push(arr, 50)
    
    Test.name = "After 5 pushes, size is 5"
    Test.actual = Array.Size(arr)
    Test.expected = 5
    RunTask(Check)
    
    // Get
    Test.name = "XGet(0) returns 10"
    Test.actual = Array.Get(arr, 0)
    Test.expected = 10
    RunTask(Check)
    
    Test.name = "XGet(2) returns 30"
    Test.actual = Array.Get(arr, 2)
    Test.expected = 30
    RunTask(Check)
    
    Test.name = "XGet(4) returns 50"
    Test.actual = Array.Get(arr, 4)
    Test.expected = 50
    RunTask(Check)
    
    // Set
    Array.Set(arr, 2, 999)
    Test.name = "After XSet(2, 999), XGet(2) is 999"
    Test.actual = Array.Get(arr, 2)
    Test.expected = 999
    RunTask(Check)
    
    // Pop
    Test.name = "XPop returns 50 (last element)"
    Test.actual = Array.Pop(arr)
    Test.expected = 50
    RunTask(Check)
    
    Test.name = "Size is now 4"
    Test.actual = Array.Size(arr)
    Test.expected = 4
    RunTask(Check)
    
    // Clear
    Array.Clear(arr)
    Test.name = "After XClear, size is 0"
    Test.actual = Array.Size(arr)
    Test.expected = 0
    RunTask(Check)
    
    Test.name = "Capacity unchanged after clear"
    Test.actual = Array.Capacity(arr)
    Test.expected = 16
    RunTask(Check)
    
    // Bounds checking
    Test.name = "XGet(-1) returns XERROR"
    Test.actual = Array.Get(arr, -1)
    Test.expected = -999999
    RunTask(Check)
    
    Array.Destroy(arr)
    PrintMessage("  XArray Core: COMPLETE\n")
}

// =============================================================================
// TEST 2: XArray Extended (First, Last, IsEmpty, IndexOf, Contains)
// =============================================================================
SubRoutine.Test_XArray_Extended {
    Test.section = "TEST 2: XArray Extended Operations"
    RunTask(SectionHeader)
    
    arr = Array.Create(16)
    
    // IsEmpty
    Test.name = "New array IsEmpty returns 1"
    Test.actual = Array.IsEmpty(arr)
    Test.expected = 1
    RunTask(Check)
    
    Array.Push(arr, 100)
    Array.Push(arr, 200)
    Array.Push(arr, 300)
    Array.Push(arr, 400)
    Array.Push(arr, 500)
    
    Test.name = "After pushes, IsEmpty returns 0"
    Test.actual = Array.IsEmpty(arr)
    Test.expected = 0
    RunTask(Check)
    
    // First and Last
    Test.name = "XFirst returns 100"
    Test.actual = Array.First(arr)
    Test.expected = 100
    RunTask(Check)
    
    Test.name = "XLast returns 500"
    Test.actual = Array.Last(arr)
    Test.expected = 500
    RunTask(Check)
    
    // IndexOf
    Test.name = "XIndexOf(300) returns 2"
    Test.actual = Array.IndexOf(arr, 300)
    Test.expected = 2
    RunTask(Check)
    
    Test.name = "XIndexOf(100) returns 0"
    Test.actual = Array.IndexOf(arr, 100)
    Test.expected = 0
    RunTask(Check)
    
    Test.name = "XIndexOf(999) returns XNULL (-1)"
    Test.actual = Array.IndexOf(arr, 999)
    Test.expected = -1
    RunTask(Check)
    
    // Contains
    Test.name = "XContains(300) returns 1"
    Test.actual = Array.Contains(arr, 300)
    Test.expected = 1
    RunTask(Check)
    
    Test.name = "XContains(999) returns 0"
    Test.actual = Array.Contains(arr, 999)
    Test.expected = 0
    RunTask(Check)
    
    Array.Destroy(arr)
    PrintMessage("  XArray Extended: COMPLETE\n")
}

// =============================================================================
// TEST 3: XArray Insert/Delete/Shift
// =============================================================================
SubRoutine.Test_XArray_InsertDelete {
    Test.section = "TEST 3: XArray Insert/Delete/Shift"
    RunTask(SectionHeader)
    
    arr = Array.Create(16)
    Array.Push(arr, 10)
    Array.Push(arr, 20)
    Array.Push(arr, 30)
    Array.Push(arr, 40)
    // arr = [10, 20, 30, 40]
    
    // Insert at middle
    Array.Insert(arr, 2, 25)
    // arr = [10, 20, 25, 30, 40]
    
    Test.name = "After XInsert(2, 25), size is 5"
    Test.actual = Array.Size(arr)
    Test.expected = 5
    RunTask(Check)
    
    Test.name = "Element at index 2 is 25"
    Test.actual = Array.Get(arr, 2)
    Test.expected = 25
    RunTask(Check)
    
    Test.name = "Element at index 3 is 30 (shifted)"
    Test.actual = Array.Get(arr, 3)
    Test.expected = 30
    RunTask(Check)
    
    // Insert at beginning
    Array.Insert(arr, 0, 5)
    // arr = [5, 10, 20, 25, 30, 40]
    
    Test.name = "After XInsert(0, 5), first element is 5"
    Test.actual = Array.Get(arr, 0)
    Test.expected = 5
    RunTask(Check)
    
    Test.name = "Size is now 6"
    Test.actual = Array.Size(arr)
    Test.expected = 6
    RunTask(Check)
    
    // Delete from middle
    deleted = Array.Delete(arr, 2)
    // arr = [5, 10, 25, 30, 40]
    
    Test.name = "XDelete(2) returns 20"
    Test.actual = deleted
    Test.expected = 20
    RunTask(Check)
    
    Test.name = "Size is now 5"
    Test.actual = Array.Size(arr)
    Test.expected = 5
    RunTask(Check)
    
    Test.name = "Element at index 2 is now 25"
    Test.actual = Array.Get(arr, 2)
    Test.expected = 25
    RunTask(Check)
    
    // Shift (remove first)
    shifted = Array.Shift(arr)
    // arr = [10, 25, 30, 40]
    
    Test.name = "XShift returns 5 (first element)"
    Test.actual = shifted
    Test.expected = 5
    RunTask(Check)
    
    Test.name = "Size is now 4"
    Test.actual = Array.Size(arr)
    Test.expected = 4
    RunTask(Check)
    
    Test.name = "New first element is 10"
    Test.actual = Array.Get(arr, 0)
    Test.expected = 10
    RunTask(Check)
    
    Array.Destroy(arr)
    PrintMessage("  XArray Insert/Delete/Shift: COMPLETE\n")
}

// =============================================================================
// TEST 4: XArray Swap, Copy, Resize
// =============================================================================
SubRoutine.Test_XArray_SwapCopyResize {
    Test.section = "TEST 4: XArray Swap/Copy/Resize"
    RunTask(SectionHeader)
    
    arr = Array.Create(8)
    Array.Push(arr, 100)
    Array.Push(arr, 200)
    Array.Push(arr, 300)
    Array.Push(arr, 400)
    
    // Swap
    Array.Swap(arr, 0, 3)
    Test.name = "After XSwap(0, 3), element 0 is 400"
    Test.actual = Array.Get(arr, 0)
    Test.expected = 400
    RunTask(Check)
    
    Test.name = "Element 3 is 100"
    Test.actual = Array.Get(arr, 3)
    Test.expected = 100
    RunTask(Check)
    
    // Copy
    copy = Array.Copy(arr)
    Test.name = "XCopy returns non-null"
    Test.actual = copy
    RunTask(CheckNotZero)
    
    Test.name = "Copy has same size"
    Test.actual = Array.Size(copy)
    Test.expected = 4
    RunTask(Check)
    
    Test.name = "Copy element 0 matches"
    Test.actual = Array.Get(copy, 0)
    Test.expected = 400
    RunTask(Check)
    
    // Modify original, copy should be independent
    Array.Set(arr, 0, 999)
    Test.name = "Copy is independent (original modified)"
    Test.actual = Array.Get(copy, 0)
    Test.expected = 400
    RunTask(Check)
    
    Array.Destroy(copy)
    
    // Resize
    Test.name = "Original capacity is 8"
    Test.actual = Array.Capacity(arr)
    Test.expected = 8
    RunTask(Check)
    
    Array.Resize(arr, 32)
    Test.name = "After XResize(32), capacity is 32"
    Test.actual = Array.Capacity(arr)
    Test.expected = 32
    RunTask(Check)
    
    Test.name = "Size preserved after resize"
    Test.actual = Array.Size(arr)
    Test.expected = 4
    RunTask(Check)
    
    Test.name = "Data preserved after resize"
    Test.actual = Array.Get(arr, 1)
    Test.expected = 200
    RunTask(Check)
    
    Array.Destroy(arr)
    PrintMessage("  XArray Swap/Copy/Resize: COMPLETE\n")
}

// =============================================================================
// TEST 5: XArray InsertSorted, BinarySearch
// =============================================================================
SubRoutine.Test_XArray_Sorted {
    Test.section = "TEST 5: XArray Sorted Operations"
    RunTask(SectionHeader)
    
    arr = Array.Create(16)
    
    // Build sorted array using InsertSorted
    Array.InsertSorted(arr, 50)
    Array.InsertSorted(arr, 20)
    Array.InsertSorted(arr, 80)
    Array.InsertSorted(arr, 10)
    Array.InsertSorted(arr, 60)
    Array.InsertSorted(arr, 40)
    // Should be: [10, 20, 40, 50, 60, 80]
    
    Test.name = "Size is 6"
    Test.actual = Array.Size(arr)
    Test.expected = 6
    RunTask(Check)
    
    Test.name = "Element 0 is 10 (sorted)"
    Test.actual = Array.Get(arr, 0)
    Test.expected = 10
    RunTask(Check)
    
    Test.name = "Element 2 is 40 (sorted)"
    Test.actual = Array.Get(arr, 2)
    Test.expected = 40
    RunTask(Check)
    
    Test.name = "Element 5 is 80 (sorted)"
    Test.actual = Array.Get(arr, 5)
    Test.expected = 80
    RunTask(Check)
    
    // BinarySearch
    Test.name = "XBinarySearch(40) returns 2"
    Test.actual = Array.BinarySearch(arr, 40)
    Test.expected = 2
    RunTask(Check)
    
    Test.name = "XBinarySearch(10) returns 0"
    Test.actual = Array.BinarySearch(arr, 10)
    Test.expected = 0
    RunTask(Check)
    
    Test.name = "XBinarySearch(80) returns 5"
    Test.actual = Array.BinarySearch(arr, 80)
    Test.expected = 5
    RunTask(Check)
    
    Test.name = "XBinarySearch(99) returns XNULL"
    Test.actual = Array.BinarySearch(arr, 99)
    Test.expected = -1
    RunTask(Check)
    
    Array.Destroy(arr)
    PrintMessage("  XArray Sorted: COMPLETE\n")
}

// =============================================================================
// TEST 6: XArray Auto-Resize Stress
// =============================================================================
SubRoutine.Test_XArray_AutoResize {
    Test.section = "TEST 6: XArray Auto-Resize Stress"
    RunTask(SectionHeader)
    
    arr = Array.Create(2)
    
    Test.name = "Initial capacity is 2"
    Test.actual = Array.Capacity(arr)
    Test.expected = 2
    RunTask(Check)
    
    // Push 100 elements, forcing many resizes
    idx = 0
    WhileLoop LessThan(idx, 100) {
        Array.Push(arr, Add(1000, idx))
        idx = Add(idx, 1)
    }
    
    Test.name = "Size is 100"
    Test.actual = Array.Size(arr)
    Test.expected = 100
    RunTask(Check)
    
    Test.name = "Capacity >= 100"
    cap = Array.Capacity(arr)
    IfCondition GreaterEqual(cap, 100) ThenBlock: {
        Test.actual = 1
        Test.expected = 1
    } ElseBlock: {
        Test.actual = cap
        Test.expected = 100
    }
    RunTask(Check)
    
    // Verify data integrity
    errors = 0
    idx = 0
    WhileLoop LessThan(idx, 100) {
        val = Array.Get(arr, idx)
        expected = Add(1000, idx)
        IfCondition NotEqual(val, expected) ThenBlock: {
            errors = Add(errors, 1)
        }
        idx = Add(idx, 1)
    }
    
    Test.name = "All 100 values correct"
    Test.actual = errors
    Test.expected = 0
    RunTask(Check)
    
    Array.Destroy(arr)
    PrintMessage("  XArray Auto-Resize: COMPLETE\n")
}

// =============================================================================
// TEST 7: XStack Operations
// =============================================================================
SubRoutine.Test_XStack {
    Test.section = "TEST 7: XStack Operations"
    RunTask(SectionHeader)
    
    stack = Stack.Create(16)
    
    Test.name = "New stack is empty"
    Test.actual = Stack.IsEmpty(stack)
    Test.expected = 1
    RunTask(Check)
    
    Stack.Push(stack, 10)
    Stack.Push(stack, 20)
    Stack.Push(stack, 30)
    
    Test.name = "After 3 pushes, not empty"
    Test.actual = Stack.IsEmpty(stack)
    Test.expected = 0
    RunTask(Check)
    
    Test.name = "XPeek returns 30 (top)"
    Test.actual = Stack.Peek(stack)
    Test.expected = 30
    RunTask(Check)
    
    Test.name = "Size still 3 after peek"
    Test.actual = Array.Size(stack)
    Test.expected = 3
    RunTask(Check)
    
    Test.name = "XPop returns 30"
    Test.actual = Stack.Pop(stack)
    Test.expected = 30
    RunTask(Check)
    
    Test.name = "XPop returns 20"
    Test.actual = Stack.Pop(stack)
    Test.expected = 20
    RunTask(Check)
    
    Test.name = "XPop returns 10"
    Test.actual = Stack.Pop(stack)
    Test.expected = 10
    RunTask(Check)
    
    Test.name = "Stack now empty"
    Test.actual = Stack.IsEmpty(stack)
    Test.expected = 1
    RunTask(Check)
    
    Test.name = "XPop from empty returns XERROR"
    Test.actual = Stack.Pop(stack)
    Test.expected = -999999
    RunTask(Check)
    
    Array.Destroy(stack)
    PrintMessage("  XStack: COMPLETE\n")
}

// =============================================================================
// TEST 8: XQueue Operations
// =============================================================================
SubRoutine.Test_XQueue {
    Test.section = "TEST 8: XQueue Operations"
    RunTask(SectionHeader)
    
    queue = Queue.Create(8)
    
    Test.name = "XQueue created"
    Test.actual = queue
    RunTask(CheckNotZero)
    
    Queue.Enqueue(queue, 100)
    Queue.Enqueue(queue, 200)
    Queue.Enqueue(queue, 300)
    
    Test.name = "Dequeue returns 100 (FIFO)"
    Test.actual = Queue.Dequeue(queue)
    Test.expected = 100
    RunTask(Check)
    
    Test.name = "Dequeue returns 200"
    Test.actual = Queue.Dequeue(queue)
    Test.expected = 200
    RunTask(Check)
    
    // Enqueue more (test circular buffer)
    Queue.Enqueue(queue, 400)
    Queue.Enqueue(queue, 500)
    Queue.Enqueue(queue, 600)
    
    Test.name = "Dequeue returns 300"
    Test.actual = Queue.Dequeue(queue)
    Test.expected = 300
    RunTask(Check)
    
    Test.name = "Dequeue returns 400"
    Test.actual = Queue.Dequeue(queue)
    Test.expected = 400
    RunTask(Check)
    
    Test.name = "Dequeue returns 500"
    Test.actual = Queue.Dequeue(queue)
    Test.expected = 500
    RunTask(Check)
    
    Test.name = "Dequeue returns 600"
    Test.actual = Queue.Dequeue(queue)
    Test.expected = 600
    RunTask(Check)
    
    Test.name = "Dequeue from empty returns XERROR"
    Test.actual = Queue.Dequeue(queue)
    Test.expected = -999999
    RunTask(Check)
    
    Queue.Destroy(queue)
    PrintMessage("  XQueue: COMPLETE\n")
}

// =============================================================================
// TEST 9: XHash (Integer Keys)
// =============================================================================
SubRoutine.Test_XHash {
    Test.section = "TEST 9: XHash (Integer Keys)"
    RunTask(SectionHeader)
    
    hash = IHash.Create(17)
    
    Test.name = "XHash created"
    Test.actual = hash
    RunTask(CheckNotZero)
    
    IHash.Insert(hash, 100, 1000)
    IHash.Insert(hash, 200, 2000)
    IHash.Insert(hash, 300, 3000)
    IHash.Insert(hash, 17, 170)
    IHash.Insert(hash, 34, 340)
    
    Test.name = "XLookup(100) returns 1000"
    Test.actual = IHash.Lookup(hash, 100)
    Test.expected = 1000
    RunTask(Check)
    
    Test.name = "XLookup(200) returns 2000"
    Test.actual = IHash.Lookup(hash, 200)
    Test.expected = 2000
    RunTask(Check)
    
    Test.name = "XLookup(300) returns 3000"
    Test.actual = IHash.Lookup(hash, 300)
    Test.expected = 3000
    RunTask(Check)
    
    Test.name = "XLookup(17) returns 170 (collision test)"
    Test.actual = IHash.Lookup(hash, 17)
    Test.expected = 170
    RunTask(Check)
    
    Test.name = "XLookup(34) returns 340 (collision test)"
    Test.actual = IHash.Lookup(hash, 34)
    Test.expected = 340
    RunTask(Check)
    
    Test.name = "XLookup(999) returns XERROR"
    Test.actual = IHash.Lookup(hash, 999)
    Test.expected = -999999
    RunTask(Check)
    
    IHash.Destroy(hash)
    PrintMessage("  XHash: COMPLETE\n")
}

// =============================================================================
// TEST 10: XSHash (String Keys)
// =============================================================================
SubRoutine.Test_XSHash {
    Test.section = "TEST 10: XSHash (String Keys)"
    RunTask(SectionHeader)
    
    hash = SHash.Create(31)
    
    Test.name = "XSHash created"
    Test.actual = hash
    RunTask(CheckNotZero)
    
    SHash.Insert(hash, "alpha", 1)
    SHash.Insert(hash, "beta", 2)
    SHash.Insert(hash, "gamma", 3)
    SHash.Insert(hash, "delta", 4)
    SHash.Insert(hash, "epsilon", 5)
    
    Test.name = "XLookup('alpha') returns 1"
    Test.actual = SHash.Lookup(hash, "alpha")
    Test.expected = 1
    RunTask(Check)
    
    Test.name = "XLookup('gamma') returns 3"
    Test.actual = SHash.Lookup(hash, "gamma")
    Test.expected = 3
    RunTask(Check)
    
    Test.name = "XLookup('epsilon') returns 5"
    Test.actual = SHash.Lookup(hash, "epsilon")
    Test.expected = 5
    RunTask(Check)
    
    Test.name = "XExists('beta') returns 1"
    Test.actual = SHash.Exists(hash, "beta")
    Test.expected = 1
    RunTask(Check)
    
    Test.name = "XExists('omega') returns 0"
    Test.actual = SHash.Exists(hash, "omega")
    Test.expected = 0
    RunTask(Check)
    
    // Update existing key
    SHash.Insert(hash, "alpha", 100)
    Test.name = "After update, XLookup('alpha') returns 100"
    Test.actual = SHash.Lookup(hash, "alpha")
    Test.expected = 100
    RunTask(Check)
    
    // Delete
    deleted = SHash.Delete(hash, "gamma")
    Test.name = "XDelete('gamma') returns 3"
    Test.actual = deleted
    Test.expected = 3
    RunTask(Check)
    
    Test.name = "After delete, XExists('gamma') returns 0"
    Test.actual = SHash.Exists(hash, "gamma")
    Test.expected = 0
    RunTask(Check)
    
    // Keys
    keys = SHash.Keys(hash)
    Test.name = "XKeys returns non-null"
    Test.actual = keys
    RunTask(CheckNotZero)
    
    Test.name = "XKeys has 4 elements"
    Test.actual = Array.Size(keys)
    Test.expected = 4
    RunTask(Check)
    
    // Cleanup keys array (contains string pointers)
    k_idx = 0
    k_size = Array.Size(keys)
    WhileLoop LessThan(k_idx, k_size) {
        k_ptr = Array.Get(keys, k_idx)
        k_len = StringLength(k_ptr)
        Deallocate(k_ptr, Add(k_len, 1))
        k_idx = Add(k_idx, 1)
    }
    Array.Destroy(keys)
    
    SHash.Destroy(hash)
    PrintMessage("  XSHash: COMPLETE\n")
}

// =============================================================================
// TEST 11: XSHash Address Variants
// =============================================================================
SubRoutine.Test_XSHash_Addr {
    Test.section = "TEST 11: XSHash Address Variants"
    RunTask(SectionHeader)
    
    hash = SHash.Create(17)
    
    // Create some "objects" (just arrays for testing)
    obj1 = Array.Create(4)
    Array.Push(obj1, 111)
    
    obj2 = Array.Create(4)
    Array.Push(obj2, 222)
    
    obj3 = Array.Create(4)
    Array.Push(obj3, 333)
    
    // Insert addresses
    SHash.InsertAddr(hash, "object1", obj1)
    SHash.InsertAddr(hash, "object2", obj2)
    SHash.InsertAddr(hash, "object3", obj3)
    
    // Lookup addresses
    Test.name = "XLookupAddr('object1') returns correct ptr"
    looked = SHash.LookupAddr(hash, "object1")
    Test.actual = looked
    Test.expected = obj1
    RunTask(Check)
    
    Test.name = "Object1 data intact"
    Test.actual = Array.Get(looked, 0)
    Test.expected = 111
    RunTask(Check)
    
    Test.name = "XExistsAddr('object2') returns 1"
    Test.actual = SHash.ExistsAddr(hash, "object2")
    Test.expected = 1
    RunTask(Check)
    
    Test.name = "XExistsAddr('missing') returns 0"
    Test.actual = SHash.ExistsAddr(hash, "missing")
    Test.expected = 0
    RunTask(Check)
    
    // Delete and get address back
    deleted_obj = SHash.DeleteAddr(hash, "object3")
    Test.name = "XDeleteAddr returns object3 ptr"
    Test.actual = deleted_obj
    Test.expected = obj3
    RunTask(Check)
    
    // Clean up objects
    Array.Destroy(obj1)
    Array.Destroy(obj2)
    Array.Destroy(obj3)
    
    SHash.Destroy(hash)
    PrintMessage("  XSHash Addr: COMPLETE\n")
}

// =============================================================================
// TEST 12: XList Operations
// =============================================================================
SubRoutine.Test_XList {
    Test.section = "TEST 12: XList Operations"
    RunTask(SectionHeader)
    
    list = List.Create()
    
    Test.name = "XList created"
    Test.actual = list
    RunTask(CheckNotZero)
    
    Test.name = "Initial size is 0"
    Test.actual = List.Size(list)
    Test.expected = 0
    RunTask(Check)
    
    // Append
    List.Append(list, 10)
    List.Append(list, 20)
    List.Append(list, 30)
    
    Test.name = "After 3 appends, size is 3"
    Test.actual = List.Size(list)
    Test.expected = 3
    RunTask(Check)
    
    // Prepend
    List.Prepend(list, 5)
    // List: 5 -> 10 -> 20 -> 30
    
    Test.name = "After prepend, size is 4"
    Test.actual = List.Size(list)
    Test.expected = 4
    RunTask(Check)
    
    // PopFront
    Test.name = "XPopFront returns 5"
    Test.actual = List.PopFront(list)
    Test.expected = 5
    RunTask(Check)
    
    Test.name = "Size is now 3"
    Test.actual = List.Size(list)
    Test.expected = 3
    RunTask(Check)
    
    // PopBack
    Test.name = "XPopBack returns 30"
    Test.actual = List.PopBack(list)
    Test.expected = 30
    RunTask(Check)
    
    Test.name = "Size is now 2"
    Test.actual = List.Size(list)
    Test.expected = 2
    RunTask(Check)
    
    // Pop remaining
    List.PopFront(list)
    List.PopFront(list)
    
    Test.name = "Size is now 0"
    Test.actual = List.Size(list)
    Test.expected = 0
    RunTask(Check)
    
    List.Destroy(list)
    PrintMessage("  XList: COMPLETE\n")
}

// =============================================================================
// TEST 13: XUtil Functions
// =============================================================================
SubRoutine.Test_XUtil {
    Test.section = "TEST 13: XUtil Functions"
    RunTask(SectionHeader)
    
    arr = Array.Create(16)
    Array.Push(arr, 50)
    Array.Push(arr, 20)
    Array.Push(arr, 80)
    Array.Push(arr, 10)
    Array.Push(arr, 60)
    Array.Push(arr, 40)
    Array.Push(arr, 30)
    Array.Push(arr, 70)
    
    // FindMax/FindMin
    Test.name = "XFindMax returns 80"
    Test.actual = Util.FindMax(arr)
    Test.expected = 80
    RunTask(Check)
    
    Test.name = "XFindMin returns 10"
    Test.actual = Util.FindMin(arr)
    Test.expected = 10
    RunTask(Check)
    
    // QuickSort
    size = Array.Size(arr)
    Util.QuickSort(arr, 0, Subtract(size, 1))
    // Should be: [10, 20, 30, 40, 50, 60, 70, 80]
    
    Test.name = "After sort, element 0 is 10"
    Test.actual = Array.Get(arr, 0)
    Test.expected = 10
    RunTask(Check)
    
    Test.name = "After sort, element 3 is 40"
    Test.actual = Array.Get(arr, 3)
    Test.expected = 40
    RunTask(Check)
    
    Test.name = "After sort, element 7 is 80"
    Test.actual = Array.Get(arr, 7)
    Test.expected = 80
    RunTask(Check)
    
    // BinarySearch on sorted array
    Test.name = "XBinarySearch(40) on sorted returns 3"
    Test.actual = Util.BinarySearch(arr, 40)
    Test.expected = 3
    RunTask(Check)
    
    // Reverse
    Util.Reverse(arr)
    // Should be: [80, 70, 60, 50, 40, 30, 20, 10]
    
    Test.name = "After reverse, element 0 is 80"
    Test.actual = Array.Get(arr, 0)
    Test.expected = 80
    RunTask(Check)
    
    Test.name = "After reverse, element 7 is 10"
    Test.actual = Array.Get(arr, 7)
    Test.expected = 10
    RunTask(Check)
    
    Array.Destroy(arr)
    PrintMessage("  XUtil: COMPLETE\n")
}

// =============================================================================
// TEST 14: Stress Test - Many Operations
// =============================================================================
SubRoutine.Test_Stress {
    Test.section = "TEST 14: Stress Test"
    RunTask(SectionHeader)
    
    PrintMessage("  Creating/destroying 500 arrays with operations...\n")
    
    errors = 0
    idx = 0
    WhileLoop LessThan(idx, 500) {
        arr = Array.Create(8)
        Array.Push(arr, idx)
        Array.Push(arr, Multiply(idx, 2))
        Array.Push(arr, Multiply(idx, 3))
        
        val = Array.Get(arr, 0)
        IfCondition NotEqual(val, idx) ThenBlock: {
            errors = Add(errors, 1)
        }
        
        Array.Destroy(arr)
        idx = Add(idx, 1)
    }
    
    Test.name = "500 array cycles with 0 errors"
    Test.actual = errors
    Test.expected = 0
    RunTask(Check)
    
    PrintMessage("  Creating/destroying 200 hash tables...\n")
    
    errors = 0
    idx = 0
    WhileLoop LessThan(idx, 200) {
        hash = SHash.Create(17)
        SHash.Insert(hash, "key1", idx)
        SHash.Insert(hash, "key2", Multiply(idx, 2))
        
        val = SHash.Lookup(hash, "key1")
        IfCondition NotEqual(val, idx) ThenBlock: {
            errors = Add(errors, 1)
        }
        
        SHash.Destroy(hash)
        idx = Add(idx, 1)
    }
    
    Test.name = "200 hash table cycles with 0 errors"
    Test.actual = errors
    Test.expected = 0
    RunTask(Check)
    
    PrintMessage("  Stress Test: COMPLETE\n")
}

// =============================================================================
// TEST 15: Mixed Operations (Compiler-like usage)
// =============================================================================
SubRoutine.Test_CompilerLike {
    Test.section = "TEST 15: Compiler-Like Usage Patterns"
    RunTask(SectionHeader)
    
    // Simulate symbol table
    symbols = SHash.Create(127)
    
    // Simulate AST node list
    ast_nodes = Array.Create(64)
    
    // Simulate scope stack
    scope_stack = Stack.Create(32)
    
    // Add symbols
    SHash.Insert(symbols, "main", 1)
    SHash.Insert(symbols, "printf", 2)
    SHash.Insert(symbols, "x", 3)
    SHash.Insert(symbols, "y", 4)
    SHash.Insert(symbols, "result", 5)
    
    // Add AST nodes
    node_idx = 0
    WhileLoop LessThan(node_idx, 50) {
        Array.Push(ast_nodes, Add(1000, node_idx))
        node_idx = Add(node_idx, 1)
    }
    
    // Push/pop scopes
    Stack.Push(scope_stack, 0)
    Stack.Push(scope_stack, 1)
    Stack.Push(scope_stack, 2)
    
    Test.name = "Symbol 'main' found"
    Test.actual = SHash.Lookup(symbols, "main")
    Test.expected = 1
    RunTask(Check)
    
    Test.name = "Symbol 'result' found"
    Test.actual = SHash.Lookup(symbols, "result")
    Test.expected = 5
    RunTask(Check)
    
    Test.name = "AST has 50 nodes"
    Test.actual = Array.Size(ast_nodes)
    Test.expected = 50
    RunTask(Check)
    
    Test.name = "Current scope is 2"
    Test.actual = Stack.Peek(scope_stack)
    Test.expected = 2
    RunTask(Check)
    
    // Pop scope
    Stack.Pop(scope_stack)
    Test.name = "After pop, scope is 1"
    Test.actual = Stack.Peek(scope_stack)
    Test.expected = 1
    RunTask(Check)
    
    // Lookup symbol that doesn't exist
    Test.name = "Symbol 'undefined' not found"
    Test.actual = SHash.Lookup(symbols, "undefined")
    Test.expected = -1
    RunTask(Check)
    
    // Cleanup
    SHash.Destroy(symbols)
    Array.Destroy(ast_nodes)
    Array.Destroy(scope_stack)
    
    PrintMessage("  Compiler-Like: COMPLETE\n")
}

