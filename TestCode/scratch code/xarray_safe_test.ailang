// xarray_safe_test.ailang
// Flow-controlled test suite - avoids subroutine state conflicts
// Uses inline assertions instead of RunTask for checks

LibraryImport.Arrays
LibraryImport.Arena

FixedPool.T {
    "pass": Initialize=0
    "fail": Initialize=0
    "total": Initialize=0
}

// Inline check macros - no subroutine calls
// We'll use simple if/else for each check

PrintMessage("╔════════════════════════════════════════════════════════════════╗\n")
PrintMessage("║   XARRAY SAFE TEST SUITE - Flow Controlled                     ║\n")
PrintMessage("╚════════════════════════════════════════════════════════════════╝\n\n")

Arena_Init()

// =============================================================================
// TEST 1: XArray Core
// =============================================================================
PrintMessage("=== TEST 1: XArray Core ===\n")

arr1 = Array.Create(16)
T.total = Add(T.total, 1)
IfCondition NotEqual(arr1, 0) ThenBlock: {
    T.pass = Add(T.pass, 1)
    PrintMessage("  [PASS] XCreate returns non-null\n")
} ElseBlock: {
    T.fail = Add(T.fail, 1)
    PrintMessage("  [FAIL] XCreate returns non-null\n")
}

T.total = Add(T.total, 1)
IfCondition EqualTo(Array.Size(arr1), 0) ThenBlock: {
    T.pass = Add(T.pass, 1)
    PrintMessage("  [PASS] Initial size is 0\n")
} ElseBlock: {
    T.fail = Add(T.fail, 1)
    PrintMessage("  [FAIL] Initial size is 0\n")
}

T.total = Add(T.total, 1)
IfCondition EqualTo(Array.Capacity(arr1), 16) ThenBlock: {
    T.pass = Add(T.pass, 1)
    PrintMessage("  [PASS] Capacity is 16\n")
} ElseBlock: {
    T.fail = Add(T.fail, 1)
    PrintMessage("  [FAIL] Capacity is 16\n")
}

Array.Push(arr1, 10)
Array.Push(arr1, 20)
Array.Push(arr1, 30)
Array.Push(arr1, 40)
Array.Push(arr1, 50)

T.total = Add(T.total, 1)
IfCondition EqualTo(Array.Size(arr1), 5) ThenBlock: {
    T.pass = Add(T.pass, 1)
    PrintMessage("  [PASS] After 5 pushes, size is 5\n")
} ElseBlock: {
    T.fail = Add(T.fail, 1)
    PrintMessage("  [FAIL] After 5 pushes, size is 5\n")
}

T.total = Add(T.total, 1)
IfCondition EqualTo(Array.Get(arr1, 0), 10) ThenBlock: {
    T.pass = Add(T.pass, 1)
    PrintMessage("  [PASS] XGet(0) returns 10\n")
} ElseBlock: {
    T.fail = Add(T.fail, 1)
    PrintMessage("  [FAIL] XGet(0) returns 10\n")
}

T.total = Add(T.total, 1)
IfCondition EqualTo(Array.Get(arr1, 2), 30) ThenBlock: {
    T.pass = Add(T.pass, 1)
    PrintMessage("  [PASS] XGet(2) returns 30\n")
} ElseBlock: {
    T.fail = Add(T.fail, 1)
    PrintMessage("  [FAIL] XGet(2) returns 30\n")
}

Array.Set(arr1, 2, 999)
T.total = Add(T.total, 1)
IfCondition EqualTo(Array.Get(arr1, 2), 999) ThenBlock: {
    T.pass = Add(T.pass, 1)
    PrintMessage("  [PASS] XSet works\n")
} ElseBlock: {
    T.fail = Add(T.fail, 1)
    PrintMessage("  [FAIL] XSet works\n")
}

popped1 = Array.Pop(arr1)
T.total = Add(T.total, 1)
IfCondition EqualTo(popped1, 50) ThenBlock: {
    T.pass = Add(T.pass, 1)
    PrintMessage("  [PASS] XPop returns 50\n")
} ElseBlock: {
    T.fail = Add(T.fail, 1)
    PrintMessage("  [FAIL] XPop returns 50\n")
}

Array.Clear(arr1)
T.total = Add(T.total, 1)
IfCondition EqualTo(Array.Size(arr1), 0) ThenBlock: {
    T.pass = Add(T.pass, 1)
    PrintMessage("  [PASS] XClear works\n")
} ElseBlock: {
    T.fail = Add(T.fail, 1)
    PrintMessage("  [FAIL] XClear works\n")
}

Array.Destroy(arr1)
PrintMessage("  TEST 1 COMPLETE\n\n")

// =============================================================================
// TEST 2: XArray Extended (First, Last, IsEmpty, IndexOf, Contains)
// =============================================================================
PrintMessage("=== TEST 2: XArray Extended ===\n")

arr2 = Array.Create(16)

T.total = Add(T.total, 1)
IfCondition EqualTo(Array.IsEmpty(arr2), 1) ThenBlock: {
    T.pass = Add(T.pass, 1)
    PrintMessage("  [PASS] New array IsEmpty\n")
} ElseBlock: {
    T.fail = Add(T.fail, 1)
    PrintMessage("  [FAIL] New array IsEmpty\n")
}

Array.Push(arr2, 100)
Array.Push(arr2, 200)
Array.Push(arr2, 300)
Array.Push(arr2, 400)
Array.Push(arr2, 500)

T.total = Add(T.total, 1)
IfCondition EqualTo(Array.First(arr2), 100) ThenBlock: {
    T.pass = Add(T.pass, 1)
    PrintMessage("  [PASS] XFirst returns 100\n")
} ElseBlock: {
    T.fail = Add(T.fail, 1)
    PrintMessage("  [FAIL] XFirst returns 100\n")
}

T.total = Add(T.total, 1)
IfCondition EqualTo(Array.Last(arr2), 500) ThenBlock: {
    T.pass = Add(T.pass, 1)
    PrintMessage("  [PASS] XLast returns 500\n")
} ElseBlock: {
    T.fail = Add(T.fail, 1)
    PrintMessage("  [FAIL] XLast returns 500\n")
}

T.total = Add(T.total, 1)
IfCondition EqualTo(Array.IndexOf(arr2, 300), 2) ThenBlock: {
    T.pass = Add(T.pass, 1)
    PrintMessage("  [PASS] XIndexOf(300) returns 2\n")
} ElseBlock: {
    T.fail = Add(T.fail, 1)
    PrintMessage("  [FAIL] XIndexOf(300) returns 2\n")
}

T.total = Add(T.total, 1)
IfCondition EqualTo(Array.Contains(arr2, 300), 1) ThenBlock: {
    T.pass = Add(T.pass, 1)
    PrintMessage("  [PASS] XContains(300) returns 1\n")
} ElseBlock: {
    T.fail = Add(T.fail, 1)
    PrintMessage("  [FAIL] XContains(300) returns 1\n")
}

T.total = Add(T.total, 1)
IfCondition EqualTo(Array.Contains(arr2, 999), 0) ThenBlock: {
    T.pass = Add(T.pass, 1)
    PrintMessage("  [PASS] XContains(999) returns 0\n")
} ElseBlock: {
    T.fail = Add(T.fail, 1)
    PrintMessage("  [FAIL] XContains(999) returns 0\n")
}

Array.Destroy(arr2)
PrintMessage("  TEST 2 COMPLETE\n\n")

// =============================================================================
// TEST 3: XArray Insert/Delete/Shift (THE CRASH AREA)
// =============================================================================
PrintMessage("=== TEST 3: XArray Insert/Delete/Shift ===\n")

arr3 = Array.Create(16)
Array.Push(arr3, 10)
Array.Push(arr3, 20)
Array.Push(arr3, 30)
Array.Push(arr3, 40)

PrintMessage("  Initial: [10, 20, 30, 40]\n")

// Insert at middle
Array.Insert(arr3, 2, 25)
PrintMessage("  After XInsert(2, 25): ")
idx3 = 0
sz3 = Array.Size(arr3)
WhileLoop LessThan(idx3, sz3) {
    PrintNumber(Array.Get(arr3, idx3))
    PrintMessage(" ")
    idx3 = Add(idx3, 1)
}
PrintMessage("\n")

T.total = Add(T.total, 1)
IfCondition EqualTo(Array.Size(arr3), 5) ThenBlock: {
    T.pass = Add(T.pass, 1)
    PrintMessage("  [PASS] Size is 5 after insert\n")
} ElseBlock: {
    T.fail = Add(T.fail, 1)
    PrintMessage("  [FAIL] Size is 5 after insert\n")
}

T.total = Add(T.total, 1)
IfCondition EqualTo(Array.Get(arr3, 2), 25) ThenBlock: {
    T.pass = Add(T.pass, 1)
    PrintMessage("  [PASS] Element 2 is 25\n")
} ElseBlock: {
    T.fail = Add(T.fail, 1)
    PrintMessage("  [FAIL] Element 2 is 25\n")
}

// Insert at beginning
Array.Insert(arr3, 0, 5)
PrintMessage("  After XInsert(0, 5): ")
idx3 = 0
sz3 = Array.Size(arr3)
WhileLoop LessThan(idx3, sz3) {
    PrintNumber(Array.Get(arr3, idx3))
    PrintMessage(" ")
    idx3 = Add(idx3, 1)
}
PrintMessage("\n")

T.total = Add(T.total, 1)
IfCondition EqualTo(Array.Get(arr3, 0), 5) ThenBlock: {
    T.pass = Add(T.pass, 1)
    PrintMessage("  [PASS] First element is 5\n")
} ElseBlock: {
    T.fail = Add(T.fail, 1)
    PrintMessage("  [FAIL] First element is 5\n")
}

// Delete from middle - arr3 = [5, 10, 20, 25, 30, 40]
PrintMessage("  About to XDelete(2)...\n")
del_val3 = Array.Delete(arr3, 2)
PrintMessage("  XDelete returned: ")
PrintNumber(del_val3)
PrintMessage("\n")

T.total = Add(T.total, 1)
IfCondition EqualTo(del_val3, 20) ThenBlock: {
    T.pass = Add(T.pass, 1)
    PrintMessage("  [PASS] XDelete(2) returns 20\n")
} ElseBlock: {
    T.fail = Add(T.fail, 1)
    PrintMessage("  [FAIL] XDelete(2) returns 20\n")
}

PrintMessage("  Checking size after delete...\n")
sz3_after = Array.Size(arr3)
PrintMessage("  Size = ")
PrintNumber(sz3_after)
PrintMessage("\n")

T.total = Add(T.total, 1)
IfCondition EqualTo(sz3_after, 5) ThenBlock: {
    T.pass = Add(T.pass, 1)
    PrintMessage("  [PASS] Size is 5 after delete\n")
} ElseBlock: {
    T.fail = Add(T.fail, 1)
    PrintMessage("  [FAIL] Size is 5 after delete\n")
}

PrintMessage("  After XDelete(2): ")
idx3 = 0
WhileLoop LessThan(idx3, sz3_after) {
    PrintNumber(Array.Get(arr3, idx3))
    PrintMessage(" ")
    idx3 = Add(idx3, 1)
}
PrintMessage("\n")

// Shift
PrintMessage("  About to XShift...\n")
shift_val3 = Array.Shift(arr3)
PrintMessage("  XShift returned: ")
PrintNumber(shift_val3)
PrintMessage("\n")

T.total = Add(T.total, 1)
IfCondition EqualTo(shift_val3, 5) ThenBlock: {
    T.pass = Add(T.pass, 1)
    PrintMessage("  [PASS] XShift returns 5\n")
} ElseBlock: {
    T.fail = Add(T.fail, 1)
    PrintMessage("  [FAIL] XShift returns 5\n")
}

T.total = Add(T.total, 1)
IfCondition EqualTo(Array.Size(arr3), 4) ThenBlock: {
    T.pass = Add(T.pass, 1)
    PrintMessage("  [PASS] Size is 4 after shift\n")
} ElseBlock: {
    T.fail = Add(T.fail, 1)
    PrintMessage("  [FAIL] Size is 4 after shift\n")
}

Array.Destroy(arr3)
PrintMessage("  TEST 3 COMPLETE\n\n")

// =============================================================================
// TEST 4: XArray Swap, Copy, Resize
// =============================================================================
PrintMessage("=== TEST 4: XArray Swap/Copy/Resize ===\n")

arr4 = Array.Create(8)
Array.Push(arr4, 100)
Array.Push(arr4, 200)
Array.Push(arr4, 300)
Array.Push(arr4, 400)

Array.Swap(arr4, 0, 3)

T.total = Add(T.total, 1)
IfCondition EqualTo(Array.Get(arr4, 0), 400) ThenBlock: {
    T.pass = Add(T.pass, 1)
    PrintMessage("  [PASS] After swap, element 0 is 400\n")
} ElseBlock: {
    T.fail = Add(T.fail, 1)
    PrintMessage("  [FAIL] After swap, element 0 is 400\n")
}

T.total = Add(T.total, 1)
IfCondition EqualTo(Array.Get(arr4, 3), 100) ThenBlock: {
    T.pass = Add(T.pass, 1)
    PrintMessage("  [PASS] After swap, element 3 is 100\n")
} ElseBlock: {
    T.fail = Add(T.fail, 1)
    PrintMessage("  [FAIL] After swap, element 3 is 100\n")
}

copy4 = Array.Copy(arr4)
T.total = Add(T.total, 1)
IfCondition NotEqual(copy4, 0) ThenBlock: {
    T.pass = Add(T.pass, 1)
    PrintMessage("  [PASS] XCopy returns non-null\n")
} ElseBlock: {
    T.fail = Add(T.fail, 1)
    PrintMessage("  [FAIL] XCopy returns non-null\n")
}

T.total = Add(T.total, 1)
IfCondition EqualTo(Array.Size(copy4), 4) ThenBlock: {
    T.pass = Add(T.pass, 1)
    PrintMessage("  [PASS] Copy has size 4\n")
} ElseBlock: {
    T.fail = Add(T.fail, 1)
    PrintMessage("  [FAIL] Copy has size 4\n")
}

Array.Set(arr4, 0, 999)
T.total = Add(T.total, 1)
IfCondition EqualTo(Array.Get(copy4, 0), 400) ThenBlock: {
    T.pass = Add(T.pass, 1)
    PrintMessage("  [PASS] Copy is independent\n")
} ElseBlock: {
    T.fail = Add(T.fail, 1)
    PrintMessage("  [FAIL] Copy is independent\n")
}

Array.Destroy(copy4)

Array.Resize(arr4, 32)
T.total = Add(T.total, 1)
IfCondition EqualTo(Array.Capacity(arr4), 32) ThenBlock: {
    T.pass = Add(T.pass, 1)
    PrintMessage("  [PASS] Resize to 32 works\n")
} ElseBlock: {
    T.fail = Add(T.fail, 1)
    PrintMessage("  [FAIL] Resize to 32 works\n")
}

Array.Destroy(arr4)
PrintMessage("  TEST 4 COMPLETE\n\n")

// =============================================================================
// TEST 5: XStack
// =============================================================================
PrintMessage("=== TEST 5: XStack ===\n")

stk5 = Stack.Create(16)

T.total = Add(T.total, 1)
IfCondition EqualTo(Stack.IsEmpty(stk5), 1) ThenBlock: {
    T.pass = Add(T.pass, 1)
    PrintMessage("  [PASS] New stack is empty\n")
} ElseBlock: {
    T.fail = Add(T.fail, 1)
    PrintMessage("  [FAIL] New stack is empty\n")
}

Stack.Push(stk5, 10)
Stack.Push(stk5, 20)
Stack.Push(stk5, 30)

T.total = Add(T.total, 1)
IfCondition EqualTo(Stack.Peek(stk5), 30) ThenBlock: {
    T.pass = Add(T.pass, 1)
    PrintMessage("  [PASS] XPeek returns 30\n")
} ElseBlock: {
    T.fail = Add(T.fail, 1)
    PrintMessage("  [FAIL] XPeek returns 30\n")
}

T.total = Add(T.total, 1)
IfCondition EqualTo(Stack.Pop(stk5), 30) ThenBlock: {
    T.pass = Add(T.pass, 1)
    PrintMessage("  [PASS] XPop returns 30\n")
} ElseBlock: {
    T.fail = Add(T.fail, 1)
    PrintMessage("  [FAIL] XPop returns 30\n")
}

T.total = Add(T.total, 1)
IfCondition EqualTo(Stack.Pop(stk5), 20) ThenBlock: {
    T.pass = Add(T.pass, 1)
    PrintMessage("  [PASS] XPop returns 20\n")
} ElseBlock: {
    T.fail = Add(T.fail, 1)
    PrintMessage("  [FAIL] XPop returns 20\n")
}

Array.Destroy(stk5)
PrintMessage("  TEST 5 COMPLETE\n\n")

// =============================================================================
// TEST 6: XQueue
// =============================================================================
PrintMessage("=== TEST 6: XQueue ===\n")

q6 = Queue.Create(8)

Queue.Enqueue(q6, 100)
Queue.Enqueue(q6, 200)
Queue.Enqueue(q6, 300)

T.total = Add(T.total, 1)
IfCondition EqualTo(Queue.Dequeue(q6), 100) ThenBlock: {
    T.pass = Add(T.pass, 1)
    PrintMessage("  [PASS] Dequeue returns 100 (FIFO)\n")
} ElseBlock: {
    T.fail = Add(T.fail, 1)
    PrintMessage("  [FAIL] Dequeue returns 100 (FIFO)\n")
}

T.total = Add(T.total, 1)
IfCondition EqualTo(Queue.Dequeue(q6), 200) ThenBlock: {
    T.pass = Add(T.pass, 1)
    PrintMessage("  [PASS] Dequeue returns 200\n")
} ElseBlock: {
    T.fail = Add(T.fail, 1)
    PrintMessage("  [FAIL] Dequeue returns 200\n")
}

Queue.Destroy(q6)
PrintMessage("  TEST 6 COMPLETE\n\n")

// =============================================================================
// TEST 7: XHash (Integer Keys)
// =============================================================================
PrintMessage("=== TEST 7: XHash ===\n")

h7 = IHash.Create(17)
IHash.Insert(h7, 100, 1000)
IHash.Insert(h7, 200, 2000)
IHash.Insert(h7, 17, 170)

T.total = Add(T.total, 1)
IfCondition EqualTo(IHash.Lookup(h7, 100), 1000) ThenBlock: {
    T.pass = Add(T.pass, 1)
    PrintMessage("  [PASS] XLookup(100) returns 1000\n")
} ElseBlock: {
    T.fail = Add(T.fail, 1)
    PrintMessage("  [FAIL] XLookup(100) returns 1000\n")
}

T.total = Add(T.total, 1)
IfCondition EqualTo(IHash.Lookup(h7, 17), 170) ThenBlock: {
    T.pass = Add(T.pass, 1)
    PrintMessage("  [PASS] XLookup(17) returns 170\n")
} ElseBlock: {
    T.fail = Add(T.fail, 1)
    PrintMessage("  [FAIL] XLookup(17) returns 170\n")
}

IHash.Destroy(h7)
PrintMessage("  TEST 7 COMPLETE\n\n")

// =============================================================================
// TEST 8: XSHash (String Keys)
// =============================================================================
PrintMessage("=== TEST 8: XSHash ===\n")

sh8 = SHash.Create(31)
SHash.Insert(sh8, "alpha", 1)
SHash.Insert(sh8, "beta", 2)
SHash.Insert(sh8, "gamma", 3)

T.total = Add(T.total, 1)
IfCondition EqualTo(SHash.Lookup(sh8, "alpha"), 1) ThenBlock: {
    T.pass = Add(T.pass, 1)
    PrintMessage("  [PASS] XLookup('alpha') returns 1\n")
} ElseBlock: {
    T.fail = Add(T.fail, 1)
    PrintMessage("  [FAIL] XLookup('alpha') returns 1\n")
}

T.total = Add(T.total, 1)
IfCondition EqualTo(SHash.Exists(sh8, "beta"), 1) ThenBlock: {
    T.pass = Add(T.pass, 1)
    PrintMessage("  [PASS] XExists('beta') returns 1\n")
} ElseBlock: {
    T.fail = Add(T.fail, 1)
    PrintMessage("  [FAIL] XExists('beta') returns 1\n")
}

T.total = Add(T.total, 1)
IfCondition EqualTo(SHash.Exists(sh8, "omega"), 0) ThenBlock: {
    T.pass = Add(T.pass, 1)
    PrintMessage("  [PASS] XExists('omega') returns 0\n")
} ElseBlock: {
    T.fail = Add(T.fail, 1)
    PrintMessage("  [FAIL] XExists('omega') returns 0\n")
}

del8 = SHash.Delete(sh8, "gamma")
T.total = Add(T.total, 1)
IfCondition EqualTo(del8, 3) ThenBlock: {
    T.pass = Add(T.pass, 1)
    PrintMessage("  [PASS] XDelete('gamma') returns 3\n")
} ElseBlock: {
    T.fail = Add(T.fail, 1)
    PrintMessage("  [FAIL] XDelete('gamma') returns 3\n")
}

SHash.Destroy(sh8)
PrintMessage("  TEST 8 COMPLETE\n\n")

// =============================================================================
// TEST 9: XList
// =============================================================================
PrintMessage("=== TEST 9: XList ===\n")

lst9 = List.Create()

T.total = Add(T.total, 1)
IfCondition EqualTo(List.Size(lst9), 0) ThenBlock: {
    T.pass = Add(T.pass, 1)
    PrintMessage("  [PASS] New list size is 0\n")
} ElseBlock: {
    T.fail = Add(T.fail, 1)
    PrintMessage("  [FAIL] New list size is 0\n")
}

List.Append(lst9, 10)
List.Append(lst9, 20)
List.Append(lst9, 30)

T.total = Add(T.total, 1)
IfCondition EqualTo(List.Size(lst9), 3) ThenBlock: {
    T.pass = Add(T.pass, 1)
    PrintMessage("  [PASS] After 3 appends, size is 3\n")
} ElseBlock: {
    T.fail = Add(T.fail, 1)
    PrintMessage("  [FAIL] After 3 appends, size is 3\n")
}

List.Prepend(lst9, 5)

T.total = Add(T.total, 1)
IfCondition EqualTo(List.Size(lst9), 4) ThenBlock: {
    T.pass = Add(T.pass, 1)
    PrintMessage("  [PASS] After prepend, size is 4\n")
} ElseBlock: {
    T.fail = Add(T.fail, 1)
    PrintMessage("  [FAIL] After prepend, size is 4\n")
}

pop9 = List.PopFront(lst9)
T.total = Add(T.total, 1)
IfCondition EqualTo(pop9, 5) ThenBlock: {
    T.pass = Add(T.pass, 1)
    PrintMessage("  [PASS] XPopFront returns 5\n")
} ElseBlock: {
    T.fail = Add(T.fail, 1)
    PrintMessage("  [FAIL] XPopFront returns 5\n")
}

List.Destroy(lst9)
PrintMessage("  TEST 9 COMPLETE\n\n")

// =============================================================================
// TEST 10: XUtil
// =============================================================================
PrintMessage("=== TEST 10: XUtil ===\n")

arr10 = Array.Create(16)
Array.Push(arr10, 50)
Array.Push(arr10, 20)
Array.Push(arr10, 80)
Array.Push(arr10, 10)
Array.Push(arr10, 60)

T.total = Add(T.total, 1)
IfCondition EqualTo(Util.FindMax(arr10), 80) ThenBlock: {
    T.pass = Add(T.pass, 1)
    PrintMessage("  [PASS] XFindMax returns 80\n")
} ElseBlock: {
    T.fail = Add(T.fail, 1)
    PrintMessage("  [FAIL] XFindMax returns 80\n")
}

T.total = Add(T.total, 1)
IfCondition EqualTo(Util.FindMin(arr10), 10) ThenBlock: {
    T.pass = Add(T.pass, 1)
    PrintMessage("  [PASS] XFindMin returns 10\n")
} ElseBlock: {
    T.fail = Add(T.fail, 1)
    PrintMessage("  [FAIL] XFindMin returns 10\n")
}

// Sort
sz10 = Array.Size(arr10)
Util.QuickSort(arr10, 0, Subtract(sz10, 1))

T.total = Add(T.total, 1)
IfCondition EqualTo(Array.Get(arr10, 0), 10) ThenBlock: {
    T.pass = Add(T.pass, 1)
    PrintMessage("  [PASS] After sort, first is 10\n")
} ElseBlock: {
    T.fail = Add(T.fail, 1)
    PrintMessage("  [FAIL] After sort, first is 10\n")
}

T.total = Add(T.total, 1)
IfCondition EqualTo(Array.Get(arr10, 4), 80) ThenBlock: {
    T.pass = Add(T.pass, 1)
    PrintMessage("  [PASS] After sort, last is 80\n")
} ElseBlock: {
    T.fail = Add(T.fail, 1)
    PrintMessage("  [FAIL] After sort, last is 80\n")
}

Util.Reverse(arr10)
T.total = Add(T.total, 1)
IfCondition EqualTo(Array.Get(arr10, 0), 80) ThenBlock: {
    T.pass = Add(T.pass, 1)
    PrintMessage("  [PASS] After reverse, first is 80\n")
} ElseBlock: {
    T.fail = Add(T.fail, 1)
    PrintMessage("  [FAIL] After reverse, first is 80\n")
}

Array.Destroy(arr10)
PrintMessage("  TEST 10 COMPLETE\n\n")

// =============================================================================
// TEST 11: Stress - Many Create/Destroy
// =============================================================================
PrintMessage("=== TEST 11: Stress Test ===\n")
PrintMessage("  Creating/destroying 500 arrays...\n")

stress_err = 0
stress_i = 0
WhileLoop LessThan(stress_i, 500) {
    stress_arr = Array.Create(8)
    Array.Push(stress_arr, stress_i)
    Array.Push(stress_arr, Multiply(stress_i, 2))
    stress_val = Array.Get(stress_arr, 0)
    IfCondition NotEqual(stress_val, stress_i) ThenBlock: {
        stress_err = Add(stress_err, 1)
    }
    Array.Destroy(stress_arr)
    stress_i = Add(stress_i, 1)
}

T.total = Add(T.total, 1)
IfCondition EqualTo(stress_err, 0) ThenBlock: {
    T.pass = Add(T.pass, 1)
    PrintMessage("  [PASS] 500 array cycles, 0 errors\n")
} ElseBlock: {
    T.fail = Add(T.fail, 1)
    PrintMessage("  [FAIL] 500 array cycles had errors\n")
}

PrintMessage("  TEST 11 COMPLETE\n\n")

// =============================================================================
// RESULTS
// =============================================================================
PrintMessage("╔════════════════════════════════════════════════════════════════╗\n")
PrintMessage("║                      FINAL RESULTS                             ║\n")
PrintMessage("╚════════════════════════════════════════════════════════════════╝\n")
PrintMessage("Passed: ")
PrintNumber(T.pass)
PrintMessage("\nFailed: ")
PrintNumber(T.fail)
PrintMessage("\nTotal:  ")
PrintNumber(T.total)
PrintMessage("\n")

IfCondition EqualTo(T.fail, 0) ThenBlock: {
    PrintMessage("\n✓ ALL TESTS PASSED\n")
} ElseBlock: {
    PrintMessage("\n✗ SOME TESTS FAILED\n")
}

PrintMessage("\n")
Arena_Report()