// string_leak_test.ailang

LibraryImport.Arena
SubRoutine.Main {
    PrintMessage("StringConcat Leak Test\n")
    
    cycle = 0
    WhileLoop LessThan(cycle, 600) {
        i = 0
        WhileLoop LessThan(i, 1000) {
            s1 = StringConcat("Hello", "World")
            s2 = StringConcat(s1, "Test")
            i = Add(i, 1)
        }
        
        // Wait
        j = 0
        WhileLoop LessThan(j, 50000000) {
            j = Add(j, 1)
        }
        
        cycle = Add(cycle, 1)
        IfCondition EqualTo(Modulo(cycle, 60), 0) ThenBlock: {
            PrintNumber(Divide(cycle, 60))
            PrintMessage(" minutes\n")
        }
    }
    
    PrintMessage("Done\n")
}

RunTask(Main)