// svg_test.ailang — Standalone SVG rendering test harness
//
// Reads an SVG file, renders it to a pixel surface, writes PPM output.
// Minimal binary: just SVG + VIF + surface allocation + PPM writer.
//
// Build:  ./ailang.x TestCode/svg_test.ailang svg_test.x
// Usage:  ./svg_test.x <input.svg> <output.ppm> [width] [height]
//         Default size: 512×512
//
// Reads file paths from stdin if no arguments given:
//   echo -e "tests/svg/basic/rect.svg\n/tmp/svg_rect.ppm" | ./svg_test.x
//
// Copyright (c) 2026 Sean Collins, 2 Paws Machine and Engineering. SCSL.

LibraryImport.Arena
LibraryImport.StringUtils
LibraryImport.Display.Render.DSurfaceTypes
LibraryImport.Display.Render.DSurface
LibraryImport.Display.Render.DDrawPixel
LibraryImport.Display.Render.VIF
LibraryImport.Display.Render.Fonts
LibraryImport.Display.Render.SurfaceBlit
LibraryImport.FixedPointTrig
LibraryImport.SVG

// =============================================================================
// STATE
// =============================================================================
FixedPool.SvgTest {
    "in_path":    Initialize=0, CanChange=True
    "out_path":   Initialize=0, CanChange=True
    "surf_w":     Initialize=512, CanChange=True
    "surf_h":     Initialize=512, CanChange=True
    "pixels":     Initialize=0, CanChange=True
}

// =============================================================================
// PPM WRITER — BGRA pixel buffer → P6 PPM file
// =============================================================================
Function.SvgTest_WritePPM {
    Input: pixels: Address
    Input: w: Integer
    Input: h: Integer
    Input: path: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(pixels, 0) ThenBlock: { ReturnValue(0) }

        // O_WRONLY|O_CREAT|O_TRUNC = 577, mode 0644 = 420
        fd = SystemCall(2, path, 577, 420)
        IfCondition LessThan(fd, 0) ThenBlock: {
            PrintMessage("[SvgTest] Cannot write: ")
            PrintMessage(path)
            PrintMessage("\n")
            ReturnValue(0)
        }

        // Build PPM header: "P6\n<W> <H>\n255\n"
        hdr = Allocate(64)
        hp = 0
        // "P6\n"
        SetByte(hdr, hp, 80)
        hp = Add(hp, 1)
        SetByte(hdr, hp, 54)
        hp = Add(hp, 1)
        SetByte(hdr, hp, 10)
        hp = Add(hp, 1)
        // Width as decimal
        hp = SvgTest_WriteInt(hdr, hp, w)
        // Space
        SetByte(hdr, hp, 32)
        hp = Add(hp, 1)
        // Height as decimal
        hp = SvgTest_WriteInt(hdr, hp, h)
        // "\n255\n"
        SetByte(hdr, hp, 10)
        hp = Add(hp, 1)
        SetByte(hdr, hp, 50)
        hp = Add(hp, 1)
        SetByte(hdr, hp, 53)
        hp = Add(hp, 1)
        SetByte(hdr, hp, 53)
        hp = Add(hp, 1)
        SetByte(hdr, hp, 10)
        hp = Add(hp, 1)
        SystemCall(1, fd, hdr, hp)
        Deallocate(hdr, 64)

        // BGRA -> RGB row by row
        row_bytes = Multiply(w, 3)
        row_buf = Allocate(Add(row_bytes, 8))
        pitch = Multiply(w, 4)

        y = 0
        WhileLoop LessThan(y, h) {
            src = Add(pixels, Multiply(y, pitch))
            x = 0
            WhileLoop LessThan(x, w) {
                si = Multiply(x, 4)
                di = Multiply(x, 3)
                SetByte(row_buf, di,          GetByte(src, Add(si, 2)))  // R
                SetByte(row_buf, Add(di, 1),  GetByte(src, Add(si, 1)))  // G
                SetByte(row_buf, Add(di, 2),  GetByte(src, si))           // B
                x = Add(x, 1)
            }
            SystemCall(1, fd, row_buf, row_bytes)
            y = Add(y, 1)
        }

        Deallocate(row_buf, Add(row_bytes, 8))
        SystemCall(3, fd)
        ReturnValue(1)
    }
}

// Write integer to buffer, return new position
Function.SvgTest_WriteInt {
    Input: buf: Address
    Input: pos: Integer
    Input: val: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(val, 0) ThenBlock: {
            SetByte(buf, pos, 48)
            ReturnValue(Add(pos, 1))
        }
        // Max 10 digits
        digits = Allocate(16)
        dc = 0
        v = val
        WhileLoop GreaterThan(v, 0) {
            SetByte(digits, dc, Add(48, Modulo(v, 10)))
            v = Divide(v, 10)
            dc = Add(dc, 1)
        }
        // Reverse
        p = pos
        i = Subtract(dc, 1)
        WhileLoop GreaterEqual(i, 0) {
            SetByte(buf, p, GetByte(digits, i))
            p = Add(p, 1)
            i = Subtract(i, 1)
        }
        Deallocate(digits, 16)
        ReturnValue(p)
    }
}

// =============================================================================
// STDIN READER — read two lines from stdin (svg path, ppm path)
// =============================================================================
Function.SvgTest_ReadStdin {
    Output: Integer
    Body: {
        buf = Allocate(4096)
        IfCondition EqualTo(buf, 0) ThenBlock: { ReturnValue(0) }

        // read(0, buf, 4096)
        n = SystemCall(0, 0, buf, 4096)
        IfCondition LessEqual(n, 0) ThenBlock: {
            Deallocate(buf, 4096)
            ReturnValue(0)
        }

        // Find first newline
        i = 0
        WhileLoop And(LessThan(i, n), NotEqual(GetByte(buf, i), 10)) {
            i = Add(i, 1)
        }
        IfCondition GreaterEqual(i, n) ThenBlock: {
            Deallocate(buf, 4096)
            ReturnValue(0)
        }

        // Copy first line → in_path
        path1 = Allocate(Add(i, 1))
        MemoryCopy(path1, buf, i)
        SetByte(path1, i, 0)
        SvgTest.in_path = path1

        // Find second line
        j = Add(i, 1)
        k = j
        WhileLoop And(LessThan(k, n), NotEqual(GetByte(buf, k), 10)) {
            k = Add(k, 1)
        }
        len2 = Subtract(k, j)
        path2 = Allocate(Add(len2, 1))
        MemoryCopy(path2, Add(buf, j), len2)
        SetByte(path2, len2, 0)
        SvgTest.out_path = path2

        Deallocate(buf, 4096)
        ReturnValue(1)
    }
}

// =============================================================================
// CMDLINE READER — parse /proc/self/cmdline for args
// =============================================================================
Function.SvgTest_ReadArgs {
    Output: Integer
    Body: {
        // Open /proc/self/cmdline
        pcl = "/proc/self/cmdline"
        fd = SystemCall(2, pcl, 0, 0)
        IfCondition LessThan(fd, 0) ThenBlock: { ReturnValue(0) }

        buf = Allocate(4096)
        n = SystemCall(0, fd, buf, 4095)
        SystemCall(3, fd)
        IfCondition LessEqual(n, 0) ThenBlock: {
            Deallocate(buf, 4096)
            ReturnValue(0)
        }

        // Parse NUL-separated args: argv[0]=program, argv[1]=svg, argv[2]=ppm, [argv[3]=w], [argv[4]=h]
        argc = 0
        argv0 = 0
        argv1 = 0
        argv2 = 0
        argv3 = 0
        argv4 = 0

        i = 0
        start = 0
        WhileLoop LessThan(i, n) {
            IfCondition EqualTo(GetByte(buf, i), 0) ThenBlock: {
                IfCondition EqualTo(argc, 0) ThenBlock: { argv0 = start }
                IfCondition EqualTo(argc, 1) ThenBlock: { argv1 = start }
                IfCondition EqualTo(argc, 2) ThenBlock: { argv2 = start }
                IfCondition EqualTo(argc, 3) ThenBlock: { argv3 = start }
                IfCondition EqualTo(argc, 4) ThenBlock: { argv4 = start }
                argc = Add(argc, 1)
                start = Add(i, 1)
            }
            i = Add(i, 1)
        }

        IfCondition LessThan(argc, 3) ThenBlock: {
            Deallocate(buf, 4096)
            ReturnValue(0)
        }

        // Copy svg path
        len1 = StringLength(Add(buf, argv1))
        p1 = Allocate(Add(len1, 1))
        MemoryCopy(p1, Add(buf, argv1), Add(len1, 1))
        SvgTest.in_path = p1

        // Copy ppm path
        len2 = StringLength(Add(buf, argv2))
        p2 = Allocate(Add(len2, 1))
        MemoryCopy(p2, Add(buf, argv2), Add(len2, 1))
        SvgTest.out_path = p2

        // Optional width/height
        IfCondition GreaterEqual(argc, 4) ThenBlock: {
            SvgTest.surf_w = StringToInt(Add(buf, argv3))
        }
        IfCondition GreaterEqual(argc, 5) ThenBlock: {
            SvgTest.surf_h = StringToInt(Add(buf, argv4))
        }

        Deallocate(buf, 4096)
        ReturnValue(1)
    }
}

// =============================================================================
// MAIN
// =============================================================================
SubRoutine.Main {
    PrintMessage("[SvgTest] SVG Rendering Test Harness\n")

    // Try cmdline args first, then stdin
    got_args = SvgTest_ReadArgs()
    IfCondition EqualTo(got_args, 0) ThenBlock: {
        got_args = SvgTest_ReadStdin()
    }
    IfCondition EqualTo(got_args, 0) ThenBlock: {
        PrintMessage("[SvgTest] Usage: svg_test.x <input.svg> <output.ppm> [width] [height]\n")
        PrintMessage("[SvgTest] Or pipe: echo -e \"input.svg\\noutput.ppm\" | ./svg_test.x\n")
        SystemCall(60, 1, 0, 0, 0, 0)
    }

    PrintMessage("[SvgTest] Input:  ")
    PrintMessage(SvgTest.in_path)
    PrintMessage("\n")
    PrintMessage("[SvgTest] Output: ")
    PrintMessage(SvgTest.out_path)
    PrintMessage("\n")
    PrintMessage("[SvgTest] Size:   ")
    PrintNumber(SvgTest.surf_w)
    PrintMessage("x")
    PrintNumber(SvgTest.surf_h)
    PrintMessage("\n")

    // Init subsystems
    Arena_Init()
    PrintMessage("[STEP 1] VIF_Init\n")
    VIF_Init()

    PrintMessage("[STEP 2] SVG_Init\n")
    SVG_Init()

    // Create proper DSurface (PIXEL_32 format)
    w = SvgTest.surf_w
    h = SvgTest.surf_h
    surf = Surface_Create(SurfaceFormat.PIXEL_32, w, h)
    IfCondition EqualTo(surf, 0) ThenBlock: {
        PrintMessage("[SvgTest] FAIL — surface create failed\n")
        SystemCall(60, 1, 0, 0, 0, 0)
    }
    // Get pixel data pointer and clear to white
    pixels = Dereference(Add(surf, SurfaceFields.DATA))
    buf_size = Dereference(Add(surf, SurfaceFields.DATA_SIZE))
    MemorySet(pixels, 255, buf_size)
    SvgTest.pixels = pixels

    // Render SVG — pass the surface struct (not raw pixels)
    PrintMessage("[STEP 3] SVG_RenderFile\n")
    result = SVG_RenderFile(SvgTest.in_path, surf, w, h)
    PrintMessage("[SvgTest] SVG_RenderFile returned: ")
    PrintNumber(result)
    PrintMessage("\n")

    // Report element count
    PrintMessage("[SvgTest] Elements rendered: ")
    PrintNumber(SVGState.elem_count)
    PrintMessage("\n")

    // Report edge count
    PrintMessage("[SvgTest] Edge count: ")
    PrintNumber(RastState.edge_count)
    PrintMessage("\n")

    // Write PPM (pass raw pixel pointer, not surface struct)
    PrintMessage("[STEP 4] WritePPM\n")
    ppm_ok = SvgTest_WritePPM(pixels, w, h, SvgTest.out_path)
    IfCondition EqualTo(ppm_ok, 1) ThenBlock: {
        PrintMessage("[SvgTest] PPM written: ")
        PrintMessage(SvgTest.out_path)
        PrintMessage("\n")
    } ElseBlock: {
        PrintMessage("[SvgTest] PPM write FAILED\n")
    }

    // Cleanup
    PrintMessage("[STEP 5] Cleanup\n")
    SVG_Shutdown()
    Surface_Destroy(surf)

    PrintMessage("[SvgTest] DONE\n")
    SystemCall(60, 0, 0, 0, 0, 0)
}

RunTask(Main)
