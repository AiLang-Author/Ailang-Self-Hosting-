// test262_harness.ailang — Thin harness for tc39/test262 conformance tests
// Reads /tmp/test262_current.js, evals it via JSEngine, exits with error code.
//
// Build: ./ailang.x TestCode/test262_harness.ailang test262_harness.x
// Run:   (called by tools/test262_runner.py)
//
// Copyright (c) 2026 Sean Collins, 2 Paws Machine and Engineering. SCSL.

LibraryImport.Arena
LibraryImport.StringUtils
LibraryImport.Browser.HTMLTokenizer
LibraryImport.Browser.HTMLDom
LibraryImport.Browser.JSLexer
LibraryImport.Browser.JSValidate
LibraryImport.Browser.JSParser
LibraryImport.Browser.JSCompiler
LibraryImport.Browser.JSRuntime
LibraryImport.Browser.JSVM
LibraryImport.Browser.JSBridge
LibraryImport.Browser.JSEngine

FixedPool.HarnessSys {
    "SYS_EXIT": Initialize=60
}

SubRoutine.Main {
    Arena_Init()
    JSEngine_Init()
    JSVM_SetMaxSteps(9999999999)

    content = ReadTextFile("/tmp/test262_current.js")
    IfCondition EqualTo(content, 0) ThenBlock: {
        PrintMessage("[harness] ERROR: could not read /tmp/test262_current.js\n")
        SystemCall(HarnessSys.SYS_EXIT, 2, 0, 0, 0, 0)
    }

    len = StringLength(content)
    JSEngine_EvalString(content, len)
    err = JSEngine_GetError()

    JSEngine_Shutdown()

    IfCondition EqualTo(err, 0) ThenBlock: {
        SystemCall(HarnessSys.SYS_EXIT, 0, 0, 0, 0, 0)
    }
    SystemCall(HarnessSys.SYS_EXIT, 1, 0, 0, 0, 0)
}

RunTask(Main)
