// test_ansi.ailang — visual smoke test for Library.ANSI.
//
// Builds a single synchronized-output frame that exercises each of the
// modern terminal primitives we care about: title, alt screen, cursor
// shape and position, truecolor SGR, OSC 8 hyperlinks. Sleeps a few
// seconds, then cleanly tears down. Run in any modern terminal:
//
//   ./test_ansi.x
//
// Verify by eye:
//   - Window title shows "Library.ANSI test"
//   - Screen clears, content appears once (no flicker / no progressive draw)
//   - Anthropic-orange "Library.ANSI primitives" header
//   - Three colored swatches with RGB values labelled
//   - "https://anthropic.com" is clickable (Ctrl-click on most terminals)
//   - Cursor is a steady beam at row 8, col 1
//   - After ~3s, screen restores cleanly to the shell
//
// Copyright 2026 Sean Collins, 2 Paws Machine and Engineering. SCSL.

LibraryImport.ANSI

FixedPool.TASys {
    "SYS_NANOSLEEP":  Initialize=35
    "SYS_EXIT":       Initialize=60
}

SubRoutine.TestANSI_Sleep_3s {
    ts = Allocate(16)
    StoreValue(Add(ts, 0), 3)             // tv_sec = 3
    StoreValue(Add(ts, 8), 0)             // tv_nsec = 0
    SystemCall(TASys.SYS_NANOSLEEP, ts, 0, 0, 0, 0)
    Deallocate(ts, 16)
}

SubRoutine.Main {
    // ── Setup: title, alt screen, hide cursor ───────────────────────────────
    title = "Library.ANSI test"
    ANSI.SetTitle(title, StringLength(title))

    setup = ANSI.NewFrame()
    sp = 0
    sp = ANSI.Build_AltScreenEnter(setup, sp)
    sp = ANSI.Build_HideCursor(setup, sp)
    sp = ANSI.Build_ClearScreen(setup, sp)
    ANSI.FlushFrameRaw(setup, sp)

    // ── Main frame: assemble everything, flush atomically ──────────────────
    f = ANSI.NewFrame()
    p = 0

    // Header — Anthropic orange (#cc785c = 204, 120, 92), bold
    p = ANSI.Build_CursorTo(f, p, 2, 4)
    p = ANSI.Build_FgRGB(f, p, 204, 120, 92)
    p = ANSI.Build_SGRAttr(f, p, ANSISGR.BOLD)
    h1 = "Library.ANSI primitives"
    p = ANSI.Build_PutText(f, p, h1, StringLength(h1))
    p = ANSI.Build_ResetSGR(f, p)

    // Subtitle — dimmer
    p = ANSI.Build_CursorTo(f, p, 3, 4)
    p = ANSI.Build_SGRAttr(f, p, ANSISGR.FAINT)
    h2 = "synchronized output · truecolor · OSC 8 · cursor shape"
    p = ANSI.Build_PutText(f, p, h2, StringLength(h2))
    p = ANSI.Build_ResetSGR(f, p)

    // Three color swatches
    p = ANSI.Build_CursorTo(f, p, 5, 4)
    p = ANSI.Build_BgRGB(f, p, 204, 120, 92)
    sw1 = "  204,120, 92  "
    p = ANSI.Build_PutText(f, p, sw1, StringLength(sw1))
    p = ANSI.Build_ResetSGR(f, p)
    p = ANSI.Build_PutStr(f, p, "  ")
    p = ANSI.Build_BgRGB(f, p,  60, 180, 220)
    sw2 = "   60,180,220  "
    p = ANSI.Build_PutText(f, p, sw2, StringLength(sw2))
    p = ANSI.Build_ResetSGR(f, p)
    p = ANSI.Build_PutStr(f, p, "  ")
    p = ANSI.Build_BgRGB(f, p, 140, 220, 140)
    sw3 = "  140,220,140  "
    p = ANSI.Build_PutText(f, p, sw3, StringLength(sw3))
    p = ANSI.Build_ResetSGR(f, p)

    // OSC 8 hyperlink
    p = ANSI.Build_CursorTo(f, p, 7, 4)
    p = ANSI.Build_PutStr(f, p, "Link: ")
    url   = "https://anthropic.com"
    label = "https://anthropic.com"
    p = ANSI.Build_FgRGB(f, p, 100, 180, 255)
    p = ANSI.Build_SGRAttr(f, p, ANSISGR.UNDERLINE)
    p = ANSI.Build_Hyperlink(f, p, url, StringLength(url), label, StringLength(label))
    p = ANSI.Build_ResetSGR(f, p)

    // Beam cursor at row 8, col 1 (so you can SEE a beam-shaped cursor)
    p = ANSI.Build_CursorTo(f, p, 8, 1)
    p = ANSI.Build_CursorShape(f, p, ANSICursor.STEADY_BEAM)
    p = ANSI.Build_ShowCursor(f, p)

    // Flush the whole thing atomically (terminals supporting ?2026 will
    // buffer until end; others render normally)
    ANSI.FlushFrame(f, p)

    // ── Hold for visual inspection ──────────────────────────────────────────
    TestANSI_Sleep_3s()

    // ── Teardown: restore everything ────────────────────────────────────────
    teardown = ANSI.NewFrame()
    tp = 0
    tp = ANSI.Build_CursorShape(teardown, tp, ANSICursor.DEFAULT)
    tp = ANSI.Build_ShowCursor(teardown, tp)
    tp = ANSI.Build_ResetSGR(teardown, tp)
    tp = ANSI.Build_AltScreenLeave(teardown, tp)
    ANSI.FlushFrameRaw(teardown, tp)

    SystemCall(TASys.SYS_EXIT, 0, 0, 0, 0, 0)
}

RunTask(Main)
