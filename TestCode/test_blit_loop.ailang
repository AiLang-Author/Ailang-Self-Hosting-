// test_blit_loop.ailang
// Minimal: just the Win_BlitOne MemoryCopy loop pattern.
// Compile, disassemble, and verify the machine code is correct.

LibraryImport.Arena

Function.BlitLoop {
    Input: src_data: Address
    Input: src_pitch: Integer
    Input: src_x0: Integer
    Input: src_y0: Integer
    Input: dst_buf: Address
    Input: dst_pitch: Integer
    Body: {
        // These would normally come from more args but we hardcode here
        // to match Win_BlitOne's flattened pattern
        dst_x = 0
        draw_w = 640
        draw_h = 480
        pb = 4

        row_bytes = Multiply(draw_w, pb)
        y = 0
        WhileLoop LessThan(y, draw_h) {
            sry = Add(y, src_y0)
            dry = Add(y, 0)
            sr_off = Add(Multiply(sry, src_pitch), Multiply(src_x0, pb))
            src_row = Add(src_data, sr_off)
            dr_off = Add(Multiply(dry, dst_pitch), Multiply(dst_x, pb))
            dst_row = Add(dst_buf, dr_off)
            MemoryCopy(dst_row, src_row, row_bytes)
            y = Add(y, 1)
        }
        ReturnValue(1)
    }
}

// Test with real data
SubRoutine.Main {
    Arena_Init()
    size = 1228800
    src = Allocate(size)
    dst = Allocate(size)

    // Fill src
    i = 0
    WhileLoop LessThan(i, size) {
        SetByte(src, i, BitwiseAnd(i, 255))
        i = Add(i, 1)
    }

    PrintMessage("Calling BlitLoop...\n")
    BlitLoop(src, 2560, 0, 0, dst, 2560)
    PrintMessage("BlitLoop done, verifying...\n")

    fail = 0
    i = 0
    WhileLoop LessThan(i, size) {
        IfCondition NotEqual(GetByte(dst, i), GetByte(src, i)) ThenBlock: {
            IfCondition EqualTo(fail, 0) ThenBlock: {
                PrintMessage("[FAIL] offset=")
                PrintNumber(i)
                PrintMessage("\n")
            }
            fail = Add(fail, 1)
        }
        i = Add(i, 1)
    }

    IfCondition EqualTo(fail, 0) ThenBlock: {
        PrintMessage("[PASS]\n")
    } ElseBlock: {
        PrintMessage("[FAIL] ")
        PrintNumber(fail)
        PrintMessage(" mismatches\n")
    }
}

RunTask(Main)
