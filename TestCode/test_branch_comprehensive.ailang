// Comprehensive Branch/Case test - exercises fast path, slow path,
// nested Branch, ReturnValue in Case, Default-only, no-match edge cases

LibraryImport.Arena

// Test 1: ReturnValue inside Case (Bug A from Battle Plan)
Function.TestReturnInCase {
    Input: x: Integer
    Output: Integer
    Body: {
        Branch x {
            Case 1: { ReturnValue(111) }
            Case 2: { ReturnValue(222) }
            Case 3: { ReturnValue(333) }
        }
        ReturnValue(999)
    }
}

// Test 2: ReturnValue with expression Case values (slow path)
Function.MakeVal {
    Input: x: Integer
    Output: Integer
    Body: {
        ReturnValue(Add(x, 100))
    }
}
Function.TestReturnInCaseExpr {
    Input: x: Integer
    Output: Integer
    Body: {
        Branch x {
            Case MakeVal(1): { ReturnValue(101) }
            Case MakeVal(5): { ReturnValue(105) }
            Default: { ReturnValue(999) }
        }
    }
}

// Test 3: Nested Branch with ReturnValue
Function.TestNestedBranch {
    Input: outer: Integer
    Input: inner: Integer
    Output: Integer
    Body: {
        Branch outer {
            Case 1: {
                Branch inner {
                    Case 10: { ReturnValue(1010) }
                    Case 20: { ReturnValue(1020) }
                    Default: { ReturnValue(1099) }
                }
            }
            Case 2: {
                ReturnValue(2000)
            }
            Default: {
                ReturnValue(9999)
            }
        }
    }
}

// Test 4: Default-only Branch
Function.TestDefaultOnly {
    Input: x: Integer
    Output: Integer
    Body: {
        Branch x {
            Default: { ReturnValue(42) }
        }
    }
}

// Test 5: No match, no default - falls through to end
Function.TestNoMatch {
    Input: x: Integer
    Output: Integer
    Body: {
        Branch x {
            Case 1: { ReturnValue(1) }
            Case 2: { ReturnValue(2) }
        }
        ReturnValue(0)
    }
}

// Test 6: Expr selector with literal cases (fast path should trigger
// since all Case values are literals, even if selector is an expr)
Function.TestExprSelector {
    Input: x: Integer
    Output: Integer
    Body: {
        Branch Add(x, 1) {
            Case 2: { ReturnValue(200) }
            Case 5: { ReturnValue(500) }
            Case 11: { ReturnValue(1100) }
            Default: { ReturnValue(999) }
        }
    }
}

SubRoutine.Main {
    // Test 1
    a1 = TestReturnInCase(1)
    a2 = TestReturnInCase(2)
    a3 = TestReturnInCase(3)
    a4 = TestReturnInCase(99)
    
    IfCondition And(And(EqualTo(a1, 111), EqualTo(a2, 222)), And(EqualTo(a3, 333), EqualTo(a4, 999))) ThenBlock: {
        PrintMessage("Test 1 PASS: ReturnValue in Case\n")
    } ElseBlock: {
        PrintMessage("Test 1 FAIL: ")
        PrintNumber(a1) PrintMessage(" ")
        PrintNumber(a2) PrintMessage(" ")
        PrintNumber(a3) PrintMessage(" ")
        PrintNumber(a4) PrintMessage("\n")
    }
    
    // Test 2 - slow path (x compared against MakeVal result)
    b1 = TestReturnInCaseExpr(101)
    b2 = TestReturnInCaseExpr(105)
    b3 = TestReturnInCaseExpr(99)
    
    IfCondition And(And(EqualTo(b1, 101), EqualTo(b2, 105)), EqualTo(b3, 999)) ThenBlock: {
        PrintMessage("Test 2 PASS: ReturnValue in Case (slow path)\n")
    } ElseBlock: {
        PrintMessage("Test 2 FAIL: ")
        PrintNumber(b1) PrintMessage(" ")
        PrintNumber(b2) PrintMessage(" ")
        PrintNumber(b3) PrintMessage("\n")
    }
    
    // Test 3
    c1 = TestNestedBranch(1, 10)
    c2 = TestNestedBranch(1, 20)
    c3 = TestNestedBranch(1, 99)
    c4 = TestNestedBranch(2, 0)
    c5 = TestNestedBranch(99, 0)
    
    IfCondition And(And(EqualTo(c1, 1010), EqualTo(c2, 1020)), And(And(EqualTo(c3, 1099), EqualTo(c4, 2000)), EqualTo(c5, 9999))) ThenBlock: {
        PrintMessage("Test 3 PASS: Nested Branch with ReturnValue\n")
    } ElseBlock: {
        PrintMessage("Test 3 FAIL: ")
        PrintNumber(c1) PrintMessage(" ")
        PrintNumber(c2) PrintMessage(" ")
        PrintNumber(c3) PrintMessage(" ")
        PrintNumber(c4) PrintMessage(" ")
        PrintNumber(c5) PrintMessage("\n")
    }
    
    // Test 4
    d1 = TestDefaultOnly(1)
    d2 = TestDefaultOnly(99)
    IfCondition And(EqualTo(d1, 42), EqualTo(d2, 42)) ThenBlock: {
        PrintMessage("Test 4 PASS: Default-only Branch\n")
    } ElseBlock: {
        PrintMessage("Test 4 FAIL: ")
        PrintNumber(d1) PrintMessage(" ")
        PrintNumber(d2) PrintMessage("\n")
    }
    
    // Test 5
    e1 = TestNoMatch(1)
    e2 = TestNoMatch(2)
    e3 = TestNoMatch(99)
    IfCondition And(And(EqualTo(e1, 1), EqualTo(e2, 2)), EqualTo(e3, 0)) ThenBlock: {
        PrintMessage("Test 5 PASS: No-match no-default falls through\n")
    } ElseBlock: {
        PrintMessage("Test 5 FAIL: ")
        PrintNumber(e1) PrintMessage(" ")
        PrintNumber(e2) PrintMessage(" ")
        PrintNumber(e3) PrintMessage("\n")
    }
    
    // Test 6
    f1 = TestExprSelector(1)
    f2 = TestExprSelector(4)
    f3 = TestExprSelector(10)
    f4 = TestExprSelector(99)
    IfCondition And(And(EqualTo(f1, 200), EqualTo(f2, 500)), And(EqualTo(f3, 1100), EqualTo(f4, 999))) ThenBlock: {
        PrintMessage("Test 6 PASS: Expression selector with literal cases\n")
    } ElseBlock: {
        PrintMessage("Test 6 FAIL: ")
        PrintNumber(f1) PrintMessage(" ")
        PrintNumber(f2) PrintMessage(" ")
        PrintNumber(f3) PrintMessage(" ")
        PrintNumber(f4) PrintMessage("\n")
    }
    
    PrintMessage("\n=== Branch/Case test complete ===\n")
    SystemCall(60, 0)
}
RunTask(Main)
