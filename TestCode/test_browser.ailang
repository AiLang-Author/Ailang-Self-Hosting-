LibraryImport.Arena
LibraryImport.StringUtils
LibraryImport.Browser.URL
LibraryImport.Browser.DNS
LibraryImport.Browser.HTTPClient
LibraryImport.Browser.ImageDecode
LibraryImport.Browser.JPEGDecode
LibraryImport.Browser.HTMLTokenizer
LibraryImport.Browser.HTMLDom
LibraryImport.Browser.CSSParse
LibraryImport.Browser.HTMLLayout
LibraryImport.Browser.HTMLRender
LibraryImport.Browser.JSLexer
LibraryImport.Browser.JSParser

FixedPool.TestState {
    "pass":     Initialize=0
    "fail":     Initialize=0
}

Function.Test_Assert {
    Input: cond: Integer
    Input: msg: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(cond, 1) ThenBlock: {
            PrintMessage("[PASS] ")
            PrintMessage(msg)
            PrintMessage("\n")
            TestState.pass = Add(TestState.pass, 1)
        } ElseBlock: {
            PrintMessage("[FAIL] ")
            PrintMessage(msg)
            PrintMessage("\n")
            TestState.fail = Add(TestState.fail, 1)
        }
        ReturnValue(cond)
    }
}

Function.Test_URL {
    Output: Integer
    Body: {
        PrintMessage("=== URL Parser Tests ===\n")

        URL_Init()

        // Test 1: Full HTTPS URL with port, query, fragment
        h1 = URL_Parse("https://www.google.com:443/search?q=hello#top", 46)
        Test_Assert(GreaterEqual(h1, 0), "URL_Parse returns valid handle")

        sc = URL_GetScheme(h1)
        Test_Assert(EqualTo(StringCompare(sc, "https"), 0), "scheme = https")

        host = URL_GetHost(h1)
        Test_Assert(EqualTo(StringCompare(host, "www.google.com"), 0), "host = www.google.com")

        port = URL_GetPort(h1)
        Test_Assert(EqualTo(port, 443), "port = 443")

        path = URL_GetPath(h1)
        Test_Assert(EqualTo(StringCompare(path, "/search"), 0), "path = /search")

        query = URL_GetQuery(h1)
        Test_Assert(EqualTo(StringCompare(query, "q=hello"), 0), "query = q=hello")

        frag = URL_GetFragment(h1)
        Test_Assert(EqualTo(StringCompare(frag, "top"), 0), "fragment = top")

        Test_Assert(EqualTo(URL_IsHTTPS(h1), 1), "IsHTTPS = 1")

        // Test 2: Simple HTTP URL
        h2 = URL_Parse("http://example.com/index.html", 28)
        sc2 = URL_GetScheme(h2)
        Test_Assert(EqualTo(StringCompare(sc2, "http"), 0), "http scheme")
        Test_Assert(EqualTo(URL_GetPort(h2), 80), "default port 80")
        Test_Assert(EqualTo(URL_IsHTTPS(h2), 0), "IsHTTPS = 0")

        // Test 3: URL with no path
        h3 = URL_Parse("https://example.com", 19)
        p3 = URL_GetPath(h3)
        Test_Assert(EqualTo(StringCompare(p3, "/"), 0), "default path = /")
        Test_Assert(EqualTo(URL_GetPort(h3), 443), "https default port 443")

        // Test 4: Percent decode
        dec = URL_PercentDecode("hello%20world", 13)
        Test_Assert(EqualTo(StringCompare(dec, "hello world"), 0), "percent decode %20")

        // Test 5: URL_ToString roundtrip
        ts = URL_ToString(h2)
        PrintMessage("  URL_ToString: ")
        PrintMessage(ts)
        PrintMessage("\n")

        PrintMessage("\n")
        ReturnValue(0)
    }
}

Function.Test_DNS {
    Output: Integer
    Body: {
        PrintMessage("=== DNS Resolver Tests ===\n")

        DNS_Init()

        // Test 1: Parse IP
        ip = DNS_Resolve("93.184.216.34", 13)
        Test_Assert(GreaterThan(ip, 0), "DNS_Resolve numeric IP")

        ip_str = DNS_IP4ToString(ip)
        PrintMessage("  Resolved IP: ")
        PrintMessage(ip_str)
        PrintMessage("\n")
        Test_Assert(EqualTo(StringCompare(ip_str, "93.184.216.34"), 0), "IP roundtrip")

        // Test 2: Resolve real hostname (requires network)
        ip2 = DNS_Resolve("example.com", 11)
        IfCondition GreaterThan(ip2, 0) ThenBlock: {
            ip2_str = DNS_IP4ToString(ip2)
            PrintMessage("  example.com -> ")
            PrintMessage(ip2_str)
            PrintMessage("\n")
            Test_Assert(1, "DNS_Resolve example.com (live)")
        } ElseBlock: {
            PrintMessage("  [SKIP] DNS_Resolve example.com (no network)\n")
        }

        // Test 3: Cache hit
        ip3 = DNS_Resolve("example.com", 11)
        IfCondition GreaterThan(ip3, 0) ThenBlock: {
            Test_Assert(EqualTo(ip2, ip3), "DNS cache hit returns same IP")
        }

        PrintMessage("\n")
        ReturnValue(0)
    }
}

// ---- PNG decode test: builds a minimal 2x2 RGB PNG in memory ----
// Pixels: (0,0)=red(255,0,0) (1,0)=green(0,255,0)
//         (0,1)=blue(0,0,255) (1,1)=white(255,255,255)
// Output is BGRA after decode.
Function.Test_PNG {
    Output: Integer
    Body: {
        PrintMessage("=== PNG Decoder Tests ===\n")

        IMG_Init()

        // Build minimal 82-byte PNG in memory (stored/uncompressed DEFLATE)
        png_data = Allocate(90)
        MemorySet(png_data, 0, 90)

        // PNG signature (8 bytes)
        SetByte(png_data, 0, 137) SetByte(png_data, 1, 80) SetByte(png_data, 2, 78) SetByte(png_data, 3, 71)
        SetByte(png_data, 4, 13) SetByte(png_data, 5, 10) SetByte(png_data, 6, 26) SetByte(png_data, 7, 10)
        // IHDR chunk (25 bytes)
        SetByte(png_data, 8, 0) SetByte(png_data, 9, 0) SetByte(png_data, 10, 0) SetByte(png_data, 11, 13)
        SetByte(png_data, 12, 73) SetByte(png_data, 13, 72) SetByte(png_data, 14, 68) SetByte(png_data, 15, 82)
        SetByte(png_data, 16, 0) SetByte(png_data, 17, 0) SetByte(png_data, 18, 0) SetByte(png_data, 19, 2)
        SetByte(png_data, 20, 0) SetByte(png_data, 21, 0) SetByte(png_data, 22, 0) SetByte(png_data, 23, 2)
        SetByte(png_data, 24, 8) SetByte(png_data, 25, 2) SetByte(png_data, 26, 0) SetByte(png_data, 27, 0)
        SetByte(png_data, 28, 0) SetByte(png_data, 29, 253) SetByte(png_data, 30, 212) SetByte(png_data, 31, 154)
        SetByte(png_data, 32, 115)
        // IDAT chunk (37 bytes: len=25 + type + data + crc)
        // zlib: CMF=0x78 FLG=0x01, stored block BFINAL=1 BTYPE=0, LEN=14 NLEN=0xFFF1
        // raw scanlines: [0,255,0,0, 0,255,0] [0,0,0,255, 255,255,255]
        SetByte(png_data, 33, 0) SetByte(png_data, 34, 0) SetByte(png_data, 35, 0) SetByte(png_data, 36, 25)
        SetByte(png_data, 37, 73) SetByte(png_data, 38, 68) SetByte(png_data, 39, 65) SetByte(png_data, 40, 84)
        SetByte(png_data, 41, 120) SetByte(png_data, 42, 1) SetByte(png_data, 43, 1)
        SetByte(png_data, 44, 14) SetByte(png_data, 45, 0) SetByte(png_data, 46, 241) SetByte(png_data, 47, 255)
        SetByte(png_data, 48, 0) SetByte(png_data, 49, 255) SetByte(png_data, 50, 0) SetByte(png_data, 51, 0)
        SetByte(png_data, 52, 0) SetByte(png_data, 53, 255) SetByte(png_data, 54, 0) SetByte(png_data, 55, 0)
        SetByte(png_data, 56, 0) SetByte(png_data, 57, 0) SetByte(png_data, 58, 255) SetByte(png_data, 59, 255)
        SetByte(png_data, 60, 255) SetByte(png_data, 61, 255) SetByte(png_data, 62, 31) SetByte(png_data, 63, 238)
        SetByte(png_data, 64, 5) SetByte(png_data, 65, 251)
        // IDAT CRC
        SetByte(png_data, 66, 222) SetByte(png_data, 67, 221) SetByte(png_data, 68, 236) SetByte(png_data, 69, 43)
        // IEND chunk (12 bytes)
        SetByte(png_data, 70, 0) SetByte(png_data, 71, 0) SetByte(png_data, 72, 0) SetByte(png_data, 73, 0)
        SetByte(png_data, 74, 73) SetByte(png_data, 75, 69) SetByte(png_data, 76, 78) SetByte(png_data, 77, 68)
        SetByte(png_data, 78, 174) SetByte(png_data, 79, 66) SetByte(png_data, 80, 96) SetByte(png_data, 81, 130)

        png_len = 82

        // Decode the PNG
        h = IMG_DecodePNG(png_data, png_len)
        Test_Assert(GreaterEqual(h, 0), "IMG_DecodePNG returns valid handle")

        // Check dimensions
        w = IMG_GetWidth(h)
        ht = IMG_GetHeight(h)
        Test_Assert(EqualTo(w, 2), "PNG width = 2")
        Test_Assert(EqualTo(ht, 2), "PNG height = 2")

        // Check pixels (BGRA order)
        pix = IMG_GetPixels(h)

        // Pixel (0,0) = red -> BGRA = (0, 0, 255, 255)
        Test_Assert(EqualTo(GetByte(pix, 0), 0),   "px(0,0) B=0")
        Test_Assert(EqualTo(GetByte(pix, 1), 0),   "px(0,0) G=0")
        Test_Assert(EqualTo(GetByte(pix, 2), 255), "px(0,0) R=255")
        Test_Assert(EqualTo(GetByte(pix, 3), 255), "px(0,0) A=255")

        // Pixel (1,0) = green -> BGRA = (0, 255, 0, 255)
        Test_Assert(EqualTo(GetByte(pix, 4), 0),   "px(1,0) B=0")
        Test_Assert(EqualTo(GetByte(pix, 5), 255), "px(1,0) G=255")
        Test_Assert(EqualTo(GetByte(pix, 6), 0),   "px(1,0) R=0")
        Test_Assert(EqualTo(GetByte(pix, 7), 255), "px(1,0) A=255")

        // Pixel (0,1) = blue -> BGRA = (255, 0, 0, 255)
        Test_Assert(EqualTo(GetByte(pix, 8), 255), "px(0,1) B=255")
        Test_Assert(EqualTo(GetByte(pix, 9), 0),   "px(0,1) G=0")
        Test_Assert(EqualTo(GetByte(pix, 10), 0),  "px(0,1) R=0")
        Test_Assert(EqualTo(GetByte(pix, 11), 255),"px(0,1) A=255")

        // Pixel (1,1) = white -> BGRA = (255, 255, 255, 255)
        Test_Assert(EqualTo(GetByte(pix, 12), 255),"px(1,1) B=255")
        Test_Assert(EqualTo(GetByte(pix, 13), 255),"px(1,1) G=255")
        Test_Assert(EqualTo(GetByte(pix, 14), 255),"px(1,1) R=255")
        Test_Assert(EqualTo(GetByte(pix, 15), 255),"px(1,1) A=255")

        PrintMessage("\n")

        // === BTYPE=1 test: same 2x2 RGB image, zlib level 9 (fixed Huffman) ===
        PrintMessage("--- PNG BTYPE=1 (fixed Huffman) ---\n")
        png2 = Allocate(80)
        MemorySet(png2, 0, 80)
        SetByte(png2, 0, 137) SetByte(png2, 1, 80) SetByte(png2, 2, 78) SetByte(png2, 3, 71)
        SetByte(png2, 4, 13) SetByte(png2, 5, 10) SetByte(png2, 6, 26) SetByte(png2, 7, 10)
        SetByte(png2, 8, 0) SetByte(png2, 9, 0) SetByte(png2, 10, 0) SetByte(png2, 11, 13)
        SetByte(png2, 12, 73) SetByte(png2, 13, 72) SetByte(png2, 14, 68) SetByte(png2, 15, 82)
        SetByte(png2, 16, 0) SetByte(png2, 17, 0) SetByte(png2, 18, 0) SetByte(png2, 19, 2)
        SetByte(png2, 20, 0) SetByte(png2, 21, 0) SetByte(png2, 22, 0) SetByte(png2, 23, 2)
        SetByte(png2, 24, 8) SetByte(png2, 25, 2) SetByte(png2, 26, 0) SetByte(png2, 27, 0)
        SetByte(png2, 28, 0) SetByte(png2, 29, 253) SetByte(png2, 30, 212) SetByte(png2, 31, 154)
        SetByte(png2, 32, 115) SetByte(png2, 33, 0) SetByte(png2, 34, 0) SetByte(png2, 35, 0)
        SetByte(png2, 36, 18) SetByte(png2, 37, 73) SetByte(png2, 38, 68) SetByte(png2, 39, 65)
        SetByte(png2, 40, 84) SetByte(png2, 41, 120) SetByte(png2, 42, 218) SetByte(png2, 43, 99)
        SetByte(png2, 44, 248) SetByte(png2, 45, 207) SetByte(png2, 46, 192) SetByte(png2, 47, 192)
        SetByte(png2, 48, 0) SetByte(png2, 49, 194) SetByte(png2, 50, 12) SetByte(png2, 51, 255)
        SetByte(png2, 52, 129) SetByte(png2, 53, 0) SetByte(png2, 54, 0) SetByte(png2, 55, 31)
        SetByte(png2, 56, 238) SetByte(png2, 57, 5) SetByte(png2, 58, 251) SetByte(png2, 59, 241)
        SetByte(png2, 60, 171) SetByte(png2, 61, 186) SetByte(png2, 62, 119) SetByte(png2, 63, 0)
        SetByte(png2, 64, 0) SetByte(png2, 65, 0) SetByte(png2, 66, 0) SetByte(png2, 67, 73)
        SetByte(png2, 68, 69) SetByte(png2, 69, 78) SetByte(png2, 70, 68) SetByte(png2, 71, 174)
        SetByte(png2, 72, 66) SetByte(png2, 73, 96) SetByte(png2, 74, 130)

        h2 = IMG_DecodePNG(png2, 75)
        Test_Assert(GreaterEqual(h2, 0), "BTYPE1: IMG_DecodePNG returns valid handle")

        w2 = IMG_GetWidth(h2)
        ht2 = IMG_GetHeight(h2)
        Test_Assert(EqualTo(w2, 2), "BTYPE1: PNG width = 2")
        Test_Assert(EqualTo(ht2, 2), "BTYPE1: PNG height = 2")

        pix2 = IMG_GetPixels(h2)

        // Same expected values as BTYPE=0 test
        Test_Assert(EqualTo(GetByte(pix2, 0), 0),   "BTYPE1: px(0,0) B=0")
        Test_Assert(EqualTo(GetByte(pix2, 1), 0),   "BTYPE1: px(0,0) G=0")
        Test_Assert(EqualTo(GetByte(pix2, 2), 255), "BTYPE1: px(0,0) R=255")
        Test_Assert(EqualTo(GetByte(pix2, 3), 255), "BTYPE1: px(0,0) A=255")
        Test_Assert(EqualTo(GetByte(pix2, 4), 0),   "BTYPE1: px(1,0) B=0")
        Test_Assert(EqualTo(GetByte(pix2, 5), 255), "BTYPE1: px(1,0) G=255")
        Test_Assert(EqualTo(GetByte(pix2, 6), 0),   "BTYPE1: px(1,0) R=0")
        Test_Assert(EqualTo(GetByte(pix2, 7), 255), "BTYPE1: px(1,0) A=255")
        Test_Assert(EqualTo(GetByte(pix2, 8), 255), "BTYPE1: px(0,1) B=255")
        Test_Assert(EqualTo(GetByte(pix2, 9), 0),   "BTYPE1: px(0,1) G=0")
        Test_Assert(EqualTo(GetByte(pix2, 10), 0),  "BTYPE1: px(0,1) R=0")
        Test_Assert(EqualTo(GetByte(pix2, 11), 255),"BTYPE1: px(0,1) A=255")
        Test_Assert(EqualTo(GetByte(pix2, 12), 255),"BTYPE1: px(1,1) B=255")
        Test_Assert(EqualTo(GetByte(pix2, 13), 255),"BTYPE1: px(1,1) G=255")
        Test_Assert(EqualTo(GetByte(pix2, 14), 255),"BTYPE1: px(1,1) R=255")
        Test_Assert(EqualTo(GetByte(pix2, 15), 255),"BTYPE1: px(1,1) A=255")

        // === BTYPE=2 test: same 2x2 RGB image, dynamic Huffman ===
        PrintMessage("--- PNG BTYPE=2 (dynamic Huffman) ---\n")
        png3 = Allocate(80)
        MemorySet(png3, 0, 80)
        SetByte(png3, 0, 137) SetByte(png3, 1, 80) SetByte(png3, 2, 78) SetByte(png3, 3, 71)
        SetByte(png3, 4, 13) SetByte(png3, 5, 10) SetByte(png3, 6, 26) SetByte(png3, 7, 10)
        SetByte(png3, 8, 0) SetByte(png3, 9, 0) SetByte(png3, 10, 0) SetByte(png3, 11, 13)
        SetByte(png3, 12, 73) SetByte(png3, 13, 72) SetByte(png3, 14, 68) SetByte(png3, 15, 82)
        SetByte(png3, 16, 0) SetByte(png3, 17, 0) SetByte(png3, 18, 0) SetByte(png3, 19, 2)
        SetByte(png3, 20, 0) SetByte(png3, 21, 0) SetByte(png3, 22, 0) SetByte(png3, 23, 2)
        SetByte(png3, 24, 8) SetByte(png3, 25, 2) SetByte(png3, 26, 0) SetByte(png3, 27, 0)
        SetByte(png3, 28, 0) SetByte(png3, 29, 253) SetByte(png3, 30, 212) SetByte(png3, 31, 154)
        SetByte(png3, 32, 115) SetByte(png3, 33, 0) SetByte(png3, 34, 0) SetByte(png3, 35, 0)
        SetByte(png3, 36, 21) SetByte(png3, 37, 73) SetByte(png3, 38, 68) SetByte(png3, 39, 65)
        SetByte(png3, 40, 84) SetByte(png3, 41, 120) SetByte(png3, 42, 1) SetByte(png3, 43, 5)
        SetByte(png3, 44, 193) SetByte(png3, 45, 1) SetByte(png3, 46, 1) SetByte(png3, 47, 0)
        SetByte(png3, 48, 0) SetByte(png3, 49, 0) SetByte(png3, 50, 128) SetByte(png3, 51, 16)
        SetByte(png3, 52, 255) SetByte(png3, 53, 79) SetByte(png3, 54, 23) SetByte(png3, 55, 66)
        SetByte(png3, 56, 80) SetByte(png3, 57, 53) SetByte(png3, 58, 31) SetByte(png3, 59, 238)
        SetByte(png3, 60, 5) SetByte(png3, 61, 251) SetByte(png3, 62, 163) SetByte(png3, 63, 87)
        SetByte(png3, 64, 242) SetByte(png3, 65, 226) SetByte(png3, 66, 0) SetByte(png3, 67, 0)
        SetByte(png3, 68, 0) SetByte(png3, 69, 0) SetByte(png3, 70, 73) SetByte(png3, 71, 69)
        SetByte(png3, 72, 78) SetByte(png3, 73, 68) SetByte(png3, 74, 174) SetByte(png3, 75, 66)
        SetByte(png3, 76, 96) SetByte(png3, 77, 130)

        h3 = IMG_DecodePNG(png3, 78)
        Test_Assert(GreaterEqual(h3, 0), "BTYPE2: IMG_DecodePNG returns valid handle")

        w3 = IMG_GetWidth(h3)
        ht3 = IMG_GetHeight(h3)
        Test_Assert(EqualTo(w3, 2), "BTYPE2: PNG width = 2")
        Test_Assert(EqualTo(ht3, 2), "BTYPE2: PNG height = 2")

        pix3 = IMG_GetPixels(h3)

        Test_Assert(EqualTo(GetByte(pix3, 0), 0),   "BTYPE2: px(0,0) B=0")
        Test_Assert(EqualTo(GetByte(pix3, 1), 0),   "BTYPE2: px(0,0) G=0")
        Test_Assert(EqualTo(GetByte(pix3, 2), 255), "BTYPE2: px(0,0) R=255")
        Test_Assert(EqualTo(GetByte(pix3, 3), 255), "BTYPE2: px(0,0) A=255")
        Test_Assert(EqualTo(GetByte(pix3, 4), 0),   "BTYPE2: px(1,0) B=0")
        Test_Assert(EqualTo(GetByte(pix3, 5), 255), "BTYPE2: px(1,0) G=255")
        Test_Assert(EqualTo(GetByte(pix3, 6), 0),   "BTYPE2: px(1,0) R=0")
        Test_Assert(EqualTo(GetByte(pix3, 7), 255), "BTYPE2: px(1,0) A=255")
        Test_Assert(EqualTo(GetByte(pix3, 8), 255), "BTYPE2: px(0,1) B=255")
        Test_Assert(EqualTo(GetByte(pix3, 9), 0),   "BTYPE2: px(0,1) G=0")
        Test_Assert(EqualTo(GetByte(pix3, 10), 0),  "BTYPE2: px(0,1) R=0")
        Test_Assert(EqualTo(GetByte(pix3, 11), 255),"BTYPE2: px(0,1) A=255")
        Test_Assert(EqualTo(GetByte(pix3, 12), 255),"BTYPE2: px(1,1) B=255")
        Test_Assert(EqualTo(GetByte(pix3, 13), 255),"BTYPE2: px(1,1) G=255")
        Test_Assert(EqualTo(GetByte(pix3, 14), 255),"BTYPE2: px(1,1) R=255")
        Test_Assert(EqualTo(GetByte(pix3, 15), 255),"BTYPE2: px(1,1) A=255")

        PrintMessage("\n")
        ReturnValue(0)
    }
}

Function.Test_HTTP {
    Output: Integer
    Body: {
        PrintMessage("=== HTTP Client Tests ===\n")

        HTTP_Init()

        // Test: HTTP GET to example.com (requires network)
        u = URL_Parse("http://example.com/", 19)
        IfCondition GreaterEqual(u, 0) ThenBlock: {
            resp = HTTP_Get(u)
            IfCondition GreaterEqual(resp, 0) ThenBlock: {
                status = HTTP_GetStatus(resp)
                PrintMessage("  Status: ")
                PrintNumber(status)
                PrintMessage("\n")

                body_len = HTTP_GetBodyLen(resp)
                PrintMessage("  Body length: ")
                PrintNumber(body_len)
                PrintMessage("\n")

                ctype = HTTP_GetContentType(resp)
                IfCondition NotEqual(ctype, 0) ThenBlock: {
                    PrintMessage("  Content-Type: ")
                    PrintMessage(ctype)
                    PrintMessage("\n")
                }

                Test_Assert(EqualTo(status, 200), "HTTP GET example.com status 200")
                Test_Assert(GreaterThan(body_len, 100), "HTTP body > 100 bytes")
            } ElseBlock: {
                PrintMessage("  [SKIP] HTTP GET failed (no network?)\n")
            }
        }

        PrintMessage("\n")
        ReturnValue(0)
    }
}

Function.Test_JPEG {
    Output: Integer
    Body: {
        PrintMessage("=== JPEG Decoder Tests ===\n")

        // ---- Test 1: Solid gray (128,128,128) — all-zero DCT coefficients ----
        PrintMessage("--- JPEG Test 1: solid gray 128 ---\n")

        jpg1 = Allocate(252)
        MemorySet(jpg1, 0, 252)
        // Fill runs of 1s (quant table bodies)
        MemorySet(Add(jpg1, 7), 1, 64)
        MemorySet(Add(jpg1, 75), 1, 65)
        // SOF0 component sampling factors and other scattered 1s
        MemorySet(Add(jpg1, 181), 1, 2)
        // Individual non-0/1 bytes — markers and headers
        SetByte(jpg1, 0, 255) SetByte(jpg1, 1, 216)              // FF D8 (SOI)
        SetByte(jpg1, 2, 255) SetByte(jpg1, 3, 219)              // FF DB (DQT)
        SetByte(jpg1, 5, 67)                                      // length 67
        SetByte(jpg1, 71, 255) SetByte(jpg1, 72, 219)            // FF DB (DQT 2)
        SetByte(jpg1, 74, 67)                                     // length 67
        SetByte(jpg1, 140, 255) SetByte(jpg1, 141, 192)          // FF C0 (SOF0)
        SetByte(jpg1, 143, 17) SetByte(jpg1, 144, 8)             // len=17, prec=8
        SetByte(jpg1, 146, 8) SetByte(jpg1, 148, 8)              // h=8, w=8
        SetByte(jpg1, 149, 3)                                     // 3 components
        SetByte(jpg1, 150, 1) SetByte(jpg1, 151, 17)             // Y: id=1, h=1,v=1
        SetByte(jpg1, 153, 2) SetByte(jpg1, 154, 17)             // Cb: id=2
        SetByte(jpg1, 155, 1)                                     // Cb: qt=1
        SetByte(jpg1, 156, 3) SetByte(jpg1, 157, 17)             // Cr: id=3
        SetByte(jpg1, 158, 1)                                     // Cr: qt=1
        SetByte(jpg1, 159, 255) SetByte(jpg1, 160, 196)          // FF C4 (DHT)
        SetByte(jpg1, 162, 74)                                    // length=74
        // DHT DC0: counts[0]=1, symbol=0 (category 0)
        SetByte(jpg1, 164, 1)                                     // 1 code of length 1
        // DC0 symbol = 0 (already 0 from memset)
        // DHT DC1: at offset 181 — counts[0]=1, symbol=0
        SetByte(jpg1, 181, 1) SetByte(jpg1, 182, 1)              // wait, already set via MemorySet
        // DHT AC0: at offset 199 — class=0x10
        SetByte(jpg1, 199, 16)                                    // class=1(AC), id=0
        SetByte(jpg1, 200, 1)                                     // 1 code of length 1
        // DHT AC1: at offset 217 — class=0x11
        SetByte(jpg1, 217, 17)                                    // class=1(AC), id=1
        SetByte(jpg1, 218, 1)                                     // 1 code of length 1
        // SOS marker
        SetByte(jpg1, 235, 255) SetByte(jpg1, 236, 218)          // FF DA (SOS)
        SetByte(jpg1, 238, 12) SetByte(jpg1, 239, 3)             // len=12, ns=3
        SetByte(jpg1, 240, 1)                                     // comp 1 (Y) -> DC0/AC0
        SetByte(jpg1, 242, 2) SetByte(jpg1, 243, 17)             // comp 2 (Cb) -> DC1/AC1
        SetByte(jpg1, 244, 3) SetByte(jpg1, 245, 17)             // comp 3 (Cr) -> DC1/AC1
        SetByte(jpg1, 247, 63)                                    // Se=63
        SetByte(jpg1, 249, 3)                                     // entropy data: 0x03 (6 zero bits + 2 pad bits)
        SetByte(jpg1, 250, 255) SetByte(jpg1, 251, 217)          // FF D9 (EOI)

        h1 = IMG_DecodeJPEG(jpg1, 252)
        Test_Assert(GreaterEqual(h1, 0), "JPEG1: decode returns valid handle")
        Test_Assert(EqualTo(IMG_GetWidth(h1), 8), "JPEG1: width = 8")
        Test_Assert(EqualTo(IMG_GetHeight(h1), 8), "JPEG1: height = 8")

        // Check pixel (0,0) — expect BGRA (128,128,128,255)
        pix1 = IMG_GetPixels(h1)
        Test_Assert(EqualTo(GetByte(pix1, 0), 128), "JPEG1: px(0,0) B=128")
        Test_Assert(EqualTo(GetByte(pix1, 1), 128), "JPEG1: px(0,0) G=128")
        Test_Assert(EqualTo(GetByte(pix1, 2), 128), "JPEG1: px(0,0) R=128")
        Test_Assert(EqualTo(GetByte(pix1, 3), 255), "JPEG1: px(0,0) A=255")
        // Check pixel (7,7) — should be same solid color
        p77 = Multiply(Add(Multiply(7, 8), 7), 4)
        Test_Assert(EqualTo(GetByte(pix1, p77), 128), "JPEG1: px(7,7) B=128")
        Test_Assert(EqualTo(GetByte(pix1, Add(p77, 1)), 128), "JPEG1: px(7,7) G=128")
        Test_Assert(EqualTo(GetByte(pix1, Add(p77, 2)), 128), "JPEG1: px(7,7) R=128")
        Test_Assert(EqualTo(GetByte(pix1, Add(p77, 3)), 255), "JPEG1: px(7,7) A=255")

        // ---- Test 2: Solid gray 200 — non-zero DC coefficient ----
        PrintMessage("--- JPEG Test 2: solid gray 200 ---\n")

        jpg2 = Allocate(253)
        MemorySet(jpg2, 0, 253)
        MemorySet(Add(jpg2, 7), 1, 64)
        MemorySet(Add(jpg2, 75), 1, 65)
        // Copy same structure as test 1 for markers
        SetByte(jpg2, 0, 255) SetByte(jpg2, 1, 216)
        SetByte(jpg2, 2, 255) SetByte(jpg2, 3, 219)
        SetByte(jpg2, 5, 67)
        SetByte(jpg2, 71, 255) SetByte(jpg2, 72, 219)
        SetByte(jpg2, 74, 67)
        SetByte(jpg2, 140, 255) SetByte(jpg2, 141, 192)
        SetByte(jpg2, 143, 17) SetByte(jpg2, 144, 8)
        SetByte(jpg2, 146, 8) SetByte(jpg2, 148, 8)
        SetByte(jpg2, 149, 3)
        SetByte(jpg2, 150, 1) SetByte(jpg2, 151, 17)
        SetByte(jpg2, 153, 2) SetByte(jpg2, 154, 17)
        SetByte(jpg2, 155, 1)
        SetByte(jpg2, 156, 3) SetByte(jpg2, 157, 17)
        SetByte(jpg2, 158, 1)
        SetByte(jpg2, 159, 255) SetByte(jpg2, 160, 196)
        SetByte(jpg2, 162, 74)
        // DHT DC0: symbol = 10 (category 10 for DC=576)
        SetByte(jpg2, 164, 1)                                     // 1 code of length 1
        SetByte(jpg2, 180, 10)                                    // symbol: category 10
        // DHT DC1: counts[0]=1, symbol=0
        SetByte(jpg2, 181, 1) SetByte(jpg2, 182, 1)
        // DHT AC0:
        SetByte(jpg2, 199, 16) SetByte(jpg2, 200, 1)
        // DHT AC1:
        SetByte(jpg2, 217, 17) SetByte(jpg2, 218, 1)
        // SOS
        SetByte(jpg2, 235, 255) SetByte(jpg2, 236, 218)
        SetByte(jpg2, 238, 12) SetByte(jpg2, 239, 3)
        SetByte(jpg2, 240, 1)
        SetByte(jpg2, 242, 2) SetByte(jpg2, 243, 17)
        SetByte(jpg2, 244, 3) SetByte(jpg2, 245, 17)
        SetByte(jpg2, 247, 63)
        // Entropy data: Y DC cat 10 (1 bit: 0) + 576 in 10 bits + AC EOB + Cb DC0 + Cb EOB + Cr DC0 + Cr EOB
        // Binary: 0 1001000000 0 0 0 0 0 = 0x48 0x00
        SetByte(jpg2, 249, 72)                                    // 0x48
        // byte 250 = 0x00 (already zero from memset)
        SetByte(jpg2, 251, 255) SetByte(jpg2, 252, 217)          // FF D9 (EOI)

        h2 = IMG_DecodeJPEG(jpg2, 253)
        Test_Assert(GreaterEqual(h2, 0), "JPEG2: decode returns valid handle")
        Test_Assert(EqualTo(IMG_GetWidth(h2), 8), "JPEG2: width = 8")
        Test_Assert(EqualTo(IMG_GetHeight(h2), 8), "JPEG2: height = 8")

        pix2 = IMG_GetPixels(h2)
        Test_Assert(EqualTo(GetByte(pix2, 0), 200), "JPEG2: px(0,0) B=200")
        Test_Assert(EqualTo(GetByte(pix2, 1), 200), "JPEG2: px(0,0) G=200")
        Test_Assert(EqualTo(GetByte(pix2, 2), 200), "JPEG2: px(0,0) R=200")
        Test_Assert(EqualTo(GetByte(pix2, 3), 255), "JPEG2: px(0,0) A=255")
        p77b = Multiply(Add(Multiply(7, 8), 7), 4)
        Test_Assert(EqualTo(GetByte(pix2, p77b), 200), "JPEG2: px(7,7) B=200")
        Test_Assert(EqualTo(GetByte(pix2, Add(p77b, 1)), 200), "JPEG2: px(7,7) G=200")
        Test_Assert(EqualTo(GetByte(pix2, Add(p77b, 2)), 200), "JPEG2: px(7,7) R=200")
        Test_Assert(EqualTo(GetByte(pix2, Add(p77b, 3)), 255), "JPEG2: px(7,7) A=255")

        PrintMessage("\n")
        ReturnValue(0)
    }
}

// =============================================================================
// HTML TOKENIZER TESTS
// =============================================================================
Function.Test_HTMLTokenizer {
    Output: Integer
    Body: {
        PrintMessage("=== HTML Tokenizer Tests ===\n")

        HTK_Init()

        // Test 1: Simple tag
        HTK_Reset()
        tok_ok = HTK_Tokenize("<div>hello</div>", 16)
        Test_Assert(EqualTo(tok_ok, 1), "HTK: tokenize simple HTML ok")

        tc = HTK_Count()
        // Expect: TAG_OPEN(div), TAG_END, TEXT(hello), TAG_CLOSE(div), EOF
        Test_Assert(EqualTo(tc, 5), "HTK: simple HTML 5 tokens")

        t0 = HTK_GetType(0)
        Test_Assert(EqualTo(t0, HTKType.TAG_OPEN), "HTK: token 0 = TAG_OPEN")

        t0_ptr = HTK_GetPtr(0)
        Test_Assert(EqualTo(StringCompare(t0_ptr, "div"), 0), "HTK: token 0 name = div")

        t1 = HTK_GetType(1)
        Test_Assert(EqualTo(t1, HTKType.TAG_END), "HTK: token 1 = TAG_END")

        t2 = HTK_GetType(2)
        Test_Assert(EqualTo(t2, HTKType.TEXT), "HTK: token 2 = TEXT")

        t2_ptr = HTK_GetPtr(2)
        Test_Assert(EqualTo(StringCompare(t2_ptr, "hello"), 0), "HTK: token 2 text = hello")

        t3 = HTK_GetType(3)
        Test_Assert(EqualTo(t3, HTKType.TAG_CLOSE), "HTK: token 3 = TAG_CLOSE")

        t4 = HTK_GetType(4)
        Test_Assert(EqualTo(t4, HTKType.EOF), "HTK: token 4 = EOF")

        // Test 2: Self-closing tag
        HTK_Reset()
        tok_ok2 = HTK_Tokenize("<br/>", 5)
        Test_Assert(EqualTo(tok_ok2, 1), "HTK: tokenize self-close ok")
        tc2 = HTK_Count()
        Test_Assert(EqualTo(tc2, 3), "HTK: self-close 3 tokens")
        sc_type = HTK_GetType(1)
        Test_Assert(EqualTo(sc_type, HTKType.TAG_SELF_CLOSE), "HTK: self-close token type")

        // Test 3: Attributes
        HTK_Reset()
        tok_ok3 = HTK_Tokenize("<a href=\"test.html\" class=\"link\">click</a>", 41)
        Test_Assert(EqualTo(tok_ok3, 1), "HTK: tokenize with attrs ok")
        // TAG_OPEN(a), ATTR_NAME(href), ATTR_VALUE(test.html), ATTR_NAME(class), ATTR_VALUE(link), TAG_END, TEXT(click), TAG_CLOSE(a), EOF
        tc3 = HTK_Count()
        Test_Assert(EqualTo(tc3, 9), "HTK: attr HTML 9 tokens")

        a_name = HTK_GetType(1)
        Test_Assert(EqualTo(a_name, HTKType.ATTR_NAME), "HTK: attr 1 = ATTR_NAME")

        a_val = HTK_GetType(2)
        Test_Assert(EqualTo(a_val, HTKType.ATTR_VALUE), "HTK: attr 2 = ATTR_VALUE")

        a_val_ptr = HTK_GetPtr(2)
        Test_Assert(EqualTo(StringCompare(a_val_ptr, "test.html"), 0), "HTK: attr value = test.html")

        // Test 4: Case-insensitive tags
        HTK_Reset()
        tok_ok4 = HTK_Tokenize("<DIV>x</DIV>", 12)
        Test_Assert(EqualTo(tok_ok4, 1), "HTK: case-insensitive ok")
        ci_ptr = HTK_GetPtr(0)
        Test_Assert(EqualTo(StringCompare(ci_ptr, "div"), 0), "HTK: DIV lowercased to div")

        // Test 5: DOCTYPE handling
        HTK_Reset()
        tok_ok5 = HTK_Tokenize("<!DOCTYPE html><p>hi</p>", 24)
        Test_Assert(EqualTo(tok_ok5, 1), "HTK: DOCTYPE handled ok")
        dt_type = HTK_GetType(0)
        Test_Assert(EqualTo(dt_type, HTKType.DOCTYPE), "HTK: first token = DOCTYPE")

        // Test 6: Comment
        HTK_Reset()
        tok_ok6 = HTK_Tokenize("<!-- comment --><b>x</b>", 24)
        Test_Assert(EqualTo(tok_ok6, 1), "HTK: comment handled ok")
        cm_type = HTK_GetType(0)
        Test_Assert(EqualTo(cm_type, HTKType.COMMENT), "HTK: first token = COMMENT")

        PrintMessage("\n")
        ReturnValue(0)
    }
}

// =============================================================================
// HTML DOM TESTS
// =============================================================================
Function.Test_HTMLDom {
    Output: Integer
    Body: {
        PrintMessage("=== HTML DOM Tests ===\n")

        DOM_Init()

        // Test 1: Simple tree
        root = DOM_ParseString("<div><p>hello</p></div>", 23)
        Test_Assert(GreaterEqual(root, 0), "DOM: parse simple HTML ok")

        nc = DOM_NodeCount()
        // ROOT, div, p, TEXT(hello) = 4 nodes
        Test_Assert(EqualTo(nc, 4), "DOM: 4 nodes created")

        rtype = DOM_GetType(root)
        Test_Assert(EqualTo(rtype, DOMType.ROOT), "DOM: root is ROOT type")

        // div is first child of root
        div_idx = DOM_GetFirstChild(root)
        Test_Assert(GreaterEqual(div_idx, 0), "DOM: root has first child")
        div_tag = DOM_GetTag(div_idx)
        Test_Assert(EqualTo(StringCompare(div_tag, "div"), 0), "DOM: first child is div")

        // p is child of div
        p_idx = DOM_GetFirstChild(div_idx)
        Test_Assert(GreaterEqual(p_idx, 0), "DOM: div has first child")
        p_tag = DOM_GetTag(p_idx)
        Test_Assert(EqualTo(StringCompare(p_tag, "p"), 0), "DOM: div child is p")

        // text is child of p
        txt_idx = DOM_GetFirstChild(p_idx)
        Test_Assert(GreaterEqual(txt_idx, 0), "DOM: p has first child")
        txt_type = DOM_GetType(txt_idx)
        Test_Assert(EqualTo(txt_type, DOMType.TEXT), "DOM: p child is TEXT")
        txt_ptr = DOM_GetText(txt_idx)
        Test_Assert(EqualTo(StringCompare(txt_ptr, "hello"), 0), "DOM: text content = hello")

        // parent link
        p_parent = DOM_GetParent(p_idx)
        Test_Assert(EqualTo(p_parent, div_idx), "DOM: p parent = div")

        // Test 2: Void elements (br, img)
        DOM_Reset()
        HTK_Reset()
        root2 = DOM_ParseString("<p>a<br>b</p>", 13)
        Test_Assert(GreaterEqual(root2, 0), "DOM: void element parse ok")
        p2_idx = DOM_GetFirstChild(root2)
        p2_cc = DOM_GetChildCount(p2_idx)
        // p has 3 children: TEXT(a), br, TEXT(b)
        Test_Assert(EqualTo(p2_cc, 3), "DOM: p has 3 children with br")

        // Test 3: Attributes
        DOM_Reset()
        HTK_Reset()
        root3 = DOM_ParseString("<div id=\"main\" class=\"box\">x</div>", 34)
        Test_Assert(GreaterEqual(root3, 0), "DOM: attr parse ok")
        d3 = DOM_GetFirstChild(root3)
        ac = DOM_AttrCount(d3)
        Test_Assert(EqualTo(ac, 2), "DOM: div has 2 attrs")
        id_val = DOM_GetAttr(d3, "id")
        Test_Assert(NotEqual(id_val, 0), "DOM: id attr found")
        Test_Assert(EqualTo(StringCompare(id_val, "main"), 0), "DOM: id = main")
        cl_val = DOM_GetAttr(d3, "class")
        Test_Assert(EqualTo(StringCompare(cl_val, "box"), 0), "DOM: class = box")

        // Test 4: FindByTag
        DOM_Reset()
        HTK_Reset()
        root4 = DOM_ParseString("<div><span>a</span><p>b</p></div>", 33)
        found_p = DOM_FindByTag(root4, "p")
        Test_Assert(GreaterEqual(found_p, 0), "DOM: FindByTag(p) found")
        fp_tag = DOM_GetTag(found_p)
        Test_Assert(EqualTo(StringCompare(fp_tag, "p"), 0), "DOM: found tag is p")

        // Test 5: FindById
        DOM_Reset()
        HTK_Reset()
        root5 = DOM_ParseString("<div><span id=\"target\">yes</span></div>", 39)
        found_id = DOM_FindById(root5, "target")
        Test_Assert(GreaterEqual(found_id, 0), "DOM: FindById(target) found")
        fid_tag = DOM_GetTag(found_id)
        Test_Assert(EqualTo(StringCompare(fid_tag, "span"), 0), "DOM: found id tag is span")

        // Test 6: Sibling links
        DOM_Reset()
        HTK_Reset()
        root6 = DOM_ParseString("<ul><li>a</li><li>b</li><li>c</li></ul>", 39)
        ul = DOM_GetFirstChild(root6)
        li1 = DOM_GetFirstChild(ul)
        li2 = DOM_GetNextSib(li1)
        Test_Assert(GreaterEqual(li2, 0), "DOM: li2 is next sib of li1")
        li3 = DOM_GetNextSib(li2)
        Test_Assert(GreaterEqual(li3, 0), "DOM: li3 is next sib of li2")
        li2_back = DOM_GetPrevSib(li3)
        Test_Assert(EqualTo(li2_back, li2), "DOM: prev sib of li3 = li2")

        PrintMessage("\n")
        ReturnValue(0)
    }
}

// =============================================================================
// CSS PARSE TESTS
// =============================================================================
Function.Test_CSSParse {
    Output: Integer
    Body: {
        PrintMessage("=== CSS Parse Tests ===\n")

        CSS_Init()

        // Test 1: Inline style
        CSS_Reset()
        r1 = CSS_ParseInline("color: red; font-size: 16px;", 28)
        Test_Assert(GreaterEqual(r1, 0), "CSS: parse inline ok")
        r1_pc = CSS_RulePropCount(r1)
        Test_Assert(EqualTo(r1_pc, 2), "CSS: inline has 2 properties")

        cv = CSS_GetPropVal(r1, "color")
        Test_Assert(NotEqual(cv, 0), "CSS: color property found")
        Test_Assert(EqualTo(StringCompare(cv, "red"), 0), "CSS: color = red")

        fv = CSS_GetPropVal(r1, "font-size")
        Test_Assert(NotEqual(fv, 0), "CSS: font-size property found")
        Test_Assert(EqualTo(StringCompare(fv, "16px"), 0), "CSS: font-size = 16px")

        // Test 2: Inline specificity = 1000
        sp1 = CSS_RuleSpecificity(r1)
        Test_Assert(EqualTo(sp1, 1000), "CSS: inline specificity = 1000")

        // Test 3: Stylesheet parsing
        CSS_Reset()
        rc = CSS_ParseSheet("p { margin: 0; padding: 5px; }", 30)
        Test_Assert(EqualTo(rc, 1), "CSS: parsed 1 rule from sheet")

        r2_st = CSS_RuleSelType(0)
        Test_Assert(EqualTo(r2_st, CSSSelType.TAG), "CSS: rule sel type = TAG")

        r2_sp = CSS_RuleSelPtr(0)
        Test_Assert(EqualTo(StringCompare(r2_sp, "p"), 0), "CSS: rule selector = p")

        r2_pc = CSS_RulePropCount(0)
        Test_Assert(EqualTo(r2_pc, 2), "CSS: rule has 2 properties")

        mv = CSS_GetPropVal(0, "margin")
        Test_Assert(EqualTo(StringCompare(mv, "0"), 0), "CSS: margin = 0")

        pv = CSS_GetPropVal(0, "padding")
        Test_Assert(EqualTo(StringCompare(pv, "5px"), 0), "CSS: padding = 5px")

        // Test 4: Specificity values
        r2_spec = CSS_RuleSpecificity(0)
        Test_Assert(EqualTo(r2_spec, 1), "CSS: tag specificity = 1")

        // Test 5: Class selector
        CSS_Reset()
        rc2 = CSS_ParseSheet(".box { display: flex; }", 23)
        Test_Assert(EqualTo(rc2, 1), "CSS: class selector parsed")
        cs_type = CSS_RuleSelType(0)
        Test_Assert(EqualTo(cs_type, CSSSelType.CLASS), "CSS: selector type = CLASS")
        cs_spec = CSS_RuleSpecificity(0)
        Test_Assert(EqualTo(cs_spec, 10), "CSS: class specificity = 10")

        // Test 6: ID selector
        CSS_Reset()
        rc3 = CSS_ParseSheet("#main { width: 100%; }", 22)
        Test_Assert(EqualTo(rc3, 1), "CSS: id selector parsed")
        id_type = CSS_RuleSelType(0)
        Test_Assert(EqualTo(id_type, CSSSelType.ID), "CSS: selector type = ID")
        id_spec = CSS_RuleSpecificity(0)
        Test_Assert(EqualTo(id_spec, 100), "CSS: id specificity = 100")

        // Test 7: Selector matching
        Test_Assert(EqualTo(CSS_MatchesTag(0, "div"), 0), "CSS: #main doesn't match div")
        Test_Assert(EqualTo(CSS_MatchesId(0, "main"), 1), "CSS: #main matches id=main")

        // Test 8: Multiple rules
        CSS_Reset()
        rc4 = CSS_ParseSheet("h1 { color: blue; } p { color: black; }", 40)
        Test_Assert(EqualTo(rc4, 2), "CSS: parsed 2 rules")
        h1_sel = CSS_RuleSelPtr(0)
        Test_Assert(EqualTo(StringCompare(h1_sel, "h1"), 0), "CSS: rule 0 sel = h1")
        p_sel = CSS_RuleSelPtr(1)
        Test_Assert(EqualTo(StringCompare(p_sel, "p"), 0), "CSS: rule 1 sel = p")

        PrintMessage("\n")
        ReturnValue(0)
    }
}

// =============================================================================
// LIVE HTML INTEGRATION TEST — full pipeline on real web page
// =============================================================================
Function.Test_LiveHTML {
    Output: Integer
    Body: {
        PrintMessage("=== Live HTML Pipeline Test ===\n")

        // Reuse HTTP_Init already called by Test_HTTP
        // Fetch example.com
        live_url = URL_Parse("http://example.com/", 19)
        IfCondition LessThan(live_url, 0) ThenBlock: {
            PrintMessage("  [SKIP] URL parse failed\n")
            ReturnValue(0)
        }

        live_resp = HTTP_Get(live_url)
        IfCondition LessThan(live_resp, 0) ThenBlock: {
            PrintMessage("  [SKIP] HTTP fetch failed (no network?)\n")
            ReturnValue(0)
        }

        live_status = HTTP_GetStatus(live_resp)
        Test_Assert(EqualTo(live_status, 200), "LIVE: HTTP 200 OK")

        live_body = HTTP_GetBody(live_resp)
        live_blen = HTTP_GetBodyLen(live_resp)
        Test_Assert(GreaterThan(live_blen, 200), "LIVE: body > 200 bytes")

        // Tokenize real HTML
        HTK_Reset()
        live_tok = HTK_Tokenize(live_body, live_blen)
        Test_Assert(EqualTo(live_tok, 1), "LIVE: tokenize ok")

        live_tc = HTK_Count()
        Test_Assert(GreaterThan(live_tc, 20), "LIVE: > 20 tokens")
        PrintMessage("  tokens: ")
        PrintNumber(live_tc)
        PrintMessage("\n")

        // Build DOM tree
        DOM_Reset()
        live_root = DOM_ParseString(live_body, live_blen)
        Test_Assert(GreaterEqual(live_root, 0), "LIVE: DOM parse ok")

        live_nc = DOM_NodeCount()
        Test_Assert(GreaterThan(live_nc, 5), "LIVE: > 5 DOM nodes")
        PrintMessage("  DOM nodes: ")
        PrintNumber(live_nc)
        PrintMessage("\n")

        // Find <h1> — example.com has "Example Domain"
        live_h1 = DOM_FindByTag(live_root, "h1")
        Test_Assert(GreaterEqual(live_h1, 0), "LIVE: found <h1>")

        IfCondition GreaterEqual(live_h1, 0) ThenBlock: {
            h1_child = DOM_GetFirstChild(live_h1)
            IfCondition GreaterEqual(h1_child, 0) ThenBlock: {
                h1_text = DOM_GetText(h1_child)
                IfCondition NotEqual(h1_text, 0) ThenBlock: {
                    PrintMessage("  h1 text: ")
                    PrintMessage(h1_text)
                    PrintMessage("\n")
                    h1_cmp = StringContains(h1_text, "Example")
                    Test_Assert(EqualTo(h1_cmp, 1), "LIVE: h1 contains 'Example'")
                }
            }
        }

        // Find <style> and parse CSS
        live_style = DOM_FindByTag(live_root, "style")
        Test_Assert(GreaterEqual(live_style, 0), "LIVE: found <style>")

        IfCondition GreaterEqual(live_style, 0) ThenBlock: {
            style_child = DOM_GetFirstChild(live_style)
            IfCondition GreaterEqual(style_child, 0) ThenBlock: {
                style_text = DOM_GetText(style_child)
                style_len = DOM_GetTextLen(style_child)
                IfCondition And(NotEqual(style_text, 0), GreaterThan(style_len, 10)) ThenBlock: {
                    PrintMessage("  CSS length: ")
                    PrintNumber(style_len)
                    PrintMessage("\n")

                    CSS_Reset()
                    live_rules = CSS_ParseSheet(style_text, style_len)
                    Test_Assert(GreaterThan(live_rules, 0), "LIVE: CSS rules parsed > 0")
                    PrintMessage("  CSS rules: ")
                    PrintNumber(live_rules)
                    PrintMessage("\n")
                }
            }
        }

        // Find <a> link
        live_a = DOM_FindByTag(live_root, "a")
        Test_Assert(GreaterEqual(live_a, 0), "LIVE: found <a>")
        IfCondition GreaterEqual(live_a, 0) ThenBlock: {
            a_href = DOM_GetAttr(live_a, "href")
            IfCondition NotEqual(a_href, 0) ThenBlock: {
                PrintMessage("  link href: ")
                PrintMessage(a_href)
                PrintMessage("\n")
                Test_Assert(NotEqual(a_href, 0), "LIVE: <a> has href")
            }
        }

        // Layout the DOM tree
        Layout_Init()
        Layout_SetViewport(1024, 700)
        cmd_count = Layout_Run(live_root)
        Test_Assert(GreaterThan(cmd_count, 0), "LIVE: layout produced commands")
        PrintMessage("  layout commands: ")
        PrintNumber(cmd_count)
        PrintMessage("  content height: ")
        PrintNumber(Layout_ContentHeight())
        PrintMessage("\n")

        // Dump layout commands for debug
        Layout_Dump()

        // ---- RENDER TEST ----
        PrintMessage("  -- Render test --\n")
        Render_Init()
        rbuf_w = 1024
        rbuf_h = 700
        rbuf_sz = Multiply(Multiply(rbuf_w, rbuf_h), 4)
        rbuf = Allocate(rbuf_sz)
        Test_Assert(NotEqual(rbuf, 0), "LIVE: render buffer allocated")

        Render_SetTarget(rbuf, rbuf_w, rbuf_h)
        Render_Clear(0xFFF0F0F2)   // light gray bg
        Render_Exec()

        // Check a pixel at where the heading should be (y=44, x=20)
        // Just verify it's not the clear color (something was drawn)
        head_off = Add(Multiply(Add(44, 8), Multiply(rbuf_w, 4)), Multiply(20, 4))
        head_px = Dereference(Add(rbuf, head_off), "dword")
        Test_Assert(NotEqual(head_px, 0xFFF0F0F2), "LIVE: heading area has drawn pixels")
        PrintMessage("  pixel at (20, 52): 0x")
        PrintNumber(head_px)
        PrintMessage("\n")

        Deallocate(rbuf, rbuf_sz)
        PrintMessage("  Render test complete\n")

        PrintMessage("\n")
        ReturnValue(0)
    }
}

// =============================================================================
// JS LEXER TESTS
// =============================================================================
Function.Test_JSLexer {
    Output: Integer
    Body: {
        PrintMessage("\n--- JSLexer Tests ---\n")
        JSLex_Init()

        // Test 1: Simple variable declaration
        tc = JSLex_Tokenize("var x = 42;", 11)
        Test_Assert(GreaterThan(tc, 0), "JSLex: tokenize var x = 42")
        // Expected tokens: KW_VAR IDENT ASSIGN NUMBER SEMI EOF
        Test_Assert(EqualTo(JSLex_GetType(0), JSTokType.KW_VAR), "JSLex: first token is KW_VAR")
        Test_Assert(EqualTo(JSLex_GetType(1), JSTokType.IDENT), "JSLex: second token is IDENT")
        Test_Assert(EqualTo(JSLex_GetType(2), JSTokType.ASSIGN), "JSLex: third token is ASSIGN")
        Test_Assert(EqualTo(JSLex_GetType(3), JSTokType.NUMBER), "JSLex: fourth token is NUMBER")
        Test_Assert(EqualTo(JSLex_GetType(4), JSTokType.SEMI), "JSLex: fifth token is SEMI")

        // Test 2: String tokens
        JSLex_Reset()
        tc2 = JSLex_Tokenize("let s = \"hello\";", 16)
        Test_Assert(GreaterThan(tc2, 0), "JSLex: tokenize let s = hello")
        Test_Assert(EqualTo(JSLex_GetType(0), JSTokType.KW_LET), "JSLex: KW_LET")
        Test_Assert(EqualTo(JSLex_GetType(3), JSTokType.STRING), "JSLex: STRING token")

        // Test 3: Operators
        JSLex_Reset()
        tc3 = JSLex_Tokenize("a === b && c !== d", 18)
        Test_Assert(GreaterThan(tc3, 0), "JSLex: tokenize operators")
        Test_Assert(EqualTo(JSLex_GetType(1), JSTokType.STRICT_EQ), "JSLex: STRICT_EQ ===")
        Test_Assert(EqualTo(JSLex_GetType(3), JSTokType.AND), "JSLex: AND &&")
        Test_Assert(EqualTo(JSLex_GetType(5), JSTokType.STRICT_NEQ), "JSLex: STRICT_NEQ !==")

        // Test 4: Function keyword
        JSLex_Reset()
        tc4 = JSLex_Tokenize("function foo(x) { return x + 1; }", 33)
        Test_Assert(GreaterThan(tc4, 0), "JSLex: tokenize function")
        Test_Assert(EqualTo(JSLex_GetType(0), JSTokType.KW_FUNCTION), "JSLex: KW_FUNCTION")
        Test_Assert(EqualTo(JSLex_GetType(1), JSTokType.IDENT), "JSLex: function name IDENT")
        Test_Assert(EqualTo(JSLex_GetType(2), JSTokType.LPAREN), "JSLex: LPAREN")
        Test_Assert(EqualTo(JSLex_GetType(4), JSTokType.RPAREN), "JSLex: RPAREN")
        Test_Assert(EqualTo(JSLex_GetType(5), JSTokType.LBRACE), "JSLex: LBRACE")

        // Test 5: Comments skipped
        JSLex_Reset()
        tc5 = JSLex_Tokenize("// comment\nvar a;", 17)
        Test_Assert(GreaterThan(tc5, 0), "JSLex: tokenize with comment")
        Test_Assert(EqualTo(JSLex_GetType(0), JSTokType.KW_VAR), "JSLex: comment skipped, first is KW_VAR")

        // Test 6: Increment/decrement
        JSLex_Reset()
        tc6 = JSLex_Tokenize("i++ + --j", 9)
        Test_Assert(GreaterThan(tc6, 0), "JSLex: tokenize ++ --")
        Test_Assert(EqualTo(JSLex_GetType(1), JSTokType.PLUS_PLUS), "JSLex: PLUS_PLUS")
        Test_Assert(EqualTo(JSLex_GetType(3), JSTokType.MINUS_MINUS), "JSLex: MINUS_MINUS")

        PrintMessage("JSLexer tests done\n")
        ReturnValue(0)
    }
}

// =============================================================================
// JS PARSER TESTS
// =============================================================================
Function.Test_JSParser {
    Output: Integer
    Body: {
        PrintMessage("=== JSParser Tests ===\n")

        JSLex_Init()
        JSParse_Init()

        PrintMessage("JSParser init done\n")

        // Test 1: Simple variable declaration — var x = 42;
        JSLex_Reset()
        tc = JSLex_Tokenize("var x = 42;", 11)
        root = JSParse_Parse()
        Test_Assert(EqualTo(JSParse_HasError(), 0), "JSParse: no error on var decl")
        Test_Assert(EqualTo(JSParse_GetType(root), ASTType.PROGRAM), "JSParse: root is PROGRAM")
        // Body is first statement
        s1 = JSParse_GetBody(root)
        Test_Assert(NotEqual(s1, -1), "JSParse: program has body")
        Test_Assert(EqualTo(JSParse_GetType(s1), ASTType.VAR_DECL), "JSParse: stmt is VAR_DECL")
        // VAR_DECL has name "x" and init expression NUMBER_LIT 42
        Test_Assert(EqualTo(JSParse_GetOp(s1), 70), "JSParse: VAR_DECL op=70 (KW_VAR)")
        init1 = JSParse_GetLeft(s1)
        Test_Assert(NotEqual(init1, -1), "JSParse: var has initializer")
        Test_Assert(EqualTo(JSParse_GetType(init1), ASTType.NUMBER_LIT), "JSParse: init is NUMBER_LIT")
        Test_Assert(EqualTo(JSParse_GetValue(init1), 42), "JSParse: number value is 42")

        // Test 2: Binary expression — 1 + 2 * 3;
        JSLex_Reset()
        JSLex_Tokenize("1 + 2 * 3;", 10)
        root2 = JSParse_Parse()
        Test_Assert(EqualTo(JSParse_HasError(), 0), "JSParse: no error on binary expr")
        s2 = JSParse_GetBody(root2)
        Test_Assert(EqualTo(JSParse_GetType(s2), ASTType.EXPR_STMT), "JSParse: expr stmt")
        expr2 = JSParse_GetLeft(s2)
        Test_Assert(EqualTo(JSParse_GetType(expr2), ASTType.BINARY_OP), "JSParse: top is BINARY_OP")
        // Should be + at top (lower prec), * in right subtree
        Test_Assert(EqualTo(JSParse_GetOp(expr2), JSTokType.PLUS), "JSParse: top op is PLUS")
        rhs = JSParse_GetRight(expr2)
        Test_Assert(EqualTo(JSParse_GetType(rhs), ASTType.BINARY_OP), "JSParse: rhs is BINARY_OP")
        Test_Assert(EqualTo(JSParse_GetOp(rhs), JSTokType.STAR), "JSParse: rhs op is STAR (prec)")

        // Test 3: Function declaration — function add(a, b) { return a + b; }
        JSLex_Reset()
        JSLex_Tokenize("function add(a, b) { return a + b; }", 36)
        root3 = JSParse_Parse()
        Test_Assert(EqualTo(JSParse_HasError(), 0), "JSParse: no error on func decl")
        s3 = JSParse_GetBody(root3)
        Test_Assert(EqualTo(JSParse_GetType(s3), ASTType.FUNC_DECL), "JSParse: stmt is FUNC_DECL")
        Test_Assert(EqualTo(JSParse_GetValue(s3), 2), "JSParse: func has 2 params")
        // Body should be a BLOCK containing RETURN_STMT
        fb = JSParse_GetBody(s3)
        Test_Assert(EqualTo(JSParse_GetType(fb), ASTType.BLOCK), "JSParse: func body is BLOCK")

        // Test 4: If-else statement
        JSLex_Reset()
        JSLex_Tokenize("if (x > 0) { y = 1; } else { y = 2; }", 38)
        root4 = JSParse_Parse()
        Test_Assert(EqualTo(JSParse_HasError(), 0), "JSParse: no error on if-else")
        s4 = JSParse_GetBody(root4)
        Test_Assert(EqualTo(JSParse_GetType(s4), ASTType.IF_STMT), "JSParse: stmt is IF_STMT")
        // Has condition, body, and alternate
        Test_Assert(NotEqual(JSParse_GetCond(s4), -1), "JSParse: if has condition")
        Test_Assert(NotEqual(JSParse_GetBody(s4), -1), "JSParse: if has body")
        Test_Assert(NotEqual(JSParse_GetRight(s4), -1), "JSParse: if has else branch")

        // Test 5: While loop
        JSLex_Reset()
        JSLex_Tokenize("while (i < 10) { i = i + 1; }", 29)
        root5 = JSParse_Parse()
        Test_Assert(EqualTo(JSParse_HasError(), 0), "JSParse: no error on while")
        s5 = JSParse_GetBody(root5)
        Test_Assert(EqualTo(JSParse_GetType(s5), ASTType.WHILE_STMT), "JSParse: stmt is WHILE_STMT")

        // Test 6: Object literal — var o = {a: 1, b: 2};
        JSLex_Reset()
        JSLex_Tokenize("var o = {a: 1, b: 2};", 21)
        root6 = JSParse_Parse()
        Test_Assert(EqualTo(JSParse_HasError(), 0), "JSParse: no error on obj literal")
        s6 = JSParse_GetBody(root6)
        Test_Assert(EqualTo(JSParse_GetType(s6), ASTType.VAR_DECL), "JSParse: var with obj init")
        objlit = JSParse_GetLeft(s6)
        Test_Assert(EqualTo(JSParse_GetType(objlit), ASTType.OBJECT_LIT), "JSParse: init is OBJECT_LIT")

        // Test 7: Array literal — var a = [1, 2, 3];
        JSLex_Reset()
        JSLex_Tokenize("var a = [1, 2, 3];", 18)
        root7 = JSParse_Parse()
        Test_Assert(EqualTo(JSParse_HasError(), 0), "JSParse: no error on array literal")
        s7 = JSParse_GetBody(root7)
        arrlit = JSParse_GetLeft(s7)
        Test_Assert(EqualTo(JSParse_GetType(arrlit), ASTType.ARRAY_LIT), "JSParse: init is ARRAY_LIT")

        // Test 8: Member access + call — obj.foo(1);
        JSLex_Reset()
        JSLex_Tokenize("obj.foo(1);", 11)
        root8 = JSParse_Parse()
        Test_Assert(EqualTo(JSParse_HasError(), 0), "JSParse: no error on member call")
        s8 = JSParse_GetBody(root8)
        call8 = JSParse_GetLeft(s8)
        Test_Assert(EqualTo(JSParse_GetType(call8), ASTType.CALL), "JSParse: expr is CALL")
        Test_Assert(EqualTo(JSParse_GetValue(call8), 1), "JSParse: call has 1 arg")

        PrintMessage("JSParser tests done\n")
        ReturnValue(0)
    }
}

SubRoutine.Main {
    Arena_Init()

    PrintMessage("Ailang Browser Engine — Test Suite\n")
    PrintMessage("==================================\n\n")

    Test_URL()
    Test_DNS()
    Test_PNG()
    Test_JPEG()
    Test_HTTP()
    Test_HTMLTokenizer()
    Test_HTMLDom()
    Test_CSSParse()
    Test_LiveHTML()
    Test_JSLexer()
    Test_JSParser()

    PrintMessage("==================================\n")
    PrintMessage("PASS: ")
    PrintNumber(TestState.pass)
    PrintMessage("  FAIL: ")
    PrintNumber(TestState.fail)
    PrintMessage("\n")

    IfCondition GreaterThan(TestState.fail, 0) ThenBlock: {
        PrintMessage("SOME TESTS FAILED\n")
        HaltProgram
    }
    PrintMessage("ALL TESTS PASSED\n")
}

RunTask(Main)
