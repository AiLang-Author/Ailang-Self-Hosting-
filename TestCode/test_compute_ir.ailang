// test_compute_ir.ailang — test Compute IR + GCN lowering
// Build: ./ailang.x TestCode/test_compute_ir.ailang test_compute_ir.x
// Run:   ./test_compute_ir.x
//
// Tests:
//   1. CIR init / begin / end lifecycle
//   2. IR op emission and dump
//   3. GCN lowering and machine code verification
//   4. Simple kernel: global_id = group_id * 64 + thread_id
//      dst[global_id] = src[global_id] + 42

LibraryImport.Accel.ComputeIR
LibraryImport.Accel.ComputeIR_GCN
LibraryImport.Drivers.AMDGPU.GCNEnc

SubRoutine.Main {
    PrintMessage("=== Compute IR Test ===\n\n")

    // --- Test 1: Init ---
    PrintMessage("--- Init ---\n")
    rc = CIR_Init()
    PrintMessage("CIR_Init: ")
    PrintNumber(rc)
    PrintMessage("\n\n")

    // --- Test 2: Build a simple kernel ---
    // Kernel: dst[global_id] = src[global_id] + 42
    // Buffer 0 = src (read), Buffer 1 = dst (write)
    // 1024 elements, 64 threads per workgroup, 16 workgroups

    PrintMessage("--- Build kernel: dst[gid] = src[gid] + 42 ---\n")
    rc = CIR_Begin()

    // Set dispatch dimensions
    rc = CIR_SetGroupSize(64, 1, 1)
    rc = CIR_SetGrid(16, 1, 1)

    // Bind buffers (dummy addresses for test)
    rc = CIR_BindBuffer(0, 0, 4096, 4, 1)
    rc = CIR_BindBuffer(1, 4096, 4096, 4, 2)

    // Allocate virtual registers
    v_gid   = CIR_AllocVReg()
    v_val   = CIR_AllocVReg()
    v_const = CIR_AllocVReg()
    v_sum   = CIR_AllocVReg()

    PrintMessage("vregs: gid=")
    PrintNumber(v_gid)
    PrintMessage(" val=")
    PrintNumber(v_val)
    PrintMessage(" const=")
    PrintNumber(v_const)
    PrintMessage(" sum=")
    PrintNumber(v_sum)
    PrintMessage("\n")

    // Emit IR program:
    //   v_gid   = GLOBAL_ID_X
    //   v_val   = LOAD_BUF(0, v_gid)
    //   WAITCNT(0, 0, 0)
    //   v_const = LOAD_CONST(42)
    //   v_sum   = ADD_U32(v_val, v_const)
    //   STORE_BUF(v_sum, 1, v_gid)
    //   WAITCNT(0, 0, 0)
    //   END_PGM

    rc = CIR_Op_GlobalIdX(v_gid)
    rc = CIR_Op_LoadBuf(v_val, 0, v_gid)
    rc = CIR_Op_WaitCnt(0, 0, 0)
    rc = CIR_Op_LoadConst(v_const, 42)
    rc = CIR_Op_AddU32(v_sum, v_val, v_const)
    rc = CIR_Op_StoreBuf(v_sum, 1, v_gid)
    rc = CIR_Op_WaitCnt(0, 0, 0)
    rc = CIR_Op_EndPgm()

    n = CIR_End()
    PrintMessage("Instructions emitted: ")
    PrintNumber(n)
    PrintMessage("\n\n")

    // --- Test 3: Dump IR ---
    PrintMessage("--- IR Dump ---\n")
    rc = CIR_Dump()
    PrintMessage("\n")

    // --- Test 4: Lower to GCN ---
    PrintMessage("--- GCN Lowering ---\n")
    mc_bytes = CIR_Lower_GCN()
    PrintMessage("Machine code bytes: ")
    PrintNumber(mc_bytes)
    PrintMessage("\n\n")

    // --- Test 5: Hex dump machine code ---
    // Read 32-bit words from MC buffer using GetByte (little-endian assembly)
    PrintMessage("--- Machine Code Hex Dump ---\n")
    i = 0
    WhileLoop LessThan(i, mc_bytes) {
        ptr = Add(CIRProg.mc_buf, i)
        b0 = GetByte(ptr, 0)
        b1 = GetByte(ptr, 1)
        b2 = GetByte(ptr, 2)
        b3 = GetByte(ptr, 3)
        w = BitwiseOr(b0, BitwiseOr(LeftShift(b1, 8), BitwiseOr(LeftShift(b2, 16), LeftShift(b3, 24))))
        PrintMessage("  +")
        PrintNumber(i)
        PrintMessage(": 0x")
        PrintHex(w)
        PrintMessage("\n")
        i = Add(i, 4)
    }
    PrintMessage("\n")

    // --- Test 6: Verify key encodings ---
    PrintMessage("--- Encoding Verification ---\n")

    // The GLOBAL_ID_X sequence should produce:
    //   S_MUL_I32 s4, s2, 64   → SOP2(op=38, sdst=4, ssrc0=2, ssrc1=255) + literal(64)
    //   V_ADD_I32 v0, s4, v0   → VOP2(op=37, vdst=0, src0=4, vsrc1=0)
    // Then LOAD_BUF → BUFFER_LOAD_DWORD ...
    // Then S_WAITCNT → 0xBF8C0000
    // Then LOAD_CONST 42 → V_MOV_B32 v2, literal(42)
    // Then ADD_U32 → V_ADD_I32 v3, v1, v2
    // Then STORE_BUF → BUFFER_STORE_DWORD ...
    // Then S_WAITCNT → 0xBF8C0000
    // Then S_ENDPGM → 0xBF810000

    // Check last word is S_ENDPGM (0xBF810000 = 3212902400)
    last_off = Subtract(mc_bytes, 4)
    ptr = Add(CIRProg.mc_buf, last_off)
    lb0 = GetByte(ptr, 0)
    lb1 = GetByte(ptr, 1)
    lb2 = GetByte(ptr, 2)
    lb3 = GetByte(ptr, 3)
    last_word = BitwiseOr(lb0, BitwiseOr(LeftShift(lb1, 8), BitwiseOr(LeftShift(lb2, 16), LeftShift(lb3, 24))))
    PrintMessage("Last word (S_ENDPGM): 0x")
    PrintHex(last_word)
    IfCondition EqualTo(last_word, 3212902400) ThenBlock: {
        PrintMessage("  PASS\n")
    }
    PrintMessage("  (expect 0xBF810000)\n")

    // Check second-to-last is S_WAITCNT 0,0,0 (0xBF8C0000 = 3213623296)
    ptr2 = Add(CIRProg.mc_buf, Subtract(mc_bytes, 8))
    wb0 = GetByte(ptr2, 0)
    wb1 = GetByte(ptr2, 1)
    wb2 = GetByte(ptr2, 2)
    wb3 = GetByte(ptr2, 3)
    w2 = BitwiseOr(wb0, BitwiseOr(LeftShift(wb1, 8), BitwiseOr(LeftShift(wb2, 16), LeftShift(wb3, 24))))
    PrintMessage("2nd-last (S_WAITCNT): 0x")
    PrintHex(w2)
    IfCondition EqualTo(w2, 3213623296) ThenBlock: {
        PrintMessage("  PASS\n")
    }
    PrintMessage("  (expect 0xBF8C0000)\n")

    PrintMessage("\n=== Compute IR Test Complete ===\n")

    // Cleanup
    rc = CIR_Shutdown()
    SystemCall(60, 0, 0, 0, 0, 0)
}

RunTask(Main)
