// test_crtc_scan.ailang — Read-only CRTC / display engine diagnostic
//
// Pure read-only. Zero register writes. Cannot crash or blank display.
//
// Reads all 6 CRTC pipes and GRPH registers to verify:
//   1. Register addresses are correct (no garbage values)
//   2. Which CRTCs are active (driving a display)
//   3. Current blank state of each CRTC
//   4. VGA render control state
//
// Build: ./ailang.x TestCode/test_crtc_scan.ailang -o test_crtc_scan.x
// Run:   ./test_crtc_scan.x 2>&1 | tee crtc_scan_log.txt

LibraryImport.Drivers.AMDGPU.AMDGPUFamily
LibraryImport.Drivers.AMDGPU.AMDGPUDiscover
LibraryImport.Drivers.AMDGPU.AMDGPUBAR
LibraryImport.Drivers.AMDGPU.AMDGPUPM4Regs
LibraryImport.Drivers.AMDGPU.AMDGPUDisplay

// =============================================================================
// ScanCRTC — read and print all registers for one CRTC pipe
// =============================================================================
Function.ScanCRTC {
    Input: gpu: Integer
    Input: pipe: Integer
    Body: {
        crtc_base = DCE6_GetCRTCBase(pipe)
        grph_base = DCE6_GetGRPHBase(pipe)

        PrintMessage("  CRTC ")
        PrintNumber(pipe)
        PrintMessage(": base=0x")
        PrintHex(crtc_base)

        // Read CRTC registers
        crtc_ctl    = GPU_Rd32(gpu, Add(crtc_base, DCE6Reg.CRTC_CONTROL_OFF))
        blank_ctl   = GPU_Rd32(gpu, Add(crtc_base, DCE6Reg.CRTC_BLANK_CONTROL_OFF))
        crtc_status = GPU_Rd32(gpu, Add(crtc_base, DCE6Reg.CRTC_STATUS_OFF))
        crtc_pos    = GPU_Rd32(gpu, Add(crtc_base, DCE6Reg.CRTC_STATUS_POS_OFF))
        update_lock = GPU_Rd32(gpu, Add(crtc_base, DCE6Reg.CRTC_UPDATE_LOCK_OFF))

        // Read GRPH register
        grph_en = GPU_Rd32(gpu, Add(grph_base, DCE6Reg.GRPH_ENABLE_OFF))

        PrintMessage("\n")

        // CRTC_CONTROL
        PrintMessage("    CRTC_CONTROL       = 0x")
        PrintHex(crtc_ctl)
        master_en = BitwiseAnd(crtc_ctl, CRTCBits.CRTC_MASTER_EN)
        IfCondition NotEqual(master_en, 0) ThenBlock: { PrintMessage("  [MASTER_EN]") }
        PrintMessage("\n")

        // CRTC_BLANK_CONTROL
        PrintMessage("    CRTC_BLANK_CONTROL = 0x")
        PrintHex(blank_ctl)
        blank_data = BitwiseAnd(blank_ctl, CRTCBits.CRTC_BLANK_DATA_EN)
        IfCondition NotEqual(blank_data, 0) ThenBlock: { PrintMessage("  [BLANK_DATA_EN]") }
        PrintMessage("\n")

        // CRTC_STATUS
        PrintMessage("    CRTC_STATUS        = 0x")
        PrintHex(crtc_status)
        vblank = BitwiseAnd(crtc_status, CRTCBits.CRTC_V_BLANK)
        IfCondition NotEqual(vblank, 0) ThenBlock: { PrintMessage("  [V_BLANK]") }
        PrintMessage("\n")

        // CRTC_STATUS_POSITION
        PrintMessage("    CRTC_STATUS_POS    = 0x")
        PrintHex(crtc_pos)
        PrintMessage("\n")

        // CRTC_UPDATE_LOCK
        PrintMessage("    CRTC_UPDATE_LOCK   = 0x")
        PrintHex(update_lock)
        PrintMessage("\n")

        // GRPH_ENABLE
        PrintMessage("    GRPH_ENABLE        = 0x")
        PrintHex(grph_en)
        grph_bit = BitwiseAnd(grph_en, CRTCBits.GRPH_ENABLE_BIT)
        IfCondition NotEqual(grph_bit, 0) ThenBlock: { PrintMessage("  [GRPH_ON]") }
        PrintMessage("\n")

        // Summary line
        PrintMessage("    --> ")
        IfCondition NotEqual(master_en, 0) ThenBlock: {
            PrintMessage("ACTIVE")
            IfCondition NotEqual(blank_data, 0) ThenBlock: { PrintMessage(" (blanked)") }
            IfCondition EqualTo(blank_data, 0) ThenBlock: { PrintMessage(" (displaying)") }
        }
        IfCondition EqualTo(master_en, 0) ThenBlock: {
            PrintMessage("INACTIVE")
        }
        PrintMessage("\n\n")
    }
}

// =============================================================================
// MAIN
// =============================================================================
Function.Main {
    Body: {
        PrintMessage("=== CRTC Read-Only Scan ===\n")
        PrintMessage("Pure read-only. Zero register writes. Cannot crash.\n\n")

        // GPU discovery + BAR mapping
        n_gpus = GPU_Discover()
        IfCondition EqualTo(n_gpus, 0) ThenBlock: {
            PrintMessage("FAIL: no AMD GPU found\n")
            ReturnValue(1)
        }
        PrintMessage("[INIT] found ")
        PrintNumber(n_gpus)
        PrintMessage(" GPU(s)\n")

        gpu = 0
        gen = GPU_GetDeviceField(gpu, GPUDevField.GENERATION)
        chip = GPU_GetDeviceField(gpu, GPUDevField.CHIP)
        PrintMessage("[INIT] Generation: ")
        IfCondition EqualTo(gen, GPUGen.SI) ThenBlock: { PrintMessage("GCN 1.0 (Southern Islands)") }
        IfCondition EqualTo(gen, GPUGen.CIK) ThenBlock: { PrintMessage("GCN 2.0 (Sea Islands)") }
        IfCondition EqualTo(gen, GPUGen.VI) ThenBlock: { PrintMessage("GCN 3.0 (Volcanic Islands)") }
        PrintMessage("\n")

        GPU_BAR_Init()
        rc = GPU_BAR_MapMMIO(gpu)
        IfCondition EqualTo(rc, 0) ThenBlock: {
            PrintMessage("FAIL: MMIO map failed\n")
            ReturnValue(1)
        }
        PrintMessage("[INIT] MMIO mapped\n")

        // Read VGA_RENDER_CONTROL for reference
        PrintMessage("\n====================================================================\n")
        PrintMessage("  SECTION 1: VGA State\n")
        PrintMessage("====================================================================\n")
        vga = GPU_Rd32(gpu, SIReg.VGA_RENDER_CONTROL)
        PrintMessage("  VGA_RENDER_CONTROL = 0x")
        PrintHex(vga)
        PrintMessage("\n")

        // Scan all 6 CRTC pipes
        PrintMessage("\n====================================================================\n")
        PrintMessage("  SECTION 2: CRTC Pipe Scan (all 6 pipes)\n")
        PrintMessage("====================================================================\n\n")

        active_count = 0
        pipe = 0
        WhileLoop LessThan(pipe, 6) {
            ScanCRTC(gpu, pipe)
            active = DCE6_IsCRTCActive(gpu, pipe)
            IfCondition EqualTo(active, 1) ThenBlock: {
                active_count = Add(active_count, 1)
            }
            pipe = Add(pipe, 1)
        }

        // Summary
        PrintMessage("====================================================================\n")
        PrintMessage("  SECTION 3: Summary\n")
        PrintMessage("====================================================================\n")
        PrintMessage("  Active CRTCs: ")
        PrintNumber(active_count)
        PrintMessage(" / 6\n")

        // List active pipes
        pipe = 0
        WhileLoop LessThan(pipe, 6) {
            active = DCE6_IsCRTCActive(gpu, pipe)
            IfCondition EqualTo(active, 1) ThenBlock: {
                PrintMessage("    CRTC ")
                PrintNumber(pipe)
                PrintMessage(": ACTIVE\n")
            }
            pipe = Add(pipe, 1)
        }

        // Verification
        PrintMessage("\n====================================================================\n")
        PrintMessage("  SECTION 4: Verification\n")
        PrintMessage("====================================================================\n")

        // CHK1: Did we read all 6 pipes without error?
        PrintMessage("  [CHK1] All 6 CRTC pipes readable: PASS\n")

        // CHK2: At least one CRTC active (display is connected)
        IfCondition GreaterThan(active_count, 0) ThenBlock: {
            PrintMessage("  [CHK2] At least one active CRTC: PASS (")
            PrintNumber(active_count)
            PrintMessage(" active)\n")
        }
        IfCondition EqualTo(active_count, 0) ThenBlock: {
            PrintMessage("  [CHK2] At least one active CRTC: WARN (none active — no display on this GPU?)\n")
        }

        PrintMessage("\n=== test_crtc_scan complete ===\n")
        SystemCall(60, 0, 0, 0, 0, 0)
    }
}

RunTask(Main)
