// test_deadlock.ailang — minimal deadlock repro
// Build:  ./ailang.x TestCode/test_deadlock.ailang test_deadlock.x
// Run:    timeout 10 ./test_deadlock.x

LibraryImport.Arena
LibraryImport.Socket
LibraryImport.HashMap
LibraryImport.XArrays
LibraryImport.StringUtils
LibraryImport.PostgreSQL_Complete

LibraryImport.Display.Render.DSurfaceTypes
LibraryImport.Display.Render.DSurface
LibraryImport.Display.Render.DDrawPixel
LibraryImport.Display.UI.Auckland
LibraryImport.Display.UI.AucklandEvent
LibraryImport.Display.Render.VIF
LibraryImport.Display.Render.SurfaceBlit
LibraryImport.Display.Render.Fonts
LibraryImport.Display.UI.TextRegion

LibraryImport.Display.Render.DRingTypes
LibraryImport.Display.Render.DRing1
LibraryImport.Display.Render.DComposeTypes
LibraryImport.Display.Render.DComposeFloat
LibraryImport.Display.Render.DCompose
LibraryImport.Display.UI.PaneDecorator
LibraryImport.Display.Window.WinManager
LibraryImport.Display.Window.WinToolbar
LibraryImport.Display.System.EventRouter
LibraryImport.Display.UI.Dialog
LibraryImport.Display.UI.FileDialog
LibraryImport.Display.Menu.Menu

Function.DebugLog_Push {
    Input: tag: Address
    Input: len: Integer
    Body: { ReturnValue(0) }
}
Function.App_CreateDocWindow { Body: { } }
Function.App_AddLine { Body: { } }
FixedPool.TestDBState { "conn": Initialize=0, CanChange=True }
Function.SysDisplay_GetDBConn { Output: Integer  Body: { ReturnValue(0) } }
FixedPool.SysDisplayState {
    "dirty":       Initialize=0, CanChange=True
    "frame_count": Initialize=0, CanChange=True
    "running":     Initialize=1, CanChange=True
}

SubRoutine.Main {
    Arena_Init()
    PrintMessage("=== Deadlock Test ===\n")

    VIF_Init()
    VFont_Init()
    TextRegion_Init()
    VFont_LoadVIF("fonts/DejaVuSans.vif")
    VFont_RasterAll(18)

    EventRouter_Init()
    Dialog_Init()
    Compose_Init(640, 480)
    WinMgr_Init()
    Menu_Init()

    // Fake desktop window (idx 0)
    d_surf = Surface_Create(SurfaceFormat.PIXEL_32, 640, 480)
    Draw_Pix_FillRect(d_surf, 0, 0, 640, 480, 0xFF1E1E3C)
    idx = Float_Add(d_surf, 0, 0, 640, 480)
    Win_SetGeom(idx, 0, 0, 640, 480)
    fptr = Float_EntryPtr(idx)
    StoreValue(Add(fptr, FloatEntryFields.SURFACE), d_surf)
    WinMgr_SetHdr(idx, -1)
    WinMgr_SetContent(idx, d_surf)
    WinMgr_SetTB(idx, -1)
    WinMgr_SetToolbarCtx(idx, 0)
    WinMgr.count = Add(WinMgr.count, 1)
    WinMgr_ZSet(0, idx)
    WinMgr.z_count = 1

    // Real window with toolbar
    win_idx = Win_Create(320, 240, 0xFF2A2A3C, "Test")
    PrintMessage("[setup] win=")
    PrintNumber(win_idx)
    PrintMessage("\n")
    Win_CreateToolbarDefault(win_idx)
    Win_SetGeom(win_idx, 50, 50, 320, 240)
    PrintMessage("[setup] done\n")

    // ===== TEST 1: Call Menu_Show directly (no prior toolbar click) =====
    PrintMessage("\n[T1] Menu_Show(0, win_idx)...\n")
    Menu_Show(0, win_idx)
    PrintMessage("[T1] returned\n")
    Menu_Close()
    PrintMessage("[T1] closed\n")

    // ===== TEST 2: Toolbar click THEN Menu_Show =====
    PrintMessage("\n[T2] toolbar click...\n")
    Win_ToolbarEvent(win_idx, 74, 38, AKMouseEv.DOWN)
    Win_ToolbarEvent(win_idx, 74, 38, AKMouseEv.UP)
    PrintMessage("[T2] click done, calling Menu_Show...\n")
    Menu_Show(0, win_idx)
    PrintMessage("[T2] returned\n")
    Menu_Close()
    PrintMessage("[T2] closed\n")

    PrintMessage("\n=== ALL PASSED ===\n")
}

RunTask(Main)
