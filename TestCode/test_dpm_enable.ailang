// test_dpm_enable.ailang — Test DPM enable following kernel's si_dpm_enable() sequence
//
// No SwitchToSwState during init. The SMC starts using the state table
// automatically when GLOBAL_PWRMGT_EN is set.
//
// Build: ./ailang.x TestCode/test_dpm_enable.ailang test_dpm_enable.x
// Run:   sg video -c "./test_dpm_enable.x"

LibraryImport.Arena
LibraryImport.Drivers.AMDGPU.AMDGPUFamily
LibraryImport.Drivers.AMDGPU.AMDGPUDiscover
LibraryImport.Drivers.AMDGPU.AMDGPUBAR
LibraryImport.Drivers.AMDGPU.AMDGPUAtomBIOS
LibraryImport.Drivers.AMDGPU.AMDGPUSMCRegs
LibraryImport.Drivers.AMDGPU.AMDGPUSMC_SI
LibraryImport.Drivers.AMDGPU.AMDGPUSMC
LibraryImport.Drivers.AMDGPU.AMDGPUPowerPlay
LibraryImport.Drivers.AMDGPU.AMDGPUVoltage
LibraryImport.Drivers.AMDGPU.AMDGPUAtomExec
LibraryImport.Drivers.AMDGPU.AMDGPUAtomExecIO
LibraryImport.Drivers.AMDGPU.AMDGPUAtomExecDecode
LibraryImport.Drivers.AMDGPU.AMDGPUAtomExecOps
LibraryImport.Drivers.AMDGPU.AMDGPUAtomExecRun
LibraryImport.Drivers.AMDGPU.AMDGPUDPM_SI
LibraryImport.Drivers.AMDGPU.AMDGPUDPM
LibraryImport.Drivers.AMDGPU.AMDGPUDisplay
LibraryImport.Drivers.AMDGPU.AMDGPUPM4Regs

SubRoutine.Main {
    PrintMessage("=== DPM Enable Test ===\n\n")

    count = GPU_Discover()
    GPU_BAR_Init()

    // Select compute GPU by PCI bus number (bus 2 = 02:00.0).
    // Display GPU is bus 1 = 01:00.0 — DO NOT MAP OR TOUCH IT.
    gpu = -1
    gi = 0
    WhileLoop LessThan(gi, count) {
        bus = GPU_GetDeviceField(gi, GPUDevField.PCI_BUS)
        IfCondition EqualTo(bus, 2) ThenBlock: {
            gpu = gi
        }
        gi = Add(gi, 1)
    }

    IfCondition LessThan(gpu, 0) ThenBlock: {
        PrintMessage("FAIL: no GPU on PCI bus 02 — refusing to touch display card.\n")
        SystemCall(60, 1, 0, 0, 0, 0)
    }

    // Only map MMIO on the compute GPU — never the display card
    GPU_BAR_MapMMIO(gpu)
    PrintMessage("Using GPU ")
    PrintNumber(gpu)
    PrintMessage(" (PCI bus 02)\n\n")

    // Load AtomBIOS + PP + Voltage
    rom = AtomBIOS_LoadROM(gpu)
    AtomBIOS_Parse(gpu)
    PP_Parse(gpu)
    Volt_Parse(gpu)

    // Read SPLL before DPM for comparison
    PrintMessage("SPLL before DPM:\n")
    PrintMessage("  CG_SPLL_FUNC_CNTL_3: 0x")
    PrintHex(GPU_Rd32(gpu, SIReg.CG_SPLL_FUNC_CNTL_3))
    PrintMessage("\n")
    PrintMessage("  GENERAL_PWRMGT:      0x")
    PrintHex(GPU_Rd32(gpu, DPMReg.GENERAL_PWRMGT))
    PrintMessage("\n")
    PrintMessage("  SCLK_PWRMGT_CNTL:    0x")
    PrintHex(GPU_Rd32(gpu, DPMReg.SCLK_PWRMGT_CNTL))
    PrintMessage("\n\n")

    // -------------------------------------------------------
    // Step 0: Initialize SPLL (before SMC sees the HW state)
    // -------------------------------------------------------
    // The SPLL is in reset/bypass at cold boot. The SMC firmware
    // reads boot HW state during init, so the PLL must be running
    // before the firmware loads. This matches the kernel sequence
    // where radeon_clocks_init() runs before si_dpm_enable().
    PrintMessage("=== Step 0: Initialize SPLL ===\n")
    spll_rc = DPM_SI_InitSPLL(gpu)
    PrintMessage("SPLL init: ")
    PrintNumber(spll_rc)
    PrintMessage("\n\n")

    // -------------------------------------------------------
    // Step 1: Load SMC firmware
    // -------------------------------------------------------
    PrintMessage("=== Step 1: Load SMC firmware ===\n")
    smc_rc = SMC_LoadFirmware(gpu)
    PrintMessage("SMC loaded: ")
    PrintNumber(smc_rc)
    PrintMessage("\n")
    IfCondition NotEqual(smc_rc, 1) ThenBlock: {
        PrintMessage("FAILED — cannot continue\n")
        SystemCall(60, 1, 0, 0, 0, 0)
    }
    PrintMessage("\n")

    // -------------------------------------------------------
    // Step 1b: SRAM write/read loopback test
    // -------------------------------------------------------
    PrintMessage("=== Step 1b: SRAM Loopback Test ===\n")

    // First: stop SMC so we have exclusive SRAM access
    PrintMessage("Stopping SMC for SRAM test...\n")
    SMC_StopSMC(gpu)

    // Raw register dump to verify indirect port is alive
    PrintMessage("IND_ACCESS_CNTL raw = 0x")
    PrintHex(GPU_Rd32(gpu, SMCReg.IND_ACCESS_CNTL))
    PrintMessage("\n")

    // Test 1: Write 0xDEADBEEF to SRAM addr 0x100 (safe scratch area), read back
    GPU_Wr32(gpu, SMCReg.IND_ACCESS_CNTL, 0)
    GPU_Wr32(gpu, SMCReg.IND_INDEX_0, 256)
    GPU_Wr32(gpu, SMCReg.IND_DATA_0, 3735928559)
    // Read back
    GPU_Wr32(gpu, SMCReg.IND_INDEX_0, 256)
    diag_val = GPU_Rd32(gpu, SMCReg.IND_DATA_0)
    PrintMessage("Write 0xDEADBEEF to 0x100, read back: 0x")
    PrintHex(diag_val)
    IfCondition EqualTo(diag_val, 3735928559) ThenBlock: { PrintMessage(" OK\n") }
    IfCondition NotEqual(diag_val, 3735928559) ThenBlock: { PrintMessage(" FAIL!\n") }

    // Test 2: Write 0x12345678 to SRAM addr 0x104, read back
    GPU_Wr32(gpu, SMCReg.IND_INDEX_0, 260)
    GPU_Wr32(gpu, SMCReg.IND_DATA_0, 305419896)
    GPU_Wr32(gpu, SMCReg.IND_INDEX_0, 260)
    diag_val = GPU_Rd32(gpu, SMCReg.IND_DATA_0)
    PrintMessage("Write 0x12345678 to 0x104, read back: 0x")
    PrintHex(diag_val)
    IfCondition EqualTo(diag_val, 305419896) ThenBlock: { PrintMessage(" OK\n") }
    IfCondition NotEqual(diag_val, 305419896) ThenBlock: { PrintMessage(" FAIL!\n") }

    // Test 3: Read IND_INDEX_0 back to verify it holds the address
    GPU_Wr32(gpu, SMCReg.IND_INDEX_0, 65552)
    idx_readback = GPU_Rd32(gpu, SMCReg.IND_INDEX_0)
    PrintMessage("IND_INDEX_0 readback after writing 0x10010: 0x")
    PrintHex(idx_readback)
    PrintMessage("\n")

    // Test 4: Read FW header with SMC stopped
    PrintMessage("\nFW header (SMC stopped):\n")
    diag_i = 0
    WhileLoop LessThan(diag_i, 16) {
        diag_addr = Add(65536, Multiply(diag_i, 4))
        GPU_Wr32(gpu, SMCReg.IND_ACCESS_CNTL, 0)
        GPU_Wr32(gpu, SMCReg.IND_INDEX_0, diag_addr)
        diag_val = GPU_Rd32(gpu, SMCReg.IND_DATA_0)
        PrintMessage("  [0x")
        PrintHex(diag_addr)
        PrintMessage("] = 0x")
        PrintHex(diag_val)
        IfCondition EqualTo(diag_i, 0) ThenBlock: { PrintMessage("  ← VERSION (expect 0x04560000)") }
        IfCondition EqualTo(diag_i, 3) ThenBlock: { PrintMessage("  ← SOFT_REGS (expect 0x0001D194)") }
        IfCondition EqualTo(diag_i, 4) ThenBlock: { PrintMessage("  ← STATE_TABLE (expect 0x0001E020)") }
        PrintMessage("\n")
        diag_i = Add(diag_i, 1)
    }

    // Restart SMC
    PrintMessage("\nRestarting SMC...\n")
    SMC_StartSMC(gpu)

    // Test 5: Read FW header with SMC running
    PrintMessage("FW header (SMC running):\n")
    diag_i = 0
    WhileLoop LessThan(diag_i, 5) {
        diag_addr = Add(65536, Multiply(diag_i, 4))
        GPU_Wr32(gpu, SMCReg.IND_ACCESS_CNTL, 0)
        GPU_Wr32(gpu, SMCReg.IND_INDEX_0, diag_addr)
        diag_val = GPU_Rd32(gpu, SMCReg.IND_DATA_0)
        PrintMessage("  [0x")
        PrintHex(diag_addr)
        PrintMessage("] = 0x")
        PrintHex(diag_val)
        PrintMessage("\n")
        diag_i = Add(diag_i, 1)
    }
    PrintMessage("\n")

    // -------------------------------------------------------
    // Step 2: Run DPM_SI_Enable (the full kernel sequence)
    // -------------------------------------------------------
    PrintMessage("=== Step 2: DPM_SI_Enable ===\n")
    dpm_rc = DPM_SI_Enable(gpu)
    PrintMessage("DPM enable result: ")
    PrintNumber(dpm_rc)
    PrintMessage("\n\n")

    // -------------------------------------------------------
    // Step 3: Verify SMC is alive and DPM is active
    // -------------------------------------------------------
    PrintMessage("=== Step 3: Verification ===\n")

    // Check SMC alive
    GPU_Wr32(gpu, SMCReg.RESP_0, 0)
    resp = SMC_SendMessage(gpu, SMCMsg.TEST)
    PrintMessage("SMC TEST: 0x")
    PrintHex(resp)
    PrintMessage(" (expect 0x1)\n")

    // Check register states
    PrintMessage("GENERAL_PWRMGT:   0x")
    PrintHex(GPU_Rd32(gpu, DPMReg.GENERAL_PWRMGT))
    PrintMessage("\n")
    PrintMessage("SCLK_PWRMGT_CNTL: 0x")
    PrintHex(GPU_Rd32(gpu, DPMReg.SCLK_PWRMGT_CNTL))
    PrintMessage("\n")

    // Read SPLL after DPM
    PrintMessage("CG_SPLL_FUNC_CNTL_3: 0x")
    PrintHex(GPU_Rd32(gpu, SIReg.CG_SPLL_FUNC_CNTL_3))
    PrintMessage("\n")

    // Read state table from SRAM to verify it was written correctly
    state_tbl_addr = SMC_ReadSRAM(gpu, Add(65536, SMCFWHdr.STATE_TABLE))
    PrintMessage("\nState table SRAM addr: 0x")
    PrintHex(state_tbl_addr)
    PrintMessage("\n")

    // Verify header
    hdr = SMC_ReadSRAM(gpu, state_tbl_addr)
    PrintMessage("Header DWORD: 0x")
    PrintHex(hdr)
    PrintMessage("\n")

    // Verify driverState at correct offset (+640 = 0x280)
    drv_hdr = SMC_ReadSRAM(gpu, Add(state_tbl_addr, 640))
    PrintMessage("driverState header at +0x280: 0x")
    PrintHex(drv_hdr)
    PrintMessage("\n")

    // Verify initialState header at +184 = 0xB8
    init_hdr = SMC_ReadSRAM(gpu, Add(state_tbl_addr, 184))
    PrintMessage("initialState header at +0xB8: 0x")
    PrintHex(init_hdr)
    PrintMessage("\n")

    // Verify MC ARB DRAM timing entries in SRAM are populated
    PrintMessage("\n--- MC ARB Timing Entries (SRAM) ---\n")
    arb_tbl_a = SMC_ReadSRAM(gpu, Add(65536, SMCFWHdr.MC_ARB_TABLE))
    PrintMessage("MC ARB table addr: 0x")
    PrintHex(arb_tbl_a)
    PrintMessage("\n")
    PrintMessage("ARB header: 0x")
    PrintHex(SMC_ReadSRAM(gpu, arb_tbl_a))
    PrintMessage(" (expect arb_current=0x0B in top byte)\n")
    // Check entries 0-4: data[i] at offset 4 + i*12
    arb_ci = 0
    WhileLoop LessThan(arb_ci, 5) {
        arb_e_base = Add(arb_tbl_a, Add(4, Multiply(arb_ci, 12)))
        arb_dt1 = SMC_ReadSRAM(gpu, arb_e_base)
        arb_dt2 = SMC_ReadSRAM(gpu, Add(arb_e_base, 4))
        arb_dt3 = SMC_ReadSRAM(gpu, Add(arb_e_base, 8))
        PrintMessage("  entry[")
        PrintNumber(arb_ci)
        PrintMessage("]: dram=0x")
        PrintHex(arb_dt1)
        PrintMessage(" dram2=0x")
        PrintHex(arb_dt2)
        PrintMessage(" burst=0x")
        PrintHex(arb_dt3)
        IfCondition EqualTo(arb_dt1, 0) ThenBlock: {
            PrintMessage(" ** ZERO!")
        }
        PrintMessage("\n")
        arb_ci = Add(arb_ci, 1)
    }
    // HW register comparison
    PrintMessage("HW MC_ARB_DRAM_TIMING:   0x")
    PrintHex(GPU_Rd32(gpu, DPMReg.MC_ARB_DRAM_TIMING))
    PrintMessage("\nHW MC_ARB_DRAM_TIMING_1: 0x")
    PrintHex(GPU_Rd32(gpu, DPMReg.MC_ARB_DRAM_TIMING_1))
    PrintMessage("\n")

    // Read the TARGET_AND_CURRENT_PROFILE_INDEX register
    // This shows what DPM level the SMC is currently using
    tgt_prof = GPU_Rd32(gpu, DPMReg.TARGET_AND_CURRENT_PROFILE_INDEX)
    PrintMessage("\nTARGET_AND_CURRENT_PROFILE_INDEX: 0x")
    PrintHex(tgt_prof)
    PrintMessage("\n")

    // Print DPM info
    DPM_SI_PrintInfo(gpu)

    // -------------------------------------------------------
    // Step 3b: Dump SPLL registers for each level in SRAM
    // -------------------------------------------------------
    PrintMessage("\n=== Step 3b: SPLL register dump per DPM level ===\n")

    // First dump initialState level SPLL (at +0xB8+4 = +188, SCLK starts at +16 within level)
    init_level_addr = Add(state_tbl_addr, Add(188, 16))
    PrintMessage("initialState SPLL:\n")
    PrintMessage("  FUNC_CNTL:   0x")
    PrintHex(SMC_ReadSRAM(gpu, init_level_addr))
    PrintMessage("\n  FUNC_CNTL_2: 0x")
    PrintHex(SMC_ReadSRAM(gpu, Add(init_level_addr, 4)))
    PrintMessage("\n  FUNC_CNTL_3: 0x")
    PrintHex(SMC_ReadSRAM(gpu, Add(init_level_addr, 8)))
    PrintMessage("\n  FUNC_CNTL_4: 0x")
    PrintHex(SMC_ReadSRAM(gpu, Add(init_level_addr, 12)))
    PrintMessage("\n  SS:          0x")
    PrintHex(SMC_ReadSRAM(gpu, Add(init_level_addr, 16)))
    PrintMessage("\n  SS_2:        0x")
    PrintHex(SMC_ReadSRAM(gpu, Add(init_level_addr, 20)))
    PrintMessage("\n  SCLK_VALUE:  0x")
    PrintHex(SMC_ReadSRAM(gpu, Add(init_level_addr, 24)))
    PrintMessage("\n")

    // Now dump driverState levels (at +0x280+4 = +644, each level is 148 bytes)
    drv_level_base = Add(state_tbl_addr, 644)
    dpm_e = DPM_SI_GetEntry(gpu)
    nlvl_dump = Dereference(Add(dpm_e, DPMField.NUM_LEVELS))
    lvl_i = 0
    WhileLoop LessThan(lvl_i, nlvl_dump) {
        lvl_addr = Add(drv_level_base, Multiply(lvl_i, 148))
        sclk_addr = Add(lvl_addr, 16)
        PrintMessage("\ndriverState Level ")
        PrintNumber(lvl_i)
        PrintMessage(" SPLL:\n")
        PrintMessage("  FUNC_CNTL:   0x")
        PrintHex(SMC_ReadSRAM(gpu, sclk_addr))
        PrintMessage("\n  FUNC_CNTL_2: 0x")
        PrintHex(SMC_ReadSRAM(gpu, Add(sclk_addr, 4)))
        PrintMessage("\n  FUNC_CNTL_3: 0x")
        PrintHex(SMC_ReadSRAM(gpu, Add(sclk_addr, 8)))
        PrintMessage("\n  FUNC_CNTL_4: 0x")
        PrintHex(SMC_ReadSRAM(gpu, Add(sclk_addr, 12)))
        PrintMessage("\n  SS:          0x")
        PrintHex(SMC_ReadSRAM(gpu, Add(sclk_addr, 16)))
        PrintMessage("\n  SS_2:        0x")
        PrintHex(SMC_ReadSRAM(gpu, Add(sclk_addr, 20)))
        PrintMessage("\n  SCLK_VALUE:  0x")
        PrintHex(SMC_ReadSRAM(gpu, Add(sclk_addr, 24)))
        PrintMessage("\n")
        // Also dump VDDC and AC_INDEX
        PrintMessage("  VDDC:        0x")
        PrintHex(SMC_ReadSRAM(gpu, Add(lvl_addr, 84)))
        PrintMessage("\n  first_dw:    0x")
        PrintHex(SMC_ReadSRAM(gpu, lvl_addr))
        PrintMessage("\n")

        lvl_i = Add(lvl_i, 1)
    }

    // Also dump the hardware SPLL registers for comparison
    PrintMessage("\nCurrent HW SPLL registers:\n")
    PrintMessage("  FUNC_CNTL:   0x")
    PrintHex(GPU_Rd32(gpu, SIReg.CG_SPLL_FUNC_CNTL))
    PrintMessage("\n  FUNC_CNTL_2: 0x")
    PrintHex(GPU_Rd32(gpu, SIReg.CG_SPLL_FUNC_CNTL_2))
    PrintMessage("\n  FUNC_CNTL_3: 0x")
    PrintHex(GPU_Rd32(gpu, SIReg.CG_SPLL_FUNC_CNTL_3))
    PrintMessage("\n  FUNC_CNTL_4: 0x")
    PrintHex(GPU_Rd32(gpu, SIReg.CG_SPLL_FUNC_CNTL_4))
    PrintMessage("\n  SS:          0x")
    PrintHex(GPU_Rd32(gpu, SIReg.CG_SPLL_SPREAD_SPECTRUM))
    PrintMessage("\n  SS_2:        0x")
    PrintHex(GPU_Rd32(gpu, SIReg.CG_SPLL_SPREAD_SPECTRUM_2))
    PrintMessage("\n")

    // -------------------------------------------------------
    // Step 4: Try runtime state switch (SwitchToSwState)
    // -------------------------------------------------------
    PrintMessage("\n=== Step 4: Runtime state switch ===\n")
    PrintMessage("Attempting SwitchToSwState (runtime transition)...\n")

    // Follow kernel's si_dpm_set_power_state() sequence:
    // 1. NoForcedLevel
    // 2. SetEnabledLevels(1) — restrict to 1 level first
    // 3. Halt
    // 4. Upload new driverState (already uploaded during init)
    // 5. FlushDataCache + Resume
    // 6. SwitchToSwState

    GPU_Wr32(gpu, SMCReg.RESP_0, 0)
    resp = SMC_SendMessage(gpu, SMCMsg.NO_FORCED_LEVEL)
    PrintMessage("  NoForcedLevel: 0x")
    PrintHex(resp)
    PrintMessage("\n")

    GPU_Wr32(gpu, SMCReg.RESP_0, 0)
    resp = SMC_SendMessageArg(gpu, SMCMsg.SET_ENABLED_LEVELS, 1)
    PrintMessage("  SetEnabledLevels(1): 0x")
    PrintHex(resp)
    PrintMessage("\n")

    GPU_Wr32(gpu, SMCReg.RESP_0, 0)
    resp = SMC_SendMessage(gpu, SMCMsg.HALT)
    PrintMessage("  Halt: 0x")
    PrintHex(resp)
    PrintMessage("\n")
    SMC_WaitInactive(gpu)

    GPU_Wr32(gpu, SMCReg.RESP_0, 0)
    resp = SMC_SendMessage(gpu, SMCMsg.FLUSH_DATA_CACHE)
    PrintMessage("  FlushDataCache: 0x")
    PrintHex(resp)
    PrintMessage("\n")

    GPU_Wr32(gpu, SMCReg.RESP_0, 0)
    resp = SMC_SendMessage(gpu, SMCMsg.RESUME)
    PrintMessage("  Resume: 0x")
    PrintHex(resp)
    PrintMessage("\n")

    GPU_Wr32(gpu, SMCReg.RESP_0, 0)
    resp = SMC_SendMessage(gpu, SMCMsg.SWITCH_TO_SWSTATE)
    PrintMessage("  SwitchToSwState: 0x")
    PrintHex(resp)
    PrintMessage("\n")

    IfCondition EqualTo(resp, SMCResp.OK) ThenBlock: {
        PrintMessage("SUCCESS — SwitchToSwState accepted!\n")

        // Check profile index after switch
        tgt_prof = GPU_Rd32(gpu, DPMReg.TARGET_AND_CURRENT_PROFILE_INDEX)
        PrintMessage("TARGET_AND_CURRENT_PROFILE_INDEX: 0x")
        PrintHex(tgt_prof)
        PrintMessage("\n")

        // Read current SPLL to see actual clock
        PrintMessage("SPLL_FUNC_CNTL_3 after switch: 0x")
        PrintHex(GPU_Rd32(gpu, SIReg.CG_SPLL_FUNC_CNTL_3))
        PrintMessage("\n")

        // -------------------------------------------------------
        // Step 5: Diagnostics + Level forcing
        // -------------------------------------------------------
        dpm_e = DPM_SI_GetEntry(gpu)
        nlvl = Dereference(Add(dpm_e, DPMField.NUM_LEVELS))

        PrintMessage("\n=== Step 5: Diagnostics ===\n")

        // Read SPLL_CNTL_MODE to check if PLL is in SW or HW control
        PrintMessage("SPLL_CNTL_MODE (0x618): 0x")
        PrintHex(GPU_Rd32(gpu, 1560))
        PrintMessage("  (bit0=SW_DIR_CONTROL)\n")

        // Verify lowSMIO was written correctly in SRAM
        state_tbl_addr2 = SMC_ReadSRAM(gpu, Add(65536, SMCFWHdr.STATE_TABLE))
        PrintMessage("lowSMIO[0]: 0x")
        PrintHex(SMC_ReadSRAM(gpu, Add(state_tbl_addr2, 4)))
        PrintMessage("\nlowSMIO[1]: 0x")
        PrintHex(SMC_ReadSRAM(gpu, Add(state_tbl_addr2, 8)))
        PrintMessage("\nlowSMIO[2]: 0x")
        PrintHex(SMC_ReadSRAM(gpu, Add(state_tbl_addr2, 12)))
        PrintMessage("\nlowSMIO[3]: 0x")
        PrintHex(SMC_ReadSRAM(gpu, Add(state_tbl_addr2, 16)))
        PrintMessage("\nvoltageMask VDDC: 0x")
        PrintHex(SMC_ReadSRAM(gpu, Add(state_tbl_addr2, 132)))
        PrintMessage("\nvoltageMask MVDD: 0x")
        PrintHex(SMC_ReadSRAM(gpu, Add(state_tbl_addr2, 136)))
        PrintMessage("\nvoltageMask VDDCI: 0x")
        PrintHex(SMC_ReadSRAM(gpu, Add(state_tbl_addr2, 140)))
        PrintMessage("\n")

        // Verify arbRefreshState in each level
        drv_level_base2 = Add(state_tbl_addr2, 644)
        li2 = 0
        WhileLoop LessThan(li2, nlvl) {
            lvl_a2 = Add(drv_level_base2, Multiply(li2, 148))
            arb_dw = SMC_ReadSRAM(gpu, Add(lvl_a2, 100))
            PrintMessage("Level ")
            PrintNumber(li2)
            PrintMessage(" arbRefresh DWORD @+100: 0x")
            PrintHex(arb_dw)
            PrintMessage("  (arbRefreshState=")
            PrintNumber(BitwiseAnd(arb_dw, 255))
            PrintMessage(")\n")

            li2 = Add(li2, 1)
        }

        // CG_DISPLAY_GAP_CNTL (0x828)
        PrintMessage("CG_DISPLAY_GAP_CNTL: 0x")
        PrintHex(GPU_Rd32(gpu, 2088))
        PrintMessage("\n")

        // CG_FTV (0x7BC) — voltage controller timing
        PrintMessage("CG_FTV: 0x")
        PrintHex(GPU_Rd32(gpu, 1980))
        PrintMessage("\n")

        // CG_THERMAL_CTRL (0x700) — DPM_EVENT_SRC bits [2:0]
        PrintMessage("CG_THERMAL_CTRL: 0x")
        PrintHex(GPU_Rd32(gpu, DPMReg.CG_THERMAL_CTRL))
        PrintMessage("  (DPM_EVENT_SRC=")
        PrintNumber(BitwiseAnd(GPU_Rd32(gpu, DPMReg.CG_THERMAL_CTRL), 7))
        PrintMessage(", expect 2=DIGITAL)\n")

        // --- Read SPLL div table entries for diagnostic ---
        PrintMessage("\n=== Step 5b: SPLL Div Table Check ===\n")
        spll_tbl_addr = SMC_ReadSRAM(gpu, Add(65536, SMCFWHdr.SPLL_TABLE))
        PrintMessage("SPLL div table addr: 0x")
        PrintHex(spll_tbl_addr)
        PrintMessage("\n")

        // Read entries at indices relevant to our SCLK values
        // Level 0: 300MHz = 30000 in 10kHz, index = 30000/512 = 58 (covers 296.96 MHz)
        // Level 1: 400MHz = 40000 in 10kHz, index = 40000/512 = 78 (covers 399.36 MHz)
        // Also check index 59 (301.568 MHz) to see nearby values
        spll_idx = 58
        WhileLoop LessEqual(spll_idx, 78) {
            spll_freq = SMC_ReadSRAM(gpu, Add(spll_tbl_addr, Multiply(spll_idx, 4)))
            // Only print relevant entries: 58, 59, 77, 78
            IfCondition LessEqual(spll_idx, 59) ThenBlock: {
                PrintMessage("  freq[")
                PrintNumber(spll_idx)
                PrintMessage("] = 0x")
                PrintHex(spll_freq)
                PrintMessage("  (sclk=")
                PrintNumber(Multiply(spll_idx, 512))
                PrintMessage(" x10kHz = ")
                PrintNumber(Divide(Multiply(spll_idx, 5120), 1000))
                PrintMessage("MHz  fb=0x")
                PrintHex(BitwiseAnd(spll_freq, 33554431))
                PrintMessage(" pd=")
                PrintNumber(RightShift(spll_freq, 25))
                PrintMessage(")\n")
            }
            IfCondition GreaterEqual(spll_idx, 77) ThenBlock: {
                PrintMessage("  freq[")
                PrintNumber(spll_idx)
                PrintMessage("] = 0x")
                PrintHex(spll_freq)
                PrintMessage("  (sclk=")
                PrintNumber(Multiply(spll_idx, 512))
                PrintMessage(" x10kHz = ")
                PrintNumber(Divide(Multiply(spll_idx, 5120), 1000))
                PrintMessage("MHz  fb=0x")
                PrintHex(BitwiseAnd(spll_freq, 33554431))
                PrintMessage(" pd=")
                PrintNumber(RightShift(spll_freq, 25))
                PrintMessage(")\n")
            }
            spll_idx = Add(spll_idx, 1)
        }
        // Also read the SS entries at the same indices (at offset +1024)
        PrintMessage("  ss[58] = 0x")
        PrintHex(SMC_ReadSRAM(gpu, Add(spll_tbl_addr, Add(1024, Multiply(58, 4)))))
        PrintMessage("\n  ss[78] = 0x")
        PrintHex(SMC_ReadSRAM(gpu, Add(spll_tbl_addr, Add(1024, Multiply(78, 4)))))
        PrintMessage("\n")

        // Compare SCLK_VALUE in level vs expected div table index
        PrintMessage("\nLevel SCLK_VALUE → div table index alignment:\n")
        l_i = 0
        WhileLoop LessThan(l_i, nlvl) {
            l_addr = Add(drv_level_base2, Multiply(l_i, 148))
            l_sclk = SMC_ReadSRAM(gpu, Add(l_addr, 40))
            l_idx = Divide(l_sclk, 512)
            l_rem = Modulo(l_sclk, 512)
            PrintMessage("  Level ")
            PrintNumber(l_i)
            PrintMessage(": SCLK_VALUE=")
            PrintNumber(l_sclk)
            PrintMessage(" → idx=")
            PrintNumber(l_idx)
            PrintMessage(" remainder=")
            PrintNumber(l_rem)
            IfCondition NotEqual(l_rem, 0) ThenBlock: {
                PrintMessage("  ** NOT ALIGNED!")
            }
            PrintMessage("\n")
            l_i = Add(l_i, 1)
        }

        IfCondition GreaterThan(nlvl, 1) ThenBlock: {
            PrintMessage("\n=== Step 6: Level Forcing ===\n")

            // --- First try SetForcedLevels(0) — force to CURRENT level (no PLL change) ---
            PrintMessage("--- Force to Level 0 (no PLL change) ---\n")
            GPU_Wr32(gpu, SMCReg.RESP_0, 0)
            resp = SMC_SendMessageArg(gpu, SMCMsg.SET_ENABLED_LEVELS, nlvl)
            PrintMessage("SetEnabledLevels(")
            PrintNumber(nlvl)
            PrintMessage("): 0x")
            PrintHex(resp)
            PrintMessage("\n")

            // SetForcedLevels(0) = don't skip any levels from bottom = use level 0
            // This should NOT require any PLL transition since we're already at level 0
            GPU_Wr32(gpu, SMCReg.RESP_0, 0)
            resp = SMC_SendMessageArg(gpu, SMCMsg.SET_FORCED_LEVELS, 0)
            PrintMessage("SetForcedLevels(0): 0x")
            PrintHex(resp)
            PrintMessage("\n")
            PrintMessage("  TARGET_PROFILE after: 0x")
            PrintHex(GPU_Rd32(gpu, DPMReg.TARGET_AND_CURRENT_PROFILE_INDEX))
            PrintMessage("\n")

            // Restore
            GPU_Wr32(gpu, SMCReg.RESP_0, 0)
            SMC_SendMessage(gpu, SMCMsg.NO_FORCED_LEVEL)

            // --- Step through each level using kernel's approach ---
            // Kernel uses SetEnabledLevels(N) + SetForcedLevels(skip)
            // SetForcedLevels(skip) forces the minimum level to (skip),
            // effectively forcing the GPU to level (skip) when combined
            // with SetEnabledLevels(skip+1).
            force_i = 1
            WhileLoop LessThan(force_i, nlvl) {
                PrintMessage("\n--- Force to Level ")
                PrintNumber(force_i)
                PrintMessage(" ---\n")

                // Enable all levels up to this one
                GPU_Wr32(gpu, SMCReg.RESP_0, 0)
                resp = SMC_SendMessageArg(gpu, SMCMsg.SET_ENABLED_LEVELS, nlvl)
                PrintMessage("  SetEnabledLevels(")
                PrintNumber(nlvl)
                PrintMessage("): 0x")
                PrintHex(resp)
                PrintMessage("\n")

                // Force: skip (force_i) levels from bottom
                GPU_Wr32(gpu, SMCReg.RESP_0, 0)
                resp = SMC_SendMessageArg(gpu, SMCMsg.SET_FORCED_LEVELS, force_i)
                PrintMessage("  SetForcedLevels(")
                PrintNumber(force_i)
                PrintMessage("): 0x")
                PrintHex(resp)
                PrintMessage("\n")

                // Wait for transition
                delay = 0
                WhileLoop LessThan(delay, 500000) { delay = Add(delay, 1) }

                PrintMessage("  SPLL_FUNC_CNTL_3: 0x")
                PrintHex(GPU_Rd32(gpu, SIReg.CG_SPLL_FUNC_CNTL_3))
                PrintMessage("\n  SPLL_STATUS:      0x")
                PrintHex(GPU_Rd32(gpu, SIReg.SPLL_STATUS))
                PrintMessage("\n  TARGET_PROFILE:   0x")
                PrintHex(GPU_Rd32(gpu, DPMReg.TARGET_AND_CURRENT_PROFILE_INDEX))
                PrintMessage("\n")

                force_i = Add(force_i, 1)
            }

            // --- Restore AUTO ---
            GPU_Wr32(gpu, SMCReg.RESP_0, 0)
            SMC_SendMessage(gpu, SMCMsg.NO_FORCED_LEVEL)
            GPU_Wr32(gpu, SMCReg.RESP_0, 0)
            SMC_SendMessageArg(gpu, SMCMsg.SET_FORCED_LEVELS, 0)
            PrintMessage("Restored AUTO mode\n")
        }
    }
    ElseBlock: {
        PrintMessage("SwitchToSwState FAILED (0x")
        PrintHex(resp)
        PrintMessage(")\n")

        // Check if SMC still alive
        GPU_Wr32(gpu, SMCReg.RESP_0, 0)
        resp2 = SMC_SendMessage(gpu, SMCMsg.NO_DISPLAY)
        PrintMessage("SMC alive after failure: 0x")
        PrintHex(resp2)
        PrintMessage("\n")
    }

    // -------------------------------------------------------
    // Cleanup
    // -------------------------------------------------------
    PrintMessage("\n=== Cleanup ===\n")
    DPM_SI_Disable(gpu)

    GPU_BAR_Unmap(gpu)

    PrintMessage("\n=== DPM Enable Test Complete ===\n")
    SystemCall(60, 0, 0, 0, 0, 0)
}

RunTask(Main)
