// test_gcn_enc.ailang — test GCN 1.0 instruction encoder
// Build: ./ailang.x TestCode/test_gcn_enc.ailang test_gcn_enc.x
// Run:   ./test_gcn_enc.x

LibraryImport.Drivers.AMDGPU.GCNEnc

SubRoutine.Main {
    PrintMessage("=== GCN 1.0 Encoder Test ===\n\n")

    // --- Test O(1) instruction lookup via FixedPool.GCN ---
    PrintMessage("--- Instruction Lookup (O(1) FixedPool) ---\n")

    desc = GCN.S_ADD_U32
    PrintMessage("S_ADD_U32:       desc=")
    PrintNumber(desc)
    PrintMessage(" op=0x")
    PrintHex(GCNEnc_Opcode(desc))
    PrintMessage(" enc=")
    PrintNumber(GCNEnc_EncFmt(desc))
    PrintMessage(" grp=")
    PrintNumber(GCNEnc_Group(desc))
    PrintMessage("\n")

    desc = GCN.V_MUL_LO_U32
    PrintMessage("V_MUL_LO_U32:   desc=")
    PrintNumber(desc)
    PrintMessage(" op=0x")
    PrintHex(GCNEnc_Opcode(desc))
    PrintMessage(" enc=")
    PrintNumber(GCNEnc_EncFmt(desc))
    PrintMessage(" 64bit=")
    PrintNumber(GCNEnc_Is64Bit(desc))
    PrintMessage("\n")

    desc = GCN.S_ENDPGM
    PrintMessage("S_ENDPGM:       desc=")
    PrintNumber(desc)
    PrintMessage(" op=0x")
    PrintHex(GCNEnc_Opcode(desc))
    PrintMessage(" enc=")
    PrintNumber(GCNEnc_EncFmt(desc))
    PrintMessage("\n")

    desc = GCN.BUFFER_LOAD_DWORD
    PrintMessage("BUF_LOAD_DWORD: desc=")
    PrintNumber(desc)
    PrintMessage(" op=0x")
    PrintHex(GCNEnc_Opcode(desc))
    PrintMessage(" enc=")
    PrintNumber(GCNEnc_EncFmt(desc))
    PrintMessage("\n")

    desc = GCN.DS_READ_B32
    PrintMessage("DS_READ_B32:    desc=")
    PrintNumber(desc)
    PrintMessage(" op=0x")
    PrintHex(GCNEnc_Opcode(desc))
    PrintMessage(" enc=")
    PrintNumber(GCNEnc_EncFmt(desc))
    PrintMessage("\n")

    desc = GCN.V_MUL_HI_U32
    PrintMessage("V_MUL_HI_U32:   op=0x")
    PrintHex(GCNEnc_Opcode(desc))
    PrintMessage(" enc=")
    PrintNumber(GCNEnc_EncFmt(desc))
    PrintMessage("\n\n")

    // --- Test register lookup ---
    PrintMessage("--- Register Lookup ---\n")
    PrintMessage("s0:     ")
    PrintNumber(GCNEnc_RegNum("s0"))
    PrintMessage("\n")
    PrintMessage("s10:    ")
    PrintNumber(GCNEnc_RegNum("s10"))
    PrintMessage("\n")
    PrintMessage("v0:     ")
    PrintNumber(GCNEnc_RegNum("v0"))
    PrintMessage("\n")
    PrintMessage("v255:   ")
    PrintNumber(GCNEnc_RegNum("v255"))
    PrintMessage("\n")
    PrintMessage("vcc_lo: ")
    PrintNumber(GCNEnc_RegNum("vcc_lo"))
    PrintMessage("\n")
    PrintMessage("exec:   ")
    PrintNumber(GCNEnc_RegNum("exec"))
    PrintMessage("\n")
    PrintMessage("m0:     ")
    PrintNumber(GCNEnc_RegNum("m0"))
    PrintMessage("\n\n")

    // --- Test instruction encoding ---
    PrintMessage("--- Instruction Encoding ---\n")

    // SOP2: S_ADD_U32 s0, s1, s2
    // Expected: [31:30]=10 [29:23]=0 [22:16]=0 [15:8]=2 [7:0]=1
    // = 0x80000201
    GCNEnc_Emit_SOP2(0, 0, 1, 2)
    PrintMessage("S_ADD_U32 s0,s1,s2: 0x")
    PrintHex(GCNEncState.word0)
    PrintMessage("  (expect 0x80000201)\n")

    // SOP1: S_MOV_B32 s5, s10
    // op=3, sdst=5, ssrc0=10
    // = 0xBE85030A
    GCNEnc_Emit_S_MOV_B32(5, 10)
    PrintMessage("S_MOV_B32 s5,s10:   0x")
    PrintHex(GCNEncState.word0)
    PrintMessage("  (expect 0xBE85030A)\n")

    // SOPP: S_ENDPGM
    // = 0xBF810000
    GCNEnc_Emit_S_ENDPGM()
    PrintMessage("S_ENDPGM:           0x")
    PrintHex(GCNEncState.word0)
    PrintMessage("  (expect 0xBF810000)\n")

    // SOPP: S_BARRIER
    // = 0xBF8A0000
    GCNEnc_Emit_S_BARRIER()
    PrintMessage("S_BARRIER:          0x")
    PrintHex(GCNEncState.word0)
    PrintMessage("  (expect 0xBF8A0000)\n")

    // SOPP: S_WAITCNT vmcnt=0, expcnt=0, lgkmcnt=0
    // = 0xBF8C0000
    GCNEnc_Emit_S_WAITCNT(0, 0, 0)
    PrintMessage("S_WAITCNT(0,0,0):   0x")
    PrintHex(GCNEncState.word0)
    PrintMessage("  (expect 0xBF8C0000)\n")

    // VOP1: V_MOV_B32 v0, v1
    // src0 for v1 = 256+1 = 257
    // = 0x7E000301
    GCNEnc_Emit_V_MOV_B32(0, 257)
    PrintMessage("V_MOV_B32 v0,v1:    0x")
    PrintHex(GCNEncState.word0)
    PrintMessage("  (expect 0x7E000301)\n")

    // VOP2: V_ADD_F32 v0, v1, v2
    // = 0x06000501
    GCNEnc_Emit_VOP2(3, 0, 257, 2)
    PrintMessage("V_ADD_F32 v0,v1,v2: 0x")
    PrintHex(GCNEncState.word0)
    PrintMessage("  (expect 0x06000501)\n")

    // VOP3: V_MUL_LO_U32 v0, v1, v2
    // op=0x169, vdst=0, src0=v1=257, src1=v2=258, src2=0, mods=0
    // word0: 0 | (0x169<<17) | (0x34<<26) = 0xD2D20000
    // word1: 257 | (258<<9) | (0<<18) = 0x00020501
    // NEW: 6 args — mods=0 (no clamp, no abs, no neg, no omod)
    GCNEnc_Emit_VOP3(361, 0, 257, 258, 0, 0)
    PrintMessage("V_MUL_LO_U32:      w0=0x")
    PrintHex(GCNEncState.word0)
    PrintMessage(" w1=0x")
    PrintHex(GCNEncState.word1)
    PrintMessage("\n")
    PrintMessage("  (expect w0=0xD2D20000 w1=0x00020501)\n")

    // VOP3 with modifiers: V_MUL_LO_U32 v0, v1, v2, clamp=1
    // mods = clamp(1) | abs(0<<1) | neg(0<<4) | omod(0<<7) = 1
    // word0 should have CLAMP bit [11] set: 0xD2D20800
    GCNEnc_Emit_VOP3(361, 0, 257, 258, 0, 1)
    PrintMessage("V_MUL w/ clamp:     w0=0x")
    PrintHex(GCNEncState.word0)
    PrintMessage(" w1=0x")
    PrintHex(GCNEncState.word1)
    PrintMessage("\n")
    PrintMessage("  (expect w0=0xD2D20800 w1=0x00020501)\n")

    PrintMessage("\n=== GCN Encoder Test Complete ===\n")
    SystemCall(60, 0, 0, 0, 0, 0)
}

RunTask(Main)
