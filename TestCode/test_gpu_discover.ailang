// test_gpu_discover.ailang — test AMD GPU PCI discovery
// Build: ./ailang.x TestCode/test_gpu_discover.ailang test_gpu_discover.x
// Run:   ./test_gpu_discover.x

LibraryImport.Arena
LibraryImport.Drivers.AMDGPU.AMDGPUFamily
LibraryImport.Drivers.AMDGPU.AMDGPUDiscover

SubRoutine.Main {
    PrintMessage("=== AMD GPU Discovery Test ===\n\n")

    count = GPU_Discover()

    PrintMessage("\n")
    IfCondition EqualTo(count, 0) ThenBlock: {
        PrintMessage("No AMD GPUs found.\n")
        SystemCall(60, 1, 0, 0, 0, 0)
    }

    PrintMessage("--- Detailed GPU Info ---\n")
    GPU_PrintAll()

    PrintMessage("\n--- Field Access Test ---\n")
    i = 0
    WhileLoop LessThan(i, count) {
        gen = GPU_GetDeviceField(i, GPUDevField.GENERATION)
        isa = GPU_GetDeviceField(i, GPUDevField.ISA)
        cus = GPU_GetDeviceField(i, GPUDevField.MAX_CUS)

        PrintMessage("GPU ")
        PrintNumber(i)
        PrintMessage(": gen=")
        PrintNumber(gen)
        PrintMessage(" isa=")
        PrintNumber(isa)
        PrintMessage(" cus=")
        PrintNumber(cus)
        PrintMessage(" SPs=")
        PrintNumber(Multiply(cus, 64))
        PrintMessage("\n")

        i = Add(i, 1)
    }

    PrintMessage("\n=== Test Complete ===\n")
    SystemCall(60, 0, 0, 0, 0, 0)
}

RunTask(Main)
