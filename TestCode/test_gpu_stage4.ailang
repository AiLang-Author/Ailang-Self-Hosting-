// test_gpu_stage4.ailang — ISOLATION TEST: DPM init (power/clock management)
// Build: ./ailang.x TestCode/test_gpu_stage4.ailang test_gpu_stage4.x
// Run:   sudo ./test_gpu_stage4.x
//
// Tests (adds to Stage 3):
//   1. Everything from stage 3 (discover, BAR, halt, reset, FW, rings)
//   2. AtomBIOS_LoadROM + AtomBIOS_Parse
//   3. PP_Parse + Volt_Parse
//   4. DPM_SI_InitSPLL
//   5. SMC_LoadFirmware
//   6. DPM_Init + DPM_Enable
//   7. Force HIGH clock level
//
// NO shader upload, NO compute dispatch.
// If this locks up: DPM/SMC interaction crashes the GPU.
// If this works: full init is fine, the problem is in compute dispatch (stage 5).

LibraryImport.Arena
LibraryImport.Drivers.AMDGPU.AMDGPUFamily
LibraryImport.Drivers.AMDGPU.AMDGPUDiscover
LibraryImport.Drivers.AMDGPU.AMDGPUBAR
LibraryImport.Drivers.AMDGPU.AMDGPUAtomBIOS
LibraryImport.Drivers.AMDGPU.AMDGPUPowerPlay
LibraryImport.Drivers.AMDGPU.AMDGPUVoltage
LibraryImport.Drivers.AMDGPU.AMDGPUSMCRegs
LibraryImport.Drivers.AMDGPU.AMDGPUSMC_SI
LibraryImport.Drivers.AMDGPU.AMDGPUSMC
LibraryImport.Drivers.AMDGPU.AMDGPUAtomExec
LibraryImport.Drivers.AMDGPU.AMDGPUAtomExecIO
LibraryImport.Drivers.AMDGPU.AMDGPUAtomExecDecode
LibraryImport.Drivers.AMDGPU.AMDGPUAtomExecOps
LibraryImport.Drivers.AMDGPU.AMDGPUAtomExecRun
LibraryImport.Drivers.AMDGPU.AMDGPUPM4
LibraryImport.Drivers.AMDGPU.AMDGPUPM4Regs
LibraryImport.Accel.HAL
LibraryImport.Drivers.AMDGPU.AMDGPUDPM_SI
LibraryImport.Drivers.AMDGPU.AMDGPUDPM
LibraryImport.Accel.AccelGCN

SubRoutine.Main {
    PrintMessage("=== GPU STAGE 4: DPM Init ===\n\n")

    // --- Discover + BAR map ---
    n_gpus = GPU_Discover()
    IfCondition EqualTo(n_gpus, 0) ThenBlock: {
        PrintMessage("[S4] FAIL: No AMD GPUs found\n")
        SystemCall(60, 1, 0, 0, 0, 0)
    }

    // Select compute GPU (PCI bus 2) — never touch display GPU (bus 1)
    gpu = -1
    gi = 0
    WhileLoop LessThan(gi, n_gpus) {
        bus = GPU_GetDeviceField(gi, GPUDevField.PCI_BUS)
        IfCondition EqualTo(bus, 2) ThenBlock: {
            gpu = gi
        }
        gi = Add(gi, 1)
    }
    IfCondition LessThan(gpu, 0) ThenBlock: {
        PrintMessage("[S4] FAIL: no GPU on PCI bus 02\n")
        SystemCall(60, 1, 0, 0, 0, 0)
    }

    GPU_BAR_Init()
    rc = GPU_BAR_MapMMIO(gpu)
    IfCondition EqualTo(rc, 0) ThenBlock: {
        PrintMessage("[S4] FAIL: MMIO map failed\n")
        SystemCall(60, 1, 0, 0, 0, 0)
    }
    rc = GPU_BAR_MapVRAM(gpu)
    IfCondition EqualTo(rc, 0) ThenBlock: {
        PrintMessage("[S4] FAIL: VRAM map failed\n")
        SystemCall(60, 1, 0, 0, 0, 0)
    }
    PrintMessage("[S4] BARs mapped OK\n")

    // --- SPLL init (engine clocks must run before GRBM-domain writes) ---
    PrintMessage("[S4] Loading AtomBIOS + initializing SPLL...\n")
    rom = AtomBIOS_LoadROM(gpu)
    IfCondition EqualTo(rom, 0) ThenBlock: {
        PrintMessage("[S4] FAIL: AtomBIOS ROM load failed\n")
        SystemCall(60, 1, 0, 0, 0, 0)
    }
    AtomBIOS_Parse(gpu)
    PP_Parse(gpu)
    Volt_Parse(gpu)
    spll_rc = DPM_SI_InitSPLL(gpu)
    IfCondition EqualTo(spll_rc, 0) ThenBlock: {
        PrintMessage("[S4] FAIL: SPLL init failed\n")
        SystemCall(60, 1, 0, 0, 0, 0)
    }
    PrintMessage("[S4] SPLL initialized\n")

    // --- CP halt + reset + FW load ---
    PM4_HaltCP(gpu)
    PM4_InitMCBase(gpu)
    PM4_SoftResetCP(gpu)
    PM4_HaltCP(gpu)
    rc = PM4_LoadCPFirmware(gpu)
    IfCondition LessThan(rc, 0) ThenBlock: {
        PrintMessage("[S4] FAIL: CP firmware\n")
        SystemCall(60, 1, 0, 0, 0, 0)
    }
    rc = PM4_LoadRLCFirmware(gpu)
    IfCondition LessThan(rc, 0) ThenBlock: {
        PrintMessage("[S4] FAIL: RLC firmware\n")
        SystemCall(60, 1, 0, 0, 0, 0)
    }
    rc = PM4_SetupIHRing(gpu)
    IfCondition LessThan(rc, 0) ThenBlock: {
        PrintMessage("[S4] FAIL: IH ring\n")
        SystemCall(60, 1, 0, 0, 0, 0)
    }
    GPU_Wr32(gpu, SIReg.CP_SEM_WAIT_TIMER, 0)
    GPU_Wr32(gpu, SIReg.CP_SEM_INCOMPLETE_TIMER, 0)
    GPU_Wr32(gpu, SIReg.CP_RB_WPTR_DELAY, 0)
    GPU_Wr32(gpu, SIReg.CP_DEBUG, 0)
    PrintMessage("[S4] FW loaded OK\n")

    // --- Ring setup + CP start + ring test ---
    rc = PM4_SetupRing(gpu, 0, RingConf.VRAM_RING_OFFSET)
    IfCondition EqualTo(rc, 0) ThenBlock: {
        PrintMessage("[S4] FAIL: ring 0 setup\n")
        SystemCall(60, 1, 0, 0, 0, 0)
    }
    GPU_Wr32(gpu, SIReg.CP_MAX_CONTEXT, 7)
    GPU_Wr32(gpu, SIReg.CP_ENDIAN_SWAP, 0)
    GPU_Wr32(gpu, SIReg.CP_DEVICE_ID, 1)
    rc = PM4_CPStart(gpu, 0)
    IfCondition EqualTo(rc, 0) ThenBlock: {
        PrintMessage("[S4] FAIL: CP start\n")
        SystemCall(60, 1, 0, 0, 0, 0)
    }
    rc = PM4_RingTest(0)
    IfCondition EqualTo(rc, 0) ThenBlock: {
        PrintMessage("[S4] FAIL: ring 0 test\n")
        SystemCall(60, 1, 0, 0, 0, 0)
    }

    rc = PM4_SetupRing(gpu, 1, AccelGCNLayout.RING1_OFFSET)
    IfCondition EqualTo(rc, 0) ThenBlock: {
        PrintMessage("[S4] FAIL: ring 1 setup\n")
        SystemCall(60, 1, 0, 0, 0, 0)
    }
    rc = PM4_RingTest(1)
    IfCondition EqualTo(rc, 0) ThenBlock: {
        PrintMessage("[S4] FAIL: ring 1 test\n")
        SystemCall(60, 1, 0, 0, 0, 0)
    }

    rc = PM4_SetupRing(gpu, 2, AccelGCNLayout.RING2_OFFSET)
    IfCondition EqualTo(rc, 0) ThenBlock: {
        PrintMessage("[S4] FAIL: ring 2 setup\n")
        SystemCall(60, 1, 0, 0, 0, 0)
    }
    rc = PM4_RingTest(2)
    IfCondition EqualTo(rc, 0) ThenBlock: {
        PrintMessage("[S4] FAIL: ring 2 test\n")
        SystemCall(60, 1, 0, 0, 0, 0)
    }

    GPU_Wr32(gpu, SIReg.SCRATCH_UMSK, 255)
    GPU_Wr32(gpu, SIReg.SCRATCH_REG0, 0)
    PrintMessage("[S4] All 3 rings tested OK\n")

    // === NEW IN STAGE 4: SMC + DPM (AtomBIOS/PP/Volt/SPLL already done above) ===

    PrintMessage("\n[S4] === DPM INIT ===\n")

    // SMC firmware
    PrintMessage("[S4] Loading SMC firmware...\n")
    smc_rc = SMC_LoadFirmware(gpu)
    PrintMessage("[S4] SMC result: ")
    PrintNumber(smc_rc)
    PrintMessage("\n")
    IfCondition EqualTo(smc_rc, 0) ThenBlock: {
        PrintMessage("[S4] WARNING: SMC firmware load failed, skipping DPM enable\n")
    }
    ElseBlock: {
        PrintMessage("[S4] Initializing DPM...\n")
        DPM_Init()
        PrintMessage("[S4] Enabling DPM...\n")
        dpm_rc = DPM_Enable(gpu)
        PrintMessage("[S4] DPM enable result: ")
        PrintNumber(dpm_rc)
        PrintMessage("\n")
        IfCondition EqualTo(dpm_rc, 1) ThenBlock: {
            DPM_SI_UploadDriverState(gpu)
            dpm = DPM_SI_GetEntry(gpu)
            num_levels = Dereference(Add(dpm, DPMField.NUM_LEVELS))
            DPM_SetLevel(gpu, Subtract(num_levels, 1))
            PrintMessage("[S4] DPM forced HIGH (")
            PrintNumber(num_levels)
            PrintMessage(" levels)\n")
        }
        ElseBlock: {
            PrintMessage("[S4] DPM enable failed, continuing at boot clocks\n")
        }
    }

    // --- Final status ---
    PrintMessage("\n[S4] GRBM_STATUS = 0x")
    PrintHex(GPU_Rd32(gpu, SIReg.GRBM_STATUS))
    PrintMessage("\n")

    // --- Cleanup ---
    PrintMessage("[S4] Disabling DPM...\n")
    DPM_Disable(gpu)
    DPM_Shutdown(gpu)
    PrintMessage("[S4] Halting CP...\n")
    PM4_HaltCP(gpu)
    GPU_BAR_Unmap(gpu)

    PrintMessage("\n=== STAGE 4 PASS ===\n")
    SystemCall(60, 0, 0, 0, 0, 0)
}

RunTask(Main)
