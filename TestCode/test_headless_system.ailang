LibraryImport.Display.Render.DRingTypes
LibraryImport.Display.Render.DRing1
LibraryImport.Display.Render.DComposeTypes
LibraryImport.Display.Render.DComposeFloat
LibraryImport.Display.Render.DCompose
LibraryImport.Display.UI.PaneDecorator
LibraryImport.Display.Window.WinManager
LibraryImport.Display.IPC.IPCBroker
LibraryImport.Display.Window.WinToolbar
LibraryImport.Arrays
LibraryImport.Display.Content.PageSurface
LibraryImport.Display.Content.Document
LibraryImport.Display.System.EventRouter
LibraryImport.Display.Input.CursorBitmap
LibraryImport.Display.Menu.Deskbar
LibraryImport.Display.UI.Dialog
LibraryImport.Display.UI.AboutDialog
LibraryImport.Display.UI.FileDialog
LibraryImport.Display.Menu.Menu
LibraryImport.Display.Menu.StartMenu
LibraryImport.Display.Menu.CascadeMenu
LibraryImport.Display.System.Screenshot
LibraryImport.Display.Theme.UIConfig
LibraryImport.Display.Theme.UITheme
LibraryImport.Display.Theme.UIScale
LibraryImport.JSON
LibraryImport.Display.Render.VIcon
LibraryImport.Display.Input.Cursor
LibraryImport.PostgreSQL_Complete

// ─── Stubs for hardware that doesn't exist headless ────────────────────────

// Stub: no real framebuffer device
Function.RenderFB_InitDouble {
    Output: Integer
    Body: {
        ReturnValue(1)
    }
}

// Stub: no evdev input devices
Function.Evdev_Poll {
    Body: { ReturnValue(0) }
}

// Stub: no TTY mode switching
Function.SysDisplay_InitTTY {
    Body: { ReturnValue(0) }
}

// Stub: no input device discovery
Function.SysDisplay_InitInput {
    Body: { ReturnValue(0) }
}

// ─── Fake framebuffer setup ────────────────────────────────────────────────
// Mimics what FB_Init + FB_InitDouble does, but with mmap'd anonymous memory.
Function.FakeFB_Init {
    Input: w: Integer
    Input: h: Integer
    Body: {
        bpp  = 32
        pitch = Multiply(w, 4)
        size = Multiply(pitch, h)

        // mmap anonymous: mmap(0, size, PROT_READ|PROT_WRITE, MAP_PRIVATE|MAP_ANONYMOUS, -1, 0)
        // PROT_READ=1, PROT_WRITE=2 => 3
        // MAP_PRIVATE=2, MAP_ANONYMOUS=32 => 34
        fb_ptr = SystemCall(9, 0, size, 3, 34, -1, 0)
        back_buf = SystemCall(9, 0, size, 3, 34, -1, 0)

        FB.fd = -1
        FB.fb_ptr = fb_ptr
        FB.back_buffer = back_buf
        FB.width = w
        FB.height = h
        FB.bpp = bpp
        FB.pitch = pitch
        FB.size = size
        FB.initialized = 1
        FB.double_buffered = 1

        // Zero out back buffer
        MemorySet(back_buf, 0, size)

        PrintMessage("[FakeFB] ")
        PrintNumber(w)
        PrintMessage("x")
        PrintNumber(h)
        PrintMessage(" pitch=")
        PrintNumber(pitch)
        PrintMessage(" size=")
        PrintNumber(size)
        PrintMessage("\n")
        ReturnValue(1)
    }
}

// ─── Stub App functions that Main.ailang defines ───────────────────────────
FixedPool.AppState {
    "doc":         Initialize=-1, CanChange=True
    "line_count":  Initialize=0, CanChange=True
    "win_idx":     Initialize=-1, CanChange=True
    "fb_win_idx":  Initialize=-1, CanChange=True
    "fb_doc":      Initialize=-1, CanChange=True
}

Function.App_CreateDocWindow {
    Output: Integer
    Body: {
        win_w = 620
        win_h = 500
        win_idx = Win_Create(win_w, win_h, WinColor.WINDOW, "Notepad")
        IfCondition LessThan(win_idx, 0) ThenBlock: {
            PrintMessage("[App] Win_Create failed\n")
            ReturnValue(-1)
        }
        AppState.win_idx = win_idx
        Win_CreateToolbarDefault(win_idx)
        WinMgr_SetTB(win_idx, -1)

        content = WinMgr_GetContent(win_idx)
        IfCondition LessEqual(content, 0) ThenBlock: {
            PrintMessage("[App] no content surface\n")
            ReturnValue(-1)
        }

        doc = Doc_Create(PaperType.LETTER, PageOrient.PORTRAIT, 96)
        IfCondition LessThan(doc, 0) ThenBlock: {
            PrintMessage("[App] Doc_Create failed\n")
            ReturnValue(-1)
        }
        AppState.doc = doc

        page0_auto = Doc_GetPage(doc, 0)
        IfCondition GreaterEqual(page0_auto, 0) ThenBlock: {
            PageSurface_Destroy(page0_auto)
        }

        cw = Win_GetCanvasW(win_idx)
        ch = Win_GetCanvasH(win_idx)
        page = PageSurface_CreateFree(cw, ch, 96)
        IfCondition LessThan(page, 0) ThenBlock: {
            PrintMessage("[App] page create failed\n")
            ReturnValue(-1)
        }
        PageSurface_SetMarginsPixels(page, 16, 16, 16, 16)

        pages = Doc_Get(doc, DocField.PAGE_LIST)
        Array.Set(pages, 0, page)

        // Write a few lines of text
        VFont_FlushCache()
        VFont_RasterAll(16)
        title_clr = TVG_PackColor(0, 80, 180, 255)
        body_clr = TVG_PackColor(30, 30, 30, 255)
        Doc_WriteText(doc, "Headless Test", 13, title_clr)
        Doc_WriteText(doc, "Line two", 8, body_clr)
        Doc_WriteText(doc, "Line three", 10, body_clr)
        VFont_FlushCache()
        VFont_RasterAll(18)

        // Blit page to window content
        src_surf = PageSurface_GetSurface(page)
        IfCondition NotEqual(src_surf, 0) ThenBlock: {
            src_data = Surface_GetData(src_surf)
            src_pitch = Surface_GetPitch(src_surf)
            dst_data = Surface_GetData(content)
            dst_pitch = Surface_GetPitch(content)
            blit_w = cw
            blit_h = ch
            row_bytes = Multiply(blit_w, 4)
            by = 0
            WhileLoop LessThan(by, blit_h) {
                src_row = Add(src_data, Multiply(by, src_pitch))
                dst_row = Add(dst_data, Multiply(by, dst_pitch))
                bx = 0
                WhileLoop LessThan(bx, row_bytes) {
                    SetByte(dst_row, bx, GetByte(src_row, bx))
                    bx = Add(bx, 1)
                }
                by = Add(by, 1)
            }
        }

        SysDisplayState.dirty = 1
        PrintMessage("[App] document window created\n")
        ReturnValue(win_idx)
    }
}

Function.App_AddLine {
    Output: Integer
    Body: { ReturnValue(0) }
}

// ─── PPM dump for debugging ────────────────────────────────────────────────
Function.DumpFBtoPPM {
    Input: path: Address
    Body: {
        w = FB.width
        h = FB.height
        pitch = FB.pitch
        data = FB.back_buffer

        fd = SystemCall(2, path, 577, 420)
        IfCondition LessThan(fd, 0) ThenBlock: {
            PrintMessage("[PPM] cannot open file\n")
            ReturnValue(0)
        }

        hdr = "P6\n"
        SystemCall(1, fd, hdr, 3)
        w_str = NumberToString(w)
        SystemCall(1, fd, w_str, StringLength(w_str))
        SystemCall(1, fd, " ", 1)
        h_str = NumberToString(h)
        SystemCall(1, fd, h_str, StringLength(h_str))
        SystemCall(1, fd, "\n255\n", 5)

        rgb_row = Allocate(Multiply(w, 3))
        y = 0
        WhileLoop LessThan(y, h) {
            row_ptr = Add(data, Multiply(y, pitch))
            x = 0
            WhileLoop LessThan(x, w) {
                src_off = Multiply(x, 4)
                dst_off = Multiply(x, 3)
                b_val = GetByte(row_ptr, src_off)
                g_val = GetByte(row_ptr, Add(src_off, 1))
                r_val = GetByte(row_ptr, Add(src_off, 2))
                SetByte(rgb_row, dst_off, r_val)
                SetByte(rgb_row, Add(dst_off, 1), g_val)
                SetByte(rgb_row, Add(dst_off, 2), b_val)
                x = Add(x, 1)
            }
            SystemCall(1, fd, rgb_row, Multiply(w, 3))
            y = Add(y, 1)
        }
        Deallocate(rgb_row, Multiply(w, 3))
        SystemCall(3, fd, 0, 0)
        PrintMessage("[PPM] wrote ")
        PrintString(path)
        PrintMessage("\n")
    }
}

// ─── MAIN ──────────────────────────────────────────────────────────────────
SubRoutine.Main {
    Arena_Init()

    PrintMessage("[STEP 1] FakeFB init\n")
    FakeFB_Init(1920, 1080)

    PrintMessage("[STEP 2] UIConfig + Theme + Scale\n")
    UIConfig_Load("config/ui.cfg")
    UITheme_Init()
    UIScale_Init(1920, 1080)
    PaneDecorator_ScaleInit()
    PaneDecorator_ThemeInit()

    bw = UIScale.border_w
    WinDefaults.w = Subtract(Divide(Multiply(1920, 80), 100), Multiply(bw, 2))
    WinDefaults.h = Subtract(Divide(Multiply(1080, 80), 100), Multiply(bw, 2))

    PrintMessage("[STEP 3] Compose + WinMgr init\n")
    Compose_Init(1920, 1080)
    WinMgr_Init()

    PrintMessage("[STEP 4] Font init\n")
    FB_FontInit()
    VIF_Init()
    VFont_Init()
    TextRegion_Init()
    VFont_LoadVIF("fonts/DejaVuSans.vif")

    // Load Alteix if available
    alt_face = VFont_LoadFace("fonts/AlteixSans.vif")
    PrintMessage("  Alteix face=")
    PrintNumber(alt_face)
    PrintMessage("\n")

    // Icon system
    VIcon_Init()
    VIcon_LoadVIF(IconTier.WIDGETS, "icons/silver_atoms.vif")

    PrintMessage("[STEP 5] Cursor init\n")
    CursorConfig.type      = CursorType.BITMAP
    CursorConfig.shape     = CursorShape.ARROW
    CursorConfig.hotspot_x = 0
    CursorConfig.hotspot_y = 0
    Cursor_Init(1920, 1080)

    PrintMessage("[STEP 6] DebugLog init\n")
    DebugLog_Init()

    PrintMessage("[STEP 7] EventRouter + Dialog + Menu + Deskbar\n")
    EventRouter_Init()
    Dialog_Init()
    Menu_Init()
    Deskbar_Init(1920, 1080)
    HTML_Init()
    PageSurface_Init()
    Doc_Init()

    PrintMessage("[STEP 8] Desktop surface (idx 0)\n")
    d_surf = Surface_Create(SurfaceFormat.PIXEL_32, 1920, 1080)
    SysDisplayState.desktop_surf = d_surf
    Draw_Pix_FillRect(d_surf, 0, 0, 1920, 1080, WinColor.DESKTOP)
    idx = Float_Add(d_surf, 0, 0, 1920, 1080)
    Win_SetGeom(idx, 0, 0, 1920, 1080)
    fptr = Float_EntryPtr(idx)
    StoreValue(Add(fptr, FloatEntryFields.SURFACE), d_surf)
    WinMgr_SetHdr(idx, -1)
    WinMgr_SetContent(idx, d_surf)
    WinMgr_SetTB(idx, -1)

    // Desktop text
    VFont_RasterAll(UIScale.font_title)
    tr_title = TextRegion_Create(d_surf, 20, 20, 760, 40)
    TextRegion_SetColor(tr_title, TVG_PackColor(255, 255, 255, 255))
    TextRegion_SetWrap(tr_title, 0)
    TextRegion_Render(tr_title, "AILANG Display Server", 21)

    tr_help = TextRegion_Create(d_surf, 20, 60, 760, 80)
    TextRegion_SetColor(tr_help, TVG_PackColor(180, 200, 220, 255))
    TextRegion_SetWrap(tr_help, 1)
    TextRegion_Render(tr_help, "Headless test mode", 18)

    // Icon rendering on desktop
    IfCondition EqualTo(VIconState.initialized, 1) ThenBlock: {
        VIcon_SetSize(32)
        icon_close = VIcon_Resolve("close_btn_normal")
        IfCondition NotEqual(icon_close, 0) ThenBlock: {
            Surface_BlitAlpha(d_surf, icon_close, 20, 120)
        }
    }

    WinMgr.count = Add(WinMgr.count, 1)
    WinMgr_ZSet(0, idx)
    WinMgr.z_count = 1
    Win_Focus(idx)

    PrintMessage("[STEP 9] First Win_BlitAll (desktop only)\n")
    SysDisplayState.dirty = 1
    Win_BlitAll()
    PrintMessage("[STEP 9] PASS\n")

    PrintMessage("[STEP 10] Create doc window\n")
    VFont_FlushCache()
    VFont_RasterAll(16)
    App_CreateDocWindow()

    PrintMessage("[STEP 11] Win_BlitAll with window\n")
    VFont_FlushCache()
    VFont_RasterAll(18)
    Win_BlitAll()
    PrintMessage("[STEP 11] PASS\n")

    PrintMessage("[STEP 12] Win_DrawTabBar via Win_RenderDirty\n")
    SysDisplayState.dirty = 1
    Win_RenderDirty()
    PrintMessage("[STEP 12] PASS\n")

    PrintMessage("[STEP 13] Win_BlitAll after render\n")
    Win_BlitAll()
    PrintMessage("[STEP 13] PASS\n")

    PrintMessage("[STEP 14] Show deskbar + blit\n")
    DeskbarState.visible = 1
    Deskbar_Refresh()
    Win_BlitAll()
    PrintMessage("[STEP 14] PASS\n")

    PrintMessage("[STEP 15] Second window\n")
    win2 = Win_Create(400, 300, WinColor.WINDOW, "Second")
    IfCondition GreaterEqual(win2, 0) ThenBlock: {
        Win_CreateToolbarDefault(win2)
        WinMgr_SetTB(win2, -1)
        PrintMessage("  win2 idx=")
        PrintNumber(win2)
        PrintMessage("\n")
    }

    PrintMessage("[STEP 16] Win_BlitAll with 2 windows + deskbar\n")
    SysDisplayState.dirty = 1
    Win_BlitAll()
    PrintMessage("[STEP 16] PASS\n")

    PrintMessage("[STEP 17] 10 frame cycles (exact main-loop sequence)\n")
    frame = 0
    WhileLoop LessThan(frame, 10) {
        // Replicate SysDisplay_Run frame body exactly:
        // Evdev_Poll (stubbed), DrainInput skipped,
        // Win_RenderDirty, EventRouter_Drain, Deskbar_Refresh,
        // DebugLog_Render, Win_BlitAll
        Win_RenderDirty()
        EventRouter_Drain()
        IfCondition EqualTo(DeskbarState.needs_refresh, 1) ThenBlock: {
            Deskbar_Refresh()
            SysDisplayState.dirty = 1
        }
        DebugLog_Render()
        IfCondition EqualTo(SysDisplayState.dirty, 1) ThenBlock: {
            Win_BlitAll()
            SysDisplayState.dirty = 0
        }
        frame = Add(frame, 1)
    }
    PrintMessage("[STEP 17] PASS — 10 frames OK\n")

    // ── STEP 18: Focus switching ──
    PrintMessage("[STEP 18] Focus win1 -> win2 -> win1\n")
    Win_Focus(AppState.win_idx)
    SysDisplayState.dirty = 1
    Win_BlitAll()
    Win_Focus(win2)
    SysDisplayState.dirty = 1
    Win_BlitAll()
    Win_Focus(AppState.win_idx)
    SysDisplayState.dirty = 1
    Win_BlitAll()
    PrintMessage("[STEP 18] PASS\n")

    // ── STEP 19: Deskbar refresh triggered by window activity ──
    PrintMessage("[STEP 19] Deskbar needs_refresh cycle\n")
    DeskbarState.needs_refresh = 1
    DeskbarState.visible = 1
    Deskbar_Refresh()
    SysDisplayState.dirty = 1
    Win_BlitAll()
    PrintMessage("[STEP 19] PASS\n")

    // ── STEP 20: Third window ──
    PrintMessage("[STEP 20] Third window\n")
    win3 = Win_Create(500, 350, WinColor.WINDOW, "Third")
    IfCondition GreaterEqual(win3, 0) ThenBlock: {
        Win_CreateToolbarDefault(win3)
        WinMgr_SetTB(win3, -1)
        PrintMessage("  win3 idx=")
        PrintNumber(win3)
        PrintMessage("\n")
    }
    DeskbarState.needs_refresh = 1
    Deskbar_Refresh()
    SysDisplayState.dirty = 1
    Win_BlitAll()
    PrintMessage("[STEP 20] PASS\n")

    // ── STEP 21: 3-window frame cycles with deskbar visible ──
    PrintMessage("[STEP 21] 20 frames, 3 windows + deskbar\n")
    frame = 0
    WhileLoop LessThan(frame, 20) {
        Win_RenderDirty()
        EventRouter_Drain()
        IfCondition EqualTo(DeskbarState.needs_refresh, 1) ThenBlock: {
            Deskbar_Refresh()
            SysDisplayState.dirty = 1
        }
        DebugLog_Render()
        SysDisplayState.dirty = 1
        Win_BlitAll()
        SysDisplayState.dirty = 0
        frame = Add(frame, 1)
    }
    PrintMessage("[STEP 21] PASS — 20 frames OK\n")

    // ── STEP 22: Menu open + blit + close + blit ──
    PrintMessage("[STEP 22] Menu open/close cycle\n")
    Menu_Show(100, 100, 1)
    SysDisplayState.dirty = 1
    Win_BlitAll()
    Menu_Close()
    SysDisplayState.dirty = 1
    Win_BlitAll()
    PrintMessage("[STEP 22] PASS\n")

    // ── STEP 23: Close third window ──
    PrintMessage("[STEP 23] Close third window\n")
    IfCondition GreaterEqual(win3, 0) ThenBlock: {
        Win_Close(win3)
        DeskbarState.needs_refresh = 1
        Deskbar_Refresh()
        SysDisplayState.dirty = 1
        Win_BlitAll()
    }
    PrintMessage("[STEP 23] PASS\n")

    // ── STEP 24: File dialog open + blit + close ──
    PrintMessage("[STEP 24] File dialog open/close\n")
    fd_slot = FileDialog_Open(0, 0, 14)
    IfCondition GreaterEqual(fd_slot, 0) ThenBlock: {
        PrintMessage("  fd slot=")
        PrintNumber(fd_slot)
        PrintMessage("\n")
        SysDisplayState.dirty = 1
        Win_BlitAll()
        FD_CloseDialog()
        SysDisplayState.dirty = 1
        Win_BlitAll()
    } ElseBlock: {
        PrintMessage("  [SKIP] FileDialog_Open returned ")
        PrintNumber(fd_slot)
        PrintMessage("\n")
    }
    PrintMessage("[STEP 24] PASS\n")

    // ── STEP 25: Focus cycling rapid fire ──
    PrintMessage("[STEP 25] Rapid focus cycling (20x)\n")
    fc = 0
    WhileLoop LessThan(fc, 20) {
        Win_Focus(AppState.win_idx)
        Win_Focus(win2)
        SysDisplayState.dirty = 1
        Win_BlitAll()
        fc = Add(fc, 1)
    }
    PrintMessage("[STEP 25] PASS\n")

    // ── STEP 26: Deskbar hide/show cycling ──
    PrintMessage("[STEP 26] Deskbar hide/show cycle (10x)\n")
    dc = 0
    WhileLoop LessThan(dc, 10) {
        DeskbarState.visible = 1
        DeskbarState.needs_refresh = 1
        Deskbar_Refresh()
        SysDisplayState.dirty = 1
        Win_BlitAll()
        DeskbarState.visible = 0
        SysDisplayState.dirty = 1
        Win_BlitAll()
        dc = Add(dc, 1)
    }
    PrintMessage("[STEP 26] PASS\n")

    // ── STEP 27: 50 full main-loop frames ──
    PrintMessage("[STEP 27] 50 full main-loop frames\n")
    frame = 0
    WhileLoop LessThan(frame, 50) {
        Win_RenderDirty()
        EventRouter_Drain()
        IfCondition EqualTo(DeskbarState.needs_refresh, 1) ThenBlock: {
            Deskbar_Refresh()
            SysDisplayState.dirty = 1
        }
        DebugLog_Render()
        SysDisplayState.dirty = 1
        Win_BlitAll()
        SysDisplayState.dirty = 0
        frame = Add(frame, 1)
    }
    PrintMessage("[STEP 27] PASS — 50 frames OK\n")

    // ── STEP 28: Create 4th, 5th, 6th windows (stress test) ──
    PrintMessage("[STEP 28] Create windows 4, 5, 6\n")
    win4 = Win_Create(300, 250, WinColor.WINDOW, "Win4")
    IfCondition GreaterEqual(win4, 0) ThenBlock: {
        Win_CreateToolbarDefault(win4)
        WinMgr_SetTB(win4, -1)
    }
    win5 = Win_Create(350, 280, WinColor.WINDOW, "Win5")
    IfCondition GreaterEqual(win5, 0) ThenBlock: {
        Win_CreateToolbarDefault(win5)
        WinMgr_SetTB(win5, -1)
    }
    win6 = Win_Create(280, 220, WinColor.WINDOW, "Win6")
    IfCondition GreaterEqual(win6, 0) ThenBlock: {
        Win_CreateToolbarDefault(win6)
        WinMgr_SetTB(win6, -1)
    }
    DeskbarState.needs_refresh = 1
    DeskbarState.visible = 1
    Deskbar_Refresh()
    SysDisplayState.dirty = 1
    Win_BlitAll()
    PrintMessage("[STEP 28] PASS\n")

    // ── STEP 29: 20 frames with 5 windows + deskbar ──
    PrintMessage("[STEP 29] 20 frames, 5 windows + deskbar\n")
    frame = 0
    WhileLoop LessThan(frame, 20) {
        SysDisplayState.dirty = 1
        Win_BlitAll()
        frame = Add(frame, 1)
    }
    PrintMessage("[STEP 29] PASS\n")

    // ── STEP 30: Close all extra windows ──
    PrintMessage("[STEP 30] Close windows 4, 5, 6\n")
    IfCondition GreaterEqual(win6, 0) ThenBlock: { Win_Close(win6) }
    IfCondition GreaterEqual(win5, 0) ThenBlock: { Win_Close(win5) }
    IfCondition GreaterEqual(win4, 0) ThenBlock: { Win_Close(win4) }
    DeskbarState.needs_refresh = 1
    Deskbar_Refresh()
    SysDisplayState.dirty = 1
    Win_BlitAll()
    PrintMessage("[STEP 30] PASS\n")

    // ── STEP 31: Dump final framebuffer ──
    PrintMessage("[STEP 31] Dump framebuffer to PPM\n")
    DumpFBtoPPM("/tmp/headless_fb.ppm")
    PrintMessage("[STEP 31] PASS\n")

    PrintMessage("\n========================================\n")
    PrintMessage("  ALL 31 STEPS PASS — no hang, no crash\n")
    PrintMessage("========================================\n")
}

RunTask(Main)
