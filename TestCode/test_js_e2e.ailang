// test_js_e2e.ailang — End-to-end JavaScript engine integration test
// Loads HTML with <script> tags, runs JS, verifies DOM mutations.
//
// Build: ./ailang.x TestCode/test_js_e2e.ailang test_js_e2e.x
// Run:   ./test_js_e2e.x
//
// Copyright (c) 2026 Sean Collins, 2 Paws Machine and Engineering. SCSL.

LibraryImport.Arena
LibraryImport.StringUtils
LibraryImport.Browser.HTMLTokenizer
LibraryImport.Browser.HTMLDom
LibraryImport.Browser.JSLexer
LibraryImport.Browser.JSParser
LibraryImport.Browser.JSCompiler
LibraryImport.Browser.JSRuntime
LibraryImport.Browser.JSVM
LibraryImport.Browser.JSBridge
LibraryImport.Browser.JSEngine

FixedPool.E2EState {
    "pass": Initialize=0
    "fail": Initialize=0
}

FixedPool.E2ETmp {
    "dom":    Initialize=0
    "node":   Initialize=0
    "text":   Initialize=0
    "len":    Initialize=0
    "result": Initialize=0
}

// =============================================================================
// ASSERT HELPER
// =============================================================================
Function.E2E_Assert {
    Input: cond: Integer
    Input: label: Address
    Output: Integer
    Body: {
        save_cond = cond
        save_label = label
        IfCondition EqualTo(save_cond, 1) ThenBlock: {
            PrintMessage("[PASS] ")
            PrintMessage(save_label)
            PrintMessage("\n")
            E2EState.pass = Add(E2EState.pass, 1)
        } ElseBlock: {
            PrintMessage("[FAIL] ")
            PrintMessage(save_label)
            PrintMessage("\n")
            E2EState.fail = Add(E2EState.fail, 1)
        }
        ReturnValue(save_cond)
    }
}

// =============================================================================
// TEST 1: Simple script — var assignment (no DOM mutation)
// =============================================================================
Function.Test_SimpleScript {
    Output: Integer
    Body: {
        PrintMessage("=== Test: Simple Script ===\n")

        // HTML with a script that just does arithmetic
        html = "<html><head><script>var x = 40 + 2;</script></head><body><p>Hello</p></body></html>"
        html_len = 84

        HTK_Reset()
        DOM_Reset()

        E2ETmp.dom = DOM_ParseString(html, html_len)
        E2E_Assert(GreaterEqual(E2ETmp.dom, 0), "DOM parsed OK")

        // Run JS engine on this DOM
        JSEngine_Reset()
        JSVM_SetMaxSteps(1000000)
        E2ETmp.result = JSEngine_LoadPage(E2ETmp.dom)
        E2E_Assert(GreaterEqual(E2ETmp.result, 0), "JSEngine_LoadPage OK")
        E2E_Assert(EqualTo(E2ETmp.result, 1), "Found and ran 1 script")
        E2E_Assert(EqualTo(JSEngine_GetError(), 0), "No JS error")

        ReturnValue(0)
    }
}

// =============================================================================
// TEST 2: innerHTML mutation — JS changes DOM text
// =============================================================================
Function.Test_InnerHTML {
    Output: Integer
    Body: {
        PrintMessage("=== Test: innerHTML Mutation ===\n")

        // HTML with a div that JS will modify
        html = "<html><body><div id=\"target\">old</div><script>document.getElementById(\"target\").innerHTML = \"new\";</script></body></html>"
        html_len = 122

        HTK_Reset()
        DOM_Reset()

        E2ETmp.dom = DOM_ParseString(html, html_len)
        E2E_Assert(GreaterEqual(E2ETmp.dom, 0), "DOM parsed OK")

        // Run JS
        JSEngine_Reset()
        JSVM_SetMaxSteps(1000000)
        E2ETmp.result = JSEngine_LoadPage(E2ETmp.dom)
        E2E_Assert(GreaterEqual(E2ETmp.result, 0), "JSEngine_LoadPage OK")
        E2E_Assert(EqualTo(JSEngine_GetError(), 0), "No JS error")

        // Check that innerHTML was changed — find the div again
        E2ETmp.node = DOM_FindById(E2ETmp.dom, "target")
        E2E_Assert(GreaterEqual(E2ETmp.node, 0), "Found div#target")

        // Get text content of the div's first child
        child = DOM_GetFirstChild(E2ETmp.node)
        IfCondition GreaterEqual(child, 0) ThenBlock: {
            E2ETmp.text = DOM_GetText(child)
            IfCondition NotEqual(E2ETmp.text, 0) ThenBlock: {
                cmp = StringCompare(E2ETmp.text, "new")
                E2E_Assert(EqualTo(cmp, 0), "innerHTML changed to 'new'")
            } ElseBlock: {
                E2E_Assert(0, "innerHTML changed to 'new'")
            }
        } ElseBlock: {
            E2E_Assert(0, "innerHTML changed to 'new'")
        }

        ReturnValue(0)
    }
}

// =============================================================================
// TEST 3: Multiple scripts — execute in document order
// =============================================================================
Function.Test_MultiScript {
    Output: Integer
    Body: {
        PrintMessage("=== Test: Multiple Scripts ===\n")

        html = "<html><body><script>var a = 10;</script><script>var b = 20;</script><script>var c = a + b;</script></body></html>"
        html_len = 112

        HTK_Reset()
        DOM_Reset()

        E2ETmp.dom = DOM_ParseString(html, html_len)
        E2E_Assert(GreaterEqual(E2ETmp.dom, 0), "DOM parsed OK")

        JSEngine_Reset()
        JSVM_SetMaxSteps(1000000)
        E2ETmp.result = JSEngine_LoadPage(E2ETmp.dom)
        E2E_Assert(EqualTo(E2ETmp.result, 3), "Found and ran 3 scripts")
        E2E_Assert(EqualTo(JSEngine_GetError(), 0), "No JS error")

        ReturnValue(0)
    }
}

// =============================================================================
// TEST 4: console.log — should not crash, just print
// =============================================================================
Function.Test_ConsoleLog {
    Output: Integer
    Body: {
        PrintMessage("=== Test: console.log ===\n")

        html = "<html><body><script>console.log(\"Hello from Ailang JS!\");</script></body></html>"
        html_len = 80

        HTK_Reset()
        DOM_Reset()

        E2ETmp.dom = DOM_ParseString(html, html_len)
        E2E_Assert(GreaterEqual(E2ETmp.dom, 0), "DOM parsed OK")

        JSEngine_Reset()
        JSVM_SetMaxSteps(1000000)
        E2ETmp.result = JSEngine_LoadPage(E2ETmp.dom)
        E2E_Assert(EqualTo(E2ETmp.result, 1), "Ran 1 script")
        E2E_Assert(EqualTo(JSEngine_GetError(), 0), "No JS error")

        ReturnValue(0)
    }
}

// =============================================================================
// TEST 5: Function definition + call inside script
// =============================================================================
Function.Test_FunctionCall {
    Output: Integer
    Body: {
        PrintMessage("=== Test: Function Def + Call ===\n")

        html = "<html><body><script>function double(n) { return n * 2; } var result = double(21);</script></body></html>"
        html_len = 102

        HTK_Reset()
        DOM_Reset()

        E2ETmp.dom = DOM_ParseString(html, html_len)
        E2E_Assert(GreaterEqual(E2ETmp.dom, 0), "DOM parsed OK")

        JSEngine_Reset()
        JSVM_SetMaxSteps(1000000)
        E2ETmp.result = JSEngine_LoadPage(E2ETmp.dom)
        E2E_Assert(EqualTo(E2ETmp.result, 1), "Ran 1 script")
        E2E_Assert(EqualTo(JSEngine_GetError(), 0), "No JS error")

        ReturnValue(0)
    }
}

// =============================================================================
// TEST 6: Loop with DOM mutation — fib computed, result written to DOM
// =============================================================================
Function.Test_LoopAndDOM {
    Output: Integer
    Body: {
        PrintMessage("=== Test: Loop + DOM Mutation ===\n")

        // Simplified: assign number via variable
        html = "<html><body><div id=\"out\">0</div><script>var el = document.getElementById(\"out\"); var r = 55; el.innerHTML = r;</script></body></html>"
        html_len = 134

        HTK_Reset()
        DOM_Reset()

        E2ETmp.dom = DOM_ParseString(html, html_len)
        E2E_Assert(GreaterEqual(E2ETmp.dom, 0), "DOM parsed OK")

        JSEngine_Reset()
        JSVM_SetMaxSteps(5000000)
        E2ETmp.result = JSEngine_LoadPage(E2ETmp.dom)
        E2E_Assert(EqualTo(E2ETmp.result, 1), "Ran 1 script")
        E2E_Assert(EqualTo(JSEngine_GetError(), 0), "No JS error")

        // fib(10) = 55, check DOM
        E2ETmp.node = DOM_FindById(E2ETmp.dom, "out")
        E2E_Assert(GreaterEqual(E2ETmp.node, 0), "Found div#out")

        child = DOM_GetFirstChild(E2ETmp.node)
        IfCondition GreaterEqual(child, 0) ThenBlock: {
            E2ETmp.text = DOM_GetText(child)
            IfCondition NotEqual(E2ETmp.text, 0) ThenBlock: {
                cmp = StringCompare(E2ETmp.text, "55")
                E2E_Assert(EqualTo(cmp, 0), "fib(10)=55 written to DOM")
            } ElseBlock: {
                E2E_Assert(0, "fib(10)=55 written to DOM")
            }
        } ElseBlock: {
            E2E_Assert(0, "fib(10)=55 written to DOM")
        }

        ReturnValue(0)
    }
}

// =============================================================================
// TEST 7: Object + property access in script
// =============================================================================
Function.Test_ObjectAccess {
    Output: Integer
    Body: {
        PrintMessage("=== Test: Object Property Access ===\n")

        html = "<html><body><script>var obj = {x: 10, y: 20}; var sum = obj.x + obj.y; console.log(sum);</script></body></html>"
        html_len = 109

        HTK_Reset()
        DOM_Reset()

        E2ETmp.dom = DOM_ParseString(html, html_len)
        E2E_Assert(GreaterEqual(E2ETmp.dom, 0), "DOM parsed OK")

        JSEngine_Reset()
        JSVM_SetMaxSteps(1000000)
        E2ETmp.result = JSEngine_LoadPage(E2ETmp.dom)
        E2E_Assert(EqualTo(E2ETmp.result, 1), "Ran 1 script")
        E2E_Assert(EqualTo(JSEngine_GetError(), 0), "No JS error")

        ReturnValue(0)
    }
}

// =============================================================================
// TEST 8: EvalString — run JS without DOM (like browser console)
// =============================================================================
Function.Test_EvalString {
    Output: Integer
    Body: {
        PrintMessage("=== Test: EvalString (no DOM) ===\n")

        JSEngine_Reset()
        JSVM_SetMaxSteps(1000000)

        js = "var x = 100; var y = 200; var z = x + y;"
        result = JSEngine_EvalString(js, 41)
        E2E_Assert(NotEqual(result, 0), "EvalString returned result")
        E2E_Assert(EqualTo(JSEngine_GetError(), 0), "No JS error")

        ReturnValue(0)
    }
}

// =============================================================================
// TEST 9: Direct innerHTML test — simpler approach, verify SET_PROP intercept
// =============================================================================
Function.Test_DirectInnerHTML {
    Output: Integer
    Body: {
        PrintMessage("=== Test: Direct innerHTML (step by step) ===\n")

        html = "<html><body><div id=\"box\">before</div></body></html>"
        html_len = 51

        HTK_Reset()
        DOM_Reset()

        E2ETmp.dom = DOM_ParseString(html, html_len)
        E2E_Assert(GreaterEqual(E2ETmp.dom, 0), "DOM parsed OK")

        // Init bridge with this DOM
        JSEngine_Reset()
        JSVM_SetMaxSteps(1000000)
        JSBridge_Init(E2ETmp.dom)
        JSVM_InstallBuiltins()

        // Manually register bridge globals
        doc_obj = JSBridge_GetDocObj()
        JSVM_SetGlobal("document", doc_obj)

        // Eval in a single script — var is local but lives for the script duration
        js1 = "var el = document.getElementById(\"box\"); el.innerHTML = \"after\";"
        JSEngine_EvalString(js1, 63)
        err1 = JSEngine_GetError()
        E2E_Assert(EqualTo(err1, 0), "innerHTML set OK")

        // Check DOM
        E2ETmp.node = DOM_FindById(E2ETmp.dom, "box")
        E2E_Assert(GreaterEqual(E2ETmp.node, 0), "Found div#box")
        child = DOM_GetFirstChild(E2ETmp.node)
        IfCondition GreaterEqual(child, 0) ThenBlock: {
            E2ETmp.text = DOM_GetText(child)
            IfCondition NotEqual(E2ETmp.text, 0) ThenBlock: {
                cmp = StringCompare(E2ETmp.text, "after")
                E2E_Assert(EqualTo(cmp, 0), "DOM text changed to 'after'")
            } ElseBlock: {
                E2E_Assert(0, "DOM text changed to 'after'")
            }
        } ElseBlock: {
            E2E_Assert(0, "DOM text changed to 'after'")
        }

        ReturnValue(0)
    }
}

// =============================================================================
// MAIN
// =============================================================================
SubRoutine.Main {
    Arena_Init()

    PrintMessage("============================================\n")
    PrintMessage("  JS Engine — End-to-End Integration Tests\n")
    PrintMessage("============================================\n\n")

    // Init subsystems
    HTK_Init()
    DOM_Init()
    JSEngine_Init()

    // Run tests
    Test_SimpleScript()
    Test_InnerHTML()
    Test_MultiScript()
    Test_ConsoleLog()
    Test_FunctionCall()

    Test_LoopAndDOM()
    Test_ObjectAccess()
    Test_EvalString()
    Test_DirectInnerHTML()

    // Summary
    PrintMessage("\n============================================\n")
    PrintMessage("PASS: ")
    PrintNumber(E2EState.pass)
    PrintMessage("  FAIL: ")
    PrintNumber(E2EState.fail)
    PrintMessage("\n")
    IfCondition EqualTo(E2EState.fail, 0) ThenBlock: {
        PrintMessage("ALL TESTS PASSED\n")
    } ElseBlock: {
        PrintMessage("SOME TESTS FAILED\n")
    }
    PrintMessage("============================================\n")

    JSEngine_Shutdown()
}

RunTask(Main)
