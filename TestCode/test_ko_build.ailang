// test_ko_build.ailang
// Build a minimal Linux kernel module (.ko) with:
//   init_module:    xor eax, eax; ret   (returns 0)
//   cleanup_module: ret                 (does nothing)
//
// No printk, no relocations — just proves the ELF structure is valid.
// Verify with: readelf -a test_module.ko
// Try loading with: sudo insmod test_module.ko  (will fail without printk but structure should parse)

LibraryImport.Compiler.Output.CELFTypes
LibraryImport.Compiler.Output.CELFBuilder
LibraryImport.Compiler.Output.CELFKernelModule
LibraryImport.Compiler.Output.COutput

Function.DoTest {
    Output: Integer
    Body: {
        PrintMessage("==============================================\n")
        PrintMessage("  .ko BUILDER TEST\n")
        PrintMessage("==============================================\n")

        ELF_Init()

        code_size = 4
        code = Allocate(code_size)
        SetByte(code, 0, 49)
        SetByte(code, 1, 192)
        SetByte(code, 2, 195)
        SetByte(code, 3, 195)

        PrintMessage("[TEST] .text bytes: 31 C0 C3 C3 (4 bytes)\n")

        data = 0
        data_size = 0

        result = ELF_BuildKernelModule(code, code_size, data, data_size)

        PrintMessage("[TEST] After ELF_BuildKernelModule, result=")
        PrintNumber(result)
        PrintMessage("\n")

        buf = ELF_GetBuffer()
        size = ELF_GetSize()

        PrintMessage("[TEST] Opening file...\n")
        fd = FileOpen("test_module.ko", FileFlags.WRITE_NEW, FileMode.EXEC)
        PrintMessage("[TEST] fd=")
        PrintNumber(fd)
        PrintMessage("\n")

        IfCondition LessThan(fd, 0) ThenBlock: {
            PrintMessage("[TEST] FAIL: FileOpen failed\n")
        } ElseBlock: {
            written = FileWrite(fd, buf, size)
            PrintMessage("[TEST] Wrote ")
            PrintNumber(written)
            PrintMessage(" bytes\n")
            FileClose(fd)
        }

        ELF_Free()
        Deallocate(code, code_size)
        PrintMessage("[TEST] Done\n")
        ReturnValue(0)
    }
}

SubRoutine.Main {
    DoTest()
}

RunTask(Main)