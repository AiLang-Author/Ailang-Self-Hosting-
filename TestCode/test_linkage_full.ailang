// test_linkage_full.ailang
LibraryImport.Arena

LinkagePool.TestPool {
    "a": Initialize=10
    "b": Initialize=20
    "c": Initialize=0
    "name": Initialize=""
}

SubRoutine.Main {
    Arena_Init()
    
    PrintMessage("=== LinkagePool Full Test ===\n\n")
    
    // Test 1: Initial values
    PrintMessage("Test 1: Initial values\n")
    ptr = AllocateLinkage(LinkagePool.TestPool)
    PrintMessage("  a = ")
    PrintNumber(ptr@a)
    PrintMessage(" (expected 10)\n")
    PrintMessage("  b = ")
    PrintNumber(ptr@b)
    PrintMessage(" (expected 20)\n")
    PrintMessage("  c = ")
    PrintNumber(ptr@c)
    PrintMessage(" (expected 0)\n")
    
    // Test 2: Write and read back
    PrintMessage("\nTest 2: Write and read back\n")
    ptr@a = 100
    ptr@b = 200
    ptr@c = 300
    PrintMessage("  a = ")
    PrintNumber(ptr@a)
    PrintMessage(" (expected 100)\n")
    PrintMessage("  b = ")
    PrintNumber(ptr@b)
    PrintMessage(" (expected 200)\n")
    PrintMessage("  c = ")
    PrintNumber(ptr@c)
    PrintMessage(" (expected 300)\n")
    
    // Test 3: Expressions with @ reads
    PrintMessage("\nTest 3: Expressions\n")
    sum = Add(ptr@a, ptr@b)
    PrintMessage("  Add(a, b) = ")
    PrintNumber(sum)
    PrintMessage(" (expected 300)\n")
    
    product = Multiply(ptr@a, 2)
    PrintMessage("  Multiply(a, 2) = ")
    PrintNumber(product)
    PrintMessage(" (expected 200)\n")
    
    // Test 4: Store expression result
    PrintMessage("\nTest 4: Store expression result\n")
    ptr@c = Add(ptr@a, ptr@b)
    PrintMessage("  c = Add(a,b) = ")
    PrintNumber(ptr@c)
    PrintMessage(" (expected 300)\n")
    
    // Test 5: Second allocation (independent)
    PrintMessage("\nTest 5: Second allocation\n")
    ptr2 = AllocateLinkage(LinkagePool.TestPool)
    PrintMessage("  ptr2@a = ")
    PrintNumber(ptr2@a)
    PrintMessage(" (expected 10, fresh init)\n")
    PrintMessage("  ptr@a still = ")
    PrintNumber(ptr@a)
    PrintMessage(" (expected 100, unchanged)\n")
    
    // Test 6: Free and done
    PrintMessage("\nTest 6: Cleanup\n")
    FreeLinkage(ptr, LinkagePool.TestPool)
    FreeLinkage(ptr2, LinkagePool.TestPool)
    PrintMessage("  FreeLinkage complete\n")
    
    PrintMessage("\n=== All Tests Complete ===\n")
    Exit(0)
}

RunTask(Main)