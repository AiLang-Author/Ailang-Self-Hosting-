// test_main.ailang
// Full system test with headless framebuffer + window resize exercise.
// Reproduces the resize crash without needing /dev/fb0.
//
// Build & run:
//   ./ailang.x TestCode/test_main.ailang test_main.x
//   ./test_main.x

// ─── Same imports as Main.ailang ─────────────────────────────────────────────
LibraryImport.Arena
LibraryImport.DSurfaceTypes
LibraryImport.DSurface
LibraryImport.DDrawPixel
LibraryImport.Framebuffer
LibraryImport.VIF
LibraryImport.SurfaceBlit
LibraryImport.Fonts
LibraryImport.TextRegion
LibraryImport.Auckland
LibraryImport.AucklandEvent
LibraryImport.HTMLParse
LibraryImport.AucklandBind
LibraryImport.WinManager
LibraryImport.WinToolbar
LibraryImport.DComposeFloat
LibraryImport.PaneDecorator
LibraryImport.DCompose
LibraryImport.XArrays
LibraryImport.PageSurface
LibraryImport.Document
LibraryImport.SysDisplay
LibraryImport.EventRouter
LibraryImport.CursorBitmap
LibraryImport.Deskbar
LibraryImport.Dialog
LibraryImport.AboutDialog
LibraryImport.FileDialog
LibraryImport.Menu
LibraryImport.Screenshot
LibraryImport.UIConfig
LibraryImport.UITheme
LibraryImport.UIScale
LibraryImport.JSON
LibraryImport.VIcon
LibraryImport.Cursor
LibraryImport.PostgreSQL_Complete
LibraryImport.DRingTypes
LibraryImport.DRing1
LibraryImport.DComposeTypes
LibraryImport.WinStack
LibraryImport.WinInput
LibraryImport.StringUtils

// ─── Override: headless framebuffer ──────────────────────────────────────────
// (FB_Init already set to headless in Library.Framebuffer.ailang choice path)

// ─── Override: no real evdev/TTY ─────────────────────────────────────────────
Function.Evdev_Poll {
    Body: { ReturnValue(0) }
}
Function.SysDisplay_InitTTY {
    Body: { ReturnValue(0) }
}
Function.SysDisplay_InitInput {
    Body: { ReturnValue(0) }
}

// ─── Override: replace main loop with resize test ────────────────────────────
Function.SysDisplay_Run {
    Output: Integer
    Body: {
        PrintMessage("[TEST] SysDisplay_Run override — resize stress test\n")

        idx = 1
        IfCondition LessThan(WinMgr.count, 2) ThenBlock: {
            PrintMessage("[TEST] FAIL: no window to resize\n")
            ReturnValue(0)
        }

        PrintMessage("[TEST] Window idx=1  w=")
        PrintNumber(Win_GetTotalW(idx))
        PrintMessage(" h=")
        PrintNumber(Win_GetTotalH(idx))
        PrintMessage("\n")

        // Baseline blit
        PrintMessage("[STEP 1] Baseline blit\n")
        Win_BlitAll()
        PrintMessage("[STEP 1] PASS\n")

        // ── STEP 2: 50 grow resize cycles (bottom-right) ────────────────
        PrintMessage("[STEP 2] 50 grow resizes +5px each\n")
        WinInputState.resize_edge = BitwiseOr(ResizeEdge.BOTTOM, ResizeEdge.RIGHT)
        ax = Add(Win_GetX(idx), Win_GetTotalW(idx))
        ay = Add(Win_GetY(idx), Win_GetTotalH(idx))
        Win_StartResize(idx, ax, ay)

        step = 0
        mx = ax
        my = ay
        WhileLoop LessThan(step, 50) {
            mx = Add(mx, 5)
            my = Add(my, 5)
            Win_UpdateResize(mx, my)
            SysDisplayState.dirty = 1
            Win_BlitAll()
            step = Add(step, 1)
        }
        Win_ApplyResize()
        PrintMessage("[STEP 2] PASS w=")
        PrintNumber(Win_GetTotalW(idx))
        PrintMessage(" h=")
        PrintNumber(Win_GetTotalH(idx))
        PrintMessage("\n")

        // ── STEP 3: 50 shrink resize cycles ──────────────────────────────
        PrintMessage("[STEP 3] 50 shrink resizes -5px each\n")
        WinInputState.resize_edge = BitwiseOr(ResizeEdge.BOTTOM, ResizeEdge.RIGHT)
        ax = Add(Win_GetX(idx), Win_GetTotalW(idx))
        ay = Add(Win_GetY(idx), Win_GetTotalH(idx))
        Win_StartResize(idx, ax, ay)

        step = 0
        mx = ax
        my = ay
        WhileLoop LessThan(step, 50) {
            mx = Subtract(mx, 5)
            my = Subtract(my, 5)
            Win_UpdateResize(mx, my)
            SysDisplayState.dirty = 1
            Win_BlitAll()
            step = Add(step, 1)
        }
        Win_ApplyResize()
        PrintMessage("[STEP 3] PASS w=")
        PrintNumber(Win_GetTotalW(idx))
        PrintMessage(" h=")
        PrintNumber(Win_GetTotalH(idx))
        PrintMessage("\n")

        // ── STEP 4: Shrink to minimum size ───────────────────────────────
        PrintMessage("[STEP 4] Shrink to minimum\n")
        WinInputState.resize_edge = BitwiseOr(ResizeEdge.BOTTOM, ResizeEdge.RIGHT)
        ax = Add(Win_GetX(idx), Win_GetTotalW(idx))
        ay = Add(Win_GetY(idx), Win_GetTotalH(idx))
        Win_StartResize(idx, ax, ay)
        Win_UpdateResize(Subtract(ax, 500), Subtract(ay, 500))
        SysDisplayState.dirty = 1
        Win_BlitAll()
        Win_ApplyResize()
        PrintMessage("[STEP 4] PASS min w=")
        PrintNumber(Win_GetTotalW(idx))
        PrintMessage(" h=")
        PrintNumber(Win_GetTotalH(idx))
        PrintMessage("\n")

        // ── STEP 5: Grow back large ─────────────────────────────────────
        PrintMessage("[STEP 5] Grow back to large\n")
        WinInputState.resize_edge = BitwiseOr(ResizeEdge.BOTTOM, ResizeEdge.RIGHT)
        ax = Add(Win_GetX(idx), Win_GetTotalW(idx))
        ay = Add(Win_GetY(idx), Win_GetTotalH(idx))
        Win_StartResize(idx, ax, ay)
        Win_UpdateResize(Add(ax, 600), Add(ay, 400))
        SysDisplayState.dirty = 1
        Win_BlitAll()
        Win_ApplyResize()
        PrintMessage("[STEP 5] PASS w=")
        PrintNumber(Win_GetTotalW(idx))
        PrintMessage(" h=")
        PrintNumber(Win_GetTotalH(idx))
        PrintMessage("\n")

        // ── STEP 6: Rapid oscillation — 100 grow/shrink alternating ─────
        PrintMessage("[STEP 6] 100 rapid oscillations\n")
        WinInputState.resize_edge = BitwiseOr(ResizeEdge.BOTTOM, ResizeEdge.RIGHT)
        ax = Add(Win_GetX(idx), Win_GetTotalW(idx))
        ay = Add(Win_GetY(idx), Win_GetTotalH(idx))
        Win_StartResize(idx, ax, ay)

        step = 0
        mx = ax
        my = ay
        WhileLoop LessThan(step, 100) {
            // Odd steps shrink, even steps grow
            rem = Modulo(step, 2)
            IfCondition EqualTo(rem, 0) ThenBlock: {
                mx = Add(mx, 8)
                my = Add(my, 8)
            } ElseBlock: {
                mx = Subtract(mx, 3)
                my = Subtract(my, 3)
            }
            Win_UpdateResize(mx, my)
            SysDisplayState.dirty = 1
            Win_BlitAll()
            step = Add(step, 1)
        }
        Win_ApplyResize()
        PrintMessage("[STEP 6] PASS w=")
        PrintNumber(Win_GetTotalW(idx))
        PrintMessage(" h=")
        PrintNumber(Win_GetTotalH(idx))
        PrintMessage("\n")

        // ── STEP 7: Batched resizes WITHOUT blit (real event drain) ────
        PrintMessage("[STEP 7] 20 resizes batched, then 1 blit (simulates real input drain)\n")
        WinInputState.resize_edge = BitwiseOr(ResizeEdge.BOTTOM, ResizeEdge.RIGHT)
        ax = Add(Win_GetX(idx), Win_GetTotalW(idx))
        ay = Add(Win_GetY(idx), Win_GetTotalH(idx))
        Win_StartResize(idx, ax, ay)

        step = 0
        mx = ax
        my = ay
        WhileLoop LessThan(step, 20) {
            mx = Add(mx, 3)
            my = Add(my, 3)
            Win_UpdateResize(mx, my)
            step = Add(step, 1)
        }
        // Only ONE blit after all resizes
        SysDisplayState.dirty = 1
        Win_BlitAll()
        Win_ApplyResize()
        PrintMessage("[STEP 7] PASS w=")
        PrintNumber(Win_GetTotalW(idx))
        PrintMessage("\n")

        // ── STEP 7b: Batched shrink resizes WITHOUT blit ────────────────
        PrintMessage("[STEP 7b] 30 shrink resizes batched, then 1 blit\n")
        WinInputState.resize_edge = BitwiseOr(ResizeEdge.BOTTOM, ResizeEdge.RIGHT)
        ax = Add(Win_GetX(idx), Win_GetTotalW(idx))
        ay = Add(Win_GetY(idx), Win_GetTotalH(idx))
        Win_StartResize(idx, ax, ay)

        step = 0
        mx = ax
        my = ay
        WhileLoop LessThan(step, 30) {
            mx = Subtract(mx, 5)
            my = Subtract(my, 5)
            Win_UpdateResize(mx, my)
            step = Add(step, 1)
        }
        SysDisplayState.dirty = 1
        Win_BlitAll()
        Win_ApplyResize()
        PrintMessage("[STEP 7b] PASS w=")
        PrintNumber(Win_GetTotalW(idx))
        PrintMessage("\n")

        // ── STEP 8: Left-edge resize ────────────────────────────────────
        PrintMessage("[STEP 8] Left-edge resize\n")
        WinInputState.resize_edge = ResizeEdge.LEFT
        ax = Win_GetX(idx)
        ay = Add(Win_GetY(idx), Divide(Win_GetTotalH(idx), 2))
        Win_StartResize(idx, ax, ay)

        step = 0
        mx = ax
        WhileLoop LessThan(step, 20) {
            mx = Subtract(mx, 5)
            Win_UpdateResize(mx, ay)
            SysDisplayState.dirty = 1
            Win_BlitAll()
            step = Add(step, 1)
        }
        Win_ApplyResize()
        PrintMessage("[STEP 8] PASS w=")
        PrintNumber(Win_GetTotalW(idx))
        PrintMessage("\n")

        // ── STEP 9: Top-edge resize ─────────────────────────────────────
        PrintMessage("[STEP 9] Top-edge resize\n")
        WinInputState.resize_edge = ResizeEdge.TOP
        ax = Add(Win_GetX(idx), Divide(Win_GetTotalW(idx), 2))
        ay = Win_GetY(idx)
        Win_StartResize(idx, ax, ay)

        step = 0
        my = ay
        WhileLoop LessThan(step, 20) {
            my = Subtract(my, 5)
            Win_UpdateResize(ax, my)
            SysDisplayState.dirty = 1
            Win_BlitAll()
            step = Add(step, 1)
        }
        Win_ApplyResize()
        PrintMessage("[STEP 9] PASS h=")
        PrintNumber(Win_GetTotalH(idx))
        PrintMessage("\n")

        PrintMessage("[TEST] Resize tests PASS — ")
        PrintNumber(Win_GetTotalW(idx))
        PrintMessage("x")
        PrintNumber(Win_GetTotalH(idx))
        PrintMessage("\n")

        // ================================================================
        // F12 DEBUG OVERLAY STRESS TEST
        // ================================================================
        PrintMessage("\n[TEST] === F12 DEBUG OVERLAY STRESS TEST ===\n")

        // ── STEP 10: Toggle debug ON, render 10 frames ─────────────────
        PrintMessage("[STEP 10] Toggle debug ON + 10 frames\n")
        DebugLog_Toggle()
        frame = 0
        WhileLoop LessThan(frame, 10) {
            SysDisplayState.frame_count = Add(SysDisplayState.frame_count, 1)
            DebugLog_Render()
            SysDisplayState.dirty = 1
            Win_BlitAll()
            frame = Add(frame, 1)
        }
        PrintMessage("[STEP 10] PASS — debug ON, 10 frames rendered\n")

        // ── STEP 11: Open new window WITH debug ON ─────────────────────
        PrintMessage("[STEP 11] Open new window with debug ON\n")
        win2 = Win_Create(400, 300, WinColor.WINDOW, "Debug Test")
        IfCondition LessThan(win2, 0) ThenBlock: {
            PrintMessage("[STEP 11] FAIL: Win_Create returned ")
            PrintNumber(win2)
            PrintMessage("\n")
        } ElseBlock: {
            Win_CreateToolbarDefault(win2)
            WinMgr_SetTB(win2, -1)
            DeskbarState.needs_refresh = 1
            Deskbar_Refresh()
            SysDisplayState.dirty = 1
            DebugLog_Render()
            Win_BlitAll()
            PrintMessage("[STEP 11] PASS — win2=")
            PrintNumber(win2)
            PrintMessage(" total_windows=")
            PrintNumber(WinMgr.count)
            PrintMessage("\n")
        }

        // ── STEP 12: Render 10 more frames with 2 windows + debug ──────
        PrintMessage("[STEP 12] 10 frames with 2 windows + debug overlay\n")
        frame = 0
        WhileLoop LessThan(frame, 10) {
            SysDisplayState.frame_count = Add(SysDisplayState.frame_count, 1)
            DebugLog_Render()
            SysDisplayState.dirty = 1
            Win_BlitAll()
            frame = Add(frame, 1)
        }
        PrintMessage("[STEP 12] PASS\n")

        // ── STEP 13: Resize window while debug is ON ───────────────────
        PrintMessage("[STEP 13] Resize win1 with debug ON\n")
        WinInputState.resize_edge = BitwiseOr(ResizeEdge.BOTTOM, ResizeEdge.RIGHT)
        ax = Add(Win_GetX(idx), Win_GetTotalW(idx))
        ay = Add(Win_GetY(idx), Win_GetTotalH(idx))
        Win_StartResize(idx, ax, ay)
        step = 0
        mx = ax
        my = ay
        WhileLoop LessThan(step, 20) {
            mx = Add(mx, 4)
            my = Add(my, 4)
            Win_UpdateResize(mx, my)
            SysDisplayState.frame_count = Add(SysDisplayState.frame_count, 1)
            DebugLog_Render()
            SysDisplayState.dirty = 1
            Win_BlitAll()
            step = Add(step, 1)
        }
        Win_ApplyResize()
        PrintMessage("[STEP 13] PASS — resized with debug ON\n")

        // ── STEP 14: Toggle OFF, render frames ─────────────────────────
        PrintMessage("[STEP 14] Toggle debug OFF + 5 frames\n")
        DebugLog_Toggle()
        frame = 0
        WhileLoop LessThan(frame, 5) {
            SysDisplayState.frame_count = Add(SysDisplayState.frame_count, 1)
            DebugLog_Render()
            SysDisplayState.dirty = 1
            Win_BlitAll()
            frame = Add(frame, 1)
        }
        PrintMessage("[STEP 14] PASS — debug OFF, dbg_surf freed\n")

        // ── STEP 15: Toggle ON again, open 3rd window ──────────────────
        PrintMessage("[STEP 15] Toggle ON again + open 3rd window\n")
        DebugLog_Toggle()
        win3 = Win_Create(350, 250, WinColor.DIALOG, "Win Three")
        IfCondition LessThan(win3, 0) ThenBlock: {
            PrintMessage("[STEP 15] FAIL: Win_Create returned ")
            PrintNumber(win3)
            PrintMessage("\n")
        } ElseBlock: {
            Win_CreateToolbarDefault(win3)
            WinMgr_SetTB(win3, -1)
            DeskbarState.needs_refresh = 1
            Deskbar_Refresh()
            SysDisplayState.dirty = 1
            DebugLog_Render()
            Win_BlitAll()
            PrintMessage("[STEP 15] PASS — win3=")
            PrintNumber(win3)
            PrintMessage(" total_windows=")
            PrintNumber(WinMgr.count)
            PrintMessage("\n")
        }

        // ── STEP 16: Close win2 with debug ON ──────────────────────────
        PrintMessage("[STEP 16] Close win2 with debug ON\n")
        IfCondition GreaterThan(win2, 0) ThenBlock: {
            Win_Close(win2)
            DeskbarState.needs_refresh = 1
            Deskbar_Refresh()
            SysDisplayState.dirty = 1
            DebugLog_Render()
            Win_BlitAll()
            PrintMessage("[STEP 16] PASS — win2 closed, total_windows=")
            PrintNumber(WinMgr.count)
            PrintMessage("\n")
        }

        // ── STEP 17: Rapid toggle cycling (20 on/off cycles) ───────────
        PrintMessage("[STEP 17] Rapid toggle cycling — 20 on/off cycles\n")
        cyc = 0
        WhileLoop LessThan(cyc, 20) {
            DebugLog_Toggle()
            SysDisplayState.frame_count = Add(SysDisplayState.frame_count, 1)
            DebugLog_Render()
            SysDisplayState.dirty = 1
            Win_BlitAll()
            cyc = Add(cyc, 1)
        }
        // Ensure debug ends OFF after even number of cycles
        PrintMessage("[STEP 17] PASS — 20 toggle cycles, debug=")
        PrintNumber(DebugLog.enabled)
        PrintMessage("\n")

        // ── STEP 18: Debug ON + close remaining extra window ───────────
        PrintMessage("[STEP 18] Debug ON + close win3\n")
        IfCondition EqualTo(DebugLog.enabled, 0) ThenBlock: {
            DebugLog_Toggle()
        }
        IfCondition GreaterThan(win3, 0) ThenBlock: {
            Win_Close(win3)
            DeskbarState.needs_refresh = 1
            Deskbar_Refresh()
        }
        SysDisplayState.dirty = 1
        DebugLog_Render()
        Win_BlitAll()
        PrintMessage("[STEP 18] PASS — win3 closed, total_windows=")
        PrintNumber(WinMgr.count)
        PrintMessage("\n")

        // ── STEP 19: Final toggle OFF + clean blit ─────────────────────
        PrintMessage("[STEP 19] Final toggle OFF + clean blit\n")
        DebugLog_Toggle()
        SysDisplayState.dirty = 1
        DebugLog_Render()
        Win_BlitAll()
        PrintMessage("[STEP 19] PASS\n")

        PrintMessage("\n[TEST] ALL PASS — resize + F12 debug overlay\n")
        ReturnValue(1)
    }
}

// ─── App state + functions (same as Main.ailang) ─────────────────────────────
FixedPool.AppState {
    "doc":         Initialize=-1, CanChange=True
    "line_count":  Initialize=0, CanChange=True
    "win_idx":     Initialize=-1, CanChange=True
    "fb_win_idx":  Initialize=-1, CanChange=True
    "fb_doc":      Initialize=-1, CanChange=True
}

Function.App_CreateDocWindow {
    Output: Integer
    Body: {
        win_w = 620
        win_h = 500
        win_idx = Win_Create(win_w, win_h, WinColor.WINDOW, "Notepad")
        IfCondition LessThan(win_idx, 0) ThenBlock: {
            PrintMessage("[App] Win_Create failed\n")
            ReturnValue(-1)
        }
        AppState.win_idx = win_idx
        Win_CreateToolbarDefault(win_idx)
        WinMgr_SetTB(win_idx, -1)

        content = WinMgr_GetContent(win_idx)
        IfCondition LessEqual(content, 0) ThenBlock: {
            PrintMessage("[App] no content surface\n")
            ReturnValue(-1)
        }

        doc = Doc_Create(PaperType.LETTER, PageOrient.PORTRAIT, 96)
        IfCondition LessThan(doc, 0) ThenBlock: {
            PrintMessage("[App] Doc_Create failed\n")
            ReturnValue(-1)
        }
        AppState.doc = doc

        page0_auto = Doc_GetPage(doc, 0)
        IfCondition GreaterEqual(page0_auto, 0) ThenBlock: {
            PageSurface_Destroy(page0_auto)
        }

        cw = Win_GetCanvasW(win_idx)
        ch = Win_GetCanvasH(win_idx)
        page = PageSurface_CreateFree(cw, ch, 96)
        IfCondition LessThan(page, 0) ThenBlock: {
            PrintMessage("[App] page create failed\n")
            ReturnValue(-1)
        }
        PageSurface_SetMarginsPixels(page, 16, 16, 16, 16)

        pages = Doc_Get(doc, DocField.PAGE_LIST)
        XArray.XSet(pages, 0, page)

        App_WriteContent(doc)
        App_BlitPageToWindow(page, content, cw, ch)

        SysDisplayState.dirty = 1
        PrintMessage("[App] document window created\n")
        ReturnValue(win_idx)
    }
}

Function.App_WriteContent {
    Input: doc: Integer
    Body: {
        title_clr = TVG_PackColor(0, 80, 180, 255)
        body_clr = TVG_PackColor(30, 30, 30, 255)

        VFont_UseSize(UIScale.font_doc)

        Doc_WriteText(doc, "AILANG Document System", 22, title_clr)
        Doc_WriteText(doc, "", 0, body_clr)
        Doc_WriteText(doc, "Resize test content line 1", 26, body_clr)
        Doc_WriteText(doc, "Resize test content line 2", 26, body_clr)
        Doc_WriteText(doc, "Resize test content line 3", 26, body_clr)

        AppState.line_count = 5
        VFont_UseSize(UIScale.font_body)
    }
}

Function.App_BlitPageToWindow {
    Input: page: Integer
    Input: dst_surf: Integer
    Input: dst_w: Integer
    Input: dst_h: Integer
    Body: {
        src_surf = PageSurface_GetSurface(page)
        IfCondition EqualTo(src_surf, 0) ThenBlock: { ReturnValue(0) }

        src_w = PageSurface_GetWidth(page)
        src_h = PageSurface_GetHeight(page)

        blit_w = src_w
        IfCondition GreaterThan(blit_w, dst_w) ThenBlock: { blit_w = dst_w }
        blit_h = src_h
        IfCondition GreaterThan(blit_h, dst_h) ThenBlock: { blit_h = dst_h }

        src_data = Surface_GetData(src_surf)
        src_pitch = Surface_GetPitch(src_surf)
        dst_data = Surface_GetData(dst_surf)
        dst_pitch = Surface_GetPitch(dst_surf)
        row_bytes = Multiply(blit_w, 4)

        by = 0
        WhileLoop LessThan(by, blit_h) {
            src_row = Add(src_data, Multiply(by, src_pitch))
            dst_row = Add(dst_data, Multiply(by, dst_pitch))
            MemoryCopy(dst_row, src_row, row_bytes)
            by = Add(by, 1)
        }
    }
}

Function.App_AddLine {
    Output: Integer
    Body: { ReturnValue(0) }
}

// ─── MAIN ────────────────────────────────────────────────────────────────────
SubRoutine.Main {
    Arena_Init()
    SysDisplay_Init()

    PrintMessage("[TEST] Init complete, setting up app\n")

    EventRouter_Init()
    Dialog_Init()
    Menu_Init()
    Deskbar_Init(SysDisplayState.scr_w, SysDisplayState.scr_h)
    HTML_Init()
    PageSurface_Init()
    Doc_Init()
    VFont_UseSize(UIScale.font_body)

    // Create initial document window
    VFont_UseSize(UIScale.font_doc)
    App_CreateDocWindow()

    VFont_UseSize(UIScale.font_body)
    Win_BlitAll()

    // Enter overridden main loop (resize test)
    SysDisplay_Run()
    SysDisplay_Shutdown()
}

RunTask(Main)
