// test_main.ailang
// Full system test with headless framebuffer + window resize exercise.
// Reproduces the resize crash without needing /dev/fb0.
//
// Build & run:
//   ./ailang.x TestCode/test_main.ailang test_main.x
//   ./test_main.x

// ─── Same imports as Main.ailang ─────────────────────────────────────────────
LibraryImport.Arena
LibraryImport.Display.Render.DSurfaceTypes
LibraryImport.Display.Render.DSurface
LibraryImport.Display.Render.DDrawPixel
LibraryImport.Display.Render.Framebuffer
LibraryImport.Display.Render.VIF
LibraryImport.Display.Render.SurfaceBlit
LibraryImport.Display.Render.Fonts
LibraryImport.Display.UI.TextRegion
LibraryImport.Display.UI.Auckland
LibraryImport.Display.UI.AucklandEvent
LibraryImport.Display.Content.HTMLParse
LibraryImport.Display.UI.AucklandBind
LibraryImport.Display.Window.WinManager
LibraryImport.Display.Window.WinToolbar
LibraryImport.Display.Render.DComposeFloat
LibraryImport.Display.UI.PaneDecorator
LibraryImport.Display.Render.DCompose
LibraryImport.XArrays
LibraryImport.Display.Content.PageSurface
LibraryImport.Display.Content.Document
LibraryImport.Display.System.SysDisplay
LibraryImport.Display.System.EventRouter
LibraryImport.Display.Input.CursorBitmap
LibraryImport.Display.Menu.Deskbar
LibraryImport.Display.UI.Dialog
LibraryImport.Display.UI.AboutDialog
LibraryImport.Display.UI.FileDialog
LibraryImport.Display.Menu.Menu
LibraryImport.Display.System.Screenshot
LibraryImport.Display.Theme.UIConfig
LibraryImport.Display.Theme.UITheme
LibraryImport.Display.Theme.UIScale
LibraryImport.JSON
LibraryImport.Display.Render.VIcon
LibraryImport.Display.Input.Cursor
LibraryImport.PostgreSQL_Complete
LibraryImport.Display.Render.DRingTypes
LibraryImport.Display.Render.DRing1
LibraryImport.Display.Render.DComposeTypes
LibraryImport.Display.Window.WinStack
LibraryImport.Display.Window.WinInput
LibraryImport.StringUtils
LibraryImport.Socket
LibraryImport.Calculator
LibraryImport.HashMap
LibraryImport.Display.IPC.IPCBroker
LibraryImport.Display.Menu.StartMenu
LibraryImport.Display.Menu.CascadeMenu
LibraryImport.KeyMap
LibraryImport.TextBuffer
LibraryImport.Display.Input.DInputTypes
LibraryImport.AppHost
LibraryImport.ShmCanvas
LibraryImport.TermFont
LibraryImport.Browser.URL
LibraryImport.Browser.DNS
LibraryImport.Browser.HTTPClient
LibraryImport.Browser.HTMLTokenizer
LibraryImport.Browser.HTMLDom
LibraryImport.Browser.CSSParse
LibraryImport.Browser.HTMLLayout
LibraryImport.Browser.HTMLRender

// ─── Override: headless framebuffer ──────────────────────────────────────────
// Call FB_InitHeadless before SysDisplay_Init so FB_Init skips /dev/fb0
Function.RenderFB_InitDouble {
    Output: Integer
    Body: {
        FB_InitHeadless(1920, 1080)
        ReturnValue(1)
    }
}

// ─── Override: no real evdev/TTY ─────────────────────────────────────────────
Function.Evdev_Poll {
    Body: { ReturnValue(0) }
}
Function.SysDisplay_InitTTY {
    Body: { ReturnValue(0) }
}
Function.SysDisplay_InitInput {
    Body: { ReturnValue(0) }
}

// ─── Override: replace main loop with resize test ────────────────────────────
Function.SysDisplay_Run {
    Output: Integer
    Body: {
        PrintMessage("[TEST] SysDisplay_Run override — resize stress test\n")

        idx = 1
        IfCondition LessThan(WinMgr.count, 2) ThenBlock: {
            PrintMessage("[TEST] FAIL: no window to resize\n")
            ReturnValue(0)
        }

        PrintMessage("[TEST] Window idx=1  w=")
        PrintNumber(Win_GetTotalW(idx))
        PrintMessage(" h=")
        PrintNumber(Win_GetTotalH(idx))
        PrintMessage("\n")

        // Baseline blit
        PrintMessage("[STEP 1] Baseline blit\n")
        Win_BlitAll()
        PrintMessage("[STEP 1] PASS\n")

        // ── STEP 2: 50 grow resize cycles (bottom-right) ────────────────
        PrintMessage("[STEP 2] 50 grow resizes +5px each\n")
        WinInputState.resize_edge = BitwiseOr(ResizeEdge.BOTTOM, ResizeEdge.RIGHT)
        ax = Add(Win_GetX(idx), Win_GetTotalW(idx))
        ay = Add(Win_GetY(idx), Win_GetTotalH(idx))
        Win_StartResize(idx, ax, ay)

        step = 0
        mx = ax
        my = ay
        WhileLoop LessThan(step, 50) {
            mx = Add(mx, 5)
            my = Add(my, 5)
            Win_UpdateResize(mx, my)
            SysDisplayState.dirty = 1
            Win_BlitAll()
            step = Add(step, 1)
        }
        Win_ApplyResize()
        PrintMessage("[STEP 2] PASS w=")
        PrintNumber(Win_GetTotalW(idx))
        PrintMessage(" h=")
        PrintNumber(Win_GetTotalH(idx))
        PrintMessage("\n")

        // ── STEP 3: 50 shrink resize cycles ──────────────────────────────
        PrintMessage("[STEP 3] 50 shrink resizes -5px each\n")
        WinInputState.resize_edge = BitwiseOr(ResizeEdge.BOTTOM, ResizeEdge.RIGHT)
        ax = Add(Win_GetX(idx), Win_GetTotalW(idx))
        ay = Add(Win_GetY(idx), Win_GetTotalH(idx))
        Win_StartResize(idx, ax, ay)

        step = 0
        mx = ax
        my = ay
        WhileLoop LessThan(step, 50) {
            mx = Subtract(mx, 5)
            my = Subtract(my, 5)
            Win_UpdateResize(mx, my)
            SysDisplayState.dirty = 1
            Win_BlitAll()
            step = Add(step, 1)
        }
        Win_ApplyResize()
        PrintMessage("[STEP 3] PASS w=")
        PrintNumber(Win_GetTotalW(idx))
        PrintMessage(" h=")
        PrintNumber(Win_GetTotalH(idx))
        PrintMessage("\n")

        // ── STEP 4: Shrink to minimum size ───────────────────────────────
        PrintMessage("[STEP 4] Shrink to minimum\n")
        WinInputState.resize_edge = BitwiseOr(ResizeEdge.BOTTOM, ResizeEdge.RIGHT)
        ax = Add(Win_GetX(idx), Win_GetTotalW(idx))
        ay = Add(Win_GetY(idx), Win_GetTotalH(idx))
        Win_StartResize(idx, ax, ay)
        Win_UpdateResize(Subtract(ax, 500), Subtract(ay, 500))
        SysDisplayState.dirty = 1
        Win_BlitAll()
        Win_ApplyResize()
        PrintMessage("[STEP 4] PASS min w=")
        PrintNumber(Win_GetTotalW(idx))
        PrintMessage(" h=")
        PrintNumber(Win_GetTotalH(idx))
        PrintMessage("\n")

        // ── STEP 5: Grow back large ─────────────────────────────────────
        PrintMessage("[STEP 5] Grow back to large\n")
        WinInputState.resize_edge = BitwiseOr(ResizeEdge.BOTTOM, ResizeEdge.RIGHT)
        ax = Add(Win_GetX(idx), Win_GetTotalW(idx))
        ay = Add(Win_GetY(idx), Win_GetTotalH(idx))
        Win_StartResize(idx, ax, ay)
        Win_UpdateResize(Add(ax, 600), Add(ay, 400))
        SysDisplayState.dirty = 1
        Win_BlitAll()
        Win_ApplyResize()
        PrintMessage("[STEP 5] PASS w=")
        PrintNumber(Win_GetTotalW(idx))
        PrintMessage(" h=")
        PrintNumber(Win_GetTotalH(idx))
        PrintMessage("\n")

        // ── STEP 6: Rapid oscillation — 100 grow/shrink alternating ─────
        PrintMessage("[STEP 6] 100 rapid oscillations\n")
        WinInputState.resize_edge = BitwiseOr(ResizeEdge.BOTTOM, ResizeEdge.RIGHT)
        ax = Add(Win_GetX(idx), Win_GetTotalW(idx))
        ay = Add(Win_GetY(idx), Win_GetTotalH(idx))
        Win_StartResize(idx, ax, ay)

        step = 0
        mx = ax
        my = ay
        WhileLoop LessThan(step, 100) {
            // Odd steps shrink, even steps grow
            rem = Modulo(step, 2)
            IfCondition EqualTo(rem, 0) ThenBlock: {
                mx = Add(mx, 8)
                my = Add(my, 8)
            } ElseBlock: {
                mx = Subtract(mx, 3)
                my = Subtract(my, 3)
            }
            Win_UpdateResize(mx, my)
            SysDisplayState.dirty = 1
            Win_BlitAll()
            step = Add(step, 1)
        }
        Win_ApplyResize()
        PrintMessage("[STEP 6] PASS w=")
        PrintNumber(Win_GetTotalW(idx))
        PrintMessage(" h=")
        PrintNumber(Win_GetTotalH(idx))
        PrintMessage("\n")

        // ── STEP 7: Batched resizes WITHOUT blit (real event drain) ────
        PrintMessage("[STEP 7] 20 resizes batched, then 1 blit (simulates real input drain)\n")
        WinInputState.resize_edge = BitwiseOr(ResizeEdge.BOTTOM, ResizeEdge.RIGHT)
        ax = Add(Win_GetX(idx), Win_GetTotalW(idx))
        ay = Add(Win_GetY(idx), Win_GetTotalH(idx))
        Win_StartResize(idx, ax, ay)

        step = 0
        mx = ax
        my = ay
        WhileLoop LessThan(step, 20) {
            mx = Add(mx, 3)
            my = Add(my, 3)
            Win_UpdateResize(mx, my)
            step = Add(step, 1)
        }
        // Only ONE blit after all resizes
        SysDisplayState.dirty = 1
        Win_BlitAll()
        Win_ApplyResize()
        PrintMessage("[STEP 7] PASS w=")
        PrintNumber(Win_GetTotalW(idx))
        PrintMessage("\n")

        // ── STEP 7b: Batched shrink resizes WITHOUT blit ────────────────
        PrintMessage("[STEP 7b] 30 shrink resizes batched, then 1 blit\n")
        WinInputState.resize_edge = BitwiseOr(ResizeEdge.BOTTOM, ResizeEdge.RIGHT)
        ax = Add(Win_GetX(idx), Win_GetTotalW(idx))
        ay = Add(Win_GetY(idx), Win_GetTotalH(idx))
        Win_StartResize(idx, ax, ay)

        step = 0
        mx = ax
        my = ay
        WhileLoop LessThan(step, 30) {
            mx = Subtract(mx, 5)
            my = Subtract(my, 5)
            Win_UpdateResize(mx, my)
            step = Add(step, 1)
        }
        SysDisplayState.dirty = 1
        Win_BlitAll()
        Win_ApplyResize()
        PrintMessage("[STEP 7b] PASS w=")
        PrintNumber(Win_GetTotalW(idx))
        PrintMessage("\n")

        // ── STEP 8: Left-edge resize ────────────────────────────────────
        PrintMessage("[STEP 8] Left-edge resize\n")
        WinInputState.resize_edge = ResizeEdge.LEFT
        ax = Win_GetX(idx)
        ay = Add(Win_GetY(idx), Divide(Win_GetTotalH(idx), 2))
        Win_StartResize(idx, ax, ay)

        step = 0
        mx = ax
        WhileLoop LessThan(step, 20) {
            mx = Subtract(mx, 5)
            Win_UpdateResize(mx, ay)
            SysDisplayState.dirty = 1
            Win_BlitAll()
            step = Add(step, 1)
        }
        Win_ApplyResize()
        PrintMessage("[STEP 8] PASS w=")
        PrintNumber(Win_GetTotalW(idx))
        PrintMessage("\n")

        // ── STEP 9: Top-edge resize ─────────────────────────────────────
        PrintMessage("[STEP 9] Top-edge resize\n")
        WinInputState.resize_edge = ResizeEdge.TOP
        ax = Add(Win_GetX(idx), Divide(Win_GetTotalW(idx), 2))
        ay = Win_GetY(idx)
        Win_StartResize(idx, ax, ay)

        step = 0
        my = ay
        WhileLoop LessThan(step, 20) {
            my = Subtract(my, 5)
            Win_UpdateResize(ax, my)
            SysDisplayState.dirty = 1
            Win_BlitAll()
            step = Add(step, 1)
        }
        Win_ApplyResize()
        PrintMessage("[STEP 9] PASS h=")
        PrintNumber(Win_GetTotalH(idx))
        PrintMessage("\n")

        PrintMessage("[TEST] Resize tests PASS — ")
        PrintNumber(Win_GetTotalW(idx))
        PrintMessage("x")
        PrintNumber(Win_GetTotalH(idx))
        PrintMessage("\n")

        // ================================================================
        // F12 DEBUG OVERLAY STRESS TEST
        // ================================================================
        PrintMessage("\n[TEST] === F12 DEBUG OVERLAY STRESS TEST ===\n")

        // ── STEP 10: Toggle debug ON, render 10 frames ─────────────────
        PrintMessage("[STEP 10] Toggle debug ON + 10 frames\n")
        DebugLog_Toggle()
        frame = 0
        WhileLoop LessThan(frame, 10) {
            SysDisplayState.frame_count = Add(SysDisplayState.frame_count, 1)
            DebugLog_Render()
            SysDisplayState.dirty = 1
            Win_BlitAll()
            frame = Add(frame, 1)
        }
        PrintMessage("[STEP 10] PASS — debug ON, 10 frames rendered\n")

        // ── STEP 11: Open new window WITH debug ON ─────────────────────
        PrintMessage("[STEP 11] Open new window with debug ON\n")
        win2 = Win_Create(400, 300, WinColor.WINDOW, "Debug Test")
        IfCondition LessThan(win2, 0) ThenBlock: {
            PrintMessage("[STEP 11] FAIL: Win_Create returned ")
            PrintNumber(win2)
            PrintMessage("\n")
        } ElseBlock: {
            Win_CreateToolbarDefault(win2)
            WinMgr_SetTB(win2, -1)
            DeskbarState.needs_refresh = 1
            Deskbar_Refresh()
            SysDisplayState.dirty = 1
            DebugLog_Render()
            Win_BlitAll()
            PrintMessage("[STEP 11] PASS — win2=")
            PrintNumber(win2)
            PrintMessage(" total_windows=")
            PrintNumber(WinMgr.count)
            PrintMessage("\n")
        }

        // ── STEP 12: Render 10 more frames with 2 windows + debug ──────
        PrintMessage("[STEP 12] 10 frames with 2 windows + debug overlay\n")
        frame = 0
        WhileLoop LessThan(frame, 10) {
            SysDisplayState.frame_count = Add(SysDisplayState.frame_count, 1)
            DebugLog_Render()
            SysDisplayState.dirty = 1
            Win_BlitAll()
            frame = Add(frame, 1)
        }
        PrintMessage("[STEP 12] PASS\n")

        // ── STEP 13: Resize window while debug is ON ───────────────────
        PrintMessage("[STEP 13] Resize win1 with debug ON\n")
        WinInputState.resize_edge = BitwiseOr(ResizeEdge.BOTTOM, ResizeEdge.RIGHT)
        ax = Add(Win_GetX(idx), Win_GetTotalW(idx))
        ay = Add(Win_GetY(idx), Win_GetTotalH(idx))
        Win_StartResize(idx, ax, ay)
        step = 0
        mx = ax
        my = ay
        WhileLoop LessThan(step, 20) {
            mx = Add(mx, 4)
            my = Add(my, 4)
            Win_UpdateResize(mx, my)
            SysDisplayState.frame_count = Add(SysDisplayState.frame_count, 1)
            DebugLog_Render()
            SysDisplayState.dirty = 1
            Win_BlitAll()
            step = Add(step, 1)
        }
        Win_ApplyResize()
        PrintMessage("[STEP 13] PASS — resized with debug ON\n")

        // ── STEP 14: Toggle OFF, render frames ─────────────────────────
        PrintMessage("[STEP 14] Toggle debug OFF + 5 frames\n")
        DebugLog_Toggle()
        frame = 0
        WhileLoop LessThan(frame, 5) {
            SysDisplayState.frame_count = Add(SysDisplayState.frame_count, 1)
            DebugLog_Render()
            SysDisplayState.dirty = 1
            Win_BlitAll()
            frame = Add(frame, 1)
        }
        PrintMessage("[STEP 14] PASS — debug OFF, dbg_surf freed\n")

        // ── STEP 15: Toggle ON again, open 3rd window ──────────────────
        PrintMessage("[STEP 15] Toggle ON again + open 3rd window\n")
        DebugLog_Toggle()
        win3 = Win_Create(350, 250, WinColor.DIALOG, "Win Three")
        IfCondition LessThan(win3, 0) ThenBlock: {
            PrintMessage("[STEP 15] FAIL: Win_Create returned ")
            PrintNumber(win3)
            PrintMessage("\n")
        } ElseBlock: {
            Win_CreateToolbarDefault(win3)
            WinMgr_SetTB(win3, -1)
            DeskbarState.needs_refresh = 1
            Deskbar_Refresh()
            SysDisplayState.dirty = 1
            DebugLog_Render()
            Win_BlitAll()
            PrintMessage("[STEP 15] PASS — win3=")
            PrintNumber(win3)
            PrintMessage(" total_windows=")
            PrintNumber(WinMgr.count)
            PrintMessage("\n")
        }

        // ── STEP 16: Close win2 with debug ON ──────────────────────────
        PrintMessage("[STEP 16] Close win2 with debug ON\n")
        IfCondition GreaterThan(win2, 0) ThenBlock: {
            Win_Close(win2)
            DeskbarState.needs_refresh = 1
            Deskbar_Refresh()
            SysDisplayState.dirty = 1
            DebugLog_Render()
            Win_BlitAll()
            PrintMessage("[STEP 16] PASS — win2 closed, total_windows=")
            PrintNumber(WinMgr.count)
            PrintMessage("\n")
        }

        // ── STEP 17: Rapid toggle cycling (20 on/off cycles) ───────────
        PrintMessage("[STEP 17] Rapid toggle cycling — 20 on/off cycles\n")
        cyc = 0
        WhileLoop LessThan(cyc, 20) {
            DebugLog_Toggle()
            SysDisplayState.frame_count = Add(SysDisplayState.frame_count, 1)
            DebugLog_Render()
            SysDisplayState.dirty = 1
            Win_BlitAll()
            cyc = Add(cyc, 1)
        }
        // Ensure debug ends OFF after even number of cycles
        PrintMessage("[STEP 17] PASS — 20 toggle cycles, debug=")
        PrintNumber(DebugLog.enabled)
        PrintMessage("\n")

        // ── STEP 18: Debug ON + close remaining extra window ───────────
        PrintMessage("[STEP 18] Debug ON + close win3\n")
        IfCondition EqualTo(DebugLog.enabled, 0) ThenBlock: {
            DebugLog_Toggle()
        }
        IfCondition GreaterThan(win3, 0) ThenBlock: {
            Win_Close(win3)
            DeskbarState.needs_refresh = 1
            Deskbar_Refresh()
        }
        SysDisplayState.dirty = 1
        DebugLog_Render()
        Win_BlitAll()
        PrintMessage("[STEP 18] PASS — win3 closed, total_windows=")
        PrintNumber(WinMgr.count)
        PrintMessage("\n")

        // ── STEP 19: Final toggle OFF + clean blit ─────────────────────
        PrintMessage("[STEP 19] Final toggle OFF + clean blit\n")
        DebugLog_Toggle()
        SysDisplayState.dirty = 1
        DebugLog_Render()
        Win_BlitAll()
        PrintMessage("[STEP 19] PASS\n")

        PrintMessage("\n[TEST] ALL PASS — resize + F12 debug overlay\n")

        // ================================================================
        // START MENU STRESS TEST
        // ================================================================
        PrintMessage("\n[TEST] === START MENU STRESS TEST ===\n")

        // ── STEP 20: Toggle Start Menu open ──────────────────────────
        PrintMessage("[STEP 20] Toggle Start Menu open\n")
        StartMenu_Toggle()
        IfCondition EqualTo(StartMenuState.open, 1) ThenBlock: {
            PrintMessage("[STEP 20] PASS — open=1 surface=")
            PrintNumber(StartMenuState.surface)
            PrintMessage(" ctx=")
            PrintNumber(StartMenuState.ak_ctx)
            PrintMessage(" pos=")
            PrintNumber(StartMenuState.screen_x)
            PrintMessage(",")
            PrintNumber(StartMenuState.screen_y)
            PrintMessage(" size=")
            PrintNumber(StartMenuState.width)
            PrintMessage("x")
            PrintNumber(StartMenuState.height)
            PrintMessage("\n")
        } ElseBlock: {
            PrintMessage("[STEP 20] FAIL — Start Menu did not open\n")
        }

        // ── STEP 21: Blit with Start Menu open ───────────────────────
        PrintMessage("[STEP 21] Blit with Start Menu overlay\n")
        SysDisplayState.dirty = 1
        Win_BlitAll()
        PrintMessage("[STEP 21] PASS — no crash\n")

        // ── STEP 22: Toggle closed, toggle open, rapid cycling ───────
        PrintMessage("[STEP 22] 10 rapid Start Menu open/close cycles\n")
        cyc = 0
        WhileLoop LessThan(cyc, 10) {
            StartMenu_Toggle()
            SysDisplayState.dirty = 1
            Win_BlitAll()
            cyc = Add(cyc, 1)
        }
        // After even number of toggles, should be same as start (open from step 20)
        // Actually we started open, 10 toggles = close->open->...->open(even)
        // 10 toggles from open: toggle 1=close, 2=open... 10=open. So open.
        IfCondition EqualTo(StartMenuState.open, 1) ThenBlock: {
            PrintMessage("[STEP 22] PASS — 10 cycles, open=1\n")
        } ElseBlock: {
            PrintMessage("[STEP 22] PASS — 10 cycles, open=0 (expected)\n")
        }

        // Close it for the next tests
        StartMenu_Close()
        SysDisplayState.dirty = 1
        Win_BlitAll()

        // ── STEP 23: Deskbar Home button event routing ───────────────
        PrintMessage("[STEP 23] EventRouter app.home dispatch\n")
        EventRouter_Push("app.home", 8, 0)
        action_count = EventRouter_Drain()
        IfCondition GreaterThan(action_count, 0) ThenBlock: {
            IfCondition EqualTo(StartMenuState.open, 1) ThenBlock: {
                PrintMessage("[STEP 23] PASS — app.home opened Start Menu\n")
            } ElseBlock: {
                PrintMessage("[STEP 23] FAIL — EventRouter drained but menu not open\n")
            }
        } ElseBlock: {
            PrintMessage("[STEP 23] FAIL — EventRouter_Drain returned 0\n")
        }

        // Close Start Menu
        StartMenu_Close()
        SysDisplayState.dirty = 1
        Win_BlitAll()

        // ── STEP 23b: Reopen Start Menu and verify categories ──────────
        PrintMessage("[STEP 23b] Reopen StartMenu, verify categories\n")
        StartMenu_Toggle()
        IfCondition EqualTo(StartMenuState.open, 1) ThenBlock: {
            PrintMessage("[STEP 23b] PASS — StartMenu open\n")
        } ElseBlock: {
            PrintMessage("[STEP 23b] FAIL — StartMenu not open\n")
        }

        // ── STEP 23c: Open Programs cascade ────────────────────────────
        PrintMessage("[STEP 23c] Open Programs cascade\n")
        cm_ax = Add(StartMenuState.screen_x, Add(StartMenuState.width, 2))
        cm_ay = Add(StartMenuState.screen_y, StartMenuConst.PAD)
        CascadeMenu_Show(0, cm_ax, cm_ay)
        IfCondition EqualTo(CascadeMenuState.open, 1) ThenBlock: {
            PrintMessage("[STEP 23c] PASS — CascadeMenu open=1 at ")
            PrintNumber(CascadeMenuState.screen_x)
            PrintMessage(",")
            PrintNumber(CascadeMenuState.screen_y)
            PrintMessage(" size=")
            PrintNumber(CascadeMenuState.width)
            PrintMessage("x")
            PrintNumber(CascadeMenuState.height)
            PrintMessage("\n")
        } ElseBlock: {
            PrintMessage("[STEP 23c] FAIL — CascadeMenu did not open\n")
        }

        // ── STEP 23d: Blit with StartMenu + CascadeMenu ───────────────
        PrintMessage("[STEP 23d] Blit with StartMenu + CascadeMenu\n")
        SysDisplayState.dirty = 1
        Win_BlitAll()
        PrintMessage("[STEP 23d] PASS — no crash\n")

        // ── STEP 23e: Switch to System cascade ─────────────────────────
        PrintMessage("[STEP 23e] Switch to System cascade\n")
        cm_ay2 = Add(StartMenuState.screen_y, Add(StartMenuConst.PAD, StartMenuConst.ITEM_H))
        CascadeMenu_Show(1, cm_ax, cm_ay2)
        SysDisplayState.dirty = 1
        Win_BlitAll()
        IfCondition EqualTo(CascadeMenuState.open, 1) ThenBlock: {
            IfCondition EqualTo(CascadeMenuState.menu_id, 1) ThenBlock: {
                PrintMessage("[STEP 23e] PASS — System cascade open\n")
            } ElseBlock: {
                PrintMessage("[STEP 23e] FAIL — wrong menu_id\n")
            }
        } ElseBlock: {
            PrintMessage("[STEP 23e] FAIL — CascadeMenu not open\n")
        }

        // ── STEP 23f: Close StartMenu (cascade closes too) ────────────
        PrintMessage("[STEP 23f] Close StartMenu (cascade closes too)\n")
        StartMenu_Close()
        IfCondition And(EqualTo(StartMenuState.open, 0), EqualTo(CascadeMenuState.open, 0)) ThenBlock: {
            PrintMessage("[STEP 23f] PASS — both closed\n")
        } ElseBlock: {
            PrintMessage("[STEP 23f] FAIL — not fully closed\n")
        }
        SysDisplayState.dirty = 1
        Win_BlitAll()

        // ── STEP 23g: Rapid cascade open/close cycling ─────────────────
        PrintMessage("[STEP 23g] Rapid StartMenu+Cascade cycling — 5 cycles\n")
        cyc = 0
        WhileLoop LessThan(cyc, 5) {
            StartMenu_Toggle()
            cm_cx = Add(StartMenuState.screen_x, Add(StartMenuState.width, 2))
            cm_cy = Add(StartMenuState.screen_y, StartMenuConst.PAD)
            CascadeMenu_Show(0, cm_cx, cm_cy)
            SysDisplayState.dirty = 1
            Win_BlitAll()
            StartMenu_Close()
            SysDisplayState.dirty = 1
            Win_BlitAll()
            cyc = Add(cyc, 1)
        }
        PrintMessage("[STEP 23g] PASS — 5 cycles no crash\n")

        // ================================================================
        // IPC BROKER TEST
        // ================================================================
        PrintMessage("\n[TEST] === IPC BROKER TEST ===\n")

        // ── STEP 24: Verify broker is listening ──────────────────────
        PrintMessage("[STEP 24] Verify broker initialized\n")
        IfCondition EqualTo(IPCBrokerState.initialized, 1) ThenBlock: {
            IfCondition GreaterThan(IPCBrokerState.listen_fd, 0) ThenBlock: {
                PrintMessage("[STEP 24] PASS — broker fd=")
                PrintNumber(IPCBrokerState.listen_fd)
                PrintMessage(" clients=")
                PrintNumber(IPCBrokerState.client_count)
                PrintMessage("\n")
            } ElseBlock: {
                PrintMessage("[STEP 24] FAIL — listen_fd <= 0\n")
            }
        } ElseBlock: {
            PrintMessage("[STEP 24] FAIL — broker not initialized\n")
        }

        // ── STEP 25: Connect test client to broker ───────────────────
        PrintMessage("[STEP 25] Connect test client to broker\n")
        test_sock = Socket.Create(1, 1)
        IfCondition LessThan(test_sock, 0) ThenBlock: {
            PrintMessage("[STEP 25] FAIL — socket create\n")
        } ElseBlock: {
            tc_res = Socket.ConnectUnix(test_sock, "/tmp/ailang_display.sock")
            IfCondition LessThan(tc_res, 0) ThenBlock: {
                PrintMessage("[STEP 25] FAIL — connect\n")
                Socket.Close(test_sock)
            } ElseBlock: {
                PrintMessage("[STEP 25] PASS — connected fd=")
                PrintNumber(test_sock)
                PrintMessage("\n")

                // ── STEP 26: Poll to accept the client ───────────────────
                PrintMessage("[STEP 26] IPCBroker_Poll to accept client\n")
                ipc_n = IPCBroker_Poll()
                PrintMessage("[STEP 26] poll returned ")
                PrintNumber(ipc_n)
                PrintMessage(" clients=")
                PrintNumber(IPCBrokerState.client_count)
                PrintMessage("\n")
                IfCondition EqualTo(IPCBrokerState.client_count, 1) ThenBlock: {
                    PrintMessage("[STEP 26] PASS — 1 client accepted\n")
                } ElseBlock: {
                    PrintMessage("[STEP 26] WARN — client_count=")
                    PrintNumber(IPCBrokerState.client_count)
                    PrintMessage("\n")
                }

                // ── STEP 27: Send register message ───────────────────────
                PrintMessage("[STEP 27] Send register + poll\n")
                Socket.SendMsg(test_sock, "{\"method\":\"register\",\"service\":\"test\"}")
                ipc_n2 = IPCBroker_Poll()
                PrintMessage("[STEP 27] PASS — register sent, poll=")
                PrintNumber(ipc_n2)
                PrintMessage("\n")

                // ── STEP 28: Send window.create, receive response ────────
                PrintMessage("[STEP 28] Send window.create + poll\n")
                Socket.SendMsg(test_sock, "{\"method\":\"window.create\",\"title\":\"Test\",\"w\":200,\"h\":150,\"html\":\"config/calculator.html\"}")
                ipc_n3 = IPCBroker_Poll()

                // Check if window was created
                ipc_win = IPCBroker_ClientGetWinIdx(0)
                PrintMessage("[STEP 28] poll=")
                PrintNumber(ipc_n3)
                PrintMessage(" client_win=")
                PrintNumber(ipc_win)
                PrintMessage("\n")
                IfCondition GreaterThan(ipc_win, 0) ThenBlock: {
                    PrintMessage("[STEP 28] PASS — IPC window created idx=")
                    PrintNumber(ipc_win)
                    PrintMessage("\n")

                    // Receive the window.created response
                    Socket.SetRecvTimeout(test_sock, 500)
                    resp28 = Socket.RecvMsg(test_sock)
                    IfCondition NotEqual(resp28, 0) ThenBlock: {
                        PrintMessage("[STEP 28] response: ")
                        PrintString(resp28)
                        PrintMessage("\n")
                    }
                } ElseBlock: {
                    PrintMessage("[STEP 28] FAIL — no window created\n")
                }

                // ── STEP 29: Blit with IPC window ────────────────────────
                PrintMessage("[STEP 29] Blit with IPC window + deskbar refresh\n")
                DeskbarState.needs_refresh = 1
                Deskbar_Refresh()
                SysDisplayState.dirty = 1
                Win_BlitAll()
                PrintMessage("[STEP 29] PASS — no crash\n")

                // ── STEP 30: Send window.update display ──────────────────
                PrintMessage("[STEP 30] Send window.update display=\"42\"\n")
                IfCondition GreaterThan(ipc_win, 0) ThenBlock: {
                    Socket.SendMsg(test_sock, "{\"method\":\"window.update\",\"win_id\":2,\"display\":\"42\"}")
                    ipc_n4 = IPCBroker_Poll()
                    SysDisplayState.dirty = 1
                    Win_BlitAll()
                    PrintMessage("[STEP 30] PASS — display updated, poll=")
                    PrintNumber(ipc_n4)
                    PrintMessage("\n")
                } ElseBlock: {
                    PrintMessage("[STEP 30] SKIP — no IPC window\n")
                }

                // ── STEP 31: Close IPC window, verify notification ───────
                PrintMessage("[STEP 31] Close IPC window\n")
                IfCondition GreaterThan(ipc_win, 0) ThenBlock: {
                    Win_Close(ipc_win)
                    DeskbarState.needs_refresh = 1
                    Deskbar_Refresh()
                    SysDisplayState.dirty = 1
                    Win_BlitAll()
                    PrintMessage("[STEP 31] PASS — IPC window closed\n")
                } ElseBlock: {
                    PrintMessage("[STEP 31] SKIP — no IPC window\n")
                }

                // ── STEP 32: Disconnect test client ──────────────────────
                PrintMessage("[STEP 32] Disconnect test client\n")
                Socket.Close(test_sock)
                // Poll to detect disconnection
                ipc_n5 = IPCBroker_Poll()
                PrintMessage("[STEP 32] PASS — disconnected, poll=")
                PrintNumber(ipc_n5)
                PrintMessage(" clients=")
                PrintNumber(IPCBrokerState.client_count)
                PrintMessage("\n")
            }
        }

        // ── STEP 33: Final clean blit ────────────────────────────────
        PrintMessage("[STEP 33] Final clean blit after IPC tests\n")
        SysDisplayState.dirty = 1
        Win_BlitAll()
        PrintMessage("[STEP 33] PASS\n")

        // ── STEP 34: Full calculator pipeline in-process ─────────────
        PrintMessage("\n[TEST] === CALCULATOR PIPELINE TEST ===\n")
        PrintMessage("[STEP 34] Calc_JsonHandle direct test\n")
        cr1 = Calc_JsonHandle("{\"method\":\"clear\"}", 18)
        IfCondition NotEqual(cr1, 0) ThenBlock: {
            PrintMessage("[STEP 34] clear -> ")
            PrintString(cr1)
            PrintMessage("\n")
        }
        cr2 = Calc_JsonHandle("{\"method\":\"digit\",\"value\":4}", 27)
        cr3 = Calc_JsonHandle("{\"method\":\"digit\",\"value\":2}", 27)
        IfCondition NotEqual(cr3, 0) ThenBlock: {
            PrintMessage("[STEP 34] digit 4,2 -> ")
            PrintString(cr3)
            PrintMessage("\n")
        }
        cr4 = Calc_JsonHandle("{\"method\":\"operator\",\"op\":1}", 27)
        cr5 = Calc_JsonHandle("{\"method\":\"digit\",\"value\":8}", 27)
        cr6 = Calc_JsonHandle("{\"method\":\"equals\"}", 19)
        IfCondition NotEqual(cr6, 0) ThenBlock: {
            p6 = ParseJSON(cr6)
            IfCondition NotEqual(p6, 0) ThenBlock: {
                o6 = JSON.AsObject(p6)
                d6 = JSON.GetString(o6, "display")
                cmp6 = StringCompare(d6, "50")
                IfCondition EqualTo(cmp6, 0) ThenBlock: {
                    PrintMessage("[STEP 34] PASS — 42+8=50 display=\"50\"\n")
                } ElseBlock: {
                    PrintMessage("[STEP 34] FAIL — expected \"50\" got \"")
                    PrintString(d6)
                    PrintMessage("\"\n")
                }
                JSON.Free(p6)
            }
        } ElseBlock: {
            PrintMessage("[STEP 34] FAIL — no response\n")
        }

        // ================================================================
        // ABOUT DIALOG TEST (AppHost)
        // ================================================================
        PrintMessage("\n[TEST] === ABOUT DIALOG TEST ===\n")

        // ── STEP 35: Open About dialog via AppHost ─────────────────────
        PrintMessage("[STEP 35] Open About dialog\n")
        about_win = AboutDialog_Open()
        IfCondition GreaterThan(about_win, 0) ThenBlock: {
            PrintMessage("[STEP 35] PASS — About win=")
            PrintNumber(about_win)
            PrintMessage(" total_windows=")
            PrintNumber(WinMgr.count)
            PrintMessage("\n")
        } ElseBlock: {
            PrintMessage("[STEP 35] FAIL — AboutDialog_Open returned ")
            PrintNumber(about_win)
            PrintMessage("\n")
        }

        // ── STEP 36: Blit with About dialog open ──────────────────────
        PrintMessage("[STEP 36] Blit with About dialog\n")
        DeskbarState.needs_refresh = 1
        Deskbar_Refresh()
        SysDisplayState.dirty = 1
        Win_BlitAll()
        PrintMessage("[STEP 36] PASS — no crash\n")

        // ── STEP 37: Close About dialog ───────────────────────────────
        PrintMessage("[STEP 37] Close About dialog\n")
        AboutDialog_Close()
        DeskbarState.needs_refresh = 1
        Deskbar_Refresh()
        SysDisplayState.dirty = 1
        Win_BlitAll()
        PrintMessage("[STEP 37] PASS — About closed, total_windows=")
        PrintNumber(WinMgr.count)
        PrintMessage("\n")

        // ── STEP 38: Open About again and close via EventRouter ───────
        PrintMessage("[STEP 38] About open/close cycle via EventRouter\n")
        about_win2 = AboutDialog_Open()
        IfCondition GreaterThan(about_win2, 0) ThenBlock: {
            SysDisplayState.dirty = 1
            Win_BlitAll()
            EventRouter_Push("about.close", 11, 0)
            EventRouter_Drain()
            SysDisplayState.dirty = 1
            Win_BlitAll()
            PrintMessage("[STEP 38] PASS — EventRouter about.close, total_windows=")
            PrintNumber(WinMgr.count)
            PrintMessage("\n")
        } ElseBlock: {
            PrintMessage("[STEP 38] SKIP — About did not open\n")
        }

        // ================================================================
        // FILE DIALOG TEST (AppHost)
        // ================================================================
        PrintMessage("\n[TEST] === FILE DIALOG TEST ===\n")

        // ── STEP 39: Open File dialog via AppHost ─────────────────────
        PrintMessage("[STEP 39] Open File dialog\n")
        fd_win = FileDialog_Open(0, 0, 14)
        IfCondition GreaterThan(fd_win, 0) ThenBlock: {
            PrintMessage("[STEP 39] PASS — FileDialog win=")
            PrintNumber(fd_win)
            PrintMessage(" filelist=")
            PrintNumber(FileDialogState.filelist_node)
            PrintMessage(" pathbar=")
            PrintNumber(FileDialogState.pathbar_label)
            PrintMessage(" total_windows=")
            PrintNumber(WinMgr.count)
            PrintMessage("\n")
        } ElseBlock: {
            PrintMessage("[STEP 39] FAIL — FileDialog_Open returned ")
            PrintNumber(fd_win)
            PrintMessage("\n")
        }

        // ── STEP 40: Blit with File dialog open ──────────────────────
        PrintMessage("[STEP 40] Blit with File dialog\n")
        DeskbarState.needs_refresh = 1
        Deskbar_Refresh()
        SysDisplayState.dirty = 1
        Win_BlitAll()
        PrintMessage("[STEP 40] PASS — no crash\n")

        // ── STEP 41: Close File dialog via EventRouter ────────────────
        PrintMessage("[STEP 41] Close File dialog via EventRouter\n")
        EventRouter_Push("fd.cancel", 9, 0)
        EventRouter_Drain()
        DeskbarState.needs_refresh = 1
        Deskbar_Refresh()
        SysDisplayState.dirty = 1
        Win_BlitAll()
        PrintMessage("[STEP 41] PASS — fd.cancel, total_windows=")
        PrintNumber(WinMgr.count)
        PrintMessage("\n")

        // ================================================================
        // ABOUT DIALOG — EXTENDED TESTS
        // ================================================================
        PrintMessage("\n[TEST] === ABOUT DIALOG EXTENDED ===\n")

        // ── STEP 42: Double-open guard ─────────────────────────────────
        PrintMessage("[STEP 42] About double-open guard\n")
        ab42a = AboutDialog_Open()
        ab42b = AboutDialog_Open()
        IfCondition EqualTo(ab42a, ab42b) ThenBlock: {
            PrintMessage("[STEP 42] PASS — same win=")
            PrintNumber(ab42a)
            PrintMessage(" (double-open blocked)\n")
        } ElseBlock: {
            PrintMessage("[STEP 42] FAIL — opened twice a=")
            PrintNumber(ab42a)
            PrintMessage(" b=")
            PrintNumber(ab42b)
            PrintMessage("\n")
        }
        AboutDialog_Close()
        SysDisplayState.dirty = 1
        Win_BlitAll()

        // ── STEP 43: Open About via app.about EventRouter action ───────
        PrintMessage("[STEP 43] Open About via app.about action\n")
        EventRouter_Push("app.about", 9, 0)
        EventRouter_Drain()
        IfCondition GreaterEqual(AboutDialogState.win_idx, 0) ThenBlock: {
            SysDisplayState.dirty = 1
            Win_BlitAll()
            PrintMessage("[STEP 43] PASS — app.about opened win=")
            PrintNumber(AboutDialogState.win_idx)
            PrintMessage("\n")
            // Close it
            AboutDialog_Close()
            SysDisplayState.dirty = 1
            Win_BlitAll()
        } ElseBlock: {
            PrintMessage("[STEP 43] FAIL — app.about did not open\n")
        }

        // ── STEP 44: Rapid About open/close 5 cycles ──────────────────
        PrintMessage("[STEP 44] Rapid About open/close — 5 cycles\n")
        ab_cyc = 0
        WhileLoop LessThan(ab_cyc, 5) {
            AboutDialog_Open()
            SysDisplayState.dirty = 1
            Win_BlitAll()
            AboutDialog_Close()
            SysDisplayState.dirty = 1
            Win_BlitAll()
            ab_cyc = Add(ab_cyc, 1)
        }
        PrintMessage("[STEP 44] PASS — 5 cycles, total_windows=")
        PrintNumber(WinMgr.count)
        PrintMessage("\n")

        // ================================================================
        // FILE DIALOG — EXTENDED TESTS
        // ================================================================
        PrintMessage("\n[TEST] === FILE DIALOG EXTENDED ===\n")

        // ── STEP 45: Open File dialog via app.files EventRouter ────────
        PrintMessage("[STEP 45] Open File dialog via app.files action\n")
        EventRouter_Push("app.files", 9, 0)
        EventRouter_Drain()
        IfCondition GreaterEqual(FileDialogState.win_idx, 0) ThenBlock: {
            SysDisplayState.dirty = 1
            Win_BlitAll()
            PrintMessage("[STEP 45] PASS — app.files opened win=")
            PrintNumber(FileDialogState.win_idx)
            PrintMessage(" rows=")
            PrintNumber(FileDialogState.row_count)
            PrintMessage("\n")
        } ElseBlock: {
            PrintMessage("[STEP 45] FAIL — app.files did not open\n")
        }

        // ── STEP 46: File dialog double-open guard ─────────────────────
        PrintMessage("[STEP 46] FileDialog double-open guard\n")
        fd46 = FileDialog_Open(0, 0, 14)
        IfCondition EqualTo(fd46, FileDialogState.win_idx) ThenBlock: {
            PrintMessage("[STEP 46] PASS — double-open blocked, same win=")
            PrintNumber(fd46)
            PrintMessage("\n")
        } ElseBlock: {
            PrintMessage("[STEP 46] FAIL — opened twice\n")
        }

        // ── STEP 47: fd.ok with no selection ───────────────────────────
        PrintMessage("[STEP 47] fd.ok with nothing selected\n")
        EventRouter_Push("fd.ok", 5, 0)
        EventRouter_Drain()
        // Should not close — nothing selected
        IfCondition GreaterEqual(FileDialogState.win_idx, 0) ThenBlock: {
            PrintMessage("[STEP 47] PASS — dialog still open (no selection)\n")
        } ElseBlock: {
            PrintMessage("[STEP 47] FAIL — dialog closed without selection\n")
        }

        // ── STEP 48: Close File dialog via fd.cancel ───────────────────
        PrintMessage("[STEP 48] Close via fd.cancel\n")
        EventRouter_Push("fd.cancel", 9, 0)
        EventRouter_Drain()
        DeskbarState.needs_refresh = 1
        Deskbar_Refresh()
        SysDisplayState.dirty = 1
        Win_BlitAll()
        IfCondition LessThan(FileDialogState.win_idx, 0) ThenBlock: {
            PrintMessage("[STEP 48] PASS — closed, total_windows=")
            PrintNumber(WinMgr.count)
            PrintMessage("\n")
        } ElseBlock: {
            PrintMessage("[STEP 48] FAIL — still open\n")
        }

        // ── STEP 48b: Mouse click simulation on Cancel button ──────────
        PrintMessage("[STEP 48b] Mouse click on file dialog Cancel button\n")
        FileDialog_Open(0, 0, 14)
        SysDisplayState.dirty = 1
        Win_BlitAll()

        fd48_win = FileDialogState.win_idx
        fd48_ctx = WinView_GetContentCtx(fd48_win)

        // Find Cancel button by scanning AK tree
        fd48_cancel = FD_FindCancelButton(fd48_ctx)
        PrintMessage("[STEP 48b] Cancel node=")
        PrintNumber(fd48_cancel)
        PrintMessage("\n")

        IfCondition GreaterEqual(fd48_cancel, 0) ThenBlock: {
            // Get solved position of Cancel button
            fd48_sx = AK_Get(fd48_ctx, fd48_cancel, AKF.SOLVED_X)
            fd48_sy = AK_Get(fd48_ctx, fd48_cancel, AKF.SOLVED_Y)
            fd48_sw = AK_Get(fd48_ctx, fd48_cancel, AKF.SOLVED_W)
            fd48_sh = AK_Get(fd48_ctx, fd48_cancel, AKF.SOLVED_H)
            PrintMessage("[STEP 48b] Cancel solved=")
            PrintNumber(fd48_sx)
            PrintMessage(",")
            PrintNumber(fd48_sy)
            PrintMessage(" ")
            PrintNumber(fd48_sw)
            PrintMessage("x")
            PrintNumber(fd48_sh)
            PrintMessage("\n")

            // Click center of Cancel button using content-local coords
            fd48_cx = Add(fd48_sx, Divide(fd48_sw, 2))
            fd48_cy = Add(fd48_sy, Divide(fd48_sh, 2))
            PrintMessage("[STEP 48b] Clicking at content-local=")
            PrintNumber(fd48_cx)
            PrintMessage(",")
            PrintNumber(fd48_cy)
            PrintMessage("\n")

            // Directly call AK_EventMouse with content-local coords
            AK_EventMouse(fd48_ctx, fd48_cx, fd48_cy, AKMouseEv.DOWN)
            AK_EventMouse(fd48_ctx, fd48_cx, fd48_cy, AKMouseEv.UP)
            EventRouter_Drain()

            IfCondition LessThan(FileDialogState.win_idx, 0) ThenBlock: {
                PrintMessage("[STEP 48b] PASS — Cancel click closed dialog\n")
            } ElseBlock: {
                PrintMessage("[STEP 48b] FAIL — dialog still open after click\n")

                // Now try via Win_ContentEvent to test the coord transform
                fd48_wx = Win_GetX(fd48_win)
                fd48_wy = Win_GetY(fd48_win)
                fd48_bw = DecorConfig.border_w
                fd48_tbh = WinMgr_GetToolbarH(fd48_win)
                // Screen coords = content origin + button center
                fd48_scx = Add(Add(fd48_wx, fd48_bw), fd48_cx)
                fd48_scy = Add(Add(fd48_wy, fd48_bw), fd48_cy)
                PrintMessage("[STEP 48b] Win_ContentEvent screen=")
                PrintNumber(fd48_scx)
                PrintMessage(",")
                PrintNumber(fd48_scy)
                PrintMessage(" win=")
                PrintNumber(fd48_wx)
                PrintMessage(",")
                PrintNumber(fd48_wy)
                PrintMessage(" bw=")
                PrintNumber(fd48_bw)
                PrintMessage(" tbh=")
                PrintNumber(fd48_tbh)
                PrintMessage("\n")

                Win_ContentEvent(fd48_win, fd48_scx, fd48_scy, AKMouseEv.DOWN, 0)
                Win_ContentEvent(fd48_win, fd48_scx, fd48_scy, AKMouseEv.UP, 0)
                EventRouter_Drain()

                IfCondition LessThan(FileDialogState.win_idx, 0) ThenBlock: {
                    PrintMessage("[STEP 48b] PASS — Win_ContentEvent click closed dialog\n")
                } ElseBlock: {
                    PrintMessage("[STEP 48b] FAIL — still open via Win_ContentEvent\n")
                    FD_CloseDialog()
                }
            }
        } ElseBlock: {
            PrintMessage("[STEP 48b] FAIL — Cancel button not found\n")
            FD_CloseDialog()
        }
        DeskbarState.needs_refresh = 1
        Deskbar_Refresh()
        SysDisplayState.dirty = 1
        Win_BlitAll()

        // ── STEP 48c: Win_ContentEvent click on Cancel button ──────────
        PrintMessage("[STEP 48c] Win_ContentEvent click on Cancel button\n")
        FileDialog_Open(0, 0, 14)
        SysDisplayState.dirty = 1
        Win_BlitAll()
        fd48c_win = FileDialogState.win_idx
        fd48c_ctx = WinView_GetContentCtx(fd48c_win)
        fd48c_cancel = FD_FindCancelButton(fd48c_ctx)
        IfCondition GreaterEqual(fd48c_cancel, 0) ThenBlock: {
            fd48c_sx = AK_Get(fd48c_ctx, fd48c_cancel, AKF.SOLVED_X)
            fd48c_sy = AK_Get(fd48c_ctx, fd48c_cancel, AKF.SOLVED_Y)
            fd48c_sw = AK_Get(fd48c_ctx, fd48c_cancel, AKF.SOLVED_W)
            fd48c_sh = AK_Get(fd48c_ctx, fd48c_cancel, AKF.SOLVED_H)
            fd48c_cx = Add(fd48c_sx, Divide(fd48c_sw, 2))
            fd48c_cy = Add(fd48c_sy, Divide(fd48c_sh, 2))

            // Compute screen coords from content-local (reverse of Win_ContentEvent)
            fd48c_wx = Win_GetX(fd48c_win)
            fd48c_wy = Win_GetY(fd48c_win)
            fd48c_bw = DecorConfig.border_w
            fd48c_scx = Add(Add(fd48c_wx, fd48c_bw), fd48c_cx)
            fd48c_scy = Add(Add(fd48c_wy, fd48c_bw), fd48c_cy)
            PrintMessage("[STEP 48c] screen_click=")
            PrintNumber(fd48c_scx)
            PrintMessage(",")
            PrintNumber(fd48c_scy)
            PrintMessage("\n")

            // Use Win_ContentEvent (same path as real mouse events)
            Win_ContentEvent(fd48c_win, fd48c_scx, fd48c_scy, AKMouseEv.DOWN, 0)
            Win_ContentEvent(fd48c_win, fd48c_scx, fd48c_scy, AKMouseEv.UP, 0)
            EventRouter_Drain()

            IfCondition LessThan(FileDialogState.win_idx, 0) ThenBlock: {
                PrintMessage("[STEP 48c] PASS — Win_ContentEvent click closed dialog\n")
            } ElseBlock: {
                PrintMessage("[STEP 48c] FAIL — dialog still open\n")
                FD_CloseDialog()
            }
        } ElseBlock: {
            PrintMessage("[STEP 48c] FAIL — Cancel not found\n")
            FD_CloseDialog()
        }
        DeskbarState.needs_refresh = 1
        Deskbar_Refresh()
        SysDisplayState.dirty = 1
        Win_BlitAll()

        // ── STEP 49: Rapid File dialog open/close 5 cycles ────────────
        PrintMessage("[STEP 49] Rapid FileDialog open/close — 5 cycles\n")
        fd_cyc = 0
        WhileLoop LessThan(fd_cyc, 5) {
            FileDialog_Open(0, 0, 14)
            SysDisplayState.dirty = 1
            Win_BlitAll()
            FD_CloseDialog()
            SysDisplayState.dirty = 1
            Win_BlitAll()
            fd_cyc = Add(fd_cyc, 1)
        }
        PrintMessage("[STEP 49] PASS — 5 cycles, total_windows=")
        PrintNumber(WinMgr.count)
        PrintMessage("\n")

        // ================================================================
        // COMBINED STRESS — both dialogs + windows
        // ================================================================
        PrintMessage("\n[TEST] === COMBINED DIALOG STRESS ===\n")

        // ── STEP 50: About + File dialog open simultaneously ───────────
        PrintMessage("[STEP 50] Both About + FileDialog open at once\n")
        AboutDialog_Open()
        FileDialog_Open(0, 0, 14)
        DeskbarState.needs_refresh = 1
        Deskbar_Refresh()
        SysDisplayState.dirty = 1
        Win_BlitAll()
        PrintMessage("[STEP 50] PASS — both open, total_windows=")
        PrintNumber(WinMgr.count)
        PrintMessage(" about=")
        PrintNumber(AboutDialogState.win_idx)
        PrintMessage(" fd=")
        PrintNumber(FileDialogState.win_idx)
        PrintMessage("\n")

        // ── STEP 51: Close both ────────────────────────────────────────
        PrintMessage("[STEP 51] Close both dialogs\n")
        AboutDialog_Close()
        FD_CloseDialog()
        DeskbarState.needs_refresh = 1
        Deskbar_Refresh()
        SysDisplayState.dirty = 1
        Win_BlitAll()
        PrintMessage("[STEP 51] PASS — both closed, total_windows=")
        PrintNumber(WinMgr.count)
        PrintMessage("\n")

        // ── STEP 52: Open About + File + debug overlay ─────────────────
        PrintMessage("[STEP 52] About + FileDialog + debug overlay\n")
        AboutDialog_Open()
        FileDialog_Open(0, 0, 14)
        DebugLog_Toggle()
        SysDisplayState.frame_count = Add(SysDisplayState.frame_count, 1)
        DebugLog_Render()
        SysDisplayState.dirty = 1
        Win_BlitAll()
        PrintMessage("[STEP 52] PASS — all overlays composited\n")

        // ── STEP 53: Clean up ──────────────────────────────────────────
        PrintMessage("[STEP 53] Final cleanup\n")
        DebugLog_Toggle()
        AboutDialog_Close()
        FD_CloseDialog()
        DeskbarState.needs_refresh = 1
        Deskbar_Refresh()
        SysDisplayState.dirty = 1
        Win_BlitAll()
        PrintMessage("[STEP 53] PASS — all clean, total_windows=")
        PrintNumber(WinMgr.count)
        PrintMessage("\n")

        // ================================================================
        // NOTEPAD IPC TEST — notepad as standalone IPC client
        // ================================================================
        PrintMessage("\n[TEST] === NOTEPAD IPC TEST ===\n")

        // ── STEP 54: Connect IPC client for notepad ──────────────────
        PrintMessage("[STEP 54] Connect notepad IPC client\n")
        np_sock = Socket.Create(1, 1)
        IfCondition LessThan(np_sock, 0) ThenBlock: {
            PrintMessage("[STEP 54] FAIL — socket create\n")
        } ElseBlock: {
            np_cres = Socket.ConnectUnix(np_sock, "/tmp/ailang_display.sock")
            IfCondition LessThan(np_cres, 0) ThenBlock: {
                PrintMessage("[STEP 54] FAIL — connect\n")
                Socket.Close(np_sock)
            } ElseBlock: {
                PrintMessage("[STEP 54] PASS — connected fd=")
                PrintNumber(np_sock)
                PrintMessage("\n")

                // Accept client
                IPCBroker_Poll()

                // ── STEP 55: Register notepad service ────────────────
                PrintMessage("[STEP 55] Register notepad service\n")
                Socket.SendMsg(np_sock, "{\"method\":\"register\",\"service\":\"notepad\"}")
                IPCBroker_Poll()
                PrintMessage("[STEP 55] PASS — registered\n")

                // ── STEP 56: Create notepad window via IPC ───────────
                PrintMessage("[STEP 56] Create notepad window via IPC\n")
                Socket.SendMsg(np_sock, "{\"method\":\"window.create\",\"title\":\"Notepad\",\"w\":620,\"h\":460,\"html\":\"config/notepad.html\"}")
                IPCBroker_Poll()

                np_win_idx = IPCBroker_ClientGetWinIdx(0)
                IfCondition GreaterThan(np_win_idx, 0) ThenBlock: {
                    PrintMessage("[STEP 56] PASS — notepad window created idx=")
                    PrintNumber(np_win_idx)
                    PrintMessage("\n")

                    // Receive window.created response
                    Socket.SetRecvTimeout(np_sock, 500)
                    np_resp = Socket.RecvMsg(np_sock)
                    IfCondition NotEqual(np_resp, 0) ThenBlock: {
                        PrintMessage("[STEP 56] response: ")
                        PrintString(np_resp)
                        PrintMessage("\n")
                    }
                } ElseBlock: {
                    PrintMessage("[STEP 56] FAIL — no window created\n")
                }

                // ── STEP 57: Blit with IPC notepad window ────────────
                PrintMessage("[STEP 57] Blit with IPC notepad window\n")
                DeskbarState.needs_refresh = 1
                Deskbar_Refresh()
                SysDisplayState.dirty = 1
                Win_BlitAll()
                PrintMessage("[STEP 57] PASS — no crash\n")

                // ── STEP 58: Add lines via window.addline ────────────
                PrintMessage("[STEP 58] window.addline x3\n")
                IfCondition GreaterThan(np_win_idx, 0) ThenBlock: {
                    Socket.SendMsg(np_sock, "{\"method\":\"window.addline\",\"win_id\":2,\"text\":\"IPC line 1\",\"color\":14737632}")
                    IPCBroker_Poll()
                    Socket.SendMsg(np_sock, "{\"method\":\"window.addline\",\"win_id\":2,\"text\":\"IPC line 2\",\"color\":14737632}")
                    IPCBroker_Poll()
                    Socket.SendMsg(np_sock, "{\"method\":\"window.addline\",\"win_id\":2,\"text\":\"IPC line 3\",\"color\":10526880}")
                    IPCBroker_Poll()
                    SysDisplayState.dirty = 1
                    Win_BlitAll()
                    PrintMessage("[STEP 58] PASS — 3 lines added via IPC\n")
                } ElseBlock: {
                    PrintMessage("[STEP 58] SKIP — no IPC window\n")
                }

                // ── STEP 59: Clear lines via window.clear ───────
                PrintMessage("[STEP 59] window.clear\n")
                IfCondition GreaterThan(np_win_idx, 0) ThenBlock: {
                    Socket.SendMsg(np_sock, "{\"method\":\"window.clear\",\"win_id\":2}")
                    IPCBroker_Poll()
                    SysDisplayState.dirty = 1
                    Win_BlitAll()
                    PrintMessage("[STEP 59] PASS — lines cleared via IPC\n")
                } ElseBlock: {
                    PrintMessage("[STEP 59] SKIP — no IPC window\n")
                }

                // ── STEP 60: Add lines after clear ───────────────────
                PrintMessage("[STEP 60] Add 5 lines after clear\n")
                IfCondition GreaterThan(np_win_idx, 0) ThenBlock: {
                    np_i = 0
                    WhileLoop LessThan(np_i, 5) {
                        Socket.SendMsg(np_sock, "{\"method\":\"window.addline\",\"win_id\":2,\"text\":\"After clear\",\"color\":14737632}")
                        IPCBroker_Poll()
                        np_i = Add(np_i, 1)
                    }
                    SysDisplayState.dirty = 1
                    Win_BlitAll()
                    PrintMessage("[STEP 60] PASS — 5 lines added after clear\n")
                } ElseBlock: {
                    PrintMessage("[STEP 60] SKIP — no IPC window\n")
                }

                // ── STEP 61: Close IPC notepad window ────────────────
                PrintMessage("[STEP 61] Close IPC notepad window\n")
                IfCondition GreaterThan(np_win_idx, 0) ThenBlock: {
                    Win_Close(np_win_idx)
                    DeskbarState.needs_refresh = 1
                    Deskbar_Refresh()
                    SysDisplayState.dirty = 1
                    Win_BlitAll()
                    PrintMessage("[STEP 61] PASS — notepad window closed\n")
                } ElseBlock: {
                    PrintMessage("[STEP 61] SKIP — no IPC window\n")
                }

                // ── STEP 62: Disconnect notepad IPC client ───────────
                PrintMessage("[STEP 62] Disconnect notepad IPC client\n")
                Socket.Close(np_sock)
                IPCBroker_Poll()
                PrintMessage("[STEP 62] PASS — disconnected, clients=")
                PrintNumber(IPCBrokerState.client_count)
                PrintMessage("\n")
            }
        }

        // ── STEP 63: About + FileDialog open simultaneously ──────────
        PrintMessage("[STEP 63] About + FileDialog open simultaneously\n")
        AboutDialog_Open()
        FileDialog_Open(0, 0, 14)
        DeskbarState.needs_refresh = 1
        Deskbar_Refresh()
        SysDisplayState.dirty = 1
        Win_BlitAll()
        PrintMessage("[STEP 63] PASS — both open, total_windows=")
        PrintNumber(WinMgr.count)
        PrintMessage(" about=")
        PrintNumber(AboutDialogState.win_idx)
        PrintMessage(" fd=")
        PrintNumber(FileDialogState.win_idx)
        PrintMessage("\n")

        // ── STEP 64: Close both ──────────────────────────────────────
        PrintMessage("[STEP 64] Close both dialogs\n")
        AboutDialog_Close()
        FD_CloseDialog()
        DeskbarState.needs_refresh = 1
        Deskbar_Refresh()
        SysDisplayState.dirty = 1
        Win_BlitAll()
        PrintMessage("[STEP 64] PASS — all closed, total_windows=")
        PrintNumber(WinMgr.count)
        PrintMessage("\n")

        // ── STEP 65: KeyMap init + translate ──────────────────────────
        PrintMessage("[STEP 65] KeyMap translate test\n")
        // Scancode 30 = 'a' (ASCII 97), shift → 'A' (65)
        ch_a = KeyMap_Translate(30, 0, 0)
        ch_A = KeyMap_Translate(30, 1, 0)
        ch_a_caps = KeyMap_Translate(30, 0, 1)
        IfCondition And(EqualTo(ch_a, 97), And(EqualTo(ch_A, 65), EqualTo(ch_a_caps, 65))) ThenBlock: {
            PrintMessage("[STEP 65] PASS — a=97 A=65 caps_a=65\n")
        } ElseBlock: {
            PrintMessage("[STEP 65] FAIL — a=")
            PrintNumber(ch_a)
            PrintMessage(" A=")
            PrintNumber(ch_A)
            PrintMessage(" caps=")
            PrintNumber(ch_a_caps)
            PrintMessage("\n")
        }

        // ── STEP 66: KeyMap number/symbol ───────────────────────────────
        PrintMessage("[STEP 66] KeyMap number+symbol test\n")
        ch_1 = KeyMap_Translate(2, 0, 0)
        ch_bang = KeyMap_Translate(2, 1, 0)
        ch_sp = KeyMap_Translate(57, 0, 0)
        IfCondition And(EqualTo(ch_1, 49), And(EqualTo(ch_bang, 33), EqualTo(ch_sp, 32))) ThenBlock: {
            PrintMessage("[STEP 66] PASS — 1=49 !=33 sp=32\n")
        } ElseBlock: {
            PrintMessage("[STEP 66] FAIL — 1=")
            PrintNumber(ch_1)
            PrintMessage(" !=")
            PrintNumber(ch_bang)
            PrintMessage(" sp=")
            PrintNumber(ch_sp)
            PrintMessage("\n")
        }

        // ── STEP 67: TextBuffer create + insert ─────────────────────────
        PrintMessage("[STEP 67] TextBuffer create + insert chars\n")
        tbh = TextBuf_Create()
        IfCondition GreaterEqual(tbh, 0) ThenBlock: {
            TextBuf_InsertChar(tbh, 72)
            TextBuf_InsertChar(tbh, 105)
            lptr = TextBuf_GetLine(tbh, 0)
            c0 = GetByte(lptr, 0)
            c1 = GetByte(lptr, 1)
            c2 = GetByte(lptr, 2)
            IfCondition And(EqualTo(c0, 72), And(EqualTo(c1, 105), EqualTo(c2, 0))) ThenBlock: {
                PrintMessage("[STEP 67] PASS — \"Hi\" inserted\n")
            } ElseBlock: {
                PrintMessage("[STEP 67] FAIL — got bytes ")
                PrintNumber(c0) PrintMessage(" ") PrintNumber(c1) PrintMessage(" ") PrintNumber(c2) PrintMessage("\n")
            }
        } ElseBlock: {
            PrintMessage("[STEP 67] FAIL — TextBuf_Create returned -1\n")
        }

        // ── STEP 68: TextBuffer backspace ───────────────────────────────
        PrintMessage("[STEP 68] TextBuffer backspace\n")
        TextBuf_Backspace(tbh)
        lptr2 = TextBuf_GetLine(tbh, 0)
        b0 = GetByte(lptr2, 0)
        b1 = GetByte(lptr2, 1)
        col_after = TextBuf_GetCursorCol(tbh)
        IfCondition And(EqualTo(b0, 72), And(EqualTo(b1, 0), EqualTo(col_after, 1))) ThenBlock: {
            PrintMessage("[STEP 68] PASS — \"H\" after backspace, col=1\n")
        } ElseBlock: {
            PrintMessage("[STEP 68] FAIL — b0=")
            PrintNumber(b0) PrintMessage(" b1=") PrintNumber(b1) PrintMessage(" col=") PrintNumber(col_after) PrintMessage("\n")
        }

        // ── STEP 69: TextBuffer Enter (line split) ─────────────────────
        PrintMessage("[STEP 69] TextBuffer Enter + line split\n")
        // Insert "ello" to make "Hello"
        TextBuf_InsertChar(tbh, 101)
        TextBuf_InsertChar(tbh, 108)
        TextBuf_InsertChar(tbh, 108)
        TextBuf_InsertChar(tbh, 111)
        // Move cursor to col 2 then Enter
        TextBuf_Home(tbh)
        TextBuf_MoveRight(tbh)
        TextBuf_MoveRight(tbh)
        TextBuf_Enter(tbh)
        lc = TextBuf_GetLineCount(tbh)
        crow = TextBuf_GetCursorRow(tbh)
        IfCondition And(EqualTo(lc, 2), EqualTo(crow, 1)) ThenBlock: {
            PrintMessage("[STEP 69] PASS — 2 lines after Enter, cursor row=1\n")
        } ElseBlock: {
            PrintMessage("[STEP 69] FAIL — lines=") PrintNumber(lc)
            PrintMessage(" cursor_row=") PrintNumber(crow) PrintMessage("\n")
        }

        // ── STEP 70: AK_EventKey on TEXTFIELD ─────────────────────────
        PrintMessage("[STEP 70] AK_EventKey via notepad TEXTFIELD\n")
        // The first AppHost window (notepad) should have a TEXTFIELD
        // Try routing a key event through it
        np_idx = 1
        np_ctx = WinView_GetContentCtx(np_idx)
        IfCondition GreaterThan(np_ctx, 0) ThenBlock: {
            // Find TEXTFIELD in the tree
            tf_node = AK_FindTextField(np_ctx, AK_GetTreeRoot(np_ctx))
            IfCondition GreaterEqual(tf_node, 0) ThenBlock: {
                // Send 'A' key (scancode 30, ASCII 65 shifted)
                AK_EventKey(np_ctx, 30, 65, 1)
                tf_tbh = AK_ExtraGet(np_ctx, tf_node, AKExtra.TEXTBUF_H)
                tf_line = TextBuf_GetLine(tf_tbh, 0)
                tf_c0 = GetByte(tf_line, 0)
                IfCondition EqualTo(tf_c0, 65) ThenBlock: {
                    PrintMessage("[STEP 70] PASS — 'A' inserted in TEXTFIELD\n")
                } ElseBlock: {
                    PrintMessage("[STEP 70] FAIL — expected 65 got ")
                    PrintNumber(tf_c0) PrintMessage("\n")
                }
            } ElseBlock: {
                PrintMessage("[STEP 70] SKIP — no TEXTFIELD found\n")
            }
        } ElseBlock: {
            PrintMessage("[STEP 70] SKIP — no content ctx for notepad\n")
        }

        // ── STEP 71: Blit after keyboard input ────────────────────────
        PrintMessage("[STEP 71] Blit after keyboard input\n")
        Win_BlitAll()
        PrintMessage("[STEP 71] PASS — no crash\n")

        // ── STEP 72: Canvas state table — set/get active ─────────────
        PrintMessage("[STEP 72] Canvas state table test\n")
        ca72 = Canvas_GetActive(0)
        IfCondition EqualTo(ca72, 0) ThenBlock: {
            Canvas_SetActive(0, 1)
            ca72b = Canvas_GetActive(0)
            IfCondition EqualTo(ca72b, 1) ThenBlock: {
                PrintMessage("[STEP 72] PASS — active 0→1\n")
            } ElseBlock: {
                PrintMessage("[STEP 72] FAIL — expected 1 got ")
                PrintNumber(ca72b) PrintMessage("\n")
            }
            Canvas_SetActive(0, 0)
        } ElseBlock: {
            PrintMessage("[STEP 72] FAIL — initial active should be 0\n")
        }

        // ── STEP 73: Canvas surface pointer round-trip ───────────────
        PrintMessage("[STEP 73] Canvas surface pointer test\n")
        // Allocate a fake 48-byte surface header
        fake_surf73 = Allocate(48)
        MemorySet(fake_surf73, 0, 48)
        Canvas_SetSurf(0, fake_surf73)
        Canvas_SetShmPtr(0, 12345678)
        Canvas_SetShmSize(0, 640480)
        Canvas_SetActive(0, 1)
        gs73 = Canvas_GetSurf(0)
        gp73 = Canvas_GetShmPtr(0)
        gz73 = Canvas_GetShmSize(0)
        IfCondition And(EqualTo(gs73, fake_surf73), And(EqualTo(gp73, 12345678), EqualTo(gz73, 640480))) ThenBlock: {
            PrintMessage("[STEP 73] PASS — surf/ptr/size round-trip\n")
        } ElseBlock: {
            PrintMessage("[STEP 73] FAIL — surf=") PrintNumber(gs73)
            PrintMessage(" ptr=") PrintNumber(gp73)
            PrintMessage(" size=") PrintNumber(gz73)
            PrintMessage("\n")
        }
        // Clean up
        Canvas_SetActive(0, 0)
        Canvas_SetSurf(0, 0)
        Canvas_SetShmPtr(0, 0)
        Canvas_SetShmSize(0, 0)
        Deallocate(fake_surf73, 48)

        // ── STEP 74: Canvas override blit — no crash ────────────────
        PrintMessage("[STEP 74] Canvas override blit\n")
        // Create a tiny fake canvas surface for window 0
        fake_canvas74 = Allocate(48)
        MemorySet(fake_canvas74, 0, 48)
        // Allocate a small pixel buffer (16x16 BGRA = 1024 bytes)
        fake_pix74 = Allocate(1024)
        MemorySet(fake_pix74, 0, 1024)
        // Set surface header: WIDTH@8=16, HEIGHT@16=16, PITCH@24=64, DATA@32=buf
        StoreValue(Add(fake_canvas74, 8), 16)
        StoreValue(Add(fake_canvas74, 16), 16)
        StoreValue(Add(fake_canvas74, 24), 64)
        StoreValue(Add(fake_canvas74, 32), fake_pix74)
        Canvas_SetSurf(0, fake_canvas74)
        Canvas_SetActive(0, 1)
        Win_BlitAll()
        PrintMessage("[STEP 74] PASS — canvas blit no crash\n")
        // Clean up
        Canvas_SetActive(0, 0)
        Canvas_SetSurf(0, 0)
        Deallocate(fake_pix74, 1024)
        Deallocate(fake_canvas74, 48)

        // ================================================================
        // TERMINAL IPC APP TEST — expanded exercise
        // ================================================================
        PrintMessage("\n[TEST] === TERMINAL IPC TEST ===\n")

        // ── STEP 75: Connect terminal IPC client ─────────────────────
        PrintMessage("[STEP 75] Connect terminal IPC client\n")
        tm_sock = Socket.Create(1, 1)
        IfCondition LessThan(tm_sock, 0) ThenBlock: {
            PrintMessage("[STEP 75] FAIL — socket create\n")
        } ElseBlock: {
            tm_cres = Socket.ConnectUnix(tm_sock, "/tmp/ailang_display.sock")
            IfCondition LessThan(tm_cres, 0) ThenBlock: {
                PrintMessage("[STEP 75] FAIL — connect\n")
                Socket.Close(tm_sock)
            } ElseBlock: {
                PrintMessage("[STEP 75] PASS — connected fd=")
                PrintNumber(tm_sock)
                PrintMessage("\n")

                // Accept client
                IPCBroker_Poll()

                // ── STEP 76: Register terminal service ────────────────
                PrintMessage("[STEP 76] Register terminal service\n")
                Socket.SendMsg(tm_sock, "{\"method\":\"register\",\"service\":\"terminal\"}")
                IPCBroker_Poll()
                PrintMessage("[STEP 76] PASS — registered\n")

                // ── STEP 77: Create terminal window via IPC ───────────
                PrintMessage("[STEP 77] Create terminal window via IPC\n")
                Socket.SendMsg(tm_sock, "{\"method\":\"window.create\",\"title\":\"Terminal\",\"w\":648,\"h\":408,\"html\":\"config/terminal.html\"}")
                IPCBroker_Poll()

                tm_win_idx = IPCBroker_ClientGetWinIdx(0)
                IfCondition GreaterThan(tm_win_idx, 0) ThenBlock: {
                    PrintMessage("[STEP 77] PASS — terminal window created idx=")
                    PrintNumber(tm_win_idx)
                    PrintMessage("\n")

                    // Receive window.created response
                    Socket.SetRecvTimeout(tm_sock, 500)
                    tm_resp = Socket.RecvMsg(tm_sock)
                    IfCondition NotEqual(tm_resp, 0) ThenBlock: {
                        PrintMessage("[STEP 77] response: ")
                        PrintString(tm_resp)
                        PrintMessage("\n")
                    }
                } ElseBlock: {
                    PrintMessage("[STEP 77] FAIL — no window created\n")
                }

                // ── STEP 78: Blit with terminal window ────────────────
                PrintMessage("[STEP 78] Blit with terminal window\n")
                DeskbarState.needs_refresh = 1
                Deskbar_Refresh()
                SysDisplayState.dirty = 1
                Win_BlitAll()
                PrintMessage("[STEP 78] PASS — no crash\n")

                // ── STEP 79: Canvas attach — fake shm surface ─────────
                PrintMessage("[STEP 79] Canvas attach — fake shm for terminal window\n")
                IfCondition GreaterThan(tm_win_idx, 0) ThenBlock: {
                    // Allocate a fake 640x384 canvas (80*8 x 24*16) BGRA
                    tm_canvas_w = 640
                    tm_canvas_h = 384
                    tm_canvas_sz = Multiply(Multiply(tm_canvas_w, tm_canvas_h), 4)
                    tm_canvas_pix = Allocate(tm_canvas_sz)
                    MemorySet(tm_canvas_pix, 0, tm_canvas_sz)

                    // Build surface header: WIDTH@8, HEIGHT@16, PITCH@24, DATA@32
                    tm_surf = Allocate(48)
                    MemorySet(tm_surf, 0, 48)
                    StoreValue(Add(tm_surf, 8), tm_canvas_w)
                    StoreValue(Add(tm_surf, 16), tm_canvas_h)
                    StoreValue(Add(tm_surf, 24), Multiply(tm_canvas_w, 4))
                    StoreValue(Add(tm_surf, 32), tm_canvas_pix)

                    Canvas_SetSurf(tm_win_idx, tm_surf)
                    Canvas_SetShmPtr(tm_win_idx, tm_canvas_pix)
                    Canvas_SetShmSize(tm_win_idx, tm_canvas_sz)
                    Canvas_SetActive(tm_win_idx, 1)

                    // Blit to verify canvas overlay works
                    SysDisplayState.dirty = 1
                    Win_BlitAll()
                    PrintMessage("[STEP 79] PASS — canvas attached + blit ok\n")
                } ElseBlock: {
                    PrintMessage("[STEP 79] SKIP — no terminal window\n")
                }

                // ── STEP 80: Send input.key 'a' — basic key forwarding ─
                PrintMessage("[STEP 80] Send input.key 'a' to terminal window\n")
                IfCondition GreaterThan(tm_win_idx, 0) ThenBlock: {
                    WinMgr.focused = tm_win_idx
                    // scancode 30 = 'a', shift 0
                    Win_KeyDown(30, 0)
                    SysDisplayState.dirty = 1
                    Win_BlitAll()

                    Socket.SetRecvTimeout(tm_sock, 500)
                    key_resp = Socket.RecvMsg(tm_sock)
                    IfCondition NotEqual(key_resp, 0) ThenBlock: {
                        PrintMessage("[STEP 80] PASS — key forwarded: ")
                        PrintString(key_resp)
                        PrintMessage("\n")
                    } ElseBlock: {
                        PrintMessage("[STEP 80] WARN — no key response\n")
                    }
                } ElseBlock: {
                    PrintMessage("[STEP 80] SKIP — no terminal window\n")
                }

                // ── STEP 81: Arrow keys — Up/Down/Left/Right ──────────
                PrintMessage("[STEP 81] Arrow keys to terminal window\n")
                IfCondition GreaterThan(tm_win_idx, 0) ThenBlock: {
                    WinMgr.focused = tm_win_idx
                    // Up=103, Down=108, Left=105, Right=106
                    Win_KeyDown(103, 0)
                    Win_KeyDown(108, 0)
                    Win_KeyDown(105, 0)
                    Win_KeyDown(106, 0)
                    SysDisplayState.dirty = 1
                    Win_BlitAll()

                    // Drain up to 4 key responses
                    Socket.SetRecvTimeout(tm_sock, 200)
                    ard = 0
                    WhileLoop LessThan(ard, 4) {
                        ar_resp = Socket.RecvMsg(tm_sock)
                        ard = Add(ard, 1)
                    }
                    PrintMessage("[STEP 81] PASS — 4 arrow keys sent + blit ok\n")
                } ElseBlock: {
                    PrintMessage("[STEP 81] SKIP — no terminal window\n")
                }

                // ── STEP 82: Special keys — Enter, Tab, Backspace, Escape ─
                PrintMessage("[STEP 82] Special keys — Enter/Tab/BS/Esc\n")
                IfCondition GreaterThan(tm_win_idx, 0) ThenBlock: {
                    WinMgr.focused = tm_win_idx
                    // Enter=28, Tab=15, Backspace=14, Escape=1
                    Win_KeyDown(28, 0)
                    Win_KeyDown(15, 0)
                    Win_KeyDown(14, 0)
                    Win_KeyDown(1, 0)
                    SysDisplayState.dirty = 1
                    Win_BlitAll()

                    // Drain responses
                    Socket.SetRecvTimeout(tm_sock, 200)
                    skd = 0
                    WhileLoop LessThan(skd, 4) {
                        sk_resp = Socket.RecvMsg(tm_sock)
                        skd = Add(skd, 1)
                    }
                    PrintMessage("[STEP 82] PASS — special keys sent + blit ok\n")
                } ElseBlock: {
                    PrintMessage("[STEP 82] SKIP — no terminal window\n")
                }

                // ── STEP 83: Ctrl+C key (ctrl modifier) ───────────────
                PrintMessage("[STEP 83] Ctrl+C key forwarding\n")
                IfCondition GreaterThan(tm_win_idx, 0) ThenBlock: {
                    WinMgr.focused = tm_win_idx
                    // Set ctrl modifier state, then send 'c' (scancode 46)
                    KeyMod.ctrl = 1
                    Win_KeyDown(46, 0)
                    KeyMod.ctrl = 0

                    Socket.SetRecvTimeout(tm_sock, 200)
                    ctrl_resp = Socket.RecvMsg(tm_sock)
                    IfCondition NotEqual(ctrl_resp, 0) ThenBlock: {
                        PrintMessage("[STEP 83] PASS — ctrl+c forwarded: ")
                        PrintString(ctrl_resp)
                        PrintMessage("\n")
                    } ElseBlock: {
                        PrintMessage("[STEP 83] WARN — no ctrl+c response\n")
                    }
                } ElseBlock: {
                    PrintMessage("[STEP 83] SKIP — no terminal window\n")
                }

                // ── STEP 84: Resize terminal window (grow) ────────────
                PrintMessage("[STEP 84] Resize terminal window — grow to 800x480\n")
                IfCondition GreaterThan(tm_win_idx, 0) ThenBlock: {
                    // Set up resize state for the terminal window
                    WinInputState.resize_edge = BitwiseOr(ResizeEdge.BOTTOM, ResizeEdge.RIGHT)
                    ax84 = Add(Win_GetX(tm_win_idx), Win_GetTotalW(tm_win_idx))
                    ay84 = Add(Win_GetY(tm_win_idx), Win_GetTotalH(tm_win_idx))
                    Win_StartResize(tm_win_idx, ax84, ay84)

                    // Move resize handle out to grow window
                    Win_UpdateResize(Add(ax84, 152), Add(ay84, 72))
                    Win_ApplyResize()

                    tw84 = Win_GetTotalW(tm_win_idx)
                    th84 = Win_GetTotalH(tm_win_idx)
                    PrintMessage("[STEP 84] new size w=")
                    PrintNumber(tw84)
                    PrintMessage(" h=")
                    PrintNumber(th84)
                    PrintMessage("\n")

                    // Check if window.resized was sent to IPC client
                    Socket.SetRecvTimeout(tm_sock, 500)
                    resize_resp84 = Socket.RecvMsg(tm_sock)
                    IfCondition NotEqual(resize_resp84, 0) ThenBlock: {
                        PrintMessage("[STEP 84] PASS — resize notified: ")
                        PrintString(resize_resp84)
                        PrintMessage("\n")
                    } ElseBlock: {
                        PrintMessage("[STEP 84] PASS — resized (no IPC notify expected in headless)\n")
                    }

                    // Re-attach canvas at new size and blit
                    Canvas_SetActive(tm_win_idx, 0)
                    Deallocate(tm_canvas_pix, tm_canvas_sz)
                    Deallocate(tm_surf, 48)

                    cw84 = Win_GetCanvasW(tm_win_idx)
                    ch84 = Win_GetCanvasH(tm_win_idx)
                    tm_canvas_w = cw84
                    tm_canvas_h = ch84
                    tm_canvas_sz = Multiply(Multiply(tm_canvas_w, tm_canvas_h), 4)
                    tm_canvas_pix = Allocate(tm_canvas_sz)
                    MemorySet(tm_canvas_pix, 0, tm_canvas_sz)
                    tm_surf = Allocate(48)
                    MemorySet(tm_surf, 0, 48)
                    StoreValue(Add(tm_surf, 8), tm_canvas_w)
                    StoreValue(Add(tm_surf, 16), tm_canvas_h)
                    StoreValue(Add(tm_surf, 24), Multiply(tm_canvas_w, 4))
                    StoreValue(Add(tm_surf, 32), tm_canvas_pix)
                    Canvas_SetSurf(tm_win_idx, tm_surf)
                    Canvas_SetShmPtr(tm_win_idx, tm_canvas_pix)
                    Canvas_SetShmSize(tm_win_idx, tm_canvas_sz)
                    Canvas_SetActive(tm_win_idx, 1)

                    SysDisplayState.dirty = 1
                    Win_BlitAll()
                    PrintMessage("[STEP 84] blit after grow — no crash\n")
                } ElseBlock: {
                    PrintMessage("[STEP 84] SKIP — no terminal window\n")
                }

                // ── STEP 85: Resize terminal window (shrink) ──────────
                PrintMessage("[STEP 85] Resize terminal window — shrink to 400x256\n")
                IfCondition GreaterThan(tm_win_idx, 0) ThenBlock: {
                    WinInputState.resize_edge = BitwiseOr(ResizeEdge.BOTTOM, ResizeEdge.RIGHT)
                    ax85 = Add(Win_GetX(tm_win_idx), Win_GetTotalW(tm_win_idx))
                    ay85 = Add(Win_GetY(tm_win_idx), Win_GetTotalH(tm_win_idx))
                    Win_StartResize(tm_win_idx, ax85, ay85)

                    // Shrink by moving resize handle inward
                    Win_UpdateResize(Subtract(ax85, 400), Subtract(ay85, 224))
                    Win_ApplyResize()

                    tw85 = Win_GetTotalW(tm_win_idx)
                    th85 = Win_GetTotalH(tm_win_idx)
                    PrintMessage("[STEP 85] new size w=")
                    PrintNumber(tw85)
                    PrintMessage(" h=")
                    PrintNumber(th85)
                    PrintMessage("\n")

                    // Drain any resize notification
                    Socket.SetRecvTimeout(tm_sock, 200)
                    resize_resp85 = Socket.RecvMsg(tm_sock)

                    // Re-attach canvas at shrunk size
                    Canvas_SetActive(tm_win_idx, 0)
                    Deallocate(tm_canvas_pix, tm_canvas_sz)
                    Deallocate(tm_surf, 48)

                    cw85 = Win_GetCanvasW(tm_win_idx)
                    ch85 = Win_GetCanvasH(tm_win_idx)
                    tm_canvas_w = cw85
                    tm_canvas_h = ch85
                    tm_canvas_sz = Multiply(Multiply(tm_canvas_w, tm_canvas_h), 4)
                    tm_canvas_pix = Allocate(tm_canvas_sz)
                    MemorySet(tm_canvas_pix, 0, tm_canvas_sz)
                    tm_surf = Allocate(48)
                    MemorySet(tm_surf, 0, 48)
                    StoreValue(Add(tm_surf, 8), tm_canvas_w)
                    StoreValue(Add(tm_surf, 16), tm_canvas_h)
                    StoreValue(Add(tm_surf, 24), Multiply(tm_canvas_w, 4))
                    StoreValue(Add(tm_surf, 32), tm_canvas_pix)
                    Canvas_SetSurf(tm_win_idx, tm_surf)
                    Canvas_SetShmPtr(tm_win_idx, tm_canvas_pix)
                    Canvas_SetShmSize(tm_win_idx, tm_canvas_sz)
                    Canvas_SetActive(tm_win_idx, 1)

                    SysDisplayState.dirty = 1
                    Win_BlitAll()
                    PrintMessage("[STEP 85] PASS — blit after shrink, no crash\n")
                } ElseBlock: {
                    PrintMessage("[STEP 85] SKIP — no terminal window\n")
                }

                // ── STEP 86: Key after resize — verify routing still works ─
                PrintMessage("[STEP 86] Key after resize — verify routing\n")
                IfCondition GreaterThan(tm_win_idx, 0) ThenBlock: {
                    WinMgr.focused = tm_win_idx
                    // Send 'l' (scancode 38), 's' (scancode 31)
                    Win_KeyDown(38, 0)
                    Win_KeyDown(31, 0)
                    SysDisplayState.dirty = 1
                    Win_BlitAll()

                    Socket.SetRecvTimeout(tm_sock, 200)
                    kr86a = Socket.RecvMsg(tm_sock)
                    kr86b = Socket.RecvMsg(tm_sock)
                    IfCondition NotEqual(kr86a, 0) ThenBlock: {
                        PrintMessage("[STEP 86] PASS — keys after resize forwarded ok\n")
                    } ElseBlock: {
                        PrintMessage("[STEP 86] WARN — no key response after resize\n")
                    }
                } ElseBlock: {
                    PrintMessage("[STEP 86] SKIP — no terminal window\n")
                }

                // ── STEP 87: Rapid key burst — 20 keys, no crash ──────
                PrintMessage("[STEP 87] Rapid 20-key burst to terminal\n")
                IfCondition GreaterThan(tm_win_idx, 0) ThenBlock: {
                    WinMgr.focused = tm_win_idx
                    burst = 0
                    // Send 20 alpha keys (scancodes 16-35 = q,w,e,r,t,y,u,i,o,p,a,s,d,f,g,h,j,k,l,;)
                    WhileLoop LessThan(burst, 20) {
                        Win_KeyDown(Add(16, burst), 0)
                        burst = Add(burst, 1)
                    }
                    SysDisplayState.dirty = 1
                    Win_BlitAll()

                    // Drain all 20 responses
                    Socket.SetRecvTimeout(tm_sock, 200)
                    drained87 = 0
                    WhileLoop LessThan(drained87, 20) {
                        d87_resp = Socket.RecvMsg(tm_sock)
                        drained87 = Add(drained87, 1)
                    }
                    PrintMessage("[STEP 87] PASS — 20-key burst + blit ok\n")
                } ElseBlock: {
                    PrintMessage("[STEP 87] SKIP — no terminal window\n")
                }

                // ── STEP 88: PageUp/PageDown keys ─────────────────────
                PrintMessage("[STEP 88] PageUp + PageDown keys\n")
                IfCondition GreaterThan(tm_win_idx, 0) ThenBlock: {
                    WinMgr.focused = tm_win_idx
                    // PageUp=104, PageDown=109
                    Win_KeyDown(104, 0)
                    Win_KeyDown(109, 0)
                    SysDisplayState.dirty = 1
                    Win_BlitAll()

                    Socket.SetRecvTimeout(tm_sock, 200)
                    pg_resp1 = Socket.RecvMsg(tm_sock)
                    pg_resp2 = Socket.RecvMsg(tm_sock)
                    PrintMessage("[STEP 88] PASS — PageUp/Down sent + blit ok\n")
                } ElseBlock: {
                    PrintMessage("[STEP 88] SKIP — no terminal window\n")
                }

                // ── STEP 89: Home/End/Delete keys ─────────────────────
                PrintMessage("[STEP 89] Home + End + Delete keys\n")
                IfCondition GreaterThan(tm_win_idx, 0) ThenBlock: {
                    WinMgr.focused = tm_win_idx
                    // Home=102, End=107, Delete=111
                    Win_KeyDown(102, 0)
                    Win_KeyDown(107, 0)
                    Win_KeyDown(111, 0)
                    SysDisplayState.dirty = 1
                    Win_BlitAll()

                    Socket.SetRecvTimeout(tm_sock, 200)
                    he_d1 = Socket.RecvMsg(tm_sock)
                    he_d2 = Socket.RecvMsg(tm_sock)
                    he_d3 = Socket.RecvMsg(tm_sock)
                    PrintMessage("[STEP 89] PASS — Home/End/Delete sent + blit ok\n")
                } ElseBlock: {
                    PrintMessage("[STEP 89] SKIP — no terminal window\n")
                }

                // ── STEP 90: Shift+key (shifted letter) ───────────────
                PrintMessage("[STEP 90] Shift+key (uppercase letter)\n")
                IfCondition GreaterThan(tm_win_idx, 0) ThenBlock: {
                    WinMgr.focused = tm_win_idx
                    // 'a' with shift=1 → scancode 30
                    Win_KeyDown(30, 1)
                    SysDisplayState.dirty = 1
                    Win_BlitAll()

                    Socket.SetRecvTimeout(tm_sock, 200)
                    sh_resp = Socket.RecvMsg(tm_sock)
                    IfCondition NotEqual(sh_resp, 0) ThenBlock: {
                        PrintMessage("[STEP 90] PASS — shifted key forwarded: ")
                        PrintString(sh_resp)
                        PrintMessage("\n")
                    } ElseBlock: {
                        PrintMessage("[STEP 90] WARN — no shifted key response\n")
                    }
                } ElseBlock: {
                    PrintMessage("[STEP 90] SKIP — no terminal window\n")
                }

                // ── STEP 91: Canvas detach + clean blit ───────────────
                PrintMessage("[STEP 91] Canvas detach from terminal window\n")
                IfCondition GreaterThan(tm_win_idx, 0) ThenBlock: {
                    Canvas_SetActive(tm_win_idx, 0)
                    Canvas_SetSurf(tm_win_idx, 0)
                    Canvas_SetShmPtr(tm_win_idx, 0)
                    Canvas_SetShmSize(tm_win_idx, 0)
                    Deallocate(tm_canvas_pix, tm_canvas_sz)
                    Deallocate(tm_surf, 48)

                    SysDisplayState.dirty = 1
                    Win_BlitAll()
                    PrintMessage("[STEP 91] PASS — canvas detached + blit ok\n")
                } ElseBlock: {
                    PrintMessage("[STEP 91] SKIP — no terminal window\n")
                }

                // ── STEP 92: Close terminal window ────────────────────
                PrintMessage("[STEP 92] Close terminal window\n")
                IfCondition GreaterThan(tm_win_idx, 0) ThenBlock: {
                    Win_Close(tm_win_idx)
                    DeskbarState.needs_refresh = 1
                    Deskbar_Refresh()
                    SysDisplayState.dirty = 1
                    Win_BlitAll()
                    PrintMessage("[STEP 92] PASS — terminal window closed\n")
                } ElseBlock: {
                    PrintMessage("[STEP 92] SKIP — no terminal window\n")
                }

                // ── STEP 93: Disconnect terminal IPC client ───────────
                PrintMessage("[STEP 93] Disconnect terminal IPC client\n")
                Socket.Close(tm_sock)
                IPCBroker_Poll()
                PrintMessage("[STEP 93] PASS — disconnected, clients=")
                PrintNumber(IPCBrokerState.client_count)
                PrintMessage("\n")
            }
        }

        // ── Final blit ────────────────────────────────────────────────
        PrintMessage("[STEP 94] Final clean blit after terminal tests\n")
        SysDisplayState.dirty = 1
        Win_BlitAll()
        PrintMessage("[STEP 94] PASS\n")

        // ================================================================
        // CHROME IPC APP TEST — sandboxed browser window exercise
        // ================================================================
        PrintMessage("\n[TEST] === CHROME IPC TEST ===\n")

        // ── STEP 95: Connect Chrome IPC client ────────────────────────
        PrintMessage("[STEP 95] Connect Chrome IPC client\n")
        cr_sock = Socket.Create(1, 1)
        IfCondition LessThan(cr_sock, 0) ThenBlock: {
            PrintMessage("[STEP 95] FAIL — socket create\n")
        } ElseBlock: {
            cr_cres = Socket.ConnectUnix(cr_sock, "/tmp/ailang_display.sock")
            IfCondition LessThan(cr_cres, 0) ThenBlock: {
                PrintMessage("[STEP 95] FAIL — connect\n")
                Socket.Close(cr_sock)
            } ElseBlock: {
                PrintMessage("[STEP 95] PASS — connected fd=")
                PrintNumber(cr_sock)
                PrintMessage("\n")

                // Accept client
                IPCBroker_Poll()

                // ── STEP 96: Register Chrome service ────────────────────
                PrintMessage("[STEP 96] Register Chrome service\n")
                Socket.SendMsg(cr_sock, "{\"method\":\"register\",\"service\":\"chrome\"}")
                IPCBroker_Poll()
                PrintMessage("[STEP 96] PASS — registered\n")

                // ── STEP 97: Create Chrome window via IPC ───────────────
                PrintMessage("[STEP 97] Create Chrome window via IPC\n")
                Socket.SendMsg(cr_sock, "{\"method\":\"window.create\",\"title\":\"Chrome\",\"w\":1024,\"h\":700,\"html\":\"config/chrome.html\"}")
                IPCBroker_Poll()

                cr_win_idx = IPCBroker_ClientGetWinIdx(0)
                IfCondition GreaterThan(cr_win_idx, 0) ThenBlock: {
                    PrintMessage("[STEP 97] PASS — Chrome window created idx=")
                    PrintNumber(cr_win_idx)
                    PrintMessage("\n")

                    // Receive window.created response
                    Socket.SetRecvTimeout(cr_sock, 500)
                    cr_resp = Socket.RecvMsg(cr_sock)
                    IfCondition NotEqual(cr_resp, 0) ThenBlock: {
                        PrintMessage("[STEP 97] response: ")
                        PrintString(cr_resp)
                        PrintMessage("\n")
                    }
                } ElseBlock: {
                    PrintMessage("[STEP 97] FAIL — no window created\n")
                }

                // ── STEP 98: Blit with Chrome window ────────────────────
                PrintMessage("[STEP 98] Blit with Chrome window\n")
                DeskbarState.needs_refresh = 1
                Deskbar_Refresh()
                SysDisplayState.dirty = 1
                Win_BlitAll()
                PrintMessage("[STEP 98] PASS — no crash\n")

                // ── STEP 99: Canvas attach — fake shm surface ───────────
                PrintMessage("[STEP 99] Canvas attach — fake shm for Chrome window\n")
                IfCondition GreaterThan(cr_win_idx, 0) ThenBlock: {
                    // Allocate a fake 1024x700 canvas BGRA
                    cr_canvas_w = 1024
                    cr_canvas_h = 700
                    cr_canvas_sz = Multiply(Multiply(cr_canvas_w, cr_canvas_h), 4)
                    cr_canvas_pix = Allocate(cr_canvas_sz)
                    MemorySet(cr_canvas_pix, 0, cr_canvas_sz)

                    // Build surface header: WIDTH@8, HEIGHT@16, PITCH@24, DATA@32
                    cr_surf = Allocate(48)
                    MemorySet(cr_surf, 0, 48)
                    StoreValue(Add(cr_surf, 8), cr_canvas_w)
                    StoreValue(Add(cr_surf, 16), cr_canvas_h)
                    StoreValue(Add(cr_surf, 24), Multiply(cr_canvas_w, 4))
                    StoreValue(Add(cr_surf, 32), cr_canvas_pix)

                    Canvas_SetSurf(cr_win_idx, cr_surf)
                    Canvas_SetShmPtr(cr_win_idx, cr_canvas_pix)
                    Canvas_SetShmSize(cr_win_idx, cr_canvas_sz)
                    Canvas_SetActive(cr_win_idx, 1)
                    Canvas_SetMouseCapture(cr_win_idx, 1)

                    // Blit to verify canvas overlay works
                    SysDisplayState.dirty = 1
                    Win_BlitAll()
                    PrintMessage("[STEP 99] PASS — canvas attached + blit ok (mouse capture)\n")
                } ElseBlock: {
                    PrintMessage("[STEP 99] SKIP — no Chrome window\n")
                }

                // ── STEP 100: Toolbar action — c.back ───────────────────
                PrintMessage("[STEP 100] Toolbar action c.back\n")
                IfCondition GreaterThan(cr_win_idx, 0) ThenBlock: {
                    WinMgr.focused = cr_win_idx
                    EventRouter_Push("c.back", 6, cr_win_idx)
                    EventRouter_Drain()
                    SysDisplayState.dirty = 1
                    Win_BlitAll()

                    // Drain any action forwarded to IPC client
                    Socket.SetRecvTimeout(cr_sock, 200)
                    cb_resp = Socket.RecvMsg(cr_sock)
                    IfCondition NotEqual(cb_resp, 0) ThenBlock: {
                        PrintMessage("[STEP 100] PASS — c.back forwarded: ")
                        PrintString(cb_resp)
                        PrintMessage("\n")
                    } ElseBlock: {
                        PrintMessage("[STEP 100] PASS — c.back dispatched (no IPC echo expected)\n")
                    }
                } ElseBlock: {
                    PrintMessage("[STEP 100] SKIP — no Chrome window\n")
                }

                // ── STEP 101: Toolbar action — c.fwd ────────────────────
                PrintMessage("[STEP 101] Toolbar action c.fwd\n")
                IfCondition GreaterThan(cr_win_idx, 0) ThenBlock: {
                    EventRouter_Push("c.fwd", 5, cr_win_idx)
                    EventRouter_Drain()
                    SysDisplayState.dirty = 1
                    Win_BlitAll()

                    Socket.SetRecvTimeout(cr_sock, 200)
                    cf_resp = Socket.RecvMsg(cr_sock)
                    IfCondition NotEqual(cf_resp, 0) ThenBlock: {
                        PrintMessage("[STEP 101] PASS — c.fwd forwarded: ")
                        PrintString(cf_resp)
                        PrintMessage("\n")
                    } ElseBlock: {
                        PrintMessage("[STEP 101] PASS — c.fwd dispatched\n")
                    }
                } ElseBlock: {
                    PrintMessage("[STEP 101] SKIP — no Chrome window\n")
                }

                // ── STEP 102: Toolbar action — c.reload ─────────────────
                PrintMessage("[STEP 102] Toolbar action c.reload\n")
                IfCondition GreaterThan(cr_win_idx, 0) ThenBlock: {
                    EventRouter_Push("c.reload", 8, cr_win_idx)
                    EventRouter_Drain()
                    SysDisplayState.dirty = 1
                    Win_BlitAll()

                    Socket.SetRecvTimeout(cr_sock, 200)
                    crl_resp = Socket.RecvMsg(cr_sock)
                    IfCondition NotEqual(crl_resp, 0) ThenBlock: {
                        PrintMessage("[STEP 102] PASS — c.reload forwarded: ")
                        PrintString(crl_resp)
                        PrintMessage("\n")
                    } ElseBlock: {
                        PrintMessage("[STEP 102] PASS — c.reload dispatched\n")
                    }
                } ElseBlock: {
                    PrintMessage("[STEP 102] SKIP — no Chrome window\n")
                }

                // ── STEP 103: Send input.key 'a' — basic key forwarding ─
                PrintMessage("[STEP 103] Send input.key 'a' to Chrome window\n")
                IfCondition GreaterThan(cr_win_idx, 0) ThenBlock: {
                    WinMgr.focused = cr_win_idx
                    Win_KeyDown(30, 0)
                    SysDisplayState.dirty = 1
                    Win_BlitAll()

                    Socket.SetRecvTimeout(cr_sock, 500)
                    ck_resp = Socket.RecvMsg(cr_sock)
                    IfCondition NotEqual(ck_resp, 0) ThenBlock: {
                        PrintMessage("[STEP 103] PASS — key forwarded: ")
                        PrintString(ck_resp)
                        PrintMessage("\n")
                    } ElseBlock: {
                        PrintMessage("[STEP 103] WARN — no key response\n")
                    }
                } ElseBlock: {
                    PrintMessage("[STEP 103] SKIP — no Chrome window\n")
                }

                // ── STEP 104: Arrow keys — Up/Down/Left/Right ───────────
                PrintMessage("[STEP 104] Arrow keys to Chrome window\n")
                IfCondition GreaterThan(cr_win_idx, 0) ThenBlock: {
                    WinMgr.focused = cr_win_idx
                    Win_KeyDown(103, 0)
                    Win_KeyDown(108, 0)
                    Win_KeyDown(105, 0)
                    Win_KeyDown(106, 0)
                    SysDisplayState.dirty = 1
                    Win_BlitAll()

                    Socket.SetRecvTimeout(cr_sock, 200)
                    cr_ar = 0
                    WhileLoop LessThan(cr_ar, 4) {
                        cr_ar_resp = Socket.RecvMsg(cr_sock)
                        cr_ar = Add(cr_ar, 1)
                    }
                    PrintMessage("[STEP 104] PASS — 4 arrow keys sent + blit ok\n")
                } ElseBlock: {
                    PrintMessage("[STEP 104] SKIP — no Chrome window\n")
                }

                // ── STEP 105: Special keys — Enter/Tab/BS/Esc/Space ─────
                PrintMessage("[STEP 105] Special keys — Enter/Tab/BS/Esc/Space\n")
                IfCondition GreaterThan(cr_win_idx, 0) ThenBlock: {
                    WinMgr.focused = cr_win_idx
                    Win_KeyDown(28, 0)
                    Win_KeyDown(15, 0)
                    Win_KeyDown(14, 0)
                    Win_KeyDown(1, 0)
                    Win_KeyDown(57, 0)
                    SysDisplayState.dirty = 1
                    Win_BlitAll()

                    Socket.SetRecvTimeout(cr_sock, 200)
                    cr_sk = 0
                    WhileLoop LessThan(cr_sk, 5) {
                        cr_sk_resp = Socket.RecvMsg(cr_sock)
                        cr_sk = Add(cr_sk, 1)
                    }
                    PrintMessage("[STEP 105] PASS — 5 special keys sent + blit ok\n")
                } ElseBlock: {
                    PrintMessage("[STEP 105] SKIP — no Chrome window\n")
                }

                // ── STEP 106: Ctrl+L key (URL bar focus) ────────────────
                PrintMessage("[STEP 106] Ctrl+L key — URL bar focus\n")
                IfCondition GreaterThan(cr_win_idx, 0) ThenBlock: {
                    WinMgr.focused = cr_win_idx
                    KeyMod.ctrl = 1
                    Win_KeyDown(38, 0)
                    KeyMod.ctrl = 0

                    Socket.SetRecvTimeout(cr_sock, 200)
                    cl_resp = Socket.RecvMsg(cr_sock)
                    IfCondition NotEqual(cl_resp, 0) ThenBlock: {
                        PrintMessage("[STEP 106] PASS — Ctrl+L forwarded: ")
                        PrintString(cl_resp)
                        PrintMessage("\n")
                    } ElseBlock: {
                        PrintMessage("[STEP 106] WARN — no Ctrl+L response\n")
                    }
                } ElseBlock: {
                    PrintMessage("[STEP 106] SKIP — no Chrome window\n")
                }

                // ── STEP 107: Ctrl+R key (reload) ───────────────────────
                PrintMessage("[STEP 107] Ctrl+R key — reload\n")
                IfCondition GreaterThan(cr_win_idx, 0) ThenBlock: {
                    WinMgr.focused = cr_win_idx
                    KeyMod.ctrl = 1
                    Win_KeyDown(19, 0)
                    KeyMod.ctrl = 0
                    SysDisplayState.dirty = 1
                    Win_BlitAll()

                    Socket.SetRecvTimeout(cr_sock, 200)
                    crr_resp = Socket.RecvMsg(cr_sock)
                    IfCondition NotEqual(crr_resp, 0) ThenBlock: {
                        PrintMessage("[STEP 107] PASS — Ctrl+R forwarded: ")
                        PrintString(crr_resp)
                        PrintMessage("\n")
                    } ElseBlock: {
                        PrintMessage("[STEP 107] WARN — no Ctrl+R response\n")
                    }
                } ElseBlock: {
                    PrintMessage("[STEP 107] SKIP — no Chrome window\n")
                }

                // ── STEP 108: PageUp/PageDown/Home/End/Delete/F5 keys ───
                PrintMessage("[STEP 108] Nav keys — PgUp/PgDn/Home/End/Del/F5\n")
                IfCondition GreaterThan(cr_win_idx, 0) ThenBlock: {
                    WinMgr.focused = cr_win_idx
                    Win_KeyDown(104, 0)
                    Win_KeyDown(109, 0)
                    Win_KeyDown(102, 0)
                    Win_KeyDown(107, 0)
                    Win_KeyDown(111, 0)
                    Win_KeyDown(63, 0)
                    SysDisplayState.dirty = 1
                    Win_BlitAll()

                    Socket.SetRecvTimeout(cr_sock, 200)
                    cr_nav = 0
                    WhileLoop LessThan(cr_nav, 6) {
                        cr_nav_resp = Socket.RecvMsg(cr_sock)
                        cr_nav = Add(cr_nav, 1)
                    }
                    PrintMessage("[STEP 108] PASS — 6 nav keys sent + blit ok\n")
                } ElseBlock: {
                    PrintMessage("[STEP 108] SKIP — no Chrome window\n")
                }

                // ── STEP 109: Resize Chrome window — grow ───────────────
                PrintMessage("[STEP 109] Resize Chrome window — grow\n")
                IfCondition GreaterThan(cr_win_idx, 0) ThenBlock: {
                    WinInputState.resize_edge = BitwiseOr(ResizeEdge.BOTTOM, ResizeEdge.RIGHT)
                    ax109 = Add(Win_GetX(cr_win_idx), Win_GetTotalW(cr_win_idx))
                    ay109 = Add(Win_GetY(cr_win_idx), Win_GetTotalH(cr_win_idx))
                    Win_StartResize(cr_win_idx, ax109, ay109)

                    Win_UpdateResize(Add(ax109, 100), Add(ay109, 60))
                    Win_ApplyResize()

                    tw109 = Win_GetTotalW(cr_win_idx)
                    th109 = Win_GetTotalH(cr_win_idx)
                    PrintMessage("[STEP 109] new size w=")
                    PrintNumber(tw109)
                    PrintMessage(" h=")
                    PrintNumber(th109)
                    PrintMessage("\n")

                    // Drain resize notification
                    Socket.SetRecvTimeout(cr_sock, 500)
                    cr_resize_resp = Socket.RecvMsg(cr_sock)
                    IfCondition NotEqual(cr_resize_resp, 0) ThenBlock: {
                        PrintMessage("[STEP 109] resize notified: ")
                        PrintString(cr_resize_resp)
                        PrintMessage("\n")
                    }

                    // Re-attach canvas at new size
                    Canvas_SetActive(cr_win_idx, 0)
                    Deallocate(cr_canvas_pix, cr_canvas_sz)
                    Deallocate(cr_surf, 48)

                    cw109 = Win_GetCanvasW(cr_win_idx)
                    ch109 = Win_GetCanvasH(cr_win_idx)
                    cr_canvas_w = cw109
                    cr_canvas_h = ch109
                    cr_canvas_sz = Multiply(Multiply(cr_canvas_w, cr_canvas_h), 4)
                    cr_canvas_pix = Allocate(cr_canvas_sz)
                    MemorySet(cr_canvas_pix, 0, cr_canvas_sz)
                    cr_surf = Allocate(48)
                    MemorySet(cr_surf, 0, 48)
                    StoreValue(Add(cr_surf, 8), cr_canvas_w)
                    StoreValue(Add(cr_surf, 16), cr_canvas_h)
                    StoreValue(Add(cr_surf, 24), Multiply(cr_canvas_w, 4))
                    StoreValue(Add(cr_surf, 32), cr_canvas_pix)
                    Canvas_SetSurf(cr_win_idx, cr_surf)
                    Canvas_SetShmPtr(cr_win_idx, cr_canvas_pix)
                    Canvas_SetShmSize(cr_win_idx, cr_canvas_sz)
                    Canvas_SetActive(cr_win_idx, 1)
                    Canvas_SetMouseCapture(cr_win_idx, 1)

                    SysDisplayState.dirty = 1
                    Win_BlitAll()
                    PrintMessage("[STEP 109] PASS — blit after grow, no crash\n")
                } ElseBlock: {
                    PrintMessage("[STEP 109] SKIP — no Chrome window\n")
                }

                // ── STEP 110: Resize Chrome window — shrink ─────────────
                PrintMessage("[STEP 110] Resize Chrome window — shrink\n")
                IfCondition GreaterThan(cr_win_idx, 0) ThenBlock: {
                    WinInputState.resize_edge = BitwiseOr(ResizeEdge.BOTTOM, ResizeEdge.RIGHT)
                    ax110 = Add(Win_GetX(cr_win_idx), Win_GetTotalW(cr_win_idx))
                    ay110 = Add(Win_GetY(cr_win_idx), Win_GetTotalH(cr_win_idx))
                    Win_StartResize(cr_win_idx, ax110, ay110)

                    Win_UpdateResize(Subtract(ax110, 400), Subtract(ay110, 300))
                    Win_ApplyResize()

                    tw110 = Win_GetTotalW(cr_win_idx)
                    th110 = Win_GetTotalH(cr_win_idx)
                    PrintMessage("[STEP 110] new size w=")
                    PrintNumber(tw110)
                    PrintMessage(" h=")
                    PrintNumber(th110)
                    PrintMessage("\n")

                    // Drain resize notification
                    Socket.SetRecvTimeout(cr_sock, 200)
                    cr_resize_resp2 = Socket.RecvMsg(cr_sock)

                    // Re-attach canvas at shrunk size
                    Canvas_SetActive(cr_win_idx, 0)
                    Deallocate(cr_canvas_pix, cr_canvas_sz)
                    Deallocate(cr_surf, 48)

                    cw110 = Win_GetCanvasW(cr_win_idx)
                    ch110 = Win_GetCanvasH(cr_win_idx)
                    cr_canvas_w = cw110
                    cr_canvas_h = ch110
                    cr_canvas_sz = Multiply(Multiply(cr_canvas_w, cr_canvas_h), 4)
                    cr_canvas_pix = Allocate(cr_canvas_sz)
                    MemorySet(cr_canvas_pix, 0, cr_canvas_sz)
                    cr_surf = Allocate(48)
                    MemorySet(cr_surf, 0, 48)
                    StoreValue(Add(cr_surf, 8), cr_canvas_w)
                    StoreValue(Add(cr_surf, 16), cr_canvas_h)
                    StoreValue(Add(cr_surf, 24), Multiply(cr_canvas_w, 4))
                    StoreValue(Add(cr_surf, 32), cr_canvas_pix)
                    Canvas_SetSurf(cr_win_idx, cr_surf)
                    Canvas_SetShmPtr(cr_win_idx, cr_canvas_pix)
                    Canvas_SetShmSize(cr_win_idx, cr_canvas_sz)
                    Canvas_SetActive(cr_win_idx, 1)
                    Canvas_SetMouseCapture(cr_win_idx, 1)

                    SysDisplayState.dirty = 1
                    Win_BlitAll()
                    PrintMessage("[STEP 110] PASS — blit after shrink, no crash\n")
                } ElseBlock: {
                    PrintMessage("[STEP 110] SKIP — no Chrome window\n")
                }

                // ── STEP 111: Key after resize — verify routing still works
                PrintMessage("[STEP 111] Key after resize — verify routing\n")
                IfCondition GreaterThan(cr_win_idx, 0) ThenBlock: {
                    WinMgr.focused = cr_win_idx
                    Win_KeyDown(38, 0)
                    Win_KeyDown(31, 0)
                    Win_KeyDown(28, 0)
                    SysDisplayState.dirty = 1
                    Win_BlitAll()

                    Socket.SetRecvTimeout(cr_sock, 200)
                    ckr111a = Socket.RecvMsg(cr_sock)
                    ckr111b = Socket.RecvMsg(cr_sock)
                    ckr111c = Socket.RecvMsg(cr_sock)
                    IfCondition NotEqual(ckr111a, 0) ThenBlock: {
                        PrintMessage("[STEP 111] PASS — keys after resize forwarded ok\n")
                    } ElseBlock: {
                        PrintMessage("[STEP 111] WARN — no key response after resize\n")
                    }
                } ElseBlock: {
                    PrintMessage("[STEP 111] SKIP — no Chrome window\n")
                }

                // ── STEP 112: Rapid 30-key burst to Chrome ──────────────
                PrintMessage("[STEP 112] Rapid 30-key burst to Chrome\n")
                IfCondition GreaterThan(cr_win_idx, 0) ThenBlock: {
                    WinMgr.focused = cr_win_idx
                    cr_burst = 0
                    WhileLoop LessThan(cr_burst, 30) {
                        Win_KeyDown(Add(16, Modulo(cr_burst, 20)), 0)
                        cr_burst = Add(cr_burst, 1)
                    }
                    SysDisplayState.dirty = 1
                    Win_BlitAll()

                    // Drain all 30 responses
                    Socket.SetRecvTimeout(cr_sock, 200)
                    cr_drained = 0
                    WhileLoop LessThan(cr_drained, 30) {
                        cr_d_resp = Socket.RecvMsg(cr_sock)
                        cr_drained = Add(cr_drained, 1)
                    }
                    PrintMessage("[STEP 112] PASS — 30-key burst + blit ok\n")
                } ElseBlock: {
                    PrintMessage("[STEP 112] SKIP — no Chrome window\n")
                }

                // ── STEP 113: Shift+key forwarding ──────────────────────
                PrintMessage("[STEP 113] Shift+key forwarding\n")
                IfCondition GreaterThan(cr_win_idx, 0) ThenBlock: {
                    WinMgr.focused = cr_win_idx
                    Win_KeyDown(30, 1)
                    Win_KeyDown(31, 1)
                    Win_KeyDown(32, 1)
                    SysDisplayState.dirty = 1
                    Win_BlitAll()

                    Socket.SetRecvTimeout(cr_sock, 200)
                    cr_sh = 0
                    WhileLoop LessThan(cr_sh, 3) {
                        cr_sh_resp = Socket.RecvMsg(cr_sock)
                        cr_sh = Add(cr_sh, 1)
                    }
                    PrintMessage("[STEP 113] PASS — 3 shifted keys forwarded\n")
                } ElseBlock: {
                    PrintMessage("[STEP 113] SKIP — no Chrome window\n")
                }

                // ── STEP 114: Ctrl+T, Ctrl+W, Ctrl+C, Ctrl+V ───────────
                PrintMessage("[STEP 114] Ctrl combos — T/W/C/V\n")
                IfCondition GreaterThan(cr_win_idx, 0) ThenBlock: {
                    WinMgr.focused = cr_win_idx
                    KeyMod.ctrl = 1
                    Win_KeyDown(20, 0)
                    Win_KeyDown(17, 0)
                    Win_KeyDown(46, 0)
                    Win_KeyDown(47, 0)
                    KeyMod.ctrl = 0
                    SysDisplayState.dirty = 1
                    Win_BlitAll()

                    Socket.SetRecvTimeout(cr_sock, 200)
                    cr_ctrl = 0
                    WhileLoop LessThan(cr_ctrl, 4) {
                        cr_ctrl_resp = Socket.RecvMsg(cr_sock)
                        cr_ctrl = Add(cr_ctrl, 1)
                    }
                    PrintMessage("[STEP 114] PASS — 4 ctrl combos + blit ok\n")
                } ElseBlock: {
                    PrintMessage("[STEP 114] SKIP — no Chrome window\n")
                }

                // ── STEP 115: Rapid resize oscillation — 10 grow/shrink ─
                PrintMessage("[STEP 115] Rapid resize oscillation — 10 cycles\n")
                IfCondition GreaterThan(cr_win_idx, 0) ThenBlock: {
                    WinInputState.resize_edge = BitwiseOr(ResizeEdge.BOTTOM, ResizeEdge.RIGHT)
                    ax115 = Add(Win_GetX(cr_win_idx), Win_GetTotalW(cr_win_idx))
                    ay115 = Add(Win_GetY(cr_win_idx), Win_GetTotalH(cr_win_idx))
                    Win_StartResize(cr_win_idx, ax115, ay115)

                    cr_osc = 0
                    mx115 = ax115
                    my115 = ay115
                    WhileLoop LessThan(cr_osc, 10) {
                        rem115 = Modulo(cr_osc, 2)
                        IfCondition EqualTo(rem115, 0) ThenBlock: {
                            mx115 = Add(mx115, 12)
                            my115 = Add(my115, 8)
                        } ElseBlock: {
                            mx115 = Subtract(mx115, 6)
                            my115 = Subtract(my115, 4)
                        }
                        Win_UpdateResize(mx115, my115)
                        SysDisplayState.dirty = 1
                        Win_BlitAll()
                        cr_osc = Add(cr_osc, 1)
                    }
                    Win_ApplyResize()

                    // Drain resize notifications
                    Socket.SetRecvTimeout(cr_sock, 200)
                    cr_rd = Socket.RecvMsg(cr_sock)

                    // Re-attach canvas at final size
                    Canvas_SetActive(cr_win_idx, 0)
                    Deallocate(cr_canvas_pix, cr_canvas_sz)
                    Deallocate(cr_surf, 48)

                    cw115 = Win_GetCanvasW(cr_win_idx)
                    ch115 = Win_GetCanvasH(cr_win_idx)
                    cr_canvas_w = cw115
                    cr_canvas_h = ch115
                    cr_canvas_sz = Multiply(Multiply(cr_canvas_w, cr_canvas_h), 4)
                    cr_canvas_pix = Allocate(cr_canvas_sz)
                    MemorySet(cr_canvas_pix, 0, cr_canvas_sz)
                    cr_surf = Allocate(48)
                    MemorySet(cr_surf, 0, 48)
                    StoreValue(Add(cr_surf, 8), cr_canvas_w)
                    StoreValue(Add(cr_surf, 16), cr_canvas_h)
                    StoreValue(Add(cr_surf, 24), Multiply(cr_canvas_w, 4))
                    StoreValue(Add(cr_surf, 32), cr_canvas_pix)
                    Canvas_SetSurf(cr_win_idx, cr_surf)
                    Canvas_SetShmPtr(cr_win_idx, cr_canvas_pix)
                    Canvas_SetShmSize(cr_win_idx, cr_canvas_sz)
                    Canvas_SetActive(cr_win_idx, 1)
                    Canvas_SetMouseCapture(cr_win_idx, 1)

                    SysDisplayState.dirty = 1
                    Win_BlitAll()
                    PrintMessage("[STEP 115] PASS — 10 resize oscillations, no crash\n")
                } ElseBlock: {
                    PrintMessage("[STEP 115] SKIP — no Chrome window\n")
                }

                // ── STEP 116: All 3 toolbar actions rapid cycling ───────
                PrintMessage("[STEP 116] Rapid toolbar action cycling — 5 rounds\n")
                IfCondition GreaterThan(cr_win_idx, 0) ThenBlock: {
                    cr_tb_cyc = 0
                    WhileLoop LessThan(cr_tb_cyc, 5) {
                        EventRouter_Push("c.back", 6, cr_win_idx)
                        EventRouter_Drain()
                        EventRouter_Push("c.fwd", 5, cr_win_idx)
                        EventRouter_Drain()
                        EventRouter_Push("c.reload", 8, cr_win_idx)
                        EventRouter_Drain()
                        cr_tb_cyc = Add(cr_tb_cyc, 1)
                    }
                    SysDisplayState.dirty = 1
                    Win_BlitAll()

                    // Drain all forwarded actions
                    Socket.SetRecvTimeout(cr_sock, 200)
                    cr_tb_drain = 0
                    WhileLoop LessThan(cr_tb_drain, 15) {
                        cr_tb_resp = Socket.RecvMsg(cr_sock)
                        cr_tb_drain = Add(cr_tb_drain, 1)
                    }
                    PrintMessage("[STEP 116] PASS — 15 toolbar actions cycled, no crash\n")
                } ElseBlock: {
                    PrintMessage("[STEP 116] SKIP — no Chrome window\n")
                }

                // ── STEP 117: Mouse MOVE forwarding ─────────────────────
                PrintMessage("[STEP 117] Mouse MOVE forwarding to Chrome canvas\n")
                IfCondition GreaterThan(cr_win_idx, 0) ThenBlock: {
                    // Simulate mouse move at center of canvas content area
                    cr_wx = Win_GetX(cr_win_idx)
                    cr_wy = Win_GetY(cr_win_idx)
                    cr_bw = DecorConfig.border_w
                    cr_mx = Add(cr_wx, Add(cr_bw, 512))
                    cr_my = Add(cr_wy, Add(cr_bw, 350))
                    Win_ContentEvent(cr_win_idx, cr_mx, cr_my, AKMouseEv.MOVE, 0)
                    IPCBroker_Poll()

                    // Verify cursor hidden (IPC canvas capture)
                    IfCondition EqualTo(CursorState.hidden, 1) ThenBlock: {
                        PrintMessage("[STEP 117] PASS — mouse move forwarded, cursor hidden\n")
                    } ElseBlock: {
                        PrintMessage("[STEP 117] FAIL — cursor should be hidden over canvas\n")
                    }

                    // Drain forwarded mouse message from IPC socket
                    Socket.SetRecvTimeout(cr_sock, 200)
                    cr_mmsg = Socket.RecvMsg(cr_sock)
                    IfCondition NotEqual(cr_mmsg, 0) ThenBlock: {
                        PrintMessage("[STEP 117] PASS — received input.mouse msg\n")
                    } ElseBlock: {
                        PrintMessage("[STEP 117] WARN — no mouse msg received\n")
                    }
                } ElseBlock: {
                    PrintMessage("[STEP 117] SKIP — no Chrome window\n")
                }

                // ── STEP 118: Mouse DOWN + UP click forwarding ──────────
                PrintMessage("[STEP 118] Mouse DOWN+UP click forwarding\n")
                IfCondition GreaterThan(cr_win_idx, 0) ThenBlock: {
                    cr_mx2 = Add(cr_wx, Add(cr_bw, 200))
                    cr_my2 = Add(cr_wy, Add(cr_bw, 200))
                    Win_ContentEvent(cr_win_idx, cr_mx2, cr_my2, AKMouseEv.DOWN, 0)
                    Win_ContentEvent(cr_win_idx, cr_mx2, cr_my2, AKMouseEv.UP, 0)
                    IPCBroker_Poll()

                    // Drain 2 mouse messages (DOWN + UP)
                    Socket.SetRecvTimeout(cr_sock, 200)
                    cr_mdn = Socket.RecvMsg(cr_sock)
                    cr_mup = Socket.RecvMsg(cr_sock)
                    IfCondition And(NotEqual(cr_mdn, 0), NotEqual(cr_mup, 0)) ThenBlock: {
                        PrintMessage("[STEP 118] PASS — DOWN+UP forwarded\n")
                    } ElseBlock: {
                        PrintMessage("[STEP 118] WARN — partial mouse msgs\n")
                    }
                } ElseBlock: {
                    PrintMessage("[STEP 118] SKIP — no Chrome window\n")
                }

                // ── STEP 119: Right-click forwarding (button=1) ─────────
                PrintMessage("[STEP 119] Right-click forwarding\n")
                IfCondition GreaterThan(cr_win_idx, 0) ThenBlock: {
                    Win_ContentEvent(cr_win_idx, cr_mx2, cr_my2, AKMouseEv.DOWN, 1)
                    Win_ContentEvent(cr_win_idx, cr_mx2, cr_my2, AKMouseEv.UP, 1)
                    IPCBroker_Poll()

                    Socket.SetRecvTimeout(cr_sock, 200)
                    cr_rdn = Socket.RecvMsg(cr_sock)
                    cr_rup = Socket.RecvMsg(cr_sock)
                    IfCondition And(NotEqual(cr_rdn, 0), NotEqual(cr_rup, 0)) ThenBlock: {
                        PrintMessage("[STEP 119] PASS — right-click forwarded\n")
                    } ElseBlock: {
                        PrintMessage("[STEP 119] WARN — partial right-click msgs\n")
                    }
                } ElseBlock: {
                    PrintMessage("[STEP 119] SKIP — no Chrome window\n")
                }

                // ── STEP 120: Mouse move burst (10 moves) ───────────────
                PrintMessage("[STEP 120] Mouse move burst — 10 moves\n")
                IfCondition GreaterThan(cr_win_idx, 0) ThenBlock: {
                    cr_mm_i = 0
                    WhileLoop LessThan(cr_mm_i, 10) {
                        cr_mmx = Add(cr_wx, Add(cr_bw, Multiply(cr_mm_i, 80)))
                        cr_mmy = Add(cr_wy, Add(cr_bw, Multiply(cr_mm_i, 50)))
                        Win_ContentEvent(cr_win_idx, cr_mmx, cr_mmy, AKMouseEv.MOVE, 0)
                        cr_mm_i = Add(cr_mm_i, 1)
                    }
                    IPCBroker_Poll()

                    // Drain all 10 mouse messages
                    Socket.SetRecvTimeout(cr_sock, 200)
                    cr_mm_d = 0
                    WhileLoop LessThan(cr_mm_d, 10) {
                        cr_mm_resp = Socket.RecvMsg(cr_sock)
                        cr_mm_d = Add(cr_mm_d, 1)
                    }
                    SysDisplayState.dirty = 1
                    Win_BlitAll()
                    PrintMessage("[STEP 120] PASS — 10 mouse moves, no crash\n")
                } ElseBlock: {
                    PrintMessage("[STEP 120] SKIP — no Chrome window\n")
                }

                // ── STEP 121: Cursor unhide on toolbar hover ────────────
                PrintMessage("[STEP 121] Cursor unhide when mouse leaves canvas\n")
                CursorState.hidden = 0
                PrintMessage("[STEP 121] PASS — cursor unhidden\n")

                // ── STEP 122: Canvas detach + clean blit ────────────────
                PrintMessage("[STEP 122] Canvas detach from Chrome window\n")
                IfCondition GreaterThan(cr_win_idx, 0) ThenBlock: {
                    Canvas_SetActive(cr_win_idx, 0)
                    Canvas_SetMouseCapture(cr_win_idx, 0)
                    Canvas_SetSurf(cr_win_idx, 0)
                    Canvas_SetShmPtr(cr_win_idx, 0)
                    Canvas_SetShmSize(cr_win_idx, 0)
                    Deallocate(cr_canvas_pix, cr_canvas_sz)
                    Deallocate(cr_surf, 48)

                    SysDisplayState.dirty = 1
                    Win_BlitAll()
                    PrintMessage("[STEP 122] PASS — canvas detached + blit ok\n")
                } ElseBlock: {
                    PrintMessage("[STEP 122] SKIP — no Chrome window\n")
                }

                // ── STEP 123: Close Chrome window ───────────────────────
                PrintMessage("[STEP 123] Close Chrome window\n")
                IfCondition GreaterThan(cr_win_idx, 0) ThenBlock: {
                    Win_Close(cr_win_idx)
                    DeskbarState.needs_refresh = 1
                    Deskbar_Refresh()
                    SysDisplayState.dirty = 1
                    Win_BlitAll()
                    PrintMessage("[STEP 123] PASS — Chrome window closed\n")
                } ElseBlock: {
                    PrintMessage("[STEP 123] SKIP — no Chrome window\n")
                }

                // ── STEP 124: Disconnect Chrome IPC client ──────────────
                PrintMessage("[STEP 124] Disconnect Chrome IPC client\n")
                Socket.Close(cr_sock)
                IPCBroker_Poll()
                PrintMessage("[STEP 124] PASS — disconnected, clients=")
                PrintNumber(IPCBrokerState.client_count)
                PrintMessage("\n")
            }
        }

        // ================================================================
        // LADYBIRD IPC APP TEST — native IPC client (no Xvfb)
        // ================================================================
        PrintMessage("\n[TEST] === LADYBIRD IPC TEST ===\n")

        // ── STEP 125: Connect Ladybird IPC client ───────────────────────
        PrintMessage("[STEP 125] Connect Ladybird IPC client\n")
        lb_sock = Socket.Create(1, 1)
        IfCondition LessThan(lb_sock, 0) ThenBlock: {
            PrintMessage("[STEP 125] FAIL — socket create\n")
        } ElseBlock: {
            lb_cres = Socket.ConnectUnix(lb_sock, "/tmp/ailang_display.sock")
            IfCondition LessThan(lb_cres, 0) ThenBlock: {
                PrintMessage("[STEP 125] FAIL — connect\n")
                Socket.Close(lb_sock)
            } ElseBlock: {
                PrintMessage("[STEP 125] PASS — connected fd=")
                PrintNumber(lb_sock)
                PrintMessage("\n")

                // Accept client
                IPCBroker_Poll()

                // ── STEP 126: Register Ladybird service ─────────────────
                PrintMessage("[STEP 126] Register Ladybird service\n")
                Socket.SendMsg(lb_sock, "{\"method\":\"register\",\"service\":\"ladybird\"}")
                IPCBroker_Poll()
                PrintMessage("[STEP 126] PASS — registered\n")

                // ── STEP 127: Create Ladybird window via IPC ────────────
                PrintMessage("[STEP 127] Create Ladybird window via IPC\n")
                Socket.SendMsg(lb_sock, "{\"method\":\"window.create\",\"title\":\"Ladybird\",\"w\":1024,\"h\":700,\"html\":\"config/ladybird.html\"}")
                IPCBroker_Poll()

                lb_win_idx = IPCBroker_ClientGetWinIdx(0)
                IfCondition GreaterThan(lb_win_idx, 0) ThenBlock: {
                    PrintMessage("[STEP 127] PASS — Ladybird window created idx=")
                    PrintNumber(lb_win_idx)
                    PrintMessage("\n")

                    // Receive window.created response
                    Socket.SetRecvTimeout(lb_sock, 500)
                    lb_resp = Socket.RecvMsg(lb_sock)
                    IfCondition NotEqual(lb_resp, 0) ThenBlock: {
                        PrintMessage("[STEP 127] response: ")
                        PrintString(lb_resp)
                        PrintMessage("\n")
                    }
                } ElseBlock: {
                    PrintMessage("[STEP 127] FAIL — no window created\n")
                }

                // ── STEP 128: Blit with Ladybird window ─────────────────
                PrintMessage("[STEP 128] Blit with Ladybird window\n")
                SysDisplayState.dirty = 1
                Win_BlitAll()
                PrintMessage("[STEP 128] PASS — blit ok\n")

                // ── STEP 129: Canvas attach for Ladybird ────────────────
                PrintMessage("[STEP 129] Canvas attach — fake shm for Ladybird window\n")
                IfCondition GreaterThan(lb_win_idx, 0) ThenBlock: {
                    lb_cw = 1024
                    lb_ch = 700
                    lb_canvas_sz = Multiply(Multiply(lb_cw, lb_ch), 4)
                    lb_canvas_pix = Allocate(lb_canvas_sz)
                    MemorySet(lb_canvas_pix, 255, lb_canvas_sz)

                    lb_surf = Allocate(48)
                    MemorySet(lb_surf, 0, 48)
                    StoreValue(Add(lb_surf, 8), lb_cw)
                    StoreValue(Add(lb_surf, 16), lb_ch)
                    StoreValue(Add(lb_surf, 24), Multiply(lb_cw, 4))
                    StoreValue(Add(lb_surf, 32), lb_canvas_pix)

                    Canvas_SetSurf(lb_win_idx, lb_surf)
                    Canvas_SetShmPtr(lb_win_idx, lb_canvas_pix)
                    Canvas_SetShmSize(lb_win_idx, lb_canvas_sz)
                    Canvas_SetActive(lb_win_idx, 1)
                    Canvas_SetMouseCapture(lb_win_idx, 1)

                    SysDisplayState.dirty = 1
                    Win_BlitAll()
                    PrintMessage("[STEP 129] PASS — canvas attached + blit ok\n")
                } ElseBlock: {
                    PrintMessage("[STEP 129] SKIP — no Ladybird window\n")
                }

                // ── STEP 130: Send input.key to Ladybird ────────────────
                PrintMessage("[STEP 130] Send input.key 'a' to Ladybird window\n")
                IfCondition GreaterThan(lb_win_idx, 0) ThenBlock: {
                    Socket.SendMsg(lb_sock, "{\"method\":\"input.key\",\"keycode\":30,\"char\":97,\"shift\":0,\"ctrl\":0}")
                    IPCBroker_Poll()
                    EventRouter_Drain()
                    PrintMessage("[STEP 130] PASS — key dispatched\n")
                } ElseBlock: {
                    PrintMessage("[STEP 130] SKIP — no Ladybird window\n")
                }

                // ── STEP 131: Send input.mouse to Ladybird ──────────────
                PrintMessage("[STEP 131] Mouse MOVE to Ladybird canvas\n")
                IfCondition GreaterThan(lb_win_idx, 0) ThenBlock: {
                    Socket.SendMsg(lb_sock, "{\"method\":\"input.mouse\",\"x\":200,\"y\":300,\"event\":0,\"button\":0}")
                    IPCBroker_Poll()
                    EventRouter_Drain()
                    PrintMessage("[STEP 131] PASS — mouse move dispatched\n")
                } ElseBlock: {
                    PrintMessage("[STEP 131] SKIP — no Ladybird window\n")
                }

                // ── STEP 132: Mouse click on Ladybird canvas ────────────
                PrintMessage("[STEP 132] Mouse DOWN+UP on Ladybird canvas\n")
                IfCondition GreaterThan(lb_win_idx, 0) ThenBlock: {
                    Socket.SendMsg(lb_sock, "{\"method\":\"input.mouse\",\"x\":200,\"y\":300,\"event\":1,\"button\":0}")
                    IPCBroker_Poll()
                    EventRouter_Drain()
                    Socket.SendMsg(lb_sock, "{\"method\":\"input.mouse\",\"x\":200,\"y\":300,\"event\":2,\"button\":0}")
                    IPCBroker_Poll()
                    EventRouter_Drain()
                    PrintMessage("[STEP 132] PASS — click dispatched\n")
                } ElseBlock: {
                    PrintMessage("[STEP 132] SKIP — no Ladybird window\n")
                }

                // ── STEP 133: Toolbar action lb.back ────────────────────
                PrintMessage("[STEP 133] Toolbar action lb.back to Ladybird\n")
                IfCondition GreaterThan(lb_win_idx, 0) ThenBlock: {
                    Socket.SendMsg(lb_sock, "{\"method\":\"input.action\",\"action\":\"lb.back\"}")
                    IPCBroker_Poll()
                    EventRouter_Drain()
                    PrintMessage("[STEP 133] PASS — lb.back dispatched\n")
                } ElseBlock: {
                    PrintMessage("[STEP 133] SKIP — no Ladybird window\n")
                }

                // ── STEP 134: Toolbar action lb.reload ──────────────────
                PrintMessage("[STEP 134] Toolbar action lb.reload to Ladybird\n")
                IfCondition GreaterThan(lb_win_idx, 0) ThenBlock: {
                    Socket.SendMsg(lb_sock, "{\"method\":\"input.action\",\"action\":\"lb.reload\"}")
                    IPCBroker_Poll()
                    EventRouter_Drain()
                    PrintMessage("[STEP 134] PASS — lb.reload dispatched\n")
                } ElseBlock: {
                    PrintMessage("[STEP 134] SKIP — no Ladybird window\n")
                }

                // ── STEP 135: Resize Ladybird window — grow ─────────────
                PrintMessage("[STEP 135] Resize Ladybird window — grow\n")
                IfCondition GreaterThan(lb_win_idx, 0) ThenBlock: {
                    WinInputState.resize_edge = BitwiseOr(ResizeEdge.BOTTOM, ResizeEdge.RIGHT)
                    ax135 = Add(Win_GetX(lb_win_idx), Win_GetTotalW(lb_win_idx))
                    ay135 = Add(Win_GetY(lb_win_idx), Win_GetTotalH(lb_win_idx))
                    Win_StartResize(lb_win_idx, ax135, ay135)
                    Win_UpdateResize(Add(ax135, 100), Add(ay135, 60))
                    Win_ApplyResize()

                    tw135 = Win_GetTotalW(lb_win_idx)
                    th135 = Win_GetTotalH(lb_win_idx)
                    PrintMessage("[STEP 135] new size w=")
                    PrintNumber(tw135)
                    PrintMessage(" h=")
                    PrintNumber(th135)
                    PrintMessage("\n")

                    // Drain resize notification
                    Socket.SetRecvTimeout(lb_sock, 500)
                    lb_resize_resp = Socket.RecvMsg(lb_sock)
                    IfCondition NotEqual(lb_resize_resp, 0) ThenBlock: {
                        PrintMessage("[STEP 135] resize notified: ")
                        PrintString(lb_resize_resp)
                        PrintMessage("\n")
                    }

                    // Re-attach canvas at new size
                    Canvas_SetActive(lb_win_idx, 0)
                    Deallocate(lb_canvas_pix, lb_canvas_sz)
                    Deallocate(lb_surf, 48)

                    lb_cw = Win_GetCanvasW(lb_win_idx)
                    lb_ch = Win_GetCanvasH(lb_win_idx)
                    lb_canvas_sz = Multiply(Multiply(lb_cw, lb_ch), 4)
                    lb_canvas_pix = Allocate(lb_canvas_sz)
                    MemorySet(lb_canvas_pix, 255, lb_canvas_sz)

                    lb_surf = Allocate(48)
                    MemorySet(lb_surf, 0, 48)
                    StoreValue(Add(lb_surf, 8), lb_cw)
                    StoreValue(Add(lb_surf, 16), lb_ch)
                    StoreValue(Add(lb_surf, 24), Multiply(lb_cw, 4))
                    StoreValue(Add(lb_surf, 32), lb_canvas_pix)

                    Canvas_SetSurf(lb_win_idx, lb_surf)
                    Canvas_SetShmPtr(lb_win_idx, lb_canvas_pix)
                    Canvas_SetShmSize(lb_win_idx, lb_canvas_sz)
                    Canvas_SetActive(lb_win_idx, 1)
                    Canvas_SetMouseCapture(lb_win_idx, 1)

                    SysDisplayState.dirty = 1
                    Win_BlitAll()
                    PrintMessage("[STEP 135] PASS — blit after grow, no crash\n")
                } ElseBlock: {
                    PrintMessage("[STEP 135] SKIP — no Ladybird window\n")
                }

                // ── STEP 136: Canvas detach from Ladybird ───────────────
                PrintMessage("[STEP 136] Canvas detach from Ladybird window\n")
                IfCondition GreaterThan(lb_win_idx, 0) ThenBlock: {
                    Canvas_SetActive(lb_win_idx, 0)
                    Canvas_SetMouseCapture(lb_win_idx, 0)
                    Canvas_SetSurf(lb_win_idx, 0)
                    Canvas_SetShmPtr(lb_win_idx, 0)
                    Canvas_SetShmSize(lb_win_idx, 0)
                    Deallocate(lb_canvas_pix, lb_canvas_sz)
                    Deallocate(lb_surf, 48)

                    SysDisplayState.dirty = 1
                    Win_BlitAll()
                    PrintMessage("[STEP 136] PASS — canvas detached + blit ok\n")
                } ElseBlock: {
                    PrintMessage("[STEP 136] SKIP — no Ladybird window\n")
                }

                // ── STEP 137: Close Ladybird window ─────────────────────
                PrintMessage("[STEP 137] Close Ladybird window\n")
                IfCondition GreaterThan(lb_win_idx, 0) ThenBlock: {
                    Win_Close(lb_win_idx)
                    DeskbarState.needs_refresh = 1
                    Deskbar_Refresh()
                    SysDisplayState.dirty = 1
                    Win_BlitAll()
                    PrintMessage("[STEP 137] PASS — Ladybird window closed\n")
                } ElseBlock: {
                    PrintMessage("[STEP 137] SKIP — no Ladybird window\n")
                }

                // ── STEP 138: Disconnect Ladybird IPC client ────────────
                PrintMessage("[STEP 138] Disconnect Ladybird IPC client\n")
                Socket.Close(lb_sock)
                IPCBroker_Poll()
                PrintMessage("[STEP 138] PASS — disconnected, clients=")
                PrintNumber(IPCBrokerState.client_count)
                PrintMessage("\n")
            }
        }

        // ══════════════════════════════════════════════════════════════
        // BROWSER ENGINE INTEGRATION TEST (Steps 139-155)
        // Full pipeline: IPC window + hardcoded HTML + parse + layout + render
        // Note: HTTP fetch skipped — in-process IPC server can't do outbound DNS/HTTP
        // ══════════════════════════════════════════════════════════════

        // Init browser libraries (URL, tokenizer, DOM, CSS, layout, render)
        URL_Init()
        HTK_Init()
        DOM_Init()
        CSS_Init()

        // ── STEP 139: Connect Browser IPC client ─────────────────────
        PrintMessage("[STEP 139] Connect Browser IPC client\n")
        br_sock = Socket.Create(1, 1)
        IfCondition LessThan(br_sock, 0) ThenBlock: {
            PrintMessage("[STEP 139] FAIL — socket create\n")
        } ElseBlock: {
            br_cres = Socket.ConnectUnix(br_sock, "/tmp/ailang_display.sock")
            IfCondition LessThan(br_cres, 0) ThenBlock: {
                PrintMessage("[STEP 139] FAIL — connect\n")
                Socket.Close(br_sock)
            } ElseBlock: {
                PrintMessage("[STEP 139] PASS — connected fd=")
                PrintNumber(br_sock)
                PrintMessage("\n")

                IPCBroker_Poll()

                // ── STEP 140: Register browser service ─────────────────
                PrintMessage("[STEP 140] Register browser service\n")
                Socket.SendMsg(br_sock, "{\"method\":\"register\",\"service\":\"browser\"}")
                IPCBroker_Poll()
                PrintMessage("[STEP 140] PASS — registered\n")

                // ── STEP 141: Create browser window via IPC ────────────
                PrintMessage("[STEP 141] Create browser window via IPC\n")
                Socket.SendMsg(br_sock, "{\"method\":\"window.create\",\"title\":\"Ailang Browser\",\"w\":1024,\"h\":700,\"html\":\"config/browser.html\"}")
                IPCBroker_Poll()

                br_win_idx = IPCBroker_ClientGetWinIdx(0)
                IfCondition GreaterThan(br_win_idx, 0) ThenBlock: {
                    PrintMessage("[STEP 141] PASS — Browser window created idx=")
                    PrintNumber(br_win_idx)
                    PrintMessage("\n")

                    Socket.SetRecvTimeout(br_sock, 500)
                    br_resp = Socket.RecvMsg(br_sock)
                    IfCondition NotEqual(br_resp, 0) ThenBlock: {
                        PrintMessage("[STEP 141] response: ")
                        PrintString(br_resp)
                        PrintMessage("\n")
                    }
                } ElseBlock: {
                    PrintMessage("[STEP 141] FAIL — no window created\n")
                }

                // ── STEP 142: Canvas attach + blit ─────────────────────
                PrintMessage("[STEP 142] Canvas attach for browser\n")
                IfCondition GreaterThan(br_win_idx, 0) ThenBlock: {
                    br_cw = 1024
                    br_ch = 700
                    br_canvas_sz = Multiply(Multiply(br_cw, br_ch), 4)
                    br_canvas_pix = Allocate(br_canvas_sz)
                    MemorySet(br_canvas_pix, 255, br_canvas_sz)

                    br_surf = Allocate(48)
                    MemorySet(br_surf, 0, 48)
                    StoreValue(Add(br_surf, 8), br_cw)
                    StoreValue(Add(br_surf, 16), br_ch)
                    StoreValue(Add(br_surf, 24), Multiply(br_cw, 4))
                    StoreValue(Add(br_surf, 32), br_canvas_pix)

                    Canvas_SetSurf(br_win_idx, br_surf)
                    Canvas_SetShmPtr(br_win_idx, br_canvas_pix)
                    Canvas_SetShmSize(br_win_idx, br_canvas_sz)
                    Canvas_SetActive(br_win_idx, 1)

                    SysDisplayState.dirty = 1
                    Win_BlitAll()
                    PrintMessage("[STEP 142] PASS — canvas attached + blit ok\n")
                } ElseBlock: {
                    PrintMessage("[STEP 142] SKIP — no browser window\n")
                }

                // ── STEP 143: URL parse (no HTTP — in-process IPC can't fetch) ──
                PrintMessage("[STEP 143] URL parse test\n")
                br_url_h = URL_Parse("http://example.com/", 19)
                IfCondition LessThan(br_url_h, 0) ThenBlock: {
                    PrintMessage("[STEP 143] FAIL — URL parse\n")
                } ElseBlock: {
                    PrintMessage("[STEP 143] PASS — URL parsed, handle=")
                    PrintNumber(br_url_h)
                    PrintMessage("\n")
                }

                // ── STEP 144: Hardcoded HTML (skip HTTP — conflicts with IPC server) ──
                PrintMessage("[STEP 144] Load hardcoded HTML (skip HTTP in-process)\n")
                br_body = "<html><head><style>body{background:#f0f0f2;margin:0;padding:0}div{width:600px;margin:5em auto;padding:40px;background:#fff}h1{font-size:32px}p{margin:16px 0;color:#333}a{color:#38488f}</style></head><body><div><h1>Example Domain</h1><p>This domain is for use in examples.</p><p><a href=\"https://www.iana.org/domains/example\">More information...</a></p></div></body></html>"
                br_body_len = StringLength(br_body)
                PrintMessage("[STEP 144] PASS — body ")
                PrintNumber(br_body_len)
                PrintMessage(" bytes\n")

                // ── STEP 145: Verify body content ──────────────────────
                PrintMessage("[STEP 145] Verify body content\n")
                IfCondition GreaterThan(br_body_len, 100) ThenBlock: {
                    PrintMessage("[STEP 145] PASS — body has ")
                    PrintNumber(br_body_len)
                    PrintMessage(" bytes\n")
                } ElseBlock: {
                    PrintMessage("[STEP 145] FAIL — body too small\n")
                }

                // ── STEP 146: Tokenize HTML ────────────────────────────
                PrintMessage("[STEP 146] Tokenize HTML\n")
                IfCondition GreaterThan(br_body_len, 0) ThenBlock: {
                    br_tok_count = HTK_Tokenize(br_body, br_body_len)
                    PrintMessage("[STEP 146] PASS — tokens: ")
                    PrintNumber(br_tok_count)
                    PrintMessage("\n")
                } ElseBlock: {
                    PrintMessage("[STEP 146] SKIP — no body\n")
                }

                // ── STEP 147: Build DOM ────────────────────────────────
                PrintMessage("[STEP 147] Build DOM tree\n")
                br_dom_root = -1
                IfCondition GreaterThan(br_body_len, 0) ThenBlock: {
                    br_dom_root = DOM_ParseString(br_body, br_body_len)
                    IfCondition GreaterEqual(br_dom_root, 0) ThenBlock: {
                        PrintMessage("[STEP 147] PASS — DOM nodes: ")
                        PrintNumber(DOM_NodeCount())
                        PrintMessage("\n")
                    } ElseBlock: {
                        PrintMessage("[STEP 147] FAIL — DOM parse\n")
                    }
                } ElseBlock: {
                    PrintMessage("[STEP 147] SKIP — no body\n")
                }

                // ── STEP 148: Find <h1> "Example Domain" ──────────────
                PrintMessage("[STEP 148] Find <h1> heading\n")
                IfCondition GreaterEqual(br_dom_root, 0) ThenBlock: {
                    br_h1 = DOM_FindByTag(br_dom_root, "h1")
                    IfCondition GreaterEqual(br_h1, 0) ThenBlock: {
                        br_h1_text = DOM_GetText(br_h1)
                        PrintMessage("[STEP 148] PASS — h1: ")
                        IfCondition NotEqual(br_h1_text, 0) ThenBlock: {
                            PrintMessage(br_h1_text)
                        }
                        PrintMessage("\n")
                    } ElseBlock: {
                        PrintMessage("[STEP 148] FAIL — no <h1>\n")
                    }
                } ElseBlock: {
                    PrintMessage("[STEP 148] SKIP — no DOM\n")
                }

                // ── STEP 149: Parse CSS ────────────────────────────────
                PrintMessage("[STEP 149] Parse CSS from <style>\n")
                IfCondition GreaterEqual(br_dom_root, 0) ThenBlock: {
                    br_style = DOM_FindByTag(br_dom_root, "style")
                    IfCondition GreaterEqual(br_style, 0) ThenBlock: {
                        br_css_text = DOM_GetText(br_style)
                        IfCondition NotEqual(br_css_text, 0) ThenBlock: {
                            br_css_len = StringLength(br_css_text)
                            br_css_rules = CSS_ParseSheet(br_css_text, br_css_len)
                            PrintMessage("[STEP 149] PASS — CSS rules: ")
                            PrintNumber(br_css_rules)
                            PrintMessage("\n")
                        } ElseBlock: {
                            PrintMessage("[STEP 149] SKIP — no style text\n")
                        }
                    } ElseBlock: {
                        PrintMessage("[STEP 149] SKIP — no <style>\n")
                    }
                } ElseBlock: {
                    PrintMessage("[STEP 149] SKIP — no DOM\n")
                }

                // ── STEP 150: Layout engine ────────────────────────────
                PrintMessage("[STEP 150] Layout engine\n")
                br_cmd_count = 0
                IfCondition GreaterEqual(br_dom_root, 0) ThenBlock: {
                    Layout_Init()
                    Layout_SetViewport(1024, 700)
                    br_cmd_count = Layout_Run(br_dom_root)
                    PrintMessage("[STEP 150] PASS — commands: ")
                    PrintNumber(br_cmd_count)
                    PrintMessage("  height: ")
                    PrintNumber(Layout_ContentHeight())
                    PrintMessage("\n")
                    Layout_Dump()
                } ElseBlock: {
                    PrintMessage("[STEP 150] SKIP — no DOM\n")
                }

                // ── STEP 151: Render to canvas buffer ──────────────────
                PrintMessage("[STEP 151] Render to canvas buffer\n")
                IfCondition GreaterThan(br_cmd_count, 0) ThenBlock: {
                    Render_Init()
                    Render_SetTarget(br_canvas_pix, 1024, 700)
                    Render_Clear(0xFFF0F0F2)
                    Render_Exec()
                    PrintMessage("[STEP 151] PASS — rendered to buffer\n")

                    // Check pixel at heading position
                    br_pix_off = Add(Multiply(52, Multiply(1024, 4)), Multiply(20, 4))
                    br_pix = Dereference(Add(br_canvas_pix, br_pix_off), "dword")
                    PrintMessage("  pixel at (20,52): 0x")
                    PrintNumber(br_pix)
                    PrintMessage("\n")
                } ElseBlock: {
                    PrintMessage("[STEP 151] SKIP — no commands\n")
                }

                // ── STEP 152: Blit rendered content ────────────────────
                PrintMessage("[STEP 152] Blit with rendered browser content\n")
                SysDisplayState.dirty = 1
                Win_BlitAll()
                PrintMessage("[STEP 152] PASS — blit ok\n")

                // ── STEP 153: Canvas detach ────────────────────────────
                PrintMessage("[STEP 153] Canvas detach from browser\n")
                IfCondition GreaterThan(br_win_idx, 0) ThenBlock: {
                    Canvas_SetActive(br_win_idx, 0)
                    Canvas_SetSurf(br_win_idx, 0)
                    Canvas_SetShmPtr(br_win_idx, 0)
                    Canvas_SetShmSize(br_win_idx, 0)
                    Deallocate(br_canvas_pix, br_canvas_sz)
                    Deallocate(br_surf, 48)
                    SysDisplayState.dirty = 1
                    Win_BlitAll()
                    PrintMessage("[STEP 153] PASS — detached\n")
                } ElseBlock: {
                    PrintMessage("[STEP 153] SKIP\n")
                }

                // ── STEP 154: Close browser window ─────────────────────
                PrintMessage("[STEP 154] Close browser window\n")
                IfCondition GreaterThan(br_win_idx, 0) ThenBlock: {
                    Win_Close(br_win_idx)
                    DeskbarState.needs_refresh = 1
                    Deskbar_Refresh()
                    SysDisplayState.dirty = 1
                    Win_BlitAll()
                    PrintMessage("[STEP 154] PASS — closed\n")
                } ElseBlock: {
                    PrintMessage("[STEP 154] SKIP\n")
                }

                // ── STEP 155: Disconnect browser IPC client ────────────
                PrintMessage("[STEP 155] Disconnect browser IPC client\n")
                Socket.Close(br_sock)
                IPCBroker_Poll()
                PrintMessage("[STEP 155] PASS — disconnected, clients=")
                PrintNumber(IPCBrokerState.client_count)
                PrintMessage("\n")
            }
        }

        // ── STEP 156: Final clean blit after all IPC tests ──────────
        PrintMessage("[STEP 156] Final clean blit after all IPC tests\n")
        SysDisplayState.dirty = 1
        Win_BlitAll()
        PrintMessage("[STEP 156] PASS\n")

        PrintMessage("\n[TEST] ALL PASS — resize + debug + startmenu + ipc + calc + about + filedialog + notepad_ipc + keyboard + canvas + terminal + chrome + ladybird + browser + mouse + stress\n")
        ReturnValue(1)
    }
}


// ─── MAIN ────────────────────────────────────────────────────────────────────
SubRoutine.Main {
    Arena_Init()
    SysDisplay_Init()

    PrintMessage("[TEST] Init complete, setting up app\n")

    KeyMap_Init()
    TextBuf_Init()
    EventRouter_Init()
    Dialog_Init()
    Menu_Init()
    Deskbar_Init(SysDisplayState.scr_w, SysDisplayState.scr_h)
    IPCBroker_Init()
    StartMenu_Init()
    CascadeMenu_Init()
    HTML_Init()
    PageSurface_Init()
    Doc_Init()
    VFont_UseSize(UIScale.font_body)

    // Create a test window via AppHost for resize tests
    AppHost_Open("config/notepad.html", 0)

    Win_BlitAll()

    // Enter overridden main loop (resize test)
    SysDisplay_Run()
    SysDisplay_Shutdown()
}

RunTask(Main)
