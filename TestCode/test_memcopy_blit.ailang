// test_memcopy_blit.ailang
// Minimal test to isolate MemoryCopy-in-loop crash/hang.
// Tests every MemoryCopy usage pattern from the display pipeline:
//   1. Single large MemoryCopy (FB_FlipFast pattern)
//   2. MemoryCopy in row loop with simple addressing (Deskbar_Draw pattern)
//   3. MemoryCopy in row loop with offset addressing (Surface_BlitOpaque pattern)
//   4. MemoryCopy in row loop with full clamped addressing (Win_BlitOne pattern)
//   5. Repeated MemoryCopy across multiple frames (main loop simulation)
//
// Build & Run:
//   ./ailang.x TestCode/test_memcopy_blit.ailang test_memcopy_blit.x
//   ./test_memcopy_blit.x
//
// No framebuffer needed. Allocates buffers, copies, verifies bytes.

LibraryImport.Arena

// =============================================================================
// Helpers
// =============================================================================
Function.FillBuffer {
    Input: buf: Address
    Input: size: Integer
    Input: val: Integer
    Body: {
        i = 0
        WhileLoop LessThan(i, size) {
            SetByte(buf, i, val)
            i = Add(i, 1)
        }
    }
}

Function.FillPattern {
    Input: buf: Address
    Input: size: Integer
    Body: {
        i = 0
        WhileLoop LessThan(i, size) {
            SetByte(buf, i, BitwiseAnd(i, 255))
            i = Add(i, 1)
        }
    }
}

Function.VerifyByte {
    Input: buf: Address
    Input: offset: Integer
    Input: expected: Integer
    Input: label: Address
    Output: Integer
    Body: {
        actual = GetByte(buf, offset)
        IfCondition NotEqual(actual, expected) ThenBlock: {
            PrintMessage("  [FAIL] ")
            PrintString(label)
            PrintMessage(" offset=")
            PrintNumber(offset)
            PrintMessage(" expected=")
            PrintNumber(expected)
            PrintMessage(" got=")
            PrintNumber(actual)
            PrintMessage("\n")
            ReturnValue(0)
        }
        ReturnValue(1)
    }
}

Function.VerifyBuffer {
    Input: buf: Address
    Input: size: Integer
    Input: expected: Integer
    Input: label: Address
    Output: Integer
    Body: {
        i = 0
        fail = 0
        WhileLoop LessThan(i, size) {
            actual = GetByte(buf, i)
            IfCondition NotEqual(actual, expected) ThenBlock: {
                IfCondition EqualTo(fail, 0) ThenBlock: {
                    PrintMessage("  [FAIL] ")
                    PrintString(label)
                    PrintMessage(" first mismatch at offset=")
                    PrintNumber(i)
                    PrintMessage(" expected=")
                    PrintNumber(expected)
                    PrintMessage(" got=")
                    PrintNumber(actual)
                    PrintMessage("\n")
                }
                fail = Add(fail, 1)
            }
            i = Add(i, 1)
        }
        IfCondition GreaterThan(fail, 0) ThenBlock: {
            PrintMessage("  [FAIL] ")
            PrintString(label)
            PrintMessage(" total mismatches=")
            PrintNumber(fail)
            PrintMessage(" / ")
            PrintNumber(size)
            PrintMessage("\n")
            ReturnValue(0)
        }
        ReturnValue(1)
    }
}

Function.VerifyPattern {
    Input: buf: Address
    Input: size: Integer
    Input: label: Address
    Output: Integer
    Body: {
        i = 0
        fail = 0
        WhileLoop LessThan(i, size) {
            expected = BitwiseAnd(i, 255)
            actual = GetByte(buf, i)
            IfCondition NotEqual(actual, expected) ThenBlock: {
                IfCondition EqualTo(fail, 0) ThenBlock: {
                    PrintMessage("  [FAIL] ")
                    PrintString(label)
                    PrintMessage(" pattern mismatch at offset=")
                    PrintNumber(i)
                    PrintMessage(" expected=")
                    PrintNumber(expected)
                    PrintMessage(" got=")
                    PrintNumber(actual)
                    PrintMessage("\n")
                }
                fail = Add(fail, 1)
            }
            i = Add(i, 1)
        }
        IfCondition GreaterThan(fail, 0) ThenBlock: {
            PrintMessage("  [FAIL] ")
            PrintString(label)
            PrintMessage(" total pattern mismatches=")
            PrintNumber(fail)
            PrintMessage("\n")
            ReturnValue(0)
        }
        ReturnValue(1)
    }
}

// =============================================================================
// TEST 1: Single large MemoryCopy (FB_FlipFast pattern)
// =============================================================================
Function.Test_SingleCopy {
    Body: {
        PrintMessage("\n=== TEST 1: Single large MemoryCopy (FB_FlipFast) ===\n")
        size = 1228800   // 640 * 480 * 4 = typical framebuffer
        src = Allocate(size)
        dst = Allocate(size)

        FillPattern(src, size)
        FillBuffer(dst, size, 0)

        PrintMessage("  Copying ")
        PrintNumber(size)
        PrintMessage(" bytes...\n")
        MemoryCopy(dst, src, size)
        PrintMessage("  Copy done, verifying...\n")

        ok = VerifyPattern(dst, size, "single-copy")
        IfCondition EqualTo(ok, 1) ThenBlock: {
            PrintMessage("  [PASS] Test 1\n")
        }

        Deallocate(src, size)
        Deallocate(dst, size)
    }
}

// =============================================================================
// TEST 2: MemoryCopy in row loop — Deskbar_Draw pattern
// Simulates: loop over db_h rows, MemoryCopy one row per iteration
// dst_ptr = buf + (dst_y + y) * pitch
// src_row = src_data + y * src_pitch
// =============================================================================
Function.Test_DeskbarPattern {
    Body: {
        PrintMessage("\n=== TEST 2: Row-loop MemoryCopy (Deskbar_Draw) ===\n")
        sw = 640
        db_h = 32
        pb = 4
        pit = Multiply(sw, pb)    // dst pitch = screen_w * 4
        src_pitch = pit            // src pitch = same

        src_size = Multiply(db_h, src_pitch)
        // dst is a full-screen-height buffer
        sh = 480
        dst_size = Multiply(sh, pit)

        src_data = Allocate(src_size)
        buf = Allocate(dst_size)

        FillPattern(src_data, src_size)
        FillBuffer(buf, dst_size, 0)

        dst_y = Subtract(sh, db_h)  // deskbar at bottom

        row_bytes = Multiply(sw, pb)
        PrintMessage("  Row loop: ")
        PrintNumber(db_h)
        PrintMessage(" rows x ")
        PrintNumber(row_bytes)
        PrintMessage(" bytes...\n")

        y = 0
        WhileLoop LessThan(y, db_h) {
            src_row = Add(src_data, Multiply(y, src_pitch))
            dst_ptr = Add(buf, Multiply(Add(dst_y, y), pit))
            MemoryCopy(dst_ptr, src_row, row_bytes)
            y = Add(y, 1)
        }
        PrintMessage("  Loop done, verifying...\n")

        // Verify the copied region
        fail = 0
        y = 0
        WhileLoop LessThan(y, db_h) {
            i = 0
            WhileLoop LessThan(i, row_bytes) {
                src_off = Add(Multiply(y, src_pitch), i)
                dst_off = Add(Multiply(Add(dst_y, y), pit), i)
                expected = GetByte(src_data, src_off)
                actual = GetByte(buf, dst_off)
                IfCondition NotEqual(actual, expected) ThenBlock: {
                    IfCondition EqualTo(fail, 0) ThenBlock: {
                        PrintMessage("  [FAIL] row=")
                        PrintNumber(y)
                        PrintMessage(" col=")
                        PrintNumber(i)
                        PrintMessage(" expected=")
                        PrintNumber(expected)
                        PrintMessage(" got=")
                        PrintNumber(actual)
                        PrintMessage("\n")
                    }
                    fail = Add(fail, 1)
                }
                i = Add(i, 1)
            }
            y = Add(y, 1)
        }
        IfCondition EqualTo(fail, 0) ThenBlock: {
            PrintMessage("  [PASS] Test 2\n")
        } ElseBlock: {
            PrintMessage("  [FAIL] Test 2 — ")
            PrintNumber(fail)
            PrintMessage(" mismatches\n")
        }

        Deallocate(src_data, src_size)
        Deallocate(buf, dst_size)
    }
}

// =============================================================================
// TEST 3: MemoryCopy in row loop with offset — Surface_BlitOpaque pattern
// =============================================================================
Function.Test_SurfaceBlitPattern {
    Body: {
        PrintMessage("\n=== TEST 3: Row-loop + offset MemoryCopy (Surface_BlitOpaque) ===\n")
        copy_w = 200
        copy_h = 150
        pb = 4

        src_w = 320
        src_h = 240
        dst_w = 640
        dst_h = 480
        src_pitch = Multiply(src_w, pb)
        dst_pitch = Multiply(dst_w, pb)

        src_data = Allocate(Multiply(src_h, src_pitch))
        dst_data = Allocate(Multiply(dst_h, dst_pitch))

        FillPattern(src_data, Multiply(src_h, src_pitch))
        FillBuffer(dst_data, Multiply(dst_h, dst_pitch), 0)

        sx_start = 10
        sy_start = 5
        dst_x = 50
        dst_y = 30

        row_bytes = Multiply(copy_w, pb)
        PrintMessage("  Row loop: ")
        PrintNumber(copy_h)
        PrintMessage(" rows x ")
        PrintNumber(row_bytes)
        PrintMessage(" bytes...\n")

        row = 0
        WhileLoop LessThan(row, copy_h) {
            sry = Add(sy_start, row)
            dry = Add(dst_y, row)
            sr_off = Add(Multiply(sry, src_pitch), Multiply(sx_start, pb))
            sr_ptr = Add(src_data, sr_off)
            dr_off = Add(Multiply(dry, dst_pitch), Multiply(dst_x, pb))
            dr_ptr = Add(dst_data, dr_off)
            MemoryCopy(dr_ptr, sr_ptr, row_bytes)
            row = Add(row, 1)
        }
        PrintMessage("  Loop done, verifying...\n")

        fail = 0
        row = 0
        WhileLoop LessThan(row, copy_h) {
            sry = Add(sy_start, row)
            dry = Add(dst_y, row)
            i = 0
            WhileLoop LessThan(i, row_bytes) {
                src_off = Add(Multiply(sry, src_pitch), Add(Multiply(sx_start, pb), i))
                dst_off = Add(Multiply(dry, dst_pitch), Add(Multiply(dst_x, pb), i))
                expected = GetByte(src_data, src_off)
                actual = GetByte(dst_data, dst_off)
                IfCondition NotEqual(actual, expected) ThenBlock: {
                    IfCondition EqualTo(fail, 0) ThenBlock: {
                        PrintMessage("  [FAIL] row=")
                        PrintNumber(row)
                        PrintMessage(" col=")
                        PrintNumber(i)
                        PrintMessage(" expected=")
                        PrintNumber(expected)
                        PrintMessage(" got=")
                        PrintNumber(actual)
                        PrintMessage("\n")
                    }
                    fail = Add(fail, 1)
                }
                i = Add(i, 1)
            }
            row = Add(row, 1)
        }
        IfCondition EqualTo(fail, 0) ThenBlock: {
            PrintMessage("  [PASS] Test 3\n")
        } ElseBlock: {
            PrintMessage("  [FAIL] Test 3 — ")
            PrintNumber(fail)
            PrintMessage(" mismatches\n")
        }

        Deallocate(src_data, Multiply(src_h, src_pitch))
        Deallocate(dst_data, Multiply(dst_h, dst_pitch))
    }
}

// =============================================================================
// TEST 4: MemoryCopy in row loop — Win_BlitOne clamped pattern
// Full clamping math + flattened addressing like commit 4142a01
// =============================================================================
Function.Test_WinBlitOnePattern {
    Body: {
        PrintMessage("\n=== TEST 4: Clamped row-loop MemoryCopy (Win_BlitOne) ===\n")
        pb = 4

        // Source surface: 320x240
        sw = 320
        sh = 240
        src_pitch = Multiply(sw, pb)
        src_data = Allocate(Multiply(sh, src_pitch))
        FillPattern(src_data, Multiply(sh, src_pitch))

        // Destination "framebuffer": 640x480
        fb_w = 640
        fb_h = 480
        dst_pitch = Multiply(fb_w, pb)
        dst_buf = Allocate(Multiply(fb_h, dst_pitch))
        FillBuffer(dst_buf, Multiply(fb_h, dst_pitch), 0)

        // Place window partially offscreen (top-left corner at -20, -10)
        dst_x = -20
        dst_y = -10

        draw_w = sw
        draw_h = sh
        src_x0 = 0
        src_y0 = 0

        // Left edge clamp
        IfCondition LessThan(dst_x, 0) ThenBlock: {
            src_x0 = Subtract(0, dst_x)
            draw_w = Subtract(sw, src_x0)
            dst_x = 0
        }
        // Top edge clamp
        IfCondition LessThan(dst_y, 0) ThenBlock: {
            src_y0 = Subtract(0, dst_y)
            draw_h = Subtract(sh, src_y0)
            dst_y = 0
        }
        // Right edge
        ovr_x = Subtract(Add(dst_x, draw_w), fb_w)
        IfCondition GreaterThan(ovr_x, 0) ThenBlock: {
            draw_w = Subtract(draw_w, ovr_x)
        }
        // Bottom edge
        ovr_y = Subtract(Add(dst_y, draw_h), fb_h)
        IfCondition GreaterThan(ovr_y, 0) ThenBlock: {
            draw_h = Subtract(draw_h, ovr_y)
        }

        IfCondition LessEqual(draw_w, 0) ThenBlock: {
            PrintMessage("  [SKIP] nothing to draw\n")
            ReturnValue(0)
        }
        IfCondition LessEqual(draw_h, 0) ThenBlock: {
            PrintMessage("  [SKIP] nothing to draw\n")
            ReturnValue(0)
        }

        row_bytes = Multiply(draw_w, pb)
        PrintMessage("  Clamped: draw_w=")
        PrintNumber(draw_w)
        PrintMessage(" draw_h=")
        PrintNumber(draw_h)
        PrintMessage(" src_x0=")
        PrintNumber(src_x0)
        PrintMessage(" src_y0=")
        PrintNumber(src_y0)
        PrintMessage("\n")
        PrintMessage("  Row loop: ")
        PrintNumber(draw_h)
        PrintMessage(" rows x ")
        PrintNumber(row_bytes)
        PrintMessage(" bytes...\n")

        y = 0
        WhileLoop LessThan(y, draw_h) {
            sry = Add(y, src_y0)
            dry = Add(y, dst_y)
            sr_off = Add(Multiply(sry, src_pitch), Multiply(src_x0, pb))
            src_row = Add(src_data, sr_off)
            dr_off = Add(Multiply(dry, dst_pitch), Multiply(dst_x, pb))
            dst_row = Add(dst_buf, dr_off)
            MemoryCopy(dst_row, src_row, row_bytes)
            y = Add(y, 1)
        }
        PrintMessage("  Loop done, verifying...\n")

        fail = 0
        y = 0
        WhileLoop LessThan(y, draw_h) {
            sry = Add(y, src_y0)
            dry = Add(y, dst_y)
            i = 0
            WhileLoop LessThan(i, row_bytes) {
                src_off = Add(Multiply(sry, src_pitch), Add(Multiply(src_x0, pb), i))
                dst_off = Add(Multiply(dry, dst_pitch), Add(Multiply(dst_x, pb), i))
                expected = GetByte(src_data, src_off)
                actual = GetByte(dst_buf, dst_off)
                IfCondition NotEqual(actual, expected) ThenBlock: {
                    IfCondition EqualTo(fail, 0) ThenBlock: {
                        PrintMessage("  [FAIL] row=")
                        PrintNumber(y)
                        PrintMessage(" col=")
                        PrintNumber(i)
                        PrintMessage(" expected=")
                        PrintNumber(expected)
                        PrintMessage(" got=")
                        PrintNumber(actual)
                        PrintMessage("\n")
                    }
                    fail = Add(fail, 1)
                }
                i = Add(i, 1)
            }
            y = Add(y, 1)
        }
        IfCondition EqualTo(fail, 0) ThenBlock: {
            PrintMessage("  [PASS] Test 4\n")
        } ElseBlock: {
            PrintMessage("  [FAIL] Test 4 — ")
            PrintNumber(fail)
            PrintMessage(" mismatches\n")
        }

        Deallocate(src_data, Multiply(sh, src_pitch))
        Deallocate(dst_buf, Multiply(fb_h, dst_pitch))
    }
}

// =============================================================================
// TEST 5: Multi-frame simulation — Deskbar_Draw called 100 times
// This tests whether the loop counter survives across many invocations
// =============================================================================
Function.Test_MultiFrame {
    Body: {
        PrintMessage("\n=== TEST 5: Multi-frame simulation (100 frames) ===\n")
        sw = 640
        db_h = 32
        pb = 4
        pit = Multiply(sw, pb)
        src_pitch = pit
        sh = 480

        src_size = Multiply(db_h, src_pitch)
        dst_size = Multiply(sh, pit)

        src_data = Allocate(src_size)
        buf = Allocate(dst_size)

        FillPattern(src_data, src_size)

        dst_y = Subtract(sh, db_h)
        row_bytes = Multiply(sw, pb)

        frame = 0
        WhileLoop LessThan(frame, 100) {
            // Clear dest region each frame
            cy = 0
            WhileLoop LessThan(cy, db_h) {
                off = Multiply(Add(dst_y, cy), pit)
                ci = 0
                WhileLoop LessThan(ci, row_bytes) {
                    SetByte(buf, Add(off, ci), 0)
                    ci = Add(ci, 1)
                }
                cy = Add(cy, 1)
            }

            // Deskbar_Draw pattern
            y = 0
            WhileLoop LessThan(y, db_h) {
                src_row = Add(src_data, Multiply(y, src_pitch))
                dst_ptr = Add(buf, Multiply(Add(dst_y, y), pit))
                MemoryCopy(dst_ptr, src_row, row_bytes)
                y = Add(y, 1)
            }

            // Quick verify: check first and last byte of first and last row
            first_dst = Multiply(dst_y, pit)
            last_dst = Multiply(Add(dst_y, Subtract(db_h, 1)), pit)
            first_src_val = GetByte(src_data, 0)
            last_src_off = Multiply(Subtract(db_h, 1), src_pitch)
            last_src_val = GetByte(src_data, last_src_off)

            a1 = GetByte(buf, first_dst)
            a2 = GetByte(buf, last_dst)
            IfCondition NotEqual(a1, first_src_val) ThenBlock: {
                PrintMessage("  [FAIL] frame=")
                PrintNumber(frame)
                PrintMessage(" first row mismatch\n")
                ReturnValue(0)
            }
            IfCondition NotEqual(a2, last_src_val) ThenBlock: {
                PrintMessage("  [FAIL] frame=")
                PrintNumber(frame)
                PrintMessage(" last row mismatch\n")
                ReturnValue(0)
            }

            frame = Add(frame, 1)
        }
        PrintMessage("  [PASS] Test 5 — 100 frames OK\n")

        Deallocate(src_data, src_size)
        Deallocate(buf, dst_size)
    }
}

// =============================================================================
// TEST 6: Combined blit pipeline — simulates Win_BlitAll
// Desktop blit + window blit + deskbar draw + FB_FlipFast
// =============================================================================
Function.Test_FullPipeline {
    Body: {
        PrintMessage("\n=== TEST 6: Full blit pipeline simulation ===\n")
        pb = 4
        fb_w = 640
        fb_h = 480
        fb_pitch = Multiply(fb_w, pb)
        fb_size = Multiply(fb_h, fb_pitch)

        // "Framebuffer" back buffer
        back_buf = Allocate(fb_size)
        // "Framebuffer" front buffer
        front_buf = Allocate(fb_size)

        // Desktop surface (full screen)
        desk_surf = Allocate(fb_size)
        FillBuffer(desk_surf, fb_size, 0x1A)

        // Window surface (200x100)
        win_w = 200
        win_h = 100
        win_pitch = Multiply(win_w, pb)
        win_size = Multiply(win_h, win_pitch)
        win_surf = Allocate(win_size)
        FillBuffer(win_surf, win_size, 0x55)

        // Deskbar surface (640x32)
        db_h = 32
        db_pitch = Multiply(fb_w, pb)
        db_size = Multiply(db_h, db_pitch)
        db_surf = Allocate(db_size)
        FillBuffer(db_surf, db_size, 0xAA)

        PrintMessage("  Running 50 frame pipeline...\n")

        frame = 0
        WhileLoop LessThan(frame, 50) {
            // 1. Blit desktop to back buffer (Win_BlitOne for desktop, full screen)
            MemoryCopy(back_buf, desk_surf, fb_size)

            // 2. Blit window at position (100, 50) — Win_BlitOne pattern
            win_x = 100
            win_y = 50
            row_bytes_w = Multiply(win_w, pb)
            wy = 0
            WhileLoop LessThan(wy, win_h) {
                src_row = Add(win_surf, Multiply(wy, win_pitch))
                dry = Add(win_y, wy)
                dr_off = Add(Multiply(dry, fb_pitch), Multiply(win_x, pb))
                dst_row = Add(back_buf, dr_off)
                MemoryCopy(dst_row, src_row, row_bytes_w)
                wy = Add(wy, 1)
            }

            // 3. Blit deskbar at bottom — Deskbar_Draw pattern
            dst_y = Subtract(fb_h, db_h)
            row_bytes_d = Multiply(fb_w, pb)
            dy = 0
            WhileLoop LessThan(dy, db_h) {
                src_row2 = Add(db_surf, Multiply(dy, db_pitch))
                dst_ptr2 = Add(back_buf, Multiply(Add(dst_y, dy), fb_pitch))
                MemoryCopy(dst_ptr2, src_row2, row_bytes_d)
                dy = Add(dy, 1)
            }

            // 4. FB_FlipFast — copy back buffer to front
            MemoryCopy(front_buf, back_buf, fb_size)

            frame = Add(frame, 1)
        }

        // Verify: deskbar region in front_buf should be 0xAA
        dst_y2 = Subtract(fb_h, db_h)
        check_off = Multiply(dst_y2, fb_pitch)
        ok1 = GetByte(front_buf, check_off)
        // Window region at (100,50) should be 0x55
        win_off = Add(Multiply(50, fb_pitch), Multiply(100, pb))
        ok2 = GetByte(front_buf, win_off)
        // Desktop region at (0,0) should be 0x1A
        ok3 = GetByte(front_buf, 0)

        pass = 1
        IfCondition NotEqual(ok1, 0xAA) ThenBlock: {
            PrintMessage("  [FAIL] Deskbar region: expected 0xAA got ")
            PrintNumber(ok1)
            PrintMessage("\n")
            pass = 0
        }
        IfCondition NotEqual(ok2, 0x55) ThenBlock: {
            PrintMessage("  [FAIL] Window region: expected 0x55 got ")
            PrintNumber(ok2)
            PrintMessage("\n")
            pass = 0
        }
        IfCondition NotEqual(ok3, 0x1A) ThenBlock: {
            PrintMessage("  [FAIL] Desktop region: expected 0x1A got ")
            PrintNumber(ok3)
            PrintMessage("\n")
            pass = 0
        }
        IfCondition EqualTo(pass, 1) ThenBlock: {
            PrintMessage("  [PASS] Test 6 — 50 frame pipeline OK\n")
        }

        Deallocate(back_buf, fb_size)
        Deallocate(front_buf, fb_size)
        Deallocate(desk_surf, fb_size)
        Deallocate(win_surf, win_size)
        Deallocate(db_surf, db_size)
    }
}

// =============================================================================
// MAIN
// =============================================================================
SubRoutine.Main {
    PrintMessage("=== MemoryCopy Blit Stress Test ===\n")
    PrintMessage("Compiler: ailang.x with CLD + register save/restore + stack cleanup\n")

    Test_SingleCopy()
    Test_DeskbarPattern()
    Test_SurfaceBlitPattern()
    Test_WinBlitOnePattern()
    Test_MultiFrame()
    Test_FullPipeline()

    PrintMessage("\n=== ALL TESTS COMPLETE ===\n")
}

RunTask(Main)
