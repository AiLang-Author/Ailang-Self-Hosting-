// test_mmio_diag.ailang — MMIO diagnostics for GPU 0
// Build: ./ailang.x TestCode/test_mmio_diag.ailang test_mmio_diag.x
// Run:   sg video -c "./test_mmio_diag.x"
//
// Reads various registers at known offsets to verify MMIO is working.

LibraryImport.Arena
LibraryImport.Drivers.AMDGPU.AMDGPUFamily
LibraryImport.Drivers.AMDGPU.AMDGPUDiscover
LibraryImport.Drivers.AMDGPU.AMDGPUBAR
LibraryImport.Drivers.AMDGPU.AMDGPUSMCRegs
LibraryImport.Drivers.AMDGPU.AMDGPUSMC_SI
LibraryImport.Drivers.AMDGPU.AMDGPUDisplay
LibraryImport.Drivers.AMDGPU.AMDGPUPM4Regs

SubRoutine.Main {
    PrintMessage("=== MMIO Diagnostic ===\n\n")

    count = GPU_Discover()
    IfCondition EqualTo(count, 0) ThenBlock: {
        PrintMessage("No GPUs found.\n")
        SystemCall(60, 1, 0, 0, 0, 0)
    }

    GPU_BAR_Init()
    gi = 0
    WhileLoop LessThan(gi, count) {
        GPU_BAR_MapMMIO(gi)
        gi = Add(gi, 1)
    }

    // Test GPU 0
    gpu = 0
    PrintMessage("Testing GPU 0 (bus 02:00.0)\n\n")

    // Read a bunch of registers at various offsets
    // The GRBM_STATUS register at offset 0x8010 should have non-zero bits
    // Actually that's in BAR0. BAR2 only covers 256KB (0x0000-0x3FFFF).
    // Let's read registers within BAR2 range.

    // IND_ACCESS_CNTL at 0x228
    PrintMessage("IND_ACCESS_CNTL  (0x228):  0x")
    PrintHex(GPU_Rd32(gpu, 552))
    PrintMessage("\n")

    // SMC MESSAGE_0 at 0x22C
    PrintMessage("MESSAGE_0        (0x22C):  0x")
    PrintHex(GPU_Rd32(gpu, 556))
    PrintMessage("\n")

    // SMC RESP_0 at 0x230
    PrintMessage("RESP_0           (0x230):  0x")
    PrintHex(GPU_Rd32(gpu, 560))
    PrintMessage("\n")

    // GENERAL_PWRMGT at 0x780
    PrintMessage("GENERAL_PWRMGT   (0x780):  0x")
    PrintHex(GPU_Rd32(gpu, 1920))
    PrintMessage("\n")

    // SCLK_PWRMGT_CNTL at 0x788
    PrintMessage("SCLK_PWRMGT_CNTL (0x788):  0x")
    PrintHex(GPU_Rd32(gpu, 1928))
    PrintMessage("\n")

    // CG_THERMAL_STATUS at 0x704 — should show temperature
    PrintMessage("CG_THERMAL_STATUS(0x704):  0x")
    PrintHex(GPU_Rd32(gpu, 1796))
    PrintMessage("\n")

    // CG_SPLL_FUNC_CNTL at 0x600 — should have non-zero PLL config
    PrintMessage("CG_SPLL_FUNC_CNTL(0x600):  0x")
    PrintHex(GPU_Rd32(gpu, SIReg.CG_SPLL_FUNC_CNTL))
    PrintMessage("\n")

    // CG_SPLL_FUNC_CNTL_2 at 0x604
    PrintMessage("SPLL_FUNC_CNTL_2 (0x604):  0x")
    PrintHex(GPU_Rd32(gpu, SIReg.CG_SPLL_FUNC_CNTL_2))
    PrintMessage("\n")

    // CG_SPLL_FUNC_CNTL_3 at 0x608
    PrintMessage("SPLL_FUNC_CNTL_3 (0x608):  0x")
    PrintHex(GPU_Rd32(gpu, SIReg.CG_SPLL_FUNC_CNTL_3))
    PrintMessage("\n")

    // CB_CGTT_SCLK_CTRL at 0x9A60
    PrintMessage("CB_CGTT_SCLK_CTL (0x9A60): 0x")
    PrintHex(GPU_Rd32(gpu, 39520))
    PrintMessage("\n")

    // Write test: write a pattern to IND_INDEX_0, read it back
    PrintMessage("\nWrite test: writing 0xDEADBEEF to IND_INDEX_0 (0x200)\n")
    GPU_Wr32(gpu, 512, 3735928559)
    readback = GPU_Rd32(gpu, 512)
    PrintMessage("  Read back: 0x")
    PrintHex(readback)
    IfCondition EqualTo(readback, 3735928559) ThenBlock: {
        PrintMessage(" MATCH\n")
    }
    ElseBlock: {
        PrintMessage(" MISMATCH!\n")
    }

    // Write 0 to clean up
    GPU_Wr32(gpu, 512, 0)

    // Try SMC indirect access: write a known address, read back
    PrintMessage("\nSMC indirect test: reading SRAM addr 0 via IND path\n")
    GPU_Wr32(gpu, SMCReg.IND_INDEX_0, 0)
    val = GPU_Rd32(gpu, SMCReg.IND_DATA_0)
    PrintMessage("  SRAM[0x0] = 0x")
    PrintHex(val)
    PrintMessage("\n")

    // Try writing a value to SRAM and reading it back
    PrintMessage("  Writing 0x12345678 to SRAM[0x100]...\n")
    GPU_Wr32(gpu, SMCReg.IND_INDEX_0, 256)
    GPU_Wr32(gpu, SMCReg.IND_DATA_0, 305419896)
    // Read back
    GPU_Wr32(gpu, SMCReg.IND_INDEX_0, 256)
    val = GPU_Rd32(gpu, SMCReg.IND_DATA_0)
    PrintMessage("  SRAM[0x100] = 0x")
    PrintHex(val)
    IfCondition EqualTo(val, 305419896) ThenBlock: {
        PrintMessage(" MATCH\n")
    }
    ElseBlock: {
        PrintMessage(" MISMATCH!\n")
    }

    PrintMessage("\n--- GPU 1 (bus 01:00.0) for comparison ---\n")
    gpu = 1
    PrintMessage("GENERAL_PWRMGT   (0x780):  0x")
    PrintHex(GPU_Rd32(gpu, 1920))
    PrintMessage("\n")
    PrintMessage("SCLK_PWRMGT_CNTL (0x788):  0x")
    PrintHex(GPU_Rd32(gpu, 1928))
    PrintMessage("\n")
    PrintMessage("CG_THERMAL_STATUS(0x704):  0x")
    PrintHex(GPU_Rd32(gpu, 1796))
    PrintMessage("\n")
    PrintMessage("CG_SPLL_FUNC_CNTL(0x600):  0x")
    PrintHex(GPU_Rd32(gpu, SIReg.CG_SPLL_FUNC_CNTL))
    PrintMessage("\n")

    // Cleanup
    gi = 0
    WhileLoop LessThan(gi, count) {
        GPU_BAR_Unmap(gi)
        gi = Add(gi, 1)
    }

    PrintMessage("\n=== MMIO Diagnostic Complete ===\n")
    SystemCall(60, 0, 0, 0, 0, 0)
}

RunTask(Main)
