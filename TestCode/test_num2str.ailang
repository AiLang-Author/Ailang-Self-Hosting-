// Test NumberToString from a Function, mirroring wc's PrintFormattedNumber.
LibraryImport.Arena

Function.GetStringLength {
    Input: str: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(str, 0) ThenBlock: { ReturnValue(0) }
        len = 0
        WhileLoop NotEqual(GetByte(str, len), 0) {
            len = Add(len, 1)
        }
        ReturnValue(len)
    }
}

Function.PrintFormattedNumber {
    Input: num: Integer
    Body: {
        num_str = NumberToString(num)
        num_len = GetStringLength(num_str)
        SystemCall(1, 1, "len=", 4)
        PrintNumber(num_len)
        SystemCall(1, 1, " str=", 5)
        SystemCall(1, 1, num_str, num_len)
        SystemCall(1, 1, "\n", 1)
    }
}

SubRoutine.Main {
    PrintFormattedNumber(3)
    PrintFormattedNumber(42)
    PrintFormattedNumber(0)
    PrintFormattedNumber(1000)
    SystemCall(60, 0)
}
RunTask(Main)
