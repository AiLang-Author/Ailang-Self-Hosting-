// test_numbertostring.ailang
// Focused test for NumberToString - verifies correctness for
// integer display use cases (TUI, audio meters, DSP values)
// Run: load test_numbertostring.ailang -> build test_nts.x -> ./test_nts.x

LibraryImport.Arena
SubRoutine.Main {

    PrintMessage("=== NumberToString Test Suite ===\n\n")

    // --- Zero ---
    PrintMessage("[1] Zero\n")
    PrintMessage("  NumberToString(0)        = [")
    PrintMessage(NumberToString(0))
    PrintMessage("]  expect: [0]\n\n")

    // --- Positive integers ---
    PrintMessage("[2] Positive integers\n")
    PrintMessage("  NumberToString(1)        = [")
    PrintMessage(NumberToString(1))
    PrintMessage("]  expect: [1]\n")
    PrintMessage("  NumberToString(42)       = [")
    PrintMessage(NumberToString(42))
    PrintMessage("]  expect: [42]\n")
    PrintMessage("  NumberToString(100)      = [")
    PrintMessage(NumberToString(100))
    PrintMessage("]  expect: [100]\n")
    PrintMessage("  NumberToString(9999)     = [")
    PrintMessage(NumberToString(9999))
    PrintMessage("]  expect: [9999]\n")
    PrintMessage("  NumberToString(44100)    = [")
    PrintMessage(NumberToString(44100))
    PrintMessage("]  expect: [44100]\n")
    PrintMessage("  NumberToString(48000)    = [")
    PrintMessage(NumberToString(48000))
    PrintMessage("]  expect: [48000]\n")
    PrintMessage("  NumberToString(1048576)  = [")
    PrintMessage(NumberToString(1048576))
    PrintMessage("]  expect: [1048576]\n\n")

    // --- Negative integers ---
    PrintMessage("[3] Negative integers\n")
    PrintMessage("  NumberToString(-1)       = [")
    PrintMessage(NumberToString(-1))
    PrintMessage("]  expect: [-1]\n")
    PrintMessage("  NumberToString(-42)      = [")
    PrintMessage(NumberToString(-42))
    PrintMessage("]  expect: [-42]\n")
    PrintMessage("  NumberToString(-9999)    = [")
    PrintMessage(NumberToString(-9999))
    PrintMessage("]  expect: [-9999]\n")
    PrintMessage("  NumberToString(-32768)   = [")
    PrintMessage(NumberToString(-32768))
    PrintMessage("]  expect: [-32768]\n\n")

    // --- Boundary / powers of 10 ---
    PrintMessage("[4] Powers of ten\n")
    PrintMessage("  NumberToString(10)       = [")
    PrintMessage(NumberToString(10))
    PrintMessage("]  expect: [10]\n")
    PrintMessage("  NumberToString(100)      = [")
    PrintMessage(NumberToString(100))
    PrintMessage("]  expect: [100]\n")
    PrintMessage("  NumberToString(1000)     = [")
    PrintMessage(NumberToString(1000))
    PrintMessage("]  expect: [1000]\n")
    PrintMessage("  NumberToString(10000)    = [")
    PrintMessage(NumberToString(10000))
    PrintMessage("]  expect: [10000]\n")
    PrintMessage("  NumberToString(100000)   = [")
    PrintMessage(NumberToString(100000))
    PrintMessage("]  expect: [100000]\n\n")

    // --- Use in string concat (critical for TUI display) ---
    PrintMessage("[5] StringConcat with NumberToString\n")
    sample_rate = 44100
    bit_depth = 16
    channels = 2
    PrintMessage("  Sample rate : ")
    PrintMessage(StringConcat(NumberToString(sample_rate), " Hz"))
    PrintMessage("\n")
    PrintMessage("  Bit depth   : ")
    PrintMessage(StringConcat(NumberToString(bit_depth), " bit"))
    PrintMessage("\n")
    PrintMessage("  Channels    : ")
    PrintMessage(StringConcat(NumberToString(channels), " ch"))
    PrintMessage("\n\n")

    // --- Computed values (not literals) ---
    PrintMessage("[6] Computed values\n")
    a = 255
    b = 128
    diff = Subtract(a, b)
    PrintMessage("  255 - 128   = [")
    PrintMessage(NumberToString(diff))
    PrintMessage("]  expect: [127]\n")
    product = Multiply(6, 7)
    PrintMessage("  6 * 7       = [")
    PrintMessage(NumberToString(product))
    PrintMessage("]  expect: [42]\n")
    modval = Modulo(44100, 1000)
    PrintMessage("  44100 % 1000= [")
    PrintMessage(NumberToString(modval))
    PrintMessage("]  expect: [100]\n\n")

    PrintMessage("=== Done ===\n")
}

RunTask(Main)