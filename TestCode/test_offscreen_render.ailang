Function.App_CreateDocWindow {
    Body: {
        PrintMessage("[STUB] App_CreateDocWindow\n")
    }
}
Function.App_AddLine {
    Body: {
        PrintMessage("[STUB] App_AddLine\n")
    }
}

// Stub SysDisplay_GetDBConn — we store the conn ourselves
FixedPool.TestDBState {
    "conn": Initialize=0, CanChange=True
}
Function.SysDisplay_GetDBConn {
    Output: Integer
    Body: { ReturnValue(TestDBState.conn) }
}

// Stub SysDisplayState.dirty so FileDialog/Dialog can set it
FixedPool.SysDisplayState {
    "dirty":    Initialize=0, CanChange=True
    "frame_count": Initialize=0, CanChange=True
}

// We need WinManager stubs or the real thing.
// WinColor is used by Dialog_Render, Win_Create, etc.
