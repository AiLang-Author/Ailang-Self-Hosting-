// test_offscreen_render.ailang
// Render one full "frame" offscreen: toolbar, menu, deskbar, file dialog.
// Dump each surface to PPM files you can view without a framebuffer.
//
// Build & Run:
//   cd /home/bob/Ailang-Self-Hosting-
//   ./ailang.x TestCode/test_offscreen_render.ailang test_offscreen.x
//   ./test_offscreen.x
//   # then: feh /tmp/ak_*.ppm  or  eog /tmp/ak_*.ppm
//
// Requires: PostgreSQL running, database ailang_system, user bob

LibraryImport.Arena
LibraryImport.Socket
LibraryImport.Hash
LibraryImport.Arrays
LibraryImport.StringUtils
LibraryImport.PostgreSQL_Complete

LibraryImport.Display.Render.DSurfaceTypes
LibraryImport.Display.Render.DSurface
LibraryImport.Display.Render.DDrawPixel
LibraryImport.Display.UI.Auckland
LibraryImport.Display.UI.AucklandEvent
LibraryImport.Display.Render.VIF
LibraryImport.Display.Render.SurfaceBlit
LibraryImport.Display.Render.Fonts
LibraryImport.Display.UI.TextRegion

