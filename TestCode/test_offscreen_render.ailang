// =============================================================================
// PPM WRITER — dump surface to P6 PPM file
// Surface is BGRA (4 bytes/pixel). PPM P6 wants RGB (3 bytes/pixel).
// =============================================================================
Function.DumpSurfacePPM {
    Input: surf: Integer
    Input: path: Address
    Body: {
        IfCondition EqualTo(surf, 0) ThenBlock: {
            PrintMessage("  [SKIP] null surface\n")
            ReturnValue(0)
        }

        w     = Surface_GetWidth(surf)
        h     = Surface_GetHeight(surf)
        pitch = Surface_GetPitch(surf)
        data  = Surface_GetData(surf)

        PrintMessage("  Dumping ")
        PrintNumber(w)
        PrintMessage("x")
        PrintNumber(h)
        PrintMessage(" to ")
        PrintString(path)
        PrintMessage("\n")

        // Open file: open(path, O_WRONLY|O_CREAT|O_TRUNC, 0644)
        // O_WRONLY=1, O_CREAT=64, O_TRUNC=512 => 577
        fd = SystemCall(2, path, 577, 420)
        IfCondition LessThan(fd, 0) ThenBlock: {
            PrintMessage("  [ERR] cannot open file\n")
            ReturnValue(0)
        }

        // Write PPM header: "P6\n<w> <h>\n255\n"
        hdr_p6 = "P6\n"
        SystemCall(1, fd, hdr_p6, 3)
        w_str = NumberToString(w)
        SystemCall(1, fd, w_str, StringLength(w_str))
        SystemCall(1, fd, " ", 1)
        h_str = NumberToString(h)
        SystemCall(1, fd, h_str, StringLength(h_str))
        SystemCall(1, fd, "\n255\n", 5)

        // Write pixel data: convert BGRA -> RGB
        rgb_row = Allocate(Multiply(w, 3))

        y = 0
        WhileLoop LessThan(y, h) {
            row_ptr = Add(data, Multiply(y, pitch))
            x = 0
            WhileLoop LessThan(x, w) {
                src_off = Multiply(x, 4)
                dst_off = Multiply(x, 3)
                b_val = GetByte(row_ptr, src_off)
                g_val = GetByte(row_ptr, Add(src_off, 1))
                r_val = GetByte(row_ptr, Add(src_off, 2))
                // PPM is RGB
                SetByte(rgb_row, dst_off, r_val)
                SetByte(rgb_row, Add(dst_off, 1), g_val)
                SetByte(rgb_row, Add(dst_off, 2), b_val)
                x = Add(x, 1)
            }
            SystemCall(1, fd, rgb_row, Multiply(w, 3))
            y = Add(y, 1)
        }

        Deallocate(rgb_row, Multiply(w, 3))
        SystemCall(3, fd, 0, 0)
        PrintMessage("  [OK] wrote PPM\n")
    }
}

// =============================================================================
// TEST 1: Toolbar render
// =============================================================================
Function.Test_Toolbar {
    Body: {
        PrintMessage("\n=== RENDER: Toolbar (320x24) ===\n")
        tb_w = 320
        tb_h = 24

        surf = Surface_Create(SurfaceFormat.PIXEL_32, tb_w, tb_h)
        IfCondition EqualTo(surf, 0) ThenBlock: {
            PrintMessage("  [FAIL] surface alloc\n")
            ReturnValue(0)
        }

        ctx = AK_CreateContext()
        IfCondition EqualTo(ctx, 0) ThenBlock: {
            PrintMessage("  [FAIL] AK_CreateContext\n")
            ReturnValue(0)
        }

        // Build toolbar tree — same as Win_BuildDefaultToolbar
        root = AK_CreateNode(ctx, AKTag.GROUP)
        AK_Set(ctx, root, AKF.LAYOUT_MODE, AKLayout.HBOX)
        AK_Set(ctx, root, AKF.GAP, 0)
        AK_Set(ctx, root, AKF.PAD_T, 0)
        AK_Set(ctx, root, AKF.PAD_R, 0)
        AK_Set(ctx, root, AKF.PAD_B, 0)
        AK_Set(ctx, root, AKF.PAD_L, 0)
        AK_ExtraSet(ctx, root, AKExtra.COLOR_BG, TVG_PackColor(42, 42, 42, 255))
        AK_SetRoot(ctx, root)

        btn_file = AK_CreateNode(ctx, AKTag.BUTTON)
        AK_Set(ctx, btn_file, AKF.MIN_W, 48)
        AK_Set(ctx, btn_file, AKF.HEIGHT, 24)
        AK_ExtraSet(ctx, btn_file, AKExtra.STR_PTR, "File")
        AK_ExtraSet(ctx, btn_file, AKExtra.STR_LEN, 4)
        AK_ExtraSet(ctx, btn_file, AKExtra.ACTION_PTR, "menu:file")
        AK_ExtraSet(ctx, btn_file, AKExtra.ACTION_LEN, 9)
        AK_ExtraSet(ctx, btn_file, AKExtra.TEXT_ALIGN, TRAlign.CENTER)
        AK_AddChild(ctx, root, btn_file)

        btn_edit = AK_CreateNode(ctx, AKTag.BUTTON)
        AK_Set(ctx, btn_edit, AKF.MIN_W, 48)
        AK_Set(ctx, btn_edit, AKF.HEIGHT, 24)
        AK_ExtraSet(ctx, btn_edit, AKExtra.STR_PTR, "Edit")
        AK_ExtraSet(ctx, btn_edit, AKExtra.STR_LEN, 4)
        AK_ExtraSet(ctx, btn_edit, AKExtra.ACTION_PTR, "menu:edit")
        AK_ExtraSet(ctx, btn_edit, AKExtra.ACTION_LEN, 9)
        AK_ExtraSet(ctx, btn_edit, AKExtra.TEXT_ALIGN, TRAlign.CENTER)
        AK_AddChild(ctx, root, btn_edit)

        btn_view = AK_CreateNode(ctx, AKTag.BUTTON)
        AK_Set(ctx, btn_view, AKF.MIN_W, 48)
        AK_Set(ctx, btn_view, AKF.HEIGHT, 24)
        AK_ExtraSet(ctx, btn_view, AKExtra.STR_PTR, "View")
        AK_ExtraSet(ctx, btn_view, AKExtra.STR_LEN, 4)
        AK_ExtraSet(ctx, btn_view, AKExtra.TEXT_ALIGN, TRAlign.CENTER)
        AK_AddChild(ctx, root, btn_view)

        btn_help = AK_CreateNode(ctx, AKTag.BUTTON)
        AK_Set(ctx, btn_help, AKF.MIN_W, 48)
        AK_Set(ctx, btn_help, AKF.HEIGHT, 24)
        AK_ExtraSet(ctx, btn_help, AKExtra.STR_PTR, "Help")
        AK_ExtraSet(ctx, btn_help, AKExtra.STR_LEN, 4)
        AK_ExtraSet(ctx, btn_help, AKExtra.TEXT_ALIGN, TRAlign.CENTER)
        AK_AddChild(ctx, root, btn_help)

        spc = AK_CreateNode(ctx, AKTag.SPACER)
        AK_Set(ctx, spc, AKF.GROW, 1)
        AK_AddChild(ctx, root, spc)

        lbl = AK_CreateNode(ctx, AKTag.LABEL)
        AK_Set(ctx, lbl, AKF.HEIGHT, 24)
        AK_ExtraSet(ctx, lbl, AKExtra.STR_PTR, "Application")
        AK_ExtraSet(ctx, lbl, AKExtra.STR_LEN, 11)
        AK_ExtraSet(ctx, lbl, AKExtra.TEXT_ALIGN, TRAlign.RIGHT)
        AK_ExtraSet(ctx, lbl, AKExtra.COLOR_FG, TVG_PackColor(136, 136, 136, 255))
        AK_ExtraSet(ctx, lbl, AKExtra.FONT_SIZE, 12)
        AK_AddChild(ctx, root, lbl)

        btn_close = AK_CreateNode(ctx, AKTag.BUTTON)
        AK_Set(ctx, btn_close, AKF.MIN_W, 28)
        AK_Set(ctx, btn_close, AKF.HEIGHT, 24)
        AK_ExtraSet(ctx, btn_close, AKExtra.STR_PTR, "X")
        AK_ExtraSet(ctx, btn_close, AKExtra.STR_LEN, 1)
        AK_ExtraSet(ctx, btn_close, AKExtra.COLOR_BG, TVG_PackColor(200, 40, 40, 255))
        AK_ExtraSet(ctx, btn_close, AKExtra.COLOR_FG, TVG_PackColor(255, 255, 255, 255))
        AK_ExtraSet(ctx, btn_close, AKExtra.TEXT_ALIGN, TRAlign.CENTER)
        AK_AddChild(ctx, root, btn_close)

        PrintMessage("  Tree: ")
        PrintNumber(AK_GetTreeCount(ctx))
        PrintMessage(" nodes\n")

        // Render
        Draw_Pix_FillRect(surf, 0, 0, tb_w, tb_h, 0xFF2A2A2A)
        PrintMessage("  AK_Draw...\n")
        AK_Draw(ctx, surf, tb_w, tb_h)
        PrintMessage("  AK_Draw done\n")

        DumpSurfacePPM(surf, "/tmp/ak_toolbar.ppm")

        AK_DestroyContext(ctx)
        Surface_Destroy(surf)
    }
}

// =============================================================================
// TEST 2: Menu render (File menu)
// =============================================================================
Function.Test_Menu {
    Body: {
        PrintMessage("\n=== RENDER: File Menu (168x60) ===\n")
        menu_w = 168
        menu_h = 164

        surf = Surface_Create(SurfaceFormat.PIXEL_32, menu_w, menu_h)
        IfCondition EqualTo(surf, 0) ThenBlock: {
            PrintMessage("  [FAIL] surface alloc\n")
            ReturnValue(0)
        }

        ctx = AK_CreateContext()
        IfCondition EqualTo(ctx, 0) ThenBlock: {
            PrintMessage("  [FAIL] AK_CreateContext\n")
            ReturnValue(0)
        }

        AK_SetDesignW(ctx, menu_w)
        AK_SetDesignH(ctx, menu_h)

        // Same as Menu_Show + Menu_BuildFile
        root = AK_CreateNode(ctx, AKTag.PANEL)
        AK_Set(ctx, root, AKF.LAYOUT_MODE, AKLayout.VBOX)
        AK_Set(ctx, root, AKF.GAP, 0)
        AK_Set(ctx, root, AKF.PAD_T, 4)
        AK_Set(ctx, root, AKF.PAD_R, 4)
        AK_Set(ctx, root, AKF.PAD_B, 4)
        AK_Set(ctx, root, AKF.PAD_L, 4)
        AK_ExtraSet(ctx, root, AKExtra.COLOR_BG, 0xFF32323C)
        AK_ExtraSet(ctx, root, AKExtra.BORDER_W, 1)
        AK_ExtraSet(ctx, root, AKExtra.BORDER_CLR, 0xFF505064)
        AK_SetRoot(ctx, root)

        iw = 160
        Menu_AddItem(ctx, root, "New Window", 10, "win.new", 7)
        Menu_AddItem(ctx, root, "Open File", 9, "app.files", 9)
        Menu_AddSeparator(ctx, root, iw)
        Menu_AddItem(ctx, root, "Close", 5, "win.close", 9)
        Menu_AddSeparator(ctx, root, iw)
        Menu_AddItem(ctx, root, "Quit", 4, "app.quit", 8)

        // Compute proper height
        menu_h = Menu_ComputeHeight(ctx, root)
        PrintMessage("  Computed height: ")
        PrintNumber(menu_h)
        PrintMessage("\n")

        PrintMessage("  Tree: ")
        PrintNumber(AK_GetTreeCount(ctx))
        PrintMessage(" nodes\n")

        // Render
        Draw_Pix_FillRect(surf, 0, 0, menu_w, menu_h, 0xFF32323C)
        PrintMessage("  AK_Draw...\n")
        AK_Draw(ctx, surf, menu_w, menu_h)
        PrintMessage("  AK_Draw done\n")

        DumpSurfacePPM(surf, "/tmp/ak_menu_file.ppm")

        PrintMessage("  Destroying menu ctx...\n")
        AK_DestroyContext(ctx)
        PrintMessage("  Destroying menu surface...\n")
        Surface_Destroy(surf)
        PrintMessage("  Menu test complete\n")
    }
}

// =============================================================================
// TEST 3: Deskbar render
// =============================================================================
Function.Test_Deskbar {
    Body: {
        PrintMessage("\n=== RENDER: Deskbar (640x40) ===\n")
        PrintMessage("  [DBG] entered Test_Deskbar\n")
        db_w = 640
        db_h = 40

        PrintMessage("  Creating surface...\n")
        surf = Surface_Create(SurfaceFormat.PIXEL_32, db_w, db_h)
        IfCondition EqualTo(surf, 0) ThenBlock: {
            PrintMessage("  [FAIL] surface alloc\n")
            ReturnValue(0)
        }
        PrintMessage("  Surface OK\n")

        ctx = AK_CreateContext()
        IfCondition EqualTo(ctx, 0) ThenBlock: {
            PrintMessage("  [FAIL] AK_CreateContext\n")
            ReturnValue(0)
        }
        PrintMessage("  Context OK\n")

        // Same as Deskbar_BuildTree — using PANEL so AK_ExtraSet works
        root = AK_CreateNode(ctx, AKTag.PANEL)
        AK_Set(ctx, root, AKF.LAYOUT_MODE, AKLayout.HBOX)
        AK_Set(ctx, root, AKF.GAP, 4)
        AK_Set(ctx, root, AKF.PAD_T, 4)
        AK_Set(ctx, root, AKF.PAD_R, 8)
        AK_Set(ctx, root, AKF.PAD_B, 4)
        AK_Set(ctx, root, AKF.PAD_L, 8)
        AK_ExtraSet(ctx, root, AKExtra.COLOR_BG, TVG_PackColor(26, 26, 46, 255))
        AK_SetRoot(ctx, root)

        btn_new = AK_CreateNode(ctx, AKTag.BUTTON)
        AK_Set(ctx, btn_new, AKF.MIN_W, 64)
        AK_Set(ctx, btn_new, AKF.HEIGHT, 32)
        AK_ExtraSet(ctx, btn_new, AKExtra.STR_PTR, "New")
        AK_ExtraSet(ctx, btn_new, AKExtra.STR_LEN, 3)
        AK_ExtraSet(ctx, btn_new, AKExtra.COLOR_BG, TVG_PackColor(40, 80, 160, 255))
        AK_ExtraSet(ctx, btn_new, AKExtra.COLOR_FG, TVG_PackColor(255, 255, 255, 255))
        AK_AddChild(ctx, root, btn_new)

        btn_files = AK_CreateNode(ctx, AKTag.BUTTON)
        AK_Set(ctx, btn_files, AKF.MIN_W, 64)
        AK_Set(ctx, btn_files, AKF.HEIGHT, 32)
        AK_ExtraSet(ctx, btn_files, AKExtra.STR_PTR, "Files")
        AK_ExtraSet(ctx, btn_files, AKExtra.STR_LEN, 5)
        AK_ExtraSet(ctx, btn_files, AKExtra.COLOR_BG, TVG_PackColor(40, 80, 160, 255))
        AK_ExtraSet(ctx, btn_files, AKExtra.COLOR_FG, TVG_PackColor(255, 255, 255, 255))
        AK_AddChild(ctx, root, btn_files)

        spc = AK_CreateNode(ctx, AKTag.SPACER)
        AK_Set(ctx, spc, AKF.GROW, 1)
        AK_AddChild(ctx, root, spc)

        btn_about = AK_CreateNode(ctx, AKTag.BUTTON)
        AK_Set(ctx, btn_about, AKF.MIN_W, 56)
        AK_Set(ctx, btn_about, AKF.HEIGHT, 32)
        AK_ExtraSet(ctx, btn_about, AKExtra.STR_PTR, "About")
        AK_ExtraSet(ctx, btn_about, AKExtra.STR_LEN, 5)
        AK_ExtraSet(ctx, btn_about, AKExtra.COLOR_BG, TVG_PackColor(60, 60, 80, 255))
        AK_ExtraSet(ctx, btn_about, AKExtra.COLOR_FG, TVG_PackColor(180, 180, 200, 255))
        AK_AddChild(ctx, root, btn_about)

        PrintMessage("  Tree: ")
        PrintNumber(AK_GetTreeCount(ctx))
        PrintMessage(" nodes\n")

        // Render
        PrintMessage("  FillRect...\n")
        Draw_Pix_FillRect(surf, 0, 0, db_w, db_h, TVG_PackColor(26, 26, 46, 255))
        PrintMessage("  AK_Draw...\n")
        AK_Draw(ctx, surf, db_w, db_h)
        PrintMessage("  AK_Draw done\n")

        DumpSurfacePPM(surf, "/tmp/ak_deskbar.ppm")

        AK_DestroyContext(ctx)
        Surface_Destroy(surf)
        PrintMessage("  Deskbar test complete\n")
    }
}

// =============================================================================
// TEST 4: File dialog — the real thing via FileDialog_Open
// This calls the actual FileDialog_Open -> Dialog_Create -> Win_Create
// -> FD_BuildTree -> FD_PopulateFiles -> Dialog_Render chain.
// =============================================================================
Function.Test_FileDialog {
    Body: {
        PrintMessage("\n=== RENDER: File Dialog (real FileDialog_Open) ===\n")
        PrintMessage("  [FD] entered function\n")

        // Init subsystems that FileDialog depends on
        PrintMessage("  [FD] Init EventRouter...\n")
        EventRouter_Init()
        PrintMessage("  [FD] Init Dialog...\n")
        Dialog_Init()
        PrintMessage("  [FD] Init Compose...\n")
        Compose_Init(640, 480)
        PrintMessage("  [FD] Init WinMgr...\n")
        WinMgr_Init()
        PrintMessage("  [FD] Init HTML...\n")
        HTML_Init()

        // Create a fake desktop entry (idx 0) so Win_Create works
        // Win_Create expects FloatTable to be set up
        d_surf = Surface_Create(SurfaceFormat.PIXEL_32, 640, 480)
        Draw_Pix_FillRect(d_surf, 0, 0, 640, 480, 0xFF1E1E3C)
        idx = Float_Add(d_surf, 0, 0, 640, 480)
        Win_SetGeom(idx, 0, 0, 640, 480)
        fptr = Float_EntryPtr(idx)
        StoreValue(Add(fptr, FloatEntryFields.SURFACE), d_surf)
        WinMgr_SetHdr(idx, -1)
        WinMgr_SetContent(idx, d_surf)
        WinMgr_SetTB(idx, -1)
        WinMgr.count = Add(WinMgr.count, 1)
        WinMgr_ZSet(0, idx)
        WinMgr.z_count = 1

        PrintMessage("  Opening file dialog...\n")
        slot = FileDialog_Open(0, 0, 14)
        IfCondition LessThan(slot, 0) ThenBlock: {
            PrintMessage("  [FAIL] FileDialog_Open returned ")
            PrintNumber(slot)
            PrintMessage("\n")
            ReturnValue(0)
        }
        PrintMessage("  FileDialog opened, slot=")
        PrintNumber(slot)
        PrintMessage("\n")

        // Get the dialog window's content surface and dump it
        win_idx = Dialog_GetWinIdx(slot)
        PrintMessage("  Dialog win_idx=")
        PrintNumber(win_idx)
        PrintMessage("\n")

        content = WinMgr_GetContent(win_idx)
        IfCondition GreaterThan(content, 0) ThenBlock: {
            PrintMessage("  Content surface=")
            PrintNumber(content)
            PrintMessage("\n")
            DumpSurfacePPM(content, "/tmp/ak_filedialog.ppm")
        } ElseBlock: {
            PrintMessage("  [WARN] no content surface\n")
        }

        // Also dump the toolbar
        tb_surf = WinMgr_GetToolbar(win_idx)
        IfCondition GreaterThan(tb_surf, 0) ThenBlock: {
            DumpSurfacePPM(tb_surf, "/tmp/ak_filedialog_toolbar.ppm")
        }

        // Clean up
        FD_CloseDialog()
        Surface_Destroy(d_surf)
    }
}

// =============================================================================
// MAIN
// =============================================================================
SubRoutine.Main {
    Arena_Init()

    PrintMessage("============================================\n")
    PrintMessage("  Offscreen Render Test Suite\n")
    PrintMessage("============================================\n")

    // Init font system (required for AK_Draw text rendering)
    VIF_Init()
    VFont_Init()
    TextRegion_Init()
    VFont_LoadVIF("fonts/DejaVuSans.vif")
    VFont_RasterAll(18)
    PrintMessage("[Font] ready\n")

    // Connect to PostgreSQL (needed for file dialog)
    conn = PG_Connect("127.0.0.1", 5432, "ailang_system", "sean", "")
    IfCondition EqualTo(conn, 0) ThenBlock: {
        PrintMessage("[WARN] No database — file dialog test will skip populate\n")
    } ElseBlock: {
        PrintMessage("[DB] Connected\n")
    }
    TestDBState.conn = conn

    // Render tests - enabling one at a time
    // Render tests
    PrintMessage("[MAIN] about to run Test_FileDialog\n")
    Test_FileDialog()
    PrintMessage("[MAIN] FileDialog done, running others\n")
    Test_Deskbar()
    Test_Toolbar()
    Test_Menu()

    // Disconnect
    IfCondition NotEqual(conn, 0) ThenBlock: {
        PG_Disconnect(conn)
    }

    PrintMessage("\n============================================\n")
    PrintMessage("  Done. Check /tmp/ak_*.ppm\n")
    PrintMessage("============================================\n")
}

RunTask(Main)
