// test_powerplay.ailang — Full PowerPlay table parsing test
// Build: ./ailang.x TestCode/test_powerplay.ailang test_powerplay.x
// Run:   sudo ./test_powerplay.x
//
// Tests:
//   1. Discover GPUs
//   2. Map MMIO BARs (needed for VRAM ROM reading)
//   3. Load and parse AtomBIOS ROM
//   4. Parse full PowerPlay table (states, clock info, non-clock, deps)
//   5. Print complete PP info
//   6. Test accessor functions (GetClockEntry, FindBootState, etc.)
//   7. Cross-validate PP data against AtomBIOS DPM entries

LibraryImport.Arena
LibraryImport.Drivers.AMDGPU.AMDGPUFamily
LibraryImport.Drivers.AMDGPU.AMDGPUDiscover
LibraryImport.Drivers.AMDGPU.AMDGPUBAR
LibraryImport.Drivers.AMDGPU.AMDGPUAtomBIOS
LibraryImport.Drivers.AMDGPU.AMDGPUPowerPlay

SubRoutine.Main {
    PrintMessage("=== PowerPlay Table Parse Test ===\n\n")

    // --- Discover GPUs ---
    count = GPU_Discover()
    IfCondition EqualTo(count, 0) ThenBlock: {
        PrintMessage("No AMD GPUs found.\n")
        SystemCall(60, 1, 0, 0, 0, 0)
    }
    GPU_PrintAll()
    PrintMessage("\n")

    // --- Map MMIO BARs (required for VRAM ROM access) ---
    GPU_BAR_Init()
    gi = 0
    WhileLoop LessThan(gi, count) {
        GPU_BAR_MapMMIO(gi)
        gi = Add(gi, 1)
    }

    // --- Process each GPU ---
    gi = 0
    WhileLoop LessThan(gi, count) {
        PrintMessage("========================================\n")
        PrintMessage("GPU ")
        PrintNumber(gi)
        PrintMessage(":\n")
        PrintMessage("========================================\n\n")

        // --- Load VBIOS ROM ---
        PrintMessage("--- Loading VBIOS ROM ---\n")
        rom = AtomBIOS_LoadROM(gi)
        IfCondition EqualTo(rom, 0) ThenBlock: {
            PrintMessage("Failed to load VBIOS ROM for GPU ")
            PrintNumber(gi)
            PrintMessage(" — skipping\n\n")
        }
        IfCondition NotEqual(rom, 0) ThenBlock: {
            // --- Parse AtomBIOS ---
            PrintMessage("--- Parsing AtomBIOS ---\n")
            rc = AtomBIOS_Parse(gi)
            IfCondition EqualTo(rc, 0) ThenBlock: {
                PrintMessage("Failed to parse AtomBIOS — skipping\n\n")
            }
            IfCondition NotEqual(rc, 0) ThenBlock: {
                // Print basic AtomBIOS info
                AtomBIOS_PrintInfo(gi)
                PrintMessage("\n")

                // --- Parse PowerPlay ---
                PrintMessage("--- Parsing PowerPlay ---\n")
                pp_rc = PP_Parse(gi)
                IfCondition EqualTo(pp_rc, 0) ThenBlock: {
                    PrintMessage("Failed to parse PowerPlay table\n\n")
                }
                IfCondition NotEqual(pp_rc, 0) ThenBlock: {
                    // Print full PP info
                    PrintMessage("\n")
                    PP_PrintInfo(gi)
                    PrintMessage("\n")

                    // --- Test accessor functions ---
                    PrintMessage("--- Accessor Function Tests ---\n")

                    // Clock entry count
                    num_ci = PP_GetNumClockEntries(gi)
                    PrintMessage("PP_GetNumClockEntries: ")
                    PrintNumber(num_ci)
                    PrintMessage("\n")

                    // Verify matches AtomBIOS_GetDPMCount
                    ab_count = AtomBIOS_GetDPMCount(gi)
                    PrintMessage("AtomBIOS_GetDPMCount:  ")
                    PrintNumber(ab_count)
                    IfCondition EqualTo(num_ci, ab_count) ThenBlock: {
                        PrintMessage("  (MATCH)\n")
                    }
                    ElseBlock: {
                        PrintMessage("  (MISMATCH!)\n")
                    }

                    // State count
                    PrintMessage("PP_GetNumStates:       ")
                    PrintNumber(PP_GetNumStates(gi))
                    PrintMessage("\n")

                    // Boot / Perf state
                    boot_idx = PP_FindBootState(gi)
                    perf_idx = PP_FindPerformanceState(gi)
                    PrintMessage("Boot state:            ")
                    PrintNumber(boot_idx)
                    PrintMessage("\n")
                    PrintMessage("Performance state:     ")
                    PrintNumber(perf_idx)
                    PrintMessage("\n")

                    // Max clocks
                    PrintMessage("PP_GetMaxSCLK:         ")
                    max_sclk = PP_GetMaxSCLK(gi)
                    PrintNumber(Divide(max_sclk, 1000))
                    PrintMessage(" MHz\n")

                    PrintMessage("PP_GetMaxMCLK:         ")
                    max_mclk = PP_GetMaxMCLK(gi)
                    PrintNumber(Divide(max_mclk, 1000))
                    PrintMessage(" MHz\n")

                    // SCLK dependency count
                    PrintMessage("SCLK-VDDC dep count:   ")
                    PrintNumber(PP_GetSclkDepCount(gi))
                    PrintMessage("\n")
                    PrintMessage("MCLK-VDDCI dep count:  ")
                    PrintNumber(PP_GetMclkDepCount(gi))
                    PrintMessage("\n\n")

                    // --- Cross-validate clock entries ---
                    PrintMessage("--- Cross-Validation (PP vs AtomBIOS) ---\n")
                    ci_buf = Allocate(PPClkEntry.SIZE)
                    vddc_buf = Allocate(8)
                    mclk_buf = Allocate(8)

                    k = 0
                    all_match = 1
                    WhileLoop LessThan(k, num_ci) {
                        PP_GetClockEntry(gi, k, ci_buf)
                        pp_sclk = Dereference(Add(ci_buf, PPClkEntry.SCLK))
                        pp_vddc = Dereference(Add(ci_buf, PPClkEntry.VDDC))
                        pp_mclk = Dereference(Add(ci_buf, PPClkEntry.MCLK))

                        ab_sclk = AtomBIOS_GetDPMEntry(gi, k, vddc_buf, mclk_buf)
                        ab_vddc = Dereference(vddc_buf)
                        ab_mclk = Dereference(mclk_buf)

                        match = 1
                        IfCondition NotEqual(pp_sclk, ab_sclk) ThenBlock: { match = 0 }
                        IfCondition NotEqual(pp_vddc, ab_vddc) ThenBlock: { match = 0 }
                        IfCondition NotEqual(pp_mclk, ab_mclk) ThenBlock: { match = 0 }

                        IfCondition EqualTo(match, 0) ThenBlock: {
                            all_match = 0
                            PrintMessage("  MISMATCH at entry ")
                            PrintNumber(k)
                            PrintMessage(": PP(")
                            PrintNumber(pp_sclk)
                            PrintMessage("/")
                            PrintNumber(pp_vddc)
                            PrintMessage("/")
                            PrintNumber(pp_mclk)
                            PrintMessage(") vs AB(")
                            PrintNumber(ab_sclk)
                            PrintMessage("/")
                            PrintNumber(ab_vddc)
                            PrintMessage("/")
                            PrintNumber(ab_mclk)
                            PrintMessage(")\n")
                        }

                        k = Add(k, 1)
                    }

                    IfCondition EqualTo(all_match, 1) ThenBlock: {
                        PrintMessage("  All ")
                        PrintNumber(num_ci)
                        PrintMessage(" entries match between PP and AtomBIOS parsers\n")
                    }

                    Deallocate(ci_buf, PPClkEntry.SIZE)
                    Deallocate(vddc_buf, 8)
                    Deallocate(mclk_buf, 8)
                    PrintMessage("\n")

                    // --- Test GetStateDPMClockIdx ---
                    IfCondition GreaterEqual(perf_idx, 0) ThenBlock: {
                        PrintMessage("--- Performance State DPM Levels ---\n")
                        state_buf = Allocate(PPStateEntry.SIZE)
                        PP_GetStateEntry(gi, perf_idx, state_buf)
                        ndpm = Dereference(Add(state_buf, PPStateEntry.NUM_DPM_LEVELS))
                        PrintMessage("Performance state has ")
                        PrintNumber(ndpm)
                        PrintMessage(" DPM levels:\n")

                        clk_buf = Allocate(PPClkEntry.SIZE)
                        m = 0
                        WhileLoop LessThan(m, ndpm) {
                            ci_idx = PP_GetStateDPMClockIdx(gi, perf_idx, m)
                            PrintMessage("  DPM[")
                            PrintNumber(m)
                            PrintMessage("] -> clk[")
                            PrintNumber(ci_idx)
                            PrintMessage("]")

                            IfCondition GreaterEqual(ci_idx, 0) ThenBlock: {
                                PP_GetClockEntry(gi, ci_idx, clk_buf)
                                PrintMessage("  SCLK=")
                                PrintNumber(Divide(Dereference(Add(clk_buf, PPClkEntry.SCLK)), 1000))
                                PrintMessage("MHz  VDDC=")
                                PrintNumber(Dereference(Add(clk_buf, PPClkEntry.VDDC)))
                                PrintMessage("mV")
                            }
                            PrintMessage("\n")
                            m = Add(m, 1)
                        }
                        Deallocate(clk_buf, PPClkEntry.SIZE)
                        Deallocate(state_buf, PPStateEntry.SIZE)
                        PrintMessage("\n")
                    }

                    // Cleanup PP
                    PP_Free(gi)
                }
            }
            // Cleanup ROM
            AtomBIOS_FreeROM(gi)
        }
        gi = Add(gi, 1)
    }

    // --- Cleanup BARs ---
    gi = 0
    WhileLoop LessThan(gi, count) {
        GPU_BAR_Unmap(gi)
        gi = Add(gi, 1)
    }

    PrintMessage("=== PowerPlay Test Complete ===\n")
    SystemCall(60, 0, 0, 0, 0, 0)
}

RunTask(Main)
