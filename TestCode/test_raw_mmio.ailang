// test_raw_mmio.ailang — Raw MMIO test, no library code for register access
// Build: ./ailang.x TestCode/test_raw_mmio.ailang test_raw_mmio.x
// Run:   sg video -c "./test_raw_mmio.x"
//
// Opens resource2 directly, mmaps it, reads/writes at raw offsets.
// No GPU_Rd32, no GPU_Wr32, no BAR library — just mmap + dereference.

LibraryImport.Arena

SubRoutine.Main {
    PrintMessage("=== Raw MMIO Test ===\n\n")

    // Open /sys/bus/pci/devices/0000:02:00.0/resource2
    path = "/sys/bus/pci/devices/0000:02:00.0/resource2"
    // O_RDWR=2, O_SYNC=1052672 (0x101000)
    flags = Add(2, 1052672)
    fd = SystemCall(2, path, flags, 0)
    PrintMessage("open fd = ")
    PrintNumber(fd)
    PrintMessage("\n")
    IfCondition LessThan(fd, 0) ThenBlock: {
        PrintMessage("FAIL: cannot open resource2\n")
        SystemCall(60, 1, 0, 0, 0, 0)
    }

    // mmap(NULL, 262144, PROT_READ|PROT_WRITE, MAP_SHARED, fd, 0)
    // PROT_READ=1, PROT_WRITE=2, MAP_SHARED=1
    // SYS_MMAP=9
    sz = 262144
    ptr = SystemCall(9, 0, sz, 3, 1, fd)
    PrintMessage("mmap ptr = 0x")
    PrintHex(ptr)
    PrintMessage("\n")

    // Check mmap didn't fail (returns -1 on error, which as unsigned is huge)
    IfCondition EqualTo(ptr, 0) ThenBlock: {
        PrintMessage("FAIL: mmap returned NULL\n")
        SystemCall(60, 1, 0, 0, 0, 0)
    }

    // --- Test 1: Read GRBM_STATUS at offset 0x8010 ---
    PrintMessage("\n--- Raw reads of known registers ---\n")
    grbm = Dereference(Add(ptr, 32784), "dword")
    PrintMessage("GRBM_STATUS  [0x8010] = 0x")
    PrintHex(grbm)
    PrintMessage("\n")

    srbm = Dereference(Add(ptr, 57472), "dword")
    PrintMessage("SRBM_STATUS  [0xE070] = 0x")
    PrintHex(srbm)
    PrintMessage("\n")

    // --- Test 2: Read the SMC indirect register block 0x200-0x234 ---
    PrintMessage("\n--- Raw reads of SMC register block ---\n")

    r200 = Dereference(Add(ptr, 512), "dword")
    PrintMessage("IND_INDEX_0  [0x200] = 0x")
    PrintHex(r200)
    PrintMessage("\n")

    r204 = Dereference(Add(ptr, 516), "dword")
    PrintMessage("IND_DATA_0   [0x204] = 0x")
    PrintHex(r204)
    PrintMessage("\n")

    r208 = Dereference(Add(ptr, 520), "dword")
    PrintMessage("IND_INDEX_1  [0x208] = 0x")
    PrintHex(r208)
    PrintMessage("\n")

    r20c = Dereference(Add(ptr, 524), "dword")
    PrintMessage("IND_DATA_1   [0x20C] = 0x")
    PrintHex(r20c)
    PrintMessage("\n")

    r228 = Dereference(Add(ptr, 552), "dword")
    PrintMessage("IND_ACC_CNTL [0x228] = 0x")
    PrintHex(r228)
    PrintMessage("\n")

    r22c = Dereference(Add(ptr, 556), "dword")
    PrintMessage("MESSAGE_0    [0x22C] = 0x")
    PrintHex(r22c)
    PrintMessage("\n")

    r230 = Dereference(Add(ptr, 560), "dword")
    PrintMessage("RESP_0       [0x230] = 0x")
    PrintHex(r230)
    PrintMessage("\n")

    // --- Test 3: Write to IND_INDEX_0 and read back ---
    PrintMessage("\n--- Write/readback IND_INDEX_0 ---\n")

    StoreValue(Add(ptr, 512), 65536, "dword")
    rb1 = Dereference(Add(ptr, 512), "dword")
    PrintMessage("Write 0x10000, readback = 0x")
    PrintHex(rb1)
    PrintMessage("\n")

    StoreValue(Add(ptr, 512), 256, "dword")
    rb2 = Dereference(Add(ptr, 512), "dword")
    PrintMessage("Write 0x100, readback = 0x")
    PrintHex(rb2)
    PrintMessage("\n")

    // --- Test 4: Try writing IND_INDEX_0 then reading IND_DATA_0 ---
    // Don't bother reading back INDEX — just write it and read DATA
    PrintMessage("\n--- Write INDEX, read DATA (no INDEX readback) ---\n")

    // Try SRAM 0x00000
    StoreValue(Add(ptr, 512), 0, "dword")
    d0 = Dereference(Add(ptr, 516), "dword")
    PrintMessage("INDEX=0x0     DATA = 0x")
    PrintHex(d0)
    PrintMessage("\n")

    // Try SRAM 0x10000 (FW start)
    StoreValue(Add(ptr, 512), 65536, "dword")
    d1 = Dereference(Add(ptr, 516), "dword")
    PrintMessage("INDEX=0x10000 DATA = 0x")
    PrintHex(d1)
    PrintMessage("\n")

    // Try syscon RESET_CNTL (0x80000000)
    StoreValue(Add(ptr, 512), 2147483648, "dword")
    d2 = Dereference(Add(ptr, 516), "dword")
    PrintMessage("INDEX=0x80000000 DATA = 0x")
    PrintHex(d2)
    PrintMessage("\n")

    // Try syscon CLOCK_CNTL_0 (0x80000004)
    StoreValue(Add(ptr, 512), 2147483652, "dword")
    d3 = Dereference(Add(ptr, 516), "dword")
    PrintMessage("INDEX=0x80000004 DATA = 0x")
    PrintHex(d3)
    PrintMessage("\n")

    // --- Test 5: Scan wider MMIO range for non-zero values near 0x200 ---
    PrintMessage("\n--- Scan MMIO 0x1F0-0x240 ---\n")
    off = 496
    WhileLoop LessEqual(off, 576) {
        val = Dereference(Add(ptr, off), "dword")
        PrintMessage("  [0x")
        PrintHex(off)
        PrintMessage("] = 0x")
        PrintHex(val)
        IfCondition NotEqual(val, 0) ThenBlock: {
            PrintMessage("  <-- NON-ZERO")
        }
        PrintMessage("\n")
        off = Add(off, 4)
    }

    // --- Test 6: Check a few registers nearby that SHOULD be non-zero ---
    PrintMessage("\n--- Other register sanity checks ---\n")

    // CONFIG_MEMSIZE at 0x5428
    cfgmem = Dereference(Add(ptr, 21544), "dword")
    PrintMessage("CONFIG_MEMSIZE [0x5428] = 0x")
    PrintHex(cfgmem)
    PrintMessage("\n")

    // MC_VM_FB_LOCATION at 0x2024
    mcfb = Dereference(Add(ptr, 8228), "dword")
    PrintMessage("MC_VM_FB_LOCATION [0x2024] = 0x")
    PrintHex(mcfb)
    PrintMessage("\n")

    // HDP_NONSURFACE_BASE at 0x2C04
    hdp = Dereference(Add(ptr, 11268), "dword")
    PrintMessage("HDP_NONSURFACE_BASE [0x2C04] = 0x")
    PrintHex(hdp)
    PrintMessage("\n")

    // SCRATCH_REG0 at 0x8504
    scr0 = Dereference(Add(ptr, 34052), "dword")
    PrintMessage("SCRATCH_REG0 [0x8504] = 0x")
    PrintHex(scr0)
    PrintMessage("\n")

    // CB_CGTT_SCLK_CTRL at 0x9A60
    cbcg = Dereference(Add(ptr, 39520), "dword")
    PrintMessage("CB_CGTT_SCLK_CTRL [0x9A60] = 0x")
    PrintHex(cbcg)
    PrintMessage("\n")

    // SMC SCRATCH0 at 0x884
    smcscr = Dereference(Add(ptr, 2180), "dword")
    PrintMessage("SMC_SCRATCH0 [0x884] = 0x")
    PrintHex(smcscr)
    PrintMessage("\n")

    // --- Test 7: SPLL registers (direct MMIO) ---
    PrintMessage("\n--- SPLL registers ---\n")
    spll0 = Dereference(Add(ptr, 1536), "dword")
    PrintMessage("CG_SPLL_FUNC_CNTL   [0x600] = 0x")
    PrintHex(spll0)
    PrintMessage("\n")

    spll2 = Dereference(Add(ptr, 1540), "dword")
    PrintMessage("CG_SPLL_FUNC_CNTL_2 [0x604] = 0x")
    PrintHex(spll2)
    PrintMessage("\n")

    spll3 = Dereference(Add(ptr, 1544), "dword")
    PrintMessage("CG_SPLL_FUNC_CNTL_3 [0x608] = 0x")
    PrintHex(spll3)
    PrintMessage("\n")

    spll4 = Dereference(Add(ptr, 1548), "dword")
    PrintMessage("CG_SPLL_FUNC_CNTL_4 [0x60C] = 0x")
    PrintHex(spll4)
    PrintMessage("\n")

    spss = Dereference(Add(ptr, 1568), "dword")
    PrintMessage("CG_SPLL_SPREAD_SPEC [0x620] = 0x")
    PrintHex(spss)
    PrintMessage("\n")

    // SRBM_STATUS at correct offset 0xE50
    srbm_real = Dereference(Add(ptr, 3664), "dword")
    PrintMessage("SRBM_STATUS [0xE50] = 0x")
    PrintHex(srbm_real)
    PrintMessage("\n")

    // SRBM_STATUS2 at 0xE74
    srbm2 = Dereference(Add(ptr, 3700), "dword")
    PrintMessage("SRBM_STATUS2 [0xE74] = 0x")
    PrintHex(srbm2)
    PrintMessage("\n")

    // GENERAL_PWRMGT
    gpwr = Dereference(Add(ptr, 3072), "dword")
    PrintMessage("GENERAL_PWRMGT [0xC00] (maybe?) = 0x")
    PrintHex(gpwr)
    PrintMessage("\n")

    // --- Test 8: Try to bring SPLL into bypass ---
    PrintMessage("\n--- Attempting SPLL bypass mode ---\n")

    // Set SPLL_RESET (bit0) + SPLL_BYPASS_EN (bit3) = 0x9
    StoreValue(Add(ptr, 1536), 9, "dword")
    spll0b = Dereference(Add(ptr, 1536), "dword")
    PrintMessage("CG_SPLL_FUNC_CNTL after write 0x9 = 0x")
    PrintHex(spll0b)
    PrintMessage("\n")

    // Check if SMC registers came alive
    r200b = Dereference(Add(ptr, 512), "dword")
    PrintMessage("IND_INDEX_0 now = 0x")
    PrintHex(r200b)
    PrintMessage("\n")

    // Try IND write/read
    StoreValue(Add(ptr, 512), 65536, "dword")
    d_test = Dereference(Add(ptr, 516), "dword")
    PrintMessage("INDEX=0x10000 DATA = 0x")
    PrintHex(d_test)
    PrintMessage("\n")

    // Check SMC scratch
    smcscr2 = Dereference(Add(ptr, 2180), "dword")
    PrintMessage("SMC_SCRATCH0 [0x884] = 0x")
    PrintHex(smcscr2)
    PrintMessage("\n")

    // Cleanup
    SystemCall(11, ptr, sz, 0, 0, 0)
    SystemCall(3, fd, 0, 0, 0, 0)

    PrintMessage("\n=== Done ===\n")
    SystemCall(60, 0, 0, 0, 0, 0)
}

RunTask(Main)
