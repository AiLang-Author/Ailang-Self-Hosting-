// test_real_blit.ailang
// Test the EXACT Win_BlitOne function from Library.WinRender.ailang
// with real surfaces and the exact same calling pattern as Win_BlitAll.
//
// The key difference from previous tests: this uses the actual Surface_*
// API calls before the MemoryCopy loop, matching the real register pressure.

LibraryImport.Arena
LibraryImport.DSurfaceTypes
LibraryImport.DSurface
LibraryImport.DDrawPixel

Function.DebugLog_Push {
    Input: tag: Address
    Input: len: Integer
    Body: { ReturnValue(0) }
}

// ============================================================================
// Exact copy of Win_BlitOne from committed code (4142a01) minus FB_* calls
// Instead of FB_*, uses explicit parameters for the "framebuffer"
// ============================================================================
Function.Test_BlitOne {
    Input: surf: Integer
    Input: dst_x: Integer
    Input: dst_y: Integer
    Input: dst_buf: Address
    Input: dst_pitch: Integer
    Input: fb_w: Integer
    Input: fb_h: Integer
    Output: Integer
    Body: {
        sw        = Surface_GetWidth(surf)
        sh        = Surface_GetHeight(surf)
        src_data  = Surface_GetData(surf)
        src_pitch = Surface_GetPitch(surf)
        pb        = SurfaceConst.PIXEL_BYTES

        src_x0 = 0
        src_y0 = 0
        draw_w = sw
        draw_h = sh

        IfCondition LessThan(dst_x, 0) ThenBlock: {
            src_x0 = Subtract(0, dst_x)
            draw_w = Subtract(sw, src_x0)
            dst_x  = 0
        }
        IfCondition LessThan(dst_y, 0) ThenBlock: {
            src_y0 = Subtract(0, dst_y)
            draw_h = Subtract(sh, src_y0)
            dst_y  = 0
        }
        ovr_x = Subtract(Add(dst_x, draw_w), fb_w)
        IfCondition GreaterThan(ovr_x, 0) ThenBlock: {
            draw_w = Subtract(draw_w, ovr_x)
        }
        ovr_y = Subtract(Add(dst_y, draw_h), fb_h)
        IfCondition GreaterThan(ovr_y, 0) ThenBlock: {
            draw_h = Subtract(draw_h, ovr_y)
        }

        IfCondition LessEqual(draw_w, 0) ThenBlock: { ReturnValue(0) }
        IfCondition LessEqual(draw_h, 0) ThenBlock: { ReturnValue(0) }

        row_bytes = Multiply(draw_w, pb)
        y = 0
        WhileLoop LessThan(y, draw_h) {
            sry = Add(y, src_y0)
            dry = Add(y, dst_y)
            sr_off = Add(Multiply(sry, src_pitch), Multiply(src_x0, pb))
            src_row = Add(src_data, sr_off)
            dr_off = Add(Multiply(dry, dst_pitch), Multiply(dst_x, pb))
            dst_row = Add(dst_buf, dr_off)
            MemoryCopy(dst_row, src_row, row_bytes)
            y = Add(y, 1)
        }
        ReturnValue(1)
    }
}

// ============================================================================
// Deskbar_Draw exact replica
// ============================================================================
Function.Test_DeskbarDraw {
    Input: surf: Integer
    Input: sw: Integer
    Input: sh: Integer
    Input: db_h: Integer
    Input: hzh: Integer
    Input: buf: Address
    Input: pit: Integer
    Body: {
        src_data  = Surface_GetData(surf)
        src_pitch = Surface_GetPitch(surf)
        pb = 4
        dst_y = Subtract(sh, Add(db_h, hzh))

        row_bytes = Multiply(sw, pb)
        y = 0
        WhileLoop LessThan(y, db_h) {
            src_row = Add(src_data, Multiply(y, src_pitch))
            dst_ptr = Add(buf, Multiply(Add(dst_y, y), pit))
            MemoryCopy(dst_ptr, src_row, row_bytes)
            y = Add(y, 1)
        }
        ReturnValue(1)
    }
}

// ============================================================================
// Win_BlitAll simulation — exactly matches the call order
// ============================================================================
Function.Test_BlitAllSim {
    Input: fb_buf: Address
    Input: fb_front: Address
    Input: fb_w: Integer
    Input: fb_h: Integer
    Input: desk_surf: Integer
    Input: win_surf: Integer
    Input: db_surf: Integer
    Body: {
        fb_pitch = Multiply(fb_w, 4)
        fb_size = Multiply(fb_h, fb_pitch)

        // Desktop (idx=0): blit at (0,0) — full screen
        Test_BlitOne(desk_surf, 0, 0, fb_buf, fb_pitch, fb_w, fb_h)

        // Window 1: blit at (100, 80)
        Test_BlitOne(win_surf, 100, 80, fb_buf, fb_pitch, fb_w, fb_h)

        // Deskbar draw
        db_h = 32
        Test_DeskbarDraw(db_surf, fb_w, fb_h, db_h, 2, fb_buf, fb_pitch)

        // FB flip
        MemoryCopy(fb_front, fb_buf, fb_size)

        ReturnValue(1)
    }
}

SubRoutine.Main {
    Arena_Init()
    PrintMessage("=== Real Blit Test (Surface API + MemoryCopy) ===\n")

    fb_w = 640
    fb_h = 480
    fb_pitch = Multiply(fb_w, 4)
    fb_size = Multiply(fb_h, fb_pitch)

    fb_buf = Allocate(fb_size)
    fb_front = Allocate(fb_size)

    // Create real surfaces
    desk_surf = Surface_Create(SurfaceFormat.PIXEL_32, fb_w, fb_h)
    Draw_Pix_FillRect(desk_surf, 0, 0, fb_w, fb_h, 0xFF1A2A1A)

    win_surf = Surface_Create(SurfaceFormat.PIXEL_32, 300, 200)
    Draw_Pix_FillRect(win_surf, 0, 0, 300, 200, 0xFF554433)

    db_surf = Surface_Create(SurfaceFormat.PIXEL_32, fb_w, 32)
    Draw_Pix_FillRect(db_surf, 0, 0, fb_w, 32, 0xFFAABBCC)

    PrintMessage("Surfaces created, running 50 frame pipeline...\n")

    frame = 0
    WhileLoop LessThan(frame, 50) {
        Test_BlitAllSim(fb_buf, fb_front, fb_w, fb_h, desk_surf, win_surf, db_surf)
        frame = Add(frame, 1)
    }

    // Verify
    pass = 1

    // Check desktop pixel at (0,0)
    v0 = GetByte(fb_front, 0)
    IfCondition NotEqual(v0, 0x1A) ThenBlock: {
        PrintMessage("[FAIL] desktop[0]=")
        PrintNumber(v0)
        PrintMessage(" expected 0x1A\n")
        pass = 0
    }

    // Check window pixel at (100, 80)
    w_off = Add(Multiply(80, fb_pitch), Multiply(100, 4))
    v1 = GetByte(fb_front, w_off)
    IfCondition NotEqual(v1, 0x33) ThenBlock: {
        PrintMessage("[FAIL] window[100,80]=")
        PrintNumber(v1)
        PrintMessage(" expected 0x33\n")
        pass = 0
    }

    // Check deskbar pixel at bottom
    db_y = Subtract(fb_h, 34)
    db_off = Multiply(db_y, fb_pitch)
    v2 = GetByte(fb_front, db_off)
    IfCondition NotEqual(v2, 0xCC) ThenBlock: {
        PrintMessage("[FAIL] deskbar=")
        PrintNumber(v2)
        PrintMessage(" expected 0xCC\n")
        pass = 0
    }

    IfCondition EqualTo(pass, 1) ThenBlock: {
        PrintMessage("[PASS] 50 frames of real blit pipeline\n")
    }

    // Edge case: partially offscreen window
    PrintMessage("\nTesting partially offscreen window...\n")
    win2 = Surface_Create(SurfaceFormat.PIXEL_32, 200, 150)
    Draw_Pix_FillRect(win2, 0, 0, 200, 150, 0xFF112233)

    // Window at (-30, -20) — partially offscreen top-left
    Test_BlitOne(win2, -30, -20, fb_buf, fb_pitch, fb_w, fb_h)
    MemoryCopy(fb_front, fb_buf, fb_size)

    // Pixel at (0,0) should be from win2 offset (30,20)
    expected_off = Add(Multiply(20, Multiply(200, 4)), Multiply(30, 4))
    exp_val = GetByte(Surface_GetData(win2), expected_off)
    got_val = GetByte(fb_front, 0)
    IfCondition EqualTo(exp_val, got_val) ThenBlock: {
        PrintMessage("[PASS] partially offscreen\n")
    } ElseBlock: {
        PrintMessage("[FAIL] offscreen: expected=")
        PrintNumber(exp_val)
        PrintMessage(" got=")
        PrintNumber(got_val)
        PrintMessage("\n")
    }

    // Window right at bottom edge (overlapping deskbar area)
    win3 = Surface_Create(SurfaceFormat.PIXEL_32, 100, 100)
    Draw_Pix_FillRect(win3, 0, 0, 100, 100, 0xFF998877)
    Test_BlitOne(win3, 200, Subtract(fb_h, 50), fb_buf, fb_pitch, fb_w, fb_h)
    MemoryCopy(fb_front, fb_buf, fb_size)
    // Check at bottom edge
    be_off = Add(Multiply(Subtract(fb_h, 1), fb_pitch), Multiply(200, 4))
    be_val = GetByte(fb_front, be_off)
    IfCondition NotEqual(be_val, 0) ThenBlock: {
        PrintMessage("[PASS] bottom edge blit: ")
        PrintNumber(be_val)
        PrintMessage("\n")
    } ElseBlock: {
        PrintMessage("[INFO] bottom edge = 0 (may be clipped)\n")
    }

    PrintMessage("\n=== ALL TESTS COMPLETE ===\n")
}

RunTask(Main)
