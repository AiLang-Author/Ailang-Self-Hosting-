// test_real_blit3.ailang
// Test using exact signatures from real code (3 args for BlitOne, 0 for DeskbarDraw)
// with FixedPool globals matching the real FB.* and DeskbarState.*

LibraryImport.Arena
LibraryImport.DSurfaceTypes
LibraryImport.DSurface
LibraryImport.DDrawPixel

Function.DebugLog_Push {
    Input: tag: Address
    Input: len: Integer
    Body: { ReturnValue(0) }
}

// ============================================================================
// Fake FB globals (matching real FB.* and related pools)
// ============================================================================
FixedPool.FakeFB {
    "buf":   Initialize=0, CanChange=True
    "pitch": Initialize=0, CanChange=True
    "w":     Initialize=0, CanChange=True
    "h":     Initialize=0, CanChange=True
    "front": Initialize=0, CanChange=True
    "size":  Initialize=0, CanChange=True
}

FixedPool.FakeDeskbar {
    "visible":    Initialize=1, CanChange=True
    "surface":    Initialize=0, CanChange=True
    "screen_w":   Initialize=0, CanChange=True
    "screen_h":   Initialize=0, CanChange=True
    "height":     Initialize=32
    "hotzone_h":  Initialize=2
}

FixedPool.FakeWin {
    "desk_surf":    Initialize=0, CanChange=True
    "win_surf":     Initialize=0, CanChange=True
    "win_x":        Initialize=100
    "win_y":        Initialize=80
}

// ============================================================================
// Exact Win_BlitOne replica — 3 inputs, reads from FakeFB globals
// ============================================================================
Function.Test_BlitOne {
    Input: surf: Integer
    Input: dst_x: Integer
    Input: dst_y: Integer
    Output: Integer
    Body: {
        sw        = Surface_GetWidth(surf)
        sh        = Surface_GetHeight(surf)
        src_data  = Surface_GetData(surf)
        src_pitch = Surface_GetPitch(surf)
        dst_buf   = FakeFB.buf
        dst_pitch = FakeFB.pitch
        fb_w      = FakeFB.w
        fb_h      = FakeFB.h
        pb        = SurfaceConst.PIXEL_BYTES

        src_x0 = 0
        src_y0 = 0
        draw_w = sw
        draw_h = sh

        IfCondition LessThan(dst_x, 0) ThenBlock: {
            src_x0 = Subtract(0, dst_x)
            draw_w = Subtract(sw, src_x0)
            dst_x  = 0
        }
        IfCondition LessThan(dst_y, 0) ThenBlock: {
            src_y0 = Subtract(0, dst_y)
            draw_h = Subtract(sh, src_y0)
            dst_y  = 0
        }
        ovr_x = Subtract(Add(dst_x, draw_w), fb_w)
        IfCondition GreaterThan(ovr_x, 0) ThenBlock: {
            draw_w = Subtract(draw_w, ovr_x)
        }
        ovr_y = Subtract(Add(dst_y, draw_h), fb_h)
        IfCondition GreaterThan(ovr_y, 0) ThenBlock: {
            draw_h = Subtract(draw_h, ovr_y)
        }

        IfCondition LessEqual(draw_w, 0) ThenBlock: { ReturnValue(0) }
        IfCondition LessEqual(draw_h, 0) ThenBlock: { ReturnValue(0) }

        row_bytes = Multiply(draw_w, pb)
        y = 0
        WhileLoop LessThan(y, draw_h) {
            sry = Add(y, src_y0)
            dry = Add(y, dst_y)
            sr_off = Add(Multiply(sry, src_pitch), Multiply(src_x0, pb))
            src_row = Add(src_data, sr_off)
            dr_off = Add(Multiply(dry, dst_pitch), Multiply(dst_x, pb))
            dst_row = Add(dst_buf, dr_off)
            MemoryCopy(dst_row, src_row, row_bytes)
            y = Add(y, 1)
        }
        ReturnValue(1)
    }
}

// ============================================================================
// Exact Deskbar_Draw replica — 0 inputs, reads from FakeDeskbar globals
// ============================================================================
Function.Test_DeskbarDraw {
    Body: {
        IfCondition EqualTo(FakeDeskbar.visible, 0) ThenBlock: { ReturnValue(0) }

        surf = FakeDeskbar.surface
        IfCondition EqualTo(surf, 0) ThenBlock: { ReturnValue(0) }

        sw   = FakeDeskbar.screen_w
        sh   = FakeDeskbar.screen_h
        db_h = FakeDeskbar.height
        hzh  = FakeDeskbar.hotzone_h

        dst_y = Subtract(sh, Add(db_h, hzh))

        buf     = FakeFB.buf
        pit     = FakeFB.pitch
        pb      = 4
        src_data  = Surface_GetData(surf)
        src_pitch = Surface_GetPitch(surf)

        row_bytes = Multiply(sw, pb)
        y = 0
        WhileLoop LessThan(y, db_h) {
            src_row = Add(src_data, Multiply(y, src_pitch))
            dst_ptr = Add(buf, Multiply(Add(dst_y, y), pit))
            MemoryCopy(dst_ptr, src_row, row_bytes)
            y = Add(y, 1)
        }
        ReturnValue(1)
    }
}

// ============================================================================
// Exact Win_BlitAll replica — 0 inputs, reads from globals
// ============================================================================
Function.Test_BlitAll {
    Output: Integer
    Body: {
        // Desktop blit
        Test_BlitOne(FakeWin.desk_surf, 0, 0)

        // Window blit
        Test_BlitOne(FakeWin.win_surf, FakeWin.win_x, FakeWin.win_y)

        // Deskbar draw
        Test_DeskbarDraw()

        // FB flip
        MemoryCopy(FakeFB.front, FakeFB.buf, FakeFB.size)

        ReturnValue(0)
    }
}

SubRoutine.Main {
    Arena_Init()
    PrintMessage("=== Real Blit Test v3 (exact function signatures) ===\n")

    fb_w = 640
    fb_h = 480
    fb_pitch = Multiply(fb_w, 4)
    fb_size = Multiply(fb_h, fb_pitch)

    // Set globals
    FakeFB.buf = Allocate(fb_size)
    FakeFB.front = Allocate(fb_size)
    FakeFB.pitch = fb_pitch
    FakeFB.w = fb_w
    FakeFB.h = fb_h
    FakeFB.size = fb_size

    FakeDeskbar.screen_w = fb_w
    FakeDeskbar.screen_h = fb_h

    // Create surfaces
    desk_surf = Surface_Create(SurfaceFormat.PIXEL_32, fb_w, fb_h)
    Draw_Pix_FillRect(desk_surf, 0, 0, fb_w, fb_h, 0xFF1A2A1A)
    FakeWin.desk_surf = desk_surf

    win_surf = Surface_Create(SurfaceFormat.PIXEL_32, 300, 200)
    Draw_Pix_FillRect(win_surf, 0, 0, 300, 200, 0xFF554433)
    FakeWin.win_surf = win_surf

    db_surf = Surface_Create(SurfaceFormat.PIXEL_32, fb_w, 32)
    Draw_Pix_FillRect(db_surf, 0, 0, fb_w, 32, 0xFFAABBCC)
    FakeDeskbar.surface = db_surf

    PrintMessage("Surfaces created, running 50 frame pipeline...\n")

    frame = 0
    WhileLoop LessThan(frame, 50) {
        Test_BlitAll()
        frame = Add(frame, 1)
    }

    // Verify
    pass = 1

    front = FakeFB.front
    v0 = GetByte(front, 0)
    IfCondition NotEqual(v0, 0x1A) ThenBlock: {
        PrintMessage("[FAIL] desktop[0]=")
        PrintNumber(v0)
        PrintMessage(" expected 0x1A\n")
        pass = 0
    }

    w_off = Add(Multiply(80, fb_pitch), Multiply(100, 4))
    v1 = GetByte(front, w_off)
    IfCondition NotEqual(v1, 0x33) ThenBlock: {
        PrintMessage("[FAIL] window=")
        PrintNumber(v1)
        PrintMessage(" expected 0x33\n")
        pass = 0
    }

    db_y = Subtract(fb_h, 34)
    db_off = Multiply(db_y, fb_pitch)
    v2 = GetByte(front, db_off)
    IfCondition NotEqual(v2, 0xCC) ThenBlock: {
        PrintMessage("[FAIL] deskbar=")
        PrintNumber(v2)
        PrintMessage(" expected 0xCC\n")
        pass = 0
    }

    IfCondition EqualTo(pass, 1) ThenBlock: {
        PrintMessage("[PASS] 50 frames OK\n")
    }

    PrintMessage("\n=== ALL TESTS COMPLETE ===\n")
}

RunTask(Main)
