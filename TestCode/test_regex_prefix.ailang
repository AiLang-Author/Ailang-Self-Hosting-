// Sanity check Regex_GetPrefix on patterns that exercise each branch.
LibraryImport.Arena
LibraryImport.Regex_Thompson

Function.Check {
    Input: label:   Address
    Input: pat:     Address
    Input: exp_len: Integer
    Body: {
        SystemCall(1, 1, label, StringLength(label))
        SystemCall(1, 1, " pat=", 5)
        SystemCall(1, 1, pat, StringLength(pat))
        SystemCall(1, 1, " ", 1)

        buf = Allocate(32)
        IfCondition EqualTo(buf, 0) ThenBlock: {
            SystemCall(1, 1, "ALLOC_FAIL\n", 11)
            ReturnValue(0)
        }

        r = Regex_Compile(pat, 0)
        IfCondition EqualTo(r, 0) ThenBlock: {
            SystemCall(1, 1, "COMPILE_FAIL\n", 13)
            ReturnValue(0)
        }

        got = Regex_GetPrefix(r, buf, 32)
        SystemCall(1, 1, "prefix=[", 8)
        SystemCall(1, 1, buf, got)
        SystemCall(1, 1, "] len=", 6)
        PrintNumber(got)
        IfCondition EqualTo(got, exp_len) ThenBlock: {
            SystemCall(1, 1, " PASS\n", 6)
        } ElseBlock: {
            SystemCall(1, 1, " FAIL (expected ", 16)
            PrintNumber(exp_len)
            SystemCall(1, 1, ")\n", 2)
        }
    }
}

SubRoutine.Main {
    Check("simple-literal  ", "foo",               3)
    Check("anchored        ", "^foo",              3)
    Check("literal+star    ", "foo.*bar",          3)
    Check("literal+plus    ", "abcd+e",            3)  // CHAR(a)CHAR(b)CHAR(c)CHAR(d)->SPLIT; extract "abcd"
    Check("first-is-class  ", "[A-Z]foo",          0)  // first state RANGE, no prefix
    Check("first-is-dot    ", ".foo",              0)  // first state DOT
    Check("alternation     ", "foo|bar",           0)  // first state SPLIT
    Check("star-first      ", "a*b",               0)  // first state SPLIT
    Check("mixed           ", "Func[a-z]",         4)  // CHAR(F)CHAR(u)CHAR(n)CHAR(c) then RANGE
    Check("long-prefix     ", "FragAllocSlot",    13)
    SystemCall(60, 0)
}
RunTask(Main)
