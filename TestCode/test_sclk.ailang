// test_sclk.ailang — SPLL clock-setting test with save/restore
//
// Tests the AccelGCN_SetSCLK SPLL reprogramming sequence in isolation.
// Saves all SPLL registers BEFORE touching anything, programs the new
// clock, verifies the PLL locks, then RESTORES the original register
// state so the display controller keeps working.
//
// This avoids the full AccelGCN_Init path (no CP reset, no ring setup,
// no firmware load) — only GPU discover + BAR map + register access.
//
// Build: ./ailang.x TestCode/test_sclk.ailang -o test_sclk.x
// Run:   sudo ./test_sclk.x 2>&1 | tee sclk_test_log.txt

LibraryImport.Drivers.AMDGPU.AMDGPUFamily
LibraryImport.Drivers.AMDGPU.AMDGPUDiscover
LibraryImport.Drivers.AMDGPU.AMDGPUBAR
LibraryImport.Drivers.AMDGPU.AMDGPUAtomBIOS
LibraryImport.Drivers.AMDGPU.AMDGPUPM4Regs

// =============================================================================
// SPLL register snapshot — saved before any writes, restored at end
// =============================================================================
FixedPool.SPLLSave {
    "cntl":     Initialize=0, CanChange=True   // CG_SPLL_FUNC_CNTL
    "cntl2":    Initialize=0, CanChange=True   // CG_SPLL_FUNC_CNTL_2
    "cntl3":    Initialize=0, CanChange=True   // CG_SPLL_FUNC_CNTL_3
    "cntl4":    Initialize=0, CanChange=True   // CG_SPLL_FUNC_CNTL_4
    "ss":       Initialize=0, CanChange=True   // CG_SPLL_SPREAD_SPECTRUM
    "ss2":      Initialize=0, CanChange=True   // CG_SPLL_SPREAD_SPECTRUM_2
    "saved":    Initialize=0, CanChange=True   // 1 = snapshot taken
}

// =============================================================================
// SPLL_Save — snapshot all SPLL registers
// =============================================================================
Function.SPLL_Save {
    Input: gpu: Integer
    Body: {
        SPLLSave.cntl  = GPU_Rd32(gpu, SIReg.CG_SPLL_FUNC_CNTL)
        SPLLSave.cntl2 = GPU_Rd32(gpu, SIReg.CG_SPLL_FUNC_CNTL_2)
        SPLLSave.cntl3 = GPU_Rd32(gpu, SIReg.CG_SPLL_FUNC_CNTL_3)
        SPLLSave.cntl4 = GPU_Rd32(gpu, SIReg.CG_SPLL_FUNC_CNTL_4)
        SPLLSave.ss    = GPU_Rd32(gpu, SIReg.CG_SPLL_SPREAD_SPECTRUM)
        SPLLSave.ss2   = GPU_Rd32(gpu, SIReg.CG_SPLL_SPREAD_SPECTRUM_2)
        SPLLSave.saved = 1

        PrintMessage("[SAVE] SPLL registers saved:\n")
        PrintMessage("  CG_SPLL_FUNC_CNTL   = 0x")
        PrintHex(SPLLSave.cntl)
        PrintMessage("\n")
        PrintMessage("  CG_SPLL_FUNC_CNTL_2 = 0x")
        PrintHex(SPLLSave.cntl2)
        PrintMessage("\n")
        PrintMessage("  CG_SPLL_FUNC_CNTL_3 = 0x")
        PrintHex(SPLLSave.cntl3)
        PrintMessage("\n")
        PrintMessage("  CG_SPLL_FUNC_CNTL_4 = 0x")
        PrintHex(SPLLSave.cntl4)
        PrintMessage("\n")
        PrintMessage("  CG_SPLL_SPREAD_SPEC = 0x")
        PrintHex(SPLLSave.ss)
        PrintMessage("\n")
        PrintMessage("  CG_SPLL_SPREAD_SPEC2= 0x")
        PrintHex(SPLLSave.ss2)
        PrintMessage("\n")
    }
}

// =============================================================================
// SPLL_Decode — decode and print current PLL state from register values
// =============================================================================
Function.SPLL_Decode {
    Input: gpu: Integer
    Input: ref_khz: Integer
    Body: {
        cntl  = GPU_Rd32(gpu, SIReg.CG_SPLL_FUNC_CNTL)
        cntl3 = GPU_Rd32(gpu, SIReg.CG_SPLL_FUNC_CNTL_3)

        refdiv = BitwiseAnd(Divide(cntl, 16), 63)
        pdiv   = BitwiseAnd(Divide(cntl, 1048576), 127)
        fbdiv  = BitwiseAnd(cntl3, 67108863)

        bypass = BitwiseAnd(cntl, SPLLBits.SPLL_BYPASS_EN)
        reset  = BitwiseAnd(cntl, SPLLBits.SPLL_RESET)
        sleep  = BitwiseAnd(cntl, SPLLBits.SPLL_SLEEP)

        PrintMessage("  REF_DIV=")
        PrintNumber(refdiv)
        PrintMessage(" FBDIV=")
        PrintNumber(fbdiv)
        PrintMessage(" PDIV=")
        PrintNumber(pdiv)
        PrintMessage("\n")

        PrintMessage("  flags: bypass=")
        PrintNumber(bypass)
        PrintMessage(" reset=")
        PrintNumber(reset)
        PrintMessage(" sleep=")
        PrintNumber(sleep)
        PrintMessage("\n")

        // Compute SCLK if dividers are valid
        IfCondition GreaterThan(refdiv, 0) ThenBlock: {
            IfCondition GreaterThan(pdiv, 0) ThenBlock: {
                IfCondition GreaterThan(ref_khz, 0) ThenBlock: {
                    sclk_khz = Divide(Multiply(ref_khz, fbdiv), Multiply(refdiv, pdiv))
                    PrintMessage("  SCLK = ")
                    PrintNumber(Divide(sclk_khz, 1000))
                    PrintMessage(" MHz (")
                    PrintNumber(sclk_khz)
                    PrintMessage(" kHz)\n")
                }
            }
        }

        status = GPU_Rd32(gpu, SIReg.SPLL_STATUS)
        PrintMessage("  SPLL_STATUS = 0x")
        PrintHex(status)
        locked = BitwiseAnd(status, SPLLBits.SPLL_CHG_STATUS)
        IfCondition NotEqual(locked, 0) ThenBlock: {
            PrintMessage(" (LOCKED)\n")
        }
        IfCondition EqualTo(locked, 0) ThenBlock: {
            PrintMessage(" (NOT locked)\n")
        }
    }
}

// =============================================================================
// SPLL_Restore — restore saved SPLL registers using safe PLL sequence
//
// We can't just slam the old values back — the PLL needs the proper
// bypass → reset → program → unreset → lock → unbypass sequence.
// =============================================================================
Function.SPLL_Restore {
    Input: gpu: Integer
    Body: {
        IfCondition EqualTo(SPLLSave.saved, 0) ThenBlock: {
            PrintMessage("[RESTORE] ERROR: no saved state\n")
            ReturnValue(-1)
        }

        PrintMessage("\n[RESTORE] restoring original SPLL state...\n")

        // Step 1: Enable bypass (engine runs on ref clock during transition)
        cur = GPU_Rd32(gpu, SIReg.CG_SPLL_FUNC_CNTL)
        cur = BitwiseOr(cur, SPLLBits.SPLL_BYPASS_EN)
        GPU_Wr32(gpu, SIReg.CG_SPLL_FUNC_CNTL, cur)
        fence = GPU_Rd32(gpu, SIReg.CG_SPLL_FUNC_CNTL)

        // Step 2: Assert reset
        cur = BitwiseOr(cur, SPLLBits.SPLL_RESET)
        GPU_Wr32(gpu, SIReg.CG_SPLL_FUNC_CNTL, cur)

        // Step 3: Restore the original CNTL value but keep bypass+reset set
        restore_cntl = BitwiseOr(SPLLSave.cntl, SPLLBits.SPLL_BYPASS_EN)
        restore_cntl = BitwiseOr(restore_cntl, SPLLBits.SPLL_RESET)
        GPU_Wr32(gpu, SIReg.CG_SPLL_FUNC_CNTL, restore_cntl)

        // Step 4: Restore CNTL_3 (FBDIV), CNTL_2, CNTL_4, SS regs
        GPU_Wr32(gpu, SIReg.CG_SPLL_FUNC_CNTL_3, SPLLSave.cntl3)
        GPU_Wr32(gpu, SIReg.CG_SPLL_FUNC_CNTL_2, SPLLSave.cntl2)
        GPU_Wr32(gpu, SIReg.CG_SPLL_FUNC_CNTL_4, SPLLSave.cntl4)
        GPU_Wr32(gpu, SIReg.CG_SPLL_SPREAD_SPECTRUM_2, SPLLSave.ss2)

        // Step 5: Deassert reset (keep bypass)
        restore_cntl = BitwiseAnd(restore_cntl, Subtract(4294967295, SPLLBits.SPLL_RESET))
        // Clear SLEEP too, in case the saved state had it clear
        restore_cntl = BitwiseAnd(restore_cntl, Subtract(4294967295, SPLLBits.SPLL_SLEEP))
        GPU_Wr32(gpu, SIReg.CG_SPLL_FUNC_CNTL, restore_cntl)

        // Step 6: Wait for PLL lock
        lock_count = 0
        lock_ok = 0
        WhileLoop LessThan(lock_count, 10000) {
            status = GPU_Rd32(gpu, SIReg.SPLL_STATUS)
            IfCondition NotEqual(BitwiseAnd(status, SPLLBits.SPLL_CHG_STATUS), 0) ThenBlock: {
                lock_ok = 1
                ExitLoop
            }
            lock_count = Add(lock_count, 1)
        }

        IfCondition EqualTo(lock_ok, 0) ThenBlock: {
            PrintMessage("[RESTORE] WARNING: PLL lock timeout!\n")
            PrintMessage("[RESTORE] SPLL_STATUS=0x")
            PrintHex(GPU_Rd32(gpu, SIReg.SPLL_STATUS))
            PrintMessage("\n")
            PrintMessage("[RESTORE] leaving bypass enabled for safety\n")
            ReturnValue(-2)
        }

        PrintMessage("[RESTORE] PLL re-locked after ")
        PrintNumber(lock_count)
        PrintMessage(" polls\n")

        // Step 7: Restore exact original CNTL (which has the original bypass bit state)
        GPU_Wr32(gpu, SIReg.CG_SPLL_FUNC_CNTL, SPLLSave.cntl)

        // Step 8: Restore spread spectrum last
        GPU_Wr32(gpu, SIReg.CG_SPLL_SPREAD_SPECTRUM, SPLLSave.ss)

        fence = GPU_Rd32(gpu, SIReg.CG_SPLL_FUNC_CNTL)

        PrintMessage("[RESTORE] registers restored:\n")
        PrintMessage("  CG_SPLL_FUNC_CNTL   = 0x")
        PrintHex(GPU_Rd32(gpu, SIReg.CG_SPLL_FUNC_CNTL))
        PrintMessage(" (saved=0x")
        PrintHex(SPLLSave.cntl)
        PrintMessage(")\n")
        PrintMessage("  CG_SPLL_FUNC_CNTL_3 = 0x")
        PrintHex(GPU_Rd32(gpu, SIReg.CG_SPLL_FUNC_CNTL_3))
        PrintMessage(" (saved=0x")
        PrintHex(SPLLSave.cntl3)
        PrintMessage(")\n")
        PrintMessage("  CG_SPLL_SPREAD_SPEC = 0x")
        PrintHex(GPU_Rd32(gpu, SIReg.CG_SPLL_SPREAD_SPECTRUM))
        PrintMessage(" (saved=0x")
        PrintHex(SPLLSave.ss)
        PrintMessage(")\n")

        ReturnValue(0)
    }
}

// =============================================================================
// SPLL_TestProgram — run the SetSCLK sequence (same as AccelGCN_SetSCLK)
// Returns: 0=success, -1=no data, -2=lock timeout
// =============================================================================
Function.SPLL_TestProgram {
    Input: gpu: Integer
    Output: Integer
    Body: {
        // Load AtomBIOS ROM
        rom = AtomBIOS_LoadROM(gpu)
        IfCondition EqualTo(rom, 0) ThenBlock: {
            PrintMessage("[TEST] AtomBIOS ROM load failed\n")
            ReturnValue(-1)
        }
        ap_rc = AtomBIOS_Parse(gpu)
        IfCondition NotEqual(ap_rc, 1) ThenBlock: {
            PrintMessage("[TEST] AtomBIOS parse failed\n")
            ReturnValue(-1)
        }

        PrintMessage("\n--- AtomBIOS Clock Data ---\n")
        AtomBIOS_PrintInfo(gpu)

        // Get target clock
        target_khz = AtomBIOS_GetField(gpu, AtomField.MAX_ENGINE_CLK)
        IfCondition EqualTo(target_khz, 0) ThenBlock: {
            target_khz = AtomBIOS_GetField(gpu, AtomField.DEF_ENGINE_CLK)
        }
        ref_khz = AtomBIOS_GetField(gpu, AtomField.CORE_REF_CLK)

        IfCondition EqualTo(target_khz, 0) ThenBlock: {
            PrintMessage("[TEST] no engine clock data in AtomBIOS\n")
            ReturnValue(-1)
        }
        IfCondition EqualTo(ref_khz, 0) ThenBlock: {
            PrintMessage("[TEST] no ref clock data in AtomBIOS\n")
            ReturnValue(-1)
        }

        // Voltage check
        max_vddc_req = AtomBIOS_GetField(gpu, AtomField.MAX_ENGINE_VDDC)
        boot_vddc = AtomBIOS_GetField(gpu, AtomField.BOOT_VDDC)
        PrintMessage("\n[TEST] voltage: target needs ")
        PrintNumber(max_vddc_req)
        PrintMessage(" mV, boot VDDC = ")
        PrintNumber(boot_vddc)
        PrintMessage(" mV\n")
        IfCondition GreaterThan(max_vddc_req, Add(boot_vddc, 100)) ThenBlock: {
            PrintMessage("[TEST] WARNING: target SCLK needs more voltage than boot provides!\n")
            PrintMessage("[TEST] This is likely what causes display corruption.\n")
            PrintMessage("[TEST] Skipping reprogram — would exceed safe voltage margin.\n")
            ReturnValue(-3)
        }

        // Compute new dividers
        new_refdiv = 1
        new_pdiv = 1
        new_fbdiv = Divide(target_khz, ref_khz)
        IfCondition LessThan(new_fbdiv, 1) ThenBlock: { new_fbdiv = 1 }
        actual_khz = Divide(Multiply(ref_khz, new_fbdiv), Multiply(new_refdiv, new_pdiv))

        PrintMessage("\n[TEST] SCLK reprogram plan:\n")
        PrintMessage("  target  = ")
        PrintNumber(Divide(target_khz, 1000))
        PrintMessage(" MHz (")
        PrintNumber(target_khz)
        PrintMessage(" kHz)\n")
        PrintMessage("  ref     = ")
        PrintNumber(Divide(ref_khz, 1000))
        PrintMessage(" MHz\n")
        PrintMessage("  FBDIV   = ")
        PrintNumber(new_fbdiv)
        PrintMessage("\n")
        PrintMessage("  actual  = ")
        PrintNumber(Divide(actual_khz, 1000))
        PrintMessage(" MHz (")
        PrintNumber(actual_khz)
        PrintMessage(" kHz)\n")
        PrintMessage("  REF_DIV = ")
        PrintNumber(new_refdiv)
        PrintMessage(", PDIV = ")
        PrintNumber(new_pdiv)
        PrintMessage("\n")

        // Check if already at target
        cntl  = GPU_Rd32(gpu, SIReg.CG_SPLL_FUNC_CNTL)
        cntl3 = GPU_Rd32(gpu, SIReg.CG_SPLL_FUNC_CNTL_3)
        cur_refdiv = BitwiseAnd(Divide(cntl, 16), 63)
        cur_pdiv   = BitwiseAnd(Divide(cntl, 1048576), 127)
        cur_fbdiv  = BitwiseAnd(cntl3, 67108863)
        cur_sclk = 0
        IfCondition GreaterThan(cur_refdiv, 0) ThenBlock: {
            IfCondition GreaterThan(cur_pdiv, 0) ThenBlock: {
                cur_sclk = Divide(Multiply(ref_khz, cur_fbdiv), Multiply(cur_refdiv, cur_pdiv))
            }
        }
        diff = Subtract(actual_khz, cur_sclk)
        IfCondition LessThan(diff, 0) ThenBlock: { diff = Subtract(0, diff) }
        threshold = Divide(target_khz, 100)
        IfCondition LessThan(diff, threshold) ThenBlock: {
            PrintMessage("[TEST] already at target clock, skipping reprogram\n")
            ReturnValue(0)
        }

        // ---- SPLL REPROGRAMMING (mirrors AccelGCN_SetSCLK) ----
        PrintMessage("\n[TEST] >>> REPROGRAMMING SPLL <<<\n")

        ss_reg = GPU_Rd32(gpu, SIReg.CG_SPLL_SPREAD_SPECTRUM)

        // Step 1: Disable spread spectrum
        ss_new = BitwiseAnd(ss_reg, Subtract(4294967295, SPLLBits.SSEN))
        GPU_Wr32(gpu, SIReg.CG_SPLL_SPREAD_SPECTRUM, ss_new)

        // Step 2: Enable SPLL bypass
        cntl_new = BitwiseOr(cntl, SPLLBits.SPLL_BYPASS_EN)
        GPU_Wr32(gpu, SIReg.CG_SPLL_FUNC_CNTL, cntl_new)
        fence = GPU_Rd32(gpu, SIReg.CG_SPLL_FUNC_CNTL)

        // Step 3: Assert SPLL reset
        cntl_new = BitwiseOr(cntl_new, SPLLBits.SPLL_RESET)
        GPU_Wr32(gpu, SIReg.CG_SPLL_FUNC_CNTL, cntl_new)

        // Step 4: Program new dividers
        cntl_new = BitwiseAnd(cntl_new, Subtract(4294967295, SPLLBits.SPLL_REF_DIV_MASK))
        cntl_new = BitwiseAnd(cntl_new, Subtract(4294967295, SPLLBits.SPLL_PDIV_A_MASK))
        cntl_new = BitwiseOr(cntl_new, Multiply(new_refdiv, 16))
        cntl_new = BitwiseOr(cntl_new, Multiply(new_pdiv, 1048576))
        GPU_Wr32(gpu, SIReg.CG_SPLL_FUNC_CNTL, cntl_new)

        cntl3_new = BitwiseAnd(cntl3, Subtract(4294967295, SPLLBits.SPLL_FB_DIV_MASK))
        cntl3_new = BitwiseOr(cntl3_new, new_fbdiv)
        GPU_Wr32(gpu, SIReg.CG_SPLL_FUNC_CNTL_3, cntl3_new)

        // Step 5: Deassert reset
        cntl_new = BitwiseAnd(cntl_new, Subtract(4294967295, SPLLBits.SPLL_RESET))
        cntl_new = BitwiseAnd(cntl_new, Subtract(4294967295, SPLLBits.SPLL_SLEEP))
        GPU_Wr32(gpu, SIReg.CG_SPLL_FUNC_CNTL, cntl_new)

        // Step 6: Poll for PLL lock
        lock_count = 0
        lock_ok = 0
        WhileLoop LessThan(lock_count, 10000) {
            status = GPU_Rd32(gpu, SIReg.SPLL_STATUS)
            IfCondition NotEqual(BitwiseAnd(status, SPLLBits.SPLL_CHG_STATUS), 0) ThenBlock: {
                lock_ok = 1
                ExitLoop
            }
            lock_count = Add(lock_count, 1)
        }

        IfCondition EqualTo(lock_ok, 0) ThenBlock: {
            PrintMessage("[TEST] PLL LOCK TIMEOUT — leaving bypass on, will restore\n")
            ReturnValue(-2)
        }

        PrintMessage("[TEST] PLL locked after ")
        PrintNumber(lock_count)
        PrintMessage(" polls\n")

        // Step 7: Disable bypass — this is the moment of truth
        cntl_new = BitwiseAnd(cntl_new, Subtract(4294967295, SPLLBits.SPLL_BYPASS_EN))
        GPU_Wr32(gpu, SIReg.CG_SPLL_FUNC_CNTL, cntl_new)
        fence = GPU_Rd32(gpu, SIReg.CG_SPLL_FUNC_CNTL)

        PrintMessage("[TEST] bypass disabled — new clock active\n")
        PrintMessage("[TEST] SPLL state after reprogram:\n")
        SPLL_Decode(gpu, ref_khz)

        ReturnValue(0)
    }
}

// =============================================================================
// MAIN
// =============================================================================
Function.Main {
    Body: {
        PrintMessage("=== SCLK Clock Setting Test ===\n")
        PrintMessage("This test saves SPLL state, attempts clock change,\n")
        PrintMessage("then restores original state.\n\n")

        // --- GPU discovery + BAR mapping (minimal, no CP/ring/firmware) ---
        n_gpus = GPU_Discover()
        IfCondition EqualTo(n_gpus, 0) ThenBlock: {
            PrintMessage("FAIL: no AMD GPU found\n")
            ReturnValue(1)
        }
        PrintMessage("[INIT] found ")
        PrintNumber(n_gpus)
        PrintMessage(" GPU(s)\n")

        gpu = 0
        GPU_BAR_Init()
        rc = GPU_BAR_MapMMIO(gpu)
        IfCondition EqualTo(rc, 0) ThenBlock: {
            PrintMessage("FAIL: MMIO map failed\n")
            ReturnValue(1)
        }
        PrintMessage("[INIT] MMIO mapped\n")

        // --- Phase 1: Save current SPLL state ---
        PrintMessage("\n--- Phase 1: Save current SPLL state ---\n")
        SPLL_Save(gpu)

        // Get ref clock for decode (need AtomBIOS)
        rom = AtomBIOS_LoadROM(gpu)
        ref_khz = 0
        IfCondition NotEqual(rom, 0) ThenBlock: {
            ap_rc = AtomBIOS_Parse(gpu)
            IfCondition EqualTo(ap_rc, 1) ThenBlock: {
                ref_khz = AtomBIOS_GetField(gpu, AtomField.CORE_REF_CLK)
            }
        }
        // Fallback: 27 MHz reference is standard for SI
        IfCondition EqualTo(ref_khz, 0) ThenBlock: {
            ref_khz = 27000
            PrintMessage("[INIT] using fallback ref clock: 27 MHz\n")
        }

        PrintMessage("\n--- Phase 2: Decode current PLL state ---\n")
        SPLL_Decode(gpu, ref_khz)

        // --- Phase 3: Attempt clock change ---
        PrintMessage("\n--- Phase 3: Attempt SCLK reprogram ---\n")
        test_rc = SPLL_TestProgram(gpu)
        PrintMessage("\n[TEST] reprogram result = ")
        PrintNumber(test_rc)
        PrintMessage("\n")

        // --- Phase 4: ALWAYS restore, regardless of test outcome ---
        PrintMessage("\n--- Phase 4: Restore original clock ---\n")
        restore_rc = SPLL_Restore(gpu)

        // --- Phase 5: Verify restoration ---
        PrintMessage("\n--- Phase 5: Verify restored state ---\n")
        SPLL_Decode(gpu, ref_khz)

        // Final readback comparison
        final_cntl  = GPU_Rd32(gpu, SIReg.CG_SPLL_FUNC_CNTL)
        final_cntl3 = GPU_Rd32(gpu, SIReg.CG_SPLL_FUNC_CNTL_3)
        final_ss    = GPU_Rd32(gpu, SIReg.CG_SPLL_SPREAD_SPECTRUM)

        match = 1
        IfCondition NotEqual(final_cntl, SPLLSave.cntl) ThenBlock: {
            PrintMessage("[VERIFY] MISMATCH: CNTL 0x")
            PrintHex(final_cntl)
            PrintMessage(" != saved 0x")
            PrintHex(SPLLSave.cntl)
            PrintMessage("\n")
            match = 0
        }
        IfCondition NotEqual(final_cntl3, SPLLSave.cntl3) ThenBlock: {
            PrintMessage("[VERIFY] MISMATCH: CNTL3 0x")
            PrintHex(final_cntl3)
            PrintMessage(" != saved 0x")
            PrintHex(SPLLSave.cntl3)
            PrintMessage("\n")
            match = 0
        }
        IfCondition NotEqual(final_ss, SPLLSave.ss) ThenBlock: {
            PrintMessage("[VERIFY] MISMATCH: SS 0x")
            PrintHex(final_ss)
            PrintMessage(" != saved 0x")
            PrintHex(SPLLSave.ss)
            PrintMessage("\n")
            match = 0
        }

        IfCondition EqualTo(match, 1) ThenBlock: {
            PrintMessage("\n=== ALL REGISTERS RESTORED — MATCH ===\n")
        }
        IfCondition EqualTo(match, 0) ThenBlock: {
            PrintMessage("\n=== WARNING: REGISTER MISMATCH AFTER RESTORE ===\n")
        }

        PrintMessage("\n[RESULT] test_rc=")
        PrintNumber(test_rc)
        PrintMessage(" restore_rc=")
        PrintNumber(restore_rc)
        PrintMessage("\n")

        IfCondition EqualTo(test_rc, -3) ThenBlock: {
            PrintMessage("\n*** VOLTAGE EXCEEDED: target SCLK requires more voltage than boot.\n")
            PrintMessage("*** This is the likely cause of the vertical bars crash.\n")
            PrintMessage("*** AccelGCN_SetSCLK needs a voltage guard before reprogramming.\n")
        }

        PrintMessage("\n=== test_sclk complete ===\n")
        SystemCall(60, 0, 0, 0, 0, 0)
    }
}

RunTask(Main)
