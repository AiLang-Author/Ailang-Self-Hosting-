// test_sclk_readonly.ailang — READ-ONLY SCLK diagnostic
//
// Reads and decodes the current SPLL state, AtomBIOS clock targets, and
// voltage info. Does NOT write any registers. Cannot crash or blank display.
//
// Use this to verify we can read the clock before attempting to set it.
//
// Build: ./ailang.x TestCode/test_sclk_readonly.ailang -o test_sclk_ro.x
// Run:   sudo ./test_sclk_ro.x 2>&1 | tee sclk_readonly_log.txt

LibraryImport.Drivers.AMDGPU.AMDGPUFamily
LibraryImport.Drivers.AMDGPU.AMDGPUDiscover
LibraryImport.Drivers.AMDGPU.AMDGPUBAR
LibraryImport.Drivers.AMDGPU.AMDGPUAtomBIOS
LibraryImport.Drivers.AMDGPU.AMDGPUPM4Regs

// =============================================================================
// SPLL_ReadDecode — read and decode current PLL state (NO WRITES)
// =============================================================================
Function.SPLL_ReadDecode {
    Input: gpu: Integer
    Input: ref_khz: Integer
    Body: {
        cntl   = GPU_Rd32(gpu, SIReg.CG_SPLL_FUNC_CNTL)
        cntl2  = GPU_Rd32(gpu, SIReg.CG_SPLL_FUNC_CNTL_2)
        cntl3  = GPU_Rd32(gpu, SIReg.CG_SPLL_FUNC_CNTL_3)
        cntl4  = GPU_Rd32(gpu, SIReg.CG_SPLL_FUNC_CNTL_4)
        status = GPU_Rd32(gpu, SIReg.SPLL_STATUS)
        ss     = GPU_Rd32(gpu, SIReg.CG_SPLL_SPREAD_SPECTRUM)
        ss2    = GPU_Rd32(gpu, SIReg.CG_SPLL_SPREAD_SPECTRUM_2)

        PrintMessage("\n=== SPLL Register Dump (read-only) ===\n")
        PrintMessage("  CG_SPLL_FUNC_CNTL     = 0x")
        PrintHex(cntl)
        PrintMessage("\n")
        PrintMessage("  CG_SPLL_FUNC_CNTL_2   = 0x")
        PrintHex(cntl2)
        PrintMessage("\n")
        PrintMessage("  CG_SPLL_FUNC_CNTL_3   = 0x")
        PrintHex(cntl3)
        PrintMessage("\n")
        PrintMessage("  CG_SPLL_FUNC_CNTL_4   = 0x")
        PrintHex(cntl4)
        PrintMessage("\n")
        PrintMessage("  SPLL_STATUS            = 0x")
        PrintHex(status)
        PrintMessage("\n")
        PrintMessage("  CG_SPLL_SPREAD_SPEC    = 0x")
        PrintHex(ss)
        PrintMessage("\n")
        PrintMessage("  CG_SPLL_SPREAD_SPEC_2  = 0x")
        PrintHex(ss2)
        PrintMessage("\n")

        // Decode dividers
        refdiv = BitwiseAnd(Divide(cntl, 16), 63)
        pdiv   = BitwiseAnd(Divide(cntl, 1048576), 127)
        fbdiv  = BitwiseAnd(cntl3, 67108863)

        PrintMessage("\n=== Decoded Dividers ===\n")
        PrintMessage("  REF_DIV  = ")
        PrintNumber(refdiv)
        PrintMessage("\n")
        PrintMessage("  FBDIV    = ")
        PrintNumber(fbdiv)
        PrintMessage("\n")
        PrintMessage("  PDIV_A   = ")
        PrintNumber(pdiv)
        PrintMessage("\n")

        // Decode flags
        bypass = BitwiseAnd(cntl, SPLLBits.SPLL_BYPASS_EN)
        reset  = BitwiseAnd(cntl, SPLLBits.SPLL_RESET)
        sleep  = BitwiseAnd(cntl, SPLLBits.SPLL_SLEEP)
        locked = BitwiseAnd(status, SPLLBits.SPLL_CHG_STATUS)
        ss_en  = BitwiseAnd(ss, SPLLBits.SSEN)

        PrintMessage("\n=== PLL Flags ===\n")
        PrintMessage("  BYPASS   = ")
        IfCondition NotEqual(bypass, 0) ThenBlock: { PrintMessage("YES (engine on ref clock)\n") }
        IfCondition EqualTo(bypass, 0) ThenBlock: { PrintMessage("NO (engine on PLL output)\n") }
        PrintMessage("  RESET    = ")
        IfCondition NotEqual(reset, 0) ThenBlock: { PrintMessage("YES (PLL held in reset)\n") }
        IfCondition EqualTo(reset, 0) ThenBlock: { PrintMessage("NO\n") }
        PrintMessage("  SLEEP    = ")
        IfCondition NotEqual(sleep, 0) ThenBlock: { PrintMessage("YES (PLL powered down)\n") }
        IfCondition EqualTo(sleep, 0) ThenBlock: { PrintMessage("NO\n") }
        PrintMessage("  LOCKED   = ")
        IfCondition NotEqual(locked, 0) ThenBlock: { PrintMessage("YES\n") }
        IfCondition EqualTo(locked, 0) ThenBlock: { PrintMessage("NO (PLL not locked!)\n") }
        PrintMessage("  SPREAD_SPEC = ")
        IfCondition NotEqual(ss_en, 0) ThenBlock: { PrintMessage("ENABLED\n") }
        IfCondition EqualTo(ss_en, 0) ThenBlock: { PrintMessage("DISABLED\n") }

        // Compute current SCLK
        PrintMessage("\n=== Current SCLK ===\n")
        IfCondition EqualTo(refdiv, 0) ThenBlock: {
            PrintMessage("  ERROR: REF_DIV is 0, cannot compute SCLK\n")
            ReturnValue(0)
        }
        IfCondition EqualTo(pdiv, 0) ThenBlock: {
            PrintMessage("  ERROR: PDIV is 0, cannot compute SCLK\n")
            ReturnValue(0)
        }

        sclk_khz = Divide(Multiply(ref_khz, fbdiv), Multiply(refdiv, pdiv))
        PrintMessage("  ref_clk  = ")
        PrintNumber(Divide(ref_khz, 1000))
        PrintMessage(" MHz (")
        PrintNumber(ref_khz)
        PrintMessage(" kHz)\n")
        PrintMessage("  formula  = (ref * FBDIV) / (REFDIV * PDIV)\n")
        PrintMessage("           = (")
        PrintNumber(ref_khz)
        PrintMessage(" * ")
        PrintNumber(fbdiv)
        PrintMessage(") / (")
        PrintNumber(refdiv)
        PrintMessage(" * ")
        PrintNumber(pdiv)
        PrintMessage(")\n")
        PrintMessage("  SCLK     = ")
        PrintNumber(Divide(sclk_khz, 1000))
        PrintMessage(" MHz (")
        PrintNumber(sclk_khz)
        PrintMessage(" kHz)\n")

        ReturnValue(sclk_khz)
    }
}

// =============================================================================
// MAIN
// =============================================================================
Function.Main {
    Body: {
        PrintMessage("=== SCLK Read-Only Diagnostic ===\n")
        PrintMessage("This test ONLY READS registers. No writes. Cannot crash.\n\n")

        // GPU discovery + BAR mapping
        n_gpus = GPU_Discover()
        IfCondition EqualTo(n_gpus, 0) ThenBlock: {
            PrintMessage("FAIL: no AMD GPU found\n")
            ReturnValue(1)
        }
        PrintMessage("[INIT] found ")
        PrintNumber(n_gpus)
        PrintMessage(" GPU(s)\n")

        // Select compute GPU by PCI bus number (bus 2 = 02:00.0).
        // Display GPU is bus 1 = 01:00.0 — DO NOT MAP OR TOUCH IT.
        gpu = -1
        gi = 0
        WhileLoop LessThan(gi, n_gpus) {
            bus = GPU_GetDeviceField(gi, GPUDevField.PCI_BUS)
            IfCondition EqualTo(bus, 2) ThenBlock: {
                gpu = gi
            }
            gi = Add(gi, 1)
        }
        IfCondition LessThan(gpu, 0) ThenBlock: {
            PrintMessage("FAIL: no GPU on PCI bus 02.\n")
            SystemCall(60, 1, 0, 0, 0, 0)
        }

        GPU_BAR_Init()
        rc = GPU_BAR_MapMMIO(gpu)
        IfCondition EqualTo(rc, 0) ThenBlock: {
            PrintMessage("FAIL: MMIO map failed\n")
            ReturnValue(1)
        }
        PrintMessage("[INIT] MMIO mapped for GPU ")
        PrintNumber(gpu)
        PrintMessage(" (PCI bus 02)\n")

        // Load AtomBIOS for reference clock and target info
        ref_khz = 27000
        target_khz = 0
        def_khz = 0
        max_khz = 0
        boot_vddc = 0
        max_vddc = 0

        rom = AtomBIOS_LoadROM(gpu)
        IfCondition NotEqual(rom, 0) ThenBlock: {
            ap_rc = AtomBIOS_Parse(gpu)
            IfCondition EqualTo(ap_rc, 1) ThenBlock: {
                PrintMessage("\n--- AtomBIOS Data ---\n")
                AtomBIOS_PrintInfo(gpu)

                ref_khz    = AtomBIOS_GetField(gpu, AtomField.CORE_REF_CLK)
                def_khz    = AtomBIOS_GetField(gpu, AtomField.DEF_ENGINE_CLK)
                max_khz    = AtomBIOS_GetField(gpu, AtomField.MAX_ENGINE_CLK)
                boot_vddc  = AtomBIOS_GetField(gpu, AtomField.BOOT_VDDC)
                max_vddc   = AtomBIOS_GetField(gpu, AtomField.MAX_ENGINE_VDDC)

                IfCondition EqualTo(ref_khz, 0) ThenBlock: {
                    ref_khz = 27000
                    PrintMessage("  (ref clock not in ROM, using 27 MHz fallback)\n")
                }
            }
        }
        IfCondition EqualTo(rom, 0) ThenBlock: {
            PrintMessage("\n[WARN] AtomBIOS ROM load failed, using 27 MHz ref fallback\n")
        }

        // Read and decode current PLL state
        cur_sclk = SPLL_ReadDecode(gpu, ref_khz)

        // Print AtomBIOS target comparison
        PrintMessage("\n=== AtomBIOS Clock Targets ===\n")
        PrintMessage("  DEF_ENGINE_CLK  = ")
        PrintNumber(Divide(def_khz, 1000))
        PrintMessage(" MHz (")
        PrintNumber(def_khz)
        PrintMessage(" kHz)\n")
        PrintMessage("  MAX_ENGINE_CLK  = ")
        PrintNumber(Divide(max_khz, 1000))
        PrintMessage(" MHz (")
        PrintNumber(max_khz)
        PrintMessage(" kHz)\n")
        PrintMessage("  CORE_REF_CLK    = ")
        PrintNumber(Divide(ref_khz, 1000))
        PrintMessage(" MHz\n")

        PrintMessage("\n=== Voltage Info ===\n")
        PrintMessage("  BOOT_VDDC       = ")
        PrintNumber(boot_vddc)
        PrintMessage(" mV\n")
        PrintMessage("  MAX_ENGINE_VDDC = ")
        PrintNumber(max_vddc)
        PrintMessage(" mV\n")

        IfCondition GreaterThan(max_vddc, 0) ThenBlock: {
            IfCondition GreaterThan(boot_vddc, 0) ThenBlock: {
                vddc_over = 0
                IfCondition GreaterThan(max_vddc, boot_vddc) ThenBlock: {
                    vddc_over = 1
                    PrintMessage("  WARNING: max clock needs MORE voltage than boot provides\n")
                    PrintMessage("           delta = ")
                    PrintNumber(Subtract(max_vddc, boot_vddc))
                    PrintMessage(" mV\n")
                }
                IfCondition EqualTo(vddc_over, 0) ThenBlock: {
                    PrintMessage("  OK: boot voltage sufficient for max clock\n")
                }
            }
        }

        // Compute what we WOULD program
        PrintMessage("\n=== Reprogram Plan (NOT EXECUTING) ===\n")
        target_khz = max_khz
        IfCondition EqualTo(target_khz, 0) ThenBlock: {
            target_khz = def_khz
        }
        IfCondition EqualTo(target_khz, 0) ThenBlock: {
            PrintMessage("  No target clock available from AtomBIOS\n")
        }
        IfCondition GreaterThan(target_khz, 0) ThenBlock: {
            new_fbdiv = Divide(target_khz, ref_khz)
            IfCondition LessThan(new_fbdiv, 1) ThenBlock: { new_fbdiv = 1 }
            planned_khz = Divide(Multiply(ref_khz, new_fbdiv), 1)

            PrintMessage("  target  = ")
            PrintNumber(Divide(target_khz, 1000))
            PrintMessage(" MHz\n")
            PrintMessage("  FBDIV   = ")
            PrintNumber(new_fbdiv)
            PrintMessage(" (REF_DIV=1, PDIV=1)\n")
            PrintMessage("  actual  = ")
            PrintNumber(Divide(planned_khz, 1000))
            PrintMessage(" MHz\n")

            // Check delta from current
            IfCondition GreaterThan(cur_sclk, 0) ThenBlock: {
                diff = Subtract(planned_khz, cur_sclk)
                IfCondition LessThan(diff, 0) ThenBlock: { diff = Subtract(0, diff) }
                threshold = Divide(target_khz, 100)
                needs_reprogram = 1
                IfCondition LessThan(diff, threshold) ThenBlock: {
                    needs_reprogram = 0
                    PrintMessage("  RESULT: already within 1% of target -- no reprogram needed\n")
                }
                IfCondition EqualTo(needs_reprogram, 1) ThenBlock: {
                    PrintMessage("  RESULT: reprogram WOULD be needed\n")
                    PrintMessage("          current=")
                    PrintNumber(Divide(cur_sclk, 1000))
                    PrintMessage(" MHz, target=")
                    PrintNumber(Divide(planned_khz, 1000))
                    PrintMessage(" MHz, delta=")
                    PrintNumber(Divide(diff, 1000))
                    PrintMessage(" MHz\n")
                }
            }
        }

        // Read a few display-related registers for future CRTC blanking work
        PrintMessage("\n=== Display Registers (for CRTC blanking planning) ===\n")
        vga = GPU_Rd32(gpu, SIReg.VGA_RENDER_CONTROL)
        PrintMessage("  VGA_RENDER_CONTROL = 0x")
        PrintHex(vga)
        PrintMessage("\n")

        PrintMessage("\n=== test_sclk_readonly complete ===\n")
        SystemCall(60, 0, 0, 0, 0, 0)
    }
}

RunTask(Main)
