// test_smc_load.ailang — SMC firmware loading and message test
// Build: ./ailang.x TestCode/test_smc_load.ailang test_smc_load.x
// Run:   sudo ./test_smc_load.x
//
// Tests:
//   1. Discover GPUs, auto-select compute card (zero active CRTCs)
//   2. Load SMC firmware (verde_smc.bin) and upload to SRAM
//   3. Start the SMC (deassert reset, enable clock)
//   4. Send TEST message and verify response = 1 (OK)
//   5. Read back first 16 SRAM DWORDs for diagnostic
//   6. Stop the SMC cleanly

LibraryImport.Arena
LibraryImport.Drivers.AMDGPU.AMDGPUFamily
LibraryImport.Drivers.AMDGPU.AMDGPUDiscover
LibraryImport.Drivers.AMDGPU.AMDGPUBAR
LibraryImport.Drivers.AMDGPU.AMDGPUSMCRegs
LibraryImport.Drivers.AMDGPU.AMDGPUSMC_SI
LibraryImport.Drivers.AMDGPU.AMDGPUSMC
LibraryImport.Drivers.AMDGPU.AMDGPUDisplay

SubRoutine.Main {
    PrintMessage("=== SMC Firmware Load Test ===\n\n")

    // --- Discover GPUs ---
    count = GPU_Discover()
    IfCondition EqualTo(count, 0) ThenBlock: {
        PrintMessage("No AMD GPUs found.\n")
        SystemCall(60, 1, 0, 0, 0, 0)
    }
    GPU_PrintAll()
    PrintMessage("\n")

    // --- Map MMIO BARs on all GPUs (initial map for CRTC detection) ---
    GPU_BAR_Init()
    gi = 0
    WhileLoop LessThan(gi, count) {
        GPU_BAR_MapMMIO(gi)
        gi = Add(gi, 1)
    }

    // --- Auto-select compute GPU (zero active CRTCs) ---
    gpu = -1
    gi = 0
    WhileLoop LessThan(gi, count) {
        IfCondition EqualTo(GPU_BAR_IsMMIOMapped(gi), 1) ThenBlock: {
            crtc_count = 0
            pipe = 0
            WhileLoop LessThan(pipe, 6) {
                IfCondition EqualTo(DCE6_IsCRTCActive(gi, pipe), 1) ThenBlock: {
                    crtc_count = Add(crtc_count, 1)
                }
                pipe = Add(pipe, 1)
            }
            PrintMessage("GPU ")
            PrintNumber(gi)
            PrintMessage(": active CRTCs = ")
            PrintNumber(crtc_count)
            PrintMessage("\n")

            IfCondition EqualTo(crtc_count, 0) ThenBlock: {
                gpu = gi
            }
        }
        gi = Add(gi, 1)
    }

    IfCondition LessThan(gpu, 0) ThenBlock: {
        IfCondition EqualTo(count, 1) ThenBlock: {
            gpu = 0
            PrintMessage("Single GPU — using GPU 0\n")
        }
        IfCondition GreaterThan(count, 1) ThenBlock: {
            PrintMessage("No GPU with zero CRTCs — falling back to highest PCI bus\n")
            best_bus = -1
            gi = 0
            WhileLoop LessThan(gi, count) {
                bus = GPU_GetDeviceField(gi, GPUDevField.PCI_BUS)
                IfCondition GreaterThan(bus, best_bus) ThenBlock: {
                    best_bus = bus
                    gpu = gi
                }
                gi = Add(gi, 1)
            }
        }
    }

    PrintMessage("\nSelected GPU ")
    PrintNumber(gpu)
    PrintMessage(" as compute card\n\n")

    // --- MMIO health check ---
    // Read a known register to verify MMIO is responding.
    // 0xFFFFFFFF = PCI master abort (card needs reboot).
    // 0x00000000 = card SMC dead but MMIO works (can load firmware).
    health = GPU_Rd32(gpu, SMCReg.IND_ACCESS_CNTL)
    PrintMessage("MMIO health check (IND_ACCESS_CNTL): 0x")
    PrintHex(health)
    PrintMessage("\n")
    // Compare to 0xFFFFFFFF (4294967295)
    IfCondition EqualTo(health, 4294967295) ThenBlock: {
        PrintMessage("FATAL: GPU MMIO returns 0xFFFFFFFF — card is uninitialized.\n")
        PrintMessage("       A system reboot is required to re-POST the VBIOS.\n")
        SystemCall(60, 1, 0, 0, 0, 0)
    }
    PrintMessage("\n")

    // --- Check SMC status before loading ---
    PrintMessage("--- Pre-Load SMC Status ---\n")
    PrintMessage("SMC running: ")
    PrintNumber(SMC_SI_IsRunning(gpu))
    PrintMessage("\n")

    rst_val = SMC_SI_IndRd32(gpu, SMCSyscon.RESET_CNTL)
    PrintMessage("RESET_CNTL:  0x")
    PrintHex(rst_val)
    PrintMessage("\n")

    clk_val = SMC_SI_IndRd32(gpu, SMCSyscon.CLOCK_CNTL_0)
    PrintMessage("CLOCK_CNTL_0: 0x")
    PrintHex(clk_val)
    PrintMessage("\n\n")

    // --- Load firmware ---
    PrintMessage("--- Loading SMC Firmware ---\n")
    rc = SMC_LoadFirmware(gpu)
    PrintMessage("Load result: ")
    PrintNumber(rc)
    PrintMessage("\n\n")

    IfCondition LessThan(rc, 0) ThenBlock: {
        PrintMessage("FAIL: SMC firmware load failed\n")
        SystemCall(60, 1, 0, 0, 0, 0)
    }

    // --- Post-load status ---
    PrintMessage("--- Post-Load SMC Status ---\n")
    PrintMessage("SMC running: ")
    PrintNumber(SMC_SI_IsRunning(gpu))
    PrintMessage("\n")

    rst_val = SMC_SI_IndRd32(gpu, SMCSyscon.RESET_CNTL)
    PrintMessage("RESET_CNTL:  0x")
    PrintHex(rst_val)
    PrintMessage("\n")

    clk_val = SMC_SI_IndRd32(gpu, SMCSyscon.CLOCK_CNTL_0)
    PrintMessage("CLOCK_CNTL_0: 0x")
    PrintHex(clk_val)
    PrintMessage("\n\n")

    // --- Send messages ---
    // Note: SI SMC has NO test/ping message. PPSMC_MSG_TEST (0x01) does not exist;
    // 0x01 is PPSMC_Result_OK (a response code). Sending it returns 0xFE = "not supported".
    // The first valid message the kernel sends is PPSMC_MSG_NoDisplay (0x5D).
    // We also try PPSMC_MSG_Halt (0x10) which should be safe.

    PrintMessage("--- Sending Messages ---\n")
    PrintMessage("RESP_0 before send: 0x")
    PrintHex(GPU_Rd32(gpu, SMCReg.RESP_0))
    PrintMessage("\n")

    // Clear RESP_0 before sending (SI kernel doesn't, but safer for first msg)
    GPU_Wr32(gpu, SMCReg.RESP_0, 0)

    // Send PPSMC_MSG_NoDisplay (0x5D = 93) — first message kernel sends
    PrintMessage("Sending NoDisplay (0x5D)... ")
    nd_resp = SMC_SendMessage(gpu, SMCMsg.NO_DISPLAY)
    PrintMessage("response: 0x")
    PrintHex(nd_resp)
    IfCondition EqualTo(nd_resp, SMCResp.OK) ThenBlock: {
        PrintMessage(" (OK)\n")
    }
    ElseBlock: {
        PrintMessage("\n")
    }

    // Clear and send HALT (0x10)
    GPU_Wr32(gpu, SMCReg.RESP_0, 0)
    PrintMessage("Sending Halt (0x10)... ")
    halt_resp = SMC_SendMessage(gpu, SMCMsg.HALT)
    PrintMessage("response: 0x")
    PrintHex(halt_resp)
    IfCondition EqualTo(halt_resp, SMCResp.OK) ThenBlock: {
        PrintMessage(" (OK)\n")
    }
    ElseBlock: {
        PrintMessage("\n")
    }

    // If halt succeeded, resume
    IfCondition EqualTo(halt_resp, SMCResp.OK) ThenBlock: {
        GPU_Wr32(gpu, SMCReg.RESP_0, 0)
        PrintMessage("Sending Resume (0x11)... ")
        res_resp = SMC_SendMessage(gpu, SMCMsg.RESUME)
        PrintMessage("response: 0x")
        PrintHex(res_resp)
        IfCondition EqualTo(res_resp, SMCResp.OK) ThenBlock: {
            PrintMessage(" (OK)\n")
        }
        ElseBlock: {
            PrintMessage("\n")
        }
    }
    PrintMessage("\n")

    // --- Read SRAM at addr 0 (bootstrap) ---
    PrintMessage("--- SRAM[0x0] (bootstrap) ---\n")
    PrintMessage("  [0x0] = 0x")
    PrintHex(SMC_ReadSRAM(gpu, 0))
    PrintMessage("\n\n")

    // --- Read first 8 firmware DWORDs at 0x10000 ---
    PrintMessage("--- SRAM Readback at 0x10000 (firmware) ---\n")
    ri = 0
    WhileLoop LessThan(ri, 8) {
        addr = Add(65536, Multiply(ri, 4))
        val = SMC_ReadSRAM(gpu, addr)
        PrintMessage("  [0x")
        PrintHex(addr)
        PrintMessage("] = 0x")
        PrintHex(val)
        PrintMessage("\n")
        ri = Add(ri, 1)
    }
    PrintMessage("\n")

    // --- Read SCRATCH0 (direct MMIO) ---
    scratch0 = GPU_Rd32(gpu, SMCReg.SCRATCH0)
    PrintMessage("SMC_SCRATCH0: 0x")
    PrintHex(scratch0)
    PrintMessage("\n\n")

    // --- Stop SMC ---
    PrintMessage("--- Stopping SMC ---\n")
    SMC_StopSMC(gpu)
    PrintMessage("SMC running: ")
    PrintNumber(SMC_IsRunning(gpu))
    PrintMessage("\n\n")

    // --- Cleanup ---
    gi = 0
    WhileLoop LessThan(gi, count) {
        GPU_BAR_Unmap(gi)
        gi = Add(gi, 1)
    }

    PrintMessage("=== SMC Load Test Complete ===\n")
    SystemCall(60, 0, 0, 0, 0, 0)
}

RunTask(Main)
