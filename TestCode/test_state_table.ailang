// test_state_table.ailang — Focused state table upload + verification
// Build: ./ailang.x TestCode/test_state_table.ailang test_state_table.x
// Run:   sg video -c "./test_state_table.x"

LibraryImport.Arena
LibraryImport.Drivers.AMDGPU.AMDGPUFamily
LibraryImport.Drivers.AMDGPU.AMDGPUDiscover
LibraryImport.Drivers.AMDGPU.AMDGPUBAR
LibraryImport.Drivers.AMDGPU.AMDGPUAtomBIOS
LibraryImport.Drivers.AMDGPU.AMDGPUSMCRegs
LibraryImport.Drivers.AMDGPU.AMDGPUSMC_SI
LibraryImport.Drivers.AMDGPU.AMDGPUSMC
LibraryImport.Drivers.AMDGPU.AMDGPUPowerPlay
LibraryImport.Drivers.AMDGPU.AMDGPUVoltage
LibraryImport.Drivers.AMDGPU.AMDGPUDPM_SI
LibraryImport.Drivers.AMDGPU.AMDGPUDPM
LibraryImport.Drivers.AMDGPU.AMDGPUDisplay
LibraryImport.Drivers.AMDGPU.AMDGPUPM4Regs

SubRoutine.Main {
    PrintMessage("=== State Table Diagnostic ===\n\n")

    count = GPU_Discover()
    GPU_BAR_Init()
    gi = 0
    WhileLoop LessThan(gi, count) {
        GPU_BAR_MapMMIO(gi)
        gi = Add(gi, 1)
    }

    // Select compute GPU
    gpu = 0
    gi = 0
    WhileLoop LessThan(gi, count) {
        crtc_count = 0
        pipe = 0
        WhileLoop LessThan(pipe, 6) {
            IfCondition EqualTo(DCE6_IsCRTCActive(gi, pipe), 1) ThenBlock: {
                crtc_count = Add(crtc_count, 1)
            }
            pipe = Add(pipe, 1)
        }
        IfCondition EqualTo(crtc_count, 0) ThenBlock: { gpu = gi }
        gi = Add(gi, 1)
    }
    PrintMessage("Using GPU ")
    PrintNumber(gpu)
    PrintMessage("\n\n")

    // Load AtomBIOS + PP + Voltage
    rom = AtomBIOS_LoadROM(gpu)
    AtomBIOS_Parse(gpu)
    PP_Parse(gpu)
    Volt_Parse(gpu)

    // Load SMC firmware
    smc_rc = SMC_LoadFirmware(gpu)
    PrintMessage("SMC loaded: ")
    PrintNumber(smc_rc)
    PrintMessage("\n")

    // Verify SMC alive
    GPU_Wr32(gpu, SMCReg.RESP_0, 0)
    resp = SMC_SendMessage(gpu, SMCMsg.NO_DISPLAY)
    PrintMessage("NoDisplay: 0x")
    PrintHex(resp)
    PrintMessage("\n\n")

    // Read firmware header
    state_tbl_addr = SMC_ReadSRAM(gpu, Add(65536, SMCFWHdr.STATE_TABLE))
    soft_regs_addr = SMC_ReadSRAM(gpu, Add(65536, SMCFWHdr.SOFT_REGS))
    PrintMessage("State table SRAM addr: 0x")
    PrintHex(state_tbl_addr)
    PrintMessage("\nSoft regs SRAM addr:   0x")
    PrintHex(soft_regs_addr)
    PrintMessage("\n\n")

    // Read what's already in the state table BEFORE we write
    PrintMessage("=== State table BEFORE upload ===\n")
    ri = 0
    WhileLoop LessThan(ri, 16) {
        addr = Add(state_tbl_addr, Multiply(ri, 4))
        val = SMC_ReadSRAM(gpu, addr)
        PrintMessage("  [0x")
        PrintHex(addr)
        PrintMessage("] = 0x")
        PrintHex(val)
        PrintMessage("\n")
        ri = Add(ri, 1)
    }
    PrintMessage("\n")

    // Also read the driverState offset (0x2A4 = 676 from state table start)
    drv_addr = Add(state_tbl_addr, 676)
    PrintMessage("driverState region (offset 0x2A4):\n")
    ri = 0
    WhileLoop LessThan(ri, 8) {
        addr = Add(drv_addr, Multiply(ri, 4))
        val = SMC_ReadSRAM(gpu, addr)
        PrintMessage("  [0x")
        PrintHex(addr)
        PrintMessage("] = 0x")
        PrintHex(val)
        PrintMessage("\n")
        ri = Add(ri, 1)
    }
    PrintMessage("\n")

    // --- Halt SMC, build and upload state table ---
    PrintMessage("=== Building and uploading state table ===\n")
    GPU_Wr32(gpu, SMCReg.RESP_0, 0)
    resp = SMC_SendMessage(gpu, SMCMsg.HALT)
    PrintMessage("Halt: 0x")
    PrintHex(resp)
    PrintMessage("\n")
    SMC_WaitInactive(gpu)

    // Init DPM to allocate state
    DPM_Init()
    rc = DPM_SI_BuildStateTable(gpu)
    PrintMessage("BuildStateTable: ")
    PrintNumber(rc)
    PrintMessage("\n")

    // --- Dump host buffer for driverState level 0 ---
    PrintMessage("\n=== Host buffer check (driverState region) ===\n")
    dpm_entry = DPM_SI_GetEntry(gpu)
    tbl_ptr = Dereference(Add(dpm_entry, DPMField.STATE_TBL_PTR))
    PrintMessage("tbl_ptr: 0x")
    PrintHex(tbl_ptr)
    PrintMessage("\n")
    // driverState starts at offset 676 = 0x2A4
    // Level 0 starts at offset 680 = 0x2A8
    host_ri = 0
    WhileLoop LessThan(host_ri, 8) {
        host_off = Add(676, Multiply(host_ri, 4))
        host_val = Dereference(Add(tbl_ptr, host_off), "dword")
        PrintMessage("  host[0x")
        PrintHex(host_off)
        PrintMessage("] = 0x")
        PrintHex(host_val)
        PrintMessage("\n")
        host_ri = Add(host_ri, 1)
    }
    PrintMessage("\n")

    // Read what's now in the state table AFTER upload
    PrintMessage("\n=== State table AFTER upload ===\n")
    PrintMessage("Header region:\n")
    ri = 0
    WhileLoop LessThan(ri, 8) {
        addr = Add(state_tbl_addr, Multiply(ri, 4))
        val = SMC_ReadSRAM(gpu, addr)
        PrintMessage("  [0x")
        PrintHex(addr)
        PrintMessage("] = 0x")
        PrintHex(val)
        PrintMessage("\n")
        ri = Add(ri, 1)
    }

    // Read driverState header + first level
    PrintMessage("\ndriverState header:\n")
    ri = 0
    WhileLoop LessThan(ri, 4) {
        addr = Add(drv_addr, Multiply(ri, 4))
        val = SMC_ReadSRAM(gpu, addr)
        PrintMessage("  [0x")
        PrintHex(addr)
        PrintMessage("] = 0x")
        PrintHex(val)
        PrintMessage("\n")
        ri = Add(ri, 1)
    }

    // Read firmware's initialState level BEFORE upload (at offset 0xB8 + 4)
    fw_init = Add(state_tbl_addr, Add(184, 4))
    PrintMessage("\nFirmware initialState level (at 0x")
    PrintHex(fw_init)
    PrintMessage("):\n")
    PrintMessage("  +0x00 (flags):      0x")
    PrintHex(SMC_ReadSRAM(gpu, fw_init))
    PrintMessage("\n  +0x04 (mc):         0x")
    PrintHex(SMC_ReadSRAM(gpu, Add(fw_init, 4)))
    PrintMessage("\n  +0x08 (aT):         0x")
    PrintHex(SMC_ReadSRAM(gpu, Add(fw_init, 8)))
    PrintMessage("\n  +0x10 (SPLL_CNTL):  0x")
    PrintHex(SMC_ReadSRAM(gpu, Add(fw_init, 16)))
    PrintMessage("\n  +0x14 (SPLL_C2):    0x")
    PrintHex(SMC_ReadSRAM(gpu, Add(fw_init, 20)))
    PrintMessage("\n  +0x18 (SPLL_C3):    0x")
    PrintHex(SMC_ReadSRAM(gpu, Add(fw_init, 24)))
    PrintMessage("\n  +0x1C (SPLL_C4):    0x")
    PrintHex(SMC_ReadSRAM(gpu, Add(fw_init, 28)))
    PrintMessage("\n  +0x20 (SPLL_SS):    0x")
    PrintHex(SMC_ReadSRAM(gpu, Add(fw_init, 32)))
    PrintMessage("\n  +0x24 (SPLL_SS2):   0x")
    PrintHex(SMC_ReadSRAM(gpu, Add(fw_init, 36)))
    PrintMessage("\n  +0x28 (SCLK_VAL):   0x")
    PrintHex(SMC_ReadSRAM(gpu, Add(fw_init, 40)))
    PrintMessage("\n  +0x2C (MPLL_CNTL):  0x")
    PrintHex(SMC_ReadSRAM(gpu, Add(fw_init, 44)))
    PrintMessage("\n  +0x30 (MPLL_C1):    0x")
    PrintHex(SMC_ReadSRAM(gpu, Add(fw_init, 48)))
    PrintMessage("\n  +0x34 (MPLL_C2):    0x")
    PrintHex(SMC_ReadSRAM(gpu, Add(fw_init, 52)))
    PrintMessage("\n  +0x38 (MPLL_AD):    0x")
    PrintHex(SMC_ReadSRAM(gpu, Add(fw_init, 56)))
    PrintMessage("\n  +0x3C (MPLL_DQ):    0x")
    PrintHex(SMC_ReadSRAM(gpu, Add(fw_init, 60)))
    PrintMessage("\n  +0x40 (MCLK_PWR):   0x")
    PrintHex(SMC_ReadSRAM(gpu, Add(fw_init, 64)))
    PrintMessage("\n  +0x44 (DLL_CNTL):   0x")
    PrintHex(SMC_ReadSRAM(gpu, Add(fw_init, 68)))
    PrintMessage("\n  +0x50 (MCLK_VAL):   0x")
    PrintHex(SMC_ReadSRAM(gpu, Add(fw_init, 80)))
    PrintMessage("\n  +0x54 (VDDC):       0x")
    PrintHex(SMC_ReadSRAM(gpu, Add(fw_init, 84)))
    PrintMessage("\n  +0x5C (VDDCI):      0x")
    PrintHex(SMC_ReadSRAM(gpu, Add(fw_init, 92)))
    PrintMessage("\n  +0x60 (STD_VDDC):   0x")
    PrintHex(SMC_ReadSRAM(gpu, Add(fw_init, 96)))
    PrintMessage("\n  +0x64 (arb):        0x")
    PrintHex(SMC_ReadSRAM(gpu, Add(fw_init, 100)))
    PrintMessage("\n  +0x68 (SQ_THR):     0x")
    PrintHex(SMC_ReadSRAM(gpu, Add(fw_init, 104)))
    PrintMessage("\n  +0x70 (MAX_CU):     0x")
    PrintHex(SMC_ReadSRAM(gpu, Add(fw_init, 112)))
    PrintMessage("\n")

    // Read first level's SCLK/voltage fields
    lvl0_addr = Add(drv_addr, 4)  // skip 4-byte header
    PrintMessage("\nLevel 0 (at 0x")
    PrintHex(lvl0_addr)
    PrintMessage("):\n")

    PrintMessage("  AC_INDEX/WM/PCIE/flags: 0x")
    PrintHex(SMC_ReadSRAM(gpu, lvl0_addr))
    PrintMessage("\n  +0x04 (uvd/strobe/mc):  0x")
    PrintHex(SMC_ReadSRAM(gpu, Add(lvl0_addr, 4)))
    PrintMessage("\n  +0x08 (aT):             0x")
    PrintHex(SMC_ReadSRAM(gpu, Add(lvl0_addr, 8)))
    PrintMessage("\n  +0x0C (bSP):            0x")
    PrintHex(SMC_ReadSRAM(gpu, Add(lvl0_addr, 12)))
    PrintMessage("\n  +0x10 (SPLL_CNTL):      0x")
    PrintHex(SMC_ReadSRAM(gpu, Add(lvl0_addr, 16)))
    PrintMessage("\n  +0x14 (SPLL_CNTL_2):    0x")
    PrintHex(SMC_ReadSRAM(gpu, Add(lvl0_addr, 20)))
    PrintMessage("\n  +0x18 (SPLL_CNTL_3):    0x")
    PrintHex(SMC_ReadSRAM(gpu, Add(lvl0_addr, 24)))
    PrintMessage("\n  +0x1C (SPLL_CNTL_4):    0x")
    PrintHex(SMC_ReadSRAM(gpu, Add(lvl0_addr, 28)))
    PrintMessage("\n  +0x28 (SCLK_VALUE):     0x")
    PrintHex(SMC_ReadSRAM(gpu, Add(lvl0_addr, 40)))
    PrintMessage("\n  +0x2C (MPLL_CNTL):      0x")
    PrintHex(SMC_ReadSRAM(gpu, Add(lvl0_addr, 44)))
    PrintMessage("\n  +0x30 (MPLL_C1):        0x")
    PrintHex(SMC_ReadSRAM(gpu, Add(lvl0_addr, 48)))
    PrintMessage("\n  +0x34 (MPLL_C2):        0x")
    PrintHex(SMC_ReadSRAM(gpu, Add(lvl0_addr, 52)))
    PrintMessage("\n  +0x38 (MPLL_AD):        0x")
    PrintHex(SMC_ReadSRAM(gpu, Add(lvl0_addr, 56)))
    PrintMessage("\n  +0x3C (MPLL_DQ):        0x")
    PrintHex(SMC_ReadSRAM(gpu, Add(lvl0_addr, 60)))
    PrintMessage("\n  +0x40 (MCLK_PWR):       0x")
    PrintHex(SMC_ReadSRAM(gpu, Add(lvl0_addr, 64)))
    PrintMessage("\n  +0x44 (DLL_CNTL):       0x")
    PrintHex(SMC_ReadSRAM(gpu, Add(lvl0_addr, 68)))
    PrintMessage("\n  +0x50 (MCLK_VALUE):     0x")
    PrintHex(SMC_ReadSRAM(gpu, Add(lvl0_addr, 80)))
    PrintMessage("\n  +0x54 (VDDC):           0x")
    PrintHex(SMC_ReadSRAM(gpu, Add(lvl0_addr, 84)))
    PrintMessage("\n  +0x58 (MVDD):           0x")
    PrintHex(SMC_ReadSRAM(gpu, Add(lvl0_addr, 88)))
    PrintMessage("\n  +0x5C (VDDCI):          0x")
    PrintHex(SMC_ReadSRAM(gpu, Add(lvl0_addr, 92)))
    PrintMessage("\n  +0x60 (STD_VDDC):       0x")
    PrintHex(SMC_ReadSRAM(gpu, Add(lvl0_addr, 96)))
    PrintMessage("\n")

    // Read level 1 if it exists
    dpm = DPM_SI_GetEntry(gpu)
    num_levels = Dereference(Add(dpm, DPMField.NUM_LEVELS))
    PrintMessage("\nNum DPM levels: ")
    PrintNumber(num_levels)
    PrintMessage("\n")

    IfCondition GreaterThan(num_levels, 1) ThenBlock: {
        lvl1_addr = Add(lvl0_addr, 160)
        PrintMessage("\nLevel 1 (at 0x")
        PrintHex(lvl1_addr)
        PrintMessage("):\n")
        PrintMessage("  +0x10 (SPLL_CNTL):      0x")
        PrintHex(SMC_ReadSRAM(gpu, Add(lvl1_addr, 16)))
        PrintMessage("\n  +0x28 (SCLK_VALUE):     0x")
        PrintHex(SMC_ReadSRAM(gpu, Add(lvl1_addr, 40)))
        PrintMessage("\n  +0x54 (VDDC):           0x")
        PrintHex(SMC_ReadSRAM(gpu, Add(lvl1_addr, 84)))
        PrintMessage("\n")
    }

    // --- Program soft registers (timing, ticks_per_us, etc.) ---
    DPM_SI_ProgramSoftRegs(gpu)

    // --- Resume SMC ---
    PrintMessage("\n=== Resume SMC ===\n")
    GPU_Wr32(gpu, SMCReg.RESP_0, 0)
    SMC_SendMessage(gpu, SMCMsg.FLUSH_DATA_CACHE)
    GPU_Wr32(gpu, SMCReg.RESP_0, 0)
    resp = SMC_SendMessage(gpu, SMCMsg.RESUME)
    PrintMessage("Resume: 0x")
    PrintHex(resp)
    PrintMessage("\n")

    // Verify SMC still alive
    GPU_Wr32(gpu, SMCReg.RESP_0, 0)
    resp = SMC_SendMessage(gpu, SMCMsg.NO_DISPLAY)
    PrintMessage("NoDisplay after resume: 0x")
    PrintHex(resp)
    PrintMessage("\n\n")

    // --- Try SwitchToSwState ---
    PrintMessage("=== Trying SwitchToSwState (0x20) ===\n")
    GPU_Wr32(gpu, SMCReg.RESP_0, 0)
    resp = SMC_SendMessage(gpu, SMCMsg.SWITCH_TO_SWSTATE)
    PrintMessage("SwitchToSwState: 0x")
    PrintHex(resp)
    PrintMessage("\n")

    IfCondition NotEqual(resp, SMCResp.OK) ThenBlock: {
        PrintMessage("FAILED — SMC rejected state table\n")
        // Check if SMC is still alive
        GPU_Wr32(gpu, SMCReg.RESP_0, 0)
        resp2 = SMC_SendMessage(gpu, SMCMsg.NO_DISPLAY)
        PrintMessage("NoDisplay after failure: 0x")
        PrintHex(resp2)
        PrintMessage("\n")
    }
    ElseBlock: {
        PrintMessage("SUCCESS — SMC accepted state table\n")

        // Try level forcing
        PrintMessage("\n=== Level Forcing ===\n")
        // Enable SCLK control
        sclk_pwr = GPU_Rd32(gpu, DPMReg.SCLK_PWRMGT_CNTL)
        sclk_pwr = BitwiseAnd(sclk_pwr, BitwiseNot(SclkPwrBits.SCLK_PWRMGT_OFF))
        GPU_Wr32(gpu, DPMReg.SCLK_PWRMGT_CNTL, sclk_pwr)

        // Enable GLOBAL_PWRMGT_EN
        gen_pwrmgt = GPU_Rd32(gpu, DPMReg.GENERAL_PWRMGT)
        gen_pwrmgt = BitwiseOr(gen_pwrmgt, PwrMgtBits.GLOBAL_PWRMGT_EN)
        gen_pwrmgt = BitwiseOr(gen_pwrmgt, PwrMgtBits.VOLT_PWRMGT_EN)
        GPU_Wr32(gpu, DPMReg.GENERAL_PWRMGT, gen_pwrmgt)

        PrintMessage("Trying SetEnabledLevels(")
        PrintNumber(num_levels)
        PrintMessage(")...\n")
        resp = SMC_SendMessageArg(gpu, SMCMsg.SET_ENABLED_LEVELS, num_levels)
        PrintMessage("  Result: 0x")
        PrintHex(resp)
        PrintMessage("\n")

        PrintMessage("Trying SetForcedLevels(1)...\n")
        resp = SMC_SendMessageArg(gpu, SMCMsg.SET_FORCED_LEVELS, 1)
        PrintMessage("  Result: 0x")
        PrintHex(resp)
        PrintMessage("\n")

        // Check SPLL
        PrintMessage("SPLL_FUNC_CNTL_3: 0x")
        PrintHex(GPU_Rd32(gpu, SIReg.CG_SPLL_FUNC_CNTL_3))
        PrintMessage("\n")
    }

    // Cleanup
    PrintMessage("\n=== Cleanup ===\n")
    // Disable DPM registers
    gen_pwrmgt = GPU_Rd32(gpu, DPMReg.GENERAL_PWRMGT)
    gen_pwrmgt = BitwiseAnd(gen_pwrmgt, BitwiseNot(PwrMgtBits.GLOBAL_PWRMGT_EN))
    gen_pwrmgt = BitwiseAnd(gen_pwrmgt, BitwiseNot(PwrMgtBits.VOLT_PWRMGT_EN))
    GPU_Wr32(gpu, DPMReg.GENERAL_PWRMGT, gen_pwrmgt)
    sclk_pwr = GPU_Rd32(gpu, DPMReg.SCLK_PWRMGT_CNTL)
    sclk_pwr = BitwiseOr(sclk_pwr, SclkPwrBits.SCLK_PWRMGT_OFF)
    GPU_Wr32(gpu, DPMReg.SCLK_PWRMGT_CNTL, sclk_pwr)

    gi = 0
    WhileLoop LessThan(gi, count) {
        GPU_BAR_Unmap(gi)
        gi = Add(gi, 1)
    }

    PrintMessage("\n=== State Table Diagnostic Complete ===\n")
    SystemCall(60, 0, 0, 0, 0, 0)
}

RunTask(Main)
