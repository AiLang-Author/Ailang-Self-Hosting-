// test_voltage.ailang — Voltage Object Table parsing test
// Build: ./ailang.x TestCode/test_voltage.ailang test_voltage.x
// Run:   sg video -c "./test_voltage.x"
//
// Tests:
//   1. Discover GPUs, map BARs
//   2. Load and parse AtomBIOS ROM
//   3. Parse PowerPlay table
//   4. Parse Voltage Object Table
//   5. Print voltage info (GPIO LUT, leakage, phase shedding)
//   6. Test voltage index lookup
//   7. Test leakage index resolution

LibraryImport.Arena
LibraryImport.Drivers.AMDGPU.AMDGPUFamily
LibraryImport.Drivers.AMDGPU.AMDGPUDiscover
LibraryImport.Drivers.AMDGPU.AMDGPUBAR
LibraryImport.Drivers.AMDGPU.AMDGPUAtomBIOS
LibraryImport.Drivers.AMDGPU.AMDGPUPowerPlay
LibraryImport.Drivers.AMDGPU.AMDGPUVoltage

SubRoutine.Main {
    PrintMessage("=== Voltage Table Parse Test ===\n\n")

    // --- Discover GPUs ---
    count = GPU_Discover()
    IfCondition EqualTo(count, 0) ThenBlock: {
        PrintMessage("No AMD GPUs found.\n")
        SystemCall(60, 1, 0, 0, 0, 0)
    }
    GPU_PrintAll()
    PrintMessage("\n")

    // --- Map BARs ---
    GPU_BAR_Init()
    gi = 0
    WhileLoop LessThan(gi, count) {
        GPU_BAR_MapMMIO(gi)
        gi = Add(gi, 1)
    }

    // --- Process each GPU ---
    gi = 0
    WhileLoop LessThan(gi, count) {
        PrintMessage("========================================\n")
        PrintMessage("GPU ")
        PrintNumber(gi)
        PrintMessage(":\n")
        PrintMessage("========================================\n\n")

        // Load + parse ROM
        rom = AtomBIOS_LoadROM(gi)
        IfCondition EqualTo(rom, 0) ThenBlock: {
            PrintMessage("Failed to load ROM — skipping\n\n")
        }
        IfCondition NotEqual(rom, 0) ThenBlock: {
            rc = AtomBIOS_Parse(gi)
            IfCondition EqualTo(rc, 0) ThenBlock: {
                PrintMessage("Failed to parse AtomBIOS — skipping\n\n")
            }
            IfCondition NotEqual(rc, 0) ThenBlock: {
                // Parse PowerPlay (needed for context)
                PP_Parse(gi)

                // Parse Voltage
                PrintMessage("--- Parsing Voltage Objects ---\n")
                vrc = Volt_Parse(gi)
                IfCondition EqualTo(vrc, 0) ThenBlock: {
                    PrintMessage("Failed to parse voltage table\n\n")
                }
                IfCondition NotEqual(vrc, 0) ThenBlock: {
                    PrintMessage("\n")
                    Volt_PrintInfo(gi)
                    PrintMessage("\n")

                    // --- Test voltage index lookup ---
                    PrintMessage("--- Voltage Index Lookup Test ---\n")
                    boot_v = Volt_GetBootVDDC(gi)
                    PrintMessage("Boot VDDC:  ")
                    PrintNumber(boot_v)
                    PrintMessage(" mV\n")

                    vddc_count = Dereference(Add(Volt_GetEntry(gi), VoltField.VDDC_COUNT))
                    IfCondition GreaterThan(vddc_count, 0) ThenBlock: {
                        // Look up boot voltage
                        idx = Volt_GetVDDCIndex(gi, boot_v)
                        PrintMessage("Index for boot (")
                        PrintNumber(boot_v)
                        PrintMessage("mV): ")
                        PrintNumber(idx)
                        PrintMessage("\n")

                        // Look up 800mV
                        idx = Volt_GetVDDCIndex(gi, 800)
                        PrintMessage("Index for 800mV:  ")
                        PrintNumber(idx)
                        PrintMessage("\n")

                        // Look up 1000mV
                        idx = Volt_GetVDDCIndex(gi, 1000)
                        PrintMessage("Index for 1000mV: ")
                        PrintNumber(idx)
                        PrintMessage("\n")

                        // Look up max
                        max_v = Volt_GetMaxVDDC(gi)
                        idx = Volt_GetVDDCIndex(gi, max_v)
                        PrintMessage("Index for max (")
                        PrintNumber(max_v)
                        PrintMessage("mV): ")
                        PrintNumber(idx)
                        PrintMessage("\n")
                    }
                    PrintMessage("\n")

                    // --- Test leakage resolution ---
                    PrintMessage("--- Leakage Resolution Test ---\n")
                    // Test with a normal voltage (should return as-is)
                    resolved = Volt_ResolveLeakageVDDC(gi, 950)
                    PrintMessage("Resolve 950mV:   ")
                    PrintNumber(resolved)
                    PrintMessage(" mV")
                    IfCondition EqualTo(resolved, 950) ThenBlock: {
                        PrintMessage("  (pass-through)\n")
                    }
                    ElseBlock: {
                        PrintMessage("  (UNEXPECTED)\n")
                    }

                    // Test with leakage index 0xFF01 (65281)
                    resolved = Volt_ResolveLeakageVDDC(gi, 65281)
                    PrintMessage("Resolve 0xFF01:  ")
                    PrintNumber(resolved)
                    PrintMessage(" mV")
                    leak_count = Dereference(Add(Volt_GetEntry(gi), VoltField.LEAK_COUNT))
                    IfCondition GreaterThan(leak_count, 0) ThenBlock: {
                        PrintMessage("  (from leakage table)\n")
                    }
                    ElseBlock: {
                        PrintMessage("  (fallback to boot VDDC)\n")
                    }

                    // Test with leakage index 0xFF02 (65282)
                    resolved = Volt_ResolveLeakageVDDC(gi, 65282)
                    PrintMessage("Resolve 0xFF02:  ")
                    PrintNumber(resolved)
                    PrintMessage(" mV\n")

                    PrintMessage("\n")

                    // --- Cross-reference PP clock entries with resolved voltages ---
                    PrintMessage("--- PP Clock Entries with Resolved Voltages ---\n")
                    num_ci = PP_GetNumClockEntries(gi)
                    ci_buf = Allocate(PPClkEntry.SIZE)
                    k = 0
                    WhileLoop LessThan(k, num_ci) {
                        PP_GetClockEntry(gi, k, ci_buf)
                        sclk = Dereference(Add(ci_buf, PPClkEntry.SCLK))
                        raw_vddc = Dereference(Add(ci_buf, PPClkEntry.VDDC))
                        resolved_vddc = Volt_ResolveLeakageVDDC(gi, raw_vddc)

                        PrintMessage("  [")
                        PrintNumber(k)
                        PrintMessage("] SCLK=")
                        PrintNumber(Divide(sclk, 1000))
                        PrintMessage("MHz  raw_VDDC=")
                        PrintNumber(raw_vddc)
                        PrintMessage("  resolved=")
                        PrintNumber(resolved_vddc)
                        PrintMessage("mV")

                        // Show voltage index if GPIO mode
                        IfCondition GreaterThan(vddc_count, 0) ThenBlock: {
                            vidx = Volt_GetVDDCIndex(gi, resolved_vddc)
                            PrintMessage("  idx=")
                            PrintNumber(vidx)
                        }
                        PrintMessage("\n")
                        k = Add(k, 1)
                    }
                    Deallocate(ci_buf, PPClkEntry.SIZE)
                    PrintMessage("\n")

                    Volt_Free(gi)
                }
                PP_Free(gi)
            }
            AtomBIOS_FreeROM(gi)
        }
        gi = Add(gi, 1)
    }

    // Cleanup
    gi = 0
    WhileLoop LessThan(gi, count) {
        GPU_BAR_Unmap(gi)
        gi = Add(gi, 1)
    }

    PrintMessage("=== Voltage Test Complete ===\n")
    SystemCall(60, 0, 0, 0, 0, 0)
}

RunTask(Main)
