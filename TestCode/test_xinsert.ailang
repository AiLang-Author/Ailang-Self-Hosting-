LibraryImport.Arrays
LibraryImport.Arena

SubRoutine.Main {
    Arena_Init()
    
    arr = Array.Create(8)
    Array.Push(arr, 10)
    Array.Push(arr, 20)
    Array.Push(arr, 30)
    
    PrintMessage("Before insert: ")
    PrintNumber(Array.Get(arr, 0))
    PrintMessage(" ")
    PrintNumber(Array.Get(arr, 1))
    PrintMessage(" ")
    PrintNumber(Array.Get(arr, 2))
    PrintMessage("\n")
    
    Array.Insert(arr, 1, 99)
    
    PrintMessage("After insert 99 at index 1: ")
    sz = Array.Size(arr)
    i = 0
    WhileLoop LessThan(i, sz) {
        PrintNumber(Array.Get(arr, i))
        PrintMessage(" ")
        i = Add(i, 1)
    }
    PrintMessage("\n")
    PrintMessage("Size: ")
    PrintNumber(sz)
    PrintMessage("\n")
}
RunTask(Main)
