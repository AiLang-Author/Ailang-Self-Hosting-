LibraryImport.XArrays
LibraryImport.Arena

SubRoutine.Main {
    Arena_Init()
    
    arr = XArray.XCreate(8)
    XArray.XPush(arr, 10)
    XArray.XPush(arr, 20)
    XArray.XPush(arr, 30)
    
    PrintMessage("Before insert: ")
    PrintNumber(XArray.XGet(arr, 0))
    PrintMessage(" ")
    PrintNumber(XArray.XGet(arr, 1))
    PrintMessage(" ")
    PrintNumber(XArray.XGet(arr, 2))
    PrintMessage("\n")
    
    XArray.XInsert(arr, 1, 99)
    
    PrintMessage("After insert 99 at index 1: ")
    sz = XArray.XSize(arr)
    i = 0
    WhileLoop LessThan(i, sz) {
        PrintNumber(XArray.XGet(arr, i))
        PrintMessage(" ")
        i = Add(i, 1)
    }
    PrintMessage("\n")
    PrintMessage("Size: ")
    PrintNumber(sz)
    PrintMessage("\n")
}
RunTask(Main)
