// linked_list_demo.ailang
// Singly linked list using LinkagePool with PointerTo type tracking

LibraryImport.Arena

LinkagePool.Node {
    "value": Initialize=0
    "next": Initialize=0, PointerTo=LinkagePool.Node
}

LinkagePool.List {
    "head": Initialize=0, PointerTo=LinkagePool.Node
    "tail": Initialize=0, PointerTo=LinkagePool.Node
    "count": Initialize=0
}

Function.List_Create {
    Output: Address
    Body: {
        list = AllocateLinkage(LinkagePool.List)
        ReturnValue(list)
    }
}

Function.List_Append {
    Input: list: Address
    Input: value: Integer
    Body: {
        node = AllocateLinkage(LinkagePool.Node)
        node@value = value
        node@next = 0
        
        IfCondition EqualTo(list@head, 0) ThenBlock: {
            list@head = node
            list@tail = node
        } ElseBlock: {
            last = list@tail
            last@next = node
            list@tail = node
        }
        
        list@count = Add(list@count, 1)
        ReturnValue(node)
    }
}

Function.List_Prepend {
    Input: list: Address
    Input: value: Integer
    Body: {
        node = AllocateLinkage(LinkagePool.Node)
        node@value = value
        node@next = list@head
        
        list@head = node
        IfCondition EqualTo(list@tail, 0) ThenBlock: {
            list@tail = node
        }
        
        list@count = Add(list@count, 1)
        ReturnValue(node)
    }
}

Function.List_Print {
    Input: list: Address
    Body: {
        PrintMessage("[")
        current = list@head
        first = 1
        
        WhileLoop NotEqual(current, 0) {
            IfCondition EqualTo(first, 0) ThenBlock: {
                PrintMessage(", ")
            }
            PrintNumber(current@value)
            first = 0
            current = current@next
        }
        
        PrintMessage("] (")
        PrintNumber(list@count)
        PrintMessage(" items)\n")
        ReturnValue(0)
    }
}

Function.List_Sum {
    Input: list: Address
    Output: Integer
    Body: {
        total = 0
        current = list@head
        
        WhileLoop NotEqual(current, 0) {
            total = Add(total, current@value)
            current = current@next
        }
        
        ReturnValue(total)
    }
}

Function.List_Max {
    Input: list: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(list@head, 0) ThenBlock: {
            ReturnValue(0)
        }
        
        current = list@head
        max = current@value
        
        WhileLoop NotEqual(current, 0) {
            IfCondition GreaterThan(current@value, max) ThenBlock: {
                max = current@value
            }
            current = current@next
        }
        
        ReturnValue(max)
    }
}

Function.List_Reverse {
    Input: list: Address
    Body: {
        prev = 0
        current = list@head
        list@tail = list@head
        
        WhileLoop NotEqual(current, 0) {
            next = current@next
            current@next = prev
            prev = current
            current = next
        }
        
        list@head = prev
        ReturnValue(0)
    }
}

Function.List_Destroy {
    Input: list: Address
    Body: {
        current = list@head
        
        WhileLoop NotEqual(current, 0) {
            next = current@next
            FreeLinkage(current, LinkagePool.Node)
            current = next
        }
        
        FreeLinkage(list, LinkagePool.List)
        ReturnValue(0)
    }
}

SubRoutine.Main {
    Arena_Init()
    
    PrintMessage("=== Linked List Demo ===\n\n")
    
    PrintMessage("Creating list and appending 1-10...\n")
    mylist = List_Create()
    
    i = 1
    WhileLoop LessEqual(i, 10) {
        List_Append(mylist, i)
        i = Add(i, 1)
    }
    
    PrintMessage("List: ")
    List_Print(mylist)
    
    PrintMessage("\nPrepending 100, 200, 300...\n")
    List_Prepend(mylist, 100)
    List_Prepend(mylist, 200)
    List_Prepend(mylist, 300)
    
    PrintMessage("List: ")
    List_Print(mylist)
    
    PrintMessage("\nStats:\n")
    sum = List_Sum(mylist)
    PrintMessage("  Sum: ")
    PrintNumber(sum)
    PrintMessage("\n")
    
    max = List_Max(mylist)
    PrintMessage("  Max: ")
    PrintNumber(max)
    PrintMessage("\n")
    
    PrintMessage("\nReversing list...\n")
    List_Reverse(mylist)
    PrintMessage("List: ")
    List_Print(mylist)
    
    PrintMessage("\nReversing again...\n")
    List_Reverse(mylist)
    PrintMessage("List: ")
    List_Print(mylist)
    
    PrintMessage("\nDestroying list...\n")
    List_Destroy(mylist)
    PrintMessage("Done!\n")
    
    PrintMessage("\n=== Demo Complete ===\n")
    Exit(0)
}

RunTask(Main)