// wpt_batch.ailang — Batch harness for WPT DOM tests
// Like test262_harness_batch but initializes a minimal DOM + JSBridge
// so document.createElement, document.body, etc. are available.
//
// Build: ./ailang.x TestCode/wpt_batch.ailang wpt_batch.x
// Run:   (called by tools/wpt_dom_runner.py)
//
// Copyright (c) 2026 Sean Collins, 2 Paws Machine and Engineering. SCSL.

LibraryImport.Arena
LibraryImport.StringUtils
LibraryImport.Browser.HTMLTokenizer
LibraryImport.Browser.HTMLDom
LibraryImport.Browser.JSLexer
LibraryImport.Browser.JSValidate
LibraryImport.Browser.JSParser
LibraryImport.Browser.JSCompiler
LibraryImport.Browser.JSRuntime
LibraryImport.Browser.JSVM
LibraryImport.Browser.JSBridge
LibraryImport.Browser.JSEngine

FixedPool.WPTBatchSys {
    "SYS_READ":  Initialize=0
    "SYS_WRITE": Initialize=1
    "SYS_EXIT":  Initialize=60
    "SYS_DUP2":  Initialize=33
}

FixedPool.WPTBatchState {
    "src_buf":   Initialize=0
    "src_cap":   Initialize=0
    "len_buf":   Initialize=0
    "out_buf":   Initialize=0
    "dom_root":  Initialize=0
}

SubRoutine.Main {
    // Save original stdout to fd 4, redirect stdout to stderr
    SystemCall(WPTBatchSys.SYS_DUP2, 1, 4, 0, 0, 0)
    SystemCall(WPTBatchSys.SYS_DUP2, 2, 1, 0, 0, 0)

    Arena_Init()
    HTK_Init()
    DOM_Init()
    JSEngine_Init()
    JSVM_SetMaxSteps(9999999999)

    // Create a minimal DOM: <html><head></head><body><div id="log"></div></body></html>
    doc_html = "<html><head></head><body><div id=\"log\"></div></body></html>"
    WPTBatchState.dom_root = DOM_ParseString(doc_html, 59)
    JSEngine_SetDomRoot(WPTBatchState.dom_root)

    // Allocate source buffer (4 MB for WPT tests with harness prepended)
    WPTBatchState.src_cap = 4194304
    WPTBatchState.src_buf = Allocate(WPTBatchState.src_cap)
    WPTBatchState.len_buf = Allocate(8)
    WPTBatchState.out_buf = Allocate(4)

    IfCondition EqualTo(WPTBatchState.src_buf, 0) ThenBlock: {
        SystemCall(WPTBatchSys.SYS_EXIT, 99, 0, 0, 0, 0)
    }

    // Main loop: read [4-byte LE length][source]
    running = 1
    WhileLoop EqualTo(running, 1) {

        // Read 4-byte length prefix from stdin (fd=0)
        MemorySet(WPTBatchState.len_buf, 0, 4)
        bytes_read = SystemCall(WPTBatchSys.SYS_READ, 0, WPTBatchState.len_buf, 4)

        IfCondition LessEqual(bytes_read, 0) ThenBlock: {
            running = 0
        }

        IfCondition EqualTo(running, 1) ThenBlock: {
            b0 = GetByte(WPTBatchState.len_buf, 0)
            b1 = GetByte(WPTBatchState.len_buf, 1)
            b2 = GetByte(WPTBatchState.len_buf, 2)
            b3 = GetByte(WPTBatchState.len_buf, 3)
            src_len = Add(b0, Add(Multiply(b1, 256), Add(Multiply(b2, 65536), Multiply(b3, 16777216))))

            IfCondition EqualTo(src_len, 0) ThenBlock: {
                running = 0
            }
        }

        IfCondition EqualTo(running, 1) ThenBlock: {
            skipped = 0

            IfCondition GreaterThan(src_len, WPTBatchState.src_cap) ThenBlock: {
                SetByte(WPTBatchState.out_buf, 0, 50)
                SystemCall(WPTBatchSys.SYS_WRITE, 4, WPTBatchState.out_buf, 1)
                drain_left = src_len
                WhileLoop GreaterThan(drain_left, 0) {
                    drain_chunk = drain_left
                    IfCondition GreaterThan(drain_chunk, WPTBatchState.src_cap) ThenBlock: {
                        drain_chunk = WPTBatchState.src_cap
                    }
                    SystemCall(WPTBatchSys.SYS_READ, 0, WPTBatchState.src_buf, drain_chunk)
                    drain_left = Subtract(drain_left, drain_chunk)
                }
                skipped = 1
            }

            IfCondition EqualTo(skipped, 0) ThenBlock: {
                total_read = 0
                WhileLoop LessThan(total_read, src_len) {
                    remaining = Subtract(src_len, total_read)
                    n = SystemCall(WPTBatchSys.SYS_READ, 0, Add(WPTBatchState.src_buf, total_read), remaining)
                    IfCondition LessEqual(n, 0) ThenBlock: {
                        running = 0
                        total_read = src_len
                    }
                    IfCondition GreaterThan(n, 0) ThenBlock: {
                        total_read = Add(total_read, n)
                    }
                }

                IfCondition EqualTo(running, 1) ThenBlock: {
                    SetByte(WPTBatchState.src_buf, src_len, 0)

                    // Reset DOM to fresh state for each test
                    DOM_Init()
                    WPTBatchState.dom_root = DOM_ParseString(doc_html, 59)
                    JSEngine_SetDomRoot(WPTBatchState.dom_root)

                    // Run the test
                    JSEngine_EvalString(WPTBatchState.src_buf, src_len)
                    err = JSEngine_GetError()

                    IfCondition EqualTo(err, 0) ThenBlock: {
                        SetByte(WPTBatchState.out_buf, 0, 48)
                    } ElseBlock: {
                        SetByte(WPTBatchState.out_buf, 0, 49)
                    }
                    SystemCall(WPTBatchSys.SYS_WRITE, 4, WPTBatchState.out_buf, 1)

                    // Reset engine for next test
                    JSEngine_Reset()
                    JSVM_SetMaxSteps(9999999999)
                }
            }
        }
    }

    JSEngine_Shutdown()
    SystemCall(WPTBatchSys.SYS_EXIT, 0, 0, 0, 0, 0)
}

RunTask(Main)
