// TestConstraints.ailang
// Systematically tests every disputed compiler constraint.
// Each test is isolated. PASS = constraint is NOT real (compiler works correctly).
// FAIL = constraint IS real (workaround needed).

FixedPool.TC {
    "total":  Initialize=0
    "passed": Initialize=0
}

Function.Check {
    Input: expected: Integer
    Input: actual:   Integer
    Input: label:    Address
    Output: Integer
    Body: {
        TC.total = Add(TC.total, 1)
        IfCondition EqualTo(expected, actual) ThenBlock: {
            PrintMessage("PASS ")
            PrintMessage(label)
            PrintMessage("\n")
            TC.passed = Add(TC.passed, 1)
            ReturnValue(1)
        } ElseBlock: {
            PrintMessage("FAIL ")
            PrintMessage(label)
            PrintMessage(" exp=")
            PrintNumber(expected)
            PrintMessage(" got=")
            PrintNumber(actual)
            PrintMessage("\n")
            ReturnValue(0)
        }
    }
}

// =============================================================================
// TEST 1: And() / Or() nested in IfCondition
// Constraint claimed: "And()/Or() nested in IfCondition — split into sequential checks"
// =============================================================================
Function.Test_AndOr {
    Output: Integer
    Body: {
        a = 1
        b = 1
        c = 0

        // And() in IfCondition
        result = 0
        IfCondition And(EqualTo(a, 1), EqualTo(b, 1)) ThenBlock: {
            result = 1
        }
        Check(1, result, "And() both true")

        result = 0
        IfCondition And(EqualTo(a, 1), EqualTo(c, 1)) ThenBlock: {
            result = 1
        }
        Check(0, result, "And() one false")

        // Or() in IfCondition
        result = 0
        IfCondition Or(EqualTo(a, 1), EqualTo(c, 1)) ThenBlock: {
            result = 1
        }
        Check(1, result, "Or() one true")

        result = 0
        IfCondition Or(EqualTo(c, 1), EqualTo(c, 1)) ThenBlock: {
            result = 1
        }
        Check(0, result, "Or() both false")

        // Nested And inside Or
        result = 0
        IfCondition Or(And(EqualTo(a, 1), EqualTo(b, 1)), EqualTo(c, 1)) ThenBlock: {
            result = 1
        }
        Check(1, result, "Or(And()) nested")

        ReturnValue(1)
    }
}

// =============================================================================
// TEST 2: ReturnValue inside WhileLoop inside IfCondition
// Constraint claimed: "ReturnValue inside WhileLoop IfCondition — use result variable"
// =============================================================================
Function.Test_ReturnInLoop {
    Input: target: Integer
    Output: Integer
    Body: {
        i = 0
        WhileLoop LessThan(i, 10) {
            IfCondition EqualTo(i, target) ThenBlock: {
                ReturnValue(i)
            }
            i = Add(i, 1)
        }
        ReturnValue(-1)
    }
}

Function.Test_ReturnValue {
    Output: Integer
    Body: {
        r0 = Test_ReturnInLoop(0)
        Check(0, r0, "ReturnValue in loop at 0")

        r5 = Test_ReturnInLoop(5)
        Check(5, r5, "ReturnValue in loop at 5")

        r9 = Test_ReturnInLoop(9)
        Check(9, r9, "ReturnValue in loop at 9")

        // target not found — falls through to -1
        rm = Test_ReturnInLoop(99)
        Check(-1, rm, "ReturnValue fallthrough")

        ReturnValue(1)
    }
}

// =============================================================================
// TEST 3: BreakLoop inside nested IfCondition
// Constraint claimed: "BreakLoop in nested IfCondition — use flag variable"
// =============================================================================
Function.Test_BreakLoop {
    Output: Integer
    Body: {
        // Simple BreakLoop in IfCondition
        i = 0
        WhileLoop LessThan(i, 10) {
            IfCondition EqualTo(i, 5) ThenBlock: {
                BreakLoop
            }
            i = Add(i, 1)
        }
        Check(5, i, "BreakLoop in IfCondition stops at 5")

        // BreakLoop in nested IfCondition
        j = 0
        outer = 0
        WhileLoop LessThan(outer, 10) {
            IfCondition GreaterThan(outer, 2) ThenBlock: {
                IfCondition EqualTo(j, 0) ThenBlock: {
                    BreakLoop
                }
            }
            outer = Add(outer, 1)
        }
        Check(3, outer, "BreakLoop in nested IfCondition stops at 3")

        ReturnValue(1)
    }
}

// =============================================================================
// TEST 4: SubRoutine with local variables
// Constraint claimed: "SubRoutine crash with locals — use Function instead"
// =============================================================================
FixedPool.SubTest {
    "result": Initialize=0
}

SubRoutine.Test_SubLocals {
    a = 10
    b = 20
    c = Add(a, b)
    d = Multiply(c, 2)
    SubTest.result = d
}

Function.Test_SubRoutineLocals {
    Output: Integer
    Body: {
        SubTest.result = 0
        RunTask(Test_SubLocals)
        Check(60, SubTest.result, "SubRoutine locals: (10+20)*2=60")
        ReturnValue(1)
    }
}

// =============================================================================
// TEST 5: WhileLoop EqualTo(1,1) with BreakLoop
// Constraint claimed: "WhileLoop EqualTo(1,1) + BreakLoop — use bounded counter"
// =============================================================================
Function.Test_InfiniteLoop {
    Output: Integer
    Body: {
        count = 0
        WhileLoop EqualTo(1, 1) {
            count = Add(count, 1)
            IfCondition EqualTo(count, 5) ThenBlock: {
                BreakLoop
            }
        }
        Check(5, count, "WhileLoop(1,1) + BreakLoop exits at 5")
        ReturnValue(1)
    }
}

// =============================================================================
// TEST 6: ReturnValue early exit (not in loop)
// Constraint claimed: "ReturnValue in Function does NOT early-exit"
// (this was in old docs, should definitely work)
// =============================================================================
Function.Test_EarlyReturn {
    Input: x: Integer
    Output: Integer
    Body: {
        IfCondition EqualTo(x, 0) ThenBlock: {
            ReturnValue(100)
        }
        IfCondition EqualTo(x, 1) ThenBlock: {
            ReturnValue(200)
        }
        ReturnValue(300)
    }
}

Function.Test_ReturnEarly {
    Output: Integer
    Body: {
        Check(100, Test_EarlyReturn(0), "early return x=0")
        Check(200, Test_EarlyReturn(1), "early return x=1")
        Check(300, Test_EarlyReturn(2), "early return x=2 fallthrough")
        ReturnValue(1)
    }
}

// =============================================================================
// MAIN
// =============================================================================
SubRoutine.Main {
    PrintMessage("=== Constraint Tests ===\n")

    PrintMessage("-- And/Or in IfCondition --\n")
    Test_AndOr()

    PrintMessage("-- ReturnValue in WhileLoop --\n")
    Test_ReturnValue()

    PrintMessage("-- BreakLoop in nested IfCondition --\n")
    Test_BreakLoop()

    PrintMessage("-- SubRoutine with locals --\n")
    Test_SubRoutineLocals()

    PrintMessage("-- WhileLoop(1,1) + BreakLoop --\n")
    Test_InfiniteLoop()

    PrintMessage("-- Early ReturnValue --\n")
    Test_ReturnEarly()

    PrintMessage("=== Summary ===\n")
    PrintMessage("Passed: ")
    PrintNumber(TC.passed)
    PrintMessage(" / ")
    PrintNumber(TC.total)
    PrintMessage("\n")
    IfCondition EqualTo(TC.passed, TC.total) ThenBlock: {
        PrintMessage("ALL PASS — constraints are folklore, remove from table\n")
    } ElseBlock: {
        PrintMessage("FAILURES — real compiler bugs, add to fix list\n")
    }
}

RunTask(Main)