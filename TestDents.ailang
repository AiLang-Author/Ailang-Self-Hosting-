// TestDents.ailang
// Raw getdents64 test with byte-level name printing

LibraryImport.Arena

SubRoutine.Main {
    PrintMessage("[Dents] opening /dev/input/by-id\n")

    fd = SystemCall(2, "/dev/input/by-id", 0, 0)
    PrintMessage("[Dents] fd=")
    PrintNumber(fd)
    PrintMessage("\n")

    IfCondition LessThan(fd, 0) ThenBlock: {
        PrintMessage("[Dents] FAIL: open\n")
        ReturnValue(0)
    }

    buf = Allocate(4096)
    nbytes = SystemCall(78, fd, buf, 4096)
    PrintMessage("[Dents] getdents64 returned ")
    PrintNumber(nbytes)
    PrintMessage("\n")

    IfCondition LessEqual(nbytes, 0) ThenBlock: {
        PrintMessage("[Dents] no entries\n")
        Deallocate(buf, 4096)
        SystemCall(3, fd, 0, 0)
        ReturnValue(0)
    }

    pos = 0
    count = 0
    WhileLoop LessThan(pos, nbytes) {
        reclen_lo = GetByte(buf, Add(pos, 16))
        reclen_hi = GetByte(buf, Add(pos, 17))
        reclen    = Add(reclen_lo, Multiply(reclen_hi, 256))

        IfCondition EqualTo(reclen, 0) ThenBlock: {
            PrintMessage("[Dents] reclen=0 stopping\n")
            pos = nbytes
            ContinueLoop
        }

        // Print raw bytes at offsets 16-23 to understand struct layout
        PrintMessage("[Dents] entry ")
        PrintNumber(count)
        PrintMessage(" reclen=")
        PrintNumber(reclen)
        PrintMessage(" bytes[16..23]: ")
        bi = 16
        WhileLoop LessThan(bi, 24) {
            PrintNumber(GetByte(buf, Add(pos, bi)))
            PrintMessage(" ")
            bi = Add(bi, 1)
        }
        PrintMessage("\n")

        // Name starts at offset 18 (verified from byte dump)
        PrintMessage("[Dents] name@18: ")
        ci = 18
        WhileLoop LessThan(ci, Add(18, 48)) {
            cb = GetByte(buf, Add(pos, ci))
            IfCondition EqualTo(cb, 0) ThenBlock: {
                ci = Add(18, 48)
            } ElseBlock: {
                PrintChar(cb)
                ci = Add(ci, 1)
            }
        }
        PrintMessage("\n")

        count = Add(count, 1)
        pos   = Add(pos, reclen)
    }

    PrintMessage("[Dents] total=")
    PrintNumber(count)
    PrintMessage("\n")

    Deallocate(buf, 4096)
    SystemCall(3, fd, 0, 0)
}

RunTask(Main)