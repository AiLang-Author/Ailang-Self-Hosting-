// TestDisplay01.ailang
// First display system smoke test
// Verifies: surface create, cell addressing, pitch math, terminal flush

LibraryImport.TUI
LibraryImport.DSurfaceTypes
LibraryImport.DSurface
LibraryImport.DRenderTerm

// =============================================================================
// Write a string into a CELL_32 surface at (x, y)
// =============================================================================
Function.WriteStr {
    Input: surf: Integer
    Input: x:    Integer
    Input: y:    Integer
    Input: str:  Address
    Input: fg:   Integer
    Input: bg:   Integer
    Body: {
        w = Surface_GetWidth(surf)
        i = 0
        WhileLoop 1 {
            ch = GetByte(str, i)
            IfCondition EqualTo(ch, 0) ThenBlock: { BreakLoop }
            cx = Add(x, i)
            IfCondition Not(LessThan(cx, w)) ThenBlock: { BreakLoop }
            IfCondition EqualTo(Surface_InBounds(surf, cx, y), 1) ThenBlock: {
                cell = Surface_CellAt(surf, cx, y)
                SetByte(cell, CellOffset.CHAR, ch)
                SetByte(cell, CellOffset.FG,   fg)
                SetByte(cell, CellOffset.BG,   bg)
                SetByte(cell, CellOffset.ATTR,  0)
            }
            i = Add(i, 1)
        }
    }
}

// =============================================================================
// Fill a rect of cells
// =============================================================================
Function.FillRect {
    Input: surf: Integer
    Input: x:    Integer
    Input: y:    Integer
    Input: w:    Integer
    Input: h:    Integer
    Input: ch:   Integer
    Input: fg:   Integer
    Input: bg:   Integer
    Body: {
        row = y
        WhileLoop LessThan(row, Add(y, h)) {
            col = x
            WhileLoop LessThan(col, Add(x, w)) {
                IfCondition EqualTo(Surface_InBounds(surf, col, row), 1) ThenBlock: {
                    cell = Surface_CellAt(surf, col, row)
                    SetByte(cell, CellOffset.CHAR, ch)
                    SetByte(cell, CellOffset.FG,   fg)
                    SetByte(cell, CellOffset.BG,   bg)
                    SetByte(cell, CellOffset.ATTR,  0)
                }
                col = Add(col, 1)
            }
            row = Add(row, 1)
        }
    }
}

// =============================================================================
// Draw a border using ASCII + - | chars
// =============================================================================
Function.DrawBorder {
    Input: surf: Integer
    Input: x:    Integer
    Input: y:    Integer
    Input: w:    Integer
    Input: h:    Integer
    Input: fg:   Integer
    Input: bg:   Integer
    Body: {
        tr_x = Subtract(Add(x, w), 1)
        bl_y = Subtract(Add(y, h), 1)

        IfCondition EqualTo(Surface_InBounds(surf, x, y), 1) ThenBlock: {
            cell = Surface_CellAt(surf, x, y)
            SetByte(cell, CellOffset.CHAR, 43)
            SetByte(cell, CellOffset.FG, fg)
            SetByte(cell, CellOffset.BG, bg)
            SetByte(cell, CellOffset.ATTR, 0)
        }
        IfCondition EqualTo(Surface_InBounds(surf, tr_x, y), 1) ThenBlock: {
            cell = Surface_CellAt(surf, tr_x, y)
            SetByte(cell, CellOffset.CHAR, 43)
            SetByte(cell, CellOffset.FG, fg)
            SetByte(cell, CellOffset.BG, bg)
            SetByte(cell, CellOffset.ATTR, 0)
        }
        IfCondition EqualTo(Surface_InBounds(surf, x, bl_y), 1) ThenBlock: {
            cell = Surface_CellAt(surf, x, bl_y)
            SetByte(cell, CellOffset.CHAR, 43)
            SetByte(cell, CellOffset.FG, fg)
            SetByte(cell, CellOffset.BG, bg)
            SetByte(cell, CellOffset.ATTR, 0)
        }
        IfCondition EqualTo(Surface_InBounds(surf, tr_x, bl_y), 1) ThenBlock: {
            cell = Surface_CellAt(surf, tr_x, bl_y)
            SetByte(cell, CellOffset.CHAR, 43)
            SetByte(cell, CellOffset.FG, fg)
            SetByte(cell, CellOffset.BG, bg)
            SetByte(cell, CellOffset.ATTR, 0)
        }

        col = Add(x, 1)
        WhileLoop LessThan(col, tr_x) {
            IfCondition EqualTo(Surface_InBounds(surf, col, y), 1) ThenBlock: {
                cell = Surface_CellAt(surf, col, y)
                SetByte(cell, CellOffset.CHAR, 45)
                SetByte(cell, CellOffset.FG, fg)
                SetByte(cell, CellOffset.BG, bg)
                SetByte(cell, CellOffset.ATTR, 0)
            }
            IfCondition EqualTo(Surface_InBounds(surf, col, bl_y), 1) ThenBlock: {
                cell = Surface_CellAt(surf, col, bl_y)
                SetByte(cell, CellOffset.CHAR, 45)
                SetByte(cell, CellOffset.FG, fg)
                SetByte(cell, CellOffset.BG, bg)
                SetByte(cell, CellOffset.ATTR, 0)
            }
            col = Add(col, 1)
        }

        row = Add(y, 1)
        WhileLoop LessThan(row, bl_y) {
            IfCondition EqualTo(Surface_InBounds(surf, x, row), 1) ThenBlock: {
                cell = Surface_CellAt(surf, x, row)
                SetByte(cell, CellOffset.CHAR, 124)
                SetByte(cell, CellOffset.FG, fg)
                SetByte(cell, CellOffset.BG, bg)
                SetByte(cell, CellOffset.ATTR, 0)
            }
            IfCondition EqualTo(Surface_InBounds(surf, tr_x, row), 1) ThenBlock: {
                cell = Surface_CellAt(surf, tr_x, row)
                SetByte(cell, CellOffset.CHAR, 124)
                SetByte(cell, CellOffset.FG, fg)
                SetByte(cell, CellOffset.BG, bg)
                SetByte(cell, CellOffset.ATTR, 0)
            }
            row = Add(row, 1)
        }
    }
}

// =============================================================================
// MAIN
// =============================================================================
SubRoutine.Main {
    RenderTerm_Init()

    surf = Surface_Create(SurfaceFormat.CELL_32, 60, 20)

    IfCondition EqualTo(surf, 0) ThenBlock: {
        PrintMessage("ERROR: Surface_Create failed\n")
        RenderTerm_Shutdown()
        ReturnValue(0)
    }

    FillRect(surf, 0, 0, 60, 20, 32, Color16.WHITE, Color16.BLUE)
    FillRect(surf, 0, 0, 60, 1,  32, Color16.BRIGHT_WHITE, Color16.BLACK)
    WriteStr(surf, 2, 0, "AILANG Display System - Test 01", Color16.BRIGHT_WHITE, Color16.BLACK)
    DrawBorder(surf, 1, 2, 56, 16, Color16.BRIGHT_WHITE, Color16.BLUE)

    WriteStr(surf, 4, 4,  "Surface is working.",        Color16.BRIGHT_GREEN, Color16.BLUE)
    WriteStr(surf, 4, 6,  "Format : CELL_32",           Color16.BRIGHT_CYAN,  Color16.BLUE)
    WriteStr(surf, 4, 7,  "Width  : 60",                Color16.BRIGHT_CYAN,  Color16.BLUE)
    WriteStr(surf, 4, 8,  "Height : 20",                Color16.BRIGHT_CYAN,  Color16.BLUE)
    WriteStr(surf, 4, 10, "Cell addressing : OK",       Color16.WHITE,        Color16.BLUE)
    WriteStr(surf, 4, 11, "Pitch math      : OK",       Color16.WHITE,        Color16.BLUE)
    WriteStr(surf, 4, 12, "Bounds checking : OK",       Color16.WHITE,        Color16.BLUE)
    WriteStr(surf, 4, 15, "Press any key to exit.",     Color16.YELLOW,       Color16.BLUE)

    RenderTerm_Flush(surf)
    TUI_GetKey()
    Surface_Destroy(surf)
    RenderTerm_Shutdown()
}

RunTask(Main)