// TestEvdevRaw.ailang — inline poll logic, no SubRoutine calls
// Proves whether the poll loop itself works before wrapping in SubRoutine

LibraryImport.Arena
LibraryImport.DInputTypes
LibraryImport.DRingTypes
LibraryImport.DRing
LibraryImport.DRing1

SubRoutine.Main {
    PrintMessage("[EvdevRaw] start\n")

    // Open keyboard directly
    kbd_fd = SystemCall(2, "/dev/input/event0", 2048, 0)
    PrintMessage("[EvdevRaw] kbd_fd=")
    PrintNumber(kbd_fd)
    PrintMessage("\n")

    mouse_fd = SystemCall(2, "/dev/input/event5", 2048, 0)
    PrintMessage("[EvdevRaw] mouse_fd=")
    PrintNumber(mouse_fd)
    PrintMessage("\n")

    // Init Ring1 so we can post to it
    Ring1_Init()
    PrintMessage("[EvdevRaw] ring1 init done\n")

    // Allocate event buffer using the constant
    PrintMessage("[EvdevRaw] EvdevEvent.SIZE=")
    PrintNumber(EvdevEvent.SIZE)
    PrintMessage("\n")
    buf = Allocate(EvdevEvent.SIZE)
    PrintMessage("[EvdevRaw] buf=")
    PrintNumber(buf)
    PrintMessage("\n")

    // Poll keyboard fd inline — one read attempt
    PrintMessage("[EvdevRaw] reading kbd...\n")
    n = SystemCall(0, kbd_fd, buf, EvdevEvent.SIZE)
    PrintMessage("[EvdevRaw] kbd read n=")
    PrintNumber(n)
    PrintMessage("\n")

    // Poll mouse fd inline — one read attempt
    PrintMessage("[EvdevRaw] reading mouse...\n")
    n2 = SystemCall(0, mouse_fd, buf, EvdevEvent.SIZE)
    PrintMessage("[EvdevRaw] mouse read n=")
    PrintNumber(n2)
    PrintMessage("\n")

    // Now try a simple loop over both fds
    PrintMessage("[EvdevRaw] loop test...\n")
    loop_i = 0
    WhileLoop LessThan(loop_i, 2) {
        PrintMessage("[EvdevRaw] loop_i=")
        PrintNumber(loop_i)
        PrintMessage("\n")
        IfCondition EqualTo(loop_i, 0) ThenBlock: {
            cur_fd = kbd_fd
        } ElseBlock: {
            cur_fd = mouse_fd
        }
        PrintMessage("[EvdevRaw] reading fd=")
        PrintNumber(cur_fd)
        PrintMessage("\n")
        nr = SystemCall(0, cur_fd, buf, EvdevEvent.SIZE)
        PrintMessage("[EvdevRaw] read=")
        PrintNumber(nr)
        PrintMessage("\n")
        loop_i = Add(loop_i, 1)
    }
    PrintMessage("[EvdevRaw] loop done\n")

    Deallocate(buf, EvdevEvent.SIZE)
    SystemCall(3, kbd_fd, 0, 0)
    SystemCall(3, mouse_fd, 0, 0)
    PrintMessage("[EvdevRaw] PASS\n")
}

RunTask(Main)