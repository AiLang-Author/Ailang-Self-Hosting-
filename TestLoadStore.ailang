// TestLoadStore.ailang
// Proof test: train model, save weights, load into fresh buffers,
// verify inference produces same results.
// Copyright © 2025 Sean Collins, 2 Paws Machine and Engineering. All rights reserved. SCSL.

LibraryImport.Arena
LibraryImport.TF.Math
LibraryImport.TF.Vec
LibraryImport.TF.Mat
LibraryImport.TF.Act
LibraryImport.TF.Carriers
LibraryImport.TF.Layer
LibraryImport.TF.Train
LibraryImport.TF.Float
LibraryImport.TF.LoadStore

// Reuse all the FixedPools and SubRoutines from ATTN.ailang
// (In practice, compile this with the same includes as ATTN.ailang)

// For this test we need the carriers defined
FixedPool.TFProjCarrier {
    "Wk":    Initialize=0
    "Wv":    Initialize=0
    "seqln": Initialize=0
    "dmod":  Initialize=0
    "dff":   Initialize=0
}

FixedPool.TFOutProjCarrier {
    "seqln": Initialize=0
    "dmod":  Initialize=0
    "vocab": Initialize=0
}

FixedPool.TFBackOut {
    "Wout":    Initialize=0
    "targets": Initialize=0
    "seqln":   Initialize=0
    "dmod":    Initialize=0
    "vocab":   Initialize=0
}

FixedPool.TFBackCtx {
    "attn":     Initialize=0
    "vvec":     Initialize=0
