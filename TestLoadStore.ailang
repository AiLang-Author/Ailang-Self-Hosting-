}

FixedPool.TFW {
    "W1":     Initialize=0
    "W2":     Initialize=0
    "Embed":  Initialize=0
    "PosEmb": Initialize=0
    "Wq":     Initialize=0
    "Wk":     Initialize=0
    "Wv":     Initialize=0
    "Wout":   Initialize=0
    "emb":    Initialize=0
    "qvec":   Initialize=0
    "kvec":   Initialize=0
    "vvec":   Initialize=0
    "scores": Initialize=0
    "attn":   Initialize=0
    "ctx":    Initialize=0
    "resid":  Initialize=0
