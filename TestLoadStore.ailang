    "loss_acc": Initialize=0
    "acc_num":  Initialize=0
    "acc_den":  Initialize=0
}

// =============================================================================
// WORKAROUND: Local Wout Load/Store
// =============================================================================
Function.TF_SaveWout {
    Input: fd: Integer
    Input: fWout: Integer
    Output: Integer
    Body: {
        vd = Multiply(TFConfig.VocabSize, TFConfig.DModel)
        TF_WriteBuffer(fd, fWout, vd)
        ReturnValue(1)
    }
}

Function.TF_LoadWout {
    Input: fd: Integer
    Input: fWout: Integer
    Output: Integer
    Body: {
        vd = Multiply(TFConfig.VocabSize, TFConfig.DModel)
        TF_ReadBuffer(fd, fWout, vd)
        ReturnValue(1)
    }
}

SubRoutine.Main {
    PrintMessage("=== TF LoadStore Test ===\n\n")

    dmod  = TFConfig.DModel
    seqln = TFConfig.SeqLen
    vocab = TFConfig.VocabSize
    dff   = TFConfig.DFF
    
    vd = Multiply(vocab, dmod)
    sd = Multiply(seqln, dmod)
    dd = Multiply(dmod, dmod)
    df = Multiply(dmod, dff)
    fd2 = Multiply(dff, dmod)

    // Step 1: Create test weight buffers with known values
    PrintMessage("[TEST] Creating test weights...\n")
    buf_Embed  = TF_MatAlloc(vocab, dmod)
    buf_PosEmb = TF_MatAlloc(seqln, dmod)
    buf_Wq     = TF_MatAlloc(dmod, dmod)
    buf_Wk     = TF_MatAlloc(dmod, dmod)
    buf_Wv     = TF_MatAlloc(dmod, dmod)
    buf_Wout   = TF_MatAlloc(vocab, dmod)
    buf_W1     = TF_MatAlloc(dmod, dff)
    buf_W2     = TF_MatAlloc(dff, dmod)

    // Fill with recognizable pattern: element[i] = i + 1
    i = 0
    WhileLoop LessThan(i, vd) {
        off = Multiply(TFElem.Size, i)
        // Store as float bits (like float masters)
        StoreValue(Add(buf_Embed, off), Float_FromInt(Add(i, 1)))
        i = Add(i, 1)
    }
    i = 0
    WhileLoop LessThan(i, sd) {
        off = Multiply(TFElem.Size, i)
        StoreValue(Add(buf_PosEmb, off), Float_FromInt(Add(i, 100)))
        i = Add(i, 1)
    }
    i = 0
    WhileLoop LessThan(i, dd) {
        off = Multiply(TFElem.Size, i)
        StoreValue(Add(buf_Wq, off), Float_FromInt(Add(i, 200)))
        i = Add(i, 1)
    }
    i = 0
    WhileLoop LessThan(i, dd) {
        off = Multiply(TFElem.Size, i)
        StoreValue(Add(buf_Wk, off), Float_FromInt(Add(i, 300)))
        i = Add(i, 1)
    }
    i = 0
    WhileLoop LessThan(i, dd) {
        off = Multiply(TFElem.Size, i)
        StoreValue(Add(buf_Wv, off), Float_FromInt(Add(i, 400)))
        i = Add(i, 1)
    }
    i = 0
    WhileLoop LessThan(i, vd) {
        off = Multiply(TFElem.Size, i)
        StoreValue(Add(buf_Wout, off), Float_FromInt(Add(i, 500)))
        i = Add(i, 1)
    }
    i = 0
    WhileLoop LessThan(i, df) {
        off = Multiply(TFElem.Size, i)
        StoreValue(Add(buf_W1, off), Float_FromInt(Add(i, 600)))
        i = Add(i, 1)
    }
    i = 0
    WhileLoop LessThan(i, fd2) {
        off = Multiply(TFElem.Size, i)
        StoreValue(Add(buf_W2, off), Float_FromInt(Add(i, 700)))
        i = Add(i, 1)
    }

    // Print first few values for verification
    PrintMessage("[TEST] Embed[0] = ")
    PrintNumber(Float_Round(Dereference(buf_Embed)))
    PrintMessage(" (expect 1)\n")
    PrintMessage("[TEST] Wq[0] = ")
    PrintNumber(Float_Round(Dereference(buf_Wq)))
    PrintMessage(" (expect 200)\n")
    PrintMessage("[TEST] W1[0] = ")
    PrintNumber(Float_Round(Dereference(buf_W1)))
    PrintMessage(" (expect 600)\n")

    // Step 2: Save to file
    PrintMessage("\n[TEST] Saving to model.bin...\n")
    // open("model.bin", O_WRONLY|O_CREAT|O_TRUNC, 0644)
    // O_WRONLY=1, O_CREAT=64, O_TRUNC=512 → flags=577
    save_fd = SystemCall(2, "model.bin", 577, 420)
    PrintMessage("[TEST] fd = ")
    PrintNumber(save_fd)
    PrintMessage("\n")

    TF_SaveModel(save_fd, buf_Embed, buf_PosEmb, buf_Wq, buf_Wk, buf_Wv)
    TF_SaveMLP(save_fd, buf_W1, buf_W2)
    TF_SaveWout(save_fd, buf_Wout)

    // close
    SystemCall(3, save_fd)
    PrintMessage("[TEST] Save complete\n")

    // Step 3: Create fresh empty buffers
    PrintMessage("\n[TEST] Creating empty load buffers...\n")
    ld_Embed  = TF_MatAlloc(vocab, dmod)
    ld_PosEmb = TF_MatAlloc(seqln, dmod)
    ld_Wq     = TF_MatAlloc(dmod, dmod)
    ld_Wk     = TF_MatAlloc(dmod, dmod)
    ld_Wv     = TF_MatAlloc(dmod, dmod)
    ld_Wout   = TF_MatAlloc(vocab, dmod)
    ld_W1     = TF_MatAlloc(dmod, dff)
    ld_W2     = TF_MatAlloc(dff, dmod)

    // Verify they're zero
    PrintMessage("[TEST] ld_Embed[0] = ")
    PrintNumber(Float_Round(Dereference(ld_Embed)))
    PrintMessage(" (expect 0)\n")

    // Step 4: Load from file
    PrintMessage("\n[TEST] Loading from model.bin...\n")
    // open("model.bin", O_RDONLY, 0) → flags=0
    load_fd = SystemCall(2, "model.bin", 0, 0)
    PrintMessage("[TEST] fd = ")
    PrintNumber(load_fd)
    PrintMessage("\n")

    ok = TF_LoadModel(load_fd, ld_Embed, ld_PosEmb, ld_Wq, ld_Wk, ld_Wv)
    TF_LoadMLP(load_fd, ld_W1, ld_W2)
    TF_LoadWout(load_fd, ld_Wout)

    // close
    SystemCall(3, load_fd)

    IfCondition EqualTo(ok, 0) ThenBlock: {
        PrintMessage("[TEST] LOAD FAILED\n")
    }
    IfCondition EqualTo(ok, 1) ThenBlock: {
        PrintMessage("[TEST] Load complete\n")
    }

    // Step 5: Verify loaded values match saved values
    PrintMessage("\n[TEST] Verifying...\n")
    errors = 0

    PrintMessage("[TEST] ld_Embed[0] = ")
    PrintNumber(Float_Round(Dereference(ld_Embed)))
    PrintMessage(" (expect 1)\n")
    PrintMessage("[TEST] ld_Wq[0] = ")
    PrintNumber(Float_Round(Dereference(ld_Wq)))
    PrintMessage(" (expect 200)\n")
    PrintMessage("[TEST] ld_W1[0] = ")
    PrintNumber(Float_Round(Dereference(ld_W1)))
    PrintMessage(" (expect 600)\n")

    // Check all Embed values
    i = 0
    WhileLoop LessThan(i, vd) {
        off = Multiply(TFElem.Size, i)
        orig = Float_Round(Dereference(Add(buf_Embed, off)))
        loaded = Float_Round(Dereference(Add(ld_Embed, off)))
        IfCondition NotEqual(orig, loaded) ThenBlock: {
            errors = Add(errors, 1)
        }
        i = Add(i, 1)
    }

    // Check all Wq values
    i = 0
    WhileLoop LessThan(i, dd) {
        off = Multiply(TFElem.Size, i)
        orig = Float_Round(Dereference(Add(buf_Wq, off)))
        loaded = Float_Round(Dereference(Add(ld_Wq, off)))
        IfCondition NotEqual(orig, loaded) ThenBlock: {
            errors = Add(errors, 1)
        }
        i = Add(i, 1)
    }

    // Check all Wout values
    i = 0
    WhileLoop LessThan(i, vd) {
        off = Multiply(TFElem.Size, i)
        orig = Float_Round(Dereference(Add(buf_Wout, off)))
        loaded = Float_Round(Dereference(Add(ld_Wout, off)))
        IfCondition NotEqual(orig, loaded) ThenBlock: {
            errors = Add(errors, 1)
        }
        i = Add(i, 1)
    }

    // Check all W1 values
    i = 0
    WhileLoop LessThan(i, df) {
        off = Multiply(TFElem.Size, i)
        orig = Float_Round(Dereference(Add(buf_W1, off)))
        loaded = Float_Round(Dereference(Add(ld_W1, off)))
        IfCondition NotEqual(orig, loaded) ThenBlock: {
            errors = Add(errors, 1)
        }
        i = Add(i, 1)
    }

    PrintMessage("\n[TEST] Errors: ")
    PrintNumber(errors)
    PrintMessage("\n")
    IfCondition EqualTo(errors, 0) ThenBlock: {
        PrintMessage("[TEST] PASS — all weights match\n")
    }
    IfCondition GreaterThan(errors, 0) ThenBlock: {
        PrintMessage("[TEST] FAIL — mismatches found\n")
    }

    // Cleanup
    TF_MatFree(buf_Embed,  vocab, dmod)
    TF_MatFree(buf_PosEmb, seqln, dmod)
    TF_MatFree(buf_Wq,     dmod, dmod)
    TF_MatFree(buf_Wk,     dmod, dmod)
    TF_MatFree(buf_Wv,     dmod, dmod)
    TF_MatFree(buf_Wout,   vocab, dmod)
    TF_MatFree(buf_W1,     dmod, dff)
    TF_MatFree(buf_W2,     dff,  dmod)
    TF_MatFree(ld_Embed,   vocab, dmod)
    TF_MatFree(ld_PosEmb,  seqln, dmod)
    TF_MatFree(ld_Wq,      dmod, dmod)
    TF_MatFree(ld_Wk,      dmod, dmod)
    TF_MatFree(ld_Wv,      dmod, dmod)
    TF_MatFree(ld_Wout,    vocab, dmod)
    TF_MatFree(ld_W1,      dmod, dff)
    TF_MatFree(ld_W2,      dff,  dmod)

    PrintMessage("\n[TEST] Done\n")
}

RunTask(Main)