// TestWindowBSP.ailang
// Phase 7b+ — BSP tiling window server
// Becoming: SysDisplay
//
// Hotkeys:
//   Alt+V  — split vertical
//   Alt+H  — split horizontal
//   Alt+M  — merge
//   ESC    — quit
//   All other keys → focused pane text buffer

LibraryImport.Framebuffer
LibraryImport.DRenderFB
LibraryImport.Arena
LibraryImport.DSurfaceTypes
LibraryImport.DSurface
LibraryImport.DDrawPixel
LibraryImport.DRingTypes
LibraryImport.DRing
LibraryImport.DRing0
LibraryImport.DRing1
LibraryImport.DRing2
LibraryImport.DRing3
LibraryImport.DComposeTypes
LibraryImport.DComposeBSP
LibraryImport.DComposeStack
LibraryImport.DComposeFloat
LibraryImport.DCompose
LibraryImport.DInputTypes
LibraryImport.DInputEvdev
LibraryImport.DInputDiscover
LibraryImport.Font
LibraryImport.FontBitmap
LibraryImport.TextBuffer
LibraryImport.Cursor
LibraryImport.CursorBitmap
LibraryImport.Focus

// =============================================================================
// STATE
// =============================================================================
FixedPool.WBSPState {
    "running":    Initialize=0
    "alt_held":   Initialize=0
    "dirty":      Initialize=0
    "scr_w":      Initialize=0
    "scr_h":      Initialize=0
    "tty_fd":     Initialize=0
    "font":       Initialize=0
    "cursor_x":   Initialize=0
    "cursor_y":   Initialize=0
}

// =============================================================================
// TBMAP — parallel to WinTable, maps slot index → TextBuffer handle
// -1 = no buffer for that slot
// =============================================================================
FixedPool.TBMap {
    "tb0":  Initialize=0
    "tb1":  Initialize=0
    "tb2":  Initialize=0
    "tb3":  Initialize=0
    "tb4":  Initialize=0
    "tb5":  Initialize=0
    "tb6":  Initialize=0
    "tb7":  Initialize=0
    "tb8":  Initialize=0
    "tb9":  Initialize=0
    "tb10": Initialize=0
    "tb11": Initialize=0
    "tb12": Initialize=0
    "tb13": Initialize=0
    "tb14": Initialize=0
    "tb15": Initialize=0
}

// TBMap entries — 16 slots * 8 bytes, stored as flat array
// We use a FixedPool array approach via Allocate
FixedPool.TBMapState {
    "data":        Initialize=0
    "initialized": Initialize=0
}

Function.TBMap_Init {
    Output: Integer
    Body: {
        TBMapState.data = Allocate(128)   // 16 * 8 bytes
        i = 0
        WhileLoop LessThan(i, 16) {
            StoreValue(Add(TBMapState.data, Multiply(i, 8)), -1)
            i = Add(i, 1)
        }
        TBMapState.initialized = 1
        ReturnValue(1)
    }
}

Function.TBMap_Set {
    Input: slot:      Integer
    Input: tb_handle: Integer
    Body: {
        StoreValue(Add(TBMapState.data, Multiply(slot, 8)), tb_handle)
        ReturnValue(0)
    }
}

Function.TBMap_Get {
    Input:  slot: Integer
    Output: Integer
    Body: {
        ReturnValue(Dereference(Add(TBMapState.data, Multiply(slot, 8))))
    }
}

// Find TBMap slot for a given WinTable leaf
Function.TBMap_FindSlot {
    Input:  leaf: Integer
    Output: Integer
    Body: {
        cnt = WinTable.count
        i   = 0
        WhileLoop LessThan(i, cnt) {
            base      = Add(WinTable.entries, Multiply(i, WinTableConst.ENTRY_SIZE))
            entry_leaf = Dereference(Add(base, WinTableConst.LEAF_OFS))
            IfCondition EqualTo(entry_leaf, leaf) ThenBlock: {
                ReturnValue(i)
            }
            i = Add(i, 1)
        }
        ReturnValue(-1)
    }
}

// Get TextBuffer handle for focused leaf
Function.GetFocusedTB {
    Output: Integer
    Body: {
        leaf = Compositor.focused_leaf
        slot = TBMap_FindSlot(leaf)
        IfCondition LessThan(slot, 0) ThenBlock: { ReturnValue(-1) }
        ReturnValue(TBMap_Get(slot))
    }
}

// =============================================================================
// CREATE PANE — surface + text buffer for a leaf
// Called after WinCreate_ForLeaf has already added to WinTable
// =============================================================================
Function.CreatePaneBuffer {
    Input:  leaf: Integer
    Output: Integer
    Body: {
        slot = TBMap_FindSlot(leaf)
        IfCondition LessThan(slot, 0) ThenBlock: {
            PrintMessage("[TB] ERROR: leaf not in WinTable\n")
            ReturnValue(-1)
        }
        surf = WinTable_GetSurface(leaf)
        IfCondition EqualTo(surf, 0) ThenBlock: { ReturnValue(-1) }

        tb = TextBuffer_Create(surf, WBSPState.font)
        IfCondition LessThan(tb, 0) ThenBlock: {
            PrintMessage("[TB] ERROR: TextBuffer_Create failed\n")
            ReturnValue(-1)
        }
        // Set bg color to match pane color so render clears correctly
        pane_color = WinTable_GetColor(leaf)
        TextBuffer_SetColors(tb, 0xFFFFFF, pane_color)
        TBMap_Set(slot, tb)
        PrintMessage("[TB] pane buffer slot=")
        PrintNumber(slot)
        PrintMessage(" tb=")
        PrintNumber(tb)
        PrintMessage("\n")
        ReturnValue(tb)
    }
}

// =============================================================================
// DESTROY PANE BUFFER — called before removing from WinTable
// =============================================================================
Function.DestroyPaneBuffer {
    Input:  leaf: Integer
    Output: Integer
    Body: {
        slot = TBMap_FindSlot(leaf)
        IfCondition LessThan(slot, 0) ThenBlock: { ReturnValue(0) }
        tb = TBMap_Get(slot)
        IfCondition GreaterEqual(tb, 0) ThenBlock: {
            TextBuffer_Destroy(tb)
        }
        TBMap_Set(slot, -1)
        ReturnValue(1)
    }
}

// =============================================================================
// RENDER ALL DIRTY BUFFERS — called each tick
// =============================================================================
Function.RenderDirtyBuffers {
    Output: Integer
    Body: {
        cnt     = WinTable.count
        any     = 0
        i       = 0
        WhileLoop LessThan(i, cnt) {
            tb = TBMap_Get(i)
            IfCondition GreaterEqual(tb, 0) ThenBlock: {
                IfCondition EqualTo(TextBuffer_IsDirty(tb), 1) ThenBlock: {
                    TextBuffer_Render(tb)
                    any = 1
                }
            }
            i = Add(i, 1)
        }
        ReturnValue(any)
    }
}

// =============================================================================
// INIT ROOT SURFACE + BUFFER
// =============================================================================
Function.InitRootSurface {
    Output: Integer
    Body: {
        root = Compositor.root
        w    = BSP_GetRegionW(root)
        h    = BSP_GetRegionH(root)
        surf = Surface_Create(SurfaceFormat.PIXEL_32, w, h)
        IfCondition EqualTo(surf, 0) ThenBlock: {
            PrintMessage("[Init] ERROR\n")
            ReturnValue(0)
        }
        Draw_Pix_FillRect(surf, 0, 0, w, h, 0x1A3A5C)
        WinTable_Add(root, surf, 0x1A3A5C)

        // Create text buffer for root pane
        tb = CreatePaneBuffer(root)
        IfCondition GreaterEqual(tb, 0) ThenBlock: {
            TextBuffer_PutString(tb, "AILANG Display Server")
            TextBuffer_PutChar(tb, 10)
            TextBuffer_PutString(tb, "Alt+V split  Alt+H split  Alt+M merge")
            TextBuffer_PutChar(tb, 10)
            TextBuffer_PutString(tb, "Click pane to focus. Type to edit.")
            TextBuffer_Render(tb)
        }

        PrintMessage("[Init] root ")
        PrintNumber(w)
        PrintMessage("x")
        PrintNumber(h)
        PrintMessage("\n")
        ReturnValue(surf)
    }
}

// =============================================================================
// BLIT ONE SURFACE
// =============================================================================
Function.BlitOneSurface {
    Input: surf:  Integer
    Input: dst_x: Integer
    Input: dst_y: Integer
    Output: Integer
    Body: {
        sw        = Surface_GetWidth(surf)
        sh        = Surface_GetHeight(surf)
        src_data  = Surface_GetData(surf)
        src_pitch = Surface_GetPitch(surf)
        dst_buf   = FB_GetDrawBuffer()
        dst_pitch = FB.pitch
        row_bytes = Multiply(sw, SurfaceConst.PIXEL_BYTES)
        dst_x_off = Multiply(dst_x, SurfaceConst.PIXEL_BYTES)
        y = 0
        WhileLoop LessThan(y, sh) {
            src_row = Add(src_data, Multiply(y, src_pitch))
            dst_row = Add(Add(dst_buf, Multiply(Add(y, dst_y), dst_pitch)), dst_x_off)
            i = 0
            WhileLoop LessThan(i, row_bytes) {
                SetByte(dst_row, i, GetByte(src_row, i))
                i = Add(i, 1)
            }
            y = Add(y, 1)
        }
        ReturnValue(1)
    }
}

// =============================================================================
// BLIT ALL
// =============================================================================
Function.BlitAllSurfaces {
    Output: Integer
    Body: {
        cnt = WinTable.count
        i   = 0
        WhileLoop LessThan(i, cnt) {
            base = Add(WinTable.entries, Multiply(i, WinTableConst.ENTRY_SIZE))
            leaf = Dereference(Add(base, WinTableConst.LEAF_OFS))
            surf = Dereference(Add(base, WinTableConst.SURF_OFS))
            IfCondition NotEqual(surf, 0) ThenBlock: {
                x = BSP_GetRegionX(leaf)
                y = BSP_GetRegionY(leaf)
                BlitOneSurface(surf, x, y)
            }
            i = Add(i, 1)
        }
        DrawCursor()
        FB_FlipFast()
        ReturnValue(0)
    }
}

// =============================================================================
// DRAW CURSOR
// =============================================================================
Function.DrawCursor {
    Output: Integer
    Body: {
        Cursor_Draw()
        ReturnValue(1)
    }
}

// =============================================================================
// DRAIN RING1
// =============================================================================
Function.DrainRing1BSP {
    Output: Integer
    Body: {
        entry = Allocate(RingEntry.SIZE)
        quit  = 0

        WhileLoop EqualTo(Ring1_IsEmpty(), 0) {
            Ring1_Drain(entry)
            ev   = Dereference(Add(entry, RingEntry.TYPE))
            pa   = Dereference(Add(entry, RingEntry.PARAM_A))
            pb   = Dereference(Add(entry, RingEntry.PARAM_B))
            data = Dereference(Add(entry, RingEntry.PARAM_C))

            // Key down
            IfCondition EqualTo(ev, Ring1Event.KEY_DOWN) ThenBlock: {
                IfCondition EqualTo(pa, 56)      ThenBlock: { WBSPState.alt_held = 1 }
                IfCondition EqualTo(pa, 100)     ThenBlock: { WBSPState.alt_held = 1 }
                IfCondition EqualTo(pa, Key.ESC) ThenBlock: { quit = 1 }

                IfCondition EqualTo(WBSPState.alt_held, 1) ThenBlock: {
                    IfCondition EqualTo(pa, 47) ThenBlock: {
                        PrintMessage("[Key] Alt+V\n")
                        Ring0_Post(Ring0Cmd.TILE_SPLIT_V, 0, 0, 0)
                        WBSPState.dirty = 1
                    }
                    IfCondition EqualTo(pa, 35) ThenBlock: {
                        PrintMessage("[Key] Alt+H\n")
                        Ring0_Post(Ring0Cmd.TILE_SPLIT_H, 0, 0, 0)
                        WBSPState.dirty = 1
                    }
                    IfCondition EqualTo(pa, 50) ThenBlock: {
                        PrintMessage("[Key] Alt+M\n")
                        Ring0_Post(Ring0Cmd.TILE_MERGE, 0, 0, 0)
                        WBSPState.dirty = 1
                    }
                } ElseBlock: {
                    // Non-hotkey — route to focused pane via Focus
                    IfCondition NotEqual(pa, Key.ESC) ThenBlock: {
                        consumed = Focus_KeyDown(pa, KeyMod.shift)
                        IfCondition EqualTo(consumed, 1) ThenBlock: {
                            WBSPState.dirty = 1
                        }
                    }
                }
            }

            // Key up
            IfCondition EqualTo(ev, Ring1Event.KEY_UP) ThenBlock: {
                IfCondition EqualTo(pa, 56)  ThenBlock: { WBSPState.alt_held = 0 }
                IfCondition EqualTo(pa, 100) ThenBlock: { WBSPState.alt_held = 0 }
            }

            // Mouse move
            IfCondition EqualTo(ev, Ring1Event.MOUSE_MOVE) ThenBlock: {
                Cursor_SetPos(pa, pb)
                WBSPState.cursor_x = pa
                WBSPState.cursor_y = pb
                Focus_MouseMove(pa, pb)
                new_shape = Focus_GetCursorShape(pa, pb)
                Cursor_SetShape(new_shape)
                WBSPState.dirty    = 1
            }

            // Mouse click — focus pane via Focus library
            IfCondition EqualTo(ev, Ring1Event.MOUSE_DOWN) ThenBlock: {
                changed = Focus_MouseDown(pa, pb, data)
                IfCondition EqualTo(changed, 1) ThenBlock: {
                    WBSPState.dirty = 1
                }
            }
        }

        Deallocate(entry, RingEntry.SIZE)
        ReturnValue(quit)
    }
}

// =============================================================================
// TTY INIT
// =============================================================================
Function.InitTTY {
    Output: Integer
    Body: {
        tty0_fd = SystemCall(2, "/dev/tty0", 2, 0)
        IfCondition LessThan(tty0_fd, 0) ThenBlock: {
            PrintMessage("[TTY] no tty0\n")
            ReturnValue(0)
        }
        vt_buf = Allocate(8)
        SystemCall(16, tty0_fd, 0x5603, vt_buf)
        vt_num = GetByte(vt_buf, 0)
        SystemCall(3, tty0_fd, 0, 0)
        Deallocate(vt_buf, 8)
        tty_path = StringConcat("/dev/tty", NumberToString(vt_num))
        tty_fd   = SystemCall(2, tty_path, 2, 0)
        IfCondition LessThan(tty_fd, 0) ThenBlock: {
            PrintMessage("[TTY] open failed\n")
            ReturnValue(0)
        }
        SystemCall(16, tty_fd, 19258, 1)
        WBSPState.tty_fd = tty_fd
        PrintMessage("[TTY] VT=")
        PrintNumber(vt_num)
        PrintMessage("\n")
        ReturnValue(1)
    }
}

// =============================================================================
// TTY RESTORE
// =============================================================================
Function.RestoreTTY {
    Output: Integer
    Body: {
        tty_fd = WBSPState.tty_fd
        IfCondition GreaterEqual(tty_fd, 0) ThenBlock: {
            SystemCall(16, tty_fd, 19258, 0)
            SystemCall(3,  tty_fd, 0, 0)
        }
        ReturnValue(1)
    }
}

// =============================================================================
// FB INIT
// =============================================================================
Function.InitFB {
    Output: Integer
    Body: {
        ok = RenderFB_InitDouble()
        IfCondition EqualTo(ok, 0) ThenBlock: {
            PrintMessage("[FAIL] FB\n")
            ReturnValue(0)
        }
        w = FB_GetWidth()
        h = FB_GetHeight()
        WBSPState.scr_w    = w
        WBSPState.scr_h    = h
        WBSPState.cursor_x = Divide(w, 2)
        WBSPState.cursor_y = Divide(h, 2)
        PrintMessage("[WBSP] FB: ")
        PrintNumber(w)
        PrintMessage("x")
        PrintNumber(h)
        PrintMessage("\n")
        ReturnValue(1)
    }
}

// =============================================================================
// COMPOSITOR INIT
// =============================================================================
Function.InitCompositor {
    Output: Integer
    Body: {
        ok = Compose_Init(WBSPState.scr_w, WBSPState.scr_h)
        IfCondition EqualTo(ok, 0) ThenBlock: {
            PrintMessage("[FAIL] Compose\n")
            ReturnValue(0)
        }
        Compose_InitFB(0, 0)
        ReturnValue(1)
    }
}

// =============================================================================
// FONT INIT
// =============================================================================
Function.InitFont {
    Output: Integer
    Body: {
        Font_Init()
        handle = Font_CreateBuiltin(8)
        IfCondition LessThan(handle, 0) ThenBlock: {
            PrintMessage("[FAIL] Font\n")
            ReturnValue(0)
        }
        WBSPState.font = handle
        Compose_SetFont(handle)
        PrintMessage("[Font] 8x8 ready handle=")
        PrintNumber(handle)
        PrintMessage("\n")
        ReturnValue(1)
    }
}

// =============================================================================
// CURSOR INIT
// =============================================================================
Function.InitCursor {
    Output: Integer
    Body: {
        CursorConfig.type      = CursorType.BITMAP
        CursorConfig.shape     = CursorShape.ARROW
        CursorConfig.hotspot_x = 0
        CursorConfig.hotspot_y = 0
        ok = Cursor_Init(WBSPState.scr_w, WBSPState.scr_h)
        IfCondition EqualTo(ok, 0) ThenBlock: {
            PrintMessage("[FAIL] Cursor\n")
            ReturnValue(0)
        }
        ReturnValue(1)
    }
}

// =============================================================================
// INPUT INIT
// =============================================================================
Function.InitInput {
    Output: Integer
    Body: {
        Ring1_Init()
        Evdev_SetMouseBounds(Subtract(WBSPState.scr_w, 1), Subtract(WBSPState.scr_h, 1))
        opened = Discover_OpenAll()
        IfCondition EqualTo(opened, 0) ThenBlock: {
            PrintMessage("[FAIL] input\n")
            ReturnValue(0)
        }
        ReturnValue(1)
    }
}

// =============================================================================
// SYNC PANE BUFFERS
// After Compose_TickRing0, WinTable may have changed (splits/merges).
// Destroy TBs for slots that no longer exist.
// Create TBs for new slots that have no TB yet.
// =============================================================================
Function.SyncPaneBuffers {
    Output: Integer
    Body: {
        cnt = WinTable.count

        // Pass 1: destroy TBs for slots beyond current WinTable count
        // (merge reduces count — old slots are now invalid)
        i = cnt
        WhileLoop LessThan(i, 16) {
            tb = TBMap_Get(i)
            IfCondition GreaterEqual(tb, 0) ThenBlock: {
                TextBuffer_Destroy(tb)
                TBMap_Set(i, -1)
            }
            i = Add(i, 1)
        }

        // Pass 2: verify existing slots still have valid surfaces
        // After a split the old slot's surface is destroyed and replaced
        // If the surface pointer changed, destroy old TB and create new one
        i = 0
        WhileLoop LessThan(i, cnt) {
            base = Add(WinTable.entries, Multiply(i, WinTableConst.ENTRY_SIZE))
            leaf = Dereference(Add(base, WinTableConst.LEAF_OFS))
            surf = Dereference(Add(base, WinTableConst.SURF_OFS))
            tb   = TBMap_Get(i)
            IfCondition GreaterEqual(tb, 0) ThenBlock: {
                tb_surf = TB_Get(tb, TBField.SURF)
                IfCondition NotEqual(tb_surf, surf) ThenBlock: {
                    // Surface changed — create new TB, copy content, destroy old
                    new_tb = TextBuffer_Create(surf, WBSPState.font)
                    IfCondition GreaterEqual(new_tb, 0) ThenBlock: {
                        pane_color = WinTable_GetColor(leaf)
                        TextBuffer_SetColors(new_tb, 0xFFFFFF, pane_color)
                        CopyTBContent(tb, new_tb)
                    }
                    TextBuffer_Destroy(tb)
                    TBMap_Set(i, new_tb)
                    tb = new_tb
                }
            }
            // Create TB if slot has no valid TB
            IfCondition LessThan(tb, 0) ThenBlock: {
                leaf = Dereference(Add(base, WinTableConst.LEAF_OFS))
                new_tb = TextBuffer_Create(surf, WBSPState.font)
                IfCondition GreaterEqual(new_tb, 0) ThenBlock: {
                    TBMap_Set(i, new_tb)
                    PrintMessage("[TB] new pane buffer slot=")
                    PrintNumber(i)
                    PrintMessage("\n")
                }
            }
            i = Add(i, 1)
        }
        ReturnValue(1)
    }
}


Function.CopyTBContent {
    Input:  src_tb: Integer
    Input:  dst_tb: Integer
    Output: Integer
    Body: {
        src_buf  = TB_Get(src_tb, TBField.BUF)
        dst_buf  = TB_Get(dst_tb, TBField.BUF)
        src_cols = TB_Get(src_tb, TBField.COLS)
        src_rows = TB_Get(src_tb, TBField.ROWS)
        dst_cols = TB_Get(dst_tb, TBField.COLS)
        dst_rows = TB_Get(dst_tb, TBField.ROWS)
        copy_rows = src_rows
        copy_cols = src_cols
        IfCondition LessThan(dst_rows, copy_rows) ThenBlock: { copy_rows = dst_rows }
        IfCondition LessThan(dst_cols, copy_cols) ThenBlock: { copy_cols = dst_cols }
        row = 0
        WhileLoop LessThan(row, copy_rows) {
            col = 0
            WhileLoop LessThan(col, copy_cols) {
                ch = GetByte(src_buf, Add(Multiply(row, src_cols), col))
                SetByte(dst_buf, Add(Multiply(row, dst_cols), col), ch)
                col = Add(col, 1)
            }
            row = Add(row, 1)
        }
        cur_col = TB_Get(src_tb, TBField.CUR_COL)
        cur_row = TB_Get(src_tb, TBField.CUR_ROW)
        IfCondition GreaterEqual(cur_col, dst_cols) ThenBlock: { cur_col = Subtract(dst_cols, 1) }
        IfCondition GreaterEqual(cur_row, dst_rows) ThenBlock: { cur_row = Subtract(dst_rows, 1) }
        TB_Set(dst_tb, TBField.CUR_COL, cur_col)
        TB_Set(dst_tb, TBField.CUR_ROW, cur_row)
        TB_Set(dst_tb, TBField.DIRTY,   1)
        ReturnValue(1)
    }
}

Function.RunLoop {
    Output: Integer
    Body: {
        WBSPState.running = 1
        WhileLoop EqualTo(WBSPState.running, 1) {
            Evdev_Poll()
            quit = DrainRing1BSP()
            IfCondition EqualTo(quit, 1) ThenBlock: {
                WBSPState.running = 0
            }

            Compose_TickRing0()

            // Sync pane buffers and keep Focus in sync with compositor
            SyncPaneBuffers()
            Focus_SetLeaf(Compositor.focused_leaf)

            // Render dirty text buffers into their surfaces
            any_dirty = RenderDirtyBuffers()

            IfCondition EqualTo(WBSPState.dirty, 1) ThenBlock: {
                BlitAllSurfaces()
                WBSPState.dirty = 0
            } ElseBlock: {
                IfCondition EqualTo(any_dirty, 1) ThenBlock: {
                    BlitAllSurfaces()
                }
            }
        }
        ReturnValue(1)
    }
}

// =============================================================================
// SHUTDOWN
// =============================================================================
Function.Shutdown {
    Output: Integer
    Body: {
        Evdev_CloseAll()
        Cursor_Shutdown()
        Compose_Shutdown()
        RenderFB_Shutdown()
        RestoreTTY()
        PrintMessage("[SysDisplay] DONE\n")
        ReturnValue(1)
    }
}

// =============================================================================
// ENTRY POINT
// =============================================================================
SubRoutine.Main {
    Arena_Init()
    PrintMessage("[SysDisplay] starting\n")
    InitFB()
    InitTTY()
    InitCompositor()
    InitFont()
    InitCursor()
    TBMap_Init()
    InitRootSurface()
    Focus_Init(TBMapState.data, WinTable.entries)
    InitInput()
    BlitAllSurfaces()
    RunLoop()
    Shutdown()
}

RunTask(Main)