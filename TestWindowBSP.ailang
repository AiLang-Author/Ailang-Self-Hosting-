// TestWindowBSP.ailang
// Phase 7b — Live BSP window management on real hardware
// Structure mirrors TestInput.ailang which is proven to work
//
// Hotkeys:
//   Alt+V  — split vertical
//   Alt+H  — split horizontal
//   Alt+M  — merge
//   ESC    — quit

LibraryImport.Framebuffer
LibraryImport.DRenderFB
LibraryImport.Arena
LibraryImport.DSurfaceTypes
LibraryImport.DSurface
LibraryImport.DDrawPixel
LibraryImport.DRingTypes
LibraryImport.DRing
LibraryImport.DRing0
LibraryImport.DRing1
LibraryImport.DRing2
LibraryImport.DRing3
LibraryImport.DComposeTypes
LibraryImport.DComposeBSP
LibraryImport.DComposeStack
LibraryImport.DComposeFloat
LibraryImport.DCompose
LibraryImport.DInputTypes
LibraryImport.DInputEvdev
LibraryImport.DInputDiscover

// =============================================================================
// STATE — mirrors TestInput pattern exactly
// =============================================================================
FixedPool.WBSPState {
    "running":  Initialize=0
    "alt_held": Initialize=0
    "dirty":    Initialize=0
    "scr_w":    Initialize=0
    "scr_h":    Initialize=0
}

FixedPool.RestoreTTY {
    "fd":     Initialize=0
    "fd_raw": Initialize=0
}

// =============================================================================
// INIT ROOT SURFACE
// =============================================================================
Function.InitRootSurface {
    Output: Integer
    Body: {
        root = Compositor.root
        w    = BSP_GetRegionW(root)
        h    = BSP_GetRegionH(root)
        surf = Surface_Create(w, h, SurfaceFormat.PIXEL_32)
        IfCondition EqualTo(surf, 0) ThenBlock: {
            PrintMessage("[Init] ERROR\n")
            ReturnValue(0)
        }
        Draw_Pix_FillRect(surf, 0, 0, w, h, 0xFF0000)
        WinTable_Add(root, surf)
        PrintMessage("[Init] root ")
        PrintNumber(w)
        PrintMessage("x")
        PrintNumber(h)
        PrintMessage("\n")
        ReturnValue(surf)
    }
}

// =============================================================================
// BLIT ALL
// =============================================================================
Function.BlitAllSurfaces {
    Output: Integer
    Body: {
        cnt = WinTable.count
        PrintMessage("[Blit] cnt=")
        PrintNumber(cnt)
        PrintMessage("\n")
        i   = 0
        WhileLoop LessThan(i, cnt) {
            base = Add(WinTable.entries, Multiply(i, WinTableConst.ENTRY_SIZE))
            leaf = Dereference(Add(base, WinTableConst.LEAF_OFS))
            surf = Dereference(Add(base, WinTableConst.SURF_OFS))
            IfCondition NotEqual(surf, 0) ThenBlock: {
                x = BSP_GetRegionX(leaf)
                y = BSP_GetRegionY(leaf)
                w = BSP_GetRegionW(leaf)
                h = BSP_GetRegionH(leaf)
                PrintMessage("[Blit] x=")
                PrintNumber(x)
                PrintMessage(" y=")
                PrintNumber(y)
                PrintMessage(" w=")
                PrintNumber(w)
                PrintMessage(" h=")
                PrintNumber(h)
                PrintMessage("\n")
                RenderFB_FlushRect(surf, x, y, w, h)
            }
            i = Add(i, 1)
        }
        ReturnValue(0)
    }
}

// =============================================================================
// DRAIN RING1 — returns 1 if ESC
// =============================================================================
Function.DrainRing1BSP {
    Output: Integer
    Body: {
        entry = Allocate(RingEntry.SIZE)
        quit  = 0

        WhileLoop EqualTo(Ring1_IsEmpty(), 0) {
            Ring1_Drain(entry)
            ev = Subtract(Dereference(Add(entry, RingEntry.TYPE)),    65536)
            pa = Subtract(Dereference(Add(entry, RingEntry.PARAM_A)), 65536)

            IfCondition EqualTo(ev, Ring1Event.KEY_DOWN) ThenBlock: {
                PrintMessage("[Key] ")
                PrintNumber(pa)
                PrintMessage("\n")
                IfCondition EqualTo(pa, 56)  ThenBlock: { WBSPState.alt_held = Add(1, 65536) }
                IfCondition EqualTo(pa, 100) ThenBlock: { WBSPState.alt_held = Add(1, 65536) }
                IfCondition EqualTo(pa, Key.ESC) ThenBlock: { quit = 1 }

                alt = Subtract(WBSPState.alt_held, 65536)
                IfCondition EqualTo(alt, 1) ThenBlock: {
                    IfCondition EqualTo(pa, 47) ThenBlock: {
                        PrintMessage("[Key] Alt+V\n")
                        Ring0_Post(Ring0Cmd.TILE_SPLIT_V, 0, 0)
                        WBSPState.dirty = Add(1, 65536)
                    }
                    IfCondition EqualTo(pa, 35) ThenBlock: {
                        PrintMessage("[Key] Alt+H\n")
                        Ring0_Post(Ring0Cmd.TILE_SPLIT_H, 0, 0)
                        WBSPState.dirty = Add(1, 65536)
                    }
                    IfCondition EqualTo(pa, 50) ThenBlock: {
                        PrintMessage("[Key] Alt+M\n")
                        Ring0_Post(Ring0Cmd.TILE_MERGE, 0, 0)
                        WBSPState.dirty = Add(1, 65536)
                    }
                }
            }

            IfCondition EqualTo(ev, Ring1Event.KEY_UP) ThenBlock: {
                IfCondition EqualTo(pa, 56)  ThenBlock: { WBSPState.alt_held = Add(0, 65536) }
                IfCondition EqualTo(pa, 100) ThenBlock: { WBSPState.alt_held = Add(0, 65536) }
            }
        }

        Deallocate(entry, RingEntry.SIZE)
        ReturnValue(quit)
    }
}

// =============================================================================
// MAIN — structure mirrors TestInput.ailang exactly
// =============================================================================
SubRoutine.Main {
    Arena_Init()
    PrintMessage("[TestWindowBSP] Phase 7b\n")

    fb_ok = RenderFB_InitDouble()
    IfCondition EqualTo(fb_ok, 0) ThenBlock: {
        PrintMessage("[FAIL] FB\n")
        Exit(1)
    }

    w = FB_GetWidth()
    h = FB_GetHeight()
    WBSPState.scr_w = w
    WBSPState.scr_h = h
    PrintMessage("[WBSP] FB: ")
    PrintNumber(w)
    PrintMessage("x")
    PrintNumber(h)
    PrintMessage("\n")

    // TTY graphics mode — same as TestInput
    tty_fd_raw = -1
    tty_fd     = Add(-1, 65536)
    tty0_fd    = SystemCall(2, "/dev/tty0", 2, 0)
    IfCondition GreaterEqual(tty0_fd, 0) ThenBlock: {
        vt_buf = Allocate(8)
        SystemCall(16, tty0_fd, 0x5603, vt_buf)
        vt_num = GetByte(vt_buf, 0)
        SystemCall(3, tty0_fd, 0, 0)
        Deallocate(vt_buf, 8)
        tty_path   = StringConcat("/dev/tty", NumberToString(vt_num))
        tty_fd_raw = SystemCall(2, tty_path, 2, 0)
        tty_fd     = Add(tty_fd_raw, 65536)
        IfCondition GreaterEqual(tty_fd_raw, 0) ThenBlock: {
            SystemCall(16, tty_fd_raw, 19258, 1)
            PrintMessage("[TTY] VT=")
            PrintNumber(vt_num)
            PrintMessage("\n")
        }
    }

    // Compositor init — use saved screen dims, not locals (TTY block corrupts locals)
    ok = Compose_Init(WBSPState.scr_w, WBSPState.scr_h)
    IfCondition EqualTo(ok, 0) ThenBlock: {
        PrintMessage("[FAIL] Compose\n")
        Exit(1)
    }
    Compose_InitFB(0, 0)

    // Input init
    Ring1_Init()
    Evdev_SetMouseBounds(Subtract(WBSPState.scr_w, 1), Subtract(WBSPState.scr_h, 1))
    opened = Discover_OpenAll()
    IfCondition EqualTo(opened, 0) ThenBlock: {
        PrintMessage("[FAIL] input\n")
        Exit(1)
    }

    // Draw initial screen
    FB_FillRectFast(0, 0, 1280, 512, 0xFF0000)
    FB_FillRectFast(0, 512, 1280, 512, 0x0000FF)
    FB_FlipFast()

    // Main loop — exact TestInput pattern
    WBSPState.running = Add(1, 65536)
    loop_count = 0
    WhileLoop EqualTo(Subtract(WBSPState.running, 65536), 1) {
        loop_count = Add(loop_count, 1)
        _p   = Evdev_Poll()
        quit = DrainRing1BSP()
        IfCondition EqualTo(quit, 1) ThenBlock: {
            WBSPState.running = Add(0, 65536)
        }

        Compose_TickRing0()

        IfCondition EqualTo(Subtract(WBSPState.dirty, 65536), 1) ThenBlock: {
            BlitAllSurfaces()
            WBSPState.dirty = Add(0, 65536)
        }
    }

    // Shutdown
    _c = Evdev_CloseAll()
    Compose_Shutdown()
    RenderFB_Shutdown()

    tty_fd_restore = Subtract(tty_fd, 65536)
    IfCondition GreaterEqual(tty_fd_restore, 0) ThenBlock: {
        SystemCall(16, tty_fd_restore, 19258, 0)
        SystemCall(3,  tty_fd_restore, 0, 0)
    }

    PrintMessage("[TestWindowBSP] DONE\n")
    Exit(0)
}

RunTask(Main)