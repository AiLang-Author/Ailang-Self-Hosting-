// TestWindowBSP.ailang
// Phase 7b — Live BSP window management + font rendering
//
// Hotkeys:
//   Alt+V  — split vertical
//   Alt+H  — split horizontal
//   Alt+M  — merge
//   ESC    — quit

LibraryImport.Framebuffer
LibraryImport.DRenderFB
LibraryImport.Arena
LibraryImport.DSurfaceTypes
LibraryImport.DSurface
LibraryImport.DDrawPixel
LibraryImport.DRingTypes
LibraryImport.DRing
LibraryImport.DRing0
LibraryImport.DRing1
LibraryImport.DRing2
LibraryImport.DRing3
LibraryImport.DComposeTypes
LibraryImport.DComposeBSP
LibraryImport.DComposeStack
LibraryImport.DComposeFloat
LibraryImport.DCompose
LibraryImport.DInputTypes
LibraryImport.DInputEvdev
LibraryImport.DInputDiscover
LibraryImport.Font
LibraryImport.FontBitmap

// =============================================================================
// STATE
// =============================================================================
FixedPool.WBSPState {
    "running":   Initialize=0
    "alt_held":  Initialize=0
    "dirty":     Initialize=0
    "scr_w":     Initialize=0
    "scr_h":     Initialize=0
    "tty_fd":    Initialize=0
    "font":      Initialize=0
}

// =============================================================================
// FONT INIT
// =============================================================================
Function.InitFont {
    Output: Integer
    Body: {
        Font_Init()
        handle = Font_CreateBuiltin(8)
        IfCondition LessThan(handle, 0) ThenBlock: {
            PrintMessage("[Font] ERROR\n")
            ReturnValue(0)
        }
        WBSPState.font = handle
        Compose_SetFont(handle)
        PrintMessage("[Font] 8x8 bitmap ready, handle=")
        PrintNumber(handle)
        PrintMessage("\n")
        ReturnValue(1)
    }
}

// =============================================================================
// DRAW LABEL INTO SURFACE
// Renders "WxH" at top-left of surface in white
// =============================================================================
Function.DrawPaneLabel {
    Input:  surf: Integer
    Input:  w:    Integer
    Input:  h:    Integer
    Body: {
        handle = WBSPState.font
        // Build label string into a small stack buffer via NumberToString
        ws = NumberToString(w)
        hs = NumberToString(h)
        // Draw "W" value
        FontBitmap_DrawString(surf, handle, 4, 4, ws, 0xFFFFFF)
        // Draw "x" separator
        x_pos = Add(4, Multiply(StringLength(ws), 8))
        FontBitmap_DrawChar(surf, handle, x_pos, 4, 120, 0xFFFFFF)
        // Draw "H" value
        h_pos = Add(x_pos, 8)
        FontBitmap_DrawString(surf, handle, h_pos, 4, hs, 0xFFFFFF)
        ReturnValue(0)
    }
}

// =============================================================================
// INIT ROOT SURFACE
// =============================================================================
Function.InitRootSurface {
    Output: Integer
    Body: {
        root = Compositor.root
        w    = BSP_GetRegionW(root)
        h    = BSP_GetRegionH(root)
        surf = Surface_Create(SurfaceFormat.PIXEL_32, w, h)
        IfCondition EqualTo(surf, 0) ThenBlock: {
            PrintMessage("[Init] ERROR\n")
            ReturnValue(0)
        }
        Draw_Pix_FillRect(surf, 0, 0, w, h, 0x1A3A5C)
        DrawPaneLabel(surf, w, h)
        WinTable_Add(root, surf)
        PrintMessage("[Init] root ")
        PrintNumber(w)
        PrintMessage("x")
        PrintNumber(h)
        PrintMessage("\n")
        ReturnValue(surf)
    }
}

// =============================================================================
// BLIT ONE SURFACE
// =============================================================================
Function.BlitOneSurface {
    Input: surf:  Integer
    Input: dst_x: Integer
    Input: dst_y: Integer
    Output: Integer
    Body: {
        sw        = Surface_GetWidth(surf)
        sh        = Surface_GetHeight(surf)
        src_data  = Surface_GetData(surf)
        src_pitch = Surface_GetPitch(surf)
        dst_buf   = FB_GetDrawBuffer()
        dst_pitch = FB.pitch
        row_bytes = Multiply(sw, SurfaceConst.PIXEL_BYTES)
        dst_x_off = Multiply(dst_x, SurfaceConst.PIXEL_BYTES)
        y = 0
        WhileLoop LessThan(y, sh) {
            src_row = Add(src_data, Multiply(y, src_pitch))
            dst_row = Add(Add(dst_buf, Multiply(Add(y, dst_y), dst_pitch)), dst_x_off)
            i = 0
            WhileLoop LessThan(i, row_bytes) {
                SetByte(dst_row, i, GetByte(src_row, i))
                i = Add(i, 1)
            }
            y = Add(y, 1)
        }
        ReturnValue(1)
    }
}

// =============================================================================
// BLIT ALL
// =============================================================================
Function.BlitAllSurfaces {
    Output: Integer
    Body: {
        cnt = WinTable.count
        PrintMessage("[Blit] cnt=")
        PrintNumber(cnt)
        PrintMessage("\n")
        i = 0
        WhileLoop LessThan(i, cnt) {
            base = Add(WinTable.entries, Multiply(i, WinTableConst.ENTRY_SIZE))
            leaf = Dereference(Add(base, WinTableConst.LEAF_OFS))
            surf = Dereference(Add(base, WinTableConst.SURF_OFS))
            IfCondition NotEqual(surf, 0) ThenBlock: {
                x = BSP_GetRegionX(leaf)
                y = BSP_GetRegionY(leaf)
                w = BSP_GetRegionW(leaf)
                h = BSP_GetRegionH(leaf)
                PrintMessage("[Blit] x=")
                PrintNumber(x)
                PrintMessage(" y=")
                PrintNumber(y)
                PrintMessage(" w=")
                PrintNumber(w)
                PrintMessage(" h=")
                PrintNumber(h)
                PrintMessage("\n")
                BlitOneSurface(surf, x, y)
            }
            i = Add(i, 1)
        }
        FB_FlipFast()
        ReturnValue(0)
    }
}

// =============================================================================
// DRAIN RING1 — returns 1 if ESC
// =============================================================================
Function.DrainRing1BSP {
    Output: Integer
    Body: {
        entry = Allocate(RingEntry.SIZE)
        quit  = 0

        WhileLoop EqualTo(Ring1_IsEmpty(), 0) {
            Ring1_Drain(entry)
            ev = Dereference(Add(entry, RingEntry.TYPE))
            pa = Dereference(Add(entry, RingEntry.PARAM_A))

            IfCondition EqualTo(ev, Ring1Event.KEY_DOWN) ThenBlock: {
                PrintMessage("[Key] ")
                PrintNumber(pa)
                PrintMessage("\n")
                IfCondition EqualTo(pa, 56)      ThenBlock: { WBSPState.alt_held = 1 }
                IfCondition EqualTo(pa, 100)     ThenBlock: { WBSPState.alt_held = 1 }
                IfCondition EqualTo(pa, Key.ESC) ThenBlock: { quit = 1 }

                IfCondition EqualTo(WBSPState.alt_held, 1) ThenBlock: {
                    IfCondition EqualTo(pa, 47) ThenBlock: {
                        PrintMessage("[Key] Alt+V\n")
                        Ring0_Post(Ring0Cmd.TILE_SPLIT_V, 0, 0, 0)
                        WBSPState.dirty = 1
                    }
                    IfCondition EqualTo(pa, 35) ThenBlock: {
                        PrintMessage("[Key] Alt+H\n")
                        Ring0_Post(Ring0Cmd.TILE_SPLIT_H, 0, 0, 0)
                        WBSPState.dirty = 1
                    }
                    IfCondition EqualTo(pa, 50) ThenBlock: {
                        PrintMessage("[Key] Alt+M\n")
                        Ring0_Post(Ring0Cmd.TILE_MERGE, 0, 0, 0)
                        WBSPState.dirty = 1
                    }
                }
            }

            IfCondition EqualTo(ev, Ring1Event.KEY_UP) ThenBlock: {
                IfCondition EqualTo(pa, 56)  ThenBlock: { WBSPState.alt_held = 0 }
                IfCondition EqualTo(pa, 100) ThenBlock: { WBSPState.alt_held = 0 }
            }
        }

        Deallocate(entry, RingEntry.SIZE)
        ReturnValue(quit)
    }
}

// =============================================================================
// TTY INIT
// =============================================================================
Function.InitTTY {
    Output: Integer
    Body: {
        tty0_fd = SystemCall(2, "/dev/tty0", 2, 0)
        IfCondition LessThan(tty0_fd, 0) ThenBlock: {
            PrintMessage("[TTY] no tty0\n")
            ReturnValue(0)
        }
        vt_buf = Allocate(8)
        SystemCall(16, tty0_fd, 0x5603, vt_buf)
        vt_num = GetByte(vt_buf, 0)
        SystemCall(3, tty0_fd, 0, 0)
        Deallocate(vt_buf, 8)
        tty_path = StringConcat("/dev/tty", NumberToString(vt_num))
        tty_fd   = SystemCall(2, tty_path, 2, 0)
        IfCondition LessThan(tty_fd, 0) ThenBlock: {
            PrintMessage("[TTY] open failed\n")
            ReturnValue(0)
        }
        SystemCall(16, tty_fd, 19258, 1)
        WBSPState.tty_fd = tty_fd
        PrintMessage("[TTY] VT=")
        PrintNumber(vt_num)
        PrintMessage("\n")
        ReturnValue(1)
    }
}

// =============================================================================
// TTY RESTORE
// =============================================================================
Function.RestoreTTY {
    Output: Integer
    Body: {
        tty_fd = WBSPState.tty_fd
        IfCondition GreaterEqual(tty_fd, 0) ThenBlock: {
            SystemCall(16, tty_fd, 19258, 0)
            SystemCall(3,  tty_fd, 0, 0)
        }
        ReturnValue(1)
    }
}

// =============================================================================
// FB INIT
// =============================================================================
Function.InitFB {
    Output: Integer
    Body: {
        ok = RenderFB_InitDouble()
        IfCondition EqualTo(ok, 0) ThenBlock: {
            PrintMessage("[FAIL] FB\n")
            ReturnValue(0)
        }
        w = FB_GetWidth()
        h = FB_GetHeight()
        WBSPState.scr_w = w
        WBSPState.scr_h = h
        PrintMessage("[WBSP] FB: ")
        PrintNumber(w)
        PrintMessage("x")
        PrintNumber(h)
        PrintMessage("\n")
        ReturnValue(1)
    }
}

// =============================================================================
// COMPOSITOR INIT
// =============================================================================
Function.InitCompositor {
    Output: Integer
    Body: {
        ok = Compose_Init(WBSPState.scr_w, WBSPState.scr_h)
        IfCondition EqualTo(ok, 0) ThenBlock: {
            PrintMessage("[FAIL] Compose\n")
            ReturnValue(0)
        }
        Compose_InitFB(0, 0)
        ReturnValue(1)
    }
}

// =============================================================================
// INPUT INIT
// =============================================================================
Function.InitInput {
    Output: Integer
    Body: {
        Ring1_Init()
        Evdev_SetMouseBounds(Subtract(WBSPState.scr_w, 1), Subtract(WBSPState.scr_h, 1))
        opened = Discover_OpenAll()
        IfCondition EqualTo(opened, 0) ThenBlock: {
            PrintMessage("[FAIL] input\n")
            ReturnValue(0)
        }
        ReturnValue(1)
    }
}

// =============================================================================
// MAIN LOOP
// =============================================================================
Function.RunLoop {
    Output: Integer
    Body: {
        WBSPState.running = 1
        WhileLoop EqualTo(WBSPState.running, 1) {
            Evdev_Poll()
            quit = DrainRing1BSP()
            IfCondition EqualTo(quit, 1) ThenBlock: {
                WBSPState.running = 0
            }
            Compose_TickRing0()
            IfCondition EqualTo(WBSPState.dirty, 1) ThenBlock: {
                BlitAllSurfaces()
                WBSPState.dirty = 0
            }
        }
        ReturnValue(1)
    }
}

// =============================================================================
// SHUTDOWN
// =============================================================================
Function.Shutdown {
    Output: Integer
    Body: {
        Evdev_CloseAll()
        Compose_Shutdown()
        RenderFB_Shutdown()
        RestoreTTY()
        PrintMessage("[TestWindowBSP] DONE\n")
        ReturnValue(1)
    }
}

// =============================================================================
// ENTRY POINT
// =============================================================================
SubRoutine.Main {
    Arena_Init()
    PrintMessage("[TestWindowBSP] Phase 7b+font\n")
    InitFB()
    InitTTY()
    InitCompositor()
    InitFont()
    InitRootSurface()
    InitInput()
    BlitAllSurfaces()
    RunLoop()
    Shutdown()
}

RunTask(Main)