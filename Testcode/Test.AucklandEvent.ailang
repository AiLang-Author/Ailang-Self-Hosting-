// Test.AucklandEvent.ailang
// Standalone test: hit testing + state machine on Auckland tree.
// Builds tree, solves layout, simulates mouse events, checks states.
// Copyright © 2026 Sean Collins, 2 Paws Machine and Engineering. SCSL.

LibraryImport.Arena
LibraryImport.Display.Render.DSurfaceTypes
LibraryImport.Display.Render.DSurface
LibraryImport.Display.Render.DDrawPixel
LibraryImport.Display.Render.VIF
LibraryImport.Display.Render.SurfaceBlit
LibraryImport.Display.Render.Fonts
LibraryImport.Display.UI.TextRegion
LibraryImport.Display.UI.Auckland
LibraryImport.Display.UI.AucklandEvent

// =============================================================================
// HELPER — print test result
// =============================================================================
Function.TestCheck {
    Input: label: Address
    Input: got: Integer
    Input: expected: Integer
    Body: {
        IfCondition EqualTo(got, expected) ThenBlock: {
            PrintMessage("[PASS] ")
        } ElseBlock: {
            PrintMessage("[FAIL] ")
        }
        PrintMessage(label)
        PrintMessage(" got=")
        PrintNumber(got)
        PrintMessage(" expected=")
        PrintNumber(expected)
        PrintMessage("\n")
        ReturnValue(0)
    }
}

// =============================================================================
// MAIN
// =============================================================================
SubRoutine.Main {
    PrintMessage("=== Auckland Event Test ===\n")

    Arena_Init()
    VIF_Init()
    VFont_Init()
    TextRegion_Init()
    AK_Init()
    AKEvent_Init()

    // Load font
    ok = VFont_LoadVIF("fonts/DejaVuSans.vif")
    IfCondition EqualTo(ok, 0) ThenBlock: {
        PrintMessage("[FAIL] cannot load font\n")
    }
    IfCondition EqualTo(ok, 1) ThenBlock: {
        VFont_RasterAll(18)

        // Set up design size
        AKTree.design_w = 640
        AKTree.design_h = 480

        // Create canvas
        canvas_w = 640
        canvas_h = 480
        canvas = Surface_Create(SurfaceFormat.PIXEL_32, canvas_w, canvas_h)
        bg = TVG_PackColor(26, 58, 92, 255)
        Draw_Pix_FillRect(canvas, 0, 0, canvas_w, canvas_h, bg)
        AKTree.canvas = canvas

        // =============================================================
        // BUILD TREE — simple layout for hit testing
        //
        //  window (vbox, padding=16, gap=12)
        //    panel (bg, grow=1)
        //      label "Title"
        //    hbox (gap=8)
        //      btn_a "OK"       action="app.ok"
        //      btn_b "Cancel"   action="app.cancel"
        //      btn_c "Help"     action="app.help"
        // =============================================================

        win = AK_CreateNode(AKTag.WINDOW)
        AK_Set(win, AKF.LAYOUT_MODE, AKLayout.VBOX)
        AK_Set(win, AKF.PAD_T, 16)
        AK_Set(win, AKF.PAD_R, 16)
        AK_Set(win, AKF.PAD_B, 16)
        AK_Set(win, AKF.PAD_L, 16)
        AK_Set(win, AKF.GAP, 12)
        AK_SetRoot(win)

        // Panel
        panel = AK_CreateNode(AKTag.PANEL)
        AK_Set(panel, AKF.GROW, 1)
        AK_ExtraSet(panel, AKExtra.COLOR_BG, TVG_PackColor(42, 42, 62, 255))
        AK_AddChild(win, panel)

        // Label inside panel
        lbl = AK_CreateNode(AKTag.LABEL)
        AK_Set(lbl, AKF.HEIGHT, 24)
        AK_ExtraSet(lbl, AKExtra.STR_PTR, "Title")
        AK_ExtraSet(lbl, AKExtra.STR_LEN, 5)
        AK_ExtraSet(lbl, AKExtra.COLOR_FG, TVG_PackColor(255, 255, 255, 255))
        AK_AddChild(panel, lbl)

        // HBox for buttons
        hbox = AK_CreateNode(AKTag.GROUP)
        AK_Set(hbox, AKF.LAYOUT_MODE, AKLayout.HBOX)
        AK_Set(hbox, AKF.HEIGHT, 40)
        AK_Set(hbox, AKF.GAP, 8)
        AK_AddChild(win, hbox)

        // Button A — OK
        btn_a = AK_CreateNode(AKTag.BUTTON)
        AK_Set(btn_a, AKF.GROW, 1)
        AK_Set(btn_a, AKF.HEIGHT, 40)
        AK_ExtraSet(btn_a, AKExtra.STR_PTR, "OK")
        AK_ExtraSet(btn_a, AKExtra.STR_LEN, 2)
        AK_ExtraSet(btn_a, AKExtra.COLOR_FG, TVG_PackColor(255, 255, 255, 255))
        AK_ExtraSet(btn_a, AKExtra.COLOR_BG, TVG_PackColor(0, 120, 215, 255))
        AK_ExtraSet(btn_a, AKExtra.ACTION_PTR, "app.ok")
        AK_ExtraSet(btn_a, AKExtra.ACTION_LEN, 6)
        AK_AddChild(hbox, btn_a)

        // Button B — Cancel
        btn_b = AK_CreateNode(AKTag.BUTTON)
        AK_Set(btn_b, AKF.GROW, 1)
        AK_Set(btn_b, AKF.HEIGHT, 40)
        AK_ExtraSet(btn_b, AKExtra.STR_PTR, "Cancel")
        AK_ExtraSet(btn_b, AKExtra.STR_LEN, 6)
        AK_ExtraSet(btn_b, AKExtra.COLOR_FG, TVG_PackColor(255, 255, 255, 255))
        AK_ExtraSet(btn_b, AKExtra.COLOR_BG, TVG_PackColor(100, 100, 100, 255))
        AK_ExtraSet(btn_b, AKExtra.ACTION_PTR, "app.cancel")
        AK_ExtraSet(btn_b, AKExtra.ACTION_LEN, 10)
        AK_AddChild(hbox, btn_b)

        // Button C — Help
        btn_c = AK_CreateNode(AKTag.BUTTON)
        AK_Set(btn_c, AKF.GROW, 1)
        AK_Set(btn_c, AKF.HEIGHT, 40)
        AK_ExtraSet(btn_c, AKExtra.STR_PTR, "Help")
        AK_ExtraSet(btn_c, AKExtra.STR_LEN, 4)
        AK_ExtraSet(btn_c, AKExtra.COLOR_FG, TVG_PackColor(255, 255, 255, 255))
        AK_ExtraSet(btn_c, AKExtra.COLOR_BG, TVG_PackColor(80, 80, 80, 255))
        AK_ExtraSet(btn_c, AKExtra.ACTION_PTR, "app.help")
        AK_ExtraSet(btn_c, AKExtra.ACTION_LEN, 8)
        AK_AddChild(hbox, btn_c)

        // Solve layout
        AK_Solve(canvas_w, canvas_h)

        // Print solved rects for debugging
        PrintMessage("\n--- Solved Rects ---\n")
        PrintMessage("btn_a: x=") PrintNumber(AK_Get(btn_a, AKF.SOLVED_X))
        PrintMessage(" y=") PrintNumber(AK_Get(btn_a, AKF.SOLVED_Y))
        PrintMessage(" w=") PrintNumber(AK_Get(btn_a, AKF.SOLVED_W))
        PrintMessage(" h=") PrintNumber(AK_Get(btn_a, AKF.SOLVED_H))
        PrintMessage("\n")
        PrintMessage("btn_b: x=") PrintNumber(AK_Get(btn_b, AKF.SOLVED_X))
        PrintMessage(" y=") PrintNumber(AK_Get(btn_b, AKF.SOLVED_Y))
        PrintMessage(" w=") PrintNumber(AK_Get(btn_b, AKF.SOLVED_W))
        PrintMessage(" h=") PrintNumber(AK_Get(btn_b, AKF.SOLVED_H))
        PrintMessage("\n")
        PrintMessage("btn_c: x=") PrintNumber(AK_Get(btn_c, AKF.SOLVED_X))
        PrintMessage(" y=") PrintNumber(AK_Get(btn_c, AKF.SOLVED_Y))
        PrintMessage(" w=") PrintNumber(AK_Get(btn_c, AKF.SOLVED_W))
        PrintMessage(" h=") PrintNumber(AK_Get(btn_c, AKF.SOLVED_H))
        PrintMessage("\n")
        PrintMessage("label: x=") PrintNumber(AK_Get(lbl, AKF.SOLVED_X))
        PrintMessage(" y=") PrintNumber(AK_Get(lbl, AKF.SOLVED_Y))
        PrintMessage(" w=") PrintNumber(AK_Get(lbl, AKF.SOLVED_W))
        PrintMessage(" h=") PrintNumber(AK_Get(lbl, AKF.SOLVED_H))
        PrintMessage("\n\n")

        // =============================================================
        // TEST 1: Hit test empty space — should return -1
        // =============================================================
        PrintMessage("--- Test 1: Hit empty space ---\n")
        h1 = AK_HitTest(5, 5)
        TestCheck("empty space", h1, -1)

        // =============================================================
        // TEST 2: Hit test over btn_a center
        // btn_a should be at roughly x=16, y=424..464 (bottom of vbox)
        // We'll use the solved coords directly
        // =============================================================
        PrintMessage("\n--- Test 2: Hit btn_a ---\n")
        ba_x = AK_Get(btn_a, AKF.SOLVED_X)
        ba_y = AK_Get(btn_a, AKF.SOLVED_Y)
        ba_cx = Add(ba_x, 10)
        ba_cy = Add(ba_y, 10)
        h2 = AK_HitTest(ba_cx, ba_cy)
        TestCheck("hit btn_a", h2, btn_a)

        // =============================================================
        // TEST 3: Hit test over btn_b center
        // =============================================================
        PrintMessage("\n--- Test 3: Hit btn_b ---\n")
        bb_x = AK_Get(btn_b, AKF.SOLVED_X)
        bb_y = AK_Get(btn_b, AKF.SOLVED_Y)
        bb_cx = Add(bb_x, 10)
        bb_cy = Add(bb_y, 10)
        h3 = AK_HitTest(bb_cx, bb_cy)
        TestCheck("hit btn_b", h3, btn_b)

        // =============================================================
        // TEST 4: Hit test over label
        // =============================================================
        PrintMessage("\n--- Test 4: Hit label ---\n")
        lx = AK_Get(lbl, AKF.SOLVED_X)
        ly = AK_Get(lbl, AKF.SOLVED_Y)
        lcx = Add(lx, 10)
        lcy = Add(ly, 10)
        h4 = AK_HitTest(lcx, lcy)
        TestCheck("hit label", h4, lbl)

        // =============================================================
        // TEST 5: HOVER state machine — move over btn_a
        // =============================================================
        PrintMessage("\n--- Test 5: Hover btn_a ---\n")
        AK_EventMouse(ba_cx, ba_cy, AKMouseEv.MOVE)
        s5 = AK_Get(btn_a, AKF.STATE)
        TestCheck("btn_a state=HOVER", s5, AKState.HOVER)
        TestCheck("hover_node=btn_a", AKEvent.hover_node, btn_a)

        // =============================================================
        // TEST 6: Move to btn_b — btn_a goes NORMAL, btn_b goes HOVER
        // =============================================================
        PrintMessage("\n--- Test 6: Hover moves to btn_b ---\n")
        AK_EventMouse(bb_cx, bb_cy, AKMouseEv.MOVE)
        s6a = AK_Get(btn_a, AKF.STATE)
        s6b = AK_Get(btn_b, AKF.STATE)
        TestCheck("btn_a state=NORMAL", s6a, AKState.NORMAL)
        TestCheck("btn_b state=HOVER", s6b, AKState.HOVER)

        // =============================================================
        // TEST 7: PRESS btn_b — goes PRESSED
        // =============================================================
        PrintMessage("\n--- Test 7: Press btn_b ---\n")
        AK_EventMouse(bb_cx, bb_cy, AKMouseEv.DOWN)
        s7 = AK_Get(btn_b, AKF.STATE)
        TestCheck("btn_b state=PRESSED", s7, AKState.PRESSED)
        TestCheck("pressed_node=btn_b", AKEvent.pressed_node, btn_b)

        // =============================================================
        // TEST 8: RELEASE on btn_b — fires action, goes HOVER
        // Should print "[ACTION] app.cancel"
        // =============================================================
        PrintMessage("\n--- Test 8: Release on btn_b (click) ---\n")
        AK_EventMouse(bb_cx, bb_cy, AKMouseEv.UP)
        s8 = AK_Get(btn_b, AKF.STATE)
        TestCheck("btn_b state=HOVER", s8, AKState.HOVER)
        TestCheck("pressed_node cleared", AKEvent.pressed_node, -1)

        // =============================================================
        // TEST 9: PRESS btn_c, drag off, release outside — cancel
        // =============================================================
        PrintMessage("\n--- Test 9: Press btn_c, release outside ---\n")
        bc_x = AK_Get(btn_c, AKF.SOLVED_X)
        bc_y = AK_Get(btn_c, AKF.SOLVED_Y)
        bc_cx = Add(bc_x, 10)
        bc_cy = Add(bc_y, 10)

        // Move to btn_c first
        AK_EventMouse(bc_cx, bc_cy, AKMouseEv.MOVE)
        // Press
        AK_EventMouse(bc_cx, bc_cy, AKMouseEv.DOWN)
        s9a = AK_Get(btn_c, AKF.STATE)
        TestCheck("btn_c state=PRESSED", s9a, AKState.PRESSED)

        // Drag to empty space (should NOT print action)
        AK_EventMouse(5, 5, AKMouseEv.MOVE)
        // Release outside
        AK_EventMouse(5, 5, AKMouseEv.UP)
        s9b = AK_Get(btn_c, AKF.STATE)
        TestCheck("btn_c state=NORMAL (cancelled)", s9b, AKState.NORMAL)

        // =============================================================
        // TEST 10: Dirty tracking
        // =============================================================
        PrintMessage("\n--- Test 10: Dirty tracking ---\n")
        // Reset all dirty flags
        AK_Set(btn_a, AKF.DIRTY, 0)
        AK_Set(btn_b, AKF.DIRTY, 0)
        AK_Set(btn_c, AKF.DIRTY, 0)
        AK_Set(lbl, AKF.DIRTY, 0)
        AKEvent.dirty_count = 0

        // Hover btn_a — should mark dirty
        AK_EventMouse(ba_cx, ba_cy, AKMouseEv.MOVE)
        d10 = AK_Get(btn_a, AKF.DIRTY)
        TestCheck("btn_a dirty after hover", d10, 1)

        // Draw dirty — should clear flag
        drew = AK_DrawDirty(canvas)
        TestCheck("drew something", drew, 1)
        d10b = AK_Get(btn_a, AKF.DIRTY)
        TestCheck("btn_a clean after draw", d10b, 0)

        // =============================================================
        // VISUAL OUTPUT — render full tree for inspection
        // =============================================================
        PrintMessage("\n--- Rendering full tree ---\n")
        Draw_Pix_FillRect(canvas, 0, 0, canvas_w, canvas_h, bg)
        AK_DrawNode(AKTree.root)

        // Dump to file

        PrintMessage("\n=== Auckland Event Test Complete ===\n")
    }
}

RunTask(Main)