LibraryImport.XArrays
LibraryImport.VIF
LibraryImport.Fonts
LibraryImport.TextRegion
LibraryImport.Auckland
LibraryImport.AucklandEvent
LibraryImport.HTMLParse
LibraryImport.AucklandBind

FixedPool.TResult {
    "pass_count": Initialize=0, CanChange=True
    "fail_count": Initialize=0, CanChange=True
    "test_num":   Initialize=0, CanChange=True
}

Function.TR_Pass {
    Input: msg: Address
    Body: {
        TResult.test_num = Add(TResult.test_num, 1)
        TResult.pass_count = Add(TResult.pass_count, 1)
        PrintMessage("  PASS ")
        PrintNumber(TResult.test_num)
        PrintMessage(": ")
        PrintMessage(msg)
        PrintMessage("\n")
    }
}

Function.TR_Fail {
    Input: msg: Address
    Body: {
        TResult.test_num = Add(TResult.test_num, 1)
        TResult.fail_count = Add(TResult.fail_count, 1)
        PrintMessage("  FAIL ")
        PrintNumber(TResult.test_num)
        PrintMessage(": ")
        PrintMessage(msg)
        PrintMessage("\n")
    }
}

Function.TR_Check {
    Input: cond: Integer
    Input: msg: Address
    Body: {
        IfCondition EqualTo(cond, 1) ThenBlock: {
            TR_Pass(msg)
        }
        IfCondition NotEqual(cond, 1) ThenBlock: {
            TR_Fail(msg)
        }
    }
}

Function.TR_CheckEqual {
    Input: actual: Integer
    Input: expected: Integer
    Input: msg: Address
    Body: {
        IfCondition EqualTo(actual, expected) ThenBlock: {
            TR_Pass(msg)
        }
        IfCondition NotEqual(actual, expected) ThenBlock: {
            TR_Fail(msg)
            PrintMessage("    expected=")
            PrintNumber(expected)
            PrintMessage(" actual=")
            PrintNumber(actual)
            PrintMessage("\n")
        }
    }
}

// =============================================================================
// TEST 1: HTML Lexer — simple self-closing tag
// =============================================================================
SubRoutine.Test1_LexSelfClose {
    PrintMessage("\n=== TEST 1: Lex self-closing tag ===\n")
    HTML_Init()
    
    src1 = "<button label=\"OK\" />"
    len1 = StringLength(src1)
    result1 = HTML_Tokenize(src1, len1)
    
    TR_Check(result1, "Tokenize returns success")
    
    // Expect: TAG_OPEN, ATTR_NAME, ATTR_VALUE, TAG_SELF_CLOSE, EOF
    t1_count = HTokTable.count
    TR_CheckEqual(t1_count, 5, "Token count = 5")
    
    t1_t0 = HTML_TokGet(0, HTokField.TYPE)
    TR_CheckEqual(t1_t0, HTok.TAG_OPEN, "Token 0 = TAG_OPEN")
    
    t1_t1 = HTML_TokGet(1, HTokField.TYPE)
    TR_CheckEqual(t1_t1, HTok.ATTR_NAME, "Token 1 = ATTR_NAME")
    
    t1_t2 = HTML_TokGet(2, HTokField.TYPE)
    TR_CheckEqual(t1_t2, HTok.ATTR_VALUE, "Token 2 = ATTR_VALUE")
    
    t1_t3 = HTML_TokGet(3, HTokField.TYPE)
    TR_CheckEqual(t1_t3, HTok.TAG_SELF_CLOSE, "Token 3 = TAG_SELF_CLOSE")
    
    t1_t4 = HTML_TokGet(4, HTokField.TYPE)
    TR_CheckEqual(t1_t4, HTok.EOF, "Token 4 = EOF")
    
    // Check tag name
    t1_name = HTML_TokGet(0, HTokField.PTR)
    t1_cmp = StringCompare(t1_name, "button")
    TR_CheckEqual(t1_cmp, 0, "Tag name = 'button'")
}

// =============================================================================
// TEST 2: HTML Lexer — open/close pair
// =============================================================================
SubRoutine.Test2_LexOpenClose {
    PrintMessage("\n=== TEST 2: Lex open/close pair ===\n")
    HTML_Reset()
    
    src2 = "<group layout=\"hbox\"></group>"
    len2 = StringLength(src2)
    result2 = HTML_Tokenize(src2, len2)
    
    TR_Check(result2, "Tokenize returns success")
    
    // TAG_OPEN, ATTR_NAME, ATTR_VALUE, TAG_END, TAG_CLOSE, EOF
    TR_CheckEqual(HTokTable.count, 6, "Token count = 6")
    
    t2_t0 = HTML_TokGet(0, HTokField.TYPE)
    TR_CheckEqual(t2_t0, HTok.TAG_OPEN, "Token 0 = TAG_OPEN")
    
    t2_t3 = HTML_TokGet(3, HTokField.TYPE)
    TR_CheckEqual(t2_t3, HTok.TAG_END, "Token 3 = TAG_END")
    
    t2_t4 = HTML_TokGet(4, HTokField.TYPE)
    TR_CheckEqual(t2_t4, HTok.TAG_CLOSE, "Token 4 = TAG_CLOSE")
}

// =============================================================================
// TEST 3: HTML Parser — nested elements
// =============================================================================
SubRoutine.Test3_ParseNested {
    PrintMessage("\n=== TEST 3: Parse nested elements ===\n")
    HTML_Reset()
    
    src3 = "<panel bg=\"#111\"><label text=\"Hello\" /><button label=\"OK\" /></panel>"
    len3 = StringLength(src3)
    
    lex3 = HTML_Tokenize(src3, len3)
    TR_Check(lex3, "Tokenize nested markup")
    
    root3 = HTML_Parse()
    TR_Check(GreaterEqual(root3, 0), "Parse returns valid root")
    
    // Root has 1 child (panel)
    rc3 = HTML_GetChildCount(root3)
    TR_CheckEqual(rc3, 1, "Root has 1 child")
    
    // Panel has 2 children
    panel3 = HTML_GetFirstChild(root3)
    pc3 = HTML_GetChildCount(panel3)
    TR_CheckEqual(pc3, 2, "Panel has 2 children")
    
    // First child is label
    label3 = HTML_GetFirstChild(panel3)
    label3_name = HTML_GetTagName(label3)
    l3_cmp = StringCompare(label3_name, "label")
    TR_CheckEqual(l3_cmp, 0, "First child is 'label'")
    
    // Second child is button
    btn3 = HTML_GetNextSibling(label3)
    btn3_name = HTML_GetTagName(btn3)
    b3_cmp = StringCompare(btn3_name, "button")
    TR_CheckEqual(b3_cmp, 0, "Second child is 'button'")
}

// =============================================================================
// TEST 4: HTML Parser — attribute retrieval
// =============================================================================
SubRoutine.Test4_Attributes {
    PrintMessage("\n=== TEST 4: Attribute retrieval ===\n")
    HTML_Reset()
    
    src4 = "<button label=\"Submit\" action=\"form.submit\" bg=\"#FF6B6B\" />"
    len4 = StringLength(src4)
    HTML_Tokenize(src4, len4)
    root4 = HTML_Parse()
    
    btn4 = HTML_GetFirstChild(root4)
    
    lbl4 = HTML_GetAttr(btn4, "label")
    lbl4_cmp = StringCompare(lbl4, "Submit")
    TR_CheckEqual(lbl4_cmp, 0, "label attr = 'Submit'")
    
    act4 = HTML_GetAttr(btn4, "action")
    act4_cmp = StringCompare(act4, "form.submit")
    TR_CheckEqual(act4_cmp, 0, "action attr = 'form.submit'")
    
    bg4 = HTML_GetAttr(btn4, "bg")
    bg4_cmp = StringCompare(bg4, "#FF6B6B")
    TR_CheckEqual(bg4_cmp, 0, "bg attr = '#FF6B6B'")
}

// =============================================================================
// TEST 5: Color parser
// =============================================================================
SubRoutine.Test5_ColorParser {
    PrintMessage("\n=== TEST 5: Color parser ===\n")
    
    // #FFF → white (255,255,255,255)
    c_white = AKBind_ParseColor("#FFF")
    c_white_exp = TVG_PackColor(255, 255, 255, 255)
    TR_CheckEqual(c_white, c_white_exp, "#FFF = white")
    
    // #000 → black
    c_black = AKBind_ParseColor("#000")
    c_black_exp = TVG_PackColor(0, 0, 0, 255)
    TR_CheckEqual(c_black, c_black_exp, "#000 = black")
    
    // #FF6B6B → salmon
    c_salmon = AKBind_ParseColor("#FF6B6B")
    c_salmon_exp = TVG_PackColor(255, 107, 107, 255)
    TR_CheckEqual(c_salmon, c_salmon_exp, "#FF6B6B = salmon")
    
    // #1A1A2EFF → with alpha
    c_alpha = AKBind_ParseColor("#1A1A2EFF")
    c_alpha_exp = TVG_PackColor(26, 26, 46, 255)
    TR_CheckEqual(c_alpha, c_alpha_exp, "#1A1A2EFF = dark blue, full alpha")
}

// =============================================================================
// TEST 6: Int parser
// =============================================================================
SubRoutine.Test6_IntParser {
    PrintMessage("\n=== TEST 6: Int parser ===\n")
    
    v_zero = AKBind_ParseInt("0")
    TR_CheckEqual(v_zero, 0, "Parse '0' = 0")
    
    v_42 = AKBind_ParseInt("42")
    TR_CheckEqual(v_42, 42, "Parse '42' = 42")
    
    v_360 = AKBind_ParseInt("360")
    TR_CheckEqual(v_360, 360, "Parse '360' = 360")
    
    v_neg = AKBind_ParseInt("-10")
    TR_CheckEqual(v_neg, -10, "Parse '-10' = -10")
}

// =============================================================================
// TEST 7: Full pipeline — markup → AK tree
// =============================================================================
SubRoutine.Test7_FullBind {
    PrintMessage("\n=== TEST 7: Full pipeline — markup to AK tree ===\n")
    
    // Init Auckland
    VIF_Init()
    VFont_Init()
    TextRegion_Init()
    AK_Init()
    AKEvent_Init()
    VFont_LoadVIF("fonts/DejaVuSans.vif")
    VFont_RasterAll(18)
    
    // Reset HTML parser and load from file
    HTML_Reset()
    root7 = AKParse_File("markup/test_parse.html")
    TR_Check(GreaterEqual(root7, 0), "AKParse_File returns valid root")
    
    IfCondition LessThan(root7, 0) ThenBlock: {
        TR_Fail("Skipping remaining Test 7 checks — parse failed")
        ReturnValue(0)
    }
    
    // Root is window
    root7_tag = AK_Get(root7, AKF.TAG)
    TR_CheckEqual(root7_tag, AKTag.WINDOW, "Root tag = WINDOW")
    
    // Design size was applied
    TR_CheckEqual(AKTree.design_w, 320, "design_w = 320")
    TR_CheckEqual(AKTree.design_h, 240, "design_h = 240")
    
    // Root has 2 children (panel, group)
    root7_cc = AK_Get(root7, AKF.CHILD_COUNT)
    TR_CheckEqual(root7_cc, 2, "Root has 2 children")
    
    // First child is panel
    panel7 = AK_Get(root7, AKF.FIRST_CHILD)
    panel7_tag = AK_Get(panel7, AKF.TAG)
    TR_CheckEqual(panel7_tag, AKTag.PANEL, "First child = PANEL")
    
    // Panel has padding=8 on all sides
    p7_pt = AK_Get(panel7, AKF.PAD_T)
    TR_CheckEqual(p7_pt, 8, "Panel pad_t = 8")
    p7_pl = AK_Get(panel7, AKF.PAD_L)
    TR_CheckEqual(p7_pl, 8, "Panel pad_l = 8")
    
    // Panel has 1 child (label)
    panel7_cc = AK_Get(panel7, AKF.CHILD_COUNT)
    TR_CheckEqual(panel7_cc, 1, "Panel has 1 child")
    
    // Second child of root is group
    group7 = AK_Get(panel7, AKF.NEXT_SIBLING)
    group7_tag = AK_Get(group7, AKF.TAG)
    TR_CheckEqual(group7_tag, AKTag.GROUP, "Second child = GROUP")
    
    // Group layout is HBOX
    group7_lm = AK_Get(group7, AKF.LAYOUT_MODE)
    TR_CheckEqual(group7_lm, AKLayout.HBOX, "Group layout = HBOX")
    
    // Group gap = 4
    group7_gap = AK_Get(group7, AKF.GAP)
    TR_CheckEqual(group7_gap, 4, "Group gap = 4")
    
    // Group has 2 buttons
    group7_cc = AK_Get(group7, AKF.CHILD_COUNT)
    TR_CheckEqual(group7_cc, 2, "Group has 2 children")
    
    // First button grow=1
    btn7a = AK_Get(group7, AKF.FIRST_CHILD)
    btn7a_grow = AK_Get(btn7a, AKF.GROW)
    TR_CheckEqual(btn7a_grow, 1, "Button A grow = 1")
    
    // Button A has label "A"
    btn7a_str = AK_ExtraGet(btn7a, AKExtra.STR_PTR)
    btn7a_cmp = StringCompare(btn7a_str, "A")
    TR_CheckEqual(btn7a_cmp, 0, "Button A label = 'A'")
    
    // Button A has action
    btn7a_act = AK_ExtraGet(btn7a, AKExtra.ACTION_PTR)
    btn7a_act_cmp = StringCompare(btn7a_act, "test.a")
    TR_CheckEqual(btn7a_act_cmp, 0, "Button A action = 'test.a'")
}

// =============================================================================
// TEST 8: Comment handling
// =============================================================================
SubRoutine.Test8_Comments {
    PrintMessage("\n=== TEST 8: Comment handling ===\n")
    HTML_Reset()
    
    src8 = "<!-- This is a comment --><label text=\"After\" />"
    len8 = StringLength(src8)
    HTML_Tokenize(src8, len8)
    root8 = HTML_Parse()
    
    TR_Check(GreaterEqual(root8, 0), "Parse with comment succeeds")
    
    rc8 = HTML_GetChildCount(root8)
    TR_CheckEqual(rc8, 1, "Root has 1 child (comment skipped)")
}

// =============================================================================
// TEST 9: Tag name mapping
// =============================================================================
SubRoutine.Test9_TagMapping {
    PrintMessage("\n=== TEST 9: Tag name → AKTag mapping ===\n")
    
    TR_CheckEqual(AKBind_TagNameToAKTag("window"), AKTag.WINDOW, "window → WINDOW")
    TR_CheckEqual(AKBind_TagNameToAKTag("button"), AKTag.BUTTON, "button → BUTTON")
    TR_CheckEqual(AKBind_TagNameToAKTag("label"), AKTag.LABEL, "label → LABEL")
    TR_CheckEqual(AKBind_TagNameToAKTag("panel"), AKTag.PANEL, "panel → PANEL")
    TR_CheckEqual(AKBind_TagNameToAKTag("group"), AKTag.GROUP, "group → GROUP")
    TR_CheckEqual(AKBind_TagNameToAKTag("spacer"), AKTag.SPACER, "spacer → SPACER")
    TR_CheckEqual(AKBind_TagNameToAKTag("separator"), AKTag.SEPARATOR, "separator → SEPARATOR")
    TR_CheckEqual(AKBind_TagNameToAKTag("checkbox"), AKTag.CHECKBOX, "checkbox → CHECKBOX")
    TR_CheckEqual(AKBind_TagNameToAKTag("slider"), AKTag.SLIDER, "slider → SLIDER")
    TR_CheckEqual(AKBind_TagNameToAKTag("canvas"), AKTag.CANVAS, "canvas → CANVAS")
}

// =============================================================================
// TEST 10: HTML_GetAttr on missing attribute
// =============================================================================
SubRoutine.Test10_MissingAttr {
    PrintMessage("\n=== TEST 10: Missing attribute returns 0 ===\n")
    HTML_Reset()
    
    src10 = "<button label=\"X\" />"
    len10 = StringLength(src10)
    HTML_Tokenize(src10, len10)
    root10 = HTML_Parse()
    
    btn10 = HTML_GetFirstChild(root10)
    missing10 = HTML_GetAttr(btn10, "nonexistent")
    TR_CheckEqual(missing10, 0, "Missing attr returns 0")
}

// =============================================================================
// RUN ALL
// =============================================================================
SubRoutine.RunAll {
    PrintMessage("========================================\n")
    PrintMessage("  Auckland Parse — Test Suite\n")
    PrintMessage("========================================\n")
    
    RunTask(Test1_LexSelfClose)
    RunTask(Test2_LexOpenClose)
    RunTask(Test3_ParseNested)
    RunTask(Test4_Attributes)
    RunTask(Test5_ColorParser)
    RunTask(Test6_IntParser)
    RunTask(Test7_FullBind)
    RunTask(Test8_Comments)
    RunTask(Test9_TagMapping)
    RunTask(Test10_MissingAttr)
    
    PrintMessage("\n========================================\n")
    PrintMessage("  Results: ")
    PrintNumber(TResult.pass_count)
    PrintMessage(" PASS, ")
    PrintNumber(TResult.fail_count)
    PrintMessage(" FAIL\n")
    PrintMessage("========================================\n")
}

RunTask(RunAll)