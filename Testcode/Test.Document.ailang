LibraryImport.Arena
LibraryImport.Display.Render.DSurfaceTypes
LibraryImport.Display.Render.DSurface
LibraryImport.Display.Render.DDrawPixel
LibraryImport.Display.Render.VIF
LibraryImport.Display.Render.SurfaceBlit
LibraryImport.Display.Render.Fonts
LibraryImport.Display.UI.TextRegion
LibraryImport.XArrays
LibraryImport.Display.Content.PageSurface
LibraryImport.Display.Content.Document

FixedPool.TResult {
    "pass_count": Initialize=0, CanChange=True
    "fail_count": Initialize=0, CanChange=True
    "test_num":   Initialize=0, CanChange=True
}

Function.TR_Pass {
    Input: msg: Address
    Body: {
        TResult.test_num = Add(TResult.test_num, 1)
        TResult.pass_count = Add(TResult.pass_count, 1)
        PrintMessage("  PASS ")
        PrintNumber(TResult.test_num)
        PrintMessage(": ")
        PrintMessage(msg)
        PrintMessage("\n")
    }
}

Function.TR_Fail {
    Input: msg: Address
    Body: {
        TResult.test_num = Add(TResult.test_num, 1)
        TResult.fail_count = Add(TResult.fail_count, 1)
        PrintMessage("  FAIL ")
        PrintNumber(TResult.test_num)
        PrintMessage(": ")
        PrintMessage(msg)
        PrintMessage("\n")
    }
}

Function.TR_Check {
    Input: cond: Integer
    Input: msg: Address
    Body: {
        IfCondition EqualTo(cond, 1) ThenBlock: {
            TR_Pass(msg)
        }
        IfCondition NotEqual(cond, 1) ThenBlock: {
            TR_Fail(msg)
        }
    }
}

Function.TR_CheckEqual {
    Input: actual: Integer
    Input: expected: Integer
    Input: msg: Address
    Body: {
        IfCondition EqualTo(actual, expected) ThenBlock: {
            TR_Pass(msg)
        }
        IfCondition NotEqual(actual, expected) ThenBlock: {
            TR_Fail(msg)
            PrintMessage("    expected=")
            PrintNumber(expected)
            PrintMessage(" actual=")
            PrintNumber(actual)
            PrintMessage("\n")
        }
    }
}

// =============================================================================
// TEST 1: PageSurface — Letter at 96 DPI
// =============================================================================
SubRoutine.Test1_LetterPage {
    PrintMessage("\n=== TEST 1: Letter page at 96 DPI ===\n")

    p1 = PageSurface_Create(PaperType.LETTER, PageOrient.PORTRAIT, 96)
    TR_Check(GreaterEqual(p1, 0), "Letter page created")

    // 8.5 * 96 = 816, 11 * 96 = 1056
    p1_w = PageSurface_GetWidth(p1)
    TR_CheckEqual(p1_w, 816, "Width = 816")

    p1_h = PageSurface_GetHeight(p1)
    TR_CheckEqual(p1_h, 1056, "Height = 1056")

    p1_dpi = PageSurface_GetDPI(p1)
    TR_CheckEqual(p1_dpi, 96, "DPI = 96")

    p1_surf = PageSurface_GetSurface(p1)
    TR_Check(NotEqual(p1_surf, 0), "Surface handle valid")

    // Default margins = 1 inch = 96px at 96 DPI
    p1_cx = PageSurface_GetContentX(p1)
    TR_CheckEqual(p1_cx, 96, "Content X = 96 (1 inch margin)")

    p1_cy = PageSurface_GetContentY(p1)
    TR_CheckEqual(p1_cy, 96, "Content Y = 96")

    // Content width = 816 - 96 - 96 = 624
    p1_cw = PageSurface_GetContentW(p1)
    TR_CheckEqual(p1_cw, 624, "Content W = 624")

    // Content height = 1056 - 96 - 96 = 864
    p1_ch = PageSurface_GetContentH(p1)
    TR_CheckEqual(p1_ch, 864, "Content H = 864")
}

// =============================================================================
// TEST 2: A4 Landscape at 150 DPI
// =============================================================================
SubRoutine.Test2_A4Landscape {
    PrintMessage("\n=== TEST 2: A4 Landscape at 150 DPI ===\n")

    p2 = PageSurface_Create(PaperType.A4, PageOrient.LANDSCAPE, 150)
    TR_Check(GreaterEqual(p2, 0), "A4 landscape created")

    // A4 landscape: 11.69 x 8.27 inches
    // 11.69 * 150 = 1753.5 -> 1753, 8.27 * 150 = 1240.5 -> 1240
    p2_w = PageSurface_GetWidth(p2)
    TR_CheckEqual(p2_w, 1753, "Width = 1753")

    p2_h = PageSurface_GetHeight(p2)
    TR_CheckEqual(p2_h, 1240, "Height = 1240")
}

// =============================================================================
// TEST 3: Legal at default DPI
// =============================================================================
SubRoutine.Test3_Legal {
    PrintMessage("\n=== TEST 3: Legal at default DPI ===\n")

    p3 = PageSurface_Create(PaperType.LEGAL, PageOrient.PORTRAIT, 0)
    TR_Check(GreaterEqual(p3, 0), "Legal page created with default DPI")

    p3_dpi = PageSurface_GetDPI(p3)
    TR_CheckEqual(p3_dpi, 96, "Default DPI = 96")

    // 8.5 * 96 = 816, 14 * 96 = 1344
    p3_w = PageSurface_GetWidth(p3)
    TR_CheckEqual(p3_w, 816, "Width = 816")

    p3_h = PageSurface_GetHeight(p3)
    TR_CheckEqual(p3_h, 1344, "Height = 1344")
}

// =============================================================================
// TEST 4: Free canvas
// =============================================================================
SubRoutine.Test4_Free {
    PrintMessage("\n=== TEST 4: Free canvas ===\n")

    p4 = PageSurface_CreateFree(640, 480, 96)
    TR_Check(GreaterEqual(p4, 0), "Free page created")

    p4_w = PageSurface_GetWidth(p4)
    TR_CheckEqual(p4_w, 640, "Width = 640")

    p4_h = PageSurface_GetHeight(p4)
    TR_CheckEqual(p4_h, 480, "Height = 480")

    // Free pages have no margins
    p4_cx = PageSurface_GetContentX(p4)
    TR_CheckEqual(p4_cx, 0, "Content X = 0 (no margin)")

    p4_cw = PageSurface_GetContentW(p4)
    TR_CheckEqual(p4_cw, 640, "Content W = 640 (full width)")
}

// =============================================================================
// TEST 5: Set margins in points
// =============================================================================
SubRoutine.Test5_Margins {
    PrintMessage("\n=== TEST 5: Set margins in points ===\n")

    p5 = PageSurface_Create(PaperType.LETTER, PageOrient.PORTRAIT, 72)
    TR_Check(GreaterEqual(p5, 0), "Letter at 72 DPI created")

    // At 72 DPI, 72 points = 72 pixels (1 inch)
    PageSurface_SetMargins(p5, 72, 72, 72, 72)

    p5_cx = PageSurface_GetContentX(p5)
    TR_CheckEqual(p5_cx, 72, "Margin left = 72px (1 inch at 72dpi)")

    // Half inch margins: 36 points
    PageSurface_SetMargins(p5, 36, 36, 36, 36)

    p5_cx2 = PageSurface_GetContentX(p5)
    TR_CheckEqual(p5_cx2, 36, "Half inch margin = 36px at 72dpi")
}

// =============================================================================
// TEST 6: Point size to pixel conversion
// =============================================================================
SubRoutine.Test6_PointConvert {
    PrintMessage("\n=== TEST 6: Point to pixel conversion ===\n")

    p6 = PageSurface_Create(PaperType.LETTER, PageOrient.PORTRAIT, 96)

    // 12pt at 96dpi = 12 * 96 / 72 = 16px
    px12 = PageSurface_PointsToPixels(p6, 12)
    TR_CheckEqual(px12, 16, "12pt at 96dpi = 16px")

    // 72pt at 96dpi = 72 * 96 / 72 = 96px (1 inch)
    px72 = PageSurface_PointsToPixels(p6, 72)
    TR_CheckEqual(px72, 96, "72pt at 96dpi = 96px")
}

// =============================================================================
// TEST 7: Document — create and add pages
// =============================================================================
SubRoutine.Test7_DocCreate {
    PrintMessage("\n=== TEST 7: Document create ===\n")

    doc1 = Doc_Create(PaperType.LETTER, PageOrient.PORTRAIT, 96)
    TR_Check(GreaterEqual(doc1, 0), "Document created")

    // Should have 1 page automatically
    pc1 = Doc_GetPageCount(doc1)
    TR_CheckEqual(pc1, 1, "Auto-created first page")

    // Get first page
    page0 = Doc_GetPage(doc1, 0)
    TR_Check(GreaterEqual(page0, 0), "First page accessible")

    // Page is Letter 96dpi
    pw1 = PageSurface_GetWidth(page0)
    TR_CheckEqual(pw1, 816, "First page width = 816")

    // Add second page
    page1_idx = Doc_AddPage(doc1)
    TR_Check(GreaterEqual(page1_idx, 0), "Second page added")

    pc2 = Doc_GetPageCount(doc1)
    TR_CheckEqual(pc2, 2, "Page count = 2")
}

// =============================================================================
// TEST 8: Document — cursor and surface access
// =============================================================================
SubRoutine.Test8_DocCursor {
    PrintMessage("\n=== TEST 8: Document cursor ===\n")

    doc2 = Doc_Create(PaperType.A4, PageOrient.PORTRAIT, 96)
    TR_Check(GreaterEqual(doc2, 0), "A4 doc created")

    surf2 = Doc_GetCurrentSurface(doc2)
    TR_Check(NotEqual(surf2, 0), "Current surface valid")

    // Initial cursor at 0
    cy2 = Doc_GetCursorY(doc2)
    TR_CheckEqual(cy2, 0, "Initial cursor Y = 0")

    // Set cursor
    Doc_SetCursorY(doc2, 200)
    cy2b = Doc_GetCursorY(doc2)
    TR_CheckEqual(cy2b, 200, "Cursor Y = 200 after set")
}

// =============================================================================
// TEST 9: Document — write text (requires font)
// =============================================================================
SubRoutine.Test9_DocWrite {
    PrintMessage("\n=== TEST 9: Document write text ===\n")

    doc3 = Doc_Create(PaperType.LETTER, PageOrient.PORTRAIT, 96)
    TR_Check(GreaterEqual(doc3, 0), "Letter doc created")

    white = TVG_PackColor(0, 0, 0, 255)
    result3 = Doc_WriteText(doc3, "Hello Document!", 15, white)
    TR_CheckEqual(result3, 1, "WriteText returned 1")

    // Cursor should have advanced
    cy3 = Doc_GetCursorY(doc3)
    TR_Check(GreaterThan(cy3, 0), "Cursor Y advanced after write")
}

// =============================================================================
// RUN ALL
// =============================================================================
SubRoutine.RunAll {
    PrintMessage("========================================\n")
    PrintMessage("  PageSurface + Document - Test Suite\n")
    PrintMessage("========================================\n")

    Arena_Init()
    VIF_Init()
    VFont_Init()
    TextRegion_Init()
    VFont_LoadVIF("fonts/DejaVuSans.vif")
    VFont_RasterAll(18)
    PageSurface_Init()
    Doc_Init()

    RunTask(Test1_LetterPage)
    RunTask(Test2_A4Landscape)
    RunTask(Test3_Legal)
    RunTask(Test4_Free)
    RunTask(Test5_Margins)
    RunTask(Test6_PointConvert)
    RunTask(Test7_DocCreate)
    RunTask(Test8_DocCursor)
    RunTask(Test9_DocWrite)

    PrintMessage("\n========================================\n")
    PrintMessage("  Results: ")
    PrintNumber(TResult.pass_count)
    PrintMessage(" PASS, ")
    PrintNumber(TResult.fail_count)
    PrintMessage(" FAIL\n")
    PrintMessage("========================================\n")
}

RunTask(RunAll)