// TestCompose.ailang
// Phase 4: stack groups and floating windows

LibraryImport.Arena
LibraryImport.DComposeTypes
LibraryImport.DComposeBSP
LibraryImport.DComposeStack
LibraryImport.DComposeFloat

SubRoutine.Main {
    PrintMessage("TestCompose: stack + float tests\n")

    // Init BSP
    root = BSP_Init(1280, 1024)

    // =========================================================
    // TEST 1: Create stack group on root leaf
    // =========================================================
    PrintMessage("1: create stack group on root\n")
    sg = Stack_Create(root, 0)
    IfCondition EqualTo(sg, 0) ThenBlock: {
        PrintMessage("FAIL: Stack_Create returned 0\n")
        ReturnValue(0)
    }
    PrintMessage("   count: ")
    PrintNumber(Stack_GetCount(sg))
    PrintMessage("\n   active: ")
    PrintNumber(Stack_GetActiveIndex(sg))
    PrintMessage("\n")

    // =========================================================
    // TEST 2: Add surfaces to stack
    // =========================================================
    PrintMessage("2: add 3 surfaces\n")
    Stack_Add(sg, 1001, 0)
    Stack_Add(sg, 1002, 0)
    Stack_Add(sg, 1003, 0)
    PrintMessage("   count: ")
    PrintNumber(Stack_GetCount(sg))
    PrintMessage("\n   active index (expect 2): ")
    PrintNumber(Stack_GetActiveIndex(sg))
    PrintMessage("\n   active surface (expect 1003): ")
    PrintNumber(Stack_GetActiveSurface(sg))
    PrintMessage("\n")

    // =========================================================
    // TEST 3: Switch tabs
    // =========================================================
    PrintMessage("3: switch to tab 0\n")
    Stack_Switch(sg, 0)
    PrintMessage("   active surface (expect 1001): ")
    PrintNumber(Stack_GetActiveSurface(sg))
    PrintMessage("\n")

    // =========================================================
    // TEST 4: Remove middle tab
    // =========================================================
    PrintMessage("4: remove tab 1 (surface 1002)\n")
    Stack_Remove(sg, 1)
    PrintMessage("   count (expect 2): ")
    PrintNumber(Stack_GetCount(sg))
    PrintMessage("\n   surface[0] (expect 1001): ")
    PrintNumber(Stack_GetSurface(sg, 0))
    PrintMessage("\n   surface[1] (expect 1003): ")
    PrintNumber(Stack_GetSurface(sg, 1))
    PrintMessage("\n")

    // =========================================================
    // TEST 5: Float windows
    // =========================================================
    PrintMessage("5: float init + add windows\n")
    Compositor.screen_w = Add(1280, 65536)
    Compositor.screen_h = Add(1024, 65536)
    Float_Init()

    idx_a = Float_Add(2001, 100, 200, 400, 300)
    idx_b = Float_Add(2002, 500, 400, 300, 200)
    PrintMessage("   float count (expect 2): ")
    PrintNumber(Float_GetCount())
    PrintMessage("\n   idx_a: ")
    PrintNumber(idx_a)
    PrintMessage(" idx_b: ")
    PrintNumber(idx_b)
    PrintMessage("\n")

    // =========================================================
    // TEST 6: Float hit test
    // =========================================================
    PrintMessage("6: hit test floats\n")
    hit = Float_HitTest(250, 300)
    PrintMessage("   (250,300) hit (expect 0): ")
    PrintNumber(hit)
    PrintMessage("\n")
    hit = Float_HitTest(600, 500)
    PrintMessage("   (600,500) hit (expect 1): ")
    PrintNumber(hit)
    PrintMessage("\n")
    hit = Float_HitTest(10, 10)
    PrintMessage("   (10,10) hit (expect -1): ")
    PrintNumber(hit)
    PrintMessage("\n")

    // =========================================================
    // TEST 7: Float move + clamp
    // =========================================================
    PrintMessage("7: move float out of bounds\n")
    Float_Move(0, 1200, 900)
    ptr = Float_EntryPtr(0)
    PrintMessage("   clamped x (expect <=880): ")
    PrintNumber(Subtract(Dereference(Add(ptr, FloatEntryFields.X)), 65536))
    PrintMessage("\n   clamped y (expect <=724): ")
    PrintNumber(Subtract(Dereference(Add(ptr, FloatEntryFields.Y)), 65536))
    PrintMessage("\n")

    // =========================================================
    // TEST 8: Float remove
    // =========================================================
    PrintMessage("8: remove float 0\n")
    Float_Remove(0)
    PrintMessage("   count (expect 1): ")
    PrintNumber(Float_GetCount())
    PrintMessage("\n")

    // Cleanup
    Stack_Destroy(sg)
    Float_Shutdown()
    BSP_Free(root)

    PrintMessage("TestCompose: all tests done\n")
}

RunTask(Main)