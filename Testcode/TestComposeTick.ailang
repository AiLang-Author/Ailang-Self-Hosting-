// TestComposeTick.ailang
// Phase 4: compositor tick loop — Ring2 → dirty → Ring3

LibraryImport.DSurfaceTypes
LibraryImport.DSurface
LibraryImport.Framebuffer
LibraryImport.DDrawCell
LibraryImport.DRingTypes
LibraryImport.DRing
LibraryImport.DRing0
LibraryImport.DRing1
LibraryImport.DRing2
LibraryImport.DRing3
LibraryImport.DComposeTypes
LibraryImport.DComposeBSP
LibraryImport.DComposeStack
LibraryImport.DComposeFloat
LibraryImport.DCompose

SubRoutine.Main {
    PrintMessage("TestComposeTick: compositor tick loop\n")

    // Init compositor 80x24 cell surface
    result = Compose_Init(80, 24)
    IfCondition EqualTo(result, 0) ThenBlock: {
        PrintMessage("FAIL: Compose_Init\n")
        ReturnValue(0)
    }

    // Create a cell surface
    surf = Surface_Create(SurfaceFormat.CELL_32, 80, 24)
    IfCondition EqualTo(surf, 0) ThenBlock: {
        PrintMessage("FAIL: Surface_Create\n")
        ReturnValue(0)
    }

    // Draw something into the surface
    Draw_FillRect(surf, 0, 0, 80, 24, 32, Color16.WHITE, Color16.BLUE)
    Draw_Text(surf, 2, 2, "Compositor tick test", Color16.BRIGHT_GREEN, Color16.BLUE)

    // =========================================================
    // TEST 1: Ring3 starts clean
    // =========================================================
    PrintMessage("1: Ring3 starts clean\n")
    PrintMessage("   dirty (expect 0): ")
    PrintNumber(Ring3_IsDirty())
    PrintMessage("\n")

    // =========================================================
    // TEST 2: Post draw command to Ring2
    // =========================================================
    PrintMessage("2: post draw command\n")
    Ring2_Post(Ring2Cmd.FILL_RECT, surf, 0, 0)
    PrintMessage("   Ring2 count (expect 1): ")
    PrintNumber(Ring2_Count())
    PrintMessage("\n")

    // =========================================================
    // TEST 3: Tick Ring2 — should drain and mark dirty
    // =========================================================
    PrintMessage("3: tick Ring2\n")
    Compose_TickRing2()
    PrintMessage("   Ring2 count after (expect 0): ")
    PrintNumber(Ring2_Count())
    PrintMessage("\n   Ring3 dirty (expect 1): ")
    PrintNumber(Ring3_IsDirty())
    PrintMessage("\n   Ring3 count (expect 1): ")
    PrintNumber(Ring3_GetCount())
    PrintMessage("\n")

    // =========================================================
    // TEST 4: Post Ring0 focus command, tick Ring0
    // =========================================================
    PrintMessage("4: Ring0 focus command\n")
    Ring0_Post(Ring0Cmd.FOCUS_SET, 9999, 0, 0)
    Compose_TickRing0()
    PrintMessage("   focused_leaf (expect 9999): ")
    PrintNumber(Compositor.focused_leaf)
    PrintMessage("\n")

    // =========================================================
    // TEST 5: Full tick — Ring3 clears after blit
    // output mode=0 so blit is no-op but flow is exercised
    // =========================================================
    PrintMessage("5: full tick\n")
    ComposeOutput.mode = 0
    Compose_Tick()
    PrintMessage("   Ring3 dirty after tick (expect 0): ")
    PrintNumber(Ring3_IsDirty())
    PrintMessage("\n")

    // =========================================================
    // TEST 6: Multiple dirty regions
    // =========================================================
    PrintMessage("6: multiple dirty regions\n")
    Ring2_Post(Ring2Cmd.FILL_RECT, surf, 0, 0)
    Ring2_Post(Ring2Cmd.DRAW_TEXT, surf, 0, 0)
    Ring2_Post(Ring2Cmd.DRAW_RECT, surf, 0, 0)
    Compose_TickRing2()
    PrintMessage("   Ring3 count (expect 3): ")
    PrintNumber(Ring3_GetCount())
    PrintMessage("\n")
    Ring3_Clear()

    // Cleanup
    Surface_Destroy(surf)
    Compose_Shutdown()

    PrintMessage("TestComposeTick: all tests done\n")
}

RunTask(Main)