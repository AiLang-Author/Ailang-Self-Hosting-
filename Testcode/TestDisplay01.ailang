// TestDisplay01.ailang
// Display system smoke test — uses DDrawCell primitives

LibraryImport.TUI
LibraryImport.Display.Render.DSurfaceTypes
LibraryImport.Display.Render.DSurface
LibraryImport.Display.Render.DDrawCell
LibraryImport.DRenderTerm

SubRoutine.Main {
    RenderTerm_Init()

    surf = Surface_Create(SurfaceFormat.CELL_32, 60, 20)

    IfCondition EqualTo(surf, 0) ThenBlock: {
        PrintMessage("ERROR: Surface_Create failed\n")
        RenderTerm_Shutdown()
        ReturnValue(0)
    }

    Draw_FillRect(surf, 0, 0, 60, 20, 32, Color16.WHITE, Color16.BLUE)
    Draw_FillRect(surf, 0, 0, 60, 1,  32, Color16.BRIGHT_WHITE, Color16.BLACK)
    Draw_Text(surf, 2, 0, "AILANG Display System - Test 01", Color16.BRIGHT_WHITE, Color16.BLACK)
    Draw_Rect(surf, 1, 2, 56, 16, Color16.BRIGHT_WHITE, Color16.BLUE)

    Draw_Text(surf, 4, 4,  "Surface is working.",        Color16.BRIGHT_GREEN, Color16.BLUE)
    Draw_Text(surf, 4, 6,  "Format : CELL_32",           Color16.BRIGHT_CYAN,  Color16.BLUE)
    Draw_Text(surf, 4, 7,  "Width  : 60",                Color16.BRIGHT_CYAN,  Color16.BLUE)
    Draw_Text(surf, 4, 8,  "Height : 20",                Color16.BRIGHT_CYAN,  Color16.BLUE)
    Draw_Text(surf, 4, 10, "Cell addressing : OK",       Color16.WHITE,        Color16.BLUE)
    Draw_Text(surf, 4, 11, "Pitch math      : OK",       Color16.WHITE,        Color16.BLUE)
    Draw_Text(surf, 4, 12, "Bounds checking : OK",       Color16.WHITE,        Color16.BLUE)
    Draw_TextAttr(surf, 4, 15, "Press any key to exit.", Color16.YELLOW, Color16.BLUE, CellAttr.BOLD)

    RenderTerm_Flush(surf)
    TUI_GetKey()
    Surface_Destroy(surf)
    RenderTerm_Shutdown()
}

RunTask(Main)