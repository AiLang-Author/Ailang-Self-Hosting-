// TestDisplay02.ailang
// Phase 2: framebuffer rendering
// Colors passed directly — avoids StoreValue byte-size bug for small values

LibraryImport.Display.Render.Framebuffer
LibraryImport.TUI

SubRoutine.Main {
    PrintMessage("TestDisplay02: initializing...\n")

    result = FB_Init()
    IfCondition EqualTo(result, 0) ThenBlock: {
        PrintMessage("ERROR: FB_Init failed\n")
        ReturnValue(0)
    }

    fw = FB_GetWidth()
    fh = FB_GetHeight()

    // === NO PrintMessage AFTER THIS POINT ===

    // Clear — use a non-zero dark blue so StoreValue stores 8 bytes
    FB_FillRectFast(0, 0, fw, fh, FB_RGB(0, 0, 32))

    // Three color bars — colors computed inline, always > 255
    bar_w = Divide(fw, 3)
    FB_FillRectFast(0,                  0, bar_w, fh, FB_RGB(220, 50,  50))
    FB_FillRectFast(bar_w,              0, bar_w, fh, FB_RGB(50,  200, 80))
    FB_FillRectFast(Multiply(bar_w, 2), 0, bar_w, fh, FB_RGB(50,  100, 220))

    // White outline rect
    FB_Rect(Divide(fw, 4), Divide(fh, 4), Divide(fw, 2), Divide(fh, 2), FB_RGB(255, 255, 255))

    // Yellow cross
    FB_HLine(0, Subtract(fw, 1), Divide(fh, 2), FB_RGB(255, 220, 0))
    FB_VLine(Divide(fw, 2), 0, Subtract(fh, 1), FB_RGB(255, 220, 0))

    // Circles
    FB_Circle(Divide(fw, 4), Divide(fh, 2), 80, FB_RGB(255, 255, 255))
    FB_FillCircle(Multiply(Divide(fw, 4), 3), Divide(fh, 2), 60, FB_RGB(0, 220, 220))

    // Wait
    TUI_InitBuffers()
    TUI_EnableRawMode()
    TUI_GetKey()
    TUI_DisableRawMode()
    TUI_CleanupBuffers()

    FB_Close()
    PrintMessage("Done.\n")
}

RunTask(Main)