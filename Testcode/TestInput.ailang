// TestInput.ailang
// Phase 7 — KDSETMODE fix + pixel positioning diagnostics
// Run on TTY2:
//   sudo chmod a+r /dev/input/event*
//   sudo ./TestInput.x

LibraryImport.Display.Render.Framebuffer
LibraryImport.Display.Render.DRenderFB
LibraryImport.Display.Render.DRingTypes
LibraryImport.Display.Render.DRing
LibraryImport.Display.Render.DRing1
LibraryImport.Display.Input.DInputTypes
LibraryImport.Display.Input.DInputEvdev
LibraryImport.Display.Input.DInputDiscover

// =============================================================================
// STATE
// =============================================================================
FixedPool.TestState {
    "running":     Initialize=0
    "dirty":       Initialize=0
    "cursor_x":    Initialize=0
    "cursor_y":    Initialize=0
    "last_key":    Initialize=0
    "key_count":   Initialize=0
    "mouse_count": Initialize=0
}

FixedPool.OldCursor {
    "x": Initialize=0
    "y": Initialize=0
}

// =============================================================================
// DRAW CROSSHAIR CURSOR
// =============================================================================
SubRoutine.EraseCursor {
    ox = OldCursor.x
    oy = OldCursor.y
    w  = FB_GetWidth()
    h  = FB_GetHeight()

    ex = Subtract(ox, 12)
    IfCondition LessThan(ex, 0) ThenBlock: { ex = 0 }
    ew = 25
    IfCondition GreaterThan(Add(ex, ew), w) ThenBlock: { ew = Subtract(w, ex) }
    IfCondition And(GreaterEqual(oy, 0), LessThan(oy, h)) ThenBlock: {
        FB_FillRectFast(ex, oy, ew, 1, 0x0A0A1A)
    }

    ey = Subtract(oy, 12)
    IfCondition LessThan(ey, 0) ThenBlock: { ey = 0 }
    eh = 25
    IfCondition GreaterThan(Add(ey, eh), h) ThenBlock: { eh = Subtract(h, ey) }
    IfCondition And(GreaterEqual(ox, 0), LessThan(ox, w)) ThenBlock: {
        FB_FillRectFast(ox, ey, 1, eh, 0x0A0A1A)
    }
}

SubRoutine.DrawCursorAt {
    cx = TestState.cursor_x
    cy = TestState.cursor_y
    w  = FB_GetWidth()
    h  = FB_GetHeight()

    hx = Subtract(cx, 12)
    IfCondition LessThan(hx, 0) ThenBlock: { hx = 0 }
    hw = 25
    IfCondition GreaterThan(Add(hx, hw), w) ThenBlock: { hw = Subtract(w, hx) }
    IfCondition And(GreaterEqual(cy, 0), LessThan(cy, h)) ThenBlock: {
        FB_FillRectFast(hx, cy, hw, 1, 0x88FF00)
    }

    vy = Subtract(cy, 12)
    IfCondition LessThan(vy, 0) ThenBlock: { vy = 0 }
    vh = 25
    IfCondition GreaterThan(Add(vy, vh), h) ThenBlock: { vh = Subtract(h, vy) }
    IfCondition And(GreaterEqual(cx, 0), LessThan(cx, w)) ThenBlock: {
        FB_FillRectFast(cx, vy, 1, vh, 0x88FF00)
    }

    OldCursor.x = cx
    OldCursor.y = cy
}

// =============================================================================
// INITIAL DRAW — own Function to avoid SubRoutine local corruption
// =============================================================================
Function.DrawInitialScreen {
    Output: Integer
    Body: {
        w      = FB_GetWidth()
        h      = FB_GetHeight()
        half_w = Divide(w, 2)
        half_h = Divide(h, 2)
        cx2    = Subtract(half_w, 100)
        cy2    = Subtract(half_h, 100)

        PrintMessage("[Draw] w=")
        PrintNumber(w)
        PrintMessage(" h=")
        PrintNumber(h)
        PrintMessage(" cx2=")
        PrintNumber(cx2)
        PrintMessage(" cy2=")
        PrintNumber(cy2)
        PrintMessage("\n")

        // Blue background
        FB_FillRectFast(0, 0, w, h, 0x0000FF)

        // Center rectangle
        FB_FillRectFast(cx2, cy2, 200, 200, 0xFF0000)

        // Diagnostic: 1px white line at exact Y center
        diag_y = Divide(h, 2)
        FB_FillRectFast(0, diag_y, w, 1, 0xFFFFFF)

        // Diagnostic: 1px white line at exact X center
        diag_x = Divide(w, 2)
        FB_FillRectFast(diag_x, 0, 1, h, 0xFFFFFF)

        FB_FlipFast()
        ReturnValue(0)
    }
}

// =============================================================================
// CURSOR INIT — own Function for same reason
// =============================================================================
Function.InitCursor {
    Output: Integer
    Body: {
        w = FB_GetWidth()
        h = FB_GetHeight()
        cx = Divide(w, 2)
        cy = Divide(h, 2)
        TestState.cursor_x = cx
        TestState.cursor_y = cy
        OldCursor.x        = cx
        OldCursor.y        = cy
        DrawCursorAt()
        FB_FlipFast()
        ReturnValue(0)
    }
}

// =============================================================================
// DRAIN RING1 — returns 1 if ESC pressed
// =============================================================================
Function.DrainRing1 {
    Output: Integer
    Body: {
        entry = Allocate(RingEntry.SIZE)
        quit  = 0

        WhileLoop EqualTo(Ring1_IsEmpty(), 0) {
            Ring1_Drain(entry)
            ev_type = Subtract(Dereference(Add(entry, RingEntry.TYPE)),    65536)
            pa      = Subtract(Dereference(Add(entry, RingEntry.PARAM_A)), 65536)
            pb      = Subtract(Dereference(Add(entry, RingEntry.PARAM_B)), 65536)
            pc      = Subtract(Dereference(Add(entry, RingEntry.PARAM_C)), 65536)

            IfCondition EqualTo(ev_type, Ring1Event.KEY_DOWN) ThenBlock: {
                TestState.last_key  = Add(pa, 65536)
                TestState.key_count = Add(Subtract(TestState.key_count, 65536), 65537)
                PrintMessage("[Key] code=")
                PrintNumber(pa)
                PrintMessage(" mods=")
                PrintNumber(pb)
                PrintMessage("\n")
                IfCondition EqualTo(pa, Key.ESC) ThenBlock: { quit = 1 }
            }

            IfCondition EqualTo(ev_type, Ring1Event.MOUSE_MOVE) ThenBlock: {
                TestState.cursor_x    = pa
                TestState.cursor_y    = pb
                TestState.mouse_count = Add(Subtract(TestState.mouse_count, 65536), 65537)
                TestState.dirty       = Add(1, 65536)
            }

            IfCondition EqualTo(ev_type, Ring1Event.MOUSE_DOWN) ThenBlock: {
                PrintMessage("[Mouse] btn=")
                PrintNumber(pc)
                PrintMessage(" at ")
                PrintNumber(pa)
                PrintMessage(",")
                PrintNumber(pb)
                PrintMessage("\n")
            }
        }

        Deallocate(entry, RingEntry.SIZE)
        ReturnValue(quit)
    }
}

// =============================================================================
// MAIN
// =============================================================================
SubRoutine.Main {
    PrintMessage("[TestInput] Phase 7 input test\n")

    fb_ok = RenderFB_InitDouble()
    IfCondition EqualTo(fb_ok, 0) ThenBlock: {
        PrintMessage("[TestInput] FAIL: FB init\n")
        ReturnValue(0)
    }
    w = FB_GetWidth()
    h = FB_GetHeight()
    PrintMessage("[TestInput] FB: ")
    PrintNumber(w)
    PrintMessage("x")
    PrintNumber(h)
    PrintMessage("\n")

    // -----------------------------------------------------------------------
    // KDSETMODE FIX — find active VT via /dev/tty0 + VT_GETSTATE
    // VT_GETSTATE=0x5603  KDSETMODE=0x4B3A=19258  KD_GRAPHICS=1  KD_TEXT=0
    // vt_stat: { uint16 v_active, uint16 v_signal, uint16 v_state }
    // -----------------------------------------------------------------------
    tty_fd_raw = -1
    tty_fd     = Add(-1, 65536)

    tty0_fd = SystemCall(2, "/dev/tty0", 2, 0)
    PrintMessage("[TestInput] tty0_fd=")
    PrintNumber(tty0_fd)
    PrintMessage("\n")
    IfCondition GreaterEqual(tty0_fd, 0) ThenBlock: {
        vt_buf = Allocate(8)
        vt_res = SystemCall(16, tty0_fd, 0x5603, vt_buf)
        PrintMessage("[TestInput] VT_GETSTATE result=")
        PrintNumber(vt_res)
        PrintMessage("\n")
        vt_num = GetByte(vt_buf, 0)
        PrintMessage("[TestInput] active VT=")
        PrintNumber(vt_num)
        PrintMessage("\n")
        SystemCall(3, tty0_fd, 0, 0)
        Deallocate(vt_buf, 8)
        tty_path = StringConcat("/dev/tty", NumberToString(vt_num))
        tty_fd_raw = SystemCall(2, tty_path, 2, 0)
        tty_fd = Add(tty_fd_raw, 65536)
        PrintMessage("[TestInput] tty_fd_raw=")
        PrintNumber(tty_fd_raw)
        PrintMessage("\n")
        IfCondition GreaterEqual(tty_fd_raw, 0) ThenBlock: {
            kd_result = SystemCall(16, tty_fd_raw, 19258, 1)
            PrintMessage("[TestInput] KDSETMODE result=")
            PrintNumber(kd_result)
            PrintMessage("\n")
        }
    }

    Ring1_Init()
    Evdev_SetMouseBounds(Subtract(w, 1), Subtract(h, 1))

    opened = Discover_OpenAll()
    IfCondition EqualTo(opened, 0) ThenBlock: {
        PrintMessage("[TestInput] FAIL: no input devices opened\n")
        PrintMessage("[TestInput] Try: sudo chmod a+r /dev/input/event*\n")
        ReturnValue(0)
    }

    // -----------------------------------------------------------------------
    // INITIAL DRAW + CURSOR
    // -----------------------------------------------------------------------
    DrawInitialScreen()
    InitCursor()

    // -----------------------------------------------------------------------
    // MAIN LOOP
    // -----------------------------------------------------------------------
    TestState.running = Add(1, 65536)
    loop_count = 0
    WhileLoop EqualTo(Subtract(TestState.running, 65536), 1) {
        loop_count = Add(loop_count, 1)
        IfCondition EqualTo(loop_count, 1) ThenBlock: {
            PrintMessage("[Loop] iteration 1 — calling Evdev_Poll\n")
        }
        _p = Evdev_Poll()
        IfCondition EqualTo(loop_count, 1) ThenBlock: {
            PrintMessage("[Loop] Evdev_Poll done — calling DrainRing1\n")
        }
        quit = DrainRing1()
        IfCondition EqualTo(loop_count, 1) ThenBlock: {
            PrintMessage("[Loop] DrainRing1 done\n")
        }
        IfCondition EqualTo(quit, 1) ThenBlock: {
            TestState.running = Add(0, 65536)
        }

        IfCondition EqualTo(Subtract(TestState.dirty, 65536), 1) ThenBlock: {
            EraseCursor()
            DrawCursorAt()
            FB_FlipFast()
            TestState.dirty = Add(0, 65536)
        }
    }

    // -----------------------------------------------------------------------
    // SHUTDOWN — restore TTY text mode
    // -----------------------------------------------------------------------
    _c = Evdev_CloseAll()
    RenderFB_Shutdown()

    tty_fd_restore = Subtract(tty_fd, 65536)
    IfCondition GreaterEqual(tty_fd_restore, 0) ThenBlock: {
        // KDSETMODE(KD_TEXT=0)
        SystemCall(16, tty_fd_restore, 19258, 0)
        SystemCall(3,  tty_fd_restore, 0, 0)
    }

    PrintMessage("[TestInput] keys=")
    PrintNumber(Subtract(TestState.key_count, 65536))
    PrintMessage(" moves=")
    PrintNumber(Subtract(TestState.mouse_count, 65536))
    PrintMessage("\n[TestInput] DONE\n")
}

RunTask(Main)