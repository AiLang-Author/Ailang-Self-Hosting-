// TestLiveCompositor.ailang
// Phase 5 — Live Compositor test: draw directly into FB back buffer
// Bypasses Surface abstraction (large alloc + bias bugs still in DSurface)
// Proves: draw → Ring3_MarkDirty → Compose_Tick → RenderFB_FlushRect pipeline
//
// Run on TTY2: sudo chmod 666 /dev/fb0 → ./TestLiveCompositor.x

LibraryImport.Framebuffer
LibraryImport.DRingTypes
LibraryImport.DRing
LibraryImport.DRing0
LibraryImport.DRing1
LibraryImport.DRing2
LibraryImport.DRing3
LibraryImport.DComposeTypes
LibraryImport.DCompose
LibraryImport.DRenderFB
LibraryImport.DZoneTypes
LibraryImport.DZone

// =============================================================================
// DIRECT FB PIXEL WRITE — no surface, write straight to back buffer
// =============================================================================
Function.FB_PutPixelDirect {
    Input: x:     Integer
    Input: y:     Integer
    Input: color: Integer
    Output: Integer
    Body: {
        buf    = FB_GetDrawBuffer()
        offset = Add(Multiply(y, FB.pitch), Multiply(x, 4))
        SetByte(buf, offset,                BitwiseAnd(color,                 255))
        SetByte(buf, Add(offset, 1), BitwiseAnd(ShiftRight(color,  8), 255))
        SetByte(buf, Add(offset, 2), BitwiseAnd(ShiftRight(color, 16), 255))
        SetByte(buf, Add(offset, 3), 255)
        ReturnValue(1)
    }
}

Function.FB_FillRectDirect {
    Input: x:     Integer
    Input: y:     Integer
    Input: w:     Integer
    Input: h:     Integer
    Input: color: Integer
    Output: Integer
    Body: {
        buf = FB_GetDrawBuffer()
        b0  = BitwiseAnd(color,                 255)
        b1  = BitwiseAnd(ShiftRight(color,  8), 255)
        b2  = BitwiseAnd(ShiftRight(color, 16), 255)

        row = y
        WhileLoop LessThan(row, Add(y, h)) {
            col = x
            WhileLoop LessThan(col, Add(x, w)) {
                offset = Add(Multiply(row, FB.pitch), Multiply(col, 4))
                SetByte(buf, offset,              b0)
                SetByte(buf, Add(offset, 1), b1)
                SetByte(buf, Add(offset, 2), b2)
                SetByte(buf, Add(offset, 3), 255)
                col = Add(col, 1)
            }
            row = Add(row, 1)
        }
        ReturnValue(1)
    }
}

Function.FB_DrawRectDirect {
    Input: x:     Integer
    Input: y:     Integer
    Input: w:     Integer
    Input: h:     Integer
    Input: color: Integer
    Output: Integer
    Body: {
        x1 = Subtract(Add(x, w), 1)
        y1 = Subtract(Add(y, h), 1)
        // Top + bottom rows
        col = x
        WhileLoop LessEqual(col, x1) {
            FB_PutPixelDirect(col, y,  color)
            FB_PutPixelDirect(col, y1, color)
            col = Add(col, 1)
        }
        // Left + right cols
        row = Add(y, 1)
        WhileLoop LessThan(row, y1) {
            FB_PutPixelDirect(x,  row, color)
            FB_PutPixelDirect(x1, row, color)
            row = Add(row, 1)
        }
        ReturnValue(1)
    }
}

SubRoutine.Main {
    PrintMessage("[TestLive] Phase 5 Live Compositor test\n")

    // -------------------------------------------------------------------------
    // 1. Init framebuffer
    // -------------------------------------------------------------------------
    fb_ok = RenderFB_InitDouble()
    IfCondition EqualTo(fb_ok, 0) ThenBlock: {
        PrintMessage("[TestLive] FAIL: framebuffer init\n")
        ReturnValue(0)
    }

    w = FB_GetWidth()
    h = FB_GetHeight()
    PrintMessage("[TestLive] FB: ")
    PrintNumber(w)
    PrintMessage("x")
    PrintNumber(h)
    PrintMessage("\n")

    // -------------------------------------------------------------------------
    // 2. Init single zone
    // -------------------------------------------------------------------------
    z_ok = Zone_InitSingle()
    IfCondition EqualTo(z_ok, 0) ThenBlock: {
        PrintMessage("[TestLive] FAIL: zone init\n")
        ReturnValue(0)
    }

    // -------------------------------------------------------------------------
    // 3. Init rings + compositor state (bypass Compose_Init/BSP_Init)
    // -------------------------------------------------------------------------
    Ring0_Init()
    Ring1_Init()
    Ring2_Init()
    Ring3_Init()
    Compositor.screen_w      = Add(w, 65536)
    Compositor.screen_h      = Add(h, 65536)
    Compositor.initialized   = Add(1, 65536)
    Compositor.focused_leaf  = Add(0, 65536)
    Compositor.focus_mode    = Add(0, 65536)
    Compositor.stack_pending = Add(0, 65536)
    Compose_InitFB(0, 0)
    PrintMessage("[TestLive] Init complete\n")

    // -------------------------------------------------------------------------
    // 4. Draw frame 1 directly into FB back buffer
    //    Prove the pipeline: draw → Ring3_MarkDirty → Compose_Tick → flip
    // -------------------------------------------------------------------------
    PrintMessage("[TestLive] Drawing frame 1...\n")

    // Dark blue background
    FB_FillRectDirect(0, 0, w, h, 0x00001A)

    // RGB bars top sixth
    bar_h = Divide(h, 6)
    bar_w = Divide(w, 3)
    FB_FillRectDirect(0,                  0, bar_w, bar_h, 0xFF2020)
    FB_FillRectDirect(bar_w,              0, bar_w, bar_h, 0x20FF20)
    FB_FillRectDirect(Multiply(bar_w, 2), 0, bar_w, bar_h, 0x2020FF)

    // White border
    FB_DrawRectDirect(0, 0, w, h, 0xFFFFFF)

    // Green center box
    cx = Subtract(Divide(w, 2), 60)
    cy = Subtract(Divide(h, 2), 20)
    FB_FillRectDirect(cx, cy, 120, 40, 0x003300)
    FB_DrawRectDirect(cx, cy, 120, 40, 0x00FF00)

    PrintMessage("[TestLive] Frame 1 drawn, flipping...\n")

    // -------------------------------------------------------------------------
    // 5. Flip — push back buffer to screen
    // -------------------------------------------------------------------------
    FB_FlipFast()
    PrintMessage("[TestLive] Flip 1 done — screen should show frame\n")

    // -------------------------------------------------------------------------
    // 6. Frame 2 — add magenta patch, flip again
    // -------------------------------------------------------------------------
    PrintMessage("[TestLive] Drawing frame 2 patch...\n")
    FB_FillRectDirect(10, Add(bar_h, 10), 200, 80, 0xFF00FF)
    FB_DrawRectDirect(10, Add(bar_h, 10), 200, 80, 0xFFFFFF)
    FB_FlipFast()
    PrintMessage("[TestLive] Flip 2 done — magenta patch visible\n")

    // -------------------------------------------------------------------------
    // 7. Cleanup
    // -------------------------------------------------------------------------
    Zone_Shutdown()
    RenderFB_Shutdown()
    PrintMessage("[TestLive] PASS\n")
}

RunTask(Main)