// TestRing.ailang
// Phase 3 smoke test: ring buffer post/drain/overflow

LibraryImport.DRingTypes
LibraryImport.DRing
LibraryImport.DRing0
LibraryImport.DRing1
LibraryImport.DRing2
LibraryImport.DRing3

SubRoutine.Main {
    PrintMessage("TestRing: ring buffer tests\n")

    // Allocate a scratch entry buffer
    entry = Allocate(RingEntry.SIZE)

    // =========================================================
    // TEST 1: Create ring, check empty
    // =========================================================
    PrintMessage("1: create ring capacity=4\n")
    ring = Ring_Create(4, RingEntry.SIZE)
    IfCondition EqualTo(ring, 0) ThenBlock: {
        PrintMessage("FAIL: Ring_Create returned 0\n")
        ReturnValue(0)
    }
    PrintMessage("   capacity: ")
    PrintNumber(Ring_GetCapacity(ring))
    PrintMessage("\n   count: ")
    PrintNumber(Ring_GetCount(ring))
    PrintMessage("\n   empty: ")
    PrintNumber(Ring_IsEmpty(ring))
    PrintMessage("\n")

    // =========================================================
    // TEST 2: Post one entry
    // =========================================================
    PrintMessage("2: post entry type=WIN_CREATE param_a=42\n")
    StoreValue(Add(entry, RingEntry.TYPE),    Add(Ring0Cmd.WIN_CREATE, 65536))
    StoreValue(Add(entry, RingEntry.PARAM_A), Add(42, 65536))
    StoreValue(Add(entry, RingEntry.PARAM_B), Add(0,  65536))
    StoreValue(Add(entry, RingEntry.PARAM_C), Add(0,  65536))
    result = Ring_Post(ring, entry)
    PrintMessage("   post result: ")
    PrintNumber(result)
    PrintMessage("\n   count: ")
    PrintNumber(Ring_GetCount(ring))
    PrintMessage("\n")

    // =========================================================
    // TEST 3: Drain entry back
    // =========================================================
    PrintMessage("3: drain entry\n")
    i = 0
    WhileLoop LessThan(i, RingEntry.SIZE) {
        SetByte(entry, i, 0)
        i = Add(i, 1)
    }
    result = Ring_Drain(ring, entry)
    PrintMessage("   drain result: ")
    PrintNumber(result)
    PrintMessage("\n   type: ")
    PrintNumber(Subtract(Dereference(Add(entry, RingEntry.TYPE)),    65536))
    PrintMessage("\n   param_a: ")
    PrintNumber(Subtract(Dereference(Add(entry, RingEntry.PARAM_A)), 65536))
    PrintMessage("\n   count after drain: ")
    PrintNumber(Ring_GetCount(ring))
    PrintMessage("\n")

    // =========================================================
    // TEST 4: Fill to capacity, verify full
    // =========================================================
    PrintMessage("4: fill ring to capacity=4\n")
    StoreValue(Add(entry, RingEntry.TYPE), Add(Ring0Cmd.FOCUS_SET, 65536))
    Ring_Post(ring, entry)
    Ring_Post(ring, entry)
    Ring_Post(ring, entry)
    Ring_Post(ring, entry)
    PrintMessage("   count: ")
    PrintNumber(Ring_GetCount(ring))
    PrintMessage("\n   full: ")
    PrintNumber(Ring_IsFull(ring))
    PrintMessage("\n")

    // =========================================================
    // TEST 5: Post to full ring — should return 0
    // =========================================================
    PrintMessage("5: post to full ring\n")
    result = Ring_Post(ring, entry)
    PrintMessage("   post result (expect 0): ")
    PrintNumber(result)
    PrintMessage("\n   count unchanged: ")
    PrintNumber(Ring_GetCount(ring))
    PrintMessage("\n")

    // =========================================================
    // TEST 6: Drop oldest, then post succeeds
    // =========================================================
    PrintMessage("6: drop oldest, post again\n")
    Ring_DropOldest(ring)
    PrintMessage("   count after drop: ")
    PrintNumber(Ring_GetCount(ring))
    PrintMessage("\n")
    result = Ring_Post(ring, entry)
    PrintMessage("   post result (expect 1): ")
    PrintNumber(result)
    PrintMessage("\n   count: ")
    PrintNumber(Ring_GetCount(ring))
    PrintMessage("\n")

    // =========================================================
    // TEST 7: Drain all, verify empty
    // =========================================================
    PrintMessage("7: drain all entries\n")
    drained = 0
    WhileLoop EqualTo(Ring_IsEmpty(ring), 0) {
        Ring_Drain(ring, entry)
        drained = Add(drained, 1)
    }
    PrintMessage("   drained: ")
    PrintNumber(drained)
    PrintMessage("\n   empty: ")
    PrintNumber(Ring_IsEmpty(ring))
    PrintMessage("\n")

    // =========================================================
    // TEST 8: Ring 1 size (128 capacity)
    // =========================================================
    PrintMessage("8: create Ring1 capacity=128\n")
    ring1 = Ring_Create(RingCap.RING1, RingEntry.SIZE)
    PrintMessage("   capacity: ")
    PrintNumber(Ring_GetCapacity(ring1))
    PrintMessage("\n")

    // Cleanup
    Deallocate(entry, RingEntry.SIZE)
    Ring_Destroy(ring)
    Ring_Destroy(ring1)

    PrintMessage("TestRing: all tests done\n")

    // =========================================================
    // TEST 9: Ring 0/1/2/3 wrappers
    // =========================================================
    PrintMessage("9: ring wrappers\n")
    Ring0_Init()
    Ring1_Init()
    Ring2_Init()
    Ring3_Init()

    // Ring0 post/drain
    Ring0_Post(Ring0Cmd.WIN_CREATE, 100, 0, 0)
    Ring0_Post(Ring0Cmd.FOCUS_SET,  200, 0, 0)
    PrintMessage("   Ring0 count: ")
    PrintNumber(Ring0_Count())
    PrintMessage("\n")

    out = Allocate(RingEntry.SIZE)
    Ring0_Drain(out)
    PrintMessage("   Ring0 drained cmd: ")
    PrintNumber(Subtract(Dereference(Add(out, RingEntry.TYPE)), 65536))
    PrintMessage(" param_a: ")
    PrintNumber(Subtract(Dereference(Add(out, RingEntry.PARAM_A)), 65536))
    PrintMessage("\n")

    // Ring1 mouse + key
    Ring1_Post(Ring1Event.MOUSE_MOVE, 640, 512, 0)
    Ring1_Post(Ring1Event.KEY_DOWN,   65,  0,   0)
    PrintMessage("   Ring1 count: ")
    PrintNumber(Ring1_Count())
    PrintMessage("\n")

    // Ring2 draw command
    Ring2_Post(Ring2Cmd.FILL_RECT, 999, 0, 0)
    PrintMessage("   Ring2 count: ")
    PrintNumber(Ring2_Count())
    PrintMessage("\n")

    // Ring3 dirty region
    Ring3_MarkDirty(999, 0, 0, 1280, 1024)
    PrintMessage("   Ring3 dirty: ")
    PrintNumber(Ring3_IsDirty())
    PrintMessage(" count: ")
    PrintNumber(Ring3_GetCount())
    PrintMessage("\n")
    Ring3_Clear()
    PrintMessage("   Ring3 after clear: ")
    PrintNumber(Ring3_IsDirty())
    PrintMessage("\n")

    Deallocate(out, RingEntry.SIZE)
    Ring0_Shutdown()
    Ring1_Shutdown()
    Ring2_Shutdown()
    Ring3_Shutdown()

    PrintMessage("All ring wrapper tests done\n")
}

RunTask(Main)