// TestSurface.ailang
// Validates DSurface bias fix — runs in terminal (no FB needed)
// Expected output: all fields correct, pixel writes in bounds, no crash

LibraryImport.Display.Render.DSurfaceTypes
LibraryImport.Display.Render.DSurface
LibraryImport.Display.Render.DDrawPixel

SubRoutine.Main {
    PrintMessage("[TestSurface] DSurface bias validation\n")

    // -------------------------------------------------------------------------
    // Test 1: Small PIXEL_32 surface — field reads
    // -------------------------------------------------------------------------
    PrintMessage("[TestSurface] Creating 320x240 PIXEL_32...\n")
    surf = Surface_Create(SurfaceFormat.PIXEL_32, 320, 240)
    IfCondition EqualTo(surf, 0) ThenBlock: {
        PrintMessage("[TestSurface] FAIL: surface create returned 0\n")
        ReturnValue(0)
    }

    w = Surface_GetWidth(surf)
    h = Surface_GetHeight(surf)
    p = Surface_GetPitch(surf)
    d = Surface_GetData(surf)

    PrintMessage("[TestSurface] width=")
    PrintNumber(w)
    PrintMessage(" (expect 320)\n")
    PrintMessage("[TestSurface] height=")
    PrintNumber(h)
    PrintMessage(" (expect 240)\n")
    PrintMessage("[TestSurface] pitch=")
    PrintNumber(p)
    PrintMessage(" (expect 1280)\n")
    PrintMessage("[TestSurface] data=")
    PrintNumber(d)
    PrintMessage(" (expect non-zero)\n")

    IfCondition NotEqual(w, 320) ThenBlock: { PrintMessage("[TestSurface] FAIL width\n") ReturnValue(0) }
    IfCondition NotEqual(h, 240) ThenBlock: { PrintMessage("[TestSurface] FAIL height\n") ReturnValue(0) }
    IfCondition NotEqual(p, 1280) ThenBlock: { PrintMessage("[TestSurface] FAIL pitch\n") ReturnValue(0) }
    IfCondition EqualTo(d, 0)    ThenBlock: { PrintMessage("[TestSurface] FAIL data null\n") ReturnValue(0) }
    PrintMessage("[TestSurface] Field reads OK\n")

    // -------------------------------------------------------------------------
    // Test 2: InBounds checks
    // -------------------------------------------------------------------------
    r1 = Surface_InBounds(surf, 0,   0)
    r2 = Surface_InBounds(surf, 319, 239)
    r3 = Surface_InBounds(surf, 320, 0)
    r4 = Surface_InBounds(surf, 0,   240)
    r5 = Surface_InBounds(surf, -1,  0)

    PrintMessage("[TestSurface] InBounds(0,0)=")     PrintNumber(r1) PrintMessage(" (expect 1)\n")
    PrintMessage("[TestSurface] InBounds(319,239)=") PrintNumber(r2) PrintMessage(" (expect 1)\n")
    PrintMessage("[TestSurface] InBounds(320,0)=")   PrintNumber(r3) PrintMessage(" (expect 0)\n")
    PrintMessage("[TestSurface] InBounds(0,240)=")   PrintNumber(r4) PrintMessage(" (expect 0)\n")
    PrintMessage("[TestSurface] InBounds(-1,0)=")    PrintNumber(r5) PrintMessage(" (expect 0)\n")

    IfCondition NotEqual(r1, 1) ThenBlock: { PrintMessage("[TestSurface] FAIL bounds 1\n") ReturnValue(0) }
    IfCondition NotEqual(r2, 1) ThenBlock: { PrintMessage("[TestSurface] FAIL bounds 2\n") ReturnValue(0) }
    IfCondition NotEqual(r3, 0) ThenBlock: { PrintMessage("[TestSurface] FAIL bounds 3\n") ReturnValue(0) }
    IfCondition NotEqual(r4, 0) ThenBlock: { PrintMessage("[TestSurface] FAIL bounds 4\n") ReturnValue(0) }
    IfCondition NotEqual(r5, 0) ThenBlock: { PrintMessage("[TestSurface] FAIL bounds 5\n") ReturnValue(0) }
    PrintMessage("[TestSurface] InBounds OK\n")

    // -------------------------------------------------------------------------
    // Test 3: Draw_Pix_FillRect — small rect, no crash = pass
    // -------------------------------------------------------------------------
    PrintMessage("[TestSurface] Draw_Pix_FillRect 10x10...\n")
    Draw_Pix_FillRect(surf, 0, 0, 10, 10, 0xFF0000)
    PrintMessage("[TestSurface] Draw_Pix_FillRect full surface...\n")
    Draw_Pix_FillRect(surf, 0, 0, 320, 240, 0x002040)
    PrintMessage("[TestSurface] FillRect OK\n")

    // -------------------------------------------------------------------------
    // Test 4: PixelAt address sanity — first and last pixel
    // -------------------------------------------------------------------------
    p0 = Surface_PixelAt(surf, 0,   0)
    p1 = Surface_PixelAt(surf, 319, 239)
    PrintMessage("[TestSurface] PixelAt(0,0)=")
    PrintNumber(p0)
    PrintMessage("\n")
    PrintMessage("[TestSurface] PixelAt(319,239)=")
    PrintNumber(p1)
    PrintMessage("\n")
    // Last pixel should be data + (239*1280) + (319*4) = data + 305920 + 1276 = data + 307196 -- but just check non-zero
    IfCondition EqualTo(p0, 0) ThenBlock: { PrintMessage("[TestSurface] FAIL PixelAt p0 null\n") ReturnValue(0) }
    IfCondition EqualTo(p1, 0) ThenBlock: { PrintMessage("[TestSurface] FAIL PixelAt p1 null\n") ReturnValue(0) }
    PrintMessage("[TestSurface] PixelAt OK\n")

    // -------------------------------------------------------------------------
    // Test 5: CELL_32 surface
    // -------------------------------------------------------------------------
    PrintMessage("[TestSurface] Creating 80x24 CELL_32...\n")
    csurf = Surface_Create(SurfaceFormat.CELL_32, 80, 24)
    IfCondition EqualTo(csurf, 0) ThenBlock: {
        PrintMessage("[TestSurface] FAIL: cell surface create\n")
        ReturnValue(0)
    }
    cw = Surface_GetWidth(csurf)
    ch = Surface_GetHeight(csurf)
    cp = Surface_GetPitch(csurf)
    PrintMessage("[TestSurface] cell width=")  PrintNumber(cw) PrintMessage(" (expect 80)\n")
    PrintMessage("[TestSurface] cell height=") PrintNumber(ch) PrintMessage(" (expect 24)\n")
    PrintMessage("[TestSurface] cell pitch=")  PrintNumber(cp) PrintMessage(" (expect 320)\n")
    IfCondition NotEqual(cw, 80)  ThenBlock: { PrintMessage("[TestSurface] FAIL cell width\n")  ReturnValue(0) }
    IfCondition NotEqual(ch, 24)  ThenBlock: { PrintMessage("[TestSurface] FAIL cell height\n") ReturnValue(0) }
    IfCondition NotEqual(cp, 320) ThenBlock: { PrintMessage("[TestSurface] FAIL cell pitch\n")  ReturnValue(0) }
    PrintMessage("[TestSurface] CELL_32 OK\n")

    // -------------------------------------------------------------------------
    // Cleanup
    // -------------------------------------------------------------------------
    Surface_Destroy(surf)
    Surface_Destroy(csurf)

    PrintMessage("[TestSurface] PASS — all checks clean\n")
}

RunTask(Main)