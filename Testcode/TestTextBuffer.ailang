// TestTextBuffer.ailang
// Unit tests for Library.TextBuffer
// No framebuffer or TTY required — tests logic only

LibraryImport.Arena
LibraryImport.DSurfaceTypes
LibraryImport.DSurface
LibraryImport.DDrawPixel
LibraryImport.Font
LibraryImport.FontBitmap
LibraryImport.TextBuffer
LibraryImport.DInputTypes

FixedPool.TBTest {
    "total":  Initialize=0
    "passed": Initialize=0
}

Function.Check {
    Input: expected: Integer
    Input: actual:   Integer
    Input: label:    Address
    Output: Integer
    Body: {
        TBTest.total = Add(TBTest.total, 1)
        IfCondition EqualTo(expected, actual) ThenBlock: {
            PrintMessage("PASS ")
            PrintMessage(label)
            PrintMessage("\n")
            TBTest.passed = Add(TBTest.passed, 1)
            ReturnValue(1)
        } ElseBlock: {
            PrintMessage("FAIL ")
            PrintMessage(label)
            PrintMessage(" expected=")
            PrintNumber(expected)
            PrintMessage(" actual=")
            PrintNumber(actual)
            PrintMessage("\n")
            ReturnValue(0)
        }
    }
}

// =============================================================================
// TEST 1: Create and destroy
// =============================================================================
Function.Test_CreateDestroy {
    Output: Integer
    Body: {
        PrintMessage("-- Create/Destroy --\n")
        Font_Init()
        font = Font_CreateBuiltin(8)

        // 160x80 surface = 20 cols x 10 rows at 8x8
        surf = Surface_Create(SurfaceFormat.PIXEL_32, 160, 80)
        Check(1, NotEqual(surf, 0), "surface created")

        handle = TextBuffer_Create(surf, font)
        Check(1, NotEqual(handle, -1), "buffer created")
        Check(1, GreaterEqual(handle, 0), "handle >= 0 (valid)")

        // Verify grid dimensions
        cols = TB_Get(handle, TBField.COLS)
        rows = TB_Get(handle, TBField.ROWS)
        Check(20, cols, "cols = 160/8 = 20")
        Check(10, rows, "rows = 80/8 = 10")

        // Verify initial cursor at 0,0
        Check(0, TB_Get(handle, TBField.CUR_COL), "cursor col=0")
        Check(0, TB_Get(handle, TBField.CUR_ROW), "cursor row=0")

        // Verify dirty on creation
        Check(1, TB_Get(handle, TBField.DIRTY), "dirty=1 on create")

        TextBuffer_Destroy(handle)
        Surface_Destroy(surf)
        ReturnValue(1)
    }
}

// =============================================================================
// TEST 2: PutChar — printable chars, cursor advance
// =============================================================================
Function.Test_PutChar {
    Output: Integer
    Body: {
        PrintMessage("-- PutChar --\n")
        Font_Init()
        font   = Font_CreateBuiltin(8)
        surf   = Surface_Create(SurfaceFormat.PIXEL_32, 160, 80)
        handle = TextBuffer_Create(surf, font)

        // Put 'A' (65)
        TextBuffer_PutChar(handle, 65)
        Check(1, TB_Get(handle, TBField.CUR_COL), "cursor advances to col 1")
        Check(0, TB_Get(handle, TBField.CUR_ROW), "cursor stays row 0")

        // Verify char stored in buffer
        buf = TB_Get(handle, TBField.BUF)
        ch  = GetByte(buf, 0)
        Check(65, ch, "char 'A' stored at (0,0)")

        // Put 'B' (66)
        TextBuffer_PutChar(handle, 66)
        ch = GetByte(buf, 1)
        Check(66, ch, "char 'B' stored at (1,0)")
        Check(2, TB_Get(handle, TBField.CUR_COL), "cursor at col 2")

        // Dirty flag set
        Check(1, TB_Get(handle, TBField.DIRTY), "dirty after PutChar")

        TextBuffer_Destroy(handle)
        Surface_Destroy(surf)
        ReturnValue(1)
    }
}

// =============================================================================
// TEST 3: Newline and carriage behavior
// =============================================================================
Function.Test_Newline {
    Output: Integer
    Body: {
        PrintMessage("-- Newline --\n")
        Font_Init()
        font   = Font_CreateBuiltin(8)
        surf   = Surface_Create(SurfaceFormat.PIXEL_32, 160, 80)
        handle = TextBuffer_Create(surf, font)

        TextBuffer_PutChar(handle, 65)   // A
        TextBuffer_PutChar(handle, 10)   // newline
        Check(0, TB_Get(handle, TBField.CUR_COL), "col resets to 0 after newline")
        Check(1, TB_Get(handle, TBField.CUR_ROW), "row advances to 1 after newline")

        TextBuffer_PutChar(handle, 66)   // B on row 1
        buf  = TB_Get(handle, TBField.BUF)
        cols = TB_Get(handle, TBField.COLS)
        ch   = GetByte(buf, cols)   // row 1, col 0
        Check(66, ch, "char 'B' on row 1")

        TextBuffer_Destroy(handle)
        Surface_Destroy(surf)
        ReturnValue(1)
    }
}

// =============================================================================
// TEST 4: Backspace
// =============================================================================
Function.Test_Backspace {
    Output: Integer
    Body: {
        PrintMessage("-- Backspace --\n")
        Font_Init()
        font   = Font_CreateBuiltin(8)
        surf   = Surface_Create(SurfaceFormat.PIXEL_32, 160, 80)
        handle = TextBuffer_Create(surf, font)

        TextBuffer_PutChar(handle, 65)   // A
        TextBuffer_PutChar(handle, 66)   // B
        Check(2, TB_Get(handle, TBField.CUR_COL), "col=2 before backspace")

        TextBuffer_PutChar(handle, 8)    // backspace
        Check(1, TB_Get(handle, TBField.CUR_COL), "col=1 after backspace")

        // Char at col 1 should be space now
        buf = TB_Get(handle, TBField.BUF)
        ch  = GetByte(buf, 1)
        Check(32, ch, "backspaced char replaced with space")

        // Backspace at col 0 does nothing
        TextBuffer_PutChar(handle, 8)    // back to col 0
        TextBuffer_PutChar(handle, 8)    // at col 0, should not go negative
        Check(0, TB_Get(handle, TBField.CUR_COL), "col stays 0 at left edge")

        TextBuffer_Destroy(handle)
        Surface_Destroy(surf)
        ReturnValue(1)
    }
}

// =============================================================================
// TEST 5: Line wrap
// =============================================================================
Function.Test_Wrap {
    Output: Integer
    Body: {
        PrintMessage("-- Line wrap --\n")
        Font_Init()
        font   = Font_CreateBuiltin(8)
        surf   = Surface_Create(SurfaceFormat.PIXEL_32, 160, 80)
        handle = TextBuffer_Create(surf, font)

        cols = TB_Get(handle, TBField.COLS)   // 20

        // Fill exactly one line
        i = 0
        WhileLoop LessThan(i, cols) {
            TextBuffer_PutChar(handle, 65)
            i = Add(i, 1)
        }
        // Should have wrapped to row 1 col 0
        Check(0, TB_Get(handle, TBField.CUR_COL), "col=0 after wrap")
        Check(1, TB_Get(handle, TBField.CUR_ROW), "row=1 after wrap")

        TextBuffer_Destroy(handle)
        Surface_Destroy(surf)
        ReturnValue(1)
    }
}

// =============================================================================
// TEST 6: Scroll
// =============================================================================
Function.Test_Scroll {
    Output: Integer
    Body: {
        PrintMessage("-- Scroll --\n")
        Font_Init()
        font   = Font_CreateBuiltin(8)
        surf   = Surface_Create(SurfaceFormat.PIXEL_32, 160, 80)
        handle = TextBuffer_Create(surf, font)

        rows = TB_Get(handle, TBField.ROWS)   // 10
        buf  = TB_Get(handle, TBField.BUF)
        cols = TB_Get(handle, TBField.COLS)

        // Write distinct char on each row via newline
        // Row 0 = 'A', row 1 = 'B', ... row 9 = 'J'
        i = 0
        WhileLoop LessThan(i, rows) {
            TextBuffer_PutChar(handle, Add(65, i))
            TextBuffer_PutChar(handle, 10)
            i = Add(i, 1)
        }
        // That last newline pushed us to row 10 which triggered scroll
        // Row 0 should now be 'B' (65+1=66)
        ch = GetByte(buf, 0)
        Check(66, ch, "row 0 = 'B' after scroll")

        // Cursor should be at last row
        Check(Subtract(rows, 1), TB_Get(handle, TBField.CUR_ROW), "cursor on last row after scroll")

        TextBuffer_Destroy(handle)
        Surface_Destroy(surf)
        ReturnValue(1)
    }
}

// =============================================================================
// TEST 7: PutString
// =============================================================================
Function.Test_PutString {
    Output: Integer
    Body: {
        PrintMessage("-- PutString --\n")
        Font_Init()
        font   = Font_CreateBuiltin(8)
        surf   = Surface_Create(SurfaceFormat.PIXEL_32, 160, 80)
        handle = TextBuffer_Create(surf, font)

        TextBuffer_PutString(handle, "Hello")
        Check(5, TB_Get(handle, TBField.CUR_COL), "cursor at col 5 after Hello")

        buf = TB_Get(handle, TBField.BUF)
        Check(72, GetByte(buf, 0), "H=72")
        Check(101, GetByte(buf, 1), "e=101")
        Check(108, GetByte(buf, 2), "l=108")
        Check(108, GetByte(buf, 3), "l=108")
        Check(111, GetByte(buf, 4), "o=111")

        TextBuffer_Destroy(handle)
        Surface_Destroy(surf)
        ReturnValue(1)
    }
}

// =============================================================================
// TEST 8: KeyToChar translation
// =============================================================================
Function.Test_KeyToChar {
    Output: Integer
    Body: {
        PrintMessage("-- KeyToChar --\n")

        // Letters unshifted
        Check(97,  TextBuffer_KeyToChar(Key.A, 0), "a unshifted")
        Check(65,  TextBuffer_KeyToChar(Key.A, 1), "A shifted")
        Check(122, TextBuffer_KeyToChar(Key.Z, 0), "z unshifted")
        Check(90,  TextBuffer_KeyToChar(Key.Z, 1), "Z shifted")

        // Numbers unshifted
        Check(49, TextBuffer_KeyToChar(2, 0), "1 unshifted")
        Check(48, TextBuffer_KeyToChar(11, 0), "0 unshifted")

        // Numbers shifted = symbols
        Check(33, TextBuffer_KeyToChar(2, 1), "! shifted")
        Check(64, TextBuffer_KeyToChar(3, 1), "@ shifted")

        // Special keys
        Check(10, TextBuffer_KeyToChar(28, 0), "enter=10")
        Check(8,  TextBuffer_KeyToChar(14, 0), "backspace=8")
        Check(32, TextBuffer_KeyToChar(57, 0), "space=32")

        // Unhandled key returns 0
        Check(0, TextBuffer_KeyToChar(1, 0), "ESC returns 0")

        ReturnValue(1)
    }
}

// =============================================================================
// TEST 9: Render does not crash, clears dirty
// =============================================================================
Function.Test_Render {
    Output: Integer
    Body: {
        PrintMessage("-- Render --\n")
        Font_Init()
        font   = Font_CreateBuiltin(8)
        surf   = Surface_Create(SurfaceFormat.PIXEL_32, 160, 80)
        handle = TextBuffer_Create(surf, font)

        TextBuffer_PutString(handle, "Hello World")
        Check(1, TextBuffer_IsDirty(handle), "dirty before render")

        TextBuffer_Render(handle)
        Check(0, TextBuffer_IsDirty(handle), "clean after render")

        // Second render on clean buffer is no-op
        TextBuffer_Render(handle)
        Check(0, TextBuffer_IsDirty(handle), "still clean after second render")

        TextBuffer_Destroy(handle)
        Surface_Destroy(surf)
        ReturnValue(1)
    }
}

// =============================================================================
// MAIN
// =============================================================================
SubRoutine.Main {
    Arena_Init()
    PrintMessage("=== TestTextBuffer ===\n")

    Test_CreateDestroy()
    Test_PutChar()
    Test_Newline()
    Test_Backspace()
    Test_Wrap()
    Test_Scroll()
    Test_PutString()
    Test_KeyToChar()
    Test_Render()

    PrintMessage("=== Summary ===\n")
    PrintMessage("Passed: ")
    PrintNumber(TBTest.passed)
    PrintMessage(" / ")
    PrintNumber(TBTest.total)
    PrintMessage("\n")
    IfCondition EqualTo(TBTest.passed, TBTest.total) ThenBlock: {
        PrintMessage("ALL PASS\n")
    } ElseBlock: {
        PrintMessage("FAILURES\n")
    }
}

RunTask(Main)