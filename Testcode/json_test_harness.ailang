LibraryImport.JSON
LibraryImport.XArrays
LibraryImport.StringUtils

// =============================================================================
// TEST STATE
// =============================================================================
FixedPool.T {
    "pass": Initialize=0, CanChange=True
    "fail": Initialize=0, CanChange=True
    "total": Initialize=0, CanChange=True
    "sec_pass": Initialize=0, CanChange=True
    "sec_total": Initialize=0, CanChange=True
    "name": Initialize=0, CanChange=True
    "exp_num": Initialize=0, CanChange=True
    "act_num": Initialize=0, CanChange=True
    "exp_str": Initialize=0, CanChange=True
    "act_str": Initialize=0, CanChange=True
    "sec_name": Initialize=0, CanChange=True
    "obj": Initialize=0, CanChange=True
    "arr": Initialize=0, CanChange=True
    "tagged": Initialize=0, CanChange=True
    "str": Initialize=0, CanChange=True
    "tmp": Initialize=0, CanChange=True
    "tmp2": Initialize=0, CanChange=True
    "inner": Initialize=0, CanChange=True
    "child": Initialize=0, CanChange=True
}

// =============================================================================
// TEST HELPERS
// =============================================================================
SubRoutine.CheckNum {
    T.total = Add(T.total, 1)
    T.sec_total = Add(T.sec_total, 1)
    PrintMessage("  TEST: ")
    PrintMessage(T.name)
    PrintMessage("\n    Expected: ")
    PrintNumber(T.exp_num)
    PrintMessage("  Actual: ")
    PrintNumber(T.act_num)
    IfCondition EqualTo(T.exp_num, T.act_num) ThenBlock: {
        PrintMessage("  [PASS]\n")
        T.pass = Add(T.pass, 1)
        T.sec_pass = Add(T.sec_pass, 1)
    } ElseBlock: {
        PrintMessage("  [FAIL]\n")
        T.fail = Add(T.fail, 1)
    }
}

SubRoutine.CheckStr {
    T.total = Add(T.total, 1)
    T.sec_total = Add(T.sec_total, 1)
    PrintMessage("  TEST: ")
    PrintMessage(T.name)
    PrintMessage("\n    Expected: '")
    PrintMessage(T.exp_str)
    PrintMessage("'\n    Actual:   '")
    PrintMessage(T.act_str)
    PrintMessage("'")
    cmp = StringCompare(T.exp_str, T.act_str)
    IfCondition EqualTo(cmp, 0) ThenBlock: {
        PrintMessage("  [PASS]\n")
        T.pass = Add(T.pass, 1)
        T.sec_pass = Add(T.sec_pass, 1)
    } ElseBlock: {
        PrintMessage("  [FAIL]\n")
        T.fail = Add(T.fail, 1)
    }
}

SubRoutine.Section {
    PrintMessage("--- Section ")
    PrintMessage(T.sec_name)
    PrintMessage(": ")
    PrintNumber(T.sec_pass)
    PrintMessage("/")
    PrintNumber(T.sec_total)
    PrintMessage(" passed ---\n\n")
    T.sec_pass = 0
    T.sec_total = 0
}

// =============================================================================
PrintMessage("========================================================\n")
PrintMessage("    JSON Library v2 - Test Suite\n")
PrintMessage("========================================================\n\n")

// =============================================================================
// SECTION 1: TAG CREATION & UNWRAP
// =============================================================================
PrintMessage("SECTION 1: Tagged Value Creation & Unwrap\n")
PrintMessage("========================================================\n")

SubRoutine.Test1_Tags {
    // Tag a string
    T.tagged = JSON.Tag(JType.STRING, "hello")
    T.name = "Tag type for string"
    T.exp_num = JType.STRING
    T.act_num = JSON.TagType(T.tagged)
    RunTask(CheckNum)

    T.name = "Tag value for string"
    T.exp_str = "hello"
    T.act_str = JSON.TagValue(T.tagged)
    RunTask(CheckStr)

    // Tag a number
    T.tagged = JSON.Tag(JType.NUMBER, 42)
    T.name = "Tag type for number"
    T.exp_num = JType.NUMBER
    T.act_num = JSON.TagType(T.tagged)
    RunTask(CheckNum)

    T.name = "Tag value for number"
    T.exp_num = 42
    T.act_num = JSON.TagValue(T.tagged)
    RunTask(CheckNum)

    // Tag bool true
    T.tagged = JSON.Tag(JType.BOOL, 1)
    T.name = "Tag type for bool"
    T.exp_num = JType.BOOL
    T.act_num = JSON.TagType(T.tagged)
    RunTask(CheckNum)

    T.name = "Bool value is 1"
    T.exp_num = 1
    T.act_num = JSON.TagValue(T.tagged)
    RunTask(CheckNum)

    // Tag null
    T.tagged = JSON.Tag(JType.NULL, 0)
    T.name = "Tag type for null"
    T.exp_num = JType.NULL
    T.act_num = JSON.TagType(T.tagged)
    RunTask(CheckNum)

    // Null tagged input
    T.name = "TagType on null ptr returns NULL"
    T.exp_num = JType.NULL
    T.act_num = JSON.TagType(0)
    RunTask(CheckNum)

    T.name = "AsString on null ptr returns 0"
    T.exp_num = 0
    T.act_num = JSON.AsString(0)
    RunTask(CheckNum)

    T.name = "AsNumber on null ptr returns 0"
    T.exp_num = 0
    T.act_num = JSON.AsNumber(0)
    RunTask(CheckNum)

    // Wrong type unwrap
    T.tagged = JSON.Tag(JType.NUMBER, 99)
    T.name = "AsString on number tag returns 0"
    T.exp_num = 0
    T.act_num = JSON.AsString(T.tagged)
    RunTask(CheckNum)
}
RunTask(Test1_Tags)
T.sec_name = "1 (Tags)"
RunTask(Section)

// =============================================================================
// SECTION 2: OBJECT SETTERS & GETTERS
// =============================================================================
PrintMessage("SECTION 2: Object Set/Get\n")
PrintMessage("========================================================\n")

SubRoutine.Test2_Object {
    T.obj = JSON.NewObject()

    JSON.SetString(T.obj, "name", "AILang")
    JSON.SetNumber(T.obj, "version", 2)
    JSON.SetBool(T.obj, "stable", 1)
    JSON.SetNull(T.obj, "deprecated")

    T.name = "GetString 'name'"
    T.exp_str = "AILang"
    T.act_str = JSON.GetString(T.obj, "name")
    RunTask(CheckStr)

    T.name = "GetNumber 'version'"
    T.exp_num = 2
    T.act_num = JSON.GetNumber(T.obj, "version")
    RunTask(CheckNum)

    T.name = "GetBool 'stable'"
    T.exp_num = 1
    T.act_num = JSON.GetBool(T.obj, "stable")
    RunTask(CheckNum)

    T.name = "GetType 'deprecated' is NULL"
    T.exp_num = JType.NULL
    T.act_num = JSON.GetType(T.obj, "deprecated")
    RunTask(CheckNum)

    T.name = "GetType 'name' is STRING"
    T.exp_num = JType.STRING
    T.act_num = JSON.GetType(T.obj, "name")
    RunTask(CheckNum)

    T.name = "GetType 'version' is NUMBER"
    T.exp_num = JType.NUMBER
    T.act_num = JSON.GetType(T.obj, "version")
    RunTask(CheckNum)

    T.name = "GetString missing key returns 0"
    T.exp_num = 0
    T.act_num = JSON.GetString(T.obj, "nonexistent")
    RunTask(CheckNum)

    T.name = "GetNumber missing key returns 0"
    T.exp_num = 0
    T.act_num = JSON.GetNumber(T.obj, "nonexistent")
    RunTask(CheckNum)

    // Nested object
    T.inner = JSON.NewObject()
    JSON.SetString(T.inner, "city", "Detroit")
    JSON.SetObject(T.obj, "location", T.inner)

    T.name = "GetType 'location' is OBJECT"
    T.exp_num = JType.OBJECT
    T.act_num = JSON.GetType(T.obj, "location")
    RunTask(CheckNum)

    T.child = JSON.GetObject(T.obj, "location")
    T.name = "Nested GetString 'city'"
    T.exp_str = "Detroit"
    T.act_str = JSON.GetString(T.child, "city")
    RunTask(CheckStr)
}
RunTask(Test2_Object)
T.sec_name = "2 (Object)"
RunTask(Section)

// =============================================================================
// SECTION 3: ARRAY PUSHERS & ACCESS
// =============================================================================
PrintMessage("SECTION 3: Array Push & Access\n")
PrintMessage("========================================================\n")

SubRoutine.Test3_Array {
    T.arr = JSON.NewArray()

    JSON.PushString(T.arr, "first")
    JSON.PushNumber(T.arr, 100)
    JSON.PushBool(T.arr, 0)
    JSON.PushNull(T.arr)

    T.name = "Array size after 4 pushes"
    T.exp_num = 4
    T.act_num = XArray.XSize(T.arr)
    RunTask(CheckNum)

    // Element 0: string
    T.tagged = XArray.XGet(T.arr, 0)
    T.name = "Array[0] type is STRING"
    T.exp_num = JType.STRING
    T.act_num = JSON.TagType(T.tagged)
    RunTask(CheckNum)

    T.name = "Array[0] value is 'first'"
    T.exp_str = "first"
    T.act_str = JSON.AsString(T.tagged)
    RunTask(CheckStr)

    // Element 1: number
    T.tagged = XArray.XGet(T.arr, 1)
    T.name = "Array[1] type is NUMBER"
    T.exp_num = JType.NUMBER
    T.act_num = JSON.TagType(T.tagged)
    RunTask(CheckNum)

    T.name = "Array[1] value is 100"
    T.exp_num = 100
    T.act_num = JSON.AsNumber(T.tagged)
    RunTask(CheckNum)

    // Element 2: bool false
    T.tagged = XArray.XGet(T.arr, 2)
    T.name = "Array[2] type is BOOL"
    T.exp_num = JType.BOOL
    T.act_num = JSON.TagType(T.tagged)
    RunTask(CheckNum)

    T.name = "Array[2] value is 0 (false)"
    T.exp_num = 0
    T.act_num = JSON.AsBool(T.tagged)
    RunTask(CheckNum)

    // Element 3: null
    T.tagged = XArray.XGet(T.arr, 3)
    T.name = "Array[3] type is NULL"
    T.exp_num = JType.NULL
    T.act_num = JSON.TagType(T.tagged)
    RunTask(CheckNum)

    // Nested array
    T.inner = JSON.NewArray()
    JSON.PushNumber(T.inner, 10)
    JSON.PushNumber(T.inner, 20)
    JSON.PushArray(T.arr, T.inner)

    T.name = "Array size after nested push"
    T.exp_num = 5
    T.act_num = XArray.XSize(T.arr)
    RunTask(CheckNum)

    T.tagged = XArray.XGet(T.arr, 4)
    T.name = "Array[4] type is ARRAY"
    T.exp_num = JType.ARRAY
    T.act_num = JSON.TagType(T.tagged)
    RunTask(CheckNum)

    T.child = JSON.AsArray(T.tagged)
    T.tagged = XArray.XGet(T.child, 1)
    T.name = "Nested array[1] is 20"
    T.exp_num = 20
    T.act_num = JSON.AsNumber(T.tagged)
    RunTask(CheckNum)
}
RunTask(Test3_Array)
T.sec_name = "3 (Array)"
RunTask(Section)

// =============================================================================
// SECTION 4: SERIALIZATION
// =============================================================================
PrintMessage("SECTION 4: Serialization\n")
PrintMessage("========================================================\n")

SubRoutine.Test4_Serialize {
    // Null
    T.tagged = JSON.Tag(JType.NULL, 0)
    T.str = JSON.Serialize(T.tagged)
    T.name = "Serialize null"
    T.exp_str = "null"
    T.act_str = T.str
    RunTask(CheckStr)

    // Bool true
    T.tagged = JSON.Tag(JType.BOOL, 1)
    T.str = JSON.Serialize(T.tagged)
    T.name = "Serialize true"
    T.exp_str = "true"
    T.act_str = T.str
    RunTask(CheckStr)

    // Bool false
    T.tagged = JSON.Tag(JType.BOOL, 0)
    T.str = JSON.Serialize(T.tagged)
    T.name = "Serialize false"
    T.exp_str = "false"
    T.act_str = T.str
    RunTask(CheckStr)

    // Number
    T.tagged = JSON.Tag(JType.NUMBER, 42)
    T.str = JSON.Serialize(T.tagged)
    T.name = "Serialize number 42"
    T.exp_str = "42"
    T.act_str = T.str
    RunTask(CheckStr)

    // String
    T.tagged = JSON.Tag(JType.STRING, "hello")
    T.str = JSON.Serialize(T.tagged)
    T.name = "Serialize string"
    T.exp_str = "\"hello\""
    T.act_str = T.str
    RunTask(CheckStr)

    // Empty object
    T.obj = JSON.NewObject()
    T.str = JSON.SerializeObject(T.obj)
    T.name = "Serialize empty object"
    T.exp_str = "{}"
    T.act_str = T.str
    RunTask(CheckStr)

    // Empty array
    T.arr = JSON.NewArray()
    T.str = JSON.SerializeArray(T.arr)
    T.name = "Serialize empty array"
    T.exp_str = "[]"
    T.act_str = T.str
    RunTask(CheckStr)

    // Simple object
    T.obj = JSON.NewObject()
    JSON.SetNumber(T.obj, "x", 10)
    T.str = JSON.SerializeObject(T.obj)
    T.name = "Serialize {x:10}"
    // Hash key order may vary, just print it
    PrintMessage("  OUTPUT: ")
    PrintMessage(T.str)
    PrintMessage("\n")
    // At minimum the output should contain "x":10
    T.name = "Serialize object non-empty (length > 2)"
    T.exp_num = 1
    slen = StringLength(T.str)
    IfCondition GreaterThan(slen, 2) ThenBlock: {
        T.act_num = 1
    } ElseBlock: {
        T.act_num = 0
    }
    RunTask(CheckNum)

    // Simple array
    T.arr = JSON.NewArray()
    JSON.PushNumber(T.arr, 1)
    JSON.PushNumber(T.arr, 2)
    JSON.PushNumber(T.arr, 3)
    T.str = JSON.SerializeArray(T.arr)
    T.name = "Serialize [1,2,3]"
    T.exp_str = "[1,2,3]"
    T.act_str = T.str
    RunTask(CheckStr)

    // Mixed array
    T.arr = JSON.NewArray()
    JSON.PushString(T.arr, "a")
    JSON.PushNumber(T.arr, 1)
    JSON.PushBool(T.arr, 1)
    JSON.PushNull(T.arr)
    T.str = JSON.SerializeArray(T.arr)
    T.name = "Serialize mixed array"
    T.exp_str = "[\"a\",1,true,null]"
    T.act_str = T.str
    RunTask(CheckStr)
}
RunTask(Test4_Serialize)
T.sec_name = "4 (Serialize)"
RunTask(Section)

// =============================================================================
// SECTION 5: PARSING
// =============================================================================
PrintMessage("SECTION 5: Parsing\n")
PrintMessage("========================================================\n")

SubRoutine.Test5_Parse {
    // Parse null
    T.tagged = ParseJSON("null")
    T.name = "Parse null type"
    T.exp_num = JType.NULL
    T.act_num = JSON.TagType(T.tagged)
    RunTask(CheckNum)

    // Parse true
    T.tagged = ParseJSON("true")
    T.name = "Parse true type"
    T.exp_num = JType.BOOL
    T.act_num = JSON.TagType(T.tagged)
    RunTask(CheckNum)

    T.name = "Parse true value"
    T.exp_num = 1
    T.act_num = JSON.AsBool(T.tagged)
    RunTask(CheckNum)

    // Parse false
    T.tagged = ParseJSON("false")
    T.name = "Parse false value"
    T.exp_num = 0
    T.act_num = JSON.AsBool(T.tagged)
    RunTask(CheckNum)

    // Parse number
    T.tagged = ParseJSON("123")
    T.name = "Parse number type"
    T.exp_num = JType.NUMBER
    T.act_num = JSON.TagType(T.tagged)
    RunTask(CheckNum)

    T.name = "Parse number value 123"
    T.exp_num = 123
    T.act_num = JSON.AsNumber(T.tagged)
    RunTask(CheckNum)

    // Parse string
    T.tagged = ParseJSON("\"hello world\"")
    T.name = "Parse string type"
    T.exp_num = JType.STRING
    T.act_num = JSON.TagType(T.tagged)
    RunTask(CheckNum)

    T.name = "Parse string value"
    T.exp_str = "hello world"
    T.act_str = JSON.AsString(T.tagged)
    RunTask(CheckStr)

    // Parse empty object
    T.tagged = ParseJSON("{}")
    T.name = "Parse empty object type"
    T.exp_num = JType.OBJECT
    T.act_num = JSON.TagType(T.tagged)
    RunTask(CheckNum)

    // Parse empty array
    T.tagged = ParseJSON("[]")
    T.name = "Parse empty array type"
    T.exp_num = JType.ARRAY
    T.act_num = JSON.TagType(T.tagged)
    RunTask(CheckNum)

    T.child = JSON.AsArray(T.tagged)
    T.name = "Parse empty array size 0"
    T.exp_num = 0
    T.act_num = XArray.XSize(T.child)
    RunTask(CheckNum)

    // Parse simple object
    T.tagged = ParseJSON("{\"name\":\"test\",\"val\":42}")
    T.name = "Parse object type"
    T.exp_num = JType.OBJECT
    T.act_num = JSON.TagType(T.tagged)
    RunTask(CheckNum)

    T.obj = JSON.AsObject(T.tagged)
    T.name = "Parsed object GetString 'name'"
    T.exp_str = "test"
    T.act_str = JSON.GetString(T.obj, "name")
    RunTask(CheckStr)

    T.name = "Parsed object GetNumber 'val'"
    T.exp_num = 42
    T.act_num = JSON.GetNumber(T.obj, "val")
    RunTask(CheckNum)

    // Parse array of numbers
    T.tagged = ParseJSON("[10,20,30]")
    T.child = JSON.AsArray(T.tagged)
    T.name = "Parse array size"
    T.exp_num = 3
    T.act_num = XArray.XSize(T.child)
    RunTask(CheckNum)

    T.tmp = XArray.XGet(T.child, 0)
    T.name = "Parse array[0] = 10"
    T.exp_num = 10
    T.act_num = JSON.AsNumber(T.tmp)
    RunTask(CheckNum)

    T.tmp = XArray.XGet(T.child, 2)
    T.name = "Parse array[2] = 30"
    T.exp_num = 30
    T.act_num = JSON.AsNumber(T.tmp)
    RunTask(CheckNum)

    // Parse nested object
    T.tagged = ParseJSON("{\"outer\":{\"inner\":99}}")
    T.obj = JSON.AsObject(T.tagged)
    T.child = JSON.GetObject(T.obj, "outer")
    T.name = "Nested object GetNumber 'inner'"
    T.exp_num = 99
    T.act_num = JSON.GetNumber(T.child, "inner")
    RunTask(CheckNum)

    // Parse with whitespace
    T.tagged = ParseJSON("  {  \"key\"  :  \"val\"  }  ")
    T.obj = JSON.AsObject(T.tagged)
    T.name = "Parse with whitespace"
    T.exp_str = "val"
    T.act_str = JSON.GetString(T.obj, "key")
    RunTask(CheckStr)
}
RunTask(Test5_Parse)
T.sec_name = "5 (Parse)"
RunTask(Section)

// =============================================================================
// SECTION 6: STRING ESCAPING
// =============================================================================
PrintMessage("SECTION 6: String Escaping\n")
PrintMessage("========================================================\n")

SubRoutine.Test6_Escape {
    // No escaping needed
    T.str = JSON.EscapeString("hello")
    T.name = "Escape plain string"
    T.exp_str = "hello"
    T.act_str = T.str
    RunTask(CheckStr)

    // Empty string
    T.str = JSON.EscapeString("")
    T.name = "Escape empty string"
    T.exp_str = ""
    T.act_str = T.str
    RunTask(CheckStr)

    // Null input
    T.name = "Escape null returns 0"
    T.exp_num = 0
    T.act_num = JSON.EscapeString(0)
    RunTask(CheckNum)
}
RunTask(Test6_Escape)
T.sec_name = "6 (Escape)"
RunTask(Section)

// =============================================================================
// SECTION 7: ROUNDTRIP (Build -> Serialize -> Parse -> Read)
// =============================================================================
PrintMessage("SECTION 7: Roundtrip\n")
PrintMessage("========================================================\n")

SubRoutine.Test7_Roundtrip {
    // Build an object
    T.obj = JSON.NewObject()
    JSON.SetString(T.obj, "compiler", "ailang")
    JSON.SetNumber(T.obj, "year", 2026)
    JSON.SetBool(T.obj, "self_hosting", 1)

    T.inner = JSON.NewArray()
    JSON.PushString(T.inner, "lexer")
    JSON.PushString(T.inner, "parser")
    JSON.PushString(T.inner, "codegen")
    JSON.SetArray(T.obj, "passes", T.inner)

    // Serialize
    T.str = JSON.SerializeObject(T.obj)
    PrintMessage("  Roundtrip JSON: ")
    PrintMessage(T.str)
    PrintMessage("\n")

    // Parse it back
    T.tagged = ParseJSON(T.str)
    T.tmp = JSON.AsObject(T.tagged)

    T.name = "Roundtrip GetString 'compiler'"
    T.exp_str = "ailang"
    T.act_str = JSON.GetString(T.tmp, "compiler")
    RunTask(CheckStr)

    T.name = "Roundtrip GetNumber 'year'"
    T.exp_num = 2026
    T.act_num = JSON.GetNumber(T.tmp, "year")
    RunTask(CheckNum)

    T.name = "Roundtrip GetBool 'self_hosting'"
    T.exp_num = 1
    T.act_num = JSON.GetBool(T.tmp, "self_hosting")
    RunTask(CheckNum)

    T.child = JSON.GetArray(T.tmp, "passes")
    T.name = "Roundtrip passes array size"
    T.exp_num = 3
    T.act_num = XArray.XSize(T.child)
    RunTask(CheckNum)

    T.tmp2 = XArray.XGet(T.child, 0)
    T.name = "Roundtrip passes[0]"
    T.exp_str = "lexer"
    T.act_str = JSON.AsString(T.tmp2)
    RunTask(CheckStr)

    T.tmp2 = XArray.XGet(T.child, 2)
    T.name = "Roundtrip passes[2]"
    T.exp_str = "codegen"
    T.act_str = JSON.AsString(T.tmp2)
    RunTask(CheckStr)
}
RunTask(Test7_Roundtrip)
T.sec_name = "7 (Roundtrip)"
RunTask(Section)

// =============================================================================
// SECTION 8: DIAGNOSTIC-STYLE USAGE (LSP pattern)
// =============================================================================
PrintMessage("SECTION 8: Diagnostic Pattern (LSP-style)\n")
PrintMessage("========================================================\n")

SubRoutine.Test8_Diagnostic {
    // Simulate what DiagnosticStore would emit
    T.obj = JSON.NewObject()
    JSON.SetString(T.obj, "file", "main.ailang")
    JSON.SetNumber(T.obj, "line", 42)
    JSON.SetNumber(T.obj, "col", 8)
    JSON.SetNumber(T.obj, "severity", 2)
    JSON.SetString(T.obj, "code", "unused-var")
    JSON.SetString(T.obj, "message", "Variable 'temp' assigned but never used")
    JSON.SetBool(T.obj, "fatal", 0)

    T.str = JSON.SerializeObject(T.obj)
    PrintMessage("  Diagnostic JSON: ")
    PrintMessage(T.str)
    PrintMessage("\n")

    // Parse it back and verify all fields
    T.tagged = ParseJSON(T.str)
    T.tmp = JSON.AsObject(T.tagged)

    T.name = "Diag file"
    T.exp_str = "main.ailang"
    T.act_str = JSON.GetString(T.tmp, "file")
    RunTask(CheckStr)

    T.name = "Diag line"
    T.exp_num = 42
    T.act_num = JSON.GetNumber(T.tmp, "line")
    RunTask(CheckNum)

    T.name = "Diag col"
    T.exp_num = 8
    T.act_num = JSON.GetNumber(T.tmp, "col")
    RunTask(CheckNum)

    T.name = "Diag severity"
    T.exp_num = 2
    T.act_num = JSON.GetNumber(T.tmp, "severity")
    RunTask(CheckNum)

    T.name = "Diag code"
    T.exp_str = "unused-var"
    T.act_str = JSON.GetString(T.tmp, "code")
    RunTask(CheckStr)

    T.name = "Diag fatal"
    T.exp_num = 0
    T.act_num = JSON.GetBool(T.tmp, "fatal")
    RunTask(CheckNum)

    // Array of diagnostics
    T.arr = JSON.NewArray()

    T.inner = JSON.NewObject()
    JSON.SetNumber(T.inner, "line", 10)
    JSON.SetString(T.inner, "msg", "warning one")
    JSON.PushObject(T.arr, T.inner)

    T.inner = JSON.NewObject()
    JSON.SetNumber(T.inner, "line", 20)
    JSON.SetString(T.inner, "msg", "warning two")
    JSON.PushObject(T.arr, T.inner)

    T.str = JSON.SerializeArray(T.arr)
    PrintMessage("  Diag array JSON: ")
    PrintMessage(T.str)
    PrintMessage("\n")

    T.tagged = ParseJSON(T.str)
    T.child = JSON.AsArray(T.tagged)
    T.name = "Diag array size"
    T.exp_num = 2
    T.act_num = XArray.XSize(T.child)
    RunTask(CheckNum)

    T.tmp = XArray.XGet(T.child, 1)
    T.tmp2 = JSON.AsObject(T.tmp)
    T.name = "Diag array[1] line"
    T.exp_num = 20
    T.act_num = JSON.GetNumber(T.tmp2, "line")
    RunTask(CheckNum)

    T.name = "Diag array[1] msg"
    T.exp_str = "warning two"
    T.act_str = JSON.GetString(T.tmp2, "msg")
    RunTask(CheckStr)
}
RunTask(Test8_Diagnostic)
T.sec_name = "8 (Diagnostic)"
RunTask(Section)

// =============================================================================
// SECTION 9: CLEANUP / FREE
// =============================================================================
PrintMessage("SECTION 9: Free / Cleanup\n")
PrintMessage("========================================================\n")

SubRoutine.Test9_Free {
    // Build a tree and free it - just verify no crash
    T.obj = JSON.NewObject()
    JSON.SetString(T.obj, "a", "hello")
    JSON.SetNumber(T.obj, "b", 1)
    T.inner = JSON.NewArray()
    JSON.PushString(T.inner, "x")
    JSON.PushNumber(T.inner, 2)
    JSON.SetArray(T.obj, "c", T.inner)

    T.tagged = JSON.Tag(JType.OBJECT, T.obj)
    JSON.Free(T.tagged)

    T.name = "Free complex tree (no crash)"
    T.exp_num = 1
    T.act_num = 1
    RunTask(CheckNum)
}
RunTask(Test9_Free)
T.sec_name = "9 (Free)"
RunTask(Section)

// =============================================================================
// FINAL SUMMARY
// =============================================================================
PrintMessage("========================================================\n")
PrintMessage("    FINAL RESULTS\n")
PrintMessage("========================================================\n")
PrintMessage("  Total:  ")
PrintNumber(T.total)
PrintMessage("\n  Passed: ")
PrintNumber(T.pass)
PrintMessage("\n  Failed: ")
PrintNumber(T.fail)
PrintMessage("\n")

IfCondition EqualTo(T.fail, 0) ThenBlock: {
    PrintMessage("\n  ALL TESTS PASSED\n")
} ElseBlock: {
    PrintMessage("\n  FAILURES DETECTED - Review above\n")
}
PrintMessage("========================================================\n")