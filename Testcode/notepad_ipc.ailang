// notepad_ipc.ailang
// Standalone IPC notepad — connects to display server,
// requests a window, handles toolbar actions via IPC messaging.
//
// The display server has ZERO notepad knowledge.
// All text management is handled here; display server just renders.
//
// Protocol:
//   1. Connect to /tmp/ailang_display.sock
//   2. Send {"method":"register","service":"notepad"}
//   3. Send {"method":"window.create","title":"Untitled - Notepad",
//           "w":620,"h":460,"html":"config/notepad.html"}
//   4. Receive {"method":"window.created","win_id":N}
//   5. Service loop:
//      - Receive {"method":"input.action","action":"fd.open",...}
//      - Handle actions (clear, file open stub, etc.)
//      - Send {"method":"window.addline","win_id":N,"text":"Hello","color":14737632}
//      - Send {"method":"window.clear","win_id":N}
//   6. On {"method":"window.closed"} → exit
//
// Build: ./ailang.x Testcode/notepad_ipc.ailang notepad_ipc.x
// Run:   ./notepad_ipc.x  (after SysDisplay.x is running)
//
// Copyright 2026 Sean Collins, 2 Paws Machine and Engineering. SCSL.

LibraryImport.Arena
LibraryImport.Socket
LibraryImport.StringUtils
LibraryImport.JSON
LibraryImport.XArrays
LibraryImport.HashMap

FixedPool.NotepadIPCState {
    "running":     Initialize=1, CanChange=True
    "win_id":      Initialize=0, CanChange=True
    "msg_count":   Initialize=0, CanChange=True
    "line_count":  Initialize=0, CanChange=True
}

SubRoutine.Main {
    Arena_Init()

    PrintMessage("============================================\n")
    PrintMessage("  Notepad IPC Client\n")
    PrintMessage("============================================\n\n")

    sock_path = "/tmp/ailang_display.sock"

    // Connect to display server
    sock = Socket.Create(1, 1)
    IfCondition LessThan(sock, 0) ThenBlock: {
        PrintMessage("[NotepadIPC] Socket create failed\n")
        HaltProgram
    }

    cres = Socket.ConnectUnix(sock, sock_path)
    IfCondition LessThan(cres, 0) ThenBlock: {
        PrintMessage("[NotepadIPC] Connect failed — is display server running?\n")
        Socket.Close(sock)
        HaltProgram
    }
    PrintMessage("[NotepadIPC] Connected to display server\n")

    // Step 1: Register
    Socket.SendMsg(sock, "{\"method\":\"register\",\"service\":\"notepad\"}")
    PrintMessage("[NotepadIPC] Sent register\n")

    // Step 2: Request window
    Socket.SendMsg(sock, "{\"method\":\"window.create\",\"title\":\"Untitled - Notepad\",\"w\":620,\"h\":460,\"html\":\"config/notepad.html\"}")
    PrintMessage("[NotepadIPC] Sent window.create\n")

    // Step 3: Wait for window.created response
    resp = Socket.RecvMsg(sock)
    IfCondition EqualTo(resp, 0) ThenBlock: {
        PrintMessage("[NotepadIPC] No response to window.create\n")
        Socket.Close(sock)
        HaltProgram
    }

    parsed = ParseJSON(resp)
    IfCondition NotEqual(parsed, 0) ThenBlock: {
        pobj = JSON.AsObject(parsed)
        wid = JSON.GetNumber(pobj, "win_id")
        NotepadIPCState.win_id = wid
        PrintMessage("[NotepadIPC] Window created, win_id=")
        PrintNumber(wid)
        PrintMessage("\n")
        JSON.Free(parsed)
    }

    // Initial line count = 3 (from HTML welcome labels)
    NotepadIPCState.line_count = 3

    PrintMessage("[NotepadIPC] Waiting for input...\n\n")

    // Step 4: Service loop — receive actions, handle text operations
    WhileLoop EqualTo(NotepadIPCState.running, 1) {
        msg = Socket.RecvMsg(sock)
        IfCondition EqualTo(msg, 0) ThenBlock: {
            PrintMessage("[NotepadIPC] Connection closed\n")
            NotepadIPCState.running = 0
        } ElseBlock: {
            NotepadIPCState.msg_count = Add(NotepadIPCState.msg_count, 1)

            // Parse the message
            pmsg = ParseJSON(msg)
            IfCondition NotEqual(pmsg, 0) ThenBlock: {
                mobj = JSON.AsObject(pmsg)
                method = JSON.GetString(mobj, "method")

                IfCondition NotEqual(method, 0) ThenBlock: {
                    // Check for window.closed
                    cmp_closed = StringCompare(method, "window.closed")
                    IfCondition EqualTo(cmp_closed, 0) ThenBlock: {
                        PrintMessage("[NotepadIPC] Window closed by user\n")
                        NotepadIPCState.running = 0
                    }

                    // Check for input.action
                    cmp_action = StringCompare(method, "input.action")
                    IfCondition EqualTo(cmp_action, 0) ThenBlock: {
                        action = JSON.GetString(mobj, "action")
                        IfCondition NotEqual(action, 0) ThenBlock: {
                            action_len = JSON.GetNumber(mobj, "action_len")
                            NotepadIPC_HandleAction(sock, action, action_len)
                        }
                    }
                }
                JSON.Free(pmsg)
            }
        }
    }

    Socket.Close(sock)

    PrintMessage("\n============================================\n")
    PrintMessage("  NotepadIPC handled ")
    PrintNumber(NotepadIPCState.msg_count)
    PrintMessage(" messages\n")
    PrintMessage("============================================\n")
}

// =============================================================================
// HANDLE ACTION — process toolbar/button actions
//
// System actions (win.close, app.about, etc.) are handled by the display
// server's EventRouter and never forwarded here. We only get app-specific
// actions (menu:file.new, menu:file.open, etc.) and content area actions.
// =============================================================================
Function.NotepadIPC_HandleAction {
    Input: sock: Integer
    Input: action: Address
    Input: action_len: Integer
    Body: {
        PrintMessage("[NotepadIPC] action: ")
        PrintString(action)
        PrintMessage("\n")

        // menu:file.new — clear text area
        cmp_new = StringCompare(action, "menu:file.new")
        IfCondition EqualTo(cmp_new, 0) ThenBlock: {
            NotepadIPC_ClearLines(sock)
            NotepadIPC_AddLine(sock, "New document", 10526880)
            NotepadIPCState.line_count = 1
            ReturnValue(1)
        }

        // menu:file.open — stub for now
        cmp_open = StringCompare(action, "menu:file.open")
        IfCondition EqualTo(cmp_open, 0) ThenBlock: {
            PrintMessage("[NotepadIPC] File > Open — not yet implemented\n")
            ReturnValue(1)
        }

        ReturnValue(0)
    }
}

// =============================================================================
// ADD LINE — send window.addline to display server
// =============================================================================
Function.NotepadIPC_AddLine {
    Input: sock: Integer
    Input: text: Address
    Input: color: Integer
    Body: {
        wid = NotepadIPCState.win_id
        buf = Allocate(512)
        pos = 0

        // {"method":"window.addline","win_id":
        prefix = "{\"method\":\"window.addline\",\"win_id\":"
        plen = StringLength(prefix)
        MemoryCopy(buf, prefix, plen)
        pos = plen

        // Write win_id as decimal
        IfCondition LessThan(wid, 10) ThenBlock: {
            SetByte(buf, pos, Add(48, wid))
            pos = Add(pos, 1)
        } ElseBlock: {
            d10 = Divide(wid, 10)
            d1 = Subtract(wid, Multiply(d10, 10))
            SetByte(buf, pos, Add(48, d10))
            pos = Add(pos, 1)
            SetByte(buf, pos, Add(48, d1))
            pos = Add(pos, 1)
        }

        // ,"text":"
        mid1 = ",\"text\":\""
        m1len = StringLength(mid1)
        MemoryCopy(Add(buf, pos), mid1, m1len)
        pos = Add(pos, m1len)

        // Copy text value
        tlen = StringLength(text)
        IfCondition GreaterThan(tlen, 250) ThenBlock: { tlen = 250 }
        MemoryCopy(Add(buf, pos), text, tlen)
        pos = Add(pos, tlen)

        // ","color":
        mid2 = "\",\"color\":"
        m2len = StringLength(mid2)
        MemoryCopy(Add(buf, pos), mid2, m2len)
        pos = Add(pos, m2len)

        // Write color as decimal (up to 8 digits)
        color_str = Allocate(16)
        color_len = IntToString(color, color_str)
        MemoryCopy(Add(buf, pos), color_str, color_len)
        pos = Add(pos, color_len)

        // }
        SetByte(buf, pos, 125)
        pos = Add(pos, 1)
        SetByte(buf, pos, 0)

        Socket.SendMsg(sock, buf)
        NotepadIPCState.line_count = Add(NotepadIPCState.line_count, 1)
    }
}

// =============================================================================
// CLEAR LINES — send window.clear to display server
// =============================================================================
Function.NotepadIPC_ClearLines {
    Input: sock: Integer
    Body: {
        wid = NotepadIPCState.win_id
        buf = Allocate(64)
        pos = 0

        prefix = "{\"method\":\"window.clear\",\"win_id\":"
        plen = StringLength(prefix)
        MemoryCopy(buf, prefix, plen)
        pos = plen

        IfCondition LessThan(wid, 10) ThenBlock: {
            SetByte(buf, pos, Add(48, wid))
            pos = Add(pos, 1)
        } ElseBlock: {
            d10 = Divide(wid, 10)
            d1 = Subtract(wid, Multiply(d10, 10))
            SetByte(buf, pos, Add(48, d10))
            pos = Add(pos, 1)
            SetByte(buf, pos, Add(48, d1))
            pos = Add(pos, 1)
        }

        SetByte(buf, pos, 125)
        pos = Add(pos, 1)
        SetByte(buf, pos, 0)

        Socket.SendMsg(sock, buf)
        NotepadIPCState.line_count = 0
    }
}

// =============================================================================
// INT TO STRING — convert integer to decimal string
// =============================================================================
Function.IntToString {
    Input: val: Integer
    Input: out: Address
    Output: Integer
    Body: {
        IfCondition EqualTo(val, 0) ThenBlock: {
            SetByte(out, 0, 48)
            SetByte(out, 1, 0)
            ReturnValue(1)
        }

        // Write digits in reverse
        tmp = Allocate(16)
        n = val
        dcount = 0
        WhileLoop GreaterThan(n, 0) {
            d = Subtract(n, Multiply(Divide(n, 10), 10))
            SetByte(tmp, dcount, Add(48, d))
            n = Divide(n, 10)
            dcount = Add(dcount, 1)
        }

        // Reverse into output
        i = 0
        WhileLoop LessThan(i, dcount) {
            SetByte(out, i, GetByte(tmp, Subtract(Subtract(dcount, 1), i)))
            i = Add(i, 1)
        }
        SetByte(out, dcount, 0)
        ReturnValue(dcount)
    }
}

RunTask(Main)
