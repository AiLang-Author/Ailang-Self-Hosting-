// ailang_analyzer.ailang
// Standalone Code Analysis CLI for AILang
// Compiles to: analyzer.x
//
// Usage: ./analyzer.x <filename>
//
// Runs all 3 analysis passes and prints unified report.
// Exit code: 0 = clean, 1 = warnings only, 2 = errors found
//
// Copyright (c) 2026 Sean Collins, 2 Paws Machine and Engineering. All rights reserved.
// Licensed under the Sean Collins Software License (SCSL).

// =============================================================================
// IMPORTS - Frontend only, no compiler backend
// =============================================================================
LibraryImport.XArrays

// Frontend - Lexer
LibraryImport.Compiler.Frontend.Lexer.CLexerCore
LibraryImport.Compiler.Frontend.Lexer.CLexerMain

// Frontend - Parser
LibraryImport.Compiler.Frontend.Parser.CParserCore
LibraryImport.Compiler.Frontend.Parser.CParserMain

// Frontend - AST
LibraryImport.Compiler.Frontend.AST.CASTTypes
LibraryImport.Compiler.Frontend.AST.CASTCore
LibraryImport.Compiler.Frontend.AST.CASTNodes

// Import resolution
LibraryImport.Compiler.Import.CImportResolver

// Analysis passes
LibraryImport.Analyzer
LibraryImport.Analyzer2
LibraryImport.Analyzer3

// =============================================================================
// CLI STATE
// =============================================================================
FixedPool.ACli {
    "filename": Initialize=0, CanChange=True
    "source": Initialize=0, CanChange=True
    "source_len": Initialize=0, CanChange=True
    "resolved": Initialize=0, CanChange=True
    "ast": Initialize=0, CanChange=True
}

// =============================================================================
// FILE LOADING
// =============================================================================
Function.ACli.LoadFile {
    Input: filename: Address
    Output: Address
    Body: {
        fd = SystemCall(2, filename, 0, 0)
        IfCondition LessThan(fd, 0) ThenBlock: {
            ReturnValue(0)
        }
        
        size = SystemCall(8, fd, 0, 2)
        SystemCall(8, fd, 0, 0)
        
        IfCondition LessEqual(size, 0) ThenBlock: {
            SystemCall(3, fd)
            ReturnValue(0)
        }
        
        buffer = Allocate(Add(size, 1))
        IfCondition EqualTo(buffer, 0) ThenBlock: {
            SystemCall(3, fd)
            ReturnValue(0)
        }
        
        bytes_read = SystemCall(0, fd, buffer, size)
        SystemCall(3, fd)
        
        IfCondition LessThan(bytes_read, 0) ThenBlock: {
            Deallocate(buffer, Add(size, 1))
            ReturnValue(0)
        }
        
        SetByte(buffer, bytes_read, 0)
        ReturnValue(buffer)
    }
}

// =============================================================================
// ARG PARSING - reads /proc/self/cmdline
// =============================================================================
Function.ACli.GetFirstArg {
    Output: Address
    Body: {
        cmdline_path = "/proc/self/cmdline"
        fd = SystemCall(2, cmdline_path, 0, 0)
        
        IfCondition LessThan(fd, 0) ThenBlock: {
            ReturnValue(0)
        }
        
        buffer = Allocate(1024)
        bytes_read = SystemCall(0, fd, buffer, 1024)
        SystemCall(3, fd)
        
        IfCondition LessEqual(bytes_read, 0) ThenBlock: {
            Deallocate(buffer, 1024)
            ReturnValue(0)
        }
        
        // Skip program name (find first null)
        i = 0
        WhileLoop LessThan(i, bytes_read) {
            ch = GetByte(buffer, i)
            IfCondition EqualTo(ch, 0) ThenBlock: {
                BreakLoop
            }
            i = Add(i, 1)
        }
        i = Add(i, 1)
        
        // Check if past end or no arg
        IfCondition GreaterEqual(i, bytes_read) ThenBlock: {
            Deallocate(buffer, 1024)
            ReturnValue(0)
        }
        
        ch = GetByte(buffer, i)
        IfCondition EqualTo(ch, 0) ThenBlock: {
            Deallocate(buffer, 1024)
            ReturnValue(0)
        }
        
        // Found arg, get its length
        arg_start = i
        arg_len = 0
        WhileLoop LessThan(i, bytes_read) {
            ch = GetByte(buffer, i)
            IfCondition EqualTo(ch, 0) ThenBlock: {
                BreakLoop
            }
            arg_len = Add(arg_len, 1)
            i = Add(i, 1)
        }
        
        IfCondition EqualTo(arg_len, 0) ThenBlock: {
            Deallocate(buffer, 1024)
            ReturnValue(0)
        }
        
        // Copy arg
        arg = Allocate(Add(arg_len, 1))
        j = 0
        WhileLoop LessThan(j, arg_len) {
            ch = GetByte(buffer, Add(arg_start, j))
            SetByte(arg, j, ch)
            j = Add(j, 1)
        }
        SetByte(arg, arg_len, 0)
        
        Deallocate(buffer, 1024)
        ReturnValue(arg)
    }
}

// =============================================================================
// UNIFIED REPORT - reads from all 3 passes
// =============================================================================
Function.ACli.Report {
    Body: {
        PrintMessage("\n")
        PrintMessage("========================================\n")
        PrintMessage("        Code Analysis Report\n")
        PrintMessage("========================================\n")
        PrintMessage("  File: ")
        PrintMessage(ACli.filename)
        PrintMessage("\n")
        PrintMessage("========================================\n\n")
        
        // --- Pass 1: Memory & Structure ---
        PrintMessage("--- Memory & Structure ---\n")
        PrintMessage("Functions analyzed: ")
        PrintNumber(Analyzer.functions_analyzed)
        PrintMessage("\n")
        PrintMessage("SubRoutines analyzed: ")
        PrintNumber(Analyzer.subroutines_analyzed)
        PrintMessage("\n")
        PrintMessage("Functions defined: ")
        PrintNumber(XArray.XSize(Analyzer.defined_funcs))
        PrintMessage("\n")
        PrintMessage("Functions called: ")
        PrintNumber(XArray.XSize(Analyzer.called_funcs))
        PrintMessage("\n")
        PrintMessage("Allocate() calls: ")
        PrintNumber(Analyzer.total_allocs)
        PrintMessage("\n")
        PrintMessage("Deallocate() calls: ")
        PrintNumber(Analyzer.total_deallocs)
        PrintMessage("\n")
        PrintMessage("Max nesting depth: ")
        PrintNumber(Analyzer.max_block_depth)
        IfCondition NotEqual(Analyzer.max_depth_func, 0) ThenBlock: {
            PrintMessage(" (in '")
            PrintMessage(Analyzer.max_depth_func)
            PrintMessage("')")
        }
        PrintMessage("\n")
        
        // --- Pass 2: Control Flow ---
        PrintMessage("\n--- Control Flow ---\n")
        PrintMessage("Unreachable code: ")
        PrintNumber(Analyzer2.unreachable_warnings)
        PrintMessage("\n")
        PrintMessage("Infinite loops: ")
        PrintNumber(Analyzer2.infinite_loop_warnings)
        PrintMessage("\n")
        PrintMessage("Missing else: ")
        PrintNumber(Analyzer2.missing_else_warnings)
        PrintMessage("\n")
        PrintMessage("Functions registered: ")
        PrintNumber(XArray.XSize(Analyzer2.func_names))
        PrintMessage("\n")
        
        // --- Pass 3: Data Flow ---
        PrintMessage("\n--- Data Flow ---\n")
        PrintMessage("Uninitialized vars: ")
        PrintNumber(Analyzer3.uninit_warnings)
        PrintMessage("\n")
        PrintMessage("Dead assignments: ")
        PrintNumber(Analyzer3.dead_assign_warnings)
        PrintMessage("\n")
        PrintMessage("Double dealloc: ")
        PrintNumber(Analyzer3.double_dealloc_warnings)
        PrintMessage("\n")
        PrintMessage("StringConcat in loops: ")
        PrintNumber(Analyzer3.concat_leak_warnings)
        PrintMessage("\n")
        PrintMessage("Variable shadowing: ")
        PrintNumber(Analyzer3.shadow_warnings)
        PrintMessage("\n")
        PrintMessage("Loop var modification: ")
        PrintNumber(Analyzer3.loop_mod_warnings)
        PrintMessage("\n")
        PrintMessage("Recursive cycles: ")
        PrintNumber(Analyzer3.recursive_cycles)
        PrintMessage("\n")
        PrintMessage("Known pools: ")
        PrintNumber(XArray.XSize(Analyzer3.known_pools))
        PrintMessage("\n")
        
        // === ERRORS ===
        total_errors = Add(Analyzer.error_count, Analyzer3.error_count)
        IfCondition GreaterThan(total_errors, 0) ThenBlock: {
            PrintMessage("\n========================================\n")
            PrintMessage("ERRORS (")
            PrintNumber(total_errors)
            PrintMessage("):\n")
            PrintMessage("========================================\n")
            
            i = 0
            WhileLoop LessThan(i, Analyzer.error_count) {
                msg = XArray.XGet(Analyzer.errors, i)
                PrintMessage("  [MEM] ")
                PrintMessage(msg)
                PrintMessage("\n")
                i = Add(i, 1)
            }
            
            i = 0
            WhileLoop LessThan(i, Analyzer3.error_count) {
                msg = XArray.XGet(Analyzer3.errors, i)
                PrintMessage("  [DFA] ")
                PrintMessage(msg)
                PrintMessage("\n")
                i = Add(i, 1)
            }
        }
        
        // === WARNINGS ===
        total_warnings = Add(Analyzer.warning_count, Analyzer2.warning_count)
        total_warnings = Add(total_warnings, Analyzer3.warning_count)
        
        IfCondition GreaterThan(total_warnings, 0) ThenBlock: {
            PrintMessage("\n========================================\n")
            PrintMessage("WARNINGS (")
            PrintNumber(total_warnings)
            PrintMessage("):\n")
            PrintMessage("========================================\n")
            
            i = 0
            WhileLoop LessThan(i, Analyzer.warning_count) {
                msg = XArray.XGet(Analyzer.warnings, i)
                PrintMessage("  [MEM] ")
                PrintMessage(msg)
                PrintMessage("\n")
                i = Add(i, 1)
            }
            
            i = 0
            WhileLoop LessThan(i, Analyzer2.warning_count) {
                msg = XArray.XGet(Analyzer2.warnings, i)
                PrintMessage("  [CFG] ")
                PrintMessage(msg)
                PrintMessage("\n")
                i = Add(i, 1)
            }
            
            i = 0
            WhileLoop LessThan(i, Analyzer3.warning_count) {
                msg = XArray.XGet(Analyzer3.warnings, i)
                PrintMessage("  [DFA] ")
                PrintMessage(msg)
                PrintMessage("\n")
                i = Add(i, 1)
            }
        }
        
        // === HINTS ===
        IfCondition GreaterThan(Analyzer2.hint_count, 0) ThenBlock: {
            PrintMessage("\n========================================\n")
            PrintMessage("HINTS (")
            PrintNumber(Analyzer2.hint_count)
            PrintMessage("):\n")
            PrintMessage("========================================\n")
            
            i = 0
            WhileLoop LessThan(i, Analyzer2.hint_count) {
                msg = XArray.XGet(Analyzer2.hints, i)
                PrintMessage("  [OPT] ")
                PrintMessage(msg)
                PrintMessage("\n")
                i = Add(i, 1)
            }
        }
        
        // === SUMMARY ===
        total_warnings = Add(Analyzer.warning_count, Analyzer2.warning_count)
        total_warnings = Add(total_warnings, Analyzer3.warning_count)
        total_errors = Add(Analyzer.error_count, Analyzer3.error_count)
        
        PrintMessage("\n========================================\n")
        PrintMessage("  Summary: ")
        PrintNumber(total_errors)
        PrintMessage(" error(s), ")
        PrintNumber(total_warnings)
        PrintMessage(" warning(s), ")
        PrintNumber(Analyzer2.hint_count)
        PrintMessage(" hint(s)\n")
        PrintMessage("========================================\n")
    }
}

// =============================================================================
// MAIN
// =============================================================================
SubRoutine.Main {
    ACli.filename = ACli.GetFirstArg()
    
    IfCondition EqualTo(ACli.filename, 0) ThenBlock: {
        PrintMessage("AILang Code Analyzer\n")
        PrintMessage("Usage: ./analyzer.x <filename.ailang>\n")
        ProcessExit(1)
    }
    
    PrintMessage("AILang Analyzer - ")
    PrintMessage(ACli.filename)
    PrintMessage("\n")
    
    // Step 1: Load
    ACli.source = ACli.LoadFile(ACli.filename)
    IfCondition EqualTo(ACli.source, 0) ThenBlock: {
        PrintMessage("ERROR: Cannot read file: ")
        PrintMessage(ACli.filename)
        PrintMessage("\n")
        ProcessExit(1)
    }
    ACli.source_len = StringLength(ACli.source)
    
    // Step 2: Resolve imports
    ACli.resolved = Import_ResolveAll(ACli.source)
    IfCondition EqualTo(ACli.resolved, 0) ThenBlock: {
        ACli.resolved = ACli.source
    }
    
    // Step 3: Lex
    resolved_len = StringLength(ACli.resolved)
    Lex_Init(ACli.resolved, resolved_len)
    Lex_Tokenize()
    
    IfCondition EqualTo(Lex.error, 1) ThenBlock: {
        PrintMessage("ERROR: Lexer failed at line ")
        PrintNumber(Lex.error_line)
        PrintMessage("\n")
        ProcessExit(1)
    }
    
    // Step 4: Parse
    Parse_Init(Lex.token_count)
    ACli.ast = Parse_Program()
    
    IfCondition EqualTo(Parse_HasError(), 1) ThenBlock: {
        PrintMessage("ERROR: Parse failed at line ")
        PrintNumber(PParser.p_error_line)
        PrintMessage(": ")
        IfCondition NotEqual(PParser.p_error_msg, 0) ThenBlock: {
            PrintMessage(PParser.p_error_msg)
        }
        PrintMessage("\n")
        ProcessExit(1)
    }
    
    // Step 5: Run all analysis passes
  Analyzer.Init()
  Analyzer.WalkNode(ACli.ast)

    // PrintMessage("[INFO] Running Analyzer.PostAnalysis...\n")
    Analyzer.PostAnalysis()
    // PrintMessage("[INFO] Analyzer.PostAnalysis finished.\n")
    
    // PrintMessage("[INFO] Running Analyzer2...\n")
    Analyzer2.Run(ACli.ast)
    // PrintMessage("[INFO] Analyzer2 finished.\n")
    
    // PrintMessage("[INFO] Running Analyzer3...\n")
    Analyzer3.Run(ACli.ast)
    // PrintMessage("[INFO] Analyzer3 finished.\n")
    
    // Step 6: Report
    ACli.Report()
    
    // Exit code based on results
    total_errors = Add(Analyzer.error_count, Analyzer3.error_count)
    IfCondition GreaterThan(total_errors, 0) ThenBlock: {
        ProcessExit(2)
    }
    
    total_warnings = Add(Analyzer.warning_count, Analyzer2.warning_count)
    total_warnings = Add(total_warnings, Analyzer3.warning_count)
    IfCondition GreaterThan(total_warnings, 0) ThenBlock: {
        ProcessExit(1)
    }
    
    HaltProgram()
}

RunTask(Main)